#define MUSIC_PAGE_SIZE                 4
#define MUSIC_ALBUM_PRICE               249
#define MUSIC_ALBUM_COUNT               6
#define MUSIC_FREE_TRACK_COUNT          12
#define MUSIC_PAID_TRACKS_PER_ALBUM     5
#define MUSIC_TAB_FREE                  0
#define MUSIC_TAB_PREMIUM               1
#define MUSIC_BTN_ITEM_0                0
#define MUSIC_BTN_ITEM_1                1
#define MUSIC_BTN_ITEM_2                2
#define MUSIC_BTN_ITEM_3                3
#define MUSIC_BTN_SEARCH                4
#define MUSIC_BTN_NEXT                  5
#define MUSIC_BTN_PREV                  6
#define MUSIC_BTN_BACK                  7
#define MUSIC_BTN_SEARCH_SEND           8
#define SC "{FFFF00}| {FFFFFF}"

new musicOn[MAX_PLAYERS];
new g_music_gui_page[MAX_PLAYERS][2];
new g_music_selected_album[MAX_PLAYERS];
new bool:g_music_premium_tracks[MAX_PLAYERS];
new g_music_active_tab[MAX_PLAYERS];
new g_music_active_name[MAX_PLAYERS][96];
new bool:g_music_active_premium[MAX_PLAYERS];
new bool:g_music_db_inited;

public OnPlayerDisconnect(playerid, reason)
{
    musicOn[playerid] = 0;
    g_music_gui_page[playerid][MUSIC_TAB_FREE] = 1;
    g_music_gui_page[playerid][MUSIC_TAB_PREMIUM] = 1;
    g_music_selected_album[playerid] = -1;
    g_music_premium_tracks[playerid] = false;
    g_music_active_name[playerid][0] = EOS;

    if(BRDuelActive[playerid])
    {
        new duel_opp = BRDuelOpponent[playerid];

        if(IsPlayerConnected(duel_opp) && BRDuelActive[duel_opp])
        {
            GivePlayerMoneyEx(duel_opp, BRDuelBet[playerid] * 2);
            SetPlayerVirtualWorld(duel_opp, BRDuelOldWorld[duel_opp]);
            SetPlayerInterior(duel_opp, BRDuelOldInterior[duel_opp]);
            SetPlayerPos(duel_opp, BRDuelOldX[duel_opp], BRDuelOldY[duel_opp], BRDuelOldZ[duel_opp]);
            SetPlayerFacingAngle(duel_opp, BRDuelOldA[duel_opp]);
            SetPlayerHealth(duel_opp, BRDuelOldHealth[duel_opp]);
            SetPlayerArmour(duel_opp, BRDuelOldArmour[duel_opp]);
            ResetPlayerWeapons(duel_opp);

            for(new w = 0; w < 13; w++)
            {
                if(BRDuelSavedWeapon[duel_opp][w] > 0 && BRDuelSavedAmmo[duel_opp][w] > 0)
                    GivePlayerWeapon(duel_opp, BRDuelSavedWeapon[duel_opp][w], BRDuelSavedAmmo[duel_opp][w]);
            }

            BRDuelActive[duel_opp] = false;
            BRDuelOpponent[duel_opp] = -1;
            BRDuelBet[duel_opp] = 0;
            BRDuelWins[duel_opp] = 0;
            SendClientMessage(duel_opp, 0x66CC33FF, "Дуэль завершена: соперник вышел. Вы получили банк дуэли.");
        }

        BRDuelActive[playerid] = false;
        BRDuelOpponent[playerid] = -1;
        BRDuelBet[playerid] = 0;
        BRDuelWins[playerid] = 0;
    }

    if(BRDuelOffer[playerid] != -1)
    {
        new offer_from = BRDuelOffer[playerid];

        if(IsPlayerConnected(offer_from))
        {
            BRDuelOffer[offer_from] = -1;
            BRDuelOfferBet[offer_from] = 0;
            SendClientMessage(offer_from, -1, "Игрок вышел. Приглашение на дуэль отменено.");
        }

        BRDuelOffer[playerid] = -1;
        BRDuelOfferBet[playerid] = 0;
    }

    Calendar_OnDisconnect(playerid);
    AutumnEvent_OnDisconnect(playerid);
    UnLoadPlayerFamily(playerid);
    #if defined fam_OnPlayerDisconnect
        return fam_OnPlayerDisconnect(playerid, reason);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnPlayerDisconnect
    #undef OnPlayerDisconnect
#else
    #define _ALS_OnPlayerDisconnect
#endif
#define OnPlayerDisconnect fam_OnPlayerDisconnect
#if defined fam_OnPlayerDisconnect
    forward fam_OnPlayerDisconnect(playerid, reason);
#endif

public: welsi_LoadFamily()
{
    new Cache:cache=mysql_query(mysql, "SELECT * FROM family");

    if(mysql_errno())
        return printf("[FAMILY SQL #1] LoadFamily %d", mysql_errno());

    if(!cache_num_rows())
        return print("None Cache | Query load Family");

    new rows = cache_num_rows();

    if(rows > MAX_FAM)
    {
        printf("count family (%d) > MAX_FAM (%d), extra rows skipped", rows, MAX_FAM);
        rows = MAX_FAM;
    } 

    for(new i; i < rows; i ++)
    {
        SetFamily(i, family_database, cache_get_field_content_int(i, "id"));
        SetFamily(i, family_owner, cache_get_field_content_int(i, "owner"));
        SetFamily(i, family_color, cache_get_field_content_int(i, "color"));
        SetFamily(i, family_count_veh, cache_get_field_content_int(i, "slot_veh"));
        SetFamily(i, family_reputation, cache_get_field_content_int(i, "reputation"));
        SetFamily(i, family_slot_veh, cache_get_field_content_int(i, "slot_veh"));
        cache_get_field_content(i, "name", GetFamily(i, family_name), mysql, 32);

        SetFamily(i, family_patron, cache_get_field_content_int(i, "patron"));
        SetFamily(i, family_patron, cache_get_field_content_int(i, "material"));
        SetFamily(i, family_heath_kit, cache_get_field_content_int(i, "heath_kit"));
        SetFamily(i, family_armour, cache_get_field_content_int(i, "armour"));
        SetFamily(i, family_money, cache_get_field_content_int(i, "money"));

        SetFamily(i, family_lvl_storage, cache_get_field_content_int(i, "level_storage"));
        SetFamily(i, family_lvl_weapon, cache_get_field_content_int(i, "level_weapon"));
        SetFamily(i, family_lvl_compound, cache_get_field_content_int(i, "level_compound"));
        SetFamily(i, family_house, cache_get_field_content_int(i, "house"));

        new rang[5][96], name[24], setting_1,
        setting_2, setting_3, setting_4, setting_5, setting_6;

        cache_get_field_content(i, "rang_1", rang[0], mysql, sizeof(rang[]));
        cache_get_field_content(i, "rang_2", rang[1], mysql, sizeof(rang[]));
        cache_get_field_content(i, "rang_3", rang[2], mysql, sizeof(rang[]));
        cache_get_field_content(i, "rang_4", rang[3], mysql, sizeof(rang[]));
        cache_get_field_content(i, "rang_5", rang[4], mysql, sizeof(rang[]));

        for(new l;l < 5;l++)
        {
            setting_1 = setting_2 = setting_3 = setting_4 = setting_5 = setting_6 = 0;
            if(sscanf(rang[l], "P<,>s[24]dddddd", name, setting_1, setting_2, setting_3, setting_4, setting_5, setting_6))
            {
                format(name, sizeof(name), "Rank %d", l + 1);
            }
            format(family_rang_name[i][l], 24, name);
            family_rang_dostup[i][l][0] = setting_1;
            family_rang_dostup[i][l][1] = setting_2;
            family_rang_dostup[i][l][2] = setting_3;
            family_rang_dostup[i][l][3] = setting_4;
            family_rang_dostup[i][l][4] = setting_5;
            family_rang_dostup[i][l][5] = setting_6;
        }
    }

    for(new i; i < MAX_FAM;i++)
    {
        if(GetFamily(i, family_database) == -1) continue;

        mysql_format(mysql, f_string184, sizeof f_string184, "SELECT"\
        "(SELECT COUNT(*) FROM accounts WHERE family_id = %d) AS accounts_count,"\
        "(SELECT COUNT(*) FROM family_cars WHERE family_owner = %d) AS cars_count", GetFamily(i, family_database), GetFamily(i, family_database)); 
        new Cache:ccache = mysql_query(mysql, f_string184);

        if(cache_num_rows())
        {
            new count_auto = cache_get_row_int(0,0),
            count_people = cache_get_row_int(0, 1);

            SetFamily(i, family_count_veh, count_auto);
            SetFamily(i, family_count_people, count_people);
            
        }

        cache_delete(ccache);
    }

    cache_delete(cache);
    return 1;
}

public: UnLoadPlayerFamily(playerid)
{
    if(GetPlayerFamily(playerid, ID_FAMILY) == -1) return 1;

    UpdatePlayerDatabaseInt(playerid, "family_id", GetPlayerFamily(playerid, ID_SQL_FAMILY));
    UpdatePlayerDatabaseInt(playerid, "family_rang", GetPlayerFamily(playerid, RANG_FAMILY));
    UpdatePlayerDatabaseInt(playerid, "family_mute", GetPlayerFamily(playerid, MUTE_FAMILY));
    UpdateAccessPlayerFamily(playerid);

    SetPlayerFamily(playerid, ID_FAMILY, -1);
    SetPlayerFamily(playerid, ID_SQL_FAMILY, -1);
    
    DestroyDynamic3DTextLabel(GetPlayerFamily(playerid, TEXT_FAMILY));
    SetPlayerFamily(playerid, TEXT_FAMILY, STREAMER_TAG_3D_TEXT_LABEL:-1);

    SetPlayerFamily(playerid, RANG_FAMILY, 0);
    SetPlayerFamily(playerid, MUTE_FAMILY, 0);
    

    SetPlayerFamily(playerid, ACCESS_GIVE, 0);
    SetPlayerFamily(playerid, ACCESS_MONEY, 0);
    SetPlayerFamily(playerid, ACCESS_ARMOUR, 0);
    SetPlayerFamily(playerid, ACCESS_MATERIAL, 0);
    SetPlayerFamily(playerid, ACCESS_HEATH_KIT, 0);
    SetPlayerFamily(playerid, ACCESS_PATRON, 0);
    SetPlayerFamily(playerid, ACCESS_MASK, 0);

    return 1;
}

public:LoadPlayerFamily(playerid)
{
    mysql_format(mysql, f_string64, sizeof(f_string64), "SELECT * FROM accounts WHERE id=%d LIMIT 1", GetPlayerAccountID(playerid));
    new Cache:cache=mysql_query(mysql, f_string64);

    if(mysql_errno())
        return print("[FAMILY SQL #2] LoadPlayerFamily");

    if(!cache_num_rows()) return printf("%d - none accounts", cache_num_rows());

    new access_c[7], access[24];

    new id = cache_get_field_content_int(0, "family_id");
    if(id == -1) return 1;

    for(new i; i <MAX_FAM;i++)
    {
        if(GetFamily(i, family_database) != id) continue;

        SetPlayerFamily(playerid, ID_FAMILY, i);
        break;
    }

    if(GetPlayerFamily(playerid, ID_FAMILY) == -1) return printf("None fAmily - %d", id);

    SetPlayerFamily(playerid, ID_SQL_FAMILY, id);

    SetPlayerFamily(playerid, RANG_FAMILY, cache_get_field_content_int(0, "family_rang"));
    SetPlayerFamily(playerid, MUTE_FAMILY, cache_get_field_content_int(0, "family_mute"));

    

    cache_get_field_content(0, "family_access", access, mysql, 24);
    sscanf(access, "P<,>ddddddd", access_c[0], access_c[1], access_c[2], access_c[3], access_c[4], 
    access_c[5], access_c[6]);

    SetPlayerFamily(playerid, ACCESS_GIVE,      access_c[0]);
    SetPlayerFamily(playerid, ACCESS_MONEY,     access_c[1]);
    SetPlayerFamily(playerid, ACCESS_ARMOUR,    access_c[2]);
    SetPlayerFamily(playerid, ACCESS_MATERIAL,  access_c[3]);
    SetPlayerFamily(playerid, ACCESS_HEATH_KIT, access_c[4]);
    SetPlayerFamily(playerid, ACCESS_PATRON,    access_c[5]);
    SetPlayerFamily(playerid, ACCESS_MASK,      access_c[6]);

    new family_id = GetPlayerIdFamily(playerid);
    if(family_id < 0 || family_id >= MAX_FAM)
    {
        cache_delete(cache);
        return 1;
    }

    new family_color_idx = GetFamily(family_id, family_color);
    if(family_color_idx < 0 || family_color_idx >= sizeof(family_type_color))
    {
        printf("[FAMILY] Invalid family color %d for family %d (sql id %d), using 0", family_color_idx, family_id, id);
        family_color_idx = 0;
        SetFamily(family_id, family_color, 0);
    }

    new familyName[64];
    format(familyName, sizeof familyName, "%s", GetFamily(family_id, family_name));
    utf8_to_cp1251(familyName);

    format(f_string144, sizeof f_string144, "%sСемья: %s", family_type_color[family_color_idx], familyName);
    printf("%s    color %s  name %s ", f_string144, family_type_color[family_color_idx], GetFamily(family_id, family_name));

    if(IsValidDynamic3DTextLabel(GetPlayerFamily(playerid, TEXT_FAMILY))) DestroyDynamic3DTextLabel(GetPlayerFamily(playerid, TEXT_FAMILY));
    SetPlayerFamily(playerid, TEXT_FAMILY, CreateDynamic3DTextLabel(f_string144, -1, 0.0, 0.0, 0.8, 7.8, playerid));

    cache_delete(cache);
    return 1;   
}

public:CheckMutePlayer()
{
    foreach(new i : Player)
    {
        if(GetPlayerIdFamily(i) == -1) continue;
        else if(!GetPlayerFamily(i, MUTE_FAMILY)) continue;

        player_family[i][MUTE_FAMILY]--;

        if(!player_family[i][MUTE_FAMILY]) SendClientMessage(i, -1, ""c_f_r" Ваш мут в чате семьи истек. Не нарушайте больше!");
    }    

    return 1;
}

stock FamilyCreate(playerid, const source_name[])
{
    new fam_name[32];
    format(fam_name, sizeof fam_name, "%s", source_name);

    if(!(6 <= strlen(fam_name) <= 31))
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Название семьи должно содержать от 6 до 31 символа.", "OK");
    if(GetPlayerIdFamily(playerid) != -1)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Вы уже состоите в семье.", "OK");
    if(GetPlayerMoneyEx(playerid) < 3_000_000)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Для создания семьи требуется 3.000.000 рублей.", "OK");

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Аккаунт ещё не загружен. Повторите попытку позже.", "OK");

    FamilyEnsureCoreTables();

    new free_id = -1;
    for(new i; i < MAX_FAM; i++)
    {
        if(GetFamily(i, family_database) != -1) continue;
        free_id = i;
        break;
    }
    if(free_id == -1)
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Нет свободного слота для новой семьи.", "OK");

    mysql_format(mysql, f_string184, sizeof f_string184,
        "SELECT id,owner FROM family WHERE name='%e' ORDER BY id DESC LIMIT 1", fam_name);
    new Cache:dup_cache = mysql_query(mysql, f_string184, true);
    new dup_errno = mysql_errno();
    if(dup_errno)
    {
        cache_delete(dup_cache);
        printf("[DONOR FAMILY CREATE][NAME CHECK ERROR] player=%d account=%d errno=%d", playerid, account_id, dup_errno);
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Ошибка проверки названия семьи.", "OK");
    }

    new family_sql_id = 0;
    if(cache_num_rows())
    {
        new existing_owner = cache_get_field_content_int(0, "owner");
        family_sql_id = cache_get_field_content_int(0, "id");
        if(existing_owner != account_id)
        {
            cache_delete(dup_cache);
            return ShowNotificationNew(playerid, 2, 6, 0, 0, "Такое название семьи уже занято.", "OK");
        }
    }
    cache_delete(dup_cache);

    if(family_sql_id <= 0)
    {
        mysql_format(mysql, f_string184, sizeof f_string184,
            "INSERT INTO family (owner,name) VALUES (%d,'%e')", account_id, fam_name);
        new Cache:create_cache = mysql_query(mysql, f_string184, true);
        new create_errno = mysql_errno();
        family_sql_id = cache_insert_id();
        cache_delete(create_cache);
        if(create_errno || family_sql_id <= 0)
        {
            printf("[DONOR FAMILY CREATE][INSERT ERROR] player=%d account=%d errno=%d id=%d query=%s", playerid, account_id, create_errno, family_sql_id, f_string184);
            format(f_string144, sizeof f_string144, "Не удалось создать семью. SQL ошибка: %d", create_errno);
            return ShowNotificationNew(playerid, 2, 6, 0, 0, f_string144, "OK");
        }
    }

    mysql_format(mysql, f_string184, sizeof f_string184,
        "UPDATE accounts SET family_access='1,1,1,1,1,1,1',family_id=%d,family_rang=5,family_mute=0 WHERE id=%d LIMIT 1",
        family_sql_id, account_id);
    mysql_query(mysql, f_string184, false);
    new update_errno = mysql_errno();
    if(update_errno)
    {
        printf("[DONOR FAMILY CREATE][ACCOUNT ERROR] player=%d account=%d family=%d errno=%d", playerid, account_id, family_sql_id, update_errno);
        format(f_string144, sizeof f_string144, "Семья создана, но аккаунт не привязан. SQL ошибка: %d", update_errno);
        return ShowNotificationNew(playerid, 2, 6, 0, 0, f_string144, "OK");
    }

    mysql_format(mysql, f_string64, sizeof f_string64, "SELECT * FROM family WHERE id=%d LIMIT 1", family_sql_id);
    new Cache:cache = mysql_query(mysql, f_string64, true);
    new select_errno = mysql_errno();
    if(select_errno || !cache_num_rows())
    {
        cache_delete(cache);
        printf("[DONOR FAMILY CREATE][LOAD ERROR] player=%d account=%d family=%d errno=%d", playerid, account_id, family_sql_id, select_errno);
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Семья записана, но не загрузилась.", "OK");
    }

    SetFamily(free_id, family_database, family_sql_id);
    SetFamily(free_id, family_owner, account_id);
    SetFamily(free_id, family_color, cache_get_field_content_int(0, "color"));
    SetFamily(free_id, family_reputation, cache_get_field_content_int(0, "reputation"));
    SetFamily(free_id, family_slot_veh, cache_get_field_content_int(0, "slot_veh"));
    cache_get_field_content(0, "name", GetFamily(free_id, family_name), mysql, 32);
    SetFamily(free_id, family_patron, cache_get_field_content_int(0, "patron"));
    SetFamily(free_id, family_material, cache_get_field_content_int(0, "material"));
    SetFamily(free_id, family_heath_kit, cache_get_field_content_int(0, "heath_kit"));
    SetFamily(free_id, family_armour, cache_get_field_content_int(0, "armour"));
    SetFamily(free_id, family_money, cache_get_field_content_int(0, "money"));
    SetFamily(free_id, family_mask, cache_get_field_content_int(0, "mask"));
    SetFamily(free_id, family_lvl_storage, cache_get_field_content_int(0, "level_storage"));
    SetFamily(free_id, family_lvl_weapon, cache_get_field_content_int(0, "level_weapon"));
    SetFamily(free_id, family_lvl_compound, cache_get_field_content_int(0, "level_compound"));
    SetFamily(free_id, family_house, cache_get_field_content_int(0, "house"));
    SetFamily(free_id, family_count_people, 1);
    SetFamily(free_id, family_count_veh, 0);

    new rang[5][96], rank_name[24], access_1, access_2, access_3, access_4, access_5, access_6;
    cache_get_field_content(0, "rang_1", rang[0], mysql, sizeof(rang[]));
    cache_get_field_content(0, "rang_2", rang[1], mysql, sizeof(rang[]));
    cache_get_field_content(0, "rang_3", rang[2], mysql, sizeof(rang[]));
    cache_get_field_content(0, "rang_4", rang[3], mysql, sizeof(rang[]));
    cache_get_field_content(0, "rang_5", rang[4], mysql, sizeof(rang[]));
    cache_delete(cache);

    for(new l; l < 5; l++)
    {
        access_1 = access_2 = access_3 = access_4 = access_5 = access_6 = 0;
        if(sscanf(rang[l], "P<,>s[24]dddddd", rank_name, access_1, access_2, access_3, access_4, access_5, access_6))
        {
            format(rank_name, sizeof rank_name, "%d ранг", l + 1);
            if(l == 4) access_1 = access_2 = access_3 = access_4 = access_5 = access_6 = 1;
        }
        format(family_rang_name[free_id][l], 24, "%s", rank_name);
        family_rang_dostup[free_id][l][0] = access_1;
        family_rang_dostup[free_id][l][1] = access_2;
        family_rang_dostup[free_id][l][2] = access_3;
        family_rang_dostup[free_id][l][3] = access_4;
        family_rang_dostup[free_id][l][4] = access_5;
        family_rang_dostup[free_id][l][5] = access_6;
    }

    SetPlayerFamily(playerid, ID_FAMILY, free_id);
    SetPlayerFamily(playerid, ID_SQL_FAMILY, family_sql_id);
    SetPlayerFamily(playerid, RANG_FAMILY, 5);
    SetPlayerFamily(playerid, MUTE_FAMILY, 0);
    SetPlayerFamily(playerid, ACCESS_GIVE, 1);
    SetPlayerFamily(playerid, ACCESS_MONEY, 1);
    SetPlayerFamily(playerid, ACCESS_ARMOUR, 1);
    SetPlayerFamily(playerid, ACCESS_MATERIAL, 1);
    SetPlayerFamily(playerid, ACCESS_HEATH_KIT, 1);
    SetPlayerFamily(playerid, ACCESS_PATRON, 1);
    SetPlayerFamily(playerid, ACCESS_MASK, 1);

    GivePlayerMoneyEx(playerid, -3_000_000);
    printf("[DONOR FAMILY CREATE][SUCCESS] player=%d account=%d family=%d slot=%d name=%s", playerid, account_id, family_sql_id, free_id, fam_name);
    format(f_string144, sizeof f_string144, "Вы успешно создали семью %s", fam_name);
    ShowNotificationNew(playerid, 2, 6, 0, 0, f_string144, "OK");
    callcmd::family(playerid);
    return 1;
}

stock ShowDialogFamilyCar(playerid, id)
{
    SetPVarInt(playerid, "select_fam_car", id);

    new status = GetStatusFamilyCar(id);

    if(!status)
    {
        if(GetPlayerRangFamily(playerid) != 5)
        {
            ShowPlayerDialog
            (
                playerid, 2224, DIALOG_STYLE_LIST, 
                "{FF0000}Семейный транспорт",
                "1. Отметить транспорт на GPS\n"\
                "2. Загрузить транспорт\n"\
                "3. Удалить транспорт",
                "Далее", "Выйти"
            );
        }
        else
        {
            ShowPlayerDialog
            (
                playerid, 2224, DIALOG_STYLE_LIST, 
                "{FF0000}Семейный транспорт",
                "1. Отметить транспорт на GPS\n"\
                "2. Загрузить транспорт\n"\
                "3. Удалить транспорт\n"\
                "4. Изменить доступ к т/с",
                "Далее", "Выйти"
            );  
        }
    }
    else
    {
        ShowPlayerDialog
        (
            playerid, 2224, DIALOG_STYLE_LIST, 
            "{FF0000}Семейный транспорт",
            "1. Отметить транспорт на GPS\n"\
            "2. Выгрузить транспорт",
            "Далее", "Выйти"
        );     
    }
}

stock MoveOwnableCar(playerid, database_car, fam)
{
    new fam_id = GetPlayerIdFamily(playerid);
    new model_id, color_1, color_2, number[32], region[8], number_type;
    new move_vinyl_name[32];
    new saved_body_colors, saved_wheel_colors, saved_wheel_comp;
    new saved_toner_front, saved_toner_rear, saved_tonir_ft, saved_tonir_rr;
    new Float:pos_x, Float:pos_y, Float:pos_z, Float:angle;
    new stored_number[32];

    mysql_format(mysql, f_string64, sizeof f_string64, "SELECT * FROM ownable_cars WHERE id=%d", database_car);
    new Cache:cache_sql = mysql_query(mysql, f_string64, true);

    if(mysql_errno())
        return SendClientMessage(playerid,-1,""c_f_r"\xce\xf8\xe8\xe1\xea\xe0 \xe2 SQL-\xe7\xe0\xef\xf0\xee\xf1\xe5 / Code: MoveOwnableCar");

    if(!cache_num_rows())
    {
        cache_delete(cache_sql);
        return SendClientMessage(playerid,-1,""c_f_r"\xd2\xf0\xe0\xed\xf1\xef\xee\xf0\xf2 \xed\xe5 \xed\xe0\xe9\xe4\xe5\xed.");
    }


    model_id = cache_get_field_content_int(0, "model_id");
    color_1 = cache_get_field_content_int(0, "color_1");
    color_2 = cache_get_field_content_int(0, "color_2");
    saved_body_colors = cache_get_field_content_int(0, "body_colors");
    saved_wheel_colors = cache_get_field_content_int(0, "wheel_colors");
    saved_wheel_comp = cache_get_field_content_int(0, "wheel_comp");
    saved_toner_front = cache_get_field_content_int(0, "toner_front");
    saved_toner_rear = cache_get_field_content_int(0, "toner_rear");
    saved_tonir_ft = cache_get_field_content_int(0, "tonir_ft");
    saved_tonir_rr = cache_get_field_content_int(0, "tonir_rr");
    pos_x = cache_get_field_content_float(0, "pos_x");
    pos_y = cache_get_field_content_float(0, "pos_y");
    pos_z = cache_get_field_content_float(0, "pos_z");
    angle = cache_get_field_content_float(0, "angle");
    cache_get_field_content(0, "number", number, mysql, sizeof number);
    cache_get_field_content(0, "vynil_name", move_vinyl_name, mysql, sizeof move_vinyl_name);
    if(move_vinyl_name[0] == 0)
    {
        new source_iscase = cache_get_field_content_int(0, "iscase");
        new source_vinyl = cache_get_field_content_int(0, "vinilcar");
        if(source_iscase || source_vinyl) GetRemapName(model_id, move_vinyl_name, sizeof move_vinyl_name);
    }

    
    
    
    if(model_id < 400)
    {
        cache_delete(cache_sql);
        printf("[FAMILY CAR] MoveOwnableCar invalid model_id=%d sql_id=%d", model_id, database_car);
        SendClientMessage(playerid, -1, ""c_f_r"\xcd\xe5\xea\xee\xf0\xf0\xe5\xea\xf2\xed\xe0\xff \xec\xee\xe4\xe5\xeb\xfc \xe0\xe2\xf2\xee\xec\xee\xe1\xe8\xeb\xff.");
        return 0;
    }

    
    
    
    
    format(stored_number, sizeof stored_number, "%s", number);
    if(!ParseStoredPlateValue(stored_number, number_type, number, sizeof number, region, sizeof region))
    {
        number_type = TYPE_RU;
        format(number, sizeof number, "");
        format(region, sizeof region, "");
    }
    if(!PlateTypeUsesRegion(number_type))
        format(region, sizeof region, "");
    cache_delete(cache_sql);

    new query[8192];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO family_cars "\
        "(family_owner, model_id, color_1, color_2, body_colors, wheel_colors, wheel_comp, toner_front, toner_rear, tonir_ft, tonir_rr, pos_x, pos_y, pos_z, angle, create_time, number, region, number_type, vynil_name) "\
        "VALUES (%d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %f, %f, %f, %f, %d, '%e', '%e', %d, '%e')",
        fam, model_id, color_1, color_2, saved_body_colors, saved_wheel_colors, saved_wheel_comp, saved_toner_front, saved_toner_rear, saved_tonir_ft, saved_tonir_rr,
        pos_x, pos_y, pos_z, angle, gettime(), number, region, number_type, move_vinyl_name
    );
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        printf("[FAMILY CAR] MoveOwnableCar INSERT error: %d", mysql_errno());
        return 0;
    }

    new family_database = cache_insert_id();

    mysql_format(mysql, query, sizeof query,
        "UPDATE family_cars fc JOIN ownable_cars oc ON oc.id=%d SET "\
        "fc.f_state=oc.f_state,fc.nitro_level=oc.nitro_level,fc.launch=oc.launch,fc.pdvradar=oc.pdvradar,"\
        "fc.lights_color=oc.lights_color,fc.underlights_color=oc.underlights_color,fc.underlights_color_lf=oc.underlights_color_lf,fc.underlights_color_rt=oc.underlights_color_rt,"\
        "fc.is_FarLight_active=oc.is_FarLight_active,fc.pnevmo_selected=oc.pnevmo_selected,fc.percentofclirness=oc.percentofclirness,fc.percentofclirnessZ=oc.percentofclirnessZ,"\
        "fc.is_hydro_active=oc.is_hydro_active,fc.is_hydro_bought=oc.is_hydro_bought,fc.is_FarLight_bought=oc.is_FarLight_bought,fc.is_pnevmo_bought=oc.is_pnevmo_bought,"\
        "fc.vinilcar=oc.vinilcar,fc.iscase=oc.iscase,fc.pt_engine=oc.pt_engine,fc.pt_brake=oc.pt_brake,fc.pt_stability=oc.pt_stability,"\
        "fc.supercharger=oc.supercharger,fc.pt_turbo=oc.pt_turbo,fc.wheel_offset_ft=oc.wheel_offset_ft,fc.wheel_offset_rr=oc.wheel_offset_rr,"\
        "fc.align_ft=oc.align_ft,fc.align_rr=oc.align_rr,fc.width_ft=oc.width_ft,fc.width_rr=oc.width_rr,fc.wheel_radius=oc.wheel_radius,"\
        "fc.comfort=oc.comfort,fc.sport=oc.sport,fc.drift=oc.drift,fc.sport_plus=oc.sport_plus,"\
        "fc.comfort1=oc.comfort1,fc.sport1=oc.sport1,fc.drift1=oc.drift1,fc.sport_plus1=oc.sport_plus1,"\
        "fc.comfort2=oc.comfort2,fc.sport2=oc.sport2,fc.drift2=oc.drift2,fc.sport_plus2=oc.sport_plus2,"\
        "fc.comfort3=oc.comfort3,fc.sport3=oc.sport3,fc.drift3=oc.drift3,fc.sport_plus3=oc.sport_plus3,"\
        "fc.comfort4=oc.comfort4,fc.sport4=oc.sport4,fc.drift4=oc.drift4,fc.sport_plus4=oc.sport_plus4,"\
        "fc.vinil_current=oc.vinil_current,fc.exhsuast_current=oc.exhsuast_current,fc.strab_current=oc.strab_current,fc.EnableNeon=oc.EnableNeon,fc.horn_current=oc.horn_current,"\
        "fc.highlight_type=oc.highlight_type,fc.stroboscope_type=oc.stroboscope_type,fc.exhaust_type=oc.exhaust_type,fc.horn_id=oc.horn_id,fc.hydraulic=oc.hydraulic,fc.brake_level=oc.brake_level,"\
        "fc.color_body_r=oc.color_body_r,fc.color_body_g=oc.color_body_g,fc.color_wheels=oc.color_wheels,fc.light_color=oc.light_color,fc.neon_center=oc.neon_center,fc.neon_left=oc.neon_left,fc.neon_right=oc.neon_right "\
        "WHERE fc.id=%d", database_car, family_database);
    mysql_query(mysql, query, false);
    if(mysql_errno()) printf("[FAMILY CAR] scalar tuning copy error: %d", mysql_errno());

    
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO family_car_components (family_car_id,componentid,state) "\
        "SELECT %d,componentid,state FROM vehicle_store_components WHERE vehicleid=%d "\
        "ON DUPLICATE KEY UPDATE state=VALUES(state)",
        family_database, database_car
    );
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        printf("[FAMILY CAR] MoveOwnableCar family tuning copy error: %d", mysql_errno());
        mysql_format(mysql, query, sizeof query, "DELETE FROM family_cars WHERE id=%d LIMIT 1", family_database);
        mysql_query(mysql, query, false);
        mysql_format(mysql, query, sizeof query, "DELETE FROM family_car_components WHERE family_car_id=%d", family_database);
        mysql_query(mysql, query, false);
        return 0;
    }

    
    if(UnloadOwnableCarBySqlID(playerid, database_car) != 1)
    {
        new old_vehicleid = GetOwnableCarBySqlID(database_car, g_GetOwnableCarBySqlIDBuffer);
        if(old_vehicleid != INVALID_VEHICLE_ID)
        {
            DestroyVehicleLabel(old_vehicleid);
            DestroyVehicle(old_vehicleid);
        }
        SetPlayerData(playerid, P_OWNABLE_CAR, INVALID_VEHICLE_ID);
    }

    mysql_format(mysql, query, sizeof query, "DELETE FROM vehicle_store_components WHERE vehicleid=%d", database_car);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query, "DELETE FROM ownable_cars WHERE id=%d LIMIT 1", database_car);
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        printf("[FAMILY CAR] MoveOwnableCar DELETE error: %d", mysql_errno());
        mysql_format(mysql, query, sizeof query, "DELETE FROM vehicle_store_components WHERE vehicleid=%d", family_database);
        mysql_query(mysql, query, false);
        mysql_format(mysql, query, sizeof query, "DELETE FROM family_cars WHERE id=%d LIMIT 1", family_database);
        mysql_query(mysql, query, false);
        return 0;
    }

    SendClientMessage(playerid, -1, ""c_f_g" \xc2\xfb \xf3\xf1\xef\xe5\xf8\xed\xee \xe4\xee\xe1\xe0\xe2\xe8\xeb\xe8 \xf2\xf0\xe0\xed\xf1\xef\xee\xf0\xf2 \xe2 \xf1\xe5\xec\xfc\xfe.");
    new family_model_name[64];
    GetVehicleModelName(model_id, family_model_name, sizeof family_model_name);
    format(f_string144, sizeof f_string144, "\xc2\xeb\xe0\xe4\xe5\xeb\xe5\xf6 %s \xe4\xee\xe1\xe0\xe2\xe8\xeb \xe2 \xf1\xe5\xec\xfc\x8e \xe0\xe2\xf2\xee\xec\xee\xe1\xe8\xeb\xfc %s", GetPlayerNameEx(playerid), family_model_name);
    SendFamilyMessage(fam_id, f_string144);
    AddFamily(fam_id, family_count_veh, +, 1);

    return 1;
}

stock MoveFamilyCar(database_car, playerid)
{
    new fam = GetPlayerIdFamily(playerid);

    mysql_format(mysql, f_string64, sizeof f_string64, "SELECT * FROM family_cars WHERE id=%d", database_car);
    new Cache:cache_sql = mysql_query(mysql, f_string64, true);

    if(mysql_errno())
        return SendClientMessage(playerid,-1,""c_f_r" \xce\xf8\xe8\xe1\xea\xe0 \xe2 SQL-\xe7\xe0\xef\xf0\xee\xf1\xe5 / Code: MoveFamilyCar");

    if(!cache_num_rows())
    {
        cache_delete(cache_sql);
        return SendClientMessage(playerid,-1,""c_f_r" \xd2\xf0\xe0\xed\xf1\xef\xee\xf0\xf2 \xed\xe5 \xed\xe0\xe9\xe4\xe5\xed.");
    }

    new model_id, color_1, color_2, number[32], region[8], number_type;
    new move_vinyl_name[32];
    new saved_body_colors, saved_wheel_colors, saved_wheel_comp;
    new saved_toner_front, saved_toner_rear, saved_tonir_ft, saved_tonir_rr;
    new Float:pos_x, Float:pos_y, Float:pos_z, Float:angle;

    model_id = cache_get_field_content_int(0, "model_id");
    color_1 = cache_get_field_content_int(0, "color_1");
    color_2 = cache_get_field_content_int(0, "color_2");
    saved_body_colors = cache_get_field_content_int(0, "body_colors");
    saved_wheel_colors = cache_get_field_content_int(0, "wheel_colors");
    saved_wheel_comp = cache_get_field_content_int(0, "wheel_comp");
    saved_toner_front = cache_get_field_content_int(0, "toner_front");
    saved_toner_rear = cache_get_field_content_int(0, "toner_rear");
    saved_tonir_ft = cache_get_field_content_int(0, "tonir_ft");
    saved_tonir_rr = cache_get_field_content_int(0, "tonir_rr");
    pos_x = cache_get_field_content_float(0, "pos_x");
    pos_y = cache_get_field_content_float(0, "pos_y");
    pos_z = cache_get_field_content_float(0, "pos_z");
    angle = cache_get_field_content_float(0, "angle");
    cache_get_field_content(0, "number", number, mysql, sizeof number);
    cache_get_field_content(0, "region", region, mysql, sizeof region);
    cache_get_field_content(0, "vynil_name", move_vinyl_name, mysql, sizeof move_vinyl_name);
    number_type = cache_get_field_content_int(0, "number_type");
    cache_delete(cache_sql);

    new stored_number[32];
    FamilyBuildStoredPlateValue(number_type, number, region, stored_number, sizeof stored_number);

    new query[8192];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ownable_cars "\
        "(owner_id, model_id, color_1, color_2, body_colors, wheel_colors, wheel_comp, toner_front, toner_rear, tonir_ft, tonir_rr, pos_x, pos_y, pos_z, angle, create_time, number, vynil_name) "\
        "VALUES (%d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %f, %f, %f, %f, %d, '%e', '%e')",
        GetPlayerAccountID(playerid), model_id, color_1, color_2, saved_body_colors, saved_wheel_colors, saved_wheel_comp, saved_toner_front, saved_toner_rear, saved_tonir_ft, saved_tonir_rr,
        pos_x, pos_y, pos_z, angle, gettime(), stored_number, move_vinyl_name
    );
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        printf("[FAMILY CAR] MoveFamilyCar INSERT error: %d", mysql_errno());
        return 0;
    }

    new ownable_database = cache_insert_id();

    mysql_format(mysql, query, sizeof query,
        "UPDATE ownable_cars oc JOIN family_cars fc ON fc.id=%d SET "\
        "oc.f_state=fc.f_state,oc.nitro_level=fc.nitro_level,oc.launch=fc.launch,oc.pdvradar=fc.pdvradar,"\
        "oc.lights_color=fc.lights_color,oc.underlights_color=fc.underlights_color,oc.underlights_color_lf=fc.underlights_color_lf,oc.underlights_color_rt=fc.underlights_color_rt,"\
        "oc.is_FarLight_active=fc.is_FarLight_active,oc.pnevmo_selected=fc.pnevmo_selected,oc.percentofclirness=fc.percentofclirness,oc.percentofclirnessZ=fc.percentofclirnessZ,"\
        "oc.is_hydro_active=fc.is_hydro_active,oc.is_hydro_bought=fc.is_hydro_bought,oc.is_FarLight_bought=fc.is_FarLight_bought,oc.is_pnevmo_bought=fc.is_pnevmo_bought,"\
        "oc.vinilcar=fc.vinilcar,oc.iscase=fc.iscase,oc.pt_engine=fc.pt_engine,oc.pt_brake=fc.pt_brake,oc.pt_stability=fc.pt_stability,"\
        "oc.supercharger=fc.supercharger,oc.pt_turbo=fc.pt_turbo,oc.wheel_offset_ft=fc.wheel_offset_ft,oc.wheel_offset_rr=fc.wheel_offset_rr,"\
        "oc.align_ft=fc.align_ft,oc.align_rr=fc.align_rr,oc.width_ft=fc.width_ft,oc.width_rr=fc.width_rr,oc.wheel_radius=fc.wheel_radius,"\
        "oc.comfort=fc.comfort,oc.sport=fc.sport,oc.drift=fc.drift,oc.sport_plus=fc.sport_plus,"\
        "oc.comfort1=fc.comfort1,oc.sport1=fc.sport1,oc.drift1=fc.drift1,oc.sport_plus1=fc.sport_plus1,"\
        "oc.comfort2=fc.comfort2,oc.sport2=fc.sport2,oc.drift2=fc.drift2,oc.sport_plus2=fc.sport_plus2,"\
        "oc.comfort3=fc.comfort3,oc.sport3=fc.sport3,oc.drift3=fc.drift3,oc.sport_plus3=fc.sport_plus3,"\
        "oc.comfort4=fc.comfort4,oc.sport4=fc.sport4,oc.drift4=fc.drift4,oc.sport_plus4=fc.sport_plus4,"\
        "oc.vinil_current=fc.vinil_current,oc.exhsuast_current=fc.exhsuast_current,oc.strab_current=fc.strab_current,oc.EnableNeon=fc.EnableNeon,oc.horn_current=fc.horn_current,"\
        "oc.highlight_type=fc.highlight_type,oc.stroboscope_type=fc.stroboscope_type,oc.exhaust_type=fc.exhaust_type,oc.horn_id=fc.horn_id,oc.hydraulic=fc.hydraulic,oc.brake_level=fc.brake_level,"\
        "oc.color_body_r=fc.color_body_r,oc.color_body_g=fc.color_body_g,oc.color_wheels=fc.color_wheels,oc.light_color=fc.light_color,oc.neon_center=fc.neon_center,oc.neon_left=fc.neon_left,oc.neon_right=fc.neon_right "\
        "WHERE oc.id=%d", database_car, ownable_database);
    mysql_query(mysql, query, false);
    if(mysql_errno()) printf("[FAMILY CAR] scalar tuning restore error: %d", mysql_errno());

    
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO vehicle_store_components (vehicleid,componentid,state) "\
        "SELECT %d,componentid,state FROM family_car_components WHERE family_car_id=%d "\
        "ON DUPLICATE KEY UPDATE state=VALUES(state)",
        ownable_database, database_car
    );
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        printf("[FAMILY CAR] MoveFamilyCar tuning restore error: %d", mysql_errno());
        mysql_format(mysql, query, sizeof query, "DELETE FROM ownable_cars WHERE id=%d LIMIT 1", ownable_database);
        mysql_query(mysql, query, false);
        return 0;
    }

    mysql_format(mysql, query, sizeof query, "DELETE FROM vehicle_store_components WHERE vehicleid=%d", database_car);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query, "DELETE FROM family_car_components WHERE family_car_id=%d", database_car);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query, "DELETE FROM family_cars WHERE id=%d LIMIT 1", database_car);
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        printf("[FAMILY CAR] MoveFamilyCar DELETE error: %d", mysql_errno());
        return 0;
    }

    SendClientMessage(playerid, -1, ""c_f_g" \xc2\xfb \xf3\xf1\xef\xe5\xf8\xed\xee \xe7\xe0\xe1\xf0\xe0\xeb\xe8 \xf2\xf0\xe0\xed\xf1\xef\xee\xf0\xf2 \xe8\xe7 \xf1\xe5\xec\xfc\xe8.");
    new family_model_name_take[64];
    GetVehicleModelName(model_id, family_model_name_take, sizeof family_model_name_take);
    format(f_string144, sizeof f_string144, "\xc2\xeb\xe0\xe4\xe5\xeb\xe5\xf6 %s \xe7\xe0\xe1\xf0\xe0\xeb \xe8\xe7 \xf1\xe5\xec\xfc\xe8 \xe0\xe2\xf2\xee\xec\xee\xe1\xe8\xeb\xfc %s", GetPlayerNameEx(playerid), family_model_name_take);
    SendFamilyMessage(fam, f_string144);
    AddFamily(fam, family_count_veh, -, 1);

    return 1;
}

stock LoadFamilyCar(database)
{
    if(GetStatusFamilyCar(database)) return 0;

    new rows, vehicleid;
    new Cache: result;

    mysql_format(mysql, f_string64, sizeof f_string64, "SELECT * FROM family_cars WHERE id=%d", database);
    result = mysql_query(mysql, f_string64, true);
    rows = cache_num_rows();

    if(!rows) return 1;

    new loaded_model_id = cache_get_field_content_int(0, "model_id");
    if(loaded_model_id < 400)
    {
        printf("[FAMILY CAR] LoadFamilyCar invalid model_id=%d database=%d", loaded_model_id, database);
        cache_delete(result);
        return 0;
    }

    new free_id = GetFreeIDFamilyCar();
    if(free_id == -1)
    {
        cache_delete(result);
        return 0;
    }
    SetCarFamily(free_id, CAR_F_database,       cache_get_field_content_int(0, "id"));

    SetCarFamily(free_id, OW_F_database,     cache_get_field_content_int(0, "family_owner"));
    SetCarFamily(free_id, OW_F_server,     GetFamilyIDSQL(GetCarFamily(free_id, OW_F_database)));

    SetCarFamily(free_id, V_F_MODEL,     cache_get_field_content_int(0, "model_id"));
    SetCarFamily(free_id, V_F_COLOR_1,      cache_get_field_content_int(0, "color_1"));
    SetCarFamily(free_id, V_F_COLOR_2,      cache_get_field_content_int(0, "color_2"));
    SetCarFamily(free_id, V_F_RANG,         cache_get_field_content_int(0, "rang"));

    SetCarFamily(free_id, V_F_SPAWN_X,        cache_get_field_content_float(0, "pos_x"));
    SetCarFamily(free_id, V_F_SPAWN_Y,        cache_get_field_content_float(0, "pos_y"));
    SetCarFamily(free_id, V_F_SPAWN_Z,        cache_get_field_content_float(0, "pos_z"));
    SetCarFamily(free_id, V_F_SPAWN_A,        cache_get_field_content_float(0, "angle"));
   
    SetCarFamily(free_id, V_F_SPAWN_LAST_X,        cache_get_field_content_float(0, "pos_last_x"));
    SetCarFamily(free_id, V_F_SPAWN_LAST_Y,        cache_get_field_content_float(0, "pos_last_y"));
    SetCarFamily(free_id, V_F_SPAWN_LAST_Z,        cache_get_field_content_float(0, "pos_last_z"));
    SetCarFamily(free_id, V_F_SPAWN_LAST_A,        cache_get_field_content_float(0, "angle_last"));

    SetCarFamily(free_id, V_F_COUNT_BOX,        0);
    SetCarFamily(free_id, V_F_TEXT_CONT,        STREAMER_TAG_3D_TEXT_LABEL:-1);
    SetCarFamily(free_id, V_F_AREA_CONT,        -1);
    SetCarFamily(free_id, V_F_STATUS_CONT,      false);

    cache_get_field_content(0, "number", vehicle_family[free_id][V_F_NUMBER], mysql, 32);
    cache_get_field_content(0, "vynil_name", vehicle_family[free_id][V_F_VINYL_NAME], mysql, 32);
    cache_get_field_content(0, "region", vehicle_family[free_id][V_F_REGION], mysql, 8);
    SetCarFamily(free_id, V_F_NUMBER_TYPE,      cache_get_field_content_int(0, "number_type"));

    
    
    new family_plate_type = GetCarFamily(free_id, V_F_NUMBER_TYPE);
    new family_plate[16], family_region[8];
    if(strfind(vehicle_family[free_id][V_F_NUMBER], "|", true) != -1)
    {
        if(ParseStoredPlateValue(vehicle_family[free_id][V_F_NUMBER], family_plate_type, family_plate, sizeof family_plate, family_region, sizeof family_region))
        {
            format(vehicle_family[free_id][V_F_NUMBER], 32, "%s", family_plate);
            if(PlateTypeUsesRegion(family_plate_type))
                format(vehicle_family[free_id][V_F_REGION], 8, "%s", family_region);
            else
                format(vehicle_family[free_id][V_F_REGION], 8, "");
            SetCarFamily(free_id, V_F_NUMBER_TYPE, family_plate_type);
        }
    }
    SetCarFamily(free_id, V_F_FSTATE,           cache_get_field_content_int(0, "f_state"));
    SetCarFamily(free_id, V_F_NITRO,            cache_get_field_content_int(0, "nitro_level"));
    SetCarFamily(free_id, V_F_LAUNCH,           cache_get_field_content_int(0, "launch"));
    SetCarFamily(free_id, V_F_PDVRADAR,         cache_get_field_content_int(0, "pdvradar"));
    SetCarFamily(free_id, V_F_LIGHTS_COLOR,     cache_get_field_content_int(0, "lights_color"));
    SetCarFamily(free_id, V_F_UNDERLIGHT_COLOR, cache_get_field_content_int(0, "underlights_color"));
    SetCarFamily(free_id, V_F_UNDERLIGHT_COLOR_LF, cache_get_field_content_int(0, "underlights_color_lf"));
    SetCarFamily(free_id, V_F_UNDERLIGHT_COLOR_RT, cache_get_field_content_int(0, "underlights_color_rt"));
    SetCarFamily(free_id, V_F_IS_FAR_LIGHT_ACTIVE, cache_get_field_content_int(0, "is_FarLight_active"));
