                        reputation = cache_get_field_content_int(i, "reputation");

                        if(database_family == id)
                        {
                            format(name_pl, sizeof name_pl, name);
                            rep_pl = reputation;
                            mesto = i+1;
                        } 

                        if(count != 10)
                        {
                            format(list, sizeof list, "{FFFFFF} №%d %s %d\n", i+1, name, reputation);
                            strcat(dialog, list);
                            count++;
