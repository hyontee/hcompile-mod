	JSON_SetInt(donate_outcoming_json, "lt", 0); 
	JSON_SetInt(donate_outcoming_json, "lv", GetPlayerLevel(playerid)); 
	JSON_SetInt(donate_outcoming_json, "l", GetPlayerLevel(playerid)); 
	JSON_SetInt(donate_outcoming_json, "mtd", 1488); 
	JSON_SetInt(donate_outcoming_json, "ns", 222); 
	JSON_SetInt(donate_outcoming_json, "op", 0); 
	JSON_SetInt(donate_outcoming_json, "pi", 0); 
	JSON_SetInt(donate_outcoming_json, "ps", 0); 
	JSON_SetInt(donate_outcoming_json, "p", 1337); 
	JSON_SetInt(donate_outcoming_json, "pp", 1337); 
	JSON_SetInt(donate_outcoming_json, "sn", 222); 
	JSON_SetInt(donate_outcoming_json, "sp", 0); 
	JSON_SetInt(donate_outcoming_json, "s", 0); 
	JSON_SetInt(donate_outcoming_json, "tk", 0); 
	JSON_SetInt(donate_outcoming_json, "sb", 0); 
	JSON_SetInt(donate_outcoming_json, "tb", 0); 
	JSON_SetInt(donate_outcoming_json, "tc", 0); 
	JSON_SetInt(donate_outcoming_json, "td", 1337); 
	JSON_SetInt(donate_outcoming_json, "th", 2334); 
	JSON_SetInt(donate_outcoming_json, "tm", 0); 
	JSON_SetInt(donate_outcoming_json, "ty", 0); 
	JSON_SetInt(donate_outcoming_json, "t", 0); 

	if(strcmp("None", GetPlayerData(playerid, P_EMAIL)))
