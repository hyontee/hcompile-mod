stock EntryAccessoryMarket(playerid)
{
    pl_accessory[playerid] = 0;
    SetPlayerPosEx(playerid, 2896.610839,1496.067871,2499.343750,355.015014, 1, playerid+1);
    HideHud(playerid);
    TogglePlayerControllable(playerid, false);

   

    InterpolateCameraPos(playerid, 2901.951660,1498.124877,2499.343750, 2900.450927,1500.220703,2499.363750, 2000, CAMERA_MOVE);
    InterpolateCameraLookAt(playerid, 2903.739257,1499.161499,2499.343750, 2899.104980,1503.386230,2499.562500, 2000, CAMERA_MOVE);

    pl_id_accessory[playerid] = CreatePlayerObject(playerid, accessory[0][ID_ACCESSORY], 2899.104980,1503.386230,2499.062500, 0.0, 0.0, 0.0);
        
    CreatePlTDButtonBR(playerid);

    SetPriceAccesory(playerid, 0);

    SelectTextDraw(playerid, 0xFF5252FF);
    for(new i;i < sizeof button_TD;i++) TextDrawShowForPlayer(playerid, button_TD[i]);
    PlayerTextDrawShow(playerid, button_PTD[playerid][0]);

    new Float:x, Float:y, Float:z, string[124];
    GetPlayerCameraPos(playerid, x, y, z);
    return 1;
}

stock SetPriceAccesory(playerid, acs)
{
    new string[24];
    format(string, sizeof string, "‰EHA:%d", accessory[acs][PRICE_ACCESSORY]);
    PlayerTextDrawSetString(playerid, button_PTD[playerid][0], string);

    return 1;
}

CMD:myacs(playerid)
{
	new fmt_text[640],
	Cache: result,
	id;

    mysql_format(mysql, fmt_text, sizeof fmt_text, "SELECT * FROM accessory_inventory WHERE player_id='%d'", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, fmt_text, true);

    new rows = cache_num_rows();

    if(!rows) SendClientMessage(playerid, 0x999999FF, "У Вас нет аксессуаров");
    else
    {	
            new query[78],
                acs, use, acs_use[24];

            format(fmt_text, sizeof fmt_text, "");

            for(new i = 0; i < rows; i ++)
            {
                id = cache_get_field_content_int(i, "id");
                acs = cache_get_field_content_int(i, "acs_id");
                use = cache_get_field_content_int(i, "use");

                if(use > 0) acs_use = "{636363}[используется]";
                else  acs_use = "";

                format
                (
                    query,
                    sizeof query,
                    "{FFFFFF}%d. %s %s\n",
                    i + 1, 
                    accessory[acs][NAME_ACCESSORY], acs_use
                );
                strcat(fmt_text, query);
                SetPlayerListitemValue(playerid, i, id);

                format(query, sizeof query, "acsuse%d", i);
                SetPVarInt(playerid, query, use);
            }

            Dialog
            (
                playerid, 1190, DIALOG_STYLE_LIST,
                "{FFCD00}Выберите акссесуар",
                fmt_text,
                "Выбрать", "Закрыть"
            );
    }

    cache_delete(result);

	return 1;
}
public LoadAccessory(playerid)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
        return 0;

    new query[220], rows, Cache:result;

    format(query, sizeof(query),
        "SELECT * FROM accessories_players WHERE player_id = %d",
        account_id
    );

    result = mysql_query(mysql, query, true);
    rows = cache_num_rows();

    printf("[ACS] LoadAccessory: player=%d account_id=%d rows=%d", playerid, account_id, rows);

    if(rows > 0)
    {
        new slot, acs, bone;
        new Float:x, Float:y, Float:z;
        new Float:rX, Float:rY, Float:rZ;
        new Float:scale;

        for(new i = 0; i < rows; i++)
        {
            slot  = cache_get_field_content_int(i, "slot");
            acs   = cache_get_field_content_int(i, "acs_id");
            bone  = cache_get_field_content_int(i, "bone");

            x     = cache_get_field_content_float(i, "x");
            y     = cache_get_field_content_float(i, "y");
            z     = cache_get_field_content_float(i, "z");

            rX    = cache_get_field_content_float(i, "rX");
            rY    = cache_get_field_content_float(i, "rY");
            rZ    = cache_get_field_content_float(i, "rZ");

            scale = cache_get_field_content_float(i, "scale");

            
            if(slot == 0 && acs == 0 && bone == 0 &&
               x == 0.0 && y == 0.0 && z == 0.0 &&
               rX == 0.0 && rY == 0.0 && rZ == 0.0 &&
               scale == 0.0)
            {
                printf("[ACS] skip empty row=%d player=%d", i, playerid);
                continue;
            }

            
            if(slot < 0 || slot > 10 || !InvV3_IsActiveAccSlot(slot))
            {
                printf("[ACS] skip row=%d invalid/inactive slot=%d", i, slot);
                continue;
            }

            if(acs <= 0 || acs >= sizeof(accessory))
            {
                printf("[ACS] skip row=%d invalid acs=%d", i, acs);
                continue;
            }

            new loaded_model = accessory[acs][ID_ACCESSORY];
            if(loaded_model <= 0)
            {
                printf("[ACS] skip row=%d invalid model from acs=%d", i, acs);
                continue;
            }

            
            
            new acc_index = FindAccsDataIndexByModel(loaded_model);
            if(acc_index != -1)
            {
                if(bone <= 0) bone = AccsData[acc_index][accBone];
                if(x == 0.0 && y == 0.0 && z == 0.0)
                {
                    x = AccsData[acc_index][accX];
                    y = AccsData[acc_index][accY];
                    z = AccsData[acc_index][accZ];
                }
                if(rX == 0.0 && rY == 0.0 && rZ == 0.0)
                {
                    rX = AccsData[acc_index][accRotX];
                    rY = AccsData[acc_index][accRotY];
                    rZ = AccsData[acc_index][accRotZ];
                }
                if(scale <= 0.0) scale = AccsData[acc_index][accScaleX];
            }

            if(bone <= 0)
            {
                bone = accessory[acs][BONE_ACCESSORY];
            }

            if(bone <= 0)
            {
                printf("[ACS] skip row=%d invalid bone=%d model=%d", i, bone, loaded_model);
                continue;
            }

            if(scale <= 0.0) scale = 1.0;

            SetPlayerAttachedObject(
                playerid,
                slot,
                loaded_model,
                bone,
                x, y, z,
                rX, rY, rZ,
                scale, scale, scale
            );

            gPlayerTempAccData[playerid][slot][0] = float(loaded_model);
            gPlayerTempAccData[playerid][slot][1] = float(bone);
            gPlayerTempAccData[playerid][slot][2] = x;
            gPlayerTempAccData[playerid][slot][3] = y;
            gPlayerTempAccData[playerid][slot][4] = z;
            gPlayerTempAccData[playerid][slot][5] = rX;
            gPlayerTempAccData[playerid][slot][6] = rY;
            gPlayerTempAccData[playerid][slot][7] = rZ;
            gPlayerTempAccData[playerid][slot][8] = scale;
            gPlayerTempAccData[playerid][slot][9] = scale;
            gPlayerTempAccData[playerid][slot][10] = scale;

            printf("[ACS] apply row=%d player=%d slot=%d acs=%d model=%d bone=%d x=%.4f y=%.4f z=%.4f rx=%.2f ry=%.2f rz=%.2f scale=%.4f",
                i, playerid, slot, acs, loaded_model, bone, x, y, z, rX, rY, rZ, scale
            );
        }
    }

    cache_delete(result);
    return 1;
}
#endif
CMD:snyat(playerid, params[])
{
    #pragma unused params

    new removed = 0;

    
    for(new active_slot = 1; active_slot <= 7; active_slot++)
    {
        if(active_slot == 6) continue;

        
        new inventory_slot = -1;
        new modelid = 0;

        if(Inventory11_MoveActiveAccessoryToInventorySlot(playerid, 0, active_slot, inventory_slot, modelid))
        {
            removed++;
        }
    }

    if(removed > 0)
    {
        SendClientMessage(playerid, 0xFFFFFFFF, "{FF5252}| {FFFFFF}Snyato aksessuarov: %d. Vse snyatye aksessuary vozvrashcheny v inventar.", removed);
        ShowPlayerInventoryV3(playerid);
    }
    else
    {
        SendClientMessage(playerid, 0x999999FF, "{FF5252}| {FFFFFF}Na persone net odenetykh aksessuarov.");
    }

    return 1;
}
