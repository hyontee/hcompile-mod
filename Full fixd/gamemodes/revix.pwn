        1. Изменить управляемую фракцию\n\
        2. Разжаловать лидера\n\
        {ff3300}3. Заблокировать аккаунт\
        ",
        "Выбрать", "Отмена"
    );

    return 1;
}
			
			case DIALOG_TELEPORT_LIST:
			{
				if(response)
				{
					if(0 <= listitem <= sizeof g_teleport_list - 1)
					{
