        ""c_server"7. "c_b"Вступить в семью\t\t\t\t%s\n"\
        ""c_server"8. "c_b"Приобрести первый автомобиль\t\t\t\t%s\n",
        GetPlayerData(playerid, P_QUEST_1) ? "{FFFF00}Выполнено" : "{32CD32}Доступно",
