stock GetTuneIdFromItem(id)
{
    if(id < 0 || id > MAX_TUNE_ITEM_ID) return 0;
    return ItemTuneId[id];
}

public OnPlayerPickUpPickupEx(playerid, pickupid, action_type, action_id)
{
    if(HandlePickupPoint(playerid, pickupid)) return 1;
    if(TaxiCompany_HandlePickup(playerid, pickupid)) return 1;
    
	if(pickupid == RazdewPravo)
	{
	    if(GetPlayerTeamEx(playerid) != TEAM_GOVERNMENT) return SendClientMessage(playerid, 0x999999FF, ""USC"Вам не доступен данный раздел");
		if(GetPlayerData(playerid, P_WORK_DAY) == 0)
	    {
	        Dialog
	        (
	            playerid, DIALOG_WORKDAY_START, DIALOG_STYLE_MSGBOX,
	            "{FF5252}"SERVER_NAME"{ffffff} | Рабочий день",
