    return 1;
}

stock SendTurnSignalRPC(playerid, vehicleid, subtype)
{
    new BitStream:bs = BS_New();

    BS_WriteValue(
        bs,
        PR_UINT32, 3,
        PR_UINT16, vehicleid,
        PR_UINT8, subtype
    );

    PR_SendRPC(
        bs,
        playerid,
        97,
        PR_HIGH_PRIORITY,
        PR_RELIABLE_ORDERED
    );

    BS_Delete(bs);
	return 1;
}

public OnIncomingRPC(playerid, rpcid, BitStream:bs)
{
    if (rpcid == 97)
    {
        new firstValue;

        if (!BS_ReadUint32(bs, firstValue))
            return 1;

        
		if (firstValue == 3)
        {
			new vehicleNetId;
            new podSubtype;

            if (!BS_ReadUint16(bs, vehicleNetId)) return 1;
            if (!BS_ReadUint8(bs, podSubtype)) return 1;

            new vehicleid = vehicleNetId;
            if (vehicleid != INVALID_VEHICLE_ID)
            {

                if (podSubtype < 1 || podSubtype > 3) {
                    return 1;
                }
				SendTurnSignalRPC(playerid, vehicleid, 3);
            }
            return 1;
		} 
        if (firstValue == 1)
        {
            new vehicleNetId;
            new Float:damage;
            new damagedPiece;

            if (!BS_ReadUint16(bs, vehicleNetId)) return 1;
            if (!BS_ReadFloat(bs, damage)) return 1;
            if (!BS_ReadUint16(bs, damagedPiece)) return 1;

            new vehicleid = vehicleNetId;
            if (vehicleid != INVALID_VEHICLE_ID)
            {
                new tick = GetTickCount();

                if (tick - gLastVehicleDamageTick[playerid] < 600)
                    return 0;

                gLastVehicleDamageTick[playerid] = tick;

                ApplyVehicleDamage(playerid, vehicleid, damage, damagedPiece);
            }
            return 1;
        }

        
        new action = firstValue;
        new actionSubtype;

        if (action == 14)
        {
            if (!BS_ReadUint8(bs, actionSubtype))
                return 1;

            switch (actionSubtype)
            {
                case 0:
                {
                    BlackPass_OpenTasksScreen(playerid);
                }
                case 1:
                {
                    BlackPass_OpenTasksScreen(playerid);
                }
                case 2:
                {
                    callcmd::donate(playerid);
                }
                case 3:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 4:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 5:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 6:
                {
                    ShowPlayerDialog_Example(playerid);
                }
            }
        }

        switch (action)
        {
            case 3:
            {
            }
            case 4:
            {
                callcmd::radial(playerid);
            }
            case 18:
            {
                if(IsPlayerNearHR(playerid) || GetPVarInt(playerid, "hr_interaction_window"))
                {
                    ToggleInteractionWindow(playerid, false);
                    if(GetPlayerTeamEx(playerid) != TEAM_NONE)
                        return SendClientMessage(playerid, -1, "{FFFF00}\xc2\xfb \xf3\xe6\xe5 \xf1\xee\xf1\xf2\xee\xe8\xf2\xe5 \xe2 \xee\xf0\xe3\xe0\xed\xe8\xe7\xe0\xf6\xe8\xe8.");
                    Dialog(playerid, DIALOG_HR_Q1, DIALOG_STYLE_MSGBOX,
                        "{FF5252}"SERVER_NAME"{ffffff} | \xcf\xf0\xe8\xb8\xec \xed\xe0 \xf0\xe0\xe1\xee\xf2\xf3",
                        "{FFFFFF}\xce\xf2\xe2\xe5\xf2\xf1\xf2\xe2\xe5\xed\xed\xfb \xeb\xe8 \xe2\xfb \xe7\xe0 \xe4\xee\xeb\xe6\xed\xee\xf1\xf2\xfc?",
                        "Yes", "No");
                    return 1;
                }

                if(IsPlayerAtATM(playerid))
                {
                    return callcmd::bankomat(playerid, "");
                }

                if (IsPlayerInRangeOfAnyCasinoTable(playerid))
                {
                    return ShowCasinoDiceUi(playerid);
                }

                if (IsPlayerInRangeOfAnyBlackJackTable(playerid))
                {
                    return callcmd::blackjack(playerid);
                }

                if(IsPlayerNearMotoSalonRange(playerid))
                {
                    DebugMotoSalonLog(playerid, "Interaction:MOTO_RANGE:open_market");
                    ToggleInteractionWindow(playerid, false);
                    return EnterPlayerBuyCarMarket(playerid, STATIC_BIZ_ID_MOTO_SALON);
                }

                return 1;
            }
        }

        return 1;
    }

    return 1;
}
