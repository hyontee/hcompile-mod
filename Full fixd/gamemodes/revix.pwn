#define TAXI_COMPANY_PICKUP_MODEL       (19132)
#define TAXI_COMPANY_PICKUP_X            (2504.0)
#define TAXI_COMPANY_PICKUP_Y            (2010.0)
#define TAXI_COMPANY_PICKUP_Z            (15.0)
#define TAXI_COMPANY_PICKUP_INTERIOR     (5)
#define TAXI_COMPANY_PICKUP_WORLD        (98)

#define TAXI_FLEET_COUNT                 (3)
new g_taxi_company_pickup = INVALID_STREAMER_ID;
new g_taxi_fleet[TAXI_FLEET_COUNT];

static const g_taxi_fleet_model[TAXI_FLEET_COUNT] = {426, 2548, 585}; 
static const Float:g_taxi_fleet_spawn[TAXI_FLEET_COUNT][4] =
{
    {379.800000, 1339.128417, 15.194649, 358.562896},
    {385.278442, 1339.128417, 15.194649, 358.562896},
    {390.758000, 1339.128417, 15.194649, 358.562896}
};

stock TaxiCompany_Init()
{
    
    g_taxi_company_pickup = CreateDynamicPickup(
        TAXI_COMPANY_PICKUP_MODEL, 23,
        TAXI_COMPANY_PICKUP_X, TAXI_COMPANY_PICKUP_Y, TAXI_COMPANY_PICKUP_Z,
        TAXI_COMPANY_PICKUP_WORLD, TAXI_COMPANY_PICKUP_INTERIOR, -1, 20.0
    );

    CreateDynamic3DTextLabel(
        "{FFFF00}Компания Такси\n{FFFFFF}Подойдите для взаимодействия",
        0xFFFFFFFF,
        TAXI_COMPANY_PICKUP_X, TAXI_COMPANY_PICKUP_Y, TAXI_COMPANY_PICKUP_Z + 0.9,
        12.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
        TAXI_COMPANY_PICKUP_WORLD, TAXI_COMPANY_PICKUP_INTERIOR
    );

    
    for(new i = 0; i < TAXI_FLEET_COUNT; i++)
    {
        g_taxi_fleet[i] = CreateVehicle(
            g_taxi_fleet_model[i],
            g_taxi_fleet_spawn[i][0], g_taxi_fleet_spawn[i][1],
            g_taxi_fleet_spawn[i][2], g_taxi_fleet_spawn[i][3],
            6, 6, 300
        );

        if(g_taxi_fleet[i] != INVALID_VEHICLE_ID)
        {
            new plate[16];
            RandomNumberPlateByType(TYPE_RU, plate, sizeof(plate));
            SetVehicleNumberPlateEx(g_taxi_fleet[i], TYPE_RU, plate, "52");
            SetVehicleParamsEx(g_taxi_fleet[i], VEHICLE_PARAMS_ON, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF);
        }
    }

    return 1;
}

stock TaxiCompany_HandlePickup(playerid, pickupid)
{
    if(pickupid != g_taxi_company_pickup) return 0;

    SendClientMessage(playerid, 0xCECECEFF, "Компания Такси: раздел находится в разработке.");
    return 1;
}

public OnGameModeInit()
{
    for(new i;i < MAX_PLAYERS;i++) SetPlayerFamily(i, ID_FAMILY, -1);
    for(new i;i < MAX_FAM;i++) SetFamily(i, family_database, -1);
    for(new i;i < MAX_OWNABLE_CARS;i++) SetCarFamily(i, CAR_F_database, -1);

    Calendar_Init();
    SetTimer("CREATE_ACCOUNTS_TABLE", 300, false);
    SetTimer("welsi_LoadFamily", 1600, false);
    SetTimer("CheckMutePlayer", 1000, true);
    #if defined fam_OnGameModeInit
        return fam_OnGameModeInit();
    #else
        return 1;
    #endif
}
   #if defined _ALS_OnGameModeInit
    #undef OnGameModeInit
#else
    #define _ALS_OnGameModeInit
#endif
#define OnGameModeInit fam_OnGameModeInit
#if defined fam_OnGameModeInit
    forward fam_OnGameModeInit();
#endif

public OnPlayerConnect(playerid)
{
    Calendar_ResetPlayer(playerid);
    BRDuelOffer[playerid] = -1;
    BRDuelOfferBet[playerid] = 0;
    BRDuelActive[playerid] = false;
    BRDuelOpponent[playerid] = -1;
    BRDuelBet[playerid] = 0;
    BRDuelWins[playerid] = 0;
    BRDuelWorld[playerid] = 0;

    
    #if defined fam_OnPlayerConnect
        return fam_OnPlayerConnect(playerid);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnPlayerConnect
    #undef OnPlayerConnect
#else
    #define _ALS_OnPlayerConnect
#endif
#define OnPlayerConnect fam_OnPlayerConnect
#if defined fam_OnPlayerConnect
    forward fam_OnPlayerConnect(playerid);
#endif

