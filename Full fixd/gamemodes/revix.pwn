	    DestroyVehicle(cargo[playerid]);
        SendClientMessage(playerid, -1, "{ffff00}|{ffffff} Вы успешно завершили заказ. С учётом премии ваша зарплата составила {ffff00}50000{ffffff} рублей");
        return true;
