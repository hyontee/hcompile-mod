								{
									SendClientMessage(playerid, 0xB5B500FF, "На основном банковском счету не хватает денег для оплаты");

									format(fmt_str, sizeof fmt_str, "Для продления аренды на %d дней необходимо %d руб", days, total_price);
									SendClientMessage(playerid, 0x999999FF, fmt_str);
								}
							}
					else SendClientMessage(playerid, 0xB5B500FF, "Вы не можете оплатить за аренду больше чем на 30 дней");
						}
						callcmd::paybizrent(playerid, "");
					}
					else ShowPlayerPayForRentDialog(playerid);
				}
			}
			case DIALOG_PAY_FOR_RENT_HOUSE:
			{
				new hnew_pay_type = GetPVarInt(playerid, "hnew_pay_type");
				new hnew_pay_id = GetPVarInt(playerid, "hnew_pay_id");
				if(hnew_pay_type != 1 && hnew_pay_type != 2) return ShowPlayerPayForRentDialog(playerid);

				if(!response)
				{
					ClearPlayerNewPropertyPayContext(playerid);
					return ShowPlayerPayForRentDialog(playerid);
				}

				new days = strval(inputtext);
				if(days <= 0 || days > 30 || !IsNumeric(inputtext))
					return ShowPlayerHousePayForRent(playerid);

				new accountid = GetPlayerAccountID(playerid);
				new rent_time, rent_price, rent_days, real_property_id;

				if(hnew_pay_type == 1)
				{
					if(!(0 <= hnew_pay_id < HOUSES_FOR_SALE_COUNT) || !gHouseOwned[hnew_pay_id] || gHouseOwnerID[hnew_pay_id] != accountid)
					{
						ClearPlayerNewPropertyPayContext(playerid);
						return SendClientMessage(playerid, 0xB5B500FF, "\xce\xec \xed\xe5 \xed\xe0\xe9\xe4\xe5\xed \xe8\xeb\xe8 \xf3\xe6\xe5 \xed\xe5 \xef\xf0\xe8\xed\xe0\xe4\xeb\xe5\xe6\xe8\xf2 \xe2\xe0\xec");
					}
					rent_time = gHouseRentTime[hnew_pay_id];
					rent_price = GetNewHouseRentPrice(hnew_pay_id);
					real_property_id = hnew_pay_id;
				}
				else
				{
					if(!(0 <= hnew_pay_id < 200000) || !gFlatOwned[hnew_pay_id] || gFlatOwnerID[hnew_pay_id] != accountid)
					{
						ClearPlayerNewPropertyPayContext(playerid);
						return SendClientMessage(playerid, 0xB5B500FF, "\xca\xe2\xe0\xf0\xf2\xe8\xf0\xe0 \xed\xe5 \xed\xe0\xe9\xe4\xe5\xed\xe0 \xe8\xeb\xe8 \xf3\xe6\xe5 \xed\xe5 \xef\xf0\xe8\xed\xe0\xe4\xeb\xe5\xe6\xe8\xf2 \xe2\xe0\xec");
					}
					rent_time = gFlatRentTime[hnew_pay_id];
					rent_price = GetNewFlatRentPrice(hnew_pay_id);
					real_property_id = g_flat_real_id[hnew_pay_id];
				}

				if(rent_time < gettime()) rent_time = gettime();
				rent_days = GetNewPropertyRentDaysLeft(rent_time);
				new total_price = rent_price * days;
				if((rent_days + days) > HNEW_MAX_RENT_DAYS)
				{
					SendClientMessage(playerid, 0xB5B500FF, "\xc2\xfb \xed\xe5 \xec\xee\xe6\xe5\xf2\xe5 \xee\xef\xeb\xe0\xf2\xe8\xf2\xfc \xed\xe0\xeb\xee\xe3 \xe1\xee\xeb\xfc\xf8\xe5 \xf7\xe5\xec \xed\xe0 30 \xe4\xed\xe5\xe9");
					return ShowPlayerHousePayForRent(playerid);
				}

				new bank = GetPlayerBankMoney(playerid);
				if(bank < total_price)
				{
					new fmt[160];
					format(fmt, sizeof fmt, "\xcd\xe0 \xe2\xe0\xf8\xe5\xec \xe1\xe0\xed\xea\xee\xe2\xf1\xea\xee\xec \xf1\xf7\xb8\xf2\xe5 \xed\xe5\xe4\xee\xf1\xf2\xe0\xf2\xee\xf7\xed\xee \xe4\xe5\xed\xe5\xe3: %d \xf0\xf3\xe1", total_price);
					SendClientMessage(playerid, 0xB5B500FF, fmt);
					return ShowPlayerHousePayForRent(playerid);
				}

				rent_time += days * 86400;
				new new_bank = bank - total_price;
				new fmt_str[300];

				
				
				
				mysql_format(mysql, fmt_str, sizeof fmt_str,
					"UPDATE accounts a, bought_houses h SET a.bank=%d, h.rent_time=%d WHERE a.id=%d AND h.house_id=%d AND h.account_id=%d LIMIT 1",
					new_bank, rent_time, accountid, real_property_id, accountid);
				mysql_query(mysql, fmt_str, false);
				new sql_error = mysql_errno();

				if(sql_error)
				{
					printf("[HOUSE RENT] payment SQL error=%d query=%s", sql_error, fmt_str);
					SendClientMessage(playerid, 0xFF6600FF, "\xce\xf8\xe8\xe1\xea\xe0 \xf1\xee\xf5\xf0\xe0\xed\xe5\xed\xe8\xff. \xc4\xe5\xed\xfc\xe3\xe8 \xed\xe5 \xf1\xed\x8f\xf2\xfb.");
				}
				else
				{
					SetPlayerData(playerid, P_BANK, new_bank);
					if(hnew_pay_type == 1) gHouseRentTime[hnew_pay_id] = rent_time;
					else gFlatRentTime[hnew_pay_id] = rent_time;

					format(fmt_str, sizeof fmt_str, "\xd1 \xe1\xe0\xed\xea\xee\xe2\xf1\xea\xee\xe3\xee \xf1\xf7\xb8\xf2\xe0 \xf1\xed\xff\xf2\xee {3399FF}%d \xf0\xf3\xe1", total_price);
					SendClientMessage(playerid, 0xFFFFFFFF, fmt_str);
					format(fmt_str, sizeof fmt_str, "\xc2\xfb \xee\xef\xeb\xe0\xf2\xe8\xeb\xe8 \xed\xe0\xeb\xee\xe3 \xed\xe0 {3399FF}%d \xe4\xed\xe5\xe9", days);
					SendClientMessage(playerid, 0x66CC00FF, fmt_str);
					ClearPlayerNewPropertyPayContext(playerid);
				}
				return ShowPlayerHousePayForRent(playerid);
			}

			case DIALOG_RETURN_MONEY:
            {
                if(response)
                {
                    new idx = GetPlayerListitemValue(playerid, listitem);

                    new fmt_text[640],
                        Cache: result;

                    mysql_format(mysql, fmt_text, sizeof fmt_text, "SELECT * FROM return_money WHERE id='%d'", idx);
                    result = mysql_query(mysql, fmt_text, true);

                    new rows = cache_num_rows();

                    if(!rows)
                        SendClientMessage(playerid, 0xCECECEFF, "У Вас нет денег которые Вам должны вернуть");

					else
                    {

                        new query[60],
                            money,
                            description[64];

                        money = cache_get_field_content_int(0, "money");
                        cache_get_field_content(0, "description", description);

                        format(query, sizeof query, "Вам было возвращено {FFFFFF}$%d (%s)", money, description);
                        SendClientMessage(playerid, 0x32a44bFF, query);

                        GivePlayerMoneyEx(playerid, money, "возврат денег", true, true);

                        mysql_format(mysql, fmt_text, sizeof fmt_text, "UPDATE return_money SET status=1 WHERE id='%d'", idx);
                        result = mysql_query(mysql, fmt_text, true);
                    }

                    cache_delete(result);
                }
            }
			
			case DIALOG_BANK:
