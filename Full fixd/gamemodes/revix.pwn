CMD:musicddd(playerid, params[])
{
	if(IsPlayerDriver(playerid))
	{
	    if(GetPVarInt(playerid, "server_radio_enabled") == 1)
	    {
	        
	        DeletePVar(playerid, "server_radio_enabled");
	        SendClientMessage(playerid, COR_SERVER, ""SC"Вы выключили радио");
	        
	    }

	    Dialog
	    (
	        playerid, DIALOG_CAR_RADIO, DIALOG_STYLE_LIST,
	        "{FFFF00}Онлайн радио",
	        g_server_radio_items,
	        "Выбрать", "Закрыть"
	    );
	    return 1;
	}
					else
	{
	 	if(GetPlayerData(playerid, P_PLAY_PLAYER) <= 0) return SendClientMessage(playerid, 0xCECECEFF, ""USC"У Вас нет наушников!");

	    if(GetPVarInt(playerid, "server_radio_enabled") == 1)
	    {
	        
	        DeletePVar(playerid, "server_radio_enabled");
	        SendClientMessage(playerid, COR_SERVER, ""SC"Вы убрали источник звука");
	        
	        RemovePlayerAttachedObject(playerid, 3);
	    }

	    Dialog
	    (
	        playerid, DIALOG_PLAY_RADIO, DIALOG_STYLE_LIST,
	        "{FFFF00}Онлайн радио",
	        g_server_radio_items,
	        "Выбрать", "Закрыть"
	    );
	    return 1;
	}
    
}

