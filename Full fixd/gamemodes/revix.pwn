			    SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			    AddPlayerData(playerid, P_GIFTS, -, 1);

			    new fmt_str1[144];
			    format(fmt_str1, sizeof fmt_str1, "У Вас осталось подарков: {FFFFFF}%d шт.", GetPlayerData(playerid, P_GIFTS));
				SendClientMessage(playerid, 0xffff00FF, fmt_str1);
				new query[144];

				format(query, sizeof query, "UPDATE accounts SET gifts=%d WHERE id=%d", GetPlayerData(playerid, P_GIFTS), GetPlayerAccountID(playerid));
				mysql_query(mysql, query, false);
			}
			case DIALOG_AUTOSALON_CAR_BUY:
			{
			    if(!response) return 1;

                new biz_id = GetPlayerInBiz(playerid);
				if (biz_id == -1) return 1;
				new car_market_id = GetCarMarketIdByBizId(biz_id);
				if(GetBusinessData(biz_id, B_TYPE) != BUSINESS_TYPE_CAR_MARKET) return 1;
				BuyOwnableCar(playerid, car_market_id, buy_car_select_car[playerid]);
				return 1;


				   

			}
case DIALOG_RENT_BIKE:
{
    if(!response)
    {
        DeletePVar(playerid, "rent_zone_id");
        return 1;
    }

    switch(listitem)
    {
        case 0:
        {
            RentScooter(playerid);
            return 1;
        }

        default:
        {
            
            
            
            new loaded_ownable_vehicle = GetPlayerOwnableCar(playerid);
            if(loaded_ownable_vehicle != INVALID_VEHICLE_ID)
            {
                if(IsValidVehicle(loaded_ownable_vehicle))
                    return SendClientMessage(playerid, -1, ""USC" У вас уже загружено личное авто!");

                SetPlayerData(playerid, P_OWNABLE_CAR, INVALID_VEHICLE_ID);
            }

            new zone_id = GetPVarInt(playerid, "rent_zone_id");
            if(zone_id < 0 || zone_id >= TotalRentZones)
                return ShowNotificationSile(playerid, 2, 4, 0, 0, "Подойдите к парковке для аренды транспорта!", " ");

            new idx = GetPlayerListitemValue(playerid, listitem);
            if(idx <= 0)
                return 1;

            SetPVarInt(playerid, "car_zone", zone_id);
            DeletePVar(playerid, "car_slot");

            ShowOwnableCarLoadDialog(playerid, idx, false, true);
            return 1;
        }
    }
}

            case DIALOG_ORG_CAR_GET:
{
    if(!response) return 1;
    new action_id = GetPlayerListitemValue(playerid, 0);
    new vehicle_index = listitem;

    if(action_id < 0 || action_id >= sizeof(g_org_car) || vehicle_index < 0 || vehicle_index >= 4)
        return 1;

    new org_modelid = _:g_org_car[action_id][O_MODEL][vehicle_index];
    if(org_modelid <= 0) return 1;

    new color1 = _:g_org_car[action_id][O_COLOR][vehicle_index];
    
    
    
    new color2 = color1;
    if(action_id >= 8 && action_id <= 10)
    {
        color1 = 0;
        color2 = 1;
    }
    new numt = g_org_car[action_id][O_NUMTYPE];
    if(numt < TYPE_RU || numt > TYPE_KZ) numt = TYPE_RU;
    new migal = g_org_car[action_id][O_MIGAL][vehicle_index];
    new siren = g_org_car[action_id][O_SIREN][vehicle_index];

    new buy_cars_count = g_org_car[action_id][O_COUNT]++;
    if(buy_cars_count >= 4) g_org_car[action_id][O_COUNT] = 0;

    new Float: pos_x = org_car_pos_spawn[action_id][buy_cars_count][0];
    new Float: pos_y = org_car_pos_spawn[action_id][buy_cars_count][1];
    new Float: pos_z = org_car_pos_spawn[action_id][buy_cars_count][2];
    new Float: angle = org_car_pos_spawn[action_id][buy_cars_count][3];

    new vehicleid = CreateVehicle(
        org_modelid, pos_x, pos_y, pos_z, angle,
        color1, color2, 120, 0,
        VEHICLE_ACTION_ORG_CAR,
        g_org_car[action_id][O_FRAC_ID]
    );

    if(vehicleid == INVALID_VEHICLE_ID)
    {
        SendClientMessage(playerid, -1, ""SC"\xce\xf8\xe8\xe1\xea\xe0 \xf1\xee\xe7\xe4\xe0\xed\xe8\xff \xf2\xf0\xe0\xed\xf1\xef\xee\xf0\xf2\xe0!");
        return 1;
    }

    
    
    
    vInfo[vehicleid][vColorBody] = GetVehicleRGBAColorById(color1);
    vInfo[vehicleid][vColorWheels] = GetVehicleRGBAColorById(color2);
    vInfo[vehicleid][vVinylTexture][0] = EOS;
    vInfo[vehicleid][vynil_name][0] = EOS;
    vInfo[vehicleid][vVinyl] = 0;

    new plate[32];
    RandomNumberPlateByType(numt, plate, sizeof(plate));
    SetVehicleNumberPlateEx(vehicleid, numt, plate, "52");
    ApplyOrgVinylToVehicle(vehicleid, action_id, vehicle_index);
    if(action_id >= 8 && action_id <= 10)
        SetVehicleColor(vehicleid, color1, color2, 1);

    if(migal != 0)
        SetVehicleCarMod(vehicleid, 0, migal, 1);

    if(siren != 0)
        SetVehicleSiren(vehicleid, siren, 1);

    SetVehicleData(vehicleid, V_ACTION_OWNER, playerid);
    SetPlayerData(playerid, P_FRACTION_CAR, vehicleid);
    PutPlayerInVehicle(playerid, vehicleid, 0);

    new org_model_name[64];
    GetVehicleModelName(org_modelid, org_model_name, sizeof(org_model_name));
    new org_spawn_msg[144];
    format(org_spawn_msg, sizeof(org_spawn_msg), "\xc2\xfb \xe2\xe7\xff\xeb\xe8 \xf2\xf0\xe0\xed\xf1\xef\xee\xf0\xf2: %s", org_model_name);
    SendClientMessage(playerid, -1, org_spawn_msg);
    return 1;
}

