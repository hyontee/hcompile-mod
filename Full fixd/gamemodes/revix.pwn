                    }

                    format(list, sizeof list, "{FFFF00}- {FFFFFF}№%d %s %d", mesto, name_pl, rep_pl);
                    strcat(dialog, list);
                    
                   ShowPlayerDialog(playerid, -1, DIALOG_STYLE_LIST, "{FF0000}Рейтинг лучших семей", dialog, "Закрыть", "");
