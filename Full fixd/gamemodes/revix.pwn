CMD:showradialmenu(playerid)
{
new vehicleid = GetPlayerVehicleID(playerid);
if(!IsPlayerInVehicle(playerid, vehicleid)) {
return true;
}
new engine, lights, alarm, doors, bonnet, boot, objective, strob, neon, parking;
