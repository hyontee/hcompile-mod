stock CreatePickupPoints()
{
    for(new i = 0; i < sizeof(PickupPoints); i++)
    {
        
        if(i == 6 || i == 7) continue;
        
        PickupPoints[i][pp_enter_pickup] = CreatePickup(19132, 23,
            PickupPoints[i][pp_enter_x],
            PickupPoints[i][pp_enter_y],
            PickupPoints[i][pp_enter_z],
            PickupPoints[i][pp_enter_vw]);
        
        
        PickupPoints[i][pp_exit_pickup] = CreatePickup(19132, 23,
            PickupPoints[i][pp_inside_x],
            PickupPoints[i][pp_inside_y],
            PickupPoints[i][pp_inside_z],
            PickupPoints[i][pp_exit_vw]);
    }
    return 1;
}


stock HandlePickupPoint(playerid, pickupid)
{
    
    for(new i = 0; i < sizeof(PickupPoints); i++)
    {
        if(pickupid == PickupPoints[i][pp_enter_pickup])
        {
            SetPlayerPos(playerid,
                PickupPoints[i][pp_exit_x],
                PickupPoints[i][pp_exit_y],
                PickupPoints[i][pp_exit_z]);
            SetPlayerInterior(playerid, PickupPoints[i][pp_exit_int]);
            SetPlayerVirtualWorld(playerid, PickupPoints[i][pp_exit_vw]);
            
            SetPVarInt(playerid, "in_pickup_point", i);
            
            new msg[128];
            format(msg, sizeof(msg), "{33aa33}| {ffffff} \xc2\xfb \xe2\xee\xf8\xeb\xe8 \xe2 %s", PickupPoints[i][pp_name]);
            SendClientMessage(playerid, -1, msg);
            return 1;
        }
    }
    
    
    for(new i = 0; i < sizeof(PickupPoints); i++)
    {
        if(pickupid == PickupPoints[i][pp_exit_pickup])
        {
            SetPlayerPos(playerid,
                PickupPoints[i][pp_enter_x],
                PickupPoints[i][pp_enter_y],
                PickupPoints[i][pp_enter_z]);
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);
            DeletePVar(playerid, "in_pickup_point");
            
            new msg[128];
            format(msg, sizeof(msg), "{33aa33}| {ffffff} \xc2\xfb \xe2\xfb\xf8\xeb\xe8 \xe8\xe7 %s", PickupPoints[i][pp_name]);
            SendClientMessage(playerid, -1, msg);
            return 1;
        }
    }
    return 0;
}

stock IsPlayerNearHR(playerid)
{
    if(GetPlayerInterior(playerid) == 1)
    {
        if(IsPlayerInRangeOfPoint(playerid, 7.0, 1502.981933,2500.498535,2501.000000) ||
           IsPlayerInRangeOfPoint(playerid, 7.0, 1985.329711,-3.292105,1381.003540) ||
           IsPlayerInRangeOfPoint(playerid, 7.0, 498.718017,1511.595458,1501.000000) ||
           IsPlayerInRangeOfPoint(playerid, 7.0, 969.463562,-2.966348,1380.996215) ||
           IsPlayerInRangeOfPoint(playerid, 7.0, -1106.177490,1513.784179,1499.953247) ||
           IsPlayerInRangeOfPoint(playerid, 7.0, 1795.375122,1729.511840,1493.153564)) return 1;
    }
    if(GetPlayerInterior(playerid) == 0 && IsPlayerInRangeOfPoint(playerid, 7.0, -1817.008300,-2631.807617,7.590855)) return 1;
    return 0;
}

