                        format(f_string144, sizeof f_string144, "%s взял из склада маску.", GetPlayerNameEx(playerid));
                        SendFamilyMessage(f, f_string144);
                        UpdateColumnFamilyInt(GetFamily(f, family_database), "mask", GetFamily(f, family_mask));
