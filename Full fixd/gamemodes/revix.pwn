	return 1;
}

CMD:spoff(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1 && GetPlayerYouTubeEx(playerid) < 1) return 1;

    if(GetPlayerSpectateData(playerid, S_PLAYER) != -1)
    {
        StopSpectate(playerid);
    }

    return 1;
}

CMD:weap(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /weap [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "Такого игрока нет");

	new fmt_text[625],
		text[45];

	format
	(
		fmt_text,
		sizeof fmt_text,
		"\
		Слот\tОружие\t\tПатроны\n{FFFFFF}\
		"
	);

	for(new i = 0; i < 13; i++)
	{
		new weapon_id, weapon_ammo;

		GetPlayerWeaponData(to_player, i, weapon_id, weapon_ammo);

		format(text, sizeof text, "\n%d\t%s%s%d", i+1, GetWeaponName(weapon_id), weapon_dialog_tabulation[weapon_id], weapon_ammo);
		strcat(fmt_text, text);
	}

	Dialog
	(
		playerid,
		INVALID_DIALOG_ID,
		DIALOG_STYLE_LIST,
		"{FFCC00}Оружия у игрока",
		fmt_text,
		"Закрыть",
		""
	);

	format(fmt_text, sizeof fmt_text, "Смотрит оружие %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:adonate(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) >= 1)
    {
		ShowPlayerAdminDonate(playerid);
	}
	return 1;
}

CMD:a(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) >= 1)
	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, ""SC"Используйте: /a [текст]");

		new fmt_str[999];
		new fmt_text[999];
		new Admin = GetPlayerAdminEx(playerid);
        switch(Admin)
        {
        case 1: fmt_text = "["ADM_LVL1_NAME"]";
        case 2: fmt_text = "["ADM_LVL2_NAME"]";
        case 3: fmt_text = "["ADM_LVL3_NAME"]";
        case 4: fmt_text = "["ADM_LVL4_NAME"]";
        case 5: fmt_text = "["ADM_LVL5_NAME"]";
        case 6: fmt_text = "["ADM_LVL6_NAME"]";
        case 7: fmt_text = "["ADM_LVL7_NAME"]";
        case 8: fmt_text = "["ADM_LVL8_NAME"]";
        case 9: fmt_text = "["ADM_LVL9_NAME"]";
        case 10: fmt_text = "["ADM_LVL10_NAME"]";
        case 11: fmt_text = "["ADM_LVL11_NAME"]";
        case 12: fmt_text = "["ADM_LVL12_NAME"]";
        case 13: fmt_text = "["ADM_LVL13_NAME"]";
        case 14: fmt_text = "["ADM_LVL14_NAME"]";
        default: fmt_text = "---";
        }

		format(fmt_str, sizeof fmt_str, "%s %s[%d]: %s", fmt_text, GetPlayerNameEx(playerid), playerid, params);
		SendMessageToAdmins(fmt_str, 0x40E0D0FF);

		SendLog(playerid, LOG_TYPE_ADMIN_CHAT, params);
	}

	return 1;
}

stock ShowAdminsOnlineDialog(playerid, page)
{
	if(page < 0)
		page = 0;

	new list[4096];
	new fmt_text[256];
	new title[64];
	new shown;
	new total;
	new start_index = page * 20;
	new end_index = start_index + 20;

	list = "{E0584B}никнейм\t{E0584B}должность\t{E0584B}информация\n";

	foreach(new i : Player)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;

		new admin_lvl = GetPlayerAdminEx(i);
		new youtube_lvl = GetPlayerYouTubeEx(i);
		if(admin_lvl == 0 && youtube_lvl == 0) continue;

		if(total >= start_index && total < end_index)
		{
			new rank_name[64];
			new info_text[48];
			new info_color[12];

			if(admin_lvl > 0)
			{
				switch(admin_lvl)
				{
					case 1:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL1_NAME);
					case 2:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL2_NAME);
					case 3:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL3_NAME);
					case 4:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL4_NAME);
					case 5:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL5_NAME);
					case 6:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL6_NAME);
					case 7:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL7_NAME);
					case 8:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL8_NAME);
					case 9:  format(rank_name, sizeof(rank_name), "%s", ADM_LVL9_NAME);
					case 10: format(rank_name, sizeof(rank_name), "%s", ADM_LVL10_NAME);
					case 11: format(rank_name, sizeof(rank_name), "%s", ADM_LVL11_NAME);
					case 12: format(rank_name, sizeof(rank_name), "%s", ADM_LVL12_NAME);
					case 13: format(rank_name, sizeof(rank_name), "%s", ADM_LVL13_NAME);
					case 14: format(rank_name, sizeof(rank_name), "%s", ADM_LVL14_NAME);
					default: format(rank_name, sizeof(rank_name), "Администратор");
				}
			}
			else format(rank_name, sizeof(rank_name), "Ютубер");

			if(IsPlayerAFK(i))
			{
				info_color = "{FF9900}";
				format(info_text, sizeof(info_text), "AFK %02d:%02d", (floatround(GetPlayerData(i, P_AFK_TIME) / 60) % 60), GetPlayerData(i, P_AFK_TIME) % 60);
			}
			else if(GetPlayerSpectateData(i, S_PLAYER) != -1)
			{
				info_color = "{33AACC}";
				format(info_text, sizeof(info_text), "следит за %d", GetPlayerSpectateData(i, S_PLAYER));
			}
			else
			{
				info_color = "{009900}";
				info_text = "в игре";
			}

			format(fmt_text, sizeof(fmt_text), "{E0584B}%d. {FFFFFF}%s[%d]\t{FFFFFF}%s\t%s%s\n", total + 1, GetPlayerNameEx(i), i, rank_name, info_color, info_text);
			if(strlen(list) + strlen(fmt_text) < sizeof(list) - 1)
			{
				strcat(list, fmt_text);
				SetPlayerListitemValue(playerid, shown, i);
				shown ++;
			}
		}
		total ++;
	}

	if(!total)
	{
		strcat(list, "{FFFFFF}Администрация не найдена");
	}
	else
	{
		if(page > 0)
		{
			strcat(list, "Предыдущая страница\n");
			SetPlayerListitemValue(playerid, shown, -1);
			shown ++;
		}
		if(end_index < total)
		{
			strcat(list, "Следующая страница");
			SetPlayerListitemValue(playerid, shown, -2);
		}
	}

	format(title, sizeof(title), "{E0584B}Администрация в сети (стр. %d)", page + 1);
	SetPVarInt(playerid, "admins_online_dialog", 1);
	SetPVarInt(playerid, "admins_online_page", page);
	ShowPlayerDialog(playerid, DIALOG_ADMINS, DIALOG_STYLE_TABLIST_HEADERS, title, list, "Выбрать", "Закрыть");
	return 1;
}
CMD:adminsoooooooooooold(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) == 0)
	{
		if(GetPlayerPremium(playerid) == 0)
		    return  SendClientMessage(playerid, 0xCECECEFF, "У Вас нет VIP аккаунта.");
	}

	new fmt_text[90],
		count;
	if(GetPlayerAdminEx(playerid) < 1) return 1;
	SendClientMessage(playerid, 0x66CC33FF, "Администраторы в сети:");
	for(new i; i < MAX_PLAYERS; i ++)
	{
		new admin_lvl = GetPlayerAdminEx(i);

		if(!IsPlayerConnected(i)) continue;
		else if(!IsPlayerLogged(i)) continue;
		else if(!(1 <= admin_lvl <= 13)) continue;

		format(fmt_text, sizeof fmt_text, "%s[%d] (%d lvl)", GetPlayerNameEx(i), i, admin_lvl);

		if(IsPlayerAFK(i))
			format(fmt_text, sizeof fmt_text, "%s {FF0000}AFK [%02d:%02d]", fmt_text, (floatround(GetPlayerData(i, P_AFK_TIME) / 60) % 60), GetPlayerData(i, P_AFK_TIME) % 60);

		else if(GetPlayerSpectateData(i, S_PLAYER) != -1)
			format(fmt_text, sizeof fmt_text, "%s {32a44b}/sp > %d", fmt_text, GetPlayerSpectateData(i, S_PLAYER));

		SendClientMessage(playerid, 0xFFFF00FF, fmt_text);
		count++;
	}
	if(!count) SendClientMessage(playerid, 0xffff00FF, "Нет администраторов в сети");

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, "Смотрит список администрации");

	return 1;
}

CMD:admins(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) == 0 && GetPlayerPremium(playerid) == 0)
		return SendClientMessage(playerid, 0xCECECEFF, "У Вас нет VIP аккаунта.");

	return ShowAdminsOnlineDialog(playerid, 0);
}


