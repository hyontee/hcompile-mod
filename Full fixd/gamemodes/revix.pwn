								"{FFFFFF}\xc2\xe2\xe5\xe4\xe8\xf2\xe5 \xed\xe0\xe7\xe2\xe0\xed\xe8\xe5 \xe4\xeb\xff \xed\xee\xe2\xee\xe3\xee \xf1\xf7\xe5\xf2\xe0.\n"\
								"\xcc\xe0\xea\xf1\xe8\xec\xe0\xeb\xfc\xed\xe0\xff \xe4\xeb\xe8\xed\xe0 20 \xf1\xe8\xec\xe2\xee\xeb\xee\xe2:",
