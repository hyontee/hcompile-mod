}

stock ShowAdminInfoDialog(playerid)
{
	if(GetPlayerData(playerid, P_ADM_STDI) == 0)
	{
		new fmt[512];
		format(fmt, sizeof(fmt), "{FFFFFF}Добро пожаловать, {FFB700}%s!\n\
		\n\
		{FFFFFF}Вы — администратор проекта {FF5533}LENOV RP{FFFFFF}.\n\
		Ваша задача: поддерживать порядок на сервере и помогать игрокам.\n\
		Активная и качественная работа может быть отмечена дополнительными наградами от руководства.\n\
		\n\
		{FFFFFF}Для продолжения работы нажмите кнопку {FFB700}Далее,\n\
		{FFFFFF}После чего введите Ваш администраторский пароль.", GetPlayerNameEx(playerid));
	
		ShowPlayerDialog(playerid, DIALOG_ADM_STDI, DIALOG_STYLE_MSGBOX, "{FF5533}LENOV RP {FFFFFF}| Информация", fmt, "Далее", "");
	}
	else if(GetPlayerData(playerid, P_ADM_STDI) == 1)
