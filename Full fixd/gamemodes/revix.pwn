	  SetPVarInt(playerid, "UrogMoney", GetPVarInt(playerid, "UrogMoney") + UrogMoney);
	
	  return 1;
	}
	if(GetPVarInt(playerid, "Uroga") == 3 )
	{
	  DisablePlayerCheckpoint(playerid);
