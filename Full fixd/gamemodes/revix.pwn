CMD:duel(playerid, params[])
{
    new targetid, bet;
    new dialog_text[256];
    new name[MAX_PLAYER_NAME];

    if(sscanf(params, "ii", targetid, bet))
        return SendClientMessage(playerid, -1, "Используй: /duel [id] [ставка]");

    if(targetid == playerid)
        return SendClientMessage(playerid, -1, "Нельзя вызвать на дуэль самого себя.");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, -1, "Игрок с таким ID не найден.");

    if(bet < 5000 || bet > 150000)
        return SendClientMessage(playerid, -1, "Ставка должна быть от 5.000 до 150.000 ?.");

    if(GetPlayerMoney(playerid) < bet)
        return SendClientMessage(playerid, -1, "У Вас недостаточно денег для этой ставки.");

    if(GetPlayerMoney(targetid) < bet)
        return SendClientMessage(playerid, -1, "У соперника недостаточно денег для этой ставки.");

    if(BRDuelActive[playerid] || BRDuelActive[targetid])
        return SendClientMessage(playerid, -1, "Один из игроков уже находится в дуэли.");

    if(BRDuelOffer[targetid] != -1)
        return SendClientMessage(playerid, -1, "Этому игроку уже предложили дуэль.");

    if(BRDuelOffer[playerid] != -1)
        return SendClientMessage(playerid, -1, "У Вас уже есть активное приглашение на дуэль.");

    if(!ProxDetectorS(10.0, playerid, targetid))
        return SendClientMessage(playerid, -1, "Вы должны находиться рядом с соперником.");

    GetPlayerName(playerid, name, MAX_PLAYER_NAME);

    format(dialog_text, sizeof(dialog_text),
        "Игрок %s[%d] приглашает Вас на дуэль.\n\nСтавка: %d ?\n\nДо 5 раундов.\nПобедитель получает банк дуэли.",
        name, playerid, bet);

    BRDuelOffer[targetid] = playerid;
    BRDuelOfferBet[targetid] = bet;

    ShowPlayerDialog(targetid, 31000, DIALOG_STYLE_MSGBOX, "Приглашение на дуэль",
        dialog_text, "Принять", "Отклонить");

    SendClientMessage(playerid, 0x66CC33FF, "Приглашение на дуэль отправлено.");
    return 1;
}

stock BRDuelSavePlayer(playerid)
{
    GetPlayerPos(playerid, BRDuelOldX[playerid], BRDuelOldY[playerid], BRDuelOldZ[playerid]);
    GetPlayerFacingAngle(playerid, BRDuelOldA[playerid]);
    BRDuelOldInterior[playerid] = GetPlayerInterior(playerid);
    BRDuelOldWorld[playerid] = GetPlayerVirtualWorld(playerid);

    GetPlayerHealth(playerid, BRDuelOldHealth[playerid]);
    GetPlayerArmour(playerid, BRDuelOldArmour[playerid]);

    for(new w = 0; w < 13; w++)
    {
        GetPlayerWeaponData(playerid, w, BRDuelSavedWeapon[playerid][w], BRDuelSavedAmmo[playerid][w]);
    }
    return 1;
}

stock BRDuelGiveWeapon(playerid)
{
    ResetPlayerWeapons(playerid);
    GivePlayerWeapon(playerid, 24, 5000);
    SetPlayerArmedWeapon(playerid, 24);
    SetPlayerHealth(playerid, 100.0);
    SetPlayerArmour(playerid, 0.0);
    return 1;
}

stock BRDuelTeleport(playerid, worldid)
{
    SetPlayerVirtualWorld(playerid, worldid);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, -2750.125976, 1432.332153, 64.727500);
    SetPlayerFacingAngle(playerid, 80.132682);
    return 1;
}

public BRDuelStart(player1, player2, bet)
{
    if(!IsPlayerConnected(player1) || !IsPlayerConnected(player2))
        return 0;

    BRDuelActive[player1] = true;
    BRDuelActive[player2] = true;

    BRDuelOpponent[player1] = player2;
    BRDuelOpponent[player2] = player1;

    BRDuelBet[player1] = bet;
    BRDuelBet[player2] = bet;

    BRDuelWins[player1] = 0;
    BRDuelWins[player2] = 0;

    BRDuelWorld[player1] = 1000 + player1;
    BRDuelWorld[player2] = BRDuelWorld[player1];

    BRDuelSavePlayer(player1);
    BRDuelSavePlayer(player2);

    GivePlayerMoneyEx(player1, -bet);
    GivePlayerMoneyEx(player2, -bet);

    BRDuelTeleport(player1, BRDuelWorld[player1]);
    BRDuelTeleport(player2, BRDuelWorld[player2]);

    BRDuelGiveWeapon(player1);
    BRDuelGiveWeapon(player2);

    TogglePlayerControllable(player1, true);
    TogglePlayerControllable(player2, true);

    SendClientMessage(player1, 0x66CC33FF, "Дуэль началась! До 5 раундов. Оружие: Desert Eagle, 5000 патронов.");
    SendClientMessage(player2, 0x66CC33FF, "Дуэль началась! До 5 раундов. Оружие: Desert Eagle, 5000 патронов.");

    return 1;
}

public BRDuelAccept(playerid, response)
{
    new opponent = BRDuelOffer[playerid];
    new bet = BRDuelOfferBet[playerid];
    if(opponent == -1 || !IsPlayerConnected(opponent))
    {
        BRDuelOffer[playerid] = -1;
        BRDuelOfferBet[playerid] = 0;
        return SendClientMessage(playerid, -1, "Приглашение на дуэль больше недействительно.");
    }

    if(!response)
    {
        BRDuelOffer[playerid] = -1;
        BRDuelOfferBet[playerid] = 0;
        SendClientMessage(playerid, -1, "Вы отказались от дуэли.");
        SendClientMessage(opponent, -1, "Игрок отказался от дуэли.");
        return 1;
    }

    if(BRDuelActive[playerid] || BRDuelActive[opponent])
    {
        BRDuelOffer[playerid] = -1;
        BRDuelOfferBet[playerid] = 0;
        return SendClientMessage(playerid, -1, "Дуэль не может быть начата: один из игроков уже в другой дуэли.");
    }

    if(!ProxDetectorS(10.0, playerid, opponent))
    {
        BRDuelOffer[playerid] = -1;
        BRDuelOfferBet[playerid] = 0;
        SendClientMessage(playerid, -1, "Вы слишком далеко от соперника.");
        SendClientMessage(opponent, -1, "Игрок отошел слишком далеко. Дуэль отменена.");
        return 1;
    }

    if(GetPlayerMoney(playerid) < bet || GetPlayerMoney(opponent) < bet)
    {
        BRDuelOffer[playerid] = -1;
        BRDuelOfferBet[playerid] = 0;
        SendClientMessage(playerid, -1, "У одного из игроков уже недостаточно денег для ставки.");
        SendClientMessage(opponent, -1, "У одного из игроков уже недостаточно денег для ставки.");
        return 1;
    }

    BRDuelOffer[playerid] = -1;
    BRDuelOfferBet[playerid] = 0;

    return BRDuelStart(opponent, playerid, bet);
}

public BRDuelHandleDeath(playerid, killerid)
{
    new opponent = BRDuelOpponent[playerid];
    new round_no;

    if(opponent == -1 || !IsPlayerConnected(opponent))
        return 1;

    if(killerid != opponent)
    {
        SetTimerEx("BRDuelNextRound", 800, false, "ii", playerid, opponent);
        return 1;
    }

    BRDuelWins[opponent]++;
    round_no = BRDuelWins[opponent] + BRDuelWins[playerid];

    GivePlayerMoneyEx(opponent, 5000);

    new msg[256];
    format(msg, sizeof(msg),
        "DUEL: %s[%d] убил %s[%d] — за это получил 5000 ?. Раунд %d/5.",
        GetPlayerNameEx(opponent), opponent, GetPlayerNameEx(playerid), playerid, round_no);
    SendClientMessageToAll(0x66CC33FF, msg);

    if(BRDuelWins[opponent] >= 3 || round_no >= 5)
    {
        BRDuelFinish(opponent, playerid);
        return 1;
    }

    format(msg, sizeof(msg), "DUEL: счёт %d:%d. Следующий раунд через секунду.",
        BRDuelWins[opponent], BRDuelWins[playerid]);
    SendClientMessage(opponent, -1, msg);
    SendClientMessage(playerid, -1, msg);

    SetTimerEx("BRDuelNextRound", 1000, false, "ii", playerid, opponent);
    return 1;
}

public BRDuelNextRound(loserid, winnerid)
{
    if(!BRDuelActive[loserid] || !BRDuelActive[winnerid])
        return 0;

    SpawnPlayer(loserid);
    SetTimerEx("BRDuelRoundStart", 350, false, "ii", loserid, winnerid);
    return 1;
}

public BRDuelRoundStart(player1, player2)
{
    if(!BRDuelActive[player1] || !BRDuelActive[player2])
        return 0;

    if(BRDuelOpponent[player1] != player2 || BRDuelOpponent[player2] != player1)
        return 0;

    BRDuelTeleport(player1, BRDuelWorld[player1]);
    BRDuelTeleport(player2, BRDuelWorld[player2]);

    BRDuelGiveWeapon(player1);
    BRDuelGiveWeapon(player2);

    TogglePlayerControllable(player1, true);
    TogglePlayerControllable(player2, true);

    return 1;
}

stock BRDuelRestoreWeapons(playerid)
{
    ResetPlayerWeapons(playerid);

    for(new w = 0; w < 13; w++)
    {
        if(BRDuelSavedWeapon[playerid][w] > 0 && BRDuelSavedAmmo[playerid][w] > 0)
            GivePlayerWeapon(playerid, BRDuelSavedWeapon[playerid][w], BRDuelSavedAmmo[playerid][w]);
    }
    return 1;
}

public BRDuelFinish(winnerid, loserid)
{
    new bet = BRDuelBet[winnerid];
    new prize = bet * 2;

    if(IsPlayerConnected(winnerid))
    {
        GivePlayerMoneyEx(winnerid, prize);

        SetPlayerVirtualWorld(winnerid, BRDuelOldWorld[winnerid]);
        SetPlayerInterior(winnerid, BRDuelOldInterior[winnerid]);
        SetPlayerPos(winnerid, BRDuelOldX[winnerid], BRDuelOldY[winnerid], BRDuelOldZ[winnerid]);
        SetPlayerFacingAngle(winnerid, BRDuelOldA[winnerid]);
        SetPlayerHealth(winnerid, BRDuelOldHealth[winnerid]);
        SetPlayerArmour(winnerid, BRDuelOldArmour[winnerid]);
        BRDuelRestoreWeapons(winnerid);
        TogglePlayerControllable(winnerid, true);

        new finish_msg[256];
        format(finish_msg, sizeof(finish_msg),
            "DUEL: %s победил в дуэли! Итог %d:%d. Получено %d ?.",
            GetPlayerNameEx(winnerid), BRDuelWins[winnerid], BRDuelWins[loserid], prize);
        SendClientMessageToAll(0x66CC33FF, finish_msg);
    }

    if(IsPlayerConnected(loserid))
    {
        SetPVarInt(loserid, "BRDuelRestore", 1);
        SpawnPlayer(loserid);
        SetTimerEx("BRDuelRestoreAfterSpawn", 350, false, "i", loserid);
    }

    BRDuelActive[winnerid] = false;
    BRDuelActive[loserid] = false;

    BRDuelOpponent[winnerid] = -1;
    BRDuelOpponent[loserid] = -1;

    BRDuelBet[winnerid] = 0;
    BRDuelBet[loserid] = 0;

    BRDuelWins[winnerid] = 0;
    BRDuelWins[loserid] = 0;

    return 1;
}

public BRDuelRestoreAfterSpawn(playerid)
{
    if(!IsPlayerConnected(playerid))
        return 0;

    if(GetPVarInt(playerid, "BRDuelRestore") != 1)
        return 0;

    DeletePVar(playerid, "BRDuelRestore");

    SetPlayerVirtualWorld(playerid, BRDuelOldWorld[playerid]);
    SetPlayerInterior(playerid, BRDuelOldInterior[playerid]);
    SetPlayerPos(playerid, BRDuelOldX[playerid], BRDuelOldY[playerid], BRDuelOldZ[playerid]);
    SetPlayerFacingAngle(playerid, BRDuelOldA[playerid]);
    SetPlayerHealth(playerid, BRDuelOldHealth[playerid]);
    SetPlayerArmour(playerid, BRDuelOldArmour[playerid]);
    BRDuelRestoreWeapons(playerid);
    TogglePlayerControllable(playerid, true);

    return 1;
}

stock ProxDetectorS(Float:radi, playerid, targetid, spec = 0)
{
	new Float:p[3];

	if(!IsPlayerConnected(playerid)) return false;

	if(!IsPlayerConnected(targetid)) return false;

	if(!spec)
	{
		if(GetPlayerState(playerid) == 9) return false;

		if(GetPlayerState(targetid) == 9) return false;
	}
	if(!GetPlayerPos(targetid, p[0], p[1], p[2])) return false;
	if(!IsPlayerInRangeOfPoint(playerid, radi, p[0], p[1], p[2])) return false;

	return true;
}

