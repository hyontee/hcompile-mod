							GivePlayerMoneyEx(playerid, -180, "Аренда эвакуатора", true, true);
							mexs[playerid] = CreateVehicle(525,1856.6643,-110.4669,15.5701,205.9911,1,1, -1, 0, VEHICLE_ACTION_TYPE_MECHANIC); 
							
							Dialog
								(
									playerid, DIALOG_MECHANIC_NAME, DIALOG_STYLE_INPUT,
									"{FFCD00}Автомеханик",
									"{FFFFFF}Введите название для Вашей техслужбы,\n"\
									"или оставьте поле пустым",
									"Готово", "Отмена"
								);
							PutPlayerInVehicle(playerid, mexs[playerid], 0);
							
