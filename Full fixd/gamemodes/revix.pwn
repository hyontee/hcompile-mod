public: Topinko(playerid)
{
	new name[24], zakaz,rows,fields, string[2000], id;
	cache_get_data(rows, fields);
	if(rows)
	{
		for(new i; i < rows; i++)
		{
			name[0] = EOS;
			
			id = cache_get_field_content_int(i, "id", mysql);
			zakaz = cache_get_field_content_int(i, "zakaz", mysql);
			format(string, sizeof(string), "%s\n"c_b"Ник: "c_server"%s\t "c_b"| \t"c_b"Заказов: "c_server"%d", string, GetPlayerNameBySqlID(id), zakaz);
			strcat(string, string, 0);
		}
	}

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "Топ инкассаторов", string, "Закрыть", "");

	return 1;
}
new huyhsusys[MAX_PLAYERS] = 30;
cmd:collist(playerid, params[])
{
	if(inko[playerid] < 1) return 1;
	if(napinko[playerid] >= 1) return SendClientMessage(playerid, 0xFFFF00, "| У вас уже имеется напарник");
	
	extract params -> new id; else return SendClientMessage(playerid, 0xFFFF00, "| Введите /collist [айди]");
	
	if(inko[id] < 1) return SendClientMessage(playerid, 0xFFFF00, "| Игрок не является инкассатором");
	if(napinko[id] >= 1) return SendClientMessage(playerid, 0xFFFF00, "| У игрока уже имеется напарник");
	

	napinko[id] = playerid;
	invnap[id] = 1;
	huyhsusys[id] = 15;
	SetTimerEx("invnnap", 1000, true, "i", id);
	SendClientMessage(playerid, 0xFFFF00, "Вы успешно запросились в напарники");
	SendClientMessage(id, 0xFFFF00, "Введите /ink для принятия приглашения в напарники в течении 15 секунд");
	return 1;
}

public invnnap(playerid)
{
	if(invnap[playerid] == 1)
	{
		huyhsusys[playerid] -= 1;
		if(huyhsusys[playerid] < 1)
		{
			SendClientMessage(napinko[playerid], 0xFFFF00, "Ваше приглашение в напарники были отказано");
			SendClientMessage(playerid, 0xFFFF00, "Вы не приняли приглашение в напарники");
			napinko[playerid] = -1;
			invnap[playerid] = 0;
			return 1;
		}
	}
					else return 1;
}
	
cmd:ink(playerid)
{
	if(invnap[playerid] == 0) return SendClientMessage(playerid, 0xFFFF00, "Вам не подавали заявку в напарники");
	if(napinko[napinko[playerid]] >= 0) return SendClientMessage(playerid, 0xFFFF00, "| У игрока уже имеется напарник");

	invnap[playerid] = 0;
	napinko[napinko[playerid]] = playerid;
	SendClientMessage(playerid, 0xFF0000, "| Игрок успешно стал вашим напарником. Арендуйте автомобиль");
	SendClientMessage(napinko[playerid], 0xFF0000, "| Вы успешно стали напарником. Арендуйте автомобиль");
}
cmd:blist(playerid)
{
	if(inko[playerid] < 2) return 1;
	if(inko[napinko[playerid]] < 2) return 1;
	if(napinko[playerid] == -1) return 1;
	if(blist[playerid] == 1 || blist[napinko[playerid]] == 1) return SendClientMessage(playerid, 0xFFFF00, "Вы уже брали заказ");
	
	new query[128], fmt[1024], rows;
	new money, Float: x, Float: y, Float: z, id, rang;
						
	mysql_query(mysql, "SELECT id, x, y, z, money, rang FROM inkozakaz", true);
	rows = cache_num_rows();
						
	if(rows)
	{
		for(new i; i < rows; i++)
		{
			id = cache_get_row_int(i, 0);
			x = cache_get_row_float(i, 1);
			y = cache_get_row_float(i, 2);
			z = cache_get_row_float(i, 3);
			money = cache_get_row_int(i, 4);
			rang = cache_get_row_int(i, 5);
								
			format(query, sizeof query, "{FFFF00}%d.{FFFFFF}\t%fм.\t%d руб\tс %d ранга\n", i+1, GetPlayerDistanceFromPoint(playerid, x, y, z), money, rang);
			strcat(fmt, query);
			SetPlayerListitemValue(playerid, i, id);
		}
		ShowPlayerDialog(playerid, 2730, DIALOG_STYLE_LIST, "Список заказов", fmt, "Выбрать", "Закрыть");
	}
					else 
		return SendClientMessage(playerid, 0xFFFF00, "Список заказов пуст");
}
cmd:isell(playerid)
{
	if(inko[playerid] == 7 && inkwork[playerid] == 2)
	{
		new money = moneyinko[playerid];
	
		new rang1 = GetPlayerZakazInko(playerid)+1;
		new rang2 = GetPlayerZakazInko(napinko[playerid])+1;
		SetPlayerZakazInko(playerid, rang1);
		SetPlayerZakazInko(napinko[playerid], rang2);
		
		GivePlayerMoney(playerid, moneyinko[playerid]);
		GivePlayerMoney(napinko[playerid], moneyinko[napinko[playerid]]);
		
		inko[playerid] = 2;
		inko[napinko[playerid]] = 2;
		
		blist[napinko[playerid]] = 0;
		blist[playerid] = 0;
		
		SendClientMessage(playerid, 0xFFFF00, "Вы успешно выполнили заказ и получили денежные средства");
		SendClientMessage(napinko[playerid], 0xFFFF00, "Вы успешно выполнили заказ и получили денежные средства");
		
		if(GetPlayerRang(playerid) == 1 && GetPlayerZakazInko(playerid) >= 150)
		{
			SetPlayerRang(playerid, 2);
			SendClientMessage(playerid, 0xFFFF00, "Вы успешно повысили ранг инкассатора на 2");
		}
					else if(GetPlayerRang(playerid) == 2 && GetPlayerZakazInko(playerid) >= 400)
		{
			SetPlayerRang(playerid, 3);
			SendClientMessage(playerid, 0xFFFF00, "Вы успешно повысили ранг инкассатора на 3");
		}
		
		if(GetPlayerRang(napinko[playerid]) == 1 && GetPlayerZakazInko(napinko[playerid]) >= 150)
		{
			SetPlayerRang(napinko[playerid], 2);
			SendClientMessage(napinko[playerid], 0xFFFF00, "Вы успешно повысили ранг инкассатора на 2");
		}
					else if(GetPlayerRang(napinko[playerid]) == 2 && GetPlayerZakazInko(napinko[playerid]) >= 400)
		{
			SetPlayerRang(napinko[playerid], 3);
			SendClientMessage(napinko[playerid], 0xFFFF00, "Вы успешно повысили ранг инкассатора на 3");
		}
	}	
}

