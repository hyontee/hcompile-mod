stock UpdateVehicleVisualForPlayer(playerid, vehicleid)
{  
 if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN_CAR) return 1;

 if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
 {
     new family_index = GetVehicleData(vehicleid, V_ACTION_ID);
     if(family_index >= 0)
     {
         SetVehicleColorHexForPlayers(playerid, vehicleid, GetCarFamily(family_index, V_F_BODY_COLORS), GetCarFamily(family_index, V_F_WHEEL_COLORS));
         new family_vinyl[32];
         ResolveFamilyCarVinylName(family_index, family_vinyl, sizeof family_vinyl, true);
         if(family_vinyl[0] != EOS) SetVehicleVinylForPlayer(playerid, vehicleid, family_vinyl);
         if(GetCarFamily(family_index, V_F_LIGHTS_COLOR) != 0) ddSetVehicleColorHexForPlayers(playerid, vehicleid, GetCarFamily(family_index, V_F_LIGHTS_COLOR));
         if(GetCarFamily(family_index, V_F_UNDERLIGHT_COLOR) != 0 || GetCarFamily(family_index, V_F_UNDERLIGHT_COLOR_LF) != 0 || GetCarFamily(family_index, V_F_UNDERLIGHT_COLOR_RT) != 0)
             SetVehicleNeonForPlayer(playerid, vehicleid, GetCarFamily(family_index, V_F_UNDERLIGHT_COLOR), GetCarFamily(family_index, V_F_UNDERLIGHT_COLOR_LF), GetCarFamily(family_index, V_F_UNDERLIGHT_COLOR_RT));
         if(GetCarFamily(family_index, F_TONIR_FT) != 0 || GetCarFamily(family_index, F_TONIR_RR) != 0)
             SetVehicleColorTonrrHexForPlayers(playerid, vehicleid, GetCarFamily(family_index, F_TONIR_FT), GetCarFamily(family_index, F_TONIR_RR));
         return 1;
     }
 }
 if(strlen(vInfo[vehicleid][vNumber][Number]) && strcmp(vInfo[vehicleid][vNumber][Number], "------", true))
 {
  if(vInfo[vehicleid][vNumber][Type] == 0) vInfo[vehicleid][vNumber][Type] = TYPE_RU;
  SetVehicleNumberPlateForPlayer(playerid, vehicleid, vInfo[vehicleid][vNumber][Type], vInfo[vehicleid][vNumber][Number], vInfo[vehicleid][vNumber][Region]);
 }
 SetVehicleTonerForPlayer  (playerid, vehicleid, vInfo[vehicleid][vTonerFront], vInfo[vehicleid][vTonerRear], vInfo[vehicleid][vTonerFrontSide], vInfo[vehicleid][vTonerRearSide]); 
 SetVehicleLightColorForPlayer (playerid, vehicleid, RGBA_to_ARGB(vInfo[vehicleid][vLightColor]));
 SetVehicleLightingForPlayer  (playerid, vehicleid, RGBA_to_ARGB(vInfo[vehicleid][vNeon][0]), RGBA_to_ARGB(vInfo[vehicleid][vNeon][1]), RGBA_to_ARGB(vInfo[vehicleid][vNeon][2]));
 SetVehicleVinylForPlayer  (playerid, vehicleid, vInfo[vehicleid][vVinylTexture]);
 SetVehicleColorForPlayer  (playerid, vehicleid, RGBA_to_ARGB(vInfo[vehicleid][vColorBody]), RGBA_to_ARGB(vInfo[vehicleid][vColorWheels]));
 if(vInfo[vehicleid][vStrob] > 0 && vInfo[vehicleid][strab_current] != 0 && EnableStrob[vehicleid]) SetVehicleStroboscopeForPlayer(playerid, vehicleid, vInfo[vehicleid][vStrob]-1);
 else SetVehicleStroboscopeForPlayer(playerid, vehicleid, 5);
 SetVehicleHighLightForPlayer (playerid, vehicleid, 1);
 SetVehicleEnableSirenForPlayer (playerid, vehicleid, 0); 
 SetVehicleSirenForPlayer  (playerid, vehicleid, vInfo[vehicleid][vSiren]);
}
