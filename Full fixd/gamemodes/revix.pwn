				{
					Dialog
					(
						playerid, DIALOG_BUY_PREFIX, DIALOG_STYLE_INPUT,
						"Админ Префикс",
						"Введите в окошко ниже префикс который вы хотите\n\
						Примечание: Используйте префикс до 15 символов!",
