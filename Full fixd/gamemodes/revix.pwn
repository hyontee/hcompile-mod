#define GUI66_BTN_KICK   (3)
#define GUI66_BTN_MUTE   (4)
#define GUI66_BTN_JAIL   (5)
#define GUI66_BTN_WARN   (6)
#define GUI66_BTN_SLAP   (7)
#define GUI66_BTN_BAN    (8)

stock GUI66_OpenReasonDialog(playerid, targetid, dialogid)
{
    new fmt_text[256], title[64];
    SetPVarInt(playerid, "gui66_reason_target", targetid);

    switch(dialogid)
    {
        case DIALOG_GUI66_MUTE_REASON:
        {
            format(title, sizeof title, "Причина мута: %s", GetPlayerNameEx(targetid));
            fmt_text[0] = 0;
            for(new i; i < sizeof g_gui66_mute_reasons; i++)
                format(fmt_text, sizeof fmt_text, "%s%s (%d мин)\n", fmt_text, g_gui66_mute_reasons[i], g_gui66_mute_reason_time[i]);
        }
        case DIALOG_GUI66_KICK_REASON:
        {
            format(title, sizeof title, "Причина кика: %s", GetPlayerNameEx(targetid));
            fmt_text[0] = 0;
            for(new i; i < sizeof g_gui66_kick_reasons; i++)
                format(fmt_text, sizeof fmt_text, "%s%s\n", fmt_text, g_gui66_kick_reasons[i]);
        }
        case DIALOG_GUI66_BAN_REASON:
        {
            format(title, sizeof title, "Причина бана: %s", GetPlayerNameEx(targetid));
            fmt_text[0] = 0;
            for(new i; i < sizeof g_gui66_ban_reasons; i++)
                format(fmt_text, sizeof fmt_text, "%s%s (%d дн.)\n", fmt_text, g_gui66_ban_reasons[i], g_gui66_ban_reason_days[i]);
        }
        case DIALOG_GUI66_WARN_REASON:
        {
            format(title, sizeof title, "Причина варна: %s", GetPlayerNameEx(targetid));
            fmt_text[0] = 0;
            for(new i; i < sizeof g_gui66_warn_reasons; i++)
                format(fmt_text, sizeof fmt_text, "%s%s\n", fmt_text, g_gui66_warn_reasons[i]);
        }
        case DIALOG_GUI66_JAIL_REASON:
        {
            format(title, sizeof title, "Причина тюрьмы: %s", GetPlayerNameEx(targetid));
            fmt_text[0] = 0;
            for(new i; i < sizeof g_gui66_jail_reasons; i++)
                format(fmt_text, sizeof fmt_text, "%s%s (%d мин)\n", fmt_text, g_gui66_jail_reasons[i], g_gui66_jail_reason_time[i]);
        }
        case DIALOG_GUI66_SLAP_REASON:
        {
            format(title, sizeof title, "Слап: %s", GetPlayerNameEx(targetid));
            fmt_text[0] = 0;
            for(new i; i < sizeof g_gui66_slap_reasons; i++)
                format(fmt_text, sizeof fmt_text, "%s%s\n", fmt_text, g_gui66_slap_reasons[i]);
        }
    }

    Dialog(playerid, dialogid, DIALOG_STYLE_LIST, title, fmt_text, "Выбрать", "Отмена");
    return 1;
}

stock GUI66_DoKick(playerid, targetid, reason[])
{
    if(GetPlayerAdminEx(playerid) < 14) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Недостаточно прав для кика", "qq");
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Такого игрока нет", "qq");
    if(GetPlayerAdminEx(targetid) > GetPlayerAdminEx(playerid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Нельзя кикнуть админа выше по рангу", "qq");
    if(AntiSliv(playerid, "/kick")) return 1;

    new fmt_msg[200];
    format(fmt_msg, sizeof fmt_msg, "Администратор %s кикнул игрока %s. Причина: %s (панель слежения)", GetPlayerNameEx(playerid), GetPlayerNameEx(targetid), reason);
    SendClientMessageToAll(0xFF5533FF, fmt_msg);
    SendClientMessage(targetid, 0xCC6600FF, "Вас отключили от сервера, можете выйти.");

    format(fmt_msg, sizeof fmt_msg, "Кикнул %s[acc:%d]. Причина: %s (панель)", GetPlayerNameEx(targetid), GetPlayerAccountID(targetid), reason);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

    StopSpectateGUIRefresh(playerid);
    StopSpectate(playerid);
    Spectate_RestoreSkin(playerid);

    Kick(targetid);
    return 1;
}

stock GUI66_DoMute(playerid, targetid, mute_time = 15, reason[])
{
    if(GetPlayerAdminEx(playerid) < 1) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Недостаточно прав для мута", "qq");
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Такого игрока нет", "qq");
    if(GetPlayerData(targetid, P_MUTE) > 0) return ShowNotificationNew(playerid, 2, 6, 0, 0, "У этого игрока уже есть мут", "qq");
    if(GetPlayerAdminEx(targetid) > GetPlayerAdminEx(playerid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Нельзя замутить админа выше по рангу", "qq");
    if(AntiSliv(playerid, "/mute")) return 1;

    new fmt_msg[160];
    format(fmt_msg, sizeof fmt_msg, "Администратор %s выдал блокировку чата игроку %s на %d мин. Причина: %s (панель)", GetPlayerNameEx(playerid), GetPlayerNameEx(targetid), mute_time, reason);
    SendClientMessageToAll(0xFF5533FF, fmt_msg);

    SetPlayerData(targetid, P_MUTE, mute_time * 60);
    UpdatePlayerDatabaseInt(targetid, "mute", mute_time * 60);
    SendClientMessage(targetid, 0xCECECEFF, "Время до окончания бана чата: {CCCC00}/time");

    format(fmt_msg, sizeof fmt_msg, "Выдал %s[acc:%d] блокировку чата на %d мин. Причина: %s (панель)", GetPlayerNameEx(targetid), GetPlayerAccountID(targetid), mute_time, reason);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

    ShowNotificationNew(playerid, 2, 6, 0, 0, "Мут выдан", "qq");
    return 1;
}

stock GUI66_DoJail(playerid, targetid, jail_time = 60, reason[] = "Причина не указана")
{
    if(GetPlayerAdminEx(playerid) < 1) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Недостаточно прав для тюрьмы", "qq");
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Такого игрока нет", "qq");
    if(GetPlayerData(targetid, P_JAIL) > 0) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Этот игрок уже сидит в тюрьме", "qq");
    if(AntiSliv(playerid, "/jail")) return 1;

    new fmt_msg[160];
    format(fmt_msg, sizeof fmt_msg, "Администратор %s посадил в тюрьму игрока %s на %d мин. Причина: %s (панель)", GetPlayerNameEx(playerid), GetPlayerNameEx(targetid), jail_time, reason);
    SendClientMessageToAll(0xFF5533FF, fmt_msg);
    SendClientMessage(targetid, 0xCECECEFF, "Время до окончания заключения: {CCCC00}/time");

    JailPlayer(targetid, jail_time);

    format(fmt_msg, sizeof fmt_msg, "Посадил в тюрьму %s[acc:%d] на %d мин. Причина: %s (панель)", GetPlayerNameEx(targetid), GetPlayerAccountID(targetid), jail_time, reason);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

    ShowNotificationNew(playerid, 2, 6, 0, 0, "Игрок посажен в тюрьму", "qq");
    return 1;
}

stock GUI66_DoWarn(playerid, targetid, reason[])
{
    if(GetPlayerAdminEx(playerid) < 2) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Недостаточно прав для варна", "qq");
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Такого игрока нет", "qq");
    if(GetPlayerAdminEx(targetid) > GetPlayerAdminEx(playerid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Нельзя выдать варн админу выше по рангу", "qq");
    if(AntiSliv(playerid, "/warn")) return 1;

    AddPlayerData(targetid, P_WARN, +, 1);
    SetPlayerData(targetid, P_WARN_TIME, gettime() + (86400 * 10));

    new fmt_msg[160];
    format(fmt_msg, sizeof fmt_msg, "Администратор %s выдал предупреждение игроку %s [%d|3]. Причина: %s (панель)", GetPlayerNameEx(playerid), GetPlayerNameEx(targetid), GetPlayerData(targetid, P_WARN), reason);
    SendClientMessageToAll(0xFF5533FF, fmt_msg);

    new uid = GetPlayerAccountID(targetid);
    new warns = GetPlayerData(targetid, P_WARN);
    new warns_time = GetPlayerData(targetid, P_WARN_TIME);

    format(fmt_msg, sizeof fmt_msg, "Выдал варн %s[acc:%d] (%d/3). Причина: %s (панель)", GetPlayerNameEx(targetid), uid, warns, reason);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

    if(warns >= 3)
    {
        SendClientMessage(targetid, 0xFF5533FF, "Аккаунт заблокирован на 10 дней");
        warns = 0;
        warns_time = 0;
        AddBan(uid, gettime(), 10, GetPlayerIpEx(targetid), "получено 3 варна", GetPlayerNameEx(playerid));
        BanEx(targetid, "получено 3 варна");
    }
    else
    {
        Kick:(targetid);
    }

    format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET warn=%d,warn_time=%d WHERE id=%d", warns, warns_time, uid);
    mysql_query(mysql, fmt_msg, false);

    ShowNotificationNew(playerid, 2, 6, 0, 0, "Предупреждение выдано", "qq");
    return 1;
}

stock GUI66_DoSlap(playerid, targetid, bool:up = true)
{
    if(GetPlayerAdminEx(playerid) < 2) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Недостаточно прав для слапа", "qq");
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Такого игрока нет", "qq");

    new Float:x, Float:y, Float:z;
    GetPlayerPos(targetid, x, y, z);
    SetPlayerPos(targetid, x, y, up ? (z + 10.0) : (z - 5.0));
    PlayerPlaySound(targetid, 1130, 0.0, 0.0, 0.0);

    new fmt_text[200];
    format(fmt_text, sizeof fmt_text, "[A] %s[%d] подбросил игрока %s[%d] (панель)", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid);
    SendMessageToAdmins(fmt_text, 0x999999FF);

    format(fmt_text, sizeof fmt_text, "{1E90FF}Администратор %s подбросил Вас", GetPlayerNameEx(playerid));
    SendClientMessage(targetid, -1, fmt_text);

    ShowNotificationNew(playerid, 2, 6, 0, 0, "Игрок подброшен", "qq");
    return 1;
}

stock GUI66_DoBan(playerid, targetid, days = 1, reason[])
{
    if(GetPlayerAdminEx(playerid) < 3) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Недостаточно прав для бана", "qq");
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Такого игрока нет", "qq");
    if(GetPlayerAdminEx(targetid) >= GetPlayerAdminEx(playerid)) return ShowNotificationNew(playerid, 2, 6, 0, 0, "Нельзя забанить админа с равным/выше рангом", "qq");
    if(AntiSliv(playerid, "/ban")) return 1;

    if(!AddBan(GetPlayerAccountID(targetid), gettime(), days, GetPlayerIpEx(targetid), reason, GetPlayerNameEx(playerid)))
        return ShowNotificationNew(playerid, 2, 6, 0, 0, "Ошибка базы данных: не удалось записать блокировку", "qq");

    new announce[256];
    format(announce, sizeof(announce), "Администратор %s заблокировал игрока %s на %d дней (панель), причина: %s", GetPlayerNameEx(playerid), GetPlayerNameEx(targetid), days, reason);
    SendClientMessageToAll(0xFF5533FF, announce);

    new log_msg[256];
    format(log_msg, sizeof(log_msg), "BAN: %s[%d] -> %s[acc:%d] на %d дней (панель). Причина: %s", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), GetPlayerAccountID(targetid), days, reason);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, log_msg);

    SendClientMessage(targetid, 0xFF5533FF, "Вы заблокированы администрацией сервера.");
    SetTimerEx("KickBannedPlayer", 1200, false, "i", targetid);

    StopSpectateGUIRefresh(playerid);
    StopSpectate(playerid);
    Spectate_RestoreSkin(playerid);

    return 1;
}


stock AT_SendPunishTemplates(playerid, category)
{
    new Node:json_response = JSON_Object();
    JSON_SetInt(json_response, "t", 2);

    switch(category)
    {
        case GUI66_BTN_KICK:
        {
            JSON_SetString(json_response, "bn", "Кик");
            JSON_SetInt(json_response, "tf", 0);
            new Node:t1 = JSON_Object("bi", JSON_Int(1), "bn", JSON_String("Afk no esc"), "be", JSON_String("Afk no esc"));
            new Node:t2 = JSON_Object("bi", JSON_Int(2), "bn", JSON_String("Помеха"), "be", JSON_String("Помеха"));
            new Node:t3 = JSON_Object("bi", JSON_Int(3), "bn", JSON_String("Баг"), "be", JSON_String("Баг"));
            JSON_SetArray(json_response, "bt", JSON_Array(t1, t2, t3));
        }
        case GUI66_BTN_MUTE:
        {
            JSON_SetString(json_response, "bn", "Мут");
            JSON_SetInt(json_response, "tf", 1);
            new Node:t1 = JSON_Object("bi", JSON_Int(4), "bn", JSON_String("Оскорбление"), "be", JSON_String("Оскорбление игроков"), "br", JSON_Int(15));
            new Node:t2 = JSON_Object("bi", JSON_Int(5), "bn", JSON_String("Упоминание родни"), "be", JSON_String("Упоминание родни"), "br", JSON_Int(30));
            new Node:t3 = JSON_Object("bi", JSON_Int(6), "bn", JSON_String("Неуважение к администрации"), "be", JSON_String("Неуважение к администрации"), "br", JSON_Int(60));
            new Node:t4 = JSON_Object("bi", JSON_Int(7), "bn", JSON_String("CAPS"), "be", JSON_String("Капс в чате"), "br", JSON_Int(10));
            JSON_SetArray(json_response, "bt", JSON_Array(t1, t2, t3, t4));
        }
        case GUI66_BTN_JAIL:
        {
            JSON_SetString(json_response, "bn", "Тюрьма");
            JSON_SetInt(json_response, "tf", 1);
            new Node:t1 = JSON_Object("bi", JSON_Int(8), "bn", JSON_String("DM"), "be", JSON_String("DM без причины"), "br", JSON_Int(10));
            new Node:t2 = JSON_Object("bi", JSON_Int(9), "bn", JSON_String("DB"), "be", JSON_String("DriveBy"), "br", JSON_Int(15));
            new Node:t3 = JSON_Object("bi", JSON_Int(10), "bn", JSON_String("TK"), "be", JSON_String("TeamKill"), "br", JSON_Int(20));
            new Node:t4 = JSON_Object("bi", JSON_Int(11), "bn", JSON_String("Провокация ГОС"), "be", JSON_String("Провокация гос. организаций"), "br", JSON_Int(25));
            JSON_SetArray(json_response, "bt", JSON_Array(t1, t2, t3, t4));
        }
        case GUI66_BTN_WARN:
        {
            JSON_SetString(json_response, "bn", "Предупреждение");
            JSON_SetInt(json_response, "tf", 0);
            new Node:t1 = JSON_Object("bi", JSON_Int(12), "bn", JSON_String("НонРП COP"), "be", JSON_String("НонРП коп"));
            new Node:t2 = JSON_Object("bi", JSON_Int(13), "bn", JSON_String("НонРП В/Ч"), "be", JSON_String("НонРП в/ч"));
            new Node:t3 = JSON_Object("bi", JSON_Int(14), "bn", JSON_String("ОРП"), "be", JSON_String("ОРП"));
            new Node:t4 = JSON_Object("bi", JSON_Int(15), "bn", JSON_String("Снят ЛД"), "be", JSON_String("Снятие ЛД"));
            JSON_SetArray(json_response, "bt", JSON_Array(t1, t2, t3, t4));
        }
        case GUI66_BTN_SLAP:
        {
            JSON_SetString(json_response, "bn", "Шлепок");
            JSON_SetInt(json_response, "tf", 0);
            new Node:t1 = JSON_Object("bi", JSON_Int(16), "bn", JSON_String("Подбросить вверх"), "be", JSON_String("Подбросить вверх"));
            new Node:t2 = JSON_Object("bi", JSON_Int(17), "bn", JSON_String("Подбросить вниз"), "be", JSON_String("Подбросить вниз"));
            JSON_SetArray(json_response, "bt", JSON_Array(t1, t2));
        }
        case GUI66_BTN_BAN:
        {
            JSON_SetString(json_response, "bn", "Бан");
            JSON_SetInt(json_response, "tf", 1);
            new Node:t1 = JSON_Object("bi", JSON_Int(18), "bn", JSON_String("Mass DM"), "be", JSON_String("Массовый DM"), "br", JSON_Int(7));
            new Node:t2 = JSON_Object("bi", JSON_Int(19), "bn", JSON_String("П/П/В"), "be", JSON_String("П/П/В"), "br", JSON_Int(30));
            new Node:t3 = JSON_Object("bi", JSON_Int(20), "bn", JSON_String("Оск. Родни"), "be", JSON_String("Оскорбление родни"), "br", JSON_Int(14));
            new Node:t4 = JSON_Object("bi", JSON_Int(21), "bn", JSON_String("Читы"), "be", JSON_String("Использование читов"), "br", JSON_Int(365));
            JSON_SetArray(json_response, "bt", JSON_Array(t1, t2, t3, t4));
        }
    }

    OnPacketIncoming(playerid, 66, json_response);
    JSON_Cleanup(json_response);
    return 1;
}


stock AT_ApplyPunishTemplate(playerid, targetid, templateId)
{
    if(!IsPlayerConnected(targetid)) return 0;

    switch(templateId)
    {
        case 1: return GUI66_DoKick(playerid, targetid, "Afk no esc");
        case 2: return GUI66_DoKick(playerid, targetid, "Помеха");
        case 3: return GUI66_DoKick(playerid, targetid, "Баг");

        case 4: return GUI66_DoMute(playerid, targetid, 15, "Оскорбление игроков");
        case 5: return GUI66_DoMute(playerid, targetid, 30, "Упоминание родни");
        case 6: return GUI66_DoMute(playerid, targetid, 60, "Неуважение к администрации");
        case 7: return GUI66_DoMute(playerid, targetid, 10, "CAPS");

        case 8: return GUI66_DoJail(playerid, targetid, 10, "DM без причины");
        case 9: return GUI66_DoJail(playerid, targetid, 15, "DB");
        case 10: return GUI66_DoJail(playerid, targetid, 20, "TeamKill");
        case 11: return GUI66_DoJail(playerid, targetid, 25, "Провокация ГОС");

        case 12: return GUI66_DoWarn(playerid, targetid, "НонРП COP");
        case 13: return GUI66_DoWarn(playerid, targetid, "НонРП В/Ч");
        case 14: return GUI66_DoWarn(playerid, targetid, "ОРП");
        case 15: return GUI66_DoWarn(playerid, targetid, "Снят ЛД");

        case 16: return GUI66_DoSlap(playerid, targetid, true);
        case 17: return GUI66_DoSlap(playerid, targetid, false);

        case 18: return GUI66_DoBan(playerid, targetid, 7, "Mass DM");
        case 19: return GUI66_DoBan(playerid, targetid, 30, "П/П/В");
        case 20: return GUI66_DoBan(playerid, targetid, 14, "Оскорбление родни");
        case 21: return GUI66_DoBan(playerid, targetid, 365, "Читы");

        default: return 0;
    }
}

IPacket:252(playerid, BitStream:bitstream)
{
    new
        header,
        rpcid, 
        data_len,
        data[4096], 
        outcoming_data[512], 
        Node:json = JSON_Object(), 
        Node:json_packet_data = JSON_Object(), 
        Node:JSONObject = JSON_Object(); 

    BS_ReadValue(bitstream, PR_UINT8, header);
    BS_ReadValue(bitstream, PR_UINT16, rpcid);
	if(rpcid == 128)
    {
		new action;
        new id;
		new damage;
        if(!BS_ReadUint32(bitstream, action))
        {
            return 1;
        }
		if(action == 22)
        {
			printf("INCOMING DAMAGE:");
		}
        if(action == 1)
        {
			printf("INCOMING DAMAGE:");
			if(!BS_ReadUint16(bitstream, id))
            {
                return 1;
            }
			if(!BS_ReadUint32(bitstream, damage))
            {
                return 1;
            }
			printf("INCOMING DAMAGE: %d HP for ID: %d", id, damage);
		}
	}
if (rpcid == 111){
	return 1;
}
    printf("[DEBUG] IPacket:252 - playerid: %d, header: %d, rpcid: %d", playerid, header, rpcid);

    new length; 
    BS_ReadValue(bitstream, PR_UINT32, length);
    if(length <= 0 || length >= sizeof(data))
    {
        printf("[GUI][WARN] IPacket:252 invalid payload length: player=%d rpcid=%d len=%d cap=%d", playerid, rpcid, length, sizeof(data));
        return 1;
    }
    BS_ReadValue(bitstream, PR_STRING, data, length);
    data[length] = EOS;

    printf("[DEBUG] IPacket:252 - data length: %d, data: %s", length, data);

    JSON_Parse(data, json); 

    switch(rpcid) 
    {
       case 71:
       {
            return Calendar_HandlePacket(playerid, json);
       }

       case 39, 65:
       {
            return BlackPass_HandleExtraGui(playerid, rpcid, json);
       }
       case 40:
  {
   new type;
   JSON_GetInt(json, "t", type);
   
   switch(type)
   {
    case 2:
    {
     Wound_SendToHospital(playerid);
    }
   }
  }
        case 113:
{
    new type;

    
    
    
    
    if (JSON_GetInt(json, "c", type))
    {
        printf("[RPC 113] close type = %d", type);
        if(type == 1)
        {
            printf("[RPC 113] Player %d closed action menu", playerid);
            return 1;
        }
    }
    else if (JSON_GetInt(json, "a", type))
    {
        printf("[RPC 113] action type = %d", type);
    }
    else
    {
        printf("[RPC 113] action/close type not found");
        return 1;
    }

    switch (type) {
        case 2:
        {
            new Node:root = JSON_Object();
            ShowPlayerGUI(playerid, 47, root);
            JSON_Cleanup(root);
        }
        case 3:  ShowNotificationNew(playerid, 2, 6, 0, 0, "Уведомление не найдены", "qq");
        case 4:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 5:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 100:ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 8:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 12: animsss(playerid);
        case 13: donatess(playerid);
        case 18: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 19: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 22: rewardsss(playerid);
        case 11: inssssv(playerid);
        case 21: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 15: promosss(playerid);
        case 14: carssssc(playerid);
        case 7:  gpswww(playerid);
        case 17: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 25: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 20: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 9:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 24: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 16: sssreport(playerid);
        default: printf("[RPC 113] Неизвестный тип: %d", type);
    }

    return 1;
}

case 77:
{
    
    
    return Marketplace_OnPacket(playerid, json);
}

case 78:
{
    return MPReward_OnPacket(playerid, json);
}

case GUIDrivingSchool: 
{
    printf("[DV-DEBUG] Incoming GUIDrivingSchool packet from player=%d", playerid);
    return HandlePacketDV(playerid, json);
}

case 45: 
{
    return PacketIncomingFamily(playerid, json);
}

	case GUIFuelFill:
	{
		if(AZC_HandleFuelGui(playerid, json))
		{
			return 1;
		}
		return 0;
	}

	case 9:
{
    return Music_OnAudioGuiPacket(playerid, json);
}


	case 25:
{
    new type;
    JSON_GetInt(json, "t", type);
    
    printf("[CASE 25] Получен пакет типа %d от игрока %d", type, playerid);

    switch(type)
    {
        case 1: 
        {
            printf("[CASE 25][TYPE 1] Запрос обновления списка игроков от %d", playerid);
            
            new Node:response = JSON_Object();
            
            
            new Node:playersArray = JSON_Array();
            new playerIndex = 0;
            
            foreach(new i : Player)
            {
                if(!IsPlayerConnected(i)) continue;
                
                new Node:playerObj = JSON_Object();
                JSON_SetInt(playerObj, "id", i);
                
                new name[MAX_PLAYER_NAME];
                GetPlayerName(i, name, sizeof(name));
                JSON_SetString(playerObj, "nick", name);
                
                JSON_SetInt(playerObj, "level", GetPlayerData(i, P_LEVEL));
                JSON_SetInt(playerObj, "ping", GetPlayerPing(i));
                
                
                JSON_ArrayAppend(playersArray, "", playerObj);
                
                JSON_Cleanup(playerObj);
                playerIndex++;
                
                printf("[CASE 25][TYPE 1] Добавлен игрок %d: %s", i, name);
            }
            
            printf("[CASE 25][TYPE 1] Всего добавлено игроков: %d", playerIndex);
            
            JSON_SetInt(response, "t", 1);
            JSON_SetArray(response, "data", playersArray);
            
            
            new jsonString[4096];
            JSON_Stringify(response, jsonString, sizeof(jsonString));
            printf("[CASE 25][TYPE 1] JSON ответ (первые 200 символов): %.200s", jsonString);
            
            OnPacketIncoming(playerid, 25, response);
            
            
            JSON_Cleanup(playersArray);
            JSON_Cleanup(response);
            
            return 1;
        }

        case 2: 
        {
            printf("[CASE 25][TYPE 2] Игрок %d закрыл окно", playerid);
            return 1;
        }
        
        default:
        {
            printf("[CASE 25][ERROR] Неизвестный тип пакета: %d от игрока %d", type, playerid);
            return 0;
        }
    }
}

        case 34:
        {
            if(FamilyStorageIsWarehouseGui(playerid))
                return FamilyStorageHandleInventoryPacket(playerid, json);

            new type = -1;
            JSON_GetInt(json, "t", type);            if(type == 8)
            {
                
                printf("[TRUNKTEST] close gui: player=%d vehicle=%d (context kept)", playerid, GetPVarInt(playerid, PVAR_TRUNKTEST_VEHICLE));
                return 1;
            }

            if(type == 3 || type == 4 || type == 5 || type == 6 || type == 7)
            {
                printf("[TRUNKTEST] menu action: player=%d type=%d", playerid, type);
                return 1;
            }

                        new vehicleid = GetPVarInt(playerid, PVAR_TRUNKTEST_VEHICLE);
            if(vehicleid == 0 || vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
            {
                new restore_vehicle = INVALID_VEHICLE_ID;
                if(TrunkTest_GetNearbyPersonalVehicle(playerid, restore_vehicle, 7.0) && TrunkTest_IsPlayerNearVehicleRear(playerid, restore_vehicle, 3.0))
                {
                    vehicleid = restore_vehicle;
                    SetPVarInt(playerid, PVAR_TRUNKTEST_VEHICLE, vehicleid);
                    printf("[TRUNKTEST] restored vehicle context: player=%d type=%d vehicle=%d", playerid, type, vehicleid);
                }
            }

            if(vehicleid == 0 || vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
            {
                printf("[TRUNKTEST][ERROR] packet without active vehicle: player=%d type=%d vehicle=%d", playerid, type, vehicleid);

                new Node:resp_no_vehicle = JSON_Object();
                JSON_SetInt(resp_no_vehicle, "t", type);
                JSON_SetInt(resp_no_vehicle, "s", 0);
                OnPacketIncoming(playerid, 34, resp_no_vehicle);
                JSON_Cleanup(resp_no_vehicle);
                return 1;
            }

            new ga = 0, os = -1, ns = -1, value = 0;
            JSON_GetInt(json, "ga", ga);
            JSON_GetInt(json, "os", os);
            JSON_GetInt(json, "ns", ns);
            JSON_GetInt(json, "v", value);

            if(ns == -1)
            {
                JSON_GetInt(json, "s", ns);
            }

            if(type == 0 && os == 0) os = 1;
            if(type == 1 && ns == 0) ns = 1;
            if((type == 2 || type == 9) && ns == 0) ns = 1;

            new bool:ok = false;
            new Node:resp = JSON_Object();
            JSON_SetInt(resp, "t", type);

            switch(type)
            {
                case 0:
                {
                    printf("[TRUNKTEST] type=0 request: player=%d vehicle=%d ga=%d os=%d ns=%d v=%d", playerid, vehicleid, ga, os, ns, value);
                    ok = TrunkTest_MoveInventoryToTrunk(playerid, vehicleid, ga, os, ns, value);
                    JSON_SetInt(resp, "w", Inventory11_GetCurrentWeightKg(playerid));
                    JSON_SetInt(resp, "bw", TrunkTest_GetTrunkWeightKg(vehicleid));
                }
                case 1:
                {
                    printf("[TRUNKTEST] type=1 request: player=%d vehicle=%d ga=%d os=%d ns=%d v=%d", playerid, vehicleid, ga, os, ns, value);
                    ok = TrunkTest_MoveTrunkToInventory(playerid, vehicleid, ga, os, ns, value);
                    JSON_SetInt(resp, "w", Inventory11_GetCurrentWeightKg(playerid));
                    JSON_SetInt(resp, "bw", TrunkTest_GetTrunkWeightKg(vehicleid));
                }
                case 2, 9:
                {
                    new slot_item = ga;
                    new active_slot = os;
                    new target_slot = ns;

                    ok = false;

                    if(slot_item == 134 || slot_item == 122)
                    {
                        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Нельзя снять одежду", " ");
                    }
					else if(!Inventory11_IsAccessoryItem(slot_item))
                    {
                        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Неверный аксессуар", " ");
                    }
					else
                    {
                        if(active_slot == 0)
                        {
                            active_slot = 1;
                        }

                        if(!InvV3_IsActiveAccSlot(active_slot))
                        {
                            active_slot = 1;
                        }
                            if(target_slot < 1 || target_slot > Inventory11_GetMaxSlots(playerid))
                            {
                                target_slot = TrunkTest_GetFreeInventorySlot(playerid);
                            }

                            if(target_slot == -1)
                            {
                                ShowNotificationLaird(playerid, 2, 6, 0, 0, "Нету мест в инвентаре", " ");
                            }
        					else
                            {
                                new item_weight_x10 = InventoryCfg_GetItemWeightX10(slot_item);
                                if(item_weight_x10 <= 0) item_weight_x10 = 10;

                                if(Inventory11_GetCurrentWeightX10(playerid) + item_weight_x10 > (Inventory11_GetMaxWeightKg(playerid) * 10))
                                {
                                    ShowNotificationLaird(playerid, 2, 6, 0, 0, "Нету мест в инвентаре", " ");
                                }
            					else
                                {
                                    new moved_model = 0;
                                    new used_slot = active_slot;
                                    if(!Inventory11_MoveActiveAccessoryToInventorySlot(playerid, slot_item, used_slot, target_slot, moved_model))
                                    {
                                        used_slot = (used_slot == 1) ? 2 : 1;
                                        if(!Inventory11_MoveActiveAccessoryToInventorySlot(playerid, slot_item, used_slot, target_slot, moved_model))
                                        {
                                            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Аксессуар не надет", " ");
                                        }
                    					else
                                        {
                                            ok = true;
                                            JSON_SetInt(resp, "w", Inventory11_GetCurrentWeightKg(playerid));
                                            JSON_SetInt(resp, "bw", TrunkTest_GetTrunkWeightKg(vehicleid));
                                        }
                                    }
                					else
                                    {
                                        ok = true;
                                        JSON_SetInt(resp, "w", Inventory11_GetCurrentWeightKg(playerid));
                                        JSON_SetInt(resp, "bw", TrunkTest_GetTrunkWeightKg(vehicleid));
                                    }
                                }
                            }
                        }
                    }
                default:
                {
                    printf("[TRUNKTEST][WARN] unknown action: player=%d type=%d ga=%d os=%d ns=%d v=%d", playerid, type, ga, os, ns, value);
                    ok = false;
                }
            }

            JSON_SetInt(resp, "s", ok ? 1 : 0);
            OnPacketIncoming(playerid, 34, resp);
            JSON_Cleanup(resp);

            if(ok)
            {
                TrunkTest_OpenGui(playerid, vehicleid);
            }
            return 1;
        }
        case 22:
        {
            new type;
            JSON_GetInt(json, "t", type);

            if((type == -2 || type == -1) && BlackPass_HandlePacket(playerid, json))
            {
                return 1;
            }

            printf("[DEBUG] IPacket:252 - rpcid 22, type: %d", type);

            switch(type)
            {
				case 1:
				{
					callcmd::casestest(playerid);
				}
                case 2:
                {
                    printf("[DEBUG] IPacket:252 - type 2, playerid: %d, P_SALE_TIME: %d", playerid, GetPlayerData(playerid, P_SALE_TIME));
                    if(GetPlayerData(playerid, P_SALE_TIME) != 0) return 1;

                    ShowPlayerDialog(playerid, 1912, DIALOG_STYLE_MSGBOX, "{FF0000}Подарок", "При открытии подарка, вы получили бронзовую рулетку!", "Закрыть", "");

                    SetPlayerData(playerid, P_SALE_TIME, 7200); 
                    UpdatePlayerDatabaseInt(playerid, "sale_time", GetPlayerData(playerid, P_SALE_TIME));

                    printf("[DEBUG] IPacket:252 - Set P_SALE_TIME to 7200 for playerid: %d", playerid);

                    JSON_SetInt(json_packet_data, "t", 2);
                    JSON_SetInt(json_packet_data, "p", GetPlayerData(playerid, P_SALE_TIME));

                    OnPacketIncoming(playerid, 22, json_packet_data);

                    printf("[DEBUG] IPacket:252 - OnPacketIncoming called for playerid: %d, rpcid: 22", playerid);

                    JSON_Cleanup(json_packet_data);

                    
                }

				case 4:
{
    new value;
    JSON_GetInt(json, "v", value); 
    printf("[DEBUG] IPacket:252 - type 4, playerid: %d, exchange donate: %d", playerid, value);

    if(value <= 0)
    {
        JSON_SetInt(json_packet_data, "t", 4);
        JSON_SetInt(json_packet_data, "y", 0);
        JSON_SetString(json_packet_data, "m", "Ошибка: некорректное количество доната для обмена.");
        JSON_SetString(json_packet_data, "n", "Введите положительное число.");
        OnPacketIncoming(playerid, 22, json_packet_data);
        JSON_Cleanup(json_packet_data);
        return 1;
    }

    if(GetPlayerDonateRub(playerid) < value)
    {
        JSON_SetInt(json_packet_data, "t", 4);
        JSON_SetInt(json_packet_data, "y", 0);
        JSON_SetString(json_packet_data, "m", "Недостаточно доната для обмена.");
        JSON_SetString(json_packet_data, "n", "Пополните баланс, чтобы произвести обмен.");
        printf("[DEBUG] IPacket:252 - type 4, insufficient donate: playerid: %d, have: %d, need: %d",
            playerid, GetPlayerDonateRub(playerid), value);
        OnPacketIncoming(playerid, 22, json_packet_data);
        JSON_Cleanup(json_packet_data);
        return 1;
    }

    
    new give_money = value * 1000;

    
    GivePlayerDonateRub(playerid, -value);
    GivePlayerMoney(playerid, give_money);

    printf("[DEBUG] IPacket:252 - type 4, exchanged %d donate -> %d money, playerid: %d, new DonateRub: %d, Money: %d",
        value, give_money, playerid, GetPlayerDonateRub(playerid), GetPlayerMoney(playerid));

    
    JSON_SetInt(json_packet_data, "t", 4);
    JSON_SetInt(json_packet_data, "y", 1);
    JSON_SetInt(json_packet_data, "v", value);
    JSON_SetInt(json_packet_data, "r", GetPlayerMoney(playerid));
    JSON_SetInt(json_packet_data, "s", GetPlayerDonateRub(playerid));
    JSON_SetString(json_packet_data, "m", "Обмен успешно выполнен!");
    JSON_SetString(json_packet_data, "n", "Вы обменяли донат на рубли.");

    OnPacketIncoming(playerid, 22, json_packet_data);
    JSON_Cleanup(json_packet_data);
}


                case 0:
                {
                    new price, client_price, internal_id, donate_vehicle_color = 0;
                    new donate_item_type, donate_game_id, donate_item_count, donate_model_id, donate_money, donate_rubles;

                    JSON_GetInt(json, "p", internal_id);
                    JSON_GetInt(json, "m", client_price);

                    
                    if(!DonateCatalog_Get(internal_id, donate_item_type, donate_game_id, price, donate_item_count, donate_model_id, donate_money, donate_rubles))
                    {
                        JSON_SetInt(json_packet_data, "t", 0);
                        JSON_SetInt(json_packet_data, "y", 0);
                        JSON_SetInt(json_packet_data, "k", 1);
                        JSON_SetString(json_packet_data, "m", "Товар не найден в каталоге.");
                        JSON_SetString(json_packet_data, "n", "Обновите клиент или обратитесь к администрации.");
                        printf("[DONATE][ERROR] Unknown internal_id=%d player=%d client_price=%d", internal_id, playerid, client_price);
                        OnPacketIncoming(playerid, 22, json_packet_data);
                        JSON_Cleanup(json_packet_data);
                        return 1;
                    }

                    
                    if(donate_item_type == 1 || donate_item_type == 4 || donate_item_type == 10 || donate_item_type == -1 || price <= 0)
                    {
                        JSON_SetInt(json_packet_data, "t", 0);
                        JSON_SetInt(json_packet_data, "y", 0);
                        JSON_SetInt(json_packet_data, "k", 1);
                        JSON_SetString(json_packet_data, "m", "Этот элемент нельзя купить напрямую.");
                        JSON_SetString(json_packet_data, "n", "Выберите конкретный товар в магазине.");
                        OnPacketIncoming(playerid, 22, json_packet_data);
                        JSON_Cleanup(json_packet_data);
                        return 1;
                    }
                    if(!JSON_GetInt(json, "l", donate_vehicle_color))
                    {
                        JSON_GetInt(json, "c", donate_vehicle_color);
                    }
                    if(donate_vehicle_color < 0 || donate_vehicle_color > 255) donate_vehicle_color = 0;

                    printf("[DONATE] player=%d internal=%d type=%d price=%d client_price=%d game=%d", playerid, internal_id, donate_item_type, price, client_price, donate_game_id);

                    new bool:purchase_with_money = (donate_rubles == 1);

                    new result = purchase_with_money ? (GetPlayerMoneyEx(playerid) - price) : (GetPlayerDonateRub(playerid) - price);
                    printf("[DEBUG] IPacket:252 - playerid: %d, money: %d, DonateRub: %d, price: %d, result: %d, money_mode: %d", playerid, GetPlayerMoneyEx(playerid), GetPlayerDonateRub(playerid), price, result, purchase_with_money);

                    new result_json[256];
                    JSON_Stringify(json, result_json);
                    printf("[DEBUG] IPacket:252 - JSON data: %s", result_json);

                    if ((purchase_with_money && GetPlayerMoneyEx(playerid) < price) || (!purchase_with_money && GetPlayerDonateRub(playerid) < price))
                    {
                        JSON_SetInt(json_packet_data, "t", 0);
                        JSON_SetInt(json_packet_data, "y", 0);
                        JSON_SetInt(json_packet_data, "k", 1);

                        JSON_SetString(json_packet_data, "m", "Недостаточно средств.");
                        JSON_SetString(json_packet_data, "n", "Пополните счет прямо сейчас!");

                        printf("[DEBUG] IPacket:252 - Insufficient funds for playerid: %d, price: %d, money: %d, DonateRub: %d, money_mode: %d", playerid, price, GetPlayerMoneyEx(playerid), GetPlayerDonateRub(playerid), purchase_with_money);

                        OnPacketIncoming(playerid, 22, json_packet_data);

                        JSON_Cleanup(json_packet_data);

                        return 1;
                    }

                    new inv_item_id = -1;
                    new acc_modelid = -1;

                    for (new i = 0; i < sizeof(AccessoryMapping); i++)
                    {
                        if (AccessoryMapping[i][0] == internal_id)
                        {
                            inv_item_id = AccessoryMapping[i][1];
                            acc_modelid = AccessoryMapping[i][2];
                            break;
                        }
                    }

                    if (inv_item_id != -1 && acc_modelid != -1)
                    {
                        new inv_slot = Inventory11_AddItemToDatabase(playerid, inv_item_id, acc_modelid, 1, 0, 0);
                        if (inv_slot == -1)
                        {
                            printf("[ERROR] IPacket:252 - Accessory add failed, playerid: %d, internal_id: %d, inv_item_id: %d, modelid: %d", playerid, internal_id, inv_item_id, acc_modelid);

                            JSON_SetInt(json_packet_data, "t", 0);
                            JSON_SetInt(json_packet_data, "y", 0);
                            JSON_SetInt(json_packet_data, "k", 1);
                            JSON_SetString(json_packet_data, "m", "Error: failed to add accessory.");
                            JSON_SetString(json_packet_data, "n", "Try again or contact support.");

                            OnPacketIncoming(playerid, 22, json_packet_data);
                            JSON_Cleanup(json_packet_data);
                            return 1;
                        }

                        if(purchase_with_money) GivePlayerMoneyEx(playerid, -price, "Покупка в донат-магазине", true, true);
        					else GivePlayerDonateRub(playerid, -price);

                        printf("[DEBUG] IPacket:252 - Buying accessory, playerid: %d, internal_id: %d, inv_item_id: %d, modelid: %d, slot: %d, price: %d, new DonateRub: %d",
                               playerid, internal_id, inv_item_id, acc_modelid, inv_slot, price, GetPlayerDonateRub(playerid));

                        JSON_SetInt(json_packet_data, "t", 0);
                        JSON_SetInt(json_packet_data, "y", 1);
                        JSON_SetInt(json_packet_data, "g", inv_item_id);
                        JSON_SetInt(json_packet_data, "r", GetPlayerMoney(playerid));
                        JSON_SetInt(json_packet_data, "s", GetPlayerDonateRub(playerid));
                        JSON_SetString(json_packet_data, "m", "Успешная операция");
                        JSON_SetString(json_packet_data, "n", "Вы приобрели аксессуар, он находится в /inv");

                        OnPacketIncoming(playerid, 22, json_packet_data);
                        JSON_Cleanup(json_packet_data);
                        return 1;
                    }

                    
                    
