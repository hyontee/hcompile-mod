                    ShowNotificationLaird(playerid, 2, 6, 0, 0, "Подойдите к личному или семейному транспорту", " ");
                }
            }
        }
        return 1;
    }

    if(notify_type == 0 && notify_id == 1)
    {
        new vehicleid = notify_sub_id;
        if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
        {
            vehicleid = GetPlayerVehicleID(playerid);
        }

        if(vehicleid != INVALID_VEHICLE_ID)
        {
            OnPlayerNotificationClick(playerid, 13, notify_id, vehicleid);
        }
        return 1;
    }

    return 1;
}

case 66:
{
    new c;
    if(JSON_GetType(json, "c") == JSON_NODE_NUMBER)
    {
        JSON_GetInt(json, "c", c);
        if(c == 1)
        {
            new ignore_close_until = GetPVarInt(playerid, "sp_gui_ignore_close_until");
            if(ignore_close_until > GetTickCount())
            {
                printf("[SP][GUI] close ignored admin=%d now=%d until=%d", playerid, GetTickCount(), ignore_close_until);
                return 1;
            }

            DeletePVar(playerid, "sp_gui_ignore_close_until");
            StopSpectateGUIRefresh(playerid);
            if(GetPlayerSpectateData(playerid, S_PLAYER) != -1)
            {
                printf("[SP][GUI] close accepted admin=%d target=%d", playerid, GetPlayerSpectateData(playerid, S_PLAYER));
                StopSpectate(playerid);
                Spectate_RestoreSkin(playerid);
                ShowNotificationNew(playerid, 2, 6, 0, 0, "Слежение остановлено.", "qq");
            }
            return 1;
        }
    }

new t;
    JSON_GetInt(json, "t", t);

    
    if(t == 2 && JSON_GetType(json, "bi") == JSON_NODE_NUMBER)
    {
        new tmpl_id;
        JSON_GetInt(json, "bi", tmpl_id);
        new admin_target2 = GetPlayerSpectateData(playerid, S_PLAYER);
        if(admin_target2 != -1 && IsPlayerConnected(admin_target2))
            AT_ApplyPunishTemplate(playerid, admin_target2, tmpl_id);
        return 1;
    }

    
    if(t == 3 && JSON_GetType(json, "b") == JSON_NODE_NUMBER)
    {
        new ans_b;
        JSON_GetInt(json, "b", ans_b);
        if(ans_b == 1)
        {
            AT_SendReportAnswerTemplates(playerid);
            return 1;
        }
    }
    if(t == 4 && JSON_GetType(json, "bi") == JSON_NODE_NUMBER)
    {
        new ans_bi;
        JSON_GetInt(json, "bi", ans_bi);
        AT_HandleReportTemplateReply(playerid, ans_bi);
        return 1;
    }

    if(t >= 1 && t <= 3)
    {
        if(JSON_GetType(json, "b") == JSON_NODE_NUMBER)
        {
            new b;
            JSON_GetInt(json, "b", b);

            if(b == 10)
            {
                new target = GetPlayerSpectateData(playerid, S_PLAYER);
                if(target == -1 || !IsPlayerConnected(target))
                {
                    ShowNotificationNew(playerid, 2, 6, 0, 0, "Слежение не активно", "qq");
                    return 1;
                }
                ShowPlayerStats(playerid, target);
                return 1;
            }

            if(b == 2 || b == 9)
            {
                new cur = GetPlayerSpectateData(playerid, S_PLAYER);
                if(cur == -1 || !IsPlayerConnected(cur))
                {
                    ShowNotificationNew(playerid, 2, 6, 0, 0, "Слежение не активно", "qq");
                    return 1;
                }

                new dir = (b == 9) ? 1 : -1;

                new count = 0;
                for(new i = 0; i < MAX_PLAYERS; i++)
                {
                    if(Spectate_CanWatchPlayer(playerid, i)) count++;
                }

                if(count <= 1)
                {
                    ShowNotificationNew(playerid, 2, 6, 0, 0, "Нет других игроков на сервере", "qq");
                    ShowSpectateGUI(playerid, cur);
                    return 1;
                }

                new next = GetNextPlayer(playerid, cur, dir);
                if(next == INVALID_PLAYER_ID || !Spectate_CanWatchPlayer(playerid, next))
                {
                    ShowNotificationNew(playerid, 2, 6, 0, 0, "Нет других игроков на сервере", "qq");
                    ShowSpectateGUI(playerid, cur);
                    return 1;
                }

                StartSpectate(playerid, next);
                StartSpectateGUIRefresh(playerid);

                Spectate_HideSkin(playerid);

                ShowSpectateGUI(playerid, next);

                new msg[96];
                format(msg, sizeof msg, "Теперь вы следите за %s[%d]", GetPlayerNameEx(next), next);
                ShowNotificationNew(playerid, 2, 6, 0, 0, msg, "qq");

                return 1;
            }

            
            new admin_target = GetPlayerSpectateData(playerid, S_PLAYER);
            if(admin_target != -1 && IsPlayerConnected(admin_target))
            {
                switch(b)
                {
                    
                    
                    
                    case GUI66_BTN_KICK, GUI66_BTN_MUTE, GUI66_BTN_JAIL, GUI66_BTN_WARN, GUI66_BTN_SLAP, GUI66_BTN_BAN:
                        return AT_SendPunishTemplates(playerid, b);
                }
            }

            return 1;
        }

        return 1;
    }

    return 1;
}

