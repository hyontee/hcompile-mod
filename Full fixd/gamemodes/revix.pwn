		if (i == 535 || i == 536 || i == 692 || i == 691 || i == 697 || i == 713 || i == 532 || i == 533)
        {
            gFlatPrice[i] = 1500000;
            gFlatType[i] = 4;
            gFlatFloors[i] = 2;
            gFlatEnTypes[i] = 0;
        }

        if (x > 303.779601 && x < 673.416601 &&
            y > 411.309478 && y < 725.309478)
        {
            gFlatPrice[i] = 500000;
            gFlatType[i] = 2;
            gFlatFloors[i] = 6;
            gFlatEnTypes[i] = 1;
        }

        if (x > 335.579601 && x < 650.086601 &&
            y > 769.031478 && y < 1082.059478)
        {
            gFlatPrice[i] = 500000;
            gFlatType[i] = 2;
            gFlatFloors[i] = 6;
            gFlatEnTypes[i] = 1;
        }

        if (x > 470.579601 && x < 973.686601 &&
            y > 1214.521478 && y < 1343.259478)
        {
            gFlatPrice[i] = 500000;
            gFlatType[i] = 2;
            gFlatFloors[i] = 6;
            gFlatEnTypes[i] = 1;
        }

        if (gFlatEnTypes[i] == 1)
        {
            CreateDynamicActionPickup(
                19134,
                23,
                -501.77,
                1002.99,
                1499.17,
                i,
                PICKUP_ACTION_TYPE_HOUSE_LIFT,
                i
            );
			

            CreateDynamicActionPickup(
                1318,
                23,
                -500.83,
                999.07,
                1499.17,
                i,
                PICKUP_ACTION_TYPE_FLAT_EXIT,
                i
            );
        }

        if (gFlatEnTypes[i] == 2)
        {
            CreateDynamicActionPickup(
                1318,
                23,
                -507.33,
                488.08,
                1501.04,
                i,
                PICKUP_ACTION_TYPE_FLAT_EXIT,
                i
            );
        }

        format(fmt, sizeof fmt, "{ffe135}« Вход в подъезд »\n| {ffffff}Номер подъезда: {ffe135}%d\n| {ffffff}Количество этажей: {ffe135}%d", i + 100, gFlatFloors[i]);
        CreateDynamic3DTextLabel(fmt, 0xffe135FF, x, y, gFlatsForSale[i][2] + 0.8, 8.0);

        gFlatSalePickup[i] = CreateDynamicActionPickup(
            1273,
            PICKUP_TYPE_DEFAULT,
            x,
            y,
            gFlatsForSale[i][2],
            0,
            PICKUP_ACTION_TYPE_HOUSE_NEWS,
            i
        );

        if (gFlatEnTypes[i] == 0)
        {
            CreateDynamicActionPickup(
                19134,
                23,
                560.64,
                23.05,
                1049.36,
                i,
                PICKUP_ACTION_TYPE_HOUSE_LIFT,
                i
            );

            CreateDynamicActionPickup(
                1318,
                23,
                558.33,
                22.61,
                1049.30,
                i,
                PICKUP_ACTION_TYPE_FLAT_EXIT,
                i
            );
        }

        for (new v = 1; v <= gFlatFloors[i]; v++)
        {
            new worldids = i + ((v - 1) * (FLATS_FOR_SALE_COUNT + 1));

            if (gFlatEnTypes[i] == 0)
            {
                CreateDynamicActionPickup(
                    19134,
                    23,
                    560.64,
                    23.05,
                    1049.36,
                    worldids,
                    PICKUP_ACTION_TYPE_HOUSE_LIFT,
                    i
                );

                if (v != 1)
                {
                    new fmtl[2048];
                    format(fmtl, sizeof fmtl, "{ffff00}Этаж: №%d", v);

                    CreateDynamic3DTextLabel(
                        fmtl,
                        0xffff00FF,
                        558.33,
                        22.61,
                        1049.30 + 1,
                        10.0,
                        INVALID_PLAYER_ID,
                        INVALID_VEHICLE_ID,
                        1,
                        worldids,
                        1
                    );
                }else{
					CreateDynamic3DTextLabel(
                        "{ffff00}Этаж: №1",
                        0xffff00FF,
                        558.33,
                        22.61,
                        1049.30 + 1,
                        10.0,
                        INVALID_PLAYER_ID,
                        INVALID_VEHICLE_ID,
                        1,
                        worldids,
                        1
                    );
				}

                CreateDynamicActionPickup(
                    1318,
                    23,
                    558.33,
                    22.61,
                    1049.30,
                    worldids,
                    PICKUP_ACTION_TYPE_FLAT_EXIT,
                    i
                );

				new Float:flatPos[4][3] =
                {
                    {552.79, 25.45, 1049.31},
                    {554.67, 26.63, 1049.31},
                    {565.18, 26.63, 1049.31},
                    {567.20, 25.33, 1049.31}
                };

                for (new k = 0; k < 4; k++)
                {
                    new flat_number = ((v - 1) * 4) + (k + 1);
                    new subid = i * 1000 + v * 10 + (k + 1);

                    CreateDynamicActionPickup(
                        19198,
                        23,
                        flatPos[k][0],
                        flatPos[k][1],
                        flatPos[k][2],
                        worldids,
                        PICKUP_ACTION_TYPE_FLAT_ENTER,
                        subid
                    );

                    new flat_label[144];
                    format(
                        flat_label,
                        sizeof flat_label,
                        "{ffff00}« Квартира »\n| {ffffff}Номер квартиры{ffff00}: %d",
                        flat_number
                    );

                    CreateDynamic3DTextLabel(
                        flat_label,
                        0xFFFFFFFF,
                        flatPos[k][0],
                        flatPos[k][1],
                        flatPos[k][2] + 1.3,
                        6.0,
                        INVALID_PLAYER_ID,
                        INVALID_VEHICLE_ID,
                        1,
                        worldids,
                        1
                    );
                }
            }

			if (gFlatEnTypes[i] == 1)
            {
                CreateDynamicActionPickup(
                    19134,
                    23,
                    -493.166503, 1005.966674, 1499.172851,
                    worldids,
                    PICKUP_ACTION_TYPE_HOUSE_LIFT,
                    i
                );

				new Float:flatPos[4][3] =
                {
                    {-491.66, 1004.88, 1499.17},
                    {-491.95, 998.40, 1499.17},
                    {-494.54, 995.28, 1499.17},
                    {-494.45, 1001.47, 1499.17}
                };

                for (new k = 0; k < 4; k++)
                {
                    new flat_number = ((v - 2) * 4) + (k + 1);
                    new subid = i * 1000 + v * 10 + (k + 1);

                    CreateDynamicActionPickup(
                        19198,
                        23,
                        flatPos[k][0],
                        flatPos[k][1],
                        flatPos[k][2],
                        worldids,
                        PICKUP_ACTION_TYPE_FLAT_ENTER,
                        subid
                    );

                    new flat_label[144];
                    format(
                        flat_label,
                        sizeof flat_label,
                        "{ffff00}« Квартира »\n| {ffffff}Номер квартиры{ffff00}: %d",
                        flat_number
                    );

                    CreateDynamic3DTextLabel(
                        flat_label,
                        0xFFFFFFFF,
                        flatPos[k][0],
                        flatPos[k][1],
                        flatPos[k][2] + 1.3,
                        6.0,
                        INVALID_PLAYER_ID,
                        INVALID_VEHICLE_ID,
                        1,
                        worldids,
                        1
                    );
                }
            }
        }
    }
    return 1;
}
stock GetHouseNewByOwner(accountsid, playerid)
{
    new selected = GetPlayerData(playerid, P_HOUSE_SELECTED);

    new count = 0;

    for(new i = 0; i < HOUSES_FOR_SALE_COUNT; i++)
    {
        if(!gHouseOwned[i]) continue;
        if(gHouseOwnerID[i] != accountsid) continue;

        if(count == selected)
            return i;

        count++;
    }

    return -1;
}
stock GetFlatNewByOwner(accountsid, playerid)
{
    new selected = GetPlayerData(playerid, P_HOUSE_SELECTED);
    new houses_count = 0;
    new flats_need_index;

    for(new i = 0; i < HOUSES_FOR_SALE_COUNT; i++)
    {
        if(!gHouseOwned[i]) continue;
        if(gHouseOwnerID[i] != accountsid) continue;
        houses_count++;
    }

    flats_need_index = selected - houses_count;

    if(flats_need_index < 0)
        return -1;

    new count = 0;

    for(new i = 0; i < 200000; i++)
    {
        if(!gFlatOwned[i]) continue;
        if(gFlatOwnerID[i] != accountsid) continue;

        if(count == flats_need_index)
            return i;

        count++;
    }

    return -1;
}

stock FamilySpawnEncodeNewHouse(houseid)
{
	return -(houseid + 2);
}

stock bool:FamilySpawnIsNewHouse(value)
{
	return value <= -2;
}

stock FamilySpawnDecodeNewHouse(value)
{
	return -value - 2;
}

stock ApplyDefaultSpawnSelection(playerid)
{
	new Float:case_1_spawns[][4] =
	{
		{846.602600, 796.555847, 13.400512, 69.896881},
		{2740.712158, -2441.565185, 21.774286, 269.248382},
		{-2429.236083, 203.175277, 26.096101, 176.712112},
		{1801.694091, 2523.137695, 14.602633, 109.981643},
		{-2667.526611, 2006.567016, 11.197804, 176.496978},
		{-2159.371093, 1558.103271, 9.840852, 84.519485}
	};
	new spawn_index = random(sizeof(case_1_spawns));

	SetPlayerSpawnSetting(playerid, 0);
	UpdatePlayerDatabaseInt(playerid, "setting_spawn", 0);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SetSpawnInfo(
		playerid,
		0,
		GetPlayerSkinEx(playerid),
		case_1_spawns[spawn_index][0],
