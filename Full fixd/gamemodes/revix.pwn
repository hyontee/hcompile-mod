        JSON_GetString(json, "nt", nt, sizeof(nt));
        JSON_SetInt(response, "t", 1);
        JSON_SetInt(response, "s", 1);
    }
					else if (type == 4)
    {
        JSON_GetInt(json, "ga", item_id);
        JSON_GetInt(json, "os", old_pos);
        JSON_GetInt(json, "s", pos);
        printf("[INV11] type=4 move request V3: player=%d ga=%d client_os=%d client_s=%d", playerid, item_id, old_pos, pos);

        if(item_id == 134 && old_pos == 6 && !InventoryV3_HasRegularItemAtClientSlot(playerid, old_pos, item_id))
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Нельзя снять одежду", " ");
            JSON_SetInt(response, "t", 4);
            JSON_SetInt(response, "s", 0);
            printf("[INV11] type=4 blocked: player=%d ga=%d reason=no_takeoff_active_slot", playerid, item_id);
        }
					else
        {
            new bool:db_ok = false;
            new active_model = 0;
            new bool:regular_source = InventoryV3_HasRegularItemAtClientSlot(playerid, old_pos, item_id);
            new bool:is_active_acc_move = (!regular_source && Inventory11_IsActiveAccessorySlot(playerid, old_pos, item_id));
            new db_target = InventoryV3_ClientToDbSlot(pos);

            if(is_active_acc_move)
            {
                db_ok = Inventory11_MoveActiveAccessoryToInventorySlot(playerid, item_id, old_pos, db_target, active_model);
                if(db_ok)
                {
                    Inventory11_SetAiArrayOnJson(playerid, response);
                    refresh_inventory_after_response = 1;
                    printf("[INV11] type=4 accessory moved active->inventory: player=%d item=%d active_slot=%d inv_slot=%d model=%d", playerid, item_id, old_pos, pos, active_model);
                }
            }
					else
            {
                new db_source = InventoryV3_ClientToDbSlot(old_pos);
                if(db_source != -1 && db_target != -1)
                {
                    db_ok = Inventory11_SwapSlotsInDatabase(playerid, db_source, db_target);
                }
            }

            JSON_SetInt(response, "t", 4);
            JSON_SetInt(response, "s", db_ok ? 1 : 0);
            JSON_SetInt(response, "nw", 200);
            JSON_SetInt(response, "ns", 20);
            printf("[INV11] type=4 result: player=%d ga=%d os=%d s=%d db_ok=%d", playerid, item_id, old_pos, pos, db_ok);
        }
    }
