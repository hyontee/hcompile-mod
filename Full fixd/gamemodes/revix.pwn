        new bool:takeoff = false;
        new takeoff_model = 0;
        new takeoff_db_slot = 0;

        if(!InventoryV3_HasRegularItemAtClientSlot(playerid, client_pos, item_id) && Inventory11_IsActiveAccessorySlot(playerid, client_pos, item_id))
        {
            takeoff = true;
            db_ok = Inventory11_MoveActiveAccessoryToInventorySlot(playerid, item_id, client_pos, takeoff_db_slot, takeoff_model);
            if(db_ok)
            {
                Inventory11_SetAiArrayOnJson(playerid, response);
                refresh_inventory_after_response = 1;
                ShowNotificationLaird(playerid, 3, 6, 0, 0, "\xc2\xfb \xf1\xed\xff\xeb\xe8 \xe0\xea\xf1\xe5\xf1\xf1\xf3\xe0\xf0", " ");
            }
        }
        else
        {
            pos = InventoryV3_ClientToDbSlot(client_pos);
            db_ok = (pos != -1 && Inventory11_DeleteSlotFromDatabase(playerid, pos));
        }

        if(db_ok && !takeoff)
        {
            new_w -= GetItemWeight(item_id);
