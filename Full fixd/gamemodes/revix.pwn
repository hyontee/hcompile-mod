stock bool:FamilyParseStoredPlateValue(stored[], &plate_type, plate[], plate_size, region[], region_size)
{
    if(plate_size > 0) plate[0] = '\0';
    if(region_size > 0) region[0] = '\0';
    plate_type = TYPE_RU;

    new len = strlen(stored), split = -1;
    if(!len) return false;

    for(new i; i < len; i++)
    {
        if(stored[i] == '|' || stored[i] == ';' || stored[i] == ',')
        {
            split = i;
            break;
        }
    }

    if(split == -1)
    {
        format(plate, plate_size, "%s", stored);
        return true;
    }

    new pos;
    for(new i; i < split && pos < plate_size - 1; i++) plate[pos++] = stored[i];
    plate[pos] = '\0';

    pos = 0;
    for(new i = split + 1; i < len && pos < region_size - 1; i++) region[pos++] = stored[i];
    region[pos] = '\0';
    return strlen(plate) > 0;
}

stock FamilyBuildStoredPlateValue(plate_type, plate[], region[], dest[], size)
{
    #pragma unused plate_type
    if(strlen(region)) format(dest, size, "%s|%s", plate, region);
    else format(dest, size, "%s", plate);
    return 1;
}

stock FamilyEnsureColumn(const table_name[], const column_name[], const definition[])
{
    new query[512];
    format(query, sizeof query, "SHOW COLUMNS FROM `%s` LIKE '%s'", table_name, column_name);
    new Cache:result = mysql_query(mysql, query, true);
    new error_code = mysql_errno();
    if(error_code)
    {
        cache_delete(result);
        printf("[DONOR FAMILY DB][COLUMN CHECK ERROR] table=%s column=%s errno=%d", table_name, column_name, error_code);
        return 0;
    }

    new exists = cache_num_rows();
    cache_delete(result);
    if(exists) return 1;

    format(query, sizeof query, "ALTER TABLE `%s` ADD `%s` %s", table_name, column_name, definition);
    mysql_query(mysql, query, false);
    error_code = mysql_errno();
    if(error_code)
    {
        printf("[DONOR FAMILY DB][COLUMN CREATE ERROR] table=%s column=%s errno=%d query=%s", table_name, column_name, error_code, query);
        return 0;
    }
    return 1;
}

stock EnsureBoughtHousesTable()
{
    mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS `bought_houses` ("\
        "`id` INT NOT NULL AUTO_INCREMENT,"\
        "`house_id` INT NOT NULL DEFAULT '0',"\
        "`account_id` INT NOT NULL DEFAULT '0',"\
        "`owner_name` VARCHAR(24) NOT NULL DEFAULT '',"\
        "`is_open` INT NOT NULL DEFAULT '0',"\
        "`remont` INT NOT NULL DEFAULT '0',"\
        "`apt` INT NOT NULL DEFAULT '0',"\
        "`shkaf` INT NOT NULL DEFAULT '0',"\
        "`kv` INT NOT NULL DEFAULT '0',"\
        "`rent_time` INT NOT NULL DEFAULT '0',"\
        "PRIMARY KEY (`id`), KEY `idx_bought_houses_house` (`house_id`), KEY `idx_bought_houses_account` (`account_id`)"\
        ") ENGINE=InnoDB DEFAULT CHARSET=cp1251",
        false
    );
    if(mysql_errno()) printf("[HOUSES DB][TABLE ERROR] bought_houses errno=%d", mysql_errno());

    FamilyEnsureColumn("bought_houses", "house_id", "INT NOT NULL DEFAULT '0'");
    FamilyEnsureColumn("bought_houses", "account_id", "INT NOT NULL DEFAULT '0'");
    FamilyEnsureColumn("bought_houses", "owner_name", "VARCHAR(24) NOT NULL DEFAULT ''");
    FamilyEnsureColumn("bought_houses", "is_open", "INT NOT NULL DEFAULT '0'");
    FamilyEnsureColumn("bought_houses", "remont", "INT NOT NULL DEFAULT '0'");
    FamilyEnsureColumn("bought_houses", "apt", "INT NOT NULL DEFAULT '0'");
    FamilyEnsureColumn("bought_houses", "shkaf", "INT NOT NULL DEFAULT '0'");
    FamilyEnsureColumn("bought_houses", "kv", "INT NOT NULL DEFAULT '0'");
    FamilyEnsureColumn("bought_houses", "rent_time", "INT NOT NULL DEFAULT '0'");
    return 1;
}

