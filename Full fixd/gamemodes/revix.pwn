stock ApplyOrgVinylToVehicle(vehicleid, org_index, slot)
{
    if(vehicleid == INVALID_VEHICLE_ID) return 0;
    if(org_index < 0 || org_index >= sizeof(g_org_car)) return 0;
    if(slot < 0 || slot > 3) return 0;

    new vinyl_name[32];
    vinyl_name[0] = '\0';

    switch(slot)
    {
        case 0: format(vinyl_name, sizeof(vinyl_name), "%s", g_org_car[org_index][O_VINYL1]);
        case 1: format(vinyl_name, sizeof(vinyl_name), "%s", g_org_car[org_index][O_VINYL2]);
        case 2: format(vinyl_name, sizeof(vinyl_name), "%s", g_org_car[org_index][O_VINYL3]);
        case 3: format(vinyl_name, sizeof(vinyl_name), "%s", g_org_car[org_index][O_VINYL4]);
    }

    
    
    
    
    format(vInfo[vehicleid][vVinylTexture], 16, "%s", vinyl_name);
    format(vInfo[vehicleid][vynil_name], 32, "%s", vinyl_name);
    vInfo[vehicleid][vVinyl] = (vinyl_name[0] != '\0');

    if(vinyl_name[0] == '\0') return 1;

    
    foreach(new playerid : streamed_players_in_veh[vehicleid])
    {
        if(IsPlayerConnected(playerid))
            SetVehicleVinylForPlayer(playerid, vehicleid, vinyl_name);
    }

    return 1;
}


stock OrgFleet_ShowPickupMenu(playerid, action_id)
{
    if(action_id < 0 || action_id >= sizeof(g_org_car)) return 0;
    if(GetPlayerData(playerid, P_TEAM) != g_org_car[action_id][O_FRAC_ID]) return 0;

    if(GetPlayerData(playerid, P_FRACTION_CAR) != INVALID_VEHICLE_ID)
    {
        new fraction_vehicleid = GetPlayerData(playerid, P_FRACTION_CAR);
        if(!IsValidVehicle(fraction_vehicleid) ||
            GetVehicleData(fraction_vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_ORG_CAR ||
            GetVehicleData(fraction_vehicleid, V_ACTION_OWNER) != playerid)
        {
            SetPlayerData(playerid, P_FRACTION_CAR, INVALID_VEHICLE_ID);
        }
        else
        {
            SendClientMessage(playerid, -1, "\"USC\"\xc2\xfb \xf3\xb6\xe5 \xe2\xe7\xff\xeb\xe8 \xf2\xf0\xe0\xed\xf1\xef\xee\xf0\xf2, \xe4\xeb\xff \xee\xf2\xec\xe5\xed\xfb \xef\xf0\xee\xf8\xeb\xee\xe3\xee \xf2\xf0\xe0\xed\xf1\xef\xee\xf0\xf2\xe0 \xe2\xe2\xe5\xf1\xf2\xe8 {FFFF00}/unfcar");
            return 1;
        }
    }

    new m1 = _:g_org_car[action_id][O_MODEL][0];
    new m2 = _:g_org_car[action_id][O_MODEL][1];
    new m3 = _:g_org_car[action_id][O_MODEL][2];
    new m4 = _:g_org_car[action_id][O_MODEL][3];

    new n1[64], n2[64], n3[64], n4[64];
    GetVehicleModelName(m1, n1, sizeof(n1));
    GetVehicleModelName(m2, n2, sizeof(n2));
    GetVehicleModelName(m3, n3, sizeof(n3));
    GetVehicleModelName(m4, n4, sizeof(n4));

    new fleet_dialog[1024];
    fleet_dialog[0] = '\0';
    if(m1 > 0) format(fleet_dialog, sizeof(fleet_dialog), "{FFFFFF}[1]\t%s\n", n1);
    if(m2 > 0) format(fleet_dialog, sizeof(fleet_dialog), "%s{FFFFFF}[2]\t%s\n", fleet_dialog, n2);
    if(m3 > 0) format(fleet_dialog, sizeof(fleet_dialog), "%s{FFFFFF}[3]\t%s\n", fleet_dialog, n3);
    if(m4 > 0) format(fleet_dialog, sizeof(fleet_dialog), "%s{FFFFFF}[4]\t%s", fleet_dialog, n4);

    SetPlayerListitemValue(playerid, 0, action_id);
    Dialog(playerid, DIALOG_ORG_CAR_GET, DIALOG_STYLE_LIST, g_org_car[action_id][O_NAME], fleet_dialog, "\xc2\xfb\xe1\xf0\xe0\xf2\xfc", "\xce\xf2\xec\xe5\xed\xe0");
    return 1;
}

