        JSON_Stringify(response, debug_str, sizeof debug_str);
        printf("[FAMILY] ОТВЕТ: %s", debug_str);
        
        OnPacketIncoming(playerid, 45, response);
        
        JSON_Cleanup(carsArray);
        JSON_Cleanup(response);
        
        cache_delete(cache);
        printf("[FAMILY] Ответ отправлен");
    }
