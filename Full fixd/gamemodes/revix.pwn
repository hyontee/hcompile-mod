    // if( GetVehicleModel(GetPlayerVehicleID(playerid)) != 546) return SendClientMessage(playerid,0xFFFFFFFF,"{ff0000}[Ошибка]{ffffff}На эту машину нельзя включить лаунч-контроль!");
