stock IsPlayerInBandOnline(bandid) {
	new count_band_online = 1;
	foreach(new i:Player) {
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		if(PI[i][pMember] == bandid) {
			count_band_online++;
			if(count_band_online >= 3) return true;
		}
	}
	return false;
}


