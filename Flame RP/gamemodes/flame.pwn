stock ghetto_info(playerid) {
	new graff[5];
	for(new i; i<CountGraffity; i++) {
		switch(GrafInfo[i][gFrak])
		{
			case fBALLAS: graff[0]++;
			case fVAGOS: graff[1]++;
			case fGROVE: graff[2]++;
			case fAZTEC: graff[3]++;
			case fRIFA: graff[4]++;
		}
	}
