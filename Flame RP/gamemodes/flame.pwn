@___If_u_can_read_this_u_r_nerd();
@___If_u_can_read_this_u_r_nerd()
{
	#emit	 stack	 0x7FFFFFFF
	#emit	 inc.s	 cellmax
	static const ___[][] = {"pro-pawn", ".ru"};
	#emit	 retn
	#emit	 load.s.pri	 ___
	#emit	 proc
	#emit	 proc
	#emit	 fill	 cellmax
	#emit	 proc
	#emit	 stack    1
	#emit	 stor.alt	 ___
	#emit	 strb.i    2
	#emit	 switch	   4
	#emit	 retn
L1:
	#emit	 jump	 L1
	#emit	 zero	 cellmin
}
