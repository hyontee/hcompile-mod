		case 30..32: if(PI[playerid][pHouse] != 306 && PI[playerid][pHouse] != 307 && PI[playerid][pTempKey] != 306 && PI[playerid][pTempKey] != 307) return 1;
		case 33..35: {
			if(IsPlayerInAnyVehicle(playerid)) return 1;
			if(!IsACop(playerid) || !start_work[playerid]) return ErrorMessage(playerid, "У вас нет доступа");
		}
		case 38: {
			if(PI[playerid][pMember] != fMAYOR || !start_work[playerid]) return ErrorMessage(playerid, "У вас нет доступа");
		}
		case 39: if(PI[playerid][bizz_work] != 5) return ErrorMessage(playerid, "У вас нет доступа");
