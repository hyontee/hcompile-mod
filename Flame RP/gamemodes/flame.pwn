stock showRegisterDialog(playerid)
{

	static const f_str[] = ""G"Добро пожаловать на сервер: "ORANGE"Lights RolePlay"G"\n\
		"G"Регистрация нового аккаунта"G"\n\n\
		Логин: "P"%s"G"\n\
		Введите пароль:\n\n\t\
		"P"Примечание:\n\t\
		"NO"*"G" Пароль должен состоять из русских и латинских символов\n\t\
		"NO"*"G" Пароль должен содержать от 6 до 20 символов\n\t\
		"NO"*"G" Пароль чувствителен к регистру";

	new string[sizeof(f_str) +1 + MAX_PLAYER_NAME];
	format(string,sizeof(string),f_str,player_name[playerid]);

	return D(playerid,D_REG,DSI, ""P"Регистрация",string, "Далее", "Отмена");
}
stock showRegisterEmailDialog(playerid) {
	return D(playerid,D_REG_MAIL,DSI, ""P"Регистрация",""G"Укажите Вашу "ORANGE"почту"G"\n\n\
	Укажите ваш реальный "P"E-mail адрес"G"\nИспользуя его в дальнейшем вы сможете восстановить доступ к аккаунту в случае взлома\nили если забудите данные для входа","Далее","Пропуск");
}
