CMD:gettick(playerid) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new s[64];
	format(s, 64, "GetTickCount: %d", GetTickCount());
	SCM(playerid, -1, s);

	format(s, 64, "Текущая частота тиков сервера: %d", GetServerTickRate());
	SCM(playerid, -1, s);
	return 1;
}
// Система промокодов
CMD:bpromo(playerid)
{
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return true;

    return D(playerid, D_CREATE_PROMO, DIALOG_STYLE_INPUT, !""P"Создание промокода", !""W"Вам необходимо придумать промокод\nДлина промокода должна быть от 4 до 32 символов, состоящая из цифр и букв латинского алфавита\n\nВведите промокод в строчку ниже:", !"Далее", !"Закрыть");
}
CMD:promolist(playerid)
{
    new query[107];
    format(query, sizeof(query), "SELECT promo_name,promo_hour FROM promocode_activation WHERE account_id='%d' AND promo_accept='0'", PI[playerid][pID]);
    new Cache:result = mysql_query(connects, query);

    new rows = cache_num_rows();
    if(!rows) return ErrorMessage(playerid, "У Вас нет активированных промокодов.");

    string_1024[0] = EOS;
	new string[64];
    for(new i; i < rows; i++)
    {
        new promo_name[33], promo_hour;
        cache_get_value_name(i, "promo_name", promo_name);
        cache_get_value_name_int(i, "promo_hour", promo_hour);

        format(string, sizeof(string), "%s\t"O"%s\n", promo_name, ConvertsCmdTime(promo_hour));
        strcat(string_1024, string);
    }
    D(playerid, DIALOG_NONE, DIALOG_STYLE_TABLIST, !""P"Список промокодов", string_1024, !"Закрыть", !"");

    cache_delete(result);
    return 1;
}
stock show_create_promocode(playerid)
{
	new string[244];

    string_1024[0] = EOS;
    format(string, sizeof(string), "Тип промокода\t%s\n", (promo_params[0]) ? (""G"Обычный") : (""O"YouTube"));
    strcat(string_1024, string);
    format(string, sizeof(string), "Количество часов\t%d\n", promo_params[1]);
    strcat(string_1024, string);
    format(string, sizeof(string), "Количество активаций\t%d\n", promo_params[2]);
    strcat(string_1024, string);
    strcat(string_1024, "\t \n");
    format(string, sizeof(string), ""P"*"W" Игровая валюта\t"GREEN"%d$\n", promo_params[3]);
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" EXP\t%d\n", promo_params[4]);
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" Водительские права\t%s\n", (promo_params[5]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" Лицензия на воздушный транспорт\t%s\n", (promo_params[6]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" Лицензия на водный транспорт\t%s\n", (promo_params[7]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" Лицензия на ношение оружия\t%s\n", (promo_params[8]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" Silenced Pistol\t%s\n", (promo_params[9]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" Desert Eagle\t%s\n", (promo_params[10]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" Shotgun\t%s\n", (promo_params[11]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" MP5\t%s\n", (promo_params[12]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" AK-47\t%s\n", (promo_params[13]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    format(string, sizeof(string), ""P"*"W" M4\t%s\n", (promo_params[14]) ? ( ""GREEN"Да") : (""NO"Нет"));
    strcat(string_1024, string);
    strcat(string_1024, ""GREEN"Создать промокод");
	
    return D(playerid, D_CREATE_PROMO_SETTINGS, DIALOG_STYLE_TABLIST, !""P"Создание промокода", string_1024, !"Далее", !"Закрыть");
}
callback: create_server_promocode(playerid, const code[])
{
    new rows;
    cache_get_row_count(rows);
    if (rows) return ErrorMessage(playerid, "Данный промокод уже существует.");

    string_1024[0] = EOS;
    mysql_format(connects, string_1024, sizeof(string_1024), "INSERT INTO server_promocode (s_promo,s_type,s_hour,s_activation,s_money,s_exp,s_lic_car,s_lic_fly,s_lic_boat,s_lic_gun,s_pistol,s_deagle,s_shotgun,s_mp5,s_ak47,s_m4) VALUES ('%e','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d','%d')", code, promo_params[0], promo_params[1] * 3600, promo_params[2], promo_params[3], promo_params[4], promo_params[5], promo_params[6], promo_params[7], promo_params[8], (promo_params[9]) ? (100) : (0), (promo_params[10]) ? (100) : (0), (promo_params[11]) ? (100) : (0), (promo_params[12]) ? (100) : (0), (promo_params[13]) ? (100) : (0), (promo_params[14]) ? (100) : (0));
    mysql_tquery(connects, string_1024);

	new string_message[122];
    format(string_message, sizeof(string_message), "Вы создали промокод "P"%s"W". Чтобы получить бонусы нужно отыграть: "O"%d час(-ов)", code, promo_params[1]);
    SendUse(playerid, string_message);

    for(new i; i < 15; i++) promo_params[i] = 0;
    DeletePVar(playerid, "PromoCode");
    return 1;
}
callback: activation_promocode(playerid, const code[])
{
	new rows;
	cache_get_row_count(rows);
	
	if(!rows) return ErrorMessage(playerid, "Данный промокод несуществует.");

	new promo_id, 
		promo_type, 
		promo_hour, 
		promo_activation;

	cache_get_value_name_int(0, "s_id", promo_id);
	cache_get_value_name_int(0, "s_type", promo_type);
	cache_get_value_name_int(0, "s_hour", promo_hour);
	cache_get_value_name_int(0, "s_activation", promo_activation);
	
	if(PI[playerid][pPromoUsed] == 1) return ErrorMessage(playerid, "Вы уже активировали промокод из данной группы.");
	if(promo_type && !promo_activation) return ErrorMessage(playerid, "У данного промокода завершились активации.");

	new query[256];
	mysql_format(connects, query, 130, "SELECT * FROM `promocode_activation` WHERE `account_id`='%d' AND `promo_name`='%e' LIMIT 1", PI[playerid][pID], code);
	new Cache: result = mysql_query(connects, query);

	if(cache_num_rows()) return ErrorMessage(playerid, "Вы уже активировали данный промокод.");

	cache_delete(result);

	mysql_format(connects, query, 145, "INSERT INTO `promocode_activation` (`account_id`,`promo_name`,`promo_hour`) VALUES ('%d','%e','%d')", PI[playerid][pID], code, promo_hour);
	mysql_tquery(connects, query);

	format(query, sizeof(query), "UPDATE `server_promocode` SET `s_activation`=`s_activation`-'1',`s_promo_used`=`s_promo_used`+'1' WHERE `s_id`='%d' LIMIT 1", promo_id);
	mysql_tquery(connects, query);

	if(!promo_type)
	{
		PI[playerid][pPromoUsed] = 1;

		format(query, 61, "UPDATE `accounts` SET `pPromoUsed`='1' WHERE `pID`= '%d'", PI[playerid][pID]);
		mysql_tquery(connects, query);
	}
	
	SendUse(playerid, "Вы успешно активировали промокод. Используйте команду: "O"/promolist");
	return 1;
}
callback: time_promocode(playerid)
{
    new rows;
    cache_get_row_count(rows);

	if(!rows) return 1;

    new promo_name[64], promo_hour, promo_accept;
    for(new i; i < rows; i++)
    {
        cache_get_value_name(i, "promo_name", promo_name);
        cache_get_value_name_int(i, "promo_hour", promo_hour);
        cache_get_value_name_int(i, "promo_accept", promo_accept);

        if(promo_hour != 0 && promo_accept != 1)
        {
            if(promo_hour > 0) promo_hour -= 60;
            else if(promo_hour <= -1) promo_hour = 0;
        }
    }
    new query[136];
    format(query, sizeof(query), "UPDATE promocode_activation SET promo_hour='%d' WHERE promo_name='%s' AND account_id='%d'", promo_hour, promo_name, PI[playerid][pID]);
    mysql_tquery(connects, query);
    return 1;
}
callback: bonus_promocode(playerid)
{
	new rows;
	cache_get_row_count(rows);

    for(new i; i < rows; i++)
    {
		new promo_name[64], promo_hour, promo_accept;
		cache_get_value_name(i, "promo_name", promo_name);
		cache_get_value_name_int(i, "promo_hour", promo_hour);
		cache_get_value_name_int(i, "promo_accept", promo_accept);

		if(promo_hour <= 0 && promo_accept != 1)
		{
		    new query_string[217];
		    format(query_string, sizeof(query_string), "SELECT `s_promo`,`s_money`,`s_exp`,`s_lic_car`,`s_lic_fly`,`s_lic_boat`,`s_lic_gun`,`s_pistol`,`s_deagle`,`s_shotgun`,`s_mp5`,`s_ak47`,`s_m4` FROM `server_promocode` WHERE `s_promo`='%s'", promo_name);
			new Cache: result = mysql_query(connects, query_string);

            new promo_names[64], promo_money, promo_exp, promo_lic[4], promo_gun[6];
			cache_get_value_name(0, "s_promo", promo_names);
	        cache_get_value_name_int(0, "s_money", promo_money);
	        cache_get_value_name_int(0, "s_exp", promo_exp);
	        cache_get_value_name_int(0, "s_lic_car", promo_lic[0]);
	        cache_get_value_name_int(0, "s_lic_fly", promo_lic[1]);
	        cache_get_value_name_int(0, "s_lic_boat", promo_lic[2]);
	        cache_get_value_name_int(0, "s_lic_gun", promo_lic[3]);
	        cache_get_value_name_int(0, "s_pistol", promo_gun[0]);
	        cache_get_value_name_int(0, "s_deagle", promo_gun[1]);
	        cache_get_value_name_int(0, "s_shotgun", promo_gun[2]);
	        cache_get_value_name_int(0, "s_mp5", promo_gun[3]);
	        cache_get_value_name_int(0, "s_ak47", promo_gun[4]);
	        cache_get_value_name_int(0, "s_m4", promo_gun[5]);

	        if(promo_money >= 1) GiveMoney(playerid, promo_money, "промокод");
	        if(promo_exp >= 1) {
				PI[playerid][pExp] += promo_exp;
				DollahScoreUpdate(playerid);
			}

	        if(promo_lic[0] >= 1) lic[playerid][0] = 1;
	        if(promo_lic[1] >= 1) lic[playerid][1] = 1;
	        if(promo_lic[2] >= 1) lic[playerid][2] = 1;
	        if(promo_lic[3] >= 1) lic[playerid][3] = 1;

			UpdateLicenses(playerid);

	        if(promo_gun[0] >= 1) PI[playerid][pGunSkill][0] = promo_gun[0];
	        if(promo_gun[1] >= 1) PI[playerid][pGunSkill][1] = promo_gun[1];
	        if(promo_gun[2] >= 1) PI[playerid][pGunSkill][2] = promo_gun[2];
	        if(promo_gun[3] >= 1) PI[playerid][pGunSkill][3] = promo_gun[3];
	        if(promo_gun[4] >= 1) PI[playerid][pGunSkill][4] = promo_gun[4];
	        if(promo_gun[5] >= 1) PI[playerid][pGunSkill][5] = promo_gun[5];

			string_1024[0] = EOS;
	        format(query_string, 97, ""W"Вы получили бонус за использование промокода: "P"%s\n", promo_names);
			strcat(string_1024, query_string);

			if(promo_money >= 1)
			{
			    format(query_string, 48, ""W"Игровая валюта: "GREEN"%d$\n", promo_money);
				strcat(string_1024, query_string);
			}
			if(promo_exp >= 1)
			{
			    format(query_string, 35, ""W"EXP: "O"%d\n", promo_exp);
				strcat(string_1024, query_string);
			}

			if(promo_lic[0] >= 1) strcat(string_1024, "\n"W"* Водительские права");
			if(promo_lic[1] >= 1) strcat(string_1024, "\n"W"* Лицензия на воздушный транспорт");
			if(promo_lic[2] >= 1) strcat(string_1024, "\n"W"* Лицензия на водный транспорт");
			if(promo_lic[3] >= 1) strcat(string_1024, "\n"W"* Лицензия на ношение оружия\n");

			if(promo_gun[0] >= 1) strcat(string_1024, "\n"W"* Silenced Pistol");
			if(promo_gun[1] >= 1) strcat(string_1024, "\n"W"* Desert Eagle");
			if(promo_gun[2] >= 1) strcat(string_1024, "\n"W"* Shotgun");
			if(promo_gun[3] >= 1) strcat(string_1024, "\n"W"* MP5");
			if(promo_gun[4] >= 1) strcat(string_1024, "\n"W"* AK-47");
			if(promo_gun[5] >= 1) strcat(string_1024, "\n"W"* M4");
			D(playerid, DIALOG_NONE, DIALOG_STYLE_MSGBOX, !""P"Промокод", string_1024, !"Закрыть", !"");

			SetPlayerSkills(playerid);


			format(query_string, 138, "UPDATE `promocode_activation` SET `promo_accept`='1' WHERE `account_id`='%d' AND `promo_name`='%s'", PI[playerid][pID], promo_name);
			mysql_tquery(connects, query_string);
			
			cache_delete(result);
		}
	}
	return 1;
}
