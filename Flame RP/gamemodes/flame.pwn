callback: RemovePlayerAttachedObjectDelay(playerid,slot) {
	RemovePlayerAttachedObject(playerid,slot);
}*/
CMD:zonestatus(playerid) {
	if(PI[playerid][pJob] != 6) return ErrorMessage(playerid, "Вы не работаете косильщиком");
	static const f_str[] =
	    "Территория\t\t\tПрогресс\n\
    	"P"1."W" Пляж Verona Beach\t\t\t"G"[%d / 46]\n\
    	"P"2."W" Правительство\t\t\t"G"[%d / 58]\n\
    	"P"3."W" Больница Лос-Сантос\t\t\t"G"[%d / 37]\n\
    	"P"4."W" Glenn парк №1\t\t\t"G"[%d / 95]\n\
    	"P"5."W" Glenn парк №2\t\t\t"G"[%d / 80]";
    new string[sizeof(f_str)];
    format(string, sizeof(string), f_str, check_verona_beach, check_white_house, check_medic_ls, check_glenpark_1,check_glenpark_2);
    D(playerid, D_JOB_GAZON_2, DSTH, ""P"Зоны для скашивания", string, "Выбрать","Закрыть");
    return 1;

}
