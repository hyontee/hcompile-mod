stock CheckBarrier(playerid,barrierid) {
	switch(barrierid) {
	    case 0: if(!IsPlayerInAnyVehicle(playerid)) return 1;
	    case 1..3: {
	        if(IsPlayerInAnyVehicle(playerid)) return 1;
	    }
		case 4: if(!IsAArm(playerid)) return ErrorMessage(playerid, "У вас нет доступа"); // [lva] ворота lva ворота
		case 17..19,21,22,41..43,44..49: {
			if(!IsACop(playerid)) return ErrorMessage(playerid, "У вас нет доступа");
		}
		case 20: {
			if(!IsPlayerInAnyVehicle(playerid)) return 1;
			if(!IsACop(playerid) || !start_work[playerid]) return ErrorMessage(playerid, "У вас нет доступа");
		}
		case 23: if(PI[playerid][bizz_work] != 7) return ErrorMessage(playerid, "У вас нет доступа");
		case 24: if(!IsAArm(playerid) || !start_work[playerid] || PI[playerid][pRank] < 7) return ErrorMessage(playerid, "У вас нет доступа");
		case 25: if(PI[playerid][bizz_work] != 2)  return ErrorMessage(playerid, "У вас нет доступа");
