CMD:quest(playerid) {
	if(car_autoschool[playerid] != INVALID_VEHICLE_ID) return ErrorMessage(playerid,"Запрещено во время экзамена");
	new num;
	string_1024[0] = EOS;
	string_1024 = ""P"Задание\t"P"Прогресс\n";
	for(new i;i<MAX_QUESTS;i++) {
		if(AcceptQuest[playerid][i]!=0 && QuestProgress[playerid][i]!=100) {
		    if(QuestProgress[playerid][i]<QI[i][LastProgress]) format(string_1024,sizeof(string_1024),"%s"W"%s\t"ORANGE"%d/%d\n",string_1024,QI[i][QuestName],QuestProgress[playerid][i],QI[i][LastProgress]);
		    else if(QuestProgress[playerid][i]==100) format(string_1024,sizeof(string_1024),"%s"W"%s\t"NO"Выполнено\n",string_1024,QI[i][QuestName]);
		    else format(string_1024,sizeof(string_1024),"%s"W"%s\t"GREEN"Можно завершить\n",string_1024,QI[i][QuestName]);
			QuestShow[playerid][num]=i;
			num++;
		}
	}
	if(num) D(playerid,D_QUEST_2,DSTH,"Квест",string_1024,"Выбрать","Отмена");
	else ErrorMessage(playerid,"Активных квестовых линий не найдено");
	return 1;
}
