    cache_get_value_name(0, "pVictim",PI[playerid][pVictim],MAX_PLAYER_NAME);

	cache_get_value_name(0,	"licenses",lic[playerid], 64);
	sscanf(lic[playerid], "p<,>a<i>[4]", lic[playerid]);

	cache_get_value_name(0,	"Settings" ,date_, sizeof date_);
	sscanf(date_,	"p<|>a<i>[11]",	PI[playerid][pSettings]);

	cache_get_value_name(0,	"pSlotItem", date_, sizeof date_);
	sscanf(date_, "p<|>a<i>[8]", PI[playerid][pSlotItem]);

	cache_get_value_name(0,	"pSlotItem_Use", date_, sizeof date_);
