CMD:changesex(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new giveplayerid;
	if(sscanf(params, "ud",playerid, giveplayerid)) return SendEsp(playerid, "/changesex [id] [1 или 2(1-м, 2-ж)]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid,not_id);
	PI[giveplayerid][pSex] = !PI[giveplayerid][pSex];

	FreezePlayerForTime(playerid,2);

	switch(PI[giveplayerid][pSex])
	{
		case 1: PI[giveplayerid][pSkin] = skin_register[0][random(8)];
		default: PI[giveplayerid][pSkin] = skin_register[1][random(6)];
	}
	A_SetPlayerSkin(playerid,PI[giveplayerid][pSkin]);

	SCM(playerid, -1, "Вы успешно сменили пол");
	return SCM(giveplayerid, -1, "Вам успешно поменяли пол");
}
