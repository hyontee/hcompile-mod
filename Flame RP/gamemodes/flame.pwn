GetLoadPlayerDate(playerid) {
	new 
		query_[128]; 

	format(query_, sizeof query_,"SELECT * FROM `"TABLE_CARS"` WHERE BINARY `owner` = '%s'",player_name[playerid]);
	mysql_tquery(connects, query_,"load_cars","i",playerid);

	format(query_,sizeof query_,"SELECT * FROM `bank` WHERE BINARY `owner` = '%s'", player_name[playerid]);
	mysql_tquery(connects, query_, "check_bank", "i", playerid);

	format(query_, sizeof query_,"SELECT * FROM online_player WHERE date >= CURDATE() AND accountid = %d", PI[playerid][pID]);
	mysql_tquery(connects, query_, "load_online_today" , "i", playerid);

	format(query_, sizeof query_,"SELECT * FROM online_player WHERE (date >= (CURDATE()-1) AND date < CURDATE()) AND accountid = %d", PI[playerid][pID]);
	mysql_tquery(connects, query_, "load_online_yesterday" , "i", playerid);

	format(query_, sizeof query_, "SELECT * FROM `questsprogress` WHERE BINARY `name` = '%s' ORDER BY `idquest`;", player_name[playerid]);
	mysql_tquery(connects, query_, "LoadQuestMysql", "d", playerid);

	format(query_, sizeof query_, "SELECT * FROM `fraction_bl` WHERE BINARY `f_bl_accused` = '%s'", player_name[playerid]);
	mysql_pquery(connects, query_, "bl_loading_callback", "i", playerid); 

	format(query_, sizeof query_, "UPDATE `"TABLE_ACCOUNTS"` SET `online_status` = '%d' WHERE pID = '%d'",playerid,PI[playerid][pID]);
 	mysql_tquery(connects, query_, "", "");
}
