alias:makeadmin("setadmin");
CMD:makeadmin(playerid, params[]) {
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return true;
	new Name[30],Level;
	if(sscanf(params, "s[30]d",Name,Level)) return SendEsp(playerid, "/makeadmin [id / ник] [уровень]");
	if(!(0 <= Level <= 6)) return ErrorMessage(playerid, "От 0 до 6");
	if(!strcmp(Name,"_") || FD(Name)) {
		SendClientMessage(playerid,COLOR_REDD,"Изменить уровень админ-прав основателю нельзя");
		return 1;
	}
	new query[128];
	if(IsNumber(Name)) {
		new id_name = strval(Name);
		if(!IsPlayerConnected(id_name)) return ErrorMessage(playerid, not_id);

		if(!strcmp(player_name[id_name],"_") || FD(player_name[id_name])) {
			SendClientMessage(playerid,COLOR_REDD,"Наивный)");
			return 1;
		}
		format(query, sizeof(query), "SELECT * FROM `admin` WHERE `name` = '%s' LIMIT 1", player_name[id_name]);
		mysql_pquery(connects, query, "Moderator", "dsd",playerid,player_name[id_name],Level);
		return 1;
	}
	mysql_format(connects, query, sizeof(query), "SELECT * FROM `admin` WHERE `name` = '%e' LIMIT 1", Name);
	mysql_pquery(connects, query, "Moderator", "dsd",playerid,Name,Level);
	return 1;
}
alias:makehelper("sethelper");
CMD:makehelper(playerid, params[]) {
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return true;
	new Name[30],Level;
	if(sscanf(params, "s[30]d",Name,Level)) return SendEsp(playerid, "/makehelper [id / ник] [1 - назначить | 0 - снять]");
	if(!(0 <= Level <= 1)) return ErrorMessage(playerid, "От 0 до 1");
	new query[128];
	if(IsNumber(Name)) {
		new id_name = strval(Name);
		if(!IsPlayerConnected(id_name)) return ErrorMessage(playerid, not_id);
		if(PI[id_name][pHelper] == Level) return ErrorMessage(playerid,"Игрок уже состоит/не состоит в Хелперах");
		PI[id_name][pHelper] = Level;
		UpdatePlayerData(id_name,"pHelper",Level);
		new str[128];
		format(str,sizeof str,""W"%s "G"успешно добавлен/удален в/из Хелперов",player_name[id_name]);
		SendOk(playerid,str);
		if(Level == 0) TI[id_name][tHelperDuty] = false;
		return 1;
	}
	mysql_format(connects, query, sizeof(query), "SELECT * FROM `accounts` WHERE `Name` = '%e' LIMIT 1", Name);
	mysql_pquery(connects, query, "add_gs", "dsd",playerid,Name,Level);
	return 1;
}
alias:helpers("gamesupports","gsupp","supports","support","helper");
CMD:aezakmi(playerid) {
	if(!PI[playerid][pAdmin]) return 0;
	SCM(playerid, -1, "теперь вы");
	TI[playerid][pAndroid] = !TI[playerid][pAndroid];
	if(TI[playerid][pAndroid]) SCM(playerid, -1, "android");
	return 1;
}
CMD:helpers(playerid) {
	new counthelper = 0;
	new str[156];
	string_1024[0] = EOS;
	foreach(new i:helpersCount) {
		format(str, sizeof(str), ""W"%s[%i] %s\n",player_name[i],i,TI[i][tAFK]>=3?("{ffa800}[AFK]"):("")),strcat(string_1024,str);
		counthelper++;
	}
	if(counthelper > 0) {
		format(string_1024, sizeof(string_1024), "%s\n"ORANGE"В сети %i хелперов", string_1024,counthelper);
		D(playerid, DIALOG_NONE, DSM, ""P"Хелперы",string_1024, "Закрыть", "");
	}
	else D(playerid, DIALOG_NONE, DSM, ""P"Хелперы",""W"Нет хелперов в сети", "Закрыть", "");
	return 1;
}
alias:askmute("amute");
CMD:askmute(playerid, params[]) {
    if(!PI[playerid][pHelper] || !TI[playerid][tHelperDuty]) return true;
	new time, text[33],giveplayerid;
	if(sscanf(params, "uds[32]",giveplayerid,time,text)) return SendEsp(playerid, "/amute [playerid] [минуты] [причина]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid,not_id);
	if(giveplayerid == playerid) return ErrorMessage(playerid,"Вы указали свой ID");
	if(PI[giveplayerid][pAskmute]) return ErrorMessage(playerid,"У игрока уже закрыт доступ к подаче вопросов");
    if(IsAIP(text))return 1;
	if(strlen(text) > 30) return ErrorMessage(playerid,"Причина должна быть меньше 30 символов");
 	if(time > 15) return ErrorMessage(playerid,"Заблокировать подачу можно максимум на 15 минут");
	if(GetPVarInt(playerid,"ban")>gettime()) return ErrorMessage(playerid,"Можно раз в 10 секунд");
    SetPVarInt(playerid,"ban",gettime()+10);
	PI[giveplayerid][pAskmute] = time*60;
	UpdatePlayerData(giveplayerid,"pAskmute",PI[giveplayerid][pAskmute]);
	new string[144];
	format(string, sizeof(string), "Хелпер %s выдал блокировку репорта %s на %d мин. Причина: %s",player_name[playerid],player_name[giveplayerid], time, text);
	SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);

	format(string, sizeof(string), "[H] "W" %s выдал блокировку репорта %s на %d мин. Причина: %s",player_name[playerid],player_name[giveplayerid], time, text);
	SendHelperMessage(COLOR_YELLOW, string);

	WriteLog(LOG_MUTE,player_name[playerid],player_name[giveplayerid],text);
	return true;
}
alias:unaskmute("unamute");
CMD:unaskmute(playerid, params[]) {
    if(!PI[playerid][pHelper] || !TI[playerid][tHelperDuty]) return true;
	new text[33],giveplayerid;
	if(sscanf(params, "uds[32]",giveplayerid,text)) return SendEsp(playerid, "/unamute [playerid] [[причина]");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid,not_id);
	if(giveplayerid == playerid) return ErrorMessage(playerid,"Вы указали свой ID");
	if(!PI[giveplayerid][pAskmute]) return ErrorMessage(playerid,"У игрока не закрыт доступ к подаче вопросов");
    if(IsAIP(text))return 1;
	if(strlen(text) > 30) return ErrorMessage(playerid,"Причина должна быть меньше 30 символов");
	if(GetPVarInt(playerid,"ban")>gettime()) return ErrorMessage(playerid,"Можно раз в 10 секунд");
    SetPVarInt(playerid,"ban",gettime()+10);
	PI[giveplayerid][pAskmute] = 0;
	UpdatePlayerData(giveplayerid,"pAskmute",PI[giveplayerid][pAskmute]);
	new string[76 + MAX_PLAYER_NAME * 2];
	format(string, sizeof(string), "Хелпер %s снял блокировку репорта %s. Причина: %s",player_name[playerid],player_name[giveplayerid], text);
	SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);

	format(string, sizeof(string), "[H] "W" %s cнял блокировку репорта %s. Причина: %s",player_name[playerid],player_name[giveplayerid], text);
	SendHelperMessage(COLOR_YELLOW, string);

	WriteLog(LOG_MUTE,player_name[playerid],player_name[giveplayerid],text);
	return true;
}

alias:hchat("hс");
CMD:hchat(playerid, params[]) {
    if(!PI[playerid][pHelper] || !TI[playerid][tHelperDuty]) return true;
	new text[130];
	if(sscanf(params,"s[128]",text)) return SendEsp(playerid,"/h(hchat) [текст]");

	new string[144];
	format(string, sizeof(string), "[H]"W" %s(%i): %s",player_name[playerid],playerid,text);
	SendHelperMessage(COLOR_YELLOW, string);
	return true;
}

CMD:dj(playerid, params[]) {
    if(!DJlvl[playerid]) return true;
	new text[130];
	if(sscanf(params,"s[128]",text)) return SendEsp(playerid,"/dj [текст]");

	new string[144];
	format(string, sizeof(string), "[DJ %s]"W" %s(%i): %s",DJname[playerid],player_name[playerid],playerid,text);
	SendDJMessage(COLOR_YELLOW, string);
	return true;
}

CMD:djmsg(playerid, params[]) {
    if(!DJlvl[playerid]) return true;
	if(DJmsg > gettime()) return ErrorMessage(playerid,"Команду можно использовать раз в 10 минут!");
	D(playerid, D_DJMSG, DSL, ""P"Выбор текста", ""P"1."W" Вариант 1\n"P"2."W" Вариант 2\n"P"3."W" Вариант 3\n"P"4."W" Вариант 4\n"P"5."W" Вариант 5", "Выбрать", "Закрыть");
	return true;
}
CMD:makedj(playerid, params[]) {
	if(PI[playerid][pAdmin] < 6 && DJlvl[playerid] < 2) return true;
	new giveplayerid,Level;
	if(sscanf(params, "dd",giveplayerid,Level)) return SendEsp(playerid, "/makedj [id] [1 - назначить | 0 - снять]");
	if(!(0 <= Level <= 1)) return ErrorMessage(playerid, "От 0 до 1");
	if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, not_id);
	if(DJlvl[giveplayerid] && Level) return ErrorMessage(playerid,"Игрок уже состоит в команде Dj");
	new query[100];
	format(query, sizeof(query), "SELECT * FROM `rjlist` WHERE `pid` = '%d' LIMIT 1", PI[giveplayerid][pID]);
	mysql_pquery(connects, query, "add_dj", "ddd",playerid,giveplayerid,Level);
	return 1;
}

CMD:hpiar(playerid, params[]) {
	if(!PI[playerid][pHelper] || !TI[playerid][tHelperDuty]) return true;
	if(GetSVarInt("gspiar_timer") > gettime()) {
		new year, month, day, hour, minute, second;
		timestamp_to_date(GetSVarInt("gspiar_timer") - unix, year, month, day, hour, minute, second);
		new string[128];
		format(string,sizeof(string),"Пользоваться данной командой можно через: "W"%02d:%02d", minute, second);
		ErrorMessage(playerid, string);
		return 1;
	}
	SendClientMessageToAll(COLOR_YELLOW,"Есть вопросы по игре? Задавайте их в поддержку - /ask");
	SetSVarInt("gspiar_timer", gettime() + 60*5);
	return 1;
}
CMD:hhelp(playerid)
{
    if(!PI[playerid][pHelper]) return true;
    SendClientMessage(playerid, 0xC99700ff, "Команды хелпера {CCFF00}"NAME_SERVER" RolePlay:");
    SendClientMessage(playerid, 0xC99700ff, "/hduty /ask /unamute /amute /asks /hpiar /hchat /helpers");
	return 1;

}
CMD:hduty(playerid, params[]) {
    if(!PI[playerid][pHelper]) return true;
	new string[144];
	if(!TI[playerid][tHelperDuty]) {
		TI[playerid][tHelperDuty] = true;
		format(string, sizeof(string), "[H]"W" %s(%i) заступил(а) на дежурство",player_name[playerid],playerid);
		Iter_Add(helpersCount, playerid);
		SendHelperMessage(COLOR_YELLOW, string);
	}
	else {
		format(string, sizeof(string), "[H]"W" %s(%i) покинул(а) дежурство",player_name[playerid],playerid);
		SendHelperMessage(COLOR_YELLOW, string);
		TI[playerid][tHelperDuty] = false;
		Iter_Remove(helpersCount, playerid);
	}
	return true;
}
CMD:asks(playerid, params[]) {
	if(!PI[playerid][pHelper] || !TI[playerid][tHelperDuty]) return true;
	for(new i;i<MAX_ASK;i++) {
		if(PlayerReportAsk[i] != -1) {
			if(ReportSlotAsk[i] == 1) continue;
			new string[140 + MAX_PLAYER_NAME];
			new stringer[38 + MAX_PLAYER_NAME];
			format(string, sizeof(string), ""W"Вопрос от %s[%i]\n\n"G"%s\n", player_name[PlayerReportAsk[i]], PlayerReportAsk[i], TextAsk[i]);
			D(playerid,D_ASK_1,DSI, ""P"Поддержка",string,"Принять","Отмена");
			ReportIDAsk[playerid] = i;
			ReportSlotAsk[i] = 1;
			format(stringer, sizeof stringer, "Хелпер %s[%d] обрабатывает Ваш вопрос",player_name[playerid],playerid);
			SendUse(PlayerReportAsk[i], stringer);
			return 1;
		}
	}
	ErrorMessage(playerid, "Вопросы отсутствуют");
	return 1;
}
CMD:last(playerid, params[]) {
    if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return ErrorMessage(playerid, "Вам недоступна эта функция");
	if(isnull(params) || strlen(params) > 25) return SendEsp(playerid, "/last [Nick_Name]");
    new query[128];
   	mysql_format(connects, query, sizeof(query), "SELECT * FROM `"TABLE_ACCOUNTS"` WHERE `Name` = '%e'",params);
	new Cache:result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) return ErrorMessage(playerid,"Аккаунт не найден");
    cache_get_value_name(0, "pOnline",query,32);
    static const f_str[] = "Ник: %s | Последний вход: %s";
	new string[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 9)];
	format(string,sizeof(string),f_str,params,query);
	SendClientMessage(playerid,COLOR_BLUE,string);
	cache_delete(result);
	return true;
}
CMD:makeleader(playerid, params[]) {
    if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return true;
	new string[64];
	string_1024[0] = EOS;
	strcat(string_1024,"№\tОрганизация\tЛидер\n");
	for(new i = 1;i < MAX_FRACTIONS;i ++) {
		format(string,sizeof(string),"%i\t%s\t%s\n",i,FI[i][fName],FI[i][fLeader]);
		strcat(string_1024,string);
	}
	D(playerid,D_MAKELEADER_INFO,DSTH,"Лидеры организаций",string_1024,"Выбрать","Отмена");
	return 1;
}
cmd:templeader(playerid) // не забыть добавить в список админ команд
{
    if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return true;

   	new string[35], strings[25 + 32 * MAX_FRACTIONS];
	strcat(strings,"Снять временную лидерку\n");
	for(new i = 1;i < MAX_FRACTIONS;i ++) {
		string = "";
		format(string,sizeof(string),"%s\n",FI[i][fName]);
		strcat(strings,string);
	}
	D(playerid,D_TEMPLEADER_CHOOSE,DSL,"Выбор временной лидерки",strings,"Выбрать","Отмена");
	return 1;
}
CMD:infoips(playerid,params[]) {
    if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return true;
	if(isnull(params) || strlen(params) > 19) return SendEsp(playerid, "/infoips [IP]");
    new QUERY[256];
    mysql_format(connects, QUERY, sizeof(QUERY), "SELECT HIGH_PRIORITY * FROM `"TABLE_ACCOUNTS"` WHERE `pvIp` LIKE '%e%e%e'","%",params,"%");
	new Cache:result = mysql_query(connects, QUERY);
	new rows = cache_num_rows();
	if(rows == 0) return ErrorMessage(playerid,"IP адрес не найден");
    new tmpas[16],regip[16],mname[32],level;
    for(new i = 0; i < rows; i++) {
	    cache_get_value_name(i, "Name", mname, MAX_PLAYER_NAME);
	    cache_get_value_name(i, "pvIp", tmpas, 16);
	    cache_get_value_name(i, "pIpReg", regip, 16);
	    cache_get_value_name_int(i,"pLevel", level);

		static const f_str[] = "%s | LAST-IP: %s | REG-IP: %s | LVL: %d";
		new string[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 16) + (-2 + 16) + (-2 + 4)];

		format(string,sizeof(string),f_str,mname,tmpas, regip,level);
		SendClientMessage(playerid,COLOR_WHITE,string);
	}
    cache_delete(result);
	return true;
}
CMD:mutelist(playerid, const params[]) {
    if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	new countmute = 0,str[128];
	string_1024[0] = EOS;
	foreach(new i:Player) {
		if(!TI[i][tLogin] || AntiCheatIsKickedWithDecync(i)) continue;
		if(PI[i][pMute] > 0) {
			format(str, sizeof(str), ""YELLOW"%d. "ORANGE"%s"W" | ID: "P"%d"W" | Секунд: "GREEN"%d\n",countmute+1,player_name[i],i,PI[i][pMute]),strcat(string_1024,str);
			countmute++;
		}
	}
	if(countmute == 0) return ErrorMessage(playerid, "Нет игроков с Баном чата");
	D(playerid, DIALOG_NONE, DSM, ""P"Игроки с баном чата", string_1024, "Закрыть", "");
	return true;
}
CMD:agetip(playerid, params[]) {
    if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return true;
	if(isnull(params) || strlen(params) > 25) return SendEsp(playerid, "/agetip [Ник]");
	new QUERY[100];
	mysql_format(connects, QUERY, sizeof(QUERY), "SELECT * FROM `"TABLE_ACCOUNTS"` WHERE `Name` = '%e'",params);
	new Cache:result = mysql_query(connects, QUERY),ip[2][17];
	new rows = cache_num_rows();
	if(rows == 0) return ErrorMessage(playerid,"Аккаунт не найден!");

	cache_get_value_name(0, "pvIp",ip[0],16);
	cache_get_value_name(0, "pIpReg",ip[1],16);

	static const f_str[] = "Ник: %s | IP: %s | IP при регистрации: %s";
	new string[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 17) + (-2 + 17)];

	format(string,sizeof(string),f_str,params,ip[0],ip[1]);
	SendClientMessage(playerid,COLOR_BLUE,string);
	cache_delete(result);
	return true;
}
CMD:captfreeze(playerid,params[]) {
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return true;
	new gang_id, time;
	if(sscanf(params,"ii",gang_id, time)) {
		SendClientMessage(playerid,COLOR_GREY,"/captfreeze [id] [часов]");
		SendClientMessage(playerid,COLOR_GREY,"1 - The Ballas | 2 - The Vagos | 3 - The Grove");
		SendClientMessage(playerid,COLOR_GREY,"4 - The Rifa | 5 - The Aztecas | 6 - LCN");
		SendClientMessage(playerid,COLOR_GREY,"7 - Yakuza | 8 - Russian Mafia");
		return 1;
	}
	if(gang_id < 1 || gang_id > 8 || time < 0) {
		SendClientMessage(playerid,COLOR_GREY,"/captfreeze [id] [часов]");
		SendClientMessage(playerid,COLOR_GREY,"1 - The Ballas | 2 - The Vagos | 3 - The Grove");
		SendClientMessage(playerid,COLOR_GREY,"4 - The Rifa | 5 - The Aztecas | 6 - LCN");
		SendClientMessage(playerid,COLOR_GREY,"7 - Yakuza | 8 - Russian Mafia");
		return 1;
	}
	new string[128];
	if(time == 0) {
		fracmoroz[gang_id-1] = 0;
		format(string, sizeof(string), "Администратор %s разморозил банду %s",player_name[playerid],fracmorozName[gang_id-1]);
	}
	else {
		fracmoroz[gang_id-1] = unix+(3600*time);
		format(string, sizeof(string), "Администратор %s заморозил банду %s на %d час(ов)",player_name[playerid],fracmorozName[gang_id-1],time);
	}
	SendBand(COLOR_LIGHTRED, string);
	AdmMSG(COLOR_LIGHTRED, string,1);
	UpdateMorozed();
	return 1;
}
alias:apanel("ap");
CMD:apanel(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;
	switch(PI[playerid][pAdmin]) {
		case 1: {
			new string[277];
			format(string,sizeof(string),""P"1."W" Администрация\n"P"2."W" Заспавниться\n"P"3."W" Устроиться на работу\n"P"4."W" Игроки в тюрьме\n"P"5."W" Игроки с баном чата\n"P"6."W" Админ информация %s\n"P"7."W" Kill List %s",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
			return D(playerid,D_ADMIN_PANEL,DSL,""P"Админ панель",string,"Выбрать","Отмена");
		}

		case 2: {
			new string[277 + 79];
			format(string,sizeof(string),""P"1."W" Администрация\n"P"2."W" Заспавниться\n"P"3."W" Устроиться на работу\n"P"4."W" Игроки в тюрьме\n"P"5."W" Игроки с баном чата\n"P"6."W" Админ информация %s\n"P"7."W" Kill List %s\n"P"8."W" Онлайн организаций\n"P"9."W" Починить автомобиль",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
			return D(playerid,D_ADMIN_PANEL,DSL,""P"Админ панель",string,"Выбрать","Отмена");
		}

		case 3: {
			new string[277 + 79 + 88];
			format(string,sizeof(string),""P"1."W" Администрация\n"P"2."W" Заспавниться\n"P"3."W" Устроиться на работу\n"P"4."W" Игроки в тюрьме\n"P"5."W" Игроки с баном чата\n"P"6."W" Админ информация %s\n"P"7."W" Kill List %s\n"P"8."W" Онлайн организаций\n"P"9."W" Починить автомобиль\n"P"10."W" Состояние складов\n"P"11."W" Узнать заморозки банд/мафий",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
			return D(playerid,D_ADMIN_PANEL,DSL,""P"Админ панель",string,"Выбрать","Отмена");
		}
		
		case 4: {
			new string[277 + 79 + 88 + 113];
			format(string,sizeof(string),""P"1."W" Администрация\n"P"2."W" Заспавниться\n"P"3."W" Устроиться на работу\n"P"4."W" Игроки в тюрьме\n"P"5."W" Игроки с баном чата\n"P"6."W" Админ информация %s\n"P"7."W" Kill List %s\n"P"8."W" Онлайн организаций\n"P"9."W" Починить автомобиль\n"P"10."W" Состояние складов\n"P"11."W" Узнать заморозки банд/мафий\n"P"12."W" Банлист\n"P"13."W" Возможно взломаны\n"P"14."W" Дуэли %s",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!duels) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
			return D(playerid,D_ADMIN_PANEL,DSL,""P"Админ панель",string,"Выбрать","Отмена");
		}
		
		case 5: {
			new string[277 + 79 + 88 + 113 + 202];
			format(string,sizeof(string),""P"1."W" Администрация\n"P"2."W" Заспавниться\n"P"3."W" Устроиться на работу\n"P"4."W" Игроки в тюрьме\n"P"5."W" Игроки с баном чата\n"P"6."W" Админ информация %s\n"P"7."W" Kill List %s\n"P"8."W" Онлайн организаций\n"P"9."W" Починить автомобиль\n"P"10."W" Состояние складов\n"P"11."W" Узнать заморозки банд/мафий\n"P"12."W" Банлист\n"P"13."W" Возможно взломаны\n"P"14."W" Дуэли %s\n"P"15."W" Античит\n"P"16."W" Казино %s\n"P"17."W" Репорт %s\n"P"18."W" Заполнить склады банд/мафий\n"P"19."W" Ограничение Invite",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!duels) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!casino) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!rep_system) ? ("{FF182D}[OLD]") : ("{33AA33}[NEW]"));
			return D(playerid,D_ADMIN_PANEL,DSL,""P"Админ панель",string,"Выбрать","Отмена");
		}
		
		case 6,7: {
			new string[277 + 79 + 88 + 113 + 202 + 211]; // итого: со всех уровней 277 + 79 + 88 + 113 + 202 + 211 = 970
			format(string,sizeof(string),""P"1."W" Администрация\n"P"2."W" Заспавниться\n"P"3."W" Устроиться на работу\n"P"4."W" Игроки в тюрьме\n"P"5."W" Игроки с баном чата\n"P"6."W" Админ информация %s\n"P"7."W" Kill List %s\n"P"8."W" Онлайн организаций\n"P"9."W" Починить автомобиль\n"P"10."W" Состояние складов\n"P"11."W" Узнать заморозки банд/мафий\n"P"12."W" Банлист\n"P"13."W" Возможно взломаны\n"P"14."W" Дуэли %s\n"P"15."W" Античит\n"P"16."W" Казино %s\n"P"17."W" Репорт %s\n"P"18."W" Заполнить склады банд/мафий\n"P"19."W" Ограничение Invite\n"P"20."W" Дальнобойщики\n"P"21."W" Промокоды\n"P"22."W" Бонусы\n"P"23."W" Пополнить продукты в бизнес(сколько заказал владелец)\n"P"24."W" Анти ТК %s",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!duels) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!casino) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!rep_system) ? ("{FF182D}[OLD]") : ("{33AA33}[NEW]"),(!anti_tk) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
			return D(playerid,D_ADMIN_PANEL,DSL,""P"Админ панель",string,"Выбрать","Отмена");
		}
	}
	return true;
}
CMD:hinfo(playerid,params[]) {
	if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return true;
	new giveplayerid;
	if(sscanf(params, "d",giveplayerid)) return SendEsp(playerid, "/hinfo [ID]");
	new string[33];
	format(string,sizeof(string),"Ответов: "W"\t\t%d",PI[giveplayerid][pAsk]);
	D(playerid,DIALOG_NONE,DSM,player_name[giveplayerid],string,"Закрыть","");
	return 1;
}
CMD:ainfo(playerid,params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return true;

	new string[512];
	format(string,sizeof(string),""ORANGE"Киков: "W"\t\t\t%d\n"ORANGE"Банов: "W"\t\t\t%d\n"ORANGE"Мутов: "W"\t\t\t%d\n"ORANGE"Ответов: "W"\t\t%d\n"ORANGE"Варнов: "W"\t\t%d\n"ORANGE"Джайлов: "W"\t\t%d\n"ORANGE"Репутация: "W"\t\t%d\n\n"ORANGE"Онлайн за текущий день:"W"\t%s",gAdmin[playerid][0],gAdmin[playerid][1],gAdmin[playerid][2],gAdmin[playerid][3],gAdmin[playerid][4],gAdmin[playerid][5],gAdmin[playerid][8],ConvertsCmdTime(gAdminTime[playerid]));
	D(playerid,DIALOG_NONE,DSM,player_name[playerid],string,"Закрыть","");
