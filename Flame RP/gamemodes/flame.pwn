stock showLoginDialog(playerid) {
	static const f_str[] = ""W"Добро пожаловать на "P"Lights Role Play!"W"\n\n\
		Аккаунт "P"%s"W" успешно найден.\n\
		Для авторизации, пожалуйста, введите пароль от аккаунта.\n\n\
		Для восстановления доступа нажмите кнопку: "P"Восстановить";

	new string[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME)];

	format(string, sizeof(string), f_str, player_name[playerid]);

	return D(playerid,D_LOGIN,DSP, ""P"Авторизация",string, "Войти", "Восстановить");
}
stock callAccountRecovery(playerid) {
	new query[92];

	format(query, sizeof(query), "SELECT `pEmail`, `pEmailStatus` FROM `"TABLE_ACCOUNTS"` WHERE `pID` = '%d' LIMIT 1", PI[playerid][pID]);
	mysql_tquery(connects, query, "login_call_account_recovery", "i", playerid);

	return 1;
}
stock ShowRentMenu(playerid)
{
	new rent_price = 0;
	switch(PI[playerid][pLevel]) {
		case 1..5: rent_price = 50;
		case 6..10: rent_price = 200;
		default: rent_price = 300;
	}

	if(TI[playerid][tArendaCar] != -1) return ErrorMessage(playerid, "Вы уже арендуете транспорт (/stoprent)"); 

	if(PI[playerid][pCash] < rent_price) return ErrorMessage(playerid, "У вас недостаточно средств");

	new string_price[64];
	format(string_price, sizeof(string_price), ""G"Вы хотите арендовать скутер за %d$?", rent_price);

	return D(playerid, D_RENT_SPAWN_LS, DSM, ""P"Аренда", string_price, "Принять", "Отмена");
}
stock ShowStats(playerid,targetid,idx) {
	if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid)) return true;
	new jtext[28];
	string_1024[0] = EOS;

	switch(PI[targetid][pJob]) {
		case 1: jtext = "Водитель автобуса";
		case 2: jtext = "Механик";
		case 3: jtext = "Развозчик продуктов/топлива";
		case 4: jtext = "Развозчик еды";
		case 5: jtext = "Мойщик дорог";
		case 6: jtext = "Газонокосильщик";
		default: jtext = "Безработный";
	}
	new str_[128];
	format(str_, sizeof str_, ""P"Имя:\t\t\t\t"YELLOW"%s",player_name[targetid]);
	strcat(string_1024,str_);
	format(str_, sizeof str_, "\n\n"P"Уровень:\t\t\t"W"%i",PI[targetid][pLevel]);
	strcat(string_1024,str_);
	format(str_, sizeof str_, "\n"P"Опыт:\t\t\t\t"W"%i/%i",PI[targetid][pExp], (PI[targetid][pLevel])*6); 
	strcat(string_1024,str_);
	format(str_, sizeof str_, "\n"P"Деньги:\t\t\t"W"%i",PI[targetid][pCash]);
	strcat(string_1024,str_);
 	format(str_, sizeof str_, "\n"P"Банк:\t\t\t\t"W"%i",PI[targetid][pBank]);
	strcat(string_1024,str_);
	format(str_, sizeof str_, "\n"P"Предупреждений:\t\t"W"%i",PI[targetid][pWarns]);
	strcat(string_1024,str_);
	format(str_, sizeof str_, "\n\n"P"Пол:\t\t\t\t"W"%s",(PI[targetid][pSex] == 1) ? ("Мужчина") : ("Женщина"));
	strcat(string_1024,str_);
	format(str_, sizeof str_, "\n"P"Супруг(а):\t\t\t"W"%s",PI[targetid][pMarried]);
	strcat(string_1024,str_);
	if(PI[targetid][pPhone] == 0) {
		strcat(string_1024,"\n\n"P"Номер телефона:\t\t"W"Нет");
	}
	else {
		format(str_, sizeof str_, "\n\n"P"Номер телефона:\t\t"W"%i",PI[targetid][pPhone]);
		strcat(string_1024,str_);
	}
	format(str_, sizeof str_, "\n"P"Мобильный счёт:\t\t"W"%i",PI[targetid][pMobile]);
	strcat(string_1024,str_);

	format(str_, sizeof str_, "\n\n"P"Законопослушность:\t\t"W"%i",PI[targetid][pZakonp]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Преступлений:\t\t\t"W"%i",PI[targetid][pCrimes]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Арестов:\t\t\t"W"%i",PI[targetid][pArrested]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Уровень розыска:\t\t"W"%i",PI[targetid][pSearch]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Зависимость:\t\t\t"W"%i",PI[targetid][pAddiction]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Наркотики:\t\t\t"W"%i",PI[targetid][pDrugs]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Боеприпасы:\t\t\t"W"%i",PI[targetid][pMats]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Аптечки:\t\t\t"W"%i",PI[targetid][pMedKit]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Маски:\t\t\t\t"W"%i",PI[targetid][pMask]);
	strcat(string_1024, str_);
	format(str_, sizeof str_, "\n"P"Отмычки:\t\t\t"W"%i",PI[targetid][pJemmy]);
	strcat(string_1024, str_);

	if(GetTeamID(targetid)) {
		format(str_, sizeof str_, "\n\n"P"Организация:\t\t\t"W"%s",FI[GetTeamID(targetid)][fName]);
		strcat(string_1024,str_);
	}
	else strcat(string_1024, "\n\n"P"Организация:\t\t\t"W"Нет");
	if(idx) {
		format(str_, sizeof str_, "\n"P"Должность:\t\t\t"W"%s (%d)",GetRankName(GetTeamID(targetid),PI[targetid][pRank]),PI[targetid][pRank]);
		strcat(string_1024,str_);
	}
	else {
		format(str_, sizeof str_, "\n"P"Должность:\t\t\t"W"%s",GetRankName(GetTeamID(targetid),PI[targetid][pRank]));
		strcat(string_1024,str_);
	}

	if(PI[targetid][pHouse]) {
		new classname[12];
		switch(gHouses[PI[targetid][pHouse]-1][houseClass]) {
			case 0: classname = "Эконом";
			case 1: classname = "Cредний";
			case 2: classname = "Элитный";
			case 3: classname = "Особняк";
		}
		format(str_, sizeof str_, "\n\n"P"Дом:\t\t\t\t"W"№%d (%s)",gHouses[PI[targetid][pHouse]-1][houseID],classname);
		strcat(string_1024,str_);
	}
	else strcat(string_1024,"\n\n"P"Дом:\t\t\t\t"W"Нет");
	if(PI[targetid][pBusiness]) {
		format(str_, sizeof str_, "\n"P"Бизнес:\t\t\t"W"%s (%s)",gBusiness[PI[targetid][pBusiness]-1][bizzName],gBusinessTypeName[gBusiness[PI[targetid][pBusiness]-1][bizzType]-1]);
		strcat(string_1024,str_);
	}
	else strcat(string_1024,"\n"P"Бизнес:\t\t\t"W"Нет");
	if(PI[targetid][pHotel]) {
		format(str_, sizeof str_, "\n"P"Отель:\t\t\t"W"%s",gHotels[PI[targetid][pHotel]-1][hotelName]);
		strcat(string_1024,str_);
	}
	else strcat(string_1024,"\n"P"Отель(бизнес):\t\t\t"W"Нет");
	if(PI[targetid][pAirport]) {
		format(str_, sizeof str_, "\n"P"Аэропорт:\t\t\t"W"%s",gAirs[PI[targetid][pAirport]-1][airName]);
		strcat(string_1024,str_);
	}
	else strcat(string_1024,"\n"P"Аэропорт:\t\t\t"W"Нет");

	format(str_, sizeof str_, "\n\n"P"Работа:\t\t\t\t"W"%s",jtext);
	strcat(string_1024,str_);
	if(idx) {
	    format(str_, sizeof str_, "\n"P"Скин:\t\t\t\t"W"%i",PI[targetid][pSkin]), strcat(string_1024,str_);
	    format(str_, sizeof str_, "\n"P"СкинФр:\t\t\t"W"%i",PI[targetid][pFracSkin]), strcat(string_1024,str_);
	    format(str_, sizeof str_, "\n"P"Дата Регистрации:\t\t"W"%s",PI[targetid][pDataReg]), strcat(string_1024,str_);
	    format(str_, sizeof str_, "\n"P"Вход по почте\t\t"W"%s",(PI[targetid][pEmailStatus] >= 2) ? ("Включен") : ("Отключен")), strcat(string_1024,str_);
	}
	if(TI[playerid][pAndroid]) SelectTextDraw(playerid, 0xFF0000FF); // это для мобильного худа
	return D(playerid, D_SHOWSTATS, DSM, ""P"Статистика", string_1024, "Закрыть", "");
}

stock UpdateSkladFrakGang() {
    ClearTotalGz();
	for(new i = 0; i < TOTALGZ; i++) {
		switch(GZInfo[i][gFrakVlad])
		{
			case fBALLAS: TotalGZ[0]++;
			case fVAGOS: TotalGZ[1]++;
			case fGROVE: TotalGZ[2]++;
			case fAZTEC: TotalGZ[4]++;
			case fRIFA: TotalGZ[3]++;
		}
	}
	new string[250];
	format(string,sizeof(string),"Склад банды {8813E7}Ballas"W"\n\n- Территорий: "P"%d\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке банды: "P"$%d\n"W"- Прибыль за час: "P"$%d",TotalGZ[0],FI[fBALLAS][fMats],FI[fBALLAS][fDrugs],FI[fBALLAS][fBank],TotalGZ[0]*40); UpdateDynamic3DTextLabelText(gMenu[0],-1,string);
	format(string,sizeof(string),"Склад банды {DBD604}Vagos"W"\n\n- Территорий: "P"%d\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке банды: "P"$%d\n"W"- Прибыль за час: "P"$%d",TotalGZ[1],FI[fVAGOS][fMats],FI[fVAGOS][fDrugs],FI[fVAGOS][fBank],TotalGZ[1]*40); UpdateDynamic3DTextLabelText(gMenu[1],-1,string);
	format(string,sizeof(string),"Склад банды {009F00}Grove"W"\n\n- Территорий: "P"%d\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке банды: "P"$%d\n"W"- Прибыль за час: "P"$%d",TotalGZ[2],FI[fGROVE][fMats],FI[fGROVE][fDrugs],FI[fGROVE][fBank],TotalGZ[2]*40); UpdateDynamic3DTextLabelText(gMenu[2],-1,string);
	format(string,sizeof(string),"Склад банды {01FCFF}Aztecas"W"\n\n- Территорий: "P"%d\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке банды: "P"$%d\n"W"- Прибыль за час: "P"$%d",TotalGZ[4],FI[fAZTEC][fMats],FI[fAZTEC][fDrugs],FI[fAZTEC][fBank],TotalGZ[4]*40); UpdateDynamic3DTextLabelText(gMenu[3],-1,string);
	format(string,sizeof(string),"Склад банды {83BFBF}Rifa"W"\n\n- Территорий: "P"%d\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке банды: "P"$%d\n"W"- Прибыль за час: "P"$%d",TotalGZ[3],FI[fRIFA][fMats],FI[fRIFA][fDrugs],FI[fRIFA][fBank],TotalGZ[3]*40); UpdateDynamic3DTextLabelText(gMenu[4],-1,string);


	format(string,sizeof(string),"Аптечка банды {8813E7}Ballas"W"\nДоступно аптечек: "P"%d",FI[fBALLAS][fHealth]); UpdateDynamic3DTextLabelText(gHealth[0],-1,string);
	format(string,sizeof(string),"Аптечка банды {DBD604}Vagos"W"\nДоступно аптечек: "P"%d",FI[fVAGOS][fHealth]); UpdateDynamic3DTextLabelText(gHealth[1],-1,string);
	format(string,sizeof(string),"Аптечка банды {009F00}Grove"W"\nДоступно аптечек: "P"%d",FI[fGROVE][fHealth]); UpdateDynamic3DTextLabelText(gHealth[2],-1,string);
	format(string,sizeof(string),"Аптечка банды {01FCFF}Aztecas"W"\nДоступно аптечек: "P"%d",FI[fAZTEC][fHealth]); UpdateDynamic3DTextLabelText(gHealth[3],-1,string);
	format(string,sizeof(string),"Аптечка банды {83BFBF}Rifa"W"\nДоступно аптечек: "P"%d",FI[fRIFA][fHealth]); UpdateDynamic3DTextLabelText(gHealth[4],-1,string);

	if(black_prods[9] > unix) {
		new year, month, day, hour, minute, second;
		timestamp_to_date(black_prods[9]-unix, year, month, day, hour, minute, second);
		static const f_str[] = "Владелец чёрного рынка\n\t{%06x}%s\n\n"W"Война возможна через: "P"%iд %iч %iм %iс";
		new str[sizeof(f_str) +1 + (-2 + 35)];
		format(str,sizeof(str),f_str,gFractionSpawn[black_prods[0]][fracColor] >>> 8,FI[black_prods[0]][fName],day-1, hour, minute, second);
		UpdateDynamic3DTextLabelText(black_market,-1,str);
	}
	else {
		static const f_str[] = "Владелец чёрного рынка\n\t{%06x}%s\n\n"YELLOW"Можно воевать за чёрный рынок";
		new str[sizeof(f_str) +1 + (-2 + 35)];
		format(str,sizeof(str),f_str,gFractionSpawn[black_prods[0]][fracColor] >>> 8,FI[black_prods[0]][fName]);
		UpdateDynamic3DTextLabelText(black_market,-1,str);
	}
	return 1;
}
stock UpdateSkladFrakMafia() {
	new string[250];
	format(string,sizeof(string),"Склад {DDA701}Итальянской мафии"W"\n\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке мафии: "P"$%d",FI[fLCN][fMats],FI[fLCN][fDrugs],FI[fLCN][fBank]); UpdateDynamic3DTextLabelText(mMenu[0],-1,string);
	format(string,sizeof(string),"Склад {FF0000}Японской мафии"W"\n\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке мафии: "P"$%d",FI[fYAKUZA][fMats],FI[fYAKUZA][fDrugs],FI[fYAKUZA][fBank]); UpdateDynamic3DTextLabelText(mMenu[1],-1,string);
	format(string,sizeof(string),"Склад {B4B5B7}Русской мафии"W"\n\n"W"- Боеприпасов: "P"%d\n"W"- Наркотиков: "P"%d\n"W"- В банке мафии: "P"$%d",FI[fRM][fMats],FI[fRM][fDrugs],FI[fRM][fBank]); UpdateDynamic3DTextLabelText(mMenu[2],-1,string);
