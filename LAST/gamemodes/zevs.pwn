forward OnCarPurchased(playerid, slot);
public OnCarPurchased(playerid, slot)
{
    VehicleInfo[playerid][slot][vDBID] = cache_insert_id();
    VehicleInfo[playerid][slot][vFuel] = 40.0;
    VehicleInfo[playerid][slot][vHealth] = 1000.0;
    gVehicleMileage[playerid][slot] = 0.0;
    VehicleInfo[playerid][slot][vAutoEngine] = false;
    VehicleInfo[playerid][slot][vAutoLock]   = false;
    VehicleInfo[playerid][slot][vLastValid]  = false;
    new r;

    if(p_SalonType[playerid] == 0)
    {
        r = random(sizeof(SalonSpawnCoordsHigh));
        for(new i=0; i<4; i++) VehicleInfo[playerid][slot][vPos][i] = SalonSpawnCoordsHigh[r][i];
    }
    else if(p_SalonType[playerid] == 1)
    {
        r = random(sizeof(SalonSpawnCoordsMedium));
        for(new i=0; i<4; i++) VehicleInfo[playerid][slot][vPos][i] = SalonSpawnCoordsMedium[r][i];
    }
    else
    {
        r = random(sizeof(SalonSpawnCoordsLow));
        for(new i=0; i<4; i++) VehicleInfo[playerid][slot][vPos][i] = SalonSpawnCoordsLow[r][i];
    }

    new query[256];
    mysql_format(db_handle, query, sizeof(query),
        "UPDATE `ownable_cars` SET `x`='%f', `y`='%f', `z`='%f', `a`='%f', `fuel`=%f, `health`=%f WHERE `id`='%d'",
        VehicleInfo[playerid][slot][vPos][0], VehicleInfo[playerid][slot][vPos][1],
        VehicleInfo[playerid][slot][vPos][2], VehicleInfo[playerid][slot][vPos][3],
        VehicleInfo[playerid][slot][vFuel], VehicleInfo[playerid][slot][vHealth],
        VehicleInfo[playerid][slot][vDBID]);
    mysql_tquery(db_handle, query, "", "");

    VehicleInfo[playerid][slot][vID] = CreateVehicle(
        VehicleInfo[playerid][slot][vModel],
        VehicleInfo[playerid][slot][vPos][0], VehicleInfo[playerid][slot][vPos][1],
        VehicleInfo[playerid][slot][vPos][2], VehicleInfo[playerid][slot][vPos][3],
        VehicleInfo[playerid][slot][vColor][0], VehicleInfo[playerid][slot][vColor][1], -1
    );
    Vehicle_UpdateOwnerCache(VehicleInfo[playerid][slot][vID], playerid, slot);

    CarSystem_InitSpawnedVehicle(VehicleInfo[playerid][slot][vID]);
    SetVehicleHealth(VehicleInfo[playerid][slot][vID], VehicleInfo[playerid][slot][vHealth]);
    
    if(p_SalonWheelID[playerid] > 0)
    {
        new wheelid = SalonWheels[p_SalonWheelID[playerid]];
        AddVehicleComponent(VehicleInfo[playerid][slot][vID], wheelid);
        VehicleInfo[playerid][slot][vWheel] = wheelid;

        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `wheel`='%d' WHERE `id`='%d'", wheelid, VehicleInfo[playerid][slot][vDBID]);
        mysql_tquery(db_handle, query, "", "");
    }

    VehicleInfo[playerid][slot][vSpawned] = true;
    SendClientMessage(playerid, COLOR_WHITE, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜!");
    
    if(VehicleInfo[playerid][slot][vNitro] > 0)
{
    AddVehicleComponent(VehicleInfo[playerid][slot][vID], 1007 + VehicleInfo[playerid][slot][vNitro]);
}
    BroadcastPersonalVehicleVisuals(VehicleInfo[playerid][slot][vID], playerid, slot);
    SetTimerEx("Timer_ReapplyCarVisuals", 200, false, "iii", VehicleInfo[playerid][slot][vID], playerid, slot);
    SetTimerEx("Timer_ReapplyCarVisuals", 550, false, "iii", VehicleInfo[playerid][slot][vID], playerid, slot);
    return 1;
}

public conti_OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(ShopStores_OnClickTextDraw(playerid, clickedid)) return 1;

    if(!acs_editing[playerid])
    {
        return 0;
    }

    if(clickedid == acss_TD[1])
    {
        StopAccessoryEdit(playerid, false);
        return 1;
    }
    if(clickedid == acss_TD[2])
    {
        StopAccessoryEdit(playerid, true);
        return 1;
    }

    if(acss_TD[3] <= clickedid <= acss_TD[9])
    {
        new TD = -1;
        for(new i = 3; i < 10; i++) if(clickedid == acss_TD[i]) { TD = i; break; }

        new td_use = GetPVarInt(playerid, "acss_TD_use");
        new count_TD = TD - 3;

        TextDrawHideForPlayer(playerid, acss_TD[10 + (td_use-1)]);
        TextDrawShowForPlayer(playerid, acss_TD[3 + (td_use-1)]);
        TextDrawHideForPlayer(playerid, acss_TD[17 + (td_use-1)]);

        TextDrawHideForPlayer(playerid, acss_TD[3 + count_TD]);
        TextDrawShowForPlayer(playerid, acss_TD[10 + count_TD]);
        TextDrawShowForPlayer(playerid, acss_TD[17 + count_TD]);

        SetPVarInt(playerid, "acss_TD_use", count_TD + 1);

        new Float:v;
        switch(count_TD + 1)
        {
            case 1: v = GetPVarFloat(playerid, "edit_y"); // ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜ UI
            case 2: v = GetPVarFloat(playerid, "edit_z");
            case 3: v = GetPVarFloat(playerid, "edit_x");
            case 4: v = GetPVarFloat(playerid, "edit_scale");
            case 5: v = GetPVarFloat(playerid, "edit_rX");
            case 6: v = GetPVarFloat(playerid, "edit_rY");
            case 7: v = GetPVarFloat(playerid, "edit_rZ");
        }
        new s[32];
        format(s, sizeof s, "%.6f", v);
        PlayerTextDrawSetString(playerid, acss_coords_PTD[playerid], s);
        return 1;
    }

    if(clickedid == acss_TD[24] || clickedid == acss_TD[25])
    {
        new Float:val = (clickedid == acss_TD[24]) ? (1.0) : (-1.0);
        new s[32], type = GetPVarInt(playerid, "acss_TD_use");

        switch(type)
        {
            case 1: // UI ˜˜˜˜˜/˜˜˜˜˜˜ -> ˜˜ ˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜/˜˜˜˜ (Y)
            {
                SetPVarFloat(playerid, "edit_z", GetPVarFloat(playerid, "edit_z") + (val * 0.005));
                format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "edit_z"));
            }
            case 2: // UI ˜˜˜˜˜/˜˜˜˜ -> ˜˜ ˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜/˜˜ ˜˜˜˜ (Z)
            {
                SetPVarFloat(playerid, "edit_x", GetPVarFloat(playerid, "edit_x") + (val * 0.005));
                format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "edit_x"));
            }
            case 3: // UI ˜˜ ˜˜˜˜/˜˜ ˜˜˜˜ -> ˜˜ ˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜/˜˜˜˜˜˜ (X)
            {
                SetPVarFloat(playerid, "edit_y", GetPVarFloat(playerid, "edit_y") + (val * 0.005));
                format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "edit_y"));
            }
            case 4:
            {
                SetPVarFloat(playerid, "edit_scale", GetPVarFloat(playerid, "edit_scale") + (val * 0.02));
                format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "edit_scale"));
            }
            case 5: { SetPVarFloat(playerid, "edit_rX", GetPVarFloat(playerid, "edit_rX") + (val * 2.0)); format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "edit_rX")); }
            case 6: { SetPVarFloat(playerid, "edit_rY", GetPVarFloat(playerid, "edit_rY") + (val * 2.0)); format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "edit_rY")); }
            case 7: { SetPVarFloat(playerid, "edit_rZ", GetPVarFloat(playerid, "edit_rZ") + (val * 2.0)); format(s, sizeof s, "%.6f", GetPVarFloat(playerid, "edit_rZ")); }
        }

        PlayerTextDrawSetString(playerid, acss_coords_PTD[playerid], s);
        SetPlayerAttachedObject(playerid, GetPVarInt(playerid, "slot"), GetPVarInt(playerid, "acs_model"), GetPVarInt(playerid, "bone"),
            GetPVarFloat(playerid, "edit_x"), GetPVarFloat(playerid, "edit_y"), GetPVarFloat(playerid, "edit_z"),
            GetPVarFloat(playerid, "edit_rX"), GetPVarFloat(playerid, "edit_rY"), GetPVarFloat(playerid, "edit_rZ"),
            GetPVarFloat(playerid, "edit_scale"), GetPVarFloat(playerid, "edit_scale"), GetPVarFloat(playerid, "edit_scale"));
        return 1;
    }
    return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    if(playertextid == avtsln_PTD[playerid][0])
    {
        new id = p_SalonCarID[playerid], car_price, car_name[32];
        if(p_SalonType[playerid] == 0) { car_price = SalonCars[id][sPrice]; strmid(car_name, SalonCars[id][sName], 0, strlen(SalonCars[id][sName]), 32); }
        else if(p_SalonType[playerid] == 1) { car_price = MediumSalonCars[id][sPrice]; strmid(car_name, MediumSalonCars[id][sName], 0, strlen(MediumSalonCars[id][sName]), 32); }
        else { car_price = LowSalonCars[id][sPrice]; strmid(car_name, LowSalonCars[id][sName], 0, strlen(LowSalonCars[id][sName]), 32); }

        if(Player[playerid][pMoney] < car_price) return SendClientMessage(playerid, COLOR_RED, "[˜˜˜˜˜˜˜˜˜] ˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜!");

        new slot = Player_FindFreeCarSlot(playerid);
        if(slot == -1)
        {
            new slot_msg[160];
            Player_FillNoCarSlotMessage(playerid, slot_msg, sizeof slot_msg);
            return SendClientMessage(playerid, COLOR_RED, slot_msg);
        }

        new string[256];
        format(string, sizeof(string),
            "%s˜˜˜˜˜˜˜˜\t%s˜˜˜˜˜˜˜˜\n%s˜˜˜˜˜˜\t%s%s\n%s˜˜˜˜\t%s%d RUB\n%s˜˜˜˜ 1\t%s%d\n%s˜˜˜˜ 2\t%s%d",
            CAR_CLR_WHITE, CAR_CLR_WHITE, CAR_CLR_WHITE, CAR_CLR_GOLD, car_name,
            CAR_CLR_WHITE, CAR_CLR_GOLD, car_price,
            CAR_CLR_WHITE, CAR_CLR_GOLD, p_SalonColor[playerid][0],
            CAR_CLR_WHITE, CAR_CLR_GOLD, p_SalonColor[playerid][1]);
        SetPVarInt(playerid, "BuyCarID", id);
        ShowPlayerDialog(playerid, DIALOG_BUY_CAR_CONFIRM, DIALOG_STYLE_TABLIST_HEADERS, CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜˜", string, "˜˜˜˜˜˜", "˜˜˜˜˜˜");
        return 1;
    }

    if(playertextid == avtsln_PTD[playerid][1]) return HideAvtosalon(playerid);

    if(playertextid == avtsln_PTD[playerid][3])
    {
        new max_id = (p_SalonType[playerid] == 0) ? sizeof(SalonCars) : (p_SalonType[playerid] == 1) ? sizeof(MediumSalonCars) : sizeof(LowSalonCars);
        p_SalonCarID[playerid] = (p_SalonCarID[playerid] >= max_id - 1) ? 0 : p_SalonCarID[playerid] + 1;
        UpdateSalonVehicle(playerid, true);
        return 1;
    }

    if(playertextid == avtsln_PTD[playerid][4])
    {
        new max_id = (p_SalonType[playerid] == 0) ? sizeof(SalonCars) : (p_SalonType[playerid] == 1) ? sizeof(MediumSalonCars) : sizeof(LowSalonCars);
        p_SalonCarID[playerid] = (p_SalonCarID[playerid] <= 0) ? max_id - 1 : p_SalonCarID[playerid] - 1;
        UpdateSalonVehicle(playerid, true);
        return 1;
    }

    if(playertextid == avtsln_PTD[playerid][8]) { p_SalonColor[playerid][0] = (p_SalonColor[playerid][0] >= 126) ? 0 : p_SalonColor[playerid][0] + 1; ChangeVehicleColor(p_BuyCar[playerid], p_SalonColor[playerid][0], p_SalonColor[playerid][1]); return 1; }
    if(playertextid == avtsln_PTD[playerid][10]) { p_SalonColor[playerid][0] = (p_SalonColor[playerid][0] <= 0) ? 126 : p_SalonColor[playerid][0] - 1; ChangeVehicleColor(p_BuyCar[playerid], p_SalonColor[playerid][0], p_SalonColor[playerid][1]); return 1; }
    if(playertextid == avtsln_PTD[playerid][7]) { p_SalonWheelID[playerid] = (p_SalonWheelID[playerid] >= sizeof(SalonWheels)-1) ? 0 : p_SalonWheelID[playerid] + 1; UpdateSalonVehicle(playerid, false); return 1; }
    if(playertextid == avtsln_PTD[playerid][9]) { p_SalonWheelID[playerid] = (p_SalonWheelID[playerid] <= 0) ? sizeof(SalonWheels)-1 : p_SalonWheelID[playerid] - 1; UpdateSalonVehicle(playerid, false); return 1; }

    return 0;
}

stock ProxDetector(Float:radi, playerid, string[], color)
{
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid))
            if(IsPlayerInRangeOfPoint(i, radi, x, y, z)) SendClientMessage(i, color, string);
    }
    return 1;
}

// ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (˜˜˜˜˜˜˜ / ˜˜˜˜˜˜˜˜˜ ˜˜˜) ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜.
stock Auth_GoRegSkinStep(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    TogglePlayerSpectating(playerid, false);
    SetPlayerPosEx(playerid, 1200.399902, 607.876281, 1349.309448, 184.824386, 1, playerid);
    SetPlayerCameraPos(playerid, 1201.510253, 604.738281, 1350.530395);
    SetPlayerCameraLookAt(playerid, 1193.910253, 630.0, 1342.530395);

    SetPVarInt(playerid, "auth_reg_flow", 1);
    DeletePVar(playerid, "reg_gui_ack");

    new Node:response = JSON_Object();
    JSON_SetInt(response, "t", 0);
    OnPacketIncoming(playerid, 38, response);
    JSON_Cleanup(response);
    return 1;
}

// ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜/˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ GUI 38 ˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ o,r (˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜).
stock Auth_MarkGuiAck(playerid)
{
    SetPVarInt(playerid, "reg_gui_ack", 1);
    return 1;
}

stock Auth_ShowRegGui(playerid, has_account)
{
    if(!IsPlayerConnected(playerid)) return 0;

    SetPVarInt(playerid, "auth_has_account", has_account ? 1 : 0);
    SetPVarInt(playerid, "auth_state_ready", 1);

    new Node:j = JSON_Object();
    JSON_SetInt(j, "o", 1);
    JSON_SetInt(j, "r", has_account ? 1 : 0);
    OnPacketIncoming(playerid, 38, j);
    JSON_Cleanup(j);
    return 1;
}

stock Auth_ReopenRegGui(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(Player[playerid][pID] != 0) return 0;
    if(GetPVarInt(playerid, "auth_reg_flow")) return 0;
    if(!GetPVarInt(playerid, "auth_state_ready")) return 0;
    if(GetPVarInt(playerid, "reg_gui_ack")) return 0;

    new reg = GetPVarInt(playerid, "auth_has_account");
    new Node:j = JSON_Object();
    JSON_SetInt(j, "o", 1);
    JSON_SetInt(j, "r", reg);
    OnPacketIncoming(playerid, 38, j);
    JSON_Cleanup(j);
    return 1;
}

forward Auth_ReopenRegGuiTimer(playerid);
public Auth_ReopenRegGuiTimer(playerid)
{
    Auth_ReopenRegGui(playerid);
    return 1;
}

stock Auth_StoreRegPassword(playerid, password[])
{
    format(Player[playerid][pPassword], 65, "%s", password);
    SetPVarString(playerid, "auth_reg_pass", password);
    return 1;
}

stock bool:Auth_ReadFirstStringField(Node:json, dest[], size, const key1[], const key2[] = "", const key3[] = "", const key4[] = "", const key5[] = "")
{
    dest[0] = EOS;
    if(key1[0] != EOS && JSON_GetString(json, key1, dest, size) && dest[0] != EOS) return true;
    if(key2[0] != EOS && JSON_GetString(json, key2, dest, size) && dest[0] != EOS) return true;
    if(key3[0] != EOS && JSON_GetString(json, key3, dest, size) && dest[0] != EOS) return true;
    if(key4[0] != EOS && JSON_GetString(json, key4, dest, size) && dest[0] != EOS) return true;
    if(key5[0] != EOS && JSON_GetString(json, key5, dest, size) && dest[0] != EOS) return true;
    return false;
}

stock Auth_ReadRegPassword(playerid, dest[], size)
{
    dest[0] = EOS;
    GetPVarString(playerid, "auth_reg_pass", dest, size);
    if(strlen(dest) >= 6 && strlen(dest) <= 16) return 1;
    if(Player[playerid][pPassword][0] != EOS && strlen(Player[playerid][pPassword]) >= 6 && strlen(Player[playerid][pPassword]) <= 16)
    {
        format(dest, size, "%s", Player[playerid][pPassword]);
        return 1;
    }
    return 0;
}

stock Auth_ClearRegSession(playerid)
{
    DeletePVar(playerid, "auth_reg_flow");
    DeletePVar(playerid, "reg_gui_ack");
    DeletePVar(playerid, "auth_reg_finish");
    DeletePVar(playerid, "auth_reg_skin");
    DeletePVar(playerid, "auth_ref_pending");
    DeletePVar(playerid, "auth_referal");
    DeletePVar(playerid, "auth_state_ready");
    DeletePVar(playerid, "auth_pending_pass");
    DeletePVar(playerid, "auth_reg_pass");
    return 1;
}

stock Auth_SubmitLogin(playerid, password[])
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(strlen(password) < 4) return 0;

    new pass_buf[65];
    format(pass_buf, sizeof(pass_buf), "%s", password);

    new query[320];
    mysql_format(db_handle, query, sizeof(query),
        "SELECT `id`, `password`, `ban_time`, `ban_start`, `ban_days`, `ban_reason`, `ban_admin` FROM `players` WHERE `name`='%e' LIMIT 1",
        Player[playerid][pName]);
    new Cache:result = mysql_query(db_handle, query, true);
    new rows = cache_num_rows();

    if(rows <= 0)
    {
        cache_delete(result);
        Auth_OnWrongPassword(playerid);
        return 0;
    }

    new db_pass[65], account_id;
    db_pass[0] = EOS;
    cache_get_field_content(0, "password", db_pass, db_handle, 65);
    account_id = cache_get_field_content_int(0, "id", db_handle);

    if(db_pass[0] == EOS || strlen(db_pass) < 1)
    {
        cache_delete(result);
        Admin_ClearBanFields(playerid);
        ShowNotification(playerid, NOTIFY_TYPE_TEXT_RED, 5, 0, 0, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜.", "");
        return 0;
    }

    Player[playerid][pBanTime] = cache_get_field_content_int(0, "ban_time", db_handle);
    Player[playerid][pBanStart] = cache_get_field_content_int(0, "ban_start", db_handle);
    Player[playerid][pBanDays] = cache_get_field_content_int(0, "ban_days", db_handle);
    Player[playerid][pBanReason][0] = EOS;
    Player[playerid][pBanAdmin][0] = EOS;
    cache_get_field_content(0, "ban_reason", Player[playerid][pBanReason], db_handle, 64);
    cache_get_field_content(0, "ban_admin", Player[playerid][pBanAdmin], db_handle, 24);
    BR_DbToGame(Player[playerid][pBanReason], 64);
    BR_DbToGame(Player[playerid][pBanAdmin], 24);
    cache_delete(result);

    if(Admin_SyncBanOnLogin(playerid))
    {
        Auth_HandleAccountBanned(playerid);
        return 0;
    }

    if(strcmp(db_pass, pass_buf, false))
    {
        Admin_ClearBanFields(playerid);
        Auth_OnWrongPassword(playerid);
        return 0;
    }

    mysql_format(db_handle, query, sizeof(query),
        "SELECT * FROM `players` WHERE `id`=%d LIMIT 1", account_id);
    result = mysql_query(db_handle, query, true);
    if(cache_num_rows() <= 0)
    {
        cache_delete(result);
        Auth_OnWrongPassword(playerid);
        return 0;
    }

    if(!Auth_ApplyAccountFromCache(playerid))
    {
        cache_delete(result);
        Auth_OnWrongPassword(playerid);
        return 0;
    }
    cache_delete(result);

    if(Admin_SyncBanOnLogin(playerid))
    {
        Auth_HandleAccountBanned(playerid);
        return 0;
    }

    ContinueAccountLoadAfterLogin(playerid);
    return 1;
}

stock Auth_OnWrongPassword(playerid)
{
    Player[playerid][pPassword][0] = EOS;
    Player[playerid][pLoginAttempts]++;
    if(Player[playerid][pLoginAttempts] >= 3)
    {
        new Node:res = JSON_Object();
        JSON_SetInt(res, "c", 1);
        OnPacketIncoming(playerid, 38, res);
        JSON_Cleanup(res);
        ShowNotification(playerid, NOTIFY_TYPE_TEXT_RED, 5, 0, 0, "˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜!", "");
        SetTimerEx("KickPublic", 500, false, "i", playerid);
    }
    else
    {
        new string[128];
        format(string, sizeof(string), "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜: %d", 3 - Player[playerid][pLoginAttempts]);
        ShowNotification(playerid, NOTIFY_TYPE_TEXT_RED, 5, 0, 0, string, "");
        // ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜.
    }
    return 1;
}

stock Auth_HandleAccountBanned(playerid)
{
    Player[playerid][pID] = 0;
    Player[playerid][pLoginAttempts]++;

    new Node:res = JSON_Object();
    JSON_SetInt(res, "c", 1);
    OnPacketIncoming(playerid, 38, res);
    JSON_Cleanup(res);

    Admin_ShowBanDialog(playerid);

    if(Player[playerid][pLoginAttempts] >= 3)
    {
        ShowNotification(playerid, 1, 5, 0, 0, "˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜ (˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜).", "");
        SetTimerEx("KickPublic", 800, false, "i", playerid);
    }
    return 1;
}

stock Auth_ReopenLoginAfterBan(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(Player[playerid][pID] > 0) return 0;

    DeletePVar(playerid, "reg_gui_ack");
    SetPVarInt(playerid, "auth_has_account", 1);
    SetPVarInt(playerid, "auth_state_ready", 1);
    Auth_ShowRegGui(playerid, 1);
    return 1;
}

// ˜˜˜˜ ˜ ˜˜˜˜˜˜˜ (˜˜˜ 16.05.26 OnAccountLoad): ˜˜˜˜˜˜ c=1, ˜˜˜ o/r ˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜.
stock Auth_SendClientLoginDone(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(Player[playerid][pID] <= 0) return 0;

    Auth_ClearRegSession(playerid);
    SetPVarInt(playerid, "auth_has_account", 1);

    new Node:res = JSON_Object();
    JSON_SetInt(res, "c", 1);
    OnPacketIncoming(playerid, 38, res);
    JSON_Cleanup(res);
    return 1;
}

// ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜ GUI (t=-1, c=1), ˜˜˜˜˜ ˜˜˜˜˜ ˜˜ int ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜.
stock Auth_FinishRegistration(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(Player[playerid][pID] <= 0) return 0;

    Auth_ClearRegSession(playerid);
    SetPVarInt(playerid, "auth_has_account", 1);
    SetPVarInt(playerid, "auth_first_play", 1);

    Hospital_ResetPlayer(playerid);
    Player[playerid][pHealth] = 100.0;
    Player[playerid][pArmour] = 0.0;
    if(IsPlayerConnected(playerid))
    {
        SetPlayerHealth(playerid, 100.0);
        SetPlayerArmour(playerid, 0.0);
    }

    SavePlayerAccount(playerid);

    ShowNotification(playerid, 3, 5, 0, 0, "˜˜˜ ˜˜˜ ˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜, ˜˜ ˜˜˜˜˜˜˜˜˜˜˜!", "");
    new reg_bonus[160];
    format(reg_bonus, sizeof(reg_bonus), "˜˜˜˜˜: %d ˜˜˜., %d BC, VIP Gold %d ˜˜.", REG_BONUS_MONEY, REG_BONUS_BC, REG_BONUS_VIP_DAYS);
    ShowNotification(playerid, 1, 6, 0, 0, reg_bonus, "");

    new Node:response = JSON_Object();
    JSON_SetInt(response, "t", -1);
    JSON_SetInt(response, "c", 1);
    OnPacketIncoming(playerid, 38, response);
    JSON_Cleanup(response);

    new q[256];
    mysql_format(db_handle, q, sizeof(q),
        "SELECT * FROM `ownable_cars` WHERE `owner_id` = %d\
         AND `id` NOT IN (SELECT `car_db_id` FROM `family_fleet` WHERE `car_db_id` > 0)",
        Player[playerid][pID]);
    mysql_tquery(db_handle, q, "LoadPlayerVehicles", "i", playerid);

    new inv_query[128];
    mysql_format(db_handle, inv_query, sizeof(inv_query), "SELECT * FROM `inventory` WHERE `uid` = %d", Player[playerid][pID]);
    mysql_tquery(db_handle, inv_query, "LoadPlayerInventory", "i", playerid);

    Calendar_Load(playerid);
    SetPlayerColor(playerid, COLOR_WHITE);

    SetPVarInt(playerid, "spawn_wait_fam", 1);
    Family_DB_LoadMember(playerid);
    SetTimerEx("SpawnLoc_FallbackOpenAfterFam", 3500, false, "i", playerid);
    return 1;
}

// ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ (GUI 50).
stock Auth_FinishSpawnWorld(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(Player[playerid][pID] <= 0) return 0;

    HideInteractionWindow(playerid);
    GibddResetPlayer(playerid);
    SetPlayerInBiz(playerid, -1);
    Shop247_OnExitBiz(playerid);

    return SpawnLoc_OpenAfterAuth(playerid);
}

forward Auth_TryFinishRegistration(playerid);
public Auth_TryFinishRegistration(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    if(!GetPVarInt(playerid, "auth_reg_finish")) return 1;

    if(Player[playerid][pID] == 0)
    {
        SetTimerEx("Auth_TryFinishRegistration", 250, false, "i", playerid);
        return 1;
    }

    new skin = GetPVarInt(playerid, "auth_reg_skin");
    if(skin > 0) Player[playerid][pSkin] = skin;
    DeletePVar(playerid, "auth_reg_finish");
    DeletePVar(playerid, "auth_reg_skin");

    Auth_FinishRegistration(playerid);
    return 1;
}

forward SetRandomSpawn(playerid);
public SetRandomSpawn(playerid)
{
    if(Player[playerid][pID] <= 0) return 1;
    Auth_FinishSpawnWorld(playerid);
    return 1;
}

forward CheckPlayerAccount(playerid);
public CheckPlayerAccount(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    if(Player[playerid][pID] > 0) return 1;

    new rows, fields;
    cache_get_data(rows, fields, db_handle);
    new reg = (rows > 0) ? 1 : 0;

    Auth_ShowRegGui(playerid, reg);
    return 1;
}

forward OnWhitelistAccessChecked(playerid);
public OnWhitelistAccessChecked(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new total = 0, allowed = 0;
    new ip_match = 0, ip_count = 0;
    if(cache_num_rows() > 0)
    {
        total = cache_get_field_content_int(0, "total", db_handle);
        allowed = cache_get_field_content_int(0, "allowed", db_handle);
        ip_match = cache_get_field_content_int(0, "ip_match", db_handle);
        ip_count = cache_get_field_content_int(0, "ip_count", db_handle);
    }

    if(total <= 0 || allowed <= 0)
    {
        ShowPlayerDialog(playerid, DIALOG_WHITELIST_DENY, DIALOG_STYLE_MSGBOX,
            "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜",
            "{FFFFFF}˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜.\n\
            ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜.\n\
            ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.",
            "˜˜˜˜˜", "");
        SetTimerEx("KickPublic", 1000, false, "i", playerid);
        return 1;
    }

    if(ip_match <= 0)
    {
        if(ip_count < 2)
        {
            new player_ip[16], ip_query[192];
            GetPlayerIp(playerid, player_ip, sizeof(player_ip));
            mysql_format(db_handle, ip_query, sizeof(ip_query),
                "INSERT IGNORE INTO `whitelist_ips` (`nickname`,`ip`) VALUES ('%e','%e')",
                Player[playerid][pName], player_ip);
            mysql_tquery(db_handle, ip_query, "", "");
        }
        else
        {
            ShowPlayerDialog(playerid, DIALOG_WHITELIST_DENY, DIALOG_STYLE_MSGBOX,
                "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜",
                "{FFFFFF}˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜.\n\
                ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ 2 IP-˜˜˜˜˜˜.\n\
                ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.",
                "˜˜˜˜˜", "");
            SetTimerEx("KickPublic", 1000, false, "i", playerid);
            return 1;
        }
    }

    new query[128];
    mysql_format(db_handle, query, sizeof(query), "SELECT * FROM `players` WHERE `name` = '%e' LIMIT 1", Player[playerid][pName]);
    mysql_tquery(db_handle, query, "CheckPlayerAccount", "i", playerid);
    return 1;
}

public OnPlayerText(playerid, text[])
{
    BR_FixUserText(text, 144);

    if(Player[playerid][pID] == 0)
    {
        SendClientMessage(playerid, COLOR_RED, "[˜˜˜˜˜˜˜˜˜˜˜] ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ (˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜).");
        return 0;
    }

    if(Player[playerid][pMuteTime] > 0)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜!", "");

        SetPlayerChatBubble(playerid, "(( MUTED ))", 0xE0584BFF, 10.0, 5000);

        return 0;
    }

    if(Phone_OnPlayerText(playerid, text))
        return 0;

    new s[144];
    format(s, sizeof(s), "- %s (%s)[%d]", text, Player[playerid][pName], playerid);
    ProxDetector(20.0, playerid, s, COLOR_WHITE);

    return 0;
}

stock GetCommandRequiredAdminLevel(const cmd[])
{
    if(!strcmp(cmd, "ans", true)) return 1;
    if(!strcmp(cmd, "showtools", true)) return 1;
    if(!strcmp(cmd, "sp", true)) return 1;
    if(!strcmp(cmd, "spoff", true)) return 1;
    if(!strcmp(cmd, "ahelp", true)) return 1;
    if(!strcmp(cmd, "admins", true)) return 1;

    if(!strcmp(cmd, "getv", true)) return 1;
    if(!strcmp(cmd, "vget", true)) return 1;
    if(!strcmp(cmd, "kick", true)) return 1;
    if(!strcmp(cmd, "mute", true)) return 1;
    if(!strcmp(cmd, "jail", true)) return 1;
    if(!strcmp(cmd, "freeze", true)) return 1;
    if(!strcmp(cmd, "unfreeze", true)) return 1;
    if(!strcmp(cmd, "unmute", true)) return 1;
    if(!strcmp(cmd, "unjail", true)) return 1;
    if(!strcmp(cmd, "spawn", true)) return 1;
    if(!strcmp(cmd, "veh", true)) return 1;
    if(!strcmp(cmd, "setskin", true)) return 1;
    if(!strcmp(cmd, "skin", true)) return 1;
    if(!strcmp(cmd, "gethere", true)) return 1;
    if(!strcmp(cmd, "goto", true)) return 1;

    if(!strcmp(cmd, "ban", true)) return 2;
    if(!strcmp(cmd, "unban", true)) return 2;
    if(!strcmp(cmd, "warn", true)) return 2;
    if(!strcmp(cmd, "givegun", true)) return 2;

    if(!strcmp(cmd, "givevip", true)) return 7;

    if(!strcmp(cmd, "givecash", true)) return 4;
    if(!strcmp(cmd, "givedonate", true)) return 5;
    if(!strcmp(cmd, "payday", true)) return 6;
    if(!strcmp(cmd, "setadmin", true)) return 9;
    if(!strcmp(cmd, "whitelist", true)) return 13;

    if(!strcmp(cmd, "permban", true)) return 5;
    if(!strcmp(cmd, "flip", true)) return 1;
    if(!strcmp(cmd, "cc", true)) return 4;
    return -1;
}

public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
    if(!strcmp(cmd, "alogin", true) || !strcmp(cmd, "goadm", true))
        return 1;

    new requiredLevel = GetCommandRequiredAdminLevel(cmd);
    if(requiredLevel == -1) return 1;

    if(Player[playerid][pAdminLvl] > 0 && Admin_IsPunishCommand(cmd) && !Player[playerid][pAdminAuth])
    {
        ShowNotification(playerid, 1, 5, 0, 0, "˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ /alogin", "");
        return 0;
    }

    if(Admin_IsJuniorModerator(playerid) && Admin_IsPunishCommand(cmd))
    {
        Admin_NotifyFunctionUnavailable(playerid);
        return 0;
    }

    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < requiredLevel)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜.", "");
        return 0;
    }
    return 1;
}

public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
    if(result == -1)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜!", "");
        return 0;
    }
    return 1;
}

public OnPlayerEnterCheckpoint(playerid)
{
    // Streamer DynamicCP ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ SetPlayerCheckpoint.
    // ˜˜˜˜˜˜˜˜˜˜ DisablePlayerCheckpoint ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜
    // (˜˜˜˜˜˜˜˜, ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ GUI).
    new STREAMER_TAG_CP:dcp = STREAMER_TAG_CP:GetPlayerVisibleDynamicCP(playerid);
    if(IsValidDynamicCP(dcp)) return 1;

    DisablePlayerCheckpoint(playerid);
    return 1;
}

public OnPlayerRequestClass(playerid, classid) {  return 1; }

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
    if(Player[playerid][pAdminAuth] && Player[playerid][pAdminLvl] >= 1)
    {
        MapTPPos[playerid][0] = fX;
        MapTPPos[playerid][1] = fY;
        MapTPPos[playerid][2] = fZ;

        ShowPlayerDialog(playerid, DIALOG_MAP_TP, DIALOG_STYLE_MSGBOX,
            "{E0584B}˜˜˜˜˜˜˜˜˜˜˜˜",
            "{FFFFFF}˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜?",
            "˜˜", "˜˜˜˜˜˜");
    }
    return 1;
}

stock PV_ApplyVehiclePaintPlr(forplayerid, vehicleid, ownerid, slot)
{
    if(!IsPlayerConnected(forplayerid)) return 0;
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;
    if(ownerid < 0 || ownerid >= MAX_PLAYERS || slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;

    return PV_ApplyVehiclePaintPlrValues(forplayerid, vehicleid,
        VehicleInfo[ownerid][slot][vBodyColor], VehicleInfo[ownerid][slot][vDiskColor]);
}

stock PV_BcastPaintPlrVals(vehicleid, body, disk)
{
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(!IsPlayerConnected(p)) continue;
        PV_ApplyVehiclePaintPlrValues(p, vehicleid, body, disk);
    }
    return 1;
}

stock PV_BroadcastVehiclePaintColors(vehicleid, ownerid, slot)
{
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(!IsPlayerConnected(p)) continue;
        PV_ApplyVehiclePaintPlr(p, vehicleid, ownerid, slot);
    }
    return 1;
}

// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜ ˜?˜, ˜˜˜˜˜, ˜˜˜˜, ˜˜˜˜˜ ˜˜˜˜?, ˜˜˜˜˜ ˜ ˜˜˜˜˜˜?˜ RPC.
stock PV_SendVehVisPlr(forplayerid, vehicleid, ownerid, slot)
{
    if(!IsPlayerConnected(forplayerid)) return 0;
    if(ownerid < 0 || !IsPlayerConnected(ownerid)) return 0;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;

    PV_ApplyVehiclePaintPlr(forplayerid, vehicleid, ownerid, slot);

    if(VehicleInfo[ownerid][slot][vLightsColor] != 0)
        SetVehicleLightsColorHEX(forplayerid, vehicleid, VehicleInfo[ownerid][slot][vLightsColor]);

    UpdateVehicleTint(forplayerid, vehicleid,
        VehicleInfo[ownerid][slot][vWindFront], VehicleInfo[ownerid][slot][vWindRear]);

    if(VehicleInfo[ownerid][slot][vNeonMain] != 0 || VehicleInfo[ownerid][slot][vNeon1] != 0 || VehicleInfo[ownerid][slot][vNeon2] != 0)
    {
        if(VehicleInfo[ownerid][slot][vNeonState])
        {
            UpdateVehicleNeon(forplayerid, vehicleid,
                VehicleInfo[ownerid][slot][vNeonMain],
                VehicleInfo[ownerid][slot][vNeon1],
                VehicleInfo[ownerid][slot][vNeon2]);
        }
        else
        {
            UpdateVehicleNeon(forplayerid, vehicleid, 0, 0, 0);
        }
    }

    if(VehicleInfo[ownerid][slot][vVinyl][0] != '\0')
        SetVehicleVinylForPlayer(forplayerid, vehicleid, VehicleInfo[ownerid][slot][vVinyl]);

    if(VehicleInfo[ownerid][slot][vDalniysvet] > 0)
        SetVehicleDlaniy(forplayerid, vehicleid, VehicleInfo[ownerid][slot][Dalniysvet] ? 1 : 0);

    if(VehicleInfo[ownerid][slot][vLaunchControl] > 0 && VehicleInfo[ownerid][slot][vLaunchControlOn])
        SetVehLaunchCtrlForPlr(forplayerid, vehicleid, 1);
    else if(VehicleInfo[ownerid][slot][vLaunchControl] > 0)
        SetVehLaunchCtrlForPlr(forplayerid, vehicleid, 0);

    if(VehicleInfo[ownerid][slot][vHornSound] > 0)
        SetVehicleHornSoundForPlayer(forplayerid, vehicleid, VehicleInfo[ownerid][slot][vHornSound]);
    if(VehicleInfo[ownerid][slot][vExhaustSound] >= 0)
        SetVehicleExhaustForPlayer(forplayerid, vehicleid, VehicleInfo[ownerid][slot][vExhaustSound]);

    if(VehicleInfo[ownerid][slot][vHydra] > 0)
        SetVehicleHydraulicsForPlayer(forplayerid, vehicleid, VehicleInfo[ownerid][slot][vHydraState] ? 1 : 0);

    if(VehicleInfo[ownerid][slot][vPnevmo] > 0)
    {
        new pm = VehicleInfo[ownerid][slot][vPnevmoMode];
        new Float:susp = 0.0;
        if(pm >= RADIAL_PNEVMO_MIN && pm <= RADIAL_PNEVMO_MAX)
            susp = Radial_GetPnevmoSuspension(pm);
        SetVehicleSuspension(forplayerid, vehicleid, susp);
    }

    if(VehicleInfo[ownerid][slot][vPlateType] > 0 && strlen(VehicleInfo[ownerid][slot][vPlateNumber]) > 0)
    {
        SetVehicleNumberPlateForPlayer(forplayerid, vehicleid,
            VehicleInfo[ownerid][slot][vPlateType],
            VehicleInfo[ownerid][slot][vPlateNumber],
            VehicleInfo[ownerid][slot][vPlateRegion]);
    }

    new type_to_send = (VehicleInfo[ownerid][slot][vStrobState]) ? VehicleInfo[ownerid][slot][vStrob] : 5;
    SetVehicleStroboscopeForPlayer(forplayerid, vehicleid, type_to_send);

    Tune_BkApplyAllForPlayer(forplayerid, vehicleid, ownerid, slot);
    return 1;
}

stock PV_SyncVehicleToPlayer(forplayerid, vehicleid)
{
    new owner, slot;
    if(!GetVehicleOwnerSlot(vehicleid, owner, slot)) return 0;
    return PV_SendVehVisPlr(forplayerid, vehicleid, owner, slot);
}

public PV_TimerVehVisSync(playerid, vehicleid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;
    return PV_SyncVehicleToPlayer(playerid, vehicleid);
}

public PV_SyncStreamedPersonalForPlr(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        for(new v = 0; v < MAX_PLAYER_VEHICLES; v++)
        {
            if(!VehicleInfo[i][v][vSpawned]) continue;
            new vid = VehicleInfo[i][v][vID];
            if(vid == INVALID_VEHICLE_ID || !GetVehicleModel(vid)) continue;
            if(IsVehicleStreamedIn(vid, playerid))
                PV_SendVehVisPlr(playerid, vid, i, v);
        }
    }
    return 1;
}

stock BroadcastVehicleTint(vehicleid, ownerid, slot)
{
    if(ownerid < 0 || slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;
    new front = VehicleInfo[ownerid][slot][vWindFront];
    new rear = VehicleInfo[ownerid][slot][vWindRear];
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(!IsPlayerConnected(p)) continue;
        UpdateVehicleTint(p, vehicleid, front, rear);
    }
    return 1;
}

stock BroadcastVehicleVinyl(vehicleid, texture[])
{
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;
    if(!texture[0]) return 0;
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(IsPlayerConnected(p)) SetVehicleVinylForPlayer(p, vehicleid, texture);
    }
    return 1;
}

stock BroadcastVehicleLightsColor(vehicleid, color)
{
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;
    if(color == 0) return 0;
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(IsPlayerConnected(p)) SetVehicleLightsColorHEX(p, vehicleid, color);
    }
    return 1;
}

stock BroadcastVehiclePnevmoState(vehicleid, ownerid, slot)
{
    if(ownerid < 0 || slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;
    if(VehicleInfo[ownerid][slot][vPnevmo] <= 0) return 0;
    new pm = VehicleInfo[ownerid][slot][vPnevmoMode];
    new Float:susp = 0.0;
    if(pm >= RADIAL_PNEVMO_MIN && pm <= RADIAL_PNEVMO_MAX)
        susp = Radial_GetPnevmoSuspension(pm);
    Radial_BroadcastSuspension(vehicleid, susp);
    return 1;
}

stock Vehicle_UpdateOwnerCache(vehicleid, ownerid, slot)
{
    if(vehicleid > 0 && vehicleid < MAX_VEHICLES)
    {
        gVehOwnerCache[vehicleid] = ownerid;
        gVehSlotCache[vehicleid] = slot;
    }
    return 1;
}

public Timer_ReapplyCarVisuals(vehicleid, ownerid, slot)
{
    if(!GetVehicleModel(vehicleid)) return 0;
    if(ownerid < 0 || ownerid > GetPlayerPoolSize()) return 0;
    if(!IsPlayerConnected(ownerid)) return 0;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(VehicleInfo[ownerid][slot][vID] != vehicleid) return 0;
    BroadcastPersonalVehicleVisuals(vehicleid, ownerid, slot);
    return 1;
}

forward Timer_ReapplyCarVisuals(vehicleid, ownerid, slot);
forward CarSystem_RefreshWheelsTimer(vehicleid, ownerid, slot);
public CarSystem_RefreshWheelsTimer(vehicleid, ownerid, slot)
{
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;
    if(ownerid < 0 || ownerid >= MAX_PLAYERS || slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(VehicleInfo[ownerid][slot][vID] != vehicleid) return 0;
    CarSystem_RefreshVehicleWheels(vehicleid, ownerid, slot);
    BroadcastPersonalVehicleVisuals(vehicleid, ownerid, slot);
    return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        for(new v = 0; v < MAX_PLAYER_VEHICLES; v++)
        {
            if(VehicleInfo[i][v][vSpawned] && VehicleInfo[i][v][vID] == vehicleid)
            {
                PV_SendVehVisPlr(forplayerid, vehicleid, i, v);
                SetTimerEx("PV_TimerVehVisSync", 120, false, "ii", forplayerid, vehicleid);
                SetTimerEx("PV_TimerVehVisSync", 500, false, "ii", forplayerid, vehicleid);
                return 1;
            }
        }
    }
    return 1;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
    #pragma unused ispassenger
    #if defined _FAMILY_ADDITION_INC_
    FamilyAddition_OnEnterVehicle(playerid, vehicleid, ispassenger);
    #endif
    if(vehicleid != INVALID_VEHICLE_ID && GetVehicleModel(vehicleid))
    {
        PV_SyncVehicleToPlayer(playerid, vehicleid);
        SetTimerEx("PV_TimerVehVisSync", 200, false, "ii", playerid, vehicleid);
    }
    VM_OnEnterVeh(playerid, vehicleid, ispassenger);
    return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
    VM_OnExitVeh(playerid, vehicleid);
    return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    #if defined _FAMILY_ADDITION_INC_
    FamilyAddition_OnKeyStateChange(playerid, newkeys, oldkeys);
    #endif
    MinerJob_OnKeyStateChange(playerid, newkeys, oldkeys);

    if(newkeys & KEY_YES)
    {
        if(MinerJob_TryInteractKey(playerid)) return 1;
        if(Shop247_TryInteractKey(playerid)) return 1;
        if(Bank_TryInteractKey(playerid)) return 1;
        if(Hospital_TryInteractKey(playerid)) return 1;
    }

    if(newkeys & KEY_CROUCH)
    {
        if(IsPlayerInRangeOfPoint(playerid, 5.0, -426.235290, 1005.412658, 12.307508) ||
           IsPlayerInRangeOfPoint(playerid, 5.0, -420.054534, 1005.409240, 12.307003) ||
           IsPlayerInRangeOfPoint(playerid, 5.0, -413.549285, 1005.543029, 12.326748))
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(!vehicleid) return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜");

            if(GetPlayerVehicleSlot(playerid, vehicleid) == -1)
                return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜");

            callcmd::techcentergui(playerid, "");
            return 1;
        }

        if(IsPlayerInRangeOfPoint(playerid, 5.0, 2311.418945, -2607.487304, 21.808467) ||
           IsPlayerInRangeOfPoint(playerid, 5.0, 2311.424804, -2613.460937, 21.808467))
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(!vehicleid)
                return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!");
            if(GetPlayerVehicleSlot(playerid, vehicleid) == -1)
                return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜");

            callcmd::tungui(playerid, "");
            return 1;
        }

        if(Shinka_IsPlayerAtEntry(playerid, 5.0))
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(!vehicleid)
                return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!");
            if(GetPlayerVehicleSlot(playerid, vehicleid) == -1)
                return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!");

            Shinka_TryOpen(playerid);
            return 1;
        }

        if(Sto_IsPlayerAtEntry(playerid, 5.0))
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(!vehicleid)
                return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!");
            if(GetPlayerVehicleSlot(playerid, vehicleid) == -1)
                return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!");

            Sto_TryOpen(playerid);
            return 1;
        }
    }
    return 1;
}

public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
    #pragma unused playerid
    if(vehicleid == INVALID_VEHICLE_ID || vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 1;
    if(!GetVehicleModel(vehicleid)) return 1;

    VehHp_OnDamageStatusUpdate(vehicleid);

    new owner, slot;
    if(!Fuel_GetVehicleOwnerSlot(vehicleid, owner, slot)) return 1;

    new Float:vh = VehHp_ClampHealth(VehicleInfo[owner][slot][vHealth]);
    SetVehicleHealth(vehicleid, vh);

    if(VehHp_IsBroken(vh))
    {
        VehHp_LimitSpeed(vehicleid, VEH_BROKEN_MAX_KMH);
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && !g_VehBrokenAnnounced[vehicleid])
        {
            g_VehBrokenAnnounced[vehicleid] = true;
            ShowNotification(playerid, 2, 5, 0, 0,
                "˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (/call 090).", "");
            SendClientMessage(playerid, 0xF5D400FF,
                "˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (/call 090).");
        }
    }

    return 1;
}

public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
    #pragma unused newinteriorid, oldinteriorid
    Admin_Spectate_OnInteriorChange(playerid);
    return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
    Admin_Spectate_OnStateChange(playerid, newstate);
    if(oldstate == PLAYER_STATE_DRIVER)
    {
        Fuel_CrashTrackReset(playerid);
        g_VehEngineOfferShown[playerid] = false;
        g_VehEngineOfferVeh[playerid] = 0;
        new old_vehicleid = GetPlayerVehicleID(playerid);
        if(old_vehicleid != INVALID_VEHICLE_ID)
        {
            ResetVehicleTunePhysics(old_vehicleid);
            SetVehicleDriftMode(playerid, old_vehicleid, false);
        }
    }

	if(newstate == PLAYER_STATE_DRIVER)
    {
        Fuel_CrashArmGrace(playerid);
        g_VehEngineOfferShown[playerid] = false;
        g_VehEngineOfferVeh[playerid] = 0;

        new vehicleid = GetPlayerVehicleID(playerid);
        new slot = GetPlayerVehicleSlot(playerid, vehicleid);
        new owner = playerid;

        if(slot != -1)
        {
            new nitro_type = VehicleInfo[playerid][slot][vNitro];
            if(nitro_type > 0)
            {
                new component_id = 1007 + nitro_type;
                if(!GetVehicleComponentInSlot(vehicleid, CARMODTYPE_NITRO))
                {
                    AddVehicleComponent(vehicleid, component_id);
                }
            }
        }
        else
        {
            for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
            {
                if(!IsPlayerConnected(i)) continue;
                slot = GetPlayerVehicleSlot(i, vehicleid);
                if(slot != -1)
                {
                    owner = i;
                    break;
                }
            }
        }

        if(slot != -1)
        {
            if(VehicleInfo[owner][slot][vComfortA])
                ApplyVehicleTuneMode(vehicleid, TUNE_MODE_COMFORT);
            else if(VehicleInfo[owner][slot][vSportA])
                ApplyVehicleTuneMode(vehicleid, TUNE_MODE_SPORT);
            else if(VehicleInfo[owner][slot][vSportPlusA])
                ApplyVehicleTuneMode(vehicleid, TUNE_MODE_SPORTPLUS);
            else if(VehicleInfo[owner][slot][vDriftA])
            {
                ApplyVehicleTuneMode(vehicleid, TUNE_MODE_DRIFT);
                SetVehicleDriftMode(playerid, vehicleid, true);
            }
            else
                ResetVehicleTunePhysics(vehicleid);

            if(!VehicleInfo[owner][slot][vDriftA])
                SetVehicleDriftMode(playerid, vehicleid, false);

            // ˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜, ˜˜ ˜˜˜˜˜˜
            // ˜˜˜ (˜˜˜˜˜˜˜˜, ˜˜˜˜ ˜˜˜˜˜). ˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜,
            // ˜˜˜˜˜ SetVehicleParamsEx ˜˜˜˜˜˜˜ lights/lock/etc ˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜.
            if(VehicleInfo[owner][slot][vAutoEngine] && !GetVehicleParam(vehicleid, V_ENGINE))
            {
                SetVehicleParam(vehicleid, V_ENGINE, 1);
            }
        }
    }
    return 1;
}

CMD:car(playerid)
{
    new spawned_slot = -1;
    new total_cars = 0;
    new bool:family_spawned = false;

    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(VehicleInfo[playerid][i][vFamFleetBorrow] && VehicleInfo[playerid][i][vSpawned])
            family_spawned = true;
        if(!CarSystem_IsPersonalGarageSlot(playerid, i)) continue;
        total_cars++;
        if(VehicleInfo[playerid][i][vSpawned])
            spawned_slot = i;
    }

    if(spawned_slot != -1)
    {
        SetPVarInt(playerid, "SelectedCarSlot", spawned_slot);
        ShowCarActionMenu(playerid, spawned_slot);
        return 1;
    }

    if(total_cars > 0)
    {
        DeletePVar(playerid, "CarMenuPage");
        ShowPlayerCars(playerid, 0);
        return 1;
    }

    if(family_spawned)
    {
        ShowNotification(playerid, 0, 5, 0, 0,
            "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜. /fm - ˜˜˜˜˜˜˜˜ - ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜.", "");
        return 1;
    }

    ShowNotification(playerid, 0, 5, 0, 0, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!", "");
    return 1;
}

stock CarDialog_FormatPlate(playerid, slot, dest[], size = 32)
{
    if(VehicleInfo[playerid][slot][vPlateType] > 0 && strlen(VehicleInfo[playerid][slot][vPlateNumber]) > 0)
    {
        if(strlen(VehicleInfo[playerid][slot][vPlateRegion]) > 0)
            format(dest, size, CAR_CLR_PLATE "%s %s",
                VehicleInfo[playerid][slot][vPlateNumber], VehicleInfo[playerid][slot][vPlateRegion]);
        else
            format(dest, size, CAR_CLR_PLATE "%s", VehicleInfo[playerid][slot][vPlateNumber]);
    }
    else
        format(dest, size, CAR_CLR_GOLD "˜");
    return 1;
}

stock CarDialog_FormatStatus(playerid, slot, dest[], size = 64)
{
    if(VehicleInfo[playerid][slot][vSpawned])
        format(dest, size, CAR_CLR_STATUS "˜˜˜˜˜˜˜˜˜");
    else
        format(dest, size, CAR_CLR_STATUS "˜˜˜˜˜˜˜˜˜");
    return 1;
}

stock CarDialog_FormatVehicleHeader(playerid, slot, dest[], size = 96)
{
    new plate_str[32], status_str[24];
    CarDialog_FormatPlate(playerid, slot, plate_str, sizeof plate_str);
    CarDialog_FormatStatus(playerid, slot, status_str, sizeof status_str);
    format(dest, size,
        CAR_CLR_WHITE "%s " CAR_CLR_WHITE "| %s " CAR_CLR_WHITE "| %s",
        GetVehicleNameByModel(VehicleInfo[playerid][slot][vModel]),
        plate_str,
        status_str);
    return 1;
}

stock ShowPlayerCars(playerid, page)
{
    new string[1536], count = 0, total = 0;
    format(string, sizeof(string), "˜˜˜˜˜˜\t˜˜˜˜˜˜˜˜ ˜˜˜˜\t˜˜˜˜˜˜˜˜˜\n");

    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(!CarSystem_IsPersonalGarageSlot(playerid, i)) continue;

        if(total >= page * 10 && count < 10)
        {
            new plate_str[32], status_str[24];
            CarDialog_FormatPlate(playerid, i, plate_str, sizeof plate_str);
            CarDialog_FormatStatus(playerid, i, status_str, sizeof status_str);

            format(string, sizeof(string), "%s" CAR_CLR_WHITE "%s\t%s\t%s\n",
                string,
                GetVehicleNameByModel(VehicleInfo[playerid][i][vModel]),
                plate_str,
                status_str);
            count++;
        }
        total++;
    }

    if(total == 0) return SendClientMessage(playerid, COLOR_RED, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!");

    if(total > (page + 1) * 10)
        format(string, sizeof(string), "%s" CAR_CLR_PAGE ">>>\t˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\t\n", string);

    if(page > 0)
        format(string, sizeof(string), "%s" CAR_CLR_PAGE "<<<\t˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\t\n", string);

    SetPVarInt(playerid, "CarMenuPage", page);

    new title[72];
    format(title, sizeof title, CAR_DLG_PREFIX "˜˜˜ ˜˜˜˜˜˜˜˜˜");
    ShowPlayerDialog(playerid, DIALOG_MY_CARS, DIALOG_STYLE_TABLIST_HEADERS, title, string, "˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
    return 1;
}

// =============================================================================
// /car helpers ˜ ˜˜˜˜˜˜˜˜ / ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜
// =============================================================================
stock CarSystem_LoadVehicle(playerid, slot, bool:useLast)
{
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(VehicleInfo[playerid][slot][vModel] == 0) return 0;
    if(VehicleInfo[playerid][slot][vFamFleetBorrow])
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ /fm.", "");
        return 0;
    }

    // ˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜.
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(i == slot) continue;
        if(VehicleInfo[playerid][i][vSpawned])
        {
            ShowNotification(playerid, 0, 5, 0, 0, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜.", "");
            return 0;
        }
    }

    new Float:x, Float:y, Float:z, Float:a;
    if(useLast && VehicleInfo[playerid][slot][vLastValid])
    {
        x = VehicleInfo[playerid][slot][vLastPos][0];
        y = VehicleInfo[playerid][slot][vLastPos][1];
        z = VehicleInfo[playerid][slot][vLastPos][2];
        a = VehicleInfo[playerid][slot][vLastPos][3];
    }
    else
    {
        x = VehicleInfo[playerid][slot][vPos][0];
        y = VehicleInfo[playerid][slot][vPos][1];
        z = VehicleInfo[playerid][slot][vPos][2];
        a = VehicleInfo[playerid][slot][vPos][3];
    }

    VehicleInfo[playerid][slot][vID] = CreateVehicle(
        VehicleInfo[playerid][slot][vModel], x, y, z, a,
        VehicleInfo[playerid][slot][vColor][0], VehicleInfo[playerid][slot][vColor][1], -1);
    Vehicle_UpdateOwnerCache(VehicleInfo[playerid][slot][vID], playerid, slot);

    VehicleInfo[playerid][slot][vStrobState] = false;
    VehicleInfo[playerid][slot][Dalniysvet]  = false;
    VehicleInfo[playerid][slot][vPnevmoMode] = 0;
    VehicleInfo[playerid][slot][vHydraState] = false;

    CarSystem_InitSpawnedVehicle(VehicleInfo[playerid][slot][vID]);

    if(VehicleInfo[playerid][slot][vWheel] > 0)
        AddVehicleComponent(VehicleInfo[playerid][slot][vID], VehicleInfo[playerid][slot][vWheel]);

    if(VehicleInfo[playerid][slot][vNitro] > 0)
        AddVehicleComponent(VehicleInfo[playerid][slot][vID], 1007 + VehicleInfo[playerid][slot][vNitro]);

    VehicleInfo[playerid][slot][vSpawned] = true;
    VehicleInfo[playerid][slot][vLaunchControlOn] = false;

    BroadcastPersonalVehicleVisuals(VehicleInfo[playerid][slot][vID], playerid, slot);
    CarSystem_QueueWheelRefresh(VehicleInfo[playerid][slot][vID], playerid, slot);
    SetTimerEx("Timer_ReapplyCarVisuals", 200, false, "iii", VehicleInfo[playerid][slot][vID], playerid, slot);
    SetTimerEx("Timer_ReapplyCarVisuals", 550, false, "iii", VehicleInfo[playerid][slot][vID], playerid, slot);

    if(VehicleInfo[playerid][slot][vPlateType] > 0 && strlen(VehicleInfo[playerid][slot][vPlateNumber]) > 0)
    {
        SetVehicleNumberPlateEx(
            VehicleInfo[playerid][slot][vID],
            VehicleInfo[playerid][slot][vPlateType],
            VehicleInfo[playerid][slot][vPlateNumber],
            VehicleInfo[playerid][slot][vPlateRegion]);
    }

    SetVehicleHealth(VehicleInfo[playerid][slot][vID], VehicleInfo[playerid][slot][vHealth]);

    SendClientMessage(playerid, -1,
        useLast ? "{FFFF00}| {FFFFFF}˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜."
                : "{FFFF00}| {FFFFFF}˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜.");
    return 1;
}

stock CarSystem_UnloadVehicle(playerid, slot)
{
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(!VehicleInfo[playerid][slot][vSpawned]) return 0;

    // ˜˜˜˜˜˜˜˜˜ "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜" ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜.
    if(VehicleInfo[playerid][slot][vID] != INVALID_VEHICLE_ID)
    {
        new Float:x, Float:y, Float:z, Float:a;
        GetVehiclePos(VehicleInfo[playerid][slot][vID], x, y, z);
        GetVehicleZAngle(VehicleInfo[playerid][slot][vID], a);

        VehicleInfo[playerid][slot][vLastPos][0] = x;
        VehicleInfo[playerid][slot][vLastPos][1] = y;
        VehicleInfo[playerid][slot][vLastPos][2] = z;
        VehicleInfo[playerid][slot][vLastPos][3] = a;
        VehicleInfo[playerid][slot][vLastValid]  = true;

        new q[256];
        mysql_format(db_handle, q, sizeof q,
            "UPDATE `ownable_cars` SET `last_x`=%f, `last_y`=%f, `last_z`=%f, `last_a`=%f, `last_valid`=1 WHERE `id`=%d",
            x, y, z, a, VehicleInfo[playerid][slot][vDBID]);
        mysql_tquery(db_handle, q);

        Fuel_FlushVehicleImmediate(playerid, slot);
        Tune_FlushVehiclePaintToDb(playerid, slot);

        DestroyVehicle(VehicleInfo[playerid][slot][vID]);
        VehicleInfo[playerid][slot][vID] = INVALID_VEHICLE_ID;
    }

    VehicleInfo[playerid][slot][vSportA]     = false;
    VehicleInfo[playerid][slot][vDriftA]     = false;
    VehicleInfo[playerid][slot][vComfortA]   = false;
    VehicleInfo[playerid][slot][vSportPlusA] = false;
    VehicleInfo[playerid][slot][vSpawned]    = false;
    VehicleInfo[playerid][slot][vStrobState] = false;
    VehicleInfo[playerid][slot][Dalniysvet]  = false;
    VehicleInfo[playerid][slot][vPnevmoMode] = 0;
    VehicleInfo[playerid][slot][vHydraState] = false;

    SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");
    return 1;
}

stock CarSell_CountOwned(playerid)
{
    new count = 0;
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
        if(VehicleInfo[playerid][i][vModel] != 0) count++;
    return count;
}

stock CarSell_GetSellPrice(playerid, slot)
{
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(VehicleInfo[playerid][slot][vModel] == 0) return 0;

    new model = VehicleInfo[playerid][slot][vModel];
    new gos = Tune_ResolveVehicleGosCost(playerid, slot, model);
    if(gos < 1) gos = GetVehiclePriceByModel(model);
    if(gos < 1) gos = VehicleInfo[playerid][slot][vPrice];
    if(gos < 1) return 0;

    return (gos * SELL_CAR_GOV_PERCENT) / 100;
}

stock CarSell_FindDriverSlot(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid)) return -1;
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return -1;

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return -1;
    if(ScooterRent_IsPlayerVehicle(playerid, vehicleid)) return -1;

    new slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot < 0) return -1;
    if(VehicleInfo[playerid][slot][vModel] == 0) return -1;
    if(VehicleInfo[playerid][slot][vFamFleetBorrow]) return -2;
    if(!VehicleInfo[playerid][slot][vSpawned]) return -1;
    return slot;
}

stock CarSell_ShowConfirmDialog(playerid, slot)
{
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;

    new model = VehicleInfo[playerid][slot][vModel];
    new sell_price = CarSell_GetSellPrice(playerid, slot);
    if(sell_price < 1)
    {
        SendClientMessage(playerid, COLOR_GREY, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");
        return 0;
    }

    new car_num = VehicleInfo[playerid][slot][vDBID];
    if(car_num <= 0) car_num = slot + 1;

    new vname[48], body[640];
    format(vname, sizeof(vname), "%s", GetVehicleNameByModel(model));
    format(body, sizeof(body),
        "{FFFFFF}| ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜:\t{FFFF00}%s (˜%d)\n\
        {FFFFFF}| ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜:\t{FFFF00}%d\n\n\
        {FFFFFF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜\n\
        {FFFFFF}˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜: {E0584B}\"/sellmycar\".\n\n\
        {FFFFFF}˜˜ ˜˜˜˜˜˜˜, ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜\n\
        {FFFFFF}˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜?",
        vname, car_num, sell_price);

    SetPVarInt(playerid, "SellCarSlot", slot);
    ShowPlayerDialog(playerid, AT_DIALOG_SELL_CAR_GOV, DIALOG_STYLE_MSGBOX,
        "{E0584B}BR BLACK STUDIO{FFFFFF} -> ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜",
        body, "˜˜", "˜˜˜˜˜˜");
    return 1;
}

stock CarSell_Complete(playerid, slot)
{
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(Player[playerid][pID] <= 0) return 0;
    if(VehicleInfo[playerid][slot][vModel] == 0) return 0;
    if(VehicleInfo[playerid][slot][vFamFleetBorrow]) return 0;

    new dbid = VehicleInfo[playerid][slot][vDBID];
    new model = VehicleInfo[playerid][slot][vModel];
    new sell_price = CarSell_GetSellPrice(playerid, slot);
    if(sell_price < 1) return 0;

    if(IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleID(playerid) == VehicleInfo[playerid][slot][vID])
        RemovePlayerFromVehicle(playerid);

    if(VehicleInfo[playerid][slot][vSpawned])
    {
        new vid = VehicleInfo[playerid][slot][vID];
        if(vid != INVALID_VEHICLE_ID && GetVehicleModel(vid) > 0)
        {
            Fuel_FlushVehicleImmediate(playerid, slot);
            Tune_FlushVehiclePaintToDb(playerid, slot);
            DestroyVehicle(vid);
            InvalidateVehicleOwnerCache(vid);
        }
    }

    if(dbid > 0)
    {
        new q[220];
        mysql_format(db_handle, q, sizeof(q),
            "DELETE FROM `family_fleet` WHERE `car_db_id`=%d", dbid);
        mysql_tquery(db_handle, q);
        Family_FleetDeleteFamilyCarsRow(dbid);
        mysql_format(db_handle, q, sizeof(q),
            "DELETE FROM `ownable_cars` WHERE `id`=%d AND `owner_id`=%d LIMIT 1",
            dbid, Player[playerid][pID]);
        mysql_tquery(db_handle, q);
    }

    new vname[48];
    format(vname, sizeof(vname), "%s", GetVehicleNameByModel(model));
    ResetPlayerVehicleSlot(playerid, slot);
    Tune_ClearStylingSession(playerid);
    gShinkaStartWheel[playerid] = 0;
    DeletePVar(playerid, "SellCarSlot");

    GivePlayerMoneyEx(playerid, sell_price);

    new msg[160];
    format(msg, sizeof(msg), "{66FF66}˜˜ ˜˜˜˜˜˜˜ %s ˜˜˜˜˜˜˜˜˜˜˜ ˜˜ %d ˜˜˜.", vname, sell_price);
    SendClientMessage(playerid, COLOR_WHITE, msg);
    return 1;
}

stock bool:CarSell_OnDialogResponse(playerid, dialogid, response)
{
    if(dialogid != AT_DIALOG_SELL_CAR_GOV) return false;

    if(!response)
    {
        DeletePVar(playerid, "SellCarSlot");
        return true;
    }

    new slot = GetPVarInt(playerid, "SellCarSlot");
    DeletePVar(playerid, "SellCarSlot");

    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES || VehicleInfo[playerid][slot][vModel] == 0)
    {
        SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜.");
        return true;
    }

    if(!VehicleInfo[playerid][slot][vSpawned] || VehicleInfo[playerid][slot][vID] == INVALID_VEHICLE_ID)
    {
        SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ (/car), ˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ /sellcar.");
        return true;
    }

    CarSell_Complete(playerid, slot);
    return true;
}

CMD:sellcar(playerid, params[])
{
    #pragma unused params

    if(Player[playerid][pID] <= 0)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜.");

    new slot = CarSell_FindDriverSlot(playerid);
    if(slot == -2)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜.");

    if(slot < 0)
    {
        if(CarSell_CountOwned(playerid) == 0)
            return ShowNotification(playerid, 2, 6, 0, 0, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜", "");
        return ShowNotification(playerid, 2, 6, 0, 0,
            "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ (/car), ˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜ /sellcar", "");
    }

    return CarSell_ShowConfirmDialog(playerid, slot);
}

stock ShowCarActionMenu(playerid, car_slot)
{
    // listitem: 0 GPS, 1 ˜˜˜˜˜˜˜˜, 2 ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜, 3 ˜˜˜˜˜˜˜˜˜, 4 ˜˜˜˜˜˜˜˜˜,
    // 5 ˜˜˜˜˜ ˜˜˜˜, 6 ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ (˜˜˜˜˜˜ ˜˜˜˜˜).
    new menu_str[640];
    new bool:spawned = VehicleInfo[playerid][car_slot][vSpawned];
    new bool:has_plate = (VehicleInfo[playerid][car_slot][vPlateType] > 0 &&
                         strlen(VehicleInfo[playerid][car_slot][vPlateNumber]) > 0);
    new bool:has_last  = VehicleInfo[playerid][car_slot][vLastValid];

    new header[160];
    CarDialog_FormatVehicleHeader(playerid, car_slot, header, sizeof header);

    strcat(menu_str, "˜˜˜˜˜˜˜\t˜˜˜˜˜˜˜˜\n");

    format(menu_str, sizeof menu_str, "%s%s\t%s\n", menu_str,
        spawned ? (CAR_CLR_LABEL "˜˜˜˜˜˜˜˜ ˜˜ GPS") : (CAR_CLR_DIM "˜˜˜˜˜˜˜˜ ˜˜ GPS"),
        spawned ? (CAR_CLR_DESC "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜") : (CAR_CLR_DIM "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜"));

    format(menu_str, sizeof menu_str, "%s%s\t%s\n", menu_str,
        !spawned ? (CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜") : (CAR_CLR_DIM "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜"),
        !spawned ? (CAR_CLR_DESC "˜ ˜˜˜˜˜ /park") : (CAR_CLR_DIM "˜˜˜ ˜˜˜˜˜˜˜˜˜"));

    format(menu_str, sizeof menu_str, "%s%s\t%s\n", menu_str,
        (!spawned && has_last) ? (CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜") : (CAR_CLR_DIM "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜"),
        (!spawned && has_last) ? (CAR_CLR_DESC "˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜") :
            (spawned ? (CAR_CLR_DIM "˜˜˜ ˜˜˜˜˜˜˜˜˜") : (CAR_CLR_DIM "˜˜˜ ˜˜˜˜˜˜")));

    format(menu_str, sizeof menu_str, "%s%s\t%s\n", menu_str,
        spawned ? (CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜") : (CAR_CLR_DIM "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜"),
        spawned ? (CAR_CLR_DESC "˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜") : (CAR_CLR_DIM "˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜"));

    format(menu_str, sizeof menu_str, "%s" CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜\t" CAR_CLR_DESC "˜˜˜˜˜˜˜˜˜˜˜˜˜, ˜˜˜˜-˜˜˜˜˜\n", menu_str);

    format(menu_str, sizeof menu_str, "%s%s\t%s\n", menu_str,
        (spawned && has_plate) ? (CAR_CLR_LABEL "˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜") : (CAR_CLR_DIM "˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜"),
        (spawned && has_plate) ? (CAR_CLR_DESC "˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜") :
            (spawned ? (CAR_CLR_DIM "˜˜˜ ˜˜˜. ˜˜˜˜˜") : (CAR_CLR_DIM "˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜")));

    if(Player[playerid][pFamilyId] > 0 && Player[playerid][pFamilyLeader])
    {
        format(menu_str, sizeof menu_str, "%s%s\t%s\n", menu_str,
            CAR_CLR_LABEL "˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜",
            CAR_CLR_DESC "˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜");
    }

    new title[200];
    format(title, sizeof title, CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜˜˜  %s", header);

    ShowPlayerDialog(playerid, DIALOG_CAR_ACTION, DIALOG_STYLE_TABLIST_HEADERS, title, menu_str, "˜˜˜˜˜", "˜˜˜˜˜");
    return 1;
}

stock ShowCarSettingsMenu(playerid, car_slot)
{
    new menu_str[420];
    strcat(menu_str, "˜˜˜˜˜˜˜˜\t˜˜˜˜˜˜˜˜˜\n");

    format(menu_str, sizeof menu_str, "%s" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜\t%s\n", menu_str,
        VehicleInfo[playerid][car_slot][vAutoEngine] ? (CAR_CLR_STATUS "˜˜˜˜˜˜˜˜") : (CAR_CLR_STATUS "˜˜˜˜˜˜˜˜˜"));

    format(menu_str, sizeof menu_str, "%s" CAR_CLR_WHITE "˜˜˜˜-˜˜˜˜˜ ˜˜˜˜˜˜ (40 ˜˜/˜)\t%s", menu_str,
        VehicleInfo[playerid][car_slot][vAutoLock] ? (CAR_CLR_STATUS "˜˜˜˜˜˜˜˜") : (CAR_CLR_STATUS "˜˜˜˜˜˜˜˜˜"));

    new header[160];
    CarDialog_FormatVehicleHeader(playerid, car_slot, header, sizeof header);

    new title[200];
    format(title, sizeof title, CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜˜  %s", header);

    ShowPlayerDialog(playerid, DIALOG_CAR_SETTINGS, DIALOG_STYLE_TABLIST_HEADERS, title, menu_str, "˜˜˜˜˜˜˜˜˜˜˜", "˜˜˜˜˜");
    return 1;
}

