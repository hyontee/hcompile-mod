        Player[targetid][pMuteTime],
        Player[targetid][pJailTime],
        Player[targetid][pWarns]
    );
    return 1;
}

stock MM_ShowPlayerStats(playerid, targetid = -1)
{
    if(targetid == -1) targetid = playerid;
    if(!IsPlayerConnected(targetid)) return 0;

    new stats[1400];
    MM_BuildStatsDialogText(targetid, stats, sizeof(stats));

    ShowPlayerDialog(playerid, AT_DIALOG_STATS, DIALOG_STYLE_MSGBOX,
        "{E0584B}BR BLACK STUDIO{FFFFFF} | ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜",
        stats, "˜˜˜˜˜", "˜˜˜˜˜˜˜");
    SetPVarInt(playerid, "MM_StatsTarget", targetid);
    return 1;
}

stock MM_ShowPassOldDialog(playerid)
{
    ShowPlayerDialog(playerid, AT_DIALOG_MM_PASS_OLD, DIALOG_STYLE_INPUT,
        "{E0584B}BR BLACK STUDIO{FFFFFF} | ˜˜˜˜˜ ˜˜˜˜˜˜",
        "˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜:",
        "˜˜˜˜˜˜˜˜", "˜˜˜˜˜");
    return 1;
}

stock MM_ShowPassNewDialog(playerid)
{
    ShowPlayerDialog(playerid, AT_DIALOG_MM_PASS_NEW, DIALOG_STYLE_INPUT,
        "{E0584B}BR BLACK STUDIO{FFFFFF} | ˜˜˜˜˜ ˜˜˜˜˜˜",
        "˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ (˜˜˜˜˜˜˜ 4 ˜˜˜˜˜˜˜):",
        "˜˜˜˜˜˜˜˜", "˜˜˜˜˜");
