                        "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.");
                    return 1;
                }
                GivePlayerBlackCoin(playerid, -price);
                DonateShop_SendPurchaseResult(playerid, json_packet_data, true,
                    "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜",
                    "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜.");
