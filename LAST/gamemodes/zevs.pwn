                        CarSystem_QueueWheelRefresh(vehicleid_w, playerid, vw);
                        BroadcastPersonalVehicleVisuals(vehicleid_w, playerid, vw);

                        Tune_FillDetal7SuccessJson(playerid, json_packet_data, wheel_item, old_wheel_cat, 24, vw);
                        bought_wheel = 1;
