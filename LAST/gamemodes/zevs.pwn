                    if(raw_sel >= 0) preview_target = Tune_MapPaintSelector(raw_sel);
                }

                new preview_color = Tune_ResolvePacket28PaintColor(json, g_GuiJsonInBuf);
                if(preview_color == 0) preview_color = Tune_LoadPreviewPaintArgb(playerid);

                new veh_pr = GetPlayerVehicleID(playerid);
                new slot_pr = GetPlayerVehicleSlot(playerid, veh_pr);

                if(preview_target >= 0 && slot_pr != -1 && veh_pr != 0 && preview_color != 0)
                {
                    if(preview_target == 0)
                    {
                        preview_color = Tune_NormalizePaintArgb(preview_color);
                        if(preview_color != 0)
                        {
                            Tune_StorePreviewPaintArgb(playerid, preview_color);
                            PV_BcastVehBodyColor(veh_pr, preview_color, playerid, slot_pr);
                        }
                    }
                    else if(preview_target == 1)
                    {
