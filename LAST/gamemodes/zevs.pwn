CMD:freeze(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;
    new targetid, str[128];
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /freeze [id]");
    if(!IsPlayerConnected(targetid)) return 1;
    if(!Admin_CanUsePunishments(playerid)) return 1;
    if(!Admin_CanActOnPlayer(playerid, targetid)) return 1;
    TogglePlayerControllable(targetid, false);
    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.", Player[playerid][pName], playerid);
    SendClientMessage(targetid, ADMIN_COLOR, str);
    format(str, sizeof(str), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d].", Player[targetid][pName], targetid);
    SendClientMessage(playerid, -1, str);
    return 1;
}

