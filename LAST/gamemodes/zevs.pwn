                {
                    dbg_body = VehicleInfo[playerid][dbg_slot][vBodyColor];
                    dbg_disk = VehicleInfo[playerid][dbg_slot][vDiskColor];
                }
                printf("[DEBUG] packet28 t=%d paint_tgt=%d col=%d body=%d disk=%d raw=%.120s",
                    type, color_type, Tune_ResolvePacket28PaintColor(json, g_GuiJsonInBuf), dbg_body, dbg_disk, g_GuiJsonInBuf);
            }
            else
                printf("[DEBUG] paclet 28 t=%d d=%d p=%d detal_id=%d sel=%d", type, json_d_int, json_p_int, detal_id, color_type);
            JSON_SetInt(json_packet_data, "s", 0);
            // PAWN: break ˜˜ switch(type) ˜˜˜˜˜˜: case 28 ˜˜˜˜˜˜ ˜ switch(guiid) ˜ guiid 024; ˜˜˜˜˜˜˜˜˜˜ if/else if.
            if(type == 18 || type == 19)
            {
                // ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ saveCarStatus (19) ˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜.
                JSON_SetInt(json_packet_data, "t", type);
                JSON_SetInt(json_packet_data, "s", 1);
                JSON_SetInt(json_packet_data, "m", GetPlayerMoneyEx(playerid));
                JSON_SetInt(json_packet_data, "dn", GetPlayerBlackCoin(playerid));
            }
            else if(type == 20)
            {
                new vehicleid_c20 = GetPlayerVehicleID(playerid);
                new slot_c20 = GetPlayerVehicleSlot(playerid, vehicleid_c20);
