public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if(GetPVarInt(playerid, "PickupDelay") > gettime()) return 1;
    if(ScooterRent_OnPickup(playerid, pickupid))
    {
        SetPVarInt(playerid, "PickupDelay", gettime() + 2);
        return 1;
    }
    if(LairdBiz_OnPickup(playerid, pickupid)) return 1;
    if(GibddOnPickup(playerid, pickupid))
    {
        SetPVarInt(playerid, "PickupDelay", gettime() + 3);
        return 1;
    }
    if(Hospital_OnPickup(playerid, pickupid))
    {
        SetPVarInt(playerid, "PickupDelay", gettime() + 3);
        return 1;
    }
    if(Fuel_OnCanisterPickup(playerid, pickupid)) return 1;
    if(MinerJob_OnPickup(playerid, pickupid))
    {
        SetPVarInt(playerid, "PickupDelay", gettime() + 5);
        return 1;
    }
    if(Bank_OnPickup(playerid, pickupid))
    {
        SetPVarInt(playerid, "PickupDelay", gettime() + 3);
        return 1;
    }

    for(new i = 0; i < TotalHouses; i++)
    {
        if(_:pickupid == _:HouseInfo[i][hHealthPickup])
        {
            if(GetPVarInt(playerid, "InHouseID") == i && HouseInfo[i][hImprovements] >= 2)
            {
                new ht = HouseInfo[i][hType];
                if(ht < 0 || ht >= MAX_HOUSE_TYPES) ht = 0;
                if(!IsPlayerInRangeOfPoint(playerid, 4.0,
                    HouseInteriors[ht][iHealthX], HouseInteriors[ht][iHealthY], HouseInteriors[ht][iHealthZ]))
                    return 1;

                SetPlayerHealth(playerid, 100.0);
                GameTextForPlayer(playerid, "~b~~h~100 hp", 3000, 1);
            }
            return 1;
        }
        if(_:pickupid == _:HouseInfo[i][hWardrobePickup])
        {
            if(GetPVarInt(playerid, "InHouseID") == i && HouseInfo[i][hOwnerID] == Player[playerid][pID] && HouseInfo[i][hImprovements] >= 5)
            {
                new ht = HouseInfo[i][hType];
                if(ht < 0 || ht >= MAX_HOUSE_TYPES) ht = 0;
                new store_int = HouseInteriors[ht][iStoreInt];
                SetPlayerInterior(playerid, store_int);
                SetPlayerPos(playerid,
                    HouseInteriors[ht][iStoreX], HouseInteriors[ht][iStoreY], HouseInteriors[ht][iStoreZ]);
                SetPlayerVirtualWorld(playerid, House_GetInteriorVW(i));
                Player_FixInteriorWorldLeak(playerid);

                ShowPlayerDialog(playerid, DIALOG_HOUSE_WARDROBE, DIALOG_STYLE_MSGBOX,
                    "{FFCC00}˜˜˜˜",
                    "{FFFFFF}˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜.\n\n{AAAAAA}˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.",
                    "˜˜˜˜˜˜˜", "");
            }
            return 1;
        }
        if(_:pickupid == _:HouseInfo[i][hExitPickup])
        {
            if(GetPVarInt(playerid, "InHouseID") == i)
            {
                SetPVarInt(playerid, "PickupDelay", gettime() + 2);
                House_ExitPlayer(playerid, i);
            }
            return 1;
        }
        if(_:pickupid == _:HouseInfo[i][hPickup])
        {
            SetPVarInt(playerid, "PickupDelay", gettime() + 5);

            if(HouseInfo[i][hOwnerID] == 0)
            {
                if(!RentPay_IsBuyable(HouseInfo[i][hEviction]))
                {
                    new left_sec = HouseInfo[i][hEviction] - gettime();
                    new left_h = left_sec / 3600;
                    new left_m = (left_sec % 3600) / 60;
                    new warn[128];
                    format(warn, sizeof warn, "˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜: %d ˜. %d ˜˜˜.", left_h, left_m);
                    return ShowNotification(playerid, 0, 5, 0, 0, warn, "");
                }
                for(new h = 0; h < TotalHouses; h++)
                {
                    if(HouseInfo[h][hOwnerID] == Player[playerid][pID])
                        return ShowNotification(playerid, 0, 5, 0, 0, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜!", "");
                }
                House_ShowPickupBuyDialog(playerid, i);
            }
            else
            {
                House_ShowPickupEnterDialog(playerid, i);
            }
            return 1;
        }
    }
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(VehicleInfo[playerid][i][vSpawned])
        {
            SendClientMessage(playerid, COLOR_RED, "[˜˜˜˜˜˜˜˜˜] ˜˜˜˜˜˜: ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜ (/car)!");
            return 1;
        }
    }

    if(pickupid == pickup_salon_high)
    {
        p_SalonType[playerid] = 0;
        OpenAutoSalon(playerid);
        SendClientMessage(playerid, -1, "{FFD700}[˜˜˜˜˜˜˜˜˜]{FFFFFF} ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜!");
    }
    else if(pickupid == pickup_salon_medium)
    {
        p_SalonType[playerid] = 1;
        OpenAutoSalon(playerid);
        SendClientMessage(playerid, -1, "{C0C0C0}[˜˜˜˜˜˜˜˜˜]{FFFFFF} ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜!");
    }
    else if(pickupid == pickup_salon_low)
    {
        p_SalonType[playerid] = 2;
        OpenAutoSalon(playerid);
        SendClientMessage(playerid, -1, "{CD7F32}[˜˜˜˜˜˜˜˜˜]{FFFFFF} ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜!");
    }
    return 1;
}

forward OnReferalCheckReg(playerid);
public OnReferalCheckReg(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new rows, fields;
    cache_get_data(rows, fields, db_handle);

    new invite_nick[MAX_PLAYER_NAME];
    invite_nick[0] = EOS;
    GetPVarString(playerid, "auth_ref_pending", invite_nick, sizeof(invite_nick));
    DeletePVar(playerid, "auth_ref_pending");

    if(rows > 0 && strlen(invite_nick) > 0)
    {
        SetPVarString(playerid, "auth_referal", invite_nick);
        Auth_GoRegSkinStep(playerid);
        return 1;
    }

    ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜!", "");
    new Node:res = JSON_Object();
    JSON_SetInt(res, "c", 1);
    OnPacketIncoming(playerid, 38, res);
    JSON_Cleanup(res);
    return 1;
}

forward OnAccountRegister(playerid);
public OnAccountRegister(playerid)
{
    Player[playerid][pID] = cache_insert_id();
    new reg_pass[65];
    if(!Auth_ReadRegPassword(playerid, reg_pass, sizeof(reg_pass)))
        reg_pass[0] = EOS;
    else
        Auth_StoreRegPassword(playerid, reg_pass);

    if(reg_pass[0] != EOS && strlen(reg_pass) >= 4)
    {
        new pass_q[160];
        mysql_format(db_handle, pass_q, sizeof(pass_q),
            "UPDATE `players` SET `password`='%e' WHERE `id`=%d LIMIT 1",
            reg_pass, Player[playerid][pID]);
        mysql_tquery(db_handle, pass_q, "", "");
    }
    else
        printf("[Auth] WARN: account %s (id=%d) registered without password", Player[playerid][pName], Player[playerid][pID]);

    Player[playerid][pBusiness] = -1;
    Player[playerid][pHealth] = 100.0;
    Player[playerid][pArmour] = 0.0;
    SetPVarInt(playerid, "auth_first_play", 1);

    Player[playerid][pLevel] = 1;
    Player[playerid][pMoney] = REG_BONUS_MONEY;
    Player[playerid][pBC] = REG_BONUS_BC;
    Player[playerid][pDonate] = REG_BONUS_BC;
    Player[playerid][pCountTodayCases] = 0;
    Player[playerid][pCountBomjCases] = REG_BONUS_BOMJ_CASES;
    Player[playerid][pCountStandartCases] = 0;
    Player[playerid][pCountCarCases] = REG_BONUS_CAR_CASES;
    Player[playerid][pCountOsobiyCases] = 0;
    Player[playerid][pAdminLvl] = 0;
    Player[playerid][pAdminPass] = 0;
    format(Player[playerid][pAdminPrefix], 32, "None");

    Player[playerid][pVipType] = REG_BONUS_VIP_TYPE;
    Player[playerid][pVipTime] = REG_BONUS_VIP_TIME;
    Player[playerid][pCarExtraSlots] = 0;
    Admin_ClearBanFields(playerid);
    Player[playerid][pMuteTime] = 0;
    Player[playerid][pJailTime] = 0;
    Player[playerid][pWarns] = 0;

    ResetPlayerMoney(playerid);
    GivePlayerMoney(playerid, Player[playerid][pMoney]);
    SetPlayerColor(playerid, COLOR_WHITE);

    Satiety_OnRegister(playerid);
    SavePlayerAccount(playerid);

    printf("[MySQL] ˜˜˜˜˜˜˜ %s ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜. ID: %d (˜˜˜˜˜: %d ˜˜˜., %d BC, VIP Gold %d ˜˜.)",
        Player[playerid][pName], Player[playerid][pID], REG_BONUS_MONEY, REG_BONUS_BC, REG_BONUS_VIP_DAYS);
    Calendar_Load(playerid);

    if(GetPVarInt(playerid, "auth_reg_finish"))
        SetTimerEx("Auth_TryFinishRegistration", 100, false, "i", playerid);
    return 1;
}

forward OnAccountLoad(playerid);

stock bool:Auth_ApplyAccountFromCache(playerid)
{
    new rows, fields;
    cache_get_data(rows, fields, db_handle);
    if(rows <= 0) return false;

    Player[playerid][pID] = cache_get_field_content_int(0, "id", db_handle);
    cache_get_field_content(0, "password", Player[playerid][pPassword], db_handle, 65);
    Player[playerid][pBusiness] = cache_get_field_content_int(0, "business", db_handle);
    if(Player[playerid][pBusiness] < 0 || Player[playerid][pBusiness] >= MAX_BUSINESS)
        Player[playerid][pBusiness] = -1;
    else if(g_business_loaded > 0 && (Player[playerid][pBusiness] >= g_business_loaded || GetBusinessData(Player[playerid][pBusiness], B_OWNER_ID) != Player[playerid][pID]))
    {
        Player[playerid][pBusiness] = -1;
        new fixb[96];
        mysql_format(db_handle, fixb, sizeof fixb, "UPDATE `players` SET `business`=-1 WHERE `id`=%d LIMIT 1", Player[playerid][pID]);
        mysql_tquery(db_handle, fixb, "", "");
    }
    Player[playerid][pLevel] = cache_get_field_content_int(0, "level", db_handle);
    Player[playerid][pSkin] = cache_get_field_content_int(0, "skin", db_handle);
    Player[playerid][pMoney] = cache_get_field_content_int(0, "money", db_handle);
    Player[playerid][pBank] = cache_get_field_content_int(0, "bank", db_handle);
    Bank_LoadExtraAccounts(playerid);
    Player[playerid][pDonate] = cache_get_field_content_int(0, "donate", db_handle);
    if(Player[playerid][pDonate] == 0)
        Player[playerid][pDonate] = cache_get_field_content_int(0, "bc", db_handle);
    Player[playerid][pBC] = Player[playerid][pDonate];
    SyncPlayerBlackCoin(playerid);
    Player[playerid][pCountTodayCases] = cache_get_field_content_int(0, "counttodaycases", db_handle);
    Player[playerid][pCountBomjCases] = cache_get_field_content_int(0, "countbomjcases", db_handle);
    Player[playerid][pCountStandartCases] = cache_get_field_content_int(0, "countstandartcases", db_handle);
    Player[playerid][pCountCarCases] = cache_get_field_content_int(0, "countcarcases", db_handle);
    Player[playerid][pCountOsobiyCases] = cache_get_field_content_int(0, "countosobiycases", db_handle);
    Player[playerid][pSimCard] = cache_get_field_content_int(0, "sim_card", db_handle);
    Player[playerid][pPhoneOwned] = (cache_get_field_content_int(0, "phone_owned", db_handle) != 0);
    Phone_LoadActiveSim(playerid);
    Player[playerid][pVipType] = cache_get_field_content_int(0, "vip_type", db_handle);
    Player[playerid][pVipTime] = cache_get_field_content_int(0, "vip_time", db_handle);
    Player[playerid][pLicA] = cache_get_field_content_int(0, "lic_a", db_handle);
    Player[playerid][pLicB] = cache_get_field_content_int(0, "lic_b", db_handle);
    Player[playerid][pLicC] = cache_get_field_content_int(0, "lic_c", db_handle);
    Player[playerid][pLicD] = cache_get_field_content_int(0, "lic_d", db_handle);
    Player[playerid][pLicWeapon] = cache_get_field_content_int(0, "lic_weapon", db_handle);
    Player[playerid][pLicWater] = cache_get_field_content_int(0, "lic_water", db_handle);
    Player[playerid][pCarExtraSlots] = cache_get_field_content_int(0, "car_extra_slots", db_handle);
    if(Player[playerid][pCarExtraSlots] < 0) Player[playerid][pCarExtraSlots] = 0;
    Player[playerid][pLastSpawnX] = cache_get_field_content_float(0, "spawn_last_x", db_handle);
    Player[playerid][pLastSpawnY] = cache_get_field_content_float(0, "spawn_last_y", db_handle);
    Player[playerid][pLastSpawnZ] = cache_get_field_content_float(0, "spawn_last_z", db_handle);
    Player[playerid][pLastSpawnA] = cache_get_field_content_float(0, "spawn_last_a", db_handle);
    Player[playerid][pLastSpawnValid] = (cache_get_field_content_int(0, "spawn_last_valid", db_handle) != 0);
    Hospital_SanitizePersistedSpawnPos(playerid);
    Player[playerid][pHospitalUnfinished] = cache_get_field_content_int(0, "hospital_unfinished", db_handle);
    if(Player[playerid][pHospitalUnfinished] != 1)
        Player[playerid][pHospitalUnfinished] = 0;
    Player[playerid][pHealth] = cache_get_field_content_float(0, "player_hp", db_handle);
    Player[playerid][pArmour] = cache_get_field_content_float(0, "player_armour", db_handle);
    if(Player[playerid][pHospitalUnfinished] == 1 && Player[playerid][pHealth] >= 99.5)
        Player[playerid][pHealth] = 10.0;
    if(Player[playerid][pHealth] < 1.0 && Player[playerid][pHospitalUnfinished] != 1)
        Player[playerid][pHealth] = 100.0;
    if(Player[playerid][pHealth] > 100.0)
        Player[playerid][pHealth] = 100.0;
    if(Player[playerid][pArmour] < 0.0)
        Player[playerid][pArmour] = 0.0;
    if(Player[playerid][pArmour] > 100.0)
        Player[playerid][pArmour] = 100.0;
    printf("[Auth] %s vitals: hp=%.1f armour=%.1f hospital_unfinished=%d",
        Player[playerid][pName], Player[playerid][pHealth], Player[playerid][pArmour], Player[playerid][pHospitalUnfinished]);
    Player[playerid][pMedCard] = cache_get_field_content_int(0, "med_card", db_handle);
    Player[playerid][pMedCardReadyAt] = cache_get_field_content_int(0, "med_card_ready_at", db_handle);
    Player[playerid][pMedQuizFailUntil] = cache_get_field_content_int(0, "med_quiz_fail_until", db_handle);
    Player[playerid][pHospitalFastHealUntil] = cache_get_field_content_int(0, "hospital_fast_heal_until", db_handle);
    Player[playerid][pMedCardIssuedAt] = cache_get_field_content_int(0, "med_card_issued_at", db_handle);
    Player[playerid][pMedCardExpiresAt] = cache_get_field_content_int(0, "med_card_expires_at", db_handle);
    Player[playerid][pMedCardIssuerBranch] = cache_get_field_content_int(0, "med_card_issuer_branch", db_handle);
    if(Player[playerid][pMedCard] != 1) Player[playerid][pMedCard] = 0;
    if(Player[playerid][pMedCardIssuerBranch] < 0 || Player[playerid][pMedCardIssuerBranch] >= HOSPITAL_BRANCH_COUNT)
        Player[playerid][pMedCardIssuerBranch] = -1;

    if(Player[playerid][pHospitalFastHealUntil] <= 0)
    {
        new old_fast = cache_get_field_content_int(0, "hospital_fast_heal", db_handle);
        if(old_fast == 1)
            Player[playerid][pHospitalFastHealUntil] = gettime() + (7 * 86400);
    }

    if(Player[playerid][pMedCard] == 1)
    {
        if(Player[playerid][pMedCardExpiresAt] <= 0 && Player[playerid][pMedCardIssuedAt] > 0)
            Player[playerid][pMedCardExpiresAt] = Player[playerid][pMedCardIssuedAt] + (30 * 86400);
        if(Player[playerid][pMedCardExpiresAt] > 0 && gettime() >= Player[playerid][pMedCardExpiresAt])
        {
            Player[playerid][pMedCard] = 0;
            Player[playerid][pMedCardExpiresAt] = 0;
        }
    }
    SetPVarInt(playerid, "player_dust", cache_get_field_content_int(0, "dust", db_handle));
    Player[playerid][pAdminLvl] = cache_get_field_content_int(0, "admlvl", db_handle);
    Player[playerid][pAdminPass] = cache_get_field_content_int(0, "admpass", db_handle);
    cache_get_field_content(0, "admprefix", Player[playerid][pAdminPrefix], db_handle, 32);
    BR_DbToGame(Player[playerid][pAdminPrefix], 32);

    Player[playerid][pGiftDelay] = cache_get_field_content_int(0, "giftdelay", db_handle);

    Player[playerid][pMuteTime] = cache_get_field_content_int(0, "mute_time", db_handle);
    Player[playerid][pJailTime] = cache_get_field_content_int(0, "jail_time", db_handle);
    Player[playerid][pWarns] = cache_get_field_content_int(0, "warns", db_handle);
    Player[playerid][pBanTime] = cache_get_field_content_int(0, "ban_time", db_handle);
    Player[playerid][pBanStart] = cache_get_field_content_int(0, "ban_start", db_handle);
    Player[playerid][pBanDays] = cache_get_field_content_int(0, "ban_days", db_handle);
    cache_get_field_content(0, "ban_reason", Player[playerid][pBanReason], db_handle, 64);
    cache_get_field_content(0, "ban_admin", Player[playerid][pBanAdmin], db_handle, 24);
    BR_DbToGame(Player[playerid][pBanReason], 64);
    BR_DbToGame(Player[playerid][pBanAdmin], 24);

    Satiety_OnAccountLoaded(playerid, cache_get_field_content_int(0, "satiety", db_handle));

    return true;
}

public OnAccountLoad(playerid)
{
    if(!Auth_ApplyAccountFromCache(playerid))
    {
        Auth_OnWrongPassword(playerid);
        return 1;
    }

    if(Admin_SyncBanOnLogin(playerid))
    {
        Auth_HandleAccountBanned(playerid);
        return 1;
    }

    ContinueAccountLoadAfterLogin(playerid);
    return 1;
}

public ContinueAccountLoadAfterLogin(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    Player[playerid][pLoginAttempts] = 0;
    printf("[Auth] Login OK: %s (id=%d)", Player[playerid][pName], Player[playerid][pID]);
    Auth_SendClientLoginDone(playerid);

    new q[256];
    mysql_format(db_handle, q, sizeof(q),
        "SELECT * FROM `ownable_cars` WHERE `owner_id` = %d\
         AND `id` NOT IN (SELECT `car_db_id` FROM `family_fleet` WHERE `car_db_id` > 0)",
        Player[playerid][pID]);
    mysql_tquery(db_handle, q, "LoadPlayerVehicles", "i", playerid);

    new inv_query[128];
    mysql_format(db_handle, inv_query, sizeof(inv_query), "SELECT * FROM `inventory` WHERE `uid` = %d", Player[playerid][pID]);
    mysql_tquery(db_handle, inv_query, "LoadPlayerInventory", "i", playerid);

    Calendar_Load(playerid);
    SetPlayerColor(playerid, COLOR_WHITE);

    ChiefDoctor_TickPlayer(playerid);
    Satiety_ResetPosition(playerid);
    SendClientMessage(playerid, 0x66CC66FF, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");
    SetPVarInt(playerid, "spawn_wait_fam", 1);
    Family_DB_LoadMember(playerid);
    SetTimerEx("SpawnLoc_FallbackOpenAfterFam", 3500, false, "i", playerid);
    return 1;
}

forward GiftTimer();
public GiftTimer()
{
    for(new i = GetPlayerPoolSize(); i >= 0; i--)
    {
        if(!IsPlayerConnected(i) || Player[i][pID] == 0) continue;

        if(Player[i][pGiftDelay] > 0)
        {
            Player[i][pGiftDelay] --;
        }
    }
    Family_MuteSecondTick();
    return 1;
}

