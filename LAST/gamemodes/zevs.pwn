stock CarSystem_IsPersonalGarageSlot(playerid, slot)
{
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return false;
    if(VehicleInfo[playerid][slot][vModel] == 0) return false;
    if(VehicleInfo[playerid][slot][vFamFleetBorrow]) return false;
    return true;
}
