stock Inv_GetAccessoryBoneByModel(modelid)
{
    if(modelid <= 0) return 0;
    for(new i = 0; i < sizeof(g_AccessoryBoneByModel); i++)
    {
        if(g_AccessoryBoneByModel[i][0] == modelid)
            return g_AccessoryBoneByModel[i][1];
    }
    switch(modelid)
    {
        case 907, 908, 909, 912, 916, 926, 918: return 1;
        case 910, 914, 919, 921, 923, 915, 917, 922, 924, 925, 911, 913, 920, 939: return 2;
    }
    return 0;
}

stock Inv_GetCatalogRawModel(catalog_id)
{
    catalog_id = Inv_ClientCatalogId(catalog_id);
    if(catalog_id <= 0) return 0;
    for(new i = 0; i < INV_CATALOG_ROWS; i++)
    {
        if(InventoryItems[i][0] == catalog_id)
            return InventoryItems[i][1];
    }
    return 0;
}

stock bool:Inv_IsClientPlaceholderModel(modelid)
{
    return (modelid >= 18600 && modelid <= 19000);
}

