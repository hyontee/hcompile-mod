                    JSON_GetInt(json, "t", pl_type);
            }
            if(pl_type != -1)
                Trade_OnPlayersListPacket(playerid, g_GuiJsonInBuf, pl_type);
            JSON_Cleanup(json);
            return 1;
        }
        case 27:
{
    new vehicleid = GetPlayerVehicleID(playerid);
    new type = -1;
    new owner = -1, slot = -1;
    if(JSON_GetType(json, "t") != JSON_NODE_NULL)
        JSON_GetInt(json, "t", type);

    if(type < 0)
    {
        Radial_OpenMenu(playerid);
        JSON_Cleanup(json);
        return 1;
    }

    new Node:json_radial_data = JSON_Object();
    JSON_SetInt(json_radial_data, "t", type);

    if(type == 1)
    {
        callcmd::park(playerid, "");
        JSON_SetInt(json_radial_data, "s", 1);
    }
    else if(type == 3)
    {
        callcmd::lk(playerid);
        if(vehicleid == INVALID_VEHICLE_ID)
        {
            for(new i = 1, j = GetVehiclePoolSize(); i <= j; i++)
            {
                if(!GetVehicleModel(i)) continue;
                new Float:pos[3];
                GetVehiclePos(i, pos[0], pos[1], pos[2]);
                if(IsPlayerInRangeOfPoint(playerid, 4.0, pos[0], pos[1], pos[2])) { vehicleid = i; break; }
            }
        }
        if(vehicleid != INVALID_VEHICLE_ID)
        {
            new engine, lights, alarm, doors, bonnet, boot, objective;
            GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
            JSON_SetInt(json_radial_data, "s", (doors == VEHICLE_PARAMS_ON) ? 1 : 0);
        }
    }
    else if(type == 6)
    {
        callcmd::e(playerid, "");
        if(vehicleid != INVALID_VEHICLE_ID)
        {
            new engine, lights, alarm, doors, bonnet, boot, objective;
            GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
            JSON_SetInt(json_radial_data, "s", (engine == VEHICLE_PARAMS_ON) ? 1 : 0);
        }
    }
    else if(type == 5)
    {
        if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleOwnerSlot(vehicleid, owner, slot))
            JSON_SetInt(json_radial_data, "s", 0);
        else if(VehicleInfo[owner][slot][vLaunchControl] <= 0)
        {
            Tune_NotifyNotOwned(playerid);
            JSON_SetInt(json_radial_data, "s", 0);
        }
        else
        {
            new bool:lc_on = VehToggleFlag(owner, slot, VF_LAUNCH_ON);
            LaunchControl_OnRadialUse(playerid, vehicleid, owner, slot, lc_on);
            JSON_SetInt(json_radial_data, "s", lc_on ? 1 : 0);
        }
    }
    else if(type == 14)
    {
        callcmd::l(playerid);
        if(vehicleid != INVALID_VEHICLE_ID)
        {
            new engine, lights, alarm, doors, bonnet, boot, objective;
            GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
            JSON_SetInt(json_radial_data, "s", (lights == VEHICLE_PARAMS_ON) ? 1 : 0);
        }
    }
    else if(type == 13)
    {
        if(vehicleid != INVALID_VEHICLE_ID && GetVehicleOwnerSlot(vehicleid, owner, slot))
        {
            if(VehicleInfo[owner][slot][vDalniysvet] <= 0)
            {
                Tune_NotifyNotOwned(playerid);
                JSON_SetInt(json_radial_data, "s", 0);
            }
            else
            {
                new bool:dalniy_on = VehToggleFlag(owner, slot, VF_DALNIY_ON);
                BroadcastVehicleDlaniy(vehicleid, dalniy_on ? 1 : 0);
                JSON_SetInt(json_radial_data, "s", dalniy_on ? 1 : 0);
            }
        }
        else JSON_SetInt(json_radial_data, "s", 0);
    }
    else if(type == 12)
    {
        if(vehicleid != INVALID_VEHICLE_ID && GetVehicleOwnerSlot(vehicleid, owner, slot))
        {
            if(VehicleInfo[owner][slot][vNeonMain] == 0 && VehicleInfo[owner][slot][vNeon1] == 0 && VehicleInfo[owner][slot][vNeon2] == 0)
            {
                Tune_NotifyNotOwned(playerid);
                JSON_SetInt(json_radial_data, "s", 0);
            }
            else
            {
                new bool:neon_on = VehToggleFlag(owner, slot, VF_NEON_ON);
                BroadcastVehicleNeon(vehicleid, owner, slot);
                JSON_SetInt(json_radial_data, "s", neon_on ? 1 : 0);
            }
        }
        else JSON_SetInt(json_radial_data, "s", 0);
    }
    else if(type == 15)
    {
        if(vehicleid != INVALID_VEHICLE_ID && GetVehicleOwnerSlot(vehicleid, owner, slot) && VehicleInfo[owner][slot][vStrob] >= 0)
        {
            new bool:strob_on = VehToggleFlag(owner, slot, VF_STROB_ON);
            JSON_SetInt(json_radial_data, "s", _:strob_on);
            BroadcastVehicleStroboscope(vehicleid, owner, slot);
        }
        else JSON_SetInt(json_radial_data, "s", 0);
    }
    else if(type >= RADIAL_PNEVMO_MIN && type <= RADIAL_PNEVMO_MAX)
    {
        if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleOwnerSlot(vehicleid, owner, slot) || VehicleInfo[owner][slot][vPnevmo] <= 0)
        {
            Tune_NotifyNotOwned(playerid);
            JSON_SetInt(json_radial_data, "s", 0);
        }
        else
        {
            new cur_mode = VehicleInfo[owner][slot][vPnevmoMode];
            new active = 0;
            if(cur_mode == type)
            {
                Radial_ApplyPnevmoMode(owner, slot, vehicleid, 0);
                Radial_PushPnevmoOffExcept(playerid, -1);
            }
            else
            {
                Radial_ApplyPnevmoMode(owner, slot, vehicleid, type);
                Radial_PushPnevmoOffExcept(playerid, type);
                active = 1;
            }
            JSON_SetInt(json_radial_data, "s", active);
        }
    }
    else if(type == 19)
    {
        if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleOwnerSlot(vehicleid, owner, slot) || VehicleInfo[owner][slot][vHydra] <= 0)
        {
            Tune_NotifyNotOwned(playerid);
            JSON_SetInt(json_radial_data, "s", 0);
        }
        else
        {
            VehicleInfo[owner][slot][vHydraState] = !VehicleInfo[owner][slot][vHydraState];
            BroadcastVehicleHydraulics(vehicleid, owner, slot);
            JSON_SetInt(json_radial_data, "s", VehicleInfo[owner][slot][vHydraState] ? 1 : 0);
        }
    }
    else if(type >= 8 && type <= 11)
    {
        if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleOwnerSlot(vehicleid, owner, slot))
        {
            JSON_SetInt(json_radial_data, "s", 0);
        }
        else
        {
            new bool:has_parts = false;
            if(type == 8) has_parts = bool:IsFullSetInstalled(VehicleInfo[owner][slot][vDrift]);
            else if(type == 9) has_parts = bool:IsFullSetInstalled(VehicleInfo[owner][slot][vComfort]);
            else if(type == 10) has_parts = bool:IsFullSetInstalled(VehicleInfo[owner][slot][vSport]);
            else if(type == 11) has_parts = bool:IsFullSetInstalled(VehicleInfo[owner][slot][vSportPlus]);

            if(!has_parts)
            {
                JSON_SetInt(json_radial_data, "s", 0);
                ShowNotification(playerid, 2, 4, 1, 1, "˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜!", "");
            }
            else
            {
                new bool:active;
                if(type == 8) active = VehGetFlag(owner, slot, VF_DRIFTA);
                else if(type == 9) active = VehGetFlag(owner, slot, VF_COMFORTA);
                else if(type == 10) active = VehGetFlag(owner, slot, VF_SPORTA);
                else if(type == 11) active = VehGetFlag(owner, slot, VF_SPORTPLUSA);

                VehSetFlag(owner, slot, VF_SPORTA, false);
                VehSetFlag(owner, slot, VF_DRIFTA, false);
                VehSetFlag(owner, slot, VF_COMFORTA, false);
                VehSetFlag(owner, slot, VF_SPORTPLUSA, false);

                for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
                {
                    if(IsPlayerConnected(p)) SetVehicleDriftMode(p, vehicleid, false);
                }

                if(active)
                {
                    ResetVehicleTunePhysics(vehicleid);
                    JSON_SetInt(json_radial_data, "s", 0);
                }
                else
                {
                    new Node:reset_json = JSON_Object();
                    for(new i = 8; i <= 11; i++)
                    {
                        JSON_SetInt(reset_json, "t", i);
                        JSON_SetInt(reset_json, "s", 0);
                        OnPacketIncoming(playerid, 27, reset_json);
                    }
                    JSON_Cleanup(reset_json);

                    if(type == 8)
                    {
                        VehSetFlag(owner, slot, VF_DRIFTA, true);
                        ApplyVehicleTuneMode(vehicleid, TUNE_MODE_DRIFT);
                        SetVehicleDriftMode(playerid, vehicleid, true);
                    }
                    else if(type == 9)
                    {
                        VehSetFlag(owner, slot, VF_COMFORTA, true);
                        ApplyVehicleTuneMode(vehicleid, TUNE_MODE_COMFORT);
                    }
                    else if(type == 10)
                    {
                        VehSetFlag(owner, slot, VF_SPORTA, true);
                        ApplyVehicleTuneMode(vehicleid, TUNE_MODE_SPORT);
                    }
                    else if(type == 11)
                    {
                        VehSetFlag(owner, slot, VF_SPORTPLUSA, true);
                        ApplyVehicleTuneMode(vehicleid, TUNE_MODE_SPORTPLUS);
                    }

                    JSON_SetInt(json_radial_data, "s", 1);
                }
            }
        }
    }

    OnPacketIncoming(playerid, 27, json_radial_data);
    JSON_Cleanup(json_radial_data);
    return 1;
}

case 28:
        {
            new Node:json_packet_data = JSON_Object();
            new outcoming_data[512];

            new type, status, detal_id, color_type;
            new json_d_int = 0, json_p_int = 0;

            JSON_GetInt(json, "t", type);
            if(type != 1 && type != 2 && type != 23)
                JSON_GetInt(json, "d", json_d_int);
            JSON_GetInt(json, "p", json_p_int);
            JSON_GetInt(json, "s", status);
            detal_id = json_p_int;
            if(detal_id == 0 && type != 1 && type != 2 && type != 23) detal_id = json_d_int;
            color_type = Tune_ResolvePacket28ColorType(json, g_GuiJsonInBuf);
            if(type == 1 || type == 2 || type == 23)
            {
                new sync_tgt = Tune_SyncPaintSelPkt(json, playerid, g_GuiJsonInBuf);
                if(sync_tgt >= 0) color_type = sync_tgt;
                new dbg_veh = GetPlayerVehicleID(playerid);
                new dbg_slot = GetPlayerVehicleSlot(playerid, dbg_veh);
