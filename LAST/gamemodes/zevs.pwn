forward ScooterRent_HideExitGui(playerid);
forward bool:ScooterRent_IsInVokzalArea(playerid);
forward ScooterRent_StartExitCountdown(playerid, mode, own_slot);
forward ScooterRent_ShowExitGuiDelayed(playerid);

stock ScooterRent_ResetPlayer(playerid, bool:destroy_vehicle = false)
{
    if(gScooterRentTimer[playerid] != 0)
    {
        KillTimer(gScooterRentTimer[playerid]);
        gScooterRentTimer[playerid] = 0;
    }

    if(destroy_vehicle && gScooterRentVehicle[playerid] != INVALID_VEHICLE_ID)
    {
        if(GetVehicleModel(gScooterRentVehicle[playerid]) != 0) DestroyVehicle(gScooterRentVehicle[playerid]);
    }

    gScooterRentVehicle[playerid] = INVALID_VEHICLE_ID;
    gScooterRentStation[playerid] = -1;
    gScooterRentExitRemain[playerid] = 0;
    gScooterRentTimerMode[playerid] = SCOOTER_TIMER_MODE_NONE;
    gScooterRentOwnSlot[playerid] = -1;
    ScooterRent_HideExitGui(playerid);
    DeletePVar(playerid, "ScooterRentMenu");
    return 1;
}

stock ScooterRent_StartExitCountdown(playerid, mode, own_slot)
{
    if(gScooterRentTimer[playerid] != 0) KillTimer(gScooterRentTimer[playerid]);
    gScooterRentExitRemain[playerid] = SCOOTER_EXIT_TIME_SEC;
    gScooterRentTimerMode[playerid] = mode;
    gScooterRentOwnSlot[playerid] = own_slot;
    gScooterRentTimer[playerid] = SetTimerEx("ScooterRent_ExitTimer", 1000, true, "i", playerid);
    SetTimerEx("ScooterRent_ShowExitGuiDelayed", 450, false, "i", playerid);
    return 1;
}

public ScooterRent_ShowExitGuiDelayed(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(gScooterRentTimerMode[playerid] == SCOOTER_TIMER_MODE_NONE) return 0;
    ScooterRent_ShowExitGui(playerid, gScooterRentExitRemain[playerid]);
    return 1;
}

stock bool:ScooterRent_IsInVokzalArea(playerid)
{
    for(new i = 0; i < SCOOTER_RENT_STATIONS; i++)
    {
        if(gZoneSphereVokzalCar[i] != 0 && IsPlayerInDynamicArea(playerid, gZoneSphereVokzalCar[i]))
            return true;
    }
    return false;
}

stock bool:ScooterRent_IsOurVokzalArea(areaid)
{
    for(new z = 0; z < SCOOTER_RENT_STATIONS; z++)
    {
        if(gZoneSphereVokzalCar[z] != 0 && _:areaid == _:gZoneSphereVokzalCar[z])
            return true;
    }
    return false;
}

// ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜ 30 ˜˜˜.
stock ScooterRent_OnEnterVokzalArea(playerid, areaid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(!ScooterRent_IsOurVokzalArea(areaid)) return 0;
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 0;

    new veh = GetPlayerVehicleID(playerid);
    if(veh == 0) return 0;

    if(gScooterRentVehicle[playerid] != INVALID_VEHICLE_ID && GetVehicleModel(gScooterRentVehicle[playerid]) != 0 && veh == gScooterRentVehicle[playerid])
    {
        ScooterRent_StartExitCountdown(playerid, SCOOTER_TIMER_MODE_RENT, -1);
        return 1;
    }

    for(new s = 0; s < MAX_PLAYER_VEHICLES; s++)
    {
        if(!VehicleInfo[playerid][s][vSpawned]) continue;
        if(VehicleInfo[playerid][s][vID] != veh) continue;
        ScooterRent_StartExitCountdown(playerid, SCOOTER_TIMER_MODE_OWNCAR, s);
        return 1;
    }
    return 0;
}

stock ScooterRent_OnLeaveVokzalArea(playerid, areaid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(!ScooterRent_IsOurVokzalArea(areaid)) return 0;
    if(ScooterRent_IsInVokzalArea(playerid)) return 0;

    if(gScooterRentTimerMode[playerid] != SCOOTER_TIMER_MODE_NONE)
        ScooterRent_HideExitGui(playerid);
    return 1;
}

stock ScooterRent_ShowExitGui(playerid, seconds_left)
{
    new text[160];
    format(text, sizeof text, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜. \n˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ %d ˜˜˜.", seconds_left);

    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 0);
    JSON_SetInt(json, "m", 0);
    JSON_SetString(json, "s", text);
    ShowPlayerGUI(playerid, 39, json);
    JSON_Cleanup(json);
    return 1;
}

stock ScooterRent_HideExitGui(playerid)
{
    new Node:close_json = JSON_Object();
    JSON_SetInt(close_json, "t", 4);
    HidePlayerGUI(playerid, 39, close_json);
    JSON_Cleanup(close_json);
    return 1;
}

stock ScooterRent_GetPrice(playerid, modelid)
{
    new level_price = 0;
    if(Player[playerid][pLevel] > 1) level_price = (Player[playerid][pLevel] - 1) * 200;

    new model_price = GetVehiclePriceByModel(modelid);
    if(model_price <= 0) model_price = 60000; // ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜
    new class_price = model_price / 1000;

    return level_price + class_price;
}

stock ScooterRent_ShowMenu(playerid, station_id)
{
    return ScooterRent_ShowMenuPage(playerid, station_id, 0);
}

stock ScooterRent_MakeRandomPlate(dest[], size = sizeof(dest))
{
    static const letters[] = "ABEKMHOPCTYX";
    format(dest, size, "%03d%c%c%c%02d",
        random(900) + 100,
        letters[random(sizeof(letters) - 1)],
        letters[random(sizeof(letters) - 1)],
        letters[random(sizeof(letters) - 1)],
        random(90) + 10);
    return 1;
}

stock ScooterRent_ShowMenuPage(playerid, station_id, page)
{
    if(page < 0) page = 0;
    SetPVarInt(playerid, "ScooterRentMenu", station_id);
    SetPVarInt(playerid, "ScooterRentPage", page);
    SetPVarInt(playerid, "ScooterRentDialogOpen", 1);
    SetPVarInt(playerid, "ScooterRentDialogCd", gettime() + SCOOTER_RENT_DIALOG_COOLDOWN);

    for(new i = 0; i < 32; i++)
    {
        gScooterRentListType[playerid][i] = 0;
        gScooterRentListSlot[playerid][i] = -1;
    }
    gScooterRentListCount[playerid] = 0;

    new list[2048];
    list = "##\t˜˜˜˜˜˜˜˜\t˜˜˜˜˜\t˜˜˜˜˜˜˜˜\n";

    new rent_price = ScooterRent_GetPrice(playerid, SCOOTER_MODEL_ID);
    new scooter_plate[16];
    ScooterRent_MakeRandomPlate(scooter_plate, sizeof scooter_plate);

    format(list, sizeof list, "%s1.\t" CAR_CLR_WHITE "˜˜˜˜˜˜ (%d ˜˜˜.)\t" CAR_CLR_GOLD "%s\t" CAR_CLR_GOLD "˜˜˜˜˜˜˜˜˜˜\n",
        list, rent_price, scooter_plate);
    gScooterRentListType[playerid][gScooterRentListCount[playerid]] = 1;
    gScooterRentListSlot[playerid][gScooterRentListCount[playerid]] = -1;
    gScooterRentListCount[playerid]++;

    new start = page * SCOOTER_RENT_DIALOG_PAGE_SIZE;
    new total = 0, shown = 0;
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(!CarSystem_IsPersonalGarageSlot(playerid, i)) continue;

        if(total >= start && shown < SCOOTER_RENT_DIALOG_PAGE_SIZE)
        {
            shown++;
            new num = shown + 1;
            new plate[32], status_str[32];
            CarDialog_FormatPlate(playerid, i, plate, sizeof plate);
            if(VehicleInfo[playerid][i][vSpawned])
                format(status_str, sizeof status_str, CAR_CLR_STATUS "˜˜˜ ˜˜˜˜˜˜˜˜");
            else
                format(status_str, sizeof status_str, CAR_CLR_STATUS "˜˜˜˜˜˜˜˜˜ ˜˜");

            format(list, sizeof list, "%s%d.\t" CAR_CLR_WHITE "%s\t%s\t%s\n",
                list,
                num,
                GetVehicleNameByModel(VehicleInfo[playerid][i][vModel]),
                plate,
                status_str);

            gScooterRentListType[playerid][gScooterRentListCount[playerid]] = 2;
            gScooterRentListSlot[playerid][gScooterRentListCount[playerid]] = i;
            gScooterRentListCount[playerid]++;
        }
        total++;
    }

    if(total > (page + 1) * SCOOTER_RENT_DIALOG_PAGE_SIZE)
    {
        format(list, sizeof list, "%s" CAR_CLR_GOLD "˜˜˜˜˜\t\t\t˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\n", list);
        gScooterRentListType[playerid][gScooterRentListCount[playerid]] = 3;
        gScooterRentListSlot[playerid][gScooterRentListCount[playerid]] = -1;
        gScooterRentListCount[playerid]++;
    }
    if(page > 0)
    {
        format(list, sizeof list, "%s" CAR_CLR_GOLD "˜˜˜˜˜\t\t\t˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\n", list);
        gScooterRentListType[playerid][gScooterRentListCount[playerid]] = 4;
        gScooterRentListSlot[playerid][gScooterRentListCount[playerid]] = -1;
        gScooterRentListCount[playerid]++;
    }

    ShowPlayerDialog(playerid, DIALOG_SCOOTER_RENT, DIALOG_STYLE_TABLIST_HEADERS,
        CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜", list, "˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜");
    return 1;
}

stock ScooterRent_GetNearbyStation(playerid)
{
    for(new i = 0; i < SCOOTER_RENT_STATIONS; i++)
    {
        if(IsPlayerInRangeOfPoint(playerid, 6.0,
            gScooterRentStations[i][SR_PICKUP_X],
            gScooterRentStations[i][SR_PICKUP_Y],
            gScooterRentStations[i][SR_PICKUP_Z]))
        {
            return i;
        }
    }
    return -1;
}

stock bool:ScooterRent_IsSpawnBusy(Float:x, Float:y, Float:z)
{
    for(new vid = 1, max_vid = GetVehiclePoolSize(); vid <= max_vid; vid++)
    {
        if(GetVehicleModel(vid) == 0) continue;
        new Float:vx, Float:vy, Float:vz;
        GetVehiclePos(vid, vx, vy, vz);

        new Float:dx = vx - x;
        new Float:dy = vy - y;
        new Float:dz = vz - z;
        if((dx * dx + dy * dy + dz * dz) <= 10.89) return true; // 3.3 * 3.3
    }
    return false;
}

stock ScooterRent_PickSpawn(station_id, &spawn_id)
{
    new start = random(SCOOTER_RENT_SPAWNS_PER_ZONE);
    for(new i = 0; i < SCOOTER_RENT_SPAWNS_PER_ZONE; i++)
    {
        new idx = (start + i) % SCOOTER_RENT_SPAWNS_PER_ZONE;
        if(!ScooterRent_IsSpawnBusy(
            gScooterRentSpawns[station_id][idx][SR_SPAWN_X],
            gScooterRentSpawns[station_id][idx][SR_SPAWN_Y],
            gScooterRentSpawns[station_id][idx][SR_SPAWN_Z]))
        {
            spawn_id = idx;
            return 1;
        }
    }

    spawn_id = random(SCOOTER_RENT_SPAWNS_PER_ZONE);
    return 1;
}

stock ScooterRent_Start(playerid, station_id)
{
    if(gScooterRentVehicle[playerid] != INVALID_VEHICLE_ID && GetVehicleModel(gScooterRentVehicle[playerid]) != 0)
        return ShowNotification(playerid, 2, 5, 0, 1, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜ ˜˜˜: /srent 2", "");

    new price = ScooterRent_GetPrice(playerid, SCOOTER_MODEL_ID);
    if(GetPlayerMoneyEx(playerid) < price)
        return ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");

    new spawn_id;
    ScooterRent_PickSpawn(station_id, spawn_id);

    new vehicleid = CreateVehicle(
        SCOOTER_MODEL_ID,
        gScooterRentSpawns[station_id][spawn_id][SR_SPAWN_X],
        gScooterRentSpawns[station_id][spawn_id][SR_SPAWN_Y],
        gScooterRentSpawns[station_id][spawn_id][SR_SPAWN_Z],
        gScooterRentSpawns[station_id][spawn_id][SR_SPAWN_A],
        6, 6, -1
    );

    if(vehicleid == INVALID_VEHICLE_ID)
        return ShowNotification(playerid, 2, 5, 0, 1, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.", "");

    GivePlayerMoneyEx(playerid, -price);
    gScooterRentVehicle[playerid] = vehicleid;
    gScooterRentStation[playerid] = station_id;
    ScooterRent_StartExitCountdown(playerid, SCOOTER_TIMER_MODE_RENT, -1);

    SetVehicleVirtualWorld(vehicleid, GetPlayerVirtualWorld(playerid));
    PutPlayerInVehicle(playerid, vehicleid, 0);

    Fuel_SendHud(playerid, 40.0);
    SetVehicleSpeedometerInfoFP(playerid, vehicleid, 40.0, 0.0);

    new msg[144];
    format(msg, sizeof(msg), "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ %d ˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ 30 ˜˜˜.", price);
    ShowNotification(playerid, 1, 6, 0, 1, msg, "");
    return 1;
}

stock ScooterRent_DeliverOwnCar(playerid, station_id, slot)
{
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(VehicleInfo[playerid][slot][vModel] == 0) return 0;
    if(VehicleInfo[playerid][slot][vSpawned])
        return ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜.", "");

    new spawn_id;
    ScooterRent_PickSpawn(station_id, spawn_id);

    VehicleInfo[playerid][slot][vPos][0] = gScooterRentSpawns[station_id][spawn_id][SR_SPAWN_X];
    VehicleInfo[playerid][slot][vPos][1] = gScooterRentSpawns[station_id][spawn_id][SR_SPAWN_Y];
    VehicleInfo[playerid][slot][vPos][2] = gScooterRentSpawns[station_id][spawn_id][SR_SPAWN_Z];
    VehicleInfo[playerid][slot][vPos][3] = gScooterRentSpawns[station_id][spawn_id][SR_SPAWN_A];

    new q[256];
    mysql_format(db_handle, q, sizeof q,
        "UPDATE `ownable_cars` SET `x`=%f, `y`=%f, `z`=%f, `a`=%f WHERE `id`=%d",
        VehicleInfo[playerid][slot][vPos][0],
        VehicleInfo[playerid][slot][vPos][1],
        VehicleInfo[playerid][slot][vPos][2],
        VehicleInfo[playerid][slot][vPos][3],
        VehicleInfo[playerid][slot][vDBID]);
    mysql_tquery(db_handle, q);

    CarSystem_LoadVehicle(playerid, slot, false);
    if(VehicleInfo[playerid][slot][vSpawned] && VehicleInfo[playerid][slot][vID] != INVALID_VEHICLE_ID)
    {
        PutPlayerInVehicle(playerid, VehicleInfo[playerid][slot][vID], 0);
        ScooterRent_StartExitCountdown(playerid, SCOOTER_TIMER_MODE_OWNCAR, slot);
        ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜.", "");
    }
    return 1;
}

stock ScooterRent_Return(playerid, bool:timeout = false)
{
    if(gScooterRentVehicle[playerid] == INVALID_VEHICLE_ID || GetVehicleModel(gScooterRentVehicle[playerid]) == 0)
    {
        ScooterRent_ResetPlayer(playerid, false);
        if(!timeout) ShowNotification(playerid, 2, 5, 0, 1, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");
        return 1;
    }

    new vehicleid = gScooterRentVehicle[playerid];
    if(IsPlayerInVehicle(playerid, vehicleid))
    {
        RemovePlayerFromVehicle(playerid);
    }
    DestroyVehicle(vehicleid);
    ScooterRent_ResetPlayer(playerid, false);

    if(timeout)
        ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜ ˜˜˜˜˜: ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜.", "");
    else
        ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");
    return 1;
}

public ScooterRent_ExitTimer(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(gScooterRentTimerMode[playerid] == SCOOTER_TIMER_MODE_NONE) return 0;

    if(gScooterRentTimerMode[playerid] == SCOOTER_TIMER_MODE_RENT)
    {
        if(gScooterRentVehicle[playerid] == INVALID_VEHICLE_ID) return 0;
        if(GetVehicleModel(gScooterRentVehicle[playerid]) == 0)
        {
            ScooterRent_ResetPlayer(playerid, false);
            return 0;
        }
    }
    else if(gScooterRentTimerMode[playerid] == SCOOTER_TIMER_MODE_OWNCAR)
    {
        new slot = gScooterRentOwnSlot[playerid];
        if(slot < 0 || slot >= MAX_PLAYER_VEHICLES || !VehicleInfo[playerid][slot][vSpawned])
        {
            if(gScooterRentTimer[playerid] != 0) KillTimer(gScooterRentTimer[playerid]);
            gScooterRentTimer[playerid] = 0;
            gScooterRentTimerMode[playerid] = SCOOTER_TIMER_MODE_NONE;
            gScooterRentOwnSlot[playerid] = -1;
            ScooterRent_HideExitGui(playerid);
            return 0;
        }
    }

    if(!ScooterRent_IsInVokzalArea(playerid))
    {
        ScooterRent_HideExitGui(playerid);
        ShowNotification(playerid, 1, 4, 0, 1, "˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");
        KillTimer(gScooterRentTimer[playerid]);
        gScooterRentTimer[playerid] = 0;
        gScooterRentExitRemain[playerid] = 0;
        gScooterRentTimerMode[playerid] = SCOOTER_TIMER_MODE_NONE;
        gScooterRentOwnSlot[playerid] = -1;
        return 1;
    }

    gScooterRentExitRemain[playerid]--;
    if(gScooterRentExitRemain[playerid] <= 0)
    {
        ScooterRent_HideExitGui(playerid);
        if(gScooterRentTimerMode[playerid] == SCOOTER_TIMER_MODE_RENT)
        {
            ScooterRent_Return(playerid, true);
        }
        else if(gScooterRentTimerMode[playerid] == SCOOTER_TIMER_MODE_OWNCAR)
        {
            new slot = gScooterRentOwnSlot[playerid];
            if(slot >= 0 && slot < MAX_PLAYER_VEHICLES && VehicleInfo[playerid][slot][vSpawned])
            {
                if(IsPlayerInVehicle(playerid, VehicleInfo[playerid][slot][vID])) RemovePlayerFromVehicle(playerid);
                CarSystem_UnloadVehicle(playerid, slot);
            }
            if(gScooterRentTimer[playerid] != 0) KillTimer(gScooterRentTimer[playerid]);
            gScooterRentTimer[playerid] = 0;
            gScooterRentTimerMode[playerid] = SCOOTER_TIMER_MODE_NONE;
            gScooterRentOwnSlot[playerid] = -1;
            ShowNotification(playerid, 2, 5, 0, 1, "˜˜ ˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜!", "");
        }
        return 1;
    }

    ScooterRent_ShowExitGui(playerid, gScooterRentExitRemain[playerid]);
    return 1;
}

stock ScooterRent_Init()
{
    for(new i = 0; i < SCOOTER_RENT_STATIONS; i++)
    {
        gScooterRentPickup[i] = CreateDynamicPickup(19134, 23,
            gScooterRentStations[i][SR_PICKUP_X],
            gScooterRentStations[i][SR_PICKUP_Y],
            gScooterRentStations[i][SR_PICKUP_Z],
            gScooterRentStations[i][SR_PICKUP_INT],
            gScooterRentStations[i][SR_PICKUP_VW]);

        CreateDynamic3DTextLabel("{f6fa05}˜˜˜˜˜˜ ˜˜˜˜˜˜˜\n{ffffff}˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜", -1,
            gScooterRentStations[i][SR_PICKUP_X],
            gScooterRentStations[i][SR_PICKUP_Y],
            gScooterRentStations[i][SR_PICKUP_Z] + 0.6,
            15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
            gScooterRentStations[i][SR_PICKUP_VW],
            gScooterRentStations[i][SR_PICKUP_INT]);
    }

    for(new p = 0; p < MAX_PLAYERS; p++)
    {
        gScooterRentVehicle[p] = INVALID_VEHICLE_ID;
        gScooterRentStation[p] = -1;
        gScooterRentExitRemain[p] = 0;
        gScooterRentTimer[p] = 0;
        gScooterRentTimerMode[p] = SCOOTER_TIMER_MODE_NONE;
        gScooterRentOwnSlot[p] = -1;
    }

    for(new z = 0; z < SCOOTER_RENT_STATIONS; z++)
    {
        new Float:mnx = gZonesCarVokzal[z][0];
        new Float:mxx = gZonesCarVokzal[z][2];
        if(mnx > mxx)
        {
            new Float:swx = mnx;
            mnx = mxx;
            mxx = swx;
        }
        new Float:mny = gZonesCarVokzal[z][1];
        new Float:mxy = gZonesCarVokzal[z][3];
        if(mny > mxy)
        {
            new Float:swy = mny;
            mny = mxy;
            mxy = swy;
        }
        mnx -= SCOOTER_VOKZAL_EXTRA_MARGIN;
        mny -= SCOOTER_VOKZAL_EXTRA_MARGIN;
        mxx += SCOOTER_VOKZAL_EXTRA_MARGIN;
        mxy += SCOOTER_VOKZAL_EXTRA_MARGIN;

        gZoneSphereVokzalCar[z] = CreateDynamicRectangle(mnx, mny, mxx, mxy);
    }
    return 1;
}

stock ScooterRent_OnDisconnect(playerid)
{
    ScooterRent_ResetPlayer(playerid, true);
    return 1;
}

stock bool:ScooterRent_OnPickup(playerid, pickupid)
{
    for(new i = 0; i < SCOOTER_RENT_STATIONS; i++)
    {
        if(pickupid == gScooterRentPickup[i])
        {
            if(GetPVarInt(playerid, "ScooterRentDialogOpen") == 1) return true;
            if(GetPVarInt(playerid, "ScooterRentDialogCd") > gettime()) return true;
            ScooterRent_ShowMenu(playerid, i);
            return true;
        }
    }
    return false;
}

stock bool:ScooterRent_HandleDialog(playerid, dialogid, response, listitem)
{
    if(dialogid != DIALOG_SCOOTER_RENT) return false;
    if(!response)
    {
        SetPVarInt(playerid, "ScooterRentDialogOpen", 0);
        return true;
    }

    new station_id = ScooterRent_GetNearbyStation(playerid);
    if(station_id == -1) station_id = GetPVarInt(playerid, "ScooterRentMenu");
    if(station_id < 0 || station_id >= SCOOTER_RENT_STATIONS)
    {
        ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");
        return true;
    }

    if(listitem < 0 || listitem >= gScooterRentListCount[playerid]) return true;

    switch(gScooterRentListType[playerid][listitem])
    {
        case 1:
        {
            ScooterRent_Start(playerid, station_id);
            SetPVarInt(playerid, "ScooterRentDialogOpen", 0);
        }
        case 2:
        {
            ScooterRent_DeliverOwnCar(playerid, station_id, gScooterRentListSlot[playerid][listitem]);
            SetPVarInt(playerid, "ScooterRentDialogOpen", 0);
        }
        case 3: ScooterRent_ShowMenuPage(playerid, station_id, GetPVarInt(playerid, "ScooterRentPage") + 1);
        case 4: ScooterRent_ShowMenuPage(playerid, station_id, GetPVarInt(playerid, "ScooterRentPage") - 1);
    }
    return true;
}

CMD:srent(playerid, params[])
{
    new action = 0;
    if(sscanf(params, "d", action))
    {
        SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜˜˜˜˜˜˜˜: /srent [1 - ˜˜˜˜˜˜˜˜˜˜ | 2 - ˜˜˜˜˜˜˜˜˜]");
        return 1;
    }

    if(action == 2) return ScooterRent_Return(playerid, false);

    if(action != 1) return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜: 1 - ˜˜˜˜˜˜˜˜˜˜, 2 - ˜˜˜˜˜˜˜˜˜");

    new station_id = ScooterRent_GetNearbyStation(playerid);
    if(station_id == -1) station_id = GetPVarInt(playerid, "ScooterRentMenu");
    if(station_id < 0 || station_id >= SCOOTER_RENT_STATIONS)
        return ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");

    return ScooterRent_Start(playerid, station_id);
}
// ----- end: scooter_rent.inc -----

