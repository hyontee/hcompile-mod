        {
            new price = GetUnivCost(GetVehiclePriceByModel(GetVehicleModel(vehicleid)));
            new spent_vinyl = 0;
            new vinyl_name[24];
            if(TuneVinyl_GetNameByApiId(detal_id, vinyl_name, sizeof vinyl_name)
                && Tune_TryChargePlayer(playerid, 0, price, spent_vinyl) && spent_vinyl > 0)
            {
                    format(VehicleInfo[playerid][v][vVinyl], 16, "%s", vinyl_name);

                    new query[128];
                    mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `vinyl`='%e' WHERE `id`=%d", vinyl_name, VehicleInfo[playerid][v][vDBID]);
                    mysql_tquery(db_handle, query, "", "");

                    BroadcastVehicleVinyl(vehicleid, VehicleInfo[playerid][v][vVinyl]);
                    BroadcastPersonalVehicleVisuals(vehicleid, playerid, v);

                    JSON_SetInt(json_packet_data, "t", 3);
                    JSON_SetInt(json_packet_data, "s", 1);
                    JSON_SetInt(json_packet_data, "p", detal_id);
                    JSON_SetInt(json_packet_data, "m", GetPlayerMoneyEx(playerid));
                    JSON_SetInt(json_packet_data, "dn", GetPlayerBlackCoin(playerid));
            }
        }
    }
}
            else if(type == 23)
            {
                new preview_target = Tune_GetActivePaintTarget(playerid);
                if(preview_target < 0)
                {
