    {853.9012, 828.9996, 13.3528},
    {2745.7209, -2419.7084, 21.7118},
    {1797.6112, 2536.9562, 14.7150},
    {-2453.7968, 193.8572, 26.0826}
};

stock GPS_Disable(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    SendDestroyWayPoint(playerid, GPS_WAYPOINT_ID);
    RemovePlayerMapIcon(playerid, GPS_MAP_ICON_SLOT);
    SetPlayerGPSPoint(playerid, 0.0, 0.0, 0.0, 0x00000000);
    HideGPS(playerid);
    DisablePlayerCheckpoint(playerid);
    return 1;
}

stock GPS_ShowInDevelopment(playerid)
{
    ShowNotification(playerid, 2, 5, 0, 1, "˜ ˜˜˜˜˜˜˜˜˜˜", "");
    return 1;
}

stock GPS_GetNearestBusinessByType(playerid, biz_type)
{
    new nearest = -1;
    new Float:best = FLOAT_INFINITY;

    for(new idx; idx < g_business_loaded; idx++)
    {
        if(!IsBusinessSlotValid(idx)) continue;
        if(GetBusinessData(idx, B_TYPE) != biz_type) continue;

        new Float:dist = GetPlayerDistanceFromPoint(playerid,
            GetBusinessData(idx, B_POS_X),
            GetBusinessData(idx, B_POS_Y),
            GetBusinessData(idx, B_POS_Z));

        if(dist < best)
        {
            best = dist;
            nearest = idx;
        }
    }
    return nearest;
}

stock GPS_GetNearestFuelStation(playerid)
{
    new nearest = -1;
    new Float:best = FLOAT_INFINITY;

    for(new i; i < MAX_FUEL_STATIONS; i++)
    {
        if(!g_FuelStations[i][FuelStationActive]) continue;

        new Float:dist = GetPlayerDistanceFromPoint(playerid,
            g_FuelStations[i][FuelStationX],
            g_FuelStations[i][FuelStationY],
            g_FuelStations[i][FuelStationZ]);

        if(dist < best)
        {
            best = dist;
            nearest = i;
        }
    }
    return nearest;
}

stock GPS_ShowNearestMark(playerid, biz_type, icon_id, const place_name[])
{
    new biz_id = GPS_GetNearestBusinessByType(playerid, biz_type);
    if(biz_id == -1)
    {
        ShowNotification(playerid, 2, 4, 0, 1, "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜.", "");
        return 0;
    }

    new Float:bx = GetBusinessData(biz_id, B_POS_X);
    new Float:by = GetBusinessData(biz_id, B_POS_Y);
    new Float:bz = GetBusinessData(biz_id, B_POS_Z);
    new Float:dist = GetPlayerDistanceFromPoint(playerid, bx, by, bz);
    new msg[144];

    GPS_SetDestination(playerid, bx, by, bz, icon_id, 0);
    format(msg, sizeof msg, "˜˜˜˜˜ ˜˜˜˜: {E0584B}%s {FFFFFF}({E0584B}%.1f ˜{FFFFFF})", place_name, dist);
    SendClientMessage(playerid, -1, msg);
    return 1;
}

stock GPS_ShowBanksMenu(playerid)
{
    new body[384], city[32];
    body[0] = '\0';
    for(new i = 0; i < BANK_BRANCH_COUNT; i++)
    {
        Bank_GetBranchName(i, city);
        format(body, sizeof body, "%s%d. " CAR_CLR_LABEL "˜˜˜˜ ˜. %s\n", body, i + 1, city);
    }
    ShowPlayerDialog(playerid, DIALOG_GPS_BANKS, DIALOG_STYLE_LIST,
        CAR_DLG_PREFIX "˜˜˜˜˜", body, "˜˜˜˜˜˜˜", "˜˜˜˜˜");
    return 1;
}

stock GPS_ShowMainMenu(playerid)
{
    ShowPlayerDialog(playerid, DIALOG_GPS, DIALOG_STYLE_LIST,
        CAR_DLG_PREFIX "GPS",
        "1. " CAR_CLR_LABEL "˜˜˜˜˜˜ ˜˜˜˜˜\n"\
        "2. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜\n"\
        "3. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜\n"\
        "4. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜˜˜\n"\
        "5. " CAR_CLR_LABEL "˜˜˜˜˜\n"\
        "6. " CAR_CLR_LABEL "˜˜˜ ˜ ˜˜˜˜˜˜-˜˜˜˜˜˜\n"\
        "7. " CAR_CLR_LABEL "˜˜˜˜˜˜˜\n"\
        "8. " CAR_CLR_LABEL "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜",
        "˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜");
    return 1;
}

stock bool:GPS_OnDialogResponse(playerid, dialogid, response, listitem)
{
    switch(dialogid)
    {
        case DIALOG_GPS:
        {
            if(!response) return true;

            switch(listitem)
            {
                case 0: GPS_ShowInDevelopment(playerid);
                case 1:
                {
                    ShowPlayerDialog(playerid, DIALOG_GPS_JOBS, DIALOG_STYLE_LIST,
                        CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜",
                        "1. " CAR_CLR_LABEL "˜˜˜˜˜",
                        "˜˜˜˜˜˜˜", "˜˜˜˜˜");
                }
                case 2:
                {
                    ShowPlayerDialog(playerid, DIALOG_GPS_STATE_ORG, DIALOG_STYLE_LIST,
                        CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜",
                        "1. " CAR_CLR_LABEL "˜˜˜˜˜ ˜. ˜˜˜˜˜\n"\
                        "2. " CAR_CLR_LABEL "˜˜˜˜˜ ˜. ˜˜˜˜˜˜˜˜˜˜˜\n"\
                        "3. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜. ˜˜˜˜˜˜˜\n"\
                        "4. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜. ˜˜˜˜˜˜˜˜˜\n"\
                        "5. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜. ˜˜˜˜˜˜˜˜˜˜˜",
                        "˜˜˜˜˜˜˜", "˜˜˜˜˜");
                }
                case 3:
                {
                    ShowPlayerDialog(playerid, DIALOG_GPS_ENTERTAINMENT, DIALOG_STYLE_LIST,
                        CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜˜˜˜",
                        "1. " CAR_CLR_LABEL "˜˜˜˜˜˜\n"\
                        "2. " CAR_CLR_LABEL "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜",
                        "˜˜˜˜˜˜˜", "˜˜˜˜˜");
                }
                case 4: GPS_ShowBanksMenu(playerid);
                case 5:
                {
                    ShowPlayerDialog(playerid, DIALOG_GPS_STO, DIALOG_STYLE_LIST,
                        CAR_DLG_PREFIX "˜˜˜ ˜ ˜˜˜˜˜˜-˜˜˜˜˜˜",
                        "1. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜\n"\
                        "2. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜ ˜˜˜˜˜\n"\
                        "3. " CAR_CLR_LABEL "˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜",
                        "˜˜˜˜˜˜˜", "˜˜˜˜˜");
                }
                case 6:
                {
                    ShowPlayerDialog(playerid, DIALOG_GPS_VOKZALS, DIALOG_STYLE_LIST,
                        CAR_DLG_PREFIX "˜˜˜˜˜˜˜",
                        "1. " CAR_CLR_LABEL "˜˜˜˜˜˜ ˜. ˜˜˜˜˜˜˜\n"\
                        "2. " CAR_CLR_LABEL "˜˜˜˜˜˜ ˜. ˜˜˜˜˜\n"\
                        "3. " CAR_CLR_LABEL "˜˜˜˜˜˜ ˜. ˜˜˜˜˜˜˜˜\n"\
                        "4. " CAR_CLR_LABEL "˜˜˜˜˜˜ ˜. ˜˜˜˜˜˜˜˜˜",
                        "˜˜˜˜˜˜˜", "˜˜˜˜˜");
                }
                case 7:
                {
                    ShowPlayerDialog(playerid, DIALOG_GPS_NEAREST, DIALOG_STYLE_LIST,
                        CAR_DLG_PREFIX "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜",
                        "1. " CAR_CLR_LABEL "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜\n"\
                        "2. " CAR_CLR_LABEL "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ 24/7\n"\
                        "3. " CAR_CLR_LABEL "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜\n"\
                        "4. " CAR_CLR_LABEL "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜\n"\
                        "5. " CAR_CLR_LABEL "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜",
                        "˜˜˜˜˜˜˜", "˜˜˜˜˜");
                }
            }
            return true;
        }
        case DIALOG_GPS_JOBS:
        {
            if(!response)
            {
                GPS_ShowMainMenu(playerid);
                return true;
            }
            if(listitem == 0)
                GPS_SetDestination(playerid, gGpsMine[0][GPS_PT_X], gGpsMine[0][GPS_PT_Y], gGpsMine[0][GPS_PT_Z]);
            return true;
        }
        case DIALOG_GPS_STATE_ORG:
        {
            if(!response)
            {
                GPS_ShowMainMenu(playerid);
                return true;
            }
            if(0 <= listitem < sizeof gGpsStateOrg)
            {
                GPS_SetDestination(playerid,
                    gGpsStateOrg[listitem][GPS_PT_X],
                    gGpsStateOrg[listitem][GPS_PT_Y],
                    gGpsStateOrg[listitem][GPS_PT_Z],
                    GPS_WAYPOINT_ICON, 0);
            }
            return true;
        }
        case DIALOG_GPS_ENTERTAINMENT:
        {
            if(!response)
            {
                GPS_ShowMainMenu(playerid);
                return true;
            }
            if(0 <= listitem < sizeof gGpsEntertainment)
            {
                GPS_SetDestination(playerid,
                    gGpsEntertainment[listitem][GPS_PT_X],
                    gGpsEntertainment[listitem][GPS_PT_Y],
                    gGpsEntertainment[listitem][GPS_PT_Z]);
            }
            return true;
        }
        case DIALOG_GPS_STO:
        {
            if(!response)
            {
                GPS_ShowMainMenu(playerid);
                return true;
            }
            if(0 <= listitem < sizeof gGpsSto)
            {
                GPS_SetDestination(playerid,
                    gGpsSto[listitem][GPS_PT_X],
                    gGpsSto[listitem][GPS_PT_Y],
                    gGpsSto[listitem][GPS_PT_Z]);
            }
            return true;
        }
        case DIALOG_GPS_VOKZALS:
        {
            if(!response)
            {
                GPS_ShowMainMenu(playerid);
                return true;
            }
            if(0 <= listitem < sizeof gGpsVokzals)
            {
                GPS_SetDestination(playerid,
                    gGpsVokzals[listitem][GPS_PT_X],
                    gGpsVokzals[listitem][GPS_PT_Y],
                    gGpsVokzals[listitem][GPS_PT_Z]);
            }
            return true;
        }
        case DIALOG_GPS_BANKS:
        {
            if(!response)
            {
                GPS_ShowMainMenu(playerid);
                return true;
            }
            if(0 <= listitem < BANK_BRANCH_COUNT)
            {
                new Float:bx, Float:by, Float:bz, city[32];
                if(Bank_GetEnterPosForGps(listitem, bx, by, bz))
                {
                    Bank_GetBranchName(listitem, city);
                    GPS_SetDestination(playerid, bx, by, bz, GPS_WAYPOINT_ICON, 0);
                    new msg[96];
                    format(msg, sizeof msg, "˜˜˜˜˜˜˜: {E0584B}˜˜˜˜ ˜. %s", city);
                    SendClientMessage(playerid, -1, msg);
                }
            }
            return true;
        }
        case DIALOG_GPS_NEAREST:
        {
            if(!response)
            {
                GPS_ShowMainMenu(playerid);
                return true;
            }

            switch(listitem)
            {
                case 0:
                {
                    new station_idx = GPS_GetNearestFuelStation(playerid);
                    if(station_idx == -1)
                    {
                        ShowNotification(playerid, 2, 4, 0, 1, "˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜.", "");
                        return true;
                    }

                    new Float:fx = g_FuelStations[station_idx][FuelStationX];
                    new Float:fy = g_FuelStations[station_idx][FuelStationY];
                    new Float:fz = g_FuelStations[station_idx][FuelStationZ];
                    new Float:dist = GetPlayerDistanceFromPoint(playerid, fx, fy, fz);
                    new msg[128];

                    GPS_SetDestination(playerid, fx, fy, fz, 47, 0);
                    format(msg, sizeof msg, "˜˜˜˜˜ ˜˜˜˜: {E0584B}˜˜˜ {FFFFFF}({E0584B}%.1f ˜{FFFFFF})", dist);
                    SendClientMessage(playerid, -1, msg);
                }
                case 1: GPS_ShowNearestMark(playerid, BUSINESS_TYPE_SHOP_24_7, 23, "˜˜˜˜˜˜˜ 24/7");
                case 2: GPS_ShowNearestMark(playerid, BUSINESS_TYPE_CLOTHING_SHOP, 45, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜");
                case 3: GPS_ShowNearestMark(playerid, BUSINESS_TYPE_SHOP_GUN, 18, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜");
                case 4: GPS_ShowNearestMark(playerid, BUSINESS_TYPE_ACCESSORY_SHOP, 52, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜");
            }
            return true;
        }
    }
    return false;
}

CMD:gps(playerid, params[])
{
    #pragma unused params
    GPS_Disable(playerid);
    GPS_ShowMainMenu(playerid);
    return 1;
}

CMD:bank(playerid, params[])
{
    #pragma unused params
    Bank_OpenMenu(playerid);
    return 1;
}

CMD:charity(playerid, params[])
{
    #pragma unused params
    Bank_ShowCharityTop(playerid);
    return 1;
}

CMD:mycoord(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;

    new Float:x, Float:y, Float:z, Float:a;
    new str[144];

    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);

    format(str, sizeof(str), "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜: X: %.4f | Y: %.4f | Z: %.4f | A: %.4f", x, y, z, a);

    SendClientMessage(playerid, -1, str);

    new log_str[180];
    format(log_str, sizeof(log_str), "[COORD LOG] ˜˜˜˜˜ %s[%d]: %.4f, %.4f, %.4f, %.4f", Player[playerid][pName], playerid, x, y, z, a);
    print(log_str);

    return 1;
}

alias:coord("coords", "pos", "mypos")
CMD:coord(playerid, params[])
{
    new Float:x, Float:y, Float:z, Float:a, Float:vx, Float:vy, Float:vz, Float:va;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);

    new interior = GetPlayerInterior(playerid);
    new vw       = GetPlayerVirtualWorld(playerid);
    new vehid    = GetPlayerVehicleID(playerid);

    new chat_str[160];
    format(chat_str, sizeof(chat_str),
        "{F6FA05}/coord {FFFFFF}| X: {66CC66}%.4f {FFFFFF}Y: {66CC66}%.4f {FFFFFF}Z: {66CC66}%.4f {FFFFFF}A: {66CC66}%.4f {AAAAAA}(int %d, vw %d)",
        x, y, z, a, interior, vw);
    SendClientMessage(playerid, -1, chat_str);

    new log_str[220];
    format(log_str, sizeof(log_str),
        "[COORD] %s[%d] pos: %.4f, %.4f, %.4f, %.4f | int=%d vw=%d",
        Player[playerid][pName], playerid, x, y, z, a, interior, vw);
    print(log_str);

    if(vehid != INVALID_VEHICLE_ID && vehid != 0)
    {
        GetVehiclePos(vehid, vx, vy, vz);
        GetVehicleZAngle(vehid, va);

        new veh_chat[160];
        format(veh_chat, sizeof(veh_chat),
            "{F6FA05}/coord {FFFFFF}| {F6FA05}veh{FFFFFF} model %d  X: {66CC66}%.4f {FFFFFF}Y: {66CC66}%.4f {FFFFFF}Z: {66CC66}%.4f {FFFFFF}A: {66CC66}%.4f",
            GetVehicleModel(vehid), vx, vy, vz, va);
        SendClientMessage(playerid, -1, veh_chat);

        new veh_log[220];
        format(veh_log, sizeof(veh_log),
            "[COORD] %s[%d] vehicle %d (model %d): %.4f, %.4f, %.4f, %.4f",
            Player[playerid][pName], playerid, vehid, GetVehicleModel(vehid), vx, vy, vz, va);
        print(veh_log);
    }

    #pragma unused params
    return 1;
}

CMD:park(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_RED, "˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜!");

    new vehid = GetPlayerVehicleID(playerid);
    new slot = -1;

    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++) {
        if(VehicleInfo[playerid][i][vID] == vehid) {
            slot = i;
            break;
        }
    }

    if(slot == -1) return SendClientMessage(playerid, COLOR_RED, "˜˜˜ ˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜!");

    GetVehiclePos(vehid, VehicleInfo[playerid][slot][vPos][0], VehicleInfo[playerid][slot][vPos][1], VehicleInfo[playerid][slot][vPos][2]);
    GetVehicleZAngle(vehid, VehicleInfo[playerid][slot][vPos][3]);

    new query[256];
    mysql_format(db_handle, query, sizeof(query),
        "UPDATE `ownable_cars` SET `x`='%f', `y`='%f', `z`='%f', `a`='%f' WHERE `id`='%d'",
        VehicleInfo[playerid][slot][vPos][0], VehicleInfo[playerid][slot][vPos][1],
        VehicleInfo[playerid][slot][vPos][2], VehicleInfo[playerid][slot][vPos][3],
        VehicleInfo[playerid][slot][vDBID]);
    mysql_tquery(db_handle, query);

    SendClientMessage(playerid, COLOR_WHITE, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜!");
    return 1;
}

CMD:radial(playerid)
{
    Radial_OpenMenu(playerid);
    return 1;
}

stock IsABike(vehicleid)
{
    new model = GetVehicleModel(vehicleid);
    return (model == 481 || model == 509 || model == 510);
}

alias:e("en")
CMD:e(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID || GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
    if(IsABike(vehicleid)) return 1;

    SetVehicleParam(vehicleid, V_ENGINE, !GetVehicleParam(vehicleid, V_ENGINE));
    return 1;
}

CMD:lk(playerid)
{
    new vehicleid = INVALID_VEHICLE_ID;
    if(IsPlayerInAnyVehicle(playerid)) vehicleid = GetPlayerVehicleID(playerid);
    else
    {
        for(new i = 1, j = GetVehiclePoolSize(); i <= j; i++)
        {
            if(!GetVehicleModel(i)) continue;
            new Float:pos[3];
            GetVehiclePos(i, pos[0], pos[1], pos[2]);
            if(IsPlayerInRangeOfPoint(playerid, 4.0, pos[0], pos[1], pos[2])) { vehicleid = i; break; }
        }
    }

    if(vehicleid == INVALID_VEHICLE_ID)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜!", "");
        return 1;
    }

    new bool:canAccess = false;
    if(Player[playerid][pAdminVeh] == vehicleid) canAccess = true;

    if(!canAccess)
    {
        for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
        {
            if(VehicleInfo[playerid][i][vSpawned] && VehicleInfo[playerid][i][vID] == vehicleid)
            {
                canAccess = true;
                break;
            }
        }
    }

    if(!canAccess)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!", "");
        return 1;
    }

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

    new name[MAX_PLAYER_NAME], str[128];
    GetPlayerName(playerid, name, sizeof(name));

    if(doors)
    {
        SetVehicleParam(vehicleid, V_LOCK, 0);
        format(str, sizeof(str), "{FF90FF}%s ˜˜˜˜˜˜(˜) ˜˜˜˜˜˜˜˜˜", name);
        PlayAudioStreamURL(playerid, "vehicle_sound_alarm.mp3");
    }
    else
    {
        SetVehicleParam(vehicleid, V_LOCK, 1);
        format(str, sizeof(str), "{FF90FF}%s ˜˜˜˜˜˜(˜) ˜˜˜˜˜˜˜˜˜", name);
        PlayAudioStreamURL(playerid, "vehicle_sound_door.mp3");
    }

    SendClientMessage(playerid, 0xFFFF90FF, str);
    return 1;
}

CMD:setadmin_legacy(playerid, params[])
{
    if(!IsPlayerAdmin(playerid) && Player[playerid][pAdminLvl] < 6) return 1;
    new cmdbuf[128], targetid, level, prefix[32];
    format(cmdbuf, sizeof(cmdbuf), "%s", params);
    BR_FixUserText(cmdbuf, sizeof(cmdbuf));
    if(sscanf(cmdbuf, "uds[32]", targetid, level, prefix)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /setadmin [id] [0-6] [˜˜˜˜˜˜˜]");
    if(!IsPlayerConnected(targetid)) return 1;

    if(!Admin_CanManageAdminRank(playerid, targetid, level))
        return 1;

    Player[targetid][pAdminLvl] = level;
    BR_CopyUserText(Player[targetid][pAdminPrefix], 32, prefix);
    if(level == 0)
    {
        Player[targetid][pAdminAuth] = false;
        Player[targetid][pAdminPass] = 0;
    }

    SavePlayerAccount(targetid);
    AT_SaveAdminDataToDB(targetid);
    SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");
    if(level > 0)
        Admin_NotifyAssignedInGame(targetid, Player[targetid][pAdminPrefix]);
    return 1;
}

CMD:getv(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;
    new vehicleid, str[128];
    if(sscanf(params, "d", vehicleid)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /getv [ID ˜˜˜˜˜˜]");
    if(vehicleid == INVALID_VEHICLE_ID || vehicleid <= 0) return SendClientMessage(playerid, 0xFF4B4BFF, "˜˜˜˜˜˜˜˜ ID ˜˜˜˜˜˜!");

    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    SetVehiclePos(vehicleid, x, y + 2.0, z + 1.0);
    SetVehicleVirtualWorld(vehicleid, GetPlayerVirtualWorld(playerid));
    LinkVehicleToInterior(vehicleid, GetPlayerInterior(playerid));

    format(str, sizeof(str), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ID %d ˜ ˜˜˜˜.", vehicleid);
    SendClientMessage(playerid, -1, str);
    return 1;
}

CMD:vget(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;
    new targetid, str[128];
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /vget [ID ˜˜˜˜˜˜]");
    if(!IsPlayerConnected(targetid)) return 1;

    new vehicle_slot = -1;
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(VehicleInfo[targetid][i][vSpawned] && VehicleInfo[targetid][i][vID] != INVALID_VEHICLE_ID)
        {
            vehicle_slot = i;
            break;
        }
    }

    if(vehicle_slot == -1) return SendClientMessage(playerid, 0xFF4B4BFF, "˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!");

    new Float:x, Float:y, Float:z;
    GetPlayerPos(targetid, x, y, z);

    SetVehiclePos(VehicleInfo[targetid][vehicle_slot][vID], x + 2.0, y, z + 1.0);
    SetVehicleVirtualWorld(VehicleInfo[targetid][vehicle_slot][vID], GetPlayerVirtualWorld(targetid));
    LinkVehicleToInterior(VehicleInfo[targetid][vehicle_slot][vID], GetPlayerInterior(targetid));

    format(str, sizeof(str), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ %s (˜˜˜˜ %d) ˜ ˜˜˜˜.", Player[targetid][pName], vehicle_slot + 1);
    SendClientMessage(playerid, -1, str);
    return 1;
}

CMD:l(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return 1;

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

    new new_lights = !lights;
    SetVehicleParam(vehicleid, V_LIGHTS, new_lights);

    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(!IsPlayerStreamedIn(vehicleid, i)) continue;

        for(new p = 0; p < MAX_PLAYERS; p++)
        {
            if(!IsPlayerConnected(p)) continue;
            for(new v = 0; v < MAX_PLAYER_VEHICLES; v++)
            {
                if(VehicleInfo[p][v][vSpawned] && VehicleInfo[p][v][vID] == vehicleid)
                {
                    if(new_lights == 1)
                    {
                        if(VehicleInfo[p][v][vLightsColor] != 0)
                        {
                            SetVehicleLightsColorHEX(i, vehicleid, VehicleInfo[p][v][vLightsColor]);
                        }
                    }
                }
            }
        }
    }
    return 1;
}

CMD:askin(playerid)
{
	if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;

	if(GetPlayerSkin(playerid) == 122)
	{
		SetPlayerSkin(playerid, Player[playerid][pSkin]);
		SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ {FFFF00}˜˜˜˜˜{FFFFFF} ˜ ˜˜˜˜ ˜˜˜˜ {FFFF00}˜˜˜˜˜˜˜˜˜˜˜˜˜˜.");
	}
	else
	{
		SetPlayerSkin(playerid, 122);
		SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜{FFFF00} ˜˜˜˜˜˜{FFFFFF} ˜˜ ˜˜˜˜ ˜˜˜˜ {FFFF00}˜˜˜˜˜˜˜˜˜˜˜˜˜˜.");
	}
	return 1;
}

public OnIncomingRPC(playerid, rpcid, BitStream:bs)
{
    if(rpcid != 97) return 1;

    new action;
    new actionSubtype;

    if(!BS_ReadUint32(bs, action))
    {
        return 1;
    }

    if(action == 18)
    {
        if(MinerJob_TryInteractKey(playerid)) return 1;
        if(Shop247_TryInteractClick(playerid)) return 1;
        if(Bank_TryInteractKey(playerid)) return 1;
        if(Hospital_TryInteractKey(playerid)) return 1;
        return 1;
    }

    if(action == 4)
    {
        if(Gibdd_OnClickRPC(playerid)) return 1;
        if(MinerJob_TryInteractKey(playerid)) return 1;
        if(Shop247_TryInteractClick(playerid)) return 1;
        if(Bank_TryInteractKey(playerid)) return 1;
        if(Hospital_TryInteractKey(playerid)) return 1;
        callcmd::radial(playerid);
        return 1;
    }

    if(action == 14)
    {
        if(!BS_ReadUint8(bs, actionSubtype)) return 1;
        else if(actionSubtype == 2)
        {
            callcmd::donate(playerid);
        }
        else if(actionSubtype == 0)
        {
            SendClientMessage(playerid, COLOR_GREY, "Black Pass ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜.");
        }
    }

    return 1;
}
forward UpdatePunishments();
public UpdatePunishments()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i) || Player[i][pID] == 0) continue;

        new bool:changed = false;

        if(Player[i][pMuteTime] > 0)
        {
            Player[i][pMuteTime]--;
            changed = true;
        }

        if(Player[i][pJailTime] > 0)
        {
            Player[i][pJailTime]--;
            changed = true;

            if(Player[i][pJailTime] <= 0)
            {
                SetPlayerPos(i, 1345.0, 123.0, 1245.0);
                SetPlayerInterior(i, 0);
                SetPlayerVirtualWorld(i, 0);
                SendClientMessage(i, COLOR_WHITE, "{4682B4}[˜˜˜˜˜˜˜˜˜˜] {FFFFFF}˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜. ˜˜ ˜˜˜˜˜˜˜˜˜!");
            }
        }

        if(changed)
        {
            new query[128];
            mysql_format(db_handle, query, sizeof(query),
                "UPDATE `players` SET `mute_time` = %d, `jail_time` = %d WHERE `id` = %d",
                Player[i][pMuteTime], Player[i][pJailTime], Player[i][pID]);
            mysql_tquery(db_handle, query);
        }
    }
    return 1;
}

CMD:time(playerid)
{
    new hour, minute, second, day, month, year;
    gettime(hour, minute, second);
    getdate(year, month, day);

    static const month_names[][] = {"", "˜˜˜˜˜˜", "˜˜˜˜˜˜˜", "˜˜˜˜˜", "˜˜˜˜˜˜", "˜˜˜", "˜˜˜˜", "˜˜˜˜", "˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜", "˜˜˜˜˜˜", "˜˜˜˜˜˜˜"};
    static const day_names[][] = {"˜˜˜˜˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜", "˜˜˜˜˜", "˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜"};

    new a = (14 - month) / 12;
    new y = year - a;
    new m = month + 12 * a - 2;
    new day_of_week = (day + y + y/4 - y/100 + y/400 + (31*m)/12) % 7;

    new str[1024], info[128];
    
    format(info, sizeof(info), "{FFFFFF}˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜: {FFFF00}%d %s %d˜.\n", day, month_names[month], year);
    strcat(str, info);
    format(info, sizeof(info), "{FFFFFF}˜˜˜˜ ˜˜˜˜˜˜: {FFFF00}%s\n", day_names[day_of_week]);
    strcat(str, info);
    format(info, sizeof(info), "{FFFFFF}˜˜˜˜˜˜˜ ˜˜˜˜˜: {FFFF00}%02d:%02d:%02d\n\n", hour, minute, second);
    strcat(str, info);

    format(info, sizeof(info), "{FFFFFF}˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜ ˜˜˜: {FFFF00}%d ˜˜˜.\n", Player[playerid][pSecondsHour] / 60);
    strcat(str, info);
    format(info, sizeof(info), "{FFFFFF}˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜˜: {FFFF00}%d ˜˜˜.\n", Player[playerid][pSecondsToday] / 60);
    strcat(str, info);
    format(info, sizeof(info), "{FFFFFF}˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜ ˜˜˜˜˜: {FFFF00}%d ˜˜˜.\n", Player[playerid][pSecondsYesterday] / 60);
    strcat(str, info);

    if(Player[playerid][pJailTime] > 0)
    {
        format(info, sizeof(info), "\n{E0584B}˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%d ˜˜˜.", Player[playerid][pJailTime]);
        strcat(str, info);
    }
    if(Player[playerid][pMuteTime] > 0)
    {
        format(info, sizeof(info), "\n{E0584B}˜˜ ˜˜˜˜˜ ˜˜˜˜: {FFFFFF}%d ˜˜˜.", Player[playerid][pMuteTime]);
        strcat(str, info);
    }

    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "{E0584B}BR BLACK STUDIO | ˜˜˜˜˜˜ ˜˜˜˜˜", str, "˜˜˜˜˜˜˜", "");
    return 1;
}

CMD:kick(playerid, params[])
{
