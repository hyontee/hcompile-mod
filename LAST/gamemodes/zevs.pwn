public SSCANF_OnPlayerConnect(playerid)
{
    ShopStores_OnPlayerConnect(playerid);
    Bank_OnPlayerConnect(playerid);
    Phone_OnPlayerConnect(playerid);
    Shop247_OnPlayerConnect(playerid);
    BusinessSystem_OnPlayerConnect(playerid);
    Kvest_OnPlayerConnect(playerid);
    Player[playerid][pLoginAttempts] = 0;
    Player[playerid][pPassword][0] = EOS;
    DeletePVar(playerid, "reg_gui_ack");
    DeletePVar(playerid, "auth_reg_finish");
    DeletePVar(playerid, "auth_reg_skin");
    DeletePVar(playerid, "auth_has_account");
    DeletePVar(playerid, "auth_state_ready");
    DeletePVar(playerid, "auth_reg_flow");
    DeletePVar(playerid, "auth_ref_pending");
    DeletePVar(playerid, "auth_referal");
    DeletePVar(playerid, "auth_pending_pass");
    DeletePVar(playerid, "auth_reg_pass");
    TogglePlayerSpectating(playerid, true);
    TogglePlayerControllable(playerid, false);
    Admin_ClearBanFields(playerid);
    Player[playerid][pID] = 0;
    Player[playerid][pCarExtraSlots] = 0;
    Player[playerid][pLevel] = 0;
    Player[playerid][pMoney] = 0;
    Player[playerid][pBank] = 0;
    Player[playerid][pDonate] = 0;
    Player[playerid][pBC] = 0;
    Player[playerid][pPhoneOwned] = false;
    Player[playerid][pSimCard] = 0;
    Player[playerid][pVipType] = 0;
    Player[playerid][pVipTime] = 0;
    Player[playerid][pCountTodayCases] = 0;
    Player[playerid][pCountBomjCases] = 0;
    Player[playerid][pCountStandartCases] = 0;
    Player[playerid][pCountCarCases] = 0;
    Player[playerid][pCountOsobiyCases] = 0;
    Player[playerid][pAdminLvl] = 0;
    Player[playerid][pAdminAuth] = false;
    Player[playerid][pSkin] = 0;
    Player[playerid][pHealth] = 100.0;
    Player[playerid][pArmour] = 0.0;
    Player[playerid][pMedCard] = 0;
    Player[playerid][pMedCardReadyAt] = 0;
    Player[playerid][pMedQuizFailUntil] = 0;
    Player[playerid][pHospitalFastHealUntil] = 0;
    Player[playerid][pHospitalUnfinished] = 0;
    Player[playerid][pMedCardIssuedAt] = 0;
    Player[playerid][pMedCardExpiresAt] = 0;
    Player[playerid][pMedCardIssuerBranch] = -1;
    format(Player[playerid][pName], MAX_PLAYER_NAME, "");
    GetPlayerName(playerid, Player[playerid][pName], MAX_PLAYER_NAME);
    SetPlayerColor(playerid, COLOR_WHITE);

    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        PlayerInventory[playerid][i][invID] = 0;
        PlayerInventory[playerid][i][invItem] = 0;
        PlayerInventory[playerid][i][invCount] = 0;
        PlayerInventory[playerid][i][invValue] = 0;
    }
    g_PlayerTrunkVeh[playerid] = INVALID_VEHICLE_ID;
    g_TrunkOfferShown[playerid] = false;
    g_TrunkOfferVeh[playerid] = 0;
    g_TrunkOfferLastTime[playerid] = 0;
    GibddResetPlayer(playerid);
    Hospital_ResetPlayer(playerid);
    DeletePVar(playerid, "auth_first_play");
    Fuel_InitCanisterPrompt(playerid);
    Family_ResetPlayerVars(playerid);
    Player[playerid][pAdminVeh] = INVALID_VEHICLE_ID;
    Calendar_OnConnect(playerid);
    MinerJob_OnConnect(playerid);

    AuthAfterConnectCheck(playerid);
    return 1;
}

forward KickPublic(playerid);
forward AuthAfterConnectCheck(playerid);
forward ContinueAccountLoadAfterLogin(playerid);
public KickPublic(playerid)
{
    if(IsPlayerConnected(playerid)) Kick(playerid);
    return 1;
}

public AuthAfterConnectCheck(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(gWhitelistEnabled)
    {
        new wl_query[512], player_ip[16];
        GetPlayerIp(playerid, player_ip, sizeof(player_ip));
        mysql_format(db_handle, wl_query, sizeof(wl_query),
            "SELECT \
            (SELECT COUNT(*) FROM `server_whitelist`) AS total, \
            (SELECT COUNT(*) FROM `server_whitelist` WHERE `nickname`='%e' LIMIT 1) AS allowed, \
            (SELECT COUNT(*) FROM `whitelist_ips` WHERE `nickname`='%e' AND `ip`='%e') AS ip_match, \
            (SELECT COUNT(*) FROM `whitelist_ips` WHERE `nickname`='%e') AS ip_count",
            Player[playerid][pName], Player[playerid][pName], player_ip, Player[playerid][pName]);
        mysql_tquery(db_handle, wl_query, "OnWhitelistAccessChecked", "i", playerid);
    }
    else
    {
        new query[128];
        mysql_format(db_handle, query, sizeof(query), "SELECT * FROM `players` WHERE `name` = '%e' LIMIT 1", Player[playerid][pName]);
        mysql_tquery(db_handle, query, "CheckPlayerAccount", "i", playerid);
    }
    return 1;
}

public SSCANF_OnPlayerDisconnect(playerid, reason)
{
    #pragma unused reason
    Admin_Spectate_OnPlayerDisconnect(playerid);
    ShopStores_OnPlayerDisconnect(playerid);
    Bank_OnPlayerDisconnect(playerid);
    Phone_OnPlayerDisconnect(playerid);
    Shop247_OnPlayerDisconnect(playerid);
    BusinessSystem_OnPlayerDisconnect(playerid);
    Kvest_OnPlayerDisconnect(playerid);
    LaunchControl_CancelAutoOff(playerid);
    gInShinkaSession[playerid] = false;
    gInStoSession[playerid] = false;
    gShinkaStartWheel[playerid] = 0;
    DeletePVar(playerid, "shinka_ret_x");
    DeletePVar(playerid, "shinka_ret_y");
    DeletePVar(playerid, "shinka_ret_z");
    DeletePVar(playerid, "shinka_ret_a");
    ScooterRent_OnDisconnect(playerid);
    VehicleMusic_OnPlayerDisconnect(playerid);
    Trunk_OnPlayerDisconnect(playerid);
    Trade_OnDisconnect(playerid);
    Calendar_OnDisconnect(playerid);
    Player[playerid][pPassword][0] = EOS;
    DeletePVar(playerid, "reg_gui_ack");
    DeletePVar(playerid, "auth_reg_finish");
    DeletePVar(playerid, "auth_reg_skin");
    DeletePVar(playerid, "auth_has_account");
    DeletePVar(playerid, "auth_state_ready");
    DeletePVar(playerid, "auth_reg_flow");
    DeletePVar(playerid, "auth_ref_pending");
    DeletePVar(playerid, "auth_referal");
    DeletePVar(playerid, "auth_reg_pass");
    DeletePVar(playerid, "spawn_gui_active");
    MinerJob_OnDisconnect(playerid);
    Cases_CleanupPlayer(playerid);
    Fuel_FlushAllPendingForPlayer(playerid);
    GPS_Disable(playerid);
    SpawnLoc_OnPlayerDisconnect(playerid);
    Hospital_OnPlayerDisconnect(playerid);
    Player_SyncVitalsFromGame(playerid);
    SavePlayerEstate(playerid);
    #if defined _FAMILY_ADDITION_INC_
    FamilyAddition_OnDisconnect(playerid);
    #endif
    Family_UnloadPlayer(playerid);
    if(acs_editing[playerid]) StopAccessoryEdit(playerid, true);
    Inv_SyncWornInventoryToDB(playerid);
    SavePlayerAccount(playerid);
    Player_FixInteriorWorldLeak(playerid);
    for(new i = 0; i < 10; i++)
    {
        if(IsPlayerAttachedObjectSlotUsed(playerid, i))
            RemovePlayerAttachedObject(playerid, i);
    }
    for(new i = 0; i < MAX_INV_SLOTS; i++) {
    PlayerInventory[playerid][i][invID] = 0;
    PlayerInventory[playerid][i][invItem] = 0;
    PlayerInventory[playerid][i][invCount] = 0;
    PlayerInventory[playerid][i][invValue] = 0;
}
    GibddResetPlayer(playerid);
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
{
    if(VehicleInfo[playerid][i][vSpawned])
    {
        DestroyVehicle(VehicleInfo[playerid][i][vID]);
        VehicleInfo[playerid][i][vSpawned] = false;
    }
}
    if(Player[playerid][pAdminVeh] != INVALID_VEHICLE_ID) DestroyVehicle(Player[playerid][pAdminVeh]);

    return 1;
}

public OnPlayerDeath(playerid, killerid, reason)
{
    #pragma unused reason
    #if defined _FAMILY_ADDITION_INC_
    FamilyAddition_OnDeath(playerid, killerid);
    #endif
    if(g_HospitalDeathPending[playerid])
        return 1;
    if(Hospital_OnPlayerDeath(playerid, killerid))
        return 1;
    if(Player[playerid][pID] > 0 && Player[playerid][pHospitalUnfinished] != 1
        && !Hospital_PlayerCanWound(playerid))
        SetTimerEx("SpawnLoc_ReviveFromAccidentalDeath", 50, false, "i", playerid);
    return 1;
}

public OnPlayerSpawn(playerid)
{
    // ˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜/˜˜˜˜˜˜ ˜ CEF ˜˜˜˜˜˜˜˜˜˜˜: ˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜.
    if(Player[playerid][pID] == 0)
    {
        if(GetPVarInt(playerid, "auth_reg_flow"))
        {
            TogglePlayerSpectating(playerid, false);
            TogglePlayerControllable(playerid, false);
            return 1;
        }
        TogglePlayerSpectating(playerid, true);
        TogglePlayerControllable(playerid, false);
        return 1;
    }

    if(GetPVarInt(playerid, "spawn_gui_active") || GetPVarInt(playerid, "spawn_resolving"))
    {
        TogglePlayerControllable(playerid, false);
        return 1;
    }

    if(Player[playerid][pHospitalUnfinished] == 1 || g_HospitalSessionActive[playerid])
    {
        TogglePlayerControllable(playerid, false);
        return 1;
    }

    if(Hospital_OnPlayerSpawn(playerid))
        return 1;

    if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
    {
        if(!Player_IsInValidInteriorWorld(playerid))
        {
            if(g_HospitalSessionActive[playerid] || Player[playerid][pHospitalUnfinished] == 1)
                return 1;
            if(GetPVarType(playerid, "InHouseID"))
            {
                new hid = GetPVarInt(playerid, "InHouseID");
                if(hid >= 0 && hid < TotalHouses)
                {
                    House_TeleportPlayerToInterior(playerid, hid);
                    return 1;
                }
            }
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);
            new r = random(sizeof(RandomSpawns));
            SetPlayerPos(playerid, RandomSpawns[r][0], RandomSpawns[r][1], RandomSpawns[r][2]);
            SetPlayerFacingAngle(playerid, RandomSpawns[r][3]);
        }
    }

    if(Admin_IsSpectating(playerid))
        Admin_StopSpectate(playerid);

#if X2_SYSTEM
    SetPlayerX2(playerid, true, 0);
#endif
	SetPlayerInBiz(playerid, -1);
	Shop247_OnExitBiz(playerid);
	GibddResetPlayer(playerid);
	if(Player[playerid][pHospitalUnfinished] != 1 && !g_HospitalSessionActive[playerid])
		Player_FixInteriorWorldLeak(playerid);
    #if defined _FAMILY_ADDITION_INC_
    FamilyAddition_OnSpawn(playerid);
    #endif
    if(!GetPVarInt(playerid, "spawn_gui_active") && !GetPVarInt(playerid, "spawn_resolving"))
        Inv_TryApplyWornAccessories(playerid);
    Kvest_OnPlayerSpawn(playerid);
    return 1;
}

public conti_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    BR_FixDialogInput(inputtext);

    if(dialogid == DIALOG_ACCOUNT_BAN)
    {
        if(Player[playerid][pID] > 0) return 1;
        Auth_ReopenLoginAfterBan(playerid);
        return 1;
    }
    if(HandleAdminToolsDialog(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(LairdBiz_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(LairdHouse_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(Fuel_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(Phone_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(Bank_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(GPS_OnDialogResponse(playerid, dialogid, response, listitem)) return 1;
    if(Gibdd_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(ScooterRent_HandleDialog(playerid, dialogid, response, listitem)) return 1;
    if(VehicleMusic_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(CarSell_OnDialogResponse(playerid, dialogid, response)) return 1;
    if(dialogid == DIALOG_FAMILY_CREATE)
    {
        Family_OnCreateDialog(playerid, response, inputtext);
        return 1;
    }
    if(Family_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(MinerJob_OnDialogResponse(playerid, dialogid, response, listitem)) return 1;

    if(dialogid == DIALOG_PROMO_MAIN)
        {
            if(!response) return 1;
            if(listitem == 0) // ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜
            {
                ShowPlayerDialog(playerid, ENTER_PROMOCODE, DIALOG_STYLE_INPUT,
                    "{E0584B}˜˜˜˜˜˜˜˜",
                    "{FFFFFF}˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜:",
                    "˜˜˜˜˜˜", "˜˜˜˜˜");
            }
        }
    if(dialogid == ENTER_PROMOCODE)
{
    if(!response) return 1;
    if(isnull(inputtext))
    {
        return ShowPlayerDialog(playerid, ENTER_PROMOCODE, DIALOG_STYLE_INPUT,
            "{E0584B}˜˜˜˜˜˜˜˜",
            "{FFFFFF}˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜:",
            "˜˜˜˜˜˜", "˜˜˜˜˜");
    }

    new msg[800];
	msg[0] = '\0';
    format(msg, sizeof(msg),
        "{FFFFFF}˜˜˜˜˜˜˜˜˜˜˜!\n\n\
        ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ {FFFF00}#%s{FFFFFF}.\n\n\
        ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜˜ {FFFF00}1{FFFFFF} ˜˜˜˜˜ ˜˜˜˜, ˜˜ ˜˜˜˜˜˜˜˜:\n\
        {E0584B}1. {FFFF00}VIP Gold {FFFFFF}˜˜ {FFFF00}12 {FFFFFF}˜.\n\
        {E0584B}2. {FFFFFF}˜˜˜˜˜˜˜˜˜˜ {FFFF00}BMW M5 F90 {FFFFFF}˜˜ {FFFF00}12 {FFFFFF}˜.\n\
        {E0584B}3. {FFFF00}15.000 {FFFFFF}˜˜˜˜˜˜\n\
        {E0584B}4. {FFFFFF}˜˜˜˜ {FFFF00}99 {FFFFFF}˜˜ {FFFF00}12 {FFFFFF}˜.\n\
        {E0584B}5. {FFFFFF}˜˜˜˜˜˜˜˜˜ {FFFF00}˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ {FFFFFF}˜˜ {FFFF00}12 {FFFFFF}˜.\n\n\
        ˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ - /promo -> ˜˜˜˜˜˜˜ ˜˜˜˜˜\n\n\
        ˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜ {E0584B}BR BLACK STUDIO!", inputtext);

    ShowPlayerDialog(playerid, PROMO_PRISE, DIALOG_STYLE_MSGBOX, "{E0584B}BR BLACK STUDIO{FFFFFF} | ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜", msg, "˜˜˜˜˜˜˜", "");
    return 1;
}
    if(dialogid == DIALOG_MAP_TP)
    {
        if(response)
        {
            if(Player[playerid][pAdminAuth] && Player[playerid][pAdminLvl] >= 1)
            {
                new vehicleid = GetPlayerVehicleID(playerid);
                new interior = GetPlayerInterior(playerid);
                new virtualworld = GetPlayerVirtualWorld(playerid);

                if(IsPlayerInAnyVehicle(playerid))
                {
                    SetVehiclePos(vehicleid, MapTPPos[playerid][0], MapTPPos[playerid][1], MapTPPos[playerid][2]);
                    SetVehicleVirtualWorld(vehicleid, virtualworld);
                    LinkVehicleToInterior(vehicleid, interior);
                }
                else
                {
                    SetPlayerPos(playerid, MapTPPos[playerid][0], MapTPPos[playerid][1], MapTPPos[playerid][2]);
                }

                SetPlayerInterior(playerid, interior);
                SetPlayerVirtualWorld(playerid, virtualworld);

                SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.");
            }
        }
        return 1;
    }
	if(dialogid == DIALOG_BUY_CAR_CONFIRM)
	{
		if(!response) return 1;

		new id = GetPVarInt(playerid, "BuyCarID");
		new slot = Player_FindFreeCarSlot(playerid);

		if(slot == -1)
		{
			new slot_msg[160];
			Player_FillNoCarSlotMessage(playerid, slot_msg, sizeof slot_msg);
			return SendClientMessage(playerid, COLOR_RED, slot_msg);
		}

		new car_model, car_price;
		if(p_SalonType[playerid] == 0) {
			car_model = SalonCars[id][sModel];
			car_price = SalonCars[id][sPrice];
		} else if(p_SalonType[playerid] == 1) {
			car_model = MediumSalonCars[id][sModel];
			car_price = MediumSalonCars[id][sPrice];
		} else {
			car_model = LowSalonCars[id][sModel];
			car_price = LowSalonCars[id][sPrice];
		}

		if(Player[playerid][pMoney] < car_price) return SendClientMessage(playerid, COLOR_RED, "[˜˜˜˜˜˜˜˜˜] ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜!");

		GivePlayerMoneyEx(playerid, -car_price);

		VehicleInfo_ClearSlot(playerid, slot, false);
		VehicleInfo[playerid][slot][vModel] = car_model;
		VehicleInfo[playerid][slot][vPrice] = car_price;
		VehicleInfo[playerid][slot][vColor][0] = p_SalonColor[playerid][0];
		VehicleInfo[playerid][slot][vColor][1] = p_SalonColor[playerid][1];
		VehicleInfo[playerid][slot][vBodyColor] = 0;
		VehicleInfo[playerid][slot][vDiskColor] = 0;
		VehicleInfo[playerid][slot][vVinyl][0] = '\0';
		VehicleInfo[playerid][slot][vSpawned] = true;
		VehicleInfo[playerid][slot][vNitro] = 0;

		new query[512];
		mysql_format(db_handle, query, sizeof(query),
			"INSERT INTO `ownable_cars` (`owner_id`, `owner_name`, `model`, `price`, `color1`, `color2`, `body_color`, `disk_color`, `wheel`, `vinyl`, `nitro`, `x`, `y`, `z`, `a`) \
			VALUES (%d, '%e', %d, %d, %d, %d, %d, %d, %d, '', 0, 0, 0, 0, 0)",
			Player[playerid][pID], Player[playerid][pName], car_model, car_price,
			p_SalonColor[playerid][0], p_SalonColor[playerid][1],
			VehicleInfo[playerid][slot][vBodyColor], VehicleInfo[playerid][slot][vDiskColor],
			VehicleInfo[playerid][slot][vWheel]);

		mysql_tquery(db_handle, query, "OnCarPurchased", "ii", playerid, slot);

		DeletePVar(playerid, "BuyCarID");
		HideAvtosalon(playerid);
		return 1;
	}
	else if(dialogid == DIALOG_MY_CARS)
{
    if(!response) return 1;

    new page = GetPVarInt(playerid, "CarMenuPage");
    new total_cars = 0;
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++) {
        if(VehicleInfo[playerid][i][vModel] != 0) total_cars++;
    }

    new cars_on_page = 0;
    new start_idx = page * 10;

    if(total_cars > start_idx) {
        cars_on_page = total_cars - start_idx;
        if(cars_on_page > 10) cars_on_page = 10;
    }

    if(listitem == cars_on_page)
    {
        if(total_cars > (page + 1) * 10) return ShowPlayerCars(playerid, page + 1);
        else return ShowPlayerCars(playerid, page - 1);
    }
    if(listitem == cars_on_page + 1) 
    {
        return ShowPlayerCars(playerid, page - 1);
    }

    new car_slot = -1, found_idx = 0, current_list_idx = 0;
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(!CarSystem_IsPersonalGarageSlot(playerid, i)) continue;

        if(found_idx >= start_idx && found_idx < start_idx + 10)
        {
            if(listitem == current_list_idx)
            {
                car_slot = i;
                break;
            }
            current_list_idx++;
        }
        found_idx++;
    }

    if(car_slot != -1)
    {
        SetPVarInt(playerid, "SelectedCarSlot", car_slot);
        ShowCarActionMenu(playerid, car_slot);
    }
    return 1;
}
	else if(dialogid == DIALOG_CAR_ACTION)
	{
		if(!response)
		{
			if(VehicleInfo[playerid][GetPVarInt(playerid, "SelectedCarSlot")][vSpawned]) return 1;
			return ShowPlayerCars(playerid, GetPVarInt(playerid, "CarMenuPage"));
		}

		new slot = GetPVarInt(playerid, "SelectedCarSlot");
		new bool:spawned = VehicleInfo[playerid][slot][vSpawned];

		switch(listitem)
		{
			case 0: // ˜˜˜˜˜˜˜˜ ˜˜ GPS
			{
				if(!spawned || VehicleInfo[playerid][slot][vID] == INVALID_VEHICLE_ID)
				{
					ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜!", "");
					ShowCarActionMenu(playerid, slot);
					return 1;
				}
				new Float:x, Float:y, Float:z;
				GetVehiclePos(VehicleInfo[playerid][slot][vID], x, y, z);
				SetGPSMarker(playerid, x, y, z);
			}
			case 1: // ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ (vPos)
			{
				if(spawned) { ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜.", ""); return ShowCarActionMenu(playerid, slot); }
				CarSystem_LoadVehicle(playerid, slot, false /* useLast */);
			}
			case 2: // ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜
			{
				if(spawned) { ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜.", ""); return ShowCarActionMenu(playerid, slot); }
				if(!VehicleInfo[playerid][slot][vLastValid])
				{
					ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.", "");
					return ShowCarActionMenu(playerid, slot);
				}
				CarSystem_LoadVehicle(playerid, slot, true /* useLast */);
			}
			case 3: // ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜
			{
				if(!spawned) { ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜.", ""); return ShowCarActionMenu(playerid, slot); }
				CarSystem_UnloadVehicle(playerid, slot);
			}
			case 4: // ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜
			{
				ShowCarSettingsMenu(playerid, slot);
				return 1;
			}
			case 5: // ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜
			{
				if(!spawned || VehicleInfo[playerid][slot][vID] == INVALID_VEHICLE_ID)
				{
					ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜!", "");
					return ShowCarActionMenu(playerid, slot);
				}
				if(VehicleInfo[playerid][slot][vPlateType] == 0 || strlen(VehicleInfo[playerid][slot][vPlateNumber]) == 0)
				{
					ShowNotification(playerid, 0, 5, 0, 0, "˜˜ ˜˜˜˜ ˜˜˜˜ ˜˜˜ ˜˜˜. ˜˜˜˜˜.", "");
					return ShowCarActionMenu(playerid, slot);
				}
				// ˜˜˜˜˜˜˜ ˜˜˜˜ ˜ ˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜.
				new country = (VehicleInfo[playerid][slot][vPlateType] - 1);
				if(country < 0 || country > 3) country = 0;
				new plate_num[12], plate_reg[8];
				format(plate_num, sizeof plate_num, "%s", VehicleInfo[playerid][slot][vPlateNumber]);
				format(plate_reg, sizeof plate_reg, "%s", VehicleInfo[playerid][slot][vPlateRegion]);

				new added = GivePlayerPlateItem(playerid, country, plate_num, plate_reg);
				if(added < 0)
				{
					ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜.", "");
					return ShowCarActionMenu(playerid, slot);
				}

				Gibdd_RemoveVehiclePlate(playerid, slot);

				new msg[128];
				format(msg, sizeof msg, "˜˜˜˜˜˜˜˜ ˜˜˜˜ %s %s ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜.", plate_num, plate_reg);
				ShowNotification(playerid, 1, 5, 0, 1, msg, "");
			}
			case 6:
			{
				if(Player[playerid][pFamilyId] > 0 && Player[playerid][pFamilyLeader])
					Family_TryAddFleetFromCarMenu(playerid, slot);
				return 1;
			}
		}
		return 1;
	}
	else if(dialogid == DIALOG_CAR_SETTINGS)
	{
		new slot = GetPVarInt(playerid, "SelectedCarSlot");
		if(!response) return ShowCarActionMenu(playerid, slot);

		// ˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜, ˜˜˜˜˜
		// OnPlayerStateChange ˜˜ ˜˜˜˜˜˜˜˜˜ (˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜ PLAYER_STATE_DRIVER).
		new cur_vehicle = GetPlayerVehicleID(playerid);
		new bool:driving_this_car = (cur_vehicle != INVALID_VEHICLE_ID &&
			VehicleInfo[playerid][slot][vSpawned] &&
			VehicleInfo[playerid][slot][vID] == cur_vehicle &&
			GetPlayerState(playerid) == PLAYER_STATE_DRIVER);

		switch(listitem)
		{
			case 0: // ˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜
			{
				VehicleInfo[playerid][slot][vAutoEngine] = !VehicleInfo[playerid][slot][vAutoEngine];
				new bool:on = VehicleInfo[playerid][slot][vAutoEngine];

				// ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜: ON -> ˜˜˜˜˜˜˜ ˜˜˜˜˜˜, OFF ˜˜ ˜˜˜˜˜˜ (˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜).
				if(on && driving_this_car && !GetVehicleParam(cur_vehicle, V_ENGINE))
					SetVehicleParam(cur_vehicle, V_ENGINE, 1);

				ShowNotification(playerid, 1, 4, 0, 1,
					on ? "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜." : "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜.", "");
			}
			case 1: // ˜˜˜˜-˜˜˜˜˜ ˜˜˜˜˜˜ >40 ˜˜/˜
			{
				VehicleInfo[playerid][slot][vAutoLock] = !VehicleInfo[playerid][slot][vAutoLock];
				new bool:on = VehicleInfo[playerid][slot][vAutoLock];

				// ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜: OFF -> ˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ (˜˜˜˜˜˜˜ UX).
				// ON ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜ ˜˜˜ v>40 ˜ Fuel_HudTick (1Hz).
				if(!on && driving_this_car && GetVehicleParam(cur_vehicle, V_LOCK))
					SetVehicleParam(cur_vehicle, V_LOCK, 0);

				ShowNotification(playerid, 1, 4, 0, 1,
					on ? "˜˜˜˜-˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜." : "˜˜˜˜-˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.", "");
			}
		}

		new q[200];
		mysql_format(db_handle, q, sizeof q,
			"UPDATE `ownable_cars` SET `auto_engine`=%d, `auto_lock`=%d WHERE `id`=%d",
			(VehicleInfo[playerid][slot][vAutoEngine] ? 1 : 0),
			(VehicleInfo[playerid][slot][vAutoLock]   ? 1 : 0),
			VehicleInfo[playerid][slot][vDBID]);
		mysql_tquery(db_handle, q, "", "");

		ShowCarSettingsMenu(playerid, slot);
		return 1;
	}
	else if(dialogid == DIALOG_ADMIN_REG)
	{
		if(!response) return 1;
		if(strlen(inputtext) != 4 || strval(inputtext) < 1000) return ShowAdminLogin(playerid);

		Player[playerid][pAdminPass] = strval(inputtext);
		TogglePlayerControllable(playerid, true);
		SavePlayerAccount(playerid);
		ShowAdminLogin(playerid);
		return 1;
	}
	else if(dialogid == DIALOG_ADMIN_LOGIN)
	{
		if(!response) return 1;
		if(strval(inputtext) != Player[playerid][pAdminPass]) return ShowAdminLogin(playerid);

		Player[playerid][pAdminAuth] = true;
		TogglePlayerControllable(playerid, true);
		new str[128];
		format(str, sizeof(str), "[A] %s %s[%d] ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜-˜˜˜˜˜˜.", Player[playerid][pAdminPrefix], Player[playerid][pName], playerid);
		SendAdminMessage(COLOR_GREY, str);
		return 1;
	}
	return 0;
}

public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
    if(LairdBiz_OnEnterCP(playerid, checkpointid)) return 1;
    // ˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜.
    if(Gibdd_OnEnterCP(playerid, STREAMER_TAG_CP:checkpointid)) return 1;
    if(MinerJob_OnEnterCP(playerid, STREAMER_TAG_CP:checkpointid)) return 1;
    return 1;
}

public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
{
    if(!MinerJob_OnTakeDamage(playerid, issuerid, amount, weaponid, bodypart))
        return 0;
    if(!Bank_OnTakeDamage(playerid, issuerid, amount, weaponid, bodypart))
        return 0;
    if(!Hospital_OnTakeDamage(playerid, issuerid, amount, weaponid, bodypart))
        return 0;
    // PvP: ˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜ laird (˜˜˜˜˜, ˜˜˜, ˜˜˜˜, ˜˜˜˜ ˜ ˜˜. ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ TakeDamage).
    if(issuerid != INVALID_PLAYER_ID && IsPlayerConnected(issuerid) && issuerid != playerid)
    {
        BR_ProcessPvPHit(playerid, issuerid, weaponid, 0.0, amount);
        return 0;
    }
    return 1;
}

public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
    #pragma unused bodypart
    if(!MinerJob_OnGiveDamage(playerid, damagedid, amount, weaponid, bodypart))
        return 0;
    if(!Bank_OnGiveDamage(playerid, damagedid, amount, weaponid, bodypart))
        return 0;
    if(!Hospital_OnGiveDamage(playerid, damagedid, amount, weaponid, bodypart))
        return 0;

    if(damagedid != INVALID_PLAYER_ID && IsPlayerConnected(damagedid))
        BR_ProcessPvPHit(damagedid, playerid, weaponid, 0.0, amount);
    return 0;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    if(!MinerJob_OnWeaponShot(playerid, weaponid, hittype, hitid, fX, fY, fZ))
        return 0;
    if(!Bank_OnWeaponShot(playerid, weaponid, hittype, hitid, fX, fY, fZ))
        return 0;
    if(!Hospital_OnWeaponShot(playerid, weaponid, hittype, hitid, fX, fY, fZ))
        return 0;
    return 1;
}

