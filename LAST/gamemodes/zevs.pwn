    );

    ShowPlayerDialog(viewerid, AT_DIALOG_PASSPORT, DIALOG_STYLE_MSGBOX,
        "{E0584B}BR BLACK STUDIO{FFFFFF} | ˜˜˜˜˜˜˜",
        body, "˜˜˜˜˜˜˜", "");
    return 1;
}

CMD:pass(playerid, params[])
{
    if(Player[playerid][pID] <= 0)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜.");

    new targetid;
    if(sscanf(params, "u", targetid))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /pass [id ˜˜˜˜˜˜]");

    if(!IsPlayerConnected(targetid) || Player[targetid][pID] <= 0)
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜.");

    if(targetid != playerid && !Pass_IsPlayerNear(playerid, targetid))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜.");

    return Pass_SendOffer(playerid, targetid);
}

stock Lic_TimestampToDate(unix_timestamp, &year, &month, &day)
{
    new hour, minute, second;
    year = unix_timestamp / 31557600;
    unix_timestamp -= year * 31557600;
    year += 1970;

    if(year % 4 == 0) unix_timestamp -= 21600;

    day = unix_timestamp / 86400;

    switch(day)
    {
        case 0..30:   { second = day;       month = 1; }
        case 31..58:  { second = day - 31;  month = 2; }
        case 59..89:  { second = day - 59;  month = 3; }
        case 90..119: { second = day - 90;  month = 4; }
        case 120..150:{ second = day - 120; month = 5; }
        case 151..180:{ second = day - 151; month = 6; }
        case 181..211:{ second = day - 181; month = 7; }
        case 212..242:{ second = day - 212; month = 8; }
        case 243..272:{ second = day - 243; month = 9; }
        case 273..303:{ second = day - 273; month = 10; }
        case 304..333:{ second = day - 304; month = 11; }
        default:      { second = day - 334; month = 12; }
    }
    day = second;
    #pragma unused hour, minute, second
}

stock Lic_FormatExpire(expire_unix, dest[], size)
{
    if(expire_unix <= gettime())
    {
        format(dest, size, "-");
        return 0;
    }

    new year, month, day;
    Lic_TimestampToDate(expire_unix, year, month, day);
    format(dest, size, "˜˜ %02d.%02d.%d", day, month, year);
    return 1;
}

stock Lic_AppendRow(list[], size, idx, const name[], expire_unix)
{
    new details[24], status[20];
    Lic_FormatExpire(expire_unix, details, sizeof(details));

    if(expire_unix > gettime())
        format(status, sizeof(status), "{66FF66}˜˜˜˜˜˜˜");
    else
        format(status, sizeof(status), "{FF6666}˜˜˜˜˜˜˜˜˜˜˜");

    format(list, size, "%s#%d\t%s\t%s\t%s\n", list, idx, name, status, details);
}

