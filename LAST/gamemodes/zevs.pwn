// ----- begin: _stop_audio_stream -----
stock StopAudioStreamURL(playerid)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_INT32, 1);
    BS_WriteValue(bs, PR_UINT8, 0);
    BS_WriteValue(bs, PR_INT32, 0);
    BS_WriteValue(bs, PR_FLOAT, 0.0);
    BS_WriteValue(bs, PR_UINT8, 1);
    PR_SendRPC(bs, playerid, 41, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}
// ----- end: _stop_audio_stream -----

// ----- begin: vehicle_music.inc -----
// ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ (˜˜˜˜˜ / ˜˜˜˜˜˜˜˜) ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ BR BLACK STUDIO
// ˜˜˜˜˜ ˜˜ ˜˜: ˜˜˜˜ ˜˜˜˜; ˜˜˜˜˜ ˜˜ ˜˜˜˜: ˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜.
// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ /music (˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜).

#define VM_SC "{FFFF00}| {FFFFFF}"
#define VM_URL_LEN 256

new g_VehicleMusicOn[MAX_PLAYERS];
new g_VehicleMusicResumePending[MAX_PLAYERS];
new g_VehicleMusicLastUrl[MAX_PLAYERS][VM_URL_LEN];

stock VehicleMusic_StopPlayback(playerid)
{
    StopAudioStreamURL(playerid);
}

stock VehicleMusic_PlayStream(playerid, const url[])
{
    format(g_VehicleMusicLastUrl[playerid], VM_URL_LEN, "%s", url);
    g_VehicleMusicResumePending[playerid] = 0;
    g_VehicleMusicOn[playerid] = 1;
    PlayAudioStreamURL(playerid, url);
}

stock bool:VehicleMusic_HasSomethingToStop(playerid)
{
    if(g_VehicleMusicOn[playerid]) return true;
    if(g_VehicleMusicResumePending[playerid]) return true;
    return g_VehicleMusicLastUrl[playerid][0] != '\0';
}

stock VehicleMusic_ClearStoredTrack(playerid)
{
    g_VehicleMusicLastUrl[playerid][0] = '\0';
    g_VehicleMusicResumePending[playerid] = 0;
    g_VehicleMusicOn[playerid] = 0;
}

stock VehicleMusic_FullStop(playerid)
{
    VehicleMusic_StopPlayback(playerid);
    VehicleMusic_ClearStoredTrack(playerid);
}

forward VehicleMusic_InMusicTimer(playerid);
public VehicleMusic_InMusicTimer(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    if(!IsPlayerInAnyVehicle(playerid))
    {
        SetTimerEx("VehicleMusic_InMusicTimer", 1500, false, "i", playerid);
        return 1;
    }
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return 1;

    if(g_VehicleMusicResumePending[playerid] && g_VehicleMusicLastUrl[playerid][0] != '\0')
    {
        PlayAudioStreamURL(playerid, g_VehicleMusicLastUrl[playerid]);
        g_VehicleMusicOn[playerid] = 1;
        g_VehicleMusicResumePending[playerid] = 0;
        SendClientMessage(playerid, -1, "" VM_SC "˜˜˜˜˜˜ ˜˜˜˜˜ {FFFFFF}˜˜˜˜˜˜˜˜ ({FFFF00}˜˜˜ ˜˜ ˜˜˜˜˜{FFFFFF}).");
        return 1;
    }

    SendClientMessage(playerid, -1, "" VM_SC "˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜: {FFFF00}/music");
    return 1;
}

stock VehicleMusic_ShowRadioDialog(playerid)
{
    new list[] = CAR_CLR_WHITE "˜˜˜˜˜˜˜˜˜˜˜˜ ˜DFM˜\n" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜˜˜˜˜ ˜Hit FM˜\n" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜";
    ShowPlayerDialog(playerid, DIALOG_VEHICLE_MUSIC_RADIO, DIALOG_STYLE_LIST,
        CAR_DLG_PREFIX "˜˜˜˜˜", list, "˜˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
    return 1;
}

stock VehicleMusic_ShowPlaylistDialog(playerid)
{
    new list[] = CAR_CLR_WHITE "˜˜˜˜˜˜\nBrainrot Rap\nMiyagi & ˜˜˜˜˜˜˜˜ - I Got Love\n˜˜˜˜˜˜\n˜˜˜ ˜˜ 20, ˜˜˜ 27\nMORGENSHTERN - Cadillac\nANNA ASTI - ˜˜ ˜˜˜˜˜\n˜˜˜˜˜\n˜˜˜˜ zolo - ˜˜˜˜˜˜\nMACAN - ˜˜˜˜˜˜˜ 8\n˜˜˜ ˜˜˜#˜\n˜˜˜˜˜˜˜ - 4˜\nMAKSIM - ˜˜˜˜˜˜ ˜˜ ˜˜\nmzlff - ˜˜ ˜˜˜˜˜\n˜˜˜˜˜ ˜˜˜˜˜˜˜˜ - ˜˜˜˜ ˜˜˜˜˜\n˜˜˜˜˜˜˜˜˜ ˜˜˜˜ - ˜˜˜˜ ˜˜˜˜\nFONK 1\nFONK 2\nFONK 3\n˜˜˜˜ ˜˜˜˜ - ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜";
    ShowPlayerDialog(playerid, DIALOG_VEHICLE_MUSIC_PLAYLIST, DIALOG_STYLE_LIST,
