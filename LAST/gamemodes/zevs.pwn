stock bool:IsRewardAllowedByTab(tab_id, reward_type)
{
    // BpRewardsFilterStateEnum (˜ ˜˜˜˜˜˜˜):
    //   1 = ALL, 2 = SKINS, 3 = VIP, 4 = ACCESSORISES,
    //   5 = CARS, 6 = CURRENCIES, 7 = OTHER
    // ˜˜˜˜ ˜˜˜˜˜˜ (˜˜ ENUM_CASE_AWARDS):
    //   1 EXP, 2 ˜˜˜˜˜˜, 5 ˜˜˜˜˜˜˜˜˜, 9 VIP, 10 BC,
    //   11 ˜˜˜˜˜˜˜˜ (˜˜˜˜˜c˜˜˜˜/˜˜˜˜˜˜˜), 23 ˜˜˜˜, 134 ˜˜˜˜
    switch(tab_id)
    {
        case 1: return true;                                  // ˜˜˜
        case 2: return (reward_type == 134);                  // ˜˜˜˜˜
        case 3: return (reward_type == 9);                    // VIP
        case 4: return (reward_type == 11);                   // ˜˜˜˜˜˜˜˜˜˜/˜˜˜˜˜˜˜˜
        case 5: return (reward_type == 5);                    // ˜˜˜˜˜˜˜˜˜
        case 6: return (reward_type == 2 || reward_type == 10 || reward_type == 1); // ˜˜˜˜˜˜/BC/EXP
        case 7:
        {
            // ˜˜˜˜˜˜ ˜ ˜˜, ˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.
            if(reward_type == 5) return false;   // ˜˜˜˜˜˜˜˜˜
            if(reward_type == 9) return false;   // VIP
            if(reward_type == 11) return false;  // ˜˜˜˜˜˜˜˜˜˜
            if(reward_type == 134) return false; // ˜˜˜˜˜
            if(reward_type == 2 || reward_type == 10 || reward_type == 1) return false; // ˜˜˜˜˜˜
            return true;
        }
    }
    return true;
}

