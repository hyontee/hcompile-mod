                new slot_d9 = GetPlayerVehicleSlot(playerid, vehicleid_d9);
                new model_d9 = GetVehicleModel(vehicleid_d9);
                new gos_d9 = Tune_GetSessionGosCost(playerid, vehicleid_d9);
                if(gos_d9 <= 0) gos_d9 = Tune_GetVehicleGosCost(playerid, vehicleid_d9);
                new price_d9 = Sto_GetComponentRepairCost(gos_d9, comp9, model_d9);
                JSON_SetInt(json_packet_data, "t", 9);
                if(slot_d9 != -1 && price_d9 > 0 && GetPlayerMoneyEx(playerid) >= price_d9)
                    JSON_SetInt(json_packet_data, "s", 1);
