stock WL_LoadConfig()
{
    mysql_tquery(db_handle, "SELECT `enabled` FROM `whitelist_config` WHERE `id`=1 LIMIT 1", "OnWhitelistConfigLoad", "");
    return 1;
}

forward OnWhitelistConfigLoad();
public OnWhitelistConfigLoad()
{
    if(cache_num_rows() > 0) gWhitelistEnabled = (cache_get_field_content_int(0, "enabled", db_handle) == 1);
    else
    {
        gWhitelistEnabled = false;
        mysql_tquery(db_handle, "INSERT INTO `whitelist_config` (`id`,`enabled`) VALUES (1,0)", "", "");
    }
    return 1;
}

stock WL_UpdateConfig(playerid, bool:enabled)
{
    new query[128];
    mysql_format(db_handle, query, sizeof(query), "UPDATE `whitelist_config` SET `enabled`=%d WHERE `id`=1 LIMIT 1", enabled ? 1 : 0);
    mysql_tquery(db_handle, query, "", "");
    gWhitelistEnabled = enabled;

    new msg[128];
    format(msg, sizeof(msg), "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜ ˜˜˜˜ %s.", enabled ? "˜˜˜˜˜˜˜" : "˜˜˜˜˜˜˜˜");
    SendClientMessage(playerid, COLOR_WHITE, msg);
    ShowNotification(playerid, enabled ? 1 : 0, 5, 0, 0, enabled ? "˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜." : "˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜.", "");
    return 1;
}

forward OnWhitelistActionDone(playerid);
public OnWhitelistActionDone(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(cache_affected_rows() > 0)
    {
        if(gWhitelistAction[playerid] == 1)
        {
            SendClientMessage(playerid, COLOR_WHITE, "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜.");
            ShowNotification(playerid, 1, 5, 0, 0, "˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜.", "");
        }
        else if(gWhitelistAction[playerid] == 2)
        {
            SendClientMessage(playerid, COLOR_WHITE, "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜.");
            ShowNotification(playerid, 1, 5, 0, 0, "˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜.", "");
        }
    }
    else
    {
        if(gWhitelistAction[playerid] == 1)
        {
            SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.");
            ShowNotification(playerid, 0, 5, 0, 0, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜.", "");
        }
        else if(gWhitelistAction[playerid] == 2)
        {
            SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜.");
            ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜.", "");
        }
    }

    gWhitelistAction[playerid] = 0;
    WL_ShowMainMenu(playerid);
    return 1;
}

stock WL_LoadListPage(playerid, page)
{
    if(page < 0) page = 0;
    SetPVarInt(playerid, "WL_PAGE", page);

    new query[192];
    mysql_format(db_handle, query, sizeof(query),
        "SELECT `nickname`,`post` FROM `server_whitelist` ORDER BY `nickname` ASC LIMIT %d,11",
        page * 10);
    mysql_tquery(db_handle, query, "OnWhitelistListLoaded", "ii", playerid, page);
    return 1;
}

forward OnWhitelistListLoaded(playerid, page);
public OnWhitelistListLoaded(playerid, page)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new rows = cache_num_rows();
    if(rows <= 0 && page == 0)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜ ˜˜˜˜˜˜ whitelist ˜˜˜˜˜˜ ˜˜˜.", "");
        return 1;
    }
    if(rows <= 0 && page > 0)
    {
        new prev_page = page - 1;
        if(prev_page < 0) prev_page = 0;
        return WL_LoadListPage(playerid, prev_page);
    }

    new list[4096], line[144], nick[MAX_PLAYER_NAME], post[46], status[16];
    new shown = rows;
    new bool:has_next = false;
    if(shown > 10)
    {
        shown = 10;
        has_next = true;
    }
    SetPVarInt(playerid, "WL_HAS_NEXT", has_next ? 1 : 0);
    format(list, sizeof(list), "˜˜˜\t˜˜˜˜˜˜˜˜˜\t˜˜˜˜˜˜\n");

    for(new i = 0; i < shown; i++)
    {
        cache_get_field_content(i, "nickname", nick, db_handle, MAX_PLAYER_NAME);
        cache_get_field_content(i, "post", post, db_handle, 46);

        format(status, sizeof(status), "˜˜ ˜ ˜˜˜˜");
        for(new p = 0; p < MAX_PLAYERS; p++)
        {
            if(!IsPlayerConnected(p)) continue;
            if(!strcmp(Player[p][pName], nick, true))
            {
                format(status, sizeof(status), "˜ ˜˜˜˜");
                break;
            }
        }

        format(line, sizeof(line), "%s\t%s\t%s\n", nick, post, status);
        strcat(list, line);
    }
    if(has_next) strcat(list, "{AAAAAA}>> ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\n");

    ShowPlayerDialog(playerid, AT_DIALOG_WHITELIST_LIST, DIALOG_STYLE_TABLIST_HEADERS,
        "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜", list, "˜˜˜˜˜", "˜˜˜˜˜");
    return 1;
}

