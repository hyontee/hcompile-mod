				SendClientMessage(playerid, 0xFF5252FF, "˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜ 0.");
				return true;
			}

			new slot = g_business_loaded;
			new interior = GetAddBizInteriorByType(type);
			new Float:x, Float:y, Float:z, Float:a;
			GetPlayerPos(playerid, x, y, z);
			GetPlayerFacingAngle(playerid, a);

			g_business[slot][B_SQL_ID] = -1;
			g_business[slot][B_OWNER_ID] = 0;
			GetAddBizNameByType(type, g_business[slot][B_NAME], 64);
			format(g_business[slot][B_OWNER_NAME], BIZ_OWNER_NAME_LEN, "None");
			g_business[slot][B_IMPROVEMENTS] = 0;
			g_business[slot][B_PRODS] = 0;
			g_business[slot][B_PROD_PRICE] = 0;
			g_business[slot][B_BALANCE] = 0;
			g_business[slot][B_RENT_DATE] = 0;
			g_business[slot][B_PRICE] = price;
			g_business[slot][B_RENT_PRICE] = rent_price;
			g_business[slot][B_TYPE] = type;
			g_business[slot][B_INTERIOR] = interior;
			g_business[slot][B_ENTER_PRICE] = 0;
			g_business[slot][B_ENTER_MUSIC] = 0;
			g_business[slot][B_LOCK_STATUS] = false;
			g_business[slot][B_POS_X] = x;
			g_business[slot][B_POS_Y] = y;
			g_business[slot][B_POS_Z] = z;
			g_business[slot][B_EXIT_POS_X] = x;
			g_business[slot][B_EXIT_POS_Y] = y;
			g_business[slot][B_EXIT_POS_Z] = z;
			g_business[slot][B_EXIT_ANGLE] = a;
			g_business[slot][B_ORDER_ID] = -1;
			g_business[slot][B_EVICTION] = 0;
			g_business[slot][B_HEALTH_PICKUP] = 0;
			g_business[slot][B_ENTER_PICKUP] = 0;
			g_business[slot][B_LABEL] = Text3D:0;

			BusinessSpawnWorldObjects(slot);
			g_business_loaded++;

			new fsx[24], fsy[24], fsz[24], fex[24], fey[24], fez[24], fsa[24];
			format(fsx, sizeof fsx, "%.4f", x);
			format(fsy, sizeof fsy, "%.4f", y);
			format(fsz, sizeof fsz, "%.4f", z);
			format(fex, sizeof fex, "%.4f", x);
			format(fey, sizeof fey, "%.4f", y);
			format(fez, sizeof fez, "%.4f", z);
			format(fsa, sizeof fsa, "%.4f", a);

			new query[512];
			mysql_format(db_handle, query, sizeof query,
				"INSERT INTO `business` (`owner_id`,`name`,`improvements`,`products`,`prod_price`,`balance`,`rent_time`,`price`,`rent_price`,`type`,`interior`,`enter_price`,`enter_music`,`lock`,`x`,`y`,`z`,`exit_x`,`exit_y`,`exit_z`,`exit_angle`,`eviction`) VALUES (0,'%e',0,0,0,0,0,%d,%d,%d,%d,0,0,0,%s,%s,%s,%s,%s,%s,%s,0)",
				g_business[slot][B_NAME], price, rent_price, type, interior, fsx, fsy, fsz, fex, fey, fez, fsa);
			mysql_tquery(db_handle, query, "OnBusinessCreated", "ii", playerid, slot);

			SendClientMessage(playerid, 0xFFCD00FF, "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜...");

			DeletePVar(playerid, "AddBizType");
			DeletePVar(playerid, "AddBizPrice");
			DeletePVar(playerid, "AddBizRent");
			DeletePVar(playerid, "AddBizName");
			return true;
		}
		case DIALOG_BIZ_DEL_ID:
