stock CarPass_FormatPlateLine(ownerid, slot, dest[], size)
{
    if(VehicleInfo[ownerid][slot][vPlateType] > 0 && strlen(VehicleInfo[ownerid][slot][vPlateNumber]) > 0)
    {
        if(strlen(VehicleInfo[ownerid][slot][vPlateRegion]) > 0)
            format(dest, size, "%s [%s]", VehicleInfo[ownerid][slot][vPlateNumber], VehicleInfo[ownerid][slot][vPlateRegion]);
        else
            format(dest, size, "%s", VehicleInfo[ownerid][slot][vPlateNumber]);
    }
    else
    {
        new reg = 0;
        if(strlen(VehicleInfo[ownerid][slot][vPlateRegion]) > 0)
            reg = strval(VehicleInfo[ownerid][slot][vPlateRegion]);
        else if(VehicleInfo[ownerid][slot][vDBID] > 0)
            reg = VehicleInfo[ownerid][slot][vDBID] % 100;
        if(reg <= 0) reg = 52;
        format(dest, size, "------ [%d]", reg);
    }
    return 1;
}

// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ (v*A), ˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.
stock CarPass_GetActiveFirmwareLabel(ownerid, slot, dest[], size)
{
    if(VehicleInfo[ownerid][slot][vDriftA])
        format(dest, size, "˜˜˜˜˜");
    else if(VehicleInfo[ownerid][slot][vComfortA])
        format(dest, size, "˜˜˜˜˜˜˜");
    else if(VehicleInfo[ownerid][slot][vSportA])
        format(dest, size, "˜˜˜˜˜");
    else if(VehicleInfo[ownerid][slot][vSportPlusA])
        format(dest, size, "˜˜˜˜˜+");
    else
        format(dest, size, "None");
    return 1;
}

stock CarPass_GetNitroLabel(ownerid, slot, dest[], size)
{
    switch(VehicleInfo[ownerid][slot][vNitro])
    {
        case 1: format(dest, size, "2x");
        case 2: format(dest, size, "5x");
        case 3: format(dest, size, "10x");
        default: format(dest, size, "˜˜ ˜˜˜˜˜˜˜˜˜˜˜");
    }
    return 1;
}

stock CarPass_GetPerfIndex(ownerid, slot)
{
    new score = 200;
    if(VehicleInfo[ownerid][slot][vDriftA])      score += 143;
    else if(VehicleInfo[ownerid][slot][vComfortA])   score += 80;
    else if(VehicleInfo[ownerid][slot][vSportA])     score += 110;
    else if(VehicleInfo[ownerid][slot][vSportPlusA]) score += 140;
    if(score < 1) score = 1;
    return score;
}

stock CarPass_AppendRow(list[], size, const label[], const value[], bool:owner_row = false)
{
    if(owner_row)
        format(list, size, "%s{FFFFFF}%s\t{E0584B}%s\n", list, label, value);
    else
        format(list, size, "%s{FFFFFF}%s\t{FFCC00}%s\n", list, label, value);
    return 1;
}

stock CarPass_ShowDialog(viewerid, ownerid, slot)
{
    if(!IsPlayerConnected(viewerid) || !IsPlayerConnected(ownerid)) return 0;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES || VehicleInfo[ownerid][slot][vModel] == 0) return 0;

    new model = VehicleInfo[ownerid][slot][vModel];
    new car_num = VehicleInfo[ownerid][slot][vDBID];
    if(car_num <= 0) car_num = slot + 1;

    new vname[48], plate[32], firmware[48], nitro[24], pdv[24], radar[24];
    new transport[64], mileage[24], gos_str[32], perf[24], done_date[16];
    new list[2400];
    new gos = Tune_ResolveVehicleGosCost(ownerid, slot, model);
    if(gos < 1) gos = GetVehiclePriceByModel(model);

    format(vname, sizeof(vname), "%s", GetVehicleNameByModel(model));
    format(transport, sizeof(transport), "%s [%d]", vname, car_num);
    CarPass_FormatPlateLine(ownerid, slot, plate, sizeof(plate));
    CarPass_GetActiveFirmwareLabel(ownerid, slot, firmware, sizeof(firmware));
    CarPass_GetNitroLabel(ownerid, slot, nitro, sizeof(nitro));

    if(VehicleInfo[ownerid][slot][vDalniysvet] > 0 || VehicleInfo[ownerid][slot][vHydra] > 0)
        format(pdv, sizeof(pdv), "˜˜˜˜˜˜˜˜˜˜˜");
    else
        format(pdv, sizeof(pdv), "˜˜ ˜˜˜˜˜˜˜˜˜˜˜");

    format(radar, sizeof(radar), "˜˜ ˜˜˜˜˜˜˜˜˜˜˜");

    new year, month, day;
    Lic_TimestampToDate(gettime(), year, month, day);
    format(done_date, sizeof(done_date), "%d.%d.%d", year, month, day);

    new mileage_km = floatround(gVehicleMileage[ownerid][slot], floatround_floor);
    if(mileage_km < 0) mileage_km = 0;
    format(mileage, sizeof(mileage), "%04d ˜˜.", mileage_km);
    format(gos_str, sizeof(gos_str), "%d ˜˜˜.", gos);
    format(perf, sizeof(perf), "C: %d", CarPass_GetPerfIndex(ownerid, slot));

    format(list, sizeof(list), "{E0584B}˜˜˜˜˜˜˜˜\t{E0584B}˜˜˜˜˜˜˜˜\n");

    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜˜˜˜:", Player[ownerid][pName], true);
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜˜˜˜˜:", transport);
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜:", plate);
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜˜:", mileage);
    CarPass_AppendRow(list, sizeof(list), "˜˜˜. ˜˜˜˜˜˜˜˜˜:", gos_str);

    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜˜˜˜:", firmware);
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜:", perf);
    CarPass_AppendRow(list, sizeof(list), "˜˜˜ ˜˜˜˜˜˜˜:", "98");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜:", nitro);
    CarPass_AppendRow(list, sizeof(list), "˜˜˜:", pdv);

    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜˜˜˜˜:", radar);
    format(list, sizeof(list), "%s{FFFFFF}-\t{FFCC00}-\n", list);
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜˜˜˜˜˜˜:", "");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜:", "0 ˜˜ 10000");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜:", "0 ˜˜ 3000");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜:", "0 ˜˜ 10000");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜:", "0 ˜˜ 10000");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜:", "0 ˜˜ 12400");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜:", "0 ˜˜ 7000");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜:", "0 ˜˜ 100");
    CarPass_AppendRow(list, sizeof(list), "˜˜˜˜˜˜˜˜˜:", done_date);

    ShowPlayerDialog(viewerid, AT_DIALOG_CARPASS, DIALOG_STYLE_TABLIST_HEADERS,
        "{FFCC00}˜˜˜. ˜˜˜˜˜˜˜",
        list, "˜˜˜˜˜˜˜", "");

    if(viewerid != ownerid)
    {
        new msg[128];
        format(msg, sizeof(msg), "{BD7BFF}%s ˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜. ˜˜˜˜˜˜˜", Player[ownerid][pName]);
        SendClientMessage(viewerid, -1, msg);
    }
    return 1;
}

stock CarPass_SendOffer(playerid, targetid, slot)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid)) return 0;
    if(Player[playerid][pID] <= 0 || Player[targetid][pID] <= 0) return 0;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES || VehicleInfo[playerid][slot][vModel] == 0) return 0;

    if(playerid != targetid && !Pass_IsPlayerNear(playerid, targetid))
    {
        SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ (5 ˜).");
        return 0;
    }

    SetPVarInt(targetid, "CarPass_Owner", playerid);
    SetPVarInt(targetid, "CarPass_Slot", slot);

    new msg[160];
    if(playerid == targetid)
        format(msg, sizeof(msg), "˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");
    else
        format(msg, sizeof(msg), "˜˜˜˜˜ %s ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜", Player[playerid][pName]);
    ShowNotification(targetid, 4, 15, NOTIFY_CARPASS_OFFER, playerid, msg, ">>");

    if(playerid == targetid)
        SendClientMessage(playerid, 0x0091FFFF, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ (>>), ˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜˜˜.");
    else
    {
        format(msg, sizeof(msg), "˜˜ ˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜", Player[targetid][pName], targetid);
        SendClientMessage(playerid, 0x0091FFFF, msg);
    }
    return 1;
}

CMD:carpass(playerid, params[])
{
    if(Player[playerid][pID] <= 0)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜.");

    new slot = CarSell_FindDriverSlot(playerid);
    if(slot == -2)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜. ˜˜˜˜˜˜˜˜.");

    if(slot < 0)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ (/car).");

    new targetid;
    if(sscanf(params, "u", targetid))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /carpass [id ˜˜˜˜˜˜]");

    if(!IsPlayerConnected(targetid) || Player[targetid][pID] <= 0)
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜.");

    if(targetid != playerid && !Pass_IsPlayerNear(playerid, targetid))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ (5 ˜).");

    return CarPass_SendOffer(playerid, targetid, slot);
}

CMD:givelic(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 6)
        return SendClientMessage(playerid, COLOR_GREY, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜˜.");

    new targetid, lic_type, days, msg[160];
    if(sscanf(params, "udd", targetid, lic_type, days))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /givelic [id] [˜˜˜ 1-6] [˜˜˜ 0-365]");

    if(!IsPlayerConnected(targetid) || Player[targetid][pID] <= 0)
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜.");

    if(lic_type < 1 || lic_type > 6)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜: 1-A, 2-B, 3-C, 4-D, 5-˜˜˜˜˜˜, 6-˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");

    if(days < 0 || days > 365)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜: 0 ˜ ˜˜˜˜˜˜˜, 1-365 ˜ ˜˜˜˜˜˜.");

    if(!Lic_SetPlayerLicense(targetid, lic_type, days))
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜.");

    new lic_name[32];
    switch(lic_type)
    {
        case 1: lic_name = "A";
        case 2: lic_name = "B";
        case 3: lic_name = "C";
        case 4: lic_name = "D";
        case 5: lic_name = "˜˜˜˜˜˜";
        case 6: lic_name = "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜";
        default: lic_name = "?";
    }

    if(days == 0)
    {
        format(msg, sizeof(msg), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜%s˜ ˜ %s[%d].", lic_name, Player[targetid][pName], targetid);
        SendClientMessage(playerid, -1, msg);
        format(msg, sizeof(msg), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜ ˜˜˜˜˜˜˜˜ ˜%s˜.", lic_name);
        SendClientMessage(targetid, -1, msg);
    }
    else
    {
        format(msg, sizeof(msg), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜ ˜%s˜ ˜˜ %d ˜˜.", Player[targetid][pName], targetid, lic_name, days);
        SendClientMessage(playerid, -1, msg);
        format(msg, sizeof(msg), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜ ˜%s˜ ˜˜ %d ˜˜.", lic_name, days);
        SendClientMessage(targetid, -1, msg);
    }
    return 1;
}

stock GivePlayerWeaponEx(playerid, weaponid, ammo)
{
    if(weaponid < 1 || weaponid > 46) return 0;

    Player[playerid][pWeapon][GetWeaponSlot(weaponid)] = weaponid;
    Player[playerid][pAmmo][GetWeaponSlot(weaponid)] += ammo;

    GivePlayerWeapon(playerid, weaponid, ammo);
    
    return 1;
}
stock GetWeaponSlot(weaponid)
{
    new slot;
    switch(weaponid)
    {
        case 0, 1: slot = 0;
        case 2..9: slot = 1;
        case 10..15: slot = 10;
        case 16..18, 39: slot = 8;
        case 22..24: slot = 2;
        case 25..27: slot = 3;
        case 28, 29, 32: slot = 4;
        case 30, 31: slot = 5;
        case 33, 34: slot = 6;
        case 35..38: slot = 7;
        case 40: slot = 12;
        case 41..43: slot = 9;
        case 44..46: slot = 11;
    }
    return slot;
}

CMD:givegun(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 2) return 1;

    new targetid, weaponid, ammo, str[144];
    if(sscanf(params, "uii", targetid, weaponid, ammo))
        return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /givegun [id] [id ˜˜˜˜˜˜] [˜˜˜˜˜˜˜]");

    if(!IsPlayerConnected(targetid)) return 1;
    if(weaponid < 1 || weaponid > 46)
        return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜ ID ˜˜˜˜˜˜ (1-46).");

    GivePlayerWeapon(targetid, weaponid, ammo);

    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ (ID: %d, ˜˜˜˜˜˜˜: %d).", Player[playerid][pName], playerid, weaponid, ammo);
    SendClientMessage(targetid, ADMIN_COLOR, str);

    format(str, sizeof(str), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜ %d (%d ˜˜˜˜˜˜˜˜).", Player[targetid][pName], targetid, weaponid, ammo);
    SendClientMessage(playerid, -1, str);
    return 1;
}
alias:givegun("gg")

stock GiveSimCard(playerid, simnumber)
{
    if(!IsPlayerConnected(playerid)) return 0;
    Phone_RegisterSim(simnumber, Player[playerid][pID]);
    SetPlayerSimCardSilent(playerid, simnumber);

    new str[64];
    format(str, sizeof(str), "˜˜ ˜˜˜˜˜˜˜˜ SIM: %d (0 ˜˜.)", simnumber);
    ShowNotification(playerid, 1, 5, 0, 1, str, "");
    return 1;
}

