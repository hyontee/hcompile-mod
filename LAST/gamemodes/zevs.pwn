			new biz_name[32];
			GetPVarString(playerid, "AddBizName", biz_name, sizeof biz_name);

			if(type < 1)
			{
				SendClientMessage(playerid, 0xFF5252FF, "˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜ ˜˜˜˜˜˜: /addbiz");
				return true;
