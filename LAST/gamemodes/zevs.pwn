    new Node:t2 = JSON_Object("bi", JSON_Int(2), "bn", JSON_String("˜˜ ˜˜ ˜˜˜˜"), "be", JSON_String("˜˜˜˜˜˜˜˜˜˜˜˜, ˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜ ˜˜˜˜. // ˜˜˜˜˜˜˜˜ ˜˜˜˜"));
    new Node:t3 = JSON_Object("bi", JSON_Int(3), "bn", JSON_String("RolePlay ˜˜˜˜˜"), "be", JSON_String("˜˜˜˜˜˜˜˜˜˜˜˜, ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ RolePlay ˜˜˜˜˜. // ˜˜˜˜˜˜˜˜ ˜˜˜˜"));
    JSON_SetArray(json_response, "bt", JSON_Array(t1, t2, t3));

    OnPacketIncoming(playerid, 66, json_response);
    JSON_Cleanup(json_response);
    return 1;
}
stock AT_HandleReportTemplateReply(playerid, templateId)
{
    new Node:empty = JSON_Object();
    new targetid = AT_ResolveReportTarget(playerid, empty);
    JSON_Cleanup(empty);
    if(targetid == INVALID_PLAYER_ID)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ /ans.", "");
        return 0;
    }

    new msg[128], out_msg[256], admin_name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, admin_name, sizeof(admin_name));

    switch(templateId)
    {
        case 1: msg = "˜˜˜˜˜˜˜˜˜˜˜˜, ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜. // ˜˜˜˜˜˜˜˜ ˜˜˜˜";
        case 2: msg = "˜˜˜˜˜˜˜˜˜˜˜˜, ˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜ ˜˜˜˜. // ˜˜˜˜˜˜˜˜ ˜˜˜˜";
        case 3: msg = "˜˜˜˜˜˜˜˜˜˜˜˜, ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ RolePlay ˜˜˜˜˜. // ˜˜˜˜˜˜˜˜ ˜˜˜˜";
        default: return 0;
    }

    format(out_msg, sizeof(out_msg), "{704214}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s ˜˜˜˜˜˜˜ ˜˜˜: {FFAE42}%s", admin_name, msg);
    SendClientMessage(targetid, -1, out_msg);

    new target_name[MAX_PLAYER_NAME];
    GetPlayerName(targetid, target_name, sizeof(target_name));
    
    new log[256];
    format(log, sizeof(log), "{704214}[A] %s[%d] ˜˜˜˜˜˜˜ %s[%d]:{FFAE42} %s", admin_name, playerid, target_name, targetid, msg);
    SendAdminMessage(-1, log);

    new Node:close_json = JSON_Object();
    JSON_SetInt(close_json, "c", 1);
    OnPacketIncoming(playerid, 66, close_json);
    JSON_Cleanup(close_json);

    DeletePVar(playerid, "ANS_TARGET");
    DeletePVar(playerid, "ANS_TEXT");
    return 1;
}

stock AT_ResolveReportTarget(playerid, Node:packet)
{
    new targetid = GetPVarInt(playerid, "ANS_TARGET");
    if(targetid != INVALID_PLAYER_ID && IsPlayerConnected(targetid))
        return targetid;

    if(JSON_GetType(packet, "id") != JSON_NODE_NULL)
    {
        new fromJson = 0;
        JSON_GetInt(packet, "id", fromJson);
        if(fromJson != INVALID_PLAYER_ID && IsPlayerConnected(fromJson))
        {
            SetPVarInt(playerid, "ANS_TARGET", fromJson);
            return fromJson;
        }
    }

    targetid = GetPVarInt(playerid, "SpectatingID");
    if(targetid != INVALID_PLAYER_ID && IsPlayerConnected(targetid))
    {
        SetPVarInt(playerid, "ANS_TARGET", targetid);
        return targetid;
    }
    return INVALID_PLAYER_ID;
}

stock AT_ExtractReportReplyText(Node:packet, dest[], dest_size)
{
    dest[0] = '\0';

    JSON_GetString(packet, "rt", dest, dest_size);
    if(isnull(dest)) JSON_GetString(packet, "bn", dest, dest_size);
    if(isnull(dest)) JSON_GetString(packet, "be", dest, dest_size);

    BR_FixUserText(dest, dest_size);
    return (strlen(dest) > 0);
}

stock AT_HandleReportCustomReply(playerid, Node:packet)
{
    new rep[256];
    if(!AT_ExtractReportReplyText(packet, rep, sizeof rep))
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜.", "");
        return 0;
    }

    new targetid = AT_ResolveReportTarget(playerid, packet);
    if(targetid == INVALID_PLAYER_ID)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ /ans.", "");
        return 0;
    }

    new a_name[MAX_PLAYER_NAME], t_name[MAX_PLAYER_NAME], out_msg[256];
    GetPlayerName(playerid, a_name, sizeof(a_name));
    GetPlayerName(targetid, t_name, sizeof(t_name));

    format(out_msg, sizeof(out_msg), "{33CCFF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s ˜˜˜˜˜˜˜ ˜˜˜: {FFFFFF}%s", a_name, rep);
    SendClientMessage(targetid, -1, out_msg);

    format(out_msg, sizeof(out_msg), "{704214}[A] %s[%d] ˜˜˜˜˜˜˜ %s[%d]:{FFAE42} %s", a_name, playerid, t_name, targetid, rep);
    SendAdminMessage(-1, out_msg);

    new Node:close_json = JSON_Object();
    JSON_SetInt(close_json, "c", 1);
    OnPacketIncoming(playerid, 66, close_json);
    JSON_Cleanup(close_json);

    DeletePVar(playerid, "ANS_TARGET");
    DeletePVar(playerid, "ANS_TEXT");
    return 1;
}

stock AT_ApplyPunishTemplate(playerid, targetid, templateId)
{
    if(!IsPlayerConnected(targetid)) return 0;
    if(!Admin_CanUsePunishments(playerid)) return 0;
    if(!Admin_CanActOnPlayer(playerid, targetid)) return 0;

    switch(templateId)
    {
        case 1: Admin_DoKick(playerid, targetid, "Afk_no_esc");
        case 2: Admin_DoKick(playerid, targetid, "˜˜˜˜˜˜");
        case 3: Admin_DoKick(playerid, targetid, "˜˜˜");

        case 4: Admin_DoMute(playerid, targetid, 15, "˜˜˜˜˜˜˜˜˜˜˜_˜˜˜˜˜˜˜");
        case 5: Admin_DoMute(playerid, targetid, 30, "˜˜˜˜˜˜˜˜˜˜_˜˜˜˜˜");
        case 6: Admin_DoMute(playerid, targetid, 60, "˜˜˜˜˜˜˜˜˜˜_˜_˜˜˜˜˜˜˜˜˜˜˜˜˜");
        case 7: Admin_DoMute(playerid, targetid, 10, "CAPS");

        case 8: Admin_DoJail(playerid, targetid, 10, "DM_˜˜˜_˜˜˜˜˜˜˜");
        case 9: Admin_DoJail(playerid, targetid, 15, "DB");
        case 10: Admin_DoJail(playerid, targetid, 20, "TeamKill");
        case 11: Admin_DoJail(playerid, targetid, 25, "˜˜˜˜˜˜˜˜˜˜_˜˜˜");

        case 12: Admin_DoWarn(playerid, targetid, "˜˜˜˜˜_COP");
        case 13: Admin_DoWarn(playerid, targetid, "˜˜˜˜˜_˜˜");
        case 14: Admin_DoWarn(playerid, targetid, "˜˜˜");
        case 15: Admin_DoWarn(playerid, targetid, "˜˜˜˜_˜˜");

        case 16:
        {
            new Float:x, Float:y, Float:z;
            GetPlayerPos(targetid, x, y, z);
            SetPlayerPos(targetid, x, y, z + 10.0);
        }
        case 17:
        {
            new Float:x, Float:y, Float:z;
            GetPlayerPos(targetid, x, y, z);
            SetPlayerPos(targetid, x, y, z - 5.0);
        }

        case 18: Admin_DoBan(playerid, targetid, 7, "Mass_DM");
        case 19: Admin_DoBan(playerid, targetid, 30, "˜˜˜");
        case 20: Admin_DoBan(playerid, targetid, 14, "˜˜˜˜˜˜˜˜˜˜˜_˜˜˜˜˜");
        case 21: Admin_DoBan(playerid, targetid, 365, "˜˜˜˜");

        default: return 0;
    }
    return 1;
}








CMD:mm(playerid, params[])
{
    return AT_ShowMainMenu(playerid);
}






CMD:report(playerid, params[])
{
    new now = gettime();
    new nextTime = GetPVarInt(playerid, "REPORT_NEXT_TIME");
    if(nextTime > now)
    {
        new left = nextTime - now;
        new msg_cd[96];
        format(msg_cd, sizeof(msg_cd), "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ %d ˜˜˜.", left);
        return SendClientMessage(playerid, COLOR_GREY, msg_cd);
    }

    if(isnull(params))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /report [˜˜˜˜˜ ˜˜˜˜˜˜]");

    new rep[220];
    format(rep, sizeof(rep), "%s", params);
    BR_FixUserText(rep, sizeof(rep));

    if(!AT_EnqueueReport(playerid, rep))
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.");

    SetPVarInt(playerid, "REPORT_NEXT_TIME", now + 60);

    SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜{FFFF00} ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜{FFFFFF}. ˜˜˜˜ ˜˜˜˜˜˜ ˜ {FFFF00}˜˜˜˜˜˜˜{FFFFFF}, ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.");

    new msg[220];
    format(msg, sizeof(msg), "{704214}[A] ˜˜˜˜˜ %s[%d] ˜˜˜˜˜ ˜˜˜˜˜˜:{FFAE42} %s", Player[playerid][pName], playerid, rep);
    SendAdminMessage(-1, msg);
    return 1;
}



CMD:ans(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;

    new targetid, repText[144];
    if(!AT_DequeueReport(targetid, repText, sizeof(repText)))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜.");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜, ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.");

    ShowReportsGUI(playerid, targetid, repText);
    return 1;
}

CMD:showtools(playerid, params[])
{
    if(Player[playerid][pAdminLvl] < 1) return 1;

    new screenType;
    if(sscanf(params, "d", screenType))
        return SendClientMessage(playerid, 0xFFFFFFAA, "˜˜˜˜˜˜˜˜˜˜˜: /showtools [1=spectate,2=reports,3=control]");

    switch(screenType)
    {
        case 1: ShowSpectateGUI(playerid, playerid);
        case 2: ShowReportsGUI(playerid, playerid, "˜˜˜˜");
        case 3: ShowControlPanelGUI(playerid);
        default: ShowNotification(playerid, 0, 3, 0, 0, "˜˜˜˜˜˜˜˜ ˜˜˜", "");
    }
    return 1;
}

CMD:alogin(playerid, params[])
{
    #pragma unused params
    return Admin_OpenLogin(playerid);
}

CMD:goadm(playerid, params[])
{
    #pragma unused params
    Admin_ApplyGoadm(playerid);
    return 1;
}

CMD:sp(playerid, params[])
{
    if(Player[playerid][pAdminLvl] < 1) return 1;
    if(!Player[playerid][pAdminAuth]) return Admin_OpenLogin(playerid);

    new targetid;
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /sp [˜˜ ˜˜˜˜˜˜]");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜!");
    if(targetid == playerid) return SendClientMessage(playerid, COLOR_RED, "˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜!");
    if(GetPVarInt(targetid, "IsSpectating")) return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜-˜˜.");

    if(!Admin_StartSpectate(playerid, targetid))
        return SendClientMessage(playerid, COLOR_RED, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜."), 1;

    new str[128];
    format(str, sizeof(str), "[A] %s[%d] ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ %s[%d]", Player[playerid][pName], playerid, Player[targetid][pName], targetid);
    SendAdminMessage(COLOR_GREY, str);
    return 1;
}
alias:sp("re")

CMD:spoff(playerid, params[])
{
    #pragma unused params
    if(Player[playerid][pAdminLvl] < 1 || !Admin_IsSpectating(playerid)) return 1;
    Admin_StopSpectate(playerid);
    return 1;
}
alias:spoff("reoff")

CMD:setadmin(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 9)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ 9 ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜.");

    new targetid;
    if(sscanf(params, "u", targetid))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /setadmin [id ˜˜˜˜˜˜]");
    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜.");
    if(targetid == playerid)
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜.");

    SetPVarInt(playerid, "AT_SETADMIN_TARGET", targetid);

    AT_ShowTemplateDivisions(playerid, AT_DIALOG_SETADMIN_DIVISION);
    return 1;
}

CMD:ahelp(playerid, params[])
{
    if(Player[playerid][pAdminLvl] < 1 || !Player[playerid][pAdminAuth])
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜.");

    AT_ShowTemplateDivisions(playerid, AT_DIALOG_AHELP_DIVISION);
    return 1;
}

CMD:admins(playerid, params[])
{
    if(Player[playerid][pAdminLvl] < 1 || !Player[playerid][pAdminAuth])
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜.");

    new line[128];
    new list[2200];
    new count = 0;
    format(list, sizeof(list), "˜˜˜\t˜˜˜˜˜˜˜˜˜\t˜˜˜˜˜˜\n");

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        if(Player[i][pAdminLvl] < 1) continue;

        format(line, sizeof(line), "%s[%d]\t%s\t˜˜˜˜˜˜\n",
            Player[i][pName], i, Player[i][pAdminPrefix]);
        strcat(list, line);
        count++;
    }

    if(!count)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜.");

    new title[96];
    format(title, sizeof(title), "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜˜˜ ˜˜˜˜˜˜: %d", count);
    ShowPlayerDialog(playerid, AT_DIALOG_ADMINS_ONLINE, DIALOG_STYLE_TABLIST_HEADERS, title, list, "˜˜˜˜˜˜˜", "");
    return 1;
}

CMD:whitelist(playerid, params[])
{
    if(!AT_CanManageWhitelist(playerid))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ 13 ˜˜˜˜˜˜.");

    WL_ShowMainMenu(playerid);
    return 1;
}
// ----- end: admintools.inc -----

// ----- begin: promocode.inc -----
stock ShowPromoMenu(playerid)
{
    new menu[512]; // ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜, ˜˜˜ ˜˜˜ ˜˜˜˜˜ {FFFFFF} ˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜
    format(menu, sizeof(menu), CAR_CLR_WHITE "˜˜˜˜˜˜˜˜\t" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜\n");
    format(menu, sizeof(menu), "%s" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\t" CAR_CLR_GOLD "˜˜˜˜˜˜˜\n", menu);
    format(menu, sizeof(menu), "%s" CAR_CLR_WHITE "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜\t" CAR_CLR_GOLD "˜˜˜˜˜˜˜\n", menu);
    format(menu, sizeof(menu), "%s" CAR_CLR_WHITE "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\t" CAR_CLR_GOLD "˜˜˜˜˜˜˜\n", menu);
    format(menu, sizeof(menu), "%s" CAR_CLR_WHITE "˜˜˜˜˜˜˜ ˜˜˜˜˜\t" CAR_CLR_GOLD "˜˜˜˜˜˜˜", menu);

    return ShowPlayerDialog(playerid, DIALOG_PROMO_MAIN, DIALOG_STYLE_TABLIST_HEADERS,
        CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜", menu, "˜˜˜˜˜", "˜˜˜˜˜");
}

CMD:promo(playerid, params[])
{
    return ShowPromoMenu(playerid);
}
// ----- end: promocode.inc -----

// ----- begin: gibdd.inc -----
// =============================================================================
// BR BLACK STUDIO ˜ ˜˜˜˜˜ (˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜)
//
//   ˜˜˜˜: mod laird/gamemodes/laird.pwn  (SetActorVirtualWorld(...,1) ? vw=1)
//         ˜˜˜˜˜˜ GUI by @valve_develop.pwn (CEF GUI 1 / Plates protocol)
//         gui/plates/* ˜ Java/Kotlin ˜˜˜˜˜˜˜ Black Russia (PlatesConstants etc.)
//
//   ˜˜˜˜˜˜˜ (˜˜˜˜˜): vw=0, int=0
//      X=1907.4281  Y=-2229.1552  Z=12.2223  A=3.1359
//   ˜˜˜˜˜˜ (˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜): int=1, vw=2 (˜˜˜˜˜) / vw=4 (˜˜˜˜˜˜˜˜˜˜˜)
//      ˜˜˜˜˜ ˜˜ ˜˜˜˜˜:  -1111.0233, 1522.7573, 1499.9459 (laird.pwn:6696, ˜˜˜˜˜˜˜˜˜)
//      EXIT pickup:     -1111.0108, 1525.7037, 1499.9459 (laird.pwn:6697)
//      ˜˜˜˜˜˜ ˜˜˜˜˜˜˜.: -1106.1774, 1513.7841, 1499.9532 (˜˜˜˜ OtdelKadrovGibdd ˜˜ laird)
//
//   CEF GUI 1 (Black Russia "Plates"):
//      Server ? Client (˜˜˜˜˜ OnPacketIncoming(..., 1, json)):
//          t=0  {p, pr, c}    ? ˜˜˜˜˜˜˜ GUI, ˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ (currencyType=0 ˜ ˜˜˜˜˜˜˜)
//          t=1  {h, c}        ? ˜˜˜˜˜˜˜˜˜/˜˜˜˜˜˜˜˜˜ ˜ GUI (˜˜˜˜˜ ˜˜˜˜˜˜˜)
//          t=2  {p, r, c}     ? ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜
//      Client ? Server (˜˜˜˜˜˜˜˜ ˜ ipacket.inc case 1):
//          t=0                ? ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ (GUI ˜˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜)
//          t=1  {c}           ? ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ (˜˜˜˜˜˜˜ ˜˜˜˜˜˜)
//          t=2                ? ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜
//          t=3  {p, r}        ? ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ plate/region)
//          t=4  {c, p, r}     ? ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜
// =============================================================================

#if !defined GIBDD_PLATE_PRICE
    #define GIBDD_PLATE_PRICE   (5000)
#endif
