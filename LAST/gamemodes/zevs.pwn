stock Player_GetMaxCarSlots(playerid)
{
    new extra = Player[playerid][pCarExtraSlots];
    if(extra < 0) extra = 0;
    return PLAYER_BASE_CAR_SLOTS + extra;
}

stock Player_CountOwnedCars(playerid)
{
    new count;
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(!CarSystem_IsPersonalGarageSlot(playerid, i)) continue;
        count++;
    }
    return count;
}

stock Player_FindFreeCarSlot(playerid)
{
    if(Player_CountOwnedCars(playerid) >= Player_GetMaxCarSlots(playerid))
        return -1;
    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(VehicleInfo[playerid][i][vModel] == 0) return i;
    }
    return -1;
}

stock Player_HasFreeCarSlot(playerid)
{
    return (Player_FindFreeCarSlot(playerid) != -1);
}

stock Player_FillNoCarSlotMessage(playerid, dest[], size)
{
    format(dest, size,
        "˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜ (%d/%d). ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ /car ˜˜˜ ˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜ ˜ ˜˜˜˜˜˜ (˜˜˜˜˜˜, 100 BC).",
        Player_CountOwnedCars(playerid), Player_GetMaxCarSlots(playerid));
}

