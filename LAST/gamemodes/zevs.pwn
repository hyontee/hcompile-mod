                OnPacketIncoming(playerid, 22, deny_json);
                JSON_Cleanup(deny_json);

                new wait_msg[112];
                new mins = (Player[playerid][pGiftDelay] + 59) / 60;
                format(wait_msg, sizeof(wait_msg),
                    "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ %d ˜˜˜.", mins);
                ShowNotification(playerid, 0, 5, 0, 0, wait_msg, "");
                return 1;
            }

            new roll = random(4) + 1;
            AddPlayerCaseCountByType(playerid, roll, 1);

            Player[playerid][pGiftDelay] = 7200;
            SavePlayerAccount(playerid);

            SyncPlayerCasesInventoryPacket(playerid);

            new Node:gift_json = JSON_Object();
            JSON_SetInt(gift_json, "t", 2);
            JSON_SetInt(gift_json, "s", 1);
            JSON_SetInt(gift_json, "p", Player[playerid][pGiftDelay]);
            OnPacketIncoming(playerid, 22, gift_json);
            JSON_Cleanup(gift_json);

            new prize_label[48];
            if(roll == 1) format(prize_label, sizeof(prize_label), "˜˜˜˜˜˜˜ ˜˜˜˜˜˜");
            else if(roll == 2) format(prize_label, sizeof(prize_label), "˜˜˜˜ ˜˜˜˜˜");
            else if(roll == 3) format(prize_label, sizeof(prize_label), "VIP-˜˜˜˜˜˜");
            else format(prize_label, sizeof(prize_label), "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ x2 (2.0)");

            new gift_msg[144];
            format(gift_msg, sizeof(gift_msg),
                "˜˜˜˜˜˜˜: %s (1 ˜˜.). ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ 2 ˜ ˜˜˜˜˜˜ ˜˜˜˜˜.", prize_label);
            ShowNotification(playerid, 3, 7, 0, 0, gift_msg, "");

            new chat_msg[96];
            format(chat_msg, sizeof(chat_msg), "˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜: %s. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ (/cases).", prize_label);
            SendClientMessage(playerid, -1, chat_msg);
            return 1;
        }
        case 1: // ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ (copy: openHeaderBoxes -> callcmd::cases)
        {
            printf("[Cases] donate GUI22 t=1 -> cases %s[%d]", Player[playerid][pName], playerid);
            callcmd::cases(playerid, "");
            JSON_Cleanup(json);
            return 1;
        }
        case 3: // ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ (closeDialog, t=3)
        {
            JSON_Cleanup(json);
            return 1;
        }
        case 4:
        {
            JSON_Cleanup(json);
            return 1;
        }
        case 5:
        {
            JSON_Cleanup(json);
            return 1;
        }
        case 6:
        {
            JSON_Cleanup(json);
            return 1;
        }
        default:
        {
            if(type == -1 || type == -2)
            {
                JSON_Cleanup(json);
                return 1;
            }
            JSON_Cleanup(json);
            return 1;
        }
    }
    JSON_Cleanup(json);
    return 1;
}
        case 1:
        {
            // CEF GUI 1 (Plates) ˜ ˜˜˜˜˜˜ ? ˜˜˜˜˜˜ (PlatesConstants):
            //   t=0  TYPE_EXIT             ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ GUI
            //   t=1  TYPE_COUNTRY_CLICKED  ˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ {c}
            //   t=2  TYPE_REFRESH_PLATES   ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜
            //   t=3  TYPE_PURCHASE_PLATE   ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ {p, r}
            //   t=4  TYPE_CHANGED_TEXT     ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ {c, p, r}
            new plate_t = -1;
            JSON_GetInt(json, "t", plate_t);

            switch(plate_t)
            {
                case 0:
                {
                    // TODO: ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ Battle Pass
                    Gibdd_OnGuiClosedByClient(playerid);
                }
                case 1:
                {
                    new country_id = -1;
                    JSON_GetInt(json, "c", country_id);
                    if(country_id < 0 || country_id > 3) { JSON_Cleanup(json); return 1; }

                    g_GibddSelectedRegion[playerid] = country_id;
                    Gibdd_EnsurePreview(playerid, country_id);
                    GibddSendPreview(playerid, country_id);
                }
                case 2:
                {
                    new country_id = g_GibddSelectedRegion[playerid];
                    if(country_id < 0 || country_id > 3) { JSON_Cleanup(json); return 1; }

                    if(GetPlayerMoneyEx(playerid) < GIBDD_PLATE_REROLL_PRICE)
                    {
                        GibddSendHint(playerid, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜.");
                        JSON_Cleanup(json);
                        return 1;
                    }

                    GivePlayerMoneyEx(playerid, -GIBDD_PLATE_REROLL_PRICE);
                    RandomNumberPlate(country_id, g_PlatePreview[playerid][country_id]);
                    RandomNumberRegion(country_id, g_RegionPreview[playerid][country_id]);
                    GibddSendPreview(playerid, country_id);
                }
                case 3:
                {
                    new country_id = g_GibddSelectedRegion[playerid];
                    if(country_id < 0 || country_id > 3) { JSON_Cleanup(json); return 1; }

                    // TODO: ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ Battle Pass
                    // TODO: ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ Battle Pass
                    // TODO: ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ Battle Pass
                    // TODO: ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ Battle Pass
                    Gibdd_EnsurePreview(playerid, country_id);

                    if(GetPlayerMoneyEx(playerid) < GIBDD_PLATE_PRICE)
                    {
                        GibddSendHint(playerid, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜.");
                        JSON_Cleanup(json);
                        return 1;
                    }

                    new added_slot = GivePlayerPlateItem(playerid, country_id,
                        g_PlatePreview[playerid][country_id], g_RegionPreview[playerid][country_id]);
                    if(added_slot < 0)
                    {
                        GibddSendHint(playerid, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜.");
                        JSON_Cleanup(json);
                        return 1;
                    }

                    GivePlayerMoneyEx(playerid, -GIBDD_PLATE_PRICE);

                    new msg[160];
                    format(msg, sizeof msg, "˜˜˜. ˜˜˜˜ %s %s ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜.",
                        g_PlatePreview[playerid][country_id], g_RegionPreview[playerid][country_id]);
                    ShowNotification(playerid, 1, 5, 0, 1, msg, "");
                    GibddSendHint(playerid, msg);

                    // TODO: ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ Battle Pass
                    g_PlatePreview[playerid][country_id][0] = '\0';
                    g_RegionPreview[playerid][country_id][0] = '\0';
                    Gibdd_EnsurePreview(playerid, country_id);
                    GibddSendPreview(playerid, country_id);
                }
                case 4:
                {
                    new country_id = -1, plate[12], region[8];
                    JSON_GetInt(json, "c", country_id);
                    JSON_GetString(json, "p", plate, sizeof plate);
                    JSON_GetString(json, "r", region, sizeof region);

                    if(country_id < 0 || country_id > 3) { JSON_Cleanup(json); return 1; }
                    format(g_PlatePreview[playerid][country_id], 12, "%s", plate);
                    format(g_RegionPreview[playerid][country_id], 8, "%s", region);
                    g_GibddSelectedRegion[playerid] = country_id;
                }
            }

            JSON_Cleanup(json);
            return 1;
        }
        case 2:
        {
            Fuel_HandleGuiPacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case 3:
        {
            Snack_HandleDinerGuiPacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case 71:
        {
            Calendar_HandleGuiPacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case 26:
        {
            MinerJob_HandleCaptchaPacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case 63:
        {
            if(ChiefDoctor_HandleGuiPacket(playerid, json))
            {
                JSON_Cleanup(json);
                return 1;
            }
            if(Shop247_HandleNpcGuiPacket(playerid, json))
            {
                JSON_Cleanup(json);
                return 1;
            }
            MinerJob_HandleNpcDialogPacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case 31:
        {
            MinerJob_HandleMiniGamePacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case 74:
        {
            Rewards_HandleGuiPacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }

case 73:
{
    new type;
    JSON_GetInt(json, "t", type);
    #if CASES_DEBUG_PACKET_LOG
        printf("[IPacket:73] %s[%d]: %s", Player[playerid][pName], playerid, g_GuiJsonInBuf);
    #else
        printf("[IPacket:73] %s[%d] t=%d", Player[playerid][pName], playerid, type);
    #endif

    switch (type)
    {
        case 3:
        {
            new cs_val = GetPVarInt(playerid, "case_open_cs");
            if(cs_val <= 0) JSON_GetInt(json, "cs", cs_val);

            new bt2_echo[64], bt2_echo_count = 0;

            if(JSON_GetType(json, "bt1") == JSON_NODE_ARRAY)
            {
                new Node:bt1_array, bt1_len;
                JSON_GetArray(json, "bt1", bt1_array);
                JSON_ArrayLength(bt1_array, bt1_len);

                new log_msg[256];
                format(log_msg, sizeof(log_msg), "[BattlePass] Player %d collected %d rewards. IDs: ", playerid, bt1_len);

                for(new i = 0; i < bt1_len; i++)
                {
                    new Node:elem, reward_ui_id;
                    JSON_ArrayObject(bt1_array, i, elem);
                    JSON_GetNodeInt(elem, reward_ui_id);

                    if(!ConsumeOpenedCaseReward(playerid, reward_ui_id)) continue;
                    if(cs_val <= 0 || reward_ui_id <= 0 || reward_ui_id > GetCaseMaxRange(cs_val)) continue;

                    new temp[16];
                    format(temp, sizeof(temp), "%d, ", reward_ui_id);
                    strcat(log_msg, temp);

                    if(cs_val > 0)
                    {
                        new query[160];
                        mysql_format(db_handle, query, sizeof(query),
                            "INSERT INTO `rewards` (`uid`, `award_id`, `case_id`) \
                            SELECT %d, %d, %d FROM DUAL \
                            WHERE (SELECT COUNT(*) FROM `rewards` WHERE `uid` = %d) < 100000",
                            Player[playerid][pID], reward_ui_id - 1, cs_val, Player[playerid][pID]);
                        mysql_tquery(db_handle, query, "", "");
                    }
                }

                printf("%s", log_msg);
            }

            if(JSON_GetType(json, "bt2") == JSON_NODE_ARRAY)
            {
                new Node:bt2_array, bt2_len;
                JSON_GetArray(json, "bt2", bt2_array);
                JSON_ArrayLength(bt2_array, bt2_len);

                new log_msg[256];
                format(log_msg, sizeof(log_msg), "[BattlePass] Player %d sprayed rewards IDs: ", playerid);

                new total_spray = 0;
                for(new i = 0; i < bt2_len; i++)
                {
                    new Node:elem, reward_ui_id;
                    JSON_ArrayObject(bt2_array, i, elem);
                    JSON_GetNodeInt(elem, reward_ui_id);

                    if(bt2_echo_count < sizeof(bt2_echo))
                        bt2_echo[bt2_echo_count++] = reward_ui_id;

                    if(!ConsumeOpenedCaseReward(playerid, reward_ui_id)) continue;

                    new temp[16];
                    format(temp, sizeof(temp), "%d, ", reward_ui_id);
                    strcat(log_msg, temp);

                    total_spray += GetCaseAwardSprayPriceByIndex(cs_val, reward_ui_id - 1);
                }

                if(total_spray > 0)
                {
                    AddPlayerDustValue(playerid, total_spray);
                    SavePlayerAccount(playerid);
                }

                printf("%s", log_msg);
            }

            if(GetPVarInt(playerid, "case_open_total") <= 0)
            {
                ResetOpenedCaseRewards(playerid);
            }

            new bool:special_case = PopSpecialCaseUiPending(playerid);
            new bool:from_reward_screen = (GetPVarInt(playerid, CASE_REWARD_UI_PVAR) > 0);

            if(from_reward_screen)
                Cases_ClearRewardScreenFlag(playerid);

            SetTimerEx("CasesDeferredSpraySaveTimer", 50, false, "i", playerid);
            Cases_QueueSprayResponse(playerid, from_reward_screen, special_case, bt2_echo, bt2_echo_count);

            JSON_Cleanup(json);
            return 1;
        }
        case 1:
        {
            new cs_val = 1;
            if(JSON_GetType(json, "cs") != JSON_NODE_NULL)
                JSON_GetInt(json, "cs", cs_val);
            Cases_SendSelectCasePacket(playerid, cs_val);
            JSON_Cleanup(json);
            return 1;
        }
        case 4:
        {
            new d = 0;
            JSON_GetInt(json, "d", d);

            Cases_CloseGui(playerid);

            if(d == 2)
                Menu_OpenDonateTab(playerid, 4);
            else
                Menu_OpenDonate(playerid);

            JSON_Cleanup(json);
            return 1;
        }
        case 6:
        {
            callcmd::reward(playerid, "");
            JSON_Cleanup(json);
            return 1;
        }
        case 2:
{
    new type_val = 1, cs_val = -1;
    JSON_GetInt(json, "type", type_val);
    JSON_GetInt(json, "cs", cs_val);

    SetPVarInt(playerid, "case_open_cs", cs_val);
    ResetOpenedCaseRewards(playerid);

    new open_count = (type_val == 2) ? 10 : 1;
    new price = 0;

    switch(cs_val)
    {
        case 1: price = 0;
        case 2: price = (open_count == 10) ? 1000 : 100;
        case 3: price = (open_count == 10) ? 7000 : 700;
        case 4: price = (open_count == 10) ? 12000 : 1200;
        case 5: price = (open_count == 10) ? 100000 : 10000;
        default:
        {
            Cases_SendSyncPacket(playerid, 0);
            JSON_Cleanup(json);
            return 1;
        }
    }

    if(cs_val < 1 || cs_val > 5)
    {
        JSON_Cleanup(json);
        return 1;
    }

    new have_cases = GetPlayerCaseCountByType(playerid, cs_val);
    new bool:use_bc = false;

    if(have_cases < open_count)
    {
        if(price <= 0)
        {
            Cases_SendSyncPacket(playerid, 0);
            ShowNotification(playerid, 2, 4, 1, 1, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜!", "");
            JSON_Cleanup(json);
            return 1;
        }

        if(GetPlayerBlackCoin(playerid) < price)
        {
            Cases_SendSyncPacket(playerid, 0);
            ShowNotification(playerid, 2, 4, 1, 1, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜!", "");
            JSON_Cleanup(json);
            return 1;
        }
        use_bc = true;
    }

    if(use_bc)
    {
        if(price > 0) GivePlayerBlackCoin(playerid, -price);
    }
    else
    {
        AddPlayerCaseCountByType(playerid, cs_val, -open_count);
    }

    new max_range = GetCaseMaxRange(cs_val);
    new bool:open_ok = (max_range > 0);
    new reward_ui_ids[10];

    if(open_ok)
    {
        for(new i = 0; i < open_count; i++)
        {
            new r = random(max_range);
            reward_ui_ids[i] = r + 1;
            AddOpenedCaseReward(playerid, reward_ui_ids[i]);
        }
    }

    printf("[Cases] OpenCase %s[%d] cs=%d cnt=%d ok=%d",
        Player[playerid][pName], playerid, cs_val, open_count, open_ok);
    Cases_QueueOpenResult(playerid, open_ok, open_count, reward_ui_ids);
    JSON_Cleanup(json);
    return 1;
}
        default:
        {
            printf("[Case73] UNKNOWN t=%d player=%d (˜˜˜˜˜ gamemodes/death.amx ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜)", type, playerid);
        }
    }

    JSON_Cleanup(json);
    return 1;
}
        // ˜˜˜˜˜˜: ˜˜˜˜˜˜˜ ˜>>˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜ (GUI 13) ˜ ˜˜˜˜˜˜˜˜˜ / ˜˜˜˜˜˜˜ ˜˜˜˜˜
        case 13:
        {
            new ntype = -1, nid = 0, nveh = 0;
            if(JSON_GetType(json, "t") != JSON_NODE_NULL) JSON_GetInt(json, "t", ntype);
            if(JSON_GetType(json, "s") != JSON_NODE_NULL) JSON_GetInt(json, "s", nid);
            if(JSON_GetType(json, "b") != JSON_NODE_NULL) JSON_GetInt(json, "b", nveh);

            if(ntype != 0)
            {
                JSON_Cleanup(json);
                return 1;
            }

            if(nid == NOTIFY_OFFER_ENGINE)
            {
                if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                    callcmd::e(playerid, "");
            }
            else if(nid == NOTIFY_OFFER_UNLOCK_CAR && nveh > 0 && nveh < MAX_VEHICLES)
            {
                VehicleHint_UnlockOfferVehicle(playerid, nveh);
            }
            #if defined NOTIFY_CONT_BET
            else if(nid == NOTIFY_CONT_BET)
            {
                callcmd::conts(playerid);
            }
            else if(nid == NOTIFY_CONT_CLAIM)
            {
                callcmd::cont(playerid);
            }
            #endif
            else if(nid == NOTIFY_PASSPORT_OFFER)
            {
                new fromid = nveh;
                if(!IsPlayerConnected(fromid) || Player[fromid][pID] <= 0)
                    ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜.", "");
                else
                {
                    Pass_ShowPassportDialog(playerid, fromid);
                    new msg[128];
                    format(msg, sizeof(msg), "˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜.", Player[playerid][pName], playerid);
                    SendClientMessage(fromid, COLOR_WHITE, msg);
                }
            }
            else if(nid == NOTIFY_LICENSE_OFFER)
            {
                new fromid = nveh;
                if(!IsPlayerConnected(fromid) || Player[fromid][pID] <= 0)
                    ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜.", "");
                else
                {
                    Lic_ShowLicensesDialog(playerid, fromid);
                    new msg[128];
                    format(msg, sizeof(msg), "˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜.", Player[playerid][pName], playerid);
                    SendClientMessage(fromid, COLOR_WHITE, msg);
                }
            }
            else if(nid == NOTIFY_MEDCARD_OFFER)
            {
                new fromid = nveh;
                if(!IsPlayerConnected(fromid) || Player[fromid][pID] <= 0)
                    ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜.", "");
                else if(!ChiefDoctor_PlayerHasMedCard(fromid))
                    ShowNotification(playerid, 0, 5, 0, 0, "˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.", "");
                else
                {
                    ChiefDoctor_ShowMedCardDialog(playerid, fromid);
                    new msg[144];
                    format(msg, sizeof(msg), "˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜. ˜˜˜˜˜.", Player[playerid][pName], playerid);
                    SendClientMessage(fromid, COLOR_WHITE, msg);
                }
            }
            else if(nid == NOTIFY_CARPASS_OFFER)
            {
                new ownerid = GetPVarInt(playerid, "CarPass_Owner");
                new slot = GetPVarInt(playerid, "CarPass_Slot");
                DeletePVar(playerid, "CarPass_Owner");
                DeletePVar(playerid, "CarPass_Slot");

                if(!IsPlayerConnected(ownerid) || Player[ownerid][pID] <= 0)
                    ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜.", "");
                else if(slot < 0 || slot >= MAX_PLAYER_VEHICLES || VehicleInfo[ownerid][slot][vModel] == 0)
                    ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.", "");
                else if(!VehicleInfo[ownerid][slot][vSpawned])
                    ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜.", "");
                else
                {
                    CarPass_ShowDialog(playerid, ownerid, slot);
                    new msg[160];
                    format(msg, sizeof(msg), "˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.", Player[playerid][pName], playerid);
                    SendClientMessage(ownerid, 0x0091FFFF, msg);
                }
            }
            else if(nid == NOTIFY_OFFER_TRUNK && nveh > 0 && nveh < MAX_VEHICLES)
            {
                Trunk_OpenForPlayer(playerid, nveh);
