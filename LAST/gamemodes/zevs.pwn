                    JSON_SetInt(json_packet_data, "t", 12);
                    JSON_SetInt(json_packet_data, "s", 1);
                }
                else
                {
                new collapse_sel = Tune_ResolvePacket28Selector(json);
                if(collapse_sel < TUNE_SEL_COLLAPSE_MIN || collapse_sel > TUNE_SEL_COLLAPSE_MAX)
                {
                    if(json_p_int >= TUNE_SEL_COLLAPSE_MIN && json_p_int <= TUNE_SEL_COLLAPSE_MAX) collapse_sel = json_p_int;
                    else if(json_d_int >= TUNE_SEL_COLLAPSE_MIN && json_d_int <= TUNE_SEL_COLLAPSE_MAX) collapse_sel = json_d_int;
                }
                new vehicleid_col = GetPlayerVehicleID(playerid);
                for(new vcol = 0; vcol < MAX_PLAYER_VEHICLES; vcol++)
