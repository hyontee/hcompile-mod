stock MM_ShowRadialMenu(playerid)
{
    new Node:root = JSON_Object();
    JSON_SetBool(root, "f", (Player[playerid][pFamilyId] > 0));
    OnPacketIncoming(playerid, MM_GUI_ID, root);
    JSON_Cleanup(root);
    SetPVarInt(playerid, "MM_FromMenu", 1);
    return 1;
}

stock MM_OnMenuGuiPacket(playerid, Node:json)
{
    new action = 0, sub = 0;
    if(JSON_GetType(json, "t") != JSON_NODE_NULL) JSON_GetInt(json, "t", action);
    if(JSON_GetType(json, "i") != JSON_NODE_NULL) JSON_GetInt(json, "i", sub);

    if(action == -1)
    {
        if(sub == 1) DeletePVar(playerid, "MM_FromMenu");
        return 1;
    }

    switch(action)
    {
        case MM_MENU_ID_MENU: MM_ShowPlayerStats(playerid, playerid);
        case 4: callcmd::inv(playerid, "");
        case 6: Menu_OpenDonate(playerid);
        case 7: SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ /car");
        case 8: callcmd::promo(playerid, "");
        case 10:
        {
            if(Player[playerid][pFamilyId] > 0) Family_ShowMenu(playerid);
            else SendClientMessage(playerid, COLOR_GREY, "˜˜ ˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜.");
        }
        case 14:
            SendClientMessage(playerid, COLOR_GREY, "Black Pass ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜.");
        case MM_MENU_ID_PASSPORT:
        {
            new nearid = Pass_FindNearestPlayer(playerid, PASS_LIC_SHOW_RANGE);
            if(nearid == -1) SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜.");
            else Pass_SendOffer(playerid, nearid);
        }
        case MM_MENU_ID_LICENSES:
        {
            new nearid = Pass_FindNearestPlayer(playerid, PASS_LIC_SHOW_RANGE);
            if(nearid == -1) SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜.");
            else Lic_SendOffer(playerid, nearid);
        }
    }
    return 1;
}

stock MM_OnStatsGuiPacket(playerid, Node:json)
{
    new btn = 0;
    if(JSON_GetType(json, "t") != JSON_NODE_NULL) JSON_GetInt(json, "t", btn);

    switch(btn)
    {
        case MM_STATS_BTN_BACK:
        {
            if(GetPVarInt(playerid, "MM_FromMenu")) AT_ShowMainMenu(playerid);
        }
        case MM_STATS_BTN_CLOSE:
        {
            DeletePVar(playerid, "MM_StatsTarget");
        }
    }
    return 1;
}

stock AT_ShowMainMenu(playerid)
{
    new menu[256];
    format(menu, sizeof(menu),
        "˜˜˜˜˜\t˜˜˜˜˜˜˜˜\n\
        ˜˜˜˜˜˜˜˜˜˜\t˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜\n\
        ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜\t˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜");
    ShowPlayerDialog(playerid, AT_DIALOG_MM_MAIN, DIALOG_STYLE_TABLIST_HEADERS,
        "{E0584B}BR BLACK STUDIO{FFFFFF} | ˜˜˜˜", menu, "˜˜˜˜˜˜˜", "˜˜˜˜˜");
    return 1;
}

stock bool:HandleAdminToolsDialog(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == AT_DIALOG_PASSPORT)
        return true;

    if(dialogid == AT_DIALOG_MEDCARD)
        return true;

    if(dialogid == AT_DIALOG_LICENSES)
        return true;

    if(dialogid == AT_DIALOG_CARPASS)
        return true;

    if(dialogid == AT_DIALOG_MM_MAIN)
    {
        if(!response) return true;
        switch(listitem)
        {
            case 0:
            {
                SetPVarInt(playerid, "MM_FromMenu", 1);
                MM_ShowPlayerStats(playerid, playerid);
            }
            case 1: MM_ShowPassOldDialog(playerid);
        }
        return true;
    }

    if(dialogid == AT_DIALOG_STATS)
    {
        if(response && GetPVarInt(playerid, "MM_FromMenu"))
            AT_ShowMainMenu(playerid);
        return true;
    }

    if(dialogid == AT_DIALOG_MM_PASS_OLD)
    {
        if(!response)
        {
            AT_ShowMainMenu(playerid);
            return true;
        }

        if(strlen(inputtext) < 1)
        {
            ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜.", "");
            MM_ShowPassOldDialog(playerid);
            return true;
        }

        if(Player[playerid][pPassword][0] == EOS)
        {
            ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜: ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜.", "");
            return true;
        }

        if(strcmp(inputtext, Player[playerid][pPassword], false) != 0)
        {
            ShowNotification(playerid, 0, 5, 0, 0, "˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.", "");
            MM_ShowPassOldDialog(playerid);
            return true;
        }

        MM_ShowPassNewDialog(playerid);
        return true;
    }

    if(dialogid == AT_DIALOG_MM_PASS_NEW)
    {
        if(!response)
        {
            AT_ShowMainMenu(playerid);
            return true;
        }

        if(strlen(inputtext) < 4)
        {
            ShowPlayerDialog(playerid, AT_DIALOG_MM_PASS_NEW, DIALOG_STYLE_INPUT,
                "{E0584B}BR BLACK STUDIO{FFFFFF} | ˜˜˜˜˜ ˜˜˜˜˜˜",
                "˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜ 4 ˜˜˜˜˜˜˜.",
                "˜˜˜˜˜˜˜˜", "˜˜˜˜˜");
            return true;
        }

        format(Player[playerid][pPassword], 65, "%s", inputtext);

        new query[192];
        mysql_format(db_handle, query, sizeof(query),
            "UPDATE `players` SET `password` = '%e' WHERE `id` = %d",
            Player[playerid][pPassword], Player[playerid][pID]);
        mysql_tquery(db_handle, query, "", "");

        ShowNotification(playerid, 1, 5, 0, 0, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");
        AT_ShowMainMenu(playerid);
        return true;
    }

    if(dialogid == AT_DIALOG_MM_SETTINGS)
    {
        if(!response)
        {
            AT_ShowMainMenu(playerid);
            return true;
        }
        if(listitem == 0) MM_ShowPassOldDialog(playerid);
        return true;
    }

    if(dialogid == AT_DIALOG_SETADMIN_DIVISION)
    {
        if(!response) return true;
        if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 9) return true;
        AT_ShowTemplatePosts(playerid, listitem + 1, false);
        return true;
    }

    if(dialogid == AT_DIALOG_SETADMIN_POST)
    {
        if(!response)
        {
            AT_ShowTemplateDivisions(playerid, AT_DIALOG_SETADMIN_DIVISION);
            return true;
        }
        if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 9) return true;

        new targetid = GetPVarInt(playerid, "AT_SETADMIN_TARGET");
        if(!IsPlayerConnected(targetid))
        {
            SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜.");
            return true;
        }

        if(listitem < 0 || listitem >= 64) return true;
        new post = AT_SetAdminPostMap[playerid][listitem];
        if(post < 0 || post >= sizeof(AT_AdminPosts))
        {
            SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");
            return true;
        }

        new level = AT_AdminPosts[post][atPostLevel];

        if(!Admin_CanManageAdminRank(playerid, targetid, level))
            return true;

        Player[targetid][pAdminLvl] = level;
        format(Player[targetid][pAdminPrefix], 32, "%s", AT_AdminPosts[post][atPostName]);
        if(level == 0)
        {
            Player[targetid][pAdminAuth] = false;
            Player[targetid][pAdminPass] = 0;
        }

        SavePlayerAccount(targetid);
        AT_SaveAdminDataToDB(targetid);

        new msg[160];
        format(msg, sizeof(msg), "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜ ˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜ ˜˜˜˜˜˜˜˜˜: %s.",
            Player[targetid][pName], targetid, AT_AdminPosts[post][atPostName]);
        SendClientMessage(playerid, COLOR_WHITE, msg);

        if(level > 0)
            Admin_NotifyAssignedInGame(targetid, AT_AdminPosts[post][atPostName]);
        return true;
    }
    if(dialogid == AT_DIALOG_AHELP_DIVISION)
    {
        if(!response) return true;
        AT_ShowTemplatePosts(playerid, listitem + 1, true);
        return true;
    }

    if(dialogid == AT_DIALOG_AHELP_POST)
    {
        if(!response)
        {
            AT_ShowTemplateDivisions(playerid, AT_DIALOG_AHELP_DIVISION);
            return true;
        }
        if(listitem < 0 || listitem >= 64) return true;
        new post_help = AT_AHelpPostMap[playerid][listitem];
        if(post_help < 0 || post_help >= sizeof(AT_AdminPosts)) return true;
        AT_ShowCommandsForLevel(playerid, AT_AdminPosts[post_help][atPostLevel]);
        return true;
    }

    if(dialogid == AT_DIALOG_AHELP_LEVEL_CMDS)
    {
        if(!response) AT_ShowTemplateDivisions(playerid, AT_DIALOG_AHELP_DIVISION);
        return true;
    }

    if(dialogid == AT_DIALOG_WHITELIST_MAIN)
    {
        if(!response) return true;
        if(!AT_CanManageWhitelist(playerid)) return true;

        switch(listitem)
        {
            case 0: WL_ShowToggleMenu(playerid);
            case 1: WL_ShowEditMenu(playerid);
            case 2:
            {
                WL_LoadListPage(playerid, 0);
            }
        }
        return true;
    }

    if(dialogid == AT_DIALOG_WHITELIST_TOGGLE)
    {
        if(!response)
        {
            WL_ShowMainMenu(playerid);
            return true;
        }
        if(!AT_CanManageWhitelist(playerid)) return true;
        switch(listitem)
        {
            case 0: WL_UpdateConfig(playerid, true);
            case 1: WL_UpdateConfig(playerid, false);
        }
        WL_ShowMainMenu(playerid);
        return true;
    }

    if(dialogid == AT_DIALOG_WHITELIST_EDIT)
    {
        if(!response)
        {
            WL_ShowMainMenu(playerid);
            return true;
        }
        if(!AT_CanManageWhitelist(playerid)) return true;

        gWhitelistAction[playerid] = listitem + 1; // 1 - add, 2 - remove
        ShowPlayerDialog(playerid, AT_DIALOG_WHITELIST_NICK, DIALOG_STYLE_INPUT,
            "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜ ˜˜˜˜˜˜",
            "˜˜˜˜˜˜˜ ˜˜˜ ˜ ˜˜˜˜˜˜˜ Name_Surname:", "˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜˜");
        return true;
    }

    if(dialogid == AT_DIALOG_WHITELIST_NICK)
    {
        if(!response)
        {
            WL_ShowEditMenu(playerid);
            return true;
        }
        if(!AT_CanManageWhitelist(playerid)) return true;
        if(isnull(inputtext) || strlen(inputtext) < 3)
        {
            ShowPlayerDialog(playerid, AT_DIALOG_WHITELIST_NICK, DIALOG_STYLE_INPUT,
                "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜ ˜˜˜˜˜˜",
                "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜˜˜ ˜˜˜ ˜ ˜˜˜˜˜˜˜ Name_Surname:", "˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜˜");
            return true;
        }

        new query[256], post_name[46];
        format(post_name, sizeof(post_name), "˜˜˜˜˜");
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i)) continue;
            if(strcmp(Player[i][pName], inputtext, true) == 0)
            {
                if(Player[i][pAdminLvl] > 0 && !isnull(Player[i][pAdminPrefix])) format(post_name, sizeof(post_name), "%s", Player[i][pAdminPrefix]);
                break;
            }
        }

        if(gWhitelistAction[playerid] == 1)
        {
            mysql_format(db_handle, query, sizeof(query),
                "INSERT INTO `server_whitelist` (`nickname`,`post`) VALUES ('%e','%e')",
                inputtext, post_name);
            mysql_tquery(db_handle, query, "OnWhitelistActionDone", "i", playerid);
        }
        else if(gWhitelistAction[playerid] == 2)
        {
            mysql_format(db_handle, query, sizeof(query),
                "DELETE FROM `server_whitelist` WHERE `nickname`='%e' LIMIT 1",
                inputtext);
            mysql_tquery(db_handle, query, "OnWhitelistActionDone", "i", playerid);

            // ˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ whitelist ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ IP ˜˜˜ ˜˜˜˜˜ ˜˜˜˜.
            mysql_format(db_handle, query, sizeof(query),
                "DELETE FROM `whitelist_ips` WHERE `nickname`='%e'",
                inputtext);
            mysql_tquery(db_handle, query, "", "");
        }
        return true;
    }

    if(dialogid == AT_DIALOG_WHITELIST_LIST)
    {
        new page = GetPVarInt(playerid, "WL_PAGE");
        if(!response)
        {
            if(page > 0) WL_LoadListPage(playerid, page - 1);
            else WL_ShowMainMenu(playerid);
            return true;
        }

        if(GetPVarInt(playerid, "WL_HAS_NEXT"))
        {
            WL_LoadListPage(playerid, page + 1);
        }
        else
        {
            ShowNotification(playerid, 0, 4, 0, 0, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜.", "");
        }
        return true;
    }

    return false;
}

stock ShowSpectateGUI(playerid, targetid)
{
    if(!IsPlayerConnected(targetid)) return 0;

    new target_name[MAX_PLAYER_NAME];
    new Float:hp, Float:armor, Float:speed, ping, money, vehicleid, level;

    GetPlayerName(targetid, target_name, sizeof(target_name));
    GetPlayerHealth(targetid, hp);
    GetPlayerArmour(targetid, armor);

    ping = GetPlayerPing(targetid);
    money = Player[targetid][pMoney];
    level = Player[targetid][pLevel];
    vehicleid = GetPlayerVehicleID(targetid);

    new Float:vx, Float:vy, Float:vz;
    GetPlayerVelocity(targetid, vx, vy, vz);
    speed = floatsqroot(vx*vx + vy*vy + vz*vz) * 181.3;

    new Node:info1 = JSON_Object("p", JSON_Int(5), "n", JSON_String("˜˜˜˜"), "v", JSON_Int(ping));
    new Node:info2 = JSON_Object("p", JSON_Int(4), "n", JSON_String("˜˜˜˜˜˜˜˜"), "v", JSON_Int(floatround(speed)));
    new Node:info3 = JSON_Object("p", JSON_Int(2), "n", JSON_String("˜˜˜˜˜˜˜˜"), "v", JSON_Int(floatround(hp)));
    new Node:info4 = JSON_Object("p", JSON_Int(3), "n", JSON_String("˜˜˜˜˜"), "v", JSON_Int(floatround(armor)));
    new Node:info5 = JSON_Object("p", JSON_Int(6), "n", JSON_String("˜˜˜˜˜˜"), "v", JSON_Int(money));
    new Node:info6 = JSON_Object("p", JSON_Int(1), "n", JSON_String("˜˜˜˜˜˜˜"), "v", JSON_Int(level));
    new Node:info7 = JSON_Object("p", JSON_Int(7), "n", JSON_String("˜˜˜˜˜˜˜˜˜"), "v", JSON_Int(vehicleid));

    new Node:pi_array;
    if(Admin_IsJuniorModerator(playerid))
        pi_array = JSON_Array(info1, info2, info3, info4, info5, info6, info7);
    else
    {
        new ban_status[32];
        Admin_FormatBanStatus(targetid, ban_status, sizeof(ban_status));
        new Node:info8 = JSON_Object("p", JSON_Int(8), "n", JSON_String("˜˜˜"), "v", JSON_String(ban_status));
        new Node:info9 = JSON_Object("p", JSON_Int(9), "n", JSON_String("˜˜˜"), "v", JSON_Int(Player[targetid][pMuteTime]));
        new Node:info10 = JSON_Object("p", JSON_Int(10), "n", JSON_String("˜˜˜˜˜˜˜˜"), "v", JSON_Int(Player[targetid][pJailTime]));
        new Node:info11 = JSON_Object("p", JSON_Int(11), "n", JSON_String("˜˜˜˜˜"), "v", JSON_Int(Player[targetid][pWarns]));
        pi_array = JSON_Array(info1, info2, info3, info4, info5, info6, info7, info8, info9, info10, info11);
    }

    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 1);
    JSON_SetInt(json, "o", 1);
    JSON_SetInt(json, "id", targetid);
    JSON_SetString(json, "pn", target_name);
    JSON_SetArray(json, "pi", pi_array);
    if(Admin_IsJuniorModerator(playerid))
        JSON_SetInt(json, "hp", 1);

    OnPacketIncoming(playerid, 66, json);

    JSON_Cleanup(json);
    return 1;
}

stock ShowReportsGUI(playerid, targetid = INVALID_PLAYER_ID, const repText[] = "")
{
    if(targetid == INVALID_PLAYER_ID || !IsPlayerConnected(targetid))
    {
        targetid = GetPVarInt(playerid, "SpectatingID");
        if(!IsPlayerConnected(targetid)) targetid = playerid;
    }

    new pname[MAX_PLAYER_NAME];
    GetPlayerName(targetid, pname, sizeof(pname));

    new text[144];
    if(isnull(repText)) format(text, sizeof(text), "˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜");
    else format(text, sizeof(text), "%s", repText);

    SetPVarInt(playerid, "ANS_TARGET", targetid);
    SetPVarString(playerid, "ANS_TEXT", text);

    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 3);
    JSON_SetInt(json, "o", 1);
    JSON_SetInt(json, "id", targetid);
    JSON_SetString(json, "pn", pname);
    JSON_SetString(json, "tr", text);
    OnPacketIncoming(playerid, 66, json);
    JSON_Cleanup(json);
    return 1;
}

stock ShowControlPanelGUI(playerid)
{
    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 6);

    new Node:btn0 = JSON_Object("bi", JSON_Int(0), "bn", JSON_String("˜˜˜ ˜˜˜˜˜˜˜"), "be", JSON_String("˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜"));
    new Node:btn1 = JSON_Object("bi", JSON_Int(1), "bn", JSON_String("˜˜˜˜˜˜˜ ˜˜˜˜˜˜"), "be", JSON_String("˜˜˜˜˜ ˜˜˜˜˜˜"));
    new Node:btn7 = JSON_Object("bi", JSON_Int(7), "bn", JSON_String("˜˜˜˜˜˜˜˜˜"), "be", JSON_String("˜˜˜˜˜˜˜˜˜"));
    new Node:arr = JSON_Array(btn0, btn1, btn7);
    JSON_SetArray(json, "bt", arr);

    OnPacketIncoming(playerid, 66, json);
    JSON_Cleanup(json);
    return 1;
}

stock AT_SendPunishTemplates(playerid, category)
{
    new Node:json_response = JSON_Object();
    JSON_SetInt(json_response, "t", 2);

    switch(category)
    {
        case 3:
        {
            JSON_SetString(json_response, "bn", "˜˜˜");
            JSON_SetInt(json_response, "tf", 0);
            new Node:t1 = JSON_Object("bi", JSON_Int(1), "bn", JSON_String("Afk no esc"), "be", JSON_String("Afk no esc"));
