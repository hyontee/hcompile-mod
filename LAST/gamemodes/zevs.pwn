stock ShowGuiDebug_PrintList(playerid)
{
	SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜ GUI ID (˜˜˜˜˜˜ BR). ˜˜˜˜˜˜˜: /showgui [id] | ˜˜˜˜˜˜˜: /hidegui [id]");
	new line[256], name[56], count;
	for(new id = 1; id <= 82; id++)
	{
		if(!GetGuiDebugName(id, name, sizeof(name))) continue;
		if(count == 0) line[0] = EOS;
		format(line, sizeof(line), "%s%d=%s | ", line, id, name);
		count++;
		if(count >= 3)
		{
			SendClientMessage(playerid, COLOR_WHITE, line);
			count = 0;
		}
	}
	if(count) SendClientMessage(playerid, COLOR_WHITE, line);
	SendClientMessage(playerid, COLOR_GREY, "Legacy (3-12,15,23,26,31,41) ˜ ˜˜˜˜˜˜ ˜˜˜˜. ˜˜˜˜˜˜˜˜˜ GUI ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (˜˜˜˜˜˜, ˜˜˜˜˜).");
	return 1;
}

stock ShowGuiDebug_Open(playerid, guiid)
{
	SetPVarInt(playerid, "ShowGui_LastId", guiid);

	switch(guiid)
	{
		case 1:
		{
			OpenGibddRegistrationGUI(playerid);
			return 1;
		}
		case 2: return Fuel_ShowGui(playerid);
		case 14: return MM_ShowRadialMenu(playerid);
        case 22: return Menu_OpenDonate(playerid);
		case 27:
		{
			if(!Radial_OpenMenu(playerid))
				return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜˜: ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜."), 0;
			return 1;
		}
		case 28: return callcmd::tungui(playerid, "");
		case 33: return callcmd::inv(playerid, "");
		case 34:
		{
			new veh = GetClosestVehicleByTrunk(playerid, 5.0);
			if(veh <= 0) return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜."), 0;
			return Trunk_OpenForPlayer(playerid, veh);
		}
		case 45:
		{
			if(Player[playerid][pFamilyId] > 0)
				return Family_ShowMenu(playerid);
			return SendClientMessage(playerid, COLOR_RED, "˜˜ ˜˜ ˜ ˜˜˜˜˜. ˜˜˜˜˜˜˜˜: /createfm"), ShowGuiDebug_OpenRaw(playerid, 45);
		}
		case 66: return ShowControlPanelGUI(playerid);
		case 50: return SpawnLoc_ShowSelectionGUI(playerid);
		case 71: return Calendar_Show(playerid);
		case 73: return callcmd::cases(playerid, "");
		case 74: return callcmd::reward(playerid, "");
	}
	return ShowGuiDebug_OpenRaw(playerid, guiid);
}

stock ShowGuiDebug_OpenRaw(playerid, guiid)
{
	new Node:json = JSON_Object();
	JSON_SetInt(json, "o", 1);
	ShowPlayerGUI(playerid, guiid, json);
	JSON_Cleanup(json);
	return 1;
}

stock ShowGuiDebug_Close(playerid, guiid)
{
	if(guiid == 1 && g_GibddGuiOpen[playerid])
	{
		CloseGibddRegistrationGUI(playerid);
		return 1;
	}
	new Node:json = JSON_Object();
	HidePlayerGUI(playerid, guiid, json);
	JSON_Cleanup(json);
	return 1;
}

CMD:showgui(playerid, params[])
{
	if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < SHOWGUI_ADMIN_LVL)
		return SendClientMessage(playerid, COLOR_GREY, "˜˜˜ ˜˜˜˜˜˜˜ (˜˜˜˜˜ 3+).");

	new guiid;
	if(isnull(params))
		return ShowGuiDebug_PrintList(playerid);

	if(sscanf(params, "d", guiid))
		return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /showgui [id] ˜ ˜˜˜˜˜˜: /showgui");

	if(guiid < 1 || guiid > 255)
		return SendClientMessage(playerid, COLOR_RED, "ID GUI: 1˜255.");

	new name[56];
	if(!GetGuiDebugName(guiid, name, sizeof(name)))
		format(name, sizeof(name), "GUI #%d", guiid);

	ShowGuiDebug_Open(playerid, guiid);

	new msg[144];
	format(msg, sizeof(msg), "˜˜˜˜˜˜ GUI %d (%s). ˜˜˜˜˜˜˜: /hidegui %d", guiid, name, guiid);
	SendClientMessage(playerid, COLOR_WHITE, msg);
	return 1;
}

CMD:hidegui(playerid, params[])
{
	if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < SHOWGUI_ADMIN_LVL)
		return SendClientMessage(playerid, COLOR_GREY, "˜˜˜ ˜˜˜˜˜˜˜ (˜˜˜˜˜ 3+).");

	new guiid;
	if(isnull(params))
	{
		guiid = GetPVarInt(playerid, "ShowGui_LastId");
		if(guiid < 1)
			return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /hidegui [id]");
	}
	else if(sscanf(params, "d", guiid))
		return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /hidegui [id]");

	ShowGuiDebug_Close(playerid, guiid);

	new msg[64];
	format(msg, sizeof(msg), "˜˜˜˜˜˜ GUI %d.", guiid);
	SendClientMessage(playerid, COLOR_WHITE, msg);
	return 1;
}

stock OnPacketIncomingStr(playerid, guiid, const json_str[])
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT8, 252);
	BS_WriteValue(bitstream, PR_UINT16, guiid);
	BS_WriteValue(bitstream, PR_UINT32, strlen(json_str));
	BS_WriteValue(bitstream, PR_STRING, json_str);
	PR_SendPacket(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);
	BS_Delete(bitstream);
	return 1;
}

stock OnPacketIncoming(playerid, guiid, Node:json)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT8, 252);

	BS_WriteValue(bitstream, PR_UINT16, guiid);

	g_GuiJsonOutBuf[0] = '\0';
	JSON_Stringify(json, g_GuiJsonOutBuf, sizeof g_GuiJsonOutBuf);

	BS_WriteValue(bitstream, PR_UINT32, strlen(g_GuiJsonOutBuf));
	BS_WriteValue(bitstream, PR_STRING, g_GuiJsonOutBuf);

	PR_SendPacket(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);
	BS_Delete(bitstream);
}
IPacket:252(playerid, BitStream:bitstream)
{
    new header, guiid;
    BS_ReadValue(bitstream, PR_UINT8, header);
    BS_ReadValue(bitstream, PR_UINT16, guiid);

    new length;
    BS_ReadValue(bitstream, PR_UINT32, length);

    if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
    if(!IsPlayerConnected(playerid)) return 0;
    if(length <= 0 || length >= GUI_JSON_IN_BUF) return 0;

    g_GuiJsonInBuf[0] = '\0';
    BS_ReadValue(bitstream, PR_STRING, g_GuiJsonInBuf, length);
    g_GuiJsonInBuf[length] = '\0';

    new Node:json = JSON_Object();
    JSON_Parse(g_GuiJsonInBuf, json);

    switch (guiid)
    {
     case 40:
     {
        new t = 0;
        JSON_GetInt(json, "t", t);

        switch(t)
        {
            case 1: Hospital_Wound_OnWaitHelp(playerid);
            case 2: Hospital_Wound_OnHospitalButton(playerid);
        }

        JSON_Cleanup(json);
        return 1;
     }
     case 66:
{
    new buttonId = 0, screenType = 0, closeFlag = 0, tableButtonId = 0;
    JSON_GetInt(json, "b", buttonId);
    JSON_GetInt(json, "t", screenType);
    JSON_GetInt(json, "c", closeFlag);
    JSON_GetInt(json, "bi", tableButtonId);

    if(closeFlag == 1)
    {
        if(Admin_IsSpectating(playerid))
            Admin_StopSpectate(playerid);
        JSON_Cleanup(json);
        return 1;
    }

    switch(screenType)
    {
        case 1:
        {
            new targetid = GetPVarInt(playerid, "SpectatingID");
            if(targetid == -1 || !IsPlayerConnected(targetid))
            {
                SendClientMessage(playerid, 0xFF3333FF, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜!");
                JSON_Cleanup(json);
                return 1;
            }

            if(buttonId >= 3 && buttonId <= 8)
            {
                if(!Admin_CanUsePunishments(playerid))
                {
                    JSON_Cleanup(json);
                    return 1;
                }
                AT_SendPunishTemplates(playerid, buttonId);
            }
            else switch(buttonId)
            {
                case 1:
                {
                    new count = 0, players[MAX_PLAYERS];
                    for(new i = 0; i <= GetPlayerPoolSize(); i++)
                    {
                        if(!IsPlayerConnected(i) || i == playerid || i == targetid || IsPlayerNPC(i)) continue;
                        if(GetPVarInt(i, "IsSpectating")) continue;
                        players[count++] = i;
                    }
                    if(count == 0) ShowNotification(playerid, 0, 3, 0, 0, "˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜", "");
                    else
                    {
                        new nextTarget = players[random(count)];
                        new str_id[16];
                        valstr(str_id, nextTarget);
                        pc_cmd_sp(playerid, str_id);
                        ShowSpectateGUI(playerid, nextTarget);
                    }
                }
                case 2:
                {
                    new prevPlayer = -1;
                    for(new i = targetid - 1; i >= 0; i--)
                    {
                        if(!IsPlayerConnected(i) || i == playerid || IsPlayerNPC(i)) continue;
                        if(GetPVarInt(i, "IsSpectating")) continue;
                        prevPlayer = i;
                        break;
                    }
                    if(prevPlayer == -1) ShowNotification(playerid, 0, 3, 0, 0, "˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜", "");
                    else
                    {
                        new str_id[16];
                        valstr(str_id, prevPlayer);
                        pc_cmd_sp(playerid, str_id);
                        ShowSpectateGUI(playerid, prevPlayer);
                    }
                }
                case 9:
                {
                    new nextPlayer = -1;
                    for(new i = targetid + 1; i <= GetPlayerPoolSize(); i++)
                    {
                        if(!IsPlayerConnected(i) || i == playerid || IsPlayerNPC(i)) continue;
                        if(GetPVarInt(i, "IsSpectating")) continue;
                        nextPlayer = i;
                        break;
                    }
                    if(nextPlayer == -1) ShowNotification(playerid, 0, 3, 0, 0, "˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜", "");
                    else
                    {
                        new str_id[16];
                        valstr(str_id, nextPlayer);
                        pc_cmd_sp(playerid, str_id);
                        ShowSpectateGUI(playerid, nextPlayer);
                    }
                }
                case 10:
                {
                    DeletePVar(playerid, "MM_FromMenu");
                    MM_ShowPlayerStats(playerid, targetid);
                }
                case 11: ShowControlPanelGUI(playerid);
            }
        }

        case 2:
        {
            new targetid = GetPVarInt(playerid, "SpectatingID");
            if(targetid != -1 && IsPlayerConnected(targetid) && tableButtonId > 0)
            {
                AT_ApplyPunishTemplate(playerid, targetid, tableButtonId);
            }
        }

        case 3:
        {
            switch(buttonId)
            {
                case 1: AT_SendReportAnswerTemplates(playerid);
                case 2:
                {
                    new Node:close_json = JSON_Object();
                    JSON_SetInt(close_json, "c", 1);
                    OnPacketIncoming(playerid, 66, close_json);
                    JSON_Cleanup(close_json);
                }
                default:
                {
                    new targetid = AT_ResolveReportTarget(playerid, json);
                    if(targetid != INVALID_PLAYER_ID)
                        SetPVarInt(playerid, "ANS_TARGET", targetid);
                }
            }
        }

        case 4:
        {
            if(tableButtonId > 0) AT_HandleReportTemplateReply(playerid, tableButtonId);
        }

        case 5:
        {
            if(buttonId == 2)
            {
                new Node:back_json = JSON_Object();
                JSON_SetInt(back_json, "t", 3);
                JSON_SetInt(back_json, "o", 1);
                new targetid = AT_ResolveReportTarget(playerid, json);
                if(targetid != INVALID_PLAYER_ID)
                {
                    new pname[MAX_PLAYER_NAME], text[144];
                    GetPlayerName(targetid, pname, sizeof pname);
                    GetPVarString(playerid, "ANS_TEXT", text, sizeof text);
                    JSON_SetInt(back_json, "id", targetid);
                    JSON_SetString(back_json, "pn", pname);
                    JSON_SetString(back_json, "tr", text);
                }
                OnPacketIncoming(playerid, 66, back_json);
                JSON_Cleanup(back_json);
            }
            else
            {
                AT_HandleReportCustomReply(playerid, json);
            }
        }

        case 6:
        {
            new menuPick = tableButtonId;
            if(menuPick == 0 && buttonId > 0) menuPick = buttonId;

            if(menuPick == 0) AT_SendMyTemplates(playerid);
            else if(menuPick == 1)
            {
                new Node:json_response = JSON_Object();
                JSON_SetInt(json_response, "t", 9);
                JSON_SetString(json_response, "bn", "˜˜˜˜˜˜˜ ˜˜˜˜˜˜");
                OnPacketIncoming(playerid, 66, json_response);
                JSON_Cleanup(json_response);
            }
            else if(menuPick == 7) AT_SendCategories(playerid);
        }

        case 7:
        {
            if(tableButtonId >= 3 && tableButtonId <= 8)
            {
                if(!Admin_CanUsePunishments(playerid))
                {
                    JSON_Cleanup(json);
                    return 1;
                }
                AT_SendPunishTemplates(playerid, tableButtonId);
            }
        }

        case 8:
        {
            if(JSON_GetType(json, "bn") == JSON_NODE_STRING && JSON_GetType(json, "be") == JSON_NODE_STRING)
            {
                new title[64], desc[256], tm = 0;
                JSON_GetString(json, "bn", title, sizeof(title));
                JSON_GetString(json, "be", desc, sizeof(desc));
                BR_FixUserText(title, sizeof(title));
                BR_FixUserText(desc, sizeof(desc));
                JSON_GetInt(json, "br", tm);

                if(!strcmp(title, "fatal", true) && !strcmp(desc, "fatal", true))
                {
                    if(tableButtonId > 0)
                    {
                        new query[160];
                        mysql_format(db_handle, query, sizeof(query), "DELETE FROM `admin_templates` WHERE `id`=%d LIMIT 1", tableButtonId);
                        mysql_query(db_handle, query, false);
                        for(new i = 0; i < AT_MAX_TEMPLATES; i++)
                        {
                            if(AT_Templates[i][atUsed] && AT_Templates[i][atId] == tableButtonId)
                            {
                                AT_Templates[i][atUsed] = 0;
                                break;
                            }
                        }
                    }
                }
                else if(tableButtonId > 0)
                {
                    new query[512];
                    mysql_format(db_handle, query, sizeof(query),
                        "UPDATE `admin_templates` SET `title`='%e', `description`='%e', `time_value`=%d WHERE `id`=%d",
                        title, desc, tm, tableButtonId);
                    mysql_query(db_handle, query, false);
                    new tpl_slot = AT_FindTemplateById(tableButtonId);
                    new tpl_owner = Player[playerid][pID];
                    if(tpl_slot >= 0 && AT_Templates[tpl_slot][atCreatedBy] > 0)
                        tpl_owner = AT_Templates[tpl_slot][atCreatedBy];
                    AT_AddTemplateToCache(tableButtonId, 0, title, desc, tm, tpl_owner);
                }
                AT_SendMyTemplates(playerid);
            }
        }

        case 9:
        {
            new templateTitle[64], templateDesc[256], templateTime = 0;
            JSON_GetString(json, "bn", templateTitle, sizeof(templateTitle));
            JSON_GetString(json, "be", templateDesc, sizeof(templateDesc));
            BR_FixUserText(templateTitle, sizeof(templateTitle));
            BR_FixUserText(templateDesc, sizeof(templateDesc));
            JSON_GetInt(json, "br", templateTime);

            if(strlen(templateTitle) > 0 && strlen(templateDesc) > 0)
                AT_InsertTemplate(playerid, templateTitle, templateDesc, templateTime);
            else
                ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");
        }

        case 82:
        {
            new templateId = 0, title[64], desc[256], tm = 0;
            JSON_GetInt(json, "bi", templateId);
            JSON_GetString(json, "bn", title, sizeof(title));
            JSON_GetString(json, "be", desc, sizeof(desc));
            BR_FixUserText(title, sizeof(title));
            BR_FixUserText(desc, sizeof(desc));
            JSON_GetInt(json, "br", tm);

            if(templateId > 0)
            {
                new query[512];
                mysql_format(db_handle, query, sizeof(query),
                    "UPDATE `admin_templates` SET `title`='%e', `description`='%e', `time_value`=%d WHERE `id`=%d",
                    title, desc, tm, templateId);
                mysql_query(db_handle, query, false);
                new tpl_slot2 = AT_FindTemplateById(templateId);
                new tpl_owner2 = Player[playerid][pID];
                if(tpl_slot2 >= 0 && AT_Templates[tpl_slot2][atCreatedBy] > 0)
                    tpl_owner2 = AT_Templates[tpl_slot2][atCreatedBy];
                AT_AddTemplateToCache(templateId, 0, title, desc, tm, tpl_owner2);
                AT_SendMyTemplates(playerid);
            }
        }
    }

    JSON_Cleanup(json);
    return 1;
}

        case 22:
        {
