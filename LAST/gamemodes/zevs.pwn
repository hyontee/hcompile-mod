            }
            else if(type == 4 && gInStoSession[playerid])
            {
                JSON_SetInt(json_packet_data, "t", 4);
                JSON_SetInt(json_packet_data, "s", 1);
            }
            else if(type == 21)
            {
                new sel21 = 0;
                if(g_GuiJsonInBuf[0] && Tune_JsonHasKey(g_GuiJsonInBuf, "s"))
                    Tune_ExtractJsonIntField(g_GuiJsonInBuf, "s", sel21);
                else if(JSON_GetType(json, "s") != JSON_NODE_NULL)
                    JSON_GetInt(json, "s", sel21);
                if(gInStoSession[playerid] && Tune_IsStoSelector(sel21))
                {
                    SetPVarInt(playerid, "tune_bk_sel", sel21);
                    if(sel21 == 17 && !GetPVarType(playerid, "tune_bk_sub"))
                        SetPVarInt(playerid, "tune_bk_sub", 0);
                    DeletePVar(playerid, "tune_bk_tid");
                }
                else
                    Tune_SetActivePaintSelector(playerid, sel21);
                printf("[DEBUG] packet28 t=21 selector=%d paint_tgt=%d", sel21, Tune_GetActivePaintTarget(playerid));
                JSON_SetInt(json_packet_data, "t", 21);
                JSON_SetInt(json_packet_data, "s", 1);
            }
            else if(type == 22 && gInStoSession[playerid])
            {
                new tune_id22 = json_d_int;
                if(tune_id22 <= 0 && JSON_GetType(json, "d") != JSON_NODE_NULL)
                    JSON_GetInt(json, "d", tune_id22);
                SetPVarInt(playerid, "tune_bk_tid", tune_id22);
                new vehicleid_bk = GetPlayerVehicleID(playerid);
                new slot_bk = GetPlayerVehicleSlot(playerid, vehicleid_bk);
                if(slot_bk != -1 && tune_id22 >= 0)
                {
                    new sel22 = GetPVarInt(playerid, "tune_bk_sel");
