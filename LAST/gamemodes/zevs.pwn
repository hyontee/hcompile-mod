#define SHINKA_ENTRY_COUNT          (3)
#define SHINKA_EXIT_X               (1742.2319)
#define SHINKA_EXIT_Y               (2465.0336)
#define SHINKA_EXIT_Z               (14.6458)
#define SHINKA_EXIT_A               (286.155)

new bool:gInShinkaSession[MAX_PLAYERS];
new gShinkaStartWheel[MAX_PLAYERS];

static Float:g_ShinkaEntryPos[SHINKA_ENTRY_COUNT][4] =
{
    {1730.0820, 2457.1672, 14.9792, 88.7982},
    {1730.9165, 2453.2282, 14.9792, 111.5359},
    {1728.9774, 2462.1293, 14.9792, 94.6376}
};

stock DetectVehicleWheelComponent(vehicleid)
{
    if(vehicleid <= 0 || vehicleid == INVALID_VEHICLE_ID) return 0;
    if(!GetVehicleModel(vehicleid)) return 0;
    return GetVehicleComponentInSlot(vehicleid, CARMODTYPE_WHEELS);
}

stock bool:Shinka_IsPlayerAtEntry(playerid, Float:range = 5.0)
{
    for(new i = 0; i < SHINKA_ENTRY_COUNT; i++)
    {
        if(IsPlayerInRangeOfPoint(playerid, range,
            g_ShinkaEntryPos[i][0], g_ShinkaEntryPos[i][1], g_ShinkaEntryPos[i][2]))
            return true;
    }
    return false;
}

stock Shinka_InitWorld()
{
    for(new i = 0; i < SHINKA_ENTRY_COUNT; i++)
    {
        CreateDynamic3DTextLabel(
            "{f6fa05}˜˜˜˜˜˜˜˜˜˜\n{ffffff}˜˜˜˜˜˜˜: {e81717}'˜˜˜˜˜' {ffffff}˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜",
            0xFFFFFFFF,
            g_ShinkaEntryPos[i][0], g_ShinkaEntryPos[i][1], g_ShinkaEntryPos[i][2] + 0.35,
            12.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
    }
    return 1;
}

stock bool:Shinka_TryOpen(playerid)
{
    if(gInShinkaSession[playerid] || InStailing[playerid] || gInStoSession[playerid]) return false;

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
    {
        SendClientMessage(playerid, 0xFF6347FF, "˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");
        return false;
    }

    new slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1)
    {
        SendClientMessage(playerid, 0xFF6347FF, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");
        return false;
    }
    if(VehicleInfo[playerid][slot][vDBID] <= 0)
    {
        SendClientMessage(playerid, 0xFFFF00FF, "˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜ /car.");
        return false;
    }

    new Float:ex, Float:ey, Float:ez, Float:ea;
    GetVehiclePos(vehicleid, ex, ey, ez);
    GetVehicleZAngle(vehicleid, ea);
    SetPVarFloat(playerid, "shinka_ret_x", ex);
    SetPVarFloat(playerid, "shinka_ret_y", ey);
    SetPVarFloat(playerid, "shinka_ret_z", ez);
    SetPVarFloat(playerid, "shinka_ret_a", ea);

    Ts_SnapFuelMileage(playerid, vehicleid);
    Fuel_ForceEngineOff(vehicleid);

    new model = GetVehicleModel(vehicleid);
    new price = Tune_ResolveVehicleGosCost(playerid, slot, model);
    Tune_SetSessionGosCost(playerid, price);

    new Node:tuning_json = JSON_Object();
    InStailing[playerid] = false;
    gInShinkaSession[playerid] = true;

    JSON_SetInt(tuning_json, "o", 1);
    JSON_SetInt(tuning_json, "w", TUNE_SCREEN_SHINKA);
    JSON_SetInt(tuning_json, "j", price);
    JSON_SetInt(tuning_json, "s", 5);
    JSON_SetString(tuning_json, "nm", GetPlayerNameEx(playerid));
    JSON_SetString(tuning_json, "n", GetVehicleNameByModel(model));
    JSON_SetInt(tuning_json, "m", GetPlayerMoneyEx(playerid));
    JSON_SetInt(tuning_json, "dn", GetPlayerBlackCoin(playerid));

    SetPlayerInterior(playerid, 1);
    SetPlayerVirtualWorld(playerid, playerid + 2000);

    new carid = vehicleid;
    SetVehicleVirtualWorld(carid, playerid + 2000);
    SetVehiclePos(carid, 995.7154, 1000.5235, 1500.1683);
    SetVehicleZAngle(carid, 180.0);
    PutPlayerInVehicle(playerid, carid, 0);

    SetPlayerCameraPos(playerid, 999.1838, 995.9953, 1501.7263);
    SetPlayerCameraLookAt(playerid, 998.5103, 996.7333, 1501.5776);

    gShinkaStartWheel[playerid] = DetectVehicleWheelComponent(vehicleid);
    Tune_ResetWheelCollapseFields(playerid, slot);
    CarSystem_RefreshVehicleWheels(vehicleid, playerid, slot);
    JSON_SetArray(tuning_json, "k", Tune_BuildVehicleKArray(playerid, slot));
    OnPacketIncoming(playerid, 28, tuning_json);
    return true;
}

CMD:shinka(playerid, params[])
{
    Shinka_TryOpen(playerid);
    return 1;
}
// ----- end: shinka.inc -----

