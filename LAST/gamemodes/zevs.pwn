#include "../include/core/death_early_api.inc"

new SalonWheels[] = {0, 1025, 1073, 1074, 1075, 1076, 1077, 1078, 1079, 1080, 1081, 1082, 1083, 1084, 1085, 1096, 1097, 1098};

new p_SalonCarID[MAX_PLAYERS];
new p_SalonColor[MAX_PLAYERS][2];
new p_SalonWheelID[MAX_PLAYERS];
new p_BuyCar[MAX_PLAYERS] = {INVALID_VEHICLE_ID, ...};
new PlayerText:avtsln_PTD[MAX_PLAYERS][15] = {{PlayerText:INVALID_TEXT_DRAW, ...}, ...};

stock UpdateSalonVehicle(playerid, bool:recreate = true)
{
    new id = p_SalonCarID[playerid], model, price, maxspeed, Float:accel, name[32];
    if(p_SalonType[playerid] == 0) {
        model = SalonCars[id][sModel]; price = SalonCars[id][sPrice]; maxspeed = SalonCars[id][sMaxSpeed]; accel = SalonCars[id][sAcceleration]; strmid(name, SalonCars[id][sName], 0, strlen(SalonCars[id][sName]), 32);
    } else if(p_SalonType[playerid] == 1) {
        model = MediumSalonCars[id][sModel]; price = MediumSalonCars[id][sPrice]; maxspeed = MediumSalonCars[id][sMaxSpeed]; accel = MediumSalonCars[id][sAcceleration]; strmid(name, MediumSalonCars[id][sName], 0, strlen(MediumSalonCars[id][sName]), 32);
    } else {
        model = LowSalonCars[id][sModel]; price = LowSalonCars[id][sPrice]; maxspeed = LowSalonCars[id][sMaxSpeed]; accel = LowSalonCars[id][sAcceleration]; strmid(name, LowSalonCars[id][sName], 0, strlen(LowSalonCars[id][sName]), 32);
    }
    if(recreate) {
        if(p_BuyCar[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(p_BuyCar[playerid]);
        p_BuyCar[playerid] = CreateVehicle(model, 1149.8434, 226.0655, 994.7953, 20.8742, p_SalonColor[playerid][0], p_SalonColor[playerid][1], -1);
        SetVehicleVirtualWorld(p_BuyCar[playerid], playerid + 1);
        LinkVehicleToInterior(p_BuyCar[playerid], 1);
    }
    if(p_SalonWheelID[playerid] > 0) AddVehicleComponent(p_BuyCar[playerid], SalonWheels[p_SalonWheelID[playerid]]);
    new str[64];
    format(str, sizeof(str), "%d RUB", price); PlayerTextDrawSetString(playerid, avtsln_PTD[playerid][11], str);
    format(str, sizeof(str), "%d KM/H", maxspeed); PlayerTextDrawSetString(playerid, avtsln_PTD[playerid][12], str);
    format(str, sizeof(str), "%.1f C", accel); PlayerTextDrawSetString(playerid, avtsln_PTD[playerid][13], str);
    PlayerTextDrawSetString(playerid, avtsln_PTD[playerid][14], name);
    return 1;
}

stock HideAvtosalon(playerid)
{
    if(p_BuyCar[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(p_BuyCar[playerid]);
    p_BuyCar[playerid] = INVALID_VEHICLE_ID;
    for(new i = 0; i < 15; i++) {
        if(avtsln_PTD[playerid][i] != PlayerText:INVALID_TEXT_DRAW) { PlayerTextDrawDestroy(playerid, avtsln_PTD[playerid][i]); avtsln_PTD[playerid][i] = PlayerText:INVALID_TEXT_DRAW; }
    }
    CancelSelectTextDraw(playerid);
    TogglePlayerControllable(playerid, true);
    SetCameraBehindPlayer(playerid);
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    if(p_SalonType[playerid] == 0) { SetPlayerPos(playerid, 657.8327, 2661.4963, 13.5165); SetPlayerFacingAngle(playerid, 149.0740); } // high
    else if(p_SalonType[playerid] == 1) { SetPlayerPos(playerid, 1409.2773, 457.3852, 13.2030); SetPlayerFacingAngle(playerid, 154.0572); } // simple
    else { SetPlayerPos(playerid, 2477.1091, -721.4980, 12.3715); SetPlayerFacingAngle(playerid, 177.5868); }  // low
    return 1;
}

stock CreateAvtosalonTextDraws(playerid)
{
    avtsln_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 194.1663, 417.3706, "txd:brsalonbuy");
    PlayerTextDrawTextSize(playerid, avtsln_PTD[playerid][0], 98.0, 28.0);
    PlayerTextDrawSetSelectable(playerid, avtsln_PTD[playerid][0], true);

    avtsln_PTD[playerid][1] = CreatePlayerTextDraw(playerid, 357.0831, 417.3703, "txd:brsalonclose");
    PlayerTextDrawTextSize(playerid, avtsln_PTD[playerid][1], 89.0, 28.0);
    PlayerTextDrawSetSelectable(playerid, avtsln_PTD[playerid][1], true);

    avtsln_PTD[playerid][2] = CreatePlayerTextDraw(playerid, 167.9167, 350.4815, "txd:brsalonmain");
    PlayerTextDrawTextSize(playerid, avtsln_PTD[playerid][2], 305.0, 61.0);

    avtsln_PTD[playerid][3] = CreatePlayerTextDraw(playerid, 549.1669, 380.0369, "txd:brsalonright");
    PlayerTextDrawTextSize(playerid, avtsln_PTD[playerid][3], 30.0, 33.0);
    PlayerTextDrawSetSelectable(playerid, avtsln_PTD[playerid][3], true);

    avtsln_PTD[playerid][4] = CreatePlayerTextDraw(playerid, 65.4165, 381.0743, "txd:brsalonleft");
    PlayerTextDrawTextSize(playerid, avtsln_PTD[playerid][4], 30.0, 33.0);
    PlayerTextDrawSetSelectable(playerid, avtsln_PTD[playerid][4], true);

    avtsln_PTD[playerid][5] = CreatePlayerTextDraw(playerid, 493.7499, 135.2962, "txd:brsaloninfo");
    PlayerTextDrawTextSize(playerid, avtsln_PTD[playerid][5], 138.0, 114.0);

    avtsln_PTD[playerid][6] = CreatePlayerTextDraw(playerid, 4.9998, 147.2220, "txd:brsaloncastom");
    PlayerTextDrawTextSize(playerid, avtsln_PTD[playerid][6], 134.0, 106.0);

    avtsln_PTD[playerid][7] = CreatePlayerTextDraw(playerid, 116.25, 221.37, "txd:brsalonnext");
    avtsln_PTD[playerid][8] = CreatePlayerTextDraw(playerid, 116.25, 187.14, "txd:brsalonnext");
    avtsln_PTD[playerid][9] = CreatePlayerTextDraw(playerid, 5.83, 220.85, "txd:brsalonback");
    avtsln_PTD[playerid][10] = CreatePlayerTextDraw(playerid, 5.83, 186.62, "txd:brsalonback");
    
    for(new i = 7; i <= 10; i++) {
        PlayerTextDrawTextSize(playerid, avtsln_PTD[playerid][i], 21.0, 29.0);
        PlayerTextDrawSetSelectable(playerid, avtsln_PTD[playerid][i], true);
    }

    avtsln_PTD[playerid][11] = CreatePlayerTextDraw(playerid, 356.2502, 389.6296, "0 RUB");
    PlayerTextDrawLetterSize(playerid, avtsln_PTD[playerid][11], 0.4, 1.6);
    PlayerTextDrawFont(playerid, avtsln_PTD[playerid][11], 1);

    avtsln_PTD[playerid][12] = CreatePlayerTextDraw(playerid, 610.0, 182.0, "0 KM/H");
    PlayerTextDrawLetterSize(playerid, avtsln_PTD[playerid][12], 0.32, 1.35); 
    PlayerTextDrawAlignment(playerid, avtsln_PTD[playerid][12], 2); 

    avtsln_PTD[playerid][13] = CreatePlayerTextDraw(playerid, 610.0, 221.0, "0.0 SEC");
    PlayerTextDrawLetterSize(playerid, avtsln_PTD[playerid][13], 0.32, 1.35); 
    PlayerTextDrawAlignment(playerid, avtsln_PTD[playerid][13], 2);

    avtsln_PTD[playerid][14] = CreatePlayerTextDraw(playerid, 254.1665, 357.4815, "None");
    PlayerTextDrawLetterSize(playerid, avtsln_PTD[playerid][14], 0.4, 1.6);
    PlayerTextDrawFont(playerid, avtsln_PTD[playerid][14], 1);

    for(new i = 0; i < 15; i++) {
        PlayerTextDrawColor(playerid, avtsln_PTD[playerid][i], -1);
        PlayerTextDrawBackgroundColor(playerid, avtsln_PTD[playerid][i], 255);
        PlayerTextDrawSetProportional(playerid, avtsln_PTD[playerid][i], 1);
        PlayerTextDrawSetShadow(playerid, avtsln_PTD[playerid][i], 0);
        if(i <= 10) PlayerTextDrawFont(playerid, avtsln_PTD[playerid][i], 4);
        else if(i != 12 && i != 13) PlayerTextDrawAlignment(playerid, avtsln_PTD[playerid][i], 1);
    }
    return 1;
}

