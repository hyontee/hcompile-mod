stock AT_EnsureTemplatesTable()
{
    mysql_tquery(db_handle,
        "CREATE TABLE IF NOT EXISTS `admin_templates` (\
        `id` INT NOT NULL AUTO_INCREMENT,\
        `category` INT NOT NULL DEFAULT 0,\
        `title` VARCHAR(64) NOT NULL DEFAULT '',\
        `description` VARCHAR(256) NOT NULL DEFAULT '',\
        `time_value` INT NOT NULL DEFAULT 0,\
        `created_by` INT NOT NULL DEFAULT 0,\
        PRIMARY KEY (`id`),\
        KEY `idx_admin_templates_creator` (`created_by`)\
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci", "", "");
    return 1;
}

stock AT_AddTemplateToCache(templateId, category, const title[], const desc[], time_value, created_by = 0)
{
    if(templateId <= 0) return 0;

    new slot = AT_FindTemplateById(templateId);
    if(slot < 0)
    {
        for(new i = 0; i < AT_MAX_TEMPLATES; i++)
        {
            if(AT_Templates[i][atUsed]) continue;
            slot = i;
            break;
        }
    }
    if(slot < 0) return 0;

    AT_Templates[slot][atUsed] = 1;
    AT_Templates[slot][atId] = templateId;
    AT_Templates[slot][atCategory] = category;
    AT_Templates[slot][atTime] = time_value;
    AT_Templates[slot][atCreatedBy] = created_by;
    format(AT_Templates[slot][atTitle], 64, "%s", title);
    format(AT_Templates[slot][atDesc], 256, "%s", desc);
    return 1;
}

stock AT_InsertTemplate(playerid, const title[], const desc[], time_value)
{
    if(Player[playerid][pID] <= 0) return 0;

    new query[700];
    mysql_format(db_handle, query, sizeof(query),
        "INSERT INTO `admin_templates` (`category`,`title`,`description`,`time_value`,`created_by`) \
        VALUES (0,'%e','%e',%d,%d)",
        title, desc, time_value, Player[playerid][pID]);
    mysql_query(db_handle, query, false);

    new templateId = cache_insert_id();
    if(templateId <= 0)
    {
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜.", "");
        return 0;
    }

    AT_AddTemplateToCache(templateId, 0, title, desc, time_value, Player[playerid][pID]);
    ShowNotification(playerid, 1, 4, 0, 0, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜.", "");
    if(Player[playerid][pID] <= 0)
        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜, ˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜.", "");
    AT_SendMyTemplates(playerid);
    return 1;
}

stock AdminToolsInit()
{
    AT_EnsureTemplatesTable();
    AT_LoadTemplates();
    WL_LoadConfig();
    return 1;
}

stock bool:AT_CanManageWhitelist(playerid)
{
    return (Player[playerid][pAdminAuth] && Player[playerid][pAdminLvl] >= 13);
}

