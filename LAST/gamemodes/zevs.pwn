#if !defined SIM_BUY_COOLDOWN
	#define SIM_BUY_COOLDOWN (3)
#endif

new g_simBuyCooldown[MAX_PLAYERS];

stock ShowSimCardBuyDialog(playerid)
{
	new now = gettime();
	if(now - g_simBuyCooldown[playerid] < SIM_BUY_COOLDOWN)
	{
		new wait_msg[80], left = SIM_BUY_COOLDOWN - (now - g_simBuyCooldown[playerid]);
		format(wait_msg, sizeof wait_msg, "˜˜˜˜˜˜˜˜˜ %d ˜˜˜. ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜.", left);
		SendClientMessage(playerid, 0xCECECEFF, wait_msg);
		return 0;
	}
	g_simBuyCooldown[playerid] = now;
	ShowPlayerDialog(playerid, DIALOG_BIZ_SHOP_24_7_SIM, DIALOG_STYLE_INPUT,
		CAR_DLG_PREFIX "˜˜˜-˜˜˜˜˜",
		"{FFFFFF}˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜-˜˜˜˜˜\n{AAAAAA}(4 ˜˜˜ 6 ˜˜˜˜, ˜˜˜˜˜˜˜˜ 4444 ˜˜˜ 123456)\n\n" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜˜: " CAR_CLR_GOLD "2000 ˜˜˜",
		"˜˜˜˜˜˜", "˜˜˜˜˜˜");
	return 1;
}

stock IsSimNumberOnlineTaken(simnumber, except_playerid = -1)
{
	if(simnumber <= 0) return 0;
	for(new p = 0; p < MAX_PLAYERS; p++)
	{
		if(!IsPlayerConnected(p)) continue;
		if(p == except_playerid) continue;
		if(GetPlayerSimCard(p) == simnumber) return 1;
		if(IsPlayerOwnsSimNumber(p, simnumber)) return 1;
	}
	return 0;
}

stock GenerateFreePhoneSim(playerid)
{
	for(new attempt = 0; attempt < 50; attempt++)
	{
		new num = 100000 + random(900000);
		if(!IsSimNumberOnlineTaken(num, playerid)) return num;
	}
	return 100000 + random(900000);
}

stock bool:IsNumeric(const str[])
{
	new len = strlen(str);
	if(!len) return false;
	for(new i; i < len; i++)
	{
		if(str[i] < '0' || str[i] > '9') return false;
	}
	return true;
}

stock GetElapsedTime(time, to_time, type = CONVERT_TIME_TO_DAYS)
{
	new result;
	switch(type)
	{
		case CONVERT_TIME_TO_DAYS:
		{
			result = ((time - (time % 86400)) - (to_time - (to_time % 86400))) / 86400;
		}
		default: result = 0;
	}
	return result;
}

stock GetPlayerIpBiz(playerid, dest[], len)
{
	GetPlayerIp(playerid, dest, len);
}

stock GetPlayerInBiz(playerid)
{
	if(!GetPVarType(playerid, "InBiz")) return -1;
	new v = GetPVarInt(playerid, "InBiz");
	if(v < 0) return -1;
	return v;
}

stock SetPlayerInBiz(playerid, bid)
{
	if(bid < 0) DeletePVar(playerid, "InBiz");
	else SetPVarInt(playerid, "InBiz", bid);
	return 1;
}

#define SetPlayerUseListitem(%0,%1) (g_biz_listitem_use[%0] = %1)
#define GetPlayerUseListitem(%0) (g_biz_listitem_use[%0])

stock bool:IsBusinessOwned(businessid)
{
	return GetBusinessData(businessid, B_OWNER_ID) != 0;
}

stock bool:IsBusinessSlotValid(businessid)
{
	if(businessid < 0 || businessid >= g_business_loaded) return false;
	return GetBusinessData(businessid, B_SQL_ID) > 0;
}

stock bool:IsBusinessSlotUsable(businessid)
{
	if(businessid < 0 || businessid >= g_business_loaded) return false;
	return GetBusinessData(businessid, B_ENTER_PICKUP) != 0;
}

stock BusinessSpawnWorldObjects(businessid)
{
	if(businessid < 0 || businessid >= MAX_BUSINESS) return 0;

	if(GetBusinessData(businessid, B_LABEL))
		DestroyDynamic3DTextLabel(GetBusinessData(businessid, B_LABEL));
	if(GetBusinessData(businessid, B_ENTER_PICKUP))
		DestroyDynamicPickup(GetBusinessData(businessid, B_ENTER_PICKUP));

	g_business[businessid][B_LABEL] = CreateDynamic3DTextLabel("...", 0xFF5252FF,
		GetBusinessData(businessid, B_POS_X),
		GetBusinessData(businessid, B_POS_Y),
		GetBusinessData(businessid, B_POS_Z) + 1.0,
		BIZ_LABEL_DRAW, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
		0, 0, -1, BIZ_LABEL_STREAM);
	g_business[businessid][B_ENTER_PICKUP] = CreateDynamicPickup(19132, 23,
		GetBusinessData(businessid, B_POS_X),
		GetBusinessData(businessid, B_POS_Y),
		GetBusinessData(businessid, B_POS_Z), 0, 0, -1, BIZ_ENT_PICKUP_STREAM);

	UpdateBusinessLabel(businessid);
	return 1;
}

stock BusinessDestroyWorldObjects(businessid)
{
	if(businessid < 0 || businessid >= MAX_BUSINESS) return 0;

	if(GetBusinessData(businessid, B_LABEL))
	{
		DestroyDynamic3DTextLabel(GetBusinessData(businessid, B_LABEL));
		SetBusinessData(businessid, B_LABEL, Text3D:0);
	}
	if(GetBusinessData(businessid, B_ENTER_PICKUP))
	{
		DestroyDynamicPickup(GetBusinessData(businessid, B_ENTER_PICKUP));
		SetBusinessData(businessid, B_ENTER_PICKUP, 0);
	}
	if(GetBusinessData(businessid, B_HEALTH_PICKUP))
	{
		DestroyDynamicPickup(GetBusinessData(businessid, B_HEALTH_PICKUP));
		SetBusinessData(businessid, B_HEALTH_PICKUP, 0);
	}
	Snack_DestroyForBusiness(businessid);
	return 1;
}

