stock GetAddBizTypeByItem(listitem)
{
	static const type_map[12] = {1, 2, 3, 5, 6, 7, 8, 9, 10, 11, 13, 16};
	if(!(0 <= listitem < sizeof type_map)) return 1;
	return type_map[listitem];
}

stock GetAddBizInteriorByType(type)
{
	switch(type)
	{
		case 1: return BUSINESS_INTERIOR_SHOP_24_7;
		case 2: return BUSINESS_INTERIOR_CLUB;
		case 3: return BUSINESS_INTERIOR_REALTOR_BIZ;
		case 5: return BUSINESS_INTERIOR_CLOTHING_SHOP;
		case 6: return BUSINESS_INTERIOR_HOTEL;
		case 7: return BUSINESS_INTERIOR_CAR_MARKET;
		case 8: return BUSINESS_INTERIOR_CASINO;
		case 9: return BUSINESS_INTERIOR_CELL_SALON;
		case 10: return BUSINESS_INTERIOR_CAR_TUNING;
		case 11: return BUSINESS_INTERIOR_SHOP_GUN;
		case 13: return BUSINESS_INTERIOR_CLOTHING_SHOP; // ˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜
		case 16: return BUSINESS_INTERIOR_SNACK;
	}
	return BUSINESS_INTERIOR_SHOP_24_7;
}

stock bool:GetLairdBizDefaultCoords(type, &Float:x, &Float:y, &Float:z, &Float:a)
{
	switch(type)
	{
		// ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ (11 ˜˜˜˜˜ ˜˜ /addbiz).
		case BUSINESS_TYPE_SHOP_24_7:      { x = 1549.72;   y = 422.58;   z = 1001.96;   a = 180.0; return true; } // ˜˜˜˜˜˜˜ 24/7
		case BUSINESS_TYPE_CLUB:           { x = -18.38;    y = -0.77;    z = 1510.46;   a = 180.0; return true; } // ˜˜˜˜ Moon
		case BUSINESS_TYPE_REALTOR_BIZ:    { x = 1985.16;   y = -0.17;    z = 1382.25;   a = 180.0; return true; } // ˜˜˜˜ ˜˜˜ / ˜˜˜˜˜˜˜˜˜˜
		case BUSINESS_TYPE_CLOTHING_SHOP:  { x = 1199.63;   y = 599.47;   z = 1349.99;   a = 180.0; return true; } // ˜˜˜˜˜ ˜˜˜˜˜˜
		case BUSINESS_TYPE_HOTEL:          { x = 1500.0;    y = 2500.0;   z = 1500.0;    a = 180.0; return true; } // ˜˜˜˜˜˜˜˜˜
		case BUSINESS_TYPE_CAR_MARKET:     { x = 1150.0;    y = 222.0;    z = 1000.0;    a = 180.0; return true; } // ˜˜˜˜˜˜˜˜˜
		case BUSINESS_TYPE_CASINO:         { x = 2503.62;   y = 2443.63;  z = 2499.8;    a = 180.0; return true; } // ˜˜˜˜/˜˜˜˜˜˜
		case BUSINESS_TYPE_CELL_SALON:     { x = 2903.16;   y = 2498.33;  z = 1052.19;   a = 180.0; return true; } // ˜˜˜˜ (˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜)
		case BUSINESS_TYPE_CAR_TUNING:     { x = 2500.0;    y = 1500.0;   z = 1500.0;    a = 180.0; return true; } // ˜˜˜
		case BUSINESS_TYPE_SHOP_GUN:       { x = 2900.0;    y = 2900.0;   z = 1500.0;    a = 180.0; return true; } // ˜˜˜˜˜˜˜ ˜˜˜˜˜˜
		case BUSINESS_TYPE_ACCESSORY_SHOP: { x = 2286.0;    y = 1837.0;   z = 1521.0;    a = 180.0; return true; } // ˜˜˜˜˜˜ ˜˜˜˜˜ / ˜˜˜˜˜˜˜˜˜˜
