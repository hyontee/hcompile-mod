#define TUNE_ITEM_EXHAUST_MAX (98)
#define TUNE_ITEM_HORN_MIN    (99)
#define TUNE_ITEM_HORN_MAX    (129)
#define TUNE_ITEM_BODY_MIN    (300)
#define TUNE_ITEM_BODY_MAX    (2000)
#define TUNE_SEL_WEAR           (15)
#define TUNE_BK_ENTRY_LEN       (32)

#define TUNE_SEL_COLLAPSE_MIN     (22)
#define TUNE_SEL_COLLAPSE_MAX     (30)

// ˜˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜, ˜˜˜˜˜, ˜˜˜˜˜˜, ˜˜˜˜˜˜, ˜˜˜˜˜˜ ˜ ˜ ˜˜˜˜˜˜˜˜˜˜ (˜˜˜˜˜˜ ˜˜˜˜˜, ˜˜˜˜˜˜, ˜˜˜˜˜).
stock bool:Tune_IsCollapseSelectorDisabled(selector_id)
{
    return (selector_id >= TUNE_SEL_COLLAPSE_MIN && selector_id <= TUNE_SEL_COLLAPSE_MAX);
}

stock Float:Tune_CollapseUiToFloat(val)
{
    return float(val) / 100.0;
}

stock Tune_CollapseFloatToUi(Float:val)
{
    return floatround(val * 100.0);
}

// ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜ UI 0..100 ˜˜˜ float (50.0 ˜˜˜˜˜˜ 0.5).
stock Float:Tune_NormalizeCollapseStored(Float:stored)
{
    if(stored <= 0.0) return 0.0;
    if(stored > 1.0) return stored / 100.0;
    return stored;
}

stock Tune_StoredToUi(Float:stored)
{
    stored = Tune_NormalizeCollapseStored(stored);
    if(stored < 0.0) return 0;
    return Tune_CollapseFloatToUi(stored);
}

stock Tune_ResetWheelCollapseFields(playerid, slot_idx)
{
    VehicleInfo[playerid][slot_idx][vClearance] = 0.0;
    VehicleInfo[playerid][slot_idx][vClearanceFront] = 0.0;
    VehicleInfo[playerid][slot_idx][vClearanceRear] = 0.0;
    VehicleInfo[playerid][slot_idx][vOffsetFront] = 0.0;
    VehicleInfo[playerid][slot_idx][vOffsetRear] = 0.0;
    VehicleInfo[playerid][slot_idx][vCamberFront] = 0.0;
    VehicleInfo[playerid][slot_idx][vCamberRear] = 0.0;
    VehicleInfo[playerid][slot_idx][vWheelWidthFront] = 0.0;
    VehicleInfo[playerid][slot_idx][vWheelWidthRear] = 0.0;
    VehicleInfo[playerid][slot_idx][vWheelRadius] = 0.0;
    return 1;
}

stock VehicleInfo_ClearSlot(playerid, slot, bool:destroy_spawned)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;

    if(destroy_spawned && VehicleInfo[playerid][slot][vSpawned])
    {
        new vid = VehicleInfo[playerid][slot][vID];
        if(vid != INVALID_VEHICLE_ID && GetVehicleModel(vid) > 0)
        {
            Trunk_ResetVehicle(vid);
            DestroyVehicle(vid);
            InvalidateVehicleOwnerCache(vid);
        }
    }

    VehicleInfo[playerid][slot][vID] = INVALID_VEHICLE_ID;
    VehicleInfo[playerid][slot][vDBID] = 0;
    VehicleInfo[playerid][slot][vModel] = 0;
    VehicleInfo[playerid][slot][vPrice] = 0;
    VehicleInfo[playerid][slot][vColor][0] = 0;
    VehicleInfo[playerid][slot][vColor][1] = 0;
    VehicleInfo[playerid][slot][vBodyColor] = 0;
    VehicleInfo[playerid][slot][vDiskColor] = 0;
    VehicleInfo[playerid][slot][vWheel] = 0;
    VehicleInfo[playerid][slot][vPos][0] = 0.0;
    VehicleInfo[playerid][slot][vPos][1] = 0.0;
    VehicleInfo[playerid][slot][vPos][2] = 0.0;
    VehicleInfo[playerid][slot][vPos][3] = 0.0;
    VehicleInfo[playerid][slot][vSpawned] = false;
    VehicleInfo[playerid][slot][vSport] = 0;
    VehicleInfo[playerid][slot][vDrift] = 0;
    VehicleInfo[playerid][slot][vComfort] = 0;
    VehicleInfo[playerid][slot][vSportPlus] = 0;
    VehicleInfo[playerid][slot][vSportA] = false;
    VehicleInfo[playerid][slot][vDriftA] = false;
    VehicleInfo[playerid][slot][vComfortA] = false;
    VehicleInfo[playerid][slot][vSportPlusA] = false;
    VehicleInfo[playerid][slot][vNitro] = 0;
    VehicleInfo[playerid][slot][vWindFront] = 0;
    VehicleInfo[playerid][slot][vWindRear] = 0;
    VehicleInfo[playerid][slot][vNeonMain] = 0;
    VehicleInfo[playerid][slot][vNeon1] = 0;
    VehicleInfo[playerid][slot][vNeon2] = 0;
    VehicleInfo[playerid][slot][vLightsColor] = 0;
    VehicleInfo[playerid][slot][vStrob] = 5;
    VehicleInfo[playerid][slot][vStrobState] = false;
    VehicleInfo[playerid][slot][vVinyl][0] = '\0';
    VehicleInfo[playerid][slot][vDalniysvet] = 0;
    VehicleInfo[playerid][slot][Dalniysvet] = false;
    Tune_ResetWheelCollapseFields(playerid, slot);
    VehicleInfo[playerid][slot][vWheelModel] = 0;
    VehicleInfo[playerid][slot][vHydra] = 0;
    VehicleInfo[playerid][slot][vPnevmo] = 0;
    VehicleInfo[playerid][slot][vPnevmoMode] = 0;
    VehicleInfo[playerid][slot][vLaunchControl] = 0;
    VehicleInfo[playerid][slot][vLaunchControlOn] = false;
    VehicleInfo[playerid][slot][vHornSound] = 0;
    VehicleInfo[playerid][slot][vExhaustSound] = -1;
    VehicleInfo[playerid][slot][vNeonState] = false;
    VehicleInfo[playerid][slot][vHydraState] = false;
    VehicleInfo[playerid][slot][vFuel] = 0.0;
    VehicleInfo[playerid][slot][vHealth] = 1000.0;
    gVehicleMileage[playerid][slot] = 0.0;
    VehicleInfo[playerid][slot][vPlateType] = 0;
    VehicleInfo[playerid][slot][vPlateNumber][0] = '\0';
    VehicleInfo[playerid][slot][vPlateRegion][0] = '\0';
    VehicleInfo[playerid][slot][vAutoEngine] = false;
    VehicleInfo[playerid][slot][vAutoLock] = false;
    VehicleInfo[playerid][slot][vLastPos][0] = 0.0;
    VehicleInfo[playerid][slot][vLastPos][1] = 0.0;
    VehicleInfo[playerid][slot][vLastPos][2] = 0.0;
    VehicleInfo[playerid][slot][vLastPos][3] = 0.0;
    VehicleInfo[playerid][slot][vLastValid] = false;
    VehicleInfo[playerid][slot][vFamFleetBorrow] = false;
    VehicleInfo[playerid][slot][vPlateStr][0] = '\0';
    VehicleInfo[playerid][slot][vBodyKits][0] = '\0';
    return 1;
}

stock ResetPlayerVehicleSlot(playerid, slot)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    return VehicleInfo_ClearSlot(playerid, slot, true);
}

stock Tune_ResetWheelCollapseDb(car_dbid, dest[], dest_len)
{
    return mysql_format(db_handle, dest, dest_len,
        "UPDATE `ownable_cars` SET `clearance`=0, `clearance_front`=0, `clearance_rear`=0, \
        `offset_front`=0, `offset_rear`=0, `camber_front`=0, `camber_rear`=0, \
        `wheel_width_front`=0, `wheel_width_rear`=0, `wheel_radius`=0 WHERE `id`=%d LIMIT 1",
        car_dbid);
}

