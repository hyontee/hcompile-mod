stock Tune_ApplyWheelPhysicsPlr(forplayerid, vehicleid, ownerid, slot)
{
    #pragma unused forplayerid, vehicleid, ownerid, slot
    return 1;
}

stock bool:Tune_SaveCollapseField(playerid, slot_idx, selector_id, Float:cf, car_dbid, dest[], dest_len)
{
    #pragma unused playerid, slot_idx, cf, car_dbid, dest, dest_len
    if(Tune_IsCollapseSelectorDisabled(selector_id)) return false;
    return false;
}

stock bool:Tune_ItemIsExhaust(item_id)
{
    return (item_id >= TUNE_ITEM_EXHAUST_MIN && item_id <= TUNE_ITEM_EXHAUST_MAX);
}

// tune-items.json: COMFORT 4,9,14,19,24 | SPORT 5,10,15,20,25 | DRIFT 6,11,16,21,26 | SPORT+ 7,12,17,22,27
stock bool:Tune_IsEngineChipItemId(item_id)
{
    switch(item_id)
    {
        case 4, 5, 6, 7, 9, 10, 11, 12, 14, 15, 16, 17, 19, 20, 21, 22, 24, 25, 26, 27:
            return true;
    }
    return false;
}

stock Tune_GetExhaustSoundFromItemId(item_id)
{
    if(!Tune_ItemIsExhaust(item_id)) return -1;
    return item_id - TUNE_ITEM_EXHAUST_MIN;
}

