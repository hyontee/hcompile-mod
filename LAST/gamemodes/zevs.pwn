stock AT_BuildMyTemplatesBtJson(playerid, dest[], dest_size, &count)
{
    dest[0] = '\0';
    count = 0;
    strcat(dest, "[", dest_size);

    new ownerId = Player[playerid][pID];
    new bool:first = true;
    new esc_t[96], esc_d[300], chunk[512];

    for(new i = 0; i < AT_MAX_TEMPLATES; i++)
    {
        if(!AT_Templates[i][atUsed]) continue;
        if(ownerId > 0 && AT_Templates[i][atCreatedBy] > 0 && AT_Templates[i][atCreatedBy] != ownerId)
            continue;

        if(!first) strcat(dest, ",", dest_size);
        first = false;

        Inv_EscapeJsonString(AT_Templates[i][atTitle], esc_t, sizeof esc_t);
        Inv_EscapeJsonString(AT_Templates[i][atDesc], esc_d, sizeof esc_d);

        if(AT_Templates[i][atTime] > 0)
        {
            format(chunk, sizeof chunk, "{\"bi\":%d,\"bn\":\"%s\",\"be\":\"%s\",\"br\":%d}",
                AT_Templates[i][atId], esc_t, esc_d, AT_Templates[i][atTime]);
        }
        else
        {
            format(chunk, sizeof chunk, "{\"bi\":%d,\"bn\":\"%s\",\"be\":\"%s\"}",
                AT_Templates[i][atId], esc_t, esc_d);
        }
        strcat(dest, chunk, dest_size);
        count++;
    }
    strcat(dest, "]", dest_size);
    return 1;
}

stock AT_SendMyTemplates(playerid)
{
    new count = 0;
    new bt_json[16384];
    AT_BuildMyTemplatesBtJson(playerid, bt_json, sizeof bt_json, count);

    new Node:json_response = JSON_Object();
    JSON_SetInt(json_response, "t", 8);
    JSON_SetString(json_response, "bn", "˜˜˜ ˜˜˜˜˜˜˜");

    new Node:arr = JSON_Array();
    if(count > 0)
    {
        JSON_Parse(bt_json, arr);
    }
    JSON_SetArray(json_response, "bt", arr);

    OnPacketIncoming(playerid, 66, json_response);
    JSON_Cleanup(json_response);
    JSON_Cleanup(arr);

    if(count == 0)
    {
        ShowNotification(playerid, 0, 4, 0, 0, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜.", "");
    }
    return 1;
}

