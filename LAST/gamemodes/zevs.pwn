stock Biz_GetInteriorVW(businessid)
{
	if(businessid < 0 || businessid >= MAX_BUSINESS)
		return 0;
	return BR_GetBusinessInteriorVW(businessid);
}

stock House_GetInteriorVW(houseid)
{
	if(houseid < 0 || houseid >= TotalHouses)
		return 0;
	// laird.pwn EnterPlayerToHouse: virtualworld = houseid + 2000
	return houseid + HOUSE_INTERIOR_VW_BASE;
}

stock bool:Biz_IsPlayerInside(playerid, businessid = -1)
{
	if(businessid == -1) businessid = GetPlayerInBiz(playerid);
	if(businessid < 0 || businessid >= g_business_loaded) return false;
	new idx = GetBusinessData(businessid, B_INTERIOR);
	if(GetPlayerInterior(playerid) != GetBusinessInteriorInfo(idx, BT_ENTER_INTERIOR))
		return false;
	if(GetPlayerVirtualWorld(playerid) != Biz_GetInteriorVW(businessid))
		return false;
	return true;
}

forward bool:Player_IsInValidInteriorWorld(playerid);
forward Player_FixInteriorWorldLeak(playerid);

stock Biz_ResetWorldIfOrphan(playerid)
{
	return Player_FixInteriorWorldLeak(playerid);
}

stock ExitPlayerFromBiz(playerid)
{
	new businessid = GetPlayerInBiz(playerid);
	if(businessid == -1)
	{
		Biz_ResetWorldIfOrphan(playerid);
		return 0;
	}

	if(Shop_IsInShop(playerid))
	{
		Shop_Exit(playerid);
		return 1;
	}

	HideInteractionWindow(playerid);
	Shop247_OnExitBiz(playerid);

	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerPos(playerid,
		GetBusinessData(businessid, B_EXIT_POS_X),
		GetBusinessData(businessid, B_EXIT_POS_Y),
		GetBusinessData(businessid, B_EXIT_POS_Z));
	SetPlayerFacingAngle(playerid, GetBusinessData(businessid, B_EXIT_ANGLE));
	SetPlayerInBiz(playerid, -1);
	SetPlayerUseListitem(playerid, -1);
	Player_FixInteriorWorldLeak(playerid);
	return 1;
}

stock TryEnterBusinessFromPickup(playerid, action_id)
{
	if(action_id < 0 || action_id >= g_business_loaded)
		return 0;

	new cur = GetPlayerInBiz(playerid);
	if(cur == action_id)
	{
		if(!Biz_IsPlayerInside(playerid, action_id))
			EnterPlayerToBiz(playerid, action_id);
		return 1;
	}
	if(cur != -1)
		ExitPlayerFromBiz(playerid);

	if(GetBusinessData(action_id, B_TYPE) == BUSINESS_TYPE_CAR_TUNING || GetBusinessData(action_id, B_TYPE) == BUSINESS_TYPE_CAR_MARKET)
	{
		SendClientMessage(playerid, 0xCECECEFF, "˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜.");
		return 1;
	}

	new i_paid_biz = GetPlayerUseListitem(playerid);

	if(IsBusinessOwned(action_id))
	{
		if(GetBusinessData(action_id, B_OWNER_ID) != Player[playerid][pID])
		{
			if(GetBusinessData(action_id, B_LOCK_STATUS))
				return GameTextForPlayer(playerid, "~w~business~n~~r~closed", 4000, 1);

			if(GetBusinessData(action_id, B_ENTER_PRICE) > 0 && i_paid_biz != action_id)
			{
				new fmt_str[128];
				SetPVarInt(playerid, "biz_enter", action_id + 1);
				format(fmt_str, sizeof fmt_str,
					"{FFFFFF}˜˜˜˜ ˜˜˜˜˜˜˜: {FF9900}%d ˜˜˜\n{99FF00}˜˜˜˜˜?",
					GetBusinessData(action_id, B_ENTER_PRICE));
				ShowPlayerDialog(playerid, DIALOG_BIZ_ENTER, DIALOG_STYLE_MSGBOX,
					GetBusinessData(action_id, B_NAME), fmt_str, "˜˜", "˜˜˜");
				return 1;
			}
		}
	}
	if(Shop_TryEnterBusiness(playerid, action_id)) return 1;
	EnterPlayerToBiz(playerid, action_id);
	return 1;
}

stock bool:LairdBiz_OnPickup(playerid, pickupid)
{
	if(Snack_OnPickup(playerid, pickupid)) return true;
	if(GetPVarInt(playerid, "PickupDelay") > gettime()) return false;

	for(new i; i < g_business_loaded; i++)
	{
		if(!IsBusinessSlotUsable(i)) continue;
		if(pickupid == GetBusinessData(i, B_ENTER_PICKUP))
		{
			SetPVarInt(playerid, "PickupDelay", gettime() + 2);
			TryEnterBusinessFromPickup(playerid, i);
			return true;
		}
		if(pickupid == GetBusinessData(i, B_HEALTH_PICKUP))
		{
			SetPVarInt(playerid, "PickupDelay", gettime() + 2);
			new businessid = GetPlayerInBiz(playerid);
			if(businessid == i)
			{
				new tim = gettime();
				if(GetPVarInt(playerid, "biz_health_use") <= tim)
				{
					new price = BIZ_HEALTH_SERVICE_PRICE;
					if(GetPlayerMoneyEx(playerid) >= price)
					{
						GivePlayerMoneyEx(playerid, -price);
						if(GetBusinessData(businessid, B_PRODS) >= 1)
						{
							AddBusinessData(businessid, B_PRODS, -, 1);
							AddBusinessData(businessid, B_BALANCE, +, price);
						}
						SetPlayerHealth(playerid, 99.0);
						SetPVarInt(playerid, "biz_health_use", tim + 300);
						Biz_LogProfit(GetBusinessData(businessid, B_SQL_ID), playerid, price, _:IsBusinessOwned(businessid));
						Biz_SaveBusinessRow(businessid);
						SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜.");
					}
					else SendClientMessage(playerid, 0x999999FF, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ 150 ˜˜˜.");
				}
				else SendClientMessage(playerid, 0x999999FF, "˜˜˜˜˜˜˜ ˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");
			}
			return true;
		}
	}

	for(new idx; idx < sizeof g_bi_exit_pickup; idx++)
	{
		if(pickupid == g_bi_exit_pickup[idx])
		{
			SetPVarInt(playerid, "PickupDelay", gettime() + 2);
			new in_biz = GetPlayerInBiz(playerid);
			if(in_biz != -1 && GetBusinessData(in_biz, B_INTERIOR) == idx)
			{
				ExitPlayerFromBiz(playerid);
			}
			return true;
		}
	}

	if(pickupid == g_bi_shopgun_pickup)
	{
		SetPVarInt(playerid, "PickupDelay", gettime() + 1);
		new businessid = GetPlayerInBiz(playerid);
		if(businessid != -1 && GetBusinessData(businessid, B_TYPE) == BUSINESS_TYPE_SHOP_GUN)
		{
			ShowPlayerDialog(playerid, DIALOG_BIZ_SHOP_GUN, DIALOG_STYLE_LIST, CAR_DLG_PREFIX "˜˜˜˜˜˜",
				BR_SHOP_LIST_GUN,
				"˜˜˜˜˜˜", "˜˜˜˜˜˜");
		}
		return true;
	}
	if(pickupid == g_bi_cartun_pickup)
	{
		SetPVarInt(playerid, "PickupDelay", gettime() + 1);
		SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜-˜˜˜˜˜: ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜.");
		return true;
	}
	return false;
}

stock bool:LairdBiz_OnEnterCP(playerid, cpid)
{
	if(cpid == GetBusinessInteriorInfo(BUSINESS_INTERIOR_CLUB, BT_BUY_CHECK_ID))
	{
		new businessid = GetPlayerInBiz(playerid);
		if(businessid != -1 && GetBusinessData(businessid, B_TYPE) == BUSINESS_TYPE_CLUB)
		{
			ShowPlayerDialog(playerid, DIALOG_BIZ_CLUB, DIALOG_STYLE_LIST, CAR_DLG_PREFIX "˜˜˜",
				BR_SHOP_LIST_CLUB,
				"˜˜˜˜˜˜", "˜˜˜˜˜˜");
		}
		return true;
	}
	if(cpid == GetBusinessInteriorInfo(BUSINESS_INTERIOR_CASINO, BT_BUY_CHECK_ID))
	{
		new businessid = GetPlayerInBiz(playerid);
		if(businessid != -1 && GetBusinessData(businessid, B_TYPE) == BUSINESS_TYPE_CASINO)
		{
			ShowPlayerDialog(playerid, DIALOG_BIZ_CLUB, DIALOG_STYLE_LIST, CAR_DLG_PREFIX "˜˜˜˜˜˜",
				BR_SHOP_LIST_CLUB,
				"˜˜˜˜˜˜", "˜˜˜˜˜˜");
		}
		return true;
	}
	return false;
}

stock ShowBizOwnerParamsList(playerid)
{
	new biz_params_list[384];
	biz_params_list[0] = '\0';
	strcat(biz_params_list, CAR_CLR_WHITE "1. ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜\n");
	strcat(biz_params_list, CAR_CLR_WHITE "2. ˜˜˜˜˜ ˜˜ ˜˜˜˜\n");
	strcat(biz_params_list, CAR_CLR_WHITE "3. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\n");
	strcat(biz_params_list, CAR_CLR_WHITE "4. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜\n");
	strcat(biz_params_list, CAR_CLR_WHITE "5. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜\n");
	strcat(biz_params_list, CAR_CLR_WHITE "6. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜\n");
	strcat(biz_params_list, CAR_CLR_WHITE "7. ˜˜˜˜˜˜˜˜˜");
	ShowPlayerDialog(playerid, DIALOG_BIZ_PARAMS, DIALOG_STYLE_LIST, CAR_DLG_PREFIX "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜",
		biz_params_list, "˜˜˜˜˜˜˜", "˜˜˜˜˜");
}

stock ShowPlayerBusinessDialog(playerid, operationid)
{
	new businessid = GetPlayerBusiness(playerid);
	if(businessid == -1) return 0;

	switch(operationid)
	{
		case BIZ_OPERATION_PARAMS:
		{
			ShowBizOwnerParamsList(playerid);
		}
		case BIZ_OPERATION_LOCK:
		{
			if(GetBusinessData(businessid, B_LOCK_STATUS))
			{
				SetBusinessData(businessid, B_LOCK_STATUS, false);
				SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜˜ ˜˜˜˜˜˜.");
			}
			else
			{
				SetBusinessData(businessid, B_LOCK_STATUS, true);
				SendClientMessage(playerid, 0xFF6600FF, "˜˜˜˜˜˜ ˜˜˜˜˜˜.");
			}
			UpdateBusinessLabel(businessid);
			new q[96];
			mysql_format(db_handle, q, sizeof q, "UPDATE business SET `lock`=%d WHERE id=%d LIMIT 1",
				_:GetBusinessData(businessid, B_LOCK_STATUS), GetBusinessData(businessid, B_SQL_ID));
			mysql_tquery(db_handle, q, "", "");
			ShowBizOwnerParamsList(playerid);
		}
		case BIZ_OPERATION_ENTER_PRICE:
		{
			ShowPlayerDialog(playerid, DIALOG_BIZ_ENTER_PRICE, DIALOG_STYLE_INPUT, "{33AACC}˜˜˜˜˜ ˜˜ ˜˜˜˜",
				"{FFFFFF}˜˜ 0 ˜˜ 5000 ˜˜˜.", "˜˜˜˜˜˜˜", "˜˜˜˜˜");
		}
		case BIZ_OPERATION_PROD_PRICE:
		{
			ShowPlayerDialog(playerid, DIALOG_BIZ_PROD_PRICE, DIALOG_STYLE_INPUT, "{33AACC}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜",
				"{FFFFFF}˜˜ 25 ˜˜ 200 ˜˜˜.", "˜˜˜˜˜˜˜", "˜˜˜˜˜");
		}
		case BIZ_OPERATION_PROD_ORDER:
		{
			ShowPlayerDialog(playerid, DIALOG_BIZ_ORDER_PRODS, DIALOG_STYLE_INPUT, "{33AACC}˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜",
				"{FFFFFF}˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜? (˜˜˜˜˜˜˜ ˜˜ 35 ˜˜˜/˜˜.)", "˜˜˜˜˜˜˜˜", "˜˜˜˜˜");
		}
		case BIZ_OPERATION_PROD_ORDER_CANCEL:
		{
			SendClientMessage(playerid, 0xFF6600FF, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ (˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜).");
			ShowBizOwnerParamsList(playerid);
		}
		case BIZ_OPERATION_PROFIT_STATS:
		{
			new time = gettime(), cur_day = time - (time % 86400), start_day = cur_day - (86400 * 20);
			new q[280];
			mysql_format(db_handle, q, sizeof q,
				"SELECT FROM_UNIXTIME(time, '%%Y-%%m-%%d') AS d, SUM(money) AS total FROM business_profit WHERE bid=%d AND view=1 AND time >= %d AND time < %d GROUP BY FROM_UNIXTIME(time, '%%Y-%%m-%%d') ORDER BY d DESC LIMIT 20",
				GetBusinessData(businessid, B_SQL_ID), start_day, cur_day);
			g_biz_mysql_race[playerid]++;
			mysql_tquery(db_handle, q, "ShowBusinessProfit", "ii", playerid, g_biz_mysql_race[playerid]);
		}
		case BIZ_OPERATION_IMPROVEMENTS:
		{
			if(IsBusinessNoUpgrade(businessid))
				return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜."), 0;

			new string[512], line[112], i_level = GetBusinessData(businessid, B_IMPROVEMENTS);
			string[0] = '\0';
			for(new idx; idx < sizeof g_business_improvements; idx++)
			{
				if(i_level > idx)
				{
					format(line, sizeof line, "%d. {2277AA}%s ˜ ˜˜˜˜˜˜˜\n", idx + 1, g_business_improvements[idx][I_NAME]);
				}
				else if(i_level < idx)
				{
					format(line, sizeof line, "%d. {CC3344}%s ˜ %d ˜˜˜\n", idx + 1, g_business_improvements[idx][I_NAME], g_business_improvements[idx][I_PRICE]);
				}
				else
				{
					format(line, sizeof line, "%d. {66CC33}%s ˜ %d ˜˜˜ (˜˜˜˜. ˜˜˜˜˜˜˜)\n", idx + 1, g_business_improvements[idx][I_NAME], g_business_improvements[idx][I_PRICE]);
				}
				strcat(string, line);
			}
			ShowPlayerDialog(playerid, DIALOG_BIZ_IMPROVEMENT, DIALOG_STYLE_LIST, "{33AADD}˜˜˜˜˜˜˜˜˜", string, "˜˜˜˜˜˜", "˜˜˜˜˜");
		}
	}
	return 1;
}

public ShowBusinessProfit(playerid, raceid)
{
	if(!IsPlayerConnected(playerid)) return 1;
	if(raceid != g_biz_mysql_race[playerid]) return 1;

	new rows, fields, msg[640];
	cache_get_data(rows, fields, db_handle);
	if(rows)
	{
		format(msg, sizeof msg, "˜˜˜˜\t\t˜˜˜˜˜˜˜\n\n{FFFFFF}");
		new daystr[16], total, line[48];
		for(new idx; idx < rows; idx++)
		{
			cache_get_field_content(idx, "d", daystr, db_handle, sizeof daystr);
			total = cache_get_field_content_int(idx, "total", db_handle);
			format(line, sizeof line, "%s\t\t%d ˜˜˜\n", daystr, total);
			strcat(msg, line);
		}
		ShowPlayerDialog(playerid, DIALOG_BIZ_PROFIT_VIEW, DIALOG_STYLE_MSGBOX, "{33AADD}˜˜˜˜˜ (20 ˜˜˜˜)", msg, "<< ˜˜˜˜˜", "˜˜˜˜˜˜˜");
	}
	else
	{
		ShowPlayerDialog(playerid, DIALOG_BIZ_PROFIT_VIEW, DIALOG_STYLE_MSGBOX, "{33AADD}˜˜˜˜˜ (20 ˜˜˜˜)",
			"{FFFFFF}˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜.", "<< ˜˜˜˜˜", "˜˜˜˜˜˜˜");
	}
	return 1;
}

stock BuyPlayerBusiness(playerid, businessid, bool:buy_from_owner = false, price = -1)
{
	if(IsBusinessOwned(businessid)) return -1;
	if(GetPlayerBusiness(playerid) != -1) return -1;
	if(price <= 0) price = GetBusinessData(businessid, B_PRICE);
	if(GetPlayerMoneyEx(playerid) < price) return 0;

	GivePlayerMoneyEx(playerid, -price);

	SetBusinessData(businessid, B_OWNER_ID, Player[playerid][pID]);
	SetBusinessData(businessid, B_IMPROVEMENTS, 0);

	new tim = gettime(), rent_time = (tim - (tim % 86400)) + 86400;
	if(!buy_from_owner)
	{
		SetBusinessData(businessid, B_PRODS, 20);
		SetBusinessData(businessid, B_PROD_PRICE, 0);
		SetBusinessData(businessid, B_ENTER_MUSIC, 0);
		SetBusinessData(businessid, B_ENTER_PRICE, 0);
		SetBusinessData(businessid, B_BALANCE, 0);
		SetBusinessData(businessid, B_RENT_DATE, rent_time);
		SetBusinessData(businessid, B_LOCK_STATUS, false);
		SetBusinessData(businessid, B_EVICTION, 0);
	}
	else
	{
		if(GetElapsedTime(GetBusinessData(businessid, B_RENT_DATE), tim, CONVERT_TIME_TO_DAYS) <= 0)
			SetBusinessData(businessid, B_RENT_DATE, rent_time);
		SetBusinessData(businessid, B_EVICTION, 0);
	}

	format(GetBusinessData(businessid, B_OWNER_NAME), BIZ_OWNER_NAME_LEN, "%s", Player[playerid][pName]);
	Player[playerid][pBusiness] = businessid;
	SavePlayerAccount(playerid);

	new q[400];
	mysql_format(db_handle, q, sizeof q,
		"UPDATE business SET owner_id=%d,improvements=%d,products=%d,prod_price=%d,balance=%d,rent_time=%d,`lock`=%d,eviction=0 WHERE id=%d LIMIT 1",
		Player[playerid][pID],
		GetBusinessData(businessid, B_IMPROVEMENTS),
		GetBusinessData(businessid, B_PRODS),
		GetBusinessData(businessid, B_PROD_PRICE),
		GetBusinessData(businessid, B_BALANCE),
		GetBusinessData(businessid, B_RENT_DATE),
		_:GetBusinessData(businessid, B_LOCK_STATUS),
		GetBusinessData(businessid, B_SQL_ID));
	mysql_tquery(db_handle, q, "", "");

	mysql_format(db_handle, q, sizeof q, "UPDATE business_profit SET view=0 WHERE bid=%d AND view=1", GetBusinessData(businessid, B_SQL_ID));
	mysql_tquery(db_handle, q, "", "");

	mysql_format(db_handle, q, sizeof q, "UPDATE players SET business=%d WHERE id=%d LIMIT 1", businessid, Player[playerid][pID]);
	mysql_tquery(db_handle, q, "", "");

	UpdateBusinessLabel(businessid);
	BusinessHealthPickupInit(businessid);
	SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜: /business");
	return 1;
}

stock SellBusiness(playerid)
{
	new businessid = GetPlayerBusiness(playerid);
	if(businessid == -1) return 0;

	new biz_price = GetBusinessData(businessid, B_PRICE);
	new biz_percent = (biz_price * 30) / 100;
	new biz_imp = BusinessImprovementsPrice(businessid);
	if(biz_imp) biz_imp = (biz_imp * 60) / 100;
	new return_money = (biz_price - biz_percent) + biz_imp;

	SetBusinessData(businessid, B_OWNER_ID, 0);
	SetBusinessData(businessid, B_IMPROVEMENTS, 0);
	SetBusinessData(businessid, B_PRODS, 0);
	SetBusinessData(businessid, B_PROD_PRICE, 0);
	SetBusinessData(businessid, B_BALANCE, 0);
	SetBusinessData(businessid, B_RENT_DATE, 0);
	SetBusinessData(businessid, B_ENTER_MUSIC, 0);
	SetBusinessData(businessid, B_LOCK_STATUS, false);
	SetBusinessData(businessid, B_EVICTION, 0);
	format(GetBusinessData(businessid, B_OWNER_NAME), BIZ_OWNER_NAME_LEN, "None");

	Player[playerid][pBusiness] = -1;
	GivePlayerMoneyEx(playerid, return_money);
	SavePlayerAccount(playerid);

	new q[400];
	mysql_format(db_handle, q, sizeof q,
		"UPDATE business SET owner_id=0,improvements=0,products=0,prod_price=0,balance=0,rent_time=0,enter_music=0,`lock`=0,eviction=0 WHERE id=%d LIMIT 1",
		GetBusinessData(businessid, B_SQL_ID));
	mysql_tquery(db_handle, q, "", "");

	mysql_format(db_handle, q, sizeof q, "UPDATE players SET business=-1 WHERE id=%d LIMIT 1", Player[playerid][pID]);
	mysql_tquery(db_handle, q, "", "");

	BusinessHealthPickupInit(businessid);
	UpdateBusinessLabel(businessid);

	new msg[144];
	SendClientMessage(playerid, 0x66CC00FF, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜.");
	format(msg, sizeof msg, "˜˜˜˜˜ 30%% ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜: %d ˜˜˜.", biz_percent);
	SendClientMessage(playerid, 0xCECECEFF, msg);
	if(biz_imp > 0)
	{
		format(msg, sizeof msg, "˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ (60%%): %d ˜˜˜.", biz_imp);
		SendClientMessage(playerid, 0xCECECEFF, msg);
	}
	format(msg, sizeof msg, "˜˜˜˜˜ ˜˜˜˜˜˜˜˜: %d ˜˜˜.", return_money);
	SendClientMessage(playerid, 0xFFFFFFFF, msg);
	return 1;
}

stock bool:LairdBiz_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if(Snack_HandleDialog(playerid, dialogid, response, listitem, inputtext))
		return true;

	switch(dialogid)
	{
		case DIALOG_BIZ_TP_LIST:
		{
			if(!response) return true;
			if(!(0 <= listitem < g_biz_tp_count[playerid])) return true;

			new biz_id = g_biz_tp_list[playerid][listitem];
			if(biz_id < 0 || biz_id >= g_business_loaded)
				return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜."), true;

			Business_AdminTeleport(playerid, biz_id);
			new bname[64], msg[180];
			GetAddBizNameByType(GetBusinessData(biz_id, B_TYPE), bname, sizeof bname);
			format(msg, sizeof msg, "{66CC33}˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜: %s (ID: %d).", bname, biz_id + 1);
			SendClientMessage(playerid, -1, msg);
			return true;
		}
		case DIALOG_BIZ_TP_ID:
		{
			if(!response) return true;
			if(!strlen(inputtext) || !IsNumeric(inputtext))
			{
				ShowPlayerDialog(playerid, DIALOG_BIZ_TP_ID, DIALOG_STYLE_INPUT,
					"{FFCD00}˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜",
					"˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜?\n\n˜˜˜˜˜˜˜ ID ˜˜˜˜˜˜˜:",
					"˜˜", "˜˜˜");
				return true;
			}

			new biz_id = strval(inputtext);
			if(biz_id < 1)
			{
				SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜˜ ID ˜˜˜˜˜˜˜ ˜˜ 1.");
				return true;
			}
			biz_id--;

			if(biz_id < 0 || biz_id >= g_business_loaded)
			{
