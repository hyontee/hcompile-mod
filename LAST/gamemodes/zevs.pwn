stock SpawnCont(contid)
{
    if(contid < 1 || contid > MAX_CONT) return printf("ERROR: Invalid container ID in SpawnCont: %d", contid);
    new prize_region, prize_id, prize_price;
    new prize_name[64];
    new random_prize_index;
    
    new random_prize_type = random(2) + 1;
    if (random_prize_type == 1)
    {
        random_prize_index = GetWeightedRandomPrize(cSkin_Info, sizeof(cSkin_Info));
        prize_region = cSkin_Info[random_prize_index][PRIZE_REGION];
        prize_id = cSkin_Info[random_prize_index][PRIZE_ID];
        format(prize_name, sizeof(prize_name), "%s", cSkin_Info[random_prize_index][PRIZE_NAME]);
        prize_price = cSkin_Info[random_prize_index][PRIZE_PRICE];
    }
    else
    {
        random_prize_index = GetWeightedRandomPrize(cCar_Info, sizeof(cCar_Info));
        prize_region = cCar_Info[random_prize_index][PRIZE_REGION];
        prize_id = cCar_Info[random_prize_index][PRIZE_ID];
        format(prize_name, sizeof(prize_name), "%s", cCar_Info[random_prize_index][PRIZE_NAME]);
        prize_price = cCar_Info[random_prize_index][PRIZE_PRICE];
    }
    
    cInfo[contid][ContRegion] = prize_region;
    cInfo[contid][ItemType] = random_prize_type;
    cInfo[contid][Item] = prize_id;
    cInfo[contid][ItemPrice] = prize_price;
    
    new initial_price = 0;
    if (cInfo[contid][ItemType] == 1)
    {
        initial_price = g_RegionData[cInfo[contid][ContRegion]][ClothesPrice];
    }
    else
    {
        initial_price = g_RegionData[cInfo[contid][ContRegion]][VehiclePrice];
    }
    
    cInfo[contid][ContPrice] = initial_price;
    cInfo[contid][BetPrice] = initial_price;
    
    new Float:x, Float:y, Float:z, Float:rot;
    new Float:door1X, Float:door1Y, Float:door1Z, Float:door1A;
    new Float:door2X, Float:door2Y, Float:door2Z, Float:door2A;
    
    x = cContsPos[contid-1][0];
    y = cContsPos[contid-1][1];
    z = cContsPos[contid-1][2];
    rot = cContsPos[contid-1][3];
    
    door1X = cContsPos[contid-1][4];
    door1Y = cContsPos[contid-1][5];
    door1Z = cContsPos[contid-1][6];
    door1A = cContsPos[contid-1][7];
    
    door2X = cContsPos[contid-1][8];
    door2Y = cContsPos[contid-1][9];
    door2Z = cContsPos[contid-1][10];
    door2A = cContsPos[contid-1][11];
    
    new object_model = g_RegionData[cInfo[contid][ContRegion]][ContModelId];
    new vorota_model = g_RegionData[cInfo[contid][ContRegion]][VorotaModelId];

    cInfo[contid][ContObjectId] = CreateObject(object_model, x, y, z, 0.0, 0.0, rot);
    cInfo[contid][ContObjectDoorLId] = CreateObject(vorota_model, door1X, door1Y, door1Z, 0.0, 0.0, door1A);
    cInfo[contid][ContObjectDoorRId] = CreateObject(vorota_model, door2X, door2Y, door2Z, 0.0, 0.0, door2A);

    cInfo[contid][ContZoneId] = CreateDynamicSphere(ContBuyTextPos[contid-1][0], ContBuyTextPos[contid-1][1], ContBuyTextPos[contid-1][2], 2.0);

    new moneystr[15];
    ConvertMoney(cInfo[contid][ContPrice], moneystr);

    TextDrawSetString(cont_name[contid], prize_name);
    
    cInfo[contid][Saled] = true;
    cInfo[contid][BetedId] = INVALID_PLAYER_ID;

    new strwerton[256];
    format(strwerton, sizeof strwerton, "{993333}˜˜˜˜˜˜˜˜˜ #%d\n\n˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜: {FFFFFF}˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s ˜˜˜˜˜˜", contid, g_RegionData[cInfo[contid][ContRegion]][RegionName], (cInfo[contid][ItemType] == 1) ? ("˜˜˜˜˜˜") : ("˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜"), moneystr);
    
    if (_:ContsText[contid] == _:INVALID_3DTEXT_ID)
    {
        ContsText[contid] = CreateDynamic3DTextLabel(strwerton, -1, ContBuyTextPos[contid-1][0], ContBuyTextPos[contid-1][1], ContBuyTextPos[contid-1][2], 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, false, contid);
    }
    else
    {
        UpdateDynamic3DTextLabelText(ContsText[contid], CLR_RED, strwerton);
    }

    return 1;
}

public TimerSecondUpdateCont(contid)
{
    if(cInfo[contid][SaleTime] > 0)
    {
        cInfo[contid][SaleTime]--;

        cInfo[contid][Saled] = true;
        
        new moneystr[15], betstr[15], startstr[15];
        ConvertMoney(cInfo[contid][ContPrice], startstr);
        ConvertMoney(cInfo[contid][BetPrice], betstr);
        ConvertMoney(cInfo[contid][ContPrice], moneystr);
        
        new strwerton[512];
        if (cInfo[contid][BetedId] != INVALID_PLAYER_ID) {
            format(strwerton, sizeof strwerton, "{993333}˜˜˜˜˜˜˜˜˜ #%d\n\n˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜: {FFFFFF}˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s ˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s ˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜: {FFFFFF}%s\n{993333}˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜: {FFFFFF}%d ˜˜˜˜˜˜", contid, g_RegionData[cInfo[contid][ContRegion]][RegionName], (cInfo[contid][ItemType] == 1) ? ("˜˜˜˜˜˜") : ("˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜"), betstr, startstr, cInfo[contid][BetedName], cInfo[contid][SaleTime]);
        }
        else
        {
            format(strwerton, sizeof strwerton, "{993333}˜˜˜˜˜˜˜˜˜ #%d\n\n˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜: {FFFFFF}˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s ˜˜˜˜˜˜", contid, g_RegionData[cInfo[contid][ContRegion]][RegionName], (cInfo[contid][ItemType] == 1) ? ("˜˜˜˜˜˜") : ("˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜"), moneystr);
        }
        UpdateDynamic3DTextLabelText(ContsText[contid], CLR_RED, strwerton);
    }
    else
    {
        KillTimer(ContsTimer[contid]);
        ContsTimer[contid] = 0;
        cInfo[contid][Saled] = false;
        
        if (cInfo[contid][BetedId] != INVALID_PLAYER_ID)
        {
            new winnerid = cInfo[contid][BetedId];
            c_pContInfo[winnerid][BetContCount]--;

            new winner_name[MAX_PLAYER_NAME];
            GetPlayerName(winnerid, winner_name, sizeof(winner_name));

            new Float:door1X = cContsPos[contid-1][4];
            new Float:door1Y = cContsPos[contid-1][5];
            new Float:door1Z = cContsPos[contid-1][6];
            new Float:door1A = cContsPos[contid-1][7];
            
            new Float:door2X = cContsPos[contid-1][8];
            new Float:door2Y = cContsPos[contid-1][9];
            new Float:door2Z = cContsPos[contid-1][10];
            new Float:door2A = cContsPos[contid-1][11];
            
            if(cInfo[contid][ItemType] == 2)
            {
                new colors[] = {1, 10, 22, 53, 50};
                cInfo[contid][ContVehicleColor] = colors[random(sizeof(colors))];
                TextDrawSetPreviewVehCol(cont_model[contid], cInfo[contid][ContVehicleColor], 1);
        
                new Float:contX = cContsPos[contid-1][0];
                new Float:contY = cContsPos[contid-1][1];
                new Float:contZ = cContsPos[contid-1][2];
                new Float:contRot = cContsPos[contid-1][3];
    
                new Float:vehicleRot = contRot + 180.0;
                if(vehicleRot >= 360.0) vehicleRot -= 360.0;
                
                cInfo[contid][ContVehicleId] = CreateVehicle(cInfo[contid][Item], contX, contY, contZ, vehicleRot, cInfo[contid][ContVehicleColor], 1, 0);
                SetVehicleParamsEx(cInfo[contid][ContVehicleId], false, false, false, true, false, false, false);
                ChangeVehicleColor(cInfo[contid][ContVehicleId], cInfo[contid][ContVehicleColor], 0);
            }
            else
            {
                new Float:contX = cContsPos[contid-1][0];
                new Float:contY = cContsPos[contid-1][1];
                new Float:contZ = cContsPos[contid-1][2] + 1.5;
                new Float:contRot = cContsPos[contid-1][3];
                new Float:clothingRot = contRot + 90.0;
                if(clothingRot >= 360.0) clothingRot -= 360.0;
                cInfo[contid][ContObjectOdejdaId] = CreateObject(959, contX, contY, contZ, 0.0, 0.0, clothingRot);
            }
            
            new str_win[270];
            new balansestr[15];
            ConvertMoney(cInfo[contid][BetPrice], balansestr);
            format(str_win, sizeof(str_win), "| {ffffff}˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜{ffff00} #%d{ffffff}!", contid);
            SendClientMessage(winnerid, CLR_YELLOW, str_win);
            if(IsPlayerConnected(winnerid))
            {
                ShowNotification(winnerid, 4, 10, NOTIFY_CONT_CLAIM, 0, "˜˜˜˜˜˜˜ ˜˜˜˜", ">>");
            }
            
            new moneystr[15];
            ConvertMoney(cInfo[contid][BetPrice], moneystr);
            new strwerton[400];
            format(strwerton, sizeof(strwerton), "{993333}˜˜˜˜˜˜˜˜˜ #%d\n\n˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜: {FFFFFF}˜˜˜˜˜ ˜˜˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s ˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s", contid, g_RegionData[cInfo[contid][ContRegion]][RegionName], (cInfo[contid][ItemType] == 1) ? ("˜˜˜˜˜˜") : ("˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜"), moneystr, winner_name);
            UpdateDynamic3DTextLabelText(ContsText[contid], CLR_GREEN, strwerton);

            MoveObject(cInfo[contid][ContObjectDoorLId], door1X, door1Y, door1Z, 8.5, 0, 0, door1A + 128.0);
            MoveObject(cInfo[contid][ContObjectDoorRId], door2X, door2Y, door2Z, 8.5, 0, 0, door2A - 128.0);
        }
        else
        {
            new moneystr[15];
            ConvertMoney(cInfo[contid][ContPrice], moneystr);
            new strwerton[256];
            format(strwerton, sizeof strwerton, "{993333}˜˜˜˜˜˜˜˜˜ #%d\n\n˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜: {FFFFFF}˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s ˜˜˜˜˜˜", contid, g_RegionData[cInfo[contid][ContRegion]][RegionName], (cInfo[contid][ItemType] == 1) ? ("˜˜˜˜˜˜") : ("˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜"), moneystr);
            UpdateDynamic3DTextLabelText(ContsText[contid], CLR_YELLOW, strwerton);

            if(cInfo[contid][ContZoneId] != -1)
            {
                DestroyDynamicArea(cInfo[contid][ContZoneId]);
                cInfo[contid][ContZoneId] = -1;
            }

            DestroyObject(cInfo[contid][ContObjectId]);
            DestroyObject(cInfo[contid][ContObjectDoorLId]);
            DestroyObject(cInfo[contid][ContObjectDoorRId]);
            DestroyObject(cInfo[contid][ContObjectOdejdaId]);
            DestroyVehicle(cInfo[contid][ContVehicleId]);
            
            SpawnCont(contid);
        }
    }
    return 1;
}

stock ResetContInfo(contid)
{
    if(cInfo[contid][ContZoneId] != -1)
    {
        DestroyDynamicArea(cInfo[contid][ContZoneId]);
        cInfo[contid][ContZoneId] = -1;
    }

    DestroyObject(cInfo[contid][ContObjectId]);
    DestroyObject(cInfo[contid][ContObjectDoorLId]);
    DestroyObject(cInfo[contid][ContObjectDoorRId]);
    DestroyObject(cInfo[contid][ContObjectOdejdaId]);
    DestroyObject(cInfo[contid][ContObjectDoorLId]);
    DestroyObject(cInfo[contid][ContObjectDoorRId]);
    DestroyObject(cInfo[contid][ContObjectOdejdaId]);
    DestroyVehicle(cInfo[contid][ContVehicleId]);
    KillTimer(ContsTimer[contid]);
    UpdateDynamic3DTextLabelText(ContsText[contid], CLR_RED, "");
    
    cInfo[contid][ContObjectId] = 0;
    cInfo[contid][ContObjectDoorLId] = 0;
    cInfo[contid][ContObjectDoorRId] = 0;
    cInfo[contid][ContObjectOdejdaId] = 0;
    cInfo[contid][ContVehicleId] = 0;
    cInfo[contid][ContVehicleColor] = 0;
    cInfo[contid][ContRegion] = 0;
    cInfo[contid][ItemType] = 0;
    cInfo[contid][Item] = 0;
    cInfo[contid][ContPrice] = 0;
    cInfo[contid][ItemPrice] = 0;
    cInfo[contid][Saled] = false;
    cInfo[contid][SaleTime] = 0;
    cInfo[contid][BetPrice] = 0;
    cInfo[contid][BetedId] = INVALID_PLAYER_ID;
    cInfo[contid][Saled] = false;
    cInfo[contid][ContZoneId] = -1;
    return 1;
}

stock Cont_RemoveSkinFromInv(playerid, skinid)
{
    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        if(PlayerInventory[playerid][i][invItem] == 134 && PlayerInventory[playerid][i][invValue] == skinid)
        {
            if(PlayerInventory[playerid][i][invID] > 0)
            {
                new q[96];
                mysql_format(db_handle, q, sizeof(q), "DELETE FROM `inventory` WHERE `id` = %d", PlayerInventory[playerid][i][invID]);
                mysql_tquery(db_handle, q);
            }
            PlayerInventory[playerid][i][invID] = 0;
            PlayerInventory[playerid][i][invItem] = 0;
            PlayerInventory[playerid][i][invCount] = 0;
            PlayerInventory[playerid][i][invValue] = 0;
            return true;
        }
    }
    return false;
}

public CorrectTimerMinute()
{
    new hour, minute, second;
    gettime(hour, minute, second);
    if(hour >= 8 && hour < 23 && minute == 25)
    { 
        SendClientMessageToAll(0xFF5533FF, "{ffff00}[˜˜˜˜˜˜˜˜˜˜] {ffffff}˜˜˜˜˜ {ffff00}10{ffffff} ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜!");
        SendClientMessageToAll(0xFF5533FF, "{ffff00}[˜˜˜˜˜˜˜˜˜˜] {ffffff}˜˜˜˜˜˜˜˜˜˜˜˜˜˜: {ffff00}/gps - ˜˜˜˜˜˜˜˜˜˜˜ > ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜");
        return 1;
    }
    else if(hour >= 8 && hour < 23 && minute == 30)
    {
        for(new cont = 1; cont <= MAX_CONT; cont++)
        {
            if(cInfo[cont][Saled] == false)
            {
                SpawnCont(cont);
            }
        }
    }
    else if(hour >= 8 && hour < 23 && minute == 40)
    {
        SendClientMessageToAll(0xFF5533FF, "{ffff00}[˜˜˜˜˜˜˜˜˜˜] {ffffff}˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜");
        StopCont();
    }
    return 1;
}

stock Conts_OnPlayerEnterArea(playerid, areaid)
{
    for(new cont = 1; cont <= MAX_CONT; cont++)
    {
        if(cInfo[cont][ContZoneId] != -1 && areaid == cInfo[cont][ContZoneId])
        {
            if(cInfo[cont][Saled])
            {
                ShowNotification(playerid, 4, 6, NOTIFY_CONT_BET, 0, "˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜ ˜˜˜˜˜˜", ">>");
            }
            else if(cInfo[cont][BetedId] == playerid)
            {
                ShowNotification(playerid, 4, 8, NOTIFY_CONT_CLAIM, 0, "˜˜˜˜˜˜˜ ˜˜˜˜", ">>");
            }
            break;
        }
    }
    return 1;
}

stock Conts_GetPlayerNearCont(playerid)
{
    for(new cont = 1; cont <= MAX_CONT; cont++)
    {
        if(cInfo[cont][ContZoneId] != -1 && IsPlayerInDynamicArea(playerid, cInfo[cont][ContZoneId]))
            return cont;
    }
    return 0;
}

CMD:conts(playerid)
{
    new cont_id = Conts_GetPlayerNearCont(playerid);
    if(!cont_id)
    {
        SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜!");
        return 1;
    }
    if(cInfo[cont_id][Saled] != true)
    {
        SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜ /cont ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.");
        return 1;
    }
    if(cInfo[cont_id][BetedId] == playerid)
    {
        SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜, ˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜");
        return 1;
    }
    new strwerton[140], betstr[15];
    ConvertMoney(cInfo[cont_id][BetPrice], betstr);
    format(strwerton, sizeof strwerton, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: %s ˜˜˜˜˜˜\n\n˜˜˜ ˜˜˜˜, ˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜\n˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜:", betstr);
    ShowPlayerDialog(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, "{FF6347}"PROJECT_NAME_CONT" {ffffff}| ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜", strwerton, "˜˜˜˜˜˜", "˜˜˜˜˜˜");
    SetPVarInt(playerid, "CurrentCont", cont_id);
    return 1;
}

CMD:cont(playerid)
{
    new cont_id = Conts_GetPlayerNearCont(playerid);
    if(!cont_id)
    {
        SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜!");
        return 1;
    }
    if(cInfo[cont_id][Saled] == true)
    {
        SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜˜˜ ˜˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜ /conts ˜˜˜ ˜˜˜˜˜˜.");
        return 1;
    }
    if(cInfo[cont_id][BetedId] == playerid)
    {
            new prize_name[64];
            new prize_price_string[32];
            new prize_modelid = cInfo[cont_id][Item];
            
            if (cInfo[cont_id][ItemType] == 1)
            {
                for(new i = 0; i < sizeof(cSkin_Info); i++)
                {
                    if (cSkin_Info[i][PRIZE_ID] == prize_modelid)
                    {
                        format(prize_name, sizeof(prize_name), "%s", cSkin_Info[i][PRIZE_NAME]);
                        break;
                    }
                }
                TextDrawSetPreviewModel(cont_model[cont_id], prize_modelid);
            }
            else if (cInfo[cont_id][ItemType] == 2)
            {
                for(new i = 0; i < sizeof(cCar_Info); i++)
                {
                    if (cCar_Info[i][PRIZE_ID] == prize_modelid)
                    {
                        format(prize_name, sizeof(prize_name), "%s", cCar_Info[i][PRIZE_NAME]);
                        break;
                    }
                }
                TextDrawSetPreviewModel(cont_model[cont_id], prize_modelid);
                TextDrawSetPreviewVehCol(cont_model[cont_id], cInfo[cont_id][ContVehicleColor], 1);
            }
            
            ConvertMoney(cInfo[cont_id][ItemPrice], prize_price_string);
            format(prize_price_string, sizeof(prize_price_string), "%s ˜˜˜", prize_price_string);
            
            TextDrawSetString(cont_name[cont_id], prize_name);
            TextDrawSetString(cont_price[cont_id], prize_price_string);

            TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_HIDE);
            TextDrawShowForPlayer(playerid, cont_fon);
            TextDrawShowForPlayer(playerid, cont_take);
            TextDrawShowForPlayer(playerid, cont_sell);
            TextDrawShowForPlayer(playerid, cont_close);
            TextDrawShowForPlayer(playerid, cont_name[cont_id]);
            TextDrawShowForPlayer(playerid, cont_price[cont_id]);
            TextDrawShowForPlayer(playerid, cont_model[cont_id]);
            
            for(new a;a < 12;a++)  SendClientMessage(playerid, 0xFFFFFFFF, "");
            
            SelectTextDraw(playerid, CLR_WHITE);
        }
    else
    {
        SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜ ˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜!");
    }
    return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(clickedid == cont_sell)
    {
        for(new cont=1; cont <= MAX_CONT; cont++)
        {
            if(cInfo[cont][ContZoneId] != -1 && IsPlayerInDynamicArea(playerid, cInfo[cont][ContZoneId]) && cInfo[cont][Saled] == false)
            {
                if(cInfo[cont][BetedId] == playerid)
                {
                    new sell_price_string[120];
                    new sell_price = cInfo[cont][ItemPrice];
                    if(cInfo[cont][ItemType] == 1)
                    {
                        Cont_RemoveSkinFromInv(playerid, cInfo[cont][Item]);
                    }
                    GivePlayerMoneyEx(playerid, sell_price);
                    format(sell_price_string, sizeof(sell_price_string), "| {ffffff}˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ {ffff00}#%d {ffffff}˜˜ {ffff00}%d {ffff00}˜˜˜˜˜˜!", cont, sell_price);
                    SendClientMessage(playerid, CLR_GREEN, sell_price_string);

                    TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_SHOW);

                    TextDrawHideForPlayer(playerid, cont_fon);
                    TextDrawHideForPlayer(playerid, cont_take);
                    TextDrawHideForPlayer(playerid, cont_sell);
                    TextDrawHideForPlayer(playerid, cont_close);

                    TextDrawHideForPlayer(playerid, cont_name[cont]);
                    TextDrawHideForPlayer(playerid, cont_price[cont]);
                    TextDrawHideForPlayer(playerid, cont_model[cont]);
                    CancelSelectTextDraw(playerid);

                    if(cInfo[cont][ContZoneId] != -1)
                    {
                        DestroyDynamicArea(cInfo[cont][ContZoneId]);
                        cInfo[cont][ContZoneId] = -1;
                    }

                    DestroyObject(cInfo[cont][ContObjectId]);
                    DestroyObject(cInfo[cont][ContObjectOdejdaId]);
                    DestroyVehicle(cInfo[cont][ContVehicleId]);
                    KillTimer(ContsTimer[cont]);
                    ResetContInfo(cont);

                    SetTimerEx("SpawnNewCont", 5000, false, "i", cont);
                    break;
                }
            }
        }
    }
    if(clickedid == cont_take)
    {
        for(new cont=1; cont <= MAX_CONT; cont++)
        {
            if(cInfo[cont][ContZoneId] != -1 && IsPlayerInDynamicArea(playerid, cInfo[cont][ContZoneId]) && cInfo[cont][Saled] == false)
            {
                if(cInfo[cont][BetedId] == playerid)
                {
                    if (cInfo[cont][ItemType] == 1)
                    {
                        if(!GivePlayerSkin(playerid, cInfo[cont][Item]))
                        {
                            SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜.");
                            return 1;
                        }
                        SendClientMessage(playerid, CLR_GREEN, "| {ffffff}˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜!");
                    }
                    else if (cInfo[cont][ItemType] == 2)
                    {
                        if(!Cont_GivePrizeVehicle(playerid, cont))
                            return 1;
                    }

                    TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_SHOW);

                    TextDrawHideForPlayer(playerid, cont_fon);
                    TextDrawHideForPlayer(playerid, cont_take);
                    TextDrawHideForPlayer(playerid, cont_sell);
                    TextDrawHideForPlayer(playerid, cont_close);

                    TextDrawHideForPlayer(playerid, cont_name[cont]);
                    TextDrawHideForPlayer(playerid, cont_price[cont]);
                    TextDrawHideForPlayer(playerid, cont_model[cont]);
                    CancelSelectTextDraw(playerid);

                    if(cInfo[cont][ContZoneId] != -1)
                    {
                        DestroyDynamicArea(cInfo[cont][ContZoneId]);
                        cInfo[cont][ContZoneId] = -1;
                    }

                    DestroyObject(cInfo[cont][ContObjectId]);
                    DestroyObject(cInfo[cont][ContObjectOdejdaId]);
                    DestroyVehicle(cInfo[cont][ContVehicleId]);
                    KillTimer(ContsTimer[cont]);
                    ResetContInfo(cont);

                    SetTimerEx("SpawnNewCont", 5000, false, "i", cont);
                    break;
                }
            }
        }
    }
    if(clickedid == cont_close)
    {
        TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_SHOW);

        TextDrawHideForPlayer(playerid, cont_fon);
        TextDrawHideForPlayer(playerid, cont_take);
        TextDrawHideForPlayer(playerid, cont_sell);
        TextDrawHideForPlayer(playerid, cont_close);
        CancelSelectTextDraw(playerid);

        for(new cont=1; cont <= MAX_CONT; cont++)
        {
            TextDrawHideForPlayer(playerid, cont_name[cont]);
            TextDrawHideForPlayer(playerid, cont_price[cont]);
            TextDrawHideForPlayer(playerid, cont_model[cont]);
        }
    }
    return conti_OnPlayerClickTextDraw(playerid, clickedid);
}
#if defined _ALS_OnPlayerClickTextDraw
    #undef OnPlayerClickTextDraw
#else
    #define _ALS_OnPlayerClickTextDraw
#endif
#define OnPlayerClickTextDraw conti_OnPlayerClickTextDraw

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    BR_FixDialogInput(inputtext);

    if(dialogid == 19560 || dialogid == 19561)
    {
        if(Phone_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    }

    if(dialogid == DIALOG_TRADE_PICK)
    {
        DeletePVar(playerid, "trade_picking");
        if(!response)
        {
            g_TradePickCount[playerid] = 0;
            return 1;
        }
        if(listitem < 0 || listitem >= g_TradePickCount[playerid])
            return 1;
        new targetid = g_TradePickList[playerid][listitem];
        g_TradePickCount[playerid] = 0;
        if(!Trade_IsPlayerNear(playerid, targetid))
        {
            Trade_NotifyError(playerid, "˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜.");
            return 1;
        }
        if(!Trade_SendInvite(playerid, targetid))
            Trade_NotifyError(playerid, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜.");
        return 1;
    }
    if(dialogid == DIALOG_TRADE_MONEY)
    {
        if(!response || !Trade_IsActive(playerid))
            return 1;

        new amount = strval(inputtext);
        if(amount < 0) amount = 0;
        if(!Trade_ApplyMoneyAmount(playerid, amount, true))
            Trade_NotifyError(playerid, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜.");
        return 1;
    }
    if(dialogid == DIALOG_CONT_BET)
    {
        if(response)
        {
            new cont = GetPVarInt(playerid, "CurrentCont");
            DeletePVar(playerid, "CurrentCont");
            
            if(cont == 0) return printf("ERROR PLAYERID: %d (contuse == 0)");
            if(cInfo[cont][Saled] == true)
            {
                if(cInfo[cont][BetedId] == playerid) return SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜, ˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜");
                if(0 < strval(inputtext) < 100000000)
                {
                    if(GetPlayerMoneyEx(playerid) >= strval(inputtext))
                    {
                        if(strval(inputtext)-99999 > cInfo[cont][BetPrice])
                        {
                            if(strval(inputtext) > cInfo[cont][ContPrice] && strval(inputtext) > cInfo[cont][BetPrice])
                            {
                                new strwerton[111];
                                new name[MAX_PLAYER_NAME]; GetPlayerName(playerid, name, MAX_PLAYER_NAME);
                                if(cInfo[cont][BetedId] != INVALID_PLAYER_ID)
                                {
                                    format(strwerton, sizeof strwerton, "| {ffffff}˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜ ˜˜˜, ˜˜˜ ˜˜˜˜˜ {FF6347}%s {ffffff}˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜!", name);
                                    SendClientMessage(cInfo[cont][BetedId], CLR_RED, strwerton);
                                    GivePlayerMoneyEx(cInfo[cont][BetedId], cInfo[cont][BetPrice]);
                                }

                                GivePlayerMoneyEx(playerid, -strval(inputtext));
                                cInfo[cont][BetPrice] = strval(inputtext);
                                cInfo[cont][BetedId] = playerid;
                                format(cInfo[cont][BetedName], MAX_PLAYER_NAME, "%s", name);

                                new betstr[15];
                                ConvertMoney(cInfo[cont][BetPrice], betstr);
                                format(strwerton, sizeof strwerton, "| {ffffff}˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ {FFFF00}%s {ffffff}˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ {FFFF00}#%d", betstr, cont);
                                SendClientMessage(playerid, CLR_YELLOW, strwerton);

                                StartContBidding(cont);
                            }
                            else
                            {
                                SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜!");
                            }
                        }
                        else
                        {
                            SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ 100.000 ˜˜˜˜˜˜!");
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, CLR_RED, "| {ffffff}˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜!");
                    }
                }
                else
                {
                    SendClientMessage(playerid, CLR_RED, "| {ffffff}˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜!");
                }
            }
        }
    }
    return conti_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
}
#if defined _ALS_OnDialogResponse
    #undef OnDialogResponse
#else
    #define _ALS_OnDialogResponse
#endif
#define OnDialogResponse conti_OnDialogResponse

stock StartCont()
{
    print("=== ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜ | BR BLACK STUDIO ===");
    StopCont();
    for(new cont=1; cont <= MAX_CONT; cont++)
    {
        SpawnCont(cont);
    }
}

stock StopCont()
{
    for(new cont=1; cont <= MAX_CONT; cont++)
    {
        if(cInfo[cont][ContZoneId] != -1)
        {
            DestroyDynamicArea(cInfo[cont][ContZoneId]);
            cInfo[cont][ContZoneId] = -1;
        }

        DestroyObject(cInfo[cont][ContObjectId]);
        DestroyObject(cInfo[cont][ContObjectDoorLId]);
        DestroyObject(cInfo[cont][ContObjectDoorRId]);
        DestroyObject(cInfo[cont][ContObjectOdejdaId]);
        DestroyVehicle(cInfo[cont][ContVehicleId]);
        KillTimer(ContsTimer[cont]);
        ResetContInfo(cont);

        TextDrawHideForAll(cont_name[cont]);
        TextDrawHideForAll(cont_price[cont]);
        TextDrawHideForAll(cont_model[cont]);
    }
    TextDrawHideForAll(cont_fon);
    TextDrawHideForAll(cont_take);
    TextDrawHideForAll(cont_sell);
    TextDrawHideForAll(cont_close);
}

stock StartContBidding(contid)
{
    cInfo[contid][SaleTime] = 30;
    KillTimer(ContsTimer[contid]);

    new moneystr[15], betstr[15];
    ConvertMoney(cInfo[contid][ContPrice], moneystr);
    ConvertMoney(cInfo[contid][BetPrice], betstr);
    
    new strwerton[512];
    format(strwerton, sizeof strwerton, "{993333}˜˜˜˜˜˜˜˜˜ #%d\n\n˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜˜: {FFFFFF}˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s ˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s ˜˜˜˜˜˜\n{993333}˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜: {FFFFFF}%s\n{993333}˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%d ˜˜˜˜˜˜", contid, g_RegionData[cInfo[contid][ContRegion]][RegionName], (cInfo[contid][ItemType] == 1) ? ("˜˜˜˜˜˜") : ("˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜"), betstr, moneystr, cInfo[contid][BetedName], cInfo[contid][SaleTime]);
    UpdateDynamic3DTextLabelText(ContsText[contid], CLR_RED, strwerton);
    
    ContsTimer[contid] = SetTimerEx("TimerSecondUpdateCont", 1000, true, "i", contid);
    return 1;
}

stock Cont_GivePrizeVehicle(playerid, contid)
{
    new slot = Player_FindFreeCarSlot(playerid);
    if(slot == -1)
    {
        new slot_msg[160];
        Player_FillNoCarSlotMessage(playerid, slot_msg, sizeof slot_msg);
        SendClientMessage(playerid, CLR_RED, slot_msg);
        return false;
    }
    new car_model = cInfo[contid][Item];
    new car_color = cInfo[contid][ContVehicleColor];
    VehicleInfo_ClearSlot(playerid, slot, false);
    VehicleInfo[playerid][slot][vModel] = car_model;
    VehicleInfo[playerid][slot][vPrice] = 0;
    VehicleInfo[playerid][slot][vColor][0] = car_color;
    VehicleInfo[playerid][slot][vColor][1] = car_color;
    VehicleInfo[playerid][slot][vBodyColor] = 0;
    VehicleInfo[playerid][slot][vDiskColor] = 0;
    VehicleInfo[playerid][slot][vWheel] = 0;
    VehicleInfo[playerid][slot][vVinyl][0] = '\0';
    VehicleInfo[playerid][slot][vNitro] = 0;
    VehicleInfo[playerid][slot][vPos][0] = cContsPos[contid - 1][0];
    VehicleInfo[playerid][slot][vPos][1] = cContsPos[contid - 1][1];
    VehicleInfo[playerid][slot][vPos][2] = cContsPos[contid - 1][2] - 1.0;
    VehicleInfo[playerid][slot][vPos][3] = cContsPos[contid - 1][3] + 90.0;
    if(VehicleInfo[playerid][slot][vPos][3] >= 360.0) VehicleInfo[playerid][slot][vPos][3] -= 360.0;
    new query[512];
    mysql_format(db_handle, query, sizeof(query),
        "INSERT INTO `ownable_cars` (`owner_id`, `owner_name`, `model`, `price`, `color1`, `color2`, `body_color`, `disk_color`, `wheel`, `vinyl`, `nitro`, `x`, `y`, `z`, `a`) \
        VALUES (%d, '%e', %d, 0, %d, %d, 0, 0, 0, '', 0, '%f', '%f', '%f', '%f')",
        Player[playerid][pID], Player[playerid][pName], car_model, car_color, car_color,
        VehicleInfo[playerid][slot][vPos][0], VehicleInfo[playerid][slot][vPos][1],
        VehicleInfo[playerid][slot][vPos][2], VehicleInfo[playerid][slot][vPos][3]);
    mysql_tquery(db_handle, query, "OnCarAwardAdded", "ii", playerid, slot);
    SendClientMessage(playerid, CLR_GREEN, "| {ffffff}˜˜˜˜˜˜˜˜˜˜˜! ˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");
    return true;
}

public SpawnNewCont(contid)
{
    SpawnCont(contid);
}

CMD:startcont(playerid)
{
    if(Player[playerid][pAdminLvl] < 11 || !Player[playerid][pAdminAuth]) return 1;
    StartCont();
    ShowNotification(playerid, 1, 3, 0, 0, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜", ">>");
    return 1;
}

CMD:stopcont(playerid)
{
    if(Player[playerid][pAdminLvl] < 11 || !Player[playerid][pAdminAuth]) return 1;
    StopCont();
    ShowNotification(playerid, 1, 3, 0, 0, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜", ">>");
    return 1;
}
