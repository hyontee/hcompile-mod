stock Inv_EnsureInventoryDbId(playerid, inv_slot)
{
    if(inv_slot < 0 || inv_slot >= MAX_INV_SLOTS) return 0;
    if(PlayerInventory[playerid][inv_slot][invID] > 0)
        return PlayerInventory[playerid][inv_slot][invID];
    if(PlayerInventory[playerid][inv_slot][invItem] <= 0) return 0;
    if(Player[playerid][pID] <= 0) return 0;

    new q[280];
    mysql_format(db_handle, q, sizeof q,
        "INSERT INTO `inventory` (`uid`, `item_id`, `count`, `slot`, `value`) VALUES (%d, %d, %d, %d, %d)",
        Player[playerid][pID], PlayerInventory[playerid][inv_slot][invItem],
        PlayerInventory[playerid][inv_slot][invCount], inv_slot,
        PlayerInventory[playerid][inv_slot][invValue]);
    mysql_query(db_handle, q, false);
    PlayerInventory[playerid][inv_slot][invID] = cache_insert_id();
    return PlayerInventory[playerid][inv_slot][invID];
}

stock Inv_AttachAccessoryPreview(playerid)
{
    new att_slot = GetPVarInt(playerid, "slot");
    new modelid = GetPVarInt(playerid, "acs_model");
    new bone = GetPVarInt(playerid, "bone");
    if(modelid <= 0) return 0;

    if(IsPlayerAttachedObjectSlotUsed(playerid, att_slot))
        RemovePlayerAttachedObject(playerid, att_slot);

    SetPlayerAttachedObject(playerid, att_slot, modelid, bone,
        GetPVarFloat(playerid, "edit_x"), GetPVarFloat(playerid, "edit_y"), GetPVarFloat(playerid, "edit_z"),
        GetPVarFloat(playerid, "edit_rX"), GetPVarFloat(playerid, "edit_rY"), GetPVarFloat(playerid, "edit_rZ"),
        GetPVarFloat(playerid, "edit_scale"), GetPVarFloat(playerid, "edit_scale"), GetPVarFloat(playerid, "edit_scale"));
    return 1;
}

stock Inv_ShowAccessoryEditUI(playerid)
{
    for(new i; i < 11; i++) TextDrawShowForPlayer(playerid, acss_TD[i]);
    TextDrawShowForPlayer(playerid, acss_TD[17]);
    TextDrawShowForPlayer(playerid, acss_TD[24]);
    TextDrawShowForPlayer(playerid, acss_TD[25]);
    SetPVarInt(playerid, "acss_TD_use", 1);

    if(acss_coords_PTD[playerid] != PlayerText:INVALID_TEXT_DRAW)
        PlayerTextDrawDestroy(playerid, acss_coords_PTD[playerid]);

    new s[32];
    format(s, sizeof s, "%.4f", GetPVarFloat(playerid, "edit_x"));
    acss_coords_PTD[playerid] = CreatePlayerTextDraw(playerid, 521.3996, 292.8998, s);
    PlayerTextDrawShow(playerid, acss_coords_PTD[playerid]);
    SelectTextDraw(playerid, -1);
    TogglePlayerControllable(playerid, false);
    acs_editing[playerid] = true;
    return 1;
}

stock StartAccessoryEdit(playerid, modelid, bone, slot, inv_db_id, inv_slot = -1)
{
    if(modelid <= 0) return 0;

    SetPVarInt(playerid, "inv_db_id", inv_db_id);
    SetPVarInt(playerid, "acc_edit_inv_slot", inv_slot);
    SetPVarInt(playerid, "slot", slot);
    SetPVarInt(playerid, "bone", bone);
    SetPVarInt(playerid, "acs_model", modelid);

    new preset_item = 0;
    if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS)
        preset_item = PlayerInventory[playerid][inv_slot][invItem];

    new preset_bone = bone;
    new Float:px, Float:py, Float:pz, Float:rx, Float:ry, Float:rz, Float:sc;
    new bool:loaded_save = false;

    if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS && preset_item > 0)
    {
        new lm = modelid;
        if(Inv_LoadAccessoryParamsForSlot(playerid, inv_slot, lm, preset_bone, px, py, pz, rx, ry, rz, sc))
        {
            modelid = lm;
            loaded_save = true;
        }
        else
            Inv_GetAccessoryPreset(preset_item, preset_bone, px, py, pz, rx, ry, rz, sc);
    }
    else if(preset_item > 0)
        Inv_GetAccessoryPreset(preset_item, preset_bone, px, py, pz, rx, ry, rz, sc);
    else
    {
        px = 0.08; py = 0.0; pz = 0.0;
        rx = 0.0; ry = 0.0; rz = 0.0; sc = 1.0;
    }

    if(preset_item > 0)
    {
        new sm = modelid;
        new sb = preset_bone;
        Inv_SanitizeAccessoryParams(preset_item, sm, sb, px, py, pz, rx, ry, rz, sc, loaded_save);
        modelid = sm;
        preset_bone = sb;
    }

    SetPVarInt(playerid, "bone", preset_bone);
    SetPVarInt(playerid, "acs_model", modelid);
    SetPVarFloat(playerid, "edit_x", px);
    SetPVarFloat(playerid, "edit_y", py);
    SetPVarFloat(playerid, "edit_z", pz);
    SetPVarFloat(playerid, "edit_rX", rx);
    SetPVarFloat(playerid, "edit_rY", ry);
    SetPVarFloat(playerid, "edit_rZ", rz);
    SetPVarFloat(playerid, "edit_scale", sc);

    Inv_AttachAccessoryPreview(playerid);
    Inv_ShowAccessoryEditUI(playerid);

    new Node:res = JSON_Object();
    JSON_SetInt(res, "c", 1);
    OnPacketIncoming(playerid, 33, res);
    JSON_Cleanup(res);
    return 1;
}

forward OnLoadAccessoryEdit(playerid);
public OnLoadAccessoryEdit(playerid)
{
    if(cache_num_rows())
    {
        new db_bone = cache_get_field_content_int(0, "bone");
        if(db_bone >= 1 && db_bone <= 18) SetPVarInt(playerid, "bone", db_bone);
        new item_id = 0;
        new inv_slot = GetPVarInt(playerid, "acc_edit_inv_slot");
        if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS)
            item_id = PlayerInventory[playerid][inv_slot][invItem];
        new db_model = cache_get_field_content_int(0, "modelid");
        if(item_id > 0)
            SetPVarInt(playerid, "acs_model", Inv_ResolveAccessoryModel(item_id, db_model));
        else if(db_model > 0)
            SetPVarInt(playerid, "acs_model", db_model);
        SetPVarFloat(playerid, "edit_x", cache_get_field_content_float(0, "pos_x"));
        SetPVarFloat(playerid, "edit_y", cache_get_field_content_float(0, "pos_y"));
        SetPVarFloat(playerid, "edit_z", cache_get_field_content_float(0, "pos_z"));
        SetPVarFloat(playerid, "edit_rX", cache_get_field_content_float(0, "rot_x"));
        SetPVarFloat(playerid, "edit_rY", cache_get_field_content_float(0, "rot_y"));
        SetPVarFloat(playerid, "edit_rZ", cache_get_field_content_float(0, "rot_z"));
        SetPVarFloat(playerid, "edit_scale", cache_get_field_content_float(0, "scale"));
    }
    else
    {
        new item_id = 0;
        new inv_slot = GetPVarInt(playerid, "acc_edit_inv_slot");
        if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS)
            item_id = PlayerInventory[playerid][inv_slot][invItem];
        if(item_id > 0)
        {
            new dbone;
            new Float:px, Float:py, Float:pz, Float:rx, Float:ry, Float:rz, Float:sc;
            Inv_GetAccessoryPreset(item_id, dbone, px, py, pz, rx, ry, rz, sc);
            SetPVarInt(playerid, "bone", dbone);
            SetPVarFloat(playerid, "edit_x", px);
            SetPVarFloat(playerid, "edit_y", py);
            SetPVarFloat(playerid, "edit_z", pz);
            SetPVarFloat(playerid, "edit_rX", rx);
            SetPVarFloat(playerid, "edit_rY", ry);
            SetPVarFloat(playerid, "edit_rZ", rz);
            SetPVarFloat(playerid, "edit_scale", sc);
        }
        else
        {
            SetPVarFloat(playerid, "edit_x", 0.08);
            SetPVarFloat(playerid, "edit_y", 0.0);
            SetPVarFloat(playerid, "edit_z", 0.0);
            SetPVarFloat(playerid, "edit_rX", 0.0);
            SetPVarFloat(playerid, "edit_rY", 0.0);
            SetPVarFloat(playerid, "edit_rZ", 0.0);
            SetPVarFloat(playerid, "edit_scale", 1.0);
        }
    }

    Inv_AttachAccessoryPreview(playerid);
    Inv_ShowAccessoryEditUI(playerid);
    return 1;
}

stock StopAccessoryEdit(playerid, bool:save)
{
    new inv_slot = GetPVarInt(playerid, "acc_edit_inv_slot");

    if(save)
    {
        new save_item = 0, save_model = GetPVarInt(playerid, "acs_model");
        if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS)
            save_item = PlayerInventory[playerid][inv_slot][invItem];
        if(save_item > 0)
        {
            new sb = GetPVarInt(playerid, "bone");
            new Float:spx, Float:spy, Float:spz, Float:srx, Float:sry, Float:srz, Float:ssc;
            spx = GetPVarFloat(playerid, "edit_x");
            spy = GetPVarFloat(playerid, "edit_y");
            spz = GetPVarFloat(playerid, "edit_z");
            srx = GetPVarFloat(playerid, "edit_rX");
            sry = GetPVarFloat(playerid, "edit_rY");
            srz = GetPVarFloat(playerid, "edit_rZ");
            ssc = GetPVarFloat(playerid, "edit_scale");
            Inv_SanitizeAccessoryParams(save_item, save_model, sb, spx, spy, spz, srx, sry, srz, ssc, true);
            SetPVarInt(playerid, "bone", sb);
            SetPVarInt(playerid, "acs_model", save_model);
            SetPVarFloat(playerid, "edit_x", spx);
            SetPVarFloat(playerid, "edit_y", spy);
            SetPVarFloat(playerid, "edit_z", spz);
            SetPVarFloat(playerid, "edit_rX", srx);
            SetPVarFloat(playerid, "edit_rY", sry);
            SetPVarFloat(playerid, "edit_rZ", srz);
            SetPVarFloat(playerid, "edit_scale", ssc);
        }

        if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS)
            Inv_SaveAccessoryRow(playerid, inv_slot, save_model, GetPVarInt(playerid, "bone"),
                GetPVarFloat(playerid, "edit_x"), GetPVarFloat(playerid, "edit_y"), GetPVarFloat(playerid, "edit_z"),
                GetPVarFloat(playerid, "edit_rX"), GetPVarFloat(playerid, "edit_rY"), GetPVarFloat(playerid, "edit_rZ"),
                GetPVarFloat(playerid, "edit_scale"));

        if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS)
        {
            save_item = PlayerInventory[playerid][inv_slot][invItem];
            if(IsItemAccessory(save_item) > 0)
            {
                if(Inv_IsBackpackItem(save_item))
                    Inv_UnequipAllBackpacks(playerid, inv_slot);
                else if(Inv_IsWearableAccessory(save_item))
                    Inv_UnequipWearableCategory(playerid, Inv_GetAccessoryCategory(save_item), inv_slot);

                PlayerInventory[playerid][inv_slot][invValue] = 1;
                if(PlayerInventory[playerid][inv_slot][invID] > 0)
                {
                    new q_w[128];
                    mysql_format(db_handle, q_w, sizeof q_w, "UPDATE `inventory` SET `value`=1 WHERE `id`=%d",
                        PlayerInventory[playerid][inv_slot][invID]);
                    mysql_query(db_handle, q_w, false);
                }

                Inv_AttachAccessoryNow(playerid, save_item,
                    GetPVarInt(playerid, "acs_model"), GetPVarInt(playerid, "bone"),
                    GetPVarFloat(playerid, "edit_x"), GetPVarFloat(playerid, "edit_y"), GetPVarFloat(playerid, "edit_z"),
                    GetPVarFloat(playerid, "edit_rX"), GetPVarFloat(playerid, "edit_rY"), GetPVarFloat(playerid, "edit_rZ"),
                    GetPVarFloat(playerid, "edit_scale"), true);
            }
        }
    }
    else
    {
        new att = GetPVarInt(playerid, "slot");
        if(att >= 0 && att < 10 && IsPlayerAttachedObjectSlotUsed(playerid, att))
            RemovePlayerAttachedObject(playerid, att);
        if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS && PlayerInventory[playerid][inv_slot][invValue] == 1)
            Inv_ApplyAccessoryFromSlot(playerid, inv_slot);
    }

    for(new i; i < sizeof acss_TD; i++) TextDrawHideForPlayer(playerid, acss_TD[i]);
    if(acss_coords_PTD[playerid] != PlayerText:INVALID_TEXT_DRAW) {
        PlayerTextDrawDestroy(playerid, acss_coords_PTD[playerid]);
        acss_coords_PTD[playerid] = PlayerText:INVALID_TEXT_DRAW;
    }
    
    DeletePVar(playerid, "inv_db_id");
    DeletePVar(playerid, "acc_edit_inv_slot");
    DeletePVar(playerid, "slot");
    DeletePVar(playerid, "bone");
    DeletePVar(playerid, "acs_model");
    DeletePVar(playerid, "acss_TD_use");
    DeletePVar(playerid, "edit_x"); DeletePVar(playerid, "edit_y"); DeletePVar(playerid, "edit_z");
    DeletePVar(playerid, "edit_rX"); DeletePVar(playerid, "edit_rY"); DeletePVar(playerid, "edit_rZ"); DeletePVar(playerid, "edit_scale");

    CancelSelectTextDraw(playerid);
    TogglePlayerControllable(playerid, true);
    acs_editing[playerid] = false;

    if(save)
    {
        ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜.", "");
        Inv_RefreshInventoryGui(playerid);
    }
    return 1;
}

stock IsAccessoryWorn(playerid, inv_slot) {
    return (PlayerInventory[playerid][inv_slot][invValue] == 1);
}

stock Inv_UnequipAllBackpacks(playerid, keep_slot = -1)
{
    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        if(i == keep_slot) continue;
        if(!Inv_IsBackpackItem(PlayerInventory[playerid][i][invItem])) continue;
        if(PlayerInventory[playerid][i][invValue] != 1) continue;

        Inv_RemoveWornAttach(playerid, PlayerInventory[playerid][i][invItem]);
        PlayerInventory[playerid][i][invValue] = 0;
        if(PlayerInventory[playerid][i][invID] > 0)
        {
            new q[128];
            mysql_format(db_handle, q, sizeof q, "UPDATE `inventory` SET `value`=0 WHERE `id`=%d",
                PlayerInventory[playerid][i][invID]);
            mysql_query(db_handle, q, false);
        }
    }
    return 1;
}

stock Inv_GetAttachSlot(itemid)
{
    if(Inv_IsBackpackItem(itemid)) return INV_ACC_SLOT_BACKPACK;
    switch(Inv_GetAccessoryCategory(itemid))
    {
        case ACC_CAT_HEAD: return INV_ACC_SLOT_HEAD;
        case ACC_CAT_HAND: return INV_ACC_SLOT_HAND;
        case ACC_CAT_SPINE: return INV_ACC_SLOT_SPINE;
    }
    return INV_ACC_SLOT_SPINE;
}

stock Inv_GetAiSlotPos(item_id)
{
    if(item_id == 134) return 6;
    if(item_id == ITEM_SIM_CARD) return SIM_CARD_ACTIVE_POS;
    if(Inv_IsBackpackItem(item_id)) return INV_ACC_SLOT_BACKPACK;
    switch(Inv_GetAccessoryCategory(item_id))
    {
        case ACC_CAT_HEAD: return 2;
        case ACC_CAT_SPINE: return 3;
        case ACC_CAT_HAND: return 4;
    }
    return 5;
}

stock GetAccSlot(itemid)
{
    return Inv_GetAttachSlot(itemid);
}

stock Inv_UnequipWearableCategory(playerid, category, keep_slot = -1)
{
    if(category == ACC_CAT_NONE) return 0;

    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        if(i == keep_slot) continue;
        new item_id = Inv_ClientCatalogId(PlayerInventory[playerid][i][invItem]);
        if(Inv_GetAccessoryCategory(item_id) != category) continue;
        if(PlayerInventory[playerid][i][invValue] != 1) continue;

        Inv_RemoveWornAttach(playerid, item_id);
        PlayerInventory[playerid][i][invValue] = 0;
        if(PlayerInventory[playerid][i][invID] > 0)
        {
            new q[128];
            mysql_format(db_handle, q, sizeof q, "UPDATE `inventory` SET `value`=0 WHERE `id`=%d",
                PlayerInventory[playerid][i][invID]);
            mysql_query(db_handle, q, false);
        }
    }
    return 1;
}

stock Inv_NormalizeWornAccessories(playerid)
{
    new keeper[ACC_CAT_BACKPACK + 1];
    for(new c = 0; c <= ACC_CAT_BACKPACK; c++) keeper[c] = -1;

    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        new item_id = Inv_ClientCatalogId(PlayerInventory[playerid][i][invItem]);
        new category = Inv_GetAccessoryCategory(item_id);
        if(category == ACC_CAT_NONE) continue;
        if(PlayerInventory[playerid][i][invValue] != 1) continue;

        if(keeper[category] == -1) { keeper[category] = i; continue; }

        Inv_RemoveWornAttach(playerid, item_id);
        PlayerInventory[playerid][i][invValue] = 0;
        if(PlayerInventory[playerid][i][invID] > 0)
        {
            new q[128];
            mysql_format(db_handle, q, sizeof q, "UPDATE `inventory` SET `value`=0 WHERE `id`=%d",
                PlayerInventory[playerid][i][invID]);
            mysql_query(db_handle, q, false);
        }
    }
    return 1;
}

stock Inv_ApplyAccessoryFromSlot(playerid, inv_slot)
{
    if(inv_slot < 0 || inv_slot >= MAX_INV_SLOTS) return 0;
    if(PlayerInventory[playerid][inv_slot][invValue] != 1) return 0;

    new item_id = Inv_ClientCatalogId(PlayerInventory[playerid][inv_slot][invItem]);
    new model, bone;
    new Float:px, Float:py, Float:pz, Float:rx, Float:ry, Float:rz, Float:sc;

    if(!Inv_LoadAccessoryParamsForSlot(playerid, inv_slot, model, bone, px, py, pz, rx, ry, rz, sc))
        return 0;

    return Inv_AttachAccessoryNow(playerid, item_id, model, bone, px, py, pz, rx, ry, rz, sc, true);
}

stock Inv_ApplyAllWornAccessories(playerid)
{
    if(!IsPlayerConnected(playerid) || Player[playerid][pID] <= 0) return 0;
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) return 0;

    Inv_NormalizeWornAccessories(playerid);

    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        new item_id = Inv_ClientCatalogId(PlayerInventory[playerid][i][invItem]);
        if(item_id <= 0 || PlayerInventory[playerid][i][invValue] != 1) continue;
        if(IsItemAccessory(item_id) <= 0 && !Inv_IsBackpackItem(item_id)) continue;

        Inv_ApplyAccessoryFromSlot(playerid, i);
    }
    return 1;
}

stock Inv_ApplySingleWornAccessory(playerid)
{
    return Inv_ApplyAllWornAccessories(playerid);
}

stock Inv_TryApplyWornAccessories(playerid)
{
    if(!IsPlayerConnected(playerid) || Player[playerid][pID] <= 0) return 0;
    SetTimerEx("Inv_ApplyWornAccessoriesDelayed", 350, false, "i", playerid);
    SetTimerEx("Inv_ApplyWornAccessoriesDelayed", 900, false, "i", playerid);
    return 1;
}

forward Inv_ApplyWornAccessoriesDelayed(playerid);
public Inv_ApplyWornAccessoriesDelayed(playerid)
{
    if(!IsPlayerConnected(playerid) || Player[playerid][pID] <= 0) return 1;
    if(GetPVarInt(playerid, "spawn_gui_active") || GetPVarInt(playerid, "spawn_resolving"))
        return 1;
    if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING)
    {
        SetTimerEx("Inv_ApplyWornAccessoriesDelayed", 400, false, "i", playerid);
        return 1;
    }
    Inv_ApplyAllWornAccessories(playerid);
    return 1;
}

stock Inv_SyncWornInventoryToDB(playerid)
{
    if(Player[playerid][pID] <= 0) return 0;
    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        if(PlayerInventory[playerid][i][invID] <= 0) continue;
        new item_id = Inv_ClientCatalogId(PlayerInventory[playerid][i][invItem]);
        if(item_id <= 0) continue;
        if(PlayerInventory[playerid][i][invValue] != 1) continue;
        if(IsItemAccessory(item_id) <= 0 && !Inv_IsBackpackItem(item_id)) continue;

        new q[128];
        mysql_format(db_handle, q, sizeof q,
            "UPDATE `inventory` SET `value`=1 WHERE `id`=%d",
            PlayerInventory[playerid][i][invID]);
        mysql_tquery(db_handle, q);
    }
    return 1;
}

stock Inventory_BuildActiveSlots(playerid, &Node:aiArray)
{
    Inv_NormalizeWornAccessories(playerid);
    new bool:cat_added[ACC_CAT_BACKPACK + 1];
    for(new c = 0; c <= ACC_CAT_BACKPACK; c++) cat_added[c] = false;

    new flat[1024];
    flat[0] = '\0';
    strcat(flat, "[", sizeof flat);
    new bool:is_first = true;

    Inv_FlatJsonPutInt(flat, sizeof flat, 134, is_first);
    Inv_FlatJsonPutInt(flat, sizeof flat, GetPlayerSkin(playerid), is_first);
    Inv_FlatJsonPutInt(flat, sizeof flat, 6, is_first);
    Inv_FlatJsonPutInt(flat, sizeof flat, 0, is_first);

    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        new item_id = Inv_ClientCatalogId(PlayerInventory[playerid][i][invItem]);
        if(item_id <= 0 || PlayerInventory[playerid][i][invValue] != 1) continue;
        if(IsItemAccessory(item_id) <= 0 && !Inv_IsBackpackItem(item_id)) continue;

        if(Inv_IsWearableAccessory(item_id))
        {
            new category = Inv_GetAccessoryCategory(item_id);
            if(cat_added[category]) continue;
            cat_added[category] = true;
        }

        new disp_cnt = PlayerInventory[playerid][i][invCount];
        if(disp_cnt < 1) disp_cnt = 1;
        Inv_FlatJsonPutInt(flat, sizeof flat, item_id, is_first);
        Inv_FlatJsonPutInt(flat, sizeof flat, disp_cnt, is_first);
        Inv_FlatJsonPutInt(flat, sizeof flat, Inv_GetAiSlotPos(item_id), is_first);
        Inv_FlatJsonPutInt(flat, sizeof flat, 0, is_first);
    }
    strcat(flat, "]", sizeof flat);

    aiArray = JSON_Array();
    if(strlen(flat) > 2)
        JSON_Parse(flat, aiArray);
    return 1;
}

stock Inv_RemoveWornAttach(playerid, item_id)
{
    new att = Inv_GetAttachSlot(item_id);
    if(IsPlayerAttachedObjectSlotUsed(playerid, att))
        RemovePlayerAttachedObject(playerid, att);
    return 1;
}

forward Inv_OnApplyWornAccessory(playerid);
public Inv_OnApplyWornAccessory(playerid)
{
    new inv_slot = GetPVarInt(playerid, "acc_wear_inv_slot");
    DeletePVar(playerid, "acc_wear_inv_slot");
    if(inv_slot < 0 || inv_slot >= MAX_INV_SLOTS) return 1;

    new item_id = PlayerInventory[playerid][inv_slot][invItem];
    new model = IsItemAccessory(item_id);
    if(model <= 0) return 1;

    new bone;
    new Float:px, Float:py, Float:pz, Float:rx, Float:ry, Float:rz, Float:sc;
    Inv_GetAccessoryPreset(item_id, bone, px, py, pz, rx, ry, rz, sc);

    if(cache_num_rows())
    {
        model = Inv_ResolveAccessoryModel(item_id, cache_get_field_content_int(0, "modelid"));
        new dbone = cache_get_field_content_int(0, "bone");
        if(dbone >= 1 && dbone <= 18) bone = dbone;
        px = cache_get_field_content_float(0, "pos_x");
        py = cache_get_field_content_float(0, "pos_y");
        pz = cache_get_field_content_float(0, "pos_z");
        rx = cache_get_field_content_float(0, "rot_x");
        ry = cache_get_field_content_float(0, "rot_y");
        rz = cache_get_field_content_float(0, "rot_z");
        sc = cache_get_field_content_float(0, "scale");
        if(sc < 0.01) sc = 1.0;
        if(floatabs(px) < 0.001 && floatabs(py) < 0.001 && floatabs(pz) < 0.001)
            Inv_GetAccessoryPreset(item_id, bone, px, py, pz, rx, ry, rz, sc);
    }

    Inv_AttachAccessoryNow(playerid, item_id, model, bone, px, py, pz, rx, ry, rz, sc);
    return 1;
}

stock Inv_FindWornAccessorySlot(playerid, item_id)
{
    item_id = Inv_ClientCatalogId(item_id);
    for(new i = 0; i < MAX_INV_SLOTS; i++)
    {
        if(Inv_ClientCatalogId(PlayerInventory[playerid][i][invItem]) != item_id) continue;
        if(PlayerInventory[playerid][i][invValue] != 1) continue;
        if(Inv_IsWearableAccessory(item_id) || IsItemAccessory(item_id) > 0 || Inv_IsBackpackItem(item_id))
            return i;
    }
    return -1;
}

stock Inv_ResolveAccessoryMigrateFrom(playerid, item_id, old_pos)
{
    if(old_pos >= 0 && old_pos < MAX_INV_SLOTS && PlayerInventory[playerid][old_pos][invItem] == item_id)
        return old_pos;
    return Inv_FindWornAccessorySlot(playerid, item_id);
}

stock Inv_SaveAccessoryRow(playerid, inv_slot, modelid, bone, Float:px, Float:py, Float:pz, Float:rx, Float:ry, Float:rz, Float:sc)
{
    if(inv_slot < 0 || inv_slot >= MAX_INV_SLOTS) return 0;
    if(PlayerInventory[playerid][inv_slot][invID] <= 0) return 0;

    new inv_db_id = PlayerInventory[playerid][inv_slot][invID];
    new item_id = Inv_ClientCatalogId(PlayerInventory[playerid][inv_slot][invItem]);
    Inv_SanitizeAccessoryParams(item_id, modelid, bone, px, py, pz, rx, ry, rz, sc, true);

    new chk[96];
    mysql_format(db_handle, chk, sizeof chk,
        "SELECT `id` FROM `player_accessories` WHERE `inv_id`=%d ORDER BY `id` DESC LIMIT 1", inv_db_id);
    new Cache:exists = mysql_query(db_handle, chk, true);

    new q[512];
    if(cache_num_rows())
    {
        new row_id = cache_get_field_content_int(0, "id");
        mysql_format(db_handle, q, sizeof q,
            "UPDATE `player_accessories` SET `uid`=%d, `modelid`=%d, `bone`=%d, `pos_x`=%f, `pos_y`=%f, `pos_z`=%f, \
            `rot_x`=%f, `rot_y`=%f, `rot_z`=%f, `scale`=%f WHERE `id`=%d",
            Player[playerid][pID], modelid, bone, px, py, pz, rx, ry, rz, sc, row_id);
    }
    else
    {
        mysql_format(db_handle, q, sizeof q,
            "INSERT INTO `player_accessories` (uid, inv_id, modelid, bone, pos_x, pos_y, pos_z, rot_x, rot_y, rot_z, scale) \
            VALUES (%d, %d, %d, %d, %f, %f, %f, %f, %f, %f, %f)",
            Player[playerid][pID], inv_db_id, modelid, bone, px, py, pz, rx, ry, rz, sc);
    }
    cache_delete(exists);
    mysql_query(db_handle, q, false);
    return 1;
}

stock Inv_AttachAccessoryNow(playerid, item_id, modelid, bone, Float:px, Float:py, Float:pz, Float:rx, Float:ry, Float:rz, Float:sc, bool:keep_saved_offsets = false)
{
    Inv_SanitizeAccessoryParams(item_id, modelid, bone, px, py, pz, rx, ry, rz, sc, keep_saved_offsets);
    if(modelid <= 0) return 0;
    new att = Inv_GetAttachSlot(item_id);
    if(IsPlayerAttachedObjectSlotUsed(playerid, att))
        RemovePlayerAttachedObject(playerid, att);
    SetPlayerAttachedObject(playerid, att, modelid, bone, px, py, pz, rx, ry, rz, sc, sc, sc);
    return 1;
}

stock Inv_EquipAccessoryWithSaved(playerid, inv_slot, bool:notify = true)
{
    if(inv_slot < 0 || inv_slot >= MAX_INV_SLOTS) return 0;

    new item_id = PlayerInventory[playerid][inv_slot][invItem];
    if(IsItemAccessory(item_id) <= 0 && !Inv_IsBackpackItem(item_id)) return 0;

    new inv_db = Inv_EnsureInventoryDbId(playerid, inv_slot);
    if(inv_db <= 0) return 0;

    if(Inv_IsBackpackItem(item_id))
        Inv_UnequipAllBackpacks(playerid, inv_slot);
    else if(Inv_IsWearableAccessory(item_id))
        Inv_UnequipWearableCategory(playerid, Inv_GetAccessoryCategory(item_id), inv_slot);

    new model, bone;
    new Float:px, Float:py, Float:pz, Float:rx, Float:ry, Float:rz, Float:sc;
    if(!Inv_LoadAccessoryParamsForSlot(playerid, inv_slot, model, bone, px, py, pz, rx, ry, rz, sc))
    {
        Inv_GetAccessoryPreset(item_id, bone, px, py, pz, rx, ry, rz, sc);
        model = Inv_ResolveAttachModel(item_id);
        Inv_SaveAccessoryRow(playerid, inv_slot, model, bone, px, py, pz, rx, ry, rz, sc);
    }

    Inv_AttachAccessoryNow(playerid, item_id, model, bone, px, py, pz, rx, ry, rz, sc, true);

    PlayerInventory[playerid][inv_slot][invValue] = 1;
    new q_w[128];
    mysql_format(db_handle, q_w, sizeof q_w, "UPDATE `inventory` SET `value`=1 WHERE `id`=%d", inv_db);
    mysql_query(db_handle, q_w, false);

    if(notify)
        ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ (˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜).", "");
    return 1;
}

stock Inv_EquipAccessoryAuto(playerid, inv_slot)
{
    return Inv_EquipAccessoryWithSaved(playerid, inv_slot, false);
}

stock Inv_EnsureAccessoryRow(playerid, inv_slot)
{
    if(inv_slot < 0 || inv_slot >= MAX_INV_SLOTS) return 0;
    if(PlayerInventory[playerid][inv_slot][invID] <= 0) return 0;
    if(Inv_HasAccessorySaveForSlot(playerid, inv_slot)) return 1;

    new item_id = PlayerInventory[playerid][inv_slot][invItem];
    new model = Inv_ResolveAttachModel(item_id);
    if(model <= 0) return 0;

    new bone;
    new Float:px, Float:py, Float:pz, Float:rx, Float:ry, Float:rz, Float:sc;
    Inv_GetAccessoryPreset(item_id, bone, px, py, pz, rx, ry, rz, sc);
    return Inv_SaveAccessoryRow(playerid, inv_slot, model, bone, px, py, pz, rx, ry, rz, sc);
}

stock Inv_ApplyWornAccessory(playerid, inv_slot)
{
    if(inv_slot < 0 || inv_slot >= MAX_INV_SLOTS) return 0;
    if(PlayerInventory[playerid][inv_slot][invItem] <= 0) return 0;
    if(IsItemAccessory(PlayerInventory[playerid][inv_slot][invItem]) <= 0) return 0;
    if(PlayerInventory[playerid][inv_slot][invID] <= 0) return 0;

    Inv_EnsureAccessoryRow(playerid, inv_slot);
    return Inv_ApplyAccessoryFromSlot(playerid, inv_slot);
}

stock Inv_RefreshAllWornAttachments(playerid)
{
    return Inv_ApplySingleWornAccessory(playerid);
}

stock RemoveAccObject(playerid, inv_id) {
    for(new i = 0; i < 10; i++) {
        if(IsPlayerAttachedObjectSlotUsed(playerid, i)) {
            RemovePlayerAttachedObject(playerid, i);
        }
    }
}
// ----- end: bussines_clothing.inc -----

