    #define GIBDD_PLATE_REROLL_PRICE (2000)
#endif
#if !defined GIBDD_USE_RADIUS
    #define GIBDD_USE_RADIUS    (4.0)
#endif

// ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜/˜˜˜˜˜ ˜˜ Black Russia (@mrsamkert).
// ˜˜˜˜˜˜˜˜: INT=1, ˜˜ 0 ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜.
// ˜˜˜˜˜˜˜˜˜˜˜˜ ˜ laird.pwn:6696 (˜˜˜˜˜ ˜˜˜˜˜ -1111.02, 1522.76, 1499.94, int=1).
// VW=1 ˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜ (˜ laird ˜˜˜ 101/102/103 ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜).
#define GIBDD_BRANCH_YUZHNY     (0)
#define GIBDD_BRANCH_NIZHNY     (1)
#define MAX_GIBDD_BRANCHES      (2)

#define GIBDD_INTERIOR_ID       (1)
#define GIBDD_VW_YUZHNY         (BR_VW_YUZHNY)
#define GIBDD_VW_NIZHNY         (BR_VW_NIZHNY)
#define GIBDD_GUI_ID            (1)

forward Player_FixInteriorWorldLeak(playerid);

stock Gibdd_GetBranchVW(branch)
{
    if(branch == GIBDD_BRANCH_NIZHNY) return GIBDD_VW_NIZHNY;
    return GIBDD_VW_YUZHNY;
}

new const Float:GibddOutsidePos[MAX_GIBDD_BRANCHES][4] =
{
    {1907.4130, -2231.2968, 11.6374, 359.7351},
    {-1991.4552, 2650.3134, 58.6910, 155.5191}
};

new const GibddBranchCityName[MAX_GIBDD_BRANCHES][20] =
{
    "˜˜˜˜˜",
    "˜˜˜˜˜˜˜˜˜˜˜"
};
new const Float:GibddEnterSpawn[4]  = {-1111.0233, 1522.7573, 1499.9459, 180.0};  // ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜
new const Float:GibddInsideSpawn[4] = {-1111.0108, 1525.7037, 1499.9459, 0.0};    // EXIT pickup (˜˜˜˜˜ ˜˜ ˜˜˜˜˜)
// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ (int=1, vw=1).
// ˜˜˜ ˜˜˜ ˜˜˜˜˜ ˜˜˜˜, ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜.
new const Float:GibddDeskPos[4]     = {-1109.0076, 1510.8000, 1499.9859, 228.7618};
// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜˜˜, ˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜
// ˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜. 1.0 ˜ ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ BR.
#if !defined GIBDD_DESK_CP_RADIUS
    #define GIBDD_DESK_CP_RADIUS (1.0)
#endif

// ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (˜˜˜ ˜˜˜˜˜˜˜ /commands ˜ ˜˜˜˜˜˜˜˜˜˜˜). ˜˜˜˜˜˜ ˜ CEF GUI ˜˜˜˜˜˜
// ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜, ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ (/coord, ˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜.˜.).
new const GibddRegionName[4][16] = {
    {"˜˜˜-˜˜˜˜˜˜"},   // RUS
    {"˜˜˜-˜˜˜˜˜˜"},   // UA
    {"˜˜˜-˜˜˜˜˜˜˜˜"}, // BY
    {"Country"}       // KZ
};
#pragma unused GibddRegionName

new STREAMER_TAG_PICKUP:gGibddEnterPickup[MAX_GIBDD_BRANCHES];
new STREAMER_TAG_PICKUP:gGibddExitPickup[MAX_GIBDD_BRANCHES];
// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ DynamicCP (˜˜ Pickup):
//  ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ (˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜),
//  ˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ 100˜˜ (˜˜˜ pickup type 23),
//  ˜ ˜˜ ˜˜˜˜˜˜ Black Russia ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ CP ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ (Y/tap) ˜ ˜˜ ˜˜˜˜˜
//    ˜˜˜˜ OnPlayerEnterDynamicCP, ˜˜˜˜ ˜˜˜˜˜˜˜ KEY_SECONDARY_ATTACK / RPC 97 (˜˜. ˜˜˜˜).
new STREAMER_TAG_CP:gGibddDeskCP[MAX_GIBDD_BRANCHES];

new STREAMER_TAG_3D_TEXT_LABEL:gGibddEnterLabel[MAX_GIBDD_BRANCHES];
new STREAMER_TAG_3D_TEXT_LABEL:gGibddExitLabel[MAX_GIBDD_BRANCHES];
new STREAMER_TAG_3D_TEXT_LABEL:gGibddDeskLabel[MAX_GIBDD_BRANCHES];

new g_GibddPlayerBranch[MAX_PLAYERS] = {-1, ...};

new g_PlatePreview[MAX_PLAYERS][4][16];
new g_RegionPreview[MAX_PLAYERS][4][8];
new g_GibddSelectedRegion[MAX_PLAYERS];

// ˜˜˜˜-˜˜˜˜ ˜˜˜˜˜˜˜: pickup type 23 ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜, ˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜.
// ˜˜˜˜˜˜˜ ˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ (Enter/Exit), ˜ ˜˜˜ Desk ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜GUI ˜˜˜˜˜˜.
new g_GibddLastEnter[MAX_PLAYERS];
new g_GibddLastExit[MAX_PLAYERS];

// ˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ Plates GUI˜. ˜˜˜˜ ˜˜ true ˜ desk pickup ˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ o:1,
// ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜-˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜, ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜.
new bool:g_GibddGuiOpen[MAX_PLAYERS];

#if !defined GIBDD_PICKUP_CD_MS
    #define GIBDD_PICKUP_CD_MS (3000)
#endif

stock GibddInit()
{
    new label[256];

    for(new branch; branch < MAX_GIBDD_BRANCHES; branch++)
    {
        new vw = Gibdd_GetBranchVW(branch);

        gGibddEnterPickup[branch] = CreateDynamicPickup(1318, 23,
            GibddOutsidePos[branch][0], GibddOutsidePos[branch][1], GibddOutsidePos[branch][2], 0, 0);

        format(label, sizeof label, "{E0584B}˜˜˜˜˜  |  ˜. %s", GibddBranchCityName[branch]);
        gGibddEnterLabel[branch] = CreateDynamic3DTextLabel(label, 0xFFFFFFFF,
            GibddOutsidePos[branch][0], GibddOutsidePos[branch][1], GibddOutsidePos[branch][2] + 0.7,
            20.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);

        gGibddDeskCP[branch] = CreateDynamicCP(
            GibddDeskPos[0], GibddDeskPos[1], GibddDeskPos[2],
            GIBDD_DESK_CP_RADIUS,
            vw, GIBDD_INTERIOR_ID, -1, 80.0);

        format(label, sizeof label,
            "{E0584B}˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜\n"\
            "{FFFFFF}˜. %s\n"\
            "{AAAAAA}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜\n"\
            "{AAAAAA}˜˜˜˜˜˜˜˜˜: {00CC00}%d ˜˜˜",
            GibddBranchCityName[branch], GIBDD_PLATE_PRICE);
        gGibddDeskLabel[branch] = CreateDynamic3DTextLabel(label, 0xFFFFFFFF,
            GibddDeskPos[0], GibddDeskPos[1], GibddDeskPos[2] + 0.9,
            12.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, vw, GIBDD_INTERIOR_ID);

        gGibddExitPickup[branch] = CreateDynamicPickup(1318, 23,
            GibddInsideSpawn[0], GibddInsideSpawn[1], GibddInsideSpawn[2],
            vw, GIBDD_INTERIOR_ID);

        gGibddExitLabel[branch] = CreateDynamic3DTextLabel(
            "{E0584B}˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜",
            0xFFFFFFFF,
            GibddInsideSpawn[0], GibddInsideSpawn[1], GibddInsideSpawn[2] + 0.7,
            18.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, vw, GIBDD_INTERIOR_ID);
    }

    #pragma unused gGibddEnterLabel, gGibddDeskLabel, gGibddExitLabel
    return 1;
}

stock GibddResetPlayer(playerid)
{
    for(new c = 0; c < 4; c++)
    {
        g_PlatePreview[playerid][c][0] = '\0';
        g_RegionPreview[playerid][c][0] = '\0';
    }
    g_GibddSelectedRegion[playerid] = -1;
    g_GibddGuiOpen[playerid] = false;
    g_GibddLastEnter[playerid] = 0;
    g_GibddLastExit[playerid] = 0;
    g_GibddPlayerBranch[playerid] = -1;
    if(GetPlayerInterior(playerid) != GIBDD_INTERIOR_ID)
    {
        new vw = GetPlayerVirtualWorld(playerid);
        if(vw == GIBDD_VW_YUZHNY || vw == GIBDD_VW_NIZHNY)
            SetPlayerVirtualWorld(playerid, 0);
    }
}

// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜. ˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜
// (˜˜. java-newbr/.../br_platebuy.xml):
//   ˜ RU/KZ -> fontFamily=@font/plate     ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜  (a,b,c,e,h,k,m,o,p,t,x,y)
//   ˜ UA/BY -> fontFamily=@font/ua_font   ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (A,B,C,E,H,K,M,O,P,T,X,Y)
// ˜˜˜˜˜˜˜ RU/KZ -> lower[], UA/BY -> upper[]. ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜
// ˜˜˜ ˜˜˜˜˜˜ (˜˜˜ ˜˜˜˜: RU/KZ -> ˜˜˜˜˜, BY ˜˜˜˜˜˜˜, ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜˜).
//
// ˜˜˜˜˜ ˜˜ layout-˜: maxLength ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜:
//   RU = 6, UA = 10 (˜ ˜˜˜˜˜˜˜˜˜ ˜AA 0000 AA˜), BY = 9 (˜8359 HA-6˜), KZ = 6.
stock RandomNumberPlate(country, plate[], size = 16)
{
    static const upper[12][2] = {"A","B","C","E","H","K","M","O","P","T","X","Y"};
    static const lower[12][2] = {"a","b","c","e","h","k","m","o","p","t","x","y"};

    plate[0] = '\0';
    switch(country)
    {
        // RUS (0):  ˜a123bc˜  ˜ 1 ˜˜˜˜˜ + 3 ˜˜˜˜˜ + 2 ˜˜˜˜˜, ˜˜˜ ˜˜˜˜˜˜˜˜, lowercase.
        // maxLength=6 ˜ @id/br_plate_et_ru ˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜, ˜˜˜˜˜ plate ˜˜˜˜ ˜˜˜˜˜˜ lower.
        case 0:
        {
            format(plate, size, "%s%d%d%d%s%s",
                lower[random(12)], random(10), random(10), random(10),
                lower[random(12)], lower[random(12)]);
        }
        // UA (1):  ˜AA 0000 AA˜ ˜ 2 ˜˜˜˜˜ + ˜˜˜˜˜˜ + 4 ˜˜˜˜˜ + ˜˜˜˜˜˜ + 2 ˜˜˜˜˜. uppercase.
        // maxLength=10 (br_plate_et_ua), fontFamily=ua_font.
        case 1:
        {
            format(plate, size, "%s%s %d%d%d%d %s%s",
                upper[random(12)], upper[random(12)],
                random(10), random(10), random(10), random(10),
                upper[random(12)], upper[random(12)]);
        }
        // BY (2):  ˜0000 AB-1˜  ˜ 4 ˜˜˜˜˜ + ˜˜˜˜˜˜ + 2 ˜˜˜˜˜ + ˜˜˜˜˜ + 1 ˜˜˜˜˜ (1˜7). uppercase.
        // maxLength=9 (br_plate_et_by), fontFamily=ua_font.
        case 2:
        {
            format(plate, size, "%d%d%d%d %s%s-%d",
                random(10), random(10), random(10), random(10),
                upper[random(12)], upper[random(12)], random(7) + 1);
        }
        // KZ (3):  ˜345abc˜  ˜ 3 ˜˜˜˜˜ + 3 ˜˜˜˜˜. ˜˜˜ ˜˜˜˜˜˜˜˜, lowercase. ˜˜˜˜˜˜ 01..17 ˜˜˜˜˜˜˜˜
        // ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ (br_plate_reg_kz_et, ua_font). maxLength=6 (br_plate_et_kz), font=plate.
        case 3:
        {
            format(plate, size, "%d%d%d%s%s%s",
                random(10), random(10), random(10),
                lower[random(12)], lower[random(12)], lower[random(12)]);
        }
    }
    return 1;
}

// ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜, ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.
// ˜˜˜˜˜˜˜ "TT" ˜˜ ˜˜˜˜˜˜˜˜˜: ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜.
stock RandomNumberRegion(country, region[], size = 8)
{
    static const upper[12][2] = {"A","B","C","E","H","K","M","O","P","T","X","Y"};
    region[0] = '\0';

    switch(country)
    {
        // RUS ˜ 01..99 (˜˜˜˜˜˜˜˜˜˜, ˜˜˜ 100+; ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜
        // ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜ ˜˜˜˜˜˜˜, ˜˜-˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ "069OCK 136").
        case 0:
        {
            new num = random(99) + 1;
            format(region, size, "%02d", num);
        }
        // UA ˜ 2 ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ (˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜, AA, BC, KX ˜ ˜.˜.)
        case 1:
        {
            format(region, size, "%s%s", upper[random(12)], upper[random(12)]);
        }
        // BY ˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ("˜AB-1"), ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜. ˜˜˜ "BY"
        // ˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ (˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜).
        case 2:
        {
            format(region, size, "BY");
        }
        // KZ ˜ 01..17 (˜˜ ˜˜˜˜˜˜˜˜).
        case 3:
        {
            new num = random(17) + 1;
            format(region, size, "%02d", num);
        }
    }
    return 1;
}

// =============================================================================
// ˜˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.
// ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ (˜˜˜˜˜˜˜˜, KZ
// ˜ ˜˜˜˜˜˜˜˜ ˜136˜ ˜˜˜ ˜069OCK˜ ˜ RUS-˜˜˜˜˜). ˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜
// ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ RandomNumberPlate/RandomNumberRegion.
// =============================================================================
stock bool:Gibdd_IsValidPlate(country, const plate[])
{
    new len = strlen(plate);
    switch(country)
    {
        // RUS ˜a123bc˜ ˜ 6 chars: letter+digit+digit+digit+letter+letter
        case 0:
        {
            if(len != 6) return false;
            if(!((plate[0] >= 'a' && plate[0] <= 'z') || (plate[0] >= 'A' && plate[0] <= 'Z'))) return false;
            for(new i = 1; i <= 3; i++)
                if(plate[i] < '0' || plate[i] > '9') return false;
            for(new i = 4; i <= 5; i++)
                if(!((plate[i] >= 'a' && plate[i] <= 'z') || (plate[i] >= 'A' && plate[i] <= 'Z'))) return false;
            return true;
        }
        // UA ˜AA 0000 AA˜ ˜ 10 chars: 2 letters + space + 4 digits + space + 2 letters
        case 1:
        {
            if(len != 10) return false;
            if(plate[2] != ' ' || plate[7] != ' ') return false;
            return true;
        }
        // BY ˜0000 AB-1˜ ˜ 9 chars: 4 digits + space + 2 letters + dash + 1 digit
        case 2:
        {
            if(len != 9) return false;
            if(plate[4] != ' ' || plate[7] != '-') return false;
            for(new i = 0; i <= 3; i++)
                if(plate[i] < '0' || plate[i] > '9') return false;
            if(plate[8] < '1' || plate[8] > '7') return false;
            return true;
        }
        // KZ ˜345abc˜ ˜ 6 chars: 3 digits + 3 letters
        case 3:
        {
            if(len != 6) return false;
            for(new i = 0; i <= 2; i++)
                if(plate[i] < '0' || plate[i] > '9') return false;
            for(new i = 3; i <= 5; i++)
                if(!((plate[i] >= 'a' && plate[i] <= 'z') || (plate[i] >= 'A' && plate[i] <= 'Z'))) return false;
            return true;
        }
    }
    return false;
}

stock bool:Gibdd_IsValidRegion(country, const region[])
{
    new len = strlen(region);
    switch(country)
    {
        // RUS ˜01..99˜ ˜ 2 digits
        case 0:
        {
            if(len != 2) return false;
            if(region[0] < '0' || region[0] > '9') return false;
            if(region[1] < '0' || region[1] > '9') return false;
            new v = (region[0] - '0') * 10 + (region[1] - '0');
            return (v >= 1 && v <= 99);
        }
        // UA ˜ 2 letters
        case 1:
        {
            if(len != 2) return false;
            for(new i = 0; i < 2; i++)
                if(!((region[i] >= 'a' && region[i] <= 'z') || (region[i] >= 'A' && region[i] <= 'Z'))) return false;
            return true;
        }
        // BY ˜ ˜˜˜˜˜˜˜ "BY" (˜˜˜˜˜ ˜˜˜˜˜˜)
        case 2: return (strcmp(region, "BY", true) == 0);
        // KZ ˜01..17˜ ˜ 2 digits
        case 3:
        {
            if(len != 2) return false;
            if(region[0] < '0' || region[0] > '9') return false;
            if(region[1] < '0' || region[1] > '9') return false;
            new v = (region[0] - '0') * 10 + (region[1] - '0');
            return (v >= 1 && v <= 17);
        }
    }
    return false;
}

// ˜˜˜˜ plate/region ˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ true.
// ˜˜˜˜˜˜˜˜˜˜ true, ˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.
stock bool:Gibdd_RepairPlate(country, plate[], plate_size, region[], region_size)
{
    new bool:changed = false;
    if(!Gibdd_IsValidPlate(country, plate))
    {
        RandomNumberPlate(country, plate, plate_size);
        changed = true;
    }
    if(!Gibdd_IsValidRegion(country, region))
    {
        RandomNumberRegion(country, region, region_size);
        changed = true;
    }
    return changed;
}

// ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.
// RU/KZ (font/plate) ˜ ˜˜˜˜˜˜ lowercase; UA/BY (font/ua_font) ˜ ˜˜˜˜˜˜ uppercase.
// ˜˜˜˜˜, ˜˜˜˜˜˜˜, ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜.
stock Gibdd_NormalizePlateText(country, text[])
{
    new bool:lower = (country == 0 || country == 3);
    for(new i = 0; text[i] != '\0'; i++)
    {
        if(text[i] >= 'A' && text[i] <= 'Z' &&  lower) text[i] = text[i] + ('a' - 'A');
        if(text[i] >= 'a' && text[i] <= 'z' && !lower) text[i] = text[i] - ('a' - 'A');
    }
    return 1;
}

stock SetVehicleNumberPlateForPlayer(playerid, vehicleid, type, const number[], const region[])
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, 7);
    BS_WriteValue(bitstream, PR_UINT16, vehicleid);
    BS_WriteValue(bitstream, PR_UINT8, type);
    BS_WriteValue(bitstream, PR_UINT8, strlen(number));
    BS_WriteValue(bitstream, PR_STRING, number);
    BS_WriteValue(bitstream, PR_UINT8, strlen(region));
    BS_WriteValue(bitstream, PR_STRING, region);

    PR_SendRPC(bitstream, playerid, 168, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bitstream);
    return 1;
}

stock bool:Vehicle_HasInstalledPlate(ownerid, slot)
{
    if(ownerid < 0 || ownerid >= MAX_PLAYERS) return false;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return false;
    return (VehicleInfo[ownerid][slot][vPlateType] > 0 &&
            strlen(VehicleInfo[ownerid][slot][vPlateNumber]) > 0);
}

stock SetVehicleNumberPlateEx(vehicleid, type, const number[], const region[])
{
    // type 1..4  ->  country 0..3  (˜˜. PlateRPCType ˜ inventory.inc).
    // ˜˜˜˜ type 0 (˜˜˜˜˜˜˜˜˜) ˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜, ˜˜˜ ˜˜˜ ˜˜˜˜.
    new country = (type >= 1 && type <= 4) ? (type - 1) : -1;

    new norm_number[16], norm_region[8];
    format(norm_number, sizeof norm_number, "%s", number);
    format(norm_region, sizeof norm_region, "%s", region);
    if(country >= 0)
    {
        Gibdd_NormalizePlateText(country, norm_number);
        Gibdd_NormalizePlateText(country, norm_region);
    }

    for(new owner = 0; owner < MAX_PLAYERS; owner++)
    {
        for(new slot = 0; slot < MAX_PLAYER_VEHICLES; slot++)
        {
            if(VehicleInfo[owner][slot][vSpawned] && VehicleInfo[owner][slot][vID] == vehicleid)
            {
                VehicleInfo[owner][slot][vPlateType] = type;
                format(VehicleInfo[owner][slot][vPlateNumber], 16, "%s", norm_number);
                format(VehicleInfo[owner][slot][vPlateRegion], 8, "%s", norm_region);
                break;
            }
        }
    }

    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        SetVehicleNumberPlateForPlayer(i, vehicleid, type, norm_number, norm_region);
    }
    return 1;
}

stock Gibdd_RemoveVehiclePlate(ownerid, slot)
{
    if(ownerid < 0 || ownerid >= MAX_PLAYERS) return 0;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(!VehicleInfo[ownerid][slot][vSpawned]) return 0;
    if(VehicleInfo[ownerid][slot][vID] == INVALID_VEHICLE_ID) return 0;

    new vehicleid = VehicleInfo[ownerid][slot][vID];

    VehicleInfo[ownerid][slot][vPlateType] = 0;
    VehicleInfo[ownerid][slot][vPlateNumber][0] = '\0';
    VehicleInfo[ownerid][slot][vPlateRegion][0] = '\0';

    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        SetVehicleNumberPlateForPlayer(i, vehicleid, 0, "XYZ", "");
    }

    if(VehicleInfo[ownerid][slot][vDBID] > 0)
    {
        new query[256];
        mysql_format(db_handle, query, sizeof(query),
            "UPDATE `ownable_cars` SET `plate_type`=0, `plate_number`='', `plate_region`='' WHERE `id`=%d LIMIT 1",
            VehicleInfo[ownerid][slot][vDBID]);
        mysql_tquery(db_handle, query, "", "");
    }
    return 1;
}

// ============================================================================
// CEF GUI 1 (Plates) ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜
// ============================================================================

// ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜, ˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜.
stock Gibdd_EnsurePreview(playerid, country)
{
    if(country < 0 || country > 3) return 0;
    if(strlen(g_PlatePreview[playerid][country]) == 0)
    {
        RandomNumberPlate(country, g_PlatePreview[playerid][country]);
        RandomNumberRegion(country, g_RegionPreview[playerid][country]);
    }
    return 1;
}

// Server -> Client | t=0 + "o":1 ˜ ˜˜˜˜˜˜˜˜˜ CEF GUI 1 (Plates) ˜ ˜˜˜ ˜˜˜˜.
// ˜˜˜˜˜: ˜˜˜˜ "c" ˜ Black Russia RPC ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜ CLOSE-˜˜˜˜ ˜˜˜ value=1
//   (˜ laird HidePlayerGUI ˜˜˜ {"c":1}). ˜˜˜˜˜˜˜ ˜ t=0 ˜˜˜ c=0 (˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜),
//   ˜ ˜ t=1/t=2 ˜˜˜˜ "c" ˜˜ ˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.
stock GibddSendPrices(playerid)
{
    new Node:json = JSON_Object();
    JSON_SetInt(json, "o", 1);
    JSON_SetInt(json, "t", 0);
    JSON_SetInt(json, "p",  GIBDD_PLATE_PRICE);
    JSON_SetInt(json, "pr", GIBDD_PLATE_REROLL_PRICE);
    JSON_SetInt(json, "c",  0);
    OnPacketIncoming(playerid, GIBDD_GUI_ID, json);
    JSON_Cleanup(json);
    return 1;
}

// Server -> Client | t=2: ˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜. "c" ˜˜ ˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ GUI.
stock GibddSendPreview(playerid, country)
{
    if(country < 0 || country > 3) return 0;
    Gibdd_EnsurePreview(playerid, country);

    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 2);
    JSON_SetString(json, "p", g_PlatePreview[playerid][country]);
    JSON_SetString(json, "r", g_RegionPreview[playerid][country]);
    OnPacketIncoming(playerid, GIBDD_GUI_ID, json);
    JSON_Cleanup(json);
    return 1;
}

// Server -> Client | t=1: ˜˜˜˜˜˜˜˜˜/˜˜˜˜˜˜˜˜˜. "c" ˜˜ ˜˜˜.
stock GibddSendHint(playerid, text[])
{
    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 1);
    JSON_SetString(json, "h", text, strlen(text));
    OnPacketIncoming(playerid, GIBDD_GUI_ID, json);
    JSON_Cleanup(json);
    return 1;
}

// ˜˜˜˜˜˜˜ CEF GUI 1 (Plates) ˜ ˜˜˜˜˜˜. Black Russia client.
// ˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ o:1 ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜
// ˜˜˜˜-˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ Plates-˜˜˜˜˜˜˜˜ (initCurrencyType) ˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.
stock OpenGibddRegistrationGUI(playerid)
{
    if(g_GibddGuiOpen[playerid]) return 1; // ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜

    g_GibddSelectedRegion[playerid] = 0;
    Gibdd_EnsurePreview(playerid, 0);

    g_GibddGuiOpen[playerid] = true;
    GibddSendPrices(playerid);        // t=0 + "o":1 ˜ ˜˜˜˜˜˜˜˜˜ GUI, ˜˜˜ ˜˜˜˜
    GibddSendPreview(playerid, 0);    // t=2 ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜ (˜˜˜ c-key, ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜)
    return 1;
}

// ˜˜˜˜˜˜˜ GUI Plates ˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜ GUI ˜˜˜˜˜˜˜ Exit.
stock CloseGibddRegistrationGUI(playerid)
{
    g_GibddGuiOpen[playerid] = false;
    new Node:json = JSON_Object();
    JSON_SetInt(json, "c", 1);        // CLOSE flag
    OnPacketIncoming(playerid, GIBDD_GUI_ID, json);
    JSON_Cleanup(json);
    return 1;
}

// ˜˜˜˜˜˜˜˜˜˜ ˜˜ ipacket.inc case 1 / t=0 ˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ GUI ˜˜˜˜˜˜˜ Exit.
stock Gibdd_OnGuiClosedByClient(playerid)
{
    g_GibddGuiOpen[playerid] = false;
    return 1;
}

// ============================================================================
// ˜˜˜˜˜˜˜˜˜
// ============================================================================

stock GibddTeleportInside(playerid, branch)
{
    if(branch < 0 || branch >= MAX_GIBDD_BRANCHES) return 0;

    new vw = Gibdd_GetBranchVW(branch);
    g_GibddPlayerBranch[playerid] = branch;

    SetPlayerVirtualWorld(playerid, vw);
    SetPlayerInterior(playerid, GIBDD_INTERIOR_ID);
    SetPlayerPos(playerid, GibddEnterSpawn[0], GibddEnterSpawn[1], GibddEnterSpawn[2]);
    SetPlayerFacingAngle(playerid, GibddEnterSpawn[3]);
    Streamer_UpdateEx(playerid, GibddEnterSpawn[0], GibddEnterSpawn[1], GibddEnterSpawn[2],
        vw, GIBDD_INTERIOR_ID);
    SetCameraBehindPlayer(playerid);

    new msg[96];
    format(msg, sizeof msg, "˜˜˜˜˜ ˜. %s ˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜", GibddBranchCityName[branch]);
    ShowNotification(playerid, 3, 5, 0, 1, msg, "");
    return 1;
}

stock GibddTeleportOutside(playerid)
{
    new branch = g_GibddPlayerBranch[playerid];
    if(branch < 0 || branch >= MAX_GIBDD_BRANCHES) branch = GIBDD_BRANCH_YUZHNY;

    SetPlayerVirtualWorld(playerid, 0);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, GibddOutsidePos[branch][0], GibddOutsidePos[branch][1], GibddOutsidePos[branch][2] + 0.3);
    SetPlayerFacingAngle(playerid, GibddOutsidePos[branch][3]);
    Streamer_UpdateEx(playerid, GibddOutsidePos[branch][0], GibddOutsidePos[branch][1], GibddOutsidePos[branch][2], 0, 0);
    SetCameraBehindPlayer(playerid);
    g_GibddPlayerBranch[playerid] = -1;
    if(g_GibddGuiOpen[playerid])
        CloseGibddRegistrationGUI(playerid);
    Player_FixInteriorWorldLeak(playerid);

    new msg[80];
    format(msg, sizeof msg, "˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜ (˜. %s)", GibddBranchCityName[branch]);
    ShowNotification(playerid, 3, 5, 0, 1, msg, "");
    return 1;
}

stock GibddOnPickup(playerid, STREAMER_TAG_PICKUP:pickupid)
{
    new tick = GetTickCount();

    for(new branch; branch < MAX_GIBDD_BRANCHES; branch++)
    {
        if(pickupid == gGibddEnterPickup[branch])
        {
            if(tick - g_GibddLastEnter[playerid] < GIBDD_PICKUP_CD_MS) return 1;
            g_GibddLastEnter[playerid] = tick;
            g_GibddLastExit[playerid]  = tick;
            return GibddTeleportInside(playerid, branch);
        }

        if(pickupid == gGibddExitPickup[branch])
        {
            if(tick - g_GibddLastExit[playerid] < GIBDD_PICKUP_CD_MS) return 1;
            g_GibddLastExit[playerid]  = tick;
            g_GibddLastEnter[playerid] = tick;
            g_GibddGuiOpen[playerid] = false;
            return GibddTeleportOutside(playerid);
        }
    }
    return 0;
}

// ˜˜˜˜˜ ˜˜˜˜˜ ˜˜ OnPlayerEnterDynamicCP ˜ ˜˜˜˜˜˜˜˜˜ Plates GUI ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜
// ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜. ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜/˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜.
stock Gibdd_GetPlayerBranch(playerid)
{
    if(!IsPlayerConnected(playerid)) return -1;
    if(GetPlayerInterior(playerid) != GIBDD_INTERIOR_ID) return -1;

    new vw = GetPlayerVirtualWorld(playerid);
    for(new branch; branch < MAX_GIBDD_BRANCHES; branch++)
    {
        if(vw == Gibdd_GetBranchVW(branch)) return branch;
    }
    return -1;
}

stock bool:Player_IsInValidInteriorWorld(playerid)
{
	new vw = GetPlayerVirtualWorld(playerid);
	new interior = GetPlayerInterior(playerid);

	if(vw == 0 && interior == 0)
		return true;

	if(vw >= HOUSE_INTERIOR_VW_BASE && vw < HOUSE_INTERIOR_VW_BASE + TotalHouses)
	{
		new hid = vw - HOUSE_INTERIOR_VW_BASE;
		if(hid >= 0 && hid < TotalHouses)
		{
			new t = HouseInfo[hid][hType];
			if(t < 0 || t >= MAX_HOUSE_TYPES) t = 0;
			if(interior == HouseInteriors[t][iInt])
				return true;
		}
	}

	if(GetPVarType(playerid, "InHouseID"))
	{
		new hid = GetPVarInt(playerid, "InHouseID");
		if(hid >= 0 && hid < TotalHouses && vw == House_GetInteriorVW(hid))
		{
			new t = HouseInfo[hid][hType];
			if(t < 0 || t >= MAX_HOUSE_TYPES) t = 0;
			if(interior == HouseInteriors[t][iInt])
				return true;
		}
	}

	if(Bank_GetPlayerBranch(playerid) != -1)
		return true;

	if(Gibdd_GetPlayerBranch(playerid) != -1)
		return true;

	if(Hospital_IsPlayerInside(playerid))
		return true;

	if(GetPVarInt(playerid, "HospitalDeathRespawn") || g_HospitalDeathPending[playerid])
	{
		if(Hospital_IsAtInteriorCoords(playerid))
			return true;
	}

	new in_biz = GetPlayerInBiz(playerid);
	if(in_biz != -1 && Biz_IsPlayerInside(playerid, in_biz))
		return true;

	if(Shop_IsInShop(playerid))
		return true;

	if(MinerJob_IsInMineGreenZone(playerid))
		return true;

	if(vw == playerid + 1 || vw == playerid + 2000)
		return true;

	return false;
}

stock Player_FixInteriorWorldLeak(playerid)
{
	if(!IsPlayerConnected(playerid))
		return 0;
	if(Player_IsInValidInteriorWorld(playerid))
		return 0;

	// ˜˜˜: ˜˜ ˜˜˜˜˜˜˜˜˜˜ interior/vw ˜ 0 ˜ ˜˜˜˜˜ void (˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ int=0).
	if(GetPVarType(playerid, "InHouseID"))
	{
		new hid = GetPVarInt(playerid, "InHouseID");
		if(hid >= 0 && hid < TotalHouses)
		{
			new t = HouseInfo[hid][hType];
			if(t < 0 || t >= MAX_HOUSE_TYPES) t = 0;
			new need_int = HouseInteriors[t][iInt];
			new need_vw = House_GetInteriorVW(hid);
			if(GetPlayerInterior(playerid) != need_int || GetPlayerVirtualWorld(playerid) != need_vw)
			{
				new Float:spx, Float:spy, Float:spz, Float:spa;
				House_GetInteriorSpawnPos(hid, spx, spy, spz, spa);
				SetPlayerPos(playerid, spx, spy, spz);
				SetPlayerFacingAngle(playerid, spa);
				SetPlayerInterior(playerid, need_int);
				SetPlayerVirtualWorld(playerid, need_vw);
				House_StreamerRefreshInterior(playerid, hid);
				return 0;
			}
		}
	}

	HideInteractionWindow(playerid);
	if(g_GibddGuiOpen[playerid])
		CloseGibddRegistrationGUI(playerid);
	GibddResetPlayer(playerid);
	Hospital_ResetPlayer(playerid);
	g_BankPlayerBranch[playerid] = -1;
	Bank_AtmProxStop(playerid);
	Shop247_OnExitBiz(playerid);
	SetPlayerInBiz(playerid, -1);

	if(GetPlayerVirtualWorld(playerid) != 0)
		SetPlayerVirtualWorld(playerid, 0);
	if(GetPlayerInterior(playerid) != 0)
		SetPlayerInterior(playerid, 0);
	return 1;
}

stock bool:Gibdd_OnEnterCP(playerid, STREAMER_TAG_CP:checkpointid)
{
    new branch = Gibdd_GetPlayerBranch(playerid);
    if(branch < 0 || branch >= MAX_GIBDD_BRANCHES) return false;
    if(checkpointid != gGibddDeskCP[branch]) return false;
    if(GetPlayerInterior(playerid) != GIBDD_INTERIOR_ID) return true;

    if(g_GibddGuiOpen[playerid]) return true;
    g_GibddPlayerBranch[playerid] = branch;
    OpenGibddRegistrationGUI(playerid);
    return true;
}

stock bool:Gibdd_IsNearDesk(playerid)
{
    new branch = Gibdd_GetPlayerBranch(playerid);
    if(branch < 0) return false;
    if(GetPlayerInterior(playerid) != GIBDD_INTERIOR_ID) return false;
    return bool:(IsPlayerInRangeOfPoint(playerid, GIBDD_DESK_CP_RADIUS + 0.5,
        GibddDeskPos[0], GibddDeskPos[1], GibddDeskPos[2]));
}

// ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ click-˜ (RPC 97 ˜˜ ˜˜˜˜˜˜˜ BR). ˜˜˜˜˜˜˜˜˜˜ ˜˜
// OnIncomingRPC ˜ death.pwn ˜˜˜˜˜ ˜˜˜˜, ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ action. ˜˜˜˜˜˜˜˜˜˜ true,
// ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜.
stock bool:Gibdd_OnClickRPC(playerid)
{
    if(!Gibdd_IsNearDesk(playerid)) return false;
    if(g_GibddGuiOpen[playerid]) return true;
    OpenGibddRegistrationGUI(playerid);
    return true;
}

// ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ (DIALOG_GIBDD_* ˜˜˜˜˜˜˜ ˜ CEF GUI ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜).
stock bool:Gibdd_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    #pragma unused playerid, dialogid, response, listitem, inputtext
    return false;
}

// ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜. ˜˜˜ GUI ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜
// ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ (Gibdd_OnEnterCP) ˜˜˜ ˜˜˜˜˜˜˜ click-RPC ˜˜˜˜˜ ˜ ˜˜˜
// (Gibdd_OnClickRPC). ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜.
stock Gibdd_TryCommandOpen(playerid)
{
    if(Gibdd_IsNearDesk(playerid))
    {
        OpenGibddRegistrationGUI(playerid);
        return 1;
    }
    ShowNotification(playerid, 0, 5, 0, 0,
        "˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ (˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜).", "");
    return 1;
}

CMD:plates(playerid)
{
    return Gibdd_TryCommandOpen(playerid);
}

CMD:gibdd(playerid)
{
    return Gibdd_TryCommandOpen(playerid);
