                    if(!VehicleInfo[playerid][vcol][vSpawned] || VehicleInfo[playerid][vcol][vID] != vehicleid_col) continue;
                    Tune_ResetWheelCollapseFields(playerid, vcol);
                    new qcol[320];
                    if(Tune_ResetWheelCollapseDb(VehicleInfo[playerid][vcol][vDBID], qcol, sizeof qcol))
                        mysql_tquery(db_handle, qcol);
