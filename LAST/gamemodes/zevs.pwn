stock SavePlayerEstate(playerid)
{
    if(Player[playerid][pID] == 0) return 0;

    // Keep house ownership label synced with current account name.
    new house_query[160];
    mysql_format(db_handle, house_query, sizeof(house_query),
        "UPDATE `houses` SET `owner_name`='%e' WHERE `owner_id`=%d",
        Player[playerid][pName], Player[playerid][pID]);
    mysql_tquery(db_handle, house_query, "", "");

    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
    {
        if(VehicleInfo[playerid][i][vDBID] == 0) continue;

        if(VehicleInfo[playerid][i][vSpawned] && VehicleInfo[playerid][i][vID] != INVALID_VEHICLE_ID)
        {
            GetVehiclePos(VehicleInfo[playerid][i][vID],
                VehicleInfo[playerid][i][vPos][0],
                VehicleInfo[playerid][i][vPos][1],
                VehicleInfo[playerid][i][vPos][2]);
            GetVehicleZAngle(VehicleInfo[playerid][i][vID], VehicleInfo[playerid][i][vPos][3]);
        }

        // ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜, ˜˜˜˜˜˜˜˜˜ "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜" = ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.
        if(VehicleInfo[playerid][i][vSpawned] && VehicleInfo[playerid][i][vID] != INVALID_VEHICLE_ID)
        {
            VehicleInfo[playerid][i][vLastPos][0] = VehicleInfo[playerid][i][vPos][0];
            VehicleInfo[playerid][i][vLastPos][1] = VehicleInfo[playerid][i][vPos][1];
            VehicleInfo[playerid][i][vLastPos][2] = VehicleInfo[playerid][i][vPos][2];
            VehicleInfo[playerid][i][vLastPos][3] = VehicleInfo[playerid][i][vPos][3];
            VehicleInfo[playerid][i][vLastValid]  = true;

        }

        new car_query[1600];
        mysql_format(db_handle, car_query, sizeof(car_query),
            "UPDATE `ownable_cars` SET \
            `owner_name`='%e', `wheel`=%d, `color1`=%d, `color2`=%d, `x`=%f, `y`=%f, `z`=%f, `a`=%f, \
            `price`=%d, `sport`=%d, `drift`=%d, `comfort`=%d, `sport_plus`=%d, `body_color`=%d, \
            `disk_color`=%d, `wheel_model_id`=%d, `pered_windcolor`=%d, `zadni_windcolor`=%d, \
            `neon_main`=%d, `neon1`=%d, `neon2`=%d, `lights_color`=%d, `strob`=%d, `vinyl`='%e', \
            `nitro`=%d, `dalniysvet`=%d, `clearance`=%f, `clearance_front`=%f, `clearance_rear`=%f, \
            `offset_front`=%f, `offset_rear`=%f, `camber_front`=%f, `camber_rear`=%f, \
            `wheel_width_front`=%f, `wheel_width_rear`=%f, `wheel_radius`=%f, `hydra`=%d, `pnevmo`=%d, \
            `launch_control`=%d, `horn_sound`=%d, `exhaust_sound`=%d, \
            `fuel`=%f, `health`=%f, `mileage`=%f, \
            `plate_type`=%d, `plate_number`='%e', `plate_region`='%e', \
            `auto_engine`=%d, `auto_lock`=%d, \
            `last_x`=%f, `last_y`=%f, `last_z`=%f, `last_a`=%f, `last_valid`=%d \
            WHERE `id`=%d AND `owner_id`=%d",
            Player[playerid][pName], VehicleInfo[playerid][i][vWheel],
            VehicleInfo[playerid][i][vColor][0], VehicleInfo[playerid][i][vColor][1],
            VehicleInfo[playerid][i][vPos][0], VehicleInfo[playerid][i][vPos][1], VehicleInfo[playerid][i][vPos][2], VehicleInfo[playerid][i][vPos][3],
            VehicleInfo[playerid][i][vPrice], VehicleInfo[playerid][i][vSport], VehicleInfo[playerid][i][vDrift], VehicleInfo[playerid][i][vComfort], VehicleInfo[playerid][i][vSportPlus],
            VehicleInfo[playerid][i][vBodyColor], VehicleInfo[playerid][i][vDiskColor], VehicleInfo[playerid][i][vWheelModel],
            VehicleInfo[playerid][i][vWindFront], VehicleInfo[playerid][i][vWindRear], VehicleInfo[playerid][i][vNeonMain], VehicleInfo[playerid][i][vNeon1], VehicleInfo[playerid][i][vNeon2],
            VehicleInfo[playerid][i][vLightsColor], VehicleInfo[playerid][i][vStrob], VehicleInfo[playerid][i][vVinyl], VehicleInfo[playerid][i][vNitro], VehicleInfo[playerid][i][vDalniysvet],
            VehicleInfo[playerid][i][vClearance], VehicleInfo[playerid][i][vClearanceFront], VehicleInfo[playerid][i][vClearanceRear], VehicleInfo[playerid][i][vOffsetFront], VehicleInfo[playerid][i][vOffsetRear],
            VehicleInfo[playerid][i][vCamberFront], VehicleInfo[playerid][i][vCamberRear], VehicleInfo[playerid][i][vWheelWidthFront], VehicleInfo[playerid][i][vWheelWidthRear], VehicleInfo[playerid][i][vWheelRadius],
            VehicleInfo[playerid][i][vHydra], VehicleInfo[playerid][i][vPnevmo],
            VehicleInfo[playerid][i][vLaunchControl],
            VehicleInfo[playerid][i][vHornSound], VehicleInfo[playerid][i][vExhaustSound],
            VehicleInfo[playerid][i][vFuel], VehicleInfo[playerid][i][vHealth], gVehicleMileage[playerid][i],
            VehicleInfo[playerid][i][vPlateType], VehicleInfo[playerid][i][vPlateNumber], VehicleInfo[playerid][i][vPlateRegion],
            (VehicleInfo[playerid][i][vAutoEngine] ? 1 : 0), (VehicleInfo[playerid][i][vAutoLock] ? 1 : 0),
            VehicleInfo[playerid][i][vLastPos][0], VehicleInfo[playerid][i][vLastPos][1], VehicleInfo[playerid][i][vLastPos][2], VehicleInfo[playerid][i][vLastPos][3],
            (VehicleInfo[playerid][i][vLastValid] ? 1 : 0),
            VehicleInfo[playerid][i][vDBID], Player[playerid][pID]
        );
        mysql_tquery(db_handle, car_query, "", "");
    }
    return 1;
}

stock LoadAndAttachAccessories(playerid)
{
    return Inv_TryApplyWornAccessories(playerid);
}

forward LoadPlayerVehicles(playerid);

public LoadPlayerVehicles(playerid)
{
    new rows, fields;
    cache_get_data(rows, fields, db_handle);
    
   	printf("[DEBUG] ˜˜˜˜˜ ˜˜˜˜˜˜˜: %d", rows);

    for(new i = 0; i < MAX_PLAYER_VEHICLES; i++)
        VehicleInfo_ClearSlot(playerid, i, false);

    for(new i = 0; i < rows && i < MAX_PLAYER_VEHICLES; i++)
    {
        VehicleInfo[playerid][i][vDBID] = cache_get_field_content_int(i, "id", db_handle);
        VehicleInfo[playerid][i][vModel] = cache_get_field_content_int(i, "model", db_handle);
        VehicleInfo[playerid][i][vColor][0] = cache_get_field_content_int(i, "color1", db_handle);
        VehicleInfo[playerid][i][vColor][1] = cache_get_field_content_int(i, "color2", db_handle);
        VehicleInfo[playerid][i][vBodyColor] = cache_get_field_content_int(i, "body_color", db_handle);
        VehicleInfo[playerid][i][vDiskColor] = cache_get_field_content_int(i, "disk_color", db_handle);
        VehicleInfo[playerid][i][vWheel] = cache_get_field_content_int(i, "wheel", db_handle);
        VehicleInfo[playerid][i][vWindFront] = cache_get_field_content_int(i, "pered_windcolor", db_handle);
        VehicleInfo[playerid][i][vWindRear] = cache_get_field_content_int(i, "zadni_windcolor", db_handle);
        VehicleInfo[playerid][i][vNeonMain] = cache_get_field_content_int(i, "neon_main", db_handle);
        VehicleInfo[playerid][i][vNeon1] = cache_get_field_content_int(i, "neon1", db_handle);
        VehicleInfo[playerid][i][vNeon2] = cache_get_field_content_int(i, "neon2", db_handle);
        VehicleInfo[playerid][i][vLightsColor] = cache_get_field_content_int(i, "lights_color", db_handle);
        VehicleInfo[playerid][i][vStrob] = cache_get_field_content_int(i, "strob", db_handle);
        if(VehicleInfo[playerid][i][vStrob] == 0) VehicleInfo[playerid][i][vStrob] = 5;

        cache_get_field_content(i, "vinyl", VehicleInfo[playerid][i][vVinyl], db_handle, 32);
        VehicleInfo[playerid][i][vSport] = cache_get_field_content_int(i, "sport", db_handle);
        VehicleInfo[playerid][i][vDrift] = cache_get_field_content_int(i, "drift", db_handle);
        VehicleInfo[playerid][i][vComfort] = cache_get_field_content_int(i, "comfort", db_handle);
        VehicleInfo[playerid][i][vSportPlus] = cache_get_field_content_int(i, "sport_plus", db_handle);
        VehicleInfo[playerid][i][vNitro] = cache_get_field_content_int(i, "nitro", db_handle);
        VehicleInfo[playerid][i][vPos][0] = cache_get_field_content_float(i, "x", db_handle);
        VehicleInfo[playerid][i][vPos][1] = cache_get_field_content_float(i, "y", db_handle);
        VehicleInfo[playerid][i][vPos][2] = cache_get_field_content_float(i, "z", db_handle);
        VehicleInfo[playerid][i][vPos][3] = cache_get_field_content_float(i, "a", db_handle);
        VehicleInfo[playerid][i][vDalniysvet] = cache_get_field_content_int(i, "dalniysvet", db_handle);
        VehicleInfo[playerid][i][vClearance] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "clearance", db_handle));
        VehicleInfo[playerid][i][vClearanceFront] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "clearance_front", db_handle));
        VehicleInfo[playerid][i][vClearanceRear] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "clearance_rear", db_handle));
        Tune_ResetWheelCollapseFields(playerid, i);
        VehicleInfo[playerid][i][vWheelModel] = cache_get_field_content_int(i, "wheel_model_id", db_handle);
        VehicleInfo[playerid][i][vOffsetFront] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "offset_front", db_handle));
        VehicleInfo[playerid][i][vOffsetRear] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "offset_rear", db_handle));
        VehicleInfo[playerid][i][vCamberFront] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "camber_front", db_handle));
        VehicleInfo[playerid][i][vCamberRear] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "camber_rear", db_handle));
        VehicleInfo[playerid][i][vWheelWidthFront] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "wheel_width_front", db_handle));
        VehicleInfo[playerid][i][vWheelWidthRear] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "wheel_width_rear", db_handle));
        VehicleInfo[playerid][i][vWheelRadius] = Tune_NormalizeCollapseStored(cache_get_field_content_float(i, "wheel_radius", db_handle));
        VehicleInfo[playerid][i][vHydra] = cache_get_field_content_int(i, "hydra", db_handle);
        VehicleInfo[playerid][i][vPnevmo] = cache_get_field_content_int(i, "pnevmo", db_handle);
        VehicleInfo[playerid][i][vLaunchControl] = cache_get_field_content_int(i, "launch_control", db_handle);
        VehicleInfo[playerid][i][vLaunchControlOn] = false;
        VehicleInfo[playerid][i][vHornSound] = cache_get_field_content_int(i, "horn_sound", db_handle);
        VehicleInfo[playerid][i][vExhaustSound] = cache_get_field_content_int(i, "exhaust_sound", db_handle);
        if(VehicleInfo[playerid][i][vExhaustSound] < -1) VehicleInfo[playerid][i][vExhaustSound] = -1;
        VehicleInfo[playerid][i][vNeonState] = (VehicleInfo[playerid][i][vNeonMain] != 0 || VehicleInfo[playerid][i][vNeon1] != 0 || VehicleInfo[playerid][i][vNeon2] != 0);

        VehicleInfo[playerid][i][vFuel] = cache_get_field_content_float(i, "fuel", db_handle);
        if(VehicleInfo[playerid][i][vFuel] < 0.0) VehicleInfo[playerid][i][vFuel] = 0.0;
        else if(VehicleInfo[playerid][i][vFuel] > 150.0) VehicleInfo[playerid][i][vFuel] = 150.0;

        VehicleInfo[playerid][i][vHealth] = cache_get_field_content_float(i, "health", db_handle);
        if(VehicleInfo[playerid][i][vHealth] <= 0.0) VehicleInfo[playerid][i][vHealth] = 1000.0;
        else if(VehicleInfo[playerid][i][vHealth] < 270.0) VehicleInfo[playerid][i][vHealth] = 270.0;
        else if(VehicleInfo[playerid][i][vHealth] > 1000.0) VehicleInfo[playerid][i][vHealth] = 1000.0;

        gVehicleMileage[playerid][i] = cache_get_field_content_float(i, "mileage", db_handle);
        if(gVehicleMileage[playerid][i] < 0.0) gVehicleMileage[playerid][i] = 0.0;

        VehicleInfo[playerid][i][vPlateType] = cache_get_field_content_int(i, "plate_type", db_handle);
        cache_get_field_content(i, "plate_number", VehicleInfo[playerid][i][vPlateNumber], db_handle, 16);
        cache_get_field_content(i, "plate_region", VehicleInfo[playerid][i][vPlateRegion], db_handle, 8);

        // ˜˜˜˜˜ ˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜, ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜
        // ˜˜˜˜˜˜˜ (˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜). Repair: format -> regenerate, ˜˜˜˜˜ normalize case.
        if(VehicleInfo[playerid][i][vPlateType] >= 1 && VehicleInfo[playerid][i][vPlateType] <= 4)
        {
            new country = VehicleInfo[playerid][i][vPlateType] - 1;
            new before_n[16], before_r[8];
            format(before_n, sizeof before_n, "%s", VehicleInfo[playerid][i][vPlateNumber]);
            format(before_r, sizeof before_r, "%s", VehicleInfo[playerid][i][vPlateRegion]);

            Gibdd_RepairPlate(country,
                VehicleInfo[playerid][i][vPlateNumber], 16,
                VehicleInfo[playerid][i][vPlateRegion], 8);
            Gibdd_NormalizePlateText(country, VehicleInfo[playerid][i][vPlateNumber]);
            Gibdd_NormalizePlateText(country, VehicleInfo[playerid][i][vPlateRegion]);

            if(strcmp(before_n, VehicleInfo[playerid][i][vPlateNumber]) != 0 ||
               strcmp(before_r, VehicleInfo[playerid][i][vPlateRegion]) != 0)
            {
                new pq[256], car_db_id = cache_get_field_content_int(i, "id", db_handle);
                mysql_format(db_handle, pq, sizeof pq,
                    "UPDATE `ownable_cars` SET `plate_number`='%e', `plate_region`='%e' WHERE `id`=%d LIMIT 1",
                    VehicleInfo[playerid][i][vPlateNumber], VehicleInfo[playerid][i][vPlateRegion], car_db_id);
                mysql_tquery(db_handle, pq, "", "");
            }
        }

        VehicleInfo[playerid][i][vAutoEngine] = (cache_get_field_content_int(i, "auto_engine", db_handle) > 0);
        VehicleInfo[playerid][i][vAutoLock]   = (cache_get_field_content_int(i, "auto_lock",   db_handle) > 0);
        VehicleInfo[playerid][i][vLastPos][0] = cache_get_field_content_float(i, "last_x", db_handle);
        VehicleInfo[playerid][i][vLastPos][1] = cache_get_field_content_float(i, "last_y", db_handle);
        VehicleInfo[playerid][i][vLastPos][2] = cache_get_field_content_float(i, "last_z", db_handle);
        VehicleInfo[playerid][i][vLastPos][3] = cache_get_field_content_float(i, "last_a", db_handle);
        VehicleInfo[playerid][i][vLastValid]  = (cache_get_field_content_int(i, "last_valid", db_handle) > 0);

        cache_get_field_content(i, "body_kits", VehicleInfo[playerid][i][vBodyKits], db_handle, 256);

        VehicleInfo[playerid][i][vID] = INVALID_VEHICLE_ID;
        VehicleInfo[playerid][i][vSpawned] = false;
        VehicleInfo[playerid][i][vFamFleetBorrow] = false;
    }

    if(rows > 0)
    {
        new q_wfix[400];
        mysql_format(db_handle, q_wfix, sizeof q_wfix,
            "UPDATE `ownable_cars` SET `clearance`=0,`clearance_front`=0,`clearance_rear`=0,\
            `offset_front`=0,`offset_rear`=0,`camber_front`=0,`camber_rear`=0,\
            `wheel_width_front`=0,`wheel_width_rear`=0,`wheel_radius`=0 WHERE `owner_id`=%d",
            Player[playerid][pID]);
        mysql_tquery(db_handle, q_wfix, "", "");
    }

    if(Player[playerid][pJailTime] > 0) JailSystem(playerid);

    if(Player[playerid][pID] > 0)
    {
        new Node:res = JSON_Object();
        JSON_SetInt(res, "c", 1);
        OnPacketIncoming(playerid, 38, res);
        JSON_Cleanup(res);
    }

    SetTimerEx("PV_SyncStreamedPersonalForPlr", 400, false, "i", playerid);
    SetTimerEx("PV_SyncStreamedPersonalForPlr", 1500, false, "i", playerid);

    Family_FleetRequestStripPersonalCars(playerid);

    return 1;
}

forward DoubleTimeTimer();
public DoubleTimeTimer()
{
    PayDayMinutesCount++;

    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(!IsPlayerConnected(i)) continue;

        ShowDoubleTime(i);
        if(SpawnLoc_TrySaveLastPos(i))
            SpawnLoc_SaveLastPosToDB(i);

        Player[i][pSecondsHour] += 300;

        if(PayDayMinutesCount >= 12)
        {
            if(Player[i][pSecondsHour] >= 900)
            {
                new exp_amount = 1;
                new bc_amount = 0;

                if(Player[i][pVipTime] > 0)
                {
                    Player[i][pVipTime] -= 60;
                    if(Player[i][pVipTime] < 0) Player[i][pVipTime] = 0;

                    switch(Player[i][pVipType])
                    {
                        case 1: { bc_amount = 200; exp_amount = 1; }
                        case 2: { bc_amount = 500; exp_amount = 2; }
                        case 3: { bc_amount = 800; exp_amount = 3; }
                    }
                }

                Player[i][pExp] += exp_amount;
                Player[i][pLevel] = (Player[i][pExp] / 4) + 1;
                SetPlayerScore(i, Player[i][pLevel]);

                if(bc_amount > 0) GivePlayerBlackCoin(i, bc_amount);

                SendClientMessage(i, 0xFFFF00FF, "--------- PAYDAY ---------");

                if(Player[i][pVipTime] == 0 && Player[i][pVipType] > 0)
                {
                    Player[i][pVipType] = 0;
                    SendClientMessage(i, 0xFF0000FF, "˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ VIP ˜˜˜˜˜˜˜ ˜˜˜˜˜!");
                }
            }
            Player[i][pSecondsHour] = 0;
        }
    }

    if(PayDayMinutesCount >= 12)
    {
        House_ProcessKvartplataPayDay();
        PayDayMinutesCount = 0;
    }
    return 1;
}

