stock Business_ApplyDisplayName(businessid)
{
	if(businessid < 0 || businessid >= g_business_loaded) return 0;
	GetAddBizNameByType(GetBusinessData(businessid, B_TYPE), g_business[businessid][B_NAME], 64);
	return 1;
}

stock GetBusinessDisplayName(businessid, dest[], size = 64)
{
	if(businessid < 0 || businessid >= g_business_loaded)
	{
		format(dest, size, "˜˜˜˜˜˜");
		return 0;
	}
	GetAddBizNameByType(GetBusinessData(businessid, B_TYPE), dest, size);
	return 1;
}

stock Business_SyncNameToDb(businessid)
{
	if(businessid < 0 || businessid >= g_business_loaded) return 0;
	if(GetBusinessData(businessid, B_SQL_ID) <= 0) return 0;
	Business_ApplyDisplayName(businessid);
	new q[192];
	mysql_format(db_handle, q, sizeof q,
		"UPDATE `business` SET `name`='%e' WHERE `id`=%d LIMIT 1",
		g_business[businessid][B_NAME], GetBusinessData(businessid, B_SQL_ID));
	mysql_tquery(db_handle, q, "", "");
	return 1;
}

stock GetBusinessTypeName(type, dest[], size = 24)
{
	switch(type)
	{
		case BUSINESS_TYPE_SHOP_24_7: format(dest, size, "24/7");
		case BUSINESS_TYPE_CLUB: format(dest, size, "˜˜˜˜");
		case BUSINESS_TYPE_REALTOR_BIZ: format(dest, size, "˜˜˜˜˜˜˜˜˜˜");
		case BUSINESS_TYPE_REALTOR_HOME: format(dest, size, "˜˜˜˜˜˜˜");
		case BUSINESS_TYPE_CLOTHING_SHOP: format(dest, size, "˜˜˜˜˜˜");
		case BUSINESS_TYPE_HOTEL: format(dest, size, "˜˜˜˜˜");
		case BUSINESS_TYPE_CAR_MARKET: format(dest, size, "˜˜˜˜˜˜˜˜˜");
		case BUSINESS_TYPE_CASINO: format(dest, size, "˜˜˜˜˜˜");
		case BUSINESS_TYPE_CELL_SALON: format(dest, size, "˜˜˜˜˜˜˜");
		case BUSINESS_TYPE_CAR_TUNING: format(dest, size, "˜˜˜˜˜˜");
		case BUSINESS_TYPE_SHOP_GUN: format(dest, size, "˜˜˜˜˜˜");
		case BUSINESS_TYPE_ACCESSORY_SHOP: format(dest, size, "˜˜˜˜˜˜˜˜˜˜");
		case BUSINESS_TYPE_SNACK: format(dest, size, "˜˜˜˜˜˜˜˜˜˜");
		default: format(dest, size, "˜˜˜˜˜˜");
	}
}

stock ShowBizTPListDialog(playerid)
{
	new list[4096], line[96], count;
	list[0] = '\0';
	strcat(list, "ID\t˜˜˜\t˜˜˜˜˜˜˜˜\n");

	for(new i; i < g_business_loaded; i++)
	{
		if(!IsBusinessSlotValid(i)) continue;
		new tname[24];
		GetBusinessTypeName(GetBusinessData(i, B_TYPE), tname, sizeof tname);
		new bname[64];
		GetAddBizNameByType(GetBusinessData(i, B_TYPE), bname, sizeof bname);
		format(line, sizeof line, "%d\t%s\t%s\n", i + 1, tname, bname);
		strcat(list, line);
		g_biz_tp_list[playerid][count] = i;
		count++;
		if(count >= MAX_BUSINESS) break;
	}

	g_biz_tp_count[playerid] = count;
	if(!count) return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜.");

	ShowPlayerDialog(playerid, DIALOG_BIZ_TP_LIST, DIALOG_STYLE_TABLIST_HEADERS,
		"{FFCD00}˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜", list, "˜˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
	return 1;
}

stock IsBusinessNoBuy(businessid)
{
	#pragma unused businessid
	return 0;
}

stock IsBusinessNoUpgrade(businessid)
{
	#pragma unused businessid
	return 0;
}

stock GetPlayerBusiness(playerid)
{
	new b = Player[playerid][pBusiness];
	if(b < 0 || b >= g_business_loaded) return -1;
	if(GetBusinessData(b, B_OWNER_ID) != Player[playerid][pID]) return -1;
	return b;
}

stock GetBusinessEnterProdCount(businessid)
{
	new take_prods = 0;
	new enter_price = GetBusinessData(businessid, B_ENTER_PRICE);
	if(enter_price > 0)
	{
		if(enter_price < 150) take_prods = 1;
		else if(enter_price < 500) take_prods = 2;
		else take_prods = 3;
	}
	return take_prods;
}

stock GetBusinessMaxProd(businessid)
{
	new max_prods = 500;
	new i_level = GetBusinessData(businessid, B_IMPROVEMENTS);
	if(i_level >= 5) max_prods = 10000;
	else if(i_level >= 1) max_prods = 3000;
	return max_prods;
}

stock BusinessImprovementsPrice(businessid)
{
	new price;
	new level = GetBusinessData(businessid, B_IMPROVEMENTS);
	if(1 <= level <= sizeof g_business_improvements)
	{
		for(new idx; idx < level; idx++)
			price += g_business_improvements[idx][I_PRICE];
	}
	return price;
}

stock GetNearestBusiness(playerid, Float:dist = 10.0)
{
	if(dist == 0.0) dist = FLOAT_INFINITY;
	new businessid = -1;
	new Float:my_dist;
	for(new idx; idx < g_business_loaded; idx++)
	{
		if(!IsBusinessSlotValid(idx)) continue;
		my_dist = GetPlayerDistanceFromPoint(playerid, GetBusinessData(idx, B_POS_X), GetBusinessData(idx, B_POS_Y), GetBusinessData(idx, B_POS_Z));
		if(my_dist < dist)
		{
			dist = my_dist;
			businessid = idx;
		}
	}
	return businessid;
}

stock bool:IsPlayerInBuyPosBiz(playerid, businessid, type, Float:radius = 50.0)
{
	if(GetBusinessData(businessid, B_TYPE) != type) return false;
	new interior = GetBusinessData(businessid, B_INTERIOR);
	new Float:bx = g_business_interiors[interior][BT_BUY_POS_X];
	new Float:by = g_business_interiors[interior][BT_BUY_POS_Y];
	new Float:bz = g_business_interiors[interior][BT_BUY_POS_Z];
	new inrange = IsPlayerInRangeOfPoint(playerid, radius, bx, by, bz);
	return inrange != 0;
}

stock Biz_LogProfit(sql_bid, playerid, money, view1)
{
	new ip[16], q[256];
	GetPlayerIpBiz(playerid, ip, sizeof ip);
	mysql_format(db_handle, q, sizeof q,
		"INSERT INTO business_profit (bid,uid,uip,time,money,view) VALUES (%d,%d,'%e',%d,%d,%d)",
		sql_bid, Player[playerid][pID], ip, gettime(), money, view1);
	mysql_tquery(db_handle, q, "", "");
}

stock Biz_SaveBusinessRow(businessid)
{
	new q[320];
	mysql_format(db_handle, q, sizeof q,
		"UPDATE business SET owner_id=%d,improvements=%d,products=%d,prod_price=%d,balance=%d,rent_time=%d,enter_price=%d,enter_music=%d,`lock`=%d WHERE id=%d LIMIT 1",
		GetBusinessData(businessid, B_OWNER_ID),
		GetBusinessData(businessid, B_IMPROVEMENTS),
		GetBusinessData(businessid, B_PRODS),
		GetBusinessData(businessid, B_PROD_PRICE),
		GetBusinessData(businessid, B_BALANCE),
		GetBusinessData(businessid, B_RENT_DATE),
		GetBusinessData(businessid, B_ENTER_PRICE),
		GetBusinessData(businessid, B_ENTER_MUSIC),
		_:GetBusinessData(businessid, B_LOCK_STATUS),
		GetBusinessData(businessid, B_SQL_ID));
	mysql_tquery(db_handle, q, "", "");
}

stock EnterPlayerToBiz(playerid, businessid)
{
	if(businessid < 0 || businessid >= g_business_loaded)
		return 0;

	new cur = GetPlayerInBiz(playerid);
	if(cur == businessid && Biz_IsPlayerInside(playerid, businessid))
	{
		if(Shop247_Is247Business(businessid))
			Shop247_OnEnterBiz(playerid, businessid);
		return 1;
	}
	if(cur != -1)
		ExitPlayerFromBiz(playerid);

	new type = GetBusinessData(businessid, B_TYPE),
		buffer = GetBusinessData(businessid, B_INTERIOR);

	if(type == BUSINESS_TYPE_CAR_MARKET || type == BUSINESS_TYPE_CAR_TUNING)
	{
		SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ (˜˜˜˜/˜˜˜˜˜˜).");
		return 1;
	}

	SetPlayerInterior(playerid, GetBusinessInteriorInfo(buffer, BT_ENTER_INTERIOR));
	SetPlayerVirtualWorld(playerid, Biz_GetInteriorVW(businessid));
	SetPlayerPos(playerid,
		GetBusinessInteriorInfo(buffer, BT_ENTER_POS_X),
		GetBusinessInteriorInfo(buffer, BT_ENTER_POS_Y),
		GetBusinessInteriorInfo(buffer, BT_ENTER_POS_Z));
	SetPlayerFacingAngle(playerid, GetBusinessInteriorInfo(buffer, BT_ENTER_ANGLE));
	SetPlayerInBiz(playerid, businessid);

	buffer = GetBusinessData(businessid, B_ENTER_MUSIC);
	if(1 <= buffer <= sizeof g_business_sound)
		PlayerPlaySound(playerid, g_business_sound[buffer - 1], 0.0, 0.0, 0.0);
	if(GetBusinessData(businessid, B_TYPE) == BUSINESS_TYPE_SNACK)
		Snack_SpawnForBusiness(businessid);
	else
		Shop247_OnEnterBiz(playerid, businessid);
	return 1;
}

stock BusinessHealthPickupInit(businessid)
{
	if(GetBusinessData(businessid, B_IMPROVEMENTS) >= 2)
	{
		if(!GetBusinessData(businessid, B_HEALTH_PICKUP))
		{
			new interior = GetBusinessData(businessid, B_INTERIOR);
			new pid = CreateDynamicPickup(1240, 23,
				GetBusinessInteriorInfo(interior, BT_HEALTH_POS_X),
				GetBusinessInteriorInfo(interior, BT_HEALTH_POS_Y),
				GetBusinessInteriorInfo(interior, BT_HEALTH_POS_Z),
				Biz_GetInteriorVW(businessid), GetBusinessInteriorInfo(interior, BT_ENTER_INTERIOR), -1, 15.0);
			SetBusinessData(businessid, B_HEALTH_PICKUP, pid);
		}
	}
	else
	{
		if(GetBusinessData(businessid, B_HEALTH_PICKUP))
		{
			DestroyDynamicPickup(GetBusinessData(businessid, B_HEALTH_PICKUP));
			SetBusinessData(businessid, B_HEALTH_PICKUP, 0);
		}
	}
}

stock UpdateBusinessLabel(businessid)
{
	if(businessid < 0 || businessid >= g_business_loaded) return 0;
	Business_ApplyDisplayName(businessid);
	new fmt_str[220];
	if(!IsBusinessOwned(businessid))
	{
		format(fmt_str, sizeof fmt_str,
			"{FF5252}%s (%d)\n{FF5252}˜˜˜˜˜˜: {FFFFFF}˜˜˜˜˜˜˜˜˜\n{DCDCDC}[/buybiz]\n{FF5252}˜˜˜˜: {FFFFFF}%d ˜˜˜\n",
			GetBusinessData(businessid, B_NAME),
			businessid + 1,
			GetBusinessData(businessid, B_PRICE));
	}
	else
	{
		format(fmt_str, sizeof fmt_str,
			"{FF5252}%s (%d)\n{FF5252}˜˜˜˜˜˜˜˜: {FFFFFF}%s\n",
			GetBusinessData(businessid, B_NAME),
			businessid + 1,
			GetBusinessData(businessid, B_OWNER_NAME));
		if(GetBusinessData(businessid, B_LOCK_STATUS))
			strcat(fmt_str, "{FF6600}˜˜˜˜˜˜˜");
	}
	UpdateDynamic3DTextLabelText(GetBusinessData(businessid, B_LABEL), 0xFF4500FF, fmt_str);
	return 1;
}

stock InitBusinessInteriorsOnce()
{
	static bool:done;
	if(done) return 1;
	done = true;

	new tmp_cp;
	for(new idx; idx < sizeof g_business_interiors; idx++)
	{
		if(idx != BUSINESS_INTERIOR_SNACK)
		{
			g_bi_exit_pickup[idx] = CreateDynamicPickup(19132, 23,
				GetBusinessInteriorInfo(idx, BT_EXIT_POS_X),
				GetBusinessInteriorInfo(idx, BT_EXIT_POS_Y),
				GetBusinessInteriorInfo(idx, BT_EXIT_POS_Z),
				-1, GetBusinessInteriorInfo(idx, BT_ENTER_INTERIOR), -1, 20.0);
		}
		else g_bi_exit_pickup[idx] = 0;

		switch(idx)
		{
			case BUSINESS_INTERIOR_SHOP_24_7:
			{
				// ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜ Shop247_SpawnForBusiness (VW = businessid+255)
			}
			case BUSINESS_INTERIOR_CLUB, BUSINESS_INTERIOR_CASINO:
			{
				CreateDynamic3DTextLabel("˜˜˜˜ ˜˜˜˜ (˜˜˜˜˜˜˜˜)", 0xFFFFFFCC,
					GetBusinessInteriorInfo(idx, BT_LABEL_POS_X),
					GetBusinessInteriorInfo(idx, BT_LABEL_POS_Y),
					GetBusinessInteriorInfo(idx, BT_LABEL_POS_Z), 9.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1);
				tmp_cp = CreateDynamicCP(
					GetBusinessInteriorInfo(idx, BT_BUY_POS_X),
					GetBusinessInteriorInfo(idx, BT_BUY_POS_Y),
					GetBusinessInteriorInfo(idx, BT_BUY_POS_Z),
					1.0, -1, GetBusinessInteriorInfo(idx, BT_ENTER_INTERIOR), -1, 12.0);
				SetBusinessInteriorInfo(idx, BT_BUY_CHECK_ID, tmp_cp);
			}
			case BUSINESS_INTERIOR_SHOP_GUN:
			{
				CreateDynamic3DTextLabel("{33AAFF}˜˜˜˜˜˜˜ ˜˜˜˜˜˜", 0xFFFFFFFF,
					GetBusinessInteriorInfo(idx, BT_BUY_POS_X),
					GetBusinessInteriorInfo(idx, BT_BUY_POS_Y),
					GetBusinessInteriorInfo(idx, BT_BUY_POS_Z) + 0.8, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1);
				g_bi_shopgun_pickup = CreateDynamicPickup(1274, 23,
					GetBusinessInteriorInfo(idx, BT_BUY_POS_X),
					GetBusinessInteriorInfo(idx, BT_BUY_POS_Y),
					GetBusinessInteriorInfo(idx, BT_BUY_POS_Z),
					-1, GetBusinessInteriorInfo(idx, BT_ENTER_INTERIOR), -1, 12.0);
			}
			case BUSINESS_INTERIOR_CAR_TUNING:
			{
				CreateDynamic3DTextLabel("˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜\n{CC6600}(˜˜˜˜˜˜˜˜˜)", 0xCC6600EE,
					GetBusinessInteriorInfo(idx, BT_LABEL_POS_X),
					GetBusinessInteriorInfo(idx, BT_LABEL_POS_Y),
					GetBusinessInteriorInfo(idx, BT_LABEL_POS_Z), 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1);
				g_bi_cartun_pickup = CreateDynamicPickup(19132, 23,
					GetBusinessInteriorInfo(idx, BT_BUY_POS_X),
					GetBusinessInteriorInfo(idx, BT_BUY_POS_Y),
					GetBusinessInteriorInfo(idx, BT_BUY_POS_Z),
					-1, GetBusinessInteriorInfo(idx, BT_ENTER_INTERIOR), -1, 8.0);
			}
			case BUSINESS_INTERIOR_SNACK:
			{
				Snack_InitInteriorExtras(idx);
			}
			default: SetBusinessInteriorInfo(idx, BT_BUY_CHECK_ID, -1);
		}
	}
	return 1;
}

public LoadBusinesses()
{
	new rows, fields;
	cache_get_data(rows, fields, db_handle);
	if(rows > MAX_BUSINESS)
	{
		printf("[Business] DB rows > MAX_BUSINESS (%d)", MAX_BUSINESS);
		rows = MAX_BUSINESS;
	}

	for(new z; z < MAX_BUSINESS; z++)
	{
		g_business[z][B_LABEL] = Text3D:0;
		g_business[z][B_ENTER_PICKUP] = 0;
		g_business[z][B_HEALTH_PICKUP] = 0;
	}

	g_business_loaded = 0;
	for(new idx; idx < rows; idx++)
	{
		SetBusinessData(idx, B_SQL_ID, cache_get_field_content_int(idx, "biz_id", db_handle));
		SetBusinessData(idx, B_OWNER_ID, cache_get_field_content_int(idx, "owner_id", db_handle));
		SetBusinessData(idx, B_TYPE, cache_get_field_content_int(idx, "biz_type", db_handle));
		Business_ApplyDisplayName(idx);
		SetBusinessData(idx, B_IMPROVEMENTS, cache_get_field_content_int(idx, "improvements", db_handle));
		SetBusinessData(idx, B_PRODS, cache_get_field_content_int(idx, "products", db_handle));
		SetBusinessData(idx, B_PROD_PRICE, cache_get_field_content_int(idx, "prod_price", db_handle));
		SetBusinessData(idx, B_BALANCE, cache_get_field_content_int(idx, "balance", db_handle));
		SetBusinessData(idx, B_RENT_DATE, cache_get_field_content_int(idx, "rent_time", db_handle));
		SetBusinessData(idx, B_PRICE, cache_get_field_content_int(idx, "price", db_handle));
		SetBusinessData(idx, B_RENT_PRICE, cache_get_field_content_int(idx, "rent_price", db_handle));
		SetBusinessData(idx, B_INTERIOR, cache_get_field_content_int(idx, "interior", db_handle));
		SetBusinessData(idx, B_ENTER_PRICE, cache_get_field_content_int(idx, "enter_price", db_handle));
		SetBusinessData(idx, B_ENTER_MUSIC, cache_get_field_content_int(idx, "enter_music", db_handle));
		SetBusinessData(idx, B_LOCK_STATUS, bool:cache_get_field_content_int(idx, "lock", db_handle));
		SetBusinessData(idx, B_POS_X, cache_get_field_content_float(idx, "x", db_handle));
		SetBusinessData(idx, B_POS_Y, cache_get_field_content_float(idx, "y", db_handle));
		SetBusinessData(idx, B_POS_Z, cache_get_field_content_float(idx, "z", db_handle));
		SetBusinessData(idx, B_EXIT_POS_X, cache_get_field_content_float(idx, "exit_x", db_handle));
		SetBusinessData(idx, B_EXIT_POS_Y, cache_get_field_content_float(idx, "exit_y", db_handle));
		SetBusinessData(idx, B_EXIT_POS_Z, cache_get_field_content_float(idx, "exit_z", db_handle));
		SetBusinessData(idx, B_EXIT_ANGLE, cache_get_field_content_float(idx, "exit_angle", db_handle));
		SetBusinessData(idx, B_EVICTION, cache_get_field_content_int(idx, "eviction", db_handle));
		if(GetBusinessData(idx, B_OWNER_ID) <= 0 && GetBusinessData(idx, B_EVICTION) == 1)
			SetBusinessData(idx, B_EVICTION, gettime() + 86400);
		cache_get_field_content(idx, "owner_name", g_business[idx][B_OWNER_NAME], db_handle, BIZ_OWNER_NAME_LEN);

		SetBusinessData(idx, B_ORDER_ID, -1);
		SetBusinessData(idx, B_HEALTH_PICKUP, 0);
		SetBusinessData(idx, B_ENTER_PICKUP, 0);

		if(GetBusinessData(idx, B_LABEL))
			DestroyDynamic3DTextLabel(GetBusinessData(idx, B_LABEL));

		g_business[idx][B_LABEL] = CreateDynamic3DTextLabel("...", 0xFF5252FF,
			GetBusinessData(idx, B_POS_X), GetBusinessData(idx, B_POS_Y), GetBusinessData(idx, B_POS_Z) + 1.0,
			BIZ_LABEL_DRAW, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
			0, 0, -1, BIZ_LABEL_STREAM);

		if(IsBusinessOwned(idx) && !strcmp(GetBusinessData(idx, B_OWNER_NAME), "None", true))
		{
			SetBusinessData(idx, B_OWNER_ID, 0);
			new qf[96];
			mysql_format(db_handle, qf, sizeof qf, "UPDATE business SET owner_id=0,improvements=0 WHERE id=%d", GetBusinessData(idx, B_SQL_ID));
			mysql_tquery(db_handle, qf, "", "");
		}

		if(!IsBusinessOwned(idx))
		{
			SetBusinessData(idx, B_PRODS, 0);
			SetBusinessData(idx, B_PROD_PRICE, 0);
			SetBusinessData(idx, B_LOCK_STATUS, false);
			SetBusinessData(idx, B_ENTER_MUSIC, 0);
			SetBusinessData(idx, B_ENTER_PRICE, 0);
		}

		UpdateBusinessLabel(idx);

		if(GetBusinessData(idx, B_ENTER_PICKUP)) DestroyDynamicPickup(GetBusinessData(idx, B_ENTER_PICKUP));
		g_business[idx][B_ENTER_PICKUP] = CreateDynamicPickup(19132, 23,
			GetBusinessData(idx, B_POS_X), GetBusinessData(idx, B_POS_Y), GetBusinessData(idx, B_POS_Z), 0, 0, -1, BIZ_ENT_PICKUP_STREAM);

		BusinessHealthPickupInit(idx);
		Business_SyncNameToDb(idx);
		g_business_loaded++;
	}

	InitBusinessInteriorsOnce();
	Shop247_SpawnAll();
	Snack_SpawnAll();
	printf("[Business] ˜˜˜˜˜˜˜˜˜: %d", g_business_loaded);
	SetTimerEx("Business_OnWorldLoadedDelay", 1500, false, "");
	return 1;
}

public Business_OnWorldLoadedDelay()
{
	for(new i; i < g_business_loaded; i++)
	{
		if(!IsBusinessSlotValid(i)) continue;
		UpdateBusinessLabel(i);
		if(!GetBusinessData(i, B_ENTER_PICKUP))
			BusinessSpawnWorldObjects(i);
	}
	House_StreamerRefreshAllPlayers();
	return 1;
}

stock GivePlayerDrinkItemSimple(playerid, listitem)
{
	new drunk = (listitem + 1) * 400;
	if(drunk > 2000) drunk = 2000;
	SetPlayerDrunkLevel(playerid, drunk);
}

