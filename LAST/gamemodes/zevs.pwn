    {
        x = GetPVarFloat(playerid, "sto_ret_x");
        y = GetPVarFloat(playerid, "sto_ret_y");
        z = GetPVarFloat(playerid, "sto_ret_z");
        a = GetPVarFloat(playerid, "sto_ret_a");
        if(x == 0.0 && y == 0.0 && z == 0.0)
        {
            x = g_StoEntryPos[0][0];
            y = g_StoEntryPos[0][1];
            z = g_StoEntryPos[0][2];
            a = g_StoEntryPos[0][3];
        }
    }
    else if(InStailing[playerid])
    {
        x = 2297.6091; y = -2614.1564; z = 21.0541; a = 65.6191;
    }
    else
    {
        x = -413.339; y = 1027.331; z = 11.235; a = 1.000;
    }

    if(exit_slot != -1)
    {
        if(GetPVarInt(playerid, "tune_session_bought"))
            Tune_FlushVehiclePaintToDb(playerid, exit_slot);
        else
            Tune_RestoreEntryColors(playerid, exit_slot);
    }

    new bool:was_shinka = gInShinkaSession[playerid];
    new bool:was_sto = gInStoSession[playerid];
    InStailing[playerid] = false;
    gInShinkaSession[playerid] = false;
    gInStoSession[playerid] = false;

    SetPlayerVirtualWorld(playerid, 0);
    SetPlayerInterior(playerid, 0);

    if(carid != 0)
    {
        SetVehicleVirtualWorld(carid, 0);
        SetVehiclePos(carid, x, y, z);
        SetVehicleZAngle(carid, a);
        PutPlayerInVehicle(playerid, carid, 0);

        if(was_shinka && exit_slot != -1)
        {
            new saved_wheel = gShinkaStartWheel[playerid];
            new cur_wheel = DetectVehicleWheelComponent(carid);
            if(saved_wheel > 0 && cur_wheel != saved_wheel)
            {
                if(cur_wheel > 0) RemoveVehicleComponent(carid, cur_wheel);
                if(VehicleInfo[playerid][exit_slot][vWheelModel] > 0)
                    AddVehicleComponent(carid, VehicleInfo[playerid][exit_slot][vWheelModel]);
                else if(VehicleInfo[playerid][exit_slot][vWheel] > 0)
                    AddVehicleComponent(carid, VehicleInfo[playerid][exit_slot][vWheel]);
            }
            VehicleInfo[playerid][exit_slot][vHydraState] = false;
        }
    }
    else
    {
        SetPlayerPos(playerid, x, y, z);
        SetPlayerFacingAngle(playerid, a);
    }

