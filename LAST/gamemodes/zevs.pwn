		}
		case DIALOG_BIZ_ENTER_PRICE:
		{
			new businessid = GetPlayerBusiness(playerid);
			if(businessid == -1) return true;
			if(response && strlen(inputtext))
			{
				new price = strval(inputtext);
				if((0 <= price <= 5000) && IsNumeric(inputtext))
				{
					SetBusinessData(businessid, B_ENTER_PRICE, price);
					Biz_SaveBusinessRow(businessid);
					UpdateBusinessLabel(businessid);
					SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜.");
					ShowBizOwnerParamsList(playerid);
					return true;
				}
				SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜ (0˜5000).");
			}
			else ShowBizOwnerParamsList(playerid);
			return true;
		}
		case DIALOG_BIZ_PROD_PRICE:
		{
			new businessid = GetPlayerBusiness(playerid);
			if(businessid == -1) return true;
			if(response && strlen(inputtext) && IsNumeric(inputtext))
			{
				new price = strval(inputtext);
				if(25 <= price <= 200)
				{
					SetBusinessData(businessid, B_PROD_PRICE, price);
					Biz_SaveBusinessRow(businessid);
					SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜.");
					ShowBizOwnerParamsList(playerid);
					return true;
				}
				SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜ 25˜200.");
			}
			else ShowBizOwnerParamsList(playerid);
			return true;
		}
		case DIALOG_BIZ_ORDER_PRODS:
		{
			new businessid = GetPlayerBusiness(playerid);
			if(businessid == -1) return true;
			if(response && strlen(inputtext) && IsNumeric(inputtext))
			{
				new order_prods = strval(inputtext), prod_price = 35, price = order_prods * prod_price;
				if(order_prods > 0)
				{
					new free_slots = GetBusinessMaxProd(businessid) - GetBusinessData(businessid, B_PRODS);
					if(free_slots > 1000) free_slots = 1000;
					if(order_prods <= free_slots && GetBusinessData(businessid, B_BALANCE) >= price)
					{
						AddBusinessData(businessid, B_BALANCE, -, price);
						AddBusinessData(businessid, B_PRODS, +, order_prods);
						Biz_SaveBusinessRow(businessid);
						SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜.");
					}
					else if(GetBusinessData(businessid, B_BALANCE) < price)
						SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜.");
					else SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜.");
				}
			}
			else ShowBizOwnerParamsList(playerid);
			return true;
		}
		case DIALOG_BIZ_ORDER_CANCEL:
		{
			ShowBizOwnerParamsList(playerid);
			return true;
		}
		case DIALOG_BIZ_IMPROVEMENT:
		{
			new businessid = GetPlayerBusiness(playerid);
			if(businessid == -1) return true;
			if(response && 0 <= listitem < sizeof g_business_improvements)
			{
				new i_level = GetBusinessData(businessid, B_IMPROVEMENTS), i_price = g_business_improvements[listitem][I_PRICE];
				if(i_level < listitem) SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.");
				else if(i_level > listitem) SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜.");
				else if(GetPlayerMoneyEx(playerid) < i_price) SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.");
				else
				{
					GivePlayerMoneyEx(playerid, -i_price);
					AddBusinessData(businessid, B_IMPROVEMENTS, +, 1);
					Biz_SaveBusinessRow(businessid);
					SendClientMessage(playerid, 0x3399FFFF, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.");
					switch(listitem + 1)
					{
						case 2: BusinessHealthPickupInit(businessid);
						case 6: SendClientMessage(playerid, 0x66CC00FF, "GPS-˜˜˜˜˜˜˜: ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ business_gps ˜ ˜˜˜˜˜˜˜ /gps.");
					}
				}
			}
			ShowBizOwnerParamsList(playerid);
			return true;
		}
		case DIALOG_BIZ_SELL:
		{
			if(response) SellBusiness(playerid);
			return true;
		}
		case DIALOG_BIZ_ENTER_MUSIC:
		{
			new businessid = GetPlayerBusiness(playerid);
			if(businessid != -1 && response && 0 <= listitem <= sizeof g_business_sound)
			{
				SetBusinessData(businessid, B_ENTER_MUSIC, listitem);
				new q[96];
				mysql_format(db_handle, q, sizeof q, "UPDATE business SET enter_music=%d WHERE id=%d LIMIT 1",
					listitem, GetBusinessData(businessid, B_SQL_ID));
				mysql_tquery(db_handle, q, "", "");
				if(listitem > 0) PlayerPlaySound(playerid, g_business_sound[listitem - 1], 0.0, 0.0, 0.0);
				SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜ ˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜.");
			}
			return true;
		}
		case DIALOG_BIZ_ENTER:
		{
			new businessid = GetPVarInt(playerid, "biz_enter") - 1;
			DeletePVar(playerid, "biz_enter");
			if(response && GetPlayerInBiz(playerid) == -1 && businessid != -1 && GetBusinessData(businessid, B_ENTER_PRICE) > 0 && IsBusinessOwned(businessid))
			{
				if(IsPlayerInRangeOfPoint(playerid, 5.0, GetBusinessData(businessid, B_POS_X), GetBusinessData(businessid, B_POS_Y), GetBusinessData(businessid, B_POS_Z)))
				{
					new price = GetBusinessData(businessid, B_ENTER_PRICE), take = GetBusinessEnterProdCount(businessid);
					if(GetPlayerMoneyEx(playerid) >= price)
					{
						GivePlayerMoneyEx(playerid, -price);
						if(GetBusinessData(businessid, B_PRODS) >= take)
						{
							AddBusinessData(businessid, B_PRODS, -, take);
							AddBusinessData(businessid, B_BALANCE, +, price);
						}
						Biz_LogProfit(GetBusinessData(businessid, B_SQL_ID), playerid, price, _:IsBusinessOwned(businessid));
						Biz_SaveBusinessRow(businessid);
						SetPlayerUseListitem(playerid, businessid);
						if(!Shop_TryEnterBusiness(playerid, businessid))
							EnterPlayerToBiz(playerid, businessid);
					}
					else SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜.");
				}
			}
			return true;
		}
		case DIALOG_BIZ_SHOP_GUN:
		{
			new businessid = GetPlayerInBiz(playerid);
			if(businessid == -1 || !response) return true;
			if(!IsPlayerInBuyPosBiz(playerid, businessid, BUSINESS_TYPE_SHOP_GUN)) return true;

			new weapon_id, weapon_ammo, price, take_prods = 1;
			switch(listitem)
			{
				case 0: { weapon_id = 25; weapon_ammo = 50; price = 140; }
				case 1: { weapon_id = 29; weapon_ammo = 100; price = 60; }
				case 2: { weapon_id = 30; weapon_ammo = 100; price = 120; }
				case 3: { weapon_id = 33; weapon_ammo = 50; price = 70; }
				case 4: { weapon_id = 24; weapon_ammo = 50; price = 100; }
				default: return true;
			}
			if(GetPlayerMoneyEx(playerid) < price) return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜."), true;
			GivePlayerMoneyEx(playerid, -price);
			if(GetBusinessData(businessid, B_PRODS) >= take_prods)
			{
				AddBusinessData(businessid, B_PRODS, -, take_prods);
				AddBusinessData(businessid, B_BALANCE, +, price);
			}
			Biz_LogProfit(GetBusinessData(businessid, B_SQL_ID), playerid, price, _:IsBusinessOwned(businessid));
			Biz_SaveBusinessRow(businessid);
			GivePlayerWeapon(playerid, weapon_id, weapon_ammo);
			SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");
			return true;
		}
		case DIALOG_BIZ_SHOP_24_7:
		{
			new businessid = GetPlayerInBiz(playerid);
			if(businessid == -1) return true;
			if(!response)
			{
				Shop247_MarkShopDialogClosed(playerid);
				return true;
			}
			if(!IsPlayerInBuyPosBiz(playerid, businessid, BUSINESS_TYPE_SHOP_24_7))
			{
				Shop247_MarkShopDialogClosed(playerid);
				return true;
			}

			if(listitem + 1 == 4)
			{
				ShowSimCardBuyDialog(playerid);
				return true;
			}

			new price, take_prods;
			switch(listitem + 1)
			{
				case 1: { price = 200;   take_prods = 2; }
				case 2: { price = 790;   take_prods = 3; }
				case 3: { price = 50000; take_prods = 10; }
				default: return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜."), true;
			}

			if(GetPlayerMoneyEx(playerid) < price) return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜."), true;
			GivePlayerMoneyEx(playerid, -price);
			if(GetBusinessData(businessid, B_PRODS) >= take_prods)
			{
				AddBusinessData(businessid, B_PRODS, -, take_prods);
				AddBusinessData(businessid, B_BALANCE, +, price);
			}
			Biz_LogProfit(GetBusinessData(businessid, B_SQL_ID), playerid, price, _:IsBusinessOwned(businessid));
			Biz_SaveBusinessRow(businessid);
			switch(listitem + 1)
			{
				case 1:
				{
					if(!GivePlayerItem(playerid, ITEM_MEDKIT, 1))
					{
						GivePlayerMoneyEx(playerid, price);
						AddBusinessData(businessid, B_PRODS, +, take_prods);
						AddBusinessData(businessid, B_BALANCE, -, price);
						return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜."), true;
					}
					SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");
					Shop247_NotePurchase(playerid);
				}
				case 2:
				{
					if(!GivePlayerItem(playerid, ITEM_REPAIR_KIT, 1))
					{
						GivePlayerMoneyEx(playerid, price);
						AddBusinessData(businessid, B_PRODS, +, take_prods);
						AddBusinessData(businessid, B_BALANCE, -, price);
						return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜."), true;
					}
					SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");
					Shop247_NotePurchase(playerid);
				}
				case 3:
				{
					new simnumber = GenerateFreePhoneSim(playerid);
					new msg[140];

					if(Player[playerid][pSimCard] == 0)
					{
						if(!GivePlayerSimCardItem(playerid, simnumber))
						{
							GivePlayerMoneyEx(playerid, price);
							AddBusinessData(businessid, B_PRODS, +, take_prods);
							AddBusinessData(businessid, B_BALANCE, -, price);
							return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜."), true;
						}
						new sim_slot = -1;
						for(new si = 0; si < MAX_INV_SLOTS; si++)
						{
							if(PlayerInventory[playerid][si][invItem] == ITEM_SIM_CARD &&
								PlayerInventory[playerid][si][invValue] == simnumber)
							{
								sim_slot = si;
								break;
							}
						}
						SetPlayerSimCardSilent(playerid, simnumber);
						if(sim_slot != -1) RemoveInventorySim(playerid, sim_slot);
						format(msg, sizeof msg, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜. SIM %d ˜˜˜˜˜˜˜˜˜˜˜ (˜˜˜˜˜˜ 0 ˜˜˜., ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜).", simnumber);
					}
					else
					{
						if(!GivePlayerSimCardItem(playerid, simnumber))
						{
							GivePlayerMoneyEx(playerid, price);
							AddBusinessData(businessid, B_PRODS, +, take_prods);
							AddBusinessData(businessid, B_BALANCE, -, price);
							return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜."), true;
						}
						format(msg, sizeof msg, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜. ˜˜˜-˜˜˜˜˜ %d ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ (˜˜˜˜˜˜˜˜: %d).", simnumber, Player[playerid][pSimCard]);
					}
					SendClientMessage(playerid, 0x66CC00FF, msg);
					Player[playerid][pPhoneOwned] = true;
					SavePlayerAccount(playerid);
					Shop247_NotePurchase(playerid);
				}
			}
			Shop247_MarkShopDialogClosed(playerid);
			return true;
		}
		case DIALOG_BIZ_SHOP_24_7_SIM:
		{
			new businessid = GetPlayerInBiz(playerid);
			if(businessid == -1 || !response) return true;
			if(!IsPlayerInBuyPosBiz(playerid, businessid, BUSINESS_TYPE_SHOP_24_7))
				return SendClientMessage(playerid, 0xCECECEFF, "˜˜ ˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ 24/7."), true;

			new len = strlen(inputtext);
			if((len != 4 && len != 6) || !IsNumeric(inputtext))
			{
				SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ 4 ˜˜˜ 6 ˜˜˜˜.");
				ShowSimCardBuyDialog(playerid);
				return true;
			}

			new simnumber = strval(inputtext);

			if(IsSimNumberOnlineTaken(simnumber, playerid))
			{
				new busy_msg[80];
				format(busy_msg, sizeof busy_msg, "˜˜˜˜˜ %d ˜˜˜ ˜˜˜˜˜, ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.", simnumber);
				SendClientMessage(playerid, 0xCECECEFF, busy_msg);
				ShowSimCardBuyDialog(playerid);
				return true;
			}

			if(GetPlayerMoneyEx(playerid) < 2000)
				return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜."), true;

			new q[384];
			Sim_FormatGlobalTakenCheckQuery(q, sizeof q, simnumber, Player[playerid][pID]);
			mysql_tquery(db_handle, q, "OnSimNumberCheck", "ii", playerid, simnumber);
			return true;
		}
		case DIALOG_BIZ_CLOTHING_BUY, DIALOG_BIZ_ACCESSORY_BUY:
		{
			if(ShopStores_OnDialogResponse(playerid, dialogid, response)) return true;
			return true;
		}
		case DIALOG_BIZ_CLUB:
		{
			new businessid = GetPlayerInBiz(playerid);
			if(businessid == -1 || !response) return true;
			if(!IsPlayerInBuyPosBiz(playerid, businessid, BUSINESS_TYPE_CLUB, 15.0) &&
				!IsPlayerInBuyPosBiz(playerid, businessid, BUSINESS_TYPE_CASINO, 15.0)) return true;

			new const item_price[10] = {60, 100, 200, 270, 300, 450, 630, 750, 50, 80};
			if(0 <= listitem <= 9 && GetPlayerMoneyEx(playerid) >= item_price[listitem])
			{
				new price = item_price[listitem];
				GivePlayerMoneyEx(playerid, -price);
				if(GetBusinessData(businessid, B_PRODS) >= 1)
				{
					AddBusinessData(businessid, B_PRODS, -, 1);
					AddBusinessData(businessid, B_BALANCE, +, price);
				}
				Biz_LogProfit(GetBusinessData(businessid, B_SQL_ID), playerid, price, _:IsBusinessOwned(businessid));
				Biz_SaveBusinessRow(businessid);
				GivePlayerDrinkItemSimple(playerid, listitem);
				SendClientMessage(playerid, 0x66CC00FF, "˜˜˜˜˜ ˜˜˜˜˜˜˜.");
			}
			else SendClientMessage(playerid, 0x999999FF, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜.");
			return true;
		}
	}
	return false;
}

stock Biz_DeleteBySlot(del_slot)
{
	if(!IsBusinessSlotValid(del_slot)) return 0;

	new del_sql_id = GetBusinessData(del_slot, B_SQL_ID);
	new last = g_business_loaded - 1;
	new q[192];

	if(GetBusinessData(del_slot, B_ENTER_PICKUP)) DestroyDynamicPickup(GetBusinessData(del_slot, B_ENTER_PICKUP));
	if(GetBusinessData(del_slot, B_HEALTH_PICKUP)) DestroyDynamicPickup(GetBusinessData(del_slot, B_HEALTH_PICKUP));
	if(GetBusinessData(del_slot, B_LABEL)) DestroyDynamic3DTextLabel(GetBusinessData(del_slot, B_LABEL));
	Shop247_DestroyForBusiness(del_slot);
	Snack_DestroyForBusiness(del_slot);

	mysql_format(db_handle, q, sizeof q, "DELETE FROM business WHERE id=%d LIMIT 1", del_sql_id);
	mysql_tquery(db_handle, q, "", "");
	mysql_format(db_handle, q, sizeof q, "UPDATE players SET business=-1 WHERE business=%d", del_slot);
	mysql_tquery(db_handle, q, "", "");

	for(new p; p < MAX_PLAYERS; p++)
	{
		if(!IsPlayerConnected(p)) continue;
		if(Player[p][pBusiness] == del_slot)
		{
			Player[p][pBusiness] = -1;
			SavePlayerAccount(p);
		}
		if(GetPlayerInBiz(p) == del_slot)
		{
			ExitPlayerFromBiz(p);
			SetPlayerPos(p, GetBusinessData(del_slot, B_POS_X), GetBusinessData(del_slot, B_POS_Y), GetBusinessData(del_slot, B_POS_Z) + 1.0);
		}
		else if(GetPlayerVirtualWorld(p) == Biz_GetInteriorVW(del_slot))
		{
			SetPlayerVirtualWorld(p, 0);
			SetPlayerInterior(p, 0);
		}
	}

	if(del_slot != last)
	{
		for(new E_BUSINESS_STRUCT:f; f < E_BUSINESS_STRUCT; f++)
		{
			g_business[del_slot][f] = g_business[last][f];
		}

		mysql_format(db_handle, q, sizeof q, "UPDATE players SET business=%d WHERE business=%d", del_slot, last);
		mysql_tquery(db_handle, q, "", "");

		for(new p2; p2 < MAX_PLAYERS; p2++)
		{
			if(!IsPlayerConnected(p2)) continue;
			if(Player[p2][pBusiness] == last)
			{
				Player[p2][pBusiness] = del_slot;
				SavePlayerAccount(p2);
			}
			if(GetPlayerInBiz(p2) == last)
			{
				SetPlayerInBiz(p2, del_slot);
				SetPlayerVirtualWorld(p2, Biz_GetInteriorVW(del_slot));
			}
		}

		g_business[del_slot][B_HEALTH_PICKUP] = 0;
		BusinessHealthPickupInit(del_slot);
		Shop247_SpawnForBusiness(del_slot);
		if(GetBusinessData(del_slot, B_TYPE) == BUSINESS_TYPE_SNACK)
			Snack_SpawnForBusiness(del_slot);
		UpdateBusinessLabel(del_slot);
	}

	for(new E_BUSINESS_STRUCT:z; z < E_BUSINESS_STRUCT; z++) g_business[last][z] = 0;
	Shop247_DestroyForBusiness(last);
	Snack_DestroyForBusiness(last);
	g_business_loaded--;
	return 1;
}

CMD:addbiz(playerid, params[])
{
	if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 5) return 1;
	ShowAddBizTypeDialog(playerid);
	return 1;
}

CMD:test(playerid, params[])
{
#pragma unused params

if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 13)
{
SendClientMessage(playerid, 0xFF5252FF, "[TEST] Access denied. Command is available only for level 13 admins.");
return 1;
}

new test_msg[144];
format(test_msg, sizeof test_msg, "[TEST] OK | admin=%s | playerid=%d | adminlvl=%d | auth=%d",
Player[playerid][pName],
playerid,
Player[playerid][pAdminLvl],
Player[playerid][pAdminAuth]
);
SendClientMessage(playerid, 0x66CC66FF, test_msg);
return 1;
}

public OnBusinessCreated(playerid, slot)
{
	if(slot < 0 || slot >= MAX_BUSINESS) return 1;

	new sql_id = cache_insert_id();
	if(sql_id <= 0)
	{
		printf("[Business] INSERT failed for slot %d (admin playerid %d)", slot, playerid);
		if(slot >= 0 && slot < g_business_loaded)
		{
			BusinessDestroyWorldObjects(slot);
			for(new E_BUSINESS_STRUCT:z; z < E_BUSINESS_STRUCT; z++)
				g_business[slot][z] = 0;
			if(slot == g_business_loaded - 1)
				g_business_loaded--;
		}
		if(IsPlayerConnected(playerid))
			SendClientMessage(playerid, 0xFF5252FF, "˜˜˜˜˜˜ MySQL: ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ business.");
		return 1;
	}

	g_business[slot][B_SQL_ID] = sql_id;
	UpdateBusinessLabel(slot);
	BusinessHealthPickupInit(slot);
	Shop247_SpawnForBusiness(slot);
	if(GetBusinessData(slot, B_TYPE) == BUSINESS_TYPE_SNACK)
		Snack_SpawnForBusiness(slot);

	if(IsPlayerConnected(playerid))
	{
		new msg[220];
		format(msg, sizeof msg,
			"{66CC33}˜˜˜˜˜˜ ˜˜˜˜˜˜: {FFFFFF}%s {66CC33}(ID: %d, ˜˜˜: %d, SQL: %d).",
			g_business[slot][B_NAME], slot + 1, Biz_GetInteriorVW(slot), sql_id);
		SendClientMessage(playerid, -1, msg);
	}
	return 1;
}

public OnSimNumberCheck(playerid, simnumber)
{
	if(!IsPlayerConnected(playerid)) return 1;

	if(cache_num_rows() > 0)
	{
		new busy_msg[80];
		format(busy_msg, sizeof busy_msg, "˜˜˜˜˜ %d ˜˜˜ ˜˜˜˜˜, ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.", simnumber);
		SendClientMessage(playerid, 0xCECECEFF, busy_msg);
		ShowSimCardBuyDialog(playerid);
		return 1;
	}

	new businessid = GetPlayerInBiz(playerid);
	if(businessid == -1) return 1;
	if(!IsPlayerInBuyPosBiz(playerid, businessid, BUSINESS_TYPE_SHOP_24_7))
		return SendClientMessage(playerid, 0xCECECEFF, "˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜, ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜."), 1;

	new price = 2000, take_prods = 5;
	if(GetPlayerMoneyEx(playerid) < price)
		return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜."), 1;

	if(IsSimNumberOnlineTaken(simnumber, playerid))
	{
		new busy_msg[80];
		format(busy_msg, sizeof busy_msg, "˜˜˜˜˜ %d ˜˜˜ ˜˜˜˜˜, ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.", simnumber);
		SendClientMessage(playerid, 0xCECECEFF, busy_msg);
		ShowSimCardBuyDialog(playerid);
		return 1;
	}

	if(!GivePlayerSimCardItem(playerid, simnumber))
		return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜."), 1;

	GivePlayerMoneyEx(playerid, -price);
	if(GetBusinessData(businessid, B_PRODS) >= take_prods)
	{
		AddBusinessData(businessid, B_PRODS, -, take_prods);
		AddBusinessData(businessid, B_BALANCE, +, price);
	}
	Biz_LogProfit(GetBusinessData(businessid, B_SQL_ID), playerid, price, _:IsBusinessOwned(businessid));
	Biz_SaveBusinessRow(businessid);

	new msg[120];
	format(msg, sizeof msg, "SIM %d ˜˜˜˜˜˜˜ ˜˜ %d ˜˜˜. (0 ˜˜.). ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.", simnumber, price);
	SendClientMessage(playerid, 0x66CC00FF, msg);
	Shop247_NotePurchase(playerid);
	Shop247_MarkShopDialogClosed(playerid);
	return 1;
}

CMD:delbiz(playerid, params[])
{
	if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 5) return 1;
	ShowPlayerDialog(playerid, DIALOG_BIZ_DEL_ID, DIALOG_STYLE_INPUT,
		"{FF5252}˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜",
		"˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜?\n\n˜˜˜˜˜˜˜ ID ˜˜˜˜˜˜˜:",
		"˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
	return 1;
}

stock Business_TeleportToEntrance(playerid, businessid)
{
	if(businessid < 0 || businessid >= g_business_loaded) return 0;

	Shop247_OnExitBiz(playerid);
	SetPlayerInBiz(playerid, -1);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerPos(playerid,
		GetBusinessData(businessid, B_POS_X),
		GetBusinessData(businessid, B_POS_Y),
		GetBusinessData(businessid, B_POS_Z) + 1.0);
	SetPlayerFacingAngle(playerid, 0.0);
	Streamer_UpdateEx(playerid,
		GetBusinessData(businessid, B_POS_X),
		GetBusinessData(businessid, B_POS_Y),
		GetBusinessData(businessid, B_POS_Z),
		0, 0, -1, -1, 0);
	return 1;
}

stock Business_AdminTeleport(playerid, businessid)
{
	if(businessid < 0 || businessid >= g_business_loaded) return 0;

	if(GetBusinessData(businessid, B_TYPE) == BUSINESS_TYPE_SHOP_24_7)
	{
		if(GetPlayerInBiz(playerid) != -1)
			ExitPlayerFromBiz(playerid);
		return EnterPlayerToBiz(playerid, businessid);
	}
	return Business_TeleportToEntrance(playerid, businessid);
}

CMD:biztp(playerid, params[])
{
	if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 5) return 1;
	if(strlen(params) > 0)
	{
		if(!IsNumeric(params))
			return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜˜˜˜˜˜: /biztp [ID] ˜˜˜ /biztp ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜."), 1;
		new businessid = strval(params);
		if(businessid < 1)
			return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜˜˜˜˜˜: /biztp [ID] (˜˜ 1)."), 1;
		businessid--;
		if(businessid < 0 || businessid >= g_business_loaded)
			return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ID ˜˜ ˜˜˜˜˜˜."), 1;
		Business_AdminTeleport(playerid, businessid);
		new bname[64], msg[180];
		GetAddBizNameByType(GetBusinessData(businessid, B_TYPE), bname, sizeof bname);
		format(msg, sizeof msg, "{66CC33}˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜: %s (ID: %d).", bname, businessid + 1);
		return SendClientMessage(playerid, -1, msg), 1;
	}
	ShowBizTPListDialog(playerid);
	return 1;
}

CMD:business(playerid, params[])
{
	#pragma unused params
	new businessid = GetPlayerBusiness(playerid);
	if(businessid == -1)
		return SendClientMessage(playerid, 0x999999FF, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜.");

	static const music_name[][16] = {"˜˜˜˜.", "˜˜˜˜ 1", "˜˜˜˜ 2", "˜˜˜˜ 3", "˜˜˜˜ 4", "˜˜˜˜ 5"};
	new em = GetBusinessData(businessid, B_ENTER_MUSIC);
	if(em > sizeof music_name - 1) em = sizeof music_name - 1;

	new fmt_str[512];
	format(fmt_str, sizeof fmt_str,
		"{FFFFFF}˜˜˜˜˜˜˜˜:\t{339999}%s\n˜˜˜˜˜:\t%d\n˜˜˜˜˜˜˜˜:\t%s\n˜˜˜˜:\t%d ˜˜˜\n˜˜˜˜˜˜˜˜:\t{66CC00}%d{FFFFFF} / {FF5252}%d\n˜˜˜˜ ˜˜˜˜˜˜:\t%d\n˜˜˜˜˜˜˜˜˜:\t%d\n˜˜˜˜˜˜:\t%d\n˜˜˜˜˜˜ (˜˜.):\t%d ˜˜ 30\n˜˜˜˜ ˜˜˜˜˜:\t%s\n˜˜˜. ˜˜˜˜:\t%d\n˜˜˜˜˜˜/˜˜˜˜:\t%d (%s)\n˜˜˜˜˜˜:\t%s\n\n{669966}˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜",
		GetBusinessData(businessid, B_NAME),
		businessid,
		GetBusinessData(businessid, B_OWNER_NAME),
		GetBusinessData(businessid, B_ENTER_PRICE),
		GetBusinessData(businessid, B_PRODS),
		GetBusinessMaxProd(businessid),
		GetBusinessData(businessid, B_PROD_PRICE),
		GetBusinessData(businessid, B_IMPROVEMENTS),
		GetBusinessData(businessid, B_BALANCE),
		GetBusinessData(businessid, B_RENT_DATE) <= gettime() ? 0 : GetElapsedTime(GetBusinessData(businessid, B_RENT_DATE), gettime(), CONVERT_TIME_TO_DAYS),
		music_name[em],
		GetBusinessData(businessid, B_PRICE),
		GetBusinessData(businessid, B_IMPROVEMENTS) < 3 ? GetBusinessData(businessid, B_RENT_PRICE) : GetBusinessData(businessid, B_RENT_PRICE) / 2,
		GetBusinessData(businessid, B_IMPROVEMENTS) < 3 ? ("˜˜˜˜˜˜") : ("˜˜˜˜˜˜˜˜"),
		GetBusinessData(businessid, B_LOCK_STATUS) ? ("{CC3333}˜˜˜˜˜˜") : ("{66CC33}˜˜˜˜˜˜")
	);
	ShowPlayerDialog(playerid, DIALOG_BIZ_INFO, DIALOG_STYLE_LIST, "{FF5252}˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜", fmt_str, "˜˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
	return 1;
}

CMD:buybiz(playerid, params[])
{
	#pragma unused params
	if(GetPlayerBusiness(playerid) != -1)
		return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜.");

	new businessid = GetNearestBusiness(playerid, 4.0);
	if(businessid == -1)
		return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜.");

	if(IsBusinessNoBuy(businessid))
		return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜ ˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜.");

	if(!RentPay_IsBuyable(GetBusinessData(businessid, B_EVICTION)))
	{
		new left_sec = GetBusinessData(businessid, B_EVICTION) - gettime();
		new left_h = left_sec / 3600;
		new left_m = (left_sec % 3600) / 60;
		new msg[128];
		format(msg, sizeof msg, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜: %d ˜. %d ˜˜˜.", left_h, left_m);
		return SendClientMessage(playerid, 0xCECECEFF, msg);
	}

	SetPVarInt(playerid, "buy_biz_id", businessid);
	new fmt_str[256];
	format(fmt_str, sizeof fmt_str,
		"{FFFFFF}%s\n˜˜˜˜:\t%d ˜˜˜\n˜˜˜˜˜˜:\t%d ˜˜˜/˜˜˜˜\n\n˜˜˜˜˜˜?",
		GetBusinessData(businessid, B_NAME),
		GetBusinessData(businessid, B_PRICE),
		GetBusinessData(businessid, B_RENT_PRICE));
	ShowPlayerDialog(playerid, DIALOG_BIZ_BUY, DIALOG_STYLE_MSGBOX, "{33AACC}˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜", fmt_str, "˜˜", "˜˜˜");
	return 1;
}

CMD:sellbiz(playerid, params[])
{
	#pragma unused params
	if(GetPlayerBusiness(playerid) == -1)
		return SendClientMessage(playerid, 0x999999FF, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜.");

	ShowPlayerDialog(playerid, DIALOG_BIZ_SELL, DIALOG_STYLE_MSGBOX, "{FF5252}˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜",
		"{FFFFFF}˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜?\n\n"\
		"{FFFFFF}˜˜˜ ˜˜˜˜˜˜˜˜ {66CC33}70%%{FFFFFF} ˜˜ ˜˜˜. ˜˜˜˜ ˜˜˜˜˜˜˜.\n"\
		"{FFFFFF}˜˜˜˜ {66CC33}60%%{FFFFFF} ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.\n\n"\
		"{AAAAAA}˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ (˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜).",
		"˜˜", "˜˜˜˜˜˜");
	return 1;
}

CMD:bizmusic(playerid, params[])
{
	#pragma unused params
	new businessid = GetPlayerBusiness(playerid);
	if(businessid == -1) return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜ ˜˜˜˜˜˜˜.");
	if(GetBusinessData(businessid, B_IMPROVEMENTS) < 4)
		return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜ 4-˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.");

	new str[256], tmp[24];
	format(str, sizeof str, CAR_CLR_WHITE "1. ˜˜˜˜˜˜˜˜\n");
	for(new idx = 1; idx <= sizeof g_business_sound; idx++)
	{
		format(tmp, sizeof tmp, CAR_CLR_WHITE "%d. ˜˜˜˜ ˜" CAR_CLR_GOLD "%d\n", idx + 1, idx);
		strcat(str, tmp);
	}
	ShowPlayerDialog(playerid, DIALOG_BIZ_ENTER_MUSIC, DIALOG_STYLE_LIST, CAR_DLG_PREFIX "˜˜˜˜ ˜˜˜ ˜˜˜˜˜", str, "˜˜˜˜˜˜˜", "˜˜˜˜˜˜˜");
	return 1;
}

CMD:buy(playerid, params[])
{
	#pragma unused params
	if(Snack_TryOpenFromBuyCmd(playerid))
		return 1;
	return Shop247_CmdBuy(playerid);
}

CMD:biz(playerid, params[])
{
	#pragma unused params
	new businessid = GetNearestBusiness(playerid, 5.0);
	if(businessid == -1) return SendClientMessage(playerid, 0xCECECEFF, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜.");
	new msg[180];
	format(msg, sizeof msg, "%s | ˜˜˜˜: %d$ | ˜˜˜˜˜˜˜˜˜: %d | ˜˜˜: %d",
		GetBusinessData(businessid, B_NAME),
		GetBusinessData(businessid, B_ENTER_PRICE),
		GetBusinessData(businessid, B_PRODS),
		GetBusinessData(businessid, B_TYPE));
	SendClientMessage(playerid, 0xFFFFFFFF, msg);
	return 1;
}

