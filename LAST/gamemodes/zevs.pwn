stock Tune_GetModelBaseMaxSpeed(model)
{
    if(model < 400 || model > 611) return 150;
    new spd = gTuneModelMaxSpeed[model - 400];
    if(spd <= 0) spd = 150;
    return spd;
}

stock SetVehicleChipTuneForPlayer(playerid, vehicleid, chip_type)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, 20);
    BS_WriteValue(bs, PR_UINT32, chip_type);
    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock SetVehicleChipTune(vehicleid, chip_type)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
            SetVehicleChipTuneForPlayer(i, vehicleid, chip_type);
    }
    return 1;
}

stock BR_SetVehMaxSpeedPl(playerid, vehicleid, Float:max_kmh)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT8, BR_PACKET_CUSTOMRPC);
    BS_WriteValue(bs, PR_UINT32, BR_RPC_CUSTOM_HANDLING);
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, 1);
    BS_WriteValue(bs, PR_UINT8, BR_HP_MAX_SPEED);
    BS_WriteValue(bs, PR_FLOAT, max_kmh);
    PR_SendPacket(bs, playerid, PR_HIGH_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock BR_ResetVehHandlingPl(playerid, vehicleid)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT8, BR_PACKET_CUSTOMRPC);
    BS_WriteValue(bs, PR_UINT32, BR_RPC_CUSTOM_HANDLING_DEFAULTS);
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    PR_SendPacket(bs, playerid, PR_HIGH_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock SetVehicleMaxSpeedTune(vehicleid, Float:max_kmh)
{
    if(vehicleid < 0 || vehicleid >= MAX_VEHICLES) return 0;
    g_VehTuneMaxCap[vehicleid] = floatround(max_kmh);
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
            BR_SetVehMaxSpeedPl(i, vehicleid, max_kmh);
    }
    return 1;
}

stock ResetVehicleTunePhysics(vehicleid)
{
    if(vehicleid < 0 || vehicleid >= MAX_VEHICLES) return 0;
    g_VehTuneMaxCap[vehicleid] = 0;
    SetVehicleChipTune(vehicleid, TUNE_CHIP_DEFAULT);
    SetVehicleAcceleration(vehicleid, 0.0);
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
            BR_ResetVehHandlingPl(i, vehicleid);
    }
    return 1;
}

stock ApplyVehicleTuneMode(vehicleid, tune_mode)
{
    if(vehicleid <= 0) return 0;

    new model = GetVehicleModel(vehicleid);
    new base_spd = Tune_GetModelBaseMaxSpeed(model);
    new chip = TUNE_CHIP_DEFAULT;
    new Float:accel = 0.0;
    new bonus = 0;

    switch(tune_mode)
    {
        case TUNE_MODE_COMFORT:
        {
            chip = TUNE_CHIP_COMFORT;
            accel = 31.8;
            bonus = TUNE_SPEED_BONUS_COMFORT;
        }
        case TUNE_MODE_SPORT:
        {
            chip = TUNE_CHIP_SPORT;
            accel = 35.0;
            bonus = TUNE_SPEED_BONUS_SPORT;
        }
        case TUNE_MODE_SPORTPLUS:
        {
            chip = TUNE_CHIP_SPORTPLUS;
            accel = 36.0;
            bonus = TUNE_SPEED_BONUS_SPORTPLUS;
        }
        case TUNE_MODE_DRIFT:
        {
            chip = TUNE_CHIP_DRIFT;
            accel = 0.0;
            bonus = 0;
        }
        default:
        {
            ResetVehicleTunePhysics(vehicleid);
            return 1;
        }
    }

    SetVehicleChipTune(vehicleid, chip);
    SetVehicleAcceleration(vehicleid, accel);
    if(bonus > 0)
        SetVehicleMaxSpeedTune(vehicleid, float(base_spd + bonus));
    else
    {
        g_VehTuneMaxCap[vehicleid] = 0;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(IsPlayerConnected(i))
                BR_ResetVehHandlingPl(i, vehicleid);
        }
    }
    return 1;
}

stock SetVehicleAcceleration(vehicleid, Float:accel)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i)) 
        {
            SetVehicleAccelerationForPlayer(i, vehicleid, accel);
        }
    }
}

stock SetVehicleAccelerationForPlayer(playerid, vehicleid, Float:accel)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, 5);

    BS_WriteValue(bs, PR_FLOAT, accel);

    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}

CMD:comforton(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1 || !IsFullSetInstalled(VehicleInfo[playerid][slot][vComfort])) return 0;
    ApplyVehicleTuneMode(vehicleid, TUNE_MODE_COMFORT);
    VehSetFlag(playerid, slot, VF_COMFORTA, true);
    return 1;
}

CMD:comfortoff(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1) return 0;
    ResetVehicleTunePhysics(vehicleid);
    VehSetFlag(playerid, slot, VF_COMFORTA, false);
    new Node:json_radial_data = JSON_Object();
    JSON_SetInt(json_radial_data, "s", 0);
    OnPacketIncoming(playerid, 27, json_radial_data);
    JSON_Cleanup(json_radial_data);
    return 1;
}

CMD:sporton(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1 || !IsFullSetInstalled(VehicleInfo[playerid][slot][vSport])) return 0;
    ApplyVehicleTuneMode(vehicleid, TUNE_MODE_SPORT);
    VehSetFlag(playerid, slot, VF_SPORTA, true);
    return 1;
}

CMD:sportoff(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1) return 0;
    ResetVehicleTunePhysics(vehicleid);
    VehSetFlag(playerid, slot, VF_SPORTA, false);
    new Node:json_radial_data = JSON_Object();
    JSON_SetInt(json_radial_data, "s", 0);
    OnPacketIncoming(playerid, 27, json_radial_data);
    JSON_Cleanup(json_radial_data);
    return 1;
}

CMD:sportpluson(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1 || !IsFullSetInstalled(VehicleInfo[playerid][slot][vSportPlus])) return 0;
    ApplyVehicleTuneMode(vehicleid, TUNE_MODE_SPORTPLUS);
    VehSetFlag(playerid, slot, VF_SPORTPLUSA, true);
    return 1;
}

CMD:sportplusoff(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1) return 0;
    ResetVehicleTunePhysics(vehicleid);
    VehSetFlag(playerid, slot, VF_SPORTPLUSA, false);
    new Node:json_radial_data = JSON_Object();
    JSON_SetInt(json_radial_data, "s", 0);
    OnPacketIncoming(playerid, 27, json_radial_data);
    JSON_Cleanup(json_radial_data);
    return 1;
}

CMD:drifton(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1 || !IsFullSetInstalled(VehicleInfo[playerid][slot][vDrift])) return 0;
    ApplyVehicleTuneMode(vehicleid, TUNE_MODE_DRIFT);
    SetVehicleDriftMode(playerid, vehicleid, true);
    VehSetFlag(playerid, slot, VF_DRIFTA, true);
    return 1;
}

CMD:driftoff(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1) return 0;
    ResetVehicleTunePhysics(vehicleid);
    SetVehicleDriftMode(playerid, vehicleid, false);
    VehSetFlag(playerid, slot, VF_DRIFTA, false);
    new Node:json_radial_data = JSON_Object();
    JSON_SetInt(json_radial_data, "s", 0);
    OnPacketIncoming(playerid, 27, json_radial_data);
    JSON_Cleanup(json_radial_data);
    return 1;
}

CMD:tuningoff(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), slot = GetPlayerVehicleSlot(playerid, vehicleid);
    ResetVehicleTunePhysics(vehicleid);
    SetVehicleDriftMode(playerid, vehicleid, false);
    if(slot != -1)
    {
        VehSetFlag(playerid, slot, VF_SPORTA, false);
        VehSetFlag(playerid, slot, VF_DRIFTA, false);
        VehSetFlag(playerid, slot, VF_COMFORTA, false);
        VehSetFlag(playerid, slot, VF_SPORTPLUSA, false);
    }
    new Node:json_radial_data = JSON_Object();
    JSON_SetInt(json_radial_data, "s", 0);
    OnPacketIncoming(playerid, 27, json_radial_data);
    JSON_Cleanup(json_radial_data);
    return 1;
}

stock SetVehicleDriftMode(playerid, vehicleid, bool:status)
{
    new BitStream:bs = BS_New();

    BS_WriteValue(bs, PR_UINT8, 5); 
    
    BS_WriteValue(bs, PR_UINT16, vehicleid);

    BS_WriteValue(bs, PR_UINT8, (status) ? 1 : 0);

    PR_SendRPC(bs, playerid, 168, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);

    BS_Delete(bs);
    return 1;
}
