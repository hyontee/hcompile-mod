CMD:givecash(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 4) return 1; // ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜
    new targetid, amount, str[128];
    if(sscanf(params, "ui", targetid, amount)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /givecash [id] [˜˜˜˜˜]");
    if(!IsPlayerConnected(targetid)) return 1;

    GivePlayerMoneyEx(targetid, amount);

    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜ ˜˜˜ %d ˜˜˜˜˜˜.", Player[playerid][pName], playerid, amount);
    SendClientMessage(targetid, ADMIN_COLOR, str);
    format(str, sizeof(str), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d] %d ˜˜˜˜˜˜.", Player[targetid][pName], targetid, amount);
    SendClientMessage(playerid, -1, str);
    return 1;
}

CMD:givedonate(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 5) return 1;
    new targetid, amount, str[128];
    if(sscanf(params, "ui", targetid, amount)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /givedonate [id] [˜˜˜˜˜]");
    if(!IsPlayerConnected(targetid)) return 1;

    GivePlayerBlackCoin(targetid, amount);

    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜ ˜˜˜ %d BlackCoins.", Player[playerid][pName], playerid, amount);
    SendClientMessage(targetid, ADMIN_COLOR, str);
    format(str, sizeof(str), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d] %d BlackCoins.", Player[targetid][pName], targetid, amount);
    SendClientMessage(playerid, -1, str);
    return 1;
}

stock GivePlayerVip(targetid, viptype, days)
{
    if(!IsPlayerConnected(targetid) || Player[targetid][pID] <= 0) return 0;

    if(days <= 0)
    {
        Player[targetid][pVipType] = 0;
        Player[targetid][pVipTime] = 0;
    }
    else
    {
        if(viptype < 1 || viptype > 3) return 0;
        Player[targetid][pVipType] = viptype;
        Player[targetid][pVipTime] = days * 86400;
    }

    SavePlayerAccount(targetid);
    return 1;
}

CMD:givevip(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 7)
        return SendClientMessage(playerid, COLOR_GREY, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜˜.");

    new targetid, premium, days, msg[196];
    if(sscanf(params, "udd", targetid, premium, days))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /givevip [id ˜˜˜˜˜˜] [˜˜˜˜˜˜˜ 1-3] [˜˜˜ 0-30]");

    if(!IsPlayerConnected(targetid) || Player[targetid][pID] <= 0)
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜.");

    if(days < 0 || days > 30)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜ 0 ˜˜ 30 (0 ˜ ˜˜˜˜˜˜˜ VIP).");

    if(days == 0)
    {
        GivePlayerVip(targetid, 0, 0);

        format(msg, sizeof(msg), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s ˜˜˜˜˜˜ ˜˜˜ VIP-˜˜˜˜˜˜.", Player[playerid][pName]);
        SendClientMessage(targetid, -1, msg);
        format(msg, sizeof(msg), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜˜ VIP ˜ ˜˜˜˜˜˜ %s[%d].", Player[targetid][pName], targetid);
        SendClientMessage(playerid, -1, msg);
        return 1;
    }

    if(premium < 1 || premium > 3)
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜ VIP: 1 ˜ Silver, 2 ˜ Gold, 3 ˜ Platinum.");

    if(!GivePlayerVip(targetid, premium, days))
        return SendClientMessage(playerid, COLOR_RED, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ VIP.");

    new vip_name[24];
    switch(premium)
    {
        case 1: vip_name = "Silver";
        case 2: vip_name = "Gold";
        case 3: vip_name = "Platinum";
        default: vip_name = "VIP";
    }

    format(msg, sizeof(msg), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s ˜˜˜˜˜ ˜˜˜ VIP %s ˜˜ %d ˜˜.", Player[playerid][pName], vip_name, days);
    SendClientMessage(targetid, -1, msg);
    format(msg, sizeof(msg), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜ %s[%d] VIP %s ˜˜ %d ˜˜.", Player[targetid][pName], targetid, vip_name, days);
    SendClientMessage(playerid, -1, msg);
    return 1;
}

stock Pass_ShowPassportDialog(viewerid, ownerid)
{
    if(!IsPlayerConnected(viewerid) || !IsPlayerConnected(ownerid)) return 0;
    if(Player[ownerid][pID] <= 0) return 0;

    new gender[16], house[48], org[48], pos[48], body[640];

    MM_GetPlayerGender(ownerid, gender, sizeof(gender));
    MM_GetPlayerHouseLabel(ownerid, house, sizeof(house));

    if(Player[ownerid][pFamilyId] > 0 && Player[ownerid][pFamilyName][0])
        format(org, sizeof(org), "%s", Player[ownerid][pFamilyName]);
    else format(org, sizeof(org), "˜˜˜˜˜˜˜˜˜˜˜");

    if(Player[ownerid][pFamilyId] > 0 && Player[ownerid][pFamilyRank] > 0)
        format(pos, sizeof(pos), "%d", Player[ownerid][pFamilyRank]);
    else format(pos, sizeof(pos), "˜˜˜˜˜˜˜˜˜˜˜");

    format(body, sizeof(body),
        "{FFFFFF}˜˜˜:\t\t\t\t{FFCC00}%s\n\
        {FFFFFF}˜˜˜˜˜˜˜:\t\t\t{FFCC00}%d\n\
        {FFFFFF}˜˜˜:\t\t\t\t{FFCC00}%s\n\
        {FFFFFF}˜˜˜˜˜˜˜˜˜˜:\t\t\t{FFCC00}%s\n\
        {FFFFFF}˜˜˜˜˜˜:\t\t\t\t{FFCC00}˜˜ ˜˜˜˜˜˜˜\n\
        {FFFFFF}˜˜˜˜˜˜˜˜˜˜˜:\t\t\t{FFCC00}%s\n\
        {FFFFFF}˜˜˜˜˜˜˜˜˜:\t\t\t{FFCC00}%s",
        Player[ownerid][pName],
