                        if(old_wheel > 0) RemoveVehicleComponent(vehicleid_w, old_wheel);
                        VehicleInfo[playerid][vw][vWheel] = tune_comp;
                        VehicleInfo[playerid][vw][vWheelModel] = tune_comp;
