                new fromid = nveh;
                if(!IsPlayerConnected(fromid) || Player[fromid][pID] <= 0)
                    ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜.", "");
                else
                    Trade_AcceptInvite(playerid, fromid);
            }
            else if(nid == NOTIFY_BANK_ATM)
            {
                if(!Shop247_HandleNotifyAtm(playerid, nid))
                    Bank_HandleNotifyPacket(playerid, nid);
            }
