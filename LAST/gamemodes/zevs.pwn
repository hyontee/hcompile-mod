stock bool:Sto_IsPlayerAtEntry(playerid, Float:range = 5.0)
{
    for(new i = 0; i < STO_ENTRY_COUNT; i++)
    {
        if(IsPlayerInRangeOfPoint(playerid, range,
            g_StoEntryPos[i][0], g_StoEntryPos[i][1], g_StoEntryPos[i][2]))
            return true;
    }
    return false;
}

stock Sto_InitWorld()
{
    for(new i = 0; i < STO_ENTRY_COUNT; i++)
    {
        CreateDynamic3DTextLabel(
            "{f6fa05}˜˜˜\n{ffffff}˜˜˜˜˜˜˜: {e81717}'˜˜˜˜˜' {ffffff}˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜",
            0xFFFFFFFF,
            g_StoEntryPos[i][0], g_StoEntryPos[i][1], g_StoEntryPos[i][2] + 0.35,
            12.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
    }
    return 1;
}

stock bool:Sto_TryOpen(playerid)
{
    if(gInStoSession[playerid] || gInShinkaSession[playerid] || InStailing[playerid]) return false;

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
    {
        SendClientMessage(playerid, 0xFF6347FF, "˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");
        return false;
    }

    new slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1)
    {
        SendClientMessage(playerid, 0xFF6347FF, "˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");
        return false;
    }
    if(VehicleInfo[playerid][slot][vDBID] <= 0)
    {
        SendClientMessage(playerid, 0xFFFF00FF, "˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜ /car.");
        return false;
    }

    new Float:ex, Float:ey, Float:ez, Float:ea;
    GetVehiclePos(vehicleid, ex, ey, ez);
    GetVehicleZAngle(vehicleid, ea);
    SetPVarFloat(playerid, "sto_ret_x", ex);
    SetPVarFloat(playerid, "sto_ret_y", ey);
    SetPVarFloat(playerid, "sto_ret_z", ez);
    SetPVarFloat(playerid, "sto_ret_a", ea);

    Ts_SnapFuelMileage(playerid, vehicleid);
    Fuel_ForceEngineOff(vehicleid);
    LaunchControl_ForceOff(playerid, vehicleid, playerid, slot);

    new model = GetVehicleModel(vehicleid);
    new tune_model = Tune_GetTuneItemsModelId(model);
    new price = Tune_ResolveVehicleGosCost(playerid, slot, model);
    Tune_SetSessionGosCost(playerid, price);

    new Node:tuning_json = JSON_Object();
    InStailing[playerid] = false;
    gInShinkaSession[playerid] = false;
    gInStoSession[playerid] = true;

    JSON_SetInt(tuning_json, "o", 1);
    JSON_SetInt(tuning_json, "w", TUNE_SCREEN_STO);
    JSON_SetInt(tuning_json, "j", price);
    JSON_SetInt(tuning_json, "s", tune_model);
    SetPVarInt(playerid, "sto_tune_model", tune_model);
    JSON_SetString(tuning_json, "nm", GetPlayerNameEx(playerid));
    JSON_SetString(tuning_json, "n", GetVehicleNameByModel(model));
    JSON_SetInt(tuning_json, "m", GetPlayerMoneyEx(playerid));
    JSON_SetInt(tuning_json, "dn", GetPlayerBlackCoin(playerid));
    JSON_SetInt(tuning_json, "bc", VehicleInfo[playerid][slot][vBodyColor]);
    JSON_SetInt(tuning_json, "dc", VehicleInfo[playerid][slot][vDiskColor]);
    new Node:diag_arr = JSON_Array();
    Sto_InitDiagnosticWear(playerid, slot, model);
    Sto_BuildDiagnosticJsonArray(playerid, slot, diag_arr);
    JSON_SetArray(tuning_json, "d", diag_arr);
    JSON_SetArray(tuning_json, "k", Tune_BuildVehicleKArray(playerid, slot));

    new vw = playerid + STO_INTERIOR_VW_BASE;
    SetPlayerInterior(playerid, 1);
    SetPlayerVirtualWorld(playerid, vw);
    SetVehicleVirtualWorld(vehicleid, vw);
    SetVehiclePos(vehicleid, STO_CAR_X, STO_CAR_Y, STO_CAR_Z);
    SetVehicleZAngle(vehicleid, STO_CAR_A);
    PutPlayerInVehicle(playerid, vehicleid, 0);

    SetPlayerCameraPos(playerid, STO_CAM_X, STO_CAM_Y, STO_CAM_Z);
    SetPlayerCameraLookAt(playerid, STO_CAM_LX, STO_CAM_LY, STO_CAM_LZ);

    Tune_BkApplyAllForPlayer(playerid, vehicleid, playerid, slot);
    OnPacketIncoming(playerid, 28, tuning_json);
    return true;
}

CMD:sto(playerid, params[])
{
    if(!Sto_IsPlayerAtEntry(playerid, 5.0))
        return SendClientMessage(playerid, 0xFF6347FF, "˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜.");
    Sto_TryOpen(playerid);
    return 1;
}
// ----- end: sto.inc -----

// ----- begin: stailing.inc -----
CMD:tungui(playerid, params[])
{
    if(gInStoSession[playerid] || gInShinkaSession[playerid]) return 1;

    new vehicleid = GetPlayerVehicleID(playerid);
    if(!vehicleid) return SendClientMessage(playerid, -1, "{FF0000}˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜.");

    new slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if(slot == -1)
        return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜!");
    if(VehicleInfo[playerid][slot][vDBID] <= 0)
        return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜ /car.");

    Ts_SnapFuelMileage(playerid, vehicleid);
    Fuel_ForceEngineOff(vehicleid);
    new model = GetVehicleModel(vehicleid);
    new price = Tune_ResolveVehicleGosCost(playerid, slot, model);
    Tune_SetSessionGosCost(playerid, price);
    LaunchControl_ForceOff(playerid, vehicleid, playerid, slot);
    new Node:tuning_json = JSON_Object();

    InStailing[playerid] = true;
    gInShinkaSession[playerid] = false;
    gInStoSession[playerid] = false;
    gShinkaStartWheel[playerid] = 0;

    JSON_SetInt(tuning_json, "o", 1);
    JSON_SetInt(tuning_json, "w", TUNE_SCREEN_STYLING);
    JSON_SetInt(tuning_json, "j", price); 
    JSON_SetInt(tuning_json, "s", 5);

    JSON_SetString(tuning_json, "nm", GetPlayerNameEx(playerid));
    JSON_SetString(tuning_json, "n", GetVehicleNameByModel(model));
    JSON_SetInt(tuning_json, "m", GetPlayerMoneyEx(playerid));
    JSON_SetInt(tuning_json, "dn", GetPlayerBlackCoin(playerid));
    JSON_SetInt(tuning_json, "bc", VehicleInfo[playerid][slot][vBodyColor]);
    JSON_SetInt(tuning_json, "dc", VehicleInfo[playerid][slot][vDiskColor]);
    new Node:open_colors = JSON_Array();
    Tune_AppColorStartArr(playerid, slot, open_colors);
    JSON_SetArray(tuning_json, "a", open_colors);
    JSON_SetArray(tuning_json, "k", Tune_BuildVehicleKArray(playerid, slot));
    Tune_SaveStylingEntryColors(playerid, slot);
    Tune_ClearActivePaintSelector(playerid);
    if(VehicleInfo[playerid][slot][vBodyColor] != 0)
        Tune_StorePreviewPaintArgb(playerid, VehicleInfo[playerid][slot][vBodyColor]);

    SetPlayerInterior(playerid, 1);

    new carid = GetPlayerVehicleID(playerid);
    if (carid != 0)
    {
        SetVehiclePos(carid, 1000.0, 1500.0, 1498.0);
        SetVehicleZAngle(carid, 180.0);
    }

    SetPlayerCameraPos(playerid, 1003.9196, 1493.9724, 1499.7500);
    SetPlayerCameraLookAt(playerid, 1003.3480, 1494.7935, 1499.5002);

    OnPacketIncoming(playerid, 28, tuning_json);

    return 1;
}

stock GetBodyPaintCost(price)
{
    return (price / 100) + 10000;
}

stock GetUnivCost(price)
{
    return (price / 100) + 10000 + 40000;
}

stock GetDalniyCost(price)
{
    return (price / 1000) + 10000;
}
stock GetDoubleCost(price)
{
    return ((price / 100) + 10000) * 2;
}

stock GetExtraCost(price)
{
    return (price / 100) + 10000 + 10000;
}

stock GetDonatCost(price)
{
    return (((price / 100) + 10000 + 40000) * 3) / 1000;
}
// ----- end: stailing.inc -----

