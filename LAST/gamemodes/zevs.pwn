stock AddPlayerDustValue(playerid, amount)
{
    new dust = GetPVarInt(playerid, "player_dust");
    dust += amount;
    if(dust < 0) dust = 0;

    if(amount > 0 && dust >= DUST_SPECIAL_CASE_COST)
    {
        new granted_cases = dust / DUST_SPECIAL_CASE_COST;
        dust -= granted_cases * DUST_SPECIAL_CASE_COST;

        AddPlayerCaseCountByType(playerid, 5, granted_cases);
        MarkSpecialCaseUiPending(playerid);
        if(Player[playerid][pID] > 0) Cases_SaveCounts(playerid);
        Cases_PushInventoryToClient(playerid);

        new dust_case_msg[144];
        if(granted_cases == 1) format(dust_case_msg, sizeof(dust_case_msg), "˜˜ ˜˜˜˜˜˜˜˜ 2000 ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜!");
        else format(dust_case_msg, sizeof(dust_case_msg), "˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜: %d ˜˜.", granted_cases);
        ShowNotification(playerid, 3, 6, 1, 0, dust_case_msg, "");
    }

    SetPVarInt(playerid, "player_dust", dust);
    return dust;
}

stock GetPlayerCaseCountByType(playerid, case_type)
{
    switch(case_type)
    {
        case 1: return Player[playerid][pCountTodayCases];
        case 2: return Player[playerid][pCountBomjCases];
        case 3: return Player[playerid][pCountStandartCases];
        case 4: return Player[playerid][pCountCarCases];
        case 5: return Player[playerid][pCountOsobiyCases];
    }
    return 0;
}

stock SetPlayerCaseCountByType(playerid, case_type, value)
{
    if(value < 0) value = 0;

    switch(case_type)
    {
        case 1: { Player[playerid][pCountTodayCases] = value; return 1; }
        case 2: { Player[playerid][pCountBomjCases] = value; return 1; }
        case 3: { Player[playerid][pCountStandartCases] = value; return 1; }
        case 4: { Player[playerid][pCountCarCases] = value; return 1; }
        case 5: { Player[playerid][pCountOsobiyCases] = value; return 1; }
    }
    return 0;
}

stock AddPlayerCaseCountByType(playerid, case_type, amount)
{
    return SetPlayerCaseCountByType(playerid, case_type, GetPlayerCaseCountByType(playerid, case_type) + amount);
}

// GUI 73: cc/pr ˜ ˜˜˜ copy/include/system/cases.inc (˜˜˜˜˜˜˜˜˜ JSON_Array + OnPacketIncoming).
#include "../include/system/cases_gui.inc"

// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ players (˜˜. mode/sql/rewards_install.sql).
stock Cases_SaveCounts(playerid)
{
    if(Player[playerid][pID] <= 0) return 0;

    new case_query[256];
    mysql_format(db_handle, case_query, sizeof(case_query),
        "UPDATE `players` SET `counttodaycases`=%d, `countbomjcases`=%d, `countstandartcases`=%d, \
        `countcarcases`=%d, `countosobiycases`=%d WHERE `id`=%d",
        Player[playerid][pCountTodayCases],
        Player[playerid][pCountBomjCases],
        Player[playerid][pCountStandartCases],
        Player[playerid][pCountCarCases],
        Player[playerid][pCountOsobiyCases],
        Player[playerid][pID]
    );
    mysql_tquery(db_handle, case_query, "", "");
    return 1;
}

stock Cases_GivePlayer(playerid, case_type, count)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(case_type < 1 || case_type > 5 || count <= 0) return 0;

    AddPlayerCaseCountByType(playerid, case_type, count);

    if(Player[playerid][pID] > 0)
    {
        Cases_SaveCounts(playerid);
        SavePlayerAccount(playerid);
    }
    Cases_PushInventoryToClient(playerid);
    return 1;
}

// BuildPlayerCasesArray, Cases_SendOpenGui, Cases_SendSyncPacket ˜ cases_gui.inc (copy/cases.inc).

stock Cases_PushInventoryToClient(playerid)
{
    return Cases_SendSyncPacket(playerid, 1);
}

stock SyncPlayerCasesInventoryPacket(playerid)
{
    return Cases_PushInventoryToClient(playerid);
}

CMD:cases(playerid, params[])
{
    #pragma unused params
    printf("[Cases] CMD:cases %s[%d] cot5=%d", Player[playerid][pName], playerid, GetPlayerCaseCountByType(playerid, 5));
    if(Cases_SendOpenGui(playerid)) return 1;
    return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜: ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ (˜˜˜˜˜˜˜˜˜˜˜)."), 0;
}

CMD:givecases(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 5)
        return SendClientMessage(playerid, COLOR_GREY, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜˜.");

    new targetid, type_case, count;
    if(sscanf(params, "uii", targetid, type_case, count))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /givecases [id] [˜˜˜ 1-5] [˜˜˜-˜˜]");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜.");

    if(Player[targetid][pID] <= 0)
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜.");

    if(type_case < 1 || type_case > 5)
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜ ˜˜˜˜˜: 1-5 (1-˜˜˜˜˜˜˜, 2-˜˜˜˜, 3-˜˜˜˜˜˜˜˜, 4-˜˜˜˜, 5-˜˜˜˜˜˜).");

    if(count <= 0 || count > 10000)
        return SendClientMessage(playerid, COLOR_RED, "˜˜˜˜˜˜˜˜˜˜: ˜˜ 1 ˜˜ 10000.");

    AddPlayerCaseCountByType(targetid, type_case, count);
    Cases_SaveCounts(targetid);
    SavePlayerAccount(targetid);
    Cases_PushInventoryToClient(targetid);

    new str[144];
    format(str, sizeof(str), "˜˜ ˜˜˜˜˜˜ %d ˜˜˜˜(˜˜) ˜˜˜˜ %d ˜˜˜˜˜˜ %s[%d]. ˜˜˜˜˜ ˜ ˜˜˜˜: %d.",
        count, type_case, Player[targetid][pName], targetid, GetPlayerCaseCountByType(targetid, type_case));
    SendClientMessage(playerid, COLOR_WHITE, str);

    format(str, sizeof(str), "˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ %d ˜˜˜˜(˜˜) ˜˜˜˜ %d.", count, type_case);
    SendClientMessage(targetid, COLOR_WHITE, str);

    new notify[96];
    format(notify, sizeof(notify), "+%d ˜˜˜˜(˜˜), ˜˜˜ %d", count, type_case);
    ShowNotification(targetid, 1, 5, 0, 1, notify, "");
    return 1;
}

// ˜˜˜˜˜˜: initJson ˜ t==0 ˜˜˜˜˜˜˜, t!=0 Black Market; updateJson ˜ t=1 ˜˜˜˜˜˜, t=2 ˜˜˜˜˜˜˜˜.
// o==1 ˜ openingScreen (˜˜˜˜˜˜ init), o==0 ˜ onPacketIncoming (˜˜˜˜˜˜ updateJson).
stock Rewards_GetOutboundJsonType(playerid, &open_gui)
{
    if(GetPVarInt(playerid, "reward_refresh_after_take") != 0)
    {
        open_gui = 0;
        new pt = GetPVarInt(playerid, "reward_packet_t");
        return (pt > 0) ? pt : 1;
    }
    new pt = GetPVarInt(playerid, "reward_packet_t");
    if(pt == 2)
    {
        open_gui = 0;
        return 2;
    }
    open_gui = 1;
    return GetPVarInt(playerid, "reward_request_type");
}

stock ClearRewardListPacketType(playerid)
{
    if(GetPVarInt(playerid, "reward_packet_t") != 0)
        DeletePVar(playerid, "reward_packet_t");
}

// ˜˜˜˜˜˜ BpRewardsValue: tn=2 (USER_HAS_TANPIN) ˜ ˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜/˜˜˜˜˜˜, tn=1 (USER_HAS_NO_TANPIN) ˜ ˜˜˜˜˜.
stock Rewards_SetHasMorePVar(playerid, rows, bool:is_append)
{
    new has_more;
    if(is_append)
        has_more = (rows >= REWARDS_QUERY_LIMIT);
    else
        has_more = (rows > REWARDS_PAGE_SIZE);
    SetPVarInt(playerid, "reward_has_more", has_more ? 1 : 0);
}

stock Rewards_ApplyTanpinToJson(Node:json, playerid)
{
    JSON_SetInt(json, "tn", GetPVarInt(playerid, "reward_has_more") ? 2 : 1);
}

stock Rewards_SendTanpinOnly(playerid)
{
    new Node:obj = JSON_Object();
    JSON_SetInt(obj, "t", 2);
    JSON_SetInt(obj, "o", 0);
    Rewards_ApplyTanpinToJson(obj, playerid);
    JSON_SetArray(obj, "pr", JSON_Array());
    OnPacketIncoming(playerid, 74, obj);
    JSON_Cleanup(obj);
}

// GUI 74: ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ switch ˜ ˜ Pawn break ˜˜ ˜˜˜˜˜˜˜˜˜ switch ˜˜˜˜˜˜ switch(guiid) ˜˜˜ error 024.
stock Rewards_HandleGuiPacket(playerid, Node:json)
{
    new type;
    JSON_GetInt(json, "t", type);
    #if defined REWARDS_DEBUG_PACKET_LOG
        printf("[IPacket:74] %s[%d] t=%d", Player[playerid][pName], playerid, type);
    #endif

    if(type == 3)
    {
        JSON_SetInt(json, "c", 1);
        callcmd::cases(playerid, "");
    }
    else if(type == 5)
    {
        Rewards_SendTanpinOnly(playerid);
    }
    else if(type == 1)
    {
        SetPVarInt(playerid, "reward_request_type", 0);

        new filter_state = 0;
        JSON_GetInt(json, "fl", filter_state);
        if(filter_state < 1 || filter_state > 7) filter_state = 1;
        SetPVarInt(playerid, "reward_case_filter", filter_state);

        SetPVarInt(playerid, "reward_offset", REWARDS_QUERY_LIMIT);
        SetPVarInt(playerid, "reward_packet_t", 1);

        new query[160];
        mysql_format(db_handle, query, sizeof(query),
            "SELECT `id`, `award_id`, `case_id` FROM `rewards` WHERE `uid` = %d ORDER BY `id` DESC LIMIT 0, %d",
            Player[playerid][pID], REWARDS_QUERY_LIMIT);
        mysql_tquery(db_handle, query, "OnPlayerRewardsLoad", "i", playerid);
    }
    else if(type == 2)
    {
        SetPVarInt(playerid, "reward_request_type", 0);
        SetPVarInt(playerid, "reward_packet_t", 2);

        new is_fill = 0;
        JSON_GetInt(json, "u", is_fill);

        new sent_total = GetPVarInt(playerid, "reward_offset");
        new query[160];
        if(is_fill == 1)
        {
            mysql_format(db_handle, query, sizeof(query),
                "SELECT `id`, `award_id`, `case_id` FROM `rewards` WHERE `uid` = %d ORDER BY `id` DESC LIMIT %d, 1",
                Player[playerid][pID], sent_total);
            SetPVarInt(playerid, "reward_offset", sent_total + 1);
        }
        else
        {
            mysql_format(db_handle, query, sizeof(query),
                "SELECT `id`, `award_id`, `case_id` FROM `rewards` WHERE `uid` = %d ORDER BY `id` DESC LIMIT %d, %d",
                Player[playerid][pID], sent_total, REWARDS_QUERY_LIMIT);
            SetPVarInt(playerid, "reward_offset", sent_total + REWARDS_QUERY_LIMIT);
        }
        mysql_tquery(db_handle, query, "OnPlayerRewardsLoad", "i", playerid);
    }
    else if(type == 4)
    {
        new reward_db_id, reward_action;
        JSON_GetInt(json, "id", reward_db_id);
        JSON_GetInt(json, "s", reward_action);

        if(reward_action == 1 || reward_action == 3)
        {
            new query[128];
            mysql_format(db_handle, query, sizeof(query),
                "SELECT `award_id`, `case_id` FROM `rewards` WHERE `id` = %d AND `uid` = %d LIMIT 1",
                reward_db_id, Player[playerid][pID]);
            mysql_tquery(db_handle, query, "OnRewardDebug", "iii", playerid, reward_db_id, reward_action);
        }
    }
    else
    {
        #if defined REWARDS_DEBUG_PACKET_LOG
            printf("[IPacket:74] unknown t=%d player=%d", type, playerid);
        #endif
    }
    return 1;
}

stock ReloadPlayerRewardsList(playerid)
{
    SetPVarInt(playerid, "reward_request_type", 0);
    SetPVarInt(playerid, "reward_packet_t", 1);
    SetPVarInt(playerid, "reward_refresh_after_take", 1);
    SetPVarInt(playerid, "reward_offset", REWARDS_QUERY_LIMIT);

    new query[160];
    mysql_format(db_handle, query, sizeof(query),
        "SELECT `id`, `award_id`, `case_id` FROM `rewards` WHERE `uid` = %d ORDER BY `id` DESC LIMIT 0, %d",
        Player[playerid][pID], REWARDS_QUERY_LIMIT);
    mysql_tquery(db_handle, query, "OnPlayerRewardsLoad", "i", playerid);
    return 1;
}

CMD:reward(playerid, params[])
{
    // reward_offset = ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜.
    // ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ REWARDS_QUERY_LIMIT (10) ˜˜˜˜.
    SetPVarInt(playerid, "reward_offset", REWARDS_QUERY_LIMIT);
    SetPVarInt(playerid, "reward_case_filter", 1); // ALL
    // ˜˜˜˜˜: t = 0 -> ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ "˜˜˜˜˜˜ | ˜˜˜ ˜˜˜˜˜˜˜" (BpRewards).
    // ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ "˜˜˜˜˜ ˜˜˜˜˜˜ | Black Market" (Marketplace).
    SetPVarInt(playerid, "reward_request_type", 0);
    new query[128];
    mysql_format(db_handle, query, sizeof(query), "SELECT `id`, `award_id`, `case_id` FROM `rewards` WHERE `uid` = %d ORDER BY `id` DESC LIMIT 0, %d", Player[playerid][pID], REWARDS_QUERY_LIMIT);
    mysql_tquery(db_handle, query, "OnPlayerRewardsLoad", "i", playerid);

    return 1;
}

forward OnPlayerRewardsLoad(playerid);
public OnPlayerRewardsLoad(playerid)
{
    new rows, fields;
    cache_get_data(rows, fields, db_handle);
    new open_gui;
    new list_packet_t = Rewards_GetOutboundJsonType(playerid, open_gui);
    new bool:skip_empty_notify = (GetPVarInt(playerid, "reward_refresh_after_take") != 0);
    if(skip_empty_notify) DeletePVar(playerid, "reward_refresh_after_take");

    if(rows == 0)
    {
        new Node:emptyObj = JSON_Object();
        new tab_filter = GetPVarInt(playerid, "reward_case_filter");
        JSON_SetInt(emptyObj, "t", list_packet_t);
        JSON_SetInt(emptyObj, "o", open_gui);
        JSON_SetInt(emptyObj, "cs", tab_filter);
        JSON_SetInt(emptyObj, "c", tab_filter);
        JSON_SetInt(emptyObj, "pc", GetPlayerDustValue(playerid));
        JSON_SetInt(emptyObj, "next_page", 0);
        SetPVarInt(playerid, "reward_has_more", 0);
        Rewards_ApplyTanpinToJson(emptyObj, playerid);
        JSON_SetArray(emptyObj, "pr", JSON_Array());
        OnPacketIncoming(playerid, 74, emptyObj);
        JSON_Cleanup(emptyObj);
        ClearRewardListPacketType(playerid);

        // ˜˜˜˜˜˜˜˜˜˜ "˜˜˜ ˜˜˜˜˜˜" ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜, ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜.
        if(!skip_empty_notify && GetPVarInt(playerid, "reward_offset") <= REWARDS_QUERY_LIMIT)
        {
            ShowNotification(playerid, 2, 4, 1, 1, "˜ ˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜!", "");
        }
        return 1;
    }

    new bool:is_append = (list_packet_t == 2);
    Rewards_SetHasMorePVar(playerid, rows, is_append);

    new Node:JSONObject = JSON_Object();
    JSON_SetInt(JSONObject, "t", list_packet_t);
    JSON_SetInt(JSONObject, "o", open_gui);
    JSON_SetInt(JSONObject, "pc", GetPlayerDustValue(playerid));
    JSON_SetInt(JSONObject, "next_page", GetPVarInt(playerid, "reward_has_more"));
    Rewards_ApplyTanpinToJson(JSONObject, playerid);
    new tab_filter = GetPVarInt(playerid, "reward_case_filter");
    JSON_SetInt(JSONObject, "cs", tab_filter);
    JSON_SetInt(JSONObject, "c", tab_filter);

    new Node:prArray = JSON_Array();
    new display_rows = rows;
    if(!is_append && rows > REWARDS_PAGE_SIZE)
        display_rows = REWARDS_PAGE_SIZE;
    new shown_count = 0;

    for(new j = 0; j < display_rows; j++)
    {
        new a_id = cache_get_field_content_int(j, "award_id", db_handle);
        new db_id = cache_get_field_content_int(j, "id", db_handle);
        new case_id = cache_get_field_content_int(j, "case_id", db_handle);
        
        new type, count, internal, spray_price, name[32];
        new bool:found = false;

        if(case_id == 1 && a_id >= 0 && a_id < 20) {
            type = CaseDailyAwards[a_id][aType];
            internal = CaseDailyAwards[a_id][aInternalID];
            spray_price = CaseDailyAwards[a_id][aSprayPrice];
            spray_price = CaseDailyAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseDailyAwards[a_id][aName]);
            found = true;
        }
        else if(case_id == 2 && a_id >= 0 && a_id < 28) {
            type = CaseBomjAwards[a_id][aType];
            internal = CaseBomjAwards[a_id][aInternalID];
            spray_price = CaseBomjAwards[a_id][aSprayPrice];
            spray_price = CaseBomjAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseBomjAwards[a_id][aName]);
            found = true;
        }
        else if(case_id == 3 && a_id >= 0 && a_id < 37) {
            type = CaseStandartAwards[a_id][aType];
            internal = CaseStandartAwards[a_id][aInternalID];
            spray_price = CaseStandartAwards[a_id][aSprayPrice];
            spray_price = CaseStandartAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseStandartAwards[a_id][aName]);
            found = true;
        }
        else if(case_id == 4 && a_id >= 0 && a_id < 31) {
            type = CaseAutoAwards[a_id][aType];
            internal = CaseAutoAwards[a_id][aInternalID];
            spray_price = CaseAutoAwards[a_id][aSprayPrice];
            spray_price = CaseAutoAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseAutoAwards[a_id][aName]);
            found = true;
        }
        else if(case_id == 5 && a_id >= 0 && a_id < 20) {
            type = CaseSpecialAwards[a_id][aType];
            internal = CaseSpecialAwards[a_id][aInternalID];
            spray_price = CaseSpecialAwards[a_id][aSprayPrice];
            spray_price = CaseSpecialAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseSpecialAwards[a_id][aName]);
            found = true;
        }
        else if(case_id == 8 && a_id >= 0 && a_id < 25) {
            type = CaseDriveAwards[a_id][aType];
            internal = CaseDriveAwards[a_id][aInternalID];
            spray_price = CaseDriveAwards[a_id][aSprayPrice];
            spray_price = CaseDriveAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseDriveAwards[a_id][aName]);
            found = true;
        }
        else if(case_id == CAL_REWARDS_CASE_ID && a_id >= 0 && a_id < CAL_AWARDS_TOTAL) {
            if(Calendar_GetRewardMeta(a_id, type, count, internal, spray_price, name, sizeof(name)))
                found = true;
        }

        if(found)
        {
            if(!IsRewardAllowedByTab(tab_filter, type)) continue;

            new Node:item = JSON_Object();
            JSON_SetInt(item, "el", internal);
            JSON_SetInt(item, "id", db_id);
            JSON_SetString(item, "n", name);
            JSON_SetInt(item, "st", 1);
            JSON_SetInt(item, "td", type);
            JSON_SetInt(item, "sp", spray_price);
            
            new Node:tempArray = JSON_Array(item);
            prArray = JSON_Append(prArray, tempArray);
            shown_count++;
        }
    }

    // ˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ (˜˜ ALL) ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜,
    // ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜ ˜˜˜˜˜˜ "˜˜˜˜˜˜˜˜˜˜˜˜" ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜.
    if(tab_filter > 1 && shown_count == 0 && rows >= REWARDS_QUERY_LIMIT)
    {
        new sent_total = GetPVarInt(playerid, "reward_offset");

        new query[160];
        mysql_format(db_handle, query, sizeof(query),
            "SELECT `id`, `award_id`, `case_id` FROM `rewards` WHERE `uid` = %d ORDER BY `id` DESC LIMIT %d, %d",
            Player[playerid][pID], sent_total, REWARDS_QUERY_LIMIT);
        mysql_tquery(db_handle, query, "OnPlayerRewardsLoad", "i", playerid);

        SetPVarInt(playerid, "reward_offset", sent_total + REWARDS_QUERY_LIMIT);

        JSON_Cleanup(JSONObject);
        return 1;
    }

    JSON_SetArray(JSONObject, "pr", prArray);
    OnPacketIncoming(playerid, 74, JSONObject);
    JSON_Cleanup(JSONObject);
    ClearRewardListPacketType(playerid);

    // ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜: ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ >9 ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜ 3x3.
    if(!is_append && GetPVarInt(playerid, "reward_has_more") && shown_count >= REWARDS_PAGE_SIZE)
    {
        SetPVarInt(playerid, "reward_packet_t", 2);
        new sent_total = GetPVarInt(playerid, "reward_offset");
        new prefetch_q[160];
        mysql_format(db_handle, prefetch_q, sizeof(prefetch_q),
            "SELECT `id`, `award_id`, `case_id` FROM `rewards` WHERE `uid` = %d ORDER BY `id` DESC LIMIT %d, %d",
            Player[playerid][pID], sent_total, REWARDS_QUERY_LIMIT);
        SetPVarInt(playerid, "reward_offset", sent_total + REWARDS_QUERY_LIMIT);
        mysql_tquery(db_handle, prefetch_q, "OnPlayerRewardsLoad", "i", playerid);
    }
    return 1;
}

forward OnRewardDebug(playerid, db_id, reward_action);
public OnRewardDebug(playerid, db_id, reward_action)
{
    new rows = cache_num_rows();
    if(rows > 0)
    {
        new a_id = cache_get_field_content_int(0, "award_id", db_handle); 
        new case_id = cache_get_field_content_int(0, "case_id", db_handle); 
        
        new type, count, internal, spray_price, name[32];
        new bool:valid = false;

        if(case_id == 1 && a_id >= 0 && a_id < 20) {
            type = CaseDailyAwards[a_id][aType];
            count = CaseDailyAwards[a_id][aCount];
            internal = CaseDailyAwards[a_id][aInternalID];
            spray_price = CaseDailyAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseDailyAwards[a_id][aName]);
            valid = true;
        }
        else if(case_id == 2 && a_id >= 0 && a_id < 28) {
            type = CaseBomjAwards[a_id][aType];
            count = CaseBomjAwards[a_id][aCount];
            internal = CaseBomjAwards[a_id][aInternalID];
            spray_price = CaseBomjAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseBomjAwards[a_id][aName]);
            valid = true;
        }
        else if(case_id == 3 && a_id >= 0 && a_id < 37) {
            type = CaseStandartAwards[a_id][aType];
            count = CaseStandartAwards[a_id][aCount];
            internal = CaseStandartAwards[a_id][aInternalID];
            spray_price = CaseStandartAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseStandartAwards[a_id][aName]);
            valid = true;
        }
        else if(case_id == 4 && a_id >= 0 && a_id < 31) {
            type = CaseAutoAwards[a_id][aType];
            count = CaseAutoAwards[a_id][aCount];
            internal = CaseAutoAwards[a_id][aInternalID];
            spray_price = CaseAutoAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseAutoAwards[a_id][aName]);
            valid = true;
        }
        else if(case_id == 5 && a_id >= 0 && a_id < 20) {
            type = CaseSpecialAwards[a_id][aType];
            count = CaseSpecialAwards[a_id][aCount];
            internal = CaseSpecialAwards[a_id][aInternalID];
            spray_price = CaseSpecialAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseSpecialAwards[a_id][aName]);
            valid = true;
        }
        else if(case_id == 8 && a_id >= 0 && a_id < 25) {
            type = CaseDriveAwards[a_id][aType];
            count = CaseDriveAwards[a_id][aCount];
            internal = CaseDriveAwards[a_id][aInternalID];
            spray_price = CaseDriveAwards[a_id][aSprayPrice];
            format(name, 32, "%s", CaseDriveAwards[a_id][aName]);
            valid = true;
        }
        else if(case_id == CAL_REWARDS_CASE_ID && a_id >= 0 && a_id < CAL_AWARDS_TOTAL) {
            if(Calendar_GetRewardMeta(a_id, type, count, internal, spray_price, name, sizeof(name)))
                valid = true;
        }
        else if(case_id >= 72 && case_id <= 74)
        {
            format(name, sizeof(name), "Black Pass (˜˜˜˜˜˜˜˜)");
            valid = true;
        }

        if(!valid) return 1;

        if(case_id >= 72 && case_id <= 74)
        {
            ShowNotification(playerid, 2, 5, 1, 1,
                "Black Pass ˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜.", "");
            new d_query[128];
            mysql_format(db_handle, d_query, sizeof(d_query), "DELETE FROM `rewards` WHERE `id` = %d", db_id);
            mysql_tquery(db_handle, d_query, "", "");
            ReloadPlayerRewardsList(playerid);
            return 1;
        }

        if(case_id == CAL_REWARDS_CASE_ID)
        {
            Calendar_ApplyRewardDirect(playerid, a_id);
            SavePlayerAccount(playerid);
            new d_query[128];
            mysql_format(db_handle, d_query, sizeof(d_query), "DELETE FROM `rewards` WHERE `id` = %d", db_id);
            mysql_tquery(db_handle, d_query, "", "");
            ReloadPlayerRewardsList(playerid);
            return 1;
        }

        new bool:should_delete = true;

        if(reward_action == 3)
        {
            if(spray_price > 0)
            {
                AddPlayerDustValue(playerid, spray_price);
                if(PopSpecialCaseUiPending(playerid))
                    QueueSpecialCaseUiOutsideSpray(playerid);

                new dust_notify[128];
                format(dust_notify, sizeof(dust_notify), "˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜ %d ˜˜˜˜.", spray_price);
                ShowNotification(playerid, 1, 5, 1, 0, dust_notify, "");
            }
            else
            {
                ShowNotification(playerid, 2, 4, 1, 1, "˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜!", "");
                should_delete = false;
            }
        }
        else
        {
            switch(type)
            {
                case 1: {
                    Player[playerid][pExp] += count;
                    Player[playerid][pLevel] = (Player[playerid][pExp] / 4) + 1;
                    SetPlayerScore(playerid, Player[playerid][pLevel]);
                }
                case 2: GivePlayerMoneyEx(playerid, count); 
                case 5: {
                    new slot = Player_FindFreeCarSlot(playerid);
                    if(slot != -1) {
                        VehicleInfo_ClearSlot(playerid, slot, false);
                        VehicleInfo[playerid][slot][vModel] = internal;
                        VehicleInfo[playerid][slot][vPrice] = 0;
                        VehicleInfo[playerid][slot][vColor][0] = 1;
                        VehicleInfo[playerid][slot][vColor][1] = 1;
                        VehicleInfo[playerid][slot][vBodyColor] = 0;
                        VehicleInfo[playerid][slot][vDiskColor] = 0;
                        VehicleInfo[playerid][slot][vWheel] = 0;
                        VehicleInfo[playerid][slot][vVinyl][0] = '\0';
                        VehicleInfo[playerid][slot][vNitro] = 0;
                        VehicleInfo[playerid][slot][vPos][0] = 2477.5002;
                        VehicleInfo[playerid][slot][vPos][1] = -741.7479;
                        VehicleInfo[playerid][slot][vPos][2] = 11.3153;
                        VehicleInfo[playerid][slot][vPos][3] = 69.2541;
                        new query[512];
                        mysql_format(db_handle, query, sizeof(query),
                            "INSERT INTO `ownable_cars` (`owner_id`, `owner_name`, `model`, `price`, `color1`, `color2`, `body_color`, `disk_color`, `wheel`, `vinyl`, `nitro`, `x`, `y`, `z`, `a`) \
                            VALUES (%d, '%e', %d, 0, 1, 1, 0, 0, 0, '', 0, '%f', '%f', '%f', '%f')",
                            Player[playerid][pID], Player[playerid][pName], internal,
                            VehicleInfo[playerid][slot][vPos][0], VehicleInfo[playerid][slot][vPos][1], VehicleInfo[playerid][slot][vPos][2], VehicleInfo[playerid][slot][vPos][3]);
                        mysql_tquery(db_handle, query, "OnCarAwardAdded", "ii", playerid, slot);
                        format(query, 128, "˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜: %s!", name);
                        ShowNotification(playerid, 3, 5, 1, 0, query, "");
                    } else {
                        new rw_slot_msg[160];
                        Player_FillNoCarSlotMessage(playerid, rw_slot_msg, sizeof rw_slot_msg);
                        ShowNotification(playerid, 2, 4, 1, 1, rw_slot_msg, "");
                        should_delete = false; 
                    }
                }
                case 9: {
                    Player[playerid][pVipType] = internal;
                    Player[playerid][pVipTime] = count * 60;
                }
                case 11: { // ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜
                    if(GivePlayerItem(playerid, internal, count)) {
                        new notify[128];
                        format(notify, sizeof(notify), "˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜: %s (%d ˜˜.)", name, count);
                        ShowNotification(playerid, 1, 5, 1, 0, notify, "");
                    } else {
                        ShowNotification(playerid, 2, 4, 1, 1, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜!", "");
                        should_delete = false;
                    }
                }
                case 134: {
                    if(GivePlayerSkin(playerid, count)) {
                        new notify[128];
                        format(notify, sizeof(notify), "˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜: %s", name);
                        ShowNotification(playerid, 1, 5, 1, 0, notify, "");
                    } else {
                        ShowNotification(playerid, 2, 4, 1, 1, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜!", "");
                        should_delete = false;
                    }
                }
                case 10: GivePlayerBlackCoin(playerid, count);
            }
        }

        if(should_delete) {
            SavePlayerAccount(playerid);
            new d_query[128];
            mysql_format(db_handle, d_query, sizeof(d_query), "DELETE FROM `rewards` WHERE `id` = %d", db_id);
            mysql_tquery(db_handle, d_query, "", "");

            // ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ (t=1): ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜, ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜.
            ReloadPlayerRewardsList(playerid);
        }
    }
    return 1;
}
forward OnCarAwardAdded(playerid, slot);
public OnCarAwardAdded(playerid, slot)
{
    VehicleInfo[playerid][slot][vDBID] = cache_insert_id(db_handle);
    return 1;
}
