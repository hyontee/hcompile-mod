stock FindCarGameIdByInternal(internal_id)
{
    for(new i = 0; i < sizeof(cars_game_ids); i++)
    {
        if(cars_game_ids[i][0] == internal_id) return cars_game_ids[i][1];
    }
    return -1;
}

// game model -> internal id ˜˜ tune-items.json / cars_game_ids (BR client ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜ id).
stock FindCarInternalIdByGameId(game_model)
{
    new best = -1;
    for(new i = 0; i < sizeof(cars_game_ids); i++)
    {
        if(cars_game_ids[i][1] != game_model) continue;
        if(best == -1 || cars_game_ids[i][0] < best)
            best = cars_game_ids[i][0];
    }
    if(best != -1) return best;
    if(game_model >= 400 && game_model <= 611) return game_model;
    return game_model;
}

stock Tune_GetTuneItemsModelId(game_model)
{
    return FindCarInternalIdByGameId(game_model);
}

// ˜˜˜˜˜˜ ˜˜˜˜˜˜ (internal_id) ˜ ˜˜˜˜ ˜ BC ˜ ˜˜˜ ˜ mod laird (ShowPlayerDrubMenu / laird-252 ipacket)
#define DONATE_SVC_CHANGE_NAME   (102)
#define DONATE_SVC_UNWARN        (103)
#define DONATE_SVC_LICENSE_PACK  (104)
#define DONATE_SVC_HEAL          (106)

#define DONATE_PRICE_CHANGE_NAME (50)
#define DONATE_PRICE_UNWARN      (150)
#define DONATE_PRICE_LICENSES    (150)
#define DONATE_PRICE_HEAL        (75)

// ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (˜˜˜˜˜˜ BR / ˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜) ˜ internal_id ˜˜˜ ˜ laird-252 / ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ 115˜124
#define DONATE_SVC_LOW_WEAR       (115)
#define DONATE_SVC_MED_ETERNAL    (116)
#define DONATE_SVC_MED_BUY        (117)
#define DONATE_SVC_LAW_UP         (119)
#define DONATE_SVC_FAM_CAR_SLOT   (120)
#define DONATE_SVC_GENDER         (121)
#define DONATE_SVC_EXTRA_CAR_SLOT (122)
#define DONATE_SVC_PLATES         (123)
#define DONATE_SVC_PHONE          (124)

#define DONATE_PRICE_LOW_WEAR       (300)
#define DONATE_PRICE_MED_ETERNAL    (300)
#define DONATE_PRICE_MED_BUY        (100)
#define DONATE_PRICE_LAW_UP         (5)
#define DONATE_PRICE_FAM_CAR_SLOT   (300)
#define DONATE_PRICE_GENDER         (100)
#define DONATE_PRICE_EXTRA_CAR_SLOT (100)
#define DONATE_PRICE_PLATES         (85)
#define DONATE_PRICE_PHONE          (70)

stock DonateService_GetExpectedBc(internal_id)
{
    switch(internal_id)
    {
        case DONATE_SVC_CHANGE_NAME:   return DONATE_PRICE_CHANGE_NAME;
        case DONATE_SVC_UNWARN:        return DONATE_PRICE_UNWARN;
        case DONATE_SVC_LICENSE_PACK:  return DONATE_PRICE_LICENSES;
        case DONATE_SVC_HEAL:          return DONATE_PRICE_HEAL;
        case DONATE_SVC_LOW_WEAR:      return DONATE_PRICE_LOW_WEAR;
        case DONATE_SVC_MED_ETERNAL:   return DONATE_PRICE_MED_ETERNAL;
        case DONATE_SVC_MED_BUY:       return DONATE_PRICE_MED_BUY;
        case DONATE_SVC_LAW_UP:        return DONATE_PRICE_LAW_UP;
        case DONATE_SVC_FAM_CAR_SLOT:  return DONATE_PRICE_FAM_CAR_SLOT;
        case DONATE_SVC_GENDER:        return DONATE_PRICE_GENDER;
        case DONATE_SVC_EXTRA_CAR_SLOT:return DONATE_PRICE_EXTRA_CAR_SLOT;
        case DONATE_SVC_PLATES:        return DONATE_PRICE_PLATES;
        case DONATE_SVC_PHONE:         return DONATE_PRICE_PHONE;
    }
    return -1;
}

#define DIALOG_DONATE_CHANGENAME (19420)

stock Donate_ShowNameChangeDialog(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    ShowPlayerDialog(playerid, DIALOG_DONATE_CHANGENAME, DIALOG_STYLE_INPUT,
        "{E0584B}˜˜˜˜˜ ˜˜˜˜",
        "{FFFFFF}˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ (3˜24 ˜˜˜˜˜˜˜). ˜˜˜˜˜˜˜˜, ˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜_˜.",
        "˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
    return 1;
}

stock DonateShop_SendPurchaseResult(playerid, Node:json_packet_data, bool:success, title[], body[], fail_k = -1)
{
    new msg[128], sub[128];
    format(msg, sizeof msg, "%s", title);
    format(sub, sizeof sub, "%s", body);

    JSON_SetInt(json_packet_data, "y", success ? 1 : 0);
    if(success)
        JSON_SetInt(json_packet_data, "k", 0);
    else
        JSON_SetInt(json_packet_data, "k", fail_k);
    JSON_SetString(json_packet_data, "m", msg);
    JSON_SetString(json_packet_data, "n", sub);
    JSON_SetInt(json_packet_data, "s", GetPlayerBlackCoin(playerid));
    JSON_SetInt(json_packet_data, "r", GetPlayerMoneyEx(playerid));
    OnPacketIncoming(playerid, 22, json_packet_data);
    JSON_Cleanup(json_packet_data);
}

// 0 = ˜˜ ˜˜˜˜˜˜, 1 = ˜˜˜˜˜, 2 = ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜, 3 = ˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜, 4 = ˜˜˜ ˜˜˜˜˜ ˜˜˜˜
stock Donate_ApplyServicePurchase(playerid, internal_id, price)
{
    new expected = DonateService_GetExpectedBc(internal_id);
    if(expected == -1) return 0;
    if(price != expected) return 0;

    switch(internal_id)
    {
        case DONATE_SVC_CHANGE_NAME:
        {
            GivePlayerBlackCoin(playerid, -price);
            Donate_ShowNameChangeDialog(playerid);
            return 1;
        }
        case DONATE_SVC_UNWARN:
        {
            if(Player[playerid][pWarns] <= 0) return 2;
            Player[playerid][pWarns] = 0;
            SavePlayerAccount(playerid);
            GivePlayerBlackCoin(playerid, -price);
            return 1;
        }
        case DONATE_SVC_LICENSE_PACK:
        {
            for(new t = 1; t <= 6; t++) Lic_SetPlayerLicense(playerid, t, 365);
            GivePlayerBlackCoin(playerid, -price);
            return 1;
        }
        case DONATE_SVC_HEAL:
        {
            SetPlayerHealth(playerid, 100.0);
            GivePlayerBlackCoin(playerid, -price);
            return 1;
        }
        case DONATE_SVC_MED_BUY:
        {
            if(!GivePlayerItem(playerid, ITEM_MEDKIT, 1)) return 3;
            GivePlayerBlackCoin(playerid, -price);
            return 1;
        }
        case DONATE_SVC_EXTRA_CAR_SLOT:
        {
            Player[playerid][pCarExtraSlots]++;
            GivePlayerBlackCoin(playerid, -price);
            SavePlayerAccount(playerid);
            return 1;
        }
        case DONATE_SVC_FAM_CAR_SLOT:
        {
            new new_lim = Family_PurchaseDonateFleetSlot(playerid);
            if(new_lim <= 0) return 5;
            GivePlayerBlackCoin(playerid, -price);
            new fam_msg[160];
            format(fam_msg, sizeof fam_msg,
                "%s[%d] ˜˜˜˜˜ ˜˜˜. ˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜. ˜˜˜˜˜ ˜˜˜˜˜˜: %d",
                Player[playerid][pName], playerid, new_lim);
            Family_SendFamilyMessage(Player[playerid][pFamilyId], fam_msg);
            return 1;
        }
        default:
            return 0;
    }
    return 0;
}
// ----- end: donate.inc -----

