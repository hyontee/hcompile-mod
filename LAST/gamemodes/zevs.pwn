			if(g_business_loaded >= MAX_BUSINESS) return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜."), true;

			new type = GetPVarInt(playerid, "AddBizType");
