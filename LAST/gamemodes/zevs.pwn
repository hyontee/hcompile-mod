		case DIALOG_BIZ_DEL_CONFIRM:
		{
			if(!response) return true;
			if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 5) return true;
			new biz_id = GetPVarInt(playerid, "DelBizID");
			DeletePVar(playerid, "DelBizID");
			if(!IsBusinessSlotValid(biz_id))
				return SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜."), true;

			new biz_name[64];
			format(biz_name, sizeof biz_name, "%s", GetBusinessData(biz_id, B_NAME));
			Biz_DeleteBySlot(biz_id);

			new msg2[180];
			format(msg2, sizeof msg2, "{66CC33}˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜: %s (ID: %d).", biz_name, biz_id);
