        }

        new model_acs = IsItemAccessory(item_id);
        if(item_id != ITEM_SIM_CARD && item_id != ITEM_MEDKIT && item_id != ITEM_REPAIR_KIT && item_id != ITEM_FUEL_CANISTER && !IsPlateItem(item_id) && model_acs > 0)
        {
            new inv_db = Inv_EnsureInventoryDbId(playerid, pos);
            if(inv_db <= 0)
            {
                ShowNotification(playerid, 2, 5, 0, 1, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜.", "");
                JSON_SetInt(response, "t", 19);
                JSON_SetInt(response, "s", 0);
                JSON_Cleanup(json);
                Inv_DispatchInvActionResult(playerid, response, false);
                return 1;
            }

            if(Inv_IsWearableAccessory(item_id) || Inv_IsBackpackItem(item_id))
            {
                new bool:acs_worn = (PlayerInventory[playerid][pos][invValue] == 1);
                new bool:acs_has_save = Inv_HasAccessorySaveForSlot(playerid, pos);

                if(acs_worn)
                {
                    new edit_bone;
                    new Float:epx, Float:epy, Float:epz, Float:erx, Float:ery, Float:erz, Float:esc;
                    new emodel = model_acs;
                    if(!Inv_LoadAccessoryParamsForSlot(playerid, pos, emodel, edit_bone, epx, epy, epz, erx, ery, erz, esc))
                        Inv_GetAccessoryPreset(item_id, edit_bone, epx, epy, epz, erx, ery, erz, esc);

                    StartAccessoryEdit(playerid, emodel, edit_bone, Inv_GetAttachSlot(item_id), inv_db, pos);
                    ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜.", "");

                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 1);
                    JSON_SetInt(response, "i", 5);
                    JSON_Cleanup(json);
                    Inv_DispatchInvActionResult(playerid, response, true);
                    return 1;
                }

                if(acs_has_save)
                {
                    Inv_EquipAccessoryWithSaved(playerid, pos, true);
                    Inv_RefreshInventoryGui(playerid);

                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 1);
                    JSON_SetInt(response, "i", Inv_GetAiSlotPos(item_id));
                    JSON_Cleanup(json);
                    Inv_DispatchInvActionResult(playerid, response, true);
                    return 1;
                }

                if(Inv_IsBackpackItem(item_id))
                    Inv_UnequipAllBackpacks(playerid, pos);
                else if(Inv_IsWearableAccessory(item_id))
                    Inv_UnequipWearableCategory(playerid, Inv_GetAccessoryCategory(item_id), pos);

                new edit_bone;
                new Float:epx, Float:epy, Float:epz, Float:erx, Float:ery, Float:erz, Float:esc;
                Inv_GetAccessoryPreset(item_id, edit_bone, epx, epy, epz, erx, ery, erz, esc);
                StartAccessoryEdit(playerid, model_acs, edit_bone, Inv_GetAttachSlot(item_id), inv_db, pos);
                ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜.", "");

                JSON_SetInt(response, "t", 19);
                JSON_SetInt(response, "s", 1);
                JSON_SetInt(response, "i", 5);
                JSON_Cleanup(json);
                Inv_DispatchInvActionResult(playerid, response, true);
                return 1;
            }

            format(dbg_str, sizeof(dbg_str), "[DEBUG AccEdit] item:%d model:%d inv_db:%d slot:%d", item_id, model_acs, inv_db, pos);
            print(dbg_str);

            new def_bone;
            new Float:dpx, Float:dpy, Float:dpz, Float:drx, Float:dry, Float:drz, Float:dsc;
            Inv_GetAccessoryPreset(item_id, def_bone, dpx, dpy, dpz, drx, dry, drz, dsc);
            StartAccessoryEdit(playerid, model_acs, def_bone, Inv_GetAttachSlot(item_id), inv_db, pos);
            ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜.", "");

            JSON_SetInt(response, "t", 19);
            JSON_SetInt(response, "s", 1);
            JSON_SetInt(response, "i", 5);

            JSON_Cleanup(json);
            Inv_DispatchInvActionResult(playerid, response, true);
            return 1;
        }
        else if(item_id == 134) 
        {
            if(pos >= 0 && pos < MAX_INV_SLOTS && PlayerInventory[playerid][pos][invItem] == 134)
            {
                if(MinerJob_IsWorking(playerid))
                {
                    ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜.", "");
                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 0);
                }
                else
                {
                new old_skin = Player[playerid][pSkin];
                new new_skin = PlayerInventory[playerid][pos][invValue];
                
                Player[playerid][pSkin] = new_skin;
                SetPlayerSkin(playerid, new_skin);
                PlayerInventory[playerid][pos][invValue] = old_skin;

                new query_skin[256];
                mysql_format(db_handle, query_skin, sizeof(query_skin), "UPDATE `players` SET `skin` = %d WHERE `id` = %d", new_skin, Player[playerid][pID]);
                mysql_tquery(db_handle, query_skin);

                mysql_format(db_handle, query_skin, sizeof(query_skin), "UPDATE `inventory` SET `value` = %d WHERE `id` = %d", old_skin, PlayerInventory[playerid][pos][invID]);
                mysql_tquery(db_handle, query_skin);

                JSON_SetInt(response, "t", 19);
                JSON_SetInt(response, "s", 1);
                JSON_SetInt(response, "i", 6);
                JSON_SetInt(response, "ps", new_skin);
                }
            }
            else
            {
                JSON_SetInt(response, "t", 19);
                JSON_SetInt(response, "s", 0);
            }

            Inv_ApplyActionResponseDefaults(playerid, response);
            JSON_Cleanup(json);
            Inv_DispatchInvActionResult(playerid, response, false);
            return 1;
        }
        else if(item_id == ITEM_SIM_CARD)
        {
            new sim_msg[80];

            if(pos == SIM_CARD_ACTIVE_POS)
            {
                if(Player[playerid][pSimCard] > 0)
                {
                    new old_sim = Player[playerid][pSimCard];
                    new moved = Inv_MoveActiveSimToInventory(playerid);
                    if(moved < 0)
                    {
                        ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜.", "");
                        JSON_SetInt(response, "t", 19);
                        JSON_SetInt(response, "s", 0);
                    }
                    else
                    {
                        format(sim_msg, sizeof(sim_msg), "˜˜˜-˜˜˜˜˜ %d ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜.", old_sim);
                        ShowNotification(playerid, 1, 5, 0, 1, sim_msg, "");

                        JSON_SetInt(response, "t", 19);
                        JSON_SetInt(response, "s", 1);
                        JSON_SetInt(response, "i", -1);
                        JSON_SetInt(response, "nm", 0);
                    }
                }
                else
                {
                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 0);
                }
            }
            else if(pos >= 0 && pos < MAX_INV_SLOTS)
            {
                new inv_slot = pos;
                new sim_val = PlayerInventory[playerid][pos][invValue];
                Inv_CorrectPacketInvSlot(playerid, ITEM_SIM_CARD, pos, sim_val, inv_slot, true);

                if(PlayerInventory[playerid][inv_slot][invItem] != ITEM_SIM_CARD)
                {
                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 0);
                }
                else
                {
                new old_active = Player[playerid][pSimCard];

                if(!SwapActiveSimWithInventorySlot(playerid, inv_slot))
                {
                    ShowNotification(playerid, 2, 5, 0, 1, "˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜-˜˜˜˜˜. ˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜.", "");
                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 0);
                }
                else
                {
                    new active_sim = Player[playerid][pSimCard];
                    if(old_active > 0)
                        format(sim_msg, sizeof(sim_msg), "˜˜˜-˜˜˜˜˜ %d ˜˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜˜˜ (%d) ˜ ˜˜˜˜˜˜˜˜˜.", active_sim, old_active);
                    else
                        format(sim_msg, sizeof(sim_msg), "˜˜˜-˜˜˜˜˜ %d ˜˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜.", active_sim);
                    ShowNotification(playerid, 1, 5, 0, 1, sim_msg, "");

                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 1);
                    JSON_SetInt(response, "i", 0);
                    JSON_SetInt(response, "nm", active_sim);
                }
                }
            }
            else
            {
                JSON_SetInt(response, "t", 19);
                JSON_SetInt(response, "s", 0);
            }

            Inv_ApplyActionResponseDefaults(playerid, response);
            JSON_Cleanup(json);
            Inv_DispatchInvActionResult(playerid, response, true);
            return 1;
        }
        else if(IsPlateItem(item_id))
        {
            if(pos < 0 || pos >= MAX_INV_SLOTS || PlayerInventory[playerid][pos][invItem] != item_id)
            {
                JSON_SetInt(response, "t", 19);
                JSON_SetInt(response, "s", 0);
            }
            else
            {
                new target_veh = GetClosestVehicleByTrunk(playerid, 3.0);
                if(target_veh == 0)
                {
                    Veh_ShowTrunkOrNoCarMsg(playerid, 8.0);
                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 0);
                }
                else
                {
                    new owner_id = -1, owner_slot = -1;
                    for(new oi = 0; oi < MAX_PLAYERS; oi++)
                    {
                        for(new si = 0; si < MAX_PLAYER_VEHICLES; si++)
                        {
                            if(VehicleInfo[oi][si][vSpawned] && VehicleInfo[oi][si][vID] == target_veh)
                            {
                                owner_id = oi;
                                owner_slot = si;
                                break;
                            }
                        }
                        if(owner_id != -1) break;
                    }
                    if(owner_id != playerid)
                    {
                        ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜.", "");
                        JSON_SetInt(response, "t", 19);
                        JSON_SetInt(response, "s", 0);
                    }
                    else if(Vehicle_HasInstalledPlate(owner_id, owner_slot))
                    {
                        new cur_plate[96];
                        format(cur_plate, sizeof cur_plate,
                            "˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜. ˜˜˜˜˜ (%s%s). ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜ /car.",
                            VehicleInfo[owner_id][owner_slot][vPlateNumber],
                            VehicleInfo[owner_id][owner_slot][vPlateRegion]);
                        ShowNotification(playerid, 2, 5, 0, 1, cur_plate, "");
                        JSON_SetInt(response, "t", 19);
                        JSON_SetInt(response, "s", 0);
                    }
                    else
                    {
                        new country = PlateCountryFromItem(item_id);
                        new plate_type = PlateRPCType(country);
                        new plate_num[12], plate_reg[8];
                        format(plate_num, sizeof plate_num, "%s", g_InvPlateNumber[playerid][pos]);
                        format(plate_reg, sizeof plate_reg, "%s", g_InvPlateRegion[playerid][pos]);

                        SetVehicleNumberPlateEx(target_veh, plate_type, plate_num, plate_reg);

                        new save_q[256];
                        mysql_format(db_handle, save_q, sizeof save_q,
                            "UPDATE `ownable_cars` SET `plate_type`=%d, `plate_number`='%e', `plate_region`='%e' WHERE `id`=%d",
                            plate_type, plate_num, plate_reg, VehicleInfo[owner_id][owner_slot][vDBID]);
                        mysql_tquery(db_handle, save_q);

                        RemoveInventoryPlate(playerid, pos);

                        new msg[160];
                        format(msg, sizeof msg, "˜˜˜. ˜˜˜˜ %s %s ˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜.", plate_num, plate_reg);
                        ShowNotification(playerid, 1, 5, 0, 1, msg, "");

                        JSON_SetInt(response, "t", 19);
                        JSON_SetInt(response, "s", 1);
                        JSON_SetInt(response, "i", -1);
                    }
                }
            }

            Inv_ApplyActionResponseDefaults(playerid, response);
            JSON_Cleanup(json);
            Inv_DispatchInvActionResult(playerid, response, false);
            return 1;
        }
        else if(item_id == ITEM_MEDKIT || item_id == ITEM_REPAIR_KIT || item_id == ITEM_FUEL_CANISTER)
        {
            if(pos < 0 || pos >= MAX_INV_SLOTS || PlayerInventory[playerid][pos][invItem] != item_id)
            {
                JSON_SetInt(response, "t", 19);
                JSON_SetInt(response, "s", 0);
            }
            else if(item_id == ITEM_MEDKIT)
            {
                SetPlayerHealth(playerid, 100.0);
                ConsumeOneInventoryItem(playerid, pos);
                ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜.", "");

                JSON_SetInt(response, "t", 19);
                JSON_SetInt(response, "s", 1);
                JSON_SetInt(response, "i", -1);
            }
            else if(item_id == ITEM_REPAIR_KIT)
            {
                new target_veh = GetPlayerVehicleID(playerid);
                if(target_veh == 0 || GetPlayerVehicleSeat(playerid) != 0)
                {
                    target_veh = GetClosestVehicleToPlayer(playerid, 5.0);
                }

                if(target_veh == 0)
                {
                    ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ (5˜).", "");
                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 0);
                }
                else
                {
                    RepairVehicle(target_veh);
                    SetVehicleHealth(target_veh, 1000.0);
                    VehHp_OnFullyRepaired(target_veh);
                    new own_rep = -1, slot_rep = -1;
                    if(GetVehicleOwnerSlot(target_veh, own_rep, slot_rep) && own_rep >= 0 && slot_rep >= 0)
                    {
                        VehicleInfo[own_rep][slot_rep][vHealth] = 1000.0;
                        Fuel_FlushVehicleImmediate(own_rep, slot_rep);
                    }
                    ConsumeOneInventoryItem(playerid, pos);
                    ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜.", "");

                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 1);
                    JSON_SetInt(response, "i", -1);
                }
            }
            else
            {
                new add_lit = PlayerInventory[playerid][pos][invValue];
                if(add_lit < 1) add_lit = 1;

                new target_veh = GetPlayerVehicleID(playerid);
                if(target_veh == 0 || GetPlayerVehicleSeat(playerid) != 0)
                    target_veh = GetClosestVehicleToPlayer(playerid, 5.0);

                if(target_veh == 0)
                {
                    ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ (5˜).", "");
                    JSON_SetInt(response, "t", 19);
                    JSON_SetInt(response, "s", 0);
                }
                else
                {
                    new own = -1, sl = -1;
                    if(!GetVehicleOwnerSlot(target_veh, own, sl) || own != playerid)
                    {
                        ShowNotification(playerid, 2, 5, 0, 1, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜.", "");
                        JSON_SetInt(response, "t", 19);
                        JSON_SetInt(response, "s", 0);
                    }
                    else
                    {
                        new Float:nf = VehicleInfo[own][sl][vFuel] + float(add_lit);
                        if(nf > 150.0) nf = 150.0;
                        VehicleInfo[own][sl][vFuel] = nf;
                        ConsumeOneInventoryItem(playerid, pos);
                        Fuel_FlushVehicleImmediate(own, sl);
                        Fuel_UpdateHudForOccupants(target_veh, VehicleInfo[own][sl][vFuel]);
                        ShowNotification(playerid, 1, 5, 0, 1, "˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜ ˜˜˜.", "");

                        JSON_SetInt(response, "t", 19);
                        JSON_SetInt(response, "s", 1);
                        JSON_SetInt(response, "i", -1);
                    }
                }
            }

            Inv_ApplyActionResponseDefaults(playerid, response);
            JSON_Cleanup(json);
            Inv_DispatchInvActionResult(playerid, response, true, true);
            return 1;
        }
        else 
        {
            JSON_SetInt(response, "t", 19);
            JSON_SetInt(response, "s", 0);
        }
    }
    else if (type == 23)
    {
        JSON_GetInt(json, "ga", item_id);
        JSON_GetInt(json, "os", old_pos);
        JSON_GetInt(json, "s", pos);

        new catalog_id = Inv_ClientCatalogId(item_id);
        new from_slot = Inv_FindSlotByUiIndex(playerid, old_pos, catalog_id, -1, true);
        new to_slot = Inv_FindSlotByUiIndex(playerid, pos, 0, -1, true);

        if(from_slot >= 0 && to_slot >= 0 && from_slot != to_slot)
        {
            if(PlayerInventory[playerid][to_slot][invItem] > 0)
                Inv_SwapInventorySlots(playerid, from_slot, to_slot);
            else
                Inv_MoveInventorySlot(playerid, from_slot, to_slot);
        }

        format(dbg_str, sizeof(dbg_str), "[DEBUG 23] ga:%d os:%d s:%d from:%d to:%d", item_id, old_pos, pos, from_slot, to_slot);
        print(dbg_str);

        JSON_SetInt(response, "t", 23);
        JSON_SetInt(response, "s", 1);
        JSON_SetInt(response, "i", pos);
        Inv_AttachFullInventoryArrays(playerid, response);
        Inv_ApplyActionResponseDefaults(playerid, response);
    }
    else if (type == 32)
    {
        JSON_GetInt(json, "ga", item_id);
        JSON_GetInt(json, "s", pos);
        if(pos < 0) JSON_GetInt(json, "sl", pos);

        format(dbg_str, sizeof(dbg_str), "[DEBUG 32] ga:%d s:%d sim:%d", item_id, pos, Player[playerid][pSimCard]);
        print(dbg_str);

        new ok = 0;
        if((item_id == ITEM_SIM_CARD || item_id == 58) && Player[playerid][pSimCard] > 0)
        {
            new inv_slot = pos;
            Inv_CorrectPacketInvSlot(playerid, ITEM_SIM_CARD, pos, Player[playerid][pSimCard], inv_slot, true);
            if(inv_slot >= 0 && inv_slot < MAX_INV_SLOTS)
                ok = Inv_MoveActiveSimToInventorySlot(playerid, inv_slot) ? 1 : 0;
        }

        JSON_SetInt(response, "t", 32);
        JSON_SetInt(response, "s", ok);
        if(ok)
        {
            JSON_SetInt(response, "nm", Player[playerid][pSimCard]);
            Inv_ApplyActionResponseDefaults(playerid, response);
        }
        else
        {
            format(dbg_str, sizeof dbg_str, "[DEBUG 32 FAIL] ga:%d s:%d sim:%d slot_item:%d",
                item_id, pos, Player[playerid][pSimCard],
                (pos >= 0 && pos < MAX_INV_SLOTS) ? PlayerInventory[playerid][pos][invItem] : -1);
            print(dbg_str);
        }
    }
    else if (type == 24)
    {
        JSON_GetInt(json, "ga", item_id);
        JSON_GetInt(json, "s", pos);
        
        format(dbg_str, sizeof(dbg_str), "[DEBUG 24] ga:%d, s:%d", item_id, pos);
        print(dbg_str);
        
        JSON_SetInt(response, "t", 24);
        JSON_SetInt(response, "s", 1);
        JSON_SetInt(response, "w", new_w);
    }
    else
    {
        format(dbg_str, sizeof(dbg_str), "[DEBUG Unknown] %d", type);
        print(dbg_str);
        JSON_SetInt(response, "t", type);
        JSON_SetInt(response, "s", 0);
    }

    if(type == 19 || type == 18 || type == 23 || type == 4) {
        if(type == 19 || type == 18) {
            JSON_SetInt(response, "w", Inventory_GetTotalWeight(playerid));
        }
    }

    if(type == 18 || type == 19)
        Inv_DispatchInvActionResult(playerid, response, false);
    else
    {
        OnPacketIncoming(playerid, 33, response);
        JSON_Cleanup(response);
    }
    JSON_Cleanup(json);
    return 1;
}
        case 34:
        {
            Trunk_HandlePacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case 38:
        {
            Auth_MarkGuiAck(playerid);

            new t;
            JSON_GetInt(json, "t", t);

            switch(t)
            {
                case -1:
{
    new skin_id;
    JSON_GetInt(json, "i", skin_id);
    SetPlayerSkin(playerid, skin_id);
    
    return 1;
}
                case 1:
                {
                    new password[65], repeat_password[65];
                    password[0] = EOS;
                    repeat_password[0] = EOS;

                    // ˜˜˜ GUI ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ "s", ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜ "p".
                    // ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜.
                    Auth_ReadFirstStringField(json, password, sizeof(password), "s", "password", "pass", "pwd", "p");

                    if(strlen(password) < 6 || strlen(password) > 16)
                    {
                        ShowNotification(playerid, NOTIFY_TYPE_TEXT_RED, 5, 0, 0, "˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜ 6 ˜˜ 16 ˜˜˜˜˜˜˜˜!", "");
                        JSON_Cleanup(json);
                        return 1;
                    }

                    // ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ (˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ "p").
                    if(Auth_ReadFirstStringField(json, repeat_password, sizeof(repeat_password), "p", "rp", "s2", "repeat", "password_repeat"))
                    {
                        if(strcmp(password, repeat_password, false) != 0)
                        {
                            ShowNotification(playerid, NOTIFY_TYPE_TEXT_RED, 5, 0, 0, "˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜.", "");
                            JSON_Cleanup(json);
                            return 1;
                        }
                    }

                    Auth_StoreRegPassword(playerid, password);

                    // ˜˜˜˜˜˜ ˜˜˜˜˜: ˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜
                    // (˜˜˜˜˜˜/˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ GUI).
                    new Node:response = JSON_Object();
                    OnPacketIncoming(playerid, 38, response);
                    JSON_Cleanup(response);
                    JSON_Cleanup(json);
                    return 1;
                }
case 3:
{
    new gender;
    JSON_GetInt(json, "r", gender);
    #pragma unused gender

    if(Player[playerid][pID] == 0)
    {
        new reg_pass[65];
        if(!Auth_ReadRegPassword(playerid, reg_pass, sizeof(reg_pass)))
        {
            ShowNotification(playerid, NOTIFY_TYPE_TEXT_RED, 5, 0, 0, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜: ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜. ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜.", "");
            JSON_Cleanup(json);
            return 1;
        }
        Auth_StoreRegPassword(playerid, reg_pass);

        new query_reg[700];
        mysql_format(db_handle, query_reg, sizeof(query_reg),
            "INSERT INTO `players` (`name`,`password`,`level`,`money`,`satiety`,`skin`,`donate`,`bc`,`vip_type`,`vip_time`,`admlvl`,`admpass`,`admprefix`,`countbomjcases`,`countcarcases`,`giftdelay`,`ban_time`,`ban_start`,`ban_days`) \
            VALUES ('%e','%e',1,%d,100,74,%d,%d,%d,%d,0,0,'None',%d,%d,7200,0,0,0)",
            Player[playerid][pName], reg_pass,
            REG_BONUS_MONEY, REG_BONUS_BC, REG_BONUS_BC,
            REG_BONUS_VIP_TYPE, REG_BONUS_VIP_TIME,
            REG_BONUS_BOMJ_CASES, REG_BONUS_CAR_CASES
        );
        mysql_tquery(db_handle, query_reg, "OnAccountRegister", "i", playerid);
    }

    // ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜?˜ (t:4), ˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜.
    new Node:response = JSON_Object();
    OnPacketIncoming(playerid, 38, response);
    JSON_Cleanup(response);
    JSON_Cleanup(json);
    return 1;
}
                case 4:
                {
                    new invite_nick[MAX_PLAYER_NAME];
                    invite_nick[0] = EOS;
                    JSON_GetString(json, "s", invite_nick, sizeof(invite_nick));

                    if(strlen(invite_nick) == 0)
                    {
                        Auth_GoRegSkinStep(playerid);
                        JSON_Cleanup(json);
                        return 1;
                    }

                    if(!strcmp(invite_nick, Player[playerid][pName], true))
                    {
                        ShowNotification(playerid, 0, 5, 0, 0, "˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜!", "");
                        new Node:err = JSON_Object();
                        JSON_SetInt(err, "c", 1);
                        OnPacketIncoming(playerid, 38, err);
                        JSON_Cleanup(err);
                        JSON_Cleanup(json);
                        return 1;
                    }

                    SetPVarString(playerid, "auth_ref_pending", invite_nick);
                    new query_ref[160];
                    mysql_format(db_handle, query_ref, sizeof(query_ref),
                        "SELECT `id` FROM `players` WHERE `name` = '%e' LIMIT 1", invite_nick);
                    mysql_tquery(db_handle, query_ref, "OnReferalCheckReg", "i", playerid);
                    JSON_Cleanup(json);
                    return 1;
                }
case 5:
{
    new final_skin;
    JSON_GetInt(json, "r", final_skin);
    Player[playerid][pSkin] = final_skin;
    SetPlayerSkin(playerid, final_skin);

    if(Player[playerid][pID] > 0)
    {
        Auth_FinishRegistration(playerid);
    }
    else
    {
        SetPVarInt(playerid, "auth_reg_finish", 1);
        SetPVarInt(playerid, "auth_reg_skin", final_skin);
        SetTimerEx("Auth_TryFinishRegistration", 200, false, "i", playerid);
    }
    JSON_Cleanup(json);
    return 1;
}
                case 2:
                {
                    new password[65];
                    password[0] = EOS;
                    new bool:got_pass = false;
                    if(Auth_ReadFirstStringField(json, password, sizeof(password), "p", "s", "password", "pass", "pwd")
                        && strlen(password) >= 6 && strlen(password) <= 16)
                        got_pass = true;

                    // ˜˜˜˜˜ ˜˜˜˜˜˜˜: t:2 ˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜, ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜ (˜˜ ˜˜˜˜˜).
                    if(Player[playerid][pID] == 0 && !GetPVarInt(playerid, "auth_reg_flow") && !GetPVarInt(playerid, "auth_has_account"))
                    {
                        new first_pass[65], confirm_pass[65];
                        first_pass[0] = confirm_pass[0] = EOS;
                        Auth_ReadRegPassword(playerid, first_pass, sizeof(first_pass));

                        if(got_pass)
                            format(confirm_pass, sizeof(confirm_pass), "%s", password);
                        else if(strlen(first_pass) >= 4)
                            format(confirm_pass, sizeof(confirm_pass), "%s", first_pass);
                        else
                        {
                            ShowNotification(playerid, NOTIFY_TYPE_TEXT_RED, 5, 0, 0, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜.", "");
                            JSON_Cleanup(json);
                            return 1;
                        }

                        if(got_pass && first_pass[0] != EOS && strcmp(confirm_pass, first_pass, false) != 0)
                        {
                            ShowNotification(playerid, NOTIFY_TYPE_TEXT_RED, 5, 0, 0, "˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜.", "");
                            JSON_Cleanup(json);
                            return 1;
                        }

                        Auth_StoreRegPassword(playerid, confirm_pass);
                        // t:2 ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜.
                        // ˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜,
                        // ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ (˜˜˜).
                        JSON_Cleanup(json);
                        return 1;
                    }

                    if(!got_pass)
                    {
                        Auth_OnWrongPassword(playerid);
                        JSON_Cleanup(json);
                        return 1;
                    }

                    Auth_SubmitLogin(playerid, password);
                    JSON_Cleanup(json);
                    return 1;
                }
                case 6:
                {
                    new password[65];
                    password[0] = EOS;
                    new bool:got_pass = false;
                    if(Auth_ReadFirstStringField(json, password, sizeof(password), "s", "p", "password", "pass", "pwd")
                        && strlen(password) >= 6 && strlen(password) <= 16)
                        got_pass = true;

                    if(!got_pass)
                    {
                        Auth_OnWrongPassword(playerid);
                        JSON_Cleanup(json);
                        return 1;
                    }

                    Auth_SubmitLogin(playerid, password);
                    JSON_Cleanup(json);
                    return 1;
                }
            }
        }
        case MM_GUI_ID:
        {
            MM_OnMenuGuiPacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case MM_STATS_GUI_ID:
        {
            MM_OnStatsGuiPacket(playerid, json);
            JSON_Cleanup(json);
            return 1;
        }
        case 45:
        {
            Family_OnGuiPacket(playerid, json, g_GuiJsonInBuf);
            JSON_Cleanup(json);
            return 1;
        }
        case SPAWN_GUI_ID:
        {
            printf("[IPacket:50] %s: %s (spawn_active=%d)", Player[playerid][pName], g_GuiJsonInBuf, GetPVarInt(playerid, "spawn_gui_active"));
            SpawnLoc_HandlePacket(playerid, json, g_GuiJsonInBuf);
            return 1;
        }
    }
    JSON_Cleanup(json);
    return 1;
}

stock GetTuningPrice(gosCost, tuneId)
{
    new Float:percent;
    new addedValue;

    switch(tuneId)
    {
        case 0: { percent = 4.0; addedValue = 15000; } // Comfort
        case 1: { percent = 7.0; addedValue = 15000; } // Sport
        case 2: { percent = 5.0; addedValue = 15000; } // Drift
        case 3: { percent = 0.005; addedValue = 20; }  // Sport+ (˜˜˜˜˜)
        default: return 0;
    }
    return floatround((float(gosCost) * percent / 100.0) + float(addedValue));
}

stock GetNitroPrice(gosCost, nitroId)
{
    new Float:percent;
    switch(nitroId)
    {
        case 0: percent = 2.0; // ˜˜˜˜˜ 2˜
        case 1: percent = 5.0; // ˜˜˜˜˜ 5˜
        case 2: percent = 7.0; // ˜˜˜˜˜ 10˜
        default: return 0;
    }
    return floatround((float(gosCost) * percent / 100.0) + 15000.0);
}

stock SetPlayerPosEx(playerid, Float: x, Float: y, Float: z, Float: angle, interior = -1, virtual_world = -1, freeze = true)
{
	#pragma unused freeze
	SetPlayerPos(playerid, x, y, z);

	SetPlayerFacingAngle(playerid, angle);
	SetCameraBehindPlayer(playerid);

	if(interior != -1)
	{
		SetPlayerInterior(playerid, interior);
	}
	if(virtual_world != -1)
	{
		SetPlayerVirtualWorld(playerid, virtual_world);
	}
	return 1;
}
