stock AT_ShowCommandsForLevel(playerid, level)
{
    new title[96], list[1800];

    switch(level)
    {
        case 1: format(list, sizeof(list), "/sp\n/g\n/vget\n/gh\n/ans");
        case 2: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail");
        case 3: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget");
        case 4: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc");
        case 5: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work");
        case 6: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work\n/setadmin\n/givecases");
        case 7: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work\n/setadmin\n/givecases");
        case 8: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work\n/setadmin\n/givecases");
        case 9: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work\n/setadmin\n/givecases");
        case 10: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work\n/setadmin\n/givecases");
        case 11: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work\n/setadmin\n/givecases");
        case 12: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work\n/setadmin\n/givecases");
        case 13: format(list, sizeof(list), "/report\n/ans\n/stats\n/admins\n/ahelp\n/sp\n/spoff\n/goto\n/gethere\n/mute\n/jail\n/kick\n/freeze\n/unfreeze\n/warn\n/ban\n/unban\n/unmute\n/unjail\n/skin\n/veh\n/getv\n/vget\n/setmoney\n/setbc\n/work\n/setadmin\n/givecases\n/re\n/reoff");
        default: format(list, sizeof(list), "/ahelp");
    }

    if(level >= 1 && level <= 13) format(title, sizeof(title), "{E0584B}AHELP {FFFFFF}| %s", AT_AdminRanks[level - 1]);
    else format(title, sizeof(title), "{E0584B}AHELP {FFFFFF}| ˜˜˜˜˜˜˜");

    SetPVarInt(playerid, "AT_AHELP_SELECTED_LEVEL", level);
    ShowPlayerDialog(playerid, AT_DIALOG_AHELP_LEVEL_CMDS, DIALOG_STYLE_LIST, title, list, "˜˜˜˜˜˜˜", "˜˜˜˜˜");
    return 1;
}

stock AT_GetAHelpLevelFromInput(const input[])
{
    if(isnull(input)) return 0;

    new level = strval(input);
    if(1 <= level <= 13) return level;

    if(!strcmp(input, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜", true)) return 1;
    if(!strcmp(input, "˜˜˜˜˜˜˜˜˜", true)) return 2;
    if(!strcmp(input, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜", true)) return 3;
    if(!strcmp(input, "˜˜˜˜˜˜˜˜˜˜˜˜˜", true)) return 4;
    if(!strcmp(input, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜", true)) return 5;
    if(!strcmp(input, "˜˜", true) || !strcmp(input, "˜˜˜", true) || !strcmp(input, "˜˜/˜˜˜", true)) return 6;
    if(!strcmp(input, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜", true)) return 7;
    if(!strcmp(input, "˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜", true)) return 8;
    if(!strcmp(input, "˜˜˜. ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜", true) || !strcmp(input, "˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜", true)) return 9;
    if(!strcmp(input, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜", true)) return 10;
    if(!strcmp(input, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜", true)) return 11;
    if(!strcmp(input, "˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜", true)) return 12;
    if(!strcmp(input, "˜˜˜˜˜˜˜˜˜˜", true)) return 13;
    if(!strcmp(input, "˜˜˜˜˜˜˜˜˜˜", true) || !strcmp(input, "˜˜˜˜˜˜˜˜˜˜˜", true) || !strcmp(input, "˜˜˜˜˜˜", true)) return 14;

    return 0;
}

stock AT_SaveAdminDataToDB(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new query[192];
    mysql_format(db_handle, query, sizeof(query),
        "UPDATE `players` SET `admlvl` = %d, `admprefix` = '%e' WHERE `id` = %d",
        Player[playerid][pAdminLvl],
        Player[playerid][pAdminPrefix],
        Player[playerid][pID]
    );
    mysql_tquery(db_handle, query, "", "");
    return 1;
}

stock AT_LoadTemplates()
{
    for(new i = 0; i < AT_MAX_TEMPLATES; i++)
    {
        AT_Templates[i][atUsed] = 0;
        AT_Templates[i][atId] = 0;
        AT_Templates[i][atCategory] = 0;
        AT_Templates[i][atTime] = 0;
        AT_Templates[i][atCreatedBy] = 0;
        format(AT_Templates[i][atTitle], 64, "");
        format(AT_Templates[i][atDesc], 256, "");
    }

    mysql_tquery(db_handle, "SELECT id, category, title, description, time_value, created_by FROM admin_templates ORDER BY id ASC", "OnAdminTemplatesLoaded", "");
    return 1;
}

forward OnAdminTemplatesLoaded();
public OnAdminTemplatesLoaded()
{
    new rows = cache_num_rows();
    new idx = 0;

    for(new i = 0; i < rows && idx < AT_MAX_TEMPLATES; i++)
    {
        AT_Templates[idx][atUsed] = 1;
        AT_Templates[idx][atId] = cache_get_field_content_int(i, "id", db_handle);
        AT_Templates[idx][atCategory] = cache_get_field_content_int(i, "category", db_handle);
        AT_Templates[idx][atTime] = cache_get_field_content_int(i, "time_value", db_handle);
        AT_Templates[idx][atCreatedBy] = cache_get_field_content_int(i, "created_by", db_handle);
        cache_get_field_content(i, "title", AT_Templates[idx][atTitle], db_handle, 64);
        cache_get_field_content(i, "description", AT_Templates[idx][atDesc], db_handle, 256);
        idx++;
    }
    return 1;
}

stock AT_FindTemplateById(templateId)
{
    for(new i = 0; i < AT_MAX_TEMPLATES; i++)
    {
        if(AT_Templates[i][atUsed] && AT_Templates[i][atId] == templateId) return i;
    }
    return -1;
}

stock AT_EnqueueReport(playerid, const text[])
{
    if(ReportQCount >= AT_REPORT_QUEUE_MAX) return 0;

    ReportQueuePlayer[ReportQTail] = playerid;
    format(ReportQueueText[ReportQTail], 144, "%s", text);

    ReportQTail = (ReportQTail + 1) % AT_REPORT_QUEUE_MAX;
    ReportQCount++;
    return 1;
}

stock AT_DequeueReport(&targetid, text[], len = 144)
{
    if(ReportQCount <= 0) return 0;

    targetid = ReportQueuePlayer[ReportQHead];
    format(text, len, "%s", ReportQueueText[ReportQHead]);

    ReportQHead = (ReportQHead + 1) % AT_REPORT_QUEUE_MAX;
    ReportQCount--;
    return 1;
}

stock MM_IsFemaleSkin(skinid)
{
    switch(skinid)
    {
        case 9..17, 20..38, 55, 56, 69, 76..90, 93: return 1;
    }
    return 0;
}

stock MM_GetPlayerGender(playerid, dest[], size)
{
    if(MM_IsFemaleSkin(GetPlayerSkin(playerid))) format(dest, size, "˜˜˜˜˜˜˜");
    else format(dest, size, "˜˜˜˜˜˜˜");
}

stock MM_GetPlayerPhone(targetid)
{
    if(Player[targetid][pSimCard] > 0) return Player[targetid][pSimCard];
    if(Player[targetid][pPhoneOwned]) return (2000000 + Player[targetid][pID]);
    return Player[targetid][pID];
}

stock MM_GetPlayerHouseLabel(playerid, dest[], size)
{
    for(new i = 0; i < TotalHouses; i++)
    {
        if(HouseInfo[i][hOwnerID] == Player[playerid][pID])
        {
            format(dest, size, "%s", HouseInteriors[HouseInfo[i][hType]][iName]);
            return 1;
        }
    }
    format(dest, size, "˜˜˜˜˜˜˜˜˜");
    return 0;
}

stock MM_GetPlayerBusinessLabel(playerid, dest[], size)
{
    new b = Player[playerid][pBusiness];
    if(b >= 0 && b < g_business_loaded && GetBusinessData(b, B_OWNER_ID) == Player[playerid][pID])
    {
        format(dest, size, "%s", GetBusinessData(b, B_NAME));
        return 1;
    }
    format(dest, size, "˜˜˜");
    return 0;
}

stock MM_GetPlayerVipLabel(playerid, dest[], size)
{
    if(Player[playerid][pVipType] > 0 && Player[playerid][pVipTime] > 0)
    {
        new vip_name[24];
        switch(Player[playerid][pVipType])
        {
            case 1: vip_name = "Silver";
            case 2: vip_name = "Gold";
            case 3: vip_name = "Platinum";
            default: vip_name = "VIP";
        }
        format(dest, size, "%s", vip_name);
        return 1;
    }
    format(dest, size, "˜˜˜");
    return 0;
}

stock MM_GetPlayerGameStatus(playerid, dest[], size)
{
    if(Player[playerid][pLevel] >= 20) format(dest, size, "˜˜˜˜˜˜˜");
    else if(Player[playerid][pLevel] >= 10) format(dest, size, "˜˜˜˜˜˜˜˜˜˜˜");
    else format(dest, size, "˜˜˜˜˜˜˜");
}

stock MM_AppendStatLine(body[], size, const label[], const value[])
{
    format(body, size, "%s%s %s<br>", body, label, value);
}

stock MM_BuildStatsHtml(targetid, body[], size)
{
    body[0] = EOS;

    new val[96], gender[16], house[48], biz[64], vip[32], status[32], org[48], pos[48];

    format(val, sizeof(val), "%d", Player[targetid][pID]);
    MM_AppendStatLine(body, size, "˜ ˜˜˜˜˜˜˜˜:", val);

    format(body, size, "%s˜˜˜: <font color='#8FD3FF'>%s</font><br>", body, Player[targetid][pName]);

    format(val, sizeof(val), "%d", Player[targetid][pLevel]);
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜:", val);

    format(val, sizeof(val), "%d ˜˜ %d", Player[targetid][pExp], GetExpToNextLevel(targetid));
    MM_AppendStatLine(body, size, "˜˜˜˜ ˜˜˜˜˜:", val);

    format(val, sizeof(val), "%d", MM_GetPlayerPhone(targetid));
    MM_AppendStatLine(body, size, "˜˜˜˜˜ ˜˜˜˜˜˜˜˜:", val);

    format(val, sizeof(val), "0 ˜˜˜");
    MM_AppendStatLine(body, size, "˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜:", val);

    format(val, sizeof(val), "0");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜:", val);
    MM_AppendStatLine(body, size, "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜:", "1 (0)");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜˜˜:", "˜˜˜˜˜˜˜˜˜˜˜ (0 ˜˜˜˜˜)");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜:", "0");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜:", "0");
    MM_AppendStatLine(body, size, "˜˜˜˜:", "0");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜˜˜:", "0");

    MM_GetPlayerGender(targetid, gender, sizeof(gender));
    MM_AppendStatLine(body, size, "˜˜˜:", gender);
    MM_AppendStatLine(body, size, "˜ ˜˜˜˜˜:", "-----");

    format(body, size, "%s<br>", body);

    format(val, sizeof(val), "˜˜ ˜˜˜˜˜˜˜");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜:", val);

    if(Player[targetid][pFamilyId] > 0 && Player[targetid][pFamilyName][0])
        format(org, sizeof(org), "%s", Player[targetid][pFamilyName]);
    else format(org, sizeof(org), "˜˜˜˜˜˜˜˜˜˜˜");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜˜˜˜˜:", org);

    if(Player[targetid][pFamilyId] > 0 && Player[targetid][pFamilyRank] > 0)
        format(pos, sizeof(pos), "%d", Player[targetid][pFamilyRank]);
    else format(pos, sizeof(pos), "˜˜˜˜˜˜˜˜˜˜˜");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜˜˜:", pos);

    format(body, size, "%s<br>", body);

    MM_GetPlayerHouseLabel(targetid, house, sizeof(house));
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜˜˜˜:", house);

    MM_GetPlayerBusinessLabel(targetid, biz, sizeof(biz));
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜:", biz);
    MM_AppendStatLine(body, size, "˜˜˜˜˜:", "˜˜˜");
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜˜:", "˜˜˜");

    MM_GetPlayerGameStatus(targetid, status, sizeof(status));
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜ ˜˜˜˜˜˜:", status);

    MM_GetPlayerVipLabel(targetid, vip, sizeof(vip));
    MM_AppendStatLine(body, size, "˜˜˜-˜˜˜˜˜˜:", vip);

    format(body, size, "%s<br>", body);
    Admin_FormatBanStatus(targetid, val, sizeof(val));
    MM_AppendStatLine(body, size, "˜˜˜:", val);
    format(val, sizeof(val), "%d", Player[targetid][pMuteTime]);
    MM_AppendStatLine(body, size, "˜˜˜ (˜˜˜):", val);
    format(val, sizeof(val), "%d", Player[targetid][pJailTime]);
    MM_AppendStatLine(body, size, "˜˜˜˜˜˜˜˜ (˜˜˜):", val);
    format(val, sizeof(val), "%d/3", Player[targetid][pWarns]);
    MM_AppendStatLine(body, size, "˜˜˜˜˜:", val);
    return 1;
}

