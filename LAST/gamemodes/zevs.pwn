    return Phone_SendSms(playerid, target_ref, text);
}

stock SetVehicleMainColorHEX(playerid, vehicleid, color)
{
    if(!IsPlayerConnected(playerid)) return 0;
    new BitStream:bs = BS_New();
    if(bs == BitStream:0) return 0;

    BS_WriteValue(bs,
        PR_UINT16, vehicleid,
        PR_UINT8,  0x12,
        PR_UINT32, color
    );

    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock SetVehicleDiskColorHEX(playerid, vehicleid, color)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new body_color = 0;

    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++) {
        for(new v = 0; v < MAX_PLAYER_VEHICLES; v++) {
            if(VehicleInfo[i][v][vSpawned] && VehicleInfo[i][v][vID] == vehicleid) {
                body_color = VehicleInfo[i][v][vBodyColor];
                break;
            }
        }
    }

    new BitStream:bs = BS_New();
    BS_WriteValue(bs,
        PR_UINT16, vehicleid,
        PR_UINT8,  0x12,
        PR_UINT32, body_color,
        PR_UINT32, color,
        PR_UINT32, color,
        PR_UINT32, color
    );

    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock SetVehicleLightsColorHEX(playerid, vehicleid, color)
{
    if(!IsPlayerConnected(playerid)) return 0;
    new BitStream:bs = BS_New();
    if(bs == BitStream:0) return 0;

    BS_WriteValue(bs,
        PR_UINT16, vehicleid,
        PR_UINT8,  0x08,
        PR_UINT32, color
    );

    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock SetVehicleVinylForPlayer(playerid, vehicleid, texture[])
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, vehicleid);
	BS_WriteValue(bitstream, PR_UINT8, 12);

	BS_WriteValue(bitstream, PR_UINT8, strlen(texture));
	BS_WriteValue(bitstream, PR_STRING, texture);

	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
}

forward LaunchControl_PreviewDemoOff(playerid, vehicleid);
public LaunchControl_PreviewDemoOff(playerid, vehicleid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(GetPlayerVehicleID(playerid) != vehicleid) return 0;

    new owner, slot;
    if(!GetVehicleOwnerSlot(vehicleid, owner, slot)) return 0;
    if(!VehicleInfo[owner][slot][vLaunchControlOn])
        SetVehLaunchCtrlForPlr(playerid, vehicleid, 0);
    return 1;
}

forward LaunchControl_AutoOffTimer(playerid);
public LaunchControl_AutoOffTimer(playerid)
{
    g_LcAutoOffTimer[playerid] = 0;
    if(!IsPlayerConnected(playerid)) return 0;

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return 0;

    new owner, slot;
    if(!GetVehicleOwnerSlot(vehicleid, owner, slot)) return 0;
    if(!VehicleInfo[owner][slot][vLaunchControlOn]) return 0;

    LaunchControl_ForceOff(playerid, vehicleid, owner, slot);
    return 1;
}

stock SetVehicleHornSoundForPlayer(playerid, vehicleid, horn_id)
{
    if(!IsPlayerConnected(playerid) || vehicleid == INVALID_VEHICLE_ID) return 0;
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid, PR_UINT8, 15, PR_UINT8, horn_id);
    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock BroadcastVehicleHornSound(vehicleid, horn_id)
{
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(IsPlayerConnected(p)) SetVehicleHornSoundForPlayer(p, vehicleid, horn_id);
    }
    return 1;
}

stock SetVehicleExhaustForPlayer(playerid, vehicleid, exhaust_id)
{
    if(!IsPlayerConnected(playerid) || vehicleid == INVALID_VEHICLE_ID) return 0;
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid, PR_UINT8, 24, PR_UINT16, exhaust_id);
    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock BroadcastVehicleExhaustSound(vehicleid, exhaust_id)
{
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(IsPlayerConnected(p)) SetVehicleExhaustForPlayer(p, vehicleid, exhaust_id);
    }
    return 1;
}

stock PV_ApplyWheelPhysicsPlr(forplayerid, vehicleid, ownerid, slot)
{
    return Tune_ApplyWheelPhysicsPlr(forplayerid, vehicleid, ownerid, slot);
}

public Timer_ReapplyWheelPhysics(vehicleid, ownerid, slot)
{
    if(vehicleid == INVALID_VEHICLE_ID || !GetVehicleModel(vehicleid)) return 0;
    if(ownerid < 0 || ownerid >= MAX_PLAYERS || slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(!IsPlayerConnected(ownerid)) return 0;
    if(VehicleInfo[ownerid][slot][vID] != vehicleid) return 0;
    BroadcastVehicleWheelPhysics(vehicleid, ownerid, slot);
    return 1;
}

stock BroadcastVehicleWheelPhysics(vehicleid, ownerid, slot)
{
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(!IsPlayerConnected(p)) continue;
        PV_ApplyWheelPhysicsPlr(p, vehicleid, ownerid, slot);
    }
    return 1;
}

// 0 = ˜˜ detal7 / ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜; >0 = ˜˜˜˜ ˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜˜˜ BC.
stock Tune_GetDetal7PurchasePrice(playerid, detal_id)
{
    detal_id = Tune_NormalizePurchaseItemId(detal_id);

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return 0;

    new v = GetPlayerVehicleSlot(playerid, vehicleid);
    if(v == -1 || !VehicleInfo[playerid][v][vSpawned]) return 0;

    new car_price = Tune_GetSessionGosCost(playerid, vehicleid);
    if(car_price <= 0) car_price = Tune_GetVehicleGosCost(playerid, vehicleid);

    if(Tune_IsEngineChipItemId(detal_id))
    {
        new mode_idx = Tune_GetChipModeIndexFromItemId(detal_id);
        new level_idx = Tune_GetChipLevelFromItemId(detal_id);
        if(mode_idx < 0 || level_idx < 0) return 0;
        if(IsPartInstalled(Tune_GetChipPartValue(playerid, v, mode_idx), level_idx + 1)) return 0;
        return Tune_GetDetailPrice(15 + level_idx, car_price, mode_idx);
    }

    new nitro_nd = Tune_NitroDetalIndexFromPacket(detal_id);
    if(nitro_nd >= 0)
    {
        if(VehicleInfo[playerid][v][vNitro] == nitro_nd + 1) return 0;
        return GetNitroPrice(car_price, nitro_nd);
    }

    if(detal_id == TUNE_ITEM_DALNIY || detal_id == 130)
    {
        if(VehicleInfo[playerid][v][vDalniysvet] > 0) return 0;
        new price = Tune_GetDetailPriceByItemId(TUNE_ITEM_DALNIY, car_price);
        if(price <= 0) price = GetDalniyCost(car_price);
        return price;
    }
    if(detal_id == TUNE_ITEM_HYDRA)
    {
        if(VehicleInfo[playerid][v][vHydra] > 0) return 0;
        new price = Tune_GetDetailPriceByItemId(TUNE_ITEM_HYDRA, car_price);
        if(price <= 0) price = GetUnivCost(car_price);
        return price;
    }
    if(detal_id == TUNE_ITEM_PNEVMO)
    {
        if(VehicleInfo[playerid][v][vPnevmo] > 0) return 0;
        new price = Tune_GetDetailPriceByItemId(TUNE_ITEM_PNEVMO, car_price);
        if(price <= 0) price = GetUnivCost(car_price);
        return price;
    }
    if(detal_id == TUNE_ITEM_LAUNCH_CONTROL)
    {
        if(VehicleInfo[playerid][v][vLaunchControl] > 0) return 0;
        new price = Tune_GetDetailPriceByItemId(TUNE_ITEM_LAUNCH_CONTROL, car_price);
        return (price > 0) ? price : 0;
    }
    if(Tune_GetExhaustSoundFromItemId(detal_id) >= 0)
    {
        new price = Tune_GetDetailPriceByItemId(detal_id, car_price);
        return (price > 0) ? price : 0;
    }
    if(Tune_GetHornSoundFromItemId(detal_id) >= 0)
    {
        new price = Tune_GetDetailPriceByItemId(detal_id, car_price);
        return (price > 0) ? price : 0;
    }
    if(Tune_GetWheelTuneIdFromItemId(detal_id) > 0)
    {
        new price = Tune_GetDetailPriceByItemId(detal_id, car_price);
        if(price <= 0) price = GetUnivCost(car_price);
        return price;
    }
    if(detal_id >= 28 && detal_id <= 32)
        return Tune_GetDetailPriceByItemId(detal_id, car_price);

    if(detal_id == TUNE_SEL_WEAR || GetPVarInt(playerid, "tune_bk_sel") == TUNE_SEL_WEAR)
    {
        new Float:hp = VehicleInfo[playerid][v][vHealth];
        return Sto_GetRepairPrice(car_price, hp);
    }

    if(Tune_IsBodyKitItemId(detal_id))
    {
        new selector = 0, sub = 0, tune_id = 0, item_type = 0;
        new Node:tmp = JSON_Object();
        if(Tune_BodyKitMetaFromPacket(tmp, g_GuiJsonInBuf, detal_id, selector, sub, tune_id, item_type, playerid))
        {
            SetPVarInt(playerid, "tune_bk_sel", selector);
            SetPVarInt(playerid, "tune_bk_sub", sub);
            if(item_type >= 0)
                return Tune_GetDetailPrice(item_type, car_price, tune_id);
        }
        JSON_Cleanup(tmp);
        return GetUnivCost(car_price);
    }
    return 0;
}

// detal_id ˜˜ tune-items (id), ˜˜ tuneId. ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜˜ type 7 ˜˜ ˜˜˜˜˜˜.
stock Tune_ApplySetDetail10(playerid, slot, vehicleid, detal_id)
{
    detal_id = Tune_NormalizePurchaseItemId(detal_id);
    new query[192];
    new car_dbid = VehicleInfo[playerid][slot][vDBID];

    if(Tune_IsEngineChipItemId(detal_id))
        return Tune_ActivateChipModeFromItemId(playerid, slot, vehicleid, detal_id);

    new exhaust_id = Tune_GetExhaustSoundFromItemId(detal_id);
    if(exhaust_id >= 0)
    {
        VehicleInfo[playerid][slot][vExhaustSound] = exhaust_id;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `exhaust_sound` = %d WHERE `id` = %d", exhaust_id, car_dbid);
        mysql_tquery(db_handle, query);
        BroadcastVehicleExhaustSound(vehicleid, exhaust_id);
        return 1;
    }

    new horn_id = Tune_GetHornSoundFromItemId(detal_id);
    if(horn_id >= 0)
    {
        VehicleInfo[playerid][slot][vHornSound] = horn_id;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `horn_sound` = %d WHERE `id` = %d", horn_id, car_dbid);
        mysql_tquery(db_handle, query);
        BroadcastVehicleHornSound(vehicleid, horn_id);
        return 1;
    }

    if(detal_id >= 28 && detal_id <= 32)
    {
        new strobLevel = detal_id - 28;
        VehicleInfo[playerid][slot][vStrob] = strobLevel;
        VehicleInfo[playerid][slot][vStrobState] = true;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `strob` = %d WHERE `id` = %d", strobLevel, car_dbid);
        mysql_tquery(db_handle, query);
        BroadcastVehicleStroboscope(vehicleid, playerid, slot);
        return 1;
    }

    new wheel_comp = Tune_GetWheelTuneIdFromItemId(detal_id);
    if(wheel_comp > 0)
    {
        new old_wheel = DetectVehicleWheelComponent(vehicleid);
        if(old_wheel > 0) RemoveVehicleComponent(vehicleid, old_wheel);
        AddVehicleComponent(vehicleid, wheel_comp);
        VehicleInfo[playerid][slot][vWheel] = wheel_comp;
        VehicleInfo[playerid][slot][vWheelModel] = wheel_comp;
        gShinkaStartWheel[playerid] = wheel_comp;
        mysql_format(db_handle, query, sizeof(query),
            "UPDATE `ownable_cars` SET `wheel`=%d, `wheel_model_id`=%d WHERE `id`=%d LIMIT 1",
            wheel_comp, wheel_comp, car_dbid);
        mysql_tquery(db_handle, query);
        Fuel_SaveVehicle(playerid, slot);
        CarSystem_QueueWheelRefresh(vehicleid, playerid, slot);
        BroadcastPersonalVehicleVisuals(vehicleid, playerid, slot);
        return 1;
    }

    if(Tune_IsBodyKitItemId(detal_id))
    {
        new selector = 0, sub = 0, tune_id = 0, item_type = 0;
        new Node:tmp = JSON_Object();
        if(!Tune_BodyKitMetaFromPacket(tmp, g_GuiJsonInBuf, detal_id, selector, sub, tune_id, item_type, playerid))
        {
            JSON_Cleanup(tmp);
            return 0;
        }
        JSON_Cleanup(tmp);
        SetPVarInt(playerid, "tune_bk_sel", selector);
        SetPVarInt(playerid, "tune_bk_sub", sub);
        return Tune_BkApplyBodyKit(playerid, slot, vehicleid, detal_id, tune_id, selector, sub, false);
    }
    return 0;
}

stock Tune_ApplyPurchaseDetal7(playerid, detal_id, Node:json_out)
{
    detal_id = Tune_NormalizePurchaseItemId(detal_id);

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID) return 0;

    new v = GetPlayerVehicleSlot(playerid, vehicleid);
    if(v == -1 || !VehicleInfo[playerid][v][vSpawned]) return 0;

    if((detal_id == TUNE_SEL_WEAR || GetPVarInt(playerid, "tune_bk_sel") == TUNE_SEL_WEAR) && gInStoSession[playerid])
    {
        if(!Sto_ApplyWearRepair(playerid, v, vehicleid)) return 0;
        Tune_FillDetal7SuccessJson(playerid, json_out, TUNE_SEL_WEAR, 0, 7, v);
        return 1;
    }

    if(Tune_IsBodyKitItemId(detal_id))
    {
        new selector = 0, sub = 0, tune_id = 0, item_type = 0;
        new Node:tmp = JSON_Object();
        if(!Tune_BodyKitMetaFromPacket(tmp, g_GuiJsonInBuf, detal_id, selector, sub, tune_id, item_type, playerid))
        {
            JSON_Cleanup(tmp);
            return 0;
        }
        JSON_Cleanup(tmp);
        SetPVarInt(playerid, "tune_bk_sel", selector);
        SetPVarInt(playerid, "tune_bk_sub", sub);
    }

    new old_detal_id = Tune_GetReplacedDetailId(playerid, v, detal_id);
    new car_dbid = VehicleInfo[playerid][v][vDBID];
    new query[192];

    if(Tune_IsEngineChipItemId(detal_id))
    {
        new mode_idx = Tune_GetChipModeIndexFromItemId(detal_id);
        new level_idx = Tune_GetChipLevelFromItemId(detal_id);
        if(mode_idx < 0 || level_idx < 0) return 0;
        if(IsPartInstalled(Tune_GetChipPartValue(playerid, v, mode_idx), level_idx + 1)) return 0;
        if(!BuyPartAtSlot(playerid, v, detal_id)) return 0;
        new chip_val = Tune_GetChipPartValue(playerid, v, mode_idx);
        if(IsFullSetInstalled(chip_val))
            Tune_ActivateChipModeFromItemId(playerid, v, vehicleid, detal_id);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }

    new nitro_nd = Tune_NitroDetalIndexFromPacket(detal_id);
    if(nitro_nd >= 0)
    {
        if(VehicleInfo[playerid][v][vNitro] == nitro_nd + 1) return 0;
        if(!BuyPartAtSlot(playerid, v, nitro_nd)) return 0;
        new nitro_comp = Tune_NitroCompFromDetal(nitro_nd);
        if(nitro_comp) AddVehicleComponent(vehicleid, nitro_comp);
        new nitro_item = detal_id;
        if(nitro_item < 0 || nitro_item > 2) nitro_item = nitro_nd;
        Tune_FillDetal7SuccessJson(playerid, json_out, nitro_item, old_detal_id, 7, v);
        return 1;
    }

    if(detal_id == TUNE_ITEM_DALNIY || detal_id == 130)
    {
        if(VehicleInfo[playerid][v][vDalniysvet] > 0) return 0;
        VehicleInfo[playerid][v][vDalniysvet] = 1;
        VehicleInfo[playerid][v][Dalniysvet] = true;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `dalniysvet` = 1 WHERE `id` = %d", car_dbid);
        mysql_tquery(db_handle, query);
        BroadcastVehicleDlaniy(vehicleid, 1);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }

    if(detal_id == TUNE_ITEM_HYDRA)
    {
        if(VehicleInfo[playerid][v][vHydra] > 0) return 0;
        VehicleInfo[playerid][v][vHydra] = 1;
        VehicleInfo[playerid][v][vHydraState] = false;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `hydra` = 1 WHERE `id` = %d", car_dbid);
        mysql_tquery(db_handle, query);
        BroadcastVehicleHydraulics(vehicleid, playerid, v);
        BroadcastPersonalVehicleVisuals(vehicleid, playerid, v);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }

    if(detal_id == TUNE_ITEM_PNEVMO)
    {
        if(VehicleInfo[playerid][v][vPnevmo] > 0) return 0;
        VehicleInfo[playerid][v][vPnevmo] = 1;
        VehicleInfo[playerid][v][vPnevmoMode] = 0;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `pnevmo` = 1 WHERE `id` = %d", car_dbid);
        mysql_tquery(db_handle, query);
        BroadcastVehiclePnevmoState(vehicleid, playerid, v);
        BroadcastPersonalVehicleVisuals(vehicleid, playerid, v);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }

    if(detal_id == TUNE_ITEM_LAUNCH_CONTROL)
    {
        if(VehicleInfo[playerid][v][vLaunchControl] > 0) return 0;
        VehicleInfo[playerid][v][vLaunchControl] = 1;
        VehicleInfo[playerid][v][vLaunchControlOn] = false;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `launch_control` = 1 WHERE `id` = %d", car_dbid);
        mysql_tquery(db_handle, query);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }

    new exhaust_id = Tune_GetExhaustSoundFromItemId(detal_id);
    if(exhaust_id >= 0)
    {
        VehicleInfo[playerid][v][vExhaustSound] = exhaust_id;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `exhaust_sound` = %d WHERE `id` = %d", exhaust_id, car_dbid);
        mysql_tquery(db_handle, query);
        BroadcastVehicleExhaustSound(vehicleid, exhaust_id);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }

    new horn_id = Tune_GetHornSoundFromItemId(detal_id);
    if(horn_id >= 0)
    {
        VehicleInfo[playerid][v][vHornSound] = horn_id;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `horn_sound` = %d WHERE `id` = %d", horn_id, car_dbid);
        mysql_tquery(db_handle, query);
        BroadcastVehicleHornSound(vehicleid, horn_id);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }

    new wheel_comp = Tune_GetWheelTuneIdFromItemId(detal_id);
    if(wheel_comp > 0)
    {
        new old_wheel = DetectVehicleWheelComponent(vehicleid);
        if(old_wheel > 0) RemoveVehicleComponent(vehicleid, old_wheel);
        AddVehicleComponent(vehicleid, wheel_comp);
        VehicleInfo[playerid][v][vWheel] = wheel_comp;
        VehicleInfo[playerid][v][vWheelModel] = wheel_comp;
        gShinkaStartWheel[playerid] = wheel_comp;

        mysql_format(db_handle, query, sizeof(query),
            "UPDATE `ownable_cars` SET `wheel`=%d, `wheel_model_id`=%d WHERE `id`=%d LIMIT 1",
            wheel_comp, wheel_comp, car_dbid);
        mysql_tquery(db_handle, query);
        Fuel_SaveVehicle(playerid, v);
        CarSystem_QueueWheelRefresh(vehicleid, playerid, v);
        BroadcastPersonalVehicleVisuals(vehicleid, playerid, v);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 24, v);
        return 1;
    }

    if(detal_id >= 28 && detal_id <= 32)
    {
        new strobLevel = detal_id - 28;
        VehicleInfo[playerid][v][vStrob] = strobLevel;
        mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `strob` = %d WHERE `id` = %d", strobLevel, car_dbid);
        mysql_tquery(db_handle, query);
        VehicleInfo[playerid][v][vStrobState] = true;
        BroadcastVehicleStroboscope(vehicleid, playerid, v);
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }

    if(Tune_IsBodyKitItemId(detal_id))
    {
        new selector = 0, sub = 0, tune_id = 0, item_type = 0;
        new Node:tmp = JSON_Object();
        if(!Tune_BodyKitMetaFromPacket(tmp, g_GuiJsonInBuf, detal_id, selector, sub, tune_id, item_type, playerid))
        {
            JSON_Cleanup(tmp);
            return 0;
        }
        JSON_Cleanup(tmp);
        SetPVarInt(playerid, "tune_bk_sel", selector);
        SetPVarInt(playerid, "tune_bk_sub", sub);
        if(!Tune_BkApplyBodyKit(playerid, v, vehicleid, detal_id, tune_id, selector, sub, true))
            return 0;
        Tune_FillDetal7SuccessJson(playerid, json_out, detal_id, old_detal_id, 7, v);
        return 1;
    }
    return 0;
}

stock SetVehicleSuspensionBias(playerid, vehicleid, Float:value)
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT16, vehicleid);
    BS_WriteValue(bitstream, PR_UINT8, 2);
    BS_WriteValue(bitstream, PR_FLOAT, value);
    PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bitstream);
}

