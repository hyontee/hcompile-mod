stock Inv_ResolveAttachModel(catalog_id)
{
    catalog_id = Inv_ClientCatalogId(catalog_id);
    if(catalog_id <= 0) return 0;

    // ˜˜˜˜˜˜ acs.inc: catalog id -> ˜˜˜˜˜˜˜˜ attach-˜˜˜˜˜˜ (˜˜ client id ˜˜ InventoryItems).
    new acs_model = Inv_LookupAcsAttachModel(catalog_id);
    if(acs_model > 0) return acs_model;

    new raw = Inv_GetCatalogRawModel(catalog_id);
    if(raw <= 0) return 0;
    if(Inv_IsClientPlaceholderModel(raw)) return 0;
    if(Inv_GetAccessoryBoneByModel(raw) > 0) return raw;
    return raw;
}

stock Float:Inv_ClampAccessoryScale(Float:sc)
{
    if(sc < 0.35) return 1.0;
    if(sc > 2.5) return 2.5;
    return sc;
}

stock Inv_GetExpectedBoneForAccessory(item_id, modelid)
{
    item_id = Inv_ClientCatalogId(item_id);
    if(modelid <= 0) modelid = Inv_ResolveAttachModel(item_id);

    new bone = Inv_GetAccessoryBoneByModel(modelid);
    if(bone > 0) return bone;
    if(Inv_IsBackpackItem(item_id)) return 1;
    if(item_id >= 8 && item_id <= 20) return 2;
    return 1;
}

stock Inv_SanitizeAccessoryParams(item_id, &modelid, &bone, &Float:px, &Float:py, &Float:pz, &Float:rx, &Float:ry, &Float:rz, &Float:sc, bool:keep_saved_offsets = false)
{
    item_id = Inv_ClientCatalogId(item_id);
    new correct_model = Inv_ResolveAttachModel(item_id);
    if(correct_model > 0) modelid = correct_model;

    if(!keep_saved_offsets)
    {
        new expect_bone = Inv_GetExpectedBoneForAccessory(item_id, modelid);
        if(bone < 1 || bone > 18 || bone != expect_bone)
            bone = expect_bone;
    }
    else if(bone < 1 || bone > 18)
        bone = Inv_GetExpectedBoneForAccessory(item_id, modelid);

    sc = Inv_ClampAccessoryScale(sc);

    if(!keep_saved_offsets && (floatabs(px) > 5.0 || floatabs(py) > 5.0 || floatabs(pz) > 5.0))
        Inv_GetAccessoryPreset(item_id, bone, px, py, pz, rx, ry, rz, sc);
    return 1;
}

stock bool:Inv_FetchAccessoryRowFromCache(playerid, item_id, inv_db_id, &modelid, &bone,
    &Float:px, &Float:py, &Float:pz, &Float:rx, &Float:ry, &Float:rz, &Float:sc)
{
    #pragma unused playerid, inv_db_id
    if(!cache_num_rows()) return false;

    new db_model = cache_get_field_content_int(0, "modelid");
    modelid = Inv_ResolveAccessoryModel(item_id, db_model);
    new dbone = cache_get_field_content_int(0, "bone");
    if(dbone >= 1 && dbone <= 18) bone = dbone;
    px = cache_get_field_content_float(0, "pos_x");
    py = cache_get_field_content_float(0, "pos_y");
    pz = cache_get_field_content_float(0, "pos_z");
    rx = cache_get_field_content_float(0, "rot_x");
    ry = cache_get_field_content_float(0, "rot_y");
    rz = cache_get_field_content_float(0, "rot_z");
    sc = cache_get_field_content_float(0, "scale");
    if(sc < 0.01) sc = 1.0;
    Inv_SanitizeAccessoryParams(item_id, modelid, bone, px, py, pz, rx, ry, rz, sc, true);
    return (modelid > 0);
}

stock bool:Inv_IsAccessoryCatalogId(catalog_id)
{
    catalog_id = Inv_ClientCatalogId(catalog_id);
    if(catalog_id <= 0) return false;
    if(catalog_id == 58 || catalog_id == 134) return false;
    if(catalog_id == 22 || catalog_id == 23 || catalog_id == 21) return false;
    if(IsPlateItem(catalog_id)) return false;
    if(Inv_GetCatalogRawModel(catalog_id) <= 0) return false;
    if(catalog_id >= 135) return true;
    if(catalog_id >= 1 && catalog_id <= 57) return true;
    return false;
}

stock IsItemAccessory(item_id)
{
    item_id = Inv_ClientCatalogId(item_id);
    if(!Inv_IsAccessoryCatalogId(item_id)) return 0;
    return Inv_ResolveAttachModel(item_id);
}
