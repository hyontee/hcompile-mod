    SendAdminMessage(0xFF4B4BFF, str);
    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜.", Player[playerid][pName], playerid);
    SendClientMessage(targetid, -1, str);
    return 1;
}

CMD:unjail(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 2) return 1;
    new targetid, str[128];
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /unjail [ID]");
    if(!IsPlayerConnected(targetid)) return 1;
    Player[targetid][pJailTime] = 0;
    SpawnPlayer(targetid);
    format(str, sizeof(str), "[A] %s[%d] ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d].", Player[playerid][pName], playerid, Player[targetid][pName], targetid);
    SendAdminMessage(0xFF4B4BFF, str);
    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜.", Player[playerid][pName], playerid);
    SendClientMessage(targetid, -1, str);
    return 1;
}

CMD:spawn(playerid, params[])
{
    if(!Player[playerid][pAdminAuth]) return 1;

    new targetid, str[128];
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /spawn [id]");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, "˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜.");

    SetRandomSpawn(targetid);
    SetPlayerInterior(targetid, 0);
    SetPlayerVirtualWorld(targetid, 0);
    SetCameraBehindPlayer(targetid);
    TogglePlayerControllable(targetid, true);

    SetPlayerScore(targetid, Player[targetid][pLevel]);
    SetPlayerSkin(targetid, Player[targetid][pSkin]);
    ResetPlayerMoney(targetid);
    GivePlayerMoney(targetid, Player[targetid][pMoney]);

    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜ ˜˜˜.", Player[playerid][pName], playerid);
    SendClientMessage(targetid, ADMIN_COLOR, str);

    format(str, sizeof(str), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d].", Player[targetid][pName], targetid);
    SendClientMessage(playerid, -1, str);
    return 1;
}
CMD:veh(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;
    new modelid, color1, color2, str[128];
    if(sscanf(params, "ddd", modelid, color1, color2)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /veh [id ˜˜˜˜˜˜] [˜˜˜˜ 1] [˜˜˜˜ 2]");
    if(modelid < 400 || modelid > 611) return SendClientMessage(playerid, 0xFF4B4BFF, "ID ˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜ ˜˜ 400 ˜˜ 611!");
    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);
    if(Player[playerid][pAdminVeh] != INVALID_VEHICLE_ID) DestroyVehicle(Player[playerid][pAdminVeh]);
    Player[playerid][pAdminVeh] = CreateVehicle(modelid, x, y, z, a, color1, color2, -1);
    SetVehicleParamsInit(Player[playerid][pAdminVeh]);
    PutPlayerInVehicle(playerid, Player[playerid][pAdminVeh], 0);
    Fuel_SendHud(playerid, 40.0);
    SetVehicleSpeedometerInfoFP(playerid, Player[playerid][pAdminVeh], 40.0, 0.0);
    format(str, sizeof(str), "{3399FF}˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ %d (ID: %d)", modelid, Player[playerid][pAdminVeh]);
    SendClientMessage(playerid, -1, str);
    return 1;
}

CMD:med(playerid, params[])
{
    return ChiefDoctor_CmdMed(playerid, params);
}

CMD:sethp(playerid, params[])
{
    new targetid = playerid;
    new Float:hp;

    if(sscanf(params, "uf", targetid, hp))
    {
        if(sscanf(params, "f", hp))
        {
            SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /sethp [id ˜˜˜˜˜˜] [HP]  ˜˜˜  /sethp [HP]");
            return 1;
        }
    }
    else if(targetid != playerid)
    {
        if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1)
            return 1;
    }

    if(!IsPlayerConnected(targetid))
    {
        SendClientMessage(playerid, -1, "{E0584B}˜˜˜˜˜ ˜˜ ˜ ˜˜˜˜.");
        return 1;
    }
    if(Player[targetid][pID] <= 0)
    {
        SendClientMessage(playerid, -1, "{E0584B}˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜˜.");
        return 1;
    }

    if(hp <= 0.0)
    {
        SetPlayerHealth(targetid, 0.0);
        SetPlayerArmour(targetid, 0.0);

        new msg_die[96];
        if(targetid == playerid)
            format(msg_die, sizeof msg_die, "{E0584B}˜˜˜˜˜˜˜˜ 0 HP ˜ ˜˜ ˜˜˜˜˜˜˜.");
        else
            format(msg_die, sizeof msg_die, "{E0584B}˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜˜˜ 0 HP.", Player[targetid][pName], targetid);

        SendClientMessage(playerid, -1, msg_die);
        if(targetid != playerid)
            SendClientMessage(targetid, -1, "{E0584B}˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ 0 HP.");
        return 1;
    }

    if(hp > 100.0) hp = 100.0;

    Player[targetid][pHealth] = hp;
    Player[targetid][pArmour] = 0.0;
    SetPlayerHealth(targetid, hp);
    SetPlayerArmour(targetid, 0.0);

    new msg[144];
    if(targetid == playerid)
    {
        format(msg, sizeof msg, "{3399FF}˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜ %.0f HP.", hp);
        SendClientMessage(playerid, -1, msg);
    }
    else
    {
        format(msg, sizeof msg, "{3399FF}˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜ %.0f HP.",
            Player[targetid][pName], targetid, hp);
        SendClientMessage(playerid, -1, msg);
        format(msg, sizeof msg, "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜ %.0f HP.",
            Player[playerid][pName], playerid, hp);
        SendClientMessage(targetid, -1, msg);
    }
    return 1;
}

CMD:setskin(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 3) return 1;
    new targetid, skinid, str[128];
    if(sscanf(params, "ui", targetid, skinid)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /setskin [id ˜˜˜˜˜˜] [id ˜˜˜˜˜]");
    if(!IsPlayerConnected(targetid)) return 1;
    Player[targetid][pSkin] = skinid;
    SetPlayerSkin(targetid, skinid);
    SavePlayerAccount(targetid);
    format(str, sizeof(str), "{3399FF}˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ %s ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ %d.", Player[targetid][pName], skinid);
    SendClientMessage(playerid, -1, str);
    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ %d.", Player[playerid][pName], playerid, skinid);
    SendClientMessage(targetid, -1, str);
    return 1;
}

CMD:skin(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;
    new targetid, skinid, str[128];

    if(sscanf(params, "ud", targetid, skinid)) return SendClientMessage(playerid, -1, "{999999} ˜˜˜˜˜˜˜˜˜˜˜: /skin [˜˜ ˜˜˜˜˜˜] [˜˜ ˜˜˜˜˜]");
    if(!IsPlayerConnected(targetid)) return 1;
    SetPlayerSkin(targetid, skinid);
    format(str, sizeof(str), "{3399FF}˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜ ˜˜˜˜ %d.", Player[targetid][pName], targetid, skinid);
    SendClientMessage(playerid, UNIV_COLOR, str);
    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜ %d.", Player[playerid][pName], playerid, skinid);
    SendClientMessage(targetid, -1, str);
    return 1;
}

stock ShowDoubleTime(playerid)
{
    SendClientMessage(playerid, 0xFFFFFFFF, "{E0584B}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ | {99cc00}˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ {33cc66}X2 {99cc00}˜˜˜˜.");

    SendClientMessage(playerid, 0xFFFFFFFF, "{E0584B}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ | {99cc00}˜˜˜˜˜˜ 'PayDay' ˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜ {33cc66}X2 {99cc00}˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ (EXP).");

    SendClientMessage(playerid, 0xFFFFFFFF, "{E0584B}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ | {99cc00}˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (Black Coin) ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ {33cc66}X2 {99cc00}˜˜˜˜!");

    SendClientMessage(playerid, 0xFFFFFFFF, "{E0584B}˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ | {99cc00}˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜, ˜˜˜ ˜˜˜˜˜ ˜˜˜˜: {33cc66}none.online");
    return 1;
}

stock GivePlayerExp(playerid, amount)
{
    if(amount <= 0) return 0;

#if X2_SYSTEM
    new total_gain = amount * 2;
#else
    new total_gain = amount;
#endif

    Player[playerid][pExp] += total_gain;

    new needed = GetExpToNextLevel(playerid);

    while(Player[playerid][pExp] >= needed)
    {
        Player[playerid][pExp] -= needed;
        Player[playerid][pLevel]++;
        needed = GetExpToNextLevel(playerid);

        new str[128];
        format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜! ˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜: %d", Player[playerid][pLevel]);
        SendClientMessage(playerid, -1, str);
        SetPlayerScore(playerid, Player[playerid][pLevel]);
    }

    SavePlayerAccount(playerid);
    return 1;
}

CMD:payday(playerid, params[])
{
    if(Player[playerid][pAdminLvl] < 6 || !Player[playerid][pAdminAuth])
        return 1;

    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(!IsPlayerConnected(i)) continue;

        else
        {
            GivePlayerExp(i, 1);
            SendClientMessage(i, -1, "{FF9900}========= PayDay =========");
        }

        Player[i][pSecondsHour] = 0;
    }

    new str[128];
    format(str, sizeof(str), "{FF9933}[A] ˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜ PayDay.", Player[playerid][pName], playerid);
    SendAdminMessage(-1, str);

    return 1;
}


CMD:v(playerid, params[])
{
    if(Player[playerid][pVipType] < 1 || Player[playerid][pVipTime] <= 0)
        return ShowNotification(playerid, 0, 5, 0, 0, "˜ ˜˜˜ ˜˜˜ vip-˜˜˜˜˜˜˜!", "");

    if(isnull(params))
        return SendClientMessage(playerid, COLOR_GREY, "˜˜˜˜˜˜˜˜˜˜˜: /v [˜˜˜˜˜]");

    new str[144], vip_name[24];
    switch(Player[playerid][pVipType])
    {
        case 1: vip_name = "Silver VIP";
        case 2: vip_name = "Gold VIP";
        case 3: vip_name = "Platinum VIP";
        default: vip_name = "VIP";
    }

    format(str, sizeof(str), "[%s] %s[%d]: %s", vip_name, Player[playerid][pName], playerid, params);

    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(IsPlayerConnected(i))
        {
            if((Player[i][pVipType] > 0 && Player[i][pVipTime] > 0) || Player[i][pAdminLvl] > 0)
            {
                SendClientMessage(i, COLOR_VIP_CHAT, str);
            }
        }
    }
    return 1;
}

CMD:gethere(playerid, params[])
{
    if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < 1) return 1;
    new targetid, str[128];
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, -1, "{999999}˜˜˜˜˜˜˜˜˜˜˜: /gethere [id]");
    if(!IsPlayerConnected(targetid)) return 1;
    if(!Admin_CanActOnPlayer(playerid, targetid)) return 1;

    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    SetPlayerPos(targetid, x + 1.5, y, z);
    SetPlayerInterior(targetid, GetPlayerInterior(playerid));
    SetPlayerVirtualWorld(targetid, GetPlayerVirtualWorld(playerid));

    format(str, sizeof(str), "{3399FF}˜˜˜˜˜˜˜˜˜˜˜˜˜ %s[%d] ˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜ ˜˜˜˜.", Player[playerid][pName], playerid);
    SendClientMessage(targetid, ADMIN_COLOR, str);
    format(str, sizeof(str), "{3399FF}[A] ˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ %s[%d] ˜ ˜˜˜˜.", Player[targetid][pName], targetid);
    SendClientMessage(playerid, -1, str);
    return 1;
}
alias:gethere("gh")

