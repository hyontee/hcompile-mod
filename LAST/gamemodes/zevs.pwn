            "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜˜", dialogText, "˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
    }
    else
    {
        ShowPlayerDialog(playerid, AT_DIALOG_AHELP_DIVISION, DIALOG_STYLE_LIST,
            "{E0584B}BR BLACK STUDIO {FFFFFF}| AHELP ˜˜˜˜˜˜˜", dialogText, "˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
    }
    return 1;
}

stock AT_ShowTemplatePosts(playerid, division, bool:for_help)
{
    new text[2000], row[90], c = 0;
    text[0] = '\0';

    for(new i = 0; i < 64; i++)
    {
        AT_SetAdminPostMap[playerid][i] = -1;
        AT_AHelpPostMap[playerid][i] = -1;
    }

    for(new i = 0; i < sizeof(AT_AdminPosts); i++)
    {
        if(AT_AdminPosts[i][atPostDivision] != division) continue;
        if(c >= 64) break;
        format(row, sizeof(row), "%d. %s\n", c + 1, AT_AdminPosts[i][atPostName]);
        strcat(text, row);
        if(for_help) AT_AHelpPostMap[playerid][c] = i;
        else AT_SetAdminPostMap[playerid][c] = i;
        c++;
    }

    if(!c) return SendClientMessage(playerid, COLOR_GREY, "˜ ˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜˜.");

    if(for_help)
    {
        ShowPlayerDialog(playerid, AT_DIALOG_AHELP_POST, DIALOG_STYLE_LIST,
            "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜˜˜˜˜˜ ˜˜˜ AHELP", text, "˜˜˜˜˜˜˜", "˜˜˜˜˜");
    }
    else
    {
        ShowPlayerDialog(playerid, AT_DIALOG_SETADMIN_POST, DIALOG_STYLE_LIST,
            "{E0584B}BR BLACK STUDIO {FFFFFF}| ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜", text, "˜˜˜˜˜˜˜˜˜", "˜˜˜˜˜");
    }
    return 1;
}

