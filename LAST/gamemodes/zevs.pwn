    new Node:cat4 = JSON_Object("bi", JSON_Int(6), "bn", JSON_String("˜˜˜˜˜˜˜˜˜˜˜˜˜˜"), "be", JSON_String("˜˜˜˜˜˜˜˜˜"));
    new Node:cat5 = JSON_Object("bi", JSON_Int(7), "bn", JSON_String("˜˜˜˜˜˜"), "be", JSON_String("˜˜˜˜˜˜˜˜˜"));
