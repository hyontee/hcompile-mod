/*
	˜˜˜˜˜˜: ˜˜˜ ˜˜ ˜˜˜˜˜, ˜˜˜ ˜ ShowNotification (death.pwn) ˜ GUI id 13.
	GUI 39 ˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜ ˜˜˜.

	ShowPlayerGUI / OnPacketIncoming: ˜˜˜˜˜ 252 (˜˜˜˜˜˜ ˜˜˜˜˜ BR-˜˜˜˜˜˜˜).
*/

#define SR_ADMIN_MIN_LVL (5)

#if !defined SR_RESTART_NOTIFY_TYPE
	#define SR_RESTART_NOTIFY_TYPE (2)
#endif
#if !defined SR_RESTART_NOTIFY_DURATION
	#define SR_RESTART_NOTIFY_DURATION (15)
#endif

/*
	˜˜˜˜˜ ˜˜˜˜˜˜˜:
	- ˜˜ ˜˜˜˜˜˜˜˜˜ gmx ˜ ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜, ˜˜˜˜˜˜˜ samp-live ˜˜˜˜˜˜˜ (˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜).
	- ˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜ (˜˜˜˜ ˜˜˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜), ˜˜˜˜˜ include ˜˜˜˜˜˜˜:
	  #define SR_RESTART_USE_FULL_EXIT
*/

#if defined SR_RESTART_USE_FULL_EXIT
	#define SR_RESTART_RCON_FINAL "exit"
#else
	#define SR_RESTART_RCON_FINAL "gmx"
#endif

new gSrvRestartRemain = 0;
new gSrvRestartTimer = 0;

forward ServerRestart_TimerTick();
forward ServerRestart_DelayedShow(playerid);

stock SpawnLoc_NotifyRestartPending(playerid)
{
	if(gSrvRestartTimer && gSrvRestartRemain > 0)
		SetTimerEx("ServerRestart_DelayedShow", 1500, false, "i", playerid);
	return 1;
}

stock ServerRestart_SendGUI(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;

	new buf[384];
	format(buf, sizeof(buf),
		"˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜\n˜˜ ˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜: %d ˜˜˜.",
		gSrvRestartRemain);

	new Node:JSONObject = JSON_Object();
	JSON_SetInt(JSONObject, "o", 1);
	JSON_SetInt(JSONObject, "t", SR_RESTART_NOTIFY_TYPE);
	JSON_SetInt(JSONObject, "d", SR_RESTART_NOTIFY_DURATION);
	JSON_SetInt(JSONObject, "s", 0);
	JSON_SetInt(JSONObject, "b", 1);
	JSON_SetString(JSONObject, "i", buf, strlen(buf));
	JSON_SetString(JSONObject, "k", "", 0);

	OnPacketIncoming(playerid, 13, JSONObject);
	JSON_Cleanup(JSONObject);
	return 1;
}

stock ServerRestart_CloseGUI(playerid)
{
	#pragma unused playerid
	return 1;
}

stock ServerRestart_DestroyPlayer(playerid)
{
	#pragma unused playerid
	return 1;
}

stock ServerRestart_HideAllConnected()
{
	return 1;
}

stock SrvRestart_FlushVehPlates()
{
	return 0;
}

stock ServerRestart_UpdateAllGUI()
{
	if(!gSrvRestartTimer || gSrvRestartRemain <= 0) return 1;
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
			ServerRestart_SendGUI(i);
	}
	return 1;
}

public ServerRestart_TimerTick()
{
	gSrvRestartRemain--;
	if(gSrvRestartRemain <= 0)
	{
		if(gSrvRestartTimer)
		{
			KillTimer(gSrvRestartTimer);
			gSrvRestartTimer = 0;
		}
		ServerRestart_HideAllConnected();
		SrvRestart_FlushVehPlates();
		SendRconCommand(SR_RESTART_RCON_FINAL);
		return;
	}
	ServerRestart_UpdateAllGUI();
}

stock ServerRestart_Begin(playerid_as_admin, seconds)
{
	if(seconds < 5) seconds = 5;
	if(seconds > 900) seconds = 900;

	if(gSrvRestartTimer)
	{
		KillTimer(gSrvRestartTimer);
		gSrvRestartTimer = 0;
	}

	gSrvRestartRemain = seconds;

	SendClientMessageToAll(-1, "{FFFFFF}˜˜˜˜˜˜˜˜! ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜!");

	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
			ServerRestart_SendGUI(i);
	}

	gSrvRestartTimer = SetTimer("ServerRestart_TimerTick", 1000, true);

	new msg[144];
	format(msg, sizeof(msg), "{666666}[˜˜˜˜˜˜˜] ˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜ %d ˜˜˜.", seconds);
	SendClientMessage(playerid_as_admin, COLOR_WHITE, msg);
	return 1;
}

public ServerRestart_DelayedShow(playerid)
{
	if(!IsPlayerConnected(playerid)) return 1;
	if(!gSrvRestartTimer || gSrvRestartRemain <= 0) return 1;
	SendClientMessage(playerid, COLOR_WHITE, "˜˜˜˜˜˜˜˜! ˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜!");
	ServerRestart_SendGUI(playerid);
	return 1;
}

stock ServerRestart_OnGuiPacket(playerid, Node:json)
{
	#pragma unused playerid
	#pragma unused json
	return 1;
}

CMD:restart(playerid, params[])
{
	if(!Player[playerid][pAdminAuth] || Player[playerid][pAdminLvl] < SR_ADMIN_MIN_LVL)
	{
		SendClientMessage(playerid, COLOR_GREY, "{999999}˜˜˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜ ˜˜˜ ˜˜˜˜ ˜˜˜˜˜˜˜.");
		return 1;
	}

	new sec = 30;
	sscanf(params, "d", sec);
	if(sec < 5) sec = 5;
	if(sec > 900) sec = 900;

	ServerRestart_Begin(playerid, sec);
	return 1;
}
// ----- end: server_restart.inc -----

// ----- begin: techcenter.inc -----
forward bool:VehGetFlag(playerid, slot, flag);
forward VehSetFlag(playerid, slot, flag, bool:value);
forward bool:VehToggleFlag(playerid, slot, flag);

stock BuyPartAtSlot(playerid, slot, detal_id)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
    if(slot < 0 || slot >= MAX_PLAYER_VEHICLES) return 0;
    if(!VehicleInfo[playerid][slot][vSpawned]) return 0;

    new type, part_num, add_val, current_val;

    switch(detal_id) {
        // COMFORT (ID: 4, 9, 14, 19, 24)
        case 4:  { type = 3; part_num = 1; add_val = 1; }
        case 9:  { type = 3; part_num = 2; add_val = 20; }
        case 14: { type = 3; part_num = 3; add_val = 300; }
        case 19: { type = 3; part_num = 4; add_val = 4000; }
        case 24: { type = 3; part_num = 5; add_val = 50000; }
        // SPORT (ID: 5, 10, 15, 20, 25)
        case 5:  { type = 1; part_num = 1; add_val = 1; }
        case 10: { type = 1; part_num = 2; add_val = 20; }
        case 15: { type = 1; part_num = 3; add_val = 300; }
        case 20: { type = 1; part_num = 4; add_val = 4000; }
        case 25: { type = 1; part_num = 5; add_val = 50000; }
        // DRIFT (ID: 6, 11, 16, 21, 26)
        case 6:  { type = 2; part_num = 1; add_val = 1; }
        case 11: { type = 2; part_num = 2; add_val = 20; }
        case 16: { type = 2; part_num = 3; add_val = 300; }
        case 21: { type = 2; part_num = 4; add_val = 4000; }
        case 26: { type = 2; part_num = 5; add_val = 50000; }
        // SPORT PLUS (ID: 7, 12, 17, 22, 27)
        case 7:  { type = 4; part_num = 1; add_val = 1; }
        case 12: { type = 4; part_num = 2; add_val = 20; }
        case 17: { type = 4; part_num = 3; add_val = 300; }
        case 22: { type = 4; part_num = 4; add_val = 4000; }
        case 27: { type = 4; part_num = 5; add_val = 50000; }
        case 0..2: { type = 5; part_num = detal_id; add_val = detal_id + 1; }

        default: return 0;
    }

    new col_name[20];
    if(type == 1) { current_val = VehicleInfo[playerid][slot][vSport]; col_name = "sport"; }
    else if(type == 2) { current_val = VehicleInfo[playerid][slot][vDrift]; col_name = "drift"; }
    else if(type == 3) { current_val = VehicleInfo[playerid][slot][vComfort]; col_name = "comfort"; }
    else if(type == 4) { current_val = VehicleInfo[playerid][slot][vSportPlus]; col_name = "sport_plus"; }
    else if(type == 5) { current_val = VehicleInfo[playerid][slot][vNitro]; col_name = "nitro"; }

    if(type == 5) {
        if(current_val == add_val) {
            return 0;
        }
        VehicleInfo[playerid][slot][vNitro] = add_val;
    }
    else {
        if(IsPartInstalled(current_val, part_num)) {
            return 0;
        }
        new new_val = current_val + add_val;
        if(type == 1) VehicleInfo[playerid][slot][vSport] = new_val;
        else if(type == 2) VehicleInfo[playerid][slot][vDrift] = new_val;
        else if(type == 3) VehicleInfo[playerid][slot][vComfort] = new_val;
        else if(type == 4) VehicleInfo[playerid][slot][vSportPlus] = new_val;
    }

    new query[128];
    mysql_format(db_handle, query, sizeof(query), "UPDATE `ownable_cars` SET `%s`='%d' WHERE `id`='%d'", col_name, (type == 5 ? add_val : VehicleInfo[playerid][slot][(type==1?vSport:type==2?vDrift:type==3?vComfort:vSportPlus)]), VehicleInfo[playerid][slot][vDBID]);
    mysql_tquery(db_handle, query, "", "");

    if(type >= 1 && type <= 4)
    {
        new chip_val = VehicleInfo[playerid][slot][(type==1?vSport:type==2?vDrift:type==3?vComfort:vSportPlus)];
        if(IsFullSetInstalled(chip_val))
        {
            new msg[72];
            if(type == 1) format(msg, sizeof msg, "˜˜˜˜˜˜˜˜ SPORT ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜.");
            else if(type == 2) format(msg, sizeof msg, "˜˜˜˜˜˜˜˜ DRIFT ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜.");
            else if(type == 3) format(msg, sizeof msg, "˜˜˜˜˜˜˜˜ COMFORT ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜.");
            else format(msg, sizeof msg, "˜˜˜˜˜˜˜˜ SPORT+ ˜˜˜˜˜˜˜˜˜˜. ˜˜˜˜˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜.");
            ShowNotification(playerid, 2, 4, 1, 1, msg, "");
        }
    }

    return 1;
}

stock BuyPart(playerid, vehicleid, detal_id)
{
    new slot = GetPlayerVehicleSlot(playerid, vehicleid);
    return BuyPartAtSlot(playerid, slot, detal_id);
}

CMD:techcentergui(playerid, params[])
{
    InStailing[playerid] = false;
    gInStoSession[playerid] = false;
    new vehicleid = GetPlayerVehicleID(playerid);
    if (!vehicleid) return SendClientMessage(playerid, -1, "{FF0000}Âû äîëæíû áûòü â ìàøèíå!");

    new slot = GetPlayerVehicleSlot(playerid, vehicleid);
    if (slot == -1) return SendClientMessage(playerid, -1, "{FF0000}Ýòî íå âàø ëè÷íûé òðàíñïîðò!");

    Ts_SnapFuelMileage(playerid, vehicleid);
    Fuel_ForceEngineOff(vehicleid);

    new model = GetVehicleModel(vehicleid);
    new price = Tune_ResolveVehicleGosCost(playerid, slot, model);
    Tune_SetSessionGosCost(playerid, price);
    LaunchControl_ForceOff(playerid, vehicleid, playerid, slot);
    new Node:tuning_json = JSON_Object();
    new Node:k_array = Tune_BuildVehicleKArray(playerid, slot);

    JSON_SetInt(tuning_json, "w", TUNE_SCREEN_TECHCENTER);
    JSON_SetInt(tuning_json, "o", 1); 
    JSON_SetInt(tuning_json, "j", price); 
    JSON_SetInt(tuning_json, "s", 5);
    JSON_SetArray(tuning_json, "k", k_array);
    JSON_SetString(tuning_json, "nm", GetPlayerNameEx(playerid));
    JSON_SetString(tuning_json, "n", GetVehicleNameByModel(model));
    JSON_SetInt(tuning_json, "m", GetPlayerMoneyEx(playerid));
    JSON_SetInt(tuning_json, "dn", GetPlayerBlackCoin(playerid));

    new vw = playerid + 1000;
    SetPlayerVirtualWorld(playerid, vw);
    SetVehicleVirtualWorld(vehicleid, vw);
    SetPlayerInterior(playerid, 1);
    SetVehiclePos(vehicleid, 996.1070, 999.4791, 1000.5);
    SetVehicleZAngle(vehicleid, -90.0);
    SetPlayerCameraPos(playerid, 1001.1626, 1002.8044, 1000.9689);
    SetPlayerCameraLookAt(playerid, 1000.3796, 1002.1858, 1001.0136);

    OnPacketIncoming(playerid, 28, tuning_json);
    JSON_Cleanup(tuning_json);
    return 1;
}

stock ShowTuneTest(playerid, value, const tune_name[])
{
    if(IsFullSetInstalled(value))
    {
        new msg[64];
        format(msg, sizeof(msg), "{00FF00}%s ÂÊËÞ×ÅÍ", tune_name);
        SendClientMessage(playerid, -1, msg);
    }
    else
    {
        new missing[64], msg[128];
        for(new p = 1; p <= 5; p++)
        {
            if(!IsPartInstalled(value, p))
            {
                format(missing, sizeof(missing), "%s%d ", missing, p);
            }
        }
        format(msg, sizeof(msg), "{FF0000}%s ÍÅ ÂÊËÞ×ÅÍ. Íåò äåòàëåé: %s", tune_name, missing);
        SendClientMessage(playerid, -1, msg);
    }
    return 1;
}

