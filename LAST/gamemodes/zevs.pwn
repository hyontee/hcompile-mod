    {
        DeletePVar(playerid, "shinka_ret_x");
        DeletePVar(playerid, "shinka_ret_y");
        DeletePVar(playerid, "shinka_ret_z");
        DeletePVar(playerid, "shinka_ret_a");
        gShinkaStartWheel[playerid] = 0;
    }

    if(was_sto)
    {
        DeletePVar(playerid, "sto_ret_x");
        DeletePVar(playerid, "sto_ret_y");
        DeletePVar(playerid, "sto_ret_z");
        DeletePVar(playerid, "sto_ret_a");
        DeletePVar(playerid, "tune_bk_sel");
        DeletePVar(playerid, "tune_bk_sub");
        DeletePVar(playerid, "tune_bk_tid");
        DeletePVar(playerid, "sto_tune_model");
