stock VehicleMusic_OnPlayerDisconnect(playerid)
{
    if(VehicleMusic_HasSomethingToStop(playerid))
        VehicleMusic_StopPlayback(playerid);
    VehicleMusic_ClearStoredTrack(playerid);
    return 1;
}

stock VM_OnExitVeh(playerid, vehicleid)
{
    #pragma unused vehicleid
    if(g_VehicleMusicOn[playerid])
    {
        SendClientMessage(playerid, -1, "" VM_SC "˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜˜˜˜˜˜˜ ˜ {FFFFFF}˜˜˜˜ ˜˜˜˜˜˜˜˜. {FFFF00}˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜ ˜˜˜˜ ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜ ˜˜ ˜˜˜˜˜.");
        VehicleMusic_StopPlayback(playerid);
        g_VehicleMusicOn[playerid] = 0;
        g_VehicleMusicResumePending[playerid] = 1;
    }
    return 1;
}

stock VM_OnEnterVeh(playerid, vehicleid, ispassenger)
{
    #pragma unused vehicleid
    if(!ispassenger)
        SetTimerEx("VehicleMusic_InMusicTimer", 2200, false, "i", playerid);
    return 1;
}

CMD:music(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid))
    {
        SendClientMessage(playerid, -1, "" VM_SC "˜˜˜˜˜˜ ˜˜˜˜˜ ˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ {FFFF00}˜ ˜˜˜˜˜˜˜˜˜˜");
        return 1;
    }
    new body[] = CAR_CLR_WHITE "˜\t" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜\t" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜\n" CAR_CLR_WHITE "1\t" CAR_CLR_WHITE "˜˜˜˜˜˜\t" CAR_CLR_GOLD "˜˜˜˜˜ ˜˜˜˜˜˜˜˜˜˜˜˜\n" CAR_CLR_WHITE "2\t" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜˜\t" CAR_CLR_GOLD "˜˜˜˜˜˜˜ ˜˜˜˜˜\n" CAR_CLR_WHITE "3\t" CAR_CLR_WHITE "˜˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜\t" CAR_CLR_GOLD "˜˜˜˜";
    ShowPlayerDialog(playerid, DIALOG_VEHICLE_MUSIC_MAIN, DIALOG_STYLE_TABLIST_HEADERS,
        CAR_DLG_PREFIX "˜˜˜˜˜˜", body, "˜˜˜˜˜˜˜", "˜˜˜˜˜˜");
    return 1;
}
// ----- end: vehicle_music.inc -----

// ----- begin: ipacket.inc -----
forward Node:Radial_BuildStateArray(vehicleid, owner, slot);

#if !defined VF_SPORTA
    #define VF_SPORTA      (1)
    #define VF_DRIFTA      (2)
    #define VF_COMFORTA    (4)
    #define VF_SPORTPLUSA  (8)
    #define VF_STROB_ON    (16)
    #define VF_DALNIY_ON   (32)
    #define VF_NEON_ON     (64)
    #define VF_LAUNCH_ON   (128)
#endif

stock bool:VehGetFlag(playerid, slot, flag)
{
    switch(flag)
    {
        case VF_SPORTA: return VehicleInfo[playerid][slot][vSportA];
        case VF_DRIFTA: return VehicleInfo[playerid][slot][vDriftA];
        case VF_COMFORTA: return VehicleInfo[playerid][slot][vComfortA];
        case VF_SPORTPLUSA: return VehicleInfo[playerid][slot][vSportPlusA];
        case VF_STROB_ON: return VehicleInfo[playerid][slot][vStrobState];
        case VF_DALNIY_ON: return VehicleInfo[playerid][slot][Dalniysvet];
        case VF_NEON_ON: return VehicleInfo[playerid][slot][vNeonState];
        case VF_LAUNCH_ON: return VehicleInfo[playerid][slot][vLaunchControlOn];
    }
    return false;
}

stock VehSetFlag(playerid, slot, flag, bool:value)
{
    switch(flag)
    {
        case VF_SPORTA: VehicleInfo[playerid][slot][vSportA] = value;
        case VF_DRIFTA: VehicleInfo[playerid][slot][vDriftA] = value;
        case VF_COMFORTA: VehicleInfo[playerid][slot][vComfortA] = value;
        case VF_SPORTPLUSA: VehicleInfo[playerid][slot][vSportPlusA] = value;
        case VF_STROB_ON: VehicleInfo[playerid][slot][vStrobState] = value;
        case VF_DALNIY_ON: VehicleInfo[playerid][slot][Dalniysvet] = value;
        case VF_NEON_ON: VehicleInfo[playerid][slot][vNeonState] = value;
        case VF_LAUNCH_ON: VehicleInfo[playerid][slot][vLaunchControlOn] = value;
    }
    return 1;
}

stock bool:VehToggleFlag(playerid, slot, flag)
{
    new bool:value = !VehGetFlag(playerid, slot, flag);
    VehSetFlag(playerid, slot, flag, value);
    return value;
}

#define RADIAL_PNEVMO_MIN   (16)
#define RADIAL_PNEVMO_MAX   (18)

stock Float:Radial_GetPnevmoSuspension(pnevmo_type)
{
    switch(pnevmo_type)
    {
        case 16: return -0.04;
        case 17: return 0.0;
        case 18: return 0.04;
    }
    return 0.0;
}

stock Radial_BroadcastSuspension(vehicleid, Float:susp_val)
{
    for(new p = 0, j = GetPlayerPoolSize(); p <= j; p++)
    {
        if(IsPlayerConnected(p)) SetVehicleSuspension(p, vehicleid, susp_val);
    }
}

stock Radial_PushTypeState(playerid, radial_type, active)
{
    new Node:j = JSON_Object();
    JSON_SetInt(j, "t", radial_type);
    JSON_SetInt(j, "s", active);
    OnPacketIncoming(playerid, 27, j);
    JSON_Cleanup(j);
}

stock Radial_PushPnevmoOffExcept(playerid, except_type)
{
    for(new t = RADIAL_PNEVMO_MIN; t <= RADIAL_PNEVMO_MAX; t++)
    {
        if(t != except_type) Radial_PushTypeState(playerid, t, 0);
    }
}

// BR client (GUIRadialMenuForCar.getData): ˜˜˜˜˜˜ "s" ˜ ˜˜˜˜˜˜˜ ˜˜˜˜˜˜ id ˜˜˜˜˜˜, ˜˜˜ ˜˜˜˜˜˜˜˜˜ [8,1].
stock Node:Radial_AppendActiveType(Node:Info, type_id)
{
    return JSON_Append(Info, JSON_Int(type_id));
}

stock Radial_PushAllActiveStates(playerid, vehicleid, owner, slot)
{
    if(vehicleid != INVALID_VEHICLE_ID)
    {
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
        if(doors == VEHICLE_PARAMS_ON) Radial_PushTypeState(playerid, 3, 1);
        if(engine == VEHICLE_PARAMS_ON) Radial_PushTypeState(playerid, 6, 1);
        if(lights == VEHICLE_PARAMS_ON) Radial_PushTypeState(playerid, 14, 1);
    }

    if(owner < 0 || slot < 0) return 1;

    if(VehicleInfo[owner][slot][vDriftA])     Radial_PushTypeState(playerid, 8, 1);
    if(VehicleInfo[owner][slot][vComfortA])   Radial_PushTypeState(playerid, 9, 1);
    if(VehicleInfo[owner][slot][vSportA])     Radial_PushTypeState(playerid, 10, 1);
    if(VehicleInfo[owner][slot][vSportPlusA]) Radial_PushTypeState(playerid, 11, 1);

    if(VehicleInfo[owner][slot][vStrob] >= 0 && VehicleInfo[owner][slot][vStrobState])
        Radial_PushTypeState(playerid, 15, 1);
    if(VehicleInfo[owner][slot][vDalniysvet] > 0 && VehicleInfo[owner][slot][Dalniysvet])
        Radial_PushTypeState(playerid, 13, 1);
    if((VehicleInfo[owner][slot][vNeonMain] != 0 || VehicleInfo[owner][slot][vNeon1] != 0 || VehicleInfo[owner][slot][vNeon2] != 0)
        && VehicleInfo[owner][slot][vNeonState])
        Radial_PushTypeState(playerid, 12, 1);
    if(VehicleInfo[owner][slot][vHydra] > 0 && VehicleInfo[owner][slot][vHydraState])
        Radial_PushTypeState(playerid, 19, 1);

    if(VehicleInfo[owner][slot][vPnevmo] > 0)
    {
        new pm = VehicleInfo[owner][slot][vPnevmoMode];
        if(pm >= RADIAL_PNEVMO_MIN && pm <= RADIAL_PNEVMO_MAX)
            Radial_PushTypeState(playerid, pm, 1);
    }

    if(VehicleInfo[owner][slot][vLaunchControl] > 0 && VehicleInfo[owner][slot][vLaunchControlOn])
        Radial_PushTypeState(playerid, 5, 1);

    return 1;
}

stock Radial_ApplyPnevmoMode(owner, slot, vehicleid, mode)
{
    if(owner < 0 || slot < 0 || vehicleid == INVALID_VEHICLE_ID) return 0;
    VehicleInfo[owner][slot][vPnevmoMode] = mode;
    if(mode >= RADIAL_PNEVMO_MIN && mode <= RADIAL_PNEVMO_MAX)
        Radial_BroadcastSuspension(vehicleid, Radial_GetPnevmoSuspension(mode));
    else
        Radial_BroadcastSuspension(vehicleid, 0.0);
    return 1;
}

stock Node:Radial_BuildStateArray(vehicleid, owner, slot)
{
    new Node:Info = JSON_Array();
    Info = Radial_AppendActiveType(Info, 1);

    if(vehicleid != INVALID_VEHICLE_ID)
    {
        new engine, lights, alarm, doors, bonnet, boot, objective;
        GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
        if(GetVehicleParam(vehicleid, V_LOCK) || doors == VEHICLE_PARAMS_ON)
            Info = Radial_AppendActiveType(Info, 3);
        if(engine == VEHICLE_PARAMS_ON) Info = Radial_AppendActiveType(Info, 6);
        if(lights == VEHICLE_PARAMS_ON) Info = Radial_AppendActiveType(Info, 14);
    }

    if(owner >= 0 && slot >= 0)
    {
        if(VehicleInfo[owner][slot][vDriftA])      Info = Radial_AppendActiveType(Info, 8);
        if(VehicleInfo[owner][slot][vComfortA])    Info = Radial_AppendActiveType(Info, 9);
        if(VehicleInfo[owner][slot][vSportA])      Info = Radial_AppendActiveType(Info, 10);
        if(VehicleInfo[owner][slot][vSportPlusA])  Info = Radial_AppendActiveType(Info, 11);
        if(VehicleInfo[owner][slot][vStrob] >= 0 && VehicleInfo[owner][slot][vStrobState])
            Info = Radial_AppendActiveType(Info, 15);
        if(VehicleInfo[owner][slot][vDalniysvet] > 0 && VehicleInfo[owner][slot][Dalniysvet])
            Info = Radial_AppendActiveType(Info, 13);
        if((VehicleInfo[owner][slot][vNeonMain] != 0 || VehicleInfo[owner][slot][vNeon1] != 0 || VehicleInfo[owner][slot][vNeon2] != 0)
            && VehicleInfo[owner][slot][vNeonState])
            Info = Radial_AppendActiveType(Info, 12);
        if(VehicleInfo[owner][slot][vHydra] > 0 && VehicleInfo[owner][slot][vHydraState])
            Info = Radial_AppendActiveType(Info, 19);
        if(VehicleInfo[owner][slot][vPnevmo] > 0)
        {
            new pm = VehicleInfo[owner][slot][vPnevmoMode];
            if(pm >= RADIAL_PNEVMO_MIN && pm <= RADIAL_PNEVMO_MAX)
                Info = Radial_AppendActiveType(Info, pm);
        }
        if(VehicleInfo[owner][slot][vLaunchControl] > 0 && VehicleInfo[owner][slot][vLaunchControlOn])
            Info = Radial_AppendActiveType(Info, 5);
    }
    return Info;
}

stock Radial_OpenMenu(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid)) return 0;

    new vehicleid = GetPlayerVehicleID(playerid);
    new owner = -1, slot = -1;
    GetVehicleOwnerSlot(vehicleid, owner, slot);

    new Node:radial_json = JSON_Object();
    new Node:Info = Radial_BuildStateArray(vehicleid, owner, slot);

    JSON_SetArray(radial_json, "s", Info);
    ShowPlayerGUI(playerid, 27, radial_json);

    JSON_Cleanup(radial_json);
    JSON_Cleanup(Info);

    Radial_PushAllActiveStates(playerid, vehicleid, owner, slot);
    return 1;
}

// ARGB / #RRGGBB / 0xRRGGBB ˜ ˜˜˜˜˜˜˜˜˜ ˜˜˜˜˜˜ ˜?˜˜ ˜?˜˜ ˜˜˜?˜ (body_color/disk_color).
stock ParseJsonColorHex(const src[])
{
    new len = strlen(src);
    if(!len) return 0;
    new start = 0;
    if(src[0] == '#') start = 1;
    else if(len >= 2 && src[0] == '0' && (src[1] == 'x' || src[1] == 'X')) start = 2;
    new val = 0, digits = 0;
    for(new i = start; i < len && digits < 8; i++)
    {
        new c = src[i], d = -1;
        if('0' <= c <= '9') d = c - '0';
        else if('A' <= c <= 'F') d = 10 + c - 'A';
        else if('a' <= c <= 'f') d = 10 + c - 'a';
        else continue;
        val = (val << 4) | d;
        digits++;
    }
    return val;
}

stock bool:GetVehicleOwnerSlot(vehicleid, &owner, &slot)
{
    owner = -1;
    slot = -1;
    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        for(new v = 0; v < MAX_PLAYER_VEHICLES; v++)
        {
            if(VehicleInfo[i][v][vSpawned] && VehicleInfo[i][v][vID] == vehicleid)
            {
                owner = i;
                slot = v;
                return true;
            }
        }
    }
    return false;
}

stock ShowPlayerGUI(playerid, guiid, Node:json)
{
	JSON_SetInt(json, "o", 1);
	OnPacketIncoming(playerid, guiid, json);
}

stock HidePlayerGUI(playerid, guiid, Node:json)
{
	JSON_SetInt(json, "c", 1);
	OnPacketIncoming(playerid, guiid, json);
}

