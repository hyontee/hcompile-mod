        Tune_ResetChipRuntimeFlagsIfIncomplete(playerid, exit_slot, carid);
        LaunchControl_ForceOff(playerid, carid, playerid, exit_slot);
        BroadcastPersonalVehicleVisuals(carid, playerid, exit_slot);
        if(was_shinka)
            CarSystem_QueueWheelRefresh(carid, playerid, exit_slot);
        SetTimerEx("Timer_ReapplyCarVisuals", 150, false, "iii", carid, playerid, exit_slot);
        SetTimerEx("Timer_ReapplyCarVisuals", 500, false, "iii", carid, playerid, exit_slot);
        SetTimerEx("Timer_ReapplyCarVisuals", 1200, false, "iii", carid, playerid, exit_slot);
    }

    Tune_ClearStylingSession(playerid);
    Tune_ClearSessionGosCost(playerid);

    JSON_SetInt(json_packet_data, "t", 0);
    JSON_SetInt(json_packet_data, "s", 1);
    JSON_SetInt(json_packet_data, "m", GetPlayerMoneyEx(playerid));
    if(exit_slot != -1)
    {
        JSON_SetInt(json_packet_data, "bc", VehicleInfo[playerid][exit_slot][vBodyColor]);
        JSON_SetInt(json_packet_data, "dc", VehicleInfo[playerid][exit_slot][vDiskColor]);
    }

    TogglePlayerControllable(playerid, 1);
    SetCameraBehindPlayer(playerid);
}
            else if(type == 7)
