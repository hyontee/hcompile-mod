ShowPlayerBankAccountCharity(playerid)
{
	format(global_string, 140, ""cWH"Введите количество денег, которые хотите пожертвовать на благотворительность\n\nВы пожертвовали: {63BD4E}%dр", PI[playerid][pCharity]);
	return ShowPlayerDialog(playerid, 9434, 1,""cMain"Благотворительность",global_string,"Принять", "Назад");
}
IsABadBankAccountName(dest[], pos=0)
{
	new is_bad_name = false;
	do
	{
		switch(dest[pos])
		{
		case 'a'..'z', 'A'..'Z', 'а'..'я', 'А'..'Я', '0'..'9': continue;
		default: is_bad_name = true;
		}
	}
	while(dest[++pos]);
	return is_bad_name;
}
IsValidBankAccount(playerid, accountid)
{
	if(0 <= accountid <= 5-1)
	{
		if(g_player_bank_accounts[playerid][accountid][B_ID] > 0)
		{
			return 1;
		}
	}
	return 0;
}
IsNumeric(const str[], pos = 0)
{
	do
	{
		if('0' <= str[pos] <= '9') continue;
		return 0;
	}
	while(str[++pos]);
	return 1;
}
SendBankAccountLog(playerid, accountid, reason[])
{
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bank_accounts_logs` (`account`, `ip`, `time`, `reason`) VALUES ('%d', '%s', NOW(), '%e')", accountid, PI[playerid][pIP], reason);
	mysql_tquery(db_prod, STRING_GLOBAL);
	return 1;
}

UpdateBankMoneyText(playerid, accountid)
{
	format(stringer1,sizeof(stringer1), "%dР.",g_player_bank_accounts[playerid][accountid][B_BALANCE]);
	PlayerTextDrawSetString(playerid, atm_td_player[1][playerid], stringer1);
	return 1;
}

callback::ShowBankAccountHistory(playerid)
{
	new rows = cache_num_rows();
	if(rows)
	{
		new time[32], reason[64];
		global_string = ""cWH"";
		for(new idx; idx < rows; idx ++)
		{
			cache_get_field_content(idx, "time", time, db_prod, 64);
			cache_get_field_content(idx, "reason", reason, db_prod, 64);
			format(global_string, sizeof global_string, "%s%s\t%s\n", global_string, time, reason);
		}
		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Последние 20 операций", global_string, "Закрыть", "");
	}
	else ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"История", ""cWH"История операций пуста", "Закрыть", "");
	return 1;
}
ShowPlayerBankAccountLog(playerid, accountid)
{
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `bank_accounts_logs` WHERE `account` = '%d' ORDER BY id DESC LIMIT 20", accountid);
	mysql_tquery(db_prod, STRING_GLOBAL, "ShowBankAccountHistory", "d", playerid);
	return 1;
}

cmd:friends(playerid, params[])
{
	ShowPlayerDialog(playerid, 7701, DIALOG_STYLE_LIST,""cMain"Меню друзей",""cMain"1. "cWH"Список друзей\n"cMain"2. "cWH"Добавить нового друга","Далее", "Отмена");
	return 1;
}

callback::ShowPlayerFriends(playerid, dialogid)
{
	new rows = cache_num_rows();
	if(rows)
	{
		new
		login[MAX_PLAYER_NAME],
		last_connect[32],
		number_phone[32],
		status[32];

		global_string = "№\tНик\tНомер тел.\tСтатус\tДата входа\n";

		new fmt_str[130];

		for(new idx; idx < rows; idx ++)
		{
			cache_get_field_content(idx, "datavhod", last_connect, db_prod, MAX_PLAYER_NAME);
			cache_get_field_content(idx, "friend", login, db_prod, MAX_PLAYER_NAME);
			cache_get_field_content(idx, "phonenumber", number_phone, db_prod, MAX_PLAYER_NAME);

			if(!strcmp(number_phone, "0")) format(number_phone, sizeof number_phone, "{FF6600}Отсутствует");
			else strcat(number_phone, "\t");

			new friendid = GetPlayerID(login);

			if(friendid != INVALID_PLAYER_ID)
			format(status, 32, ""cMain"В сети (%d)"cWH"", friendid);
			else
			status[0] = EOS, strcat(status, "{FF6600}Не в сети"cWH"");

			format(fmt_str, sizeof fmt_str, ""cMain"%d"cWH". %s"cWH"\t"cMain"%s"cWH"\t%s\t%s\n", idx + 1, login, number_phone, status, last_connect);
			strcat(global_string, fmt_str);

			g_player_listitem[playerid][idx + 1] = cache_get_field_content_int(idx, "id");
		}
		ShowPlayerDialog(playerid, dialogid, DIALOG_STYLE_LIST,""cMain"Друзья",global_string,"Действия", "Отмена");
	}
	else SendClientMessage(playerid, COLOR_RED, "У Вас нет друзей");
}

ShowPlayerFriendsList(playerid)
{
	mysql_format(db_prod, global_string, 250, "SELECT f.*, IFNULL(a.datavhod, '0.0.0.0') datavhod, IFNULL(a.phonenumber, '0') phonenumber FROM friends f LEFT JOIN accounts a ON a.name=f.friend WHERE login='%s'", GetName(playerid));
	mysql_tquery(db_prod, global_string, "ShowPlayerFriends", "dd", playerid, 7777);
	return 1;
}

ShowPlayerSelectBankAccTextDraw(playerid)
{
	for(new i; i < 6; i ++) TextDrawShowForPlayer(playerid, select_acc_td_global[i]);
	for(new i; i < 5; i ++) PlayerTextDrawShow(playerid, select_acc_td_player[i][playerid]);

	SelectTextDrawEx(playerid, -1);
	for(new accountid; accountid < 5; accountid ++)
	{
		if(!IsValidBankAccount(playerid, accountid))
		{
			PlayerTextDrawSetString(playerid, select_acc_td_player[accountid][playerid], "Отсутствует");
			continue;
		}
		stringer1 = "";
		strcat(stringer1, g_player_bank_accounts[playerid][accountid][B_TYPE] ? ("[E]") : ("[R]"));
		strcat(stringer1, g_player_bank_accounts[playerid][accountid][B_NAME]);
		PlayerTextDrawSetString(playerid, select_acc_td_player[accountid][playerid], stringer1);
	}
	select_acc[playerid] = 1;
}

ShowPlayerAtmTextDraw(playerid, accountid)
{
	if(!IsValidBankAccount(playerid, accountid)) return 1;
	if(PI[playerid][pSelectAccType] != SELECT_TYPE_ATM) return 1;

	format(stringer1,sizeof(stringer1), "%dР.",g_player_bank_accounts[playerid][accountid][B_BALANCE]);
	PlayerTextDrawSetString(playerid, atm_td_player[1][playerid], stringer1);


	stringer1 = "";
	strcat(stringer1, g_player_bank_accounts[playerid][accountid][B_NAME]);
	PlayerTextDrawSetString(playerid, atm_td_player[0][playerid], stringer1);

	g_player_listitem_use[playerid] = accountid;
	SelectTextDrawEx(playerid, -1);
	for(new i; i < 6; i ++) TextDrawHideForPlayer(playerid, select_acc_td_global[i]);
	for(new i; i < 5; i ++) PlayerTextDrawHide(playerid, select_acc_td_player[i][playerid]);

	for(new i; i < 32; i ++) TextDrawShowForPlayer(playerid, atm_td_global[i]);
	for(new i; i < 2; i ++) PlayerTextDrawShow(playerid, atm_td_player[i][playerid]);
	return 1;
}

ShowPlayerBankTextDraw(playerid, accountid)
{
	if(!IsValidBankAccount(playerid, accountid)) return 1;
	if(PI[playerid][pSelectAccType] != SELECT_TYPE_BANK) return 1;

	SelectTextDrawEx(playerid, -1);
	g_player_listitem_use[playerid] = accountid;
	for(new i; i < 22; i ++) TextDrawShowForPlayer(playerid, bank_td_global[i]);
	for(new i; i < 6; i ++) TextDrawHideForPlayer(playerid, select_acc_td_global[i]);
	for(new i; i < 5; i ++) PlayerTextDrawHide(playerid, select_acc_td_player[i][playerid]);
	return 1;
}

