DLG(154, playerid, response, listitem, inputtext[])
{
	if(!response) return RemovePlayerFromVehicle(playerid);
	new arid = GetArendCarID(GetPlayerVehicleID(playerid));
	if(arid != -1)
	{
		if(arendkey[playerid] == -1)
		{
			if(ArendInfo[arid][aPlayerID] == INVALID_PLAYER_ID || !IsPlayerConnected(ArendInfo[arid][aPlayerID]))
			{
				if(GetPlayerRubble(playerid) >= ArendInfo[arid][aCost])
				{
					arendkey[playerid] = arid;
					SetPlayerMoney(playerid, -ArendInfo[arid][aCost]);
					ArendInfo[arid][aPlayerID] = playerid;
					SendClientMessage(playerid, -1, ""cDA"Вы успешно арендовали этот транспорт");
					ShowPlayerDialog(playerid, 0, 0, ""cMain"Вы успешно арендовали транспорт", ""cWH"Список доступных команд:\n\n{46ca00}/lock 3"cWH" - закрыть/открыть арендованный транспорт\n{46ca00}/crent"cWH" - отказаться от аренды\n\n{afafaf}При отдалении от ТС на 2км контракт автоматически расторгается", "Закрыть", "");
				}
				else
				{
					SendClientMessage(playerid, COLOR_FADE1, "У вас не хватает денег");
					RemovePlayerFromVehicle(playerid);
				}
			}
			else
			{
				SendClientMessage(playerid, COLOR_FADE1, "Этот транспорт уже арендуют");
				RemovePlayerFromVehicle(playerid);
			}
		}
		else
		{
			SendClientMessage(playerid, COLOR_FADE1, "Вы уже арендуете транспорт");
			RemovePlayerFromVehicle(playerid);
		}
	}
	return 1;
}
