DLG(6467, playerid, response, listitem, inputtext[])
{
	if(!response) return ShowCupboard(playerid);
	new money;
	if(sscanf(inputtext, "i", money) || !(1 <= money <= 1000000))
	{
		SendErr(playerid, "Введите число от 1 до 1000000");
		ShowCupboard(playerid);
		return 1;
	}
	new id = safeid[playerid];
	if(HouseInfo[id][hMoney] < money) return SendClientMessage(playerid, COLOR_GREY, "В сейфе нет такого количества денег");
	HouseInfo[id][hMoney] -= money;
	SetPlayerMoney(playerid, money);
	format(stringer1, sizeof stringer1, "UPDATE `house` SET `hMoney` = '%d' WHERE `id` = '%d'", HouseInfo[id][hMoney], HouseInfo[id][hID]);
	mysql_tquery(db_prod, stringer1, "","");
	SCMF(playerid, COLOR_GREEN, "Вы взяли из шкафа %d рублей", money);
	UpdateCupboard(id);
	return ShowCupboard(playerid);
}
DLG(1256, playerid, response, listitem, inputtext[])
{
	if(!response) return ShowCupboard(playerid);
	new money;
	if(sscanf(inputtext, "i", money) || !(1 <= money <= 1000000))
	{
		SendErr(playerid, "Введите число от 1 до 1000000");
		ShowCupboard(playerid);
		return 1;
	}
	new id = safeid[playerid];
	if(PI[playerid][pCash] < money) return SendClientMessage(playerid, COLOR_DARKORANGE, "У Вас нет такого количества денег");
	if(HouseInfo[id][hMoney] + money > 1000000) return SendClientMessage(playerid, COLOR_DARKORANGE, "Сейф может вместить только 1.000.000 рублей");
	HouseInfo[id][hMoney] += money;
	SetPlayerMoney(playerid, -money);
	format(stringer1, sizeof stringer1, "UPDATE `house` SET `hMoney` = '%d' WHERE `id` = '%d'", HouseInfo[id][hMoney], HouseInfo[id][hID]);
	mysql_tquery(db_prod, stringer1, "","");
	SCMF(playerid, COLOR_LIME, "Вы положили в сейф %d рублей", money);
	UpdateCupboard(id);
	return ShowCupboard(playerid);
}
DLG(6562, playerid, response, listitem, inputtext[])
{
	if(!response) return ShowCupboard(playerid);
	new patr;
	if(sscanf(inputtext, "i", patr) || !(1 <= patr <= 1000))
	{
		SendErr(playerid, "Введите число от 1 до 1000");
