callback::EventInfo(playerid, type)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		format(global_string, sizeof global_string, "%s", eventTextInfo[type][ADM_INFO]);

		new account[MAX_PLAYER_NAME], score, temp[20];
		for(new i = 1; i <= rows; i++)
		{
			cache_get_field_content(i-1, "name", account, db_prod, MAX_PLAYER_NAME);
			cache_get_field_content(i-1, "scoreivent", temp), score = strval(temp);
			format(global_string, sizeof global_string, "%s"cWH"%s - "cMain"%d очков\n", global_string, account, score);
		}
		strcat(global_string, "\n\n"cWH"Итоги ивентов проходят каждое "cMain"воскресенье в 18:00!");

		new bool: success;
		switch(type)
		{
			case 0: { if(PI[playerid][pMember] == TEAM_HITMAN) success = true; }
			case 1:
			{
				switch(PI[playerid][pMember])
				{ case TEAM_MVD,TEAM_FSB: success = true; }
			}
			case 2:
			{
				switch(PI[playerid][pMember])
				{ case TEAM_CSKA, TEAM_SPARTAK, TEAM_ITALMAFIA, TEAM_RUSMAFIA:  success = true; }
			}
			case 3:
			{
				switch(PI[playerid][pMember])
				{
					case TEAM_ARMY: success = true;
				}
			}
		}
		if(success) strcat(global_string, "\n"cWH"Вы можете участвовать в этом ивенте!");
		ShowPlayerDialog(playerid, 0, DSM,""cMain"Ивент",global_string,"Закрыть", "");
	}
	return 1;
}

ShowEventPrize(playerid)
{
	global_string = "";
	format(global_string, sizeof global_string,
	""cWH"Лучший убийца\t"cMain"(%d, %d, %d)\n\
	"cWH"Лучший правоохранитель\t"cMain"(%d, %d, %d)\n"\
	""cWH"Лучший тащер\t"cMain"(%d, %d, %d)\n"\
	""cWH"Лучший армеец\t"cMain"(%d, %d, %d)\n",
	event_season_prize[0][0], event_season_prize[0][1], event_season_prize[0][2],
	event_season_prize[1][0], event_season_prize[1][1], event_season_prize[1][2],
	event_season_prize[2][0], event_season_prize[2][1], event_season_prize[2][2],
	event_season_prize[3][0], event_season_prize[3][1], event_season_prize[3][2]);
	ShowPlayerDialog(playerid, 9003, DSL,""cMain"Призы сезонных ивентов",global_string,"Изменить", "Отмена");
	return 1;
}

DLG(9002, playerid, response, listitem, inputtext[])
{
	if(!response || listitem < 0) return 1;
	switch(listitem)
	{
		case 0: ShowEventPrize(playerid);
		case 1..3: ShowPlayerDialog(playerid, 9005, DSI,""cMain"Призы ивентов",""cWH"Введите "SERVER_COINS" через запятую (10, 20, 30)","Далее", "Отмена");
	}
	g_player_listitem_use[playerid] = listitem;
	return 1;
}

DLG(9003, playerid, response, listitem, inputtext[])
{
	if(!response || listitem < 0) return 1;
	ShowPlayerDialog(playerid, 9004, DSI,""cMain"Призы ивентов",""cWH"Введите "SERVER_COINS" через запятую (10, 20, 30)","Далее", "Отмена");
	g_player_listitem_use[playerid] = listitem;
	return 1;
}

DLG(9004, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new prize[3];
	if(sscanf(inputtext, "p<,>iii", prize[0], prize[1], prize[2]))
	{
		SendClientMessage(playerid, COLOR_RED, "Указаны неверные параметры. Укажите призы через запятую");
		ShowPlayerDialog(playerid, 9003, DSI, ""cMain"Призы ивентов", ""cWH"Введите "SERVER_COINS" через запятую (10, 20, 30)", "Далее", "Отмена");
		return 1;
	}

	new idx = g_player_listitem_use[playerid];
	event_season_prize[idx][0] = prize[0];
	event_season_prize[idx][1] = prize[1];
	event_season_prize[idx][2] = prize[2];

	global_string = "";
	mysql_format(db_prod, global_string, 400, "UPDATE other SET event_season_prize='%d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d'",
	event_season_prize[0][0], event_season_prize[0][1], event_season_prize[0][2],
	event_season_prize[1][0], event_season_prize[1][1], event_season_prize[1][2],
	event_season_prize[2][0], event_season_prize[2][1], event_season_prize[2][2],
	event_season_prize[3][0], event_season_prize[3][1], event_season_prize[3][2]);
	mysql_tquery(db_prod, global_string, "", "");
	SCMF(playerid, 0xFFCC00AA, "Вы изменили призы на %d - %d - %d", prize[0], prize[1], prize[2]);
	return 1;
}

DLG(9005, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new prize[3];
	if(sscanf(inputtext, "p<,>iii", prize[0], prize[1], prize[2]))
	{
		SendClientMessage(playerid, COLOR_RED, "Указаны неверные параметры. Укажите призы через запятую");
		ShowPlayerDialog(playerid, 9005, DSI, ""cMain"Призы ивентов", ""cWH"Введите "SERVER_COINS" через запятую (10, 20, 30)","Далее", "Отмена");
		return 1;
	}
	new idx = g_player_listitem_use[playerid];
	switch(idx)
	{
		case 1:
		{
			event_pubg_prize[0] = prize[0];
			event_pubg_prize[1] = prize[1];
			event_pubg_prize[2] = prize[2];

			global_string = "";
			mysql_format(db_prod, global_string, 400, "UPDATE other SET event_pubg_prize='%d, %d, %d'", event_pubg_prize[0], event_pubg_prize[1], event_pubg_prize[2]);
			mysql_tquery(db_prod, global_string, "", "");
		}
		case 2:
		{
			event_derby_prize[0] = prize[0];
			event_derby_prize[1] = prize[1];
			event_derby_prize[2] = prize[2];

			global_string = "";
			mysql_format(db_prod, global_string, 400, "UPDATE other SET event_derby_prize='%d, %d, %d'", event_derby_prize[0], event_derby_prize[1], event_derby_prize[2]);
			mysql_tquery(db_prod, global_string, "", "");
		}
		case 3:
		{
			event_skydiving_prize[0] = prize[0];
			event_skydiving_prize[1] = prize[1];
			event_skydiving_prize[2] = prize[2];

			global_string = "";
			mysql_format(db_prod, global_string, 400, "UPDATE other SET event_skydiving_prize='%d, %d, %d'", event_skydiving_prize[0], event_skydiving_prize[1], event_skydiving_prize[2]);
			mysql_tquery(db_prod, global_string, "", "");
		}
	}
	SCMF(playerid, 0xFFCC00AA, "Вы изменили призы на %d - %d - %d", prize[0], prize[1], prize[2]);
	fLogs("[admin] %s /apanel управление призы %i %i %i %i", GetName(playerid), idx, prize[0], prize[1], prize[2]);
	return 1;
}

callback::EventResult(type)
{
	new rows, fields;
	cache_get_data(rows, fields);

	new ivent_name[][] = {"Лучший убийца", "Лучший правоохранитель", "Лучший тащер", "Лучший армеец"};
	if(rows)
	{
		new account[MAX_PLAYER_NAME], score, temp[20];
		for(new i = 1; i <= rows; i++)
		{
			cache_get_field_content(i-1, "name", account, db_prod, MAX_PLAYER_NAME);
			cache_get_field_content(i-1, "scoreivent", temp), score = strval (temp);

			if(score == 0) continue;
			new playerid = GetPlayerID(account);
			if(playerid != INVALID_PLAYER_ID)
			{
				PI[playerid][pPerfectCoins] += event_season_prize[type][i-1];
				MysqlUpdatePlayerInt(playerid,"credits",PI[playerid][pPerfectCoins]);
				fLogs("[coin] %s +%i %s", GetName(playerid), event_season_prize[type][i-1], ivent_name[type]);
			}
			else
			{
				SQF1("UPDATE accounts SET credits=credits+%d WHERE name='%s'", event_season_prize[type][i-1], account);
			}
			global_string = "";
			format(global_string, sizeof global_string, "[%s] %s занимает %d место (%d очков), заработав %d "SERVER_COINS"", ivent_name[type], account, i, score, event_season_prize[type][i-1]);
			SendClientMessageToAll(0xFFCC00AA, global_string);
		}
	}
	if(type == 3)
	{
		IteratePlayer(playerid) PI[playerid][pScoreIvent] = 0;
		mysql_tquery(db_prod, "UPDATE accounts SET scoreivent=0");
	}
	return 1;
}

CMD:eventresult(playerid)
{
	if(!g_player_full_access[playerid]) return 1;
	SendGlobalInf("Итоги сезонных ивентов: ");

	mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d ORDER BY scoreivent DESC LIMIT 3", TEAM_HITMAN);
	mysql_tquery(db_prod, global_string, "EventResult", "i", 0);

	mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d OR member = %d OR member = %d OR member = %d OR member = %d ORDER BY scoreivent DESC LIMIT 3", TEAM_OBLASTADMIN, TEAM_MVD, TEAM_FSB, TEAM_HOSPITAL, TEAM_SMI);
	mysql_tquery(db_prod, global_string, "EventResult", "i", 1);

	mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d OR member = %d OR member = %d OR member = %d ORDER BY scoreivent DESC LIMIT 3", TEAM_CSKA, TEAM_SPARTAK, TEAM_RUSMAFIA, TEAM_ITALMAFIA);
	mysql_tquery(db_prod, global_string, "EventResult", "i", 2);

	mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d ORDER BY scoreivent DESC LIMIT 3", TEAM_ARMY);
	mysql_tquery(db_prod, global_string, "EventResult", "i", 3);

	fLogs("[admin] %s /eventresult", GetName(playerid));
	return 1;
}

SkyDivingStart()
{
	if(gSkyDivingStatus != 2) return printf("[SKY DIVING] ERROR START");

	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Мероприятие 'Прыжки с парашюта' началось");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация закрыта");

	gSkyDivingWinners[0] =
	gSkyDivingWinners[1] =
	gSkyDivingWinners[2] = INVALID_PLAYER_ID;

	foreach(new playerid: Player) if(playerGameSkyDiving{playerid})
	{
		ResetPlayerWeapons(playerid);
		new pos = random(sizeof SkyDivingSpawn);
		SetPlayerPos(playerid, SkyDivingSpawn[pos][0], SkyDivingSpawn[pos][1], SkyDivingSpawn[pos][2]);
		SetPlayerFacingAngle(playerid, SkyDivingSpawn[pos][3]);
		GivePlayerWeapon(playerid, 46, 1);
		SetPlayerInterior(playerid, 30);
		playerSkyDivingCount[playerid] = 5;
	}
	return 1;
}
EndSkyDiving()
{
	if(gSkyDivingStatus != 2) return printf("[SKY DIVING] ERROR END");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Мероприятие 'Прыжки с парашюта' завершилось.");

	foreach(new to_player: Player) if(playerGameSkyDiving{to_player})
	{
		playerGameSkyDiving{to_player} = 0;
		playerSkyDivingCount[to_player] = 0;

		ResetPlayerWeapons(to_player);
		SpawnPlayer(to_player);
		break;
	}
	if(gSkyDivingWinners[0] != INVALID_PLAYER_ID)
	{
		PI[gSkyDivingWinners[0]][pPerfectCoins] += event_skydiving_prize[0];
		UpdatePlayerData(gSkyDivingWinners[0], "credits", PI[gSkyDivingWinners[0]][pPerfectCoins]);
		fLogs("[coin] %s +%i прыжки с парашюта 1", GetName(gSkyDivingWinners[0]), event_skydiving_prize[0]);
		SCMF(gSkyDivingWinners[0], 0xFFCC00AA, "За первое место в 'Прыжки с парашюта' Вам было выдано %d "SERVER_COINS"", event_skydiving_prize[0]);
	}
	if(gSkyDivingWinners[1] != INVALID_PLAYER_ID)
	{
		PI[gSkyDivingWinners[1]][pPerfectCoins] += event_skydiving_prize[1];
		UpdatePlayerData(gSkyDivingWinners[1], "credits", PI[gSkyDivingWinners[1]][pPerfectCoins]);
		fLogs("[coin] %s +%i прыжки с парашюта 2", GetName(gSkyDivingWinners[1]), event_skydiving_prize[1]);
		SCMF(gSkyDivingWinners[1], 0xFFCC00AA, "За второе место в 'Прыжки с парашюта' Вам было выдано %d "SERVER_COINS"", event_skydiving_prize[1]);
	}
	if(gSkyDivingWinners[2] != INVALID_PLAYER_ID)
	{
		PI[gSkyDivingWinners[2]][pPerfectCoins] += event_skydiving_prize[2];
		UpdatePlayerData(gSkyDivingWinners[2], "credits", PI[gSkyDivingWinners[2]][pPerfectCoins]);
		fLogs("[coin] %s +%i прыжки с парашюта 3", GetName(gSkyDivingWinners[2]), event_skydiving_prize[2]);
		SCMF(gSkyDivingWinners[2], 0xFFCC00AA, "За третье место в 'Прыжки с парашюта' Вам было выдано %d "SERVER_COINS"", event_skydiving_prize[2]);
	}

	gSkyDivingWinners[2] =
	gSkyDivingWinners[1] =
	gSkyDivingWinners[0] = INVALID_PLAYER_ID;
	gSkyDivingCount =
	gSkyDivingStatus = 0;
	return 1;
}

callback::CheckTickets(playerid, find)
{
	new rows, fields;
	cache_get_data(rows, fields);
	global_string = "";
	if(rows)
	{
		if(find) return SCM(playerid,-1,"У Вас имеются неоплаченные штрафы, действие невозможно!");
		new Names2[MAX_PLAYER_NAME],full,Date[12];
		for(new idx = 0; idx < rows; idx++)
		{
			cache_get_field_content(idx,"Name",Names2);
			cache_get_field_content(idx,"Date",Date);
			format(stringer,sizeof stringer,""cWH"%d. {B4B3B2}№ %d "cWH"К оплате: {B4B3B2}%d рублей "cWH" Дата: {B4B3B2}%s\n",idx+1,cache_get_field_content_int(idx, "Num", db_prod),cache_get_field_content_int(idx, "Sum", db_prod),Date);
			strcat(global_string,stringer);
			full++;
			SetPlayerListitemValue(playerid, idx, cache_get_field_content_int(idx, "Num", db_prod));
		}
		format(stringer1,sizeof stringer1,""cMain"Штрафы %s | Всего %d",Names2,full);
		ShowPlayerDialog(playerid,12006,DIALOG_STYLE_LIST,stringer1,global_string,"Выбор","Отмена");
	}
	else
	{
		if(find) return ShowPlayerDialog(playerid,12005,DIALOG_STYLE_MSGBOX,""cMain"Выкуп автомобиля","{B4B3B2}За услуги эвакуации с Вас будет удержано 5000 рублей.\nВы согласны?","Да","Нет");
		ShowPlayerDialog(playerid,0,DIALOG_STYLE_MSGBOX,""cMain"Штрафы","Информация о штрафах не найдена!","Закрыть","");
	}
	return 1;
}
callback::PaymentTickets(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SCM(playerid,-1,"Штраф с таким номером квитанции не найден!");
	new Names[MAX_PLAYER_NAME],Names2[MAX_PLAYER_NAME],Reason[70],Date[12];
	cache_get_field_content(0,"Writer",Names);
	cache_get_field_content(0,"Name",Names2);
	cache_get_field_content(0,"Reason",Reason);
	cache_get_field_content(0,"Date",Date);
	new id = cache_get_field_content_int(0, "Num", db_prod);
	new summ = cache_get_field_content_int(0, "Sum", db_prod);
	format(stringer, sizeof stringer,"{B4B3B2}Квитанция № %d\n{\
	ffffff}Имя нарушителя: {B4B3B2}%s\n\
	"cWH"К оплате: {B4B3B2}%d рублей\n\
	"cWH"Причина: {B4B3B2}%s\n\
	"cWH"Дата: {B4B3B2}%s\n\
	"cWH"Выписал: {B4B3B2}%s\n\
	Вы хотите оплатить его сейчас?",id,Names2,summ,Reason,Date,Names);
	ShowPlayerDialog(playerid,12003,DIALOG_STYLE_MSGBOX,""cMain" Оплата штрафа",stringer,"Да","Нет");
	SetPVarInt(playerid,"id_tickets",id);
	SetPVarInt(playerid,"summ_tickets",summ);
	return 1;
}
stock Start_MFon(playerid)
{
	new Float:BBCoord[4];
	GetPlayerPos(playerid, BBCoord[0], BBCoord[1], BBCoord[2]);
	GetPlayerFacingAngle(playerid, BBCoord[3]);

	BBCoord[0] += (2 * floatsin(-BBCoord[3], degrees));
	BBCoord[1] += (2 * floatcos(-BBCoord[3], degrees));
	BBCoord[2] -= 0.3;
	Mfon[playerid][p_fonpos][0] = BBCoord[0];
	Mfon[playerid][p_fonpos][1] = BBCoord[1];
	Mfon[playerid][p_fonpos][2] = BBCoord[2];
	//Mfon[playerid][p_object] = 	CreateDynamicObject(1747, BBCoord[0], BBCoord[1], BBCoord[2], 0.0, 0.0, 0.0, .worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid));
	format(string, sizeof(string), "Установил: %s [%d]\nУправление: /mfon", GetName(playerid), playerid);
	Mfon[playerid][p_label] = CreateDynamic3DTextLabel(string, -1, BBCoord[0], BBCoord[1], BBCoord[2]+0.6, 8, .worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid));
	Mfon[playerid][p_area] = CreateDynamicSphere(BBCoord[0], BBCoord[1], BBCoord[2], 20.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	Mfon[playerid][p_int] = GetPlayerInterior(playerid);
	Mfon[playerid][p_vw] = GetPlayerVirtualWorld(playerid);
	Mfon[playerid][p_mfon] = 1;
	ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
	ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
}
stock Stop_MFon(playerid)
{
	ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
	ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
	if(IsValidDynamicObject(Mfon[playerid][p_object])) DestroyDynamicObject(Mfon[playerid][p_object]);
	if(IsValidDynamic3DTextLabel(Text3D:Mfon[playerid][p_label])) DestroyDynamic3DTextLabel(Mfon[playerid][p_label]);
	if(IsValidDynamicArea(Mfon[playerid][p_area]))
	{
		foreach(new i: Player)
		{
			if(IsPlayerInDynamicArea(i, Mfon[playerid][p_area]))
			{
				StopAudioStreamForPlayer(i);
				SendClientMessage(i, COLOR_LIGHTBLUE, "Магнитофон выключен");
			}
		}
	}
	DestroyDynamicArea(Mfon[playerid][p_area]);
	Mfon[playerid][p_mfon] = 0;
	Mfon[playerid][p_st] = 0;
	Mfon[playerid][p_station] = EOS;
	Mfon[playerid][p_int] = 0;
	Mfon[playerid][p_vw] = 0;
	new newslot;
	if(CheckMaxVes(playerid,105,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
	PlayerItem1[playerid][newslot]=105;
	PlayerItem2[playerid][newslot]+=1;
	return 1;
}
stock Switch_Mfon_St(playerid)
{
	if(IsValidDynamicArea(Mfon[playerid][p_area]))
	{
		foreach(new i: Player)
		{
			if(IsPlayerInDynamicArea(i, Mfon[playerid][p_area]))
			{
				StopAudioStreamForPlayer(i);
				SendClientMessage(i, COLOR_LIGHTBLUE, "Смена станции/трека..");
				PlayAudioStreamForPlayer(i, Mfon[playerid][p_station], 0.0, 0.0, 0.0, 20.0, 0);
			}
		}
	}
}

stock ShowPlayerAdminReports(playerid)
{
	new total_admin_reports = 0;
	global_string = "";
	for(new i; i < MAX_REPORTS; i++)
	{
		if(gReportInfo[i][rPlayerID] == -1) continue;
		format(global_string, sizeof(global_string), "%s"cMain"№%d\t"cWH"%s\t%s\n", global_string, gReportInfo[i][rPlayerID], gReportInfo[i][rWhenWroted_Text], PI[gReportInfo[i][rPlayerID]][pName]);
		total_admin_reports++;
	}
	if(total_admin_reports == 0) return SendClientMessage(playerid, COLOR_GREY, !"В данный момент нет обращений.");
	ShowPlayerDialog(playerid, 9006, DIALOG_STYLE_LIST, ""cMain"Список сообщений администраторам", global_string, "Выбрать", "Отмена");
	return 1;
}

DLG(9006, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new
		id = strval(inputtext[strfind(inputtext, "№")]);

	for(new i; i < MAX_REPORTS; i++)
	{
		if(gReportInfo[i][rPlayerID] == id)
		{
			if(gReportInfo[i][rIsTooked] == false)
				ShowPlayerAdminReportAnswer(playerid, id);

			else SendClientMessage(playerid, COLOR_GREY, "На данную жалобу ответ не требуется.");
			break;
		}
	}
	return 1;
}
stock ShowPlayerAdminReportAnswer(playerid, player_id)
{
	for(new i; i < MAX_REPORTS; i++)
	{
		if(gReportInfo[i][rPlayerID] == player_id)
		{
			playerAdminReport[playerid] = i;
			gReportInfo[i][rIsTooked] = true;
			global_string = "";
			format(global_string, sizeof global_string, ""cWH"Сообщение от: "cMain"%s\n\n"cWH"%s\n"cWH"Время отправки: "cMain"%s", PI[ gReportInfo[i][rPlayerID] ][pName], gReportInfo[i][rText], gReportInfo[i][rWhenWroted_Text]);
			ShowPlayerDialog(playerid, 9007, DIALOG_STYLE_INPUT, ""cWH"", global_string, "Ответить", "Удалить");
			break;
		}
	}
	return 1;
}

DLG(9007, playerid, response, listitem, inputtext[])
{
	new report_id = playerAdminReport[playerid], target_id = gReportInfo[report_id][rPlayerID];
	if(report_id == -1) return ShowPlayerAdminReports(playerid);

	if(!response)
	{
		format(global_string, sizeof(global_string), "Администратор %s[%d] удалил жалобу %s[%d]", GetName(playerid), playerid, GetName(target_id), target_id);
		SendAdminMessage(0xFFAA44FF, global_string);
		gReportInfo[report_id][rIsTooked] = false;
		playerAdminReport[playerid] = -1;
		gReportInfo[report_id][rAnswer] = -1;
		if(gReportInfo[report_id][rPlayerID] != -1) playerReportID[gReportInfo[report_id][rPlayerID]] = -1;
		gReportInfo[report_id][rPlayerID] = -1;
		SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно удалили выбранную жалобу.");
		ShowPlayerAdminReports(playerid);
		return 1;
	}
	else
	{
		if(null(inputtext))
		{
			SendClientMessage(playerid, COLOR_GREY, "Ваше сообщение пустое.");
			gReportInfo[report_id][rIsTooked] = false;
			return 1;
		}
		if(target_id == -1) return SendClientMessage(playerid, COLOR_GREY, "Игрок отключился"), gReportInfo[report_id][rIsTooked] = false;
		PI[playerid][pAdmSt][ADMIN_PM] ++;

		global_string="";
		format(global_string, sizeof(global_string), "Администратор %s[%d] ответил игроку %s[%d]: %s", GetName(playerid), playerid, GetName(target_id), target_id, inputtext);
		SendAdminMessage(0xFFAA44FF, global_string);

		AdminInfo[playerid][admAnsText][0] = EOS;
		strcat(AdminInfo[playerid][admAnsText], inputtext);

		if(Setting[target_id][5])
		{
			global_string = "";
			format(global_string, sizeof global_string,""cWH"Ответ на Ваш вопрос/жалобу от %s:\n\n"cMain"%s", PI[playerid][pName], inputtext);
			ShowPlayerDialog(target_id, 0, DSM,""cMain"Ответ",global_string,"Закрыть", "");
		}
		else
		{
			global_string = "";
			format(global_string, sizeof(global_string), "Администратор %s[%d] ответил Вам: %s", PI[playerid][pName],playerid, inputtext);
			SendClientMessage(target_id, 0xFFAA44FF, global_string);
		}
		playerReportID[target_id] = -1;
		gReportInfo[report_id][rIsTooked] = false;
		gReportInfo[report_id][rID] = report_id;
		gReportInfo[report_id][rPlayerID] = -1;
		gReportInfo[report_id][rAnswer] = -1;
		gReportInfo[report_id][rText][0] = EOS;
		gReportInfo[report_id][rWhenWroted_Time] = -1;
		gReportInfo[report_id][rWhenWroted_Text][0] = EOS;
	}

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `server_stats` SET `reports` = `reports` - '1'");
	mysql_tquery(db_prod, STRING_GLOBAL);

	return 1;
}

SetHookLabel(idx)
{
	nfor(i, 8)
	{
		global_string = "";
		format(global_string, sizeof global_string,"{3585CB}- Столик №%d -\n"cWH"Статус: %s", i + 1, HookTableStatus[idx][i] == 1 ? "{FF4530}занят" : ""cMain"свободен");
		if(!IsValidDynamic3DTextLabel(HookTableLabel[idx][i]))
		{
			HookTableLabel[idx][i] = CreateDynamic3DTextLabel(global_string, COLOR_WHITE, hook_table_pos[i][0], hook_table_pos[i][1], hook_table_pos[i][2], 2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,BizzInfo[idx][bVirtual],BizzInfo[idx][bInt]);
		}
		else
		{
			UpdateDynamic3DTextLabelText(HookTableLabel[idx][i], COLOR_WHITE, global_string);
		}
	}
}

HookList(playerid, idx)
{
	global_string = "";
	new status[3][32] = {""cMain"свободно", "{FF4530}занято", "{FF4530}ожидает подтверждения"};
	nfor(i, 8)
	{
		format(global_string, sizeof global_string,"%s"cWH"Место №"cWH"%d\tСтатус: %s\n",global_string, i + 1, status[HookTableStatus[idx][i]]);
	}
	format(global_string, sizeof global_string,"%s"cWH"\n\nСтоимость аренды:\t"cMain"%d рублей",global_string, BizzInfo[idx][bTill]);
	ShowPlayerDialog(playerid, 9008, DSL,""cMain"Кальянная",global_string,"Занять", "Отмена");
	return 1;
}

DLG(9008, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new idx = listitem, biz = GetPlayerInBiz(playerid);

	if(biz == -1) return 1;
	if(!(0 <= listitem <= 7)) return HookList(playerid, biz);

	if(HookTableStatus[biz][idx] && HookTableArendator[biz][idx] != playerid) return SendClientMessage(playerid, COLOR_RED, "К сожалению, но место уже занято");
	if(GetPlayerRubble(playerid) < BizzInfo[idx][bTill]) return SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно денег дня аренды");

	HookTableStatus[biz][idx] = 2;
	playerSelectHook[playerid] = idx;
	g_player_listitem_use[playerid] = idx;
	ShowPlayerHookFriends(playerid);
	return 1;
}

ShowPlayerHookFriends(playerid)
{
	global_string = "Арендовать одному\n";
	new count;
	IteratePlayer(to_player)
	{
		if(playerid == to_player) continue;
		if(GetDistanceBetweenPlayers(playerid, to_player) > 8.0) continue;
		format(global_string, sizeof global_string,"%s%s\n",global_string, GetName(to_player));
		count ++;
		g_player_listitem[playerid][count] = to_player;
	}
	ShowPlayerDialog(playerid, 9009, DSL,""cMain"Кальянная: выбор друзей",global_string,"Выбрать", "Отмена");
	return 1;
}

DLG(9009, playerid, response, listitem, inputtext[])
{
	new idx = g_player_listitem_use[playerid], biz = GetPlayerInBiz(playerid);
	if(!response)
	{
		if(HookTableArendator[biz][idx] == playerid) return HookTableStatus[biz][idx] = 1;
		HookTableStatus[biz][idx] = 0;
		return 1;
	}
	if(!listitem)
	{
		if(playerHookID[playerid] != -1)
		{
			SendClientMessage(playerid, COLOR_GREY, "Вы уже арендуете место в кальянной");
			if(HookTableArendator[biz][idx] == playerid) return HookTableStatus[biz][idx] = 1;
			HookTableStatus[biz][idx] = 0;
		}
		else
		{
			SetPlayerMoney(playerid, -BizzInfo[biz][bTill]);
			SCMF(playerid, 0xFFCC00AA, "Вы успешно арендовали столик №%d. Отправляйтесь к нему и нажмите ALT", idx + 1);

			if(BizzInfo[biz][bProduct] > 0)
			{
				BizzInfo[biz][bMoney] += BizzInfo[biz][bTill];
				BizzInfo[biz][bProduct] -= 25;
				BizzPay[biz] += BizzInfo[biz][bTill];
				MysqlUpdateBizzInt(biz, "money", BizzInfo[biz][bMoney]);
				MysqlUpdateBizzInt(biz, "product", BizzInfo[biz][bProduct]);
			}
			playerSelectHook[playerid] = -1;

			ClearHookPos(biz, idx);
			HookTableStatus[biz][idx] = 1;
			HookTableArendator[biz][idx] = playerid;
			HookTableArendators[biz][idx][0] = playerid;

			SetHookLabel(biz);
			playerHookID[playerid] = idx;
		}
	}
	else
	{
		if(playerHookID[playerid] == -1) return SendClientMessage(playerid, COLOR_GREY, "Вы ещё не арендовали столик"), HookTableStatus[biz][idx] = 0;
		new to_player = g_player_listitem[playerid][listitem];
		if(!IsPlayerConnected(to_player)) return SendClientMessage(playerid, COLOR_GREY, "Ошибка, игрок вышел.");
		if(PlayerLogged[to_player] == false) return SendClientMessage(playerid, COLOR_GREY, "Ошибка, игрок вышел.");
		if(playerHookID[to_player] != -1) return SendClientMessage(playerid, COLOR_GREY, "У этого игрока уже есть место в кальянной");

		new pos = GetHookFreePos(biz, playerHookID[playerid]);
		if(pos == -1) return SendClientMessage(playerid, COLOR_RED, "У Вас нет места за столом, максимум 4");

		HookTableStatus[biz][idx] = 1;
		SetHookLabel(biz);
		SendPlayerProposition(playerid, to_player, PROPOSITION_TYPE_HOOK, idx, biz);
	}
	return 1;
}

ClearHookAllPos(idx)
{
	for(new stol; stol < 8; stol ++)
	{
		for(new mesto; mesto < 4; mesto ++)
		{
			HookTableArendators[idx][stol][mesto] = INVALID_PLAYER_ID;
		}
		HookTableArendator[idx][stol] = INVALID_PLAYER_ID;
	}
	return 1;
}

ClearHookPos(idx, stol)
{
	for(new mesto; mesto < 4; mesto ++)
	{
		HookTableArendators[idx][stol][mesto] = INVALID_PLAYER_ID;
	}
	HookTableStatus[idx][stol] = 0;
	HookTableArendator[idx][stol] = INVALID_PLAYER_ID;
	return 1;
}

GetHookFreePos(idx, stol)
{
	new success = -1;
	for(new mesto; mesto < 4; mesto ++)
	{
		if(HookTableArendators[idx][stol][mesto] == INVALID_PLAYER_ID) success = mesto;
	}
	return success;
}

GetHookArendators(idx, stol)
{
	new success = 0;
	for(new mesto; mesto < 4; mesto ++)
	{
		if(HookTableArendators[idx][stol][mesto] != INVALID_PLAYER_ID) success ++;
	}
	return success;
}

cmd:gethook(playerid, params[])
{
	new biz = GetPlayerInBiz(playerid);
	if(biz == -1) return 1;
	new hook;
	if(sscanf(params, "i", hook)) return SendClientMessage(playerid, -1, ""cPS"Используйте: /gethook [ID]");
	global_string = "";
	format(global_string, 144, "[HOOK %d]: Arendators: %d", hook, GetHookArendators(biz, hook));
	SendClientMessage(playerid, -1, global_string);
	return 1;
}

callback::HookClear(playerid)
{
	RemovePlayerAttachedObject(playerid, 5);
	return 1;
}


cmd:addcont(playerid)
{
	if(!g_player_full_access[playerid]) return 1;
	new count_container = 0;
	for(new i = 0; i < MAX_CONTAINERS; i ++) if(containersInfo[i][coCheckpoint] != 0) count_container ++;
	if(count_container != 0) return SendClientMessage(playerid, -1, ""cER"Для начала игроки должны открыть уже существующие контейнеры");

	CreateContainers();
	fLogs("[admin] %s /addcont", GetName(playerid));
	return 1;
}

CreateContainers()
{
	for(new idx; idx < MAX_CONTAINERS; idx ++)
	{
		if(containersInfo[idx][coObject] != INVALID_OBJECT_ID) containersInfo[idx][coObject] = INVALID_OBJECT_ID;
		if(containersInfo[idx][coLabel] != INVALID_3DTEXT_ID) DestroyDynamic3DTextLabel(containersInfo[idx][coLabel]); containersInfo[idx][coLabel] = INVALID_3DTEXT_ID;
		if(containersInfo[idx][coCheckpoint]) DestroyPickup(containersInfo[idx][coCheckpoint]); containersInfo[idx][coCheckpoint] = 0;
		containersInfo[idx][coObject] = 	CreateDynamicObject(containersModel[idx], containersPos[idx][0], containersPos[idx][1], containersPos[idx][2], containersPos[idx][3], containersPos[idx][4], containersPos[idx][5]);

		new type = random(MAX_CONTAINERS_TYPE);
		containersInfo[idx][coType] = type;
		containersInfo[idx][coCost] = containersInfoType[type][coInfoPrice];
		containersInfo[idx][coBuyerID] = INVALID_PLAYER_ID;
		containersInfo[idx][coTime] = 60;
		containersInfo[idx][coOpen] = 0;

		global_string = "";
		format(global_string, sizeof global_string,
		""cWH"Контейнер "cMain"№%d\n\
		"cWH"Стоимость: "cMain"%d рублей\n\
		"cWH"%s: "cMain"%d секунд\n\
		"cWH"Если Вы готовы испытать удачку - подойдите к чекпоинту!",
		idx + 1, containersInfo[idx][coCost], containersInfo[idx][coBuyerID] == INVALID_PLAYER_ID ? "До удаления" : "До конца торгов", -- containersInfo[idx][coTime]);

		containersInfo[idx][coLabel] = CreateDynamic3DTextLabel(global_string, -1, containersInfo[idx][coLabelPosX], containersInfo[idx][coLabelPosY], containersInfo[idx][coLabelPosZ]-1.0, 10.0);
		containersInfo[idx][coCheckpoint] = CreatePickup(19135, 23, containersInfo[idx][coCheckpointPosX], containersInfo[idx][coCheckpointPosY], containersInfo[idx][coCheckpointPosZ], -1);
	}
	SendGlobalInf("В депо г. Южный были доставлены контейнеры! Навигатор: /gps > 1 > 9 ");
	return 1;
}

DLG(9100, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new idx = playerSelectContainer[playerid];
	if(idx == -1) return 1;

	new price = containersInfo[idx][coCost], percent = price * 10 / 100;
	if(containersInfo[idx][coBuyerID] != INVALID_PLAYER_ID) price += percent;

	new put_price;
	if(sscanf(inputtext, "d", put_price) || !(0 <= put_price <= 999999999)) return SCMF(playerid, COLOR_RED, "Цена за контейнер не может быть меньше %d рублей", price);
	if(GetPlayerRubble(playerid) < put_price) return SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно денег");
	if(put_price < price) return SendErr(playerid, "Вы поставили ставку меньше");

	if(containersInfo[idx][coBuyerID] != INVALID_PLAYER_ID)
	{
		SCMF(containersInfo[idx][coBuyerID], 0xFFCC00AA, "%s перекупил Ваш контейнер", GetName(playerid));
		playerBuyContainer[ containersInfo[idx][coBuyerID] ] = -1;
		playerSelectContainer[ containersInfo[idx][coBuyerID] ] = -1;
		SetPlayerMoney(containersInfo[idx][coBuyerID], containersInfo[idx][coCost]);
	}
	SetPlayerMoney(playerid, -put_price);
	containersInfo[idx][coCost] = put_price;
	containersInfo[idx][coBuyerID] = playerid;
	containersInfo[idx][coTime] = 60;

	SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно поставили новую цену за контейнер. В случае, если её не перебьют, Вы получите этот контейнер.");
	playerBuyContainer[playerid] = idx;
	return 1;
}

DLG(9101, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		SendClientMessage(playerid, 0xFFCC00AA, "Вы продали скин за 1.000.000 рублей");
		if(PI[playerid][pMember]) SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
		else SetPlayerSkin(playerid, PI[playerid][pModel]);
		SetPlayerMoney(playerid, 1000000);
	}
	else
	{
		SendClientMessage(playerid, 0xFFCC00AA, "Вы оставили выйгранный скин в качестве своей основной одежды.");
		PI[playerid][pModel] = PlayerContainerSkin[playerid];
		MysqlUpdatePlayerInt(playerid, "model", PI[playerid][pModel]);
	}
	return 1;
}

CMD:heal(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_HOSPITAL) return SendClientMessage(playerid, COLOR_RED, "Вы не работаете в больнице");
	if(IsPlayerInRangeOfPoint(playerid,70.0,-2525.6848,1285.5862,2023.7655))
	{
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/heal [id игрока]");
		if(playerid == params[0]) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете вылечить себя!");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_RED, "Игрока нет");
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, COLOR_RED, "Игрока нет");
		if(GetDistanceBetweenPlayers(playerid, params[0]) > 5) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");

		new Float:shealth;
		GetPlayerHealth(params[0], shealth);
		if(shealth >= 100.0) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок здоров!");
		SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_HEAL, MP1[5]);
	}
	else if(IsPlayerInAnyVehicle(playerid))
	{
		new vehid = GetPlayerVehicleID(playerid);
		if(GetVehicleModel(vehid) != 416 || GetVehicleModel(vehid) != 563)
		{
			if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/heal [id игрока]");
			if(playerid == params[0]) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете вылечить себя!");
			if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_RED, "Игрока нет");
			if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, COLOR_RED, "Игрока нет");
			if(!IsPlayerInVehicle(params[0], GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться с Вами в транспорте!");

			new Float:shealth;
			GetPlayerHealth(params[0], shealth);
			if(shealth >= 100.0) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок здоров!");
			SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_HEAL, MP1[5]);
		}
		else SendClientMessage(playerid, COLOR_GREY, "Вы должны находиться в специализированном транспорте!");
	}
	return 1;
}
ShowHistoryBan(playerid, targetid)
{
	playerHistoryBanTarget[playerid] = targetid;
	mysql_format(1, sqltext, sizeof(sqltext), "SELECT `text` FROM `historyban` WHERE `name` = '%e' LIMIT %d, %d", PI[targetid][pName], (playerHistoryBanPage[playerid] * 20), (playerHistoryBanPage[playerid] * 20) + 20);
	mysql_tquery(1, sqltext, "HistoryBanList", "i", playerid);
}
callback::HistoryBanRefresh(playerid)
{
	playerHistoryBanPage[playerid]--;
	ShowHistoryBan(playerid, playerHistoryBanTarget[playerid]);
}
callback::HistoryBanList(playerid)
{
	new rows = cache_num_rows(), page = playerHistoryBanPage[playerid];
	if(!rows)
	{
		if(page) SetTimerEx("HistoryBanRefresh", 100, 0, "i", playerid);
		return SCM(playerid, -1, "Данные не найдены");
	}
	new buffer[144];
	sqltext = ""cWH"";
	for(new i; i < rows; i++)
	{
		cache_get_field_content(i, "text", buffer);
		format(sqltext, sizeof(sqltext), "%s%s\n", sqltext, buffer);
	}
	ShowPlayerDialog(playerid, 8568, DIALOG_STYLE_MSGBOX, ""cMain"История наказаний", sqltext, "Далее", "Закрыть");
	return 1;
}
DLG(8568, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	playerHistoryBanPage[playerid]++;
	ShowHistoryBan(playerid, playerHistoryBanTarget[playerid]);
	return 1;
}
SaveHistoryBan(name[], text[])
{
	format(sqltext, sizeof(sqltext), "[%d/%d/%d | %d:%d:%d] %s", day, month, year, hour, minute, second, text);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `historyban` (`name`, `text`) VALUES ('%e', '%e')", name, sqltext);
	mysql_tquery(db_prod, STRING_GLOBAL);
}

CMD:agetip(playerid, params[])
{
	if(PI[playerid][pAdmin] < 6) return 1;
	new ip[16];
	if(sscanf(params, "s[16]", ip)) return SCM(playerid, -1, "/agetip [IP / ID]");
	fLogs("[admin] %s /agetip %s", GetName(playerid), ip);
	if(strfind(ip, ".") == -1)
	{
		new id = strval(ip);
		if(0 <= id < MAX_PLAYERS && IsPlayerConnected(id)) format(ip, 16, PI[id][pIP]);
		else { return 1; }
	}
	mysql_escape_string(ip, playerAGetIP[playerid]);
	playerAGetIPPage[playerid] = 0;
	ShowAGetIPCall(playerid);
	return 1;
}
ShowAGetIPCall(playerid)
{
	sqltext = "SELECT `name` FROM `accounts` WHERE `ip` LIKE '";
	strcat(sqltext, playerAGetIP[playerid]);
	strcat(sqltext, "%'");
	format(sqltext, sizeof(sqltext), "%s LIMIT %d, %d", sqltext, (playerAGetIPPage[playerid] * 20), (playerAGetIPPage[playerid] * 20) + 20);
	mysql_tquery(1, sqltext, "RegIPCallBack", "i", playerid);
}
callback::RegIPCallBackRefresh(playerid)
{
	playerAGetIPPage[playerid]--;
	ShowAGetIPCall(playerid);
}
callback::RegIPCallBack(playerid)
{
	new rows = cache_num_rows(), page = playerAGetIPPage[playerid];
	if(!rows)
	{
		if(page) SetTimerEx("RegIPCallBackRefresh", 100, 0, "i", playerid);
		return SCM(playerid, -1, "Данные не найдены");
	}
	new buffer[24];
	sqltext = ""cWH"";
	for(new i; i < rows; i++)
	{
		cache_get_field_content(i, "name", buffer);
		strcat(sqltext, buffer);
		strcat(sqltext, "\n");
	}
	ShowPlayerDialog(playerid, 4365, DIALOG_STYLE_MSGBOX, ""cMain"Аккаунты на этом IP", sqltext, "Далее", "Закрыть");
	return 1;
}
DLG(4365, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	playerAGetIPPage[playerid]++;
	RegIPCallBackRefresh(playerid);
	return 1;
}

CMD:obj(playerid, params[]) // edit
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston"))
	{
		if(IsPlayerFromThePhone(playerid))
		{
			SendInf(playerid, "Создавать объект можно только с ПК!");
			return 1;
		}

		SendInf(playerid, "/obj работает в тестовом режиме, после создания убедитесь что игроков с телефона не крашит.");

		ShowPlayerDialog(playerid, 8936, DIALOG_STYLE_LIST, ""cMain"Редактор", ""cWH"1. Создать объект\n2. Редактировать объекты\n3. Удалить объекты", "Выбрать", "Отмена");
		return 1;
	}

	return 1;
}
DLG(8936, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
		case 0: ShowPlayerDialog(playerid, 4908, DIALOG_STYLE_INPUT, ""cMain"Редактор", ""cWH"Укажите ID модели объекта:", "Принять", "Отмена");
		case 1: SelectObject(playerid);
		case 2: ShowPlayerDialog(playerid, 3567, DIALOG_STYLE_INPUT, ""cMain"Редактор", ""cWH"Укажите радиус удаления объектов:", "Принять", "Отмена");
	}
	return 1;
}
DLG(4908, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::obj(playerid, "");
	new model = strval(inputtext);
	if(!(3 <= strlen(inputtext) <= 5)) return ShowPlayerDialog(playerid, 4908, DIALOG_STYLE_INPUT, ""cMain"Редактор", ""cWH"Укажите ID модели объекта:", "Принять", "Отмена");

	switch(model)
	{
		case 18788..18798, 19866, 19474, 19054..19058, 19076, 19905..19911, 19593, 19881:
		{
			SendInf(playerid, "Вы пытаетесь создать крашущий объект.");
			return 1;
		}
	}

	new Float:pos_x, Float:pos_y, Float:pos_z, Float:pos_a, world = GetPlayerVirtualWorld(playerid), inter = GetPlayerInterior(playerid);
	GetPlayerPos(playerid, pos_x, pos_y, pos_z);
	GetPlayerFacingAngle(playerid, pos_a);

	SetPVarInt(playerid, "ModelID", model);

	new tmp = -1;
	for(new i; i < MAX_OBJLIMIT; i++) if(!serObjectID[i]) { tmp = i; break; }
	if(tmp == -1) return SCM(playerid, -1, "Лимит объектов исчерпан");
	playerSelectObjectSlot[playerid] = tmp;

	playerSelectObject[playerid] = serObjectID[tmp] = 	CreateDynamicObject(model, pos_x + (1.0 * floatsin(-pos_a, degrees)), pos_y + (1.0 * floatcos(-pos_a, degrees)), pos_z, 0.0, 0.0, 0.0, world, inter);
	Streamer_UpdateEx(playerid, pos_x, pos_y, pos_z, world, inter);
	EditDynamicObject(playerid, serObjectID[tmp]);

	if(!NoSaveMapping)
	{
		serObjectPosX[tmp] = pos_x + (1.0 * floatsin(-pos_a, degrees));
		serObjectPosY[tmp] = pos_y + (1.0 * floatcos(-pos_a, degrees));
		serObjectPosZ[tmp] = pos_z;
		serObjectWorld[tmp] = world;
		serObjectInter[tmp] = inter;
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `objects` (`name`, `date`, `slot`, `model`, `posx`, `posy`, `posz`, `rotx`, `roty`, `rotz`, `world`, `inter`) VALUE ('%e', '%d/%d/%d %d:%d', '%d', '%d', '%f', '%f', '%f', '0.0', '0.0', '0.0', '%d', '%d')", GetName(playerid), day, month, year, hour, minute, tmp, model, pos_x, pos_y, pos_z, world, inter);
		mysql_pquery(db_prod, STRING_GLOBAL);
	}

	fLogs("[admin] %s /obj создать %i [%f %f %f]", GetName(playerid), model, pos_x, pos_y, pos_z);
	return 1;
}
public OnPlayerSelectDynamicObject(playerid, objectid, modelid, Float:x, Float:y, Float:z)
{
	if(!g_player_full_access[playerid]) return 1;
	for(new i; i < MAX_OBJLIMIT; i++) if(serObjectID[i] == objectid)
	{
		playerSelectObjectSlot[playerid] = i;
		playerSelectObject[playerid] = objectid;
		ShowPlayerDialog(playerid, 9546, DIALOG_STYLE_LIST, ""cMain"Редактор", "1. Удалить\n2. Изменить" , "Выбрать", "Закрыть");
	}
	return 1;
}
DLG(9546, playerid, response, listitem, inputtext[])
{
	if(!response) playerSelectObject[playerid] = 0;
	else
	{
		if(listitem) EditDynamicObject(playerid, playerSelectObject[playerid]);
		else
		{
			DestroyDynamicObject(playerSelectObject[playerid]);
			serObjectID[playerSelectObjectSlot[playerid]] = 0;

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `objects` WHERE `slot` = '%d'", playerSelectObjectSlot[playerid]);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			fLogs("[admin] %s /obj удалить %i", GetName(playerid), playerSelectObjectSlot[playerid]);
			SelectObject(playerid);
			playerSelectObject[playerid] = 0;
		}
	}
	return 1;
}
DLG(3567, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::obj(playerid, "");
	new Float:dist = floatstr(inputtext);
	if(!(1.0 <= dist <= 10000.0)) return ShowPlayerDialog(playerid, 3567, DIALOG_STYLE_INPUT, ""cMain"Редактор", ""cWH"Укажите радиус удаления объектов:", "Принять", "Отмена");

	new tmp, world = GetPlayerVirtualWorld(playerid), inter = GetPlayerInterior(playerid);
	for(new i; i < MAX_OBJLIMIT; i++) if(serObjectID[i] && world == serObjectWorld[i] && inter == serObjectInter[i] && IsPlayerInRangeOfPoint(playerid, dist, serObjectPosX[i], serObjectPosY[i], serObjectPosZ[i]))
	{
		tmp++;
		DestroyDynamicObject(serObjectID[i]);
		serObjectID[i] = 0;

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `objects` WHERE `slot` = '%d'", i);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	}
	SCMF(playerid, -1, "Удалено %d объектов", tmp);
	fLogs("[admin] %s /obj удалить в %f %i", GetName(playerid), dist, tmp);
	return 1;
}

CMD:aveh(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(sscanf(params, "ddd", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WHITE, "Введите: /aveh [id машины] [цвет 1] [цвет 2]");
	if(params[0] > 611 || params[0] < 400) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] ID машины не может быть меньше 400 и больше чем 611");
	if(params[1] > 255 || params[1] < 0) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Номер цвета не может быть меньше 0 и больше 255");
	if(params[2] > 255 || params[2] < 0) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Номер цвета не может быть меньше 0 и больше 255");
	if(RestrictVehicle(params[0]) && !g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Вы пытаетесь создать запрещенное авто.");
	if(params[0] == 493) return SendClientMessage(playerid, COLOR_GREY, "моделька косячная.");

	new Float:X, Float:Y, Float:Z;
	GetPlayerPos(playerid, X, Y, Z);

	new veh_id = CreateVehicle(params[0], X + 1.5, Y, Z, 0.0, params[1], params[2], -1);
	CarDoorsEx(veh_id, 0);
	SetVehicleVirtualWorld(veh_id, GetPlayerVirtualWorld(playerid));
	LinkVehicleToInterior(veh_id, GetPlayerInterior(playerid));

	Fuel[veh_id] = 100;
	VehicleGodMode[veh_id] = 1;
	Iter_Add(adm_vehicles, veh_id);
	SetVehicleNumberPlate(veh_id, "{FF0000}ADMIN");

	format(string, sizeof(string), "[A] %s[%d] создал неуязвимый транспорт (MODEL: %s(%d) | ID: %d)", GetName(playerid), playerid, VehicleNames[params[0]-400], params[0], veh_id);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /aveh %i %i %i", GetName(playerid), params[0], params[1], params[2]);
	return 1;
}

CMD:az(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	fLogs("[admin] %s /az", GetName(playerid));
	if(GetPlayerVirtualWorld(playerid) == 54)
	{
		SpawnPlayer(playerid);
		return 1;
	}
	SetPlayerPos(playerid, 152.0, -2409.0, 33.0);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 54);
	return 1;
}

ShowFrakRangName(playerid, frakid)
{
	playerShowRangFrak[playerid] = frakid;
	stringer = ""cWH"";
	for(new i = 1; i < MAX_RANGS; i++) format(stringer, sizeof(stringer), "%s%d.%s\n", stringer, i, frakRangName[frakid][i]);
	SPD(playerid, 9565, DIALOG_STYLE_LIST, ""cMain"Ранги", stringer, "Выбрать", "Назад");
	return 1;
}
DLG(9565, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::lpanel(playerid);
	playerShowRangList[playerid] = listitem+1;
	SPD(playerid, 9566, DIALOG_STYLE_INPUT, ""cMain"Ранги", ""cWH"Введите новое название этого ранга:", "Принять", "Назад");
	return 1;
}
DLG(9566, playerid, response, listitem, inputtext[])
