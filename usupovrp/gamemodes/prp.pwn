DLG(8052, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new idx = PlayerRoomsSelect[playerid];
		if(RoomsInfo[idx][rLock] == 1)
		{
			if(strcmp(PI[playerid][pName], RoomsInfo[idx][rOwner], true) == 0) ShowPlayerDialog(playerid, 8050+6, 0, "Квартира", "Ваша квартира закрыта\n\nВы хотите её открыть?", "Да", "Нет");
			GameTextForPlayer(playerid, "~r~закрыто", 5000, 1);
		}
		else
		{
			SetPlayerPos(playerid,RoomsInfo[idx][rExitX],RoomsInfo[idx][rExitY],RoomsInfo[idx][rExitZ]);
			SetPlayerInterior(playerid,RoomsInfo[idx][rExitI]);
			SetPlayerVirtualWorld(playerid,RoomsInfo[idx][rExitV]);
			PI[playerid][pInRoom] = idx;
		}
	}
	return 1;
}
DLG(8053, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new idx = PlayerRoomsSelect[playerid];

		if(GetPlayerRooms(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира!");
		if(GetPlayerHouse(playerid) != 0) return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом!");

		new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, GetInflationPrice(RoomsInfo[idx][rCost]));
		if(PI[playerid][pCash] < price_house) return SendClientMessage(playerid, COLOR_DARKORANGE,"У вас не хватает денег для покупки квартиры.");
		SetPlayerMoney(playerid, -price_house);
		SendMes(playerid, COLOR_YELLOW, "Вы купили квартиру за %d рублей", price_house);
		SendClientMessage(playerid, COLOR_YELLOW, "Квартира оплачена на 1 день. Не забудьте оплатить квартиру в любом банке/банкомате города");

		PI[playerid][pRoom] = idx;

		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=3, room=%d WHERE id=%d", idx, PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1);

		SetPlayerPos(playerid,RoomsInfo[idx][rExitX],RoomsInfo[idx][rExitY],RoomsInfo[idx][rExitZ]);
		SetPlayerInterior(playerid,RoomsInfo[idx][rExitI]);
		RoomsInfo[idx][rOplata] = 1;
		PI[playerid][pSpawnChange] = 3;
		SetPlayerVirtualWorld(playerid,RoomsInfo[idx][rExitV]);

		RoomsInfo[idx][rOwned] = PI[playerid][pID];
		strmid(RoomsInfo[idx][rOwner],PI[playerid][pName], 0, strlen(PI[playerid][pName]), MAX_PLAYER_NAME);
		format(global_string, 150, "UPDATE `rooms` SET rOwner = '%s', `rOwned` = '%d', rOplata = 1 WHERE id = '%d' LIMIT 1", RoomsInfo[idx][rOwner], RoomsInfo[idx][rOwned], idx);
		mysql_tquery(db_prod, global_string, "", "");
	}
	return 1;
}
DLG(8054, playerid, response, listitem, inputtext[])
{
	if(!response) return true;
	new i = GetPlayerRooms(playerid);
	switch(listitem)
	{
		case 0:
		{
			if(RoomsInfo[i][rLock] == 1)
			{
				RoomsInfo[i][rLock] = 0;
				GameTextForPlayer(playerid, "~g~открыто", 5000, 5);
				format(string, 90, "%s достал ключи и открыл замок квартиры", PI[playerid][pName]);
				ProxDetector(20.0,playerid,string,COLOR_PURPLE);
				SetRoomsInt(i, "rLock", RoomsInfo[i][rLock]);
			}
			else
			{
				if(RoomsInfo[i][rLock] == 1) return SendClientMessage(playerid, -1,"Ваша квартира закрыта");
				RoomsInfo[i][rLock] = 1;
				GameTextForPlayer(playerid, "~r~закрыто", 5000, 5);
				format(string, 90, "%s достал ключи и закрыл замок квартиры", PI[playerid][pName]);
				ProxDetector(20.0,playerid,string,COLOR_PURPLE);
				SetRoomsInt(i, "rLock", RoomsInfo[i][rLock]);
			}
		}
		case 1: callcmd::rpanel(playerid);
		case 2: ShowPlayerDialog(playerid, 8050+5, 0, "Продать квартиру", "Вы хотите продать свою квартиру?", "Да", "Нет");
	}
	return 1;
}
DLG(8055, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = PI[playerid][pMainBankAccount];

		if(!IsValidBankAccount(playerid, accountid))
		return SendClientMessage(playerid, COLOR_RED, "У Вас не установлен основной банковский счёт");

		new i = GetPlayerRooms(playerid);
		strmid(RoomsInfo[i][rOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
		RoomsInfo[i][rLock] = 0;
		RoomsInfo[i][rOwned] = -1;
		RoomsInfo[i][rOplata] = 0;
		SendMes(playerid, COLOR_LIGHTRED, "Вы продали свой дом государству за %d.",RoomsInfo[i][rCost]);

		PI[playerid][pRoom] = -1;

		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=0, room=-1 WHERE id=%d", PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1);

		SetPlayerMoney(playerid, RoomsInfo[i][rCost]);
		PI[playerid][pSpawnChange] = 0;
		GameTextForPlayer(playerid, "The house sold", 3000, 5);

		format(global_string, sizeof(global_string), "UPDATE `rooms` SET  rOwner = 'None', `rOwned` = '-1', rLock = 0, rOplata = 0 WHERE id = %d LIMIT 1", i);
		mysql_tquery(db_prod, global_string, "", "");

		format(stringer1, sizeof stringer1, "+ Продажа квартиры %d рублей", RoomsInfo[i][rCost]);
		SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
		UpdateBankMoneyText(playerid, accountid);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
		mysql_tquery(db_prod, STRING_GLOBAL);

	}
	return 1;
}
DLG(8056, playerid, response, listitem, inputtext[])
{
	if(!response) return true;
	new i = GetPlayerRooms(playerid);
	RoomsInfo[i][rLock] = 0;
	GameTextForPlayer(playerid, "~g~открыто", 5000, 5);
	format(string, 90, "%s открывает замок квартиры", PI[playerid][pName]);
