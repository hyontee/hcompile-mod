			if(BlackList[params[0]][0] == 1) return SendClientMessage(playerid, COLOR_GREY, AddBlock);
			BlackList[params[0]][0] = 1;
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET black0=1 WHERE id=%d", PI[params[0]][pID]);
