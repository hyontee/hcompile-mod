						ApplyAnimation(playerid,"PED","SEAT_down",4.1,0,0,0,1,1,1);

						SendClientMessage(playerid, 0xFFCC00AA, "Вы сели за столик. Нажмите C и отпустите, чтобы начать курить, но будьте осторожны, Вам может стать плохо.");
