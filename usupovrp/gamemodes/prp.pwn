		if((Fuel[vehid] + player_fuel_count[playerid]) > 45) return SendClientMessage(playerid, COLOR_RED, "В Ваш бак не влезет столько бензина");

		if(GetPlayerRubble(playerid) < player_fuel_cost[playerid]) return SCMF(playerid, -1, "У вас не хватает денег. Нужно %d вирт", player_fuel_cost[playerid]);
		SetPlayerMoney(playerid, -player_fuel_cost[playerid]);

		if(BizzInfo[FuelBizzID[playerid]][bProduct] > 0)
		{
			BizzPay[FuelBizzID[playerid]] += player_fuel_cost[playerid];
			BizzInfo[FuelBizzID[playerid]][bMoney] += player_fuel_cost[playerid];
			BizzInfo[FuelBizzID[playerid]][bProduct] -= player_fuel_count[playerid];
			MysqlUpdateBizzInt(FuelBizzID[playerid], "product", BizzInfo[FuelBizzID[playerid]][bProduct]);
			MysqlUpdateBizzInt(FuelBizzID[playerid], "money", BizzInfo[FuelBizzID[playerid]][bMoney]);
		}
