ShowBetCar(const playerid)
{
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "ListBetCar", "i", playerid);
}

callback::ListBetCar(playerid)
{
	new rows = cache_num_rows();
	if(rows == 0) return SendClientMessage(playerid, COLOR_RED, "Ошибка: у Вас нет автомобилей");

	STRING_GLOBAL[0] = EOS;
	new car_number[64], car_model;
	for(new idx = 0; idx < rows; idx++)
	{
		DynamicInfo[playerid][CarID][idx] = cache_get_field_content_int(idx, "id");
		cache_get_field_content(idx, "c_number", car_number, db_prod, 64);
		car_model = cache_get_field_content_int(idx, "c_model");

		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cMain"%i."cWH"%s [номер: %s]\n", STRING_GLOBAL, idx + 1, VehicleNames[car_model-400], car_number);
	}
	ShowPlayerDialog(playerid, 2526, DIALOG_STYLE_LIST, ""cMain"Выберите автомобиль из списка:", STRING_GLOBAL, "Выбрать", "Отмена");
	return 0x1;
}

DLG(2526, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"Вы не участвуете в обмене");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `ownable_cars` WHERE `id` = '%d' AND `c_owner` = '%s' LIMIT 1", DynamicInfo[playerid][CarID][listitem], GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "LoadBetCar", "i", playerid);
	return 0x1;
}

callback::LoadBetCar(playerid)
{
	new rows = cache_num_rows();
	if(rows == 0) return SendClientMessage(playerid, COLOR_RED, "Произошла ошибка");

	new car_ids;
	new car_model;
	new car_number[64];

	car_ids = cache_get_field_content_int(0, "id");
	car_model = cache_get_field_content_int(0, "c_model");
	cache_get_field_content(0, "c_number", car_number, db_prod, 64);

	for(new i; i < MAX_LOAD_VEHICLE; i++)
	{
		if(PlayerVehicleSQL[playerid][i] == car_ids)
			return SendErr(playerid, "Для начала выгрузите данный автомобиль");
	}
	AddExchangeBet(playerid, BET_CAR, car_ids, car_number, car_model);
	return 0x1;
}

DLG(2521, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	switch(listitem)
	{
		case 0: ShowBetMoney(playerid);
		case 1: ShowBetCar(playerid);
		case 2:
		{
			if(GetPlayerHouse(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет недвижимости");
			AddExchangeBet(playerid, BET_HOUSE, GetPlayerHouse(playerid));
		}
		case 3:
		{
			if(GetPlayerBizz(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет бизнеса");
			AddExchangeBet(playerid, BET_BIZ, GetPlayerBizz(playerid));
		}
	}
	return 0x1;
}

EndExchange(const playerid)
{
	if(DynamicInfo[playerid][ExchangeTargetid] == INVALID_PLAYER_ID) return 0x1;

	new targetid = DynamicInfo[playerid][ExchangeTargetid];
	DeletePVar(playerid, "Exchange:Ready");
	DeletePVar(playerid, "Exchange:Confirmed");

	DeletePVar(targetid, "Exchange:Ready");
	DeletePVar(targetid, "Exchange:Confirmed");
	Delete3DTextLabel(DynamicInfo[playerid][ExchangeText] ? DynamicInfo[playerid][ExchangeText] : DynamicInfo[targetid][ExchangeText]);

	SetPlayerVirtualWorld(targetid, 0);
	SetPlayerVirtualWorld(playerid, 0);

	SendClientMessage(targetid, -1, ""cDA"Обмен завершен.");
	SendClientMessage(playerid, -1, ""cDA"Обмен завершен.");

	DynamicInfo[targetid][ExchangeTargetid] = 0xFFFF;
	DynamicInfo[playerid][ExchangeTargetid] = 0xFFFF;
	return 0x1;
}

StartExchange(const playerid, const targetid)
{
	if(DynamicInfo[playerid][ExchangeTargetid] != 0xFFFF || DynamicInfo[targetid][ExchangeTargetid] != 0xFFFF) return 0x0;

	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		gExchange[playerid][i][xType] =
		gExchange[playerid][i][xId] = INVALID_EXCHANGE;

		gExchange[targetid][i][xType] =
		gExchange[targetid][i][xId] = INVALID_EXCHANGE;

		gExchange[playerid][i][xNumber][0] = EOS;
		gExchange[targetid][i][xNumber][0] = EOS;
	}

	DeletePVar(playerid, "Exchange:Ready");
	DeletePVar(playerid, "Exchange:Confirmed");

	DeletePVar(targetid, "Exchange:Ready");
	DeletePVar(targetid, "Exchange:Confirmed");

	DynamicInfo[playerid][ExchangeTargetid] = targetid;
	DynamicInfo[targetid][ExchangeTargetid] = playerid;

	SetPlayerVirtualWorld(playerid, playerid + 10000);
	SetPlayerVirtualWorld(targetid, playerid + 10000);

	DynamicInfo[playerid][ExchangeText] = Create3DTextLabel("*", 0xCCCCCCFF, 1979.4351, 495.8600, 3323.9719, 30.0, playerid + 10000, 0);
	UpdateExchangeText(playerid);

	SendClientMessage(playerid, 0xCCCCCCFF, "Меню управления обменом: /emenu");
	SendClientMessage(targetid, 0xCCCCCCFF, "Меню управления обменом: /emenu");
	return 0x1;
}

UpdateExchangeText(const playeridEx)
{
	if(DynamicInfo[playeridEx][ExchangeTargetid] == 0xFFFF) return 0x0;

	new playerid = DynamicInfo[playeridEx][ExchangeTargetid] ? playeridEx : DynamicInfo[playeridEx][ExchangeTargetid];
	new targetid = DynamicInfo[playerid][ExchangeTargetid];

	new PlayerBuffer[(MAX_EXCHANGE + 1) * 60];
	new TargetBuffer[(MAX_EXCHANGE + 1) * 60];
	FormatExchange3DText(playerid, PlayerBuffer);
	FormatExchange3DText(targetid, TargetBuffer);

	new string_echange[(MAX_EXCHANGE + 1) * 60 * 2];
	strcat(string_echange, PlayerBuffer);
	strcat(string_echange, TargetBuffer);
	Update3DTextLabelText(DynamicInfo[playerid][ExchangeText], 0xCCCCCCFF, string_echange);
	return 0x1;
}


FormatExchange3DText(const playerid, buffer[], len = sizeof buffer)
{
	format(buffer, len, "** ВКЛАД ИГРОКА {00FF00}%s{CCCCCC} **\n", GetName(playerid));
	if(GetPVarInt(playerid, "Exchange:Ready"))
	{
		strcat(buffer, "{FFFFFF}ГОТОВ К ОБМЕНУ\n{CCCCCC}", len);
	}

	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		if(gExchange[playerid][i][xType] == INVALID_EXCHANGE) continue;
		switch(gExchange[playerid][i][xType])
		{
			case BET_RUBBLE:
			{
				format(buffer, len, "%sРубли %d\n", buffer, gExchange[playerid][i][xId]);
			}
			case BET_EURO:
			{
				format(buffer, len, "%sЕвро %d\n", buffer, gExchange[playerid][i][xId]);
			}
			case BET_CAR:
			{
				format(buffer, len, "%sАвтомобиль %s [%s{CCCCCC}]\n", buffer, VehicleNames[gExchange[playerid][i][xModel] - 400], gExchange[playerid][i][xNumber]);
			}
			case BET_HOUSE:
			{
				format(buffer, len, "%sДом №%d "cWH"|{CCCCCC} Стоимость: %d рублей\n", buffer, gExchange[playerid][i][xId], HouseInfo[gExchange[playerid][i][xId]][hPrice]);
			}
			case BET_BIZ:
			{
				format(buffer, len, "%sБизнес №%d "cWH"|{CCCCCC} Стоимость: %d рублей "cWH"|{CCCCCC} Название: %s\n", buffer, gExchange[playerid][i][xId], BizzInfo[gExchange[playerid][i][xId]][bPrice], BizzInfo[gExchange[playerid][i][xId]][bName]);
			}
		}

	}
}




ConfirmExchange(const playerid)
{
	new targetid = DynamicInfo[playerid][ExchangeTargetid];

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cWH"Вклад игрока "cMain"%s\n", GetName(playerid));

	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		if(gExchange[playerid][i][xType] == INVALID_EXCHANGE) continue;
		switch(gExchange[playerid][i][xType])
		{
			case BET_RUBBLE:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Рубли "cMain"%d\n", STRING_GLOBAL, gExchange[playerid][i][xId]);
				fLogs("[EXCHANGE] %s добавил в обмен %i рублей", GetName(playerid), gExchange[playerid][i][xId]);
			}
			case BET_EURO:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Евро "cMain"%d\n", STRING_GLOBAL, gExchange[playerid][i][xId]);
				fLogs("[EXCHANGE] %s добавил в обмен %i Евро", GetName(playerid), gExchange[playerid][i][xId]);
			}
			case BET_CAR:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Автомобиль "cMain"%s{CCCCCC} [%s{CCCCCC}]\n", STRING_GLOBAL, VehicleNames[gExchange[playerid][i][xModel] - 400], gExchange[playerid][i][xNumber]);
				fLogs("[EXCHANGE] %s добавил в обмен автомобиль: %s с номером %s", GetName(playerid), VehicleNames[gExchange[playerid][i][xModel] - 400], gExchange[playerid][i][xNumber]);
			}
			case BET_HOUSE:
			{
				if(gExchange[playerid][i][xId] != INVALID_EXCHANGE)
				{
					format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Дом "cMain"№%d "cWH"| {CCCCCC}Стоимость: "cMain"%d {CCCCCC}%s\n", STRING_GLOBAL, gExchange[playerid][i][xId], HouseInfo[gExchange[playerid][i][xId]][hPrice], HouseInfo[gExchange[playerid][i][xId]][hType] ? ("евро") : ("рублей"));
					fLogs("[EXCHANGE] %s добавил в обмен дом %i", GetName(playerid),  gExchange[playerid][i][xId]);
				}
			}
			case BET_BIZ:
			{
				if(gExchange[playerid][i][xId] != INVALID_EXCHANGE)
				{
					format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Бизнес "cMain"№%d "cWH"| {CCCCCC}Стоимость: "cMain"%d {CCCCCC}рублей "cWH"| Название: "cMain"%s\n", STRING_GLOBAL, gExchange[playerid][i][xId], BizzInfo[gExchange[playerid][i][xId]][bPrice], BizzInfo[gExchange[playerid][i][xId]][bName]);
					fLogs("[EXCHANGE] %s добавил в обмен бизнес %i", GetName(playerid),  gExchange[playerid][i][xId]);
				}
			}
		}
	}

	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cWH"Вклад игрока "cMain"%s\n", STRING_GLOBAL, GetName(targetid));
	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		if(gExchange[targetid][i][xType] == INVALID_EXCHANGE) continue;
		switch(gExchange[targetid][i][xType])
		{
			case BET_RUBBLE:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Рубли "cMain"%d\n", STRING_GLOBAL, gExchange[targetid][i][xId]);
				fLogs("[EXCHANGE] %s добавил в обмен %i рублей", GetName(targetid), gExchange[targetid][i][xId]);
			}
			case BET_EURO:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Евро "cMain"%d\n", STRING_GLOBAL, gExchange[targetid][i][xId]);

				fLogs("[EXCHANGE] %s добавил в обмен %i Евро", GetName(targetid), gExchange[targetid][i][xId]);
			}
			case BET_CAR:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Автомобиль "cMain"%s [%s"cWH"]\n", STRING_GLOBAL, VehicleNames[gExchange[targetid][i][xModel] - 400], gExchange[targetid][i][xNumber]);
				fLogs("[EXCHANGE] %s добавил в обмен автомобиль: %s с номером %s", GetName(targetid), VehicleNames[gExchange[targetid][i][xModel] - 400], gExchange[targetid][i][xNumber]);
			}
			case BET_HOUSE:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Дом "cMain"№%d "cWH"| {CCCCCC}Стоимость: "cMain"%d {CCCCCC}%s\n", STRING_GLOBAL, gExchange[targetid][i][xId], HouseInfo[gExchange[targetid][i][xId]][hPrice], HouseInfo[gExchange[targetid][i][xId]][hType] ? ("евро") : ("рублей"));
				fLogs("[EXCHANGE] %s добавил в обмен дом %i", GetName(targetid),  gExchange[targetid][i][xId]);
			}
			case BET_BIZ:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}Бизнес "cMain"№%d "cWH"| {CCCCCC}Стоимость: "cMain"%d {CCCCCC}рублей "cWH"| Название: "cMain"%s\n", STRING_GLOBAL, gExchange[targetid][i][xId], BizzInfo[gExchange[targetid][i][xId]][bPrice], BizzInfo[gExchange[targetid][i][xId]][bName]);
				fLogs("[EXCHANGE] %s добавил в обмен бизнес %i", GetName(targetid),  gExchange[targetid][i][xId]);
			}
		}
	}
	strcat(STRING_GLOBAL, "\nВы подтверждаете обмен?");
	ShowPlayerDialog(playerid, 2525, DIALOG_STYLE_MSGBOX, ""cMain"Подтверждение обмена", STRING_GLOBAL, "Да", "Нет");
	ShowPlayerDialog(targetid, 2525, DIALOG_STYLE_MSGBOX, ""cMain"Подтверждение обмена", STRING_GLOBAL, "Да", "Нет");
	return 0x1;
}

DLG(2525, playerid, response, listitem, inputtext[])
{
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"Вы не участвуете в обмене");
	if(!response)
	{
		SetPVarInt(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Ready", false);
		SetPVarInt(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Confirmed", false);
		SetPVarInt(playerid, "Exchange:Ready", false);
		UpdateExchangeText(playerid);

		SendClientMessage(DynamicInfo[playerid][ExchangeTargetid], -1, ""cER"Игрок отказался от обмена");
		SendClientMessage(playerid,  -1, ""cER"Вы отказались от обмена");
		return 0x1;
	}

	SetPVarInt(playerid, "Exchange:Confirmed", true);
	if(GetPVarInt(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Confirmed"))
	{
		Exchange(playerid);
		return 0x1;
	}

	SendClientMessage(playerid, -1, ""cDA"Ожидайте подтверждения от другого участника");
	SendClientMessage(playerid, -1, ""cDA"Вы подтвердили обмен");
	return 0x1;
}

ExchangeFailed(const playerid, const reason[])
{
	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cER"Ошибка при обмене с %s[%d]. Причина: %s", GetName(playerid), playerid, reason);
	SendClientMessage(DynamicInfo[playerid][ExchangeTargetid], 0xCCCCCCFF, STRING_GLOBAL);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cER"Ошибка при обмене с %s[%d]. Причина: %s", GetName(DynamicInfo[playerid][ExchangeTargetid]), DynamicInfo[playerid][ExchangeTargetid], reason);
	SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);

	UpdateExchangeText(playerid);

	DeletePVar(playerid, "Exchange:Ready");
	DeletePVar(playerid, "Exchange:Confirmed");

	DeletePVar(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Ready");
	DeletePVar(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Confirmed");
	return 0x0;
}

Exchange(const playerid)
{
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return 0x0;
	new targetid = DynamicInfo[playerid][ExchangeTargetid];

	new status1 = CheckPlayerExchange(playerid);
	new status2 = CheckPlayerExchange(targetid);

	if((status1 + status2) == 2)
	{
		TransferExchange(playerid, targetid);
		TransferExchange(targetid, playerid);
		EndExchange(playerid);
	}
	fLogs("[EXCHANGE] %s произвел обмен с %s", GetName(playerid), GetName(targetid));
	return 0x1;
}

CheckPlayerExchange(const playerid)
{
	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		switch(gExchange[playerid][i][xType])
		{
			case BET_CAR:
			{

				new str_query[128];
				format(str_query, sizeof(str_query), "SELECT `c_status` FROM `ownable_cars` WHERE `id` = '%d' AND `c_owner` = '%s' LIMIT 1", gExchange[playerid][i][xId], GetName(playerid));
				new Cache:result = mysql_query(db_prod, str_query);
				if(cache_num_rows() == 0)
				{
					ExchangeFailed(playerid, "Отсутствует транспорт");
					cache_delete(result);
					return 0x1;
				}

				new cid;
				cid = cache_get_field_content_int(0, "id");

				for(new z; z < MAX_LOAD_VEHICLE; z++)
				{
					if(PlayerVehicleSQL[playerid][z] == cid)
						return SendErr(playerid, "Для начала выгрузите данный автомобиль");
				}

				STRING_GLOBAL[0] = EOS;
				new targetid = DynamicInfo[playerid][ExchangeTargetid];
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(targetid));
				new Cache:results = mysql_query(db_prod, STRING_GLOBAL);
				new reason_car = cache_num_rows();
				cache_delete(results);

				if(PI[targetid][pCountCars] < (reason_car)) return ExchangeFailed(targetid, "Недостаточное количество слотов для транспорта");
			}
			case BET_EURO:
			{
				if(gExchange[playerid][i][xId] > playerEuro[playerid]) return ExchangeFailed(playerid, "Отсутствие денег");
			}
			case BET_RUBBLE:
			{
				if(gExchange[playerid][i][xId] > GetPlayerRubble(playerid)) return ExchangeFailed(playerid, "Отсутствие денег");
				if(GetPlayerLimitMoney(DynamicInfo[playerid][ExchangeTargetid], gExchange[playerid][i][xId]))
				{
					SendErr(playerid, "У игрока максимальное количество денег.");
					SendErr(DynamicInfo[playerid][ExchangeTargetid], "У Вас максимальное количество денег.");
					return 1;
				}
			}
			case BET_HOUSE:
			{
				if(GetPlayerHouse(playerid) != gExchange[playerid][i][xId]) return ExchangeFailed(playerid, "Отсутствие дома");
			}
			case BET_BIZ:
			{
				if(GetPlayerBizz(playerid) != gExchange[playerid][i][xId]) return ExchangeFailed(playerid, "Отсутствие бизнеса");
			}
		}
	}
	return 0x1;
}
TransferExchange(const playerid, const targetid) //kakaxa
{
	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		switch(gExchange[playerid][i][xType])
		{
			case BET_EURO:
			{
				TransferEuro(-1, targetid, gExchange[playerid][i][xId], "Обмен биржа");
				TransferEuro(playerid, -1, gExchange[playerid][i][xId], "Обмен биржа");
			}
			case BET_RUBBLE:
			{
				SetPlayerMoney(targetid, gExchange[playerid][i][xId]);
				SetPlayerMoney(playerid, -gExchange[playerid][i][xId]);
			}
			case BET_CAR:
			{
				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `ownable_cars` SET `c_owner` = '%s' WHERE `id` = '%d'", GetName(targetid), gExchange[playerid][i][xId]);
				mysql_tquery(db_prod, STRING_GLOBAL, "", "");

				fLogs("[cars][БИРЖА] %s +%i /setcar", GetName(targetid), gExchange[playerid][i][xModel]);
				fLogs("[cars][БИРЖА] %s -%i /setcar", GetName(playerid), gExchange[playerid][i][xModel]);
			}
			case BET_HOUSE:
			{
				if(GetPlayerHouse(targetid) != 0)
				{
					new house_id = GetPlayerHouse(targetid);
					HouseInfo[house_id][hLock] = 1;
					strmid(HouseInfo[house_id][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);

					UpdateHouse(house_id);
					PI[playerid][pHouse] = -1;
					PI[playerid][pSpawnChange] = 0;
					MysqlUpdatePlayerInt(playerid, "house", PI[playerid][pHouse]);

					STRING_GLOBAL[0] = EOS;
					mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `house` SET  `hOwner` = '%s', `hOwned` = '-1', `buyprice` = '0', `hLock` = '%d', `hOplata` = '0', `hGarage` = '0', `hAutoDoors` = '0' WHERE `id` = '%d' LIMIT 1", HouseInfo[house_id][hOwner], HouseInfo[house_id][hLock], house_id);
					mysql_tquery(db_prod, STRING_GLOBAL, "", "");
				}

				new house_id = gExchange[playerid][i][xId];
				PI[playerid][pHouse] = -1;
				PI[playerid][pSpawnChange] = 0;
				PI[targetid][pHouse] = house_id;
				HouseInfo[house_id][hOwned] = PI[targetid][pID];

				MysqlUpdatePlayerInt(targetid, "house", PI[targetid][pHouse]);
				MysqlUpdatePlayerInt(playerid, "house", PI[playerid][pHouse]);
				strmid(HouseInfo[house_id][hOwner], GetName(targetid), 0, strlen(GetName(targetid)), MAX_PLAYER_NAME);

				UpdateHouse(house_id);

				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `house` SET `hOwner` = '%s', `hOwned` = '%d', `hOplata` = '%d', `buyprice` = '%d', `hLock` = '%d' WHERE `id` = '%d' LIMIT 1", HouseInfo[house_id][hOwner], HouseInfo[house_id][hOwned], HouseInfo[house_id][hOplata], HouseInfo[house_id][hBuyPrice], HouseInfo[house_id][hLock], house_id);
				mysql_tquery(db_prod, STRING_GLOBAL, "", "");
			}
			case BET_BIZ: //kakaxa
			{
				if(GetPlayerBizz(targetid) != 0)
				{
					new bizz_id = GetPlayerBizz(targetid);
					PI[targetid][pBiz] = -1;

					BizzInfo[bizz_id][bOwned] = -1;
					BizzInfo[bizz_id][bMoney] = 0;
					BizzInfo[bizz_id][bProduct] = 0;
					BizzInfo[bizz_id][bBuyPrice] = 0;
					MysqlUpdatePlayerInt(targetid, "business", PI[targetid][pBiz]);
					strmid(BizzInfo[bizz_id][bOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);

					STRING_GLOBAL[0] = EOS;
					mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bizz` SET `owner` = 'None', `owned` = '-1', `block` = '0', `money` = '0', `penter` = '0', `till` = '50', `buyprice` = '%d', `product` = '%d', `oplata` = '0' WHERE `id` = '%d'", BizzInfo[bizz_id][bOwner], BizzInfo[bizz_id][bBuyPrice], BizzInfo[bizz_id][bProduct], bizz_id);
					mysql_tquery(db_prod, STRING_GLOBAL, "", "");
					UpdateBizz(bizz_id);
				}

				new bizz_id = gExchange[playerid][i][xId];
				PI[targetid][pBiz] = bizz_id;
				PI[playerid][pBiz] = -1;

				BizzInfo[bizz_id][bOwned] = PI[targetid][pID];
				MysqlUpdatePlayerInt(targetid, "business", PI[targetid][pBiz]);
				MysqlUpdatePlayerInt(playerid, "business", PI[playerid][pBiz]);
				strmid(BizzInfo[bizz_id][bOwner], GetName(targetid), 0, strlen(GetName(targetid)), MAX_PLAYER_NAME);
				UpdateBizz(bizz_id);

				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bizz` SET `owner` = '%s', `owned` = '%d', `buyprice` = '%d', `product` = '%d', `money` = '%d', `oplata` = '%d' WHERE `id` = '%d' LIMIT 1", BizzInfo[bizz_id][bOwner], BizzInfo[bizz_id][bOwned], BizzInfo[bizz_id][bBuyPrice], BizzInfo[bizz_id][bProduct],BizzInfo[bizz_id][bMoney], BizzInfo[bizz_id][bOplata], bizz_id);
				mysql_tquery(db_prod, STRING_GLOBAL, "", "");
			}
		}
	}
	return 0x1;
}

stock ShowNotify(playerid, text[])
{
	PlayerTextDrawSetString(playerid, info_money_PTD[playerid], text);
