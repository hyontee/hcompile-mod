cmd:gotoveh(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, ""cPS"/gotoveh [id транспорта]");
	if(!GetVehicleModel(params[0])) return SendClientMessage(playerid, -1, "Авто не существует!");
	new Float:x, Float:y, Float:z;
	GetVehiclePos(params[0], x, y, z);
	SetPlayerPos(playerid, x+2, y+2, z);
	SetPlayerVirtualWorld(playerid,GetVehicleVirtualWorld(params[0]));
	fLogs("[admin] %s /gotoveh %i [%f %f %f %i]", GetName(playerid), params[0], x, y, z, GetVehicleVirtualWorld(params[0]));
	return 1;
}
alias:gotoveh("gtv");

CMD:gotoposs(playerid, params[])
{
	new Float:p[3];
	if(PI[playerid][pAdmin] < 2 || AdminLogged[playerid] == false) return 1;
	if(sscanf(params, "fff", p[0],p[1],p[2])) return SendClientMessage(playerid, COLOR_WHITE, "• {ffcf00}[ Подсказка ] "cWH"Введите: /gotopos [x,y,z]");
	if (GetPlayerState(playerid) == 2)
	{
		new tmpcar = GetPlayerVehicleID(playerid);
		SetVehiclePos(tmpcar, p[0],p[1],p[2]);
	}
	else
	{
		SetPlayerPos(playerid,p[0],p[1],p[2]);
	}
	SendClientMessage(playerid, COLOR_ORANGE, "Вы были телепортированы");
	fLogs("[admin] %s /gotopos [%f %f %f]", GetName(playerid), p[0],p[1],p[2]);
	return 1;
}

cmd:getcar(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, ""cPS"/getcar [id транспорта]");
	if(!GetVehicleModel(params[0])) return SendClientMessage(playerid, -1, "Авто не существует!");
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	SetVehiclePos(params[0], x+2, y+2, z);
	LinkVehicleToInterior(params[0], GetPlayerInterior(playerid));
	SetVehicleVirtualWorld(params[0], GetPlayerVirtualWorld(playerid));
	if(!g_player_full_access[playerid])
	{
		format(stringer1, sizeof(stringer1), ""aAC"%s[%d] телепортировал к себе автомобиль №%d", GetName(playerid), playerid, params[0]);
		SendAdminMessage(COLOR_GREY, stringer1);
	}
	fLogs("[admin] %s /getcar %i [%f %f %f %i %i]", GetName(playerid), params[0], x, y, z, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
	return 1;
}
alias:getcar("getveh");

cmd:gethere(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/gethere [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[playerid][pAdmin] < 5 && AdminInfo[params[0]][admGethere] || g_player_full_access[params[0]] && !g_player_full_access[playerid]) return SendClientMessage(playerid, -1, ""cER"Телепорт этого администратора запрещён");
	new Float:plocx, Float:plocy, Float:plocz;
	GetPlayerPos(playerid, plocx, plocy, plocz);
	if(GetPlayerState(params[0]) == 2) SetVehiclePos(GetPlayerVehicleID(params[0]), plocx, plocy, plocz);
	else SetPlayerPos(params[0], plocx, plocy, plocz);
	SetPlayerVirtualWorld(params[0], GetPlayerVirtualWorld(playerid));
	SetPlayerInterior(params[0], GetPlayerInterior(playerid));
	if(PI[playerid][pInHouse] != -1) PI[params[0]][pInHouse] = PI[playerid][pInHouse];
	if(PI[playerid][pInGarage] != -1) PI[params[0]][pInGarage] = PI[playerid][pInGarage];

	format(string, sizeof(string), "Администратор %s[%d] телепортировал Вас к себе", GetName(playerid), playerid);
	SendClientMessage(params[0], COLOR_WHITE, string);
	if(!g_player_full_access[playerid])
	{
		format(string, sizeof(string), ""aAC"%s[%d] телепортировал игрока %s[%d] к себе", GetName(playerid), playerid, GetName(params[0]), params[0]);
		SendAdminMessage(COLOR_GREY, string);
	}
	fLogs("[admin] %s /gethere %s [%f %f %f %i %i]", GetName(playerid), GetName(params[0]), plocx, plocy, plocz, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	return 1;
}

CMD:setweather(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	extract params -> new weather; else return SendClientMessage(playerid, COLOR_WHITE, ""cPS"{9ACD32}Введите: /setweather [погода (0-20)]");

	if(!(-1 <= weather <= 20))
	{
		SendClientMessage(playerid, COLOR_BBLUE, "Погода 0 до 20 [-1 - случайно])");
		SendClientMessage(playerid, COLOR_BBLUE, "Рекомендовано: 6, 10");
		return 1;
	}
	if(weather != -1) SetWeather(weather), world_weather = weather;
	else ServerUpdateTimer_Random();

	new fmt_text[70];
	if(weather != -1) format(fmt_text, sizeof fmt_text, "Вы установили погоду %d", weather);
	else format(fmt_text, sizeof fmt_text, "Вы установили случайную погоду");
	SendClientMessage(playerid, 0xFFCC00AA, fmt_text);

	if(weather != -1) format(fmt_text, sizeof fmt_text, "[A] %s[%d] установил погоду на сервере на %d", GetName(playerid), playerid, weather);
	else format(fmt_text, sizeof fmt_text, "[A] %s[%d] установил случайную погоду на сервере", GetName(playerid), playerid);
	SendAdminMessage(0x999999FF, fmt_text);

	fLogs("[admin] %s /setweather %i", GetName(playerid), weather);
	return 1;
}

CMD:settime(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	extract params -> new time; else return SendClientMessage(playerid, COLOR_WHITE, ""cPS"{9ACD32}Введите: /settime [time 00-23]");

	if(time > 23 || time < 00) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"{9ACD32}Введите: /settime [time 00-23]");

	foreach(new i : Player) SetPlayerTime(i, time, 00);

	new fmt_text[70];
	format(fmt_text, sizeof fmt_text, "[A] %s[%d] установил время на сервере на %d", GetName(playerid), playerid, time);

	SCMF(playerid, 0xFFCC00AA, "Вы установили время на %d часов", time);
	SendAdminMessage(0x999999FF, fmt_text);

	fLogs("[admin] %s /settime %i", GetName(playerid), time);
	return 1;
}

cmd:msg(playerid, params[])
{
	if(PI[playerid][pAdmin] < 7) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SCM(playerid, -1, "Покупным  администраторам недоступна эта команда");
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/msg [текст]");
	if(IsIpFound(params[0]) || CheckString(params[0])) PlayerGetsChatBan(playerid, params[0]);

	format(string, sizeof(string), "Администратор %s: %s", GetName(playerid), params[0]);
	SendClientMessageToAll(0xFFCC00FF, string);
	fLogs("[admin] %s /msg %s", GetName(playerid), params);
	return 1;
}
cmd:chat(playerid)
{
	if(PI[playerid][pAdmin] < 11) return 1;
