callback::TopMyDMCallBack(playerid)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "ТОП геймеров не найден!");
		return 1;
	}
	mysql_tquery(1, "SELECT name, dmkills FROM accounts ORDER BY dmkills DESC LIMIT 10", "TopDMCallBack", "ii", playerid, cache_get_field_content_int(0, "dmkills"));
	return 1;
}

callback::TopDMCallBack(playerid, count)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "ТОП геймеров не найден");
		return 1;
	}
	global_string = ""cWH"";
	nformat(global_string, "%s"cMain"0. %s\t"cMain"%i"cWH"\n", global_string, GetName(playerid), count);
	nfor(i, rows)
	{
		cache_get_field_content(i, "name", stringer1, 1, 24);
		nformat(global_string, "%s%i. %s\t%i\n", global_string, (i + 1), stringer1, cache_get_field_content_int(i, "dmkills"));
	}
	ShowPlayerDialog(playerid, 0, DSL, ""cMain"TOП-10 геймеров", global_string, "Выбрать", "Закрыть");
	return 1;
}

callback::LoadFriends(playerid)
{
	new rows = cache_num_rows();
	if(rows)
	{
		new to_player_name[MAX_PLAYER_NAME],
		to_player = INVALID_PLAYER_ID;

		for(new idx; idx < rows; idx ++)
		{
			cache_get_field_content(idx, "login", to_player_name, db_prod, 24);
			if(to_player == INVALID_PLAYER_ID) sscanf(to_player_name, "u", to_player);
			else
			{
				SCMF(to_player, 0xFFCC00AA,  "Ваш друг %s [%d] зашёл на сервер", GetName(playerid), playerid);
				to_player = INVALID_PLAYER_ID;
			}
		}
	}
}

callback::LoadBankAccounts(playerid)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bank_accounts` (`owner`, `name`, `reg_time`) VALUES ('%d', 'Основной счёт', NOW())", PI[playerid][pID]);
		mysql_tquery(db_prod, STRING_GLOBAL);

		PI[playerid][pMainBankAccount] = 0;
		MysqlUpdatePlayerInt(playerid, "mainbankaccount", PI[playerid][pMainBankAccount]);

		SetTimerEx("OnPlayerLoadBank", 100, 0, "i", playerid);
	}
	else if(rows > 0 && rows <= 5)
	{
		for(new idx; idx < rows; idx ++)
		{
			SetPlayerBankAccountData(playerid, idx, B_ID, cache_get_field_content_int(idx, "id"));
			SetPlayerBankAccountData(playerid, idx, B_TYPE, cache_get_field_content_int(idx, "type"));
			SetPlayerBankAccountData(playerid, idx, B_BALANCE, cache_get_field_content_int(idx, "balance"));

			cache_get_field_content(idx, "name", g_player_bank_accounts[playerid][idx][B_NAME], db_prod, 24);
			cache_get_field_content(idx, "reg_time", g_player_bank_accounts[playerid][idx][B_REG_TIME], db_prod, 64);
		}
	}
}

callback::OnPlayerLoadBank(playerid)
{
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `bank_accounts` WHERE `owner` = '%d'", PI[playerid][pID]);
	mysql_tquery(db_prod, STRING_GLOBAL, "LoadBankAccounts", "d", playerid);
}

callback::OnPlayerLogin(playerid) //kakaxa
{
	if(Setting[playerid][1] != 1)
	{
		for(new idx; idx < 3; idx++) TextDrawHideForPlayer(playerid, log_TD[idx]);
	}
	CancelSelectTextDrawEx(playerid);
	SCM(playerid, -1, "+request2");
	PI[playerid][pID] = cache_get_field_content_int(0, "id");
	cache_get_field_content(0, "referal", PI[playerid][pReferal], db_prod, 24);
