	if(till < 1 || till > 500) return SendClientMessage(playerid, COLOR_RED, "Кол-во материалов от 1 до 500");
	new id;
	switch(PI[playerid][pMember])
	{
		case TEAM_CSKA: id = 1;
		case TEAM_SPARTAK: id = 0;
		case TEAM_RUSMAFIA: id = 3;
		case TEAM_ITALMAFIA: id = 2;
		case TEAM_ARMY: id = 4;
	}
	if(Mats[id] < till) return SendClientMessage(playerid, COLOR_RED, "На складе нет столько материалов");
	Mats[id] -= till;
	PI[playerid][pMats] += till;

	format(string, 90, "Вы взяли со склада мафии материалы (-%d)", till);
	SendClientMessage(playerid, COLOR_GREEN, string);
	if(PI[playerid][pSex] == 1) format(string, 90, "%s[%d] взял со склада мафии %d материалов", GetName(playerid), playerid, till);
	else format(string, 90, "%s[%d] взяла со склада мафии %d материалов", GetName(playerid), playerid, till);
	SendFMes(PI[playerid][pMember], COLOR_YELLOW2, string);
	return 1;
}
