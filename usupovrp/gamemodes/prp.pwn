DLG(270, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
		case 0: ShowPlayerDialog(playerid, 131+140, 2, ""cMain"Важные места",
			"1. Автовокзал\n\
			2. Остров для МП\n\
			3. Получение номеров\n\
			4. Автосалон\n\
			5. Тюрьма\n\
			6. ЗАГС\n\
			7. Перекресток\n\
			8. Анашан\n\
			9. Админ дом\n\
			10. Риелторское агентство 'Любимый город'\n\
			11. Телебашня 'Останкино'\n\
			12. Военкомат", "Телепорт", "Назад");
		case 1: ShowPlayerDialog(playerid, 131+141, 2, ""cMain"Базы организаций",
			"1. Администация\n\
			2. ФСБ\n\
			3. ГИБДД\n\
			4. Больница\n\
