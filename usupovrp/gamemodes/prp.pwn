DLG(2686, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(!IsAMafia(playerid) && PI[playerid][pMember] != TEAM_HITMAN)
		return SendClientMessage(playerid, -1, ""cER"Доступно только мафиии и хитманам");

		if(PI[playerid][pRank] < 6)
		return SendClientMessage(playerid, -1, ""cER"Данная возможность доступна с 6 ранга");

		if(PI[playerid][pCarTheft] != INVALID_VEHICLE_ID)
		return SendClientMessage(playerid, COLOR_RED, "Вы уже взяли другой заказ");

		new vehicleid = INVALID_VEHICLE_ID;
		IterateVehicle(idx)
		{
			if(!GetVehicleModel(idx) || VehicleOwner[idx] == INVALID_PLAYER_ID || SpeedVehicle(playerid) != 0 || Engine[idx] != false) continue;
			vehicleid = idx;
			break;
		}

		if(vehicleid == INVALID_VEHICLE_ID)
		return SendClientMessage(playerid, COLOR_RED, "В данный момент нет заказов");

		PI[playerid][pCarTheft] = vehicleid;
		PI[playerid][pCarTheftTime] = 600;

		new Float: X, Float: Y, Float: Z;
		GetVehiclePos(vehicleid, X, Y, Z);
		SetPlayerRaceCheckpoint(playerid, 1, X, Y, Z, 0.0,0.0,0.0, 4.0);

		global_string = "";
		format(global_string, 144, "Автомобиль %s обозначен на Вашей мини-карте. Доберитесь к нему, взломайте замок и отвезите к гаражу", VehicleNames[GetVehicleModel(vehicleid)-400]);
		SendClientMessage(playerid, 0xFFCC00AA, global_string);

		SendClientMessage(playerid, 0xFFCC00AA, "Взломать замок можно с помощью команды: /cbreak");
		SendClientMessage(playerid, 0xFFCC00AA, "На время выполнения заказа у Вас есть 10 минут");
		CarTheft[playerid] = 1;
	}
	return 1;
}
DLG(8312, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(pPressed[playerid] == 10) return 1;
