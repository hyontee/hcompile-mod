callback::CheckFullAccess(playerid, a_name[])
{
	if(cache_num_rows()) return SendClientMessage(playerid, COLOR_RED, "У данного администратора уже есть FullDostup");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `fullaccess` (`name`) values ('%e')", a_name);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	SendMes(playerid, COLOR_GREEN, "Администратору %s был выдан FullDostup", a_name);

	new id = GetPlayerID(a_name);
	if(id != INVALID_PLAYER_ID)
	{
		SendMes(id, COLOR_GREEN, "Администратор %s выдал Вам FullDostup", GetName(playerid));
		IsPlayerFullAccess(id);
	}
	return 1;
}
UpdatePlayerData(playerid, fields[], data)
{
	mysql_format(db_prod, stringer1, 144, "UPDATE `accounts` SET `%s` = '%d' WHERE `id` = '%d' LIMIT 1",fields, data, PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");
	return 1;
}
GiveBonusDay(playerid, days)
{
	switch(days)
	{
	case 1:
		{
			SetPlayerMoney(playerid, bonus_day_cash [ 0 ]);
			SendMes(playerid, -1, ""cDA"Ваш бонус сегодня: игровая валюта в размере %d руб.", bonus_day_cash [ 0 ]);
		}
	case 2:
		{
			SetPlayerMoney(playerid, bonus_day_cash [ 1 ]);
			SendMes(playerid, -1, ""cDA"Ваш бонус сегодня: игровая валюта в размере %d руб.", bonus_day_cash [ 1 ]);
		}
	case 3:
		{
			SetPlayerMoney(playerid, bonus_day_cash [ 2 ]);
			SendMes(playerid, -1, ""cDA"Ваш бонус сегодня: игровая валюта в размере %d руб.", bonus_day_cash [ 2 ]);
		}
	case 4:
		{
			SetPlayerMoney(playerid, bonus_day_cash [ 3 ]);
			SendMes(playerid, -1, ""cDA"Ваш бонус сегодня: игровая валюта в размере %d руб.", bonus_day_cash [ 3 ]);
		}
	case 5:
		{
			PI[playerid][pPerfectCoins] += bonus_day_donate [ 0 ];
			UpdatePlayerData(playerid, "credits", PI[playerid][pPerfectCoins]);
			fLogs("[coin] %s +%i ежедневный бонус", GetName(playerid), bonus_day_donate [ 0 ]);
			SendMes(playerid, -1, ""cDA"Ваш бонус сегодня: Perfect Coins в размере %d P`C", bonus_day_donate [ 0 ]);
		}
	case 6:
		{
			PI[playerid][pPerfectCoins] += bonus_day_donate [ 1 ];
			UpdatePlayerData(playerid, "credits", PI[playerid][pPerfectCoins]);
			fLogs("[coin] %s +%i ежедневный бонус", GetName(playerid), bonus_day_donate [ 1 ]);
			SendMes(playerid, -1, ""cDA"Ваш бонус сегодня: Perfect Coins в размере %d P`C", bonus_day_donate [ 1 ]);
		}
	case 7:
		{
			if(TYPE_VIP[playerid] == VIP_STATE_NONE)
			{
				PI[playerid][pVip] = VIP_STATE_SAPPHIRE;
				PI[playerid][pVipTime] = 2;
				SendClientMessage(playerid, -1, ""cDA"Вы получили 2 дня V.I.P Sapphire");
			}
			else
			{
				PI[playerid][pVipTime] += 2;
				SendClientMessage(playerid, -1, ""cDA"Ваш вип аккаунт продлен на 2 дня.");
			}
			format(stringer1, 144, "UPDATE `accounts` SET vip = '%i', vip_time = '%i' WHERE id = '%d' LIMIT 1", PI[playerid][pVip], PI[playerid][pVipTime], PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
		}
	}
	return 1;
}
SetPlayerAnimation(playerid, index, Float:fDelta = 4.1, loop = 1, lockx = 0, locky = 0, freeze = 0, time = 0, forcesync = 1)
{
	if(IsPlayerConnected(playerid))
	{
		if(index > 0 && index < 1813)
		{
			new animlib[32], animname[32];
			GetAnimationName(index, animlib, 32, animname, 32);
			ApplyAnimation(playerid, animlib, animname, fDelta, loop, lockx, locky, freeze, time, forcesync);
			return 1;
		}
	}
	return 0;
}
ShowPlayerBankAccounts(playerid, type)
{
	if(type == 0)
	{
		new count;
		STRING_GLOBAL[0] = EOS;
		for(new accountid; accountid < 5; accountid ++)
		{
			if(!IsValidBankAccount(playerid, accountid)) continue;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cWH"[%d]"cMain" %s"cWH" %d %s\n", STRING_GLOBAL, GetPlayerBankAccountData(playerid, accountid, B_ID), g_player_bank_accounts[playerid][accountid][B_NAME], GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_TYPE) ? ("евро") : ("рублей"));
			SetPlayerListitemValue(playerid, count ++, accountid);
		}
		ShowPlayerDialog(playerid, 3837, DIALOG_STYLE_LIST,""cMain"Банковские счета", STRING_GLOBAL, "Далее", "Назад");
	}
	if(type == 1)
	{
		new count;
		STRING_GLOBAL[0] = EOS;
		for(new accountid; accountid < 5; accountid ++)
		{
			if(!IsValidBankAccount(playerid, accountid)) continue;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cWH"[%d]"cMain" %s"cWH" %d %s\n", STRING_GLOBAL, GetPlayerBankAccountData(playerid, accountid, B_ID), g_player_bank_accounts[playerid][accountid][B_NAME], GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_TYPE) ? ("евро") : ("рублей"));
			SetPlayerListitemValue(playerid, count ++, accountid);
		}
		ShowPlayerDialog(playerid, 2532, DIALOG_STYLE_LIST,""cMain"Удаление банковсковского счета", STRING_GLOBAL, "Далее", "Назад");
	}
	return 1;
}
ClearPlayerBankAccountInfo(playerid, accountid)
{
	nstrmid(g_player_bank_accounts[playerid][accountid][B_NAME], "None");
	nstrmid(g_player_bank_accounts[playerid][accountid][B_REG_TIME], "None");

	SetPlayerBankAccountData(playerid, accountid, B_ID, 0);
	SetPlayerBankAccountData(playerid, accountid, B_TYPE, -1);
	SetPlayerBankAccountData(playerid, accountid, B_BALANCE, 0);
}
