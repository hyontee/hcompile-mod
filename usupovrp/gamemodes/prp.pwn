	switch index do {
		case 425: return 1;
		case 433: return 1;
		case 437: return 1;
		case 439: return 1;
		case 441: return 1;
		case 442: return 1;
		case 443: return 1;
		case 447: return 1;
		case 462: return 1;
		case 463: return 1;
		case 471: return 1;
		case 478: return 1;
		case 481: return 1;
		case 482: return 1;
		case 483: return 1;
		case 484: return 1;
		case 492: return 1;
		case 493: return 1;
		case 500: return 1;
		case 513: return 1;
		case 514: return 1;
		case 519: return 1;
		case 522: return 1;
		case 523: return 1;
		case 599: return 1;
		case 528: return 1;
		case 545: return 1;
		case 555: return 1;
		case 582: return 1;
		case 592: return 1;
		case 595: return 1;
		case 601: return 1;

	}

	return false;
}
#define or ||
CMD:plveh(playerid, params[])
{
	if(PI[playerid][pAdmin] < 7) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено создавать транспорт");
	if(sscanf(params, "iiii", params[0], params[1], params[2], params[3])) return SendClientMessage(playerid, COLOR_WHITE, "Введите: /plveh [id игрока] [id машины] [цвет 1] [цвет 2]");
	if(params[1] == 493 or params[1] == 425 or params[1] == 433) return SendClientMessage(playerid, COLOR_GREY, "моделька косячная.");
	if(params[1] > 3000 || params[1] < 400) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] ID машины не может быть меньше 400 и больше чем 3000");
	if(params[2] > 255 || params[2] < 0) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Номер цвета не может быть меньше 0 и больше 255");
	if(params[3] > 255 || params[3] < 0) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Номер цвета не может быть меньше 0 и больше 255");

	if(check_close_car(params[1])) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Данное авто невозможно создать на сервере!");


	if(RestrictVehicle(params[1]) && !g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Вы пытаетесь создать запрещенное авто.");

	new Float:X, Float:Y, Float:Z;
	GetPlayerPos(params[0], X,Y,Z);

	if(playerAdminVeh[params[0]])
	{
		DestroyVehicle(playerAdminVeh[params[0]]);
		Iter_Remove(adm_vehicles, playerAdminVeh[params[0]]);
	}
	new veh_id = playerAdminVeh[params[0]] = CreateVehicle(params[1], X + 1.5, Y, Z, 0.0, params[2], params[3], -1);
	CarDoorsEx(veh_id, 0);
	SetVehicleVirtualWorld(veh_id, GetPlayerVirtualWorld(playerid));
	LinkVehicleToInterior(veh_id, GetPlayerInterior(playerid));

	Fuel[veh_id] = 100;
	Iter_Add(adm_vehicles, veh_id);
	SetVehicleNumberPlate(veh_id, "{FF0000}ADMIN");
	PutPlayerInVehicle(params[0], veh_id, 0);

	format(string, sizeof(string), "[A] %s[%d] создал транспорт для игрока %s[%i] (MODEL: %s(%d) | ID: %d)", GetName(playerid), playerid, GetName(params[0]), params[0], VehicleNames[params[1]-400], params[1], veh_id);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /plveh %i %i %i %i", GetName(playerid), params[0], params[1], params[2], params[3]);
	return 1;
}

CMD:veh(playerid, params[])
{
	if(PI[playerid][pAdmin] < 7) return 1;
	if(AdminLogged[playerid] == false)
		return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	if(sscanf(params, "ddd", params[0], params[1], params[2]))
		return SendClientMessage(playerid, COLOR_WHITE, "Введите: /veh [id машины] [цвет 1] [цвет 2]");

	if(check_close_car(params[0])) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Данное авто невозможно создать на сервере!");
	if(params[0] > 3000 || params[0] < 400)
		return SendClientMessage(playerid, COLOR_GREY, "ID машины не может быть меньше 400 и больше чем 3000");


    if(params[1] > 256 || params[1] < 0 || params[2] > 256 || params[2] < 0)
    	return SendClientMessage(playerid, COLOR_GREY, "ID цвета транспорта может быть от 0 до 256!");

	if(RestrictVehicle(params[0]) && !g_player_full_access[playerid])
		return SendClientMessage(playerid, COLOR_GREY, "Вы пытаетесь создать запрещенное авто.");

	new Float:X, Float:Y, Float:Z;
	GetPlayerPos(playerid, X,Y,Z);

	new veh_id = CreateVehicle(params[0], X + 1.5, Y, Z, 0.0, params[1], params[2], -1);
	CarDoorsEx(veh_id, 0);
	SetVehicleVirtualWorld(veh_id, GetPlayerVirtualWorld(playerid));
	LinkVehicleToInterior(veh_id, GetPlayerInterior(playerid));

	Fuel[veh_id] = 100;
	Iter_Add(adm_vehicles, veh_id);
	SetVehicleNumberPlate(veh_id, "{FF0000}ADMIN");

	format(string, sizeof(string), "[A] %s[%d] создал транспорт (%s(%d) | ID: %d)", GetName(playerid), playerid, VehicleNames[params[0]-400], params[0], veh_id);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /veh %i %i %i", GetName(playerid), params[0], params[1], params[2]);

	PutPlayerInVehicle(playerid, veh_id, 0);

	return 1;
}

CMD:delveh(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, "Используйте: /delveh [ID автомобиля]");
	new vehh = params[0];
	if(!Iter_Contains(adm_vehicles, vehh)) return SendClientMessage(playerid, COLOR_GREY, "Этот автомобиль не создавал администратор");

	format(string, sizeof(string), "[A] %s[%d] удалил транспорт (ID: %d)", GetName(playerid), playerid, vehh);
	SendAdminMessage(COLOR_GREY, string);
	if(GetVehicleModel(vehh)) DestroyVehicle(vehh);
	Iter_Remove(adm_vehicles, vehh);
	fLogs("[admin] %s /delveh %i", GetName(playerid), params[0]);
	return 1;
}

CMD:alldelveh(playerid, params[])
{
	if(PI[playerid][pAdmin] < 10) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено удалять транспорт");
	new huiverbluda;
	foreach(new i : adm_vehicles)
	{
		if(!Iter_Contains(adm_vehicles, i)) continue;
		if(GetVehicleModel(i)) DestroyVehicle(i);
		SetTimerEx("DestroyAdmVehicles", 0, false, "i", i);
		huiverbluda++;
	}
	format(string, sizeof(string), "[A] %s[%d] удалил весь админ транспорт (%d штук)", GetName(playerid), playerid, huiverbluda);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /alldelveh", GetName(playerid));
	return 1;
}

callback::DestroyAdmVehicles(veh)
{
	Iter_Remove(adm_vehicles, veh);
	return 1;
}

cmd:vehhp(playerid)
{
	if(PI[playerid][pAdmin] < 3) return 1;
