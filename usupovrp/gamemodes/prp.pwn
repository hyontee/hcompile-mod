cmd:getpveh(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11)
		return true;

	if(sscanf(params, "i", params[0]))
		return SendInf(playerid, "/getpveh [ID игрока]");

	if(!IsPlayerConnected(params[0]))
		return SendClientMessage(playerid, -1, PlayerIsNotOnline);

	if(PlayerLogged[params[0]] == false)
		return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);

	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `c_owner` FROM `ownable_cars` WHERE c_owner = '%s'", GetName(params[0]));
	mysql_tquery(db_prod, STRING_GLOBAL, "GetPlayerCar", "ii", playerid, params[0]);
	return 1;
}

callback:: GetPlayerCar(playerid, id)
{
	new rows = cache_num_rows();
	if(!rows) return SendClientMessage(playerid, COLOR_RED, "У игрока нет автомобилей");

	new car_number[64], fmt_status[50], car_model, car_arrest, arrest_str[24], ids;
	global_string = "";
	for(new idx = 0; idx < rows; idx++)
	{
		cache_get_field_content(idx, "c_number", car_number, db_prod, 64);
		ids = cache_get_field_content_int(idx, "id");
		car_model = cache_get_field_content_int(idx, "c_model");
		car_arrest = cache_get_field_content_int(idx, "c_arrest");
		new status_car = cache_get_field_content_int(idx, "c_status");
		if(status_car == 1 && GetPlayerVehicleStatus(playerid, ids)) format(fmt_status,sizeof(fmt_status), "{41BB36}[Загружена]");
		else
		{
			format(stringer1, 170, "UPDATE `ownable_cars` SET c_status = '0' WHERE c_owner = '%s' AND id = '%d'", GetName(id), ids);
			mysql_tquery(db_prod, stringer1, "", "");
			fmt_status = "{EF3A0C}[Не загружена]";
		}
		if(car_arrest) arrest_str = " - {ff0000}Под арестом";
		else arrest_str = "";

		format(global_string, sizeof global_string, "%s{F27208}Автомобиль "cWH"%s — %s — %s%s\n", global_string, VehicleNames[car_model-400], car_number, fmt_status,arrest_str);
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_LIST, ""cMain"Автомобили игрока", global_string, "Выбрать", "Отмена");
	return true;
}
cmd:admins(playerid)
{
	if(PI[playerid][pAdmin] < 1 && TYPE_VIP[playerid] == VIP_STATE_NONE) return true;
	if(TYPE_VIP[playerid] != VIP_STATE_NONE && PI[playerid][pAdmin] == 0 && VipData[TYPE_VIP[playerid]][VipAdmin] == 0) return 0x1;

	new str[144];
	SendClientMessage(playerid, COLOR_GREEN, "Администраторы онлайн:");

	foreach(new i: Player)
	{
		if(!PlayerLogged[i] || !PI[i][pAdmin] || PI[i][pBuyAdmin]) continue;

		format(str, sizeof(str), "%s[%d] (%d lvl) [%d/3] [%s] ", GetName(i), i, PI[i][pAdmin],AdminInfo[i][admWarns],ConvertSeconds(AdminInfo[i][admTimeMin]));
		if(PI[i][Spectating][0] == INVALID_PLAYER_ID && PI[i][pAFK] >= 3)
		format(str, sizeof(str), "%s "cMain"AFK %s", str, ConvertSeconds(PI[i][pAFK]));

		if(PI[playerid][pAdmin])
		{
			if(PI[i][Spectating][0] != INVALID_PLAYER_ID && PI[i][pAFK] < 3)
			format(str, sizeof(str), "%s {FF0000}(SP|%d)", str, PI[i][Spectating][0]);

			else if(PI[i][Spectating][0] != INVALID_PLAYER_ID && PI[i][pAFK] >= 3)
			format(str, sizeof(str), "%s "cMain"AFK %s {FF0000}(SP|%d)", str, ConvertSeconds(PI[i][pAFK]), PI[i][Spectating][0]);
		}
		strcat(str, " "cMain"(Основной)");
		SendClientMessage(playerid, COLOR_WHITE, str);
	}

	foreach(new i: Player)
	{
		if(!PlayerLogged[i] || !PI[i][pAdmin] || !PI[i][pBuyAdmin]) continue;

		format(str, sizeof(str), "%s[%d] (%d lvl) [%d/3] [%s] ", GetName(i), i, PI[i][pAdmin],AdminInfo[i][admWarns],ConvertSeconds(AdminInfo[i][admTimeMin]));
		if(PI[i][Spectating][0] == INVALID_PLAYER_ID && PI[i][pAFK] >= 3)
		format(str, sizeof(str), "%s "cMain"AFK %s", str, ConvertSeconds(PI[i][pAFK]));

		if(PI[playerid][pAdmin])
		{
			if(PI[i][Spectating][0] != INVALID_PLAYER_ID && PI[i][pAFK] < 3)
			format(str, sizeof(str), "%s {FF0000}(SP|%d)", str, PI[i][Spectating][0]);

			else if(PI[i][Spectating][0] != INVALID_PLAYER_ID && PI[i][pAFK] >= 3)
			format(str, sizeof(str), "%s "cMain"AFK %s {FF0000}(SP|%d)", str, ConvertSeconds(PI[i][pAFK]), PI[i][Spectating][0]);
		}
		strcat(str, " "cWH"(Покупной)");
		SendClientMessage(playerid, COLOR_WHITE, str);
	}
	return 1;
}

AdminOnline(playerid)
{
	new page = playerPage[playerid], count, next;
	global_string = "";
	foreach(Player, otherid) if(PI[otherid][pAdmin] && PlayerLogged[otherid])
	{
		if(count >= (page * 15) 	&& count < (page * 15) + 15) next++;
		if(count >= (page - 1) * 15 && count < ((page - 1) * 15) + 15) format(global_string, 1300, "%s%s"cWH"[%d]\t%s[%d]\t%d/3\n", global_string, g_player_full_access[otherid] ? full_access_rank[otherid] : gAdminRanks[PI[otherid][pAdmin]-1],PI[otherid][pAdmin], GetName(otherid), otherid, AdminInfo[otherid][admWarns]);
		count++;
	}
	if(next) strcat(global_string, "Следующая страница\n");
	if(page > 1) strcat(global_string, "Предыдущая страница");
	stringer1 = ""cWH"Ранг | Ник | Выговоры\n";
	ShowPlayerDialog(playerid, 143, DIALOG_STYLE_LIST, stringer1, global_string, "Выбрать", "Закрыть");
}

CMD:awarn(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PI[playerid][pAdmin] < 11) return 1;
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "us[64]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, "• {66CC00}[ Подсказка ] "cWH"Введите: /awarn [id админа] [причина]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(PI[params[0]][pAdmin] == 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не является администратором!");
		AdminInfo[params[0]][admWarns]++;
		if(AdminInfo[params[0]][admWarns] >= 3)
		{
			PI[params[0]][pAdmin] --,AdminInfo[params[0]][admWarns] = 0;
			format(string, sizeof(string), "[A] %s[%d] выдал выговор 3/3 %s[%d]. Причина: %s",PI[playerid][pName],playerid,PI[params[0]][pName],params[0],params[1]);
			SendAdminMessage(COLOR_RED, string);
			switch(PI[params[0]][pAdmin])
			{
			case 0:
				{
					SendClientMessage(params[0],COLOR_WHITE,"Вы были сняты по причине 3-ёх выговоров.");
					RemoveAdmin(params[0], GetName(params[0]));
					format(string,sizeof(string),"[A] Администратор %s[%d] был снят. Причина: 3 выговора", PI[params[0]][pName],params[0]);
				}
			default: format(string,sizeof(string),"[A] Администратор %s[%d] был понижен до %d-ого уровня. Причина: 3 выговора",PI[params[0]][pName],params[0],PI[params[0]][pAdmin]);
			}
			SendAdminMessage(COLOR_RED, string);

			global_string = "";
			mysql_format(db_prod, global_string, 100, "UPDATE `admin` SET `level` = '%d' WHERE `name` = '%s' LIMIT 1", PI[params[0]][pAdmin], PI[params[0]][pName]);
			mysql_tquery(db_prod, global_string, "", "");
		}
		else
		{
			format(string, sizeof(string), "[A] %s[%d] выдал выговор %d/3 %s[%d]. Причина: %s",PI[playerid][pName],playerid,AdminInfo[params[0]][admWarns],PI[params[0]][pName],params[0],params[1]);
			SendAdminMessage(COLOR_RED, string); SendClientMessage(params[0],COLOR_WHITE,"[A] Вы получили выговор. Больше не нарушайте админ.правила!");
		}
		format(string, sizeof(string), "UPDATE `admin` SET awarn='%d' WHERE name='%s' LIMIT 1", AdminInfo[params[0]][admWarns], GetName(params[0]));
		mysql_tquery(db_prod, string, "", "");
		fLogs("[admin] %s /awarn %s %s", GetName(playerid), GetName(params[0]), params[1]);
	}
	return 1;
}

CMD:unawarn(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PI[playerid][pAdmin] < 11) return 1;
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "us[64]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, "• {66CC00}[ Подсказка ] "cWH"Введите: /unawarn [id админа] [причина]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(PI[params[0]][pAdmin] == 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не является администратором!");
		if(AdminInfo[params[0]][admWarns] == 0) return SendClientMessage(playerid,COLOR_GREY,"У администратора нет выговоров!");
		AdminInfo[params[0]][admWarns]--;

		format(string, sizeof(string), "[A] %s[%d] снял выговор %d/3 %s[%d]. Причина: %s",PI[playerid][pName],playerid,AdminInfo[params[0]][admWarns],PI[params[0]][pName],params[0],params[1]);
		SendAdminMessage(COLOR_GREY, string);

		format(string, sizeof(string), "UPDATE `admin` SET awarn='%d' WHERE name='%s' LIMIT 1", AdminInfo[params[0]][admWarns], GetName(params[0]));
		mysql_tquery(db_prod, string, "", "");
		fLogs("[admin] %s /unawarn %s %s", GetName(playerid), GetName(params[0]), params[1]);
	}
	return 1;
}

cmd:gun(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/gun [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	new strings[1000],strin[70],strs[100],gunname[32];
	new weapons[13][2];
	format(strs, 100, "Игрок:\t%s"cWH"", GetName(params[0]));
	strcat(strings, strs);
	for(new i = 0; i != 12; i ++)
	{
		GetPlayerWeaponData(params[0], i, weapons[i][0], weapons[i][1]);
		GetWeaponName(weapons[i][0],gunname,32);
		if(weapons[i][0] != 0)
		{
			format(strin,70,"\n\nОружие:\t%s (%d)\nПатроны:\t%d",gunname,weapons[i][0],weapons[i][1]);
			strcat(strings,strin);
		}
	}
	ShowPlayerDialog(playerid,0,0,""cMain"Оружие игрока",strings,"Закрыть","");
	fLogs("[admin] %s /gun %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:createactor(playerid, params[])
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted") || GetString(GetName(playerid), "Winston"))
	{
		if(sscanf(params, "ds[64]", params[0], params[1])) return SCM(playerid, -1, "/createactor SKIN NAME");

		for(new i; i < sizeof(CrashSkins); i++)
		{
			if(params[0] == CrashSkins[i])
			{
				SCMF(playerid, -1, "Skin %d crashed", params[0]);
				return 1;
			}
		}

		for(new idx = 0; idx < MAX_ACTORS_BOTS; idx++)
		{
			if(ActorsData[idx][a_ID] == 0)
			{
				ActorsData[idx][a_SKIN] = params[0];
				format(ActorsData[idx][a_NAME], 64, "%s", params[1]);
				GetPlayerPos(playerid, ActorsData[idx][a_POS][0], ActorsData[idx][a_POS][1], ActorsData[idx][a_POS][2]);
				GetPlayerFacingAngle(playerid, ActorsData[idx][a_POS][3]);
				ActorsData[idx][a_WORLD] = GetPlayerVirtualWorld(playerid);
				ActorsData[idx][a_INT] = GetPlayerInterior(playerid);
				ActorsData[idx][a_ID] = idx+1;

				ActorsData[idx][a_CREATE] = CreateDynamicActor(ActorsData[idx][a_SKIN], ActorsData[idx][a_POS][0], ActorsData[idx][a_POS][1], ActorsData[idx][a_POS][2], ActorsData[idx][a_POS][3], true, 100.0, ActorsData[idx][a_WORLD], ActorsData[idx][a_INT]);

				new actor_string[64];
				format(actor_string, sizeof(actor_string), "%s [NPC:%d]",ActorsData[idx][a_NAME], ActorsData[idx][a_ID]);
				ActorsData[idx][a_3DTEXT] = CreateDynamic3DTextLabel(actor_string, COLOR_RED, ActorsData[idx][a_POS][0], ActorsData[idx][a_POS][1], ActorsData[idx][a_POS][2]+1.2, 20.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, ActorsData[idx][a_WORLD], ActorsData[idx][a_INT]);

				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `actors` (`actor_id`, `actor_skin`, `actor_position`, `actor_name`, `actor_world`, `actor_int`) VALUES ('%d', '%d', '%f, %f, %f, %f', '%s', '%d', '%d')",
				ActorsData[idx][a_ID],
				ActorsData[idx][a_SKIN],
				ActorsData[idx][a_POS][0],
				ActorsData[idx][a_POS][1],
				ActorsData[idx][a_POS][2],
				ActorsData[idx][a_POS][3],
				ActorsData[idx][a_NAME],
				ActorsData[idx][a_WORLD],
				ActorsData[idx][a_INT]);

				mysql_tquery(db_prod, STRING_GLOBAL);
				break;
			}
		}
	}
	return 1;
}

cmd:add(playerid, params[])
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted"))
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		ShowPlayerDialog(playerid, 11, 2, ""cMain"Добавить", "1. Дом\n2. Добавить бизнес\n3. Добавить транспорт\n4. Добавить ATM\n5. Добавить гараж", "Принять", "Отмена");
	}
	return 1;
}

CMD:createpodezd(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(PI[playerid][pAdmin] < 11) return 1;
	if(sscanf(params, "ii", params[0],params[1])) return SendClientMessage(playerid, COLOR_LIGHTGREEN, "| "cWH"Введите: /createpodezd [Тип][Уровень цены]");
	if(params[0] == 0 || params[0] > 1)
	{
		SendClientMessage(playerid, -1,""cWH" 1 тип : 1 этаж");
		SendClientMessage(playerid, -1,""cWH" 2,3,4 тип : недоступно");
		return 1;
	}
	if(params[1] == 0 || params[1] > 1) return SendClientMessage(playerid, -1,""cWH" Уровни : 1. 2, 3 недоступны.");

	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);

	new type = params[0];
	new cena = params[1];
	TOTALPODEZD++;
	switch(type)
	{
	case 1: format(string,90,"2107.4250,299.9096,1399.5313,10,1");	// Инт 1 этаж
	case 2: format(string,90,"514.6105,-73.8570,1398.2188,2,2");// Инт 2 падика
	case 3: format(string,90,"468.5620,-61.4008,1408.6062,3,3");// Инт 4 этажа
	case 4: format(string,90,"363.9392,-73.1163,1411.6899,4,4");// Инт 4 этажа
	}
	sscanf(string,"p<,>fffii",
	PodezdInfo[TOTALPODEZD][poExitX],PodezdInfo[TOTALPODEZD][poExitY],PodezdInfo[TOTALPODEZD][poExitZ],
	PodezdInfo[TOTALPODEZD][poI],PodezdInfo[TOTALPODEZD][poType]);
	PodezdInfo[TOTALPODEZD][poX] = x;
	PodezdInfo[TOTALPODEZD][poY] = y;
	PodezdInfo[TOTALPODEZD][poZ] = z;
	PodezdInfo[TOTALPODEZD][poV] = TOTALPODEZD;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `podezd` (`poX`, `poY`, `poZ`, `poExitX`, `poExitY`, `poExitZ`, `poI`, `poV`, `poType`) VALUES ('%f', '%f', '%f', '%f', '%f', '%f', '%d', '%d', '%d')", PodezdInfo[TOTALPODEZD][poX], PodezdInfo[TOTALPODEZD][poY], PodezdInfo[TOTALPODEZD][poZ], PodezdInfo[TOTALPODEZD][poExitX], PodezdInfo[TOTALPODEZD][poExitY], PodezdInfo[TOTALPODEZD][poExitZ], PodezdInfo[TOTALPODEZD][poI], PodezdInfo[TOTALPODEZD][poV], PodezdInfo[TOTALPODEZD][poType]);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	CreateDynamicMapIcon(PodezdInfo[TOTALPODEZD][poX], PodezdInfo[TOTALPODEZD][poY], PodezdInfo[TOTALPODEZD][poZ], 35, 0);
	PodezdInfo[TOTALPODEZD][poPickup] = CreatePickup(19133, 1, PodezdInfo[TOTALPODEZD][poX], PodezdInfo[TOTALPODEZD][poY], PodezdInfo[TOTALPODEZD][poZ],-1);

	new podezdid = TOTALPODEZD;
	new string2[100];
	new string1[100];
	new ids = 0;
	new typepodezd = PodezdInfo[TOTALPODEZD][poType];
	new maxids;
	switch(typepodezd)
	{
	case 1: maxids = 8;
	case 2: maxids = 6;
	case 3: maxids = 7;
	case 4: maxids = 24;
	}
	while(ids < maxids)
	{
		TOTALROOMS++;
		if(typepodezd == 1)
		{
			format(string2,90,"%f,%f,%f", RoomClass1[ids][0], RoomClass1[ids][1], RoomClass1[ids][2]);
		}
		if(typepodezd == 2)
		{
			format(string2,90,"%f,%f,%f", RoomClass2[ids][0], RoomClass2[ids][1], RoomClass2[ids][2]);
		}
		if(typepodezd == 3)
		{
			format(string2,90,"%f,%f,%f", RoomClass3[ids][0], RoomClass3[ids][1], RoomClass3[ids][2]);
		}
		if(typepodezd == 4)
		{
			format(string2,90,"%f,%f,%f", RoomClass4[ids][0], RoomClass4[ids][1], RoomClass4[ids][2]);
		}
		sscanf(string2,"p<,>fff",
		RoomsInfo[TOTALROOMS][rX], RoomsInfo[TOTALROOMS][rY], RoomsInfo[TOTALROOMS][rZ]);

		switch(random(3))
		{
		case 0: format(string1, 100,"1098.2271,294.4289,1401.0000, 7, 1, 750000");
		case 1: format(string1, 100,"1098.2271,294.4289,1401.0000, 7, 2, 950000");
		case 2: format(string1, 100,"1098.2271,294.4289,1401.0000, 7, 3, 1200000");
		}

		sscanf(string1,"p<,>fffiii",
		RoomsInfo[TOTALROOMS][rExitX], RoomsInfo[TOTALROOMS][rExitY], RoomsInfo[TOTALROOMS][rExitZ], RoomsInfo[TOTALROOMS][rExitI], RoomsInfo[TOTALROOMS][rType],RoomsInfo[TOTALROOMS][rCost]);
		RoomsInfo[TOTALROOMS][rCost] = RoomsInfo[TOTALROOMS][rCost]*cena;
		RoomsInfo[TOTALROOMS][rV] = PodezdInfo[podezdid][poV];
		RoomsInfo[TOTALROOMS][rI] = PodezdInfo[podezdid][poI];
		RoomsInfo[TOTALROOMS][rExitV] = TOTALROOMS+1;
		RoomsInfo[TOTALROOMS][rOwned] = -1;
		strmid(RoomsInfo[TOTALROOMS][rOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `rooms` (`rX`, `rY`, `rZ`, `rV`, `rI`, `rExitX`, `rExitY`, `rExitZ`, `rExitV`, `rExitI`, `rType`, `rCost`) VALUES ('%f', '%f', '%f', '%d', '%d', '%f', '%f', '%f', '%d', '%d', '%d', '%d')",
		RoomsInfo[TOTALROOMS][rX], RoomsInfo[TOTALROOMS][rY], RoomsInfo[TOTALROOMS][rZ], RoomsInfo[TOTALROOMS][rV], RoomsInfo[TOTALROOMS][rI],
		RoomsInfo[TOTALROOMS][rExitX], RoomsInfo[TOTALROOMS][rExitY], RoomsInfo[TOTALROOMS][rExitZ], RoomsInfo[TOTALROOMS][rExitV], RoomsInfo[TOTALROOMS][rExitI],
		RoomsInfo[TOTALROOMS][rType], RoomsInfo[TOTALROOMS][rCost]);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
		ids++;
	}
	SendMes(playerid, COLOR_LIGHTBLUE, "Подьезд №"cMain"%d "cMain"успешно создан.", TOTALPODEZD);
	fLogs("[admin] %s /createpodezd %i %i", GetName(playerid), params[0], params[1]);
	return true;
}

cmd:changecar(playerid, params[])
{
	SendClientMessage(playerid, 0xCCCCCCFF, "Для продажи автомобиля/передачи автомобиля игроку используйте биржу обмена");
	SendClientMessage(playerid, 0xCCCCCCFF, "/gps > Основные места > Биржа обмена");
	return 1;
}

callback::CheckPlayerCares(playerid)
{
	new r = cache_num_rows();
	if(!r) return SendClientMessage(playerid, COLOR_RED, "Ошибка: у игрока нет автомобилей для обмена");
	new car_model;
	global_string = "";
	for(new idx = 0; idx < r; idx++)
	{
		car_model = cache_get_field_content_int(idx, "c_model");
		cache_get_field_content(idx, "c_number", g_player_listitem2[playerid][idx], db_prod, 64);
		format(global_string, sizeof global_string, "%s{F27208}» "cWH"Автомобиль №%d: %s\tГос. Номер: %s\n", global_string, idx+1, VehicleNames[car_model-400], g_player_listitem2[playerid][idx]);
		SetPlayerListitemValue(playerid, idx, cache_get_field_content_int(idx, "id"));
		SetPlayerListitemValue1(playerid, idx, car_model);
	}
	ShowPlayerDialog(playerid, 7734, DIALOG_STYLE_LIST, ""cMain"Выберите автомобиль игрока, на который хотите поменять:", global_string, "Выбрать", "Отмена");
	return 1;
}

cmd:changehouse(playerid, params[])
{
	if(GetPlayerHouse(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет дома!");
	if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 12) return SendClientMessage(playerid,COLOR_GREY,"Обмениваться домами можно только отыграв 12 часов (12 EXP)");
	if(sscanf(params, "ud", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/changehouse [id игрока] [доплата]");
	if(PI[params[0]][pLevel] == BONUS_LVL && PI[params[0]][pExp] < 12) return SendClientMessage(playerid,COLOR_GREY,"У предложенного игрока нету 12 отыгранных часов."),SendClientMessage(params[0],COLOR_GREY,"У вас нету 12 отыгранных часов для обмена.");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetPlayerHouse(params[0]) == 0) return SendClientMessage(playerid, -1, ""cER"У игрока нет дома!");
	if(HouseOffer[params[0]] != -1) return SendClientMessage(playerid, -1, ""cER"Этот игрок уже получил предложение об обмене");

	if(HouseInfo[GetPlayerHouse(playerid)][hRublevka] > 0)
	{
		if(params[1] < 10000000 || params[1] > 100000000) return SendClientMessage(playerid, COLOR_GREY, "Количество доплаты от 10.000.000 до 100.000.000!");
	}
	if(HouseInfo[GetPlayerHouse(params[0])][hRublevka] > 0)
	{
		if(params[1] < 10000000 || params[1] > 100000000) return SendClientMessage(playerid, COLOR_GREY, "Количество доплаты от 10.000.000 до 100.000.000!");
	}
	if(params[1] < 0 || params[1] > 3000000) return SendClientMessage(playerid, COLOR_GREY, "Количество доплаты от 1 до 3000000!");

	new i = GetPlayerHouse(playerid);
	new i2 = GetPlayerHouse(params[0]);
	if(IsPlayerInRangeOfPoint(playerid, 15.0, HouseInfo[i][hExitx], HouseInfo[i][hExity], HouseInfo[i][hExitz]) && GetPlayerVirtualWorld(playerid) == HouseInfo[i][hVirtual])
	{
		if(GetDistanceBetweenPlayers(playerid, params[0]) < 8.0)
		{
			if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете обменять дом себе!");
			new class_text[24];
			switch(HouseInfo[i][hDiscript])
			{
			case 1: class_text = "Низкий";
			case 2: class_text = "Средний";
			case 3: class_text = "Высокий";
			case 4: class_text = "Премиум";
			}
			SendMes(playerid, COLOR_LIGHTBLUE, "Вы предложили обменяться домами с %s. Твоя доплата: %d",GetName(params[0]), params[1]);
			SendMes(params[0], COLOR_LIGHTBLUE, "%s предложил обменяться домами с вами. Доплата: %d",GetName(playerid), params[1]);
			format(string, sizeof(string), "{FFFF00}%s предложил обменять свой дом\n\n\t"cWH"(Номер: %d, Класс: %s, Доплата: %d)\n{FFFF00}на ваш дом\n\t"cWH"(Номер: %d, Класс: %s)\n\n{FFFF00}Вы согласны?", GetName(playerid), i, class_text, params[1], i2, class_text);
			ShowPlayerDialog(params[0], 29+1, 0, ""cMain"Обменять дом", string, "Да", "Нет");
			format(string, sizeof(string), "{FFFF00}Вы предложили %s обменять свой дом\n\n\t"cWH"(Номер: %d, Класс: %s, Доплата: %d)\n{FFFF00}на его дом\n\t"cWH"(Номер: %d, Класс: %s)", GetName(params[0]), i, class_text, params[1], i2, class_text);
			ShowPlayerDialog(playerid, 0, 0, ""cMain"Обменять дом", string, "Закрыть", "");
			HouseOffer[params[0]] = playerid;
			HousePrice[params[0]] = params[1];
		}
		else SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться рядом с тобой!");
	}
	else SendClientMessage(playerid, -1, ""cPS"Вы должны находится внутри своего дома!");
	return 1;
}

cmd:vpc(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(AddVehicleFrac[playerid] == 0) return 1;
	if(GetPlayerState(playerid) != 2) return 1;
	if(sscanf(coordv, "p<,>iiiiii", VehInfo[TOTALVEH][vModel], VehInfo[TOTALVEH][vColor][0], VehInfo[TOTALVEH][vColor][1],VehInfo[TOTALVEH][vFraction],VehInfo[TOTALVEH][vInt],VehInfo[TOTALVEH][vWorld])) return SendClientMessage(playerid, -1, "/vpc id cars, цвет, цвет, организация , -1, 0");
	//if(!IsPlayerInVehicle(playerid, AddVehicleFrac[playerid])) return 1;
	new Float:X,Float:Y,Float:Z,Float:FA;
	GetVehicleZAngle(GetPlayerVehicleID(playerid), FA);
	GetVehiclePos(GetPlayerVehicleID(playerid), X,Y,Z);
	DestroyVehicle(AddVehicleFrac[playerid]);
	TOTALVEH++;


	format(VehInfo[TOTALVEH][vColors], 16, "%d, %d", VehInfo[TOTALVEH][vColor][0],VehInfo[TOTALVEH][vColor][1]);
	VehInfo[TOTALVEH][vPos_X] = X;
	VehInfo[TOTALVEH][vPos_Y] = Y;
	VehInfo[TOTALVEH][vPos_Z] = Z;
	VehInfo[TOTALVEH][vPos_FA] = FA;
	VehInfo[TOTALVEH][vVehicle] = CreateVehicle(VehInfo[TOTALVEH][vModel], VehInfo[TOTALVEH][vPos_X], VehInfo[TOTALVEH][vPos_Y], VehInfo[TOTALVEH][vPos_Z], VehInfo[TOTALVEH][vPos_FA],VehInfo[TOTALVEH][vColor][0],VehInfo[TOTALVEH][vColor][1], 300);
	CarDoorsEx(VehInfo[TOTALVEH][vVehicle], 0);
	LinkVehicleToInterior(VehInfo[TOTALVEH][vVehicle], VehInfo[TOTALVEH][vInt]);
	SetVehicleVirtualWorld(VehInfo[TOTALVEH][vVehicle], VehInfo[TOTALVEH][vWorld]);
	Fuel[VehInfo[TOTALVEH][vVehicle]] = 45;
	Engine[VehInfo[TOTALVEH][vVehicle]] = false;
	Lights[VehInfo[TOTALVEH][vVehicle]] = false;
	AddVehicleFrac[playerid] = INVALID_VEHICLE_ID;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `vehicle` (`id`, `model`, `x`, `y`, `z`, `fa`, `vint`, `world`, `colors`, `fraction`) VALUES ('%d', '%d', '%f', '%f', '%f', '%f', '%d', '%d', '%e', '%d')",
	TOTALVEH,VehInfo[TOTALVEH][vModel],VehInfo[TOTALVEH][vPos_X],VehInfo[TOTALVEH][vPos_Y],VehInfo[TOTALVEH][vPos_Z],VehInfo[TOTALVEH][vPos_FA],VehInfo[TOTALVEH][vInt],
	VehInfo[TOTALVEH][vWorld],VehInfo[TOTALVEH][vColors],VehInfo[TOTALVEH][vFraction]);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	SendMes(playerid, COLOR_LIME, "Транспорт номер %d создан", TOTALVEH);
	fLogs("[admin] %s /add транспорт %i %i %i [%f %f %f]", GetName(playerid), VehInfo[TOTALVEH][vFraction], VehInfo[TOTALVEH][vModel], TOTALVEH, VehInfo[TOTALVEH][vPos_X], VehInfo[TOTALVEH][vPos_Y], VehInfo[TOTALVEH][vPos_Z]);
	return 1;
}

cmd:tpc(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(add_house_rublevka[playerid])
	{
		new Float:X,Float:Y,Float:Z,Float:Angle;
		GetPlayerPos(playerid, X,Y,Z);
		GetPlayerFacingAngle(playerid,Angle);
		VehTest[playerid] = CreateVehicle(488, X,Y,Z, Angle, random(10), 0, 10000);
		CarDoorsEx(VehTest[playerid], 0);
		Fuel[VehTest[playerid]] = 40;
		PutPlayerInVehicle(playerid, VehTest[playerid], 0);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Выберите место для появления вертолета и введите еще раз /tpc");
		TPC[playerid] = true;
		add_house_rublevka[playerid] = 0;
	}
	else if(TPC[playerid] == true && !add_house_rublevka[playerid])
	{
		if(!IsPlayerInVehicle(playerid, VehTest[playerid])) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится в транспорте!");
		new Float:X,Float:Y,Float:Z,Float:FA;
		GetVehicleZAngle(VehTest[playerid], FA);
		GetVehiclePos(VehTest[playerid], X,Y,Z);
		format(coordh, sizeof(coordh), "%f, %f, %f, %f", X, Y, Z, FA);
		if(VehTest[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(VehTest[playerid]);
		VehTest[playerid] = INVALID_VEHICLE_ID;
		TPC[playerid] = false;
		SendClientMessage(playerid, COLOR_LIGHTRED, "Координаты созданы");
		ShowPlayerDialog(playerid, 11+6, DIALOG_STYLE_INPUT, ""cMain"Укажите цену:", ""cWH"Укажите цену за дом:", "Далее", "Отмена");
	}
	return 1;
}

cmd:crent(playerid)
{
	if(arendkey[playerid] == -1) return SendClientMessage(playerid, COLOR_FADE1, "Вы не арендуете транспорт.");
	new rc = arendkey[playerid];
	if(ArendInfo[rc][aPlayerID] != playerid)
	{
		SendClientMessage(playerid, COLOR_FADE1, "Вы не арендуете транспорт");
		arendkey[playerid] = -1;
		return 1;
	}
	ShowPlayerDialog(playerid, 6400, 0, ""cMain"Отмена аренды", "\n\n{FF6600}Вы действительно хотите отменить аренду транспорта?\n"cWH"Дальнейшее его использование станет недоступным,\nдо нового заключения договора на аренду транспорта.\n\n", "Принять", "Отмена");
	return 1;
}


cmd:lock(playerid, params[])
{
	if(sscanf(params,"i",params[0]))
	{
		ShowPlayerDialog(playerid, 2566, DIALOG_STYLE_MSGBOX, ""cMain"Информация", "\
		Используйте: /lock [тип]\n\n\
		1 - Личный транспорт\n\
		2 - Вертолет\n\
		3 - Личная яхта\n\
		4 - Арендованный транспорт\n\
		5 - Арендованный скутер\n\
		6 - Фракционный транспорт\n\
		7 - Семейный транспорт\n\
		8 - Доверенный транспорт", "Закрыть", "");
		return 1;
	}
	if(!(1 <= params[0] <= 8))
	{
		ShowPlayerDialog(playerid, 2566, DIALOG_STYLE_MSGBOX, ""cMain"Информация", "\
		Используйте: /lock [тип]\n\n\
		1 - Личный транспорт\n\
		2 - Вертолет\n\
		3 - Личная яхта\n\
		4 - Арендованный транспорт\n\
		5 - Арендованный скутер\n\
		6 - Фракционный транспорт\n\
		7 - Семейный транспорт\n\
		8 - Доверенный транспорт", "Закрыть", "");
		return 1;
	}
	new carid;
	if(PI[playerid][HelicopterID] != INVALID_VEHICLE_ID && params[0] == 2) carid = PI[playerid][HelicopterID];
	if(PI[playerid][YachtID] != INVALID_VEHICLE_ID && params[0] == 3) carid = PI[playerid][YachtID];

	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);

	if(GetPlayerVehicleID(playerid) != 0)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(!IsLocked[vehicleid]) PlayerTextDrawColor(playerid, speed_PTD[playerid][5], 0xFFFFFFFF);
		else PlayerTextDrawColor(playerid, speed_PTD[playerid][5], 0xFF6600FF);

		PlayerTextDrawHide(playerid, speed_PTD[playerid][5]); PlayerTextDrawShow(playerid, speed_PTD[playerid][5]);
	}

	if(params[0] == 1)
	{
		for(new i; i < MAX_LOAD_VEHICLE; i++)
		{
			if(PlayerVehicle[playerid][i] != INVALID_PLAYER_VEHICLE)
			{
				carid = PlayerVehicle[playerid][i];
				if(GetVehicleDistanceFromPoint(carid, x, y, z) > 5.0)
					continue;

				if(IsLocked[carid] == false)
				{
					C_DATA[playerid][c_lock] = 1;
					CarDoorsEx(carid, C_DATA[playerid][c_lock]);
					GameTextForPlayer(playerid, "~r~закрыто", 2000, 3);
					MeAction(playerid, "достал ключи и закрыл транспорт");
					break;
				}
				else
				{
					C_DATA[playerid][c_lock] = 0;
					CarDoorsEx(carid, C_DATA[playerid][c_lock]);
					GameTextForPlayer(playerid, "~g~открыто", 2000, 3);
					MeAction(playerid, "достал ключи и открыл транспорт");
					if(C_DATA[playerid][c_alarm]) PlayerPlaySound(playerid, 25800, 0.0, 0.0, 0.0);
					break;
				}

			}
		}
		return true;
	}
	if(params[0] == 2)
	{
		if(PI[playerid][HelicopterID] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"У вас нет активного личного вертолета");
		if(GetVehicleDistanceFromPoint(carid, x, y, z) > 5.0) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться возле вертолета");
		if(IsLocked[carid] == false)
		{
			H_DATA[playerid][h_lock] = 1;
			CarDoorsEx(carid, H_DATA[playerid][h_lock]);
			GameTextForPlayer(playerid, "~r~закрыто", 2000, 3);
			MeAction(playerid, "достал ключи и закрыл вертолет");
		}
		else
		{
			H_DATA[playerid][h_lock] = 0;
			CarDoorsEx(carid, H_DATA[playerid][h_lock]);
			GameTextForPlayer(playerid, "~g~открыто", 2000, 3);
			MeAction(playerid, "достал ключи и открыл вертолет");
		}
		return 1;
	}
	if(params[0] == 3)
	{
		if(PI[playerid][YachtID] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"У вас нет активного личной яхты");
		if(GetVehicleDistanceFromPoint(carid, x, y, z) > 5.0) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться возле своей яхты");
		if(IsLocked[carid] == false)
		{
			Y_DATA[playerid][y_lock] = 1;
			CarDoorsEx(carid, Y_DATA[playerid][y_lock]);
			GameTextForPlayer(playerid, "~r~закрыто", 2000, 3);
			MeAction(playerid, "достал ключи и закрыл яхту");
		}
		else
		{
			Y_DATA[playerid][y_lock] = 0;
			CarDoorsEx(carid, Y_DATA[playerid][y_lock]);
			GameTextForPlayer(playerid, "~g~открыто", 2000, 3);
			MeAction(playerid, "достал ключи и открыл яхту");
		}
		return 1;
	}
	if(params[0] == 4)
	{
		new rc = arendkey[playerid];
		if(rc == -1) return SendClientMessage(playerid, COLOR_GREY, "Вы не арендуете транспорт");
		if(ArendInfo[rc][aPlayerID] != playerid)
		{
			arendkey[playerid] = -1;
			return SendClientMessage(playerid, COLOR_GREY, "Вы не арендуете транспорт");
		}
		if(GetVehicleDistanceFromPoint(ArendInfo[rc][aID], x, y, z) > 5.0) return SendClientMessage(playerid, COLOR_GREY, "Вы должны находиться возле арендованного Вами транспорта!");
		if(IsLocked[ArendInfo[rc][aID]] == false)
		{
			CarDoorsEx(ArendInfo[rc][aID], 1);
			GameTextForPlayer(playerid, "~r~закрыто", 2000, 3);
			MeAction(playerid, "достал ключи и закрыл транспорт");
		}
		else
		{
			CarDoorsEx(ArendInfo[rc][aID], 0);
			GameTextForPlayer(playerid, "~g~открыто", 2000, 3);
			MeAction(playerid, "достал ключи и открыл транспорт");
		}
		return 1;
	}
	if(params[0] == 5)
	{
		new skuter = arenda_took[playerid];
		if(!skuter) return SendClientMessage(playerid, COLOR_RED, "Вы не арендуете скутер");
		if(GetVehicleDistanceFromPoint(skuter, x, y, z) > 5.0) return SendClientMessage(playerid, COLOR_RED, "Вы находитесь слишком далеко от арендованного Вами транспорта");
		if(IsLocked[skuter] == false)
		{
			CarDoorsEx(skuter, 1);
			GameTextForPlayer(playerid, "~r~закрыто", 2000, 3);
			MeAction(playerid, "достал ключи и закрыл транспорт");
		}
		else
		{
			CarDoorsEx(skuter, 0);
			GameTextForPlayer(playerid, "~g~открыто", 2000, 3);
			MeAction(playerid, "достал ключи и открыл транспорт");
		}
		return 1;
	}
	if(params[0] == 6)
	{
		for(new v = 1; v <= TOTALVEH; v++)
		{
			if(VehInfo[v][vFraction] != PI[playerid][pMember] || !GetVehicleModel(VehInfo[v][vVehicle]) || GetVehicleDistanceFromPoint(VehInfo[v][vVehicle], x, y, z) > 5.0) continue;
			if(IsLocked[VehInfo[v][vVehicle]] == false)
			{
				CarDoorsEx(VehInfo[v][vVehicle], 1);
				GameTextForPlayer(playerid, "~r~закрыто", 2000, 3);
				MeAction(playerid, "достал ключи и закрыл транспорт");
			}
			else
			{
				CarDoorsEx(VehInfo[v][vVehicle], 0);
				GameTextForPlayer(playerid, "~g~открыто", 2000, 3);
				MeAction(playerid, "достал ключи и открыл транспорт");
			}
			return 1;
		}
	}
	if(params[0] == 7)
	{
		if(!PI[playerid][pFamily]) return SendClientMessage(playerid, -1, "Вы не состоите в семье!");
		new f = PI[playerid][pFamily];
		nfor(i, 5)
		{
			new vehicleid = family_info[f][f_cars][i];
			if(!GetVehicleModel(vehicleid) || GetVehicleDistanceFromPoint(vehicleid, x, y, z) > 5.0) continue;
			if(IsLocked[vehicleid] == false)
			{
				CarDoorsEx(vehicleid, 1);
				GameTextForPlayer(playerid, "~r~закрыто", 2000, 3);
				MeAction(playerid, "достал ключи и закрыл транспорт");
			}
			else
			{
				CarDoorsEx(vehicleid, 0);
				GameTextForPlayer(playerid, "~g~открыто", 2000, 3);
				MeAction(playerid, "достал ключи и открыл транспорт");
			}
			return 1;
		}
	}
	if(params[0] == 8)
	{
		IterateVehicle(vehicleid)
		{
			if(vehTakeCarKey[vehicleid] != playerid || GetVehicleDistanceFromPoint(vehicleid, x, y, z) > 5.0) continue;
			if(IsLocked[vehicleid] == false)
			{
				CarDoorsEx(vehicleid, 1);
				GameTextForPlayer(playerid, "~r~закрыто", 2000, 3);
				MeAction(playerid, "достал ключи и закрыл транспорт");
			}
			else
			{
				CarDoorsEx(vehicleid, 0);
				GameTextForPlayer(playerid, "~g~открыто", 2000, 3);
				MeAction(playerid, "достал ключи и открыл транспорт");
			}
			return 1;
		}
	}
	SendClientMessage(playerid, -1, "Рядом нет транспорта который вы можете открыть");
	return 1;
}
cmd:yacht(playerid)
{
	global_string = "";
	mysql_format(db_prod, global_string, 128, "SELECT `y_owner` FROM `yacht` WHERE y_owner = '%s'", GetName(playerid));
	mysql_tquery(db_prod, global_string, "CheckPlayerYachts", "i", playerid);
	return 1;
}

cmd:sellcopter(playerid)
{
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится в транспорте!");
	if(GetPlayerVehicleID(playerid) != PI[playerid][HelicopterID]) return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своем вертолете");
	ShowPlayerDialog(playerid, 6477, DIALOG_STYLE_MSGBOX, ""cMain"Продажа вертолета", ""cWH"Вы действительно хотите продать свой вертолет государству за пол цены?", "Да", "Нет");
	return 1;
}

cmd:makegun(playerid)
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	if(IsAGang(playerid) || IsAMafia(playerid) && PI[playerid][pMember] != TEAM_HITMAN)
	{
		if(PI[playerid][pJail] > 0)
		return SendClientMessage(playerid, COLOR_RED, "Вы не можете создать оружие в деморгане/КПЗ");

		ShowPlayerDialog(playerid, 7443, DIALOG_STYLE_LIST, ""cMain"Выберите оружие для изготовления:", "- Пистолет 9мм {F0A338}(150 материалов)\n- Пистолет 9мм с глушителем {F0A338}(200 материалов)\n- Desert Eagle {F0A338}(200 материалов)\n- Дробовик {F0A338}(350 материалов)\n- УЗИ {F0A338}(300 материалов)\n- MP5 {F0A338}(300 материалов)\n- АК-47 {F0A338}(400 материалов)\n- М4А1 {F0A338}(450 материалов)", "Выбрать", "Отмена");
	}
	else return 1;
	return 1;
}

cmd:sellcopterid(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится в вертолете!");
	if(GetPlayerVehicleID(playerid) != PI[playerid][HelicopterID]) return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своем вертолете");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, -1, ""cPS"Используйте: /sellcopterid [ID игрока] [Цена]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете продать транспорт себе!");
	if(params[1] < 1 || params[1] > 5000000) return SendClientMessage(playerid, COLOR_GREY, "Стоимость от 1 до 5000000 руб");
	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_SELL_COPTER, params[1], GetVehicleModel(PI[playerid][HelicopterID]));
	return 1;
}
cmd:sellcar(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid))
		return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в транспорте!");

	if(!GetPlayerVehicle(playerid))
		return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своем транспорте");

	if(!IsPlayerInRangeOfPoint(playerid, 400.0, 675.8384,1007.5715,11.7961)) return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться на авторынке");
	if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 12) return SendClientMessage(playerid,COLOR_GREY,"Продавать транспорт игроку можно только отыграв 12 часов (12 EXP)");
	ShowPlayerDialog(playerid, 131+22, 0, "{ffa500}Продать транспорт", ""cWH"Вы хотите продать свой транспорт?\n\n{F04245}[Внимание] "cWH"Вам вернут только половину стоимости транспорта", "Да", "Нет");
	return 1;
}

cmd:pts(playerid, params[])
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	if(GetActivePlayerVehicleCount(playerid) == 0)
		return SendErr(playerid, "У вас нет загруженного транспорта");

	if(sscanf(params, "u", params[0]))
		return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/pts [id игрока]");
	if(!IsPlayerConnected(params[0]))
		return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false)
		return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 5.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0]))
		return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	global_string = ""cWH"";

	new
		count;

	for(new i; i < MAX_LOAD_VEHICLE; i++)
	{
		if(PlayerVehicle[playerid][i] != INVALID_PLAYER_VEHICLE)
		{
			format(global_string, sizeof(global_string), "%s"cWH"%s\n", global_string, VehicleNames[GetVehicleModel(PlayerVehicle[playerid][i])-400]);
			SetPlayerListitemValue(playerid, count, PlayerVehicleSQL[playerid][i]);
			count ++;
		}
	}

	ShowPlayerDialog(playerid, 2415, DIALOG_STYLE_LIST, !""cMain"Выберите транспорт", global_string, !"Показать", !"Закрыть");
	SetPVarInt(playerid, "pts_player", params[0]);
	return 1;
}

DLG(2415, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;
	new
		player = GetPVarInt(playerid, "pts_player"),
		id = GetPlayerListitemValue(playerid, listitem);

	if(debug_mode)
	{
		format(String144, sizeof(String144), "[debug] carid: {CCCCCC}%i "cWH"player accept: {CCCCCC}%i", id, player);
		SendClientMessage(playerid, -1, String144);
	}

	new
		query[256];

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", id);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();

	new
		model,
		number_plate[32],
		Float:mileage;
	if(rows > 0)
	{
		cache_get_field_content(0, "c_number", number_plate, db_prod, 32);
		model = cache_get_field_content_int(0, "c_model");
		mileage = cache_get_field_content_int(0, "c_mileage");
	}
	cache_delete(result);

	global_string[0] = EOS;

	format(global_string, 800, ""cWH"Владелец: {9ACD32}%s\n"cWH"Модель: "cMain"%s\n"cWH"Гос.Знак: "cMain"%s\n"cWH"Пробег: "cMain"%f", GetName(playerid), VehicleNames[model-400], number_plate, mileage);
	ShowPlayerDialog(player, 0, DIALOG_STYLE_MSGBOX, !""cMain"ПТС", global_string, !"Закрыть", "");

	format(stringer, sizeof(stringer), "показал(а) паспорт транспортного средства %s", GetName(player));
	MeAction(playerid, stringer);
	return true;
}

cmd:sp(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "В транспорте нельзя следить!");
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/sp [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[playerid][pAdmin] < 8 && AdminInfo[params[0]][admSpectate] || g_player_full_access[params[0]] && !g_player_full_access[playerid]) return SendClientMessage(playerid, -1, ""cER"Следить за этим администратором запрещено");
	new Float:xPos[4];
	GetPlayerPos(playerid, xPos[0], xPos[1], xPos[2]);
	GetPlayerFacingAngle(playerid, xPos[3]);
	if(PI[playerid][Spectating][0] == INVALID_PLAYER_ID)
	{
		SpecInt[playerid] = GetPlayerInterior(playerid);
		SpecVw[playerid] = GetPlayerVirtualWorld(playerid);

		SpecX[playerid] = xPos[0];
		SpecY[playerid] = xPos[1];
		SpecZ[playerid] = xPos[2];
		SpecA[playerid] = xPos[3];

		if(PI[playerid][pAdmin] < 11)
		{
			format(stringer1, sizeof(stringer1), ""aAC"%s[%d] начал наблюдать за %s[%d]", GetName(playerid), playerid, GetName(params[0]), params[0]);
			SendAdminMessage(COLOR_GREY, stringer1);
		}
	}
	SetPlayerInterior(playerid, GetPlayerInterior(params[0]));
	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(params[0]));
	TogglePlayerSpectating(playerid, 1);
	if(IsPlayerInAnyVehicle(params[0])) PlayerSpectateVehicle(playerid, GetPlayerVehicleID(params[0]));
	else PlayerSpectatePlayer(playerid, params[0]);
	PI[playerid][Spectating][0] = params[0];
	PI[playerid][Spectating][1] = playerid;
	if(PI[playerid][SpecTxt] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, PI[playerid][SpecTxt]), PI[playerid][SpecTxt] = PlayerText:INVALID_TEXT_DRAW;
	PI[playerid][SpecTxt] = CreatePlayerTextDraw(playerid, 496.000000, 219.625000, "Spectate");
	PlayerTextDrawBackgroundColor(playerid, PI[playerid][SpecTxt], 255);
	PlayerTextDrawFont(playerid, PI[playerid][SpecTxt], 2);
	PlayerTextDrawLetterSize(playerid, PI[playerid][SpecTxt], 0.240000, 1.271875);
	PlayerTextDrawColor(playerid, PI[playerid][SpecTxt], -1);
	PlayerTextDrawSetOutline(playerid, PI[playerid][SpecTxt], 1);
	PlayerTextDrawShow(playerid, PI[playerid][SpecTxt]);
	ShowMenuForPlayer(specmenu, playerid);

	fLogs("[admin] %s /sp %s", GetName(playerid), GetName(params[0]));
	return 1;
}
alias:sp("spec");

cmd:editobject(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 0;
	EditDynamicObject(playerid, edit_object);
	return 1;
}

cmd:spoff(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][Spectating][0] == INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, ""cER"Вы не наблюдаете за игроком!");
	if(PI[playerid][pAdmin] < 11)
	{
		format(stringer1, sizeof(stringer1), ""aAC"%s[%d] закончил наблюдение за %s[%d]", GetName(playerid), playerid, GetName(PI[playerid][Spectating][0]), PI[playerid][Spectating][0]);
		SendAdminMessage(COLOR_GREY, stringer1);
	}
	TogglePlayerSpectating(playerid, 0);
	PlayerTextDrawHide(playerid, PI[playerid][SpecTxt]);
	if(PI[playerid][SpecTxt] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, PI[playerid][SpecTxt]), PI[playerid][SpecTxt] = PlayerText:INVALID_TEXT_DRAW;
	HideMenuForPlayer(specmenu, playerid);
	fLogs("[admin] %s /spoff", GetName(playerid));
	return 1;
}
alias:spoff("specoff");

cmd:spveh(playerid, params[])
{
	if(PI[playerid][pAdmin] < 8) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено спавнить транспорт");
	new radius;
	if(sscanf(params, "d", radius)) return SendClientMessage(playerid, -1, ""cPS"Используйте: /spveh [радиус]");
	if(!(1 <= radius <= 100)) return SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Неверное значение радиуса (1-100)");
	new Float:car_x,Float:car_y,Float:car_z;
	for(new cars = 0; cars < MAX_VEHICLES; cars++)
	{
		if(GetVehicleModel(cars) > 399)
		{
			if(IsVehicleOccupiedAC(cars)) continue;
			GetVehiclePos(cars,car_x,car_y,car_z);
			if(IsPlayerInRangeOfPoint(playerid,radius,car_x,car_y,car_z))
			{
				SetVehicleToRespawn(cars);
			}
		}
	}
	format(stringer1, sizeof stringer1, "Незанятый транспорт в радиусе %dм. - заспавлен администратором %s(%d)", radius, GetName(playerid), playerid);
	SendClientMessageToAll(COLOR_LIGHTRED, stringer1);
	fLogs("[admin] %s /spveh %i", GetName(playerid), radius);
	return 1;
}

cmd:spawncars(playerid, params[])
{
	if(PI[playerid][pAdmin] < 8) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено спавнить транспорт");
	if(ServerSpawnCars != -1) return SendClientMessage(playerid, -1, ""cER"Ожидайте, кто то уже вызвал респавн транспорта");

	format(stringer1, sizeof stringer1, "Администратор %s[%d] заспавнит незанятый людьми транспорт через 15 секунд", GetName(playerid), playerid);
	SendClientMessageToAll(COLOR_LIGHTRED, stringer1);
	ServerSpawnCars = 15;
	fLogs("[admin] %s /spawncars", GetName(playerid));
	return true;
}

cmd:setmat(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "ii", params[0], params[1])) return SendClientMessage(playerid, -1, ""cPS"Введите /setmat (0-ИМ|1-РМ|2-ФК ЦСКА|3-ФК Спартак|4-В|5-Р|6-А|7-АРМИЯ) [кол-во]");
	if(params[0] < 1 || params[0] > 7) return SendClientMessage(playerid, -1, ""cPS"Введите /setmat (0-ИМ|1-РМ|2-ФК ЦСКА|3-ФК Спартак|4-В|5-Р|6-А|7-АРМИЯ) [кол-во]");
	switch(params[0])
	{
	case 0:{MafiaEd[0] += params[1]; MafiaPatr[0] += params[1];}//IM
	case 1:{MafiaEd[1] += params[1]; MafiaPatr[1] += params[1];}//PM
	case 2:{GangPatr[0] += params[1]; GangEd[0] += params[1];}//
	case 3:{GangPatr[1] += params[1]; GangEd[1] += params[1];}//
	case 4:{GangPatr[2] += params[1]; GangEd[2] += params[1];}//
	case 5:{GangPatr[3] += params[1]; GangEd[3] += params[1];}//
	case 6:{GangPatr[4] += params[1]; GangEd[4] += params[1];}//ОА
	case 7:{gArmyWarehouse[0] += params[1]; gArmyWarehouse[1] += params[1]; Mats[4] += params[1];}//Армия
	}
	WHDataUpdate();
	fLogs("[admin] %s /setmat %i %i", GetName(playerid), params[0], params[1]);
	return 1;
}

cmd:maskirovka(playerid)
{
	if(PI[playerid][pMember] != TEAM_FSB)
		return SendErr(playerid, "Доступно только ФСБ");

	if(PI[playerid][pRank] < 3)
		return SendErr(playerid, "Данная функция доступна с 3 ранга");

	new full = 0;
	for(new i = 1; i <= TOTALVEH; i++)
	{
		if(PI[playerid][pMember] == TEAM_FSB)
		{
			if(VehInfo[i][vFraction] == TEAM_FSB)
			{
				new str[90], str2[600];
				for(new z = 1; z < MAX_FRACTIONS; z++)
				{
					format(str, sizeof(str), "№%d - %s\n", z, Fraction_Name[z]);
					strcat(str2, str);
				}
				ShowPlayerDialog(playerid, 18248, 2, ""cMain"Выберите организацию:", str2, "Выбрать", "Отмена");
				full++;
				break;
			}
		}
	}
	if(full == 0) SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в служебном транспорте!");
	return 1;
}

cmd:gopolice(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/gopolice [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PoliceON[params[0]]) return SendClientMessage(playerid, COLOR_GREY, "Этот игрок не вызывал полицию либо его вызов уже приняли");
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(IsACopAndFSB(i)) SendMes(i, COLOR_YELLOW, "%s %s принял вызов %s", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), GetName(params[0]));
	}
	SendMes(params[0], COLOR_GREEN, "%s %s принял ваш вызов, ждите", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid));
	SendMes(playerid, COLOR_GREEN, "Игрок %s отмечен на карте", GetName(params[0]));
	new Float:X, Float:Y, Float:Z;
	GetPlayerPos(params[0], X, Y, Z);
	DisablePlayerRaceCheckpoint(playerid);
	SetPlayerRaceCheckpoint(playerid, 1, X, Y, Z, 0.0, 0.0, 0.0, 5);
	UseGPS[playerid] = true;
	PoliceON[params[0]] = false;
	CallPolice[params[0]] = unix + 600;
	return 1;
}

cmd:sethouseday(playerid, params[])
{
	if(!GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Eduard_Haunted")) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "ii", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"Введите /sethouseday [ID дома] [кол-во дней]");

	HouseInfo[params[0]][hOplata] =  params[1];
	SendClientMessage(playerid, COLOR_GREEN, "Количество дней в доме изменено");

	global_string = "";
	mysql_format(db_prod, global_string, 128, "UPDATE `house` SET hOplata = %d WHERE id = '%d' LIMIT 1", HouseInfo[params[0]][hOplata], params[0]);
	mysql_tquery(db_prod, global_string, "", "");

	fLogs("[admin] %s /sethouseday %i %i", GetName(playerid), params[0], params[1]);
	return 1;
}

cmd:gps(playerid, params[])
{
	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "GPS-навигатор не может установить соединение со спутником. Выйдите на улицу.");
	if(playerFind[playerid]) return SendErr(playerid, "Отключите слежку за преступником");
	if(CarTheft[playerid] > 1) return 1;

	if(UseGPS[playerid])
	{
		SendClientMessage(playerid, COLOR_RED, "Вы отменили GPS");
		DisablePlayerRaceCheckpoint(playerid);
		UseGPS[playerid] = false;

		if(PI[playerid][pSettingTD][1] == 1)
		{
			for(new i; i < 10; i++) TextDrawHideForPlayer(playerid, gps_td_global[i]);
			for(new i; i < 3; i++) PlayerTextDrawHide(playerid, gps_td_player[i][playerid]);
		}
	}
	ShowPlayerDialog(playerid, 46, DIALOG_STYLE_LIST, ""cMain"GPS", "{ffffff}1. Основные Места\n\
	2. По работе\n\
	3. Государственные Организации\n\
	4. Нелегальные Организации\n\
	5. Банки\n\
	6. Развлечения\n\
	7. Автосалоны\n\
	8. Аренда транспорта\n\
	9. Спавны новичков\n\
	11. {CCFFFF}Ближайший магазин 24/7\n\
	12. {CCFFFF}Ближайшая АЗС\n\
	13. {CCFFFF}Ближайший банкомат\n\
	14. {CCFFFF}Ближайшую СТО\n\
	15. {CCFFFF}Ближайшее казино\n\
	16. {CCFFFF}Ближайший магазин одежды\n\
	17. {CCFFFF}Ближайший оружейный магазин\n\
	18. {CCFFFF}Ближайший магазин аксессуаров\n\
	19. {CCFFFF}Найти свой дом\n\
	20. {CCFFFF}Найти свою квартиру\n\
	21. {CCFFFF}Поиск бизнеса", "Выбрать", "Отмена");
	goto_gps[playerid] = 0;
	return 1;
}

cmd:gm(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(freeze_gm[playerid] > unix) return SendClientMessage(playerid, COLOR_RED, "Пользоваться командой /gm можно раз в 60 секунд");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/gm [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(StartGMTest[playerid] == true) return SendClientMessage(playerid, -1, ""cER"Вы тестируете другого человека, подождите окончания теста!");
	if(PI[playerid][pBuyAdmin]) return SCM(playerid, -1, "Покупным  администраторам недоступна эта команда");

	new Float:gmhealth;
	GetPlayerHealth(params[0], gmhealth);
	new Float:boomx, Float:boomy, Float:boomz;
	GetPlayerPos(params[0],boomx, boomy, boomz);
	CreateExplosion(boomx, boomy, boomz+7, 5, 0.5);
	SetTimerEx("GmTest", 1000, false, "ddf", playerid, params[0], gmhealth);
	StartGMTest[playerid] = true;

	format(string, sizeof(string), "[GMTEST] %s[%d] проверил игрока %s[%d]", GetName(playerid), playerid, GetName(params[0]),params[0]);
	SendAdminMessage(COLOR_ORANGE, string);
	format(string, sizeof(string), "Администратор %s[%d] проверил Вас на GM", GetName(playerid), playerid);
	SendClientMessage(params[0], COLOR_ORANGE, string);
	freeze_gm[playerid] = unix + 60;
	fLogs("[admin] %s /gm %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:rlock(playerid)
{
	new i = GetPlayerRooms(playerid);
	if(GetPlayerRooms(playerid) == 0) return SendClientMessage(playerid, COLOR_RED, "У Вас нет квартиры");
	if(IsPlayerInRangeOfPoint(playerid, 2.0, RoomsInfo[i][rX], RoomsInfo[i][rY], RoomsInfo[i][rZ]))
	{
		if(RoomsInfo[i][rLock] == 1)
		{
			RoomsInfo[i][rLock] = 0;
			format(string, 16, "~g~открыто");
			GameTextForPlayer(playerid, string, 5000, 5);
			format(string, 90, "%s достал ключи и открыл замок квартиры", PI[playerid][pName]);
			ProxDetector(20.0,playerid,string,COLOR_PURPLE);
			SetRoomsInt(i, "rLock", RoomsInfo[i][rLock]);
		}
		else
		{
			if(RoomsInfo[i][rLock] == 1) return SendClientMessage(playerid, -1,"Ваша квартира закрыта");
			RoomsInfo[i][rLock] = 1;
			format(string, 16, "~r~закрыто");
			GameTextForPlayer(playerid, string, 5000, 5);
			format(string, 90, "%s достал ключи и закрыл замок квартиры", PI[playerid][pName]);
			ProxDetector(20.0,playerid,string,COLOR_PURPLE);
			SetRoomsInt(i, "rLock", RoomsInfo[i][rLock]);
		}
	}
	else if(IsPlayerInRangeOfPoint(playerid, 2.0, RoomsInfo[i][rExitX], RoomsInfo[i][rExitY], RoomsInfo[i][rExitZ]))
	{
		if(RoomsInfo[i][rLock] == 1)
		{
			RoomsInfo[i][rLock] = 0;
			format(string, 16, "~g~открыто");
			GameTextForPlayer(playerid, string, 5000, 5);
			format(string, 90, "%s достал ключи и открыл замок квартиры", PI[playerid][pName]);
			ProxDetector(20.0,playerid,string,COLOR_PURPLE);
			SetRoomsInt(i, "rLock", RoomsInfo[i][rLock]);
		}
		else
		{
			if(RoomsInfo[i][rLock] == 1) return SendClientMessage(playerid, -1,"Ваша квартира закрыта");
			RoomsInfo[i][rLock] = 1;
			format(string, 16, "~r~закрыто");
			GameTextForPlayer(playerid, string, 5000, 5);
			format(string, 90, "%s достал ключи и закрыл замок квартиры", PI[playerid][pName]);
			ProxDetector(20.0,playerid,string,COLOR_PURPLE);
			SetRoomsInt(i, "rLock", RoomsInfo[i][rLock]);
		}
	}

	return 1;
}

