callback::ClearAnimationsDelay(playerid) ApplyAnimation(playerid, "PED", "IDLE_chat", 4.1, 1, 0, 0, 0, 1, 1);

callback::OnPlayerHistoryName(playerid)
{
	if(cache_get_row_count(db_prod) > 0)
	{
		new idacca = cache_get_field_content_int(0, "id");
		format(string, sizeof(string), "SELECT * FROM `historyname` WHERE `idacca` = '%d' ORDER BY `id` DESC LIMIT 10", idacca);
		mysql_tquery(db_prod, string, "OnPlayerHistoryName2", "d", playerid);
