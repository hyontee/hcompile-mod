{
	if(!response) return 0;
	if(null(inputtext)) return ShowPlayerDialog(playerid, 3800+8, DIALOG_STYLE_INPUT, ""cMain"Добавление контакта", ""cWH"Введите номер контакта:", "Добавить", "Назад");
	new str[128], slot = g_player_listitem_use[playerid];
