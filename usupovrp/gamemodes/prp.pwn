DLG(2422, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;
	new
		id = GetPVarInt(playerid, "trunk_vehid"),
		query[256];

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", id);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();

	new
		patron,
		gascan,
		drugs,
		money,
		gun[3],
		repairkit,
		trunks[64];

	if(rows > 0)
	{
		cache_get_field_content(0, "c_trunk", trunks, db_prod, 64);
		sscanf(trunks, "p<,>iiiiiiii",
		patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
	}
	cache_delete(result);

	switch(listitem)
	{
		case 0:
		{
			if(patron == 1000)
				return SendErr(playerid, "В багажнике максимальное кол-во патрон");

			return ShowDialogPutPatron(playerid, patron);
		}
		case 1:
		{
			if(gascan == 3)
				return SendErr(playerid, "Нельзя больше положить канистр в багажник");

			new
				ok = SearchInventoryItem(playerid, 49);

			if(ok == 0)
				return SendClientMessage(playerid, COLOR_GREY, "У вас нет канистры, купите её на заправочной станции!");

			if(PlayerItem2[playerid][ok] == 0)
			{
				PlayerItem1[playerid][ok]= 0;
			}
			PlayerItem2[playerid][ok] --;

			gascan ++;

			SendClientMessage(playerid, COLOR_GREEN, "Вы положили в багажик канистру");

			UpDateInv(playerid);
			SaveItem(playerid,ok);

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
		case 2:
		{
			if(drugs == 1000)
				return SendErr(playerid, "В багажнике максимальное кол-во наркотиков");

			return ShowDialogPutDrugs(playerid, drugs);
		}
		case 3:
		{
			if(money == 10000000)
				return SendErr(playerid, "В багажнике максимальное кол-во денег");

			return ShowDialogPutMoney(playerid, money);
		}
		case 4:
		{
			if(gun[0])
				return SendErr(playerid, "В данном слоте уже лежит оружие");
			new
				weap = GetPlayerWeapon(playerid);

			if(!weap)
				return SendErr(playerid, "Возьмите в руки то оружие, которое хотите положить");

			if(weap != 23 && weap != 24 && weap != 25 && weap != 29 && weap != 30 && weap != 31 && weap != 33)
				return SendErr(playerid, "Нельзя положить данное оружие");

			gun[0] = weap;

			RemovePlayerWeapon(playerid, weap);

			SendMes(playerid, COLOR_GREEN, "Вы положили в багажник '%s'", GunNames[gun[0]]);

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
		case 5:
		{
			if(gun[1])
				return SendErr(playerid, "В данном слоте уже лежит оружие");
			new
				weap = GetPlayerWeapon(playerid);

			if(!weap)
				return SendErr(playerid, "Возьмите в руки то оружие, которое хотите положить");

			if(weap != 23 && weap != 24 && weap != 25 && weap != 29 && weap != 30 && weap != 31 && weap != 33)
				return SendErr(playerid, "Нельзя положить данное оружие");

			gun[1] = weap;

			RemovePlayerWeapon(playerid, weap);

			SendMes(playerid, COLOR_GREEN, "Вы положили в багажник '%s'", GunNames[gun[1]]);

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
		case 6:
		{
			if(gun[2])
				return SendErr(playerid, "В данном слоте уже лежит оружие");
			new
				weap = GetPlayerWeapon(playerid);

			if(!weap)
				return SendErr(playerid, "Возьмите в руки то оружие, которое хотите положить");

			if(weap != 23 && weap != 24 && weap != 25 && weap != 29 && weap != 30 && weap != 31 && weap != 33)
				return SendErr(playerid, "Нельзя положить данное оружие");

			gun[2] = weap;

			RemovePlayerWeapon(playerid, weap);

			SendMes(playerid, COLOR_GREEN, "Вы положили в багажник '%s'", GunNames[gun[2]]);

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
		case 7:
		{
			if(repairkit == 2)
				return SendErr(playerid, "В багажнике максимальное кол-во рем. коплектов");

			new ok = SearchInventoryItem(playerid, 48);
			if(ok==0)
				return SendErr(playerid, "У вас нет набора инструментов!");

			PlayerItem2[playerid][ok]--;
			UpDateInv(playerid);
			SaveItem(playerid,ok);
			SendSucc(playerid, "Вы положили в багажник рем. коплект");
			repairkit ++;

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
	}
	return true;
}

DLG(2418, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;
	new
		id = GetPVarInt(playerid, "trunk_vehid"),
		query[256];

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", id);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();

	new
		patron,
		gascan,
		drugs,
		money,
		gun[3],
		repairkit,
		trunks[64];

	if(rows > 0)
	{
		cache_get_field_content(0, "c_trunk", trunks, db_prod, 64);
		sscanf(trunks, "p<,>iiiiiiii",
		patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
	}
	cache_delete(result);

	switch(listitem)
	{
		case 0:
		{
			if(!patron)
				return SendErr(playerid, "Патроны отсутствуют в багажнике");

			return ShowDialogTakePatron(playerid, patron);
		}
		case 1:
		{
			if(!gascan)
				return SendErr(playerid, "Канистра отсутствует в багажнике");

			new newslot;
			if(CheckMaxVes(playerid,49,1,newslot)==1)
				return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");

			PlayerItem1[playerid][newslot]= 49;
			PlayerItem2[playerid][newslot] += 1;
			gascan -= 1;
			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника %i канистру", 1);
			SaveItem(playerid,newslot);

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
		case 2:
		{
			if(!drugs)
				return SendErr(playerid, "Наркотики отсутствуют в багажнике");

			return ShowDialogTakeDrugs(playerid, drugs);
		}
		case 3:
		{
			if(!money)
				return SendErr(playerid, "Деньги отсутствуют в багажнике");

			return ShowDialogTakeMoney(playerid, money);
		}
		case 4:
		{
			if(!gun[0])
				return SendErr(playerid, "В данном слоте нет оружия");

			GivePlayerWeapon(playerid, gun[0], 1);

			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника '%s'", GunNames[gun[0]]);

			gun[0] = 0;

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
		case 5:
		{
			if(!gun[1])
				return SendErr(playerid, "В данном слоте нет оружия");

			GivePlayerWeapon(playerid, gun[1], 1);

			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника '%s'", GunNames[gun[1]]);

			gun[1] = 0;

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
		case 6:
		{
			if(!gun[2])
				return SendErr(playerid, "В данном слоте нет оружия");

			GivePlayerWeapon(playerid, gun[2], 1);

			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника '%s'", GunNames[gun[2]]);

			gun[2] = 0;

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
		case 7:
		{
			if(!repairkit)
				return SendErr(playerid, "В багажнике нет рем. коплекта");


			new newslot;

			if(CheckMaxVes(playerid,48,1,newslot)==1)
				return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");

			PlayerItem1[playerid][newslot]=48;
			PlayerItem2[playerid][newslot]+=1;
			SaveItem(playerid,newslot);

			SendSucc(playerid, "Вы взяли из багажника ремонтный комплект");

			repairkit --;

			stringer1[0] = EOS;

			new
				trunker[64];

			format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
			format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			return true;
		}
	}
	return true;
}

