				{
					if(PI[playerid][pMember] == TEAM_RUSMAFIA && b_Sklad{6} || PI[playerid][pRank] < UseStockRang[ GetSkladID(PI[playerid][pMember]) ]) return SendClientMessage(playerid, -1, ""cER"Доступ к складу вашей мафии закрыт!");
					ShowPlayerDialog(playerid, 4200, 2, ""cMain"Склад мафии", "{63BD4E}Положить патроны\n{63BD4E}Положить деньги\n{63BD4E}Положить наркотики\n{63BD4E}Положить материалы\n"cWH"Взять патроны\nВзять деньги\nВзять наркотики\nВзять материалы", "Принять", "Отмена");
				}
				return 1;
			}
			if(PlayerToPoint(2.0, playerid, -2102.4185,296.9484,1397.0883) && GetPlayerVirtualWorld(playerid) == 1)
