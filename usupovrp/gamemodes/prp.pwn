new_DestroyVehicle(vehid)
{
	NullVehicle(vehid);
	DestroyVehicle(vehid);
}
#if defined _ALS_DestroyVehicle
#undef DestroyVehicle
#else
#define	_ALS_DestroyVehicle
#endif
#define DestroyVehicle new_DestroyVehicle

NullVehicle(vehid, type = 0)
{
	if(VehicleLabel[vehid] != INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(VehicleLabel[vehid]);
		VehicleLabel[vehid] = INVALID_3DTEXT_ID;
	}
	if(gFamily3DTextVehicle[vehid] != INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(gFamily3DTextVehicle[vehid]);
		gFamily3DTextVehicle[vehid] = INVALID_3DTEXT_ID;
		VehicleFamilyCars[vehid] = -1;
	}
	if(vBoomBoxArea[vehid])
	{
		IteratePlayer(otherid) if(IsPlayerInDynamicArea(otherid, vBoomBoxArea[vehid])) { StopAudioStreamForPlayer(otherid); }
		DestroyDynamicArea(vBoomBoxArea[vehid]);
		vBoomBoxStati[vehid] = "";
		vBoomBoxArea[vehid] = 0;
	}
	CarDoorsEx(vehid, 0);
	SetVehicleNumberPlate(vehid, "KING");
	SetVehicleParamsEx(vehid, false, false, false, false, false, false, false);

	Engine[vehid] =
	Lights[vehid] = false;
	Fuel[vehid] = 45;
	vehicle_mileage[vehid] = 0.0;
	RadioVeh[vehid] = 0;
	VehicleGodMode[vehid] = 0;
	//VehicleFamily[vehid] = -1;
	materials_text[vehid] = INVALID_3DTEXT_ID;
	VehicleOwner[vehid] = INVALID_PLAYER_ID;
	if(!type) vehTakeCarKey[vehid] = -1;
}
Float:GetDistanceBetweenPlayers(i,t)
{
	new Float:pos_x, Float:pos_y, Float:pos_z;
	GetPlayerPos(i, pos_x, pos_y, pos_z);
	return GetPlayerDistanceFromPoint(t, pos_x, pos_y, pos_z);
}

Float:GetDistanceBetweenPoints(Float:X, Float:Y, Float:Z, Float:PointX, Float:PointY, Float:PointZ)
{
	new Float:Distance;Distance = floatabs(floatsub(X, PointX)) + floatabs(floatsub(Y, PointY)) + floatabs(floatsub(Z, PointZ));
	return Distance;
}

