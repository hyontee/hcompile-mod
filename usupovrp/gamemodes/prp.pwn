}
DLG(4003, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new till = 0;
	if(sscanf(inputtext, "i", till)) return ShowPlayerDialog(playerid, 4000+3, 1, ""cMain"Положить деньги", ""cWH"Введите количество денег:", "Принять", "Отмена");
	if(till < 0) return ShowPlayerDialog(playerid, 4000+3, 1, ""cMain"Положить деньги", ""cWH"Введите количество денег:", "Принять", "Отмена");
	new i = (PI[playerid][pMember] == TEAM_CSKA) ? (0) : (PI[playerid][pMember] == TEAM_SPARTAK) ? (1) : (4); //TEAM_HITMAN
	if(FracBank[i] + till > 2000000000) return SendClientMessage(playerid, COLOR_RED, "Вы не можете пополнить склад денег более чем 2000000000 рублей");

	if(PI[playerid][pMember] == TEAM_HITMAN)
	{
		if(till > playerEuro[playerid] || till < 0) return SendClientMessage(playerid, -1, ""cER"У Вас нет столько Euro!");
		TransferEuro(playerid, -1, till, "Положил в общак");
		FracBank[i] += till;

		new Query[150];
		format(Query, sizeof(Query), "UPDATE `gang` SET grovebank=%d,ballasbank=%d,rifabank=%d,aztecbank=%d,vagosbank=%d", FracBank[0], FracBank[1], FracBank[2], FracBank[3], FracBank[4]);
		mysql_tquery(db_prod, Query, "", "");

		format(string, 90, "Вы положили на склад банды %d euro", till);
		SendClientMessage(playerid, COLOR_GREEN, string);

		if(PI[playerid][pSex] == 1) format(string, 90, "%s[%d] положил на склад банды %d euro", GetName(playerid), playerid, till);
		else format(string, 90, "%s[%d] положила на склад банды %d euro", GetName(playerid), playerid, till);
		SendFMes(PI[playerid][pMember], COLOR_YELLOW2, string);
		return 0x1;
	}
	if(till > GetPlayerRubble(playerid) || till < 0) return SendClientMessage(playerid, -1, ""cER"У Вас нет столько денег!");

	SetPlayerMoney(playerid, -till);
	FracBank[i] += till;

	new Query[150];
	format(Query, sizeof(Query), "UPDATE `gang` SET grovebank=%d,ballasbank=%d,rifabank=%d,aztecbank=%d,vagosbank=%d", FracBank[0], FracBank[1], FracBank[2], FracBank[3], FracBank[4]);
	mysql_tquery(db_prod, Query, "", "");

	format(string, 90, "Вы положили на склад банды %dр", till);
	SendClientMessage(playerid, COLOR_GREEN, string);
	if(PI[playerid][pSex] == 1) format(string, 90, "%s[%d] положил на склад банды %dр", GetName(playerid), playerid, till);
	else format(string, 90, "%s[%d] положила на склад банды %dр", GetName(playerid), playerid, till);
	SendFMes(PI[playerid][pMember], COLOR_YELLOW2, string);
	return 1;
}
