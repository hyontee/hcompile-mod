				if(containersInfo[idx][coLabel] == INVALID_3DTEXT_ID) continue;
				if(!containersInfo[idx][coCheckpoint]) continue;

				if(!IsPlayerInRangeOfPoint(playerid, 2.0, containersInfo[idx][coCheckpointPosX], containersInfo[idx][coCheckpointPosY], containersInfo[idx][coCheckpointPosZ])) continue;
