callback::CheckPlayerNick(playerid, nick[], param)
{
	if(!cache_num_rows()) return SendErr(playerid, "Ошибка: Аккаунт не найден.");

	switch(param)
	{
		case 0:
		{
			global_string = "";
			mysql_format(db_prod, global_string, 220, "UPDATE accounts SET cash = 20000000, LEVEL = 8, EXP = 0, credits = 0, donatepay = 0, countcars = 3, AllDonate = 0, model = 14, member = 0, leader = 0, rank = 0 WHERE NAME = '%e'", nick);
			mysql_tquery(db_prod, global_string, "", "");

			global_string = "";
			mysql_format(db_prod, global_string, 100, "DELETE FROM ownable_cars WHERE c_owner = '%e'", nick);
			mysql_tquery(db_prod, global_string, "", "");

			global_string = "";
			mysql_format(db_prod, global_string, 100, "DELETE FROM admin WHERE name = '%e'", nick);
			mysql_tquery(db_prod, global_string, "", "");

			global_string = "";
			mysql_format(db_prod, global_string, 100, "DELETE FROM fullaccess WHERE name = '%e'", nick);
			mysql_tquery(db_prod, global_string, "", "");

			fLogs("[admin] %s /obnul %s", GetName(playerid), nick);

			SendFormatInf(playerid, "Аккаунт %s успешно обнулен.", nick);
			return 1;
		}
		case 1:
		{
			new vost_pass[32];
			cache_get_field_content(0, "password", vost_pass, db_prod, 32);

			fLogs("[admin] %s /vostpass %s", GetName(playerid), nick);

			SendFormatInf(playerid, "Пароль от аккаунта %s - '%s' , без '.", nick, vost_pass);
		}
	}

	return 1;
}

