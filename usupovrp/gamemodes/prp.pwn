forward check_banlist(playerid);
public check_banlist(playerid)
{
	if(cache_num_rows())
	{
		new banday = cache_get_field_content_int(0, "time");
		if(banday)
		{
			for(new idx; idx < 3; idx++) TextDrawHideForPlayer(playerid, log_TD[idx]);
			CancelSelectTextDrawEx(playerid);

			new data[32], whobanned[MAX_PLAYER_NAME], reason[32];
			cache_get_field_content(0, "bandate", data);
			cache_get_field_content(0, "whobanned", whobanned);
			cache_get_field_content(0, "reason", reason);

			format(global_string, 464, ""cWH"Ваш аккаунт заблокирован на {ff4400}%d дней."cWH"\n\n"cWH"Ваш ник-нейм: "cMain"%s\n\
			"cWH"Ник администратора: "cMain"%s\n"cWH"Причина блокировки: "cMain"%s\n"cWH"Дата и время: "cMain"%s %s\n\n\
			"cWH"Введите {ffcd00}/в (/выход)"cWH" чтобы выйти.",  banday, GetName(playerid), whobanned, reason, data);

			stringer1 = ""cMain"Perfect RolePlay ";
			strcat(stringer1, SERVER_INFO);
			ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, stringer1, global_string, "Закрыть", "");
			KickEx(playerid, "banned");
		}
		else Testedgtrf(playerid);
	}
	else Testedgtrf(playerid);
	return 1;
}

stock Testedgtrf(playerid)
{
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `bans` WHERE `name` = '%s' LIMIT 1;", GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accounts` WHERE `name`= '%s' LIMIT 1;", GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "OnPlayerLogin", "d", playerid);
	return 1;
}

