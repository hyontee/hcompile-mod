			if(!GetPlayerHouse(playerid)) return SendClientMessage(playerid, -1, ""cER"У вас нет дома!");
			ShowPlayerDialog(playerid, 4600, DIALOG_STYLE_MSGBOX, ""cMain"Дом", "{66CC00}/home "cWH"- меню дома\n\
			{66CC00}/car "cWH"- обновить транспорт\n\
			{66CC00}/healing "cWH"- использовать домашнюю аптечку\n\
