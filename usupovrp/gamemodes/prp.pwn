public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	switch(hittype)
	{
	case BULLET_HIT_TYPE_PLAYER:
		{
			if(g_capture[C_STATUS])
			{
				if(PI[hitid][pMember] == g_capture[C_PROTECT_TEAM] || PI[hitid][pMember] == g_capture[C_ATTACK_TEAM])
				{
					if(PI[ playerid ][pMember] != g_capture[C_PROTECT_TEAM] && PI[ playerid ][pMember] != g_capture[C_ATTACK_TEAM]) return 0;
				}
			}
		}
	}
	return 1;
}

public OnPlayerTakeDamage(playerid, issuerid, Float: amount, weaponid, bodypart)
{
	if(!IsPlayerConnected(playerid)) return 0;
	if(!IsPlayerConnected(issuerid)) return 0;
	if(PI[issuerid][pAFK] >= 3) return 0;

	new Float:p_health;
	GetPlayerHealth(playerid, p_health);

	if(!IsACopAndFSB(issuerid))
	{
		if(PI[issuerid][pAdmin] < 10)
		{
			if(InAntiDMZone[playerid] != 0)
			{
				if(fights_player_status[issuerid] && fights_player_status[playerid]) return 1;
				antidmcount{issuerid} --;
				global_string = "";
				if(PI[issuerid][pJail] > 0)
				{
					if(antidmcount{issuerid} <= 0)
					{
						ShowPlayerDialog(issuerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Зелёная-Зона", "{FF0000}Внимание! Срок вашего наказания увеличен на 3 минуты, за частые действия DeathMatch'a", "Понял", "");
						PI[issuerid][pJailTime] += 3 * 60;
						antidmcount{issuerid} = 5;
						return true;
					}
					format(global_string, 356,""cWH"Внимание! Вы находитесь в зелёной зоне!\
					\n\nЧто такое зелёная зона?\nЭто место в котором запрещены драки в любом виде (кулаками,оружием)\
					\n\n{FF0000}Если Вы продолжите подобные действия,то через %d раз(а) Срок наказания будет увеличен!.",antidmcount{issuerid});
					ShowPlayerDialog(issuerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Зелёная-Зона", global_string, "Понял", "");
					SetPlayerHealth(playerid, p_health);
				}
				else
				{
					if(antidmcount{issuerid} <= 0)
					{
						ShowPlayerDialog(issuerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Зелёная-Зона", "{FF0000}Внимание! Вы были убиты за частые действия DeathMatch'a", "Понял", "");
						SetPlayerHealth(issuerid,0);
						return true;
					}
					format(global_string, 356,""cWH"Внимание! Вы находитесь в зелёной зоне!\
					\n\nЧто такое зелёная зона?\nЭто место в котором запрещены драки в любом виде (кулаками,оружием)\
					\n\n{FF0000}Если Вы продолжите подобные действия,то через %d раз(а) Вас убьет.",antidmcount{issuerid});
					ShowPlayerDialog(issuerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Зелёная-Зона", global_string, "Понял", "");
					SetPlayerHealth(playerid, p_health);
				}
				ApplyAnimation(issuerid,"MISC","plyr_shkhead",4.0,0,0,0,0,0,1);
				return 0;
			}
		}
	}

	switch(weaponid)
	{
	case 3:
		{
			if(IsACopAndFSB(issuerid))
			{
				if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(issuerid, COLOR_GREY, "Человек в машине!");
				if(g_player_tazer[playerid] > 0 || pCuff[playerid][pCuffee] == playerid) return SendClientMessage(issuerid, COLOR_GREY, "Игрок уже оглушен / в наручниках");
				format(string, sizeof(string), "%s оглушил Вас на 15 секунд", GetName(issuerid));
				SendClientMessage(playerid, COLOR_BLUE, string);
				format(string, sizeof(string), "Вы оглушили %s на 15 секунд", GetName(playerid));
				SendClientMessage(issuerid, COLOR_BLUE, string);
				if(PI[playerid][pSex] == 1) format(string, sizeof(string), "оглушил дубинкой %s", GetName(playerid));
				else format(string, sizeof(string), "оглушила дубинкой %s", GetName(playerid));
				MeAction(issuerid, string);
				ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 0, 1, 1, 1, 0, 1);

				g_player_tazer[playerid] = 1;
				PlayerFixTimerTazer[playerid] = 1;
				TogglePlayerControllable(playerid, 0);
				PlayerFixTimerTazerCount[playerid] = 15;
			}
		}
	}
	return 1;
}

stock PlayerToggle(playerid)
{
	TogglePlayerControllable(playerid, 1);
	ClearAnimations(playerid);
	if(g_player_tazer[playerid] > 0)
	{
		g_player_tazer[playerid] = 0;
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		return 1;
	}
	return 1;
}

GetVehSpeed(vehid)
{
	new Float:vel_x, Float:vel_y, Float:vel_z;
	GetVehicleVelocity(vehid, vel_x, vel_y, vel_z);
	return floatround(VectorSize(vel_x, vel_y, vel_z) * 170.0);
}
callback::PayDayTimer(playerid)
{
	if(GetPoluchPayDay[playerid] == 1)
	{
		GetPoluchPayDay[playerid] = 0;

		if(!playerNoTimeUpdate[playerid]) SetPlayerTime(playerid, hour, minute);

		new accountid = PI[playerid][pMainBankAccount];
		if(!IsValidBankAccount(playerid, accountid)) SendClientMessage(playerid, COLOR_RED, "У Вас не установлен основной банковский счёт"), GetPoluchPayDay[playerid] = 0;
		else
		{
			if(PI[playerid][pCheckTime] >= 2400 && IsThePayDayMembers(PI[playerid][pMember]) && !PI[playerid][pAdmin] && GetTeamID(playerid) != 0 && PI[playerid][pRank] != 0)
			{
				PI[playerid][pPayCheck] += Fraction_Pay[GetTeamID(playerid)][PI[playerid][pRank]-1]*MP1[4];
			}
			else if(PI[playerid][pCheckTime] >= 2400 && !PI[playerid][pAdmin])
			{
				switch(PI[playerid][pMember])
				{
				case TEAM_CSKA: PI[playerid][pPayCheck] += 1 * GangTotalGz[3];
				case TEAM_SPARTAK: PI[playerid][pPayCheck] += 1 * GangTotalGz[2];
				case TEAM_HITMAN: PI[playerid][pPayCheck] += 1 * GangTotalGz[4];
				}
			}
			SendClientMessage(playerid, COLOR_WHITE, "");
			SendClientMessage(playerid, COLOR_WHITE, ""cMain"______________________________________");

			if(PI[playerid][pMember] && PI[playerid][pRank])
			{
				if(IsAGang(playerid) == 0)
				{
					format(string, sizeof(string), "- Зарплата: {66CC00}%d рублей "cWH"| {66CC00}%d euro", Fraction_Pay[GetTeamID(playerid)][PI[playerid][pRank]-1]*MP1[4], Fraction_PayEuro[GetTeamID(playerid)][PI[playerid][pRank]-1]);
					SendClientMessage(playerid, COLOR_WHITE, string);
					TransferEuro(-1, playerid, Fraction_PayEuro[GetTeamID(playerid)][PI[playerid][pRank]-1], "payday");
				}
				if(IsAGang(playerid) == 1)
				{
					format(string, sizeof(string), "- Зарплата: {66CC00}%d рублей "cWH"| {66CC00}%d euro",  Fraction_Pay[GetTeamID(playerid)][PI[playerid][pRank]-1]*MP1[4], PI[playerid][pPayCheck]);
					SendClientMessage(playerid, COLOR_WHITE, string);
					TransferEuro(-1, playerid, PI[playerid][pPayCheck], "payday");
				}
				GiveBankMoney(playerid, Fraction_Pay[GetTeamID(playerid)][PI[playerid][pRank]-1]*MP1[4]);

				FracBank[9] -= Fraction_Pay[GetTeamID(playerid)][PI[playerid][pRank]-1]*MP1[4];
				MysqlUpdateOtherInt("sfnbank", FracBank[9]);
			}
			if(MP1[0] > 0)
			{
				format(string, sizeof(string), "- Гос. Налог: "cMain"%dр", MP1[0]);
				SendClientMessage(playerid, COLOR_WHITE, string);

				SetPlayerMoney(playerid, -MP1[0]);
				SetMeriaCash(MP1[0]);
			}

			if(GetPlayerRooms(playerid)) SendClientMessage(playerid, COLOR_WHITE, "- Кварплата: "cMain"100р");
			if(GetPlayerHouse(playerid)) SCMF(playerid, COLOR_WHITE, "- Налог на дом: {66CC00}%dр", GetHomeOplata(GetPlayerHouse(playerid)));
			if(GetPlayerBizz(playerid)) SCMF(playerid, COLOR_WHITE, "- Налог на бизнес: {66CC00}%dр", BizzInfo[GetPlayerBizz(playerid)][bBuyPrice] / 1000);
			if(PI[playerid][pPayCheck]) GiveBankMoney(playerid, PI[playerid][pPayCheck]);

			SCMF(playerid, COLOR_WHITE, "- Текущий баланс счёта: "cMain"%dр", g_player_bank_accounts[playerid][accountid][B_BALANCE]);
			PI[playerid][pPayCheck] = 0;

			if(PI[playerid][pWanted])
			{
				PI[playerid][pWanted]--;
				SetPlayerWantedLevel(playerid, PI[playerid][pWanted]);
			}
			if(PI[playerid][pCheckTime] < 0) SendClientMessage(playerid, COLOR_DARKORANGE, "В этом часу Вы отыграли менее 40 минут, по этому ничего не получаете!");
			else
			{
				PI[playerid][pTime]++;
				if(TYPE_VIP[playerid] != VIP_STATE_NONE) PI[playerid][pExp] += VipData[TYPE_VIP[playerid]][VipExp];
				if(TYPE_VIP[playerid] == VIP_STATE_NONE) PI[playerid][pExp] += 1;

				if(doubling_exp) PI[playerid][pExp]++;
				format(string, sizeof(string), "- Опыт (%d из %d)", PI[playerid][pExp], (PI[playerid][pLevel]+1)*4);
				SendClientMessage(playerid, COLOR_WHITE, string);
				if(PI[playerid][pExp] >= (PI[playerid][pLevel]+1)*4)
				{
					SendClientMessage(playerid, TEAM_BLUE_COLOR, "Ваш игровой возраст повысился!");

					if(TYPE_VIP[playerid] != VIP_STATE_NONE)
					{
						SCMF(playerid, COLOR_WHITE, "- Бонус за уровень: "cMain"%dр", VipData[TYPE_VIP[playerid]][VipBonus]);
					}

					PI[playerid][pLevel]++;
					PI[playerid][pAge]++;
					PI[playerid][pExp] = 0;
					SetPlayerScore(playerid, PI[playerid][pLevel]);
				}
			}
			PI[playerid][pCheckTime] = 0;
			Conday[1] = 0;
			SendClientMessage(playerid, COLOR_WHITE, ""cMain"______________________________________");

			if(InShop[playerid]) SelectTextDrawEx(playerid,gSelectColor[playerid]);
		}
		PayDayPlayerPromo(playerid);
	}
	return 0x1;
}

AntiFlood(playerid, code, time)
{
	if(playerAntiFlood[playerid][code] > unix) return 0;
	playerAntiFlood[playerid][code] = (unix + time);
	return 1;
}
callback::RestartServer()
{
	GameTextForAll( "~b~RESTART", 5000, 3);
	SendClientMessageToAll(COLOR_RED, "Уважаемые игроки, происходит автоматическая перезагрузка сервера...");
	SaveWarehouse();
	SaveMats();
	SaveMileage();
	SaveRouletteCount();
	foreach(new i: Player) KickEx(i, "restart");
	return 1;
}

new result_ivent;
new cont_spawn;

ShowPlayerStatsDialog(playerid, targetid) //kakaxa
{
	if(targetid == INVALID_PLAYER_ID) return 1;
	new status_text[20], married_text[MAX_PLAYER_NAME], wanted_text[32], phone_text[20];
	if(PI[targetid][pMarried] == 0) format(married_text, sizeof(married_text), "Нет");
	else format(married_text, sizeof(married_text), "%s", PI[targetid][pWhoMarried]);
	if(PI[targetid][pWanted] == 0) format(wanted_text, sizeof(wanted_text), "Нет");
	else format(wanted_text, sizeof(wanted_text), "%s", PI[targetid][pWantedReason]);
	if(PI[targetid][pPhoneNumber] <= 1) format(phone_text, sizeof(phone_text), "Не имеется");
	else format(phone_text, sizeof(phone_text), "%d", PI[targetid][pPhoneNumber]);
	if(PI[targetid][pAdmin]) status_text = "Администратор";
	else if(PI[targetid][pVip] != -1) status_text = "VIP";
	else status_text = "Игрок";
	new sctring[1400], str[250];
	format(str,sizeof(str),""cWH"Имя:\t"cMain"%s\n",GetName(targetid));
	strcat(sctring,str);
	format(str,sizeof(str),""cWH"Уровень:\t{FFAA44}%d\n",PI[targetid][pLevel]);
	strcat(sctring,str);
	format(str,sizeof(str),""cWH"Опыт:\t{FFAA44}%d / %d\n",PI[targetid][pExp], (PI[targetid][pLevel]+1)*4);
	strcat(sctring,str);
	format(str,sizeof(str),""cWH"Возраст:\t%d\n",PI[targetid][pAge]);
	strcat(sctring,str);
	format(str,sizeof(str),"Предупреждения:\t%d / 3\n",PI[targetid][pWarn]);
	strcat(sctring,str);
	format(str,sizeof(str),"Законопослушность:\t%d\n",PI[targetid][pZakon]);
	strcat(sctring,str);
	format(str,sizeof(str),"Наличные:\t%dр\n",GetPlayerRubble(targetid));
	strcat(sctring,str);
	format(str,sizeof(str),"Розыск:\t%d\n",PI[targetid][pWanted]);
	strcat(sctring,str);
	format(str,sizeof(str),"Номер телефона:\t%s\n",phone_text);
	strcat(sctring,str);
	if(PI[targetid][pSex] == 1) format(str,sizeof(str),"Женат на:\t%s\n",married_text);
	else format(str,sizeof(str),"Замужем за:\t%s\n",married_text);
	strcat(sctring,str);
	format(str,sizeof(str),"Пол:\t%s\n",(PI[targetid][pSex]==1)?("Мужчина"):("Женщина"));
	strcat(sctring,str);
	if(PI[targetid][pMember] != 0)
	{
		format(str,sizeof(str),"Организация:\t{63BD4E}%s"cWH"\n",Fraction_Name[PI[targetid][pMember]]);
		strcat(sctring,str);
		format(str,sizeof(str),"Должность:\t{63BD4E}%s (%d)"cWH"\n\n",frakRangName[PI[targetid][pMember]][PI[targetid][pRank]],PI[targetid][pRank]);
		strcat(sctring,str);
		format(str,sizeof(str),"Фракционных предупреждений:\t{63BD4E}%d/3"cWH"\n",PI[targetid][pTWarn]);
		strcat(sctring,str);
	}
	else format(str,sizeof(str),"Организация:\tНет\n");

	new number_bizz = GetPlayerBizz(targetid);

	if(!number_bizz)
	strcat(sctring,"Бизнес:\tНет\n");
	else
	{
		format(str,sizeof(str),"Бизнеc:\t%s (%d)\n",BizzInfo[number_bizz][bName],number_bizz);
		strcat(sctring,str);
	}

	new number_house = GetPlayerHouse(targetid);

	if(!number_house)
	strcat(sctring,"Дом:\tНет\n");
	else
	{
		format(str,sizeof(str),"Дом:\t№%d\n",number_house);
		strcat(sctring,str);
	}

	format(str,sizeof(str),"\n"SERVER_COINS":\t%d\n",PI[targetid][pPerfectCoins]);
	strcat(sctring,str);
	format(str,sizeof(str),"Номер аккаунта:\t%d\n",PI[targetid][pID]);
	strcat(sctring,str);
	format(str,sizeof(str),"Статус:\t%s\n",status_text);
	strcat(sctring,str);
	format(str,sizeof(str),"Материалов:\t%d\n",PI[targetid][pMats]);
	strcat(sctring,str);
	format(str,sizeof(str),"Фишки:\t%d\n",PhoneNumbers[targetid][0]);
	strcat(sctring,str);
	format(str,sizeof(str),"Очков ивента:\t%d\n",PI[targetid][pScoreIvent]);
	strcat(sctring,str);
	format(str,sizeof(str),"Дата:\t%d.%d.%04dг.",day, month, year);
	strcat(sctring,str);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Статистика персонажа", sctring, "Закрыть", "");
	return 1;
}

SetServerConfiguration(bind[], port)
{
	//51.91.91.100
	if(!strcmp(bind, "188.127.241.74") && port == 1256) // - Main
	{
		format(SERVER_INFO, sizeof(SERVER_INFO), "Red");

		BONUS_CASH = 50000000;
		BONUS_LVL = 8;

		SetGameModeText("CASE RUSSIA | RED");

		db_prod = mysql_connect("127.0.0.1", "user40226", "H531O3svHoxv", "casaca1");
		db_vost = mysql_connect("127.0.0.1", "user40226", "H531O3svHoxv", "casaca1");
	}
	else if(!strcmp(bind, "188.127.241.74") && port == 1256) // - Test
	{
		format(SERVER_INFO, sizeof(SERVER_INFO), "Test");

		BONUS_CASH = 50000000;
		BONUS_LVL = 8;

		SetGameModeText("CASE RUSSIA | Green");

		db_prod = mysql_connect("127.0.0.1", "user40226", "H531O3svHoxv", "casaca1");
		db_vost = mysql_connect("127.0.0.1", "user40226", "H531O3svHoxv", "casaca1");
	}
	else
	{
		printf("[debug] Сервер отключен, подключение не найдено.");
		GameModeExit();
