		case 6:
			{
				if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1) return SendClientMessage(playerid, -1, ""cER"Данная операция недоступна с данным счетом");
				ShowPlayerBankAccountCharity(playerid);
			}
		case 7:
			{
				if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1) return SendClientMessage(playerid, -1, ""cER"Данная операция недоступна с данным счетом");
				ShowPlayerDialog
				(
				playerid, 9341, DIALOG_STYLE_LIST,
				""cMain"Выберите действие:",
				""cWH"1. Снять деньги со счета бизнеса\n"\
				""cWH"2. Пополнить баланс бизнеса",
				"Далее", "Отмена"
				);
			}
		case 8:
			{
				if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1) return SendClientMessage(playerid, -1, ""cER"Данная операция недоступна с данным счетом");
