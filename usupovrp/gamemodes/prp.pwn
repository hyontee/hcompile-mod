{
	format(stringer1, 128, "SELECT `h_owner` FROM `helicopters` WHERE h_owner = '%s'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "CheckPlayerHelicopterLoad","i",playerid);
	return 1;
}

