DLG(403, playerid, response, listitem, inputtext[])
{
	if(!response) return SelectTextDraw(playerid, -1);
	new i = CTObizzid[playerid];
	new till = BizzInfo[i][bTill];
	if(GetVehicleComponentInSlot(GetPlayerVehicleID(playerid),CARMODTYPE_HYDRAULICS) != 1087)
	{
		if(GetPlayerRubble(playerid) < till*100) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
		SetPlayerMoney(playerid, -(till * 100));
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzInfo[i][bMoney] += till*100;
			BizzInfo[i][bProduct] -= 100;
			BizzPay[i] += till*100;
			MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
			MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
		}
		SendClientMessage(playerid,COLOR_GREEN,"Вы поставили гидравлику!");
		AddVehicleComponent(GetPlayerVehicleID(playerid),1087);
	}
	else
	{
		SendClientMessage(playerid,COLOR_RED,"Вы удалили гидравлику!");
		RemoveVehicleComponent(GetPlayerVehicleID(playerid),1087);
	}
	SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));

	SelectTextDraw(playerid, -1);

	return 1;
}
DLG(404, playerid, response, listitem, inputtext[])
{
	if(!response) return SelectTextDraw(playerid, -1);
	new color[2];
	if(GetPlayerVehicle(playerid))
	{
		if(sscanf(inputtext, "p<,>ii",color[0], color[1])) return ShowPlayerDialog(playerid, 400+4, 1, "Перекраска", "Введите основной и дополнительный цвет транспорта через запятую", "Принять", "Назад");
		if(color[0] < 0 || color[0] > 255)
		{
			ShowPlayerDialog(playerid, 400+4, 1, "{ffa500}Перекраска", ""cWH"Введите основной и дополнительный цвет транспорта через запятую", "Принять", "Назад");
			return SendClientMessage(playerid, COLOR_GREY, "ID цвета от 0 до 255!");
		}
		if(color[1] < 0 || color[1] > 255)
		{
			ShowPlayerDialog(playerid, 400+4, 1, "{ffa500}Перекраска", ""cWH"Введите основной и дополнительный цвет транспорта через запятую", "Принять", "Назад");
			return SendClientMessage(playerid, COLOR_GREY, "ID цвета от 0 до 255!");
		}
		new i = CTObizzid[playerid];
		new till = BizzInfo[i][bTill];
		if(GetPlayerRubble(playerid) < till*5) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
		SetPlayerMoney(playerid, -(till * 5));
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzInfo[i][bMoney] += till*5;
			BizzInfo[i][bProduct] -= 5;
			BizzPay[i] += till*5;
			MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
			MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
		}
		C_DATA[playerid][c_color][0] = color[0];
		C_DATA[playerid][c_color][1] = color[1];

		global_string[0] = EOS;
		mysql_format(db_prod, global_string, 300, "\
		UPDATE `ownable_cars` SET \
		c_color1 = '%d',\
		c_color2 = '%d' WHERE `id` = '%i'",
		color[0], color[1],
		GetPlayerVehicleSqlID(playerid));
		mysql_tquery(db_prod, global_string, "","");
		ChangeVehicleColor(GetPlayerVehicleID(playerid), color[0], color[1]);
		SendClientMessage(playerid,-1, ""cDA"Вы успешно перекрасили свое авто");

		SelectTextDraw(playerid, -1);
	}
	return 1;
}
DLG(414, playerid, response, listitem, inputtext[])
{
	new i = CTObizzid[playerid];
	if(!response) return SelectTextDraw(playerid, -1);
	if(GetPlayerRubble(playerid) < 15000) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
	if(BizzInfo[i][bProduct] > 0)
	{
		BizzInfo[i][bMoney] += 15000;
		BizzInfo[i][bProduct] -= 150;
		BizzPay[i] += 15000;
		SetPlayerMoney(playerid, -15000);
		MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
		MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
		RepairVehicle(GetPlayerVehicleID(playerid));
		SendClientMessage(playerid, COLOR_GREEN, "Вы тремонтировали Ваш транспорт за 15.000 рублей!");

		SelectTextDraw(playerid, -1);
	}
	else return SendClientMessage(playerid, COLOR_RED, "В СТО нет запчастей!");
	return 1;
}
DLG(5, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0: ShowPlayerStatsDialog(playerid, playerid);
	case 1: callcmd::cmd(playerid);
	case 2: callcmd::report(playerid);
	case 3: callcmd::ask(playerid);
	case 4:
		{
			global_string = "";
			format(global_string, 1500, "%s\n%s\n%s\n%s\n%s\n"cMain"6."cWH" Отображение TextDraw на экране",
			(Setting[playerid][1] != 1) ? (""cMain"1. "cWH"Авторизация на сервере\t| {63BD4E}TextDraw") : (""cMain"1. "cWH"Авторизация на сервере\t| {63BD4E}Диалог"),
			(Setting[playerid][2] != 1) ? (""cMain"2. "cWH"Покупка домов и бизнесов\t| {63BD4E}TextDraw") : (""cMain"2. "cWH"Покупка домов и бизнесов\t| {63BD4E}Диалог"),
			(Setting[playerid][3] != 1) ? (""cMain"3. "cWH"Меню банка и банкомата\t| {63BD4E}TextDraw") : (""cMain"3. "cWH"Меню банка и банкомата\t| {63BD4E}Диалог"),
			(Setting[playerid][4] != 1) ? (""cMain"4. "cWH"Заправочная станция\t| {63BD4E}TextDraw") : (""cMain"4. "cWH"Заправочная станция\t| {63BD4E}Диалог"),
			(Setting[playerid][5] != 1) ? (""cMain"5. "cWH"Ответ на вопрос/жалобу\t| {63BD4E}Сообщение") : (""cMain"5. "cWH"Ответ на вопрос/жалобу\t| {63BD4E}Диалог"));
			ShowPlayerDialog(playerid, 304, DIALOG_STYLE_LIST, ""cMain"Настройки персонажа", global_string, "Выбрать", "Назад");
		}
	case 5: PlayerSecurity(playerid);
	case 6: callcmd::donate(playerid);
	case 7:
		{
			new access, fmt_str[60];
			global_string = "";
			for(new idx; idx < MAX_PLAYER_ACCESSORIES; idx ++)
			{
				if(GetPlayerAccessoriesData(playerid, idx, A_OBJECT) == 0) continue;
				format(fmt_str, sizeof fmt_str, ""cMain"%d. "cWH"%s\n", idx + 1, GetPlayerAccessoriesData(playerid, idx, A_NAME));
				strcat(global_string, fmt_str);
				access ++;
			}
			if(access == 0) return SendClientMessage(playerid, COLOR_RED, "У Вас нет аксессуаров. Приобрести их можно в магазине аксессуаров (/gps)");
			ShowPlayerDialog(playerid, 7746, DIALOG_STYLE_LIST, ""cMain"Аксессуары", global_string, "Далее", "Отмена");
		}
	case 8:
		{
			playerHistoryBanPage[playerid] = 0;
			ShowHistoryBan(playerid, playerid);
		}
	case 9: ShowPlayerDialog(playerid, 2538, DIALOG_STYLE_LIST, ""cMain"Рефералы", ""cMain"1."cWH" Мои рефералы\n"cMain"2."cWH" Указать игрока пригласившего вас в игру ["cMain"Доступно если отыграно менее 2 часf"cWH"]", "Принять", "Отмена");
	case 10: ShowPlayerDialog(playerid, 2552, DIALOG_STYLE_LIST, ""cMain"Промокод", ""cMain"1."cWH" Список активированных промокодов\n"cMain"2."cWH" Активировать промокод", "Выбрать", "Отмена");
	}
	return 1;
}
DLG(15005, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(IsTextInvalid(inputtext)) return SCM(playerid,-1,""cMain"Ошибка: "cWH"Вы ввели запрещенные символы.");

	mysql_format(db_prod, stringer1, sizeof(stringer1), "SELECT * FROM `promo_activations` WHERE `account_id` = '%d' AND `name_promo` = '%e'",PI[playerid][pID],inputtext);
	mysql_tquery(db_prod, stringer1, "CheckPromo", "is", playerid, inputtext);
	return 1;
}

