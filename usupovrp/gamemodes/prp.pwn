			ShowPlayerDialog(playerid, 4600, DIALOG_STYLE_MSGBOX, ""cMain"Чат", "{66CC00}/me "cWH"- действие от 1-го лица \n\
			{66CC00}/ame "cWH"- действие от 1-го лица (над головой)\n\
			{66CC00}/do "cWH"- действие от 3-го лица\n\
			{66CC00}/try "cWH"- попытка действия\n\
			{66CC00}/s "cWH"- крикнуть\n\
