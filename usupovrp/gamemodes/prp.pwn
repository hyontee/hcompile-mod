DLG(2425, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;
	new
		id = GetPVarInt(playerid, "trunk_vehid"),
		query[256];

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", id);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();

	new
		patron,
		gascan,
		drugs,
		money,
		gun[3],
		repairkit,
		trunks[64];

	if(rows > 0)
	{
		cache_get_field_content(0, "c_trunk", trunks, db_prod, 64);
		sscanf(trunks, "p<,>iiiiiiii",
		patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
	}
	cache_delete(result);

	new
		count = strval(inputtext);

	if(GetPlayerRubble(playerid) < count)
		return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько денег");

	if(strval(inputtext) < 1 || count+money > 10000000)
		return ShowDialogPutMoney(playerid, money);


	money += count;
	SetPlayerMoney(playerid, -count);
	SendMes(playerid, COLOR_GREEN, "Вы положили в багажник %i рублей", count);

	new
		trunker[64];

	format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2]);
	format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
	mysql_tquery(db_prod, stringer1, "", "");
	return true;
}

