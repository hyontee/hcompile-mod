	if(PlayerItem2[playerid][ok]<strval(inputtext))return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько патронов");
	if(PlayerItem2[playerid][ok] == 0) PlayerItem1[playerid][ok]=0;

	family_info[f][f_patr] += strval(inputtext);
	PlayerItem2[playerid][ok] -= strval(inputtext);
	global_string = "";
	mysql_format(db_prod, global_string, 100, "UPDATE `family_system` SET `fam_patr` = '%d' WHERE `fam_id` = '%d'", family_info[f][f_patr], f);
	mysql_tquery(db_prod, global_string, "","");
	new fmt_msg[128];
