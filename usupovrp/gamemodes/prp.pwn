cmd:a(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, "• {66CC00}[ Подсказка ] "cWH"Введите: /a [текст]");

	if(!g_player_full_access[playerid])
	{
		if(PI[playerid][pBuyAdmin]) format(stringer1,sizeof(stringer1), "[П] %s %s[%d]: %s", gAdminRanks[PI[playerid][pAdmin]-1], PI[playerid][pName], playerid, params[0]);
		else format(stringer1,sizeof(stringer1), "[A] %s %s[%d]: %s", gAdminRanks[PI[playerid][pAdmin]-1], PI[playerid][pName], playerid, params[0]);
	}
	else format(stringer1, sizeof(stringer1), "[A] {FF0000}(%s)"cWH" %s[%d]: %s", full_access_rank[playerid],PI[playerid][pName], playerid, params[0]);
	SendAdminMessage(-1, stringer1);

	fLogs("[admin] %s /a %s", GetName(playerid), params);
	return 1;
}

cmd:garage(playerid)
{
	if(GetPlayerGarage(playerid) == -1) return SendClientMessage(playerid, COLOR_RED, "Вы не имеете гараж");

	new g = GetPlayerGarage(playerid), title_str[64];

	format(title_str, sizeof title_str, ""cMain"Управление гаражем №%d", g);

	ShowPlayerDialog
	(
	playerid,
	6463,
	DIALOG_STYLE_LIST,
	title_str,
	"{43B5E6}1. Информация о гараже\n\
			"cWH"2. Отметить гараж на GPS\n\
			3. Открыть / закрыть гараж\n\
			4. Улучшения\n\
			5. Отремонтировать автомобиль\n\
			6. Воспользоваться радиоприемником\n\
			{FA6442}6. Дополнительные действия",
	"Выбрать", "Отмена"
	)
	;


	return true;
}

cmd:buygarage(playerid)
{
	for(new g = TotalGarages; g > 0; g --)
	{
		if(IsPlayerInRangeOfPoint(playerid, 3.0, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z]))
		{
			new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, GarageInfo[g][g_PRICE]);

			if(GetPlayerRubble(playerid) < price_house)
			return SendClientMessage(playerid, COLOR_RED, "На Вашем счету недостаточно средств для покупки данного гаража");
			if(GetPlayerGarage(playerid) != -1)
			return SendClientMessage(playerid, COLOR_RED, "У Вас уже имеется гараж");
			if(GarageInfo[g][g_OWNED] != -1)
			return SendClientMessage(playerid, COLOR_RED, "Вы не можете приобрести уже купленный гараж");
			garage_idVAR[playerid] = g;
			new garage_text[256], class_text[20];

			switch(GarageInfo[g][g_TYPE])
			{
			case 1: class_text = "Низкий";
			case 2: class_text = "Средний";
			case 3: class_text = "Высокий";
			}

			format(garage_text, sizeof garage_text, "\
			"cWH"Номер гаража: \t№%d\n\
			Класс гаража: \t%s\n\
			Стоимость: \t{43C928}%d рублей\n\n\
			"cWH"Для того, чтобы купить гараж, нажмите 'Купить'\n\
			Для того, чтобы отменить покупку, нажмите 'Отмена'",
			g, class_text, price_house);
			ShowPlayerDialog(playerid,5723,DIALOG_STYLE_MSGBOX,"{31A0CC}Покупка гаража",garage_text,"Купить", "Отмена");
			return true;
		}
	}
	return true;
}

cmd:adg(playerid)
{
	if(!GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Winston")) return 1;

	if(!CREATE_GARAGE[playerid])
	return SendClientMessage(playerid, COLOR_RED, "Вы еще не начали создавать гараж");

	new Float:PosX, Float:PosY, Float:PosZ;
	GetPlayerPos(playerid, PosX, PosY, PosZ);

	CREATE_GARAGE[playerid] = 1;

	GARAGE_X[playerid] = PosX;
	GARAGE_Y[playerid] = PosY;
	GARAGE_Z[playerid] = PosZ;

	SendClientMessage(playerid, COLOR_GREEN, "Теперь отойдите на расстояние от текстур, чтобы машина не попала в текстуры, и введите /nextgarage");

	return true;
}

cmd:endgarage(playerid)
{
	if(!GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Winston")) return 1;

	if(!CREATE_GARAGE[playerid])
	return SendClientMessage(playerid, COLOR_RED, "Вы еще не начали создавать гараж");
	if(GetPlayerInterior(playerid) != 0)
	return SendClientMessage(playerid, COLOR_RED, "В интерьере нельзя создать гараж");

	new Float:carX, Float:carY, Float:carZ, Float:carA;
	GetVehiclePos(garage_car[playerid], carX, carY, carZ);
	GetVehicleZAngle(garage_car[playerid], carA);

	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleID(playerid) != garage_car[playerid])
	return SendClientMessage(playerid, COLOR_RED, "Вы должны быть в специально-созданном автомобиле для установки гаража");

	GARAGE_CAR_X[playerid] = carX;
	GARAGE_CAR_Y[playerid] = carY;
	GARAGE_CAR_Z[playerid] = carZ;
	GARAGE_CAR_A[playerid] = carA;
	if(garage_car[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(garage_car[playerid]), garage_car[playerid] = INVALID_VEHICLE_ID;

	ShowPlayerDialog(playerid,7372,DIALOG_STYLE_LIST,"{2291B9}Выберите класс гаража", "\
	"cWH"1. Низкий класс \t{5AB4E4}Цена: 350.000 рублей\n\
	"cWH"2. Средний класс \t{5AB4E4}Цена: 750.000 рублей\n\
	"cWH"3. Премиум класс \t{5AB4E4}Цена: 1.150.000 рублей","Выбрать", "Выход");
	return true;
}

cmd:n(playerid, params[])
{
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	else if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/n [текст]");
	else if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);

	format(string, sizeof(string), "(( %s[%d]: %s ))", GetName(playerid), playerid, params);
	ProxDetector(20.0, playerid, string, 0xCCCC99FF);
	SetPlayerChatBubble(playerid, params, 0xCCCC99FF, 20.0, 7000);
	return 1;
}
alias:n("b");

cmd:s(playerid, params[])
{
	if(PI[playerid][pTime] < 1) return SendClientMessage(playerid, -1, ""cPS"Вы должны играть на сервере более 1 часа!");
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/s [текст]");
	if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);

	format(string, sizeof(string), "%s[%d] кричит: %s", GetName(playerid), playerid, params[0]);
	foreach(new i : Player)
	{
		new Float:rdist = GetDistanceBetweenPlayers(playerid, i), c;
		if(rdist > 13.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(i)) continue;
		switch(floatround(rdist))
		{
		case 0..3: c = 0xFFFFFFFF;
		case 4..8: c = 0xCCCCCCFF;
		case 9..13: c = 0xAAAAAAFF;
		default: c = 0x888888FF;
		}
		SendClientMessage(i, c, string);
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid, "ON_LOOKERS", "shout_01", 4.0, 0, 0, 0, 0, 0, 0);
	return 1;
}
cmd:w(playerid, params[])
{
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/w [текст]");
	if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);

	format(string, sizeof(string), "%s шепчет: %s", GetName(playerid), params[0]);
	ProxDetector(1.2,playerid, string, 0xBDB76BFF);
	SetPlayerChatBubble(playerid,params[0],COLOR_WHITE,1.2,10000);
	return 1;
}

cmd:infogov(playerid, params[])
{

	new minutes;

	new fmt_str[100],
	fmt_status[40];

	global_string = "";
	for(new idx; idx < 12; idx ++)
	{
		if(g_gov_info[idx][GOV_FRACTION] != 0)
		format(fmt_status, sizeof fmt_status, ""cMain"(%s)", Fraction_Name[g_gov_info[idx][GOV_FRACTION]]);
		else format(fmt_status, sizeof fmt_status, ""cMain"(Свободно)");

		format(fmt_str, sizeof fmt_str, ""cWH"%d"cMain":"cWH"%s%d\t%s\n", hour, idx < 2 ? ("0") : (""), minutes, fmt_status);
		strcat(global_string, fmt_str);

		minutes += 5;
	}

	ShowPlayerDialog
	(
	playerid, 0, DIALOG_STYLE_LIST,
	""cMain"Информация о гос. новостях",
	global_string,
	"Занять", "Отмена"
	);

	return 1;
}

cmd:editgov(playerid, params[])
{
	if(!IsALegal(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, "Канал гос. новостей не доступен для Вас");
	if(PI[playerid][pMuted]) return SendClientMessage(playerid, COLOR_GREY, "Канал гос. новостей не доступен с мутом");

	new minutes;
	new fmt_str[100],
	fmt_status[40];

	global_string = "";
	for(new idx; idx < 12; idx ++)
	{
		if(g_gov_info[idx][GOV_FRACTION] != 0)
		format(fmt_status, sizeof fmt_status, ""cMain"(%s)", Fraction_Name[g_gov_info[idx][GOV_FRACTION]]);
		else format(fmt_status, sizeof fmt_status, ""cMain"(Свободно)");

		format(fmt_str, sizeof fmt_str, ""cWH"%d"cMain":"cWH"%s%d\t%s\n", hour, idx < 2 ? ("0") : (""), minutes, fmt_status);
		strcat(global_string, fmt_str);
		minutes += 5;
	}
	ShowPlayerDialog(playerid, 7335, DIALOG_STYLE_LIST,""cMain"Редактор гос. новостей",global_string,"Занять", "Отмена");
	return 1;
}

cmd:ot(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено отвечать на репорт");
	if(sscanf(params, "us[128]", params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/ot [ID] [текст]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]) & 0;

	format(string, sizeof(string), "Администратор %s[%d] ответил Вам: %s", GetName(playerid), playerid, params[1]);
	SendClientMessage(params[0], 0xFFAA44FF, string);
	format(string, sizeof(string), "{6495ED}Администратор %s[%d] ответил игроку %s[%d]: {808080} %s", GetName(playerid), playerid, GetName(params[0]), params[0], params[1]);
	SendAdminMessage(0xFFAA44FF, string);
	fLogs("[admin] %s /ot %s %s", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}
CMD:areport(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 0x1;
	if(!g_player_full_access[playerid]) return 0x1;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, 0xCCCCCCFF, "Используйте: /areport [id]");
	if(PI[params[0]][pAdmin] < 1) return SendClientMessage(playerid, -1, ""cER"Данный игрок не является администратором");

	PI[params[0]][pAdmSt][ADMIN_PM] -= 100;
	if(PI[params[0]][pAdmSt][ADMIN_PM] < 0) PI[params[0]][pAdmSt][ADMIN_PM] = 0;

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы списали 100 репортов у администратора %s[%d]", GetName(params[0]), params[0]);
	SendClientMessage(playerid, 0xFFFF00FF, STRING_GLOBAL);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] списал вам 100 репортов", GetName(playerid), playerid);
	SendClientMessage(params[0], 0xFFFF00FF, STRING_GLOBAL);
	return 0x1;
}

CMD:pm(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, COLOR_GREY, YouAreNotLoggedInAsAdmin);

	new osn_adm;
	foreach(new i : Player)
	{
		if(PI[i][pAdmin] > 0 && !PI[i][pBuyAdmin] && PI[i][pAdmin] != 11) osn_adm++;
	}
	if(osn_adm != 0 && PI[playerid][pBuyAdmin]) return SCM(playerid, -1, "Запрещено отвечать в репорт, когда в сети есть основная администрация");

	new ReportCount = 0;
	for(new report_id = 0; report_id != MAX_REPORTS; report_id ++)
	{
		if(gReportInfo[report_id][rPlayerID] != -1 && gReportInfo[report_id][rAnswer] == -1)
		{
			gReportInfo[report_id][rAnswer] = playerid;
			gReportInfo[report_id][rIsTooked] = true;
			playerAdminReport[playerid] = report_id;
			ReportCount ++;

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cWH"Сообщение от: "cMain"%s\n\n"cWH"%s\n"cWH"Время отправки: "cMain"%s", PI[ gReportInfo[report_id][rPlayerID] ][pName], gReportInfo[report_id][rText], gReportInfo[report_id][rWhenWroted_Text]);
			ShowPlayerDialog(playerid, 9007, DIALOG_STYLE_INPUT, ""cWH"", STRING_GLOBAL, "Ответить", "Удалить");
			break;
		}
	}
	if(ReportCount == 0) return SendClientMessage(playerid, 0xCCCCCCFF, ""cER"В данный момент нет активных жалоб");
	return 0x1;
}

CMD:ans(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	new osn_adm;
	foreach(new i : Player)
	{
		if(PI[i][pAdmin] > 0 && !PI[i][pBuyAdmin] && PI[i][pAdmin] != 11) osn_adm++;
	}
	if(osn_adm != 0 && PI[playerid][pBuyAdmin]) return SCM(playerid, -1, "Запрещено отвечать в репорт, когда в сети есть основная администрация");

	if(new_report) return ShowPlayerAdminReports(playerid);
	else SendErr(playerid, "Список активных репортов пуст");
	return 0x1;
}

cmd:freeze(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1, ""cPS"/freeze [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(FreezePlayer[params[0]] == true) return SendClientMessage(playerid, COLOR_GREY, "Этот игрок уже заморожен");
	if(g_player_in_event[params[0]]) return SendClientMessage(playerid, COLOR_RED, "Этот игрок участвует в мероприятии");

	format(string, sizeof(string), ""cAD"%s[%d] заморозил %s[%d]", GetName(playerid), playerid, GetName(params[0]), params[0]);
	SendAdminMessage(COLOR_GREY, string);
	format(string, sizeof(string), "Администратор %s заморозил Вас", GetName(playerid));
	SendClientMessage(params[0], COLOR_RED, string);
	TogglePlayerControllable(params[0], 0);
	fLogs("[admin] %s /freeze %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:unfreeze(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1, ""cPS"/unfreeze [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(FreezePlayer[params[0]] == false) return SendClientMessage(playerid, COLOR_GREY, "Этот игрок не заморожен");

	format(string, sizeof(string), ""cAD"%s[%d] разморозил %s[%d]", GetName(playerid), playerid, GetName(params[0]), params[0]);
	SendAdminMessage(COLOR_GREY, string);
	format(string, sizeof(string), "Администратор %s разморозил Вас", GetName(playerid));
	SendClientMessage(params[0], COLOR_RED, string);
	TogglePlayerControllable(params[0], 1);
	fLogs("[admin] %s /unfreeze %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:nabor(playerid, params[])
{
	if((IsAGang(playerid) || IsAMafia(playerid)) && PI[playerid][pRank] >= 9)
	{
		if(CMDnabor[playerid] > unix)
		{
			SendMes(playerid, -1, "Вы уже подавали объявление. Следующее можно будет отправить через: %d секунд",CMDnabor[playerid]-unix);
			return 1;
		}
		if(sscanf(params,"s[144]",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Используйте /nabor [текст]");
		if(strlen(params[0]) > 100) return SendClientMessage(playerid, -1, "Слишком длинное сообщение");
		if(PI[playerid][pMuted]) return SendClientMessage(playerid, -1, "У вас бан чата!");
		if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);
		global_string="";
		format(global_string,144,"« (( НАБОР )) » %s. Отправитель: %s[%d]. Тел: %d", params[0], PI[playerid][pName], playerid, PI[playerid][pPhone]);
		SendClientMessageToAll(0xEFAB0CFF, global_string);
		CMDnabor[playerid] = unix+120;
	}
	return 1;
}

CMD:killer(playerid)
{
	if(PI[playerid][pMember] != TEAM_HITMAN) return SendClientMessage(playerid, -1, ""cER"Вам не доступна данная возможность");
	mysql_tquery(db_prod, "SELECT * FROM `hitman` WHERE `ONLINE` != '0'", "OnServerLoadKillerData", "ii", playerid, 0);
	return 0x1;
}

CMD:kill(playerid, params[])
{
	if(sscanf(params, "ii", params[0], params[1])) return SendClientMessage(playerid, 0xCCCCCCFF, ""cPS"Используйте: /kill [ID жертвы] [Сумма в EURO]");
	if(IsPlayerConnected(params[0]) == 0 || params[0] == 0xFFFF || PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, ""cER"Данный игрок не авторизован на сервере");
	if(params[1] < 10 || params[1] > 50000) return SendClientMessage(playerid, -1, ""cER"Сумма не может быть менее 10 и более 50000 EURO");
	if(playerEuro[playerid] < params[1]) return SendClientMessage(playerid, -1, ""cER"У вас недостаточно денежных средств");
	if(PI[params[0]][pMember] == TEAM_HITMAN) return SendClientMessage(playerid, -1, ""cER"Вы не можете сделать заказ на киллера");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете заказать свое убийство");

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] сделал заказ на убийство %s[%d]. Награда: %d EURO", GetName(playerid), playerid, GetName(params[0]), params[0], params[1]);
	SendFMes(TEAM_HITMAN, 0xFFFF00FF, STRING_GLOBAL);

	SendFMes(TEAM_HITMAN, 0xFFFF00FF, "Для просмотра заказов используйте /killer");

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы сделали заказ на убийство %s[%d]. Награда: %d EURO", GetName(params[0]), params[0], params[1]);
	SendClientMessage(playerid, 0xFFFF00FF, STRING_GLOBAL);

	TransferEuro(playerid, -1, params[1], "Заказ у хитманов");
	PlayerUseVictim[params[0]] = 1;
	FracBank[4] += params[1];

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `gang` SET `vagosbank` = '%d'", FracBank[4]);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `hitman` (`ONLINE`, `OWNER`, `oID`, `VICTIM`, `vID`, `MONEY`, `UNIX_TIME`) VALUES ('%d', '%e', '%d', '%e', '%d', '%d', '%d')", params[0], GetName(playerid), PI[playerid][pID], GetName(params[0]), PI[params[0]][pID], params[1], gettime());
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	return 0x1;
}

cmd:findkill(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_HITMAN) return SendClientMessage(playerid, -1, ""cER"Вам не доступна данная возможность");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, 0xCCCCCCFF, ""cPS"Используйте: /findkill [ID]");
	if(IsPlayerConnected(params[0]) == 0 || params[0] == 0xFFFF || PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, ""cER"Данный игрок не авторизован на сервере");
	if(PlayerUseVictim[params[0]] == -1) return SendClientMessage(playerid, -1, ""cER"Данного персонажа нет в списке закаов");

	new Float: PosX;
	new Float: PosY;
	new Float: PosZ;
	GetPlayerPos(params[0], PosX, PosY, PosZ);
	GPSPlayer_(playerid, PosX, PosY, PosZ, "Последнее местоположение");
	SendClientMessage(playerid, COLOR_GREEN, "Последнее местоположение жертвы отмечено у Вас на карте");
	return 0x1;
}
cmd:search(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendErr(playerid, YouCanNot);
	new id;
	if(sscanf(params, "u", id)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/search [id игрока]");
	if(!IsPlayerConnected(id)) return SendErr(playerid, PlayerIsNotOnline);
	if(PlayerLogged[id] == false) return SendErr(playerid, PlayerIsNotAuthorized);
	if(!PI[id][pWanted]) return SendErr(playerid, "Игрок не находится в розыске");
	if(GetPlayerInterior(id) || GetPlayerVirtualWorld(id)) return SendErr(playerid, "Местоположение преступника определить не удалось. Попробуйте позже");
	if(playerFind[playerid])
	{
		playerFind[playerid] = 0;
		SendInf(playerid, "Вы отключили поиск приступника");
		DisablePlayerRaceCheckpoint(playerid);
	}
	else
	{
		playerFind[playerid] = (id + 1);
		new Float:pos_x, Float:pos_y, Float:pos_z;
		GetPlayerPos(id, pos_x, pos_y, pos_z);
		SendInf(playerid, "Последнее местоположение преступника отмечено у Вас на карте");
		SendInf(playerid, "Оно будет обновляться каждые 10 секунд.");
		GPSPlayer_(playerid, pos_x, pos_y, pos_z, "Последнее местоположение");
	}
	return 1;
}


cmd:kick(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено кикать игроков");
	if(sscanf(params, "uS()[32]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/kick [ID] [причина]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(g_player_full_access[params[0]]) return BanAdminFromServer(playerid, params[0]);
	if(!GetString(GetName(playerid), "Winston") && PI[playerid][pAdmin] <= PI[params[0]][pAdmin]) return AttemptRemoveAdmin(playerid, params[0]);
	if(IsIpFound(params[1]) || CheckString(params[1])) return AdminAntisliv(playerid, params[1]);

	if(strlen(params[1])) format(string, sizeof(string), "Администратор %s кикнул игрока %s. Причина: %s", GetName(playerid), GetName(params[0]), params[1]);
	else format(string, sizeof(string), "Администратор %s кикнул игрока %s.", GetName(playerid), GetName(params[0]));
	SendClientMessageToAll(COLOR_RED, string);
	SaveHistoryBan(GetName(params[0]), string);

	KickEx(params[0], "/kick");
	PI[playerid][pAdmSt][ADMIN_KICK] ++;
	AdminInfo[playerid][admKickText][0] = EOS;
	strcat(AdminInfo[playerid][admKickText], params[1]);
	ProtectionServerAdmin(playerid);
	fLogs("[admin] %s /kick %s %s", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}

cmd:skick(playerid, params[])
{
	if(PI[playerid][pAdmin] < 6) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено кикать игроков");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/skick [id игрока]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(g_player_full_access[params[0]]) return BanAdminFromServer(playerid, params[0]);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!GetString(GetName(playerid), "Winston") && PI[playerid][pAdmin] <= PI[params[0]][pAdmin]) return AttemptRemoveAdmin(playerid, params[0]);

	format(string, sizeof(string), ""cAD"%s[%d] тихо кикнул игрока %s [ID:%d]", GetName(playerid), playerid, GetName(params[0]), params[0]);
	SendAdminMessage(COLOR_GREY, string);

	PI[playerid][pAdmSt][ADMIN_KICK] ++;
	KickEx(params[0], "/skick");
	ProtectionServerAdmin(playerid);
	fLogs("[admin] %s /skick %s", GetName(playerid), GetName(params[0]));
	return 1;
}

CMD:netstats(playerid)
{
	if(PI[playerid][pAdmin] < 12)
		return 1;

	new
		totalstring[1024];
	GetNetworkStats(totalstring, 1024);
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Статистика сервера", totalstring, !"Закрыть", !"");
	return true;
}

CMD:setpos(playerid, params[])
{
	if(PI[playerid][pAdmin] < 12)
		return 1;

	new Float:X,Float:Y,Float:Z;
	if(sscanf(params, "fff", X, Y, Z) && sscanf(params, "p<,>fff", X, Y, Z))
		return SendInf(playerid, "/setpos [X] [Y] [Z]");

	SetPlayerPos(playerid, X, Y, Z);
	return true;
}

cmd:sban(playerid, params[])
{
	if(PI[playerid][pAdmin] < 8) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено банить игроков");
	if(sscanf(params, "ids[32]", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/sban [id игрока] [кол-во дней] [причина]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!GetString(GetName(playerid), "Winston") && PI[playerid][pAdmin] <= PI[params[0]][pAdmin]) return AttemptRemoveAdmin(playerid, params[0]);
	if(IsIpFound(params[2]) || CheckString(params[2])) return AdminAntisliv(playerid, params[2]);
	if(params[1] > 30 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "Количество дней от 1 до 30!");

	format(stringer1, sizeof(stringer1), ""cAD"%s[%d] тихо забанил игрока %s на %d дней. Причина: %s", GetName(playerid), playerid, GetName(params[0]),params[1], params[2]);
	SendAdminMessage(COLOR_GREY,stringer1);

	SCMF(playerid, -1, "- [%s] [IP: %s] - [RegIP: %s] - [LastIP: %s]", GetName(params[0]), PI[params[0]][pIP], PI[params[0]][pRegIP], PI[params[0]][pLastIP]);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', '%e', '%s', NOW(), %d, '%e')", GetName(params[0]), GetName(playerid), PI[params[0]][pIP], params[1], params[2]);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	KickEx(params[0], "/sban");
	PI[playerid][pAdmSt][ADMIN_BAN] ++;
	ProtectionServerAdmin(playerid);
	fLogs("[admin] %s /sban %s %i %s", GetName(playerid), GetName(params[0]), params[1], params[2]);
	return 1;
}

cmd:getip(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/getip [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);

	format(string, sizeof(string), "[%s] [IP: %s]-[RegIP: %s]-[LastIP: %s]", GetName(params[0]),PI[params[0]][pIP],PI[params[0]][pRegIP],PI[params[0]][pLastIP]);
	SendClientMessage(playerid, COLOR_YELLOW, string);
	fLogs("[admin] %s /getip %s [%s]", GetName(playerid), GetName(params[0]), PI[params[0]][pIP]);
	return 1;
}
CMD:pgetipoff(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	new name[24];
	if(sscanf(params, "s[24]", name))
	{
		SendInf(playerid, "Используйте: /pgetipoff [Имя]");
		return 1;
	}
	SQF2("i", playerid, "OnPlayerAccounts", "SELECT * FROM accounts WHERE name='%e'", name);
	fLogs("[admin] %s /pgetipoff %s", GetName(playerid), name);
	return 1;
}
callback::OnPlayerAccounts(playerid)
{
	if(!cache_num_rows())
	{
		SendErr(playerid, "Аккаунт не найден");
		return 1;
	}
	cache_get_field_content(0, "ip", stringer1, 1, 20);
	SQF2("i", playerid, "OnPlayerAccountsTwo", "SELECT * FROM accounts WHERE ip='%s'", stringer1);
	return 1;
}
callback::OnPlayerAccountsTwo(playerid)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "Аккаунт не найден");
		return 1;
	}
	stringer1 = ""cWH"Имя | Последний заход\n";
	global_string = "";
	new data0[24], data1[16];
	nfor(i, rows)
	{
		cache_get_field_content(i, "name", data0, 1, 32);
		cache_get_field_content(i, "datavhod", data1, 1, 16);
		nformat(global_string, "%s%s\t%s\n", global_string, data0, data1);
	}
	ShowPlayerDialog(playerid, 0, DSL, stringer1, global_string, "Выбрать", "Закрыть");
	return 1;
}
cmd:pgetip(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "s[60]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/pgetip [ip адрес]");

	format(string, sizeof(string), "- - - - Совпадение с: %s. - - - -", params[0]);
	SendClientMessage(playerid, COLOR_LIME, string);
	foreach(new i: Player) if(i != playerid && PlayerLogged[i])
	{
		if(GetString(PI[i][pIP], params[0]))
		{
			format(string, sizeof(string), "- %s[%d]", GetName(i), i, PI[i][pIP]);
			SendClientMessage(playerid, COLOR_ORANGE, string);
		}
	}
	fLogs("[admin] %s /pgetip %s", GetName(playerid), params[0]);
	return 1;
}

cmd:saveacc(playerid, params[])
{
	if(PI[playerid][pAdmin] < 8) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		SaveAccount(i);
	}
	SendClientMessage(playerid, -1, ""cDA"Вы успешно сохранили все аккаунты");
	fLogs("[admin] %s /saveacc", GetName(playerid));
	return 1;
}

cmd:nhistory(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено просматривать историю игрока");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/nhistory [id игрока]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	ShowHistoryBan(playerid, params[0]);
	return 1;
}

cmd:ban(playerid, params[])
{
	if(PI[playerid][pAdmin] < 4) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено банить игроков");
	if(sscanf(params, "udS()[32]", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/ban [id игрока] [кол-во дней] [причина]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] > 30 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "Количество дней от 1 до 30!");
	if(g_player_full_access[params[0]]) return BanAdminFromServer(playerid, params[0]);
	if(!GetString(GetName(playerid), "Winston") && PI[playerid][pAdmin] <= PI[params[0]][pAdmin]) return AttemptRemoveAdmin(playerid, params[0]);
	if(IsIpFound(params[2]) || CheckString(params[2])) return AdminAntisliv(playerid, params[2]);
	PI[params[0]][pSpawnChange] = 0;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawnchange` = '0' WHERE `id` = '%d' LIMIT 1", PI[params[0]][pID]);
	mysql_tquery(db_prod, STRING_GLOBAL);

	if(strlen(params[2])) format(string, sizeof(string), "Администратор %s забанил игрока %s на %d дней. Причина: %s", GetName(playerid), GetName(params[0]), params[1], params[2]);
	else format(string, sizeof(string), "Администратор %s забанил игрока %s на %d дней.", GetName(playerid), GetName(params[0]), params[1]);
	SendClientMessageToAll(COLOR_RED, string);
	SaveHistoryBan(GetName(params[0]), string);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', '%e', '%s', NOW(), %d, '%e')", GetName(params[0]), GetName(playerid), PI[params[0]][pIP], params[1], params[2]);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	PI[playerid][pAdmSt][ADMIN_BAN] ++;
	ResetPlayerWeapons(params[0]);
	KickEx(params[0], "/ban");

	AdminInfo[playerid][admBanText][0] = EOS;
	strcat(AdminInfo[playerid][admBanText], params[2]);
	ProtectionServerAdmin(playerid);
	fLogs("[admin] %s /ban %s %i %s", GetName(playerid), GetName(params[0]), params[1], params[2]);
	return 1;
}

cmd:offban(playerid, params[])
{
	if(PI[playerid][pAdmin] < 8) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено банить игроков");
	new playername[MAX_PLAYER_NAME], countday, reason[32];
	if(sscanf(params, "s[60]is[60]", playername, countday, reason)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offban [ник игрока] [кол-во дней] [причина]");
	if(CheckExceptionName(playername)) return AttemptRemoveChiefAdmin(playerid);
	if(IsIpFound(reason) || CheckString(reason)) return AdminAntisliv(playerid, reason);
	if(GetPlayerID(playername) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок в сети, используйте команду /ban");
	if(countday > 30 || countday < 1) return SendClientMessage(playerid, COLOR_GREY, "Количество дней от 1 до 30!");
	format(global_string, sizeof(global_string), "SELECT * FROM `accounts` WHERE `name`='%s'", playername);
	mysql_tquery(db_prod, global_string, "OnPlayerOffban", "isis", playerid, playername, countday, reason);
	return 1;
}

cmd:offwarn(playerid, params[])
{
	if(PI[playerid][pAdmin] < 9) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено варнить игроков");
	new playername[MAX_PLAYER_NAME], reason[32];
	if(sscanf(params, "s[60]s[60]", playername, reason)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offwarn [ник игрока] [причина]");
	if(CheckExceptionName(playername)) return AttemptRemoveChiefAdmin(playerid);
	if(IsIpFound(reason) || CheckString(reason)) return AdminAntisliv(playerid, reason);
	if(GetPlayerID(playername) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок в сети, используйте команду /warn");
	format(global_string, sizeof(global_string), "SELECT * FROM `accounts` WHERE `name`='%s'", playername);
	mysql_tquery(db_prod, global_string, "OnPlayerOffwarn", "iss", playerid, playername, reason);
	return 1;
}

cmd:offleader(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	new reason[32];
	if(sscanf(params, "s[60]s[60]", params[0], reason)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offleader [ник игрока] [причина]");
	if(CheckExceptionName(params[0])) return AttemptRemoveChiefAdmin(playerid);
	if(IsIpFound(reason) || CheckString(reason)) return AdminAntisliv(playerid, reason);
	if(GetPlayerID(params[0]) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок в сети!");

	format(global_string, sizeof(global_string), "UPDATE `accounts` SET leader = 0, member = 0, rank = 0 WHERE name = '%s'", params[0]);
	mysql_tquery(db_prod, global_string, "", "");

	format(stringer1, sizeof(stringer1), "Администратор %s[%d] снял в оффлайне лидера %s. Причина: %s", GetName(playerid), playerid, params[0], reason);
	SendClientMessageToAll(COLOR_RED, stringer1);
	SaveHistoryBan(params[0], stringer1);
	fLogs("[admin] %s /offleader %s %s", GetName(playerid), params[0], reason);
	return 1;
}

cmd:warn(playerid, params[])
{
	if(PI[playerid][pAdmin] < 8) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено варнить игроков");
	if(sscanf(params, "us[24]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/warn [id игрока] [причина]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(g_player_full_access[params[0]]) return BanAdminFromServer(playerid, params[0]);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!GetString(GetName(playerid), "Winston") && PI[playerid][pAdmin] <= PI[params[0]][pAdmin]) return AttemptRemoveAdmin(playerid, params[0]);
	if(IsIpFound(params[1]) || CheckString(params[1])) return AdminAntisliv(playerid, params[1]);
	PI[params[0]][pWarn]++;

	if(PI[params[0]][pWarn] < 3) format(string, sizeof(string), "Администратор %s выдал предупреждение игроку %s [%d/3]. Причина: %s", GetName(playerid), GetName(params[0]), PI[params[0]][pWarn], params[1]),PI[playerid][pAdmSt][ADMIN_WARN] ++;
	else
	{
		PI[params[0]][pWarn] = 0;
		format(string, sizeof(string), "Администратор %s забанил игрока %s (3 предупреждения). Причина: %s", GetName(playerid), GetName(params[0]), params[1]);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', '%e', '%s', NOW(), 7, '%e')", GetName(params[0]), GetName(playerid), PI[params[0]][pIP], params[1]);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
		PI[playerid][pAdmSt][ADMIN_BAN] ++;
	}
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET warn=%d, spawnchange=0 WHERE id=%d", PI[params[0]][pWarn], PI[params[0]][pID]);
	mysql_tquery(db_prod, stringer1, "", "");
	SendClientMessageToAll(COLOR_RED, string);
	SaveHistoryBan(GetName(params[0]), string);
	LeaveFractionPlayer(params[0]);
	PI[params[0]][pSpawnChange] = 0;

	KickEx(params[0], "/warn");
	AdminInfo[playerid][admWarnText][0] = EOS;
	strcat(AdminInfo[playerid][admWarnText], params[1]);
	ProtectionServerAdmin(playerid);
	fLogs("[admin] %s /warn %s %s", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}

cmd:tpcord(playerid, params[])
{
	new Float:pos[3];
	if(PI[playerid][pAdmin] < 11) return false;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "p<,>fff", pos[0], pos[1], pos[2])) return SendClientMessage(playerid, COLOR_RED, "Используйте: /tpcord [x, y, z]");
	SetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	fLogs("[admin] %s /tpcord %f %f %f", GetName(playerid), pos[0], pos[1], pos[2]);
	return true;
}
cmd:setcountcar(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(PI[playerid][pAdmin] < 11) return false;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params,"i", params[0])) return SendClientMessage(playerid,COLOR_ORANGE,"Введите: /setcountcar [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_RED, "Данный игрок не в сети");
	PI[params[0]][pCountCars] ++;
	SendMes(playerid, 0x53B346FF, "Вы увеличили игроку {FCA21C}%s(%d) {53B346}количество машин. Теперь игрок может иметь: {FCA21C}%d автомобилей", GetName(params[0]), params[0], PI[params[0]][pCountCars]);
	SendMes(params[0], 0x53B346FF, "Администратор {FCA21C}%s(%d) {53B346}увеличил Вам количество машин. Теперь Вы можете иметь: {FCA21C}%d автомобилей", GetName(playerid), playerid, PI[params[0]][pCountCars]);

	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET countcars=%d WHERE id=%d", PI[params[0]][pCountCars], PI[params[0]][pID]);
	mysql_tquery(db_prod, stringer1, "", "");
	fLogs("[admin] %s /setcountcar %s [%i]", GetName(playerid), GetName(params[0]), PI[params[0]][pCountCars]);
	return 1;
}
cmd:setcar(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return false;
	if(!g_player_full_access[playerid] && !GetString(GetName(playerid), "Winston")) return false;	// - buy fd
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	if(!GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Eduard_Haunted"))
	{
		if(PI[playerid][GiveCar] != 0) return SendClientMessage(playerid, -1, ""cER"Превышен лимит выдачи транспорта на сегодня.");
	}

	if(sscanf(params,"iiii", params[0], params[1], params[2], params[3])) return SendClientMessage(playerid,COLOR_ORANGE,"Введите: /setcar [id игрока] [ID модели] [Цвет 1] [Цвет 2]");
	if(params[1] > 611 || params[1] < 400) return SendClientMessage(playerid, COLOR_GREEN, "ID машины не может быть меньше 400 и больше чем 611");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_RED, "Данный игрок не в сети");
	if(params[1] == 493) return SendClientMessage(playerid, COLOR_GREY, "моделька косячная.");

	global_string = "";
	mysql_format(db_prod, global_string, 500, "\
	INSERT INTO `ownable_cars` (c_model, c_x, c_y, c_z, c_a, c_class, c_owner, c_fuel, c_color1, c_color2, c_lock, c_price, c_health) VALUES \
	('%d', '0', '0', '0', '0', '1', '%s', '45', '%d', '%d', '1', '2000000', '1000.0')",
	params[1], GetName(params[0]), params[2], params[3]);
	mysql_tquery(db_prod, global_string, "", "");

	PI[params[0]][pCountCars] ++;
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET countcars=%d WHERE id=%d", PI[params[0]][pCountCars], PI[params[0]][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	if(!GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Eduard_Haunted") && !GetString(GetName(playerid), "Winston"))
	{
		PI[playerid][GiveCar] = 1;
		MysqlUpdatePlayerInt(playerid, "GiveCar", PI[playerid][GiveCar]);
	}

	SendMes(playerid, 0x53B346FF, "Вы выдали {FCA21C}%s(%d) {53B346}автомобиль {FCA21C}%s(%d)", GetName(params[0]), params[1], VehicleNames[params[1]-400], params[1]);
	SendMes(params[0], 0x53B346FF, "Администратор {FCA21C}%s(%d) {53B346}выдал Вам автомобиль {FCA21C}%s(%d)", GetName(playerid), playerid, VehicleNames[params[1]-400], params[1]);
	SendClientMessage(params[0], 0x53B346FF, "Для загрузки автомобиля в игру, используйте команду {FCA21C}/car");

	fLogs("[admin] %s /setcar %s %i %i %i [%s]", GetName(playerid), GetName(params[0]), params[1], params[2], params[3], VehicleNames[params[1]-400]);
	fLogs("[cars] %s +%i %i %i /setcar", GetName(playerid), params[1], params[2], params[3]);
	return 1;
}

cmd:banip(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(PI[playerid][pAdmin] < 8) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SCM(playerid, -1, "Покупным  администраторам недоступна эта команда");
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/banip [ip адрес]");

	format(string, sizeof(string), ""cAD"%s заблокировал IP адрес %s", GetName(playerid), params);
	SendAdminMessage(COLOR_GREY, string);

	format(string, sizeof(string), "banip %s", params);
	SendRconCommand(string);
	fLogs("[admin] %s /banip %s", GetName(playerid), params);
	return 1;
}

cmd:unbanip(playerid, params[])
{
	if(PI[playerid][pAdmin] < 8) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SCM(playerid, -1, "Покупным  администраторам недоступна эта команда");
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/unbanip [ip адрес]");

	format(string, sizeof(string), ""cAD"%s разблокировал IP адрес %s", GetName(playerid), params);
	SendAdminMessage(COLOR_GREY, string);
	format(string, sizeof(string), "unbanip %s", params);
	SendRconCommand(string);
	fLogs("[admin] %s /unbanip %s", GetName(playerid), params);
	return 1;
}

cmd:acceptchangecar(playerid)
{
	if(!obcar_status[playerid]) return SendClientMessage(playerid, COLOR_RED, "Вам никто не предлагал обмен");
	new id1 = cars_id[playerid];

	new targetid = CarPlayer[playerid], price = CarPrice[playerid], id = my_car_id[playerid];

	if(GetPlayerLimitMoney(targetid, price))
	{
		SendErr(playerid, "У игрока максимальное количество денег.");
		SendErr(targetid, "У Вас максимальное количество денег.");
		return 1;
	}

	if(!GetPlayerVehicle(playerid))
		return SendErr(playerid,"Вы должны находиться в машине, которую хотите обменять");

	if(!GetPlayerVehicle(targetid))
		return SendErr(targetid,"Вы должны находиться в машине, которую хотите обменять");

	global_string = "";
	mysql_format(db_prod, global_string, 128, "UPDATE `ownable_cars` SET c_owner = '%s', c_status = '0' WHERE id = '%d'", GetName(playerid), id);
	mysql_tquery(db_prod, global_string, "", "");

	global_string = "";
	mysql_format(db_prod, global_string, 128, "UPDATE `ownable_cars` SET c_owner = '%s', c_status = '0' WHERE id = '%d'", GetName(targetid), id1);
	mysql_tquery(db_prod, global_string, "", "");

	SetPlayerMoney(playerid, -price);
	SetPlayerMoney(targetid, price);

	fLogs("[cars] %s -%i /acceptchangecar", GetName(playerid), id1);
	fLogs("[cars] %s +%i /acceptchangecar", GetName(playerid), id);
	fLogs("[cars] %s -%i /acceptchangecar", GetName(targetid), id);
	fLogs("[cars] %s +%i /acceptchangecar", GetName(targetid), id1);

	SendClientMessage(playerid, COLOR_GREEN, "Поздравляем Вас с обменом машины!");
	SendClientMessage(targetid, COLOR_GREEN, "Поздравляем Вас с обменом машины!");

	obcar_status[playerid] = 0;
	obmen_status[targetid] = 0;
	CarPrice[targetid] = 0;
	CarPlayer[targetid] = 0;
	CarPrice[playerid] = 0;
	CarPlayer[playerid] = 0;

	if(PI[playerid][PlayerCarID] != INVALID_VEHICLE_ID)
	{
		C_DATA[playerid][c_fuel] = Fuel[PI[playerid][PlayerCarID]];

		if(VehicleLabel[PI[playerid][PlayerCarID]] != INVALID_3DTEXT_ID) DestroyVehicleLabel(PI[playerid][PlayerCarID]);
		VehicleLabel[PI[playerid][PlayerCarID]] = INVALID_3DTEXT_ID;
		//DestroyPlayerCar(playerid);
		ClearCarData(playerid);

		global_string = "";
		mysql_format(db_prod, global_string, 128, "UPDATE `ownable_cars` SET c_status = '0' WHERE c_owner = '%s' and c_status != '0'", GetName(playerid));
		mysql_tquery(db_prod, global_string, "", "");

	}
	if(PI[targetid][PlayerCarID] != INVALID_VEHICLE_ID)
	{
		C_DATA[targetid][c_fuel] = Fuel[PI[targetid][PlayerCarID]];

		if(VehicleLabel[PI[targetid][PlayerCarID]] != INVALID_3DTEXT_ID) DestroyVehicleLabel(PI[targetid][PlayerCarID]);
		VehicleLabel[PI[targetid][PlayerCarID]] = INVALID_3DTEXT_ID;
		//DestroyPlayerCar(targetid);
		ClearCarData(targetid);

		global_string = "";
		mysql_format(db_prod, global_string, 128, "UPDATE `ownable_cars` SET c_status = '0' WHERE c_owner = '%s' and c_status != '0'", GetName(targetid));
		mysql_tquery(db_prod, global_string, "", "");
	}
	obmen_status[CarPlayer[playerid]] = 0;
	CarPlayer[ CarPlayer[playerid] ] = 0;
	obcar_status[playerid] = 0;
	CarPlayer[playerid] = 0;
	CarPrice[playerid] = 0;
	my_car_id[playerid] = 0;
	return 1;
}

cmd:deniedchangecar(playerid)
{
	if(!obcar_status[playerid]) return SendClientMessage(playerid, COLOR_RED, "Вам никто не предлагал обмен");

	SendMes(CarPlayer[playerid], COLOR_RED, "%s отказался от Вашего предложения", GetName(playerid));

	obmen_status[CarPlayer[playerid]] = 0;

	CarPlayer[ CarPlayer[playerid] ] = 0;
	obcar_status[playerid] = 0;
	CarPlayer[playerid] = 0;
	CarPrice[playerid] = 0;
	my_car_id[playerid] = 0;

	SendClientMessage(playerid, COLOR_RED, "Вы отказались от обмена");

	return 1;
}
cmd:cancelcar(playerid)
{
	if(!obmen_status[playerid]) return SendClientMessage(playerid, COLOR_RED, "Вы никому не предлагали обмен");
	new pid = CarPlayer[playerid];
	SendMes(pid, COLOR_RED, "%s отменил свое предложение об обмене", GetName(playerid));

	obmen_status[playerid] = 0;
	CarPlayer[playerid] = 0;
	change_car_time[playerid] = 0;

	obcar_status[pid] = 0;
	CarPlayer[pid] = 0;
	CarPrice[pid] = 0;
	my_car_id[pid] = 0;
	cars_id[pid] = 0;
	SendClientMessage(playerid, COLOR_RED, "Вы отказались от обмена");
	return 1;
}

cmd:e(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 0;
	if(Fuel[GetPlayerVehicleID(playerid)] <= 0) return SendClientMessage(playerid, COLOR_RED, "В транспорте закончился бензин");
	new vehicleid = GetPlayerVehicleID(playerid);
	GetVehicleParamsEx(vehicleid,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
	SetVehicleParamsEx(vehicleid,(Engine[vehicleid])?(false):(true),lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
	Engine[vehicleid] = (Engine[vehicleid])?(false):(true);

	if(!Engine[vehicleid]) PlayerTextDrawColor(playerid, speed_PTD[playerid][3], 0xFFFFFFFF);
	else PlayerTextDrawColor(playerid, speed_PTD[playerid][3], 0xFF6600FF);

	PlayerTextDrawHide(playerid, speed_PTD[playerid][3]); PlayerTextDrawShow(playerid, speed_PTD[playerid][3]);
	return 1;
}

cmd:l(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 0;

	new vehicleid = GetPlayerVehicleID(playerid);

	if(GetVehicleType(vehicleid) == 7 || GetVehicleType(vehicleid) == 5) return 1;
	GetVehicleParamsEx(vehicleid,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
	SetVehicleParamsEx(vehicleid,engine_global,(Lights[vehicleid])?(false):(true),alarm_global,doors_global,bonnet_global,boot_global,objective_global);
	Lights[vehicleid] = (Lights[vehicleid])?(false):(true);

	if(!Lights[vehicleid]) PlayerTextDrawColor(playerid, speed_PTD[playerid][4], 0xFFFFFFFF);
	else PlayerTextDrawColor(playerid, speed_PTD[playerid][4], 0xFF6600FF);

	PlayerTextDrawHide(playerid, speed_PTD[playerid][4]); PlayerTextDrawShow(playerid, speed_PTD[playerid][4]);
	return 1;
}

cmd:buyfuel(playerid)
{
	new newslot;
	for(new i = TOTALBIZZ; i > 0; i --)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, BizzInfo[i][bEntrx], BizzInfo[i][bEntry], BizzInfo[i][bEntrz])	&& BizzInfo[i][bType] == 2)
		{
			new till = BizzInfo[i][bTill]*4;
			if(GetPlayerRubble(playerid) < till) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
			if(CheckMaxVes(playerid,49,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
			SetPlayerMoney(playerid, -till);
			if(BizzInfo[i][bProduct] > 0)
			{
				BizzInfo[i][bMoney] += till;
				BizzInfo[i][bProduct] -= 10;
				BizzPay[i] += till;
				MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
				MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
			}
			PlayerItem1[playerid][newslot]=49;
			PlayerItem2[playerid][newslot]+=1;
			SendMes(playerid, -1, ""cDA"Вы купили канистру за %dр!", till);
			FuelBizzID[playerid] = 0;
			SaveItem(playerid,newslot);
		}
	}
	return 1;
}

cmd:cm(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 0;
	new vehicleid = GetPlayerVehicleID(playerid);
	if(GetVehicleType(vehicleid) == 2 || GetVehicleType(vehicleid) == 3 || GetVehicleType(vehicleid) == 5 || GetVehicleType(vehicleid) == 4 || GetVehicleType(vehicleid) == 7) return 1;
	ShowPlayerDialog(playerid, 4814, DIALOG_STYLE_LIST, ""cMain"Панель машины", "1. Капот\n2. Багажник\n3. Сигнализация\n4. Радиоприемник", "Выбор", "Отмена");
	return 1;
}

cmd:hgps(playerid)
{
	if(GetPlayerHouse(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вы не владеете домом");
	for(new i = TOTALHOUSE; i > 0; i--)
	{
		if(strcmp(GetName(playerid),HouseInfo[i][hOwner], true) == 0)
		{
			SetPlayerRaceCheckpoint(playerid,1, HouseInfo[i][hEntrx],HouseInfo[i][hEntry],HouseInfo[i][hEntrz],0.0,0.0,0.0, 4.0);
			SendClientMessage(playerid, COLOR_WHITE, "Ваш дом обозначен на карте {FF0000}красной меткой");
			Home[playerid] = 1;
			break;
		}
	}
	return 1;
}

cmd:rgps(playerid)
{
	if(GetPlayerRooms(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вы не владеете квартирой");

	for(new i = TOTALROOMS; i > 0;  i--)
	{
		if(!strcmp(RoomsInfo[i][rOwner],PI[playerid][pName],true))
		{
			new pod_id = RoomsInfo[i][rV];
			SetPlayerRaceCheckpoint(playerid,1, PodezdInfo[pod_id][poX],PodezdInfo[pod_id][poY],PodezdInfo[pod_id][poZ],0.0,0.0,0.0, 4.0);
			SendClientMessage(playerid, COLOR_WHITE, "Ваш подъезд обозначен на карте {FF0000}красной меткой");
			Pod[playerid] = 1;
			break;
		}
	}
	return 1;
}

cmd:unmute(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/unmute [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[params[0]][pMuted] == 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не имеет бан чата!");
	PI[params[0]][pMuted] = 0;
	PVC_UnMutePlayer(params[0]);

	format(string, sizeof(string), "Администратор %s снял бан чата у %s",GetName(playerid),GetName(params[0]));
	SendClientMessageToAll(COLOR_RED, string);
	SaveHistoryBan(GetName(params[0]), string);
	fLogs("[admin] %s /unmute %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:mute(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "udS()[64]", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/mute [id игрока] [время] [причина]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[playerid][pBuyAdmin] && PI[params[0]][pAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено выдавать наказания администраторам");
	if(PI[params[0]][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже имеет бан чата!");
	if(params[1] > 300 || params[1] < 10) return SendClientMessage(playerid, COLOR_GREY, "Время от 10 до 300 минут!");
	if(IsIpFound(params[2]) || CheckString(params[2])) return AdminAntisliv(playerid, params[2]);

	PI[params[0]][pMuted] = params[1]*60;
	if(strlen(params[2])) format(string, sizeof(string), "Администратор %s[%d] выдал бан чата %s[%d] на %d минут. Причина: %s",GetName(playerid), playerid, GetName(params[0]), params[0], params[1], params[2]);
	else format(string, sizeof(string), "Администратор %s[%d] выдал бан чата %s[%d] на %d минут.",GetName(playerid), playerid, GetName(params[0]), params[0], params[1]);
	SendClientMessageToAll(COLOR_RED, string);
	SaveHistoryBan(GetName(params[0]), string);
	PI[playerid][pAdmSt][ADMIN_MUTE] ++;

	PVC_MutePlayer(params[0]);

	AdminInfo[playerid][admMuteText][0] = EOS;
	strcat(AdminInfo[playerid][admMuteText], params[2]);
	ProtectionServerAdmin(playerid);
	fLogs("[admin] %s /mute %s %i %s", GetName(playerid), GetName(params[0]), params[1], params[2]);
	return 1;
}

cmd:paintlist(playerid)
{
	if(PlayerLogged[playerid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!strcmp(PBP_WINNAME,"None",true)) return SendClientMessage(playerid,COLOR_GREY,"Список победителей не составлен.");

	format(string,sizeof(string),""cWH"Лидер прошедшей игры в 'Мясорубке':\n- %s -",PBP_WINNAME);
	return ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "{F3F035}Результаты PaintBall", string, "Закрыть", "");
}

cmd:pbstart(playerid)
{
	if(!g_player_full_access[playerid]) return 1;
	if(PBP_STATUS != 0) return SCM(playerid,COLOR_GREY,"Мясорубка уже запущен.");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открылась регистрация на мероприятие 'Мясорубка'");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Стоимость регистрации 30.000 руб. Время на регистрацию 15 минут");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Зарегистрироваться: /gps -> Развлечения");
	PBP_STATUS = 1;
	PBP_TIMER = 900;//
	fLogs("[admin] %s /pbstart", GetName(playerid));
	return true;
}

cmd:pbtime(playerid,params[])
{
	if(PlayerLogged[playerid] == false) return true;
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PBP_STATUS == 0) return SCM(playerid,COLOR_GREY,"Мясорубка не запущена");
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"{9ACD32}Введите: /pbtime [время]");
	if(params[0] < 1 || params[0] > 300) return SCM(playerid,COLOR_GREY,"Разрешено от 1 до 300 секунд");
	PBP_TIMER = params[0];
	SendMes(playerid,COLOR_GREY,"Вы успешно установили %d сек до начала Мясорубки",PBP_TIMER);
	fLogs("[admin] %s /pbtime %i", GetName(playerid), params[0]);
	return true;
}

callback::OnPlayerCheckNumber(playerid, number[])
{
	if(cache_num_rows())
	{
		new owner_name[MAX_PLAYER_NAME], model;
		cache_get_field_content(0, "c_owner", owner_name);
		model = cache_get_field_content_int(0, "c_model");

		format(stringer1, 144,""cWH"Информация по гос. номеру "cMain"\"%s\":\n\n"cWH"Владелец: "cMain"%s\n"cWH"Модель: "cMain"%s (%d)\n\n",number,owner_name,VehicleNames[model-400],model);
		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX,""cMain"База данных",stringer1,"Закрыть", "");
		MeAction(playerid, "воспользовался базой данных");
	}
	else SendClientMessage(playerid, COLOR_RED, "В базе данных не найден автомобиль с таким номером");
	return 1;
}

cmd:number_info(playerid, params[])
{
	if(!IsACopAndFSB(playerid))
	return SendClientMessage(playerid, COLOR_RED, "Вам недостуна эта возможность");

	if(!strlen(params))
	return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/number_info [номер авто]");

	extract params -> new string: number[12];

	if(!strlen(number))
	return SendClientMessage(playerid, COLOR_RED, "Введите номер авто");

	global_string = "";
	mysql_format(db_prod, global_string, 128, "SELECT * FROM  WHERE c_number='%s'", number);
	mysql_tquery(db_prod, global_string, "OnPlayerCheckNumber", "is", playerid, number);

	return 1;
}

cmd:pull(playerid, params[])
{
	if(IsACopAndFSB(playerid))
	{
		new id;
		if(sscanf(params,"u",id)) return SendClientMessage(playerid, -1, ""cPS"Используй: /pull [id]");
		if(id == INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, ""cER"Данный игрок не авторизован на сервере.");
		if(id == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете тащить самого себя");
		if(GetDistanceBetweenPlayers(playerid, id) < 3.0)
		{
			if(GotoInfo[playerid][gtID] == INVALID_PLAYER_ID)
			{
				if(GotoInfo[id][gtGoID] == INVALID_PLAYER_ID)
				{
					if(pCuff[id][pCuffee] == id)
					{
						CheckPlayerGoCuff(playerid);
						CheckPlayerGoCuff(id);
						GotoInfo[id][gtID] = INVALID_PLAYER_ID;
						GotoInfo[playerid][gtGoID] = INVALID_PLAYER_ID;
						GotoInfo[playerid][gtID] = id;
						GotoInfo[id][gtGoID] = playerid;
						GotoInfo[id][gtState] = GetPlayerState(playerid);
						GetPlayerPos(id, GotoInfo[id][gtX], GotoInfo[id][gtY], GotoInfo[id][gtZ]);
						SendClientMessage(playerid, COLOR_WHITE, "{FFFF00}[Информация] "cWH"Чтобы перестать тащить игрока введите {33AA33}/unpull");
						format(string, sizeof(string), "* %s потащил игрока %s за собой", GetName(playerid), GetName(id));
						ProxDetector(25.0, playerid, string, COLOR_FADE1);
						TogglePlayerControllable(id, true);
					}
					else SendClientMessage(playerid, -1, ""cER"Игрок не скован");
				}
				else SendClientMessage(playerid, -1, ""cER"Этого игрока уже кто-то ведет за собой");
			}
			else SendClientMessage(playerid, -1, ""cER"Вы уже кого-то ведете за собой");
		}
		else SendClientMessage(playerid, -1, ""cER"Вы далеко от игрока");
	}
	return true;
}

cmd:resetgun(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 0;
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, ""cPS"Используйте: /resetgun [ID]");
	SendMes(playerid, COLOR_GREEN, "Оружие игрока %s было обнулено", GetName(params[0]));
	ResetPlayerWeapons(params[0]);
	fLogs("[admin] %s /resetgun %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:unpull(playerid, params[])
{
	if(IsACopAndFSB(playerid))
	{
		new id;
		if(sscanf(params,"u",id)) return SendClientMessage(playerid, -1, ""cPS"Используй: /unpull [id/name]");
		if(GetDistanceBetweenPlayers(playerid,id) < 2.0)
		{
			if(pCuff[id][pCuffee] == id && GotoInfo[playerid][gtID] == id)
			{
				format(string,sizeof(string),"* %s перестал тащить за собой игрока %s",GetName(playerid),GetName(id));
				ProxDetector(25.0, playerid, string, COLOR_FADE1);
				TogglePlayerControllable(id, 0);
				CheckPlayerGoCuff(id);
				CheckPlayerGoCuff(playerid);
			}
			else SendClientMessage(playerid, -1, ""cER"Игрок не скован, либо вы не тащите его");
		}
	}
	return true;
}

CMD:amusic(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	ShowPlayerDialog(playerid, 2631, DIALOG_STYLE_INPUT, "{FFCD00}Музыка", ""cWH"Функция позволяет включать музыку всем игрокам\nВведите URL аудиофайла или потока", "Принять", "Отмена");
	return true;
}

CMD:jail(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "iis[64]", params[0], params[1],  params[2]) || !(0 <= params[1] <= 120)) return SendClientMessage(playerid, COLOR_WHITE, "• {66CC00}[ Подсказка ] "cWH"Введите: /jail [id игрока] [время в минутах] [причина]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[params[0]][pJail] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже находиться в деморгане!");
	if(IsIpFound(params[2]) || CheckString(params[2])) return AdminAntisliv(playerid, params[2]);
	if(PI[playerid][pBuyAdmin] && PI[params[0]][pAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено выдавать наказания администраторам");

	ResetPlayerWeapons(params[0]);
	PI[params[0]][pJailTime] = params[1] * 60;
	if(pCuff[params[0]][pCuffer] != INVALID_PLAYER_ID)
	{
		new cuffer = pCuff[params[0]][pCuffer];
		SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(params[0], 0);
		pCuff[params[0]][pCuffer] = INVALID_PLAYER_ID;
		pCuff[params[0]][pCuffee] = INVALID_PLAYER_ID;
		pCuff[cuffer][pCuffee] = INVALID_PLAYER_ID;
		pCuff[cuffer][pCuffer] = INVALID_PLAYER_ID;
	}
	SetPlayerVirtualWorld(params[0], 3);

	format(string, sizeof(string), "Администратор %s посадил Вас в одиночную тюрьму на %d мин. Причина: %s", GetName(playerid),params[1], params[2]);
	SendClientMessage(params[0], COLOR_GREEN, string);
	format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~JAILED: ~w~%d MIN", params[1]);
	GameTextForPlayer(params[0], string, 3000, 3);
	format(string, sizeof(string), "[A] %s[%d] посадил %s[%d] в тюрьму на %d минут (%s)", GetName(playerid), playerid, GetName(params[0]), params[0], params[1], params[2]);
	SendAdminMessage(COLOR_GREY, string);
	format(string, sizeof(string), "Администратор %s посадил в тюрьму %s на %d минут. Причина: %s",GetName(playerid),GetName(params[0]), params[1], params[2]);
	SendClientMessageToAll(COLOR_LIGHTRED, string);
	SaveHistoryBan(GetName(params[0]), string);

	new r = random(10);
	SetPlayerPos(params[0], SetPlayerPosJail[r][0], SetPlayerPosJail[r][1], SetPlayerPosJail[r][2]);
	SetPlayerFacingAngle(params[0], SetPlayerPosJail[r][3]);
	SetPlayerVirtualWorld(params[0], playerid+1);
	SetPlayerInterior(params[0], 1);


	PI[params[0]][pJail] = 1;
	SetPlayerWantedLevel(params[0], 0);

	PI[playerid][pAdmSt][ADMIN_PRISON] ++;

	AdminInfo[playerid][admJailText][0] = EOS;
	strcat(AdminInfo[playerid][admJailText], params[2]);
	ProtectionServerAdmin(playerid);
	SetPlayerSkin(params[0], 48);
	fLogs("[admin] %s /jail %s %i %s", GetName(playerid), GetName(params[0]), params[1], params[2]);
	return 1;
}

cmd:unjail(playerid, params[])
{
	if(PI[playerid][pAdmin] < 2) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/unjail [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[params[0]][pJail] == 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находиться в тюрьме!");
	PI[params[0]][pJailTime] = 1;
	ResetPlayerWeapons(params[0]);

	format(string, sizeof(string), "Администратор %s[%d] выпустил из тюрьмы %s[%d]",GetName(playerid),playerid,GetName(params[0]),params[0]);
	SendClientMessageToAll(COLOR_RED, string);
	SaveHistoryBan(GetName(params[0]), string);

	format(string, sizeof(string), "Администратор %s[%d] вытащил вас из тюрьмы",GetName(playerid),playerid);
	SendClientMessage(params[0],COLOR_LIGHTGREEN, string);
	fLogs("[admin] %s /unjail %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:unarrest(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_OBLASTADMIN) return 1;
	if(!IsPlayerInRangeOfPoint(playerid, 300.0,-2320.9109,318.9050,1002.0000)) return true;
	if(PI[playerid][pRank] != 4) return SendClientMessage(playerid, COLOR_GREY, "Доступно только адвокатам!");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/unarrest [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(PI[params[0]][pJail] == 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находиться в тюрьме!");
	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_JAIL, MP1[2]);
	return 1;
}

cmd:id(playerid, params[])
{
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/id [ID / часть имени]");
	new ids = 0;
	if(!sscanf(params, "u", params[0]))
	{
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		SendMes(playerid, COLOR_WHITE, "ID: %d - %s",params[0],GetName(params[0]));
	}
	else
	{
		foreach(new i: Player)
		{
			if(PlayerLogged[i] == false) continue;
			if(strfind(GetName(i), params[0], true) != -1)
			{
				global_string = "";
				format(global_string, 144, ""cWH"ID: %d - %s",i,GetName(i));
				if(PI[i][pAFK] >= 3)
				{
					new str[40];
					format(str, sizeof str, " - {FF6600}AFK: %s", ConvertSeconds(PI[i][pAFK]));
					strcat(global_string, str);
				}
				SendClientMessage(playerid, COLOR_WHITE, global_string);
				ids++;
			}
		}
		if(ids == 0) SendClientMessage(playerid,-1,"Совпадений не найдено");
	}
	return 1;
}

cmd:obnul(playerid, params[])
{
	if(!GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Eduard_Haunted") && !GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Winston")) return 1;
	if(sscanf(params, "s[60]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/obnul [ник игрока]");

	foreach(new i: Player)
	{
		if(GetString(GetName(i), params[0]))
		{
			KickEx(i, "/obnul");
			continue;
		}
	}

	global_string = "";
	mysql_format(db_prod, global_string, 100, "SELECT * FROM WHERE name = '%e'", params[0]);
	mysql_tquery(db_prod, global_string, "CheckPlayerNick", "dsd", playerid, params[0], 0);
	return 1;
}

cmd:vostpass(playerid, params[])
{
	if(!GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Eduard_Haunted") && !GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Winston")) return 1;
	if(sscanf(params, "s[60]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/vostpass [ник игрока]");

	foreach(new i: Player)
	{
		if(GetString(GetName(i), params[0]))
		{
			KickEx(i, "/vostpass");
			continue;
		}
	}

	global_string = "";
	mysql_format(db_prod, global_string, 100, "SELECT * FROM WHERE name = '%e'", params[0]);
	mysql_tquery(db_prod, global_string, "CheckPlayerNick", "dsd", playerid, params[0], 1);
	return 1;
}

cmd:givegun(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "uii", params[0],params[1],params[2])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/givegun [id игрока] [id оружия] [кол-во патронов]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] < 1 || params[1] > 34) return SendClientMessage(playerid, COLOR_GREY, "ID оружия от 1 до 34!");
	if(params[2] > 500 || params[2] < 1 && !g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "Количество патронов от 1 до 500!");

	new tuc;
	for(new i; i < sizeof(prohibited_weapons); i++)
	{
		if(params[1] == prohibited_weapons[i]) tuc++;
	}
	if(tuc && PI[params[0]][pAdmin] < 11 && !g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "ID оружия от 1 до 47!");

	GivePlayerWeapon(params[0], params[1], params[2]);
	global_string = "";
	format(global_string, 128, "[A] Администратор %s(%d) выдал игроку %s(%d) оружие %s (ID: %d | Патроны: %d)", GetName(playerid), playerid, GetName(params[0]), params[0], GunNames[params[1]], params[1], params[2]);
	if(!g_player_full_access[playerid]) SendAdminMessage(COLOR_GREY, global_string);

	SendMes(playerid, COLOR_LIME, "Вы установили игроку %s",GetName(params[0]));
	fLogs("[admin] %s /givegun %s %i %i", GetName(playerid), GetName(params[0]), params[1], params[2]);
	return 1;
}
cmd:vk(playerid, params[]) callcmd::soc(playerid, params);
cmd:soc(playerid, params[])
{
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(!PI[playerid][pPhone][1]) return SendClientMessage(playerid, COLOR_GREY, "У Вас не подключен интернет. Подключить его можно в салоне магазина 24/7");
	if(Phone[playerid] == false) return SendClientMessage(playerid, COLOR_RED, "Телефон выключен. Для включения телефона используйте /togphone");
	if(PhoneInternetStatus[playerid] == false) return SendClientMessage(playerid, COLOR_RED, "Чтобы использовать интернет, необходимо включить передачу данных(/phone)");
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"В тюрьме недоступно!");
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/soc [текст]");
	if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);

	format(string, sizeof(string), "ВКонтакте "cWH"| %s[%d]: %s", GetName(playerid), playerid, params[0]);
	SendSocMessage(0x4a76a8FF, string);

	return 1;
}

cmd:debug(playerid, params[])
{
	if(!g_player_full_access[playerid])
		return true;

	switch(debug_mode)
	{
		case 0:
		{
			debug_mode = 1;
			SendSucc(playerid, "Debug ON");
		}
		case 1:
		{
			debug_mode = 0;
			SendSucc(playerid, "Debug OFF");
		}
	}
	return true;
}

cmd:givemoney(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "ui", params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/givemoney [id игрока] [кол-во денег]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] > 100000000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "Количество денег от 1 до 100000000!");

	SetPlayerMoney(params[0], params[1]);
	SendMes(playerid, COLOR_LIME, "Вы установили денег игроку: %s", GetName(params[0]));
	SendMes(params[0], COLOR_WHITE, ""cPS"Администратор %s выписал Вам чек на %dр", GetName(playerid),params[1]);
	SendClientMessage(params[0], COLOR_WHITE, ""cPS"Деньги были зачислены на ваш баланс");
	fLogs("[admin] %s /givemoney %s %i", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}

cmd:givecredits(playerid, params[])
{
	if(g_player_full_access[playerid] && !GetString(GetName(playerid), "Shame_Overdrive"))		// - buy fd
	{
		if(sscanf(params, "ui", params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/givecredits [id игрока] [кол-во]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);


		if(params[1] > 9999 || params[1] < 1)
			return SendClientMessage(playerid, COLOR_GREY, "Количество от 1 до 9999!");


		format(string, sizeof(string), "Вы перевели %d "SERVER_COINS" на счёт игроку %s", params[1], GetName(params[0]));
		SendClientMessage(playerid, COLOR_GREEN, string);
		format(string, sizeof(string), ""cPS"На Ваш аккаунт поступили денежные средства", params[1]);
		SendClientMessage(params[0], -1, string);
		SendClientMessage(params[0], -1, ""cPS"Чтобы ими воспользоваться, введите /donate");

		format(string, sizeof(string), "UPDATE `accounts` SET credits=%d WHERE name='%s'", PI[params[0]][pPerfectCoins]+params[1], GetName(params[0]));
		mysql_tquery(db_prod, string, "", "");
		PI[params[0]][pPerfectCoins] += params[1];

		PI[playerid][GiveCoin] += params[1];
		MysqlUpdatePlayerInt(playerid, "GiveCoin", PI[playerid][GiveCoin]);

		fLogs("[coin] %s +%i /givecredits %s", GetName(params[0]), params[1], GetName(playerid));
		fLogs("[admin] %s /givecredits %s %i", GetName(playerid), GetName(params[0]), params[1]);
	}
	return 1;
}

cmd:fullaccess(playerid)
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted"))
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		ShowPlayerDialog(playerid, 19005, DIALOG_STYLE_LIST, ""cMain"Управление Full Dostup`ом", "1. Выдать FullDostup администратору\n2. Управление администраторами с FD", "Выбрать", "Отмена");
	}
	return 1;
}

cmd:addblock(playerid, params[])
{
	if(PI[playerid][pLeader] < 1) return 1;
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/addblock [id игрока]");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете добавить себя!");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
