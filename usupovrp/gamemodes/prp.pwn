CMD:back(playerid, params[])
{
	if(!playerOldMpDatan[playerid][2] || PI[playerid][pJailTime]) return SendErr(playerid, "Вам недоступна данная функция");
	playerOldMpDatan[playerid][2] = 0;
	SetPlayerPos(playerid, playerOldMpPosn[playerid][0], playerOldMpPosn[playerid][1], playerOldMpPosn[playerid][2]);
	SetPlayerFacingAngle(playerid, 0.0);
	SetPlayerInterior(playerid, playerOldMpDatan[playerid][1]);
	SetPlayerVirtualWorld(playerid, playerOldMpDatan[playerid][0]);
	SendInf(playerid, "Вы вернулись туда, где были до телепортации");
	return 1;
}

stock GetNumberOfPlayersOnThisIP(test_ip[])
{
	new against_ip[32+1];
	new ip_count = 0;
	foreach(new x : Player)
	{
		if(IsPlayerConnected(x))
		{
			GetPlayerIp(x,against_ip,32);
			if(!strcmp(against_ip,test_ip)) ip_count++;
		}
	}
	return ip_count;
}

callback::OnPlayerPutRaceCar(playerid, carid) PutPlayerInVehicle(playerid, carid, 0);

callback::OnServerLoadKillerData(playerid, type)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return printf("[MYSQL WARNING]: Произошла ошибка при загрузке KILLER DATA");

	new MONEY;
	new OWNER[MAX_PLAYER_NAME];
	new VICTIM[MAX_PLAYER_NAME];
	new DATA_TIME[MAX_PLAYER_NAME];

	if(type == 0)
	{
		STRING_GLOBAL[0] = EOS;
		for(new i = 0; i != rows; i ++)
		{
			MONEY = cache_get_field_content_int(i, "MONEY");
			cache_get_field_content(i, "OWNER", OWNER, db_prod, 24);
			cache_get_field_content(i, "VICTIM", VICTIM, db_prod, 24);
			cache_get_field_content(i, "DATA_TIME", DATA_TIME, db_prod, 24);

			new STATE_VICTIM[35];
			if(GetPlayerID(VICTIM) != 0xFFFF)
			{
				format(STATE_VICTIM, sizeof(STATE_VICTIM), ""cWH"[{FF0000}ID: %d"cWH"]", GetPlayerID(VICTIM));
			}

			new REASON_MONEY = MONEY / 4;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cMain"Заказал: "cWH"%s\t"cMain"Жертва: "cWH"%s%s\t"cMain"Награда: "cWH"%d "cMain"Euro\n", STRING_GLOBAL, OWNER, VICTIM, STATE_VICTIM, (MONEY - REASON_MONEY));
		}
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\n\n"cMain"Для выбора и поиска жертвы введите "cWH"/findkill [id]", STRING_GLOBAL);
		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Заказы", STRING_GLOBAL, "Скрыть", "");
	}
	if(type == 1)
	{
		for(new i = 0; i != rows; i ++)
		{
			cache_get_field_content(i, "OWNER", OWNER, db_prod, 24);
			cache_get_field_content(i, "VICTIM", VICTIM, db_prod, 24);
			MONEY = cache_get_field_content_int(i, "MONEY");

			if(PlayerFixHitman[playerid] == GetPlayerID(VICTIM) && GetPlayerID(VICTIM) != 0xFFFF)
			{
				new REASON_MONEY = MONEY / 4;

				STRING_GLOBAL[0] = EOS;
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы успешно выполнили заказ на убийство %s. Награда: %d EURO", VICTIM, (MONEY - REASON_MONEY));
				SendClientMessage(playerid, 0xFFFF00FF, STRING_GLOBAL);

				if(GetPlayerID(OWNER) != 0xFFFF)
				{
					STRING_GLOBAL[0] = EOS;
					format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Ваш заказ на убийство %s успешно выполнен", VICTIM);
					SendClientMessage(GetPlayerID(OWNER), 0xFFFF00FF, STRING_GLOBAL);
				}
				if(GetPlayerID(VICTIM) != 0xFFFF) PlayerUseVictim[GetPlayerID(VICTIM)] = -1;

				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `hitman` WHERE `OWNER` = '%e' AND `VICTIM` = '%e'", OWNER, VICTIM);
				mysql_tquery(db_prod, STRING_GLOBAL, "", "");

				PlayerFixHitman[playerid] = -1;
				TransferEuro(-1, playerid, ((MONEY / 100) * 75), "Заказ хитманы");
				FracBank[4] -= ((MONEY / 100) * 75);
				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `gang` SET `vagosbank` = '%d'", FracBank[4]);
				mysql_tquery(db_prod, STRING_GLOBAL, "", "");
				return 0x1;
			}
		}
	}
	return 0x1;
}

forward OnServerLoadVipSetting();
public OnServerLoadVipSetting()
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return printf("[MYSQL WARNING]: Произошла ошибка при загрузке V.I.P настроек");

