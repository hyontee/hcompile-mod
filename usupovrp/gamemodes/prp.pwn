DLG(7346, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	switch(listitem)
	{
	case 0:
		{
			stringer1 = ""cWH"Группа ВКонтакте: {68C83B}vk.com/prpcrmp";
			global_string = "{189DDF}Perfect RolePlay "cWH"- это совершенно уникальная и интересная игра\n\
			Мы постарались объединить лучшие элементы ролевой игры с новыми идеями и широкими возможностями для всех игроков. \n\
			Поселившись в одном из городов и став полноправным гражданином, Вы сможете выбрать любимую работу, а может быть открыть свое небольшое дело и иметь постоянный доход. \n\
			А быть может Вам захочется вступить в одну из организаций и начать карьерный рост, пока не достигнете желаемой высоты.\n\
			Играя у нас, Вы получите огромную дозу позитива и бурю эмоций от игрового процесса.\n\n\
			Наш сайт: {68C83B}"SERVER_WEBSITE"\n";

			strcat(global_string, stringer1);
			strcat(global_string, "\n"cWH"Пополнить донат-счет: {68C83B}"PAGE_WEBSITE_DONATE"");
			ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, "{ECDE19}О сервере", global_string, "Закрыть", "");
		}
	case 1:
		{
			ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, "{ECDE19}F.A.Q для новичков", "{ECDE19}Основная терминология Roleplay серверов:\n\
			{A1A1A0}Role-Play "cWH"- (сокращение Rp) Реальная игра, реальное поведение, как в жизни, игра по ролям\n\
			{A1A1A0}Non Role-Play "cWH"- (Сокращение NonRp) Не реальная игра, действие, как данный персонаж не поступил бы в жизни. Нарушение Rp режима\n\n\
			{ECDE19}Администраторские термины, наказания:\n\
			{58BE2C}Админ/Администратор "cWH"- персонаж контролирующий соблюдение правил на сервере, с возможностью наказания.\n\
			{58BE2C}Ban "cWH"- Наказание после которого, игрок, не сможет продолжить игру на сервере.\n\
			{58BE2C}Warn "cWH"- Наказание после которого, игрок будет уволен из организации, и не сможет вступить обратно, или в другую организацию.\n\
			{58BE2C}Kick "cWH"- Окончание игрового сеанса.\n\
			{58BE2C}Бан чата "cWH"- Игрок не сможет писать сообщения в чаты. Дается на 5 мин или более.\n\n\
			{ECDE19}Термины, названия действий игрока:\n\
			{14A2DF}Revenge kill "cWH"- убить игрока, за то что он убил тебя / возвращение на место смерти.\n\
			{14A2DF}Mеtagаming"cWH" - использование OOC информации в IC.\n\
			{14A2DF}Powergaming "cWH"- Воображение из себя супер героя. Пример: драка 1х3\n\
			{14A2DF}Bunnyhopping "cWH"- прыгать, чтобы быстрее передвигаться.\n\
			{14A2DF}Deatmatch "cWH"- (сокращение ДМ) убивать всех подряд без IC причины.\n\
			{14A2DF}DriveBy "cWH"- (Сокращение ДБ) Убийство машиной или с расстрел с водительского места.\n\
			{14A2DF}Spawn kill "cWH"- Убийство на респауне (на месте появления).\n\
			{14A2DF}Team kill "cWH"- Убийство члена своей команды, фракции.\n\
			{14A2DF}Сharacter kill (Сокращение CK) "cWH"- убийство, с целью полностью ликвидировать какого-либо персонажа, участвующего в игре. \n\
			"cWH"Другими словами - убийство с целью по Rp расстаться с человеком. Ярким примером служит увольнение из мафии. Является частью отыгрывания Rp. Не приветствуется администрацией!\n\
			{14A2DF}FastReload "cWH"- Баг с быстрой перезарядкой.\n\
			{14A2DF}RepeatKill "cWH"- Намеренное ,повторное убийство одного и того же игрока.\n\
			{14A2DF}Willihopping "cWH"- Это прыжок с вылосипеда, мопеда, мотоцикла.Поестеству даже с велика прыгнуть страховато как 'Си Джей'.\n\
			{14A2DF}Fastmoving "cWH"- Баг с быстрым перемещением.\n\n\
			{ECDE19}Остальные термины:\n\
			{F93232}OOC (Out Of Character) "cWH"- это все, что касается реального мира. (пишется в /b чат)\n\
			{F93232}IC (In Character) "cWH"- это все, что касается виртуального мира, то есть игры. (пишется в обычный чат)\n\
			{F93232}AFK "cWH"- Away From Keyboard - Отошел от клавиатуры.\n\
			{F93232}Role-Play Nickname "cWH"- ник в формате: Имя_Фамилия. Пример: David_Marlboro.\n\
			{F93232}Фракция "cWH"- Организация, банда, мафия и т.д. Пример: Зона 51, LS News.\n\
			{F93232}Newbie (Noob) "cWH"- новичок, игрок непонимающий сути игры RP, игрок не умеющий играть. На игровом сленге - 'Нуб'\n\
			{F93232}Spawn (ReSpawn) "cWH"- Место появления персонажа на сервере. На игровом сленге - 'Респ'", "Закрыть", "");
		}
	}
	return 1;
}
DLG(18012, playerid, response, listitem, inputtext[])
{
	if(!response) return ClearHelicopterData(playerid);
	if(AeroportStatus[listitem] != false) return SendClientMessage(playerid, COLOR_RED, "Данное место для взлета занято, выберите другое!"), ClearHelicopterData(playerid);

	AeroportStatus[listitem] = true;
	AeroportPlayer[listitem] = playerid;

	PI[playerid][HelicopterID] = CreateVehicle(H_DATA[playerid][h_model], AeroportRandomSpawn[listitem][0], AeroportRandomSpawn[listitem][1], AeroportRandomSpawn[listitem][2], AeroportRandomSpawn[listitem][3], H_DATA[playerid][h_color], -1, 90000);
	CarDoorsEx(PI[playerid][HelicopterID], H_DATA[playerid][h_lock]);
	Fuel[PI[playerid][HelicopterID]] = 999;
	SetVehicleHealth(PI[playerid][HelicopterID], 1000);
	SetVehicleVirtualWorld(PI[playerid][HelicopterID], 0);
	Engine[PI[playerid][HelicopterID]] = Lights[PI[playerid][HelicopterID]] = false;
	SendClientMessage(playerid, COLOR_GREEN, "Вертолет успешно загружен на сервер. Он находится на выбранном месте.");
	SendClientMessage(playerid, COLOR_GREEN, "Для поиска вертолета можно использовать /findcopter .");
	return 1;
}
DLG(136, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(arenda_took[playerid] != 0) return SendClientMessage(playerid, -1, "Вы уже арендовали свой мопед");
	if(check_arenda_moped[playerid]) return 1;
	if(GetPlayerRubble(playerid) < 5000) return SendClientMessage(playerid, COLOR_RED, "Недостаточно средств");
	SetPlayerMoney(playerid, -5000);
	new Float:x,Float:y,Float:a,Float:z;
	GetPlayerPos(playerid,x,y,z);
	GetPlayerFacingAngle(playerid,a);

	arenda_took[playerid] = CreateVehicle(448, x,y,z,a, 1,1, 300);
	CarDoorsEx(arenda_took[playerid], 0);
	new engines,lightss,alarms,doorss,bonnets,boots,objectives;
	GetVehicleParamsEx(arenda_took[playerid],engines,lightss,alarms,doorss,bonnets,boots,objectives);
	Fuel[arenda_took[playerid]] = 45;
	PutPlayerInVehicle(playerid,arenda_took[playerid],0);
	SetVehicleParamsEx(arenda_took[playerid],0,0,alarms,doorss,bonnets,boots,objectives);
	check_arenda_moped[playerid] = 1;
	SendClientMessage(playerid,COLOR_GREY,"Вам был выдан мопед!");
	return 1;
}
DLG(6363, playerid, response, listitem, inputtext[])
{
	if(!response) return true;
	if(PB_COUNTPLAYERS() >= MAX_PBPLAYER-1) return SendClientMessage(playerid,COLOR_GREY,"Все билеты на регистрацию закончились.");
	if(GetPlayerRubble(playerid) < 30000) return SendClientMessage(playerid,COLOR_GREY,"У Вас недостаточно денег. Для регистрации необходимо 30.000 руб.");
	new slot = PB_GETSLOTPLAYER(playerid);
	if(slot != -1) return SendClientMessage(playerid,COLOR_GREY,"Вы уже зарегистрированы на мероприятие 'Мясорубка'. Дождитесь его начала..");
	PBP_PLAYERIDS[PB_GETSLOT()] = playerid;
	PBP_BANK += 30000;
	SetPlayerMoney(playerid, -30000);
	PBP_PLAYERS++;
	SendClientMessage(playerid,COLOR_GREEN,"Вы успешно зарегестрировались на мероприятие 'Мясорубка'");
	SendClientMessage(playerid,COLOR_RED,"Если Вы отойдете далеко от места регистрации,то Вы будете дисквалифицированы.");
	return 1;
}
DLG(2836, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!listitem)
	{
		if(PI[playerid][HelicopterID] != INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Вертолет уже загружен и его нельзя загрузить повторно");
		format(stringer1, 128, "SELECT * FROM `helicopters` WHERE h_owner = '%s'", GetName(playerid));
		mysql_tquery(db_prod, stringer1, "LoadHelicopter", "i", playerid);
		return 1;
	}
	if(PI[playerid][HelicopterID] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Ошибка: вертолет не загружен");
	H_DATA[playerid][h_timer] = unix + 900;
	DestroyHelicopter(playerid);
	SendClientMessage(playerid, COLOR_GREEN, "Вертолет успешно выгружен с сервера");
	return 1;
}
DLG(6673, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	format(stringer1, 128, "SELECT `c_owner` FROM `ownable_cars` WHERE c_owner = '%s'", GetName(to_player_sell_car[playerid]));
	mysql_tquery(db_prod, stringer1, "SELLCAR_G","ii",playerid,GetPlayerListitemValue(playerid, listitem));
	return 1;
}
DLG(7734, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	new car_model = GetPlayerListitemValue1(playerid, listitem);

	SendMes(playerid, 0x66BE5EFF, "Вы выбрали автомобиль: {EA8F08}%s(%d) {66BE5E}для обмена, теперь выбирает другой игрок. Ожидайте..", VehicleNames[car_model-400], car_model);
	SendMes(playerid, COLOR_LIGHTBLUE, "Вы предложили обменяться транспортами с %s. Доплата игрока: %d", GetName(CarPlayer[playerid]), CarPrice[playerid]);
	SendMes(CarPlayer[playerid], COLOR_LIGHTBLUE, "%s предложил обменяться транспортами с вами. Ваша доплата: %d", GetName(playerid), CarPrice[playerid]);

	SendMes(playerid,-1,"Вы успешно предложили обменять транспорт, игроку предложено доплатить %d для обмена", CarPrice[playerid]);
	SendMes(CarPlayer[playerid], 0xFA5AF2FF, "Автомобиль %s(%s)", GetName(playerid), VehicleNames[car_model-400], g_player_listitem2[playerid][listitem], CarPrice[playerid]);
	SendClientMessage(CarPlayer[playerid], 0xFA5AF2FF, "{35D832}Согласиться - /acceptchangecar, {FC4148}отказаться - /deniedchangecar");
	SendClientMessage(playerid, 0xFA5AF2FF, "{FC4148}отказаться - /cancelcar");

	new car_id_ = GetPlayerListitemValue(playerid, listitem);

	cars_id[ CarPlayer[playerid] ] = car_id_;

	change_car_time[playerid] = unix + 60;

	obcar_status[ CarPlayer[playerid] ] = 1;

	obmen_status[playerid] = 1;
	return 1;
}
DLG(2672, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!listitem)
	{
		format(stringer1, 128, "SELECT * FROM `ownable_cars` WHERE c_owner = '%s'", GetName(playerid));
		mysql_tquery(db_prod, stringer1, "fixcar_C","i",playerid);
		return 1;
	}

	new
		count;

	global_string[0] = EOS;

	for(new i; i < MAX_LOAD_VEHICLE; i++)
	{
		if(PlayerVehicle[playerid][i] != INVALID_PLAYER_VEHICLE)
		{
			format(global_string, sizeof(global_string), "%s"cWH"%s\n", global_string, VehicleNames[GetVehicleModel(PlayerVehicle[playerid][i])-400]);
			SetPlayerListitemValue(playerid, count, PlayerVehicleSQL[playerid][i]);
			count ++;
		}
	}
	if(!count)
		SendErr(playerid, "Нет загруженных автомобилей");

	ShowPlayerDialog(playerid, 2414, DIALOG_STYLE_LIST, !""cMain"Загруженный транспорт", global_string, !"Выгрузить", !"Закрыть");
	return 1;
}
DLG(13467, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;

	car_id[playerid] = GetPlayerListitemValue(playerid, listitem);

	if(debug_mode)
	{
		format(String144, sizeof(String144), "[debug] carid: {999999}%i", car_id[playerid]);
		SendClientMessage(playerid, -1, String144);
	}
	new
		status,
		query[256];

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", car_id[playerid]);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();
	if(rows > 0)
	{
		status = cache_get_field_content_int(0, "c_status");
	}
	cache_delete(result);

	if(status != 0)
		return SendErr(playerid, "Автомобиль уже загружен");

	format(stringer1, 128, "SELECT * FROM `ownable_cars` WHERE c_owner = '%s' AND id = '%d' LIMIT 1", GetName(playerid), car_id[playerid]);
	mysql_tquery(db_prod, stringer1, "LoadPlayerCar", "i", playerid);
	return 1;
}

DLG(2414, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;
	new
		id = GetPlayerListitemValue(playerid, listitem);

	if(debug_mode)
	{
		format(String144, sizeof(String144), "[debug] carid: {999999}%i", id);
		SendClientMessage(playerid, -1, String144);
	}

	for(new i; i < MAX_LOAD_VEHICLE; i++)
	{
		if(PlayerVehicleSQL[playerid][i] == id)
		{
			DestroyPlayerVehicle(playerid, i);
			SendSucc(playerid, "Транспорт выгружен");
			break;
		}
	}
	return true;
}

DLG(7336, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(GetPlayerData(playerid, SalonCarID) != INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Системная ошибка, перезайдите на сервер");

	for(new i; i < 7; i++) TextDrawShowForPlayer(playerid, ashop_TD[i]);
	for(new i; i < 2; i++) PlayerTextDrawShow(playerid, ashop_PTD[playerid][i]);
	SelectTextDrawEx(playerid, 0xCCCCCCCC);

	pPressed[playerid] = 0;
	HelicopterColor[playerid] = 0;
	SetPlayerData(playerid, SalonCarID, CreateVehicle(carsH[pPressed[playerid]][0],1462.5294, 1712.7496, 15.4801, HelicopterColor[playerid],-1,10000));
	CarDoorsEx(carsH[pPressed[playerid]][0], 0);

	SetPlayerPos(playerid,-101.2753, -1005.1133, 47.4599);
	SetPlayerFacingAngle(playerid,101.9068);
	TogglePlayerControllable(playerid,false);
	SetPlayerVirtualWorld(playerid, playerid);
	SetVehicleVirtualWorld(GetPlayerData(playerid, SalonCarID),playerid);
	PutPlayerInVehicle(playerid,GetPlayerData(playerid, SalonCarID),0);

	SetPlayerCameraPos(playerid, 1468.7054, 1721.9009, 16.8956);
	SetPlayerCameraLookAt(playerid, 1468.0685, 1721.1079, 16.7903);

	stringer1 = "";
	format(stringer1, sizeof(stringer1), "%dР",carsH[pPressed[playerid]][1]);
	PlayerTextDrawSetString(playerid, ashop_PTD[playerid][1], stringer1);

	stringer1 = "";
	format(stringer1, sizeof(stringer1), "%s", VehicleNames[carsH[pPressed[playerid]][0]-400]);
	PlayerTextDrawSetString(playerid, ashop_PTD[playerid][0], stringer1);

	ChangeVehicleColor(GetPlayerData(playerid, SalonCarID), HelicopterColor[playerid], -1);
	InShop[playerid] = 2;
	return 1;
}
