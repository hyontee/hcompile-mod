SetPlayerInteriorEx(playerid, inter)
{
	if(inter != 0)
	{
		playerNoTimeUpdate[playerid] = true;
		SetPlayerTime(playerid, 23, 00);
	}
	else
	{
		playerNoTimeUpdate[playerid] = false;
		SetPlayerTime(playerid, hour, minute);
	}

	SetPlayerInterior(playerid, inter);
}
