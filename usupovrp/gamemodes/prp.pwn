			{
				format(str, sizeof(str), ""cWH"%s\t%d\n", (PhoneNumbers[playerid][i]) ? GetNameWithNumber(PhoneNumbers[playerid][i]) : ("Offline/None"), PhoneNumbers[playerid][i]);
