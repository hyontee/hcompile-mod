ShowFrakVehicle(playerid, frak)
{
	stringer = ""cWH"";
	new tmp, id;
	for(new i; i < 50; i++)
	{
		id = frakVehicleCount[frak][i];
		if(id)
		{
			playerTempFrakVeh[playerid][tmp++] = id;
			format(stringer, sizeof(stringer), "%s%s\n", stringer, (VehInfo[id][vModel]) ? (VehicleNames[VehInfo[id][vModel]-400]) : ("Пусто"));
		}
	}
	SPD(playerid, 7245, DIALOG_STYLE_LIST, ""cMain"Транспорт", stringer, "Выбрать", "Назад");
	return 1;
}
DLG(7245, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::lpanel(playerid);
	new frak = PI[playerid][pMember];
	playerTempFrakVehList[playerid] = listitem;

	stringer = ""cWH"";
	for(new i; i < 10; i++) { if(Fraction_Vehicle[frak][i]) format(stringer, sizeof(stringer), "%s%s\n", stringer, VehicleNames[Fraction_Vehicle[frak][i]-400]); }
	strcat(stringer, "Удалить");
	SPD(playerid, 6798, DIALOG_STYLE_LIST, ""cMain"Транспорт", stringer, "Выбрать", "Назад");
	return 1;
}
DLG(6798, playerid, response, listitem, inputtext[])
{
	if(!response) return ShowFrakVehicle(playerid, PI[playerid][pMember]);
	new list = playerTempFrakVeh[playerid][playerTempFrakVehList[playerid]];

	SaveMileage();
	if(VehInfo[list][vVehicle] != INVALID_VEHICLE_ID)
	{
		DestroyVehicle(VehInfo[list][vVehicle]);
		VehInfo[list][vVehicle] = INVALID_VEHICLE_ID;
	}
	if(!strcmp(inputtext, "Удалить")) VehInfo[list][vModel] = 0;
	else
	{
		VehInfo[list][vModel] = Fraction_Vehicle[PI[playerid][pMember]][listitem];
		VehInfo[list][vVehicle] = CreateVehicle(VehInfo[list][vModel], VehInfo[list][vPos_X], VehInfo[list][vPos_Y], VehInfo[list][vPos_Z], VehInfo[list][vPos_FA], VehInfo[list][vColor][0], VehInfo[list][vColor][1], 900);
		LinkVehicleToInterior(VehInfo[list][vVehicle], VehInfo[list][vInt]);
		SetVehicleVirtualWorld(VehInfo[list][vVehicle], VehInfo[list][vWorld]);
		vehicle_mileage[VehInfo[list][vVehicle]] = VehInfo[list][vMileage];
	}
	format(global_string, sizeof(global_string), "UPDATE vehicle SET model = '%d' WHERE id = '%d'", VehInfo[list][vModel], VehInfo[list][vID]);
	mysql_tquery(db_prod, global_string);

	ShowFrakVehicle(playerid, PI[playerid][pMember]);
	return 1;
}

PlayerToFamilySquare(playerid, lobby)
{
	new Float:pos_x, Float:pos_y, Float:pos_z;
	GetPlayerPos(playerid, pos_x, pos_y, pos_z);
	if(glFamilyCaptPosY[lobby][0] < pos_y < glFamilyCaptPosY[lobby][2] && glFamilyCaptPosX[lobby][3] < pos_x < glFamilyCaptPosX[lobby][1]) return 1;
	return 0;
}
CreateFamilySquare(lobby, Float:size = 50.0)
{
	new Float:pos_a, Float:pos_x0, Float:pos_y0, Float:pos_x1, Float:pos_y1;
	nfor(i, 4)
	{
		new Float:pos_x = glFamilyCaptPos[lobby][0] - (-size * floatsin(pos_a, degrees));
		new Float:pos_y = glFamilyCaptPos[lobby][1] - (size * floatcos(pos_a, degrees));
		glFamilyCaptPosX[lobby][i] = pos_x;
		glFamilyCaptPosY[lobby][i] = pos_y;
		switch(i)
		{
			case 0: glFamilyCaptZone[lobby][i] = GangZoneCreate(
					(pos_x0 = pos_x - (-size * floatsin(270.0, degrees))),
					(pos_y0 = pos_y - (size * floatcos(90.0, degrees))) - 5.0,
					pos_x - (-size * floatsin(90.0, degrees)),
					pos_y - (size * floatcos(270.0, degrees)) + 5.0);
			case 2: glFamilyCaptZone[lobby][i] = GangZoneCreate(
					pos_x - (-size * floatsin(270.0, degrees)),
					pos_y - (size * floatcos(90.0, degrees)) - 5.0,
					(pos_x1 = pos_x - (-size * floatsin(90.0, degrees))),
					(pos_y1 = pos_y - (size * floatcos(270.0, degrees))) + 5.0);
			case 1: glFamilyCaptZone[lobby][i] = GangZoneCreate(
					pos_x - (-size * floatsin(180.0, degrees)) - 5.0,
					pos_y - (size * floatcos(0.0, degrees)),
					pos_x - (-size * floatsin(0.0, degrees)) + 5.0,
					pos_y - (size * floatcos(180.0, degrees)));
			case 3: glFamilyCaptZone[lobby][i] = GangZoneCreate(
					pos_x - (-size * floatsin(180.0, degrees)) - 5.0,
					pos_y - (size * floatcos(0.0, degrees)),
					pos_x - (-size * floatsin(0.0, degrees)) + 5.0,
					pos_y - (size * floatcos(180.0, degrees)));
		}
		pos_a += 90.0;
	}
	glFamilyCaptZone[lobby][4] = GangZoneCreate(pos_x0, pos_y0, pos_x1, pos_y1);
	return 1;
}

DLG(6321, playerid, response, listitem, inputtext[])
{
	new idin = PI[playerid][pFamily];
	if(!response || !idin) return 1;

	new idfm = playerFamilyCaptFam[playerid];
	if(glFamilyCaptActive[idfm]) return SCM(playerid, -1, ""cER"Семья противника уже участвует в разборке");
	if(glFamilyCaptActive[PI[playerid][pFamily]]) return SCM(playerid, -1, ""cER"Ваша семья уже участвует в разборке");

	new tmp;
	foreach(Player, id) if(PI[id][pFamily] == idin) tmp++;
	if(tmp < 3) return SCM(playerid, -1, ""cER"В вашей семье должно быть не менее 3 игроков");
	tmp = 0;
	foreach(Player, id) if(PI[id][pFamily] == idfm) tmp++;
	if(tmp < 3) return SCM(playerid, -1, ""cER"В семье противника должно быть не менее 3 игроков");

	new ider = -1;
	for(new i; i < sizeof(glFamilyCaptPos); i++) if(!glFamilyCaptBusy[i]) ider = i;
	if(ider == -1) return SCM(playerid, -1, ""cER"Все места проведения разборок заняты");
	glFamilyCaptBusy[ider] = 1;


	format(stringer, sizeof(stringer), "Семья %s устроила с вами разборку, прибудьте на место встречи которое обозначено на карте. Сумма за разборку %d евро", family_info[idin][f_name], gFamilyCaptMoney[idin]);
	foreach(Player, id)
	{
		if(PI[id][pFamily] == idfm)
		{
			SCM(id, -1, stringer);
		}
	}
	format(stringer, sizeof(stringer), "%s[%i] устроил разборку с семьей %s, прибудьте на место встречи которое обозначено на карте. Сумма за разборку %d евро", PI[playerid][pName], playerid, family_info[idfm][f_name], gFamilyCaptMoney[idin]);
	foreach(Player, id)
	{
		if(PI[id][pFamily] == idin)
		{
			SCM(id, -1, stringer);
		}
	}
	foreach(Player, targetid)
	{
		if(PI[targetid][pFamily] == idin || PI[targetid][pFamily] == idfm)
		{
			playerCreateCaptTD[targetid] = 0;
			for(new i; i < 4; i++) GangZoneShowForPlayer(targetid, glFamilyCaptZone[ider][i], 0x6A5ACDFF);
			GangZoneShowForPlayer(targetid, glFamilyCaptZone[ider][4], 0x6A5ACD25);

			SetPlayerMapIcon(targetid, 99, glFamilyCaptPos[ider][0], glFamilyCaptPos[ider][1], 0.0, 0, 0, MAPICON_GLOBAL);
		}
	}
	glFamilyCaptCount[idfm] =
	glFamilyCaptCount[idin] = 0;
	glFamilyCaptActive[idfm] =
	glFamilyCaptActive[idin] = 1;
	glFamilyCaptIder[idfm] =
	glFamilyCaptIder[idin] = ider;
	gFamilyCaptMoney[idfm] = gFamilyCaptMoney[idin];
	glFamilyCaptPidor[idfm] = idin;
	glFamilyCaptPidor[idin] = idfm;

	glFamilyCaptTime[idin] = 600;
	glFamilyCaptTimer[idin] = SetTimerEx("FamilyCaptTimer", 1000, 1, "ii", idin, idfm);
	return 1;
}

callback::FamilyCaptTimer(idin, idfm)
{
	if(--glFamilyCaptTime[idin] <= 0)
	{
		family_info[idfm][f_fight] += 1;
		family_info[idin][f_fight] += 1;
		new win, lose;
		if(glFamilyCaptCount[idfm] == glFamilyCaptCount[idin])
		{
			new count[2];
			foreach(Player, id)
			{
				if(PI[id][pFamily] == idfm) count[0]++;
				if(PI[id][pFamily] == idin) count[1]++;
			}
			if(count[0] >= count[1])
			{
				win = idfm;
				lose = idin;
			}
			else
			{
				win = idin;
				lose = idfm;
			}
		}
		else
		{
			if(glFamilyCaptCount[idfm] > glFamilyCaptCount[idin])
			{
				win = idfm;
				lose = idin;
			}
			else
			{
				win = idin;
				lose = idfm;
			}
		}
		family_info[lose][f_rating] += glFamilyCaptCount[lose];
		family_info[win][f_rating] += glFamilyCaptCount[win];
		family_info[win][f_euro] += gFamilyCaptMoney[win];
		family_info[lose][f_euro] -= gFamilyCaptMoney[win];
		family_info[win][f_victory] += 1;

		format(stringer1, 144, ""cWH"Вы показали семье %s что с вами не нужно шутить[+ ЧСВ]. К вам в общак упало %d евро", family_info[lose][f_name], gFamilyCaptMoney[win]);
		format(stringer, 144, ""cWH"Вы облажались, семья %s зачислила вас в отряд неудачников, с вашего общака снято %d евро", family_info[win][f_name], gFamilyCaptMoney[win]);

		foreach(Player, id)
		{
			if(PI[id][pFamily] == win) SCM(id, -1, stringer1);
			if(PI[id][pFamily] == lose) SCM(id, -1, stringer);
		}

		OnServerUpdateFamilyData("fam_rating", family_info[idin][f_rating], idin);
		OnServerUpdateFamilyData("fam_rating", family_info[idin][f_rating], idfm);

		OnServerUpdateFamilyData("fam_euro", family_info[idin][f_euro], idin);
		OnServerUpdateFamilyData("fam_euro", family_info[idin][f_euro], idfm);

		OnServerUpdateFamilyData("fam_victory", family_info[idin][f_victory], idin);
		OnServerUpdateFamilyData("fam_victory", family_info[idin][f_victory], idfm);

		OnServerUpdateFamilyData("fam_fight", family_info[idin][f_fight], idin);
		OnServerUpdateFamilyData("fam_fight", family_info[idin][f_fight], idfm);
		foreach(Player, targetid)
		{
			if(PI[targetid][pFamily] == idin || PI[targetid][pFamily] == idfm)
			{
				RemovePlayerMapIcon(targetid, 99);
				for(new i = 0; i < 5; i ++) SendDeathMessageToPlayer(targetid, 1001, 1001, 200);
				for(new i = 0; i < 16; i ++) PlayerTextDrawDestroy(targetid, perfect_fcapture_TD[targetid][i]);
			}
		}
		for(new i; i < 5; i++) GangZoneHideForAll(glFamilyCaptZone[glFamilyCaptIder[idin]][i]);
		glFamilyCaptBusy[glFamilyCaptIder[idin]] =
		glFamilyCaptActive[idfm] =
		glFamilyCaptActive[idin] = 0;
		KillTimer(glFamilyCaptTimer[idin]);
		return;
	}
	foreach(Player, id) if(PI[id][pFamily] == idin || PI[id][pFamily] == idfm)
	{
		if(!playerCreateCaptTD[id])
		{
			playerCreateCaptTD[id] = 1;
			CreateFamCaptTextDraw(id);
		}
		PlayerTextDrawSetString(id, perfect_fcapture_TD[id][4], family_info[idin][f_name]);
		PlayerTextDrawSetString(id, perfect_fcapture_TD[id][1], family_info[idfm][f_name]);

		valstr(stringer, glFamilyCaptCount[idin]);
		PlayerTextDrawSetString(id, perfect_fcapture_TD[id][5], stringer);
		valstr(stringer, glFamilyCaptCount[idfm]);
		PlayerTextDrawSetString(id, perfect_fcapture_TD[id][3], stringer);

		stringer1 = "";
		strcat(stringer1, ConvertSeconds(glFamilyCaptTime[idin]));
		PlayerTextDrawSetString(id, perfect_fcapture_TD[id][15], stringer1);
		for(new i; i < 16; i++) PlayerTextDrawShow(id, perfect_fcapture_TD[id][i]);
	}
}

CMD:bottle(playerid, params[])
{
	if(TYPE_VIP[playerid] == VIP_STATE_NONE) return 0x1;
	if(VipData[TYPE_VIP[playerid]][VipBottle] == 0) return 0x1;
	playerActiveBottle[playerid] = !playerActiveBottle[playerid];
	if(playerActiveBottle[playerid])
	{
		SendClientMessage(playerid, -1, "Вы успешно достали бутылку из кармана");
		SendClientMessage(playerid, -1, "Что бы сесть на бутылку нажмите клавишу "cMain"[C]");
	}
	else
	{
		playerInBottle{playerid} = 0;
		RemovePlayerAttachedObject(playerid, 9);
		SCM(playerid, -1, "Вы успешно спрятали бутылку в карман");
	}
	return 1;
}

SendLogs(text[])
{
	new
		query[2048];

	mysql_format(db_prod, query, sizeof(query), "INSERT INTO `nlogs` (`text`, `date`) VALUES ('%e', '%i.%i.%i - %i:%i:%i')", text, day, month, year, hour, minute, second);
	mysql_pquery(db_prod, query);
	return 1;
}
CMD:logs(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(!g_player_full_access[playerid]) return 1;
	fLogs("[admin] %s /logs", GetName(playerid));
	new data0[32], data1[32];
	sscanf(params, "s[32]s[32]", data0, data1);
	if(!data0[0]) return SCM(playerid, -1, "Используйте: /logs [запрос] [доп. запрос (по надобности)]");
	playerCheckLogPage[playerid] = 0;
	CheckLogStock(playerid, data0, data1);
	return 1;
}
CheckLogStock(playerid, text0[], text1[])
{
	mysql_escape_string(text0, playerCheckLogData0[playerid]);
	if(text1[0]) mysql_escape_string(text1, playerCheckLogData1[playerid]);
	else playerCheckLogData1[playerid] = "";

	sqltext = "SELECT `text`, `date` FROM `nlogs` WHERE `text` LIKE '%";
	strcat(sqltext, text0);
	strcat(sqltext, "%'");
	if(text1[0])
	{
		strcat(sqltext, " AND `text` LIKE '%");
		strcat(sqltext, text1);
		strcat(sqltext, "%'");
	}
	format(sqltext, sizeof(sqltext), "%s ORDER BY `id` DESC LIMIT %i, 15", sqltext, (playerCheckLogPage[playerid] * 15));
	mysql_tquery(1, sqltext, "CheckLogCallBack", "i", playerid);
}
callback::CheckLogRefresh(playerid)
{
	playerCheckLogPage[playerid]--;
	CheckLogStock(playerid, playerCheckLogData0[playerid], playerCheckLogData1[playerid]);
}
callback::CheckLogCallBack(playerid)
{
	new rows = cache_num_rows(), page = playerCheckLogPage[playerid];
	if(!rows)
	{
		if(page) SetTimerEx("CheckLogRefresh", 100, 0, "i", playerid);
		SCM(playerid, -1, "Данные не найдены");
		return 1;
	}
	sqltext = ""cWH"";
	new data[24];
	for(new i; i < rows; i++)
	{
		cache_get_field_content(i, "date", data);
		cache_get_field_content(i, "text", stringer);
		format(sqltext, sizeof(sqltext), "%s%s\t%s\n", sqltext, data, stringer);
	}

	strcat(sqltext, "-----------------\n");
	strcat(sqltext, "Следующая страница\n");
	if(page) strcat(sqltext, "Предыдущая страница");
	format(stringer, sizeof(stringer), "Страница: %i", (page + 1));
	SPD(playerid, 8932, DIALOG_STYLE_LIST, stringer, sqltext, "Выбрать", "Закрыть");
	return 1;
}
DLG(8932, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!strcmp(inputtext, "-----------------")) return SPD(playerid, 8324, DIALOG_STYLE_INPUT, "Страница", ""cWH"Укажите нужную страницу", "Выбрать", "Назад");
	if(!strcmp(inputtext, "Следующая страница")) playerCheckLogPage[playerid]++;
	else if(!strcmp(inputtext, "Предыдущая страница")) playerCheckLogPage[playerid]--;
	CheckLogStock(playerid, playerCheckLogData0[playerid], playerCheckLogData1[playerid]);
	return 1;
}
DLG(8324, playerid, response, listitem, inputtext[])
{
	new id = strval(inputtext);
	if(response && (0 <= id <= 800000000)) playerCheckLogPage[playerid] = id;
	CheckLogStock(playerid, playerCheckLogData0[playerid], playerCheckLogData1[playerid]);
	return 1;
}

