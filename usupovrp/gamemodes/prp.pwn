				if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1) return SendClientMessage(playerid, -1, ""cER"Данная операция недоступна с данным счетом");
				ShowPlayerDialog(
				playerid, 7341, DIALOG_STYLE_LIST,
