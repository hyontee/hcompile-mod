				format(string,256,""cWH"Квартира №"cMain"%d\n\n"cWH"Владелец:\t{9ACD32}%s %s\n"cWH"Класс:\t"cMain"%d",idx,RoomsInfo[idx][rOwner],ttextt,RoomsInfo[idx][rType]);
				return ShowPlayerDialog(playerid, 8050+2, 0,""cMain"Квартира",string,"Войти","Отмена");
			}
		}

		if(IsPlayerInRangeOfPoint(playerid,2.0,RoomsInfo[idx][rExitX],RoomsInfo[idx][rExitY],RoomsInfo[idx][rExitZ]) &&  GetPlayerVirtualWorld(playerid) == RoomsInfo[idx][rExitV])
		{
			if(RoomsInfo[idx][rLock] == 1)
			{
				if(strcmp(PI[playerid][pName], RoomsInfo[idx][rOwner], true) == 0) ShowPlayerDialog(playerid, 8050+6, 0, "Квартира", "Ваш дом закрыт\n\nВы хотите его открыть?", "Да", "Нет");
				GameTextForPlayer(playerid, "~r~закрыто", 5000, 1);
			}
			else
			{
				SetPlayerPos(playerid,RoomsInfo[idx][rX],RoomsInfo[idx][rY],RoomsInfo[idx][rZ]);
				SetPlayerInterior(playerid,RoomsInfo[idx][rI]);
				SetPlayerVirtualWorld(playerid,RoomsInfo[idx][rV]);
			}
			return 1;
		}
	}
	return 1;
}

public OnVehicleMod(playerid, vehicleid, componentid)
{
	switch(componentid)
	{
	case 1008..1010: if(IsPlayerInInvalidNosVehicle(playerid)) RemoveVehicleComponent(vehicleid, componentid);
	}
	if(!IsComponentidCompatible(GetVehicleModel(vehicleid), componentid)) RemoveVehicleComponent(vehicleid, componentid);
	return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
	if(playertextid == PlayerText:INVALID_TEXT_DRAW)
	{
		if(gSelectColor[playerid] != EOS)
		{
			if(dl_playerDialogID[playerid] == -1) SelectTextDraw(playerid,gSelectColor[playerid]);
		}
		return 1;
	}
	RouletteClickTextDraw(playerid, PlayerText:playertextid);

	new picked_dcb;
	for(new i = 29; i <= 36; i++)
	{
		picked_dcb++;
		if(playertextid == donat_cars_PTD[playerid][i])
		{
			new picked = (picked_dcb+((page_DCB[playerid]-1)*DCB_MAX_ITEM_LIST) -1);

			selectcar_DCB[playerid] = 0;

			if(picked < ITEM_DONATE_CARS)
			{
				selectcar_DCB[playerid] = picked;
				SendFormatInf(playerid, "Вы выбрали автомобиль "cMain"%s"cWH" за %d KC. Для покупки нажмите 'ПРИОБРЕСТИ'!", VehicleNames[gDonateCars[selectcar_DCB[playerid]]-400], gDonatePrice[selectcar_DCB[playerid]]);
			}
		}
	}

	if(playertextid == donat_cars_PTD[playerid][4])
	{
		if(!pagelimit_DCB[playerid])
		{
			page_DCB[playerid]++;
			Update_DonateCarBuy(playerid);
		}
	}

	if(playertextid == donat_cars_PTD[playerid][3])
	{
		if(page_DCB[playerid] > 1)
		{
			page_DCB[playerid]--;
			pagelimit_DCB[playerid] = false;
			Update_DonateCarBuy(playerid);
		}
	}

	if(playertextid == donat_cars_PTD[playerid][2]) Hide_DonateCarBuy(playerid);

	if(playertextid == donat_cars_PTD[playerid][1])
	{
		if(selectcar_DCB[playerid] > 0)// Дописать
		{
			if(PI[playerid][pPerfectCoins] < gDonatePrice[selectcar_DCB[playerid]]) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");

			SPD(
				playerid,
				122412,
				DIALOG_STYLE_LIST,
				!""cMain"Выберите пункт",
				!""cMain"1. "cWH"Купить личный автомобиль\n\
				"cMain"2. "cWH"Купить семейный автомобиль",
				!"Купить", !"Отмена");
		}
		else SendClientMessage(playerid, -1, ""cMain"'Магазин донат автомобилей'"cWH" - Для продолжения покупки выберите транспорт");
	}
	if(playertextid == reg_PTD[playerid][1])
	{
		if(regstatus{playerid} == false) return KickEx(playerid, "not reg");

		PI[playerid][pSex] = 1;
		REG_SEX[playerid] = 1;

		PlayerTextDrawColor(playerid, reg_PTD[playerid][1], 0xFF6600FF);
		PlayerTextDrawColor(playerid, reg_PTD[playerid][2], -1);
		return true;
	}
	if(playertextid == reg_PTD[playerid][2])
	{
		if(regstatus{playerid} == false) return KickEx(playerid, "not reg2");

		PI[playerid][pSex] = 2;
		REG_SEX[playerid] = 1;

		PlayerTextDrawColor(playerid, reg_PTD[playerid][2], 0xFF6600FF);
		PlayerTextDrawColor(playerid, reg_PTD[playerid][1], -1);
		return true;
	}
	if(playertextid == TD_NUMBER_PD[playerid][10]) // Закрыть
	{
		for(new i = 0; i != 12; i ++) PlayerTextDrawHide(playerid, TD_NUMBER_PD[playerid][i]);
		CancelSelectTextDrawEx(playerid);
		return 0x1;
	}


	if(playertextid == TD_NUMBER_PD[playerid][10]) // Закрыть
	{
		for(new i = 0; i != 12; i ++) PlayerTextDrawHide(playerid, TD_NUMBER_PD[playerid][i]);
		CancelSelectTextDrawEx(playerid);
		return 0x1;
	}
	if(playertextid == TDP_HOUSE[playerid][1])
	{
		new idx = PlayerHouseSelect[playerid];
		if(!strcmp(HouseInfo[idx][hOwner], "None", true))
		{
			if(HouseInfo[idx][hType] == 0)
			{
				new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, HouseInfo[idx][hPrice]);
				if(PI[playerid][pCash] < price_house) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
				else
				{
					if(GetPlayerHouse(playerid))  return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом!");
					if(GetPlayerRooms(playerid)) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира!");

					SetPlayerMoney(playerid, -price_house);
					HouseInfo[idx][hBuyPrice] = HouseInfo[idx][hPrice]/2;
					HouseInfo[idx][hOplata] = 1;
					HouseInfo[idx][hLock] = 1;
					HouseInfo[idx][hOwned] = PI[playerid][pID];
					SendMes(playerid, -1, ""cDA"Вы купили дом за %dр. У вас осталось: %dр",price_house, PI[playerid][pCash]);
					SendClientMessage(playerid, -1, ""cPS"Ваш дом оплачен на 1 день. Рекомендуем оплатить аренду в любом банке/банкомате города");
					SendMes(playerid, -1, ""cPS"Стоимость кварплаты для вашего дома будет составлять %dр в сутки",GetHomeOplata(idx));
					strmid(HouseInfo[idx][hOwner], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);

					STRING_GLOBAL[0] = EOS;
					mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `house` SET `hOwner` = '%e', `hOwned` = '%d', `hOplata` = 1, `buyprice` = '%d', `hLock` = '%d' WHERE `id` = '%d' LIMIT 1", HouseInfo[idx][hOwner], HouseInfo[idx][hOwned], HouseInfo[idx][hBuyPrice], HouseInfo[idx][hLock], idx);
					mysql_tquery(db_prod, STRING_GLOBAL, "", "");

					PI[playerid][pSpawnChange] = 1;

					format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=1, house=%d WHERE id=%d", idx, PI[playerid][pID]);
					mysql_tquery(db_prod, stringer1);

					PI[playerid][pHouse] = idx;
					UpdateHouse(idx);
					PlayerHouseSelect[playerid] = 0;
					for(new i; i < 24; i++) TextDrawHideForPlayer(playerid, TD_HOUSE[i]);
					for(new i; i < 2; i++) PlayerTextDrawHide(playerid, TDP_HOUSE[playerid][i]);
					CancelSelectTextDrawEx(playerid);
					fLogs("[house] %s +%i покупка", GetName(playerid), idx);
					return 1;
				}
			}
			if(HouseInfo[idx][hType] == 1)
			{
				new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, HouseInfo[idx][hPrice]);
				if(playerEuro[playerid] < price_house) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
				else
				{
					if(GetPlayerHouse(playerid))  return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом!");
					if(GetPlayerRooms(playerid)) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира!");

					TransferEuro(playerid, -1, price_house, "Покупка дома");
					HouseInfo[idx][hBuyPrice] = HouseInfo[idx][hPrice]/2;
					HouseInfo[idx][hOplata] = 1;
					HouseInfo[idx][hLock] = 1;
					HouseInfo[idx][hOwned] = PI[playerid][pID];
					SendMes(playerid, -1, ""cDA"Вы купили дом за %d евро. У вас осталось: %d евро",price_house, playerEuro[playerid]);
					SendClientMessage(playerid, -1, ""cPS"Ваш дом оплачен на 1 день. Рекомендуем оплатить аренду в любом банке/банкомате города");
					SendMes(playerid, -1, ""cPS"Стоимость кварплаты для вашего дома будет составлять %dр в сутки",GetHomeOplata(idx));
					strmid(HouseInfo[idx][hOwner], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);

					format(string, sizeof(string), "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hOplata = %d, buyprice = %d, hLock = %d WHERE id = '%d' LIMIT 1", HouseInfo[idx][hOwner], HouseInfo[idx][hOwned], HouseInfo[idx][hOplata], HouseInfo[idx][hBuyPrice], HouseInfo[idx][hLock], idx);
					mysql_tquery(db_prod, string, "", "");
					PI[playerid][pSpawnChange] = 1;

					format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=1, house=%d WHERE id=%d", idx, PI[playerid][pID]);
					mysql_tquery(db_prod, stringer1);

					PI[playerid][pHouse] = idx;
					UpdateHouse(idx);
					PlayerHouseSelect[playerid] = 0;
					for(new i; i < 24; i++) TextDrawHideForPlayer(playerid, TD_HOUSE[i]);
					for(new i; i < 2; i++) PlayerTextDrawHide(playerid, TDP_HOUSE[playerid][i]);
					CancelSelectTextDrawEx(playerid);
					fLogs("[house] %s +%i покупка", GetName(playerid), idx);
					return 1;
				}
			}
		}
		else
		{
			if(HouseInfo[idx][hLock] == 1)
			{
				if(strcmp(GetName(playerid), HouseInfo[idx][hOwner], true) == 0 || GetPlayerArend(playerid) == idx) ShowPlayerDialog(playerid, 131+14, 0, ""cMain"Дом", ""cWH"Ваш дом закрыт\n\nВы хотите его открыть?", "Да", "Нет");
				GameTextForPlayer(playerid, "~r~закрыто", 5000, 1);
			}
			else
			{

				SetPlayerPos(playerid,HouseInfo[idx][hExitx],HouseInfo[idx][hExity],HouseInfo[idx][hExitz]);
				switch(HouseInfo[idx][hDiscript])
				{
				case 1: SetPlayerFacingAngle(playerid, 90.0);
				case 2: SetPlayerFacingAngle(playerid, 89.0109);
				case 3: SetPlayerFacingAngle(playerid, 180.7951);
				}
				SetPlayerInterior(playerid,HouseInfo[idx][hInt]);
				SetPlayerVirtualWorld(playerid,HouseInfo[idx][hVirtual]);

				PI[playerid][pInHouse] = idx;

				PlayerHouseSelect[playerid] = 0;
			}
			for(new i; i < 24; i++) TextDrawHideForPlayer(playerid, TD_HOUSE[i]);
			for(new i; i < 2; i++) PlayerTextDrawHide(playerid, TDP_HOUSE[playerid][i]);
			CancelSelectTextDrawEx(playerid);
		}
		return 1;
	}


	if(select_acc[playerid])
	{
		new accountid = -1;

		new idx = _:(playertextid - select_acc_td_player[0][playerid]);

		if(!IsValidBankAccount(playerid, idx))
		return SendClientMessage(playerid, COLOR_RED, "У Вас не открыт этот счёт ");
		else accountid = idx;


		if(accountid == -1) return SendClientMessage(playerid, COLOR_RED, "Вы не выбрали аккаунт");

		if(PI[playerid][pSelectAccType] == SELECT_TYPE_ATM) ShowPlayerAtmTextDraw(playerid, accountid);
		if(PI[playerid][pSelectAccType] == SELECT_TYPE_BANK) ShowPlayerBankTextDraw(playerid, accountid);

		select_acc[playerid] = 0;
		return 1;
	}
	return 1;
}

DLG(2535, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		settext(PI[playerid][pReferal], "None");
		CreateAccount(playerid, PI[playerid][pPassword]);
		fLogs("[skin] %s регистрация [%i]", GetName(playerid), ChosenSkin[playerid]);
		return 0x1;
	}
	else
	{
		if(IsTextInvalid(inputtext))
		{
			RegisterReferalDialogInput(playerid);
			return SendErr(playerid, "Вы ввели запрещенные символы.");
		}
		if(!strlen(inputtext) || strlen(inputtext) > 24)
			return RegisterReferalDialogInput(playerid);

		format(String144, sizeof(String144), "SELECT * FROM `accounts` WHERE `name` = '%s'", inputtext);
		new Cache:result = mysql_query(db_prod, String144);

		new rows = cache_num_rows();
		cache_delete(result);

		if(!rows)
		{
			RegisterReferalDialogInput(playerid);
			return SendErr(playerid, "Введенный вами никнейм не найден в базе данных");
		}

		settext(PI[playerid][pReferal], inputtext);
		CreateAccount(playerid, PI[playerid][pPassword]);
		fLogs("[skin] %s регистрация [%i]", GetName(playerid), ChosenSkin[playerid]);
	}
	return 0x1;
}

DLG(2537, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;

	if(IsTextInvalid(inputtext))
	{
		ReferalDialogInput(playerid);
		return SendErr(playerid, "Вы ввели запрещенные символы.");
	}
	if(!strlen(inputtext) || strlen(inputtext) > 24)
		return ReferalDialogInput(playerid);

	format(String144, sizeof(String144), "SELECT * FROM `accounts` WHERE `name` = '%s'", inputtext);
	new Cache:result = mysql_query(db_prod, String144);

	new rows = cache_num_rows();
	cache_delete(result);

	if(!rows)
	{
		ReferalDialogInput(playerid);
		return SendErr(playerid, "Введенный вами никнейм не найден в базе данных");
	}

	settext(PI[playerid][pReferal], inputtext);
	MysqlUpdatePlayerStr(playerid, "referal", PI[playerid][pReferal]);
	return 0x1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
	new newslot;
	if(clickedid == Text:INVALID_TEXT_DRAW)
	{
		if(playerRecordingStatus{playerid})
		{
			SetCameraBehindPlayer(playerid);
			SetPlayerPos(playerid, 902.6959,1.1607,1405.6897);
			SetPlayerVirtualWorld(playerid, 0);
			SetPlayerInterior(playerid, 1);
			playerRecordingStatus{playerid} = 0;
			nfor(i, 11) TextDrawHideForPlayer(playerid, cameraTextDraw[i]);
			CancelSelectTextDrawEx(playerid);
		}

		if(ClothesRound[playerid] == 2)
		{
			TogglePlayerControllable(playerid,true);
			SetPlayerPos(playerid, 2698.5212,301.8629,1401.0000);
			SetPlayerFacingAngle(playerid, 180.0);
			SetPlayerVirtualWorld(playerid, InShopSkin[playerid]);
			SetPlayerInterior(playerid, 15);
			InShopSkin[playerid] = 0;
			SelectCharPlace[playerid] = 0;
			ClothesRound[playerid] = 0;
			SetCameraBehindPlayer(playerid);
			if(PI[playerid][pMember]) SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
			else SetPlayerSkin(playerid, PI[playerid][pModel]);
			for(new i; i < 21; i++) TextDrawHideForPlayer(playerid, clothes_td_global[i]);
			PlayerTextDrawHide(playerid, clothes_td_player[playerid]);
			CancelSelectTextDrawEx(playerid);
		}
		if(Phonesmenu[playerid] == 1)
		{
			PhoneMenuExit(playerid);
		}
		if(gSelectColor[playerid] != EOS)
		{
			if(dl_playerDialogID[playerid] == -1) SelectTextDraw(playerid,gSelectColor[playerid]);
		}
		return 1;
	}

	if(clickedid == rating_td_global[5])
	{
		for(new i = 0; i != 4; i ++) PlayerTextDrawHide(playerid, rating_td_player[playerid][i]);
		for(new i = 0; i != 13; i ++) TextDrawHideForPlayer(playerid, rating_td_global[i]);
		CancelSelectTextDrawEx(playerid);
		return 0x1;
	}

	if(clickedid == start_game_TD[2]) //информация
	{
		ShowPlayerDialog(playerid, 7346, DIALOG_STYLE_LIST, "{ECDE19}Информация", "1. О сервере\n2. F.A.Q для новичков", "Далее", "Назад");
		return 1;
	}
	if(clickedid == start_game_TD[1]) // начать игру
	{

		PlayerTextDrawHide(playerid, start_game_PTD[playerid][0]);
		for(new i; i < 3; i ++)
		{
			TextDrawHideForPlayer(playerid, start_game_TD[i]);
		}

		global_string = "";
		mysql_format(db_prod, global_string, sizeof(global_string), "SELECT `model`,`password` FROM `accounts` WHERE `name` = '%e' LIMIT 1", GetName(playerid));
		mysql_tquery(db_prod, global_string, "player_check", "i", playerid);
		return 1;
	}

	if(select_acc[playerid])
	{
		if(clickedid == select_acc_td_global[1])
		{
			if(PI[playerid][pSelectAccType] == SELECT_TYPE_ATM) return SendClientMessage(playerid, COLOR_RED, "Создать новый счет можно только в банке");

			select_acc[playerid] = 0;
			PI[playerid][pSelectAccType] = SELECT_TYPE_NONE;

			for(new i; i < 6; i ++) TextDrawHideForPlayer(playerid, select_acc_td_global[i]);
			for(new i; i < 5; i ++) PlayerTextDrawHide(playerid, select_acc_td_player[i][playerid]);

			CancelSelectTextDrawEx(playerid);

			return ShowPlayerCreateBankAccount(playerid);
		}

		if(clickedid == select_acc_td_global[5])
		{
			select_acc[playerid] = 0;
			PI[playerid][pSelectAccType] = SELECT_TYPE_NONE;

			for(new i; i < 6; i ++) TextDrawHideForPlayer(playerid, select_acc_td_global[i]);
			for(new i; i < 5; i ++) PlayerTextDrawHide(playerid, select_acc_td_player[i][playerid]);

			CancelSelectTextDrawEx(playerid);

			return 1;
		}
	}

	if(rob_td_global[5] <= clickedid <= rob_td_global[8] && g_rob[R_STATUS])
	{
		new idx = _:(clickedid - rob_td_global[5]);

		if(idx != g_rob[R_ICON])
		{
			SendClientMessage(playerid, COLOR_RED, "Вы выбрали неверный знак. Взлом начат заново");

			new rand = random(4);

			g_rob[R_ICON] = rand;
			g_rob[R_PRESSED] = 0;

			PlayerTextDrawSetString(playerid, rob_td_player[0][playerid], g_rob_icons[rand]);

			format(stringer1, 40, "прогресс:_%d/30", g_rob[R_PRESSED]);
			PlayerTextDrawSetString(playerid, rob_td_player[2][playerid], stringer1);
		}
		else
		{
			new rand = random(4);
			PlayerTextDrawSetString(playerid, rob_td_player[0][playerid], g_rob_icons[rand]);

			g_rob[R_ICON] = rand;
			g_rob[R_PRESSED] ++;

			format(stringer1, 40, "прогресс:_%d/30", g_rob[R_PRESSED]);
			PlayerTextDrawSetString(playerid, rob_td_player[2][playerid], stringer1);

			if(g_rob[R_PRESSED] > 30)
			{
				SendClientMessage(playerid, 0xFFCC00AA, "Вы выбрали верно все знаки. Вам был выдан мешок с деньгами");
				SendClientMessage(playerid, 0xFFCC00AA, "Вам нужно доставить его на базу (отмечено на GPS)");
				SendClientMessage(playerid, 0xFFCC00AA, "Но будьте осторожны, сотрудники полиции могут встретить Вас");

				g_rob[R_TIME] = 0;

				PlayerBase[playerid] = 1;
				SetPlayerRaceCheckpoint(playerid, 1, 2613.3416,1774.7411,2.4369, 0.0,0.0,0.0, 4.0);
				//SetPlayerAttachedObject(playerid, 4, 1550, 1, 0.0000, -0.3319, 0.0000, 1.09, 91.20, 1.70, 1.00, 1.00, 1.00);

				for(new td; td < 30; td ++) TextDrawHideForPlayer(playerid, rob_td_global[td]);
				for(new td; td < 3; td ++) PlayerTextDrawHide(playerid, rob_td_player[td][playerid]);
				CancelSelectTextDrawEx(playerid);
			}
		}
		return 1;
	}

	if(PI[playerid][pAccType] != -1)
	{
		if(clickedid == td_acessories_global[16])
		{
			new type = PI[playerid][pAccType];
			pPressed[playerid] ++;
			if(pPressed[playerid] > g_accessories_objects_max_index[type])
			pPressed[playerid] = 0;
			CreateNewAccessoriesObject(playerid, pPressed[playerid]);
			return 1;
		}
		if(clickedid == td_acessories_global[18])
		{
			new type = PI[playerid][pAccType];
			pPressed[playerid] --;
			if(pPressed[playerid] < 0)
			pPressed[playerid] = g_accessories_objects_max_index[type];
			CreateNewAccessoriesObject(playerid, pPressed[playerid]);
			return 1;
		}
		if(clickedid == td_acessories_global[2])
		{
			if(GetPlayerRubble(playerid) < g_accessories_objects_sum[PI[playerid][pAccType]] * BizzInfo[GetPlayerInBiz(playerid)][bTill]) return SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно денег");
			SetPlayerMoney(playerid, -g_accessories_objects_sum[PI[playerid][pAccType]] * BizzInfo[GetPlayerInBiz(playerid)][bTill]);

			new access = -1;
			for(new idx; idx < MAX_PLAYER_ACCESSORIES; idx ++)
			{
				if(GetPlayerAccessoriesData(playerid, idx, A_OBJECT) != 0) continue;
				SetPlayerAccessoriesData(playerid, idx, A_OBJECT, g_accessories_objects[ PI[playerid][pAccType] ][ pPressed[playerid] ]);

				g_player_accessories[playerid][idx][A_OBJECT_X] = 0.0;
				g_player_accessories[playerid][idx][A_OBJECT_Y] = 0.0;
				g_player_accessories[playerid][idx][A_OBJECT_Z] = 0.0;

				nstrmid(g_player_accessories[playerid][idx][A_NAME], g_accessories_objects_names[ PI[playerid][pAccType] ]);
				access = idx;
				break;
			}
			if(access == -1) return SendClientMessage(playerid, COLOR_RED, "У Вас нет места для аксессуаров (15)");

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `accounts_accessories` (`owner`, `name`, `objectid`) VALUES ('%d', '%e', '%d')", PI[playerid][pID], g_accessories_objects_names[ PI[playerid][pAccType] ], g_accessories_objects[ PI[playerid][pAccType] ][ pPressed[playerid] ]);
			mysql_tquery(db_prod, STRING_GLOBAL, "accessories_in", "ii", playerid, access);
			return 1;
		}
		if(clickedid == td_acessories_global[3])
		{
			TogglePlayerControllable(playerid,true);
			SetPlayerPos(playerid, 2699.2236,299.5913,1401.0000);
			SetPlayerFacingAngle(playerid, 180.0);

			SetCameraBehindPlayer(playerid);
			if(PI[playerid][pAccObject] != INVALID_OBJECT_ID) DestroyPlayerObject(playerid, PI[playerid][pAccObject]), PI[playerid][pAccObject] = INVALID_OBJECT_ID;
			for(new i; i < 23; i ++) TextDrawHideForPlayer(playerid, td_acessories_global[i]);
			PlayerTextDrawHide(playerid, td_acessories_player[playerid]);
			CancelSelectTextDrawEx(playerid);
			return 1;
		}
	}
	if(clickedid == td_pasport_global[18])
	{
		for(new idx; idx < 20; idx ++)
		TextDrawHideForPlayer(playerid, td_pasport_global[idx]);
		for(new idx; idx < 4; idx ++)
		PlayerTextDrawHide(playerid, td_pasport_player[idx][playerid]);
		CancelSelectTextDrawEx(playerid);
		passport_status[playerid] = false;
		return 1;
	}
	if(ClothesRound[playerid] == 1)
	{
		if(clickedid == skin_choosing_td[22])
		{
			if(PI[playerid][pSex] == 1)
			{
				if(SelectCharPlace[playerid] == sizeof(JoinRegM)-1) SelectCharPlace[playerid] = 0;
				else SelectCharPlace[playerid]++;
				SetPlayerSkin(playerid, JoinRegM[SelectCharPlace[playerid]]);
				ChosenSkin[playerid] = JoinRegM[SelectCharPlace[playerid]];
			}
			else
			{
				if(SelectCharPlace[playerid] == sizeof(JoinRegF)-1) SelectCharPlace[playerid] = 0;
				else SelectCharPlace[playerid]++;
				SetPlayerSkin(playerid, JoinRegF[SelectCharPlace[playerid]]);
				ChosenSkin[playerid] = JoinRegF[SelectCharPlace[playerid]];
			}
			return 1;
		}
		if(clickedid == skin_choosing_td[10])
		{
			if(PI[playerid][pSex] == 1)
			{
				if(SelectCharPlace[playerid] == 0) SelectCharPlace[playerid] = sizeof(JoinRegM)-1;
				else SelectCharPlace[playerid]--;
				SetPlayerSkin(playerid, JoinRegM[SelectCharPlace[playerid]]);
				ChosenSkin[playerid] = JoinRegM[SelectCharPlace[playerid]];
			}
			else
			{
				if(SelectCharPlace[playerid] == 0) SelectCharPlace[playerid] = sizeof(JoinRegF)-1;
				else SelectCharPlace[playerid]--;
				SetPlayerSkin(playerid, JoinRegF[SelectCharPlace[playerid]]);
				ChosenSkin[playerid] = JoinRegF[SelectCharPlace[playerid]];
			}
			return 1;
		}
		if(clickedid == skin_choosing_td[16])
		{
			PI[playerid][pModel] = ChosenSkin[playerid];
			ChosenSkin[playerid] = 0;
			SelectCharPlace[playerid] = 0;
			ClothesRound[playerid] = 0;
			TogglePlayerControllable(playerid, 1);
			RegisterReferalDialogInput(playerid);
			CancelSelectTextDrawEx(playerid);
			for(new i; i < 25; i++) TextDrawHideForPlayer(playerid, skin_choosing_td[i]);
			return 1;
		}
	}

	if(ClothesRound[playerid] == 2)
	{
		if(clickedid == clothes_td_global[4])
		{
			if(PI[playerid][pSex] == 1)
			{
				if(SelectCharPlace[playerid] == sizeof(JoinShopM)-1) SelectCharPlace[playerid] = 0;
				else SelectCharPlace[playerid]++;
				SetPlayerSkin(playerid, JoinShopM[SelectCharPlace[playerid]][0]);

				new price_skin = GetReasonMoneyPercentVip(playerid, TYPE_VIP_SKIN, JoinShopM[SelectCharPlace[playerid]][1]);
				format(stringer1, sizeof(stringer1), "%d_рублей", price_skin);
				PlayerTextDrawSetString(playerid, clothes_td_player[playerid], stringer1);

			}
			else
			{
				if(SelectCharPlace[playerid] == sizeof(JoinShopF)-1) SelectCharPlace[playerid] = 0;
				else SelectCharPlace[playerid]++;
				SetPlayerSkin(playerid, JoinShopF[SelectCharPlace[playerid]][0]);

				new price_skin = GetReasonMoneyPercentVip(playerid, TYPE_VIP_SKIN, JoinShopM[SelectCharPlace[playerid]][1]);
				format(stringer1, sizeof(stringer1), "%d_рублей", price_skin);
				PlayerTextDrawSetString(playerid, clothes_td_player[playerid], stringer1);
			}
			return 1;
		}
		if(clickedid == clothes_td_global[2])
		{
			if(PI[playerid][pSex] == 1)
			{
				if(SelectCharPlace[playerid] == 0) SelectCharPlace[playerid] = sizeof(JoinShopM)-1;
				else SelectCharPlace[playerid]--;
				SetPlayerSkin(playerid, JoinShopM[SelectCharPlace[playerid]][0]);

				new price_skin = GetReasonMoneyPercentVip(playerid, TYPE_VIP_SKIN, JoinShopM[SelectCharPlace[playerid]][1]);
				format(stringer1, sizeof(stringer1), "%d_рублей",price_skin);
				PlayerTextDrawSetString(playerid, clothes_td_player[playerid], stringer1);
			}
			else
			{
				if(SelectCharPlace[playerid] == 0) SelectCharPlace[playerid] = sizeof(JoinShopF)-1;
				else SelectCharPlace[playerid]--;
				SetPlayerSkin(playerid, JoinShopF[SelectCharPlace[playerid]][0]);


				new price_skin = GetReasonMoneyPercentVip(playerid, TYPE_VIP_SKIN, JoinShopM[SelectCharPlace[playerid]][1]);
				format(stringer1, sizeof(stringer1), "%d_рублей",price_skin);
				PlayerTextDrawSetString(playerid, clothes_td_player[playerid], stringer1);
			}
			return 1;
		}
		if(clickedid == clothes_td_global[19])
		{
			TogglePlayerControllable(playerid,true);
			SetPlayerPos(playerid, 2698.5212,301.8629,1401.0000);
			SetPlayerFacingAngle(playerid, 180.0);
			SetPlayerVirtualWorld(playerid, InShopSkin[playerid]);
			SetPlayerInterior(playerid, 15);
			InShopSkin[playerid] = 0;
			SelectCharPlace[playerid] = 0;
			ClothesRound[playerid] = 0;
			SetCameraBehindPlayer(playerid);
			if(PI[playerid][pMember]) SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
			else SetPlayerSkin(playerid, PI[playerid][pModel]);
			for(new i; i < 21; i++) TextDrawHideForPlayer(playerid, clothes_td_global[i]);
			PlayerTextDrawHide(playerid, clothes_td_player[playerid]);
			CancelSelectTextDrawEx(playerid);
			return 1;
		}
		if(clickedid == clothes_td_global[3])
		{
			new b = GetPlayerInBiz(playerid);
			if(b == -1) return 1;

			new price = (PI[playerid][pSex] == 1) ? (JoinShopM[SelectCharPlace[playerid]][1]) : (JoinShopF[SelectCharPlace[playerid]][1]);
			new price_skin = GetReasonMoneyPercentVip(playerid, TYPE_VIP_SKIN, price);
			if(GetPlayerRubble(playerid) < price_skin) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств на счету!");
			PI[playerid][pModel] = (PI[playerid][pSex] == 1) ? (JoinShopM[SelectCharPlace[playerid]][0]) : (JoinShopF[SelectCharPlace[playerid]][0]);
			fLogs("[skin] %s магазин [%i]", GetName(playerid), ChosenSkin[playerid]);

			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET model=%d WHERE id=%d", PI[playerid][pModel], PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
			SetPlayerMoney(playerid, -price_skin);

			if(BizzInfo[b][bProduct] > 0)
			{
				BizzInfo[b][bMoney] += price / 4;
				BizzPay[b] += price / 4;
				BizzInfo[b][bProduct] -= (price / 100) * 2;
				MysqlUpdateBizzInt(b, "money", BizzInfo[b][bMoney]);
				MysqlUpdateBizzInt(b, "product", BizzInfo[b][bProduct]);
			}
			TogglePlayerControllable(playerid,true);
			SetPlayerPos(playerid, 2698.5212,301.8629,1401.0000);
			SetPlayerFacingAngle(playerid, 180.0);
			SetPlayerVirtualWorld(playerid, InShopSkin[playerid]);
			SetPlayerInterior(playerid, 15);
			InShopSkin[playerid] = 0;
			SelectCharPlace[playerid] = 0;
			ClothesRound[playerid] = 0;
			SetCameraBehindPlayer(playerid);
			SetPlayerSkin(playerid, PI[playerid][pModel]);
			new house12 = 0;
			for(new i = TOTALHOUSE; i > 0; i --)
			{
				if(!strcmp(HouseInfo[i][hOwner],GetName(playerid),true))
				{
					house12++;
					break;
				}
			}
			if(house12)
			{
				new oneskin[14], twoskin[14], threeskin[14];

				if(!PI[playerid][pSkin][0]) format(oneskin, sizeof(oneskin), "{F04245}(нет)");
				else format(oneskin, sizeof(oneskin), "{63BD4E}(%d)", PI[playerid][pSkin][0]);
				if(!PI[playerid][pSkin][1]) format(twoskin, sizeof(twoskin), "{F04245}(нет)");
				else format(twoskin, sizeof(twoskin), "{63BD4E}(%d)", PI[playerid][pSkin][1]);
				if(!PI[playerid][pSkin][2]) format(threeskin, sizeof(threeskin), "{F04245}(нет)");
				else format(threeskin, sizeof(threeskin), "{63BD4E}(%d)", PI[playerid][pSkin][1]);

				format(stringer, sizeof(stringer), ""cWH"Полка №1 %s\n"cWH"Полка №2 %s\n"cWH"Полка №3 %s\n"cWH"Оставить одежду на себе", oneskin, twoskin, threeskin);
				ShowPlayerDialog(playerid, 1431, DIALOG_STYLE_LIST, ""cMain"Куда положить одежду", stringer, "Выбрать", "");
			}
			for(new i; i < 21; i++) TextDrawHideForPlayer(playerid, clothes_td_global[i]);
			PlayerTextDrawHide(playerid, clothes_td_player[playerid]);
			CancelSelectTextDrawEx(playerid);
			SendClientMessage(playerid, -1, ""cDA"Вы купили одежду в магазине.");
		}
	}


