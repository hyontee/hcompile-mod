cmd:med(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/med [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	new med_status[25], gender_text[8];
	switch(PhoneNumbers[playerid][2])
	{
	case 0: return SendClientMessage(playerid, -1, ""cER"У вас нет мед. карты");
	case 1: med_status = "не определен";
	case 2: med_status = "психически не здоров(-а)";
	case 3: med_status = "наблюдаются отклонения";
	case 4: med_status = "полностью здоровый(-ая)";
	}
	if(PI[playerid][pSex] == 1) gender_text = "Мужчина";
	else if(PI[playerid][pSex] == 2) gender_text = "Женщина";

	string = ""cWH"";
	format(string, sizeof(string), "%sИмя: %s\n", string, GetName(playerid));
	format(string, sizeof(string), "%sВозраст: %d\n", string, PI[playerid][pAge]);
	format(string, sizeof(string), "%sПол: %s\n", string, gender_text);
	format(string, sizeof(string), "%sСтатус: %s\n", string, med_status);
	ShowPlayerDialog(params[0], 0, DIALOG_STYLE_MSGBOX, ""cMain"Мед. карта", string, "Закрыть", "");

	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "показал свою мед. карту %s", GetName(params[0]));
	else format(string, sizeof(string), "показалa свою мед. карту %s", GetName(params[0]));
	MeAction(playerid, string);
	return true;
}

cmd:eject(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится в транспорте!");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться за рулем транспорт!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/eject [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(playerid == params[0]) return SendClientMessage(playerid, -1, ""cER"Ты не можешь выкинуть себя!");
	if(!IsPlayerInVehicle(params[0],GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться в вашем транспорте!");

	SendMes(playerid, COLOR_LIGHTBLUE, "Вы выкинули из транспорта %s", GetName(params[0]));
	SendMes(params[0], COLOR_LIGHTBLUE, "%s выкинул вас из транспорта", GetName(playerid));
	TogglePlayerControllable(params[0], 1);
	format(string, sizeof(string), "выкинул из транспорта %s", GetName(params[0]));
	MeAction(playerid, string);
	RemovePlayerFromVehicle(params[0]);
	return 1;
}

cmd:payday(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PI[playerid][pAdmin] < 11) return 1;
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		PayDay();
		fLogs("[admin] %s /payday", GetName(playerid));
	}
	return 1;
}
CMD:auninvite(playerid, params[])
{
	if(PI[playerid][pAdmin] < 10) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено увольнять игроков");
	if(sscanf(params, "us[32]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, "• {66CC00}[ Подсказка ] "cWH"Введите: /auninvite [id игрока] [причина]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PI[params[0]][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находится в организации!");
	if(PI[params[0]][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Нельзя увольнять лидеров!");

	format(string, sizeof(string), "[F] Администратор %s[%d] уволил %s[%d]. Причина: %s",PI[playerid][pName],playerid,PI[params[0]][pName],params[0],params[1]);
	SendFMes(PI[params[0]][pMember], COLOR_YELLOW2, string);
	SaveHistoryBan(GetName(params[0]), string);
	SendMes(playerid, COLOR_BLUE, "Вы уволили %s из организации. Причина: %s",GetName(params[0]),params[1]);
	SendMes(params[0], COLOR_BLUE, "Администратор %s уволил Вас из организации. Причина: %s",GetName(playerid),params[1]);
	LeaveFractionPlayer(params[0]);
	fLogs("[admin] %s /auninvite %s %s", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}

cmd:gcontrol(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PI[playerid][pAdmin] < 10) return 1;
		else if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		ShowDialogGhetto(playerid);
	}
	return 1;
}

cmd:pay(playerid, params[])
{
	if(payer[playerid] > unix) return SendClientMessage(playerid, -1, ""cER"Передавать деньги можно раз в минуту");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/pay [id игрока] [сумма]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "Нельзя передавать деньги самому себе");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(params[1] < 1 || GetPlayerRubble(playerid) < params[1]) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
	if(params[1] < 1 || params[1] > 100000) return SendClientMessage(playerid, COLOR_GREY, "Игроки могут передавать только по 100.000р");

	if(!strcmp(PI[params[0]][pIP], PI[playerid][pIP], true))
	{
		SendClientMessage(playerid, COLOR_RED, "* Передача денежных средств на мультиаккаунты запрещена.");
		return 1;
	}
	SetPlayerMoney(playerid, -params[1]);
	SetPlayerMoney(params[0], params[1]);
	SendMes(params[0], COLOR_GREY, "Игрок %s передал вам %dр", GetName(playerid), params[1]);
	SendMes(playerid, COLOR_GREY, "Вы передали %dр игроку %s", params[1], GetName(params[0]));

	if(PI[playerid][pSex] == 1) format(stringer1, sizeof(stringer1), "достал деньги из кармана и передал их %s", GetName(params[0]));
	else format(stringer1, sizeof(stringer1), "достала деньги из кармана и передала их %s", GetName(params[0]));
	MeAction(playerid, stringer1);

	ApplyAnimation(playerid, "DEALER", "shop_pay", 4.1, 0, 1, 1, 0, 0, 1);
	if(!PI[playerid][pAdmin]) payer[playerid] = unix+60;
	return 1;
}

cmd:idbiz(playerid)
{
	if(g_player_full_access[playerid])
	{
		for(new idx = TOTALBIZZ; idx > 0; idx--)
		{
			if(IsPlayerInRangeOfPoint(playerid, 1.0, BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz])) SendMes(playerid, COLOR_RED, "ID этого бизнеса: %d", idx);
		}
	}
	return true;
}

cmd:setbizpos(playerid, params[])
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted"))
	{
		new biz_id = 0, Float:pos[3];
		if(sscanf(params, "i", biz_id)) return SendClientMessage(playerid, -1, ""cPS"Используйте: /setbizpos [ID бизнеса(узнать /idbiz)]");
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);

		BizzInfo[biz_id][bEntrx] = pos[0];
		BizzInfo[biz_id][bEntry] = pos[1];
		BizzInfo[biz_id][bEntrz] = pos[2];

		MysqlUpdateBizzFloat(biz_id, "x", BizzInfo[biz_id][bEntrx]);
		MysqlUpdateBizzFloat(biz_id, "y", BizzInfo[biz_id][bEntry]);
		MysqlUpdateBizzFloat(biz_id, "z", BizzInfo[biz_id][bEntrz]);

		if(IsValidDynamicMapIcon(BizzInfo[biz_id][bIcon]))
		{
			DestroyDynamicMapIcon(BizzInfo[biz_id][bIcon]);
			BizzInfo[biz_id][bIcon] = CreateDynamicMapIcon(BizzInfo[biz_id][bEntrx],BizzInfo[biz_id][bEntry],BizzInfo[biz_id][bEntrz], BizzInfo[biz_id][bMIcon], 0);
		}

		new fee[64];
		if(BizzInfo[biz_id][bEnter] == 0) fee = "Бесплатный";
		else format(fee, sizeof(fee), "%dр", BizzInfo[biz_id][bEnter]);

		if(BizzInfo[biz_id][bType] != 2 && BizzInfo[biz_id][bType] != 7)
		{
			DestroyPickup(BizzInfo[biz_id][bPickup]);
			DestroyDynamic3DTextLabel(LABELBIZZ[biz_id]);
			BizzInfo[biz_id][bPickup] = CreatePickup(19132,1, BizzInfo[biz_id][bEntrx],BizzInfo[biz_id][bEntry],BizzInfo[biz_id][bEntrz],-1);
			if(!strcmp(BizzInfo[biz_id][bOwner],"None",true))
			{
				format(string, sizeof(string), "{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: "cMain"%dр\n"cWH"Крышуют: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bPrice], BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "Нет");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz]+0.5,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
			}
			else
			{
				format(string, sizeof(string), "{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Вход: "cMain"%s\n"cWH"Крышуют: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bOwner], fee, BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "Нет");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz]+0.5,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
			}
		}
		else if(BizzInfo[biz_id][bType] == 2)
		{
			DestroyDynamic3DTextLabel(LABELBIZZ[biz_id]);
			if(!strcmp(BizzInfo[biz_id][bOwner],"None",true))
			{
				format(string, sizeof(string), "{ffcc33}H - Меню АЗС\n\n{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\n"cWH"Цена за 1 литр бензина: "cMain"%dр\n"cWH"Купить канистру: /buyfuel\n"cWH"Крышуют: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bPrice], BizzInfo[biz_id][bTill] / 3, BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "Нет");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz]+1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID);
			}
			else
			{
				format(string, sizeof(string), "{ffcc33}H - Меню АЗС\n\n{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Цена за 1 литр бензина: "cMain"%dp\n"cWH"Купить канистру: /buyfuel\n"cWH"Крышуют: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bOwner], BizzInfo[biz_id][bTill] / 3, BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "Нет");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz]+1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID);
			}
		}
		else
		{
			DestroyDynamic3DTextLabel(LABELBIZZ[biz_id]);
			if(!strcmp(BizzInfo[biz_id][bOwner],"None",true))
			{
				format(string, sizeof(string), "{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\n"cWH"Цена за 1 запчасть - "cMain"%dр\n\n{ffcc33}H - Заехать в СТО\n"cWH"Крышуют: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bPrice], BizzInfo[biz_id][bTill], BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "Нет");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
			}
			else
			{
				format(string, sizeof(string), "{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Цена за 1 запчасть - "cMain"%dр\n\n{ffcc33}H - Заехать в СТО\n"cWH"Крышуют: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bOwner], BizzInfo[biz_id][bTill], BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "Нет");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
			}
		}
		UpdateBizz(biz_id);
		SendClientMessage(playerid, COLOR_GREEN, "Бизнес перенесен на новые координаты");
		fLogs("[admin] %s /setbizpos %i", GetName(playerid), biz_id);
	}
	return true;
}

cmd:sethousepos(playerid, params[])
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted"))
	{
		new biz_id = 0, Float:pos[3];

		if(sscanf(params, "i", biz_id))
		return SendClientMessage(playerid, -1, ""cPS"Используйте: /sethousepos [ID дома]");

		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);

		HouseInfo[biz_id][hEntrx] = pos[0];
		HouseInfo[biz_id][hEntry] = pos[1];
		HouseInfo[biz_id][hEntrz] = pos[2];

		global_string = "";
		mysql_format(db_prod, global_string, 200, "UPDATE `house` SET hEntrx = '%f', hEntry = '%f', hEntrz = '%f' WHERE id = '%d'", pos[0], pos[1], pos[2], biz_id);
		mysql_tquery(db_prod, global_string, "", "");

		if(IsValidDynamicMapIcon(HouseInfo[biz_id][hMIcon]))
		{
			DestroyDynamicMapIcon(HouseInfo[biz_id][hMIcon]);
			BizzInfo[biz_id][bIcon] = HouseInfo[biz_id][hMIcon] = CreateDynamicMapIcon(HouseInfo[biz_id][hEntrx], HouseInfo[biz_id][hEntry], HouseInfo[biz_id][hEntrz], 31, 0);
		}

		if(!strcmp(HouseInfo[biz_id][hOwner],"None",true))
		{
			DestroyPickup(HouseInfo[biz_id][hPickup]);
			HouseInfo[biz_id][hPickup] = CreatePickup(1273, 1, HouseInfo[biz_id][hEntrx], HouseInfo[biz_id][hEntry], HouseInfo[biz_id][hEntrz],-1);
		}
		else
		{
			DestroyPickup(HouseInfo[biz_id][hPickup]);
			HouseInfo[biz_id][hMIcon] = CreateDynamicMapIcon(HouseInfo[biz_id][hEntrx], HouseInfo[biz_id][hEntry], HouseInfo[biz_id][hEntrz], 32, 0);
			HouseInfo[biz_id][hPickup] = CreatePickup(1272, 1, HouseInfo[biz_id][hEntrx], HouseInfo[biz_id][hEntry], HouseInfo[biz_id][hEntrz],-1);
		}
		SendClientMessage(playerid, COLOR_GREEN, "Дом перенесен на новые координаты");
		fLogs("[admin] %s /sethousepos %i", GetName(playerid), biz_id);
	}
	return true;
}

callback::GivePlayerOffMute(playerid, name[], time, reason[])
{
	if(!cache_num_rows()) return SendClientMessage(playerid, -1, ""cER"Аккаунт не найден");
	if(time)
	{
		mysql_format(db_prod, stringer1, 128, "UPDATE accounts SET mute=mute+%d, mutereason = '%s' WHERE name = '%e'", time * 60, reason, name);
		mysql_tquery(db_prod, stringer1, "", "");

		format(stringer1, sizeof stringer1, "Администратор %s(%d) выдал мут игроку %s в Offline на %d минут. Причина: %s", GetName(playerid), playerid, name, time, reason);
		SendClientMessageToAll(COLOR_RED, stringer1);
		SaveHistoryBan(name, stringer1);
	}
	else
	{
		mysql_format(db_prod, stringer1, 128, "UPDATE accounts SET mute = 0 WHERE name = '%e'", name);
		mysql_tquery(db_prod, stringer1, "", "");

		format(stringer1, sizeof stringer1, "Администратор %s(%d) снял мут игроку %s в Offline. Причина: %s", GetName(playerid), playerid, name, reason);
		SendClientMessageToAll(COLOR_RED, stringer1);
		SaveHistoryBan(name, stringer1);
	}
	fLogs("[admin] %s /offmute %s %i %s", GetName(playerid), name, time, reason);
	return 1;
}

callback::GivePlayerOffJail(playerid, name[], time, reason[])
{
	if(!cache_num_rows()) return SendClientMessage(playerid, -1, ""cER"Аккаунт не найден");
	if(time)
	{
		mysql_format(db_prod, stringer1, 128, "UPDATE accounts SET jail = '1', jailtime=jailtime+%d, jailreason = '%s' WHERE name = '%e'", time * 60, reason, name);
		mysql_tquery(db_prod, stringer1, "", "");

		format(stringer1, sizeof stringer1, "Администратор %s(%d) посадил в тюрьму игрока %s в Offline на %d минут. Причина: %s", GetName(playerid), playerid, name, time, reason);
		SendClientMessageToAll(COLOR_RED, stringer1);
		SaveHistoryBan(name, stringer1);
	}
	else
	{
		mysql_format(db_prod, stringer1, 128, "UPDATE accounts SET jail = '0', jailtime = '0' WHERE name = '%e'", name);
		mysql_tquery(db_prod, stringer1, "", "");

		format(stringer1, sizeof stringer1, "Администратор %s(%d) выпустил с тюрьмы игрока %s в Offline. Причина: %s", GetName(playerid), playerid, name, reason);
		SendClientMessageToAll(COLOR_RED, stringer1);
		SaveHistoryBan(name, stringer1);
	}
	fLogs("[admin] %s /offjail %s %i %s", GetName(playerid), name, time, reason);
	return 1;
}

cmd:offmute(playerid, params[])
{
	if(PI[playerid][pAdmin] >= 4)
	{
		new player_name[MAX_PLAYER_NAME], player_count, player_reason[64];
		if(sscanf(params, "s[24]is[64]", player_name, player_count, player_reason)) return SendClientMessage(playerid, -1, ""cPS"Используйте: /offmute [Имя] [Минуты] [Причина]");
		if(GetPlayerID(player_name) != INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, ""cER"Данный игрок Online. Используйте /mute");

		global_string = "";
		mysql_format(db_prod, global_string, 128, "SELECT * FROM accounts WHERE name = '%s'", player_name);
		mysql_tquery(db_prod, global_string, "GivePlayerOffMute", "isis", playerid, player_name, player_count, player_reason);

	}
	else SendClientMessage(playerid, -1, ""cER"Недоступно для Вашего ранга");
	return 1;
}

cmd:offjail(playerid, params[])
{
	if(PI[playerid][pAdmin] >= 4)
	{
		new player_name[MAX_PLAYER_NAME], player_count, player_reason[64];
		if(sscanf(params, "s[24]is[64]", player_name, player_count, player_reason)) return SendClientMessage(playerid, -1, ""cPS"Используйте: /offjail [Имя] [Минуты] [Причина]");
		if(GetPlayerID(player_name) != INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, ""cER"Данный игрок Online. Используйте /jail");

		global_string = "";
		mysql_format(db_prod, global_string, 128, "SELECT * FROM accounts WHERE name = '%s'", player_name);
		mysql_tquery(db_prod, global_string, "GivePlayerOffJail", "isis", playerid, player_name, player_count, player_reason);

	}
	else SendClientMessage(playerid, -1, ""cER"Недоступно для Вашего ранга");
	return 1;
}
cmd:apark(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	new Float: vehicleX, Float: vehicleY, Float: vehicleZ, vehid;
	foreach(new i: Vehicle)
	{
		GetVehiclePos(i, vehicleX, vehicleY, vehicleZ);
		if(IsPlayerInRangeOfPoint(playerid, 2.0, vehicleX, vehicleY, vehicleZ))
		{
			vehid = i;
			break;
		}
	}
	if(vehid != 0)
	{
		foreach(new i: Player)
		{
			for(new z; z < MAX_LOAD_VEHICLE; z++)
			{
				if(PlayerVehicle[i][z] == vehid)
				{
					new
						querys[256];
					mysql_format(db_prod, querys, 256, "UPDATE `ownable_cars` SET c_x = '0.0', c_y = '0.0', c_z = '0.0', c_a = '0.0', c_world = '0'  WHERE `id` = '%i' LIMIT 1"
					, PlayerVehicleSQL[i][z]);
					mysql_tquery(db_prod, querys, "", "");
					SCMF(i, COLOR_LIME, "Место парковки для вашего транспорта сменил администратор %s", GetName(playerid));
					SendInf(playerid, "Вы сменили место парковки.");

					DestroyPlayerVehicle(i, z);
					fLogs("[admin] %s /apark %s", GetName(playerid), GetName(i));
					return true;
				}
			}
		}
	}
	SendInf(playerid, "Автомобиль не найден, подойдите ближе.");
	return 1;
}
cmd:fpark(playerid)
{
	if(PI[playerid][pFamily] == 0) return SendErr(playerid, "Нужно быть в семье");
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,COLOR_DARKORANGE,"Нужно находиться в автомобиле");
	if(NoParking(playerid)) return SendClientMessage(playerid, COLOR_DARKORANGE, "Здесь запрещено парковать машину!");
	new vehicleid = GetPlayerVehicleID(playerid), f = PI[playerid][pFamily], type = -1;
	nfor(i, 5) if(family_info[f][f_cars][i] == vehicleid)
	{
		type = i;
		break;
	}
	if(type == -1) return SendClientMessage(playerid, COLOR_RED, "Вы должны быть в семейном автомобиле");
	GetVehiclePos(vehicleid,family_info[f][f_vehx][type],family_info[f][f_vehy][type],family_info[f][f_vehz][type]);
	GetVehicleZAngle(vehicleid,family_info[f][f_veha][type]);

	SendClientMessage(playerid,COLOR_LIME,"Семейный транспорт успешно припаркован в этом месте");
	format(stringer1, 128, "UPDATE `family_cars` SET x='%f', y='%f', z='%f',fa='%f' WHERE family=%d AND id=%d", family_info[f][f_vehx][type],family_info[f][f_vehy][type],family_info[f][f_vehz][type],family_info[f][f_veha][type], f, family_info[f][f_vehid][type]);
	mysql_tquery(db_prod, stringer1);
	return 1;
}

cmd:park(playerid)
{
	if(!IsPlayerInAnyVehicle(playerid))
		return SendClientMessage(playerid,COLOR_DARKORANGE,"Нужно находиться в автомобиле");
	if(NoParking(playerid))
		return SendClientMessage(playerid, COLOR_DARKORANGE, "Здесь запрещено парковать машину!");

	new vehicleid = GetPlayerVehicleID(playerid);
	if(!GetPlayerVehicle(playerid))
		return SendClientMessage(playerid, COLOR_RED, "Вы должны быть в своем автомобиле");
	new Float:pos[4], g = GetPlayerGarage(playerid);
	GetVehiclePos(vehicleid,pos[0],pos[1],pos[2]);
	GetVehicleZAngle(vehicleid,pos[3]);

	new
		querys[256];

	if(GetPlayerGarage(playerid) != -1)
	{
		for(new i; i < 3; i++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 50.0, GaragesEnterCar[i][0], GaragesEnterCar[i][1], GaragesEnterCar[i][2]))
			{
				SendClientMessage(playerid,COLOR_LIME,"Личный транспорт успешно припаркован в гараже");

				mysql_format(db_prod, querys, 256, "UPDATE `ownable_cars` SET c_x = '%f', c_y = '%f', c_z = '%f', c_a = '%f', c_world = '%i'  WHERE `id` = '%i' LIMIT 1"
				, pos[0], pos[1], pos[2], pos[3], GarageInfo[g][g_WORLD], GetPlayerVehicleSqlID(playerid));
				mysql_tquery(db_prod, querys, "", "");
				return true;
			}
		}
	}
	if(IsPlayerInRangeOfPoint(playerid, 50.0, 1946.8455,1310.7291,3060.2183))
	{
		SendClientMessage(playerid,COLOR_LIME,"Личный транспорт успешно припаркован на парковке");
		mysql_format(db_prod, querys, 256, "UPDATE `ownable_cars` SET c_x = '%f', c_y = '%f', c_z = '%f', c_a = '%f', c_world = '%i'  WHERE `id` = '%i' LIMIT 1"
		, pos[0], pos[1], pos[2], pos[3], GetPlayerVirtualWorld(playerid), GetPlayerVehicleSqlID(playerid));
		mysql_tquery(db_prod, querys, "", "");
		return true;
	}
	mysql_format(db_prod, querys, 256, "UPDATE `ownable_cars` SET c_x = '%f', c_y = '%f', c_z = '%f', c_a = '%f', c_world = '0'  WHERE `id` = '%i' LIMIT 1"
	, pos[0], pos[1], pos[2], pos[3], GetPlayerVehicleSqlID(playerid));
	mysql_tquery(db_prod, querys, "", "");
	SendClientMessage(playerid,COLOR_LIME,"Личный транспорт успешно припаркован в этом месте");
	return 1;
}

cmd:ctune(playerid)
{
	if(!UsedCTO[playerid]) return 0;
	new bizzid = CTObizzid[playerid];
	if(GetPlayerState(playerid) != 2) return KickEx(playerid, "ctune");
	new pveh = GetPlayerVehicleID(playerid);
	SetVehiclePos(pveh,BizzInfo[bizzid][bEntrx],BizzInfo[bizzid][bEntry],BizzInfo[bizzid][bEntrz]);
	UsedCTO[playerid] = 0;
	SetVehicleZAngle(pveh,270.9845);
	SetPlayerInterior(playerid,0);
	SetPlayerVirtualWorld(playerid,0);
	SetVehicleVirtualWorld(pveh,0);
	LinkVehicleToInterior(pveh,0);
	PutPlayerInVehicle(playerid, pveh, 0);
	TogglePlayerControllable(playerid,true);
	SetCameraBehindPlayer(playerid);

	for(new i = 0; i != 11; i ++)
		TextDrawHideForPlayer(playerid, sto_td_global[i]);

	for(new i = 0; i != 2; i ++)
		PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);

	for(new idx; idx < 43; idx ++)
		TextDrawHideForPlayer(playerid, td_sto[idx]);

	for(new i = 0; i != sizeof tuning_menu_td; i ++)
		TextDrawHideForPlayer(playerid, tuning_menu_td[i]);

	if(PI[playerid][pSettingTD][2] == 1)
	{
		for(new i; i < 15; i++) TextDrawShowForPlayer(playerid, server_info_td[i]);
	}
	CancelSelectTextDrawEx(playerid);

	Speed_Show_Player(playerid);
	return 1;
}

cmd:healing(playerid, params[])
{
	new full = 0;
	for(new i = TOTALHOUSE; i > 0 ; i --)
	{
		if(IsPlayerInRangeOfPoint(playerid, 60.0, HouseInfo[i][hExitx], HouseInfo[i][hExity], HouseInfo[i][hExitz]))
		{
			if(HouseInfo[i][hVirtual] == GetPlayerVirtualWorld(playerid))
			{
				if(HouseInfo[i][hHeal] == 0) return SendClientMessage(playerid, COLOR_GREY, "В доме нет аптечек!");
				new Float:shealth;
				GetPlayerHealth(playerid, shealth);
				if(shealth >= 100) return SendClientMessage(playerid, -1, ""cER"Вы не нуждаетесь в лечении!");
				HouseInfo[i][hHeal]--;
				MysqlUpdateHouseInt(i, "hHeal", HouseInfo[i][hHeal]);
				SetPlayerHealth(playerid, shealth+25);
				GetPlayerHealth(playerid, shealth);
				if(shealth > 100) SetPlayerHealth(playerid, 100);
				SendMes(playerid, COLOR_BLUE, "Вы использовали 1 аптечку. Осталось %d аптечек", HouseInfo[i][hHeal]);
				MeAction(playerid, "использовал аптечку");
				full++;
			}
		}
	}
	if(full == 0) SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в доме!");
	return 1;
}

cmd:afk(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	new list,full,str[100],sttr[2000];
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pAFK] >= 3) list++;
	}
	format(str,sizeof(str),"{FF6347}Всего в AFK - %d игрок(ов)\n\n",list);
	strcat(sttr, str);
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pAFK] >= 3)
		{
			format(str,sizeof(str),""cWH"%s[%d] - {FF6347}AFK: %s\n",GetName(i), i, ConvertSeconds(PI[i][pAFK]));
			strcat(sttr, str);
			full++;
		}
	}
	if(full == 0) strcat(sttr, ""cWH"Информация не найдена");
	ShowPlayerDialog(playerid,0,DIALOG_STYLE_MSGBOX,""cWH"AFK",sttr,"Закрыть","");
	fLogs("[admin] %s /afk", GetName(playerid));
	return 1;
}

cmd:wanted(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new full, str[150], sttr[2000];
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pWanted] > 0)
		{
			format(str,sizeof(str),"{ffff00}%s - "cWH"Звезд: {ffff00}%d, "cWH"обвинение: {ffff00}%s, "cWH"доложил: {ffff00}%s\n",GetName(i), PI[i][pWanted], PI[i][pWantedReason], PI[i][pWantedWho]);
			strcat(sttr, str);
			full++;
		}
	}
	if(full == 0) strcat(sttr, "Информация не найдена");
	ShowPlayerDialog(playerid,0,DIALOG_STYLE_MSGBOX,"Внимание, в розыске!",sttr,"Закрыть","");
	return 1;
}

cmd:wedding(playerid, params[])
{
	if(PI[playerid][pMarried] == 1) return SendClientMessage(playerid, COLOR_GREY, "Вы уже связаны узами брака!");
	if(!IsPlayerInRangeOfPoint(playerid,5.0, 2000.0297,1498.1522,1601.0000)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться у ЗАГС'а!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/wedding [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(playerid == params[0]) return SendClientMessage(playerid, -1, ""cER"Ты не можешь заключить брак сам с собой!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(PI[params[0]][pMarried] == 1) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже связан узами брака!");

	format(string, sizeof(string), "Вы предложили %s заключить брачный договор", GetName(params[0]));
	SendClientMessage(playerid, COLOR_BLUE, string);
	if(PI[playerid][pSex] == 1)
	{
		format(string, sizeof(string), "%s предложил Вам заключить брачный договор", GetName(playerid));
		SendClientMessage(params[0], COLOR_BLUE, string);
		format(string, sizeof(string), ""cWH"%s предложил Вам заключить брачный договор\n\nВы согласны?", GetName(playerid));
		ShowPlayerDialog(params[0], 106+19, 0, "{FF6666}Свадьба", string, "Да", "Нет");
	}
	else
	{
		format(string, sizeof(string), "%s предложила Вам заключить брачный договор", GetName(playerid));
		SendClientMessage(params[0], COLOR_BLUE, string);
		format(string, sizeof(string), ""cWH"%s предложила Вам заключить брачный договоре\n\nВы согласны?", GetName(playerid));
		ShowPlayerDialog(params[0], 106+19, 0, "{FF6666}Свадьба", string, "Да", "Нет");
	}
	PlayerMarriage[params[0]] = playerid;
	return 1;
}

callback::OnPlayerOffDivorce(playerid)
{
	if(cache_num_rows())
	{
		new whomarried[24];
		cache_get_field_content(0, "whomarried", whomarried, db_prod, 24);

		if(GetPlayerID(whomarried) != INVALID_PLAYER_ID)
		return SendClientMessage(playerid, COLOR_RED, "Игрок в сети");

		format(stringer1, 144, "UPDATE accounts SET married=0, whomarried='None' WHERE name='%s' AND name='%s'", GetName(playerid), whomarried);
		mysql_tquery(db_prod, stringer1);
		SCMF(playerid, 0xFFCC00AA, "Вы успешно развелись с %s", whomarried);

		strmid(PI[playerid][pWhoMarried], "None", 0, strlen("None"), MAX_PLAYER_NAME);
		PI[playerid][pMarried] = 0;
		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET married=0, whomarried='None' WHERE id=%d", PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1);
	}
	else SendClientMessage(playerid, COLOR_RED, "В базе данных не найден автомобиль с таким номером");
	return 1;
}

CMD:offdivorce(playerid, params[])
{
	if(!PI[playerid][pMarried]) return SendClientMessage(playerid, COLOR_RED, "Вы не связаны узами брака");
	format(stringer1, 128, "SELECT whomarried FROM accounts WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "OnPlayerOffDivorce", "i", playerid);
	return 1;
}

cmd:divorce(playerid, params[])
{
	if(PI[playerid][pMarried] == 0) return SendClientMessage(playerid, -1, ""cER"Вы не связаны узами брака!");
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, 2000.0297,1498.1522,1601.0000)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться у церкви!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/divorce [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(playerid == params[0]) return SendClientMessage(playerid, -1, ""cER"Ты не можешь разорвать брак сам с собой!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(!strcmp(GetName(params[0]), PI[playerid][pWhoMarried], true))
	{
		format(string, sizeof(string), "Вы предложили %s развестись", GetName(params[0]));
		SendClientMessage(playerid, COLOR_BLUE, string);
		if(PI[playerid][pSex] == 1)
		{
			format(string, sizeof(string), "%s предложил Вам развестись", GetName(playerid));
			SendClientMessage(params[0], COLOR_BLUE, string);
			format(string, sizeof(string), ""cWH"%s предложил Вам развестись\n\nВы согласны?", GetName(playerid));
			ShowPlayerDialog(params[0], 106+20, 0, "{F04245}Развод", string, "Да", "Нет");
		}
		else
		{
			format(string, sizeof(string), "%s предложила Вам развестись", GetName(playerid));
			SendClientMessage(params[0], COLOR_BLUE, string);
			format(string, sizeof(string), ""cWH"%s предложила Вам развестись\n\nВы согласны?", GetName(playerid));
			ShowPlayerDialog(params[0], 106+20, 0, "{F04245}Развод", string, "Да", "Нет");
		}
		PlayerMarriage[params[0]] = playerid;
	}
	else SendClientMessage(playerid, COLOR_GREY, "Игрок не связам узами брака с вами!");
	return 1;
}

CMD:v(playerid,params[])
{
	if(TYPE_VIP[playerid] == VIP_STATE_NONE) return 0x1;
	if(VipData[TYPE_VIP[playerid]][VipChat] == 0) return 0x1;
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, -1, ""cER"У вас бан чата");
	if(PlayerVipFix[playerid] > gettime()) return SendClientMessage(playerid, -1, ""cER"Писать в V.I.P чат можно раз в 15 секунд");
	if(isnull(params) || strlen(params) > 144) return SendClientMessage(playerid, 0xCCCCCCFF, "Используйте: {FFFFFF}/v [текст]");

	new string_vip[128];
	foreach(new i:Player)
	{
		if(PlayerLogged[i] == true &&  TYPE_VIP[i] != VIP_STATE_NONE)
		{
			format(string_vip, sizeof(string_vip), "[VIP] %s [%d]: %s", GetName(playerid), playerid, params);
			SendClientMessage(i, COLOR_BLUE, string_vip);
		}
	}
	PlayerVipFix[playerid] = gettime() + 15;
	return 1;
}

