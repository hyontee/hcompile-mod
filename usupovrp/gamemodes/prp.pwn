DLG(1000, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			PI[playerid][pSpawnChange] = 0;
		}
	case 1:
		{
			if(!GetPlayerHouse(playerid)) return SendClientMessage(playerid, -1, ""cER"У вас нет дома!");
			PI[playerid][pSpawnChange] = 1;
		}
	case 2:
		{
			if(!PI[playerid][pMember]) return SendClientMessage(playerid, -1, ""cER"Вы не состоите в организации!");
			PI[playerid][pSpawnChange] = 2;
		}
	case 3:
		{
			if(GetPlayerRooms(playerid) == 0) return SendClientMessage(playerid, COLOR_GREY, "У вас нет квартиры!");
			PI[playerid][pSpawnChange] = 3;
		}
	case 4:
		{
			if(!PI[playerid][pFamily]) return SendClientMessage(playerid, COLOR_GREY, "Вы не являетесь членом какой-либо семьи");
			if(!family_info[PI[playerid][pFamily]][f_spawn]) return SendClientMessage(playerid, COLOR_GREY, "Глава семьи не разрешил появляться у него дома");
			PI[playerid][pSpawnChange] = 4;
			GetCreatorHouseID(playerid);
		}
	case 5:
		{
			if(!GetPlayerArend(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Вас никто у себя не поселил");
			PI[playerid][pSpawnChange] = 5;
		}
	}
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=%d WHERE id=%d", listitem, PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1);

	SendClientMessage(playerid, -1, ""cDA"Ваше место появления в игре изменено");
	return 1;
}
DLG(1200, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0: ShowPlayerDialog(playerid, 1200+1, DIALOG_STYLE_INPUT, ""cMain"Обменять деньги на фишки", ""cWH"Введите количество фишек, которые хотите обменять\n\t1 рубль - 1 фишка", "Далее", "Назад");
	case 1: ShowPlayerDialog(playerid, 1200+2, DIALOG_STYLE_INPUT, ""cMain"Обменять фишки на деньги", ""cWH"Введите количество денег, которые хотите обменять\n\t1 фишка - 1 рубль", "Далее", "Назад");
	}
	return 1;
}
DLG(1201, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(strval(inputtext) < 1000 || strval(inputtext) > 10000000) return SendClientMessage(playerid, COLOR_GREY, "Количество от 1.000 фишки до 10.000.000 фишек!");
	if(GetPlayerRubble(playerid) < strval(inputtext)) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
	new idx = GetPlayerInBiz(playerid);
	if(idx == -1) return SendErr(playerid, "Вы не в бизнесе");
	SetPlayerMoney(playerid, -strval(inputtext));

	format(string, sizeof(string), "Вы приобрели "cWH"%d фишек{ffff00} за "cWH"%dр!", strval(inputtext), strval(inputtext));
	SendClientMessage(playerid, COLOR_YELLOW, string);
	format(string, sizeof(string), "+%dФ", strval(inputtext));
	GameTextForPlayer(playerid, string, 3000, 1);
	PhoneNumbers[playerid][0] += strval(inputtext);
	if(BizzInfo[idx][bMoney] >= strval(inputtext)/500)
	{
		BizzInfo[idx][bMoney] += strval(inputtext)/500;
		MysqlUpdateBizzInt(idx, "money", BizzInfo[idx][bMoney]);
	}
	return 1;
}
DLG(1202, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(strval(inputtext) < 1000 || strval(inputtext) > 10000000) return SendClientMessage(playerid, COLOR_GREY, "Количество от 1.000 фишки до 10.000.000 фишек!");
	if(PhoneNumbers[playerid][0] < strval(inputtext)) return SendClientMessage(playerid, -1, ""cER"У вас не хватает фишек!");
	new idx = GetPlayerInBiz(playerid);
	if(idx == -1) return SendErr(playerid, "Вы не в бизнесе");
	PhoneNumbers[playerid][0] -= strval(inputtext);

	format(string, sizeof(string), "Вы обменяли "cWH"%d фишек{ffff00} на "cWH"%dр!", strval(inputtext), strval(inputtext));
	SendClientMessage(playerid, COLOR_YELLOW, string);
	format(string, sizeof(string), "+%dр", strval(inputtext));
	GameTextForPlayer(playerid, string, 3000, 1);
	SetPlayerMoney(playerid, strval(inputtext));
	if(BizzInfo[idx][bMoney] >= strval(inputtext)/750)
	{
		BizzInfo[idx][bMoney] -= strval(inputtext)/750;
		MysqlUpdateBizzInt(idx, "money", BizzInfo[idx][bMoney]);
	}
	return 1;
}
DLG(400, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится за рулем своего авто!");
		foreach(new i : Player)
		{
			if(i != playerid)
			{
				if(GetPlayerState(i) == PLAYER_STATE_PASSENGER && IsPlayerInVehicle(i, GetPlayerVehicleID(playerid)))
				{
					return SCM(playerid, -1, "Заезд в СТО с пассажирами запрещен");
				}
			}
		}

		new pveh = GetPlayerVehicleID(playerid);
		SetVehiclePos(pveh, -203.2737, 164.4404, 1200.6191);
		SetVehicleZAngle(pveh, 0);
		SetPlayerInterior(playerid, 24);
		SetPlayerVirtualWorld(playerid, playerid);
		SetVehicleVirtualWorld(pveh, playerid);
		LinkVehicleToInterior(pveh, 24);
		PutPlayerInVehicle(playerid, pveh, 0);
		SetPlayerCameraPos(playerid, -207.0780, 168.9628, 1201.9812);
		SetPlayerCameraLookAt(playerid, -206.4904, 168.1556, 1201.7128);
		TogglePlayerControllable(playerid, false);
		Speed_Hide_Player(playerid);
		if(PI[playerid][pSettingTD][2] == 1)
		{
			for(new i; i < 15; i++) TextDrawHideForPlayer(playerid, server_info_td[i]);
		}
		UsedCTO[playerid] = 1;

		SendClientMessage(playerid, 0xFFCC00AA, "Чтобы удалить тюнинг с авто введите команду "cWH"/rtune");
		for(new idx; idx < 43; idx++) TextDrawShowForPlayer(playerid, td_sto[idx]);

		for(new i = 0; i != sizeof tuning_menu_td; i ++)
			TextDrawShowForPlayer(playerid, tuning_menu_td[i]);

		SelectTextDrawEx(playerid, -1);
	}
	return 1;
}
