		VipData[i][VipExp] 			= cache_get_field_content_int(i, "EXP");
		VipData[i][VipWork] 		= cache_get_field_content_int(i, "WORK");
		VipData[i][VipSkin] 		= cache_get_field_content_int(i, "SKIN");
		VipData[i][VipBizz] 		= cache_get_field_content_int(i, "BIZZ");
		VipData[i][VipChat] 		= cache_get_field_content_int(i, "CHAT");
		VipData[i][VipCall] 		= cache_get_field_content_int(i, "CALL");
		VipData[i][VipHouse] 		= cache_get_field_content_int(i, "HOUSE");
		VipData[i][VipAdmin] 		= cache_get_field_content_int(i, "ADMIN");
		VipData[i][VipDrugs] 		= cache_get_field_content_int(i, "DRUGS");
		VipData[i][VipBonus] 		= cache_get_field_content_int(i, "BONUS");
		VipData[i][VipPhone] 		= cache_get_field_content_int(i, "PHONE");
		VipData[i][VipIznas] 		= cache_get_field_content_int(i, "IZNAS");
		VipData[i][VipBottle]       = cache_get_field_content_int(i, "BOTTLE");
