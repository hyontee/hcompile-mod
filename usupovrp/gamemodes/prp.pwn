DLG(10003, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		if(!goto_gps[playerid]) callcmd::gps(playerid, inputtext);
		else callcmd::tp(playerid);
		return 1;
	}
	new locname[30], Float:X, Float:Y, Float:Z;
	switch(listitem)
	{
	case 0: X = 1908.5549, Y = -2243.0327, Z = 11.0945, locname = "Администрация г.Южный";
	case 1: X = 2583.6091, Y = -2416.6177, Z = 21.7985, locname = "Полиция г. Южный (МВД)";
	case 2: X = 2114.1262, Y = -2385.7788, Z = 21.9430, locname = "Центральная Больница";
	case 3: X = -2548.0159, Y = -675.8547, Z = 29.4547, locname = "Армия";
	case 4: X = -317.8824, Y = 825.1603, Z = 13.0635, locname = "СМИ";
	case 5: X = 2412.6230, Y = -1847.4076, Z = 21.8567, locname = "ФСБ";
	}
	if(!goto_gps[playerid]) GPSPlayer_(playerid, X, Y, Z, locname);
	else SetPlayerPos(playerid, X, Y, Z), SetPlayerInterior(playerid, 0), SetPlayerVirtualWorld(playerid, 0);
	return 1;
}
