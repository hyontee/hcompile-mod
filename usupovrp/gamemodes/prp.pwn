	return 1;
}

callback::callback_offmembers ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		ofm_list_page[playerid] = 0;
		return 1 ;
	}
	new rows_list = ofm_list_page[playerid] - 1;
	ofm_list_rows[playerid] = rows;
	new line_string [ MAX_PLAYER_NAME + 37 ],
	pl_ofm_name [ 24 ],
	pl_ofm_rank,
	pl_ofm_online [ 16 ] ;

	new dialog_string [ 10 * sizeof(line_string) + 50 ] ;
	strcat ( dialog_string, "{C1C1C1}<<<<\n{C1C1C1}>>>>\n" ) ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

		cache_get_field_content ( i, "name", pl_ofm_name, db_prod, 24 ) ;
		pl_ofm_rank = cache_get_field_content_int ( i, "rank", db_prod ) ;
		cache_get_field_content ( i, "datavhod", pl_ofm_online, db_prod, 16 ) ;

		g_player_members_name[ i - rows_list * 10 ][playerid][0] = EOS;
		strcat(g_player_members_name[ i - rows_list * 10 ][playerid], pl_ofm_name);

		format ( line_string, sizeof ( line_string ), "Последний вход: %s\tРанг: %d\tИмя: %s\n", pl_ofm_online, pl_ofm_rank, pl_ofm_name) ;
		strcat ( dialog_string, line_string ) ;

	}

	ShowPlayerDialog ( playerid, 19020, DIALOG_STYLE_LIST, ""cMain"Члены организации оффлайн", dialog_string, "Выбрать", "Назад" ) ;
	return 1 ;
}

callback::KickMemberFromFraction(playerid, name[])
{
	new r, f;
	cache_get_data(r, f);
	if(!r) return 1;

	new leader = cache_get_field_content_int(0, "leader");
	if(leader != 0) return SendClientMessage(playerid, COLOR_RED, "Вы не можете уволить лидера!");

	global_string = "";

	mysql_format(db_prod, global_string, 200, "UPDATE `accounts` SET leader = '0', member = '0', rank = '0', memberskin = '0', spawnchange = '0' WHERE name = '%s' LIMIT 1",name);
	mysql_tquery(db_prod, global_string, "", "");

	SendMes(playerid, COLOR_GREEN, "Вы уволили %s из организации", name);

	global_string = "";
	mysql_format ( db_prod, global_string, 140, "SELECT `name`,`rank`,`datavhod` FROM `accounts` WHERE `member` = '%d' AND `online` = '1001'", PI[playerid][pMember]) ;
	mysql_tquery ( db_prod, global_string, "callback_offmembers", "i", playerid ) ;

	return 1;
}

callback::OfflineUninviteOnFraction(playerid)
{
	new rows, fields, Names[MAX_PLAYER_NAME], leader;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, COLOR_GRAD1, "Не найдено совпадений!");
	cache_get_field_content(0, "name", Names, db_prod, 32);
	leader = cache_get_field_content_int(0, "leader");
	if(leader != 0) return SendClientMessage(playerid, COLOR_RED, "Вы не можете уволить лидера!");

	format(global_string, 256, "UPDATE `accounts` SET leader = '0', member = '0', rank = '0', memberskin = '0', spawnchange = '0', mainsub=0 WHERE name = '%s' LIMIT 1",Names);
	mysql_tquery(db_prod, global_string, "", "");
	format(string, sizeof(string), "Вы уволили игрока %s", Names);
	SendClientMessage(playerid, COLOR_RED, string);
	return 1;
}

