}

callback::LoadATM()
{
	new time = GetTickCount(), rows = cache_num_rows();
	if(rows)
	{
		for(new idx = 1; idx <= rows; idx++)
		{
			ATMInfo[idx][aID] = cache_get_field_content_int(idx-1, "ID");
			ATMInfo[idx][aX] = cache_get_field_content_float(idx-1, "aX");
			ATMInfo[idx][aY] = cache_get_field_content_float(idx-1, "aY");
			ATMInfo[idx][aZ] = cache_get_field_content_float(idx-1, "aZ");
			ATMInfo[idx][arX] = cache_get_field_content_float(idx-1, "arX");
			ATMInfo[idx][arY] = cache_get_field_content_float(idx-1, "arY");
			ATMInfo[idx][arZ] = cache_get_field_content_float(idx-1, "arZ");
			TOTALATM++;
			ATM[idx] = 	CreateDynamicObject(11135, ATMInfo[idx][aX], ATMInfo[idx][aY], ATMInfo[idx][aZ], ATMInfo[idx][arX], ATMInfo[idx][arY], ATMInfo[idx][arZ]);
			LABELATM[idx] = CreateDynamic3DTextLabel("Банкомат\n"cWH"Нажмите: ALT", 0xBBBBBBFF, ATMInfo[idx][aX],ATMInfo[idx][aY],ATMInfo[idx][aZ]+1.1,10.0);
		}
	}
	printf("[Загружено банкоматов]: <%d>. Потрачено: <%d ms>.", TOTALATM, GetTickCount() - time);
	return 1;
}

callback::LoadBizz()
{
	new time = GetTickCount(), rows = cache_num_rows(), type;
	for(new i; i < TOTALBIZZ; i++) strmid(BizzInfo[i][bOwner],"None",0,strlen("None"),MAX_PLAYER_NAME);
	if(rows)
	{
		for(new idx = 1; idx <= rows; idx++)
		{
			BizzInfo[idx][bID] = cache_get_field_content_int(idx-1, "id");
			cache_get_field_content(idx-1, "owner", BizzInfo[idx][bOwner], db_prod, MAX_PLAYER_NAME);
			BizzInfo[idx][bOwned] = cache_get_field_content_int(idx-1, "owned");
			BizzInfo[idx][bType] = cache_get_field_content_int(idx-1, "type");

			type = BizzInfo[idx][bType];
			type -= 1;

			BizzInfo[idx][bPrice] = cache_get_field_content_int(idx-1, "price");
			BizzInfo[idx][bBuyPrice] = cache_get_field_content_int(idx-1, "buyprice");
			BizzInfo[idx][bMoney] = cache_get_field_content_int(idx-1, "money");

			// - TODO
			BizzInfo[idx][bEntrx] = cache_get_field_content_float(idx-1, "x");
			BizzInfo[idx][bEntry] = cache_get_field_content_float(idx-1, "y");
			BizzInfo[idx][bEntrz] = cache_get_field_content_float(idx-1, "z");

			if(type == 4)
			{
				BizzInfo[idx][bExitx] = g_business_info[type + 1][0];
				BizzInfo[idx][bExity] = g_business_info[type + 1][1];
				BizzInfo[idx][bExitz] = g_business_info[type + 1][2];
				BizzInfo[idx][bMenux] = g_business_info[type + 1][3];
				BizzInfo[idx][bMenuy] = g_business_info[type + 1][4];
				BizzInfo[idx][bMenuz] = g_business_info[type + 1][5];
			}
			else if(type == 1)
			{
				BizzInfo[idx][bExitx] = -111.9175;
				BizzInfo[idx][bExity] = -40.4628;
				BizzInfo[idx][bExitz] = 1298.0078;
			}
			else
			{
				BizzInfo[idx][bExitx] = g_business_info[type][0];
				BizzInfo[idx][bExity] = g_business_info[type][1];
				BizzInfo[idx][bExitz] = g_business_info[type][2];
				BizzInfo[idx][bMenux] = g_business_info[type][3];
				BizzInfo[idx][bMenuy] = g_business_info[type][4];
				BizzInfo[idx][bMenuz] = g_business_info[type][5];
			}
			BizzInfo[idx][bInt] = cache_get_field_content_int(idx-1, "vint");
			BizzInfo[idx][bVirtual] = cache_get_field_content_int(idx-1, "virt");
			BizzInfo[idx][bMIcon] = cache_get_field_content_int(idx-1, "icon");
			cache_get_field_content(idx-1, "name", BizzInfo[idx][bName], db_prod, 32);
			BizzInfo[idx][bEnter] = cache_get_field_content_int(idx-1, "penter");
			BizzInfo[idx][bLock] = cache_get_field_content_int(idx-1, "block");
			BizzInfo[idx][bProduct] = cache_get_field_content_int(idx-1, "product");
			BizzInfo[idx][bTill] = cache_get_field_content_int(idx-1, "till");
			BizzInfo[idx][bLockTime] = cache_get_field_content_int(idx-1, "locktime");
			BizzInfo[idx][bMafia] = cache_get_field_content_int(idx-1, "mafia");
			BizzInfo[idx][bOplata] = cache_get_field_content_int(idx-1, "oplata");
			BizzInfo[idx][bUpdate] = cache_get_field_content_int(idx-1, "update_biz");
			switch(BizzInfo[idx][bMafia])
			{
				case TEAM_ITALMAFIA: MafiaTotalBizz[0]++;
				case TEAM_RUSMAFIA: MafiaTotalBizz[1]++;
			}
			BizzInfo[idx][bIcon] = CreateDynamicMapIcon(BizzInfo[idx][bEntrx],BizzInfo[idx][bEntry],BizzInfo[idx][bEntrz], BizzInfo[idx][bMIcon], 0);
			new fee[64];
			if(BizzInfo[idx][bEnter] == 0) fee = "Бесплатный";
			else format(fee, sizeof(fee), "%dр", BizzInfo[idx][bEnter]);
			if(BizzInfo[idx][bType] != 2 && BizzInfo[idx][bType] != 7)
			{
				BizzInfo[idx][bPickup] = CreatePickup(19132,1, BizzInfo[idx][bEntrx],BizzInfo[idx][bEntry],BizzInfo[idx][bEntrz],-1);
				BizzInfo[idx][bPickupExit] = CreatePickup(19132,1,BizzInfo[idx][bExitx], BizzInfo[idx][bExity], BizzInfo[idx][bExitz],BizzInfo[idx][bVirtual]);
				BizzInfo[idx][bMenu] = CreateDynamicSphere(BizzInfo[idx][bMenux],BizzInfo[idx][bMenuy],BizzInfo[idx][bMenuz],1.0,BizzInfo[idx][bVirtual],BizzInfo[idx][bInt]);
				if(BizzInfo[idx][bType] == 8) CreatePickup(1275,1,BizzInfo[idx][bMenux],BizzInfo[idx][bMenuy],BizzInfo[idx][bMenuz],BizzInfo[idx][bVirtual]);
				else CreatePickup(1274,1,BizzInfo[idx][bMenux],BizzInfo[idx][bMenuy],BizzInfo[idx][bMenuz],BizzInfo[idx][bVirtual]);
				if(!strcmp(BizzInfo[idx][bOwner],"None",true))
				{
					format(string, sizeof(string), "{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: "cMain"%dр\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bPrice], BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
					LABELBIZZ[idx] = CreateDynamic3DTextLabel(string,-1,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz]+0.5,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
				}
				else
				{
					format(string, sizeof(string), "{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Вход: "cMain"%s\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bOwner], fee, BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
					LABELBIZZ[idx] = CreateDynamic3DTextLabel(string,-1,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz]+0.5,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
				}
			}
			else if(BizzInfo[idx][bType] == 2)
			{
				if(!strcmp(BizzInfo[idx][bOwner],"None",true))
				{
					format(string, sizeof(string), "{ffcc33}H - Меню АЗС\n\n{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\n"cWH"Цена за 1 литр бензина: "cMain"%dр\n"cWH"Купить канистру: /buyfuel\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bPrice], BizzInfo[idx][bTill] / 3, BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
					LABELBIZZ[idx] = CreateDynamic3DTextLabel(string,-1,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz]+1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID);
				}
				else
				{
					format(string, sizeof(string), "{ffcc33}H - Меню АЗС\n\n{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Цена за 1 литр бензина: "cMain"%dp\n"cWH"Купить канистру: /buyfuel\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bOwner], BizzInfo[idx][bTill] / 3, BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
					LABELBIZZ[idx] = CreateDynamic3DTextLabel(string,-1,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz]+1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID);
				}
			}
			else
			{
				if(!strcmp(BizzInfo[idx][bOwner],"None",true))
				{
					format(string, sizeof(string), "{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\n"cWH"Цена за 1 запчасть - "cMain"%dр\n\n{ffcc33}H - Заехать в СТО\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bPrice], BizzInfo[idx][bTill], BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
					LABELBIZZ[idx] = CreateDynamic3DTextLabel(string,-1,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
				}
				else
				{
					format(string, sizeof(string), "{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Цена за 1 запчасть - "cMain"%dр\n\n{ffcc33}H - Заехать в СТО\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bOwner], BizzInfo[idx][bTill], BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
					LABELBIZZ[idx] = CreateDynamic3DTextLabel(string,-1,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
				}
			}

			if(BizzInfo[idx][bType] == 3) SetHookLabel(idx);

			TOTALBIZZ++;

			ClearHookAllPos(idx);
			for(new slot; slot < 8; slot ++) ClearHookPos(idx, slot);

		}
	}
	printf("[Загружено бизнесов]: <%d>. Потрачено: <%d ms>.", TOTALBIZZ,GetTickCount() - time);
	return 1;
}

callback::LoadHouse()
{
	new temp[80], time = GetTickCount(), rows = cache_num_rows();
	for(new i = TOTALHOUSE; i > 0; i --) strmid(HouseInfo[i][hOwner],"None",0,strlen("None"),MAX_PLAYER_NAME);
	if(rows)
	{
		for(new idx = 1; idx <= rows; idx++)
		{
			HouseInfo[idx][hID] = cache_get_field_content_int(idx-1, "id");
			HouseInfo[idx][hEntrx] = cache_get_field_content_float(idx-1, "hEntrx");
			HouseInfo[idx][hEntry] = cache_get_field_content_float(idx-1, "hEntry");
			HouseInfo[idx][hEntrz] = cache_get_field_content_float(idx-1, "hEntrz");

			HouseInfo[idx][hDiscript] = cache_get_field_content_int(idx-1, "hDiscript");

			if(HouseInfo[idx][hDiscript] == 1) {
				HouseInfo[idx][hExitx] = 1098.2213;
				HouseInfo[idx][hExity] = 293.8798;
				HouseInfo[idx][hExitz] = 1401.0000;
			}
			else if(HouseInfo[idx][hDiscript] == 2) {
				HouseInfo[idx][hExitx] = 1403.4792;
				HouseInfo[idx][hExity] = 295.3107;
				HouseInfo[idx][hExitz] = 1401.0000;
			}
			//2415.6943,286.3324
			else if(HouseInfo[idx][hDiscript] == 3) {
				HouseInfo[idx][hExitx] = 2415.6943;
				HouseInfo[idx][hExity] = 286.3324;
				HouseInfo[idx][hExitz] = 1401.0000;

			}

			cache_get_field_content(idx-1, "hOwner", HouseInfo[idx][hOwner], db_prod, MAX_PLAYER_NAME);
			HouseInfo[idx][hOwned] = cache_get_field_content_int(idx-1, "hOwned");
			HouseInfo[idx][hPrice] = cache_get_field_content_int(idx-1, "hPrice");
			HouseInfo[idx][hType] = cache_get_field_content_int(idx-1, "hType");
			HouseInfo[idx][hBuyPrice] = cache_get_field_content_int(idx-1, "buyprice");
			HouseInfo[idx][hInt] = cache_get_field_content_int(idx-1, "hInt");
			HouseInfo[idx][hVirtual] = cache_get_field_content_int(idx-1, "hVirtual");
			HouseInfo[idx][hLock] = cache_get_field_content_int(idx-1, "hLock");
			HouseInfo[idx][hOplata] = cache_get_field_content_int(idx-1, "hOplata");
			HouseInfo[idx][hHeal] = cache_get_field_content_int(idx-1, "hHeal");
			HouseInfo[idx][hGarage] = cache_get_field_content_int(idx-1, "hGarage");
			HouseInfo[idx][hAutoDoors] = cache_get_field_content_int(idx-1, "hAutoDoors");
			HouseInfo[idx][hCS] = cache_get_field_content_int(idx-1, "hCS");
			HouseInfo[idx][hMoney] = cache_get_field_content_int(idx-1, "hMoney");
			HouseInfo[idx][hPatrons] = cache_get_field_content_int(idx-1, "hPatrons");
			HouseInfo[idx][hDrugs] = cache_get_field_content_int(idx-1, "hDrugs");
			HouseInfo[idx][hRublevka] = cache_get_field_content_int(idx-1, "hRublevka");
			HouseInfo[idx][helicopter_housepos][0] = cache_get_field_content_float(idx-1, "hVertX");
			HouseInfo[idx][helicopter_housepos][1] = cache_get_field_content_float(idx-1, "hVertY");
			HouseInfo[idx][helicopter_housepos][2] = cache_get_field_content_float(idx-1, "hVertZ");
			HouseInfo[idx][helicopter_housepos][3] = cache_get_field_content_float(idx-1, "hVertA");
			cache_get_field_content(idx-1, "hArendName", temp), sscanf(temp, "p<,>s[24]s[24]s[24]", HouseArendName[idx][0], HouseArendName[idx][1], HouseArendName[idx][2]);

			if(!strcmp(HouseInfo[idx][hOwner],"None",true))
			{
				HouseInfo[idx][hMIcon] = CreateDynamicMapIcon(HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz], 31, 0);
				HouseInfo[idx][hPickup] = CreatePickup(1273, 1, HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz],-1);
			}
			else
			{
				HouseInfo[idx][hMIcon] = CreateDynamicMapIcon(HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz], 32, 0);
				HouseInfo[idx][hPickup] = CreatePickup(1272, 1, HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz],-1);
			}
			if(!HouseInfo[idx][hAutoDoors])
			{
				HouseInfo[idx][hPickupExit] = CreateDynamic3DTextLabel(""cWH"Для выхода введите:\n"cMain"/exit\n"cWH"Управление домом: \n"cMain"/home",COLOR_WHITE,HouseInfo[idx][hExitx], HouseInfo[idx][hExity], HouseInfo[idx][hExitz],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,HouseInfo[idx][hVirtual],HouseInfo[idx][hInt]);
			}
			else
			{
				HouseInfo[idx][hPickupExit] = CreateDynamic3DTextLabel(""cWH"Для выхода используйте:\n "cMain"ALT\n"cWH"Управление домом: \n"cMain"/home",COLOR_WHITE,HouseInfo[idx][hExitx], HouseInfo[idx][hExity], HouseInfo[idx][hExitz],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,HouseInfo[idx][hVirtual],HouseInfo[idx][hInt]);
			}
			TOTALHOUSE++;
			//UpdateCupboard(idx);
		}
	}
	printf("[Загружено домов]: <%d>. Потрачено: <%d ms>.", TOTALHOUSE, GetTickCount() - time);
	return 1;
}

callback::LoadMafia()
{
	new time = GetTickCount(), rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		FracBank[5] = cache_get_field_content_int(0, "yakuzabank");
		FracBank[6] = cache_get_field_content_int(0, "lcnbank");
		FracBank[7] = cache_get_field_content_int(0, "rmbank");
		DrugsBank[TEAM_RUSMAFIA] = cache_get_field_content_int(0, "yakuzadrugs");
		DrugsBank[TEAM_ITALMAFIA] = cache_get_field_content_int(0, "lcndrugs");
		MafiaPatr[0] = cache_get_field_content_int(0, "lcnpat");
		MafiaPatr[1] = cache_get_field_content_int(0, "yakpat");
		MafiaPatr[2] = cache_get_field_content_int(0, "rmpat");
		MafiaEd[0] = cache_get_field_content_int(0, "lcned");
		MafiaEd[1] = cache_get_field_content_int(0, "yaked");
		MafiaEd[2] = cache_get_field_content_int(0, "rmed");
		b_Sklad{5} = cache_get_field_content_int(0, "bskl_l");
		b_Sklad{6} = cache_get_field_content_int(0, "bskl_y");
		b_Sklad{7} = cache_get_field_content_int(0, "bskl_r");
	}
	printf("[Загружены склады мафий]: Потрачено: <%d ms>.", GetTickCount() - time);
	return 1;
}

callback::LoadGang()
{
	new time = GetTickCount(), rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		FracBank[0] = cache_get_field_content_int(0, "grovebank");
		FracBank[1] = cache_get_field_content_int(0, "ballasbank");
		FracBank[2] = cache_get_field_content_int(0, "rifabank");
		FracBank[3] = cache_get_field_content_int(0, "aztecbank");
