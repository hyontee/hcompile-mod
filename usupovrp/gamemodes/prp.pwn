DLG(5204, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new targetid, price;
	if(sscanf(inputtext, "ui", targetid, price)) return ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"Перевод", ""cWH"Введите ник игрока и количество денег через запятую\n\nПример: Ivan_Ivanov, 10000", "Принять", "Назад");
	if(!IsPlayerConnected(targetid))
	{
		ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"Перевод", ""cWH"Введите ник игрока и количество денег через запятую\n\nПример: Ivan_Ivanov, 10000", "Принять", "Назад");
		return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	}
	if(PlayerLogged[targetid] == false)
	{
		ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"Перевод", ""cWH"Введите ник игрока и количество денег через запятую\n\nПример: Ivan_Ivanov, 10000", "Принять", "Назад");
		return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	}
	if(g_player_bank_accounts[playerid][ PI[playerid][pMainBankAccount] ][B_BALANCE] < price)
	{
		ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"Перевод", ""cWH"Введите ник игрока и количество денег через запятую\n\nПример: Ivan_Ivanov, 10000", "Принять", "Назад");
		return SendClientMessage(playerid, COLOR_GREY, "На вашем счету в банке не хватает денег!");
	}
	if(price < 1) return ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"Перевод", ""cWH"Введите ник игрока и количество денег через запятую\n\nПример: Ivan_Ivanov, 10000", "Принять", "Назад");

	if(!strcmp(PI[targetid][pIP], PI[playerid][pIP], true))
	{
		SendClientMessage(playerid, -1, "* Передача денежных средств на мультиаккаунты запрещена.");
		return 1;
	}

	if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 12)
		return SendClientMessage(playerid, COLOR_RED, "Вам нужно отыграть 12 часов для совершения обмена");

	if(PI[targetid][pLevel] == BONUS_LVL && PI[targetid][pExp] < 12)
		return SendClientMessage(playerid, COLOR_RED, "Игроку нужно отыграть 12 часов для совершения обмена");

	GiveBankMoney(playerid, -price);
	GiveBankMoney(targetid, price);

	fLogs("[money] %s передал %s [%i]", GetName(playerid), GetName(targetid), price);
	SendMes(playerid, COLOR_WHITE, "Вы перевели %dр игроку %s[%d] на счет", price, GetName(targetid), playerid);
	SendMes(targetid, COLOR_WHITE, "Вам поступил перевод на ваш счет в размере %dр от игрока %s[%d]", price, GetName(playerid), playerid);
	TransferReset[playerid] = 60;
	return 1;
}
DLG(5205, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new h = GetPlayerHouse(playerid);
	new dayss = strval(inputtext), g_rent = GetHomeOplata(h) * dayss;

	if(!dayss) return SendClientMessage(playerid, COLOR_RED, "Количество дней не может быть равно 0 или быть менее 0");
	new accountid = g_player_listitem_use[playerid];
	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");
	if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < g_rent) return SendClientMessage(playerid, COLOR_RED, "У Вас не хватает средств для оплаты аренды дома");
	if(dayss < 1 || dayss > 7) return SendClientMessage(playerid, COLOR_RED, "Количество дней от 1 до 7");
	if((HouseInfo[h][hOplata] + dayss) > 7) return SendClientMessage(playerid, COLOR_RED, "Нельзя оплатить более чем на 7 дней");

	HouseInfo[h][hOplata] += dayss;
	SCMF(playerid, COLOR_GREEN, "Вы оплатили дом на %d дней. С Вашего счета списано: %d рублей", dayss, g_rent);
	SetPlayerMoney(playerid, -g_rent);
	MysqlUpdateHouseInt(h, "hOplata", HouseInfo[h][hOplata]);
	return 1;
}
DLG(5206, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new h = GetPlayerRooms(playerid);
	new dayss = strval(inputtext), g_rent = GetRoomOplata(h) * dayss;

	g_rent = GetRoomOplata(h) * dayss;

	if(!dayss) return SendClientMessage(playerid, COLOR_RED, "Количество дней не может быть равно 0 или быть менее 0");
	new accountid = g_player_listitem_use[playerid];

	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");
	if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE)< g_rent) return SendClientMessage(playerid, COLOR_RED, "У Вас не хватает средств для оплаты аренды квартиры");
	if(dayss < 1 || dayss > 7) return SendClientMessage(playerid, COLOR_RED, "Количество дней от 1 до 7");
	if((RoomsInfo[h][rOplata] + dayss) > 7)	return SendClientMessage(playerid, COLOR_RED, "Нельзя оплатить более чем на 7 дней");

	RoomsInfo[h][rOplata] += dayss;
	SCMF(playerid, COLOR_GREEN, "Вы оплатили квартиру на %d дней. С Вашего счета списано: %d рублей", dayss, g_rent);
	SetPlayerMoney(playerid, -g_rent);
	SetRoomsInt(h, "rOplata", RoomsInfo[h][rOplata]);
	return 1;
}
DLG(101, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new a = GetPlayerHouse(playerid);
	switch(listitem)
	{
	case 0:
		{
			if(HouseInfo[a][hLock] == 1)
			{
				HouseInfo[a][hLock] = 0;
				GameTextForPlayer(playerid, "~g~открыто", 5000, 5);
				MeAction(playerid, "открывает замок дома");
			}
			else
			{
				HouseInfo[a][hLock] = 1;
				GameTextForPlayer(playerid, "~r~закрыто", 5000, 5);
				MeAction(playerid, "закрывает замок дома");
			}
			MysqlUpdateHouseInt(a, "hLock", HouseInfo[a][hLock]);
		}
	case 1:
		{
			new oneskin[14], twoskin[14], threeskin[14], mskin[14];
			if(!PI[playerid][pSkin][0]) format(oneskin, sizeof(oneskin), "{F04245}(нет)");
			else format(oneskin, sizeof(oneskin), "{63BD4E}(%d)", PI[playerid][pSkin][0]);
			if(!PI[playerid][pSkin][1]) format(twoskin, sizeof(twoskin), "{F04245}(нет)");
			else format(twoskin, sizeof(twoskin), "{63BD4E}(%d)", PI[playerid][pSkin][1]);
			if(!PI[playerid][pSkin][2]) format(threeskin, sizeof(threeskin), "{F04245}(нет)");
			else format(threeskin, sizeof(threeskin), "{63BD4E}(%d)", PI[playerid][pSkin][2]);
			if(!PI[playerid][pMemberSkin]) format(mskin, sizeof(mskin), "{F04245}(нет)");
			else format(mskin, sizeof(mskin), "{63BD4E}(%d)", PI[playerid][pMemberSkin]);

			format(string, sizeof(string), ""cWH"Полка №1 %s\n"cWH"Полка №2 %s\n"cWH"Полка №3 %s\n"cWH"Одежда организации %s", oneskin, twoskin, threeskin, mskin);
			ShowPlayerDialog(playerid, 1543, DIALOG_STYLE_LIST, ""cMain"Гардероб", string, "Выбрать", "Назад");
		}
	case 2,3: callcmd::home(playerid);
	case 4:
		{
			ShowPlayerDialog(playerid, 4800, DIALOG_STYLE_LIST, ""cMain"Улучшения дома", (HouseInfo[a][hAutoDoors]) ? (""cWH"Автоматические двери\t| {63BD4E}Куплено\n") : (""cWH"Автоматические двери\t| {F04245}Не имеется (25000р)"), "Купить", "Назад");
		}
	case 5: ShowPlayerDialog(playerid, 29, 0, ""cMain"Продажа дома", ""cWH"Вы действительно хотите продать свой дом?\nОт его продажи Вам вернётся только половина стоимости дома", "Принять", "Назад");
	case 6:
		{
			ShowPlayerDialog(playerid, 18101, DIALOG_STYLE_LIST, ""cMain"Управление арендой", "1. Управление списком проживающих в доме\n2. Выселить всех из дома", "Далее", "Отмена");
		}
	}
	return 1;
}
DLG(18101, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::home(playerid);

	new h = GetPlayerHouse(playerid), fmt_str[40];

	global_string = "";

	switch(listitem)
	{
	case 0:
		{
			for(new idx; idx < 3; idx++)
			{
				if(!strcmp(HouseArendName[h][idx], "none", true)) format(fmt_str, sizeof fmt_str, ""cWH"%d. -\n", idx+1);
				else format(fmt_str, sizeof fmt_str, ""cWH"%d. %s\n", idx+1, HouseArendName[h][idx]);
				strcat(global_string, fmt_str);
			}
			ShowPlayerDialog(playerid, 18101+1, DIALOG_STYLE_LIST, ""cMain"Список проживающих в доме", global_string, "Выбрать", "Отмена");
		}
	case 1:
		{
			if(!CountHouseArend(h)) return SendClientMessage(playerid, COLOR_RED, "В Вашем доме никто не проживает");

			format(global_string, 130, ""cWH"В данный момент в Вашем доме проживают: {c9ff00}%d человек(а)\n\n"cWH"Вы действительно хотите выселить всех людей?", CountHouseArend(h));

			ShowPlayerDialog(playerid, 18101+2, DIALOG_STYLE_MSGBOX, ""cMain"Выселить всех из дома", global_string, "Да", "Нет");
		}
	}
	return 1;
}
DLG(18102, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::home(playerid);

	new h = GetPlayerHouse(playerid);

	number_arenda[playerid] = listitem;

	if(!strcmp(HouseArendName[h][listitem], "none", true))
	{
		ShowPlayerDialog(playerid, 18101+3, DIALOG_STYLE_INPUT, ""cMain"Поселить человека", ""cWH"Укажите ник-нейм человека, которого необходимо поселить в Ваш дом:", "Далее", "Отмена");
	}
	else
	{
		ShowPlayerDialog(playerid, 18101+4, DIALOG_STYLE_MSGBOX, ""cMain"Выселить человека", ""cWH"Вы действительно хотите выселить данного человека из Вашего дома?", "Далее", "Отмена");
	}
	return 1;
}
DLG(18104, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::home(playerid);

	new h = GetPlayerHouse(playerid);

	if(strlen(inputtext) < 3 || strlen(inputtext) > 24) return SendClientMessage(playerid, COLOR_RED, "Длина ника не может быть меньше трех и больше 24 символов");
	if(IsLoginInvalid(GetName(playerid))) return SendClientMessage(playerid, COLOR_RED, "Имя содержит запрещенные символы или цифры, используйте имя формата Имя_Фамилия на английском");
	new slen = strlen(inputtext);
	mfor(i, (slen - 1)) if('А' <= inputtext[i] <= 'Я' || 'а' <= inputtext[i] <= 'я' || inputtext[i] == ' ' || inputtext[i] == '=') return SendClientMessage(playerid, COLOR_RED, "Ник должен содержать только латинские буквы");
	if(CheckPlayerArend(inputtext) != 0) return SendClientMessage(playerid, COLOR_RED, "Данного игрока уже кто-то заселил");
	if(GetPlayerArendHouse(inputtext) != 0) return SendClientMessage(playerid, COLOR_RED, "У данного игрока есть дом");
	if(GetPlayerID(inputtext) == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_RED, "Игрок должен быть в игре");

	global_string = "";

	mysql_format(db_prod, global_string, 100, "SELECT `name` FROM `accounts` WHERE name = '%s' LIMIT 1", inputtext);
	mysql_tquery(db_prod, global_string, "IsPlayerFexistAccount", "isid", playerid, inputtext, h, number_arenda[playerid]);
	return 1;
}
DLG(18105, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::home(playerid);

	new c = number_arenda[playerid], h = GetPlayerHouse(playerid), arend_str[100];

	strmid(HouseArendName[h][c], "none", 0, strlen("none"), 24);

	global_string = "";

	format(arend_str, 100, "%s,%s,%s", HouseArendName[h][0], HouseArendName[h][1], HouseArendName[h][2]);

	mysql_format(db_prod,global_string, 100, "UPDATE `house` SET `hArendName` = '%e' WHERE `id` = '%d'", arend_str, h);
	mysql_tquery(db_prod, global_string, "", "");

	SendMes(playerid, COLOR_RED, "Игрок с ником '%s' был выселен из Вашего дома", HouseArendName[ GetPlayerHouse(playerid) ][ number_arenda[playerid] ]);

	new to_player = GetPlayerID(HouseArendName[ GetPlayerHouse(playerid) ][ number_arenda[playerid] ]);

	if(to_player != INVALID_PLAYER_ID)
	{
		PI[to_player][pHouseArend] = -1;
		MysqlUpdatePlayerInt(to_player, "house_arend", PI[to_player][pHouseArend]);

		SendMes(to_player, COLOR_RED, "[Дом]: %s выселил Вас из своего дома", GetName(playerid));
	}
	else
	{
		global_string = "";
		mysql_format(db_prod,global_string, 100, "UPDATE accounts SET house_arend=-1 WHERE name='%s'",HouseArendName[ GetPlayerHouse(playerid) ][ number_arenda[playerid] ]);
		mysql_tquery(db_prod, global_string, "", "");
	}
	return 1;
}
DLG(18103, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::home(playerid);

	new h = GetPlayerHouse(playerid), arend_str[30];

	global_string = "";

	for(new i; i < 3; i++) strmid(HouseArendName[h][i], "none", 0, strlen("none"), 10);

	format(arend_str, sizeof arend_str, "none,none,none");

	mysql_format(db_prod,global_string, 100, "UPDATE `house` SET `hArendName` = '%e' WHERE `id` = '%d'", arend_str, h);
	mysql_tquery(db_prod, global_string, "", "");

	SendClientMessage(playerid, COLOR_GREEN, "Вы выселили всех из Вашего дома");

	foreach(new to_player: Player)
	{
		if(PI[to_player][pHouseArend] == h)
		{
			PI[to_player][pHouseArend] = -1;

			SendMes(to_player, COLOR_RED, "[Дом]: %s выселил Вас из своего дома", GetName(playerid));
		}
	}

	global_string = "";
	mysql_format(db_prod,global_string, 100, "UPDATE accounts SET house_arend=-1 WHERE house_arend=%d", h);
	mysql_tquery(db_prod, global_string, "", "");
	return 1;
}
DLG(102, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	{
		new a = GetPlayerInHouse(playerid);
		switch(listitem)
		{
		case 0:
			{
				if(PlayerToPoint(8.0, playerid, HouseInfo[a][hExitx], HouseInfo[a][hExity], HouseInfo[a][hExitz]) && GetPlayerVirtualWorld(playerid) == HouseInfo[a][hVirtual])
				{
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerPos(playerid, HouseInfo[a][hEntrx], HouseInfo[a][hEntry], HouseInfo[a][hEntrz]);

					PI[playerid][pInHouse] = -1;
				}
			}
		case 1:
			{
				if(PlayerToPoint(20, playerid, HouseInfo[a][hExitx], HouseInfo[a][hExity], HouseInfo[a][hExitz]))
				{
					PI[playerid][pInHouse] = -1;
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld(playerid, HouseInfo[a][hVirtual]);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), HouseInfo[a][hVirtual]);
					SetPlayerPos(playerid, -1613.5419,1581.3352,2005.7100);
					SendClientMessage(playerid, -1, ""cPS"Чтобы выехать из гаража, нажмите клавишу сигнала (за рулём)");
					if(!HouseInfo[a][hAutoDoors]) SendClientMessage(playerid, -1, ""cPS"Если Вы хотите выйти из гаража, введите /exit (рядом с дверью)");
					else SendClientMessage(playerid, -1, ""cPS"Если Вы хотите выйти из гаража, нажмите Левый ALT (рядом с дверью)");
				}
			}
		}
	}
	return 1;
}
DLG(103, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new a = GetPlayerInHouse(playerid);
	new vehicleid = GetPlayerVehicleID(playerid);
	SetVehiclePos(vehicleid, -1616.6018,1579.0420,2005.5146);
	PutPlayerInVehicle(playerid, vehicleid, 0);
	SetVehicleZAngle(vehicleid, 90.9035);
	SetCameraBehindPlayer(playerid);
	LinkVehicleToInterior(vehicleid, 0);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, HouseInfo[a][hVirtual]);
	SetVehicleVirtualWorld(vehicleid, HouseInfo[a][hVirtual]);
	return 1;
}
DLG(104, playerid, response, listitem, inputtext[])
{
