			playerid, 7235, DIALOG_STYLE_INPUT,
			""cMain"Пополнение денег на счет бизнеса",
			""cWH"Введите количество денег, которое хотите пополнить:",
			"Пополнить", "Отмена"
			);
		}
	}
	return 1;
}
DLG(1363, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];
		if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");
		if(GetPlayerBizz(playerid) == 0) return SendClientMessage(playerid, COLOR_RED, "У Вас нет бизнеса");

		new b = GetPlayerBizz(playerid);
		new price;
		if(sscanf(inputtext, "i", price))
		{
			return ShowPlayerDialog
			(
			playerid, 1363, DIALOG_STYLE_INPUT,
			""cMain"Снятие денег с бизнеса",
			""cWH"Введите количество денег, которое хотите снять:",
			"Снять", "Отмена"
			);
		}
		if(price < 1 || BizzInfo[b][bMoney] < price)
		{
			return ShowPlayerDialog
			(
			playerid, 1363, DIALOG_STYLE_INPUT,
			""cMain"Снятие денег с бизнеса",
			""cWH"Введите количество денег, которое хотите снять:",
			"Снять", "Отмена"
			), SendClientMessage(playerid, COLOR_RED, "На счету бизнеса нет столько денег");
		}
		g_player_bank_accounts[playerid][accountid][B_BALANCE] += price;
		BizzInfo[b][bMoney] -= price;
		MysqlUpdateBizzInt(b, "money", BizzInfo[b][bMoney]);
		SendMes(playerid, TEAM_BLUE_COLOR, "Вы сняли со счета бизнеса %d рублей. На счете бизнеса: %dр", price, BizzInfo[b][bMoney]);

		format(stringer1, sizeof stringer1, "+ Снятие со счета бизнеса %d рублей", price);
		SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
		UpdateBankMoneyText(playerid, accountid);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
		mysql_tquery(db_prod, STRING_GLOBAL);
	}
	return 1;
}
