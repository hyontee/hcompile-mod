			return 1;

			if(metall_info[idx][mLoading])
			return 1;

			DestroyDynamicArea(metall_info[idx][mArea]);
			DestroyPickup(metall_info[idx][mPickup]);
			metall_info[idx][mPickup] = 0;
			metall_info[idx][mArea] = 0;
			metall_info[idx][mArea] = 0;
