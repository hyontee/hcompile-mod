}
DLG(2209, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new playa=GivePlayer[playerid][0];

		if(playerid == INVALID_PLAYER_ID || playa == INVALID_PLAYER_ID)
		{
			GivePlayer[playerid][0] =
			GivePlayer[playerid][1] =
			GivePlayer[playerid][2] =
			GivePlayer[playerid][3] =
			GivePlayer[playerid][4] = -1;

			return SendClientMessage(playerid, COLOR_RED, "Игрок вышел из игры. Обмен невозможен.");
		}

		new s=GivePlayer[playerid][4];
		new kolv=GivePlayer[playerid][1];
		new id = GivePlayer[playerid][3];
		new money=GivePlayer[playerid][2];
		if(GetPlayerRubble(playerid) < money) return SendClientMessage(playerid, -1, ""cER"У вас недостаточно денег"),SendClientMessage(playa,COLOR_GREY,"У игрока недостаточно денег!");
		if(CheckMaxVes(playerid,id,kolv) == 1){SendClientMessage(playa,COLOR_GREY,"Сумка игрока полна!");return true;}
		if(GetDistanceBetweenPlayers(playerid, playa) > 3.0) return SendClientMessage(playerid,COLOR_GREY,"Игрок не рядом с вами!"),SendClientMessage(playa,COLOR_GREY,"Вы слишком далеко!");

		if(PlayerItem2[playa][s] < kolv) return SendClientMessage(playerid,COLOR_GREY,"У игрока нет столько предметов!"),SendClientMessage(playa,COLOR_GREY,"У вас нет столько предметов!");
		if(GetPlayerLimitMoney(playa, money))
		{
			SendErr(playerid, "У игрока максимальное количество денег.");
			SendErr(playa, "У Вас максимальное количество денег.");
			return 1;
		}

		SetPlayerMoney(playerid, -money);
		SetPlayerMoney(playa, money);
		new slot;
		if(Item[id][iStek]==1)
		{
			new stek = 0;
			for(new si=1;si<MAX_SLOT;si++)
			{
				if(PlayerItem1[playerid][si]==id) { stek=1; slot=si; break; }
			}
			if(stek == 0)
			{
				for(new si=1;si<MAX_SLOT;si++)
				{
					if(PlayerItem1[playerid][si]==0) { stek=0; slot=si; break; }
				}
			}
		}
		else
		{
			for(new si=1;si<MAX_SLOT;si++)
			{
				if(PlayerItem1[playerid][si] == 0) { slot=si; break; }
			}
		}
		PlayerItem1[playerid][slot] = id;
		PlayerItem2[playerid][slot] += kolv;
		nstrmid(PlayerItem3[playerid][slot], PlayerItem3[playa][slot]);
		if(PlayerItem2[playa][s]-kolv <= 0)
		{
			PlayerItem1[playa][s] = 0;
			PlayerItem2[playa][s] = 0;
			nstrmid(PlayerItem3[playa][s],"");
		}
		else PlayerItem2[playa][s] -= kolv;

		SaveItem(playerid,slot);
		SaveItem(playa,s);
		UpDateInv(playerid);
		UpDateInv(playa);

		format(stringer1, sizeof(stringer1), "%s передает что-то в руки %s", GetName(playa),GetName(playerid));
		ProxDetector(15, playerid, stringer1, COLOR_PURPLE);
		return SendClientMessage(playa,-1, ""cDA"Вы успешно продали предмет!"),SendClientMessage(playerid,-1, ""cDA"Вы успешно купили предмет!");
	}
	else
	{
		SendClientMessage(playerid,COLOR_GREY,"Вы отказались от сделки");
		SendClientMessage(GivePlayer[playerid][0],COLOR_GREY,"Игрок отказался от сделки");
	}
	return 1;
}
DLG(2210, playerid, response, listitem, inputtext[])
