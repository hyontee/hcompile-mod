callback::LoadFamily()
{
	new time = GetTickCount(), rows, temp[100];
	rows = cache_num_rows();
	family_count = rows;
	if(rows)
	{
		for(new f; f < rows; f++)
		{
			//new id = cache_get_field_content_int(f, "fam_id");
			cache_get_field_content(f, "fam_name", temp) ,sscanf(temp, "s[64]", family_info[f + 1][f_name]);
			cache_get_field_content(f, "fam_creator", temp) , sscanf(temp, "s[64]", family_info[f + 1][f_creator]) ;
			cache_get_field_content(f, "fam_data", temp ) , sscanf(temp, "s[32]", family_info[f + 1][f_creating_data]);
			family_info[f + 1][f_chat_color] = cache_get_field_content_int(f, "fam_chat_color");
			family_info[f + 1][f_sklad_dostup] = cache_get_field_content_int(f, "fam_sklad_dostup");
			family_info[f + 1][f_spawn] = cache_get_field_content_int(f, "fam_spawn");
			family_info[f + 1][f_house] = cache_get_field_content_int(f, "fam_house");
			family_info[f + 1][f_spawn_x] = cache_get_field_content_float(f, "fam_spawn_x");
			family_info[f + 1][f_spawn_y] = cache_get_field_content_float(f, "fam_spawn_y");
			family_info[f + 1][f_spawn_z] = cache_get_field_content_float(f, "fam_spawn_z");
			family_info[f + 1][f_money] = cache_get_field_content_int(f, "fam_money");
			family_info[f + 1][f_euro] = cache_get_field_content_int(f, "fam_euro");
			family_info[f + 1][f_narko] = cache_get_field_content_int(f, "fam_narko");
			family_info[f + 1][f_patr] = cache_get_field_content_int(f, "fam_patr");
			family_info[f + 1][f_int] = cache_get_field_content_int(f, "fam_int");
			family_info[f + 1][f_world] = cache_get_field_content_int(f, "fam_world");
			family_info[f + 1][f_victory] = cache_get_field_content_int(f, "fam_victory");
			family_info[f + 1][f_fight] = cache_get_field_content_int(f, "fam_fight");
			family_info[f + 1][f_rating] = cache_get_field_content_int(f, "fam_rating");
			cache_get_field_content(f, "fam_ranks", temp) , sscanf(temp, "p<,>s[12]s[12]s[12]s[12]s[12]s[12]s[12]", family_rank_name[f + 1][0], family_rank_name[f + 1][1], family_rank_name[f + 1][2], family_rank_name[f + 1][3], family_rank_name[f + 1][4], family_rank_name[f + 1][5], family_rank_name[f + 1][6]);

			family_info[f + 1][f_total_cars] = cache_get_field_content_int(f, "fam_total_cars");

			for(new i; i < 5; i ++) family_info[f + 1][f_cars][i] = INVALID_VEHICLE_ID;
		}
		printf("[Загружено семей]: <%d>. Потрачено: <%d ms>.", family_count, GetTickCount() - time);
	}
	else return print("[Загружено семей]: <0>. Потрачено: <->.");
	return true;
}

callback::LoadPickup()
{
	new time = GetTickCount();
	new rows, fields;

	cache_get_data(rows, fields);

	for(new idx = 1; idx <= rows; idx++)
	{
		e_info[idx][e_id] = cache_get_field_content_int(idx-1, "id");
		e_info[idx][e_x] = cache_get_field_content_float(idx-1, "e_x");
		e_info[idx][e_y] = cache_get_field_content_float(idx-1, "e_y");
		e_info[idx][e_z] = cache_get_field_content_float(idx-1, "e_z");
		e_info[idx][e_r] = cache_get_field_content_float(idx-1, "e_r");
		e_info[idx][v_x] = cache_get_field_content_float(idx-1, "v_x");
		e_info[idx][v_y] = cache_get_field_content_float(idx-1, "v_y");
		e_info[idx][v_z] = cache_get_field_content_float(idx-1, "v_z");
		e_info[idx][v_r] = cache_get_field_content_float(idx-1, "v_r");
		e_info[idx][e_int] = cache_get_field_content_int(idx-1, "e_int");
		e_info[idx][e_world] = cache_get_field_content_int(idx-1, "e_world");
		e_info[idx][e_types] = cache_get_field_content_int(idx-1, "type");
		e_info[idx][e_dostup] = cache_get_field_content_int(idx-1, "dostup");
		e_info[idx][e_fraction] = cache_get_field_content_int(idx-1, "fraction");

		e_info[idx][p_pic_enter] = CreatePickup(1318, 1, e_info[idx][e_x], e_info[idx][e_y], e_info[idx][e_z],-1);
		e_info[idx][p_pic_exit] = CreatePickup(1318, 1, e_info[idx][v_x], e_info[idx][v_y], e_info[idx][v_z], e_info[idx][e_world]);
		e_info[idx][p_text_enter] = CreateDynamic3DTextLabel("{EF9B15}Вход: ALT", COLOR_WHITE, e_info[idx][e_x], e_info[idx][e_y], e_info[idx][e_z],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1, 0, 0);
		e_info[idx][p_text_exit] = CreateDynamic3DTextLabel("{EF9B15}Выход: ALT", COLOR_WHITE, e_info[idx][v_x], e_info[idx][v_y], e_info[idx][v_z],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1, e_info[idx][e_world], e_info[idx][e_int]);

		TOTALENTER++;

	}
	printf("[Загружено пикапов]: <%d>. Потрачено: <%d ms>.", TOTALENTER, GetTickCount() - time);
	return 1;
}

