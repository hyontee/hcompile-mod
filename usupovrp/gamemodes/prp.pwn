stock Float:GetAngleToPointFire(Float:x1, Float:y1, Float:x2, Float:y2)
{
	new Float: angle;
	angle = atan2(y2 - y1, x2 - x1) + 270;
	return angle < 360 ? angle : angle - 360;
}

Float:GetAngleToPoint(Float:X, Float:Y, Float:A, Float:x, Float:y)
{
	new Float:angle = 185.0 - atan2(X-x, Y-y);
	A -= (angle - 5.0);
	return A;
}
GetPlayerAngleToPoint(playerid, Float:x, Float:y)
{
	new Float:ix, Float:iy, Float:iz, Float:a;
	GetPlayerFacingAngle(playerid, a);
	GetPlayerPos(playerid, ix, iy, iz);
	return floatround(GetAngleToPoint(ix, iy, a, x, y));
}
Float:GetPlayerAngleToPlayer(playerid, facingtoid)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(facingtoid, x, y, z);
	return float(GetPlayerAngleToPoint(playerid, x, y));
}
GetPlayerFaceToPlayer(playerid, targetid, Float:facing)
{
	new Float:radius = GetPlayerAngleToPlayer(playerid, targetid);
	return (radius > -facing && radius < facing);
}
PlayerSecurity(playerid)
{
	ShowPlayerDialog(playerid, 332, 2, ""cMain"Безопасность", ""cMain"1."cWH" Смена пароля\n"cMain"2."cWH" Потверждение почты\n"cMain"3."cWH" Смена почты\n"cMain"4."cWH" Привязать аккаунт к Группе ВКонтакте (VK - CONNECT)\n"cMain"5."cWH" Защита аккаунта через Группу ВКонтакте (VK - Guard)", "Выбрать", "Назад");
	return 1;
}
GPSPlayer_(playerid, Float:X, Float:Y, Float:Z, locname[])
{
	if(X == 0.0) return SendClientMessage(playerid, COLOR_GREY, "Критическая ошибка! Обратитесь к администрации!");
	new Float:VPos[4];
	global_string = "";
	GetPlayerPos(playerid, VPos[0], VPos[1], VPos[2]);
	UseGPS[playerid] = true;
	DisablePlayerRaceCheckpoint(playerid);
	SetPlayerRaceCheckpoint(playerid, 1, X, Y, Z, 0, 0, 0, 5.0);
	VPos[3] = GetDistanceBetweenPoints(VPos[0], VPos[1], VPos[2], X, Y, Z);
	gps_player_x[playerid] = X;
	gps_player_y[playerid] = Y;
	gps_player_z[playerid] = Z;

	SCMF(playerid, COLOR_WHITE, "Вы отметили на карте: %s. "cMain"Расстояние: %.1f м", locname, VPos[3]);

	if(PI[playerid][pSettingTD][1] == 1)
	{
		for(new i; i < 10; i++) TextDrawShowForPlayer(playerid, gps_td_global[i]);
		for(new i; i < 3; i++) PlayerTextDrawShow(playerid, gps_td_player[i][playerid]);
	}
	PlayerTextDrawSetString(playerid, gps_td_player[2][playerid], locname);
	format(stringer1, 80, "%.1f_м", VPos[3]);
	PlayerTextDrawSetString(playerid, gps_td_player[1][playerid], stringer1);
	return 1;
}
MeAction(playerid, action[], Float:distance = 13.0)
{
	new virt = GetPlayerVirtualWorld(playerid);
	stringer1 = "";
	strcat(stringer1, GetName(playerid));
	strcat(stringer1, " ");
	strcat(stringer1, action);
	foreach(new i : Player)
	{
		if(GetDistanceBetweenPlayers(playerid,i) > distance || GetPlayerVirtualWorld(i) != virt) continue;
		SendClientMessage(i, COLOR_PURPLE, stringer1);
	}
	return 1;
}
DoAction(playerid, action[], Float:distance = 13.0)
{
	new virt = GetPlayerVirtualWorld(playerid);
	stringer1 = "";
	strcat(stringer1, action);
	strcat(stringer1, " |  ");
	strcat(stringer1, GetName(playerid));
	foreach(new i : Player)
	{
		if(!IsPlayerConnected(i) ||  GetDistanceBetweenPlayers(playerid,i) > distance || GetPlayerVirtualWorld(i) != virt) continue;
		SendClientMessage(i, COLOR_PURPLE, stringer1);
	}
	return 1;
}
TryAction(playerid, action[], Float:distance = 13.0)
{
	if(random(2) == 1) format(string, sizeof(string), "%s %s - {63BD4E}удачно", GetName(playerid), action);
	else format(string, sizeof(string), "%s %s - {FF6347}неудачно", GetName(playerid), action);
	foreach(new i : Player)
	{
		if(!IsPlayerConnected(i) || GetDistanceBetweenPlayers(playerid,i) > distance || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
		SendClientMessage(i, COLOR_PURPLE, string);
	}
	return 1;
}

callback::OnPlayerOffban(playerid, name[], dayss, reason[])
{
	if(cache_get_row_count(db_prod) > 0)
	{
		format(string, sizeof(string), "Администратор %s заблокировал аккаунт %s в Offline на %d дней. Причина: %s", GetName(playerid), name, dayss, reason);
		SendClientMessageToAll(COLOR_RED, string);
		SaveHistoryBan(name, string);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', '%e', '%s', NOW(), '%d', '%e')", name, GetName(playerid), cache_get_field_content(0, "ip", PI[playerid][pLastIP], db_prod, 16), dayss, reason);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");


		format(global_string, sizeof(global_string), "UPDATE `accounts` SET warn = 0,member = 0,leader = 0,rank = 0,spawnchange = 0 WHERE name = '%s'", name);
		mysql_tquery(db_prod, global_string, "", "");

		PI[playerid][pAdmSt][ADMIN_BAN] ++;
		ProtectionServerAdmin(playerid);
		fLogs("[admin] %s /offban %s %i %s", GetName(playerid), name, dayss, reason);
	}
	else SendClientMessage(playerid, COLOR_GREY, "Игрок не найден!");
	return 1;
}

callback::OnPlayerOffwarn(playerid, name[], reason[])
{
	if(cache_get_row_count(db_prod) > 0)
	{
		if(cache_get_field_content_int(0, "warn") < 3)
		{
			format(string, sizeof(string), "Игрок %s получил оффлайн предупреждение от администратора %s. Причина: %s", name, GetName(playerid), reason);
			format(global_string, sizeof(global_string), "UPDATE `accounts` SET warn=warn+1,member=0,leader=0,rank=0,spawnchange=0 WHERE name='%s'", name);
			mysql_tquery(db_prod, global_string, "", "");
			PI[playerid][pAdmSt][ADMIN_WARN] ++;
		}
		else
		{
			format(string, sizeof(string), "Игрок %s получил оффлайн бан на 7 дней от администратора %s. Причина: %s", name, GetName(playerid), reason);

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', '%e', '%s', '%02d.%02d.%04d', '7', '%e')", name, GetName(playerid), cache_get_field_content(0, "ip", PI[playerid][pLastIP], db_prod, 16), day, month, year, reason);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");


			format(global_string, sizeof(global_string), "UPDATE `accounts` SET warn=0,member=0,leader=0,rank=0,spawnchange=0 WHERE name='%s'", name);
			mysql_tquery(db_prod, global_string, "", "");
			PI[playerid][pAdmSt][ADMIN_BAN] ++;
		}
		SendClientMessageToAll(COLOR_RED, string);
		fLogs("[admin] %s /offwarn %s %s", GetName(playerid), name, reason);
		ProtectionServerAdmin(playerid);
	}
	else SendClientMessage(playerid, COLOR_GREY, "Игрок не найден!");
	return 1;
}

callback::OnPlayerUnban(playerid, name[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок не забанен!");
	else
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `bans` WHERE `name` = '%e'", name);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");


		format(string, sizeof(string), ""cAD"%s[%d] разбанил игрока %s", GetName(playerid), playerid, name);
		SendAdminMessage(COLOR_GREY, string);
		fLogs("[admin] %s /unban %s", GetName(playerid), name);
	}
	return 1;
}

callback::OnPlayerOffgeta(playerid, name[])
{
	if(cache_get_row_count(db_prod) > 0)
	{
		new string_dialogue[512], cash, level, regip[16], lastip[16], datareg[15], datavhod[15], donate;

		cash = cache_get_field_content_int(0, "cash");
		level = cache_get_field_content_int(0, "level");

		cache_get_field_content(0, "regip", regip, db_prod, 16);
		cache_get_field_content(0, "ip", lastip, db_prod, 16);
		cache_get_field_content(0, "datareg", datareg, db_prod, 15);
		cache_get_field_content(0, "datavhod", datavhod, db_prod, 15);
		donate = cache_get_field_content_int(0, "credits");

		format(string, sizeof(string), "Наличные:\t%d\n", cash);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Уровень:\t%d\n", level);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "IP адрес (регис.):\t%s\n", regip);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "IP адрес (последн.):\t%s\n", lastip);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Дата регистрации:\t%s\n", datareg);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Посл. вход:\t%s\n", datavhod);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Донат:\t%d\n", donate);
