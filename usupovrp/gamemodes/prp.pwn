		return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько наркотиков");

	if(strval(inputtext) < 1 || count+drugs > 1000)
		return ShowDialogPutDrugs(playerid, drugs);

	if(!PlayerItem2[playerid][ok]) PlayerItem1[playerid][ok]=0;

	drugs += count;
	PlayerItem2[playerid][ok] -= count;
	SendMes(playerid, COLOR_GREEN, "Вы положили в багажник %i наркотиков", count);
	UpDateInv(playerid);
	SaveItem(playerid,ok);

	new
		trunker[64];

	format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2]);
	format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
	mysql_tquery(db_prod, stringer1, "", "");
	return true;
}

DLG(2423, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;
	new
		id = GetPVarInt(playerid, "trunk_vehid"),
		query[256];

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", id);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();

	new
		patron,
		gascan,
		drugs,
		money,
		gun[3],
		repairkit,
		trunks[64];

	if(rows > 0)
	{
		cache_get_field_content(0, "c_trunk", trunks, db_prod, 64);
		sscanf(trunks, "p<,>iiiiiiii",
		patron, gascan, drugs, money, gun[0], gun[1], gun[2], repairkit);
	}
	cache_delete(result);

	new ok = SearchInventoryItem(playerid, 42);

	new
		count = strval(inputtext);

	if(!ok)
		return SendErr(playerid, "У вас нет предмета");
	if(PlayerItem2[playerid][ok] < count)
		return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько патронов");

	if(strval(inputtext) < 1 || count+patron > 1000)
		return ShowDialogPutPatron(playerid, patron);

	if(!PlayerItem2[playerid][ok]) PlayerItem1[playerid][ok]=0;

	patron += count;
	PlayerItem2[playerid][ok] -= count;
	SendMes(playerid, COLOR_GREEN, "Вы положили в багажник %d патронов", count);
	UpDateInv(playerid);
	SaveItem(playerid,ok);

	new
		trunker[64];

	format(trunker, 64, "%i, %i, %i, %i, %i, %i, %i", patron, gascan, drugs, money, gun[0], gun[1], gun[2]);
	format(stringer1, 128, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE c_owner = '%s' AND id = '%d'", trunker, GetName(playerid), id);
	mysql_tquery(db_prod, stringer1, "", "");
	return true;
}

