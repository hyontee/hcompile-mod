DLG(3810, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][pPhone][1] == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа к интернету!");
			callcmd::leaders(playerid);
		}
	case 1:
		{
			if(use_camera[playerid]) return 1;

			use_camera[playerid] = 1;

			SendClientMessage(playerid, COLOR_ORANGE, "[Камера]: /selfie - выход из камеры");
			if(!IsPlayerFromThePhone(playerid))SendClientMessage(playerid, COLOR_ORANGE, "[Камера]: /headmove - отключить поворот головы персонажа");
			if(!IsPlayerFromThePhone(playerid)) SendClientMessage(playerid, COLOR_ORANGE, "[Камера]: F8 - сделать снимок");

			PhoneMenuExit(playerid);

			static Float: n1X, Float: n1Y;

			new Float:Degree, Float:lX, Float:lY, Float:lZ;
			GetPlayerPos(playerid,lX,lY,lZ);

			if(Degree >= 360) Degree = 0;
			Degree += 5.25;
			n1X = lX + 1.4 * floatcos(Degree, degrees);
			n1Y = lY + 1.4 * floatsin(Degree, degrees);
			SetPlayerCameraPos(playerid, n1X, n1Y, lZ + 1.0);
			SetPlayerCameraLookAt(playerid, lX, lY, lZ+1);
			SetPlayerFacingAngle(playerid, Degree - 90.0);
			takingselfie[playerid] = 1;
			ApplyAnimation(playerid, "PED", "gang_gunstand", 4.1, 1, 1, 1, 1, 1, 1);
		}
	}
	return 1;
}
DLG(3802, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new params;
	if(sscanf(inputtext, "d", params)) return ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад");
	if(params < 1 || params > 9999999) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Неверный номер телефона!"); }
	if(params == PI[playerid][pPhoneNumber]) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Ты не можешь позвонить самому себе!"); }
	if(PI[playerid][pPhoneBalance] < 1) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, COLOR_GREY, "Пополните счет сим-карты в любом банкомате города! Узнать баланс /callbalance"); }
	new fullphone, string11[90];
	if(params == SMI_NUMBER)
	{
		if(Ether[playerid] == true) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Действие невозможно!"); }
		if(PI[playerid][pNews] != 1) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cPS"Вы должны переключиться на волну этой студии!"); }
		if(PI[playerid][pNews] < 1) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"News ID Error!"); }
		if(EtherCall == false) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Радио не принимает звонков!"); }
		foreach(new i: Player)
		{
			if(PlayerLogged[i] == true && (Ether[i] == true) && PI[i][pMember] == TEAM_SMI)
			{
				if(Mobile[i] != -1) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже разговаривает по телефону!");
				if(PI[i][pJail] > 0) return SendClientMessage(playerid, COLOR_GREY, "Абонент временно недоступен!");
				Mobile[playerid] = i;
				SendMes(i, COLOR_WHITE, "Ваc вызывает: %s (%d). Чтобы ответить, введите: /pickup (/p)", GetName(playerid), PI[playerid][pPhoneNumber]);
				format(string11, sizeof(string11), "У %s звонит мобильный телефон", GetName(i));
				ProxDetector(13.0, i, string11,COLOR_PURPLE);
				SendClientMessage(playerid, COLOR_WHITE, "Чтобы повесить трубку, введите: /hangup (/h)");
				if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, 11);
				CellTime[playerid] = 0;
			}
		}
	}

	foreach(new i: Player)
	{
		if(params == PI[i][pPhoneNumber] && PlayerLogged[i] == true)
		{
			if(Phone[i] == false) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Игрок выключил телефон!"); }
			if(Ether[i] == true) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Действие невозможно!"); }
			if(Mobile[i] != -1) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Игрок уже разговаривает по телефону!"); }
			if(PI[i][pJail] > 0) return SendClientMessage(playerid, COLOR_GREY, "Абонент временно недоступен!");
			Mobile[playerid] = i;
			SendMes(i, COLOR_WHITE, "Ваc вызывает: %s (%d). Чтобы ответить, введите: /pickup (/p)", GetName(playerid), PI[playerid][pPhoneNumber]);
			format(string11, sizeof(string11), "У %s звонит мобильный телефон", GetName(i));
			ProxDetector(13.0, i, string11, COLOR_PURPLE);
			SendClientMessage(playerid, COLOR_WHITE, "Чтобы повесить трубку, введите: /hangup (/h)");
			if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, 11);
			CellTime[playerid] = 0;
			fullphone++;
		}
	}
	if(fullphone == 0) { ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Игрок с данным номером не найден!"); }
	return 1;
}
DLG(3803, playerid, response, listitem, inputtext[])
{
	if(!response) { PhoneSMS[playerid] = 0; return 1; }
	new params, full;
	if(sscanf(inputtext, "d", params)) return ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад");
	if(params < 1 || params > 9999999) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Неверный номер телефона!"); }
	if(params == PI[playerid][pPhoneNumber]) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Ты не можешь писать смс самому себе!"); }
	if(params == SMI_NUMBER) full++;
	foreach(new i: Player)
	{
		if(params == PI[i][pPhoneNumber] && PlayerLogged[i] == true)
		{
			full++;
			break;
		}
	}
	if(full == 0) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Отправка смс", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Игрок с данным номером не найден!"); }
	PhoneSMS[playerid] = params;
	SendSMS(playerid);
	return 1;
}
DLG(3804, playerid, response, listitem, inputtext[])
{
	if(!response) { PhoneSMS[playerid] = 0; return ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); }
	if(strlen(inputtext) == 0) return SendSMS(playerid);
	if(strlen(inputtext) > 64)
	{
		SendClientMessage(playerid, -1, ""cER"Максимальное количество символов - 64!");
		return SendSMS(playerid);
	}
	if(IsIpFound(inputtext) || CheckString(inputtext)) return PlayerGetsChatBan(playerid, inputtext);
	new fullsms, params = PhoneSMS[playerid];
	if(params == SMI_NUMBER)
	{
		if(PI[playerid][pNews] != 1) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cPS"Вы должны переключиться на волну этой студии!"); }
		if(EtherSms == false) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Радио не принимает СМС!"); }
		if(PI[playerid][pPhoneBalance] < SmsPrice) return SendClientMessage(playerid, COLOR_GREY, "На вашем счету в банке не хватает денег!");
		foreach(new i: Player)
		{
			if((Ether[i] == true) && PI[i][pMember] == TEAM_SMI)
			{
				PI[playerid][pPhoneBalance] -= SmsPrice;
				FracBank[8] += SmsPrice;
				MysqlUpdateOtherInt("lsnbank", FracBank[8]);

				format(string, sizeof(string), "SMS: "cWH"%s {FFFF00}Отправитель: "cWH"%s {FFFF00}Тел.: "cWH"%d", inputtext, GetName(playerid), PI[playerid][pPhoneNumber]);
				SendClientMessage(i, COLOR_YELLOW, string);
				format(string, sizeof(string), "SMS: "cWH"%s {FFFF00}Получатель: "cWH"СМИ {FFFF00}Тел.: "cWH"555", inputtext);
				SendClientMessage(playerid, COLOR_YELLOW, string);
				SendClientMessage(playerid, COLOR_WHITE, "Ваше сообщение доставлено");
				MeAction(playerid, "достаёт мобильный телефон");
				break;
			}
		}
	}
	foreach(new i: Player)
	{
		if(params == PI[i][pPhoneNumber] && PlayerLogged[i] == true)
		{
			if(Phone[i] == false) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cPS"Игрок выключил телефон!"); }
			if(PI[i][pJail] > 0) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cPS"Абонент временно недоступен!"); }
			format(string, sizeof(string), "SMS: "cWH"%s {FFFF00}Отправитель: "cWH"%s {FFFF00}Тел.: "cWH"%d", inputtext, GetName(playerid), PI[playerid][pPhoneNumber]);
			SendClientMessage(i, COLOR_YELLOW, string);
			format(string, sizeof(string), "SMS: "cWH"%s {FFFF00}Получатель: "cWH"%s {FFFF00}Тел.: "cWH"%d", inputtext, GetName(i), PI[i][pPhoneNumber]);
			SendClientMessage(playerid, COLOR_YELLOW, string);
			PI[playerid][pPhoneBalance] -= 10;
			SendClientMessage(playerid, COLOR_WHITE, "Ваше сообщение доставлено");
			MeAction(playerid, "достаёт мобильный телефон");
			fullsms++;
			break;
		}
	}
	if(fullsms == 0) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"Игрок с данным номером не найден!"); }
	PhoneSMS[playerid] = 0;
	return 1;
}
