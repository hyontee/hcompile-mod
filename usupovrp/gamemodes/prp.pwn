		{
			ShowPlayerDialog(playerid, 2505, DIALOG_STYLE_MSGBOX, ""cMain"Оружие", "\
			"cWH"Данная возможность дает вам брать пакет с оружием в любое подходящие для вас время\n\
			"cWH"В пакет с оружием входит такие модели оружия как\n\
			"cMain"Desert Eagle"cWH" - 150 пт.\n\
			"cMain"Shotgun"cWH" - 150 пт.\n\
			"cMain"M4"cWH" - 150 пт.\n\n\
			\
			При покупке вы получаете сразу 15 пакетов с оружием.\n\
			Пакеты сохраняются и хранятся на аккаунте до тех пор покуда вы их не израсходуете.", "Принять", "Отмена");
		}
	case 1:
		{
			if(PI[playerid][pPerfectCoins] < 25) return SendClientMessage(playerid, -1, ""cER"У вас недостаточно "SERVER_COINS"!");

			PI[playerid][pPerfectCoins] -= 25;
			PI[playerid][GunPack] += 15;
			fLogs("[coin] %s -25 пакет оружия", GetName(playerid));

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET GunPack=GunPack+15, credits=credits-25 WHERE id=%d", PI[playerid][pID]);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы купили 15 пакетов с оружием. Всего у вас "cMain"%d {FFFF00}пакетов с оружием", PI[playerid][GunPack]);
			SendClientMessage(playerid, 0xFFFF00FF, STRING_GLOBAL);
		}
	case 2:
		{
			if(PI[playerid][GunPack] <= 0) return SendClientMessage(playerid, -1, ""cER"У вас нет в наличие пакетов с оружием.");

			GivePlayerWeapon(playerid, WEAPON_M4, 150);
			GivePlayerWeapon(playerid, WEAPON_DEAGLE, 150);
			GivePlayerWeapon(playerid, WEAPON_SHOTGUN, 150);

			PI[playerid][GunPack] -= 1;
			UpdatePlayerDataInt(playerid, "GunPack", PI[playerid][GunPack]);

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы активировали пакет с оружием. У вас осталось "cMain"%d {FFFF00}пакетов с оружием", PI[playerid][GunPack]);
			SendClientMessage(playerid, 0xFFFF00FF, STRING_GLOBAL);
		}
	}

	return 0x1;
}

