cmd:find(playerid)
{
	if(!PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new full;
	global_string = "{FFFF00}ID\tУровень\tРанг\tИмя игрока\n\n";
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pMember] == PI[playerid][pMember])
		{
			if(PI[i][pAFK] >= 3) format(global_string, sizeof(global_string),"%s"cWH"%d\t%d\t%s [%d]\t%s[AFK: %s]\n", global_string, i, PI[i][pLevel], (PI[i][pTempLeader]) ? ("Админ") : (GetFrackRangName(i)), PI[i][pRank], GetName(i), ConvertSeconds(PI[i][pAFK]));
			else format(global_string, sizeof(global_string),"%s"cWH"%d\t%d\t%s [%d]\t%s\n", global_string, i, PI[i][pLevel], (PI[i][pTempLeader]) ? ("Админ") : (GetFrackRangName(i)), PI[i][pRank], GetName(i));
			full++;
		}
	}
	format(stringer1, sizeof stringer1, ""cMain"Члены организации в сети (%d чел.)", full);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, stringer1, global_string, "Закрыть", "");
	return 1;
}

cmd:allfind(playerid)
{
	if(PI[playerid][pAdmin] < 9) return 0x1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	new fraction_online[11];

	foreach(new i: Player)
	{
		if(!PI[i][pMember] || PlayerLogged[i] == false) continue;
		switch(PI[i][pMember])
		{
		case 1: fraction_online[0] ++; //Областная Администрация
		case 2: fraction_online[1] ++; //МВД
		case 3: fraction_online[2] ++; //ФСБ
		case 4: fraction_online[3] ++; //БОЛЬНИЦА
		case 5: fraction_online[4] ++; //ЦСКА
		case 6: fraction_online[5] ++; //СПАРТАК
		case 7: fraction_online[6] ++; //ХИТМАНЫ
		case 8: fraction_online[7] ++; //АРМИЯ
		case 9: fraction_online[8] ++; //ИМ
		case 10: fraction_online[9] ++; //РМ
		case 11: fraction_online[10] ++; //СМИ
		}
	}

	format(global_string, 800, "\
	{5992C1}Государственные организации:\n\n\
	"cWH"Областная Администрация: {EEC522}%d чел.\n\
	"cWH"МВД: {EEC522}%d чел.\n\
	"cWH"ФСБ: {EEC522}%d чел.\n\
	"cWH"Больница: {EEC522}%d чел.\n\
	"cWH"Армия: {EEC522}%d чел.\n\
	"cWH"СМИ: {EEC522}%d чел.\n\n\
	{FB5C1D}Нелегальные организации:\n\n\
	"cWH"ФК 'ЦСКА': {EEC522}%d чел.\n\
	"cWH"ФК 'Спартак': {EEC522}%d чел.\n\
	"cWH"Хитманы: {EEC522}%d чел.\n\
	"cWH"Итальянская мафия: {EEC522}%d чел.\n\
	"cWH"Русская мафия: {EEC522}%d чел.\n\n\
	"cWH"Текущий онлайн: %d\nДата: %02d.%02d.%04d\n\
	Время: %02d:%02d:%02d",
	fraction_online[0],
	fraction_online[1],
	fraction_online[2],
	fraction_online[3],
	fraction_online[7],
	fraction_online[10],
	fraction_online[4],
	fraction_online[5],
	fraction_online[6],
	fraction_online[8],
	fraction_online[9],
	Iter_Count(Player), day, month, year, hour, minute, second);
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""cMain"Мониторинг онлайна организаций", global_string, "Закрыть", "");

	fLogs("[admin] %s /allfind", GetName(playerid));
	return 1;
}
cmd:invite(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new targetid;
	if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/invite [id игрока]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
	if(PI[targetid][pMember] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок находиться в другой организации!");
	if(PI[targetid][pWarn] > 0) return SendClientMessage(playerid, -1, ""cER"У игрока предупреждение!");
	if(IsPlayerInAnyVehicle(targetid)) return SendClientMessage(playerid, COLOR_GREY, "Игрок не должен находиться в транспорте!");
	if(GetDistanceBetweenPlayers(playerid, targetid) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(PI[targetid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено находиться в организации");
	if(PI[targetid][Billet] == 0)
	{
		if(IsACopAndFSB(playerid))
		{
			SendClientMessage(targetid, -1, ""cER"Для вступления в данную фракцию вам необходимо получить военный билет в армии");
			SendClientMessage(playerid, -1, ""cER"У данного игрока нет военного билета");
			return 1;
		}
	}
	switch(PI[playerid][pMember])
	{
	case 1:if(BlackList[targetid][0] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 2:if(BlackList[targetid][1] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 3:if(BlackList[targetid][2] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 4:if(BlackList[targetid][3] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 5:if(BlackList[targetid][4] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 6:if(BlackList[targetid][5] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 7:if(BlackList[targetid][11] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 8:if(BlackList[targetid][12] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 12:if(BlackList[targetid][6] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 15:if(BlackList[targetid][7] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 16:if(BlackList[targetid][8] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 18:if(BlackList[targetid][9] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 21:if(BlackList[targetid][10] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	}
	SendMes(playerid,COLOR_BLUE,"Вы предложили %s присоединиться в вашу организацию",GetName(targetid));
	format(string,sizeof(string),"%s %s предлагает вам присоединиться к \"%s\"\n\nВы согласны?",frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), Fraction_Name[PI[playerid][pMember]]);
	ShowPlayerDialog(targetid, 18, 0, ""cMain"Вступление во фракцию",string,"Да","Нет");

	offerfractionid[targetid] = PI[playerid][pMember];
	offerplayer[targetid] = playerid;
	actplayerid[playerid] = targetid;
	return 1;
}

cmd:changeskin(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new targetid;
	if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/changeskin [id игрока]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находиться в организации!");
	if(PI[targetid][pMember] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок находиться в другой организации!");
	if(GetDistanceBetweenPlayers(playerid,targetid) > 5.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(targetid)) return SendClientMessage(playerid,COLOR_GREY,"Вы далеко друг от друга");
	if(PI[targetid][pRank] > PI[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "Ваш ранг недостаточен");
	actplayerid[playerid] = targetid;
	new fractionid = PI[playerid][pMember];
	new mes[128];
	for(new i; i < 9; i++)
	{
		new skinid = Fraction_Skin[fractionid][i];
		if(!skinid) break;
		if(!i) format(mes, sizeof(mes), "Скин %d [%d]", i+1, skinid);
		else format(mes, sizeof(mes), "%s\nСкин %d [%d]", mes, i+1, skinid);
	}
	ShowPlayerDialog(playerid, 49+8, 2, ""cMain"Выбор скина", mes, "Принять", "");
	return 1;
}

cmd:leave(playerid, params[])
{
	if(!PI[playerid][pMember]) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в организации!");
	if(PI[playerid][pLeader] > 0) return SendClientMessage(playerid, -1, ""cER"Вы не должны быть лидером!");
	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cER"Вы не должны находиться в транспорте!");

	format(string, 256, ""cWH"Вы состоите в организации: \"%s\",\nи вы хотите покинуть её по собственному желанию.\nПри этом все Ваши достижения в организации останутся позади.\n\nВы уверены что хотите уволится из организации?",Fraction_Name[PI[playerid][pMember]]);
	ShowPlayerDialog(playerid, 6000, 0, "{FF6600}Предупреждение", string, "Да", "Нет");
	return 1;
}

cmd:selfie(playerid)
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	if(!use_camera[playerid]) return 1;
	TogglePlayerControllable(playerid, 1);
	SetCameraBehindPlayer(playerid);
	takingselfie[playerid] = 0;
	use_camera[playerid] = 0;
	ApplyAnimation(playerid, "PED", "ATM", 4.1, 0, 1, 1, 0, 1, 1);
	return 1;
}
cmd:report(playerid)
{
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);

	if(playerReportID[playerid] != -1 && new_report) return SendClientMessage(playerid, COLOR_RED, "Вы уже задали вопрос. Пожалуйста, дождитесь ответа.");

	ShowPlayerDialog(playerid, 13212, DIALOG_STYLE_INPUT, ""cMain"Жалоба на игрока", "\
	"cWH"Введите ID игрока и причину подачи на него в репорт:", "Отправить","Отмена");
	return 1;
}
cmd:ask(playerid)
{
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);

	if(playerReportID[playerid] != -1) return SendClientMessage(playerid, COLOR_RED, "Вы уже задали вопрос. Пожалуйста, дождитесь ответа.");

	ShowPlayerDialog(playerid, 13213, DIALOG_STYLE_INPUT, ""cMain"Задать вопрос", "\
	{ff0033}Запрещено:\n"cWH"- Использовать нецензурные выражения\n\
	- Оскорблять, унижать других игроков\n- Писать вопросы и жалобы не по теме\n\
	- Выпрашивать что-либо, нарушающее РП процесс\n\n\
	Все доступные места можно посмотреть '/gps'\n\
	Все доступные команды можно посмотреть '/cmd'\n\n\
	Введите чётко поставленный вопрос:", "Отправить","Отмена");
	return 1;
}

cmd:uninvite(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new targetid, reason[32];
	if(sscanf(params, "us[32]", targetid, reason)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/uninvite [id игрока] [причина]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находиться в организации!");
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
	if(PI[targetid][pMember] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок находиться в другой организации!");
	if(playerid == targetid) return SendClientMessage(playerid, COLOR_GREY, "Самого себя нельзя уволить!");
	if(PI[targetid][pRank] >= 9 && !PI[playerid][pLeader]) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете уволить заместителя");
	SendMes(playerid, COLOR_BLUE, "Вы уволили %s из организации. Причина: %s",GetName(targetid),reason);
	SendMes(targetid, COLOR_BLUE, "%s %s уволил Вас из организации. Причина: %s", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]],GetName(playerid),reason);
	LeaveFractionPlayer(targetid);
	PI[playerid][pLeaderStat][LEADER_UNINVITE] ++;
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET sub_uninvited=sub_uninvited+1 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");
	FractionProtectionServer(playerid, reason);
	fLogs("[uninvite] %s /uninvite %s [%s]", GetName(playerid), GetName(targetid), Fraction_Name[PI[playerid][pMember]]);
	if(F_MSG_Log == true)
	{
        format(string, sizeof(string), "[F-MSG] %s[%d] uninvite %s[%d] from %s", GetName(playerid), playerid, GetName(targetid), targetid, Fraction_Name[PI[playerid][pMember]]);
		SendAdminMessage(COLOR_GREY, string);
	}
	return 1;
}

cmd:uval(playerid, params[])
{
	if(PI[playerid][pAdmin] < 9) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено увольнять игроков");
	new targetid, reason[32];
	if(sscanf(params, "us[32]", targetid, reason)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/uval [id игрока] [причина]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находиться в организации!");
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
	SendMes(playerid, COLOR_BLUE, "Вы уволили %s из организации. Причина: %s",GetName(targetid),reason);

	format(stringer, sizeof(stringer), "Администратор %s уволил Вас из организции. Причина: %s",GetName(playerid),reason);
	SCM(targetid, COLOR_BLUE, stringer);
	SaveHistoryBan(GetName(targetid), stringer);

	LeaveFractionPlayer(targetid);
	ProtectionServerAdmin(playerid);

	fLogs("[admin] %s /uval %s %s", GetName(playerid), GetName(targetid), reason);
	return 1;
}

cmd:giverank(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new targetid;
	if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/giverank [id игрока]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(targetid == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете дать себе ранг!");
	if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находится в организации!");
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
	if(GetDistanceBetweenPlayers(playerid, targetid) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(PI[targetid][pMember] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок находиться в другой организации!");
	new str[45], str2[765], full = 0;
	for(new i = 1; i < MAX_RANGS-1; i++)
	{
		if(i == 8 && PI[playerid][pRank] == 9 && !PI[playerid][pMainSub]) break;
		format(str, sizeof(str), "Ранг №%d - %s\n", i, frakRangName[PI[playerid][pMember]][i]);
		strcat(str2, str);
		full++;
	}
	if(full == 0) return SendClientMessage(playerid, -1, ""cER"Обратитесь к администрации!");
	PlayerRank[playerid] = targetid;
	ShowPlayerDialog(playerid, 49+1, 2, ""cMain"Ранг", str2, "Принять", "Отмена");
	return 1;
}

cmd:agiverank(playerid, params[])
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted"))
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		new targetid;
		if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/agiverank [id игрока]");
		if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находиться в организации!");
		if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
		new str[45], str2[765], full = 0;
		for(new i = 1; i < MAX_RANGS; i++)
		{
			format(str, sizeof(str), "Ранг №%d - %s\n", i, frakRangName[PI[targetid][pMember]][i]);
			strcat(str2, str);
			full++;
		}
		if(full == 0) return SendClientMessage(playerid, -1, ""cER"Обратитесь к администрации!");
		PlayerRank[playerid] = targetid;
		ShowPlayerDialog(playerid, 49+2, 2, ""cMain"Ранг", str2, "Принять", "Отмена");
	}
	return 1;
}

cmd:setspawn(playerid)
{
	ShowPlayerDialog(playerid, 1000, DIALOG_STYLE_LIST, ""cMain"Изменение места появления в игре", "\
	1. На вокзале\n\
	2. В собственном доме\n\
	3. На базе организации\n\
	4. В собственной квартире\n\
	5. Семья\n\
	6. Дом, в котором Вас поселили", "Выбрать", "Отмена");
	return 1;
}

CMD:setmainsub(playerid, params[])
{
	if(!PI[playerid][pLeader]) return SendClientMessage(playerid, -1, ""cER"Вы не лидер!");
	new targetid;
	if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setmainsub [id игрока]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
	if(PI[targetid][pMember] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок находиться в другой организации!");
	if(PI[targetid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, "Игрок не заместитель!");
	if(PI[targetid][pMainSub]) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже является главным заместителем");
	if(GetDistanceBetweenPlayers(playerid, targetid) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");

	global_string = "";
	mysql_format(db_prod, global_string, 144, "SELECT id FROM accounts WHERE mainsub=1 AND member=%d", PI[playerid][pMember]);
	mysql_tquery(db_prod, global_string, "CheckMainSub", "ii", playerid, targetid);
	return 1;
}

cmd:lpanel(playerid)
{
	if(!PI[playerid][pLeader] && !PI[playerid][pMainSub]) return SendClientMessage(playerid, -1, ""cER"Вы не лидер или не главный заместитель!");

	if(IsALegal(playerid)) ShowPlayerDialog(playerid, 6566, DIALOG_STYLE_LIST, ""cMain"Меню лидера", "1. Сотрудники организации {6CB75A}(Online)\n"cWH"2. Сотрудники организации {F86014}(Offline)\n"cWH"3. Список заместителей\n"cWH"3. Уволить сотрудника\n4. Меню автопарка\n5. Зареспавнить транспорт\n6. Ранги\n7. Транспорт", "Выбрать", "Отмена");
	else ShowPlayerDialog(playerid, 6566, DIALOG_STYLE_LIST, ""cMain"Меню лидера", "1. Сотрудники организации {6CB75A}(Online)\n"cWH"2. Сотрудники организации {F86014}(Offline)\n"cWH"3. Список заместителей\n\n"cWH"3. Уволить сотрудника\n4. Меню автопарка\n5. Зареспавнить транспорт\n6. Ранги\n7. Транспорт\n8. Настройки склада", "Выбрать", "Отмена");
	return 1;
}

cmd:takegun(playerid, params[])
{
	if((PI[playerid][pMember] == TEAM_MVD || PI[playerid][pMember] == TEAM_MVD) && PI[playerid][pRank] >= 6)
	{
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/take [id игрока]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
		ResetPlayerWeapons(params[0]);
		SendMes(playerid, COLOR_LIME, "Вы забрали оружие у %s",GetName(params[0]));
		SendMes(params[0], COLOR_LIME, "%s забрал у вас оружие",GetName(playerid));
	}
	else SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	return 1;
}
cmd:radio(playerid, params[])
{
	ShowPlayerDialog(playerid, 77+3, 2, ""cMain"Радио", "Станция: Ритм\n{AFAFAF}Выключить", "Принять", "Отмена");
	return 1;
}

cmd:inv(playerid)
{
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"В тюрьме инвентарь недоступен!");
	if(IsPlayerEvent(playerid)) return SendClientMessage(playerid, -1, ""cER"В этом мероприятии инвентарь недоступен!");
	string = "";
	new num, id;
	PlayerVesItem[playerid]=0;
	for(new s = 1; s < MAX_SLOT; s++)
	{
		if(PlayerItem1[playerid][s] == 0)continue;
		id = PlayerItem1[playerid][s];
		PlayerUseList[playerid][num] = s;
		PlayerVesItem[playerid] += Item[id][iGG]*PlayerItem2[playerid][s];
		num++;
		if(Item[id][iStek] == 1)
		{
			if(id == 44) format(string,sizeof(string),"%s{808080}[%dг] "cWH"%s "cMain"(%d грамм)\n",string,PlayerItem2[playerid][s]*Item[id][iGG],Item[id][iName],PlayerItem2[playerid][s]);
			else format(string,sizeof(string),"%s{808080}[%dг] "cWH"%s "cMain"(%d шт)\n",string,PlayerItem2[playerid][s]*Item[id][iGG],Item[id][iName],PlayerItem2[playerid][s]);
		}
		else
		{
			switch(PlayerItem1[playerid][s])
			{
				case 107: format(string,sizeof(string),"%s"cWH"%s (ID: %d)\n",string,Item[id][iName],PlayerItem2[playerid][s]);
				case 126: format(string,sizeof(string),"%s{808080}[%dг] "cWH"%s (номер: %s)\n",string,Item[id][iGG],Item[id][iName],PlayerItem3[playerid][s]);
				default: format(string,sizeof(string),"%s{808080}[%dг] "cWH"%s\n",string,Item[id][iGG],Item[id][iName]);
			}
		}
	}
	if(num > 0)
	{
		format(stringer,sizeof(stringer),"{808080}[%d/16]"cWH" Инвентарь [{fcdd76}%d"cWH"г / {ff7f50}%d"cWH"г]",num,PlayerVesItem[playerid],PI[playerid][pSprunk]);
		ShowPlayerDialog(playerid, 2200+2, DIALOG_STYLE_LIST, stringer, string, "Выбрать", "Выйти");
	}
	else SendClientMessage(playerid,COLOR_GREY,""cER"Инвентарь пустой!");
	return true;
}

cmd:giveinv(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено использовать /giveinv");
	if(sscanf(params, "iii",params[0],params[1],params[2])) return SendClientMessage(playerid, -1, ""cPS"Используй: /giveinv [playerid] [Item] [kolv]");

	new newslot,kolv;
	if(Item[params[1]][iStek]==0){kolv=1;}
	else kolv=params[2];
	if(CheckMaxVes(params[0],params[1],kolv,newslot)==1) return SendClientMessage(playerid,COLOR_GREY,"У игрока нет свободного места!");
	PlayerItem1[params[0]][newslot]=params[1];
	PlayerItem2[params[0]][newslot]+=kolv;
	SaveItem(params[0],newslot);

	format(string, sizeof(string), ""cAD"%s получил предмет %s в количестве %d", GetName(params[0]),Item[params[1]][iName],kolv);
	SendClientMessage(params[0], COLOR_GREY, string);
	fLogs("[admin] %s /giveinv %s %i %i", GetName(playerid), GetName(params[0]), params[1], params[2]);
	return true;
}

cmd:checkinv(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, -1, ""cPS"Используй: /checkinv [playerid]");

	string = "";
	new num;
	for(new s = 1; s < MAX_SLOT; s++)
	{
		if(PlayerItem1[params[0]][s]==0)continue;
		if(PlayerItem1[params[0]][s]>0)
		{
			new id=PlayerItem1[params[0]][s];
			PlayerUseList[playerid][num]=s;
			num++;
			if(Item[id][iStek]==1){format(string,sizeof(string),"%s{808080}[%dг] "cWH"%s "cMain"(%d шт)\n",string,PlayerItem2[params[0]][s]*Item[id][iGG],Item[id][iName],PlayerItem2[params[0]][s]);}
			else
			{
				switch(PlayerItem1[params[0]][s])
				{
				case 126:format(string,sizeof(string),"%s{808080}[%dг] "cWH"%s (номер: %s)\n",string,Item[id][iGG],Item[id][iName],PlayerItem3[params[0]][s]);
				default:format(string,sizeof(string),"%s{808080}[%dг] "cWH"%s\n",string,Item[id][iGG],Item[id][iName]);
				}
			}
		}
	}
	if(num > 0)
	{
		g_player_listitem_use[playerid] = params[0];
		new str[62];
		format(str,sizeof(str),""cWH" Инвентарь {808080}%s",GetName(params[0]));
		ShowPlayerDialog(playerid, 2200+10, DIALOG_STYLE_LIST, str, string, "Выбрать", "Выйти");
		fLogs("[admin] %s /checkinv %s", GetName(playerid), GetName(params[0]));
	}
	else SendClientMessage(playerid,COLOR_GREY,""cER"Инвентарь пустой!");
	return true;
}

cmd:unammo(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))return SendClientMessage(playerid,COLOR_GREY,"Вы не можете разрядить оружие в машине!");
	ResetPlayerWeapons(playerid);
	SendClientMessage(playerid,COLOR_GREY,"Вы разрядили всё оружие");
	if(PI[playerid][pSex] == 1) MeAction(playerid, "разрядил оружие");
	else MeAction(playerid, "разрядила оружие");
	return true;
}
CMD:family(playerid)
{
	if(!PI[playerid][pFamily]) return SendClientMessage(playerid, COLOR_GREY,"Вы не являетесь членом какой-либо семьи..");

	new f = PI[playerid][pFamily];

	STRING_GLOBAL[0] = EOS;
	if(PI[playerid][pFamilySozd] || PI[playerid][pFamilyZam])
	{

		format(STRING_GLOBAL, sizeof(STRING_GLOBAL),
		"1. Информация о семье\n\
			2. Члены семьи {7EB643}[online]\n\
			"cWH"3. Члены семьи {F94301}[offline]\n\
			"cWH"4. Весь состав семьи \t["cMain"%d человек"cWH"]\n\
			"cWH"5. Общак семьи\n\
			6. Изменить цвет рации семьи\n\
			7. Смена названия семьи\t["cMain"1.000 евро"cWH"]\n\
			8. Управление рангами\n\
			9. Уволить игрока {F94301}[offline]\n\
			"cWH"10. Доступ к общаку имеют члены семьи \t["cMain"С %d ранга"cWH"]\n\
			"cWH"11. Место появления \t[%s]"cWH"\n\
			"cWH"12. Управление машинами\n\
			"cWH"13. Начать войну\n\
			{FA6B6B}14. Расформировать семью\n\
			{FA6B6B}15. Покинуть семью\n",
		GetFamilyAllMembers(f), family_info[f][f_sklad_dostup], (!family_info[f][f_spawn]) ? ("{FA2020}Не установлено") : ("{76B548}Установлено"));

		ShowPlayerDialog(playerid,3526,DIALOG_STYLE_LIST,""cMain"Меню семьи",STRING_GLOBAL,"Выбор", "Выход");
	}
	else
	{
		format
		(
		global_string, 256,
		"\
			1. Информация о семье\n\
			2. Члены семьи \t{7EB643}[online]\n\
			"cWH"3. Члены семьи \t{F94301}[offline]\n\
			"cWH"4. Весь состав семьи \t{E4DF2D}[%d человек]\n\
			"cWH"5. Общак семьи \t{E4DF2D}[доступен с %d ранга]\n\
			{FA6B6B}6. Покинуть семью",
		GetFamilyAllMembers(f), family_info[f][f_sklad_dostup]
		);

		ShowPlayerDialog
		(
		playerid,
		3526,
		DIALOG_STYLE_LIST,
		""cMain"Меню семьи",
		global_string,
		"Выбор", "Выход"
		);
	}

	return true;
}

cmd:finvite(playerid, params[])
{
	if(PI[playerid][pFamilySozd] == 0 && PI[playerid][pFamilyZam] == 0) return SendClientMessage(playerid, COLOR_GREY, "Принимать в семью может только создатель и заместитель семьи.");
	if(sscanf(params, "d", params [0])) return SendClientMessage(playerid, COLOR_GREY, "Ввведите: /finvite [id]");
	if(!IsPlayerConnected(params [0]) || params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "Указан не верный ID игрока");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 5.0) return SendClientMessage(playerid, COLOR_GREY, "Этот игрок находится далеко от Вас.");
	if(PI[params[0]][pFamily] > 0) return SendClientMessage(playerid, COLOR_GREY, "Этот игрок уже состоит в семье!");
	new text_string [46 + MAX_PLAYER_NAME + 32];
	format(text_string,sizeof(text_string),"Вы пригласили %s присоединиться к семье %s",GetName(params[0]),family_info [PI[playerid][pFamily]] [f_name]);
	SendClientMessage(playerid,-1,text_string);

	format(string,sizeof(string),""cWH"%s приглашает вас присоединиться к семье %s.\nВы согласны присоединиться?",GetName(playerid),family_info[PI[playerid][pFamily]] [f_name]);
	ShowPlayerDialog(params[0],707,DIALOG_STYLE_MSGBOX,""cMain"Приглашение в семью",string,"Да","Нет");
	player_family_invite[params[0]] = playerid;
	return 1;
}
cmd:funinvite(playerid, params[])
{
	new text[64];
	if(sscanf(params, "ds[64]",params[0],text)) return SendClientMessage(playerid, COLOR_GRAD2, "Используйте: /funinvite [id] [причина]");
	if(PI[playerid][pFamilySozd] == 0 && PI[playerid][pFamilyZam] == 0) return SendClientMessage(playerid, COLOR_GREY,"Выгонять из семьи может только заместитель и создатель.");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не можете выгнать самого себя!");


	if(PI[params[0]][pFamilySozd] > 0 && GetString(family_info [PI[playerid][pFamily]] [f_creator], GetName(params[0])))
		return SendClientMessage(playerid, COLOR_GREY, "Вы не можете уволить создателя семьи!");
	if(PI[playerid][pFamily] != PI[params[0]][pFamily]) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок не состоит в Вашей семье.");

	format(string, sizeof(string), "%s выгнал Вас из семьи. Причина: %s",GetName(playerid), text);
	SendClientMessage(params[0], 0xFFD39BFF, string);
	format(string, sizeof(string), "Вы выгнали игрока %s из семьи. Причина %s",GetName(params[0]), text);
	SendClientMessage(playerid, 0xFFD39BFF, string);
	family_info [ PI[params[0]][pFamily]] [ f_online ] -= 1;
	family_info [ PI[params[0]][pFamily] ] [ f_members_amount ] -= 1;
	PI[params[0]][pFamilySozd] =
	PI[params[0]][pFamily] =
	PI[params[0]][pFamilyZam] = 0;

	if(playerFamilyNameTag[params[0]] != INVALID_3DTEXT_ID)
	{
		UpdateDynamic3DTextLabelText(playerFamilyNameTag[ params[0] ], -1, " ");

		DestroyDynamic3DTextLabel(playerFamilyNameTag[params[0]]);
		playerFamilyNameTag[params[0]] = INVALID_3DTEXT_ID;
	}
	format(string,sizeof(string),"{%s}[%s]{FFD39B} %s(%s) выгнал игрока %s из семьи. Причина: %s",family_chat_color [family_info[PI[playerid][pFamily]] [f_chat_color ]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid), family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1], GetName(params[0]),text);
	family_message(PI[playerid][pFamily],-1, string);
	format(string, sizeof string, "UPDATE `accounts` SET family = 0, familyzam = 0, familyrank = 0, familysozd = 0 WHERE name = '%s'", GetName(params[0]));
	mysql_function_query ( db_prod, string, false, "", "");
	return true;
}

OnServerUpdateFamilyData(field[], data, reason)
{
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `family_system` SET `%s` = '%d' WHERE `fam_id` = '%d' LIMIT 1", field, data, reason);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	return 0x1;
}

cmd:setfamrank(playerid, params[])
{
	if(!PI[playerid][pFamily]) return SendClientMessage(playerid, -1, "Вы не состоите в семье!");
	if(!PI[playerid][pFamilySozd] && !PI[playerid][pFamilyZam]) return SendClientMessage(playerid, -1, "Доступ имеет только создатель семьи и заместитель");
	if(sscanf(params, "ii", params[0], params[1])) return SendClientMessage(playerid, -1, "Используйте: /setfamrank [id игрока] [ранг(от 1 до 6)]");
	if(params[1] < 1 || params[1] > 6) return SendClientMessage(playerid, -1, "Ранг от 1 до 6");
	if(playerid == params[0]) return SendErr(playerid, "Нельзя менять ранг себе");
	if(PI[playerid][pFamily] != PI[params[0]][pFamily]) return SendClientMessage(playerid, -1, "Игрок не состоит в Вашей семье");

	if(PI[params[0]][pFamilySozd] || PI[params[0]][pFamilyZam])
		return SendClientMessage(playerid, COLOR_RED, "Вы не можете установить ранг создателю");

	format(string, sizeof(string), "{%s}[%s]{FFD39B} %s[%s] установил %d-й ранг члену семьи %s",family_chat_color [family_info [PI[playerid][pFamily]] [f_chat_color]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid),family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1], params[1], GetName(params[0]));
	family_message(PI[playerid][pFamily],-1, string);
	PI[params[0]][pFamilyRank] = params[1];
	MysqlUpdatePlayerInt(params[0], "familyrank", PI[params[0]][pFamilyRank]);
	return true;
}
cmd:k(playerid, params[])
{
	if(PI[playerid][pFamily] == 0)
		return SendErr(playerid, "Вы не состоите в семье");

	if(sscanf(params, "s[128]", params[0]))
		return SendInf(playerid, "/k [текст]");

	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, -1, PlayerHaveMuteTime);
	if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);

	format(string, sizeof(string), "{%s}[%s]{FFD39B} %s[%d]: %s",family_chat_color [family_info [PI[playerid][pFamily]] [f_chat_color]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid), playerid,params);
	family_message(PI[playerid][pFamily],-1, string);
	SetPlayerChatBubble(playerid, "Отправляет сообщение в рацию",COLOR_PURPLE,30.0,10000);
	return true;
}
cmd:news(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_SMI) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(IsPlayerInAnyVehicle(playerid))
	{
		new full = 0;
		for(new i = 1; i <= TOTALVEH; i++)
		{
			if(PI[playerid][pMember] == TEAM_SMI)
			{
				if(VehInfo[i][vFraction] == TEAM_SMI)
				{
					NewsPanel(playerid);
					full++;
					break;
				}
			}
		}
		if(full == 0) SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в офисе или в служебном транспорте!");
	}
	else
	{
		if(IsPlayerInRangeOfPoint(playerid, 150.0, -92.6928,64.2366,1201.0000)) NewsPanel(playerid);
		else SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в офисе или в служебном транспорте!");
	}
	return 1;
}

cmd:ad(playerid, params[])
{
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");}
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(PI[playerid][pTime] < 2) return SendClientMessage(playerid, -1, ""cPS"Вы должны играть на сервере более 2 часов!");
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"У вас нет SIM-карты!");
	if(PI[playerid][pNews] == 0) return SendClientMessage(playerid, -1, ""cPS"Вы должны быть переключены на какую-либо станцию (/radio)");
	if(TOTALADVERT >= 15) return SendClientMessage(playerid, COLOR_GREY, "Линия заполнена, обратитесь позже!");
	if(AdvertTime_[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "Посылать объявление можно раз в минуту!");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/ad [текст]");
	if(GetPlayerRubble(playerid) < strlen(params[0])*AdvertPrice) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
	TOTALADVERT++;

	strmid(AdvertInfo[TOTALADVERT][aText],params[0],0,strlen(params[0]),128);
	strmid(AdvertInfo[TOTALADVERT][aName],GetName(playerid),0,strlen(GetName(playerid)),MAX_PLAYER_NAME);
	AdvertInfo[TOTALADVERT][aPhone] = PI[playerid][pPhoneNumber];
	SetPlayerMoney(playerid, -(strlen(params[0]) * AdvertPrice));
	FracBank[8] += strlen(params[0]) * AdvertPrice;
	MysqlUpdateOtherInt("lsnbank", FracBank[8]);

	SendClientMessage(playerid, COLOR_LIGHTRED, "Ваше объявление было отправлено на обработку");
	SendFMes(18, COLOR_LIME, "В редакцию поступило новое объявление!");
	format(stringer1, sizeof(stringer1), "~r~Цена %dр~n~~w~Содержащиеся сообщение: %d символа", strlen(params[0]) * AdvertPrice, strlen(params[0]));
	GameTextForPlayer(playerid, stringer1, 5000, 5);
	AdvertTime_[playerid] = unix + 60;
	return 1;
}

CMD:vad(playerid, params[])
{
	if(TYPE_VIP[playerid] == VIP_STATE_NONE) return 0x1;
	if(TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipAd] == 0) return 0x1;
	if(SearchInventoryItem(playerid, 47)==0) return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(PI[playerid][pTime] < 2) return SendClientMessage(playerid, -1, ""cPS"Вы должны играть на сервере более 2 часов!");
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"У вас нет SIM-карты!");
	if(PI[playerid][pNews] == 0) return SendClientMessage(playerid, -1, ""cPS"Вы должны быть переключены на какую-либо станцию (/radio)");
	if(AdvertTime_[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "Посылать объявление можно раз в минуту!");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/vad [текст]");

	AdvertTime_[playerid] = unix + 60;
	format(string, sizeof(string), ""cMain"V.I.P {63BD4E}%s Отправитель: %s (тел.: %d)", params[0], GetName(playerid), PI[playerid][pPhoneNumber]);
	SendClientMessageToAll(COLOR_GREEN, string);
	return 0x1;
}

cmd:npanel(playerid, params[])
{
	if(PI[playerid][pMember] == TEAM_SMI && PI[playerid][pLeader] || PI[playerid][pMainSub]) ShowPlayerDialog(playerid, 77+4, 2, ""cMain"Панель", "- Установить цену за звонок\n- Установить цену за СМС\n- Установить цену за объявление", "Принять", "Отмена");
	else SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	return 1;
}

cmd:mpanel(playerid, params[])
{
	if(PI[playerid][pMember] == TEAM_OBLASTADMIN)
	{
		switch(PI[playerid][pRank])
		{
		case 7:
			{
				ShowPlayerDialog(playerid, 101+6, 2, ""cMain"Панель Мин. здравоохранения", "- Установить цену лечения", "Принять", "Отмена");
			}
		case 10:
			{
				ShowPlayerDialog(playerid, 77+12, 2, ""cMain"Панель Президента", "\
				- Установить цену гос. налога\n- Установить цену освобождение из тюрьмы\n\
				- Установить цену за получение паспорта\n- Контролировать зарплату в организациях", "Принять", "Отмена");
			}
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	return 1;
}

CMD:call(playerid, params[])
{
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"У вас нет SIM-карты!");
	new number;
	if(sscanf(params, "i", number)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/call [номер телефона]");

	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");}
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"У вас изъяли телефон!");
	if(Mobile[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "Вы уже разговариваете по телефону!");
	if(Phone[playerid] == false) return SendClientMessage(playerid, -1, ""cER"У вас выключен телефон!");
	if(Ether[playerid] == true) return SendClientMessage(playerid, -1, ""cER"Действие невозможно!");

	if(PI[playerid][pPhoneBalance] < 5 && TYPE_VIP[playerid] == VIP_STATE_NONE) return SendClientMessage(playerid, COLOR_RED, "Пополните счет сим-карты в любом банкомате города! Узнать баланс /callbalance");
	if(PI[playerid][pPhoneBalance] < 5 && TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipCall] == 0) return SendClientMessage(playerid, COLOR_RED, "Пополните счет сим-карты в любом банкомате города! Узнать баланс /callbalance");

	if(number == 1111)
	{
		if(PI[playerid][MobileBank] == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет привелегии мобильный банкинг");
		ShowPlayerBankMenu(playerid);
		return 0x1;
	}
	if(number == SMI_NUMBER)
	{
		if(PI[playerid][pNews] != 1) return SendClientMessage(playerid, -1, ""cPS"Вы должны переключиться на волну этой студии!");
		if(PI[playerid][pNews] < 1) return SendClientMessage(playerid, -1, ""cER"News ID Error!");
		if(EtherCall == false) return SendClientMessage(playerid, -1, ""cER"Радио не принимает звонков!");

		foreach(new i: Player)
		{
			if(PlayerLogged[i] == true && (Ether[i] == true) && PI[i][pMember] == TEAM_SMI)
			{
				if(Mobile[i] != -1) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже разговаривает по телефону!");
				if(PI[i][pJail] > 0) return SendClientMessage(playerid, COLOR_GREY, "Абонент временно недоступен!");
				Mobile[playerid] = i;
				SendMes(i, COLOR_WHITE, "Ваc вызывает: %s (%d).", GetName(playerid), PI[playerid][pPhoneNumber]);
				SendClientMessage(i, COLOR_WHITE, "Чтобы ответить введите /pickup (/p) или чтобы отклонить вызов /hangup (/h)");

				format(stringer1, 144, "У %s звонит мобильный телефон", GetName(i));
				ProxDetector(13.0, i, stringer1, COLOR_PURPLE);

				SendClientMessage(playerid, COLOR_WHITE, "Чтобы повесить трубку, введите: /hangup (/h)");
				if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, 11);
				CellTime[playerid] = 0;

				phone_call_to_id[playerid] = i;
				phone_caller_id[i] = playerid;
				return 1;
			}
		}
	}
	foreach(new i: Player)
	{
		if(number == PI[i][pPhoneNumber] && PlayerLogged[i] == true)
		{
			if(Phone[i] == false) return SendClientMessage(playerid, -1, ""cER"Игрок выключил телефон!");
			if(Ether[i] == true)  return SendClientMessage(playerid, -1, ""cER"Действие невозможно!");
			if(Mobile[i] != -1) return SendClientMessage(playerid, -1, ""cER"Игрок уже разговаривает по телефону!");
			if(PI[i][pJail]) return SendClientMessage(playerid, COLOR_GREY, "Абонент временно недоступен!");

			Mobile[playerid] = i;
			SendMes(i, COLOR_WHITE, "Ваc вызывает: %s (%d).", GetName(playerid), PI[playerid][pPhoneNumber]);
			SendClientMessage(i, COLOR_WHITE, "Чтобы ответить введите /pickup (/p) или чтобы отклонить вызов /hangup (/h)");

			format(stringer1, 144, "У %s звонит мобильный телефон", GetName(i));
			ProxDetector(13.0, i, stringer1, COLOR_PURPLE);

			SendClientMessage(playerid, COLOR_WHITE, "Чтобы повесить трубку, введите: /hangup (/h)");
			if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, 11);
			CellTime[playerid] = 0;

			phone_call_to_id[playerid] = i;
			phone_caller_id[i] = playerid;
			return 1;
		}
	}
	SendClientMessage(playerid, COLOR_RED, "Игрока с таким номером нет");
	return 1;
}
alias:call("c");

CMD:sms(playerid, params[])
{
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"У вас нет SIM-карты!");
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");}

	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"У вас изъяли телефон!");
	if(Phone[playerid] == false) return SendClientMessage(playerid, -1, ""cER"У вас выключен телефон!");

	if(PI[playerid][pPhoneBalance] < 5 && TYPE_VIP[playerid] == VIP_STATE_NONE) return SendClientMessage(playerid, COLOR_RED, "На счету недостаточно средств");
	if(PI[playerid][pPhoneBalance] < 5 && TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipSms] == 0) return SendClientMessage(playerid, COLOR_RED, "На счету недостаточно средств");
	if(!strlen(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/sms [номер телефона] [сообщение]");
	extract params -> new number, string:message[66];

	new full, to_player = INVALID_PLAYER_ID;
	if(number == SMI_NUMBER) full++;
	if(full == 0)
	{
		foreach(new i: Player) if(number == PI[i][pPhoneNumber] && PlayerLogged[i] == true)
		{
			if(Phone[i] == false)
			{
				SendClientMessage(playerid, -1, ""cPS"Игрок выключил телефон!");
				break;
			}
			if(PI[i][pJail] > 0)
			{
				SendClientMessage(playerid, -1, ""cPS"Абонент временно недоступен!");
				break;
			}
			to_player = i;
			full++;
			break;
		}
	}
	if(to_player == INVALID_PLAYER_ID && number != SMI_NUMBER)
	{
		SendClientMessage(playerid, COLOR_RED, "Телефон находится вне зоны доступа");
		return 1;
	}
	if(!strlen(message)) return SendClientMessage(playerid, COLOR_RED, "Введите сообщение для отправки");
	if(strlen(message) >= 65) return SendClientMessage(playerid, COLOR_RED, "Слишком длинное сообщение");

	if(IsIpFound(message) || CheckString(message)) return PlayerGetsChatBan(playerid, message);


	if(TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		if(VipData[TYPE_VIP[playerid]][VipSms] == 0)
		{
			if(PI[playerid][pPhoneBalance] >= 5)
			{
				GameTextForPlayer(playerid, "SMS  ~n~~y~-5 rub", 4000, 1);
				PI[playerid][pPhoneBalance] -= 5;
			}
			if(PI[playerid][pPhoneBalance] <= 4) PI[playerid][pPhoneBalance] = 0;
		}
	}
	if(TYPE_VIP[playerid] == VIP_STATE_NONE)
	{
		if(PI[playerid][pPhoneBalance] >= 5) PI[playerid][pPhoneBalance] -= 5;
		if(PI[playerid][pPhoneBalance] <= 4) PI[playerid][pPhoneBalance] = 0;
		GameTextForPlayer(playerid, "SMS  ~n~~y~-5 rub", 4000, 1);
	}

	full = 0;
	if(number == SMI_NUMBER)
	{
		if(PI[playerid][pNews] != 1) return SendClientMessage(playerid, -1, ""cPS"Вы должны переключиться на волну этой студии!");
		if(EtherSms == false) return SendClientMessage(playerid, -1, ""cER"Радио не принимает СМС!");

		if(PI[playerid][pPhoneBalance] < SmsPrice) return SendClientMessage(playerid, COLOR_GREY, "На вашем счету в банке не хватает денег!");

		foreach(new i: Player)
		{
			if((Ether[i] == true) && PI[i][pMember] == TEAM_SMI)
			{
				PI[playerid][pPhoneBalance] -= SmsPrice;
				FracBank[8] += SmsPrice;
				MysqlUpdateOtherInt("lsnbank", FracBank[8]);

				global_string = "";
				format(global_string, 144, "SMS: "cWH"%s {FFFF00}Отправитель: "cWH"%s {FFFF00}Тел.: "cWH"%d", message, GetName(playerid), PI[playerid][pPhoneNumber]);
				SendClientMessage(i, COLOR_YELLOW, global_string);

				global_string = "";
				format(global_string, 144, "SMS: "cWH"%s {FFFF00}Получатель: "cWH"СМИ {FFFF00}Тел.: "cWH"555", message);
				SendClientMessage(playerid, COLOR_YELLOW, global_string);

				SendClientMessage(playerid, COLOR_WHITE, "Ваше сообщение доставлено");
				MeAction(playerid, "достаёт мобильный телефон");
				full ++;
				break;
			}
		}
	}
	if(full == 0)
	{
		new fmt_msg[128];
		format(fmt_msg, sizeof fmt_msg, "SMS: %s | Отправитель: %s [т.%d]", message, GetName(playerid), PI[playerid][pPhoneNumber]);
		SendClientMessage(to_player, 0xFFFF00FF, fmt_msg);
		SetPlayerChatBubble(to_player, "SMS <<", 0xFFFF00FF, 5.0, 1500);

		format(fmt_msg, sizeof fmt_msg, "SMS: %s | Получатель: %s [т.%d]", message, GetName(to_player), PI[to_player][pPhoneNumber]);
		SendClientMessage(playerid, 0xFFFF00FF, fmt_msg);
		SetPlayerChatBubble(playerid, "SMS >>", 0xFFFF00FF, 5.0, 1500);

		format(global_string,sizeof(global_string),"[SMS]: %s[%d] для %s[%d] %s",GetName(playerid),playerid,GetName(to_player),to_player,message);
		foreach(new i: Player)
		{
			if(PI[i][pAdmin] && PA_ChatSMS[i]) SendClientMessage(i,COLOR_GRAD1,global_string);
		}
		global_string = "";
	}
	MeAction(playerid, "достаёт мобильный телефон");
	return 1;
}

cmd:pickup(playerid)
{
	if(Mobile[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "Вы уже разговариваете по телефону!");
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(Mobile[i] == playerid)
		{
			if(Ether[playerid] == true) CallNews++, EtherCalled[i] = true;
			Mobile[playerid] = i;
			SendMes(i, COLOR_GRAD2, "%s поднял трубку мобильного", GetName(playerid));



			if(TYPE_VIP[i] != VIP_STATE_NONE)
			{
				if(VipData[TYPE_VIP[i]][VipCall] == 0)
				{
					if(PI[i][pPhoneBalance] >= 10) PI[i][pPhoneBalance] -= 10;
					if(PI[i][pPhoneBalance] <= 9) PI[i][pPhoneBalance] = 0;
				}
			}
			if(TYPE_VIP[i] == VIP_STATE_NONE)
			{
				if(PI[i][pPhoneBalance] >= 10) PI[i][pPhoneBalance] -= 10;
				if(PI[i][pPhoneBalance] <= 9) PI[i][pPhoneBalance] = 0;
			}


			MeAction(playerid, "ответил на звонок");
			if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
			return 1;
		}
	}
	return 1;
}
alias:pickup("p");

CMD:hangup(playerid)
{
	if(Mobile[playerid] == -1) return SendClientMessage(playerid, COLOR_GREY, "Вы не разговариваете по телефону!");
	new callerid = Mobile[playerid];
	SendClientMessage(callerid, COLOR_GRAD2, "Абонент положил трубку");
	SetPlayerSpecialAction(callerid,SPECIAL_ACTION_STOPUSECELLPHONE);
	CellTime[callerid] = -1;
	CellTime[playerid] = -1;
	Mobile[callerid] = -1;
	if(EtherCalled[playerid] == true) EtherCalled[playerid] = false;
	if(EtherCalled[callerid] == true) EtherCalled[callerid] = false;
	SendClientMessage(playerid,  COLOR_GRAD2, "Вы положили трубку");
	Mobile[playerid] = -1;
	SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
	CallTime[playerid] = 0;
	CallTime[callerid] = 0;
	return 1;
}
alias:hangup("h");

cmd:togphone(playerid, params[])
{
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"У вас нет мобильного SIM-карты!");
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");}
	if(Phone[playerid])
	{
		Phone[playerid] = false;
		SendSucc(playerid, "Вы выключили телефон");
		SetPlayerChatBubble(playerid, "выключил телефон", COLOR_PURPLE, 13.0, 10000);
		PhoneMenuExit(playerid);
	}
	else
	{
		Phone[playerid] = true;
		SendSucc(playerid, "Вы включили телефон");
		SetPlayerChatBubble(playerid, "включил телефон", COLOR_PURPLE, 13.0, 10000);
	}

	if(TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		if(VipData[TYPE_VIP[playerid]][VipPhone] == 1)
		{
			UpdatePlayerData(playerid, "togphone", Phone[playerid]);
			SendClientMessage(playerid, 0xFFCC00AA, "Настройки Вашего телефона сохранены");
		}
	}
	return 1;
}

cmd:phone(playerid)
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"У вас нет SIM-карты!");
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");}

	if(IsPlayerFromThePhone(playerid))
	{
		if(Phonesmenu[playerid] == 1) return PhoneMenuExit(playerid);
		SendInf(playerid, "Чтобы убрать телефон введите /phone заново.");
	}

	PhoneMenu(playerid);
	return 1;
}

cmd:number(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/number [id/имя игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[params[0]][pPhoneNumber] <= 1) return SendClientMessage(playerid, COLOR_GREY, "Игрок не владеет телефоном или у него нет SIM-карты!");

	format(string, sizeof(string), "Номер игрока %s[%d]: {33CCFF}%d", GetName(params[0]), params[0], PI[params[0]][pPhoneNumber]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	return 1;
}

cmd:business(playerid)
{
	if(GetPlayerBizz(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вы не владеете бизнесом!");
	ShowPlayerDialog(playerid, 106+10, 2, ""cMain"Панель управления бизнесом", ""cMain"1. "cWH"Информация о бизнесе\n"cMain"2. "cWH"Открыть бизнес\n"cMain"3. "cWH"Установить цену за товар\n"cMain"4. "cWH"Установить цену за вход\n"cMain"5. "cWH"Продать бизнес\n"cMain"6. "cWH"Заказать продукты\n"cMain"7."cWH" Улучшения", "Принять", "Отмена");
	return 1;
}
alias:business("bpanel");

cmd:setbizprod(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setbizprod [количество продуктов]");
	for(new idx = TOTALBIZZ; idx > 0; idx--)
	{
		if(IsPlayerInRangeOfPoint(playerid, 4.0, BizzInfo[idx][bEntrx],BizzInfo[idx][bEntry],BizzInfo[idx][bEntrz]))
		{
			BizzInfo[idx][bProduct] = params[0];
			MysqlUpdateBizzInt(idx, "product", params[0]);
			SendMes(playerid, COLOR_WHITE, "Вы заменили бизнесу %s продуктов на %d",BizzInfo[idx][bName], BizzInfo[idx][bProduct]);
			fLogs("[admin] %s /setbizprod %i %i", GetName(playerid), idx, params[0]);
		}
	}
	return 1;
}

cmd:buybiz(playerid, params[])
{
	if(GetPlayerBizz(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Вы уже владеете бизнесом!");

	new full, full_;
	global_string = "";
	for(new idx = TOTALBIZZ; idx > 0; idx--)
	{
		if(IsPlayerInRangeOfPoint(playerid, 2.0, BizzInfo[idx][bEntrx],BizzInfo[idx][bEntry],BizzInfo[idx][bEntrz]))
		{
			full++;
			if(!strcmp(BizzInfo[idx][bOwner],"None",true))
			{
				full_++;

				new price_biz = GetReasonMoneyPercentVip(playerid, TYPE_VIP_BUSINESS, BizzInfo[idx][bPrice]);
				if(PI[playerid][pCash] < price_biz) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
				else
				{
					SetPlayerMoney(playerid, -price_biz);
					BizzInfo[idx][bBuyPrice] = BizzInfo[idx][bPrice] / 2;
					BizzInfo[idx][bProduct] = 100;
					BizzInfo[idx][bOplata] = 1;
					BizzInfo[idx][bOwned] = PI[playerid][pID];
					BizzInfo[idx][bMoney] = BizzInfo[idx][bBuyPrice] / 8000;
					BizzInfo[idx][bEnter] = 0;
					BizzInfo[idx][bTill] = 50;

					SendMes(playerid, -1, ""cDA"Вы купили бизнес %s за %dр. У вас осталось: %dр", BizzInfo[idx][bName], price_biz, PI[playerid][pCash]);
					SendClientMessage(playerid, -1, ""cPS"Аренда бизнеса оплачена на 1 день, не забывайте регулярно следить за его балансом.");
					SendInf(playerid, "Введите команду /business для управления бизнесом");

					strmid(BizzInfo[idx][bOwner],GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);

					format(global_string, 200, "UPDATE `bizz` SET owner = '%s', `owned` = '%d', buyprice = %d , product = %d, money = %d, oplata = %d WHERE id = '%d' LIMIT 1", BizzInfo[idx][bOwner], BizzInfo[idx][bOwned], BizzInfo[idx][bBuyPrice], BizzInfo[idx][bProduct],BizzInfo[idx][bMoney], BizzInfo[idx][bOplata], idx);
					mysql_tquery(db_prod, global_string, "", "");

					PI[playerid][pBiz] = idx;
					MysqlUpdatePlayerInt(playerid, "business", PI[playerid][pBiz]);
					UpdateBizz(idx);
					break;
				}
			}
			else full_++;
		}
	}
	if(full == 0) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится рядом с бизнесом!");
	if(full_ == 0) return SendClientMessage(playerid, COLOR_GREY, "Бизнес уже имеет владельца!");
	return 1;
}

cmd:sellmybiz(playerid, params[])
{
	if(!GetPlayerBizz(playerid)) return SendClientMessage(playerid, COLOR_DARKORANGE, "Вы не владеете бизнесом!");

	SendClientMessage(playerid, 0xCCCCCCFF, "Для продажи дома/передачи бизнеса игроку используйте биржу обмена");
	SendClientMessage(playerid, 0xCCCCCCFF, "/gps > Основные места > Биржа обмена");
	return 1;
}

cmd:play(playerid)
{
	if(SearchInventoryItem(playerid,40)==0){return SendClientMessage(playerid,COLOR_GREY,"У вас нет плеера MP3!");}
	ShowPlayerDialog(playerid, 9345, DIALOG_STYLE_LIST, ""cMain"Выберите радиостанцию", "1. Радио Шансон\n2. Наше Радио\n3. Радио Рекорд\n4. Зайцев.FM (Pop)\n5. Зайцев.FM (RnB)\n6. Выключить радио", "Выбор", "Выход");
	return 1;
}

CMD:rpanel(playerid)
{
	if(GetPlayerRooms(playerid) == 0) return SendClientMessage(playerid, COLOR_GREY, "У вас нет квартиры");
	new i = GetPlayerInRoom(playerid);
	if(strcmp(PI[playerid][pName],RoomsInfo[i][rOwner],true) == 0)
	{
		if(IsPlayerInRangeOfPoint(playerid, 15.0, RoomsInfo[i][rExitX], RoomsInfo[i][rExitY], RoomsInfo[i][rExitZ]))
		{
			format(string, sizeof(string), "\
			"cMain"1. "cWH"Закрыть/Открыть\n\
			"cMain"2. "cWH"Квартира оплачена на: {FFAA44}%d дн.\n\
			"cMain"3. "cWH"Продать", RoomsInfo[i][rOplata]);
			ShowPlayerDialog(playerid, 8050+4, 2, ""cMain"Панель управления Квартирой", string, "Принять", "Отмена");
		}
		else SendClientMessage(playerid, COLOR_GREY, "Вы не в квартире!");
	}
	return true;
}

cmd:endarend(playerid)
{
	if(!GetPlayerArend(playerid)) return SendClientMessage(playerid, COLOR_RED, "Вас нигде не поселили");

	ShowPlayerDialog(playerid, 18110, DIALOG_STYLE_MSGBOX, ""cMain"Выселиться из дома", ""cWH"Вы действительно хотите выселиться из дома, в который Вас поселили?", "Да", "Нет");

	return true;
}

cmd:home(playerid)
{
	if(GetPlayerHouse(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет дома!");
	new i = GetPlayerHouse(playerid);
	if(strcmp(GetName(playerid), HouseInfo[i][hOwner], true) == 0)
	{
		if((IsPlayerInRangeOfPoint(playerid,60.0,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]) || IsPlayerInRangeOfPoint(playerid,3.0,2934.4077,2967.4949,3176.5769)) && GetPlayerVirtualWorld(playerid) == HouseInfo[i][hVirtual])
		{
			format(string, sizeof(string), ""cWH"\
			"cMain"1. "cWH"Открыть / закрыть дом\n\
			"cMain"2. "cWH"Гардероб\n\
			"cMain"3. "cWH"Дом оплачен на: {FFAA44}%d дн.\n"cWH"\
			"cMain"4. "cWH"Аптечек в доме: {FFAA44}%d шт\n"cWH"\
			"cMain"5. "cWH"Улучшения дома\n\
			"cMain"6. "cWH"Продать дом\n\
			"cMain"7. "cWH"Управление арендой дома", HouseInfo[i][hOplata], HouseInfo[i][hHeal]);
			ShowPlayerDialog(playerid, 101, 2, ""cMain"Панель управления домом", string, "Принять", "Отмена");
		}
		else SendClientMessage(playerid, -1, ""cPS"Вы должны находится в вашем доме!");
	}
	return 1;
}
alias:home("hmenu");

cmd:sellmyhouse(playerid, params[])
{
	new i = GetPlayerHouse(playerid);
	if(i == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет дома!");
	SendClientMessage(playerid, 0xCCCCCCFF, "Для продажи дома/передачи дома игроку используйте биржу обмена");
	SendClientMessage(playerid, 0xCCCCCCFF, "/gps > Основные места > Биржа обмена");
	return true;
}

cmd:getbizstats(playerid, params[])
{
	new full = 0;
	for(new i = TOTALBIZZ; i > 0; i --)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, BizzInfo[i][bEntrx],BizzInfo[i][bEntry],BizzInfo[i][bEntrz]))
		{
			BizzStats(playerid, i);
			full++;
		}
	}
	if(full == 0) SendClientMessage(playerid, -1, ""cPS"Вы должны находиться рядом с бизнесом!");
	return 1;
}

cmd:bizlist(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	SendClientMessage(playerid, COLOR_GREEN, "Завоеванные бизнесы:");
	for(new h = 0; h < MAX_BIZZ; h++)
	{
		new mafiapay = BizzPay[h] / 10;
		switch(PI[playerid][pMember])
		{
		case TEAM_RUSMAFIA:
			{
				if(BizzInfo[h][bMafia] == TEAM_RUSMAFIA)
				{
					format(string, sizeof(string), "- %s, прибыль: %d", BizzInfo[h][bName], mafiapay);
					SendClientMessage(playerid, COLOR_YELLOW2, string);
				}
			}
		case TEAM_ITALMAFIA:
			{
				if(BizzInfo[h][bMafia] == TEAM_ITALMAFIA)
				{
					format(string, sizeof(string), "- %s, прибыль: %d", BizzInfo[h][bName], mafiapay);
					SendClientMessage(playerid, COLOR_YELLOW2, string);
				}
			}
		}
	}
	return 1;
}

CMD:ganginfo(playerid, params[])
{
	if(IsAGang(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вам не доступна данная возможность");

	new count = 0;
	STRING_GLOBAL[0] = EOS;
	foreach(new targetid : Player)
	{
		if(PI[playerid][pMember] == PI[targetid][pMember] && (DynamicInfo[targetid][CaptureKill] > 0 || DynamicInfo[targetid][CaptureDeath] > 0))
		{
			count ++;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cMain"%s\t"cMain"Убил: "cWH"%d\t"cMain"Умер: "cWH"%d\n", STRING_GLOBAL, GetName(targetid), DynamicInfo[targetid][CaptureKill], DynamicInfo[targetid][CaptureDeath]);
		}
	}
	if(count == 0) return ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Статистика войны за зону", "Нет информации о убийствах/смертях на стреле в вашей фракции", "Принять", "Отмена");
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Статистика войны за зону", STRING_GLOBAL, "Принять", "Отмена");
	return 0x1;
}

CMD:mafiainfo(playerid, params[])
{
	if(IsAMafia(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вам не доступна данная возможность");

	new count = 0;
	STRING_GLOBAL[0] = EOS;
	foreach(new targetid : Player)
	{
		if(PI[playerid][pMember] == PI[targetid][pMember] && (DynamicInfo[targetid][CaptureKill] > 0 || DynamicInfo[targetid][CaptureDeath] > 0))
		{
			count ++;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cMain"%s\t"cWH"Убил: "cMain"%d\t"cWH"Умер: "cMain"%d\n", STRING_GLOBAL, GetName(targetid), DynamicInfo[targetid][CaptureKill], DynamicInfo[targetid][CaptureDeath]);
		}
	}
	if(count == 0) return ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Статистика войны за бизнес", "Нет информации о убийствах/смертях на стреле в вашей фракции", "Принять", "Отмена");
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Статистика войны за бизнес", STRING_GLOBAL, "Принять", "Отмена");
	return 0x1;
}

cmd:capture(playerid, params[])
{
	if(!IsAGang(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	//if(PI[playerid][pMember] == TEAM_HITMAN) return 1;
	if(PI[playerid][pRank] < 7) return SendClientMessage(playerid,COLOR_GREY,"Захват территории доступен с 7 ранга и выше!");
	if(g_last_capture_time > unix) return SendClientMessage(playerid, COLOR_RED, "С момента предыдущего капта не прошло 15 минут");
	if(PI[playerid][pMember] == TEAM_CSKA && b_Capture{0}) return SendClientMessage(playerid, -1, ""cER"Доступ вашей банде к войне за территории закрыт");
	if(PI[playerid][pMember] == TEAM_SPARTAK && b_Capture{1}) return SendClientMessage(playerid, -1, ""cER"Доступ вашей банде к войне за территории закрыт");

	if(g_capture[C_STATUS]) return SendClientMessage(playerid, COLOR_RED, "В данный момент уже идёт капт");
	for(new idx = 0; idx < sizeof(GZInfo); idx ++)
	{
		if(IsPlayerInDynamicArea(playerid, GZInfo[idx][gArea]) && GZInfo[idx][gFrak] != PI[playerid][pMember])
		{
			StartCapture(playerid, idx, -1, PI[playerid][pMember], GZInfo[idx][gFrak]);
			return 1;
		}
	}
	SendClientMessage(playerid, COLOR_RED, "Вы не находитесь в зоне или эта зона Ваша");
	return 1;
}
StartCapture(playerid, zone_id=-1, biz_id=-1, fraction, zone_team)
{
	if(zone_id != -1)
	{
		format(stringer1, 144, "На вашу территорию напала банда %s, у вас есть 10 минут чтобы отстоять её!", Fraction_Name[fraction]);
		SendFMes(zone_team, COLOR_LIGHTRED, stringer1);

		format(stringer1, 144, "%s[%d] напал на территорию банды %s",GetName(playerid),playerid,Fraction_Name[zone_team]);
		SendFMes(fraction, COLOR_LIME, stringer1);

		format(stringer1,144, ""cAD"Банда %s напала на территорию банды %s",Fraction_Name[fraction],Fraction_Name[zone_team]);
		SendAdminMessage(COLOR_FADE1, stringer1);

		GangZoneFlashForAll(GZInfo[zone_id][gZone], GetGangFlashZone(fraction));
		g_capture[C_ZONE] = zone_id;
		g_capture[C_BIZ] = -1;
	}
	else if(biz_id != -1)
	{
		g_capture[C_BIZ] = biz_id;
		g_capture[C_ZONE] = -1;
	}

	g_capture[C_STATUS] = true;
	g_capture[C_ATTACK_TEAM] = fraction;
	g_capture[C_PROTECT_TEAM] = zone_team;
	g_capture[C_ATTACKER_KILLS] =
	g_capture[C_PROTECTOR_KILLS] = 0;
	g_capture[C_TIME] = 10 * 60;

	foreach(new idx: Player)
	{
		if(PI[idx][pMember] == fraction || PI[idx][pMember] == zone_team)
		{
			for(new i; i < 20; i ++) TextDrawShowForPlayer(idx, capture_td[i]);
			if(PlayerUseMask[idx])
			{
				CheckPlayerSkin(idx);
				PlayerUseMask[idx] = false;
				GameTextForPlayer(idx, "~y~INVISABLE OFF", 800, 4);
				MeAction(idx, "снимает маску");
				SetPlayerChatBubble(idx, "снимает маску", -1, 20.0, 500);
			}
		}
	}
	UpdateCaptureTextDraw();

	stringer1 = "";
	strcat(stringer1, Fraction_Name[ fraction ]);
	TextDrawSetString(capture_td[3], stringer1);

	stringer1 = "";
	strcat(stringer1, Fraction_Name[ zone_team ]);
	TextDrawSetString(capture_td[4], stringer1);
	return 1;
}
EndCapture()
{
	if(!g_capture[C_STATUS]) return 0;

	new attack_team = g_capture[C_ATTACK_TEAM];
	new protect_team = g_capture[C_PROTECT_TEAM];

	if(g_capture[C_ZONE] != -1)
	{
		new zone_id = g_capture[C_ZONE];
		if(g_capture[C_ATTACKER_KILLS] > g_capture[C_PROTECTOR_KILLS])
		{
			stringer1 = "Вы захватили новую территорию, которая находилась под контролем банды ";
			strcat(stringer1, Fraction_Name[protect_team]);
			SendFMes(attack_team,COLOR_GREEN, stringer1);

			stringer1 = "Вам не удалось отстоять свою территорию, теперь эта территория под контролем банды ";
			strcat(stringer1, Fraction_Name[attack_team]);
			SendFMes(protect_team, COLOR_RED, stringer1);

			GZInfo[zone_id][gFrak] = attack_team;

			SendFMes(attack_team, 0xFFFF00FF, "Просмотр информации о капте: "cWH"/ganginfo");
			SendFMes(protect_team, 0xFFFF00FF, "Просмотр информации о капте: "cWH"/ganginfo");
		}
		else
		{
			SendFMes(attack_team, 0xFFFF00FF, "Просмотр информации о капте: "cWH"/ganginfo");
			SendFMes(protect_team, 0xFFFF00FF, "Просмотр информации о капте: "cWH"/ganginfo");
			SendFMes(attack_team,COLOR_RED, "Вам не удалось захватить новую территорию");
			SendFMes(protect_team,COLOR_GREEN,"Вы отстояли свою территорию");
			GZInfo[zone_id][gFrak] = protect_team;
		}
		GangZoneStopFlashForAll(GZInfo[zone_id][gZone]);
		GangZoneHideForAll(GZInfo[zone_id][gZone]);
		GangZoneShowForAll(GZInfo[zone_id][gZone],GetGangZoneColor(zone_id));

		//printf("[debug] EndCapture -> zone_id: %d", zone_id);

		SaveGZ(zone_id);
		UpdTerrsBand();

		foreach(Player, otherid) if(PI[otherid][pMember] == attack_team || PI[otherid][pMember] == protect_team)
		{
			for(new i; i < 20; i ++) TextDrawHideForPlayer(otherid, capture_td[i]);
			nfor(i, 5) SendDeathMessageToPlayer(otherid, 1001, 1001, 200);
		}

		g_last_capture_time = unix + 900;
	}
	else if(g_capture[C_BIZ] != -1)
	{
		new biz_id = g_capture[C_BIZ];
		if(g_capture[C_ATTACKER_KILLS] > g_capture[C_PROTECTOR_KILLS])
		{
			stringer1 = "Вы захватили новый бизнес, которая находилась под контролем мафии ";
			strcat(stringer1, Fraction_Name[protect_team]);
			SendFMes(attack_team,COLOR_GREEN, stringer1);

			stringer1 = "Вам не удалось отстоять свой бизнес, теперь этот бизнес под контролем мафии ";
			strcat(stringer1, Fraction_Name[attack_team]);
			SendFMes(protect_team, COLOR_RED, stringer1);

			SendFMes(attack_team, 0xFFFF00FF, "Просмотр информации о капте: "cWH"/mafiainfo");
			SendFMes(protect_team, 0xFFFF00FF, "Просмотр информации о капте: "cWH"/mafiainfo");

			BizzInfo[biz_id][bMafia] = g_capture[C_ATTACK_TEAM];
		}
		else
		{
			SendFMes(attack_team,COLOR_RED, "Вам не удалось захватить новый бизнес");
			SendFMes(protect_team,COLOR_GREEN,"Вы отстояли свой бизнес");

			SendFMes(attack_team, 0xFFFF00FF, "Просмотр информации о капте: "cWH"/mafiainfo");
			SendFMes(protect_team, 0xFFFF00FF, "Просмотр информации о капте: "cWH"/mafiainfo");
		}
		foreach(Player, otherid) if(PI[otherid][pMember] == attack_team || PI[otherid][pMember] == protect_team)
		{
			for(new i; i < 20; i ++) TextDrawHideForPlayer(otherid, capture_td[i]);
			nfor(i, 5) SendDeathMessageToPlayer(otherid, 1001, 1001, 200);
		}

		MafiaTotalBizz[BizzInfo[biz_id][bMafia] == TEAM_ITALMAFIA ? 0 : 1]++;
		BizzInfo[biz_id][bZahvat] = 0;
		MysqlUpdateBizzInt(biz_id, "mafia", BizzInfo[biz_id][bMafia]);
		UpdateBizz(biz_id);

		GangZoneDestroy(g_bizwar_zone);
		g_last_bizwar_time = unix + 900;
	}
	g_capture[C_STATUS] = false;
	g_capture[C_ZONE] =
	g_capture[C_BIZ] =
	g_capture[C_ATTACK_TEAM] =
	g_capture[C_PROTECT_TEAM] = -1;
	g_capture[C_ATTACKER_KILLS] =
	g_capture[C_PROTECTOR_KILLS] =
	g_capture[C_TIME] = 0;
	return 1;
}
UpdateCaptureTextDraw()
{
	valstr(stringer1, g_capture[C_ATTACKER_KILLS]);
	TextDrawSetString(capture_td[1], stringer1);

	valstr(stringer1, g_capture[C_PROTECTOR_KILLS]);
	TextDrawSetString(capture_td[2], stringer1);

	format(stringer1, 64, "%d:%02d", g_capture[C_TIME] / 60, g_capture[C_TIME] % 60);
	TextDrawSetString(capture_td[13], stringer1);
	return 1;
}

cmd:bizwar(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(g_capture[C_STATUS]) return SendClientMessage(playerid, -1, ""cER"Война уже начата!");
	if(g_last_bizwar_time > unix) return SendClientMessage(playerid, COLOR_RED, "В момента предыдущего капта не прошло 15 минут");

	for(new h = 0; h < MAX_BIZZ; h++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 6.0, BizzInfo[h][bEntrx],BizzInfo[h][bEntry],BizzInfo[h][bEntrz]))
		{
			if(BizzInfo[h][bMafia] == PI[playerid][pMember])
			return SendClientMessage(playerid, -1, ""cER"Бизнес принадлежит вам!");

			if(BizzInfo[h][bMafia] == 0)
			{
				BizzInfo[h][bMafia] = PI[playerid][pMember];
				MafiaTotalBizz[BizzInfo[h][bMafia] == TEAM_ITALMAFIA ? 0 : 1]++;
				SendFMes(PI[playerid][pMember], RUSMAFIA_COLOR, "[F] Ваша мафия захватила новый бизнес!");
				MysqlUpdateBizzInt(h, "mafia", BizzInfo[h][bMafia]);
				UpdateBizz(h);
				return 1;
			}
			format(stringer1, 144,"%s назначил стрелу за %s мафии %s",GetName(playerid),BizzInfo[h][bName],BizzInfo[h][bMafia]);
			SendFMes(PI[playerid][pMember],COLOR_REDD,stringer1);

			format(stringer1, 144, "%s назначила вам стрелу за бизнес %s",Fraction_Name[PI[playerid][pMember]],BizzInfo[h][bName]);
			SendFMes(BizzInfo[h][bMafia],COLOR_REDD,stringer1);

			SendFMes(PI[playerid][pMember],COLOR_REDD,"Место встречи отмечено на карте (Мигающий квадрат)");
			SendFMes(BizzInfo[h][bMafia],COLOR_REDD,"Место встречи отмечено на карте (Мигающий квадрат)");

			g_capture[C_STATUS] = 1;
			g_capture[C_ATTACK_TEAM] = PI[playerid][pMember];
			g_capture[C_PROTECT_TEAM] = BizzInfo[h][bMafia];
			g_capture[C_BIZ] = h;
			BizzInfo[h][bZahvat] = 1;

			StartCapture(-1, -1, h, g_capture[C_ATTACK_TEAM], g_capture[C_PROTECT_TEAM]);

			g_bizwar_zone = GangZoneCreate(-258.9921,376.2745,-104.0616,546.9094);
			GangZoneShowForAll(g_bizwar_zone, COLOR_NEWS);
			GangZoneFlashForAll(g_bizwar_zone, COLOR_RED);
			return 1;
		}
	}
	SendClientMessage(playerid, -1, ""cER"Вы находитесь далеко от бизнеса!");
	return 1;
}

cmd:flight(playerid, params[])
{
	if(IsACopAndFSB(playerid) || PI[playerid][pMember] == TEAM_ARMY)
	{
		if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "Нельзя использовать в машине.");
		if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/flight [тип 1-2]");
		if(params[0] == 0)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
			if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
			SendClientMessage(playerid, COLOR_LIGHTGREEN, "Вы спрятали фонарик в карман.");
		}
		else if(params[0] == 1)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
			if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
			SendClientMessage(playerid, COLOR_LIGHTGREEN, "Вы достали фонарик малой дальности!");
			SetPlayerAttachedObject(playerid, 1, 18656, 5, 0.1, 0.038, -0.1, -90.0, 180.0, 0.0, 0.03, 0.03, 0.03);
			return SetPlayerAttachedObject(playerid, 2, 18641, 5, 0.1, 0.02, -0.05, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0);
		}
		else if(params[0] == 2)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
			if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
			SendClientMessage(playerid, COLOR_LIGHTGREEN, "Вы достали фонарик повышенной дальности!");
			SetPlayerAttachedObject(playerid, 1, 18656, 5, 0.1, 0.038, -0.01, -90.0, 180.0, 0.0, 0.03, 0.1, 0.03);
			return SetPlayerAttachedObject(playerid, 2, 18641, 5, 0.1, 0.02, -0.05, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0);
		}
	}
	else SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	return 1;
}

alias:suspect("su");
cmd:suspect(playerid, params[])
{
	if(!IsACopAndFSB(playerid) || PI[playerid][pRank] < 5) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new id;
	if(sscanf(params, "i", id)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/suspect [id игрока]");
	if(!IsPlayerConnected(id)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[id] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[id][pJail] > 0) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок уже находиться в тюрьме!");
	if(IsACopAndFSB(id) || PI[id][pMember] == TEAM_ARMY) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок полицейский/агент/военный!");
	if(PI[playerid][pMember] != TEAM_FSB && PI[id][pWanted] >= 3) return SendClientMessage(playerid, -1, ""cER"Вы не можете дать более 3-ех звезд!");
	if(PI[playerid][pMember] == TEAM_FSB && PI[id][pWanted] >= 6) return SendClientMessage(playerid, -1, ""cER"Вы не можете дать более 6-ти звезд!");

	new bool: in_pb = false;
	for(new i; i < MAX_PBPLAYER; i++)
	{
		if(PBP_PLAYERIDS[i] == INVALID_PLAYER_ID) continue;
		if(PBP_PLAYERIDS[i] != playerid) continue;
		in_pb = true;
		break;
	}
	if(in_pb) return SendClientMessage(playerid, COLOR_RED, "Вам запрещено использовать эту команду во время мероприятия");
	playerWantedID[playerid] = id;
	ShowPlayerDialog(playerid, 718, DIALOG_STYLE_LIST, ""cMain"Объявить в розыск", ""cWH"1. Причинение физического вреда здоровью\n2. Вооруженное нападение\n3. Угон транспортного средства\n4. Предложение/подкуп должностного лица\n5. Оружие\n6. Взятие в заложники\n7. Неподчинение\n8. Проникновение на охраняемую территорию\n9. Наркотики\n10. Отказ оплаты штрафа\n11. Мошенничество", "Выбрать", "Закрыть");
	return 1;
}

cmd:frisk(playerid, params[])
{
	if(IsACopAndFSB(playerid) || PI[playerid][pMember] == TEAM_ARMY)
	{
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/frisk [id игрока]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(playerid == params[0]) return SendClientMessage(playerid, -1, ""cER"Вы не можете обыскать себя!");
		if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
		SendMes(playerid, COLOR_WHITE, "Имущество %s", GetName(params[0]));

		new patr, narko;
		for(new s=1;s<MAX_SLOT;s++)
		{
			if(PlayerItem1[params[0]][s]==42){patr=s;}
			if(PlayerItem1[params[0]][s]==44){narko=s;}
		}
		SendMes(playerid, COLOR_GREY, "- %s", (PlayerItem2[params[0]][patr]) ? ("Патроны") : ("Пусто"));
		SendMes(playerid, COLOR_GREY, "- %s", (PlayerItem2[params[0]][narko]) ? ("Наркотики") : ("Пусто"));

		if(PI[playerid][pSex] == 1) format(string, sizeof(string), "достал перчатки и обыскал %s", GetName(params[0]));
		else format(string, sizeof(string), "достала перчатки и обыскала %s", GetName(params[0]));
		MeAction(playerid, string);
	}
	else SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	return 1;
}

cmd:ticket(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(sscanf(params, "iis[24]", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/ticket [id игрока] [сумма] [причина]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(params[1] < 1 || params[1] > 10000) return SendClientMessage(playerid, -1, ""cER"Сумма штрафа от 1р до 10000р");
	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_TICKET, params[1], _, params[2]);
	return 1;
}

cmd:canceldice(playerid)
{
	if(KostiName[playerid] == INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, ""cER"Вы не предлагали никому игру!");
	Predlog[playerid] = Predlog[KostiName[playerid]] =
	KostiMoney[playerid] = KostiMoney[KostiName[playerid]] =
	ZapretDice[playerid] = ZapretDice[KostiName[playerid]] = 0;
	SendClientMessage(KostiName[playerid], COLOR_RED, "Игрок отказался от ставки!");
	SendClientMessage(playerid, COLOR_RED, "Вы отказались играть!");
	KostiName[KostiName[playerid]] = KostiName[playerid] = INVALID_PLAYER_ID;
	return true;
}

cmd:dice(playerid, params[])
{
	if(!IsPlayerInRangeOfPoint(playerid,40.0,-115.5616,-38.2983,1298.0078)) return SendClientMessage(playerid, -1, ""cER"Вы должны находиться в казино!");
	if(KostiMoney[playerid] != 0 || ZapretDice[playerid] != 0) return SendClientMessage(playerid, -1, ""cER"Вам уже предложили игру!");
	if(sscanf(params, "ud", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/dice [id игрока] [ставка (в фишках)]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] < 1000 || params[1] > 100000000) return SendClientMessage(playerid, -1, ""cER"Минимальная ставка 1.000 фишек, максимальная 100.000.000 фишек");
	if(ZapretDice[params[0]] == 1) return SendClientMessage(playerid, -1, ""cER"В данный момент игрок не может играть!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 6.0) return SendClientMessage(playerid, -1, ""cER"Игрок не рядом с вами!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Самому себе нельзя предлагать игру");
	if(PhoneNumbers[playerid][0] < params[1]) return SendClientMessage(playerid, -1, ""cER"У вас недостаточно фишек. Вы можете купить фишки в обменнике казино");
	SendClientMessage(playerid, -1, ""cPS"Для того чтобы отказатся от своей ставки, введите /canceldice");

	format(string, sizeof(string), "Вы предложили %s бросить кости. Ставка: %d", GetName(params[0]), params[1]);
	SendClientMessage(playerid, COLOR_BLUE, string);
	format(string, sizeof(string), "%s предлагает бросить кости. Ставка: %d", GetName(playerid), params[1]);
	SendClientMessage(params[0], COLOR_BLUE, string);

	SendClientMessage(params[0], COLOR_WHITE, PlayerAccess);
	ZapretDice[playerid] = ZapretDice[params[0]] = 1;
	KostiName[playerid] = params[0];
	KostiName[params[0]] = playerid;
	KostiMoney[params[0]] = KostiMoney[playerid] = params[1];
	Predlog[playerid] = 1;
	return 1;
}

cmd:history(playerid, params[])
{
	new nickname[MAX_PLAYER_NAME];
	if(sscanf(params, "s[90]", nickname)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/history [имя игрока]");
	format(string, sizeof(string), "SELECT `id` FROM `accounts` WHERE `name` = '%s'", nickname);
	mysql_tquery(db_prod, string, "OnPlayerHistoryName", "d", playerid);
	return 1;
}

