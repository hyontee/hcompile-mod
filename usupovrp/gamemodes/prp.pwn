DLG(16, playerid, response, listitem, inputtext[])
{
	if(PlayerLogged[playerid] == false) return 1;
	if(PI[playerid][pAdmin] < 11 || AdminLogged[playerid] == false) return 1;
	if(TOTALATM >= MAX_ATM-2) return SendClientMessage(playerid, -1, ""cER"Вы не можете больше устанавливать банкоматы!");
	if(LoadATMObject[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY, "Вы уже устанавливаете банкомат!");
	ShowPlayerDialog(playerid, 62+9, 0, "Добавить банкомат", "Вы хотите начать установку банкомата?", "Да", "Нет");
	return 1;
}
