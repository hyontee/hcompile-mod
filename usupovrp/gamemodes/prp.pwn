		if(!vehid) return 1;
		if(GetVehicleType(vehid) == 7 || GetVehicleType(vehid) == 4) return 1;
		if(Fuel[vehid] >= 45) return SendClientMessage(playerid, -1, ""cER"Ваш бак полон!");
		if(player_fuel_count[playerid] >= 45) return 1;

		new fuel = BizzInfo[FuelBizzID[playerid]][bTill] / 3;
		if(fuel * player_fuel_count[playerid] > GetPlayerRubble(playerid)) return SendClientMessage(playerid, COLOR_RED, "Вы указали слишком большое кол-во топлива, на которое у Вас не хватит денег!");

		player_fuel_count[playerid]++;
		player_fuel_cost[playerid] += fuel;

		format(stringer1, sizeof(stringer1), "%dл.",player_fuel_count[playerid]);
		PlayerTextDrawSetString(playerid, TDP_Fuel[playerid][0], stringer1);

		format(stringer1, sizeof(stringer1), "цена: %d рублей",player_fuel_cost[playerid]);
