DLG(7708, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	switch(listitem)
	{
	case 0: ShowPlayerDialog(playerid, 7709, DIALOG_STYLE_LIST, ""cMain"Выберите действие:", "1. Положить деньги в общак\n2. Взять деньги из общака", "Далее", "Меню");
	case 1:
		{
			if(glFamilyCaptActive[PI[playerid][pFamily]] == 1) return SendClientMessage(playerid, -1, ""cER"Нельзя трогать евро, покуда не окончится война");
			ShowPlayerDialog(playerid, 2539, DIALOG_STYLE_LIST, ""cMain"Выберите действие:", "1. Положить деньги в общак\n2. Взять деньги из общака", "Далее", "Меню");
		}
	case 2: ShowPlayerDialog(playerid, 7710, DIALOG_STYLE_LIST, ""cMain"Выберите действие:", "1. Положить наркотики в общак\n2. Взять наркотики из общака", "Далее", "Меню");
	case 3: ShowPlayerDialog(playerid, 7711, DIALOG_STYLE_LIST, ""cMain"Выберите действие:", "1. Положить патроны в общак\n2. Взять патроны из общака", "Далее", "Меню");
	}
	return 1;
}
