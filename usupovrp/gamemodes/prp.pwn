	ShowPlayerDialogAdminCommands(playerid, 0);
	fLogs("[admin] %s /ahelp", GetName(playerid));
	return 1;
}

CMD:selladminhouse(playerid, params[])
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted"))
	{
		new houseid;
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "d", houseid)) return SendClientMessage(playerid, 0xCCCCCCFF, "Используйте: /selladminhouse [id]");

		new targetid = GetPlayerID(HouseInfo[houseid][hOwner]);
		if(targetid != INVALID_PLAYER_ID)
		{
			if(HouseInfo[houseid][hType] == 0)
			{
				SetPlayerMoney(targetid, HouseInfo[houseid][hPrice]);
			}
			PI[targetid][pSpawnChange] = 0;
			SendClientMessage(targetid, -1, ""cPS"Вы не оплатили электричество, ваш дом был передан гос-ву!");
			SendClientMessage(targetid, -1, ""cPS"На ваш банковский счет возвращена стоимость дома по гос-ву");
			PI[targetid][pHouse] = -1;

			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=0, house=-1 WHERE id=%d", PI[targetid][pID]);
			mysql_tquery(db_prod, stringer1);
		}

		HouseInfo[houseid][hLock] = 1;
		HouseInfo[houseid][hOwned] = -1;
		strmid(HouseInfo[houseid][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
		HouseInfo[houseid][hBuyPrice] = HouseInfo[houseid][hOplata] = HouseInfo[houseid][hGarage] = HouseInfo[houseid][hAutoDoors] = 0;

		global_string = "";
		format(global_string, sizeof(global_string), "UPDATE `house` SET hOwner='%s', `hOwned` = '-1', `hArendName` = 'none,none,none',hOplata=%d,buyprice=%d,hGarage=%d,hAutoDoors=%d,hLock=%d WHERE id=%d",
		HouseInfo[houseid][hOwner],HouseInfo[houseid][hOplata],HouseInfo[houseid][hBuyPrice],HouseInfo[houseid][hGarage],HouseInfo[houseid][hAutoDoors],HouseInfo[houseid][hLock],houseid);
		mysql_tquery(db_prod, global_string, "", "");
		UpdateHouse(houseid);
	}
	return 0x1;
}

