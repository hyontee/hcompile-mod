					if(b_Sklad{4} || PI[playerid][pRank] < UseStockRang[ GetSkladID(PI[playerid][pMember]) ]) return SendClientMessage(playerid, -1, ""cER"Доступ к складу вашей банды закрыт!");
					ShowPlayerDialog(playerid, 4000, 2, ""cMain"Склад банды", "{63BD4E}Положить патроны\n{63BD4E}Положить деньги\n{63BD4E}Положить наркотики\n"cWH"Взять патроны\nВзять деньги\nВзять наркотики", "Принять", "Отмена");
				}
				return 1;
