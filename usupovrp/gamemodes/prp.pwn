DLG(2400, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
		case 0:
		{
			if(PhoneNumbers[playerid][1] > 0) return SendClientMessage(playerid, -1, ""cER"У Вас уже есть паспорт!");
			if(GetPlayerRubble(playerid) < MP1[3]) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
			SetPlayerMoney(playerid, -MP1[3]);
			PhoneNumbers[playerid][1] = 100000 + random(900000);
			SendClientMessage(playerid, -1, ""cDA"Вы успешно получили паспорт. Чтобы показать, используйте команду /pass");
			SetMeriaCash(MP1[3]);
		}
	}
	return 1;
}

DLG(5600, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	if(GetActivePlayerVehicleCount(playerid) == 0)
		return SendClientMessage(playerid, COLOR_RED, "Загрузите свой автомобиль, прежде чем получить на него номерной знак (/car)");

	new
		count;

	global_string[0] = EOS;

	for(new i; i < MAX_LOAD_VEHICLE; i++)
	{
		if(PlayerVehicle[playerid][i] != INVALID_PLAYER_VEHICLE)
		{
			format(global_string, sizeof(global_string), "%s"cWH"%s\n", global_string, VehicleNames[GetVehicleModel(PlayerVehicle[playerid][i])-400]);
			SetPlayerListitemValue(playerid, count, PlayerVehicleSQL[playerid][i]);
			count ++;
		}
	}
	if(!count)
		SendErr(playerid, "Нет загруженных автомобилей");

	ShowPlayerDialog(playerid, 5601, DIALOG_STYLE_LIST, !""cMain"Выберите автомобиль", global_string, !"Выбрать", !"Закрыть");

	return 1;
}

DLG(5601, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	car_id[playerid] = GetPlayerListitemValue(playerid, listitem);

	new
		number_plate[32],
		query[256];

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", car_id[playerid]);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();
	if(rows > 0)
	{
		cache_get_field_content(0, "c_number", number_plate, db_prod, 32);
	}
	cache_delete(result);

	if(strcmp(number_plate, "None",true))
		return SendClientMessage(playerid, COLOR_RED, "У Вас уже имеются номера на автомобиле");
	if(nomercar[playerid] > unix)
		return SendClientMessage(playerid,COLOR_RED,""cER"Номера можно ставить раз в 10 минут");

	mysql_tquery(db_prod, "SELECT number FROM ownable_numbers f JOIN ( SELECT RAND( ) * ( SELECT MAX( id ) FROM ownable_numbers ) AS max_id) AS m WHERE f.id >= m.max_id AND is_used =0 ORDER BY f.id ASC LIMIT 1","DPSNumber_C","i",playerid);

	return 1;
}

DLG(5400, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][pAdmin] < 10) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа!");
			SendClientMessage(playerid, COLOR_BLUE, "VIP игроки:");
			foreach(new i: Player)
			{
				if(!PlayerLogged[i] || PI[i][pVip] == -1) continue;
				format(string, sizeof(string), "- %s[%d] (осталось дн.: %d)", GetName(i), i, PI[i][pVipTime]);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
		}
	case 1:
		{
			if(PI[playerid][pAdmin] < 10) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа!");
			SendClientMessage(playerid, COLOR_BLUE, "Игроки с мутом:");
			foreach(new i: Player)
			{
				if(!PlayerLogged[i] || !PI[i][pMuted]) continue;
				format(string, sizeof(string), "- %s[%d] (осталось: %d сек)", GetName(i), i, PI[i][pMuted]);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
		}
	case 2:
		{
			if(PI[playerid][pAdmin] < 10) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа!");
			SendClientMessage(playerid, COLOR_BLUE, "Игроки в тюрьме:");
			foreach(new i: Player)
			{
				if(!PlayerLogged[i] || !PI[i][pJail]) continue;
				format(string, sizeof(string), "- %s[%d] (осталось: %d сек)", GetName(i), i, PI[i][pJailTime]);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
		}
	case 3: callcmd::admins(playerid);
	case 4:
		{
			if(g_player_full_access[playerid])
			{
				mysql_tquery(db_prod, "SELECT * FROM `admin` WHERE level > '0'", "AllAdmins", "i", playerid);
			}
		}
	case 5:
		{
			if(PI[playerid][pAdmin] < 11) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа!");
			mysql_tquery(db_prod, "SELECT * FROM `accounts` WHERE leader > '0'", "Allleaders", "i", playerid);
		}
	case 6: callcmd::ahelp(playerid);
	case 7:
		{
			if(PI[playerid][pAdmin] < 8) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа!");
			global_string = "";
			format(global_string, 350, ""cWH"Телепорт к себе\t| %s\n"cWH"Телепорт себя\t| %s\n"cWH"Слежка за собой\t| %s\nИнформация",
			(AdminInfo[playerid][admGoto]) ? ("{F04245}Запрещён") : ("{63BD4E}Разрешён"),
			(AdminInfo[playerid][admGethere]) ? ("{F04245}Запрещён") : ("{63BD4E}Разрешён"),
			(AdminInfo[playerid][admSpectate]) ? ("{F04245}Запрещена") : ("{63BD4E}Разрешена"));
			ShowPlayerDialog(playerid, 5400+3, 2, ""cMain"Настройки администратора", global_string, "Выбрать", "Назад");
		}
	case 8:
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cWH"Посещение за все время\t{FFFF00}%d\n"cWH"Посещение за сегодня\t{FFFF00}%d\n"cWH"Посещение за час\t{FFFF00}%d\n"cWH"Регистраций за сегодня\t{FFFF00}%d", MD[5], Conday[0], Conday[1], Conday[2]);
			ShowPlayerDialog(playerid, 9565, DIALOG_STYLE_MSGBOX, ""cMain"Инфорация сервера", STRING_GLOBAL, "Назад", "Закрыть");
		}
	case 9:
		{
			if(g_player_full_access[playerid])
			{
				ShowPlayerDialog(playerid, 5400+5, DIALOG_STYLE_INPUT, "{11D2B5}снятие лидеров фракции", ""cWH"Введите ID фракции, которую необходимо расформировать лидеров(посмотреть можно в /setleader)","ОК","Отмена");
			}
		}
	case 10:
		{
			if(g_player_full_access[playerid])
			{
				if(PI[playerid][pAdmin] < 11) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа!");

				STRING_GLOBAL[0] = EOS;
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
				"cWH"Удвоение опыта\t[%s"cWH"]\n\
				"cWH"Удвоение доната\t[%s"cWH"]\n\
				"cWH"Удвоение зарплаты\t[%s"cWH"]\n\
				"cWH"Счастливые часы\t[%s"cWH"]\n\
				"cWH"Новый репорт\t[%s"cWH"]\n\
				"cWH"Донат бонусы\t[%s"cWH"]\n\
				"cWH"Призы мероприятий",
				(!doubling_exp) 	? ("{FF0000}Выключено") : ("{00FF00}Включено"),
				(!doubling_donate) 	? ("{FF0000}Выключено") : ("{00FF00}Включено"),
				(!doubling_job) 	? ("{FF0000}Выключено") : ("{00FF00}Включено"),
				(!happy_hours) 		? ("{FF0000}Выключено") : ("{00FF00}Включено"),
				(!new_report) 		? ("{FF0000}Выключено") : ("{00FF00}Включено"),
				(!donate_bonus) 	? ("{FF0000}Выключено") : ("{00FF00}Включено"));
				ShowPlayerDialog(playerid, 5400+2, 2, ""cMain"Управление сервером", STRING_GLOBAL, "Выбрать", "Назад");
			}
		}
	case 11:
		{
			if(g_player_full_access[playerid])
			{
				if(PI[playerid][pAdmin] < 11) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа!");
				if(!GetString(GetName(playerid), "Winston") && !GetString(GetName(playerid), "Eduard_Haunted") && !GetString(GetName(playerid), "Winston")) return SendClientMessage(playerid, -1, ""cER"У вас нет доступа!");

				ShowSettingDialogAC(playerid);
			}
		}
	}
	fLogs("[admin] %s /apanel %s", GetName(playerid), inputtext);
	return 1;
}
DLG(5402, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::apanel(playerid);
	switch(listitem)
	{
	case 0:
		{
			doubling_exp = (!doubling_exp) ? (1) : (0);
			MysqlUpdateOtherInt("d_exp", doubling_exp);
		}
	case 1:
		{
			doubling_donate = (!doubling_donate) ? (1) : (0);
			MysqlUpdateOtherInt("d_donate", doubling_donate);
		}
	case 2:
		{
			doubling_job = (!doubling_job) ? (1) : (0);
			MysqlUpdateOtherInt("d_jobik", doubling_job);
		}
	case 3:
		{
			ShowHappyHoursDialog(playerid);
		}
	case 4:
		{
			new_report = !new_report;

			SCMF(playerid, 0xFFCC00AA, "Вы %s новую систему репорта/вопроса", new_report ? "включили" : "выключили");

		}
	case 5:
		{
			donate_bonus = (!donate_bonus) ? (1) : (0);
			MysqlUpdateOtherInt("donate_bonus", donate_bonus);
		}
	case 6:
		{
			if(!GetString(GetName(playerid), "Winston") && GetString(GetName(playerid), "Winston")) return 1;
			global_string = "";

			format
			(
				global_string, sizeof global_string,
				""cWH"Сезонные ивенты\n"\
				""cWH"Battle Royale\t"cMain"(%d, %d, %d)\n"\
				""cWH"Дерби\t"cMain"(%d, %d, %d)\n"\
				""cWH"Прыжки с парашюта\t"cMain"(%d, %d, %d)",
				event_pubg_prize[0], event_pubg_prize[1], event_pubg_prize[2],
				event_derby_prize[0], event_derby_prize[1], event_derby_prize[2],
				event_skydiving_prize[0], event_skydiving_prize[1], event_skydiving_prize[2]
			);

			ShowPlayerDialog
			(
				playerid, 9002, DSL,
				""cMain"Призы меропритий",
				global_string,
				"Изменить", "Отмена"
			);

		}
	}
	if(listitem == 0 || listitem == 1 || listitem == 2 || listitem == 5)
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
		"cWH"Удвоение опыта\t[%s"cWH"]\n\
		"cWH"Удвоение доната\t[%s"cWH"]\n\
		"cWH"Удвоение зарплаты\t[%s"cWH"]\n\
		"cWH"Счастливые часы\t[%s"cWH"]\n\
		"cWH"Новый репорт\t[%s"cWH"]\n\
		"cWH"Донат бонусы\t[%s"cWH"]\n\
		"cWH"Призы мероприятий\n\
		",
		(!doubling_exp) 	? ("{FF0000}Выключено") : ("{00FF00}Включено"),
		(!doubling_donate) 	? ("{FF0000}Выключено") : ("{00FF00}Включено"),
		(!doubling_job) 	? ("{FF0000}Выключено") : ("{00FF00}Включено"),
		(!happy_hours) 		? ("{FF0000}Выключено") : ("{00FF00}Включено"),
		(!new_report) 		? ("{FF0000}Выключено") : ("{00FF00}Включено"),
		(!donate_bonus) 	? ("{FF0000}Выключено") : ("{00FF00}Включено"));
		ShowPlayerDialog(playerid, 5400+2, 2, ""cMain"Управление сервером", STRING_GLOBAL, "Выбрать", "Назад");
	}
	fLogs("[admin] %s /apanel управление %d", GetName(playerid), inputtext);
	return 1;
}
DLG(5406, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::apanel(playerid);

	if(!happy_hours && (doubling_exp || doubling_job || doubling_donate)) return SendClientMessage(playerid, COLOR_RED, "Нельзя использовать счастливые часы совместно с обычной X2 акцией");

	switch(listitem)
	{
	case 0:
		{

			ShowPlayerDialog
			(
			playerid,
			5400+7,
			DIALOG_STYLE_INPUT,
			""cMain"Укажите время",
			""cWH"Укажите время, до которого будут действовать счастливые часы\nНеобходимо указать час и минуты через ':'. Пример: 16:01\n\nУкажите время:",
			"Далее", "Отмена"
			);

			first_happy_hours[playerid] = 1;

		}
	case 1:
		{
			if(!happy_hours) return SendClientMessage(playerid, COLOR_RED, "Счастливые часы не запущены");
			happy_hours 		=
			happy_hours_hour	=
			happy_h_time		=
			happy_hours_time	=
			happy_hours_minute  =
			doubling_exp 		=
			doubling_donate 	=
			doubling_job 		= 0;

			mysql_tquery(db_prod, "UPDATE `accounts` SET credits=credits+donatepay, donatepay = 0 WHERE `online` = '1001' AND `donatepay` > '0'", "");

			foreach(new targetid : Player)
			{
				if(PlayerLogged[playerid] == false) continue;

				STRING_GLOBAL[0] = EOS;
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `donatepay` FROM `accounts` WHERE `name` = '%s' AND `donatepay` > '0'", PI[targetid][pName]);
				mysql_tquery(db_prod, STRING_GLOBAL, "ObnulDonatePay", "i", targetid);
			}

			SendClientMessageToAll(0xff9f21FF, "'Счастливые часы' были закончены досрочно. Акци X2 Donate, X2 EXP, X2 ЗП завершены");
			fLogs("[admin] %s /apanel управление счастливые часы остановить", GetName(playerid));

			DonateText[0] = CreateDynamic3DTextLabel("\
			{FFFF00}Заберите свой подарок\n\
			{FFFFFF}При пополнение от "cMain"500{FFFFFF} рублей получите в подарок "cMain"30%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополнение от "cMain"1.000{FFFFFF} рублей получите в подарок "cMain"40%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополненние от "cMain"2.500{FFFFFF} рублей получите в подарок "cMain"50%{FFFFFF} от суммы пополнения\n\n\
			{FFFFFF}Не работает при включенной акции "cMain"Счастливые часы", 0xAFAFAFFF, 461.9609,1679.4919,12.1884, 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

			DonateText[1] = CreateDynamic3DTextLabel("\
			{FFFF00}Заберите свой подарок\n\
			{FFFFFF}При пополнение от "cMain"500{FFFFFF} рублей получите в подарок "cMain"30%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополнение от "cMain"1.000{FFFFFF} рублей получите в подарок "cMain"40%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополненние от "cMain"2.500{FFFFFF} рублей получите в подарок "cMain"50%{FFFFFF} от суммы пополнения\n\n\
			{FFFFFF}Не работает при включенной акции "cMain"Счастливые часы", 0xAFAFAFFF, 2510.1682,-2143.8259,21.9766, 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

			DonateText[2] = CreateDynamic3DTextLabel("\
			{FFFF00}Заберите свой подарок\n\
			{FFFFFF}При пополнение от "cMain"500{FFFFFF} рублей получите в подарок "cMain"30%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополнение от "cMain"1.000{FFFFFF} рублей получите в подарок "cMain"40%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополненние от "cMain"2.500{FFFFFF} рублей получите в подарок "cMain"50%{FFFFFF} от суммы пополнения\n\n\
			{FFFFFF}Не работает при включенной акции "cMain"Счастливые часы", 0xAFAFAFFF, 1807.0496,2513.7751,15.6717, 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

		}
	case 2:
		{
			if(!happy_hours) return SendClientMessage(playerid, COLOR_RED, "Счастливые часы не запущены");
			ShowPlayerDialog(playerid, 5400+7, DIALOG_STYLE_INPUT, ""cMain"Изменить время", ""cWH"Укажите время, до которого будут действовать счастливые часы\nНеобходимо указать час и минуты через ':'. Пример: 16:01\n\nУкажите время:", "Далее", "Отмена");
		}
	case 3:
		{
			if(!happy_hours) return SendClientMessage(playerid, COLOR_RED, "Счастливые часы не запущены");
			ShowPlayerDialog(playerid, 5400+8, DIALOG_STYLE_INPUT, ""cMain"Частота оповещения", ""cWH"Укажите частоту оповещения (от 1 до 120 минут), через которую сервер будет оповещать о счастливых часах", "Далее", "Отмена");
		}
	}
	return 1;
}
DLG(5408, playerid, response, listitem, inputtext[])
{
	if(!response) return ShowHappyHoursDialog(playerid);
	if(null(inputtext)) ShowPlayerDialog(playerid, 5400+8, DIALOG_STYLE_INPUT, ""cMain"Частота оповещения", ""cWH"Укажите частоту оповещения (от 1 до 120 минут), через которую сервер будет оповещать о счастливых часах", "Далее", "Отмена");
	else if(!(1 <= strval(inputtext) <= 120)) ShowPlayerDialog(playerid, 5400+8, DIALOG_STYLE_INPUT, ""cMain"Частота оповещения", ""cWH"Укажите частоту оповещения (от 1 до 120 минут), через которую сервер будет оповещать о счастливых часах", "Далее", "Отмена");

	happy_hours_time = strval(inputtext);
	SendMes(playerid, COLOR_GREEN, "Теперь через каждые %d минут(у) в чат будет выводиться оповещение о действии 'Счастливых часов'", strval(inputtext));
	fLogs("[admin] %s /apanel управление счастливые часы оповещение %i", GetName(playerid), strval(inputtext));
	return 1;
}
DLG(5407, playerid, response, listitem, inputtext[])
{
	if(!response) return ShowHappyHoursDialog(playerid);

	new h_hours, h_minute;

	if(sscanf(inputtext, "p<:>ii", h_hours, h_minute)) return ShowPlayerDialog(playerid, 5400+7, DIALOG_STYLE_INPUT, ""cMain"Укажите время", ""cWH"Укажите время, до которого будут действовать счастливые часы\nНеобходимо указать час и минуты через ':'. Пример: 16:01\n\nУкажите время:", "Далее", "Отмена");
	if(!(0 <= h_hours <= 23)) return ShowPlayerDialog(playerid, 5400+7, DIALOG_STYLE_INPUT, ""cMain"Укажите время", ""cWH"Укажите время, до которого будут действовать счастливые часы\nНеобходимо указать час и минуты через ':'. Пример: 16:01\n\nУкажите время:", "Далее", "Отмена");
	if(!(0 <= h_minute <= 59)) return ShowPlayerDialog(playerid, 5400+7, DIALOG_STYLE_INPUT, ""cMain"Укажите время", ""cWH"Укажите время, до которого будут действовать счастливые часы\nНеобходимо указать час и минуты через ':'. Пример: 16:01\n\nУкажите время:", "Далее", "Отмена");

	happy_hours_hour = h_hours;
	happy_hours_minute = h_minute;

	global_string = "";

	if(first_happy_hours[playerid])
	{
		happy_hours = (!happy_hours) ? (1) : (0);

		format(global_string, 128, "На сервере активированы 'Счастливые часы'. До %02d:%02d по MCK запущены акции X2 Donate, X2 EXP, X2 ЗП", happy_hours_hour, happy_hours_minute);
		SendClientMessageToAll(0xff9f21FF, global_string);

		doubling_exp 		=
		doubling_donate 	=
		doubling_job 		= 1;

		happy_hours_time 	= 30;

		if(IsValidDynamic3DTextLabel(DonateText[0])) DestroyDynamic3DTextLabel(DonateText[0]);
		if(IsValidDynamic3DTextLabel(DonateText[1])) DestroyDynamic3DTextLabel(DonateText[1]);
		if(IsValidDynamic3DTextLabel(DonateText[2])) DestroyDynamic3DTextLabel(DonateText[2]);
	}
	else
	{
		format(global_string, 128, "Внимание! 'Счастливые часы' были продлены до %02d:%02d по MCK", happy_hours_hour, happy_hours_minute);
		SendClientMessageToAll(0xff9f21FF, global_string);
		SendClientMessageToAll(0xff9f21FF, "До этого времени на сервере запущены акции X2 Donate, X2 EXP, X2 ЗП");

		if(IsValidDynamic3DTextLabel(DonateText[0])) DestroyDynamic3DTextLabel(DonateText[0]);
		if(IsValidDynamic3DTextLabel(DonateText[1])) DestroyDynamic3DTextLabel(DonateText[1]);
		if(IsValidDynamic3DTextLabel(DonateText[2])) DestroyDynamic3DTextLabel(DonateText[2]);
	}
	fLogs("[admin] %s /apanel управление счастливые часы %i %i", GetName(playerid), happy_hours_hour, happy_hours_minute);
	first_happy_hours[playerid] = 0;
	return 1;
}
DLG(5403, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::apanel(playerid);
	if(listitem < 3)
	{
		new Query[128];
		global_string = "";
		switch(listitem)
		{
		case 0:
			{
				AdminInfo[playerid][admGoto] = (!AdminInfo[playerid][admGoto]) ? (1) : (0);
				format(Query, sizeof(Query), "UPDATE `admin` SET a_goto='%d' WHERE name='%s' LIMIT 1", AdminInfo[playerid][admGoto], GetName(playerid));
				mysql_tquery(db_prod, Query, "", "");
			}
		case 1:
			{
				AdminInfo[playerid][admGethere] = (!AdminInfo[playerid][admGethere]) ? (1) : (0);
				format(Query, sizeof(Query), "UPDATE `admin` SET a_gethere='%d' WHERE name='%s' LIMIT 1", AdminInfo[playerid][admGoto], GetName(playerid));
				mysql_tquery(db_prod, Query, "", "");
			}
		case 2:
			{
				AdminInfo[playerid][admSpectate] = (!AdminInfo[playerid][admSpectate]) ? (1) : (0);
				format(Query, sizeof(Query), "UPDATE `admin` SET a_spec='%d' WHERE name='%s' LIMIT 1", AdminInfo[playerid][admGoto], GetName(playerid));
				mysql_tquery(db_prod, Query, "", "");
			}
		}
		format(global_string, 200, ""cWH"Телепорт к себе\t| %s\n"cWH"Телепорт себя\t| %s\n"cWH"Слежка за собой\t| %s\nИнформация",
