IsValidMail(email[], len = sizeof email)
{
	new count[2];
	if(!(5 <= len <= 60)) return 0;
	for(new i; i != len; i++)
	{
		switch(email[i])
		{
		case '@':
			{
				count[0]++;
				if(count[0] != 1 || i == len - 1 || i == 0) return 0;
			}
		case '.':
			{
				if(count[0] == 1 && count[1] == 0 && i != len - 1)
				{
					count[1] = 1;
				}
			}
		case '0'..'9', 'a'..'z', 'A'..'Z', '_', '-':
			{
				continue;
			}
		default: return 0;
		}
	}
	if(count[1] == 0) return 0;
	return 1;
}

callback::SelectFractionSub(playerid)
{
	new rows = cache_num_rows();
	if(!rows) return SendClientMessage(playerid, COLOR_RED, "В этой организации нет заместителей");

	new sub_name[MAX_PLAYER_NAME], to_player = INVALID_PLAYER_ID, status[32], query_string[128], mainsub;
	global_string = "";
	for(new idx; idx < rows; idx ++)
	{
		cache_get_field_content(idx, "name", sub_name, db_prod, MAX_PLAYER_NAME);
		mainsub = cache_get_field_content_int(idx, "mainsub");

		to_player = GetPlayerID(sub_name);
		if(to_player == INVALID_PLAYER_ID) status[0] = EOS, format(status, 32, "{FF6600}Оффлайн"cWH"");
		else status[0] = EOS, format(status, 32, ""cMain"Онлайн (%d)"cWH"", to_player), mainsub = PI[to_player][pMainSub];

		format(query_string, sizeof query_string, ""cMain"%d. "cWH"%s - %s %s\n", idx + 1, sub_name, status, mainsub ? "(главный заместитель)" : "");
		strcat(global_string, query_string);

		mainsub = 0;
		new id = cache_get_field_content_int(idx, "id");
		g_player_listitem[playerid][idx] = id;
	}
	ShowPlayerDialog(playerid, 9010, DIALOG_STYLE_LIST,""cMain"Список заместителей:",global_string,"Статистика", "Закрыть");
	return 1;
}

DLG(9010, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	format(stringer1, 128, "SELECT * FROM accounts a, accounts_online ao WHERE a.id=%d AND ao.id=a.id", g_player_listitem[playerid][listitem]);
	mysql_tquery(db_prod, stringer1, "FractionSubStats", "d", playerid);
	printf("%s",stringer1 );
	return 1;
}

callback::FractionSubStats(playerid)
{
	new rows = cache_num_rows();
	if(!rows) return SendClientMessage(playerid, COLOR_RED, "Произошла ошибка.");

	new name[MAX_PLAYER_NAME];
	cache_get_field_content(0, "name", name, db_prod, 24);

	static const Names_Days[7][12] = {"saturday","sunday","monday","tuesday","wednesday","thursday","friday"};

	new new_day = day_weeks;

	new get_day_name[32];
	strcat(get_day_name, "online_");
	strcat(get_day_name, Names_Days[new_day]);

	new online_today = cache_get_field_content_int(0, get_day_name);//g_player_online[playerid][new_day];

	new dayss = new_day--;
	if(dayss >= 7) new_day -= 7;
	else if(dayss < 0) new_day = 7;

	get_day_name[0] = EOS;
	strcat(get_day_name, "online_");
	strcat(get_day_name, Names_Days[dayss]);

	new online_yesterday = cache_get_field_content_int(0, get_day_name);

	new online_week =
	cache_get_field_content_int(0, "online_monday") +
	cache_get_field_content_int(0, "online_tuesday") +
	cache_get_field_content_int(0, "online_wednesday") +
	cache_get_field_content_int(0, "online_thursday") +
	cache_get_field_content_int(0, "online_friday") +
	cache_get_field_content_int(0, "online_saturday") +
	cache_get_field_content_int(0, "online_sunday");

	global_string = "";
	format(global_string, sizeof global_string,
	""cWH"Имя: "cMain"%s\n\n"\
	""cWH"Организация: "cMain"%s\n"\
	""cWH"Главный заместитель: "cMain"%s\n\n"\
	""cWH"В игре за сегодня: "cMain"%s\n"\
	""cWH"В игре за вчера: "cMain"%s\n"\
	""cWH"В игре за неделю: "cMain"%s\n"\
	""cWH"Принято игроков: "cMain"%d\n"\
	""cWH"Уволено игроков: "cMain"%d\n"\
	""cWH"Выдано выговоров: "cMain"%d",
	name, Fraction_Name[cache_get_field_content_int(0, "member")], cache_get_field_content_int(0, "mainsub") ? "Да" : "Нет",

	ConvertSeconds(online_today),
	ConvertSeconds(online_yesterday),
	ConvertSeconds(online_week),

	cache_get_field_content_int(0, "sub_invited"),
	cache_get_field_content_int(0, "sub_uninvited"),
	cache_get_field_content_int(0, "sub_twarns"));
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Статистика заместителя", global_string, "Закрыть", "");
	return 1;
}

callback::TransferBank(playerid, id, sum, accountid)
{
	if(cache_num_rows())
	{
		new acc_id = cache_get_field_content_int(0, "owner");

		foreach(new i: Player) if(PI[i][pID] == acc_id)
		{
			for(new idx; idx < 5; idx ++)
			{
				if(GetPlayerBankAccountData(i, idx, B_ID) == id)
				{
					if((g_player_bank_accounts[i][idx][B_BALANCE] + sum) > 2000000000) return SendClientMessage(playerid, 0xCCCCCCFF, "Не возможно пополнить данный счет на такую сумму");
					if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) != GetPlayerBankAccountData(i, idx, B_TYPE)) return SendClientMessage(playerid, 0xCCCCCCFF, "Вы не можете перевести одну валюту на счет с другой валютой");

					if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 0)
					{
						g_player_bank_accounts[i][idx][B_BALANCE] += sum;
						g_player_bank_accounts[playerid][accountid][B_BALANCE] -= sum;

						format(global_string, 144, "На ваш счёт №%d поступил перевод на %d руб. от %s[%d]", id, sum, GetName(playerid), playerid);
						SendClientMessage(i, 0xFFCC00AA, global_string);

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = `balance`+'%d' WHERE `id` = '%d' LIMIT 1", sum, id);
						mysql_tquery(db_prod, STRING_GLOBAL);

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
						mysql_tquery(db_prod, STRING_GLOBAL);

						format(global_string, sizeof global_string, "Вы успешно отправили %d рублей на счёт №%d", sum, id);
						SendClientMessage(playerid, 0xFFCC00AA, global_string);

						format(stringer1, sizeof stringer1, "- Перевод на счёт №%d сумма %d рублей", id, sum);
						SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
						UpdateBankMoneyText(playerid, accountid);

						format(stringer1, sizeof stringer1, "+ Перевод со счета №%d на сумму %d рублей", GetPlayerBankAccountData(playerid, accountid, B_ID), sum);
						SendBankAccountLog(i, id, stringer1);
						UpdateBankMoneyText(playerid, accountid);
						return 1;
					}
					if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1)
					{
						g_player_bank_accounts[i][idx][B_BALANCE] += sum;
						g_player_bank_accounts[playerid][accountid][B_BALANCE] -= sum;

						format(global_string, 144, "На ваш счёт №%d поступил перевод на %d евро от %s[%d]", id, sum, GetName(playerid), playerid);
						SendClientMessage(i, 0xFFCC00AA, global_string);

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = balance+%d WHERE `id` = '%d' LIMIT 1", sum, id);
						mysql_tquery(db_prod, STRING_GLOBAL);

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = balance-%d WHERE `id` = '%d' LIMIT 1", sum, GetPlayerBankAccountData(playerid, accountid, B_ID));
						mysql_tquery(db_prod, STRING_GLOBAL);

						format(global_string, sizeof global_string, "Вы успешно отправили %d евро на счёт №%d", sum, id);
						SendClientMessage(playerid, 0xFFCC00AA, global_string);

						format(stringer1, sizeof stringer1, "- Перевод на счёт №%d сумма %d евро", id, sum);
						SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
						UpdateBankMoneyText(playerid, accountid);

						format(stringer1, sizeof stringer1, "+ Перевод со счета №%d на сумму %d евро", GetPlayerBankAccountData(playerid, accountid, B_ID), sum);
						SendBankAccountLog(i, id, stringer1);
						UpdateBankMoneyText(playerid, accountid);
						return 1;
					}
				}
			}
		}
		SendErr(playerid, "Игрок не на сервере");
		return 1;
	}
	SendErr(playerid, "Не найден счет");
	return 1;
}

callback::ResultAddFriend(playerid, targetid)
{
	if(cache_num_rows())
	{
		new total_friends = cache_get_row_int(0, 0);
		if(total_friends > 20)
		{
			SendMes(targetid, COLOR_GREY, "У игрока %s достигнут лимит дуей (20)", GetName(playerid));
			SendMes(playerid, COLOR_GREY, "Вы не можете начать дружить с %s потому что у Вас достигнул лимит друзей (20)", GetName(targetid));
			return 1;
		}
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `friends` (`login`, `friend`) VALUES ('%e', '%e')", GetName(targetid), GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `friends` (`login`, `friend`) VALUES ('%e', '%e')", GetName(playerid), GetName(targetid));
		mysql_tquery(db_prod, STRING_GLOBAL);

		SendMes(playerid, COLOR_GREEN, "Вы успешно начали дружить с %s", GetName(targetid));
		SendMes(targetid, COLOR_GREEN, "Вы успешно начали дружить с %s", GetName(playerid));
	}

	return 1;
}

callback::CreateBankAccount(playerid, name[])
{
	if(cache_num_rows())
	{
		new total_bank_accounts = cache_get_row_int(0, 0);
		if(total_bank_accounts > 4)
		return SendClientMessage(playerid, COLOR_RED, "Вы достигли максимальное количество счетов (5)");

		PlayerFixBank[playerid][0] = EOS;
		format(PlayerFixBank[playerid], 64, "%s", name);
		ShowPlayerDialog(playerid, 2530, DIALOG_STYLE_MSGBOX, ""cMain"Выбор валюты", "Выберите валюту для вашего нового счета", "Рубли", "Евро");
	}
	return 1;
}

DLG(2530, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bank_accounts` (`type`, `owner`, `name`, `balance`) VALUES ('0', '%d', '%e', '0')", PI[playerid][pID], PlayerFixBank[playerid]);
		mysql_tquery(db_prod, STRING_GLOBAL);
	}
	else
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bank_accounts` (`type`, `owner`, `name`, `balance`) VALUES ('1', '%d', '%e', '0')", PI[playerid][pID], PlayerFixBank[playerid]);
		mysql_tquery(db_prod, STRING_GLOBAL);

	}
	SetPlayerMoney(playerid, -1000000);
	SetTimerEx("OnPlayerLoadBank", 100, 0, "i", playerid);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы успешно создали банковский счёт \"%s\"", PlayerFixBank[playerid]);
	SendClientMessage(playerid, 0xFFCC00AA, STRING_GLOBAL);
	return 0x1;
}

callback::FriendAction(playerid, listitem)
{
	new number_phone[32],
	to_player_name[MAX_PLAYER_NAME],
	to_player = INVALID_PLAYER_ID;

	if(cache_num_rows())
	{
		cache_get_field_content(0, "phonenumber", number_phone, db_prod, 32);
		cache_get_field_content(0, "name", to_player_name, db_prod, MAX_PLAYER_NAME);
		to_player = GetPlayerID(to_player_name);
	}
	if(0 <= listitem <= 1)
	{
		if(to_player == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_RED, "Этот игрок не в сети");
		if(!PlayerLogged[to_player]) return SendClientMessage(playerid, COLOR_RED, "Этот игрок не в сети");
		if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"У Вас нет телефона");}
		if(!strcmp(number_phone, "0")) return SendClientMessage(playerid, COLOR_RED, "У этого игрока нет телефона");
	}
	friend_to_player[playerid] = to_player;

	switch(listitem)
	{
	case 0:
		{
			if(Phone[to_player] == false)
			return SendClientMessage(playerid, -1, ""cER"Игрок выключил телефон!");

			if(Ether[to_player] == true)
			return SendClientMessage(playerid, -1, ""cER"Действие невозможно!");

			if(Mobile[to_player] != -1)
			return SendClientMessage(playerid, -1, ""cER"Игрок уже разговаривает по телефону!");

			if(PI[to_player][pJail] > 0)
			return SendClientMessage(playerid, COLOR_GREY, "Абонент временно недоступен!");

			Mobile[playerid] = to_player;
			SendMes(to_player, COLOR_WHITE, "Ваc вызывает: %s (%d). Чтобы ответить, введите: /pickup (/p)", GetName(playerid), PI[playerid][pPhoneNumber]);

			global_string = "";
			format(global_string, sizeof(global_string), "У %s звонит мобильный телефон", GetName(to_player));
			ProxDetector(13.0, to_player, global_string, COLOR_PURPLE);

			SendClientMessage(playerid, COLOR_WHITE, "Чтобы повесить трубку, введите: /hangup (/h)");
			if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, 11);
			CellTime[playerid] = 0;

			phone_call_to_id[playerid] = to_player;
		}
	case 1:
		{
			ShowPlayerDialog(playerid, 5236, DIALOG_STYLE_INPUT,""cMain"Смс игроку",""cWH"Введите текст смс:","Отправить", "Отмена");
		}
	case 2:
		{
			global_string = "";
			format(global_string, 120, ""cWH"Вы действительно хотите удалить "cMain"%s "cWH"из списка друзей?", to_player_name);
			ShowPlayerDialog(playerid, 1627, DIALOG_STYLE_MSGBOX,""cMain"Удаление друга",global_string,"Да", "Нет");
		}
	}
	return 1;
}

callback::SelectPlayerRegID(playerid)
{
	if(cache_num_rows())
	{
		PI[playerid][pID] = cache_get_field_content_int(0, "id");

		format(stringer1, sizeof(stringer1),"SELECT * FROM `inventory` WHERE `Name` = '%s'", GetName(playerid));
		mysql_tquery(db_prod, stringer1, "LoadPlayerItem","d", playerid);

		format(stringer1, 128, "SELECT * FROM accounts_online WHERE `id` = '%d'", PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1, "LoadOnline", "dd", playerid, -1);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `bank_accounts` WHERE `owner` = '%d'", PI[playerid][pID]);
		mysql_tquery(db_prod, STRING_GLOBAL, "LoadBankAccounts", "d", playerid);
	}
	return 1;
}

callback::GetPlayerCountFriends(playerid)
{
	if(!cache_num_rows()) return 1;
	if(cache_get_row_int(0, 0) > 20) return SendClientMessage(playerid, COLOR_RED, "Вы не можете иметь более 20 друзей");
	ShowPlayerDialog(playerid, 9437, DIALOG_STYLE_INPUT,""cMain"Новый друг",""cWH"Введи ид игрока, которого хотите добавить в друзья:","Добавить", "Отмена");
	return 1;
}

callback::CheckFriend(playerid, to_player)
{
	if(cache_num_rows()) return SendClientMessage(playerid, COLOR_RED, "Этот игрок уже есть в списке Ваших друзей");
	if(GetDistanceBetweenPlayers(playerid, to_player) > 8.0) return SendClientMessage(playerid, COLOR_RED, "Игрок должен находиться рядом с Вами");
	SendPlayerProposition(playerid, to_player, PROPOSITION_TYPE_FRIEND);
	return 1;
}

callback::DeleteFriend(playerid, id)
{
	new rows, field;
	cache_get_data(rows, field);

	if(rows)
	{
		new
		to_player_name[MAX_PLAYER_NAME],
		to_player = INVALID_PLAYER_ID;

		cache_get_field_content(0, "friend", to_player_name, db_prod, MAX_PLAYER_NAME);

		to_player = GetPlayerID(to_player_name);

		global_string = "";
		format(global_string, 144, "Вы успешно удалили %s из списка друзей", to_player_name);
		SendClientMessage(playerid, 0xFFCC00AA, global_string);

		if(to_player != INVALID_PLAYER_ID)
		{
			global_string = "";
			format(global_string, 144, "Игрок %s удалил Вас из списка друзей", GetName(playerid));
			SendClientMessage(to_player, 0xFFCC00AA, global_string);
		}

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `friends` WHERE `id` = '%d'", id);
		mysql_tquery(db_prod, STRING_GLOBAL);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `friends` WHERE `login` = '%e' AND `friend` = '%e'", to_player_name, GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL);
	}
	return 1;
}
callback::accessories_in(playerid, access)
{
	SetPlayerAccessoriesData(playerid, access, A_ID, cache_insert_id());

	global_string = "";
	format(global_string, 144, "Вы успешно приобрели аксессуар \"%s\"", g_accessories_objects_names[ PI[playerid][pAccType] ]);
	SendClientMessage(playerid, 0xFFCC00AA, global_string);

	TogglePlayerControllable(playerid,true);
	SetPlayerPos(playerid, 2699.2236,299.5913,1401.0000);
	SetPlayerFacingAngle(playerid, 180.0);

	SetCameraBehindPlayer(playerid);

	if(PI[playerid][pAccObject] != INVALID_OBJECT_ID) DestroyPlayerObject(playerid, PI[playerid][pAccObject]), PI[playerid][pAccObject] = INVALID_OBJECT_ID;

	for(new i; i < 23; i ++) TextDrawHideForPlayer(playerid, td_acessories_global[i]);
	PlayerTextDrawHide(playerid, td_acessories_player[playerid]);

	CancelSelectTextDrawEx(playerid);
	return 1;
}
cmd:offcheck(playerid, params[])
{
	if(PI[playerid][pAdmin] < 4) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "s[24]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offcheck [name]");
	if(IsPlayerConnected(GetPlayerID(params[0]))) return SendClientMessage(playerid, COLOR_RED,"Игрок онлайн!");

	mysql_format(db_prod, string, sizeof(string), "SELECT * FROM `accounts` WHERE `name`='%e'", params[0]);
	mysql_tquery(db_prod, string, "OfflineStatsPlayer", "ds", playerid, params[0]);
	return 1;
}
callback::OfflineStatsPlayer(playerid, name[])
{

	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, COLOR_RED,"Аккаунт не найден!!");
	new ip[16],reg_ip[16],mail[64],data_r[16],wh_mar[24],last_conn[24];
	cache_get_field_content(0, "ip", ip, db_prod, 16);
	cache_get_field_content(0, "regip", reg_ip, db_prod, 16);
	cache_get_field_content(0, "mail", mail, db_prod, 64);
	cache_get_field_content(0, "datareg", data_r, db_prod, 15);
	cache_get_field_content(0, "whomarried", wh_mar, db_prod, MAX_PLAYER_NAME);
	cache_get_field_content(0, "datavhod", last_conn, db_prod, 24);

	new id = cache_get_field_content_int(0, "id");
	new adm = cache_get_field_content_int(0, "admin");
	new lvl = cache_get_field_content_int(0, "level");
	new cash = cache_get_field_content_int(0, "cash");
	new exp = cache_get_field_content_int(0, "exp");
	//new leader = cache_get_field_content_int(0, "leader");
	new member = cache_get_field_content_int(0, "member");
	new rank = cache_get_field_content_int(0, "rank");
	new warn = cache_get_field_content_int(0, "warn");
	new sex = cache_get_field_content_int(0, "sex");
	new age = cache_get_field_content_int(0, "age");
	new ph_num = cache_get_field_content_int(0, "phonenumber");
	new married = cache_get_field_content_int(0, "married");


	new vip = cache_get_field_content_int(0, "vip");

	new status_text[20], married_text[MAX_PLAYER_NAME], phone_text[20];
	if(married == 0) format(married_text, sizeof(married_text), "Нет");
	else format(married_text, sizeof(married_text), "%s", wh_mar);

	if(ph_num <= 1) format(phone_text, sizeof(phone_text), "Не имеется");
	else format(phone_text, sizeof(phone_text), "%d", ph_num);
	if(adm) status_text = "Администратор";
	else if(vip) status_text = "VIP";
	else status_text = "Игрок";
	new sctring[1400], str[250];
	format(str,sizeof(str),""cWH"Имя:\t"cMain"%s\t|\t"cWH"dbID: "cMain"%d\n",name,id);
	strcat(sctring,str);
	format(str,sizeof(str),""cWH"Уровень:\t{FFAA44}%d (%d/%d)\n",lvl,exp, (lvl+1)*4);
	strcat(sctring,str);
	format(str,sizeof(str),""cWH"Возраст:\t%d\n",age);
	strcat(sctring,str);
	format(str,sizeof(str),"Предупреждения:\t%d / 3\n",warn);
	strcat(sctring,str);
	format(str,sizeof(str),"Наличные:\t%dр\n",cash);
	strcat(sctring,str);
	format(str,sizeof(str),"Номер телефона:\t%s\n",phone_text);
	strcat(sctring,str);
	if(sex == 1) format(str,sizeof(str),"Женат на:\t%s\n",married_text);
	else format(str,sizeof(str),"Замужем за:\t%s\n",married_text);
	strcat(sctring,str);
	format(str,sizeof(str),"Пол:\t%s\n",(sex==1)?("Мужчина"):("Женщина"));
	strcat(sctring,str);
	if(member != 0) format(str,sizeof(str),"Организация:\t{63BD4E}%s"cWH"\n",Fraction_Name[member]);
	else format(str,sizeof(str),"Организация:\tНет\n");
	strcat(sctring,str);
	if(rank != 0) format(str,sizeof(str),"Должность:\t{63BD4E}%s (%d)"cWH"\n\n",frakRangName[member][rank],rank);
	else format(str,sizeof(str),"Должность:\tНет\n\n");
	strcat(sctring,str);
	new number_bizz = 0;
	for(new i = TOTALBIZZ; i > 0; i --)
	{
		if(!strcmp(BizzInfo[i][bOwner],name,true)) number_bizz = i;
	}
	format(str,sizeof(str),"Бизнеc:\t%s (%d)\n",BizzInfo[number_bizz][bName],number_bizz);
	strcat(sctring,str);
	new number_house = 0;
	for(new i = TOTALHOUSE; i > 0; i--)
	{
		if(!strcmp(HouseInfo[i][hOwner],name,true)) number_house = i;
	}
	format(str,sizeof(str),"Дом:\t№%d\n",number_house);
	strcat(sctring,str);


	//PI[playerid][pFamilyRank] =  cache_get_field_content_int(0, "familyrank");
	new lwarn = cache_get_field_content_int(0, "lwarn");
	new twarn = cache_get_field_content_int(0, "twarn");
	new car_count = cache_get_field_content_int(0, "countcars");
	new donate = cache_get_field_content_int(0, "credits");
	new mats = cache_get_field_content_int(0, "mats");
	new bonusday = cache_get_field_content_int(0, "bonusday");

	format(str,sizeof(str),"\n"SERVER_COINS":\t%d\n",donate);
	strcat(sctring,str);

	format(str,sizeof(str),"Статус:\t%s\n",status_text);
	strcat(sctring,str);
	format(str,sizeof(str),"Материалов:\t%d\n",mats);
	strcat(sctring,str);
	format(str,sizeof(str),"R-IP:\t%s \t|\tL-IP:\t%s\n",reg_ip,ip);
	strcat(sctring,str);
	format(str,sizeof(str),"data reg:\t%s \t|\tlast login:\t%s\n",data_r,last_conn);
	strcat(sctring,str);
	format(str,sizeof(str),"lwarn:\t%d / 3\t|\ttwarn:\t%d / 3\n",lwarn,twarn);
	strcat(sctring,str);
	format(str,sizeof(str),"car count:\t%d \t|\tbonus day:\t%d / 7\n",car_count,bonusday);
	strcat(sctring,str);
	if(vip)
	{
		format(str,sizeof(str),"vip time left:\t%d",vip);
		strcat(sctring,str);
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "{ff0000}offline "cMain"Статистика персонажа", sctring, "Закрыть", "");
	fLogs("[admin] %s /offcheck %s", GetName(playerid), name);
	return 1;
}

callback::TwarnLogs(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		new
		issued[MAX_PLAYER_NAME],
		fraction,
		reason[64],
		date_[64],
		fmt_str[200];

		global_string = "Ник\tОрганизация\tВыдавший\tПричина\tДата"cWH"\n\n";

		for(new idx; idx < rows; idx ++)
		{
			cache_get_field_content(idx, "issued", issued, db_prod, MAX_PLAYER_NAME);
			fraction = cache_get_field_content_int(idx, "fraction");
			cache_get_field_content(idx, "reason", reason, db_prod, MAX_PLAYER_NAME);
			cache_get_field_content(idx, "date", date_, db_prod, MAX_PLAYER_NAME);

			format(fmt_str, 200, ""cMain"%d. "cWH"%s\t%s%s\t%s\t%s\%s\n", idx + 1, GetName(playerid), Fraction_Name[fraction], fraction == 1 ? ("\t") : fraction == 15 ? ("\t") : fraction == 16 ? ("\t") : (""),issued, reason, date_);
			strcat(global_string, fmt_str);

			ShowPlayerDialog
			(
			playerid, 0, DIALOG_STYLE_MSGBOX,
			""cMain"История Ваших фракционных выговоров",
			global_string,
			"Закрыть", ""
			);
		}
	}
	else SendClientMessage(playerid, COLOR_RED, "История Ваших фракционных выговор отсутствует");
	return 1;
}

callback::ShowPlayerFamilyCars(playerid)
{
	new rows = cache_num_rows();
	if(!rows) return SendErr(playerid, "В Вашей семье нет автомобилей");

	global_string = "";

	new car_model, car_status, id, familyid = PI[playerid][pFamily];
	family_info[familyid][f_total_cars] = 0;
	for(new idx; idx < rows; idx ++)
	{
		id = family_info[familyid][f_vehid][idx] =  cache_get_field_content_int(idx, "id");
		family_info[familyid][f_cost][idx] =  cache_get_field_content_int(idx, "cost");
		car_status = cache_get_field_content_int(idx, "status");
		car_model = cache_get_field_content_int(idx, "model");
		family_info[familyid][f_total_cars] ++;

		format(global_string, 1500, "%s{F27208}» "cWH"Автомобиль №%d: %s — %s — %s\n", global_string, idx+1, VehicleNames[car_model-400], family_info[familyid][f_name], car_status ? "{41BB36}(Загружена)" : "{EF3A0C}(Не загружена)");
		SetPlayerListitemValue(playerid, idx, id);
		ShowPlayerDialog(playerid, 7727, DIALOG_STYLE_LIST, ""cMain"Выберите автомобиль из списка:", global_string, "Выбрать", "Отмена");
	}
	return 1;
}

stock GetSkladID(idx)
{
	new sklad_id = -1;

	switch(idx)
	{
	case TEAM_CSKA: sklad_id = 0;
	case TEAM_SPARTAK: sklad_id = 1;
	case TEAM_HITMAN: sklad_id = 4;
	case TEAM_ITALMAFIA: sklad_id = 5;
	case TEAM_RUSMAFIA: sklad_id = 6;
	}

	return sklad_id;
}
PubgStart()
{
	if(g_pubg_status != 2) return printf("[PUBG] ERROR START");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Мероприятие 'Battle Royale' началось");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация закрыта");

	g_pubg_winners[0] =
	g_pubg_winners[1] =
	g_pubg_winners[2] = INVALID_PLAYER_ID;

	foreach(new playerid: Player) if(playerGamePubg{playerid})
	{
		new pos = random(sizeof g_pubg_spawn_pos);
		SetPlayerPos(playerid, g_pubg_spawn_pos[pos][0], g_pubg_spawn_pos[pos][1], g_pubg_spawn_pos[pos][2]);

		SetPlayerHealth(playerid, 100.0);
		SetPlayerArmour(playerid, 0.0);
		SetPlayerArmedWeapon(playerid, 0);
		ResetPlayerWeapons(playerid);

		SetPlayerVirtualWorld(playerid, 3);
		SetPlayerInterior(playerid, 30);
		g_player_pubg_kills[playerid] = 0;

		for(new idx; idx < 17; idx ++) TextDrawShowForPlayer(playerid, pubg_td_global[idx]);
		PlayerTextDrawShow(playerid, pubg_td_player[playerid]);
	}
	format(string, sizeof(string), "%d", g_pubg_count);
	TextDrawSetString(pubg_td_global[16], string);
	CreatePubgPickup();
	return 1;
}
EndPubg()
{
	if(g_pubg_status != 2) return printf("[PUBG] ERROR END");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Мероприятие 'Battle Royale' завершилось.");

	foreach(new to_player: Player) if(playerGamePubg{to_player})
	{
		for(new idx; idx < 17; idx ++) TextDrawHideForPlayer(to_player, pubg_td_global[idx]);
		PlayerTextDrawHide(to_player, pubg_td_player[to_player]);

		g_pubg_winners[0] = to_player;
		ResetPlayerWeapons(to_player);
		SpawnPlayer(to_player);

		break;
	}
	if(g_pubg_winners[0] != INVALID_PLAYER_ID)
	{
		PI[g_pubg_winners[0]][pPerfectCoins] += event_pubg_prize[0];
		UpdatePlayerData(g_pubg_winners[0], "credits", PI[g_pubg_winners[0]][pPerfectCoins]);
		fLogs("[coin] %s +%i battle royale 1", GetName(g_pubg_winners[0]), event_pubg_prize[0]);
		SCMF(g_pubg_winners[0], 0xFFCC00AA, "За первое место в 'Battle Royale' Вам было выдано %d "SERVER_COINS"", event_pubg_prize[0]);
	}
	if(g_pubg_winners[1] != INVALID_PLAYER_ID)
	{
		PI[g_pubg_winners[1]][pPerfectCoins] += event_pubg_prize[1];
		UpdatePlayerData(g_pubg_winners[1], "credits", PI[g_pubg_winners[1]][pPerfectCoins]);
		fLogs("[coin] %s +%i battle royale 2", GetName(g_pubg_winners[1]), event_pubg_prize[1]);
		SCMF(g_pubg_winners[1], 0xFFCC00AA, "За второе место в 'Battle Royale' Вам было выдано %d "SERVER_COINS"", event_pubg_prize[1]);
	}
	if(g_pubg_winners[2] != INVALID_PLAYER_ID)
	{
		PI[g_pubg_winners[2]][pPerfectCoins] += event_pubg_prize[2];
		UpdatePlayerData(g_pubg_winners[2], "credits", PI[g_pubg_winners[2]][pPerfectCoins]);
		fLogs("[coin] %s +%i battle royale 3", GetName(g_pubg_winners[2]), event_pubg_prize[2]);
		SCMF(g_pubg_winners[2], 0xFFCC00AA, "За третье место в 'Battle Royale' Вам было выдано %d "SERVER_COINS"", event_pubg_prize[2]);
	}
	for(new idx; idx < 10; idx ++)
	{
		DestroyPickup(g_pubg_pickup_armour[idx]);
		DestroyPickup(g_pubg_pickup_hp[idx]);

		g_pubg_pickup_armour[idx] =
		g_pubg_pickup_hp[idx] = 0;

		DestroyVehicle(g_pubg_vehicle[idx]);
	}
	for(new idx; idx < sizeof g_pubg_gun_pos; idx ++)
	{
		DestroyPickup(g_pubg_gun_info[idx][PB_GUN_ID]);
		g_pubg_gun_info[idx][PB_GUN_ID] = 0;

		g_pubg_gun_info[idx][PB_GUN_WEAPON] = 0;
		g_pubg_gun_info[idx][PB_GUN_AMMO] = 0;
		g_pubg_gun_info[idx][PB_STATUS] = 2;
	}
	g_pubg_winners[2] =
	g_pubg_winners[1] =
	g_pubg_winners[0] = INVALID_PLAYER_ID;
	g_pubg_count =
	g_pubg_status = 0;
	return 1;
}
CreatePubgPickup()
{
	if(g_pubg_status != 2) return printf("[PUBG] ERROR CREATE PICKUP");

	for(new idx; idx < 10; idx ++) g_pubg_pickup_hp[idx] = CreatePickup(1240, 23, g_pubg_pickup_hp_pos[idx][0], g_pubg_pickup_hp_pos[idx][1], g_pubg_pickup_hp_pos[idx][2], 3);
	for(new idx; idx < 10; idx ++)
	{
		g_pubg_pickup_armour[idx] = CreatePickup(1242, 23, g_pubg_pickup_armour_pos[idx][0], g_pubg_pickup_armour_pos[idx][1], g_pubg_pickup_armour_pos[idx][2], 3);

		g_pubg_vehicle[idx] = CreateVehicle(586, g_pubg_vehicle_pos[idx][0], g_pubg_vehicle_pos[idx][1], g_pubg_vehicle_pos[idx][2], g_pubg_vehicle_pos[idx][3], 0, 0, 100);

		SetVehicleVirtualWorld(g_pubg_vehicle[idx], 3);
		LinkVehicleToInterior(g_pubg_vehicle[idx], 30);

		Fuel[g_pubg_vehicle[idx]] = 45;
	}

	for(new idx; idx < sizeof g_pubg_gun_pos; idx ++)
	{
		new gun_id = random(sizeof g_pubg_gun);

		g_pubg_gun_info[idx][PB_GUN_ID] = CreatePickup(g_pubg_gun[gun_id][1], 1, g_pubg_gun_pos[idx][0], g_pubg_gun_pos[idx][1], g_pubg_gun_pos[idx][2], -1);


		g_pubg_gun_info[idx][PB_GUN_WEAPON] = g_pubg_gun[gun_id][0];
		g_pubg_gun_info[idx][PB_GUN_AMMO] = g_pubg_gun[gun_id][2];
		g_pubg_gun_info[idx][PB_STATUS] = 0;
	}

	return 1;
}
SendPlayerProposition(playerid, to_player, type, value_1 = 0, value_2 = 0, reason[]="")
{
	if(proposition_info[playerid][P_OUT_ID] == INVALID_PLAYER_ID && to_player != INVALID_PLAYER_ID)
	{
		new fmt_str[144];
		switch(type)
		{
		case PROPOSITION_TYPE_HEAL:
			{
				SCMF(to_player, 0x3399FFFF, "%s предлагает Вам провести курс лечения за %d рублей", GetName(playerid), MP1[5]);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				SCMF(playerid, 0x3399FFFF, "Вы предложили %s вылечиться", GetName(to_player));
			}

		case PROPOSITION_TYPE_HANDSHAKE:
			{
				SCMF(to_player, 0x3399FFFF, "Игрок %s предлагает пожать Вам руку", GetName(playerid));

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				SCMF(playerid, 0x3399FFFF, "Вы предложили %s пожать руку", GetName(to_player));
			}

		case PROPOSITION_TYPE_HOOK:
			{
				SCMF(to_player, 0x3399FFFF, "Игрок %s предлагает пожать Вам покурить кальян за его столиком", GetName(playerid));

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				SCMF(playerid, 0x3399FFFF, "Вы предложили %s покурить кальян за его столиком", GetName(to_player));
			}
		case PROPOSITION_TYPE_TICKET:
			{
				format(fmt_str, sizeof fmt_str, "Офицер %s выписал вам штраф в размере %dр. Причина: %s", GetName(playerid), value_1, reason);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы выписали штраф %s в размере %dр. Причина: %s", GetName(to_player), value_1, reason);
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_KISS:
			{
				format(fmt_str, sizeof fmt_str, "%s предалагает Вам поцеловаться. Причина: %s", GetName(playerid));
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили %s поцеловаться", GetName(to_player));
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_JAIL:
			{
				format(fmt_str, sizeof fmt_str, "Адвокат %s оформил(а) документы по освобождению в размере %dр.", GetName(playerid), MP1[2]);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы оформили документы по освобождению %s в размере %dр.", GetName(to_player), MP1[2]);
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_FRIEND:
			{
				format(fmt_str, sizeof fmt_str, "Игрок %s предлагает начать Вам дружить", GetName(playerid));
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили %s начать дружить", GetName(to_player));
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_SIM:
			{
				format(fmt_str, sizeof fmt_str, "%s предложил Вам купить SIM-карту. Цена: %dр", GetName(playerid), value_1);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили %s купить SIM-карту. Цена: %dр", GetName(to_player), value_1);
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_SKIN:
			{
				format(fmt_str, sizeof fmt_str, "%s предложил Вам купить одежду (id скина %i). Цена: %dр", GetName(playerid), GetPlayerSkin(playerid), value_1);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили %s купить вашу одежду. Цена: %dр", GetName(to_player), value_1);
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_RACE:
			{
				format(fmt_str, sizeof fmt_str, "%s предлагает Вам гонку до %s. Победитель получает: {ffa500}%d руб", GetName(playerid), value_2 == 1 ? ("Казино г. Арзамас") : ("ТРК Останкино"), value_1);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);
				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили игроку %s гонку. Победитель получает %i руб", GetName(to_player), value_1);
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_SELL_YACHT:
			{
				format(fmt_str, sizeof fmt_str, "%s предложил Вам купить его яхту. Модель: %s, стоимость: %d руб", GetName(playerid), VehicleNames[value_2-400], value_1);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили купить свою яхту %s, ожидайте подтверждения игрока", GetName(to_player));
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_SELL_COPTER:
			{
				format(fmt_str, sizeof fmt_str, "%s предложил Вам купить его вертолет. Модель: %s, стоимость: %d руб", GetName(playerid), VehicleNames[value_2-400], value_1);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили купить свой вертолет %s, ожидайте подтверждения игрока", GetName(to_player));
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_SELL_GARAGE:
			{
				format(fmt_str, sizeof fmt_str, "Игрок "cMain" %s {1D99D4}предлагает купить Вам его гараж за "cMain"%d {1D99D4}рублей", GetName(playerid), value_1);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили "cMain"%s {1D99D4}купить ваш гараж за "cMain"%d {1D99D4}рублей", GetName(to_player), value_1);
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_CHANGE_GARAGE:
			{
				format(fmt_str, sizeof fmt_str, "Игрок "cMain" %s {1D99D4}предложил обменяться с ним гаражами с доплатой %d рублей", GetName(playerid), value_1);
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили обменяться гаражами игроку %s(%d) с доплатой %d рублей", GetName(to_player), to_player, value_1);
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		case PROPOSITION_TYPE_AREND_HOUSE:
			{
				format(fmt_str, sizeof fmt_str, "Игрок "cMain" %s {1D99D4}предлагает Вам поселиться у него дома", GetName(playerid));
				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				SendClientMessage(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y "cWH"для согласия или {FF6600}N "cWH"для отказа");

				format(fmt_str, sizeof fmt_str, "Вы предложили %s поселиться у себя дома", GetName(to_player));
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
		default: return 1;
		}
		proposition_info[playerid][P_OUT_ID] = to_player;
		proposition_info[to_player][P_ING_ID] = playerid;
		proposition_info[to_player][P_INCOMING_TYPE] = type;
		proposition_info[to_player][P_INCOMING_VALUE][0] = value_1;
		proposition_info[to_player][P_INCOMING_VALUE][1] = value_2;
	}
	else SendClientMessage(playerid, 0xFFFFFFFF, "Используйте {FF9900}/cancel "cWH"чтобы отозвать предыдущее предложение");
	return 1;
}

CMD:yes(playerid, params[])
{
	new proposition_id = proposition_info[playerid][P_ING_ID];
	new offer_type = proposition_info[playerid][P_INCOMING_TYPE];

	new value_1 = proposition_info[playerid][P_INCOMING_VALUE][0];
	new value_2 = proposition_info[playerid][P_INCOMING_VALUE][1];

	if(proposition_id != INVALID_PLAYER_ID)
	{
		if(IsPlayerConnected(proposition_id))
		{
			if(proposition_info[proposition_id][P_OUT_ID] == playerid)
			{
				proposition_info[proposition_id] = g_proposition_default_values;
			}
			else offer_type = -1;

			new Float: x, Float: y, Float: z;
			new Float: dist;

			GetPlayerPos(proposition_id, x, y, z);
			dist = GetPlayerDistanceFromPoint(playerid, x, y, z);

			if(dist <= 20.0)
			{
				switch(offer_type)
				{
				case PROPOSITION_TYPE_HEAL:
					{
						if(GetPlayerRubble(playerid) < value_1)
						{
							SendMes(proposition_id, -1, ""cER"У игрока %s недостаточно средств!", GetName(playerid));
							SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
						}
						else
						{
							if(GetPlayerLimitMoney(proposition_id, value_1))
							{
								SendErr(playerid, "У игрока максимальное количество денег.");
								SendErr(proposition_id, "У Вас максимальное количество денег.");
							}
							else
							{
								if(IsPlayerInAnyVehicle(proposition_id) && !IsPlayerInVehicle(playerid, GetPlayerVehicleID(proposition_id))) SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться вместе с Вами в машине!");
								else
								{
									SetPlayerMoney(playerid, -value_1);
									SetPlayerMoney(proposition_id, value_1);

									SetPlayerHealth(playerid, 100);

									if(GetPlayerDrunkLevel(playerid) > 0) SetPlayerDrunkLevel(playerid, 0);
									SCMF(playerid, COLOR_GREEN, "%s %s вылечил Вас за %dр", frakRangName[PI[proposition_id][pMember]][PI[proposition_id][pRank]], GetName(proposition_id), value_1);
									SCMF(proposition_id, COLOR_GREEN, "Вы вылечили %s за %dр", GetName(playerid), value_1);
								}
							}
						}
					}
				case PROPOSITION_TYPE_HOOK:
					{
