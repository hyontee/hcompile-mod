				if(CheckMaxVes(playerid,65,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=65;
				PlayerItem2[playerid][newslot]+=1;
