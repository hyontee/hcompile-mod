SearchInventoryItem(playerid, item)
{
	for(new s=1; s<MAX_SLOT; s++)
	{
		if(PlayerItem1[playerid][s] == item) return s;
	}
	return 0;
}
public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
	if(checkpointid == gunsklad[4])
	{
		if(PI[playerid][pMember] == TEAM_HITMAN)
		{
			if(b_Sklad{4}) return SendClientMessage(playerid, -1, ""cER"Доступ к складу вашей банды закрыт!");
			ShowPlayerDialog(playerid, 4000, 2, ""cMain"Склад банды", "{63BD4E}Положить патроны\n{63BD4E}Положить деньги\n{63BD4E}Положить наркотики\n"cWH"Взять патроны\nВзять деньги\nВзять наркотики", "Принять", "Отмена");
		}
		return 1;
	}
	if(checkpointid == sitsklad[0])
	{
		if(PI[playerid][pMember] == TEAM_SMI && PI[playerid][pLeader])
		{
			format(stringer1, 128, "Ввод средств в банк организации\nВывод средств из банка организации\nВ банке организации: %dр", FracBank[8]);
			ShowPlayerDialog(playerid, 131+131, 2, ""cMain"Банк", stringer1, "Принять", "Отмена");
		}
		return 1;
	}
	if(checkpointid == sitsklad[1])
	{
		if(PI[playerid][pMember] == TEAM_OBLASTADMIN && PI[playerid][pLeader])
		{
			format(stringer1, 128, "Ввод средств в банк организации\nВывод средств из банка организации\nВ банке организации: %dр", FracBank[9]);
			ShowPlayerDialog(playerid, 131+131, 2, ""cMain"Банк", stringer1, "Принять", "Отмена");
		}
		return 1;
	}
	if(checkpointid == armyammo)
	{
		if(PI[playerid][pMember] == TEAM_ARMY || IsAGang(playerid) || IsAMafia(playerid) && PI[playerid][pMember] != TEAM_HITMAN) PI[playerid][pInTakeMats] = 1;
		else SendClientMessage(playerid, -1, ""cER"Вы не можете пользоваться этим складом!");
	}
	return 1;
}

public OnPlayerLeaveDynamicCP(playerid, checkpointid)
{
	if(checkpointid == armyammo)
	{
		if(PI[playerid][pMember] == TEAM_ARMY || IsAGang(playerid) || IsAMafia(playerid) && PI[playerid][pMember] != TEAM_HITMAN) PI[playerid][pInTakeMats] = 0;
	}
	return 1;
}
public OnPlayerLeaveCheckpoint(playerid)
{
	return 0x1;
}

public OnPlayerEnterCheckpoint(playerid)
{
	if(CP_PlayerType[playerid] == 1) // CP_PlayerTemp
	{
		if(!GetPVarInt(playerid, "drugs_work")) return 1;
		DisablePlayerCheckpoint(playerid);
		ClearAnimations(playerid);
		TogglePlayerControllable(playerid, 0);
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 0, 0);
		SetTimerEx("TimerTakeDrugs", 5000, false, "i", playerid);
		return 1;
	}
	if(UseGPS[playerid] == true && GetPVarInt(playerid, "drugs_work")) return DisablePlayerCheckpoint(playerid);
	if(IsPlayerInRangeOfPoint(playerid, 1.0, -1060.9146,2208.5632,38.0988))
	{
		if(mats_status[playerid]) return SendClientMessage(playerid, COLOR_RED, "Вы уже взяли ящик. Отнесите его в автомобиль");

		//SetPlayerAttachedObject(playerid,5,1221,1,0.135011,0.463495,-0.024351,357.460632, 87.350753,88.068374,0.434164,0.491270,0.368655);
		SendClientMessage(playerid, COLOR_GREEN, "Вы взяли ящик с патронами. Отнесите и загрузите его в машину");
		ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,0,1,1,1,1);

		materials -= 500;
		format(stringer1, 128, "UPDATE `other` SET materials = '%d'", materials);
		mysql_tquery(db_prod, stringer1, "", "");

		mats_status[playerid] = 1;
	}
	return 1;
}

CMD:nosaveobj(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;

	switch(NoSaveMapping)
	{
		case 0:
		{
			NoSaveMapping = 1;
			SendInf(playerid, "Маппинг теперь не сохраняется");
		}
		case 1:
		{
			NoSaveMapping = 0;
			SendInf(playerid, "Маппинг теперь сохраняется");
		}
	}
	return 1;
}

CMD:exitdm(playerid, params[])
{
	if(!playerPVPGun[playerid][0] && !playerIvent{playerid}) return SendErr(playerid, "Вам недоступна данная функция");
	dmCountMap[playerPVPGun[playerid][0] ? 0 : 1]--;
	SQF1("UPDATE accounts SET dmkills=%i WHERE id=%i", playerKillPVP[playerid], PI[playerid][pID]);

	playerIvent{playerid} =
	playerDeathPVP[playerid] =
	playerKillPVP[playerid] =
	playerPVPGun[playerid][0] =
	playerPVPGun[playerid][1] = 0;

	SetPlayerPos(playerid, 2089.0557,-2283.7131,23.1052);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerInterior(playerid, 0);
	ResetPlayerWeapons(playerid);

	nfor(i, 2) PlayerTextDrawHide(playerid, playerComputerTD[playerid][i]);
	nfor(i, 8) TextDrawHideForPlayer(playerid, computerGlobalTD[i]);
	nfor(i, 5) SendDeathMessageToPlayer(playerid, 1001, 1001, 200);
	return 1;
}
CMD:music(playerid, params[])
{
	if(!playerMusicCar{playerid}) return SendErr(playerid, "Данная услуга не куплена");
	if(!GetPlayerVehicleID(playerid)) return SendErr(playerid, "Нужно находится в ТС");
	ShowPlayerDialog(playerid, 9946, DSL, ""cMain"Меню Music",""cWH"1. Record FM\n2. Russian Mix\n3. Record Dubstep\n4. Yo! FM\n5. Teodor Hardstyle\n6. Своя песня\n7. Выключить", "Выбрать", "Назад");
	return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		DisablePlayerRaceCheckpoint(playerid);
	}
	if(PlayerBase[playerid] == 1)
	{
		DisablePlayerRaceCheckpoint(playerid);
		PlayerBase[playerid] = 0;

		new i = g_rob[R_BIZ_ID], percent =  BizzInfo[i][bMoney] * 90 / 100,
		money =  BizzInfo[i][bMoney] - percent;

		SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно доставили мешок с деньгами на склад");
		SCMF(playerid, 0xFFCC00AA, "Мешок содержал: %d рублей, они были пополнены на склад", money);
		RemovePlayerAttachedObject(playerid,4);
		FracBank[7] += money;

		BizzInfo[i][bMoney] -= money;
		MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);

		g_rob[R_STATUS] = false;
		g_rob[R_TIME] = 0;
		g_rob[R_ICON] = 0;
		g_rob[R_BIZ_ID] = 0;
		g_rob[R_PLAYERID] = INVALID_PLAYER_ID;
		g_rob[R_PRESSED] = 0;
	}
	if(CarTheft[playerid] == 1)
	{
		DisablePlayerRaceCheckpoint(playerid);
		CarTheft[playerid] = 0;
	}
	if(CarTheft[playerid] == 2)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(vehicleid != PI[playerid][pCarTheft] || VehicleOwner[vehicleid] == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_RED, "Вы доставили не тот автомобиль");

		new percent = C_DATA[VehicleOwner[vehicleid]][c_price] * 80 / 100,
		money =  C_DATA[VehicleOwner[vehicleid]][c_price] - percent;

		SCMF(playerid, 0xFFCC00AA, "Вы успешно украли автомобиль %s. Заработано: %d рублей", VehicleNames[GetVehicleModel(vehicleid)-400], money);
		SetPlayerMoney(playerid, money);
		SetVehicleToRespawn( PI[playerid][pCarTheft] );

		PI[playerid][pCarTheft] = INVALID_VEHICLE_ID;
		DisablePlayerRaceCheckpoint(playerid);
		CarTheft[playerid] = 0;
	}
	if(UseGPS[playerid])
	{
		SendClientMessage(playerid, -1, ""cDA"Вы достигли места назначения");
		DisablePlayerRaceCheckpoint(playerid);
		UseGPS[playerid] = false;

		if(PI[playerid][pSettingTD][1] == 1)
		{
			for(new i; i < 10; i++) TextDrawHideForPlayer(playerid, gps_td_global[i]);
			for(new i; i < 3; i++) PlayerTextDrawHide(playerid, gps_td_player[i][playerid]);
		}
		return 1;
	}
	if(playerFind[playerid])
	{
		playerFind[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
		return 1;
	}
	if(Home[playerid] == 1)
	{
		SendClientMessage(playerid, -1, ""cDA"Вы достигли места назначения");
		Home[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
	}
	if(Pod[playerid] == 1)
	{
		SendClientMessage(playerid, -1, ""cDA"Вы достигли места назначения");
		Pod[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
	}
	if(BIZZ[playerid] == 1)
	{
		SendClientMessage(playerid, -1, ""cDA"Вы достигли места назначения");
		BIZZ[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
	}
	return 1;
}

public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
	return 1;
}

public OnPlayerPickUpPickup(playerid, pickupid)
{
	if(GetTickCount() - TickPickup[playerid] < 1000) return 1;
	TickPickup[playerid] = GetTickCount();

	if(pickupid == g_fk_pickup[0])
	{
		SetPlayerPos(playerid, 299.5505,1155.5618,901.0031);
		SetPlayerFacingAngle(playerid, 360.0);
		SetPlayerVirtualWorld(playerid, 1);
		SetPlayerInterior(playerid, 4);
	}
	if(pickupid == g_fk_pickup[1])
	{
		SetPlayerPos(playerid, 211.5166,1379.6085,11.9254);
		SetPlayerFacingAngle(playerid, 180.0);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);
	}
	if(pickupid == g_fk_pickup[2])
	{
		SetPlayerPos(playerid, -334.8711,148.4671,1301.0000);
		SetPlayerFacingAngle(playerid, 180.0);
		SetPlayerVirtualWorld(playerid, 2);
		SetPlayerInterior(playerid, 27);
	}
	if(pickupid == g_fk_pickup[3])
	{
		SetPlayerPos(playerid, -885.4584,1192.0015,10.5120);
		SetPlayerFacingAngle(playerid, 276.0);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);
	}
	if(pickupid == recordPickup) if(IsACopAndFSB(playerid))
	{
		ShowPlayerDialog(playerid, 8526, DSL, ""cMain"Видеонаблюдение", ""cWH"1. Банк\n2. Клуб 8-бит\n3. Биржа обмена\n4. Мост Южный\n5. Депо контейнеров", "Далее", "Выйти");
	}
	if(pickupid == clubPickup)
	{
		nformat(global_string, ""cWH"1. ДМ арена [%i игроков]\n2. Гонка вооружений [%i игроков]\n3. Топ геймеров", dmCountMap[0], dmCountMap[1]);
		ShowPlayerDialog(playerid, 6526, DSL, ""cMain"Компьютерный клуб", global_string, "Далее", "Выйти");
	}
	if(pickupid == g_autosalon_pickup[0])
	{
		SetPlayerPos(playerid, -18.2327,-5.0809,1201.0000);
		SetPlayerFacingAngle(playerid, 90.0);
		SetPlayerInterior(playerid, 21);

		g_player_salon[playerid] = 1;
		SetPlayerVirtualWorld(playerid, g_player_salon[playerid]);
	}

	if(pickupid == g_autosalon_pickup[1])
	{
		SetPlayerPos(playerid, 2498.3733,-729.0608,12.1132);
		SetPlayerFacingAngle(playerid, 180.00);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);
		g_player_salon[playerid] = 0;
	}
	if(pickupid == g_autosalon_pickup[2])
	{
		SetPlayerPos(playerid, 448.7762,378.2893,12.0305);
		SetPlayerFacingAngle(playerid, 253.9777);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);
		g_player_salon[playerid] = 0;
	}
	if(pickupid == g_autosalon_pickup[3])
	{
		SetPlayerPos(playerid, -18.2327,-5.0809,1201.0000);
		SetPlayerFacingAngle(playerid, 90.0);
		SetPlayerInterior(playerid, 21);

		g_player_salon[playerid] = 2;
		SetPlayerVirtualWorld(playerid, g_player_salon[playerid]);
	}

	for(new idx; idx < 10; idx++)
	{
		if(pickupid == g_pubg_pickup_hp[idx] && g_pubg_status == 2)
		{
			new Float: health;
			GetPlayerHealth(playerid, health);
			if(health > 80) SendClientMessage(playerid, COLOR_RED, "У Вас много хп");
			else
			{
				GiveHealth(playerid, 20);
				DestroyPickup(g_pubg_pickup_hp[idx]);
				g_pubg_pickup_hp[idx] = 0;
			}
		}

		if(pickupid == g_pubg_pickup_armour[idx] && g_pubg_status == 2)
		{
			new Float: armour;
			GetPlayerArmour(playerid, armour);
			if(armour > 80) SendClientMessage(playerid, COLOR_RED, "У Вас много брони");
			else
			{
				SetPlayerArmour(playerid, armour + 20);
				DestroyPickup(g_pubg_pickup_armour[idx]);
				g_pubg_pickup_armour[idx] = 0;
			}
		}
	}

	if(pickupid == g_rob_pickup)
	{
		if(IsACopAndFSB(playerid))
		{
			SendClientMessage(playerid, 0xFFCC00AA, "Вы подобрали мешок с деньгами. Ваш была выписана премия в размере 100.000 рублей");
			SetPlayerMoney(playerid, 100000);
			PlayerBase[playerid] = 0;
			DestroyPickup(g_rob_pickup);
			g_rob_pickup = 0;
		}
	}
	if(pickupid == fights_pic[1])
	{
		if(!fights_status) return SendClientMessage(playerid, COLOR_RED, "Начало боя не объявлено, регистрация на бой невозможна");
		ShowPlayerDialog(playerid, 18239, DIALOG_STYLE_LIST, ""cMain"Бойцовский клуб", "1. Участвовать в бою\n2. Покинуть бой\n3. Сделать ставки на событие", "Далее", "Отмена");
	}

	if(pickupid == fights_pic[0])
	{
		if(!fights_status) return SendClientMessage(playerid, COLOR_RED, "Начало боя не объявлено, бар закрыт");

		ShowPlayerDialog(playerid, 18239+2, DIALOG_STYLE_LIST, ""cMain"Бар", "- Пиво Жигулевское\n- Коньяк 1000 мгновений\n- Паленая водка\n- Вино Краснодарское\n- Абсент София", "Далее", "Отмена");

	}

	if(pickupid == rieltor) ShowPlayerDialog(playerid, 18225, DIALOG_STYLE_LIST, ""cMain"Риелторское агентство", "- Приобрести собственный дом\n- Приобрести собственный бизнес", "Выбрать", "Выход");

	if(pickupid == buy_helicopter) return ShowPlayerDialog(playerid, 7336, DIALOG_STYLE_MSGBOX, "{DEDB18}Покупка вертолета", ""cWH"Перейти к покупке вертолета?", "Далее", "Отмена");

	if(pickupid == paint_pic)
	{
		if(PBP_STATUS != 1) return SendClientMessage(playerid,COLOR_GREY,"Регистрация на мероприятие 'Мясорубка' закрыта");
		if(PI[playerid][pAdmin] && !g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_RED, "Администраторам запрещено участвовать в мероприятиях");

		format(global_string, 1300, ""cWH"Для регистрации на мероприятие 'Мясорубка' Вам необходимо иметь 30.000р наличным\n\n\
		Информация о текущем матче:\nЗарегистрировано %d/100\nБанк игры: %d рублей\n\n\
		Правила игры:\nКаждый играет сам за себя и по окончанию времени выбирается лучший из лучших\n\
		Игрок, выигравший данную битву - получает 15 Perfect Coins и весь банк игры\n\n\
		{FF0000}Вы хотите участвовать в мясорубке?", PB_COUNTPLAYERS(),PBP_BANK);
		ShowPlayerDialog(playerid,6363,DIALOG_STYLE_MSGBOX,"{FCE011}Регистрация",global_string,"Да","Нет");
		return 1;
	}
	if(pickupid >= pickuptook[0] && pickupid <= pickuptook[13])
	{
		if(arenda_took[playerid] && check_arenda_moped[playerid])
		{
			new veh = arenda_took[playerid];
			if(veh != INVALID_VEHICLE_ID) DestroyVehicle(veh);
			arenda_took[playerid] = 0;
			SendClientMessage(playerid,COLOR_GREY,"Ваш арендованый мопед был удален!");
			check_arenda_moped[playerid] = 0;
		}
		if(!check_arenda_moped[playerid]) return ShowPlayerDialog(playerid,136,DIALOG_STYLE_MSGBOX,"{CE0F28}Аренда мопедов",""cWH"Аренда мопедов.\n\nИнформация:\n- Если арендованый транспорт не будет использоваться 5-ть минут.\n- Он будет удален автоматически!","Арендовать","Отмена");
		return 1;
	}

