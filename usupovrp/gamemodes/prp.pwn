CMD:kaif_ac_playerstats(playerid, params[])
{
	if(!g_player_full_access[playerid])
		return SendClientMessage(playerid, -1, "{f49090}Команда не обнаружена! Используйте {ffffff}/menu > Список команд {f49090}для просмотра команд");

	new id = INVALID_PLAYER_ID;

	sscanf(params, "u", id);

	if(id != INVALID_PLAYER_ID)
	{
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "player: %s[%i] | ping: %i | loss: %f", GetName(id), id, GetPlayerPing(id), NetStats_PacketLossPercent(id));
		SendClientMessage(playerid, -1, STRING_GLOBAL);
	}

	return 1;
}

CMD:st_set(playerid, params[])
{
	if(!g_player_full_access[playerid])
		return SendClientMessage(playerid, -1, "{f49090}Команда не обнаружена! Используйте {ffffff}/menu > Список команд {f49090}для просмотра команд");

	if(!strlen(params))
	{
		SendClientMessage(playerid, 0xf6e58dAA, "Используйте: {ffffff}Введите: /st_set [set_type (1-6)]");

		SendClientMessage(playerid, 0xCECECEFF, "1. Streamer_SetTickRate(rate)");
		SendClientMessage(playerid, 0xCECECEFF, "2. Streamer_SetMaxItems(type, items)");
		SendClientMessage(playerid, 0xCECECEFF, "3. Streamer_SetVisibleItems(type, items, playerid = -1)");
		SendClientMessage(playerid, 0xCECECEFF, "4. Streamer_SetRadiusMultiplier(type, Float:multiplier, playerid = -1)");
		SendClientMessage(playerid, 0xCECECEFF, "5. Streamer_SetCellDistance(Float:distance)");
		SendClientMessage(playerid, 0xCECECEFF, "6. Streamer_SetCellSize(Float:size)");
		SendClientMessage(playerid, 0xCECECEFF, "7. Streamer_ProcessActiveItems()");

		return 1;
	}

	extract params -> new set_type;

	new type, value, to_player, Float: f_value;
	new fmt_msg[90];

	switch(set_type)
	{
		case 1:
		{
			if(sscanf(params, "{d}d", value)) return SendClientMessage(playerid, 0xf6e58dAA, "Используйте: {ffffff}Введите: /st_set [1] [rate]");
			Streamer_SetTickRate(value);

			format(fmt_msg, sizeof fmt_msg, "Streamer_SetTickRate(%d);", value);
			SendClientMessage(playerid, 0xCECECEFF, fmt_msg);
		}
		case 2:
		{
			if(sscanf(params, "{d}dd", type, value)) return SendClientMessage(playerid, 0xf6e58dAA, "Используйте: {ffffff}Введите: /st_set [2] [type] [items]");
			Streamer_SetMaxItems(type, value);

			format(fmt_msg, sizeof fmt_msg, "Streamer_SetMaxItems(%d, %d);", type, value);
			SendClientMessage(playerid, 0xCECECEFF, fmt_msg);
		}
		case 3:
		{
			if(sscanf(params, "{d}ddd", type, value, to_player)) return SendClientMessage(playerid, 0xf6e58dAA, "Используйте: {ffffff}Введите: /st_set [3] [type] [items] [playerid]");
			if(!(0 <= to_player <= MAX_PLAYERS))
				to_player = -1;

			Streamer_SetVisibleItems(type, value, to_player);

			format(fmt_msg, sizeof fmt_msg, "Streamer_SetVisibleItems(%d, %d, %d);", type, value, to_player);
			SendClientMessage(playerid, 0xCECECEFF, fmt_msg);
		}
		case 4:
		{
			if(sscanf(params, "{d}dfd", type, f_value, to_player)) return SendClientMessage(playerid, 0xf6e58dAA, "Используйте: {ffffff}Введите: /st_set [4] [type] [(Float) multiplier] [playerid]");
			if(!(0 <= to_player <= MAX_PLAYERS))
				to_player = -1;

			Streamer_SetRadiusMultiplier(type, f_value, to_player);

			format(fmt_msg, sizeof fmt_msg, "Streamer_SetRadiusMultiplier(%d, %f, %d);", type, f_value, to_player);
			SendClientMessage(playerid, 0xCECECEFF, fmt_msg);
		}
		case 5:
		{
			if(sscanf(params, "{d}f", f_value)) return SendClientMessage(playerid, 0xf6e58dAA, "Используйте: {ffffff}Введите: /st_set [5] [(Float) distance]");

			Streamer_SetCellDistance(f_value);

			format(fmt_msg, sizeof fmt_msg, "Streamer_SetCellDistance(%f);", f_value);
			SendClientMessage(playerid, 0xCECECEFF, fmt_msg);
		}
		case 6:
		{
			if(sscanf(params, "{d}f", f_value)) return SendClientMessage(playerid, 0xf6e58dAA, "Используйте: {ffffff}Введите: /st_set [6] [(Float) size]");

			Streamer_SetCellSize(f_value);

			format(fmt_msg, sizeof fmt_msg, "Streamer_SetCellSize(%f);", f_value);
			SendClientMessage(playerid, 0xCECECEFF, fmt_msg);
		}
		case 7:
		{
			Streamer_ProcessActiveItems();
			SendClientMessage(playerid, 0xCECECEFF, "Streamer_ProcessActiveItems();");
		}
		default: return SendClientMessage(playerid, 0xFF6600FF, "INVALID_SET_TYPE_ID");
	}

	return 1;
}

CMD:on_turn(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	EnableVehicleTurnLight(playerid, vehicleid, 3);
}

CMD:off_turn(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	EnableVehicleTurnLight(playerid, vehicleid, 0);
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
	for(new i = 0; i != sizeof g_vehicle_tuning; i ++)
	{
		switch(i)
		{
			case VT_NEON_COLOR_R..VT_NEON_ALPHA:
			{
				EnableVehicleNeon
				(
					forplayerid,
					vehicleid,
					GetVehicleTuning(vehicleid, VT_NEON_COLOR_R),
					GetVehicleTuning(vehicleid, VT_NEON_COLOR_G),
					GetVehicleTuning(vehicleid, VT_NEON_COLOR_B),
					100
				);
			}

			case VT_LIGHTS_COLOR_R..VT_LIGHTS_COLOR_B:
			{
				EnableVehicleLights
				(
					forplayerid,
					vehicleid,
					GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_R),
					GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_G),
					GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_B)
				);
			}

			case VT_MAIN_COLOR_R..VT_MAIN_COLOR_B:
			{
				EnableVehicleColor
				(
					forplayerid,
					vehicleid,
					GetVehicleTuning(vehicleid, VT_MAIN_COLOR_R),
					GetVehicleTuning(vehicleid, VT_MAIN_COLOR_G),
					GetVehicleTuning(vehicleid, VT_MAIN_COLOR_B)
				);
			}

			case VT_TINING_TRANSPARENT:
			{
				EnableVehicleTining
				(
					forplayerid,
					vehicleid,
					0,
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
					GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
				);

				EnableVehicleTining
				(
					forplayerid,
					vehicleid,
					1,
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
					GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
				);

				EnableVehicleTining
				(
					forplayerid,
					vehicleid,
					2,
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
					GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
				);

				EnableVehicleTining
				(
					forplayerid,
					vehicleid,
					3,
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
					GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
					GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
				);
			}

			case VT_WHEELS_COLOR_R..VT_WHEELS_COLOR_A:
			{
				/*EnableCarWheelsColor
				(
					forplayerid,
					vehicleid,
					GetVehicleTuning(vehicleid, VT_WHEELS_COLOR_R),
					GetVehicleTuning(vehicleid, VT_WHEELS_COLOR_G),
					GetVehicleTuning(vehicleid, VT_WHEELS_COLOR_B),
					GetVehicleTuning(vehicleid, VT_WHEELS_COLOR_A)
				);*/
			}

			case VT_TURN_LIGHTS_RIGHT:
			{
				EnableVehicleTurnLight
				(
					forplayerid,
					vehicleid,
					GetVehicleTuning(vehicleid, VT_TURN_LIGHTS_RIGHT)
				);
			}

			case VT_TURN_LIGHTS_LEFT:
			{
				EnableVehicleTurnLight
				(
					forplayerid,
					vehicleid,
					GetVehicleTuning(vehicleid, VT_TURN_LIGHTS_LEFT)
				);
			}

			case VT_TURN_LIGHTS_TWOSIDE:
			{
				EnableVehicleTurnLight
				(
					forplayerid,
					vehicleid,
					GetVehicleTuning(vehicleid, VT_TURN_LIGHTS_TWOSIDE)
				);
			}
		}
	}

    return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
    new BitStream: bs = BS_New();

	BS_WriteValue
	(
	    bs,
	    PR_UINT16, vehicleid
	);

	PR_SendRPC(bs, forplayerid, RPC_RemoveSync);
	BS_Delete(bs);

	return 1;
}

CMD:generate_numbers_sql(playerid)
{
	if(!g_player_full_access[playerid]) return 1;

	for(new i = 0; i != 10000000; i ++)
	{
		new letters[11][2] = {"A", "B", "C", "T", "X", "E", "K", "M", "H", "P", "O"};

		new letter_1 = random(sizeof letters);
		new letter_first[3];

		format(letter_first, sizeof letter_first, "%s", letters[letter_1]);

		new number_1 = random(9);
		new number_2 = random(9);
		new number_3 = random(9);

		new letter_2 = random(sizeof letters);
		new letter_second[3];

		format(letter_second, sizeof letter_second, "%s", letters[letter_2]);

		new letter_3 = random(sizeof letters);
		new letter_third[3];

		format(letter_third, sizeof letter_third, "%s", letters[letter_3]);

		STRING_GLOBAL[0] = EOS;

		format(STRING_GLOBAL, sizeof STRING_GLOBAL, "INSERT INTO `ownable_numbers` (`number`) VALUES ('%s%d%d%d%s%s')", letter_first, number_1, number_2, number_3, letter_second, letter_third);
		mysql_tquery(db_prod, STRING_GLOBAL);
	}

	return 1;
}

