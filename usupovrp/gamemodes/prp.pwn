		{
			ofm_list_page[playerid] = 1;
			format(stringer1, sizeof stringer1, "SELECT `name`,`rank`,`datavhod` FROM `accounts` WHERE `member` = '%d' AND `online` = '1001'", PI[playerid][pMember]) ;
			mysql_tquery ( db_prod, stringer1, "callback_offmembers", "i", playerid ) ;
		}
	case 2:
		{
			format(stringer1, 128, "SELECT `name`, `mainsub`, `id` FROM `accounts` WHERE `member` = '%d' AND `rank` = '9'", PI[playerid][pMember]) ;
			mysql_tquery(db_prod, stringer1, "SelectFractionSub", "d", playerid);
		}
	case 3: ShowPlayerDialog(playerid, 7500, DIALOG_STYLE_INPUT, ""cMain"Уволить игрока", ""cWH"Введите ник игрока, которого Вы хотите уволить:", "Далее", "Отмена");
	case 4: ShowFractionCarDialog(playerid);
	case 5:
		{
			new vehid;
			for(new i = 1; i <= TOTALVEH; i++)
			{
				if(VehInfo[i][vFraction] == PI[playerid][pMember])
				{
					vehid = VehInfo[i][vVehicle];
					if(!IsVehicleOccupiedAC(vehid)) SetVehicleToRespawn(vehid);
				}
			}
			SendClientMessage(playerid, -1, ""cPS"Транспорт зареспавнен");
		}
	case 6: ShowFrakRangName(playerid, PI[playerid][pMember]);
	case 7: ShowFrakVehicle(playerid, PI[playerid][pMember]);
	case 8:
		{
			new idx = GetSkladID(PI[playerid][pMember]);
			if(idx == -1) return 1;

			format(stringer, 300,""cMain"1. "cWH"Статус: %s\n"cMain"2. "cWH"Доступ с: "cMain"%d "cWH"ранга", !b_Sklad{idx} ? "{66cc00}открыт" : "{ff614a}закрыт",UseStockRang[idx]);
			ShowPlayerDialog(playerid, 1266, DIALOG_STYLE_LIST,""cMain"Склад",stringer,"Изменить", "Назад");
		}
	}
	return 1;
}

DLG(18248, playerid, response, listitem, inputtext[])
