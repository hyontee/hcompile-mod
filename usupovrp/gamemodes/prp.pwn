	case 1:
		{
			new id = GetPlayerID(ac_name);
			if(id != INVALID_PLAYER_ID)
			{
				SendMes(id, COLOR_RED, "Администратор %s отобрал у Вас FullDostup", GetName(playerid));
				g_player_full_access[id] = false;
			}

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `fullaccess` WHERE `name` = '%e'", ac_name);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			SendMes(playerid, COLOR_RED, "FullDostup снят с администратора %s", ac_name);
		}
	}
	return 1;
}
DLG(19009, playerid, response, listitem, inputtext[])
{
