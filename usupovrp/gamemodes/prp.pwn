DLG(2510, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	switch(listitem)
	{
	case 0:
	{
		if(showed_DCB[playerid] == true || RouletteMenuSelectable[playerid] != -1) return 1;
		Show_DonateCarBuy(playerid);
	}
	case 1:
		{
			if(PI[playerid][pPerfectCoins] < 75) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");

			PI[playerid][pCountCars] ++;
			PI[playerid][pPerfectCoins] -= 75;
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET credits=%d, countcars=%d WHERE id=%d", PI[playerid][pPerfectCoins], PI[playerid][pCountCars], PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");

			fLogs("[coin] %s -75 доп.слоты для тачки", GetName(playerid));
			SendMes(playerid, COLOR_GREEN, "Вы приобрели доп. слот для автомобиля. Теперь Вы можете иметь: %d автомобилей", PI[playerid][pCountCars]);
		}
	case 2:
		{
			if(PI[playerid][pPerfectCoins] < 200) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");

			if(GetActivePlayerVehicleCount(playerid) == 0)
				return SendClientMessage(playerid, COLOR_RED, "Сначала необходимо загрузить транспорт в игру: /car");

			if(!GetPlayerVehicle(playerid))
				return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своем автомобиле");

			ShowPlayerDialog(playerid, 200+11, DIALOG_STYLE_LIST, ""cMain"Выберите первую букву номера:","А\nB\nC\nT\nX\nE\nK\nM\nH\nP\nO", "Далее", "Отмена");
		}
	case 3:
		{
			if(PI[playerid][pPerfectCoins] < 500) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");
			if(GetActivePlayerVehicleCount(playerid) == 0)
				return SendClientMessage(playerid, COLOR_RED, "Сначала необходимо загрузить транспорт в игру: /car");

			if(!GetPlayerVehicle(playerid))
				return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своем автомобиле");
			ShowPlayerDialog(playerid, 8862, DIALOG_STYLE_LIST, ""cMain"Выберите цвет номера:","\
			{F71212}Красный\n\
			{F76A12}Оранжевый\n\
			{F7E812}Желтый\n\
			{17B40E}Зеленый\n\
			{30B7F0}Голубой\n\
			{1664D3}Синий\n\
			{9416D3}Фиолетовый\n\
			{FA43E5}Розовый", "Далее", "Отмена");
		}
	}
	return 0x1;
}

DLG(2503, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][pWarn] == 0) return SendClientMessage(playerid, -1, ""cER"Вы не имеете предупреждений!");
			if(PI[playerid][pPerfectCoins] < 35) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");
			PI[playerid][pPerfectCoins] -= 35;
			PI[playerid][pWarn]--;
			fLogs("[coin] %s -35 варн", GetName(playerid));
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET warn=warn-1, credits=credits-35 WHERE id=%d", PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
			SendClientMessage(playerid, -1, ""cDA"Вы успешно сняли "cWH"одно {ffff00}предупреждение!");
		}
	case 1:
		{
			if(PI[playerid][pPerfectCoins] < 60) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");
			ShowPlayerDialog(playerid, 310, 1, ""cMain"Смена ника", ""cWH"Введите будущий ник:", "Принять", "Назад");
		}
	case 2:
		{
			if(PI[playerid][pPerfectCoins] < 200) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");
			PI[playerid][pPerfectCoins] -= 200;
			playerMusicCar{playerid} = 1;
			fLogs("[coin] %s -200 /music", GetName(playerid));
			format(stringer1, sizeof(stringer1), "UPDATE accounts SET credits=credits-200, musiccar=1 WHERE id=%d", PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1);
			SendInf(playerid, "Вы успешно сняли купили музыку в машину. /music");

		}
	}
	return 0x1;
}
DLG(7433, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new count = strval(inputtext);
	if(null(inputtext) || !isNumeric(inputtext))
	{
		ShowPlayerDialog(playerid, 7433, DIALOG_STYLE_INPUT,
		""cMain"Конвертер",
		""cWH"Введи количество рублей которое хотите конвертировать в EURO\n\
		"cWH"Курс 1р - 15 euro", "Далее", "Отмена");
		return 1;
	}
	if(!(1 <= count <= 5000))
	{
		ShowPlayerDialog(playerid, 7433, DIALOG_STYLE_INPUT,
		""cMain"Конвертер",
		""cWH"Введи количество рублей которое хотите конвертировать в EURO\n\
		"cWH"Курс 1р - 15 euro", "Далее", "Отмена");
		return SendErr(playerid, "Не менее 1, и не более 5000");
	}
	if(PI[playerid][pPerfectCoins] < count)
	{
		ShowPlayerDialog(playerid, 7433, DIALOG_STYLE_INPUT,
		""cMain"Конвертер",
		""cWH"Введи количество рублей которое хотите конвертировать в EURO\n\
		"cWH"Курс 1р - 15 euro", "Далее", "Отмена");
		return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");
	}
	TransferEuro(-1, playerid, count*15, "конвертер");
	PI[playerid][pPerfectCoins] -= count;
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET credits = credits-%i WHERE id = %d", count, PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1);
	fLogs("[coin] %s -%i конвертер euro", GetName(playerid), count);
	SendFormatInf(playerid, "Вы успешно конвертировали "cMain"%i"SERVER_COINS""cWH" в "cMain"%i euro", count, count*15);


	if(donate_bonus)
	{
		new donate_money = 0;
		new donate_convert = strval(inputtext) * 15;

		switch(donate_convert)
		{
		case 0..99: donate_money = 0;
		case 100..499: donate_money = 2;
		case 500..999: donate_money = 5;
		case 1000..5000: donate_money = 10;
		default: donate_money = 15;
		}

		new total_money = ((donate_convert / 100) * donate_money);
		if(donate_money > 0)
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Ваш бонус за конвертацию игровой валюты составил %d euro", total_money);
			SendClientMessage(playerid, 0xFFFF00FF, STRING_GLOBAL);

			TransferEuro(-1, playerid, total_money, "Бонус конверта");
		}
	}
	return 1;
}

DLG(8234, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(PI[playerid][pPerfectCoins] < 150) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");
		new skin_id = donate_skin[playerid];
		PI[playerid][pModel] = skin_id;
		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET model=%d, credits=credits-150 WHERE id=%d", PI[playerid][pModel], PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1, "", "");
		PI[playerid][pPerfectCoins] -= 150;
		fLogs("[coin] %s -150 скин %i", GetName(playerid), skin_id);
		fLogs("[skin] %s донат [%i]", GetName(playerid), skin_id);
		SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно приобрели этот скин за 150 "SERVER_COINS"");
	}
	else
	{
		donate_skin[playerid] = 0;
		if(PI[playerid][pMember]) SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
		else SetPlayerSkin(playerid, PI[playerid][pModel]);
	}
	return 1;
}
DLG(8862, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	ColorNumber[playerid][0] = EOS;
	strcat(ColorNumber[playerid], gColorNumber[listitem]);
	ShowPlayerDialog(playerid, 4562, DIALOG_STYLE_INPUT, ""cMain"Введите название номера", ""cWH"Введите название вашего будущего номера. Пример: КРАСАВЧИК 228", "Ввести", "Выйти");
	return 1;
}
DLG(4562, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(null(inputtext) || strlen(inputtext) >= 32) return ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_INPUT, ""cMain"Введите название номера", ""cWH"Введите название вашего будущего номера. Пример: КРАСАВЧИК 228", "Ввести", "Выйти");
	if(GetString(inputtext, "mq") || GetString(inputtext, "маму ебал") || GetString(inputtext, "маме привет") || GetString(inputtext, "мамку ебал"))
		return SendErr(playerid, "Запрещенный номер");
	new	slen = strlen(inputtext);
	mfor(i, (slen - 1)) if(inputtext[i] == '™' || inputtext[i] == '&' || inputtext[i] == '&' || inputtext[i] == '*' || inputtext[i] == '=' || inputtext[i] == '+' || inputtext[i] == '-' || inputtext[i] == '%')
	{
		SendErr(playerid, "Вы используете запрещенные символы");
		return ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_INPUT, ""cMain"Введите название номера", ""cWH"Введите название вашего будущего номера. Пример: КРАСАВЧИК 228", "Ввести", "Выйти");
	}
	if(IsIpFound(inputtext) || CheckString(inputtext))
	{
		SendErr(playerid, "Вы используете запрещенные слова");
		return ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_INPUT, ""cMain"Введите название номера", ""cWH"Введите название вашего будущего номера. Пример: КРАСАВЧИК 228", "Ввести", "Выйти");
	}
	mysql_format(db_prod, stringer1, 144, "SELECT `c_number` FROM `ownable_cars` WHERE `c_number` = '%e'", inputtext);
	mysql_tquery(db_prod, stringer1, "OnPlayerCheckNumberDonate", "is", playerid, inputtext);
	return 1;
}
DLG(211, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::donate(playerid);

	FirstLetter[playerid][0] = EOS;
	strcat(FirstLetter[playerid], gVehNumbers[listitem]);

	ShowPlayerDialog(playerid, 200+12, DIALOG_STYLE_INPUT, ""cMain"Укажите цифры в номере:","\n\n"cWH"Введите любые желаемые 3 цифры, которые будут использоваться в Вашем номере:\n\n", "Далее", "Отмена");
	return 1;
}
DLG(212, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::donate(playerid);
	if(strlen(inputtext) != 3) return SendClientMessage(playerid, COLOR_RED, "Длина цифр в номере должна быть не менее 1 знака, и не более 3-х"), ShowPlayerDialog(playerid, 200+12, DIALOG_STYLE_INPUT, ""cMain"Укажите цифры в номере:","\n\n"cWH"Введите любые желаемые 3 цифры, которые будут использоваться в Вашем номере:\n\n", "Далее", "Отмена");
