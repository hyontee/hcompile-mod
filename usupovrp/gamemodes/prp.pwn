DLG(7714, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	new f = PI[playerid][pFamily];
	new ok = SearchInventoryItem(playerid, 44);
	if(!ok) return SendErr(playerid, "У вас нет наркотиков");
	if(null(inputtext) || !isNumeric(inputtext)) return 1;
	if(!(1 <= strval(inputtext) <= 1500)) return SendClientMessage(playerid, COLOR_GREY, "Вы можете положить в общак от 1 до 1500 грамм наркотиков");
	if(family_info[f][f_narko] + strval(inputtext) > 1500) return SendClientMessage(playerid, COLOR_GREY, "Сейф может вместить только 1500 грамм наркотиков");
	if(PlayerItem2[playerid][ok]<strval(inputtext))return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько наркотиков");
	if(PlayerItem2[playerid][ok] == 0) PlayerItem1[playerid][ok]=0;
	family_info[f][f_narko] += strval(inputtext);
	PlayerItem2[playerid][ok] -= strval(inputtext);
	global_string = "";
	mysql_format(db_prod, global_string, sizeof global_string, "UPDATE `family_system` SET `fam_narko` = '%d' WHERE `fam_id` = '%d'", strval(inputtext), f);
	mysql_tquery(db_prod, global_string, "","");
	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, "{%s}[F] %s(%s) положил в общак семьи %d наркотиков", family_chat_color[family_info[f][f_chat_color]], GetName(playerid), family_rank_name[f][PI[playerid][pFamilyRank] - 1], strval(inputtext));
	family_message(f, -1, fmt_msg);
	SaveItem(playerid,ok);
	return 1;
}
DLG(7715, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	new f = PI[playerid][pFamily], newslot;
	if(null(inputtext) || !isNumeric(inputtext)) return 1;
	if(family_info[f][f_narko] < strval(inputtext)) return SendClientMessage(playerid, COLOR_GREY, "В общаке нет такого количества наркотиков");
	if(CheckMaxVes(playerid,44,strval(inputtext),newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
	PlayerItem1[playerid][newslot]=44;
	PlayerItem2[playerid][newslot]+=strval(inputtext);
	family_info[f][f_narko] -= strval(inputtext);
	global_string = "";
	mysql_format(db_prod, global_string, 100, "UPDATE `family_system` SET `fam_narko` = '%d' WHERE `fam_id` = '%d'", family_info[f][f_narko], f);
	mysql_tquery(db_prod, global_string, "","");
	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, "{%s}[F] %s(%s) взял из общака семьи %d наркотиков", family_chat_color[family_info[f][f_chat_color]], GetName(playerid), family_rank_name[f][PI[playerid][pFamilyRank] - 1], strval(inputtext));
	family_message(f, -1, fmt_msg);
	SaveItem(playerid,newslot);
	return 1;
}
