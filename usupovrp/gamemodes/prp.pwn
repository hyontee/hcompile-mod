DLG(2282, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new newslot;
	switch(listitem)
	{
	case 0:
		{
			if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, ""cER"Вы должны находится за рулем!");
			if(GetVehicleType(GetPlayerVehicleID(playerid)) == 7 || GetVehicleType(GetPlayerVehicleID(playerid)) == 4) return 1;
			if(Fuel[GetPlayerVehicleID(playerid)] >= 45) return SendClientMessage(playerid, -1, ""cER"Ваш бак полон!");
			if(Refueling[playerid] > 0) return SendClientMessage(playerid, -1, ""cER"Вы уже заправляетесь!");
			ShowPlayerDialog(playerid, 131+128, DIALOG_STYLE_INPUT, ""cMain"Топливо", ""cWH"Введите количество литров топлива:", "Принять", "Отмена");
		}
	case 1:
		{
			new till = BizzInfo[FuelBizzID[playerid]][bTill]*4;
			if(GetPlayerRubble(playerid) < till) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
			if(CheckMaxVes(playerid,49,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
			SetPlayerMoney(playerid, -till);
			if(BizzInfo[FuelBizzID[playerid]][bProduct] > 0)
			{
				BizzInfo[FuelBizzID[playerid]][bMoney] += till;
				BizzInfo[FuelBizzID[playerid]][bProduct] -= 10;
				BizzPay[FuelBizzID[playerid]] += till;
				MysqlUpdateBizzInt(FuelBizzID[playerid], "money", BizzInfo[FuelBizzID[playerid]][bMoney]);
				MysqlUpdateBizzInt(FuelBizzID[playerid], "product", BizzInfo[FuelBizzID[playerid]][bProduct]);
			}
			PlayerItem1[playerid][newslot]=49;
			PlayerItem2[playerid][newslot]+=1;
			SendMes(playerid, -1, ""cDA"Вы купили канистру за %dр!", till);
			FuelBizzID[playerid] = 0;
			SaveItem(playerid,newslot);
		}
	case 2:
		{
			new till = BizzInfo[FuelBizzID[playerid]][bTill]*5;
			if(CheckMaxVes(playerid,48,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
			if(GetPlayerRubble(playerid) < till) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
			SetPlayerMoney(playerid, -till);
			if(BizzInfo[FuelBizzID[playerid]][bProduct] > 0)
			{
				BizzInfo[FuelBizzID[playerid]][bMoney] += till;
				BizzInfo[FuelBizzID[playerid]][bProduct] -= 10;
				BizzPay[FuelBizzID[playerid]] += till;
				MysqlUpdateBizzInt(FuelBizzID[playerid], "money", BizzInfo[FuelBizzID[playerid]][bMoney]);
				MysqlUpdateBizzInt(FuelBizzID[playerid], "product", BizzInfo[FuelBizzID[playerid]][bProduct]);
			}
			PlayerItem1[playerid][newslot]=48;
			PlayerItem2[playerid][newslot]+=1;
			SendMes(playerid, -1, ""cDA"Вы купили набор инструментов за %dр!", till);
			FuelBizzID[playerid] = 0;
			SaveItem(playerid,newslot);
		}
	}
	return 1;
}
DLG(4600, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	else callcmd::cmd(playerid);
	return 1;
}
DLG(17, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(null(inputtext)) return ShowPlayerDialog(playerid, 11+6, DIALOG_STYLE_INPUT, ""cMain"Укажите цену:", ""cWH"Укажите цену за дом:", "Далее", "Отмена");

	rublevka_cost[playerid] = strval(inputtext);

	AddRublevkaHouse(playerid);
	return 1;
}
DLG(11, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
		{
		case 0:
			{
				ShowPlayerDialog(playerid, 11+2, DIALOG_STYLE_LIST, ""cMain"Выберите тип дома:", "1. Обычный дом\n2. Дом на Рублевке\n3. Дом за евро", "Выбрать", "Отмена");

			}
		case 1: ShowPlayerDialog(playerid, 11+4, 2, "Добавить бизнес", "Магазин 24/7\nЗаправка\nПиццерия\nМагазин аксессуаров\nКальянная\nСвободно\nСвободно\nСвободно\nБар\nАммуниция\nНовый клуб\nСТО\nМагазин одежды\nКазино", "Принять", "Отмена");
		case 2: ShowPlayerDialog(playerid, 77+15, 1, "Добавить транспорт", "ВАЖНО: Модель, Цвет1, Цвет2, Фракция, Статус\nПРИМЕР: 504, 1, 3, 4, 0", "Принять", "Отмена");
		case 3: ShowPlayerDialog(playerid, 11+5, 0, "Добавить ATM", "Вы хотите начать установку банкомата?", "Да", "Нет");
		case 4:
			{
				if(GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, COLOR_RED, "В интерьере нельзя создать гараж");
				if(CREATE_GARAGE[playerid]) return SendClientMessage(playerid, COLOR_RED, "Вы уже начали создавать гараж..");
				ShowPlayerDialog(playerid, 7373, DIALOG_STYLE_MSGBOX, "{2291B9}Создание гаража", ""cWH"Вы готовы приступить к созданию гаража?", "Да", "Нет");
			}
		}
	}
	return 1;
}
DLG(13, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			ShowPlayerDialog(playerid,11+1,1,""cMain"Добавить дом", "ВАЖНО: Тип интерьера\n\nПРИМЕР: 1\n\n\
			1. Низкий класс\n\
			2. Средний класс\n\
			3. Высокий класс","Выбрать","Закрыть");
		}
	case 1:
		{

			new Float:X, Float:Y, Float:Z;
			GetPlayerPos(playerid, X, Y, Z);

			add_house_rublevka[playerid] = 1;
			SendClientMessage(playerid, COLOR_GREEN, "Теперь Вам следует установить координаты появления личного вертолета");
			SendClientMessage(playerid, COLOR_GREEN, "Отойдите подальше от текстур и зданий так, чтобы ничего не мешало появлению вертолета и введите команду /tpc");

			house_posX[playerid] = X;
			house_posY[playerid] = Y;
			house_posZ[playerid] = Z;
		}
		case 2:
		{
			ShowPlayerDialog(playerid, 2565,1,""cMain"Добавить дом", "ВАЖНО: Тип интерьера\n\nПРИМЕР: 1\n\n\
			1. Низкий класс\n\
			2. Средний класс\n\
			3. Высокий класс","Выбрать","Закрыть");
		}
	}
	return 1;
}
DLG(2565, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new type, Float:x,Float:y,Float:z;
		if(sscanf(inputtext,"i",type))
		{
			if(!(1 <= type <= 3))
			{
				ShowPlayerDialog(playerid,11+1,1,"Добавить дом", "ВАЖНО: Тип интерьера\n\nПРИМЕР: 1\n\n\
				1. Низкий класс\n\
				2. Средний класс\n\
				3. Высокий класс","Выбрать","Закрыть");
				return 1;
			}
		}
		TOTALHOUSE++;
		GetPlayerPos(playerid,x,y,z);
		HouseInfo[TOTALHOUSE][hEntrx] = x;
		HouseInfo[TOTALHOUSE][hEntry] = y;
		HouseInfo[TOTALHOUSE][hEntrz] = z;

		switch(type)
		{
			case 1: format(string,10,"1,7");
			case 2: format(string,10,"2,8");
			case 3: format(string,10,"3,9");
		}
		sscanf(string,"p<,>ii",
		HouseInfo[TOTALHOUSE][hDiscript], HouseInfo[TOTALHOUSE][hInt]);
		HouseInfo[TOTALHOUSE][hVirtual] = TOTALHOUSE;

		HouseInfo[TOTALHOUSE][hOwned] = -1;
		HouseInfo[TOTALHOUSE][hType] = 1;
		HouseInfo[TOTALHOUSE][hExitx] = g_house_info[ HouseInfo[TOTALHOUSE][hDiscript] ][0];
		HouseInfo[TOTALHOUSE][hExity] = g_house_info[ HouseInfo[TOTALHOUSE][hDiscript] ][1];
		HouseInfo[TOTALHOUSE][hExitz] = g_house_info[ HouseInfo[TOTALHOUSE][hDiscript] ][2];

		new price__;
		switch(HouseInfo[TOTALHOUSE][hDiscript])
		{
			case 1: price__ = 3000000;
			case 2: price__ = 6000000;
			case 3: price__ = 9000000;
		}
		HouseInfo[TOTALHOUSE][hPrice] = price__;

		strmid(HouseInfo[TOTALHOUSE][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
		HouseInfo[TOTALHOUSE][hMIcon] = CreateDynamicMapIcon(HouseInfo[TOTALHOUSE][hEntrx], HouseInfo[TOTALHOUSE][hEntry], HouseInfo[TOTALHOUSE][hEntrz], 31, 0);
		HouseInfo[TOTALHOUSE][hPickup] = CreatePickup(1273,1, HouseInfo[TOTALHOUSE][hEntrx], HouseInfo[TOTALHOUSE][hEntry], HouseInfo[TOTALHOUSE][hEntrz]);
		HouseInfo[TOTALHOUSE][hPickupExit] = CreateDynamic3DTextLabel(""cWH"Для выхода введите:\n"cMain"/exit\n"cWH"Управление домом: \n"cMain"/home",COLOR_WHITE,HouseInfo[TOTALHOUSE][hExitx], HouseInfo[TOTALHOUSE][hExity], HouseInfo[TOTALHOUSE][hExitz],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,HouseInfo[TOTALHOUSE][hVirtual],HouseInfo[TOTALHOUSE][hInt]);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `house` (`id`, `hEntrx`, `hEntry`, `hEntrz`, `hExitx`, `hExity`, `hExitz`, `hDiscript`, `hPrice`, `hType`, `hInt`, `hVirtual`) VALUES ('%d', '%f', '%f', '%f', '%f', '%f', '%f', '%d', '%d', '%d', '%d', '%d')",
		TOTALHOUSE,
		HouseInfo[TOTALHOUSE][hEntrx],HouseInfo[TOTALHOUSE][hEntry],HouseInfo[TOTALHOUSE][hEntrz],
		HouseInfo[TOTALHOUSE][hExitx],HouseInfo[TOTALHOUSE][hExity],HouseInfo[TOTALHOUSE][hExitz],
		HouseInfo[TOTALHOUSE][hDiscript],HouseInfo[TOTALHOUSE][hPrice],HouseInfo[TOTALHOUSE][hType],HouseInfo[TOTALHOUSE][hInt],HouseInfo[TOTALHOUSE][hVirtual]);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
		UpdateCupboard(TOTALHOUSE);

		for(new i; i < 3; i++) strmid(HouseArendName[TOTALHOUSE][i], "none", 0, strlen("none"), 10);
		SendMes(playerid,COLOR_LIME,"Дом №%d Успешно создан",TOTALHOUSE);
		fLogs("[admin] %s /add дом %i [%f %f %f]", GetName(playerid), TOTALHOUSE, HouseInfo[TOTALHOUSE][hEntrx], HouseInfo[TOTALHOUSE][hEntry], HouseInfo[TOTALHOUSE][hEntrz]);
		return 1;
	}
	TPC[playerid] = false;
	return 1;
}
DLG(12, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new type, Float:x,Float:y,Float:z;
		if(sscanf(inputtext,"i",type))
