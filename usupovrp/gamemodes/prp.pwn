cmd:setfuel(playerid, params[])
{
	if(PI[playerid][pAdmin] < 4) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится в транспорте!");
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setfuel [кол-во бензина]");
	if(params[0] > 45 || params[0] < 1) return SendClientMessage(playerid, COLOR_GREY, "Неверное кол-во литров. Можно установить от 1 до 45 л");
	Fuel[GetPlayerVehicleID(playerid)] = params[0];
	SendClientMessage(playerid, COLOR_LIME, "Транспорт заправлен");
	fLogs("[admin] %s /setfuel %i %i", GetName(playerid), GetPlayerVehicleID(playerid), params[0]);
	return 1;
}
