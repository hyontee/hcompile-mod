new add_player;
stock check_acsid(playerid, accs) {

	new names_acs[19], acs_close = 0, access = -1;

	switch accs do {
	    case 612: names_acs = "Нимб";
	    case 613: names_acs = "Шар #1";
	    case 614: names_acs = "Шар #2";
	    case 615: names_acs = "Шар #3";
     	case 616: names_acs = "Шар #4";
     	case 617: names_acs = "Шар #5";
     	case 618: names_acs = "Шар #6";
		case 619: names_acs = "Шляпа Китайца";
		case 620: names_acs = "Голова Дьявола";
		case 621: names_acs = "Попугай на плечо";
		case 622: names_acs = "Катана (Обычная)";
		case 623: names_acs = "Розовая катана";
		case 624: names_acs = "Зелёная катана";
		case 625: names_acs = "Синяя катана";
		case 626: names_acs = "Красная катана";
		case 627: names_acs = "Голубая катана";
		case 628: names_acs = "Фиолетная катана";
		case 629: names_acs = "Чёрная гитара";
		case 630: names_acs = "Бело-Чёрная гитара";
		case 631: names_acs = "Красная гитара";
		case 632: names_acs = "Шляпа Ведьмы";
		case 633: names_acs = "Молот на спину";
		case 634: names_acs = "Прозрачный Нимб";
		case 635: names_acs = "Очки НЗ";
		case 636: names_acs = "Респиратор";
	    default: names_acs = "Неизвестный", acs_close = 1;

	}

	if(acs_close == 1) return SendClientMessage(add_player, -1, "Не правильный ID");


	SCMF(playerid, COLOR_YELLOW, "Вам был добавлен новый аксессуар '%s' Используйте: /accs (Чтобы его одеть)", names_acs);
	SCM(playerid, COLOR_YELLOW, "Аксессуар появится после перезахода в игру.");

	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `accounts_accessories` (`owner`, `name`, `objectid`) VALUES ('%d', '%e', '%d')", PI[playerid][pID], names_acs, accs);
	mysql_tquery(db_prod, STRING_GLOBAL, "accessories_in", "ii", playerid, access);

	acs_close = 0;

	return accs;
}
cmd:idacs(playerid) {

    if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	return ShowPlayerDialog(playerid, 0, 0, "ID Аксессуаров",
	"{FFFF00}ID:{c0c0c0} 612{FFFF00} - Нимб\n\
	{FFFF00}ID:{c0c0c0} 613{FFFF00} - Шар #1\nID:{c0c0c0} 614{FFFF00} - Шар #2\nID:{c0c0c0} 615{FFFF00} - Шар #3\nID:{c0c0c0} 616{FFFF00} - Шар #4\n{FFFF00}ID:{c0c0c0} 617{FFFF00} - Шар #4\n{FFFF00}ID:{c0c0c0} 618{FFFF00} - Шар #5\n\
	{FFFF00}ID:{c0c0c0} 619{FFFF00} - Шляпа Китайца\n{FFFF00}ID{c0c0c0} 621{FFFF00} - Попугай на плечо\n\
	{FFFF00}ID{c0c0c0} 622{FFFF00} - Катана (Обычная)\n{FFFF00}ID{c0c0c0} 623{FFFF00} - Розовая катана\n{FFFF00}ID{c0c0c0} 624{FFFF00} - Зелёная катана\n\
	{FFFF00}ID{c0c0c0} 625{FFFF00} - Синяя катана\n{FFFF00}ID{c0c0c0} 626{FFFF00} - Красная катана\n{FFFF00}ID{c0c0c0} 627{FFFF00} - Голубая катана\n{FFFF00}ID{c0c0c0} 628{FFFF00} - Фиолетная катана\n\
	{FFFF00}ID{c0c0c0} 629{FFFF00} - Чёрная Гитара\n{FFFF00}ID{c0c0c0} 630{FFFF00} - Бело-Чёрная гитара\n{FFFF00}ID{c0c0c0} 631{FFFF00} - Красная гитара\n\
	{FFFF00}ID{c0c0c0} 632{FFFF00} - Шляпа Ведьмы\n{FFFF00}ID{c0c0c0} 633{FFFF00} - Молот на спину\n{FFFF00}ID{c0c0c0} 634{FFFF00} - Прозрачный Нимб\n\
	{FFFF00}ID{c0c0c0} 635{FFFF00} - Очки НЗ\n{FFFF00}ID{c0c0c0} 636{FFFF00} - Респиратор", "x", "");

}
cmd:additem(playerid, params[]) {

    new id, acs;

	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "dd", id, acs)) return SendClientMessage(playerid, -1, "/additem [id player] [id acs (/idacs)]");
	if(acs == check_acsid(id, acs)) add_player = playerid, SCMF(playerid, -1, "Вы успешно выдали '%d' аксессуар игроку (Количество: 1)", acs);
	else return SendClientMessage(playerid, -1, "Данного акссесуара несуществует! Узнать ID аксессуара: /idacs");

	return 1;
}
CMD:gt(playerid)
{
	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "int %d world %d", GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
	SendClientMessage(playerid, -1, STRING_GLOBAL);
}

CMD:stream(playerid)
{
	if(streamer_mode[playerid] != 1)
	{
		SendClientMessage(playerid, 0xa48bcaFF, "Вы успешно активировали режим стримера.");

		streamer_mode[playerid] = 1;

		HideWarningPanelAC(playerid);
	}

	else
	{
		SendClientMessage(playerid, 0xa48bcaFF, "Вы успешно деактивировали режим стримера.");

		streamer_mode[playerid] = 0;

		ShowWarningPanelAC(playerid);
	}
}

