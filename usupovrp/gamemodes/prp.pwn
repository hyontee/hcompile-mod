				if(gArmyWarehouse[1] < 20) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 20;
			}
			gun_select_inv[playerid] = 28;
			gun_select_gun[playerid] = 31;
			gun_select_buy[playerid] = 0;
		}
	case 5:
		{
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 40) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 40;
			}
			gun_select_inv[playerid] = 30;
			gun_select_gun[playerid] = 30;
			gun_select_buy[playerid] = 0;
		}
	case 6:
		{
			if(PI[playerid][pMember] == TEAM_MVD)
			{
				gun_select_inv[playerid] = 26;
				gun_select_gun[playerid] = 29;
				gun_select_buy[playerid] = 0;
			}
		}
	}
	if(listitem != 0) ShowPlayerDialog(playerid, 19015, DIALOG_STYLE_LIST, ""cMain"Выберите действие:", "1. Поместить оружие в инвентарь\n2. Взять оружие в руки", "Выбрать", "Отмена");

	SaveItem(playerid,newslot);
	SetPlayerHealth(playerid, 100);
	return 1;
}

DLG(19015, playerid, response, listitem, inputtext[])
{
	if(!response) return gun_select_inv[playerid] = 0, gun_select_gun[playerid] = 0;

	new newslot;

	new price_weapon = GetReasonMoneyPercentVip(playerid, TYPE_VIP_WEAPON, gGunCosts[gun_select_buy[playerid]]);
	switch(listitem)
	{
	case 0:
		{
			new inv_gun = gun_select_inv[playerid];
			if(CheckMaxVes(playerid,inv_gun,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
			PlayerItem1[playerid][newslot]=inv_gun;
			PlayerItem2[playerid][newslot]+=1;
			if(!gun_select_buy[playerid])
			{
				SendMes(playerid, -1, ""cPS"Вы взяли %s. Оружие в Вашем инвентаре (/inv)", GunNames[gun_select_inv[playerid]]);
				if(PI[playerid][pSex] == 1) MeAction(playerid, "взял оружие из шкафчика");
				else MeAction(playerid, "взяла оружие из шкафчика");
				gun_select_inv[playerid] = 0;
			}
			else if(gun_select_buy[playerid])
			{
				new i = GetPlayerInBiz(playerid);
				if(i == -1) return 1;
				new price = price_weapon;
				if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
				SetPlayerMoney(playerid, -price);
				if(BizzInfo[i][bProduct] > 0)
				{
					BizzInfo[i][bMoney] += price;
					BizzPay[i] += price;
					BizzInfo[i][bProduct] -= floatround(price / 100);
					MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
					MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
				}
				format(string, sizeof(string), ""cDA"Вы купили оружие за %dр", price);
				SendClientMessage(playerid, -1, string);
				gun_select_buy[playerid] = 0;
				gun_select_inv[playerid] = 0;
			}
			SaveItem(playerid,newslot);
		}
	case 1:
		{
			new gun = gun_select_gun[playerid];

			if(!gun_select_buy[playerid])
			{
				GivePlayerWeapon(playerid, gun, 100);
				SendMes(playerid, -1, ""cPS"Вы взяли %s из шкафчика", GunNames[gun]);
				if(PI[playerid][pSex] == 1) MeAction(playerid, "взял оружие из шкафчика");
				else MeAction(playerid, "взяла оружие из шкафчика");
				gun_select_gun[playerid] = 0;
			}
			else if(gun_select_buy[playerid])
			{
				new i = GetPlayerInBiz(playerid);
				if(i == -1) return 1;
				new price = price_weapon;
				if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
				SetPlayerMoney(playerid, -price);
				if(BizzInfo[i][bProduct] > 0)
				{
					BizzInfo[i][bMoney] += price;
					BizzPay[i] += price;
					BizzInfo[i][bProduct] -= floatround(price / 100);
					MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
					MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
				}
				format(string, sizeof(string), ""cDA"Вы купили оржие за %dр", price);
				SendClientMessage(playerid, -1, string);
				gun_select_buy[playerid] = 0;
				GivePlayerWeapon(playerid, gun, 100);
				gun_select_inv[playerid] = 0;
			}
			SaveItem(playerid,newslot);
		}
	}
	return 1;
}
DLG(1604, playerid, response, listitem, inputtext[])
{
	if(PhoneNumbers[playerid][5] < 40) return SendClientMessage(playerid, -1, ""cER"Недостаточно подарков!");
	{
		new rand_money = random(99999);
		PhoneNumbers[playerid][5] -= 40;
		SetPlayerMoney(playerid, rand_money);
		format(string,sizeof(string), ""cMain"Подарки |"cWH" Вы выиграли {bbbbbb}%dр{ffcd00} на игровой аккаунт", rand_money);
		SendClientMessage(playerid, 0xFFCD00FF, string);
	}
	return 1;
}
DLG(112, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new name[90];
	if(sscanf(inputtext,"s[90]",name)) return ShowPlayerDialog(playerid, 106+6, 1, "Бизнес", "ВАЖНО: Название\n\nПРИМЕР: Gas Station", "Принять", "Отмена");
	TOTALBIZZ++;
	sscanf(boordh,"p<,>ffffffiii",
	BizzInfo[TOTALBIZZ][bExitx],BizzInfo[TOTALBIZZ][bExity],BizzInfo[TOTALBIZZ][bExitz],
	BizzInfo[TOTALBIZZ][bMenux],BizzInfo[TOTALBIZZ][bMenuy],BizzInfo[TOTALBIZZ][bMenuz],
	BizzInfo[TOTALBIZZ][bInt],BizzInfo[TOTALBIZZ][bMIcon], BizzInfo[TOTALBIZZ][bType]);
	GetPlayerPos(playerid,BizzInfo[TOTALBIZZ][bEntrx],BizzInfo[TOTALBIZZ][bEntry],BizzInfo[TOTALBIZZ][bEntrz]);
	strmid(BizzInfo[TOTALBIZZ][bOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
	strmid(BizzInfo[TOTALBIZZ][bName], name, 0, strlen(name), 32);
	BizzInfo[TOTALBIZZ][bVirtual] = TOTALBIZZ;
	BizzInfo[TOTALBIZZ][bEnter] = 0;
	BizzInfo[TOTALBIZZ][bOwned] = -1;
	BizzInfo[TOTALBIZZ][bTill] = 50;

	new price__;
	switch(BizzInfo[TOTALBIZZ][bType])
	{
		case 1: price__ = 540000;
		case 2: price__ = 500000;
		case 3: price__ = 10000000;
		case 4: price__ = 460000;
		case 5: price__ = 240000;
		case 6: price__ = 800000;
		case 7: price__ = 450000;
		case 8: price__ = 410000;
		case 9: price__ = 1000000;
		case 10: price__ = 3000000;
	}
	BizzInfo[TOTALBIZZ][bPrice] = price__;
	BizzInfo[TOTALBIZZ][bProduct] = OverallBizz[BizzInfo[TOTALBIZZ][bType]];

	BizzInfo[TOTALBIZZ][bIcon] = CreateDynamicMapIcon(BizzInfo[TOTALBIZZ][bEntrx],BizzInfo[TOTALBIZZ][bEntry],BizzInfo[TOTALBIZZ][bEntrz], BizzInfo[TOTALBIZZ][bMIcon], 0);
	new fee[64];
	if(BizzInfo[TOTALBIZZ][bEnter] == 0) fee = "Бесплатный";
	else format(fee, sizeof(fee), "%dр", BizzInfo[TOTALBIZZ][bEnter]);

	if(BizzInfo[TOTALBIZZ][bType] != 2 && BizzInfo[TOTALBIZZ][bType] != 7)
	{
		global_string = "";
		BizzInfo[TOTALBIZZ][bPickup] = CreatePickup(19132,1,BizzInfo[TOTALBIZZ][bEntrx],BizzInfo[TOTALBIZZ][bEntry],BizzInfo[TOTALBIZZ][bEntrz]);
		BizzInfo[TOTALBIZZ][bPickupExit] = CreatePickup(19132,1,BizzInfo[TOTALBIZZ][bExitx],BizzInfo[TOTALBIZZ][bExity],BizzInfo[TOTALBIZZ][bExitz],BizzInfo[TOTALBIZZ][bVirtual]);
		BizzInfo[TOTALBIZZ][bMenu] = CreateDynamicSphere(BizzInfo[TOTALBIZZ][bMenux],BizzInfo[TOTALBIZZ][bMenuy],BizzInfo[TOTALBIZZ][bMenuz],1.0,BizzInfo[TOTALBIZZ][bVirtual],BizzInfo[TOTALBIZZ][bInt]);
		if(BizzInfo[TOTALBIZZ][bType] == 8) CreatePickup(1275,1,BizzInfo[TOTALBIZZ][bMenux],BizzInfo[TOTALBIZZ][bMenuy],BizzInfo[TOTALBIZZ][bMenuz],BizzInfo[TOTALBIZZ][bVirtual]);
		else CreatePickup(1274,1,BizzInfo[TOTALBIZZ][bMenux],BizzInfo[TOTALBIZZ][bMenuy],BizzInfo[TOTALBIZZ][bMenuz],BizzInfo[TOTALBIZZ][bVirtual]);
		if(!strcmp(BizzInfo[TOTALBIZZ][bOwner],"None",true))
		{
			format(global_string, 250, "{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\nКрышуют: {99cc00}Нет", BizzInfo[TOTALBIZZ][bName], BizzInfo[TOTALBIZZ][bPrice]);
			LABELBIZZ[TOTALBIZZ] = CreateDynamic3DTextLabel(global_string,-1,BizzInfo[TOTALBIZZ][bEntrx], BizzInfo[TOTALBIZZ][bEntry], BizzInfo[TOTALBIZZ][bEntrz]+0.5,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
		}
		else
		{
			format(global_string, 250, "{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Вход: "cMain"%s\nКрышуют: {99cc00}Нет", BizzInfo[TOTALBIZZ][bName], BizzInfo[TOTALBIZZ][bOwner], fee);
			LABELBIZZ[TOTALBIZZ] = CreateDynamic3DTextLabel(global_string,-1,BizzInfo[TOTALBIZZ][bEntrx], BizzInfo[TOTALBIZZ][bEntry], BizzInfo[TOTALBIZZ][bEntrz]+0.5,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
		}
	}
	else if(BizzInfo[TOTALBIZZ][bType] == 2)
	{
		global_string = "";
		if(!strcmp(BizzInfo[TOTALBIZZ][bOwner],"None",true))
		{
			format(global_string, 320, "{ffcc33}H - Меню АЗС\n\n{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\n"cWH"Цена за 1 литр бензина: "cMain"%dр\n"cWH"Купить канистру: /buyfuel\nКрышуют: {99cc00}Нет", BizzInfo[TOTALBIZZ][bName], BizzInfo[TOTALBIZZ][bPrice], BizzInfo[TOTALBIZZ][bTill] / 3);
			LABELBIZZ[TOTALBIZZ] = CreateDynamic3DTextLabel(global_string,-1,BizzInfo[TOTALBIZZ][bEntrx], BizzInfo[TOTALBIZZ][bEntry], BizzInfo[TOTALBIZZ][bEntrz]+1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID);
		}
		else
		{
			format(global_string, 320, "{ffcc33}H - Меню АЗС\n\n{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Цена за 1 литр бензина: "cMain"%dр\n"cWH"Купить канистру: /buyfuel\nКрышуют: {99cc00}Нет", BizzInfo[TOTALBIZZ][bName], BizzInfo[TOTALBIZZ][bOwner], BizzInfo[TOTALBIZZ][bTill] / 3);
			LABELBIZZ[TOTALBIZZ] = CreateDynamic3DTextLabel(global_string,-1,BizzInfo[TOTALBIZZ][bEntrx], BizzInfo[TOTALBIZZ][bEntry], BizzInfo[TOTALBIZZ][bEntrz]+1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID);
		}
	}
	else if(BizzInfo[TOTALBIZZ][bType] == 7)
	{
		global_string = "";
		if(!strcmp(BizzInfo[TOTALBIZZ][bOwner],"None",true))
		{
			format(global_string, 300, "{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\n"cWH"Цена за 1 запчасть - "cMain"%dр\n\n{ffcc33}ГУДОК - Заехать в СТО\nКрышуют: {99cc00}Нет", BizzInfo[TOTALBIZZ][bName], BizzInfo[TOTALBIZZ][bPrice], BizzInfo[TOTALBIZZ][bTill]);
			LABELBIZZ[TOTALBIZZ] = CreateDynamic3DTextLabel(global_string,-1,BizzInfo[TOTALBIZZ][bEntrx], BizzInfo[TOTALBIZZ][bEntry], BizzInfo[TOTALBIZZ][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
		}
		else
		{
			format(global_string, 300, "{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Цена за 1 запчасть - "cMain"%dр\n\n{ffcc33}ГУДОК - Заехать в СТО\nКрышуют: {99cc00}Нет", BizzInfo[TOTALBIZZ][bName], BizzInfo[TOTALBIZZ][bOwner], BizzInfo[TOTALBIZZ][bTill]);
			LABELBIZZ[TOTALBIZZ] = CreateDynamic3DTextLabel(global_string,COLOR_GREEN,BizzInfo[TOTALBIZZ][bEntrx], BizzInfo[TOTALBIZZ][bEntry], BizzInfo[TOTALBIZZ][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
		}
	}
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bizz` (`id`, `x`, `y`, `z`, `xt`, `yt`, `zt`, `menux`, `menuy`, `menuz`, `vint`, `virt`, `owner`, `name`, `price`, `product`, `type`, `icon`) VALUES ('%d', '%f', '%f', '%f', '%f', '%f', '%f','%f', '%f', '%f', '%d', '%d', '%e', '%e', '%d', '%d', '%d', '%d')",
	TOTALBIZZ,BizzInfo[TOTALBIZZ][bEntrx],BizzInfo[TOTALBIZZ][bEntry],BizzInfo[TOTALBIZZ][bEntrz],BizzInfo[TOTALBIZZ][bExitx],BizzInfo[TOTALBIZZ][bExity],BizzInfo[TOTALBIZZ][bExitz], BizzInfo[TOTALBIZZ][bMenux],BizzInfo[TOTALBIZZ][bMenuy],BizzInfo[TOTALBIZZ][bMenuz]
	,BizzInfo[TOTALBIZZ][bInt],BizzInfo[TOTALBIZZ][bVirtual],BizzInfo[TOTALBIZZ][bOwner],BizzInfo[TOTALBIZZ][bName], BizzInfo[TOTALBIZZ][bPrice], BizzInfo[TOTALBIZZ][bProduct], BizzInfo[TOTALBIZZ][bType], BizzInfo[TOTALBIZZ][bMIcon]);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	SendMes(playerid,COLOR_LIME,"Бизнес номер %d создан",TOTALBIZZ);

	fLogs("[admin] %s /add бизнес %i [%f %f %f]", GetName(playerid), TOTALBIZZ, BizzInfo[TOTALBIZZ][bEntrx],BizzInfo[TOTALBIZZ][bEntry],BizzInfo[TOTALBIZZ][bEntrz]);
	return 1;
}
DLG(115, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new idx = PlayerBizzSelect[playerid];

	PI[playerid][pInBiz] = idx;

	SetPlayerPos(playerid,BizzInfo[idx][bExitx], BizzInfo[idx][bExity], BizzInfo[idx][bExitz]);
	SetPlayerInterior(playerid,BizzInfo[idx][bInt]);
	SetPlayerVirtualWorld(playerid,BizzInfo[idx][bVirtual]);
	SetCameraBehindPlayer(playerid);
	return 1;
}
DLG(116, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new i = GetPlayerBizz(playerid);
	switch(listitem)
	{
		case 0: BizzStats(playerid, i);
		case 1:
		{
			if(BizzInfo[i][bLock] == 0) return SendClientMessage(playerid, COLOR_GREY, "Бизнес уже открыт!");
			if(BizzInfo[i][bProduct] <= 0) return SendClientMessage(playerid, COLOR_GREY, "В бизнесе нет продуктов!");
			BizzInfo[i][bLock] = 0;
			BizzInfo[i][bLockTime] = 0;
			MysqlUpdateBizzInt(i, "block", BizzInfo[i][bLock]);
			MysqlUpdateBizzInt(i, "locktime", BizzInfo[i][bLockTime]);
			SendClientMessage(playerid, COLOR_LIGHTRED, "Вы открыли бизнес. Всегда следите за состоянием продуктов");
			SendClientMessage(playerid, COLOR_LIGHTRED, "В противном случае вы можете потерять бизнес");
		}
		case 2:
		{
			if(BizzInfo[i][bType] == 1 || BizzInfo[i][bType] == 6 || BizzInfo[i][bType] == 7 || BizzInfo[i][bType] == 8)
			{
				SendClientMessage(playerid, COLOR_GREY, "В данном типе бизнеса нельзя управлять ценой на товар!");
			}
			else
			{
				ShowPlayerDialog(playerid, 106+11, 1, ""cMain"Цена", ""cWH"Введите цену за товар:", "Принять", "Отмена");
			}
		}
		case 3:
		{
			if(BizzInfo[i][bType] == 2 || BizzInfo[i][bType] == 7)
			{
				SendClientMessage(playerid, COLOR_GREY, "В данном типе бизнеса нельзя управлять ценой за вход!");
			}
			else
			{
				ShowPlayerDialog(playerid, 106+12, 1, ""cMain"Цена", ""cWH"Введите цену за вход:", "Принять", "Отмена");
			}
		}
		case 4: ShowPlayerDialog(playerid, 106+16, 0, ""cMain"Продать бизнес", ""cWH"Вы хотите продать свой бизнес?\n\n{F04245}Вам вернут только половину стоимости бизнеса!", "Да", "Нет");
		case 5: ShowPlayerDialog(playerid, 106+27, 1, ""cMain"Заказать продукты", ""cWH"Введите к-во товара, которое хотите заказать {FFFF00}(1ед. = 2р):", "Принять", "Отмена");
		case 6:
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
			"cMain"1."cWH" Вместимость склада\t"cMain"Улучшения: %d/10"cWH"\t"cMain"Стоимость:"cMain" %d евро"cWH"", BizzInfo[i][bUpdate], (BizzInfo[i][bUpdate] + 1) * 1000);
			ShowPlayerDialog(playerid, 5003, DIALOG_STYLE_LIST, ""cMain"Улучшения", STRING_GLOBAL, "Принять", "Отмена");
		}
	}
	return 1;
}

DLG(5003, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::business(playerid);

	new i = GetPlayerBizz(playerid);

	if(BizzInfo[i][bUpdate] == 10)
		return SendErr(playerid, "Вы достигли максимального улучшения");

	if(playerEuro[playerid] < (BizzInfo[i][bUpdate] + 1) * 1000) return SendClientMessage(playerid, -1, ""cER"У вас недостаточно денежных средств");

	BizzInfo[i][bUpdate] += 1;
	TransferEuro(playerid, -1, (BizzInfo[i][bUpdate] + 1) * 1000, "Улучшения в бизнесе");
	MysqlUpdateBizzInt(i, "update_biz", BizzInfo[i][bUpdate]);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
	"cMain"1."cWH" Вместимость склада\t"cMain"Улучшения: %d/10"cWH"\t"cMain"Стоимость:"cMain" %d евро"cWH"", BizzInfo[i][bUpdate], (BizzInfo[i][bUpdate] + 1) * 1000);
	ShowPlayerDialog(playerid, 5003, DIALOG_STYLE_LIST, ""cMain"Улучшения", STRING_GLOBAL, "Принять", "Отмена");
	return 0x1;
}

DLG(133, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::business(playerid);
	new idx = GetPlayerBizz(playerid);
	new prod = strval(inputtext);
	new price = (prod * 2);

	new MaxProd = (2500 * BizzInfo[idx][bUpdate]) + OverallBizz[BizzInfo[idx][bType]];
	if(BizzInfo[idx][bType] == 1)
	{
		if(prod < 0 || prod > MaxProd-BizzInfo[idx][bProduct])
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы не можете заказать более %d единиц товара", MaxProd - BizzInfo[idx][bProduct]);
			SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);
			return 0x1;
		}
		if(GetPlayerRubble(playerid) < price)
		{
			format(string, sizeof(string), "Вам нужно %dр для того чтобы заказать %d ед. товара", price, prod);
			SendClientMessage(playerid, COLOR_GREY, string);
			return 1;
		}
		orderprod[playerid] = prod;
		format(string, sizeof(string), ""cWH"Вы действительно хотите заказать %d ед. товара за %dр?", prod, price);
		ShowPlayerDialog(playerid, 106+28, 0, " ", string, "Да", "Нет");
	}
	if(BizzInfo[idx][bType] == 2)
	{
		if(prod < 0 || prod > MaxProd-BizzInfo[idx][bProduct])
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы не можете заказать более %d единиц товара", MaxProd - BizzInfo[idx][bProduct]);
			SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);
			return 0x1;
		}
		if(GetPlayerRubble(playerid) < price)
		{
			format(string, sizeof(string), "Вам нужно %dр для того чтобы заказать %d л. бензина", price, prod);
			SendClientMessage(playerid, COLOR_GREY, string);
			return 1;
		}
		orderprod[playerid] = prod;
		format(string, sizeof(string), ""cWH"Вы действительно хотите заказать %d л. бензина за %dр?", prod, price);
		ShowPlayerDialog(playerid, 106+28, 0, " ", string, "Да", "Нет");
	}
	if(BizzInfo[idx][bType] == 3)
	{
		if(prod < 0 || prod > MaxProd-BizzInfo[idx][bProduct])
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы не можете заказать более %d единиц товара", MaxProd - BizzInfo[idx][bProduct]);
			SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);
			return 0x1;
		}
		if(GetPlayerRubble(playerid) < price)
		{
			format(string, sizeof(string), "Вам нужно %dр для того чтобы заказать %d ед. товара", price, prod);
			SendClientMessage(playerid, COLOR_GREY, string);
			return 1;
		}
		orderprod[playerid] = prod;
		format(string, sizeof(string), ""cWH"Вы действительно хотите заказать %d ед. товара за %dр?", prod, price);
		ShowPlayerDialog(playerid, 106+28, 0, " ", string, "Да", "Нет");
	}
	if(BizzInfo[idx][bType] == 4 || BizzInfo[idx][bType] == 5)
	{
		if(prod < 0 || prod > MaxProd-BizzInfo[idx][bProduct])
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы не можете заказать более %d единиц товара", MaxProd - BizzInfo[idx][bProduct]);
