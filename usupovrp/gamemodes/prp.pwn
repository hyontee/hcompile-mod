	SaveItem(playerid,newslot);
	return 1;
}
DLG(121, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new i = GetPlayerInBiz(playerid);
	if(i == -1) return 1;
	new price = gBarCost[listitem], till = BizzInfo[i][bTill];
	if(GetPlayerRubble(playerid) < till * price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
	new Float:amount;
	GetPlayerHealth(playerid, amount);
	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выпил воды");
			else MeAction(playerid, "выпила воды");
			if(amount+10.0 > 100)
			{
				SetPlayerHealth(playerid, 100);
				SendClientMessage(playerid, COLOR_WHITE, "Вы полностью наелись!");
			}
			else GiveHealth(playerid, 10);
		}
	case 1:
		{
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выпил соды");
			else MeAction(playerid, "выпила соды");
			if(amount+10.0 > 100)
			{
				SetPlayerHealth(playerid, 100);
				SendClientMessage(playerid, COLOR_WHITE, "Вы полностью наелись!");
			}
			else GiveHealth(playerid, 10);
		}
	case 2:
		{
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выпил кока-колы");
			else MeAction(playerid, "выпила кока-колы");
			if(amount+10.0 > 100)
			{
				SetPlayerHealth(playerid, 100);
				SendClientMessage(playerid, COLOR_WHITE, "Вы полностью наелись!");
			}
			else GiveHealth(playerid, 10);
		}
	case 3:
		{
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выпил пиво");
			else MeAction(playerid, "выпила пиво");
			if(amount+10.0 > 100)
			{
				SetPlayerHealth(playerid, 100);
				SendClientMessage(playerid, COLOR_WHITE, "Вы полностью наелись!");
			}
			else GiveHealth(playerid, 20);
			if(GetPlayerDrunkLevel(playerid) < 20000) SetPlayerDrunkLevel(playerid,GetPlayerDrunkLevel(playerid)+2000);
		}
	case 4:
		{
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выпил водки 'Шурале'");
			else MeAction(playerid, "выпила водки 'Шурале'");
			if(amount+30.0 > 100)
			{
				SetPlayerHealth(playerid, 100);
				SendClientMessage(playerid, COLOR_WHITE, "Вы полностью наелись!");
			}
			else GiveHealth(playerid, 30);
			if(GetPlayerDrunkLevel(playerid) < 20000) SetPlayerDrunkLevel(playerid,GetPlayerDrunkLevel(playerid)+5000);
		}
	case 5:
		{
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выпил коньяк");
			else MeAction(playerid, "выпила коньяк");
			if(amount+30.0 > 100)
			{
				SetPlayerHealth(playerid, 100);
				SendClientMessage(playerid, COLOR_WHITE, "Вы полностью наелись!");
			}
			else GiveHealth(playerid, 30);
			if(GetPlayerDrunkLevel(playerid) < 20000) SetPlayerDrunkLevel(playerid,GetPlayerDrunkLevel(playerid)+5000);
		}
	case 6:
		{
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выпил абсент 'София'");
			else MeAction(playerid, "выпила абсент 'София'");
			if(amount+30.0 > 100)
			{
				SetPlayerHealth(playerid, 100);
				SendClientMessage(playerid, COLOR_WHITE, "Вы полностью наелись!");
			}
			else GiveHealth(playerid, 30);
			if(GetPlayerDrunkLevel(playerid) < 20000) SetPlayerDrunkLevel(playerid,GetPlayerDrunkLevel(playerid)+5000);
		}
	}

	SetPlayerMoney(playerid, -(till * price));
	if(BizzInfo[i][bProduct] > 0)
	{
		BizzInfo[i][bMoney] += till * price;
		BizzPay[i] += till * price;
		BizzInfo[i][bProduct] -= gBarProd[listitem];
		MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
		MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
	}
	ApplyAnimation(playerid, "BAR", "dnk_stndF_loop", 4.1, 0, 0, 0, 0, 0, 1);
	if(GetPlayerDrunkLevel(playerid) > 20000) SetPlayerDrunkLevel(playerid, 20000);
	BarList(playerid);
	return 1;
}
DLG(122, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new i = GetPlayerBizz(playerid);

	strmid(BizzInfo[i][bOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
	SendMes(playerid, COLOR_RED, "Вы продали свой бизнес за %dр. Деньги с бизнеса переведены на ваш счет",BizzInfo[i][bPrice]/2);

	BizzInfo[i][bLock] =
	BizzInfo[i][bBuyPrice] =
	BizzInfo[i][bMoney] =
	BizzInfo[i][bEnter] =
	BizzInfo[i][bMafia] =
	BizzInfo[i][bOplata] = 0;
	BizzInfo[i][bOwned] = -1;
	BizzInfo[i][bTill] = 50;

	BizzInfo[i][bProduct] = OverallBizz[BizzInfo[i][bType]];
	format(global_string, 256, "UPDATE `bizz` SET owner='None', `owned` = '-1', block=0, money=0, penter=0, till=50, buyprice=%d , product=%d, oplata=0 WHERE id = %d",BizzInfo[i][bOwner], BizzInfo[i][bBuyPrice], BizzInfo[i][bProduct], i);
	mysql_tquery(db_prod, global_string, "", "");
	UpdateBizz(i);

	PI[playerid][pBiz] = -1;
	MysqlUpdatePlayerInt(playerid, "business", PI[playerid][pBiz]);
	fLogs("[biz] %s -%i /sellbiz [%i]", GetName(playerid), i, BizzInfo[i][bPrice]/2);

	new accountid = PI[playerid][pMainBankAccount];
	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "У Вас не установлен основной банковский счёт");

	g_player_bank_accounts[playerid][accountid][B_BALANCE] += BizzInfo[i][bBuyPrice];
	g_player_bank_accounts[playerid][accountid][B_BALANCE] += BizzInfo[i][bMoney];

	format(stringer1, sizeof stringer1, "+ Продажа бизнеса %d рублей", BizzInfo[i][bBuyPrice]);
	SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
	UpdateBankMoneyText(playerid, accountid);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
	mysql_tquery(db_prod, STRING_GLOBAL);
	return 1;
}
DLG(125, playerid, response, listitem, inputtext[])
{
	new targetid = PlayerMarriage[playerid];
	if(response)
	{
		format(string, sizeof(string), "%s и %s вступили в брак", GetName(targetid), GetName(playerid));
		SendClientMessageToAll(COLOR_PURPLE, string);
		strmid(PI[playerid][pWhoMarried], GetName(targetid), 0, strlen(GetName(targetid)), MAX_PLAYER_NAME);
		strmid(PI[targetid][pWhoMarried], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
		PI[playerid][pMarried] = PI[targetid][pMarried] = 1;

		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET married=1, whomarried='%s' WHERE id=%d", PI[playerid][pWhoMarried], PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1);

		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET married=1, whomarried='%s' WHERE id=%d", PI[targetid][pWhoMarried], PI[targetid][pID]);
		mysql_tquery(db_prod, stringer1);

		SendMes(playerid, COLOR_YELLOW, "Вы приняли предложение связать судьбу с %s", GetName(targetid));
		if(PI[playerid][pSex] == 1) SendMes(targetid, COLOR_GREEN, "%s принял предложение связать судьбу с вами", GetName(playerid));
		else SendMes(targetid, COLOR_GREEN, "%s приняла предложение связать судьбу с вами", GetName(playerid));
	}
	else
	{
		if(PI[playerid][pSex] == 1) SendMes(targetid, COLOR_RED, "%s отклонил предложение связать судьбу с вами", GetName(playerid));
		else SendMes(targetid, COLOR_RED, "%s отклонила предложение связать судьбу с вами", GetName(playerid));
	}
	PlayerMarriage[playerid] = INVALID_PLAYER_ID;
	return 1;
}
