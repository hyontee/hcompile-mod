	case 4:
		{
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выпил абсент 'София'");
			else MeAction(playerid, "выпила абсент 'София'");
			if(amount+20.0 > 100)
			{
				SetPlayerHealth(playerid, 100);
				SendClientMessage(playerid, COLOR_WHITE, "Вы полностью напились!");
			}
			else GiveHealth(playerid, 20);
			if(GetPlayerDrunkLevel(playerid) < 20000) SetPlayerDrunkLevel(playerid,GetPlayerDrunkLevel(playerid)+2000);
		}
	}
	return 1;
}
DLG(18239, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][pAdmin] && !g_player_full_access[playerid])
			return SendClientMessage(playerid, COLOR_RED, "Администраторам запрещено участвовать в мероприятиях");

			if(fights_player_status[playerid]) return SendClientMessage(playerid, COLOR_RED, "Вы являетесь участником боя, поэтому Вам недоступно данное меню");
			if(!strcmp(fights_player[0],"None",true))
			{
				fights_player_status[playerid] = true;
				strmid(fights_player[0], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
				SendClientMessage(playerid, COLOR_GREEN, "Вы зарегистрировались на бой в качестве 1-го номера");
				UpdateFightsText();
				fights_count_players ++;
			}
			else if(!strcmp(fights_player[1],"None",true))
			{
				fights_player_status[playerid] = true;
				strmid(fights_player[1], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
				SendClientMessage(playerid, COLOR_GREEN, "Вы зарегистрировались на бой в качестве 2-го номера");
				UpdateFightsText();
				fights_count_players ++;
			}
			else SendClientMessage(playerid, COLOR_RED, "К сожалению все участники на этот бой уже набраны, ожидайте другой..");
		}
	case 1:
		{
			if(!fights_player_status[playerid]) return SendClientMessage(playerid, COLOR_RED, "Вы не являетесь участником боя, поэтому Вам недоступно данное меню");

			for(new idx; idx < 2; idx++)
			{
				if(!strcmp(fights_player[idx], GetName(playerid), true))
				{
					strmid(fights_player[idx], "None", 0, strlen("None"), 5);
					SendClientMessage(playerid, COLOR_RED, "Вы соскочили с боя и заплатили штраф в размере 100.000 рублей");
					SetPlayerMoney(playerid, -100000);
					fights_player_status[playerid] = false;
				}
			}
			UpdateFightsText();
		}
	case 2:
		{
			if(!fights_status_s) return SendClientMessage(playerid, COLOR_RED, "Прием ставок закрыт");
			if(fights_player_status[playerid]) return SendClientMessage(playerid, COLOR_RED, "Участники 'мордобоя' не могут делать ставки на себя");
			if(fights_money[playerid]) return SendClientMessage(playerid, COLOR_RED, "Вы уже сделали ставку, ожидайте исхода события..");

			global_string = "";

			format
			(
			global_string,
			350,
			""cWH"В данном окне Вы можете сделать ставку на одного из бойцов:\n\n\
					Боец №1: {4ed74d}%s\n\
					"cWH"Боец №2: {4ed74d}%s\n\n\
					{f7ff00}В случае победы Вашего бойца, Вы получите на счет удвоенную сумму Вашей ставки\n\
					Например: поставили 100.000 руб - получили 200.000 руб\n\
					Минимальная ставка: 10.000 рублей, максимальная: 1.000.000 рублей\n\n\
					Сделайте Вашу ставку:", fights_player[0], fights_player[1]
			);

			ShowPlayerDialog(playerid, 18239+1, DIALOG_STYLE_INPUT, ""cMain"Укажите сумму ставки:", global_string, "Указать", "Отмена");
		}
	}
	return 1;
}
DLG(18240, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new count, id;

	if(sscanf(inputtext, "p<,>ii", id, count))
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
		"cWH"В данном окне Вы можете сделать ставку на одного из бойцов:\n\n\
		"cWH"Боец №1: {4ed74d}%s\n\
		"cWH"Боец №2: {4ed74d}%s\n\n\
		{f7ff00}В случае победы Вашего бойца, Вы получите на счет удвоенную сумму Вашей ставки\n\
		Например: поставили 100.000 руб - получили 200.000 руб\n\
		Минимальная ставка: 10.000 рублей, максимальная: 1.000.000 рублей\n\n\
		Пример: 1, 10000", fights_player[0], fights_player[1]);
		ShowPlayerDialog(playerid, 18239+1, DIALOG_STYLE_INPUT, ""cMain"Укажите сумму ставки:", global_string, "Указать", "Отмена");
		SendClientMessage(playerid, COLOR_RED, "Указаны неверные параметры");
		return 0x1;
	}
	if(id <= 0 || id >= 3)
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
		"cWH"В данном окне Вы можете сделать ставку на одного из бойцов:\n\n\
		"cWH"Боец №1: {4ed74d}%s\n\
		"cWH"Боец №2: {4ed74d}%s\n\n\
		{f7ff00}В случае победы Вашего бойца, Вы получите на счет удвоенную сумму Вашей ставки\n\
		Например: поставили 100.000 руб - получили 200.000 руб\n\
		Минимальная ставка: 10.000 рублей, максимальная: 1.000.000 рублей\n\n\
		Пример: 1, 10000", fights_player[0], fights_player[1]);
		ShowPlayerDialog(playerid, 18239+1, DIALOG_STYLE_INPUT, ""cMain"Укажите сумму ставки:", global_string, "Указать", "Отмена");
		SendClientMessage(playerid, COLOR_RED, "Указаны неверные параметры");
		return 0x1;
	}

	if(!strcmp(fights_player[id-1], "None"))
	return SendClientMessage(playerid, COLOR_RED, "Участник ещё не зарегистрирован.");

	if(GetPlayerRubble(playerid) < count) return SendClientMessage(playerid, COLOR_RED, "У Вас нет таких средств на счету");
	if(!(10000 <= count <= 1000000)) return SendClientMessage(playerid, COLOR_RED, "Нельзя поставить на бойца менее 10.000 и не более 1.000.000 руб");

	if(fights_duel) return SendClientMessage(playerid, COLOR_RED, "Бой уже идёт ;)");

	SetPlayerMoney(playerid, -count);
	fights_bank += count;

	fights_money[playerid] += count;
	fights_player_p[playerid] = id-1;
	SendMes(playerid, COLOR_GREEN, "Вы поставили на игрока %s сумму в размере %d руб", fights_player[id-1], count);
	return 1;
}
DLG(6243, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][YachtID] == INVALID_VEHICLE_ID)
			{
				global_string = "";
				mysql_format(db_prod, global_string, 128, "SELECT * FROM `yacht` WHERE y_owner = '%s'", GetName(playerid));
				mysql_tquery(db_prod, global_string, "LoadYacht", "i", playerid);
			}
			else
			{
				if(PI[playerid][YachtID] != INVALID_VEHICLE_ID)
				{
					DestroyYacht(playerid);
					SendClientMessage(playerid, COLOR_RED, "Яхта выгружена с сервера");
				}
			}
		}
	case 1:
		{
			if(PI[playerid][YachtID] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Ваша яхта не загружена на сервер");

			new Float: pos[3], locname[30];

			GetVehiclePos(PI[playerid][YachtID], pos[0], pos[1], pos[2]);
			locname = "Личная яхта";
			GPSPlayer_(playerid, pos[0],pos[1],pos[2], locname);
		}
	case 2:
		{
			if(PI[playerid][YachtID] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Ваша яхта не загружена на сервер");
			if(GetPlayerVehicleID(playerid) != PI[playerid][YachtID]) return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своей яхте");

			new Float:pos[4];
			GetVehiclePos(GetPlayerVehicleID(playerid), pos[0],pos[1],pos[2]);
			GetVehicleZAngle(GetPlayerVehicleID(playerid), pos[3]);

			if(pos[2] > 1.0) return SCM(playerid, -1, "Парковать лодку можно только на воде");

			Y_DATA[playerid][y_x] = pos[0];
			Y_DATA[playerid][y_y] = pos[1];
			Y_DATA[playerid][y_z] = pos[2];
			Y_DATA[playerid][y_r] = pos[3];

			SendClientMessage(playerid, COLOR_GREEN, "Теперь Ваша яхта будет появляться в этом месте");
			SaveYacht(playerid);
		}
	case 3:
		{
			if(PI[playerid][YachtID] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Ваша яхта не загружена на сервер");
			if(GetPlayerVehicleID(playerid) != PI[playerid][YachtID]) return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своей яхте");
			ShowPlayerDialog(playerid, 6243+1, DIALOG_STYLE_MSGBOX, ""cMain"Продажа яхты", ""cWH"Вы действительно хотите продать свою яхту государству за пол цены?", "Да", "Нет");
		}
	case 4:
		{
			if(PI[playerid][YachtID] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Ваша яхта не загружена на сервер");
			if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится в вертолете!");
			if(GetPlayerVehicleID(playerid) != PI[playerid][YachtID]) return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своем вертолете");

			if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 12)
				return SendClientMessage(playerid, COLOR_RED, "Вам нужно отыграть 12 часов для продажи яхты");

			ShowPlayerDialog(playerid, 6243+2, DIALOG_STYLE_INPUT, ""cMain"Продажа яхты игроку", ""cWH"Укажите ниже ID игрока, которому хотите продать яхту и цену через запятую:\nПример: 38, 10000000", "Далее", "Отмена");
		}
	}
	return 1;
}
DLG(6244, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	if(GetPlayerVehicleID(playerid) == PI[playerid][YachtID])
	{
		SendMes(playerid, COLOR_GREEN, "Вы успешно продали яхту государству. На Ваш счет зачислено: %d рублей", Y_DATA[playerid][y_price] / 2);
		SetPlayerMoney(playerid, Y_DATA[playerid][y_price] / 2);
		fLogs("[cars] %s -%i /sellcar гос", GetName(playerid), Y_DATA[playerid][y_model]);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `yacht` WHERE `y_owner` = '%e'", GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");

		DestroyYacht(playerid);
	}
	else SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своей яхте");
	return 1;
}
DLG(6245, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new sell_id, sell_price;

	if(sscanf(inputtext, "p<,>ii", sell_id, sell_price) || !(0 <= sell_price <= 999999999))
	{
		SendClientMessage(playerid, COLOR_RED, "Указаны неверные параметры. Укажите ID игрока и цену через запятую");
		ShowPlayerDialog(playerid, 6243+2, DIALOG_STYLE_INPUT, ""cMain"Продажа яхты игроку", ""cWH"Укажите ниже ID игрока, которому хотите продать яхту и цену через запятую:\nПример: 38, 10000000", "Далее", "Отмена");
		return 1;
	}

	if(!IsPlayerConnected(sell_id)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[sell_id] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(sell_id == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете продать яхту себе!");

	if(PI[sell_id][pLevel] == BONUS_LVL && PI[sell_id][pExp] < 12)
		return SendClientMessage(playerid, COLOR_RED, "Игроку требуется отыграть 12 часов для совершения продажи");

	SendPlayerProposition(playerid, sell_id, PROPOSITION_TYPE_SELL_YACHT, sell_price, GetVehicleModel(PI[playerid][YachtID]));
	return 1;
}
DLG(18235, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(GetPlayerData(playerid, SalonCarID) != INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Системная ошибка, перезайдите на сервер");

	for(new i; i < 26; i++) TextDrawShowForPlayer(playerid, yacht_td_global[i]);
	PlayerTextDrawShow(playerid, yacht_td_player[playerid]);
	SelectTextDrawEx(playerid, -1);

	pPressed[playerid] = 0;
	YachtColor[playerid] = 0;
	SetPlayerData(playerid, SalonCarID, CreateVehicle(carsY[pPressed[playerid]][0], 2863.3843, -1537.6000, -0.4076, 90.0000, YachtColor[playerid], -1,10000));
	CarDoorsEx(carsY[pPressed[playerid]][0], 0);

	SetPlayerPos(playerid,2852.3359,-1548.8278,2.0206);
	SetPlayerFacingAngle(playerid,0.0);
	SetPlayerVirtualWorld(playerid, playerid+1);
	SetVehicleVirtualWorld(GetPlayerData(playerid, SalonCarID),playerid+1);
	PutPlayerInVehicle(playerid,GetPlayerData(playerid, SalonCarID),0);
	TogglePlayerControllable(playerid,false);

	SetPlayerCameraPos(playerid, 2850.8933, -1546.1816, 3.5435);
	SetPlayerCameraLookAt(playerid, 2851.6509, -1545.5315, 3.3984);

	format(stringer1, sizeof stringer1, "цена:__~g~%d_рублей", carsY[pPressed[playerid]][1]);
	PlayerTextDrawSetString(playerid, yacht_td_player[playerid], stringer1);

	InShop[playerid] = 2;
	return 1;
}
DLG(3811, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(PhoneInternetStatus[playerid])
			{
				PhoneInternetStatus[playerid] = false;
				SendClientMessage(playerid, -1, ""cDA"Вы выключили передачу данных, интернет больше не работает");
				SetPlayerChatBubble(playerid, "выключил передачу телефонных данных", COLOR_PURPLE, 13.0, 10000);
			}
			else
			{
				PhoneInternetStatus[playerid] = true;
				SendClientMessage(playerid, -1, ""cDA"Вы включили передачу данных. Для использования соц. сети 'ВКонтакте', используйте /soc или /vk");
				SetPlayerChatBubble(playerid, "включил передачу телефонных данных", COLOR_PURPLE, 13.0, 10000);
			}
		}
	case 1:
		{
			if(Phone[playerid])
			{
				Phone[playerid] = false;
				SendClientMessage(playerid, -1, ""cDA"Вы выключили телефон");
				SetPlayerChatBubble(playerid, "выключил телефон", COLOR_PURPLE, 13.0, 10000);
				if(Mobile[playerid] != -1) MobileCrash(playerid);
			}
		}
	}
	return 1;
}
DLG(18225, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0: mysql_tquery(db_prod, "SELECT `id` FROM `house` WHERE hOwner = 'None' and hRublevka = '0'", "ShowRieltorHouse", "i", playerid);
	case 1: mysql_tquery(db_prod, "SELECT `id` FROM `bizz` WHERE owner = 'None'", "ShowRieltorBizz", "i", playerid);
	}
	return 1;
}
DLG(18229, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new bizz_id = GetPlayerListitemValue(playerid, listitem);

	SetPlayerCameraPos(playerid, BizzInfo[bizz_id][bEntrx]-15.0, BizzInfo[bizz_id][bEntry]-15, BizzInfo[bizz_id][bEntrz]+5);
	SetPlayerCameraLookAt(playerid, BizzInfo[bizz_id][bEntrx], BizzInfo[bizz_id][bEntry], BizzInfo[bizz_id][bEntrz]);

	buy_bizz_id[playerid] = bizz_id;

	SetPlayerPos(playerid,BizzInfo[bizz_id][bEntrx]-15.0,BizzInfo[bizz_id][bEntry]-15,BizzInfo[bizz_id][bEntrz]);

	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, playerid);

	TogglePlayerControllable(playerid, 0);

	global_string = "";
	format(global_string, 300, "\
	"cWH"Информация о бизнесе:\n\n\
	Номер бизнеса: {E5D648}№%d\n\
	"cWH"Владелец: {E5D648}государство\n\
	"cWH"Название: {E5D648}%s\n\
	"cWH"Цена: {E5D648}%d рублей\n\
	"cWH"Стоимость аренды в сутки: {E5D648}2000 рублей\n\n\
	"cWH"Для покупки бизнеса, нажмите 'Купить'\n\
	Для отмена покупки, нажмите 'Отмена'", bizz_id, BizzInfo[bizz_id][bName], BizzInfo[bizz_id][bPrice]);
	ShowPlayerDialog(playerid, 18225+5, DIALOG_STYLE_MSGBOX, ""cMain"Покупка бизнеса", global_string, "Купить", "Отмена");
	return 1;
}
DLG(18230, playerid, response, listitem, inputtext[])
{
	if(!response) return ExitRieltorMenu(playerid);

	new idx = buy_bizz_id[playerid];

	if(GetPlayerBizz(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "Вы уже владеете бизнесом!"), ExitRieltorMenu(playerid);
	global_string = "";

	if(!strcmp(BizzInfo[idx][bOwner],"None",true))
	{
		if(PI[playerid][pCash] < BizzInfo[idx][bPrice]) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!"), ExitRieltorMenu(playerid);
		else
		{
			SetPlayerMoney(playerid, -BizzInfo[idx][bPrice]);
			BizzInfo[idx][bBuyPrice] = BizzInfo[idx][bPrice] / 2;
			BizzInfo[idx][bProduct] = 100;
			BizzInfo[idx][bOplata] = 1;
			BizzInfo[idx][bOwned] = PI[playerid][pID];
			BizzInfo[idx][bMoney] = BizzInfo[idx][bBuyPrice] / 8000;
			BizzInfo[idx][bEnter] = 0;
			BizzInfo[idx][bTill] = 50;

			SendMes(playerid, -1, ""cDA"Вы купили бизнес %s за %dр. У вас осталось: %dр", BizzInfo[idx][bName], BizzInfo[idx][bPrice], PI[playerid][pCash]);
			SendClientMessage(playerid, -1, ""cPS"Аренда бизнеса оплачена на 1 день, не забывайте регулярно следить за его балансом.");
			SendInf(playerid, "Введите команду /business для управления бизнесом");

			strmid(BizzInfo[idx][bOwner],GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
			format(global_string, 200, "UPDATE `bizz` SET owner = '%s', `owned` = '%d', buyprice = %d , product = %d, money = %d, oplata = %d WHERE id = '%d' LIMIT 1", BizzInfo[idx][bOwner], BizzInfo[idx][bOwned], BizzInfo[idx][bBuyPrice], BizzInfo[idx][bProduct],BizzInfo[idx][bMoney], BizzInfo[idx][bOplata], idx);
			mysql_tquery(db_prod, global_string, "", "");

			PI[playerid][pBiz] = idx;
			MysqlUpdatePlayerInt(playerid, "business", PI[playerid][pBiz]);

			UpdateBizz(idx);
			ExitRieltorMenu(playerid);
		}
	}
	return 1;
}
DLG(18226, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	buy_house_id[playerid] = GetPlayerListitemValue(playerid, listitem);

	ShowPlayerDialog(playerid, 18225+2, DIALOG_STYLE_LIST, ""cMain"Покупка дома", "1. Посмотреть дом изнутри(интерьер)\n2. Посмотреть дом снаружи", "Далее", "Отмена");
	return 1;
}
DLG(18227, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new house_id = buy_house_id[playerid];

	switch(listitem)
	{
	case 0:
		{

			new class_text[24];

			switch(HouseInfo[house_id][hDiscript])
			{
			case 1: class_text = "Низкий";
			case 2: class_text = "Средний";
			case 3: class_text = "Высокий";
			case 4: class_text = "Элитный";
			}

			for(new idx; idx < 12; idx++) TextDrawShowForPlayer(playerid, td_rieltor[idx]);
			SetPlayerVirtualWorld(playerid, playerid);
			SetPlayerPos(playerid,HouseInfo[house_id][hExitx],HouseInfo[house_id][hExity],HouseInfo[house_id][hExitz]);

			SendMes(playerid, COLOR_GREEN, "Вы посетили дом {F89A47}№%d {63BD4E}для осмотра интерьера", house_id);
			SendClientMessage(playerid, COLOR_GREEN, "Для покупки дома, используйте {F89A47}/buyhouse");
			SendClientMessage(playerid, COLOR_GREEN, "Для возвращения в риелторское агентство, используйте {F89A47}/exithouse");

			PI[playerid][pInHouse] = house_id;

			is_player_in_rieltor_house[playerid] = 1;

			new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, HouseInfo[house_id][hPrice]);

			if(HouseInfo[house_id][hType] == 0)
			{
				global_string = "";
				format(global_string, 300, "\
				"cWH"Информация о доме:\n\n\
				Номер дома: {E5D648}№%d\n\
				"cWH"Владелец: {E5D648}государство\n\
				"cWH"Класс: {E5D648}%s\n\
				"cWH"Стоимость: {E5D648}%d рублей\n\
				"cWH"Стоимость аренды в сутки: {E5D648}%d рублей\n\n\
				"cWH"Для покупки дома, нажмите 'Купить'\n\
				Для отмена покупки, нажмите 'Отмена'", house_id, class_text, price_house, GetHomeOplata(house_id));
			}
			if(HouseInfo[house_id][hType] == 1)
			{
				global_string = "";
				format(global_string, 300, "\
				"cWH"Информация о доме:\n\n\
				Номер дома: {E5D648}№%d\n\
				"cWH"Владелец: {E5D648}государство\n\
				"cWH"Класс: {E5D648}%s\n\
				"cWH"Стоимость: {E5D648}%d евро\n\
				"cWH"Стоимость аренды в сутки: {E5D648}%d рублей\n\n\
				"cWH"Для покупки дома, нажмите 'Купить'\n\
				Для отмена покупки, нажмите 'Отмена'", house_id, class_text, price_house, GetHomeOplata(house_id));
			}
			ShowPlayerDialog(playerid, 000, DIALOG_STYLE_MSGBOX, ""cMain"Информация о доме", global_string, "Закрыть", "");

		}
	case 1:
		{

			new class_text[24];

			SetPlayerCameraPos(playerid, HouseInfo[house_id][hEntrx]-15.0, HouseInfo[house_id][hEntry]-15, HouseInfo[house_id][hEntrz]+5);
			SetPlayerCameraLookAt(playerid, HouseInfo[house_id][hEntrx], HouseInfo[house_id][hEntry], HouseInfo[house_id][hEntrz]);

			TogglePlayerControllable(playerid, 0);

			SetPlayerPos(playerid,HouseInfo[house_id][hEntrx]-15.0,HouseInfo[house_id][hEntry]-15,HouseInfo[house_id][hEntrz]);

			PI[playerid][pInBiz] = house_id;

			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, playerid);

			switch(HouseInfo[house_id][hDiscript])
			{
			case 1: class_text = "Низкий";
			case 2: class_text = "Средний";
			case 3: class_text = "Высокий";
			case 4: class_text = "Элитный";
			}

			new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, HouseInfo[house_id][hPrice]);

			if(HouseInfo[house_id][hType] == 0)
			{
				global_string = "";
				format(global_string, 300, "\
				"cWH"Информация о доме:\n\n\
				Номер дома: {E5D648}№%d\n\
				"cWH"Владелец: {E5D648}государство\n\
				"cWH"Класс: {E5D648}%s\n\
				"cWH"Стоимость: {E5D648}%d рублей\n\
				"cWH"Стоимость аренды в сутки: {E5D648}%d рублей\n\n\
				"cWH"Для покупки дома, нажмите 'Купить'\n\
				Для отмена покупки, нажмите 'Отмена'", house_id, class_text, price_house, GetHomeOplata(house_id));
			}
			if(HouseInfo[house_id][hType] == 1)
			{
				global_string = "";
				format(global_string, 300, "\
				"cWH"Информация о доме:\n\n\
				Номер дома: {E5D648}№%d\n\
				"cWH"Владелец: {E5D648}государство\n\
				"cWH"Класс: {E5D648}%s\n\
				"cWH"Стоимость: {E5D648}%d евро\n\
				"cWH"Стоимость аренды в сутки: {E5D648}%d рублей\n\n\
				"cWH"Для покупки дома, нажмите 'Купить'\n\
				Для отмена покупки, нажмите 'Отмена'", house_id, class_text, price_house, GetHomeOplata(house_id));
			}
			ShowPlayerDialog(playerid, 18225+3, DIALOG_STYLE_MSGBOX, ""cMain"Покупка дома", global_string, "Купить", "Отмена");
		}
	}
	return 1;
}
DLG(18228, playerid, response, listitem, inputtext[])
{
	if(!response) return ExitRieltorMenu(playerid);

	new idx = buy_house_id[playerid];

	if(!strcmp(HouseInfo[idx][hOwner], "None", true))
	{
		new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, HouseInfo[idx][hPrice]);
		if(HouseInfo[idx][hType] == 0)
		{
			if(PI[playerid][pCash] < price_house) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!"), ExitRieltorMenu(playerid);
			if(GetPlayerHouse(playerid) != 0) return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом!"), ExitRieltorMenu(playerid);
			if(GetPlayerRooms(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира!"), ExitRieltorMenu(playerid);

			SetPlayerMoney(playerid, -price_house);
			HouseInfo[idx][hBuyPrice] = HouseInfo[idx][hPrice]/2;
			HouseInfo[idx][hOplata] = 1;
			HouseInfo[idx][hLock] = 1;
			HouseInfo[idx][hOwned] = PI[playerid][pID];
			SendMes(playerid, -1, ""cDA"Вы купили дом за %dр. У вас осталось: %dр", price_house, PI[playerid][pCash]);
			SendClientMessage(playerid, -1, ""cPS"Аренда Вашего дома оплачена на 1 день. Рекомендуем оплатить дом в любом банке города");
			SendMes(playerid, -1, ""cPS"Стоимость кварплаты для вашего дома будет составлять %dр в день",GetHomeOplata(idx));
			SendClientMessage(playerid, COLOR_YELLOW, "Спасибо за то, что воспользовались услугами нашего агентства! Будем рады видеть Вас снова!");
			strmid(HouseInfo[idx][hOwner], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
			global_string = "";
			format(global_string, 200, "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hOplata = %d, buyprice = %d, hLock = %d WHERE id = '%d' LIMIT 1", HouseInfo[idx][hOwner], HouseInfo[idx][hOwned], HouseInfo[idx][hOplata], HouseInfo[idx][hBuyPrice], HouseInfo[idx][hLock], idx);
			mysql_tquery(db_prod, global_string, "", "");
			PI[playerid][pSpawnChange] = 1;

			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=1, house=%d WHERE id=%d", idx, PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1);

			PI[playerid][pHouse] = idx;
			UpdateHouse(idx);
			ExitRieltorMenu(playerid);
			fLogs("[house] %s +%i покупка", GetName(playerid), idx);
			return 1;
		}
		if(HouseInfo[idx][hType] == 1)
		{
			if(playerEuro[playerid] < price_house) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!"), ExitRieltorMenu(playerid);
			if(GetPlayerHouse(playerid) != 0) return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом!"), ExitRieltorMenu(playerid);
			if(GetPlayerRooms(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира!"), ExitRieltorMenu(playerid);

			TransferEuro(playerid, -1, price_house, "Покупка дома");
			HouseInfo[idx][hBuyPrice] = HouseInfo[idx][hPrice]/2;
			HouseInfo[idx][hOplata] = 1;
			HouseInfo[idx][hLock] = 1;
			HouseInfo[idx][hOwned] = PI[playerid][pID];
			SendMes(playerid, -1, ""cDA"Вы купили дом за %dевро. У вас осталось: %d евро", price_house, playerEuro[playerid]);
			SendClientMessage(playerid, -1, ""cPS"Аренда Вашего дома оплачена на 1 день. Рекомендуем оплатить дом в любом банке города");
			SendMes(playerid, -1, ""cPS"Стоимость кварплаты для вашего дома будет составлять %dр в день",GetHomeOplata(idx));
			SendClientMessage(playerid, COLOR_YELLOW, "Спасибо за то, что воспользовались услугами нашего агентства! Будем рады видеть Вас снова!");
			strmid(HouseInfo[idx][hOwner], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
			global_string = "";
			format(global_string, 200, "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hOplata = %d, buyprice = %d, hLock = %d WHERE id = '%d' LIMIT 1", HouseInfo[idx][hOwner], HouseInfo[idx][hOwned], HouseInfo[idx][hOplata], HouseInfo[idx][hBuyPrice], HouseInfo[idx][hLock], idx);
			mysql_tquery(db_prod, global_string, "", "");
			PI[playerid][pSpawnChange] = 1;

			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=1, house=%d WHERE id=%d", idx, PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1);

			PI[playerid][pHouse] = idx;
			UpdateHouse(idx);
			ExitRieltorMenu(playerid);
			fLogs("[house] %s +%i покупка", GetName(playerid), idx);
			return 1;
		}
	}

	buy_house_id[playerid] = -1;
	return 1;
}
DLG(6677, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	ShowPlayerDialog
	(
	playerid,
	6677+1,
	DIALOG_STYLE_LIST,
	""cMain"Управление багажником",
	"1. Положить/взять патроны из багажника\n\
			2. Положить/взять наркотики из багажника\n\
			3. Положить/взять деньги из багажника\n\
			4. Положить/взять канистры из багажника\n\
			5. Положить/взять оружие из багажника\n\
			{66C7E7}- Информация по багажнику",
	"Далее", "Отмена"
	);
	return 1;
}
DLG(6678, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::trunk(playerid);

	switch(listitem)
	{
	case 0: ShowPlayerDialog(playerid, 6677+2, DIALOG_STYLE_INPUT, ""cMain"Багажник | Патроны", ""cWH"В данном окне Вы сможете положить или взять патроны из багажника\nУкажите действие положить(1) или взять(2) и кол-во патронов(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	case 1: ShowPlayerDialog(playerid, 6677+3, DIALOG_STYLE_INPUT, ""cMain"Багажник | Наркотики", ""cWH"В данном окне Вы сможете положить или взять наркотики из багажника\nУкажите действие положить(1) или взять(2) и кол-во наркотиков(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	case 2: ShowPlayerDialog(playerid, 6677+4, DIALOG_STYLE_INPUT, ""cMain"Багажник | Деньги", ""cWH"В данном окне Вы сможете положить или взять деньги из багажника\nУкажите действие положить(1) или взять(2) и кол-во денег(через запятую)\nПример: 2, 200000\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	case 3: ShowPlayerDialog(playerid, 6677+5, DIALOG_STYLE_INPUT, ""cMain"Багажник | Канистры", ""cWH"В данном окне Вы сможете положить или взять канистры из багажника\nУкажите действие положить(1) или взять(2)\nПример: 1\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	case 4: ShowPlayerDialog(playerid, 6677+6, DIALOG_STYLE_INPUT, ""cMain"Багажник | Оружие", ""cWH"В данном окне Вы сможете положить или взять оружие из багажника\nУкажите действие положить(1) или взять(2) и номер оружия в багажнике(от 1 до 3)\nПример: 1, 3\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	case 5:
		{
			ShowPlayerDialog
			(
			playerid,
			6677+7,
			DIALOG_STYLE_MSGBOX,
			""cMain"Багажник | Информация",
			"\
					"cWH"Вместимость багажника:\n\n\
					"cWH"Патроны: \t{E0EB1B}1000 шт.\n\
					"cWH"Наркотики: \t{E0EB1B}350 гр.\n\
					"cWH"Деньги: \t{E0EB1B}10.000.000 руб.\n\
					"cWH"Канистры: \t{E0EB1B}3 шт.\n\
					"cWH"Оружие: \t{E0EB1B}3 оружия\n\n\
					"cWH"Для возвращения в меню багажника, нажмите 'Назад'",
			"Назад", ""
			);
		}
	}
	return 1;
}
DLG(6683, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::trunk(playerid);
	new list, n;

	if(sscanf(inputtext, "p<,>ii", list, n)) ShowPlayerDialog(playerid, 6677+6, DIALOG_STYLE_INPUT, ""cMain"Багажник | Оружие", ""cWH"В данном окне Вы сможете положить или взять оружие из багажника\nУкажите действие положить(1) или взять(2) и номер оружия в багажнике(от 1 до 3)\nПример: 1, 3\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(!n || !list) return ShowPlayerDialog(playerid, 6677+6, DIALOG_STYLE_INPUT, ""cMain"Багажник | Оружие", ""cWH"В данном окне Вы сможете положить или взять оружие из багажника\nУкажите действие положить(1) или взять(2) и номер оружия в багажнике(от 1 до 3)\nПример: 1, 3\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if((list < 1 || list > 2) || (n < 1 || n > 3)) return ShowPlayerDialog(playerid, 6677+6, DIALOG_STYLE_INPUT, ""cMain"Багажник | Оружие", ""cWH"В данном окне Вы сможете положить или взять оружие из багажника\nУкажите действие положить(1) или взять(2) и номер оружия в багажнике(от 1 до 3)\nПример: 1, 3\n\nУкажите действие в строчку ниже:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Неверные параметры");

	switch(list)
	{
	case 1:
		{
			if(C_DATA[playerid][c_trunk_gun][n-1] != 0) return ShowPlayerDialog(playerid, 6677+6, DIALOG_STYLE_INPUT, ""cMain"Багажник | Оружие", ""cWH"В данном окне Вы сможете положить или взять оружие из багажника\nУкажите действие положить(1) или взять(2) и номер оружия в багажнике(от 1 до 3)\nПример: 1, 3\n\nУкажите действие в строчку ниже:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Данное место под оружие занято");

			if(!GetPlayerWeapon(playerid)) return ShowPlayerDialog(playerid, 6677+6, DIALOG_STYLE_INPUT, ""cMain"Багажник | Оружие", ""cWH"В данном окне Вы сможете положить или взять оружие из багажника\nУкажите действие положить(1) или взять(2) и номер оружия в багажнике(от 1 до 3)\nПример: 1, 3\n\nУкажите действие в строчку ниже:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Возьмите в руки оружие, которое необходимо положить в багажник");

			new
				weap = GetPlayerWeapon(playerid);

			if(weap != 23 && weap != 24 && weap != 25 && weap != 29 && weap != 30 && weap != 31 && weap != 33)
				return SendErr(playerid, "Нельзя положить данное оружие");

			C_DATA[playerid][c_trunk_gun][n-1] = GetPlayerWeapon(playerid);

			RemovePlayerWeapon(playerid, GetPlayerWeapon(playerid));

			SendMes(playerid, COLOR_GREEN, "Вы положили в багажник '%s'. Для взаимодействие: /trunk", GunNames[C_DATA[playerid][c_trunk_gun][n-1]]);

			SaveTrunkCar(playerid);

		}
	case 2:
		{
			if(!C_DATA[playerid][c_trunk_gun][n-1]) return ShowPlayerDialog(playerid, 6677+6, DIALOG_STYLE_INPUT, ""cMain"Багажник | Оружие", ""cWH"В данном окне Вы сможете положить или взять оружие из багажника\nУкажите действие положить(1) или взять(2) и номер оружия в багажнике(от 1 до 3)\nПример: 1, 3\n\nУкажите действие в строчку ниже:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Оружие отсутствует");

			GivePlayerWeapon(playerid, C_DATA[playerid][c_trunk_gun][n-1], 1);

			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника '%s'", GunNames[C_DATA[playerid][c_trunk_gun][n-1]]);

			C_DATA[playerid][c_trunk_gun][n-1] = 0;

			SaveTrunkCar(playerid);

		}
	}
	return 1;
}
DLG(6679, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::trunk(playerid);

	new n, count;

	if(sscanf(inputtext, "p<,>ii", n, count)) return ShowPlayerDialog(playerid, 6677+2, DIALOG_STYLE_INPUT, ""cMain"Багажник | Патроны", ""cWH"В данном окне Вы сможете положить или взять патроны из багажника\nУкажите действие положить(1) или взять(2) и кол-во патронов(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(!n) return ShowPlayerDialog(playerid, 6677+2, DIALOG_STYLE_INPUT, ""cMain"Багажник | Патроны", ""cWH"В данном окне Вы сможете положить или взять патроны из багажника\nУкажите действие положить(1) или взять(2) и кол-во патронов(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(n < 1 || n > 2) return ShowPlayerDialog(playerid, 6677+2, DIALOG_STYLE_INPUT, ""cMain"Багажник | Патроны", ""cWH"В данном окне Вы сможете положить или взять патроны из багажника\nУкажите действие положить(1) или взять(2) и кол-во патронов(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");

	switch(n)
	{

	case 1:
		{
			if(!count) return ShowPlayerDialog(playerid, 6677+2, DIALOG_STYLE_INPUT, ""cMain"Багажник | Патроны", ""cWH"В данном окне Вы сможете положить или взять патроны из багажника\nУкажите действие положить(1) или взять(2) и кол-во патронов(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
			if((count + C_DATA[playerid][c_trunk][0]) > 1000) return ShowPlayerDialog(playerid, 6677+2, DIALOG_STYLE_INPUT, ""cMain"Багажник | Патроны", ""cWH"В данном окне Вы сможете положить или взять патроны из багажника\nУкажите действие положить(1) или взять(2) и кол-во патронов(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Багажник не может вместить более 1000 патронов");

			new ok = SearchInventoryItem(playerid, 42);

			if(!ok) return SendErr(playerid, "У вас нет предмета");
			if(PlayerItem2[playerid][ok]<count)return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько патронов");
			if(!PlayerItem2[playerid][ok]) PlayerItem1[playerid][ok]=0;

			C_DATA[playerid][c_trunk][0] += count;
			PlayerItem2[playerid][ok] -= count;
			SendMes(playerid, COLOR_GREEN, "Вы положили в багажник %d патронов, теперь в нем %d патронов", count, C_DATA[playerid][c_trunk][0]);
			UpDateInv(playerid);
			SaveItem(playerid,ok);
			SaveTrunkCar(playerid);
		}
	case 2:
		{
			if(!count || count > C_DATA[playerid][c_trunk][0]) return ShowPlayerDialog(playerid, 6677+2, DIALOG_STYLE_INPUT, ""cMain"Багажник | Патроны", ""cWH"В данном окне Вы сможете положить или взять патроны из багажника\nУкажите действие положить(1) или взять(2) и кол-во патронов(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");

			new newslot;
			if(CheckMaxVes(playerid,42,count,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
			PlayerItem1[playerid][newslot]=42;
			PlayerItem2[playerid][newslot] += count;
			C_DATA[playerid][c_trunk][0] -= count;
			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника %d патронов, теперь в нем %d патронов", count, C_DATA[playerid][c_trunk][0]);
			SaveItem(playerid,newslot);
			SaveTrunkCar(playerid);
		}
	}
	return 1;
}
DLG(6680, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::trunk(playerid);

	new n, count;

	if(sscanf(inputtext, "p<,>ii", n, count)) return ShowPlayerDialog(playerid, 6677+3, DIALOG_STYLE_INPUT, ""cMain"Багажник | Наркотики", ""cWH"В данном окне Вы сможете положить или взять наркотики из багажника\nУкажите действие положить(1) или взять(2) и кол-во наркотиков(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(!n) return ShowPlayerDialog(playerid, 6677+3, DIALOG_STYLE_INPUT, ""cMain"Багажник | Наркотики", ""cWH"В данном окне Вы сможете положить или взять наркотики из багажника\nУкажите действие положить(1) или взять(2) и кол-во наркотиков(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(n < 1 || n > 2) return ShowPlayerDialog(playerid, 6677+3, DIALOG_STYLE_INPUT, ""cMain"Багажник | Наркотики", ""cWH"В данном окне Вы сможете положить или взять наркотики из багажника\nУкажите действие положить(1) или взять(2) и кол-во наркотиков(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");

	switch(strval(inputtext))
	{

	case 1:
		{
			if(!count) return ShowPlayerDialog(playerid, 6677+3, DIALOG_STYLE_INPUT, ""cMain"Багажник | Наркотики", ""cWH"В данном окне Вы сможете положить или взять наркотики из багажника\nУкажите действие положить(1) или взять(2) и кол-во наркотиков(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
			if((count + C_DATA[playerid][c_trunk][2]) > 350) return ShowPlayerDialog(playerid, 6677+3, DIALOG_STYLE_INPUT, ""cMain"Багажник | Наркотики", ""cWH"В данном окне Вы сможете положить или взять наркотики из багажника\nУкажите действие положить(1) или взять(2) и кол-во наркотиков(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Багажник не может вместить более 350 наркотиков");

			new ok = SearchInventoryItem(playerid, 44);
			if(!ok) return SendErr(playerid, "У вас этого предмета");
			if(PlayerItem2[playerid][ok]<strval(inputtext))return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько наркотиков");
			if(PlayerItem2[playerid][ok] == 0)
			{
				PlayerItem1[playerid][ok]=0;
			}
			C_DATA[playerid][c_trunk][2] += count;
			PlayerItem2[playerid][ok] -= count;
			SendMes(playerid, COLOR_GREEN, "Вы положили в багажник %d наркотиков, теперь в нем %d наркотиков", count, C_DATA[playerid][c_trunk][2]);
			UpDateInv(playerid);
			SaveItem(playerid,ok);
			SaveTrunkCar(playerid);
		}
	case 2:
		{
			if(!count || count > C_DATA[playerid][c_trunk][2]) return ShowPlayerDialog(playerid, 6677+3, DIALOG_STYLE_INPUT, ""cMain"Багажник | Наркотики", ""cWH"В данном окне Вы сможете положить или взять наркотики из багажника\nУкажите действие положить(1) или взять(2) и кол-во наркотиков(через запятую)\nПример: 1, 200\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");

			new newslot;
			if(CheckMaxVes(playerid,44,count,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
			PlayerItem1[playerid][newslot]=44;
			PlayerItem2[playerid][newslot] += count;
			C_DATA[playerid][c_trunk][2] -= count;
			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника %d наркотиков, теперь в нем %d наркотиков", count, C_DATA[playerid][c_trunk][2]);
			SaveItem(playerid,newslot);
			SaveTrunkCar(playerid);
		}
	}
	return 1;
}
DLG(6681, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::trunk(playerid);

	new n, count;

	if(sscanf(inputtext, "p<,>ii", n, count) || !(0 <= count <= 999999999)) return ShowPlayerDialog(playerid, 6677+4, DIALOG_STYLE_INPUT, ""cMain"Багажник | Деньги", ""cWH"В данном окне Вы сможете положить или взять деньги из багажника\nУкажите действие положить(1) или взять(2) и кол-во денег(через запятую)\nПример: 2, 200000\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(!n) return ShowPlayerDialog(playerid, 6677+4, DIALOG_STYLE_INPUT, ""cMain"Багажник | Деньги", ""cWH"В данном окне Вы сможете положить или взять деньги из багажника\nУкажите действие положить(1) или взять(2) и кол-во денег(через запятую)\nПример: 2, 200000\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(n < 1 || n > 2) return ShowPlayerDialog(playerid, 6677+4, DIALOG_STYLE_INPUT, ""cMain"Багажник | Деньги", ""cWH"В данном окне Вы сможете положить или взять деньги из багажника\nУкажите действие положить(1) или взять(2) и кол-во денег(через запятую)\nПример: 2, 200000\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");

	switch(n)
	{

	case 1:
		{
			if(!count) return ShowPlayerDialog(playerid, 6677+4, DIALOG_STYLE_INPUT, ""cMain"Багажник | Деньги", ""cWH"В данном окне Вы сможете положить или взять деньги из багажника\nУкажите действие положить(1) или взять(2) и кол-во денег(через запятую)\nПример: 2, 200000\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
			if((count + C_DATA[playerid][c_trunk][3]) > 10000000) return ShowPlayerDialog(playerid, 6677+4, DIALOG_STYLE_INPUT, ""cMain"Багажник | Деньги", ""cWH"В данном окне Вы сможете положить или взять деньги из багажника\nУкажите действие положить(1) или взять(2) и кол-во денег(через запятую)\nПример: 2, 200000\n\nУкажите действие в строчку ниже:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Багажник не может вместить более 10кк денег");

			if(GetPlayerRubble(playerid) < count)return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько денег");

			C_DATA[playerid][c_trunk][3] += count;
			SetPlayerMoney(playerid, -count);
			SendMes(playerid, COLOR_GREEN, "Вы положили в багажник %d денег, теперь в нем %d денег", count, C_DATA[playerid][c_trunk][3]);
			UpDateInv(playerid);
			SaveTrunkCar(playerid);
		}
	case 2:
		{
			if(!count || count > C_DATA[playerid][c_trunk][3]) return ShowPlayerDialog(playerid, 6677+4, DIALOG_STYLE_INPUT, ""cMain"Багажник | Деньги", ""cWH"В данном окне Вы сможете положить или взять деньги из багажника\nУкажите действие положить(1) или взять(2) и кол-во денег(через запятую)\nПример: 2, 200000\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");

			SetPlayerMoney(playerid, count);
			C_DATA[playerid][c_trunk][3] -= count;
			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника %d рублей, теперь в нем %d рублей", count, C_DATA[playerid][c_trunk][3]);
			SaveTrunkCar(playerid);
		}
	}
	return 1;
}
DLG(6682, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::trunk(playerid);

	new n;

	if(sscanf(inputtext, "p<,>i", n)) return ShowPlayerDialog(playerid, 6677+5, DIALOG_STYLE_INPUT, ""cMain"Багажник | Канистры", ""cWH"В данном окне Вы сможете положить или взять канистры из багажника\nУкажите действие положить(1) или взять(2)\nПример: 1\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(!n) return ShowPlayerDialog(playerid, 6677+5, DIALOG_STYLE_INPUT, ""cMain"Багажник | Канистры", ""cWH"В данном окне Вы сможете положить или взять канистры из багажника\nУкажите действие положить(1) или взять(2)\nПример: 1\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");
	if(n < 1 || n > 2) return ShowPlayerDialog(playerid, 6677+5, DIALOG_STYLE_INPUT, ""cMain"Багажник | Канистры", ""cWH"В данном окне Вы сможете положить или взять канистры из багажника\nУкажите действие положить(1) или взять(2)\nПример: 1\n\nУкажите действие в строчку ниже:", "Далее", "Отмена");

	switch(n)
	{

	case 1:
		{
			if(C_DATA[playerid][c_trunk][1] >= 3) return ShowPlayerDialog(playerid, 6677+5, DIALOG_STYLE_INPUT, ""cMain"Багажник | Канистры", ""cWH"В данном окне Вы сможете положить или взять канистры из багажника\nУкажите действие положить(1) или взять(2)\nПример: 1\n\nУкажите действие в строчку ниже:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Багажник не может вместить более 3-х канистр");

			new ok = SearchInventoryItem(playerid, 49);
			if(ok==0){return SendClientMessage(playerid, COLOR_GREY, "У вас нет канистры, купите её на заправочной станции!");}

			if(PlayerItem2[playerid][ok] == 0)
			{
				PlayerItem1[playerid][ok]=0;
			}
			PlayerItem2[playerid][ok]--;

			C_DATA[playerid][c_trunk][1]++;
			SendMes(playerid, COLOR_GREEN, "Вы положили в багажник канистру, теперь в нем %d канистр", C_DATA[playerid][c_trunk][1]);
			UpDateInv(playerid);
			SaveItem(playerid,ok);
			SaveTrunkCar(playerid);
		}
	case 2:
		{
			new newslot;

			if(!C_DATA[playerid][c_trunk][1]) return SendClientMessage(playerid, COLOR_RED, "В багажнике нет канистр");

			if(CheckMaxVes(playerid,49,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");

			PlayerItem1[playerid][newslot]=49;
			PlayerItem2[playerid][newslot]+=1;
			C_DATA[playerid][c_trunk][1] --;
			SaveItem(playerid,newslot);
			SendMes(playerid, COLOR_GREEN, "Вы взяли из багажника канистру, теперь в нем %d канистр", strval(inputtext), C_DATA[playerid][c_trunk][1]);
			SaveTrunkCar(playerid);
		}
	}
	return 1;
}
DLG(18209, playerid, response, listitem, inputtext[])
{
	callcmd::trunk(playerid);
	return 1;
}
DLG(5123, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new newslot;
	switch(listitem)
	{
	case 0:
		{
			if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, ""cER"Вы должны находится за рулем!");
			if(GetVehicleType(GetPlayerVehicleID(playerid)) == 7 || GetVehicleType(GetPlayerVehicleID(playerid)) == 4) return 1;
			if(Fuel[GetPlayerVehicleID(playerid)] >= 45) return SendClientMessage(playerid, -1, ""cER"Ваш бак полон!");
			if(Refueling[playerid] > 0) return SendClientMessage(playerid, -1, ""cER"Вы уже заправляетесь!");
			ShowPlayerDialog(playerid, 131+128, DIALOG_STYLE_INPUT, ""cMain"Топливо", ""cWH"Введите количество литров топлива:", "Принять", "Отмена");
		}
	case 1:
		{
			new till = BizzInfo[FuelBizzID[playerid]][bTill]*5;
			if(CheckMaxVes(playerid,48,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
			if(GetPlayerRubble(playerid) < till) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");

			SetPlayerMoney(playerid, -till);
			if(BizzInfo[FuelBizzID[playerid]][bProduct] > 0)
			{
				BizzInfo[FuelBizzID[playerid]][bMoney] += till;
				BizzInfo[FuelBizzID[playerid]][bProduct] -= 10;
				BizzPay[FuelBizzID[playerid]] += till;
				MysqlUpdateBizzInt(FuelBizzID[playerid], "money", BizzInfo[FuelBizzID[playerid]][bMoney]);
				MysqlUpdateBizzInt(FuelBizzID[playerid], "product", BizzInfo[FuelBizzID[playerid]][bProduct]);
			}
			PlayerItem1[playerid][newslot]=48;
			PlayerItem2[playerid][newslot]+=1;
			SendMes(playerid, -1, ""cDA"Вы купили набор инструментов за %dр!", till);
			FuelBizzID[playerid] = 0;
			SaveItem(playerid,newslot);
		}
	case 2:
		{
			new till = BizzInfo[FuelBizzID[playerid]][bTill]*4;
			if(GetPlayerRubble(playerid) < till) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
			if(CheckMaxVes(playerid,49,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");

			SetPlayerMoney(playerid, -till);
			if(BizzInfo[FuelBizzID[playerid]][bProduct] > 0)
			{
				BizzInfo[FuelBizzID[playerid]][bMoney] += till;
				BizzInfo[FuelBizzID[playerid]][bProduct] -= 10;
				BizzPay[FuelBizzID[playerid]] += till;
				MysqlUpdateBizzInt(FuelBizzID[playerid], "money", BizzInfo[FuelBizzID[playerid]][bMoney]);
				MysqlUpdateBizzInt(FuelBizzID[playerid], "product", BizzInfo[FuelBizzID[playerid]][bProduct]);
			}
			PlayerItem1[playerid][newslot]=49;
			PlayerItem2[playerid][newslot]+=1;
			SendMes(playerid, -1, ""cDA"Вы купили канистру за %dр!", till);
			FuelBizzID[playerid] = 0;
			SaveItem(playerid,newslot);
		}
	}
	return 1;
}
DLG(8752, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	new accountid = g_player_listitem_use[playerid];
	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");

	switch(listitem)
	{
	case 0:
		{
			format(string, 90, ""cWH"Баланс банковского счета: {63BD4E}%d %s", g_player_bank_accounts[playerid][ PI[playerid][pMainBankAccount] ][B_BALANCE] );
			ShowPlayerDialog(playerid, 0, 0, ""cMain"Баланс", string, "Назад", "");
		}
	case 1:
		{
			ShowPlayerDialog(playerid, 62+12, 1, ""cMain"Пополнение",
			""cWH"Введите количество денег\n\
			на которое хотите пополнить банковский счёт", "Принять", "Назад");
		}
	case 2:
		{
			ShowPlayerDialog(playerid, 62+8, 1, ""cMain"Снять со счета",
			""cWH"Введите количество денег\n\
			которое хотите снять с банковского счёта", "Принять", "Назад");
		}
	case 3:
		{
			if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1) return SendClientMessage(playerid, -1, ""cER"Данная операция недоступна с данным счетом");
			ShowPlayerDialog(playerid, 7323, DIALOG_STYLE_LIST, "{DEE914}Выберите что хотите оплатить:", "1. Дом\n2. Квартиру\n3. Гараж\n4. Бизнес", "Далее", "Отмена");
		}
	case 4:
		{
			if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1) return SendClientMessage(playerid, -1, ""cER"Данная операция недоступна с данным счетом");
			if(PI[playerid][pPhoneNumber] <= 1)
			{
				SendClientMessage(playerid, -1, ""cER"У вас нет Sim-Card!");
				return 1;
			}
			new ok = SearchInventoryItem(playerid, 47);
			if(ok==0){return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");}
			format(string, sizeof(string), ""cWH"Введите сумму пополнения\n\nКомиссия за операцию: {1D99D4}0%%\n\n"cWH"Текущее состояние счёта: {63BD4E}%dр", PI[playerid][pPhoneBalance]);
			ShowPlayerDialog(playerid, 62+1, 1, ""cMain"Пополнение счета телефона", string, "Принять", "Назад");
		}
	case 5:
		{
			if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1) return SendClientMessage(playerid, -1, ""cER"Данная операция недоступна с данным счетом");
			format(global_string, 128, ""cWH"Введите количество денег, которые хотите пожертвовать на благотворительность\n\nВы пожертвовали: {63BD4E}%dр", PI[playerid][pCharity]);
			ShowPlayerDialog(playerid, 62+4, 1, ""cMain"Благотворительность", global_string, "Принять", "Назад");
		}
	case 6:
		{

			if(!TransferReset[playerid])
			{
				if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 13) return SendClientMessage(playerid,COLOR_GREY,"Переводить деньги можно только отыграв 13 часов (13 EXP)");
				else ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"Перевод", ""cWH"Введите ID игрока и количество денег через запятую\n\nПример: 234, 10000", "Принять", "Назад");
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREY, "Переводить деньги можно только раз в минуту.");
			}
		}
	case 7:
		{
			if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1) return SendClientMessage(playerid, -1, ""cER"Данная операция недоступна с данным счетом");
			ShowPlayerDialog(playerid, 106+214, DIALOG_STYLE_LIST, ""cMain"Операции со счетом бизнеса", "1. Пополнить счет бизнеса\n2. Вывести средства со счета бизнеса", "Выбрать", "Отмена");
		}
	}
	return 1;
}
DLG(18110, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new h = GetPlayerArend(playerid);
	new slot = GetPlayerSlotArend(playerid, h);

	if(slot == -1) return SendClientMessage(playerid, COLOR_RED, "Произошла ошибка. Мест нет.");

	strmid(HouseArendName[h][slot], "none", 0, strlen("none"), 24);

	mysql_format(db_prod,global_string, 150, "UPDATE `house` SET `hArendName` = '%e,%e,%e' WHERE `id` = '%d'", HouseArendName[h][0], HouseArendName[h][1], HouseArendName[h][2], h);
	mysql_tquery(db_prod, global_string, "", "");

	SendClientMessage(playerid, COLOR_RED, "Вы успешно выселились из дома");

	PI[playerid][pHouseArend] = -1;
	PI[playerid][pSpawnChange] = 0;

	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=0, house_arend=-1 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1);

	switch(random(3))
	{
	case 0: SetPlayerPos(playerid, 1370.0806,-189.7610,1903.9984), SetPlayerFacingAngle(playerid, 180.0);
	case 1: SetPlayerPos(playerid, 1370.2666,-207.2611,1903.9984), SetPlayerFacingAngle(playerid, 0.0);
	case 2: SetPlayerPos(playerid, 1358.4496,-198.1853,1903.9984), SetPlayerFacingAngle(playerid, 270.0);
	}
	SetCameraBehindPlayer(playerid);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	return 1;
}
DLG(8564, playerid, response, listitem, inputtext[])
{
	if(regstatus{playerid} == true)
	{
		if(!response) return SCM(playerid,COLOR_RED,"[Регистрация]: Вы отказались от ввода пароля,но без него Вы не сможете закончить регистарцию.");
		if(strlen(inputtext) < 2 || strlen(inputtext) > 32) return SCM(playerid,COLOR_RED,"Пароль должен состоять от 2 до 32 символов!"),ShowPlayerDialog(playerid,8564,DIALOG_STYLE_INPUT,"{1383b4}Регистрация | Пароль",""cWH"Во избежание взлома Вашего аккаунта придумайте хороший пароль который нигде больше не используете\nВведите придуманный пароль в окошко ниже:","Выбрать","Закрыть");
		for(new i = strlen(inputtext)-1; i != -1; i--)
		{
			switch(inputtext[i])
			{
			case '0'..'9', 'а'..'я', 'a'..'z', 'А'..'Я', 'A'..'Z': continue;
			default: return ShowPlayerDialog(playerid,8564,DIALOG_STYLE_INPUT,"{1383b4}Регистрация | Пароль",""cWH"Во избежание взлома Вашего аккаунта придумайте хороший пароль который нигде больше не используете\nВведите придуманный пароль в окошко ниже:","Выбрать","Закрыть");
			}
		}
		settext(PI[playerid][pPassword],inputtext);
		return REG_PASS[playerid] = 1;
	}
	else
	{
		if(!response) return SCM(playerid,COLOR_RED,"[Авторизация]: Вы отказались от ввода пароля,но без него Вы не сможете авторизоваться.");
		if(strlen(inputtext) < 2 || strlen(inputtext) > 32) return SCM(playerid,COLOR_RED,"Пароль должен состоять от 2 до 32 символов!"),ShowPlayerDialog(playerid,8564,DIALOG_STYLE_INPUT,"{1383b4}Авторизация | Пароль",""cWH"Введите Ваш пароль указанный при регистрации:","Выбрать","Закрыть");
		if(!istext(PI[playerid][pPassword],inputtext)) return SCM(playerid,COLOR_RED,"Введёный пароль не соответствует настоящему"),ShowPlayerDialog(playerid,8564,DIALOG_STYLE_INPUT,"{1383b4}Авторизация | Пароль",""cWH"Введите Ваш пароль указанный при регистрации:","Выбрать","Закрыть");
		SCM(playerid,COLOR_GREEN,"Пароль успешно подошёл. Теперь нажмите 'продолжить'"),AVT_PASS[playerid] = 1;
	}
	return 1;
}
DLG(1299, playerid, response, listitem, inputtext[])
{
	if(!response) return SendClientMessage(playerid,0x88AA88AA,"Вы отменили перемещение!");

	SetPlayerInterior(playerid,0);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerPosFindZ(playerid, tp_map_pos[playerid][0], tp_map_pos[playerid][1], tp_map_pos[playerid][2]);
	SendClientMessage(playerid,0x88AA88AA,"Вы переместились на отмеченную точку!");
	return 1;
}
DLG(4235, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new g = garage_idVAR[playerid], type = GarageInfo[g][g_TYPE]-1;
	if(GarageInfo[g][g_TYPE] == 1)
	{
		if(vehicle_in_garage[playerid]) return SendClientMessage(playerid, COLOR_RED, "У Вас одноместный гараж и сейчас это место занято другим автомобилем. Уберите транспорт из гаража и повторите попытку..");
	}
	if(GarageInfo[g][g_LOCK] != 0) return SendClientMessage(playerid, COLOR_RED, "Гараж закрыт");

	new vehid = GetPlayerVehicleID(playerid);
	SetVehiclePos(vehid, GaragesEnterCar[type][0], GaragesEnterCar[type][1], GaragesEnterCar[type][2]);
	SetVehicleZAngle(vehid, GaragesEnterCar[type][3]);
	SetVehicleVirtualWorld(vehid, GarageInfo[g][g_WORLD]);
	LinkVehicleToInterior(vehid, 6);

	foreach(new i : Player) if(IsPlayerInVehicle(i, vehid))
	{
		SetPlayerPos(i, GaragesEnterCar[type][0], GaragesEnterCar[type][1], GaragesEnterCar[type][2]);
		SetPlayerVirtualWorld(i, GarageInfo[g][g_WORLD]);
		SetPlayerInterior(i, 6);
		PI[i][pInGarage] = g;
		PutPlayerInVehicle(i, vehid, GetPlayerVehicleSeat(i));
	}
	SendClientMessage(playerid, COLOR_ORANGE, "Чтобы выехать с гаража, нажмите клавишу H(в машине)");
	return 1;
}
DLG(6237, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new g = GetPlayerInGarage(playerid);
	if(g == -1) return 1;

	new vehid = GetPlayerVehicleID(playerid);
	SetVehiclePos(vehid, GarageInfo[g][g_ENTER_X_CAR], GarageInfo[g][g_ENTER_Y_CAR], GarageInfo[g][g_ENTER_Z_CAR]);
	SetVehicleZAngle(vehid, GarageInfo[g][g_ENTER_A_CAR]);
	SetVehicleVirtualWorld(vehid, 0);
	LinkVehicleToInterior(vehid, 0);

	foreach(new i : Player) if(IsPlayerInVehicle(i, vehid))
	{
		SetPlayerPos(i, GarageInfo[g][g_ENTER_X_CAR], GarageInfo[g][g_ENTER_Y_CAR], GarageInfo[g][g_ENTER_Z_CAR]);
		SetPlayerVirtualWorld(i, 0);
		SetPlayerInterior(i, 0);
		PI[i][pInGarage] = -1;
		PutPlayerInVehicle(i, vehid, GetPlayerVehicleSeat(i));
	}
	return 1;
}
DLG(3682, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new g = garage_idVAR[playerid], type = GarageInfo[g][g_TYPE]-1;
	if(GarageInfo[g][g_LOCK] != 0) return SendClientMessage(playerid, COLOR_RED, "Гараж закрыт");
	PI[playerid][pInGarage] = g;

	SetPlayerPos(playerid, GaragesEnterCar[type][0], GaragesEnterCar[type][1], GaragesEnterCar[type][2]);
	SetPlayerInterior(playerid, 6);
	SetPlayerVirtualWorld(playerid, GarageInfo[g][g_WORLD]);
	SendClientMessage(playerid, COLOR_GREEN, "Вы вошли в гараж. Чтобы выйти с гаража, нажмите клавишу ALT(у двери)");
	return 1;
}
DLG(6343, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new g = GetPlayerInGarage(playerid);
	if(g == -1) return 1;
	PI[playerid][pInGarage] = -1;

	SetPlayerPos(playerid, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z]);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	return 1;
}
DLG(7323, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	global_string = "";

	switch(listitem)
	{
	case 0:
		{
			new id = GetPlayerHouse(playerid);
			if(id == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет дома!");

			format(global_string, 320, ""cWH"Укажите количество дней, на которое хотите оплатить дом(не более 7):\n\n\
			Количество уже оплаченных дней: {E9D70C}%d дн.\n\
			"cWH"Доступное количество дней для оплаты: {E9D70C}%d дней\n\
			"cWH"Сумма аренды в сутки составляет: {E9D70C}%d руб.\n\n\
			"cWH"Введите количество дней оплаты в строчку ниже:",
			HouseInfo[id][hOplata], 7 - HouseInfo[id][hOplata]);
			ShowPlayerDialog(playerid, 5200+5, 1, ""cMain"Оплата дома", global_string, "Принять", "Назад");
		}
	case 1:
		{
			new id = GetPlayerRooms(playerid);
			if(id == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет квартиры!");
			format(global_string, 320, ""cWH"Укажите количество дней, на которое хотите оплатить квартиру(не более 7):\n\n\
			Количество уже оплаченных дней: {E9D70C}%d дн.\n\
			"cWH"Доступное количество дней для оплаты: {E9D70C}%d дней\n\
			"cWH"Сумма аренды в сутки составляет: {E9D70C}%d руб.\n\n\
			"cWH"Введите количество дней оплаты в строчку ниже:",
			RoomsInfo[id][rOplata], 7 - RoomsInfo[id][rOplata], GetRoomOplata(id));

			ShowPlayerDialog(playerid, 5200+6, 1, ""cMain"Оплата квартиры", global_string, "Принять", "Назад");
		}
	case 2:
		{
			if(GetPlayerGarage(playerid) == -1)
			return SendClientMessage(playerid, COLOR_RED, "У Вас нет гаража");

			new g = GetPlayerGarage(playerid);

			format(global_string, 320, ""cWH"Укажите количество дней, на которое хотите оплатить гараж(не более 7):\n\n\
			Количество уже оплаченных дней: {E9D70C}%d дн.\n\
			"cWH"Доступное количество дней для оплаты: {E9D70C}%d дн.\n\
			"cWH"Сумма аренды в сутки составляет: {E9D70C}%d руб.\n\n\
			"cWH"Введите количество дней оплаты в строчку ниже:", GarageInfo[g][g_DAY], 7 - GarageInfo[g][g_DAY], GaragePayment(GarageInfo[g][g_TYPE]));
			ShowPlayerDialog(playerid, 3672, DIALOG_STYLE_INPUT, "{DEE914}Оплата гаража", global_string, "Далее", "Выход");
		}
	case 3:
		{
			new id = GetPlayerBizz(playerid);
			if(id == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет бизнеса!");
			format(global_string, 320, ""cWH"Укажите количество дней, на которое хотите оплатить бизнес(не более 7):\n\n\
			Количество уже оплаченных дней: {E9D70C}%d дн.\n\
			"cWH"Доступное количество дней для оплаты: {E9D70C}%d дней\n\
			"cWH"Сумма аренды в сутки составляет: {E9D70C}2000 рублей\n\n\
			"cWH"Введите количество дней оплаты в строчку ниже:",
			BizzInfo[id][bOplata], 7 - BizzInfo[id][bOplata]);

			ShowPlayerDialog(playerid, 5200+7, 1, ""cMain"Оплата бизнеса", global_string, "Принять", "Назад");
		}
	}
	return 1;
}
DLG(8262, playerid, response, listitem, inputtext[])
{

	new g = GetPlayerGarage(playerid), title_str[64];
	if(g == -1) return 1;

	format(title_str, sizeof title_str, ""cMain"Управление гаражем №%d", g);

	ShowPlayerDialog
	(
	playerid,
	6463,
	DIALOG_STYLE_LIST,
	title_str,
	"{43B5E6}1. Информация о гараже\n\
		"cWH"2. Отметить гараж на GPS\n\
		3. Открыть / закрыть гараж\n\
		4. Улучшения\n\
		5. Отремонтировать автомобиль\n\
		6. Воспользоваться радиоприемником\n\
		{FA6442}6. Дополнительные действия",
	"Выбрать", "Отмена"
	)
	;
	return 1;
}
DLG(6123, playerid, response, listitem, inputtext[])
{

	new g = GetPlayerGarage(playerid);
	if(g == -1) return 1;
	if(!response)
	{

		new title_str[64];

		format(title_str, sizeof title_str, ""cMain"Управление гаражем №%d", g);

		ShowPlayerDialog
		(
		playerid,
		6463,
		DIALOG_STYLE_LIST,
		title_str,
		"{43B5E6}1. Информация о гараже\n\
			"cWH"2. Отметить гараж на GPS\n\
			3. Открыть / закрыть гараж\n\
			4. Улучшения\n\
			5. Отремонтировать автомобиль\n\
			6. Воспользоваться радиоприемником\n\
			{FA6442}6. Дополнительные действия",
		"Выбрать", "Отмена"
		)
		;

		return true;

	}
	if(GetPlayerRubble(playerid) < 3000 * GarageInfo[g][g_UPDATE]+1) return SendClientMessage(playerid, COLOR_RED, "Недостаточно средств для покупки данного улучшения");
	switch(listitem)
	{

	case 0:
		{
			if(GarageInfo[g][g_UPDATE] >= 2) return SendClientMessage(playerid, COLOR_RED, "Гараж улучшен по максимуму");
			GarageInfo[g][g_UPDATE] ++;
			SendClientMessage(playerid, COLOR_GREEN, "Улучшение приобретено");
		}
	case 1:
		{
			if(GarageInfo[g][g_UPDATE] >= 2) return SendClientMessage(playerid, COLOR_RED, "Гараж улучшен по максимуму");
			if(GarageInfo[g][g_UPDATE] < 1) return SendClientMessage(playerid, COLOR_RED, "Сначала стоит приобрести предыдущее улучшение");
			GarageInfo[g][g_UPDATE] ++;
			SendClientMessage(playerid, COLOR_GREEN, "Улучшение приобретено");
		}
	case 2:
		{
			ShowPlayerDialog(playerid, 3167, DIALOG_STYLE_MSGBOX, "{3A93D6}Информация об улучшениях", "{EF8307}Возможность ремонтировать транспорт:\n\
			"cWH"- С покупкой данного улучшения, Вы сможете ремонтировать транспорт в собственном гараже\n\n\
			{EF8307}Возможность использовать радиоприемник:\n\
			"cWH"- C покупкой данного улучшения, в Вашем гараже появится радиоприемник, через который Вы сможете наслаждаться музыкой\n\n", "Назад", "");
		}
	}
	SetPlayerMoney(playerid, -3000*GarageInfo[g][g_UPDATE]+1);
	SaveGarageData(g);
	return 1;
}
DLG(3167, playerid, response, listitem, inputtext[])
{

	new
	upd_str[296],
	g = GetPlayerGarage(playerid)
	;
	if(g == -1) return 1;
	format
	(
	upd_str, sizeof upd_str,
	"\
			1. Возможность ремонтировать транспорт в гараже \t%s\n\
			2. Возможность использовать радиоприемник \t%s\n\
			{2F94CA}3. Информация об улучшениях",
	GarageInfo[g][g_UPDATE] >= 1 ? ("{59CF46}Куплено") : ("{F94627}Не куплено"),
	GarageInfo[g][g_UPDATE] >= 2 ? ("{59CF46}Куплено") : ("{F94627}Не куплено")
	)
	;

	ShowPlayerDialog
	(
	playerid,
	6123,
	DIALOG_STYLE_LIST,
	"{F29F2A}Улучшения",
	upd_str,
	"Купить", "Назад"
	)
	;
	return 1;
}
DLG(6463, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new g = GetPlayerGarage(playerid);
	if(g == -1) return 1;

	switch(listitem)
	{
	case 0: // информация
		{
			new garage_str[306], class_text[32], lock_text[54];

			switch(GarageInfo[g][g_TYPE])
			{
			case 1: class_text = "Низкий класс";
			case 2: class_text = "Средний класс";
			case 3: class_text = "Премиум класс";
			}

			switch(GarageInfo[g][g_LOCK])
			{
			case 0: lock_text = "{63DB67}Гараж открыт";
			case 1: lock_text = "{FA5751}Гараж закрыт";
			}

			format
			(
			garage_str, sizeof garage_str, "\
				"cWH"Информация о гараже:\n\n\
				Тип / название: \t{F26D06}%s\n\
				"cWH"Номер гаража: \t%d\n\
				Владелец: \t%s\n\
				Стоимость: \t%d рублей\n\
				Оплачен на: \t%d/7 дн.\n\
				Сумма оплаты(в сутки): \t%d рублей\n\
				Уровень улучшений: \t%dур.\n\
				Статус гаража: \t%s",
			class_text,
			g,
			GarageInfo[g][g_OWNER],
			GarageInfo[g][g_PRICE],
			GarageInfo[g][g_DAY],
			GaragePayment(GarageInfo[g][g_TYPE]),
			GarageInfo[g][g_UPDATE],
			lock_text
			)
			;

			ShowPlayerDialog
			(
			playerid,
			8262,
			DIALOG_STYLE_MSGBOX,
			" ",
			garage_str,
			"Назад", ""
			)
			;
		}

	case 1: // отметить на GPS
		{

			new locname[30];

			locname = "Личный гараж";

			DisablePlayerCheckpoint(playerid);
			GPSPlayer_(playerid, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z], locname);
			SendClientMessage(playerid,-1,"{3DC132}[Гараж]: "cWH"Гараж отмечен на карте красной меткой");

		}

	case 2: // открыть / закрыть
		{

			if(GarageInfo[g][g_LOCK] == 1)
			{
				GarageInfo[g][g_LOCK] = 0;
				SendClientMessage(playerid, COLOR_GREEN, "Гараж открыт");
			}

			else GarageInfo[g][g_LOCK] = 1, SendClientMessage(playerid, COLOR_RED, "Гараж закрыт");

			SaveGarageData(g);

		}

	case 3: // улучшения
		{

			new
			upd_str[296]
			;

			format
			(
			upd_str, sizeof upd_str,
			"\
				1. Возможность ремонтировать транспорт в гараже \t%s\n\
				2. Возможность использовать радиоприемник \t%s\n\
				{2F94CA}3. Информация об улучшениях",
			GarageInfo[g][g_UPDATE] >= 1 ? ("{59CF46}Куплено") : ("{F94627}Не куплено"),
			GarageInfo[g][g_UPDATE] >= 2 ? ("{59CF46}Куплено") : ("{F94627}Не куплено")
			)
			;

			ShowPlayerDialog
			(
			playerid,
			6123,
			DIALOG_STYLE_LIST,
			"{F29F2A}Улучшения",
			upd_str,
			"Купить", "Назад"
			)
			;

		}

	case 4: // ремонт
		{

			if(GarageInfo[g][g_UPDATE] < 1)
			return SendClientMessage(playerid, COLOR_RED, "У Вас не куплено данное улучшение");

			if(!IsPlayerInAnyVehicle(playerid))
			return SendClientMessage(playerid, COLOR_RED, "Нужно находиться в транспорте");

			if(IsPlayerInRangeOfPoint(playerid, 20.0, GaragesEnterCar[0][0], GaragesEnterCar[0][1], GaragesEnterCar[0][2]) == 0 && IsPlayerInRangeOfPoint(playerid, 20.0, GaragesEnterCar[1][0], GaragesEnterCar[1][1], GaragesEnterCar[1][2]) == 0 && IsPlayerInRangeOfPoint(playerid, 20.0, GaragesEnterCar[2][0], GaragesEnterCar[2][1], GaragesEnterCar[2][2]) == 0) return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в гараже, для совершения данного действия");
			SendClientMessage(playerid, COLOR_GREEN, "Транспорт отремонтирован");
			RepairVehicle(GetPlayerVehicleID(playerid));

		}

	case 5: // радиостанция
		{

			if(GarageInfo[g][g_UPDATE] < 2)
			return SendClientMessage(playerid, COLOR_RED, "У Вас не куплено данное улучшение");

			ShowPlayerDialog(playerid, 8212, 2, ""cMain"Радио", "\
		1. Станция: Радио шансон\n\
		2. Станция: Русский хит\n\
		3. Станция: Europa Plus\n\
		4. Станция: Дорожное\n\
		5. Станция: Record\n\
		{AFAFAF}Выключить радио", "Принять", "Отмена");

		}

	case 6: // доп. функции
		{

			ShowPlayerDialog
			(
			playerid,
			4411,
			DIALOG_STYLE_LIST,
			"{F75353}Дополнительные действия",
			"1. Обменяться гаражами с игроком\n\
				2. Продать гараж игроку\n\
				3. Продать гараж государству",
			"Выбрать", "Назад"
			);
		}
	}
	return 1;
}
DLG(8212, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	switch(listitem)
	{
	case 0: PlayAudioStreamForPlayer(playerid,"http://chanson.hostingradio.ru:8041/chanson128.mp3");
	case 1: PlayAudioStreamForPlayer(playerid,"http://s8.imgradio.pro/RusHit");
	case 2: PlayAudioStreamForPlayer(playerid,"http://emg02.hostingradio.ru/ep-new128.mp3");
	case 3: PlayAudioStreamForPlayer(playerid,"http://dorognoe.hostingradio.ru:8000/radio");
	case 4: PlayAudioStreamForPlayer(playerid,"http://air2.radiorecord.ru:805/mix_128");
	case 5: PlayAudioStreamForPlayer(playerid,"");
	}
	return 1;
}
DLG(3672, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	new g = GetPlayerGarage(playerid);
	if(g == -1) return 1;
	new dayss = strval(inputtext), g_rent = GaragePayment(GarageInfo[g][g_TYPE]) * dayss;

	if(!dayss) return SendClientMessage(playerid, COLOR_RED, "Количество дней не может быть равно 0 или быть менее 0");
	new accountid = g_player_listitem_use[playerid];

	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");
	if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < g_rent) return SendClientMessage(playerid, COLOR_RED, "У Вас не хватает средств для оплаты аренды гаража");
	if(dayss < 1 || dayss > 7) return SendClientMessage(playerid, COLOR_RED, "Количество дней от 1 до 7");
	if((GarageInfo[g][g_DAY] + dayss) > 7) return SendClientMessage(playerid, COLOR_RED, "Нельзя оплатить более чем на 7 дней");

	GarageInfo[g][g_DAY] += dayss;
	SetPlayerMoney(playerid, -g_rent);
	SaveGarageData(g);

	SCMF(playerid, COLOR_GREEN, "Вы оплатили гараж на %d дней. С Вашего счета списано: %d рублей", dayss, g_rent);
	return 1;
}
DLG(4411, playerid, response, listitem, inputtext[])
{
	if(!response)
	{

		new g = GetPlayerGarage(playerid), title_str[64];
		if(g == -1) return 1;
		format(title_str, sizeof title_str, ""cMain"Управление гаражем №%d", g);

		ShowPlayerDialog
		(
		playerid,
		6463,
		DIALOG_STYLE_LIST,
		title_str,
		"{43B5E6}1. Информация о гараже\n\
			"cWH"2. Отметить гараж на GPS\n\
			3. Открыть / закрыть гараж\n\
			4. Улучшения\n\
			5. Отремонтировать автомобиль\n\
			6. Воспользоваться радиоприемником\n\
			{FA6442}6. Дополнительные действия",
		"Выбрать", "Отмена"
		)
		;

		return true;

	}

	switch(listitem)
	{

	case 0: ShowPlayerDialog(playerid, 3862, DIALOG_STYLE_INPUT, "{F65860}Обменяться гаражем с игроком", ""cWH"Введите в поле ниже ID игрока и доплату через запятую\nПример: 38, 450000\n\n{F65860}Если без доплаты, то указываем сумму 0", "Далее", "Назад");
	case 1: ShowPlayerDialog(playerid, 6272, DIALOG_STYLE_INPUT, "{F65860}Продажа гаража игроку", ""cWH"Введите в поле ниже ID игрока и цену, через запятую\nПример: 38, 450000", "Далее", "Назад");
	case 2: ShowPlayerDialog(playerid, 7262, DIALOG_STYLE_MSGBOX, "{F65860}Продажа гаража государству", ""cWH"Вы действительно хотите продать свой гараж государству? Гараж будет продан за пол цены\n\nЕсли согласны продать гараж, нажмите 'Далее'\nЕсли отказываетесь продать гараж, нажмите 'Назад'", "Далее", "Назад");
	}
	return 1;
}
DLG(6272, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	new sell_id, sell_price;

	if(sscanf(inputtext, "p<,>ii", sell_id, sell_price)) return ShowPlayerDialog(playerid, 6272, DIALOG_STYLE_INPUT, "{F65860}Продажа гаража игроку", ""cWH"Введите в поле ниже ID игрока и цену, через запятую\nПример: 38, 450000", "Далее", "Назад");

	if(!IsPlayerConnected(sell_id))
	return SendClientMessage(playerid, COLOR_RED, "Игрок не в игре");

	if(sell_id == playerid)
	return SendClientMessage(playerid, COLOR_RED, "Нельзя продать гараж самому себе");

	if(sell_price < 10000 || sell_price > 2000000)
	return SendClientMessage(playerid, COLOR_RED, "Цена не может быть менее 10.000 рублей и более 2.000.000 рублей");

	if(GetPlayerRubble(sell_id) < sell_price)
	return SendClientMessage(playerid, COLOR_RED, "У игрока нет столько средств на руках");

	if(GetPlayerGarage(sell_id) != -1)
	return SendClientMessage(playerid, COLOR_RED, "У игрока уже есть гараж. Если Вы хотите обменяться гаражами с игроком, используйте другой пункт меню..");

	new Float:x,Float:y,Float:z;
	GetPlayerPos(sell_id, x, y, z);
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z))
	return SendClientMessage(playerid, COLOR_RED,"Данный игрок слишком далеко от Вас!");

	SendPlayerProposition(playerid, sell_id, PROPOSITION_TYPE_SELL_GARAGE, sell_price);
	return 1;
}
DLG(3862, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	new obmen_id, obmen_price;

	if(sscanf(inputtext, "p<,>ii", obmen_id, obmen_price)) return ShowPlayerDialog(playerid, 3862, DIALOG_STYLE_INPUT, "{F65860}Обменяться гаражем с игроком", ""cWH"Введите в поле ниже ID игрока и доплату через запятую\nПример: 38, 450000\n\n{F65860}Если без доплаты, то указываем сумму 0", "Далее", "Назад");

	if(!IsPlayerConnected(obmen_id))
	return SendClientMessage(playerid, COLOR_RED, "Игрок не в игре");

	if(obmen_id == playerid)
	return SendClientMessage(playerid, COLOR_RED, "Нельзя обменяться гаражами самому с собой");

	if(obmen_price != 0)
	{
		if(obmen_price < 10000 || obmen_price > 1000000)
		return SendClientMessage(playerid, COLOR_RED, "Доплата не может быть менее 10.000 рублей и более 2.000.000 рублей");
	}

	if(GetPlayerRubble(playerid) < obmen_price)
	return SendClientMessage(playerid, COLOR_RED, "У Вас нет столько денег на руках для доплаты");

	if(GetPlayerGarage(obmen_id) == -1)
	return SendClientMessage(playerid, COLOR_RED, "У этого игрока нет гаража, на что Вы хотите меняться с ним? На воздух?");

	new Float:x,Float:y,Float:z;
	GetPlayerPos(obmen_id, x, y, z);
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z))
	return SendClientMessage(playerid, COLOR_RED,"Данный игрок слишком далеко от Вас!");

	SendPlayerProposition(playerid, obmen_id, PROPOSITION_TYPE_CHANGE_GARAGE, obmen_price);
	return 1;
}
DLG(7262, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		ShowPlayerDialog
		(playerid,4411,DIALOG_STYLE_LIST,"{F75353}Дополнительные действия","1. Обменяться гаражами с игроком\n2. Продать гараж игроку\n3. Продать гараж государству","Выбрать", "Назад");
		return true;
	}
	new garage_id = GetPlayerGarage(playerid), sell_f[128];


	if(GetActivePlayerVehicleCount(playerid) != 0)
	{
		for(new i; i < MAX_LOAD_VEHICLE; i++)
		{
			if(PlayerVehicle[playerid][i] != INVALID_PLAYER_VEHICLE)
			{
				if(GetVehicleVirtualWorld(PlayerVehicle[playerid][i]) != 0)
				{
					DestroyPlayerVehicle(playerid, i);
				}
			}
		}
	}

	GarageInfo[garage_id][g_OWNED] = -1;
	GarageInfo[garage_id][g_DAY] = 0;
	GarageInfo[garage_id][g_UPDATE] = 0;
	GarageInfo[garage_id][g_LOCK] = 1;

	PI[playerid][pGarage] = -1;
	MysqlUpdatePlayerInt(playerid, "garage", PI[playerid][pGarage]);

	SetPlayerMoney(playerid, GarageInfo[garage_id][g_PRICE] / 2);
	strmid(GarageInfo[garage_id][g_OWNER], "None", 0, strlen("None"), 24);
	vehicle_in_garage[playerid] = 0;

	format(sell_f, sizeof sell_f, "Вы успешно продали свой гараж за %d руб", GarageInfo[garage_id][g_PRICE] / 2);
	SendClientMessage(playerid, COLOR_RED, sell_f);

	SaveGarageData(garage_id);
	UpdateGarageData(garage_id);
	return 1;
}
DLG(5723, playerid, response, listitem, inputtext[])
{
	if(!response) return false;
	new garage_id = garage_idVAR[playerid];

	new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, GarageInfo[garage_id][g_PRICE]);

	GarageInfo[garage_id][g_OWNED] = PI[playerid][pID];
	GarageInfo[garage_id][g_DAY] = 1;
	SetPlayerMoney(playerid, -price_house);
	strmid(GarageInfo[garage_id][g_OWNER], GetName(playerid), 0, strlen(GetName(playerid)), 24);

	SendClientMessage(playerid, COLOR_GREEN, "Поздравляем Вас с успешной покупкой гаража!");
	SendClientMessage(playerid, COLOR_GREEN, "Для того, чтобы открыть меню управления гаражем, используйте /garage");
	SendClientMessage(playerid, COLOR_GREEN, "Ваш гараж оплачен на 1 день. Рекомендуем оплатить аренду гаража в любом банке области");

	PI[playerid][pGarage] = garage_id;
	MysqlUpdatePlayerInt(playerid, "garage", PI[playerid][pGarage]);

	SaveGarageData(garage_id);
	UpdateGarageData(garage_id);
	return 1;
}
