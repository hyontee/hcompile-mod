DLG(2211, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new playa=g_player_listitem_use[playerid];
		new id = PlayerItem1[playa][PlayerUseList[playerid][MAX_LIST]];
		new s=PlayerUseList[playerid][MAX_LIST];
		switch(Item[id][iStek])
		{
		case 0:
			{
				new newslot;
				if(CheckMaxVes(playerid,id,1,newslot)==1) return true;
				PlayerItem1[playerid][s]=id;
				PlayerItem2[playerid][s]=1;
				nstrmid(PlayerItem3[playerid][s],PlayerItem3[playa][s]);
				SaveItem(playerid,s);
				UpDateInv(playerid);
				PlayerItem2[playa][s]=0;
				SaveItem(playa,s);
				UpDateInv(playa);
			}
		default:ShowPlayerDialog(playerid,2200+12,DIALOG_STYLE_INPUT,"Конфисковать","Введите сумму предметов,\nКоторую Вы хотите конфисковать!","Дальше","Выйти");
		}
