cmd:kiss(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/kiss [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendErr(playerid, "Игрок не в сети");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_WHITE, ""cER"Вы не можете поцеловать самомого себе!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 1.5) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_KISS);
	return 1;
}
CMD:tpcor(playerid, params[])
{
	if(g_player_full_access[playerid] == false) return 0x1;
	new Float:pX, Float:pY, Float:pZ;
	if(sscanf(params,"p<,>fff",pX,pY,pZ)) return SendClientMessage(playerid, 0xCCCCCCFF, "Используйте: /tpcor [x] [y] [z]");
	SetPlayerPos(playerid, pX, pY, pZ);
	return 1;
}
cmd:iznas(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid)) return SCM(playerid, COLOR_GREY, "Нельзя использовать в машине");
	if(iznas_time[playerid] > unix) return SendClientMessage(playerid, COLOR_RED, "Команду можно использовать раз в 5 минут");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/iznas [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, "Игрок не в сети!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 2.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipIznas] == 1) return SCM(playerid,COLOR_GRAD1, "Не, не, у игрока стальная попа. (он VIP)");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_WHITE, ""cER"Вы указали свой ID!");
	if(PI[params[0]][pAdmin] >= 1) return SCM(playerid,COLOR_GRAD1, "Не, не, у игрока стальная попа.");
	new Float:angle;
	GetPlayerFacingAngle(playerid, angle);
	SetPlayerFacingAngle(params[0], angle + 180);
	SendClientMessage(params[0], COLOR_RED, "Вас изнасиловал маньяк");
	format(global_string, sizeof(global_string), "изнасиловал(а) %s",GetName(params[0]));
	MeAction(playerid, global_string);
	ApplyAnimation(params[0], "SNM", "SPANKINGW",4.1,0,1,1,1,1,1);
	ApplyAnimation(playerid, "SNM", "SPANKEDW",4.1,0,1,1,1,1,1);
	iznas_time[playerid] = unix+(60*5);
	if(random(2))
	{
		PI[playerid][pWanted]++;
		SetPlayerWantedLevel(playerid, PI[playerid][pWanted]);
		SetPlayerCriminal(playerid, "Неизвестный", "Изнасилование человека");
	}
	return true;
}
cmd:hi(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/hi [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendErr(playerid, "Игрок не в сети");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_WHITE, ""cER"Вы не можете пожать руку самому себе!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_HANDSHAKE);
	return 1;
}

cmd:usedrugs(playerid)
{
	new ok = SearchInventoryItem(playerid, 44);
	if(!ok) return SendClientMessage(playerid, -1, ""cER"У вас нет наркотиков!");
	if(DrugsTime[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "Употреблять наркотики можно раз в 2 минуты!");

	new Float:health;
	GetPlayerHealth(playerid, health);
	if(TYPE_VIP[playerid] != VIP_STATE_NONE) SetPlayerHealth(playerid, health + float(VipData[TYPE_VIP[playerid]][VipDrugs]));
	if(TYPE_VIP[playerid] == VIP_STATE_NONE) SetPlayerHealth(playerid, health + 15);
	GetPlayerHealth(playerid, health);

	if(health > 120) return SendClientMessage(playerid, -1, "Вам плохо от наркотиков, пожалуйста подождите");
	if(PlayerItem2[playerid][ok] == 0) PlayerItem1[playerid][ok] = 0;
	PlayerItem2[playerid][ok]--;

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
	SendClientMessage(playerid, COLOR_GREY, "Вы употребили 40 грамм наркотиков!");

	SetTimerEx("DrugEffectGone", 60000, false, "i", playerid);
	DrugsTime[playerid] = unix+60;

	if(PI[playerid][pSex] == 1) MeAction(playerid, "достал пакетик и употребил наркотик");
	else MeAction(playerid, "достала пакетик и употребила наркотик");

	SetPlayerDrunkLevel(playerid, 3000);
	SetPlayerWeather(playerid, -68);
	SaveItem(playerid,ok);
	return 1;
}

cmd:offawarn(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		new adm_name[24], adm_reason[60];
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "s[24]s[32]", adm_name, adm_reason)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offawarn [ник админа] [причина]");
		if(GetPlayerID(adm_name) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Админ в сети, используйте команду /awarn");
		mysql_format(db_prod, stringer1, 128, "SELECT * FROM `admin` WHERE `name`='%s'", adm_name);
		mysql_tquery(db_prod, stringer1, "OffWarnAdmin", "iss", playerid, adm_name, adm_reason);
	}
	return true;
}

cmd:offlwarn(playerid, params[])
{
	global_string = "";
	if(g_player_full_access[playerid])
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "s[24]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offlwarn [ник игрока]");
		if(GetPlayerID(params[0]) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок в сети, используйте команду /lwarn");
		format(global_string, 128, "SELECT * FROM `accounts` WHERE `name`='%s' LIMIT 1", params[0]);
		mysql_tquery(db_prod, global_string, "OffWarnLeader", "is", playerid, params[0]);
	}
	return true;
}

cmd:offunawarn(playerid, params[])
{
	global_string = "";
	if(g_player_full_access[playerid])
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "s[24]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offunawarn [ник админа]");
		if(GetPlayerID(params[0]) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок в сети, используйте команду /unawarn");
		format(global_string, 128, "SELECT * FROM `admin` WHERE `name` = '%s'", params[0]);
		mysql_tquery(db_prod, global_string, "OffUNWarnAdmin", "is", playerid, params[0]);
	}
	return true;
}

cmd:offunlwarn(playerid, params[])
{
	global_string = "";
	if(g_player_full_access[playerid])
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "s[24]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offunlwarn [ник игрока]");
		if(GetPlayerID(params[0]) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок в сети, используйте команду /unlwarn");
		format(global_string, 128, "SELECT * FROM `accounts` WHERE `name`='%s' AND `leader` > '0'", params[0]);
		mysql_tquery(db_prod, global_string, "OffUNWarnLeader", "is", playerid, params[0]);
	}
	return true;
}

cmd:unlwarn(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/unlwarn [id игрока]");
		if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(!PI[params[0]][pLeader]) return SendClientMessage(playerid, -1, ""cER"Выбранный Вами лидер не является лидером");
		if(!PI[params[0]][pLWarn]) return SendClientMessage(playerid, -1, ""cER"Выбранный Вами лидер не имеет выговоров");
		PI[params[0]][pLWarn] --;

		format(string, sizeof string, "[A] Администратор %s снял выговор с лидера %s [%d/3]", GetName(playerid), GetName(params[0]), PI[params[0]][pLWarn]);
		SendAdminMessage(COLOR_RED, string);
		SaveHistoryBan(GetName(params[0]), string);
		SendClientMessage(params[0], COLOR_RED, string);
		MysqlUpdatePlayerInt(params[0], "lwarn", PI[params[0]][pLWarn]);
		fLogs("[admin] %s /unlwarn %s", GetName(playerid), GetName(params[0]));
	}
	return true;
}

cmd:lwarn(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "us[24]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/lwarn [id игрока] [причина]");
		if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(!PI[params[0]][pLeader]) return SendClientMessage(playerid, -1, ""cER"Выбранный Вами игрок не является лидером");

		PI[params[0]][pLWarn] ++;
		if(PI[params[0]][pLWarn] < 3)
		{
			format(stringer1, sizeof stringer1, "UPDATE `accounts` SET lwarn=%d WHERE name = '%s'", PI[params[0]][pLWarn], GetName(params[0]));
			mysql_function_query ( db_prod, stringer1, false, "", "");
			format(string, sizeof(string), "[A] Администратор %s выдал выговор лидеру %s [%d/3]. Причина: %s", GetName(playerid), GetName(params[0]), PI[params[0]][pLWarn], params[1]);
		}
		else
		{
			LeaveFractionPlayer(params[0]);
			format(string, sizeof(string), "[A] Лидер %s(%d) получил 3 выговора и был снят администратором %s(%d)", GetName(params[0]), params[0], GetName(playerid), playerid);
		}
		SendAdminMessage(COLOR_RED, string);
		SaveHistoryBan(GetName(params[0]), string);
		format(string, sizeof string, "Вы получили выговор от администратора %s(%d). При 3-х имеющихся выговоров, Вы будете сняты с поста", GetName(playerid), playerid);
		SendClientMessage(params[0], COLOR_GREEN, string);
		SendClientMessage(params[0], COLOR_GREEN, "Если Вы считаете, что произошла ошибка, обратитесь к основателям сервера");
		fLogs("[admin] %s /lwarn %s %s", GetName(playerid), GetName(params[0]), params[1]);
	}
	return true;
}

cmd:twarns(playerid)
{
	format(global_string, 128, "SELECT * FROM t_warn_logs WHERE `name`='%s' ORDER BY `date` DESC LIMIT 20", GetName(playerid));
	mysql_tquery(db_prod, global_string, "TwarnLogs", "i", playerid);
	return 1;
}

cmd:twarn(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_RED, "Вам недоступна эта возможность");
	new to_player, reason[24];
	if(sscanf(params, "us[24]", to_player, reason)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/twarn [id игрока] [причина]");
	if(!IsPlayerConnected(to_player)) return SendClientMessage(playerid, COLOR_GREY, "Игрок не в сети");
	if(PI[playerid][pMember] != PI[to_player][pMember]) return SendClientMessage(playerid, COLOR_RED, "Этот игрок состоит не в Вашей организации");
	if(PI[to_player][pRank] >= PI[playerid][pRank]) return SendClientMessage(playerid, COLOR_RED, "Вы не можете выдать этому игроку предупреждение");

	PI[to_player][pTWarn] ++;
	format(stringer1, sizeof stringer1, "UPDATE `accounts` SET twarn=%d WHERE name = '%s'", PI[to_player][pTWarn], GetName(to_player));
	mysql_function_query ( db_prod, stringer1, false, "", "");

	global_string = "";
	format(global_string, 144, "[R] %s %s[%d] выдал предупреждение %s[%d|3]. Причина: %s", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), playerid, GetName(to_player), PI[to_player][pTWarn], reason);
	SendFMes(PI[playerid][pMember], 0x5da130FF, global_string);

	if(PI[to_player][pTWarn] < 3)
	{
		global_string = "";
		format(global_string, 144, "%s %s[%d] выдал Вам предупреждение. Причина: %s", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), playerid, reason);
		SendClientMessage(to_player, COLOR_GREEN, global_string);

		global_string = "";
		format(global_string, 144, "Вы выдали предупреждение %s[%d]. Причина: %s", GetName(to_player), to_player, reason);
		SendClientMessage(playerid, COLOR_GREEN, global_string);
	}
	else
	{
		global_string = "";
		format(global_string, 144, "[R] %s[%d] был уволен из организации. Причина: 3 предупреждения", GetName(to_player), to_player);
		SendFMes(PI[playerid][pMember], 0x5da130FF, global_string);

		SendClientMessage(to_player, COLOR_GREEN, "Вы были уволены из организации. Причина: 3 предупреждения");
		LeaveFractionPlayer(to_player);
	}

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `t_warn_logs` (`name`, `issued`, `fraction`, `reason`, `date`) VALUES ('%e', '%e', '%d', '%e', NOW())", GetName(to_player), GetName(playerid), PI[playerid][pMember], reason);
	mysql_tquery(db_prod, STRING_GLOBAL);

	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET sub_twarns=sub_uninvited+1 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");
	FractionProtectionServer(playerid, reason);

	fLogs("[twarn] %s /twarn %s(%d/3) [%s]", GetName(playerid), GetName(to_player), PI[to_player][pTWarn], Fraction_Name[PI[playerid][pMember]]);
	if(F_MSG_Log == true)
	{
        format(string, sizeof(string), "[F-MSG] %s[%d] twarn(%d/3) %s[%d] in %s", GetName(playerid), playerid, PI[to_player][pTWarn], GetName(to_player), to_player, Fraction_Name[PI[playerid][pMember]]);
		SendAdminMessage(COLOR_GREY, string);
	}
	return 1;
}

cmd:untwarn(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_RED, "Вам недоступна эта возможность");
	new to_player;
	if(sscanf(params, "u", to_player)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/untwarn [id игрока]");
	if(!IsPlayerConnected(to_player)) return SendClientMessage(playerid, COLOR_GREY, "Игрок не в сети");
	if(PI[playerid][pMember] != PI[to_player][pMember]) return SendClientMessage(playerid, COLOR_RED, "Этот игрок состоит не в Вашей организации");
	if(!PI[to_player][pTWarn]) return SendClientMessage(playerid, COLOR_RED, "У этого игрока нет предупреждений");

	PI[to_player][pTWarn] --;
	format(stringer1, sizeof stringer1, "UPDATE `accounts` SET twarn=%d WHERE id=%d", PI[to_player][pTWarn], PI[to_player][pID]);
	mysql_function_query ( db_prod, stringer1, false, "", "");

	format(stringer1, 144, "[R] %s %s[%d] снял предупреждение %s[%d|3]", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), playerid, GetName(to_player), PI[to_player][pTWarn]);
	SendFMes(PI[playerid][pMember], 0x5da130FF, stringer1);

	SCMF(to_player, COLOR_GREEN, "%s %s[%d] снял Вам предупреждение", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), playerid);
	SCMF(playerid, COLOR_GREEN, "Вы сняли предупреждение %s[%d]", GetName(to_player), to_player);
	return 1;
}

cmd:sellsim(playerid, params[])
{
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"У вас нет SIM-карты!");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/sellsim [id игрока] [цена]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(playerid == params[0]) return SendClientMessage(playerid, COLOR_GREY, "Самому себе нельзя продавать SIM-карту!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(params[1] < 1 || params[1] > 1000000) return SendClientMessage(playerid, -1, ""cER"Цена должна быть от 1 до 1.000.000р");
	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_SIM, params[1]);
	return 1;
}

cmd:sellskin(playerid, params[])
{
	if(PI[playerid][pModel] == 97 || PI[playerid][pModel] == 140)
		return SendErr(playerid, "Вы не можете продать данный скин");

	if(sscanf(params, "ii", params[0], params[1]))
		return SendInf(playerid, "/sellskin [id игрока] [сумма]");

	if(!IsPlayerConnected(params[0]))
		return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false)
		return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(playerid == params[0])
		return SendClientMessage(playerid, COLOR_GREY, "Самому себе нельзя продавать скин!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0)
		return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(params[1] < 30000000 || params[1] > 500000000) return SendClientMessage(playerid, -1, ""cER"Цена должна быть от 30.000.000 до 500.000.000р");

	if(GetPlayerSkin(playerid) != PI[playerid][pModel])
		return SendErr(playerid, "На вас должен быть надет ваш скин");

	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_SKIN, params[1]);
	return 1;
}

CMD:race(playerid, params[])
{
	if(sscanf(params,"ddd",params[0],params[1], params[2]))
		return SendInf(playerid,"/race [id] [сумма] [1 до Казино Арзамас 2 - до Останкино]");

	if(!IsPlayerConnected(params[0])) // || params[0] == playerid
		return SendErr(playerid, "Неверный ID");

	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0)
		return SendErr(playerid, "Игрок должен находиться рядом с вами!");

	if GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerState(params[0]) != PLAYER_STATE_DRIVER *then
		return SendInf(playerid, "Вы и игрок должны находиться за рулем автомобилей.");

	if params[1] > 500000 || params[1] < 1000 *then
		return SendErr(playerid, "Сумма должна быть не менее 1000 руб и не более 500000 рублей.");

	if params[2] > 2 || params[1] < 1 *then
		return SendErr(playerid, "1 - до Казино Арзамас, 2 - до Останкино");

	if GetPlayerRubble(playerid) < params[1] *then
		return SendErr(playerid, "У вас недостаточно денег!");
	if GetPlayerRubble(params[0]) < params[1] *then
		return SendErr(playerid, "У соперника недостаточно денег!");

	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_RACE, params[1], params[2]);
	return true;

}

CMD:bgps(playerid, params[])
{
	if(PI[playerid][pMember] == TEAM_MVD)
	{
		if(g_rob[R_STATUS])
		{
			new idx = g_rob[R_BIZ_ID];
			GPSPlayer_(playerid, BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz], "Бизнес");
			SendClientMessage(playerid, COLOR_RED, "Бизнес, у которого сработала сигнализация отмечен на GPS");
		}
	}
	return 1;
}

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
	if(PI[playerid][pAdmin] && AdminLogged[playerid] == true)
	{
		tp_map_pos[playerid][0] = fX;
		tp_map_pos[playerid][1] = fY;
		tp_map_pos[playerid][2] = fZ;
		ShowPlayerDialog(playerid, 1299, DIALOG_STYLE_MSGBOX, "{E8CA1E}Телепорт", "\t{9ACD32}Уважаемый администратор!\n Вы подтверждаете действие: {9ACD32}переместиться на поставленную точку", "Да", "Нет");
		return 1;
	}
	return 1;
}
UpDateInv(playerid)
{
	PlayerVesItem[playerid]=0;
	for(new i = 1; i < MAX_SLOT; i++)
	{
		if(PlayerItem1[playerid][i] > 0)
		{
			PlayerVesItem[playerid] += Item[PlayerItem1[playerid][i]][iGG] * PlayerItem2[playerid][i];
		}
	}
}
CheckMaxVes(playerid,id,kol,&newslot=0)
{
	UpDateInv(playerid);
	new stek=0;
	if(Item[id][iStek]==1)
	{
		for(new s=1;s<MAX_SLOT;s++)
		{
			if(PlayerItem1[playerid][s]==id){newslot=s;stek=1;break;}
		}
		if(stek==0)
		{
			for(new s=1;s<MAX_SLOT;s++)
			{
				if(PlayerItem1[playerid][s]==0){newslot=s;stek=1;break;}
			}
		}
	}
	else
	{
		for(new s=1;s<MAX_SLOT;s++)
		{
			if(PlayerItem1[playerid][s]==0){newslot=s;stek=1;break;}
		}
	}
	if(stek==0){return SendClientMessage(playerid,COLOR_GREY,"У вас не хватает свободных слотов в сумке! (( Нужен 1 свободный слот))");}
	new ves=PlayerVesItem[playerid];
	ves+=Item[id][iGG]*kol;
	if(PI[playerid][pSprunk]<ves)
	{
		SCMF(playerid,COLOR_GREY,"У вас не хватает места в сумке! (( Нужно еще %d гр. свободного места ))",PI[playerid][pSprunk]-(Item[id][iGG]*kol));
		return true;
	}
	return false;
}
OnPlayerUseItem(playerid,list)
{
	new id = PlayerItem1[playerid][list];
	if(PlayerItem1[playerid][list]<=0)return SendClientMessage(playerid,COLOR_GREY,"Предмет не найден!");
	switch(id)
	{
	case 1:return GivePlayerWeapon(playerid,1,1);
	case 2:return GivePlayerWeapon(playerid,2,1);
	case 3:return GivePlayerWeapon(playerid,3,1);
	case 4:return GivePlayerWeapon(playerid,4,1);
	case 5:return GivePlayerWeapon(playerid,5,1);
	case 6:return GivePlayerWeapon(playerid,6,1);
	case 7:return GivePlayerWeapon(playerid,7,1);
	case 8:return GivePlayerWeapon(playerid,8,1);
	case 9:return GivePlayerWeapon(playerid,9,1);
	case 10:return GivePlayerWeapon(playerid,10,1);
	case 11:return GivePlayerWeapon(playerid,11,1);
	case 12:return GivePlayerWeapon(playerid,12,1);
	case 13:return GivePlayerWeapon(playerid,13,1);
	case 14:return GivePlayerWeapon(playerid,14,1);
	case 15:return GivePlayerWeapon(playerid,15,1);
	case 16:return SendErr(playerid, "Нельзя использовать данное оружие");
	case 17:return GivePlayerWeapon(playerid,17,1);
	case 18:return GivePlayerWeapon(playerid,18,1);
	case 19..35:{return ShowPlayerDialog(playerid,2200,DIALOG_STYLE_INPUT,""cMain"Зарядить оружие", "\n\n"cWH"Введите сумму патронов,\nКоторыми хотите зарядить оружие:", "Зарядить", "Отмена");}
	case 36:return GivePlayerWeapon(playerid,41,250);
	case 37:return GivePlayerWeapon(playerid,42,1000);
	case 38: GivePlayerWeapon(playerid,43,30);
	case 39:return GivePlayerWeapon(playerid,46,1);
	case 40:return callcmd::play(playerid);
	case 41:return callcmd::time(playerid);
	case 42:{return SendClientMessage(playerid,COLOR_GREY,"Этот предмет нельзя использовать!");}
	case 44:return callcmd::usedrugs(playerid);
	case 45:return callcmd::mask(playerid);
	case 46:return callcmd::smoke(playerid);
	case 47:return callcmd::phone(playerid);
	case 48:return callcmd::tools(playerid);
	case 49:return callcmd::fuel(playerid);
	case 50..54:
		{
			new Float:amount;
			GetPlayerHealth(playerid, amount);
			if(amount > 98.0) return SendClientMessage(playerid, -1, ""cER"Вы не хотите кушать!");
			GiveHealth(playerid, 2);format(string, sizeof(string), "%s ест %s", GetName(playerid),Item[id][iName]);
		}
	case 55..59:
		{
			new Float:amount;
			GetPlayerHealth(playerid, amount);
			if(amount > 97.0) return SendClientMessage(playerid, -1, ""cER"Вы не хотите кушать!");
			GiveHealth(playerid, 3);format(string, sizeof(string), "%s ест %s", GetName(playerid),Item[id][iName]);
		}
	case 60..64:
		{
			new Float:amount;
			GetPlayerHealth(playerid, amount);
			if(amount > 96.0) return SendClientMessage(playerid, -1, ""cER"Вы не хотите кушать!");
			GiveHealth(playerid, 4);format(string, sizeof(string), "%s ест %s", GetName(playerid),Item[id][iName]);
		}
	case 65..69:
		{
			new Float:amount;
			GetPlayerHealth(playerid, amount);
			if(amount > 95.0) return SendClientMessage(playerid, -1, ""cER"Вы не хотите кушать!");
			GiveHealth(playerid, 5);format(string, sizeof(string), "%s ест %s", GetName(playerid),Item[id][iName]);
		}
	case 70:
		{
			new Float:amount;
			GetPlayerHealth(playerid, amount);
			if(amount > 97.0) return SendClientMessage(playerid, -1, ""cER"Вы не хотите пить!");
			GiveHealth(playerid, 3);format(string, sizeof(string), "%s пьет %s", GetName(playerid),Item[id][iName]);SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DRINK_SPRUNK);
		}
	case 105:
		{
			new str[45];
			format(str,sizeof(str),"%s",(Mfon[playerid][p_mfon]) ? ("{ff0000}Выключить\n"cWH"Сменить станцию") : ("{00ff00}Включить"));
			ShowPlayerDialog(playerid,12007,DIALOG_STYLE_LIST,""cWH"Магнитофон",str,"Выбор","Отмена");
			format(string, sizeof(string), "%s установил %s", GetName(playerid),Item[id][iName]);
		}
	case 107:
		{
			new temp = PI[playerid][pModel];
			PI[playerid][pModel] = PlayerItem2[playerid][list];
			PlayerItem2[playerid][list] = temp;
			if(PI[playerid][pMember]) SendClientMessage(playerid, 0xFFFF00FF, "Вы изменили гражданскую одежду");
   			else
      		{
        		SendClientMessage(playerid, COLOR_GREY, "Вы переоделись");
          		SetPlayerSkin(playerid, PI[playerid][pModel]);
          		format(string, sizeof(string), "%s переоделся", GetName(playerid));
          		ProxDetector(15, playerid, string, COLOR_PURPLE);
			}
			return 1;
		}
	}
	ProxDetector(15, playerid, string, COLOR_PURPLE);
	PlayerItem2[playerid][list]--;
	SaveItem(playerid,list);
	return true;
}

GetGunIdInItem(item)
{
	switch(item)
	{
	case 1..15:{return item;}
	case 19:return 22;
	case 20:return 23;
	case 21:return 24;
	case 22:return 25;
	case 23:return 26;
	case 24:return 27;
	case 25:return 28;
	case 26:return 29;
	case 27:return 30;
	case 28:return 31;
	case 29:return 32;
	case 30:return 33;
	case 31:return 34;
	case 32:return 35;
	case 33:return 36;
	case 35:return 38;
	default:return false;
	}
	return false;
}
CheckUseGun(playerid,item,oks=0)
{
	new idgun=GetGunIdInItem(item);
	if(idgun==0)return false;
	new weapons[13][2],ok=0;
	for (new i = 0; i <= 12; i++)
	{
		GetPlayerWeaponData(playerid, i, weapons[i][0], weapons[i][1]);
		if(weapons[i][0]==idgun)
		{
			for(new s=1;s<MAX_SLOT;s++)
			{
				if(PlayerItem1[playerid][s]==item){ok++;}
			}
			break;
		}
	}
	if(ok==1&&oks==1)return true;
	if(ok==1&&oks==0)return SendClientMessage(playerid,COLOR_GREY,"Прежде чем передать/выкинуть уберите оружие. (/unammo)");
	return false;
}

public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
	EngineStalled[playerid]++;

	if(EngineStalled[playerid] >= 7 && Engine[vehicleid] == true && !VehicleGodMode[vehicleid])
	{
		if(TYPE_VIP[playerid] == VIP_STATE_NONE)
		{
			Engine[vehicleid] = false;
			GetVehicleParamsEx(vehicleid,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			SetVehicleParamsEx(vehicleid,false,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			GameTextForPlayer(playerid, "ДВИГАТЕЛЬ ~r~ВЫКЛ", 1000, 6);
			EngineStalled[playerid] = 0;
		}
		if(TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipEngine] == 0)
		{
			Engine[vehicleid] = false;
			GetVehicleParamsEx(vehicleid,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			SetVehicleParamsEx(vehicleid,false,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			GameTextForPlayer(playerid, "ДВИГАТЕЛЬ ~r~ВЫКЛ", 1000, 6);
			EngineStalled[playerid] = 0;
		}
	}
	return 1;
}
emptyMessage(text[])
{
	for(new i; text[i] != 0x0; i++)
	{
		switch(text[i])
		{
		case 0x20: continue;
		default: return 0;
		}
	}
	return 1;
}
SetPlayerSkills(playerid)
{
	SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL_SILENCED, 		1000);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_DESERT_EAGLE, 		1000);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_SHOTGUN, 				1000);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_MP5, 					1000);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_AK47, 				1000);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_M4, 					1000);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL, 				1000);
