	SendMes(playerid, COLOR_GREEN, "Вы изменили ранг администратору %s на %s", g_player_full_name[ player_full_id[playerid] ][playerid], inputtext);
	return 1;
}
DLG(DIALOG_WL_ADD, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	if(null(inputtext))
		return ShowPlayerDialog(playerid, DIALOG_WL_ADD, DIALOG_STYLE_INPUT, ""cMain"Whitelist", ""cWH"Enter nickname in format Name_Surname:", "Add", "Cancel");

	if(strlen(inputtext) > (MAX_PLAYER_NAME - 1))
		return SendClientMessage(playerid, COLOR_RED, "Nickname is too long.");

	if(IsLoginInvalid(inputtext))
		return SendClientMessage(playerid, COLOR_RED, "Invalid nickname format. Use Name_Surname.");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT id FROM whitelist WHERE name = '%e' LIMIT 1", inputtext);
	mysql_tquery(db_prod, STRING_GLOBAL, "WhitelistAddCheck", "is", playerid, inputtext);
	return 1;
}

DLG(DIALOG_WL_LIST, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(listitem < 0 || listitem >= g_whitelist_item_count[playerid]) return 1;

	g_whitelist_selected_id[playerid] = g_whitelist_item_id[playerid][listitem];
	ShowPlayerDialog(playerid, DIALOG_WL_ACTION, DIALOG_STYLE_LIST, ""cMain"Whitelist action", "1. Remove from whitelist", "Select", "Back");
	return 1;
}

DLG(DIALOG_WL_ACTION, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::whitelist(playerid);

	if(listitem == 0)
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM whitelist WHERE id = '%d' LIMIT 1", g_whitelist_selected_id[playerid]);
		mysql_tquery(db_prod, STRING_GLOBAL, "WhitelistDeleteDone", "ii", playerid, g_whitelist_selected_id[playerid]);
	}
	return 1;
}

DLG(DIALOG_WL_DENY, playerid, response, listitem, inputtext[])
