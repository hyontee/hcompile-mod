	format(global_string, 256, "\n\
	"cWH"Введите кол-во патрон, которое хотите положить в багажник.\n\
	"cLGREY"Примечание: в багажнике %i патрон", patron);

	ShowPlayerDialog(playerid,2423, DIALOG_STYLE_INPUT, !""cMain"Багажник автомобиля", global_string, !"Положить", !"Закрыть");
	return true;
}

