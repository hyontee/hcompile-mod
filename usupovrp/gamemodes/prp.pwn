        format(string, sizeof(string), "[F-MSG] %s[%d] rankname %d set %s in %s", GetName(playerid), playerid, list, inputtext, Fraction_Name[PI[playerid][pMember]]);
		SendAdminMessage(COLOR_GREY, string);
	}
	return 1;
