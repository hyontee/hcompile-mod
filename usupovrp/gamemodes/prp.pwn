DLG(7584, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];
		if(IsValidBankAccount(playerid, accountid))
		{
			new tmp;
			for(new index; index < 5; index ++)
			{
				if(!IsValidBankAccount(playerid, index)) continue;
				if(accountid == index)
				{
					tmp = 1;
					break;
				}
			}
			if(!tmp)
			{
				printf("[debug] %s %d %d", GetName(playerid), PI[playerid][pID], accountid);
				return 1;
			}
			new take_sum = strval(inputtext);
			if(take_sum > 0 && IsNumeric(inputtext))
			{
				if(take_sum > 100000000) return SendClientMessage(playerid, 0xCCCCCCFF, "Снять можно только 100млн.");
				if((PI[playerid][pCash] + take_sum) > 2000000000) return SendClientMessage(playerid, 0xCCCCCCFF, "Не возможно снять со счета такую сумму, превышен лимит");
				if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 0)
				{
					if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) >= take_sum)
					{
						g_player_bank_accounts[playerid][accountid][B_BALANCE] -= take_sum;

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
						mysql_tquery(db_prod, STRING_GLOBAL);

						format(global_string, sizeof global_string, "Ваша операция выполнена успешна. Вы сняли со счета \"%s\" %d рублей.", GetPlayerBankAccountData(playerid, accountid, B_NAME), take_sum);
						SendClientMessage(playerid, 0xFFCC00AA, global_string);

						SetPlayerMoney(playerid, take_sum);

						format(stringer1, sizeof stringer1, "- Снятие на сумму %d рублей", take_sum);
						SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
						UpdateBankMoneyText(playerid, accountid);
					}
					else SendClientMessage(playerid, COLOR_RED, "На этом счету недостаточно денег");
				}
				if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1)
				{
					if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) >= take_sum)
					{
						g_player_bank_accounts[playerid][accountid][B_BALANCE] -= take_sum;

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
						mysql_tquery(db_prod, STRING_GLOBAL);


						format(global_string, sizeof global_string, "Ваша операция выполнена успешна. Вы сняли со счета \"%s\" %d евро.", GetPlayerBankAccountData(playerid, accountid, B_NAME), take_sum);
						SendClientMessage(playerid, 0xFFCC00AA, global_string);

						TransferEuro(-1, playerid, take_sum, "Снял с банка");
						format(stringer1, sizeof stringer1, "- Снятие на сумму %d евро", take_sum);
						SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
						UpdateBankMoneyText(playerid, accountid);
					}
					else SendClientMessage(playerid, COLOR_RED, "На этом счету недостаточно денег");
				}
			}
		}
	}
	return 1;
}
DLG(8692, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];
		if(IsValidBankAccount(playerid, accountid))
		{
			new put_sum = strval(inputtext);
			if(put_sum > 0 && IsNumeric(inputtext))
			{
				if((g_player_bank_accounts[playerid][accountid][B_BALANCE] + put_sum) > 2000000000) return SendClientMessage(playerid, 0xCCCCCCFF, "Не возможно пополнить данный счет на такую сумму");
				if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 0)
				{
					if(GetPlayerRubble(playerid) >= put_sum)
					{
						g_player_bank_accounts[playerid][accountid][B_BALANCE] += put_sum;
						SetPlayerMoney(playerid, -put_sum);

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
						mysql_tquery(db_prod, STRING_GLOBAL);

						SCMF(playerid, 0xFFCC00AA, "Ваша операция выполнена успешна. Вы пополнили на счёт \"%s\" %d рублей.", GetPlayerBankAccountData(playerid, accountid, B_NAME), put_sum);

						format(stringer1, sizeof stringer1, "+ Пополнение на сумму %d рублей", put_sum);
						SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);

						UpdateBankMoneyText(playerid, accountid);

					}
					else SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно денег");
				}
				if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1)
				{
					if(playerEuro[playerid] >= put_sum)
					{
						if(g_player_bank_accounts[playerid][accountid][B_BALANCE] + put_sum < -100000000) return SendClientMessage(playerid, COLOR_RED, "У Вас будет достигнут лимит денег на этом счете");

						g_player_bank_accounts[playerid][accountid][B_BALANCE] += put_sum;
						TransferEuro(playerid, -1, put_sum, "Положил в банк");

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
						mysql_tquery(db_prod, STRING_GLOBAL);

						SCMF(playerid, 0xFFCC00AA, "Ваша операция выполнена успешна. Вы пополнили на счёт \"%s\" %d евро.", GetPlayerBankAccountData(playerid, accountid, B_NAME), put_sum);

						format(stringer1, sizeof stringer1, "+ Пополнение на сумму %d евро", put_sum);
						SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);

						UpdateBankMoneyText(playerid, accountid);

					}
					else SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно денег");
				}
			}
		}
	}
	return 1;
}
DLG(6367, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 12) return SendClientMessage(playerid,COLOR_GREY,"Перекидывать средства на другой счет можно только отыграв 12 часов (12 EXP)");

		new accountid = g_player_listitem_use[playerid];
		if(!IsValidBankAccount(playerid, accountid))
		return 1;

		new id, sum;

		if(sscanf(inputtext, "p<,>dd", id, sum))
		return SendClientMessage(playerid, COLOR_RED, "Вы допустили ошибку в вводе данных");

		if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < sum)
		return SendClientMessage(playerid, COLOR_RED, "На Вашем счету недостаточно денег");

		if(!(0 < sum < 999999999))
		return SendClientMessage(playerid, COLOR_RED, "На Вашем счету недостаточно денег");

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `bank_accounts` WHERE `id` = '%d'", id);
		mysql_tquery(db_prod, STRING_GLOBAL, "TransferBank", "dddd", playerid, id, sum, accountid);
	}
	return 1;
}
DLG(7341, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];

		if(!IsValidBankAccount(playerid, accountid))
		return 1;

		global_string = "";

		switch(listitem)
		{
		case 0:
			{
				new id = GetPlayerHouse(playerid);
				if(id == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет дома!");

				format(global_string, 320, ""cWH"Укажите количество дней, на которое хотите оплатить дом(не более 7):\n\n\
				Количество уже оплаченных дней: {E9D70C}%d дн.\n\
				"cWH"Доступное количество дней для оплаты: {E9D70C}%d дней\n\
				"cWH"Сумма аренды в сутки составляет: {E9D70C}%d руб.\n\n\
				"cWH"Введите количество дней оплаты в строчку ниже:",
				HouseInfo[id][hOplata], 7 - HouseInfo[id][hOplata], GetHomeOplata(id));
				ShowPlayerDialog(playerid, 8215, 1, ""cMain"Оплата дома", global_string, "Принять", "Назад");
			}
		case 1:
			{
				new id = GetPlayerRooms(playerid);
				if(id == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет квартиры!");
				format(global_string, 320, ""cWH"Укажите количество дней, на которое хотите оплатить квартиру(не более 7):\n\n\
			Количество уже оплаченных дней: {E9D70C}%d дн.\n\
			"cWH"Доступное количество дней для оплаты: {E9D70C}%d дней\n\
			"cWH"Сумма аренды в сутки составляет: {E9D70C}%d руб.\n\n\
			"cWH"Введите количество дней оплаты в строчку ниже:",
				RoomsInfo[id][rOplata],
				7 - RoomsInfo[id][rOplata], GetRoomOplata(id));

				ShowPlayerDialog(playerid, 4671, 1, ""cMain"Оплата квартиры", global_string, "Принять", "Назад");
			}
		case 2:
			{
				new g = GetPlayerGarage(playerid);
				if(g == -1) return SendClientMessage(playerid, COLOR_RED, "У Вас нет гаража");

				format(global_string, 320, ""cWH"Укажите количество дней, на которое хотите оплатить гараж(не более 7):\n\n\
			Количество уже оплаченных дней: {E9D70C}%d дн.\n\
			"cWH"Доступное количество дней для оплаты: {E9D70C}%d дн.\n\
			"cWH"Сумма аренды в сутки составляет: {E9D70C}%d руб.\n\n\
			"cWH"Введите количество дней оплаты в строчку ниже:", GarageInfo[g][g_DAY], 7 - GarageInfo[g][g_DAY], GaragePayment(GarageInfo[g][g_TYPE]));
				ShowPlayerDialog(playerid, 7565, DIALOG_STYLE_INPUT, "{DEE914}Оплата гаража", global_string, "Далее", "Выход");
			}
		case 3:
			{
				new id = GetPlayerBizz(playerid);
				if(id == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет бизнеса!");
				format(global_string, 320, ""cWH"Укажите количество дней, на которое хотите оплатить бизнес(не более 7):\n\n\
				Количество уже оплаченных дней: {E9D70C}%d дн.\n\
				"cWH"Доступное количество дней для оплаты: {E9D70C}%d дней\n\
				"cWH"Сумма аренды в сутки составляет: {E9D70C}2000 рублей\n\n\
				"cWH"Введите количество дней оплаты в строчку ниже:",
				BizzInfo[id][bOplata],
				7 - BizzInfo[id][bOplata]);
				ShowPlayerDialog(playerid, 8346, 1, ""cMain"Оплата бизнеса", global_string, "Принять", "Назад");
			}
		}
	}
	return 1;
}
DLG(8215, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];
		if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");
		new h = GetPlayerHouse(playerid), dayss = strval(inputtext), g_rent = GetHomeOplata(h) * dayss;

		if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < g_rent) return SendClientMessage(playerid, COLOR_RED, "У Вас не хватает средств для оплаты аренды дома");
		if(dayss < 1 || dayss > 7) return SendClientMessage(playerid, COLOR_RED, "Количество дней от 1 до 7");
		if((HouseInfo[h][hOplata] + dayss) > 7) return SendClientMessage(playerid, COLOR_RED, "Нельзя оплатить более чем на 7 дней");

		HouseInfo[h][hOplata] += dayss;
		SCMF(playerid, COLOR_GREEN, "Вы оплатили дом на %d дней. С Вашего счета списано: %d рублей", dayss, g_rent);

		g_player_bank_accounts[playerid][accountid][B_BALANCE] -= g_rent;
		MysqlUpdateHouseInt(h, "hOplata", HouseInfo[h][hOplata]);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
		mysql_tquery(db_prod, STRING_GLOBAL);

		format(stringer1, sizeof stringer1, "- Пополнение дома %d рублей", g_rent);
		SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
		UpdateBankMoneyText(playerid, accountid);
	}
	return 1;
}
DLG(4671, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];

		if(!IsValidBankAccount(playerid, accountid))
		return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");

		new h = GetPlayerRooms(playerid);
		new dayss = strval(inputtext), g_rent = GetRoomOplata(h) * dayss;

		if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < g_rent)
		return SendClientMessage(playerid, COLOR_RED, "У Вас не хватает средств для оплаты аренды квартиры");

		if(!dayss)
		return SendClientMessage(playerid, COLOR_RED, "Количество дней не может быть равно 0 или быть менее 0");

		if(dayss < 1 || dayss > 7)
		return SendClientMessage(playerid, COLOR_RED, "Количество дней от 1 до 7");

		if((RoomsInfo[h][rOplata] + dayss) > 7)
		return SendClientMessage(playerid, COLOR_RED, "Нельзя оплатить более чем на 7 дней");

		RoomsInfo[h][rOplata] += dayss;

		SCMF(playerid, COLOR_GREEN, "Вы оплатили квартиру на %d дней. С Вашего счета списано: %d рублей", dayss, g_rent);

		g_player_bank_accounts[playerid][accountid][B_BALANCE] -= g_rent;
		SetRoomsInt(h, "rOplata", RoomsInfo[h][rOplata]);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
		mysql_tquery(db_prod, STRING_GLOBAL);

		format(stringer1, sizeof stringer1, "- Пополнение аренды квартиры %d рублей", g_rent);
		SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
		UpdateBankMoneyText(playerid, accountid);
	}
	return 1;
}
DLG(7565, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];

		if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");
		new dayss = strval(inputtext), g = GetPlayerGarage(playerid), g_rent = GaragePayment(GarageInfo[g][g_TYPE]) * dayss;

		if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < g_rent) return SendClientMessage(playerid, COLOR_RED, "У Вас не хватает средств для оплаты аренды гаража");
		if(!dayss) return SendClientMessage(playerid, COLOR_RED, "Количество дней не может быть равно 0 или быть менее 0");
		if(dayss < 1 || dayss > 7) return SendClientMessage(playerid, COLOR_RED, "Количество дней от 1 до 7");
		if((GarageInfo[g][g_DAY] + dayss) > 7) return SendClientMessage(playerid, COLOR_RED, "Нельзя оплатить более чем на 7 дней");

		GarageInfo[g][g_DAY] += dayss;
		SCMF(playerid, COLOR_GREEN, "Вы оплатили гараж на %d дней. С Вашего счета списано: %d рублей", dayss, g_rent);

		g_player_bank_accounts[playerid][accountid][B_BALANCE] -= g_rent;

		SaveGarageData(g);

		format(stringer1, sizeof stringer1, "- Пополнение гаража %d рублей", g_rent);
		SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
		UpdateBankMoneyText(playerid, accountid);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
		mysql_tquery(db_prod, STRING_GLOBAL);
	}
	return 1;
}
DLG(8346, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];
		if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");

		new h = GetPlayerBizz(playerid);
		new dayss = strval(inputtext), g_rent = 2000 * dayss;
		if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < g_rent) return SendClientMessage(playerid, COLOR_RED, "У Вас не хватает средств для оплаты аренды бизнеса");
		if(dayss < 1 || dayss > 7) return SendClientMessage(playerid, COLOR_RED, "Количество дней от 1 до 7");
		if((BizzInfo[h][bOplata] + dayss) > 7) return SendClientMessage(playerid, COLOR_RED, "Нельзя оплатить более чем на 7 дней");
		SCMF(playerid, COLOR_GREEN, "Вы оплатили бизнес на %d дней. С Вашего счета списано: %d рублей", dayss, g_rent);

		g_player_bank_accounts[playerid][accountid][B_BALANCE] -= g_rent;
		BizzInfo[h][bOplata] += dayss;
		MysqlUpdateBizzInt(h, "oplata", BizzInfo[h][bOplata]);

		format(stringer1, sizeof stringer1, "- Пополнение бизнеса %d рублей", g_rent);
		SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
		UpdateBankMoneyText(playerid, accountid);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
		mysql_tquery(db_prod, STRING_GLOBAL);
	}
	return 1;
}
DLG(9434, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];
		if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");

		new price;

		if(sscanf(inputtext, "i", price) || !(1 <= price <= 10000000)) return ShowPlayerBankAccountCharity(playerid);
		if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < price)
		{
			SendClientMessage(playerid, COLOR_RED, ""cER"У вас не хватает денег");
			return ShowPlayerBankAccountCharity(playerid);
		}
		if((FracBank[9] + price) > 2000000000)
		{
			SendErr(playerid, "В казне слишком много денег");
			ShowPlayerBankAccountCharity(playerid);
			return 1;
		}
		PI[playerid][pCharity] += price;
		if(PI[playerid][pCharity] > 2000000000) PI[playerid][pCharity] = 2000000000;
		MysqlUpdatePlayerInt(playerid, "charity", PI[playerid][pCharity]);

		g_player_bank_accounts[playerid][accountid][B_BALANCE] -= price;
		SetMeriaCash(price);
		MysqlUpdateOtherInt("sfnbank", FracBank[9]);

		SendMes(playerid, COLOR_YELLOW, "Вы пожертвовали на благотворительность "cWH"%dр{FFFF00}. Список самых щедрых: "cWH"/charity", price);

		format(stringer1, sizeof stringer1, "- Пожертвование %d рублей", price);
		SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
		UpdateBankMoneyText(playerid, accountid);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
		mysql_tquery(db_prod, STRING_GLOBAL);
	}
	return 1;
}
