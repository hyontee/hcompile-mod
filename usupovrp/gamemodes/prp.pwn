		return 1;
	}
	new id = safeid[playerid], newslot;
	if(HouseInfo[id][hPatrons] < patr)
	{
		SendClientMessage(playerid, COLOR_GREY, "В сейфе нет такого количества патронов");
		ShowCupboard(playerid);
		return 1;
	}
	if(CheckMaxVes(playerid,42,patr,newslot)==1) return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
	HouseInfo[id][hPatrons] -= patr;
	format(stringer1, sizeof stringer1, "UPDATE `house` SET `hPatrons` = '%d' WHERE `id` = '%d'", HouseInfo[id][hPatrons], HouseInfo[id][hID]);
	mysql_tquery(db_prod, stringer1, "","");
	SCMF(playerid, COLOR_GREEN, "Вы взяли из сейфа %d патронов", patr);
	UpdateCupboard(id);
	PlayerItem1[playerid][newslot]= 42;
	PlayerItem2[playerid][newslot]+= patr;
	SaveItem(playerid,newslot);
	return ShowCupboard(playerid);
}
