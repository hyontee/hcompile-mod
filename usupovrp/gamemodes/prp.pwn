DLG(4201, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new till = 0;
	if(sscanf(inputtext, "i", till)) return ShowPlayerDialog(playerid, 4200+1, 1, ""cMain"Положить патроны", ""cWH"Введите количество патронов:", "Принять", "Отмена");
	if(till < 0) return ShowPlayerDialog(playerid, 4200+1, 1, ""cMain"Положить патроны", ""cWH"Введите количество патронов:", "Принять", "Отмена");
	new ok = SearchInventoryItem(playerid, 42);
	new i = (PI[playerid][pMember] == TEAM_ITALMAFIA) ? (0) : (1);
	if(PlayerItem2[playerid][ok]<strval(inputtext))return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько патронов");
	if(PlayerItem2[playerid][ok] == 0)
	{
		PlayerItem1[playerid][ok]=0;
	}
	PlayerItem2[playerid][ok]-=till;
	MafiaPatr[i] += till;

	new Query[128];
	format(Query, sizeof(Query), "UPDATE `mafia` SET lcnpat=%d,yakpat=%d,rmpat=%d", MafiaPatr[0], MafiaPatr[1], MafiaPatr[2]);
	mysql_tquery(db_prod, Query, "", "");

	format(string, 90, "Вы положили на склад мафии патроны (+%d)", till);
	SendClientMessage(playerid, COLOR_GREEN, string);
	if(PI[playerid][pSex] == 1) format(string, 90, "%s[%d] положил на склад мафии %d патрон", GetName(playerid), playerid, till);
	else format(string, 90, "%s[%d] положила на склад мафии %d патрон", GetName(playerid), playerid, till);
	SendFMes(PI[playerid][pMember], COLOR_YELLOW2, string);

	UpDateInv(playerid);
	SaveItem(playerid,ok);
	return 1;
}
DLG(4203, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new till = 0;
	if(sscanf(inputtext, "i", till)) return ShowPlayerDialog(playerid, 4200+3, 1, ""cMain"Положить деньги", ""cWH"Введите количество денег:", "Принять", "Отмена");
	if(till < 0) return ShowPlayerDialog(playerid, 4200+3, 1, ""cMain"Положить деньги", ""cWH"Введите количество денег:", "Принять", "Отмена");
	if(till > GetPlayerRubble(playerid) || till < 0) return SendClientMessage(playerid, -1, ""cER"У Вас нет столько денег!");
	new i = (PI[playerid][pMember] == TEAM_ITALMAFIA) ? (6) : (5);
	if(FracBank[i] + till > 2000000000) return SendClientMessage(playerid, COLOR_RED, "Вы не можете пополнить склад денег более чем 2000000000 рублей");

	SetPlayerMoney(playerid, -till);
	FracBank[i] += till;

	new Query[83];
	format(Query, sizeof(Query), "UPDATE `mafia` SET yakuzabank=%d,lcnbank=%d,rmbank=%d", FracBank[5], FracBank[6], FracBank[7]);
	mysql_tquery(db_prod, Query, "", "");

	format(string, 90, "Вы положили на склад мафии %dр", till);
	SendClientMessage(playerid, COLOR_GREEN, string);
	if(PI[playerid][pSex] == 1) format(string, 90, "%s[%d] положил на склад мафии %dр", GetName(playerid), playerid, till);
	else format(string, 90, "%s[%d] положила на склад мафии %dр", GetName(playerid), playerid, till);
	SendFMes(PI[playerid][pMember], COLOR_YELLOW2, string);
	return 1;
}
DLG(4209, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new till;
	if(sscanf(inputtext, "i", till)) return ShowPlayerDialog(playerid, 4200+9, 1, ""cMain"Положить материалы", ""cWH"Введите количество материалов:","Принять", "Отмена");
