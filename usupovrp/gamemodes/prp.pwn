			metall_info[idx][mLoading] = -1;

			Iter_Remove(VehicleGun, idx);
		}
	}

	if(!response) RemovePlayerFromVehicle(playerid);
	return 1;
}
DLG(6612, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(PI[playerid][P_TO_MP_POS_X] == 0.0 || PI[playerid][P_TO_MP_POS_Y] == 0.0)
		return SendClientMessage(playerid, COLOR_RED, "При загрузке Ваших координат произошла ошибка");

		SetPlayerPos(playerid, PI[playerid][P_TO_MP_POS_X], PI[playerid][P_TO_MP_POS_Y], PI[playerid][P_TO_MP_POS_Z]);
		SetPlayerVirtualWorld(playerid, PI[playerid][P_TO_MP_POS_WV]);
		SetPlayerVirtualWorld(playerid, PI[playerid][P_TO_MP_POS_INT]);

		PI[playerid][P_TO_MP_POS_X] =
		PI[playerid][P_TO_MP_POS_Y] =
		PI[playerid][P_TO_MP_POS_Z] = 0.0;

		PI[playerid][P_TO_MP_POS_WV] =
		PI[playerid][P_TO_MP_POS_INT] = 0;
	}
	else
	{
		PI[playerid][P_TO_MP_POS_X] =
		PI[playerid][P_TO_MP_POS_Y] =
		PI[playerid][P_TO_MP_POS_Z] = 0.0;

		PI[playerid][P_TO_MP_POS_WV] =
		PI[playerid][P_TO_MP_POS_INT] = 0;
	}
	return 1;
}
