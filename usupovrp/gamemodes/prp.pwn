stock CheckNick_krossplatforma(playerid)
{
	new name_string[MAX_PLAYER_NAME];

	foreach(new i : Player)
	{
		if(i == playerid) continue;
		if(!strcmp(GetName(playerid), GetName(i), true))
		{
			SCMF(playerid, -1, "Игрок с вашим никнеймом %s уже играет под ID %d, используйте другое имя для входа.", GetName(playerid), i);
			return 0;
		}
	}

	if(!strcmp("Nick_Name", GetName(playerid), true))
	{
		SCM(playerid, -1, "Вы не сменили ник-нейм в лаунчере. Просьба, поставьте свой ник в настройках.");
		return 0;
	}

	if(strlen(GetName(playerid)) > 18)
	{
		SCM(playerid, -1, "Ваш никнейм содержит более 18 символов. Пожалуйста, используйте от 3 до 18 символов в нике.");
		SCM(playerid, -1, "Если вас переподключило - перезайдите, это поможет.");
		return 0;
	}

	format(name_string, MAX_PLAYER_NAME, "%s", GetName(playerid));
	strdel(name_string, 0, strlen(name_string)-2);

	if(!strcmp(name_string, "_M", true))
	{
		SCM(playerid, -1, "Некорректный никнейм. Перезайдите, если вам это не поможет - поменяйте никнейм в лаунчере.");
		SCM(playerid, -1, "Если вас переподключило - перезайдите, это поможет.");
		SCM(playerid, -1, "Ошибка: Последние два символа вашего ника '_M', это запрещено!");

		return 0;
	}
	return 1;
}

stock delete_game_start_PTD(playerid)
{
	if(start_game_PTD[playerid][0] != PlayerText:INVALID_TEXT_DRAW)
	{
		PlayerTextDrawHide(playerid, start_game_PTD[playerid][0]);

		PlayerTextDrawDestroy(playerid, start_game_PTD[playerid][0]);
		start_game_PTD[playerid][0] = PlayerText:INVALID_TEXT_DRAW;
	}

	for(new i; i < 3; i ++)
	{
		TextDrawHideForPlayer(playerid, start_game_TD[i]);
	}
}

