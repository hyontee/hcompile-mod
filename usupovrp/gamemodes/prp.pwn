callback::LoadActors()
{
	new time = GetTickCount();
	new rows, fields;
	cache_get_data(rows, fields);
	for(new idx = 0; idx < rows; idx++)
	{
		new actor_string[64];

		ActorsData[idx][a_ID] = cache_get_field_content_int(idx, "actor_id");
		ActorsData[idx][a_SKIN] = cache_get_field_content_int(idx, "actor_skin");
		ActorsData[idx][a_WORLD] = cache_get_field_content_int(idx, "actor_world");
		ActorsData[idx][a_INT] = cache_get_field_content_int(idx, "actor_int");
		cache_get_field_content(idx, "actor_name", ActorsData[idx][a_NAME], db_prod, 64);

		cache_get_field_content(idx, "actor_position", actor_string, db_prod, 64);
		sscanf(actor_string, "p<,>a<f>[4]", ActorsData[idx][a_POS]);

		ActorsData[idx][a_CREATE] = CreateDynamicActor(ActorsData[idx][a_SKIN], ActorsData[idx][a_POS][0], ActorsData[idx][a_POS][1], ActorsData[idx][a_POS][2], ActorsData[idx][a_POS][3], true, 100.0, ActorsData[idx][a_WORLD], ActorsData[idx][a_INT]);

		format(actor_string, sizeof(actor_string), "%s [NPC:%d]",ActorsData[idx][a_NAME], ActorsData[idx][a_ID]);
		ActorsData[idx][a_3DTEXT] = CreateDynamic3DTextLabel(actor_string, COLOR_RED, ActorsData[idx][a_POS][0], ActorsData[idx][a_POS][1], ActorsData[idx][a_POS][2]+1.2, 20.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, ActorsData[idx][a_WORLD], ActorsData[idx][a_INT]);
	}
	printf("[Загружено актеров]: <%d>. Потрачено: <%d ms>.", rows, GetTickCount() - time);
	return true;
}

SaveMats()
{
	format(stringer, sizeof(stringer), "UPDATE `gang` SET spartak_mats=%d,cska_mats=%d,itmaf_mats=%d,rusmaf_mats=%d,army_mats=%d", Mats[0], Mats[1], Mats[2], Mats[3], Mats[4]);
	mysql_tquery(db_prod, stringer);
	return 1;
}

cmd:setpatr(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 0;
	if(sscanf(params, "i", params[0])) return 1;

	gArmyWarehouse[1] += params[0];
	SendMes(playerid, -1, ""cDA"Вы добавили на склад армии %d патронов", params[0]);
	fLogs("[admin] %s /setpatr %i", GetName(playerid), params[0]);
	return 1;
}

cmd:setmats(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 0;
	if(sscanf(params, "i", params[0])) return 1;
	materials += params[0];

	global_string = "";
	mysql_format(db_prod, global_string, 128, "UPDATE `other` SET materials = '%d'", materials);
	mysql_tquery(db_prod, global_string, "", "");

	WHDataUpdate();

	SendMes(playerid, -1, ""cDA"Вы добавили на главный склад %d материалов", params[0]);
	fLogs("[admin] %s /setmats %i", GetName(playerid), params[0]);
	return 1;
}
SaveWarehouse()
{
	format(stringer1, sizeof(stringer1), "UPDATE `other` SET armygun=%d,armyammo=%d", gArmyWarehouse[0], gArmyWarehouse[1]);
	mysql_tquery(db_prod, stringer1, "", "");
	return 1;
}
