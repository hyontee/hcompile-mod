DLG(145, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new i = PlayerHouseSelect[playerid];
	HouseInfo[i][hLock] = 0;
	GameTextForPlayer(playerid, "~g~открыто", 5000, 5);
	MeAction(playerid, "открывает замок дома");
	MysqlUpdateHouseInt(i, "hLock", HouseInfo[i][hLock]);

	SetPlayerPos(playerid,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]);
	switch(HouseInfo[i][hDiscript])
	{
	case 1: SetPlayerFacingAngle(playerid, 90.0);
	case 2: SetPlayerFacingAngle(playerid, 89.0109);
	case 3: SetPlayerFacingAngle(playerid, 180.7951);
	}
	SetPlayerInterior(playerid,HouseInfo[i][hInt]);
	SetPlayerVirtualWorld(playerid,HouseInfo[i][hVirtual]);

	PI[playerid][pInHouse] = i;

	PlayerHouseSelect[playerid] = 0;
	return 1;
}
DLG(2600, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
		case 0:
		{
			mysql_format(db_prod, global_string,sizeof global_string,"SELECT * FROM `fines` WHERE Name = '%s'",GetName(playerid));
			mysql_tquery(db_prod, global_string, "CheckTickets","dd", playerid, 0);
		}
		case 1:
		{
			if(GetPlayerRubble(playerid) < 100000) return SendClientMessage(playerid, -1, ""cER"У вас недостаточно денежных средств");
			ShowPlayerDialog(playerid, 5600, DIALOG_STYLE_MSGBOX, ""cMain"Пункт выдачи номеров", "\
			{63BD4E}Требования:\n\
			"cWH"- Наличие паспорта\n\
			- Наличие водительского удостоверения\n\
			- Документы на автомобиль\n\n\
			{afafaf}Если все это у вас есть, нажмите `Далее`", "Далее", "Закрыть");
		}
		case 2: callcmd::freecar(playerid);
	}
	return 1;
}
