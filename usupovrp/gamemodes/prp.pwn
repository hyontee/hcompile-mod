					SetPlayerFacingAngle(playerid, 360.0);
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerInterior(playerid, 0);
					return true;
				}
				else if(GetPlayerVirtualWorld(playerid) == 2)
				{
					SetPlayerPos(playerid, 405.6777,623.2484,12.0000);
					SetPlayerFacingAngle(playerid, 157.2924);
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerInterior(playerid, 0);
					return true;
				}
			}
			if(CREATOR_HOUSE_ID[playerid] != -1)
			{
				new hid = CREATOR_HOUSE_ID[playerid];

				if(PlayerToPoint(3.0, playerid, HouseInfo[hid][hExitx], HouseInfo[hid][hExity], HouseInfo[hid][hExitz]) && GetPlayerVirtualWorld(playerid) == HouseInfo[hid][hVirtual])
				{
					if(HouseInfo[hid][hAutoDoors] == 0) return SendClientMessage(playerid, -1, ""cER"В этом доме не установлены автоматические двери");
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerPos(playerid, HouseInfo[hid][hEntrx], HouseInfo[hid][hEntry], HouseInfo[hid][hEntrz]);
				}
			}
			if(IsPlayerInRangeOfPoint(playerid, 10.0, -118.7106,-32.2754,1301.1094))
			{
				for(new idx; idx < sizeof casino_td_global; idx++) TextDrawShowForPlayer(playerid, casino_td_global[idx]);
				for(new idx; idx < sizeof casino_td_player; idx++) PlayerTextDrawShow(playerid, casino_td_player[idx][playerid]);

				global_string = "";
				format(global_string, 100, "баланс:_~g~%d_p", GetPlayerRubble(playerid));
				PlayerTextDrawSetString(playerid, casino_td_player[0][playerid], global_string);
				PlayerTextDrawSetString(playerid, casino_td_player[1][playerid], "ставка:_~r~0_р");

				new r = random(3);
				casino_win_card[playerid] = r + 1;

				SelectTextDrawEx(playerid, -1);
				SendClientMessage(playerid, -1, "{F97203}» "cWH"Добро пожаловать в игру 'Все или ничего'");
				SendClientMessage(playerid, -1, "{F97203}» "cWH"Внимательно прочитайте всю информацию и начните игру");
				return 1;
			}
			return 1;
		}
		if(pressed(KEY_YES))
		{
			if(KostiName[playerid] != INVALID_PLAYER_ID)
			{
				new dice = random(5) + 2;
				new dice1 = random(5) + 2;
				if(GetDistanceBetweenPlayers(playerid, KostiName[playerid]) > 6.0) return SendClientMessage(playerid, -1, ""cER"Игрок не рядом с вами!");
				if(Predlog[playerid] != 0) return SendClientMessage(playerid, -1, ""cER"Вы не можете принять игру!");
				new fiski = PhoneNumbers[playerid][0];
				new fiski1 = PhoneNumbers[KostiName[playerid]][0];
				if(fiski < KostiMoney[playerid] || fiski1 < KostiMoney[KostiName[playerid]])
				{
					SendClientMessage(playerid, -1, ""cER"У одного из вас не хватает фишек для игры в кости.");
					SendClientMessage(KostiName[playerid], -1, ""cER"У одного из вас не хватает фишек для игры в кости.");
					callcmd::canceldice(playerid);
					return 0;
				}
				format(string, sizeof(string), "%s и %s бросили кости. Результат: {FFFF00}%d : %d", GetName(KostiName[playerid]), GetName(playerid), dice, dice1);
				ProxDetector(13.0, playerid, string, COLOR_PURPLE);
				if(dice > dice1)
				{
					PhoneNumbers[KostiName[playerid]][0] += KostiMoney[playerid];
					PhoneNumbers[playerid][0] -= KostiMoney[playerid];
					SendClientMessage(KostiName[playerid], COLOR_GREEN, "Поздравляем! Вы выиграли!");
					SendClientMessage(playerid, COLOR_RED, "К сожалению, Вы проиграли!");
					format(string, 20, "~g~+%dр", KostiMoney[playerid]);
					GameTextForPlayer(KostiName[playerid], string, 3000, 1);
					format(string, 20, "~r~-%dр", KostiMoney[playerid]);
					GameTextForPlayer(playerid, string, 3000, 1);
				}
				else if(dice < dice1)
				{
					PhoneNumbers[KostiName[playerid]][0] -= KostiMoney[playerid];
					PhoneNumbers[playerid][0] += KostiMoney[playerid];
					SendClientMessage(playerid, COLOR_GREEN, "Поздравляем! Вы выиграли!");
					SendClientMessage(KostiName[playerid], COLOR_RED, "К сожалению, вы проиграли!");
					format(string, 20, "~g~+%dр", KostiMoney[playerid]);
					GameTextForPlayer(playerid, string, 3000, 1);
					format(string, 20, "~r~-%dр", KostiMoney[playerid]);
					GameTextForPlayer(KostiName[playerid], string, 3000, 1);

					new business_id = PlayerBizzSelect[playerid];

					BizzInfo[business_id][bMoney] += KostiMoney[playerid] / 20;
					BizzPay[business_id] += KostiMoney[playerid] / 20;

					BizzInfo[business_id][bProduct] -= (KostiMoney[playerid] / 100) * 2;

					MysqlUpdateBizzInt(business_id, "money", BizzInfo[business_id][bMoney]);
					MysqlUpdateBizzInt(business_id, "product", BizzInfo[business_id][bProduct]);
				}
				else if(dice == dice1)
				{
					SendClientMessage(playerid, COLOR_ORANGE, "Игра закончилась в ничью!");
					SendClientMessage(KostiName[playerid], COLOR_ORANGE, "Игра закончилась в ничью!");
				}
				format(string, 14, "Выпало: %d", dice1);
				SetPlayerChatBubble(playerid, string, COLOR_RED, 30.0, 10000);
				format(string, 14, "Выпало: %d", dice);
				SetPlayerChatBubble(KostiName[playerid], string, COLOR_GREEN, 30.0, 10000);
				ZapretDice[playerid] = ZapretDice[KostiName[playerid]] = 0;
				KostiMoney[playerid] = KostiMoney[KostiName[playerid]] = 0;
				Predlog[KostiName[playerid]] = 0;
				KostiName[KostiName[playerid]] = KostiName[playerid] = INVALID_PLAYER_ID;
			}
			return 1;
		}
		if(pressed(KEY_NO))
		{
			if(KostiName[playerid] != INVALID_PLAYER_ID)
			{
				SendClientMessage(playerid, COLOR_RED, "Вы отказались от предложения");
				SendClientMessage(KostiName[playerid], COLOR_RED, "Игрок отказался от предложения");
				Predlog[playerid] = Predlog[KostiName[playerid]] =
				KostiMoney[playerid] = KostiMoney[KostiName[playerid]] =
				ZapretDice[playerid] = ZapretDice[KostiName[playerid]] = 0;
				KostiName[KostiName[playerid]] = KostiName[playerid] = INVALID_PLAYER_ID;
			}
			return 1;
		}
		if(pressed(KEY_ANALOG_RIGHT))
		{
			if(!use_camera[playerid]) callcmd::inv(playerid);
			return 1;
		}
		if(pressed(KEY_CTRL_BACK))
		{
			for(new i = TOTALBIZZ; i > 0; i --)
			{
				if(IsPlayerInRangeOfPoint(playerid, 5.0, BizzInfo[i][bEntrx], BizzInfo[i][bEntry], BizzInfo[i][bEntrz])	&& BizzInfo[i][bType] == 2)
				{
					if(IsPlayerInAnyVehicle(playerid))
					{
						if(Setting[playerid][4] != 1)
						{
							if(Refueling[playerid])
								return SendClientMessage(playerid, COLOR_LIME, "Транспорт заправляется, пожалуйста подождите");

							player_fuel_cost[playerid] = player_fuel_count[playerid] = 0;

							for(new idx; idx < 20; idx++)
							TextDrawShowForPlayer(playerid, TD_Fuel[idx]);
							for(new idx; idx < 2; idx++)
							PlayerTextDrawShow(playerid, TDP_Fuel[playerid][idx]);
							SelectTextDrawEx(playerid, 0xFFFFFFFF);

							global_string = "";

							format(global_string, 3, "%dл.", player_fuel_count[playerid]);
							PlayerTextDrawSetString(playerid, TDP_Fuel[playerid][0], global_string);

							format(global_string, 20, "цена: %d рублей", player_fuel_cost[playerid]);
							PlayerTextDrawSetString(playerid, TDP_Fuel[playerid][0], global_string);
							return 1;
						}
						else ShowPlayerDialog(playerid, 5123, DIALOG_STYLE_LIST, ""cMain"Заправочная станция", ""cMain"1. "cWH"Заправить автомобиль\n"cMain"2. "cWH"Приобрести ремонтный набор\n"cMain"3. "cWH"Приобрести канистру", "Выбрать", "Отмена");
						FuelBizzID[playerid] = i;
						return 1;
					}
				}
			}
		}
	}
	return 1;
}

public OnPlayerUpdate(playerid)
{
	PI[playerid][pAFK] = 0;
	if(PlayerLogged[playerid] && IsPlayerFromThePhone(playerid) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		new notify_type = 0;
		new near_biz_id = 0;
		for(new idx = TOTALBIZZ; idx > 0; idx--)
		{
			if(BizzInfo[idx][bType] == 2 || BizzInfo[idx][bType] == 7) continue;
			if(PlayerToPoint(1.2, playerid, BizzInfo[idx][bExitx], BizzInfo[idx][bExity], BizzInfo[idx][bExitz]) && GetPlayerVirtualWorld(playerid) == BizzInfo[idx][bVirtual])
			{
				notify_type = NOTIFY_EXIT_BIZ;
				near_biz_id = idx;
				break;
			}
			if(!near_biz_id && PlayerToPoint(1.2, playerid, BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz]))
			{
				notify_type = NOTIFY_ENTER_BIZ;
				near_biz_id = idx;
			}
		}
		if(near_biz_id)
		{
			new now = GetTickCount();
			if(g_mobile_notify_last_bizid[playerid] != near_biz_id
			|| g_mobile_notify_last_type[playerid] != notify_type
			|| now >= g_mobile_notify_next_tick[playerid])
			{
				PlayerBizzSelect[playerid] = near_biz_id;
				g_mobile_notify_bizid[playerid] = near_biz_id;
				g_mobile_notify_last_bizid[playerid] = near_biz_id;
				g_mobile_notify_last_type[playerid] = notify_type;
				g_mobile_notify_next_tick[playerid] = now + 2200;
				if(notify_type == NOTIFY_ENTER_BIZ) { new notify_text[96]; format(notify_text, sizeof notify_text, "Нажмите для просмотра информации о бизнесе #%d.", near_biz_id); ShowNotificationLaird(playerid, 4, 6, NOTIFY_ENTER_BIZ, 0, notify_text, ">>"); }
				else ShowNotificationLaird(playerid, 4, 6, NOTIFY_EXIT_BIZ, 0, "Нажмите для выхода из бизнеса.", ">>");
			}
		}
		else
		{
			g_mobile_notify_bizid[playerid] = 0;
			g_mobile_notify_last_bizid[playerid] = 0;
			g_mobile_notify_last_type[playerid] = 0;
		}
	}
	return 1;
}

callback::ReFill(playerid)
{
	if(!Refueling[playerid]) return 1;
	Fuel[GetPlayerVehicleID(playerid)]++;
	Filling[playerid] ++;
	format(string,32,"Fill: %d",Filling[playerid]);
	GameTextForPlayer(playerid, string, 600, 6);
	if(Refueling[playerid] <= Filling[playerid])
	{
		KillTimer(ReFuelTimer[playerid]);
		Refueling[playerid] = 0;
		Filling[playerid] = 0;
		TogglePlayerControllable(playerid, true);
		SendClientMessage(playerid, COLOR_GREEN, "Транспорт заправлен");
	}
	return 1;
}

public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	if(PlayerLogged[playerid] == false) return 0;
	if(!IsPlayerConnected(playerid)) return 0;

	if(!AntiFlood(playerid, 0, 1))
	{
		SendErr(playerid, "Не флудите пожалуйста.");
		return 0;
	}
	if((obcar_status[playerid] || obmen_status[playerid]) && strfind(cmd, "acceptchangecar", true) == -1 && strfind(cmd, "time", true) == -1 && strfind(cmd, "deniedchangecar", true) == -1) return SendClientMessage(playerid, -1, ""cER"Вы обмениваетесь автомобилями, нельзя использовать никакие команды кроме /acceptchangecar и /deniedchangecar") & 0;
	if(PI[playerid][pJail] && strfind(cmd, "time", true) == -1 && strfind(cmd, "b", true) == -1 && strfind(cmd, "n", true) == -1 && strfind(cmd, "animlist", true) == -1 && strfind(cmd, "mm", true) == -1 && !PI[playerid][pAdmin]) return SendClientMessage(playerid, COLOR_RED, "В тюрьме запрещены любые команды кроме /time, /animlist, /mm, /n, /b") & 0;
	if(IsPlayerInRangeOfPoint(playerid, 80.0, -196.6820,1405.3795,1502.0037) && strfind(cmd, "animlist", true) == -1 && strfind(cmd, "mm", true) == -1 && strfind(cmd, "time", true) == -1 && !PI[playerid][pAdmin]) return SendClientMessage(playerid, COLOR_RED, "В бойцовском клубе запрещены любые команды, кроме /animlist, /time, /mm") & 0;
	return 1;
}

cmd:use(playerid)
{
	if(GetPlayerInHouse(playerid) == -1) return SendClientMessage(playerid, COLOR_DARKORANGE, "Вы находитесь на улице");
	new i = GetPlayerInHouse(playerid), id = GetPlayerHouse(playerid);
	if(HouseInfo[i][hID] != HouseInfo[id][hID] && HouseInfo[i][hCS] == 1) return SendClientMessage(playerid, COLOR_DARKORANGE, "Этот сейф закрыт");
	if((!IsPlayerInRangeOfPoint(playerid,60.0,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]) || IsPlayerInRangeOfPoint(playerid,3.0,2934.4077,2967.4949,3176.5769)) && GetPlayerVirtualWorld(playerid) == HouseInfo[i][hVirtual]) return SendClientMessage(playerid, COLOR_DARKORANGE, "Вы должны быть в доме");
	if(!IsPlayerInRangeOfPoint(playerid, 2.0, g_house_info[ HouseInfo[i][hDiscript] ][3], g_house_info[ HouseInfo[i][hDiscript] ][4], g_house_info[ HouseInfo[i][hDiscript] ][5])) return SendClientMessage(playerid, COLOR_GREY, "Вы далеко от сейфа");
	ShowPlayerDialog(playerid, 18000, DIALOG_STYLE_LIST, ""cMain"Сейф",
	""cMain"1. "cWH"Взять деньги\n\
	"cMain"2. "cWH"Положить деньги\n\
	"cMain"3. "cWH"Взять патроны\n\
	"cMain"4. "cWH"Положить патроны\n\
	"cMain"5. "cWH"Взять наркотики\n\
	"cMain"6. "cWH"Положить наркотики", "Далее", "Отмена");
	safeid[playerid] = id;
	return 1;
}

cmd:mutelist(playerid)
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	new list,full,str[100];
	global_string = "";

	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pMuted] > 0) list++;
	}
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pMuted] > 0)
		{
			format(str,sizeof(str),""cWH"%s[%d] - {FF6347}TIME: %s\n",PI[i][pName], i, ConvertSeconds(PI[i][pMuted]));
			strcat(global_string, str);
			full++;
		}
	}
	if(full == 0) strcat(global_string, ""cWH"Информация не найдена");
	ShowPlayerDialog(playerid,0,DIALOG_STYLE_MSGBOX,""cMain"MUTE LIST",global_string,"Закрыть","");
	fLogs("[admin] %s /mutelist", GetName(playerid));
	return 1;
}

cmd:jaillist(playerid)
{
	if(PI[playerid][pAdmin] > 0 || IsACopAndFSB(playerid))
	{
		new list,full,str[100];
		global_string = "";
		foreach(new i: Player)
		{
			if(PlayerLogged[i] == false) continue;
			if(PI[i][pJail] > 0) list++;
		}
		foreach(new i: Player)
		{
			if(PlayerLogged[i] == false) continue;
			if(PI[i][pJail] > 0)
			{
				format(str,sizeof(str),""cWH"%s[%d] - {FF6347}TIME: %s\n",PI[i][pName], i, ConvertSeconds(PI[i][pJailTime]));
				strcat(global_string, str);
				full++;
			}
		}
		if(full == 0) strcat(global_string, ""cWH"Информация не найдена");
		ShowPlayerDialog(playerid,0,DIALOG_STYLE_MSGBOX,""cMain"Список заключенных",global_string,"Закрыть","");
		fLogs("[admin] %s /jaillist", GetName(playerid));
	}
	return 1;
}
cmd:hook(playerid)
{
	if(PI[playerid][pMember] != TEAM_MVD)
	return SendClientMessage(playerid, COLOR_DARKORANGE, "Вы не состоите в МВД!");
	new car = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(car)!=525) return SCM(playerid,COLOR_DARKORANGE,"Чтобы прицепить транспорт, Вы должны находиться в эвакуаторе.");
	if(IsTrailerAttachedToVehicle(car))
	{
		DetachTrailerFromVehicle(car);
		SCM(playerid,-1,"{32CD32}| "cWH"Вы отцепили транспорт от эвакуатора.");
		return 1;
	}
	new Float:posx, Float:posy, Float:posz, bool:found = false;
	new Float:oldposx, Float:oldposy, Float:oldposz;
	new Float:tempposx, Float:tempposy, Float:tempposz;
	new Float:Radi=6.0;
	new Float:AngRange=90.0;
	new Float:plAngle;    GetVehicleZAngle(car, plAngle);
	new Float:crAngle,Float:Angle,Float:Angle2;
	GetVehiclePos(car, posx, posy, posz);
	foreach(new v: Vehicle)
	{
		if(car == v) continue;
		GetVehiclePos(v, oldposx, oldposy, oldposz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		tempposz = (oldposz -posz);
		if (((tempposx < Radi) && (tempposx > -Radi)) && ((tempposy < Radi) && (tempposy > -Radi)) && ((tempposz < Radi) && (tempposz > -Radi)))
		{
			if(GetVehicleType(v) <= 1)
			{
				GetVehicleZAngle(v, crAngle);
				Angle = (plAngle -crAngle);
				Angle2= (Angle-180.0);
				if (( ((Angle < AngRange) && (Angle > -AngRange)) || ((Angle2 < AngRange) && (Angle2 > -AngRange)) ))
				{
					AttachTrailerToVehicle(v, car);
					SCM(playerid,-1,"{32CD32}| "cWH"Вы прицепили транспорт к эвакуатору.");
					SCM(playerid,-1,"{F7D757}| "cWH"Чтобы отцепить транспорт от эвакуатора, введите /hook ещё раз.");
					found = true;
					break;
				}
			}
		}
	}
	if(found == false) SCM(playerid, -1, "{B22222}| "cWH"Поблизости не был найден транспорт.");
	return 1;
}
CMD:serverstats(playerid)
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston"))
	{
		new string_stats[401];
		GetNetworkStats(string_stats, sizeof(string_stats));
		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Сетевая статистика сервера", string_stats, "Close", "");
	}
	return 0x1;
}
cmd:arrestcar(playerid)
{
	if(PI[playerid][pMember] != TEAM_MVD) return SendClientMessage(playerid, COLOR_DARKORANGE, "Вы не состоите в МВД!");
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_DARKORANGE, "Вы должны находиться в транспорте!");
	new car = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(car)!=525) return SCM(playerid,COLOR_DARKORANGE,"Чтобы поместить авто на Ш/С, Вы должны находиться в эвакуаторе.");
	if(!PlayerToPoint(5.0, playerid, 2542.1277,-2408.6106,22.0044)) return SCM(playerid,COLOR_DARKORANGE,"Вы должны находиться у въезда на Ш/С!");
	if(!IsTrailerAttachedToVehicle(car)) return SCM(playerid,COLOR_DARKORANGE,"На буксире нет автомобиля!");
	new ar_id = GetVehicleTrailer(car);
	new bool:found = false;
	foreach(new i:Player)
	{
		for(new z; z < MAX_LOAD_VEHICLE; z++)
		{
			if(PlayerVehicle[i][z] == ar_id)
			{
				format(global_string,sizeof(global_string),"{9ACD32}Марка/модель:\t"cWH"%s\n\
					{9ACD32}Владелец:\t"cWH"%s\n\n\n\
					Введите причину ареста указанного транспортного средства и размер штрафа:\n\n\
					Пример: Неправильная парковка, 1000",
				VehicleNames[GetVehicleModel(ar_id)-400],GetName(i));
				ShowPlayerDialog(playerid, 12001, DIALOG_STYLE_INPUT, ""cMain"Арест транспорта", global_string,"Ввод", "Отмена");
				SetPVarInt(playerid,"arrestcar",i);
				SetPVarInt(playerid, "arrestcarsql", PlayerVehicleSQL[i][z]);
				SetPVarInt(playerid, "arrestcarid", PlayerVehicle[i][z]);
				found = true;
				break;
			}
		}
	}
	if(found == false) SCM(playerid, -1, "Данное Т/С нельзя поместить на штрафстоянку!");
	return 1;

}
cmd:unarrestcar(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_MVD) return SendClientMessage(playerid, COLOR_DARKORANGE, "Вы не состоите в МВД!");
	if(!PlayerToPoint(5.0, playerid, 2542.1277,-2408.6106,22.0044)) return SCM(playerid,COLOR_DARKORANGE,"Вы должны находиться у въезда на Ш/С!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/unarrestcar [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "Действие невозможно!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	format(stringer1, 128, "SELECT * FROM `ownable_cars` WHERE c_owner = '%s' AND `c_arrest` = 1", GetName(params[0]));
	mysql_tquery(db_prod, stringer1, "ChkPlayerArrestCar", "i", playerid);
	SetPVarInt(playerid,#P_Dps_Id, params[0]);
	return 1;
}
cmd:mytickets(playerid)
{
	if(!PI[playerid][pPhone][1]) return SendClientMessage(playerid, COLOR_GREY, "У Вас не подключен интернет. Подключить его можно в салоне магазина 24/7");
	if(Phone[playerid] == false) return SendClientMessage(playerid, COLOR_RED, "Телефон выключен. Для включения телефона используйте /togphone");
	if(PhoneInternetStatus[playerid] == false) return SendClientMessage(playerid, COLOR_RED, "Чтобы использовать интернет, необходимо включить передачу данных(/phone)");
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"В тюрьме недоступно!");
	mysql_format(db_prod, global_string,sizeof global_string,"SELECT * FROM `fines` WHERE Name = '%s'",GetName(playerid));
	mysql_tquery(db_prod, global_string, "CheckTickets","dd", playerid, 0);
	return 1;
}
cmd:freecar(playerid)
{
	format(stringer1, 128, "SELECT * FROM `ownable_cars` WHERE c_owner = '%s' AND `c_arrest` = 1", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "ChkPlayerArrestCar", "i", playerid);
	return 1;
}
cmd:mfon(playerid)
{
	if(!IsValidDynamicArea(Mfon[playerid][p_area]) && !IsPlayerInDynamicArea(playerid, Mfon[playerid][p_area])) return SCM(playerid,-1, "Вы не устанавливали магнитофон!");
	if(!PlayerToPoint(3.0, playerid, Mfon[playerid][p_fonpos][0],  Mfon[playerid][p_fonpos][1],  Mfon[playerid][p_fonpos][2])) return SCM(playerid,-1, "Вы должны быть рядом с магнитофоном!");
	format(stringer,sizeof(stringer),"%s",(Mfon[playerid][p_mfon]) ? ("{ff0000}Выключить\n"cWH"Сменить станцию") : ("{00ff00}Включить"));
	ShowPlayerDialog(playerid,12007,DIALOG_STYLE_LIST,""cWH"Магнитофон",stringer,"Выбор","Отмена");
	return 1;
}
callback::ChkPlayerArrestCar(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, COLOR_RED, "Ошибка: автомобили которые находятся на Ш/С не найдены.");

	new car_number[64], car_model;
	global_string = "";
	for(new idx = 0; idx < rows; idx++)
	{
		cache_get_field_content(idx, "c_number", car_number, db_prod, 64);
		car_model = cache_get_field_content_int(idx, "c_model");
		format(global_string, sizeof global_string, "%s{F27208}» "cWH"Автомобиль №%d: %s — %s — {ff0000}Арестован\n", global_string, idx+1, VehicleNames[car_model-400], car_number);
		SetPlayerListitemValue(playerid, idx, cache_get_field_content_int(idx, "id"));
		if(GetPVarType(playerid,#P_Dps_Id))
		{
			SetPlayerListitemValue1(playerid, idx, car_model);
		}
	}
	ShowPlayerDialog(playerid, 12004, DIALOG_STYLE_LIST, ""cMain"Выберите автомобиль из списка:", global_string, "Выбрать", "Отмена");
	return 1;
}

cmd:test(playerid)
{
	for(new i; i < 10; i ++)
	{
		TextDrawShowForPlayer(playerid, menu_TD[i]);
	}
	SelectTextDrawEx(playerid, 0xFA5E1BAA);
	return true;
}

cmd:tp(playerid)
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	ShowPlayerDialog(playerid, 46, DIALOG_STYLE_LIST, ""cMain"Телепорт", "{ffffff}1. Основные Места\n\
	2. По работе\n\
	3. Государственные Организации\n\
	4. Нелегальные Организации\n\
	5. Банки\n\
	6. Развлечения\n\
	7. Автосалоны\n\
	8. Аренда транспорта\n\
	9. Спавны новичков", "Выбрать", "Отмена");
	goto_gps[playerid] = 1;
	return 1;
}

cmd:setworld(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(sscanf(params, "ii", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, "\
	"cPS"/setworld [вирт. мир] [инт]");
	SetPlayerVirtualWorld(playerid, params[0]);
	SetPlayerInterior(playerid, params[1]);
	fLogs("[admin] %s /setworld %i %i", GetName(playerid), params[0], params[1]);
	return 1;
}
cmd:myworld(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	SendMes(playerid, COLOR_WHITE, ""cPS"Вирт.мир:%d | Интерьер:%d",GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	fLogs("[admin] %s /myworld %i %i", GetName(playerid), GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	return 1;
}
cmd:mp(playerid)
{
	if(PI[playerid][pAdmin] < 7) return 1;
	if(PI[playerid][pBuyAdmin]) return SCM(playerid, -1, "Покупным  администраторам недоступна эта команда");
	ShowPlayerDialog(playerid,9994,DIALOG_STYLE_LIST,""cMain"Меню мероприятия","{ffffff}1. Создать/Удалить точку телепорта\n2. Заморозить игроков "cMain"(50м)\n3. Выдать игрокам 100ХП "cMain"(50м)\n4. Выдать игрокам 100БР "cMain"(50м)\n5. Выдать игрокам оружие "cMain"(50м)\n6. Выдать игрокам скин "cMain"(50м)\n5. Изменить игрокам цвет "cMain"(50м)\n6. Отобрать у игроков оружие "cMain"(50м)\n7. Отобрать у игроков броню "cMain"(50м)","Выбрать","Закрыть");
	return true;
}

cmd:settp(playerid)
{
	if(PI[playerid][pAdmin] < 7) return 1;
	if(Teleport == 0)
	{
		GetPlayerPos(playerid, TeleportFloat[0], TeleportFloat[1], TeleportFloat[2]);
		TeleportInfo[0] = GetPlayerInterior(playerid);
		TeleportInfo[1] = GetPlayerVirtualWorld(playerid);
		Teleport = 1;
		format(string, sizeof(string), ""aAC"%s[%d] установил точку телепорта для игроков. {0abf12}ТП включен.", GetName(playerid), playerid);
		SendAdminMessage(COLOR_GREY, string);
		fLogs("[admin] %s /settp 1 [%f %f %f %i %i]", GetName(playerid), TeleportFloat[0], TeleportFloat[1], TeleportFloat[2], TeleportInfo[1], TeleportInfo[0]);
	}
	else
	{
		format(string, sizeof(string), ""aAC"%s[%d] удалил точку телепорта для игроков. {c16e38}ТП отключен.", GetName(playerid), playerid);
		SendAdminMessage(COLOR_GREY, string);
		Teleport = 0;
		fLogs("[admin] %s /settp 0", GetName(playerid));
		return true;
	}
	return true;
}

cmd:gotomp(playerid)
{
	if(IsPlayerEvent(playerid) || g_player_tazer[playerid] || pCuff[playerid][pCuffee] == playerid || PI[playerid][pJail] || playerRecordingStatus{playerid}) return SendErr(playerid, "В данный момент Вы не можете использовать данную команду");
	if(PI[playerid][pBuyAdmin])
		return SendErr(playerid, "Вам запрещено использовать данную команду");
	if(Teleport == 0) return true;
	else
	{
		PlayerFixMP[playerid] = 1;
		SetPlayerPos(playerid, TeleportFloat[0], TeleportFloat[1], TeleportFloat[2]);
		SetPlayerInterior(playerid, TeleportInfo[0]);
		SetPlayerVirtualWorld(playerid, TeleportInfo[1]);

		GetPlayerPos(playerid, PI[playerid][P_TO_MP_POS_X], PI[playerid][P_TO_MP_POS_Y], PI[playerid][P_TO_MP_POS_Z]);
		PI[playerid][P_TO_MP_POS_WV] = GetPlayerVirtualWorld(playerid);
		PI[playerid][P_TO_MP_POS_INT] = GetPlayerInterior(playerid);
	}
	return true;
}

