cmd:fstyle(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/fstyle [стиль от 1 до 4]");
	if(params[0] < 1 || params[0] > 4) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/fstyle [стиль от 1 до 4]");
	switch(params[0])
	{
	case 1:
		{
			PI[playerid][pFightStyle] = 0;
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET fstyle=0 WHERE id=%d", PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
			SetPlayerFightingStyle(playerid, FIGHT_STYLE_NORMAL);
			SendClientMessage(playerid, COLOR_GREEN, "Вы изменили свой стиль боя на "cWH"стандартный");
		}
	case 2:
		{
			PI[playerid][pFightStyle] = 5;
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET fstyle=5 WHERE id=%d", PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
			SetPlayerFightingStyle(playerid, FIGHT_STYLE_BOXING);
			SendClientMessage(playerid, COLOR_GREEN, "Вы изменили свой стиль боя на "cWH"бокс");
		}
	case 3:
		{
			PI[playerid][pFightStyle] = 6;
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET fstyle=6 WHERE id=%d", PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
			SetPlayerFightingStyle(playerid, FIGHT_STYLE_KUNGFU);
			SendClientMessage(playerid, COLOR_GREEN, "Вы изменили свой стиль боя на "cWH"кунг-фу");
		}
	case 4:
		{
			PI[playerid][pFightStyle] = 7;
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET fstyle=7 WHERE id=%d", PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
			SetPlayerFightingStyle(playerid, FIGHT_STYLE_KNEEHEAD);
			SendClientMessage(playerid, COLOR_GREEN, "Вы изменили свой стиль боя на "cWH"кикбокс");
		}
	}
	return 1;
}

cmd:fights(playerid)
{
	if(g_player_full_access[playerid])
	{
		fights_status = true;
		fights_status_s = true;
		fights_timer = 300;
		SendClientMessageToAll(COLOR_YELLOW, "Внимание! В бойцовском клубе открыта регистрация на поединок. Начало через 5 минут!");
		fLogs("[admin] %s /fights", GetName(playerid));
	}
	return 1;
}

cmd:fightstime(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(!fights_status) return SendClientMessage(playerid, COLOR_RED, "Для начала начните бой");
		if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, "/fightstime [время]");
		fights_timer = params[0];
		SendMes(playerid, COLOR_GREEN, "Вы установили время до начала боя: %d сек. или %d мин", fights_timer, fights_timer/60);
		fLogs("[admin] %s /fightstime %i", GetName(playerid), params[0]);
	}
	return 1;
}
ClearFightsData()
{
	for(new idx; idx < 2; idx++) strmid(fights_player[idx], "None", 0, strlen("None"), 10);
	fights_winner 				=
	fights_loser 				= INVALID_PLAYER_ID;
	fights_bank 				=
	fights_count_players		=
	fights_timer                = 0;
	fights_status 				=
	fights_status_s 			= false;
	fights_timer                = -1;
	UpdateFightsText();
}
FightsStart()
{
	if(fights_status)
	{
		new playerid = GetPlayerID(fights_player[0]);
		new targetid = GetPlayerID(fights_player[1]);

		g_player_in_event[playerid] =
		g_player_in_event[targetid] = true;

		SetPlayerPos(playerid, -207.5554,62.2850,1301.5000);
		SetPlayerPos(targetid, -203.8427,58.9074,1301.5000);
		SetPlayerFacingAngle(playerid, 228.0);
		SetPlayerFacingAngle(targetid, 45.0);

		SetPlayerSkin(playerid, 80);
		SetPlayerSkin(targetid, 81);

		SetPlayerHealth(playerid, 100);
		SetPlayerHealth(targetid, 100);

		SetPlayerArmour(playerid, 0);
		SetPlayerArmour(targetid, 0);

		ResetPlayerWeapons(playerid);
		ResetPlayerWeapons(targetid);

		global_string = "";
		format(global_string, 128, "[Бойцовский клуб]: Бой начался! Соперники: %s и %s. Банк игры: %d руб.", GetName(playerid), GetName(targetid), fights_bank);
		SendClientMessageToAll(COLOR_YELLOW, global_string);

		fights_timer = -1;
		fights_status_s = false;
		fights_duel = true;
	}
}
CancelFight()
{
	if(fights_status)
	{
		new player_1 = GetPlayerID(fights_player[0]),
		player_2 = GetPlayerID(fights_player[1]);

		g_player_in_event[player_1] =
		g_player_in_event[player_2] = false;


		printf("%i = %i || %i", player_1, player_2, fights_winner);
		if(player_1 == fights_winner)
		{
			if(player_1 != INVALID_PLAYER_ID)
			{
				SendMes(player_1, COLOR_GREEN, "Поздравляем! Вы выиграли бой у %s", GetName(player_2));
				SendMes(player_1, COLOR_GREEN, "На Ваш счет было перечислено 10% от суммы ставок: %d рублей", (fights_bank/100)*10);
				SendMes(player_2, COLOR_RED, "К сожалению Вы проиграли бой игроку %s", GetName(player_1));
				SetPlayerMoney(player_1, (fights_bank/100)*10);
			}
		}
		else if(player_2 == fights_winner)
		{
			if(player_2 != INVALID_PLAYER_ID)
			{
				SendMes(player_2, COLOR_GREEN, "Поздравляем! Вы выиграли бой у %s", GetName(player_1));
				SendMes(player_2, COLOR_GREEN, "На Ваш счет было перечислено 10% от суммы ставок: %d рублей", (fights_bank/100)*10);
				SendMes(player_1, COLOR_RED, "К сожалению Вы проиграли бой игроку %s", GetName(player_2));
				SetPlayerMoney(player_2, (fights_bank/100)*10);
			}
		}

		SetPlayerPos(player_1, -191.0231,73.7684,1301.0000);
		SetPlayerPos(player_2, -192.0231,73.7684,1301.0000);
		SetPlayerFacingAngle(player_1, 228);
		SetPlayerFacingAngle(player_2, 45);

		SetPlayerSkin(player_1, PI[player_1][pModel]);
		SetPlayerSkin(player_2, PI[player_2][pModel]);

		foreach(new i: Player)
		{
			if(fights_player_p[i] != -1 && fights_money[i])
			{
				switch(fights_player_p[i])
				{
				case 0:
					{
						if(player_1 == fights_winner)
						{
							SetPlayerMoney(i, fights_money[i]*2);
							SendMes(i, COLOR_GREEN, "Ваша недавняя ставка на игрока %s успешно прошла. На Ваш счет было зачислено: %d руб", GetName(player_1), fights_money[i]*2);
							fights_player_p[i] = -1; fights_money[i] = 0;
						}
						else
						{
							SendMes(i, COLOR_RED, "К сожалению Ваша ставка на игрока %s не прошла. В другой раз обязательно повезет..", GetName(player_1));
							fights_player_p[i] = -1; fights_money[i] = 0;
						}
					}
				case 1:
					{
						if(player_2 == fights_winner)
						{
							SetPlayerMoney(i, fights_money[i]*2);
							SendMes(i, COLOR_GREEN, "Ваша недавняя ставка на игрока %s успешно прошла. На Ваш счет было зачислено: %d руб", GetName(player_2), fights_money[i]*2);
							fights_player_p[i] = -1; fights_money[i] = 0;
						}
						else
						{
							SendMes(i, COLOR_RED, "К сожалению Ваша ставка на игрока %s не прошла. В другой раз обязательно повезет..", GetName(player_2));
							fights_player_p[i] = -1; fights_money[i] = 0;
						}
					}
				}

			}
		}
		global_string = "";
		format(global_string, 128, "[Бойцовский клуб]: бой завершился. Победитель: %s, проигравший: %s. Сумма банка: %d руб.", GetName(fights_winner), GetName(fights_loser), fights_bank);
		SendClientMessageToAll(COLOR_YELLOW, global_string);

		fights_player_status[player_1] = false;
		fights_player_status[player_2] = false;
		fights_duel = false;

		UpdateFightsText();
		ClearFightsData();
	}
	return 1;
}

cmd:gzcolor(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	new id;
	if(sscanf(params, "i", id)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/gzcolor [id банды]");
	if(id != TEAM_CSKA && id != TEAM_SPARTAK) return SendFormatErr(playerid, "Вы выбрали неверный ID (%d - %s или %d - %s)", TEAM_CSKA, Fraction_Name[TEAM_CSKA], TEAM_SPARTAK, Fraction_Name[TEAM_SPARTAK]);
	for(new i = 0; i < sizeof(GZInfo); i++)
	{
		if(IsPlayerToSquare(playerid,GZInfo[i][gCoords][0], GZInfo[i][gCoords][1],GZInfo[i][gCoords][2],GZInfo[i][gCoords][3]))
		{
			GZInfo[i][gFrak] = id;
			GangZoneStopFlashForAll(GZInfo[i][gZone]);
			GangZoneHideForAll(GZInfo[i][gZone]);
			GangZoneShowForAll(GZInfo[i][gZone],GetGangZoneColor(i));
			SaveGZ(i);
			fLogs("[admin] %s /gzcolor %i %i", GetName(playerid), i, params[0]);
			break;
		}
	}
	return 1;
}

cmd:close(playerid, params[])
{
	if((IsAGang(playerid) || IsAMafia(playerid)) && PI[playerid][pRank] >= 9)
	{
		switch(PI[playerid][pMember])
