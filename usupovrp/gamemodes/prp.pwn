		else format(global_string, 350,""cWH"Вы действительно хотите продать след. итем?\n"cWH"Название предмета: "cMain"%s\n"cWH"Стоимость предмета: "cMain"%dр\n"cWH"Количество предмета: "cMain"%d\n"cWH"Вес предмета: "cMain"%d",Item[id][iName],GivePlayer[playerid][2],GivePlayer[playerid][1],Item[id][iGG]*GivePlayer[playerid][1]);
