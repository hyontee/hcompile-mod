cmd:d(playerid, params[])
{
	if(IsACopAndFSB(playerid) || PI[playerid][pMember] == TEAM_ARMY || PI[playerid][pMember] == TEAM_OBLASTADMIN || PI[playerid][pMember] == TEAM_SMI || PI[playerid][pMember] == TEAM_HOSPITAL)
	{
		if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
		if(dep[playerid] > gettime()) return SendClientMessage(playerid, 0xFF7979AA, "Следующее сообщение вы сможете отправить через 15 секунд!");
		if(PI[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_RED, "Писать в департамент можно с 3 ранга");
		if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/d [текст]");
		if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);
		if(strlen(params) > 100) return SendClientMessage(playerid, -1, "Слишком длинное сообщение");

		format(global_string, sizeof(global_string), "[D] [%s] %s %s[%d]: %s", Fraction_Name[PI[playerid][pMember]], GetFrackRangName(playerid), GetName(playerid), playerid, params[0]);
		SendDMes(0x007FFFFF, global_string);
		SetPlayerChatBubble(playerid,"сообщает в департамент",COLOR_PURPLE,30.0,10000);
		dep[playerid] = gettime() + 20;
		if(PI[playerid][pLeader]) PI[playerid][pLeaderStat][LEADER_D] ++;
		FractionProtectionServer(playerid, params[0]);
	}
	else SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	return 1;
}

