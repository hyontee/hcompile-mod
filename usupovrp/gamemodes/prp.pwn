DLG(3200, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(PlayerALogin[playerid])
	{
		if(!strcmp(inputtext, "qwerty", true) || strlen(inputtext) < 6 || strlen(inputtext) > 16 || strfind(inputtext, "=", true) != -1)
		return ShowPlayerDialog(playerid, 3200, DIALOG_STYLE_PASSWORD, ""cMain"Регистрация администратора", ""cWH"Введите пароль, который будет от панели администратора\n\n{63BD4E}Примечание:\n\t- Пароль должен состоять из латинских букв и цифр\n\t- Размер пароля от 6 до 15 символов", "Принять", "Отмена");

		for(new i = strlen(inputtext)-1; i != -1; i--)
		{
			switch(inputtext[i])
			{
				case '0'..'9', 'а'..'я', 'a'..'z', 'А'..'Я', 'A'..'Z': continue;
				default:
				{
					ShowPlayerDialog(playerid, 3200, DIALOG_STYLE_PASSWORD, ""cMain"Регистрация администратора", ""cWH"Введите пароль, который будет от панели администратора\n\n{63BD4E}Примечание:\n\t- Пароль должен состоять из латинских букв и цифр\n\t- Размер пароля от 6 до 15 символов", "Принять", "Отмена");
					return 0x1;
				}
			}
		}

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `admin` WHERE `name` = '%s'", GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL, "AloginReg", "iss", playerid, GetName(playerid), inputtext);
		return 0x1;
	}
	if(null(inputtext)) return ShowPlayerDialog(playerid, 3200, DIALOG_STYLE_PASSWORD, ""cMain"Доступ администратора", ""cWH"Введите Ваш пароль от панели администратора", "Принять", "Отмена");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `admin` WHERE `name` = '%e' AND `password` = '%e'", GetName(playerid), inputtext);
	mysql_tquery(db_prod, STRING_GLOBAL, "AloginAuth", "is", playerid, inputtext);
	return 1;
}
