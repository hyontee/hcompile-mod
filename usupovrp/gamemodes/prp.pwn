DLG(7718, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	new fam_id = PI[playerid][pFamily];
	family_info [fam_id] [f_chat_color] = listitem;
	callcmd::family(playerid);
	global_string = "";
	format(global_string, 128, "UPDATE `family_system` SET `fam_chat_color` = '%d' WHERE `fam_id` = '%d' LIMIT 1",family_info [fam_id] [f_chat_color], fam_id);
	mysql_function_query(db_prod, global_string, false, "", "");
	new fmt_msg[128];
	format(fmt_msg, sizeof(fmt_msg), "{%s}[%s]{FFD39B} %s[%s]: изменил цвет чата семьи",family_chat_color [family_info[fam_id] [f_chat_color]],family_info [fam_id] [f_name],GetName(playerid),family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1]);
	family_message(fam_id,-1, fmt_msg);
	return 1;
}
DLG(7719, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	if(playerEuro[playerid] < 1000) return SendClientMessage(playerid, -1, ""cER"Для смены названия семьи необходимо 1.000 евро");
	if (strlen ( inputtext ) < 2 || strlen (inputtext) > 12) return ShowPlayerDialog(playerid,7719,DIALOG_STYLE_INPUT,""cMain"Название семьи",""cWH"Введите новое название семьи:","Далее","Закрыть");

	mysql_format(db_prod, global_string, 100, "SELECT `fam_name` FROM `family_system` WHERE fam_name = '%e'", inputtext);
	mysql_tquery(db_prod, global_string, "CheckFamilyName", "isi", playerid, inputtext, 2);
	return 1;
}
DLG(3526, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new f = PI[playerid][pFamily];
	if(!f) return SendErr(playerid, "Вы не состоите в семье");

	global_string = "";
	switch(listitem)
	{
	case 0:
		{
			format(global_string, 256,""cWH"Название семьи: {%s}%s\n\n"cWH"Состав семьи: всего %d игрок(ов)\nДата создания семьи: %s\n\nСоздатель семьи: %s\n\nОнлайн семьи: {43CD80}%d игрок(ов)",
			family_chat_color [family_info [f] [f_chat_color]],family_info [f] [f_name],GetFamilyAllMembers(f),family_info [f] [f_creating_data],family_info [f] [f_creator], GetFamilyOnline(f));
			ShowPlayerDialog(playerid, 7705, DIALOG_STYLE_MSGBOX,""cMain"Информация о семье", global_string, "Назад","");
		}
	case 1:
		{
			new str[50], numb;
			foreach(Player, i)
			{
				if(PI[i][pFamily] == f)
				{
					format(str, sizeof str,"%s (Ранг: %d)\n", GetName(i), PI[i][pFamilyRank]),strcat(global_string,str);
					DialogSlot[playerid][++numb] = i;
				}
			}
			ShowPlayerDialog(playerid, 7706, DIALOG_STYLE_LIST,""cMain"Игроки онлайн", global_string, "Выбрать","Назад");
		}
	case 2:
		{
			format(global_string, 128, "SELECT `name`,`datavhod`,`familyrank` FROM `accounts` WHERE family = '%d' AND online = '1001'", f);
			mysql_tquery(db_prod, global_string, "OfflineMembersOfFamily", "i", playerid);
		}
	case 3:
		{
			format(global_string, 128, "SELECT `name`,`online`,`familyrank` FROM `accounts` WHERE family = '%d'", f);
			mysql_tquery(db_prod, global_string, "AllMembersFamily", "i", playerid);
		}
	case 4:
		{
			if((PI[playerid][pFamilyRank] >= family_info[f][f_sklad_dostup]) || PI[playerid][pFamilySozd] || PI[playerid][pFamilyZam])
			{
				format(global_string, 500,"\
					"cWH"1. Взять/положить деньги в общак {DECA31}(В общаке: %d руб)\n\
					"cWH"2. Взять/положить деньги в общак {DECA31}(В общаке: %d евро)\n\
					"cWH"3. Взять/положить наркотики в общак {DECA31}(В общаке: %d наркотиков)\n\
					"cWH"4. Взять/положить патроны в общак {DECA31}(В общаке: %d патронов)",
				family_info[f][f_money], family_info[f][f_euro], family_info[f][f_narko], family_info[f][f_patr]);
				ShowPlayerDialog(playerid, 7708, DIALOG_STYLE_LIST, ""cMain"Общак семьи", global_string, "Выбрать", "Назад");
			}
			else SendMes(playerid, COLOR_RED, "Доступ к общаку разрешен с %d ранга", family_info[f][f_sklad_dostup]);
		}
	case 5:
		{
			if(PI[playerid][pFamilySozd] || PI[playerid][pFamilyZam])
			{
				new color_dialog [ 356 ];
				format(color_dialog,sizeof(color_dialog),"{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----\n{%s}-----",family_chat_color [ 0 ],family_chat_color [ 1 ],family_chat_color [ 2 ],family_chat_color [ 3 ],family_chat_color [ 4 ]
				,family_chat_color [ 5 ],family_chat_color [ 6 ],family_chat_color [ 7 ],family_chat_color [ 8 ],family_chat_color [ 9 ],family_chat_color [ 10 ],family_chat_color [ 11 ],family_chat_color [ 12 ],family_chat_color [ 13 ],family_chat_color [ 14 ],family_chat_color [ 15 ],family_chat_color [ 16 ],family_chat_color [ 17 ],family_chat_color [ 18 ],family_chat_color [ 19 ],family_chat_color [ 20 ],family_chat_color [ 21 ]);
				ShowPlayerDialog(playerid,7718,DIALOG_STYLE_LIST,""cMain"Цвет чата",color_dialog,"Выбрать","Назад");
			}
			else
			{
				format(stringer1, sizeof(stringer1), "{%s}[%s] {FFD39B}%s[%d] покинул семью по собственному желанию",family_chat_color[family_info[f][f_chat_color]], family_info[f][f_name], GetName(playerid), playerid);
				family_message(f,-1, stringer1);

				SendClientMessage(playerid,COLOR_GREY,"Вы покинули семью по собственному желанию.");

				PI[playerid][pFamilySozd] =
				PI[playerid][pFamily] =
				PI[playerid][pFamilyZam] = 0;

				if(playerFamilyNameTag[playerid] != INVALID_3DTEXT_ID)
				{
					UpdateDynamic3DTextLabelText(playerFamilyNameTag[playerid], -1, " ");

					DestroyDynamic3DTextLabel(playerFamilyNameTag[playerid]);
					playerFamilyNameTag[playerid] = INVALID_3DTEXT_ID;
				}

				format(stringer1, sizeof stringer1, "UPDATE `accounts` SET family = 0, familyzam = 0, familyrank = 0, familysozd = 0 WHERE id=%d", PI[playerid][pID]);
				mysql_function_query ( db_prod, stringer1, false, "", "");
			}
		}
	case 6:
		{
			if(playerEuro[playerid] < 1000) return SendClientMessage(playerid, -1, ""cER"Для смены названия семьи необходимо 1.000 евро");
			ShowPlayerDialog(playerid,7719,DIALOG_STYLE_INPUT,""cMain"Название семьи",""cWH"Введите новое название семьи:","Далее","Закрыть");
		}
	case 7:
		{
			new fmt_str[70];
			global_string = "";
			for(new i; i < 7; i++)
			{
				if(!strcmp(family_rank_name[f][i], "none", true)) format(fmt_str, sizeof fmt_str, ""cWH"Ранг №%d: нет {57C255}(установить)%s", i+1, i != 7 ? "\n" : "");
				else format(fmt_str, sizeof fmt_str, ""cWH"Ранг №%d: %s {EFE524}(изменить)%s", i+1, family_rank_name[f][i], i != 7 ? "\n" : "");
				strcat(global_string, fmt_str);
			}
			ShowPlayerDialog(playerid, 7720, DIALOG_STYLE_LIST, ""cMain"Управление рангами", global_string, "Выбрать", "Назад");
		}
	case 8: ShowPlayerDialog(playerid, 7722, DIALOG_STYLE_INPUT, ""cMain"Выгнать из семьи offline", ""cWH"Укажите ник игрока, которого необходимо выгнать из семьи:", "Далее", "Назад");
	case 9: ShowPlayerDialog(playerid, 7723, DIALOG_STYLE_INPUT, ""cMain"Доступ к общаку", ""cWH"Укажите номер ранга, с которого будет доступен общак(от 1 до 7):", "Далее", "Назад");
	case 10:
		{
			if(GetPlayerHouse(playerid) == 0) return SendClientMessage(playerid, COLOR_RED, "У Вас нет дома и Вы не можете изменять место спавна");
			new fmt_msg[128], h = GetPlayerHouse(playerid);
			if(family_info[f][f_spawn] == 0)
			{
				format(fmt_msg, sizeof(fmt_msg), "{%s}[%s] {FFD39B}Глава: %s установил возможность появляться членам семьи у него дома (/setspawn)",family_chat_color [family_info [f] [f_chat_color]], family_info [f] [f_name], GetName(playerid), family_rank_name[f][PI[playerid][pFamilyRank] - 1], strval(inputtext));
				family_message(PI[playerid][pFamily],-1, fmt_msg);

				family_info[f][f_spawn] = 1;
				family_info[f][f_house] = h;
				family_info[f][f_spawn_x] = HouseInfo[h][hExitx];
				family_info[f][f_spawn_y] = HouseInfo[h][hExity];
				family_info[f][f_spawn_z] = HouseInfo[h][hExitz];
				family_info[f][f_int] = HouseInfo[h][hInt];
				family_info[f][f_world] = HouseInfo[h][hVirtual];
			}
			else
			{
				format(fmt_msg, sizeof(fmt_msg), "{%s}[%s] {FFD39B}Глава: %s запретил появляться членам семьи у него дома",family_chat_color [family_info [f] [f_chat_color]], family_info [f] [f_name], GetName(playerid), family_rank_name[f][PI[playerid][pFamilyRank] - 1], strval(inputtext));
				family_message(PI[playerid][pFamily],-1, fmt_msg);

				family_info[f][f_house] =
				family_info[f][f_spawn] =
				family_info[f][f_int] =
				family_info[f][f_world] = 0;
				family_info[f][f_spawn_x] =
				family_info[f][f_spawn_y] =
				family_info[f][f_spawn_z] = 0.0;
			}
			global_string = "";
			format(global_string, 300, "UPDATE `family_system` SET fam_house=%d, `fam_spawn` = %d, `fam_spawn_x` = '%f', `fam_spawn_y` = '%f', `fam_spawn_z` = '%f', `fam_int` = %d, `fam_world` = %d WHERE `fam_id` = '%d' LIMIT 1",
			family_info[f][f_house], family_info[f][f_spawn], family_info[f][f_spawn_x], family_info[f][f_spawn_y], family_info[f][f_spawn_z], family_info[f][f_int], family_info[f][f_world], f);
			mysql_function_query(db_prod, global_string, false, "", "");

		}
	case 11:
		{
			if(family_info[f][f_total_cars] == 0) return SendClientMessage(playerid, COLOR_RED, "В Вашей семье нет авто");
			mysql_format(db_prod, stringer1, 128, "SELECT * FROM `family_cars` WHERE family = '%d'", f);
			mysql_tquery(db_prod, stringer1, "ShowPlayerFamilyCars","i",playerid);
		}
	case 12:
		{
			ShowPlayerDialog(playerid, 2548, DIALOG_STYLE_INPUT, ""cMain"Война семей", "Укажите название семьи и сумму евро за войну через запятую.\nПример: Pupkin Team, 100", "Принять", "Отмена");
		}
	case 13:
		{
			SendErr(playerid, "Функция будет скоро доступна");
			//	ShowPlayerDialog(playerid, 7724, DIALOG_STYLE_MSGBOX, ""cMain"Расформировать семью", ""cWH"Вы действительно хотите расформировать свою семью?\nДанное действие необратимо!\n\nРасформировать семью?", "Да", "Нет");
		}
	case 14:
	{
		if(PI[playerid][pFamilySozd])
			return SendErr(playerid, "Вы не можете покинуть семью");

		ShowPlayerDialog(playerid, 7725, DIALOG_STYLE_MSGBOX, ""cMain"Покинуть семью", ""cWH"Вы действительно хотите покинуть свою семью?\nВы являетесь создателем данной семьи\n\nВы подтверждаете свое действие?", "Да", "Нет");
	}
	}
	return 1;
}

DLG(2548, playerid, response, listitem, inputtext[])
{
	if(!PI[playerid][pFamily]) return 1;
	if(!PI[playerid][pFamilySozd] && !PI[playerid][pFamilyZam]) return SCM(playerid, -1, ""cER"Доступ имеет только создатель семьи и заместитель");

	new MoneyFamily;
	new NameFamily[64];
	if(sscanf(inputtext, "p<,>s[64]i", NameFamily, MoneyFamily)) return ShowPlayerDialog(playerid, 2545, DIALOG_STYLE_INPUT, ""cMain"Война семей", "Укажите название семьи и сумму евро за войну через запятую.\nПример: Pupkin Team, 100", "Принять", "Отмена");

	new ider = -1;
	for(new i; i < sizeof(glFamilyCaptPos); i++) if(!glFamilyCaptBusy[i]) ider = i;
	if(ider == -1) return SCM(playerid, -1, ""cER"Все места проведения разборок заняты");

	new idfm = -1;
	for(new i; i < MAX_FAMILY; i++)
	{
		if(family_info[i][f_name][0] && !strcmp(family_info[i][f_name], NameFamily))
		{
			idfm = i;
		}
	}
	if(idfm == -1) return SCM(playerid, -1, ""cER"Семьи с таким названием нет");
	if(idfm == PI[playerid][pFamily]) return SendClientMessage(playerid, -1, ""cER"Вы не можете начать войну со своей же семьей");
	if(glFamilyCaptActive[idfm]) return SCM(playerid, -1, ""cER"Семья противника уже участвует в разборке");
	if(glFamilyCaptActive[PI[playerid][pFamily]]) return SCM(playerid, -1, ""cER"Ваша семья уже участвует в разборке");

	if(family_info[idfm][f_euro] < MoneyFamily) return SendClientMessage(playerid, -1, ""cER"У данной семьи нет столько евро в общаке");
	if(family_info[PI[playerid][pFamily]][f_euro] < MoneyFamily) return SendClientMessage(playerid, -1, ""cER"В вашей семьи нет столько евро в общаке");

	new FamilyCaptRang = -1;
	foreach(new targetid : Player)
	{
		if(PI[targetid][pFamily] == idfm)
		{
			if(PI[targetid][pFamilySozd] > 0 ||  PI[playerid][pFamilyZam] > 0)
			{
				FamilyCaptRang = 1;
			}
		}
	}
	if(FamilyCaptRang == -1) return SendClientMessage(playerid, -1, ""cER"В онлайне данной семьи нету основателя или заместителя");
	playerFamilyCaptFam[playerid] = idfm;

	gFamilyCaptMoney[PI[playerid][pFamily]] = MoneyFamily;
	format(playerFamilyCaptName[playerid], 32, NameFamily);

	format(stringer, sizeof(stringer), ""cWH"Вы действительно хотите начать разборки с семьей %s?", NameFamily);
	SPD(playerid, 6321, DIALOG_STYLE_MSGBOX, ""cMain"Разборки", stringer, "Да", "Нет");
	return 0x1;
}
DLG(7727, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	playerList[playerid][0] = listitem;
	ShowPlayerDialog(playerid, 5262, DSL, ""cMain"Транспорт", ""cWH"1. Выгрузить/загрузить\n2. Найти\n3. Продать", "Далее", "Выйти");
	return 1;
}
DLG(5262, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new list = playerList[playerid][0];
	switch(listitem)
	{
	case 0:
		{
			new car_id_ = GetPlayerListitemValue(playerid, list);
			format(stringer1, 128, "SELECT * FROM `family_cars` WHERE family = '%d' AND id = '%d'", PI[playerid][pFamily], car_id_);
			mysql_tquery(db_prod, stringer1, "LoadFamilyCar", "ii", playerid, list);
		}
	case 1:
		{
			new id = family_info[PI[playerid][pFamily]][f_cars][list];
			if(id != INVALID_VEHICLE_ID)
			{
				new Float:pos_x, Float:pos_y, Float:pos_z;
				GetVehiclePos(id, pos_x, pos_y, pos_z);
				GPSPlayer_(playerid, pos_x, pos_y, pos_z, "Семейный автомобиль");
			}
			else SendErr(playerid, "Машина не загружена");
		}
	case 2:
		{
			new f = PI[playerid][pFamily];
			new count = family_info[f][f_cost][list] / 2;
			if((family_info[f][f_money] + count) > 20000000)
			{
				SendMes(playerid, COLOR_GREEN, "Вы успешно продали автомобиль государству. На Ваш счет зачислено: %d рублей", count);
				SetPlayerMoney(playerid, count);
			}
			else
			{
				SendMes(playerid, COLOR_GREEN, "Вы успешно продали автомобиль государству. %d рублей было перечислено в общак.", count);
				family_info[f][f_money] += count;
			}

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `family_cars` WHERE `family` = '%d' AND `id` = '%d'", f, family_info[f][f_vehid][list]);
			mysql_tquery(db_prod, STRING_GLOBAL);
			print(stringer1);

			family_info[f][f_total_cars]--;
			family_info[f][f_cost][list] = 0;
			family_info[f][f_vehid][list] = 0;
			format(stringer1, 100, "UPDATE `family_system` SET `fam_total_cars` = '%d' WHERE `fam_id` = '%d'", family_info[f][f_total_cars], f);
			mysql_tquery(db_prod, stringer1);

			new id = family_info[f][f_cars][list];
			if(id != INVALID_VEHICLE_ID)
			{
				DestroyVehicle(id);
				family_info[f][f_cars][list] = INVALID_VEHICLE_ID;
			}
		}
	}
	return 1;
}
callback::LoadFamilyCar(playerid, free)
{
	if(!cache_num_rows()) return 1;
	new f = PI[playerid][pFamily];
	if(cache_get_field_content_int(0, "status"))
	{
		SendInf(playerid, "Авто было выгружено");
		format(stringer1, 128, "UPDATE `family_cars` SET status = '0' WHERE family=%d AND id=%d", f, family_info[f][f_vehid][free]);
		mysql_tquery(db_prod, stringer1, "", "");

		new id = family_info[f][f_cars][free];
		if(GetVehicleModel(id)) DestroyVehicle(id);
		family_info[f][f_cars][free] = INVALID_VEHICLE_ID;
		family_info[f][f_cost][free] = 0;
		family_info[f][f_vehid][free] = 0;
		return 1;
	}
	family_info[f][f_vehid][free] =     cache_get_field_content_int(0, "id");
	new model = 						cache_get_field_content_int(0, "model");
	family_info[f][f_vehx][free] =      cache_get_field_content_float(0, "x");
	family_info[f][f_vehy][free] =      cache_get_field_content_float(0, "y");
	family_info[f][f_vehz][free] =      cache_get_field_content_float(0, "z");
	family_info[f][f_veha][free] =      cache_get_field_content_float(0, "fa");
	family_info[f][f_color1][free] = 	cache_get_field_content_int(0, "color1");
	family_info[f][f_color2][free] = 	cache_get_field_content_int(0, "color2");
	family_info[f][f_cost][free] =     	cache_get_field_content_int(0, "cost");

	new vehid;
	if(family_info[f][f_vehx][free] == 0 && family_info[f][f_vehy][free] == 0 && family_info[f][f_vehz][free] == 0)
	{
		new rand = random(44);
		family_info[f][f_cars][free] = vehid = CreateVehicle(model, SalonRandSpawn[rand][0], SalonRandSpawn[rand][1], SalonRandSpawn[rand][2], SalonRandSpawn[rand][3], family_info[f][f_color1][free], family_info[f][f_color2][free], 600);
		SendClientMessage(playerid, COLOR_GREEN,"Ваш автомобиль не был припаркован после покупки и был отбуксирован на стоянку. Найти автомобиль -> /family - Транспорт - Найти машину");
	}
	else family_info[f][f_cars][free] = vehid = CreateVehicle(model, family_info[f][f_vehx][free], family_info[f][f_vehy][free], family_info[f][f_vehz][free], family_info[f][f_veha][free], family_info[f][f_color1][free], family_info[f][f_color2][free], 600);

	VehicleOwner[vehid] = playerid;
	SetVehicleNumberPlate(vehid, family_info[f][f_name]);

	SendMes(playerid, COLOR_GREEN, "Автомобиль (ID: %d) успешно загружен в игру.", vehid);
	format(stringer1, 128, "UPDATE `family_cars` SET status = '1' WHERE family=%d AND id=%d", f, family_info[f][f_vehid][free]);
	mysql_tquery(db_prod, stringer1);

	stringer1 = "";
	strcat(stringer1, family_info[f][f_name]);
	strcat(stringer1, ""cWH" ");
	strcat(stringer1, "Family");
	VehicleFamilyCars[vehid] = f;
	gFamily3DTextVehicle[vehid] = CreateDynamic3DTextLabel(stringer1, gFamilyColor[family_info[f][f_chat_color]], 0.0, 0.0, 1.0, 20.0, INVALID_PLAYER_ID, vehid, 1);
	return true;
}
DLG(7724, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	new familyid = PI[playerid][pFamily];
	foreach(new to_player: Player)
	{
		if(to_player == playerid) continue;
		if(PI[to_player][pFamily] != familyid) continue;

		family_info [ familyid ] [ f_members_amount ] -= 1;
		PI[to_player][pFamily] = 0;
		PI[to_player][pFamilySozd] = 0;
		PI[to_player][pFamilyZam] = 0;
		PI[to_player][pFamilyRank] = 0;

		if(playerFamilyNameTag[to_player] != INVALID_3DTEXT_ID)
		{
			UpdateDynamic3DTextLabelText(playerFamilyNameTag[to_player], -1, " ");

			DestroyDynamic3DTextLabel(playerFamilyNameTag[to_player]);
			playerFamilyNameTag[to_player] = INVALID_3DTEXT_ID;
		}
		format(stringer1, sizeof stringer1, "UPDATE `accounts` SET family = 0, familyzam = 0, familyrank = 0, familysozd = 0 WHERE name = '%s'", GetName(to_player));
		mysql_function_query ( db_prod, stringer1, false, "", "");
		SendErr(to_player, "Ваша семья расформирована");
	}
	format(stringer1, 128, "SELECT `id` FROM `accounts` WHERE family = '%d'", PI[playerid][pFamily]);
	mysql_tquery(db_prod, stringer1, "DeleteMembersFamily", "i", playerid);
	return 1;
}
DLG(7725, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	format(stringer1, 128, "UPDATE `family_system` SET fam_members_amount=fam_members_amount-1 WHERE fam_id = '%d'", PI[playerid][pFamily]); //
	mysql_tquery(db_prod, stringer1, "", "");

	PI[playerid][pFamily] = 0;
	PI[playerid][pFamilySozd] = 0;
	PI[playerid][pFamilyZam] = 0;
	PI[playerid][pFamilyRank] = 0;

	if(playerFamilyNameTag[playerid] != INVALID_3DTEXT_ID)
	{
		UpdateDynamic3DTextLabelText(playerFamilyNameTag[playerid], -1, " ");

		DestroyDynamic3DTextLabel(playerFamilyNameTag[playerid]);
		playerFamilyNameTag[playerid] = INVALID_3DTEXT_ID;
	}
	format(stringer1, sizeof stringer1, "UPDATE `accounts` SET family = 0, familyzam = 0, familyrank = 0, familysozd = 0 WHERE name = '%s'", GetName(playerid));
	mysql_function_query ( db_prod, stringer1, false, "", "");
	SendClientMessage(playerid, COLOR_RED, "Вы покинули семью. Обязанности создателя были с Вас сняты");
	return 1;
}
DLG(7720, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	family_number[playerid] = listitem;
	ShowPlayerDialog(playerid, 7721, DIALOG_STYLE_INPUT, ""cMain"Изменить название ранга", ""cWH"Введите новое название ранга:", "Далее", "Назад");
	return 1;
}
DLG(7721, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	if(strlen(inputtext) < 5 || strlen(inputtext) > 12) return SendClientMessage(playerid, COLOR_RED, "Название ранга должно быть длиной от 5 до 12 символов");
	new c = family_number[playerid], f = PI[playerid][pFamily];

	strmid(family_rank_name[f][c], inputtext, 0, strlen(inputtext), 12);
	SendClientMessage(playerid, COLOR_GREEN, "Вы успешно изменили название выбранного ранга");
	family_number[playerid] = -1;
	mysql_format(db_prod, stringer, 300, "UPDATE `family_system` SET `fam_ranks` = '%e,%e,%e,%e,%e,%e,%e' WHERE `fam_id` = '%d' LIMIT 1",family_rank_name[f][0], family_rank_name[f][1], family_rank_name[f][2], family_rank_name[f][3], family_rank_name[f][4], family_rank_name[f][5], family_rank_name[f][6], f);
	mysql_function_query(db_prod, stringer, false, "", "");
	return 1;
}
DLG(7722, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	global_string = "";
	mysql_format(db_prod, global_string, 128, "SELECT `name`,`family`,`familysozd` FROM accounts WHERE name = '%e'", inputtext);
	mysql_tquery(db_prod, global_string, "KickFromFamily", "is", playerid, inputtext);
	return 1;
}
DLG(7723, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	if(strval(inputtext) < 1 || strval(inputtext) > 7) return SendClientMessage(playerid, COLOR_RED, "Номер ранга от 1 до 7");
	new fmt_msg[128];
	format(fmt_msg, sizeof(fmt_msg), "{%s}[%s] {FFD39B}%s[%s] установил доступ к общаку с %d ранга",family_chat_color [family_info [PI[playerid][pFamily]] [f_chat_color]], family_info [PI[playerid][pFamily]] [f_name], GetName(playerid), family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1], strval(inputtext));
	family_message(PI[playerid][pFamily],-1, fmt_msg);
	family_info[PI[playerid][pFamily]][f_sklad_dostup] = strval(inputtext);
	global_string = "";
	format(global_string, 300, "UPDATE `family_system` SET `fam_sklad_dostup` = '%d' WHERE `fam_id` = %d LIMIT 1",strval(inputtext), PI[playerid][pFamily]);
	mysql_function_query(db_prod, global_string, false, "", "");
	return 1;
}
DLG(122412, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		SendClientMessage(playerid,COLOR_GREEN,"Вы отказались от покупки автомобиля..");
		return 1;
	}

	switch(listitem)
	{

		case 0:
		{
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `ownable_cars` (`c_model`, `c_x`, `c_y`, `c_z`, `c_a`, `c_class`, `c_owner`, `c_fuel`, `c_color1`, `c_color2`, `c_lock`, `c_price`, `c_health`) VALUES ('%d', '0', '0', '0', '0', '1', '%e', '45', '-1', '-1', '1', '9000000', '1000.0')", gDonateCars[selectcar_DCB[playerid]], GetName(playerid));
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			PI[playerid][pPerfectCoins] -= gDonatePrice[selectcar_DCB[playerid]];
			PI[playerid][pCountCars] ++;

			fLogs("[cars] %s +%i донат", GetName(playerid), gDonateCars[selectcar_DCB[playerid]]);
			fLogs("[coin] %s -%i тачка %s", GetName(playerid), gDonatePrice[selectcar_DCB[playerid]], VehicleNames[gDonateCars[selectcar_DCB[playerid]]-400]);
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET credits=%d, countcars=%d WHERE id=%d", PI[playerid][pPerfectCoins], PI[playerid][pCountCars], PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");

			SendFormatInf(playerid, "Вы успешно приобрели "cMain"%s за "cMain"%d"cWH" Perfect Coins", VehicleNames[gDonateCars[selectcar_DCB[playerid]]-400], gDonatePrice[selectcar_DCB[playerid]]);
		}
		case 1:
		{
			new f = PI[playerid][pFamily];
			if(!f)
			{
				return SendErr(playerid, "У Вас нет семьи");
			}
			if(family_info[f][f_total_cars] >= 5)
			{
				return SendErr(playerid, "Ваш семейный автопарк не может включать более 5 машин");
			}

			PI[playerid][pPerfectCoins] -= gDonatePrice[selectcar_DCB[playerid]];
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET credits=%d, countcars=%d WHERE id=%d", PI[playerid][pPerfectCoins], PI[playerid][pCountCars], PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");

			family_info[f][f_total_cars] ++;
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `family_cars` (`model`, `x`, `y`, `z`, `fa`, `color1`, `color2`, `family`, `cost`) VALUES ('%d', '0', '0', '0', '0', '%d', '%d', '%d', '%d')", gDonateCars[selectcar_DCB[playerid]], 0, 0, f, 0);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Автомобиль",
			""cWH"Поздравляем Вас с покупкой семейного автомобиля!\n\
			Автомобиль был отбуксирован на автостоянку\n\n\
			Для загрузки автомобиля в игру, используйте: "cMain"/family\n\
			"cWH"Для поиска семейного автомобиля, используйте: "cMain"/family", "Закрыть", "");
		}
	}
	Hide_DonateCarBuy(playerid);
	return 1;
}
DLG(12000, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		BuyCloseCar(playerid);
		SendClientMessage(playerid,COLOR_GREEN,"Вы отказались от покупки автомобиля.. Приходите еще!");
		return 1;
	}
	if(!listitem)
	{
		ShowPlayerDialog(playerid,16000,DIALOG_STYLE_MSGBOX,""cMain"Покупка автомобиля","\
		"cWH"Вы действительно хотите приобрести данный автомобиль?\n\n\
		Нажмите 'Да' чтобы приобрести автомобиль\n\
		Нажмите 'Нет' чтобы покинуть автосалон", "Да","Нет");
		return 1;
	}
	if(GetPlayerData(playerid, SalonCarID) == INVALID_VEHICLE_ID) return 1;

	new f = PI[playerid][pFamily];
	if(!f)
	{
		BuyCloseCar(playerid);
		return 1;
	}
	if(family_info[f][f_total_cars] >= 5)
	{
		BuyCloseCar(playerid);
		return SendErr(playerid, "Ваш семейный автопарк не может включать более 5 машин");
	}
	new cost, model;

	if(g_player_salon[playerid] == 1) cost = carsC[pPressed[playerid]][1], model = carsC[pPressed[playerid]][0];
	else cost = carsC[pPressed[playerid]][1], model = carsC[pPressed[playerid]][0];

	if(family_info[f][f_money] < cost)
	{
		BuyCloseCar(playerid);
		return SendErr(playerid, "В общаке семьи нет столько денег.");
	}
	family_info[f][f_money] -= cost;
	family_info[f][f_total_cars] ++;

	format(stringer1, 100, "UPDATE `family_system` SET `fam_money` = '%d', `fam_total_cars` = '%d' WHERE `fam_id` = '%d'", family_info[f][f_money], family_info[f][f_total_cars], f);
	mysql_tquery(db_prod, stringer1);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `family_cars` (`model`, `x`, `y`, `z`, `fa`, `color1`, `color2`, `family`, `cost`) VALUES ('%d', '0', '0', '0', '0', '%d', '%d', '%d', '%d')", model, colors[playerid][0], colors[playerid][1], f, cost);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Автомобиль",
	""cWH"Поздравляем Вас с покупкой семейного автомобиля!\n\
	Автомобиль был отбуксирован на автостоянку\n\n\
	Для загрузки автомобиля в игру, используйте: "cMain"/family\n\
	"cWH"Для поиска семейного автомобиля, используйте: "cMain"/family", "Закрыть", "");

	BuyCloseCar(playerid);
	return 1;
}
DLG(12001, playerid, response, listitem, inputtext[])
{
	if(!response) return DeletePVar(playerid,"arrestcar");
	if(GetPVarInt(playerid,"arrestcar") == 0) return SendClientMessage(playerid, -1, ""cER"Произошла ошибка");
	new i = GetPVarInt(playerid,"arrestcar");

	new
		vehid = GetPVarInt(playerid, "arrestcarid"),
		sql_id = GetPVarInt(playerid, "arrestcarsql");
	new summ;
	if(sscanf(inputtext,"p<,>s[128]i", C_DATA[i][c_arrestinfo], summ))
	{
		format(global_string,sizeof(global_string),"{9ACD32}Марка/модель:\t"cWH"%s\n\
		{9ACD32}Владелец:\t"cWH"%s\n\n\n\
		Введите причину ареста указанного транспортного средства и размер штрафа:\n\n\
		Пример: Неправильная парковка, 1000",
		VehicleNames[GetVehicleModel(vehid)-400],GetName(i));
		ShowPlayerDialog(playerid, 12001, DIALOG_STYLE_INPUT, ""cMain"Арест транспорта", global_string,"Ввод", "Отмена");
		return 1;
	}

	if(!(1 <= summ <= 1000000))
	{
		SendClientMessage(playerid, COLOR_RED, "Сумма от 1 до 1000000 руб");
		format(global_string,sizeof(global_string),"{9ACD32}Марка/модель:\t"cWH"%s\n\
		{9ACD32}Владелец:\t"cWH"%s\n\n\n\
		Введите причину ареста указанного транспортного средства и размер штрафа:\n\n\
		Пример: Неправильная парковка, 1000",
		VehicleNames[GetVehicleModel(vehid)-400],GetName(i));
		ShowPlayerDialog(playerid, 12001, DIALOG_STYLE_INPUT, ""cMain"Арест транспорта", global_string,"Ввод", "Отмена");
		return 1;
	}

	C_DATA[i][c_arrest] = 1;

	SCM(i,-1,"Ваш автомобиль был эвакуирован на штрафстоянку");
	format(global_string,sizeof global_string,"Причина: %s, Штраф: %d рублей.", C_DATA[i][c_arrestinfo], summ);
	SCM(i,-1,global_string);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL),"INSERT INTO `fines` (`Name`, `Sum`, `Reason`, `Date`, `Writer`) VALUES ('%e', '%d', '%e', '%d.%d.%d', '%e')", GetName(i), summ,C_DATA[i][c_arrestinfo], day, month, year, GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");


	SCM(i,-1,"{F7D757}| "cWH"Вам выписали штраф. Чтобы посмотреть все свои штрафы, введите команду /mytickets.");
	mysql_format(db_prod, global_string, sizeof global_string, "UPDATE `ownable_cars` SET c_arrest = '1', c_arrestinfo = '%e' WHERE c_owner = '%s' AND id = '%i'", C_DATA[i][c_arrestinfo], GetName(i), sql_id);
	mysql_tquery(db_prod, global_string, "", "");
	DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));

	for(new z; z < MAX_LOAD_VEHICLE; z++)
	{
		if(PlayerVehicle[i][z] == vehid)
		{
			DestroyPlayerVehicle(i, z);
			break;
		}
	}
	SCM(playerid,-1,"Транспорт был успешно помещен на штрафстоянку");
	return 1;
}
DLG(12002, playerid, response, listitem, inputtext[])
{
	if(!response)
	if(null(inputtext))return SendClientMessage(playerid,COLOR_GREY,"Вы ничего не ввели!");
	new id = strval(inputtext);
	mysql_format(db_prod, global_string,sizeof global_string,"SELECT * FROM `fines` WHERE Num = '%d'", id);
	mysql_tquery(db_prod, global_string, "PaymentTickets","d", playerid);
	return 1;
}
DLG(12003, playerid, response, listitem, inputtext[])
{
	if(!response) return DeletePVar(playerid,"id_tickets") & DeletePVar(playerid,"summ_tickets");
	new id = GetPVarInt(playerid,"id_tickets"); DeletePVar(playerid,"id_tickets");
	new summ = GetPVarInt(playerid,"summ_tickets"); DeletePVar(playerid,"summ_tickets");
	if(GetPlayerRubble(playerid) < summ) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

	SetPlayerMoney(playerid, -summ);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `fines` WHERE `Num` = '%d'", id);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");


	format(stringer1, sizeof stringer1,"Штраф № %d успешно оплачен.",id);
	SCM(playerid,-1,stringer1);
	return 1;
}
DLG(12004, playerid, response, listitem, inputtext[])
{
	if(!response) return false;

	new car_id_ = GetPlayerListitemValue(playerid, listitem);
	car_id[playerid] = car_id_;
	if(GetPVarType(playerid,#P_Dps_Id))
	{
		new car_model = GetPlayerListitemValue1(playerid, listitem);
		format(stringer1, sizeof(stringer1), ""cWH"Сотрудник ГИБДД %s Производит снятие ареста с вашего Т/С %s\nСтоимость услуги 1500 рублей\nВы согласны?",GetName(playerid),VehicleNames[car_model-400]);
		ShowPlayerDialog(GetPVarInt(playerid,#P_Dps_Id),12005,DIALOG_STYLE_MSGBOX,""cMain"Выкуп автомобиля",stringer1,"Да","Нет");
		SCM(playerid, -1, "Предложение отправлено игроку. Ожидаем ответа..");
		SetPVarInt(GetPVarInt(playerid,#P_Dps_Id),#P_Arr_Id,playerid);
		return 1;
	}
	mysql_format(db_prod, global_string,sizeof global_string,"SELECT * FROM `fines` WHERE Name = '%s'",GetName(playerid));
	mysql_tquery(db_prod, global_string, "CheckTickets","dd", playerid, 1);
	return 1;
}
DLG(12005, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		SCM(playerid,-1,"Операция прервана по Вашей инициативе.");
		car_id[playerid] = -1;
		if(GetPVarType(playerid,#P_Arr_Id))
		{
			new pid = GetPVarInt(playerid,#P_Arr_Id);
			SCM(pid, -1, "Игрок отклонил Ваше предложение");
			car_id[pid] = -1;
			DeletePVar(pid,#P_Dps_Id);
			DeletePVar(playerid,#P_Arr_Id);
		}
		return 1;
	}
	if(GetPVarType(playerid,#P_Arr_Id))
	{
		new pid = GetPVarInt(playerid,#P_Arr_Id);
		if(GetPlayerRubble(playerid) < 1500)
		{
			SCM(pid, -1, "У игрока недостаточно средств для оплаты.");
			DeletePVar(pid,#P_Dps_Id);
			DeletePVar(playerid,#P_Arr_Id);
			return SCM(playerid, -1, "У Вас недостаточно средств для оплаты.");
		}
		SetPlayerMoney(playerid, -1500);
		format(stringer1, sizeof(stringer1), "Вы успешно освободили из под ареста автомобиль игрока %s", GetName(playerid));
		printf("carid_pid %d",car_id[pid]);
		printf("carid_p %d",car_id[playerid]);
		car_id[playerid] = car_id[pid];
		printf("carid_p1 %d",car_id[playerid]);
		car_id[pid] = -1;
		DeletePVar(pid,#P_Dps_Id);
		DeletePVar(playerid,#P_Arr_Id);
		SCM(pid,-1,stringer1);
	}
	else
	{
		if(GetPlayerRubble(playerid) < 5000) return SCM(playerid, -1, "У Вас недостаточно средств для оплаты.");
		SetPlayerMoney(playerid, 5000);
	}
	printf("carid_p2 %d",car_id[playerid]);
	mysql_format(db_prod, global_string, sizeof global_string, "UPDATE `ownable_cars` SET c_arrest = '0', c_arrestinfo = '-' WHERE c_owner = '%s' AND id = '%d'",GetName(playerid), car_id[playerid]);
	mysql_tquery(db_prod, global_string, "", "");
	printf(global_string);
	SCM(playerid, -1, "Ваш автомобиль успешно освобожден из под ареста, используйте /car");
	car_id[playerid] = -1;
	return 1;
}
DLG(12006, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new tick_id = GetPlayerListitemValue(playerid, listitem);
	mysql_format(db_prod, global_string,sizeof global_string,"SELECT * FROM `fines` WHERE Num = '%d'", tick_id);
	mysql_tquery(db_prod, global_string, "PaymentTickets","d", playerid);
	return 1;
