CMD:no(playerid, params[])
{
	new proposition_id = proposition_info[playerid][P_ING_ID];

	if(proposition_id != INVALID_PLAYER_ID)
	{
		if(proposition_info[proposition_id][P_OUT_ID] == playerid)
		{
			proposition_info[proposition_id] = g_proposition_default_values;

			SCMF(proposition_id, 0xFF6600FF, "%s отказался от Вашего предложения", GetName(playerid));
			SCMF(playerid, 0xFF6600FF, "Вы отказались от предложения игрока %s", GetName(proposition_id));
			GameTextForPlayer(proposition_id, "~r~no", 4000, 1);
		}
		else SendClientMessage(playerid, 0xFF6600FF, "Вы отказались от предложения игрока");
		proposition_info[playerid] = g_proposition_default_values;
	}
	return 1;
}
CMD:cancel(playerid, params[])
{
	new proposition_id = proposition_info[playerid][P_OUT_ID];
	if(proposition_id != INVALID_PLAYER_ID)
	{
		if(proposition_info[proposition_id][P_ING_ID] == playerid)
		{
			proposition_info[proposition_id] = g_proposition_default_values;
			SCMF(proposition_id, 0xFF6600FF, "%s отозвал свое предложение", GetName(playerid));
			SCMF(playerid, 0xFF6600FF, "Вы отозвали свое предложение для %s", GetName(proposition_id));
		}
		else SendClientMessage(playerid, 0xFF6600FF, "Вы отозвали свое последнее предложение");
		proposition_info[playerid] = g_proposition_default_values;
	}
	return 1;
}

DLG(19030, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!listitem)
	{
		ShowPlayerBankAccounts(playerid, 0);
		return 1;
	}
	ShowPlayerCreateBankAccount(playerid);
	return 1;
}
DLG(8333, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new len = strlen(inputtext);

		if(!(3 <= len <= 32)) return ShowPlayerCreateBankAccount(playerid);
		if(IsABadBankAccountName(inputtext)) return ShowPlayerCreateBankAccount(playerid);
		if(GetPlayerRubble(playerid) < 1000000) return SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно денег");

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT COUNT(*) FROM `bank_accounts` WHERE `owner` = '%d'", PI[playerid][pID]);
		mysql_tquery(db_prod, STRING_GLOBAL, "CreateBankAccount", "ds", playerid, inputtext);
	}
	return 1;
}

DLG(3837, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem[playerid][listitem];
		g_player_listitem_use[playerid] = accountid;
		ShowPlayerBankAccountOperation(playerid);
	}
	return 1;
}
DLG(2532, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem[playerid][listitem];
		g_player_listitem_use[playerid] = accountid;


		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы хотите удалить счет %s с балансом %d %s\nПри удаление счета все денежные средства будут выданы наличными", GetPlayerBankAccountData(playerid, accountid, B_NAME), GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_TYPE) ? ("евро") : ("рублей"));
		ShowPlayerDialog(playerid, 2533, DIALOG_STYLE_MSGBOX, ""cMain"Удаление счета", STRING_GLOBAL, "Принять", "Отмена");
	}
	return 1;
}

DLG(2533, playerid, response, listitem, inputtext[]) //kakaxa
{
	if(!response) return ShowPlayerBankAccounts(playerid, 1);

	new accountid = g_player_listitem_use[playerid];
	if(accountid == 0) return SendClientMessage(playerid, -1, ""cER"Запрещено удалять основной счет");

	if(GetPlayerLimitMoney(playerid, GetPlayerBankAccountData(playerid, accountid, B_BALANCE)))
	{
		SendErr(playerid, "У Вас максимальное количество денег.");
		return 1;
	}
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `bank_accounts` WHERE `id` = '%d'", GetPlayerBankAccountData(playerid, accountid, B_ID));
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	if(mysql_errno() != 0) return SendClientMessage(playerid, -1, ""cER"Произошла ошибка, обратитесь к администрации");

	if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) > 0)
	{
		if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 0)
		{
			SetPlayerMoney(playerid, GetPlayerBankAccountData(playerid, accountid, B_BALANCE));
			g_player_bank_accounts[playerid][accountid][B_BALANCE] = 0;
		}
		if(GetPlayerBankAccountData(playerid, accountid, B_TYPE) == 1)
		{
			TransferEuro(-1, playerid, GetPlayerBankAccountData(playerid, accountid, B_BALANCE), "Удаление счета");
			g_player_bank_accounts[playerid][accountid][B_BALANCE] = 0;
		}
	}
	SendClientMessage(playerid, 0xCCCCCCFF, ""cDA"Вы успешно удалили счет в банке");
	ClearPlayerBankAccountInfo(playerid, accountid);
	return 0x1;
}

DLG(8534, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];

		if(!IsValidBankAccount(playerid, accountid)) return 1;

		switch(listitem)
		{
		case 0:
			{
				global_string = "";

				format
				(
				global_string, sizeof global_string,
				""cWH"Номер счёта: "cMain"%d\n"\
				""cWH"Название счёта: "cMain"%s\n"\
				""cWH"Баланс счёта: "cMain"%d %s\n"\
				""cWH"Дата создания: "cMain"%s",
				GetPlayerBankAccountData(playerid, accountid, B_ID),
				GetPlayerBankAccountData(playerid, accountid, B_NAME),
				GetPlayerBankAccountData(playerid, accountid, B_BALANCE),
				GetPlayerBankAccountData(playerid, accountid, B_TYPE) ? ("евро") : ("рублей"),
