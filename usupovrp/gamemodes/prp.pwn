}
GiveBankMoney(playerid, money)
{
	new accountid = PI[playerid][pMainBankAccount];
	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "У Вас не установлен основной банковский счёт");
	if(g_player_bank_accounts[playerid][accountid][B_BALANCE] + money < -100000000) return SendClientMessage(playerid, COLOR_RED, "У Вас будет достигнут лимит денег на этом счете");

	g_player_bank_accounts[playerid][accountid][B_BALANCE] += (money);

	format(stringer1, sizeof stringer1, "+ Переводы в банке %d рублей", money);
	SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
	UpdateBankMoneyText(playerid, accountid);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
	mysql_tquery(db_prod, STRING_GLOBAL);

	return 1;
}

TransferEuro(playerid, toplayerid, count, info[])
{
	new string_money[64];
	if(toplayerid != -1)
	{
		playerEuro[toplayerid] += count;
		if(playerEuro[toplayerid] < 0) playerEuro[toplayerid] = 0;
		UpdatePlayerData(toplayerid, "pEuro", playerEuro[toplayerid]);

		if(!IsPlayerFromThePhone(toplayerid))
		{
			if(euro_PTD_MOB[toplayerid] != PlayerText:INVALID_TEXT_DRAW)
			{
				format(string_money, sizeof(string_money), "e%08d", playerEuro[toplayerid]);
				PlayerTextDrawSetString(toplayerid, euro_PTD_MOB[toplayerid], string_money);
			}
		}
	}
	if(playerid != -1)
	{
		playerEuro[playerid] -= count;
		if(playerEuro[playerid] < 0) playerEuro[playerid] = 0;
		UpdatePlayerData(playerid, "pEuro", playerEuro[playerid]);

		if(!IsPlayerFromThePhone(playerid))
		{
			if(euro_PTD[playerid][1] != PlayerText:INVALID_TEXT_DRAW)
			{
				format(string_money, sizeof(string_money), "%09d", playerEuro[playerid]);
				PlayerTextDrawSetString(playerid, euro_PTD[playerid][1], string_money);
			}
		}
	}
	if(playerid != -1 && toplayerid != -1)
	{
		format(string_money, sizeof(string_money), "+%d euro", count);
		ShowNotify(toplayerid, string_money);

		format(string_money, sizeof(string_money), "%d euro", count);
		ShowNotify(playerid, string_money);

		fLogs("[euro] %s -%i | %s +%i | %s", GetName(playerid), count, GetName(toplayerid), count, info);
		return 0x1;
	}
	if(playerid != -1)
	{
		format(string_money, sizeof(string_money), "%d euro", count);
		ShowNotify(playerid, string_money);

		fLogs("[euro] SERVER +%i | %s -%i | %s", count, GetName(playerid), count, info);
	}
	if(toplayerid != -1)
	{
		format(string_money, sizeof(string_money), "+%d euro", count);
		ShowNotify(toplayerid, string_money);

		fLogs("[euro] %s +%i | SERVER -%i | %s", GetName(toplayerid), count, count, info);
	}
	return 1;
}

