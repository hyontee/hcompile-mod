								GivePlayerWeapon(playerid, 5, 1);
								GivePlayerWeapon(playerid, 22, 100);
								GivePlayerWeapon(playerid, 30, 100);
								GivePlayerWeapon(playerid, 29, 100);
								GivePlayerWeapon(playerid, 34, 100);
							}
						}
					case 5:
						{
