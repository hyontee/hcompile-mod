DLG(2523, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"Вы не участвуете в обмене");

	if(strlen(inputtext) == 0)
	{
		ShowPlayerDialog(playerid, 2523, DIALOG_STYLE_INPUT, ""cMain"Рубли", "\
			Введите сумму, которую вы хотите добавить в свой вклад.\n\
			Сумма не может быть менее 1.000 и более 2.000.000.000 рублей\n\
			Деньги будут списаны с ваших наличных", "Принять", "Отмена");
		return 0x1;
	}
	if(strval(inputtext) < 1000 || strval(inputtext) > 2000000000)
	{
		ShowPlayerDialog(playerid, 2523, DIALOG_STYLE_INPUT, ""cMain"Рубли", "\
			Введите сумму, которую вы хотите добавить в свой вклад.\n\
			Сумма не может быть менее 1.000 и более 2.000.000.000 рублей\n\
			Деньги будут списаны с ваших наличных", "Принять", "Отмена");
		return 0x1;
	}
	if(GetPlayerRubble(playerid) < strval(inputtext))
	{
		SendClientMessage(playerid, -1, ""cER"У вас недостаточно денежных средств");
		ShowPlayerDialog(playerid, 2523, DIALOG_STYLE_INPUT, ""cMain"Рубли", "\
			Введите сумму, которую вы хотите добавить в свой вклад.\n\
			Сумма не может быть менее 1.000 и более 2.000.000.000 рублей\n\
			Деньги будут списаны с ваших наличных", "Принять", "Отмена");
		return 0x1;
	}

	AddExchangeBet(playerid, BET_RUBBLE, strval(inputtext));
	return 0x1;
}

