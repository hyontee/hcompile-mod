DLG(8000, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "SELECT * FROM `accounts` WHERE `name` = '%s' LIMIT 1", inputtext);
	mysql_tquery(db_vost, STRING_GLOBAL, "CheckPlayerHaveAccount", "is", playerid, inputtext);

	return 1;
}

DLG(8001, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "SELECT * FROM `accounts` WHERE `name` = '%s' AND `password` = MD5('%s') LIMIT 1", vost_name[playerid], inputtext);
	mysql_tquery(db_vost, STRING_GLOBAL, "CheckPlayerAccountPassword", "is", playerid, vost_name[playerid]);

	return 1;
}

callback::CheckPlayerAccountPassword(playerid, const name[])
{
	new rows = cache_num_rows();

	if(!rows)
		return SendClientMessage(playerid, COLOR_RED, "Пароль введен неверно.");

	new money = cache_get_field_content_int(0, "cash");
	new level = cache_get_field_content_int(0, "level");

	new admin = cache_get_field_content_int(0, "admin");

	SetPlayerMoney(playerid, money);

	PI[playerid][pLevel] = level;

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `accounts` SET `cash` = '%d', `level` = '%d', `admin` = '%d' WHERE `name` = '%s' LIMIT 1", money, level, admin, name);
	mysql_tquery(db_prod, STRING_GLOBAL);

	if(admin > 0)
	{
		STRING_GLOBAL[0] = EOS;

		mysql_format
		(
			db_prod, string, sizeof(string),
			"INSERT INTO `admin` (`name`, `level`, `last_connect`, `put_admin`, `data`, `day`, `buyadmin`) VALUES ('%s', %d, '%02d.%02d.%04d', '%s', '%02d.%02d.%04d', '%d', '%d')",
			name,
			admin,
			day,
			month,
			year,
			GetName(playerid),
			day,
			month,
			year,
			gettime(),
			1
		);

		mysql_tquery(db_prod, STRING_GLOBAL);
	}

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "SELECT * FROM `freekassa_payments` WHERE `account` = '%s'", name);
	mysql_tquery(db_vost, STRING_GLOBAL, "CheckPlayerDonate", "siiii", name, playerid, money, level, admin);

	return 1;
}

callback::CheckPlayerHaveAccount(playerid, const name[])
{
	new rows = cache_num_rows();

	if(!rows)
		return SendClientMessage(playerid, COLOR_RED, "Аккаунта с таким именем не существует. Попробуйте другое.");

	format(vost_name[playerid], 24, "%s", name);

	ShowPlayerDialog
	(
		playerid, 8001, DIALOG_STYLE_INPUT,
		"{FF9900}Восстановление аккаунта",
		"{ffffff}Введите в окно ниже пароль от выбранного аккаунта",
		"Далее", "Закрыть"
	);

	return 1;
}

callback::CheckPlayerDonate(const name[], playerid, money, level, admin)
{
	new rows = cache_num_rows();

	if(rows)
	{
		for(new i = 0; i != rows; i ++)
		{
			new donate = cache_get_field_content_int(0, "sum");

			PI[playerid][pPerfectCoins] += donate;

			if(PI[playerid][pPerfectCoins] > 15000)
				PI[playerid][pPerfectCoins] = 4999;

			MysqlUpdatePlayerInt(playerid, "credits", PI[playerid][pPerfectCoins]);
		}
	}

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "SELECT * FROM `ownable_cars` WHERE `owner_name` = '%s'", name);
	mysql_tquery(db_vost, STRING_GLOBAL, "CheckPlayerCars", "siiii", name, playerid, money, level, admin);
}

callback::CheckPlayerCars(const name[], playerid, money, level, admin)
{
	new rows = cache_num_rows();

	if(!rows)
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof STRING_GLOBAL, "Деньги: {FF9900}%d рублей{ffffff}. Уровень: {FF9900}%d{ffffff}. Админка: {FF9900}%d уровня{ffffff}. {FF9900}Донат: %d Perfect Coins", money, level, admin, PI[playerid][pPerfectCoins]);

		SendClientMessage(playerid, -1, "{FF9900}Вы успешно восстановили аккаунт.");
		SendClientMessage(playerid, -1, STRING_GLOBAL);
	}

	else
	{
		new cars_coins = 0;

		for(new i = 0; i != rows; i ++)
		{
			new model_id = cache_get_field_content_int(i, "model");

			for(new idx = 0; idx != sizeof g_coins_car_list; idx ++)
			{
				if(g_coins_car_list[idx][0] == model_id)
				{
					PI[playerid][pPerfectCoins] += g_coins_car_list[idx][2];

					if(PI[playerid][pPerfectCoins] > 15000)
						PI[playerid][pPerfectCoins] = 4999;

					MysqlUpdatePlayerInt(playerid, "credits", PI[playerid][pPerfectCoins]);

					cars_coins += g_coins_car_list[idx][2];
				}
			}
		}

		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof STRING_GLOBAL, "Деньги: {FF9900}%d рублей{ffffff}. Уровень: {FF9900}%d{ffffff}. Админка: {FF9900}%d уровня{ffffff}. {FF9900}Донат: %d Perfect Coins (и за автомобили)", money, level, admin, PI[playerid][pPerfectCoins]);

		SendClientMessage(playerid, -1, "{FF9900}Вы успешно восстановили аккаунт.");
		SendClientMessage(playerid, -1, STRING_GLOBAL);
	}

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `accounts` SET `name` = 'vost_%s' WHERE `name` = '%s' LIMIT 1", name, name);
	mysql_tquery(db_vost, STRING_GLOBAL);

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "INSERT INTO `vost_stats` (`name`, `money`, `level`, `admin`, `cars`, `donate`) VALUES ('%s', '%d', '%d', '%d', '%d', '%d')", name, money, level, admin, rows, PI[playerid][pPerfectCoins]);
	mysql_tquery(db_prod, STRING_GLOBAL);

	return 1;
}

