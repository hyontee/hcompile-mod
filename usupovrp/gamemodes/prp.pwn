IsPlayerUnMats(playerid)
{
	switch(PI[playerid][pMember])
	{
	case TEAM_CSKA: if(IsPlayerInRangeOfPoint(playerid, 20.0, 152.2886,247.8900,12.0850)) return 1;
	case TEAM_SPARTAK: if(IsPlayerInRangeOfPoint(playerid, 20.0, 1015.5616,-419.7861,4.0300)) return 1;
	case TEAM_RUSMAFIA: if(IsPlayerInRangeOfPoint(playerid, 20.0, 473.1967,760.3156,12.0000)) return 1;
	case TEAM_ITALMAFIA: if(IsPlayerInRangeOfPoint(playerid, 20.0, 368.6578,1547.7220,12.0500)) return 1;
	}
	return 0;
}
GetSkladMaterials(playerid, fraction)
{
	new id;
	switch(fraction)
	{
	case TEAM_CSKA: id = 1;
	case TEAM_SPARTAK: id = 0;
	case TEAM_RUSMAFIA: id = 3;
	case TEAM_ITALMAFIA: id = 2;
	case TEAM_ARMY: id = 4;
	}
	Mats[id] += materials_count[GetPlayerVehicleID(playerid)];

	global_string = "";
	switch(fraction)
	{
	case TEAM_CSKA: format(global_string, 128, "UPDATE gang SET cska_mats = '%d'", Mats[id]);
	case TEAM_SPARTAK: format(global_string, 128, "UPDATE gang SET spartak_mats = '%d'", Mats[id]);
	case TEAM_RUSMAFIA: format(global_string, 128, "UPDATE gang SET rusmaf_mats = '%d'", Mats[id]);
	case TEAM_ITALMAFIA: format(global_string, 128, "UPDATE gang SET itmaf_mats = '%d'", Mats[id]);
	case TEAM_ARMY: format(global_string, 128, "UPDATE gang SET army_mats = '%d'", Mats[id]);
	}
	mysql_tquery(db_prod, global_string, "", "");
	SendMes(playerid, COLOR_GREEN, "Вы завезли на склад %d материалов", materials_count[GetPlayerVehicleID(playerid)]);

	if(PI[playerid][pSex] == 1) format(string, 90, "%s[%d] завез на склад %d материалов", GetName(playerid), playerid, materials_count[GetPlayerVehicleID(playerid)]);
	else format(string, 90, "%s[%d] завезла на склад %d материалов", GetName(playerid), playerid, materials_count[GetPlayerVehicleID(playerid)]);
	SendFMes(PI[playerid][pMember], COLOR_YELLOW2, string);

	materials_count[GetPlayerVehicleID(playerid)] = 0;
	if(materials_text[GetPlayerVehicleID(playerid)] != INVALID_3DTEXT_ID) DestroyDynamic3DTextLabel(materials_text[GetPlayerVehicleID(playerid)]);
	materials_text[GetPlayerVehicleID(playerid)] = INVALID_3DTEXT_ID;
	return 1;
}
ShowHappyHoursDialog(playerid)
{
	new fmt_str[80], frmt_str[80];

	if(happy_hours) format(fmt_str, sizeof fmt_str, "{F9A21F}(%02d:%02d)", happy_hours_hour, happy_hours_minute);
	else format(fmt_str, sizeof fmt_str, "{A1A09E}недоступно");

	if(happy_hours) format(frmt_str, sizeof frmt_str, "{04b004}(%d минут(у))", happy_hours_time);
	else format(frmt_str, sizeof frmt_str, "{A1A09E}недоступно");

	global_string = "";

	format(global_string, 512, "- {63BD4E}Активировать "cWH"счастливые часы\n- {F04245}Отключить "cWH"счастливые часы\n- Изменить время окончания счастливых часов %s\n- Частота оповещения %s", fmt_str, frmt_str);
	ShowPlayerDialog(playerid, 5400+6, DIALOG_STYLE_LIST, ""cMain"Счастливые часы", global_string, "Выбрать", "Отмена");

	return 1;
}
FractionProtectionServer(playerid, text[])
{
	global_string = "";

	if(strfind(text, member_message[playerid], true) != -1)
	{
		member_count_message[playerid] ++;
		member_message_time[playerid] = GetTickCount() + 20000; // 20 сек на сброс похожих сообщений
	}
	if(member_count_message[playerid] >= 5)
	{
		SendClientMessage(playerid, COLOR_RED, "Вам был выдан мут на 10 минут по подозрению в сливе");
		SendClientMessage(playerid, COLOR_RED, "Если Вы повторно будете производить противоправные действия, то будете выгнаны из организации");
		global_string = "";
		format(global_string, 128, "Внимание! Товарищу %s(%d) был выдан мут по подозрению в сливе", GetName(playerid), playerid);
		SendClientMessageToAll(COLOR_RED, global_string);
		fLogs("[mute] %s выдан, подозрение в сливе", GetName(playerid));

		PI[playerid][pMuted] = 10*60;
		PVC_MutePlayer(playerid);
		fraction_protection_status[playerid] = 1;
		member_message_time[playerid] = 0;
		member_message_time_2[playerid] = GetTickCount() + 60000 * 10; // таймер на 10 минут, это сбросить попытки после мута.
		return 1;
	}
	if(fraction_protection_status[playerid] && member_count_message[playerid] >= 3)
	{
		LeaveFractionPlayer(playerid);
		SendClientMessage(playerid, COLOR_RED, "Вы были выгнаны из организации по подозрению в сливе");
		global_string = "";
		format(global_string, 128, "Внимание! Товарищ %s(%d) был выгнан из организации по подозрению в сливе", GetName(playerid), playerid);
		SendClientMessageToAll(COLOR_RED, global_string);
		fLogs("[member] %s выгнан, подозрение в сливе [%i]", GetName(playerid), PI[playerid][pMember]);

		member_message_time[playerid] = 0;
		member_message_time_2[playerid] = 0;
		fraction_protection_status[playerid] = 0;
	}
	strmid(member_message[playerid], text, 0, strlen(text), 128);
	return 1;
}

