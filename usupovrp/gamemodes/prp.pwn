				return SendClientMessage(playerid, COLOR_GREY, String144);
			}

			ShowPlayerDialog(playerid, 4000+8, 1, ""cMain"Взять наркотики", ""cWH"Введите количество наркотиков:", "Принять", "Отмена");
		}
	case 7:
		{
			if(PI[playerid][pMember] == TEAM_CSKA && b_Sklad{0})
				return SendClientMessage(playerid, -1, ""cER"Доступ к складу вашей банды закрыт!");

			if(PI[playerid][pMember] == TEAM_SPARTAK && b_Sklad{1})
				return SendClientMessage(playerid, -1, ""cER"Доступ к складу вашей банды закрыт!");


			if(PI[playerid][pRank] < UseStockRang[GetSkladID(PI[playerid][pMember])])
			{
				format(String144, sizeof(String144), "Данная возможность доступна с %i ранга!", UseStockRang[GetSkladID(PI[playerid][pMember])]);

				return SendClientMessage(playerid, COLOR_GREY, String144);
			}

			ShowPlayerDialog(playerid, 4000+10, 1, ""cMain"Взять материалы", ""cWH"Введите количество материалов:", "Принять", "Отмена");
		}
	}
	return 1;
}
