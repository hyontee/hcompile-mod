}
DLG(2212, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(null(inputtext))return SendClientMessage(playerid,COLOR_GREY,"Вы ничего не ввели!");
		if(strval(inputtext) < 1 || strval(inputtext) > 1000000) return SendClientMessage(playerid, -1, ""cER"Число может быть не больше 1000000");
		new playa=g_player_listitem_use[playerid];
		new id = PlayerItem1[playa][PlayerUseList[playerid][MAX_LIST]];
		new s=PlayerUseList[playerid][MAX_LIST];
		new kolv=0;
		if(PlayerItem2[playa][s]<=strval(inputtext)){kolv=PlayerItem2[playa][s];}
		else if(PlayerItem2[playa][s]>=strval(inputtext)){kolv=strval(inputtext);}
		new newslot;
		if(CheckMaxVes(playerid,id,kolv,newslot)==1)return true;
		PlayerItem1[playerid][s]=id;
		PlayerItem2[playerid][s]=1;
		format(PlayerItem3[playerid][s],32,"%s",PlayerItem3[playa][s]);
		SaveItem(playerid,s);
		UpDateInv(playerid);
		PlayerItem2[playa][s]-=strval(inputtext);
		SaveItem(playa,s);
		UpDateInv(playa);
	}
	return 1;
}
DLG(2213, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(null(inputtext))return SendClientMessage(playerid,COLOR_GREY,"Вы ничего не ввели!");
		if(strval(inputtext) < 1 || strval(inputtext) > 1000000) return SendClientMessage(playerid, -1, ""cER"Число может быть не больше 1000000");
