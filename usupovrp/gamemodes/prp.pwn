cmd:bcn(playerid, params[])
{
	if(!IsAGang(playerid)) return SendClientMessage(playerid, COLOR_RED,"Вы не бандит!");
	if(sscanf(params,"s[100]",params[0])) return SendClientMessage(playerid, -1, ""cPS"Введите: /bcn [текст]");
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, -1, ""cPS"У вас бан чата!");
	new text[100];
	strmid(text,params[0],0,100);
	new ttext[50];

	switch(PI[playerid][pMember])
	{
	case TEAM_CSKA: ttext = "{8813E7}[ФК ЦСКА]";
	case TEAM_SPARTAK: ttext = "{01FCFF}[ФК Спартак]";
	case TEAM_HITMAN: ttext = "{DBD604}[Хитманы]";
	}
	global_string = "";
	format(global_string, 144, "{CE0F28}[ЧАТ БАНДИТОВ] %s "cWH"%s[%d]: (( %s ))", ttext, GetName(playerid), playerid, text);

	foreach(new i:Player) if(IsAGang(i)) SendClientMessage(i, 0xFFFFFFFF, global_string);
	return 1;
}
