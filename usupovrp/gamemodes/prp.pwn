SetSpawnInfo_crash(playerid, team, skin, Float:x, Float:y, Float:z, Float:rotation, weapon1, weapon1_ammo, weapon2, weapon2_ammo, weapon3, weapon3_ammo)
{
	for(new i; i < sizeof(CrashSkins); i++)
	{
		if(skin == CrashSkins[i]) SCMF(playerid, -1, "SkinSpawn %d crashed, go to 21", skin), skin = 21;
	}

	SetSpawnInfo(playerid, team, skin, Float:x, Float:y, Float:z, Float:rotation, weapon1, weapon1_ammo, weapon2, weapon2_ammo, weapon3, weapon3_ammo);

	return 1;
}

