	return 1;
}
DLG(3798, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new skin;
		if(sscanf(inputtext,"i", skin)) return ShowPlayerDialog(playerid, 3798, DIALOG_STYLE_INPUT, "{1874CD}»"cWH" Изменить скин » Всем (50m)", "FF0000}Внимание! {FFFF00}Пример: 245 | (Итог: Игрокам в радиусе 50m установелн скин 245)\n\n"cWH"Введите ID скина:", "Ввод", "Назад");
		if(skin > 299 || skin < 1) return SendClientMessage(playerid, 0xAFAFAFAA, "ID скинов от 1 до 299."), ShowPlayerDialog(playerid, 3798, DIALOG_STYLE_INPUT, "{1874CD}»"cWH" Изменить скин » Всем (50m)", "{FF0000}Внимание! {FFFF00}Пример: 245 | (Итог: Игрокам в радиусе 50m установелн скин 245)\n\n"cWH"Введите ID скина:", "Ввод", "Назад");
		new Float:PlayerPos[3];
		GetPlayerPos(playerid, PlayerPos[0], PlayerPos[1], PlayerPos[2]);
		foreach(new i:Player)
		{
			if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i) && GetPlayerInterior(playerid) == GetPlayerInterior(i))
			{
				if(PlayerToPoint(50.0, i, PlayerPos[0], PlayerPos[1], PlayerPos[2]))
				{
					SetPlayerSkin(i, skin);
					SendMes(i, 0x9ACD32AA, "Администратор %s изменил всем скин.", GetName(playerid));
				}
			}
		}
		callcmd::mp(playerid);
		fLogs("[admin] %s /mp скин %i", GetName(playerid), skin);
	}
	else callcmd::mp(playerid);
	return 1;
}
DLG(3797, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new gun;
		new patr;
		if(sscanf(inputtext,"p<,>ii", gun, patr)) return ShowPlayerDialog(playerid, 3797, DIALOG_STYLE_INPUT, "{1874CD}»"cWH" Выдать оружие игрокам", "{FF0000}Внимание! {FFFF00}Пример: 24, 200 | (Итог: Дигл и 200 патронов)\n\n"cWH"Введите ID оружия и кол-во патрон:", "Выдать", "Назад");
		if(!(1 <= gun <= 34)) return SendErr(playerid, "Запрещенное оружие");
		if(!(1 <= patr <= 500)) return SendErr(playerid, "Макс 500пт.");
		new Float:PlayerPos[3];
		GetPlayerPos(playerid, PlayerPos[0], PlayerPos[1], PlayerPos[2]);
		foreach(new i:Player)
		{
			if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i) && GetPlayerInterior(playerid) == GetPlayerInterior(i))
			{
				if(PlayerToPoint(50.0, i, PlayerPos[0], PlayerPos[1], PlayerPos[2]))
				{
					PlayerFixWeapon[playerid] = 1;
					GivePlayerWeapon(i, gun, patr);
					SendClientMessage(i, 0xFF6347AA, "Администратор выдал всем оружие.");
				}
			}
		}
		callcmd::mp(playerid);
		fLogs("[admin] %s /mp оружие %i %i", GetName(playerid), gun, patr);
	}
	else callcmd::mp(playerid);
	return 1;
}
