SetPosInShop(playerid)
{
	if(GetPlayerData(playerid, SalonCarID) == INVALID_VEHICLE_ID) return 1;

	if(g_player_salon[playerid] == 1)
	{
		SetPlayerPos(playerid, -14.2478,-5.1019,1201.0469);
		SetPlayerInterior(playerid, 21);
		LinkVehicleToInterior(GetPlayerData(playerid, SalonCarID), 21);
	}
	if(g_player_salon[playerid] == 2)
	{
		SetPlayerPos(playerid, -14.2478,-5.1019,1201.0469);
		SetPlayerInterior(playerid, 21);
		LinkVehicleToInterior(GetPlayerData(playerid, SalonCarID), 21);
	}
	SetPlayerFacingAngle(playerid, 90.0000);
	SetPlayerVirtualWorld(playerid, playerid+1001);
	TogglePlayerControllable(playerid,false);
	pPressed[playerid] = 0;
	SetVehicleVirtualWorld(GetPlayerData(playerid, SalonCarID), playerid+1001);
	PutPlayerInVehicle(playerid,GetPlayerData(playerid, SalonCarID),0);
	return 1;
}
