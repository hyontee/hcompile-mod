				);
			}
		case 4:
			{
				ShowPlayerDialog
				(
				playerid, 6367, DIALOG_STYLE_INPUT,
				""cMain"Перевод средств",
				""cWH"Введите номер счета и кол-во денег через запятую:",
				"Перевести", "Назад"
				);
			}
		case 5:
