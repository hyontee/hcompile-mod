DLG(127, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price;
	new b = GetPlayerBizz(playerid);
	if(sscanf(inputtext, "i", price))
	{
		format(string, sizeof(string), ""cWH"Введите сумму пополнения\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
		return ShowPlayerDialog(playerid, 106+21, 1, ""cMain"Пополнение счета бизнеса", string, "Принять", "Назад");
	}
	if(price < 1)
	{
		format(string, sizeof(string), ""cWH"Введите сумму пополнения\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
		return ShowPlayerDialog(playerid, 106+21, 1, ""cMain"Пополнение счета бизнеса", string, "Принять", "Назад");
	}
	new accountid = PI[playerid][pMainBankAccount];
	if(g_player_bank_accounts[playerid][accountid][B_BALANCE] < price)
	{
		SendClientMessage(playerid, COLOR_GREY, "На вашем счету в банке не хватает денег!");
		format(string, sizeof(string), ""cWH"Введите сумму пополнения\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
		return ShowPlayerDialog(playerid, 106+21, 1, ""cMain"Пополнение счета бизнеса", string, "Принять", "Назад");
	}
	g_player_bank_accounts[playerid][accountid][B_BALANCE] -= price;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
	mysql_tquery(db_prod, STRING_GLOBAL);

	format(stringer1, sizeof stringer1, "- Пополнение счета бизнеса %d рублей", price);
	SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
	UpdateBankMoneyText(playerid, accountid);

	BizzInfo[b][bMoney] += price;
	MysqlUpdateBizzInt(b, "money", BizzInfo[b][bMoney]);
	SendMes(playerid, TEAM_BLUE_COLOR, "Вы положили на счет бизнеса: %dр. На счете бизнеса: %dр", price, BizzInfo[b][bMoney]);
	return 1;
}
DLG(5207, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new accountid = g_player_listitem_use[playerid];
	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");

	new h = GetPlayerBizz(playerid);
	new dayss = strval(inputtext), g_rent = 2000 * dayss;
	if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < g_rent) return SendClientMessage(playerid, COLOR_RED, "У Вас не хватает средств для оплаты аренды бизнеса");
	if(dayss < 1 || dayss > 7) return SendClientMessage(playerid, COLOR_RED, "Количество дней от 1 до 7");
	if((BizzInfo[h][bOplata] + dayss) > 7) return SendClientMessage(playerid, COLOR_RED, "Нельзя оплатить более чем на 7 дней");
	SCMF(playerid, COLOR_GREEN, "Вы оплатили бизнес на %d дней. С Вашего счета списано: %d рублей", dayss, g_rent);

	SetPlayerMoney(playerid, -g_rent);
	BizzInfo[h][bOplata] += dayss;
	MysqlUpdateBizzInt(h, "oplata", BizzInfo[h][bOplata]);
	return 1;
}
DLG(320, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new b = GetPlayerBizz(playerid);
	global_string = "";
	switch(listitem)
	{
	case 0:
		{
			if(GetPlayerBizz(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вы не владеете бизнесом!");
			format(global_string, 100, ""cWH"Введите сумму пополнения\nТекущий счет бизнеса: %dр", BizzInfo[GetPlayerBizz(playerid)][bMoney]);
			ShowPlayerDialog(playerid, 106+21, 1, ""cMain"Пополнение счета бизнеса", global_string, "Принять", "Назад");
		}
	case 1:
		{
			if(GetPlayerBizz(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вы не владеете бизнесом!");
			format(string, sizeof(string), ""cWH"Введите сумму вывода денег с бизнеса\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
			ShowPlayerDialog(playerid, 106+213, 1, ""cMain"Вывод счета с бизнеса", string, "Принять", "Назад");
		}
	}
	return 1;
}
DLG(319, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price;
	new b = GetPlayerBizz(playerid);
	if(sscanf(inputtext, "i", price))
	{
		format(string, sizeof(string), ""cWH"Введите сумму вывода денег с бизнеса\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
		return ShowPlayerDialog(playerid, 106+213, 1, ""cMain"Вывод счета с бизнеса", string, "Принять", "Назад");
	}
	if(price < 1)
	{
		format(string, sizeof(string), ""cWH"Введите сумму вывода денег с бизнеса\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
		return ShowPlayerDialog(playerid, 106+213, 1, ""cMain"Вывод счета с бизнеса", string, "Принять", "Назад");
	}
	if(BizzInfo[b][bMoney] < price)
	{
		SendClientMessage(playerid, COLOR_GREY, "На вашем счету в бизнесе не хватает денег!");
		format(string, sizeof(string), ""cWH"Введите сумму вывода денег с бизнеса\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
		return ShowPlayerDialog(playerid, 106+213, 1, ""cMain"Вывод счета с бизнеса", string, "Принять", "Назад");
	}
	if(GetPlayerLimitMoney(playerid, price))
	{
		SendErr(playerid, "У Вас максимальное количество денег.");
		return 1;
	}
	BizzInfo[b][bMoney] -= price;

	SetPlayerMoney(playerid, price);
	MysqlUpdateBizzInt(b, "money", BizzInfo[b][bMoney]);
	SendMes(playerid, TEAM_BLUE_COLOR, "Вы вывели со счета бизнеса: %dр. На счете бизнеса: %dр", price, BizzInfo[b][bMoney]);
	return 1;
}
DLG(63, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price;
	if(sscanf(inputtext, "i", price))
	{
		format(string, sizeof(string), ""cWH"Введите сумму пополнения\n\nКомиссия за операцию: {1D99D4}0%%\n\n"cWH"Текущее состояние счёта: {63BD4E}%dр", PI[playerid][pPhoneBalance]);
		return ShowPlayerDialog(playerid, 62+1, 1, ""cMain"Пополнение счета телефона", string, "Принять", "Назад");
	}
	if(price < 1)
	{
		format(string, sizeof(string), ""cWH"Введите сумму пополнения\n\nКомиссия за операцию: {1D99D4}0%%\n\n"cWH"Текущее состояние счёта: {63BD4E}%dр", PI[playerid][pPhoneBalance]);
		return ShowPlayerDialog(playerid, 62+1, 1, ""cMain"Пополнение счета телефона", string, "Принять", "Назад");
	}
	if(GetPlayerRubble(playerid) < price)
	{
		SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
		format(string, sizeof(string), ""cWH"Введите сумму пополнения\n\nКомиссия за операцию: {1D99D4}0%%\n\n"cWH"Текущее состояние счёта: {63BD4E}%dр", PI[playerid][pPhoneBalance]);
		return ShowPlayerDialog(playerid, 62+1, 1, ""cMain"Пополнение счета телефона", string, "Принять", "Назад");
	}
	if(PI[playerid][pPhoneBalance] + price > 15000) return SendClientMessage(playerid, COLOR_GREY, "Нельзя положить на баланс телефона более 15000р");
	PI[playerid][pPhoneBalance] += price;

	SetPlayerMoney(playerid, -price);
	SendMes(playerid, COLOR_YELLOW, "SMS: "cWH"Поступление платежа: %dр. Текущее состояние счёта: %dр. {FFFF00}Отправитель: "cWH"Оператор связи", price, PI[playerid][pPhoneBalance]);
	return 1;
}
DLG(66, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price;
	if(sscanf(inputtext, "i", price) || !(1 <= price <= 10000000))
	{
		format(string, sizeof(string), ""cWH"Введите количество денег, которые хотите пожертвовать на благотворительность\n\nВы пожертвовали: {63BD4E}%dр", PI[playerid][pCharity]);
		return ShowPlayerDialog(playerid, 62+4, 1, ""cMain"Благотворительность", string, "Принять", "Назад");
	}
	if(GetPlayerRubble(playerid) < price)
	{
		SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
		format(string, sizeof(string), ""cWH"Введите количество денег, которые хотите пожертвовать на благотворительность\n\nВы пожертвовали: {63BD4E}%dр", PI[playerid][pCharity]);
		return ShowPlayerDialog(playerid, 62+4, 1, ""cMain"Благотворительность", string, "Принять", "Назад");
	}
	if((FracBank[9] + price) > 2000000000)
	{
		SendErr(playerid, "В казне слишком много денег");
		ShowPlayerBankAccountCharity(playerid);
		return 1;
	}
	PI[playerid][pCharity] += price;
	if(PI[playerid][pCharity] > 2000000000) PI[playerid][pCharity] = 2000000000;
	MysqlUpdatePlayerInt(playerid, "charity", PI[playerid][pCharity]);

	SetPlayerMoney(playerid, -price);
	SetMeriaCash(price);
	SendMes(playerid, COLOR_YELLOW, "Вы пожертвовали на благотворительность "cWH"%dр{FFFF00}. Список самых щедрых: "cWH"/charity", price);
	return 1;
}
DLG(132, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new idx = PlayerBizzSelect[playerid];
	if(GetPlayerRubble(playerid) < BizzInfo[idx][bEnter]) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств для входа!");
	SetPlayerMoney(playerid, BizzInfo[idx][bEnter]);
	BizzInfo[idx][bMoney] += BizzInfo[idx][bEnter];
	BizzPay[idx] += BizzInfo[idx][bEnter];
	MysqlUpdateBizzInt(idx, "money", BizzInfo[idx][bMoney]);

	PI[playerid][pInBiz] = idx;

	SetPlayerPos(playerid,BizzInfo[idx][bExitx], BizzInfo[idx][bExity], BizzInfo[idx][bExitz]);
	SetPlayerInterior(playerid,BizzInfo[idx][bInt]);
	SetPlayerVirtualWorld(playerid,BizzInfo[idx][bVirtual]);
	SetCameraBehindPlayer(playerid);
	return 1;
}
DLG(6000, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	format(stringer1, sizeof(stringer1), "[Внимание] %s покинул организацию по собственному желанию (/leave)", GetName(playerid));
	SendFMes(PI[playerid][pMember], COLOR_YELLOW, stringer1);
	LeaveFractionPlayer(playerid);
	return 1;
}
DLG(5000, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!isNumeric(inputtext) || strlen(inputtext) != 6 || inputtext[0] == '0'|| inputtext[0] == '+'|| inputtext[0] == '-' || IsTextInvalid(inputtext))
	{
		SendClientMessage(playerid, COLOR_GREY, "Номер должен состоять из 6 цифр. Первая цифра не должны быть \"ноль\"");
		ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_INPUT, ""cMain"Покупка SIM-карты", ""cWH"Введите новый шестизначный номер", "Купить", "Закрыть");
		return 1;
	}
	new number = strval(inputtext);
	foreach(new i: Player)
	{
		if(PI[i][pPhoneNumber] == number) SendClientMessage(playerid, COLOR_GREY, "Такой номер уже используется");
		break;
	}
	format(stringer1, sizeof(stringer1), "SELECT `id` FROM `accounts` WHERE phonenumber = '%d'", strval(inputtext));
	mysql_tquery(db_prod, stringer1, "OnPlayerSetPhoneNumber", "ii", playerid, number);
	return 1;
}
DLG(3800, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
			if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"У вас изъяли телефон!");
			if(Mobile[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "Вы уже разговариваете по телефону!");
			if(Phone[playerid] == false) return SendClientMessage(playerid, -1, ""cER"У вас выключен телефон!");
			if(Ether[playerid] == true) return SendClientMessage(playerid, -1, ""cER"Действие невозможно!");
			ShowPlayerDialog(playerid, 3800+2, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад");
		}
	case 1:
		{
			if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
			if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"У вас изъяли телефон!");
			if(Phone[playerid] == false) return SendClientMessage(playerid, -1, ""cER"У вас выключен телефон!");
			ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"Номер телефона", ""cWH"Введите номер телефона абонента:", "Принять", "Назад");
		}
	case 2:
		{
			if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"У вас изъяли телефон!");
			ShowPlayerDialog(playerid, 106+3, 2, ""cMain"Сервисы", "1. Вызвать полицию", "Принять", "Назад");
		}
	}
	return 1;
}
