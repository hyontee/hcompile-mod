new crash_cars_list[] =
{
	412,
	469,
	427,
	503,
	522,
	558,
	562,
	589
};

new_AddStaticVehicleEx(modelid, Float:spawn_x, Float:spawn_y, Float:spawn_z, Float:z_angle, color1, color2, respawn_delay = 1800)
{
	for(new i = 0; i != sizeof crash_cars_list; i ++)
	{
		if(modelid == crash_cars_list[i]) return INVALID_VEHICLE_ID;
	}

	if(!strcmp(VehicleNames[modelid - 400], "СКОРО БУДЕТ", true))
	{
		return INVALID_VEHICLE_ID;
	}

	new vehid = AddStaticVehicleEx(modelid, spawn_x, spawn_y, spawn_z, z_angle, color1, color2, respawn_delay);
	if(vehid == INVALID_VEHICLE_ID) return INVALID_VEHICLE_ID;
	NullVehicle(vehid);
	return vehid;
}
#if defined _ALS_AddStaticVehicleEx
#undef AddStaticVehicleEx
#else
#define	_ALS_AddStaticVehicleEx
#endif
#define AddStaticVehicleEx new_AddStaticVehicleEx

new_CreateVehicle(modelid, Float:spawn_x, Float:spawn_y, Float:spawn_z, Float:z_angle, color1, color2, respawn_delay = 1800, siren = 0)
{
	if(!GetString(SERVER_INFO, "Test"))
	{
		for(new i = 0; i != sizeof crash_cars_list; i ++)
		{
			if(modelid == crash_cars_list[i]) return INVALID_VEHICLE_ID;
		}

		if(!strcmp(VehicleNames[modelid - 400], "СКОРО БУДЕТ", true))
		{
			return INVALID_VEHICLE_ID;
		}
	}

	new vehid = CreateVehicle(modelid, spawn_x, spawn_y, spawn_z, z_angle, color1, color2, respawn_delay, siren);
	if(vehid == INVALID_VEHICLE_ID) return INVALID_VEHICLE_ID;
	NullVehicle(vehid);

	SetVehicleTuning(vehid, VT_LIGHTS_COLOR_R, 100);
	SetVehicleTuning(vehid, VT_LIGHTS_COLOR_G, 100);
	SetVehicleTuning(vehid, VT_LIGHTS_COLOR_B, 100);

	SetVehicleTuning(vehid, VT_NEON_COLOR_R, 0);
	SetVehicleTuning(vehid, VT_NEON_COLOR_G, 0);
	SetVehicleTuning(vehid, VT_NEON_COLOR_B, 0);

	SetVehicleTuning(vehid, VT_MAIN_COLOR_R, 255);
	SetVehicleTuning(vehid, VT_MAIN_COLOR_G, 255);
	SetVehicleTuning(vehid, VT_MAIN_COLOR_B, 255);

	SetVehicleTuning(vehid, VT_TINING_TRANSPARENT, 130);

	SetVehicleTuning(vehid, VT_TINING_COLOR_R, 0);
	SetVehicleTuning(vehid, VT_TINING_COLOR_G, 0);
	SetVehicleTuning(vehid, VT_TINING_COLOR_B, 0);

	SetVehicleTuning(vehid, VT_TURN_LIGHTS_LEFT, 0);
	SetVehicleTuning(vehid, VT_TURN_LIGHTS_RIGHT, 0);
	SetVehicleTuning(vehid, VT_TURN_LIGHTS_TWOSIDE, 0);

	SetVehicleTuningTemp(vehid, VT_LIGHTS_COLOR_R, 100);
	SetVehicleTuningTemp(vehid, VT_LIGHTS_COLOR_G, 100);
	SetVehicleTuningTemp(vehid, VT_LIGHTS_COLOR_B, 100);

	SetVehicleTuningTemp(vehid, VT_NEON_COLOR_R, 0);
	SetVehicleTuningTemp(vehid, VT_NEON_COLOR_G, 0);
	SetVehicleTuningTemp(vehid, VT_NEON_COLOR_B, 0);

	SetVehicleTuningTemp(vehid, VT_MAIN_COLOR_R, 255);
	SetVehicleTuningTemp(vehid, VT_MAIN_COLOR_G, 255);
	SetVehicleTuningTemp(vehid, VT_MAIN_COLOR_B, 255);

	SetVehicleTuningTemp(vehid, VT_TINING_TRANSPARENT, 100);

	SetVehicleTuningTemp(vehid, VT_TINING_COLOR_R, 0);
	SetVehicleTuningTemp(vehid, VT_TINING_COLOR_G, 0);
	SetVehicleTuningTemp(vehid, VT_TINING_COLOR_B, 0);

	SetVehicleTuningTemp(vehid, VT_TURN_LIGHTS_LEFT, 0);
	SetVehicleTuningTemp(vehid, VT_TURN_LIGHTS_RIGHT, 0);
	SetVehicleTuningTemp(vehid, VT_TURN_LIGHTS_TWOSIDE, 0);

	return vehid;
}
