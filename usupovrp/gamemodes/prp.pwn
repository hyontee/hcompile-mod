DLG(9397, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0: ShowPlayerDialog(playerid, 9395, DIALOG_STYLE_LIST, "Покупка Админ-Прав","{FF7300}Выберите уровень:\n1 уровень - 100 "SERVER_COINS"\n2 уровень - 200 "SERVER_COINS"\n3 уровень - 300 "SERVER_COINS"\n4 уровень - 400 "SERVER_COINS"\n5 уровень - 500 "SERVER_COINS"\n6 уровень - 600 "SERVER_COINS"\n7 уровень - 700 "SERVER_COINS"\n8 уровень - 800 "SERVER_COINS"\n9 уровень - 1200 "SERVER_COINS"\n10 уровень - 2400 "SERVER_COINS"\n11 уровень - 3500 "SERVER_COINS"", "Купить","Выход");
	case 1: AdminLevel(playerid);
	case 2:
		{
			if(PI[playerid][pPerfectCoins] < 100)
			return SendClientMessage(playerid, -1, "У Вас недостаточно "SERVER_COINS".");

			if(!PI[playerid][pAdmin])
			return SendClientMessage(playerid, COLOR_RED, "Вы не администратор");

			if(!AdminInfo[playerid][admWarns])
			return SendClientMessage(playerid, COLOR_RED, "У Вас нет выговоров");

			SendClientMessage(playerid, COLOR_GREEN, "Вы сняли все выговоры");

			PI[playerid][pPerfectCoins] -= 100;
			AdminInfo[playerid][admWarns] = 0;
			MysqlUpdatePlayerInt(playerid, "credits", PI[playerid][pPerfectCoins]);

			global_string = "";
			format(global_string, 128, "UPDATE `admin` SET awarn='0' WHERE name='%s' LIMIT 1", GetName(playerid));
			mysql_tquery(db_prod, global_string, "", "");
			fLogs("[coin] %s -100 админ выговоры", GetName(playerid));
		}
	}
	return 1;
}
DLG(9395, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!listitem) return ShowPlayerDialog(playerid, 9395, DIALOG_STYLE_LIST, "Покупка Админ-Прав","{FF7300}Выберите уровень:\n1 уровень - 100 "SERVER_COINS"\n2 уровень - 200 "SERVER_COINS"\n3 уровень - 300 "SERVER_COINS"\n4 уровень - 400 "SERVER_COINS"\n5 уровень - 500 "SERVER_COINS"\n6 уровень - 600 "SERVER_COINS"\n7 уровень - 700 "SERVER_COINS"\n8 уровень - 800 "SERVER_COINS"\n9 уровень - 1200 "SERVER_COINS"\n10 уровень - 2400 "SERVER_COINS"\n11 уровень - 3500 "SERVER_COINS"", "Купить","Выход");
	ShowPlayerDialog(playerid, 9396, DIALOG_STYLE_INPUT, ""cMain"Введите ваш ВК", "Введите ваш ВК, он нужен нам для добавления вас в беседу администраторов.\n Пример: vk.com/id264153643", "Ввел", "Отмена");
	BuyAdmLVL[playerid] = listitem;
	return 1;
}
DLG(9396, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	switch(BuyAdmLVL[playerid])
	{
	case 1..8: AddAdmin(playerid, BuyAdmLVL[playerid]*100, BuyAdmLVL[playerid], inputtext);
	case 9: AddAdmin(playerid, 1200, BuyAdmLVL[playerid], inputtext);
	case 10: AddAdmin(playerid, 2400, BuyAdmLVL[playerid], inputtext);
	case 11: AddAdmin(playerid, 3500, BuyAdmLVL[playerid], inputtext);
	default: SCM(playerid, -1, "Повторите попытку, в случае неудачи сообщите разработчикам"), BuyAdmLVL[playerid] = 0;
	}
	return 1;
}
DLG(201, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::donate(playerid);
	return 1;
}
DLG(202, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::donate(playerid);
	if(strval(inputtext) < 1 || strval(inputtext) > 5000) return SendClientMessage(playerid, COLOR_GREY, "Количество от 1 до 5000 "SERVER_COINS"!");
	if(PI[playerid][pPerfectCoins] < strval(inputtext)) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");

	if(GetPlayerLimitMoney(playerid, strval(inputtext)*50000))
	{
		SendErr(playerid, "У Вас максимальное количество денег.");
		return 1;
	}
	MysqlUpdatePlayerInt(playerid,"credits",PI[playerid][pPerfectCoins]-strval(inputtext));
	PI[playerid][pPerfectCoins] -= strval(inputtext);

	format(string, sizeof(string), "Вы получили "cWH"%dр{ffff00} за "cWH"%d{ffff00} "SERVER_COINS"!", strval(inputtext)*50000, strval(inputtext));
	SendClientMessage(playerid, COLOR_YELLOW, string);
	format(string, sizeof(string), "+%dр", strval(inputtext)*50000);
	GameTextForPlayer(playerid, string, 3000, 1);

	if(donate_bonus)
	{
		new donate_money = 0;
		new donate_convert = strval(inputtext) * 50000;

		switch(strval(inputtext))
		{
			case 0..99: donate_money = 0;
			case 100..499: donate_money = 2;
			case 500..999: donate_money = 5;
			case 1000..5000: donate_money = 10;
			default: donate_money = 15;
		}

		new total_money = ((donate_convert / 100) * donate_money);
		if(donate_money > 0)
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Ваш бонус за конвертацию игровой валюты составил %d рублей", total_money);
			SendClientMessage(playerid, 0xFFFF00FF, STRING_GLOBAL);

			SetPlayerMoney(playerid, total_money);
		}
	}
	SetPlayerMoney(playerid, strval(inputtext)*50000);
	fLogs("[coin] %s -%i обмен на рубли %i", GetName(playerid), strval(inputtext), strval(inputtext)*50000);
	return 1;
}

