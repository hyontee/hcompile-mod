DLG(134, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::business(playerid);
	new idx = GetPlayerBizz(playerid);
	new prod = orderprod[playerid];
	new price = prod;

	SetPlayerMoney(playerid, -price);
	BizzInfo[idx][bProduct] += prod;
	MysqlUpdateBizzInt(idx, "product", BizzInfo[idx][bProduct]);
	SendClientMessage(playerid, COLOR_GREEN, "Товар был доставлен в ваш бизнес");
	return 1;
}
DLG(117, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price, i = GetPlayerBizz(playerid);
	if(sscanf(inputtext, "i", price)) return ShowPlayerDialog(playerid, 106+11, 1, ""cMain"Цена", ""cWH"Введите цену за товар:", "Принять", "Отмена");
	if(BizzInfo[i][bType] == 2)
	{
		if(price < 50 || price > 200) return SendClientMessage(playerid, COLOR_GREY, "Неверная цена. Возможно от 50 до 200р");
	}
	else if(BizzInfo[i][bType] == 3)
	{
		if(price < 100 || price > 100000) return SendClientMessage(playerid, COLOR_GREY, "Неверная цена. Возможно от 100 до 100000р");
	}
	else
	{
		if(price < 1 || price > 500) return SendClientMessage(playerid, COLOR_GREY, "Неверная цена. Возможно от 1 до 500р");
	}
	BizzInfo[i][bTill] = price;
	MysqlUpdateBizzInt(i, "till", price);
	SendClientMessage(playerid, COLOR_BLUE, "Новая цена товара установлена");
	UpdateBizz(i);
	return 1;
}
DLG(118, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price, i = GetPlayerBizz(playerid);
	if(sscanf(inputtext, "i", price)) return ShowPlayerDialog(playerid, 106+12, 1, ""cMain"Цена", ""cWH"Введите цену за вход:", "Принять", "Отмена");
	if(price < 0 || price > 1000) return SendClientMessage(playerid, COLOR_GREY, "Неверная цена. Возможно от 0 до 1000р");
	BizzInfo[i][bEnter] = price;
	MysqlUpdateBizzInt(i, "penter", price);
	SendClientMessage(playerid, -1, ""cDA"Цена за вход успешно установлена");
	UpdateBizz(i);
	return 1;
}
