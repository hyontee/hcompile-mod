GetGangFlashZone(fractionid) return
(fractionid == TEAM_SPARTAK) ? (0xCC00FFAA) :
(fractionid == TEAM_HITMAN) ? (0xffa500AA) :
(fractionid == TEAM_CSKA) ? (0x009900AA) :  (0xFFFFFF65);

GetGangZoneColor(zone_id)
{
	return
	(GZInfo[zone_id][gFrak] == TEAM_SPARTAK) ? (0xCC00FFAA) :
	(GZInfo[zone_id][gFrak] == TEAM_HITMAN) ? (0xffa500AA) :
	(GZInfo[zone_id][gFrak] == TEAM_CSKA) ? (0x009900AA) :  (0xFFFFFF65);
}

IsPlayerToSquare(playerid,Float:min_x,Float:min_y,Float:max_x,Float:max_y)
{
	new Float:xxp,Float:yyp,Float:zzp;
	GetPlayerPos(playerid, xxp, yyp, zzp);
	if((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return 1;
	return 0;
}
LeaveFractionPlayer(playerid)
{
	if(IsAGang(playerid))
	{
		for(new i; i < 20; i++) TextDrawHideForPlayer(playerid, capture_td[i]);
	}

	PI[playerid][pScoreIvent] =
	PI[playerid][pMainSub] =
	PI[playerid][pMemberSkin] =
	PI[playerid][pMember] =
	PI[playerid][pRank] =
	PI[playerid][pLeader] =
	PI[playerid][pLWarn] =
	PI[playerid][pTWarn] = 0;

	format(global_string, sizeof(global_string), "UPDATE `accounts` SET twarn=0, lwarn=0, memberskin=0, leader=0, member=0, rank=0, mainsub=0, scoreivent=0, sub_invited=0, sub_uninvited=0, sub_twarns=0 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, global_string);
	ResetPlayerWeapons(playerid);
	SetPlayerSkin(playerid,PI[playerid][pModel]);
	SetPlayerColorEx(playerid,TeamColors[0]);
	return 1;
}
NewsPanel(playerid)
{
	format(string, sizeof(string), "%s\n"cWH"- Пригласить в эфир\n"cWH"- Выпроводить из эфира\n%s\n%s\n{FFFF00}- Объявления [Новых %d]",
	!Ether[playerid] ? ("{63BD4E}- Войти в эфир") : ("{F04245}- Выйти из эфира"),
	!EtherCall ? ("{63BD4E}- Включить прием звонков в эфир") : ("{F04245}- Выключить прием звонков в эфир"),
	!EtherSms ? ("{63BD4E}- Включить прием смс в эфир") : ("{F04245}- Выключить прием смс в эфир"),
	TOTALADVERT);
	ShowPlayerDialog(playerid, 77, 2, "{3399FF}СМИ "cWH"(т. 555)",string, "Принять", "Отмена");
	return 1;
}
MobileCrash(playerid)
{
	new id = Mobile[playerid];
	SendClientMessage(id, COLOR_GRAD2, "Абонент положил трубку");
	SetPlayerSpecialAction(id, SPECIAL_ACTION_STOPUSECELLPHONE);
	CellTime[id] = CellTime[playerid] = Mobile[id] = -1;
	if(EtherCalled[playerid] == true) EtherCalled[playerid] = false;
	if(EtherCalled[id] == true) EtherCalled[id] = false;
	Mobile[playerid] = -1;
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
	CallTime[playerid] =
	CallTime[id] = 0;
	return 1;
}
stock OnServerClearPlayerBizz(bizzid)
{
	new targetid = GetPlayerPID(BizzInfo[bizzid][bOwner]);
	if(targetid != 0xFFFF && PlayerLogged[targetid])
	{
		SetPlayerMoney(targetid, BizzInfo[bizzid][bBuyPrice]);
		SetPlayerMoney(targetid, BizzInfo[bizzid][bMoney]);

		PI[targetid][pBiz] = -1;
		MysqlUpdatePlayerInt(targetid, "business", PI[targetid][pBiz]);

		SendClientMessage(targetid, COLOR_YELLOW,"[Налоговая служба] Ваш бизнес закрыли в связи с нехваткой ресурсов");
		SendClientMessage(targetid, COLOR_YELLOW,"[Налоговая служба] Половина стоимости бизнеса и его бюджет зачислены на ваш банковский счет");
	}
	else
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `cash`, `text` FROM `accounts` WHERE `name` = '%s'", BizzInfo[bizzid][bOwner]);
		mysql_tquery(db_prod, STRING_GLOBAL, "OnServerClearOffPlayerBizz", "is", bizzid, BizzInfo[bizzid][bOwner]);
	}
	BizzPay[bizzid] = BizzInfo[bizzid][bOplata] = BizzInfo[bizzid][bLock] = BizzInfo[bizzid][bLockTime] = BizzInfo[bizzid][bMafia] = BizzInfo[bizzid][bBuyPrice] = BizzInfo[bizzid][bMoney] = BizzInfo[bizzid][bEnter] = 0;
	BizzInfo[bizzid][bTill] = 50;
	BizzInfo[bizzid][bOwned] = -1;

	BizzInfo[bizzid][bProduct] = OverallBizz[BizzInfo[bizzid][bType]];
	strmid(BizzInfo[bizzid][bOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bizz` SET `owner` = 'None', `owned` = '-1', `block` = '%d', `locktime` = '%d', `money` = '%d', `penter` = '%d', `till` = '%d', `buyprice` = '%d', `product` = '%d', `mafia` = '%d', `oplata` = '%d' WHERE `id` = '%d' LIMIT 1", BizzInfo[bizzid][bLock], BizzInfo[bizzid][bLockTime], BizzInfo[bizzid][bMoney], BizzInfo[bizzid][bEnter], BizzInfo[bizzid][bTill], BizzInfo[bizzid][bBuyPrice], BizzInfo[bizzid][bProduct], BizzInfo[bizzid][bMafia], BizzInfo[bizzid][bOplata], bizzid);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	UpdateBizz(bizzid);
	return 0x1;
}

GetHomeOplata(idx)
{
	new htax;
	switch(HouseInfo[idx][hDiscript])
	{
	case 1: htax = 50000;
	case 2: htax = 100000;
	case 3: htax = 150000;
	case 4: htax = 250000;
	}
	return htax;
}
GetRoomOplata(idx)
{
	new htax;
	switch(RoomsInfo[idx][rType])
	{
	case 1: htax = 25000;
	case 2: htax = 50000;
	case 3: htax = 100000;
	}
	return htax;
}

callback::OnServerClearOffPlayerBizz(bizzid, NamePlayer[])
{
	new rows;
	new string_fix;
	cache_get_data(string_fix, rows);

	if(string_fix != 0x0)
	{
		new Text[4];
		new TextFix[16];
		cache_get_field_content(0, "text", TextFix, db_prod, 16);

		sscanf(TextFix, "p<,>a<i>[4]", Text);
		format(TextFix, sizeof(TextFix), "%d, %d, %d, %d", Text[0], bizzid, Text[2], Text[3]);

		new ReasonMoney;
		ReasonMoney += BizzInfo[bizzid][bBuyPrice];
		ReasonMoney += BizzInfo[bizzid][bMoney];

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `cash` = `cash`+'%d', `text` = '%s', `spawnchange` = '0', `room` = '-1' WHERE `name` = '%s' LIMIT 1", TextFix, ReasonMoney, NamePlayer);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	}
	return 0x1;
}
callback::OnServerClearPlayerRoom(kvartid, NamePlayer[])
{
	new rows;
	new string_fix;
	cache_get_data(string_fix, rows);

	if(string_fix != 0x0)
	{
		new Text[4];
		new TextFix[16];
		cache_get_field_content(0, "text", TextFix, db_prod, 16);

		sscanf(TextFix, "p<,>a<i>[4]", Text);
		format(TextFix, sizeof(TextFix), "%d, %d, %d, %d", Text[0], Text[1], kvartid, Text[3]);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `text` = '%s', `spawnchange` = '0', `room` = '-1' WHERE `name` = '%s' LIMIT 1", TextFix, NamePlayer);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	}
	return 0x1;
}

callback::OnServerClearPlayerHouse(houseid, PlayerID)
{
	new rows;
	new string_fix;
	cache_get_data(string_fix, rows);

	if(string_fix != 0x0)
	{
		new Text[4];
		new TextFix[16];
		cache_get_field_content(0, "text", TextFix, db_prod, 16);

		sscanf(TextFix, "p<,>a<i>[4]", Text);
		format(TextFix, sizeof(TextFix), "%d, %d, %d, %d", houseid, Text[1], Text[2], Text[3]);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `text` = '%s', `spawnchange` = '0', `house` = '-1' WHERE `id` = '%d' LIMIT 1", TextFix, PlayerID);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	}
	return 0x1;
}

GunShopList(playerid)
{
	if(GetPlayerInBiz(playerid) == -1) return SendErr(playerid, "Нужно находиться в бизнесе");
	if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 5) return SendClientMessage(playerid,COLOR_GREY,"Покупать оружие можно только отыграв 5 часов (5 EXP)");
	string = "";

	for(new i; i < GUN_OBJECTS; i++)
	{
		new price_weapon = GetReasonMoneyPercentVip(playerid, TYPE_VIP_WEAPON, gGunCosts[i]);
		format(string, sizeof(string), "%s"cWH"%s\t{63BD4E}%dр\n", string, gGunNames[i], price_weapon);
	}
	ShowPlayerDialog(playerid, 1374, DIALOG_STYLE_LIST, ""cMain"Магазин оружия", string, "Купить", "Отмена");
	return 1;
}
SkinShopList(playerid)
{
	if(PI[playerid][pMember])
		return SendClientMessage(playerid, COLOR_RED, "Вы состоите в организации");

	ClothesRound[playerid] = 2;
	InShopSkin[playerid] = GetPlayerVirtualWorld(playerid);
	SpawnPlayer(playerid);
	return 1;
}
AccessoriesShowList(playerid)
{
	ShowPlayerDialog
	(
	playerid, 5312, DIALOG_STYLE_LIST,
