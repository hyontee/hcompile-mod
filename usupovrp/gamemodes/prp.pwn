GetVehicleFullTuneModel(vehicleid)
{
	switch(GetVehicleModel(vehicleid))
	{
		case 559, 560, 562: return 0x1;
		default: return 0x0;
	}
	return 0x0;
}


stock OnServerUpdateDrawData()
{
	format(stringer1, sizeof(stringer1), "%02d:%02d", hour, minute);
	TextDrawSetString(server_info_td[5], stringer1);

	format(stringer1, sizeof(stringer1), "%02d.%02d.%04d", day, month, year);
	TextDrawSetString(server_info_td[3], stringer1);

	format(stringer1, sizeof(stringer1), "%02d:%02d", hour, minute);
	TextDrawSetString(PhoneSA[35], stringer1);

	format(stringer1, sizeof(stringer1), "%02d/%02d/%04d", day, month, year);
	TextDrawSetString(PhoneSA[41], stringer1);
	return 0x1;
}

stock OnServerUpdateData()
{
	if(gPayTime != hour)
	{
		gPayTime = hour;
		PayDay();
		switch(hour)
		{
			case 0:
			{
				if(++day_weeks >= 7) day_weeks -= 7;

				foreach(new playerid : Player)
				{
					if(PlayerLogged[playerid])
					{
						g_player_online[playerid][day_weeks] = 0;

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE accounts SET `day` = '%d' WHERE `id` = '%d'", day, PI[playerid][pID]);
						mysql_tquery(db_prod, STRING_GLOBAL);

						STRING_GLOBAL[0] = EOS;
						mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE accounts_online SET online_monday=%d,online_tuesday=%d,online_wednesday=%d,online_thursday=%d,online_friday=%d,online_saturday=%d,online_sunday=%d WHERE id=%d", g_player_online[playerid][2],g_player_online[playerid][3],g_player_online[playerid][4],g_player_online[playerid][5],g_player_online[playerid][6],g_player_online[playerid][0],g_player_online[playerid][1],PI[playerid][pID]);
						mysql_tquery(db_prod, STRING_GLOBAL);
					}
				}
				CheckServerProperty();
				SendClientMessageToAll(COLOR_ORANGE, "[Недвижимость] Все неоплаченные дома/бизнесы/квартиры/гаражи были проданы государству.");
			}
			case 12..14:
			{
				if(!gDerbyStatus)
				{
					foreach(new ids: Player) playerGameDerby{ids} = 0;

					gDerbyStatus = 1;
					gDerbyTimer = 600;

					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открылась регистрация на мероприятие 'Дерби'");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Максимальное количество людей для регистрации 10 чел");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 10 минут");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 10");
				}
			}
			case 15, 17:
			{
				if(!gSkyDivingStatus)
				{
					foreach(new ids: Player) playerGameSkyDiving{ids} = 0, playerSkyDivingCount[ids] = 0;

					gSkyDivingStatus = 1;
					gSkyDivingTimer = 600;

					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открылась регистрация на мероприятие 'Прыжки с парашюта'");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Максимальное количество людей для регистрации 50 чел");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 10 минут");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 11");
				}
			}
			case 16, 18:
			{
				if(!g_pubg_status)
				{
					g_pubg_status = 1;
					g_pubg_timer = 600;

					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открылась регистрация на мероприятие 'Battle Royale'");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Максимальное количество людей для регистрации 100 чел");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 10 минут");
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 7");
				}
			}
			case 6..11, 19..22:
			{
				if(!fights_status)
				{
					fights_status = true;
					fights_status_s = true;
					fights_timer = 300;
					SendClientMessageToAll(COLOR_YELLOW, "Внимание! В бойцовском клубе открыта регистрация на поединок. Начало через 5 минут!");
				}
			}
			case 5:
			{
				//SendClientMessageToAll(COLOR_RED, "Через две минуты произойдет автоматическая перезагрузка сервера.");
				//SendClientMessageToAll(COLOR_RED, "Закончите пожалуйста все свои работы! Вы будете отключены с сервера.");
				//SetTimer("RestartServer", 120000, 0);
			}
		}
	}
	return 0x1;
}

stock OnServerUpdatePlayerTimer()
{
	foreach(new playerid : Player)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(PI[playerid][pAFK] <= 3 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetVehicleModel(vehicleid) >= 400)
		{
			new speed = GetVehSpeed(vehicleid);
			if(playerRadarIgnore[playerid] <= gettime())
			{
				nfor(i, (TOTALRADAR + 1))
				{
					if(!gRadarSpeed[i]) continue;
					if(speed >= gRadarSpeed[i]) if(IsPlayerInRangeOfPoint(playerid, 20.0, gRadarPos[i][0],gRadarPos[i][1],gRadarPos[i][2]))
					{
						playerRadarIgnore[playerid] = gettime() + 15;
						SetPlayerMoney(playerid, -gRadarPrice[i]);
						SendFormatErr(playerid, "Вы были оштрафованы за превышение скорости на %i тыс. рублей", gRadarPrice[i]);
						SendFormatErr(playerid, "Ваша текущая скорость %i км/ч, максимальная скорость на данном участке %i км/ч", speed, gRadarSpeed[i]);
						break;
					}
				}
			}

			if(GetVehicleType(vehicleid) != 2 && GetVehicleType(vehicleid) != 3 && GetVehicleType(vehicleid) != 5 && GetVehicleType(vehicleid) != 4 && GetVehicleType(vehicleid) != 7)
			{
			}
		}

		if(GetPlayerWeapon(playerid) && !PI[playerid][pAdmin] && IsPlayerInRangeOfPoint(playerid, 80.0, -197.3163,1405.5825,1502.0037))
		{
			SetPlayerArmedWeapon(playerid, 0);
			SendClientMessage(playerid, COLOR_RED, "Держать оружие в руках в данном месте запрещено.");
		}
		if(playerActiveBottle[playerid])
		{
			new anim = GetPlayerAnimationIndex(playerid);
			if(anim == 1274 || anim == 1159)
			{
				if(!playerInBottle{playerid} && !IsPlayerAttachedObjectSlotUsed(playerid, 9))
				{
					playerInBottle{playerid} = 1;
					//SetPlayerAttachedObject(playerid, 9, 1486, 1, -0.302000, 0.338999, 0.001000,  88.099998, 45.300144, -72.199890, 1.500000, 1.500000, 1.500000);
				}
			}
			else
			{
				if(playerInBottle{playerid})
				{
					playerInBottle{playerid} = 0;
					RemovePlayerAttachedObject(playerid, 9);
				}
			}
		}
	}
	return 0x1;
}
stock OnServerUpdatePlayerTimer1()
{
	foreach(new playerid : Player)
	{
		/*if(IsPlayerFromThePhone(playerid))
			SendPlayerHudData(playerid, g_players_count, PI[playerid][P_IN_GREEN_ZONE], playerEuro[playerid]);*/

		//printf("[debug] client ac -> g_player_anticheat: %d", g_player_anticheat[playerid]);

		if(PlayerLogged[playerid])
/*		{
			if(g_anticheat_timer[playerid] > 0)
				g_anticheat_timer[playerid] --;

			if(g_anticheat_timer[playerid] == 0)
			{
				if(g_player_anticheat[playerid] == -1 && !IsPlayerFromThePhone(playerid))
				{
					ClientAnticheatKick(playerid, -1);
				}
			}
		}*/

		if(InAntiDMZone[playerid] == 2)
		{
			new weapon = GetPlayerWeapon(playerid);
			if(weapon && weapon != 43) SetPlayerArmedWeapon(playerid, 0);
		}

		PayDayTimer(playerid);

		if(PlayerFixTimerClearAnim[playerid] == 1)
		{
			if(PlayerFixTimerClearAnimCount[playerid] > 0)
			{
				PlayerFixTimerClearAnim[playerid] --;
				if(PlayerFixTimerClearAnimCount[playerid] == 0)
				{
					ClearAnimText(playerid);
					PlayerFixTimerClearAnim[playerid] = -1;
					PlayerFixTimerClearAnimCount[playerid] = -1;
				}
			}
		}
		if(PlayerFixTimerTazer[playerid] == 1)
		{
			if(PlayerFixTimerTazerCount[playerid] > 0)
			{
				PlayerFixTimerTazerCount[playerid] --;
				if(PlayerFixTimerTazerCount[playerid] == 0)
				{
					OnPlayerTazerOff(playerid);
					PlayerFixTimerTazer[playerid] = -1;
					PlayerFixTimerTazerCount[playerid] = -1;
				}
			}
		}

		new vehicleid = GetPlayerVehicleID(playerid);
		if(minute == 55 && second == 00)
		{
			if(IsAGang(playerid) == 1)
			{
				SendClientMessage(playerid, 0xFFFF00FF, "Просмотр топ ОПГ: "cWH"/topopg");
			}
		}
		if(playerAuthTime[playerid] > 0 && !PlayerLogged[playerid])
		{
			playerAuthTime[playerid] --;
			if(playerAuthTime[playerid] == 0)
			{
				SendClientMessage(playerid, COLOR_RED, "Время на авторизацию истекло! Для выхода из игры введите: "cWH"/q(uit)");
				KickEx(playerid, "auth_time");
			}
		}
		if(PlayerLogged[playerid] == true)
		{
			if(playerHookClick{playerid})
			{
				if( ++ playerHookTime[playerid] > 5)
				{
					SetPlayerDrunkLevel(playerid, 3000);
				}
			}
			if((second % 2) == 0)
			{
				if(PI[playerid][pInHospital] && IsPlayerInRangeOfPoint(playerid, 50.0, -2525.6289,1291.5995,2023.7655))
				{
					GameTextForPlayer(playerid, "~g~~h~~h~+ 1 HP", 1000, 4);
					SetPlayerChatBubble(playerid, "+1 hp", 0x33CC33FF, 5.0, 1000);
					GiveHealth(playerid, 1);

					new Float:shealth;
					GetPlayerHealth(playerid, shealth);
					if(shealth >= 100.0)
					{
						SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно прошли курс лечения!");
						PI[playerid][pInHospital] = false;
					}
				}
			}
			if(PI[playerid][pCarTheftTime] != -1) if(PI[playerid][pCarTheft] != INVALID_PLAYER_ID)
			{
				PI[playerid][pCarTheftTime] --;
				stringer1 = "";
				strcat(stringer1, ConvertSeconds(PI[playerid][pCarTheftTime]));
				GameTextForPlayer(playerid, stringer1, 1000, 4);
				if(PI[playerid][pCarTheftTime] < 0)
				{
					SendClientMessage(playerid, COLOR_RED, "К сожалению вы не успели доставить автомобиль");
					SetVehicleToRespawn(PI[playerid][pCarTheft]);
					DisablePlayerRaceCheckpoint(playerid);
					CarTheft[playerid] = 0;
					PI[playerid][pCarTheftTime] = -1;
				}
			}
			if(UseGPS[playerid])
			{
				new Float:pos_x, Float:pos_y, Float:pos_z;
				GetPlayerPos(playerid, pos_x, pos_y, pos_z);
				format(stringer1, 80, "%.1fМ", GetDistanceBetweenPoints(pos_x, pos_y, pos_z, gps_player_x[playerid], gps_player_y[playerid], gps_player_z[playerid]));
				PlayerTextDrawSetString(playerid, gps_td_player[1][playerid], stringer1);
			}
			if(PI[playerid][pAdmin] && admin_warning_attempt[playerid] > 0)
			{
				if(admin_warning_time[playerid] <= GetTickCount() && admin_warning_attempt[playerid] > 0) admin_warning_attempt[playerid] = 0;
			}
			if(PI[playerid][pMember] && leader_warning_attempt[playerid] > 0)
			{
				if(leader_warning_time[playerid] <= GetTickCount() && leader_warning_attempt[playerid] > 0) leader_warning_attempt[playerid] = 0;
			}
			if(GetPlayerSurfingVehicleID(playerid) != INVALID_VEHICLE_ID) if(SpeedVehicle(playerid) > 70)
			{
				new Float:pos_x, Float:pos_y, Float:pos_z;
				GetPlayerPos(playerid, pos_x, pos_y, pos_z);
				SetPlayerPos(playerid, (pos_x + 2.5), pos_y, (pos_z + 2.5));
				ApplyAnimation(playerid, "ped", "BIKE_fallR", 4.0, 0, 1, 0, 0, 0, 0);

				PlayerFixTimerClearAnim[playerid] = 1;
				PlayerFixTimerClearAnimCount[playerid] = 1;
			}
			if(member_message_time[playerid] <= GetTickCount())
			{
				if(PI[playerid][pMember] && member_count_message[playerid] > 0)
				{
					member_count_message[playerid] = 0;
					member_message_time[playerid] = 0;
					strmid(member_message[playerid], "_", 0, strlen("_"), 5);
				}
			}
			if(member_message_time_2[playerid] <= GetTickCount() && fraction_protection_status[playerid] && member_count_message[playerid] > 0)
			{
				member_count_message[playerid] = 0;
				member_message_time[playerid] = 0;
				member_message_time_2[playerid] = 0;
				strmid(member_message[playerid], "_", 0, strlen("_"), 5);
				fraction_protection_status[playerid] = 0;

			}
			if(GotoInfo[playerid][gtGoID] != INVALID_PLAYER_ID)
			{
				new goid = GotoInfo[playerid][gtGoID];
				if(IsPlayerConnected(goid))
				{
					new Float:xX, Float:xY, Float:xZ,Float:agle;
					GetPlayerPos(goid, xX, xY, xZ);
					GetPlayerFacingAngle(playerid, agle);
					if(GetPlayerState(goid)==1)
					{
						new ANIMATION;
						if(GotoInfo[goid][gtTPX] != 0.0 || GotoInfo[goid][gtTPY] != 0.0)
						{
							SetPlayerFaceToPoint(playerid, GotoInfo[goid][gtTPX], GotoInfo[goid][gtTPY]);
							ANIMATION = GoPlayerAnimation(playerid, GotoInfo[goid][gtTPX], GotoInfo[goid][gtTPY], GotoInfo[goid][gtTPZ]);
						}
						else
						{
							TurnPlayerFaceToPlayer(playerid, goid);
							ANIMATION = GoPlayerAnimation(playerid, xX, xY, xZ);
						}
						if(ANIMATION != 1)
						{
							if(IsPlayerInRangeOfPoint(playerid, 0.05, GotoInfo[playerid][gtX], GotoInfo[playerid][gtY], GotoInfo[playerid][gtZ]))
							{
								GotoInfo[playerid][gtStayed] ++;
								if(GotoInfo[playerid][gtStayed] >= 10)
								{
									new Float:xA;
									GetPlayerPos(playerid, xX, xY, xZ);
									GetPlayerFacingAngle(playerid, xA);
									ShiftCords(0, xX, xY, xA, 1.5);
									SetPlayerPos(playerid, xX, xY, xZ);
									GotoInfo[playerid][gtStayed] = 0;
								}
							}
							else GotoInfo[playerid][gtStayed] = 0;
							GetPlayerPos(playerid, GotoInfo[playerid][gtX], GotoInfo[playerid][gtY], GotoInfo[playerid][gtZ]);
						}
					}
				}
				else
				{
					GotoInfo[playerid][gtGoID] = INVALID_PLAYER_ID;
					GotoInfo[playerid][gtX] = 0.0;
					GotoInfo[playerid][gtY] = 0.0;
					GotoInfo[playerid][gtZ] = 0.0;
				}
			}
			new target = PB_GETSLOTPLAYER(playerid);
			if(target != -1)
			{
				format(global_string, 200, "%dР~N~%d/%d~n~%s~n~~n~%d/%d~n~%d/%d", PBP_BANK,PB_COUNTPLAYERS(),MAX_PBPLAYER,ConvertSeconds(PBP_TIMER), PB_GETPOS(playerid),PBP_PLAYERS, PB_KILL[playerid] ,PB_DEATH[playerid]);
				PlayerTextDrawSetString(playerid, paint_td_player[playerid], global_string);

				if(!IsPlayerInRangeOfPoint(playerid, 100.0, 101.7717,812.6373,13.0688) && PBP_STATUS == 1)
				{
					SendClientMessage(playerid,COLOR_RED,"Вы были дисквалифицированы с Мясорубки из-за того что далеко ушли.");
					g_player_in_event[playerid] = false;
					PBP_PLAYERIDS[target] = INVALID_PLAYER_ID;
					PB_KILL[playerid] =
					playerMyasoRubk{playerid} =
					PB_DEATH[playerid] = 0;
				}
			}
			PI[playerid][pAFK]++;
			if(PI[playerid][pAFK] >= 3)
			{
				stringer1 = "Игрок на паузе:";
				strcat(stringer1, ConvertSeconds(PI[playerid][pAFK]));
				SetPlayerChatBubble(playerid, stringer1, COLOR_YELLOW, 10.0, 1600);
			}
			else
			{
				g_player_online[playerid][day_weeks] ++;
				PI[playerid][pAdmSt][6] ++;
			}
			if(PI[playerid][Spectating][1] != INVALID_PLAYER_ID)
			{
				new str[300];
				new Float:values[3];
				GetPlayerHealth(PI[playerid][Spectating][0], values[0]);
				GetPlayerArmour(PI[playerid][Spectating][0], values[1]);
				GetVehicleHealth(GetPlayerVehicleID(PI[playerid][Spectating][0]), values[2]);
				format(str, sizeof(str), "%s~n~ID: %d~n~Ping: %d~n~HP: %.1f~n~Armour: %.1f~n~Speed: %d~n~CarHP: %.1f~n~Ammo: %d:%d~n~Warns: %d~n~Cash: %d",
				GetName(PI[playerid][Spectating][0]), PI[playerid][Spectating][0], GetPlayerPing(PI[playerid][Spectating][0]),
				values[0], values[1], (PI[playerid][Spectating][0]), values[2],
				GetPlayerWeapon(PI[playerid][Spectating][0]), GetPlayerAmmo(PI[playerid][Spectating][0]),
				PI[PI[playerid][Spectating][0]][pWarn], PI[PI[playerid][Spectating][0]][pCash]);
				PlayerTextDrawSetString(PI[playerid][Spectating][1], PI[PI[playerid][Spectating][1]][SpecTxt], str);
			}
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			{
				new vehicle_id = GetPlayerVehicleID(playerid);
				new Float:vehhealth;
				GetVehicleHealth(vehicle_id, vehhealth);
				if(vehhealth <= 400)
				{
					if(Engine[vehicle_id] == true) SendClientMessage(playerid, -1, ""cER"Машина поломана!");
					Engine[vehicle_id] = false;
					GetVehicleParamsEx(vehicle_id,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
					SetVehicleParamsEx(vehicle_id,false,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
				}
				if(Fuel[vehicle_id] < 1 && PlayerFuelMes[vehicle_id] == true && GetVehicleModel(vehicle_id) != 462)
				{
					SendClientMessage(playerid, COLOR_GREY, "В транспорте закончился бензин, необходима заправка!");
					Engine[vehicle_id] = false;
					GetVehicleParamsEx(vehicle_id,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
					SetVehicleParamsEx(vehicle_id,false,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
					PlayerFuelMes[vehicle_id] = false;
				}
			}
			if(PI[playerid][pInTakeMats]) if(PI[playerid][pMember] == TEAM_ARMY || IsAGang(playerid) || IsAMafia(playerid) && PI[playerid][pMember] != TEAM_HITMAN)
			{
				if(RefillBoxUnLoad[playerid])
				{
					RefillBoxUnLoad[playerid] = 0;
					RemovePlayerAttachedObject(playerid, 0);
					ApplyAnimation(playerid,"CARRY","putdwn",1.0,0,1,1,0,0,1);
					Mats[4] += 500;
					gArmyWarehouse[1] += 500;

					PI[playerid][pScoreIvent] ++;
					WHDataUpdate();

					MysqlUpdatePlayerInt(playerid, "scoreivent", PI[playerid][pScoreIvent]);
				}
				else StealMats(playerid);
			}
			if(Mobile[playerid] != -1 && EtherCalled[playerid] == false)
			{
				CallTime[playerid] += 1;
				if(CallTime[playerid] >= 60)
				{
					if(PI[playerid][pPhoneBalance] > PHONE_PRICE)
					{
						PI[playerid][pPhoneBalance] -= PHONE_PRICE;
						CallTime[playerid] = 0;
					}
					else
					{
						new callerid = Mobile[playerid];
						SendClientMessage(callerid, COLOR_GRAD2, "Абонент положил трубку");
						SetPlayerSpecialAction(callerid,SPECIAL_ACTION_STOPUSECELLPHONE);
						CellTime[callerid] = -1;
						CellTime[playerid] = -1;
						SendClientMessage(playerid,  COLOR_GRAD2, ""cER"Недостаточно средств на счету...");
						Mobile[playerid] = -1;
						SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
						CallTime[playerid] = 0;
						CallTime[playerid] = 0;
					}
				}
			}
			if(EtherCalled[playerid] == true)
			{
				if(PI[playerid][pPhoneBalance] > CallPrice)
				{
					PI[playerid][pPhoneBalance] -= CallPrice;
					FracBank[8] += CallPrice;
					MysqlUpdateOtherInt("lsnbank", FracBank[8]);
				}
				else
				{
					new callerid = Mobile[playerid];
					SendClientMessage(callerid, COLOR_GRAD2, "Абонент положил трубку");
					SetPlayerSpecialAction(callerid,SPECIAL_ACTION_STOPUSECELLPHONE);
					CellTime[callerid] = -1;
					CellTime[playerid] = -1;
					Mobile[callerid] = -1;
					if(EtherCalled[playerid] == true) EtherCalled[playerid] = false;
					if(EtherCalled[callerid] == true) EtherCalled[callerid] = false;
					SendClientMessage(playerid,  COLOR_GRAD2, ""cER"Недостаточно средств на счету...");
					Mobile[playerid] = -1;
					SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
				}
			}
			if(PI[playerid][pJail])
			{
				if(PI[playerid][pJail] == 1)
				{
					if(!IsPlayerInRangeOfPoint(playerid, 50.0, SetPlayerPosJail[0][0], SetPlayerPosJail[0][1], SetPlayerPosJail[0][2]))
					{
						new r = random(10);
						SetPlayerPos(playerid, SetPlayerPosJail[r][0], SetPlayerPosJail[r][1], SetPlayerPosJail[r][2]);
						SetPlayerFacingAngle(playerid, SetPlayerPosJail[r][2]);
						SetPlayerWantedLevel(playerid, 3);
						SetPlayerInterior(playerid, 1);
						SetPlayerVirtualWorld(playerid, playerid+1);
					}
				}
				else
				{
					if(!IsPlayerInRangeOfPoint(playerid, 50.0, 830.4164, 1311.4521, 421.0300))
					{
						SetPlayerVirtualWorld(playerid, 1);
						SetPlayerInterior(playerid, 0);
						SetPlayerPos(playerid, 830.4164, 1311.4521, 421.0300);
					}
				}
				PI[playerid][pJailTime]--;
				if(PI[playerid][pJailTime] <= 0)
				{
					SendClientMessage(playerid, COLOR_WHITE,"Время заключения в деморгане истекло, теперь Вы свободны");
					SetPlayerPos(playerid, -1708.2100,-2808.5928,14.4170);
					SetPlayerFacingAngle(playerid, 0);

					CheckPlayerSkin(playerid);
					GameTextForPlayer(playerid, "~g~freedom", 5000, 1);
					PI[playerid][pJail] =
					PI[playerid][pJailTime] = 0;
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld(playerid, 0);

					if(PI[playerid][pMember]) SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
					else SetPlayerSkin(playerid, PI[playerid][pModel]);
				}
			}
			if(PI[playerid][pMuted])
			{
				PI[playerid][pMuted]--;
				if(PI[playerid][pMuted] <= 0)
				{
					PVC_UnMutePlayer(playerid);
					SendClientMessage(playerid, COLOR_GREEN, "Время мута закончилось, теперь вы можете говорить");
					SendClientMessage(playerid, COLOR_WHITE, "Соблюдайте правила сервера, чтобы избежать наказаний!");
				}
			}
			if(GetPlayerDrunkLevel(playerid))
			{
				DrunkTime[playerid] += 1;
				if(DrunkTime[playerid] >= 100)
				{
					SetPlayerDrunkLevel(playerid, GetPlayerDrunkLevel(playerid) - 1000);
					DrunkTime[playerid] = 0;
				}
			}
			if(CellTime[playerid] > -1)
			{
				CellTime[playerid]++;
				vehicleid = Mobile[playerid];
				if(Mobile[vehicleid] == -1 && CellTime[playerid] == 5)
				{
					CellTime[playerid] = 0;
					if(Phone_Time[vehicleid] > 0) Phone_Time[vehicleid] -= 1;
					if(!Phone_Time[vehicleid])
					{
						Phone_Time[vehicleid] = 3;
						format(stringer1, sizeof(stringer1), "У %s звонит мобильный телефон", GetName(Mobile[playerid]));
						ProxDetector(13.0, Mobile[playerid], stringer1, COLOR_PURPLE);
					}
				}
			}
			if(PI[playerid][pAFK] < 3)
			{
				PI[playerid][pRefTime] ++;
				PI[playerid][pCheckTime]++;

				if(PI[playerid][pRefTime] >= (3600 * 12) && PI[playerid][pRefPay] == 0)
				{
					PI[playerid][pRefPay] = 1;
					UpdatePlayerData(playerid, "RefPay", PI[playerid][pRefPay]);
					if(strcmp(PI[playerid][pReferal], "None", true) != 0)
					{
						if(GetPlayerID(PI[playerid][pReferal]) != INVALID_PLAYER_ID)
						{
							new targetid = GetPlayerID(PI[playerid][pReferal]);

							STRING_GLOBAL[0] = EOS;
							format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Ваш реферал %s[%d] достиг отыгранной нормы. Награда 250 euro и 10 "SERVER_COINS"", GetName(playerid), playerid);
							SendClientMessage(playerid, 0xFFFF00FF, STRING_GLOBAL);

							PI[targetid][pPerfectCoins] += 10;
							UpdatePlayerData(targetid, "credits", PI[targetid][pPerfectCoins]);

							TransferEuro(-1, targetid, 250, "Реферал");
						}
						else
						{
							STRING_GLOBAL[0] = EOS;
							mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `credits` = credits + 10, `pEuro` = pEuro + 250 WHERE `name` = '%s'", PI[playerid][pReferal]);
							mysql_tquery(db_prod, STRING_GLOBAL);
						}
					}
				}
			}
			if(PI[playerid][pAdmin]) AdminInfo[playerid][admTimeMin]++, AdminInfo[playerid][admTimeDay]++;
			if(PI[playerid][pLeader]) PI[playerid][pLeaderStat][LEADER_TIME]++;
			if(Ether[playerid] == true) InEther[playerid] += 1;
			if(TransferReset[playerid] > 0) TransferReset[playerid]--;
			if(UnMaskReset[playerid] > 0) UnMaskReset[playerid]--;

			CheckRaceBetPlayers(playerid);
		}
	}
	return 0x1;
}

callback:: CheckRaceBetPlayers(playerid)
{
	if GetPVarInt(playerid, "gonka_time") <= 5 && GetPVarInt(playerid, "gonka_time") != 0 *then
	{
		SetPVarInt(playerid, "gonka_time", GetPVarInt(playerid, "gonka_time") - 1);

		if GetPVarInt(playerid, "gonka_time") == 0 *then
		{
			GameTextForPlayer(playerid, "~g~START", 1000, 3);
			TogglePlayerControllable(playerid, true);
		}
		else
		{
			format(String64, 8, "~y~%d", GetPVarInt(playerid, "gonka_time"));
			GameTextForPlayer(playerid, String64, 1000, 3);
		}
	}
	return true;
}
OnServerUpdatePlayerTimer10()
{
	foreach(new playerid : Player)
	{
		if(playerFind[playerid])
		{
			new id = playerFind[playerid] - 1;
			new Float:pos_x, Float:pos_y, Float:pos_z;
			GetPlayerPos(id, pos_x, pos_y, pos_z);
			GPSPlayer_(playerid, pos_x, pos_y, pos_z, "Последнее местоположение");
		}
		if(arendkey[playerid] != -1)
		{
			new rc = arendkey[playerid];
			if(ArendInfo[rc][aPlayerID] != playerid) arendkey[playerid] = -1;
			if(!IsPlayerInVehicle(playerid, ArendInfo[rc][aID]) && arendkey[playerid] != -1)
			{
				new Float:x, Float:y, Float:z;
				GetVehiclePos(ArendInfo[rc][aID], x, y, z);
				if(!IsPlayerInRangeOfPoint(playerid, 500.0, x, y, z) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
				{
					SendClientMessage(playerid, COLOR_FADE1, "Вы отошли слишком далеко от арендованного вами транспорта");
					ArendInfo[rc][aPlayerID] = INVALID_PLAYER_ID;
					SetVehicleToRespawn(ArendInfo[rc][aID]);
					CarDoorsEx(ArendInfo[rc][aID], 0);
					arendkey[playerid] = -1;
				}
			}
		}
		for(new accountid; accountid < 5; accountid ++)
		{
			if(!IsValidBankAccount(playerid, accountid)) continue;
			if(g_player_bank_accounts[playerid][accountid][B_BALANCE] < -100000000)
			{
				g_player_bank_accounts[playerid][accountid][B_BALANCE] = 2000000000;

				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
				mysql_tquery(db_prod, STRING_GLOBAL);

				SendClientMessage(playerid, 0xFFCC00AA, "У Вас достигнут лимит денег на одном из бановских счетов. Ваш баланс изменен на 2 миллиарда");
			}
		}
	}
	return 0x1;
}

stock GetNameComponent(playerid, componentid)
{
	new str_name[128];
	if(GetUsedComponent(playerid, componentid) == 1) str_name = "Уже установлено";
	if(GetUsedComponent(playerid, componentid) == 0)
	{
		format(str_name, sizeof(str_name), "%s", GetVehicleComponentName(componentid));
	}
	return str_name;
}

stock IsPlayerEvent(id)
{
	if(!PlayerFixMP[id] &&
	!playerPVPGun[id][0] &&
	!playerIvent{id} &&
	!playerGamePubg{id} &&
	PB_GETSLOTPLAYER(id) == -1 &&
	!fights_player_status[id]) return false;
	else return true;
}

stock Speed_Show_Player(playerid)
{
	if(!IsPlayerFromThePhone(playerid))
	{
		new vehicleid = GetPlayerVehicleID(playerid);

		TextDrawShowForPlayer(playerid, speed_TD[0]);

		if(!Engine[vehicleid]) PlayerTextDrawColor(playerid, speed_PTD[playerid][3], 0xFFFFFFFF);
		else PlayerTextDrawColor(playerid, speed_PTD[playerid][3], 0xFF6600FF);

		if(!Lights[vehicleid]) PlayerTextDrawColor(playerid, speed_PTD[playerid][4], 0xFFFFFFFF);
		else PlayerTextDrawColor(playerid, speed_PTD[playerid][4], 0xFF6600FF);

		if(!IsLocked[vehicleid]) PlayerTextDrawColor(playerid, speed_PTD[playerid][5], 0xFFFFFFFF);
		else PlayerTextDrawColor(playerid, speed_PTD[playerid][5], 0xFF6600FF);

		for(new idx; idx < 8; idx++) PlayerTextDrawShow(playerid, speed_PTD[playerid][idx]);
	}

	else
	{
		//ShowPlayerSpeedometer(playerid);
	}
}

stock Speed_Hide_Player(playerid)
{
	if(IsPlayerFromThePhone(playerid))
	{
		TextDrawHideForPlayer(playerid, speed_TD[0]);
	}

	else
	{
		TextDrawHideForPlayer(playerid, speed_TD[0]);

		for(new idx; idx < 8; idx++)
		{
			PlayerTextDrawHide(playerid, speed_PTD[playerid][idx]);
		}
	}

	return 1;
}
