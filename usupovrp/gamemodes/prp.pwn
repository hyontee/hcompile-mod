cmd:loadmats(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_ARMY)
	return 1;

	if(!(metall_info[0][mVehicle] <= GetPlayerVehicleID(playerid) <= metall_info[3][mVehicle]))
	return 1;

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	return 1;

	if(!IsPlayerInRangeOfPoint(playerid, 50.0, -1060.8104,2208.3440,38.0989))
	return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться на складе");

	new vehicleid = GetPlayerVehicleID(playerid),
	idx = vehicleid - metall_info[0][mVehicle];

	if(vehicleid != metall_info[idx][mVehicle])
	return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в автомобиле для разгрузки");

	if(metall_info[idx][mLoading] == -1)
	{
		new Float:x, Float:y, Float:z, Float:a;
		GetVehiclePos(vehicleid, x, y, z);
		GetVehicleZAngle(vehicleid, a);
		switch(GetVehicleModel(vehicleid))
		{
		case 433:
			{
				x = x - (-4.5*floatsin(a, degrees));
				y = y - 5.5*floatcos(a, degrees);
				metall_info[idx][mPickup] = CreatePickup(3013, 1, x, y, z-0.5, -1); //Пикап грузовиков
				metall_info[idx][mArea] = CreateDynamicSphere(x, y, z, 1.0);

				metall_info[idx][mLoading] = 1;

				Iter_Add(VehicleGun, idx);
				SendClientMessage(playerid, 0xFFCC00AA, "Загрузка начата");

				RemovePlayerFromVehicle(playerid);
			}
		case 400,404,436,466,475,489,492,579,482:
			{
				x = x - (-3.0*floatsin(a, degrees));
				y = y - 3.5*floatcos(a, degrees);
				metall_info[idx][mPickup] = CreatePickup(3013, 1, x, y, z-0.2, -1); //Пикап для легковых авто
				metall_info[idx][mArea] = CreateDynamicSphere(x, y, z, 1.0);

				metall_info[idx][mLoading] = 1;

				Iter_Add(VehicleGun, idx);
				SendClientMessage(playerid, 0xFFCC00AA, "Загрузка начата");

				RemovePlayerFromVehicle(playerid);
			}
		default: SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в автомобиле для разгрузки");
		}
	}

	return 1;
}

cmd:unloadmats(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_ARMY) return 1;

	if(!(metall_info[0][mVehicle] <= GetPlayerVehicleID(playerid) <= metall_info[3][mVehicle]))
	return 1;

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	return 1;

	new vehicleid = GetPlayerVehicleID(playerid),
	idx = vehicleid - metall_info[0][mVehicle];

	if(!IsPlayerInRangeOfPoint(playerid, 100.0, -2521.9690, -669.4315, 29.4547) && PI[playerid][pMember] == TEAM_ARMY)
	return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться на базе");

	if(vehicleid != metall_info[idx][mVehicle])
	return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в автомобиле для разгрузки");

	if(metall_info[idx][mLoad] < 1)
	return SendClientMessage(playerid, COLOR_RED, "В авто нет ящиков");

	if(metall_info[idx][mLoading] == -1)
	{
		RemovePlayerFromVehicle(playerid);
		new Float:x, Float:y, Float:z, Float:a;
		GetVehiclePos(vehicleid, x, y, z);
		GetVehicleZAngle(vehicleid, a);
		switch(GetVehicleModel(vehicleid))
		{
		case 433:
			{
				x = x - (-6.0*floatsin(a, degrees));
				y = y - 5.5*floatcos(a, degrees);
				metall_info[idx][mPickup] = CreatePickup(3013, 1, x, y, z-0.5, -1); //Пикап грузовиков
				metall_info[idx][mArea] = CreateDynamicSphere(x, y, z, 1.0);

				metall_info[idx][mLoading] = 0;
			}
		case 400,404,436,466,475,489,492,579,482:
			{
				x = x - (-3.0*floatsin(a, degrees));
				y = y - 3.5*floatcos(a, degrees);
				metall_info[idx][mPickup] = CreatePickup(19133, 1, x, y, z-0.2, -1); //Пикап для легковых авто
				metall_info[idx][mArea] = CreateDynamicSphere(x, y, z, 1.0);

				metall_info[idx][mLoading] = 0;
			}
		default: SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в автомобиле для разгрузки");
		}

		Iter_Add(VehicleGun, idx);
		SendClientMessage(playerid, 0xFFCC00AA, "Разгрузка начата");
	}

	return 1;
}
CreateNewAccessoriesObject(playerid, idx)
{
	new type = PI[playerid][pAccType];

	if(type== -1 || GetPlayerInBiz(playerid) == -1) return 1;

	if(PI[playerid][pAccObject] != INVALID_OBJECT_ID) DestroyPlayerObject(playerid, PI[playerid][pAccObject]), PI[playerid][pAccObject] = INVALID_OBJECT_ID;

	new objectid = g_accessories_objects[type][idx];

	if(0 <= type <= 2 && idx < 4) PI[playerid][pAccObject] = CreatePlayerObject(playerid, objectid, 2696.7288, 298.2143, 1401.1230,   0.0000, -90.0000, 149.1593);

	if(type == 0 && idx > 3) PI[playerid][pAccObject] = CreatePlayerObject(playerid, objectid, 2696.7288, 298.2143, 1401.1230,   0.0000, -90.0000, 149.1593);

	if(type == 1 && idx > 3) PI[playerid][pAccObject] = CreatePlayerObject(playerid, objectid, 2696.7288, 298.2143, 1401.1230,   0.0000, -90.0000, 149.1593);

	if(type == 1 && idx > 12) PI[playerid][pAccObject] = CreatePlayerObject(playerid, objectid, 2696.7288, 298.2143, 1401.1230,   0.0000, -90.0000, 149.1593);

	if(3 <= type <= 4) PI[playerid][pAccObject] = CreatePlayerObject(playerid, objectid, 2696.7288, 298.2143, 1401.1230,   0.0000, -90.0000, 149.1593);

	global_string = "";
	format(global_string, 30, "%d_руб", g_accessories_objects_sum[type] * BizzInfo[ GetPlayerInBiz(playerid) ][bTill]);
	PlayerTextDrawSetString(playerid, td_acessories_player[playerid], global_string);

	return 1;
}

callback::LoadPlayerAccessories(playerid)
{
	new rows = cache_num_rows();
	if(rows)
	{
		for(new idx; idx < rows; idx ++)
		{
			SetPlayerAccessoriesData(playerid, idx, A_ID, cache_get_field_content_int(idx, "id"));
			SetPlayerAccessoriesData(playerid, idx, A_OBJECT, cache_get_field_content_int(idx, "objectid"));

			cache_get_field_content(idx, "name", g_player_accessories[playerid][idx][A_NAME], db_prod, 32);

			SetPlayerAccessoriesData(playerid, idx, A_OBJECT_X, cache_get_field_content_float(idx, "object_x"));
			SetPlayerAccessoriesData(playerid, idx, A_OBJECT_Y, cache_get_field_content_float(idx, "object_y"));
			SetPlayerAccessoriesData(playerid, idx, A_OBJECT_Z, cache_get_field_content_float(idx, "object_z"));
		}
	}
	return 1;
}

CMD:accs(playerid, params[])
{
    format(stringer1, sizeof(stringer1),"SELECT * FROM accounts_accessories WHERE `owner` = '%d'", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "LoadPlayerAccessories","d", playerid);

	new access, fmt_str[60];

	global_string = "";

	for(new idx; idx < MAX_PLAYER_ACCESSORIES; idx ++)
	{
		if(GetPlayerAccessoriesData(playerid, idx, A_OBJECT) == 0) continue;

		format(fmt_str, sizeof fmt_str, ""cMain"%d. "cWH"%s\n", idx + 1, GetPlayerAccessoriesData(playerid, idx, A_NAME));
		strcat(global_string, fmt_str);

		access ++;
	}

	if(access == 0) return SendClientMessage(playerid, COLOR_RED, "У Вас нет аксессуаров. Приобрести их можно в магазине аксессуаров (/gps)");

	ShowPlayerDialog
	(
	playerid, 7746, DIALOG_STYLE_LIST,
	""cMain"Аксессуары",
	global_string,
	"Далее", "Отмена"
	);

	return 1;
}

GetBoneObject(objectid)
{
	new bone = -1;

	for(new type; type < sizeof g_accessories_objects; type ++)
	{
		for(new idx; idx < 33; idx ++)
		{
			if(g_accessories_objects[type][idx] == objectid)
			{
				bone = type;

				break;
			}
		}
	}

	return bone;
}
