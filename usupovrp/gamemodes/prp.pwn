				{
					if(e_info[idx][e_dostup] && (e_info[idx][e_fraction] != PI[playerid][pMember] && !IsACopAndFSB(playerid))) return SendClientMessage(playerid, COLOR_RED, "Нет пропуска");
					SetPlayerPos(playerid, e_info[idx][v_x], e_info[idx][v_y], e_info[idx][v_z]);
