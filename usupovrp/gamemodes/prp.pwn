	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится в транспорте!");
	RepairVehicle(GetPlayerVehicleID(playerid));
	SendClientMessage(playerid, COLOR_WHITE, "Ваша машина отремонтирована!");
	fLogs("[admin] %s /vehhp %i", GetName(playerid), GetPlayerVehicleID(playerid));
	return 1;
}
