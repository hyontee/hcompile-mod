		fLogs("[admin] %s /agetid %s", GetName(playerid), name);
	}
	else SendClientMessage(playerid, COLOR_GREY, "Игрок не найден!");
	return 1;
}

callback::OnPlayerOffget(playerid, name[])
{
	if(cache_get_row_count(db_prod) > 0)
	{
		new string_dialogue[512], idacca, cash, level, regip[16], lastip[16], datareg[15], datavhod[15], donate;
		idacca = cache_get_field_content_int(0, "id");
		cash = cache_get_field_content_int(0, "cash");
		level = cache_get_field_content_int(0, "level");

		cache_get_field_content(0, "regip", regip, db_prod, 16);
		cache_get_field_content(0, "ip", lastip, db_prod, 16);
		cache_get_field_content(0, "datareg", datareg, db_prod, 15);
		cache_get_field_content(0, "datavhod", datavhod, db_prod, 15);
		donate = cache_get_field_content_int(0, "credits");

		format(string, sizeof(string), "Номер аккаунта:\t%d\n", idacca);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Наличные:\t%d\n", cash);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Уровень:\t%d\n", level);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "IP адрес (регис.):\t%s\n", regip);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "IP адрес (последн.):\t%s\n", lastip);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Дата регистрации:\t%s\n", datareg);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Посл. вход:\t%s\n", datavhod);
		strcat(string_dialogue, string);
		format(string, sizeof(string), "Донат:\t%d\n", donate);
		strcat(string_dialogue, string);
		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, name, string_dialogue, "Закрыть", "");
	}
	else SendClientMessage(playerid, COLOR_GREY, "Игрок не найден!");
	return 1;
}
PhoneMenuExit(playerid)
{
	Phonesmenu[playerid] = 0;
	for(new i; i < 49; i++) TextDrawHideForPlayer(playerid, PhoneSA[i]);
	CancelSelectTextDrawEx(playerid);
	return 1;
}
PhoneMenu(playerid)
{
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"У вас нет SIM-карты!");
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");}
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"У вас изъяли телефон!");
	if(Phone[playerid] == false) return SendClientMessage(playerid, -1, ""cER"У вас выключен телефон, включить (/togphone)");
	Phonesmenu[playerid] = 1;
	for(new i; i < 49; i++) TextDrawShowForPlayer(playerid, PhoneSA[i]);
	SelectTextDrawEx(playerid, 0xFF4040AA);
	return 1;
}
SendSMS(playerid)
{
	format(stringer1, sizeof(stringer1), ""cWH"Вы пытаетесь отправить СМС на номер: %d\n\nВведите текст сообщения:", PhoneSMS[playerid]);
	ShowPlayerDialog(playerid, 3800+4, 1, ""cMain"СМС", stringer1, "Принять", "Назад");
	return 1;
}
GetString(param1[],param2[])
{
	return !strcmp(param1, param2, false);
}

callback::GmTest(playerid, targetid, Float:oldhealth)
{
	new Float: newhealth;
	GetPlayerHealth(targetid, newhealth);
	new mes[256];
	if(oldhealth == newhealth) string = "{FF0000}Возможно игрок использует God Mode(GM)";
	if(oldhealth != newhealth) string = "{05E900}Вероятно игрок чист, показатель его HP уменьшился";
	format(mes, sizeof(mes), ""cWH"Было: "cMain"%.0f.0 (HP)\n"cWH"Стало: "cMain"%.0f.0 (HP)\n"cWH"Уменьшилось на: "cMain"%.0f.0 (HP)\n\n%s", oldhealth, newhealth, oldhealth-newhealth, string);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, GetName(targetid), mes, "Закрыть", "");
	SetPlayerHealth(targetid, oldhealth);
	StartGMTest[playerid] = false;
	return 1;
}

callback::StealMats(playerid)
{
	if(PI[playerid][pAFK] >= 3) return 1;
	if(!IsPlayerInRangeOfPoint(playerid, 10.0, -2490.0676,-654.9683,29.6725))
	{
		PI[playerid][pInTakeMats] = 0;
		return 1;
	}

	new newslot;
	new ammo = random(5) + 1;
	new mats = random(5) + 5;

	if(gArmyWarehouse[1] > ammo)
	{
		if(CheckMaxVes(playerid,42,ammo,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
		gArmyWarehouse[1] -= ammo;
		PlayerItem1[playerid][newslot]=42;
		PlayerItem2[playerid][newslot]+=ammo;
		SaveItem(playerid,newslot);
	}
	if(Mats[4] > mats)
	{
		Mats[4] -= mats;
		PI[playerid][pMats] += mats;
	}
	if(!Mats[4] && !gArmyWarehouse[1]) return SendClientMessage(playerid, COLOR_RED, "Склад пуст");

	format(global_string, 256,""cWH"Патронов: {63BD4E}%d шт.\n"cWH"Материалов: {63BD4E}%d шт.", gArmyWarehouse[1], Mats[4]);
	UpdateDynamic3DTextLabelText(gArmyWarehouseText,0xFFFFFFFF,global_string);

	format(stringer1, sizeof(stringer1), "~b~ПАТРОНОВ: ~g~+%d~n~~b~МАТЕРИАЛОВ: ~r~+%d", ammo, mats);
	GameTextForPlayer(playerid, stringer1, 1500, 6);
	return 1;
}
UpdTerrsBand()
{
	for(new i; i < 5; i++) GangTotalGz[i] = 0;

	for(new idx = 0; idx < sizeof(GZInfo); idx++)
	{
		switch(GZInfo[idx][gFrak])
		{
		case TEAM_CSKA: GangTotalGz[3]++;
		case TEAM_SPARTAK: GangTotalGz[2]++;
		}
	}
	format(global_string, 512, "{009900}Склад - ФК ЦСКА\n\n"cWH"Патроны: {63BD4E}%d\n"cWH"Материалы: {63BD4E}%d\n"cWH"Наркотики: {63BD4E}%d\n"cWH"Деньги: {63BD4E}%d\n"cWH"Кол-во контролируемых улиц: {63BD4E}%d\n\n"cWH"Склад: %s", GangPatr[0], Mats[1], DrugsBank[TEAM_CSKA], FracBank[0], GangTotalGz[3], b_Sklad{0}?("{F04245}Закрыт"):("{63BD4E}Открыт"));
	UpdateDynamic3DTextLabelText(Gang3d[0],0xFFFFFFFF,global_string);

	format(global_string, 512,"{CC00FF}Склад - ФК Спартак\n\n"cWH"Патроны: {63BD4E}%d\n"cWH"Материалы: {63BD4E}%d\n"cWH"Наркотики: {63BD4E}%d\n"cWH"Деньги: {63BD4E}%d\n"cWH"Кол-во контролируемых улиц: {63BD4E}%d\n\n"cWH"Склад: %s", GangPatr[1], Mats[0], DrugsBank[TEAM_SPARTAK], FracBank[1], GangTotalGz[2], b_Sklad{1}?("{F04245}Закрыт"):("{63BD4E}Открыт"));
	UpdateDynamic3DTextLabelText(Gang3d[1],0xFFFFFFFF,global_string);
}
WHDataUpdate()
{
	format(global_string, 256,""cWH"Патронов: {63BD4E}%d шт.\n"cWH"Материалов: {63BD4E}%d шт.", gArmyWarehouse[1], Mats[4]);
	UpdateDynamic3DTextLabelText(gArmyWarehouseText,0xFFFFFFFF,global_string);

	format(global_string, 256,"{993366}Итальянская Мафия\n\n"cWH"Патроны: {63BD4E}%d\n"cWH"Материалы: %d\n"cWH"Наркотики: {63BD4E}%d\n"cWH"Деньги: {63BD4E}%d\n"cWH"Кол-во контролируемых бизнесов: {63BD4E}%d\n\n"cWH"Склад: %s", MafiaPatr[0], Mats[2], DrugsBank[TEAM_ITALMAFIA], FracBank[6], MafiaTotalBizz[0], b_Sklad{5}?("{F04245}Закрыт"):("{63BD4E}Открыт"));
	UpdateDynamic3DTextLabelText(Mafia3d[0],0xFFFFFFFF,global_string);

	format(global_string, 256,"{993366}Хитманы\n\n"cWH"Патроны: {63BD4E}%d\n"cWH"Наркотики: {63BD4E}%d\n"cWH"Euro: {63BD4E}%d\n\n"cWH"Склад: %s", GangPatr[4], DrugsBank[TEAM_HITMAN], FracBank[4], b_Sklad{4}?("{F04245}Закрыт"):("{63BD4E}Открыт"));
	UpdateDynamic3DTextLabelText(Gang3d[2],0xFFFFFFFF,global_string);

	format(global_string, 256,"{BB0000}Русская Мафия\n\n"cWH"Патроны: {63BD4E}%d\n"cWH"Материалы: %d\n"cWH"Наркотики: {63BD4E}%d\n"cWH"Деньги: {63BD4E}%d\n"cWH"Кол-во контролируемых бизнесов: {63BD4E}%d\n\n"cWH"Склад: %s", MafiaPatr[1], Mats[3], DrugsBank[TEAM_RUSMAFIA], FracBank[5], MafiaTotalBizz[1], b_Sklad{6}?("{F04245}Закрыт"):("{63BD4E}Открыт"));
	UpdateDynamic3DTextLabelText(Mafia3d[1],0xFFFFFFFF,global_string);

	format(global_string, 256,"{BB0000}Сейф СМИ\n\n"cWH"Деньги: {63BD4E}%d", FracBank[8]);
	UpdateDynamic3DTextLabelText(nBank3d[0],0xFFFFFFFF,global_string);

	format(global_string, 256,""cWH"Государственный Сейф\n\nДеньги: {63BD4E}%d", FracBank[9]);
	UpdateDynamic3DTextLabelText(nBank3d[1],0xFFFFFFFF,global_string);

	format(global_string, 128, "{4386BD}- Главный склад-\n\n"cWH"Материалов на складе: %d шт.", materials);
	UpdateDynamic3DTextLabelText(sklad_text, 0xFFFFFFFF, global_string);

	UpdTerrsBand();
}
IsIpFound(text[])
{
	new count = 8;
	mfor(i, (strlen(text) - 1)) if(text[i] >= '0' && text[i] <= '9')
	{
		if(--count <= 0) return 1;

	}
	return 0;
}

CheckString(text[])
{
	static const WebSites[][] =
	{
		".ws", ".ru", ".tk", ".rp", "www", ".org", ".net", ".cc", ".рф", ".by", ".biz", ".su", ".info", ".com", "vk.",
		"переезд", "новый сервер", "new ip", "дам админку", "mq", "маму", "мамке", "positiv", "нубо мод", "нуборп", "нубо рп", "176.32.39.240",
		"217.106", "106.106", "нубосервер", "дносервер", "переехали", "pravda_prp", "слив", "помойка", "помойку", "помойке", "уходите нахуй",
		"кайф хуйня"
	};

	for(new i = 0; i < sizeof(WebSites); i++)
	{
		if(strfind(text, WebSites[i], true) != -1) return 1;
	}
	return 0;
}

CheckReport(text[])
{
	static const RepBot[][] = {"дайте мне","можно мне","выдайте мне","админку","админ права"};
	for(new i = 0; i < sizeof(RepBot); i++) if(strfind(text, RepBot[i], true) != -1) return 1;
	return 0;
}
CheckExceptionName(text[])
{
	if(strfind(text, "Winston", true) != -1) return 1;
	return 0;
}
PlayerGetsChatBan(playerid, text[])
{
	format(string, sizeof(string), "[Антиреклама] %s[%d] подозревается в рекламе [IP:%s]", GetName(playerid), playerid, PI[playerid][pIP]);
	SendAdminMessage(COLOR_ORANGE, string);
	format(string, sizeof(string), "[Антиреклама] Текст: %s", text);
	SendAdminMessage(COLOR_ORANGE, string);
	PI[playerid][pMuted] = 2*60;
	PVC_MutePlayer(playerid);
	MysqlUpdatePlayerInt(playerid, "mute", PI[playerid][pMuted]);
	SendClientMessage(playerid, COLOR_RED, "Вы получили бан чата (2 мин) по подозрению в отправке рекламного сообщения.");
	SendClientMessage(playerid, COLOR_RED, "Если вы считаете, что получили его ошибочно, свяжитесь с администрацией.");
	return 1;
}
AdminAntisliv(playerid, text[])
{
	RemoveAdmin(playerid, GetName(playerid));
	format(stringer1, sizeof(stringer1), "[Внимание] %s[%d] подозревается во взломе [IP:%s]", GetName(playerid), playerid, PI[playerid][pIP]);
	SendAdminMessage(COLOR_REDD, stringer1);
	format(stringer1, sizeof(stringer1), "[Внимание] Текст: %s", text);
	SendAdminMessage(COLOR_REDD, stringer1);
	format(stringer1, sizeof(stringer1), "Админ %s [%s]: %s", GetName(playerid), PI[playerid][pIP], text);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', 'System', '%s', '%02d.%02d.%04d', '30', 'Слив админки')", GetName(playerid), PI[playerid][pIP], day, month, year);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	KickEx(playerid, "antisliv");
	return 1;
}

BotReport(playerid)
{
	SendClientMessage(playerid, COLOR_GREY, ""cMain"-"cWH" Админ права можно приобрести в /donate, а "SERVER_COINS" можно пополнить на сайте "SERVER_WEBSITE"");
	SendClientMessage(playerid, COLOR_GREY, ""cMain"-"cWH" Администрация не чего не выдает, всего добивайтесь рп путем!");
	return 1;
}
AttemptRemoveChiefAdmin(playerid)
{
	RemoveAdmin(playerid, GetName(playerid));

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', 'System', '%s', '%02d.%02d.%04d', '30', 'Слив админки')", GetName(playerid), PI[playerid][pIP], day, month, year);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	format(stringer1, sizeof(stringer1), "[Внимание] %s был снят за попытку выдать наказание главному администратору", GetName(playerid));
	SendAdminMessage(COLOR_REDD, stringer1);
	KickEx(playerid, "r_chief_adm");
	return 1;
}
BanAdminFromServer(playerid, toplayer)
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted") || GetString(GetName(playerid), "Winston")) return 1;
	RemoveAdmin(playerid, GetName(playerid));

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', 'System', '%s', '%02d.%02d.%04d', '30', 'Слив админки')", GetName(playerid), PI[playerid][pIP], day, month, year);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");


	format(stringer1, sizeof(stringer1), "[Внимание] %s(%d) был заблокирован и снят за попытку выдать наказание главному администратору %s(%d)", GetName(playerid), playerid, GetName(toplayer), toplayer);
	SendAdminMessage(COLOR_REDD, stringer1);
	fLogs("[admin] %s снят, попытка наказать ГА [%s]", GetName(playerid), GetName(toplayer));
	KickEx(playerid, "ban_admin");
	return 1;
}
AttemptRemoveAdmin(playerid, toplayer)
{
	SendClientMessage(playerid, COLOR_GREY, "Администратор выше вас рангом, или равен вам");
	format(string, sizeof(string), "[Внимание] %s(%d) попытался выдать наказание администратору %s(%d)", GetName(playerid), playerid, GetName(toplayer), toplayer);
	SendAdminMessage(COLOR_REDD, string);
	fLogs("[admin] %s попытка наказать админа [%s]", GetName(playerid), GetName(toplayer));

	return 1;
}
RemoveAdmin(targetid, name[])
{
	PI[targetid][pAdmin] = 0;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `admin` WHERE `name` = '%e'", name);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	AdminInfo[targetid][admGoto]                    =
	AdminInfo[targetid][admGethere]                 =
	AdminInfo[targetid][admSpectate]                =
	AdminInfo[targetid][admWarns]                   =
	AdminInfo[targetid][admTimeDay]					= 0;

	AdminLogged[targetid] = false;

	Iter_Remove(Admins, targetid);

	return 1;
}
GetNameWithNumber(number)
{
	new str[MAX_PLAYER_NAME] = {"Offline/None"};
	foreach(new i: Player)
	{
		if(!PlayerLogged[i]) continue;
		if(PI[i][pPhoneNumber] == number)
		{
			format(str, sizeof(str), "%s", GetName(i));
			break;
		}
	}
	return str;
}

callback::SetAdmin(playerid, name[], level, type)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		if(!level)
		{
			new id = GetPlayerID(name);
			if(id != INVALID_PLAYER_ID)
			{
				PI[id][pAdmin] = 0, AdminLogged[id] = false;
				PI[id][pBuyAdmin] = 0;
			}
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `admin` WHERE `name` = '%e'", name);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы сняли %s с должности администратора", name);
			SendClientMessage(playerid, COLOR_YELLOW, STRING_GLOBAL);

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] %s снял %s с должности администратора", GetName(playerid), name);
			SendAdminMessage(COLOR_GREY, STRING_GLOBAL);

			Iter_Remove(Admins, GetPlayerID(name));
		}
		else
		{
			new id = GetPlayerID(name);
			if(id != INVALID_PLAYER_ID)
			{
				PI[id][pAdmin] = level;

				if(type) PI[id][pBuyAdmin] = 1;
				else PI[id][pBuyAdmin] = 0;
			}
			mysql_format(db_prod, string, sizeof(string), "UPDATE `admin` SET `level` = '%d', buyadmin=%d WHERE `name` = '%s' LIMIT 1", level, type ? 1 : 0, name);
			mysql_tquery(db_prod, string, "", "");
			format(string, sizeof(string), "Вы установили уровень администратора %s на %d", name, level);
			SendClientMessage(playerid, COLOR_YELLOW, string);
			format(string, sizeof(string), "[A] %s установил уровень администратора %s на %d", GetName(playerid), name, level);
			SendAdminMessage(COLOR_GREY, string);
		}
		fLogs("[admin] %s /setadmin %s %i", GetName(playerid), name, level);
	}
	else
	{
		if(!level) return SendClientMessage(playerid, COLOR_GREY, "Игрок не администратор");

		mysql_format(db_prod, string, sizeof(string), "\
		INSERT INTO `admin` (`name`, `level`, `last_connect`, `put_admin`, `data`, `day`, `buyadmin`) VALUES ('%s', %d, '%02d.%02d.%04d', '%s', '%02d.%02d.%04d', '%d', '%d')",
		name, level, day, month, year, GetName(playerid), day, month, year, gettime(), type ? 1 : 0);
		mysql_tquery(db_prod, string, "", "");

		format(string, sizeof(string), "%s добавлен в список администрации. Уровень полномочий %d", name, level);
		SendClientMessage(playerid, COLOR_GREEN, string);
		format(string, sizeof(string), "[A] %s добавил в список администрации %s (%d уровень)", GetName(playerid), name, level);
		SendAdminMessage(COLOR_GREY, string);

		new id = GetPlayerID(name);
		if(id != INVALID_PLAYER_ID)
		{
			format(string, sizeof(string), "%s назначил Вас администратором", GetName(playerid));
			SendClientMessage(id, COLOR_YELLOW, string);
		}
		fLogs("[admin] %s /setadmin %s %i", GetName(playerid), name, level);
	}
	return 1;
}

callback::Alogin(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		if(PI[playerid][pAdmin] > 0) PI[playerid][pAdmin] = 0;
		return 1;
	}
	new Password[16];
	cache_get_field_content(0, "password", Password, db_prod);
	if(!strcmp(Password, "qwerty", true))
	{
		PlayerALogin[playerid] = 1;
		ShowPlayerDialog(playerid, 3200, DIALOG_STYLE_INPUT, ""cMain"Регистрация администратора", "\
		"cWH"Введите пароль, который будет от панели администратора\n\n\
		{63BD4E}Примечание:\n\
		\t- Пароль должен состоять из латинских букв и цифр\n\
		\t- Размер пароля от 6 до 15 символов", "Принять", "Отмена");
	}
	else
	{
		SendClientMessage(playerid, -1, "Для начала введите админ. пароль");
		PlayerALogin[playerid] = 0;
		ShowPlayerDialog(playerid, 3200, DIALOG_STYLE_INPUT, ""cMain"Доступ администратора", "\
		"cWH"Введите Ваш пароль от панели администратора", "Принять", "Отмена");
	}
	return 1;
}

callback::AloginReg(playerid, name[], password[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return 1;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `admin` SET `password` = '%e' WHERE `name` = '%e' LIMIT 1", password, GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	PI[playerid][pAdmin] = cache_get_field_content_int(0, "level");

	format(string, sizeof(string), ""cAD"%s %s[%d] авторизовался [IP: %s | R-IP %s]", gAdminRanks[PI[playerid][pAdmin]-1], GetName(playerid), playerid, PI[playerid][pLastIP],PI[playerid][pRegIP]);
	SendAdminMessage(COLOR_BLUE, string);
	fLogs("[admin] %s авторизовался", GetName(playerid));

	AdminLogged[playerid] = true;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `admin` SET `last_connect` = '%d.%d.%d', `day` = '%d' WHERE `name` = '%e' LIMIT 1", day, month, year, gettime(), GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	PI[playerid][pAdmSt][ADMIN_KICK] = cache_get_field_content_int(0, "kicks");
	PI[playerid][pAdmSt][ADMIN_BAN] = cache_get_field_content_int(0, "bans");
	PI[playerid][pAdmSt][ADMIN_WARN] = cache_get_field_content_int(0, "warns");
	PI[playerid][pAdmSt][ADMIN_PM] = cache_get_field_content_int(0, "ans");
	PI[playerid][pAdmSt][ADMIN_MUTE] = cache_get_field_content_int(0, "mutes");
	PI[playerid][pAdmSt][ADMIN_PRISON] = cache_get_field_content_int(0, "jails");
	AdminInfo[playerid][admTimeDay] = cache_get_field_content_int(0, "timeday");
	PI[playerid][pAdmSt][6] = cache_get_field_content_int(0, "act_time");
	PI[playerid][pBuyAdmin] = cache_get_field_content_int(0, "buyadmin");

	Iter_Add(Admins, playerid);

	ShowWarningPanelAC(playerid);

	return 1;
}

callback::AloginAuth(playerid, inputtext[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		SendClientMessage(playerid, -1, ""cER"Неверный пароль");
		attempt_pass[playerid] += 1;
		if(attempt_pass[playerid] > 3)
		{
			attempt_pass[playerid] = 0;
			KickEx(playerid, "alogin_auth");
		}
	}
	else
	{
		IsPlayerFullAccess(playerid);

		new warnreason[64];
		AdminLogged[playerid] = true;

		PI[playerid][pAdmin] = cache_get_field_content_int(0, "level");
		AdminInfo[playerid][admGoto] = cache_get_field_content_int(0, "a_goto");
		AdminInfo[playerid][admGethere] = cache_get_field_content_int(0, "a_gethere");
		AdminInfo[playerid][admSpectate] = cache_get_field_content_int(0, "a_spec");
		AdminInfo[playerid][admTimeMin] = cache_get_field_content_int(0, "timemin");
		AdminInfo[playerid][admWarns] = cache_get_field_content_int(0, "awarn");
		cache_get_field_content(0, "warnreason", warnreason, db_prod, 64);
		AdminInfo[playerid][admTimeDay] = cache_get_field_content_int(0, "timeday");

		PI[playerid][pAdmSt][ADMIN_KICK] = cache_get_field_content_int(0, "kicks");
		PI[playerid][pAdmSt][ADMIN_BAN] = cache_get_field_content_int(0, "bans");
		PI[playerid][pAdmSt][ADMIN_WARN] = cache_get_field_content_int(0, "warns");
		PI[playerid][pAdmSt][ADMIN_PM] = cache_get_field_content_int(0, "ans");
		PI[playerid][pAdmSt][ADMIN_MUTE] = cache_get_field_content_int(0, "mutes");
		PI[playerid][pAdmSt][ADMIN_PRISON] = cache_get_field_content_int(0, "jails");
		PI[playerid][pAdmSt][6] = cache_get_field_content_int(0, "act_time");
		PI[playerid][pBuyAdmin] = cache_get_field_content_int(0, "buyadmin");

		if(strcmp(warnreason, "None", true))
		{
			SendMes(playerid, COLOR_RED, "Вам был выдан выговор от администратора. Причина: %s", warnreason);

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE admin SET warnreason = 'None' WHERE name = '%e'", GetName(playerid));
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");
		}

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `admin` SET `last_connect` = '%d.%d.%d', `day` = '%d' WHERE `name` = '%e' LIMIT 1", day, month, year, gettime(), GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
		if(AdminInfo[playerid][admWarns] >= 3)
		{
			PI[playerid][pAdmin] --;
			AdminInfo[playerid][admWarns] = 0;
			PI[playerid][pBuyAdmin] = 0;

			switch(PI[playerid][pAdmin])
			{
			case 0,1: format(string,sizeof(string),"[A] Администратор %s[%d] был снят. Причина: 3 выговора"),SendClientMessage(playerid,COLOR_WHITE,"Вы были сняты по причине 3-ёх выговоров."),RemoveAdmin(playerid, GetName(playerid));
			default: format(string,sizeof(string),"[A] Администратор %s[%d] был понижен до %d-ого уровня. Причина: 3 выговора",PI[playerid][pName],playerid,PI[playerid][pAdmin]),SendClientMessage(playerid,COLOR_WHITE,"Вы были понижены по причине 3-ёх выговоров! Больше не нарушайте админ.правил!");
			}
			SendAdminMessage(COLOR_GREY, string);
			return 1;
		}
		SetTimerEx("OnPlayerCheckAdmin", 50, 0, "ii", playerid, cache_get_field_content_int(0, "day"));
	}
	return 1;
}

callback::OnPlayerCheckAdmin(playerid, days)
{
	if(g_player_full_access[playerid])
	{
		fLogs("[admin] %s авторизовался [%s]", GetName(playerid), PI[playerid][pIP]);
		format(stringer, 144, "%s %s[%d] авторизовался [IP: СКРЫТО | R-IP СКРЫТО]", full_access_rank[playerid], GetName(playerid), playerid);

		Iter_Add(Admins, playerid);

		ShowWarningPanelAC(playerid);
	}
	else
	{
		if(gettime() > days + (86400 * 30))
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `admin` WHERE `name` = '%e'", GetName(playerid));
			mysql_tquery(db_prod, STRING_GLOBAL);

			format(stringer, 300, ""cAD"%s %s[%d] был снят по причине неактива", gAdminRanks[PI[playerid][pAdmin]-1], GetName(playerid), playerid);
			SendAdminMessage(COLOR_BLUE, stringer);
			fLogs("[admin] %s снят неактив [%s]", GetName(playerid), PI[playerid][pIP]);

			SendClientMessage(playerid, COLOR_YELLOW, "Вы сняты с должности администратора по причине неактива");
			ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, "{E83E14}ВАЖНАЯ ИНФОРМАЦИЯ", "\
			"cWH"- [Информация] Вы были сняты с поста администратора системой по причине неактива\n\n\
			"cWH"- [Информация] Правило 3.25 администрации сервера. \n\
			"cWH"- [Информация] Покупая админ.права на нашем сервере мы даем гарантию, что просто так Вас точно не снимут. \n\n\
			"cWH"- [Информация] И Вы, и МЫ - люди. Мы вас замечательно понимаем.\n\
			"cWH"- [Информация] Но если вы допустили ошибку, то с этим уже ничего нельзя поделать.\n\
			"cWH"- [Информация] Вот честно, лично МЫ только ЗА чтобы вы не снимались из-за таких глупостей. \n\n\
			"cWH"- [Информация] Если вы гляните правила - вы поймете, что вы не соблюдали и найдете свою причину снятия.\n\n\
			"cWH"- [Информация] Приятной игры на PERFECT RUSSIA!", "Закрыть", "");

			PI[playerid][pAdmin] = 0;
			AdminLogged[playerid] = false;

			PI[playerid][pBuyAdmin] = 0;

			AdminInfo[playerid][admGoto]                    =
			AdminInfo[playerid][admGethere]                 =
			AdminInfo[playerid][admSpectate]                =
			AdminInfo[playerid][admWarns]                   =
			AdminInfo[playerid][admTimeDay]					= 0;
			return;
		}

		Iter_Add(Admins, playerid);

		ShowWarningPanelAC(playerid);

		format(stringer, 300, ""cAD"%s %s[%d] авторизовался [IP: %s | R-IP %s]", gAdminRanks[PI[playerid][pAdmin]-1], GetName(playerid), playerid,  PI[playerid][pLastIP],PI[playerid][pRegIP]);
	}

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `accounts` SET `admin` = '%d' WHERE `name` = '%s' LIMIT 1", PI[playerid][pAdmin], GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL);

	foreach(new i: Player)
	{
		if(!PlayerLogged[i]) continue;
		if(PI[i][pAdmin] > 0 && streamer_mode[i] != 1) SendClientMessage(i, COLOR_BLUE, stringer);
	}
}
GetArendCarID(vehicleid, &arend_id = INVALID_PLAYER_ID)
{
	arend_id = INVALID_PLAYER_ID;
	for(new i = 0; i < sizeof(ArendInfo); i++)
	{
		if(vehicleid == ArendInfo[i][aID])
		{
			if(IsPlayerConnected(ArendInfo[i][aPlayerID])) arend_id = ArendInfo[i][aPlayerID];
			return i;
		}
	}
	return -1;
}

callback::TopCharity(playerid)
{
	new rows, fields, name[MAX_PLAYER_NAME], string_dialogue[945];
	cache_get_data(rows, fields);
	strcat(string_dialogue, "{FFFF00}Ник игрока\t{FFFF00}Пожертвовано\n");
	if(rows < 1) return 1;
	for(new i; i < rows; i++)
	{
		if(cache_get_field_content_int(i, "charity") < 1 || cache_get_field_content_int(i, "admin") >= 10) continue;
		cache_get_field_content(i, "name", name, db_prod, MAX_PLAYER_NAME);
		format(string, sizeof(string), ""cWH"%s\t{63BD4E}%dр\n", name, cache_get_field_content_int(i, "charity"));
		strcat(string_dialogue, string);
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Самые щедрые игроки", string_dialogue, "Закрыть", "");
	return 1;
}

