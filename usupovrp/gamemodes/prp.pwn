public OnPlayerExitedMenu(playerid)
{
	if(playerid == INVALID_PLAYER_ID) return KickEx(playerid, "exited menu");
	if(GetPlayerMenu(playerid) == Menu:INVALID_MENU) return KickEx(playerid, "exited menu 2");
	return 1;
}

public OnEnterExitModShop(playerid, enterexit, interiorid)
{
	if(enterexit == 1) return KickEx(playerid, "exit mod shop");
	return true;
}


#define holding(%0) 			(((newkeys & (%0)) != (%0)) && ((oldkeys & (%0)) == (%0)))
#define pressed(%0) (((newkeys & (%0)) == (%0)) && ((oldkeys & (%0)) != (%0)))

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	if(PlayerLogged[playerid] == false) return 1;

	if(pressed(KEY_YES)) callcmd::yes(playerid, "");
	if(pressed(KEY_NO)) callcmd::no(playerid, "");

	if(newkeys == 262144 && !IsPlayerFromThePhone(playerid))
	{
		for(new i; i < 10; i ++)
		{
			TextDrawShowForPlayer(playerid, menu_TD[i]);
		}
		SelectTextDrawEx(playerid, 0xFA5E1BAA);
	}

	if(newkeys == 1024 && IsPlayerInRangeOfPoint(playerid, 5.0, 235.8488,-1277.1885,1539.1079)) {
		if(PI[playerid][pFamily] != 0) return SendClientMessage(playerid, -1, ""cER"У вас уже есть семья");
		format(stringer1,sizeof(stringer1), "1. Создание семьи\n2. Всего семей: %d", family_count);
		ShowPlayerDialog(playerid, 700, DIALOG_STYLE_LIST, ""cMain"Информация о семьях", stringer1, "Выбор", "Выход");

	}

	if(playerHookID[playerid] != -1 && playerHookIsSitting{playerid} && GetPlayerAnimationIndex(playerid) == 1189)
	{
		if(pressed(KEY_CROUCH))
		{
			playerHookClick{playerid} = 1;
			return 0;
		}
		if(holding(KEY_CROUCH))
		{
			playerHookClick{playerid} = 0;
			switch(random(3))
			{
			case 0: SetPlayerAttachedObject(playerid, 5, 18675, 2, 0.221999, 1.192000, -1.698997, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
			case 1: SetPlayerAttachedObject(playerid, 5, 18676, 2, -0.033000, 0.223999, -1.636999, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
			case 2: SetPlayerAttachedObject(playerid, 5, 18687, 2, 0.072000, 0.087999, -1.624998, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
			}
			SetTimerEx("HookClear", 3000, false, "d", playerid);
		}
	}
	if(g_player_action[playerid])
	{
		if(position_action[playerid] < 10)
		{
			if(newkeys & key_action[playerid])
			{
				if(key_action[playerid] == KEY_YES)
				{
					if(newkeys & KEY_YES)
					{
						switch(random(2))
						{
						case 0: key_action[playerid] = KEY_YES, PlayerTextDrawSetString(playerid, cuff_td_player[0][playerid], "Y");
						case 1: key_action[playerid] = KEY_NO, PlayerTextDrawSetString(playerid, cuff_td_player[0][playerid], "N");
						}
						position_action[playerid] ++;
						new Float:td_x = position_action[playerid] * 10.8;
						PlayerTextDrawTextSize(playerid, cuff_td_player[1][playerid], td_x, 7.0000);
						PlayerTextDrawHide(playerid, cuff_td_player[1][playerid]);
						PlayerTextDrawShow(playerid, cuff_td_player[1][playerid]);
					}
				}
				else if(key_action[playerid] == KEY_NO)
				{
					if(newkeys & KEY_NO)
					{
						switch(random(2))
						{
						case 0: key_action[playerid] = KEY_YES, PlayerTextDrawSetString(playerid, cuff_td_player[0][playerid], "Y");
						case 1: key_action[playerid] = KEY_NO, PlayerTextDrawSetString(playerid, cuff_td_player[0][playerid], "N");
						}
						position_action[playerid] ++;
