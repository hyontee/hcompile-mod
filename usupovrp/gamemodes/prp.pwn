DLG(2200, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(null(inputtext))return SendClientMessage(playerid,COLOR_GREY,"Вы ничего не ввели!");
		new patr = strval(inputtext);
		if(patr < 1 || patr > 60) return SendClientMessage(playerid, -1, ""cER"Число может быть не больше 60");
		new slot=PlayerUseList[playerid][MAX_LIST];
		switch(PlayerItem1[playerid][slot])
		{
		case 19..35:
			{
				new ok = SearchInventoryItem(playerid, 42);
				if(!ok) return SendErr(playerid, "У вас нет патронов");
				if(PlayerItem2[playerid][ok]< patr) return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько патронов");
				switch(PlayerItem1[playerid][slot])
				{
				case 19:GivePlayerWeapon(playerid,22,patr);
				case 20:GivePlayerWeapon(playerid,23,patr);
				case 21:GivePlayerWeapon(playerid,24,patr);
				case 22:GivePlayerWeapon(playerid,25,patr);
				case 23:GivePlayerWeapon(playerid,26,patr);
				case 24:GivePlayerWeapon(playerid,27,patr);
				case 25:GivePlayerWeapon(playerid,28,patr);
				case 26:GivePlayerWeapon(playerid,29,patr);
				case 27:GivePlayerWeapon(playerid,30,patr);
				case 28:GivePlayerWeapon(playerid,31,patr);
				case 29:GivePlayerWeapon(playerid,32,patr);
				case 30:GivePlayerWeapon(playerid,33,patr);
				case 31:GivePlayerWeapon(playerid,34,patr);
				case 32:GivePlayerWeapon(playerid,34,patr);
				case 33:GivePlayerWeapon(playerid,34,patr);
				case 35:GivePlayerWeapon(playerid,34,patr);
				}
				if(PlayerItem2[playerid][ok] == 0) PlayerItem1[playerid][ok]=0;
				PlayerItem2[playerid][ok] -= patr;
				SaveItem(playerid,ok);
			}
		}
		UpDateInv(playerid);
	}
	return 1;
}
DLG(2201, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(null(inputtext)) return SendClientMessage(playerid,COLOR_GREY,"Вы ничего не ввели!");
		if(strval(inputtext) < 1 || strval(inputtext) > 1000000) return SendClientMessage(playerid, -1, ""cER"Число может быть не больше 1000000");
		new s = PlayerUseList[playerid][MAX_LIST];
		new kolv = 0;
		if(PlayerItem2[playerid][s] <= strval(inputtext)) kolv = PlayerItem2[playerid][s];
		else if(PlayerItem2[playerid][s] >= strval(inputtext)) kolv = strval(inputtext);
		PlayerItem2[playerid][s] -= kolv;
		SaveItem(playerid,s);
		UpDateInv(playerid);
		SendClientMessage(playerid,COLOR_WHITE,""cDA"Вы успешно удалили предмет из инвентаря");
	}
	return 1;
}
DLG(2202, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(listitem <= -1) return SendClientMessage(playerid,COLOR_RED,"Произошла ошибка");
		new list;
		PlayerUseList[playerid][MAX_LIST] = list = PlayerUseList[playerid][listitem];
		if(list == -1) return SendClientMessage(playerid,COLOR_RED,"Произошла ошибка");
		if(PlayerItem1[playerid][list] == -1)  return SendClientMessage(playerid,COLOR_RED,"Произошла ошибка");

		new id = PlayerItem1[playerid][list];
		if(IsPlayerInRangeOfPoint(playerid,3.0,2450.1392,-1903.5297,21.9619))
		{
			format(stringer1, sizeof(stringer1), ""cWH"Вы желаете продать в ломбард "cMain"'%s'"cWH" за {63BD4E}%dр", Item[id][iName], Item[id][iLom]);
			ShowPlayerDialog(playerid, 2200+14, DIALOG_STYLE_MSGBOX, ""cMain"Ломбард", stringer1, "Продать", "Отмена");
		}
		else
		{
			stringer1 = "Предмет: ";
			strcat(stringer1, Item[id][iName]);
			ShowPlayerDialog(playerid, 2200+3, DIALOG_STYLE_LIST, stringer1, "- Использовать предмет\n- Передать предмет игроку\n- Удалить предмет", "Выбрать", "Выйти");
		}
	}
	return 1;
}
DLG(2203, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
		{
		case 0:{OnPlayerUseItem(playerid,PlayerUseList[playerid][MAX_LIST]);}
		case 1:
			{
				if(CheckUseGun(playerid,PlayerItem1[playerid][PlayerUseList[playerid][MAX_LIST]])==1){return true;}
				ShowPlayerDialog(playerid,2200+5,DIALOG_STYLE_INPUT,""cMain"Передача предмета",""cWH"Введите ид игрока,\nКоторому Вы хотите передать предмет!","Дальше","Выйти");
			}
		case 2:
			{
				new id = PlayerItem1[playerid][PlayerUseList[playerid][MAX_LIST]];
				if(CheckUseGun(playerid,PlayerItem1[playerid][PlayerUseList[playerid][MAX_LIST]])==1){return true;}
				new s = PlayerUseList[playerid][MAX_LIST];
				switch(Item[id][iStek])
				{
				case 0:
					{
						if(id == 47)
						{
							if(Mobile[playerid] != -1) MobileCrash(playerid);
							PI[playerid][pPhoneNumber] = 0;
							format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET phonenumber=0 WHERE id=%d", PI[playerid][pID]);
							mysql_tquery(db_prod, stringer1, "", "");
							Phone[playerid] = false;
							SendClientMessage(playerid, -1, "Телефон отключен, сим-карта уничтожена");
						}
						PlayerItem2[playerid][s]=0;
						SaveItem(playerid,s);
						UpDateInv(playerid);
						SendClientMessage(playerid,COLOR_WHITE,""cDA"Вы успешно удалили предмет из инвентаря");
					}
				default:ShowPlayerDialog(playerid,2200+1,DIALOG_STYLE_INPUT,""cMain"Удалить предмет",""cWH"Введите сумму предметов,\nКоторую Вы хотите удалить:","Дальше","Выйти");
				}
			}
		case 3:
			{
				new id = PlayerItem1[playerid][PlayerUseList[playerid][MAX_LIST]];
				if(CheckUseGun(playerid,PlayerItem1[playerid][PlayerUseList[playerid][MAX_LIST]])==1){return true;}
				new s = PlayerUseList[playerid][MAX_LIST];
				switch(Item[id][iStek])
				{
				case 0:
					{
						PlayerItem2[playerid][s]=0;
						SaveItem(playerid,s);
						UpDateInv(playerid);
						SetPlayerMoney(playerid, Item[id][iLom]);
						format(string, sizeof(string), "%s продал в ломбард '%s'", GetName(playerid),Item[id][iName]);
						ProxDetector(15, playerid, string, COLOR_PURPLE);
						SendMes(playerid,-1, ""cDA"Вы успешно продали предмет за '%dр'",Item[id][iLom]);
					}
				default:ShowPlayerDialog(playerid,2200+13,DIALOG_STYLE_INPUT,"Ломбард","Введите сумму предметов,\nКоторую Вы хотите продать!","Дальше","Выйти");
				}
			}
		}
	}
	return 1;
}
DLG(2205, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(null(inputtext)) return SendClientMessage(playerid,COLOR_GREY,"Вы ничего не ввели!");
		if(!IsPlayerConnected(strval(inputtext))) return SendClientMessage(playerid, -1, PlayerIsNotOnline);

		if(PI[ strval(inputtext) ][pLevel] == BONUS_LVL && PI[ strval(inputtext) ][pExp] < 12)
			return SendClientMessage(playerid, COLOR_RED, "Игроку нужно отыграть 12 часов для совершения обмена");

		new Float:p[3];
		GetPlayerPos(strval(inputtext),p[0],p[1],p[2]);
		if(!IsPlayerInRangeOfPoint(playerid,3,p[0],p[1],p[2]))return SendClientMessage(playerid,COLOR_GREY,"Игрок не рядом с вами!");
		GivePlayer[playerid][0]=strval(inputtext);
		new id = PlayerItem1[playerid][PlayerUseList[playerid][MAX_LIST]];
		new s=PlayerUseList[playerid][MAX_LIST];
		GivePlayer[playerid][4]=s;
		switch(Item[id][iStek])
		{
		case 0:
			{
				GivePlayer[playerid][1]=PlayerItem2[playerid][s];
				ShowPlayerDialog(playerid,2200+7,DIALOG_STYLE_INPUT,""cMain"Передача предмета",""cWH"Введите точную сумму денег\nЗа которую Вы хотите продать предмет.","Дальше","Выйти");
			}
		default:ShowPlayerDialog(playerid,2200+6,DIALOG_STYLE_INPUT,""cMain"Передача предмета",""cWH"Введите точное количество предметов\nКоторое Вы хотите продать игроку!","Дальше","Выйти");
		}
	}
	return 1;
}
DLG(2206, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(null(inputtext))return SendClientMessage(playerid,COLOR_GREY,"Вы ничего не ввели!");
		if(strval(inputtext) < 0 || strval(inputtext) > 1000000) return SendClientMessage(playerid, -1, ""cER"Число может быть не больше 1000000");
		new s = PlayerUseList[playerid][MAX_LIST];
		if(PlayerItem2[playerid][s] < strval(inputtext))return SendClientMessage(playerid,COLOR_GREY,"У вас нет столько предметов!");
		GivePlayer[playerid][1] = strval(inputtext);
		ShowPlayerDialog(playerid,2200+7,DIALOG_STYLE_INPUT,""cMain"Передача предмета",""cWH"Введите точную сумму денег\nЗа которую Вы хотите продать предмет.","Дальше","Выйти");
	}
	return 1;
}
