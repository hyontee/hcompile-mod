	return true;
}


ClearPlayerFreeTune(playerid, CAR_MODE)
{
	new
		c1,
		c2,
		paint_job,
		tune[14],
		tune_string[64],
		query[256];

	new vehicleid = GetPlayerVehicleID(playerid);

	if(GetPlayerVehicle(playerid))
	{
		format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", GetPlayerVehicleSqlID(playerid));
		new Cache:result = mysql_query(db_prod, query);
		new rows = cache_num_rows();
		if(rows > 0)
		{
			c1 = cache_get_field_content_int(0, "c_color1");
			c2 = cache_get_field_content_int(0, "c_color2");
			paint_job = cache_get_field_content_int(0, "c_paintjob");
			cache_get_field_content(0, "c_vehcom", tune_string, db_prod, 64);
			sscanf(tune_string, "p<,>a<i>[14]", tune);
		}
		cache_delete(result);
	}

	if(CAR_MODE == CARMODTYPE_REAR_BUMPER)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][ZBUMPER][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_FRONT_BUMPER)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][PBUMPER][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_EXHAUST)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][EXHAUST][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_SIDESKIRT)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][SIDESKIRT][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_SPOILER)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][SPOILER][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_PAINTJOB)
	{
		if(paint_job != 3) ChangeVehiclePaintjob(GetPlayerVehicleID(playerid),paint_job);
		else
		{
			ChangeVehiclePaintjob(GetPlayerVehicleID(playerid), 3);
			ChangeVehicleColor(GetPlayerVehicleID(playerid), c1, c2);
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_NITRO)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), g_nitro[PlayerIDMode[playerid]][D_ID]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_WHEELS)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), g_disk[PlayerIDMode[playerid]][D_ID]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}

	switch(CAR_MODE)
	{
		case CAR_MODE_TYPE_NEON:
		{
			EnableVehicleNeon
			(
				playerid,
				vehicleid,
				GetVehicleTuning(vehicleid, VT_NEON_COLOR_R),
				GetVehicleTuning(vehicleid, VT_NEON_COLOR_G),
				GetVehicleTuning(vehicleid, VT_NEON_COLOR_B),
				100
			);

			SetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_R, 0);
			SetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_G, 0);
			SetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_B, 0);
		}

		case CAR_MODE_TYPE_LIGHTS:
		{
			EnableVehicleLights(playerid, vehicleid, GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_R), GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_G), GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_B));

			SetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_R, 100);
			SetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_G, 100);
			SetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_B, 100);
		}

		case CAR_MODE_TYPE_TINING:
		{
			EnableVehicleTining
			(
				playerid,
				vehicleid,
				1,
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
				GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
			);

			EnableVehicleTining
			(
				playerid,
				vehicleid,
				2,
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
				GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
			);

			EnableVehicleTining
			(
				playerid,
				vehicleid,
				3,
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
				GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
			);

			EnableVehicleTining
			(
				playerid,
				vehicleid,
				0,
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
				GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
			);

			SetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_R, 0);
			SetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_G, 0);
			SetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_B, 0);
		}

		case CAR_MODE_TYPE_COLOR:
		{
			SetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_R, 255);
			SetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_G, 255);
			SetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_B, 255);

			//printf("[debug] tuning -> CAR_MODE_TYPE_COLOR -> VT_MAIN_COLOR_R: %d VT_MAIN_COLOR_G: %d VT_MAIN_COLOR_B: %d", GetVehicleTuning(vehicleid, VT_MAIN_COLOR_R), GetVehicleTuning(vehicleid, VT_MAIN_COLOR_G), GetVehicleTuning(vehicleid, VT_MAIN_COLOR_B));

			EnableVehicleColor(playerid, vehicleid, GetVehicleTuning(vehicleid, VT_MAIN_COLOR_R), GetVehicleTuning(vehicleid, VT_MAIN_COLOR_G), GetVehicleTuning(vehicleid, VT_MAIN_COLOR_B));
		}
	}

	return 0x1;
}

stock GetPlayerCostTune(playerid, CAR_MODE, COST_BIZZ)
{
	new REASON_COST;
	switch(CAR_MODE)
	{
		case CARMODTYPE_SPOILER:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_SPOILER)  * COST_BIZZ;
		}
		case CARMODTYPE_SIDESKIRT:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_SIDESKIRT)  * COST_BIZZ;
		}
		case CARMODTYPE_EXHAUST:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_EXHAUST)  * COST_BIZZ;
		}
		case CARMODTYPE_FRONT_BUMPER:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_PBUMPER)  * COST_BIZZ;
		}
		case CARMODTYPE_REAR_BUMPER:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_ZBUMPER)  * COST_BIZZ;
		}
	}
	return REASON_COST;
}
BuyTuneCarMode(playerid, CAR_MODE)
{
	new bizz_id = CTObizzid[playerid];
	new COST_BIZZ = BizzInfo[bizz_id][bTill];

	new vehicleid = GetPlayerVehicleID(playerid);

	if(CAR_MODE == CARMODTYPE_REAR_BUMPER)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_REAR_BUMPER, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"Вы купили эту запчасть");
	}
	if(CAR_MODE == CARMODTYPE_FRONT_BUMPER)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_FRONT_BUMPER, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"Вы купили эту запчасть");
	}
	if(CAR_MODE == CARMODTYPE_EXHAUST)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_EXHAUST, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"Вы купили эту запчасть");
	}
	if(CAR_MODE == CARMODTYPE_SIDESKIRT)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_SIDESKIRT, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"Вы купили эту запчасть");
	}
	if(CAR_MODE == CARMODTYPE_SPOILER)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_SPOILER, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}

		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"Вы купили эту запчасть");
	}
	if(CAR_MODE == CARMODTYPE_NITRO)
	{
		new i = PlayerIDMode[playerid];
		if(GetPlayerRubble(playerid) < g_nitro[i][D_PRICE] * COST_BIZZ) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

		SetPlayerMoney(playerid, -(g_nitro[i][D_PRICE] * COST_BIZZ), 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzInfo[bizz_id][bProduct] -= 50;
			BizzPay[i] += g_paintjob[i][D_PRICE] * COST_BIZZ;
			BizzInfo[bizz_id][bMoney] += g_nitro[i][D_PRICE] * COST_BIZZ;
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"Вы купили эту запчасть");
	}
	if(CAR_MODE == CARMODTYPE_PAINTJOB)
	{
		new i = PlayerIDMode[playerid];
		if(GetPlayerRubble(playerid) < g_paintjob[i][D_PRICE] * COST_BIZZ) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

		if(GetPlayerVehicle(playerid))
		{
			SetPlayerMoney(playerid, -(g_paintjob[i][D_PRICE] * COST_BIZZ), 1);
			if(BizzInfo[i][bProduct] > 0)
			{
				BizzInfo[i][bProduct] -= 50;
				BizzPay[i] += g_paintjob[i][D_PRICE] * COST_BIZZ;
				BizzInfo[i][bMoney] += g_paintjob[i][D_PRICE] * COST_BIZZ;
				MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
				MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
			}
			SendMes(playerid,COLOR_GREEN,"Вы оплатили %d руб за покрасочную работу", g_paintjob[i][D_PRICE] * COST_BIZZ);

			format(stringer1, 128, "UPDATE `ownable_cars` SET c_paintjob = '%i' WHERE c_owner = '%s' AND id = '%d'", g_paintjob[i][D_ID], GetName(playerid), GetPlayerVehicleSqlID(playerid));
			mysql_tquery(db_prod, stringer1, "", "");
		}
	}
	if(CAR_MODE == CARMODTYPE_WHEELS)
	{
		new i = PlayerIDMode[playerid];
		if(GetPlayerRubble(playerid) < g_disk[i][D_PRICE] * COST_BIZZ) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

		SetPlayerMoney(playerid, -(g_disk[i][D_PRICE] * COST_BIZZ), 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += g_disk[i][D_PRICE] * COST_BIZZ;
			BizzInfo[bizz_id][bProduct] -= 50;
			BizzInfo[bizz_id][bMoney] += g_disk[i][D_PRICE] * COST_BIZZ;
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"Вы купили эту запчасть");
	}

	switch(CAR_MODE)
	{
		case CAR_MODE_TYPE_NEON:
		{
			new i = PlayerIDMode[playerid];
			new price = NEON_PRICE;

			if(PI[playerid][pPerfectCoins] < price)
				return SendClientMessage(playerid, -1, ""cER"Недостаточно Perfect Coins! Пополнить счет: {ffffff}kaif-crmp.com/donate");

			PI[playerid][pPerfectCoins] -= price;
			UpdatePlayerData(playerid, "credits", PI[playerid][pPerfectCoins]);

			if(BizzInfo[i][bProduct] > 0)
			{
				BizzPay[bizz_id] += ((price / 100) * 25);

				BizzInfo[bizz_id][bProduct] -= 250;
				BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);

				MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
				MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
			}

			SendClientMessage(playerid,-1, ""cDA"Вы успешно купили неоновую подсветку");

			SetVehicleTuning(vehicleid, VT_NEON_COLOR_R, GetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_R));
			SetVehicleTuning(vehicleid, VT_NEON_COLOR_G, GetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_G));
			SetVehicleTuning(vehicleid, VT_NEON_COLOR_B, GetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_B));

			SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		}

		case CAR_MODE_TYPE_LIGHTS:
		{
			new i = PlayerIDMode[playerid];
			new price = LIGHTS_PRICE;

			if(PI[playerid][pPerfectCoins] < price)
				return SendClientMessage(playerid, -1, ""cER"Недостаточно Perfect Coins! Пополнить счет: {ffffff}kaif-crmp.com/donate");

			PI[playerid][pPerfectCoins] -= price;
			UpdatePlayerData(playerid, "credits", PI[playerid][pPerfectCoins]);

			if(BizzInfo[i][bProduct] > 0)
			{
				BizzPay[bizz_id] += ((price / 100) * 25);

				BizzInfo[bizz_id][bProduct] -= 250;
				BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);

				MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
				MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
			}

			SendClientMessage(playerid,-1, ""cDA"Вы успешно купили изменение цвета фар");

			SetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_R, GetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_R));
			SetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_G, GetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_G));
			SetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_B, GetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_B));

			SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		}

		case CAR_MODE_TYPE_TINING:
		{
			new i = PlayerIDMode[playerid];
			new price = TINING_PRICE;

			if(GetPlayerRubble(playerid) < price)
				return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

			SetPlayerMoney(playerid, -price, 1);

			if(BizzInfo[i][bProduct] > 0)
			{
				BizzPay[bizz_id] += ((price / 100) * 45);

				BizzInfo[bizz_id][bProduct] -= 250;
				BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);

				MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
				MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
			}

			SendClientMessage(playerid,-1, ""cDA"Вы успешно купили тонировку");

			SetVehicleTuning(vehicleid, VT_TINING_COLOR_R, GetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_R));
			SetVehicleTuning(vehicleid, VT_TINING_COLOR_G, GetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_G));
			SetVehicleTuning(vehicleid, VT_TINING_COLOR_B, GetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_B));
			SetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT, GetVehicleTuningTemp(vehicleid, VT_TINING_TRANSPARENT));

			SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		}

		case CAR_MODE_TYPE_COLOR:
		{
			new i = PlayerIDMode[playerid];
			new price = COLOR_PRICE;

			if(GetPlayerRubble(playerid) < price)
				return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");

			SetPlayerMoney(playerid, -price, 1);

			if(BizzInfo[i][bProduct] > 0)
			{
				BizzPay[bizz_id] += ((price / 100) * 25);

				BizzInfo[bizz_id][bProduct] -= 250;
				BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);

				MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
				MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
			}

			SendClientMessage(playerid,-1, ""cDA"Вы успешно купили RGB цвет автомобиля");

			SetVehicleTuning(vehicleid, VT_MAIN_COLOR_R, GetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_R));
			SetVehicleTuning(vehicleid, VT_MAIN_COLOR_G, GetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_G));
			SetVehicleTuning(vehicleid, VT_MAIN_COLOR_B, GetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_B));

			SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		}
	}

	return 0x1;
}

ShowPlayerTuneDraw(playerid, CAR_MODE)
{
	new string_td[100];
	PlayerIDMode[playerid] = 0;
	PlayerCarMode[playerid] = CAR_MODE;
	new vehicleid = GetPlayerVehicleID(playerid);
	new COST_BIZZ = BizzInfo[CTObizzid[playerid]][bTill];

	if(CAR_MODE == CARMODTYPE_REAR_BUMPER)
	{
		GetTypeModelComponent(playerid, GetVehicleModel(vehicleid), CARMODTYPE_REAR_BUMPER);
		if(TUNING_DATA[playerid][ZBUMPER_COUNT] == -1) return SendClientMessage(playerid, -1, ""cER"На вашу модель транспорта нет данных деталей");

		format(string_td, sizeof(string_td), "%s", GetNameComponent(playerid, TUNING_DATA[playerid][ZBUMPER][0]));
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		new price = GetPlayerCostTune(playerid, CARMODTYPE_REAR_BUMPER, COST_BIZZ);
		format(string_td, sizeof(string_td), "%d рублей", price);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		AddVehicleComponent(vehicleid, TUNING_DATA[playerid][ZBUMPER][PlayerIDMode[playerid]]);

		for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_FRONT_BUMPER)
	{
		GetTypeModelComponent(playerid, GetVehicleModel(vehicleid), CARMODTYPE_FRONT_BUMPER);
		if(TUNING_DATA[playerid][PBUMPER_COUNT] == -1) return SendClientMessage(playerid, -1, ""cER"На вашу модель транспорта нет данных деталей");

		format(string_td, sizeof(string_td), "%s", GetNameComponent(playerid, TUNING_DATA[playerid][PBUMPER][0]));
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		new price = GetPlayerCostTune(playerid, CARMODTYPE_REAR_BUMPER, COST_BIZZ);
		format(string_td, sizeof(string_td), "%d рублей", price);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		AddVehicleComponent(vehicleid, TUNING_DATA[playerid][PBUMPER][PlayerIDMode[playerid]]);

		for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_EXHAUST)
	{
		GetTypeModelComponent(playerid, GetVehicleModel(vehicleid), CARMODTYPE_EXHAUST);
		if(TUNING_DATA[playerid][EXHAUST_COUNT] == -1) return SendClientMessage(playerid, -1, ""cER"На вашу модель транспорта нет данных деталей");

		format(string_td, sizeof(string_td), "%s", GetNameComponent(playerid, TUNING_DATA[playerid][EXHAUST][0]));
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		new price = GetPlayerCostTune(playerid, CARMODTYPE_EXHAUST, COST_BIZZ);
		format(string_td, sizeof(string_td), "%d рублей", price);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		AddVehicleComponent(vehicleid, TUNING_DATA[playerid][EXHAUST][PlayerIDMode[playerid]]);

		for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_SIDESKIRT)
	{
		GetTypeModelComponent(playerid, GetVehicleModel(vehicleid), CARMODTYPE_SIDESKIRT);
		if(TUNING_DATA[playerid][SIDESKIRT_COUNT] == -1) return SendClientMessage(playerid, -1, ""cER"На вашу модель транспорта нет данных деталей");
		if(GetVehicleModel(vehicleid) == 560 && C_DATA[playerid][c_vehcoms][6] == 0) SendClientMessage(playerid, -1, ""cDA"На данный модели возможно дополнительное изменение порога, после установки выхлопной системы.");

		format(string_td, sizeof(string_td), "%s", GetNameComponent(playerid, TUNING_DATA[playerid][SIDESKIRT][0]));
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		new price = GetPlayerCostTune(playerid, CARMODTYPE_SIDESKIRT, COST_BIZZ);
		format(string_td, sizeof(string_td), "%d рублей", price);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		AddVehicleComponent(vehicleid, TUNING_DATA[playerid][SIDESKIRT][PlayerIDMode[playerid]]);

		for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_SPOILER)
	{
		GetTypeModelComponent(playerid, GetVehicleModel(vehicleid), CARMODTYPE_SPOILER);
		if(TUNING_DATA[playerid][SPOILER_COUNT] == -1) return SendClientMessage(playerid, -1, ""cER"На вашу модель транспорта нет данных деталей");

		format(string_td, sizeof(string_td), "%s", GetNameComponent(playerid, TUNING_DATA[playerid][SPOILER][0]));
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		new price = GetPlayerCostTune(playerid, CARMODTYPE_SPOILER, COST_BIZZ);
		format(string_td, sizeof(string_td), "%d рублей", price);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		AddVehicleComponent(vehicleid, TUNING_DATA[playerid][SPOILER][PlayerIDMode[playerid]]);

		for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_PAINTJOB)
	{
		format(string_td, sizeof(string_td), "%s", g_paintjob[0][D_NAME]);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		format(string_td, sizeof(string_td), "%d рублей", g_paintjob[0][D_PRICE] * COST_BIZZ);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		ChangeVehiclePaintjob(vehicleid,  g_paintjob[0][D_ID]);

		for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_NITRO)
	{
		format(string_td, sizeof(string_td), "%s", g_nitro[0][D_NAME]);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		format(string_td, sizeof(string_td), "%d рублей", g_nitro[0][D_PRICE] * COST_BIZZ);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		AddVehicleComponent(vehicleid, g_nitro[0][D_ID]);

		for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_WHEELS)
	{
		format(string_td, sizeof(string_td), "%s", g_disk[0][D_NAME]);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		format(string_td, sizeof(string_td), "%d рублей", g_disk[0][D_PRICE] * COST_BIZZ);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		AddVehicleComponent(vehicleid, g_disk[0][D_ID]);

		for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
	}

	switch(CAR_MODE)
	{
		case CAR_MODE_TYPE_NEON:
		{
			format(string_td, sizeof(string_td), "Неоновая подсветка");
			PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

			format(string_td, sizeof(string_td), "%d Perfect Coins", NEON_PRICE);
			PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

			for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
			for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
		}

		case CAR_MODE_TYPE_LIGHTS:
		{
			format(string_td, sizeof(string_td), "Изменение цвета фар");
			PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

			format(string_td, sizeof(string_td), "%d Perfect Coins", LIGHTS_PRICE);
			PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

			for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
			for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
		}

		case CAR_MODE_TYPE_TINING:
		{
			format(string_td, sizeof(string_td), "Тонировка стекол");
			PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

			format(string_td, sizeof(string_td), "%d рублей", TINING_PRICE);
			PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

			for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
			for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
		}

		case CAR_MODE_TYPE_COLOR:
		{
			format(string_td, sizeof(string_td), "RGB цвет автомобиля");
			PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

			format(string_td, sizeof(string_td), "%d рублей", COLOR_PRICE);
			PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

			for(new i = 0; i != 11; i ++) TextDrawShowForPlayer(playerid, sto_td_global[i]);
			for(new i = 0; i != 2; i ++) PlayerTextDrawShow(playerid, sto_td_player[playerid][i]);
		}
	}

	return 0x1;
}



NextPlayerTuneDraw(playerid, CAR_MODE)
{
	new string_td[100];
	PlayerIDMode[playerid] += 1;
	new vehicleid = GetPlayerVehicleID(playerid);
	new COST_BIZZ = BizzInfo[CTObizzid[playerid]][bTill];

	if(CAR_MODE == CARMODTYPE_REAR_BUMPER)
	{
		if(PlayerIDMode[playerid] > TUNING_DATA[playerid][ZBUMPER_COUNT]) PlayerIDMode[playerid] = 0;

		format(string_td, sizeof(string_td), "%s", GetNameComponent(playerid, TUNING_DATA[playerid][ZBUMPER][PlayerIDMode[playerid]]));
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		new price = GetPlayerCostTune(playerid, CARMODTYPE_REAR_BUMPER, COST_BIZZ);
		format(string_td, sizeof(string_td), "%d рублей", price);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

		AddVehicleComponent(vehicleid, TUNING_DATA[playerid][ZBUMPER][PlayerIDMode[playerid]]);
		return 0x1;
	}
	if(CAR_MODE == CARMODTYPE_FRONT_BUMPER)
	{
		if(PlayerIDMode[playerid] > TUNING_DATA[playerid][PBUMPER_COUNT]) PlayerIDMode[playerid] = 0;

		format(string_td, sizeof(string_td), "%s", GetNameComponent(playerid, TUNING_DATA[playerid][PBUMPER][PlayerIDMode[playerid]]));
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		new price = GetPlayerCostTune(playerid, CARMODTYPE_FRONT_BUMPER, COST_BIZZ);
		format(string_td, sizeof(string_td), "%d рублей", price);
