}
DLG(9946, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new vehid = GetPlayerVehicleID(playerid);
	if(!vehid) return 1;
	if(vBoomBoxArea[vehid])
	{
		IteratePlayer(otherid) if(IsPlayerInDynamicArea(otherid, vBoomBoxArea[vehid])) { StopAudioStreamForPlayer(otherid); }
		DestroyDynamicArea(vBoomBoxArea[vehid]);
		vBoomBoxStati[vehid] = "";
		vBoomBoxArea[vehid] = 0;
	}
	switch(listitem)
	{
	case 0: vBoomBoxStati[vehid] = "http://air.radiorecord.ru:8102/club_128";
	case 1: vBoomBoxStati[vehid] = "http://air.radiorecord.ru:8102/rus_320";
	case 2: vBoomBoxStati[vehid] = "http://air.radiorecord.ru:8102/dub_320";
	case 3: vBoomBoxStati[vehid] = "http://air.radiorecord.ru:8102/yo_320";
	case 4: vBoomBoxStati[vehid] = "http://air.radiorecord.ru:8102/teo_320";
	case 5:
		{
			ShowPlayerDialog(playerid, 9947, DSI, ""cMain"Меню Music", ""cWH"Вставляйте ссылку на радио/песню", "Принять", "Назад");
			return 1;
		}
	case 6:
		{
			SendInf(playerid, "Вы выключили музыку в машине");
			return 1;
		}
	}
	new Float:pos_x, Float:pos_y, Float:pos_z;
	GetVehiclePos(vehid, pos_x, pos_y, pos_z);
	vBoomBoxArea[vehid] = CreateDynamicSphere(pos_x, pos_y, pos_z, 30.0, 0, 0);
	AttachDynamicAreaToVehicle(vBoomBoxArea[vehid], vehid, 0.0, 0.0, 0.0);
	SendInf(playerid, "Вы включили музыку в машине");
	return 1;
}
DLG(9947, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new vehid = GetPlayerVehicleID(playerid);
	if(!vehid) return 1;
	if(null(inputtext))
	{
		ShowPlayerDialog(playerid, 9947, DSI, ""cMain"Меню Music", ""cWH"Вставляйте ссылку на радио/песню", "Принять", "Назад");
		return 1;
	}
	nstrmid(vBoomBoxStati[vehid], inputtext);
	new Float:pos_x, Float:pos_y, Float:pos_z;
	GetVehiclePos(vehid, pos_x, pos_y, pos_z);
	vBoomBoxArea[vehid] = CreateDynamicSphere(pos_x, pos_y, pos_z, 30.0, 0, 0);
	AttachDynamicAreaToVehicle(vBoomBoxArea[vehid], vehid, 0.0, 0.0, 0.0);
	return 1;
}
DLG(8572, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new targetid;
	if(sscanf(inputtext, "u", targetid))
	{
		SendErr(playerid, "Вы ввели неверный ID");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}
	if(!IsPlayerConnected(targetid))
	{
		SendErr(playerid, "Вы ввели неверный ID");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}
	if(PlayerLogged[targetid] == false)
	{
		SendErr(playerid, "Игрок не авторизован");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}
	if(PI[targetid][pLeader] > 0)
	{
		SendErr(playerid, "Игрок лидер другой организации");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}
	if(PI[targetid][pMember] != PI[playerid][pMember])
	{
		SendErr(playerid, "Игрок находиться в другой организации");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}
	if(PI[targetid][pRank] < 9)
	{
		SendErr(playerid, "Игрок не заместитель");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}
	if(PI[targetid][pMainSub])
	{
		SendErr(playerid, "Игрок уже главный заместитель");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}
	if(GetDistanceBetweenPlayers(playerid, targetid) > 8.0)
	{
		SendErr(playerid, "Игрок слишком далеко!");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}

	PI[targetid][pMainSub] = 1;
	SCMF(targetid, COLOR_LIME, "%s %s назначил Вас главным заместителем организации %s", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), Fraction_Name[PI[playerid][pMember]]);
	SCMF(playerid, COLOR_LIME, "Вы назначили %s главным заместителем организации %s", GetName(targetid), Fraction_Name[PI[playerid][pMember]]);
	MysqlUpdatePlayerInt(targetid, "mainsub", PI[targetid][pMainSub]);
	new ld = playerNameSubMain[playerid];
	IteratePlayer(id)
	{
		if(PlayerLogged[id] == false) continue;
		if(PI[id][pID] != ld) continue;
		PI[id][pMainSub] = 0;
		SendErr(id, "С Вас сняли полномочие главного заместителя");
		break;
	}
	format(stringer1, sizeof(stringer1), "UPDATE accounts SET mainsub=0 WHERE id=%i LIMIT 1", ld);
	mysql_tquery(db_prod, stringer1, "", "");
	return 1;
}
DLG(718, playerid, response, listitem, inputtext[])
{
	new warid = playerWantedID[playerid];
	if(!response || warid == -1) return 1;
	switch(listitem)
	{
	case 0:
		{
			ShowPlayerDialog(playerid, 719, DSL, ""cMain"Причинение физического вреда здоровью", ""cWH"1. Нападение на гражданское лицо\n2. Нападение на сотрудника полиции\n3. Нападение на сотрудника Администрации", "Выбрать", "Назад");
			return 1;
		}
	case 1:
		{
			ShowPlayerDialog(playerid, 720, DSL, ""cMain"Вооруженное нападение", ""cWH"1. Вооруженное нападение\n2. Убийство гражданского лица\n3. Убийство сотрудника полиции\n4. Убийство сотрудника МЧС", "Выбрать", "Назад");
			return 1;
		}
	case 2:
		{
			ShowPlayerDialog(playerid, 721, DSL, ""cMain"Угон транспортного средства", ""cWH"1. Угон транспортного средства\n2. Угон служебного транспорта", "Выбрать", "Назад");
			return 1;
		}
	case 3: SetWantedLvl(warid, playerid, 3, "Предложение/подкуп должностного лица");
	case 4:
		{
			ShowPlayerDialog(playerid, 722, DSL, ""cMain"Оружие", ""cWH"1. Продажа оружие\n2. Кража/ношение\n3. Ношение оружия в открытом виде (кроме гос.)\n4. Ношение оружия без лицензии", "Выбрать", "Назад");
			return 1;
		}
	case 5: SetWantedLvl(warid, playerid, 6, "Взятие в заложники");
	case 6: SetWantedLvl(warid, playerid, 2, "Неподчинение");
	case 7:
		{
			ShowPlayerDialog(playerid, 723, DSL, ""cMain"Проникновение на охраняемую территорию", ""cWH"1. Проникновение охр. органами правопорядка территорию\n2. Проникновение на территорию военных сил", "Выбрать", "Назад");
			return 1;
		}
	case 8:
		{
			ShowPlayerDialog(playerid, 724, DSL, ""cMain"Наркотики", ""cWH"1. Хранение/перевозка наркотиков\n2. Сбыт наркотиков в общественном месте\n3. Употребление наркотиков", "Выбрать", "Назад");
			return 1;
		}
	case 9: SetWantedLvl(warid, playerid, 2, "Отказ оплаты штрафа");
	case 10:
		{
			ShowPlayerDialog(playerid, 725, DSL, ""cMain"Мошенничество", ""cWH"1. Мошенничество, совершенное лицом\n2. Мошенничество, совершенное группой лиц\n3. Мошенничество, совершенное организованной группой", "Выбрать", "Назад");
			return 1;
		}
	}
	return 1;
}
