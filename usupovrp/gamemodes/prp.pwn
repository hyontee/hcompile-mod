DLG(150, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new	slen = strlen(inputtext);
	mfor(i, (slen - 1)) if('А' <= inputtext[i] <= 'Я' || 'а' <= inputtext[i] <= 'я' || inputtext[i] == ' ' || inputtext[i] == '=')
	{
		SendClientMessage(playerid, 0xFF6600FF, "Длина пароля должна быть от 3 до 16 символов");
		SendClientMessage(playerid, 0xFF6600FF, "Также не допускается использование пробелов");
		SendClientMessage(playerid, 0xFF6600FF, "Также не допускается использование русских символов");
		return ShowPlayerDialog(playerid, 131+19, 1, ""cMain"Смена пароля", ""cWH"Введите новый пароль:", "Принять", "Отмена");
	}
	if(!(3 <= slen <= 16))
	{
		SendClientMessage(playerid, 0xFF6600FF, "Длина пароля должна быть от 3 до 16 символов");
		SendClientMessage(playerid, 0xFF6600FF, "Также не допускается использование пробелов");
		SendClientMessage(playerid, 0xFF6600FF, "Также не допускается использование русских символов");
		return ShowPlayerDialog(playerid, 131+19, 1, ""cMain"Смена пароля", ""cWH"Введите новый пароль:", "Принять", "Отмена");
	}
	else
	{

		strmid(PI[playerid][pPassword], inputtext, 0, strlen(inputtext), 32);

		SendMes(playerid, COLOR_LIGHTRED, "Ваш новый пароль: "cWH"'%s' (без кавычек)", inputtext);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Рекомендуется сделать скриншот. Клавиша: "cWH"F8");
		MysqlUpdatePlayerStr(playerid, "password", PI[playerid][pPassword]);

	}
	return 1;
}
DLG(153, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(GetPlayerVehicle(playerid))
	{
		new
			id = GetPlayerVehicleSqlID(playerid);

		new
			sell_price,
			model,
			number_plate[32],
			query[256];

		format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", id);
		new Cache:result = mysql_query(db_prod, query);
		new rows = cache_num_rows();
		if(rows > 0)
		{
			cache_get_field_content(0, "c_number", number_plate, db_prod, 32);
			sell_price = cache_get_field_content_int(0, "c_price");
			model = cache_get_field_content_int(0, "c_model");
		}
		cache_delete(result);

		SendMes(playerid, COLOR_GREEN, "Вы успешно продали автомобиль государству. На Ваш счет зачислено: %d рублей", sell_price/2);
		fLogs("[cars] %s -%i /sellcar гос", GetName(playerid), model);
		SetPlayerMoney(playerid, sell_price/2);

		mysql_format(db_prod, stringer1, 128, "UPDATE `ownable_numbers` SET `is_used` = '0' WHERE number = '%s'", number_plate);
		mysql_tquery(db_prod, stringer1, "", "");

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `ownable_cars` WHERE `c_owner` = '%s' AND id = '%d' LIMIT 1", GetName(playerid), id);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");

		for(new i; i < MAX_LOAD_VEHICLE; i++)
		{
			if(PlayerVehicleSQL[playerid][i] == id)
			{
				DestroyVehicle(PlayerVehicle[playerid][i]);
				PlayerVehicle[playerid][i] = INVALID_PLAYER_VEHICLE;
				PlayerVehicleSQL[playerid][i] = INVALID_PLAYER_VEHICLE;
				break;
			}
		}
	}
	return 1;
}
