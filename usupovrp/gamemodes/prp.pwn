SaveGarageData(g)
{
	format(stringer,sizeof(stringer),"UPDATE `garages` SET `owner` = '%s', `owned` = %d, `update` = %d, `lock` = %d, `day` = %d WHERE `id`= %d", GarageInfo[g][g_OWNER], GarageInfo[g][g_OWNED], GarageInfo[g][g_UPDATE], GarageInfo[g][g_LOCK], GarageInfo[g][g_DAY], GarageInfo[g][g_ID]);
	mysql_function_query(db_prod, stringer, true, "", "");
	return true;
}
UpdateGarageData(g)
{

	new class_text[20];
	global_string = "";

	switch(GarageInfo[g][g_TYPE])
	{
	case 1: class_text = "Низкий";
	case 2: class_text = "Средний";
	case 3: class_text = "Высокий";
	}

	if(GarageInfo[g][g_OWNED] == -1)
	{
		format(global_string, 200, "{5AB4E4}- Гараж №%d -\n\n"cWH"Владелец: государство\nКласс: %s\nЦена: %d рублей\n\n{C9CBCC}/buygarage - купить гараж", g, class_text, GarageInfo[g][g_PRICE]);
		UpdateDynamic3DTextLabelText(GarageInfo[g][g_TEXT], -1, global_string);
	}
	else
	{
		format(global_string, 200, "{5AB4E4}- Гараж №%d -\n"cWH"Владелец: %s\n\n{C9CBCC}Меню гаража: /garage\n{C9CBCC}Попасть в гараж: ALT(пешком), H(за рулем)", g, GarageInfo[g][g_OWNER], class_text);
		UpdateDynamic3DTextLabelText(GarageInfo[g][g_TEXT], -1, global_string);
	}

	return true;
}
GaragePayment(g_type)
{

	new g_pay;

	switch(g_type)
	{

	case 1: g_pay = 500;
	case 2: g_pay = 1000;
	case 3: g_pay = 1500;

	}

	return g_pay;
}
cmd:setgaragepos(playerid, params[])
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted") || GetString(GetName(playerid), "Winston"))
	{
		new g = 0, Float:pos[3];
		new class_text[32];
		if(sscanf(params, "i", g))
		return SendClientMessage(playerid, -1, ""cPS"Используйте: /setgaragepos [ID]");

		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		GarageInfo[g][G_ENTER_X] = pos[0];
		GarageInfo[g][G_ENTER_Y] = pos[1];
		GarageInfo[g][G_ENTER_Z] = pos[2];

		global_string = "";
		mysql_format(db_prod, global_string, 200, "UPDATE `garages` SET enter_x = '%f', enter_y = '%f', enter_z = '%f' WHERE id = '%d'", pos[0], pos[1], pos[2], GarageInfo[g][g_ID]);
		mysql_tquery(db_prod, global_string, "", "");
		switch(GarageInfo[g][g_TYPE])
		{
		case 1: class_text = "Низкий";
		case 2: class_text = "Средний";
		case 3: class_text = "Премиум";
		}
		DestroyDynamic3DTextLabel(GarageInfo[g][g_TEXT]);
		if(GarageInfo[g][g_OWNED] == -1)
		{
			format(global_string, 200, "{5AB4E4}- Гараж №%d -\n\n"cWH"Владелец: государство\nКласс: %s\nЦена: %d рублей\n\n{C9CBCC}/buygarage - купить гараж", g, class_text, GarageInfo[g][g_PRICE]);
			GarageInfo[g][g_TEXT] = CreateDynamic3DTextLabel(global_string, 0xFFFFFFFF, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z], 5.0);
		}
		else
		{
			format(global_string, 200, "{5AB4E4}- Гараж №%d -\n"cWH"Владелец: %s\n\n{C9CBCC}Меню гаража: /garage\n{C9CBCC}Попасть в гараж: ALT(пешком), H(за рулем)", g, GarageInfo[g][g_OWNER]);
			GarageInfo[g][g_TEXT] = CreateDynamic3DTextLabel(global_string, 0xFFFFFFFF, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z], 5.0);
		}
		DestroyPickup(GarageInfo[g][g_PIC]);
		GarageInfo[g][g_PIC] = CreatePickup(1239, 23, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z]);
		PA_Garage_IDx[playerid] = g;
		SendClientMessage(playerid, COLOR_GREEN, "Гараж перенесен на новые координаты, теперь установить коорды выезда авто /ncgarage");
		fLogs("[admin] %s /setgaragepos %i", GetName(playerid), g);
	}
	return true;
}
cmd:ncgarage(playerid)
{
	if(!PA_Garage_IDx[playerid]) return SendClientMessage(playerid,-1,"Вы не изменяли позиции гаражей.");
	new Float:X, Float:Y, Float:Z, Float:A;
	GetPlayerPos(playerid, X, Y, Z);
	GetPlayerFacingAngle(playerid, A);

	if(garage_car[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(garage_car[playerid]), garage_car[playerid] = INVALID_VEHICLE_ID;
	garage_car[playerid] = CreateVehicle(466, X, Y, Z, A, -1, -1, 80000);
	PutPlayerInVehicle(playerid, garage_car[playerid], 0);
	SendClientMessage(playerid, COLOR_GREEN, "Теперь выберите место, где будет появляться машина после выезда из гаража, и введите /encgarage");
	return true;
}
cmd:encgarage(playerid)
{
	if(!PA_Garage_IDx[playerid]) return SendClientMessage(playerid,-1,"Вы не изменяли позиции гаражей.");
	new g = PA_Garage_IDx[playerid];
	new Float:carX, Float:carY, Float:carZ, Float:carA;
	GetVehiclePos(garage_car[playerid], carX, carY, carZ);
	GetVehicleZAngle(garage_car[playerid], carA);

	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleID(playerid) != garage_car[playerid])
	return SendClientMessage(playerid, COLOR_RED, "Вы должны быть в специально-созданном автомобиле для установки позиций");

	GarageInfo[g][g_ENTER_X_CAR] = carX;
	GarageInfo[g][g_ENTER_Y_CAR] = carY;
	GarageInfo[g][g_ENTER_Z_CAR] = carZ;
	GarageInfo[g][g_ENTER_A_CAR] = carA;

	if(garage_car[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(garage_car[playerid]), garage_car[playerid] = INVALID_VEHICLE_ID;
	global_string = "";
	mysql_format(db_prod, global_string, 200, "UPDATE `garages` SET enter_x_car = '%f', enter_y_car = '%f', enter_z_car = '%f', enter_a_car = '%f' WHERE id = '%d'", carX, carY, carZ, carA, GarageInfo[g][g_ID]);
	mysql_tquery(db_prod, global_string, "", "");
	PA_Garage_IDx[playerid] = -1;
	SCM(playerid,-1,"Позиции успешно изменены. Изменения сохранены.");
	return true;
}

callback::LoadGarages()
{
	new time = GetTickCount();

	global_string = "";

	new class_text[32], temp[20], rows, fields;
	cache_get_data(rows, fields);

	if(rows)
	{
		for(new g = 1; g <= rows; g++)
		{
			cache_get_field_content(g-1, "id", temp), GarageInfo[g][g_ID] = strval (temp);
			cache_get_field_content(g-1, "enter_x", temp), GarageInfo[g][G_ENTER_X] = floatstr (temp);
			cache_get_field_content(g-1, "enter_y", temp), GarageInfo[g][G_ENTER_Y] = floatstr (temp);
			cache_get_field_content(g-1, "enter_z", temp), GarageInfo[g][G_ENTER_Z] = floatstr (temp);
			cache_get_field_content(g-1, "enter_x_car", temp), GarageInfo[g][g_ENTER_X_CAR] = floatstr (temp);
			cache_get_field_content(g-1, "enter_y_car", temp), GarageInfo[g][g_ENTER_Y_CAR] = floatstr (temp);
			cache_get_field_content(g-1, "enter_z_car", temp), GarageInfo[g][g_ENTER_Z_CAR] = floatstr (temp);
			cache_get_field_content(g-1, "enter_a_car", temp), GarageInfo[g][g_ENTER_A_CAR] = floatstr (temp);
			cache_get_field_content(g-1, "exit_x", temp), GarageInfo[g][g_EXIT_X] = floatstr (temp);
			cache_get_field_content(g-1, "exit_y", temp), GarageInfo[g][g_EXIT_Y] = floatstr (temp);
			cache_get_field_content(g-1, "exit_z", temp), GarageInfo[g][g_EXIT_Z] = floatstr (temp);
			cache_get_field_content(g-1, "lock", temp), GarageInfo[g][g_LOCK] = strval (temp);
			cache_get_field_content(g-1, "type", temp), GarageInfo[g][g_TYPE] = strval (temp);
			cache_get_field_content(g-1, "owner", GarageInfo[g][g_OWNER], db_prod, MAX_PLAYER_NAME);
			cache_get_field_content(g-1, "owned", temp), GarageInfo[g][g_OWNED] = strval (temp);
			cache_get_field_content(g-1, "price", temp), GarageInfo[g][g_PRICE] = strval (temp);
			cache_get_field_content(g-1, "update", temp), GarageInfo[g][g_UPDATE] = strval (temp);
			cache_get_field_content(g-1, "int", temp), GarageInfo[g][g_INT] = strval (temp);
			cache_get_field_content(g-1, "world", temp), GarageInfo[g][g_WORLD] = strval (temp);
			cache_get_field_content(g-1, "day", temp), GarageInfo[g][g_DAY] = strval (temp);

			switch(GarageInfo[g][g_TYPE])
			{
			case 1: class_text = "Низкий";
			case 2: class_text = "Средний";
			case 3: class_text = "Премиум";
			}

			if(GarageInfo[g][g_OWNED] == -1)
			{
				format(global_string, 200, "{5AB4E4}- Гараж №%d -\n\n"cWH"Владелец: государство\nКласс: %s\nЦена: %d рублей\n\n{C9CBCC}/buygarage - купить гараж", TotalGarages+1, class_text, GarageInfo[g][g_PRICE]);
				GarageInfo[g][g_TEXT] = CreateDynamic3DTextLabel(global_string, 0xFFFFFFFF, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z], 5.0);
			}
			else
			{
				format(global_string, 200, "{5AB4E4}- Гараж №%d -\n"cWH"Владелец: %s\n\n{C9CBCC}Меню гаража: /garage\n{C9CBCC}Попасть в гараж: ALT(пешком), H(за рулем)", TotalGarages+1, GarageInfo[g][g_OWNER]);
				GarageInfo[g][g_TEXT] = CreateDynamic3DTextLabel(global_string, 0xFFFFFFFF, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z], 5.0);
			}
			GarageInfo[g][g_PIC] = CreatePickup(1239, 23, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z]);

			GarageInfo[g][g_LOCK] = 1;

			TotalGarages++;
		}
	}

	return printf("[Загружено гаражей]: <%d>. Потрачено: <%d ms>.", TotalGarages, GetTickCount()-time);
}
CreateGarage(playerid)
{

	new
Float:enter_x = GARAGE_X[playerid],
Float:enter_y = GARAGE_Y[playerid],
Float:enter_z = GARAGE_Z[playerid],

Float:enter_x_car = GARAGE_CAR_X[playerid],
Float:enter_y_car = GARAGE_CAR_Y[playerid],
Float:enter_z_car = GARAGE_CAR_Z[playerid],
Float:enter_a_car = GARAGE_CAR_A[playerid],

Float:exit_x = GARAGE_EXIT_X[playerid],
Float:exit_y = GARAGE_EXIT_Y[playerid],
Float:exit_z = GARAGE_EXIT_Z[playerid],

	garage_type = GARAGE_CLASS[playerid],
	garage_price = GARAGE_PRICE[playerid],

	class_text[32],

	g = TotalGarages
	;

	global_string = "";

	GarageInfo[g][G_ENTER_X] = enter_x;
	GarageInfo[g][G_ENTER_Y] = enter_y;
	GarageInfo[g][G_ENTER_Z] = enter_z;
	GarageInfo[g][g_ENTER_X_CAR] = enter_x_car;
	GarageInfo[g][g_ENTER_Y_CAR] = enter_y_car;
	GarageInfo[g][g_ENTER_Z_CAR] = enter_z_car;
	GarageInfo[g][g_ENTER_A_CAR] = enter_a_car;
	GarageInfo[g][g_EXIT_X] = exit_x;
	GarageInfo[g][g_EXIT_Y] = exit_y;
	GarageInfo[g][g_EXIT_Z] = exit_z;
	GarageInfo[g][g_TYPE] = garage_type;
	GarageInfo[g][g_LOCK] = 1;
	GarageInfo[g][g_OWNED] = -1;
	GarageInfo[g][g_PRICE] = garage_price;
	GarageInfo[g][g_INT] = GarageInfo[g][g_WORLD] = TotalGarages+1;
	strmid(GarageInfo[g][g_OWNER], "None", 0, strlen(GarageInfo[g][g_OWNER]), 24);

	switch(GarageInfo[g][g_TYPE])
	{
	case 1: class_text = "Низкий";
	case 2: class_text = "Средний";
	case 3: class_text = "Премиум";
	}

	format(global_string, 200, "{5AB4E4}- Гараж №%d -\n\n"cWH"Владелец: государство\nКласс: %s\nЦена: %d рублей\n\n{C9CBCC}/buygarage - купить гараж", TotalGarages + 1, class_text, GarageInfo[g][g_PRICE]);

	GarageInfo[g][g_TEXT] = CreateDynamic3DTextLabel(global_string, 0xFFFFFFFF, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z], 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1);
	GarageInfo[g][g_PIC] = CreatePickup(1239, 23, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z]);

	TotalGarages++;
	GarageInfo[g][g_ID] = TotalGarages;

	global_string = "";
	mysql_format(db_prod, global_string, 400, "\
	INSERT INTO `garages`\
	(`enter_x`, `enter_y`, `enter_z`,\
	`enter_x_car`, `enter_y_car`, `enter_z_car`, `enter_a_car`,\
	`exit_x`, `exit_y`, `exit_z`, `lock`,\
	`type`, `owner`, `owned`, `price`, `int`, `world`) VALUES \
	( '%f', '%f', '%f', \
	'%f', '%f', '%f', '%f',\
	'%f', '%f', '%f', '1',\
	'%d', '%s', '%d', '%d', '%d', '%d')",
	GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z],
	GarageInfo[g][g_ENTER_X_CAR], GarageInfo[g][g_ENTER_Y_CAR], GarageInfo[g][g_ENTER_Z_CAR], GarageInfo[g][g_ENTER_A_CAR],
	GarageInfo[g][g_EXIT_X], GarageInfo[g][g_EXIT_Y], GarageInfo[g][g_EXIT_Z],
	GarageInfo[g][g_TYPE], GarageInfo[g][g_OWNER], GarageInfo[g][g_OWNED], GarageInfo[g][g_PRICE],
	GarageInfo[g][g_INT], GarageInfo[g][g_WORLD]);
	mysql_function_query(db_prod, global_string, false, "", "");

	SetPlayerPos(playerid, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z]);
	CREATE_GARAGE[playerid] = 0;

	SendMes(playerid, COLOR_GREEN, "Гараж №%d успешно добавлен на сервер", TotalGarages);
	fLogs("[admin] %s /add гараж %i [%f %f %f]", GetName(playerid), TotalGarages, GarageInfo[g][G_ENTER_X], GarageInfo[g][G_ENTER_Y], GarageInfo[g][G_ENTER_Z]);
	return true;
}
ClearPlayerCar(playerid)
{
	C_DATA[playerid][c_x] = C_DATA[playerid][c_y] = C_DATA[playerid][c_z] = C_DATA[playerid][c_a] = 0;
	C_DATA[playerid][c_world] = 0;
	C_DATA[playerid][c_fuel] = 45;
	SendClientMessage(playerid, COLOR_RED, "Так как Ваш автомобиль был припаркован в гараже, он был перепаркован");
	SavePlayerCar(playerid);
	return true;
}

public OnQueryError(errorid, error[], callback[], query[], connectionHandle)
{
	printf("[MYSQL PLUGIN] %d, %s, %s, %s, %d", errorid, error, callback, query, connectionHandle);
	switch(errorid)
	{
	case CR_SERVER_GONE_ERROR:
		{
			printf("[MYSQL PLUGIN] Потеря соединения с MySQL, перезагрузка...");
			mysql_reconnect(db_prod);
			new stats[100];
			mysql_stat(stats);
		}
	case ER_SYNTAX_ERROR: printf("Ошибка в синтакте: %s",query);
	}
	printf("%d, %s, %s, %s, %d", errorid, error, callback, query, connectionHandle);
	return 1;
}

callback::OffWarnAdmin(playerid, name[], reason[])
{
	new warn_count, admin_level;
	new r, f;
	cache_get_data(r, f);
	if(!r) return SendClientMessage(playerid, -1, ""cER"Аккаунта этого игрока нет в базе");

	warn_count = cache_get_field_content_int(0, "awarn");
	admin_level = cache_get_field_content_int(0, "level");
	warn_count ++;

	if(warn_count < 3)
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Руководитель %s выдал OFFLINE выговор администратору %s [%d/3]. Причина: %s", GetName(playerid), name, warn_count, reason);
		SendAdminMessage(COLOR_RED, STRING_GLOBAL);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE admin SET warnreason = '%s' WHERE name = '%s'", reason, name);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	}
	else
	{
		if(admin_level > 1)
		{
			admin_level --;
			warn_count = 0;

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] Администратор %s получил 3 выговора от руководителя %s и был понижен до %d уровня", name, GetName(playerid), admin_level);
			SendAdminMessage(COLOR_RED, STRING_GLOBAL);
		}
		else
		{
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `admin` WHERE `name` = '%e'", name);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[A] Администратор %s получил 3 выговора от руководителя %s и был снят с поста", name, GetName(playerid));
			SendAdminMessage(COLOR_RED, STRING_GLOBAL);
		}
	}

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE admin SET `awarn` = '%d', `level` = '%d' WHERE `name` = '%s'", warn_count, admin_level, name);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	fLogs("[admin] %s /offawarn %s %s", GetName(playerid), name, reason);
	return 1;
}

callback::OffWarnLeader(playerid, name[])
{
	new player_lvl, warn_count;
	new r, f;
	cache_get_data(r, f);
	if(!r) return SendClientMessage(playerid, -1, ""cER"Аккаунта этого игрока нет в базе");

	warn_count = cache_get_field_content_int(0, "lwarn");
	player_lvl = cache_get_field_content_int(0, "leader");

	if(player_lvl == 0) return SendClientMessage(playerid, -1, ""cER"Этот игрок не лидер");
	warn_count ++;

	if(warn_count < 3) format(string, sizeof(string), "Администратор %s выдал OFFLINE выговор лидеру %s [%d/3]", GetName(playerid), name, warn_count);
	else
	{
		mysql_format(db_prod, string, sizeof(string), "UPDATE `accounts` SET `leader` = '0', `member` = '0', `rank` = '0', `lwarn` = '0' WHERE `name` = '%s'", name);
		mysql_tquery(db_prod, string, "", "");
		format(string, sizeof string, "[A] Лидер %s получил 3 выговора от администратора %s и был снят с поста", name, GetName(playerid));
	}
	SendAdminMessage(COLOR_RED, string);
	SaveHistoryBan(name, string);

	mysql_format(db_prod, string, sizeof(string), "UPDATE `accounts` SET `lwarn` = '%d' WHERE `name` = '%s'", warn_count, name);
	mysql_tquery(db_prod, string, "", "");
	fLogs("[admin] %s /offlwarn %s", GetName(playerid), name);
	return true;
}

callback::OffUNWarnAdmin(playerid, name[])
{
	new warn_count, r, f;
	cache_get_data(r, f);
	if(!r) return SendClientMessage(playerid, -1, ""cER"Аккаунта этого игрока нет в базе, либо он не админ");

	warn_count = cache_get_field_content_int(0, "awarn");
	if(warn_count == 0) SendClientMessage(playerid, -1, ""cER"У данного админа нет ни одного выговора");
	else
	{
		warn_count --;
		mysql_format(db_prod, string, sizeof(string), "UPDATE admin SET `awarn` = '%d' WHERE `name` = '%s'", warn_count, name);
		mysql_tquery(db_prod, string, "", "");
		format(string, sizeof string, "[A] Руководитель %s OFFLINE снял выговор с администратора %s [Варнов у админа: %d/3]", GetName(playerid), name, warn_count);
		SendAdminMessage(COLOR_RED, string);
	}

	fLogs("[admin] %s /offunawarn %s", GetName(playerid), name);
	return true;
}

callback::OffUNWarnLeader(playerid, name[])
{
	new warn_count, r, f;
	cache_get_data(r, f);
	if(!r) return SendClientMessage(playerid, -1, ""cER"Аккаунта этого игрока нет в базе, либо он не лидер");

	warn_count = cache_get_field_content_int(0, "lwarn");
	if(warn_count == 0) SendClientMessage(playerid, -1, ""cER"У данного лидера нет ни одного выговора");
	else
	{
		warn_count --;
		mysql_format(db_prod, string, sizeof(string), "UPDATE `accounts` SET `lwarn` = '%d' WHERE `name` = '%s'", warn_count, name);
		mysql_tquery(db_prod, string, "", "");

		format(string, sizeof string, "[A] Администратор %s OFFLINE снял выговор с лидера %s [Варнов у лидера: %d/3]", GetName(playerid), name, warn_count);
		SendAdminMessage(COLOR_RED, string);
		SaveHistoryBan(name, string);
	}

	fLogs("[admin] %s /offunlwarn %s", GetName(playerid), name);
	return true;
}


CheckServerProperty()
{
	mysql_tquery(db_prod, "UPDATE bans SET time=time-1 WHERE time>0");
	mysql_tquery(db_prod, "UPDATE accounts SET vip_time=vip_time-1 WHERE vip_time>-1");

	SaveWarehouse();
	SaveMats();
	SaveRouletteCount();
	for(new garageid = TotalGarages; garageid > 0; garageid --)
	{
		if(!strcmp("None", GarageInfo[garageid][g_OWNER], true)) continue;
		GarageInfo[garageid][g_DAY]--;
		format(stringer,sizeof(stringer),"UPDATE `garages` SET `day` = %d WHERE `id`= %d", GarageInfo[garageid][g_DAY], GarageInfo[garageid][g_ID]);
		mysql_function_query(db_prod, stringer, true, "", "");
		if(GarageInfo[garageid][g_DAY] <= 0)
		{
			new targetid = GetPlayerPID(GarageInfo[garageid][g_OWNED]);
			if(targetid != 0xFFFF)
			{
				PI[targetid][pGarage] = -1;
				vehicle_in_garage[targetid] = 0;
				SetPlayerMoney(targetid, GarageInfo[garageid][g_PRICE] / 2);
				SendClientMessage(targetid, 0xFFFF00FF, "[ГАРАЖ]: За неуплату аренды, гараж был продан государству. Государство вернуло вам часть стоимости");
			}
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `garage` = '-1' WHERE `id` = '%d' LIMIT 1", GarageInfo[garageid][g_OWNED]);
			mysql_tquery(db_prod, STRING_GLOBAL);

			strmid(GarageInfo[garageid][g_OWNER], "None", 0, strlen("None"), 24);
			GarageInfo[garageid][g_UPDATE] = GarageInfo[garageid][g_DAY] = 0;
			GarageInfo[garageid][g_OWNED] = -1;
			GarageInfo[garageid][g_LOCK] = 1;
			UpdateGarageData(garageid);

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `garages` SET `owner` = 'None', `owned` = '-1', `update` = '0', `lock` = '1', `day` = '0' WHERE `id` = '%d' LIMIT 1", GarageInfo[garageid][g_ID]);
			mysql_tquery(db_prod, STRING_GLOBAL);
		}
	}
	for(new kvartid = TOTALROOMS; kvartid > 0; kvartid --)
	{
		if(!strcmp("None", RoomsInfo[kvartid][rOwner], true)) continue;
		RoomsInfo[kvartid][rOplata]--;
		SetRoomsInt(kvartid, "rOplata", RoomsInfo[kvartid][rOplata]);
		if(RoomsInfo[kvartid][rOplata] <= 0)
		{
			new targetid = GetPlayerPID(RoomsInfo[kvartid][rOwned]);
			if(targetid != 0xFFFF)
			{
				PI[targetid][pRoom] = -1;
				PI[targetid][pSpawnChange] = 0;
				SetPlayerMoney(targetid, (RoomsInfo[kvartid][rCost] / 2));
				SendClientMessage(targetid, 0xFFFF00FF, "[КВАРТИРА]: За неуплату аренды, квартира была продана государству. Государство вернуло вам часть стоимость");
			}

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `cash` = `cash`+'%d', `spawnchange` = '0', `room` = '-1' WHERE `id` = '%d' LIMIT 1", (RoomsInfo[kvartid][rCost] / 2), RoomsInfo[kvartid][rOwned]);
			mysql_tquery(db_prod, STRING_GLOBAL);

			RoomsInfo[kvartid][rLock] = 0;
			RoomsInfo[kvartid][rOwned] = -1;
			strmid(RoomsInfo[kvartid][rOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `rooms` SET  `rOwner` = 'None', `rOwned` = '-1', `rLock` = '0', rOplata=0 WHERE `id` = '%d' LIMIT 1", kvartid);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");
		}
	}
	for(new houseid = TOTALHOUSE; houseid > 0; houseid --)
	{
		if(!strcmp("None", HouseInfo[houseid][hOwner], true)) continue;
		HouseInfo[houseid][hOplata]--;
		MysqlUpdateHouseInt(houseid, "hOplata", HouseInfo[houseid][hOplata]);
		if(HouseInfo[houseid][hOplata] <= 0)
		{
			new targetid = GetPlayerPID(HouseInfo[houseid][hOwned]);
			if(targetid != 0xFFFF)
			{
				PI[targetid][pHouse] = -1;
				PI[targetid][pSpawnChange] = 0;
				SetPlayerMoney(targetid, HouseInfo[houseid][hBuyPrice]);
				SendClientMessage(targetid, 0xFFFF00FF, "[ДОМ]: За неуплату аренды, дом была продана государству. Государство вернуло вам часть стоимость");

				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `spawnchange` = '0', `house` = '-1' WHERE `id` = '%d' LIMIT 1", PI[targetid][pID]);
				mysql_tquery(db_prod, STRING_GLOBAL);
			}
			if(targetid == 0xFFFF)
			{
				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `accounts` WHERE `id` = '%d'", HouseInfo[houseid][hOwned]);
				mysql_tquery(db_prod, STRING_GLOBAL, "OnServerClearPlayerHouse", "id", houseid, HouseInfo[houseid][hOwned]);
			}
			strmid(HouseArendName[houseid][0], "none", 0, strlen("none"), 10);
			strmid(HouseArendName[houseid][1], "none", 0, strlen("none"), 10);
			strmid(HouseArendName[houseid][2], "none", 0, strlen("none"), 10);

			foreach(new to_player: Player)
			{
				if(PI[to_player][pHouseArend] == houseid)
				{
					PI[to_player][pHouseArend] = -1;
					SendClientMessage(to_player, COLOR_RED, "[Дом]: Вы были выселены из своего дома");
				}
			}
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `house_arend` = '-1' WHERE `house_arend` = '%d'", houseid);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			HouseInfo[houseid][hLock] = 1;
			HouseInfo[houseid][hOwned] = -1;
			strmid(HouseInfo[houseid][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
			HouseInfo[houseid][hBuyPrice] = HouseInfo[houseid][hOplata] = HouseInfo[houseid][hGarage] = HouseInfo[houseid][hAutoDoors] = 0;

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `house` SET `hOwner` = '%s', `hOwned` = '-1', `hArendName` = 'none,none,none', `hOplata` = '%d', `buyprice` = '%d', `hGarage` = '%d', `hAutoDoors` = '%d', `hLock` = '%d' WHERE `id` = '%d'", HouseInfo[houseid][hOwner], HouseInfo[houseid][hOplata], HouseInfo[houseid][hBuyPrice], HouseInfo[houseid][hGarage], HouseInfo[houseid][hAutoDoors], HouseInfo[houseid][hLock], houseid);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");
			UpdateHouse(houseid);
		}
	}
	for(new bizzid = 1; bizzid <= TOTALBIZZ; bizzid++)
	{
		if(!strcmp(BizzInfo[bizzid][bOwner], "None", true)) continue;
		BizzInfo[bizzid][bOplata]--;
		MysqlUpdateBizzInt(bizzid, "oplata", BizzInfo[bizzid][bOplata]);
		if(BizzInfo[bizzid][bOplata] <= 0) OnServerClearPlayerBizz(bizzid);
		else
		{
			new targetid = GetPlayerPID(BizzInfo[bizzid][bOwned]);
			if(BizzInfo[bizzid][bProduct] <= 0 && targetid != 0xFFFF)
			{
				if(BizzInfo[bizzid][bLockTime] == 0 && GetPlayerBizz(targetid) != 0x0)
				{
					SendClientMessage(targetid, COLOR_YELLOW, "Налоговая служба |"cWH" Ваш бизнес был закрыт по причине: отсутствие продуктов");
					SendClientMessage(targetid, COLOR_YELLOW, "Налоговая служба |"cWH" Если по истечению 12 часов бизнес будет закрыт, он будет продан гос-ву");
				}
				BizzInfo[bizzid][bLock] = 1;
				MysqlUpdateBizzInt(bizzid, "block", BizzInfo[bizzid][bLock]);
			}
			if(BizzInfo[bizzid][bLock] == 1)
			{
				BizzInfo[bizzid][bLockTime]++;
				MysqlUpdateBizzInt(bizzid, "locktime", BizzInfo[bizzid][bLockTime]);
			}
			if(BizzInfo[bizzid][bLockTime] > 1 && BizzInfo[bizzid][bLockTime] < 12)
			{
				if(targetid != 0xFFFF && GetPlayerBizz(targetid) != 0x0)
				{
					SendMes(targetid, -1, ""cPS"Ваш бизнес закрыт уже %d час(а)", BizzInfo[bizzid][bLockTime]);
					SendClientMessage(targetid, -1, ""cPS"Если по истечению 12 часов бизнес будет закрыт, он будет продан гос-ву");
				}
			}
		}
		switch(BizzInfo[bizzid][bMafia])
		{
		case TEAM_ITALMAFIA:
			{
				FracBank[6] += BizzPay[bizzid] / 10;
			}
		case TEAM_RUSMAFIA:
			{
				FracBank[5] += BizzPay[bizzid] / 10;
			}
		}
		BizzPay[bizzid] = 0;
	}
	MysqlUpdateMafiaInt("lcnbank", FracBank[6]);
	MysqlUpdateMafiaInt("yakuzabank", FracBank[5]);
	return 0x1;
}

callback::KickFromFamily(playerid, name[])
{
	new fam_id, fam_lid, r, f;
	cache_get_data(r, f);
	if(!r) return SendClientMessage(playerid, COLOR_RED, "Игрок не найден");
	if(GetPlayerID(name) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_RED, "Данный член семьи онлайн");
	fam_id = cache_get_field_content_int(0, "family");
	fam_lid = cache_get_field_content_int(0, "familysozd");
	if(fam_id != PI[playerid][pFamily]) return SendClientMessage(playerid, COLOR_RED, "Данный игрок не состоит в Вашей семье");
	if(fam_lid == 1 && GetString(family_info [PI[playerid][pFamily]] [f_creator], name)) return SendClientMessage(playerid, COLOR_RED, "Создателя семьи нельзя выгнать!");
	global_string = "";
	mysql_format(db_prod, global_string, 300, "UPDATE accounts SET family = '0', familyzam = 0, familyrank = 0, familysozd = 0 WHERE name = '%s'", name);
	mysql_tquery(db_prod, global_string, "", "");

	global_string = "";
	mysql_format(db_prod, global_string, 100, "SELECT * FROM `family_system` WHERE fam_id = '%d'", fam_id);
	mysql_tquery(db_prod, global_string, "CheckFamily", "ii", playerid, fam_id);

	SendClientMessage(playerid, COLOR_GREEN, "Вы успешно выгнали игрока из семьи");
	return true;
}

callback::CheckFamily(playerid, famid)
{
	new members, r, f;
	cache_get_data(r, f);
	if(r)
	{
		members = cache_get_field_content_int(0, "fam_members_amount");
	}
	global_string = "";
	mysql_format(db_prod, global_string, 128, "UPDATE `family_system` SET fam_members_amount = '%d' WHERE fam_id = '%d'", members-1, famid);
	mysql_tquery(db_prod, global_string, "", "");
	return true;
}

callback::DeleteMembersFamily(playerid)
{
	new r, f;
	cache_get_data(r, f);
	if(r)
	{
		global_string = "";
		format(global_string, 300, "UPDATE accounts SET family = '0', familyzam = 0, familyrank = 0, familysozd = 0 WHERE name != '%s' AND family = '%d'", GetName(playerid),PI[playerid][pFamily]); //, fam_members_amount = '1'
		mysql_tquery(db_prod, global_string, "", "");

		format(global_string, 300, "UPDATE `family_system` SET fam_members_amount = '1' WHERE fam_id = '%d'", PI[playerid][pFamily]); //
		mysql_tquery(db_prod, global_string, "", "");
		SendClientMessage(playerid, COLOR_GREEN, "Вы полностью расформировали семью");
	}
	return true;
}
GetPlayerArend(playerid)
{
	new houseid = 0;

	if(PI[playerid][pHouseArend] != -1)
	houseid = PI[playerid][pHouseArend];
	return houseid;
}
CountHouseArend(houseid)
{
	new count_house_arend = 0;

	for(new idx; idx < 3; idx++)
	{
		if(!strcmp(HouseArendName[houseid][idx], "none", true)) continue;
		count_house_arend ++;
	}
	return count_house_arend;
}
CheckPlayerArend(name[])
{
	new count = 0;
	for(new idx = TOTALHOUSE; idx > 0; idx--)
	{
		if(!strcmp(HouseArendName[idx][0], name, true) || !strcmp(HouseArendName[idx][1], name, true) || !strcmp(HouseArendName[idx][2], name, true)) count++;
	}
	return count;
}

callback::IsPlayerFexistAccount(playerid, name[], h, numberarend)
{
	new r, f;
	cache_get_data(r, f);
	if(!r) return SendClientMessage(playerid, COLOR_RED, "Данный аккаунт не найден в базе данных");
	new to_player = GetPlayerID(name);
	SendPlayerProposition(playerid, to_player, PROPOSITION_TYPE_AREND_HOUSE, h, numberarend);
	return 1;
}

callback::CheckFamilyName(playerid, text[], type)
{
	new r, f;
	cache_get_data(r, f);
	if(r) return SendClientMessage(playerid, COLOR_RED, "Такое имя семьи уже занято");

	if(type == 1)
	{
		if((family_count + 1) >= MAX_FAMILY) return SendClientMessage(playerid, 0xCCCCCCFF, "На сервере превышен лимит семей");
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `family_system` (`fam_name`, `fam_creator`, `fam_data`) VALUES ('%e', '%s', NOW())", text, GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL);

		family_count ++;
		PI[playerid][pFamily] = family_count;
		PI[playerid][pFamilyRank] = 7;
		SetPlayerMoney(playerid, -5000000);
		fLogs("[coin] %s -5.000.000$ создание семьи", GetName(playerid));

		strmid (family_info [family_count][f_name], text, 0, strlen(text), strlen(text)+5);
		strmid (family_info [family_count] [f_creator], GetName(playerid), 0, strlen(GetName(playerid)), strlen(GetName(playerid))+5);
		family_info [family_count] [f_chat_color] = 0;
		format(family_info [family_count] [f_creating_data], 32,"%02d/%02d/%d",year,month,day);
		PI[playerid][pFamilySozd] = 1;
		SCMF(playerid, COLOR_LIME, "Вы успешно создали семью %s, используйте /cmd > Семья для просмотр команд.", text);

		if(playerFamilyNameTag[playerid] == INVALID_3DTEXT_ID)
		{
			stringer1 = "";
			strcat(stringer1, family_info[family_count][f_name]);
			strcat(stringer1, ""cWH" ");
			strcat(stringer1, "Family");
			playerFamilyNameTag[playerid] = CreateDynamic3DTextLabel(stringer1, gFamilyColor[family_info[family_count][f_chat_color]], 0.0, 0.0, 0.5, 10.0, playerid, INVALID_VEHICLE_ID, 1);
		}

		format(stringer1, sizeof stringer1, "UPDATE `accounts` SET  family = %d, familyrank = 7, familysozd = 1 WHERE id=%d", PI[playerid][pFamily], PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1);
	}
	else
	{
		if(playerEuro[playerid] < 1000) return SendClientMessage(playerid, -1, ""cER"Для смены названия семьи необходимо 1.000 евро");

		TransferEuro(playerid, -1, 1000, "Смена названия семьи");
		format(family_info [PI[playerid][pFamily]] [f_name], 32 , text);
		new fmt_str[128];
		format(fmt_str, sizeof(fmt_str), "{FFD39B}%s[%s]: изменил название семьи на {%s}%s",GetName(playerid),family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1],family_chat_color [family_info [PI[playerid][pFamily]] [f_chat_color]],text);
		family_message(PI[playerid][pFamily],-1, fmt_str);

		global_string = "";
		mysql_format(db_prod, global_string, 128, "UPDATE `family_system` SET `fam_name` = '%e' WHERE `fam_id` = '%d'", text, PI[playerid][pFamily]);
		mysql_function_query ( db_prod, global_string, false, "", "");
	}
	return 1;
}
GetCreatorHouseID(playerid)
{
	new fam = PI[playerid][pFamily];
	if(family_info[fam][f_house]) CREATOR_HOUSE_ID[playerid] = family_info[fam][f_house];
	else CREATOR_HOUSE_ID[playerid] = -1;
}
GetPlayerSlotArend(playerid, houseid)
{
	new slot_id = -1;

	for(new i; i < 3; i++)
	{
		if(!strcmp(HouseArendName[houseid][i], GetName(playerid), true)) slot_id = i;
	}

	return slot_id;
}
GetPlayerGarage(playerid)
{
	return PI[playerid][pGarage];
}

callback::LoadHelicopter(playerid)
{
	new r, f;
	cache_get_data(r, f);
	if(r)
	{
		H_DATA[playerid][h_timer] = 		cache_get_field_content_int(0, "h_timer");

		if(H_DATA[playerid][h_timer] > unix)
		{
			new time = H_DATA[playerid][h_timer] - unix, CB[30];
			Convert(time, CB);
			SendMes(playerid, COLOR_RED, "Вертолет на ремонте. До окончания ремонта: %s", CB);
			return 1;
		}

		H_DATA[playerid][h_model] = 		cache_get_field_content_int(0, "h_model");
		H_DATA[playerid][h_color] = 		cache_get_field_content_int(0, "h_color");
		H_DATA[playerid][h_lock] =      	cache_get_field_content_int(0, "h_lock");
		H_DATA[playerid][h_price] =     	cache_get_field_content_int(0, "h_price");

		new Float:HomeVertPos[4];
		if(GetPlayerHouse(playerid) != 0 && HouseInfo[GetPlayerHouse(playerid)][hRublevka] > 0)
		{
			for(new i; i < 4; i++) HomeVertPos[i] = HouseInfo[GetPlayerHouse(playerid)][helicopter_housepos][i];

			if(HomeVertPos[0] != 0 && HomeVertPos[1] != 0)
			{
				PI[playerid][HelicopterID] = CreateVehicle(H_DATA[playerid][h_model], HomeVertPos[0], HomeVertPos[1], HomeVertPos[2], HomeVertPos[3], H_DATA[playerid][h_color], -1, 90000);
				CarDoorsEx(PI[playerid][HelicopterID], H_DATA[playerid][h_lock]);
				Fuel[PI[playerid][HelicopterID]] = 999;
				SetVehicleHealth(PI[playerid][HelicopterID], 1000);
				SetVehicleVirtualWorld(PI[playerid][HelicopterID], 0);
				Engine[PI[playerid][HelicopterID]] = Lights[PI[playerid][HelicopterID]] = false;
				SendClientMessage(playerid, COLOR_GREEN, "Вертолет успешно загружен на сервер. Он находится у вашего особняка.");
			}
			else
			{
				SendClientMessage(playerid, COLOR_ORANGE, "[Информация]: если место имеет статус 'Свободно' - загрузка разрешена");
				SendClientMessage(playerid, COLOR_ORANGE, "[Информация]: если место имеет статус 'Занято' - загрузка запрещена. Необходимо подождать, пока другой вертолет освободит место на полосе");
				SendClientMessage(playerid, COLOR_ORANGE, "[Информация]: если все места заняты, то рекомендуем Вам подождать или прогуляться по окрестностям поселка");

				string = "";
				for(new idx; idx < sizeof AeroportRandomSpawn; idx++)
				{
					format(string, sizeof string, "%s"cWH"- Место №%d | Статус: %s\n", string, idx+1, (AeroportStatus[idx] ? ("{F12E20}Занято") : ("{3DC148}Свободно")));
				}
				ShowPlayerDialog(playerid, 18012, DIALOG_STYLE_LIST, "{ECDE19}Загрузка вертолета", string, "Выбрать", "Выход");
			}
		}
		else
		{
			SendClientMessage(playerid, COLOR_ORANGE, "[Информация]: если место имеет статус 'Свободно' - загрузка разрешена");
			SendClientMessage(playerid, COLOR_ORANGE, "[Информация]: если место имеет статус 'Занято' - загрузка запрещена. Необходимо подождать, пока другой вертолет освободит место на полосе");
			SendClientMessage(playerid, COLOR_ORANGE, "[Информация]: если все места заняты, то рекомендуем Вам подождать или прогуляться по окрестностям поселка");

			string = "";
			for(new idx; idx < sizeof AeroportRandomSpawn; idx++)
			{
				format(string, sizeof string, "%s"cWH"- Место №%d | Статус: %s\n", string, idx+1, (AeroportStatus[idx] ? ("{F12E20}Занято") : ("{3DC148}Свободно")));
			}
			ShowPlayerDialog(playerid, 18012, DIALOG_STYLE_LIST, "{ECDE19}Загрузка вертолета", string, "Выбрать", "Выход");
		}
	}
	else SendClientMessage(playerid, COLOR_RED, "Системная ошибка #1: Напишите о баге в группу vk.com/prpcrmp");
	return 1;
}

callback::LoadYacht(playerid)
{
	new r, f;
	cache_get_data(r, f);
	if(r)
	{

		Y_DATA[playerid][y_model] = 		cache_get_field_content_int(0, "y_model");
		Y_DATA[playerid][y_color] = 		cache_get_field_content_int(0, "y_color");
		Y_DATA[playerid][y_lock] =      	cache_get_field_content_int(0, "y_lock");
		Y_DATA[playerid][y_price] =     	cache_get_field_content_int(0, "y_price");
		Y_DATA[playerid][y_x] =     		cache_get_field_content_float(0, "y_x");
		Y_DATA[playerid][y_y] =     		cache_get_field_content_float(0, "y_y");
		Y_DATA[playerid][y_z] =     		cache_get_field_content_float(0, "y_z");
		Y_DATA[playerid][y_r] =     		cache_get_field_content_float(0, "y_r");

		if(!Y_DATA[playerid][y_x] && !Y_DATA[playerid][y_y] && !Y_DATA[playerid][y_z])
		{
			new rand = random(24);
			PI[playerid][YachtID] = CreateVehicle(Y_DATA[playerid][y_model], YachtRandomSpawn[rand][0], YachtRandomSpawn[rand][1], YachtRandomSpawn[rand][2], YachtRandomSpawn[rand][3], Y_DATA[playerid][y_color], -1, 90000);
			SendClientMessage(playerid, COLOR_ORANGE, "Ваша яхта не была припаркована, поэтому она заспавнена у береговой линии. Для поиска яхты используйте: /yacht -> 2. Поиск яхты");
		}
		else PI[playerid][YachtID] = CreateVehicle(Y_DATA[playerid][y_model], Y_DATA[playerid][y_x], Y_DATA[playerid][y_y], Y_DATA[playerid][y_z], Y_DATA[playerid][y_r], Y_DATA[playerid][y_color], -1, 90000);

		CarDoorsEx(PI[playerid][YachtID], Y_DATA[playerid][y_lock]);
		Fuel[PI[playerid][YachtID]] = 999;
		SetVehicleHealth(PI[playerid][YachtID], 1000);
		Engine[PI[playerid][YachtID]] = Lights[PI[playerid][YachtID]] = false;

		SendClientMessage(playerid, COLOR_GREEN, "Яхта успешно загружена на сервер. Для поиска яхты используйте: {F79131}/yacht -> 2. Поиск яхты");

	}
	else SendClientMessage(playerid, COLOR_RED, "Системная ошибка #1: обратитесь к администратору");
	return 1;
}
DestroyYacht(playerid)
{
	if(PI[playerid][YachtID] == INVALID_VEHICLE_ID) return 1;
	SaveYacht(playerid);
	DestroyVehicle(PI[playerid][YachtID]);
	ClearYachtData(playerid);
	return 1;
}
SaveYacht(playerid)
{
	global_string = "";
	mysql_format(db_prod, global_string, 300, "\
	UPDATE `yacht` SET \
	y_model = '%d',\
	y_owner = '%s',\
	y_color = '%d',\
	y_lock = '%d',\
	y_price = '%d', \
	y_x = '%f',\
	y_y = '%f',\
	y_z = '%f',\
	y_r = '%f' WHERE `y_owner` = '%s'",
	Y_DATA[playerid][y_model],
	GetName(playerid),
	Y_DATA[playerid][y_color],
	Y_DATA[playerid][y_lock],
	Y_DATA[playerid][y_price],
	Y_DATA[playerid][y_x],
	Y_DATA[playerid][y_y],
	Y_DATA[playerid][y_z],
	Y_DATA[playerid][y_r],
	GetName(playerid));
	mysql_tquery(db_prod, global_string, "","");
	return 1;
}
ClearYachtData(playerid)
{

	Y_DATA[playerid][y_model] 			=
	Y_DATA[playerid][y_color] 			=
	Y_DATA[playerid][y_lock]			=
	Y_DATA[playerid][y_price] 			=   0;

	Y_DATA[playerid][y_x]				=
	Y_DATA[playerid][y_y]				=
	Y_DATA[playerid][y_z]				=
	Y_DATA[playerid][y_r]				=   0.0;

	PI[playerid][YachtID]       		=	INVALID_VEHICLE_ID;

	return 1;
}

callback::LoadPlayerCar(playerid)
{
	if(GetPlayerSlotVehicle(playerid) == -1)
		return SendClientMessage(playerid, COLOR_RED, "Выгрузите предыдущий автомобиль, прежде чем загрузить новый");

	if(GetActivePlayerVehicleCount(playerid) == 2 && PI[playerid][pVip] != VIP_STATE_DIAMOND)
		return SendErr(playerid, "Загрузить больше автомобилей можно с VIP Diamond");

	new r, f;
	cache_get_data(r, f);
	if(r)
	{
		C_DATA[playerid][c_arrest] =     	cache_get_field_content_int(0, "c_arrest");
		if(C_DATA[playerid][c_arrest])
		{
			C_DATA[playerid][c_arrest] = 0;
			return SCM(playerid,-1,"Автомобиль не может быть загружен т.к он находится под арестом!");
		}
		C_DATA[playerid][c_model] = 		cache_get_field_content_int(0, "c_model");
		C_DATA[playerid][c_class] = 		cache_get_field_content_int(0, "c_class");
		C_DATA[playerid][c_fuel] = 			cache_get_field_content_int(0, "c_fuel");
		C_DATA[playerid][c_x] =         	cache_get_field_content_float(0, "c_x");
		C_DATA[playerid][c_y] =         	cache_get_field_content_float(0, "c_y");
		C_DATA[playerid][c_z] =         	cache_get_field_content_float(0, "c_z");
		C_DATA[playerid][c_a] =         	cache_get_field_content_float(0, "c_a");
		C_DATA[playerid][c_color][0] = 		cache_get_field_content_int(0, "c_color1");
		C_DATA[playerid][c_color][1] = 		cache_get_field_content_int(0, "c_color2");
		C_DATA[playerid][c_lock] =      	cache_get_field_content_int(0, "c_lock");
		C_DATA[playerid][c_price] =     	cache_get_field_content_int(0, "c_price");
		cache_get_field_content(0, "c_vehcom", C_DATA[playerid][c_vehcom], db_prod, 64);
		cache_get_field_content(0, "c_number", C_DATA[playerid][c_number], db_prod, 64);
		cache_get_field_content(0, "c_trunk", C_DATA[playerid][c_trunks], db_prod, 64);
		C_DATA[playerid][c_paintjob] = 		cache_get_field_content_int(0, "c_paintjob");
		C_DATA[playerid][c_world] = 		cache_get_field_content_int(0, "c_world");
		C_DATA[playerid][c_update] =        cache_get_field_content_int(0, "c_update");
		C_DATA[playerid][c_mileage] =       cache_get_field_content_float(0, "c_mileage");
		C_DATA[playerid][c_health] =        cache_get_field_content_float(0, "c_health");

		sscanf(C_DATA[playerid][c_vehcom], "p<,>a<i>[14]", C_DATA[playerid][c_vehcoms]);
		sscanf(C_DATA[playerid][c_trunks], "p<,>iiiiiii", C_DATA[playerid][c_trunk][0], C_DATA[playerid][c_trunk][1], C_DATA[playerid][c_trunk][2], C_DATA[playerid][c_trunk][3], C_DATA[playerid][c_trunk_gun][0], C_DATA[playerid][c_trunk_gun][1], C_DATA[playerid][c_trunk_gun][2]);

		if(GetPlayerGarage(playerid) == -1 && C_DATA[playerid][c_world] > 1) ClearPlayerCar(playerid);

		new
			slot = GetPlayerSlotVehicle(playerid);
		new
			veh_id;

		if(C_DATA[playerid][c_x] == 0 && C_DATA[playerid][c_y] == 0 && C_DATA[playerid][c_z] == 0)
		{
			if(C_DATA[playerid][c_class] == 1)
			{
				new rand = random(44);
				veh_id = PlayerVehicle[playerid][slot] = CreateVehicle(C_DATA[playerid][c_model], SalonRandSpawn[rand][0], SalonRandSpawn[rand][1], SalonRandSpawn[rand][2], SalonRandSpawn[rand][3], C_DATA[playerid][c_color][0], C_DATA[playerid][c_color][1], 600);
				SendClientMessage(playerid, COLOR_GREEN,"Ваш автомобиль не был припаркован после покупки и был отбуксирован на стоянку. Найти автомобиль -> /findcar");
			}
			else
			{
				new rand = random(20);
				veh_id = PlayerVehicle[playerid][slot] = CreateVehicle(C_DATA[playerid][c_model], LSalonRandSpawn[rand][0], LSalonRandSpawn[rand][1], LSalonRandSpawn[rand][2], LSalonRandSpawn[rand][3], C_DATA[playerid][c_color][0], C_DATA[playerid][c_color][1], 600);
				SendClientMessage(playerid, COLOR_GREEN,"Ваш автомобиль не был припаркован после покупки и был отбуксирован на стоянку. Найти автомобиль -> /findcar");

			}
		}
		else  veh_id = PlayerVehicle[playerid][slot] = CreateVehicle(C_DATA[playerid][c_model], C_DATA[playerid][c_x], C_DATA[playerid][c_y], C_DATA[playerid][c_z], C_DATA[playerid][c_a], C_DATA[playerid][c_color][0], C_DATA[playerid][c_color][1], 600);

		if(VehicleLabel[veh_id] != INVALID_3DTEXT_ID) DestroyVehicleLabel(veh_id);
		VehicleLabel[veh_id] = INVALID_3DTEXT_ID;

		if(C_DATA[playerid][c_health] < 500) SetVehicleHealth(veh_id, 500);
		else SetVehicleHealth(veh_id, C_DATA[playerid][c_health]);

		//CarDoorsEx(veh_id, C_DATA[playerid][c_lock]);
		Fuel[veh_id] = C_DATA[playerid][c_fuel];
		SetVehicleVirtualWorld(veh_id, C_DATA[playerid][c_world]);

		if(C_DATA[playerid][c_world] > 1) vehicle_in_garage[playerid] = 1;
		vehicle_mileage[veh_id] = C_DATA[playerid][c_mileage];

		for(new i; i < 14; i++)
		{
			if(C_DATA[playerid][c_vehcoms][i]) AddVehicleComponent(veh_id, C_DATA[playerid][c_vehcoms][i]);
		}
		if(C_DATA[playerid][c_paintjob] != 3) ChangeVehiclePaintjob(veh_id, C_DATA[playerid][c_paintjob]);

		global_string = "";
		mysql_format(db_prod, global_string, 128, "UPDATE `ownable_cars` SET c_status = '1' WHERE c_owner = '%s' AND id = '%d'", GetName(playerid), car_id[playerid]);
		mysql_tquery(db_prod, global_string, "", "");

		PlayerVehicleSQL[playerid][slot] = car_id[playerid];

		if(PI[playerid][pGarage] == -1)
		{
			if(GetVehicleDistanceFromPoint(veh_id, 1500.0162,2499.3147,1601.0000) <= 100.0)
			{
				if(C_DATA[playerid][c_class] == 1)
				{
					new rand = random(44);
					SetVehiclePos(veh_id, SalonRandSpawn[rand][0], SalonRandSpawn[rand][1], SalonRandSpawn[rand][2]);
					SetVehicleZAngle(veh_id, SalonRandSpawn[rand][3]);
				}
				else
				{
					new rand = random(20);
					SetVehiclePos(veh_id, LSalonRandSpawn[rand][0], LSalonRandSpawn[rand][1], LSalonRandSpawn[rand][2]);
					SetVehicleZAngle(veh_id, LSalonRandSpawn[rand][3]);
				}
			}
		}

		if(veh_id == INVALID_VEHICLE_ID) return SendErr(playerid, "Ошибка, машины не существует");
		if(VehicleLabel[veh_id] == INVALID_3DTEXT_ID)
		{
			stringer1 = "{78A94D}";
			strcat(stringer1, C_DATA[playerid][c_number]);
			CreateVehicleLabel(veh_id, stringer1, 0xFFFFFFFF, 0.0, 0.0, 0.0, 20.0);
			SetVehicleNumberPlate(veh_id, stringer1);
		}

		SetVehicleTuning(veh_id, VT_LIGHTS_COLOR_R, cache_get_field_content_int(0, "lights_color_r"));
		SetVehicleTuning(veh_id, VT_LIGHTS_COLOR_G, cache_get_field_content_int(0, "lights_color_g"));
		SetVehicleTuning(veh_id, VT_LIGHTS_COLOR_B, cache_get_field_content_int(0, "lights_color_b"));

		SetVehicleTuning(veh_id, VT_NEON_COLOR_R, cache_get_field_content_int(0, "neon_color_r"));
		SetVehicleTuning(veh_id, VT_NEON_COLOR_G, cache_get_field_content_int(0, "neon_color_g"));
		SetVehicleTuning(veh_id, VT_NEON_COLOR_B, cache_get_field_content_int(0, "neon_color_b"));

		SetVehicleTuning(veh_id, VT_MAIN_COLOR_R, cache_get_field_content_int(0, "rgb_color_r"));
		SetVehicleTuning(veh_id, VT_MAIN_COLOR_G, cache_get_field_content_int(0, "rgb_color_g"));
		SetVehicleTuning(veh_id, VT_MAIN_COLOR_B, cache_get_field_content_int(0, "rgb_color_b"));

		SetVehicleTuning(veh_id, VT_TINING_TRANSPARENT, cache_get_field_content_int(0, "tining_transparent"));

		SetVehicleTuning(veh_id, VT_TINING_COLOR_R, cache_get_field_content_int(0, "tining_color_r"));
		SetVehicleTuning(veh_id, VT_TINING_COLOR_G, cache_get_field_content_int(0, "tining_color_g"));
		SetVehicleTuning(veh_id, VT_TINING_COLOR_B, cache_get_field_content_int(0, "tining_color_b"));

		EnableVehicleLights
		(
			playerid,
			veh_id,
			GetVehicleTuning(veh_id, VT_LIGHTS_COLOR_R),
			GetVehicleTuning(veh_id, VT_LIGHTS_COLOR_G),
			GetVehicleTuning(veh_id, VT_LIGHTS_COLOR_B)
		);

		EnableVehicleColor
		(
			playerid,
			veh_id,
			GetVehicleTuning(veh_id, VT_MAIN_COLOR_R),
			GetVehicleTuning(veh_id, VT_MAIN_COLOR_G),
			GetVehicleTuning(veh_id, VT_MAIN_COLOR_B)
		);

		EnableVehicleNeon
		(
			playerid,
			veh_id,
			GetVehicleTuning(veh_id, VT_NEON_COLOR_R),
			GetVehicleTuning(veh_id, VT_NEON_COLOR_G),
			GetVehicleTuning(veh_id, VT_NEON_COLOR_B),
			GetVehicleTuning(veh_id, VT_NEON_ALPHA)
		);

		EnableVehicleTining
		(
			playerid,
			veh_id,
			1,
			GetVehicleTuning(veh_id, VT_TINING_COLOR_R),
			GetVehicleTuning(veh_id, VT_TINING_COLOR_G),
			GetVehicleTuning(veh_id, VT_TINING_COLOR_B),
			GetVehicleTuning(veh_id, VT_TINING_TRANSPARENT)
		);

		EnableVehicleTining
		(
			playerid,
			veh_id,
			2,
			GetVehicleTuning(veh_id, VT_TINING_COLOR_R),
			GetVehicleTuning(veh_id, VT_TINING_COLOR_G),
			GetVehicleTuning(veh_id, VT_TINING_COLOR_B),
			GetVehicleTuning(veh_id, VT_TINING_TRANSPARENT)
		);

		EnableVehicleTining
		(
			playerid,
			veh_id,
			3,
			GetVehicleTuning(veh_id, VT_TINING_COLOR_R),
			GetVehicleTuning(veh_id, VT_TINING_COLOR_G),
			GetVehicleTuning(veh_id, VT_TINING_COLOR_B),
			GetVehicleTuning(veh_id, VT_TINING_TRANSPARENT)
		);

		EnableVehicleTining
		(
			playerid,
			veh_id,
			0,
			GetVehicleTuning(veh_id, VT_TINING_COLOR_R),
			GetVehicleTuning(veh_id, VT_TINING_COLOR_G),
			GetVehicleTuning(veh_id, VT_TINING_COLOR_B),
			GetVehicleTuning(veh_id, VT_TINING_TRANSPARENT)
		);

		SendMes(playerid, COLOR_GREEN, "Автомобиль (ID: %d) успешно загружен в игру. Найти автомобиль: /findcar", veh_id);
		fLogs("[cars] %s %i %s загружен", GetName(playerid), C_DATA[playerid][c_model], VehicleNames[C_DATA[playerid][c_model]-400], veh_id);
	}
	else SendClientMessage(playerid, COLOR_RED, "Системная ошибка #1: обратитесь к администратору");
	return true;
}
SetPlayerCarNumber(vehid, strings[])
{
	if(vehid == INVALID_VEHICLE_ID) return 1;

	new Float: car_pos_x, Float: car_pos_y, Float: car_pos_z, Float: car_pos_a;
	GetVehiclePos(vehid, car_pos_x, car_pos_y, car_pos_z);
	SetVehicleNumberPlate(vehid, strings);
	SetVehiclePos(vehid, car_pos_x, car_pos_y, car_pos_z);
	SetVehicleZAngle(vehid, car_pos_a);
	return 1;
}
DestroyHelicopter(playerid)
{
	if(PI[playerid][HelicopterID] == INVALID_VEHICLE_ID) return 1;
	SaveHelicopter(playerid);
	DestroyVehicle(PI[playerid][HelicopterID]);
	ClearHelicopterData(playerid);
	return 1;
}
SaveHelicopter(playerid)
{
	global_string = "";
	mysql_format(db_prod, global_string, 1000, "\
	UPDATE `helicopters` SET \
	h_model = '%d',\
	h_owner = '%s',\
	h_color = '%d',\
	h_lock = '%d',\
	h_price = '%d', \
	h_timer = '%d' WHERE `h_owner` = '%s'",
	H_DATA[playerid][h_model],
	GetName(playerid),
	H_DATA[playerid][h_color],
	H_DATA[playerid][h_lock],
	H_DATA[playerid][h_price],
	H_DATA[playerid][h_timer],
	GetName(playerid));
	mysql_tquery(db_prod, global_string, "","");
	return 1;
}
SaveTrunkCar(playerid)
{
	global_string = "";

	format(C_DATA[playerid][c_trunks], 64, "%d,%d,%d,%d,%d,%d,%d",
	C_DATA[playerid][c_trunk][0], C_DATA[playerid][c_trunk][1], C_DATA[playerid][c_trunk][2],
	C_DATA[playerid][c_trunk][3], C_DATA[playerid][c_trunk_gun][0], C_DATA[playerid][c_trunk_gun][1],
	C_DATA[playerid][c_trunk_gun][2]);

	mysql_format(db_prod, global_string, 1000, "UPDATE `ownable_cars` SET c_trunk = '%s' WHERE `c_owner` = '%s' AND c_status = '1'", C_DATA[playerid][c_trunks], GetName(playerid));
	mysql_tquery(db_prod, global_string, "","");
	return 1;
}
SavePlayerCar(playerid)
{
	global_string = "";
	format(C_DATA[playerid][c_vehcom], 64, "%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
	C_DATA[playerid][c_vehcoms][0], C_DATA[playerid][c_vehcoms][1], C_DATA[playerid][c_vehcoms][2],
	C_DATA[playerid][c_vehcoms][3], C_DATA[playerid][c_vehcoms][4], C_DATA[playerid][c_vehcoms][5],
	C_DATA[playerid][c_vehcoms][6], C_DATA[playerid][c_vehcoms][7], C_DATA[playerid][c_vehcoms][8],
	C_DATA[playerid][c_vehcoms][9],	C_DATA[playerid][c_vehcoms][10], C_DATA[playerid][c_vehcoms][11],
	C_DATA[playerid][c_vehcoms][12], C_DATA[playerid][c_vehcoms][13]);
	mysql_format(db_prod, global_string, 1000, "\
	UPDATE `ownable_cars` SET \
	c_model = '%d',\
	c_x = '%f',\
	c_y = '%f',\
	c_z = '%f',\
	c_a = '%f',\
	c_class = '%d',\
	c_owner = '%s',\
	c_fuel = '%d',\
	c_color1 = '%d',\
	c_color2 = '%d',\
	c_lock = '%d',\
	c_price = '%d',\
	c_vehcom = '%s',\
	c_number = '%s',\
	c_world = '%d',\
	c_update = '%d',\
	c_paintjob = '%d',\
	c_mileage = '%f',\
	c_health = '%f' WHERE `c_owner` = '%s' AND c_status = '1'",
	C_DATA[playerid][c_model],
	C_DATA[playerid][c_x],
	C_DATA[playerid][c_y],
	C_DATA[playerid][c_z],
	C_DATA[playerid][c_a],
	C_DATA[playerid][c_class],
	GetName(playerid),
	C_DATA[playerid][c_fuel],
	C_DATA[playerid][c_color][0],
	C_DATA[playerid][c_color][1],
	C_DATA[playerid][c_lock],
	C_DATA[playerid][c_price],
	C_DATA[playerid][c_vehcom],
	C_DATA[playerid][c_number],
	C_DATA[playerid][c_world],
	C_DATA[playerid][c_update],
	C_DATA[playerid][c_paintjob],
	C_DATA[playerid][c_mileage],
	C_DATA[playerid][c_health],
	GetName(playerid));
	mysql_tquery(db_prod, global_string, "","");
	return 1;
}
ClearCarData(playerid)
{

	C_DATA[playerid][c_model] 			=
	C_DATA[playerid][c_class] 			=
	C_DATA[playerid][c_arrest] 			=
	C_DATA[playerid][c_fuel] 			= 	0;
	C_DATA[playerid][c_x] 				=
	C_DATA[playerid][c_y] 				=
	C_DATA[playerid][c_z] 				=
	C_DATA[playerid][c_a] 				=
	C_DATA[playerid][c_health]			=
	C_DATA[playerid][c_mileage] 		=	0.0;
	C_DATA[playerid][c_color][0] 		=
	C_DATA[playerid][c_color][1] 		=
	C_DATA[playerid][c_lock]			=
	C_DATA[playerid][c_price] 			=
	C_DATA[playerid][c_paintjob] 		=   3;
	C_DATA[playerid][c_arrestinfo]		=	EOS;
	for(new idx; idx < 4; idx++) C_DATA[playerid][c_trunk][idx] = 0;
	for(new idx; idx < 3; idx++) C_DATA[playerid][c_trunk_gun][idx] = 0;
	PI[playerid][PlayerCarID]       	=	INVALID_VEHICLE_ID;
	return 1;
}
ClearHelicopterData(playerid)
{

	H_DATA[playerid][h_model] 			=
	H_DATA[playerid][h_color] 			=
	H_DATA[playerid][h_lock]			=
	H_DATA[playerid][h_price] 			=   0;

	PI[playerid][HelicopterID]       	=	INVALID_VEHICLE_ID;

	return 1;
}
CreateVehicleLabel(vehicleid, text[], color, Float:x, Float:y, Float:z, Float:drawdistance, testlos = 0, worldid = -1, interiorid = -1, playerid = -1, Float:streamdistance = STREAMER_3D_TEXT_LABEL_SD)
{
	if(VehicleLabel[vehicleid] != INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(VehicleLabel[vehicleid]);
		VehicleLabel[vehicleid] = INVALID_3DTEXT_ID;
	}
	if(GetVehicleModel(vehicleid))
	{
		if(!IsValidDynamic3DTextLabel(VehicleLabel[vehicleid]))
		{
			VehicleLabel[vehicleid] = CreateDynamic3DTextLabel(text, color, x, y, z, drawdistance, INVALID_PLAYER_ID, vehicleid, testlos, worldid, interiorid, playerid, streamdistance);
		}
	}
	return 1;
}
UpdateVehicleLabel(vehicleid, color, text[])
{
	if(GetVehicleModel(vehicleid))
	{
		if(IsValidDynamic3DTextLabel(VehicleLabel[vehicleid]))
		{
			UpdateDynamic3DTextLabelText(VehicleLabel[vehicleid], color, text);
		}
	}
	return 1;
}
DestroyVehicleLabel(vehicleid)
{
	if(VehicleLabel[vehicleid] != INVALID_3DTEXT_ID)
	{
		if(GetVehicleModel(vehicleid))
		{
			if(IsValidDynamic3DTextLabel(VehicleLabel[vehicleid]))
			{
				DestroyDynamic3DTextLabel(VehicleLabel[vehicleid]);
				VehicleLabel[vehicleid] = INVALID_3DTEXT_ID;
			}
		}
	}
	return 1;
}
RemovePlayerWeapon(playerid, b_weapon)
{
	new b_weaponammo[13][2];
	for(new s; s != 13; s++) GetPlayerWeaponData(playerid, s, b_weaponammo[s][0], b_weaponammo[s][1]);
	ResetPlayerWeapons(playerid);
	for(new g; g != 13; g++)
	{
		if(b_weaponammo[g][0] == b_weapon || b_weaponammo[g][1] <= 0) continue;
		GivePlayerWeapon(playerid, b_weaponammo[g][0], b_weaponammo[g][1]);
		break;
	}
}

SendSocMessage(color, str[])
{
	foreach(new i: Player)
	{
		if(!PlayerLogged[i]) continue;
		if(PI[i][pPhone][1] > 0 && Phone[i] == true && PhoneInternetStatus[i] == true) SendClientMessage(i, color, str);
	}
	return 1;
}

callback::ShowRieltorHouse(playerid)
{
	new r, f;
	cache_get_data(r, f);
	if(!r) return SendClientMessage(playerid, COLOR_RED, "Извините, в настоящий момент свободных домов нет..");

	new house_id, fmt_str[60], Float: Pos[3];

	GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);

	olderX[playerid] = Pos[0];
	olderY[playerid] = Pos[1];
	olderZ[playerid] = Pos[2];
	olderInt[playerid] = GetPlayerInterior(playerid);
	olderWorld[playerid] = GetPlayerVirtualWorld(playerid);

	global_string = "";

	for(new idx = 0; idx < r; idx++)
	{
		house_id = cache_get_field_content_int(idx, "id");
		format(fmt_str, sizeof fmt_str, ""cWH"- №%d\n", house_id);
		strcat(global_string, fmt_str);
		SetPlayerListitemValue(playerid, idx, house_id);
	}

	ShowPlayerDialog(playerid, 18225+1, DIALOG_STYLE_LIST, ""cMain"Выберите номер свободного дома:", global_string, "Выбрать", "Отмена");

	return 1;
}

callback::ShowRieltorBizz(playerid)
{
	new r, f;
	cache_get_data(r, f);
	if(!r) return SendClientMessage(playerid, COLOR_RED, "Извините, в настоящий момент свободных бизнесов нет..");

	new bizz_id, fmt_str[110], Float: Pos[3];

	GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);

	olderX[playerid] = Pos[0];
	olderY[playerid] = Pos[1];
	olderZ[playerid] = Pos[2];
	olderInt[playerid] = GetPlayerInterior(playerid);
	olderWorld[playerid] = GetPlayerVirtualWorld(playerid);

	global_string = "";

	for(new idx = 0; idx < r; idx++)
	{
		bizz_id = cache_get_field_content_int(idx, "id");
		format(fmt_str, sizeof fmt_str, ""cWH"- №%d\n", bizz_id);
		strcat(global_string, fmt_str);
		SetPlayerListitemValue(playerid, idx, bizz_id);
	}

	ShowPlayerDialog(playerid, 18225+4, DIALOG_STYLE_LIST, ""cMain"Выберите номер свободного бизнеса:", global_string, "Выбрать", "Отмена");

	return 1;
}
ExitRieltorMenu(playerid)
{
	SetPlayerPos(playerid, olderX[playerid], olderY[playerid], olderZ[playerid]);
	SetPlayerVirtualWorld(playerid, olderWorld[playerid]);
	SetPlayerInterior(playerid, olderInt[playerid]);

	olderX[playerid] = olderY[playerid] = olderZ[playerid] = 0.0;
	olderInt[playerid] = olderWorld[playerid] = 0;
	is_player_in_rieltor_house[playerid] = 0;

	TogglePlayerControllable(playerid, 1);

	buy_house_id[playerid] = -1; buy_bizz_id[playerid] = -1;

	SetCameraBehindPlayer(playerid);
	return 1;
}
CheckPlayerGoCuff(playerid)
{
	GotoInfo[playerid][gtX] = 0.0;
	GotoInfo[playerid][gtY] = 0.0;
	GotoInfo[playerid][gtZ] = 0.0;
	GotoInfo[playerid][gtTPX] = 0.0;
	GotoInfo[playerid][gtTPY] = 0.0;
	GotoInfo[playerid][gtTPZ] = 0.0;
	GotoInfo[playerid][gtID] = INVALID_PLAYER_ID;
	GotoInfo[playerid][gtGoID] = INVALID_PLAYER_ID;
	GotoInfo[playerid][gtState] = 0;
	GotoInfo[playerid][gtStayed] = 0;
	return true;
}
SetPlayerFaceToPoint(playerid, Float:X, Float:Y)
{
	new Float:angle;
	new Float:misc = 5.0;
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	angle = 180.0-atan2(x-X,y-Y);
	angle += misc;
	misc *= -1;
	SetPlayerFacingAngle(playerid, angle+misc);
	return true;
}
TurnPlayerFaceToPlayer(playerid, facingtoid)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(facingtoid, x, y, z);
	SetPlayerFaceToPoint(playerid, x, y);
	return true;
}
GoPlayerAnimation(playerid, Float:X, Float:Y, Float:Z)
{
	if(IsPlayerInAnyVehicle(playerid)) return false;
	if(IsPlayerInRangeOfPoint(playerid, 2.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "IDLE_STANCE", 4.1, 0, 1, 1, 0, 0, 1);
	if(IsPlayerInRangeOfPoint(playerid, 4.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "WALK_PLAYER", 4.1, 0, 1, 1, 0, 0, 1);
	if(IsPlayerInRangeOfPoint(playerid, 7.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "RUN_GANG1", 4.1, 0, 1, 1, 0, 0, 1);
	ApplyAnimation(playerid, "PED", "SPRINT_PANIC", 4.1, 0, 1, 1, 0, 0, 1);\
	return true;
}
ShiftCords(style, &Float:x, &Float:y, Float:a, Float:distance)
{
	switch(style)
	{
	case 0:
		{
			x += (distance * floatsin(-a, degrees));
			y += (distance * floatcos(-a, degrees));
		}
	case 1:
		{
			x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
	default: return false;
	}
	return true;
}
AddRublevkaHouse(playerid)
{
	TOTALHOUSE++;
	HouseInfo[TOTALHOUSE][hEntrx] = house_posX[playerid];
	HouseInfo[TOTALHOUSE][hEntry] = house_posY[playerid];
	HouseInfo[TOTALHOUSE][hEntrz] = house_posZ[playerid];

	format(string,90,"2415.5125,286.9295,1401.0000,4,9");
	sscanf(coordh,"p<,>ffff",
	HouseInfo[TOTALHOUSE][helicopter_housepos][0],HouseInfo[TOTALHOUSE][helicopter_housepos][1],HouseInfo[TOTALHOUSE][helicopter_housepos][2],HouseInfo[TOTALHOUSE][helicopter_housepos][3]);
	sscanf(string,"p<,>fffii",
	HouseInfo[TOTALHOUSE][hExitx],HouseInfo[TOTALHOUSE][hExity],HouseInfo[TOTALHOUSE][hExitz],
	HouseInfo[TOTALHOUSE][hDiscript],HouseInfo[TOTALHOUSE][hInt]);
	HouseInfo[TOTALHOUSE][hVirtual] = TOTALHOUSE;

	HouseInfo[TOTALHOUSE][hPrice] = rublevka_cost[playerid];
	HouseInfo[TOTALHOUSE][hRublevka] = 1;
	HouseInfo[TOTALHOUSE][hOwned] = -1;

	strmid(HouseInfo[TOTALHOUSE][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
	HouseInfo[TOTALHOUSE][hMIcon] = CreateDynamicMapIcon(HouseInfo[TOTALHOUSE][hEntrx], HouseInfo[TOTALHOUSE][hEntry], HouseInfo[TOTALHOUSE][hEntrz], 31, 0);
	HouseInfo[TOTALHOUSE][hPickup] = CreatePickup(1273,1, HouseInfo[TOTALHOUSE][hEntrx], HouseInfo[TOTALHOUSE][hEntry], HouseInfo[TOTALHOUSE][hEntrz]);
	HouseInfo[TOTALHOUSE][hPickupExit] = CreateDynamic3DTextLabel(""cWH"Для выхода введите:\n"cMain"/exit\n"cWH"Управление домом: \n"cMain"/home",COLOR_WHITE,HouseInfo[TOTALHOUSE][hExitx], HouseInfo[TOTALHOUSE][hExity], HouseInfo[TOTALHOUSE][hExitz],2.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,HouseInfo[TOTALHOUSE][hVirtual],HouseInfo[TOTALHOUSE][hInt]);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `house` (`id`, `hEntrx`, `hEntry`, `hEntrz`, `hExitx`, `hExity`, `hExitz`, `hDiscript`, `hPrice`, `hInt`, `hVirtual`, `hRublevka`, `hVertX`, `hVertY`, `hVertZ`, `hVertA`)\
	VALUES ('%d', '%f', '%f', '%f', '%f', '%f', '%f', '%d', '%d', '%d', '%d', '1', '%f', '%f', '%f', '%f')",
	TOTALHOUSE,
	HouseInfo[TOTALHOUSE][hEntrx],HouseInfo[TOTALHOUSE][hEntry],HouseInfo[TOTALHOUSE][hEntrz],
	HouseInfo[TOTALHOUSE][hExitx],HouseInfo[TOTALHOUSE][hExity],HouseInfo[TOTALHOUSE][hExitz],
	HouseInfo[TOTALHOUSE][hDiscript],HouseInfo[TOTALHOUSE][hPrice],HouseInfo[TOTALHOUSE][hInt],HouseInfo[TOTALHOUSE][hVirtual],
	HouseInfo[TOTALHOUSE][helicopter_housepos][0],HouseInfo[TOTALHOUSE][helicopter_housepos][1],HouseInfo[TOTALHOUSE][helicopter_housepos][2],HouseInfo[TOTALHOUSE][helicopter_housepos][3]);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	UpdateCupboard(TOTALHOUSE);

	for(new i; i < 3; i++) strmid(HouseArendName[TOTALHOUSE][i], "none", 0, strlen("none"), 10);
	SetPlayerPos(playerid, house_posX[playerid], house_posY[playerid], house_posZ[playerid]);
	SendMes(playerid,COLOR_LIME,"Дом №%d Успешно создан (Рублевка)",TOTALHOUSE);

	rublevka_cost[playerid] = 0;
	house_posX[playerid] =
	house_posY[playerid] =
	house_posZ[playerid] = 0.0;
	fLogs("[admin] %s /add дом рублёвка %i [%f %f %f]", GetName(playerid), TOTALHOUSE, HouseInfo[TOTALHOUSE][hEntrx], HouseInfo[TOTALHOUSE][hEntry], HouseInfo[TOTALHOUSE][hEntrz]);
	return 1;
}

callback::OnPlayerDivorce(targetid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		global_string = "";
		mysql_format(db_prod, global_string, 128, "UPDATE `accounts` SET married = 0, whomarried = 'None' WHERE name = '%s'",PI[targetid][pName]);
		mysql_tquery(db_prod, global_string, "", "");
	}
	return 1;
}
ProtectionServerAdmin(playerid)
{
	if(!PI[playerid][pAdmin]) return 1;
	if(admin_warning_attempt[playerid] >= 4 && admin_warning_time[playerid] > GetTickCount())
	{
		RemoveAdmin(playerid, GetName(playerid));

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `bans` (`name`, `whobanned`, `ip`, `bandate`, `time`, `reason`) VALUES ('%e', 'System', '%s', '%02d.%02d.%04d', '10', 'Подозрение на слив')", GetName(playerid), PI[playerid][pIP], day, month, year);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
		for(new idx; idx < 10; idx++) SendClientMessage(playerid, -1, "");
		SendClientMessage(playerid, 0xFA661CFF, "["SERVER_NAME"]: {E6B420}Ваш аккаунт на сервере был заблокирован на сервере по подозрению в сливе или перебане игроков");
		SendClientMessage(playerid, 0xFA661CFF, "["SERVER_NAME"]: {E6B420}Если Вы считаете, что произошла ошибка, обратитесь к высшей администрации сервера");
		SendMes(playerid, 0xFA661CFF, "["SERVER_NAME"]: {E6B420}Дата: %02d.%02d.%04d | Время: %02d:%02d:%02d | Пинг: %d", day, month, year, hour, minute, second, GetPlayerPing(playerid));
		new fmt_str[128];
		format(fmt_str, sizeof fmt_str, "[A] Администратор %s(%d) был заблокирован на сервере. Причина: подозрение на слив", GetName(playerid), playerid);
		SendClientMessageToAll(COLOR_RED, fmt_str);
		fLogs("[admin] %s снят, подозрение на слив", GetName(playerid));
		KickEx(playerid, "sliv");
	}
	else
	{
		admin_warning_attempt[playerid] ++;
		admin_warning_time[playerid] = GetTickCount()+7000;
	}
	return 1;
}
UpdateFightsText()
{
	new f_text[2][24];

	if(!strcmp(fights_player[0], "None", true)) f_text[0] = "Нет";
	else format(f_text[0], 24, "%s", fights_player[0]);

	if(!strcmp(fights_player[1], "None", true)) f_text[1] = "Нет";
	else format(f_text[1], 24, "%s", fights_player[1]);

	global_string = "";

	if(fights_timer <= 0)
	{
		format(global_string, 100,"{46b8f8}- Бойцовский клуб -\n\n\n{ff4700}Бой не начался\nПрием ставок закрыт");
	}
	else
	{
		format(global_string, 150,"{46b8f8}- Бойцовский клуб -\n\n"cWH"Боец №1: %s\nБоец №2: %s\nСумма ставок: %d руб.\nВремя до начала боя: %s", f_text[0], f_text[1], fights_bank, ConvertSeconds(fights_timer));
	}

	UpdateDynamic3DTextLabelText(fights_text,0xFFFFFFFF, global_string);

}

callback::BuyYacht_C(playerid, owner_id, price)
{
	if(cache_num_rows())
	{
		SendMes(owner_id, COLOR_GREY, "У игрока %s уже имеется яхта", GetName(playerid));
		SendClientMessage(playerid, COLOR_RED, "Ошибка: у Вас уже есть яхта");
		return 1;
	}
	if(GetPlayerLimitMoney(owner_id, price))
	{
		SendErr(playerid, "У игрока максимальное количество денег.");
		SendErr(owner_id, "У Вас максимальное количество денег.");
		return 1;
	}
	mysql_format(db_prod, global_string, 100, "UPDATE yacht SET y_owner='%s' WHERE y_owner='%s'", GetName(playerid), GetName(owner_id));
	mysql_tquery(db_prod, global_string, "", "");

	SendClientMessage(playerid, COLOR_GREEN, "Поздравляем Вас с покупкой яхты! Меню управления яхтой - /yacht");
	SendClientMessage(owner_id, COLOR_GREEN, "Поздравляем Вас с продажей яхты!");

	SetPlayerMoney(playerid, -price);
	SetPlayerMoney(owner_id, price);

	if(PI[owner_id][YachtID] != INVALID_VEHICLE_ID)
	{
		DestroyVehicle(PI[owner_id][YachtID]);
		PI[owner_id][YachtID] = INVALID_VEHICLE_ID;
		ClearYachtData(owner_id);
	}
	return 1;
}

callback::BuyHelic_C(playerid, owner_id, price)
{
	if(cache_num_rows())
	{
		SendMes(owner_id, COLOR_GREY, "У игрока %s уже имеется вертолет", GetName(playerid));
		SendClientMessage(playerid, COLOR_RED, "Ошибка: у Вас уже есть вертолет");
		return 1;
	}
	if(GetPlayerLimitMoney(owner_id, price))
	{
		SendErr(playerid, "У игрока максимальное количество денег.");
		SendErr(owner_id, "У Вас максимальное количество денег.");
		return 1;
	}
	mysql_format(db_prod, global_string, 100, "UPDATE helicopters SET h_owner='%s' WHERE h_owner='%s'", GetName(playerid), GetName(owner_id));
	mysql_tquery(db_prod, global_string, "", "");

	SendClientMessage(playerid, COLOR_GREEN, "Поздравляем Вас с покупкой вертолета! Загрузить вертолет можно командой: /fixcopter");
	SendClientMessage(owner_id, COLOR_GREEN, "Поздравляем Вас с продажей вертолета!");

	SetPlayerMoney(playerid, -price);
	SetPlayerMoney(owner_id, price);

	if(PI[owner_id][HelicopterID] != INVALID_VEHICLE_ID)
	{
		DestroyVehicle(PI[owner_id][HelicopterID]);
		PI[owner_id][HelicopterID] = INVALID_VEHICLE_ID;
		ClearHelicopterData(owner_id);
	}
	return 1;
}


callback::fixcar_C(playerid)
{
	new rows = cache_num_rows();
	if(!rows) return SendClientMessage(playerid, COLOR_RED, "Ошибка: у Вас нет автомобилей");

	new car_number[64], fmt_status[50], car_model, car_arrest, arrest_str[24], id;
	global_string = "";
	for(new idx = 0; idx < rows; idx++)
	{
		cache_get_field_content(idx, "c_number", car_number, db_prod, 64);
		id = cache_get_field_content_int(idx, "id");
		car_model = cache_get_field_content_int(idx, "c_model");

		if(car_model == 0) continue;

		car_arrest = cache_get_field_content_int(idx, "c_arrest");
		new status_car = cache_get_field_content_int(idx, "c_status");
		if(status_car == 1 && GetPlayerVehicleStatus(playerid, id)) format(fmt_status,sizeof(fmt_status), "{41BB36}[Загружена]");
		else
		{
			format(stringer1, 170, "UPDATE `ownable_cars` SET c_status = '0' WHERE c_owner = '%s' AND id = '%d'", GetName(playerid), id);
			mysql_tquery(db_prod, stringer1, "", "");
			fmt_status = "{EF3A0C}[Не загружена]";
		}
		if(car_arrest) arrest_str = " - {ff0000}Под арестом";
		else arrest_str = "";

		format(global_string, sizeof global_string, "%s{F27208}Автомобиль "cWH"%s — %s — %s%s\n", global_string, VehicleNames[car_model-400], car_number, fmt_status,arrest_str);
		SetPlayerListitemValue(playerid, idx, id);
	}
	ShowPlayerDialog(playerid, 13467, DIALOG_STYLE_LIST, ""cMain"Выберите автомобиль из списка:", global_string, "Выбрать", "Отмена");
	return 1;
}

callback::CountCars_C(playerid)
{
	new rows = cache_num_rows();
	if(PI[playerid][pCountCars] < rows+1) return SendClientMessage(playerid, COLOR_RED, "Для покупки нового автомобиля, нужно купить доп. слоты авто в /donate");

	new cost, model;

	if(g_player_salon[playerid] == 1) cost = carsC[pPressed[playerid]][1], model = carsC[pPressed[playerid]][0];
	else cost = carsC[pPressed[playerid]][1], model = carsC[pPressed[playerid]][0];

	if(PI[playerid][pCash] < cost) return SendClientMessage(playerid, COLOR_GREY, "На вашем счету не хватает денег!");

	global_string = "";
	mysql_format(db_prod, global_string, 500, "\
			INSERT INTO `ownable_cars` (c_model, c_x, c_y, c_z, c_a, c_class, c_owner, c_fuel, c_color1, c_color2, c_lock, c_price, c_health) VALUES \
			('%d', '0', '0', '0', '0', '%d', '%s', '45', '%d', '%d', '1', '%d', '1000.0')",
	model, g_player_salon[playerid], GetName(playerid), colors[playerid][0], colors[playerid][1], cost);
	mysql_tquery(db_prod, global_string, "", "");
	fLogs("[cars] %s +%i %i %i автосалон", GetName(playerid), model, colors[playerid][0], colors[playerid][1]);

	ShowPlayerDialog (playerid,000,DIALOG_STYLE_MSGBOX,""cMain"Автомобиль", ""cWH"Поздравляем Вас с покупкой автомобиля!\n\
	Ваш автомобиль был отбуксирован на автостоянку\n\n\
	Для загрузки автомобиля в игру, используйте: "cMain"/car\n\
	"cWH"Для поиска личного автомобиля, используйте: "cMain"/findcar\n\n\
	"cWH"Для получения доп. сведений об управлении Т/С - "cMain"/cmd -> Транспорт","Закрыть", "");

	SetPlayerMoney(playerid, -cost);
	BuyCloseCar(playerid);
	return 1;
}
callback::CountCars_Containers(playerid, model)
{
	new rows = cache_num_rows();
	if(PI[playerid][pCountCars] < rows+1) PI[playerid][pCountCars] ++;

	global_string = "";
	mysql_format(db_prod, global_string, 500, "\
			INSERT INTO `ownable_cars` (c_model, c_x, c_y, c_z, c_a, c_class, c_owner, c_fuel, c_color1, c_color2, c_lock, c_price, c_health) VALUES \
			('%d', '0', '0', '0', '0', '%d', '%s', '45', '%d', '%d', '1', '9000000', '1000.0')",
	model, 1, GetName(playerid), colors[playerid][0], colors[playerid][1]);
	mysql_tquery(db_prod, global_string, "", "");

	fLogs("[cars] %s +%i %i %i контейнер", GetName(playerid), model, colors[playerid][0], colors[playerid][1]);
	ShowPlayerDialog (playerid,000,DIALOG_STYLE_MSGBOX,""cMain"Автомобиль", ""cWH"Поздравляем Вас с получением автомобиля!\n\
	Ваш автомобиль был отбуксирован на автостоянку\n\n\
	Для загрузки автомобиля в игру, используйте: "cMain"/car\n\
	"cWH"Для поиска личного автомобиля, используйте: "cMain"/findcar\n\n\
	"cWH"Для получения доп. сведений об управлении Т/С - "cMain"/cmd -> Транспорт","Закрыть", "");
	return 1;
}
callback::OnPlayerCheckNumberDonate(playerid, number[])
{
	if(cache_num_rows()) return SendClientMessage(playerid, COLOR_RED, "Номер уже используется, придумайте новый и повторите попытку..");
	PI[playerid][pPerfectCoins] -= 500;
	MysqlUpdatePlayerInt(playerid, "credits", PI[playerid][pPerfectCoins]);
	fLogs("[coin] %s -500 номер тачки", GetName(playerid));

	new
		number_plate[32],
		query[256];


	car_id[playerid] = GetPlayerVehicleSqlID(playerid);

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", car_id[playerid]);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();
	if(rows > 0)
	{
		cache_get_field_content(0, "c_number", number_plate, db_prod, 32);
	}
	cache_delete(result);

	new numbercar[40];

	strcat(numbercar, ColorNumber[playerid]);
	strcat(numbercar, number);
	nstrmid(number_plate, numbercar);

	new
		vehid = GetPlayerVehicleID(playerid);

	if(VehicleLabel[vehid] != INVALID_3DTEXT_ID) UpdateVehicleLabel(vehid, 0xFFFFFFFF, number_plate);

	SetPlayerCarNumber(vehid, number_plate);

	global_string = "";
	format(global_string, 120, "UPDATE `ownable_cars` SET c_number = '%s' WHERE id = '%i'",number_plate, car_id[playerid]);
	mysql_tquery(db_prod, global_string,"", "");

	SendFormatInf(playerid, "Вы успешно купили номер: %s . Для корректного отображения перезагрузите ваше авто.", number_plate);
	return 1;
}
callback::DonateNumber_C(playerid)
{
	if(cache_num_rows() > 0)
	{
		FirstLetter[playerid][0] =
		SecondLetter[playerid][0] =
		ThirdLetter[playerid][0] =
		Region[playerid][0] =
		ColorNumber[playerid][0] =
		figures[playerid][0] = EOS;
		SendClientMessage(playerid, COLOR_RED, "Номер уже используется, придумайте новый и повторите попытку..");
		return 1;
	}

	car_id[playerid] = GetPlayerVehicleSqlID(playerid);

	new
		number_plate[32],
		query[256];

	format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", car_id[playerid]);
	new Cache:result = mysql_query(db_prod, query);
	new rows = cache_num_rows();
	if(rows > 0)
	{
		cache_get_field_content(0, "c_number", number_plate, db_prod, 32);
	}
	cache_delete(result);

	if(strcmp(number_plate,"None",true))
	{
		global_string = "";
		format(global_string, 120, "UPDATE `ownable_numbers` SET is_used = 0 WHERE number = '%s'",number_plate);
		mysql_tquery(db_prod, global_string,"", "");
	}

	new labelcar[65];
	format(labelcar, 64, "%s%s%s%s %s| %sRUS", FirstLetter[playerid], figures[playerid], SecondLetter[playerid], ThirdLetter[playerid], ColorNumber[playerid], Region[playerid]);
	format(string, sizeof string, "{78A94D}%s", labelcar);
	strmid(number_plate, labelcar, 0, strlen(labelcar), 150);

	MysqlUpdatePlayerInt(playerid,"credits",PI[playerid][pPerfectCoins]-200);
	PI[playerid][pPerfectCoins] -= 200;
	fLogs("[coin] %s -200 номер тачки", GetName(playerid));
	SendClientMessage(playerid, -1, ""cDA"Вы успешно приобрели новый номер для автомобиля!");

	FirstLetter[playerid][0] =
	SecondLetter[playerid][0] =
	ThirdLetter[playerid][0] =
	Region[playerid][0] =
	ColorNumber[playerid][0] =
	figures[playerid][0] = EOS;

	new
		vehid = GetPlayerVehicleID(playerid);

	if(VehicleLabel[vehid] != INVALID_3DTEXT_ID) UpdateVehicleLabel(vehid, 0xFFFFFFFF, string);

	SetPlayerCarNumber(vehid, number_plate);

	global_string = "";
	format(global_string, 120, "UPDATE `ownable_cars` SET c_number = '%s' WHERE id = '%i'",number_plate, car_id[playerid]);
	mysql_tquery(db_prod, global_string,"", "");
	return 1;
}

callback::DPSNumber_C(playerid)
{
	if(!cache_num_rows()) return 1;

	cache_get_field_content(0, "number", PlayerLoadNumber[playerid], db_prod, 10);
	ShowPlayerDialog(playerid, 2570, DIALOG_STYLE_MSGBOX, ""cMain"Покупка номеров", "Вы действительно хотите купить номера?", "Принять", "Отмена");

	return 0x1;
}

DLG(2570, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `ownable_numbers` SET is_used = 1 WHERE number = '%s'", PlayerLoadNumber[playerid]);
	mysql_tquery(db_prod, STRING_GLOBAL,"", "");

	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pMember] == TEAM_MVD) SendMes(i, 0x3399FFFF, "[Пункт выдачи номеров] %s[%d] зарегистрировал номер на авто #1 [%s]", GetName(playerid), playerid, PlayerLoadNumber[playerid]);
	}

	new
		vehid;
	for(new i; i < MAX_LOAD_VEHICLE; i++)
	{
		if(PlayerVehicleSQL[playerid][i] == car_id[playerid])
		{
			vehid = PlayerVehicle[playerid][i];
			break;
		}
	}
	new
		car_number[32],
		strings[74];
	format(strings, sizeof strings, "{78A94D}%s", PlayerLoadNumber[playerid]);
	strmid(car_number, PlayerLoadNumber[playerid], 0, strlen(PlayerLoadNumber[playerid]), 64);

	SetPlayerMoney(playerid, -100000);
	nomercar[playerid] = unix + 600;
	if(VehicleLabel[vehid] != INVALID_3DTEXT_ID) UpdateVehicleLabel(vehid, 0xFFFFFFFF, strings);

	SetPlayerCarNumber(vehid, car_number);

	new
		querys[256];
	mysql_format(db_prod, querys, 256, "UPDATE `ownable_cars` SET `c_number` = '%s'  WHERE `id` = '%i' LIMIT 1", car_number, car_id[playerid]);
	mysql_tquery(db_prod, querys, "", "");


	SendClientMessage(playerid, 0xCCCCCCFF, ""cDA"Вы успешно купили автомобильный номер, купленный номер показан на экране");
	for(new i = 0; i != 12; i ++) PlayerTextDrawShow(playerid, TD_NUMBER_PD[playerid][i]);
	PlayerTextDrawSetString(playerid, TD_NUMBER_PD[playerid][9], PlayerLoadNumber[playerid]);
	SelectTextDrawEx(playerid, 0x00000050);
	return 0x1;
}

callback::ClearAStats(playerid, a_name[])
{
	if(!cache_num_rows()) return SendClientMessage(playerid, COLOR_RED, "Ошибка в написании ник-нейма, либо игрок не администратор");
	mysql_format(db_prod, global_string, 1000, "UPDATE `admin` SET `sunday` = '0,0,0,0,0,0,0', `monday` = '0,0,0,0,0,0,0', `tuesday` = '0,0,0,0,0,0,0', `wednesday` = '0,0,0,0,0,0,0', `thursday` = '0,0,0,0,0,0,0', `friday` = '0,0,0,0,0,0,0', `saturday` = '0,0,0,0,0,0,0', act_time = '0' WHERE `name` = '%s'", a_name);
	mysql_tquery(db_prod, global_string, "", "");

	format(global_string, 128, "[A] Администратор %s обнулил статистику администратора %s", GetName(playerid), a_name);
	SendAdminMessage(COLOR_GREY, global_string);
	fLogs("[admin] %s /resetoffastats %s", GetName(playerid), a_name);
	return 1;
}

callback::CheckMail(playerid,inputtext[])
