	if(price < 0 || price > 200) return ShowPlayerDialog(playerid, 77+18, 1, ""cMain"Панель", ""cWH"Введите цену гос. налога\n\n{FFFF00}Примечание:\n"cWH"Цена может быть от 0 до 200", "Принять", "Отмена");
