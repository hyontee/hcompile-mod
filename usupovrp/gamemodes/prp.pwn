stock GetFamilyOnline(fam_id)
{
	new
		count = 0;

	foreach(new i : Player)
	{
		if(PI[i][pFamily] == fam_id)
			count++;
	}
	return count;
}

callback:: GetFamilyAllMembers(fam_id)
{
	format(String144, sizeof(String144), "SELECT * FROM `accounts` WHERE `family` = '%i'", fam_id);
	new Cache:result = mysql_query(db_prod, String144);

	new rows = cache_num_rows();
	cache_delete(result);

	return rows;
}

stock GetVehicleType(vehicle)
{
	vehicle = GetVehicleModel(vehicle);
	switch(vehicle)
	{
		case 403,408,413,414,422,440,443,455,456,459,482,498,499,514,515,524,578,582,609,407,416,427,431,433,437,544,601: return 1; //Рабочие машины
		case 417,425,447,469,487,488,497,548,563: return 2; //Вертолёты
		case 460,476,511,512,513,519,520,553,577,592,593: return 3; //Самолёты
		case 462: return 4; // Мопед
		case 430,446,452,453,454,472,473,484,493,595: return 5; // Лодки
		case 461,463,468,471,521,522,523,581,586,448: return 6; // Байки
		case 481,509,510: return 7; // Велики
	}
	return 0; //Обычные авто
}
RestrictVehicle(model)
{
	switch(model)
	{
		case 425, 430, 432, 447, 449, 464, 465, 476, 501, 512, 520, 523, 532, 537, 538, 553, 569, 570, 577, 590, 591, 592, 601, 606, 607, 608, 610, 611, 521: return 1;
		default: return 0;
	}
	return 0;
}
public OnPlayerCommandText(playerid, cmdtext[])
{
	return 0;
}
CMD:listening(playerid)
{
	if(PI[playerid][pMember] != TEAM_FSB) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(PI[playerid][pRank] < 5) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);

	if(PI[playerid][pListening] != 0)
	{
		PI[playerid][pListening] = 0;
		return SendClientMessage(playerid, COLOR_DARKORANGE, "Вы отключили прослушивание организаций");
	}
	global_string = ""cWH"";
	for(new i = 1; i < 12; i++)
	{
		format(global_string, 1000, "%s%d - %s\n", global_string, i, Fraction_Name[i]);
	}
	ShowPlayerDialog(playerid, 9000, 2, ""cMain"Выберите организацию", global_string, "Далее", "Отмена");
	return 1;
}

DLG(9000, playerid, response, listitem, inputtext[])
{
	if(!response || listitem < 0) return 1;
	new fractionid = listitem + 1;
	PI[playerid][pListening] = fractionid;
	SCMF(playerid, COLOR_LIME, "Вы начали прослушивание организации: %s", Fraction_Name[fractionid]);
	return 1;
}

callback::UpdateDonateLabel()
{
	new rows;
	new fields;
	new AllDonate;
	new PlayerName[24];

	stringer = "";

	cache_get_data(rows, fields);
	if(rows)
	{
		stringer = ""cMain"Топ донатеры:"cWH"\n\n";
		for(new i = 0; i != rows; i++)
		{
			cache_get_field_content(i, "name", PlayerName, db_prod, MAX_PLAYER_NAME);
			AllDonate = cache_get_field_content_int(i, "AllDonate");

			format(stringer, sizeof(stringer), "%s"cMain"%s "cWH"- %d "SERVER_COINS"\n", stringer, PlayerName, AllDonate);
		}
		if(!IsValidDynamic3DTextLabel(DonateLabel[0])) DonateLabel[0] = CreateDynamic3DTextLabel(stringer, 0xFFFFFFFF, 461.3614,1686.9437,12.1884, 20.0);
		else UpdateDynamic3DTextLabelText(DonateLabel[0], 0xFFFFFFFF, stringer);

		if(!IsValidDynamic3DTextLabel(DonateLabel[1])) DonateLabel[1] = CreateDynamic3DTextLabel(stringer, 0xFFFFFFFF, 2514.1091,-2143.9565,21.9766, 20.0);
		else UpdateDynamic3DTextLabelText(DonateLabel[1], 0xFFFFFFFF, stringer);

		if(!IsValidDynamic3DTextLabel(DonateLabel[2])) DonateLabel[2] = CreateDynamic3DTextLabel(stringer, 0xFFFFFFFF, 1808.7202,2511.8250,15.6717, 20.0);
		else UpdateDynamic3DTextLabelText(DonateLabel[2], 0xFFFFFFFF, stringer);

	}
	return 0x1;
}

callback::CheckMainSub(playerid, targetid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		playerNameSubMain[playerid] = cache_get_field_content_int(0, "id");
		ShowPlayerDialog(playerid, 8572, DSI,""cMain"Заместитель", ""cWH"В Вашей организации уже есть главный заместитель\nВы можете ввести ID нового заместителя в строку ниже:","Далее", "Закрыть");
		return 1;
	}
	else
	{
		PI[targetid][pMainSub] = 1;
		SCMF(targetid, COLOR_LIME, "%s %s назначил Вас главным заместителем организации %s", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), Fraction_Name[PI[playerid][pMember]]);
		SCMF(playerid, COLOR_LIME, "Вы назначили %s главным заместителем организации %s", GetName(targetid), Fraction_Name[PI[playerid][pMember]]);
		MysqlUpdatePlayerInt(targetid, "mainsub", PI[targetid][pMainSub]);
	}
	return 1;
}
DerbyStart()
{
	if(gDerbyStatus != 2) return printf("[DERBY] ERROR START");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Мероприятие 'Дерби' началось");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация закрыта");

	gDerbyWinners[0] =
	gDerbyWinners[1] =
	gDerbyWinners[2] = INVALID_PLAYER_ID;
	gDerbyLastSpawn = 0;

	foreach(new playerid: Player) if(playerGameDerby{playerid})
	{
		SetPlayerVirtualWorld(playerid, 1);
		SetPlayerInterior(playerid, 30);
		ResetPlayerWeapons(playerid);

		new pos = gDerbyLastSpawn;
		playerDerbyVehicleID[playerid] = CreateVehicle(444, DerbySpawn[pos][0], DerbySpawn[pos][1], DerbySpawn[pos][2], random(255), random(255), 90000);
		SetVehicleVirtualWorld(playerDerbyVehicleID[playerid], 1);
		LinkVehicleToInterior(playerDerbyVehicleID[playerid], 30);
		PutPlayerInVehicle(playerid, playerDerbyVehicleID[playerid], 0);
		gDerbyLastSpawn ++;
	}
	return 1;
}

EndDerby()
{
	if(gDerbyStatus != 2) return printf("[DERBY] ERROR END");
	SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Мероприятие 'Дерби' завершилось.");

	foreach(new to_player: Player) if(playerGameDerby{to_player})
	{
		DestroyVehicle(playerDerbyVehicleID[to_player]);
		playerDerbyVehicleID[to_player] = 0;
		ResetPlayerWeapons(to_player);
		SpawnPlayer(to_player);
		break;
	}
	if(gDerbyWinners[0] != INVALID_PLAYER_ID)
	{
		PI[gDerbyWinners[0]][pPerfectCoins] += event_derby_prize[0];
		UpdatePlayerData(gDerbyWinners[0], "credits", PI[gDerbyWinners[0]][pPerfectCoins]);
		fLogs("[coin] %s +%i дерби 1", GetName(gDerbyWinners[0]), event_derby_prize[0]);
		SCMF(gDerbyWinners[0], 0xFFCC00AA, "За первое место в 'Дерби' Вам было выдано %d "SERVER_COINS"", event_derby_prize[0]);
	}
	if(gDerbyWinners[1] != INVALID_PLAYER_ID)
	{
		PI[gDerbyWinners[1]][pPerfectCoins] += event_derby_prize[1];
		UpdatePlayerData(gDerbyWinners[1], "credits", PI[gDerbyWinners[1]][pPerfectCoins]);
		fLogs("[coin] %s +%i дерби 2", GetName(gDerbyWinners[1]), event_derby_prize[1]);
		SCMF(gDerbyWinners[1], 0xFFCC00AA, "За второе место в 'Дерби' Вам было выдано %d "SERVER_COINS"", event_derby_prize[1]);
	}
	if(gDerbyWinners[2] != INVALID_PLAYER_ID)
	{
		PI[gDerbyWinners[2]][pPerfectCoins] += event_derby_prize[2];
		UpdatePlayerData(gDerbyWinners[2], "credits", PI[gDerbyWinners[2]][pPerfectCoins]);
		fLogs("[coin] %s +%i дерби 3", GetName(gDerbyWinners[2]), event_derby_prize[2]);
		SCMF(gDerbyWinners[2], 0xFFCC00AA, "За третье место в 'Дерби' Вам было выдано %d "SERVER_COINS"", event_derby_prize[2]);
	}
	gDerbyWinners[2] =
	gDerbyWinners[1] =
	gDerbyWinners[0] = INVALID_PLAYER_ID;
	gDerbyCount =
	gDerbyStatus = 0;
	return 1;
}

