DLG(12007, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!listitem)
	{
		switch(Mfon[playerid][p_mfon])
		{
		case 0:
			{
				foreach(new i:Player)
				{
					if(IsPlayerInDynamicArea(playerid,Mfon[i][p_area])) return SendClientMessage(playerid,COLOR_GRAD1,"В этом месте уже установлен магнитофон, попробуйте поставить в другом месте");
				}
				ShowPlayerDialog(playerid,12008,DIALOG_STYLE_LIST, ""cMain"Выбор радиостанции.","{808080}1."cWH" Zaycev FM.\n{808080}2."cWH" Европа+.\n{808080}3."cWH" Radio Record.\
				\n{808080}4."cWH" Авторадио.\n{808080}5."cWH" Радио шансон.\n{808080}6."cWH" Наше радио.","Выбрать","Отмена");
			}
		case 1:
			{
				if(!PlayerToPoint(3.0, playerid, Mfon[playerid][p_fonpos][0],  Mfon[playerid][p_fonpos][1],  Mfon[playerid][p_fonpos][2])) return SendClientMessage(playerid,COLOR_GRAD1,#Вы должны быть рядом с магинтофоном!);
				Stop_MFon(playerid);
			}
		}
	}
	else
	{
		if(!PlayerToPoint(3.0, playerid, Mfon[playerid][p_fonpos][0],  Mfon[playerid][p_fonpos][1],  Mfon[playerid][p_fonpos][2])) return SendClientMessage(playerid,COLOR_GRAD1,#Вы должны быть рядом с магинтофоном!);
		ShowPlayerDialog(playerid,12008,DIALOG_STYLE_LIST, ""cMain"Выбор радиостанции.","{808080}1."cWH" Zaycev FM.\n{808080}2."cWH" Европа+.\n{808080}3."cWH" Radio Record.\
		\n{808080}4."cWH" Авторадио.\n{808080}5."cWH" Радио шансон.\n{808080}6."cWH" Наше радио.","Выбрать","Отмена");
	}
	return 1;
}
DLG(12008, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new str[124];
	switch(listitem)
	{
	case 0: str = "http://www.zaycev.fm:9001/rnb/ZaycevFM(128)";
	case 1: str = "http://s3.radioheart.ru:8043/RH376";
	case 2: str = "http://radiorecord.fm/m3u/rr320-28kbps.m3u";
	case 3: str = "http://stream02.media.rambler.ru/auto128.mp3";
	case 4: str = "http://radiopotok.ru/f/m3u/station_2.m3u";
	case 5: str = "http://radiopotok.ru/f/m3u/station_33.m3u";
	}
	strmid(Mfon[playerid][p_station],str,0,strlen(str));
	if(!Mfon[playerid][p_mfon]) Start_MFon(playerid);
	else Switch_Mfon_St(playerid);
	return 1;
}
DLG(16000, playerid, response, listitem, inputtext[])
{
	if(GetPlayerData(playerid, SalonCarID) == INVALID_VEHICLE_ID) return 1;
	if(!response)
	{
		BuyCloseCar(playerid);
		SendClientMessage(playerid,COLOR_GREEN,"Вы отказались от покупки автомобиля.. Приходите еще!");
		return 1;
	}

	format(stringer1, 128, "SELECT `id` FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "CountCars_C","i",playerid);
	return 1;
}
DLG(9993, playerid, response, listitem, inputtext[])
{
	new Float:PlayerPos[3];
	GetPlayerPos(playerid, PlayerPos[0], PlayerPos[1], PlayerPos[2]);
	foreach(new i:Player)
	{
		if(playerid != i)
		{
			if(GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i) && GetPlayerInterior(playerid) == GetPlayerInterior(i))
			{
				if(PlayerToPoint(50.0, i, PlayerPos[0], PlayerPos[1], PlayerPos[2]))
				{
					if(response)
					{
						TogglePlayerControllable(i, 0);
						SendClientMessage(i, 0xFF6347AA, "Организатор заморозил вас.");
					}
					else
					{
						TogglePlayerControllable(i, 1);
						SendClientMessage(i, 0xFF6347AA, "Организатор снял заморозку.");
					}
				}
			}
		}
	}
	fLogs("[admin] %s /mp заморозка %i", GetName(playerid), response);
	return 1;
}
DLG(9994, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0: callcmd::settp(playerid);
