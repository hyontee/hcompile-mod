DLG(2509, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::donate(playerid);
	if(PI[playerid][pPerfectCoins] < 100) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");
	if(PI[playerid][MobileBank] == 1) return SendClientMessage(playerid, -1, ""cER"У вас уже есть данная привелегия");

	PI[playerid][pPerfectCoins] -= 100;
	PI[playerid][MobileBank] = 1;
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET MobileBank=1, credits=credits-100 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");
	SendClientMessage(playerid, COLOR_LIME, "Вы купили привелегию "cMain"Мобильный банкинг");
	fLogs("[coin] %s -100 Мобильный банкинг", GetName(playerid));
	return 0x1;
}
DLG(4814, playerid, response, listitem, inputtext[])
{
	new veh = GetPlayerVehicleID(playerid);
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			Bonnet_CM[playerid] = Bonnet_CM[playerid] ^ 1;

			GetVehicleParamsEx(veh,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			SetVehicleParamsEx(veh,engine_global,lights_global,alarm_global,doors_global,Bonnet_CM[playerid],boot_global,objective_global);
		}
	case 1:
		{
			Boot_CM[playerid] = Boot_CM[playerid] ^ 1;

			GetVehicleParamsEx(veh,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			SetVehicleParamsEx(veh,engine_global,lights_global,alarm_global,doors_global,bonnet_global,Boot_CM[playerid],objective_global);
			vehicle_boot[veh] = Boot_CM[playerid];
		}
	case 2:
		{
			Alarm_CM[playerid] = Alarm_CM[playerid] ^ 1;

			GetVehicleParamsEx(veh,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			SetVehicleParamsEx(veh,engine_global,lights_global,Alarm_CM[playerid],doors_global,bonnet_global,boot_global,objective_global);
		}
	case 3:
		{
			new _str [ MAX_RADIO * MAX_RAD_NAME + 2] ;
			for( new _r; _r < MAX_RADIO ; ++ _r) strcat( _str, Radio[_r][0] ), strcat( _str,"\n" );
			strcat( _str,"Выключить\n" );
			ShowPlayerDialog(playerid, 18221, DIALOG_STYLE_LIST, ""cMain"Радиоприемник", _str, "Выбрать", "Выкл.");
		}
	}
	return 1;
}
DLG(18221, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new vehid = GetPlayerVehicleID(playerid);
	if(listitem < MAX_RADIO)
	{
		RadioVeh[GetPlayerVehicleID(playerid)] = listitem;
		foreach(new i: Player)
		{
			if(vehid == GetPlayerVehicleID(i))
			{
				StopAudioStreamForPlayer(i);
				PlayAudioStreamForPlayer(i, Radio[listitem][1]);
			}
		}
	}
	else if(listitem >= MAX_RADIO)
	{
		RadioVeh[GetPlayerVehicleID(playerid)] = 0;
		foreach(new i: Player)
		{
			if(vehid == GetPlayerVehicleID(i))
			{
				StopAudioStreamForPlayer(i);
			}
		}
	}
	return 1;
}
DLG(18222, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new vehid = GetPlayerVehicleID(playerid);
	RadioVeh[GetPlayerVehicleID(playerid)] = MAX_RADIO;
	foreach(new i: Player)
	{
		if(vehid == GetPlayerVehicleID(i))
		{
			StopAudioStreamForPlayer(i);
			PlayAudioStreamForPlayer(i, inputtext);
		}
	}
	return 1;
}
DLG(9345, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(listitem == 5)
	{
		if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
		StopAudioStreamForPlayer(playerid);
		player_use_mp3[playerid] = 0;
	}
	else
	{
		static const Radio_List[6][64] = {
			"http://radio02-cn03.akadostream.ru:8108/shanson128.mp3",
			"http://radio02-cn03.akadostream.ru:8112/nashe128.mp3",
			"http://online.radiorecord.ru:8101/rr_128",
			"http://radio.zaycev.fm:9002/ZaycevFM(128).m3u",
			"http://radio.zaycev.fm:9002/ZaycevFM(128).m3u",
			"http://radio.zaycev.fm:9002/rnb/ZaycevFM(128).m3u"
		};
		if(!(IsPlayerAttachedObjectSlotUsed(playerid, 3)))
		{
			ApplyAnimation(playerid, "goggles", "goggles_put_on", 4.1, 0, 0, 0, 0, 0, 1);
			SetPlayerAttachedObject(playerid, 3, 19424, 2, 0.05, 0.0, 0.0, 90.0, 360.0, 270.0);
		}
		player_use_mp3[playerid] = 1;
		PlayAudioStreamForPlayer(playerid, Radio_List[listitem]);
	}
	return 1;
}
DLG(969, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!b_Capture{listitem})
	{
		b_Capture{listitem} = 1;
		SendClientMessage(playerid, COLOR_RED, "Вы включили запрет на капт данной банде!");
		fLogs("[admin] %s /gcontrol %s 1", GetName(playerid), inputtext);
	}
	else
	{
		b_Capture{listitem} = 0;
		SendClientMessage(playerid, COLOR_GREEN, "Вы отключили запрет на капт данной банде!");
		fLogs("[admin] %s /gcontrol %s 0", GetName(playerid), inputtext);
	}
	new Query[75];
	format(Query, sizeof(Query), "UPDATE `gang` SET bcapt_g=%d,bcapt_b=%d,bcapt_r=%d,bcapt_a=%d,bcapt_v=%d", b_Capture{0}, b_Capture{1}, b_Capture{2}, b_Capture{3}, b_Capture{4});
	mysql_tquery(db_prod, Query, "", "");
	ShowDialogGhetto(playerid);
	return 1;
}
DLG(6400, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	SendClientMessage(playerid, COLOR_FADE1, "Вы отказались от аренды транспорта");
	new rc = arendkey[playerid];
	ArendInfo[rc][aPlayerID] = INVALID_PLAYER_ID;
	SetVehicleToRespawn(ArendInfo[rc][aID]);
	CarDoorsEx(ArendInfo[rc][aID], 0);
	return 1;
}
DLG(1431, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(listitem < 3)
		{
			PI[playerid][pSkin][listitem] = PI[playerid][pModel];
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET skin%d=%d WHERE id=%d", listitem+1, PI[playerid][pModel], PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
			SendMes(playerid, -1, ""cPS"Вы выбрали %d полку для одежды. Переодеться можно дома (/home)", listitem+1);
		}
		else SendClientMessage(playerid, -1, ""cPS"Одежда будет на вас");
	}
	return 1;
}
DLG(1212, playerid, response, listitem, inputtext[])
{
	if(!response) return SendClientMessage(playerid, COLOR_GREY, "Шагай тогда отсюда и не возвращайся");
	if(!IsAGang(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Что-то ты не похож на своего. Забудь сюда дорогу! (( Вы должны состоять в банде, чтобы вырубить наркотики ))");
	SendClientMessage(playerid, COLOR_GREEN, "Отправляйся в соседнюю комнату, там ты найдёшь что ищешь.");
	return 1;
}
DLG(1213, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new maximum = strval(inputtext),newslot;
	if(null(inputtext)) return ShowPlayerDialog(playerid,1213,DIALOG_STYLE_INPUT,""cMain"Покупка травы",""cWH"Введите количество пакетиков которое вы хотите купить.","Купить","Отмена");
	if(PI[playerid][pCash] < maximum*40) return ShowPlayerDialog(playerid,1213,DIALOG_STYLE_INPUT,""cMain"Покупка травы",""cWH"Введите количество пакетиков которое вы хотите купить.\n\n{F04245}У вас недостаточно денег!","Купить","Отмена");
	if(maximum < 1 || maximum > 100) return ShowPlayerDialog(playerid,1213,DIALOG_STYLE_INPUT,""cMain"Покупка травы",""cWH"Введите количество пакетиков которое вы хотите купить.\n\n{F04245}Количество не должно превышать 100 грамм!","Купить","Отмена");
	if(CheckMaxVes(playerid,44,maximum,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
	PlayerItem1[playerid][newslot]=44;
	PlayerItem2[playerid][newslot]+=maximum;
	SetPlayerMoney(playerid, -(maximum*40));
	SendClientMessage(playerid, COLOR_YELLOW, "Вот, держи свой товар! Заходи ещё, скоро будет увеличен ассортимент");
	SaveItem(playerid,newslot);
	return 1;
}
DLG(2, playerid, response, listitem, inputtext[])
{
	if(!response) { SendClientMessage(playerid, COLOR_RED, PlayerNeedToLoggedForToPlay); KickEx(playerid, "reg_p_null"); }
	if(null(inputtext))
	{
		format(string, sizeof(string), "\
		"cWH"Добро пожаловать на сервер {ffc0cb}"SERVER_NAME"."cWH"\n\
		Ваш логин: {689ddb}%s"cWH"\n\n\
		Статус аккаунта: {4BCC2B}зарегистрирован"cWH"\n\
		Чтобы начать игру, введите пароль указанный при регистрации:",
		GetName(playerid));
		ShowPlayerDialog(playerid, 2, DIALOG_STYLE_INPUT, ""cMain"Авторизация", string, "Войти", "Отмена");
		return 1;
	}
	if(strcmp(inputtext, PI[playerid][pPassword], false))
	{
		PlayerLogTries[playerid]++;
		if(PlayerLogTries[playerid] == 4)
		{
			SendClientMessage(playerid,COLOR_RED, "Вы несколько раз ввели неверный пароль! Для выхода из игры введите: "cWH"/q(uit)");
			return KickEx(playerid, "reg_p_inv");
		}
		format(stringer1, sizeof(stringer1), ""cWH"Вы ввели неверный пароль!\nУ вас осталось %d попытки", 3 - PlayerLogTries[playerid]);
		ShowPlayerDialog(playerid, 3, DIALOG_STYLE_MSGBOX, ""cMain"Ошибка", stringer1, "Повтор", "Выйти");
		return 1;
	}
	else
	{
		mysql_format(db_prod, stringer1, 144, "SELECT * FROM bans WHERE name = '%e'", GetName(playerid));
		mysql_tquery(db_prod, stringer1, "check_banlist", "i", playerid);
	}
	return 1;
}
DLG(3, playerid, response, listitem, inputtext[])
{
	if(!response) { SendClientMessage(playerid, COLOR_RED, PlayerNeedToLoggedForToPlay); KickEx(playerid, "reg_p_null2"); }
	format(string, sizeof(string), "\
	"cWH"Добро пожаловать на сервер {ffc0cb}"SERVER_NAME"."cWH"\n\
	Ваш логин: {689ddb}%s"cWH"\n\n\
	Статус аккаунта: {4BCC2B}зарегистрирован"cWH"\n\
	Неверно введён пароль от аккаунта,\n\
	убедитесь в правильности введённых вами данных и повторите попытку:",
	GetName(playerid));
	ShowPlayerDialog(playerid, 2, DIALOG_STYLE_INPUT, ""cMain"Авторизация", string, "Войти", "Отмена");
	return 1;
}
DLG(6800, playerid, response, listitem, inputtext[])
{
	if(!response) return SCM(playerid,COLOR_RED,"Без ввода вы не сможете продолжить регистрацию.");
	new age;
	if(sscanf(inputtext, "i", age))
	{
		SendClientMessage(playerid,COLOR_LIME,"Возраст пишите цифрами. Например: 17");
		ShowPlayerDialog(playerid,6800,1,""cMain"Ваш возраст",""cWH"Укажите ваш игровой возраст:","Далее","");
		return 1;
	}
	if(age < 16 || age > 80)
	{
		SendClientMessage(playerid,COLOR_LIME,"Возраст не может быть меньше 16 и не больше 80!");
		ShowPlayerDialog(playerid,6800,1,""cMain"Ваш возраст",""cWH"Укажите ваш игровой возраст:","Далее","");
		return 1;
	}
	PI[playerid][pAge] = age;

	return REG_AGE[playerid] = 1;
}
DLG(13212, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(null(inputtext)) return ShowPlayerDialog(playerid, 13212, DIALOG_STYLE_INPUT, ""cMain"Репорт", ""cWH"Введите ID игрока и причину подачи на него в репорт:", "Отправить","Назад");
	if(AntiFloodRep[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "На отправку репорта/вопроса существует лимит времени, пожалуйста подождите.");

	if(new_report)
	{
		global_string = "";

		if(TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipReport] == 1) format(global_string, sizeof(global_string), "{FF0000}[/ans] %s[%d]: {ffd400}%s", PI[playerid][pName], playerid, inputtext);
		if(TYPE_VIP[playerid] == VIP_STATE_NONE || (TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipReport] == 0)) format(global_string, sizeof(global_string), "{DB5622}[/ans] %s[%d]: {ffd400}%s", PI[playerid][pName], playerid, inputtext);
		SendAdminMessage(0xDB5622FF, global_string);

		STRING_GLOBAL[0] = EOS;

		format(STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `server_stats` SET `reports` = `reports` + '1'");
		mysql_tquery(db_prod, STRING_GLOBAL);

		for(new i; i < MAX_REPORTS; i++)
		{
			if(gReportInfo[i][rPlayerID] != -1) continue;
			gReportInfo[i][rIsTooked] = false;
			gReportInfo[i][rID] = i;
			gReportInfo[i][rAnswer] = -1;
			gReportInfo[i][rPlayerID] = playerid;

			global_string = "";
			format(global_string, sizeof(global_string), "%s", inputtext);
			strmid(gReportInfo[i][rText], global_string, 0, 60, 60);

			gReportInfo[i][rWhenWroted_Time] = unix;
			global_string = "";
			format(global_string, sizeof(global_string), "%02d:%02d:%02d", hour, minute, second);
			strmid(gReportInfo[i][rWhenWroted_Text], global_string, 0, 10, 10);
			playerReportID[playerid] = i;
			break;
		}
	}
	else
	{
		if(TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipReport] == 1) format(stringer1, sizeof(stringer1), "{FF0000}%s[%d]: {ffd400}%s",PI[playerid][pName], playerid, inputtext);
		if(TYPE_VIP[playerid] == VIP_STATE_NONE || (TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipReport] == 0)) format(stringer1, sizeof(stringer1), "{DB5622}%s[%d]: {ffd400}%s",PI[playerid][pName], playerid, inputtext);
		SendAdminMessage(0xDB5622FF, stringer1);

		SCMF(playerid, -1, "{35aa28}%s[%d]: {ffd400}%s", PI[playerid][pName], playerid, inputtext);
	}

	SendClientMessage(playerid, 0x35AA28FF, !"Ожидайте, в ближайшее время на Вашу жалобу отреагирует администратор.");

	if(PI[playerid][pVip]) AntiFloodRep[playerid] = unix + 5;
	else AntiFloodRep[playerid] = unix + 15;
	return 1;
}
DLG(13213, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(null(inputtext)) return ShowPlayerDialog(playerid, 13213, DIALOG_STYLE_INPUT, ""cMain"Задать вопрос", ""cWH"Введите чётко поставленный вопрос:", "Отправить","Назад");
	if(AntiFloodRep[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "На отправку репорта/вопроса существует лимит времени, пожалуйста подождите.");
	if(CheckReport(inputtext)) return BotReport(playerid);

	if(new_report)
	{
		global_string = "";
		format(global_string, sizeof(global_string), "{35aa28}[Вопрос] от %s[%d]: {ffd400}%s", PI[playerid][pName], playerid, inputtext);
		SendAdminMessage(0x35AA28FF, global_string);

		for(new i; i < MAX_REPORTS; i++)
		{
			if(gReportInfo[i][rPlayerID] != -1) continue;
			gReportInfo[i][rIsTooked] = false;
			gReportInfo[i][rID] = i;
			gReportInfo[i][rAnswer] = -1;
			gReportInfo[i][rPlayerID] = playerid;

			global_string = "";
			format(global_string, sizeof(global_string), "%s", inputtext);
			strmid(gReportInfo[i][rText], global_string, 0, 60, 60);

			gReportInfo[i][rWhenWroted_Time] = unix;
			global_string = "";
			format(global_string, sizeof(global_string), "%02d:%02d:%02d", hour, minute, second);
			strmid(gReportInfo[i][rWhenWroted_Text], global_string, 0, 10, 10);
			playerReportID[playerid] = i;
			break;
		}
	}
	else
	{
		format(stringer1, sizeof(stringer1), "{DB5622}%s[%d]: {ffd400}%s",PI[playerid][pName],playerid,inputtext);
		SendAdminMessage(0xDB5622FF, stringer1);

		SCMF(playerid, -1, "{35aa28}%s[%d]: {ffd400}%s", PI[playerid][pName], playerid, inputtext);
	}

	SendClientMessage(playerid, 0x35AA28FF, !"Ожидайте, в ближайшее время на Ваш вопрос отреагирует администратор.");

	if(PI[playerid][pVip]) AntiFloodRep[playerid] = unix + 5;
	else AntiFloodRep[playerid] = unix + 15;
	return 1;
}
DLG(15144, playerid, response, listitem, inputtext[])
{
	if(response) return ShowPlayerStatsDialog(playerid, playerid);
	return 1;
}
