{
	if(!response) return callcmd::family(playerid);
	switch(listitem)
	{
	case 0: ShowPlayerDialog(playerid, 2540, DIALOG_STYLE_INPUT, ""cMain"Положить деньги в общак", ""cWH"Введите кол-во средств, которое хотите положить в общак:", "Далее", "Меню");
	case 1: ShowPlayerDialog(playerid, 2541, DIALOG_STYLE_INPUT, ""cMain"Взять деньги из общака", ""cWH"Введите кол-во средств, которое хотите взять из общака:", "Далее", "Меню");
	}
	return 1;
}
DLG(2540, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	new count = strval(inputtext), f = PI[playerid][pFamily];
	if(null(inputtext) || !isNumeric(inputtext)) return 1;
	if(playerEuro[playerid] < count) return SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно средств");
	if(count < 1 || count > 10000000) return SendClientMessage(playerid, COLOR_RED, "Количество денег от 1 до 10.000.000 euro");
	if(!PI[playerid][pFamilySozd] || PI[playerid][pFamilyZam] && (count > 1000000)) return SendClientMessage(playerid, COLOR_RED, "Обычным членам семьи за раз нельзя класть более 1кк валюты. Лидерам и заместителям без лимита");
	if((family_info[f][f_euro] + count) > 20000000) return SendClientMessage(playerid, COLOR_RED, "Общак переполнен! В него можно положить только до 20.000.000 руб");
	family_info[f][f_euro] += strval(inputtext);

	TransferEuro(playerid, -1, strval(inputtext), "Положил в фаму");

	global_string = "";
	mysql_format(db_prod, global_string, 100, "UPDATE `family_system` SET `fam_euro` = '%d' WHERE `fam_id` = '%d'", family_info[f][f_euro], f);
	mysql_tquery(db_prod, global_string, "","");
	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, "{%s}[F] %s(%s) положил в общак семьи %d евро", family_chat_color[family_info[f][f_chat_color]], GetName(playerid), family_rank_name[f][PI[playerid][pFamilyRank] - 1], count);
	family_message(f, -1, fmt_msg);
	return 1;
}

DLG(2541, playerid, response, listitem, inputtext[])
