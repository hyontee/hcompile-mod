cmd:get(playerid, params[])
{
	if(PI[playerid][pAdmin] < 4) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/get [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "Эту информацию разрешено просматривать только FullDostup");

	format(string, sizeof(string), ""cWH"Ник-нейм аккаунта:\t%s\n\n", GetName(params[0]));
	format(string, sizeof(string), "%sНомер аккаунта:\t%d\n", string, PI[params[0]][pID]);
	format(string, sizeof(string), "%sНаличные:\t%d\n", string, PI[params[0]][pCash]);
	format(string, sizeof(string), "%sОсн. банковский счёт:\t%d\n", string,g_player_bank_accounts[params[0]][PI[params[0]][pMainBankAccount]][B_BALANCE]);
	format(string, sizeof(string), "%sУровень:\t%d\n", string,PI[params[0]][pLevel]);
	format(string, sizeof(string), "%sIP адрес (регис.):\t%s\n", string,PI[params[0]][pRegIP]);
	format(string, sizeof(string), "%sIP адрес (последн.):\t%s\n", string,PI[params[0]][pLastIP]);
	format(string, sizeof(string), "%sДата регистрации:\t%s\n", string,PI[params[0]][pRegData]);
	format(string, sizeof(string), "%sДонат:\t%d\n", string,PI[params[0]][pPerfectCoins]);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"/get", string, "Закрыть", "");
	fLogs("[admin] %s /get %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:offget(playerid, params[]) //edit
{
	if(PI[playerid][pAdmin] < 4) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(!g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "Эту информацию разрешено просматривать только FullDostup");

	new playername[MAX_PLAYER_NAME];
	if(sscanf(params, "s[128]", playername)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offget [имя игрока]");
	if(GetPlayerID(playername) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок в сети, используйте команду /get");
	format(global_string, sizeof(global_string), "SELECT * FROM `accounts` WHERE `name`='%s'", playername);
	mysql_tquery(db_prod, global_string, "OnPlayerOffget", "is", playerid, playername);
	return 1;
}

cmd:agetid(playerid, params[])
{
	if(PI[playerid][pAdmin] < 4) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(!g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "Эту информацию разрешено просматривать только FullDostup");
	new playername[MAX_PLAYER_NAME];
	if(sscanf(params, "s[90]", playername)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/agetid [id игрока]");
	format(global_string, sizeof(global_string), "SELECT * FROM `accounts` WHERE `id`='%s'", playername);
	mysql_tquery(db_prod, global_string, "OnPlayerOffgeta", "is", playerid, playername);
	return 1;
}
cmd:unmask(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Вам недоступна эта команда!");
	if(UnMaskReset[playerid] > 0) return 1;
	UnMaskReset[playerid] = 3;
	foreach(new i: Player)
	{
		if(!PlayerLogged[i] || !PlayerUseMask[i] || GetDistanceBetweenPlayers(playerid, i) > 4.0 || !GetPlayerFaceToPlayer(playerid, i, 30.0)) continue;
		if(pCuff[i][pCuffee] != i) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен быть в наручниках");
		{
			PlayerUseMask[i] = false;
			format(string, sizeof(string), "Вы сняли маску с игрока %s", GetName(i));
			SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
			format(string, sizeof(string), "%s снял с вас маску", GetName(playerid));
			SendClientMessage(i, COLOR_GREY, string);
			format(string, sizeof(string), "снял маску с игрока %s", GetName(i));
			MeAction(playerid, string);
			return 1;
		}
	}
	return 1;
}

cmd:clips(playerid)
{
	if(pCuff[playerid][pCuffer] == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Вы не в наручниках");
	if(PI[playerid][pClips] == 0) return SendClientMessage(playerid, COLOR_RED, "У Вас нет скрепок");

	new Float: X, Float: Y, Float: Z;
	GetPlayerPos(playerid, X, Y, Z);

	new find;
	foreach(new idx: Player)
	{
		if(IsPlayerInRangeOfPoint(idx, 10.0, X, Y, Z) && IsACopAndFSB(idx)) find = 1;
	}
	if(find) return SendClientMessage(playerid, COLOR_RED, "Рядом с Вами есть полицейский");

	PI[playerid][pClips] = 0;
	UpdatePlayerData(playerid, "clips", PI[playerid][pClips]);
	SendClientMessage(playerid, COLOR_BBLUE, "Вы начали взлом наручников");
	ShowPlayerCuffTextDraw(playerid);
	return 1;
}

cmd:admclips(playerid) return ShowPlayerCuffTextDraw(playerid);

ShowPlayerCuffTextDraw(playerid)
{
	for(new i; i < sizeof cuff_td_global; i ++) TextDrawShowForPlayer(playerid,  cuff_td_global[i]);
	for(new i; i < sizeof cuff_td_player; i ++) PlayerTextDrawShow(playerid, cuff_td_player[i][playerid]);

	PlayerTextDrawLetterSize(playerid, cuff_td_player[1][playerid], 0.0, 0.0);

	switch(random(2))
	{
	case 0: key_action[playerid] = KEY_YES, PlayerTextDrawSetString(playerid, cuff_td_player[0][playerid], "Y");
	case 1: key_action[playerid] = KEY_NO, PlayerTextDrawSetString(playerid, cuff_td_player[0][playerid], "N");
	}

	g_player_action[playerid] = true;

	return 1;
}
HidePlayerCuffTextDraw(playerid)
{
	for(new i; i < sizeof cuff_td_global; i ++) TextDrawHideForPlayer(playerid,  cuff_td_global[i]);
	for(new i; i < sizeof cuff_td_player; i ++) PlayerTextDrawHide(playerid, cuff_td_player[i][playerid]);

	position_action[playerid] = 0;
	g_player_action[playerid] = false;

	return 1;
}

cmd:cuff(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(PlayerTied[playerid] == true) return SendClientMessage(playerid, COLOR_GREY, "Вы связаны, вы не можете одеть наручники!");
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, COLOR_RED, "Вы не можете одеть наручники в деморгане/КПЗ");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/cuff [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Вы далеко друг от друга");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете надеть наручники на себя!");
	if(IsACopAndFSB(params[0])) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок Полицейский/Агент/Военный!");
	if(pCuff[params[0]][pCuffee] == params[0]) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже в наручниках!");

	if(PI[playerid][pMember] != TEAM_FSB && PI[params[0]][pWanted] == 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находится в розыске");
	if(PI[playerid][pMember] == TEAM_FSB && PI[playerid][pRank] < 5 && PI[params[0]][pWanted] == 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находится в розыске");

	new bool: in_pb = false;
	for(new i; i < MAX_PBPLAYER; i++)
	{
		if(PBP_PLAYERIDS[i] == INVALID_PLAYER_ID) continue;
		if(PBP_PLAYERIDS[i] != playerid) continue;
		in_pb = true;
		break;
	}
	if(in_pb) return SendClientMessage(playerid, COLOR_RED, "Вам запрещено использовать эту команду во время мероприятия");

	SendMes(playerid, COLOR_BLUE, "Вы надели наручники на %s", GetName(params[0]));
	if(PI[playerid][pSex] == 1) SendMes(params[0], COLOR_BLUE, "%s надел на вас наручники!", GetName(playerid));
	else SendMes(params[0], COLOR_BLUE, "%s надела на вас наручники!", GetName(playerid));
	SetPlayerArmedWeapon(params[0], 0);
	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_CUFFED);
	SetPlayerAttachedObject(params[0], 0, 19418, 6, -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035, 0.891999, 1.000000, 1.168000);
	pCuff[params[0]][pCuffee] = pCuff[playerid][pCuffee] = params[0];
	pCuff[params[0]][pCuffer] = pCuff[playerid][pCuffer] = playerid;
	TogglePlayerControllable(params[0], 0);
	GameTextForPlayer(playerid, "~r~cuffed", 5000, 5);
	GameTextForPlayer(params[0], "~r~cuffed", 5000, 5);

	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "надел наручники на %s", GetName(params[0]));
	else format(string, sizeof(string), "надела наручники на %s", GetName(params[0]));
	MeAction(playerid, string);
	return 1;
}

cmd:uncuff(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/uncuff [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Вы далеко друг от друга");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете снять наручники с себя!");
	if(pCuff[params[0]][pCuffer] == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок не в наручниках!");

	SendMes(playerid, COLOR_BLUE, "Вы сняли наручники с %s", GetName(params[0]));
	if(PI[playerid][pSex] == 1) SendMes(params[0], COLOR_BLUE, "%s снял с вас наручники", GetName(playerid));
	else SendMes(params[0], COLOR_BLUE, "%s сняла с вас наручники", GetName(playerid));
	TogglePlayerControllable(params[0], 1);
	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
	RemovePlayerAttachedObject(params[0], 0);
	pCuff[params[0]][pCuffer] = pCuff[params[0]][pCuffee] = pCuff[playerid][pCuffee] = pCuff[playerid][pCuffer] = INVALID_PLAYER_ID;
	GameTextForPlayer(playerid, "~g~uncuffed", 5000, 5);
	GameTextForPlayer(params[0], "~g~uncuffed", 5000, 5);

	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "снял наручники с %s", GetName(params[0]));
	else format(string, sizeof(string), "сняла наручники с %s", GetName(params[0]));
	MeAction(playerid, string);
	return 1;
}

cmd:auncuff(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/auncuff [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Вы далеко друг от друга");
	if(pCuff[params[0]][pCuffer] == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок не в наручниках!");

	SendMes(playerid, COLOR_BLUE, "Вы сняли наручники с %s", GetName(params[0]));
	if(PI[playerid][pSex] == 1) SendMes(params[0], COLOR_BLUE, "%s снял с вас наручники", GetName(playerid));
	else SendMes(params[0], COLOR_BLUE, "%s сняла с вас наручники", GetName(playerid));
	TogglePlayerControllable(params[0], 1);
	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
	RemovePlayerAttachedObject(params[0], 0);
	pCuff[params[0]][pCuffer] = pCuff[params[0]][pCuffee] = pCuff[playerid][pCuffee] = pCuff[playerid][pCuffer] = INVALID_PLAYER_ID;
	GameTextForPlayer(playerid, "~g~uncuffed", 5000, 5);
	GameTextForPlayer(params[0], "~g~uncuffed", 5000, 5);

	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "снял наручники с %s", GetName(params[0]));
	else format(string, sizeof(string), "сняла наручники с %s", GetName(params[0]));
	MeAction(playerid, string);
	fLogs("[admin] %s /auncuff %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:arrest(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(!IsPlayerInRangeOfPoint(playerid, 10.0,-1704.6469,-2808.0452,14.2065) && !IsPlayerInRangeOfPoint(playerid, 30.0, 2516.8201, 757.8386, 2019.7719) && !IsPlayerInRangeOfPoint(playerid, 20.0, -1704.6469,-2808.0452,14.2065)) return SendClientMessage(playerid, -1, ""cER"Вам необходимо находится около въезда в тюрьму или около камеры в тюрьме!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/arrest [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(PI[params[0]][pJail] > 0) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок уже находиться в тюрьме!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете арестовать самого себя!");
	if(IsACopAndFSB(params[0]) || PI[params[0]][pMember] == TEAM_ARMY) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок полицейский/агент/военный!");
	if(PI[params[0]][pWanted] == 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен иметь хотя бы 1 уровень розыска!");

	ResetPlayerWeapons(params[0]);
	PI[playerid][pScoreIvent] ++;
	MysqlUpdatePlayerInt(playerid, "scoreivent", PI[playerid][pScoreIvent]);

	PI[params[0]][pJailTime] = PI[params[0]][pWanted]* 5 * 60;
	PI[params[0]][pWanted] = 0;
	if(pCuff[params[0]][pCuffer] != INVALID_PLAYER_ID)
	{
		new cuffer = pCuff[params[0]][pCuffer];
		SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(params[0], 0);
		pCuff[params[0]][pCuffer] = INVALID_PLAYER_ID;
		pCuff[params[0]][pCuffee] = INVALID_PLAYER_ID;
		pCuff[cuffer][pCuffee] = INVALID_PLAYER_ID;
		pCuff[cuffer][pCuffer] = INVALID_PLAYER_ID;
	}
	SetPlayerColorEx(params[0],TeamColors[0]);
	SendMes(playerid, COLOR_BLUE, "Вы посадили в одиночную камеру %s[%d] на %d секунд", GetName(params[0]), params[0], PI[params[0]][pJailTime]);
	SendMes(params[0], COLOR_BLUE, "%s %s[%d] посадил вас в одиночную камеру на %d секунд", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), playerid, PI[params[0]][pJailTime]);

	new r = random(10);
	SetPlayerPos(params[0],SetPlayerPosJail[r][0], SetPlayerPosJail[r][1], SetPlayerPosJail[r][2]);
	SetPlayerFacingAngle(params[0], SetPlayerPosJail[r][3]);
	SetPlayerVirtualWorld(params[0], playerid+1);
	SetPlayerInterior(params[0], 1);

	PI[params[0]][pJail] = 1;
	SetPlayerWantedLevel(params[0], 0);
	TogglePlayerControllable(params[0], 1);
	SetPlayerSkin(params[0], 48);
	return 0x1;
}

cmd:megaphone(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в транспорте!");
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/megaphone [текст]");
	format(stringer1, sizeof(stringer1), "[Мегафон] %s %s: %s",frakRangName[PI[playerid][pMember]][PI[playerid][pRank]],GetName(playerid),params[0]);
	ProxDetector(45.0, playerid, stringer1, COLOR_YELLOW);
	return 1;
}
alias:megaphone("m");

cmd:clear(playerid, params[])
{
	if(!IsACopAndFSB(playerid) || PI[playerid][pRank] < 4) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в транспорте!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/clear [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете снять себе розыск!");
	if(!PI[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться в розыске!");
	if(!IsPlayerInVehicle(params[0], GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться с вами в транспорте!");
	SendMes(playerid, COLOR_LIGHTBLUE, "Вы сняли уровни розыска с %s'а", GetName(params[0]));
	SendMes(params[0], COLOR_LIGHTBLUE, "Офицер %s снял с вас уровни розыска", GetName(playerid));
	format(stringer1, sizeof(stringer1), "Офицер %s зашел(ла) в базу данных полиции", GetName(playerid));
	ProxDetector(13.0,playerid, stringer1, COLOR_PURPLE);
	PI[params[0]][pWanted] = 0;
	SetPlayerWantedLevel(params[0], 0);
	return 1;
}

cmd:aclear(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	{
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/clear [id игрока]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(!PI[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться в розыске!");
		SendMes(playerid, COLOR_LIGHTBLUE, "Вы сняли уровни розыска с %s'а", GetName(params[0]));
		SendMes(params[0], COLOR_LIGHTBLUE, "Администратор %s снял с вас уровни розыска", GetName(playerid));
		PI[params[0]][pWanted] = 0;
		SetPlayerWantedLevel(params[0], 0);
		fLogs("[admin] %s /aclear %s", GetName(playerid), GetName(params[0]));
	}
	return 1;
}

cmd:push(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Вам недоступна эта команда!");
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, ""cPS"Вы должны быть в авто!");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/push [id игрока] [место(1-3)]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не рядом с вами!");
	if(IsPlayerInAnyVehicle(params[0])) return SendClientMessage(playerid, COLOR_GREY, "Игрок не должен находится в транспорте!");
	if(pCuff[params[0]][pCuffer] == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Игрок не в наручниках!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете затащить в автомобиль самого себя!");
	if(params[1] > 3 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "Количество мест от 1 до 3!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете затащить в автомобиль самого себя!");

	PutPlayerInVehicle(params[0], GetPlayerVehicleID(playerid), params[1]);
	TogglePlayerControllable(params[0], 0);
	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "затащил в авто %s", GetName(params[0]));
	else format(string, sizeof(string), "затащила в авто %s", GetName(params[0]));
	MeAction(playerid, string);
	return true;
}
cmd:incar(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, "Вам недоступна эта команда!");
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, ""cPS"Вы должны быть в авто!");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/incar [id игрока] [место(1-3)]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок не рядом с вами!");
	if(IsPlayerInAnyVehicle(params[0])) return SendClientMessage(playerid, COLOR_GREY, "Игрок не должен находится в транспорте!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете затащить в автомобиль самого себя!");
	if(!PlayerTied[params[0]]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не связан!");
	if(params[1] > 3 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "Количество мест от 1 до 3!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете затащить в автомобиль самого себя!");

	PutPlayerInVehicle(params[0], GetPlayerVehicleID(playerid), params[1]);
	TogglePlayerControllable(params[0], 0);
	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "насильно затащил в авто %s", GetName(params[0]));
	else format(string, sizeof(string), "насильно затащила в авто %s", GetName(params[0]));
	MeAction(playerid, string);
	return true;
}

cmd:getmats(playerid)
{
	if(IsPlayerInAnyVehicle(playerid))
	{
		if(IsPlayerInRangeOfPoint(playerid, 10.0, -1093.9832,2208.5503,37.9239))
		{
			if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 578)
			{
				if(materials_count[GetPlayerVehicleID(playerid)] < 10000)
				{
					if(materials > 500)
					{
						if(PI[playerid][pMember] == TEAM_ARMY)
						{
							ShowPlayerDialog(playerid, 18275, DIALOG_STYLE_MSGBOX, ""cMain"Загрузка материалов", ""cWH"Вы готовы начать загрузку материалов?", "Да", "Нет");
						}
						else SendClientMessage(playerid, COLOR_RED, "Загружать материалы может только армия");
					}
					else SendClientMessage(playerid, COLOR_RED, "Материалов на складе осталось слишком мало");
				}
				else SendClientMessage(playerid, COLOR_RED, "Ваша машина переполнена. Отвезите материалы на склад");
			}
			else SendClientMessage(playerid, COLOR_RED, "Вам необходимо находиться в специальном автомобиле, чтобы перевозить материалы");
		}
	}
	return 1;
}

cmd:unmats(playerid)
{

	if(IsPlayerInAnyVehicle(playerid))
	{
		if(IsAGang(playerid) || IsAMafia(playerid))
		{
			if(IsPlayerUnMats(playerid))
			{
				if(materials_count[GetPlayerVehicleID(playerid)] > 0)
				{
					GetSkladMaterials(playerid, PI[playerid][pMember]);
				}
				else SendClientMessage(playerid, COLOR_RED, "Ваша машина ничем не загружена");
			}
			else SendClientMessage(playerid, COLOR_RED, "Вы должны находиться на месте разгрузки");
		}
		else SendClientMessage(playerid, COLOR_RED, "Вам это недоступно");
	}
	else SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в автомобиле");

	return 1;
}

cmd:findcar(playerid,params[])
{
	if(GetActivePlayerVehicleCount(playerid) == 0)
		return SendErr(playerid, "У вас нет загруженного транспорта");

	global_string[0] = EOS;

	new
		count;

	for(new i; i < MAX_LOAD_VEHICLE; i++)
	{
		if(PlayerVehicle[playerid][i] != INVALID_PLAYER_VEHICLE)
		{
			format(global_string, sizeof(global_string), "%s"cWH"%s\n", global_string, VehicleNames[GetVehicleModel(PlayerVehicle[playerid][i])-400]);
			SetPlayerListitemValue(playerid, count, PlayerVehicle[playerid][i]);
			count ++;
		}
	}

	ShowPlayerDialog(playerid, 2416, DIALOG_STYLE_LIST, !""cMain"Выберите транспорт", global_string, !"Найти", !"Закрыть");
	return true;
}

DLG(2416, playerid, response, listitem, inputtext[])
{
	if(!response)
		return true;
	new
		id = GetPlayerListitemValue(playerid, listitem);

	if(debug_mode)
	{
		format(String144, sizeof(String144), "[debug] vehicle id: {CCCCCC}%i", id);
		SendClientMessage(playerid, -1, String144);
	}

	new Float: pos[3];
	GetVehiclePos(id, pos[0], pos[1], pos[2]);

	if(GetVehicleVirtualWorld(id) == 1)
	{
		pos[0] = 2326.9092;
		pos[1] = -1804.2758;
		pos[2] = 22.4540;

		SendClientMessage(playerid, 0xFFCC00AA, "Ваш автомобиль находится на парковке");
	}

	GPSPlayer_(playerid, pos[0],pos[1],pos[2], "Личный транспорт");

	return true;
}

cmd:findcopter(playerid,params[])
{

	if(PI[playerid][HelicopterID] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Вертолет не загружен или отсутствует. Используйте /fixcopter для загрузки вертолета в игру");

	new Float: pos[3], locname[30];
	GetVehiclePos(PI[playerid][HelicopterID], pos[0], pos[1], pos[2]);
	locname = "Личный вертолет";
	GPSPlayer_(playerid, pos[0],pos[1],pos[2], locname);

	return true;
}

cmd:ram(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new full = 0;
	for(new i = TOTALHOUSE; i > 0; i--)
	{
		if(IsPlayerInRangeOfPoint(playerid, 3.0, HouseInfo[i][hEntrx], HouseInfo[i][hEntry], HouseInfo[i][hEntrz]))
		{
			SendMes(playerid, COLOR_LIGHTRED, "Вы выбили дверь дома (Владелец: %s)", HouseInfo[i][hOwner]);
			if(PI[playerid][pSex] == 1) MeAction(playerid, "выбил дверь дома");
			else MeAction(playerid, "выбила дверь дома");

			SetPlayerPos(playerid,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]);
			SetPlayerInterior(playerid,HouseInfo[i][hInt]);
			SetPlayerVirtualWorld(playerid,HouseInfo[i][hVirtual]);

			PI[playerid][pInHouse] = i;
			full++;
		}
	}
	if(full == 0) SendClientMessage(playerid, -1, ""cPS"Вы должны находиться рядом с домом!");
	return 1;
}

cmd:pass(playerid, params[])
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	if(PhoneNumbers[playerid][1] == 0) return SendClientMessage(playerid, -1, ""cER"У Вас нет паспорта");
	if(freeze_pass[playerid] > unix) return SendClientMessage(playerid, COLOR_RED, "Пользоваться командой /pass можно раз в 15 секунд");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/pass [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок слишком далеко!");
	if(passport_status[params[0]] != false) return SendClientMessage(playerid, COLOR_RED, "Этому игроку уже кто-то показывает паспорт");
	if(fights_player_status[params[0]])  return SendClientMessage(playerid, COLOR_RED, "Данному игроку запрещено показывать паспорт");
	new text[20], mtext[MAX_PLAYER_NAME];
	if(PI[playerid][pMarried] == 0) format(mtext, sizeof(mtext), "Нет");
	else format(mtext, sizeof(mtext), "%s", PI[playerid][pWhoMarried]);
	if(PI[playerid][pPhoneNumber] <= 1) format(text, sizeof(text), "нет");
	else format(text, sizeof(text), "%d", PI[playerid][pPhoneNumber]);

	global_string = "";
	for(new idx; idx < 20; idx ++)
	TextDrawShowForPlayer(params[0], td_pasport_global[idx]);
	for(new idx; idx < 4; idx ++)
	PlayerTextDrawShow(params[0], td_pasport_player[idx][playerid]);

	new house_text[24];
	if(GetPlayerHouse(playerid) == 0) format(house_text, sizeof house_text, "нет");
	else format(house_text, sizeof house_text,"Д. %d", GetPlayerHouse(playerid));

	SelectTextDrawEx(params[0], -1);
	passport_status[params[0]] = true;

	global_string = "";
	format(global_string, 120, "%s", GetName(playerid));
	PlayerTextDrawSetString(params[0], td_pasport_player[0][playerid], global_string);
	PlayerTextDrawSetString(params[0], td_pasport_player[3][playerid], PI[playerid][pSex] == 1 ? ("м"):("ж"));

	global_string = "";
	format(global_string, 120, "%s~n~____уфмс_россии_по_г.южный~n~%s~n~~n~%s~n~%s~n~%s", PI[playerid][pSex] == 1 ? ("Мужской"):("Женский"), PI[playerid][Billet] ? "Пройдена" : "Не пройдена", Fraction_Name[PI[playerid][pMember]], frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], mtext);
	PlayerTextDrawSetString(params[0], td_pasport_player[1][playerid], global_string);

	global_string = "";
	format(global_string, 120, "%d~n~%d_лет~n~%s~n~%s", PI[playerid][pAge], PI[playerid][pLevel], text, house_text);
	PlayerTextDrawSetString(params[0], td_pasport_player[2][playerid], global_string);

	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "показал свой паспорт %s", GetName(params[0]));
	else format(string, sizeof(string), "показалa свой паспорт %s", GetName(params[0]));
	MeAction(playerid, string);
	freeze_pass[playerid] = unix + 15;
	return 1;
}

cmd:trunk(playerid)
{
	foreach(new vehicleid : Vehicle)
	{
		new Float: car_pos_x, Float: car_pos_y, Float: car_pos_z, Float: car_pos_r, Float: distance;
		GetVehicleModelInfo(GetVehicleModel(vehicleid), 1, car_pos_x, distance, car_pos_z);
		distance = distance/2 + 0.1;

		GetVehiclePos(vehicleid, car_pos_x, car_pos_y, car_pos_z);
		GetVehicleZAngle(vehicleid, car_pos_r);

		car_pos_x += (distance * floatsin(-car_pos_r + 180, degrees));
		car_pos_y += (distance * floatcos(-car_pos_r + 180, degrees));

		if(IsPlayerInRangeOfPoint(playerid, 2.0, car_pos_x, car_pos_y, car_pos_z))
		{
			if(vehicleid != PlayerVehicle[playerid][0] && vehicleid != PlayerVehicle[playerid][1] && vehicleid != PlayerVehicle[playerid][2] &&
			vehicleid != PlayerVehicle[playerid][3] && vehicleid != PlayerVehicle[playerid][4])
				return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться около багажника своего автомобиля");

			if(!vehicle_boot[vehicleid])
				return SendClientMessage(playerid, COLOR_RED, "Для начала следует открыть багажник. Сделать это можно с помощью команды /cm");

			for(new i; i < MAX_LOAD_VEHICLE; i++)
			{
				if(vehicleid == PlayerVehicle[playerid][i])
				{
					SetPVarInt(playerid, "trunk_vehid", PlayerVehicleSQL[playerid][i]);
					ShowPlayerDialog(playerid,2417,DIALOG_STYLE_LIST, !""cMain"Багажник автомобиля", !"\
						"cMain"1. "cWH"Взять вещи из багажника\n\
						"cMain"2. "cWH"Положить вещи в багажник", !"Далее", !"Закрыть");

					break;
				}
			}

			global_string = "";
			format(global_string, 300, "\
			"cWH"Содержимое багажника:\n\n\
			Патроны: "cMain"%d шт.\n\
			"cWH"Канистры: "cMain"%d шт.\n\
			"cWH"Наркотики: "cMain"%d гр.\n\
			"cWH"Деньги: "cMain"%d руб.\n\n\
			"cWH"Оружие №1: "cMain"%s\n\
			"cWH"Оружие №2: "cMain"%s\n\
			"cWH"Оружие №3: "cMain"%s",
			C_DATA[playerid][c_trunk][0],
			C_DATA[playerid][c_trunk][1],
			C_DATA[playerid][c_trunk][2],
			C_DATA[playerid][c_trunk][3],
			GunNames[C_DATA[playerid][c_trunk_gun][0]],
			GunNames[C_DATA[playerid][c_trunk_gun][1]],
			GunNames[C_DATA[playerid][c_trunk_gun][2]]);
		}
	}
	return 1;
}

