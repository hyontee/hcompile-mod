		}
	}
	else SendClientMessage(playerid, COLOR_RED, "Члены семьи оффлайн отсутствуют");
	ShowPlayerDialog(playerid, 7705, DIALOG_STYLE_LIST, ""cMain"Члены семьи offline", string, "Закрыть", "");
