			6. Наркопритон\n\
			7. Автоугонщик", goto_gps[playerid] ? "Далее" : "Найти", "Назад");
	case 4: ShowPlayerDialog(playerid, 10007, DIALOG_STYLE_LIST, ""cMain"Банки",
		"1. Банк г. Южный\n\
