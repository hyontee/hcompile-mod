new CrashSkins[] = {5,128,149,265,266,267,268,269,270,271,297,299};

SetPlayerSkin_crash(playerid, skinid)
{
	for(new i; i < sizeof(CrashSkins); i++)
	{
		if(skinid == CrashSkins[i])
		{
			skinid = 21;
			return SCMF(playerid, -1, "Skin %d crashed", skinid);
		}
	}
	ClearAnimations(playerid);
	if(skinid >= 299) skinid = 21;
	else if(skinid <= 0) skinid = 21;
	SetPlayerSkin(playerid, skinid);
	return 1;
}

#if defined _ALS_SetPlayerSkin
#undef SetPlayerSkin
#else
#define _ALS_SetPlayerSkin
#endif
#define	SetPlayerSkin SetPlayerSkin_crash

