CMD:rstats(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_SMI) return SendClientMessage(playerid, -1, ""cER"Вам не доступна данная возможность.");
	if(PI[playerid][pRank] < 9)
	{
		ShowFinancStatDialog(playerid, playerid);
		return 0x1;
	}
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, 0xCCCCCCFF, ""cPS"Используйте: "cWH" /rstats [id игрока]");
	if(params[0] == INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, ""cER"Игрок не найден.");
	if(IsPlayerConnected(params[0]) == 0) return SendClientMessage(playerid, -1, ""cER"Игрок не найден.");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 3.0 || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return SendClientMessage(playerid, -1, ""cER"Игрок далеко от Вас.");

	ShowFinancStatDialog(playerid, params[0]);
	return 0x1;
}

stock ShowFinancStatDialog(playerid, targetid)
{
	static const
		month_names[12][9] =
		{
			"января", "февраля", "марта", "апреля", "мая", "июня",
			"июля", "августа", "сентября", "октября", "ноября", "декабря"
		},
		month_days[12] =
		{
			31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
		};

	new str_query[128];
	format(str_query, sizeof(str_query), "SELECT * FROM `news` WHERE `user_id` = '%d' LIMIT 1", PI[targetid][pID]);
	new Cache:result = mysql_query(db_prod, str_query);
	if(cache_num_rows() == 0)
	{
		SendClientMessage(playerid, -1, ""cER"Информациия о данном игроке отсутствует");
		cache_delete(result);
		return 0x0;
	}

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Статистика сотрудника СМИ: %s\n", GetName(targetid));
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sДолжность: %s[%d]\n\n\n", STRING_GLOBAL, frakRangName[PI[targetid][pMember]][PI[targetid][pRank]], PI[targetid][pRank]);

	new years, months, days, total_buff;
	getdate(years, months, days);

	if(days >= 7)
	{
		for(new i, buff; i < 7; i++)
		{
			buff = cache_get_row_int(0, i+1);
			total_buff += buff;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t{00FF00}%d\n", STRING_GLOBAL, days-7+i + 1, month_names[months-1], years, buff);
		}
	}
	else
	{
		if(months != 1) months-=1;
		else
		{
			months = 12;
			years-=1;
		}

		new i = 0,
			d = month_days[months-1] + days-7 + 1,
			last_iter = month_days[months-1]+1,
			buff;

		for(; d < last_iter; i++, d++)
		{
			buff = cache_get_row_int(0, i+1);
			total_buff += buff;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t{00FF00}%d\n", STRING_GLOBAL, d, month_names[months-1], years, buff);
		}

		if(months == 12)
		{
			years++;
			months = 1;
		}
		else months++;
		d = 1;
		last_iter = days;
		for(; d <= last_iter; i++, d++)
		{
			buff = cache_get_row_int(0, i+1);
			total_buff += buff;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}%02d %s %04d:\t{00FF00}%d\n", STRING_GLOBAL, d, month_names[months-1], years, buff);
		}
	}
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s\nВсего отредактировано: %d", STRING_GLOBAL, total_buff);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "Статистика", STRING_GLOBAL, "Ок", "");
	cache_delete(result);
	return 1;
}

forward OnMemoryCheckPlayerID(playerid);
public OnMemoryCheckPlayerID(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);

	if(rows == 0)
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `news` (`user_id`, `day_7`) VALUES ('%d', '1');", PI[playerid][pID]);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	}
	if(rows != 0)
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `news` SET `day_7` = `day_7` + '1' WHERE `user_id` = '%d'", PI[playerid][pID]);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	}
	return 0x1;
}


stock UpdatePlayerDataInt(playerid, rows[], data)
{
	new str_data[128];
	mysql_format(db_prod, str_data, sizeof(str_data), "UPDATE `accounts` SET `%s` = '%d' WHERE `id` = '%d'", rows, data, PI[playerid][pID]);
	mysql_tquery(db_prod, str_data);
	return 0x1;
}

stock GetReasonMoneyPercentVip(playerid, type, old_money)
{
	new ReasonMoney = old_money;
	if(TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		switch(type)
		{
			case TYPE_VIP_AUTO: 	ReasonMoney = ((old_money / 100) * (100 - VipData[TYPE_VIP[playerid]][VipAuto]));
			case TYPE_VIP_SKIN: 	ReasonMoney = ((old_money / 100) * (100 - VipData[TYPE_VIP[playerid]][VipSkin]));
			case TYPE_VIP_HOUSE: 	ReasonMoney = ((old_money / 100) * (100 - VipData[TYPE_VIP[playerid]][VipHouse]));
			case TYPE_VIP_WEAPON: 	ReasonMoney = ((old_money / 100) * (100 - VipData[TYPE_VIP[playerid]][VipGun]));
			case TYPE_VIP_BUSINESS: ReasonMoney = ((old_money / 100) * (100 - VipData[TYPE_VIP[playerid]][VipBizz]));
		}
	}
	return floatround(ReasonMoney);
}

stock random2(const max_value, ...)
{
	new result;
	rerandom: result = random(max_value + 1);
	for(new i = numargs() + 1; --i != 0;)
	{
		if(result == getarg(i))
		{
			goto rerandom;
		}
	}
	return result;
}

IsPlayerNearPlayer(const firstid, const secondid, const Float:dist = 10.0)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(secondid, x, y, z);

	return (GetPlayerVirtualWorld(firstid) == GetPlayerVirtualWorld(secondid) && GetPlayerInterior(firstid) == GetPlayerInterior(secondid) && IsPlayerInRangeOfPoint(firstid, dist, x, y, z));
}

DLG(2519, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	if(DynamicInfo[playerid][ExchangeTargetid] != 0xFFFF) return SendClientMessage(playerid, -1, ""cER"Вы уже участвуете в обмене");

	new targetid;
	if(sscanf(inputtext, "d", targetid)) return ShowPlayerDialog(playerid, 2519, DIALOG_STYLE_INPUT, ""cMain"Биржа обмена", "Введите ID игрока с которым хотите начать обмен", "Принять", "Отмена");
	if(playerid == targetid || !IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, ""cER"Данный игрок не авторизован на сервере");
	if(!IsPlayerNearPlayer(playerid, targetid)) return SendClientMessage(playerid, -1, ""cER"Данный игрок слишком далеко от вас");

	if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 12) return SendClientMessage(playerid,COLOR_GREY,"Участвовать в обмене можно только отыграв 12 часов (12 EXP)");

	if(PI[targetid][pLevel] == BONUS_LVL && PI[targetid][pExp] < 12)
	{
		SendClientMessage(targetid,COLOR_GREY,"Участвовать в обмене можно только отыграв 12 часов (12 EXP)");
		SendClientMessage(playerid,COLOR_GREY,"Участвовать в обмене можно только отыграв 12 часов (12 EXP)");
		return 1;
	}

	SetPVarInt(playerid, "pred", targetid);
	SetPVarInt(targetid, "my_id", playerid);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cDA"Вы отправили %s предложение на участие в обмене", GetName(targetid));
	SendClientMessage(playerid, -1, STRING_GLOBAL);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cMain"%s "cWH"предлагает вам поучаствовать в обмене", GetName(playerid));
	ShowPlayerDialog(targetid, 2520, DIALOG_STYLE_MSGBOX, ""cMain"Предложение в обмене", STRING_GLOBAL, "Принять", "Отклонить");
	return 0x1;
}

AddExchangeBet(const playerid, const type, const prop, const number[] = "", const model = 0)
{
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return 0x0;
	if(GetPVarInt(playerid, "Exchange:Ready")) return SendClientMessage(playerid, -1, ""cER"После согласия на обмен, запрещено менять вклад");

	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		if(gExchange[playerid][i][xType] == type)
		{
			SendClientMessage(playerid, -1, ""cER"Нельзя добавить больше одного такого же типа");
			return 1;
		}
	}
	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		if(gExchange[playerid][i][xType] == INVALID_EXCHANGE)
		{
			gExchange[playerid][i][xType] = type;
			gExchange[playerid][i][xId] = prop;

			if(gExchange[playerid][i][xType] == BET_CAR)
			{
				gExchange[playerid][i][xNumber][0] = EOS;
				strcat(gExchange[playerid][i][xNumber], number);
				gExchange[playerid][i][xModel] = model;
			}

			UpdateExchangeText(playerid);
			SendClientMessage(playerid, -1, ""cDA"Вы добавили предмет в обмен.");
			return 0x1;
		}
		if(gExchange[playerid][i][xType] == type && gExchange[playerid][i][xId] == prop)
		{
			SendClientMessage(playerid, -1, ""cER"Вы уже добавили этот предмет во вклад.");
			return 0x1;
		}
	}
	return SendClientMessage(playerid, -1, ""cER"Во вкладе нет мест.");
}


DLG(2520, playerid, response, listitem, inputtext[])
{
	new targetid = GetPVarInt(playerid, "my_id");

	if(!response)
	{
		SendClientMessage(targetid, -1, ""cER"Игрок отказался от обмена.");
		SendClientMessage(playerid, -1, ""cER"Вы отказались от обмена.");
	}
	else
	{
		if(DynamicInfo[playerid][ExchangeTargetid] != 0xFFFF) return SendClientMessage(playerid, -1, ""cER"Вы уже участвуете в обмене");
		if(DynamicInfo[targetid][ExchangeTargetid] != 0xFFFF) return SendClientMessage(targetid, -1, ""cER"Вы уже участвуете в обмене");
		StartExchange(playerid, targetid);
	}

	SetPVarInt(targetid, "pred", -1);
	SetPVarInt(playerid, "my_id", -1);
	return 0x1;
}

cmd:emenu(const playerid, const params[])
{
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"Вы не участвуете в обмене");
	if(GetPVarInt(playerid, "Exchange:Ready")) return SendClientMessage(playerid, -1, ""cER"После согласия на обмен, запрещено менять вклад");
	ShowPlayerDialog(playerid, 2527, DIALOG_STYLE_LIST, ""cMain"Биржа обмена", ""cMain"1."cWH" Добавить предмет\n"cMain"2."cWH" Согласится на обмен\n"cMain"3."cWH" Отказаться от обмена", "Принять", "Отмена");
	return 0x1;
}

DLG(2527, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	switch(listitem)
	{
		case 0: return ShowPlayerDialog(playerid, 2521, DIALOG_STYLE_LIST, ""cMain"Вклад в обмен", ""cMain"1."cWH" Деньги\n"cMain"2."cWH" Транспорт\n"cMain"3."cWH" Дом\n"cMain"4."cWH" Бизнес", "Принять", "Отмена");
		case 1:
		{
			if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"Вы не участвуете в обмене.");
			if(GetPVarInt(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Ready"))
			{
				SetPVarInt(playerid, "Exchange:Ready", true);
				ConfirmExchange(playerid);
				return 0x1;
			}

			if(GetPVarInt(playerid, "Exchange:Ready"))
			{
				SetPVarInt(playerid, "Exchange:Ready", false);
				SendClientMessage(playerid, -1, ""cER"Вы не готовы провести обмен");

				STRING_GLOBAL[0] = EOS;
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cER"%s[%d] не готов провести обмен", GetName(playerid), playerid);
				SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);
				UpdateExchangeText(playerid);
				return 0x1;
			}

			SetPVarInt(playerid, "Exchange:Ready", true);
			SendClientMessage(playerid, -1, ""cDA"Вы готов провести обмен");

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cDA"%s[%d] готов провести обмен", GetName(playerid), playerid);
			SendClientMessage(DynamicInfo[playerid][ExchangeTargetid], -1, STRING_GLOBAL);
			UpdateExchangeText(playerid);
			return 0x1;
		}
		case 2:
		{
			if(DynamicInfo[playerid][ExchangeTargetid] == INVALID_PLAYER_ID) return 0x1;

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s[%d] отказался от обмена", GetName(playerid), playerid);
			SendClientMessage(DynamicInfo[playerid][ExchangeTargetid], 0xCCCCCCFF, STRING_GLOBAL);

			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Вы отказались от обмена с %s[%d]", GetName(DynamicInfo[playerid][ExchangeTargetid]), DynamicInfo[playerid][ExchangeTargetid]);
			SendClientMessage(DynamicInfo[playerid][ExchangeTargetid], 0xCCCCCCFF, STRING_GLOBAL);
			EndExchange(playerid);
			return 0x1;
		}
	}
	return 0x1;
}

