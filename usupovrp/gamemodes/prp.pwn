		case 0: mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d ORDER BY scoreivent DESC LIMIT 5", TEAM_HITMAN);
		case 1: mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d OR member = %d OR member = %d OR member = %d OR member = %d ORDER BY scoreivent DESC LIMIT 5", TEAM_OBLASTADMIN, TEAM_MVD, TEAM_FSB, TEAM_HOSPITAL, TEAM_SMI);
		case 2: mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d OR member = %d OR member = %d OR member = %d ORDER BY scoreivent DESC LIMIT 5", TEAM_CSKA, TEAM_SPARTAK, TEAM_RUSMAFIA, TEAM_ITALMAFIA);
		case 3: mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d ORDER BY scoreivent DESC LIMIT 5", TEAM_ARMY);
	}
	mysql_tquery(db_prod, global_string, "EventInfo", "ii", playerid, listitem);
	return 1;
