	if(PI[playerid][pMats] < till) return SendClientMessage(playerid, COLOR_RED, "У Вас нет стольких материалов");
	new id;
	switch(PI[playerid][pMember])
	{
		case TEAM_CSKA: id = 1;
		case TEAM_SPARTAK: id = 0;
		case TEAM_RUSMAFIA: id = 3;
		case TEAM_ITALMAFIA: id = 2;
		case TEAM_ARMY: id = 4;
