DLG(4800, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::home(playerid);
	global_string = "";
	switch(listitem)
	{
	case 0:
		{
			format(global_string, 128,""cWH"Автоматические двери - выход из дома или из гаража в дом станет доступным на клавишу {FFFF00}Левый ALT.");
			ShowPlayerDialog(playerid,4800+1,DIALOG_STYLE_MSGBOX,""cMain"Автоматические двери",global_string,"Купить","Назад");
		}
	case 1:
		{
			format(global_string, 128,""cWH"Гараж - помещение для стоянки, а иногда и ремонта автомобилей, мотоциклов.");
			ShowPlayerDialog(playerid,4800+2,DIALOG_STYLE_MSGBOX,""cMain"Гараж",global_string,"Купить","Назад");
		}
	}
	return 1;
}
DLG(4801, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		format(string, sizeof(string),""cWH"Автоматические двери - выход из дома или из гаража в дом станет доступным на клавишу {FFFF00}Левый ALT.");
		ShowPlayerDialog(playerid,4800+1,DIALOG_STYLE_MSGBOX,""cMain"Автоматические двери",string,"Купить","Назад");
		return 1;
	}
	new a = GetPlayerHouse(playerid);
	if(HouseInfo[a][hAutoDoors]) return SendClientMessage(playerid,COLOR_GREY,""cER"У вас уже имеются автоматические двери в доме!");
	if(GetPlayerRubble(playerid) < 25000) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
	SetPlayerMoney(playerid, -25000);
	HouseInfo[a][hAutoDoors] = 1;
	MysqlUpdateHouseInt(a, "hAutoDoors", HouseInfo[a][hAutoDoors]);
	SendClientMessage(playerid, COLOR_LIME, "Теперь в Вашем доме имеются автоматические двери!");
	UpdateDynamic3DTextLabelText(HouseInfo[a][hPickupExit], COLOR_WHITE, ""cWH"Для выхода используйте:\n "cMain"ALT\n"cWH"Управление домом: \n"cMain"/home");
	return 1;
}

DLG(15419, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	static const list_skins[3] = {287,179,255};
	SetPlayerSkin(playerid, list_skins[listitem]);
	SendClientMessage(playerid, COLOR_GREEN, (listitem == 0) ? ("Вы переоделись в постовую форму!") :
	(listitem == 1) ? ("Вы переоделись в спортивную форму!") : ("Вы переоделись в парадную форму!"));
	return 1;
}
DLG(1543, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::home(playerid);
	if(listitem == 3)
	{
		if(!PI[playerid][pMemberSkin]) return SendClientMessage(playerid, -1, ""cER"Вы не состоите в организации");
		SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
		SendClientMessage(playerid, -1, ""cDA"Вы надели форму организации");
	}
	else
	{
		if(!PI[playerid][pSkin][listitem]) return SendClientMessage(playerid, -1, ""cER"У вас нет одежды на этой полке");
		PI[playerid][pModel] = PI[playerid][pSkin][listitem];
		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET model=%d WHERE id=%d", PI[playerid][pModel], PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1, "", "");
		SetPlayerSkin(playerid, PI[playerid][pModel]);
		SendClientMessage(playerid, -1, ""cDA"Вы надели одежду из шкафа");
	}
	return 1;
}
DLG(109, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	ShowPlayerDialog(playerid, 1400+4, 1, ""cMain"Вызвать полицию", ""cWH"Опишите место где вы находитесь\n{AFAFAF}Сообщение должно состоять из 6 до 20 символов!", "Принять", "Отмена");
	return 1;
}
DLG(15420, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(!PI[playerid][pModel]) return 1;
			SetPlayerSkin(playerid, PI[playerid][pModel]);
			SendClientMessage(playerid,COLOR_YELLOW,"Вы переоделись!");
		}
	case 1:
		{
			if(!PI[playerid][pMemberSkin]) return SendClientMessage(playerid,COLOR_GREY,"Вы не состоите в организации");
			SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
			SendClientMessage(playerid,-1, ""cDA"Вы надели форму организации");
		}
	case 2:
		{
			if(PI[playerid][pRank] >= 3)
			{
				new str[90], str2[600];
				for(new i = 1; i < MAX_FRACTIONS; i++)
				{
					format(str, sizeof(str), "№%d - %s\n", i, Fraction_Name[i]);
					strcat(str2, str);
				}
				ShowPlayerDialog(playerid, 18248, 2, ""cMain"Выберите организацию:", str2, "Выбрать", "Отмена");
			}
			else SendClientMessage(playerid, COLOR_RED, "Недоступно на данном ранге");
		}
	}
	return 1;
}
DLG(15421, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(!PI[playerid][pModel]) return 1;
			SetPlayerSkin(playerid, PI[playerid][pModel]);
			SendClientMessage(playerid,COLOR_YELLOW,"Вы переоделись в гражданскую форму");
		}
	case 1:
		{
			if(!PI[playerid][pMemberSkin]) return SendClientMessage(playerid,COLOR_GREY,"Вы не состоите в организации");
			SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
			SendClientMessage(playerid,-1, ""cDA"Вы надели форму организации");
		}
	}
	return 1;
}
DLG(1404, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"У вас изъяли телефон!");
		return 1;
	}
	if(GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[Диспетчер] Не удалось определить Ваше местоположение. Выйдите из помещения.");
	if(GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[Диспетчер] Не удалось определить Ваше местоположение. Выйдите из помещения.");
	if(CallPolice[playerid] > unix) return SendClientMessage(playerid, -1, ""cER"Вы недавно вызывали полицию!");
	if(strlen(inputtext) < 6 || strlen(inputtext) > 20) return SendClientMessage(playerid, -1, ""cER"В сообщении должно быть от 6 до 20 символов!");
	new full = 0;
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(IsACopAndFSB(i) && i != playerid) full++;
	}
	if(!full) SendClientMessage(playerid, -1, ""cPS"В данный момент нет полицейских на дежурстве!");
	else SendClientMessage(playerid, -1, ""cDA"Ваш запрос был отправлен полиции. Ждите ответа");
	PoliceON[playerid] = true;
	new trr[3];
	if(IsPlayerToSquare(playerid,-891.3302,-2950.0190,2915.9917,560.3257)) trr = "";
	else if(IsPlayerToSquare(playerid,-2929.6589,-2889.1660,-1326.9077,1493.1770)) trr = "";
	else trr = "";
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(IsACopAndFSB(i))
		{
			SendMes(i, COLOR_WHITE, "%s[%d] {FFFF00}с города "cWH"%s{FFFF00}, вызывает полицию, местоположение: "cWH"%s", GetName(playerid), playerid, trr, inputtext);
			SendClientMessage(i, COLOR_YELLOW, "Чтобы принять вызов введите "cWH"/gopolice");
		}
	}
	return 1;
}
DLG(1600, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new newslot;
	switch(listitem)
	{
	case 0:
		{
			if(CheckMaxVes(playerid,42,60,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 60) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 60;
			}
			PlayerItem1[playerid][newslot]=42;
			PlayerItem2[playerid][newslot]+=60;
			SendClientMessage(playerid, -1, ""cPS"Вы взяли патроны(60 шт.)");
			if(PI[playerid][pSex] == 1) MeAction(playerid, "взял патроны");
			else MeAction(playerid, "взяла патроны");
		}
	case 1:
		{
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 10) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 10;
			}
			gun_select_inv[playerid] = 3;
			gun_select_gun[playerid] = 3;
			gun_select_buy[playerid] = 0;
		}
	case 2:
		{
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 20) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 20;
			}
			gun_select_inv[playerid] = 19;
			gun_select_gun[playerid] = 22;
			gun_select_buy[playerid] = 0;
		}
	case 3:
		{
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 20) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 20;
			}
			gun_select_inv[playerid] = 21;
			gun_select_gun[playerid] = 24;
			gun_select_buy[playerid] = 0;
		}
	case 4:
		{
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 20) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 20;
			}
			gun_select_inv[playerid] = 28;
			gun_select_gun[playerid] = 31;
			gun_select_buy[playerid] = 0;
		}
	case 5:
		{
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 40) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 40;
			}
			if(PI[playerid][pMember] == TEAM_FSB)
			{
				if(PI[playerid][pRank] < 7) return SendClientMessage(playerid, -1, ""cER"Данное вооружение доступно с 5-го ранга");
				gun_select_inv[playerid] = 106;
				gun_select_gun[playerid] = 34;
				gun_select_buy[playerid] = 0;
			}
			else
			{
				gun_select_inv[playerid] = 30;
				gun_select_gun[playerid] = 30;
				gun_select_buy[playerid] = 0;
			}
		}
	case 6:
		{
			if(PI[playerid][pMember] == TEAM_MVD)
			{
				gun_select_inv[playerid] = 26;
				gun_select_gun[playerid] = 29;
				gun_select_buy[playerid] = 0;

				return 1;
			}
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 10) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 10;
			}
			//SetPlayerAttachedObject(playerid, 1, 1214, 6, -0.040454, 0.028840, -0.012862, 2.521301, 76.277267, 70.163467, 0.300000, 0.300000, 0.500000);
		}
	case 7:
		{
			if(PI[playerid][pMember] == TEAM_ARMY)
			{
				if(gArmyWarehouse[1] < 40) return SendClientMessage(playerid,COLOR_GREY,"На складе армии нет патронов!");
				gArmyWarehouse[1] -= 40;
			}

			gun_select_inv[playerid] = 26;
			gun_select_gun[playerid] = 29;
			gun_select_buy[playerid] = 0;
		}
	}
	if(listitem != 0 && listitem != 6) ShowPlayerDialog(playerid, 19015, DIALOG_STYLE_LIST, ""cMain"Выберите действие:", "1. Поместить оружие в инвентарь\n2. Взять оружие в руки", "Выбрать", "Отмена");

	SaveItem(playerid,newslot);
	SetPlayerHealth(playerid, 100);
	return 1;
}
