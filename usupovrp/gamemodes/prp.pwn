						case 624: names_acs = "Зелёная катана";
						case 625: names_acs = "Синяя катана";
						case 626: names_acs = "Красная катана";
						case 627: names_acs = "Голубая катана";
						case 628: names_acs = "Фиолетная катана";
						*/

					}
				}
				SCMF(playerid, -1, "%d idx", idx);
    			SCMF(playerid, -1, "%d g_player_accessories[MAX_PLAYERS][idx][A_ID];", g_player_accessories[playerid][idx][A_ID]);
    			SCMF(playerid, -1, "%d GetPlayerAccessoriesData(playerid, idx, A_OBJECT)", GetPlayerAccessoriesData(playerid, idx, A_OBJECT));
			}
  			case 999:
			{
				if(!IsPlayerAttachedObjectSlotUsed(playerid, bone))
				{
					new Float:frx, Float:fry, Float:frz;
					GetOffsetAttachedAccesories(GetPlayerAccessoriesData(playerid, idx, A_OBJECT),frx,frx,frx,frx,fry,frz);

					SetPlayerAttachedObject(playerid, bone, GetPlayerAccessoriesData(playerid, idx, A_OBJECT), bone, GetPlayerAccessoriesData(playerid, idx, A_OBJECT_X), GetPlayerAccessoriesData(playerid, idx, A_OBJECT_Y), GetPlayerAccessoriesData(playerid, idx, A_OBJECT_Z), frx, fry, frz);
				}

				EditAccessories[playerid] = idx;

				SendClientMessage(playerid, 0xFFCC00AA, "Нажмите пробелов для осмотра аксессуара");

				EditAttachedObject(playerid, bone);
			}
		case 1:
			{
				//RemovePlayerAttachedObject(playerid, bone);

				SetPlayerAccessoriesData(playerid, idx, A_OBJECT, 0);
				SetPlayerAccessoriesData(playerid, idx, A_OBJECT_X, 0.0);
				SetPlayerAccessoriesData(playerid, idx, A_OBJECT_Y, 0.0);
				SetPlayerAccessoriesData(playerid, idx, A_OBJECT_Z, 0.0);

				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `accounts_accessories` WHERE `id` = '%d'", GetPlayerAccessoriesData(playerid, idx, A_ID));
				mysql_tquery(db_prod, STRING_GLOBAL);

				SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно удалили аксессуар");
			}
		}
	}
	return 1;
}

