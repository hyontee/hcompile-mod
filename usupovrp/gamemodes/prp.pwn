		ShowPlayerDialogAdminCommands(playerid, pPressed[playerid]);
	}
	return 1;
}
DLG(8367, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new vehicleid = GetPlayerVehicleID(playerid);

		if(metall_info[0][mVehicle] <= vehicleid <= metall_info[3][mVehicle])
		{
			new idx = vehicleid - metall_info[0][mVehicle];

			if(!Iter_Contains(VehicleGun, idx))
			return 1;

			if(!metall_info[idx][mLoading])
			return 1;

			DestroyDynamicArea(metall_info[idx][mArea]);
			DestroyPickup(metall_info[idx][mPickup]);
			metall_info[idx][mPickup] = 0;
			metall_info[idx][mArea] = 0;
			metall_info[idx][mArea] = 0;
			SendClientMessage(playerid, COLOR_GREEN, "Загрузка завершена");

			metall_info[idx][mLoading] = -1;

			Iter_Remove(VehicleGun, idx);
		}
	}

	if(!response) RemovePlayerFromVehicle(playerid);
	return 1;
}
DLG(7256, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new vehicleid = GetPlayerVehicleID(playerid);

		if(metall_info[0][mVehicle] <= vehicleid <= metall_info[3][mVehicle])
