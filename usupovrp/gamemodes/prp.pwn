callback::OnPlayerHistoryName2(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		new nickname[MAX_PLAYER_NAME], str[35];
		global_string = "";
		for(new i = 0; i < rows; i++)
		{
			cache_get_field_content(i, "name", nickname, db_prod, MAX_PLAYER_NAME);

			format(str, sizeof(str), ""cWH"%s\n", nickname);
			strcat(global_string, str);
		}
		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_LIST, ""cMain"История ников", global_string, "Закрыть", "");
	}
	else SendClientMessage(playerid, -1, ""cER"Данный игрок ещё не менял имя");
	return 1;
}

callback::Onmysql_query(playerid,id,params[])
{
	new rows,fields;
	cache_get_data(rows,fields,db_prod);
	if(id == 100)
	{
		new plid = DialogSlot[playerid][g_player_listitem_use[playerid]];
		if(PI[playerid][pFamilySozd] == 0) return SendClientMessage(playerid,COLOR_GREY,"Вам недоступна эта функция.");
		if(rows > 3) return SendClientMessage(playerid,COLOR_GREY, "Возможно иметь только трех заместителей.");
		else
		{
			if(PI[playerid][pFamilySozd] == 0) return SendClientMessage(playerid, COLOR_GREY,"Назначать игрока заместителем может только создатель семьи.");
			if(plid == playerid) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не можете назначить заместителем самого себя!");

			PI[plid][pFamilyZam] = 1;
			PI[plid][pFamilyRank] = 6;
			format(string,sizeof(string),"{%s}[%s]{FFD39B} %s(%s) назначил игрока %s заместителем семьи",family_chat_color [family_info[PI[playerid][pFamily]] [f_chat_color ]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid),family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1], GetName(plid));
			family_message(PI[playerid][pFamily],-1, string);

			format(string, sizeof string, "UPDATE `accounts` SET familyrank = 6, familyzam = 1 WHERE name = '%s'", GetName(plid));
			mysql_function_query ( db_prod, string, false, "", "");
			return true;
		}
	}
	return true;
}
