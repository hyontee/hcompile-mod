	mysql_tquery(db_prod, global_string, "","");
	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, "{%s}[F] %s(%s) взял из общака семьи %d патронов", family_chat_color[family_info[f][f_chat_color]], GetName(playerid), family_rank_name[f][PI[playerid][pFamilyRank] - 1], strval(inputtext));
	family_message(f, -1, fmt_msg);
