callback::TopMyLevelCallBack(playerid)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "Ошибка!");
		return 1;
	}
	mysql_tquery(1, "SELECT * FROM accounts ORDER BY level DESC LIMIT 10", "TopLevelCallBack", "ii", playerid, cache_get_field_content_int(0, "level"));
	return 1;
}
callback::TopLevelCallBack(playerid, count)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "Ошибка");
		return 1;
	}
	new LevelTop[10];
	new NameTop[10][MAX_PLAYER_NAME];
	for(new i = 0; i != rows; i ++)
	{
		cache_get_field_content(i, "name", NameTop[i], 1, 24);
		LevelTop[i] = cache_get_field_content_int(i, "level");
	}
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][3], "Топ 10 самых больших уровней");

	new string_top[MAX_PLAYER_NAME * 10];
	format(string_top, sizeof(string_top), "\
	%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s",
	NameTop[0], NameTop[1], NameTop[2], NameTop[3], NameTop[4], NameTop[5], NameTop[6], NameTop[7], NameTop[8], NameTop[9]);
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][1], string_top);

	format(string_top, sizeof(string_top), "\
	%dLVL~n~%dLVL~n~%dLVL~n~%dLVL~n~%dLVL~n~%dLVL~n~%dLVL~n~%dLVL~n~%dLVL~n~%dLVL",
	LevelTop[0], LevelTop[1], LevelTop[2], LevelTop[3], LevelTop[4], LevelTop[5], LevelTop[6], LevelTop[7], LevelTop[8], LevelTop[9]);
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][2], string_top);

	for(new i = 0; i != 13; i ++) TextDrawShowForPlayer(playerid, rating_td_global[i]);
	for(new i = 0; i != 4; i ++) PlayerTextDrawShow(playerid, rating_td_player[playerid][i]);
	SelectTextDrawEx(playerid, 0x00000050);
	return 0x1;
}
callback::TopMyTimeCallBack(playerid)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "Ошибка!");
		return 1;
	}
	mysql_tquery(1, "SELECT * FROM accounts ORDER BY time DESC LIMIT 10", "TopTimeCallBack", "ii", playerid, cache_get_field_content_int(0, "time"));
	return 1;
}
callback::TopTimeCallBack(playerid, count)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "Ошибка");
		return 1;
	}

	new TimeTop[10];
	new NameTop[10][MAX_PLAYER_NAME];
	for(new i = 0; i != rows; i ++)
	{
		cache_get_field_content(i, "name", NameTop[i], 1, 24);
		TimeTop[i] = cache_get_field_content_int(i, "time");
	}
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][3], "Топ 10 самых играющих");

	new string_top[MAX_PLAYER_NAME * 10];
	format(string_top, sizeof(string_top), "\
	%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s",
	NameTop[0], NameTop[1], NameTop[2], NameTop[3], NameTop[4], NameTop[5], NameTop[6], NameTop[7], NameTop[8], NameTop[9]);
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][1], string_top);

	format(string_top, sizeof(string_top), "\
	%dч~n~%dч~n~%dч~n~%dч~n~%dч~n~%dч~n~%dч~n~%dч~n~%dч~n~%dч",
	TimeTop[0], TimeTop[1], TimeTop[2], TimeTop[3], TimeTop[4], TimeTop[5], TimeTop[6], TimeTop[7], TimeTop[8], TimeTop[9]);
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][2], string_top);

	for(new i = 0; i != 13; i ++) TextDrawShowForPlayer(playerid, rating_td_global[i]);
	for(new i = 0; i != 4; i ++) PlayerTextDrawShow(playerid, rating_td_player[playerid][i]);
	SelectTextDrawEx(playerid, 0x00000050);
	return 0x1;
}

DLG(2534, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	switch(listitem)
	{
	case 0:
		{
			mysql_tquery(db_prod, "SELECT `fam_name`, `fam_victory` FROM `family_system` WHERE `fam_victory` != '0' ORDER BY `fam_victory` DESC LIMIT 10", "OnServerTopFamilyData", "ii", playerid, 0);
		}
	case 1:
		{
			mysql_tquery(db_prod, "SELECT `fam_name`, `fam_fight` FROM `family_system` WHERE `fam_fight` != '0' ORDER BY `fam_fight` DESC LIMIT 10", "OnServerTopFamilyData", "ii", playerid, 1);
		}
	case 2:
		{
			mysql_tquery(db_prod, "SELECT `fam_name`, `fam_rating` FROM `family_system` WHERE `fam_rating` != '0' ORDER BY `fam_rating` DESC LIMIT 10", "OnServerTopFamilyData", "ii", playerid, 2);
		}
	}
	return 0x1;
}

callback::OnServerTopFamilyData(playerid, TYPE_FAMILY)
{
	new rows = cache_num_rows();
	if(!rows) return SendClientMessage(playerid, -1, ""cER"Произошла ошибка при загрузке данных");

	if(TYPE_FAMILY == 0)
	{
		new Victory[10];
		new FamName[10][64];
		for(new i = 0; i != rows; i ++)
		{
			Victory[i] = cache_get_field_content_int(i, "fam_victory");
			cache_get_field_content(i, "fam_name", FamName[i], db_prod, 64);

		}
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][3], "Топ 10 по количеству побед");

		new string_top[MAX_PLAYER_NAME * 10];
		format(string_top, sizeof(string_top), "%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s",
		FamName[0], FamName[1], FamName[2], FamName[3], FamName[4], FamName[5], FamName[6], FamName[7], FamName[8], FamName[9]);
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][1], string_top);

		format(string_top, sizeof(string_top), "%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d",
		Victory[0], Victory[1], Victory[2], Victory[3], Victory[4], Victory[5], Victory[6], Victory[7], Victory[8], Victory[9]);
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][2], string_top);

		for(new i = 0; i != 13; i ++) TextDrawShowForPlayer(playerid, rating_td_global[i]);
		for(new i = 0; i != 4; i ++) PlayerTextDrawShow(playerid, rating_td_player[playerid][i]);
		SelectTextDrawEx(playerid, 0x00000050);
	}
	if(TYPE_FAMILY == 1)
	{
		new Fight[10];
		new FamName[10][64];
		for(new i = 0; i != rows; i ++)
		{
			Fight[i] = cache_get_field_content_int(i, "fam_fight");
			cache_get_field_content(i, "fam_name", FamName[i], db_prod, 64);
		}
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][3], "Топ 10 по количеству воин");

		new string_top[MAX_PLAYER_NAME * 10];
		format(string_top, sizeof(string_top), "%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s",
		FamName[0], FamName[1], FamName[2], FamName[3], FamName[4], FamName[5], FamName[6], FamName[7], FamName[8], FamName[9]);
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][1], string_top);

		format(string_top, sizeof(string_top), "%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d",
		Fight[0], Fight[1], Fight[2], Fight[3], Fight[4], Fight[5], Fight[6], Fight[7], Fight[8], Fight[9]);
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][2], string_top);

		for(new i = 0; i != 13; i ++) TextDrawShowForPlayer(playerid, rating_td_global[i]);
		for(new i = 0; i != 4; i ++) PlayerTextDrawShow(playerid, rating_td_player[playerid][i]);
		SelectTextDrawEx(playerid, 0x00000050);
	}
	if(TYPE_FAMILY == 2)
	{
		new Rating[10];
		new FamName[10][64];
		for(new i = 0; i != rows; i ++)
		{
			Rating[i] = cache_get_field_content_int(i, "fam_rating");
			cache_get_field_content(i, "fam_name", FamName[i], db_prod, 64);
		}
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][3], "Топ 10 по рейтингу");

		new string_top[MAX_PLAYER_NAME * 10];
		format(string_top, sizeof(string_top), "%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s",
		FamName[0], FamName[1], FamName[2], FamName[3], FamName[4], FamName[5], FamName[6], FamName[7], FamName[8], FamName[9]);
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][1], string_top);

		format(string_top, sizeof(string_top), "%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d~n~%d",
		Rating[0], Rating[1], Rating[2], Rating[3], Rating[4], Rating[5], Rating[6], Rating[7], Rating[8], Rating[9]);
		PlayerTextDrawSetString(playerid, rating_td_player[playerid][2], string_top);

		for(new i = 0; i != 13; i ++) TextDrawShowForPlayer(playerid, rating_td_global[i]);
		for(new i = 0; i != 4; i ++) PlayerTextDrawShow(playerid, rating_td_player[playerid][i]);
		SelectTextDrawEx(playerid, 0x00000050);
	}
	return 0x1;
}

callback::TopMyCashCallBack(playerid)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "Ошибка!");
		return 1;
	}
	mysql_tquery(1, "SELECT * FROM accounts ORDER BY cash DESC LIMIT 10", "TopCashCallBack", "ii", playerid, cache_get_field_content_int(0, "cash"));
	return 1;
}
callback::TopCashCallBack(playerid, count)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		SendErr(playerid, "Ошибка");
		return 1;
	}

	new MoneyTop[10];
	new NameTop[10][MAX_PLAYER_NAME];
	for(new i = 0; i != rows; i ++)
	{
		cache_get_field_content(i, "name", NameTop[i], 1, 24);
		MoneyTop[i] = cache_get_field_content_int(i, "cash");
	}
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][3], "Топ 10 самых богатых сервера");

	new string_top[MAX_PLAYER_NAME * 10];
	format(string_top, sizeof(string_top), "\
	%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s~n~%s",
	NameTop[0], NameTop[1], NameTop[2], NameTop[3], NameTop[4], NameTop[5], NameTop[6], NameTop[7], NameTop[8], NameTop[9]);
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][1], string_top);

	format(string_top, sizeof(string_top), "\
	%dp~n~%dp~n~%dp~n~%dp~n~%dp~n~%dp~n~%dp~n~%dp~n~%dp~n~%dp",
	MoneyTop[0], MoneyTop[1], MoneyTop[2], MoneyTop[3], MoneyTop[4], MoneyTop[5], MoneyTop[6], MoneyTop[7], MoneyTop[8], MoneyTop[9]);
	PlayerTextDrawSetString(playerid, rating_td_player[playerid][2], string_top);

	for(new i = 0; i != 13; i ++) TextDrawShowForPlayer(playerid, rating_td_global[i]);
	for(new i = 0; i != 4; i ++) PlayerTextDrawShow(playerid, rating_td_player[playerid][i]);
	SelectTextDrawEx(playerid, 0x00000050);
	return 0x1;
}

stock HideRadikalMenu(playerid)
{
	for(new i; i < 10; i ++)
	{
		TextDrawHideForPlayer(playerid, menu_TD[i]);
	}
	CancelSelectTextDrawEx(playerid);
	return true;
}

stock GetFrackRangName(playerid)
{
	new str_rang[64];
	if(PI[playerid][pAdmin] > 0)
	{
		format(str_rang, sizeof(str_rang), "Следящий");
	}
	else
	{
		format(str_rang, sizeof(str_rang), "%s", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]]);
	}
	return str_rang;
}
cmd:leaders(playerid)
{
	new text[20];
	global_string = "{FFFF00}Организация - Должность - Имя игрока - Телефон\n\n";
	foreach(new i: Player)
	{
		if(PI[i][pAdmin] <= 0)
		{
			if(!PI[i][pLeader] || PlayerLogged[i] == false) continue;

			if(PI[i][pPhoneNumber] <= 1) text = "None";
			else format(text,sizeof(text), "%d",PI[i][pPhoneNumber]);

			if(PI[i][pAFK] >= 3) format(global_string, sizeof(global_string), "%s"cWH"%s - %s - %s [%d/3] - %s {FF0000}[AFK: %s]\n", global_string, Fraction_Name[PI[i][pLeader]], GetFrackRangName(i), GetName(i), PI[i][pLWarn], text, ConvertSeconds(PI[i][pAFK]));
			else format(global_string, sizeof(global_string),"%s"cWH"%s - %s - %s[%d/3] - %s\n", global_string, Fraction_Name[PI[i][pLeader]], GetFrackRangName(i), GetName(i), PI[i][pLWarn], text);
		}
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Лидеры организаций в сети", global_string, "Закрыть", "");
	return 1;
}
cmd:topopg(playerid, params[])
{
	if(!IsAGang(playerid)) return SendClientMessage(playerid, COLOR_RED,"Вы не бандит");

	new win_frac,
	lose_frac,
	members[2];

	if(GangTotalGz[3] > GangTotalGz[2])
	{
		win_frac = TEAM_CSKA;
		lose_frac = TEAM_SPARTAK;
	}
	else
	{
		win_frac = TEAM_SPARTAK;
		lose_frac = TEAM_CSKA;
	}
	foreach(new i: Player)
	{
		if(PI[i][pMember] == TEAM_CSKA)
		members[0] ++;

		if(PI[i][pMember] == TEAM_SPARTAK)
		members[1] ++;
	}
	global_string = "";
	format(global_string, 1024,
	""cWH"\""cMain"%s"cWH"\":\n\n"\
	""cWH"Онлайн: "cMain"%d чел.\n"\
	""cWH"Кол-во контролируемых улиц: "cMain"%d\n"\
	""cWH"Денег на складе: "cMain"%d рублей\n"\
	""cWH"Наркотиков: "cMain"%d гр.\n"\
	""cWH"Материалов: "cMain"%d шт.\n\n"\
	""cWH"\""cMain"%s"cWH"\":\n\n"\
	""cWH"Онлайн: "cMain"%d чел.\n"\
	""cWH"Кол-во контролируемых улиц: "cMain"%d\n"\
	""cWH"Денег на складе: "cMain"%d рублей\n"\
	""cWH"Наркотиков: "cMain"%d гр.\n"\
	""cWH"Материалов: "cMain"%d шт.",
	Fraction_Name[ win_frac ],
	members[win_frac == TEAM_CSKA ? 0 : 1],
	win_frac == TEAM_CSKA ? GangTotalGz[3] : GangTotalGz[2],
	win_frac == TEAM_CSKA ? FracBank[0] : FracBank[1],
	win_frac == TEAM_CSKA ? GangPatr[0] : GangPatr[1],
	DrugsBank[win_frac == TEAM_CSKA ? TEAM_CSKA : TEAM_SPARTAK],
	Fraction_Name[ lose_frac ],
	members[lose_frac == TEAM_SPARTAK ? 1 : 0],
	lose_frac == TEAM_SPARTAK ? GangTotalGz[2] : GangTotalGz[3],
	lose_frac == TEAM_SPARTAK ? FracBank[1] : FracBank[0],
	lose_frac == TEAM_SPARTAK ? GangPatr[1] : GangPatr[0],
	DrugsBank[lose_frac == TEAM_SPARTAK ? TEAM_SPARTAK : TEAM_CSKA]);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX,""cMain"Топ ОПГ:",global_string,"Закрыть", "");
	return 1;
}

cmd:asellhouse(playerid)
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston"))
	{
		for(new idx = TOTALHOUSE; idx > 0; idx--)
		{
			if(IsPlayerInRangeOfPoint(playerid, 1.0, HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz]))
			{
				ShowPlayerDialog(playerid, 6266, DIALOG_STYLE_MSGBOX, ""cMain"Продажа дома", ""cWH"Вы действительно хотите продать данный дом?", "Да", "Нет");
				asellhouse_id[playerid] = idx;
			}
		}
	}
	return 1;
}

cmd:mc(playerid, params[])
{
	if(IsAMafia(playerid) || PI[playerid][pMember] == TEAM_HITMAN)
	{
		if(sscanf(params,"s[100]",params[0])) return SendClientMessage(playerid, -1, ""cPS"Введите: /mc [текст]");
		if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, -1, ""cPS"У вас бан чата!");
		new text[100];
		strmid(text,params[0],0,100);
		new ttext[50];

		switch(PI[playerid][pMember])
		{
		case TEAM_ITALMAFIA: ttext = "{009F00}[Итальянская Мафия]";
		case TEAM_RUSMAFIA: ttext = "{DBD604}[Русская Мафия]";
		case TEAM_HITMAN: ttext = "{DBD604}[Хитманы]";
		}
		global_string = "";
		format(global_string, 144, "{CE0F28}[ЧАТ] %s "cWH"%s[%d]: %s", ttext, GetName(playerid), playerid, text);

		foreach(new i:Player) if(IsAMafia(i) || PI[i][pMember] == TEAM_HITMAN) SendClientMessage(i, 0xFFFFFFFF, global_string);
	}
	return 1;
}

cmd:tie(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(pCuff[playerid][pCuffee] == playerid) return SendClientMessage(playerid, COLOR_GREY, "Вы в наручниках, вы не можете связывать!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/tie [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Вязать можно только за рулем авто!");
	if(!IsPlayerInVehicle(params[0],GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY,"Вязать можно только игрока в вашей машине!");
	new Float:possed[4];
	GetPlayerPos(params[0],possed[0],possed[1],possed[2]);
	if(!IsPlayerInRangeOfPoint(playerid, 1, possed[0],possed[1],possed[2])) return SendClientMessage(playerid, COLOR_WHITE, "Вы слишком далеко от данного игрока");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете связать себя!");
	if(PlayerTied[params[0]]) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже связан!");

	SendMes(playerid, 0x6495EDFF, "Вы связали %s", GetName(params[0]));
	if(PI[playerid][pSex] == 1)
	{
		SendMes(params[0], 0x6495EDFF, "%s связал Вас", GetName(playerid));
		format(string, sizeof(string), " %s", GetName(params[0]));
	}
	else
	{
		SendMes(params[0], 0x6495EDFF, "%s связала Вас", GetName(playerid));
		format(string, sizeof(string), "связала %s", GetName(params[0]));
	}
	MeAction(playerid, string);
	GameTextForPlayer(playerid, "~r~tieted", 5000, 5);
	GameTextForPlayer(params[0], "~r~tieted", 5000, 5);
	TogglePlayerControllable(params[0], 0);
	PlayerTied[params[0]] = true;
	return 1;
}

cmd:untie(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/untie [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	new Float:possed[4];
	GetPlayerPos(params[0],possed[0],possed[1],possed[2]);
	if(!IsPlayerInRangeOfPoint(playerid, 4, possed[0],possed[1],possed[2])) return SendClientMessage(playerid, COLOR_WHITE, "Вы слишком далеко от данного игрока");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете развязать себя!");
	if(!PlayerTied[params[0]]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не связан!");

	SendMes(playerid, 0x6495EDFF, "Вы развязали %s", GetName(params[0]));
	if(PI[playerid][pSex] == 1)
	{
		SendMes(params[0], 0x6495EDFF, "%s развязал Вас", GetName(playerid));
		format(string, sizeof(string), "развязал %s", GetName(params[0]));
	}
	else
	{
		SendMes(params[0], 0x6495EDFF, "%s развязала Вас", GetName(playerid));
		format(string, sizeof(string), "развязала %s", GetName(params[0]));
	}
	MeAction(playerid, string);
	GameTextForPlayer(playerid, "~g~untied", 5000,5);
	GameTextForPlayer(params[0], "~g~untied", 5000,5);
	TogglePlayerControllable(params[0], 1);
	PlayerTied[params[0]] = false;
	return 1;
}

cmd:spawn(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/spawn [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);

	format(string, sizeof(string), ""aAC"%s[%d] заспавнил игрока %s[%d]", GetName(playerid), playerid, GetName(params[0]), params[0]);
	SendAdminMessage(COLOR_GREY, string);
	format(string, sizeof(string), " %s[%d] заспавнил Вас", GetName(playerid), playerid);
	SendClientMessage(params[0], -1, string);

	if(IsPlayerInAnyVehicle(params[0]))
	{
		SetPlayerPos(params[0], 0,0,0);
	}
	SpawnPlayer(params[0]);
	fLogs("[admin] %s /spawn %s", GetName(playerid), GetName(params[0]));
	return 1;
}


callback::ShowPlayerHistoryName(playerid)
{
	new rows, field;
	cache_get_data(rows, field);

	if(!rows)
	return SendClientMessage(playerid, COLOR_RED, "Истории с этим ником не найдено");

	new
	_date[32],
	old_nick[MAX_PLAYER_NAME],
	new_nick[MAX_PLAYER_NAME],
	allowed[MAX_PLAYER_NAME],
	fmt_str[140];

	global_string = ""cWH"Дата - Старый ник - Новый ник - Одобрил\n\n";

	for(new idx; idx < rows; idx ++)
	{
		cache_get_field_content(idx, "date", _date);
		cache_get_field_content(idx, "old_name", old_nick);
		cache_get_field_content(idx, "name", new_nick);
		cache_get_field_content(idx, "allowed", allowed);

		format(fmt_str, sizeof fmt_str, "%s - %s - %s - %s\n", _date, old_nick, new_nick, allowed);
		strcat(global_string, fmt_str);
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX,""cMain"История ников",global_string,"Закрыть", "");
	return 1;
}

cmd:oldnick(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(!strlen(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/oldnick [имя игрока]");
	if(!(3 <= strlen(params) <= 20)) return SendClientMessage(playerid, COLOR_RED, "Вы ввели неверный ник");
	extract params -> new string: name[21];

	global_string = "";
	mysql_format(db_prod, global_string, 128, "SELECT * FROM historyname WHERE name='%s' OR old_name='%s'", name, name);
	mysql_tquery(db_prod, global_string, "ShowPlayerHistoryName", "d", playerid);
	fLogs("[admin] %s /oldnick %s", GetName(playerid), params);
	return 1;
}

cmd:atakegun(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	new id;
	if(sscanf(params, "i", id)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/atakegun [id игрока]");
	if(!IsPlayerConnected(id)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[id] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	ResetPlayerWeapons(id);
	SendFormatInf(id, "Администратор %s[%d] забрал у Вас оружия", GetName(playerid), playerid);
	if(!g_player_full_access[playerid])
	{
		format(stringer1, sizeof(stringer1), ""aAC"%s[%d] забрал у %s[%d] оружия", GetName(playerid), playerid, GetName(id), id);
		SendAdminMessage(COLOR_GREY, stringer1);
	}
	fLogs("[admin] %s /atakegun %s", GetName(playerid), GetName(id));
	return 1;
}


cmd:fmsg(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	if(F_MSG_Log == true)
	{
        F_MSG_Log = false;
        format(string, sizeof(string), "[F-MSG] %s[%d] выключил логи фракций в чат!", GetName(playerid), playerid);
		SendAdminMessage(COLOR_GREY, string);
	}
	else
	{
        F_MSG_Log = true;
        format(string, sizeof(string), "[F-MSG] %s[%d] включил логи фракций в чат!", GetName(playerid), playerid);
		SendAdminMessage(COLOR_GREY, string);
	}
	fLogs("[admin] %s /fmsg", GetName(playerid));
	return 1;
}

cmd:goto(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/goto [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[playerid][pAdmin] < 8 && AdminInfo[params[0]][admGoto] || g_player_full_access[params[0]] && !g_player_full_access[playerid]) return SendClientMessage(playerid, -1, ""cER"Телепорт к этому администратору запрещён");
	new Float:plocx,Float:plocy,Float:plocz;
	GetPlayerPos(params[0], plocx, plocy, plocz);
	if(GetPlayerState(playerid) == 2) SetVehiclePos(GetPlayerVehicleID(playerid), plocx+2, plocy+2, plocz);
	else SetPlayerPos(playerid, plocx+2, plocy+2, plocz);
	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(params[0]));
	SetPlayerInterior(playerid, GetPlayerInterior(params[0]));

	if(!g_player_full_access[playerid])
	{
		format(string, sizeof(string), ""aAC"%s[%d] телепортировался к игроку %s[%d]", GetName(playerid), playerid, GetName(params[0]), params[0]);
		SendAdminMessage(COLOR_GREY, string);
	}
	fLogs("[admin] %s /goto %s [%f %f %f %i %i]", GetName(playerid), GetName(params[0]), plocx, plocy, plocz, GetPlayerVirtualWorld(params[0]), GetPlayerInterior(params[0]));
	return 1;
}
alias:goto("g");

cmd:down(playerid)
