{
	if(!response) return 1;
	new price;
	if(sscanf(inputtext, "i",price)) return ShowPlayerDialog(playerid, 62+12, 1, ""cMain"Пополнение", ""cWH"Введите количество денег\nна которое хотите пополнить банковский счёт", "Принять", "Назад");
	if(price < 1) return ShowPlayerDialog(playerid, 62+12, 1, ""cMain"Пополнение", ""cWH"Введите количество денег\nна которое хотите пополнить банковский счёт", "Принять", "Назад");
	if(GetPlayerRubble(playerid) < price) { ShowPlayerDialog(playerid, 62+12, 1, ""cMain"Пополнение", ""cWH"Введите количество денег\nна которое хотите пополнить банковский счёт", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!"); }
	GiveBankMoney(playerid, price);
	SetPlayerMoney(playerid, -price);
	SendMes(playerid, COLOR_LIME, "Вы положили на счет: %dр. На счету: %dр", price, g_player_bank_accounts[playerid][ PI[playerid][pMainBankAccount] ][B_BALANCE] );
	return 1;
}
DLG(77, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "Прямой эфир недоступен на Вашем ранге");
			new full = 0, CB[16];
			foreach(new i: Player)
			{
				if(PlayerLogged[i] == false || playerid == i) continue;
				if(Ether[i] == true && PI[i][pMember] == PI[playerid][pMember]) full++;
			}
			if(full > 0) return SendClientMessage(playerid, COLOR_GREY, "Эфир занят! В эфире находиться ваш коллега!");
			if(Ether[playerid] == false)
			{
				if(PI[playerid][pMember] == TEAM_SMI && PI[playerid][pNews] != 1) PI[playerid][pNews] = 1;
				Ether[playerid] = true;
				format(string, 90, "[F] %s вошел в прямой эфир",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_LIGHTBLUE, string);
			}
			else if(Ether[playerid] == true)
			{
				Ether[playerid] = false;
				Convert(InEther[playerid],CB);

				if(EtherSms == true) { format(string, 90, "[F] %s выключил прием СМС",GetName(playerid)); SendFMes(PI[playerid][pMember], COLOR_LIGHTRED, string); }
				if(EtherCall == true) { format(string, 90, "[F] %s выключил прием звонков",GetName(playerid)); SendFMes(PI[playerid][pMember], COLOR_LIGHTRED, string); }
				format(string, 90, "[F] %s вышел из прямого эфира (Время в эфире: %s, звонков: %d, СМС: %d)",GetName(playerid), CB, CallNews, SmsNews);
				SendFMes(PI[playerid][pMember], COLOR_LIGHTRED, string);

				SmsNews = 0;
				CallNews = 0;
				EtherSms = false;
				EtherCall = false;
				InEther[playerid] = 0;
				if(Mobile[playerid] != -1) MobileCrash(playerid);
			}
		}
	case 1:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "Прямой эфир недоступен на Вашем ранге");
			if(Ether[playerid] == false) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в прямом эфире!");
			ShowPlayerDialog(playerid, 77+1, 1, ""cMain"Эфир", ""cWH"Введите ID или имя игрока:", "Принять", "Отмена");
		}
	case 2:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "Прямой эфир недоступен на Вашем ранге");
			if(Ether[playerid] == false) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в прямом эфире!");
			ShowPlayerDialog(playerid, 77+2, 1, ""cMain"Эфир", ""cWH"Введите ID или имя игрока:", "Принять", "Отмена");
		}
	case 3:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "Прямой эфир недоступен на Вашем ранге");
			if(Ether[playerid] == false) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в прямом эфире!");
			if(EtherCall == false)
			{
				EtherCall = true;
				format(string, 90, "[F] %s включил прием звонков",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_GREEN, string);
			}
			else
			{
				EtherCall = false;
				format(string, 90, "[F] %s выключил прием звонков",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_RED, string);
			}
		}
	case 4:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "Прямой эфир недоступен на Вашем ранге");
			if(Ether[playerid] == false) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в прямом эфире!");
			if(EtherSms == false)
			{
				EtherSms = true;
				format(string, 90, "[F] %s включил прием СМС",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_GREEN, string);
			}
			else
			{
				EtherSms = false;
				format(string, 90, "[F] %s выключил прием СМС",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_RED, string);
			}
		}
	case 5:
		{
			if(PI[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_RED, "Недоступно для Вашего ранга");
			if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_RED, "Во время мута Вы не можете проверять объявления");
			AdvertList(playerid);
		}
	}
	return 1;
}
DLG(78, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new targetid;
	if(sscanf(inputtext, "u",targetid)) ShowPlayerDialog(playerid, 77+1, 1, ""cMain"Эфир", ""cWH"Введите ID или имя игрока:", "Принять", "Отмена");
	if(targetid == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете пригласить себя!");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(IsPlayerInAnyVehicle(playerid)&&!IsPlayerInVehicle(targetid, GetPlayerVehicleID(playerid)) || !IsPlayerInAnyVehicle(playerid) && GetDistanceBetweenPlayers(playerid,targetid) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться с вами в транспорте!");
	if(EtherLive[targetid] == true) return SendClientMessage(playerid, COLOR_GREY, "Игрок уже в прямом эфире!");
	if(PI[playerid][pMember] == TEAM_SMI && PI[targetid][pNews] != 1)
	{
		SendMes(playerid, COLOR_GREY, "Игрок должен слушать радио: %s", Fraction_Name[TEAM_SMI]);
		return 1;
	}
	EtherLive[targetid] = true;
	Etherfrac[targetid] = PI[playerid][pMember];
	SendMes(playerid, COLOR_LIGHTBLUE, "Вы пригласили в эфир: %s", GetName(targetid));
	SendMes(targetid, COLOR_LIGHTBLUE, "%s пригласил вас в эфир", GetName(playerid));
	return 1;
}
DLG(79, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new targetid;
	if(sscanf(inputtext, "u",targetid)) ShowPlayerDialog(playerid, 77+2, 1, ""cMain"Эфир", ""cWH"Введите ID или имя игрока:", "Принять", "Отмена");
	if(targetid == playerid) return SendClientMessage(playerid, -1, ""cER"Вы не можете выпроводить себя!");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(IsPlayerInAnyVehicle(playerid)&&!IsPlayerInVehicle(targetid, GetPlayerVehicleID(playerid)) || !IsPlayerInAnyVehicle(playerid) && GetDistanceBetweenPlayers(playerid,targetid) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "Игрок должен находиться с вами в транспорте!");
	if(EtherLive[targetid] == false) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находиться в прямом эфире!");
	EtherLive[targetid] = false;
	Etherfrac[playerid] = 0;
	SendMes(playerid, COLOR_LIGHTRED, "Вы выпроводили из эфира: %s", GetName(targetid));
	SendMes(targetid, COLOR_LIGHTRED, "%s выпроводил вас из эфира", GetName(playerid));
	return 1;
}
DLG(80, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(listitem < 1)
	{
		SendClientMessage(playerid, COLOR_WHITE, "Вы слушаете радио: Ритм");
		PI[playerid][pNews] = 1;
	}
	else
	{
		SendClientMessage(playerid, COLOR_LIGHTRED, "Вы выключили радио");
		PI[playerid][pNews] = 0;
	}
	return 1;
}
DLG(81, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0: ShowPlayerDialog(playerid, 77+9, 1, ""cMain"Панель", ""cWH"Введите цену за 1 секунду в эфире\n\n{FFFF00}Примечание:\n"cWH"Цена может быть от 1р до 3р", "Принять", "Отмена");
	case 1: ShowPlayerDialog(playerid, 77+10, 1, ""cMain"Панель", ""cWH"Введите цену за СМС\n\n{FFFF00}Примечание:\n"cWH"Цена может быть от 10р до 20р", "Принять", "Отмена");
	case 2: ShowPlayerDialog(playerid, 77+11, 1, ""cMain"Панель", ""cWH"Введите цену за 1 символ объявления\n\n{FFFF00}Примечание:\n"cWH"Цена может быть от 5р до 50р", "Принять", "Отмена");//убрать
	}
	return 1;
}
DLG(82, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	AdvertID[playerid] = listitem + 1;
	ShowPlayerDialog(playerid, 77+6, 2, ""cMain"Объявления", "Прочитать объявление\nРедактировать объявление\nУдалить объявление\nОтправить объявление\nОтправить администрации", "Принять", "Назад");
	return 1;
}
DLG(83, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		AdvertID[playerid] = 0;
		AdvertList(playerid);
		return 1;
	}
	switch(listitem)
	{
	case 0:
		{
			format(string, sizeof(string), ""cWH"Текст: %s - Прислал: %s",AdvertInfo[AdvertID[playerid]][aText],AdvertInfo[AdvertID[playerid]][aName]);
			ShowPlayerDialog(playerid, 77+7, 0, ""cMain"Объявления", string, "Назад", "");
		}
	case 1:
		{
			format(string, sizeof(string), ""cWH"Текст: %s - Прислал: %s",AdvertInfo[AdvertID[playerid]][aText],AdvertInfo[AdvertID[playerid]][aName]);
			ShowPlayerDialog(playerid, 77+8, 1, ""cMain"Объявления", string, "Принять", "Назад");
		}
	case 2:
		{
			for(new i = AdvertID[playerid]; i <= TOTALADVERT - 1; i++)
			{
				AdvertInfo[i][aPhone] = AdvertInfo[i+1][aPhone];
				strmid(AdvertInfo[i][aText],AdvertInfo[i+1][aText],0,strlen(AdvertInfo[i+1][aText]), 128);
				strmid(AdvertInfo[i][aName],AdvertInfo[i+1][aName],0,strlen(AdvertInfo[i+1][aName]), MAX_PLAYER_NAME);
			}
			if(TOTALADVERT > 0) TOTALADVERT--;
			SendClientMessage(playerid, COLOR_LIGHTRED, "Объявление удалено");
			AdvertID[playerid] = 0;
			AdvertList(playerid);
		}
	case 3:
		{
			if(AdvertTime > unix)
			{
				AdvertID[playerid] = 0;
				SendClientMessage(playerid, COLOR_GREY, "Отправлять объявление можно раз в 15 секунд!");
				return AdvertList(playerid);
			}

			format(string, sizeof(string), "%s Отправитель: %s (тел.: %d)",AdvertInfo[AdvertID[playerid]][aText], AdvertInfo[AdvertID[playerid]][aName], AdvertInfo[AdvertID[playerid]][aPhone]);
			SendClientMessageToAll(COLOR_GREEN, string);

			format(string, sizeof(string), "   Проверил объявление %s: %s[%d]",frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), playerid);
			SendClientMessageToAll(COLOR_GREEN, string);
			for(new i = AdvertID[playerid]; i <= TOTALADVERT - 1; i++)
			{
				AdvertInfo[i][aPhone] = AdvertInfo[i+1][aPhone];
				strmid(AdvertInfo[i][aText],AdvertInfo[i+1][aText],0,strlen(AdvertInfo[i+1][aText]), 128);
				strmid(AdvertInfo[i][aName],AdvertInfo[i+1][aName],0,strlen(AdvertInfo[i+1][aName]), MAX_PLAYER_NAME);
			}
			if(TOTALADVERT > 0) TOTALADVERT--;
			AdvertTime = unix + 15;
			AdvertID[playerid] = 0;
			AdvertList(playerid);

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `news` WHERE `user_id` = %d", PI[playerid][pID]);
			mysql_tquery(db_prod, STRING_GLOBAL, "OnMemoryCheckPlayerID", "i", playerid);
		}
	case 4:
		{
			format(string, sizeof(string), "[AD] %s: %s Редактор: %s", AdvertInfo[AdvertID[playerid]][aName], AdvertInfo[AdvertID[playerid]][aText], GetName(playerid));
			SendAdminMessage(COLOR_YELLOW, string);
			for(new i = AdvertID[playerid]; i <= TOTALADVERT - 1; i++)
			{
				AdvertInfo[i][aPhone] = AdvertInfo[i+1][aPhone];
				strmid(AdvertInfo[i][aText],AdvertInfo[i+1][aText],0,strlen(AdvertInfo[i+1][aText]), 128);
				strmid(AdvertInfo[i][aName],AdvertInfo[i+1][aName],0,strlen(AdvertInfo[i+1][aName]), MAX_PLAYER_NAME);
			}
			if(TOTALADVERT > 0) TOTALADVERT--;
			SendClientMessage(playerid, COLOR_LIGHTRED, "Объявление отправлено администрации");
			AdvertID[playerid] = 0;
			AdvertList(playerid);
		}
	}
	return 1;
}
DLG(84, playerid, response, listitem, inputtext[])
{
	ShowPlayerDialog(playerid, 77+6, 2, ""cMain"Объявления", "Прочитать объявление\nРедактировать объявление\nУдалить объявление\nОтправить объявление\nОтправить администрации", "Принять", "Назад");
	return 1;
}
DLG(85, playerid, response, listitem, inputtext[])
{
	if(!response) return ShowPlayerDialog(playerid, 77+6, 2, ""cMain"Объявления", "Прочитать объявление\nРедактировать объявление\nУдалить объявление\nОтправить объявление\nОтправить администрации", "Принять", "Назад");
	new text[128];
	if(sscanf(inputtext, "s[128]",text))
	{
		format(string, 128, ""cWH"Текст: %s - Прислал: %s",AdvertInfo[AdvertID[playerid]][aText],AdvertInfo[AdvertID[playerid]][aName]);
		return ShowPlayerDialog(playerid, 77+8, 1, ""cMain"Объявления", string, "Принять", "Назад");
	}
	strmid(AdvertInfo[AdvertID[playerid]][aText],text,0,strlen(text));
	SendClientMessage(playerid, COLOR_LIGHTGREEN, "Объявление отредактировано и сохранено");
	ShowPlayerDialog(playerid, 77+6, 2, ""cMain"Объявления", "Прочитать объявление\nРедактировать объявление\nУдалить объявление\nОтправить объявление\nОтправить администрации", "Принять", "Назад");
	return 1;
}
DLG(86, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price;
	if(sscanf(inputtext, "i",price)) return ShowPlayerDialog(playerid, 77+9, 1, ""cMain"Панель", ""cWH"Введите цену за 1 секунду в эфире\n\n{FFFF00}Примечание:\n"cWH"Цена может быть от 1р до 3р", "Принять", "Отмена");
	if(price < 1 || price > 3) return ShowPlayerDialog(playerid, 77+9, 1, ""cMain"Панель", ""cWH"Введите цену за 1 секунду в эфире\n\n{FFFF00}Примечание:\n"cWH"Цена может быть от 1р до 3р", "Принять", "Отмена");
	CallPrice = price;
	SendMes(playerid, COLOR_LIGHTGREEN, "Цена за 1 секунду в эфире: %dр", price);
	format(NewsPrice, sizeof(NewsPrice),"%d, %d, %d, %d, %d, %d", SmsPrice, SmsPrice, CallPrice, CallPrice, AdvertPrice, AdvertPrice);
	MysqlUpdateOtherStr("newsprice", NewsPrice);
	return 1;
}
DLG(87, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price;
	if(sscanf(inputtext, "i",price)) return ShowPlayerDialog(playerid, 77+10, 1, ""cMain"Панель", ""cWH"Введите цену за СМС\n\n{FFFF00}Примечание:\n"cWH"Цена может быть от 10р до 20р", "Принять", "Отмена");
	if(price < 10 || price > 20) return ShowPlayerDialog(playerid, 77+10, 1, ""cMain"Панель", ""cWH"Введите цену за СМС\n\n{FFFF00}Примечание:\n"cWH"Цена может быть от 10р до 20р", "Принять", "Отмена");
	SmsPrice = price;
	SendMes(playerid, COLOR_LIGHTGREEN, "Цена за СМС: %dр", price);
	format(NewsPrice, sizeof(NewsPrice),"%d, %d, %d, %d, %d, %d", SmsPrice, SmsPrice, CallPrice, CallPrice, AdvertPrice, AdvertPrice);
	MysqlUpdateOtherStr("newsprice", NewsPrice);
	return 1;
}
