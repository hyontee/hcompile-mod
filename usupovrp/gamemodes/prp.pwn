	ShowPlayerDialog(playerid, 3794, DIALOG_STYLE_LIST, ""cMain"Помощь по серверу", "1. Общение\n2. Список игроков\n3. Общее\n4. Оружие и убийство", "Далее", "Отмена");
	return 1;
}
DLG(3794, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	global_string = "";
	switch(listitem)
	{
	case 0:
		{
			stringer1 = "Так же посетите нашу группу вк, в дальнейшем Вам это пригодится vk.com/prpcrmp";
			global_string = "\tОбщение\n\nВы можете общаться с другими игроками через чат в левом верхнем углу.\nЧтобы напечатать сообщение, нажмите клавишу \"F6\" или \"T\" (на латинице).\nТак же с помощью чата используются все команды сервера, к примеру \"/menu\".\n\nИспользуйте \"/menu\" для просмотра персонального меню.\nВ диалоговом окне Вы сможете найти всё необходимое.\nБолее подробное описание Вы найдёте на нашем сайте "SERVER_WEBSITE"\n";
			strcat(global_string, stringer1);
			ShowPlayerDialog(playerid, 3795, DIALOG_STYLE_MSGBOX, ""cMain"Общение", global_string, "Назад", "Закрыть");
		}
	case 1:
		{
			ShowPlayerDialog(playerid, 3795, DIALOG_STYLE_MSGBOX, ""cMain"Список игроков", "\
			\tСписок игроков\n\n\
			Данный список можно посмотреть, нажав клавишу \"TAB\".\n\
			Там вы увидите:\n\n\
			\"ID\" игрока (используется в командах)\n\
			\"Ник\" (Role Play имя игрока)\n\
			\"Уровень\" графа Score (количество лет в стране)\n\
			\"Пинг\" время отклика между Вами и сервером (в милисекундах)\n\n\
			Для просмотра списка полностью, используйте прокрутку справа.\n\
			Вы в этой табличке всегда отображаетесь первым, независимо от ID.", "Назад", "Закрыть");
		}
	case 2:
		{
			ShowPlayerDialog(playerid, 3795, DIALOG_STYLE_MSGBOX, ""cMain"Общее", "\tОбщее\n\n\
			На нашем сервере можно зарабатывать деньги, все работы Вы можете найти в GPS-навигаторе.\n\
			На заработанные деньги возможно приобретать недвижимость, транспорт и прочие мелочи.\n\n\
			Можно работать полицейским защищая гражданских или быть на противоположной стороне закона,\n\
			ведя войну за контроль над кварталами или бизнесами. И это только малая часть доступного!", "Назад", "Закрыть");
		}
	case 3:
		{
			stringer1 = "Так же почитайте Правила на нашем форуме kaif-crmp.com > Форум";
			global_string = "\tОружие и убийство\n\nЗа убийство человека Вы будете объявлены в розыск, как опасный преступник,\nа при аресте Вы лишитесь свободы и сядете в тюрьму!\n";
			strcat(global_string, stringer1);
			ShowPlayerDialog(playerid, 3795, DIALOG_STYLE_MSGBOX, ""cMain"Оружие и убийство", global_string, "Назад", "Закрыть");
		}
	}
	return 1;
}
DLG(3795, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	ShowPlayerDialog(playerid, 3794, DIALOG_STYLE_LIST, ""cMain"Помощь по серверу", "1. Общение\n2. Список игроков\n3. Транспорт\n4. Общее\n5. Оружие и убийство\n6. Получение документов", "Далее", "Отмена");
