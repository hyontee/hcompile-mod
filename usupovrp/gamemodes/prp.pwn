DLG(2944, playerid, response, listitem, inputtext[]) {
	if(!response) return 1;
	if(PI[playerid][pPerfectCoins] < player_car_buy[playerid][1]) return SCM(playerid, COLOR_RED, "Не хватает King Coins (Пополнить: king-crmp.com)");
	if(player_car_buy[playerid][0] == 0) return SCM(playerid, COLOR_RED, "Попробуйте снова");

	SPD(playerid, 2945, DIALOG_STYLE_LIST, !""cMain"Выберите пункт", !""cMain"1. "cWH"Купить личный автомобиль\n\
	"cMain"2. "cWH"Купить семейный автомобиль", !"Купить", !"Отмена");
	return 1;

}
DLG(2945, playerid, response, listitem, inputtext[]) {
	if(!response) return 1;

    switch(listitem)
	{

		case 0:
		{
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `ownable_cars` (`c_model`, `c_x`, `c_y`, `c_z`, `c_a`, `c_class`, `c_owner`, `c_fuel`, `c_color1`, `c_color2`, `c_lock`, `c_price`, `c_health`) VALUES ('%d', '0', '0', '0', '0', '1', '%e', '45', '-1', '-1', '1', '9000000', '1000.0')", player_car_buy[playerid][0], GetName(playerid));
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			PI[playerid][pPerfectCoins] -= player_car_buy[playerid][1];
			PI[playerid][pCountCars] ++;

			fLogs("[cars] %s +%i донат", GetName(playerid),  player_car_buy[playerid][1]);
			fLogs("[coin] %s -%i тачка %s", GetName(playerid), player_car_buy[playerid][1], name_car[playerid]);
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET credits=%d, countcars=%d WHERE id=%d", PI[playerid][pPerfectCoins], PI[playerid][pCountCars], PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");

			SendFormatInf(playerid, "Вы успешно приобрели "cMain"%s ?? "cMain"%d"cWH" King Coins", name_car[playerid], player_car_buy[playerid][1]);
		}
		case 1:
		{
			new f = PI[playerid][pFamily];
			if(!f) return SendErr(playerid, "У вас нет семьи");
			if(family_info[f][f_total_cars] >= 5) return SendErr(playerid, "Ваш семейный автопарк не может включать более 5 машин");

			PI[playerid][pPerfectCoins] -=  player_car_buy[playerid][1];
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET credits=%d, countcars=%d WHERE id=%d", PI[playerid][pPerfectCoins], PI[playerid][pCountCars], PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");

			family_info[f][f_total_cars] ++;
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `family_cars` (`model`, `x`, `y`, `z`, `fa`, `color1`, `color2`, `family`, `cost`) VALUES ('%d', '0', '0', '0', '0', '%d', '%d', '%d', '%d')", player_car_buy[playerid][1], 0, 0, f, 0);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Автомобиль",
			""cWH"Поздравляем вас с покупкой семейного автомобиля!\n\
			Автомобиль был отбуксирован на автостоянку\n\n\
			Для загрузки автомобиля в игру, используйте: "cMain"/family\n\
			"cWH"Для поиска семейного автомобиля, ипспользуйте: "cMain"/family", "Закрыть", "");
		}
	}
	player_car_buy[playerid][1] = 0, player_car_buy[playerid][0] = 0, name_car[playerid] = "None";

	return 1;
}
stock Update_DonateCarBuy(playerid)
{
	new price_car[DCB_MAX_ITEM_LIST], model_car[DCB_MAX_ITEM_LIST], b;

	for(new i = (page_DCB[playerid]*DCB_MAX_ITEM_LIST)-DCB_MAX_ITEM_LIST; i < page_DCB[playerid]*DCB_MAX_ITEM_LIST; i++)
	{
		if(i > ITEM_DONATE_CARS-1 || pagelimit_DCB[playerid] == true)
		{
			pagelimit_DCB[playerid] = true;
			break;
		}

		price_car[b] = gDonatePrice[i];
		model_car[b] = gDonateCars[i];
		b++;
	}

	for(new i = 13; i <= 20; i++) //цена
	{
		if(price_car[i-13] > 0)
		{
			format(stringer1, sizeof(stringer), "ЦЕНА:_%d", price_car[i-13]);
			PlayerTextDrawSetString(playerid, donat_cars_PTD[playerid][i], stringer1);
		}
		else PlayerTextDrawSetString(playerid, donat_cars_PTD[playerid][i], "");
	}

	for(new i = 5; i <= 12; i++) //товар
	{
		if(model_car[i-5] > 0)
		{
			format(stringer1, sizeof(stringer), "%s", VehicleNames[model_car[i-5]-400]);
			PlayerTextDrawSetString(playerid, donat_cars_PTD[playerid][i], stringer1);
		}
		else PlayerTextDrawSetString(playerid, donat_cars_PTD[playerid][i], "");
	}

	for(new i = 21; i <= 28; i++) //первью модели
	{
		if(model_car[i-21] > 0)
		{
			PlayerTextDrawSetPreviewModel(playerid, donat_cars_PTD[playerid][i], model_car[i-21]);
			PlayerTextDrawShow(playerid, donat_cars_PTD[playerid][i]);
		}
		else PlayerTextDrawHide(playerid, donat_cars_PTD[playerid][i]);
	}
	return 1;
}

stock Hide_DonateCarBuy(playerid)
{
	for(new i; i < 37; i++)
	{
		PlayerTextDrawHide(playerid, donat_cars_PTD[playerid][i]);

		if(donat_cars_PTD[playerid][i] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, donat_cars_PTD[playerid][i]);
		donat_cars_PTD[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
	}

	page_DCB[playerid] = 1;
	selectcar_DCB[playerid] = 0;

	pagelimit_DCB[playerid] = false;
	showed_DCB[playerid] = false;
	CancelSelectTextDrawEx(playerid);
	return 1;
}

IsLoginInvalid(text[])
{
	if(strfind(text, "none", false) != -1) return 1;
	if(strfind(text, "'", true) != -1) return 1;
	if(strfind(text, "/", true) != -1) return 1;
	if(strfind(text, "%", true) != -1) return 1;
	if(strfind(text, "&", true) != -1) return 1;
	if(strfind(text, "*", true) != -1) return 1;
	if(strfind(text, "(", true) != -1) return 1;
	if(strfind(text, ")", true) != -1) return 1;
	if(strfind(text, "1", true) != -1) return 1;
	if(strfind(text, "2", true) != -1) return 1;
	if(strfind(text, "3", true) != -1) return 1;
	if(strfind(text, "4", true) != -1) return 1;
	if(strfind(text, "5", true) != -1) return 1;
	if(strfind(text, "6", true) != -1) return 1;
	if(strfind(text, "7", true) != -1) return 1;
	if(strfind(text, "8", true) != -1) return 1;
	if(strfind(text, "9", true) != -1) return 1;
	return 0;
}
#if defined TL_VERSION

callback::TL_TIMER(playerid)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		if(GetPVarInt(playerid, "traffic_light_tick") < gettime())
		{
			for(new i = 0; i != sizeof g_traffic_lights; i ++)
			{
				if(IsPlayerInRangeOfPoint(playerid, 4.0, g_traffic_lights[i][TL_POS_X], g_traffic_lights[i][TL_POS_Y], g_traffic_lights[i][TL_POS_Z]))
				{
					if(g_traffic_lights[i][TL_COLOR] == TLC_RED)
					{
						if(!IsACopAndFSB(playerid))
						{
							new vehicleid = GetPlayerVehicleID(playerid);

							if(GetVehSpeed(vehicleid) > 10.0)
							{
								STRING_GLOBAL[0] = EOS;

								format(STRING_GLOBAL, sizeof STRING_GLOBAL, "| {ffffff}Вы были оштрафованы на {badc58}%d рублей {ffffff}за проезд на красный сигнал светофора.", TRAFFIC_LIGHTS_PRICE);
								SendClientMessage(playerid, COLOR_RED, STRING_GLOBAL);

								SetPlayerMoney(playerid, -TRAFFIC_LIGHTS_PRICE);

								SetPVarInt(playerid, "traffic_light_tick", gettime() + 15);

								GameTextForPlayer(playerid, "~r~ПРОЕЗД НА КРАСНЫЙ~n~~w~ШТРАФ", 2000, 4);
							}
						}
					}
				}
			}
		}
	}

	g_player_timer[playerid] = SetTimerEx("TL_TIMER", 100, false, "i", playerid);

	return 1;
}

#endif

cmd:players(playerid)
{
	if(!g_player_full_access[playerid] || PI[playerid][pAdmin] < 11) return 1;

	new mobile_players, all_players;

	foreach(new i : Player)
	{
		if(IsPlayerFromThePhone(i))
			mobile_players ++;

		all_players ++;
	}

	SCMF(playerid, -1, "[1] Всего игроков: %d, игроков с телефона: %d, игроков с ПК: %d", all_players, mobile_players, all_players-mobile_players);

	new mobile_players_gpv, all_players_gpv;

	foreach(new i : Player)
	{
		new StringMax[50];

		GetPlayerVersion(i, StringMax, sizeof(StringMax));

		if(!strcmp(StringMax, "prp-mob-a", true))
			mobile_players_gpv ++;

		all_players_gpv ++;
	}

	SCMF(playerid, -1, "[2] Всего игроков: %d, игроков с телефона: %d, игроков с ПК: %d", all_players_gpv, mobile_players_gpv, all_players_gpv-mobile_players_gpv);

	return 1;
}

cmd:authentificator(playerid)
{
	foreach(new i : Player)
	{
		if(!PlayerLogged[i]) continue;
		new StringMax[50];
		GetPlayerVersion(i, StringMax, sizeof(StringMax));

		if(!IsPlayerFromThePhone(i))
		{
			if(!strcmp(StringMax, "prp-mob-a", true))
			{
				SCMF(playerid, -1, "DETECTED! NAME: %s[ID:%d], GPV = prp-mob-a, is_mob = 0 ???", GetName(i), i);
			}
		}
	}
}

