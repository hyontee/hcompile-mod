SaveVehicleTuning(playerid, sql_id)
{
	new
		tune[14];

	if(GetPlayerVehicle(playerid))
	{
		new
			vehid = GetPlayerVehicleID(playerid);

		tune[0] = GetVehicleComponentInSlot(vehid, CARMODTYPE_SPOILER);
		tune[1] = GetVehicleComponentInSlot(vehid, CARMODTYPE_HOOD);
		tune[2] = GetVehicleComponentInSlot(vehid, CARMODTYPE_ROOF);
		tune[3] = GetVehicleComponentInSlot(vehid, CARMODTYPE_SIDESKIRT);
		tune[4] = GetVehicleComponentInSlot(vehid, CARMODTYPE_LAMPS);
		tune[5] = GetVehicleComponentInSlot(vehid, CARMODTYPE_NITRO);
		tune[6] = GetVehicleComponentInSlot(vehid, CARMODTYPE_EXHAUST);
		tune[7] = GetVehicleComponentInSlot(vehid, CARMODTYPE_WHEELS);
		tune[8] = GetVehicleComponentInSlot(vehid, CARMODTYPE_STEREO);
		tune[9] = GetVehicleComponentInSlot(vehid, CARMODTYPE_HYDRAULICS);
		tune[10] = GetVehicleComponentInSlot(vehid, CARMODTYPE_FRONT_BUMPER);
		tune[11] = GetVehicleComponentInSlot(vehid, CARMODTYPE_REAR_BUMPER);
		tune[12] = GetVehicleComponentInSlot(vehid, CARMODTYPE_VENT_RIGHT);
		tune[13] = GetVehicleComponentInSlot(vehid, CARMODTYPE_VENT_LEFT);

		new
			veh_string[64];
		format(veh_string, 64, "%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
		tune[0], tune[1], tune[2], tune[3], tune[4], tune[5], tune[6], tune[7], tune[8], tune[9], tune[10], tune[11], tune[12], tune[13]);

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `ownable_cars` SET `c_vehcom` = '%s' WHERE c_owner = '%s' and id = '%i'", veh_string, GetName(playerid), sql_id);
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");

		STRING_GLOBAL[0] = EOS;

		format
		(
			STRING_GLOBAL, sizeof STRING_GLOBAL, "UPDATE `ownable_cars` SET "\
			"`neon_color_r` = '%d', "\
			"`neon_color_g` = '%d', "\
			"`neon_color_b` = '%d', "\
			"`lights_color_r` = '%d', "\
			"`lights_color_g` = '%d', "\
			"`lights_color_b` = '%d', "\
			"`tining_color_r` = '%d', "\
			"`tining_color_g` = '%d', "\
			"`tining_color_b` = '%d', "\
			"`tining_transparent` = '%d', "\
			"`rgb_color_r` = '%d', "\
			"`rgb_color_g` = '%d', "\
			"`rgb_color_b` = '%d' "\
			"WHERE c_owner = '%s' and id = '%i' LIMIT 1",
			GetVehicleTuning(vehid, VT_NEON_COLOR_R),
			GetVehicleTuning(vehid, VT_NEON_COLOR_G),
			GetVehicleTuning(vehid, VT_NEON_COLOR_B),
			GetVehicleTuning(vehid, VT_LIGHTS_COLOR_R),
			GetVehicleTuning(vehid, VT_LIGHTS_COLOR_G),
			GetVehicleTuning(vehid, VT_LIGHTS_COLOR_B),
			GetVehicleTuning(vehid, VT_TINING_COLOR_R),
			GetVehicleTuning(vehid, VT_TINING_COLOR_G),
			GetVehicleTuning(vehid, VT_TINING_COLOR_B),
			GetVehicleTuning(vehid, VT_TINING_TRANSPARENT),
			GetVehicleTuning(vehid, VT_MAIN_COLOR_R),
			GetVehicleTuning(vehid, VT_MAIN_COLOR_G),
			GetVehicleTuning(vehid, VT_MAIN_COLOR_B),
			GetName(playerid),
			sql_id
		);

		mysql_tquery(db_prod, STRING_GLOBAL);
	}
	return 1;
}
CreateAccount(playerid, password[])
{
	if(PlayerRegistered[playerid] == 0) return KickEx(playerid, "reg0");
	new pass[50];
	mysql_escape_string(password, pass, db_prod);
	if(IsTextInvalid(pass))
	{
		SendClientMessage(playerid, COLOR_RED, "В пароле должны быть только буквы и цифры");
		return KickEx(playerid, "reg_inv_t");
	}
	regstatus{playerid} = false;

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `accounts` (`name`, `password`, `referal`, `regip`, `datareg`, `sex`, `age`, `model`, `mail`, day) VALUES ('%e', '%s', '%e', '%e', '%02d.%02d.%04d', '%d', '%d', '%d', '%s', '%d')", GetName(playerid), pass, PI[playerid][pReferal], PI[playerid][pIP], day, month, year, PI[playerid][pSex], PI[playerid][pAge], PI[playerid][pModel], PI[playerid][pMail], day);
	mysql_tquery(db_prod, STRING_GLOBAL);


	mysql_format(db_prod, stringer1, 128, "SELECT * FROM accounts WHERE `name` = '%s'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "SelectPlayerRegID", "d", playerid);

	playerReg{playerid} = 0;
	PlayerLogged[playerid] = true;
	PlayerRegistered[playerid] = 0;

	PI[playerid][pPerfectCoins] = 0;
	PI[playerid][pCash] = BONUS_CASH;
	PI[playerid][pLevel] = BONUS_LVL;
	PI[playerid][pCountCars] = 3;

	PI[playerid][pVip] = VIP_STATE_NONE;
	PI[playerid][pVipTime] = 0;

	ResetPlayerMoney(playerid); GivePlayerMoney(playerid, PI[playerid][pCash]);

	if(PI[playerid][pSettingTD][0] == 1)
	{
		if(!IsPlayerFromThePhone(playerid))
			CPTD_Euro(playerid);
	}
	if(PI[playerid][pSettingTD][2] == 1) for(new i; i < 15; i++) TextDrawShowForPlayer(playerid, server_info_td[i]);

	PI[playerid][pHouse] = -1;
	PI[playerid][pHouseArend] = -1;
	PI[playerid][pBiz] = -1;
	PI[playerid][pGarage] = -1;
	PI[playerid][pRoom] = -1;

	PI[playerid][pSprunk] = 7000;
	Conday[2]++;

	for(new i; i < 50; i++) SendClientMessage(playerid, COLOR_WHITE, "");
	SendClientMessage(playerid, COLOR_WHITE, ""cPS"Вы успешно зарегистрировались на "cMain""SERVER_NAME"!");
	SendClientMessage(playerid, -1, ""cPS"Появился вопрос? Задавайте его администраторам сервера "cMain"(/report)");

	playerAuthTime[playerid] = -1;

	#if defined BINDER_VERSION
	LoadPlayerBinder(playerid);
	#endif

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "{ffffff}[A] Приветствуем нового игрока - {f6e58d}%s", GetName(playerid));
	SendAdminMessage(COLOR_WHITE, STRING_GLOBAL);

	/*ShowPlayerDialog
	(
		playerid, 0, DIALOG_STYLE_MSGBOX,
		"{7bed9f}Закрытое Бета Тестирование",
		"{ffffff}Приветствуем Вас на Закрытом Бета Тестировании {7bed9f}PERFECT RUSSIA{ffffff}!\n\n"\
		"Мы безумно рады видеть Вас и надеемся, что Вы сможете обнаружить\n"\
		"максимальное количество {7bed9f}недоработок {ffffff}нашей игры.\n\n"\
		"Вам был выдан бонус при регистрации в виде {7bed9f}денег {ffffff}и {7bed9f}Perfect Coins{ffffff}, обо всех\n"\
		"найденных недоработках сообщайте в {7bed9f}конференцию {ffffff}с подписью {7bed9f}#BUG{ffffff}.",
		"Закрыть", ""
	);*/

	//ShowPlayerHud(playerid);

	SpawnPlayer(playerid);

	return 1;
}

