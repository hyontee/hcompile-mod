DLG(3600, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		actplayerid[playerid] = 0;
		actfraction[playerid] = 0;
		return 1;
	}
	new actplayerid_ = actplayerid[playerid];
	new fractionid = actfraction[playerid];
	new skinid = Fraction_Skin[fractionid][listitem];
	if(!IsPlayerConnected(actplayerid_)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(!PlayerLogged[actplayerid_]) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);

	PI[actplayerid_][pRank] = 10;
	PI[actplayerid_][pLeader] = PI[actplayerid_][pMember] = fractionid;
	PI[actplayerid_][pSpawnChange] = 2;
	PI[actplayerid_][pMemberSkin] = skinid;

	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=2, rank=%d, memberskin=%d, leader=%d, member=%d WHERE id=%d", PI[actplayerid_][pRank], PI[actplayerid_][pMemberSkin], fractionid, fractionid, PI[actplayerid_][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	SetPlayerSkin(actplayerid_, PI[actplayerid_][pMemberSkin]);
	format(string, sizeof(string), "Вы назначили %s лидером организации: %s", GetName(actplayerid_), Fraction_Name[fractionid]);
	SendClientMessage(playerid, COLOR_LIME, string);
	format(string, sizeof(string), "Администратор %s назначил Вас лидером организации: %s", GetName(playerid), Fraction_Name[fractionid]);
	SendClientMessage(actplayerid_, COLOR_BLUE, string);
	format(string, sizeof(string), ""aAC"%s назначил %s лидером организации \"%s\"", GetName(playerid), GetName(actplayerid_), Fraction_Name[fractionid]);
	SendAdminMessage(COLOR_GREY, string);

	fLogs("[admin] %s /setleader %s %i(%s)", GetName(playerid), GetName(actplayerid_), fractionid, Fraction_Name[fractionid]);
	ResetPlayerWeapons(actplayerid_);
	SetPlayerColorEx(actplayerid_, TeamColors[GetTeamID(actplayerid_)]);
	actplayerid[playerid] = 0;
	actfraction[playerid] = 0;
	return 1;
}
DLG(3400, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new fractionid = listitem+1;

	PI[playerid][pRank] = 9;
	PI[playerid][pTempLeader] = PI[playerid][pMember] = fractionid;
	PI[playerid][pMemberSkin] = GetPlayerSkin(playerid);
	PI[playerid][pSpawnChange] = 2;

	SetPlayerColorEx(playerid, TeamColors[GetTeamID(playerid)]);
	ResetPlayerWeapons(playerid);

	format(string, sizeof(string), "Вы тихо вступили в организации: %s", Fraction_Name[fractionid]);
	SendClientMessage(playerid, COLOR_LIME, string);
	format(string, sizeof(string), ""aAC"%s тихо вступили в организации \"%s\"", GetName(playerid), Fraction_Name[fractionid]);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /ainvite %i(%s)", GetName(playerid), fractionid, Fraction_Name[fractionid]);
	return 1;
}
DLG(50, playerid, response, listitem, inputtext[])
{
	new targetid = PlayerRank[playerid];
	if(!response) { PlayerRank[playerid] = INVALID_PLAYER_ID; return 1; }
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находиться в организации!");
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
	if(PI[targetid][pMember] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок находиться в другой организации!");
	if(PI[targetid][pRank] == PI[playerid][pRank]) return SendClientMessage(playerid, -1, ""cER"Заму нельзя назчначить ранг!");
	if(PI[targetid][pMember] == TEAM_ARMY && PI[targetid][Billet] == 0 && listitem+1 >= 3)
	{
		PI[targetid][Billet] = 1;
		MysqlUpdatePlayerInt(targetid, "Billet", PI[targetid][Billet]);
		SendClientMessage(targetid, 0xFFFF00FF, "Поздравляем! Вы получили военный билет");
	}
	PlayerRank[playerid] = INVALID_PLAYER_ID;
	PI[targetid][pRank] = listitem+1;
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET rank=%d WHERE id=%d", PI[targetid][pRank], PI[targetid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");
	SendMes(targetid,COLOR_BLUE,"%s %s повысил/понизил ваш ранг. Сейчас вы: %s",frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid),frakRangName[PI[targetid][pMember]][PI[targetid][pRank]]);
	SendMes(playerid,COLOR_BLUE,"Вы повысили/понизили ранг %s. Сейчас он/она: %s",GetName(targetid), frakRangName[PI[targetid][pMember]][PI[targetid][pRank]]);
	PI[playerid][pLeaderStat][LEADER_RANK] ++;

	fLogs("[giverank] %s /giverank(%d) %s [%s]", GetName(playerid), PI[targetid][pRank], GetName(targetid), Fraction_Name[PI[playerid][pMember]]);
	if(F_MSG_Log == true)
	{
        format(string, sizeof(string), "[F-MSG] %s[%d] giverank(%d) %s[%d] in %s", GetName(playerid), playerid, PI[targetid][pRank], GetName(targetid), targetid, Fraction_Name[PI[playerid][pMember]]);
		SendAdminMessage(COLOR_GREY, string);
	}
	return 1;
}
DLG(51, playerid, response, listitem, inputtext[])
{
	new targetid = PlayerRank[playerid];
	if(!response) { PlayerRank[playerid] = INVALID_PLAYER_ID; return 1; }
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Игрок не находится в организации!");
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
	PlayerRank[playerid] = INVALID_PLAYER_ID;
	PI[targetid][pRank] = listitem+1;
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET rank=%d WHERE id=%d", PI[targetid][pRank], PI[targetid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");
	SendMes(targetid,COLOR_BLUE,"Администратор %s повысил/понизил ваш ранг. Сейчас вы: %s",GetName(playerid),frakRangName[PI[targetid][pMember]][PI[targetid][pRank]]);
	SendMes(playerid,COLOR_LIME,"Вы повысили/понизили ранг %s. Сейчас он/она: %s",GetName(targetid), frakRangName[PI[targetid][pMember]][PI[targetid][pRank]]);
	return 1;
}

DLG(57, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new actplayerid_ = actplayerid[playerid];
	new fractionid = PI[actplayerid_][pMember];
	new skinid = Fraction_Skin[fractionid][listitem];
	if(skinid == PI[actplayerid_][pMemberSkin]) return 1;
	new mes[128];
	format(mes,sizeof(mes), "%s выдал Вам новую фракционную одежду", GetName(playerid));
	SendClientMessage(actplayerid_, COLOR_BLUE, mes);
	format(mes,sizeof(mes), "%s получил новую фракционную одежду", GetName(actplayerid_));
	SendClientMessage(playerid, COLOR_BLUE, mes);
	PI[actplayerid_][pMemberSkin] = skinid;

	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET memberskin=%d WHERE id=%d", PI[actplayerid_][pMemberSkin], PI[actplayerid_][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	SetPlayerSkin(actplayerid_, skinid);
	actplayerid[playerid] = 0;
	return 1;
}
DLG(143, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!strcmp(inputtext, "Следующая страница")) playerPage[playerid]++;
	else if(!strcmp(inputtext, "Предыдущая страница")) playerPage[playerid]--;
	AdminOnline(playerid);
	return 1;
}

DLG(7500, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new slen = strlen(inputtext);
	mfor(i, (slen - 1)) if('А' <= inputtext[i] <= 'Я' || 'а' <= inputtext[i] <= 'я' || inputtext[i] == ' ' || inputtext[i] == '=')
	{
		ShowPlayerDialog(playerid, 7500, DIALOG_STYLE_INPUT, ""cWH"Уволить игрока", "Введите ник игрока, которого Вы хотите уволить:", "Далее","Отмена");
		return SendClientMessage(playerid,COLOR_GREY,"Используйте только английские буквы!");
	}
	if(slen < 3 || slen > 24)
	{
		ShowPlayerDialog(playerid, 7500, DIALOG_STYLE_INPUT, ""cWH"Уволить игрока", "Введите ник игрока, которого Вы хотите уволить:", "Далее","Отмена");
		return 1;
	}
	format(global_string, sizeof(global_string), "SELECT `name`,`leader` FROM `accounts` WHERE name = '%s' AND online = '1001' AND member = '%d' LIMIT 1",inputtext,PI[playerid][pMember]);
	mysql_tquery(db_prod, global_string, "OfflineUninviteOnFraction", "i", playerid);
	return 1;
}
DLG(71, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new Float:x, Float:y, Float:z, Float:angle;
	GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, angle);
	x += floatsin(-angle, degrees);
	y += floatcos(-angle, degrees);
	new atm1;
	SendClientMessage(playerid, COLOR_LIGHTRED, "Чтобы выйти, нажмите: ESC и чтобы сохранить, нажмите курсором: СОХРАНИТЬ");
	atm1 = CreateObject(11135, x, y, z-0.35, 0.0, 0.0, 0.0);
	LoadATMObject[playerid] = atm1 + 1;
	EditObject(playerid, atm1);
	return 1;
}
DLG(67, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			format(string, 90, ""cWH"Баланс банковского счёта: {63BD4E}%dр", g_player_bank_accounts[playerid][ PI[playerid][pMainBankAccount] ][B_BALANCE]);
			ShowPlayerDialog(playerid, 0, 0, ""cMain"Баланс", string, "Назад", "");
		}
	case 1: ShowPlayerDialog(playerid, 62+7, 1, ""cMain"Пополнение", ""cWH"Введите количество денег\nна которое хотите пополнить банковский счёт", "Принять", "Назад");
	case 2: ShowPlayerDialog(playerid, 62+8, 1, ""cMain"Снять со счета", ""cWH"Введите количество денег\nкоторое хотите снять с банковского счёта", "Принять", "Назад");
	case 3:
		{
			if(!TransferReset[playerid])
			{
				if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 10) return SendClientMessage(playerid,COLOR_GREY,"Переводить деньги можно только отыграв 10 часов (10 EXP)");
				else ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"Перевод", ""cWH"Введите ID игрока и количество денег через запятую\n\nПример: 234, 10000", "Принять", "Назад");
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREY, "Переводить деньги можно только раз в минуту.");
			}
		}
	case 4:
		{
			if(GetPlayerHouse(playerid) > 0)
			{
				if(GetPlayerHouse(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет дома!");
				format(string, sizeof(string), ""cWH"Введите сумму пополнения\nВаш дом оплачен на %d дней", HouseInfo[GetPlayerHouse(playerid)][hOplata]);
				ShowPlayerDialog(playerid, 5200+5, 1, ""cMain"Пополнение домашнего счета", string, "Принять", "Назад");
			}
			if(GetPlayerRooms(playerid) > 0)
			{
				if(GetPlayerRooms(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"У вас нет квартиры!");
				format(string, sizeof(string), ""cWH"Введите сумму пополнения\nВаша квартира оплачена на: %d дней", RoomsInfo[GetPlayerRooms(playerid)][rOplata]);
				ShowPlayerDialog(playerid, 5200+6, 1, ""cMain"Пополнение домашнего счета", string, "Принять", "Назад");
			}
			else SendClientMessage(playerid, -1, ""cER"У вас нет квартиры/дома!");
		}
	case 5:
		{
			new b = GetPlayerBizz(playerid);
			if(GetPlayerBizz(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вы не владеете бизнесом!");
			format(string, sizeof(string), ""cWH"Введите сумму пополнения\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
			ShowPlayerDialog(playerid, 106+21, 1, ""cMain"Пополнение счета бизнеса", string, "Принять", "Назад");
		}
	case 6:
		{

			new b = GetPlayerBizz(playerid);
			if(GetPlayerBizz(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вы не владеете бизнесом!");
			format(string, sizeof(string), ""cWH"Введите сумму вывода денег с бизнеса\nТекущий счет бизнеса: %dр", BizzInfo[b][bMoney]);
			ShowPlayerDialog(playerid, 106+213, 1, ""cMain"Вывод счета с бизнеса", string, "Принять", "Назад");
		}
	}
	return 1;
}
DLG(69, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price;
	if(sscanf(inputtext, "i",price)) return ShowPlayerDialog(playerid, 62+7, 1, ""cMain"Пополнение", ""cWH"Введите количество денег\nна которое хотите пополнить банковский счёт", "Принять", "Назад");
	if(price < 1) return ShowPlayerDialog(playerid, 62+7, 1, ""cMain"Пополнение", ""cWH"Введите количество денег\nна которое хотите пополнить банковский счёт", "Принять", "Назад");
	if(GetPlayerRubble(playerid) < price) { ShowPlayerDialog(playerid, 62+7, 1, ""cMain"Пополнение", ""cWH"Введите количество денег\nна которое хотите пополнить банковский счёт", "Принять", "Назад"); return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!"); }
	GiveBankMoney(playerid, price);
	SetPlayerMoney(playerid, -price);
	SendMes(playerid, COLOR_LIME, "Вы положили на счет: %dр. На счету: %dр", price, g_player_bank_accounts[playerid][ PI[playerid][pMainBankAccount] ][B_BALANCE]);
	return 1;
}
DLG(70, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new price;
	if(sscanf(inputtext, "i",price)) return ShowPlayerDialog(playerid, 62+8, 1, ""cMain"Снять со счета", ""cWH"Введите количество денег\nкоторое хотите снять с банковского счёта", "Принять", "Назад");
	if(price < 1) return ShowPlayerDialog(playerid, 62+8, 1, ""cMain"Снять со счета", ""cWH"Введите количество денег\nкоторое хотите снять с банковского счёта", "Принять", "Назад");
	if(g_player_bank_accounts[playerid][ PI[playerid][pMainBankAccount] ][B_BALANCE] < price)
	{
		ShowPlayerDialog(playerid, 62+8, 1, ""cMain"Снять со счета", ""cWH"Введите количество денег\nкоторое хотите снять с банковского счёта", "Принять", "Назад");
		SendClientMessage(playerid, COLOR_GREY, "На вашем счету в банке не хватает денег!");
		return 1;
	}
	if(GetPlayerLimitMoney(playerid, price))
	{
		SendErr(playerid, "У Вас максимальное количество денег.");
		return 1;
	}
	GiveBankMoney(playerid, -price);
	SetPlayerMoney(playerid, price);
	SendMes(playerid, COLOR_LIME, "Вы сняли со счета: %dр. На счету: %dр", price, g_player_bank_accounts[playerid][ PI[playerid][pMainBankAccount] ][B_BALANCE]);
	return 1;
}
