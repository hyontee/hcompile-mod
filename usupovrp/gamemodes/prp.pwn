callback::CheckAccount(playerid)
{
	switch(cache_get_field_content_int(0, "pGuard"))
	{
	case 0:
		{
			mysql_format(db_prod, stringer1, sizeof stringer1, "SELECT * FROM `accounts` WHERE `name`='%e'", GetName(playerid));
			mysql_tquery(db_prod, stringer1, "OnPlayerLogin", "d", playerid);
		}
	case 1:
		{
			if(strcmp(PI[playerid][pIP], PI[playerid][pLastIP], false, 5) != 0)
			{
				global_string="";
				mysql_format(db_prod, global_string, 200, "SELECT `user_id` FROM accounts WHERE `name` = '%e'", GetName(playerid));
				mysql_tquery(db_prod, global_string, "SendCode", "d", playerid);
			}
			else
			{
				mysql_format(db_prod, stringer1, sizeof stringer1, "SELECT * FROM `accounts` WHERE `name`='%e'", GetName(playerid));
				mysql_tquery(db_prod, stringer1, "OnPlayerLogin", "d", playerid);
			}
		}
	case 2:
		{
			global_string="";
			mysql_format(db_prod, global_string, 200, "SELECT `user_id` FROM accounts WHERE `name` = '%e'", GetName(playerid));
			mysql_tquery(db_prod, global_string, "SendCode", "d", playerid);
		}
	default:
		{
			SCM(playerid, -1, "Произошла системная ошибка №2812. Соединение закрыто.");
			KickEx(playerid, "checkacc_err");
		}
	}
	return 1;
}
callback::SendCode(playerid)
{
	PlayerLogTries[playerid] = 0;

	playerCode[playerid] = random(999999-100000)+100000;
	nformat(stringer1, "botvk.perfect-rp.ru/vk_sender.php?message=Ваш+код+для+входа+на+PERFECT+CRMP:+%i+.+Никому+его+не+передавайте!+IP+с+которого+совершен+вход:+%s&to=%i", playerCode[playerid], PI[playerid][pIP], cache_get_field_content_int(0, "user_id"));
	HTTP(playerid, HTTP_GET, stringer1, "", "");
	ShowPlayerDialog(playerid, 9245, DSI, ""cMain"VK-Guard", ""cWH"У вас подключена защита VK-Guard! \n Введите код который отослала Вам наша группа в VK:", "Далее", "Выйти");
}
