cmd:buyhouse(playerid)
{
	if(!is_player_in_rieltor_house[playerid]) return 1;

	new idx = buy_house_id[playerid];
	if(!strcmp(HouseInfo[idx][hOwner], "None", true))
	{
		new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, HouseInfo[idx][hPrice]);
		if(HouseInfo[idx][hType] == 0)
		{
			if(PI[playerid][pCash] < price_house) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег! Используйте /exithouse для отмены покупки");
			if(GetPlayerHouse(playerid)) return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом! Используйте /exithouse для отмены покупки"), ExitRieltorMenu(playerid);
			if(GetPlayerRooms(playerid)) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира! Используйте /exithouse для отмены покупки"), ExitRieltorMenu(playerid);

			SetPlayerMoney(playerid, -price_house);
			HouseInfo[idx][hBuyPrice] = HouseInfo[idx][hPrice]/2;
			HouseInfo[idx][hOplata] = 1;
			HouseInfo[idx][hOwned] = PI[playerid][pID];
			HouseInfo[idx][hLock] = 1;
			SendMes(playerid, -1, ""cDA"Вы купили дом за %dр. У вас осталось: %dр", price_house, PI[playerid][pCash]);
			SendClientMessage(playerid, -1, ""cPS"Аренда Вашего дома оплачена на 1 день. Рекомендуем оплатить дом в любом банке города");
			SendMes(playerid, -1, ""cPS"Стоимость кварплаты для вашего дома будет составлять %dр в день",GetHomeOplata(idx));
			SendClientMessage(playerid, COLOR_YELLOW, "Спасибо за то, что воспользовались услугами нашего агентства! Будем рады видеть Вас снова!");
			strmid(HouseInfo[idx][hOwner], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
			global_string = "";
			format(global_string, 200, "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hOplata = %d, buyprice = %d, hLock = %d WHERE id = '%d' LIMIT 1", HouseInfo[idx][hOwner], HouseInfo[idx][hOwned], HouseInfo[idx][hOplata], HouseInfo[idx][hBuyPrice], HouseInfo[idx][hLock], idx);
			mysql_tquery(db_prod, global_string, "", "");
			PI[playerid][pSpawnChange] = 1;
			UpdateHouse(idx);

			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=1, house=%d WHERE id=%d", idx, PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1);

			PI[playerid][pHouse] = idx;

			for(new j; j < 12; j++) TextDrawHideForPlayer(playerid, td_rieltor[j]);

			SetPlayerPos(playerid, olderX[playerid], olderY[playerid], olderZ[playerid]);
			SetPlayerVirtualWorld(playerid, olderInt[playerid]);
			SetPlayerInterior(playerid, olderWorld[playerid]);

			olderX[playerid] = olderY[playerid] = olderZ[playerid] = 0.0;
			olderInt[playerid] = olderWorld[playerid] = 0;
			is_player_in_rieltor_house[playerid] = 0;
			fLogs("[house] %s +%i покупка", GetName(playerid), idx);
			return 1;
		}
		if(HouseInfo[idx][hType] == 1)
		{
			if(playerEuro[playerid] < price_house) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег! Используйте /exithouse для отмены покупки");
			if(GetPlayerHouse(playerid)) return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом! Используйте /exithouse для отмены покупки"), ExitRieltorMenu(playerid);
			if(GetPlayerRooms(playerid)) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира! Используйте /exithouse для отмены покупки"), ExitRieltorMenu(playerid);

			TransferEuro(playerid, -1, price_house, "Покупка дома");
			HouseInfo[idx][hBuyPrice] = HouseInfo[idx][hPrice]/2;
			HouseInfo[idx][hOplata] = 1;
			HouseInfo[idx][hOwned] = PI[playerid][pID];
			HouseInfo[idx][hLock] = 1;
			SendMes(playerid, -1, ""cDA"Вы купили дом за %d евро. У вас осталось: %d евро", price_house, playerEuro[playerid]);
			SendClientMessage(playerid, -1, ""cPS"Аренда Вашего дома оплачена на 1 день. Рекомендуем оплатить дом в любом банке города");
			SendMes(playerid, -1, ""cPS"Стоимость кварплаты для вашего дома будет составлять %dр в день",GetHomeOplata(idx));
			SendClientMessage(playerid, COLOR_YELLOW, "Спасибо за то, что воспользовались услугами нашего агентства! Будем рады видеть Вас снова!");
			strmid(HouseInfo[idx][hOwner], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
			global_string = "";
			format(global_string, 200, "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hOplata = %d, buyprice = %d, hLock = %d WHERE id = '%d' LIMIT 1", HouseInfo[idx][hOwner], HouseInfo[idx][hOwned], HouseInfo[idx][hOplata], HouseInfo[idx][hBuyPrice], HouseInfo[idx][hLock], idx);
			mysql_tquery(db_prod, global_string, "", "");
			PI[playerid][pSpawnChange] = 1;
			UpdateHouse(idx);

			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=1, house=%d WHERE id=%d", idx, PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1);

			PI[playerid][pHouse] = idx;

			for(new j; j < 12; j++) TextDrawHideForPlayer(playerid, td_rieltor[j]);

			SetPlayerPos(playerid, olderX[playerid], olderY[playerid], olderZ[playerid]);
			SetPlayerVirtualWorld(playerid, olderInt[playerid]);
			SetPlayerInterior(playerid, olderWorld[playerid]);

			olderX[playerid] = olderY[playerid] = olderZ[playerid] = 0.0;
			olderInt[playerid] = olderWorld[playerid] = 0;
			is_player_in_rieltor_house[playerid] = 0;
			fLogs("[house] %s +%i покупка", GetName(playerid), idx);
			return 1;
		}
	}
	is_player_in_rieltor_house[playerid] = 0;
	return 1;
}
cmd:exithouse(playerid)
{
	if(!is_player_in_rieltor_house[playerid]) return 1;
	for(new idx; idx < 12; idx++) TextDrawHideForPlayer(playerid, td_rieltor[idx]);

	SetPlayerPos(playerid, olderX[playerid], olderY[playerid], olderZ[playerid]);
	SetPlayerVirtualWorld(playerid, olderWorld[playerid]);
	SetPlayerInterior(playerid, olderInt[playerid]);

	olderX[playerid] = olderY[playerid] = olderZ[playerid] = 0.0;
	olderInt[playerid] = olderWorld[playerid] = 0;
	is_player_in_rieltor_house[playerid] = 0;

	PI[playerid][pInHouse] = -1;
	return 1;
}

cmd:setvip(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "uii", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setvip [id игрока] [Тип (0-3)] [кол-во дней]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(params[2] < 0 || params[2] > 30) return SendClientMessage(playerid, COLOR_GREY, "Нельзя выдавать VIP статус более чем на 30 дней");

		new vip_name[4][20] = {
			"V.I.P Ruby",
			"V.I.P Emerlad",
			"V.I.P Sapphire",
			"V.I.P Diamond"};

		if(params[2] > 0)
		{
			PI[params[0]][pVip] = params[1];
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET `vip` = '%d', `vip_time` = '%d' WHERE `id` = '%d'", params[1], params[2], PI[params[0]][pID]);
			mysql_tquery(db_prod, stringer1, "", "");

			format(string, sizeof(string), "Вы выдали %s игроку %s на %d дней", vip_name[params[1]], GetName(params[0]), params[2]);
			SendClientMessage(playerid, COLOR_YELLOW, string);
			format(string, sizeof(string), "Администратор %s выдал вам %s на %d дней", GetName(playerid), vip_name[params[1]], params[2]);
			SendClientMessage(params[0], COLOR_YELLOW, string);
		}
		else if(params[2] == 0)
		{
			PI[params[0]][pVip] = -1;
			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET `vip` = '-1', `vip_time` = '0' WHERE `id` = '%d'", PI[params[0]][pID]);
			mysql_tquery(db_prod, stringer1, "", "");

			format(string, sizeof(string), "Вы забрали %s у игрока %s", vip_name[params[1]], GetName(params[0]));
			SendClientMessage(playerid, COLOR_YELLOW, string);
			format(string, sizeof(string), "Администратор %s забрал у вас %s", GetName(playerid), vip_name[params[1]]);
			SendClientMessage(params[0], COLOR_YELLOW, string);
		}
		fLogs("[admin] %s /setvip %s %s %i", GetName(playerid), GetName(params[0]), vip_name[params[1]], params[2]);
	}
	return 1;
}

cmd:clearinv(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		new to_player;
		if(sscanf(params, "u", to_player)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/clearinv [id игрока]");
		ResetItem(to_player);
		SCMF(playerid, 0xFFCC00AA,  "Вы успешно очистили инвентарь %s[%d]", GetName(to_player), to_player);
		SCMF(to_player, 0xFFCC00AA, "%s[%d] очистил Вам инвентарь", GetName(playerid), playerid);
		fLogs("[admin] %s /clearinv %s", GetName(playerid), GetName(to_player));
	}
	return 1;
}
CMD:cartp(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	new Float:pos_x, Float:pos_y, Float:pos_z;
	GetVehiclePos(strval(params), pos_x, pos_y, pos_z);
	SetPlayerPos(playerid, pos_x, pos_y, pos_z);
	fLogs("[admin] %s /cartp %i", GetName(playerid), strval(params));
	return 1;
}
CMD:addradar(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	new speed, price;
	if(sscanf(params, "ii", speed, price))
	{
		SendInf(playerid, "Используйте: /addradar [скорость] [цена]");
		return 1;
	}
	new Float:X, Float:Y, Float:Z;
	GetPlayerPos(playerid, X, Y, Z);
	TOTALRADAR++;
	playerRadarSelect[playerid] = TOTALRADAR;
	gRadarPrice[TOTALRADAR] = price;
	gRadarSpeed[TOTALRADAR] = speed;
	playerRadarObject[playerid] = 	CreateDynamicObject(18880, X+1, Y+1, Z+1, 0.0,0.0,0.0);
	SetTimerEx("OnPlayerRadarObj", 300, 0, "ii", playerid, playerRadarObject[playerid]);
	return 1;
}
callback::OnPlayerRadarObj(playerid, obj) EditDynamicObject(playerid, obj);

cmd:setadmin(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PlayerLogged[playerid] == false) return 1;
		new playername[24], admin_level, type;
		if(sscanf(params, "s[64]ii", playername, admin_level, type)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setadmin [ник игрока] [уровень админа] [тип (0-основной, 1-покупной)]");
		mysql_format(db_prod, stringer1, sizeof(stringer1), "SELECT * FROM `admin` WHERE `name` = '%s'", playername);
		mysql_tquery(db_prod, stringer1, "SetAdmin", "isii", playerid, playername, admin_level, type);
	}
	return 1;
}
cmd:setadmin12(playerid, params[])
{
    if(!g_player_full_access[playerid]) return 1;
    if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

    new playername[24];
    if(sscanf(params, "s[24]", playername))
        return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setadmin12 [ник игрока]");

    mysql_format(db_prod, stringer1, sizeof(stringer1), "SELECT * FROM admin WHERE name = '%s'", playername);
    mysql_tquery(db_prod, stringer1, "SetAdmin", "isii", playerid, playername, 12, 0);

    return 1;
}
cmd:wladd(playerid)
{
	if(!g_player_full_access[playerid]) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	ShowPlayerDialog(playerid, DIALOG_WL_ADD, DIALOG_STYLE_INPUT, ""cMain"Whitelist", ""cWH"Enter nickname in format Name_Surname:", "Add", "Cancel");
	return 1;
}

cmd:whitelist(playerid)
{
	if(!g_player_full_access[playerid]) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT id, name, added_by, DATE_FORMAT(created_at, '%%d.%%m.%%Y %%H:%%i') AS wl_date FROM whitelist ORDER BY id ASC LIMIT %d", WHITELIST_MAX_VIEW + 1);
	mysql_tquery(db_prod, STRING_GLOBAL, "WhitelistShowList", "i", playerid);
	return 1;
}

cmd:lstats(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(sscanf(params, "s[32]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/lstats [Ник лидера]");
		mysql_format(db_prod, stringer1, 128, "SELECT * FROM accounts a, accounts_online ao WHERE a.name = '%e' and leader != '0' AND ao.id=a.id", params[0]);
		mysql_tquery(db_prod, stringer1, "ShowLeaderStats", "is", playerid, params[0]);
		fLogs("[admin] %s /lstats %s", GetName(playerid), params[0]);
	}
	return 1;
}
CMD:mystat(playerid, params[])
{
	if(!PI[playerid][pLeader]) return SendErr(playerid, "Вы не лидер");
	mysql_format(db_prod, stringer1, 128, "SELECT * FROM accounts a, accounts_online ao WHERE a.name = '%e' and leader != '0' AND ao.id=a.id", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "ShowLeaderStats", "is", playerid, GetName(playerid));
	return 1;
}
callback::ShowLeaderStats(playerid, name[])
{
	if(!cache_num_rows()) return SendClientMessage(playerid, COLOR_RED, "Ник лидера указан неверно, либо игрок вовсе не лидер");

	new l_stats[32], l_time, l_inv, l_uninv, l_d, l_r, l_rank,
	l_online_monday,
	l_online_tuesday,
	l_online_wednesday,
	l_online_thursday,
	l_online_friday,
	l_online_saturday,
	l_online_sunday;

	cache_get_field_content(0, "leaderstats", l_stats, db_prod, 32);

	new leaderid = GetPlayerID(name);

	if(leaderid == INVALID_PLAYER_ID)
	{
		l_online_monday = cache_get_field_content_int(0, "online_monday");
		l_online_tuesday = cache_get_field_content_int(0, "online_tuesday");
		l_online_wednesday = cache_get_field_content_int(0, "online_wednesday");
		l_online_thursday = cache_get_field_content_int(0, "online_thursday");
		l_online_friday = cache_get_field_content_int(0, "online_friday");
		l_online_saturday = cache_get_field_content_int(0, "online_saturday");
		l_online_sunday = cache_get_field_content_int(0, "online_sunday");
	}
	else
	{
		l_online_monday = g_player_online[leaderid][2];
		l_online_tuesday = g_player_online[leaderid][3];
		l_online_wednesday = g_player_online[leaderid][4];
		l_online_thursday = g_player_online[leaderid][5];
		l_online_friday = g_player_online[leaderid][6];
		l_online_saturday = g_player_online[leaderid][0];
		l_online_sunday = g_player_online[leaderid][1];
	}

	sscanf(l_stats, "p<,>iiiiii", l_time, l_inv, l_uninv, l_d, l_r, l_rank);

	global_string = "";

	format(global_string, 1200,
	""cWH"Cтатистика лидера: %s\
	\n\n- Принял в организацию: \t%d"cWH"\n\
	- Уволил из организации: \t%d\n\
	- Повысил/понизил игроков:: \t%d\n\
	- Сообщений в /d чате: \t%d\n\
	- Сообщений в /r чате: \t%d\n\
	- Время на посту: \t%s\n\n\
	"cWH"Статистика онлайна лидера:\n\n\
	"cWH"- Понедельник: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Вторник: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Среда: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Четверг: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Пятница: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Суббота: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Воскресенье: \t{E0D730}%s\t"cWH"| Норма онлайна: %s",
	name,
	l_inv,
	l_uninv,
	l_rank,
	l_d,
	l_r,
	ConvertSeconds(l_time),
	ConvertSeconds(l_online_monday),
	(l_online_monday/3600>=4)?("{63BD4E}Выполнена"):(l_online_monday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(l_online_tuesday),
	(l_online_tuesday/3600>=4)?("{63BD4E}Выполнена"):(l_online_tuesday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(l_online_wednesday),
	(l_online_wednesday/3600>=4)?("{63BD4E}Выполнена"):(l_online_wednesday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(l_online_thursday),
	(l_online_thursday/3600>=4)?("{63BD4E}Выполнена"):(l_online_thursday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(l_online_friday),
	(l_online_friday/3600>=4)?("{63BD4E}Выполнена"):(l_online_friday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(l_online_saturday),
	(l_online_saturday/3600>=4)?("{63BD4E}Выполнена"):(l_online_saturday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(l_online_sunday),
	(l_online_sunday/3600>=4)?("{63BD4E}Выполнена"):(l_online_sunday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"));

	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Информация о лидере", global_string, "Закрыть","");

	return 1;
}
cmd:astats(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		new player_name[24];
		if(sscanf(params, "s[24]",player_name)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/astats [Ник]");
		mysql_format(db_prod, global_string, sizeof(global_string), "SELECT * FROM accounts WHERE `name` = '%e'", player_name);
		mysql_tquery(db_prod, global_string, "CheckAccountid", "is", playerid, player_name);
	}
	return 1;
}
callback::CheckAccountid(playerid, player_name[])
{
	if(!cache_num_rows()) return SCM(playerid, -1, "Админ не найден");
	mysql_format(db_prod, global_string, 200, "SELECT * FROM admin a, accounts_online ad WHERE a.name = '%s' AND ad.id = '%d'", player_name, cache_get_field_content_int(0, "id"));
	mysql_tquery(db_prod, global_string, "ShowAdminStats", "i", playerid);
	fLogs("[admin] %s /astats %s", GetName(playerid), player_name);
	return 1;
}

callback::ShowAdminStats(playerid)
{
	if(!cache_num_rows()) return 1;

	new
	a_name[MAX_PLAYER_NAME],
	a_warns,
	a_time,
	a_kick,
	a_ban,
	a_warn,
	a_ans,
	a_mute,
	a_jail,
	a_lvl,
	a_online_monday,
	a_online_tuesday,
	a_online_wednesday,
	a_online_thursday,
	a_online_friday,
	a_online_saturday,
	a_online_sunday,
	last_ans_text[32],
	last_warn_text[32],
	last_kick_text[32],
	last_ban_text[32],
	last_mute_text[32],
	last_jail_text[32],
	put_admin[MAX_PLAYER_NAME],
	data[32],
	type
	;

	cache_get_field_content(0, "name", a_name, db_prod, MAX_PLAYER_NAME);

	a_warns = cache_get_field_content_int(0, "awarn");
	a_time = cache_get_field_content_int(0, "act_time");
	type = a_time = cache_get_field_content_int(0, "buyadmin");

	cache_get_field_content(0, "put_admin", put_admin, db_prod, 32);
	cache_get_field_content(0, "data", data, db_prod, 32);

	a_lvl = cache_get_field_content_int(0, "level");

	new adminid = GetPlayerID(a_name);

	if(adminid == INVALID_PLAYER_ID)
	{
		a_kick = cache_get_field_content_int(0, "kicks");
		a_ban = cache_get_field_content_int(0, "bans");
		a_warn = cache_get_field_content_int(0, "warns");
		a_ans = cache_get_field_content_int(0, "ans");
		a_mute = cache_get_field_content_int(0, "mutes");
		a_jail = cache_get_field_content_int(0, "jails");

		a_online_monday = cache_get_field_content_int(0, "online_monday");
		a_online_tuesday = cache_get_field_content_int(0, "online_tuesday");
		a_online_wednesday = cache_get_field_content_int(0, "online_wednesday");
		a_online_thursday = cache_get_field_content_int(0, "online_thursday");
		a_online_friday = cache_get_field_content_int(0, "online_friday");
		a_online_saturday = cache_get_field_content_int(0, "online_saturday");
		a_online_sunday = cache_get_field_content_int(0, "online_sunday");

		cache_get_field_content(0, "last_ans_text", last_ans_text, db_prod, 32);
		cache_get_field_content(0, "last_warn_text", last_warn_text, db_prod, 32);
		cache_get_field_content(0, "last_kick_text", last_kick_text, db_prod, 32);
		cache_get_field_content(0, "last_ban_text", last_ban_text, db_prod, 32);
		cache_get_field_content(0, "last_mute_text", last_mute_text, db_prod, 32);
		cache_get_field_content(0, "last_jail_text", last_jail_text, db_prod, 32);
	}
	else
	{
		a_kick = PI[adminid][pAdmSt][ADMIN_KICK];
		a_ban =PI[adminid][pAdmSt][ADMIN_BAN];
		a_warn = PI[adminid][pAdmSt][ADMIN_WARN];
		a_ans =	PI[adminid][pAdmSt][ADMIN_PM];
		a_mute = PI[adminid][pAdmSt][ADMIN_MUTE];
		a_jail = PI[adminid][pAdmSt][ADMIN_PRISON];

		a_online_monday = g_player_online[adminid][2];
		a_online_tuesday = g_player_online[adminid][3];
		a_online_wednesday = g_player_online[adminid][4];
		a_online_thursday = g_player_online[adminid][5];
		a_online_friday = g_player_online[adminid][6];
		a_online_saturday = g_player_online[adminid][0];
		a_online_sunday = g_player_online[adminid][1];

		strcat(last_ans_text, AdminInfo[adminid][admAnsText]);
		strcat(last_warn_text, AdminInfo[adminid][admWarnText]);
		strcat(last_kick_text, AdminInfo[adminid][admKickText]);
		strcat(last_ban_text, AdminInfo[adminid][admBanText]);
		strcat(last_mute_text, AdminInfo[adminid][admMuteText]);
		strcat(last_jail_text, AdminInfo[adminid][admJailText]);
	}
	global_string = "";

	format(global_string, 4000, "\
	"cWH"Общая статистика администратора {F5AE20}%s (%d уровень) %s:\n\n\
	"cWH"- Назначил: \t{AEADAD}%s\t "cWH"| Дата: "cMain"%s\n\
	"cWH"- Кикнул: \t{AEADAD}%d\t "cWH"| Посл. причина: "cMain"%s\n\
	"cWH"- Забанил: \t{AEADAD}%d\t "cWH"| Посл. причина: "cMain"%s\n\
	"cWH"- Выдал варн: \t{AEADAD}%d\t "cWH"| Посл. причина: "cMain"%s\n\
	"cWH"- Ответов: \t{AEADAD}%d\t "cWH"| Посл. причина: "cMain"%s\n\
	"cWH"- Мутов: \t{AEADAD}%d\t "cWH"| Посл. причина: "cMain"%s\n\
	"cWH"- Посажено в тюрьму: \t{AEADAD}%d\t "cWH"| Посл. причина: "cMain"%s\n\n\
	"cWH"- Выговоров: \t{FB2424}%d\n\n\
	"cWH"Статистика онлайна администратора:\n\n\
	"cWH"- Понедельник: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Вторник: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Среда: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Четверг: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Пятница: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Суббота: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Воскресенье: \t{E0D730}%s\t"cWH"| Норма онлайна: %s\n\
	"cWH"- Актив за все время: \t{E0D730}%s",
	a_name,
	a_lvl,
	type ? " (покупной)" : "",

	put_admin,
	data,

	a_kick,
	last_kick_text,
	a_ban,
	last_ban_text,
	a_warn,
	last_warn_text,
	a_ans,
	last_ans_text,
	a_mute,
	last_mute_text,
	a_jail,
	last_jail_text,
	a_warns,
	ConvertSeconds(a_online_monday),
	(a_online_monday/3600>=4)?("{63BD4E}Выполнена"):(a_online_monday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(a_online_tuesday),
	(a_online_tuesday/3600>=4)?("{63BD4E}Выполнена"):(a_online_tuesday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(a_online_wednesday),
	(a_online_wednesday/3600>=4)?("{63BD4E}Выполнена"):(a_online_wednesday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(a_online_thursday),
	(a_online_thursday/3600>=4)?("{63BD4E}Выполнена"):(a_online_thursday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(a_online_friday),
	(a_online_friday/3600>=4)?("{63BD4E}Выполнена"):(a_online_friday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(a_online_saturday),
	(a_online_saturday/3600>=4)?("{63BD4E}Выполнена"):(a_online_saturday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(a_online_sunday),
	(a_online_sunday/3600>=4)?("{63BD4E}Выполнена"):(a_online_sunday/3600>=3)?(""cMain"Не выполнена"):("{F04245}Не выполнена"),
	ConvertSeconds(a_time));

	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "{F4D030}Статистика", global_string, "Закрыть", "");
	return 1;
}


cmd:mystats(playerid)
{
	if(!PI[playerid][pAdmin]) return 1;

	new Query[128];
	format(Query, sizeof(Query), "UPDATE `admin` SET timemin='%d' WHERE name='%s' LIMIT 1", AdminInfo[playerid][admTimeMin], GetName(playerid));
	mysql_tquery(db_prod, Query, "", "");
	AdminSaveStats(GetName(playerid));

	global_string = "";

	mysql_format(db_prod, global_string, 200, "SELECT * FROM admin a, accounts_online ao WHERE a.name='%s' AND ao.id=%d", GetName(playerid), PI[playerid][pID]);
	mysql_tquery(db_prod, global_string, "ShowAdminStats", "i", playerid);

	fLogs("[admin] %s /mystat", GetName(playerid));
	return 1;
}
cmd:resetlstats(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/resetlstats [ID]");
		if(!PI[params[0]][pLeader]) return SendClientMessage(playerid, COLOR_RED, "Игрок не лидер!");
		PI[params[0]][pLeaderStat][LEADER_TIME] 		=
		PI[params[0]][pLeaderStat][LEADER_INVITE] 		=
		PI[params[0]][pLeaderStat][LEADER_UNINVITE] 	=
		PI[params[0]][pLeaderStat][LEADER_R] 			=
		PI[params[0]][pLeaderStat][LEADER_D] 			=
		PI[params[0]][pLeaderStat][LEADER_RANK] 		= 0;
		SendMes(playerid, COLOR_GREEN, "Вы обнулили статистику лидера %s", GetName(params[0]));
		fLogs("[admin] %s /resetlstats %s", GetName(playerid), GetName(params[0]));
	}
	return 1;
}
cmd:resetastats(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/resetastats [ID]");
		if(!PI[params[0]][pAdmin]) return SendClientMessage(playerid, COLOR_RED, "Игрок не администратор!");
		PI[params[0]][pAdmSt][ADMIN_KICK] 		=
		PI[params[0]][pAdmSt][ADMIN_BAN] 		=
		PI[params[0]][pAdmSt][ADMIN_WARN] 		=
		PI[params[0]][pAdmSt][ADMIN_PM] 		=
		PI[params[0]][pAdmSt][ADMIN_MUTE] 		=
		PI[params[0]][pAdmSt][ADMIN_PRISON] 	=
		PI[params[0]][pAdmSt][6] 				=
		g_player_online[playerid][0]			=
		g_player_online[playerid][1]			=
		g_player_online[playerid][2]			=
		g_player_online[playerid][3]			=
		g_player_online[playerid][4]			=
		g_player_online[playerid][5]			=
		g_player_online[playerid][6]			= 0;
		SendMes(playerid, COLOR_GREEN, "Вы обнулили статистику администратора %s", GetName(params[0]));
		fLogs("[admin] %s /resetstats %s", GetName(playerid), GetName(params[0]));
	}
	return 1;
}
cmd:resetoffastats(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(sscanf(params, "s[24]",params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/resetoffastats [ник]");
		if(GetPlayerID(params[0]) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_RED, "Данный игрок online");

		global_string = "";
		mysql_format(db_prod, global_string, 100, "SELECT `name` FROM `accounts` WHERE `name` = '%s'", params[0]);
		mysql_tquery(db_prod, global_string, "ClearAStats", "is", playerid, params[0]);
	}
	return 1;
}

cmd:gg(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 0x1;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, 0xCCCCCCFF, "Используйте: /gg [id]");
	if(freeze_gg[playerid] > unix) return SendClientMessage(playerid, COLOR_RED, "Пользоваться командой /gg можно раз в 5 секунд");

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Администратор %s пожелал(а) Вам приятной игры на сервере Perfect Role Play", GetName(playerid));
	SendClientMessage(params[0], 0xffa500FF, STRING_GLOBAL);

	freeze_gg[playerid] = unix + 5;
	fLogs("[admin] %s /gg", GetName(playerid));
	return 0x1;
}

cmd:hitman(playerid)
{
	if(PI[playerid][pMember] != TEAM_HITMAN)
		return SendErr(playerid, "Доступно только хитманам");

	if(PlayerLogged[playerid] == false)
		return 1;

	if(PI[playerid][pRank] < 5)
		return SendClientMessage(playerid, COLOR_RED, "Доступно с 5 ранга");

	new str[90], str2[600];
	for(new i = 1; i < MAX_FRACTIONS; i++)
	{
		format(str, sizeof(str), "№%d - %s\n", i, Fraction_Name[i]);
		strcat(str2, str);
	}
	ShowPlayerDialog(playerid, 18248, 2, ""cMain"Выберите организацию:", str2, "Выбрать", "Отмена");
	return 1;
}
cmd:setleader(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PI[playerid][pAdmin] < 11) return 1;
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setleader [id игрока]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(IsPlayerInAnyVehicle(params[0])) return SendClientMessage(playerid, COLOR_GREY, "Игрок не должен находиться в транспорте!");
		if((PI[params[0]][pAdmin] >= 1 && PI[params[0]][pAdmin] <= 10) && PI[playerid][pAdmin] != 11) return SendClientMessage(playerid, COLOR_GREY, "Администратора нельзя ставить на пост лидера!");
		if(PI[params[0]][pTempLeader]) return SendClientMessage(playerid, COLOR_GREY, "Сначала снимите с себя права временного состояние в организации!");
		if(PI[params[0]][pLeader])
		{
			LeaveFractionPlayer(params[0]);
			SendMes(playerid, COLOR_BLUE, "Вы сняли %s с должности лидера организации",GetName(params[0]));
			SendMes(params[0], COLOR_BLUE, "Администратор %s снял вас с должности лидера организации", GetName(playerid));

			PI[params[0]][pLeaderStat][LEADER_TIME] 		=
			PI[params[0]][pLeaderStat][LEADER_INVITE] 		=
			PI[params[0]][pLeaderStat][LEADER_UNINVITE] 	=
			PI[params[0]][pLeaderStat][LEADER_R] 			=
			PI[params[0]][pLeaderStat][LEADER_D] 			=
			PI[params[0]][pLeaderStat][LEADER_RANK] 		= 0;
			LeaderSaveStats(params[0]);
			fLogs("[admin] %s /setleader %s 0", GetName(playerid), GetName(params[0]));
		}
		else
		{
			if(PI[params[0]][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок лидер другой организации!");
			if(PI[params[0]][pMember] > 0) return SendClientMessage(playerid, COLOR_GREY, "Игрок находится в другой организации!");
			new str[90], str2[600];
			for(new i = 1; i < MAX_FRACTIONS; i++)
			{
				format(str, sizeof(str), "№%d - %s\n", i, Fraction_Name[i]);
				strcat(str2, str);
			}
			actplayerid[playerid] = params[0];
			ShowPlayerDialog(playerid, 49, 2, ""cMain"Организации", str2, "Принять", "Отмена");
		}
	}
	return 1;
}

cmd:ainvite(playerid)
{
	if(PI[playerid][pAdmin] < 10) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "Покупным администраторам запрещено принимать в организацию");

	if(PI[playerid][pTempLeader])
	{
		if(PI[playerid][pTempLeader] == 0) return SendClientMessage(playerid, -1, ""cER"Вы не состоите в организации!");
		LeaveFractionPlayer(playerid);
		PI[playerid][pTempLeader] = 0;
		SendClientMessage(playerid, COLOR_BLUE, "Вы тихо вышли из организации.");
	}
	else
	{
		new str[90], str2[600];
		for(new i = 1; i < MAX_FRACTIONS; i++)
		{
			format(str, sizeof(str), "№%d - %s\n", i, Fraction_Name[i]);
			strcat(str2, str);
		}
		ShowPlayerDialog(playerid, 3400, 2, ""cMain"Организации", str2, "Принять", "Отмена");
	}
	return 1;
}

cmd:f(playerid, params[])
{
	if(IsAGang(playerid) || IsAMafia(playerid))
	{
		if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, -1, PlayerHaveMuteTime);
		if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/f [текст]");
		if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);
		new mesid[128];
		format(mesid, sizeof(mesid), "[F] %s %s[%d]: %s", GetFrackRangName(playerid), GetName(playerid), playerid, params[0]);
		SendFMes(PI[playerid][pMember], 0x4682B4AA, mesid);
	}
	else SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	return 1;
}

