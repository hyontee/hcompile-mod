DLG(700, playerid, response, listitem, inputtext[])
{
	if(!response) return true;
	if(!listitem)
	{
		ShowPlayerDialog(playerid,701,DIALOG_STYLE_INPUT,""cMain"Создание семьи",""cWH"Для создании семьи необходимо иметь 5.000.000 Игровой Валюты.\n\nНазвание семьи можно будет изменить в дальнейшем\nВведите название семьи:","Далее","Закрыть");
		return 1;
	}

	format(stringer1,sizeof(stringer1), "1. Создание семьи\n2. Всего семей: %d", family_count);
	ShowPlayerDialog(playerid, 700, DIALOG_STYLE_LIST, ""cMain"Информация о семьях", stringer1, "Выбор", "Выход");
	return 1;
}
DLG(701, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		format(stringer1,sizeof(stringer1), "1. Создание семьи\n2. Всего семей: %d", family_count);
		ShowPlayerDialog(playerid, 700, DIALOG_STYLE_LIST, ""cMain"Информация о семьях", stringer1, "Выбор", "Выход");
		return 1;
	}
	if(PI[playerid][pCash] < 5000000) return SendClientMessage(playerid, COLOR_GREY, "Для создания семьи Вам необходимо иметь 5.000.000 Игровой Валюты.");
	if(PI[playerid][pFamilySozd] != 0) return SendClientMessage(playerid,COLOR_GREY,"У Вас уже есть семья! Нельзя создавать больше чем одну семью.");
	if(PI[playerid][pFamily] != 0) return SendClientMessage(playerid,COLOR_GREY,"Вы состоите в семье! Необходимо покинуть семью, что бы создать свою.");

	new temp [32];
	if(sscanf(inputtext, "s[32]", temp) || !(2 <= strlen(temp) <= 20))
	{
		ShowPlayerDialog(playerid,701,DIALOG_STYLE_INPUT,""cMain"Создание семьи","{AFAFAF}Название семьи не может быть больше 12 символов!\n"cWH"Для создании семьи необходимо иметь 300 "SERVER_COINS"\nПеред созданием семьи рекомендуем ознакомиться с разделом 'Информация'\n\nНазвание семьи можено будет изменить в дальнейшем\nВведите название семьи:","Далее","Закрыть");
		return 1;
	}
	mysql_format(db_prod, global_string, 100, "SELECT `fam_name` FROM `family_system` WHERE fam_name = '%e'", inputtext);
	mysql_tquery(db_prod, global_string, "CheckFamilyName", "isi", playerid, temp, 1);
	return 1;
}
DLG(7726, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::family(playerid);
	new dialogPLid = DialogSlot[playerid][g_player_listitem_use[playerid]], YCMDstr[128];
	switch(listitem)
	{
	case 0:
		{
			mysql_format(db_prod,stringer1, 128,"SELECT `name` FROM `accounts` WHERE `family` = '%d' AND `familyzam` = '1'", PI[playerid][pFamily]);
			mysql_function_query(db_prod,stringer1, true,"Onmysql_query","ddd",playerid,100,dialogPLid);
		}
	case 1:
		{
			if(PI[playerid][pFamilySozd] == 0 && PI[playerid][pFamilyZam] == 0) return SendClientMessage(playerid, COLOR_GREY,"Выгонять из семьи может только заместитель и создатель.");
			if(PI[dialogPLid][pFamilySozd] != 0 && GetString(family_info [PI[playerid][pFamily]] [f_creator], GetName(dialogPLid)))
				 return SendClientMessage(playerid, COLOR_GREY,"Нельзя выгнать создателя из семьи");

			if(dialogPLid == playerid)
				return SendClientMessage(playerid, COLOR_GRAD1, "Вы не можете выгнать самого себя!");
			if(PI[playerid][pFamily] != PI[dialogPLid][pFamily]) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок не состоит в Вашей семье.");

			format(YCMDstr, sizeof(YCMDstr), "%s выгнал Вас из семьи.", GetName(playerid));
			SendClientMessage(dialogPLid, 0xFFD39BFF, YCMDstr);
			format(YCMDstr, sizeof(YCMDstr), "Вы выгнали игрока %s из семьи.",GetName(dialogPLid));
			SendClientMessage(playerid, 0xFFD39BFF, YCMDstr);
			format(string,sizeof(string),"{%s}[%s]{FFD39B} %s(%s) выгнал игрока %s из семьи",family_chat_color [family_info[PI[playerid][pFamily]] [f_chat_color ]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid),family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1], GetName(dialogPLid));
			family_message(PI[playerid][pFamily],-1, string);
			family_info [ PI[playerid][pFamily]] [ f_online ] -= 1;
			family_info [ PI[playerid][pFamily] ] [ f_members_amount ] -= 1;
			PI[dialogPLid][pFamily] =
			PI[dialogPLid][pFamilySozd] =
			PI[dialogPLid][pFamilyZam] = 0;

			if(playerFamilyNameTag[dialogPLid] != INVALID_3DTEXT_ID)
			{
				UpdateDynamic3DTextLabelText(playerFamilyNameTag[dialogPLid], -1, " ");

				DestroyDynamic3DTextLabel(playerFamilyNameTag[dialogPLid]);
				playerFamilyNameTag[dialogPLid] = INVALID_3DTEXT_ID;
			}

			format(string, sizeof string, "UPDATE `accounts` SET family = 0, familyzam = 0, familyrank = 0, familysozd = 0 WHERE name = '%s'", GetName(dialogPLid));
			mysql_function_query ( db_prod, string, false, "", "");

		}
	}
	return 1;
}
