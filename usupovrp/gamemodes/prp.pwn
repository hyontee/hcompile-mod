stock GetVehicleComponentName(componentid)
{
	new str_name[128];
	new index = componentid - 1000;
	if (!(0 <= index < sizeof(gComponentName))) str_name = "Ошибка";
	else strcat(str_name, gComponentName[index]);
	return str_name;
}

stock SendSucc(playerid,strings[])
{
	format(String256,sizeof(String256),"* {63BD4E}[Успешно] "cWH"%s",strings);
	SendClientMessage(playerid,0xFFFFFFFF, String256);
	return 1;
}


