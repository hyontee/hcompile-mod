SaveMileage()
{
	for(new v = 1; v <= TOTALVEH; v++)
	{
		if(VehInfo[v][vVehicle] != INVALID_VEHICLE_ID)
		{
			mysql_format(db_prod, global_string, 128, "UPDATE `vehicle` SET mileage = '%f' WHERE id = '%d'", vehicle_mileage[VehInfo[v][vVehicle]], v);
			mysql_tquery(db_prod, global_string, "", "");
		}
	}
	return 1;
}

callback::OnLoadRadar()
{
	new time = GetTickCount(), rows = cache_num_rows();
	if(rows)
	{
		new id;
		nfor(i, rows)
		{
			id = cache_get_field_content_int(i, "id");
			gRadarPos[id][0] = cache_get_field_content_float(i, "x");
			gRadarPos[id][1] = cache_get_field_content_float(i, "y");
			gRadarPos[id][2] = cache_get_field_content_float(i, "z");
			gRadarPos[id][3] = cache_get_field_content_float(i, "r");

			gRadarSpeed[id] = cache_get_field_content_int(i, "speed");
			gRadarPrice[id] = cache_get_field_content_int(i, "price");

			nformat(stringer, ""cWH"Радар: "cMain"%i\n"cWH"Максимальная скорость: "cMain"%i км/ч.\n"cWH"Штраф за нарушение: "cMain"%i руб.", id, gRadarSpeed[id], gRadarPrice[id]);
			gRadarText[id] = CreateDynamic3DTextLabel(stringer, -1, gRadarPos[id][0],gRadarPos[id][1],gRadarPos[id][2]+3.0, 10.0);
			gRadarObject[id] = 	CreateDynamicObject(18880,  gRadarPos[id][0],gRadarPos[id][1],gRadarPos[id][2] - 1.3, 0, 0, gRadarPos[id][3]);

			TOTALRADAR++;
		}
	}
	printf("[Загружено радаров]: <%d>. Потрачено: <%d ms>.", TOTALRADAR, GetTickCount() - time);
}
callback::LoadVeh()
{
	new time = GetTickCount(), rows = cache_num_rows();
	if(rows)
	{
		new tmp[MAX_FRACTIONS];
		for(new idx = 1; idx <= rows; idx++)
		{
			VehInfo[idx][vVehicle] = INVALID_VEHICLE_ID;
			VehInfo[idx][vID] = cache_get_field_content_int(idx-1, "id");
			VehInfo[idx][vModel] = cache_get_field_content_int(idx-1, "model");
			VehInfo[idx][vPos_X] = cache_get_field_content_float(idx-1, "x");
			VehInfo[idx][vPos_Y] = cache_get_field_content_float(idx-1, "y");
			VehInfo[idx][vPos_Z] = cache_get_field_content_float(idx-1, "z");
			VehInfo[idx][vPos_FA] = cache_get_field_content_float(idx-1, "fa");
			VehInfo[idx][vInt] = cache_get_field_content_int(idx-1, "vint");
			VehInfo[idx][vWorld] = cache_get_field_content_int(idx-1, "world");
			cache_get_field_content(idx-1, "colors", VehInfo[idx][vColors], db_prod, 16);
			VehInfo[idx][vFraction] = cache_get_field_content_int(idx-1, "fraction");
			VehInfo[idx][vCost] = cache_get_field_content_int(idx-1, "cost");
			VehInfo[idx][vMileage] = cache_get_field_content_float(idx-1, "mileage");
			VehInfo[idx][vDostup] = cache_get_field_content_int(idx-1, "dostup");
			sscanf(VehInfo[idx][vColors], "p<,>a<i>[2]", VehInfo[idx][vColor]);

			if(VehInfo[idx][vModel])
			{
				VehInfo[idx][vVehicle] = CreateVehicle(VehInfo[idx][vModel], VehInfo[idx][vPos_X], VehInfo[idx][vPos_Y], VehInfo[idx][vPos_Z], VehInfo[idx][vPos_FA], VehInfo[idx][vColor][0], VehInfo[idx][vColor][1], 900);
				if(VehInfo[idx][vFraction] != 6) CarDoorsEx(VehInfo[idx][vVehicle], 1);
				LinkVehicleToInterior(VehInfo[idx][vVehicle], VehInfo[idx][vInt]);
				SetVehicleVirtualWorld(VehInfo[idx][vVehicle], VehInfo[idx][vWorld]);

				/*new r, g, b;

				switch(VehInfo[idx][vFraction])
				{
					case 1:
					{
						r = 204;
						g = 255;
						b = 0;
					}

					case 2:
					{
						r = 0;
						g = 0;
						b = 255;
