UpdateCupboard(cupboardid)
{
	DestroyDynamic3DTextLabel(HouseInfo[cupboardid][hCupboardText]);
	new fmt_text[180];
	format(fmt_text, sizeof fmt_text, ""cWH"Деньги: {66CC00}%d руб.\n"cWH"Патроны: {A52A2A}%d шт.\n"cWH"Наркотики: "cMain"%d мешочков\n\n"cWH"Взаимодействие: {63B135}/use",
	HouseInfo[cupboardid][hMoney], HouseInfo[cupboardid][hPatrons],HouseInfo[cupboardid][hDrugs]);
	HouseInfo[cupboardid][hCupboardText] = CreateDynamic3DTextLabel(fmt_text, 0x0099FFFF,
	g_house_info[ HouseInfo[cupboardid][hDiscript] ][3], g_house_info[ HouseInfo[cupboardid][hDiscript] ][4], g_house_info[ HouseInfo[cupboardid][hDiscript] ][5],
	5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, HouseInfo[cupboardid][hVirtual], HouseInfo[cupboardid][hInt], -1, 5.0);
	return 1;
}
isNumeric(text[])
{
	new len = strlen(text);
	if(!len) return 0;
	mfor(i, (len - 1))
	{
		if(text[i] < '0' || text[i] > '9') return 0;
	}
	return 1;
}

callback::ObnulDonatePay(playerid)
{
	new rows = cache_get_row_count(db_prod);
	if(!rows) return 0x1;
	new donatepay = cache_get_field_content_int(0, "donatepay");

	new AllDonate = 0;
	SendMes(playerid,COLOR_GREEN,"На Ваш счёт зачислено %d "SERVER_COINS". Благодарим за помощь серверу!",donatepay);
	SendClientMessage(playerid,COLOR_GREEN,"Сумма увеличена в два раза благодаря акции X2 Donate");
	AllDonate = donatepay / 2;


	format(string, sizeof(string), "UPDATE `accounts` SET `credits` = '%d', `donatepay` = '0', `AllDonate` = `AllDonate`+'%d'  WHERE `name` = '%s'", PI[playerid][pPerfectCoins] + donatepay, AllDonate, PI[playerid][pName]);
	mysql_tquery(db_prod, string, "", "");

	PI[playerid][pPerfectCoins] += donatepay;
	fLogs("[coin] %s +%i автодонат", GetName(playerid), donatepay);
	mysql_tquery(db_prod, "SELECT `name`, `AllDonate` FROM `accounts` WHERE `AllDonate` > '0' ORDER BY `AllDonate` DESC LIMIT 5", "UpdateDonateLabel");
	return 0x1;
}

callback::ActiveDonate(playerid)
{
	new rows = cache_get_row_count(db_prod);
	if(!rows) return SendClientMessage(playerid,COLOR_RED,"Произошла системная ошибка при пополнении. Номер ошибки: 001");
	new donatepay = cache_get_field_content_int(0, "donatepay");
	if(donatepay == 0) return SendClientMessage(playerid, COLOR_GREY, "На Ваш счёт не поступало пополнений. Пополнить счёт можно на {FFFF00}"PAGE_WEBSITE_DONATE"");

	if(doubling_donate)
		donatepay *= 2;

	new DonatePay;
	new AllDonate = 0;
	if(happy_hours != 0)
	{
		SendMes(playerid,COLOR_GREEN,"На Ваш счёт зачислено %d "SERVER_COINS". Благодарим за помощь серверу!",donatepay);
		SendClientMessage(playerid,COLOR_GREEN,"Сумма увеличена в два раза благодаря акции X2 Donate");
		AllDonate = donatepay / 2;
	}
	if(happy_hours == 0)
	{
		new percent = 0;
		switch(donatepay)
		{
		case 0..499: percent = 0;
		case 500..999: percent = 30;
		case 1000..2499: percent = 40;
		default: percent = 50;
		}
		if(percent != 0)
		{
			DonatePay = (donatepay / 100) * percent;
			SendMes(playerid, COLOR_GREEN, "Бонус от пополнения составил %d "SERVER_COINS".", DonatePay);
		}
		SendMes(playerid,COLOR_GREEN,"На Ваш счёт зачислено %d "SERVER_COINS". Благодарим за помощь серверу!", donatepay + DonatePay);
		AllDonate = donatepay;
	}
	format(string, sizeof(string), "UPDATE `accounts` SET `credits` = '%d', `donatepay` = '0', `AllDonate` = `AllDonate`+'%d'  WHERE `name` = '%s'", PI[playerid][pPerfectCoins] + (donatepay + DonatePay), AllDonate, PI[playerid][pName]);
	mysql_tquery(db_prod, string, "", "");

	PI[playerid][pPerfectCoins] += (donatepay + DonatePay);
	fLogs("[coin] %s +%i автодонат", GetName(playerid), (donatepay + DonatePay));
	mysql_tquery(db_prod, "SELECT `name`, `AllDonate` FROM `accounts` WHERE `AllDonate` > '0' ORDER BY `AllDonate` DESC LIMIT 5", "UpdateDonateLabel");
	return 1;
}

AdminLevel(playerid)
{
	if(!PI[playerid][pAdmin]) return 1;
	if(PI[playerid][pAdmin] >= 10) return SendClientMessage(playerid, -1, "У Вас максимальный уровень админ-прав");

	if(PI[playerid][pAdmin] < 8)
	{
		if(PI[playerid][pPerfectCoins] < 150) return SendClientMessage(playerid, -1, "Для повышение админ-уровня Вам требуется 150 "SERVER_COINS" на балансе");
		mysql_format(db_prod, string, sizeof(string), "UPDATE `admin` SET `level` = '%d' WHERE `name` = '%s' LIMIT 1", PI[playerid][pAdmin]+1, GetName(playerid));
		mysql_tquery(db_prod, string);
		PI[playerid][pAdmin] = PI[playerid][pAdmin]+1;

		MysqlUpdatePlayerInt(playerid,"credits",PI[playerid][pPerfectCoins]-150);
		PI[playerid][pPerfectCoins] -= 150;
		fLogs("[coin] %s -150 админка", GetName(playerid));

		SendMes(playerid, COLOR_GREEN, "Вы успешно повысили свой админ-уровень до %d.", PI[playerid][pAdmin]);
		SendClientMessage(playerid, -1, "Авторизуйтесь по новой, что бы Ваш уровень обновился.");
		fLogs("[admin] %s повысил уровень донат", GetName(playerid));
		return 1;
	}
	else if(PI[playerid][pAdmin] >= 8)
	{
		if(PI[playerid][pPerfectCoins] < 1000) return SendClientMessage(playerid, -1, "Для повышение админ-уровня Вам требуется 1000 "SERVER_COINS" на балансе");
		mysql_format(db_prod, string, sizeof(string), "UPDATE `admin` SET `level` = '%d' WHERE `name` = '%s' LIMIT 1", PI[playerid][pAdmin]+1, GetName(playerid));
		mysql_tquery(db_prod, string);
		PI[playerid][pAdmin] = PI[playerid][pAdmin]+1;

		MysqlUpdatePlayerInt(playerid,"credits",PI[playerid][pPerfectCoins]-1000);
		PI[playerid][pPerfectCoins] -= 1000;
		fLogs("[coin] %s -1000 админка", GetName(playerid));

		SendMes(playerid, COLOR_GREEN, "Вы успешно повысили свой админ-уровень до %d.", PI[playerid][pAdmin]);
		SendClientMessage(playerid, -1, "Авторизуйтесь по новой, что бы Ваш уровень обновился.");
		fLogs("[admin] %s повысил уровень донат", GetName(playerid));
		return 1;
	}
	return 1;
}
AddAdmin(targetid, cena, lvl,vkid[])
{
	if(PI[targetid][pAdmin]) return 1;
	if(lvl == 10) cena = 2400;
	if(PI[targetid][pPerfectCoins] < cena) { SendMes(targetid, -1, "Для приобретения админ-прав данного уровня Вам нужно %d "SERVER_COINS"",cena); return 1; }

	format(stringer1, sizeof(stringer1), "SELECT * FROM `admin` WHERE `name` = '%s'", GetName(targetid));
	mysql_tquery(db_prod, stringer1, "CheckBuyAdmin", "iisi", targetid, cena, vkid, lvl);
	return 1;
}

callback::CheckBuyAdmin(targetid, cena, vkid, lvl)
{
	if(cache_num_rows())
	{
		SendErr(targetid, "У вас уже есть админ-права. Введите: /alogin");
		return 1;
	}
	if(lvl == 10) cena = 2400;
	if(PI[targetid][pPerfectCoins] < cena) { SendMes(targetid, -1, "Для приобретения админ-прав данного уровня Вам нужно %d "SERVER_COINS"",cena); return 1; }

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `admin` (`name`, `level`, `last_connect`, `put_admin`, `data`, `buyadmin`) VALUES ('%e', %d, CURDATE(), '%e', CURDATE(), '1')", GetName(targetid), lvl, vkid);
	mysql_tquery(db_prod, STRING_GLOBAL);

	MysqlUpdatePlayerInt(targetid,"credits",PI[targetid][pPerfectCoins]-cena);
	PI[targetid][pPerfectCoins] -= cena;
	fLogs("[coin] %s -%i админка", GetName(targetid), cena);

	PI[targetid][pBuyAdmin] = 1;
	SendMes(targetid, -1, "Вы успешно приобрели админ-права %d-го уровня.",lvl);
	SendClientMessage(targetid, -1, "Введите команду /alogin и придумайте себе пароль. (Обязательно его запишите)");
	SendClientMessage(targetid, -1, "Прочитайте правила администратора на форуме kaif-crmp.com > Форум");
	SendClientMessage(targetid, -1, "Несоблюдение правил = снятие");
	SendClientMessage(targetid, -1, "Незнание правил не освобождает вас от ответственности");

	fLogs("[admin] %s купил", GetName(targetid));
	return 1;
}
TeleportFreeze(playerid, ms)
{
	if(ms <= 0) return 0;
	TogglePlayerControllable(playerid, false);
	SetTimerEx("TeleportUnfreeze", ms, false, "d", playerid);
	return 1;
}

callback::TeleportUnfreeze(playerid)
{
	TogglePlayerControllable(playerid, true);
	ClearAnimations(playerid);
	return 1;
}

callback::LoadLstats(playerid)
{
	if(cache_num_rows())
	{
		new l_stats[32];
		cache_get_field_content(0, "leaderstats", l_stats, db_prod, 32);
		sscanf(l_stats, "p<,>iiiiii", PI[playerid][pLeaderStat][LEADER_TIME], PI[playerid][pLeaderStat][LEADER_INVITE], PI[playerid][pLeaderStat][LEADER_UNINVITE], PI[playerid][pLeaderStat][LEADER_D], PI[playerid][pLeaderStat][LEADER_R], PI[playerid][pLeaderStat][LEADER_RANK]);
	}
	return true;
}

callback::LoadOnline(playerid, nday)
{
	if(cache_num_rows())
	{
		g_player_online[playerid][0] = cache_get_field_content_int(0, "online_saturday");
		g_player_online[playerid][1] = cache_get_field_content_int(0, "online_sunday");
		g_player_online[playerid][2] = cache_get_field_content_int(0, "online_monday");
		g_player_online[playerid][3] = cache_get_field_content_int(0, "online_tuesday");
		g_player_online[playerid][4] = cache_get_field_content_int(0, "online_wednesday");
		g_player_online[playerid][5] = cache_get_field_content_int(0, "online_thursday");
		g_player_online[playerid][6] = cache_get_field_content_int(0, "online_friday");
		if(nday != day)
		{
			g_player_online[playerid][day_weeks] = 0;

			format(stringer1, 80, "UPDATE accounts SET day=%d WHERE id=%d", day, PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1);

			format(global_string, 300, "UPDATE accounts_online SET online_monday=%d,online_tuesday=%d,online_wednesday=%d,online_thursday=%d,online_friday=%d,online_saturday=%d,online_sunday=%d WHERE id=%d", g_player_online[playerid][2],g_player_online[playerid][3],g_player_online[playerid][4],g_player_online[playerid][5],g_player_online[playerid][6],g_player_online[playerid][0],g_player_online[playerid][1],PI[playerid][pID]);
			mysql_tquery(db_prod, global_string);
		}
	}
	else
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `accounts_online` (`id`) VALUES ('%d')", PI[playerid][pID]);
		mysql_tquery(db_prod, STRING_GLOBAL);

		for(new i; i < 7; i ++) g_player_online[playerid][i] = 0;
	}
	return 1;
}
LeaderSaveStats(playerid)
{
	if(PlayerLogged[playerid] == false) return 1;
	mysql_format(db_prod, global_string, 200, "UPDATE `accounts` SET  `leaderstats` = '%d,%d,%d,%d,%d,%d' WHERE `name` = '%s'", PI[playerid][pLeaderStat][LEADER_TIME], PI[playerid][pLeaderStat][LEADER_INVITE], PI[playerid][pLeaderStat][LEADER_UNINVITE], PI[playerid][pLeaderStat][LEADER_D], PI[playerid][pLeaderStat][LEADER_R], PI[playerid][pLeaderStat][LEADER_RANK], GetName(playerid));
	mysql_tquery(db_prod, global_string,"","");
	return true;
}
AdminSaveStats(name[])
{
	new playerid = GetPlayerID(name);
	if(playerid != INVALID_PLAYER_ID)
	{
		if(AdminLogged[playerid] == false) return 1;
	}
	new hours, minutes, seconds;
	gettime(hours, minutes, seconds);
	if((hours > 00 && minutes > 01) && (hours < 08 && minutes < 01)) return 0x1;

	mysql_format(db_prod, global_string, 300, "UPDATE `admin` SET act_time = %d, ans=%d, warns=%d, kicks=%d, bans=%d, mutes=%d, jails=%d WHERE `name` = '%s'",
	PI[playerid][pAdmSt][6],
	PI[playerid][pAdmSt][ADMIN_PM],
	PI[playerid][pAdmSt][ADMIN_WARN],
	PI[playerid][pAdmSt][ADMIN_KICK],
	PI[playerid][pAdmSt][ADMIN_BAN],
	PI[playerid][pAdmSt][ADMIN_MUTE],
	PI[playerid][pAdmSt][ADMIN_PRISON],
	GetName(playerid));
	mysql_tquery(db_prod, global_string,"","");
	return true;
}

callback::OpenFirework(playerid)
{
	if(TimerFirework[playerid] > 0)
	{
		new randZ, randX, randY;
		TimerFirework[playerid] -= 1;
		if(TimerFirework[playerid] <= 0)
		{
			P_Fire_Prog[playerid] -= 1;
			if(P_Fire_Prog[playerid] == 14)
			{
				P_Fire_Prog[playerid] = -1, TimerFirework[playerid] = -1, TimerFirework2[playerid] = -1, KillTimer(P_FireTimer[playerid]);
				P_FireWork[playerid] = 0;
				for(new i; i < 15; i++) DestroyDynamicObject(Firework[playerid][i]);
				return true;
			}
			for(new ids; ids < 15; ids++)
			{
				randZ = random(20)+30;
				randX = random(20)+5;
				randY = random(20)+5;
				MoveDynamicObject(Firework[playerid][ids], Fire_Pos[playerid][0]+randX, Fire_Pos[playerid][1]+randY, Fire_Pos[playerid][2]+randZ, 50.0);
			}
			TimerFirework2[playerid] = 4;
		}
	}
	if(TimerFirework2[playerid] > 0)
	{
		TimerFirework2[playerid] -= 1;

		if(TimerFirework2[playerid] <= 0)
		{
			new Float:fPOS[3], randmodel;
			for(new id; id < 15; id++)
			{
				GetDynamicObjectPos(Firework[playerid][id], fPOS[0], fPOS[1], fPOS[2]);
				CreateExplosion(fPOS[0], fPOS[1], fPOS[2], 11, 0.5);
				DestroyDynamicObject(Firework[playerid][id]);
			}
			for(new i; i < 15; i++)
			{
				randmodel = 19122+random(5);
				Firework[playerid][i] = 	CreateDynamicObject(randmodel, Fire_Pos[playerid][0]+1, Fire_Pos[playerid][1], Fire_Pos[playerid][2]-0.5, 0.0, 0.0, 0.0);
			}
			TimerFirework[playerid] = 5;
		}
	}
	return true;
}
SelectTextDrawEx(playerid,color)
{
	gSelectColor[playerid] = color;

	SelectTextDraw(playerid,color);
	return 1;
}
CancelSelectTextDrawEx(playerid)
{
	gSelectColor[playerid] = EOS;
	CancelSelectTextDraw(playerid);
	return 1;
}
PB_START(type)
{
	new id;
	for(new i; i < MAX_PBPLAYER; i++)
	{
		if(type == 0)
		{
			id = PBP_PLAYERIDS[i];
			if(id == INVALID_PLAYER_ID) continue;
			new r = RandomEx(0,10);
			SetPlayerPos(id,PBP_SPAWN[r][0],PBP_SPAWN[r][1],PBP_SPAWN[r][2]);
			SetPlayerFacingAngle(id,PBP_SPAWN[r][3]);
			SetPlayerVirtualWorld(id,1575);
			GivePlayerWeapon(id, 24, 500);
			GivePlayerWeapon(id, 31, 5000);
			SetPlayerHealth(id, 100);
			SetPlayerInterior(id, 30);

			for(new td; td < 12; td++) TextDrawShowForPlayer(id, paint_td_global[td]);
			PlayerTextDrawShow(id, paint_td_player[id]);
			g_player_in_event[id] = true;
		}
		if(type == 1)
		{
			id = PBP_PLAYERIDS[i];
			if(id == INVALID_PLAYER_ID) continue;
			new r = RandomEx(0,10);
			SetPlayerPos(id,PBP_SPAWN[r][0],PBP_SPAWN[r][1],PBP_SPAWN[r][2]);
			SetPlayerFacingAngle(id,PBP_SPAWN[r][3]);
			SetPlayerVirtualWorld(id,1575);
			GivePlayerWeapon(id, 24, 500);
			GivePlayerWeapon(id, 31, 5000);
			SetPlayerHealth(id, 100);
			SetPlayerInterior(id, 30);
			PB_DEATH[id] =
			PB_KILL[id] = 0;
			playerMyasoRubk{id} = 1;

			for(new td; td < 12; td++) TextDrawShowForPlayer(id, paint_td_global[td]);
			PlayerTextDrawShow(id, paint_td_player[id]);
			g_player_in_event[id] = true;
			PBP_LID = id;
		}
	}
	return true;
}
GetWinnerPB()
{
	for(new i; i < MAX_PBPLAYER; i++)
	{
		if(PBP_PLAYERIDS[i] == INVALID_PLAYER_ID) continue;
		g_player_in_event[i] = false;
		if(PB_GETPOS(PBP_PLAYERIDS[i]) == 1)
		{
			PBP_LID = PBP_PLAYERIDS[i];
			return PBP_LID;
		}
	}
	return INVALID_PLAYER_ID;
}
PB_STOP()
{
	for(new i; i < MAX_PBPLAYER; i++)
	{
		if(PBP_PLAYERIDS[i] == INVALID_PLAYER_ID) continue;
		SetPlayerPos(PBP_PLAYERIDS[i],100.3156,818.2423,12.0010),ResetPlayerWeapons(PBP_PLAYERIDS[i]);
		SetPlayerHealth(PBP_PLAYERIDS[i], 100);

		playerMyasoRubk{PBP_PLAYERIDS[i]} =
		PB_DEATH[ PBP_PLAYERIDS[i] ] =
		PB_KILL[ PBP_PLAYERIDS[i] ] = 0;

		for(new td; td < 12; td++) TextDrawHideForPlayer(PBP_PLAYERIDS[i], paint_td_global[td]);
		PlayerTextDrawHide(PBP_PLAYERIDS[i], paint_td_player[PBP_PLAYERIDS[i]]);
		SetPlayerVirtualWorld(PBP_PLAYERIDS[i],0);
		g_player_in_event[PBP_PLAYERIDS[i]] = false;
	}
	if(PBP_LID == INVALID_PLAYER_ID) settext(PBP_WINNAME,"None");
	else settext(PBP_WINNAME,GetName(PBP_LID));

	if(PBP_LID != INVALID_PLAYER_ID)
	{
		mysql_format(db_prod, string, sizeof(string), "UPDATE `accounts` SET credits=%d WHERE id=%d", PI[PBP_LID][pPerfectCoins]+15, PI[PBP_LID][pID]);
		mysql_tquery(db_prod, string, "", "");

		SetPlayerMoney(PBP_LID, PBP_BANK);
		PI[PBP_LID][pPerfectCoins] += 15;
		fLogs("[coin] %s +15 пейнтбол", GetName(PBP_LID));
		SendClientMessage(PBP_LID, -1, "Вы выиграли игру и получили 15 кредитов + весь банк игры");
	}
	PB_CLEAR();
}
cmd:pbtest(playerid)
{
	if(PlayerLogged[playerid] == false) return 1;

	PI[playerid][pPerfectCoins] += 10000;

	return 1;
}
PB_CLEAR()
{
	for(new i; i < MAX_PBPLAYER; i++) PBP_PLAYERIDS[i] = INVALID_PLAYER_ID;
	PBP_LID = INVALID_PLAYER_ID;
	PBP_BANK =
	PBP_STATUS =
	PBP_TIMER =
	PBP_PLAYERS = 0;
}
PB_GETSLOTPLAYER(playerid)
{
	for(new i; i < MAX_PBPLAYER; i++) if(PBP_PLAYERIDS[i] == playerid)
	{
		return i;
	}
	return -1;
}
PB_GETSLOT()
{
	for(new i; i < MAX_PBPLAYER; i++) if(PBP_PLAYERIDS[i] == INVALID_PLAYER_ID)
	{
		return i;
	}
	return -1;
}
PB_COUNTPLAYERS()
{
	new count;
	for(new i; i < MAX_PBPLAYER; i++)
	{
		if(PBP_PLAYERIDS[i] != INVALID_PLAYER_ID) count ++;
	}
	return count;
}
PB_GETPOS(playerid)
{
	new mypos;
	for(new i; i < PBP_PLAYERS; i++) if(PBP_PLAYERIDS[i] != INVALID_PLAYER_ID)
	{
		if(PB_KILL[PBP_PLAYERIDS[i]] >= PB_KILL[playerid]) mypos ++;
	}
	return mypos;
}

callback::CheckPlayerHelicopter(playerid)
{
	new r, f;

	cache_get_data(r, f);

	if(r)
	{
		return SendClientMessage(playerid, COLOR_RED, "У Вас уже имеется вертолет, покупка второго невозможна..");
	}

	BuyHelicopter(playerid);
	return 1;
}
BuyHelicopter(playerid)
{
	if(GetPlayerData(playerid, SalonCarID) == INVALID_VEHICLE_ID) return 1;

	new cost[MAX_PLAYERS],model[MAX_PLAYERS];
	cost[playerid] = carsH[pPressed[playerid]][1], model[playerid] = carsH[pPressed[playerid]][0];
	if(PI[playerid][pCash] < cost[playerid]) return SendClientMessage(playerid, COLOR_GREY, "На вашем счету не хватает денег!");
	InShop[playerid] = 0;
	TogglePlayerControllable(playerid,true);

	SetPlayerMoney(playerid, -cost[playerid]);
	for(new i; i < 7; i++) TextDrawHideForPlayer(playerid, ashop_TD[i]);
	for(new i; i < 2; i++) PlayerTextDrawHide(playerid, ashop_PTD[playerid][i]);
	CancelSelectTextDrawEx(playerid);
	SetPlayerPos(playerid, 1447.3878, 1674.7571, 15.4673);
	SetPlayerFacingAngle(playerid,0.0);
	SetPlayerInterior(playerid,0);
	SetPlayerVirtualWorld(playerid,0);
	SetCameraBehindPlayer(playerid);

	global_string = "";
	mysql_format(db_prod, global_string, 500, "\
	INSERT INTO `helicopters` (h_model, h_owner, h_color,  h_lock, h_price) VALUES \
	('%d', '%s', '%d', '1', '%d')",
	model[playerid], GetName(playerid), HelicopterColor[playerid], cost[playerid]);
	mysql_tquery(db_prod, global_string, "", "");

	SendClientMessage(playerid, COLOR_GREEN, "Поздравляем с приобретением вертолета!");
	SendClientMessage(playerid, COLOR_GREEN, "Для получения информации по управлению вертолетом, воспользуйтесь: {F47506}/cmd -> Вертолет");
	SendClientMessage(playerid, COLOR_GREEN, "Чтобы загрузить вертолет, введите /fixcopter . Если у вас есть особняк - вы сможете загрузить вертолет около него.");

	DestroyVehicle(GetPlayerData(playerid, SalonCarID));
	SetPlayerData(playerid, SalonCarID, INVALID_VEHICLE_ID);

	pPressed[playerid] = 0;
	return true;
}

