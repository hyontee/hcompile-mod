DLG(1375, playerid, response, listitem, inputtext[])
{
	new i = GetPlayerInBiz(playerid), newslot;
	if(i == -1) return 1;
	if(!response) return GunShopList(playerid);
	new ammo = strval(inputtext);
	new price = GetReasonMoneyPercentVip(playerid, TYPE_VIP_WEAPON, gGunCosts[9]) * ammo;
	if(ammo < 1 || ammo > 100)
	{
		SendClientMessage(playerid, -1, ""cER"Укажите значение патронов от 1 до 100");
		ShowPlayerDialog(playerid, 1375, 1, ""cMain"Покупка оружия", ""cWH"Укажите количество патронов\nЦена одного патрона - 100р", "Купить", "Назад");
		return 1;
	}
	if(GetPlayerRubble(playerid) < price)
	{
		SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
		ShowPlayerDialog(playerid, 1375, 1, ""cMain"Покупка оружия", ""cWH"Укажите количество патронов\nЦена одного патрона - 100р", "Купить", "Назад");
		return 1;
	}
	if(CheckMaxVes(playerid,42,ammo,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");

	SetPlayerMoney(playerid, -price);
	if(BizzInfo[i][bProduct] > 0)
	{
		BizzInfo[i][bMoney] += price;
		BizzPay[i] += price;
		BizzInfo[i][bProduct] -= price / 3;
		MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
		MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
	}
	PlayerItem1[playerid][newslot]=42;
	PlayerItem2[playerid][newslot]+=ammo;
	global_string = "";
	format(global_string, 128, ""cDA"Вы купили патроны(%d) за %dр", ammo, price);
	SendClientMessage(playerid, COLOR_BLUE, global_string);
	GunShopList(playerid);
	SaveItem(playerid,newslot);
	return 1;
}
DLG(119, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new i = GetPlayerInBiz(playerid);
	new price = gShopCosts[listitem], newslot;
	if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
	if(listitem > 1)
	{
		switch(listitem)
		{
		case 2:
			{
				if(CheckMaxVes(playerid,14,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=14;
				PlayerItem2[playerid][newslot]+=1;
				SendClientMessage(playerid, -1, ""cDA"Вы купили цветы");
			}
		case 3:
			{
				if(CheckMaxVes(playerid,41,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=41;
				PlayerItem2[playerid][newslot]+=1;
				SendClientMessage(playerid, -1, ""cDA"Вы купили наручные часы");
			}
		case 4:
			{
				if(CheckMaxVes(playerid,45,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=45;
				PlayerItem2[playerid][newslot]+=1;
				SendClientMessage(playerid, -1, ""cDA"Вы купили маску");
			}
		case 5:
			{
				if(CheckMaxVes(playerid,46,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=46;
				PlayerItem2[playerid][newslot]+=1;
				SendClientMessage(playerid, -1, ""cDA"Вы купили 1 сигарету");
			}
		case 6:
			{
				if(CheckMaxVes(playerid,70,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=70;
				PlayerItem2[playerid][newslot]+=1;
				SendClientMessage(playerid, -1, ""cDA"Вы купили Спранк");
			}
		case 7:
			{
				if(PI[playerid][pAptechka] >= 3) return SendClientMessage(playerid, -1, ""cER"В рюкзак вмещается до 3 аптечек!");
				PI[playerid][pAptechka]++;

				format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET aptechka=aptechka+1 WHERE id=%d", PI[playerid][pID]);
				mysql_tquery(db_prod, stringer1, "", "");

				SendMes(playerid, -1, ""cDA"Вы купили 1 аптечку, теперь у вас %d аптечек(-ки)",PI[playerid][pAptechka]);
			}
		case 8:
			{
				if(CheckMaxVes(playerid,40,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=40;
				PlayerItem2[playerid][newslot]+=1;
				SendClientMessage(playerid, -1, ""cDA"Вы купили MP3-плеер");
			}
		case 9:
			{
				if(GetPlayerRubble(playerid) < 500)
				return SendClientMessage(playerid, -1, ""cER"У Вас недостаточно средств для покупки отмычек");

				if(!IsAMafia(playerid) && !IsAGang(playerid))
				return SendClientMessage(playerid, -1, ""cER"Доступно только нелегальным организациям");

				SendClientMessage(playerid, -1, ""cDA"Вы приобрели отмычки. Для взлома автомобиля, используйте /cbreak");

				PI[playerid][pLockPicks] = 1;
				SetPlayerMoney(playerid, -500);

				UpdatePlayerData(playerid, "LockPick", PI[playerid][pLockPicks]);
			}
		case 10:
			{
				if(GetPlayerRubble(playerid) < 1000)
				return SendClientMessage(playerid, -1, ""cER"У Вас недостаточно средств для покупки скрепок");

				if(PI[playerid][pClips])
				return SendClientMessage(playerid, -1, ""cER"У Вас уже есть скрепки");

				SendClientMessage(playerid, -1, ""cDA"Вы приобрели скрепки. Для взлома наручников, используйте /clips");

				PI[playerid][pClips] = 1;

				UpdatePlayerData(playerid, "clips", PI[playerid][pClips]);
			}
		case 11:
			{
				if(CheckMaxVes(playerid,105,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=105;
				PlayerItem2[playerid][newslot]+=1;
				SendClientMessage(playerid, -1, ""cDA"Вы купили магнитофон, достать его можно с помощью инвентаря (/inv)");
			}
		case 12:
			{
				if(CheckMaxVes(playerid,47,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				if(SearchInventoryItem(playerid, 47) > 0){return SendClientMessage(playerid, -1, ""cER"У вас уже есть телефон!");}
				PlayerItem1[playerid][newslot]=47;
				PlayerItem2[playerid][newslot]+=1;

				SendClientMessage(playerid, -1, ""cDA"Вы купили телефон");
			}
		case 13:
			{
				if(SearchInventoryItem(playerid, 47)==0){return SendClientMessage(playerid, -1, ""cER"У вас нет телефона!");}
				if(PI[playerid][pPhoneNumber] > 1) return SendClientMessage(playerid, COLOR_RED, "У Вас уже имеется сим-карта");
				ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_INPUT, ""cMain"Покупка SIM-карты", ""cWH"Введите новый шестизначный номер", "Купить", "Закрыть");
				return 1;
			}
		case 14:
			{
				if(PI[playerid][pPhone][1] > 0) return SendClientMessage(playerid, -1, ""cER"У вас уже подключён интернет!");
				PI[playerid][pPhone][1] = 1;
				format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET phone='%d, 1' WHERE id=%d", PI[playerid][pPhone][0], PI[playerid][pID]);
				mysql_tquery(db_prod, stringer1, "", "");

				SendClientMessage(playerid, -1, ""cDA"Вы подключили интернет на телефон. Использовать соц. сеть 'ВКонтакте': /soc или /vk");
			}
		}
		SetPlayerMoney(playerid, - price);
		SaveItem(playerid,newslot);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzInfo[i][bMoney] += price;
			BizzPay[i] += price;
			BizzInfo[i][bProduct] -= gShopProd[listitem];
			MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
			MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
		}
		MagazineList(playerid);
	}
	else
	{
		switch(listitem)
		{
		case 0:
			{
				if(CheckMaxVes(playerid,38,30,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=38;
				PlayerItem2[playerid][newslot]+=1;
				SendClientMessage(playerid, -1, ""cDA"Вы купили фотоаппарат");
			}
		case 1:
			{
				if(GetPlayerHouse(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"Вы не владеете домом!");
				new p = GetPlayerHouse(playerid);
				HouseInfo[p][hHeal] += 10;
				MysqlUpdateHouseInt(p, "hHeal", HouseInfo[p][hHeal]);
				SendClientMessage(playerid, -1, ""cDA"Вы купили 10 аптечек для вашего дома");
			}
		}
	}
	return 1;
}
DLG(120, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new i = GetPlayerInBiz(playerid), till = BizzInfo[i][bTill], interiorid = GetPlayerInterior(playerid), newslot;
	new price = gEateryCosts[listitem];
	if(GetPlayerRubble(playerid) < till * price) return SendClientMessage(playerid, -1, ""cER"Недостаточно средств!");
	switch(listitem)
	{
	case 0:
		{
			if(interiorid == 5)
			{
				MeAction(playerid, "купил(а) маленькую пиццу");
				if(CheckMaxVes(playerid,50,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
				PlayerItem1[playerid][newslot]=50;
				PlayerItem2[playerid][newslot]+=1;
			}
			else if(interiorid == 10)
			{
