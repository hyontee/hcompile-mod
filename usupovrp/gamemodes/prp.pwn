							}
							if(HouseInfo[idx][hType] == 1)
							{
								global_string = "";
								format(global_string, 200,""cWH"\tДом №%d\n\nСтоимость:\t%d евро\nКласс:\t%s\nОплата составляет:\t%d руб за сутки",idx, price_house, classs, GetHomeOplata(idx));
								ShowPlayerDialog(playerid, 24, 0,""cMain"Дом", global_string, "Купить","Отмена");
							}
						}

						return 1;

