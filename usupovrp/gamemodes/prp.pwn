DLG(2335, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = g_player_listitem_use[playerid];
		if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "Произошла внутренняя ошибка #1. Обратитесь к администрации");
		if(PI[playerid][pMainBankAccount] == accountid) return SendClientMessage(playerid, COLOR_RED, "Этот счет уже является основным");

		PI[playerid][pMainBankAccount] = accountid;
		MysqlUpdatePlayerInt(playerid, "mainbankaccount", PI[playerid][pMainBankAccount]);

		global_string = "";
		format(global_string, 144, "Вы успешно изменили основной счет на \"%s\" (№%d)", GetPlayerBankAccountData(playerid, accountid, B_NAME), GetPlayerBankAccountData(playerid, accountid, B_ID));
		SendClientMessage(playerid, 0xFFCC00AA, global_string);
	}
	return 1;
}
DLG(7701, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
		{
		case 0: ShowPlayerFriendsList(playerid);
		case 1:
			{
				global_string = "";
				mysql_format(db_prod, global_string, 100, "SELECT COUNT(*) FROM friends WHERE login='%s'", GetName(playerid));
				mysql_tquery(db_prod, global_string, "GetPlayerCountFriends", "d", playerid);
			}
		}
	}
	return 1;
}
DLG(7777, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(listitem == 0) return ShowPlayerFriendsList(playerid);

		friend_id[playerid] = g_player_listitem[playerid][listitem];

		ShowPlayerDialog
		(
		playerid, 3621, DIALOG_STYLE_LIST,
		""cMain"Действитя с другом",
		""cMain"1. "cWH"Позвонить\n"\
		""cMain"2. "cWH"Отправить смс\n"\
		""cMain"3. "cWH"Удалить из друзей",
		"Далее", "Назад"
		);
	}
	return 1;
}
DLG(3621, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new index = friend_id[playerid];

		global_string = "";
		mysql_format(db_prod, global_string, 200, "SELECT f.*, IFNULL(a.datavhod, '0.0.0.0') datavhod, IFNULL(a.phonenumber, '0') phonenumber, name FROM friends f LEFT JOIN accounts a ON a.name=f.friend WHERE f.id=%d", index);
		mysql_tquery(db_prod, global_string, "FriendAction", "dd", playerid, listitem);
	}
	else ShowPlayerFriendsList(playerid);
	return 1;
}
DLG(5236, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(strlen(inputtext) == 0)
		return SendClientMessage(playerid, COLOR_RED, "Вы не ввели смс");

		if(strlen(inputtext) > 64)
		{
			return SendClientMessage(playerid, COLOR_RED, "Максимальное количество символов - 64!");
		}

		new to_player = INVALID_PLAYER_ID;

		to_player = friend_to_player[playerid];

		if(to_player == INVALID_PLAYER_ID)
		return SendClientMessage(playerid, COLOR_RED, "Этот игрок не в сети");

		if(PlayerLogged[to_player] == false) return SendClientMessage(playerid, COLOR_RED, "Этот игрок не в сети");

		if(Phone[to_player] == false)
		return SendClientMessage(playerid, -1, ""cPS"Игрок выключил телефон!");

		if(PI[to_player][pJail] > 0)
		return SendClientMessage(playerid, -1, ""cPS"Абонент временно недоступен!");

		global_string = "";
		format(global_string, 144, "SMS: "cWH"%s {FFFF00}Отправитель: "cWH"%s {FFFF00}Тел.: "cWH"%d", inputtext, GetName(playerid), PI[playerid][pPhoneNumber]);
		SendClientMessage(to_player, COLOR_YELLOW, global_string);

		global_string = "";
		format(global_string, 144, "SMS: "cWH"%s {FFFF00}Получатель: "cWH"%s {FFFF00}Тел.: "cWH"%d", inputtext, GetName(to_player), PI[to_player][pPhoneNumber]);
		SendClientMessage(playerid, COLOR_YELLOW, global_string);

		PI[playerid][pPhoneBalance] -= 10;
		SendClientMessage(playerid, COLOR_WHITE, "Ваше сообщение доставлено");
		MeAction(playerid, "достаёт мобильный телефон");
	}
	return 1;
}
DLG(9437, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(strlen(inputtext) == 0)
		return SendClientMessage(playerid, COLOR_RED, "Вы не ид игрока");

		new to_player;

		if(sscanf(inputtext, "d", to_player))
		{
			return ShowPlayerDialog
			(
			playerid, 9437, DIALOG_STYLE_INPUT,
			""cMain"Новый друг",
			""cWH"Введи ид игрока, которого хотите добавить в друзья:",
			"Добавить", "Отмена"
			);
		}

		if(!IsPlayerConnected(to_player) || !PlayerLogged[to_player] || playerid == to_player)
		return SendClientMessage(playerid, COLOR_RED, "Такого игрока нет");

		global_string = "";
		mysql_format(db_prod, global_string, 200, "SELECT * FROM friends WHERE login='%s' AND friend='%s' OR friend='%s' AND login='%s'", GetName(playerid), GetName(to_player), GetName(to_player), GetName(playerid));
		mysql_tquery(db_prod, global_string, "CheckFriend", "dd", playerid, to_player);
	}
	return 1;
}
DLG(1627, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new id = friend_id[playerid];

		global_string = "";
		mysql_format(db_prod, global_string, 200, "SELECT * FROM friends WHERE id=%d", id);
		mysql_tquery(db_prod, global_string, "DeleteFriend", "dd", playerid, id);
	}
	return 1;
}
DLG(7335, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(!IsALegal(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
		if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, "Канал гос. новостей не доступен для Вас");

		player_gov_index[playerid] = listitem;
		stringer1 = ""cMain"1. "cWH"Занять гос. волну\n"cMain"2. "cWH"Информация о новости";
		if(g_gov_info[listitem][GOV_FRACTION] != 0) strcat(stringer1, "\n"cMain"3. "cWH"Удалить новость");
		ShowPlayerDialog(playerid, 4521, DIALOG_STYLE_LIST,""cMain"Редактор гос. новостей",stringer1,"Далее", "Отмена");
	}
	return 1;
}
DLG(4521, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
		{
		case 0:
			{
				new index = player_gov_index[playerid];

				if(g_gov_info[index][GOV_FRACTION] != 0)
				return SendClientMessage(playerid, COLOR_RED, "Это время уже занято");

				new last_idx = -1, bool: cancel;

				if(minute > index*5)
				return SendClientMessage(playerid, COLOR_RED, "Это время уже прошло");

				for(new i; i < 12; i ++)
				{
					if(last_idx == -1)
					{
						last_idx = i;
						continue;
					}

					if(g_gov_info[last_idx][GOV_FRACTION] == PI[playerid][pMember] && index == i)
					{
						cancel = true;
						break;
					}

					last_idx = i;

				}

				if(cancel)
				return SendClientMessage(playerid, COLOR_RED, "Вы не можете воспользоваться гос. новостями более чем один раз в 10 минут");

				player_send[playerid] = 0;

				g_gov_info[index][GOV_FRACTION] = PI[playerid][pMember];

				format(g_gov_info[index][GOV_SENDER], MAX_PLAYER_NAME, "%s", GetName(playerid));

				ShowPlayerDialog
				(
				playerid, 8863, DIALOG_STYLE_INPUT,
				""cMain"Редакция гос. новостей",
				""cWH"Введите текст, который будет написан в "cMain"первом "cWH"сообщении:",
				"Далее", "Отмена"
				);
			}
		case 1:
			{
				new index = player_gov_index[playerid];

				if(g_gov_info[index][GOV_FRACTION] == 0)
				return SendClientMessage(playerid, COLOR_RED, "Это время не занято");

				new text[4][144];

				for(new idx; idx < 4; idx ++)
				{
					text[idx][0] = EOS;

					if(g_gov_send_text[index][idx][0] != EOS)
					format(text[idx], 144, "%s", g_gov_send_text[index][idx]);
					else
					format(text[idx], 144, "Отсутствует");
				}

				global_string = "";

				format
				(
				global_string, 1024,
				""cWH"Информация о гос. новостях на "cMain"%d:%s%d:\n\n"\
				""cWH"Организация: "cMain"%s\n"\
				""cWH"Отправитель: "cMain"%s\n\n"\
				""cWH"Сообщения 1:\n"\
				""cMain"%s\n"\
				""cWH"Сообщения 2:\n"\
				""cMain"%s\n"\
				""cWH"Сообщения 3:\n"\
				""cMain"%s\n"\
				""cWH"Сообщения 4:\n"\
				""cMain"%s\n",
				hour, index < 2 ? ("0") : "", index * 5,
				Fraction_Name[g_gov_info[index][GOV_FRACTION]],
				g_gov_info[index][GOV_SENDER],
				text[0],
				text[1],
				text[2],
				text[3]
				);

				ShowPlayerDialog
				(
				playerid, 0, DIALOG_STYLE_MSGBOX,
				""cMain"Информация о новости",
				global_string,
				"Закрыть", ""
				);
			}
		case 2:
			{
				new index = player_gov_index[playerid];

				if(g_gov_info[index][GOV_FRACTION] == 0)
				return SendClientMessage(playerid, COLOR_RED, "Это время не занято");

				if(g_gov_info[index][GOV_FRACTION] != PI[playerid][pMember])
				return SendClientMessage(playerid, COLOR_RED, "Вы не можете удалить новость");

				if(!IsALegal(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
				if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете удалить новость");

				global_string = "";

				format
				(
				global_string, 110,
				""cWH"Вы действительно хотите удалить гос. новость на "cMain"%d:%s%d?",
				hour, index < 2 ? ("0") : "", index * 5
				);

				ShowPlayerDialog
				(
				playerid, 2983, DIALOG_STYLE_MSGBOX,
				""cMain"Удаление новости",
				global_string,
				"Да", "Нет"
				);
			}
		}
	}
	return 1;
}
DLG(DIALOG_GOV_EDIT, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(g_gov_info[listitem][GOV_FRACTION] != 0)
		return callcmd::editgov(playerid, "");

		new count;

		for(new i; i < 12; i ++)
		{
			if(g_gov_info[listitem][GOV_FRACTION] != PI[playerid][pMember])
			continue;

			count ++;
		}

		if(count > 2)
		return SendClientMessage(playerid, COLOR_RED, "Вы не можете воспользоваться гос. новостями более чем два раза в час");

		player_send[playerid] = 0;

		g_gov_info[listitem][GOV_FRACTION] = PI[playerid][pMember];

		ShowPlayerDialog
		(
		playerid, 8863, DIALOG_STYLE_INPUT,
		""cMain"Редакция гос. новостей",
		""cWH"Введите текст, который будет написан в "cMain"первом "cWH"сообщении:",
		"Далее", "Отмена"
		);
	}
	return 1;
}
DLG(8863, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new index = player_gov_index[playerid],
		send = player_send[playerid];

		if(IsIpFound(inputtext) || CheckString(inputtext))
		{
			PlayerGetsChatBan(playerid, inputtext);

			ClearGovData(index);

			for(new i; i < 4; i ++) g_gov_send_text[index][i][0] = EOS;

			return 1;
		}

		g_gov_send_text[index][send][0] = EOS;
		strcat(g_gov_send_text[index][send], inputtext);

		new send_number[4][10] =
		{
			"первом",
			"втором",
			"третьем",
			"четвертом"
		};

		if(send == 3)
		{
			return SendClientMessage(playerid, 0xFFCC00AA, "Ваши гос. новости созданы, ожидайте своего времени.");
		}

		global_string = "";
		format(global_string, 100, ""cWH"Введите текст, который будет написан в "cMain"%s "cWH"сообщении:", send_number[send + 1]);

		player_send[playerid] += 1;

		ShowPlayerDialog
		(
		playerid, 8863, DIALOG_STYLE_INPUT,
		""cMain"Редакция гос. новостей",
		global_string,
		"Далее", "Отмена"
		);
	}

	if(!response)
	{
		new index = player_gov_index[playerid];

		ClearGovData(index);

		for(new i; i < 4; i ++) g_gov_send_text[index][i][0] = EOS;
	}
	return 1;
}
DLG(2983, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new index = player_gov_index[playerid];
		if(g_gov_info[index][GOV_FRACTION] == 0) return SendClientMessage(playerid, COLOR_RED, "Это время не занято");
		if(g_gov_info[index][GOV_FRACTION] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_RED, "Вы не можете удалить новость");
		if(!IsALegal(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
		if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете удалить новость");

		format
		(
		global_string, 144,
		""cWH"Вы успешно удалили новость на "cMain"%d:%s%d",
		hour, index < 2 ? ("0") : "", index * 5
		);
		SendClientMessage(playerid, 0xFFCC00AA, global_string);
		ClearGovData(index);
		for(new i; i < 4; i ++) g_gov_send_text[index][i][0] = EOS;
	}
	return 1;
}
