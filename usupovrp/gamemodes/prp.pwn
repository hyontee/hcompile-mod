stock SetPlayerMoney(playerid, MONEY, push = 0)
{
	if(playerid == 0xFFFF) return 0x1;
	if((PI[playerid][pCash] + MONEY) < -100000000)
	{
		PI[playerid][pCash] = 2000000000;
		SendClientMessage(playerid, -1, ""cER"Вы достигли лимита средств, скиньте Ваши деньги на банковский счет!");
		return 1;
	}
	if((PI[playerid][pCash] + MONEY) > 2000000000) SendClientMessage(playerid, -1, ""cER"У вас достигнут лимит наличных средств, вам установлено максимальное кол-во денежных средств");

	new string_money[64];
	PI[playerid][pCash] += MONEY;
	if(PI[playerid][pCash] > 2000000000) PI[playerid][pCash] = 2000000000;
	UpdatePlayerData(playerid, "cash", PI[playerid][pCash]);

	if(push == 0)
	{
		if(MONEY > 0)
		{
			format(string_money, sizeof(string_money), "+%i_P", MONEY);
			ShowNotify(playerid, string_money);
		}
		else
		{
			format(string_money, sizeof(string_money), "%i_P", MONEY);
			ShowNotify(playerid, string_money);
		}
	}
	ResetPlayerMoney(playerid); GivePlayerMoney(playerid, PI[playerid][pCash]);
	return 0x1;
}
