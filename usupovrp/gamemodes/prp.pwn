cmd:setpubg(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	new integer;
	if(sscanf(params, "d", integer) || !(0 <= integer <= 2)) return SendClientMessage(playerid, COLOR_GREY, "Ввведите: /setpubg [id]");
	g_pubg_status = integer;
	switch(integer)
	{
	case 1:
		{
			g_pubg_timer = 600;
			SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открылась регистрация на мероприятие 'Battle Royale'");
			SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Максимальное количество людей для регистрации 100 чел");
			SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 10 минут");
			SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 7");
		}
	case 0:
		{
			SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация на мероприятие 'Battle Royale' закрылась из-за нехватки участников");
			foreach(new ids: Player) if(playerGamePubg{ids}) playerGamePubg{ids} = 0;
			g_pubg_status =
			g_pubg_count = 0;
		}
	case 2:
		{
			g_pubg_status = 2;
			PubgStart();
		}
	}
	fLogs("[admin] %s /setpubg %i", GetName(playerid), integer);
	return 1;
}

