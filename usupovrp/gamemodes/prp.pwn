{
	global_string[0] = EOS;

	format(global_string, 256, "\n\
	"cWH"Введите кол-во патрон, которое хотите взять с багажника.\n\
	"cLGREY"Примечание: в багажнике %i патрон", patron);

	ShowPlayerDialog(playerid,2419, DIALOG_STYLE_INPUT, !""cMain"Багажник автомобиля", global_string, !"Взять", !"Закрыть");
	return true;
}

