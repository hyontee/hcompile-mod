		CreatePickup(19133, 23, g_area[idx][g_pos_area_x], g_area[idx][g_pos_area_y], g_area[idx][g_pos_area_z], g_area[idx][g_get_area_virtualworld]);

		if(g_area[idx][g_text] != EOS)
		{
			stringer1 = "";
			strcat(stringer1, g_area[idx][g_text]);
			CreateDynamic3DTextLabel(stringer1, COLOR_BLUE, g_area[idx][g_pos_area_x], g_area[idx][g_pos_area_y], g_area[idx][g_pos_area_z]+1.0, 10.0);
		}
	}
	CreateDynamic3DTextLabel("Штрафстоянка\n\nВведите: /arrestcar\n Чтобы поместить авто на Ш/С\n/unarrestcar\nДля сотрудников ГИБДД\n\n/freecar\nЧтобы самостоятельно забрать личное авто", COLOR_BLUE, 2542.1277,-2408.6106,22.0044+1.0, 15.0);

	for(new i; i < MAX_REPORTS; i++)
	{
		gReportInfo[i][rIsTooked] = false;
		gReportInfo[i][rID] = i;
		gReportInfo[i][rAnswer] = -1;
		gReportInfo[i][rPlayerID] = -1;
		gReportInfo[i][rText][0] = EOS;
		gReportInfo[i][rWhenWroted_Time] = -1;
		gReportInfo[i][rWhenWroted_Text][0] = EOS;
	}
	TimerData[TimerID] = SetTimer("OnServerUnixTimer", 500, true);

	for(new i; i < MAX_PBPLAYER; i++)
	{
		PBP_PLAYERIDS[i] = INVALID_PLAYER_ID;
	}
	printf ("-> Динамических объектов: %d", CountDynamicObjects());
	printf ("-> Статических объектов: %d", TotalObject);

	g_autosalon_cars[0] = CreateVehicle(401, 1484.8120, 1777.5020, 2523.3550, 45.00000, -1, -1, 100);
	CreateVehicle(404, 1485.6460, 1792.0620, 2523.3350, 135.0000, -1, -1, 100);
	CreateVehicle(411, 1470.1200, 1792.2400, 2523.3550, 225.0000, -1, -1, 100);
	g_autosalon_cars[1] = CreateVehicle(439, 1469.8000, 1778.3480, 2523.3550, 315.0000, -1, -1, 100);

	g_autosalon_cars[2] = CreateVehicle(400, 1660.6500, 1300.3000, 3026.7000, 270.0000, -1, -1, 100);
	CreateVehicle(502, 1660.6500, 1310.9000, 3026.7000, 270.0000, -1, -1, 100);
	CreateVehicle(451, 1676.2500, 1300.3000, 3026.7000, 90.00000, -1, -1, 100);
	CreateVehicle(466, 1676.2500, 1305.6000, 3026.7000, 90.00000, -1, -1, 100);
	g_autosalon_cars[3] = CreateVehicle(502, 1676.2500, 1310.9000, 3026.7000, 90.00000, -1, -1, 100);

	for(new i = g_autosalon_cars[0]; i != g_autosalon_cars[1]+1; i ++)
	{
		SetVehicleVirtualWorld(i, 1);
		LinkVehicleToInterior(i, 1);
	}
	for(new i = g_autosalon_cars[2]; i != g_autosalon_cars[3]+1; i ++)
	{
		SetVehicleVirtualWorld(i, 2);
		LinkVehicleToInterior(i, 2);
	}

	gamemodeloaded = 1;

	return 1;
}

callback::OnVoiceToggle()
{
	PVC_StartPushInfo();

	foreach(new i: Player)
	{
		if(!PlayerLogged[i] || IsPlayerNPC(i)) continue;

		new Float: x, Float: y, Float: z;

		new world;

		world = GetPlayerVirtualWorld(i);

		GetPlayerPos(i, x, y, z);
		PVC_PushInfo(i, x, y, z, world, 0);
	}

	PVC_EndPushInfo();

	return 1;
}

forward OnServerUnixTimer();
public OnServerUnixTimer()
{
	unix_time = gettime();
	OnServerUpdatePlayerTimer();
	if(TimerData[Timer_1] <= unix_time)
	{
		ServerUpdateTimer_1();
		OnServerUpdatePlayerTimer1();
		TimerData[Timer_1] = unix_time + 1;
	}
	if(TimerData[Timer_5] <= unix_time)
	{
		OnServerUpdateData();
		TimerData[Timer_5] = unix_time + 5;
	}
	if(TimerData[Timer_10] <= unix_time)
	{
		OnServerUpdatePlayerTimer10();
		TimerData[Timer_10] = unix_time + 10;
	}
	if(TimerData[Timer_30] <= unix_time)
	{
		ServerUpdateTimer_30();
		TimerData[Timer_30] = unix_time + 30;
	}
	if(TimerData[Timer_60] <= unix_time)
	{
		ServerUpdateTimer_60();
		TimerData[Timer_60] = unix_time + 60;
	}
	if(TimerData[TimerRandom] <= unix_time)
	{
		TimerData[TimerRandom] = unix_time + (random(1800) + 1800);
		ServerUpdateTimer_Random();
	}
	return 0x1;
}
CheckTimeSystems()
{

	if(hour == 18 && minute == 0 && !cont_spawn)
	{
		CreateContainers();
		cont_spawn = 1;
	}
	if((!(0 <= hour <= 23) && minute == 15) && PBP_STATUS == 0)
	{
		format(stringer1, sizeof stringer1, "[Новости]: Максимальное количество людей для регистрации %d чел", MAX_PBPLAYER);
		SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открылась регистрация на мероприятие 'Мясорубка'");
		SendClientMessageToAll(COLOR_ORANGE, stringer1);
		SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Стоимость регистрации 30.000 руб. Время на регистрацию 15 минут.");
		PBP_STATUS = 1,PBP_TIMER = 900;
	}
	if(hour == 18 && minute == 0 && day_weeks == 1 && !result_ivent)
	{
		SendGlobalInf("Итоги сезонных ивентов: ");

		mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d ORDER BY scoreivent DESC LIMIT 3", TEAM_HITMAN);
		mysql_tquery(db_prod, global_string, "EventResult", "i", 0);

		mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d OR member = %d OR member = %d OR member = %d OR member = %d ORDER BY scoreivent DESC LIMIT 3", TEAM_OBLASTADMIN, TEAM_MVD, TEAM_FSB, TEAM_HOSPITAL, TEAM_SMI);
		mysql_tquery(db_prod, global_string, "EventResult", "i", 1);

		mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d OR member = %d OR member = %d OR member = %d ORDER BY scoreivent DESC LIMIT 3", TEAM_CSKA, TEAM_SPARTAK, TEAM_RUSMAFIA, TEAM_ITALMAFIA);
		mysql_tquery(db_prod, global_string, "EventResult", "i", 2);

		mysql_format(db_prod, global_string, 144, "SELECT * FROM accounts WHERE member = %d ORDER BY scoreivent DESC LIMIT 3", TEAM_ARMY);
		mysql_tquery(db_prod, global_string, "EventResult", "i", 3);

		result_ivent =1;
	}
	if(minute == 0 || (minute % 5) == 0)
	{
		for(new idx; idx < 12; idx ++)
		{
			if(g_gov_info[idx][GOV_FRACTION] == 0) continue;
			if(minute != idx * 5) continue;
			for(new i; i < 4; i ++)
			{
				if(g_gov_send_text[idx][i][0] == EOS) continue;

				format(stringer1, 144, "[Гос. новости] %s: %s", Fraction_Name[ g_gov_info[idx][GOV_FRACTION] ], g_gov_send_text[idx][i]);
				SendClientMessageToAll(0x4466CCFF, stringer1);
				g_gov_send_text[idx][i][0] = EOS;
			}
			new sender_id = GetPlayerID(g_gov_info[idx][GOV_SENDER]), senter_text_id[10];
			if(sender_id == INVALID_PLAYER_ID) senter_text_id[0] = EOS, format(senter_text_id, 10, "Оффлайн");
			else senter_text_id[0] = EOS, senter_text_id[0] = sender_id;

			format(stringer1, 144, "[A] Отправитель гос. новости - %s[%d]", g_gov_info[idx][GOV_SENDER], senter_text_id);
			SendAdminMessage(COLOR_GREY, stringer1);
			ClearGovData(idx);
		}
	}
}
callback::ServerUpdateTimer_1()
{
	unix = gettime(hour, minute, second);
	getdate(year, month, day);

	OnServerUpdateDrawData();

	if(happy_hours)
	{
		happy_h_time ++;
		if(hour == happy_hours_hour && minute == happy_hours_minute)
		{
			happy_hours 		=
			happy_hours_hour	=
			happy_h_time		=
			happy_hours_time	=
			happy_hours_minute  =

			doubling_exp =
			doubling_donate =
			doubling_job 		= 0;

			DonateText[0] = CreateDynamic3DTextLabel("\
			{FFFF00}Заберите свой подарок\n\
			{FFFFFF}При пополнение от "cMain"500{FFFFFF} рублей получите в подарок "cMain"30%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополнение от "cMain"1.000{FFFFFF} рублей получите в подарок "cMain"40%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополненние от "cMain"2.500{FFFFFF} рублей получите в подарок "cMain"50%{FFFFFF} от суммы пополнения\n\n\
			{FFFFFF}Не работает при включенной акции "cMain"Счастливые часы", 0xAFAFAFFF, 461.9609,1679.4919,12.1884, 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

			DonateText[1] = CreateDynamic3DTextLabel("\
			{FFFF00}Заберите свой подарок\n\
			{FFFFFF}При пополнение от "cMain"500{FFFFFF} рублей получите в подарок "cMain"30%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополнение от "cMain"1.000{FFFFFF} рублей получите в подарок "cMain"40%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополненние от "cMain"2.500{FFFFFF} рублей получите в подарок "cMain"50%{FFFFFF} от суммы пополнения\n\n\
			{FFFFFF}Не работает при включенной акции "cMain"Счастливые часы", 0xAFAFAFFF, 2510.1682,-2143.8259,21.9766, 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

			DonateText[2] = CreateDynamic3DTextLabel("\
			{FFFF00}Заберите свой подарок\n\
			{FFFFFF}При пополнение от "cMain"500{FFFFFF} рублей получите в подарок "cMain"30%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополнение от "cMain"1.000{FFFFFF} рублей получите в подарок "cMain"40%{FFFFFF} от суммы пополнения\n\
			{FFFFFF}При пополненние от "cMain"2.500{FFFFFF} рублей получите в подарок "cMain"50%{FFFFFF} от суммы пополнения\n\n\
			{FFFFFF}Не работает при включенной акции "cMain"Счастливые часы", 0xAFAFAFFF, 1807.0496,2513.7751,15.6717, 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

			mysql_tquery(db_prod, "UPDATE `accounts` SET credits=credits+donatepay, donatepay = 0 WHERE `online` = '1001' AND `donatepay` > '0'", "");

			foreach(new targetid : Player)
			{
				if(PlayerLogged[targetid] == false) continue;

				STRING_GLOBAL[0] = EOS;
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `donatepay` FROM `accounts` WHERE `name` = '%s' AND `donatepay` > '0'", PI[targetid][pName]);
				mysql_tquery(db_prod, STRING_GLOBAL, "ObnulDonatePay", "i", targetid);
			}

			SendClientMessageToAll(0xff9f21FF, "'Счастливые часы' завершены. Акции X2 Donate, X2 EXP, X2 ЗП отключены");
		}
		else if(happy_h_time == happy_hours_time*60)
		{
			SendClientMessageToAll(0xff9f21FF, "* Счастливые часы * А мы напоминаем, что на сервере активированы 'Счастливые часы'");
			SendClientMessageToAll(0xff9f21FF, "* Счастливые часы * Во время действия счастливых часов, действуют акции X2 Donate, X2 EXP, X2 ЗП");
			happy_h_time = 0;
		}
	}

	if(ServerSpawnCars > 0) if(--ServerSpawnCars <= 0)
	{
		ServerSpawnCars = -1;
		for(new cars = 0; cars < MAX_VEHICLES; cars++)
		{
			if(GetVehicleModel(cars) > 399)
			{
				if(IsVehicleOccupiedAC(cars)) continue;
				SetVehicleToRespawn(cars);
			}
		}
	}
	for(new idx; idx < MAX_CONTAINERS; idx ++)
	{
		if(containersInfo[idx][coOpen]) continue;
		if(containersInfo[idx][coObject] == INVALID_OBJECT_ID) continue;
		if(containersInfo[idx][coLabel] == INVALID_3DTEXT_ID) continue;
		if(!containersInfo[idx][coCheckpoint]) continue;

		containersInfo[idx][coTime] --;
		if(containersInfo[idx][coBuyerID] != INVALID_PLAYER_ID) format(stringer1, sizeof stringer1, "\n"cWH"Покупатель: "cMain"%s\n", GetName(containersInfo[idx][coBuyerID]));

		global_string = "";
		format(global_string, sizeof global_string,
		""cWH"Контейнер "cMain"№%d\n\
		"cWH"Стоимость: "cMain"%d рублей\n\
		%s\
		"cWH"%s: "cMain"%d секунд\n\
		"cWH"Если Вы готовы испытать удачу - подойдите к чекпоинту!",
		idx + 1, containersInfo[idx][coCost], containersInfo[idx][coBuyerID] != INVALID_PLAYER_ID ? stringer1 : "", containersInfo[idx][coBuyerID] == INVALID_PLAYER_ID ? "До удаления" : "До конца торгов", containersInfo[idx][coTime]);

		if(containersInfo[idx][coTime] <= 0)
		{
			new playerid = containersInfo[idx][coBuyerID];
			if(containersInfo[idx][coBuyerID] != INVALID_PLAYER_ID)
			{
				SCMF(playerid, 0xFFCC00AA, "Вы побеждаете в торгах за контейнер №%d, чтобы открыть его подойдите к чекпоинту", idx + 1);
				if(containersInfo[idx][coBuyerID] != INVALID_PLAYER_ID) format(stringer1, sizeof stringer1, "\n"cWH"Покупатель: "cMain"%s\n", GetName(containersInfo[idx][coBuyerID]));
				containersInfo[idx][coOpen] = 1;

				global_string = "";
				format(global_string, sizeof global_string,
				""cWH"Контейнер "cMain"№%d\n\
				"cWH"Стоимость: "cMain"%d рублей\n\
				%s\
				"cWH"%s: "cMain"окончено\n\
				"cWH"Если Вы готовы испытать удачу - подойдите к чекпоинту!",
				idx + 1, containersInfo[idx][coCost], containersInfo[idx][coBuyerID] != INVALID_PLAYER_ID ? stringer1 : "", containersInfo[idx][coBuyerID] == INVALID_PLAYER_ID ? "До удаления" : "До конца торгов");

				if(!IsValidDynamic3DTextLabel(containersInfo[idx][coLabel])) containersInfo[idx][coLabel] = CreateDynamic3DTextLabel(global_string, -1, containersInfo[idx][coLabelPosX], containersInfo[idx][coLabelPosY], containersInfo[idx][coLabelPosZ], 10.0);
				else UpdateDynamic3DTextLabelText(containersInfo[idx][coLabel], COLOR_WHITE, global_string);
			}
			else
			{
				if(containersInfo[idx][coObject] != INVALID_OBJECT_ID) DestroyDynamicObject(containersInfo[idx][coObject]), containersInfo[idx][coObject] = INVALID_OBJECT_ID;
				if(containersInfo[idx][coLabel] != INVALID_3DTEXT_ID) DestroyDynamic3DTextLabel(containersInfo[idx][coLabel]), containersInfo[idx][coLabel] = INVALID_3DTEXT_ID;
				if(containersInfo[idx][coCheckpoint]) DestroyPickup(containersInfo[idx][coCheckpoint]), containersInfo[idx][coCheckpoint] = 0;
			}
		}
		else
		{
			if(!IsValidDynamic3DTextLabel(containersInfo[idx][coLabel])) containersInfo[idx][coLabel] = CreateDynamic3DTextLabel(global_string, -1, containersInfo[idx][coLabelPosX], containersInfo[idx][coLabelPosY], containersInfo[idx][coLabelPosZ], 10.0);
			else UpdateDynamic3DTextLabelText(containersInfo[idx][coLabel], COLOR_WHITE, global_string);
		}
	}

	if(g_rob[R_STATUS] && g_rob[R_TIME] > 0)
	{
		new playerid = g_rob[R_PLAYERID];

		-- g_rob[R_TIME];

		format(stringer1, 60, "%d:%02d_минут", g_rob[R_TIME] / 60, g_rob[R_TIME] % 60);
		PlayerTextDrawSetString(playerid, rob_td_player[1][playerid], stringer1);

		if(g_rob[R_TIME] == 0)
		{
			SendClientMessage(playerid, COLOR_RED, "Вы не успели выбрать все знаки. Ограбление завершено.");

			g_rob[R_STATUS] = false;
			g_rob[R_TIME] = 0;
			g_rob[R_ICON] = 0;
			g_rob[R_BIZ_ID] = 0;
			g_rob[R_PLAYERID] = INVALID_PLAYER_ID;
			g_rob[R_PRESSED] = 0;
		}
	}
	if(g_capture[C_STATUS] && g_capture[C_TIME] > 0)
	{
		--g_capture[C_TIME];
		UpdateCaptureTextDraw();
		if(g_capture[C_TIME] == 0) EndCapture();
	}
	if(fights_status)
	{
		if(fights_timer > 0)
		{
			fights_timer -= 1;
			UpdateFightsText();
		}
		if(fights_timer == 0)
		{
			new bool: block = false;
			if(fights_count_players < 2) block = true;

			new player_1 = INVALID_PLAYER_ID,
			player_2 = INVALID_PLAYER_ID;

			player_1 = GetPlayerID(fights_player[0]),
			player_2 = GetPlayerID(fights_player[1]);

			if(player_1 == INVALID_PLAYER_ID || player_2 == INVALID_PLAYER_ID) block = true;
			if(player_1 != INVALID_PLAYER_ID && player_2 != INVALID_PLAYER_ID)
			{
				if(PI[player_1][pJailTime] > 0) block = true;
				if(PI[player_2][pJailTime] > 0) block = true;
				if(!IsPlayerInRangeOfPoint(player_1, 100.0, -207.5554,62.2850,1301.5000)) block = true;
				if(!IsPlayerInRangeOfPoint(player_2, 100.0, -207.5554,62.2850,1301.5000)) block = true;
			}
			if(block)
			{
				SendClientMessageToAll(COLOR_YELLOW, "[Бойцовский клуб]: бой отменен из-за нарушения правил боя");
				SendClientMessageToAll(COLOR_YELLOW, "[Бойцовский клуб]: ставки, сделанные на исход события, были возвращены");
				UpdateFightsText();
				ClearFightsData();
				foreach(new i: Player)
				{
					if(fights_money[i] > 0)
					{
						SendMes(i, COLOR_ORANGE, "Из-за отмены боя, Вам на счет была возвращена сумма Вашей ставки: %d рублей", fights_money[i]);
						SetPlayerMoney(i, fights_money[i]);
						fights_money[i] = 0;
					}
					fights_player_status[i] = false;
				}
			}
			else FightsStart();
		}
	}
	for(new idx; idx < sizeof AeroportRandomSpawn; idx++)
	{
		if(AeroportPlayer[idx] == -1 || AeroportStatus[idx] == false) continue;
		new helic_vehid = PI[AeroportPlayer[idx]][HelicopterID];
		new Float: helic_distance = GetVehicleDistanceFromPoint(PI[AeroportPlayer[idx]][HelicopterID], AeroportRandomSpawn[idx][0], AeroportRandomSpawn[idx][1], AeroportRandomSpawn[idx][2]);

		if(helic_distance > 500.0 || !IsValidVehicle(helic_vehid))
		{
			SendClientMessage(AeroportPlayer[idx], COLOR_GREEN, "Вы покинули зону взлета аэропорта.");
			SendClientMessage(AeroportPlayer[idx], COLOR_GREEN, "Ранее занятое Вами место для взлета - освободилось.");
			AeroportPlayer[idx] = -1;
			AeroportStatus[idx] = false;
		}
	}
	if(g_pubg_status == 1)
	{
		switch(--g_pubg_timer)
		{
		case 300:
			{
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открыта регистрация на мероприятие 'Battle Royale'");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 5 минут");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 7");
			}
		case 120:
			{
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открыта регистрация на мероприятие 'Battle Royale'");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 2 минуты");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 7");
			}
		case 0:
			{
				if(g_pubg_count < 2)
				{
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация на мероприятие 'Battle Royale' закрылась из-за нехватки участников");
					g_pubg_count =
					g_pubg_status = 0;
					foreach(new ids: Player) if(playerGamePubg{ids}) playerGamePubg{ids} = 0;
				}
				else
				{
					g_pubg_status = 2;
					PubgStart();
				}
			}
		}
	}

	if(gDerbyStatus == 1)
	{
		switch(--gDerbyTimer)
		{
		case 300:
			{
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открыта регистрация на мероприятие 'Дерби'");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 5 минут");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 10");
			}
		case 120:
			{
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открыта регистрация на мероприятие 'Дерби'");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 2 минуты");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 10");
			}
		case 0:
			{
				if(gDerbyCount < 4)
				{
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация на мероприятие 'Дерби' закрылась из-за нехватки участников");
					gDerbyCount =
					gDerbyStatus = 0;
					foreach(new ids: Player) playerGameDerby{ids} = 0;
				}
				else
				{
					gDerbyStatus = 2;
					DerbyStart();
				}
			}
		}
	}
	if(gSkyDivingStatus == 1)
	{
		switch(--gSkyDivingTimer)
		{
		case 300:
			{
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открыта регистрация на мероприятие 'Прыжки с парашюта'");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 5 минут");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 11");
			}
		case 120:
			{
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Открыта регистрация на мероприятие 'Прыжки с парашюта'");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра стартует через 2 минуты");
				SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Место регистрации: /gps > 6 > 11");
			}
		case 0:
			{
				if(gSkyDivingCount < 5)
				{
					SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация на мероприятие 'Прыжки с парашюта' закрылась из-за нехватки участников");

					gSkyDivingCount =
					gSkyDivingStatus = 0;

					foreach(new ids: Player) playerGameSkyDiving{ids} = 0, playerSkyDivingCount[ids] = 0;
				}
				else
				{
					gSkyDivingStatus = 2;
					SkyDivingStart();
				}
			}
		}
	}
	if(PBP_TIMER)
	{
		switch(PBP_STATUS)
		{
		case 1:
			{
				switch(--PBP_TIMER)
				{
				case 600:
					{
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: А мы напоминаем, что открыта регистрация на мероприятие 'Мясорубка'!");
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Осталось времени на регистрацию 10 минут");
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Успей зарегистрироваться! /gps -> Развлечения");
					}
				case 300:
					{
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: А мы напоминаем, что открыта регистрация на мероприятие 'Мясорубка'!");
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Осталось времени на регистрацию 5 минут");
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Успей зарегистрироваться! /gps -> Развлечения");
					}
				case 120:
					{
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: А мы напоминаем, что открыта регистрация на мероприятие 'Мясорубка'!");
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Осталось времени на регистрацию 2 минуты");
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Успей зарегистрироваться! /gps -> Развлечения");
					}
				case 0:
					{
						if(PB_COUNTPLAYERS() < 6)
						{
							SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация на мероприятие 'Мясорубка' закрылась из-за нехватки участников");
							PB_STOP();
						}
						else
						{
							SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Регистрация на мероприятие 'Мясорубка' закрылась. Игра начинается..");
							SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Время игры: 10 минут");
							PBP_STATUS = 2;
							PBP_TIMER = 600;
							PB_START(1);
						}
					}
				}
			}
		case 2:
			{
				switch(--PBP_TIMER)
				{
				case 300: SendClientMessageToAll(COLOR_ORANGE,"[Новости]: До окончания игры 'Мясорубка' осталось 5 минут");
				case 120: SendClientMessageToAll(COLOR_ORANGE,"[Новости]: До окончания игры 'Мясорубка' осталось 2 минуты");
				case 0:
					{
						PBP_LID = GetWinnerPB();
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Игра 'Мясорубка' завершилась.");
						SendClientMessageToAll(COLOR_ORANGE,"[Новости]: Посмотреть список победителей можно командой /paintlist");
						PB_STOP();
					}
				}
			}
		}
	}
	return 1;
}

stock ServerUpdateTimer_Random()
{
	new rand_ = random(sizeof(g_weather));

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "{3399FF}[Прогноз погоды] "cWH"В области ожидается %s {99CC00}(%d °С)", g_weather[rand_][W_NAME], g_weather[rand_][W_DEGREES]);
	SendClientMessageToAll(0xFFFFFFFF, STRING_GLOBAL);

	world_weather = g_weather[rand_][W_ID];

	SetWeather(g_weather[rand_][W_ID]);
	return 1;
}
SetWantedLvl(i, idm, lvl, reason[])
{
	PI[i][pWanted] += lvl;
	SetPlayerWantedLevel(i, PI[i][pWanted]);
	SetPlayerCriminal(i, GetName(idm), reason);
}
stock SetMeriaCash(price)
{
	if((FracBank[9] + price) < 2000000000)
	{
		if(FracBank[9] < 0) FracBank[9] = 0;
		FracBank[9] += price;
		MysqlUpdateOtherInt("sfnbank", FracBank[9]);
	}
}
stock ServerUpdateTimer_30()
{
	#if defined TL_VERSION

	//светофоры
	for(new i = 0; i != sizeof g_traffic_lights; i ++)
	{
		new hours;
		gettime(hours, _, _);

		if(hours >= 0 && hours < 5)
		{
			g_traffic_lights[i][TL_COLOR] = TLC_YELLOW;
			SetTrafficLightColor(i, g_traffic_lights[i][TL_COLOR]);
		}

		if(g_traffic_lights[i][TL_COLOR] == TLC_RED)
		{
			g_traffic_lights[i][TL_COLOR] = TLC_GREEN;
			SetTrafficLightColor(i, g_traffic_lights[i][TL_COLOR]);
		}

		else if(g_traffic_lights[i][TL_COLOR] == TLC_GREEN)
		{
			g_traffic_lights[i][TL_COLOR] = TLC_RED;
			SetTrafficLightColor(i, g_traffic_lights[i][TL_COLOR]);
		}

		new Float: pos_obj[3];
		GetDynamicObjectPos(TL_Data[i][tl_object_id], pos_obj[0], pos_obj[1], pos_obj[2]);

		foreach(new playerid : Player)
		{
			if(!IsPlayerInRangeOfPoint(playerid, 20.0, pos_obj[0], pos_obj[1], pos_obj[2])) continue;
			if(PI[playerid][pAFK] >= 3) continue;
			Streamer_UpdateEx(playerid, pos_obj[0], pos_obj[1], pos_obj[2]);
		}
	}

	#endif
	return 1;
}
stock ServerUpdateTimer_60()
{
	WHDataUpdate();

	if(++UpdateAkkSchet >= 30)
	{
		if(doubling_donate != 0)
		{
			SendClientMessageToAll(COLOR_WHITE, "");
			SendClientMessageToAll(0xFFCC00FF, "["PROJECT_NAME_BIG" INFO] УВАЖАЕМЫЕ ИГРОКИ! У ВАС ЕСТЬ УДИВИТЕЛЬНО ВЫГОДНАЯ ВОЗМОЖНОСТЬ ПРИОБРЕСТИ АДМИНКУ");
			SendClientMessageToAll(0xFFCC00FF, "["PROJECT_NAME_BIG" INFO] ИСПОЛЬЗОВАВ АВТОДОНАТ! СЕЙЧАС ДЕЙСТВУЕТ АКЦИЯ X2 DONATE! ИСПОЛЬЗУЙТЕ /DONATE");
			SendClientMessageToAll(0xFFCC00FF, "["PROJECT_NAME_BIG" INFO] ВСЕ ВАШИ ПОПОЛНЕНИЯ УМНОЖАЮТСЯ НА ДВА! ПРИМЕР: ЗАДОНАТИЛИ 100 РУБ ПОЛУЧИЛИ 200");
			SendClientMessageToAll(0xFFCC00FF, "["PROJECT_NAME_BIG" INFO] ПОПОЛНИТЬ "SERVER_COINS_BIG" - "PAGE_WEBSITE_DONATE_BIG"");
			SendClientMessageToAll(COLOR_WHITE, "");
		}
		else
		{
			SendClientMessageToAll(COLOR_WHITE, "");
			SendClientMessageToAll(0xFFCC00FF, "["PROJECT_NAME_BIG" INFO] Уважаемые игроки! У вас есть удивительно выгодная возможность приобрести админку!");
			SendClientMessageToAll(0xFFCC00FF, "["PROJECT_NAME_BIG" INFO] Использовав автодонат! Используйте /donate !");
			SendClientMessageToAll(0xFFCC00FF, "["PROJECT_NAME_BIG" INFO] Пополнить "SERVER_COINS" - "PAGE_WEBSITE_DONATE_BIG"");
			SendClientMessageToAll(COLOR_WHITE, "");
		}
		SendClientMessageToAll(0xFFCC00FF, "["PROJECT_NAME_BIG" INFO] СЕЙЧАС ПРОХОДЯТ СЕЗОННЫЕ ИВЕНТЫ! ПОДРОБНЕЕ: /topevent");
		UpdateAkkSchet = 0;
	}
	foreach(new v : Vehicle)
	{
		if(GetVehicleType(v) == 2 || GetVehicleType(v) == 3 || GetVehicleType(v) == 4 || GetVehicleType(v) == 5 || GetVehicleType(v) == 7) continue;
		if(Engine[v] != true || Fuel[v] < 0) continue;
		Fuel[v]--;
		if(Fuel[v] < 1)
		{
			Engine[v] = false;
			PlayerFuelMes[v] = true;
			GetVehicleParamsEx(v,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			SetVehicleParamsEx(v,false,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
			Fuel[v] = 0;
		}
	}
	for(new i; i < MAX_REPORTS; i++)
	{
		if(gReportInfo[i][rPlayerID] == -1)  continue;
		if(unix - gReportInfo[i][rWhenWroted_Time] >= 10*60)
		{
			new playerid = gReportInfo[i][rPlayerID];
			SendClientMessage(playerid, COLOR_GREY, !"Ваше обращение к администрации было удалено по времени.");
			playerReportID[playerid] = -1;
			gReportInfo[i][rIsTooked] = false;
			gReportInfo[i][rID] = i;
			gReportInfo[i][rAnswer] = -1;
			gReportInfo[i][rPlayerID] = -1;
			gReportInfo[i][rText][0] = EOS;
			gReportInfo[i][rWhenWroted_Time] = -1;
			gReportInfo[i][rWhenWroted_Text][0] = EOS;
		}
	}
	CheckTimeSystems();
	return 1;
}
public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
	if(response && EditAccessories[playerid] != -1)
	{
		new idx = EditAccessories[playerid];
		SetPlayerAccessoriesData(playerid, idx, A_OBJECT_X, fOffsetX);
		SetPlayerAccessoriesData(playerid, idx, A_OBJECT_Y, fOffsetY);
		SetPlayerAccessoriesData(playerid, idx, A_OBJECT_Z, fOffsetZ);

		global_string = "";
		format(global_string, 128, "UPDATE accounts_accessories SET object_x=%.4f, object_y=%.4f, object_z=%.4f WHERE id=%d", fOffsetX, fOffsetY, fOffsetZ, GetPlayerAccessoriesData(playerid, idx, A_ID));
		mysql_tquery(db_prod, global_string);

		SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно изменили позицию аксессуара");
		EditAccessories[playerid] = -1;
	}
}

public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
	if(playerRadarSelect[playerid])
	{
		new id = playerRadarSelect[playerid];
		if(response == EDIT_RESPONSE_FINAL)
		{
			gRadarPos[id][0] = x;
			gRadarPos[id][1] = y;
			gRadarPos[id][2] = z;
			gRadarPos[id][3] = rz;

			DestroyDynamicObject(objectid);

			nformat(stringer, ""cWH"Радар: "cMain"%i\n"cWH"Максимальная скорость: "cMain"%i км/ч.\n"cWH"Штраф за нарушение: "cMain"%i руб.", id, gRadarSpeed[id], gRadarPrice[id]);
			gRadarText[id] = CreateDynamic3DTextLabel(stringer, -1, gRadarPos[id][0],gRadarPos[id][1],gRadarPos[id][2]+3.0, 10.0);
			gRadarObject[id] = 	CreateDynamicObject(18880,  gRadarPos[id][0],gRadarPos[id][1],gRadarPos[id][2] - 1.3, 0, 0, gRadarPos[id][3]);

			playerRadarObject[playerid] =
			playerRadarSelect[playerid] = 0;
			SQF1("INSERT INTO radar (x,y,z,r,speed,price,id) VALUES ('%f', '%f', '%f', '%f',%i,%i,%i)",x,y,z,rz,gRadarSpeed[id], gRadarPrice[id], id);
			fLogs("[admin] %s /addradar %i [%f %f %f %f]", GetName(playerid), id, x, y, z, rz);
		}
		else if(response == EDIT_RESPONSE_CANCEL)
		{
			DestroyDynamicObject(objectid);
			gRadarSpeed[id] =
			gRadarPrice[id] =
			playerRadarObject[playerid] =
			playerRadarSelect[playerid] = 0;
			TOTALRADAR--;
		}
	}
	if(playerSelectObject[playerid] == objectid)
	{
		if(response == EDIT_RESPONSE_FINAL)
		{
			MoveDynamicObject(objectid, x, y, z, 100.0, rx, ry, rz);

			if(NoSaveMapping)
			{
				new string1[255], string2[128], File: objs;
				format(string2, sizeof(string2), "objectlog.txt");
				objs = fopen(string2, io_append);
				format(string1, sizeof(string1), "CreateDynamicObject(%d, %f,%f,%f, %f,%f,%f);\n", GetPVarInt(playerid,"ModelID"),x,y,z,rx,ry,rz);
				fwrite(objs, string1);
				fclose(objs);
			}
			else
			{
				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `objects` SET `posx` = '%f', `posy` = '%f', `posz` = '%f', `rotx` = '%f', `roty` = '%f', `rotz` = '%f' WHERE `slot` = '%d' LIMIT 1", x, y, z, rx, ry, rz, playerSelectObjectSlot[playerid]);
				mysql_tquery(db_prod, STRING_GLOBAL);
			}

			fLogs("[admin] %s /obj изменить %i [%f %f %f]", GetName(playerid), playerSelectObjectSlot[playerid], x, y, z);
			playerSelectObject[playerid] = 0;
		}
		if(response == EDIT_RESPONSE_CANCEL)
		{
			DestroyDynamicObject(objectid);
			serObjectID[playerSelectObjectSlot[playerid]] = 0;

			if(!NoSaveMapping)
			{
				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `objects` WHERE `slot` = '%d'", playerSelectObjectSlot[playerid]);
				mysql_tquery(db_prod, STRING_GLOBAL);
			}
			fLogs("[admin] %s /obj удалить %i", GetName(playerid), playerSelectObjectSlot[playerid]);
			playerSelectObject[playerid] = 0;
		}
		return 1;
	}
	return 1;
}

public OnPlayerEditObject(playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ)
{
	if(LoadATMObject[playerid] > 0)
	{
		if(!playerobject)
		{
			if(!IsValidObject(objectid)) return 1;
			MoveDynamicObject(objectid, fX, fY, fZ, 10.0, fRotX, fRotY, fRotZ);
		}
		if(response == EDIT_RESPONSE_FINAL)
		{
			TOTALATM++;
			ATMInfo[TOTALATM][aX] = fX;
			ATMInfo[TOTALATM][aY] = fY;
			ATMInfo[TOTALATM][aZ] = fZ;
			ATMInfo[TOTALATM][arX] = fRotX;
			ATMInfo[TOTALATM][arY] = fRotY;
			ATMInfo[TOTALATM][arZ] = fRotZ;
			SendClientMessage(playerid,COLOR_YELLOW,"ИНФО: Вы установили банкомат");
			DestroyObject(LoadATMObject[playerid]-1);
			ATM[TOTALATM] = 	CreateDynamicObject(11135, fX, fY, fZ, fRotX, fRotY, fRotZ);
			LABELATM[TOTALATM] = CreateDynamic3DTextLabel("Банкомат\n"cWH"Нажмите: "cMain"ALT", 0xFFFFFFAA, ATMInfo[TOTALATM][aX],ATMInfo[TOTALATM][aY],ATMInfo[TOTALATM][aZ]+1.1,10.0);
			LoadATMObject[playerid] = 0;
			CancelEdit(playerid);

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `atm` (`ID`, `aX`, `aY`, `aZ`, `arX`, `arY`, `arZ`) VALUES (%d, '%f', '%f', '%f', '%f', '%f', '%f')", TOTALATM,ATMInfo[TOTALATM][aX],ATMInfo[TOTALATM][aY],ATMInfo[TOTALATM][aZ], ATMInfo[TOTALATM][arX], ATMInfo[TOTALATM][arY], ATMInfo[TOTALATM][arZ]);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");
			fLogs("[admin] %s /add банкомат %i [%f %f %f]", GetName(playerid), TOTALATM, fX, fY, fZ);
		}
		if(response == EDIT_RESPONSE_CANCEL)
		{
			LoadATMObject[playerid] = 0;
			SendClientMessage(playerid, COLOR_RED, "Установка банкомата отменена");
			DestroyObject(LoadATMObject[playerid]-1);
			CancelEdit(playerid);
		}
		return 1;
	}
	return 1;
}

public OnGameModeExit()
{
	DestroyAllDynamicObjects();
	DestroyAllDynamicCPs();
	DestroyAllDynamicRaceCPs();
	DestroyAllDynamicMapIcons();
	DestroyAllDynamic3DTextLabels();
	DestroyAllDynamicAreas();
	mysql_close(db_prod);
	return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
	SetSpawnInfo(playerid, 255, 21, 0.1, 0.1, 13.6987, 0.0, 0, 0, 0, 0, 0, 0);

	SetPlayerVirtualWorld(playerid, playerid + 1);
	SetPlayerInterior(playerid, playerid + 1);

	return SpawnPlayer(playerid);
}
#include "gordeev/usupovrp.inc"

callback::player_settings_type(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		cache_get_field_content(0, "settings", PI[playerid][pSettings], db_prod, 32);
		cache_get_field_content(0, "password", PI[playerid][pPassword], db_prod, 32);
		cache_get_field_content(0, "ip", PI[playerid][pLastIP], db_prod, 16);

		sscanf(PI[playerid][pSettings], "p<,>a<i>[6]", Setting[playerid]);
		new l_day, l_month, l_year, datavhod[24];
		cache_get_field_content(0, "datavhod", datavhod, db_prod, 24);
		sscanf(datavhod, "p<.>iii", l_day, l_month, l_year);
		data_vhod[playerid] = l_day;
		PI[playerid][pModel] = cache_get_field_content_int(0, "model");

		new str_setting[64];
		cache_get_field_content(0, "SettingTD", str_setting, db_prod, 64);
		sscanf(str_setting, "p<|>a<i>[5]", PI[playerid][pSettingTD]);

		for(new i; i < 3; i ++)
		{
			TextDrawHideForPlayer(playerid, start_game_TD[i]);
		}
		PlayerTextDrawHide(playerid, start_game_PTD[playerid][0]);
		CancelSelectTextDrawEx(playerid);

		regstatus{playerid} = false;
		ShowPlayerAuthGUI(playerid, true);
	}
	else
	{
		if(IsLoginInvalid(GetName(playerid)))
		{
			SendClientMessage(playerid, COLOR_RED, "Ваше имя содержит запрещенные символы или формат неверен, используйте имя формата Имя_Фамилия на английском!");
			SendClientMessage(playerid, COLOR_RED, "Обязательные условия ника: 1 заглавная буква в имени, 1 заглавная буква в фамилии и один прочерк _ между ними!");
			SendClientMessage(playerid, COLOR_RED, "Никнеймы подобного типа запрещены: VOVA_PUTiN, VoVa_Putin, Vo2a_Putin.");
			SendClientMessage(playerid, COLOR_RED, "Никнеймы подобного типа разрешены: Vova_Putin, Artem_Fokich, Winston_Blagov");
			SendClientMessage(playerid, COLOR_RED, "Пожалуйста, если у вас возникла проблема напишите нам в группу - vk.com/kaspilcrmp");
			return SetTimerEx("DisconnectPlayer", 50, 0, "d", playerid);
		}

		for(new i; i < 3; i ++)
		{
			TextDrawHideForPlayer(playerid, start_game_TD[i]);
		}
		PlayerTextDrawHide(playerid, start_game_PTD[playerid][0]);
		CancelSelectTextDrawEx(playerid);

		SetPlayerSkin(playerid, JoinRegM[SelectCharPlace[playerid]]);
		ChosenSkin[playerid] = JoinRegM[SelectCharPlace[playerid]];
		regstatus{playerid} = true;
		ShowPlayerAuthGUI(playerid, false);
	}
	return 1;
}
callback::player_check(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		cache_get_field_content(0, "password", PI[playerid][pPassword], db_prod, 32);
		regstatus{playerid} = false;

		ShowPlayerAuthGUI(playerid, true);
	}
	else
	{
		SetPlayerSkin(playerid, JoinRegM[SelectCharPlace[playerid]]);
		ChosenSkin[playerid] = JoinRegM[SelectCharPlace[playerid]];
		regstatus{playerid} = true;

		ShowPlayerAuthGUI(playerid, false);
	}
	return 1;
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(result == -1)
    {
        SendClientMessage(playerid, 0xf49090FF, "Команда не обнаружена! Используйте {ffffff}/menu > Список команд {f49090}для просмотра команд");
        return 0;
    }

	return 1;
}
public OnPlayerConnect(playerid)
{
	RemoveBuild(playerid);

	if(IsPlayerNPC(playerid)) return 1;
	if(playerid == INVALID_PLAYER_ID || gamemodeloaded != 1) return KickEx(playerid, "gamemodeloaded");

//	if(!IsPlayerFromThePhone(playerid))
//		GetPlayerHWID(playerid);

	streamer_mode[playerid] = 0;

	new StringMax[50];

	GetPlayerVersion(playerid, StringMax, sizeof(StringMax));

/*	if(strfind(StringMax, "prp-a") == -1 && strfind(StringMax, "prp-mob-a") == -1)
	{
		SendClientMessage(playerid, COLOR_RED, "[CONNECTION ERROR] Используйте актуальную игру для входа.");
		return SetTimerEx("DisconnectPlayer", 50, 0, "d", playerid);
	}*/

	crash_status[playerid] = 0;

	g_players_count ++;

	PI[playerid][P_IN_GREEN_ZONE] = 0;

	GivePlayer[playerid][0] =
	GivePlayer[playerid][1] =
	GivePlayer[playerid][2] =
	GivePlayer[playerid][3] =
	GivePlayer[playerid][4] = -1;

	GetPlayerIp(playerid, PI[playerid][pIP], 16);

	GetPlayerName(playerid, PI[playerid][pName], MAX_PLAYER_NAME);

	if(strfind(StringMax, "prp-mob-a") != -1)
	{
		new format_name[MAX_PLAYER_NAME];
		new name[MAX_PLAYER_NAME];

		GetPlayerName(playerid, name, MAX_PLAYER_NAME);

		format(format_name, sizeof format_name, "%s_M", name);
		SetPlayerName(playerid, format_name);

		printf("(MOBILE CONNECT) NAME: %s", format_name);
	}

	if(!CheckNick_krossplatforma(playerid)) return KickEx(playerid, "nick");

	new num_ip = GetNumberOfPlayersOnThisIP(PI[playerid][pIP]);
	if(num_ip > 5)
	{
		BanEx(playerid, "USED BOTS");
		printf("PLAYER USED BOTS - %s[%d] %s", GetName(playerid), playerid, PI[playerid][pIP]);
		return 1;
	}

	SetPlayerDataToDefault(playerid);
	CreateTextDraws(playerid);
	SetPlayerColor(playerid, COLOR_GREY);

	info_money_PTD[playerid] = CreatePlayerTextDraw(playerid, 324.0000, 421.4667, "+10_P");
	PlayerTextDrawLetterSize(playerid, info_money_PTD[playerid], 0.2383, 1.1976);
	PlayerTextDrawAlignment(playerid, info_money_PTD[playerid], 2);
	PlayerTextDrawColor(playerid, info_money_PTD[playerid], -39583489);
	PlayerTextDrawBackgroundColor(playerid, info_money_PTD[playerid], 255);
	PlayerTextDrawFont(playerid, info_money_PTD[playerid], 1);
	PlayerTextDrawSetProportional(playerid, info_money_PTD[playerid], 1);
	PlayerTextDrawSetShadow(playerid, info_money_PTD[playerid], 0);

	Conday[0]++;
	Conday[1]++;
	MD[5]++;

	for(new i = 0; i < MAX_LIST+1; i++) PlayerUseList[playerid][i] = 0;

	AddToWarningPanel(playerid, "Подключение к серверу", 2);

	/*if(strfind(StringMax, "prp-mob-a") == -1)
	{
		printf("[PC LAUNCHER ANTI-CHEAT] Player %s [%d] connecting to the server... [AC IS ON]", GetName(playerid), playerid);

		STRING_GLOBAL[0] = EOS;

		format(STRING_GLOBAL, sizeof STRING_GLOBAL, "SELECT * FROM `connections` WHERE `name` = '%s' LIMIT 1", GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL, "GetPlayerLauncherConnect", "i", playerid);
	}*/

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT `id` FROM `whitelist` WHERE `name` = '%e' LIMIT 1", GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "WhitelistCheckPlayer", "i", playerid);

	return 1;
}

callback::GetPlayerLauncherConnect(playerid)
{
	if(g_launcher_anticheat_status != 1) return 1;
	if(GetString(GetName(playerid), "Winston")) return 1;

	new rows, fields;
	cache_get_data(rows, fields);

	if(!rows)
	{
		STRING_GLOBAL[0] = EOS;

		format
		(
			STRING_GLOBAL, sizeof STRING_GLOBAL,
			"{ffffff}Вы были кикнуты анти-чит системой по причине входа\n"\
			"с {ff4757}невалидного клиента{ffffff}.\n\n"\
			"Ваше имя: {ff4757}%s\n"\
			"{ffffff}Ваш пинг: {ff4757}%d\n\n"\
			"{ffffff}Модуль анти-чита: {ff4757}launcher\n\n"\
			"{ffffff}Возможно, Вы не {ff4757}обновили лаунчер {ffffff}до последней версии,\n"\
			"перезапустите его и дождитесь обновления.",
			GetName(playerid),
			GetPlayerPing(playerid)
		);

		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "{ff4757}King Anti-Cheat System", "", "Закрыть", "");

		return KickEx(playerid, "AC -> Launcher");
	}

	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "DELETE FROM `connections` WHERE `name` = '%s'", GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL);

	return 1;
}

callback::WhitelistCheckPlayer(playerid)
{
	if(!IsPlayerConnected(playerid)) return 1;

	new rows, fields;
	cache_get_data(rows, fields);

	if(!rows)
	{
		ShowPlayerDialog(playerid, DIALOG_WL_DENY, DIALOG_STYLE_MSGBOX, "{FF4757}Whitelist", "{FFFFFF}Server is in whitelist mode.\nYou are not in the access list.", "Ok", "");
		return SetTimerEx("DisconnectPlayer", 1500, 0, "d", playerid);
	}

	SpawnPlayer(playerid);
	return 1;
}

callback::WhitelistShowList(playerid)
{
	if(!IsPlayerConnected(playerid)) return 1;

	new rows, fields;
	cache_get_data(rows, fields);

	if(!rows)
	{
		ShowPlayerDialog(playerid, DIALOG_WL_LIST, DIALOG_STYLE_MSGBOX, ""cMain"Whitelist", ""cWH"Whitelist is empty.", "Close", "");
		return 1;
	}

	STRING_GLOBAL[0] = EOS;
	strcat(STRING_GLOBAL, "ID\tName\tAdded by\tDate\n");

	g_whitelist_item_count[playerid] = 0;

	for(new i; i < rows && i < WHITELIST_MAX_VIEW; i++)
	{
		new wl_name[MAX_PLAYER_NAME], wl_added[MAX_PLAYER_NAME], wl_date[20];

		g_whitelist_item_id[playerid][i] = cache_get_field_content_int(i, "id");
		cache_get_field_content(i, "name", wl_name, db_prod, MAX_PLAYER_NAME);
		cache_get_field_content(i, "added_by", wl_added, db_prod, MAX_PLAYER_NAME);
		cache_get_field_content(i, "wl_date", wl_date, db_prod, sizeof(wl_date));

		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%d\t%s\t%s\t%s\n", STRING_GLOBAL, g_whitelist_item_id[playerid][i], wl_name, wl_added, wl_date);
		g_whitelist_item_count[playerid]++;
	}

	if(rows > WHITELIST_MAX_VIEW) SendClientMessage(playerid, COLOR_GREY, "Whitelist list is too long. Showing first 200 entries.");
	ShowPlayerDialog(playerid, DIALOG_WL_LIST, DIALOG_STYLE_TABLIST_HEADERS, ""cMain"Whitelist", STRING_GLOBAL, "Select", "Close");
	return 1;
}

callback::WhitelistAddCheck(playerid, wlname[])
{
	if(!IsPlayerConnected(playerid)) return 1;

	new rows, fields;
	cache_get_data(rows, fields);

	if(rows) return SendClientMessage(playerid, COLOR_RED, "This nickname is already in whitelist.");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO whitelist (name, added_by) VALUES ('%e', '%e')", wlname, GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "WhitelistAddDone", "is", playerid, wlname);
	return 1;
}

callback::WhitelistAddDone(playerid, wlname[])
{
	if(!IsPlayerConnected(playerid)) return 1;
	SendMes(playerid, COLOR_GREEN, "You added %s to whitelist.", wlname);
	return 1;
}

callback::WhitelistDeleteDone(playerid, wlid)
{
	if(!IsPlayerConnected(playerid)) return 1;
	SendMes(playerid, COLOR_GREEN, "Whitelist entry #%d was removed.", wlid);
	return callcmd::whitelist(playerid);
}
ExitPubg(playerid)
{
	playerGamePubg{playerid} = 0;
	ResetPlayerWeapons(playerid);

	format(string, sizeof(string), "%d",g_pubg_count-1);
	TextDrawSetString(pubg_td_global[16], string);

	if(--g_pubg_count <= 1)
	{
		foreach(new to_player: Player) if(playerGamePubg{to_player})
		{
			for(new idx; idx < 8; idx ++) TextDrawHideForPlayer(to_player, pubg_td_global[idx]);
			PlayerTextDrawHide(to_player, pubg_td_player[to_player]);

			g_pubg_winners[0] = to_player;
			ResetPlayerWeapons(to_player);
			SpawnPlayer(to_player);
			break;
		}
		EndPubg();
	}
}

ExitDerby(playerid)
{
	playerGameDerby{playerid} = 0;

	if(playerDerbyVehicleID[playerid]) DestroyVehicle(playerDerbyVehicleID[playerid]);

	if(--gDerbyCount <= 1)
	{
		foreach(new to_player: Player) if(playerGameDerby{to_player})
		{
			gDerbyWinners[0] = to_player;
			SpawnPlayer(to_player);
			break;
		}
		EndDerby();
	}
}


ExitSkyDiving(playerid)
{
	playerGameSkyDiving{playerid} = 0;

	if(--gSkyDivingCount <= 1)
	{
		foreach(new to_player: Player) if(playerGameSkyDiving{to_player})
		{
			gSkyDivingWinners[0] = to_player;

			SpawnPlayer(to_player);
			break;
		}
		EndSkyDiving();
	}
}
public OnPlayerDisconnect(playerid, reason)
{
	if(IsValidDynamicArea(PlayerRaceSphere[playerid]))
		DestroyDynamicArea(PlayerRaceSphere[playerid]);

	GivePlayer[playerid][0] =
	GivePlayer[playerid][1] =
	GivePlayer[playerid][2] =
	GivePlayer[playerid][3] =
	GivePlayer[playerid][4] = -1;

	PVC_UnMutePlayer(playerid);
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `hitman` WHERE `vID` = '%d'", PI[playerid][pID]);
	mysql_tquery(db_prod, STRING_GLOBAL, "CheckKillerList", "ii", playerid, 0);

	g_players_count --;

	if(crash_status[playerid] == 0)
	{
		new message[30], totalstring[128];

		switch(reason)
		{
			case 0:
			{
				if(IsPlayerFromThePhone(playerid))
				{
					format(message, sizeof message, "вышел");
					printf("[DE-BUG] FAKE CRASH: EXIT GAME");
				}

				else
				{
					new Float: x, Float: y, Float: z;
					GetPlayerPos(playerid, x, y, z);

					printf("[DE-BUG] Player %s [%d] has been crashed (PC) (%f, %f, %f", GetName(playerid), playerid, x, y, z);
					format(message, sizeof message, "Обрыв связи (PC)");
				}
			}

			case 1:
			{
				format(message, sizeof message, "вышел");
				printf("[DE-BUG] DEFAULT EXIT GAME");
			}

			case 2:
			{
				if(IsPlayerFromThePhone(playerid))
					format(message, sizeof message, "Кикнут (%s) (M)", kick_reason[playerid]);

				else format(message, sizeof message, "Кикнут (%s) (PC)", kick_reason[playerid]);
			}
		}

		if(Iter_Contains(Admins, playerid))
		{
			Iter_Remove(Admins, playerid);

			if(!g_player_full_access[playerid])
			{
				format(totalstring, sizeof totalstring, "[A] %s %s [%d] покинул игру. Причина: %s", gAdminRanks[PI[playerid][pAdmin] - 1], GetName(playerid), playerid, message);
				SendAdminMessage(COLOR_GREY, totalstring);
			}
		}

		else
		{
			AddToWarningPanel(playerid, message, 3);
		}
	}

	is_mobile[playerid] = false;

	if(GetPVarInt(playerid, "narkopriton"))
	{
		for(new i; i < MAX_NARKOPRITON; i++)
		{
			if(nData[i][narkoID] == playerid)
			{
				nData[i][narkoID] = INVALID_PLAYER_ID;
				nData[i][narkoCount] = 0;
				nData[i][narkoPrice] = 0;
				DeletePVar(playerid, "narkopriton");
				break;
			}
		}
	}
	if(GetPVarInt(playerid, "gonka_price"))
	{
		new
			id = GetPVarInt(playerid, "gonka_id");

		if GetPlayerRubble(playerid) < GetPVarInt(id, "gonka_price") *then
		{
			if IsValidDynamicArea(PlayerRaceSphere[playerid]) *then DestroyDynamicArea(PlayerRaceSphere[playerid]);
			if IsValidDynamicArea(PlayerRaceSphere[id]) *then DestroyDynamicArea(PlayerRaceSphere[id]);
			DeletePVar(playerid, "gonka_id");
			DeletePVar(playerid, "gonka_price");
			DeletePVar(id, "gonka_id");
			DeletePVar(id, "gonka_price");
			return SendErr(playerid, "Соперник вышел из игры и у него нет денег, чтобы оплатить выигрыш.");
		}
		SendInf(id, "Вы пришли первым к финишу.");

		SetPlayerMoney(playerid, -GetPVarInt(playerid, "gonka_price"));
		SetPlayerMoney(id, GetPVarInt(playerid, "gonka_price"));

		fLogs("[заезд] %s -%i за проигрыш в гонке (выход)", GetName(playerid), GetPVarInt(playerid, "gonka_price"));
		fLogs("[заезд] %s +%i за выигрыш в гонке (выход)", GetName(id), GetPVarInt(playerid, "gonka_price"));

		DisablePlayerRaceCheckpoint(playerid);
		DisablePlayerRaceCheckpoint(id);

		if IsValidDynamicArea(PlayerRaceSphere[playerid]) *then DestroyDynamicArea(PlayerRaceSphere[playerid]);
		if IsValidDynamicArea(PlayerRaceSphere[id]) *then DestroyDynamicArea(PlayerRaceSphere[id]);

		DeletePVar(playerid, "gonka_id");
		DeletePVar(playerid, "gonka_price");
		DeletePVar(id, "gonka_id");
		DeletePVar(id, "gonka_price");
	}
	if(playerFamilyNameTag[playerid] != INVALID_3DTEXT_ID)
	{
		UpdateDynamic3DTextLabelText(playerFamilyNameTag[playerid], -1, " ");

		DestroyDynamic3DTextLabel(playerFamilyNameTag[playerid]);
		playerFamilyNameTag[playerid] = INVALID_3DTEXT_ID;
	}
	if(PlayerFixWeapon[playerid] == 1)
	{
		ResetPlayerWeapons(playerid);
	}
	if(playerPVPGun[playerid][0])
	{
		dmCountMap[0]--;
		ResetPlayerWeapons(playerid);
	}
	if(playerIvent{playerid})
	{
		dmCountMap[1]--;
		ResetPlayerWeapons(playerid);
	}
	if(playerBuyContainer[playerid] != -1)
	{
		new idx = playerBuyContainer[playerid];
		if(containersInfo[idx][coOpen])
		{
			global_string = "";
			if(containersInfo[idx][coType] == 0) containersInfo[idx][coType] = 1 + random(MAX_CONTAINERS_TYPE-1);
			switch(containersInfo[idx][coType])
			{
			case 0:
				{
					new skin = containers_skins[random(sizeof containers_skins)];
					SetPlayerSkin(playerid, skin);
					PlayerContainerSkin[playerid] = skin;
					ShowPlayerDialog(playerid, 9101, DIALOG_STYLE_MSGBOX,""cMain"Скин",""cWH"Вы хотите оставить этот скин?\nЕсли нет, то он будет продан за 1.000.000 рублей","Да", "Нет");
				}
			case 1:
				{
					new model_id = carsC[ random(sizeof(carsC)) ][0];
					SCMF(playerid, 0xFFCC00AA, "Контейнер содержал: автомобиль %s", VehicleNames[model_id-400]);
					format(stringer1, 128, "SELECT `id` FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(playerid));
					mysql_tquery(db_prod, stringer1, "CountCars_Containers","ii",playerid, model_id);
				}
			case 2:
				{
					new model_ids[] = {480, 503};
					new model_id = model_ids[random(sizeof model_ids)];
					SCMF(playerid, 0xFFCC00AA, "Контейнер содержал: автомобиль %s", VehicleNames[model_id-400]);
					format(stringer1, 128, "SELECT `id` FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(playerid));
					mysql_tquery(db_prod, stringer1, "CountCars_Containers","ii",playerid, model_id);

				}
			case 3:
				{
					new count = random(10) + 5;
					SCMF(playerid, 0xFFCC00AA, "Контейнер содержал: %d слитков ("SERVER_COINS") ", count);
					PI[playerid][pPerfectCoins] += count;
					UpdatePlayerData(playerid, "credits", PI[playerid][pPerfectCoins]);
					fLogs("[coin] %s +%i контейнер", GetName(playerid), count);
				}
			case 4:
				{
					SCM(playerid, 0xFFCC00AA, "Контейнер содержал: набор оружия");
					if(random(2) == 1)
					{
						GivePlayerWeapon(playerid, 3, 1);
						GivePlayerWeapon(playerid, 23, 100);
						GivePlayerWeapon(playerid, 31, 100);
						GivePlayerWeapon(playerid, 29, 100);
						GivePlayerWeapon(playerid, 34, 100);
					}
					else
					{
						GivePlayerWeapon(playerid, 5, 1);
						GivePlayerWeapon(playerid, 22, 100);
						GivePlayerWeapon(playerid, 30, 100);
						GivePlayerWeapon(playerid, 29, 100);
						GivePlayerWeapon(playerid, 34, 100);
					}
				}
			case 5:
				{
					SCM(playerid, 0xFFCC00AA, "Контейнер содержал: комплект инструментов");
					new newslot;
					if(CheckMaxVes(playerid,48,1,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"У вас нет свободного места в инвентаре!");
					PlayerItem1[playerid][newslot]=48;
					PlayerItem2[playerid][newslot]+=1;
				}
			}
			if(containersInfo[idx][coObject] != INVALID_OBJECT_ID) DestroyDynamicObject(containersInfo[idx][coObject]), containersInfo[idx][coObject] = INVALID_OBJECT_ID;
			if(containersInfo[idx][coLabel] != INVALID_3DTEXT_ID) DestroyDynamic3DTextLabel(containersInfo[idx][coLabel]), containersInfo[idx][coLabel] = INVALID_3DTEXT_ID;
			if(containersInfo[idx][coCheckpoint]) DestroyPickup(containersInfo[idx][coCheckpoint]), containersInfo[idx][coCheckpoint] = 0;
			playerSelectContainer[playerid] = -1;
			playerBuyContainer[playerid] = -1;
		}
		else
		{
			playerSelectContainer[playerid] = -1;
			containersInfo[idx][coBuyerID] = INVALID_PLAYER_ID;
			containersInfo[idx][coTime] = 60;
		}
	}

	if(playerAdminVeh[playerid])
	{
		DestroyVehicle(playerAdminVeh[playerid]);
		Iter_Remove(adm_vehicles, playerAdminVeh[playerid]);
	}
	if(playerReportID[playerid] != -1)
	{
		new i = playerReportID[playerid];
		gReportInfo[i][rIsTooked] = false;
		gReportInfo[i][rID] = i;
		gReportInfo[i][rAnswer] = -1;
		gReportInfo[i][rPlayerID] = -1;
		gReportInfo[i][rText][0] = EOS;
		gReportInfo[i][rWhenWroted_Time] = -1;
		gReportInfo[i][rWhenWroted_Text][0] = EOS;
	}

	if(Mfon[playerid][p_mfon]) Stop_MFon(playerid);
	if(playerGamePubg{playerid}) ExitPubg(playerid);

	if(playerGameDerby{playerid}) ExitDerby(playerid);
	if(playerGameSkyDiving{playerid}) ExitSkyDiving(playerid);

	if(P_FireWork[playerid]) KillTimer(P_FireTimer[playerid]), P_FireWork[playerid] = -1;


	if(playerHookID[playerid] != -1 && GetPlayerInBiz(playerid) != -1 && GetPlayerInBiz(playerid) < MAX_BIZZ)
	{
		new biz = GetPlayerInBiz(playerid),
		hook = playerHookID[playerid];

		for(new idx; idx < 4; idx ++)
		{
			if(HookTableArendators[ biz ][ hook ][ idx ] == playerid)
			{
				HookTableArendators[ biz ][ hook ][ idx ] = INVALID_PLAYER_ID;

				if(GetHookArendators(biz, hook) == 0)
				{
					ClearHookPos(biz, hook);
					SetHookLabel(biz);
				}

				playerHookID[playerid] = -1;
			}
		}
	}

	if(playerSelectHook[playerid] != -1 && GetPlayerInBiz(playerid) != -1) HookTableStatus[ GetPlayerInBiz(playerid) ][ playerSelectHook[playerid] ] = 0, playerSelectHook[playerid] = -1;

	if(PI[playerid][pAdmin])
	{
		mysql_format(db_prod, global_string, 400,"UPDATE admin SET day='%d', timemin='%d', last_ans_text='%s', last_warn_text='%s', last_kick_text='%s', last_ban_text='%s', last_mute_text='%s', last_jail_text='%s' WHERE name='%s'", gettime() + (86400 * 30), AdminInfo[playerid][admTimeMin],AdminInfo[playerid][admAnsText], AdminInfo[playerid][admWarnText], AdminInfo[playerid][admKickText], AdminInfo[playerid][admBanText], AdminInfo[playerid][admMuteText], AdminInfo[playerid][admJailText], GetName(playerid));
		mysql_tquery(db_prod, global_string);
		AdminSaveStats(GetName(playerid));
		fLogs("[admin] %s вышел из игры [%s]", GetName(playerid), PI[playerid][pIP]);
	}
	if(PI[playerid][pAccObject] != INVALID_OBJECT_ID) DestroyPlayerObject(playerid, PI[playerid][pAccObject]), PI[playerid][pAccObject] = INVALID_OBJECT_ID;
	if(PI[playerid][pFamily])family_info [ PI[playerid][pFamily]] [ f_online ]--;
	for(new i=0;i<MAX_LIST+1;i++) PlayerUseList[playerid][i]=0;

	new targetid = PB_GETSLOTPLAYER(playerid);
	if(targetid != -1)
	{
		PBP_PLAYERIDS[targetid] = INVALID_PLAYER_ID;
		PB_KILL[playerid] =
		PB_DEATH[playerid] =
		playerMyasoRubk{playerid} = 0;
	}
	if(obmen_status[playerid])
	{
		new pid = CarPlayer[playerid];
		if(!IsPlayerConnected(pid))
		{
			SendMes(pid, COLOR_RED, "%s отменил свое предложение об обмене", GetName(playerid));
			obcar_status[pid] = 0;
			CarPlayer[pid] = 0;
			CarPrice[pid] = 0;
			my_car_id[pid] = 0;
			cars_id[pid] = 0;
		}
		obmen_status[playerid] = 0;
		CarPlayer[playerid] = 0;
		change_car_time[playerid] = 0;
	}
	if(obcar_status[playerid])
	{
		new pid = CarPlayer[playerid];
		if(!IsPlayerConnected(pid))
		{
			SendMes(pid, COLOR_RED, "%s отклонил ваше предложение об обмене", GetName(playerid));
			obmen_status[pid] = 0;
			CarPlayer[pid] = 0;
			change_car_time[pid] = 0;
		}

		obcar_status[playerid] = 0;
		CarPlayer[playerid] = 0;
		CarPrice[playerid] = 0;
		my_car_id[playerid] = 0;
		cars_id[playerid] = 0;
	}
	if(fights_player_status[playerid])
	{
		for(new idx; idx < 2; idx++)
		{
			if(!strcmp(fights_player[idx], GetName(playerid), true))
			{
				strmid(fights_player[idx], "None", 0, strlen("None"), 5);
				fights_player_status[playerid] = false;
			}
		}
		UpdateFightsText();
		fights_count_players --;
	}
	if(PI[playerid][pLeader]) LeaderSaveStats(playerid);

	DisconnectPlayerVehicle(playerid);

	if(PI[playerid][HelicopterID] != INVALID_VEHICLE_ID) DestroyHelicopter(playerid);
	if(PI[playerid][YachtID] != INVALID_VEHICLE_ID) DestroyYacht(playerid);
	if(arenda_took[playerid])
	{
		new veh = arenda_took[playerid];
		if(veh != INVALID_VEHICLE_ID) DestroyVehicle(veh);
		arenda_took[playerid] = 0;
		check_arenda_moped[playerid] = 0;
	}
	if(InShop[playerid] > 0)
	{
		if(GetPlayerData(playerid, SalonCarID) != INVALID_VEHICLE_ID)
		{
			DestroyVehicle(GetPlayerData(playerid, SalonCarID));
			SetPlayerData(playerid, SalonCarID, INVALID_VEHICLE_ID);
			InShop[playerid] = 0;

			for(new i; i < 2; i++) if(cshop_PTD[playerid][i] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, cshop_PTD[playerid][i]), cshop_PTD[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
			for(new i; i < 17; i++) TextDrawHideForPlayer(playerid, cshop_TD[i]);
			CancelSelectTextDrawEx(playerid);
		}
	}
	if(GotoInfo[playerid][gtGoID] != INVALID_PLAYER_ID)
	{
		CheckPlayerGoCuff(GotoInfo[playerid][gtGoID]), CheckPlayerGoCuff(playerid);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(playerid, 0);
		TogglePlayerControllable(playerid, 1);
		pCuff[playerid][pCuffer] = pCuff[playerid][pCuffee] = INVALID_PLAYER_ID;
	}
	if(GotoInfo[playerid][gtID] != INVALID_PLAYER_ID)
	{
		TogglePlayerControllable(GotoInfo[playerid][gtID],true);
		SendClientMessage(GotoInfo[playerid][gtID],-1,""cPS"Вы были выпущены с конвоя.");
		CheckPlayerGoCuff(GotoInfo[playerid][gtID]);
		SetPlayerSpecialAction(GotoInfo[playerid][gtID], SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(GotoInfo[playerid][gtID], 0);
		pCuff[GotoInfo[playerid][gtID]][pCuffer] = INVALID_PLAYER_ID;
		pCuff[GotoInfo[playerid][gtID]][pCuffee] = INVALID_PLAYER_ID;
	}
	if(pCuff[playerid][pCuffee] != INVALID_PLAYER_ID && reason == 1)
	{
		new id = pCuff[playerid][pCuffee];
		if(id == playerid)
		{
			new cuffer = pCuff[playerid][pCuffer];
			format(string, sizeof(string), "%s вышел при аресте и был посажен в тюрьму на 10 минут", GetName(playerid));
			SendClientMessageToAll(COLOR_RED, string);
			PI[playerid][pJail] = 1;
			PI[playerid][pJailTime] = 600;
			PI[playerid][pWanted] = 0;
			pCuff[cuffer][pCuffer] = INVALID_PLAYER_ID;
			pCuff[cuffer][pCuffee] = INVALID_PLAYER_ID;
			pCuff[playerid][pCuffee] = INVALID_PLAYER_ID;
			pCuff[playerid][pCuffer] = INVALID_PLAYER_ID;
		}
		else if(!IsPlayerConnected(id))
		{
			SetPlayerSpecialAction(id, SPECIAL_ACTION_NONE);
			RemovePlayerAttachedObject(id, 0);
			pCuff[id][pCuffer] = INVALID_PLAYER_ID;
			pCuff[id][pCuffee] = INVALID_PLAYER_ID;
			pCuff[playerid][pCuffee] = INVALID_PLAYER_ID;
			pCuff[playerid][pCuffer] = INVALID_PLAYER_ID;
			SendClientMessage(playerid, COLOR_LIME, "Офицер, надевший на Вас наручники, вышел из игры. Наручники сняты.");
		}
	}
	if(arendkey[playerid] != -1)
	{
		new v = arendkey[playerid];
		if(ArendInfo[v][aPlayerID] == playerid)
		{
			ArendInfo[v][aPlayerID] = INVALID_PLAYER_ID;
			SetVehicleToRespawn(ArendInfo[v][aID]);
			CarDoorsEx(ArendInfo[v][aID], 0);
		}
	}
	if(playerDerbyVehicleID[playerid]) DestroyVehicle(playerDerbyVehicleID[playerid]);

	if(UseGPS[playerid])
	{
		DisablePlayerRaceCheckpoint(playerid);
		UseGPS[playerid] = false;

		if(PI[playerid][pSettingTD][1] == 1)
		{
			for(new i; i < 10; i++) TextDrawHideForPlayer(playerid, gps_td_global[i]);
			for(new i; i < 3; i++)
			{
				if(gps_td_player[i][playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, gps_td_player[i][playerid]), gps_td_player[i][playerid] = PlayerText:INVALID_TEXT_DRAW;
			}
		}
	}
	if(VehNazv[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawHide(playerid,VehNazv[playerid]), VehNazv[playerid] = PlayerText:INVALID_TEXT_DRAW;
	if(VehNazv[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawHide(playerid,VehCost[playerid]), VehCost[playerid] = PlayerText:INVALID_TEXT_DRAW;

	foreach(new i: Player)
	{
		if(GetPlayerState(i) == PLAYER_STATE_SPECTATING && PI[i][Spectating][0] == playerid)
		{
			GameTextForPlayer(i, "PLAYER DISCONNECTED", 3000, 3);
			callcmd::spoff(i, "");
		}
	}
	if(yacht_td_player[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, yacht_td_player[playerid]), yacht_td_player[playerid] = PlayerText:INVALID_TEXT_DRAW;
	if(pubg_td_player[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, pubg_td_player[playerid]), pubg_td_player[playerid] = PlayerText:INVALID_TEXT_DRAW;
	if(td_acessories_player[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, td_acessories_player[playerid]), td_acessories_player[playerid] = PlayerText:INVALID_TEXT_DRAW;
	for(new idx; idx != 4; idx ++) if(rating_td_player[playerid][idx] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, rating_td_player[playerid][idx]), rating_td_player[playerid][idx] = PlayerText:INVALID_TEXT_DRAW;
	if(paint_td_player[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, paint_td_player[playerid]), paint_td_player[playerid] = PlayerText:INVALID_TEXT_DRAW;
	if(bonus_td_player[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, bonus_td_player[playerid]), bonus_td_player[playerid] = PlayerText:INVALID_TEXT_DRAW;
	if(clothes_td_player[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, clothes_td_player[playerid]), clothes_td_player[playerid] = PlayerText:INVALID_TEXT_DRAW;
	if(SelSkin[playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, SelSkin[playerid]), SelSkin[playerid] = PlayerText:INVALID_TEXT_DRAW;
	for(new i; i < 2; i++) if(cshop_PTD[playerid][i] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, cshop_PTD[playerid][i]), cshop_PTD[playerid][i] = PlayerText:INVALID_TEXT_DRAW;

	for(new i = 0; i < 2; i++)
	{
		if(gps_td_player[i][playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, gps_td_player[i][playerid]), gps_td_player[i][playerid] = PlayerText:INVALID_TEXT_DRAW;
		if(TDP_Fuel[playerid][i] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, TDP_Fuel[playerid][i]), TDP_Fuel[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
		if(casino_td_player[i][playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, casino_td_player[i][playerid]), casino_td_player[i][playerid] = PlayerText:INVALID_TEXT_DRAW;

		if(TDP_HOUSE[playerid][i] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, TDP_HOUSE[playerid][i]), TDP_HOUSE[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
	}
	for(new idx; idx < 3; idx++)
	{
		if(reg_PTD[playerid][idx] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, reg_PTD[playerid][idx]), reg_PTD[playerid][idx] = PlayerText:INVALID_TEXT_DRAW;
		if(rob_td_player[idx][playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, rob_td_player[idx][playerid]), rob_td_player[idx][playerid] = PlayerText:INVALID_TEXT_DRAW;
	}
	for(new idx; idx < 4; idx ++) if(td_pasport_player[idx][playerid] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, td_pasport_player[idx][playerid]), td_pasport_player[idx][playerid] = PlayerText:INVALID_TEXT_DRAW;

	for(new idx; idx < 6; idx++)
	{
		if(business_PTD[playerid][idx] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, business_PTD[playerid][idx]), business_PTD[playerid][idx] = PlayerText:INVALID_TEXT_DRAW;
	}
	for(new idx; idx < 2; idx++)
	{
		if(ashop_PTD[playerid][idx] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawDestroy(playerid, ashop_PTD[playerid][idx]), ashop_PTD[playerid][idx] = PlayerText:INVALID_TEXT_DRAW;
	}

	Hide_DonateCarBuy(playerid);
	Speed_Hide_Player(playerid);

	if(!IsPlayerFromThePhone(playerid))
		RPTD_Euro(playerid);

	#if defined TL_VERSION
	KillTimer(g_player_timer[playerid]);
	#endif

	CancelSelectTextDrawEx(playerid);
	SaveAccount(playerid);

	ClearPI(playerid);
	SetPlayerDataToDefault(playerid);
	return 1;
}
