DLG(2511, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::donate(playerid);
	if(PI[playerid][pPerfectCoins] < 1250) return SendClientMessage(playerid, -1, ""cER"У вас недостаточно "SERVER_COINS"");


	PI[playerid][pVip] = VIP_STATE_DIAMOND;
	PI[playerid][pVipTime] = 180;
	PI[playerid][pPerfectCoins] -= 1250;
	format(stringer1, 255, "UPDATE `accounts` SET vip = '%i', vip_time = '%i', credits=%i WHERE id = '%d' LIMIT 1", PI[playerid][pVip], PI[playerid][pVipTime], PI[playerid][pPerfectCoins], PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	SendClientMessage(playerid, 0xFFFF00FF, "Поздравляем Вас с покупкой V.I.P Diamond");
	return 0x1;
}

