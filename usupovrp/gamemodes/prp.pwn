SetPlayerCriminal(playerid, killerid[], reason[])
{
	strmid(PI[playerid][pWantedWho], killerid, 0, strlen(killerid), MAX_PLAYER_NAME);
	strmid(PI[playerid][pWantedReason], reason, 0, strlen(reason), 32);

	mysql_format(db_prod, stringer1, sizeof(stringer1), "UPDATE `accounts` SET zakon=zakon-1, wantedwho='%e', wantedreason='%e' WHERE id=%d", PI[playerid][pWantedWho],PI[playerid][pWantedReason], PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	SendMes(playerid, COLOR_RED, "Вы совершили преступление: %s. Сообщает: %s.", reason, killerid);
	SendMes(playerid, COLOR_RED, "Ваш уровень розыска: %d", PI[playerid][pWanted]);
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(IsACopAndFSB(i)) SendMes(i, 0x3399FFFF, "[SU] %s[%d] совершил преступление: %s. Звезд: %d. Сообщает: %s", GetName(playerid), playerid, reason, PI[playerid][pWanted], killerid);
	}
	PI[playerid][pZakon]--;
	return 1;
}
