cmd:getadmin(playerid, params[])
{
	if(PlayerLogged[playerid] == false) return 1;

	new playername[24], admin_level, type;

	if(sscanf(params, "s[64]ii", playername, admin_level, type))
		return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/getadmin [ник игрока]");

	mysql_format(db_prod, stringer1, sizeof(stringer1), "SELECT * FROM `admin` WHERE `name` = '%s'", playername);
	mysql_tquery(db_prod, stringer1, "SetAdmin", "isii", playerid, playername, admin_level, type);

	return 1;
}

DLG(9245, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		SendErr(playerid, "Вы не ввели код VK-GUARD! Инициирован выход из игры...");
		KickEx(playerid, "vkguard");
		return 1;
	}

	if(playerCode[playerid] != strval(inputtext) || strlen(inputtext) != 6)
	{
		PlayerLogTries[playerid]++;
		if(PlayerLogTries[playerid] == 4)
		{
			SendErr(playerid, "Вы ввели неверный код VK-GUARD слишком много раз! Сервер отключает вас... Для выхода из игры введите: "cWH"/q(uit)");
			return KickEx(playerid, "inv_vkguard");
		}

		format(stringer1, sizeof(stringer1), ""cWH"Вы ввели неверный код VK-GUARD!\n У вас осталось %d попытки.\n Введите код который отослала Вам наша группа в VK:", 3 - PlayerLogTries[playerid]);
		ShowPlayerDialog(playerid, 9245, DSI, ""cMain"VK-Guard - Ошибка", stringer1, "Повтор", "Выйти");
		return 1;
	}


	mysql_format(db_prod, stringer1, sizeof stringer1, "SELECT * FROM `accounts` WHERE `name`='%e'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "OnPlayerLogin", "d", playerid);
	return 1;
}

