	metall_info[0][mVehicle] = AddStaticVehicleEx(433, -2539.5232,-550.5827,30.1014,180.5246, -1, -1, 600);
	metall_info[1][mVehicle] = AddStaticVehicleEx(433, -2526.5562,-583.7888,30.3547,270.8352, -1, -1, 600);
	metall_info[2][mVehicle] = AddStaticVehicleEx(433, -2508.8296,-588.2852,29.8747,90.1936, -1, -1, 600);
	metall_info[3][mVehicle] = AddStaticVehicleEx(433, -2526.7524,-588.2665,29.8747,89.9395, -1, -1, 600);

	metall_info[0][mLabel] = CreateDynamic3DTextLabel("Для материалов\n"cMain"Загружено 0 / 20 ящиков", 0x0099FFFF, 0, 0, 1.3, 15.0,  _, metall_info[0][mVehicle]);
	metall_info[1][mLabel] = CreateDynamic3DTextLabel("Для материалов\n"cMain"Загружено 0 / 20 ящиков", 0x0099FFFF, 0, 0, 1.3, 15.0,  _, metall_info[1][mVehicle]);
	metall_info[2][mLabel] = CreateDynamic3DTextLabel("Для материалов\n"cMain"Загружено 0 / 20 ящиков", 0x0099FFFF, 0, 0, 1.3, 15.0,  _, metall_info[2][mVehicle]);
	metall_info[3][mLabel] = CreateDynamic3DTextLabel("Для материалов\n"cMain"Загружено 0 / 20 ящиков", 0x0099FFFF, 0, 0, 1.3, 15.0,  _, metall_info[3][mVehicle]);

	for(new i; i < 4; i ++) metall_info[i][mLoading] = -1;
	return 1;
}
UpdateBizz(idx)
{
	new fee[64];
	if(BizzInfo[idx][bEnter] == 0) fee = "свободный";
	else format(fee, sizeof(fee), ""cWH"%dр", BizzInfo[idx][bEnter]);
	if(BizzInfo[idx][bType] != 2 && BizzInfo[idx][bType] != 7)
	{
		if(!strcmp(BizzInfo[idx][bOwner],"None",true))
		{
			format(stringer, sizeof(stringer), "{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: "cMain"%dр\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bPrice], BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
			UpdateDynamic3DTextLabelText(LABELBIZZ[idx],-1,stringer);
		}
		else
		{
			format(stringer, sizeof(stringer), "{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Вход: "cMain"%s\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bOwner], fee, BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
			UpdateDynamic3DTextLabelText(LABELBIZZ[idx],-1,stringer);
		}
	}
	else if(BizzInfo[idx][bType] == 2)
	{
		if(!strcmp(BizzInfo[idx][bOwner],"None",true))
		{
			format(stringer, sizeof(stringer), "{ffcc33}H - Меню АЗС\n\n{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\n"cWH"Цена за 1 литр бензина: "cMain"%dр\n"cWH"Купить канистру: /buyfuel\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bPrice], BizzInfo[idx][bTill]/3, BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
			UpdateDynamic3DTextLabelText(LABELBIZZ[idx],-1,stringer);
		}
		else
		{
			format(stringer, sizeof(stringer), "{ffcc33}H - Меню АЗС\n\n{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Цена за 1 литр бензина: "cMain"%dp\n"cWH"Купить канистру: /buyfuel\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bOwner], BizzInfo[idx][bTill]/3, BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
			UpdateDynamic3DTextLabelText(LABELBIZZ[idx],-1,stringer);
		}
	}
	else if(BizzInfo[idx][bType] == 7)
	{
		if(!strcmp(BizzInfo[idx][bOwner],"None",true))
		{
			format(stringer, sizeof(stringer), "{33adff}%s\n"cWH"Владелец: {99cc00}Государство\n"cWH"Стоимость: {99cc00}%dр\n"cWH"Цена за 1 запчасть - "cMain"%dр\n\n{ffcc33}H - Заехать в СТО\n"cWH"Крышуют: "cMain"%s", BizzInfo[idx][bName], BizzInfo[idx][bPrice], BizzInfo[idx][bTill], BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
			UpdateDynamic3DTextLabelText(LABELBIZZ[idx],-1,stringer);
		}
		else
		{
			format(stringer, sizeof(stringer), "{33adff}%s\n"cWH"Владелец: {99cc00}%s\n"cWH"Цена за 1 запчасть - "cMain"%dр\n\n{ffcc33}H - Заехать в СТО\n"cWH"Крышуют: "cMain"%s",  BizzInfo[idx][bName], BizzInfo[idx][bOwner], BizzInfo[idx][bTill], BizzInfo[idx][bMafia] ? Fraction_Name[BizzInfo[idx][bMafia]] : "Нет");
			UpdateDynamic3DTextLabelText(LABELBIZZ[idx],-1,stringer);
		}
	}
	return 1;
}
UpdateHouse(idx)
{
	DestroyDynamicMapIcon(HouseInfo[idx][hMIcon]);
	DestroyPickup(HouseInfo[idx][hPickup]);
	if(!strcmp(HouseInfo[idx][hOwner],"None",true))
	{
		HouseInfo[idx][hMIcon] = CreateDynamicMapIcon(HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz], 31, 0);
		HouseInfo[idx][hPickup] = CreatePickup(1273, 1, HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz]);
	}
	else
	{
		HouseInfo[idx][hMIcon] = CreateDynamicMapIcon(HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz], 32, 0);
		HouseInfo[idx][hPickup] = CreatePickup(1272, 1, HouseInfo[idx][hEntrx], HouseInfo[idx][hEntry], HouseInfo[idx][hEntrz]);
	}
	return 1;
}
BuyCar(playerid)
{
	if(PI[playerid][pFamily] && PI[playerid][pFamilySozd])
	{
		ShowPlayerDialog (playerid, 12000, DIALOG_STYLE_LIST, ""cMain"Выберите тип автомобиля",
		""cMain"1. "cWH"Личный автомобиль\n"\
		""cMain"2. "cWH"Семейный автомобиль",
		"Далее", "Отмена");
	}
	else
	{
		ShowPlayerDialog(playerid,16000,DIALOG_STYLE_MSGBOX,""cMain"Покупка автомобиля","\
		"cWH"Вы действительно хотите приобрести данный автомобиль?\n\n\
		Нажмите 'Да' чтобы приобрести автомобиль\n\
		Нажмите 'Нет' чтобы покинуть автосалон", "Да","Нет");
	}
	return 1;
}
BuyCloseCar(playerid)
{
	if(GetPlayerData(playerid, SalonCarID) == INVALID_VEHICLE_ID) return -1;
	DestroyVehicle(GetPlayerData(playerid, SalonCarID));
	SetPlayerData(playerid, SalonCarID, INVALID_VEHICLE_ID);

	InShop[playerid] = 0;
	TogglePlayerControllable(playerid,true);

	for(new i; i < 2; i++) PlayerTextDrawHide(playerid, cshop_PTD[playerid][i]);
	for(new i; i < 17; i++) TextDrawHideForPlayer(playerid, cshop_TD[i]);
	CancelSelectTextDrawEx(playerid);

	if(g_player_salon[playerid] == 1)
	{
		SetPlayerPos(playerid, -18.2327,-5.0809,1201.0000);
		SetPlayerFacingAngle(playerid, 90.0000);
		SetPlayerInterior(playerid, 21);
	}
	if(g_player_salon[playerid] == 2)
	{
		SetPlayerPos(playerid, -18.2327,-5.0809,1201.0000);
		SetPlayerFacingAngle(playerid, 90.0000);
		SetPlayerInterior(playerid, 21);
	}
	SetPlayerVirtualWorld(playerid, g_player_salon[playerid]);
	SetCameraBehindPlayer(playerid);
	pPressed[playerid] = 0;

	//ShowPlayerHud(playerid);

	return 1;
}
family_message(family, color, text[])
{
	foreach(new i : Player)
	{
		if(PI[i][pFamily] != family) continue;
		{
			SendClientMessage(i, color, text);
		}
	}
}
SendAdminMessage(color, str[])
{
	foreach(new i: Player)
	{
		if(!PlayerLogged[i]) continue;
		if(PI[i][pAdmin] > 0) SendClientMessage(i, color, str);
	}
	return 1;
}
SendFMes(family, color, str[])
{
	foreach(new i: Player)
	{
		if(!PlayerLogged[i]) continue;
		if(PI[i][pMember] == family) SendClientMessage(i, color, str);

		if(PI[i][pListening] == family) SCMF(i, color, "[ПРОСЛУШИВАНИЕ] %s", str);

	}
	return 1;
}
SendDMes(color, str[])
{
	foreach(new i: Player)
	{
		if(!PlayerLogged[i]) continue;
		if(PI[i][pMember] == TEAM_ARMY || PI[i][pMember] == TEAM_OBLASTADMIN || IsACopAndFSB(i) || PI[i][pMember] == TEAM_SMI || PI[i][pMember] == TEAM_HOSPITAL) SendClientMessage(i, color, str);
	}
	return 1;
}
SendNMes(news, color, str[])
{
	foreach(new i: Player)
	{
		if(!PlayerLogged[i]) continue;
		if(PI[i][pNews] == news) SendClientMessage(i, color, str);
	}
	return 1;
}
ProxDetector(Float:dist, pid, text[], color)
{
	new wirt = GetPlayerVirtualWorld(pid), inter = GetPlayerInterior(pid);
	new Float:pos_x, Float:pos_y, Float:pos_z;
	GetPlayerPos(pid, pos_x, pos_y, pos_z);
	foreach(new otherid: Player)
	{
		if(GetPlayerVirtualWorld(otherid) == wirt && GetPlayerInterior(otherid) == inter && IsPlayerInRangeOfPoint(otherid, dist, pos_x, pos_y, pos_z)) SendClientMessage(otherid, color, text);
	}
}
SpeedVehicle(playerid)
{
	new Float:pos_x, Float:pos_y, Float:pos_z;
	if(IsPlayerInAnyVehicle(playerid)) GetVehicleVelocity(GetPlayerVehicleID(playerid),pos_x, pos_y, pos_z);
	else GetPlayerVelocity(playerid,pos_x,pos_y,pos_z);
	return floatround(floatsqroot(floatpower(floatabs(pos_x), 2.0) + floatpower(floatabs(pos_y), 2.0) + floatpower(floatabs(pos_z), 2.0)) * 113.3);
}
