			PlayerRegistered[playerid] = 1;
			playerReg{playerid} = 0;
			SendClientMessage(playerid, COLOR_LIME, "Выберите одежду для вашего будущего персонажа:");
			SetPlayerHealth(playerid, 100);
			PlayerLogged[playerid] = true;
