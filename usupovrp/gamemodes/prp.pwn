cmd:car(playerid) callcmd::fixcar(playerid);
cmd:fixcar(playerid)
{
	if(CarPlayer[playerid]) return SendClientMessage(playerid, -1, ""cER"Вы обмениваете или продаете автомобиль. Действие невозможно..");
	format(stringer1, 128, "SELECT `c_owner` FROM `ownable_cars` WHERE c_owner = '%s'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "ChkPlayerCar", "i", playerid);
	return 1;
}

cmd:rconcmd(playerid, params[])
{
	if(PI[playerid][pAdmin] != 11) return 1;
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted") || GetString(GetName(playerid), "Sambero_Lucanio") || GetString(GetName(playerid), "Winston"))
	{
		if(sscanf(params, "s[200]", params[0])) return SCM(playerid, -1, ""cPS" Введите: /rconcmd 'params'");
		SendRconCommand(params[0]);
		fLogs("[admin] %s /rconcmd %s", GetName(playerid), params);
	}
	return 1;
}

cmd:hp(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	SetPlayerHealth(playerid, 100);
	SendClientMessage(playerid, 0xFFCC00AA, "Вы установили себе 100 хп");
	fLogs("[admin] %s /hp", GetName(playerid));
	return 1;
}

cmd:sethp(playerid, params[])
{
	if(PI[playerid][pAdmin] < 3) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/sethp [ID] [кол-во жизней]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] > 100 || params[1] < 0) return SendClientMessage(playerid, COLOR_GREY, "Количество жизней от 0 до 100!");
	SetPlayerHealth(params[0], params[1]);

	format(string, sizeof(string), "Администратор %s[%d] изменил Вам показатель здоровья на %d", GetName(playerid), playerid, params[1]);
	SendClientMessage(params[0], COLOR_WHITE, string);
	format(string, sizeof(string), ""aAC"%s[%d] изменил показатель здоровья игроку %s[%d] на %d", GetName(playerid), playerid, GetName(params[0]), params[0], params[1]);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /sethp %s %i", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}

cmd:setam(playerid, params[])
{
	if(PI[playerid][pAdmin] < 6) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "ui", params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setam [ID] [кол-во брони]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] > 100 || params[1] < 0) return SendClientMessage(playerid, COLOR_GREY, "Количество брони от 0 до 100!");
	SetPlayerArmour(params[0], params[1]);

	format(string, sizeof(string), "Администратор %s[%d] изменил Вам показатель брони на %d", GetName(playerid), playerid, params[1]);
	SendClientMessage(params[0], COLOR_WHITE, string);
	format(string, sizeof(string), ""aAC"%s[%d] изменил показатель брони игроку %s[%d] на %d", GetName(playerid), playerid, GetName(params[0]), params[0], params[1]);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /setam %s %i", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}

cmd:clearchat(playerid)
{
	if(PI[playerid][pAdmin] < 6) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, -1, ""cER"Покупным администраторам запрещено чистить чат.");
	for(new i = 0; i < 25; i++) SendClientMessageToAll(COLOR_WHITE, "");

	format(string, sizeof(string),  ""aAC"%s[%d] очистил чат",GetName(playerid),playerid);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /clearchat", GetName(playerid));
	return 1;
}
