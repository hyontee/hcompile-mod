#define DLG(%0,%1,%2,%3,%4) 	forward dia_%0(%1,%2,%3,%4); public dia_%0(%1,%2,%3,%4)

static gString1[12];
new dl_playerDialogID[MAX_PLAYERS];

stock dialogs_ShowPlayerDialog(playerid, dialogid, style, caption[], info[], button1[], button2[])
{
	if(!IsPlayerConnected(playerid)) return 0;
	if(dialogid == 0 || dialogid == 65535) dl_playerDialogID[playerid] = -1;
	else
	{
		dl_playerDialogID[playerid] = dialogid;
		CancelSelectTextDraw(playerid);
	}
	return ShowPlayerDialog(playerid, 0, style, caption, info, button1, button2);
}

#define ShowPlayerDialog dialogs_ShowPlayerDialog

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if(!IsPlayerConnected(playerid)) return 1;

	for(new id = (strlen(inputtext) - 1); id >= 0; id--) { if(inputtext[id] == '%') inputtext[id] = '#'; }

	if(strfind(inputtext, "~k~" ) != -1)
	{
		SendClientMessage(playerid, -1, "У ТЕБЯ МАТЬ ШЛЮХА ДОЛБАЕБ ПОШЕЛ НАХУЙ =)");
		return Kick(playerid);
	}

	if(dl_playerDialogID[playerid] != -1)
	{
		format(gString1, sizeof(gString1), "dia_%i", dl_playerDialogID[playerid]);
		dl_playerDialogID[playerid] = -1;
		if(gSelectColor[playerid] != EOS) SelectTextDraw(playerid,gSelectColor[playerid]);

		CallLocalFunction(gString1, "iiis", playerid, response, listitem, isnull(inputtext) ? ("\1") : inputtext);
	}
	return 1;
}
