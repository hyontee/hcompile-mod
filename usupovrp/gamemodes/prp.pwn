cmd:resetmoney(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PI[playerid][pAdmin] < 11) return 1;
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "ud", params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/resetmoney [id игрока] [1 - наличка 2 - банковский счет]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(params[1] == 1)
		{
			SetPlayerMoney(params[0], -GetPlayerRubble(params[0]));
			SendMes(playerid, COLOR_LIME, "Вы сбросили наличку игроку %s", GetName(params[0]));
		}
		else if(params[1] == 2)
		{
			new accountid = PI[ params[0] ][pMainBankAccount];
			if(!IsValidBankAccount(playerid, accountid))
			return SendClientMessage(playerid, COLOR_RED, "У этого игрока не установлен основной банкоский счёт");

			g_player_bank_accounts[ params[0] ][ PI[ params[0] ][pMainBankAccount] ][B_BALANCE] = 0;
			SendMes(playerid, COLOR_LIME, "Вы сбросили банковский счет игроку %s", GetName(params[0]));

			SendBankAccountLog(params[0], GetPlayerBankAccountData(params[0], accountid, B_ID), "- Сброс счета");

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(params[0], accountid, B_BALANCE), GetPlayerBankAccountData(params[0], accountid, B_ID));
			mysql_tquery(db_prod, STRING_GLOBAL);

			UpdateBankMoneyText(playerid, accountid);
		}
		fLogs("[admin] %s /resetmoney %s %i", GetName(playerid), GetName(params[0]), params[1]);
	}
	return 1;
}

cmd:slap(playerid, params[])
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/slap [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(g_player_in_event[params[0]]) return SendClientMessage(playerid, COLOR_RED, "Этот игрок участвует в мероприятии");
	if(PI[playerid][pBuyAdmin]) return SCM(playerid, -1, "Покупным  администраторам недоступна эта команда");

	new Float:shealth,Float:slx, Float:sly, Float:slz;
	GetPlayerHealth(params[0], shealth);
	SetPlayerHealth(params[0], shealth-5);
	GetPlayerPos(params[0], slx, sly, slz);
	SetPlayerPos(params[0], slx, sly, slz+5);

	format(string, sizeof(string), "[A] %s[%d] подкинул игрока %s[%d]", GetName(playerid), playerid, GetName(params[0]), params[0]);
	SendAdminMessage(COLOR_GREY, string);
	format(string, sizeof(string), "Администратор %s[%d] подкинул Вас", GetName(playerid), playerid);
	SendClientMessage(params[0], -1, string);
	fLogs("[admin] %s /slap %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:alogin(playerid, params[])
{
	if(AdminLogged[playerid]) return SendClientMessage(playerid, -1, ""cER"Вы уже авторизовались как администратор!");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `admin` WHERE `name` = '%e'", GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "Alogin", "i", playerid);
	return 1;
}

cmd:setsex(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/setsex [id игрока]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	switch(PI[params[0]][pSex])
	{
	case 1:
		{
			format(string, sizeof(string), "Вы изменили пол игроку %s на женский", GetName(params[0]));
			SendClientMessage(playerid, COLOR_LIME, string);
			SendClientMessage(params[0], COLOR_LIME, "Администратор изменил ваш пол на женский");
			PI[params[0]][pSex] = 2;
		}
	case 2:
		{
			format(string, sizeof(string), "Вы изменили пол игроку %s на мужской",GetName(params[0]));
			SendClientMessage(playerid, COLOR_LIME, string);
			SendClientMessage(params[0], COLOR_LIME, "Администратор изменил ваш пол на мужской");
			PI[params[0]][pSex] = 1;
		}
	}
	fLogs("[admin] %s /setsex %s", GetName(playerid), GetName(params[0]));
	return 1;
}

cmd:skin(playerid, params[])
{
	if(PI[playerid][pAdmin] < 4) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "ii", params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/skin [id игрока] [id внешности]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] > 20000 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "Неверный id внешности. Можно установить от 1 до 20000");

	SetPlayerSkin(params[0], params[1]);
	format(string, sizeof(string), "Администратор %s выдал Вам временный скин", GetName(playerid));
	SendClientMessage(params[0], COLOR_LIME, string);
	format(string, sizeof(string), "Вы выдали временный скин [%d] игроку %s", params[1], GetName(params[0]));
	SendClientMessage(playerid, COLOR_LIME, string);
	format(string, sizeof(string), ""aAC"%s[%d] выдал временный скин %s[%d] (%d)", GetName(playerid), playerid, GetName(params[0]), params[0], params[1]);
	SendAdminMessage(COLOR_GREY, string);
	fLogs("[admin] %s /setskin %s %i", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}
alias:skin("setskin");

cmd:asetskin(playerid, params[])
{
	if(!g_player_full_access[playerid]) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "ui", params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/asetskin [id игрока] [id внешности]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] > 299 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "Неверный id внешности. Можно установить от 1 до 299");

	if(PI[params[0]][pMember])
	{
		PI[params[0]][pMemberSkin] = params[1];
		SetPlayerSkin(params[0], PI[params[0]][pMemberSkin]);
		MysqlUpdatePlayerInt(params[0], "memberskin", PI[params[0]][pMemberSkin]);
	}
	else
	{
		PI[params[0]][pModel] = params[1];
		SetPlayerSkin(params[0], PI[params[0]][pModel]);
		MysqlUpdatePlayerInt(params[0], "model", PI[params[0]][pModel]);
		fLogs("[skin] %s /asetskin [%i]", GetName(params[0]), params[1]);
	}
	format(string, sizeof(string), "Администратор %s выдал Вам статический скин", GetName(playerid));
	SendClientMessage(params[0], COLOR_LIME, string);
	format(string, sizeof(string), "Вы выдали статический скин [%d] игроку %s", params[1], GetName(params[0]));
	SendClientMessage(playerid, COLOR_LIME, string);
	fLogs("[admin] %s /asetskin %s %i", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}
cmd:exit(playerid, params[])
{
	new a = GetPlayerInHouse(playerid);
	if(a != -1 && PlayerToPoint(3.0, playerid, HouseInfo[a][hExitx], HouseInfo[a][hExity], HouseInfo[a][hExitz]) && GetPlayerVirtualWorld(playerid) == HouseInfo[a][hVirtual])
	{
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);

		SetPlayerPos(playerid, HouseInfo[a][hEntrx], HouseInfo[a][hEntry], HouseInfo[a][hEntrz]);
		PI[playerid][pInHouse] = -1;
		return 1;
	}
	if(GetPlayerArend(playerid) != 0)
	{
		if(PlayerToPoint(3.0, playerid, HouseInfo[GetPlayerArend(playerid)][hExitx], HouseInfo[GetPlayerArend(playerid)][hExity], HouseInfo[GetPlayerArend(playerid)][hExitz]) && GetPlayerVirtualWorld(playerid) == HouseInfo[GetPlayerArend(playerid)][hVirtual])
		{
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);

			SetPlayerPos(playerid, HouseInfo[GetPlayerArend(playerid)][hEntrx], HouseInfo[GetPlayerArend(playerid)][hEntry], HouseInfo[GetPlayerArend(playerid)][hEntrz]);
			PI[playerid][pInHouse] = -1;
			return 1;
		}
	}
	if(PI[playerid][pFamily] && family_info[PI[playerid][pFamily]][f_spawn])
	{
		new hid = CREATOR_HOUSE_ID[playerid];
		if(hid == -1) return SendClientMessage(playerid,COLOR_RED,"Произошла системная ошибка -1 exit");
		if(PlayerToPoint(3.0, playerid, HouseInfo[hid][hExitx], HouseInfo[hid][hExity], HouseInfo[hid][hExitz]) && GetPlayerVirtualWorld(playerid) == family_info[PI[playerid][pFamily]][f_world])
		{
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);

			SetPlayerPos(playerid, HouseInfo[hid][hEntrx], HouseInfo[hid][hEntry], HouseInfo[hid][hEntrz]);
			PI[playerid][pInHouse] = -1;
		}
	}
	return 1;
}

cmd:smoke(playerid)
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	new ok = SearchInventoryItem(playerid, 46);
	if(ok==0){return SendClientMessage(playerid, -1, ""cER"У вас нет сигарет, купите их в супермаркете или 24/7!");}
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_SMOKE_CIGGY);
	if(PlayerItem2[playerid][ok] == 0)
	{
		PlayerItem1[playerid][ok]=0;
	}
	PlayerItem2[playerid][ok]--;
	SaveItem(playerid,ok);

	new Float:amount;
	GetPlayerHealth(playerid, amount);
	if(amount <= 97) GiveHealth(playerid, 3);
	else SetPlayerHealth(playerid, 100);
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
	if(PI[playerid][pSex] == 1) MeAction(playerid, "достал сигарету и закурил её");
	else MeAction(playerid, "достала сигарету и закурила её");
	return 1;
}

cmd:fuel(playerid)
{
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находится в транспорте!");
	new ok = SearchInventoryItem(playerid, 49);
	if(ok==0){return SendClientMessage(playerid, COLOR_GREY, "У вас нет канистры, купите её на заправочной станции!");}
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться за рулем транспорт!");
	if(Fuel[GetPlayerVehicleID(playerid)] >= 35) return SendClientMessage(playerid, COLOR_GREY, "В баке есть бензин!");
	Fuel[GetPlayerVehicleID(playerid)] += 10;
	if(PlayerItem2[playerid][ok] == 0)
	{
		PlayerItem1[playerid][ok]=0;
	}
	PlayerItem2[playerid][ok]--;
	SaveItem(playerid,ok);
	if(PI[playerid][pSex] == 1) MeAction(playerid, "достал канистру и заливает бензин в бак машины");
	else MeAction(playerid, "достала канистру и заливает бензин в бак машины");
	return 1;
}

cmd:tools(playerid)
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться в транспорте!");
	new ok = SearchInventoryItem(playerid, 48);
	if(ok==0){return SendClientMessage(playerid, -1, ""cER"У вас нет набора инструментов, купите его на заправочной станции!");}
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, -1, ""cPS"Вы должны находиться за рулем транспорт!");
	RepairVehicle(GetPlayerVehicleID(playerid));
	if(PlayerItem2[playerid][ok] == 0)
	{
		PlayerItem1[playerid][ok]=0;
	}
	PlayerItem2[playerid][ok]--;
	SaveItem(playerid,ok);
	if(PI[playerid][pSex] == 1) MeAction(playerid, "достал инструменты и ремонтирует машину");
	else MeAction(playerid, "достала инструменты и ремонтирует машину");
	return 1;
}

cmd:mask(playerid)
{
	new ok = SearchInventoryItem(playerid, 45);
	if(ok==0){return SendClientMessage(playerid, -1, ""cER"У вас нет маски, купите их в супермаркете или 24/7!");}
	if(!PlayerUseMask[playerid])
	{
		SetPlayerColor(playerid, 0x00000000);
		PlayerUseMask[playerid] = true;
		if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid, "SHOP", "ROB_Shifty", 4.1, 0, 0, 0, 0, 0);
		SendClientMessage(playerid, COLOR_YELLOW, "Ваше местоположение на GPS "cWH"скрыто");
		SetPlayerChatBubble(playerid, "одевает маску", COLOR_ORANGE, 20.0, 500);
		GameTextForPlayer(playerid, "~b~INVISABLE ON", 800, 4);
		MeAction(playerid, "одевает маску");
	}
	else
	{
		CheckPlayerSkin(playerid);
		PlayerUseMask[playerid] = false;
		GameTextForPlayer(playerid, "~y~INVISABLE OFF", 800, 4);
		MeAction(playerid, "снимает маску");
		SetPlayerChatBubble(playerid, "снимает маску", -1, 20.0, 500);
	}
	return 1;
}

cmd:healme(playerid, params[])
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	if(PI[playerid][pAptechka] == 0) return SendClientMessage(playerid, COLOR_GREY,"У вас нет аптечек, купите их в супермаркете или 24/7!");
	new Float:shealth;
	GetPlayerHealth(playerid, shealth);
	if(shealth >= 100) return SendClientMessage(playerid, COLOR_GREY, "Твое здоровье вполне в хорошем состоянии!");
	SetPlayerHealth(playerid, shealth+40);
	GetPlayerHealth(playerid, shealth);
	if(shealth > 100) SetPlayerHealth(playerid, 100);
	PI[playerid][pAptechka]--;
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET aptechka=aptechka-1 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"ped","gum_eat",4.0,0,0,0,0,0,1);
	if(PI[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"использовал аптечку",COLOR_PURPLE,30.0,1000);
	else SetPlayerChatBubble(playerid,"использовала аптечку",COLOR_PURPLE,30.0,1000);
	GameTextForPlayer(playerid, "~b~+40 HP", 100, 1);
	return 1;
}

cmd:jtime(playerid)
{
	if(!PI[playerid][pJail]) return 1;
	format(string, sizeof string, "Вам осталось сидеть в тюрьме: {F97F37}%d минут", PI[playerid][pJailTime]/60);
	SendClientMessage(playerid, 0x63B637FF, string);
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"COP_AMBIENT","Coplook_watch",4.1,0,0,0,0,0,1);
	if(PI[playerid][pSex] == 1) MeAction(playerid, "посмотрел на часы");
	else MeAction(playerid, "посмотрела на часы");
	return true;
}

cmd:time(playerid)
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "На мероприятии нельзя использовать");
	if(freeze_time[playerid] > unix)
	return SendClientMessage(playerid, COLOR_RED, "Пользоваться командой /time можно раз в 10 секунд");

	new saturday = 1310155200, w = unix, day_week;
	while(w - saturday > 60 * 60 * 24)
	{
		w -= 60 * 60 * 24;
		day_week ++;
	}
	while(day_week >= 7) day_week -= 7;

	static const Names_Months[12][12] = {"января","февраля","марта","апреля","мая","июня","июля","августа","сентября","октября","ноября","декабря"};
	static const Names_Days[7][12] = {"суббота","воскресенье","понедельник","вторник","среда","четверг","пятница"};

	format(string, sizeof(string), "\
	"cWH"Точное время: "cMain"%d:%02d\n\
	"cWH"Сегодняшняя дата: "cMain"%s, %d %s %04d г.\n\n\
	"cWH"Отыграно за час: {FFFF00}%d мин\
	", hour, minute, Names_Days[day_week], day, Names_Months[month-1], year, PI[playerid][pCheckTime]/60);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"Часы", string, "Закрыть", "");
	format(string, sizeof(string), "~y~%02d:%02d~n~~w~%02d.%02d.%04d", hour, minute, day, month, year);
	GameTextForPlayer(playerid, string, 5000, 1);

	if(PI[playerid][pJailTime] != 0)
	{
		new fmt_str[70];
		format(fmt_str, sizeof(fmt_str),""cWH"Время до выхода на свободу: {FF6600}%s",ConvertSeconds(PI[playerid][pJailTime]));
		SendClientMessage(playerid, COLOR_GREEN, fmt_str);
	}

	if(PI[playerid][pMuted] != 0)
	{
		new fmt_str[70];
		format(fmt_str, sizeof(fmt_str),""cWH"Время до окончания затычки {FF6600}%s",ConvertSeconds(PI[playerid][pMuted]));
		SendClientMessage(playerid, COLOR_GREEN, fmt_str);
	}

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"COP_AMBIENT","Coplook_watch",4.1,0,0,0,0,0,1);
	if(PI[playerid][pSex] == 1) MeAction(playerid, "посмотрел на часы");
	else MeAction(playerid, "посмотрела на часы");
	freeze_time[playerid] = unix + 10;
	return 1;
}


