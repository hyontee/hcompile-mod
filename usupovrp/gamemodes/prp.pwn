{
	if(!response) return callcmd::family(playerid);
	new count = strval(inputtext), f = PI[playerid][pFamily];
	if(null(inputtext) || !isNumeric(inputtext)) return 1;
	if(GetPlayerRubble(playerid) < count) return SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно средств");
	if(count < 1 || count > 10000000) return SendClientMessage(playerid, COLOR_RED, "Количество денег от 1 до 10.000.000 руб");
	if(!PI[playerid][pFamilySozd] || PI[playerid][pFamilyZam] && (count > 1000000)) return SendClientMessage(playerid, COLOR_RED, "Обычным членам семьи за раз нельзя класть более 1кк валюты. Лидерам и заместителям без лимита");
	if((family_info[f][f_money] + count) > 20000000) return SendClientMessage(playerid, COLOR_RED, "Общак переполнен! В него можно положить только до 20.000.000 руб");
