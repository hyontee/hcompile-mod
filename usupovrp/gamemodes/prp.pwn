	format(string, sizeof(string), ""cWH"ФК ЦСКА\t| %s\nФК Спартак\t| %s",
	(b_Capture{0} ? ("{F04245}Запрет включен"cWH"") : ("{63BD4E}Запрет выключен"cWH"")),
	(b_Capture{1} ? ("{F04245}Запрет включен"cWH"") : ("{63BD4E}Запрет выключен"cWH"")));
	ShowPlayerDialog(playerid, 969, DIALOG_STYLE_LIST, ""cMain"Управление каптами", string, "Изменить", "Отмена");
	return 1;
}

callback::OnPlayerChangeDonateName(playerid, nickname[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		SendClientMessage(playerid, COLOR_GREY, "Этот никнейм уже используется");
		return ShowPlayerDialog(playerid, 131+179, 1, ""cMain"Смена ника", ""cWH"Введите будущий ник:", "Принять", "Назад");
	}
	if(GetPlayerHouse(playerid))
	{
		new i = GetPlayerHouse(playerid);
		if(!strcmp(HouseInfo[i][hOwner],GetName(playerid),true))
		{
			nstrmid(HouseInfo[i][hOwner], nickname);
			MysqlUpdateHouseStr(i, "hOwner", nickname);
		}
	}
	if(GetPlayerRooms(playerid))
	{
		new i = GetPlayerRooms(playerid);
		if(!strcmp(RoomsInfo[i][rOwner],GetName(playerid),true))
		{
			nstrmid(RoomsInfo[i][rOwner], nickname);
			mysql_format(db_prod, stringer1, 128, "UPDATE `rooms` SET rOwner = '%e' WHERE id = '%d' LIMIT 1", RoomsInfo[i][rOwner], i);
			mysql_tquery(db_prod, stringer1, "", "");
		}
	}
	if(GetPlayerBizz(playerid))
	{
		new i = GetPlayerBizz(playerid);
		if(!strcmp(BizzInfo[i][bOwner],GetName(playerid),true))
		{
			nstrmid(BizzInfo[i][bOwner], nickname);
			MysqlUpdateBizzStr(i, "owner", nickname);
			UpdateBizz(i);
		}
	}
	if(GetPlayerGarage(playerid) != -1)
	{
		new g = GetPlayerGarage(playerid);
		strmid(GarageInfo[g][g_OWNER], nickname, 0, strlen(nickname), 24);
		SaveGarageData(g);
		UpdateGarageData(g);
	}
	if(PI[playerid][pFamilySozd] != 0)
	{
		if(!strcmp(family_info [PI[playerid][pFamily]] [f_creator],GetName(playerid),true))
		{
			nstrmid(family_info [PI[playerid][pFamily]] [f_creator] , nickname);
			mysql_format(db_prod, stringer1, 128, "UPDATE `family_system` SET `fam_creator` = '%e' WHERE `fam_id` = '%d'", family_info [PI[playerid][pFamily]] [f_creator], PI[playerid][pFamily]);
			mysql_function_query ( db_prod, stringer1, false, "", "");
		}
	}

	format(stringer1, sizeof(stringer1), "SELECT * FROM `admin` WHERE `name` = '%s'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "CheckChangeNameAdmin", "ss", GetName(playerid), nickname);
	mysql_format(db_prod, stringer1, 128, "UPDATE `inventory` SET `Name` = '%e' WHERE `Name` = '%s'", nickname, GetName(playerid));
	mysql_tquery(db_prod, stringer1, "","");

	mysql_format(db_prod, stringer1, 128, "UPDATE `ownable_cars` SET c_owner = '%e' WHERE c_owner = '%s'", nickname, GetName(playerid));
	mysql_tquery(db_prod, stringer1, "", "");
	mysql_format(db_prod, stringer1, 128, "UPDATE `helicopters` SET h_owner = '%e' WHERE h_owner = '%s'", nickname, GetName(playerid));
	mysql_tquery(db_prod, stringer1, "", "");
	mysql_format(db_prod, stringer1, 128, "UPDATE `yacht` SET y_owner = '%e' WHERE y_owner = '%s'", nickname, GetName(playerid));
	mysql_tquery(db_prod, stringer1, "", "");
	mysql_format(db_prod, stringer1, 144, "UPDATE `accounts` SET name='%e',credits=%d WHERE name='%s'", nickname, PI[playerid][pPerfectCoins]-60, GetName(playerid));
	mysql_tquery(db_prod, stringer1, "", "");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `historyname` (`idacca`, `Name`, `old_name`, `allowed`, `date`) VALUE ('%d', '%e', '%e', 'Donate System', NOW())", PI[playerid][pID], nickname, GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");

	format(stringer1, sizeof(stringer1), "[Смена ника] %s изменил имя на %s", GetName(playerid), nickname);
	SendClientMessageToAll(COLOR_ORANGE, stringer1);

	PI[playerid][pPerfectCoins] -= 60;
	fLogs("[coin] %s -60 донат ник [%s]", GetName(playerid), nickname);

	SendMes(playerid, COLOR_GREEN, "Ваше новое имя: "cWH"%s", nickname);
	SendClientMessage(playerid, COLOR_GREEN, "Обязательно нужно сделать скриншот. Клавиша: "cWH"F8");
	SendClientMessage(playerid, COLOR_GREEN, "Пропишите свой новый ник в окне "cWH"CR:MP");
	KickEx(playerid, "change nick");
	return 1;
}

callback::CheckChangeNameAdmin(name[], newname[])
{
	if(cache_num_rows())
	{
		mysql_format(db_prod, stringer1, 128, "UPDATE `admin` SET name='%e' WHERE name='%s'", newname, name);
		mysql_tquery(db_prod, stringer1);
	}
}

callback::OnPlayerSetPhoneNumber(playerid, number)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(GetPlayerRubble(playerid) < 3000) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
	if(rows)
	{
		SendClientMessage(playerid, COLOR_GREY, "Такой номер уже используется");
		ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_INPUT, ""cMain"Покупка SIM-карты", ""cWH"Введите новый шестизначный номер", "Купить", "Закрыть");
		return 1;
	}
	PI[playerid][pPhoneNumber] = number;
	SCMF(playerid, -1, ""cDA"Вы купили SIM-карту. Ваш номер: "cWH"%d", PI[playerid][pPhoneNumber]);

	SetPlayerMoney(playerid, -3000);
	MysqlUpdatePlayerInt(playerid, "phonenumber", PI[playerid][pPhoneNumber]);
	return 1;
}

callback::MysqlCheckPhoneNumber(playerid, telephone)
{
	if(cache_get_row_count(db_prod) > 0) return SendClientMessage(playerid, -1, ""cER"Произошла ошибка при покупке SIM-карты, попробуйте еще раз!");
	new num;
	foreach(new i: Player)
	{
		if((PI[i][pPhoneNumber] == telephone) && (i != playerid))
		{
			SendClientMessage(playerid, -1, ""cER"Произошла ошибка при покупке SIM-карты, попробуйте еще раз!");
			num++;
			break;
		}
	}
	if(num == 0)
	{
		PI[playerid][pPhoneNumber] = telephone;
		SendMes(playerid, -1, ""cDA"Вы купили мобильный телефон. Ваш номер: "cWH"%d", telephone);
		MysqlUpdatePlayerInt(playerid, "phonenumber", PI[playerid][pPhoneNumber]);
		new price = gShopCosts[0];
		new i = GetPlayerInBiz(playerid);

		SetPlayerMoney(playerid, -price);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzInfo[i][bMoney] += price;
			BizzPay[i] += price;
			BizzInfo[i][bProduct] -= gShopProd[0];
			MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
			MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
		}
		MagazineList(playerid);
	}
	return 1;
}

callback::OfflineMembersOfFamily(playerid)
{
