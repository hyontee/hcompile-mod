	return true;
}
DLG(24, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new idx = PlayerHouseSelect[playerid];

	if(!strcmp(HouseInfo[idx][hOwner], "None", true))
	{
		new price_house = GetReasonMoneyPercentVip(playerid, TYPE_VIP_HOUSE, HouseInfo[idx][hPrice]);
		if(HouseInfo[idx][hType] == 0)
		{
			if(PI[playerid][pCash] < price_house) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
			if(GetPlayerHouse(playerid)) return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом!");
			if(GetPlayerRooms(playerid)) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира!");

			SetPlayerMoney(playerid, -price_house);
			HouseInfo[idx][hBuyPrice] = HouseInfo[idx][hPrice]/2;
			HouseInfo[idx][hOplata] = 1;
			HouseInfo[idx][hLock] = 1;
			HouseInfo[idx][hOwned] = PI[playerid][pID];
			SendMes(playerid, -1, ""cDA"Вы купили дом за %dр. У вас осталось: %dр", price_house, PI[playerid][pCash]);
			SendClientMessage(playerid, -1, ""cPS"Аренда Вашего дома оплачена на 1 день. Рекомендуем оплатить дом в любом банке города");
			SendMes(playerid, -1, ""cPS"Стоимость кварплаты для вашего дома будет составлять %dр в день",GetHomeOplata(idx));
			strmid(HouseInfo[idx][hOwner], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
			global_string = "";
			format(global_string, 200, "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hOplata = %d, buyprice = %d, hLock = %d WHERE id = '%d' LIMIT 1", HouseInfo[idx][hOwner], HouseInfo[idx][hOwned], HouseInfo[idx][hOplata], HouseInfo[idx][hBuyPrice], HouseInfo[idx][hLock], idx);
			mysql_tquery(db_prod, global_string, "", "");
			PI[playerid][pSpawnChange] = 1;

			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=1, house=%d WHERE id=%d", idx, PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1);

			PI[playerid][pHouse] = idx;

			UpdateHouse(idx);
			PlayerHouseSelect[playerid] = 0;
			fLogs("[house] %s +%i покупка", GetName(playerid), idx);
			return 1;
		}
		if(HouseInfo[idx][hType] == 1)
		{
			if(playerEuro[playerid] < price_house) return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
			if(GetPlayerHouse(playerid)) return SendClientMessage(playerid, -1, ""cER"У вас уже есть дом!");
			if(GetPlayerRooms(playerid)) return SendClientMessage(playerid, COLOR_GREY, "У вас уже есть квартира!");

			TransferEuro(playerid, -1, price_house, "Покупка Дома");
			HouseInfo[idx][hBuyPrice] = HouseInfo[idx][hPrice]/2;
			HouseInfo[idx][hOplata] = 1;
			HouseInfo[idx][hLock] = 1;
			HouseInfo[idx][hOwned] = PI[playerid][pID];
			SendMes(playerid, -1, ""cDA"Вы купили дом за %d евро. У вас осталось: %d евро", price_house, playerEuro[playerid]);
			SendClientMessage(playerid, -1, ""cPS"Аренда Вашего дома оплачена на 1 день. Рекомендуем оплатить дом в любом банке города");
			SendMes(playerid, -1, ""cPS"Стоимость кварплаты для вашего дома будет составлять %dр в день",GetHomeOplata(idx));
			strmid(HouseInfo[idx][hOwner], GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
			global_string = "";
			format(global_string, 200, "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hOplata = %d, buyprice = %d, hLock = %d WHERE id = '%d' LIMIT 1", HouseInfo[idx][hOwner], HouseInfo[idx][hOwned], HouseInfo[idx][hOplata], HouseInfo[idx][hBuyPrice], HouseInfo[idx][hLock], idx);
			mysql_tquery(db_prod, global_string, "", "");
			PI[playerid][pSpawnChange] = 1;

			format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=1, house=%d WHERE id=%d", idx, PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1);

			PI[playerid][pHouse] = idx;

			UpdateHouse(idx);
			PlayerHouseSelect[playerid] = 0;
			fLogs("[house] %s +%i покупка", GetName(playerid), idx);
			return 1;
		}
	}
	else
	{
		if(HouseInfo[idx][hLock] == 1)
		{
			if(strcmp(GetName(playerid), HouseInfo[idx][hOwner], true) == 0) ShowPlayerDialog(playerid, 131+14, 0, ""cMain"Дом", ""cWH"Ваш дом закрыт\n\nВы хотите его открыть?", "Да", "Нет");
			GameTextForPlayer(playerid, "~r~закрыто", 5000, 1);
		}
		else
		{

			SetPlayerPos(playerid,HouseInfo[idx][hExitx],HouseInfo[idx][hExity],HouseInfo[idx][hExitz]);
			SetPlayerInterior(playerid,HouseInfo[idx][hInt]);
			SetPlayerVirtualWorld(playerid,HouseInfo[idx][hVirtual]);

			PI[playerid][pInHouse] = idx;

			PlayerHouseSelect[playerid] = 0;
		}
	}
	return 1;
}
DLG(29, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::home(playerid);
	new i = GetPlayerHouse(playerid);
	if(GetPlayerVirtualWorld(playerid) != HouseInfo[i][hVirtual]) return SendClientMessage(playerid, COLOR_RED, "Вы должны находиться в своем доме");
	if(i != 0 && HouseInfo[i][hRublevka] > 0) DestroyHelicopter(playerid);
	strmid(HouseInfo[i][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);

	PI[playerid][pHouse] = -1;
	printf("SELL HOUSE 5: %s", GetName(playerid));
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=0, house=-1 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1);
	fLogs("[house] %s -%i продал гос", GetName(playerid), i);

	PI[playerid][pSpawnChange] = 0;
	SendMes(playerid, -1, ""cPS"Деньги с домашнего счета переведены на ваш банковский счет (%d руб)", HouseInfo[i][hBuyPrice]);
	MysqlUpdateHouseStr(i, "hOwner", "None");
	HouseInfo[i][hLock] = 1;
	HouseInfo[i][hOwned] = -1;
	HouseInfo[i][hOplata] = HouseInfo[i][hGarage] = HouseInfo[i][hAutoDoors] = 0;
	SendMes(playerid, -1, ""cDA"Вы продали свой дом государству за %d руб. Деньги переведены в банк",HouseInfo[i][hBuyPrice]);

	UpdateHouse(i);
	new fam = PI[playerid][pFamily];
	if(fam) if(family_info[fam][f_spawn])
	{
		if(family_info[fam][f_house] == i)
		{
			family_info[fam][f_spawn] =
			family_info[fam][f_spawn] = 0;
			format(stringer1, 100, "UPDATE `family_system` SET fam_house=0, fam_spawn=0 WHERE fam_id=%d", fam);
			mysql_tquery(db_prod, stringer1);
		}
	}
	format(global_string, sizeof(global_string), "UPDATE `house` SET  hOwner = '%s', `hOwned` = '-1', buyprice = 0, hLock = %d, hOplata = 0, hGarage = 0, hAutoDoors = 0 WHERE id = '%d' LIMIT 1", HouseInfo[i][hOwner], HouseInfo[i][hLock], i);
	mysql_tquery(db_prod, global_string, "", "");
	if(GetPlayerVirtualWorld(playerid) == HouseInfo[i][hVirtual])
	{
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerPos(playerid, HouseInfo[i][hEntrx], HouseInfo[i][hEntry], HouseInfo[i][hEntrz]);
		PI[playerid][pInHouse] = -1;
	}
	new accountid = PI[playerid][pMainBankAccount];
	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "У Вас не установлен основной банковский счёт");
	g_player_bank_accounts[playerid][ accountid ][B_BALANCE] += HouseInfo[i][hBuyPrice];

	format(stringer1, sizeof stringer1, "+ Продажа дома %d рублей", HouseInfo[i][hBuyPrice]);
	SendBankAccountLog(playerid, GetPlayerBankAccountData(playerid, accountid, B_ID), stringer1);
	UpdateBankMoneyText(playerid, accountid);

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bank_accounts` SET `balance` = '%d' WHERE `id` = '%d' LIMIT 1", GetPlayerBankAccountData(playerid, accountid, B_BALANCE), GetPlayerBankAccountData(playerid, accountid, B_ID));
	mysql_tquery(db_prod, STRING_GLOBAL);
	return 1;
}
DLG(30, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(!IsPlayerConnected(HouseOffer[playerid])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[HouseOffer[playerid]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(GetPlayerRubble(playerid) < HousePrice[playerid])
		{
			SendMes(HouseOffer[playerid], -1, ""cER"У %s недостаточно средств!", GetName(playerid));
			HouseOffer[playerid] = -1;
			HousePrice[playerid] = 0;
			return SendClientMessage(playerid, -1, ""cER"У вас не хватает денег!");
		}

		if(GetPlayerHouse(HouseOffer[playerid]) != 0 && HouseInfo[GetPlayerHouse(HouseOffer[playerid])][hRublevka] > 0) DestroyHelicopter(HouseOffer[playerid]);
		if(GetPlayerHouse(playerid) != 0 && HouseInfo[GetPlayerHouse(playerid)][hRublevka] > 0) DestroyHelicopter(playerid);

		if(GetPlayerLimitMoney(HouseOffer[playerid], HousePrice[playerid]))
		{
			SendErr(playerid, "У игрока максимальное количество денег.");
			SendErr(HouseOffer[playerid], "У Вас максимальное количество денег.");
			return 1;
		}

		SetPlayerMoney(HouseOffer[playerid], HousePrice[playerid]);
		SetPlayerMoney(playerid, -HousePrice[playerid]);

		HouseInfo[GetPlayerHouse(HouseOffer[playerid])][hOwned] = PI[HouseOffer[playerid]][pID];
		HouseInfo[GetPlayerHouse(playerid)][hOwned] = PI[playerid][pID];

		format(global_string, sizeof(global_string), "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hLock = 1, hOplata = '%d' WHERE id = '%d' LIMIT 1", GetName(HouseOffer[playerid]), HouseInfo[HouseOffer[playerid]][hOwned], HouseInfo[GetPlayerHouse(HouseOffer[playerid])][hOplata], GetPlayerHouse(playerid));
		mysql_tquery(db_prod, global_string, "", "");
		format(global_string, sizeof(global_string), "UPDATE `house` SET hOwner = '%s', `hOwned` = '%d', hLock = 1, hOplata = '%d' WHERE id = '%d' LIMIT 1", GetName(playerid), HouseInfo[GetPlayerHouse(playerid)][hOwned], HouseInfo[GetPlayerHouse(playerid)][hOplata], GetPlayerHouse(HouseOffer[playerid]));
		mysql_tquery(db_prod, global_string, "", "");

		strmid(HouseInfo[GetPlayerHouse(HouseOffer[playerid])][hOwner],GetName(playerid), 0, strlen(GetName(playerid)), MAX_PLAYER_NAME);
		strmid(HouseInfo[GetPlayerHouse(playerid)][hOwner],GetName(HouseOffer[playerid]), 0, strlen(GetName(HouseOffer[playerid])), MAX_PLAYER_NAME);

		HouseInfo[GetPlayerHouse(HouseOffer[playerid])][hLock] = 1;
		HouseInfo[GetPlayerHouse(playerid)][hLock] = 1;

		PI[playerid][pHouse] = GetPlayerHouse(HouseOffer[playerid]);
		fLogs("[house] %s +%i обмен", GetName(playerid), PI[playerid][pHouse]);
		PI[HouseOffer[playerid]][pHouse] = GetPlayerHouse(playerid);
		fLogs("[house] %s +%i обмен", GetName(HouseOffer[playerid]), GetPlayerHouse(playerid));

		UpdateHouse(GetPlayerHouse(HouseOffer[playerid]));
		UpdateHouse(GetPlayerHouse(playerid));

		MysqlUpdatePlayerInt(playerid, "house", PI[playerid][pHouse]);
		MysqlUpdatePlayerInt(HouseOffer[playerid], "house", PI[HouseOffer[playerid]][pHouse]);

		SendMes(playerid, COLOR_GREEN, "Вы обменялись домами с %s. Доплата: %d руб", GetName(HouseOffer[playerid]),HousePrice[playerid]);
		SendMes(HouseOffer[playerid], COLOR_GREEN, "Вы обменялись домами с %s. Ваша доплата: %d руб", GetName(playerid),HousePrice[playerid]);
		HouseOffer[playerid] = -1;
		HousePrice[playerid] = 0;
		PI[playerid][pSpawnChange] = 0;

		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET spawnchange=0, house=%d WHERE id=%d", PI[playerid][pHouse], PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1);
	}
	else
	{
		SendMes(HouseOffer[playerid], COLOR_RED, "%s отклонил предложение обменяться домами с вами", GetName(playerid));
		HouseOffer[playerid] = -1;
		HousePrice[playerid] = 0;
	}
	return 1;
}
DLG(35, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(GetPlayerData(playerid, SalonCarID) != INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Системная ошибка, обратитесь к администратору");
	SendClientMessage(playerid, -1, ""cPS"Добро пожаловать в автосалон");
	InShop[playerid] = 1;
	pPressed[playerid] = 0;

	/*HidePlayerSpeedometer(playerid);
	HidePlayerHud(playerid);*/

	TogglePlayerControllable(playerid, false);

	for(new i; i < 17; i++) TextDrawShowForPlayer(playerid, cshop_TD[i]);
	for(new i; i < 2; i++) PlayerTextDrawShow(playerid, cshop_PTD[playerid][i]);

	if(g_player_salon[playerid] == 1)
	{
		SetPlayerData(playerid, SalonCarID, CreateVehicle(carsC[pPressed[playerid]][0], -18.7182, 2.1684, 1200.7897, 122.4599, colors[playerid][0]=random(10),colors[playerid][1]=random(10),10000));
		CarDoorsEx(GetPlayerData(playerid, SalonCarID), 0);

		format(string,sizeof(string),"%s",VehicleNames[carsC[pPressed[playerid]][0]-400]);
		PlayerTextDrawSetString(playerid,cshop_PTD[playerid][1],string);

		new price_car = GetReasonMoneyPercentVip(playerid, TYPE_VIP_AUTO, carsC[pPressed[playerid]][1]);
		format(string,sizeof(string),"%dР",price_car);
		PlayerTextDrawSetString(playerid,cshop_PTD[playerid][0],string);
	}
	else
	{
		SetPlayerData(playerid, SalonCarID, CreateVehicle(carsC[pPressed[playerid]][0], -18.7182, 2.1684, 1200.7897, 122.4599, colors[playerid][0]=random(10),colors[playerid][1]=random(10),10000));
		CarDoorsEx(GetPlayerData(playerid, SalonCarID), 0);

		format(string,sizeof(string),"%s",VehicleNames[carsC[pPressed[playerid]][0]-400]);
		PlayerTextDrawSetString(playerid,cshop_PTD[playerid][1],string);

		new price_car = GetReasonMoneyPercentVip(playerid, TYPE_VIP_AUTO, carsC[pPressed[playerid]][1]);
		format(string,sizeof(string),"%dР",price_car);
		PlayerTextDrawSetString(playerid,cshop_PTD[playerid][0],string);
	}
	SetPosInShop(playerid);
	SelectTextDrawEx(playerid, 0xFFFFFFFF);

	/*HidePlayerSpeedometer(playerid);
	HidePlayerHud(playerid);*/

	if(g_player_salon[playerid] == 1)
	{
		SetPlayerCameraPos(playerid, -21.2776, -3.0766, 1201.6437);
		SetPlayerCameraLookAt(playerid, -20.9471, -2.1343, 1201.5801);
	}
	if(g_player_salon[playerid] == 2)
	{
		SetPlayerCameraPos(playerid, -21.2776, -3.0766, 1201.6437);
		SetPlayerCameraLookAt(playerid, -20.9471, -2.1343, 1201.5801);
	}
	return 1;
}
DLG(18, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		offerplayer[playerid] = INVALID_PLAYER_ID;
		offerfractionid[playerid] = 0;
		return 1;
	}
	new fractionid = offerfractionid[playerid];
	new offer = offerplayer[playerid];
	new mes[128];
	for(new i; i < 9; i++)
	{
		new skinid = Fraction_Skin[fractionid][i];
		if(!skinid) break;
		if(!i) format(mes, sizeof(mes), "Скин %d [%d]", i+1, skinid);
		else format(mes, sizeof(mes), "%s\nСкин %d [%d]", mes, i+1, skinid);
	}
	SendClientMessage(playerid, COLOR_BLUE, "Ждите, пока лидер выберет одежду для Вас");
	ShowPlayerDialog(offer, 7000, 2, ""cMain"Выбор скина", mes, "Принять", "");
	return 1;
}
DLG(7000, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new actplayerid_ = actplayerid[playerid];
	new fractionid = offerfractionid[actplayerid_];
	new skinid = Fraction_Skin[fractionid][listitem];
	SendMes(actplayerid_, COLOR_BLUE, "Вы присоединились к организации \"%s\"", Fraction_Name[fractionid]);
	SendMes(playerid, COLOR_BLUE, "%s принял предложение присоединиться к \"%s\"", GetName(actplayerid_), Fraction_Name[fractionid]);
	PI[actplayerid_][pMember] = fractionid;
	PI[actplayerid_][pRank] = 1;
	PI[actplayerid_][pMemberSkin] = skinid;
	SetPlayerSkin(actplayerid_, skinid);
	SetPlayerColorEx(actplayerid_, TeamColors[GetTeamID(actplayerid_)]);
	ResetPlayerWeapons(actplayerid_);
	PI[playerid][pLeaderStat][LEADER_INVITE] ++;

	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET memberskin=%d, member=%d, rank=1 WHERE id=%d", skinid, fractionid, PI[actplayerid_][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET sub_invited=sub_invited+1 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	fLogs("[invite] %s /invite %s [%s]", GetName(playerid), GetName(actplayerid_), Fraction_Name[fractionid]);

	if(F_MSG_Log == true)
	{
        format(string, sizeof(string), "[F-MSG] %s[%d] invited %s[%d] to %s", GetName(playerid), playerid, GetName(actplayerid_), actplayerid_, Fraction_Name[fractionid]);
		SendAdminMessage(COLOR_GREY, string);
	}
	return 1;
}
DLG(49, playerid, response, listitem, inputtext[])
{
	if(!response) return actplayerid[playerid] = 0;
	actfraction[playerid] = listitem + 1;
	new fractionid = actfraction[playerid];
	new mes[128];
	for(new i; i < 9; i++)
	{
		new skinid = Fraction_Skin[fractionid][i];
		if(!skinid) break;
		if(!i) format(mes, sizeof(mes), "Скин %d [%d]", i+1, skinid);
