			ShowPlayerDialog(playerid, 4600, DIALOG_STYLE_MSGBOX, ""cMain"Организация", global_string, "Назад", "Закрыть");
		}
		case 11:
		{
			ShowPlayerDialog(playerid, 4600, DIALOG_STYLE_MSGBOX, ""cMain"Горячие клавиши", "{66CC00}'ALT' "cWH"- взаимодействие с дверями, воротами\n\
