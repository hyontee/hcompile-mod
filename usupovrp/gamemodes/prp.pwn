						r = 204;
						g = 255;
						b = 255;
					}

					case 5:
					{
						r = 0;
						g = 153;
						b = 0;
					}

					case 6:
					{
						r = 204;
						g = 0;
						b = 255;
					}

					case 7:
					{
						r = 255;
						g = 204;
						b = 0;
					}

					case 8:
					{
						r = 153;
						g = 102;
						b = 51;
					}

					case 9:
					{
						r = 153;
						g = 51;
						b = 102;
					}

					case 10:
					{
						r = 187;
						g = 0;
						b = 0;
					}

					case 11:
					{
						r = 255;
						g = 102;
						b = 0;
					}

					default:
					{
						r = 255;
						g = 255;
						b = 255;
					}
				}

				SetVehicleTuning(VehInfo[idx][vVehicle], VT_MAIN_COLOR_R, r);
				SetVehicleTuning(VehInfo[idx][vVehicle], VT_MAIN_COLOR_G, g);
				SetVehicleTuning(VehInfo[idx][vVehicle], VT_MAIN_COLOR_B, b);*/

				if(VehInfo[idx][vVehicle] != INVALID_VEHICLE_ID)
					vehicle_mileage[VehInfo[idx][vVehicle]] = VehInfo[idx][vMileage];
			}
			frakVehicleCount[VehInfo[idx][vFraction]][tmp[VehInfo[idx][vFraction]]] = idx;
			tmp[VehInfo[idx][vFraction]]++;
