	BlackList[playerid][10] = cache_get_field_content_int(0, "black10");
	BlackList[playerid][11] = cache_get_field_content_int(0, "black11");
	BlackList[playerid][12] = cache_get_field_content_int(0, "black12");
	PI[playerid][pFamilyRank] =  cache_get_field_content_int(0, "familyrank");
	PI[playerid][pLWarn] = cache_get_field_content_int(0, "lwarn");
	PI[playerid][pTWarn] = cache_get_field_content_int(0, "twarn");
	PI[playerid][pCountCars] = cache_get_field_content_int(0, "countcars");
	PI[playerid][pPerfectCoins] = cache_get_field_content_int(0, "credits");
	PI[playerid][pMats] = cache_get_field_content_int(0, "mats");
	PI[playerid][pLockPicks] = cache_get_field_content_int(0, "LockPick");
	PI[playerid][pBonusDay] = cache_get_field_content_int(0, "bonusday");
	PI[playerid][pMainBankAccount] = cache_get_field_content_int(0, "mainbankaccount");
	PI[playerid][pClips] = cache_get_field_content_int(0, "clips");
	Phone[playerid] = bool: cache_get_field_content_int(0, "togphone");
	PI[playerid][pHouse] = cache_get_field_content_int(0, "house");
	PI[playerid][pHouseArend] = cache_get_field_content_int(0, "house_arend");
	PI[playerid][pBiz] = cache_get_field_content_int(0, "business");
	PI[playerid][pGarage] = cache_get_field_content_int(0, "garage");
	PI[playerid][pRoom] = cache_get_field_content_int(0, "room");
	playerDefeetKart[playerid] = cache_get_field_content_int(0, "defeetkart");
	playerWinKart[playerid] = cache_get_field_content_int(0, "winkart");
	PI[playerid][pMainSub] = cache_get_field_content_int(0, "mainsub");
	PI[playerid][pScoreIvent] = cache_get_field_content_int(0, "scoreivent");
	playerEuro[playerid] = cache_get_field_content_int(0, "pEuro");
	PI[playerid][GunPack] = cache_get_field_content_int(0, "GunPack");
	PI[playerid][MobileBank] = cache_get_field_content_int(0, "MobileBank");
	PI[playerid][pRefTime] = cache_get_field_content_int(0, "RefTime");
	PI[playerid][pRefPay] = cache_get_field_content_int(0, "RefPay");
	PI[playerid][Billet] = cache_get_field_content_int(0, "Billet");
	PI[playerid][GiveCoin] = cache_get_field_content_int(0, "GiveCoin");
	PI[playerid][GiveCar] = cache_get_field_content_int(0, "GiveCar");

	PI[playerid][P_MOBILE] = IsPlayerFromThePhone(playerid) ? 1 : 0;
	UpdatePlayerData(playerid, "is_mobile", PI[playerid][P_MOBILE]);

	new l_guns[56], l_ammo[56];
	cache_get_field_content(0, "guns", l_guns, db_prod, 56);
	cache_get_field_content(0, "ammos", l_ammo, db_prod, 56);

	new g_data[13], a_data[13];
	sscanf(l_guns, "p<,>a<i>[13]", g_data);
	sscanf(l_ammo, "p<,>a<i>[13]", a_data);
	for(new i; i < 13; i++)
	{
		playerLoadGun[playerid][i] = g_data[i];
		playerLoadAmmo[playerid][i] = a_data[i];
	}
	Connected[playerid] = 1;

	sscanf(PI[playerid][pTexts], "p<,>a<i>[4]", PI[playerid][pText]);
	sscanf(PI[playerid][pPhones], "p<,>a<i>[2]", PI[playerid][pPhone]);
	sscanf(PI[playerid][pSettings], "p<,>a<i>[7]", Setting[playerid]);

	playerAuthTime[playerid] = -1;
	format(MdPanel, sizeof(MdPanel),"%d, %d, %d, %d, %d, %d", MD[0], MD[1], MD[2], MD[3], MD[4], MD[5]);
	MysqlUpdateOtherStr("mdpanel", MdPanel);

	for(new i; i < 15; i++) SendClientMessage(playerid, COLOR_WHITE, "");
	SendClientMessage(playerid, -1, ""cPS"Добро пожаловать на "cMain""SERVER_NAME"");

	if(PI[playerid][pVip] != VIP_STATE_NONE)
	{
		if(PI[playerid][pVipTime] < 0)
		{
			PI[playerid][pVip] = VIP_STATE_NONE;
			PI[playerid][pVipTime] = 0;

			format(stringer1, 144, "UPDATE `accounts` SET vip = '-1', vip_time = '0' WHERE id = '%d' LIMIT 1", PI[playerid][pID]);
			mysql_tquery(db_prod, stringer1, "", "");
		}
	}

	format(stringer1, sizeof(stringer1),"SELECT * FROM `inventory` WHERE `Name` = '%s'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "LoadPlayerItem","d", playerid);

	format(stringer1, sizeof(stringer1),"SELECT * FROM accounts_accessories WHERE `owner` = '%d'", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "LoadPlayerAccessories","d", playerid);

	format(stringer1, 144, "UPDATE `accounts` SET ip = '%s', online = '%d' WHERE id = '%d' LIMIT 1", PI[playerid][pIP],playerid, PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	if(doubling_exp && !doubling_donate) SendClientMessage(playerid, COLOR_LIME, ""cPS"Сегодня действует двойной опыт каждый час!");
	else if(doubling_donate && !doubling_exp)
	{
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Внимание! СЕЙЧАС действует акция X2 Donate!"),
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Она увеличивает все ваши поступления в два раза"),
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Пример: Закинули 100 руб получили 200 "SERVER_COINS"");
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Пополнить счет - "PAGE_WEBSITE_DONATE"");
	}
	else if(doubling_donate && doubling_exp)
	{
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Сегодня действует двойной опыт каждый час и акция X2 Donate");
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Внимание! СЕЙЧАС действует акция X2 Donate!"),
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Она увеличивает все ваши поступления в два раза"),
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Пример: Закинули 100 руб получили 200 "SERVER_COINS"");
		SendClientMessage(playerid, COLOR_LIME, ""cPS"Пополнить счет - "PAGE_WEBSITE_DONATE"");
	}

	if(PI[playerid][pText][0] == 1)
	{
		new i = PI[playerid][pText][0];
		if(HouseInfo[i][hType] == 0)
		{
			SetPlayerMoney(playerid, HouseInfo[i][hPrice] / 2);
			SendMes(playerid, COLOR_YELLOW, "[ДОМ]: Вы были выселены за неуплату! Вам было возвращено %dр", HouseInfo[i][hPrice] / 2);
		}
		if(HouseInfo[i][hType] == 1)
		{
			TransferEuro(-1, playerid, HouseInfo[i][hPrice] / 2, "Дом улетел в гос");
			SendMes(playerid, COLOR_YELLOW, "[ДОМ]: Вы были выселены за неуплату! Вам было возвращено %d евро", HouseInfo[i][hPrice] / 2);
		}
		format(PI[playerid][pTexts], 20,  "0, %d, %d, %d", PI[playerid][pText][1], PI[playerid][pText][2], PI[playerid][pText][3]);
		format(global_string, 256, "UPDATE `accounts` SET text = '%s' WHERE name = '%s'", PI[playerid][pTexts], GetName(playerid));
		mysql_tquery(db_prod, global_string, "", "");
		new fam = PI[playerid][pFamily];
		if(fam) if(family_info[fam][f_spawn])
		{
			if(family_info[fam][f_house] == i)
			{
				family_info[fam][f_spawn] =
				family_info[fam][f_spawn] = 0;
				format(stringer1, 100, "UPDATE `family_system` SET fam_house=0, fam_spawn=0 WHERE fam_id=%d", fam);
				mysql_tquery(db_prod, stringer1);
			}
		}
	}

	new mutereason[64], jailreason[64];
	cache_get_field_content(0, "mutereason", mutereason, db_prod, 64);
	cache_get_field_content(0, "jailreason", jailreason, db_prod, 64);

	if(strcmp(mutereason, "None", true))
	{
		SendMes(playerid, -1, ""cER"Вам был выдан мут в Offline. Причина: %s", mutereason);
		mysql_format(db_prod, stringer1, 128, "UPDATE `accounts` SET mutereason = 'None' WHERE name = '%s'", GetName(playerid));
		mysql_tquery(db_prod, stringer1, "", "");
	}
	if(strcmp(jailreason, "None", true))
	{
		SendMes(playerid, -1, ""cER"Вы были посажены в тюрьму в Offline. Причина: %s", jailreason);
		mysql_format(db_prod, stringer1, 128, "UPDATE `accounts` SET jailreason = 'None' WHERE name = '%s'", GetName(playerid));
		mysql_tquery(db_prod, stringer1, "", "");
	}
	if(PI[playerid][pText][1] == 1)
	{
		SendClientMessage(playerid, COLOR_YELLOW, "[БИЗНЕС]: Ваш бизнес закрыли в связи с нехваткой ресурсов");
		SendClientMessage(playerid, COLOR_YELLOW, "[БИЗНЕС]: Бюджет бизнеса зачислен на ваш банковский счет");
		format(PI[playerid][pTexts], 20, "%d, 0, %d, %d", PI[playerid][pText][0], PI[playerid][pText][2], PI[playerid][pText][3]);
		format(stringer1, 144, "UPDATE `accounts` SET text = '%s' WHERE name = '%s'", PI[playerid][pTexts], GetName(playerid));
		mysql_tquery(db_prod, stringer1, "", "");
	}
	if(PI[playerid][pText][3] == 1)
	{
		SendClientMessage(playerid, -1, ""cDA"На ваш счёт поступил донат платёж (/donate - Проверить зачисления)");
		format(PI[playerid][pTexts], 20, "%d, %d, %d, 0", PI[playerid][pText][0], PI[playerid][pText][1], PI[playerid][pText][2]);
		format(global_string, 256, "UPDATE `accounts` SET text = '%s' WHERE name = '%s'", PI[playerid][pTexts], GetName(playerid));
		mysql_tquery(db_prod, global_string, "", "");
	}

	if(GetPlayerGarage(playerid) != -1)
	{
		if(strcmp(GetName(playerid), GarageInfo[GetPlayerGarage(playerid)][g_OWNER]) != 0)
		{
			PI[playerid][pGarage] = -1;
			MysqlUpdatePlayerInt(playerid, "garage", PI[playerid][pGarage]);
		}
		else SCMF(playerid, COLOR_ORANGE, "[Гараж]: Ваш гараж оплачен на %d д. Оплатить гараж можно: (/gps -> Банки) или в любом банкомате города.", GarageInfo[GetPlayerGarage(playerid)][g_DAY]);
	}
	if(GetPlayerHouse(playerid))
	{
		if(strcmp(GetName(playerid), HouseInfo[GetPlayerHouse(playerid)][hOwner]) != 0)
		{
			PI[playerid][pHouse] = -1;
			MysqlUpdatePlayerInt(playerid, "house", PI[playerid][pHouse]);
			printf("SELL HOUSE 1: %s", GetName(playerid));
			fLogs("[house] %s -%i под другим", GetName(playerid), GetPlayerHouse(playerid));
		}
		else SCMF(playerid, COLOR_ORANGE, "[Дом]: Ваш дом оплачен на %d д. Оплатить дом можно: (/gps -> Банки) или в любо банкомате города.", HouseInfo[GetPlayerHouse(playerid)][hOplata]);
	}
	else
	{
		for(new i = TOTALHOUSE; i > 0; i --)
		{
			if(!strcmp(GetName(playerid), HouseInfo[i][hOwner]))
			{
				PI[playerid][pHouse] = i;
				MysqlUpdatePlayerInt(playerid, "house", PI[playerid][pHouse]);
				printf("SET PLAYER HOUSE: %s - %d", GetName(playerid), i);
				fLogs("[house] %s +%i загружен", GetName(playerid), i);
			}
		}
	}
	if(GetPlayerRooms(playerid))
	{
		if(strcmp(GetName(playerid), RoomsInfo[GetPlayerRooms(playerid)][rOwner]) != 0)
		{
			PI[playerid][pRoom] = -1;
			MysqlUpdatePlayerInt(playerid, "room", PI[playerid][pRoom]);
		}
		else SCMF(playerid, COLOR_ORANGE, "[Квартира]: Ваша квартира оплачена на %d д. Оплатить квартиру можно: (/gps -> Банки) или в любом банкомате города.", RoomsInfo[GetPlayerRooms(playerid)][rOplata]);
	}
	new id = GetPlayerBizz(playerid);
	if(id != 0)
	{
		if(strcmp(GetName(playerid), BizzInfo[id][bOwner]) != 0)
		{
			SendInf(playerid, "Ваш бизнес имеет другой человек.");
			PI[playerid][pBiz] = -1;
			MysqlUpdatePlayerInt(playerid, "business", PI[playerid][pBiz]);
			printf("SELL BIZZ 3: %s", GetName(playerid));
			fLogs("[biz] %s -%i под другим", GetName(playerid), id);
		}
		else SCMF(playerid, COLOR_ORANGE, "[Бизнес]: Ваш бизнес оплачен на %d д. Оплатить бизнес можно: (/gps -> Банки) или в любом банкомате города.", BizzInfo[id][bOplata]);
	}
	else
	{
		for(new i = TOTALBIZZ; i > 0; i --)
		{
			if(!strcmp(GetName(playerid), BizzInfo[i][bOwner]))
			{
				PI[playerid][pBiz] = i;
				MysqlUpdatePlayerInt(playerid, "business", PI[playerid][pBiz]);
				printf("SET PLAYER BIZ: %s - %d", GetName(playerid), i);
			}
		}
	}
	if(GetPlayerArend(playerid) != 0 && PI[playerid][pSpawnChange] != 5) SendMes(playerid, COLOR_ORANGE, "Хозяин дома №%d поселил Вас у него. Чтобы появляться в его доме, используйте команду /setspawn", GetPlayerArend(playerid));
	if(PI[playerid][pFamily])
	{
		new familyid = PI[playerid][pFamily];
		if(playerFamilyNameTag[playerid] == INVALID_3DTEXT_ID)
		{
			stringer1 = "";
			strcat(stringer1, family_info[familyid][f_name]);
			strcat(stringer1, ""cWH" ");
			strcat(stringer1, "Family");
			playerFamilyNameTag[playerid] = CreateDynamic3DTextLabel(stringer1, gFamilyColor[family_info[familyid][f_chat_color]], 0.0, 0.0, 0.5, 10.0, playerid, INVALID_VEHICLE_ID, 1);
		}
		GetCreatorHouseID(playerid);
	}
	if(GetPlayerHouse(playerid) != 0 && HouseInfo[GetPlayerHouse(playerid)][hRublevka] > 0 && PI[playerid][HelicopterID] == INVALID_VEHICLE_ID)
	{
		format(stringer1, 128, "SELECT `h_owner` FROM `helicopters` WHERE h_owner = '%s'", GetName(playerid));
		mysql_tquery(db_prod, stringer1, "CheckHelicopterLoad", "i", playerid);
	}
	if(PI[playerid][pLeader])
	{
		format(stringer1, 128, "SELECT * FROM `accounts` WHERE `name` = '%s'",GetName(playerid));
		mysql_tquery(db_prod, stringer1, "LoadLstats", "d", playerid);
	}
	playerReg{playerid} = 0;
	PlayerLogged[playerid] = true;
	SpawnPlayer(playerid);

	if(PI[playerid][pPhone][1] > 0) SendClientMessage(playerid, COLOR_ORANGE, "У Вас подключен интернет. Для использования соц. сети 'ВКонтакте', используйте команду: /soc или /vk");
	if(!strcmp(PI[playerid][pMail], "undefinedmailurl"))
	{
		ShowPlayerDialog(playerid, 131+339, 1, "{ffffad}УВЕДОМЛЕНИЕ","\
		"cWH"Что бы {9ACD32}обезопасить "cWH"Ваш аккаунт,\n\
		Вам потребуется ввести Ваш почтовый ящик\n\
		В случае, если Ваш аккаунт будет взломан или Вы забудете пароль\n\
		Вы с легкостью сможете его восстановить.\n\n\
		Пример: {AFAFAF}My@mail.ru\n\
		"cWH"Введите Вашу почту:", "Далее", "Отмена");
	}

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `hitman` WHERE `vID` = '%d'", PI[playerid][pID]);
	mysql_tquery(db_prod, STRING_GLOBAL, "CheckKillerList", "ii", playerid, 1);

	if(PI[playerid][pLevel] <= BONUS_LVL) SendClientMessage(playerid, -1, ""cPS"Появился вопрос? Задавайте его администраторам сервера "cMain"(/report)");

	ResetPlayerMoney(playerid); GivePlayerMoney(playerid, PI[playerid][pCash]);

	if(PI[playerid][pSettingTD][0] == 1)
	{
		if(!IsPlayerFromThePhone(playerid))
			CPTD_Euro(playerid);
	}

	if(PI[playerid][pSettingTD][2] == 1)
	{
		for(new i; i < 15; i++) TextDrawShowForPlayer(playerid, server_info_td[i]);
	}
	BonusDay(playerid);


	if(give_car > 0)
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `ownable_cars` (`c_model`, `c_x`, `c_y`, `c_z`, `c_a`, `c_class`, `c_owner`, `c_fuel`, `c_color1`, `c_color2`, `c_lock`, `c_price`, `c_health`) VALUES ('458', '0', '0', '0', '0', '1', '%e', '45', '-1', '-1', '1', '9000000', '1000.0')", GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL, "", "");

		PI[playerid][pCountCars] ++;
		MysqlUpdatePlayerInt(playerid, "countcars", PI[playerid][pCountCars]);
		fLogs("[cars] %s +[Cadillac] подарок на обнову", GetName(playerid));

		give_car --;
		MysqlUpdateOtherInt("give_car", give_car);
		SendClientMessage(playerid, 0xFFFF00FF, "Вы попали в список первых вошедших 500 игроков на сервер и получили Cadillac + слот к нему");
	}
	format(stringer1, 128, "SELECT * FROM accounts_online WHERE `id` = '%d'", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "LoadOnline", "di", playerid, cache_get_field_content_int(0, "day"));

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `bank_accounts` WHERE `owner` = '%d'", PI[playerid][pID]);
	mysql_tquery(db_prod, STRING_GLOBAL, "LoadBankAccounts", "d", playerid);

	format(stringer1, 128, "SELECT * FROM friends WHERE friend='%s'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "LoadFriends", "d", playerid);


	if(glFamilyCaptActive[PI[playerid][pFamily]])
	{
		for(new i; i < 4; i++) GangZoneShowForPlayer(playerid, glFamilyCaptZone[glFamilyCaptIder[PI[playerid][pFamily]]][i], 0x6A5ACDFF);
		GangZoneShowForPlayer(playerid, glFamilyCaptZone[glFamilyCaptIder[PI[playerid][pFamily]]][4], 0x6A5ACD25);
	}
	for(new i = 0; i < sizeof(GZInfo); i++) GangZoneShowForPlayer(playerid, GZInfo[i][gZone], GetGangZoneColor(i));

	#if defined TL_VERSION
	g_player_timer[playerid] = SetTimerEx("TL_TIMER", 100, false, "i", playerid);
	#endif

	if(PI[playerid][pMuted] > 0)
	{
		PVC_MutePlayer(playerid);
	}
	else
		PVC_UnMutePlayer(playerid);

	#if defined BINDER_VERSION
	LoadPlayerBinder(playerid);
	#endif

	/*ShowPlayerDialog
	(
		playerid, 0, DIALOG_STYLE_MSGBOX,
		"{7bed9f}Закрытое Бета Тестирование",
		"{ffffff}Приветствуем Вас на Закрытом Бета Тестировании {7bed9f}PERFECT RUSSIA{ffffff}!\n\n"\
		"Мы безумно рады видеть Вас и надеемся, что Вы сможете обнаружить\n"\
		"максимальное количество {7bed9f}недоработок {ffffff}нашей игры.\n\n"\
		"Вам был выдан бонус при регистрации в виде {7bed9f}денег {ffffff}и {7bed9f}Perfect Coins{ffffff}, обо всех\n"\
		"найденных недоработках сообщайте в {7bed9f}конференцию {ffffff}с подписью {7bed9f}#BUG{ffffff}.",
		"", "Закрыть"
	);*/

	//ShowPlayerHud(playerid);

	return 1;
}
BonusDay(playerid)
{
	new l_day = data_vhod[playerid];

	if((day - l_day == 1) || !PI[playerid][pBonusDay] || day - l_day < -26)
	{
		PI[playerid][pBonusDay] ++;
		if(PI[playerid][pBonusDay] > 7) PI[playerid][pBonusDay] = 1;
		UpdatePlayerData(playerid, "bonusday", PI[playerid][pBonusDay]);
		SendMes(playerid, -1, ""cDA"Бонусный день №%d", PI[playerid][pBonusDay]);

		for(new i; i < 27; i++) TextDrawShowForPlayer(playerid, bonus_td_global[i]);
		PlayerTextDrawShow(playerid, bonus_td_player[playerid]);

		SelectTextDrawEx(playerid, -1);
		format(stringer1, 200, "заходите_на_сервер_каждый_день_и_получайте_подарки!~n~сегодня:_%d_день,_вы_получите_%s!", PI[playerid][pBonusDay], bonus_text[PI[playerid][pBonusDay]-1]);

		PlayerTextDrawSetString(playerid, bonus_td_player[playerid], stringer1);

	}
	else if((day - l_day > 1))
	{
		PI[playerid][pBonusDay] = 1;
		UpdatePlayerData(playerid, "bonusday", PI[playerid][pBonusDay]);
		SendMes(playerid, -1, ""cDA"Бонусный день №%d", PI[playerid][pBonusDay]);

		for(new i; i < 27; i++) TextDrawShowForPlayer(playerid, bonus_td_global[i]);
		PlayerTextDrawShow(playerid, bonus_td_player[playerid]);

		SelectTextDrawEx(playerid, -1);
		PlayerTextDrawSetString(playerid, bonus_td_player[playerid], "заходите_на_сервер_каждый_день_и_получайте_подарки!~n~сегодня:_1_день,вы_получите_100000 рублей!");
	}
	return 1;
}

cmd:cbreak(playerid)
{
	if(PI[playerid][pCarTheft] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "Вы не взяли заказ");
	if(!IsAMafia(playerid) && PI[playerid][pMember] != TEAM_HITMAN)  return SendClientMessage(playerid, -1, ""cER"Доступно только мафиии и хитманам");
	if(PI[playerid][pRank] < 6) return SendClientMessage(playerid, -1, ""cER"Данная возможность доступна с 6 ранга");
	if(!PI[playerid][pLockPicks]) return SendClientMessage(playerid, -1, ""cER"У Вас нет отмычек. Купить отмычки можно в магазине 24/7. Для поиска используйте /gps");
	if(car_break_status[playerid]) return SendClientMessage(playerid, -1, ""cER"Вы уже начали взлом замка автомобиля");
	new Float: pos_car_x, Float: pos_car_y, Float: pos_car_z;
	foreach(new vehicleid: Vehicle)
	{
		GetVehiclePos(vehicleid, pos_car_x, pos_car_y, pos_car_z);
		if(IsPlayerInRangeOfPoint(playerid, 5.0, pos_car_x, pos_car_y, pos_car_z) && IsLocked[vehicleid] == true)
		{
			if(VehicleOwner[vehicleid] == INVALID_PLAYER_ID || PI[playerid][pCarTheft] != vehicleid) continue;
			for(new idx; idx < 10; idx++) SendClientMessage(playerid, -1, " ");

			SendClientMessage(playerid, -1, ""cDA"Вы начали взлом автомобиля отмычками");
			SendClientMessage(playerid, -1, ""cDA"Справа от Вас имеется шкала взлома. Для успешного взлома автомобиля, она должна быть полностью заполнена");
			SendClientMessage(playerid, -1, ""cDA"Имейте ввиду, что взлом может оказаться неудачным");
			SendClientMessage(playerid, -1, ""cDA"Действуйте быстро и без лишних свидетелей, дабы не иметь проблем с законом");

			car_break_status[playerid] = true;
			car_break_count[playerid] = 0;

			for(new idx; idx < sizeof cbreak_td_global; idx++) TextDrawShowForPlayer(playerid, cbreak_td_global[idx]);

			PlayerTextDrawSetString(playerid, cbreak_td_player[playerid], "0%");
			PlayerTextDrawShow(playerid, cbreak_td_player[playerid]);

			SetPlayerAnimation(playerid, 1380);
			MeAction(playerid, "начинает взлом замка автомобиля");

			car_break_timer[playerid] = SetTimerEx("callback_car_break", 100, 1, "i", playerid);

			cbreak_car_pos_x[playerid] = pos_car_x;
			cbreak_car_pos_y[playerid] = pos_car_y;
			cbreak_car_pos_z[playerid] = pos_car_z;
			cbreak_car_id[playerid] = vehicleid;

			PI[playerid][pLockPicks] = 0;

			UpdatePlayerData(playerid, "LockPick", PI[playerid][pLockPicks]);
			return 1;
		}
	}
	return 1;
}

callback::callback_car_break(playerid)
{
	if(car_break_status[playerid] == true)
	{
		if(c_break_time[playerid] > unix) return 1;
		if(IsPlayerInRangeOfPoint(playerid, 5.0, cbreak_car_pos_x[playerid], cbreak_car_pos_y[playerid], cbreak_car_pos_z[playerid]))
		{
			if(car_break_count[playerid] >= 99.0)
			{
				new r = random(6);

				switch(r)
				{
				case 0..2:
					{
						CarDoorsEx(cbreak_car_id[playerid], 0);
						SendClientMessage(playerid, -1, ""cDA"Автомобиль успешно взломан");
						SendClientMessage(playerid, -1, ""cDA"Советуем Вам как можно скорее убираться от сюда, пока Вас не заметила полиция");

						car_break_count[playerid] = 0;
						car_break_status[playerid] = false;

						ClearAnimations(playerid);
						KillTimer(car_break_timer[playerid]);

						for(new idx; idx < sizeof cbreak_td_global; idx++) TextDrawHideForPlayer(playerid, cbreak_td_global[idx]);
						PlayerTextDrawHide(playerid, cbreak_td_player[playerid]);
					}
				case 3..5:
					{
						for(new idx; idx < sizeof cbreak_td_global; idx++) TextDrawHideForPlayer(playerid, cbreak_td_global[idx]);
						PlayerTextDrawHide(playerid, cbreak_td_player[playerid]);

						SendClientMessage(playerid, -1, ""cER"Вам не удалось взломать замок автомобиля..");
						SendClientMessage(playerid, -1, ""cER"Отмычка сорвалась и поранила Вам руку");
						SendClientMessage(playerid, -1, ""cER"Ваши противозаконные действия заметила полиция");

						car_break_count[playerid] = 0;
						car_break_status[playerid] = false;

						KillTimer(car_break_timer[playerid]);

						PI[playerid][pWanted]++;
						SetPlayerWantedLevel(playerid, PI[playerid][pWanted]);
						SetPlayerCriminal(playerid, "Неизвестный", "Попытка взлома автомобиля");
						ClearAnimations(playerid);
					}
				}
			}
			else
			{
				car_break_count[playerid] += 5.0;
				c_break_time[playerid] = unix + 1;
				SetPlayerAnimation(playerid, 1380);
				new fmt_str[10];
				format(fmt_str, sizeof fmt_str, "%d%", floatround(car_break_count[playerid]));
				PlayerTextDrawSetString(playerid, cbreak_td_player[playerid], fmt_str);

				PlayerTextDrawShow(playerid, cbreak_td_player[playerid]);
			}
		}
	}
	return 1;
}

callback::CheckKillerList(playerid, type)
{
	if(cache_num_rows())
	{
		if(type == 0)
		{
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `hitman` SET `ONLINE` = '-1' WHERE `vID` = '%d'", PI[playerid][pID]);
			mysql_tquery(db_prod, STRING_GLOBAL);
		}
		if(type == 1)
		{
			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `hitman` SET `ONLINE` = '%d' WHERE `vID` = '%d'", playerid, PI[playerid][pID]);
			mysql_tquery(db_prod, STRING_GLOBAL);

			PlayerUseVictim[playerid] = 1;
		}
	}
	return 1;
}

callback::CheckHelicopterLoad(playerid)
{
	if(cache_num_rows())
	{
		format(stringer1, 128, "SELECT * FROM `helicopters` WHERE h_owner = '%s'", GetName(playerid));
		mysql_tquery(db_prod, stringer1, "LoadHelicopter", "i", playerid);
	}
	return 1;
}

callback::LoadPlayerItem(playerid)
{
	new rows = cache_num_rows();
	if(rows)
	{
		for(new f=1,st[16],st2[16],st3[40],maximum[11];f<MAX_SLOT;f++)
		{
			new Value[32];
			format(st,sizeof(st),"Slot%d",f);
			format(st2,sizeof(st2),"Amt%d",f);
			format(st3,sizeof(st3),"Value%d",f);
			cache_get_field_content(0, st, maximum), PlayerItem1[playerid][f] = strval(maximum);
			cache_get_field_content(0, st2, maximum), PlayerItem2[playerid][f] = strval(maximum);
			cache_get_field_content(0, st3, Value); format(PlayerItem3[playerid][f],32,"%s",Value);
		}
	}
	else if(!rows)
	{
		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `inventory` (`Name`) VALUES ('%e')", GetName(playerid));
		mysql_tquery(db_prod, STRING_GLOBAL);
		ResetItem(playerid);
	}
	return true;
}

callback::SaveItem(p,i)
{
	if(PlayerItem1[p][i]<0){PlayerItem1[p][i]=0;}
	if(PlayerItem2[p][i]<=0)
	{
		PlayerItem1[p][i]=0;
		PlayerItem2[p][i]=0;
		nstrmid(PlayerItem3[p][i],"");
	}
	format(global_string,sizeof(global_string),"UPDATE `inventory` SET `Slot%d`='%d', `Amt%d`='%d', `Value%d`='%s' WHERE `Name` = '%s'",i,PlayerItem1[p][i],i,PlayerItem2[p][i],i,PlayerItem3[p][i],GetName(p));
	mysql_tquery(db_prod,global_string,"","");
	return true;
}
ResetItem(playerid)
{
	for(new f=1;f<MAX_SLOT;f++)
	{
		PlayerItem1[playerid][f]=0;
		PlayerItem2[playerid][f]=0;
		nstrmid(PlayerItem3[playerid][f],"");
	}
}
SaveAccount(playerid) //kakaxa
{
	if(PlayerLogged[playerid] == false || IsPlayerConnected(playerid) == 0) return 1;

	new weapon_player[13], ammo_player[13];

	mysql_format(db_prod, global_string, 1000, "UPDATE accounts SET RefTime=%i, age=%d, phnumber1=%d, phnumber2=%d, phnumber3=%d, phnumber5=%d, phnumber6=%d, phnumber7=%d, phnumber8=%d, mats=%d, phonebalance=%d, datavhod='%d.%d.%d', jail=%d, mute=%d, wanted=%d, time=%d, checktime=%d, paycheck=%d, jailtime=%d, exp=%d, cash=%d, ip='%s', level=%d, guns='%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d', ammos='%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d', online='1001', scoreivent=%d WHERE id=%d LIMIT 1",
	PI[playerid][pRefTime], PI[playerid][pAge], PhoneNumbers[playerid][0], PhoneNumbers[playerid][1], PhoneNumbers[playerid][2], PhoneNumbers[playerid][4], PhoneNumbers[playerid][5], PhoneNumbers[playerid][6], PhoneNumbers[playerid][7],
	PI[playerid][pMats], PI[playerid][pPhoneBalance], day, month, year,
	PI[playerid][pJail], PI[playerid][pMuted], PI[playerid][pWanted], PI[playerid][pTime], PI[playerid][pCheckTime], PI[playerid][pPayCheck],
	PI[playerid][pJailTime], PI[playerid][pExp], PI[playerid][pCash], PI[playerid][pIP], PI[playerid][pLevel],
	weapon_player[0], weapon_player[1], weapon_player[2], weapon_player[3],
	weapon_player[4], weapon_player[5], weapon_player[6], weapon_player[7],
	weapon_player[8], weapon_player[9], weapon_player[10], weapon_player[11],
	weapon_player[12], ammo_player[0], ammo_player[1], ammo_player[2], ammo_player[3],
	ammo_player[4], ammo_player[5], ammo_player[6], ammo_player[7],
	ammo_player[8], ammo_player[9], ammo_player[10], ammo_player[11], ammo_player[12], PI[playerid][pScoreIvent], PI[playerid][pID]);
	mysql_tquery(db_prod, global_string, "", "");

	format(global_string, 300, "UPDATE accounts_online SET online_monday=%d,online_tuesday=%d,online_wednesday=%d,online_thursday=%d,online_friday=%d,online_saturday=%d,online_sunday=%d WHERE id=%d",
	g_player_online[playerid][2],g_player_online[playerid][3],g_player_online[playerid][4],g_player_online[playerid][5],g_player_online[playerid][6],g_player_online[playerid][0],g_player_online[playerid][1],PI[playerid][pID]);
	mysql_tquery(db_prod, global_string);
	return 1;
}
