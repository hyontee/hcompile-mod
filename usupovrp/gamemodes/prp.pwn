{
	if(!response) return ShowCupboard(playerid);
	new patr;
	if(sscanf(inputtext, "i", patr) || !(1 <= patr <= 500))
	{
		SendErr(playerid, "Введите число от 1 до 500");
		ShowCupboard(playerid);
		return 1;
	}
	new id = safeid[playerid], ok = SearchInventoryItem(playerid, 42);
	if(HouseInfo[id][hPatrons] + patr > 1500) return SendClientMessage(playerid, COLOR_GREY, "Сейф может вместить только 1500 патронов");
