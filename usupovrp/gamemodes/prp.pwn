CMD:referals(playerid) //kakaxa
{
	new string_query[128];
	format(string_query, sizeof(string_query), "SELECT `name`, `RefTime` FROM `accounts` WHERE `referal` = '%s' ORDER BY `RefTime` DESC LIMIT 10", GetName(playerid));
	new Cache:result = mysql_query(db_prod, string_query);

	new string_number = cache_num_rows();
	if(string_number == 0)
	{
		SendClientMessage(playerid, -1, ""cER"У вас отсутствуют рефералы");
		cache_delete(result);
		return 0x1;
	}

	new ReferalTime;
	STRING_GLOBAL[0] = EOS;
	PlayerReferalList[playerid] = 0;
	new ReferalName[MAX_PLAYER_NAME];
	for(new i = 0; i != string_number; i ++)
	{
		cache_get_field_content(i, "name", ReferalName, db_prod, 24);
		ReferalTime = cache_get_field_content_int(i, "RefTime");

		if(ReferalTime < 43200)
		{
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cWH"Ник: "cMain"%s "cWH"| Время: "cMain"%s "cWH"| Награда: "cMain"Не получена\n", STRING_GLOBAL, ReferalName, ConvertSeconds(ReferalTime));
		}
		if(ReferalTime >= 43200)
		{
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cWH"Ник: "cMain"%s "cWH"| Время: "cMain"%s "cWH"| Награда: "cMain"Получена\n", STRING_GLOBAL, ReferalName, ConvertSeconds(ReferalTime));
		}
	}
	if(string_number >= 10) strcat(STRING_GLOBAL, "{FF0000}Следущая страница");
	ShowPlayerDialog(playerid, 2536, DIALOG_STYLE_LIST, ""cMain"Мои Рефералы", STRING_GLOBAL, "Принять", "Закрыть");
	cache_delete(result);
	return 0x1;
}

DLG(2536, playerid, response, listitem, inputtext[]) //kakaxa
{
	if(!response) return 0x1;
	if(listitem == 10) PlayerReferalList[playerid] += 10;

	new string_query[128];
	format(string_query, sizeof(string_query), "SELECT `name`, `RefTime` FROM `accounts` WHERE `referal` = '%s' ORDER BY `RefTime` DESC LIMIT %i, 10", GetName(playerid), PlayerReferalList[playerid]);
	new Cache:result = mysql_query(db_prod, string_query);

	new string_number = cache_num_rows();
	if(string_number == 0)
	{
		SendClientMessage(playerid, -1, ""cER"У вас отсутствуют рефералы");
		cache_delete(result);
		return 0x1;
	}

	new ReferalTime;
	STRING_GLOBAL[0] = EOS;
	PlayerReferalList[playerid] = 0;
	new ReferalName[MAX_PLAYER_NAME];
	for(new i = 0; i != string_number; i ++)
	{
		cache_get_field_content(i, "name", ReferalName, db_prod, 24);
		ReferalTime = cache_get_field_content_int(i, "RefTime");

		if(ReferalTime < 43200)
		{
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cWH"Ник: "cMain"%s "cWH"| Время: "cMain"%s "cWH"| Награда: "cMain"Не получена\n", STRING_GLOBAL, ReferalName, ConvertSeconds(ReferalTime));
		}
		if(ReferalTime >= 43200)
		{
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cWH"Ник: "cMain"%s "cWH"| Время: "cMain"%s "cWH"| Награда: "cMain"Получена\n", STRING_GLOBAL, ConvertSeconds(ReferalTime), ReferalTime);
		}
	}
	strcat(STRING_GLOBAL, "{FF0000}Следущая страница\n");
	ShowPlayerDialog(playerid, 2536, DIALOG_STYLE_LIST, ""cMain"Мои Рефералы", STRING_GLOBAL, "Принять", "Закрыть");
	cache_delete(result);
	return 0x1;
}

