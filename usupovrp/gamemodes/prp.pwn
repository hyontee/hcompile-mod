DLG(1266, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		switch(listitem)
		{
		case 0:
			{
				callcmd::close(playerid, "");
			}
		case 1:
			{
				ShowPlayerDialog
				(
				playerid, 9956, DIALOG_STYLE_INPUT,
				""cMain"Изменение ранга доступа к складу",
				""cWH"Введите ранг, с которого будет доступен склад",
				"Далее", "Отмена"
				);
			}
		}
	}
	return 1;
}
DLG(9956, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(strlen(inputtext) != 1 || !(1 <= strval(inputtext) <= 10))
		{
			return ShowPlayerDialog
			(
			playerid, 9956, DIALOG_STYLE_INPUT,
			""cMain"Изменение ранга доступа к складу",
			""cWH"Введите ранг, с которого будет доступен склад",
			"Далее", "Отмена"
			);
		}

		new rang = strval(inputtext);

		UseStockRang[ GetSkladID(PI[playerid][pMember]) ] = rang;

		global_string = "";
		format(global_string, 144, "Теперь доступ к складу осуществляется с %d ранга", rang);
		SendClientMessage(playerid, 0xFFCC00AA, global_string);


		global_string = "";
		format(global_string, 200, "UPDATE gang SET stock_rang='%d,%d,%d,%d,%d,%d,%d,%d'", UseStockRang[0],UseStockRang[1],UseStockRang[2],UseStockRang[3],UseStockRang[4],UseStockRang[5],UseStockRang[6],UseStockRang[7]);
		mysql_tquery(db_prod, global_string);

	}
	return 1;
}
DLG(2259, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(g_pubg_status != 1) return SendClientMessage(playerid, COLOR_RED, "К сожалению регистрация закрыта");
		if(g_pubg_count >= 100) return SendClientMessage(playerid, COLOR_RED, "Места для игры не осталось");
		if(playerGamePubg{playerid}) return SendClientMessage(playerid, COLOR_RED, "Вы уже участвуете в этом мероприятии");

		g_pubg_count++;
		g_player_pubg_kills[playerid] = 0;
		playerGamePubg{playerid} = 1;
		SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно зарегистрировались на Battle Royale");
	}
	return 1;
}


DLG(2260, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(gDerbyStatus != 1) return SendClientMessage(playerid, COLOR_RED, "К сожалению регистрация закрыта");

		if(gDerbyCount >= 10) return SendClientMessage(playerid, COLOR_RED, "Места для игры не осталось");

		if(playerGameDerby{playerid}) return SendClientMessage(playerid, COLOR_RED, "Вы уже участвуете в этом мероприятии");

		gDerbyCount++;

		playerGameDerby{playerid} = 1;

		SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно зарегистрировались на дерби, ожидайте начала.");
	}
	return 1;
}

DLG(2261, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(gSkyDivingStatus != 1) return SendClientMessage(playerid, COLOR_RED, "К сожалению регистрация закрыта");

		if(gSkyDivingCount >= 50) return SendClientMessage(playerid, COLOR_RED, "Места для игры не осталось");

		if(playerGameSkyDiving{playerid}) return SendClientMessage(playerid, COLOR_RED, "Вы уже участвуете в этом мероприятии");

		gSkyDivingCount++;

		playerGameSkyDiving{playerid} = 1;

		SendClientMessage(playerid, 0xFFCC00AA, "Вы успешно зарегистрировались на прыжки с парашюта, ожидайте начала.");
	}
	return 1;
}

DLG(19020, playerid, response, listitem, inputtext[])
{
	new query_string [ 140 ] ;
	if ( ! response )
	{
		for ( new i = 0 ; i < 10 ; i ++ )
		{
			g_player_members_name[i][playerid][0] = EOS;
		}
		return 1 ;
	}
	if ( listitem == 0 )
	{
		new page_id = ofm_list_page[playerid] - 1;
		if ( page_id == 0 )
		{
			mysql_format ( db_prod, query_string, sizeof query_string, "SELECT `name`,`rank`,`datavhod` FROM `accounts` WHERE `member` = '%d' AND `online` = '1001'", PI[playerid][pMember]) ;
			mysql_tquery ( db_prod, query_string, "callback_offmembers", "i", playerid ) ;
			return 1 ;

		}
		ofm_list_page[playerid] = page_id;
		mysql_format ( db_prod, query_string, sizeof query_string, "SELECT `name`,`rank`,`datavhod` FROM `accounts` WHERE `member` = '%d' AND `online` = '1001'", PI[playerid][pMember]) ;
		mysql_tquery ( db_prod, query_string, "callback_offmembers", "i", playerid ) ;

	}
	else if ( listitem == 1 )
	{
		new page_id = ofm_list_page[playerid] - 1 ;
		if ( ( page_id + 1 ) * 10 >= ofm_list_rows[playerid] )
		{
			mysql_format ( db_prod, query_string, sizeof query_string, "SELECT `name`,`rank`,`datavhod` FROM `accounts` WHERE `member` = '%d' AND `online` = '1001'", PI[playerid][pMember]) ;
			mysql_tquery ( db_prod, query_string, "callback_offmembers", "i", playerid ) ;

			return 1 ;
		}
		ofm_list_page[playerid] = page_id + 2;
		mysql_format ( db_prod, query_string, sizeof query_string, "SELECT `name`,`rank`,`datavhod` FROM `accounts` WHERE `member` = '%d' AND `online` = '1001'", PI[playerid][pMember]) ;
		mysql_tquery ( db_prod, query_string, "callback_offmembers", "i", playerid ) ;
	}
	else
	{
		new pl_name [ 20 ];
		strcat(pl_name, g_player_members_name[listitem - 2][playerid]);

		ofm_listitem[playerid] = listitem - 2 ;
		new fmt_str [ 128 ];

		format(fmt_str, sizeof fmt_str, ""cWH"Вы действительно хотите уволить {DCC13D}%s "cWH"из организации?", pl_name);
		format(ofm_step_2[playerid], 30, pl_name);
		ShowPlayerDialog(playerid, 19020+1, DIALOG_STYLE_MSGBOX, ""cMain"Уволить из организации", fmt_str, "Да", "Нет");
	}
	return 1 ;
}
DLG(19021, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new pl_name [ 20 ] ;
	format(pl_name, 20, ofm_step_2[playerid]);

	global_string = "";
	mysql_format(db_prod, global_string, 128, "SELECT name, leader FROM accounts WHERE name = '%s'", pl_name);
	mysql_tquery(db_prod, global_string, "KickMemberFromFraction", "is", playerid, pl_name);
	return 1;
}
DLG(707, playerid, response, listitem, inputtext[])
{
	new familyid = PI[ player_family_invite[playerid] ][pFamily];
	if(!familyid) return SendClientMessage(playerid, COLOR_RED, "Произошла ошибка #1");

	global_string="";

	if(!response)
	{
		format(global_string, sizeof(global_string), "Игрок %s[%d] отказался от вашего пришлашения в семью.",GetName(playerid),playerid);
		player_family_invite[playerid] = -1;
	}
	else
	{
		PI[playerid][pFamily] = familyid;
		PI[playerid][pFamilyRank] = 1;
		PI[playerid][pFamilyZam] =
		PI[playerid][pFamilySozd] = 0;

		if(playerFamilyNameTag[playerid] == INVALID_3DTEXT_ID)
		{
			stringer1 = "";
			strcat(stringer1, family_info[familyid][f_name]);
			strcat(stringer1, ""cWH" ");
			strcat(stringer1, "Family");
			playerFamilyNameTag[playerid] = CreateDynamic3DTextLabel(stringer1, gFamilyColor[family_info[familyid][f_chat_color]], 0.0, 0.0, 0.5, 10.0, playerid, INVALID_VEHICLE_ID, 1);
		}

		format(global_string,sizeof(global_string),"{%s}[%s]{FFD39B} %s[%d] вступил в семью",family_chat_color [family_info[familyid][f_chat_color ]],family_info[familyid][f_name],GetName(playerid),playerid);
		family_message(familyid,-1, global_string);

		format(global_string, sizeof global_string, "UPDATE `accounts` SET `family` = '%d', familyzam=0, familyrank=1, familysozd = 0 WHERE `id` = '%d' LIMIT 1", familyid, PI[playerid][pID]);
		mysql_function_query(db_prod, global_string, false, "", "");

		player_family_invite[playerid] = -1;
	}
	return 1;
}
