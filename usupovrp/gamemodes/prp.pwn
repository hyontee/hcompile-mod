	SetTimer("OnVoiceToggle", 200, 1);

	return 1;
}

public OnGameModeInit()
{
	PB_CLEAR();
	settext(PBP_WINNAME,"None");
	Iter_Clear(Vehicle);
	SetGravity(0.009);
	ManualVehicleEngineAndLights();
	EnableStuntBonusForAll(0);
	SetNameTagDrawDistance(24.0);
	ShowPlayerMarkers(2);
	DisableInteriorEnterExits();

	mysql_tquery(db_prod, "DELETE FROM `connections`");
	mysql_tquery(db_prod, "CREATE TABLE IF NOT EXISTS `whitelist` (`id` INT NOT NULL AUTO_INCREMENT, `name` VARCHAR(24) NOT NULL, `added_by` VARCHAR(24) NOT NULL, `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`id`), UNIQUE KEY `name` (`name`)) ENGINE=InnoDB DEFAULT CHARSET=cp1251");

	SendRconCommand("sleep 3");

	for(new idx; idx < 12; idx ++)
	{
		ClearGovData(idx);
		for(new i; i < 4; i ++) g_gov_send_text[idx][i][0] = EOS;
	}
	for(new vehicleid = 0; vehicleid != MAX_VEHICLES; vehicleid ++)
	{
		VehicleFamilyCars[vehicleid] = -1;
	}
	for(new i; i < sizeof(glFamilyCaptPos); i++) CreateFamilySquare(i);
	for(new i; i < MAX_VCARS; i++) VehInfo[i][vVehicle] = INVALID_VEHICLE_ID;

	happy_hours =
	happy_hours_hour =
	happy_h_time =
	happy_hours_time =
	happy_hours_minute =
	gamemodeloaded = 0;

	CreateDynamic3DTextLabel(\
	"[ Создать Семью ]\n\n{ffffff}5.000.000 Рублей\n{cccccc}Нажмите ALT",0xFFFF00FF, 235.8488,-1277.1885,1539.1079, 5.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

	DonateText[0] = CreateDynamic3DTextLabel("\
	{FFFF00}Заберите свой подарок\n\
	{FFFFFF}При пополнение от "cMain"500{FFFFFF} рублей получите в подарок "cMain"30%{FFFFFF} от суммы пополнения\n\
