{
	if(!response)
	{
		ShowPlayerDialog(playerid, 718, DSL, ""cMain"Объявить в розыск", ""cWH"1. Причинение физического вреда здоровью\n2. Вооруженное нападение\n3. Угон транспортного средства\n4. Предложение/подкуп должностного лица\n5. Оружие\n6. Взятие в заложники\n7. Неподчинение\n8. Проникновение на охраняемую территорию\n9. Наркотики\n10. Отказ оплаты штрафа\n11. Мошенничество", "Выбрать", "Закрыть");
