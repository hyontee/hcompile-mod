			else if(PI[playerid][pMember] == TEAM_MVD || PI[playerid][pMember] == TEAM_FSB)
			{
				global_string = "{66CC00}/r "cWH"- рация\n\
				{66CC00}/pull "cWH"- взять под конвой игрока\n\
				{66CC00}/unpull "cWH"- снять игрока с конвоя\n\
				{66CC00}/rn "cWH"- NonRP чат фракции\n\
