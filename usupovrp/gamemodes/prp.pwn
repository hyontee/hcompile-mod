				//if(PI[playerid][pAdmin] > 0) return SendClientMessage(playerid, -1, ""cER"Администрация не может ввести торги на контейнерах");
				if(!containersInfo[idx][coOpen])
				{
					new price = containersInfo[idx][coCost], percent = price * 10 / 100;
					if(containersInfo[idx][coBuyerID] != INVALID_PLAYER_ID) price += percent;
					global_string = "";
					format(global_string, sizeof global_string, ""cWH"Вы готовы начать торги за контейнер?\n\nСтоимость этого контейнера составляет "cMain"%d рублей\n\n"cWH"Введите свою стоимость, но не меньше чем "cMain"%d рублей", containersInfo[idx][coCost], price);
					playerSelectContainer[playerid] = idx;
					ShowPlayerDialog(playerid, 9100, DIALOG_STYLE_INPUT,""cMain"Контейнер",global_string,"Далее", "Отмена");
				}
				else
				{
					if(playerBuyContainer[playerid] != idx) return SendClientMessage(playerid, COLOR_RED, "Вы не купили этот контейнер.");

					global_string = "";
					if(containersInfo[idx][coType] == 0 && PI[playerid][pMember]) containersInfo[idx][coType] = 1 + random(MAX_CONTAINERS_TYPE-1);
					switch(containersInfo[idx][coType])
					{
					case 0:
						{
							new skin = containers_skins[random(sizeof containers_skins)];
							SetPlayerSkin(playerid, skin);
							PlayerContainerSkin[playerid] = skin;
							ShowPlayerDialog(playerid, 9101, DIALOG_STYLE_MSGBOX,""cMain"Скин",""cWH"Вы хотите оставить этот скин?\nЕсли нет, то он будет продан за 1.000.000 рублей","Да", "Нет");
						}
					case 1:
						{
							new model_id = carsC[  random(sizeof(carsC)) ][0];
							SCMF(playerid, 0xFFCC00AA, "Контейнер содержал: автомобиль %s", VehicleNames[model_id-400]);
							format(stringer1, 128, "SELECT `id` FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(playerid));
							mysql_tquery(db_prod, stringer1, "CountCars_Containers","ii",playerid, model_id);
						}
					case 2:
						{
							new model_ids[] = {480, 503};
							new model_id = model_ids[random(sizeof model_ids)];
							SCMF(playerid, 0xFFCC00AA, "Контейнер содержал: автомобиль %s", VehicleNames[model_id-400]);
							format(stringer1, 128, "SELECT `id` FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(playerid));
							mysql_tquery(db_prod, stringer1, "CountCars_Containers","ii",playerid, model_id);
						}
					case 3:
						{
							new count = random(10) + 5;
							SCMF(playerid, 0xFFCC00AA, "Контейнер содержал: %d слитков ("SERVER_COINS") ", count);
							PI[playerid][pPerfectCoins] += count;
							UpdatePlayerData(playerid, "credits", PI[playerid][pPerfectCoins]);
							fLogs("[coin] %s +%i контейнер", GetName(playerid), count);
						}
					case 4:
						{
							SCM(playerid, 0xFFCC00AA, "Контейнер содержал: набор оружия");
							if(random(2) == 1)
							{
								GivePlayerWeapon(playerid, 3, 1);
								GivePlayerWeapon(playerid, 23, 100);
								GivePlayerWeapon(playerid, 31, 100);
								GivePlayerWeapon(playerid, 29, 100);
								GivePlayerWeapon(playerid, 34, 100);
							}
							else
