DLG(18293, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	for(new idx = 1; idx <= TOTALVEH; idx++)
	{
		if(VehInfo[idx][vID] == f_car_id[playerid])
		{
			SaveMileage();
			if(VehInfo[idx][vVehicle] != INVALID_VEHICLE_ID)
			{
				DestroyVehicle(VehInfo[idx][vVehicle]);
				VehInfo[idx][vVehicle] = INVALID_VEHICLE_ID;
			}
			VehInfo[idx][vModel] = fraction_cars[listitem];
			VehInfo[idx][vVehicle] = CreateVehicle(VehInfo[idx][vModel], VehInfo[idx][vPos_X], VehInfo[idx][vPos_Y], VehInfo[idx][vPos_Z], VehInfo[idx][vPos_FA], VehInfo[idx][vColor][0], VehInfo[idx][vColor][1], 900);
			LinkVehicleToInterior(VehInfo[idx][vVehicle], VehInfo[idx][vInt]);
			SetVehicleVirtualWorld(VehInfo[idx][vVehicle], VehInfo[idx][vWorld]);
			vehicle_mileage[VehInfo[idx][vVehicle]] = VehInfo[idx][vMileage];

			format(global_string, 128, "UPDATE vehicle SET model = '%d' WHERE id = '%d'", fraction_cars[listitem], f_car_id[playerid]);
			mysql_tquery(db_prod, global_string, "", "");
			SendClientMessage(playerid, COLOR_GREEN, "Модель автомобиля изменена");
		}
	}
	return 1;
}
DLG(18292, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	if(!(1 <= strval(inputtext) <= 10)) return ShowPlayerDialog(playerid, 18290+2, DIALOG_STYLE_INPUT, ""cMain"Изменение ранга доступа к автомобилю", ""cWH"Укажите номер ранга, с которого будет доступен данный автомобиль:", "Далее", "Отмена"), SendClientMessage(playerid, COLOR_RED, "Ранг от 1 до 10");

	for(new idx = 1; idx <= TOTALVEH; idx++)
	{
		if(VehInfo[idx][vID] == f_car_id[playerid])
		{
			VehInfo[idx][vDostup] = strval(inputtext);
			global_string = "";

			format(global_string, 128, "UPDATE vehicle SET dostup = '%d' where id = '%d'", strval(inputtext), f_car_id[playerid]);
			mysql_tquery(db_prod, global_string, "", "");

			SendMes(playerid, COLOR_GREEN, "Доступ к данной машине теперь с %d ранга", strval(inputtext));

		}
	}
	return 1;
}
DLG(6266, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new hid = asellhouse_id[playerid];
	fLogs("[admin] %s /asellhouse %i", GetName(playerid), hid);

	new to_player = GetPlayerID(HouseInfo[hid][hOwner]);
	if(to_player != INVALID_PLAYER_ID)
	{
		PI[to_player][pHouse] = -1;
		printf("SELL HOUSE 4: %s", GetName(to_player));
		MysqlUpdatePlayerInt(to_player, "house", PI[to_player][pHouse]);
		SendFormatInf(to_player, "Администратор %s продал Вам дом", GetName(playerid));
		fLogs("[house] %s -%i /asellhouse", GetName(to_player), hid);
	}
	else
	{
		global_string = "";
		mysql_format(db_prod, global_string, 200, "UPDATE accounts SET house=-1 WHERE name='%s'", HouseInfo[hid][hOwner]);
		mysql_tquery(db_prod, global_string);
		MysqlUpdateHouseStr(hid, "hOwner", "None");
	}

	strmid(HouseInfo[hid][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
	HouseInfo[hid][hLock] = 1;
	HouseInfo[hid][hOwned] = -1;
	HouseInfo[hid][hOplata] = HouseInfo[hid][hGarage] = HouseInfo[hid][hAutoDoors] = 0;
	UpdateHouse(hid);
	SendClientMessage(playerid, COLOR_GREEN, "Дом продан");
	asellhouse_id[playerid] = 0;
	return 1;
}
DLG(18275, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new vehicleid = GetPlayerVehicleID(playerid), Float: car_pos_x, Float: car_pos_y, Float: car_pos_z, Float: car_pos_r, Float: distance;

	GetVehicleModelInfo(GetVehicleModel(vehicleid), 1, car_pos_x, distance, car_pos_z);
	distance = distance/2 + 0.1;

	GetVehiclePos(vehicleid, car_pos_x, car_pos_y, car_pos_z);
	GetVehicleZAngle(vehicleid, car_pos_r);

	car_pos_x += (distance * floatsin(-car_pos_r + 180, degrees));
	car_pos_y += (distance * floatcos(-car_pos_r + 180, degrees));

	SendClientMessage(playerid, COLOR_YELLOW, "Вы начали загрузку материалов в машину");
	SendClientMessage(playerid, COLOR_YELLOW, "Следуйте к чекпоинту, чтобы взять ящик с материалами и загрузить его в машину");

	SetPlayerCheckpoint(playerid, -1060.9146,2208.5632,38.0988, 1.0);

	if(materials_text[vehicleid] != INVALID_3DTEXT_ID) return 1;

	global_string = "";

	format(global_string, 200, "Материалов в автомобиле: {68ABE2}%d / 10000\n\nALT - загрузить материалы\n/getmats - начать загрузку материалов\n/unmats - выгрузить материалы", materials_count[vehicleid]);
	materials_text[vehicleid] = CreateDynamic3DTextLabel(global_string, 0xFFFFFFFF, car_pos_x, car_pos_y, car_pos_z, 10.0, INVALID_PLAYER_ID, vehicleid, -1);

	return 1;
}
DLG(6366, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new count = strval(inputtext);

	if(GetPlayerRubble(playerid) < count) return SendClientMessage(playerid, COLOR_RED, "У Вас недостаточно средств для ставки");
	if(!(50000 <= count <= 1000000)) return SendClientMessage(playerid, COLOR_RED, "Недопустимая сумма. Стоит указать ставку от 50,000 до 1,000,000 рублей");

	SendMes(playerid, COLOR_GREEN, "Вы успешно сделали ставку в размере %d руб.", count);

	global_string = "";
	format(global_string, 50, "ставка:_~r~%d_p", count);
	PlayerTextDrawSetString(playerid, casino_td_player[1][playerid], global_string);

	casino_bet[playerid] = count;
	return 1;
}
DLG(6566, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	switch(listitem)
	{
	case 0: callcmd::find(playerid);
