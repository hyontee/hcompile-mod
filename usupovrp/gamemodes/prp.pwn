DLG(165, playerid, response, listitem, inputtext[])
{
	if(!response) { ShowPlayerDialog(playerid,131+34,1,""cMain"Ваш возраст",""cWH"Укажите ваш игровой возраст:","Далее",""); }
	new age;
	if(sscanf(inputtext, "i", age))
	{
		SendClientMessage(playerid,COLOR_LIME,"Возраст пишите цифрами. Например: 17");
		ShowPlayerDialog(playerid,131+34,1,""cMain"Ваш возраст",""cWH"Укажите ваш игровой возраст:","Далее","");
		return 1;
	}
	if(age < 16 || age > 80)
	{
		SendClientMessage(playerid,COLOR_LIME,"Возраст не может быть меньше 16 и не больше 80!");
		ShowPlayerDialog(playerid,131+34,1,""cMain"Ваш возраст",""cWH"Укажите ваш игровой возраст:","Далее","");
		return 1;
	}
	PI[playerid][pAge] = age;
	ClothesRound[playerid] = 1;
	PlayerRegistered[playerid] = 1;
	playerReg{playerid} = 0;
	SendClientMessage(playerid, COLOR_LIME, "Выберите одежду для вашего будущего персонажа:");
	SetPlayerHealth(playerid, 100);
	PlayerLogged[playerid] = true;
	SpawnPlayer(playerid);
	return 1;
}
DLG(169, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(GetPlayerData(playerid, SalonCarID) == INVALID_VEHICLE_ID) return 1;

	DestroyVehicle(GetPlayerData(playerid, SalonCarID));
	SetPlayerData(playerid, SalonCarID, INVALID_VEHICLE_ID);
	TogglePlayerControllable(playerid,true);

	for(new i; i < 2; i++) PlayerTextDrawHide(playerid, cshop_PTD[playerid][i]);
	CancelSelectTextDrawEx(playerid);
	for(new i; i < 17; i++) TextDrawHideForPlayer(playerid, cshop_TD[i]);

	if(g_player_salon[playerid] == 1)
	{
		SetPlayerPos(playerid, -18.2327,-5.0809,1201.0000);
		SetPlayerFacingAngle(playerid, 360.0);
		SetPlayerInterior(playerid, 21);
		SetCameraBehindPlayer(playerid);
		SendClientMessage(playerid, COLOR_RED, "Вы отменили покупку транспорта");
	}
	if(g_player_salon[playerid] == 2)
	{
		SetPlayerPos(playerid, -18.2327,-5.0809,1201.0000);
		SetPlayerFacingAngle(playerid, 360.0);
		SetPlayerInterior(playerid, 21);
		SetCameraBehindPlayer(playerid);
		SendClientMessage(playerid, COLOR_RED, "Вы отменили покупку транспорта");
	}

	SetPlayerVirtualWorld(playerid, g_player_salon[playerid]);
	return 1;
}
DLG(304, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
		case 0:
		{
			if(Setting[playerid][1] == 0) Setting[playerid][1] = 1;
			else Setting[playerid][1] = 0;
		}
		case 1:
		{
			if(Setting[playerid][2] == 0) Setting[playerid][2] = 1;
			else Setting[playerid][2] = 0;
		}
		case 2:
		{
			if(Setting[playerid][3] == 0) Setting[playerid][3] = 1;
			else Setting[playerid][3] = 0;
		}
		case 3:
		{
			if(Setting[playerid][4] == 0) Setting[playerid][4] = 1;
			else Setting[playerid][4] = 0;
		}
		case 4:
		{
			if(Setting[playerid][5] == 0) Setting[playerid][5] = 1;
			else Setting[playerid][5] = 0;
		}
		case 5:
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
			"cMain"1."cWH" ЕВРО\t[%s"cWH"]\n\
			"cMain"2."cWH" Навигатор\t[%s"cWH"]\n\
			"cMain"3."cWH" Информация о сервере\t[%s"cWH"]",
			PI[playerid][pSettingTD][0] ? ("{00FF00}Включено") : ("{FF0000}Выключено"),
			PI[playerid][pSettingTD][1] ? ("{00FF00}Включено") : ("{FF0000}Выключено"),
			PI[playerid][pSettingTD][2] ? ("{00FF00}Включено") : ("{FF0000}Выключено"));
			ShowPlayerDialog(playerid, 5002, DIALOG_STYLE_LIST, ""cMain"Отображение TextDraw", STRING_GLOBAL, "Изменить", "Назад");
			return 0x1;
		}
	}

	if(listitem < 5)
	{
		format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET settings='%d,%d,%d,%d,%d,%d' WHERE id=%d", Setting[playerid][0], Setting[playerid][1], Setting[playerid][2], Setting[playerid][3], Setting[playerid][4], Setting[playerid][5], PI[playerid][pID]);
		mysql_tquery(db_prod, stringer1, "", "");

		global_string = "";
		format(global_string, 1500, "%s\n%s\n%s\n%s\n%s\n"cMain"6."cWH" Отображение TextDraw на экране",
		(Setting[playerid][1] != 1) ? (""cMain"1. "cWH"Авторизация на сервере\t| {63BD4E}TextDraw") : (""cMain"1. "cWH"Авторизация на сервере\t| {63BD4E}Диалог"),
		(Setting[playerid][2] != 1) ? (""cMain"2. "cWH"Покупка домов и бизнесов\t| {63BD4E}TextDraw") : (""cMain"2. "cWH"Покупка домов и бизнесов\t| {63BD4E}Диалог"),
		(Setting[playerid][3] != 1) ? (""cMain"3. "cWH"Меню банка и банкомата\t| {63BD4E}TextDraw") : (""cMain"3. "cWH"Меню банка и банкомата\t| {63BD4E}Диалог"),
		(Setting[playerid][4] != 1) ? (""cMain"4. "cWH"Заправочная станция\t| {63BD4E}TextDraw") : (""cMain"4. "cWH"Заправочная станция\t| {63BD4E}Диалог"),
		(Setting[playerid][5] != 1) ? (""cMain"5. "cWH"Ответ на вопрос/жалобу\t| {63BD4E}Сообщение") : (""cMain"5. "cWH"Ответ на вопрос/жалобу\t| {63BD4E}Диалог"));
		ShowPlayerDialog(playerid, 304, DIALOG_STYLE_LIST, ""cMain"Настройки персонажа", global_string, "Выбрать", "Назад");
	}
	return 1;
}

DLG(5002, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		global_string = "";
		format(global_string, 1500, "%s\n%s\n%s\n%s\n%s\n"cMain"6."cWH" Отображение TextDraw на экране",
		(Setting[playerid][1] != 1) ? (""cMain"1. "cWH"Авторизация на сервере\t| {63BD4E}TextDraw") : (""cMain"1. "cWH"Авторизация на сервере\t| {63BD4E}Диалог"),
		(Setting[playerid][2] != 1) ? (""cMain"2. "cWH"Покупка домов и бизнесов\t| {63BD4E}TextDraw") : (""cMain"2. "cWH"Покупка домов и бизнесов\t| {63BD4E}Диалог"),
		(Setting[playerid][3] != 1) ? (""cMain"3. "cWH"Меню банка и банкомата\t| {63BD4E}TextDraw") : (""cMain"3. "cWH"Меню банка и банкомата\t| {63BD4E}Диалог"),
		(Setting[playerid][4] != 1) ? (""cMain"4. "cWH"Заправочная станция\t| {63BD4E}TextDraw") : (""cMain"4. "cWH"Заправочная станция\t| {63BD4E}Диалог"),
		(Setting[playerid][5] != 1) ? (""cMain"5. "cWH"Ответ на вопрос/жалобу\t| {63BD4E}Сообщение") : (""cMain"5. "cWH"Ответ на вопрос/жалобу\t| {63BD4E}Диалог"));
		ShowPlayerDialog(playerid, 304, DIALOG_STYLE_LIST, ""cMain"Настройки персонажа", global_string, "Выбрать", "Назад");
		return 0x1;
	}
	PI[playerid][pSettingTD][listitem] = (!PI[playerid][pSettingTD][listitem] ? (1) : (0));

	switch(listitem)
	{
		case 0:
		{
			if(RouletteMenuSelectable[playerid] == -1)
			{
				if(!IsPlayerFromThePhone(playerid))
				{
					if(PI[playerid][pSettingTD][0] == 1)
					{
						CPTD_Euro(playerid);
					}

					else RPTD_Euro(playerid);
				}
			}
		}
		case 1:
		{
			if(UseGPS[playerid] == true)
			{
				if(PI[playerid][pSettingTD][1] == 1)
				{
					for(new i; i < 10; i++) TextDrawShowForPlayer(playerid, gps_td_global[i]);
					for(new i; i < 3; i++) PlayerTextDrawShow(playerid, gps_td_player[i][playerid]);
				}
				if(PI[playerid][pSettingTD][1] == 0)
				{
					for(new i; i < 10; i++) TextDrawHideForPlayer(playerid, gps_td_global[i]);
					for(new i; i < 3; i++) PlayerTextDrawHide(playerid, gps_td_player[i][playerid]);
				}
			}
		}
		case 2:
		{
			if(PI[playerid][pSettingTD][2] == 1)
			{
				for(new i; i < 15; i++) TextDrawShowForPlayer(playerid, server_info_td[i]);
			}
			if(PI[playerid][pSettingTD][2] == 0)
			{
				for(new i; i < 15; i++) TextDrawHideForPlayer(playerid, server_info_td[i]);
			}
		}
	}
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `accounts` SET `SettingTD` = '%d|%d|%d|%d' WHERE `id` = '%d'", PI[playerid][pSettingTD][0], PI[playerid][pSettingTD][1], PI[playerid][pSettingTD][2], PI[playerid][pSettingTD][4], PI[playerid][pID]);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");


	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
	"cMain"1."cWH" ЕВРО\t[%s"cWH"]\n\
	"cMain"2."cWH" Навигатор\t[%s"cWH"]\n\
	"cMain"3."cWH" Информация о сервере\t[%s"cWH"]",
	PI[playerid][pSettingTD][0] ? ("{00FF00}Включено") : ("{FF0000}Выключено"),
	PI[playerid][pSettingTD][1] ? ("{00FF00}Включено") : ("{FF0000}Выключено"),
	PI[playerid][pSettingTD][2] ? ("{00FF00}Включено") : ("{FF0000}Выключено"));
	ShowPlayerDialog(playerid, 5002, DIALOG_STYLE_LIST, ""cMain"Отображение TextDraw", STRING_GLOBAL, "Изменить", "Назад");
	return 0x1;
}

DLG(2538, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	switch(listitem)
	{
		case 0: return callcmd::referals(playerid);
		case 1:
		{
			if(PI[playerid][pLevel] >= (BONUS_LVL + 1))
				return SendErr(playerid, "Вы отыграли уже более 2 часов.");

			if(PI[playerid][pRefTime] > 7200)
				return SendErr(playerid, "Вы отыграли уже более 2 часов.");

			if(strcmp(PI[playerid][pReferal], "None") != 0)
				return SendErr(playerid, "У вас уже указан реферал");

			ReferalDialogInput(playerid);
		}
	}
	return 0x1;
}

DLG(310, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::donate(playerid);
	if(PI[playerid][pPerfectCoins] < 60) return SendClientMessage(playerid, -1, ""cER"Недостаточно "SERVER_COINS"!");
	new nickname[24];
	if(sscanf(inputtext, "s[24]", nickname)) return ShowPlayerDialog(playerid, 131+179, 1, ""cMain"Смена ника", ""cWH"Введите будущий ник:", "Принять", "Назад");
	if(strlen(nickname) < 3 || strlen(nickname) > 20) return SendClientMessage(playerid, -1, ""cER"Длина ника не может быть меньше трех и больше 20 символов");
	if(IsLoginInvalid(GetName(playerid))) return SendClientMessage(playerid, -1, ""cER"Имя содержит запрещенные символы или цифры, используйте имя формата Имя_Фамилия на английском");
	if(strfind(nickname, " ", true) != -1) return SendClientMessage(playerid, -1, ""cER"Использовать пробелы запрещено");
	if(strfind(nickname, "_", true) == -1) return SendClientMessage(playerid, -1, ""cER"Новый ник должен быть формата Имя_Фамилия");

	new len = strlen(inputtext);
	if(4 <= len <= 18)
	{
		new bool: valid_name = true;
		for(new idx; idx < len; idx ++)
		{
			switch(inputtext[idx])
			{
				case 'a'..'z', 'A'..'Z', '[', ']', '_': continue;
				default: valid_name = false;
			}
		}
		if(valid_name)
		{
			mysql_format(db_prod, global_string, 128, "SELECT `name` FROM `accounts` WHERE name = '%s'", nickname);
			mysql_tquery(db_prod, global_string, "OnPlayerChangeDonateName", "is", playerid, nickname);
		}
		else
		{
			SendClientMessage(playerid, 0xFF6600FF, "Имя уже используется или содержит недопустимые символы");
			SendClientMessage(playerid, 0xFFFFFFFF, "Используйте латинские буквы a-z A-Z, а также символы [ ] _");
		}
	}
	else SendClientMessage(playerid, 0xFF6600FF, "Длина ника до 4 до 18 символов");
	return 1;
}
DLG(259, playerid, response, listitem, inputtext[])
{
	if(!response) return true;
	new fuel;
	new bizz = BizzInfo[FuelBizzID[playerid]][bTill] / 3;
	if(sscanf(inputtext, "i",fuel)) return ShowPlayerDialog(playerid, 131+128, DIALOG_STYLE_INPUT, ""cMain"Топливо", ""cWH"Введите количество литров топлива:", "Принять", "Отмена");
	if(fuel < 1 || fuel > 45)
	{
		SendClientMessage(playerid, COLOR_GREY, "Топлива от 1 до 45 литров!");
		return ShowPlayerDialog(playerid, 131+128, DIALOG_STYLE_INPUT, ""cMain"Топливо", ""cWH"Введите количество литров топлива:", "Принять", "Отмена");
	}
	if(fuel+Fuel[GetPlayerVehicleID(playerid)] > 45)
	{
		SendMes(playerid, COLOR_DARKORANGE, "Слишком много топлива. Рекомендуем: %d литров", 45-Fuel[GetPlayerVehicleID(playerid)]);
		return ShowPlayerDialog(playerid, 131+128, DIALOG_STYLE_INPUT, ""cMain"Топливо", ""cWH"Введите количество литров топлива:", "Принять", "Отмена");
	}
	new price = fuel*bizz;
	if(GetPlayerRubble(playerid) < price)
	{
		ShowPlayerDialog(playerid, 131+128, DIALOG_STYLE_INPUT, ""cMain"Топливо", ""cWH"Введите количество литров топлива:", "Принять", "Отмена");
		return SCMF(playerid, -1, "У вас не хватает денег. Нужно %d вирт", price);
	}
	SetPlayerMoney(playerid, -price);
	if(BizzInfo[FuelBizzID[playerid]][bProduct] > 0)
	{
		BizzPay[FuelBizzID[playerid]] += price/2;
		BizzInfo[FuelBizzID[playerid]][bMoney] += price/2;
		BizzInfo[FuelBizzID[playerid]][bProduct] -= fuel;
		MysqlUpdateBizzInt(BizzInfo[FuelBizzID[playerid]][bID], "product", BizzInfo[FuelBizzID[playerid]][bProduct]);
	}
	FuelBizzID[playerid] = 0;
	SendClientMessage(playerid, COLOR_LIME, "Транспорт заправляется, пожалуйста подождите");
	Refueling[playerid] = fuel;
	TogglePlayerControllable(playerid, false);
	ReFuelTimer[playerid] = SetTimerEx("ReFill", 500, true, "i", playerid);
	return true;
}
DLG(262, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
		case 0:
		{
			new price, bank;
			if(sscanf(inputtext, "i",price) || !(0 <= price <= 999999999)) return ShowPlayerDialog(playerid, 131+133, 1, ""cMain"Положить деньги", ""cWH"Введите количество денег:", "Положить", "Назад");
			if(price < 1 || price > GetPlayerRubble(playerid))
			{
				SendMes(playerid, COLOR_GREY, "Количество доллларов от 1 до %d!", GetPlayerRubble(playerid));
				return ShowPlayerDialog(playerid, 131+133, 1, ""cMain"Положить деньги", ""cWH"Введите количество денег:", "Положить", "Назад");
			}
			if(PI[playerid][pMember] == TEAM_SMI) bank = FracBank[8];
			if(PI[playerid][pMember] == TEAM_OBLASTADMIN) bank = FracBank[9];
			new sbank = bank+price;
			SendMes(playerid, COLOR_BLUE, "Вы положили %dр в сейф. Теперь в сейфе: %dр", price, sbank);

			SetPlayerMoney(playerid, -price);
			if(PI[playerid][pMember] == TEAM_SMI) MysqlUpdateOtherInt("lsnbank", FracBank[8]),FracBank[8]+=price;
			if(PI[playerid][pMember] == TEAM_OBLASTADMIN) SetMeriaCash(price);
			return 1;
		}
		case 1:
		{
			if(PlayerLogged[playerid] == false) return 1;
			if(PI[playerid][pLeader] > 0)
			{
				new price, bank;
				if(sscanf(inputtext, "i",price) || !(0 <= price <= 999999999)) return ShowPlayerDialog(playerid, 131+132, 1, ""cMain"Снять деньги", ""cWH"Введите количество денег:", "Обналичить", "Назад");
				if(PI[playerid][pMember] == TEAM_SMI) bank = FracBank[8];
				if(PI[playerid][pMember] == TEAM_OBLASTADMIN) bank = FracBank[9];
				if(price < 1 || price > bank)
				{
					SendMes(playerid, COLOR_GREY, "Количество денег от 1 до %d!", bank);
					return ShowPlayerDialog(playerid, 131+132, 1, ""cMain"Снять деньги", ""cWH"Введите количество денег:", "Обналичить", "Назад");
				}
				SendMes(playerid, COLOR_BLUE, "Вы взяли %dр из сейфа. Остаток: %dр", price, bank-price);

				SetPlayerMoney(playerid, price);
				if(PI[playerid][pMember] == TEAM_SMI) MysqlUpdateOtherInt("lsnbank", FracBank[8]),FracBank[8]-=price;
				if(PI[playerid][pMember] == TEAM_OBLASTADMIN)
				{
					FracBank[9]-=price;
					MysqlUpdateOtherInt("sfnbank", FracBank[9]);
				}
			}
		}
	}
	return 1;
}
DLG(263, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(PlayerLogged[playerid] == false) return 1;
		if(PI[playerid][pLeader] > 0)
		{
			new price, bank;
			if(sscanf(inputtext, "i",price) || !(0 <= price <= 999999999)) return ShowPlayerDialog(playerid, 131+132, 1, ""cMain"Снять деньги", ""cWH"Введите количество денег:", "Обналичить", "Назад");
			if(PI[playerid][pMember] == TEAM_SMI) bank = FracBank[8];
			if(PI[playerid][pMember] == TEAM_OBLASTADMIN) bank = FracBank[9];
			if(price < 1 || price > bank)
			{
				SendMes(playerid, COLOR_GREY, "Количество денег от 1 до %d!", bank);
				return ShowPlayerDialog(playerid, 131+132, 1, ""cMain"Снять деньги", ""cWH"Введите количество денег:", "Обналичить", "Назад");
			}
			SendMes(playerid, COLOR_BLUE, "Вы взяли %dр из сейфа. Остаток: %dр", price, bank-price);

			SetPlayerMoney(playerid, price);
			if(PI[playerid][pMember] == TEAM_SMI) MysqlUpdateOtherInt("lsnbank", FracBank[8]),FracBank[8]-=price;
			if(PI[playerid][pMember] == TEAM_OBLASTADMIN)
			{
				FracBank[9] -= price;
				MysqlUpdateOtherInt("sfnbank", FracBank[9]);
			}
		}
		else SendClientMessage(playerid,COLOR_GREY,"Вы не лидер");
	}
	return 1;
}
