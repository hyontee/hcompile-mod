					{66CC00}/nabor "cWH"- набор во фракцию (писать одним сообщением)\n";
				}
			}
			else if(IsAMafia(playerid))
			{
				global_string = "{66CC00}/mc "cWH"- чат мафиози\n\
				{66CC00}/mcn "cWH"- OOC чат мафиози\n\
				{66CC00}/f "cWH"- чат фракции\n\
				{66CC00}/fn "cWH"- NonRP чат фракции\n\
