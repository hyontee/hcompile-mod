stock ShowLogDialogAC(playerid, fname[], date[], page = 0)
{
    format(GlobalString, sizeof(GlobalString), "anticheat/%s/%s.txt", fname, date);
	new File:fileid = fopen(GlobalString, io_readwrite);
	if(fileid)
	{
	    GlobalString = "{FFFFFF}Name\t{FFFFFF}Reason\t{FFFFFF}Date\t{FFFFFF}Data\n";
	    new astring[120], name[24], aip[16], reason[32], adate[24], ping, Float:loss, anpos[56], count, next;
	    while(fread(fileid, astring))
	    {
	    	if((page + 1) * MAX_DLIST <= count < ((page + 1) * MAX_DLIST) + MAX_DLIST) next++;
	        if((page * MAX_DLIST) <= count < (page * MAX_DLIST) + MAX_DLIST)
			{
			    strdel(astring, (strlen(astring) - 4), strlen(astring));
			    sscanf(astring, "p<|>s[24]s[16]s[32]s[24]ifs[56]", name, aip, reason, adate, ping, loss, anpos);
				format(GlobalString, sizeof(GlobalString), "%s%s[%s]\t%s\t%s\t%i | %f | %s\n", GlobalString, name, aip, reason, adate, ping, loss, anpos);
			}
	        count++;
		}
		fclose(fileid);
		
		strcat(GlobalString, "-----------------\n");
	    if(next) strcat(GlobalString, "Next page\n");
		if(page) strcat(GlobalString, "Last page");
		
		playerLogDialogPage[playerid] = page;
		format(playerLogDialogName[playerid], 16, fname);
		format(playerLogDialogDate[playerid], 12, date);
		
		format(astring, sizeof(astring), "{FFFFFF}Page: %i", page);
	    ShowPlayerDialog(playerid, 6151, DIALOG_STYLE_TABLIST_HEADERS, astring, GlobalString, "Select", "Close");
  	}
}

