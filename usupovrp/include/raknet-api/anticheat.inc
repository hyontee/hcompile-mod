public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    if(!(BULLET_HIT_TYPE_NONE <= hittype <= BULLET_HIT_TYPE_PLAYER_OBJECT) || !(22 <= weaponid <= 34) || playerPaused[playerid] > 3 || fX != fX || fY != fY || fZ != fZ) return 0;
    new Float:pos_px, Float:pos_py, Float:pos_pz, Float:pos_sx, Float:pos_sy, Float:pos_sz;
	GetPlayerLastShotVectors(playerid, pos_px, pos_py, pos_pz, pos_sx, pos_sy, pos_sz);
	if(pos_px != pos_px || pos_py != pos_py || pos_pz != pos_pz || pos_sx != pos_sx || pos_sy != pos_sy || pos_sz != pos_sz || floatabs(pos_px) >= 35000.0 || floatabs(pos_py) >= 35000.0 || floatabs(pos_pz) >= 35000.0 || floatabs(pos_sx) >= 35000.0 || floatabs(pos_sy) >= 35000.0 || floatabs(pos_sz) >= 35000.0) return 0;

	if(hittype != BULLET_HIT_TYPE_NONE && (floatabs(fX) >= 1000.0 || floatabs(fY) >= 1000.0 || floatabs(fZ) >= 1000.0))
	{
		CheatDetected(playerid, AC_CRASH1);
		return 0;
	}
	if(playerCheckWeapon{playerid} <= 0)
	{
		new weap, ammo;
	  	GetPlayerWeaponData(playerid, WeaponSlots[weaponid], weap, ammo);
	    playerAmmo[playerid][WeaponSlots[weaponid]]--;
	    if(ammo > (playerAmmo[playerid][WeaponSlots[weaponid]] + 20)) CheatDetected(playerid, AC_AMMO);
	    if(weaponid != playerWeaponID[playerid][WeaponSlots[weaponid]]) CheatDetected(playerid, AC_WEAPON);
 	}
	switch(hittype)
	{
		case BULLET_HIT_TYPE_PLAYER:
		{
			if(!BulletInPlayer(playerid, weaponid, hitid, fX, fY, fZ, pos_px, pos_py, pos_pz, pos_sx, pos_sy, pos_sz)) return 0;
		}
		case BULLET_HIT_TYPE_VEHICLE: if(!GetVehicleModel(hitid)) return 0;
		case BULLET_HIT_TYPE_OBJECT: if(!IsValidObject(hitid)) return 0;
		case BULLET_HIT_TYPE_PLAYER_OBJECT: if(!IsValidPlayerObject(playerid, hitid)) return 0;
	}
	FastBillet(playerid, weaponid);
	new ret = 1;
	#if defined ac_OnPlayerWeaponShot
		ret = ac_OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, fX, fY, fZ);
	#endif
	if(ret && hittype == BULLET_HIT_TYPE_PLAYER)
	{
		if(!CheatStatus[AC_AIMCIN]) { if(++playerContShotCount[playerid] > WeaponCount[weaponid - 22]) AddToWarningPanel(playerid, "aim"); }
	    if(!CheatStatus[AC_DAMAGESYS])
		{
		    new Float:dist = GetPlayerDistanceFromPoint(playerid, pos_sx, pos_sy, pos_sz);
			DamageSystem(playerid, weaponid, hitid, dist);
			return 0;
		}
	}
	else playerContShotCount[playerid] = 0;
	return ret;
}
