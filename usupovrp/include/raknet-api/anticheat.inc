public OnGameModeInit()
{
    new File:fileid = fopen("anticheat/setting.txt", io_readwrite);
	if(fileid)
	{
	    new count;
	    while(fread(fileid, GlobalString))
		{
		    if(count >= sizeof(CheatName)) break;
			CheatStatus[count++] = strval(GlobalString);
		}
		fclose(fileid);
	}
	for(new id = (MAX_MODEL - 1); id >= 0; id--) GetVehicleModelInfo((id + 400), VEHICLE_MODEL_INFO_SIZE, VehicleSize[id][0], VehicleSize[id][1], VehicleSize[id][2]);
	
	new Text:textid, Float:pos = 436.0693;
    for(new id; id < PANEL_LINE; id++)
    {
    	warningPanelTD[id] = textid = TextDrawCreate(635.5764, pos, "_"); pos -= 7.0;
        TextDrawLetterSize(textid, 0.1804, 0.8024);
		TextDrawAlignment(textid, 3);
		TextDrawColor(textid, -1);
		TextDrawSetOutline(textid, 0);
		TextDrawBackgroundColor(textid, 255);
		TextDrawFont(textid, 1);
		TextDrawSetProportional(textid, 1);
		//TextDrawSetShadow(textid, 1);
		warningPanelText[id] = "_";
	}
	GlobalTextDrawHealth = textid = TextDrawCreate(263.758728, 430.267517, "box");
	TextDrawLetterSize(textid, 0.000000, 1.247057);
	TextDrawTextSize(textid, 375.699920, 0.000000);
	TextDrawAlignment(textid, 1);
	TextDrawColor(textid, -2139062017);
	TextDrawUseBox(textid, 1);
	TextDrawBoxColor(textid, 255);
	TextDrawBackgroundColor(textid, -2139062017);
	TextDrawFont(textid, 1);
	TextDrawSetProportional(textid, 1);
	
	Iter_Init(VehStream);
	SetTimer("ac_MainUpdate", 1000, 1);
	StartTick = (gettime() + 30);
	#if defined ac_OnGameModeInit
		return ac_OnGameModeInit();
	#else
	    return 1;
	#endif
}
