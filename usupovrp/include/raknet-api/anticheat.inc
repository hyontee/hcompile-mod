static stock CheckInviz(playerid)
{
	if(!playerInviz{playerid} && playerSurf[playerid] > 2000 && playerSurf[playerid] != INVALID_VEHICLE_ID)
	{
		new Float:pos_ox0, Float:pos_oy0, Float:pos_oz0, Float:pos_ox1, Float:pos_oy1, Float:pos_oz1;
		GetObjectPos((playerSurf[playerid] - 2000), pos_ox0, pos_oy0, pos_oz0);
		GetPlayerObjectPos(playerid, (playerSurf[playerid] - 2000), pos_ox1, pos_oy1, pos_oz1);
		if(!IsPlayerInRangeOfPoint(playerid, 20.0, pos_ox0, pos_oy0, pos_oz0) && !IsPlayerInRangeOfPoint(playerid, 20.0, pos_ox1, pos_oy1, pos_oz1)) { if(++playerWarningInviz{playerid} > 3) CheatDetected(playerid, AC_INVIZ0); }
		else playerWarningInviz{playerid} = 0;
	}
	else playerWarningInviz{playerid} = 0;
}

static stock CheckWeapon(playerid)
{
  	if(playerCheckWeapon{playerid}) playerCheckWeapon{playerid}--;
    else { for(new weap, ammo, id = 12; id >= 0; id--)
	{
 		GetPlayerWeaponData(playerid, id, weap, ammo);
 		if(weap && weap != 1 && weap != 46)
 		{
	 		if(ammo < playerAmmo[playerid][id]) playerAmmo[playerid][id] = ammo;
	        if(weap != playerWeaponID[playerid][id])
			{
			    ResetPlayerWeapons(playerid);
				CheatDetected(playerid, AC_WEAPON);
			}
 		}
	}}
}

static stock CheckAnimation(playerid)
{
    new animid = GetPlayerAnimationIndex(playerid);
    switch(animid)
    {
        case -1: CheatDetected(playerid, AC_IANIM);
		case 1058: CheatDetected(playerid, AC_FLY4);
    	case 157, 159, 161: CheatDetected(playerid, AC_FLY1);
	}
    if((1538 <= animid <= 1544) && !IsPlayerInWaterAC(playerid)) { if(++playerWarningFly1{playerid} > 3) CheatDetected(playerid, AC_FLY2); }
    else playerWarningFly1{playerid} = 0;
    
    if((animid == 958 || animid == 959) && GetPlayerWeapon(playerid) != 46) { if(++playerWarningFly2{playerid} > 3) CheatDetected(playerid, AC_FLY3); }
    else playerWarningFly2{playerid} = 0;
}

static stock CheckFly(playerid, vehid, gstate)
{
    new Float:pos_x, Float:pos_y, Float:pos_z;
	GetPlayerPos(playerid, pos_x, pos_y, pos_z);
	if(playerCheckFly{playerid}) playerCheckFly{playerid}--;
 	else
 	{
 	    new Float:dist = VectorSize(floatabs(playerPosX[playerid] - pos_x), floatabs(playerPosY[playerid] - pos_y), 0.0);
	 	if(gstate != PLAYER_STATE_PASSENGER && !playerInviz{playerid} && dist > 0.0 && pos_x != 0.0 && pos_y != 0.0 && playerPosX[playerid] != 0.0 && playerPosY[playerid] != 0.0 && playerPosZ[playerid] > -35.0 && GetTickDiffAC(GetTickCount(), playerLagFly[playerid]) < 1500)
	 	{
	 	    if(vehid) { if(dist > 160.0) CheatDetected(playerid, AC_TP0); }
	        else { if(dist > 40.0)
			{
				UpdateSurfInfo(playerid);
				if(playerSurf[playerid] == INVALID_VEHICLE_ID) CheatDetected(playerid, AC_TP1);
			}}
			if(dist > 5.0 && GetPlayerSpeedAC(playerid) < 5) { if(++playerWarningFly0{playerid} > 3) CheatDetected(playerid, AC_FLY0); }
			else playerWarningFly0{playerid} = 0;
		}
	}
	playerPosX[playerid] = pos_x;
 	playerPosY[playerid] = pos_y;
 	playerPosZ[playerid] = pos_z;
}

static stock CheckSurf(playerid)
{
	new Float:vel_x, Float:vel_y, Float:vel_z, Float:heal;
	GetPlayerHealth(playerid, heal);
	GetPlayerVelocity(playerid, vel_x, vel_y, vel_z);
    if((floatabs(vel_x) > 0.3 || floatabs(vel_y) > 0.3) && vel_z > -0.2 && GetPlayerWeapon(playerid) != 46) SetTimerEx("ac_CheckSurfing", 2100, 0, "if", playerid, heal, playerVehicleID[playerid]);
	else playerWarningSurf{playerid} = 0;
}

static stock SpeedDiff(playerid)
{
	new tick = GetTickCount(), speed = GetPlayerSpeedAC(playerid), vehid = playerVehicleID[playerid], Float:pos_z;
	GetPlayerPos(playerid, pos_z, pos_z, pos_z);
	if(!IsAirTransportAC(vehid) && GetTickDiffAC(tick, playerLagSpeed[playerid]) < 300 && GetTickDiffAC(tick, playerFreezeSpeed[playerid]) > 0)
	{
	    if(speed > 220.0) CheatDetected(playerid, AC_SPEED);
	    if(!CheatStatus[AC_OVERSPEED])
 		{
 		    new model = GetVehicleModel(vehid);
 		    if(model)
 		    {
	 		    new count = (VehicleMaxSpeed[model - 400] - 20);
	 		    if(IsMotoTransportAC(vehid)) count += 50;
			 	if(speed > count && (pos_z - playerOspOldPosZ[playerid]) > -2.0) AddToWarningPanel(playerid, "overspeed");
	 		}
	 	}
	    new diff = (speed - playerLastSpeed[playerid]);
	 	if(diff > 60)
	 	{
	 	    if(++playerWarningSpeed{playerid} > 3) CheatDetected(playerid, AC_DIFFSPEED);
	 	    playerNullWarningTimer[playerid][0] = 20;
	 	}
	 	else if(diff > 30 && !CheatStatus[AC_SPEEDWARN]) AddToWarningPanel(playerid, "speed");
	}
	playerLastSpeed[playerid] = speed;
 	playerOspOldPosZ[playerid] = pos_z;
}

static stock FastBillet(playerid, weaponid)
{
	new count = WeaponReload[weaponid - 22], tick = GetTickCount(), diff = GetTickDiffAC(tick, playerLastShot[playerid]);
	playerLastShot[playerid] = tick;
	if(!CheatStatus[AC_CBUGCEV] && diff < 650 && weaponid == 24) AddToWarningPanel(playerid, "+C");
	
	if(playerVehicleID[playerid])
	{
		if((22 <= weaponid <= 24) || (26 <= weaponid <= 32)) count = 100;
	    else count = 900;
    }
 	if(diff < count) { if(++playerWarningRapid{playerid} > 3) CheatDetected(playerid, AC_RAPID); }
	else playerWarningRapid{playerid} = 0;
}

static stock BulletInPlayer(playerid, weaponid, hitid, Float:fX, Float:fY, Float:fZ, Float:pos_px, Float:pos_py, Float:pos_pz, Float:pos_sx, Float:pos_sy, Float:pos_sz)
{
    if(playerPaused[hitid] > 3 || !IsPlayerInRangeOfPoint(hitid, MaxDistShot[weaponid - 22], pos_px, pos_py, pos_pz)) return 0;
    if(floatabs(fX) > 20.0 || floatabs(fY) > 20.0 || floatabs(fZ) > 20.0)
	{
		CheatDetected(playerid, AC_CRASH13);
		return 0;
	}
	if(fX == floatstr("-0.009999") && fY == floatstr("-0.019999") && fZ == floatstr("0.039999"))
	{
		CheatDetected(playerid, AC_CRASH12);
		return 0;
	}
 	if(floatabs(fX) < 0.01 && floatabs(fY) < 0.01 && floatabs(fZ) < 0.01)
 	{
	 	if(++playerWarningAim4{playerid} > 3) CheatDetected(playerid, AC_AIM4);
   		return 0;
 	}
 	else playerWarningAim4{playerid} = 0;
    if(playerSurf[hitid] == INVALID_VEHICLE_ID && !IsPlayerInRangeOfPoint(hitid, 10.0, pos_sx, pos_sy, pos_sz))
	{
		if(++playerWarningProAim{playerid} > 3) CheatDetected(playerid, AC_AIM2);
  		return 0;
	}
	else playerWarningProAim{playerid} = 0;

    new Float:ppos_z;
 	GetPlayerPos(playerid, ppos_z, ppos_z, ppos_z);
	if(floatabs(ppos_z - pos_pz) < 0.001)
	{
		if(++playerWarningAim0{playerid} > 3) CheatDetected(playerid, AC_AIM3);
		return 0;
	}
	else playerWarningAim0{playerid} = 0;
	
	new Float:hpos_z;
	GetPlayerPos(hitid, hpos_z, hpos_z, hpos_z);
 	if(floatabs(hpos_z - pos_sz) < 0.001)
 	{
	 	if(++playerWarningAim3{playerid} > 3) CheatDetected(playerid, AC_AIM0);
	 	return 0;
 	}
 	else playerWarningAim3{playerid} = 0;
 	return 1;
}

static stock DamageSystem(playerid, weaponid, hitid, Float:dist) if(!playerDamageSys{hitid})
{
	new Float:ndmg, Float:dmg = WeaponDamage[weaponid - 22];
	if(25 <= weaponid <= 27)
	{
		ndmg = (dist / 7.5);
		if(ndmg >= 1.0 && (5.0 <= dist <= MaxDistShot[weaponid - 22])) dmg = (dmg / ndmg);
	}
	new Float:heal = playerHealth[hitid], Float:arm = playerArmour[hitid];
	#if defined OnPlayerDamageStatusUpdateAC
		if(!OnPlayerDamageStatusUpdateAC(playerid, hitid, dmg, arm, weaponid)) return;
	#endif
	playerLastHitID[hitid] = playerid;
    playerLastHitTick[hitid] = GetTickCount();
	if(!arm)
    {
        if((heal - dmg) > 0.0) SetPlayerHealth(hitid, (heal - dmg));
        else
		{
		    #if defined OnPlayerDeathFromWeaponAC
				if(!OnPlayerDeathFromWeaponAC(hitid, playerid, weaponid)) return;
			#endif
		    playerDamageSys{hitid} = 1;
		    ResetPlayerWeapons(hitid);
			SpawnPlayer(hitid);
		}
    }
	else if(dmg > arm)
    {
        #if defined OnPlayerResetArmourAC
        	OnPlayerResetArmourAC(hitid);
		#endif
        SetPlayerArmour(hitid, 0.0);
        if((heal - (dmg - arm)) > 0.0) SetPlayerHealth(hitid, (heal - (dmg - arm)));
        else
		{
		    #if defined OnPlayerDeathFromWeaponAC
				if(!OnPlayerDeathFromWeaponAC(hitid, playerid, weaponid)) return;
			#endif
		    playerDamageSys{hitid} = 1;
		    ResetPlayerWeapons(hitid);
			SpawnPlayer(hitid);
		}
    }
	else SetPlayerArmour(hitid, (arm - dmg));
    if(!CheatStatus[AC_INFDAMAGE]) DamageInfo(playerid, hitid);
}

