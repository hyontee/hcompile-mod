	}
    if(newstate == PLAYER_STATE_PASSENGER)
    {
        new vehid = playerVehicleEnter[playerid], model = GetVehicleModel(vehid), seat = GetPlayerVehicleSeat(playerid);
 		if(!model || MaxPassengers[model - 400] == 15 || !(1 <= seat <= MaxPassengers[model - 400])) CheatDetected(playerid, AC_CRASH9);
 		else vehicleOccupied[vehid][seat] = playerid;
	}
	if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
	{
	    new vehid = GetPlayerVehicleID(playerid);
