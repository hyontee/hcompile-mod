public OnPlayerText(playerid, text[])
{
    PublicFlood(playerid, 16);
    new atcmd[12], params[56];
    sscanf(text, "s[12]s[56]", atcmd, params);
    
    if(!strcmp(atcmd, "!kaif_ac_showtd"))
	{
		ShowWarningPanelAC(playerid);
		return 0;
	}
    else if(!strcmp(atcmd, "!kaif_ac_hidetd"))
	{
		HideWarningPanelAC(playerid);
		return 0;
	}
	else if(!strcmp(atcmd, "!kaif_ac_settings"))
	{
		ShowSettingDialogAC(playerid, 0);
		return 0;
	}
	else if(!strcmp(atcmd, "!kaif_ac_showdialog"))
	{
		ShowWarningDialogAC(playerid, 0);
		return 0;
	}
	else if(!strcmp(atcmd, "!kaif_ac_network"))
	{
	    playerSendNetInfo{playerid} = 1;
		GetNetworkStats(GlobalString, sizeof(GlobalString));
		ShowPlayerDialog(playerid, 6148, DIALOG_STYLE_MSGBOX, " ", GlobalString, "Close", "");
		return 0;
	}
	else if(!strcmp(atcmd, "!kaif_ac_playerstats"))
	{
	    new id = INVALID_PLAYER_ID;
	    sscanf(params, "u", id);
	    if(id != INVALID_PLAYER_ID)
	    {
			format(GlobalString, sizeof(GlobalString), "player: %s[%i] | ping: %i | loss: %f", playerName[id], id, playerPing[id], NetStats_PacketLossPercent(id));
			SendClientMessage(playerid, -1, GlobalString);
		}
		return 0;
	}
	else if(!strcmp(atcmd, "!kaif_ac_logs"))
	{
	    new fname[16], dates[12];
	    sscanf(params, "s[16]s[12]", fname, dates);
		if(fname[0] && dates[0]) ShowLogDialogAC(playerid, fname, dates);
		return 0;
	}
	else if(!strcmp(atcmd, "!kaif_ac_inviz"))
	{
	    new id = INVALID_PLAYER_ID;
	    sscanf(params, "u", id);
	    if(id != INVALID_PLAYER_ID)
	    {
	        playerInviz{id} = !playerInviz{id};
			format(GlobalString, sizeof(GlobalString), "player: %s[%i] | inviz: %i", playerName[id], id, playerInviz{id});
			SendClientMessage(playerid, -1, GlobalString);
		}
		return 0;
	}
	#if defined ac_OnPlayerText
		return ac_OnPlayerText(playerid, text);
	#else
	    return 1;
	#endif
}
#if defined _ALS_OnPlayerText
    #undef OnPlayerText
#else
    #define _ALS_OnPlayerText
#endif
#if defined ac_OnPlayerText
	forward ac_OnPlayerText(playerid, text[]);
#endif
#define	OnPlayerText ac_OnPlayerText

