    BS_ReadInCarSync(bs, data);
    if(floatabs(data[PR_velocity][2]) > 10.0)
    {
        data[PR_velocity][2] = 0.0;
        BS_SetWriteOffset(bs, 8);
        BS_WriteInCarSync(bs, data);
