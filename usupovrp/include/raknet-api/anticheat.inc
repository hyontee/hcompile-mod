					}
					foreach(Player, otherid) if(playerSettingDialogPage[playerid] == playerSettingDialogPage[otherid]) ShowSettingDialogAC(otherid, playerSettingDialogPage[otherid]);
			    }
			}
    	}
    	case 6148: playerSendNetInfo{playerid} = 0;
