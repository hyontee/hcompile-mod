stock IsPlayerInWaterAC(playerid)
{
	new Float:pos_z;
    GetPlayerPos(playerid, pos_z, pos_z, pos_z);
	if(pos_z < 0.0) return 1;
	for(new id = (sizeof(WaterPos) - 1); id >= 0; id--) if(GetPlayerDistanceFromPoint(playerid, WaterPos[id][0], WaterPos[id][1], WaterPos[id][2]) <= WaterPos[id][3]) return 1;
	return 0;
}

stock IsVehicleInWaterAC(vehid)
{
	new Float:pos_z;
    GetVehiclePos(vehid, pos_z, pos_z, pos_z);
	if(pos_z < 0.0) return 1;
	for(new id = (sizeof(WaterPos) - 1); id >= 0; id--) if(GetVehicleDistanceFromPoint(vehid, WaterPos[id][0], WaterPos[id][1], WaterPos[id][2]) <= WaterPos[id][3]) return 1;
	return 0;
}

stock IsComponentidCompatibleAC(modelid, componentid)
{
	if(!(1000 <= componentid <= 1191)) { if(modelid == 576 && (componentid == 1192 || componentid == 1193)) return 1; }
	else
	{
		componentid -= 1000;
		if(VehicleMods[modelid - 400][componentid >>> 5] & (1 << (componentid & 0b00011111))) return 1;
	}
	return 0;
}

stock GetPlayerSpeedAC(playerid)
{
    new vehid = playerVehicleID[playerid], Float:vel_x, Float:vel_y, Float:vel_z;
    if(!vehid) GetPlayerVelocity(playerid, vel_x, vel_y, vel_z);
	else GetVehicleVelocity(vehid, vel_x, vel_y, vel_z);
	return floatround(VectorSize(vel_x, vel_y, 0.0) * 136.666667);
}

stock GetTickDiffAC(newtick, oldtick)
{
	if(oldtick > newtick || (oldtick >= 0 && newtick < 0)) return ((cellmax - oldtick + 1) - (cellmin - newtick));
	return (newtick - oldtick);
}

static stock UpdateSurfInfo(playerid) if(playerState{playerid} == PLAYER_STATE_ONFOOT)
{
    new vehsurf = GetPlayerSurfingVehicleID(playerid);
    if(vehsurf != INVALID_VEHICLE_ID)
	{
		playerSurf[playerid] = vehsurf;
		return;
	}
    new objsurf = GetPlayerSurfingObjectID(playerid);
    if(objsurf != INVALID_VEHICLE_ID && !playerInviz{playerid})
	{
		playerSurf[playerid] = (objsurf + 2000);
		return;
	}
	new model, Float:pos_x, Float:pos_y, Float:pos_z, Float:vpos_x, Float:vpos_y, Float:vpos_z;
	GetPlayerPos(playerid, pos_x, pos_y, pos_z);
	foreach(VehStream[playerid], vehid)
	{
	    model = GetVehicleModel(vehid);
		if(!model) continue;
	    GetVehiclePos(vehid, vpos_x, vpos_y, vpos_z);
	    if((vpos_z + 0.5) < pos_z < (vpos_z + (VehicleSize[model - 400][2] + 1.0)) && VectorSize(floatabs(pos_x - vpos_x), floatabs(pos_y - vpos_y), 0.0) <= VehicleSize[model - 400][1])
		{
			playerSurf[playerid] = vehid;
			break;
		}
	}
}

static stock DamageInfo(playerid, hitid)
{
	PlayerPlaySound(playerid, 17802, 0.0, 0.0, 0.0);
	PlayerPlaySound(hitid, 17802, 0.0, 0.0, 0.0);
	if(playerHealth[hitid] > 100.0 || playerArmour[hitid] > 100.0) return;
	playerTargetTime{playerid} = 5;
	if(playerOldTargetID[playerid] != hitid)
	{
	    playerOldTargetID[playerid] = hitid;
        TextDrawShowForPlayer(playerid, GlobalTextDrawHealth);
		PlayerTextDrawSetString(playerid, playerTextDrawHealth[playerid][1], playerName[hitid]);
	}
	if(playerArmour[hitid] <= 0.0)
	{
	    PlayerTextDrawColor(playerid, playerTextDrawHealth[playerid][1], -1);
		PlayerTextDrawBoxColor(playerid, playerTextDrawHealth[playerid][0], -16776961);
		PlayerTextDrawTextSize(playerid, playerTextDrawHealth[playerid][0], ((265.076629 - 5.0) + (playerHealth[hitid] / 100.0) * 109.862549), 0.0);
	}
	else
	{
	    PlayerTextDrawColor(playerid, playerTextDrawHealth[playerid][1], -2139062017);
		PlayerTextDrawBoxColor(playerid, playerTextDrawHealth[playerid][0], -1);
		PlayerTextDrawTextSize(playerid, playerTextDrawHealth[playerid][0], ((265.076629 - 5.0) + (playerArmour[hitid] / 100.0) * 109.862549), 0.0);
	}
	PlayerTextDrawShow(playerid, playerTextDrawHealth[playerid][0]);
	PlayerTextDrawShow(playerid, playerTextDrawHealth[playerid][1]);
}

static stock AddToWarningDialog(playerid, reason[])
{
	#if defined OnPlayerWarningDialogAC
    	if(!OnPlayerWarningDialogAC(playerid, reason)) return;
	#endif
	format(GlobalString, sizeof(GlobalString), "%s[%i]\t%s\t%s", playerName[playerid], playerid, playerIP[playerid], reason);
    for(new id = (DIALOG_LINE - 1); id >= 0; id--) if(!strcmp(warningDialogText[id], GlobalString)) return;
	for(new id = (DIALOG_LINE - 1); id > 0; id--) warningDialogText[id] = warningDialogText[id - 1];
	format(warningDialogText[0], 64, GlobalString);
	LogDetectPots(playerid, "dialoglog", reason);
	foreach(Player, otherid) if(playerWarningDialogPage[otherid] != -1) ShowWarningDialogAC(otherid, playerWarningDialogPage[otherid]);
}

static stock RemoveToWarningDialog(playerid, reason[])
{
	new lastid = -1;
    for(new id; id < DIALOG_LINE; id++) if(strlen(warningDialogText[id]) && strfind(warningDialogText[id], playerName[playerid]) != -1 && strfind(warningDialogText[id], reason) != -1)
	{
		lastid = id;
		break;
	}
	if(lastid != -1) { for(new id = lastid; id < (DIALOG_LINE - 1); id++) warningDialogText[id] = warningDialogText[id + 1]; }
}

static stock LogDetectPots(playerid, fname[], reason[])
{
    new ayear, amonth, aday, dates[12];
    getdate(ayear, amonth, aday);
    format(dates, sizeof(dates), "%i-%i-%i", aday, amonth, ayear);
    
    format(GlobalString, sizeof(GlobalString), "anticheat/%s/%s.txt", fname, dates);
    new File:fileid = fopen(GlobalString, io_append);
	if(fileid)
	{
	    new ahour, aminute, asecond;
		gettime(ahour, aminute, asecond);
		format(GlobalString, sizeof(GlobalString), "%s|%s|%s|%i.%i.%i %i:%i:%i|%i|%f|%f,%f,%f\r\n", playerName[playerid], playerIP[playerid], reason, aday, amonth, ayear, ahour, aminute, asecond, playerPing[playerid], NetStats_PacketLossPercent(playerid), playerPosX[playerid], playerPosY[playerid], playerPosZ[playerid]);
		for(new id, len = strlen(GlobalString); id < len; id++) fputchar(fileid, GlobalString[id], false);
		fclose(fileid);
		foreach(Player, otherid) if(playerLogDialogPage[otherid] != -1 && !strcmp(playerLogDialogName[otherid], fname) && !strcmp(playerLogDialogDate[otherid], dates)) ShowLogDialogAC(otherid, playerLogDialogName[otherid], playerLogDialogDate[otherid], playerLogDialogPage[otherid]);
	}
}

static stock PublicFlood(playerid, id)
{
	new tick = GetTickCount();
    if(GetTickDiffAC(tick, playerLastPublicTick[playerid][id]) < PublicMaxTick[id]) { if(++playerWarningPublic[playerid][id] > 10) CheatDetected(playerid, AC_PUBFLOOD, id); }
	else playerWarningPublic[playerid][id] = 0;
	if(GetTickDiffAC(tick, playerLastPublicTick[playerid][27]) < PublicMaxTick[27]) { if(++playerWarningPublic[playerid][27] > 10) CheatDetected(playerid, AC_CROSFLOOD); }
	else playerWarningPublic[playerid][27] = 0;
	playerLastPublicTick[playerid][id] =
	playerLastPublicTick[playerid][27] = tick;
}

static stock CheatDetected(playerid, code, daar = 0) if(!CheatStatus[code] && !playerKickTimer[playerid] && IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
{
	new astring[24];
	if(code != AC_PUBFLOOD) format(astring, sizeof(astring), CheatName[code]);
	else
	{
	    code = (500 + daar);
		format(astring, sizeof(astring), "%s%i", CheatName[AC_PUBFLOOD], daar);
	}
	new ret = 1;
	#if defined OnPlayerCheatAC
		ret = OnPlayerCheatAC(playerid, code, astring);
	#endif
	if(ret)
	{
		new ping = (playerPing[playerid] + 50);
 		playerKickTimer[playerid] = SetTimerEx("ac_KickTimer", (ping > MAX_PING) ? (MAX_PING) : (ping), 0, "i", playerid);
 		AddToWarningPanel(playerid, astring, 1);
 		LogDetectPots(playerid, "kicklog", astring);
	}
}

stock AddToWarningPanel(playerid, reason[], type = 0)
{
	#if defined OnPlayerWarningPanelAC
    	if(!OnPlayerWarningPanelAC(playerid, reason)) return;
	#endif
	switch(type)
	{
    	case 0: format(GlobalString, sizeof(GlobalString), "~r~~h~~h~(warning) ~w~%s(%i)(%s) reason: %s", playerName[playerid], playerid, playerIP[playerid], reason);
    	case 1: format(GlobalString, sizeof(GlobalString), "~w~(kick) %s(%i)(%s) reason: %s", playerName[playerid], playerid, playerIP[playerid], reason);
		case 2: format(GlobalString, sizeof GlobalString, "~g~(connect) ~w~%s(%i)(%s)", playerName[playerid], playerid, playerIP[playerid]);
		case 3: format(GlobalString, sizeof GlobalString, "~r~(disconnect) ~w~%s(%i)(%s)(%s)", playerName[playerid], playerid, playerIP[playerid], reason);
	}
	for(new id = (PANEL_LINE - 1); id >= 0; id--) if(!strcmp(warningPanelText[id], GlobalString))
	{
	    warningPanelTime{id} = 30;
		return;
	}
	for(new id = (PANEL_LINE - 1); id > 0; id--)
	{
	    warningPanelTime{id} = warningPanelTime{id - 1};
		warningPanelText[id] = warningPanelText[id - 1];
	}
	warningPanelTime{0} = 30;
	format(warningPanelText[0], 100, GlobalString);
 	for(new id = (PANEL_LINE - 1); id >= 0; id--) TextDrawSetString(warningPanelTD[id], warningPanelText[id]);
 	if(!type) LogDetectPots(playerid, "panellog", reason);
}

static stock CheckHealth(playerid)
{
	if(playerCheckHealth{playerid}) playerCheckHealth{playerid}--;
	else
	{
		new Float:heal;
		GetPlayerHealth(playerid, heal);
		if(playerHealth[playerid] < heal)
		{
		    SetPlayerHealth(playerid, playerHealth[playerid]);
		    if(++playerWarningHealth{playerid} > 10) CheatDetected(playerid, AC_HEALTH);
		}
		else if(playerHealth[playerid] > heal)
		{
			playerHealth[playerid] = heal;
			playerWarningHealth{playerid} = 0;
		}
		else playerWarningHealth{playerid} = 0;
	}
}

static stock CheckArmour(playerid)
{
  	if(playerCheckArmour{playerid}) playerCheckArmour{playerid}--;
	else
	{
		new Float:arm;
		GetPlayerArmour(playerid, arm);
		if(playerArmour[playerid] < arm)
		{
		    SetPlayerArmour(playerid, playerArmour[playerid]);
		    if(++playerWarningArmour{playerid} > 10) CheatDetected(playerid, AC_ARMOUR);
		}
		else if(playerArmour[playerid] > arm)
		{
			playerArmour[playerid] = arm;
			playerWarningArmour{playerid} = 0;
		}
		else playerWarningArmour{playerid} = 0;
	}
}

static stock CheckRepair(playerid, vehid)
{
	if(playerCheckRepair{playerid}) playerCheckRepair{playerid}--;
	else
	{
	    new Float:heal;
		GetVehicleHealth(vehid, heal);
		if(!playerInModShop{playerid} && heal > vehicleHealth[vehid] && !IsPlayerInPayNSprayAC(playerid))
		{
		    SetVehicleHealth(vehid, vehicleHealth[vehid]);
			if(++playerWarningReapir{playerid} > 10) CheatDetected(playerid, AC_REPAIR);
		}
		else
		{
            vehicleHealth[vehid] = heal;
            playerWarningReapir{playerid} = 0;
		}
	}
}

function ac_MainUpdate()
{
	new tmp;
    for(new id; id < connblockLast; id++) if(connblockTime[id])
	{
		connblockTime[id]--;
		if(connblockTime[id] <= 0) { if(connblockLast == id) connblockLast = tmp; }
		else tmp = id;
	}
	for(new id = (PANEL_LINE - 1); id >= 0; id--) if(warningPanelTime{id}) { if(--warningPanelTime{id} <= 0)
	{
	    warningPanelText[id] = "_";
		TextDrawSetString(warningPanelTD[id], "_");
	}}
}

function ac_SubPlayerUpdate(playerid)
{
    new ping = GetPlayerPing(playerid);
    if(ping > MAX_PING) { if(++playerWarningPing{playerid} > 10) CheatDetected(playerid, AC_PING); }
	else playerWarningPing{playerid} = 0;

	if(0 <= ping <= MAX_PING)
	{
		playerPing[playerid] = ping;
		playerSleep{playerid} = (3 + floatround(((ping + 50) > MAX_PING) ? (MAX_PING / 100) : ((ping + 50) / 100)));
	}
	if(playerPaused[playerid] <= 3) UpdateSurfInfo(playerid);
}

function ac_MainPlayerUpdate(playerid)
{
	if(++playerPaused[playerid] <= 3)
	{
	    new gstate = playerState{playerid};
		if(gstate != PLAYER_STATE_NONE && gstate != PLAYER_STATE_SPECTATING)
	    {
			new vehid = GetPlayerVehicleID(playerid);
			if(vehid)
			{
			    if(gstate == PLAYER_STATE_DRIVER) CheckRepair(playerid, vehid);
				if(playerRemoveVehicle{playerid}) { if(--playerRemoveVehicle{playerid} <= 0) CheatDetected(playerid, AC_VEHREMOVE); }
				if(playerVehicleEnterTick{playerid}) playerVehicleEnterTick{playerid}--;
				playerVehicleID[playerid] = vehid;
			}
			else
			{
				CheckAnimation(playerid);
				playerVehicleID[playerid] =
				playerRemoveVehicle{playerid} =
				playerVehicleEnterTick{playerid} = 0;
			}
			CheckFly(playerid, vehid, gstate);
			CheckInviz(playerid);
			CheckWeapon(playerid);
			CheckArmour(playerid);
			CheckHealth(playerid);
		}
		if(playerSendNetInfo{playerid})
	    {
			GetNetworkStats(GlobalString, sizeof(GlobalString));
			ShowPlayerDialog(playerid, 6148, DIALOG_STYLE_MSGBOX, " ", GlobalString, "Close", "");
		}
		if(playerOldTargetID[playerid] != INVALID_PLAYER_ID) { if(--playerTargetTime{playerid} <= 0)
	    {
		    playerOldTargetID[playerid] = INVALID_PLAYER_ID;
	        TextDrawHideForPlayer(playerid, GlobalTextDrawHealth);
			PlayerTextDrawHide(playerid, playerTextDrawHealth[playerid][0]);
			PlayerTextDrawHide(playerid, playerTextDrawHealth[playerid][1]);
		}}
	    for(new id = (NULL_WARN - 1); id >= 0; id--) if(playerNullWarningTimer[playerid][id]) { if(--playerNullWarningTimer[playerid][id] <= 0) switch(id)
	    {
	        case 0: if(--playerWarningSpeed{playerid} > 0) playerNullWarningTimer[playerid][id] = 20;
	        case 1: if(--playerWarningCarShot{playerid} > 0) playerNullWarningTimer[playerid][id] = 10;
	    }}
	    if(gstate == PLAYER_STATE_SPECTATING && !playerSpect{playerid}) { if(++playerWarningSpect{playerid} > 3) CheatDetected(playerid, AC_INVIZ1); }
		else playerWarningSpect{playerid} = 0;
		if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK) CheatDetected(playerid, AC_JETPACK);
	}
	playerLagFly[playerid] = GetTickCount();
}

function ac_FastPlayerUpdate(playerid)
{
    if(playerPaused[playerid] <= 3) switch(playerState{playerid})
	{
		case PLAYER_STATE_ONFOOT: if(playerSurf[playerid] == INVALID_VEHICLE_ID)
		{
			if(!CheatStatus[AC_SURF]) CheckSurf(playerid);
			if(GetPlayerSpeedAC(playerid) > 220.0) CheatDetected(playerid, AC_SPEED);
		}
		case PLAYER_STATE_DRIVER, PLAYER_STATE_PASSENGER: SpeedDiff(playerid);
	}
	playerLagSpeed[playerid] = GetTickCount();
}

function ac_CheckProxy(playerid, response_code, data[])
{
	if(response_code == 200 && data[0] == 'Y' && strcmp(playerIP[playerid], "127.0.0.1") != 0) AddToWarningDialog(playerid, "proxy");
}

function ac_CheckSurfing(playerid, Float:lheal, vehid)
{
    new Float:heal;
	GetPlayerHealth(playerid, heal);
	if(vehid == playerVehicleID[playerid] && lheal <= heal) { if(++playerWarningSurf{playerid} > 1) AddToWarningPanel(playerid, "surf"); }
	else playerWarningSurf{playerid} = 0;
}

function ac_KickTimer(playerid)
{
    playerKickTimer[playerid] = 0;
    if(IsPlayerConnected(playerid)) Kick(playerid);
}

function ac_SpawnTimer(playerid)
{
	playerSpawn{playerid} = 0;
	playerSpawnTimer[playerid] = 0;
}

stock ac_SpawnPlayer(playerid)
{
    playerCheckFly{playerid} = playerSleep{playerid};
    playerWarningFly0{playerid} = 0;
    
    playerSpawn{playerid} = 1;
    if(playerSpawnTimer[playerid])
	{
		KillTimer(playerSpawnTimer[playerid]);
		playerSpawnTimer[playerid] = 0;
	}
	return SpawnPlayer(playerid);
}
