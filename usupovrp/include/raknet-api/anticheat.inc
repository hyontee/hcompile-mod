    {
        new vehid = playerVehicleEnter[playerid], model = GetVehicleModel(vehid);
        if(!model || MaxPassengers[model - 400] == 15 || GetPlayerVehicleSeat(playerid)) CheatDetected(playerid, AC_CRASH9);
        if((model == 520 || model == 425) && GetPlayerWeapon(playerid) == 34) SetPlayerArmedWeapon(playerid, 0);
