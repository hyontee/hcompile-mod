	}
	if(newstate == oldstate || (newstate == PLAYER_STATE_DRIVER && oldstate == PLAYER_STATE_PASSENGER) || (newstate == PLAYER_STATE_PASSENGER && oldstate == PLAYER_STATE_DRIVER)) CheatDetected(playerid, AC_CRASH10);
