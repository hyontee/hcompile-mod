    BS_ReadOnFootSync(bs, data);
    if(44 <= data[PR_weaponId] <= 45)
	{
		data[PR_weaponId] = 0;
		BS_SetWriteOffset(bs, 8);
		BS_WriteOnFootSync(bs, data);
	}
	if(playerInviz{playerid})
	{
	    data[PR_surfingVehicleId] = 2001;
		BS_SetWriteOffset(bs, 8);
		BS_WriteOnFootSync(bs, data);
	}
    if(data[PR_surfingOffsets][0] != data[PR_surfingOffsets][0] || data[PR_surfingOffsets][1] != data[PR_surfingOffsets][1] || data[PR_surfingOffsets][2] != data[PR_surfingOffsets][2])
	{
		CheatDetected(playerid, AC_CRASH8);
		return 0;
	}
	return 1;
}

IPacket:203(playerid, BitStream:bs) // AIM_SYNC
{
    new data[PR_AimSync];
    BS_IgnoreBits(bs, 8);
    BS_ReadAimSync(bs, data);
    if(data[PR_aimZ] != data[PR_aimZ])
	{
	    data[PR_aimZ] = 0.0;
	    BS_SetWriteOffset(bs, 8);
        BS_WriteAimSync(bs, data);
	}
	switch(data[PR_camMode]) { case 34, 45, 49:
	{
		CheatDetected(playerid, AC_DERPCAM);
		return 0;
	}}
    return 1;
}

