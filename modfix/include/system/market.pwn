stock Market_GetSkinInternalId(modelid)
{
    for(new i = 0; i < SKIN_CATALOG_COUNT; i++)
    {
        if(g_SkinCatalog[i][0] == modelid) return g_SkinCatalog[i][1];
    }
    // ИСПРАВЛЕНО: раньше здесь было "return modelid" — для скинов, которых
    // нет в каталоге skins.json (он не покрывает вообще все скины игры),
    // сырой modelId уходил в "md" как есть и попадал в то же id-пространство,
    // что и модели аксессуаров/объектов — отсюда рендер случайного чужого
    // объекта (например значок такси) вместо одежды. -1 — тот же "пусто",
    // что уже используется (и работает без багов) для аксессуаров в
    // Market_GetAccessoryModelByStoredId/Market_GetSkinModelByStoredId.
    return -1;
}

// Названия скинов из skins.json (758 записей), ключ — modelId (то, что
// реально хранится в inv_itemCount слота с item_id=134).
