stock GetVehicleNameByModel(modelid) {
    new name[48];
    if (modelid >= 400 && modelid <= 611) {
        format(name, sizeof(name), "%s", VehicleNames[modelid - 400]);
    }
    // Наша новая проверка:
    else if (modelid >= 2389 && modelid <= 2394) {
        format(name, sizeof(name), "%s", NewCustomVehicles[modelid - 2389]);
    }
    else if (modelid >= 2543 && modelid <= 2629) {
        format(name, sizeof(name), "%s", CustomVehicleNames[modelid - 2543]);
    }
    else {
        format(name, sizeof(name), "Unknown Model %d", modelid);
    }
    
    if(name[0] == '\0') format(name, sizeof(name), "Empty Model %d", modelid);
    return name;
}