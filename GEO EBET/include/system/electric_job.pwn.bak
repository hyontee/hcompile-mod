public OnGameModeInit()
{
    print("[ELECTRIC_SYSTEM] Система работы электриком загружена.");
    CreateElectricSystem();
    
    #if defined e_OnGameModeInit
        return e_OnGameModeInit();
    #else
        return 1;
    #endif
}

stock CreateElectricSystem()
{
    actor_san_sanych = CreateActor(11968, -2464.30, 352.80, 1501.12, 90.67);
    SetActorVirtualWorld(actor_san_sanych, 1);
    actor_san_sanych1 = CreateActor(11968, -2464.30, 352.80, 1501.12, 90.67);
    SetActorVirtualWorld(actor_san_sanych1, 2);
    actor_san_sanych2 = CreateActor(11968, -2464.30, 352.80, 1501.12, 90.67);
    SetActorVirtualWorld(actor_san_sanych2, 3);
    actor_san_sanych3 = CreateActor(11968, -2464.30, 352.80, 1501.12, 90.67);
    SetActorVirtualWorld(actor_san_sanych3, 4);
    sphere_san_sanych = CreateDynamicSphere(-2464.30, 352.80, 1501.12, 3.0, -1, -1);
    
    CreateDynamic3DTextLabel("{FFFF00}Сан Саныч\n\n{FFFFFF}Подойдите для {DC143C}взаимодействия", 0xFFFF00FF, -2464.30, 352.80, 1501.12 + 0.3, 10.0, .worldid = -1, .interiorid = -1);

    for(new i = 0; i < 4; i++)
	{	
		actor_parking_electric[i] = CreateActor(11967, parking_positions[i][0], parking_positions[i][1], parking_positions[i][2], parking_positions[i][3]);
		SetActorVirtualWorld(actor_parking_electric[i], 0);
    
		sphere_parking_electric[i] = CreateDynamicSphere(parking_positions[i][0], parking_positions[i][1], parking_positions[i][2], 2.0, -1, -1);
    
		CreateDynamic3DTextLabel("{FFFF00}Начальник парковки\n{FFFFFF}Подойдите для {FFFF00}взаимодействия", 0xFFFF00FF, 
   	parking_positions[i][0], parking_positions[i][1], parking_positions[i][2] + 0.3, 10.0);
	}
	
	orders_count_city1 = sizeof(orders_electric_city1);
    orders_count_city2 = sizeof(orders_electric_city2); 
    orders_count_city3 = sizeof(orders_electric_city3);
    orders_count_city4 = sizeof(orders_electric_city4);

    return 1;
}

forward ResetOrderCooldown(city, index);
public ResetOrderCooldown(city, index)
{
    if(city < 1 || city > 4) return;
    
    switch(city)
    {
        case 1: 
        {
            if(index < orders_count_city1)
            {
                orders_electric_city1[index][E_IN_COOLDOWN] = false;
                orders_electric_city1[index][E_COOLDOWN_END] = 0;
                orders_electric_city1[index][E_ACTIVE] = true;
            }
        }
        case 2: 
        {
            if(index < orders_count_city2)
            {
                orders_electric_city2[index][E_IN_COOLDOWN] = false;
                orders_electric_city2[index][E_COOLDOWN_END] = 0;
                orders_electric_city2[index][E_ACTIVE] = true;
            }
        }
        case 3: 
        {
            if(index < orders_count_city3)
            {
                orders_electric_city3[index][E_IN_COOLDOWN] = false;
                orders_electric_city3[index][E_COOLDOWN_END] = 0;
                orders_electric_city3[index][E_ACTIVE] = true;
            }
        }
        case 4: 
        {
            if(index < orders_count_city4)
            {
                orders_electric_city4[index][E_IN_COOLDOWN] = false;
                orders_electric_city4[index][E_COOLDOWN_END] = 0;
                orders_electric_city4[index][E_ACTIVE] = true;
            }
        }
    }
    
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && player_electric[i] && GetPlayerSkin(i) == 11969 && player_electric_city[i] == city)
        {
            SendClientMessage(i, -1, "{FFFFFF}Вам поступил новый вызов, используйте: {FFFF00}/elist");
        }
    }
    
    new timer_id = (city - 1) * MAX_ORDERS_PER_CITY + index;
    order_cooldown_timer[timer_id] = -1;
}

stock SetOrderCooldown(city, index)
{
    if(city < 1 || city > 4) return;
    
    new cooldown_time;
    new order_type;
    
    switch(city)
    {
        case 1: 
        {
            if(index < orders_count_city1)
                order_type = orders_electric_city1[index][E_TYPE];
        }
        case 2: 
        {
            if(index < orders_count_city2)
                order_type = orders_electric_city2[index][E_TYPE];
        }
        case 3: 
        {
            if(index < orders_count_city3)
                order_type = orders_electric_city3[index][E_TYPE];
        }
        case 4: 
        {
            if(index < orders_count_city4)
                order_type = orders_electric_city4[index][E_TYPE];
        }
    }
    
    switch(order_type)
    {
        case ORDER_TYPE_LAMP: cooldown_time = COOLDOWN_LAMP;
        case ORDER_TYPE_SHIELD: cooldown_time = COOLDOWN_SHIELD;
        case ORDER_TYPE_TRANSFORMER: cooldown_time = COOLDOWN_TRANSFORMER;
        case ORDER_TYPE_TRAFFIC: cooldown_time = COOLDOWN_TRAFFIC;
        default: cooldown_time = COOLDOWN_LAMP;
    }
    
    switch(city)
    {
        case 1: 
        {
            if(index < orders_count_city1)
            {
                orders_electric_city1[index][E_IN_COOLDOWN] = true;
                orders_electric_city1[index][E_COOLDOWN_END] = gettime() + cooldown_time;
                orders_electric_city1[index][E_ACTIVE] = false;
                
                new timer_id = (city - 1) * MAX_ORDERS_PER_CITY + index;
                order_cooldown_timer[timer_id] = SetTimerEx("ResetOrderCooldown", cooldown_time * 1000, false, "ii", city, index);
            }
        }
        case 2: 
        {
            if(index < orders_count_city2)
            {
                orders_electric_city2[index][E_IN_COOLDOWN] = true;
                orders_electric_city2[index][E_COOLDOWN_END] = gettime() + cooldown_time;
                orders_electric_city2[index][E_ACTIVE] = false;
                
                new timer_id = (city - 1) * MAX_ORDERS_PER_CITY + index;
                order_cooldown_timer[timer_id] = SetTimerEx("ResetOrderCooldown", cooldown_time * 1000, false, "ii", city, index);
            }
        }
        case 3: 
        {
            if(index < orders_count_city3)
            {
                orders_electric_city3[index][E_IN_COOLDOWN] = true;
                orders_electric_city3[index][E_COOLDOWN_END] = gettime() + cooldown_time;
                orders_electric_city3[index][E_ACTIVE] = false;
                
                new timer_id = (city - 1) * MAX_ORDERS_PER_CITY + index;
                order_cooldown_timer[timer_id] = SetTimerEx("ResetOrderCooldown", cooldown_time * 1000, false, "ii", city, index);
            }
        }
        case 4: 
        {
            if(index < orders_count_city4)
            {
                orders_electric_city4[index][E_IN_COOLDOWN] = true;
                orders_electric_city4[index][E_COOLDOWN_END] = gettime() + cooldown_time;
                orders_electric_city4[index][E_ACTIVE] = false;
                
                new timer_id = (city - 1) * MAX_ORDERS_PER_CITY + index;
                order_cooldown_timer[timer_id] = SetTimerEx("ResetOrderCooldown", cooldown_time * 1000, false, "ii", city, index);
            }
        }
    }
}

public OnPlayerEnterDynamicArea(playerid, areaid)
{
    if(areaid == sphere_san_sanych)
    {
        ShowNotificationNew(playerid, 4, 5, notifcmdsanich, 0, "Нажмите для взаимодействия", "");
        return 1;
    }

    for(new i = 0; i < 4; i++)
    {
        if(areaid == sphere_parking_electric[i])
        {
            if(player_electric[playerid] && GetPlayerSkin(playerid) == 11969)
            {
                ShowNotificationNew(playerid, 4, 5, notifcmdelectricarenda, 0, "Нажмите для взаимодействия", "");
            }
            return 1;
        }
    }

    if(areaid == player_electric_area[playerid])
    {
        if(player_electric[playerid] &&
           player_orders_electric[playerid] != -1)
        {
            new city = player_electric_city[playerid];
            new order_id = player_orders_electric[playerid];
            
            new is_valid_order = 0;
            
            switch(city)
            {
                case 1:
                {
                    if(order_id < sizeof(orders_electric_city1) && 
                       orders_electric_city1[order_id][E_PLAYER_ID] == playerid)
                    {
                        is_valid_order = 1;
                    }
                }
                case 2:
                {
                    if(order_id < sizeof(orders_electric_city2) && 
                       orders_electric_city2[order_id][E_PLAYER_ID] == playerid)
                    {
                        is_valid_order = 1;
                    }
                }
                case 3:
                {
                    if(order_id < sizeof(orders_electric_city3) && 
                       orders_electric_city3[order_id][E_PLAYER_ID] == playerid)
                    {
                        is_valid_order = 1;
                    }
                }
                case 4:
                {
                    if(order_id < sizeof(orders_electric_city4) && 
                       orders_electric_city4[order_id][E_PLAYER_ID] == playerid)
                    {
                        is_valid_order = 1;
                    }
                }
            }

            if(!is_valid_order)
            {
                return 1;
            }
  
            RemoveGPSMarker(playerid);
            DisablePlayerCheckpoint(playerid);
            
            if(!IsPlayerInAnyVehicle(playerid))
			{
			    ShowNotificationNew(playerid, 4, 5, notifcmdelectricstartordergame, 0, "Нажмите для начала работы", "");
			}
           
        }
        return 1;
    }

    #if defined e_OnPlayerEnterDynamicArea
        return e_OnPlayerEnterDynamicArea(playerid, STREAMER_TAG_AREA:areaid);
    #endif
}

CMD:electricarenda(playerid)
{
    for(new i = 0; i < 4; i++)
    {
        if(IsPlayerInDynamicArea(playerid, sphere_parking_electric[i]))
        {
            if(player_electric[playerid] && GetPlayerSkin(playerid) == 11969)
            {
                if(player_arenda_electric[playerid] != -1)
                {
                    ShowCancelRentDialog(playerid);
                }
                else
                {
                    ShowElectrickRentDialog(playerid, i);
                }
            }
            else
            {
                SendClientMessage(playerid, -1, "{FFFFFF}Вы не работаете электриком или не в рабочей форме.");
            }
            return 1;
        }
    }
    SendClientMessage(playerid, -1, "{FFFFFF}Вы не рядом с начальником парковки.");
    return 1;
}

