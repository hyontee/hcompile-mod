stock StartElectricWorkDay(playerid)
{
    if(!player_electric[playerid])
    {
        player_electric[playerid] = true;
        player_electric_work_start[playerid] = gettime();
        player_electric_city[playerid] = GetPlayerVirtualWorld(playerid);

        player_electric_skin_saved[playerid] = GetPlayerSkin(playerid);

        SetPlayerSkin(playerid, 11969);
        
        new city = player_electric_city[playerid];
        if(city >= 1 && city <= 4)
        {
            SetPlayerCheckpoint(playerid, parking_positions[city-1][0], parking_positions[city-1][1], parking_positions[city-1][2], 3.0);
        }
        
        SendClientMessage(playerid, -1, "{FFFFFF}Вы успешно устроились работать {FFFF00}электриком.");
        SendClientMessage(playerid, -1, "{FFFFFF}Теперь арендуйте {FFFF00}рабочий транспорт{FFFFFF} для начала работы.");

        SavePlayerElectricData(playerid);
    }
}

stock ResetPlayerOrderLabel(playerid)
{
    if(player_orders_electric[playerid] != -1)
    {
        new order_id = player_orders_electric[playerid];
        new city = player_electric_city[playerid];
        
        switch(city)
        {
            case 1: 
            {
                if(order_id < orders_count_city1)
                {
                    if(orders_electric_city1[order_id][E_LABEL] != Text3D:INVALID_3DTEXT_ID)
                    {
                        UpdateDynamic3DTextLabelText(orders_electric_city1[order_id][E_LABEL], 0xFFFFFFFF, " ");
                        Delete3DTextLabel(orders_electric_city1[order_id][E_LABEL]);
                        orders_electric_city1[order_id][E_LABEL] = Text3D:INVALID_3DTEXT_ID;
                    }
                }
            }
            case 2: 
            {
                if(order_id < orders_count_city2)
                {
                    if(orders_electric_city2[order_id][E_LABEL] != Text3D:INVALID_3DTEXT_ID)
                    {
                        UpdateDynamic3DTextLabelText(orders_electric_city2[order_id][E_LABEL], 0xFFFFFFFF, " ");
                        Delete3DTextLabel(orders_electric_city2[order_id][E_LABEL]);
                        orders_electric_city2[order_id][E_LABEL] = Text3D:INVALID_3DTEXT_ID;
                    }
                }
            }
            case 3: 
            {
                if(order_id < orders_count_city3)
                {
                    if(orders_electric_city3[order_id][E_LABEL] != Text3D:INVALID_3DTEXT_ID)
                    {
                        UpdateDynamic3DTextLabelText(orders_electric_city3[order_id][E_LABEL], 0xFFFFFFFF, " ");
                        Delete3DTextLabel(orders_electric_city3[order_id][E_LABEL]);
                        orders_electric_city3[order_id][E_LABEL] = Text3D:INVALID_3DTEXT_ID;
                    }
                }
            }
            case 4: 
            {
                if(order_id < orders_count_city4)
                {
                    if(orders_electric_city4[order_id][E_LABEL] != Text3D:INVALID_3DTEXT_ID)
                    {
                        UpdateDynamic3DTextLabelText(orders_electric_city4[order_id][E_LABEL], 0xFFFFFFFF, " ");
                        Delete3DTextLabel(orders_electric_city4[order_id][E_LABEL]);
                        orders_electric_city4[order_id][E_LABEL] = Text3D:INVALID_3DTEXT_ID;
                    }
                }
            }
        }
    }
}

stock ResetPlayerOrder(playerid)
{
    if(player_orders_electric[playerid] != -1)
    {
        new order_id = player_orders_electric[playerid];
        new city = player_electric_city[playerid];
        
        ResetPlayerOrderLabel(playerid);
        
        switch(city)
        {
            case 1: 
            {
                if(order_id < orders_count_city1)
                {
                    orders_electric_city1[order_id][E_ACTIVE] = true;
                    orders_electric_city1[order_id][E_PLAYER_ID] = -1;
                }
            }
            case 2: 
            {
                if(order_id < orders_count_city2)
                {
                    orders_electric_city2[order_id][E_ACTIVE] = true;
                    orders_electric_city2[order_id][E_PLAYER_ID] = -1;
                }
            }
            case 3: 
            {
                if(order_id < orders_count_city3)
                {
                    orders_electric_city3[order_id][E_ACTIVE] = true;
                    orders_electric_city3[order_id][E_PLAYER_ID] = -1;
                }
            }
            case 4: 
            {
                if(order_id < orders_count_city4)
                {
                    orders_electric_city4[order_id][E_ACTIVE] = true;
                    orders_electric_city4[order_id][E_PLAYER_ID] = -1;
                }
            }
        }
        
        player_orders_electric[playerid] = -1;
    }
}

stock ForceEndElectricWork(playerid)
{
    if(player_electric[playerid])
    {
        player_electric[playerid] = false;
        player_electric_work_start[playerid] = 0;

        if(player_electric_area[playerid] != -1)
        {
            DestroyDynamicArea(player_electric_area[playerid]);
            player_electric_area[playerid] = -1;
        }

        ResetPlayerOrder(playerid);

        if(player_arenda_electric[playerid] != -1) 
        {
            DestroyVehicle(player_arenda_electric[playerid]);
            player_arenda_electric[playerid] = -1;
        }

        if(GetPlayerSkin(playerid) == 11969) 
        {
            SetPlayerSkin(playerid, player_electric_skin_saved[playerid]);
        }
        
        DisablePlayerCheckpoint(playerid);

        SavePlayerElectricData(playerid);
    }
}

stock EndElectricWorkDay(playerid)
{
    ForceEndElectricWork(playerid);
    SendClientMessage(playerid, -1, "{FFFFFF}Вы завершили рабочий день электрика!");
}

stock ShowElectrickRentDialog(playerid, city)
{
    if(!player_electric[playerid]) 
    {
        SendClientMessage(playerid, -1, "{FFFFFF}Вы не работаете электриком.");
        return 0;
    }
    
    if(GetPlayerSkin(playerid) != 11969) 
    {
        SendClientMessage(playerid, -1, "{FFFFFF}Вы должны быть в рабочей форме.");
        return 0;
    }
    
    if(player_arenda_electric[playerid] != -1) 
    {
        SendClientMessage(playerid, -1, "{FFFFFF}У вас уже есть арендованный транспорт.");
        return 0;
    }
    
    new dialog[512];
    format(dialog, sizeof(dialog),
        "#\tназвание\tдоступность\tдействие\n\
        1.\tOpel Vivaro 2022\t%s\tНажмите для аренды\n\
        2.\tNissan Qashqai\t%s\tНажмите для аренды\n\
        3.\tNissan Pathfinder\t%s\tНажмите для аренды",
        (player_electric_rank[playerid] >= 1) ? ("{00FF00}Доступно") : ("{FF0000}Недоступно"),
        (player_electric_rank[playerid] >= 2) ? ("{00FF00}Доступно") : ("{FF0000}Недоступно"),
        (player_electric_rank[playerid] >= 3) ? ("{00FF00}Доступно") : ("{FF0000}Недоступно")
    );
    
    ShowPlayerDialog(playerid, 3244, DIALOG_STYLE_TABLIST_HEADERS,
        "{DC143C}C-Energy{FFFFFF} | Аренда транспорта", dialog, "Выбрать", "Закрыть");
    return 1;
}

stock CreateElectricVehicle(playerid, modelid, city)
{
    new spawn_index = random(3);
    player_arenda_electric[playerid] = CreateVehicle(modelid, 
        vehicle_spawns[city][spawn_index][0], 
        vehicle_spawns[city][spawn_index][1], 
        vehicle_spawns[city][spawn_index][2], 
        vehicle_spawns[city][spawn_index][3], 
        6, 0, 0
    );
    
    PutPlayerInVehicle(playerid, player_arenda_electric[playerid], 0);

    SetVehicleParam(player_arenda_electric[playerid], V_ENGINE, VEHICLE_PARAM_ON);
    
    DisablePlayerCheckpoint(playerid);
    SendClientMessage(playerid, -1, "{FFFFFF}Вы успешно арендовали рабочий транспорт!");
    SendClientMessage(playerid, -1, "{FFFFFF}Для просмотра списка вызовов используйте - {FFFF00} /elist");
    return 1;
}

CMD:elist(playerid)
{
    if(!player_electric[playerid]) return SendClientMessage(playerid, -1, "{FFFFFF}Вы не работаете электриком.");
    if(player_orders_electric[playerid] != -1) return SendClientMessage(playerid, -1, "{FFFFFF}Сначала выполните предыдущий вызов");
    if(GetPlayerSkin(playerid) != 11969) return SendClientMessage(playerid, -1, "{FFFFFF}Переоденьтесь в рабочую форму");
    if(player_arenda_electric[playerid] == -1) return SendClientMessage(playerid, -1, "{FFFFFF}Сначала арендуйте транспорт");
    if(GetPlayerVehicleID(playerid) != player_arenda_electric[playerid]) return SendClientMessage(playerid, -1, "{FFFFFF}Вы должны быть в рабочем транспорте");
    
    ShowAvailableOrders(playerid);
    return 1;
}

stock ShowAvailableOrders(playerid)
{
    new list[4096];
    format(list, sizeof(list), "{DC143C}Номер\tНазвание\tДоступность\n");

    new city = player_electric_city[playerid];
    new rank = player_electric_rank[playerid];

    if(city < 1 || city > 4)
    {
        SendClientMessage(playerid, -1, "{FFFFFF}Ошибка определения города.");
        return 0;
    }

    new available_orders[MAX_ORDERS_PER_CITY], order_count = 0;

    switch(city)
    {
        case 1:
        {
            for(new j = 0; j < orders_count_city1; j++)
            {
                if(orders_electric_city1[j][E_ACTIVE] &&
                   !orders_electric_city1[j][E_IN_COOLDOWN] &&
                   orders_electric_city1[j][E_PLAYER_ID] == -1)
                {
                    available_orders[order_count++] = j;
                }
            }
        }
        case 2:
        {
            for(new j = 0; j < orders_count_city2; j++)
            {
                if(orders_electric_city2[j][E_ACTIVE] &&
                   !orders_electric_city2[j][E_IN_COOLDOWN] &&
                   orders_electric_city2[j][E_PLAYER_ID] == -1)
                {
                    available_orders[order_count++] = j;
                }
            }
        }
        case 3:
        {
            for(new j = 0; j < orders_count_city3; j++)
            {
                if(orders_electric_city3[j][E_ACTIVE] &&
                   !orders_electric_city3[j][E_IN_COOLDOWN] &&
                   orders_electric_city3[j][E_PLAYER_ID] == -1)
                {
                    available_orders[order_count++] = j;
                }
            }
        }
        case 4:
        {
            for(new j = 0; j < orders_count_city4; j++)
            {
                if(orders_electric_city4[j][E_ACTIVE] &&
                   !orders_electric_city4[j][E_IN_COOLDOWN] &&
                   orders_electric_city4[j][E_PLAYER_ID] == -1)
                {
                    available_orders[order_count++] = j;
                }
            }
        }
    }
    
    for(new i = 0; i < order_count; i++)
    {
        new order_index = available_orders[i];
        new order_name[64], order_rank;

        switch(city)
        {
            case 1:
            {
                format(order_name, sizeof(order_name), "%s", orders_electric_city1[order_index][E_NAME]);
                order_rank = orders_electric_city1[order_index][E_RANK];
            }
            case 2:
            {
                format(order_name, sizeof(order_name), "%s", orders_electric_city2[order_index][E_NAME]);
                order_rank = orders_electric_city2[order_index][E_RANK];
            }
            case 3:
            {
                format(order_name, sizeof(order_name), "%s", orders_electric_city3[order_index][E_NAME]);
                order_rank = orders_electric_city3[order_index][E_RANK];
            }
            case 4:
            {
                format(order_name, sizeof(order_name), "%s", orders_electric_city4[order_index][E_NAME]);
                order_rank = orders_electric_city4[order_index][E_RANK];
            }
        }
        
        new available = (rank >= order_rank) ? 1 : 0;
        
        new list_line[128];
        format(list_line, sizeof(list_line), "{DC143C}%d.\t{FFFFFF}%s\t%s\n", 
            i + 1, 
            order_name,
            available ? "{00FF00}Доступно" : "{FF0000}Недоступно");
            
        strcat(list, list_line);
    }

    if(order_count == 0)
    {
        SendClientMessage(playerid, -1, "{FFFFFF}Нет доступных вызовов в вашем городе.");
        return 0;
    }

    ShowPlayerDialog(playerid, 3248, DIALOG_STYLE_TABLIST_HEADERS,
        "{DC143C}C-Energy{FFFFFF} | Список вызовов", list, "Выбрать", "Отмена");
    return 1;
}

stock StartElectricWork(playerid, order_id)
{
    new city = player_electric_city[playerid];
    if(city < 1 || city > 4) return 0;

    new Float:order_x, Float:order_y, Float:order_z;

    switch(city)
    {
        case 1:
        {
            if(order_id < sizeof(orders_electric_city1))
            {
                order_x = orders_electric_city1[order_id][E_X];
                order_y = orders_electric_city1[order_id][E_Y];
                order_z = orders_electric_city1[order_id][E_Z];
            }
        }
        case 2:
        {
            if(order_id < sizeof(orders_electric_city2))
            {
                order_x = orders_electric_city2[order_id][E_X];
                order_y = orders_electric_city2[order_id][E_Y];
                order_z = orders_electric_city2[order_id][E_Z];
            }
        }
        case 3:
        {
            if(order_id < sizeof(orders_electric_city3))
            {
                order_x = orders_electric_city3[order_id][E_X];
                order_y = orders_electric_city3[order_id][E_Y];
                order_z = orders_electric_city3[order_id][E_Z];
            }
        }
        case 4:
        {
            if(order_id < sizeof(orders_electric_city4))
            {
                order_x = orders_electric_city4[order_id][E_X];
                order_y = orders_electric_city4[order_id][E_Y];
                order_z = orders_electric_city4[order_id][E_Z];
            }
        }
    }

    if(order_x == 0.0 && order_y == 0.0 && order_z == 0.0)
    {
        SendClientMessage(playerid, -1, "{FF0000}Ошибка: не удалось определить координаты заказа.");
        return 0;
    }

    if(player_electric_area[playerid] != -1)
    {
        DestroyDynamicArea(player_electric_area[playerid]);
    }
    player_electric_area[playerid] = CreateDynamicSphere(order_x, order_y, order_z, 3.0, -1, -1);

    EnablePlayerGPS(playerid, order_x, order_y, order_z, "{FFFF00}Вызов {FFFFFF}| Точка выполнения вызова отмечена на крате.");

    return 1;
}

