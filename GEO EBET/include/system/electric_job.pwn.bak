stock ShowSanSanychCard(playerid)
{
    new needed_exp;
    switch(player_electric_rank[playerid])
    {
        case 1: needed_exp = 100 - player_electric_exp[playerid];
        case 2: needed_exp = 300 - player_electric_exp[playerid];
        case 3: needed_exp = 600 - player_electric_exp[playerid];
        case 4: needed_exp = 0;
        default: needed_exp = 100 - player_electric_exp[playerid];
    }
    
    new card_info[1024];
    format(card_info, sizeof(card_info),
        "Вот твоя личная карточка, прочитай повнимательнее - \n\n\
        {FFFF00}1.{FFFFFF} Имя: {FFFF00}%s\n\
        {FFFF00}2.{FFFFFF} Должность: {FFFF00}Электрик %d ранга\n\
        {FFFF00}3.{FFFFFF} Выполненных вызовов за все время: {FFFF00}%d\n\
        {FFFF00}4.{FFFFFF} Осталось опыта для повышения в должности: {FFFF00}%d\n\n\
        {FFFFFF}Доступные вызовы:\n\n",
        GetPlayerNameEx(playerid),
        player_electric_rank[playerid],
        player_electric_orders_total[playerid],
        needed_exp
    );
    
    if(player_electric_rank[playerid] == 1)
    {
        format(card_info, sizeof(card_info), "%s{FFFF00}Починка уличных фонарей{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n\n", 
            card_info, player_electric_orders_lamp[playerid]);
    }
    else if(player_electric_rank[playerid] == 2)
    {
        format(card_info, sizeof(card_info), "%s{FFFF00}Починка уличных фонарей{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n", 
            card_info, player_electric_orders_lamp[playerid]);
        format(card_info, sizeof(card_info), "%s{FFFF00}Диагностика электрощита{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n\n", 
            card_info, player_electric_orders_shield[playerid]);
    }
    else if(player_electric_rank[playerid] == 3)
    {
        format(card_info, sizeof(card_info), "%s{FFFF00}Починка уличных фонарей{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n", 
            card_info, player_electric_orders_lamp[playerid]);
        format(card_info, sizeof(card_info), "%s{FFFF00}Диагностика электрощита{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n", 
            card_info, player_electric_orders_shield[playerid]);
        format(card_info, sizeof(card_info), "%s{FFFF00}Починка трансформаторной будки{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n\n", 
            card_info, player_electric_orders_transformer[playerid]);
    }
    else if(player_electric_rank[playerid] == 4)
    {
        format(card_info, sizeof(card_info), "%s{FFFF00}Починка уличных фонарей{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n", 
            card_info, player_electric_orders_lamp[playerid]);
        format(card_info, sizeof(card_info), "%s{FFFF00}Диагностика электрощитовых{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n", 
            card_info, player_electric_orders_shield[playerid]);
        format(card_info, sizeof(card_info), "%s{FFFF00}Починка трансформаторных будок{FFFFFF} | Выполнено вызовов: {FFFF00}%d\n", 
            card_info, player_electric_orders_transformer[playerid]);
        format(card_info, sizeof(card_info), "%s{FFFF00}Отладка светофоров{FFFFFF} | Выполнено вызовов: {FFFF00}%d", 
            card_info, player_electric_orders_traffic[playerid]);
    }
    
    ShowPlayerDialog(playerid, 3252, DIALOG_STYLE_MSGBOX,
        "{DC143C}C-Energy{FFFFFF} | Личная карточка",
        card_info, "Назад", "Закрыть");
}

stock ShowSanSanychStartWork(playerid)
{
    ShowPlayerDialog(playerid, 3253, DIALOG_STYLE_MSGBOX,
        "{DC143C}C-Energy{FFFFFF} | Трудоустройство",
        "Здравствуй, горе-электрик, хе-хе. Я инженер этой компании и несу ответственность за всех сотрудников.\nМне нужны умелые руки, чтобы не приходилось исправлять за ними.\nЕсли ты подходишь под мои условия, то поздравляю. Ты принят на работу! \n\n{FFFF00}Примечание: для работы нужен 7 игровой уровень",
        "Начать", "Назад");
