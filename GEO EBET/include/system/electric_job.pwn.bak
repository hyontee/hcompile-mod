    ShowElectricMiniGame(playerid, ELECTRIC_FIND_PROBLEM, order_id);
    return 1;
}

stock ShowShieldDiagnosticGUI(playerid, order_id)
{
    ShowElectricMiniGame(playerid, ELECTRIC_SUM_CONTACTS, order_id);
    return 1;
}

stock ShowRaceChargeGUI(playerid, order_id)
{
    ShowElectricMiniGame(playerid, ELECTRIC_RAISE_CHARGE, order_id);
    return 1;
}

stock ShowTrafficLightRepairGUI(playerid, order_id)
{
    if(player_electric_rank[playerid] < 4) 
    {
        SendClientMessage(playerid, -1, "{FFFFFF}Ремонт светофоров с 4 ранга!");
        return 0;
    }
    ShowElectricMiniGame(playerid, ELECTRIC_COLLECT_SCHEME, order_id);
    return 1;
}

stock ShowElectricMiniGame(playerid, gameType, order_id)
{
    if(!player_electric[playerid]) return 0;
    
    player_electric_game[playerid] = gameType;
    player_electric_order[playerid] = order_id;
    
    new Node:json = JSON_Object();
    JSON_SetInt(json, "t", 1);
    JSON_SetInt(json, "screen", 56);
    JSON_SetString(json, "categoryTitle", "Работа электрика");
    JSON_SetBool(json, "isInterfaceVisible", true);
    JSON_SetInt(json, "mg", gameType);
    JSON_SetInt(json, "levelCounter", player_electric_rank[playerid]);
    JSON_SetInt(json, "orderId", order_id);
    
    new salary = 0;
    switch(gameType)
    {
        case ELECTRIC_FIND_PROBLEM: salary = 5000;
        case ELECTRIC_SUM_CONTACTS: salary = 8000;
        case ELECTRIC_RAISE_CHARGE: salary = 11000;
        case ELECTRIC_COLLECT_SCHEME: salary = 14000;
    }
    JSON_SetInt(json, "salary", salary);
    
    JSON_SetInt(json, "countWin", 0);
    JSON_SetBool(json, "isNeedClose", false);
    JSON_SetBool(json, "isBlockingLoading", false);

    new Node:instructionsArray = JSON_Array();
    
    switch(gameType)
    {
        case ELECTRIC_FIND_PROBLEM:
        {
            new Node:instruction1 = JSON_Object();
            JSON_SetString(instruction1, "ti", "Для проверки предохранителей,\nВам потребуется провести проверку платы.\n\nС помощью клеммы к точке\nнапряжения и точке заземления,\nВы сможете измерить\nсколько Ohm показывает каждый\nпредохранитель.\n\nСправа Вы увидите какое\nнапряжение Вам необходимо");
            new Node:hints1 = JSON_Array();
            JSON_Append(hints1, JSON_String(""));
            JSON_Append(hints1, JSON_String(""));
            JSON_SetArray(instruction1, "th", hints1);
            JSON_Append(instructionsArray, instruction1);
        }
        case ELECTRIC_SUM_CONTACTS:
        {
            new Node:instruction1 = JSON_Object();
            JSON_SetString(instruction1, "ti", "Чтобы выполнить диагностику электрощита\nВам нужно взять лампы с числами\nи вставить их в патронники так,\nчтобы их сумма была равной\nчислу на панели.");
            new Node:hints1 = JSON_Array();
            JSON_Append(hints1, JSON_String(""));
            JSON_Append(hints1, JSON_String(""));
            JSON_SetArray(instruction1, "th", hints1);
            JSON_Append(instructionsArray, instruction1);
        }
        case ELECTRIC_COLLECT_SCHEME:
        {
            new Node:instruction1 = JSON_Object();
            JSON_SetString(instruction1, "ti", "Для починки светофора Вам нужно\nвключить тумблер светофора так,\nкак показано на схеме слева.");
            new Node:hints1 = JSON_Array();
            JSON_Append(hints1, JSON_String(""));
            JSON_Append(hints1, JSON_String(""));
            JSON_SetArray(instruction1, "th", hints1);
            JSON_Append(instructionsArray, instruction1);
        }
        case ELECTRIC_RAISE_CHARGE:
        {
            new Node:instruction1 = JSON_Object();
            JSON_SetString(instruction1, "ti", "Это работа на повышение мощности,\nдля её выполнения вы должны нажимать\nна кнопку 'поднять' и поднимать\nмощность до определённой отметки,\nпосле чего вам нужно закрепить то значение.");
            new Node:hints1 = JSON_Array();
            JSON_Append(hints1, JSON_String(""));
            JSON_Append(hints1, JSON_String(""));
            JSON_SetArray(instruction1, "th", hints1);
            JSON_Append(instructionsArray, instruction1);
        }
    }

    JSON_SetArray(json, "hi", instructionsArray);

    new screenArgsString[512];
    JSON_Stringify(instructionsArray, screenArgsString, sizeof(screenArgsString), false);
    JSON_SetString(json, "screenArgs", screenArgsString);

    ShowPlayerGUI(playerid, 56, json);
    
    new arrayLength;
    JSON_ArrayLength(instructionsArray, arrayLength);
    
    for(new i = 0; i < arrayLength; i++)
    {
        new Node:instruction;
        if(JSON_ArrayObject(instructionsArray, i, instruction))
        {
            new Node:hints;
            if(JSON_GetArray(instruction, "th", hints))
            {
                JSON_Cleanup(hints);
            }
            JSON_Cleanup(instruction);
        }
    }
    
    JSON_Cleanup(instructionsArray);
    JSON_Cleanup(json);
    
    return 1;
}

forward ElectricRetryGame(playerid, orderId);
public ElectricRetryGame(playerid, orderId)
{
    player_electric_frozen[playerid] = false;
    TogglePlayerControllable(playerid, true);
    ClearAnimations(playerid);

    new mg = player_electric_game[playerid];
    if(mg > 0)
    {
        ShowElectricMiniGame(playerid, mg, orderId);
        SendClientMessage(playerid, -1, "{FFFFFF}Повторяем попытку...");
    }
    else
    {
        SendClientMessage(playerid, -1, "{FFFFFF}Ошибка повтора. Возьмите вызов заново.");
    }
}

stock GivePlayerElectricExp(playerid, exp)
{
    player_electric_exp[playerid] += exp;
    
    new old_rank = player_electric_rank[playerid];
    new new_rank = old_rank;
    
    if(player_electric_exp[playerid] >= 100 && old_rank == 1) new_rank = 2;
    else if(player_electric_exp[playerid] >= 300 && old_rank == 2) new_rank = 3;
    else if(player_electric_exp[playerid] >= 600 && old_rank == 3) new_rank = 4;
    
    if(new_rank != old_rank)
    {
        player_electric_rank[playerid] = new_rank;
        new msg[128];
        format(msg, sizeof(msg), "{FFFFFF}Поздравляем! Вы получили {FFFF00}%d {FFFFFF}ранг электрика!", new_rank);
        SendClientMessage(playerid, -1, msg);
    }
    
    SavePlayerElectricData(playerid);
    return 1;
}

stock SavePlayerElectricData(playerid)
{
    new query[512];
    mysql_format(mysql, query, sizeof(query),
        "UPDATE accounts SET electric_rank = %d, electric_exp = %d, electricorders_total = %d, electricorders_lampa = %d, electricorders_diagnoz = %d, electricorders_transgay = %d, electricorders_svetofors = %d WHERE id = %d",
        player_electric_rank[playerid], 
        player_electric_exp[playerid],
        player_electric_orders_total[playerid],
        player_electric_orders_lamp[playerid],
        player_electric_orders_shield[playerid],
        player_electric_orders_transformer[playerid],
        player_electric_orders_traffic[playerid],
        GetPlayerAccountID(playerid)
    );
    mysql_query(mysql, query, false);
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == 3250 && response)
    {
        switch(listitem)
        {
            case 0: ShowSanSanychInfo(playerid);
            case 1: ShowSanSanychStartWork(playerid);
            case 2: ShowSanSanychCard(playerid);
            case 3: ShowSanSanychEndWork(playerid);
        }
        return 1;
    }
    
    if(dialogid == 3251 && response)
    {
        ShowSanSanychDialog(playerid);
        return 1;
    }
    
    if(dialogid == 3252 && response)
    {
        ShowSanSanychDialog(playerid);
        return 1;
    }
    
    if(dialogid == 3253 && response)
    {
        if(GetPlayerLevel(playerid) < 7) 
            return SendClientMessage(playerid, -1, "{FFFFFF}Для работы электриком нужен 7 уровень!");
        
        if(!player_electric[playerid])
        {
            StartElectricWorkDay(playerid);
        }
        return 1;
    }
    
    if(dialogid == 3254 && response)
    {
        if(player_electric[playerid])
        {
            EndElectricWorkDay(playerid);
        }
        return 1;
    }
    
    if(dialogid == 3244 && response)
    {
        new city = player_electric_city[playerid];
        if(city == -1) 
        {
            SendClientMessage(playerid, -1, "{FFFFFF}Вы не у базы электриков.");
            return 1;
        }

        if(!player_electric[playerid]) 
        {
            SendClientMessage(playerid, -1, "{FFFFFF}Вы не работаете электриком.");
            return 1;
        }
        
        if(GetPlayerSkin(playerid) != 11969) 
        {
            SendClientMessage(playerid, -1, "{FFFFFF}Вы должны быть в рабочей форме.");
            return 1;
        }
        
        if(player_arenda_electric[playerid] != -1) 
        {
            SendClientMessage(playerid, -1, "{FFFFFF}У вас уже есть арендованный транспорт.");
            return 1;
        }
        
        switch(listitem)
        {
            case 0: 
            {
                if(player_electric_rank[playerid] >= 1) 
                    CreateElectricVehicle(playerid, 2381, city-1);
                else 
                    ShowNotificationNew(playerid, 0, 5, 0, 0, "Данный транспорт доступен от 1-го ранга электрика", "");
            }
            case 1: 
            {
                if(player_electric_rank[playerid] >= 3) 
                    CreateElectricVehicle(playerid, 2385, city-1);
                else 
                    ShowNotificationNew(playerid, 0, 5, 0, 0, "Данный транспорт доступен от 3-го ранга электрика", "");
            }
            case 2: 
            {
                if(player_electric_rank[playerid] >= 4) 
                    CreateElectricVehicle(playerid, 2380, city-1);
                else 
                    ShowNotificationNew(playerid, 0, 5, 0, 0, "Данный транспорт доступен от 4-го ранга электрика", "");
            }
        }
        return 1;
    }
    
    if(dialogid == 3245 && response)
    {
        if(player_arenda_electric[playerid] != -1)
        {
            DestroyVehicle(player_arenda_electric[playerid]);
            player_arenda_electric[playerid] = -1;
            SendClientMessage(playerid, -1, "{FFFFFF}Аренда транспорта отменена.");
        }
        return 1;
    }
    
    if(dialogid == 3248 && response)
    {
        if(!player_electric[playerid] || player_orders_electric[playerid] != -1 || GetPlayerSkin(playerid) != 11969 || 
           player_arenda_electric[playerid] == -1 || GetPlayerVehicleID(playerid) != player_arenda_electric[playerid]) 
            return 1;

        new city = player_electric_city[playerid];
        if(city < 1 || city > 4) return 1;

        new available_orders[MAX_ORDERS_PER_CITY], order_count = 0;

        switch(city)
        {
            case 1:
            {
                for(new i = 0; i < sizeof(orders_electric_city1); i++)
                {
                    if(orders_electric_city1[i][E_ACTIVE] &&
                       !orders_electric_city1[i][E_IN_COOLDOWN] &&
                       orders_electric_city1[i][E_PLAYER_ID] == -1)
                    {
                        available_orders[order_count++] = i;
                    }
                }
            }
            case 2:
            {
                for(new i = 0; i < sizeof(orders_electric_city2); i++)
                {
                    if(orders_electric_city2[i][E_ACTIVE] &&
                       !orders_electric_city2[i][E_IN_COOLDOWN] &&
                       orders_electric_city2[i][E_PLAYER_ID] == -1)
                    {
                        available_orders[order_count++] = i;
                    }
                }
            }
            case 3:
            {
                for(new i = 0; i < sizeof(orders_electric_city3); i++)
                {
                    if(orders_electric_city3[i][E_ACTIVE] &&
                       !orders_electric_city3[i][E_IN_COOLDOWN] &&
                       orders_electric_city3[i][E_PLAYER_ID] == -1)
                    {
                        available_orders[order_count++] = i;
                    }
                }
            }
            case 4:
            {
                for(new i = 0; i < sizeof(orders_electric_city4); i++)
                {
                    if(orders_electric_city4[i][E_ACTIVE] &&
                       !orders_electric_city4[i][E_IN_COOLDOWN] &&
                       orders_electric_city4[i][E_PLAYER_ID] == -1)
                    {
                        available_orders[order_count++] = i;
                    }
                }
            }
        }

        if(listitem >= order_count) return 1;

        new selected_order = available_orders[listitem];
        new order_rank, order_type;
        new order_name[84];
        
        switch(city)
        {
            case 1:
            {
                format(order_name, sizeof(order_name), "%s", orders_electric_city1[selected_order][E_NAME]);
                order_rank = orders_electric_city1[selected_order][E_RANK];
                order_type = orders_electric_city1[selected_order][E_TYPE];
            }
            case 2:
            {
                format(order_name, sizeof(order_name), "%s", orders_electric_city2[selected_order][E_NAME]);
                order_rank = orders_electric_city2[selected_order][E_RANK];
                order_type = orders_electric_city2[selected_order][E_TYPE];
            }
            case 3:
            {
                format(order_name, sizeof(order_name), "%s", orders_electric_city3[selected_order][E_NAME]);
                order_rank = orders_electric_city3[selected_order][E_RANK];
                order_type = orders_electric_city3[selected_order][E_TYPE];
            }
            case 4:
            {
                format(order_name, sizeof(order_name), "%s", orders_electric_city4[selected_order][E_NAME]);
                order_rank = orders_electric_city4[selected_order][E_RANK];
                order_type = orders_electric_city4[selected_order][E_TYPE];
            }
        }

        if(player_electric_rank[playerid] < order_rank)
        {
            ShowNotificationNew(playerid, 0, 5, 0, 0, "Вам недоступен этот вызов", "");
            return 1;
        }

        player_orders_electric[playerid] = selected_order;
        player_electric_ordertype[playerid] = order_type;
        
        switch(order_type)
        {
            case 1: player_salary_electric[playerid] = 7000;
            case 2: player_salary_electric[playerid] = 10000;
            case 3: player_salary_electric[playerid] = 15000;
            case 4: player_salary_electric[playerid] = 12000;
        }

        new label_text_buffer[128];
        format(label_text_buffer, sizeof(label_text_buffer), "{FFFF00}%s", 
            order_name);

        switch(city)
        {
            case 1:
            {
                if(selected_order < sizeof(orders_electric_city1))
                {
                    orders_electric_city1[selected_order][E_PLAYER_ID] = playerid;
                    orders_electric_city1[selected_order][E_ACTIVE] = false;
                    
                    orders_electric_city1[selected_order][E_LABEL] = CreateDynamic3DTextLabel(label_text_buffer, -1,
                        orders_electric_city1[selected_order][E_X],
                        orders_electric_city1[selected_order][E_Y],
                        orders_electric_city1[selected_order][E_Z] + 0.3, 10.0);
                }
            }
            case 2:
            {
                if(selected_order < sizeof(orders_electric_city2))
                {
                    orders_electric_city2[selected_order][E_PLAYER_ID] = playerid;
                    orders_electric_city2[selected_order][E_ACTIVE] = false;
                    
                    orders_electric_city2[selected_order][E_LABEL] = CreateDynamic3DTextLabel(label_text_buffer, -1,
                        orders_electric_city2[selected_order][E_X],
                        orders_electric_city2[selected_order][E_Y],
                        orders_electric_city2[selected_order][E_Z] + 0.3, 10.0);
                }
            }
            case 3:
            {
                if(selected_order < sizeof(orders_electric_city3))
                {
                    orders_electric_city3[selected_order][E_PLAYER_ID] = playerid;
                    orders_electric_city3[selected_order][E_ACTIVE] = false;
                    
                    orders_electric_city3[selected_order][E_LABEL] = CreateDynamic3DTextLabel(label_text_buffer, -1,
                        orders_electric_city3[selected_order][E_X],
                        orders_electric_city3[selected_order][E_Y],
                        orders_electric_city3[selected_order][E_Z] + 0.3, 10.0);
                }
            }
            case 4:
            {
                if(selected_order < sizeof(orders_electric_city4))
                {
                    orders_electric_city4[selected_order][E_PLAYER_ID] = playerid;
                    orders_electric_city4[selected_order][E_ACTIVE] = false;
                    
                    orders_electric_city4[selected_order][E_LABEL] = CreateDynamic3DTextLabel(label_text_buffer, -1,
                        orders_electric_city4[selected_order][E_X],
                        orders_electric_city4[selected_order][E_Y],
                        orders_electric_city4[selected_order][E_Z] + 0.3, 10.0);
                }
            }
        }

        StartElectricWork(playerid, selected_order);
        return 1;
    }
    
    #if defined e_OnDialogResponse
        return e_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    #endif
}

public OnPlayerConnect(playerid)
{
    OrdinaryNewElectric(playerid);
    
    #if defined e_OnPlayerConnect
        return e_OnPlayerConnect(playerid);
    #endif
}

public OnPlayerDisconnect(playerid, reason)
{
    if(player_electric[playerid])
    {
        ForceEndElectricWork(playerid);
    }
    
    OrdinaryNewElectric(playerid);
    
    #if defined e_OnPlayerDisconnect
        return e_OnPlayerDisconnect(playerid, reason);
    #endif
}

public OnPlayerSpawn(playerid)
{
    if(player_electric[playerid])
    {
        if(GetPlayerSkin(playerid) != 11969)
        {
            ForceEndElectricWork(playerid);
        }
    }
    
    if(player_arenda_electric[playerid] != -1) 
    {
   	ForceEndElectricWork(playerid);
    }
    
    LoadPlayerElectricData(playerid);
    
    #if defined e_OnPlayerSpawn
        return e_OnPlayerSpawn(playerid);
    #endif
}

public OnVehicleSpawn(vehicleid)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && player_arenda_electric[i] == vehicleid)
        {
            DestroyVehicle(player_arenda_electric[i]);
            player_arenda_electric[i] = -1;
            
        }
    }
    
    #if defined e_OnVehicleSpawn
        return e_OnVehicleSpawn(vehicleid);
    #endif
}

stock OrdinaryNewElectric(playerid)
{
    if(player_arenda_electric[playerid] != -1) 
    {
        DestroyVehicle(player_arenda_electric[playerid]);
        player_arenda_electric[playerid] = -1;
    }
    
    if(player_electric_area[playerid] != -1)
    {
        DestroyDynamicArea(player_electric_area[playerid]);
        player_electric_area[playerid] = -1;
    }
    
    player_electric[playerid] = false;
    player_salary_electric[playerid] = 0;
    player_orders_electric[playerid] = -1;
    player_electric_rank[playerid] = 1;
    player_electric_exp[playerid] = 0;
    player_electric_skin_saved[playerid] = 0;
    player_electric_game[playerid] = 0;
    player_electric_order[playerid] = -1;
    player_electric_city[playerid] = 0;
    player_electric_work_start[playerid] = 0;
    player_electric_orders_total[playerid] = 0;
    player_electric_orders_lamp[playerid] = 0;
    player_electric_orders_shield[playerid] = 0;
    player_electric_orders_transformer[playerid] = 0;
    player_electric_orders_traffic[playerid] = 0;
    
    return 1;
}

stock LoadPlayerElectricData(playerid)
{
    new query[256];
    mysql_format(mysql, query, sizeof(query), 
        "SELECT electric_rank, electric_exp, electricorders_total, electricorders_lampa, electricorders_diagnoz, electricorders_transgay, electricorders_svetofors FROM accounts WHERE id = %d", 
        GetPlayerAccountID(playerid)
    );
    
    new Cache:cache = mysql_query(mysql, query);
    if(cache_get_row_count() > 0)
    {
        player_electric_rank[playerid] = cache_get_row_int(0, 0);
        player_electric_exp[playerid] = cache_get_row_int(0, 1);
        player_electric_orders_total[playerid] = cache_get_row_int(0, 2);
        player_electric_orders_lamp[playerid] = cache_get_row_int(0, 3);
        player_electric_orders_shield[playerid] = cache_get_row_int(0, 4);
        player_electric_orders_transformer[playerid] = cache_get_row_int(0, 5);
        player_electric_orders_traffic[playerid] = cache_get_row_int(0, 6);
    }
    cache_delete(cache);
    return 1;
}

stock IncreaseElectricOrderStats(playerid, order_type)
{
    player_electric_orders_total[playerid]++;
    
    switch(order_type)
    {
        case ORDER_TYPE_LAMP:
        {
            player_electric_orders_lamp[playerid]++;
        }
        case ORDER_TYPE_SHIELD:
        {
            player_electric_orders_shield[playerid]++;
        }
        case ORDER_TYPE_TRANSFORMER:
        {
            player_electric_orders_transformer[playerid]++;
        }
        case ORDER_TYPE_TRAFFIC:
        {
            player_electric_orders_traffic[playerid]++;
        }
        default:
        {
            printf("[ELECTRIC] Ошибка: неизвестный тип заказа %d у игрока %s", order_type, GetPlayerNameEx(playerid));
        }
    }
    
    SavePlayerElectricData(playerid);

    return 1;
}

CMD:electricstartordergame(playerid)
{
    if(!player_electric[playerid])
        return SendClientMessage(playerid, -1, "{FFFFFF}Вы не работаете электриком.");
    
    if(player_orders_electric[playerid] == -1)
        return SendClientMessage(playerid, -1, "{FFFFFF}У вас нет активного вызова.");
    
    if(IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, -1, "{FFFFFF}Выйдите из транспортного средства.");
    
    if(!IsPlayerInDynamicArea(playerid, player_electric_area[playerid]))
        return SendClientMessage(playerid, -1, "{FFFFFF}Вы не в зоне выполнения вызова.");

    ShowElectricMiniGame(playerid, player_electric_ordertype[playerid], player_orders_electric[playerid]);
    
    return 1;
}

