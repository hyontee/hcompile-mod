                InitPlayerCaseBonusStates(g_player_case_bonus[playerid], sizeof(g_player_case_bonus[]));
                new query[2048];
        
	        mysql_format(mysql, query, sizeof query, "UPDATE accounts SET `case_bonus`='%s' WHERE `id`=%d LIMIT 1", g_player_case_bonus[playerid], GetPlayerAccountID(playerid));
	        mysql_query(mysql, query, false);
            }
        
            new caseData[512];
            format(caseData, sizeof(caseData), "%s", g_player_case[playerid]);
        
            new openedCases[MAX_CASES];
            for (new i = 0; i < MAX_CASES; i++) openedCases[i] = 0;
        
            if (strlen(caseData) > 0)
            {
                new tmp[64];
                new idx = 0, pos = 0;
        
                for (new i = 0; i <= strlen(caseData) && idx < MAX_CASES; i++)
                {
                    if (caseData[i] == ',' || caseData[i] == '\0')
                    {
                        tmp[pos] = '\0';
                        new val = strval(tmp);
                        if (val > 300) val = 300;
                        openedCases[idx++] = val;
                        pos = 0;
                    }
					else
                    {
                        if (pos < sizeof(tmp) - 1)
                            tmp[pos++] = caseData[i];
                    }
                }
            }
        
            RefreshCaseBonusStatesForCase(
                g_player_case_bonus[playerid],
                sizeof(g_player_case_bonus[]),
                caseIndex,
                openedCases[caseIndex - 1]
            );
        
            new curState = GetCaseBonusState(g_player_case_bonus[playerid], caseIndex, buttonIndex);
            if (curState != CASE_BONUS_STATE_AVAILABLE)
            {
                printf("[CASE BONUS] Player %d tried claim unavailable bonus: case=%d button=%d state=%d",
                    playerid, caseIndex, buttonIndex, curState);
                return 1;
            }
        
            //    
            // GiveCaseBonusReward(playerid, caseIndex, buttonIndex);
			if (!SavePlayerCaseBonusReward(playerid, caseIndex, buttonIndex))
            {
                printf("[CASE BONUS]    : player=%d case=%d button=%d",
                    playerid, caseIndex, buttonIndex);
                return 1;
            }
            SetCaseBonusState(
                g_player_case_bonus[playerid],
                sizeof(g_player_case_bonus[]),
                caseIndex,
                buttonIndex,
                CASE_BONUS_STATE_CLAIMED
            );
        
            new query[2048];
        
	        mysql_format(mysql, query, sizeof query, "UPDATE accounts SET `case_bonus`='%s' WHERE `id`=%d LIMIT 1", g_player_case_bonus[playerid], GetPlayerAccountID(playerid));
	        mysql_query(mysql, query, false);
           
            printf("[CASE BONUS] Player %d ->  %d,  %d : %s",
                playerid, caseIndex, buttonIndex, g_player_case_bonus[playerid]);
        
            new JSON:response = JSON_Object();
            JSON_SetInt(response, "t", 1);
        
            JSON_SetInt(response, "bcc", openedCases[caseIndex - 1]);
        
            new cbStr[512];
            BuildCaseBonusJsonForClient(cbStr, sizeof(cbStr), g_player_case_bonus[playerid], caseIndex);
        
            new JSON:cbArray = JSON_Array();
            JSON_Parse(cbStr, cbArray);
            JSON_SetArray(response, "cb", cbArray);
			new ccStr[512];
            ccStr[0] = '\0';
            strcat(ccStr, "[", sizeof(ccStr));
        
            for (new i = 1; i <= MAX_CASES; i++)
            {
                new cot = 0;
                if (i == 5)
                    cot = GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE);
        
                format(ccStr[strlen(ccStr)], sizeof(ccStr) - strlen(ccStr),
                    "{\"id\":%d,\"cot\":%d}%s", i, cot, (i < MAX_CASES) ? "," : ""
                );
            }
        
            strcat(ccStr, "]", sizeof(ccStr));
        
            new JSON:ccArray = JSON_Array();
            JSON_Parse(ccStr, ccArray);
            JSON_SetArray(response, "cc", ccArray);
        
            OnPacketIncoming(playerid, 73, response);
            JSON_Cleanup(response);
        }
	}
}
case 63:
{
    new type;
    JSON_GetInt(json, "t", type);  //   ( )

    switch(type)
    {
        case 1:  //    (sendCloseScreen)
        {
            new closeFlag;
            JSON_GetInt(json, "c", closeFlag);

            if (closeFlag == 1)
            {
                //   :    
                new JSON:response = JSON_Object();
                JSON_SetInt(response, "s", 0);  // screen = 0 ()
                JSON_SetInt(response, "st", 1);  // isNeedClose = true

                OnPacketIncoming(playerid, 63, response);
                JSON_Cleanup(response);
                
                //  
                SendClientMessage(playerid, -1, "NPC interaction closed.");
            }
        }
        case 2:  //    (sendButtonClick)
        {
            new buttonKey;
            JSON_GetInt(json, "b", buttonKey);

            //    buttonKey,   
            new JSON:response = JSON_Object();
            JSON_SetInt(response, "s", 1);  // screen = 1 ( )
            JSON_SetString(response, "tt", "NPC Title");  // textTitle
            JSON_SetString(response, "td", "Hello, adventurer! What do you want?");  // textDesc
            JSON_SetInt(response, "ts", 50);  // typingSpeed = 50ms
            JSON_SetBool(response, "st", true);  // isSkipText = true
            JSON_SetInt(response, "r", 101);  // renderId = 101 ( NPC )

            //   (bt)   InteractionWithNpcButtonModel
            new JSON:buttonList = JSON_Array();
            
            new JSON:btn1 = JSON_Object();
            JSON_SetInt(btn1, "k", INTERACTION_WITH_NPC_BUTTON_GREEN);  // key = 1 (green)
            JSON_SetString(btn1, "n", "Accept Quest");  // name
            JSON_SetInt(btn1, "i", 1);  // id = 1
            JSON_Append(buttonList, btn1);
            
            new JSON:btn2 = JSON_Object();
            JSON_SetInt(btn2, "k", INTERACTION_WITH_NPC_BUTTON_RED);  // key = 3 (red)
            JSON_SetString(btn2, "n", "Decline");  // name
            JSON_SetInt(btn2, "i", 2);  // id = 2
            JSON_Append(buttonList, btn2);
            
            new JSON:btn3 = JSON_Object();
            JSON_SetInt(btn3, "k", INTERACTION_WITH_NPC_BUTTON_GRAY);  // key = 2 (gray)
            JSON_SetString(btn3, "n", "More Info");  // name
            JSON_SetInt(btn3, "i", 3);  // id = 3
            JSON_Append(buttonList, btn3);
            
            JSON_SetArray(response, "bt", buttonList);  // buttonList

            OnPacketIncoming(playerid, 63, response);
            JSON_Cleanup(response);
        } 

        default:
        {
            //     
            new JSON:response = JSON_Object();
            JSON_SetInt(response, "s", 1);  //  
            JSON_SetString(response, "tt", "Welcome to NPC"); 
            JSON_SetString(response, "td", "This is a test dialog. Press a button.");
            JSON_SetInt(response, "ts", 30); 
            JSON_SetBool(response, "st", false); 
            JSON_SetInt(response, "r", 100); 

            //    
            new JSON:buttonList = JSON_Array();
            
            new JSON:btnSkip = JSON_Object();
            JSON_SetInt(btnSkip, "k", INTERACTION_WITH_NPC_BUTTON_SKIP);  // key = 0 (skip)
            JSON_SetString(btnSkip, "n", "Skip"); 
            JSON_SetInt(btnSkip, "i", 0); 
            JSON_Append(buttonList, btnSkip);
            
            JSON_SetArray(response, "bt", buttonList);

            OnPacketIncoming(playerid, 63, response);
            JSON_Cleanup(response);
            
            ~json;
        }
    }
}



        default:
        {
            //    (  ),    Case 
            JSON_Cleanup(JSONObject);
            ~json;
            JSON_Cleanup(json_packet_data);
        }
    }
    return 1;
}

CMD:donate(playerid)
{
	new JSON:donate_outcoming_json = JSON_Object(), donate_outcoming_data[512], promotions_array_len;

	JSON_ArrayLength(g_player_donate_data[playerid][JSON_PROMOTIONS_ARRAY], promotions_array_len);

	if(promotions_array_len == 0)
	{
		RestorePlayerPromotions(playerid);
	}

	JSON_SetInt(donate_outcoming_json, "o", 1); // ,   ,     
	JSON_SetInt(donate_outcoming_json, "a", 1); // A_GET_PREMIUM_STATUS -   
	JSON_SetInt(donate_outcoming_json, "cl", 1488); // CL_MARATHON_LEVEL -  
	JSON_SetInt(donate_outcoming_json, "d", 0); // D_GET_TASK_ID - ID 
	JSON_SetInt(donate_outcoming_json, "ec", 0); // EC_GET_VALUE_OF_EXPERIENCE -  
	JSON_SetInt(donate_outcoming_json, "es", 0); // ES_EXPERIENCE - 
	JSON_SetInt(donate_outcoming_json, "e", 0); // E_GET_VALUE_OF_EXPERIENCE -  
	JSON_SetInt(donate_outcoming_json, "id", 122); // ID_ITEM_ID - ID 
	JSON_SetInt(donate_outcoming_json, "is", 0); // IS_IS_REWARD_STANDART -   
	JSON_SetInt(donate_outcoming_json, "k", 0); // K_CURRENT_PAGE -  
	JSON_SetInt(donate_outcoming_json, "la", 0); // LA_CURRENT_LAYOUT -  layout
	JSON_SetInt(donate_outcoming_json, "lc", 0); // LC_CURRENT_LAYOUT -  layout
	JSON_SetInt(donate_outcoming_json, "ln", 222); // LN_GET_LEADER_OF_SEASON -  
	JSON_SetInt(donate_outcoming_json, "lt", 0); // LT_IS_AWARD -   
	JSON_SetInt(donate_outcoming_json, "lv", GetPlayerLevel(playerid)); // LV_GET_LEVEL - 
	JSON_SetInt(donate_outcoming_json, "l", GetPlayerLevel(playerid)); // L_GET_LEVEL - 
	JSON_SetInt(donate_outcoming_json, "mtd", 1488); // MTD_MARATHON_DAYS_TIMER -   
	JSON_SetInt(donate_outcoming_json, "ns", 222); // NS_TOP_PLAYERS -  
	JSON_SetInt(donate_outcoming_json, "op", 0); // OP_PRICE_TITLE -  
	JSON_SetInt(donate_outcoming_json, "pi", 0); // PI_GET_TASK_STATUS -  
	JSON_SetInt(donate_outcoming_json, "ps", 0); // PS_IS_REWARD_PREMIUM -   
	JSON_SetInt(donate_outcoming_json, "p", 1337); // P_BP_LEVELS_TO_BUY -   
	JSON_SetInt(donate_outcoming_json, "pp", 1337); // P_PREMIUM_DELUXE_PRICE -   deluxe
	JSON_SetInt(donate_outcoming_json, "sn", 222); // SN_GET_BP_NAME -  
	JSON_SetInt(donate_outcoming_json, "sp", 0); // SP_SHOW_SPLIT -   
	JSON_SetInt(donate_outcoming_json, "s", 0); // S_OPERATION_STATUS -  
	JSON_SetInt(donate_outcoming_json, "tk", 0); // TASKS_LIST_KEY -  
	JSON_SetInt(donate_outcoming_json, "sb", 0); // TASK_COMMAND -  
	JSON_SetInt(donate_outcoming_json, "tb", 0); // TASK_ID - ID 
	JSON_SetInt(donate_outcoming_json, "tc", 0); // TC_COMPLETED_TASKS -  
	JSON_SetInt(donate_outcoming_json, "td", 1337); // TD_GET_SEASON_TIMER -  
	JSON_SetInt(donate_outcoming_json, "th", 2334); // TH_TIMER_MS -   
	JSON_SetInt(donate_outcoming_json, "tm", 0); // TM_GET_TASK_TIMER -  
	JSON_SetInt(donate_outcoming_json, "ty", 0); // TY_MAIN_TYPE -  
	JSON_SetInt(donate_outcoming_json, "t", 0); // T_KEY - 

	if(strcmp("None", GetPlayerData(playerid, P_EMAIL)))
	{
		JSON_SetString(donate_outcoming_json, "em", GetPlayerData(playerid, P_EMAIL));
	}

	JSON_SetString(donate_outcoming_json, "nm", GetPlayerNameEx(playerid));

	JSON_SetInt(donate_outcoming_json, "ds", 0); //     2,    ,      
	JSON_SetInt(donate_outcoming_json, "sv", 1); //   id   (   ,    )

	JSON_SetInt(donate_outcoming_json, "r", GetPlayerMoney(playerid));
	JSON_SetInt(donate_outcoming_json, "d", GetPlayerDonateRub(playerid));

	JSON_SetArray(donate_outcoming_json, "s", g_player_donate_data[playerid][JSON_PROMOTIONS_ARRAY]);

	JSON_SetInt(donate_outcoming_json, "p", GetPlayerData(playerid, P_SALE_TIME)); //    ,   

    ShowPlayerGUI(playerid, 22, donate_outcoming_json);
}

