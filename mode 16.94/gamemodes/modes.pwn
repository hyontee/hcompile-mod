			{
				null++;
				format(string, sizeof(string), "%s\n{FFFFFF}%i. %s[%d] | : %s [%s]", string, null, GetPlayerNameEx(i),i,RepInfo[i][Reptex], date("%hh:%ii:%ss", RepInfo[i][RepTime]));
			}
		}
		strcat(string, "\n\n{FFCC00}  : /pm [id] []");
		if(null == 0) return SendClientMessage(playerid, 0xAA3333AA,"  ");
		Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "",string, "", "");
	}

	return 1;
}

