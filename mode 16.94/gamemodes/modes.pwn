CMD:helpers(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) == 0)
	{
		if(GetPlayerPremium(playerid) == 0)
		    return  SendClientMessage(playerid, 0xCECECEFF, "   VIP .");
	}

 new fmt_text[100],
 list[sizeof fmt_text * 10 + 50] = "\t\t\t\t\t\t\t\t\t\n";


  foreach(new i : Player)
  {
  if(!IsPlayerConnected(i)) continue;
  else if(!IsPlayerLogged(i)) continue;
  else if(!GetPlayerHelperEx(i)) continue;
  new Helper = GetPlayerHelperEx(i);
  switch(Helper)
  {
        case 1: fmt_text = "(1)";
        default: fmt_text = " (2)";
  }

  format(fmt_text, sizeof fmt_text, "%s[%d]\t\t\t\t\t%s\t\t\t\t{66CC33} \n",  GetPlayerNameEx(i), i, fmt_text);
  strcat(list, fmt_text);
 }

 Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "{00FFFF}"SERVER_NAME"{ffffff} |   ", list, "", "");

 return 1;
}

CMD:dm(playerid, params[])

{


    
	if(GetPlayerAdminEx(playerid) < 1) return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");





	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC": /dm [ID ]");



	extract params -> new to_player;



	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))

	return ShowNotificationNew(playerid, 2, 4, 0, 0, "  ", "");



