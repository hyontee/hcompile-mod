CMD:base(playerid, params[])
{
   if(!IsPlayerInPoliceTeam(playerid)) return SendClientMessage(playerid, 0x999999FF, "    ");
   
	new fmt_text[125], list[sizeof(fmt_text)*10];

	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(!IsPlayerConnected(i)) continue;
		else if(!IsPlayerLogged(i)) continue;
		else if(!GetPlayerSuspect(i)) continue;
        
		format(fmt_text, sizeof fmt_text, "{FFFFFF}#%d. {FFFF00}%s[%d]{FFFFFF} -  : {FFFF00}%d\n", i+1, GetPlayerNameEx(i), i, GetPlayerSuspect(i));
		strcat(list, fmt_text);
		SetPlayerListitemValue(playerid, i, i);
	}

	Dialog(playerid, DIALOG_PBASE, DIALOG_STYLE_LIST, "{00FFFF}"SERVER_NAME"{ffffff} |  ", list, "", "");

	return 1;
}



CMD:med(playerid, params[])
{
	if(g_player[playerid][P_MEDKA] == 0) return SCM(playerid, COLOR_WHITE, "   -!");
	if(sscanf(params, "d", params[0])) return SCM(playerid, COLOR_WHITE, ": /med [id]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, 0x999999FF, "  ");
	new Float:px, Float:py, Float:pz;
	GetPlayerPos(params[0], px, py, pz);
	if(!IsPlayerInRangeOfPoint(params[0], 5.0, px, py, pz)) return SendClientMessage(playerid, 0x999999FF, "   !");
	new string[128];
	format(string, sizeof(string), " :{ffff00} %s\n {ffffff} :{ffff00} \n {ffffff} : {ffff00} \n {ffffff} : {ffff00} ", GetPlayerNameEx(playerid));
	SPD(params[0], 99999, DIALOG_STYLE_MSGBOX, "{00FFFF}"SERVER_NAME"{ffffff} |  ", string, "", "");
	return 1;
}

CMD:cheat(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");


	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC": /cheat [id ]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	return ShowNotificationNew(playerid, 2, 4, 0, 0, "  ", "");

	new ban_time = 9999;

    new reason[999];

	new fmt_msg[999];

	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid))
	return SendClientMessage(playerid, 0xCECECEFF, ""SC"     ");
	if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, ""SC"   ");

	if(AntiSliv(playerid, "/cheat")) return true;

	format(fmt_msg, sizeof fmt_msg, " %s    %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));

	format(fmt_msg, sizeof fmt_msg, "%s. :  ", fmt_msg);

	if(strlen(reason) > 0)
		format(fmt_msg, sizeof fmt_msg, "%s. : %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

    InfoAstats[1] += 1;

	format(fmt_msg, sizeof fmt_msg, " %s[acc:%d] . :  ", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));

	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_msg);

	AddBan(GetPlayerAccountID(to_player), gettime(), ban_time, GetPlayerIpEx(to_player), " ", GetPlayerNameEx(playerid));
	BanEx(to_player, "  ");
	return 1;
}

