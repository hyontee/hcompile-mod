	time = gettime();
	gettime(hour, minute, second);

	switch(minute)
	{
        case 29: SendClientMessageToAll(-1, "{ffff00}|         1 !");
        case 30:
        {
            new vehicles_count;
            for(new i = 1; i < MAX_VEHICLES; i++)
            {
                if(!IsValidVehicle(i)) continue;
                else if(IsVehicleOccupied(i)) continue;
                else if(IsTrailerAttachedToAnyVehicle(i)) continue;

                SetVehicleToRespawn(i);
                vehicles_count++;
            }
            SendClientMessageToAll(-1, "{ffff00}|       ");
        }
        case 35:
        {
            new fmt_text[128];
            new fam_id = GetPlayerData(playerid, P_FAMILY) + 1;
