					else ShowNotificationNew(playerid, 2, 7, 0, 0, "  ", ">>");
	    }
	}
	if(GetPlayerTeamEx(playerid) == 8) // 
	{
	    new fmt_text[75],
        list[sizeof fmt_text * 10 + 50] = " \t \t \t \t \t \t \t \t \t  \t \t \t \t \t \t \t \t \t \t \t {FFFFFF}\n";
	
	
        for(new f; f<MAX_PLAYERS; f++)
        {
	        if(!IsPlayerConnected(f)) continue;
	        if(GetPlayerTeamEx(f) == 8)
		    {
		
		
                foreach(new i : Player)
                {
                    if(!IsPlayerConnected(i)) continue;
					else if(!IsPlayerLogged(i)) continue;
					else if(!GetPlayerTeamEx(i) == 8) continue;

                    format(fmt_text, sizeof fmt_text, "%s[%d] \t \t \t \t \t \t \t \t %d \t \t \t \t \t \t \t \t \t \t \t \t %s\n", GetPlayerNameEx(i), i, GetPlayerJob(i), GetPlayerJobAndRankName(i));
                    strcat(list, fmt_text);
                }
			    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "{00FFFF}"SERVER_NAME"{ffffff} |     ", list, "", "");
		    }
					else ShowNotificationNew(playerid, 2, 7, 0, 0, "  ", ">>");
	    }
	}
	if(GetPlayerTeamEx(playerid) == 9) // 
	{
	    new fmt_text[75],
        list[sizeof fmt_text * 10 + 50] = " \t \t \t \t \t \t \t \t \t  \t \t \t \t \t \t \t \t \t \t \t {FFFFFF}\n";
	
	
        for(new f; f<MAX_PLAYERS; f++)
        {
	        if(!IsPlayerConnected(f)) continue;
	        if(GetPlayerTeamEx(f) == 9)
		    {
		
		
                foreach(new i : Player)
                {
                    if(!IsPlayerConnected(i)) continue;
					else if(!IsPlayerLogged(i)) continue;
					else if(!GetPlayerTeamEx(i) == 9) continue;

                    format(fmt_text, sizeof fmt_text, "%s[%d] \t \t \t \t \t \t \t \t %d \t \t \t \t \t \t \t \t \t \t \t \t %s\n", GetPlayerNameEx(i), i, GetPlayerJob(i), GetPlayerJobAndRankName(i));
                    strcat(list, fmt_text);
                }
			    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "{00FFFF}"SERVER_NAME"{ffffff} |     ", list, "", "");
		    }
					else ShowNotificationNew(playerid, 2, 7, 0, 0, "  ", ">>");
	    }
	}
	if(GetPlayerTeamEx(playerid) == 10) // 
	{
	    new fmt_text[75],
        list[sizeof fmt_text * 10 + 50] = " \t \t \t \t \t \t \t \t \t  \t \t \t \t \t \t \t \t \t \t \t {FFFFFF}\n";
	
	
        for(new f; f<MAX_PLAYERS; f++)
        {
	        if(!IsPlayerConnected(f)) continue;
	        if(GetPlayerTeamEx(f) == 10)
		    {
		
		
                foreach(new i : Player)
                {
                    if(!IsPlayerConnected(i)) continue;
					else if(!IsPlayerLogged(i)) continue;
					else if(!GetPlayerTeamEx(i) == 10) continue;

                    format(fmt_text, sizeof fmt_text, "%s[%d] \t \t \t \t \t \t \t \t %d \t \t \t \t \t \t \t \t \t \t \t \t %s\n", GetPlayerNameEx(i), i, GetPlayerJob(i), GetPlayerJobAndRankName(i));
                    strcat(list, fmt_text);
                }
			    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "{00FFFF}"SERVER_NAME"{ffffff} |    ", list, "", "");
		    }
					else ShowNotificationNew(playerid, 2, 7, 0, 0, "  ", ">>");
	    }
	}
	
	
	
	
    


return 1;
}


CMD:leaders(playerid, params[])
{
 new fmt_text[75],
  list[sizeof fmt_text * 10 + 50] = " -  -  - {FFFFFF}\n";

 foreach(new i : Player)
 {
  if(!IsPlayerConnected(i)) continue;
  else if(!IsPlayerLogged(i)) continue;
  else if(!GetPlayerTeamEx(i)) continue;
  else if(GetPlayerJob(i) != 10) continue;

  format(fmt_text, sizeof fmt_text, "\n%s - %s - %s[%d] - %d", GetTeamName(GetPlayerTeamEx(i)), GetPlayerJobAndRankName(i), GetPlayerNameEx(i), i, GetPlayerPhone(i));
  strcat(list, fmt_text);
 }

 Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "{FFCD00} ", list, "", "");

 return 1;
}

CMD:admlist(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	new query[115],
		Cache: result,
		rows,
		admin,
		day_prev,
		day_last,
		name[21],
		last_login,
		last_date[6],
		list[sizeof query * 25 + 60] = "\t\t\t\t  \t  \t\t \n{FFFFFF}";

	mysql_format(mysql, query, sizeof query, "SELECT * FROM accounts WHERE admin > 0 ORDER BY last_login ASC");
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows(result);

	for(new i; i < rows; i ++)
	{
		new day_time[4];

		admin = cache_get_field_content_int(i, "admin");
		day_prev = cache_get_field_content_int(i, "game_for_day_prev");
		day_last = cache_get_field_content_int(i, "game_for_day");

		day_time[0] = ConvertUnixTime(day_prev, CONVERT_TIME_TO_HOURS);
		day_time[1] = ConvertUnixTime(day_prev, CONVERT_TIME_TO_MINUTES);

		day_time[2] = ConvertUnixTime(day_last, CONVERT_TIME_TO_HOURS);
		day_time[3] = ConvertUnixTime(day_last, CONVERT_TIME_TO_MINUTES);

		last_login = cache_get_field_content_int(i, "last_login");
		timestamp_to_date(last_login, last_date[2], last_date[1], last_date[0], last_date[3], last_date[4], last_date[5]);


		cache_get_field_content(i, "name", name);

		new fix_tabulation[21] = "                    ";

		format
		(
			query, sizeof query,
			"\n{FFFFFF}%s%s\t%d .\t%s%d  %d \t%s%d  %d \t\t%s\t%02d.%02d.%d  %02d:%02d:%02d\n",
			name,
			fix_tabulation[strlen(name)],
			admin,
			day_time[0] >= 3 ? day_time[0] > 3 ? "{66CC33}" : "{FFCD00}" : "{FF5533}",
			day_time[0],
			day_time[1],
			day_time[2] >= 3 ? day_time[0] > 3 ? "{66CC33}" : "{FFCD00}" : "{FF5533}",
			day_time[2],
			day_time[3],
			IsPlayerConnected(GetPlayerID(name)) ? "{66CC33}Online" : "{FF5533}Offline",
			last_date[0], last_date[1], last_date[2],
			last_date[3], last_date[4], last_date[5]
		);

		strcat(list, query);
	}

	cache_delete(result);

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCD00} ", list, "", "");

	return 1;
}

CMD:admlist1(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	new query[115],
		Cache: result,
		rows,
		admin,
		day_prev,
		day_last,
		name[21],
		list[sizeof query * 25 + 60] = "\t\t\t\t  \t  \t\n{FFFFFF}";

	mysql_format(mysql, query, sizeof query, "SELECT * FROM accounts WHERE admin > 0 ORDER BY admin DESC");
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows(result);

	for(new i; i < rows; i ++)
	{
		new day_time[4];

		admin = cache_get_field_content_int(i, "admin");
		day_prev = cache_get_field_content_int(i, "game_for_day_prev");
		day_last = cache_get_field_content_int(i, "game_for_day");

		day_time[0] = ConvertUnixTime(day_prev, CONVERT_TIME_TO_HOURS);
		day_time[1] = ConvertUnixTime(day_prev, CONVERT_TIME_TO_MINUTES);

		day_time[2] = ConvertUnixTime(day_last, CONVERT_TIME_TO_HOURS);
		day_time[3] = ConvertUnixTime(day_last, CONVERT_TIME_TO_MINUTES);

		cache_get_field_content(i, "name", name);

		new fix_tabulation[21] = "                    ";

		format
		(
			query, sizeof query,
			"\n{FFFFFF}%s%s\t%d .\t%s%d  %d \t%s%d  %d \t\t%s",
			name,
			fix_tabulation[strlen(name)],
			admin,
			(day_time[0] >= 3) ? ((day_time[0] > 3) ? ("{66CC33}") : ("")) : ("{FF5533}"),
			day_time[0],
			day_time[1],
			(day_time[2] >= 3) ? ((day_time[2] > 3) ? ("{66CC33}") : ("")) : ("{FF5533}"),
			day_time[2],
			day_time[3],
			IsPlayerConnected(GetPlayerID(name)) ? "{66CC33}Online" : "{FF5533}Offline"
		);

		strcat(list, query);
	}

	cache_delete(result);

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, " ", list, "", "");

	return 1;
}

stock AdminStats_Init()
{
	mysql_tquery(mysql,
		"ALTER TABLE accounts ADD COLUMN IF NOT EXISTS admin_reports INT NOT NULL DEFAULT 0");
	mysql_tquery(mysql,
		"CREATE TABLE IF NOT EXISTS admin_stats_online (" \
		"account_id INT NOT NULL," \
		"stat_date DATE NOT NULL," \
		"seconds INT NOT NULL DEFAULT 0," \
		"PRIMARY KEY(account_id,stat_date)," \
		"INDEX idx_stat_date(stat_date)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
	return 1;
}

stock AdminStats_AddReportAnswer(playerid)
{
	if(!IsPlayerConnected(playerid) || GetPlayerAdminEx(playerid) < 1 || GetPlayerAccountID(playerid) <= 0)
		return 0;

	new query[160];
	mysql_format(mysql, query, sizeof query,
		"UPDATE accounts SET admin_reports=admin_reports+1 WHERE id=%d LIMIT 1",
		GetPlayerAccountID(playerid));
	mysql_tquery(mysql, query);
	return 1;
}

stock AdminStats_GetLastAction(account_id, const pattern[], output[], size)
{
	format(output, size, "");
	new query[256];
	mysql_format(mysql, query, sizeof query,
		"SELECT description FROM action_log WHERE acc_id=%d AND description LIKE '%e' ORDER BY time DESC LIMIT 1",
		account_id, pattern);
	new Cache:result = mysql_query(mysql, query, true);
	if(cache_num_rows(result))
		cache_get_field_content(0, "description", output, mysql, size);
	cache_delete(result);
	return 1;
}

stock AdminStats_FormatTime(seconds, output[], size)
{
	if(seconds < 0) seconds = 0;
	format(output, size, "%d:%02d:%02d", seconds / 3600, (seconds / 60) % 60, seconds % 60);
	return 1;
}

CMD:astats(playerid, params[])
{
	#pragma unused params
	if(GetPlayerAdminEx(playerid) < 1)
		return SendClientMessage(playerid, 0x999999FF, "      .");

	new account_id = GetPlayerAccountID(playerid);
	new query[1024];
	mysql_format(mysql, query, sizeof query,
		"SELECT " \
		"SUM(description LIKE ' %%' OR description LIKE '   %%') AS kicks," \
		"SUM(description LIKE 'BAN: %%' OR description LIKE '  %%') AS bans," \
		"SUM(description LIKE '  %%') AS warns," \
		"SUM(description LIKE ' %%   %%') AS mutes," \
		"SUM(description LIKE '   %%') AS jails " \
		"FROM action_log WHERE acc_id=%d",
		account_id);
	new Cache:result = mysql_query(mysql, query, true);
	if(mysql_errno() || !cache_num_rows(result))
	{
		cache_delete(result);
		return SendClientMessage(playerid, 0xFF5533FF, "    .");
	}

	new kicks = cache_get_field_content_int(0, "kicks");
	new bans = cache_get_field_content_int(0, "bans");
	new warns = cache_get_field_content_int(0, "warns");
	new mutes = cache_get_field_content_int(0, "mutes");
	new jails = cache_get_field_content_int(0, "jails");
	cache_delete(result);

	mysql_format(mysql, query, sizeof query,
		"SELECT admin_reports FROM accounts WHERE id=%d LIMIT 1", account_id);
	result = mysql_query(mysql, query, true);
	new reports = cache_num_rows(result) ? cache_get_field_content_int(0, "admin_reports") : 0;
	cache_delete(result);

	new last_kick[48], last_ban[48], last_warn[48], last_mute[48], last_jail[48];
	AdminStats_GetLastAction(account_id, " %", last_kick, sizeof last_kick);
	if(!strcmp(last_kick, "")) AdminStats_GetLastAction(account_id, "   %", last_kick, sizeof last_kick);
	AdminStats_GetLastAction(account_id, "BAN: %", last_ban, sizeof last_ban);
	if(!strcmp(last_ban, "")) AdminStats_GetLastAction(account_id, "  %", last_ban, sizeof last_ban);
	AdminStats_GetLastAction(account_id, "  %", last_warn, sizeof last_warn);
	AdminStats_GetLastAction(account_id, " %   %", last_mute, sizeof last_mute);
	AdminStats_GetLastAction(account_id, "   %", last_jail, sizeof last_jail);

	new week_seconds[7];
	mysql_format(mysql, query, sizeof query,
		"SELECT WEEKDAY(stat_date) AS week_day,seconds FROM admin_stats_online " \
		"WHERE account_id=%d AND YEARWEEK(stat_date,1)=YEARWEEK(CURDATE(),1)",
		account_id);
	result = mysql_query(mysql, query, true);
	for(new i; i < cache_num_rows(result); i++)
	{
		new day = cache_get_field_content_int(i, "week_day");
		if(0 <= day <= 6) week_seconds[day] = cache_get_field_content_int(i, "seconds");
	}
	cache_delete(result);

	mysql_format(mysql, query, sizeof query,
		"SELECT IFNULL(SUM(seconds),0) AS total FROM admin_stats_online WHERE account_id=%d",
		account_id);
	result = mysql_query(mysql, query, true);
	new total_online = cache_num_rows(result) ? cache_get_field_content_int(0, "total") : 0;
	cache_delete(result);

	static const day_name[7][16] =
	{
		"", "", "", "",
		"", "", ""
	};
	new body[4096], row[256], time_text[24], total_time_text[24];
	format(body, sizeof body,
		"\
		{E8E8E8}   {D7D729}%s {E8E8E8}(%d ):\n\n\
		{FFFFFF}- : {FFFF00} {FFFFFF}| : {FFFF00}\n\
		{FFFFFF}- : {FFFF00}%d {FFFFFF}| . : {AAAAAA}%s\n\
		{FFFFFF}- : {FFFF00}%d {FFFFFF}| . : {AAAAAA}%s\n\
		{FFFFFF}-  : {FFFF00}%d {FFFFFF}| . : {AAAAAA}%s\n\
		{FFFFFF}- : {FFFF00}%d\n\
		{FFFFFF}- : {FFFF00}%d {FFFFFF}| . : {AAAAAA}%s\n\
		{FFFFFF}-   : {FFFF00}%d {FFFFFF}| . : {AAAAAA}%s\n\n\
		{FFFFFF}- : {FF5533}%d\n\n\
		{FFFFFF}  :\n\n",
		GetPlayerNameEx(playerid), GetPlayerAdminEx(playerid),
		kicks, last_kick, bans, last_ban, warns, last_warn,
		reports, mutes, last_mute, jails, last_jail,
		GetPlayerAdminWarn(playerid));

	for(new day; day < 7; day++)
	{
		AdminStats_FormatTime(week_seconds[day], time_text, sizeof time_text);
		format(row, sizeof row,
			"{FFFFFF}- %s: {FFFF00}%s {FFFFFF}|  : %s%s\n",
			day_name[day], time_text,
			week_seconds[day] >= 10800 ? "{33CC33}" : "{FF5533}",
			week_seconds[day] >= 10800 ? "" : " ");
		strcat(body, row, sizeof body);
	}
	AdminStats_FormatTime(total_online, total_time_text, sizeof total_time_text);
	format(row, sizeof row, "{FFFFFF}-    : {FFFF00}%s", total_time_text);
	strcat(body, row, sizeof body);

	new title[128];
	format(title, sizeof title, "{D7D729}  %s", GetPlayerNameEx(playerid));
	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, title, body, "", "");
	return 1;
}

CMD:techinfo(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 8)
		return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");

	if(!strlen(params))
		return SendClientMessage(playerid, 0xCECECEFF, ": /techinfo [ ]");

	extract params -> new string:name[24];
	if(!(3 <= strlen(name) <= 24))
		return SendClientMessage(playerid, 0x999999FF, "  ");

	new query[512];
	new Cache:result;
	new rows;
	mysql_format(mysql, query, sizeof query,
		"SELECT id,name,level,money,bank,wage,admin,phone,reg_ip,last_ip,reg_time,last_login,game_for_hour,donate_current,donate_total FROM accounts WHERE name='%e' LIMIT 1",
		name);
	result = mysql_query(mysql, query, true);
	rows = cache_num_rows(result);
	if(!rows)
	{
		cache_delete(result);
		return SendClientMessage(playerid, 0x999999FF, "     ");
	}

	new account_id = cache_get_field_content_int(0, "id");
	new account_name[25];
	new reg_ip[17];
	new last_ip[17];
	new reg_date[6];
	new last_date[6];
	new reg_time = cache_get_field_content_int(0, "reg_time");
	new last_login = cache_get_field_content_int(0, "last_login");
	new dialog_text[4096];
	new tech_line[256];

	cache_get_field_content(0, "name", account_name, mysql, sizeof account_name);
	cache_get_field_content(0, "reg_ip", reg_ip, mysql, sizeof reg_ip);
	cache_get_field_content(0, "last_ip", last_ip, mysql, sizeof last_ip);
	timestamp_to_date(reg_time, reg_date[2], reg_date[1], reg_date[0], reg_date[3], reg_date[4], reg_date[5]);
	timestamp_to_date(last_login, last_date[2], last_date[1], last_date[0], last_date[3], last_date[4], last_date[5]);

	format(dialog_text, sizeof dialog_text,
		"\
		{FFD700} \n\
		{FFFFFF}:\t%s\n\
		ID :\t%d\n\
		:\t%s\n\
		:\t%d\n\
		 :\t%d\n\
		:\t%d\n\
		 :\t%02d.%02d.%d %02d:%02d:%02d\n\
		 :\t%02d.%02d.%d %02d:%02d:%02d\n\
		   :\t%d .\n\n\
		{FFD700} \n\
		{FFFFFF}IP :\t%s\n\
		 IP:\t%s\n\n\
		{FFD700}\n\
		{FFFFFF}:\t%d .\n\
		 :\t%d .\n\
		 :\t%d .\n\
		:\t%d (: %d)\n",
		account_name,
		account_id,
		IsPlayerConnected(GetPlayerID(account_name)) ? ("{66CC33}Online{FFFFFF}") : ("{FF5533}Offline{FFFFFF}"),
		cache_get_field_content_int(0, "level"),
		cache_get_field_content_int(0, "admin"),
		cache_get_field_content_int(0, "phone"),
		reg_date[0], reg_date[1], reg_date[2], reg_date[3], reg_date[4], reg_date[5],
		last_date[0], last_date[1], last_date[2], last_date[3], last_date[4], last_date[5],
		ConvertUnixTime(cache_get_field_content_int(0, "game_for_hour"), CONVERT_TIME_TO_HOURS),
		reg_ip, last_ip,
		cache_get_field_content_int(0, "money"),
		cache_get_field_content_int(0, "bank"),
		cache_get_field_content_int(0, "wage"),
		cache_get_field_content_int(0, "donate_current"),
		cache_get_field_content_int(0, "donate_total"));
	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT IFNULL(SUM(balance),0) AS total FROM bank_accounts WHERE uid=%d", account_id);
	result = mysql_query(mysql, query, true);
	format(tech_line, sizeof tech_line, " :\t%d .\n\n", cache_get_field_content_int(0, "total"));
	strcat(dialog_text, tech_line, sizeof dialog_text);
	cache_delete(result);

	strcat(dialog_text, "{FFD700}\n", sizeof dialog_text);
	mysql_format(mysql, query, sizeof query,
		"SELECT id,model_id,number,mileage,health FROM ownable_cars WHERE owner_id=%d ORDER BY id LIMIT 20", account_id);
	result = mysql_query(mysql, query, true);
	rows = cache_num_rows(result);
	if(!rows) strcat(dialog_text, "{AAAAAA}  \n", sizeof dialog_text);
	for(new i; i < rows; i++)
	{
		new vehicle_number[8];
		cache_get_field_content(i, "number", vehicle_number, mysql, sizeof vehicle_number);
		format(tech_line, sizeof tech_line, "{FFFFFF}ID %d:  %d,  %s,  %.1f, HP %.0f\n",
			cache_get_field_content_int(i, "id"),
			cache_get_field_content_int(i, "model_id"),
			vehicle_number,
			cache_get_field_content_float(i, "mileage"),
			cache_get_field_content_float(i, "health"));
		strcat(dialog_text, tech_line, sizeof dialog_text);
	}
	cache_delete(result);

	strcat(dialog_text, "\n{FFD700}  \n", sizeof dialog_text);
	mysql_format(mysql, query, sizeof query, "SELECT id,price FROM houses WHERE owner_id=%d ORDER BY id LIMIT 10", account_id);
	result = mysql_query(mysql, query, true);
	rows = cache_num_rows(result);
	for(new i; i < rows; i++)
	{
		format(tech_line, sizeof tech_line, "{FFFFFF}: ID %d,  %d .\n",
			cache_get_field_content_int(i, "id"), cache_get_field_content_int(i, "price"));
		strcat(dialog_text, tech_line, sizeof dialog_text);
	}
	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT id,price,type FROM housesnew WHERE accounts_id=%d ORDER BY id LIMIT 10", account_id);
	result = mysql_query(mysql, query, true);
	rows += cache_num_rows(result);
	for(new i; i < cache_num_rows(result); i++)
	{
		format(tech_line, sizeof tech_line, "{FFFFFF} : ID %d,  %d,  %d .\n",
			cache_get_field_content_int(i, "id"),
			cache_get_field_content_int(i, "type"),
			cache_get_field_content_int(i, "price"));
		strcat(dialog_text, tech_line, sizeof dialog_text);
	}
	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT id,name,type,balance,products FROM business WHERE owner_id=%d ORDER BY id LIMIT 10", account_id);
	result = mysql_query(mysql, query, true);
	new property_rows = cache_num_rows(result);
	for(new i; i < property_rows; i++)
	{
		new business_name[32];
		cache_get_field_content(i, "name", business_name, mysql, sizeof business_name);
		format(tech_line, sizeof tech_line, "{FFFFFF}: ID %d, %s,  %d,  %d,  %d\n",
			cache_get_field_content_int(i, "id"), business_name,
			cache_get_field_content_int(i, "type"),
			cache_get_field_content_int(i, "balance"),
			cache_get_field_content_int(i, "products"));
		strcat(dialog_text, tech_line, sizeof dialog_text);
	}
	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT id,name,balance FROM fuel_stations WHERE owner_id=%d ORDER BY id LIMIT 10", account_id);
	result = mysql_query(mysql, query, true);
	property_rows += cache_num_rows(result);
	for(new i; i < cache_num_rows(result); i++)
	{
		new station_name[32];
		cache_get_field_content(i, "name", station_name, mysql, sizeof station_name);
		format(tech_line, sizeof tech_line, "{FFFFFF}: ID %d, %s,  %d .\n",
			cache_get_field_content_int(i, "id"), station_name,
			cache_get_field_content_int(i, "balance"));
		strcat(dialog_text, tech_line, sizeof dialog_text);
	}
	cache_delete(result);
	if(!rows && !property_rows)
		strcat(dialog_text, "{AAAAAA}   \n", sizeof dialog_text);

	strcat(dialog_text, "\n{FFD700}  IP\n", sizeof dialog_text);
	mysql_format(mysql, query, sizeof query,
		"SELECT id,name,level,admin,last_ip FROM accounts WHERE id<>%d AND (last_ip='%e' OR reg_ip='%e' OR last_ip='%e' OR reg_ip='%e') ORDER BY last_login DESC LIMIT 30",
		account_id, last_ip, last_ip, reg_ip, reg_ip);
	result = mysql_query(mysql, query, true);
	rows = cache_num_rows(result);
	if(!rows) strcat(dialog_text, "{AAAAAA}    IP  \n", sizeof dialog_text);
	for(new i; i < rows; i++)
	{
		new twin_name[25], twin_ip[17];
		cache_get_field_content(i, "name", twin_name, mysql, sizeof twin_name);
		cache_get_field_content(i, "last_ip", twin_ip, mysql, sizeof twin_ip);
		format(tech_line, sizeof tech_line, "{FFFFFF}%s [acc:%d]  LVL %d, ADM %d, IP %s\n",
			twin_name,
			cache_get_field_content_int(i, "id"),
			cache_get_field_content_int(i, "level"),
			cache_get_field_content_int(i, "admin"),
			twin_ip);
		strcat(dialog_text, tech_line, sizeof dialog_text);
	}
	cache_delete(result);

	format(tech_line, sizeof tech_line, "{FFD700} : %s", account_name);
	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, tech_line, dialog_text, "", "");

	format(tech_line, sizeof tech_line, "TECHINFO:   %s[acc:%d], IP %s", account_name, account_id, last_ip);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, tech_line);
	return 1;
}

CMD:get(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 8) return 1;

	if(!strlen(params))
		return SendClientMessage(playerid, 0xCECECEFF, ": /get [ ]");

	if(!(3 <= strlen(params) <= 20))
		return SendClientMessage(playerid, 0x999999FF, "     ");

	extract params -> new string: name[21];

	new query[100];
	new Cache: result, user_id;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM accounts WHERE name='%e' LIMIT 1", name);
	result = mysql_query(mysql, query);

	if(cache_num_rows(result))
		user_id = cache_get_field_content_int(0, "id");

	if(!cache_num_rows(result) || !user_id)
		return SendClientMessage(playerid, 0x999999FF, "     "), cache_delete(result);

	new reg_ip[16],
		last_ip[16],
		reg_date[6],
		reg_time = cache_get_field_content_int(0, "reg_time"),
		game_for_day = cache_get_field_content_int(0, "game_for_day"),
		game_for_day_prev = cache_get_field_content_int(0, "game_for_day_prev"),
		car_slots = cache_get_field_content_int(0, "car_slots");

	cache_get_field_content(0, "reg_ip", reg_ip);
	cache_get_field_content(0, "last_ip", last_ip);

	timestamp_to_date(reg_time, reg_date[2], reg_date[1], reg_date[0], reg_date[3], reg_date[4], reg_date[5]);

	new fmt_text[256];

	format
	(
		fmt_text, sizeof fmt_text,
		"\
		 :\t\t%d\n\
		:\t\t\t%d\n\
		.  :\t\t%d\n\
		:\t\t\t%d\n\
		IP  (.):\t\t%s\n\
		IP  (.):\t\t%s\n\
		   :\t\%02d.%02d.%d  %02d:%02d:%02d\n\
		:\t\t\t\t%d (: %d)\n\
		  :\t\t%d  %d \n\
		  :\t\t\t%d  %d \n\n\
		  :\t%d\n\
		",
		user_id,
		cache_get_field_content_int(0, "money"),
		cache_get_field_content_int(0, "bank"),
		cache_get_field_content_int(0, "level"),
		reg_ip,
		last_ip,
		reg_date[0], reg_date[1], reg_date[2],
		reg_date[3], reg_date[4], reg_date[5],
		cache_get_field_content_int(0, "donate_current"),
		cache_get_field_content_int(0, "donate_total"),
		ConvertUnixTime(game_for_day, CONVERT_TIME_TO_HOURS),
		ConvertUnixTime(game_for_day, CONVERT_TIME_TO_MINUTES),
		ConvertUnixTime(game_for_day_prev, CONVERT_TIME_TO_HOURS),
		ConvertUnixTime(game_for_day_prev, CONVERT_TIME_TO_MINUTES),
		car_slots
	);

	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT * FROM ownable_cars WHERE owner_id=%d", user_id);
	result = mysql_query(mysql, query, true);

	if(cache_num_rows(result))
	{
		for(new idx; idx < cache_num_rows(result); idx ++)
		{
			new id = cache_get_field_content_int(idx, "id"),
				modelid = cache_get_field_content_int(idx, "model_id"),
				Float: x = cache_get_field_content_float(idx, "pos_x"),
				Float: y = cache_get_field_content_float(idx, "pos_y"),
				Float: z = cache_get_field_content_float(idx, "pos_z"),
				Float: health = cache_get_field_content_float(idx, "health"),
				number[7];

			cache_get_field_content(idx, "number", number);

			format(query, sizeof query, "\n%s [%d] - %s (%.1f, %.1f, %.1f) HP: %.1f", GetVehicleInfo(modelid - 400, VI_NAME), id, number, x, y, z, health);
			strcat(fmt_text, query);
		}
	}

	cache_delete(result);

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, name, fmt_text, "", "");

	format(fmt_text, sizeof fmt_text, "    %s[acc:%d]", name, user_id);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);

	return 1;
}

CMD:money(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	if(!strlen(params))
		return SendClientMessage(playerid, 0xCECECEFF, ": /money [ ]");

	if(!(3 <= strlen(params) <= 20))
		return SendClientMessage(playerid, 0x999999FF, "     ");

	extract params -> new string: name[21];

	new query[90];
	new Cache: result, user_id;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM accounts WHERE name='%e' LIMIT 1", name);
	result = mysql_query(mysql, query);

	if(cache_num_rows(result))
		user_id = cache_get_field_content_int(0, "id");

	if(!cache_num_rows(result) || !user_id)
		return SendClientMessage(playerid, 0x999999FF, "     "), cache_delete(result);

	new player_cash = cache_get_field_content_int(0, "money"),
		player_bank = cache_get_field_content_int(0, "bank"),
		player_wage = cache_get_field_content_int(0, "wage"),
		player_business = cache_get_field_content_int(0, "business"),
		player_fuel_st = cache_get_field_content_int(0, "fuel_st"),
		bank_accounts_money,
		fmt_text[310];

	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT * FROM bank_accounts WHERE uid='%d'", user_id);
	result = mysql_query(mysql, query);

	if(cache_num_rows(result))
	{
		for(new i = 0; i < cache_num_rows(result); i++)
			bank_accounts_money += cache_get_field_content_int(i, "balance");
	}

	cache_delete(result);

	format
	(
		fmt_text, sizeof fmt_text,
		"\
		 :\t\t\t%d \n\
		. :\t\t\t%d \n\
		 / :\t\t\t%d \n\n\
		  . . :\t\t%d \n\n\
		",
		player_cash, player_bank, player_wage, bank_accounts_money
	);

	if(player_business != -1)
	{
		mysql_format(mysql, query, sizeof query, "SELECT balance FROM business WHERE owner_id='%d' LIMIT 1", user_id);
		result = mysql_query(mysql, query);

		format(query, sizeof query, "  :\t\t\t%d \n", cache_get_row_int(0, 0));
		strcat(fmt_text, query);

		cache_delete(result);
	}
					else strcat(fmt_text, " \n");
	cache_delete(result);
	if(player_fuel_st != -1)
	{
		mysql_format(mysql, query, sizeof query, "SELECT balance FROM fuel_stations WHERE owner_id='%d' LIMIT 1", user_id);
		result = mysql_query(mysql, query);

		format(query, sizeof query, "  :\t\t\t\t%d ", cache_get_row_int(0, 0));
		strcat(fmt_text, query);

		cache_delete(result);
	}
					else strcat(fmt_text, " ");

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, name, fmt_text, "", "");

	format(fmt_text, sizeof fmt_text, "    %s[acc:%d]", params, user_id);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);

	return 1;
}

CMD:getlog(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 12) return 1;

	if(!strlen(params))
	{
		SendClientMessage(playerid, 0xCECECEFF, ": /getlog [ ] [ ] [- ]");
		SendClientMessage(playerid, 0xCECECEFF, ":");
		SendClientMessage(playerid, 0xCECECEFF, "1 -  ");
		SendClientMessage(playerid, 0xCECECEFF, "2 -   ");
		SendClientMessage(playerid, 0xCECECEFF, "3 -  ");
		SendClientMessage(playerid, 0xCECECEFF, "4 -   ");
		SendClientMessage(playerid, 0xCECECEFF, "5 -   ");
		SendClientMessage(playerid, 0xCECECEFF, "6 -  ");
		SendClientMessage(playerid, 0xCECECEFF, "7 -    ");
		SendClientMessage(playerid, 0xCECECEFF, "8 - /  ");
		SendClientMessage(playerid, 0xCECECEFF, "9 -    /");
		SendClientMessage(playerid, 0xCECECEFF, "10 -   ");

		return 1;
	}

	extract params -> new string:name[21], log_id, time_limit;

	if(!(LOG_TYPE_ADMIN_CHAT <= log_id <= LOG_TYPE_SUPERADMIN_ACTION))
		return SendClientMessage(playerid, 0x999999FF, " ");

	if(!(0 <= time_limit <= 30))
		return SendClientMessage(playerid, 0x999999FF, "   1  30.  0    ");

	if(!(3 <= strlen(name) <= 20))
		return SendClientMessage(playerid, 0x999999FF, "     ");

	new query[144];
	new Cache: result,
		rows,
		user_id,
		admin;

	mysql_format(mysql, query, sizeof query, "SELECT id, admin FROM accounts WHERE name='%e' LIMIT 1", name);
	result = mysql_query(mysql, query);

	rows = cache_num_rows(result);

	if(rows)
	{
		user_id = cache_get_row_int(0, 0);
		admin = cache_get_row_int(0, 1);
	}

	cache_delete(result);

	if(rows && user_id)
	{
		if(GetPlayerAdminEx(playerid) >= admin)
		{
			mysql_format(mysql, query, sizeof query, "SELECT * FROM action_log WHERE acc_id=%d AND type=%d", user_id, log_id);

			new fmt_text[35];

			if(time_limit)
			{
				format(fmt_text, sizeof fmt_text, " AND time >= %d", gettime() - (time_limit * 86400));
				strcat(query, fmt_text);
			}

			result = mysql_query(mysql, query, true);

			rows = cache_num_rows(result);

			if(rows)
			{
				new log_name[10][37] =
				{
					" ",
					"  ",
					" ",
					"  ",
					"  ",
					" ",
					"   ",
					"/  ",
					"   /",
					"  "
				};

				format(query, sizeof query, "    \"%s\"   %s", log_name[log_id - 1], name);

				if(time_limit)
				{
					format(fmt_text, sizeof fmt_text, "   %d .", time_limit);
					strcat(query, fmt_text);
				}

				SendClientMessage(playerid, 0x66CC33FF, query);

				for(new idx; idx < rows; idx ++)
				{
					new desc[144],
						time[6],
						uip[17];

					cache_get_field_content(idx, "description", desc);
					cache_get_field_content(idx, "uip", uip);

					timestamp_to_date(cache_get_field_content_int(idx, "time"), time[2], time[1], time[0], time[3], time[4], time[5]);

					format
					(
						query, sizeof query,
						"#%d | %02d.%02d.%d  %02d:%02d:%02d | %s | %s",
						cache_get_field_content_int(idx, "id"),
						time[0], time[1], time[2], time[3], time[4], time[5],
						uip, desc
					);

					SendClientMessage(playerid, 0xFFCD00FF, query);
				}

				format(query, sizeof query, "  : %d", rows);
				SendClientMessage(playerid, 0x66CC33FF, query);
			}
					else SendClientMessage(playerid, 0x999999FF, "        ");

			cache_delete(result);
		}
					else SendClientMessage(playerid, 0x999999FF, "        ");
	}
					else SendClientMessage(playerid, 0x999999FF, "     ");

	return 1;
}

CMD:lip(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 8) return 1;

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ": /lip [IP ]");

	new query[130],
		fmt_text[2300],
		Cache: result,
		rows;

	mysql_format(mysql, query, sizeof query, "SELECT name, reg_ip FROM accounts WHERE reg_ip = '%s' OR last_ip = '%s'", params, params);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows(result);

	if(rows)
	{
		new l_acc_count;

		format(fmt_text, sizeof fmt_text, "IP: %s\n", params);

		for(new idx; idx < rows; idx ++)
		{
			new name[21],
				ip[17];

			cache_get_row(idx, 0, name);
			cache_get_row(idx, 1, ip);

			new bool: is_reg = false;

			if(!strcmp(ip, params, true))
				is_reg = true;

			else
				l_acc_count ++;

			format
			(
				query, sizeof query,
				"\n{FFFFFF}%d. %s - %s %s",
				idx + 1,
				name,
				is_reg ? "Reg" : "Last",
				IsPlayerConnected(GetPlayerID(name)) ? "{66CC33}[online]" : "{888888}[offline]"
			);

			strcat(fmt_text, query);
		}

		format(query, sizeof query, "{FF9900} : %d / %d", l_acc_count, rows);

		Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, query, fmt_text, "", "");
	}
					else SendClientMessage(playerid, 0x999999FF, " IP      ");

	cache_delete(result);

	return 1;
}

CMD:kick(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 1) return 1;
	

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ": /kick [id ] [ ()]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player)) return SendClientMessage(playerid, 0xCECECEFF, "  ");
	else if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "     ");

	new reason[31];
	sscanf(params, "{d}s[30]", reason);

	if(AntiSliv(playerid, "/kick")) return true;

	new fmt_msg[200];
	format(fmt_msg, sizeof fmt_msg, " %s   %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));

	if(strlen(reason) > 0)
		format(fmt_msg, sizeof fmt_msg, "%s. : %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);
	
	SendClientMessage(to_player, 0xCECECEFF, fmt_msg);
	Kick:(playerid);
		
	format(fmt_msg, sizeof fmt_msg, " %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	Kick:(playerid, "  .", 3000);

	return 1;
}


CMD:skick(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 1) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, ": /skick [id ]");

	if(!IsPlayerConnected(to_player)) return SendClientMessage(playerid, 0xCECECEFF, "  ");
	else if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "     ");

	new fmt_msg[128];

	if(GetPlayerAdminEx(playerid) < 6)
	{
		format(fmt_msg, sizeof fmt_msg, "[A]  %s[%d]  %s[%d]   ", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
		SendMessageToAdmins(fmt_msg, 0x999999FF);
	}

	format(fmt_msg, sizeof fmt_msg, "   %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	Kick(to_player);
	return 1;
}

CMD:mute(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 1) return 1;
	

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ": /mute [id ] [  ] [ ()]");

	extract params -> new to_player, mute_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "  ");

	if(!(1 <= mute_time <= 360)) return SendClientMessage(playerid, 0xCECECEFF, "     1    360 ");
	if(GetPlayerData(to_player, P_MUTE) > 0) return SendClientMessage(playerid, 0xCECECEFF, "     ");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "      ");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "    ");

	if(AntiSliv(playerid, "/mute")) return true;

	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, " %s     %s  %d ", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), mute_time);

	if(strlen(reason))
		format(fmt_msg, sizeof fmt_msg, "%s. : %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SetPlayerData(to_player, P_MUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "mute", mute_time * 60);

	SendClientMessage(to_player, 0xCECECEFF, "    : {CCCC00}/time");

	format(fmt_msg, sizeof fmt_msg, " %s[acc:%d]    %d . : %s",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time, reason);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:unmute(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 1) return 1;

	extract params -> new to_player, string: reason[30]; else return SendClientMessage(playerid, 0xCECECEFF, ": /unmute [id ] []");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "  ");

	else if(GetPlayerData(to_player, P_MUTE) <= 0) return SendClientMessage(playerid, 0xCECECEFF, "    ");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "     ");

	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, " %s     %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));

	if(strlen(reason))
		format(fmt_msg, sizeof fmt_msg, "%s. : %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SendClientMessage(to_player, 0x66CC00FF, "   ");

	format(fmt_msg, sizeof fmt_msg, "  %s[acc:%d]. : %s",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), reason);

	SetPlayerData(to_player, P_MUTE, 0);
	UpdatePlayerDatabaseInt(to_player, "mute", 0);


	format(fmt_msg, sizeof fmt_msg, "    %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);
	return 1;
}

CMD:jail(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 1) return 1;
	

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ": /jail [id ] [  ] [ ()]");

	extract params -> new to_player, jail_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "  ");

	if(!(1 <= jail_time <= 360)) return SendClientMessage(playerid, 0xCECECEFF, "     1    360 ");
	if(GetPlayerData(to_player, P_JAIL) > 0) return SendClientMessage(playerid, 0xCECECEFF, "     ");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "    ");

	if(AntiSliv(playerid, "/jail")) return true;

	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, " %s     %s  %d ", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), jail_time);

	if(strlen(reason))
		format(fmt_msg, sizeof fmt_msg, "%s. : %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SendClientMessage(to_player, 0xCECECEFF, "   : {CCCC00}/time");

	JailPlayer(to_player, jail_time);

	format(fmt_msg, sizeof fmt_msg, "   %s[acc:%d]  %d . : %s",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), jail_time, reason);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:unjail(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 1) return 1;

	extract params -> new to_player, string: reason[30]; else return SendClientMessage(playerid, 0xCECECEFF, ": /unjail [id ] []");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "  ");

	else if(GetPlayerData(to_player, P_JAIL) <= 0) return SendClientMessage(playerid, 0xCECECEFF, "     ");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "     ");

	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, " %s    %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));

	if(strlen(reason))
		format(fmt_msg, sizeof fmt_msg, "%s. : %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SendClientMessage(to_player, 0x66CC00FF, "   ");

	format(fmt_msg, sizeof fmt_msg, "   %s[acc:%d]. : %s",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), reason);

	UnjailPlayer(to_player);

	format(fmt_msg, sizeof fmt_msg, "   %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}
CMD:getcam(playerid, params[])
{
						new
                        Float:fPX, Float:fPY, Float:fPZ,
                        Float:fVX, Float:fVY, Float:fVZ,
                        Float:object_x, Float:object_y, Float:object_z;

		                const
		                Float:fScale = 5.0;

		                GetPlayerCameraPos(playerid, fPX, fPY, fPZ);
		                GetPlayerCameraFrontVector(playerid, fVX, fVY, fVZ);

		                object_x = fPX + floatmul(fVX, fScale);
		                object_y = fPY + floatmul(fVY, fScale);
		                object_z = fPZ + floatmul(fVZ, fScale);

		                format(sctring, sizeof(sctring), "CameraPos: %f,%f,%f | LookAt: %f,%f,%f",fPX,fPY,fPZ,object_x,object_y,object_z);
		                print(sctring);
		                SendClientMessage(playerid, -1, sctring);
						return 1;
}
CMD:ban(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 4)
        return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");

    if(!strlen(params))
        return SendClientMessage(playerid, 0xCECECEFF, ": /ban [id  ] [] []");

    extract params -> new string:target[24], days, string:reason[96];

    if(!strlen(target))
        return SendClientMessage(playerid, 0xCECECEFF, ": /ban [id  ] [] []");

    if(!(1 <= days <= 3650))
        return SendClientMessage(playerid, 0x999999FF, "     1  3650 ");

    if(!strlen(reason))
        return SendClientMessage(playerid, 0x999999FF, "  ");

    if(AntiSliv(playerid, "/ban"))
        return 1;

    new to_player = GetPlayerID(target);
    if(IsPlayerConnected(to_player) && IsPlayerLogged(to_player))
    {
        if(GetPlayerAdminEx(to_player) >= GetPlayerAdminEx(playerid))
            return SendClientMessage(playerid, 0xCECECEFF, "    / ");

        if(!AddBan(GetPlayerAccountID(to_player), gettime(), days, GetPlayerIpEx(to_player), reason, GetPlayerNameEx(playerid)))
            return SendClientMessage(playerid, 0xFF5533FF, "  :    ");

        new announce[256];
        format(announce, sizeof(announce), " %s   %s  %d , : %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), days, reason);
        SendClientMessageToAll(0xFF5533FF, announce);

        new log_msg[256];
        format(log_msg, sizeof(log_msg), "BAN: %s[%d] -> %s[acc:%d]  %d . : %s", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), days, reason);
        SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, log_msg);

        new ban_msg[180];
        format(ban_msg, sizeof(ban_msg), "    %d . : %s", days, reason);
        SendClientMessage(to_player, 0xFF5533FF, "   .");
        SendClientMessage(to_player, 0xFF5533FF, ban_msg);

        SetTimerEx("KickBannedPlayer", 1200, false, "i", to_player);
        return 1;
    }

    new query[256], Cache:result, rows, uid, admin_level, player_name[24], uip[16];
    player_name[0] = EOS;
    uip[0] = EOS;

    mysql_format(mysql, query, sizeof query, "SELECT id, name, admin, last_ip FROM accounts WHERE name='%e' LIMIT 1", target);
    result = mysql_query(mysql, query, true);
    rows = cache_num_rows(result);

    if(rows)
    {
        uid = cache_get_row_int(0, 0);
        cache_get_row(0, 1, player_name);
        admin_level = cache_get_row_int(0, 2);
        cache_get_row(0, 3, uip);
    }
    cache_delete(result);

    if(!rows || !uid)
        return ShowNotificationNew(playerid, 2, 4, 0, 0, "  ", "");

    if(admin_level >= GetPlayerAdminEx(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, "    / ");

    mysql_format(mysql, query, sizeof query, "SELECT 1 FROM listban WHERE acc_id=%d LIMIT 1", uid);
    result = mysql_query(mysql, query, true);
    rows = cache_num_rows(result);
    cache_delete(result);

    if(rows)
        return SendClientMessage(playerid, 0x999999FF, "   ");

    if(!AddBan(uid, gettime(), days, uip, reason, GetPlayerNameEx(playerid)))
        return SendClientMessage(playerid, 0xFF5533FF, "  :    ");

    if(!strlen(player_name)) format(player_name, sizeof player_name, "%s", target);

    new announce[256];
    format(announce, sizeof(announce), " %s   %s  %d , : %s", GetPlayerNameEx(playerid), player_name, days, reason);
    SendClientMessageToAll(0xFF5533FF, announce);

    new log_msg[256];
    format(log_msg, sizeof(log_msg), "OFFBAN  /ban: %s[%d] -> %s[acc:%d]  %d . : %s", GetPlayerNameEx(playerid), playerid, player_name, uid, days, reason);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, log_msg);
    return 1;
}


CMD:unban(playerid, params[])
{

	if(GetPlayerAdminEx(playerid) < 3) return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");

	extract params -> new string: player_name[21];

	if(!strlen(player_name)) return SendClientMessage(playerid, 0xCECECEFF, ""SC": /unban [ ]");

	new query[80],
		Cache: result,
		rows,
		uid,
		uip[16];

	mysql_format(mysql, query, sizeof query, "SELECT id, last_ip FROM accounts WHERE name='%s'", player_name);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows(result);

	if(rows)
	{
		uid = cache_get_row_int(0, 0);
		cache_get_row(0, 1, uip);
	}

	cache_delete(result);

	if(!rows || !uid) return SendClientMessage(playerid, 0x999999FF, ""SC"     ");

	mysql_format(mysql, query, sizeof query, "SELECT * FROM listban WHERE acc_id=%d", uid);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows(result);

	cache_delete(result);

	if(!rows) return SendClientMessage(playerid, 0x999999FF, ""SC"   ");

	mysql_format(mysql, query, sizeof query, "DELETE FROM listban WHERE acc_id=%d", uid);
	mysql_query(mysql, query, false);

	mysql_format(mysql, query, sizeof query, "DELETE FROM ban_list WHERE user_id=%d", uid);
	mysql_query(mysql, query, false);

	format(query, sizeof query, "unbanip %s", uip);
	SendRconCommand(query);

	SendRconCommand("reloadbans");

	format(query, sizeof query, " %s   %s", GetPlayerNameEx(playerid), player_name);
	

	SendClientMessageToAll(0xFF5533FF, query);

	format(query, sizeof query, " %s[acc:%d]", player_name, uid);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, query);

	return 1;
}
CMD:setskin(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4) return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");

	extract params -> new skin_id; else return SendClientMessage(playerid, 0xCECECEFF, ""SC": /setskin [id ]");

	if(GetPlayerTeamEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"  ,   ");
	if(!(2 <= skin_id <= 20000000)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"ID   1  20000");

	new old_skin_id = GetPlayerData(playerid, P_SKIN);
	SetPlayerData(playerid, P_SKIN, skin_id);
	UpdatePlayerDatabaseInt(playerid, "skin", skin_id);
	SetPlayerSkinInit(playerid);

	new fmt_text[144];
	format(fmt_text, sizeof fmt_text, "{1E90FF}    %d", skin_id);
	SendClientMessage(playerid, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, "{FF5533}[A] %s[%d]    %d", GetPlayerNameEx(playerid), playerid, skin_id);
	SendMessageToAdmins(fmt_text, 0xCECECEFF);

	format(fmt_text, sizeof fmt_text, "  [acc:%d]  %d", GetPlayerAccountID(playerid), skin_id);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);
	new skin_change[48];
	format(skin_change, sizeof skin_change, "%d -> %d", old_skin_id, skin_id);

	return 1;
}

