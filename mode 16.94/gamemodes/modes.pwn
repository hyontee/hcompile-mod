enum E_PLAYER_CP_STRUCT
{
	Float: CP_POS_X,
	Float: CP_POS_Y,
	Float: CP_POS_Z,
	Float: CP_SIZE,
	bool: CP_ENABLED,
	CP_ACTION_TYPE
};

