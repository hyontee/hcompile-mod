			case DIALOG_ADMIN_LOGIN:
			{
				if(!IsPlayerLogged(playerid))
					return SendClientMessage(playerid, 0x999999FF, "    .  .");
				if(GetPlayerAdminEx(playerid) < 1)
					return SendClientMessage(playerid, 0x999999FF, "      .");
				if(GetPlayerData(playerid, P_ADMIN_LOGGED))
					return SendClientMessage(playerid, 0x999999FF, "    -.");

				if(!response) return 1;
				if(!strlen(inputtext) || !IsNumeric(inputtext) || strval(inputtext) != GetPlayerData(playerid, P_APASS))
				{
					SetPVarInt(playerid, "AdminLoginAttempts", GetPVarInt(playerid, "AdminLoginAttempts") + 1);
					new attempts_left = 3 - GetPVarInt(playerid, "AdminLoginAttempts");
					if(attempts_left <= 0)
					{
						new warning[160];
						format(warning, sizeof warning, "[A] %s[%d] :    . IP: %s", GetPlayerNameEx(playerid), playerid, GetPlayerIpEx(playerid));
						SendMessageToAdmins(warning, 0xFF5533FF);
						FixKick(playerid);
						return 1;
					}
					new error_text[144];
					format(error_text, sizeof error_text, "{FF5533}  .  : %d", attempts_left);
					SendClientMessage(playerid, 0xFF5533FF, error_text);
					return ShowAdminLoginPasswordDialog(playerid);
				}

				DeletePVar(playerid, "AdminLoginAttempts");
				SetPlayerData(playerid, P_ADMIN_LOGGED, 1);
				SendClientMessage(playerid, 0x33CC33FF, "    -.");
				new login_message[144];
				format(login_message, sizeof login_message, "[A-LOGIN] %s[%d]   -", GetPlayerNameEx(playerid), playerid);
				SendMessageToAdmins(login_message, 0x33CC33FF);
				return 1;
			}
			case DIALOG_ADMIN_REG:
			{
				if(!response) return FixKick(playerid);

				if(strval(inputtext) < 1000 || strval(inputtext) > 9999) return Dialog(playerid, DIALOG_ADMIN_REG, DIALOG_STYLE_INPUT, "{00FFFF}"SERVER_NAME" {ffffff} |  ", "{FFFFFF}   4-      \n{FFFFFF}    :\n", "", "");
	            SetPlayerData(playerid, P_APASS, strval(inputtext));

	            UpdatePlayerDatabaseInt(playerid, "AdminPass", GetPlayerData(playerid, P_APASS));

	            AdminAuthorization(playerid);
			}
			case DIALOG_ADMINS:
{
    if(GetPVarInt(playerid, "admins_online_dialog"))
    {
        if(!response)
        {
            DeletePVar(playerid, "admins_online_dialog");
            DeletePVar(playerid, "admins_online_page");
            return 1;
        }

        new nav_value = GetPlayerListitemValue(playerid, listitem);
        if(nav_value == -1)
        {
            new page = GetPVarInt(playerid, "admins_online_page");
            if(page > 0)
                ShowAdminsOnlineDialog(playerid, page - 1);
            return 1;
        }
        if(nav_value == -2)
        {
            ShowAdminsOnlineDialog(playerid, GetPVarInt(playerid, "admins_online_page") + 1);
            return 1;
        }
        return 1;
    }

    if(!response) return 1;
 
    new user_id = GetPlayerListitemValue(playerid, listitem);
    SetPVarInt(playerid, "admin_panel_user_id", user_id);
 
    Dialog
    (
        playerid, DIALOG_EDIT_ADMIN, DIALOG_STYLE_LIST,
        "{FFCC00} ",
        "\
        1. / .\n\
        2.  \n\
        {ff3300}3.  \
        ",
        "", ""
    );
 
    return 1;
}

			case DIALOG_EDIT_ADMIN:
{
    if(!response) return 1; //       

    new fmt_text[128],
        user_id = GetPVarInt(playerid, "admin_panel_user_id");

    switch(listitem)
    {
        case 0:
        {
            format
            (
                fmt_text, sizeof fmt_text,
                "{FFFFFF}\
                  \n\n\
                ID : %d\n\
                : \t%s\
                ",
                user_id, GetPlayerNameBySqlID(user_id)
            );

            Dialog(playerid, DIALOG_EDIT_ADMIN_RANG, DIALOG_STYLE_MSGBOX, "{FFCC00} .", fmt_text, "", "");
        }
        case 1:
        {
            format
            (
                fmt_text, sizeof fmt_text,
                "{FFFFFF}\
                 \n\n\
                ID : %d\n\
                : \t%s\n\n\
                    ?\
                ",
                user_id, GetPlayerNameBySqlID(user_id)
            );

            Dialog(playerid, DIALOG_EDIT_ADMIN_RANG, DIALOG_STYLE_MSGBOX, "{FFCC00} ", fmt_text, "", "");
        }
    }

    return 1;
}

			case DIALOG_EDIT_ADMIN_RANG:
			{
				new user_id = GetPVarInt(playerid, "admin_panel_user_id"),
					player_id = GetPlayerIDBySqlID(user_id);

				if(player_id != -1)
				{
					if(response) AddPlayerData(player_id, P_ADMIN, +, 1);
					else AddPlayerData(player_id, P_ADMIN, -, 1);
					UpdatePlayerDatabaseInt(player_id, "admin", GetPlayerData(player_id, P_ADMIN));
					if(response) SendClientMessage(playerid, 0x66CC33FF, "    ");
					else SendClientMessage(playerid, 0xFF3300FF, "    ");
				}
					else
				{
					new query[55],
						Cache: result,
						admin_rank;

					mysql_format(mysql, query, sizeof query, "SELECT admin FROM accounts WHERE id=%d", user_id);
					result = mysql_query(mysql, query, true);

					if(!cache_num_rows(result)) return 0;

					admin_rank = cache_get_row_int(0, 0);

					cache_delete(result);

					if(response) admin_rank++;
					else admin_rank--;

					mysql_format(mysql, query, sizeof query, "UPDATE accounts SET admin=%d WHERE id=%d", user_id, admin_rank);
					result = mysql_query(mysql, query, false);
				}


				return 1;
			}

			case DIALOG_LEADERS:
{
    if(!response) return 1; //       

    new user_id = GetPlayerListitemValue(playerid, listitem);
