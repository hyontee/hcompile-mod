forward RestartServer();

public RestartServer()
{
	SendClientMessageToAll(-1, " {CA0303}      !");

	foreach(new i : Player)
	{
		OnPlayerDisconnect(i, 0);
	}

	server_restart = true;
	return GameModeExit();
}

