	vInfo[i][IsHydroActive]        = GetOwnableCarData(i, OC_isHydroActive);
	vInfo[i][IsHydroBought]        = GetOwnableCarData(i, OC_isHydroBought);
	vInfo[i][IsFarLightActive]        = GetOwnableCarData(i, OC_isFarLightActive);
