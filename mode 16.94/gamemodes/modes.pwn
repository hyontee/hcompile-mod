stock ShowPlayerGUI(playerid, guiid, Node:json)
{
	JSON_SetInt(json, "o", 1);
	OnPacketIncoming(playerid, guiid, json);
}
stock UpdatePlayerGUI(playerid, guiid, Node:json)
{
	OnPacketIncoming(playerid, guiid, json);
}
stock HidePlayerGUI(playerid, guiid) //, Node:json)
{
	new Node:json = JSON_Object();
	JSON_SetInt(json, "c", 1);
	OnPacketIncoming(playerid, guiid, json);
}

stock OnPacketIncoming(playerid, guiid, Node:json)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT8, PACKET_BLACKRRPC);

	BS_WriteValue(bitstream, PR_UINT16, guiid);

	new data[1024];
    JSON_Stringify(json, data);

    BS_WriteValue(bitstream, PR_UINT32, strlen(data));
    BS_WriteValue(bitstream, PR_STRING, data);

	PR_SendPacket(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);
	BS_Delete(bitstream);
}


stock ResetCarModes(playerid, vehicleid)
{
    if(!IsAOwnableCar(vehicleid)) return 0;
    static const modes[] = { 8, 9, 10, 11 };

    new JSON:tmp = JSON_Object();

    for (new i = 0; i < sizeof(modes); i++)
    {
        JSON_SetInt(tmp, "t", modes[i]);
        JSON_SetInt(tmp, "s", 0);
        OnPacketIncoming(playerid, GUIRadialMenuForCar, tmp);
    }

    JSON_Cleanup(tmp);
	new i = GetVehicleData(vehicleid, V_ACTION_ID);
    if(i < 0 || i >= sizeof(vInfo) || i >= MAX_OWNABLE_CARS) return 0;
    vInfo[i][vFstate] = FSTATE_NONE;
	SendCarFirmware(playerid, FSTATE_NONE);
    SetVehicleDriftForPlayer(playerid, vehicleid, 0);
	new query[75], Cache: result;
	new database_id = GetOwnableCarData(GetVehicleData(vehicleid, V_ACTION_ID), OC_SQL_ID);
	mysql_format(mysql, query, sizeof query,
        "UPDATE ownable_cars SET f_state = %d WHERE id = %d",
        FSTATE_NONE, database_id
    );
	mysql_query(mysql, query, false);
	printf("%d", database_id);
}
stock CheckFirmwareLine(index, firmware_line)
{
    switch (firmware_line)
    {
        case FSTATE_COMFORT:
        {
            if (vInfo[index][vComfort]  &&
                vInfo[index][vComfort1] &&
                vInfo[index][vComfort2] &&
                vInfo[index][vComfort3] &&
                vInfo[index][vComfort4])
                return 1;
        }
        case FSTATE_SPORT:
        {
            if (vInfo[index][vSport]  &&
                vInfo[index][vSport1] &&
                vInfo[index][vSport2] &&
                vInfo[index][vSport3] &&
                vInfo[index][vSport4])
                return 1;
        }
        case FSTATE_DRIFT:
        {
            if (vInfo[index][vDrift]  &&
                vInfo[index][vDrift1] &&
                vInfo[index][vDrift2] &&
                vInfo[index][vDrift3] &&
                vInfo[index][vDrift4])
                return 1;
        }
        case FSTATE_SPORT_PLUS:
        {
            if (vInfo[index][vSportPlus]  &&
                vInfo[index][vSportPlus1] &&
                vInfo[index][vSportPlus2] &&
                vInfo[index][vSportPlus3] &&
                vInfo[index][vSportPlus4])
                return 1;
        }
    }
    return 0;
}

#define PERCENT_COMFORT   4.25
#define PERCENT_SPORT     7.25
#define PERCENT_DRIFT     5.25
#define PERCENT_SPORTPLUS 0.53
stock GetFirmwarePrice(vehicleID, Float:percent)
{
    new car_price = GetVehiclePriceByModel(vInfo[vehicleID][vModelID]);
	printf("carprice %d", car_price);
	printf("carpriceper %d", floatround(car_price * (percent / 100.0)));
    return floatround(car_price * (percent / 100.0));
}

stock SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, bias) 
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, 1); 
	new packed = _:bias; // reinterpret float bits
BS_WriteValue(bs, PR_UINT32, packed);
    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}
stock SetVehicleSuspensionBiasFor(playerid, vehicleid, bias) 
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, 2); 
	new packed = _:bias; // reinterpret float bits
BS_WriteValue(bs, PR_UINT32, packed);
    PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}
new bool:CarLights[MAX_VEHICLES];
new bool:CarLock[MAX_VEHICLES];
new bool:CarEngine[MAX_VEHICLES];
new bool:CarKey[MAX_VEHICLES];

IPacket:252(playerid, BitStream:bitstream)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid)) return 0;

    new
        header,
        rpcid,
        data[512],
        outcoming_data[512],
        JSON:json,
        JSON:json_packet_data = JSON_Object(),
        JSON:JSONObject = JSON_Object();

    BS_ReadValue(bitstream, PR_UINT8, header);
    BS_ReadValue(bitstream, PR_UINT16, rpcid);
	if(rpcid == 128)
    {
		new action;
        new id;
		new damage;
        if(!BS_ReadUint32(bitstream, action))
        {
            return 1;
        }
		if(action == 22)
        {
			printf("INCOMING DAMAGE:");
		}
        if(action == 1)
        {
			printf("INCOMING DAMAGE:");
			if(!BS_ReadUint16(bitstream, id))
            {
                return 1;
            }
			if(!BS_ReadUint32(bitstream, damage))
            {
                return 1;
            }
			printf("INCOMING DAMAGE: %d HP for ID: %d", id, damage);
		}
	}
if (rpcid == 111){
	return 1;
}
    printf("[DEBUG] IPacket:252 - playerid: %d, header: %d, rpcid: %d", playerid, header, rpcid);

    new length;
    BS_ReadValue(bitstream, PR_UINT32, length);
    BS_ReadValue(bitstream, PR_STRING, data, length);

    printf("[DEBUG] IPacket:252 - data length: %d, data: %s", length, data);

    JSON_Parse(data, json);

    switch(rpcid) 
    {
       case 39, 65:
       {
            return BlackPass_HandleExtraGui(playerid, rpcid, json);
       }
       case BrDialogDiner:
       {
            return Larek_HandleJsonPacket(playerid, json);
       }
       case 40:
  {
   new type;
   JSON_GetInt(json, "t", type);
   
   switch(type)
   {
    case 2:
    {
     JSON_SetInt(json, "t", 2);
     
     SetPlayerPos(playerid, 1482.54,2504.26,2501.04);
     SetPlayerFacingAngle(playerid, 182.71);
     SetPlayerInterior(playerid, 1);
    
     HidePlayerGUI(playerid, 40);
    }
   }
  }
       case 125:
       {
            return ContNewSystem_HandlePacket(playerid, json);
       }
        case 113:
{
    new type;

    //       "a" (action)
    if (JSON_GetInt(json, "a", type)) {
        printf("[RPC 113]   type = %d   'a'", type);
    }
    //    "a",   "c" (click/close)
    else if (JSON_GetInt(json, "c", type)) {
        printf("[RPC 113]   type = %d   'c'", type);

        //  type = 1   "c" -   
        if (type == 1) {
            printf("[RPC 113]  %d  ", playerid);
            return 1;
        }
    }
					else {
        printf("[RPC 113]    type   'a'  'c'");
        return 1;
    }

    switch (type) {
        case 2:
        {
            new JSON:root = JSON_Object();
            ShowPlayerGUI(playerid, 47, root);
            JSON_Cleanup(root);
        }
        case 3:  ShowNotificationNew(playerid, 2, 6, 0, 0, "  ", "qq");
        case 4:  ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 5:  ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 100:ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 8:  ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 12: animsss(playerid);
        case 13: donatess(playerid);
        case 18: ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 19: ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 22: rewardsss(playerid);
        case 11: inssssv(playerid);
        case 21: ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 15: promosss(playerid);
        case 14: carssssc(playerid);
        case 7:  gpswww(playerid);
        case 17: ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 25: ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 20: ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 9:  ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 24: ShowNotificationNew(playerid, 2, 6, 0, 0, " ", "qq");
        case 16: sssreport(playerid);
        default: printf("[RPC 113]  : %d", type);
    }

    return 1;
}

case 45: // 
{
    return FamilyGuiHandlePacket(playerid, json);
}

	case GUIFuelFill:
