stock ShowSpawnLocationGUI(playerid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid))
        return 0;

    new JSON:json_spawn = JSON_Object();
    new JSON:json_spawn_array = JSON_Array();

    // 1 = основные точки, 2 = последнее место,
    // 4 = дом/квартира, 6 = фракция.
    json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(1)));

    if(HasRecentSpawnState(GetPlayerAccountID(playerid)))
        json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(2)));

    if(GetHouseNewByOwner(GetPlayerAccountID(playerid), playerid) != -1)
        json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(4)));

    if(GetFlatNewByOwner(GetPlayerAccountID(playerid), playerid) != -1)
        json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(4)));

    if(GetPlayerIdFamily(playerid) != -1 && GetFamily(GetPlayerIdFamily(playerid), family_house) != -1)
        json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(6)));

    if(GetPlayerTeamEx(playerid))
        json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(0)));

    JSON_SetArray(json_spawn, "m", json_spawn_array);
    ShowPlayerGUI(playerid, GUISpawnLocation, json_spawn);
    JSON_Cleanup(json_spawn);
    return 1;
}

CMD:spawn(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1)
        return SendClientMessage(playerid, 0xCECECEFF, "      .");

    extract params -> new targetid; else
        return SendClientMessage(playerid, 0xCECECEFF, " /spawn [id ]");

    if(targetid < 0 || targetid >= MAX_PLAYERS || !IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
        return ShowNotificationNew(playerid, 2, 4, 0, 0, "  ", "");

    if(GetPlayerData(targetid, P_JAIL) > 0)
        return SendClientMessage(playerid, COLOR_RED, "      .");

    if(!ShowSpawnLocationGUI(targetid))
        return SendClientMessage(playerid, COLOR_RED, "        .");

    new fmt_text[144];
    format(fmt_text, sizeof fmt_text, "[A] %s[%d]     %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid);
    SendMessageToAdmins(fmt_text, 0x999999FF);

    format(fmt_text, sizeof fmt_text, "  %s[acc:%d]    /spawn", GetPlayerNameEx(targetid), GetPlayerAccountID(targetid));
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

    SendClientMessage(playerid, 0x999999FF, "     .");
    SendClientMessage(targetid, 0xFFFFFFFF, "       .");
    return 1;
}

