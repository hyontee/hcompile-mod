{
    SetPVarInt(playerid, "select_fam_car", id);

    new status = GetStatusFamilyCar(id);

    if(!status)
    {
        if(GetPlayerRangFamily(playerid) != 5)
        {
            Dialog
            (
                playerid, 2224, DIALOG_STYLE_LIST, 
                "{FF0000} ",
                "1.    GPS\n"\
                "2.  \n"\
                "3.  ",
                "", ""
            );
        }
        else
        {
            Dialog
            (
                playerid, 2224, DIALOG_STYLE_LIST, 
                "{FF0000} ",
