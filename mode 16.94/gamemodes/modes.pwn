        100, 250, 500, 1000, 2000, 300, 450, 600, 800, 1200,
        1500, 1800, 2200, 2500, 3000, 3500, 4000, 4500, 5000, 5500,
        6000, 6500, 7000, 7500, 8000, 9000, 10000, 12000, 15000, 20000
    };

    new JSON:caseNamesArray = JSON_Array();
    new JSON:caseTypesArray = JSON_Array();
    new JSON:casePricesArray = JSON_Array();
    for (new i = 0; i < MAX_CASES; i++)
    {
        JSON_Append(caseNamesArray, JSON_String(caseNames[i]));
        JSON_Append(caseTypesArray, JSON_String(caseTypes[i]));
        JSON_Append(casePricesArray, JSON_Int(casePrices[i]));
    }
    JSON_SetArray(JSONObject, "cn", caseNamesArray);
    JSON_SetArray(JSONObject, "ct", caseTypesArray);
    JSON_SetArray(JSONObject, "cp", casePricesArray);
    JSON_SetString(JSONObject, "cstyle", "black_russia_cases");
    JSON_SetInt(JSONObject, "cnav", 1);

    //    : id +    .
    new JSON:caseCatalog = JSON_Array();
