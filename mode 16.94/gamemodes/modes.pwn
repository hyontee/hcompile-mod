		 	mp[MP_POS_X] ? ("") : (""));

			Dialog(playerid, DIALOG_MP_MENU, DIALOG_STYLE_LIST, " ", fmt_str, "", "");
		}
	}
	return 1;
}

CMD:63(playerid, params[])
{
	if(!mp[MP_CREATE]) return SendClientMessage(playerid, 0xCECECEFF, "  ");

	if(!mp[MP_POS_X]) return SendClientMessage(playerid, 0xCECECEFF, "   ");

	SetPlayerPos(playerid, mp[MP_POS_X], mp[MP_POS_Y], mp[MP_POS_Z]);

	SendClientMessage(playerid, -1, "    ");

	SetPlayerData(playerid, P_LAST_MP, 1);

	return 1;
}

CMD:mp(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) >= 3)
	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, ": /mp []");

        new fmt_str[999];

		for(new i; i < MAX_PLAYERS; i ++)
		{
			if(!IsPlayerConnected(i)) continue;
			else if(!IsPlayerLogged(i)) continue;
			else if(GetPlayerData(i, P_LAST_MP) != 0) continue;

			format(fmt_str, sizeof fmt_str, "{FFCC33}[EVENT]  {d58300}%s{FFCC33}: %s", GetPlayerNameEx(playerid), params);
			SendClientMessage(playerid, 0x3399FFFF, fmt_str);
		}
	}
	return 1;
}


