stock ApplyWoundAnimation(playerid)
{
    ClearAnimations(playerid);
    ApplyAnimation(playerid, "SWEET", "Sweet_injuredloop", 4.1, 1, 0, 0, 0, 0, 1);
    TogglePlayerControllable(playerid, 0);
    return 1;
}

stock SpawnPlayerToHospital(playerid)
{
    new Float:hospital_x = -2584.400390;
    new Float:hospital_y = 31.464624;
    new Float:hospital_z = 28.115768;
    new Float:hospital_angle = 1.187911;

    ClearAnimations(playerid);
    SetPlayerPos(playerid, hospital_x, hospital_y, hospital_z);
    SetPlayerFacingAngle(playerid, hospital_angle);
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    SetPlayerHealth(playerid, 100.0);
    SetPlayerArmour(playerid, 0.0);
    TogglePlayerControllable(playerid, 1);
    SetPVarInt(playerid, "WoundActive", 0);
    SetPVarInt(playerid, "WoundHospital", 1);
    SetPlayerSpawnInit(playerid);
    SendClientMessage(playerid, 0xFFFFFF, "    ");
    return 1;
}

stock ShowWoundSystem(playerid)
{
    new Node:json = JSON_Object();
    new wounded_name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, wounded_name, MAX_PLAYER_NAME);
    JSON_SetInt(json, "id", GetPlayerAccountID(playerid));
    JSON_SetString(json, "p", wounded_name);
    JSON_SetInt(json, "h", 0);
    ShowPlayerGUI(playerid, 40, json);
    JSON_Cleanup(json);
    return 1;
}

CMD:woundd(playerid, params[])
