                for( new j; j < 20; j++ )
                {
                    if(GetPVarInt(playerid, #dialog) == j+1)
                    {
                        format(quick_mes[playerid][j][line], 128, inputtext);
                        save_QuickMessage(playerid, j);
                    }
                }
                editMessage(playerid);

            }
