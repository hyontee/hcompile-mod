		    "{FFFFFF}:\t{00CC66}%d \n"\
		    "{FFFFFF} :\t{00CC66}%d ",
		    HouseData[h][hName],
		    houseid + 3000,
		    HouseData[h][hRooms],
		    HouseData[h][hPrice],
