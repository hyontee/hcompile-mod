          {
            format(info, sizeof info, "{FFFFFF}%s\n{2BB1FF} :{FFFFFF} %s\n{2BB1FF} :{FFFFFF} %d \n{2BB1FF} :{FFFFFF} %d \n\n   {ffff00}/buycar", GetVehicleName(veh), GetPlayerNameEx(playerid), nrbpack, GetVehicleInfo(modelid - 400, VI_PRICE));
            CreateVehicleLabel(veh, info, 0x2BB1FFFF, x, y, z + 1, 5.0);
            }
