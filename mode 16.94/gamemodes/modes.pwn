cmd:startfevent(playerid, params[])
{
    extract params -> new t;

    if(!t) return SendClientMessage(playerid, -1, "1 -  / 2 -   / 3 -   / 4 -  ");


    if(1 <= t <= 3)
    {
       if(CAPTURE_STATUS[t-1]) return SendClientMessage(playerid, -1, "   .");
       StartFCapture(t-1); 
    } 
    else if(t == 4)
    {
        if(FAM_CONT_STATUS[0] || FAM_CONT_STATUS[1]) return SendClientMessage(playerid, -1, "   .");
        StartFCont(0);
    }
    return 1;
}

stock UpdateExpFamily(f, t)
{
    new player_all_exp;

    foreach(new i : Player)
    {
        if(GetPlayerIdFamily(i) != f) continue;
        else if(!IsPlayerInDynamicArea(i, CAPTURE_AREA[t])) continue;

        player_all_exp += CAPTURE_PLAYER_EXP[i];
    }

    if(CAPTURE_FAMILY_EXP[f][t] != player_all_exp) CAPTURE_FAMILY_EXP[f][t] = player_all_exp;

    if(f == CAPTURE_LEADER[t][0]) CAPTURE_LEADER[t][1] = CAPTURE_FAMILY_EXP[f][t];

    return 1;
}
cmd:tpw(playerid, params[])
{
    if(!params[0]) SetPlayerPos(playerid, 452.989440,-2388.076660,34.813564);
    else SetPlayerPos(playerid, 2016.786865,1397.302490,26.15625);

    return 1;
}

stock StartFCont(type_capt)
{
    if(FAM_CONT_STATUS[type_capt]) return printf("CONT: %d already started", type_capt);

    new string[265], welsi = 2; //genius

    for(new i;i < welsi;i++)
    {
        FAM_CONT_STATUS[i] = true;
        FAM_CONT_BOX[i] = 350;
        FAM_CONT_SECOND[i] = 1500;
        FAM_CONT_GANG_ZONE[i] = GangZoneCreate(coord_fam_cont[i][0], coord_fam_cont[i][1], coord_fam_cont[i][2], coord_fam_cont[i][3]);
        FAM_CONT_AREA[i] = CreateDynamicRectangle(coord_fam_cont[i][0], coord_fam_cont[i][1], coord_fam_cont[i][2], coord_fam_cont[i][3], 
        0, 0);
        FAM_CONT_OBJECT[i] = CreateObject(934, coord_obj_cont[i][0], coord_obj_cont[i][1], coord_obj_cont[i][2]+1.0, 0.0, 0.0, 0.0);

        FAM_CONT_PICKUP[i] = CreateDynamicPickup(19135, 23, coord_puckup_cont[i][0], coord_puckup_cont[i][1], coord_puckup_cont[i][2], 0, 0);
        FAM_CONT_AREA_P[i] = CreateDynamicSphere(coord_puckup_cont[i][0], coord_puckup_cont[i][1], coord_puckup_cont[i][2], 1.5, 0, 0);
        FAM_CONT_3DTEXT[i] = Create3DTextLabel(" \n  : 25 \n    .", -1, 
        coord_puckup_cont[i][0], coord_puckup_cont[i][1], coord_puckup_cont[i][2], 20.0, 0);

        foreach(new w : Player)
        {
            if(GetPlayerIdFamily(w) == -1) continue;
            GangZoneShowForPlayer(w, FAM_CONT_GANG_ZONE[i], 0xFF0000FF0);
            GangZoneFlashForPlayer(w, FAM_CONT_GANG_ZONE[i], 0xFFFF00FF);
        }

        format(string, sizeof string, "{FFFF00}|{FFFFFF}    {FFFF00} {FFFFFF},       ");

        FAM_CONT_TIMER[i] = SetTimerEx("ContUpd", 1000, true, "i", i);
    }
    
    foreach(new w : Player)
    {
        if(GetPlayerIdFamily(w) == -1) continue;
        SendClientMessage(w, -1, string);
    }

    return 1;
}

new string_count[98];
public:ContUpd(i)
{
    if(!FAM_CONT_SECOND[i]) return EndFCont();
    FAM_CONT_SECOND[i]--;

    format(string_count, sizeof string_count, " \n  : %d \n    .", ConvertUnixTime(FAM_CONT_SECOND[i], CONVERT_TIME_TO_MINUTES));
    Update3DTextLabelText(FAM_CONT_3DTEXT[i], -1, string_count);
    return 1;
}

stock EndFCont()
{
    for(new i;i < 2;i++)
    {
        KillTimer(FAM_CONT_TIMER[i]);
        FAM_CONT_TIMER[i] = -1;

        FAM_CONT_STATUS[i] = false;

        DestroyObject(FAM_CONT_OBJECT[i]);
        FAM_CONT_OBJECT[i] = -1; 

        DestroyDynamicArea(FAM_CONT_AREA[i]);
        FAM_CONT_AREA[i] = -1;

        DestroyDynamicArea(FAM_CONT_AREA_P[i]);
        FAM_CONT_AREA_P[i] = -1;

        GangZoneDestroy(FAM_CONT_GANG_ZONE[i]);
        FAM_CONT_GANG_ZONE[i] = -1;

        FAM_CONT_BOX[i] = 0;

        FAM_CONT_SECOND[i] = 0;

        Delete3DTextLabel(FAM_CONT_3DTEXT[i]);
        FAM_CONT_3DTEXT[i] = Text3D:-1;

        DestroyDynamicPickup(FAM_CONT_PICKUP[i]);
        FAM_CONT_PICKUP[i] = -1;
    }
    return 1;
}


cmd:loadfamily(playerid)
{
    if(GetPlayerIdFamily(playerid) == -1) return 0;

    if(!IsPlayerInDynamicArea(playerid, FAM_CONT_AREA[0]) && !IsPlayerInDynamicArea(playerid, FAM_CONT_AREA[1]))
        return SendClientMessage(playerid, -1, ""c_f_g"    .");

    new vehicleid = GetPlayerVehicleID(playerid), action = GetVehicleData(vehicleid, V_ACTION_ID);

    if(vehicleid == INVALID_VEHICLE_ID || GetCarFamily(action, CAR_F_database) == -1 || GetCarFamily(action, OW_F_server) != GetPlayerIdFamily(playerid)) 
        return SendClientMessage(playerid, -1, ""c_f_r"     .");

    FAM_CONT_VEHICLE[playerid] = action;

    new Float:x, Float:y, Float:z, string[74];
    GetCoordBootFamilyVehicle(vehicleid, x, y, z);

    format(string, sizeof string, " : {FF0000}%d", GetCarFamily(action, V_F_COUNT_BOX));

    SetCarFamily(action, V_F_AREA_CONT, CreateDynamicSphere(x,y,z,1.5, 0, 0));
    SetCarFamily(action, V_F_TEXT_CONT, CreateDynamic3DTextLabel(string, -1, x, y, z, 7.0));
    SetCarFamily(action, V_F_STATUS_CONT, true);

    RemovePlayerFromVehicle(playerid);
    SendClientMessage(playerid, -1, ""c_f_g" .");
     
    return 1;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
    {
        new id = GetVehicleData(vehicleid, V_ACTION_ID);

        if(GetCarFamily(id, V_F_STATUS_CONT))
        {
            SendClientMessage(playerid, -1, ""c_f_r"      ( )");
            CreateDynamicMapIcon(2323.082275,-248.499404,1.991280, 6, 0, 0, 0, playerid, -1);
            SetCarFamily(id, V_F_STATUS_CONT, false);

            RemovePlayerAttachedObject(playerid, 2);

            FAM_CONT_VEHICLE[playerid] = -1;

            if(IsValidDynamicArea(GetCarFamily(id, V_F_AREA_CONT))) DestroyDynamicArea(GetCarFamily(id, V_F_AREA_CONT));
            DestroyDynamic3DTextLabel(GetCarFamily(id, V_F_TEXT_CONT));
            SetCarFamily(id, V_F_STATUS_CONT, false);
        } 
    }
    #if defined cont_OnPlayerEnterVehicle
        return cont_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger);
    #else
        return 1;
    #endif
}
   #if defined _ALS_OnPlayerEnterVehicle
    #undef OnPlayerEnterVehicle
#else
    #define _ALS_OnPlayerEnterVehicle
#endif
#define OnPlayerEnterVehicle cont_OnPlayerEnterVehicle
#if defined cont_OnPlayerEnterVehicle
    forward cont_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger);
#endif

stock GetCoordBootFamilyVehicle(vehicleid, &Float:x, &Float:y, &Float:z)
{
    new Float:angle,Float:distance;
    GetVehicleModelInfo(GetVehicleModel(vehicleid), 1, x, distance, z);
    distance = distance/2 + 0.1;
        GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle+180, degrees));
    y += (distance * floatcos(-angle+180, degrees));
    return 1;
}

public:SetPlayerBoxInHard(playerid, number)
{
    SetPlayerAttachedObject(playerid, 2, 2969, 1, 0.121241, 0.433916, -0.038068, 359.338867, 91.670600, 179.788787, 1.000000, 1.000000, 1.000000);
    FAM_CONT_BOX[number]--;
    SendClientMessage(playerid, -1, ""c_f"  ,     .");
    SetPVarInt(playerid, "box_in_hard", 1);
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 1, 1, 1, 1, 0);

    return 1;
}
// Stock   KEY_CROUCH
stock HandleFamilyCrouch(playerid)
{
    if(GetPlayerIdFamily(playerid) == -1 || !IsPlayerInDynamicArea(playerid, FAM_CONT_DELIVERY)) return 0;

    new vehicleid = GetPlayerVehicleID(playerid);

    if(vehicleid == INVALID_VEHICLE_ID || GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_FAMILY_CAR) return 0;

    new action = GetVehicleData(vehicleid, V_ACTION_ID), f = GetCarFamily(action, OW_F_server);

    if(f != GetPlayerIdFamily(playerid)) return 0;

    if(GetCarFamily(action, V_F_COUNT_BOX) == 0) return SendClientMessage(playerid, -1, ""c_f_r"      ");

    new money = GetCarFamily(action, V_F_COUNT_BOX) * 100;

    AddFamily(f, family_reputation, +, GetCarFamily(action, V_F_COUNT_BOX));
    AddFamily(f, family_money, +, money);
    UpdateColumnFamilyInt(GetFamily(f, family_database), "money", GetFamily(f, family_money));
    UpdateColumnFamilyInt(GetFamily(f, family_database), "reputation", GetFamily(f, family_reputation));

    format(f_string144, sizeof f_string144, "%s[%d]     ,   %d .,  %d ", 
        GetPlayerNameEx(playerid), playerid, GetCarFamily(action, V_F_COUNT_BOX), money);
    SendFamilyMessage(f, f_string144);
    SetCarFamily(action, V_F_COUNT_BOX, 0);

    return 1;
}
// END INLINED: include/system/family_addition.pwn
// BEGIN INLINED: include/system/familysystem.inc
#if defined _INC_FAMILY_SYSTEM
    #endinput
#endif
#define _INC_FAMILY_SYSTEM

#define FAMILY_SYSTEM_MAX_CARS (1000)

enum E_FAMILY_SYSTEM_CAR
{
    FS_SQL_ID,
    FS_FAMILY_ID,
    FS_OWNABLE_CAR_ID,
    FS_MODEL_ID,
    FS_OWNER_ID,
    FS_ACCESS_RANK,
    FS_STATUS
}

new g_family_system_car[FAMILY_SYSTEM_MAX_CARS][E_FAMILY_SYSTEM_CAR];
new g_family_system_loaded;

stock FamilySystemGetPlayerFamily(playerid)
{
    new family_id = GetPlayerData(playerid, P_FAMILY);

    if(family_id > 0)
    {
        return family_id;
    }

    if(family_id == 0 && GetPlayerData(playerid, P_FAMILY_RANK) >= 10)
    {
        new fam_name[64];
        format(fam_name, sizeof fam_name, "%s", GetFamilyData(0, F_NAME));
        if(strlen(fam_name) > 0)
        {
            return 0;
        }
    }

    if(GetPlayerIdFamily(playerid) != -1)
    {
        return GetPlayerIdFamily(playerid);
    }

    return -1;
}

stock FamilySystemResetSlot(slot)
{
    g_family_system_car[slot][FS_SQL_ID] = 0;
    g_family_system_car[slot][FS_FAMILY_ID] = 0;
    g_family_system_car[slot][FS_OWNABLE_CAR_ID] = 0;
    g_family_system_car[slot][FS_MODEL_ID] = 0;
    g_family_system_car[slot][FS_OWNER_ID] = 0;
    g_family_system_car[slot][FS_ACCESS_RANK] = 1;
    g_family_system_car[slot][FS_STATUS] = 0;
    return 1;
}

stock FamilySystemGetFreeSlot()
{
    for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
    {
        if(g_family_system_car[i][FS_SQL_ID] == 0)
        {
            return i;
        }
    }
    return -1;
}

stock FamilySystemFindBySql(sql_id)
{
    for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
    {
        if(g_family_system_car[i][FS_SQL_ID] == sql_id)
        {
            return i;
        }
    }
    return -1;
}

stock FamilySystemFindByFamilyOwnable(family_id, ownable_car_id)
{
    for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
    {
        if(g_family_system_car[i][FS_SQL_ID] == 0) continue;
        if(g_family_system_car[i][FS_FAMILY_ID] != family_id) continue;
        if(g_family_system_car[i][FS_OWNABLE_CAR_ID] != ownable_car_id) continue;
        return i;
    }
    return -1;
}

stock FamilySystemCreateTable()
{
    mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS `familysystem` (\
        `id` INT NOT NULL AUTO_INCREMENT,\
        `family_id` INT NOT NULL,\
        `owner_id` INT NOT NULL,\
        `ownable_car_id` INT NOT NULL,\
        `model_id` INT NOT NULL,\
        `access_rank` INT NOT NULL DEFAULT 1,\
        `status` TINYINT NOT NULL DEFAULT 0,\
        `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\
        PRIMARY KEY (`id`),\
        UNIQUE KEY `idx_family_ownable` (`family_id`, `ownable_car_id`),\
        KEY `idx_family` (`family_id`),\
        KEY `idx_owner` (`owner_id`),\
        KEY `idx_ownable` (`ownable_car_id`)\
    ) ENGINE=InnoDB DEFAULT CHARSET=cp1251;",
    false);
    return 1;
}

stock FamilySystemLoad()
{
    for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
    {
        FamilySystemResetSlot(i);
    }

    new Cache:result = mysql_query(mysql,
        "SELECT id, family_id, owner_id, ownable_car_id, model_id, access_rank, status FROM familysystem",
    true);

    new rows = cache_num_rows();
    if(rows > FAMILY_SYSTEM_MAX_CARS)
    {
        printf("[FamilySystem] rows (%d) > FAMILY_SYSTEM_MAX_CARS (%d)", rows, FAMILY_SYSTEM_MAX_CARS);
        rows = FAMILY_SYSTEM_MAX_CARS;
    }

    for(new i; i < rows; i++)
    {
        g_family_system_car[i][FS_SQL_ID] = cache_get_field_content_int(i, "id");
        g_family_system_car[i][FS_FAMILY_ID] = cache_get_field_content_int(i, "family_id");
        g_family_system_car[i][FS_OWNER_ID] = cache_get_field_content_int(i, "owner_id");
        g_family_system_car[i][FS_OWNABLE_CAR_ID] = cache_get_field_content_int(i, "ownable_car_id");
        g_family_system_car[i][FS_MODEL_ID] = cache_get_field_content_int(i, "model_id");
        g_family_system_car[i][FS_ACCESS_RANK] = cache_get_field_content_int(i, "access_rank");
        g_family_system_car[i][FS_STATUS] = cache_get_field_content_int(i, "status");
    }

    g_family_system_loaded = rows;
    cache_delete(result);

    printf("[FamilySystem] Loaded cars: %d", g_family_system_loaded);
    return rows;
}

stock FamilySystemInit()
{
    FamilySystemCreateTable();
    FamilySystemLoad();
    return 1;
}

stock FamilySystemAddOwnableCarToFamily(playerid, ownable_car_id, model_id)
{
    new family_id = FamilySystemGetPlayerFamily(playerid);
    if(family_id == -1)
    {
        SendClientMessage(playerid, 0xCECECEFF, "You are not in a family");
        return 0;
    }

    if(GetPlayerData(playerid, P_FAMILY_RANK) < 10 && GetPlayerRangFamily(playerid) != 5)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Only family leader can add cars");
        return 0;
    }

    if(ownable_car_id <= 0 || model_id <= 0)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Invalid vehicle data");
        return 0;
    }

    if(FamilySystemFindByFamilyOwnable(family_id, ownable_car_id) != -1)
    {
        SendClientMessage(playerid, 0xCECECEFF, "This car is already in family car park");
        return 0;
    }

    new slot = FamilySystemGetFreeSlot();
    if(slot == -1)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Family car park limit reached");
        return 0;
    }

    new query[256];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO familysystem (family_id, owner_id, ownable_car_id, model_id, access_rank, status) VALUES (%d, %d, %d, %d, 1, 0)",
        family_id,
        GetPlayerAccountID(playerid),
        ownable_car_id,
        model_id);

    new Cache:result = mysql_query(mysql, query, true);
    if(mysql_errno() != 0)
    {
        cache_delete(result);
        SendClientMessage(playerid, 0xCECECEFF, "SQL error while adding car to family");
        return 0;
    }

    new insert_id = cache_insert_id();
    cache_delete(result);

    if(insert_id <= 0)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Failed to get new family car ID");
        return 0;
    }

    g_family_system_car[slot][FS_SQL_ID] = insert_id;
    g_family_system_car[slot][FS_FAMILY_ID] = family_id;
    g_family_system_car[slot][FS_OWNER_ID] = GetPlayerAccountID(playerid);
    g_family_system_car[slot][FS_OWNABLE_CAR_ID] = ownable_car_id;
    g_family_system_car[slot][FS_MODEL_ID] = model_id;
    g_family_system_car[slot][FS_ACCESS_RANK] = 1;
    g_family_system_car[slot][FS_STATUS] = 0;
    g_family_system_loaded++;

    SendClientMessage(playerid, 0x66CC00FF, "Car added to family car park");
    return 1;
}

stock FamilySystemAddOwnableCarBySql(playerid, ownable_car_id)
{
    if(ownable_car_id <= 0)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Usage: /testfamilybuy [ownable_cars id]");
        return 0;
    }

    new query[144];
    mysql_format(mysql, query, sizeof query,
        "SELECT owner_id, model_id FROM ownable_cars WHERE id = %d LIMIT 1",
        ownable_car_id);

    new Cache:result = mysql_query(mysql, query, true);
    if(cache_num_rows() == 0)
    {
        cache_delete(result);
        SendClientMessage(playerid, 0xCECECEFF, "Car with this ID was not found");
        return 0;
    }

    new owner_id = cache_get_field_content_int(0, "owner_id");
    new model_id = cache_get_field_content_int(0, "model_id");
    cache_delete(result);

    if(owner_id != GetPlayerAccountID(playerid))
    {
        SendClientMessage(playerid, 0xCECECEFF, "You can add only your own personal car");
        return 0;
    }

    return FamilySystemAddOwnableCarToFamily(playerid, ownable_car_id, model_id);
}

stock FamilySystemSendCarList(playerid, Node:json)
{
    new family_id = FamilySystemGetPlayerFamily(playerid);

    JSON_SetInt(json, "t", 2);
    JSON_SetInt(json, "g", 1);

    new Node:nArray = JSON_Array();
    new Node:idArray = JSON_Array();

    if(family_id != -1)
    {
        new model_name[32];
        for(new i; i < FAMILY_SYSTEM_MAX_CARS; i++)
        {
            if(g_family_system_car[i][FS_SQL_ID] == 0) continue;
            if(g_family_system_car[i][FS_FAMILY_ID] != family_id) continue;

            model_name[0] = EOS;
            if(g_family_system_car[i][FS_MODEL_ID] >= 400 && g_family_system_car[i][FS_MODEL_ID] <= 611)
                GetVehicleModelName(g_family_system_car[i][FS_MODEL_ID], model_name);
            else
                format(model_name, sizeof model_name, "Model %d", g_family_system_car[i][FS_MODEL_ID]);

            nArray = JSON_Append(nArray, JSON_Array(JSON_String(model_name)));
            idArray = JSON_Append(idArray, JSON_Array(JSON_Int(g_family_system_car[i][FS_SQL_ID])));
        }
    }

    JSON_SetArray(json, "n", nArray);
    JSON_SetArray(json, "id", idArray);

    OnPacketIncoming(playerid, 45, json);
    return 1;
}

stock FamilySystemSendCarInfo(playerid, Node:json)
{
    new family_id = FamilySystemGetPlayerFamily(playerid);

    new sql_id;
    if(!JSON_GetInt(json, "id", sql_id))
    {
        JSON_SetInt(json, "t", 2);
        JSON_SetInt(json, "s", 1);
        JSON_SetInt(json, "r", 1);
        JSON_SetInt(json, "d", 0);
        OnPacketIncoming(playerid, 45, json);
        return 0;
    }

    new idx = FamilySystemFindBySql(sql_id);
    if(idx == -1 || family_id == -1 || g_family_system_car[idx][FS_FAMILY_ID] != family_id)
    {
        JSON_SetInt(json, "t", 2);
        JSON_SetInt(json, "s", 1);
        JSON_SetInt(json, "r", 1);
        JSON_SetInt(json, "d", 0);
        OnPacketIncoming(playerid, 45, json);
        return 0;
    }

    JSON_SetInt(json, "t", 2);
    JSON_SetInt(json, "s", 1);
    JSON_SetInt(json, "r", g_family_system_car[idx][FS_ACCESS_RANK]);
    JSON_SetInt(json, "d", g_family_system_car[idx][FS_STATUS]);
    OnPacketIncoming(playerid, 45, json);
    return 1;
}

stock FamilySystemSendActionResult(playerid, Node:json, success)
{
    JSON_SetInt(json, "t", 2);
    JSON_SetInt(json, "s", 2);
    JSON_SetInt(json, "d", success ? 1 : 0);
    OnPacketIncoming(playerid, 45, json);
    return 1;
}

stock FamilySystemHandleCarAction(playerid, Node:json)
{
    new family_id = FamilySystemGetPlayerFamily(playerid);

    new sql_id, action_id;
    if(!JSON_GetInt(json, "m", sql_id) || !JSON_GetInt(json, "id", action_id))
    {
        return FamilySystemSendActionResult(playerid, json, 0);
    }

    new idx = FamilySystemFindBySql(sql_id);
    if(idx == -1 || family_id == -1 || g_family_system_car[idx][FS_FAMILY_ID] != family_id)
    {
        return FamilySystemSendActionResult(playerid, json, 0);
    }

    new query[160];

    switch(action_id)
    {
        case 1, 5, 6:
        {
            g_family_system_car[idx][FS_STATUS] = 1;
            mysql_format(mysql, query, sizeof query,
                "UPDATE familysystem SET status = 1 WHERE id = %d LIMIT 1",
                g_family_system_car[idx][FS_SQL_ID]);
            mysql_query(mysql, query, false);
        }
        case 4:
        {
            g_family_system_car[idx][FS_STATUS] = 0;
            mysql_format(mysql, query, sizeof query,
                "UPDATE familysystem SET status = 0 WHERE id = %d LIMIT 1",
                g_family_system_car[idx][FS_SQL_ID]);
            mysql_query(mysql, query, false);
        }
        case 2:
        {
            mysql_format(mysql, query, sizeof query,
                "DELETE FROM familysystem WHERE id = %d LIMIT 1",
                g_family_system_car[idx][FS_SQL_ID]);
            mysql_query(mysql, query, false);
            FamilySystemResetSlot(idx);
            if(g_family_system_loaded > 0) g_family_system_loaded--;
        }
        case 3:
        {
            new access;
            if(JSON_GetInt(json, "r", access))
            {
                if(access == 0 && g_family_system_car[idx][FS_ACCESS_RANK] > 1)
                    g_family_system_car[idx][FS_ACCESS_RANK]--;
                else if(access == 1 && g_family_system_car[idx][FS_ACCESS_RANK] < 10)
                    g_family_system_car[idx][FS_ACCESS_RANK]++;
            }

            mysql_format(mysql, query, sizeof query,
                "UPDATE familysystem SET access_rank = %d WHERE id = %d LIMIT 1",
                g_family_system_car[idx][FS_ACCESS_RANK],
                g_family_system_car[idx][FS_SQL_ID]);
            mysql_query(mysql, query, false);
        }
        case 0, 7:
        {
        }
        default:
        {
            return FamilySystemSendActionResult(playerid, json, 0);
        }
    }

    return FamilySystemSendActionResult(playerid, json, 1);
}

CMD:testfamilybuy(playerid, params[])
{
    if(FamilySystemGetPlayerFamily(playerid) == -1)
        return SendClientMessage(playerid, 0xCECECEFF, "You are not in a family");

    if(GetPlayerData(playerid, P_FAMILY_RANK) < 10 && GetPlayerRangFamily(playerid) != 5)
        return SendClientMessage(playerid, 0xCECECEFF, "Only family leader can use /testfamilybuy");

    new ownable_car_id;
    if(sscanf(params, "d", ownable_car_id))
        ownable_car_id = 0;

    if(ownable_car_id > 0)
        return FamilySystemAddOwnableCarBySql(playerid, ownable_car_id);

    new vehicleid = GetPlayerOwnableCar(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0xCECECEFF, "Sit in your own car or use: /testfamilybuy [id]");

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    return FamilySystemAddOwnableCarToFamily(
        playerid,
        GetOwnableCarData(index, OC_SQL_ID),
        GetOwnableCarData(index, OC_MODEL_ID)
    );
}
