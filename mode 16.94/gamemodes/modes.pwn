CMD:bomboxbuy(playerid)
{
	if(GetPlayerDonateRub(playerid) >= 1000)
						{
						    if(GetPlayerData(playerid, P_BOOMBOX) >= 1) return ShowNotificationNew(playerid, 2, 4, 0, 0, "    !", "");

							GivePlayerDonateRub(playerid, -1000, " ");

                            ShowNotificationNew(playerid, 3, 4, 0, 0, "   (/boombox)", "");

							SetPlayerData(playerid, P_BOOMBOX, 1);
							UpdatePlayerDatabaseInt(playerid, "boombox", 1);
						
						}
					else ShowNotificationNew(playerid, 2, 4, 0, 0, " !", "");
						
	
	return 1;
						    
}
