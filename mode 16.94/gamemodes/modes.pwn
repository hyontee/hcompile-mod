		//1 

	    case 1:

	    {

	        DestroyObject(SvetforsColor[i]);

	    	SvetforsColor[i] = CreateObject(929, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);

	    	SetTimerEx("SvetforsChangeColor", 3000, false, "ddd", i, 2, 1);

	    }

		//2 

	    case 2:

	    {

	        if(warn == 1) // - 

	        {

		        DestroyObject(SvetforsColor[i]);

		    	SvetforsColor[i] = CreateObject(928, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);

		    	SetTimerEx("SvetforsChangeColor", 10000, false, "ddd", i, 3, 0);

			}
					else // - 

			{

		        DestroyObject(SvetforsColor[i]);

		    	SvetforsColor[i] = CreateObject(930, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);

		    	SetTimerEx("SvetforsChangeColor", 10000, false, "dd", i, 1, 0);

			}

	    }

		//3 

	    case 3:

	    {

	        DestroyObject(SvetforsColor[i]);

	    	SvetforsColor[i] = CreateObject(929, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);

	    	SetTimerEx("SvetforsChangeColor", 3000, false, "dd", i, 2, 2);

	    }

	}

	

}

CMD:mat(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 4) return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");


	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC": /mat [ID ]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	return ShowNotificationNew(playerid, 2, 4, 0, 0, "  ", "");

	new mute_time = 30;
	if(GetPlayerData(to_player, P_MUTE) > 0) return SendClientMessage(playerid, 0xCECECEFF, ""SC"     ");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"      ");

	if(AntiSliv(playerid, "/mat")) return true;

	new fmt_msg[999];
	format(fmt_msg, sizeof fmt_msg, " %s     %s  %d ", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), mute_time);

	format(fmt_msg, sizeof fmt_msg, "%s. :    ", fmt_msg);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SetPlayerData(to_player, P_MUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "mute", mute_time * 60);

	SendClientMessage(to_player, 0xCECECEFF, ""SC"    : {CCCC00}/time");
	SendClientMessage(to_player, 0xCECECEFF, ""SC"    ,     .");
	ShowNotificationNew(to_player, 2, 3, 0, 0, "{FFFFFF}    .  \n{FFFFFF}: {CCCC00}/time", "");

	format(fmt_msg, sizeof fmt_msg, " %s[acc:%d]    %d . :    ",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

