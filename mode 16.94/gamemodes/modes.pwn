	return ShowNotificationNew(playerid, 2, 4, 0, 0, "  ", "");
	new mute_time = 30;
	//if(!(1 <= mute_time <= 360)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"     1    360 ");
	if(GetPlayerData(to_player, P_MUTE) > 0) return SendClientMessage(playerid, 0xCECECEFF, "     ");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "       ");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, ""SC"    ");
	if(AntiSliv(playerid, "/flood")) return true;
	new fmt_msg[999];
	format(fmt_msg, sizeof fmt_msg, " %s     %s  %d ", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), mute_time);
	format(fmt_msg, sizeof fmt_msg, "%s. : ", fmt_msg);
	SendClientMessageToAll(0xFF5533FF, fmt_msg);
	SetPlayerData(to_player, P_MUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "mute", mute_time * 60);
	SendClientMessage(to_player, 0xCECECEFF, ""SC"    : {CCCC00}/time");
	SendClientMessage(to_player, 0xCECECEFF, ""SC"    ,     .");
	ShowNotificationNew(to_player, 2, 3, 0, 0, "{FFFFFF}    .  \n{FFFFFF}: {CCCC00}/time", "");
	format(fmt_msg, sizeof fmt_msg, " %s[acc:%d]    %d . : ",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);
	return 1;
}

