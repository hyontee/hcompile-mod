{
    SetTimer("CREATE_ACCOUNTS_TABLE_WP", 3000, false);
    SetTimer("CheckWeeklyPrizes", 5000, true);

    print("[KRANIN_SYSTEM]    .");

    #if defined weekly_OnGameModeInit
        return weekly_OnGameModeInit();
    #else
