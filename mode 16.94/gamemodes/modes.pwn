if(dialogid == 8968) //
{
        if(response)
        {
                if(!strlen(inputtext)) //   ,       ,  
                {
                        ShowPlayerDialog(playerid,8968,DIALOG_STYLE_INPUT,"{00FFFF}"SERVER_NAME"{FFFFFF} |    ","   ,    \n      :","","");
                        return 1;
                }
  if(strval(inputtext))  //      
                {
                         new nrbpack = strval(inputtext); //            
                         new veh = GetPlayerOwnableCar(playerid);
                         
                         for(new i = 0; i < MAX_PLAYERS; i++)
		  {
          if(IsPlayerInVehicle(i, veh))

          SetPlayerVirtualWorld(i, 101);
          SetPlayerInterior(i, 1);
          SetCameraBehindPlayer(i);
          }
                         
          new rand = random(sizeof(gVezd));
