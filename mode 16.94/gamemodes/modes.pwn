          format(info, sizeof info, "{FFFFFF}%s\n{2BB1FF} :{FFFFFF} %s\n{2BB1FF}  :{FFFFFF} %d\n{2BB1FF} :{FFFFFF} %d \n{2BB1FF} :{FFFFFF} %d \n\n   {ffff00}/buycar", GetVehicleName(veh), GetPlayerNameEx(playerid), GetPlayerPhone(playerid), nrbpack, GetVehicleInfo(modelid - 400, VI_PRICE));
            CreateVehicleLabel(veh, info, 0x2BB1FFFF, x, y, z + 1, 5.0);
            }
            
            new ownable_index = GetVehicleData(veh, V_ACTION_ID);
            if(ownable_index < 0) return SendClientMessage(playerid, 0xFF6600FF, "     ");
            SetOwnableCarData(ownable_index, OC_LAST_PRICE, nrbpack);
            SetOwnableCarData(ownable_index, OC_LAST_OWNER_GAME_ID, playerid);
            
            SetTimerEx("tp_buy", 500, false, "d", playerid);
		
