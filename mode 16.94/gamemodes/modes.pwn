			Dialog
			(
				playerid, DIALOG_MP_CREATE, DIALOG_STYLE_INPUT,
				" ",
				"{FFFFFF}   \n"\
				"    :\n\n"\
				"{33CC66}: , \n\n"\
				"{888888}:\n"\
				"{FFFFFF}-     1  30 \n"\
				"-   1.000.000  10.000.000 ()",
				"", ""
			);
		}
					else
		{
			new fmt_str[1026];

		    format(fmt_str, sizeof fmt_str, \
			"{ffff00}1. {FFFFFF}: {ffff00}%s\n"\
			"{ffff00}2. {FFFFFF}: {3399FF}$%d\n"\
			"{ffff00}3. {FFFFFF}  \n"\
			"{ffff00}4. {FFFFFF}%s \n"\
			"{ffff00}5. {FFFFFF} \n"\
