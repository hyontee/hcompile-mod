    result = mysql_query(mysql, query, true);

    if (cache_num_rows(result))
    {
        new name[32];
        cache_get_field_content(0, "name", name);
        shet = GetFamilyData(fam_id, F_OCKIFARMA);

format(fmt_msg, sizeof fmt_msg, "{ffff00} \n  {ffffff}   : \n{%06x} %s",family_colors[GetFamilyData(GetPlayerData(playerid, P_FAMILY), F_COLOR)] >>> 8,name);
vishka1 = Create3DTextLabel("    1\n   ", COLOR_RED, 2323.015136,-264.258728,1.538782+1.8, 25.0 , 0, 1);
Update3DTextLabelText (vishka1, COLOR_RED,fmt_msg);
}
}
