CMD:gevent(playerid, params[])
{
	if(!mp[MP_CREATE]) return SendClientMessage(playerid, 0xCECECEFF, "  ");

	if(!mp[MP_POS_X]) return SendClientMessage(playerid, 0xCECECEFF, "   ");

