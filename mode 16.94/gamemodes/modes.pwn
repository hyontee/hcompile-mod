};

enum STRUCT_AUCTION_PANEL
{
    bool:show_panel,
    count_list,
    select_slot,
    select_type,
    select_tab,
    filter_min_price,
    filter_max_price,
    filter_type,
    filter_tovar_type,
    filter_vehicle_model,
    bool:type_tovar, 
    bool:price_tovar, 
    bool:opisanie_tovar, 
    bool:tovar,
}

stock AuctionDatabaseExecuteAffected(query[])
{
    new Cache:result = mysql_query(mysql, query, true);
    if(mysql_errno())
    {
        cache_delete(result);
        return 0;
    }

    new affected = cache_affected_rows();
    cache_delete(result);
    return affected > 0;
}
stock AuctionBid_ReserveDatabaseUpdate(slot, rate, old_rate, bidder_account_id, bidder_name[])
{
    if(auction_slot[slot][AUCTION_DB_ID] <= 0) return 1;

    new query[512], Cache:result;
    mysql_format(mysql, query, sizeof query,
        "UPDATE auction_lots SET current_price=%d,highest_bidder_account_id=%d,highest_bidder_name='%e' WHERE id=%d AND status='active' AND ends_at>%d AND current_price=%d AND highest_bidder_account_id=%d",
        rate, bidder_account_id, bidder_name, auction_slot[slot][AUCTION_DB_ID], gettime(),
        auction_slot[slot][CURRENT_RATE], old_rate);
    result = mysql_query(mysql, query, true);
    if(mysql_errno())
    {
        cache_delete(result);
        return 0;
    }

    new affected = cache_affected_rows();
    cache_delete(result);
    return affected == 1;
}
stock AuctionBid_RollbackDatabaseUpdate(slot, rate, bidder_account_id, old_rate, old_bidder_account_id)
{
    if(auction_slot[slot][AUCTION_DB_ID] <= 0) return 1;

    new query[384], Cache:result;
    mysql_format(mysql, query, sizeof query,
        "UPDATE auction_lots SET current_price=%d,highest_bidder_account_id=%d,highest_bidder_name='' WHERE id=%d AND status='active' AND current_price=%d AND highest_bidder_account_id=%d",
        auction_slot[slot][CURRENT_RATE], old_bidder_account_id, auction_slot[slot][AUCTION_DB_ID], rate, bidder_account_id);
    result = mysql_query(mysql, query, true);
    if(mysql_errno())
    {
        cache_delete(result);
        return 0;
    }

    new affected = cache_affected_rows();
    cache_delete(result);
    return affected == 1;
}

