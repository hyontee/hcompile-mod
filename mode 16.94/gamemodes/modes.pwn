				}
			}
			// -----------------------------------------------------------------
			case DIALOG_PAY_FOR_RENT:
			{
				if(response)
				{
					new buffer = -1;
					switch(listitem + 1)
					{
						case 1: //   
						{
							buffer = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
							if(
								buffer != -1
								|| GetHouseNewByOwner(GetPlayerAccountID(playerid), playerid) != -1
								|| GetFlatNewByOwner(GetPlayerAccountID(playerid), playerid) != -1
							)
							{
								ShowPlayerHousePayForRent(playerid);
								return 1;
							}
					else SendClientMessage(playerid, 0x999999FF, "   ");
						}
						case 2: //   
						{
							buffer = GetPlayerBusiness(playerid);
							if(buffer != -1)
							{
								callcmd::paybizrent(playerid, "");
