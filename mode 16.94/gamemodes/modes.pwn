	if(checkpointid == markerhelp1)
	{
		callcmd::help(playerid, "");
	}
					else if(checkpointid == driving_exam_CP)
	{
		Dialog
		(
			playerid, DIALOG_DRIVING_EXAM_INFO, DIALOG_STYLE_MSGBOX,
