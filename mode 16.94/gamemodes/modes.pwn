CMD:disarm(playerid, params[])
{
    if(!strcmp(params, "all", true))
    {
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i))
                ResetPlayerWeapons(i);
                
        SendClientMessageToAll(-1, "     .");
        return 1;
    }
    
    ResetPlayerWeapons(playerid);
    SendClientMessage(playerid, -1, "     .");
    return 1;
}

