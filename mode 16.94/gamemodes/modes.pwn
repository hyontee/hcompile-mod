    ShowPlayerGUI(playerid, 40, json);
    JSON_Cleanup(json);
    return 1;
}

forward CheckWoundTimer();
public CheckWoundTimer()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && GetPVarInt(i, "WoundActive") == 1)
        {
            new timer = GetPVarInt(i, "WoundTimer");
            new remaining = timer - gettime();
            
            if(remaining <= 0)
            {
                SpawnPlayerToHospital(i);
                SetPVarInt(i, "WoundActive", 0);
            }
        }
    }
    return 1;
}

// ==========================================
//  GUI   
// ==========================================

public OnPlayerReceiveGUIResponse(playerid, guiid, Node:json)
{
    if(guiid == 40)
    {
        if(json == Node:0) return 1;
        
        new action_type;
        JSON_GetInt(json, "t", action_type);
        
        if(action_type == 2) // " "
        {
            SpawnPlayerToHospital(playerid);
            SetPVarInt(playerid, "WoundActive", 0);
            SetPVarInt(playerid, "WoundHospital", 1);
            JSON_Cleanup(json);
        }
        else if(action_type == 1) // ""
        {
            JSON_Cleanup(json);
            SendClientMessage(playerid, 0xFFFFFF, "      30 ");
        }
        
        return 1;
    }
    return 0;
}