					else {
				format(query, sizeof query, "UPDATE accounts SET `fuel_st`=-1 WHERE `id`=%d LIMIT 1", owner_id);
				mysql_query(mysql, query, false);
			}

			SetFuelStationData(i, FS_OWNER_ID, 0);
