						if(3 <= strlen(inputtext) <= 15)
						{
							utf8_to_cp1251(inputtext);
							format(g_fuel_station[stationid][FS_NAME], 20, inputtext, 0);
							UpdateFuelStationLabel(stationid);

							SendClientMessage(playerid, 0x66CC00FF, "   ");
