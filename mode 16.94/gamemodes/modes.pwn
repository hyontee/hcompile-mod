CMD:delveh(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 4 && GetPlayerYouTubeEx(playerid) < 1) 
        return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");

    if(PlayerVehicleCount[playerid] == 0)
        return SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff}     .");

    new slot;
    if(sscanf(params, "i", slot))
    {
        new info[256];
        format(info, sizeof(info), "{ffff00}|{ffffff} : /delveh [ 1-%d]", PlayerVehicleCount[playerid]);
        SendClientMessage(playerid, 0xCECECEFF, info);
        
        //    
        SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff}   :");
        for(new i = 0; i < PlayerVehicleCount[playerid]; i++)
        {
            if(IsValidVehicle(PlayerCreatedVehicles[playerid][i]))
            {
                new model = GetVehicleModel(PlayerCreatedVehicles[playerid][i]);
                format(info, sizeof(info), " %d: ID %d,  %d,  %s %s", 
                    i+1, PlayerCreatedVehicles[playerid][i], model, 
                    g_VehicleNumberPlate[PlayerCreatedVehicles[playerid][i]], 
                    g_VehicleRegion[PlayerCreatedVehicles[playerid][i]]);
                SendClientMessage(playerid, 0x999999FF, info);
            }
					else
            {
                format(info, sizeof(info), " %d: ", i+1);
                SendClientMessage(playerid, 0x999999FF, info);
            }
        }
        return 1;
    }

    if(slot < 1 || slot > PlayerVehicleCount[playerid])
    {
        new info[128];
        format(info, sizeof(info), "{ffff00}|{ffffff}    1  %d", PlayerVehicleCount[playerid]);
        return SendClientMessage(playerid, 0xCECECEFF, info);
    }

    //   (  1-5,   0-4)
    slot--;

    if(!IsValidVehicle(PlayerCreatedVehicles[playerid][slot]))
        return SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff}      .");

    //  
    DestroyVehicle(PlayerCreatedVehicles[playerid][slot]);
    
    //  
    for(new i = slot; i < PlayerVehicleCount[playerid] - 1; i++)
    {
        PlayerCreatedVehicles[playerid][i] = PlayerCreatedVehicles[playerid][i+1];
    }
    
    //      
    PlayerCreatedVehicles[playerid][PlayerVehicleCount[playerid] - 1] = 0;
    PlayerVehicleCount[playerid]--;

    new fmt_text[128];
    format(fmt_text, sizeof(fmt_text), "{ffff00}|{ffffff}   .    %d/5 .", PlayerVehicleCount[playerid]);
    SendClientMessage(playerid, 0xCECECEFF, fmt_text);

    // 
    format(fmt_text, sizeof(fmt_text), "[A] %s[%d]    ( %d)", 
        GetPlayerNameEx(playerid), playerid, slot+1);
    SendMessageToAdmins(fmt_text, 0x999999FF);

    return 1;
}


CMD:reset_cash(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");
	//else if(admin_logged[playerid] == false) return SendClientMessage(playerid, 0x999999FF, "  ,    /alogin");

	extract params -> new to_player, cash; else return SendClientMessage(playerid, 0xCECECEFF, ": /reset_cash [ID ] [c]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationNew(playerid, 2, 4, 0, 0, "  ", "");

	new reason[999];
	new fmt_msg[999];
	format(reason, sizeof reason, "{1E90FF} %s[%d]   ", GetPlayerNameEx(playerid), playerid);
	GivePlayerMoneyEx(to_player, -cash, reason, true, true);
	SendClientMessage(to_player, 0x66CC00FF, reason);
	
    format(fmt_msg, sizeof fmt_msg, "[A] %s[%d]    %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
    SendMessageToAdmins(fmt_msg, 0x999999FF);	

	format(reason, sizeof reason, "{1E90FF}  %s %d ", GetPlayerNameEx(to_player), cash);
	SendClientMessage(playerid, 0x66CC00FF, reason);

	format(reason, sizeof reason, " %s[%d] %d ", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), cash);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, reason);
	return 1;
}

CMD:reset_donate(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");
	//else if(admin_logged[playerid] == false) return SendClientMessage(playerid, 0x999999FF, "  ,    /alogin");

	extract params -> new to_player, donate; else return SendClientMessage(playerid, 0xCECECEFF, ": /reset_donate [ID ] [c]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationNew(playerid, 2, 4, 0, 0, "  ", "");

	new reason[999];
	new fmt_msg[999];
	format(reason, sizeof reason, "{1E90FF} %s[%d]   ", GetPlayerNameEx(playerid), playerid);
	GivePlayerDonateRub(to_player, -donate, reason, true, true);
	SendClientMessage(to_player, 0x66CC00FF, reason);
	
    format(fmt_msg, sizeof fmt_msg, "[A] %s[%d]    %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
    SendMessageToAdmins(fmt_msg, 0x999999FF);		

	format(reason, sizeof reason, "{1E90FF}  %s %d ", GetPlayerNameEx(to_player), donate);
	SendClientMessage(playerid, 0x66CC00FF, reason);

	format(reason, sizeof reason, " %s[%d] %d ", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), donate);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, reason);
	return 1;
}

CMD:givevip(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return SendClientMessage(playerid, 0xCECECEFF, "       ");
	extract params -> new to_player, premium, days; else return SendClientMessage(playerid, 0xCECECEFF, ": /givevip [ID ] [ -] [ ( )]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "  ");

	if(!(1 <= premium <= 3)) return SendClientMessage(playerid, 0x999999FF, " -  1  3 ( ,  - : 0)");

	if(!(0 <= days <= 30)) return SendClientMessage(playerid, 0x999999FF, "   0  30");

	new fmt_msg[999];

	new premium_rank[3][17] =
	{
		"{C0C0C0}Silver",
		"{FFD700}Gold",
		"{E5E4E2}Platinum"
	};

	new premium_expires = gettime() + days * 86400;
	SetPlayerData(to_player, P_PREMIUM, premium);
	SetPlayerData(to_player, P_PREMIUM_DATE, premium_expires);
	SetPlayerData(to_player, P_PREMIUM_TIME, premium_expires);
	SetPlayerData(to_player, P_PREMIUM_CHAT, 1);

	UpdatePlayerDatabaseInt(to_player, "premium", premium);
	UpdatePlayerDatabaseInt(to_player, "premium_date", premium_expires);
	UpdatePlayerDatabaseInt(to_player, "premium_time", premium_expires);

	format(fmt_msg, sizeof fmt_msg, "%s   %s {3399FF}-  %d .", GetPlayerNameEx(playerid), premium_rank[premium - 1], days);
	SendClientMessage(to_player, 0x3399FFFF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "  %s %s {3399FF}-  %d .", GetPlayerNameEx(to_player), premium_rank[premium - 1], days);
	SendClientMessage(playerid, 0x3399FFFF, fmt_msg);


	return 1;
}

CMD:epoints(playerid)
{
	if(GetPlayerAdminEx(playerid) < 1) return 0;

	new fmt_str[300];

	format(str, sizeof str, "{00FFFF}"SERVER_NAME"{ffffff} | : {FFFF00}%d", GetPlayerData(playerid, P_ACOINS));
	 
	Dialog
		(
			playerid, DIALOG_ADMSHOP, DIALOG_STYLE_LIST, 
			str, 		
			"{FFFF00} #1 {FFFFFF} \t\t\t\t\t {888888}   \n"\
