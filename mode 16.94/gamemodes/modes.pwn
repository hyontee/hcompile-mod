			"{FFFF00} #3 {FFFFFF} \t\t\t\t\t {888888}   \n"\
			"{FFFF00} #4 {FFFFFF}\t\t\t\t\t {888888}   \n"\
			"{FFFF00} #5 {FFFFFF} \t\t\t\t\t {888888}   ",
			"", ""
		);
