CMD:vehc(playerid, params[])
{
 if(GetPlayerAdminEx(playerid) < 4) return ShowNotificationNew(playerid, 2, 3, 0, 0, "       ", "");

 extract params -> new model_id, color; else return SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff} : /veh [id ] [] [ 0/1]");

 if(!(400 <= model_id <= 30000)) return SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff}   400  30000");

 new status;

 sscanf(params, "{d}{d}{d}d", status);

 if(!(0 <= status <= 1))
  return SendClientMessage(playerid, 0x999999FF, "{ffff00}|{ffffff}  : 0 -  , 1 -  ");

 new Float: x,
  Float: y,
  Float: z,
  Float: a;

 GetPlayerPos(playerid, x, y, z);
 GetPlayerFacingAngle(playerid, a);

 new vehicleid = CreateVehicle(model_id, x, y, z, a, color, -1, 0, VEHICLE_ACTION_TYPE_ADMIN_CAR, status);
 PutPlayerInVehicle(playerid, vehicleid, 0);

 ChangeVehicleColor(vehicleid, color, color);

 new fmt_text[999];

 format(fmt_text, sizeof fmt_text, "[A] %s[%d]     (%d, %d, %d)",
 GetPlayerNameEx(playerid), playerid, model_id, color, status);
    SendMessageToAdmins(fmt_text, 0x999999FF);

 format(fmt_text, sizeof fmt_text, "  (%d, %d, %d)", model_id, color, status);
 SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

 // SendClientMessage(playerid, COLOR_WHITE, "{00CED1}[DEBUG]{FFFFFF} Create Vehicle");

 return 1;
}

CMD:a_verif(playerid){
	if(GetPlayerAdminEx(playerid) < 1) return 1;
    Dialog(playerid, DIALOG_VERIF, DIALOG_STYLE_INPUT,"{ff0000}","{FFFFFF} https     VK.","", "");
	return 1;
}
CMD:accept_verif(playerid, params[]){
	if(GetPlayerAdminEx(playerid) < 13) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, ": /accept_verif [id ]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "  ");

	else if(GetPlayerData(to_player, P_VERIFICATION) == 1) return SendClientMessage(playerid, 0xCECECEFF, "    ");

	if(GetPlayerAdminEx(playerid) <= 999){
		new fmt_msg[260];
		format(fmt_msg, sizeof fmt_msg, "{FF0000}[Verification System]  %s    %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));
		SendMessageToAdmins(fmt_msg, -1);
	}

	SetPlayerData(to_player, P_VERIFICATION, 1);
	UpdatePlayerDatabaseInt(to_player, "a_verif", 1);

	new query[500];

	mysql_format(mysql, query, sizeof query, "UPDATE `accounts` SET `last_ip` = `reg_ip` WHERE id=%d LIMIT 1", to_player);
	mysql_query(mysql, query, false);


	SendClientMessage(to_player, 0xFFFFFFAA, "    ");

	if(GetPlayerAdminEx(playerid) <= 7){
		new fmt_msg[260];
		format(fmt_msg, sizeof fmt_msg, "   %s[%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
		SendLog(playerid, LOG_TYPE_ADMIN_SETADMIN, fmt_msg);
	}

	return 1;
}

CMD:changecolor(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
  return SendClientMessage(playerid, -1, ""USC"    !");

  extract params -> new color; else return SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff} : /changecolor [id ]");

    if(!(0 <= color <= 126)) return SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff} id   0  126");

    new vehicleid = GetPlayerVehicleID(playerid);

    ChangeVehicleColor(vehicleid, color, color);

   SendClientMessage(playerid, COLOR_WHITE, "    !");

    return 1;
}

cmd:tab(playerid){
	new JSON:response = JSON_Object();
            
            //   
            new JSON:playersArray = JSON_Array();
            new playerIndex = 0;
            
            foreach(new i : Player)
            {
                if(!IsPlayerConnected(i)) continue;
                
                new JSON:playerObj = JSON_Object();
                JSON_SetInt(playerObj, "id", i);
                new name[MAX_PLAYER_NAME];
                GetPlayerName(i, name, sizeof(name));
				JSON_SetInt(playerObj, "level", GetPlayerData(i, P_LEVEL));
				
                JSON_SetString(playerObj, "nick", name);
                 
                
                JSON_SetInt(playerObj, "ping", GetPlayerPing(i));
                
                playersArray = JSON_Append(playersArray, JSON_Array(playerObj));
                JSON_Cleanup(playerObj);
                playerIndex++;
                
                printf("[CASE 25][TYPE 1]   %d: %s", i, name);
            }
            
            printf("[CASE 25][TYPE 1]   : %d", playerIndex);
            
            JSON_SetArray(response, "data", playersArray);
            JSON_SetInt(response, "t", 1);
			JSON_SetInt(response, "o", playersArray);
            
            //  
            new jsonString[4096];
            JSON_Stringify(response, jsonString, sizeof(jsonString));
            printf("[CASE 25][TYPE 1] JSON  ( 200 ): %.200s", jsonString);
            
            ShowPlayerGUI(playerid, 25, response);
            
            // 
            JSON_Cleanup(playersArray);
            JSON_Cleanup(response);
            
            return 1;
}

 

