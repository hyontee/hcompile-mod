#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <string>
#include <sampgdk/sampgdk.h>
#include <sampgdk/plugin.h>

#define SERVER_IP "185.207.214.14"
#define SERVER_PORT 2893

PLUGIN_EXPORT bool PLUGIN_CALL Load(void **ppData)
{
    sampgdk::SetAll(ppData);
    return true;
}

PLUGIN_EXPORT void PLUGIN_CALL Unload()
{
}

static cell AMX_NATIVE_CALL n_CheckLicense(AMX *amx, cell *params)
{
    char bind_addr[32];
    int port;
    
    if(!sampgdk::GetServerVarAsString("bind", bind_addr, sizeof(bind_addr)))
        return 0;
    
    port = sampgdk::GetServerVarAsInt("port");
    
    if(strcmp(bind_addr, SERVER_IP) == 0 && port == SERVER_PORT)
        return 1;
    
    return 0;
}

static AMX_NATIVE_INFO natives[] = 
{
    {"CheckLicense", n_CheckLicense},
    {NULL, NULL}
};

PLUGIN_EXPORT int PLUGIN_CALL AmxLoad(AMX *amx)
{
    return amx_Register(amx, natives, -1);
}

PLUGIN_EXPORT int PLUGIN_CALL AmxUnload(AMX *amx)
{
    return AMX_ERR_NONE;
}

BOOL APIENTRY DllMain(HMODULE hModule, DWORD ul_reason_for_call, LPVOID lpReserved)
{
    return TRUE;
}