stock RaceStyling_GetVehiclePriceForGUI(vehicleid)
{
    new modelid = GetVehicleData(vehicleid, V_MODELID);
    new price;
    GetVehicleJsonCostByModelId(modelid, price);
    if(price <= 0) price = 100000;
    return price;
}

stock RaceStyling_IsOwnableDriverVehicle(playerid, &vehicleid, &idx)
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, -1, "{FF5252}| {FFFFFF}Вы должны находиться в автомобиле!");

    vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
        return SendClientMessage(playerid, -1, "{FF5252}| {FFFFFF}Не удалось получить ID автомобиля!");

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, -1, "{FF5252}| {FFFFFF}Вы должны быть за рулем автомобиля!");

    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return SendClientMessage(playerid, -1, "{FF5252}| {FFFFFF}Доступно только на личном транспорте!");

    idx = GetVehicleData(vehicleid, V_ACTION_ID);
    if(idx < 0 || GetOwnableCarData(idx, OC_OWNER_ID) != GetPlayerAccountID(playerid))
        return SendClientMessage(playerid, -1, "{FF5252}| {FFFFFF}Вы должны быть за рулем своего личного транспорта!");

    return 1;
}

stock RaceStyling_SaveReturnPosition(playerid, vehicleid)
{
    GetVehiclePos(vehicleid, g_RaceStylingReturnPos[playerid][0], g_RaceStylingReturnPos[playerid][1], g_RaceStylingReturnPos[playerid][2]);
    GetVehicleZAngle(vehicleid, g_RaceStylingReturnPos[playerid][3]);
    g_RaceStylingReturnInterior[playerid] = GetPlayerInterior(playerid);
    g_RaceStylingReturnWorld[playerid] = GetPlayerVirtualWorld(playerid);
    g_RaceStylingInGUI[playerid] = true;
    return 1;
}

stock RaceStyling_RestoreReturnPosition(playerid, vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid)) return 0;

    if(g_RaceStylingInGUI[playerid])
    {
        SetVehiclePos(vehicleid, g_RaceStylingReturnPos[playerid][0], g_RaceStylingReturnPos[playerid][1], g_RaceStylingReturnPos[playerid][2]);
        SetVehicleZAngle(vehicleid, g_RaceStylingReturnPos[playerid][3]);
        SetPlayerInterior(playerid, g_RaceStylingReturnInterior[playerid]);
        SetVehicleVirtualWorld(vehicleid, g_RaceStylingReturnWorld[playerid]);
        SetPlayerVirtualWorld(playerid, g_RaceStylingReturnWorld[playerid]);
        g_RaceStylingInGUI[playerid] = false;
    }
    else
    {
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetVehicleVirtualWorld(vehicleid, 0);
    }
    return 1;
}

stock RaceStyling_OpenGUI(playerid, work_type)
{
    new vehicleid, idx;
    if(!RaceStyling_IsOwnableDriverVehicle(playerid, vehicleid, idx)) return 1;

    new modelid = GetVehicleData(vehicleid, V_MODELID);
    new Node:tuning_json = JSON_Object();
    new car_name[64];
    new vw = playerid + 1000;

    g_TuningType[playerid] = work_type;
    RaceStyling_SaveReturnPosition(playerid, vehicleid);

    GetVehicleModelName(modelid, car_name, sizeof(car_name));

    JSON_SetInt(tuning_json, "o", 1);
    JSON_SetInt(tuning_json, "w", work_type == 0 ? 0 : (work_type == 1 ? 2 : 3));
    JSON_SetInt(tuning_json, "t", work_type == 0 ? 0 : 2);
    JSON_SetInt(tuning_json, "j", RaceStyling_GetVehiclePriceForGUI(vehicleid));
    JSON_SetInt(tuning_json, "s", 5);
    JSON_SetString(tuning_json, "nm", GetPlayerNameEx(playerid));
    JSON_SetString(tuning_json, "n", car_name);
    JSON_SetInt(tuning_json, "m", GetPlayerMoneyEx(playerid));

    SetPlayerVirtualWorld(playerid, vw);
    SetVehicleVirtualWorld(vehicleid, vw);
    SetPlayerInterior(playerid, 1);

    if(work_type == 0)
    {
        SetVehiclePos(vehicleid, 1000.0847, 1502.3265, 1497.5124);
        SetVehicleZAngle(vehicleid, 180.0);
        SetPlayerCameraPos(playerid, 1004.384033, 1497.215942, 1500.519287);
        SetPlayerCameraLookAt(playerid, 1001.266967, 1501.026733, 1499.646728);
    }
    else if(work_type == 1)
    {
        SetVehiclePos(vehicleid, 995.452331, 1001.766601, 1500.253295);
        SetVehicleZAngle(vehicleid, 180.0);
        SetPlayerCameraPos(playerid, 998.835937, 997.811462, 1501.182983);
        SetPlayerCameraLookAt(playerid, 995.605468, 1001.587646, 1501.734863);
    }
    else
    {
        SetVehiclePos(vehicleid, 996.1070, 999.4791, 1000.5);
        SetVehicleZAngle(vehicleid, -90.0);
        SetPlayerCameraPos(playerid, 1001.1626, 1002.8044, 1000.9689);
        SetPlayerCameraLookAt(playerid, 1000.3796, 1002.1858, 1001.0136);
    }

    TogglePlayerControllable(playerid, 0);
    ShowPlayerGUI(playerid, 28, tuning_json);
    JSON_Cleanup(tuning_json);
    return 1;
}
