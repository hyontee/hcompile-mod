stock GetVehicleNameByModel(modelid, dest[], size = 64)
{
    for(new i = 0; i < sizeof(VehicleInfo); i++)
    {
        if(VehicleInfo[i][vehicleModel] == modelid)
            return format(dest, size, "%s", VehicleInfo[i][vehicleName]);
    }
    format(dest, size, "ID %d", modelid);
    return 1;
}

stock GetVehiclePriceByModel(modelid)
{
    for(new i = 0; i < sizeof(VehicleInfo); i++)
        if(VehicleInfo[i][vehicleModel] == modelid)
            return VehicleInfo[i][vehiclePrice];
    return 1000000;
}

stock GetVehicleGovSellByModel(modelid)
{
    for(new i = 0; i < sizeof(VehicleInfo); i++)
        if(VehicleInfo[i][vehicleModel] == modelid)
            return VehicleInfo[i][vehicleGovSell];
    return 760000;
}

stock GetPlayerVehicleName(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid <= 0) return 0;
    new modelid = GetVehicleModel(vehicleid);
    new vehName[64], msg[160];
    GetVehicleNameByModel(modelid, vehName, sizeof(vehName));
    format(msg, sizeof(msg), "�� ������� ���������� %s.", vehName);
    SendClientMessage(playerid, 0xFFFFFFFF, msg);
    return 1;
}
