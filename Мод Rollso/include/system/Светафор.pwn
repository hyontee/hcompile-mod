new Float:redLightFine = 700;

// Функция для проверки, проехал ли водитель на красный свет
public OnPlayerPassedRedLight(playerid)
{
    // Здесь должна быть логика для определения, проехал ли игрок на красный свет
    // Например, можно использовать функции, которые проверяют состояние светофора и положение игрока
    // Если игрок проехал на красный свет, то вызываем функцию выдачи штрафа
    GiveFine(playerid);
}

// Функция для выдачи штрафа
public GiveFine(playerid)
{
    // Здесь должна быть логика для выдачи штрафа
    // Например, можно вычесть сумму штрафа из баланса игрока или добавить запись о штрафе в базу данных
    // В данном примере просто выводим сообщение о штрафе и вычитаем сумму штрафа из игрового баланса игрока
    new Float:playerBalance = GetPlayerMoney(700);
    if (playerBalance >= 700) {
        GivePlayerMoney);
        SendClientMessage(playerid, COLOR_RED, "Вам выписан штраф в размере "700" рублей за проезд на красный свет!");
    } else {
        SendClientMessage(playerid, COLOR_RED, "У вас недостаточно средств для оплаты штрафа!");
    }
}
