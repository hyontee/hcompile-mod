case DIALOG_OWNABLE_CAR_LOAD:
{
    if(response)
    {
        new oc_id = GetPVarInt(playerid, "ownablecar_id");
        new Float:x, Float:y, Float:z, Float:last_x, Float:last_y, Float:last_z;
        new Cache:result, query[100];

        if(oc_id <= 0)
            return SendClientMessage(playerid, 0x999999FF, "шибка: транспорт не найден");

        mysql_format(mysql, query, sizeof query, "SELECT pos_x, pos_y, pos_z, pos_x_last, pos_y_last, pos_z_last FROM ownable_cars WHERE id='%d'", oc_id);
        result = mysql_query(mysql, query, true);

        if(cache_num_rows())
        {
            x = cache_get_row_float(0, 0);
            y = cache_get_row_float(0, 1);
            z = cache_get_row_float(0, 2);

			last_x = cache_get_field_content_float(0, "pos_x_last");
            last_y = cache_get_field_content_float(0, "pos_y_last");
            last_z = cache_get_field_content_float(0, "pos_z_last");
        }
        cache_delete(result);

		printf("[DEBUG] ID авто: %d", oc_id);
        printf("[DEBUG] сновне координат (парковка): %f, %f, %f", x, y, z);
        printf("[DEBUG] оследние координат (сейчас): %f, %f, %f", last_x, last_y, last_z);
        printf("[DEBUG] асстоние до последних координат: %f", GetPlayerDistanceFromPoint(playerid, last_x, last_y, last_z));

        switch(listitem + 1)
        {
            case 1:
            {
                if(GetPlayerGPSInfo(playerid, G_ENABLED) == GPS_STATUS_OFF)
                {
                    if(GetPlayerMoneyEx(playerid) >= 300)
                    {
                        GivePlayerMoneyEx(playerid, -300, "етка  на GPS", true, true);
                        EnablePlayerGPS(playerid, 55, x, y, z, "естоположение ашего транспорта отмечено на GPS");

                    }
                    else SendClientMessage(playerid, 0x999999FF, "едостаточно денег");
                }
                else SendClientMessage(playerid, 0xCECECEFF, "а ашем GPS уже отмечено место");
            }

			case 2:
			{
				if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
                {
                    ShowNotificationSile(playerid, 3, 5, 1, 1, "ранспорт уже загружен!", "");
                    return 1;
                }

                if(!IsPlayerInRangeOfPoint(playerid, 40.0, last_x, last_y, last_z))
                {
                    ShowNotificationSile(playerid, 2, 5, 1, 1, " слишком далеко от вгрузки транспорта", "");
                    return 1;
                }

				if(IsPlayerInRangeOfPoint(playerid, 2.0, last_x, last_y, last_z))
                {
                	ShowNotificationSile(playerid, 2, 5, 1, 1, " слишком близко возле вгрузки транспорта", "");
                    return 1;
                }

				new vehicleid = LoadOwnableCarLastPos(oc_id);
                if(vehicleid != INVALID_VEHICLE_ID)
                {
                    PlayerOwnableCarInit(playerid);
                    ApplyVehicleNumberPlate(vehicleid);
					SyncVehicleTuningForPlayer(playerid, vehicleid);
                    SendClientMessage(playerid, 0x66CC33FF, "аш транспорт успешно загружен!");
					SetTimerEx("DelayedSyncVehicleTuning", 400, false, "dd", vehicleid, playerid);
            	}
                else SendClientMessage(playerid, 0x999999FF, "шибка при загрузке личного транспорта");

			}

            case 3:
            {
                if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
                {
                    SendClientMessage(playerid, 0x999999FF, "истемна ошибка. ранспорт уже загружен.");
                }
                else
                {
						if(!IsPlayerInRangeOfPoint(playerid, 40.0, x, y, z))
						{
							ShowNotificationSile(playerid, 2, 5, 1, 1, " слишком далеко от вгрузки транспорта", "");
							return 1;
						}

						if(IsPlayerInRangeOfPoint(playerid, 2.0, x, y, z))
						{
							ShowNotificationSile(playerid, 2, 5, 1, 1, " слишком близко возле вгрузки транспорта", "");
							return 1;
						}
                        new vehicleid = LoadOwnableCar(oc_id);
                        if(vehicleid != INVALID_VEHICLE_ID)
                        {
                            PlayerOwnableCarInit(playerid);
                            ApplyVehicleNumberPlate(vehicleid);
							SyncVehicleTuningForPlayer(playerid, vehicleid);
                            SendClientMessage(playerid, 0x66CC33FF, "аш транспорт успешно загружен!");
							SetTimerEx("DelayedSyncVehicleTuning", 400, false, "dd", vehicleid, playerid);
                        }
                        else SendClientMessage(playerid, 0x999999FF, "шибка при загрузке личного транспорта");
                    }
                }

			case 4:
			{
				new Float:new_pos_x = 2498.205810;
				new Float:new_pos_y = -742.256042;
				new Float:new_pos_z = 12.164166;
				new Float:new_angle = 356.240051;

				new query[512];
				mysql_format(mysql, query, sizeof(query),
    			"UPDATE `ownable_cars` SET \
    			`pos_x` = '%f', \
				`pos_y` = '%f', \
				`pos_z` = '%f' \
				WHERE `id` = '%d'",
				new_pos_x, new_pos_y, new_pos_z, oc_id);

				result = mysql_query(mysql, query, true);

				if(!cache_num_rows())
				{
					ShowNotificationSile(playerid, 3, 6, -1, -1, "арковка ашего автомобил успешно сброшена.", "");
				}
				else 
				{
					ShowNotificationSile(playerid, 2, 6, -1, -1, "шибка, попробуйте позже.", "");
				}
				cache_delete(result);
			}
        }
    }
    else
    {
        if(GetPVarInt(playerid, "show_menu"))
        {
            DeletePVar(playerid, "show_menu");
            callcmd::car(playerid, "");
        }
    }
    return 1;
}

			case DIALOG_OWNABLE_CAR_LIST:
			{
				if(response)
				{
					new up = GetPVarInt(playerid, "up_count"),
					down = GetPVarInt(playerid, "down_count");

					if(listitem == up || listitem == down)
					{
						new list = GetPVarInt(playerid, "count_list");

						if(listitem == up)  list++;
						else if(listitem == down) list--;
						SetPVarInt(playerid, "count_list", list);

						new fmt_text[4096],
						Cache: result,
						id;

						mysql_format(mysql, fmt_text, sizeof fmt_text, "SELECT * FROM ownable_cars WHERE owner_id='%d'", GetPlayerAccountID(playerid));
						result = mysql_query(mysql, fmt_text, true);

						new rows = cache_num_rows();

						new count_rows, count = 10 * GetPVarInt(playerid, "count_list");

						if(!(count - rows))
						{
							if(listitem == 10)
							{
								SendClientMessage(playerid, -1, ""USC"то последн страница.");
								return 1;
							}
						}

						if(rows >= count)
						{
							count_rows = count;
							SetPVarInt(playerid, "up_count", 10);
							SetPVarInt(playerid, "down_count", 11);
						}
						else
						{
							count_rows = rows;
							new p = count_rows - (count - 10);
							SetPVarInt(playerid, "down_count", p);
							SetPVarInt(playerid, "up_count", 10);
						}

						format(fmt_text, sizeof fmt_text, "");

						new query[196],
						model_id,
						car_number[8],
                        model_name[64];

                        for(new i = count-10, p; i < count_rows; i ++, p ++)
                        {
                            id = cache_get_field_content_int(i, "id");
                            model_id = cache_get_field_content_int(i, "model_id");
                            cache_get_field_content(i, "number", car_number);

                            GetVehicleModelName(model_id, model_name, sizeof(model_name));
                            format(query, sizeof query, "{FFFFFF}%d. %s {888888}[%s]\n", p + 1, model_name, car_number);

                            if(p >= sizeof(g_player_listitem[]))
                                break;

                            if(strlen(fmt_text) + strlen(query) >= sizeof(fmt_text) - 1)
                                break;

                            strcat(fmt_text, query);
                            SetPlayerListitemValue(playerid, p, id);
                        }

						if(rows >= count+1)
						{
							new buttom[21];
							format(buttom, sizeof buttom, "ледующа страница\n");
							strcat(fmt_text, buttom);

						}

						if(count >= 11)
						{
							new buttom_1[21];
							format(buttom_1, sizeof buttom_1, "реддуща страница");
							strcat(fmt_text, buttom_1);
						}

						Dialog
						(
							playerid, DIALOG_OWNABLE_CAR_LIST, DIALOG_STYLE_LIST,
							"{FFCD00}берите транспорт",
							fmt_text,
							"брат", "акрт"
						);

						cache_delete(result);

						return 1;
					}

					new idx = GetPlayerListitemValue(playerid, listitem);

					ShowOwnableCarLoadDialog(playerid, idx, true);
				}
			}
			case DIALOG_OWNABLE_CAR_SELL:
{
    if(response)
    {
        new vehicleid = GetPlayerOwnableCar(playerid);
