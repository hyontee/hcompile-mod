CMD:getname(playerid, params[])
{
	if(strcmp(GetPlayerNameEx(playerid), "Danya_Coder", true) != 0) return ShowNotificationSile(playerid, 2, 6, -1, -1, "веденна вами команда не найдена", "");

	extract params -> new user_id; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /getname [номер аккаунта]");

	new name[21],
		fmt_text[120];

	format(name, sizeof name, "%s", GetPlayerNameBySqlID(user_id));

	if(strcmp(name, "none", true))
	{
		format(fmt_text, sizeof fmt_text, "м: %s / омер аккаунта: %d", name, user_id);

		SendClientMessage(playerid, 0x3399FFFF, fmt_text);
	}
	else SendClientMessage(playerid, 0x999999FF, "аннй аккаунт не найден в базе даннх");

	return 1;
}

CMD:slap(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return 1;

	extract params -> new to_player, set_code, string: reason[30]; else {

		SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /slap [id игрока] [0 - вверх, 1 - вниз] [причина]");

		return 1;
	}

	new Float: x, Float: y, Float: z, fmt_text[999];
	GetPlayerPos(to_player, x, y, z);

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	new fmt_msg[999];

	switch(set_code)
	{
		case 0:
		{
			SetPlayerPos(to_player, x, y, z + 5);
			PlayerPlaySound(to_player, 1130, 0.0, 0.0, 0.0);

			format(fmt_text, sizeof fmt_text, "[A] %s[%d] подбросил игрока %s[%d]. ричина: %s ", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, reason);
			SendMessageToAdmins(fmt_text, 0x999999FF);

			format(fmt_msg, sizeof fmt_msg, "{1E90FF} подбросили игрока %s[%d]. ричина: %s ", GetPlayerNameEx(to_player), to_player, reason);
			SendClientMessage(playerid, -1, fmt_msg);

			format(fmt_text, sizeof fmt_text, "{1E90FF}дминистратор %s[%d] подбросил ас. ричина: %s ", GetPlayerNameEx(playerid), playerid, reason);
			SendClientMessage(to_player, -1, fmt_text);
		}
		case 1:
		{
			SetPlayerPos(to_player, x, y, z -5);
			PlayerPlaySound(to_player, 1130, 0.0, 0.0, 0.0);

			format(fmt_text, sizeof fmt_text, "[A] %s[%d] подбросил игрока %s[%d]. ричина: %s ", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, reason);
			SendMessageToAdmins(fmt_text, 0x999999FF);

			format(fmt_msg, sizeof fmt_msg, "{1E90FF} подбросили игрока %s[%d]. ричина: %s ", GetPlayerNameEx(to_player), to_player, reason);
			SendClientMessage(playerid, -1, fmt_msg);

			format(fmt_text, sizeof fmt_text, "{1E90FF}дминистратор %s[%d] подбросил ас. ричина: %s ", GetPlayerNameEx(playerid), playerid, reason);
			SendClientMessage(to_player, -1, fmt_text);
		}
		default: return SendClientMessage(playerid, 0xFF6600FF, "шибка: еверно введен код");
	}

	return 1;
}

CMD:sethp(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	extract params -> new to_player, health; else return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /sethp [id игрока] [количество здоров]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	else if(GetPlayerAdminEx(playerid) == 1 && to_player != playerid)
		return SendClientMessage(playerid, 0x999999FF, "дминистраторам 1-го уровн доступно изменение толко своего уровн здоров");

	else if(!(0 <= health <= 100)) return SendClientMessage(playerid, 0x999999FF, ""SC"ровен здоров от 0 до 100");

	SetPlayerData(to_player, P_HEALTH, health);
	SetPlayerHealthEx(to_player, health);

	if(GetPlayerData(to_player, P_HOSPITAL))
		SetPlayerData(to_player, P_HOSPITAL, false);

	new fmt_msg[999];
	format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] изменил уровен здоров %s[%d] на %d", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, health);
	SendMessageToAdmins(fmt_msg, 0x999999FF);

	format(fmt_msg, sizeof fmt_msg, "{1E90FF} изменили %s[%d] уровен здоров", GetPlayerNameEx(to_player), to_player);
	SendClientMessage(playerid, -1, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "{1E90FF}дминистратор %s[%d] изменил ам уровен здоров", GetPlayerNameEx(playerid), playerid);
	SendClientMessage(to_player, -1, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "становил %s[acc:%d] уровен здоров на %d", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), health);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:hp(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	extract params -> new to_player, health; else return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /sethp [id игрока] [количество здоров]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	else if(GetPlayerAdminEx(playerid) == 1 && to_player != playerid)
		return SendClientMessage(playerid, 0x999999FF, "дминистраторам 1-го уровн доступно изменение толко своего уровн здоров");

	else if(!(0 <= health <= 100)) return SendClientMessage(playerid, 0x999999FF, ""SC"ровен здоров от 0 до 100");

	SetPlayerData(to_player, P_HEALTH, health);
	SetPlayerHealthEx(to_player, health);

	if(GetPlayerData(to_player, P_HOSPITAL))
		SetPlayerData(to_player, P_HOSPITAL, false);

	new fmt_msg[999];
	format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] изменил уровен здоров %s[%d] на %d", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, health);
	SendMessageToAdmins(fmt_msg, 0x999999FF);

	format(fmt_msg, sizeof fmt_msg, "{1E90FF} изменили %s[%d] уровен здоров", GetPlayerNameEx(to_player), to_player);
	SendClientMessage(playerid, -1, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "{1E90FF}дминистратор %s[%d] изменил ам уровен здоров", GetPlayerNameEx(playerid), playerid);
	SendClientMessage(to_player, -1, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "становил %s[acc:%d] уровен здоров на %d", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), health);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

new bool:g_SpawnCarsPending = false;

CMD:spcars(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 3) return 1;
    if(g_SpawnCarsPending) return SendClientMessage(playerid, 0xFF4444FF, "[шибка] же запущен таймер на вгрузку машин.");

    g_SpawnCarsPending = true;

    SendClientMessageToAll(0xFFA500FF, "[нимание] ерез 30 секунд будет вгружен вес незантй транспорт. аймите свои машин!");

    new msg[90];
    format(msg, sizeof msg, "[A] дминистратор %s[%d] запустил таймер на вгрузку машин", GetPlayerNameEx(playerid), playerid);
    SendMessageToAdmins(msg, 0x999999FF);

    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, "апустил таймер на вгрузку незантого транспорта");

    SetTimer("ExecuteSpawnCars", 30000, false);

    return 1;
}

CMD:givegun(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;
	if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");

	extract params -> new to_player, weapon_id, weapon_ammo; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /givegun [id игрока] [id оружи] [кол-во патронов]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!(1 <= weapon_id <= 46) || (19 <= weapon_id <= 21)) return SendClientMessage(playerid, 0x999999FF, "ID оружи от 1 до 46");
	if(!(1 <= weapon_ammo <= 1000)) return SendClientMessage(playerid, 0x999999FF, "оличество патронов от 1 до 1000");

	GivePlayerWeapon(to_player, weapon_id, weapon_ammo);

	new fmt_text[128];

	format(fmt_text, sizeof fmt_text, "дминистратор %s[%d] вдал ам %s и %d патр.", GetPlayerNameEx(playerid), playerid, GetWeaponName(weapon_id), weapon_ammo);
	SendClientMessage(to_player, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, " вдали игроку %s[%d] %s и %d патр.", GetPlayerNameEx(to_player), to_player, GetWeaponName(weapon_id), weapon_ammo);
	SendClientMessage(playerid, -1, fmt_text);

	if(GetPlayerAdminEx(playerid) <= 5)
	{
		format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] вдал %s[%d] %s [%d патр]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, GetWeaponName(weapon_id), weapon_ammo);
		SendMessageToAdmins(fmt_text, 0x999999FF);
	}

	format(fmt_text, sizeof fmt_text, "дал %s[acc:%d] %s[%d патр]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), GetWeaponName(weapon_id), weapon_ammo);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

