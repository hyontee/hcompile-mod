    BS_WriteValue(bitstream, PR_UINT32, id);

	PR_SendRPC(bitstream, playerid, 168, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bitstream);
}

stock SetVehicleCarMod(vehicleid, operation, param, setvalue=0)
{
	if(setvalue)
    {
        vInfo[vehicleid][vCarMod] = param;
        vInfo[vehicleid][vCarModParam] = operation;
    }
    foreach(new playerid: Player)
        SendCarMod(playerid, operation, vehicleid, param);
}

stock SendCarMod(playerid, operation, vehicleid, param) {

    new BitStream:bs = BS_New();
    BS_WriteValue(bs,
        PR_UINT8, 15,
        PR_UINT8, operation,
        PR_UINT16, vehicleid,
        PR_UINT16, param
    );
    PR_SendRPC(bs, playerid, 168, PR_HIGH_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}

stock SendCarFirmware(playerid, firmware)
{
    new BitStream:bs = BS_New();

    BS_WriteValue(bs, PR_UINT8, 0);
    BS_WriteValue(bs, PR_UINT16, firmware);

    PR_SendRPC(bs, playerid, 255, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}

stock SendOpenLink(playerid, const link[])
{
    new BitStream:bs = BS_New();

    BS_WriteValue(bs, PR_UINT8, 0);
    BS_WriteValue(bs, PR_UINT16, 99);
    new len = strlen(link);
    BS_WriteValue(bs, PR_UINT16, len);
    BS_WriteValue(bs, PR_STRING, link);

    PR_SendRPC(bs, playerid, 255, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}

CMD:carmod(playerid, params[])
{
    new operation, vehicleid, param, setvalue;
    if (sscanf(params, "iiii", operation, vehicleid, param, setvalue))
        return SendClientMessage(playerid, -1, "сползование: /carmod [op=0-3] [vehid] [param] [setvalue]");

    SetVehicleCarMod(vehicleid, operation, param, setvalue);
    return 1;
}

CMD:firmv(playerid, params[])
{
    new firmwar;
    if (sscanf(params, "i", firmwar))
        return SendClientMessage(playerid, -1, "сползование: /firmv [firmware]");

    SendCarFirmware(playerid, firmwar);
    return 1;
}

CMD:olink(playerid, params[])
{
	new link[128];
	if (sscanf(params, "s[128]", link))
		return SendClientMessage(playerid, -1, "сползование: /olink [сслка]");

	SendOpenLink(playerid, link);
	return 1;
}

CMD:af(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1)
        return SendClientMessage(playerid, 0xFFFFFFFF, "{FF0000}| {FFFFFF}оступно толко {FF5252}администрации сервера{FFFFFF}.");

    names[playerid] = params[0];

    new string[1222];
    string[0] = '\0';

    strcat(string, "{FF5252}номер\t{FF5252}описание\t{FF5252}действие\n");

    strcat(string, "{FF5252}#1\tктивне форм\tнажмите дл взаимодействи\n");
    strcat(string, "{FF5252}#2\tодат форму\tнажмите дл взаимодействи\n");

    new sile_title[128];
    format(sile_title, sizeof sile_title, "{FF5252}%s{FFFFFF} -> орм администрации", NameServer[SILE_NAME]);

    SPD(playerid, DIALOG_AF, DIALOG_STYLE_TABLIST_HEADERS, sile_title, string, "алее", "йти");
    return 1;
}
