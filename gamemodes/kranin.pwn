				new Float: pos_y = 424.3185;
				new Float: pos_z = 12.2686;
				new Float: angle = 356.7986;

				if(response)
				{
					switch(listitem + 1)
					{
						case 1:
						{
						    if((GetPlayerOwnableCars(playerid) + 1) > GetPlayerCarSlots(playerid))
							{
								SendClientMessage(playerid, 0x3399FFFF, "се слот дл транспорта зант.  можете увеличит их: {FF5252}/menu > ополнително");
