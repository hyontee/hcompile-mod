							SendClientMessage(owner_player, 0xFF6600FF, "аше предпритие бло изъто государством за неуплату налогов");

						}
						SetFuelStationData(sell_fs_id, FS_IMPROVEMENTS, 0);

						SetFuelStationData(sell_fs_id, FS_FUELS, 		1000);
