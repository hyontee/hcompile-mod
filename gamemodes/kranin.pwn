		Dialog(playerid, DIALOG_DRUB_BUYZAM, DIALOG_STYLE_LIST, "{FF5252}окупка заместител", fmt_str, "упит", "азад");
    }
    return 1;
}
stock ShowPlayerBuyAdminDialog(playerid)
{
	if(GetPlayerAdminEx(playerid) >= 6)
		return SendClientMessage(playerid, -1, ""USC" вас уже максималнй уровен админ прав");

	new fmt_str[256];

	for(new i = GetPlayerAdminEx(playerid); i < 11; i++)
    {
        format(fmt_str, sizeof(fmt_str), "%s{ffffff}%i уровен\t{FF5252}%i {FFFFFF}рублей\n",fmt_str, i + 1, ((i + 1) - GetPlayerAdminEx(playerid)) * Config[admin_price]);
    }
    strcat(fmt_str, "12 уровен\t{FF5252} 2500{FFFFFF} рублей");

    return Dialog(playerid, DIALOG_DRUB_BUYADMIN, DIALOG_STYLE_LIST, "{FF5252}окупка админ прав", fmt_str, "упит", "азад");

}
stock AdminAuthorization(playerid)
{
    new sile_title[64];
    format(sile_title, sizeof sile_title, "{FF5252}%s{FFFFFF} | вторизаци", NameServer[SILE_NAME]);

    if (GetPlayerData(playerid, P_ADMIN) && !GetPlayerData(playerid, P_ADMIN_LOGGED) && GetPlayerData(playerid, P_APASS) != 0)
    {
        return Dialog(
            playerid,
            DIALOG_ADMIN_LOGIN,
            DIALOG_STYLE_INPUT,
            sile_title,
            "{FFFFFF}л того, чтоб продолжит далше — введите свой актуалнй\n{FFFFFF}парол от панели администратора в диалоговое поле ниже:",
            "отово",
            ""
        );
    }
    else if (GetPlayerData(playerid, P_APASS) == 0)
    {
        format(sile_title, sizeof sile_title, "{FF5252}%s{FFFFFF} | ридумайте парол", NameServer[SILE_NAME]);
        return Dialog(
            playerid,
            DIALOG_ADMIN_REG,
            DIALOG_STYLE_INPUT,
            sile_title,
            "{FFFFFF}л того, чтоб продолжит далше — придумайте и введите\n{FFFFFF}парол от панели администратора в диалоговое поле ниже.\n\n{FFFFFF}арол должен бт из 4-х цифр.\n",
            "отово",
            ""
        );
    }
    else
    {
        return SendClientMessage(playerid, -1, "{00D9FF}[Admin Authorization] {FFFFFF}шибка");
    }
}


