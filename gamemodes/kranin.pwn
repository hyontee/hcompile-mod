stock bool:CanUseMedkit(playerid)
{
    new bool:canUse = true;

    if(g_PlayerMedkitUsed[playerid] == true)
    {
        canUse = false;
    }

    return canUse;
}

stock SetPlayerMedkitUsed(playerid, bool:used)
{
    g_PlayerMedkitUsed[playerid] = used;
}

forward ResetMedkitCooldown(playerid);
public ResetMedkitCooldown(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        g_PlayerMedkitUsed[playerid] = false;
    }
}

CMD:healme(playerid, params[])
{
    new med_slot = -1;
    new med_count = 0;

    if(!CanUseMedkit(playerid))
    {
        ShowNotificationSile(playerid, 2, 5, -1, -1, "дите,  уже исползовали аптечку", "");
        return 1;
    }

    for(new i = 0; i < MAX_INVENTORY_SLOTS; i++)
    {
        if(g_PlayerInventory[playerid][i][inv_itemId] == 22)
        {
            med_slot = i;
            med_count = g_PlayerInventory[playerid][i][inv_itemCount];
            break;
        }
    }

    if(med_slot == -1 || med_count <= 0)
    {
        SendClientMessage(playerid, 0xCECECEFF, " ас нет аптечки.");
        return 1;
    }

    new Float:currentHealth;
    GetPlayerHealth(playerid, currentHealth);

    new Float:newHealth = currentHealth + 60.0;
    if(newHealth > 100.0) newHealth = 100.0;

    SetPlayerHealthEx(playerid, newHealth, true);

    SetPlayerMedkitUsed(playerid, true);
    SetTimerEx("ResetMedkitCooldown", 5000, false, "i", playerid);

    printf("[HEALME] Player %d used medkit from slot %d, count: %d", playerid, med_slot, med_count);

    if(med_count > 1)
    {
        g_PlayerInventory[playerid][med_slot][inv_itemCount] = med_count - 1;

        new query[256];
        mysql_format(mysql, query, sizeof(query),
            "UPDATE `player_inventory` SET `item_count` = %d WHERE `player_id` = %d AND `slot` = %d AND `is_active` = 0",
            med_count - 1, GetPlayerAccountID(playerid), med_slot);
        mysql_tquery(mysql, query);

        printf("[HEALME] Reduced medkit count to %d", med_count - 1);
    }
    else
    {
        printf("[HEALME] Last medkit, deleting slot %d", med_slot);

        g_PlayerInventory[playerid][med_slot][inv_itemId] = 0;
        g_PlayerInventory[playerid][med_slot][inv_itemCount] = 0;
        g_PlayerInventory[playerid][med_slot][inv_itemSlot] = med_slot;
        g_PlayerInventory[playerid][med_slot][inv_itemPlate][0] = 0;
        g_PlayerInventory[playerid][med_slot][inv_itemType] = 0;
        g_PlayerInventory[playerid][med_slot][inv_itemWeight] = 0;
        g_PlayerInventory[playerid][med_slot][inv_itemName][0] = 0;
        g_PlayerInventory[playerid][med_slot][inv_itemActive] = false;

        new query[256];
        mysql_format(mysql, query, sizeof(query),
            "DELETE FROM `player_inventory` WHERE `player_id` = %d AND `slot` = %d AND `is_active` = 0",
            GetPlayerAccountID(playerid), med_slot);
        mysql_tquery(mysql, query);
    }

    new newWeight = GetPlayerWeight(playerid) - GetItemWeight(22);
    SetPlayerWeight(playerid, newWeight);

    ShowNotificationSile(playerid, 3, 5, -1, -1, " исползовали аптечку. аше здорове увеличилос на 60 единиц", "");
    ApplyAnimationEx(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 1);

    return 1;
}

CMD:present(playerid, params[])
{
	if(!IsPlayerHaveWeapon(playerid, WEAPON_FLOWER))
		return SendClientMessage(playerid, 0xCECECEFF, " ас нет цветов");

	if(!strlen(params))
		return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /present [id игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 3.0))
		return SendClientMessage(playerid, 0xCECECEFF, "грок слишком далеко");

	if(IsPlayerHaveWeapon(to_player, WEAPON_FLOWER))
		return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест букет цветов");

	new fmt_str[64];

	new Float: angle;
	new Float: to_x, Float: to_y;
	new Float: x, Float: y, Float: z;

	GetPlayerPos(playerid, x, y, z);
	GetPlayerPos(to_player, to_x, to_y, z);

	angle = GetAngleToPoint(to_x, to_y, x, y);

	SetPlayerFacingAngle(playerid, angle);
	SetPlayerFacingAngle(to_player, angle + 180.0);

	ApplyAnimationEx(playerid, "DEALER", "DEALER_DEAL", 4.0, 0, 0, 0, 0, 0, 0);
	ApplyAnimationEx(to_player, "DEALER", "DEALER_DEAL", 4.0, 0, 0, 0, 0, 0, 0);

	format(fmt_str, sizeof fmt_str, "%s получил(а) от ас цвет", GetPlayerNameEx(to_player));
	SendClientMessage(playerid, 0x3399FFFF, fmt_str);

	format(fmt_str, sizeof fmt_str, "%s подарил(а) ам цвет", GetPlayerNameEx(playerid));
	SendClientMessage(to_player, 0x3399FFFF, fmt_str);

	SetTimerEx("PresentFlowersToPlayer", 1500, false, "ii", playerid, to_player);
	return 1;
}

CMD:mask(playerid, params[])
{
    new slot = -1;

    for(new i = 0; i < MAX_INVENTORY_SLOTS; i++)
    {
        if(g_PlayerInventory[playerid][i][inv_itemId] == 116 &&
           g_PlayerInventory[playerid][i][inv_itemCount] > 0)
        {
            slot = i;
            break;
        }
    }

    if(slot == -1)
    {
        SendClientMessage(playerid, 0xCECECEFF, " ас нет с собой маски");
        return 1;
    }

    new current_count = g_PlayerInventory[playerid][slot][inv_itemCount];

    if(SetPlayerAttachedObject(playerid, 8, 2641, 2, 0.029, 0.059, 0.000, 180.000, 90.000, 0.000, 1.100, 1.100, 1.100))
    {
        SendClientMessage(playerid, 0x3399FFFF, "аше месторасположение на GPS скрто на 10 минут");
   	 SetPlayerColorEx(playerid, 0x00000000);

    	ApplyAnimation(playerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 0);
    	SetPlayerChatBubble(playerid, "адевает маску", 0xFF9900FF, 15.0, 5000);
        SetTimerEx("RemovePlayerMask", 600000, false, "i", playerid);

        if(current_count > 1)
        {
            g_PlayerInventory[playerid][slot][inv_itemCount] = current_count - 1;

            new query[256];
            mysql_format(mysql, query, sizeof(query),
                "UPDATE `player_inventory` SET `item_count` = %d WHERE `player_id` = %d AND `slot` = %d AND `is_active` = 0",
                current_count - 1, GetPlayerAccountID(playerid), slot);
            mysql_tquery(mysql, query);

            new newWeight = GetPlayerWeight(playerid) - GetItemWeight(116);
            SetPlayerWeight(playerid, newWeight);
        }
        else
        {
            new newWeight = GetPlayerWeight(playerid) - GetItemWeight(116);
            SetPlayerWeight(playerid, newWeight);

            g_PlayerInventory[playerid][slot][inv_itemId] = 0;
            g_PlayerInventory[playerid][slot][inv_itemCount] = 0;
            g_PlayerInventory[playerid][slot][inv_itemSlot] = slot;
            g_PlayerInventory[playerid][slot][inv_itemPlate][0] = 0;
            g_PlayerInventory[playerid][slot][inv_itemType] = 0;
            g_PlayerInventory[playerid][slot][inv_itemWeight] = 0;
            g_PlayerInventory[playerid][slot][inv_itemName][0] = 0;
            g_PlayerInventory[playerid][slot][inv_itemActive] = false;

            new query[256];
            mysql_format(mysql, query, sizeof(query),
                "DELETE FROM `player_inventory` WHERE `player_id` = %d AND `slot` = %d AND `is_active` = 0",
                GetPlayerAccountID(playerid), slot);
            mysql_tquery(mysql, query);
        }
    }
    else
    {
        SendClientMessage(playerid, -1, "шибка: не удалос надет маску");
    }

    return 1;
}

forward RemovePlayerMask(playerid);
public RemovePlayerMask(playerid)
{
	if(IsPlayerConnected(playerid))
	{
		if(RemovePlayerAttachedObject(playerid, 8))
		{
			SetPlayerColorEx(playerid, GetPlayerData(playerid, P_COLOR));
			SetPlayerData(playerid, P_MASK, 0);

			SendClientMessage(playerid, 0xFF9900FF, "аска слетела, ваше местоположение снова видно на GPS");
			ApplyAnimationEx(playerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 0);
		}
	}
	return 1;
}

CMD:dis(playerid)
{
    if(GetPlayerTeamEx(playerid) != TEAM_FBI) return SendClientMessage(playerid, 0x999999FF, "оступно толко !");

	SetPlayerColorEx(playerid, 0x00000000);

	SendClientMessage(playerid, 0x3399FFFF, " успешно замаскировалис!");

	return 1;
}

CMD:offdis(playerid)
{
    if(GetPlayerTeamEx(playerid) != TEAM_FBI) return SendClientMessage(playerid, 0x999999FF, "оступно толко !");

    SetPlayerColorEx(playerid, GetPlayerTeamColor(playerid));

    return 1;
}

CMD:home(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		new fmt_str[512];
		new entranceid = GetHouseData(houseid, H_ENTRACE);
		new city[MAX_ZONES_NAME + 1], area[MAX_ZONES_NAME + 1];

		format(fmt_str, sizeof fmt_str, "{FFFFFF}ип / название:\t\t\t{339999}%s\n", GetHouseData(houseid, H_NAME));
		if(entranceid != -1)
		{
			GetCityName(GetEntranceData(entranceid, E_POS_X), GetEntranceData(entranceid, E_POS_Y), city);
			GetAreaName(GetEntranceData(entranceid, E_POS_X), GetEntranceData(entranceid, E_POS_Y), area);
			format
			(
				fmt_str, sizeof fmt_str,
				"%s{FFFFFF}омер подъезда:\t\t\t%d\n"\
				"омер квартир:\t\t\t%d\n"\
				"ород / област:\t\t\t%s\n"\
				"айон:\t\t\t\t\t%s\n",
				fmt_str,
				entranceid + 1,
				GetHouseData(houseid, H_FLAT_ID) + 1,
				city,
				area
			);
		}
		else
		{
			GetCityName(GetHouseData(houseid, H_POS_X), GetHouseData(houseid, H_POS_Y), city);
			GetAreaName(GetHouseData(houseid, H_POS_X), GetHouseData(houseid, H_POS_Y), area);
			format
			(
				fmt_str, sizeof fmt_str,
				"%s{FFFFFF}омер дома:\t\t\t\t%d\n"\
				"ород / област:\t\t\t%s\n"\
				"айон:\t\t\t\t\t%s\n",
				fmt_str,
				houseid,
				city,
				area
			);
		}

		format
		(
			fmt_str, sizeof fmt_str,
			"%sтоимост:\t\t\t\t%d руб\n"\
			"ом оплачен на:\t\t\t%d/30 дней\n"\
			"оличество комнат:\t\t\t%d\n"\
			"ровен улучшений:\t\t\t%d\n"\
			"одел домашнего авто:\t\t{FF3333}ет\n"\
			"{FFFFFF}вартплата:\t\t\t\t%d руб в ден\n"\
			"ип квартплат:\t\t\t%s\n"\
			"татус:\t\t\t\t\t%s\n\n"\
			"{669966}л открти панели управлени вашим домом\n"\
			"нажмите кнопку \"зменит\"",
			fmt_str,
			GetHouseData(houseid, H_PRICE),
			GetHouseData(houseid, H_RENT_DATE) <= gettime() ? 0 :
			GetElapsedTime(GetHouseData(houseid, H_RENT_DATE), gettime(), CONVERT_TIME_TO_DAYS),
			GetHouseTypeInfo(GetHouseData(houseid, H_TYPE), HT_ROOMS),
			GetHouseData(houseid, H_IMPROVEMENTS),
			GetHouseData(houseid, H_IMPROVEMENTS) < 4 ? (GetHouseData(houseid, H_RENT_PRICE)) : (GetHouseData(houseid, H_RENT_PRICE) / 2),
			GetHouseData(houseid, H_IMPROVEMENTS) < 4 ? ("бчна") : ("ониженна"),
			GetHouseData(houseid, H_LOCK_STATUS) ? ("{CC3333}ом закрт") : ("{66CC33}ом открт")
		);
		Dialog(playerid, DIALOG_HOUSE_INFO, DIALOG_STYLE_MSGBOX, "{33AACC}нформаци о доме", fmt_str, "зменит", "тмена");
	}
	else SendClientMessage(playerid, 0x999999FF, " ас нет дома");

	return 1;
}

CMD:sellhome(playerid, params[])
{
    new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
    if(houseid != -1)
    {
        new title[128];
        format(title, sizeof(title), "{FF5252}%s{ffffff} -> {FFFFFF}родажа дома", NameServer[SILE_NAME]);

        Dialog
        (
            playerid, DIALOG_HOUSE_SELL, DIALOG_STYLE_MSGBOX,
            title,
            "{FFFFFF} уверен что хотите продат свой дом государству?\n\n"\
            "{ffffff}ам будет возвращено {32CD32} 70 {ffffff}процентов от стоимости недвижимости.\n"\
            "{ffffff}ам будет возвращено {32CD32} 60 {ffffff}процентов от купленнх ранее улучшений.\n\n"\
            "{ffffff}сли  хотите продат бизнес другому игроку,\n"\
            "{ffffff}исползуйте команду {1E90FF} /sellmyhome",
            "а", "ет"
        );
    }
    else SendClientMessage(playerid, 0x999999FF, " ас нет дома");

    return 1;
}

CMD:sellmyhome(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /sellmyhome [id игрока] [стоимост]");

		extract params -> new to_player, price;

		new house_price = GetHouseData(houseid, H_PRICE);

		if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
			return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

		if(GetPlayerHouse(to_player) != -1)
			return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест дом");

		if(!((house_price / 3) <= price <= (house_price * 3)))
			return SendClientMessage(playerid, 0xCECECEFF, "тоимост не должна бт дороже или дешевле в 3 раза от стоимости дома");

		if(GetPlayerMoneyEx(to_player) < price)
			return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет такой сумм");

		if(!(IsPlayerInRangeOfHouse(playerid, houseid, 10.0) && IsPlayerInRangeOfHouse(to_player, houseid, 10.0)))
			return SendClientMessage(playerid, 0xCECECEFF, " и покупател должн находитс около дома которй хотите продат");

		SendPlayerOffer(playerid, to_player, OFFER_TYPE_SELL_HOME, houseid, price);
	}
	else SendClientMessage(playerid, 0x999999FF, " ас нет дома");

	return 1;
}

CMD:live(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		new type = GetHouseData(houseid, H_TYPE);
		new rooms = GetHouseTypeInfo(type, HT_ROOMS);

		if(GetHouseRentersCount(houseid) >= rooms)
			return SendClientMessage(playerid, 0x999999FF, "се комнат ашего дома уже зант");

		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /live [id игрока]");

		extract params -> new to_player, days, price;

		if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
			return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

		if(GetPlayerHouse(to_player) != -1)
			return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест дом");

		if(!(IsPlayerInRangeOfHouse(playerid, houseid, 10.0) && IsPlayerInRangeOfHouse(to_player, houseid, 10.0)))
			return SendClientMessage(playerid, 0xCECECEFF, " и арендатор должн находитс около дома которй хотите сдат в аренду");

		SendPlayerOffer(playerid, to_player, OFFER_TYPE_HOME_RENT_ROOM, houseid);
	}
	else SendClientMessage(playerid, 0x999999FF, " ас нет дома");

	return 1;
}

CMD:liveout(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_ROOM);
	if(houseid != -1)
	{
		Dialog
		(
			playerid, DIALOG_HOUSE_EVICT, DIALOG_STYLE_MSGBOX,
			"{FF9900}селение из дома",
			"{FFFFFF} действително хотите вселитс из дома?",
			"а", "ет"
		);
	}
	else SendClientMessage(playerid, 0x999999FF, " нигде не проживаете");

	return 1;
}

CMD:makestore(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		if(GetHouseData(houseid, H_IMPROVEMENTS) >= 5)
		{
			if(GetPlayerInHouse(playerid) == houseid)
			{
				new type = GetHouseData(houseid, H_TYPE);
				if(IsPlayerInRangeOfPoint(playerid, 50.0, GetHouseTypeInfo(type, HT_ENTER_POS_X), GetHouseTypeInfo(type, HT_ENTER_POS_Y), GetHouseTypeInfo(type, HT_ENTER_POS_Z)))
				{
					Dialog
					(
						playerid, DIALOG_HOUSE_MOVE_STORE, DIALOG_STYLE_MSGBOX,
						"{FFCD00}каф",
						"{FFFFFF} хотите разместит шкаф в этом месте?",
						"а", "ет"
					);
				}
				else SendClientMessage(playerid, 0x999999FF, " должн находитс у себ в доме");
			}
			else SendClientMessage(playerid, 0x999999FF, " должн находитс у себ в доме");
		}
		else SendClientMessage(playerid, 0x999999FF, "еобходим 5 уровен улучшений дл дома");
	}
	else SendClientMessage(playerid, 0x999999FF, "ункци доступна владелцам недвижимости");

	return 1;
}

CMD:use(playerid, params[])
{
	new house_id = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);

	if(house_id == -1) return SendClientMessage(playerid, 0x999999FF, "ункци доступна владелцам недвижимости");

	if(GetPlayerInHouse(playerid) != house_id) return SendClientMessage(playerid, 0x999999FF, " должн находитс в своём доме");

	if(GetHouseData(house_id, H_IMPROVEMENTS) < 5) return SendClientMessage(playerid, 0x999999FF, "еобходим 5 уровен улучшений дл дома");

	if(!IsPlayerInRangeOfPoint(playerid, 3.0, GetHouseData(house_id, H_STORE_X), GetHouseData(house_id, H_STORE_Y), GetHouseData(house_id, H_STORE_Z)))
		return SendClientMessage(playerid, 0xCECECEFF, " должн находитс у своего шкафа");

	Dialog
	(
		playerid, DIALOG_HOUSE_STORE, DIALOG_STYLE_LIST,
		"{FFCC00}каф",
		"1. оложит атериал\n\
		2. оложит наркотики\n\
		3. оложит оружие\n\
		4. оложит одежду\n\
		{99FF99}5. зт атериал\n\
		{99FF99}6. зт наркотики\n\
		{99FF99}7. зт оружие\n\
		{99FF99}8. зт одежду",
		"алее", "акрт"
	);

	return 1;
}

CMD:homelock(playerid, params[])
{
	new hotel_id = GetPlayerHouse(playerid, HOUSE_TYPE_HOTEL);
	new room_id = GetPlayerData(playerid, P_HOUSE_ROOM);

	if(hotel_id != -1)
	{
		if(GetHotelData(hotel_id, room_id, H_STATUS))
		{
			SetHotelData(hotel_id, room_id, H_STATUS, false);

			SendClientMessage(playerid, 0x66CC00FF, "омер открт");
		}
		else
		{
			SetHotelData(hotel_id, room_id, H_STATUS, true);

			SendClientMessage(playerid, 0xFF6600FF, "омер закрт");
		}

		new query[64];
		format(query, sizeof query, "UPDATE hotels SET status=%d WHERE id=%d LIMIT 1", GetHotelData(hotel_id, room_id, H_STATUS), GetHotelData(hotel_id, room_id, H_SQL_ID));
		mysql_query(mysql, query, false);
	}
	else SendClientMessage(playerid, 0x999999FF, " не снимаете номер в гостинице");

	return 1;
}

CMD:exit(playerid, params[])
{
    printf("[DEBUG] оманда /exit взвана игроком %d", playerid);
    
    new houseid = GetPlayerInHouse(playerid);
    printf("[DEBUG] GetPlayerInHouse вернул: houseid=%d", houseid);
    
    if(houseid != -1)
    {
        new improvements = GetHouseData(houseid, H_IMPROVEMENTS);
        printf("[DEBUG] лучшени дома: improvements=%d", improvements);
        
        if(improvements > 5)
        {
            printf("[DEBUG] лучшений >5, показваем диалог входа (улица/гараж)");
            Dialog
            (
                playerid, DIALOG_ACTION_EXIT_HOUSE, DIALOG_STYLE_LIST,
                "{FFCC00}ход",
                "1. лица\n\
                2. араж",
                "алее", "акрт"
            );
            printf("[DEBUG] иалог входа показан");
        }
        else
        {
            printf("[DEBUG] лучшений <=5, входим сразу на улицу");
            ExitPlayerFromHouse(playerid, 3.0);
            printf("[DEBUG] ExitPlayerFromHouse взвана");
        }
    }
    else if(GetPlayerData(playerid, P_IN_HOTEL_ROOM) != -1)
    {
        printf("[DEBUG] грок в отеле (P_IN_HOTEL_ROOM=%d)", GetPlayerData(playerid, P_IN_HOTEL_ROOM));
        ExitPlayerFromHotelRoom(playerid);
        printf("[DEBUG] ExitPlayerFromHotelRoom взвана");
    }
    else if(!GetPlayerInterior(playerid))
    {
        printf("[DEBUG] грок не в помещении (интерер=0)");
        SendClientMessage(playerid, 0xCECECEFF, " не в помещении");
    }
    else
    {
        printf("[DEBUG] грок в интерере %d, но не в доме и не в отеле", GetPlayerInterior(playerid));
    }
    
    printf("[DEBUG] оманда /exit завершена");
    return 1;
}

CMD:lift(playerid, params[])
{
	new entranceid = GetPlayerInEntrance(playerid);
	if(entranceid != -1)
	{
		new floor = GetPlayerInEntranceFloor(playerid);
		if(floor != -1)
		{
			if(!floor)
			{
				if(!IsPlayerInRangeOfPoint(playerid, 1.5, 30.5405, 1403.6593, 1508.4163))
					return SendClientMessage(playerid, 0xCECECEFF, " должн находитс около лифта");
			}
			else
			{
				if(!IsPlayerInRangeOfPoint(playerid, 1.5, 11.1776, 1377.5216, 1508.4163))
					return SendClientMessage(playerid, 0xCECECEFF, " должн находитс около лифта");
			}
			ShowPlayerEntranceFloorsLift(playerid, entranceid, floor);
		}
	}
	else SendClientMessage(playerid, 0xCECECEFF, " не в подъезде");

	return 1;
}
alias:lock("lk")

CMD:lock(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);

    if(vehicleid != 0 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
        {
            new car_id = GetVehicleData(vehicleid, V_ACTION_ID);
            new family_car_sql_db = GetCarFamily(car_id, OW_F_database);
            new player_family_sql = GetPlayerFamily(playerid, ID_SQL_FAMILY);

            if(player_family_sql != -1 && player_family_sql == family_car_sql_db)
            {
                ToggleLock(playerid, vehicleid);
                return 1;
            }
            else
            {
                SendClientMessage(playerid, 0x999999FF, ""USC"то семейнй транспорт, но в не в этой семе!");
                return 1;
            }
        }
        if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        {
            new car_id = GetVehicleData(vehicleid, V_ACTION_ID);
            if(GetOwnableCarData(car_id, OC_OWNER_ID) == GetPlayerAccountID(playerid))
            {
                ToggleLock(playerid, vehicleid);
                return 1;
            }
            else
            {
                SendClientMessage(playerid, 0x999999FF, ""USC"то не ваш транспорт!");
                return 1;
            }
        }

        SendClientMessage(playerid, 0x999999FF, ""USC"тот транспорт нелз закрт!");
        return 1;
    }

    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    for(new i = 1; i <= MAX_VEHICLES; i++)
    {
        if(!IsValidVehicle(i)) continue;

        new Float:vx, Float:vy, Float:vz;
        GetVehiclePos(i, vx, vy, vz);

        if(GetPlayerDistanceFromPoint(playerid, vx, vy, vz) <= 5.0)
        {
            vehicleid = i;
            break;
        }
    }

    if(vehicleid == 0)
    {
        SendClientMessage(playerid, 0x999999FF, ""USC"дом нет транспорта!");
        return 1;
    }

    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
    {
        new car_id = GetVehicleData(vehicleid, V_ACTION_ID);
        new family_car_sql_db = GetCarFamily(car_id, OW_F_database);
        new family_index = GetFamilyIDSQL(family_car_sql_db);
        new player_family_index = GetPlayerIdFamily(playerid);

        if(player_family_index != -1 && player_family_index == family_index)
        {
            ToggleLock(playerid, vehicleid);
            return 1;
        }
        else
        {
            SendClientMessage(playerid, 0x999999FF, ""USC"то семейнй транспорт, но в не в этой семе!");
            return 1;
        }
    }

    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        new car_id = GetVehicleData(vehicleid, V_ACTION_ID);
        if(GetOwnableCarData(car_id, OC_OWNER_ID) == GetPlayerAccountID(playerid))
        {
            ToggleLock(playerid, vehicleid);
            return 1;
        }
        else
        {
            SendClientMessage(playerid, 0x999999FF, ""USC"то не ваш транспорт!");
            return 1;
        }
    }

    SendClientMessage(playerid, 0x999999FF, ""USC"тот транспорт нелз закрт!");
    return 1;
}

stock ToggleLock(playerid, vehicleid)
{
    if(GetVehicleParam(vehicleid, V_LOCK))
    {
        new fmt_str[128];
        format(fmt_str, sizeof fmt_str,"%s открл(а) транспорт", GetPlayerNameEx(playerid));
        SendMessageInLocal(playerid, fmt_str, 0xDD90FFFF, 25.0);
        SetVehicleParam(vehicleid, V_LOCK, 0);
        ShowNotificationSile(playerid, 3, 5, 0, 0, " открли транспорт", " ");

        player_unlock_notif_shown[playerid] = false;
    }
    else
    {
        new fmt_str[128];
        format(fmt_str, sizeof fmt_str,"%s закрл(а) транспорт", GetPlayerNameEx(playerid));
        SendMessageInLocal(playerid, fmt_str, 0xDD90FFFF, 25.0);
        SetVehicleParam(vehicleid, V_LOCK, 1);
        ShowNotificationSile(playerid, 3, 5, 0, 0, " закрли транспорт", " ");
    }
}

CMD:park(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, " должн находитс в транспорте");

    new vehicleid = GetPlayerVehicleID(playerid);
    new action_type = GetVehicleData(vehicleid, V_ACTION_TYPE);

    if(action_type == VEHICLE_ACTION_TYPE_FAMILY_CAR)
    {
        new f_index = GetPlayerIdFamily(playerid);
        if(f_index == -1)
        {
            return 1;
        }

        if(GetPlayerRangFamily(playerid) != 5)
        {
            SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
            return 1;
        }

        new car_action_id = GetVehicleData(vehicleid, V_ACTION_ID);
        new car_family_sql_id = GetCarFamily(car_action_id, OW_F_database);
        new player_family_sql_id = GetPlayerFamily(playerid, ID_SQL_FAMILY);

        if(car_family_sql_id != player_family_sql_id)
        {
            SendClientMessage(playerid, 0xCECECEFF, "тот транспорт не принадлежит вашей семе!");
            return 1;
        }

        new Float:x, Float:y, Float:z, Float:angle;
        GetVehiclePos(vehicleid, x, y, z);
        GetVehicleZAngle(vehicleid, angle);

        new car_db = GetCarFamily(car_action_id, CAR_F_database);

        mysql_format(mysql, f_string144, sizeof f_string144,
            "UPDATE family_cars SET pos_x = %f, pos_y = %f, pos_z = %f, angle = %f WHERE id = %d",
            x, y, z, angle, car_db);
        mysql_query(mysql, f_string144, false);

        for(new i; i < MAX_OWNABLE_CARS; i++)
        {
            if(GetCarFamily(i, CAR_F_database) == car_db)
            {
                SetCarFamily(i, V_F_SPAWN_X, x);
                SetCarFamily(i, V_F_SPAWN_Y, y);
                SetCarFamily(i, V_F_SPAWN_Z, z);
                SetCarFamily(i, V_F_SPAWN_A, angle);
                break;
            }
        }

        SendClientMessage(playerid, 0x66CC00FF, "аш транспорт успешно припаркован");
        return 1;
    }

    if(action_type != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        SendClientMessage(playerid, 0xCECECEFF, "тот транспорт нелз припарковат!");
        return 1;
    }

    new vehicleid_own = GetPlayerOwnableCar(playerid);
    if(vehicleid_own == INVALID_VEHICLE_ID)
    {
        if(GetPlayerOwnableCars(playerid) == 0)
            return SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
        else
            return SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
    }

    if(vehicleid_own != vehicleid)
        return SendClientMessage(playerid, 0xCECECEFF, " должн находитс в личном транспорте");

    new green_zone_id = GetPVarInt(playerid, "player_in_green_zone") - 1;

    if(green_zone_id != -1)
    {
        if(!g_green_zones[green_zone_id][GZ_ALLOW_PARK])
        {
            new fmt_text[144];
            format(fmt_text, sizeof fmt_text, "а территории {FF5252}'%s' {3399FF}парковка личного транспорта запрещена. берите другое место дл парковки", g_green_zones[green_zone_id][GZ_NAME]);
            SendClientMessage(playerid, 0x3399FFFF, fmt_text);
            return 1;
        }
    }

    new index = GetVehicleData(vehicleid, V_ACTION_ID);

    GetVehiclePos(vehicleid, GetOwnableCarData(index, OC_POS_X), GetOwnableCarData(index, OC_POS_Y), GetOwnableCarData(index, OC_POS_Z));
    GetVehicleZAngle(vehicleid, GetOwnableCarData(index, OC_ANGLE));

    SaveOwnableCar(vehicleid);
    return SendClientMessage(playerid, 0x66CC00FF, "аш транспорт успешно припаркован");
}

CMD:key(playerid, params[])
{
	if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID || GetPlayerAllowedCar(playerid) != INVALID_VEHICLE_ID)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
			if(IsPlayerInAnyVehicle(playerid))
			{
				if(vehicleid == GetPlayerOwnableCar(playerid) || vehicleid == GetPlayerAllowedCar(playerid))
				{
				if(!IsABike(vehicleid))
				{
						new index = GetVehicleData(vehicleid, V_ACTION_ID);
						new bool: status = GetOwnableCarData(index, OC_KEY_IN);

						if(status)
						{
							if(GetVehicleParam(vehicleid, V_ENGINE) == VEHICLE_PARAM_ON)
							{
								SetVehicleParam(vehicleid, V_ENGINE, VEHICLE_PARAM_OFF);
							}
							Action(playerid, "втащил ключ из замка зажигани", _, false);
						}
						else Action(playerid, "вставил ключ в замок зажигани", _, false);

						SetOwnableCarData(index, OC_KEY_IN, status ^ true);
				}
				}
				else SendClientMessage(playerid, 0xCECECEFF, " должн находитс в личном/доверенном транспорте");
			}
			else
			{
				if(carkeystatus[playerid] == 0)
				{
					for(new i; i < sizeof(carkey_TD); i++)
					{
						TextDrawShowForPlayer(playerid, carkey_TD[i]);
					}
					SendClientMessage(playerid, -1, " успешно достали брелок сигнализации");
					carkeystatus[playerid] = 1;
				}
				else
				{
					for(new i; i < sizeof(carkey_TD); i++)
					{
					TextDrawHideForPlayer(playerid, carkey_TD[i]);
					}
					SendClientMessage(playerid, -1, " успешно убрали брелок сигнализации");
					carkeystatus[playerid] = 0;
				}
			}
	}
	else 
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			SendClientMessage(playerid, 0x999999FF, " ас нет личного/доверенного транспорта");
		else
			SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}
	return 1;
}

CMD:getmycar(playerid, params[])
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		new price = 300;
		new i_have_home = (GetPlayerHouse(playerid, HOUSE_TYPE_HOME) != -1 || GetPlayerHouse(playerid, HOUSE_TYPE_HOTEL) != -1);

		if(GetPlayerGPSInfo(playerid, G_ENABLED) == GPS_STATUS_OFF)
		{
			if(GetPlayerMoneyEx(playerid) >= price || i_have_home)
			{
				if(!i_have_home)
					GivePlayerMoneyEx(playerid, -price, "етка  на GPS", true, true);

				new Float: x, Float: y, Float: z;
				GetVehiclePos(vehicleid, x, y, z);

				EnablePlayerGPS(playerid, 55, x, y, z, "естоположение ашего транспорта отмечено на GPS");
				return 1;
			}
			else SendClientMessage(playerid, 0x999999FF, "едостаточно денег");
		}
		else SendClientMessage(playerid, 0xCECECEFF, "а ашем GPS уже отмечено место");
	}
	else
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
		else
			SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}

	return 0;
}

CMD:sellcar(playerid, params[])
{
    new vehicleid = GetPlayerOwnableCar(playerid);
    if(vehicleid != INVALID_VEHICLE_ID)
    {
        new model_id = GetVehicleData(vehicleid, V_MODELID);
        if(model_id)
        {
            new fmt_str[999];
            new price, sell_price;
            new vehicle_name[64];

            if(!GetVehicleJsonNameByModelId(model_id, vehicle_name, sizeof(vehicle_name)))
                format(vehicle_name, sizeof(vehicle_name), "еизвестнй транспорт");

            if(GetVehicleJsonCostByModelId(model_id, price))
            {
                sell_price = price / 2;

                format
                (
                    fmt_str, sizeof fmt_str,
                    ""SC"ранспортное средство:\t{FF5252}%s (№%d)\n"\
                    ""SC"тоимост продажи:\t{FF5252}%d руб.\n\n"\
                    "{FFFFFF} можете продат свое транспортное средство другим\n"\
                    "игрокам с помощю команд: {FF5252}\"/sellmycar\".\n\n"\
                    "{FFFFFF} уверен, что хотите моментално продат свое\n"\
                    "транспортное средство?",
                    vehicle_name,
                    model_id,
                    sell_price
                );

                new title[128];
                format(title, sizeof(title), "{FF5252}%s{ffffff} -> {FFFFFF}родажа транспорта", NameServer[SILE_NAME]);

                Dialog(playerid, DIALOG_OWNABLE_CAR_SELL, DIALOG_STYLE_MSGBOX, title, fmt_str, "а", "тмена");
            }
            else
            {
                ShowNotificationSile(playerid, 2, 6, 0, 0, "шибка: цена дл этого транспорта не найдена в базе даннх", "");
            }
        }
    }
    else
    {
        if(GetPlayerOwnableCars(playerid) == 0)
            ShowNotificationSile(playerid, 2, 6, 0, 0, " ас нет личного транспорта", "");
        else
            ShowNotificationSile(playerid, 2, 6, 0, 0, "аш личнй транспорт не загружен на сервере", "");
    }

    return 1;
}

CMD:sellmycar(playerid, params[])
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /sellmycar [id игрока] [стоимост]");

		extract params -> new to_player, price;

		new model_id = GetVehicleData(vehicleid, V_MODELID);
		if(model_id)
		{
			new car_price = GetVehicleInfo(model_id-400, VI_PRICE);

			if(!IsPlayerConnected(to_player) || to_player == playerid)
				return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

			if((GetPlayerOwnableCars(to_player) + 1) > GetPlayerCarSlots(to_player))
				return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет свободнх слотов дл транспорта");

			if(GetPlayerOwnableCar(to_player) != INVALID_VEHICLE_ID)
				return SendClientMessage(playerid, 0xCECECEFF, "тот игрок должен вгрузит его личнй транспорт с сервера {888888}(/car > 7)");

			if(!(3000 <= price <= (car_price * 2)))
				return SendClientMessage(playerid, 0xCECECEFF, "тоимост должа бт от 3000 рублей и не дороже в 2 раза гос. стоимости ");

			if(GetPlayerMoneyEx(to_player) < price)
				return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет такой сумм");

			new  Float: car_x, Float: car_y, Float: car_z;
			GetVehiclePos(vehicleid, car_x, car_y, car_z);

			if(IsPlayerInRangeOfPoint(playerid, 15.0, car_x, car_y, car_z) && IsPlayerInRangeOfPoint(to_player, 15.0, car_x, car_y, car_z))
			{
				SendPlayerOffer(playerid, to_player, OFFER_TYPE_SELL_OWNABLE_CAR, price, vehicleid);
			}
			else SendClientMessage(playerid, 0xCECECEFF, " и покупател должн находитс около ");
		}
	}
	else
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
		else
			SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}

	return 1;
}

CMD:allow(playerid, params[])
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid == INVALID_VEHICLE_ID)
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			return SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
		else
			return SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /allow [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	new fmt_text[71];

	if(GetPlayerAllowedCar(to_player) == vehicleid)
	{
		format(fmt_text, sizeof fmt_text, " забрали у %s ключи от ашего личного транспорта", GetPlayerNameEx(to_player));
		SendClientMessage(playerid, 0x3399FFFF, fmt_text);

		format(fmt_text, sizeof fmt_text, "%s забрал у ас ключи от своего личного транспорта", GetPlayerNameEx(playerid));
		SendClientMessage(to_player, 0xFF5533FF, fmt_text);

		SetPlayerData(to_player, P_ALLOWED_CAR, INVALID_VEHICLE_ID);
	}
	else
	{
		if(!IsPlayerInRangeOfPlayer(playerid, to_player, 10.0)) return SendClientMessage(playerid, 0xCECECEFF, "грок находитс слишком далеко");

		SendPlayerOffer(playerid, to_player, OFFER_TYPE_GIVE_CAR_KEY);
	}

	return 1;
}

CMD:car(playerid, params[])
{
    new ownableCar = GetPlayerOwnableCar(playerid);
    if(ownableCar != INVALID_VEHICLE_ID && !IsValidVehicle(ownableCar))
    {
        SetPlayerData(playerid, P_OWNABLE_CAR, INVALID_VEHICLE_ID);
        ownableCar = INVALID_VEHICLE_ID;
    }

    if (ownableCar != INVALID_VEHICLE_ID)
    {
        Dialog(playerid, DIALOG_OWNABLE_CAR, DIALOG_STYLE_LIST,
            "{FFCD00}истема управлени транспортом",
            "1. {669900}ткрт {FFFFFF}или {FF3300}закрт {FFFFFF}транспорт\n"\
            "2. тметит транспорт на GPS {FF6600}(300 руб)\n"\
            "3. одержимое багажника\n"\
            "4. окумент на транспорт\n"\
            "5. нт номерне знаки\n"\
            "6. рипарковат транспорт\n"\
            "{888888}7. грузит транспорт с сервера\n"\
            "8. становит сабвуфер в авто\n"\
            "9. нт сабвуфер с авто\n"\
            "10. обавит авто в семю",
            "брат", "акрт"
        );
        return 1;
    }

    new fmt_text[512];
    new Cache:result;
    new rows;

    mysql_format(mysql, fmt_text, sizeof fmt_text, "SELECT * FROM ownable_cars WHERE owner_id='%d'", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, fmt_text, true);
    rows = cache_num_rows();

    if (rows == 0)
    {
        SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
        cache_delete(result);
        return 1;
    }

    new dialog_text[4096] = "";

    strcat(dialog_text, "{FFCD00}№\t{FFCD00}одел\t{FFCD00}омер\t{FFCD00}татус\n");

    new query[196];
    new model_id;
    new num_type;
    new car_number[16];
    new car_region[8];
    new model_name[64];
    new listed = 0;

    for (new i = 0; i < rows; i++)
    {
        new id = cache_get_field_content_int(i, "id");
        model_id = cache_get_field_content_int(i, "model_id");
        num_type = cache_get_field_content_int(i, "number_type");
        cache_get_field_content(i, "number", car_number);
        cache_get_field_content(i, "region", car_region);

        if (g_ownable_car_loaded >= MAX_OWNABLE_CARS && !IsOwnableCarLoaded(id))
            continue;

        GetVehicleModelName(model_id, model_name, sizeof(model_name));

        new status_text[32];
        if (IsOwnableCarLoaded(id))
        {
            status_text = "{669900}агружен";
        }
        else
        {
            status_text = "{FF3300}е загружен";
        }

        new display_number[32];

        if(num_type == 1 || num_type == 4)
        {
            format(display_number, sizeof display_number, "[%s | %s]", car_number, car_region);
        }
        else if(num_type == 2 || num_type == 3)
        {
            format(display_number, sizeof display_number, "[%s]", car_number);
        }
        else
        {
            format(display_number, sizeof display_number, "[%s | %s]", car_number, car_region);
        }

        format(query, sizeof query, "{FFFFFF}%d\t{FFFFFF}%s\t{888888}%s\t%s\n", listed + 1, model_name, display_number, status_text);

        if(listed >= sizeof(g_player_listitem[]))
            break;

        if(strlen(dialog_text) + strlen(query) >= sizeof(dialog_text) - 1)
            break;

        strcat(dialog_text, query);

        SetPlayerListitemValue(playerid, listed, id);
        listed++;
    }

    if(listed == 0)
    {
        SendClientMessage(playerid, 0x999999FF, "ет доступнх к загрузке автомобилей (лимит превшен)");
        cache_delete(result);
        return 1;
    }

    Dialog(playerid, DIALOG_OWNABLE_CAR_LIST, DIALOG_STYLE_TABLIST_HEADERS,
        "{FFCD00}аш личнй транспорт",
        dialog_text,
        "брат", "акрт"
    );

    cache_delete(result);
    return 1;
}


CMD:delvehall(playerid)
{
    if(GetPlayerAdminEx(playerid) < 13) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

    new total_car = 0;
    for(new i = 0; i < MAX_VEHICLES; i++)
    {
        if(GetVehicleData(i, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN_CAR)
        {
            DestroyVehicle(i);
            total_car ++;
        }

    }

    format(sctring, sizeof(sctring), ""SC" удалили {00ff00}%i {FFFFFF}автомобилей созданнх на сервере!", total_car);
    SendClientMessage(playerid, -1, sctring);
    format(sctring, sizeof(sctring), "[A] %s[%d] удалил вес созданнй транспорт на сервере. (%i шт)",GetPlayerNameEx(playerid), playerid, total_car);
    SendMessageToAdmins(sctring, 0x999999FF);
    return 1;
}

stock RandomNumberPlate(country, plate[], size)
{
    switch(country)
    {
        case 1:
        {
            new letters[] = {'a', 'b', 'c', 'e', 'h', 'k', 'm', 'o', 'p', 't', 'x', 'y'};
            format(plate, size, "%c%d%d%d%c%c",
                   letters[random(sizeof(letters))],
                   random(10), random(10), random(10),
                   letters[random(sizeof(letters))],
                   letters[random(sizeof(letters))]);
        }
        case 2:
        {
            new letters[] = {"A", "B", "C", "E", "H", "K", "M", "O", "P", "T", "X", "Y"};
            format(plate, size, "%c%c %d%d%d%d %c%c",
                   letters[random(sizeof(letters))],
                   letters[random(sizeof(letters))],
                   random(10), random(10), random(10), random(10),
                   letters[random(sizeof(letters))],
                   letters[random(sizeof(letters))]);
        }
        case 3:
        {
            new letters[] = {"A", "B", "C", "E", "H", "K", "M", "O", "P", "T", "X", "Y"};
            format(plate, size, "%d%d%d%d %c%c-%d",
                   random(10), random(10), random(10), random(10),
                   letters[random(sizeof(letters))],
                   letters[random(sizeof(letters))],
                   random(10));
        }
        case 4:
        {
            new letters[] = {'a', 'b', 'c', 'e', 'h', 'k', 'm', 'o', 'p', 't', 'x', 'y'};
            format(plate, size, "%d%d%d%c%c%c",
                   random(10), random(10), random(10),
                   letters[random(sizeof(letters))],
                   letters[random(sizeof(letters))],
                   letters[random(sizeof(letters))]);
        }
        case 5: //x 0000 | 52
        {
            new letters[] = {'a', 'b', 'c', 'e', 'h', 'k', 'm', 'o', 'p', 't', 'x', 'y'};
            format(plate, size, "%c %d%d%d%d",
                   letters[random(sizeof(letters))],
                   random(10), random(10), random(10), random(10));
        }
        case 7: //0000 xx | 52 
        {
            new letters[] = {'a', 'b', 'c', 'e', 'h', 'k', 'm', 'o', 'p', 't', 'x', 'y'};
            format(plate, size, "%d%d%d%d %c%c",
                   random(10), random(10), random(10), random(10),
                   letters[random(sizeof(letters))],
                   letters[random(sizeof(letters))]);
        }
    }
}

stock RandomNumberRegion(country, region[], size)
{
    switch(country)
    {
        case 0:
        {
            format(region, size, "%02d", 1 + random(99));
        }
        case 3:
        {
            format(region, size, "%02d", 1 + random(17));
        }
        default:
        {
            format(region, size, "tt");
        }
    }
}

stock bool:ValidatePlateInput(country, const plate[], const region[])
{

    new len = strlen(plate);

    switch(country)
    {
        case 0: return (len == 6);
        case 1: return (len == 10);
        case 2: return (len == 9);
        case 3: return (len == 6);
    }
    return false;
}

CMD:veh(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4 && GetPlayerYouTubeEx(playerid) < 1) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	new model_id, color_1, color_2, status = 1, fmt_text[256];
	if(sscanf(params, "ddd", model_id, color_1, color_2))
		return SendClientMessage(playerid, 0xCECECEFF, "{FF5252}|{ffffff} сползуйте: /veh [id модели] [цвет 1] [цвет 2] [доступ дл игроков (не обзателно)]");

	if(!(400 <= model_id <= 30000)) return SendClientMessage(playerid, 0xCECECEFF, "{FF5252}|{ffffff}сползуйте модел от 400 до 2591");

	new Float: x,
		Float: y,
		Float: z,
		Float: a;

	GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, a);

	new vehicleid = CreateVehicle(model_id, x, y, z, a, 1, 1, -1, 0, VEHICLE_ACTION_TYPE_ADMIN_CAR, status);

	SetTimerEx("DelayedPutPlayerInVehicle", 150, false, "ii", playerid, vehicleid);
	new plate[32];
	RandomNumberPlate(1, plate, sizeof(plate));
	SetVehicleNumberPlateEx(vehicleid, 1, plate, "52");
	//SetVehicleColor(vehicleid, RGBA_to_ARGB(color_1), RGBA_to_ARGB(color_2), 1);

	format(fmt_text, sizeof fmt_text, "[A] %s[%d] создал транспорт (%d, %s, %s)",
	GetPlayerNameEx(playerid), playerid, model_id, color_1, color_2);
    SendMessageToAdmins(fmt_text, 0x999999FF);

	format(fmt_text, sizeof fmt_text, "оздал транспорт (%d, %s, %s)", model_id, color_1, color_2);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}
CMD:pos(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return 1;

	new Float: x, Float: y, Float: z, interior, virtual_world;

	if(sscanf(params, "P<,>fff", x, y, z))
		return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /pos [x y z]");

	sscanf(params, "P<,>{fff}dd", interior, virtual_world);

	return SetPlayerPosEx(playerid, x, y, z, interior, virtual_world);
}

CMD:d(playerid, params[])
{
	if(!GetPlayerTeamEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, " не состоите в организацих");
	else if(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(playerid) <= TEAM_OPG_LYTKARINSKAYA) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна дл сотрудников гос. организаций");
	else if(IsPlayerMuted(playerid) > 0) return SendClientMessage(playerid, 0xFF6600FF, "оступ в чат заблокирован. рем до разблокировки: {66CC33}/time");
	else if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /d [текст]");

	new fmt_msg[144];

	format(fmt_msg, sizeof fmt_msg, "[D] %s %s[%d]: %s", GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid, params);

	if(IsAIP(params))
	{
      	SendClientMessage(playerid, -1, "одозрени в рекламе!");
       	return false;
    }

	for(new i; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;
		if(!GetPlayerTeamEx(i)) continue;
		if(GetPlayerData(i, P_ADVISOR_BLOCK_CHAT)) continue;

		SendClientMessage(i, 0xFF9999FF, fmt_msg);
	}

	SetPlayerChatBubble(playerid, "сказал(а) что-то в рацию организаций", 0xDD99FFAA, 10.0, 4000);

	return 1;
}

CMD:dd(playerid, params[])
{
	if(!GetPlayerTeamEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, " не состоите в организацих");
	else if(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(playerid) <= TEAM_OPG_LYTKARINSKAYA) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна дл сотрудников гос. организаций");
	else if(IsPlayerMuted(playerid) > 0) return SendClientMessage(playerid, 0xFF6600FF, "оступ в чат заблокирован. рем до разблокировки: {66CC33}/time");
	else if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /dd [текст]");

	new fmt_msg[144];

	format(fmt_msg, sizeof fmt_msg, "(( [D] %s %s[%d]: %s ))", GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid, params);

	if(IsAIP(params))
	{
      	SendClientMessage(playerid, -1, "одозрени в рекламе!");
       	return false;
    }

	for(new i; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;
		if(!GetPlayerTeamEx(i)) continue;
		if(GetPlayerData(i, P_ADVISOR_BLOCK_CHAT)) continue;

		SendClientMessage(i, 0xFF9999FF, fmt_msg);
	}

	SetPlayerChatBubble(playerid, "сказал(а) что-то в рацию организаций", 0xDD99FFAA, 10.0, 4000);

	return 1;
}

CMD:r(playerid, params[])
{
	if(!(GetPlayerTeamEx(playerid) || GetPlayerJob(playerid))) return SendClientMessage(playerid, 0xCECECEFF, " нигде не работаете/не состоите в организацих");
	else if(IsPlayerMuted(playerid) > 0) return SendClientMessage(playerid, 0xCECECEFF, "оступ в чат заблокирован. рем до разблокировки: {66CC33}/time");
	else if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /r [текст]");

	new fmt_msg[144];

	format(fmt_msg, sizeof fmt_msg, "[R] %s %s[%d]: %s", GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid, params);

	if(!GetPlayerTeamEx(playerid))
		SendMessageToJob(GetPlayerJob(playerid), fmt_msg), SendClientMessage(playerid,-1,"аботаит");
	else
	    SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_msg, 0x33CC66FF);

	SetPlayerChatBubble(playerid, "сказал(а) что-то в рацию", 0xDD99FFAA, 10.0, 4000);
	return 1;
}

CMD:rn(playerid, params[])
{
	if(!(GetPlayerTeamEx(playerid) || GetPlayerJob(playerid))) return SendClientMessage(playerid, 0xCECECEFF, " нигде не работаете/не состоите в организацих");

	else if(IsPlayerMuted(playerid) > 0) return SendClientMessage(playerid, 0xCECECEFF, "оступ в чат заблокирован. рем до разблокировки: {66CC33}/time");
	else if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /rn [текст]");

	new fmt_msg[144];

	format(fmt_msg, sizeof fmt_msg, "(( OOC: [R] %s %s[%d]: %s ))", GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid, params);

	if(1 <= GetPlayerTeamEx(playerid) < MAX_ORG)
		SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_msg, 0x33CC66FF);
	else
		SendMessageToJob(GetPlayerJob(playerid), fmt_msg, 0x33CC66FF, _);

	SetPlayerChatBubble(playerid, "сказал(а) что-то в рацию", 0xDD99FFAA, 10.0, 4000);
	return 1;
}

CMD:gnews(playerid, params[])
{
	if(!(TEAM_GOVERNMENT <= GetPlayerTeamEx(playerid) <= TEAM_FBI)) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");
	if(!(9 <= GetPlayerJob(playerid) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна лидерам организации и их заместителм");
	if(IsPlayerMuted(playerid) > 0) return SendClientMessage(playerid, 0xFF6600FF, "оступ в чат заблокирован. рем до разблокировки: {66CC33}/time");
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /gnews [текст]");

	if(IsAIP(params))
	{
      	SendClientMessage(playerid, -1, "одозрени в рекламе!");
       	return false;
    }

	new fmt_msg[170 + 1];
	format(fmt_msg, sizeof fmt_msg, "ос.новости: %s[%d]: %s", GetPlayerNameEx(playerid), playerid, params);
	SendClientMessageToAll(0x4466CCFF,  fmt_msg);

	return 1;
}
alias:gnews("gov")

CMD:invite(playerid, params[])
{
	if(!(1 <= GetPlayerTeamEx(playerid) < MAX_ORG)) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");
	if(!(9 <= GetPlayerJob(playerid) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна лидерам организации и их заместителм");
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /invite [id игрока]");

	extract params -> new to_player;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");
	if(1 <= GetPlayerTeamEx(to_player) < MAX_ORG) return SendClientMessage(playerid, 0xCECECEFF, "тот игрок уже состоит в организации");
	if(GetPlayerData(to_player, P_WARN)) return SendClientMessage(playerid, 0xCECECEFF, " игрока ест предупреждени");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 10.0)) return SendClientMessage(playerid, 0xCECECEFF, "грок находитс слишком далеко");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_INVITE);
	return 1;
}

CMD:uninvite(playerid, params[])
{
	if(!(1 <= GetPlayerTeamEx(playerid) < MAX_ORG)) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");
	if(!(9 <= GetPlayerJob(playerid) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна лидерам организации и их заместителм");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /uninvite [id игрока] [причина]");

	extract params -> new to_player, string:reason[32];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(1 <= strlen(reason) <= 32))
		return SendClientMessage(playerid, 0xCECECEFF, "ведите причину уволнени");

	if(GetPlayerTeamEx(to_player) != GetPlayerTeamEx(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей организации");

	if(GetPlayerJob(to_player) >= GetPlayerJob(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "елз уволит уволит заместител/лидера организации");

	UnInvite(playerid, to_player, reason);

	return 1;
}

CMD:rang(playerid, params[])
{
	if(!(1 <= GetPlayerTeamEx(playerid) < MAX_ORG)) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");
	if(!(9 <= GetPlayerJob(playerid) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна лидерам организации и их заместителм");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /rang [id игрока] [+/-]");
	extract params -> new to_player, string:give_rang[2];
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");
	if(GetPlayerTeamEx(to_player) != GetPlayerTeamEx(playerid)) return SendClientMessage(playerid, 0x999999FF, "тот игрок не состоит в ашей организации");
	if(GetPlayerJob(to_player) >= 10) return SendClientMessage(playerid, 0x999999FF, "елз повсит или понизит лидера организации");

	new current_rang = GetPlayerJob(to_player);

	new fmt_msg[75];
	if(give_rang[0] == '+')
	{
		if((current_rang + 1) >= GetPlayerJob(playerid)) return SendClientMessage(playerid, 0x999999FF, "елз повсит болше своего ранга");

		GetPlayerJob(to_player)++;
		format(fmt_msg, sizeof fmt_msg, "аш ранг в организации бл повшен до %d (%s)", GetPlayerJob(to_player), GetPlayerJobAndRankName(to_player));
		SendClientMessage(to_player, 0x3399FFFF, fmt_msg);
	}
	else if(give_rang[0] == '-')
	{
		if((current_rang - 1) < 1) return SendClientMessage(playerid, 0x999999FF, "елз понизит ниже 1 ранга");

		GetPlayerJob(to_player)--;
		format(fmt_msg, sizeof fmt_msg, "аш ранг в организации бл понижен до %d (%s)", GetPlayerJob(to_player), GetPlayerJobAndRankName(to_player));
		SendClientMessage(to_player, 0x3399FFFF, fmt_msg);
	}
	else return SendClientMessage(playerid, 0xCECECEFF, "ведите действие: '+' чтоб повсит или '-' чтоб понизит");

	if(GetPlayerTeamEx(to_player) == TEAM_GOVERNMENT && IsValidDynamic3DTextLabel(GetPlayerData(to_player, P_ADVISOR_LABEL)))
	{
		DestroyDynamic3DTextLabel(GetPlayerData(to_player, P_ADVISOR_LABEL));
		SetPlayerData(to_player, P_ADVISOR_LABEL, Text3D: -1);
	}

	if(!GetPlayerSex(to_player))
	{
		SetPlayerData(playerid, P_OSKIN, GetTeamData(GetPlayerTeamEx(to_player), O_SKINS)[GetPlayerJob(to_player)-1]);
		ResetSkin(to_player);
	}

	format(fmt_msg, sizeof fmt_msg, " %s ранг %s[%d] до %d (%s)", (give_rang[0] == '+') ? ("повсили") : ("понизили"),  GetPlayerNameEx(to_player), to_player, GetPlayerJob(to_player), GetPlayerJobAndRankName(to_player));
	SendClientMessage(playerid, 0x3399FFFF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET org_skin=%d,job=%d WHERE id=%d", GetPlayerData(to_player, P_OSKIN), GetPlayerJob(to_player), GetPlayerAccountID(to_player));
	mysql_query(mysql, fmt_msg, false);

	format(fmt_msg, sizeof fmt_msg, "%s %s[acc:%d] до %d (%s)", (give_rang[0] == '+') ? ("овсил") : ("онизил"),  GetPlayerNameEx(to_player), to_player, GetPlayerJob(to_player), GetPlayerJobAndRankName(to_player));

	SendLog(playerid, LOG_TYPE_FRACTION, fmt_msg);

	return 1;
}

CMD:changeskin(playerid, params[])
{
    if(GetPlayerTeamEx(playerid) < 1 || GetPlayerTeamEx(playerid) >= MAX_ORG)
        return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");

    if(GetPlayerJob(playerid) < 9 || GetPlayerJob(playerid) > 10)
        return SendClientMessage(playerid, 0x999999FF, "ункци доступна лидерам организации и их заместителм");

    if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /changeskin [id игрока]");
    extract params -> new to_player;

    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

    if(GetPlayerTeamEx(to_player) != GetPlayerTeamEx(playerid))
        return SendClientMessage(playerid, 0x999999FF, "тот игрок не состоит в ашей организации");

    if(GetPlayerSex(to_player))
        return SendClientMessage(playerid, 0x999999FF, "елз изменит внешност игрокам с женским полом");

    new team_id = GetPlayerTeamEx(playerid);

    new fmt_str[50];
    new text[256];
    new count;

    SetPVarInt(playerid, "change_team_skin_playerid", to_player);

    for(new i; i < 10; i++)
    {
        new skin_id = GetTeamData(team_id, O_SKINS)[i];

        if(skin_id == 0) continue;

        SetPlayerListitemValue(playerid, count, i);
        format(fmt_str, sizeof fmt_str, "кин %d (ID: %d)\n", count + 1, skin_id);
        strcat(text, fmt_str);

        count++;
    }

    if(count == 0)
        return SendClientMessage(playerid, 0x999999FF, "ет доступнх скинов дл этой организации");

    Dialog(playerid, DIALOG_TEAM_CHANGE_SKIN, DIALOG_STYLE_LIST,
        "берите внешност дл игрока:", text, "к", "тмена");

    return 1;
}

CMD:showall(playerid, params[])
{
	if(!(1 <= GetPlayerTeamEx(playerid) < MAX_ORG)) return SendClientMessage(playerid, 0xCECECEFF, "ам недоступна данна функци");
	if(!(9 <= GetPlayerJob(playerid) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна лидерам организации и их заместителм");

	new query[75];
	format(query, sizeof query, "SELECT name, score, job FROM accounts WHERE team = %d ORDER BY job DESC", GetPlayerTeamEx(playerid));
	mysql_tquery(mysql, query, "ShowOrgAllPlayers", "i", playerid);
	return 1;
}

public: ShowOrgAllPlayers(playerid)
{
	new rows = cache_num_rows();

	new p_name[21];
	new lvl, rang;

	new fmt_str[33];
	new text[1290] = "ровен\tанг\tм\n\n{FFFFFF}";

	new idx, j = rows;
	if(j > 45)
		j = 45;

	for(idx = 0; idx < j; idx ++)
	{
		cache_get_row(idx, 0, p_name);
		lvl = cache_get_row_int(idx, 1);
		rang = cache_get_row_int(idx,2);

		format(fmt_str, sizeof fmt_str, "%d\t%d\t%s\n", lvl, rang, p_name);
		strcat(text, fmt_str);
	}

	format(fmt_str, sizeof fmt_str, "{00CC00}оказан %d/%d игроков", idx, rows);
	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, fmt_str, text, "акрт", "");
	return 1;
}

CMD:find(playerid, params[])
{
	if(!(GetPlayerTeamEx(playerid) || GetPlayerJob(playerid))) return SendClientMessage(playerid, 0xCECECEFF, " нигде не работаете/не состоите в организацих");

	ShowTeamStructureDialog(playerid, GetPlayerTeamEx(playerid));
	return 1;
}

stock ShowTeamStructureDialog(playerid, teamid)
{
	new string[1500];
	new fmt_str[40];

	if(teamid)
	{
		string = "ровен\tанг\tелефон\tм\n\n{FFFFFF}";

		for(new i; i < MAX_PLAYERS; i ++)
		{
			if(!IsPlayerConnected(i)) continue;
			else if(!IsPlayerLogged(i)) continue;
			else if(GetPlayerTeamEx(i) != teamid) continue;

			format(fmt_str, sizeof fmt_str, "%d\t\t%d\t%d\t\t%s", GetPlayerLevel(i), GetPlayerJob(i), GetPlayerPhone(i), GetPlayerNameEx(i));
			strcat(string, fmt_str);

			if(IsPlayerAFK(i))
				strcat(string, "-AFK");

			strcat(string, "\n");
		}

		if(IsTeamSubdivision(teamid))
			Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCC00}лен подразделени online", string, "акрт", "");
		else
			Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCC00}лен организации online", string, "акрт", "");
	}
	else
	{
		string = "ровен\tелефон\tм\n\n{FFFFFF}";

		for(new i; i < MAX_PLAYERS; i ++)
		{
			if(!IsPlayerConnected(i)) continue;
			else if(!IsPlayerLogged(i)) continue;
			else if(GetPlayerJob(i) != GetPlayerJob(playerid)) continue;

			format(fmt_str, sizeof fmt_str, "%d\t%d%s%s", GetPlayerLevel(i), GetPlayerPhone(i), GetPlayerPhone(i) > 0 ? ("\t") : ("\t\t"), GetPlayerNameEx(i));
			strcat(string, fmt_str);

			if(IsPlayerAFK(i))
				strcat(string, "-AFK");

			if(IsPlayerInJob(i))
				strcat(string, " *");

			strcat(string, "\n");
		}

		Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCC00}отрудники online", string, "акрт", "");
	}
	return 1;
}

CMD:leadersooooooooold(playerid, params[])
{
	new fmt_text[75],
		list[sizeof fmt_text * 10 + 50] = "рганизаци - олжност - м - елефон{FFFFFF}\n";

	foreach(new i : Player)
	{
		if(!IsPlayerConnected(i)) continue;
		else if(!IsPlayerLogged(i)) continue;
		else if(!GetPlayerTeamEx(i)) continue;
		else if(GetPlayerJob(i) != 10) continue;

		format(fmt_text, sizeof fmt_text, "\n%s - %s - %s[%d] - %d", GetTeamName(GetPlayerTeamEx(i)), GetPlayerJobAndRankName(i), GetPlayerNameEx(i), i, GetPlayerPhone(i));
		strcat(list, fmt_text);
	}

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCD00}идер онлайн", list, "акрт", "");

	return 1;
}

CMD:liclist(playerid, params[])
