		}
		else SendClientMessage(playerid, 0xCECECEFF, "л исползование этой функции необходим 4 уровен улучшени бизнеса");
	}
	else SendClientMessage(playerid, 0xCECECEFF, " ас нет бизнеса");

	return 1;
}

