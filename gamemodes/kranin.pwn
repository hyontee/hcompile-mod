                else
                {
                    for( new j; j < 20; j++ )
                        format(quick_mes[playerid][j][line], 28, "ведите текст дл пол №%d", j+1);
                    editMessage(playerid);
                }
                SetPVarInt(playerid, #dialog, listitem+1);
            }
			case DIALOG_TEXT_QM:
            {
