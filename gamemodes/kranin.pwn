 return 1;
}

CMD:base(playerid, params[])
{
   if(!IsPlayerInPoliceTeam(playerid)) return SendClientMessage(playerid, 0x999999FF, " не работник правоохранителнх органов");

	new fmt_text[125], list[sizeof(fmt_text)*10];

	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(!IsPlayerConnected(i)) continue;
		else if(!IsPlayerLogged(i)) continue;
		else if(!GetPlayerSuspect(i)) continue;

		format(fmt_text, sizeof fmt_text, "{FFFFFF}#%d. {FF5252}%s[%d]{FFFFFF} - уровен розска: {FF5252}%d\n", i+1, GetPlayerNameEx(i), i, GetPlayerSuspect(i));
		strcat(list, fmt_text);
		SetPlayerListitemValue(playerid, i, i);
	}

	Dialog(playerid, DIALOG_PBASE, DIALOG_STYLE_LIST, "писок преступников", list, "оиск", "акрт");

	return 1;
}

CMD:med(playerid, params[])
{
	if(g_player[playerid][P_MEDKA] == 0) return SCM(playerid, COLOR_WHITE, " вас нет мед-карт!");
	if(sscanf(params, "d", params[0])) return SCM(playerid, COLOR_WHITE, "ведите: /med [id]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");
	new Float:px, Float:py, Float:pz;
	GetPlayerPos(params[0], px, py, pz);
	if(!IsPlayerInRangeOfPoint(params[0], 5.0, px, py, pz)) return SendClientMessage(playerid, 0x999999FF, "грок находитс слишком далеко!");
	new string[128];
	format(string, sizeof(string), "икнейм игрока:{FF5252} %s\n {ffffff}остоние игрока:{FF5252} норме\n {ffffff}ем вдано: {FF5252}ородска болница\n {ffffff}ата вдачи: {FF5252} август", GetPlayerNameEx(playerid));
	SPD(params[0], 99999, DIALOG_STYLE_MSGBOX, "едицинска карта", string, "акрт", "");
	return 1;
}

CMD:cheat(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /cheat [id игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	new ban_time = 9999;

    new reason[999];

	new fmt_msg[999];

	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid))
	return SendClientMessage(playerid, 0xCECECEFF, ""SC"елз забанит администратора вше по рангу");
	if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, ""SC"елз забанит самого себ");

	if(AntiSliv(playerid, "/cheat")) return true;

	format(fmt_msg, sizeof fmt_msg, "дминистратор %s навсегда забанил игрока %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));

	format(fmt_msg, sizeof fmt_msg, "%s. ричина: остороннее ", fmt_msg);

	if(strlen(reason) > 0)
		format(fmt_msg, sizeof fmt_msg, "%s. ричина: %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

    InfoAstats[1] += 1;

	format(fmt_msg, sizeof fmt_msg, "абанил %s[acc:%d] навсегда. ричина: остороннее ", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));

	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_msg);

	AddBan(GetPlayerAccountID(to_player), gettime(), ban_time, GetPlayerNameEx(playerid));
	BanEx(to_player);
	return 1;
}

