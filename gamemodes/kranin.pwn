CMD:givevb(playerid, params[])
{
 if(GetPlayerAdminEx(playerid) < 11) return 1;

    if(!strlen(params)) return SendClientMessage(playerid, 0xffffffff, "{FFFFFF}сползуйте: /givevb [id игрока]");

    extract params -> new to_player;

    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
    return SendClientMessage(playerid, 0xfffffffff, "{FFFFFF}акого игрока нет");

    if(!IsPlayerInRangeOfPlayer(playerid, to_player, 4.0))
    return SendClientMessage(playerid, 0xfffffffffff, "{FFFFFF}грок находитс слишком далеко");

    new fmt_msg[75];
    format(fmt_msg, sizeof fmt_msg, "{FFFFFF}дминистратор %s[%d] вдал ам военнй билет", GetPlayerNameEx(playerid), playerid);
    SendClientMessage(to_player, 0x3399FFFF, fmt_msg);

	new pVoenik;
    SetPlayerData(playerid, pVoenik, 1);
    UpdatePlayerDatabaseInt(playerid, "voenny_bilet", 1);
}

new pVoenik;
CMD:showvb(playerid, params[])
{
 if(GetPlayerData(playerid, pVoenik) == 0) return SendClientMessage(playerid, 0xFFFFF, "{ff0000} ас нету военного билета.");
 if(!strlen(params))
  return SendClientMessage(playerid, 0x999999FF, "{FF5252}| {FFFFFF}сползуйте: /showvb {FF5252}[id игрока]");

 extract params -> new to_player;

 if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
  return SendClientMessage(playerid, 2, "{ff0000}| {FFFFFF}акого игрока нет");

 if(!IsPlayerInRangeOfPlayer(playerid, to_player, 4.0))
  return SendClientMessage(playerid, 0xFFFFFF, "{ff0000}| {FFFFFF}грок находитс слишком далеко");

 new fmt_str[300];

 format(fmt_str, sizeof fmt_str, "%s показал свой военнй билет", to_player == playerid ? "просматривает" : "показал");

 Action(playerid, fmt_str, _, false);

