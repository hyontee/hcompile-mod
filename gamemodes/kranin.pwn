										{
											SendClientMessage(playerid, 0x66CC00FF, "епер ваши клиент будут слшат звук при входе в бизнес");
											SendClientMessage(playerid, 0x999999FF, " также можете помент или включит его командой {FF9900}/bizmusic");
										}
