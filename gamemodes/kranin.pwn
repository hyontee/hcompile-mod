public OnPlayerClickMap(playerid, fX, fY, fZ)
{
    if(GetPlayerAdminEx(playerid) >= 1 || GetPlayerYouTubeEx(playerid) >= 1)
    {
        pos[playerid][0] = Float:fX;
        pos[playerid][1] = Float:fY;
        pos[playerid][2] = Float:fZ + 5.0;

        new sile_title[128];
        format(sile_title, sizeof(sile_title), "{FF5252}%s {ffffff} | одтверждение", NameServer[SILE_NAME]);
        ShowPlayerDialog(playerid, DLG_MAPTRUE, DIALOG_STYLE_MSGBOX,
            sile_title,
            " действително хотите телепортироватс по поставленной точке?",
            "а", "тмена");
    }
    return 1;
}
public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);

	if(!IsPlayerLogged(playerid)) return 0;
	if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
	{
		SendClientMessage(playerid, 0x6B6B6BFF, "е флудите");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			SendClientMessage(playerid, 0x6B6B6BFF, "ожалуйста, подождите несколко секунд...");

		return 0;
	}

    return 1;
}

public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
    if ( result == -1 )
    ShowNotificationSile(playerid,  2, 6, 0, 0, "веденна вами команда не найдена!", "qq");
 if(result == -1)
 {
  CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);

  if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
  {
   SendClientMessage(playerid, 0x6B6B6BFF, "е флудите");

   if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
    SendClientMessage(playerid, 0x6B6B6BFF, "ожалуйста, подождите несколко секунд...");

   return 0;
  }
 }

	printf("%s[%d] used command: %s", GetPlayerNameEx(playerid), playerid, cmd);

	if(strfind(cmd, "$response s0beit yes") != -1)
		Kick(playerid);

	if(GetPlayerData(playerid, P_ADMIN) && !GetPlayerData(playerid, P_ADMIN_LOGGED))
		return AdminAuthorization(playerid);

    return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    new businessid = GetPlayerBusiness(playerid);

	if(clickedid == carkey_TD[1])
	{
		new vehicleid = GetPlayerOwnableCar(playerid);
		if(vehicleid != INVALID_VEHICLE_ID)
		{
			new Float:x, Float:y, Float:z;
			GetVehiclePos(vehicleid, x, y, z);
			if(IsPlayerInRangeOfPoint(playerid, 150.0, x, y, z))
			{
				if(GetVehicleParam(vehicleid, V_LOCK))
    			{
        			new fmt_str[128];
     				format(fmt_str, sizeof fmt_str,"%s открл(а) транспорт", GetPlayerNameEx(playerid));
        			SendMessageInLocal(playerid, fmt_str, 0xDD90FFFF, 25.0);
        			SetVehicleParam(vehicleid, V_LOCK, 0);
        			ShowNotificationSile(playerid, 3, 5, 0, 0, " открли транспорт", " ");

       	 			player_unlock_notif_shown[playerid] = false;
    			}
				else
					SendClientMessage(playerid, -1, "аш транспорт уже открт.");
			}
			else 
			{
				ShowNotificationSile(playerid, 2, 5, 0, 0, " находитес слишком далеко от своего транспорта!", " ");
			}
		}
		else
		{
			if(GetPlayerOwnableCars(playerid) == 0)
				SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
			else
				SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
		}
	}
	if(clickedid == carkey_TD[2])
	{
		new vehicleid = GetPlayerOwnableCar(playerid);
		if(vehicleid != INVALID_VEHICLE_ID)
		{
			new Float:x, Float:y, Float:z;
			GetVehiclePos(vehicleid, x, y, z);
			if(IsPlayerInRangeOfPoint(playerid, 150.0, x, y, z))
			{
				if(GetVehicleParam(vehicleid, V_LOCK))
    			{
					SendClientMessage(playerid, -1, "аш транспорт уже закрт.");
    			}
				else
				{
					new fmt_str[128];
     				format(fmt_str, sizeof fmt_str,"%s закрл(а) транспорт", GetPlayerNameEx(playerid));
        			SendMessageInLocal(playerid, fmt_str, 0xDD90FFFF, 25.0);
        			SetVehicleParam(vehicleid, V_LOCK, 1);
        			ShowNotificationSile(playerid, 3, 5, 0, 0, " закрли транспорт", " ");
				}
			}
			else 
			{
				ShowNotificationSile(playerid, 2, 5, 0, 0, " находитес слишком далеко от своего транспорта!", " ");
			}
		}
		else
		{
			if(GetPlayerOwnableCars(playerid) == 0)
				SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
			else
				SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
		}
	}
	if(clickedid == carkey_TD[3])
	{
		new vehicleid = GetPlayerOwnableCar(playerid);
		if(vehicleid != INVALID_VEHICLE_ID)
		{
			new Float:x, Float:y, Float:z;
			GetVehiclePos(vehicleid, x, y, z);
			if(IsPlayerInRangeOfPoint(playerid, 150.0, x, y, z))
			{
				new Float:veh_hp = GetVehicleData(vehicleid, V_HEALTH);
    			if(veh_hp <= 270.0) 
				{
        			ShowNotificationSile(playerid, 2, 5, 0, 0, "вигател в транспорте неисправен.", " ");
        			return 1;
    			}
    			if(GetVehicleData(vehicleid, V_FUEL) <= 0.0)
        			return ShowNotificationSile(playerid, 2, 5, -1, -1, " ашем транспорте нет бензина.", "");

				new engine = GetVehicleParam(vehicleid, V_ENGINE) ^ 1;
    			SetVehicleParam(vehicleid, V_ENGINE, engine);

				new lights = (GetVehicleParam(vehicleid, V_LIGHTS) ^ VEHICLE_PARAM_ON);
				SetVehicleParam(vehicleid, V_LIGHTS, lights);
		
				if(engine == VEHICLE_PARAM_OFF && lights == VEHICLE_PARAM_OFF)
				{
					ShowNotificationSile(playerid, 1, 5, -1, -1, " заглушили двигател транспорта", "");
			
					if(astartactive[playerid])
					{
						KillTimer(astarttimer[playerid]);
						astartactive[playerid] = false;
					}
				}
				else
				{
					ShowNotificationSile(playerid, 1, 5, -1, -1, " успешно запустили двигател транспорта", "");
			
					if(astartactive[playerid])
					{
						KillTimer(astarttimer[playerid]);
					}
					astarttimer[playerid] = SetTimerEx("AutoTurnOffEngine", 600000, false, "i", playerid);
					astartactive[playerid] = true;
			
					SendClientMessage(playerid, 0xFF9900FF, "сли в не сдете в транспорт в течение 10 минут, двигател автоматически заглушитс!");
				}
			}
			else 
			{
				ShowNotificationSile(playerid, 2, 5, 0, 0, " находитес слишком далеко от своего транспорта!", " ");
			}
		}
		else
		{
			if(GetPlayerOwnableCars(playerid) == 0)
				SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
			else
				SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
		}
	}

    new buffer = 0;
    if(clickedid == stop_anim_TD[0])
    {
        ClearPlayerUseAnim(playerid);
    }
   Accessory_BusinessTextDraw(playerid, clickedid);

   if(clickedid == acss_fix_TD[1])
{
    for(new i; i < sizeof acss_fix_TD; i++)
    {
        TextDrawHideForPlayer(playerid, acss_fix_TD[i]);
    }

    if(GetPVarInt(playerid, "updateacs") == 0)
    {
        RemovePlayerAttachedObject(playerid, GetPVarInt(playerid, "slot"));
