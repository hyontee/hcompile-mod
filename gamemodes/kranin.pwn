					GetPlayerName(playerid, playerName, sizeof(playerName));

					format(fmt_text, sizeof fmt_text,
					"{00D9FF}дминистраци:{FFFFFF} %s {AAAAAA}[%d]{FFFFFF} авторизовалс как {FF5252}%s",
					playerName, playerid, admin_rank[adminLevel - 1]);
					SendMessageToAdmins(fmt_text, 0x00D9FFFF);

				}

				SetPlayerData(playerid, P_ADMIN_LOGGED, 1);

				if(GetPlayerAdminWarn(playerid) > 0)
				{
					format(fmt_text, 256, "{FF6600} ас ест %i вговор(а), некоторе команд бли заблокирован.", GetPlayerAdminWarn(playerid));
					SendClientMessage(playerid, -1, fmt_text);
				}

				return 1;
			}

			case DIALOG_ADMIN_REG:
			{
