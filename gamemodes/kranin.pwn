if(dialogid == DIALOG_REPORT_CLAIM)
{
    if (response)
    {
        if (strlen(inputtext) > 500)
        {
            SendClientMessage(playerid, -1, "аксималное количество символов 500");
            return 1;
        }

        if (strlen(inputtext) == 0) return 1;

        utf8_to_cp1251(inputtext);

        SendReport(playerid, inputtext);
        UpdateReportText();

        new fmt_text[200];
        format(fmt_text, sizeof fmt_text, "{008000}[R] алоба от %s[%d]: {FF5252}%s", GetPlayerNameEx(playerid), playerid, inputtext);
        SendMessageToAdmins(fmt_text, 0xFFFFFFFF);

        SendClientMessage(playerid, -1, "{FF5252}| {FFFFFF}аша жалоба бла отправлена администрации сервера, ожидайте ответа.");
        return 1;
