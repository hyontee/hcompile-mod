							EnablePlayerGPS(playerid, 35, GetEntranceData(ent_id, E_POS_X), GetEntranceData(ent_id, E_POS_Y), GetEntranceData(ent_id, E_POS_Z), "одъезд квартир должника отмечена у ас на GPS");
