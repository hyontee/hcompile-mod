			case DIALOG_SECURITY_SETTING_INFO:
			{
				ShowPlayerSecuritySettings(playerid);
				return 1;
			}
			case DIALOG_SECURITY_SETTING_PHONE:
			{
				if(!strcmp(GetPlayerData(playerid, P_SETTING_PHONE), "None", true)) return 1;

				if(response)
				{
					if(0 <= listitem && listitem <= 2)
					{
						new query[64 + 1];
						SetPlayerData(playerid, P_REQUEST_PHONE, listitem);

						format(query, sizeof query, "UPDATE accounts SET request_phone=%d WHERE id=%d LIMIT 1", listitem, GetPlayerAccountID(playerid));
						mysql_query(mysql, query, false);

						if(!mysql_errno())
						{
							SendClientMessage(playerid, 0xFFFFFFFF, "зменени в настройках безопасности {00FFCC}сохранен");
							switch(listitem + 1)
							{
								case 1: SendClientMessage(playerid, 0xFF6600FF, "апрос на ввод мобилного телефона отключен");
								case 2: SendClientMessage(playerid, 0xFF5252FF, "аш мобилнй телефон будет запрашиватс при несовпадении подсети");
								case 3: SendClientMessage(playerid, 0x66CC00FF, "обилнй телефон будет запрашиватс при несовпадении IP адресов");
							}
						}
						else
						{
							SendClientMessage(playerid, 0xFFFFFFFF, "зменени в настройках безопасности {FF3333}не сохранен");
							SendClientMessage(playerid, 0xFF6600FF, "шибка сохранени, повторите поптку {FF0000}(equ-code 03)");
						}
					}
				}
				ShowPlayerSecuritySettings(playerid);
			}
			case DIALOG_SECURITY_SETTING_PHONE_S:
			{
				if(strcmp(GetPlayerData(playerid, P_SETTING_PHONE), "None", true) != 0) return 1;
				return 1;
			}
			case DIALOG_SECURITY_SETTING_PIN:
			{
				if(!strcmp(GetPlayerData(playerid, P_SETTING_PIN), "None", true)) return 1;

				if(response)
				{
					switch(listitem + 1)
					{
						case 1:
						{
							ShowPlayerPinCodePTD(playerid, PIN_CODE_STATE_CHANGE);
						}
						case 2:
						{
							ShowPlayerPinCodePTD(playerid, PIN_CODE_STATE_CHECK);
							pin_code_action[playerid] = 2;
						}
					}
				}
			}
			case DIALOG_PIN_CODE:
			{
				if(!response)
				{
					HidePlayerPinCodePTD(playerid, false);
					return 1;
				}

				new pc_state = GetPlayerPinCodeState(playerid);
				new action = pin_code_action[playerid];
				new bool: valid = true;

				if(strlen(inputtext) != 4)
					valid = false;
				else
				{
					for(new i = 0; i < 4; i++)
					{
						if(inputtext[i] < '0' || inputtext[i] > '9')
						{
							valid = false;
							break;
						}
					}
				}

				if(!valid)
				{
					SendClientMessage(playerid, 0xFF6600FF, "PIN-код должен состот из 4 цифр");
					ShowPlayerPinCodePTD(playerid, pc_state);
					return 1;
				}

				format(pin_code_input[playerid], 5, "%s", inputtext);

				switch(pc_state)
				{
					case PIN_CODE_STATE_SET, PIN_CODE_STATE_CHANGE:
					{
						new query[75];

						mysql_format(mysql, query, sizeof query, "UPDATE accounts SET setting_pin_code='%e' WHERE id=%d LIMIT 1", pin_code_input[playerid], GetPlayerAccountID(playerid));
						mysql_query(mysql, query, false);

						if(!mysql_errno())
						{
							format(g_player[playerid][P_SETTING_PIN], 5, "%s", pin_code_input[playerid]);

							mysql_format(mysql, query, sizeof query, "PIN-код %s: {FF5252}%s", pc_state == PIN_CODE_STATE_SET ? ("успешно установлен") : ("изменен на"), GetPlayerData(playerid, P_SETTING_PIN));
							SendClientMessage(playerid, 0x66CC00FF, query);
							SendClientMessage(playerid, 0x66CC00FF, "апомните или запишите это число");

							pin_code_action[playerid] = 0;
							HidePlayerPinCodePTD(playerid, false);
							ShowPlayerSecuritySettings(playerid);
						}
						else
						{
							SendClientMessage(playerid, 0xFF6600FF, "шибка сохранени, повторите поптку {FF0000}(equ-code 04)");
							ShowPlayerPinCodePTD(playerid, pc_state);
						}
						return 1;
					}
					case PIN_CODE_STATE_CHECK:
					{
						if(strcmp(pin_code_input[playerid], GetPlayerData(playerid, P_SETTING_PIN)) != 0)
						{
							SendClientMessage(playerid, 0xFF6600FF, "PIN-код введен неверно");
							HidePlayerPinCodePTD(playerid, false);
							ShowPlayerSecuritySettings(playerid);
						}
						else
						{
							if(action == 1)
							{
								pin_code_action[playerid] = 0;
								HidePlayerPinCodePTD(playerid, false);
								ShowPlayerPinCodePTD(playerid, PIN_CODE_STATE_CHANGE);
							}
							else if(action == 2)
							{
								new query[128];
								SetPlayerData(playerid, P_REQUEST_PIN, 0);
								format(query, sizeof query, "UPDATE accounts SET setting_pin_code='None', request_pin=0 WHERE id=%d LIMIT 1", GetPlayerAccountID(playerid));
								mysql_query(mysql, query, false);
								format(g_player[playerid][P_SETTING_PIN], 5, "None");
								if(!mysql_errno())
								{
									SendClientMessage(playerid, 0x66CC00FF, "PIN-код успешно удален");
								}
								else
								{
									SendClientMessage(playerid, 0xFF6600FF, "шибка удалени PIN-кода, повторите поптку");
								}
								pin_code_action[playerid] = 0;
								HidePlayerPinCodePTD(playerid, false);
								ShowPlayerSecuritySettings(playerid);
							}
							else
							{
								HidePlayerPinCodePTD(playerid, false);
								ShowPlayerPinCodePTD(playerid, PIN_CODE_STATE_CHANGE);
							}
						}
						return 1;
					}
					case PIN_CODE_STATE_LOGIN_CHECK:
					{
						if(!IsPlayerLogged(playerid))
						{
							if(GetPlayerData(playerid, P_ACCOUNT_STATE) == ACCOUNT_STATE_LOGIN)
							{
								new step = GetPlayerData(playerid, P_ACCOUNT_STEP_STATE);
								new bool: wrong_pass = false;

								if(!strlen(GetPlayerData(playerid, P_SETTING_PIN)) || strcmp(GetPlayerData(playerid, P_SETTING_PIN), pin_code_input[playerid]) != 0)
								{
									wrong_pass = true;
									step--;
								}

								HidePlayerPinCodePTD(playerid, false);
								ShowPlayerLoginDialog(playerid, step + 1, wrong_pass);
							}
						}
						return 1;
					}
				}
				return 1;
			}

                        case DIALOG_SECURITY_SETTING_PIN_SET:
                        {
                            if(strcmp(GetPlayerData(playerid, P_SETTING_PIN), "None", true) != 0) return 1;

                            if(response)
                            {
                                ShowPlayerPinCodePTD(playerid, PIN_CODE_STATE_SET);
                            }
                            else
                            {
                                ShowPlayerSecuritySettings(playerid);
                            }
                            return 1;
                        }
			case DIALOG_SECURITY_SETTING_PASS_1:
			{
				if(response)
				{
					strmid(CheckPass[playerid], inputtext, 0, strlen(inputtext), 65);
					new hash[65];
       				SHA256_PassHash(CheckPass[playerid], GetPlayerData(playerid, P_SALT), hash, 65);

					if(!strcmp(hash, GetPlayerData(playerid, P_PASSWORD)))
					{
						Dialog
						(
							playerid, DIALOG_SECURITY_SETTING_PASS_2, DIALOG_STYLE_INPUT,
							"{FFCD00}овй парол",
							"{FFFFFF}ведите новй парол в поле ниже:",
							"зменит", "тмена"
						);
