CMD:astart(playerid)
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		new Float:veh_hp = GetVehicleData(vehicleid, V_HEALTH);
    	if(veh_hp <= 270.0) 
		{
        	ShowNotificationSile(playerid, 2, 5, 0, 0, "вигател в транспорте неисправен.", " ");
        	return 1;
    	}
    	if(GetVehicleData(vehicleid, V_FUEL) <= 0.0)
        	return ShowNotificationSile(playerid, 2, 5, -1, -1, " ашем транспорте нет бензина.", "");

		new Float:x, Float:y, Float:z;
		GetVehiclePos(vehicleid, x, y, z);
		if(!IsPlayerInRangeOfPoint(playerid, 50.0, x, y, z))
		{
			ShowNotificationSile(playerid, 2, 5, 0, 0, " находитес слишком далеко от своего транспорта!", " ");
			return 1;
		}

    	new engine = GetVehicleParam(vehicleid, V_ENGINE) ^ 1;
    	SetVehicleParam(vehicleid, V_ENGINE, engine);

		new lights = (GetVehicleParam(vehicleid, V_LIGHTS) ^ VEHICLE_PARAM_ON);
		SetVehicleParam(vehicleid, V_LIGHTS, lights);
		
		if(engine == VEHICLE_PARAM_OFF && lights == VEHICLE_PARAM_OFF)
		{
			ShowNotificationSile(playerid, 1, 5, -1, -1, " заглушили транспорт", "");
			SendClientMessage(playerid, -1, "л включени двигател исползуйте команду /astart");
			
			if(astartactive[playerid])
			{
				KillTimer(astarttimer[playerid]);
				astartactive[playerid] = false;
			}
		}
		else
		{
			ShowNotificationSile(playerid, 1, 5, -1, -1, " успешно запустили транспорт", "");
			SendClientMessage(playerid, -1, "л включени двигател исползуйте команду /astart");
			
			if(astartactive[playerid])
			{
				KillTimer(astarttimer[playerid]);
			}
			astarttimer[playerid] = SetTimerEx("AutoTurnOffEngine", 600000, false, "i", playerid);
			astartactive[playerid] = true;
			
			SendClientMessage(playerid, 0xFF9900FF, "сли в не сдете в транспорт в течение 10 минут, двигател автоматически заглушитс!");
		}
	}
	else
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
		else
			SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}
}

forward AutoOffEngine(playerid);
public AutoOffEngine(playerid)
{
	if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid))
		return 1;
	
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid == INVALID_VEHICLE_ID)
		return 1;
	
	if(IsPlayerInVehicle(playerid, vehicleid))
	{
		astartactive[playerid] = false;
		SendClientMessage(playerid, -1, " сели в транспорт, автоматическое глушение отменено!");
		return 1;
	}
	
	new Float:x, Float:y, Float:z;
	GetVehiclePos(vehicleid, x, y, z);
	
	if(!IsPlayerInRangeOfPoint(playerid, 250.0, x, y, z))
	{
		SetVehicleParam(vehicleid, V_ENGINE, VEHICLE_PARAM_OFF);
		SetVehicleParam(vehicleid, V_LIGHTS, VEHICLE_PARAM_OFF);
		astartactive[playerid] = false;
		
		ShowNotificationSile(playerid, 2, 5, -1, -1, "ранспорт заглушен из-за длителного бездействи!", "");
		SendClientMessage(playerid, -1, " отошли от транспорта. вигател автоматически заглушен.");
		
		return 1;
	}
	
	SendClientMessage(playerid, -1, "ранспорт будет заглушен через 10 минут, если в не сдете в него!");
	astarttimer[playerid] = SetTimerEx("AutoOffEngine", 600000, false, "i", playerid);
	
	return 1;
}

CMD:givedonateall(playerid, params[])
{
  if(GetPlayerAdminEx(playerid) < 13) return 1;

  extract params -> new donate; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /givedonateall [cумма]");

  if(!(-100_000 <= donate <= 100_000)) return SendClientMessage(playerid, 0xCECECEFF, "ожно вдават до 100.000 доната за один раз");

  new reason[144];
  
  for(new i = 0; i < MAX_PLAYERS; i++) 
    { 
    GivePlayerDonateRub(i, donate, reason, true, true);

  format(reason, sizeof reason, "{FFD700}дминистратор %s вдал всем игрокам %d доната", GetPlayerNameEx(playerid), donate);
  SendClientMessageToAll(0xFFFFFFFF, reason);
  }

  return 1;
}

CMD:givemoneyall(playerid, params[])
{
  if(GetPlayerAdminEx(playerid) < 13) return 1;

  extract params -> new cash; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /givemoneyall [cумма]");

  if(!(-100_000_000 <= cash <= 100_000_000)) return SendClientMessage(playerid, 0xCECECEFF, "ожно вдават до 100.000.000 рублей за один раз");

  new reason[144];
  
  for(new i = 0; i < MAX_PLAYERS; i++) 
    { 
    GivePlayerMoneyEx(i, cash, reason, true, true);

  format(reason, sizeof reason, "{FFD700}дминистратор %s вдал всем игрокам %d рублей", GetPlayerNameEx(playerid), cash);
  SendClientMessageToAll(0xFFFFFFFF, reason);
  }

  return 1;
}

