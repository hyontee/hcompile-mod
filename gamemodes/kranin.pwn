forward DeliveryTimerOrderP(playerid);
public DeliveryTimerOrderP(playerid)
{
	 if(DeliveryTimerOrder[playerid] != -1)
     {
    	 KillTimer(DeliveryTimerOrder[playerid]);
         DeliveryTimerOrder[playerid] = -1;
     }
     if(DeliveryTimerMoney[playerid] != -1)
     {
    	 KillTimer(DeliveryTimerMoney[playerid]);
         DeliveryTimerMoney[playerid] = -1;
     }
	ShowPlayerProgressGUI(playerid, 1, 50, 100, 100, 1, 25, "олучение денег..");
    DeliveryTimerMoney[playerid] = SetTimerEx("DeliveryTimerMoneyP", 2500, false, "i", playerid);
	KillTimer(DeliveryTimerOrder[playerid]);
	DeliveryTimerOrder[playerid] = -1;	
} 

forward DeliveryTimerMoneyP(playerid);
public DeliveryTimerMoneyP(playerid)
{
	
      if(DeliveryTimerMoney[playerid] != -1)
     {
    	 KillTimer(DeliveryTimerMoney[playerid]);
         DeliveryTimerMoney[playerid] = -1;
     }
      KillTimer(DeliveryTimerMoney[playerid]);
      DeliveryTimerMoney[playerid] = -1;
      new nextcheckpoint, randomMoney = 70000 + random(100001);  
                    
     do 
     {
         nextcheckpoint = random(10);
      } while(DeliveryLastCheckpoint[playerid] == nextcheckpoint);
                    
      DeliveryLastCheckpoint[playerid] = nextcheckpoint;
      DisablePlayerCheckpoint(playerid);
      EnablePlayerGPS(playerid, 55, DeliveryCheckpoint[nextcheckpoint][0], DeliveryCheckpoint[nextcheckpoint][1], DeliveryCheckpoint[nextcheckpoint][2], " доставили заказ на нужную точку. а карте отмечена нова точка, отправлйтес туда");
      SendClientMessage(playerid, COLOR_LIGHTBLUE, "л завершени работ и получени зарплат {FF5252}/gps - сновне работ - урерска служба доставки");
      DeliveryCheck[playerid] = nextcheckpoint;
      DeliverySalaryEnd[playerid] += randomMoney;
      AddZP(playerid, randomMoney);
      UpdateTextDrawsZP(playerid);
}

stock FreezePlayerEx(playerid)
{
    TogglePlayerControllable(playerid, 0);
    SetPlayerData(playerid, P_FREEZE, true);
    return 1;
}

stock unFreezePlayerEx(playerid)
{
    TogglePlayerControllable(playerid, 1);
    SetPlayerData(playerid, P_FREEZE, false);
    return 1;
}

stock ShowVehicleTrunkNotification(playerid)
{
    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        new vehicleid = -1;
        new Float: x, Float: y, Float: z;
        new Float: angle, Float: distance;
        
        for(new i = 1; i < MAX_VEHICLES; i++)
        {
            if(!IsValidVehicle(i)) continue;
            
            GetCoordVehicle(i, VEHICLE_COORD_TYPE_BOOT, x, y, z, angle, distance);
            
            if(IsPlayerInRangeOfPoint(playerid, 1.5, x, y, z))
            {
                vehicleid = i;
                break;
            }
        }
        
        if(vehicleid != -1)
        {
            new action_type = GetVehicleData(vehicleid, V_ACTION_TYPE);
            
            if(action_type == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
            {
                new car_id = GetVehicleData(vehicleid, V_ACTION_ID);
                new bool:has_access = false;
                
                if(action_type == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
                {
                    if(GetOwnableCarData(car_id, OC_OWNER_ID) == GetPlayerAccountID(playerid))
                        has_access = true;
                }
                if(has_access)
                {
                    ShowNotificationSile(playerid, 5, 5, OFFER_TRUNK, -1, "агажник транспорта закрт", "ткрт");
                }
            }
        }
    }
}

forward CheckNearbyTrunk();
public CheckNearbyTrunk()
{
    foreach(new playerid : Player)
    {
        if(IsPlayerLogged(playerid) && !IsPlayerInAnyVehicle(playerid))
        {
            ShowVehicleTrunkNotification(playerid);
        }
    }
    return 1;
}



forward AutoRestart();
public AutoRestart()
{
    new hour, minute, second;
    gettime(hour, minute, second);
    
    if(hour == 5 && minute == 0 && second == 0)
    {
        if(!restart_active && restart_timer == -1)
        {
       	 foreach(new i : Player)
      	  {
     			if(IsPlayerConnected(i))
    			 {
   					SendClearChat(i);
           			SetTimerEx("ClearChat", 65, false, "ii", i, CH_RESTART2);
   			  } 
    		} 
       	 
            restart_timer = SetTimer("DoRestart", 60000, false);
            restart_active = true;
        }
    }
}

forward DoRestart();
public DoRestart()
{
    restart_timer = -1;
    restart_active = false;
    SendRconCommand("gmx");
}

stock ShowAdminInfoDialog(playerid)
{
	if(GetPlayerData(playerid, P_ADM_STDI) == 0)
	{
		new fmt[512];
		format(fmt, sizeof(fmt), "{FFFFFF}обро пожаловат, {FFB700}%s!\n\
		\n\
		{FFFFFF} — администратор проекта {FF5533}SILE RUSSIA{FFFFFF}.\n\
		аша задача: поддерживат пордок на сервере и помогат игрокам.\n\
		ктивна и качественна работа может бт отмечена дополнителнми наградами от руководства.\n\
		\n\
		{FFFFFF}л продолжени работ нажмите кнопку {FFB700}алее,\n\
		{FFFFFF}осле чего введите аш администраторский парол.", GetPlayerNameEx(playerid));
	
		ShowPlayerDialog(playerid, DIALOG_ADM_STDI, DIALOG_STYLE_MSGBOX, "{FF5533}SILE RUSSIA {FFFFFF}| нформаци", fmt, "алее", "");
	}
	else if(GetPlayerData(playerid, P_ADM_STDI) == 1)
	{
           AdminAuthorization(playerid);
	}
	return 1;
}

CMD:pay(playerid, params[])
{
    new to_player, money;

    if(sscanf(params, "ui", to_player, money)) return SendClientMessage(playerid, -1, "ведите /pay [айди игрока] [сумма]");

    if(money <= 0) return SendClientMessage(playerid, -1, "умма должна бт болше 0!");

    if(!IsPlayerConnected(to_player))
        return ShowNotificationSile(playerid, 2, 6, -1, -1, "грок не найден!", "");

    if(!IsPlayerInRangeOfPlayer(playerid, to_player, 5.0))
        return ShowNotificationSile(playerid, 2, 6, -1, -1, "грок находитс слишком далеко", "");

    if(playerid == to_player)
        return SendClientMessage(playerid, -1, "елз перевести денги самому себе!");

    new pl_vip = GetPlayerData(playerid, P_PREMIUM);
    new max_money = 2500; 

    switch(pl_vip)
    {
        case 0: max_money = 2500;
        case 1: max_money = 10000;
        case 2: max_money = 25000;
        case 3: max_money = 50000;
        default: max_money = 2500;
    }

    if(money > max_money)
    {
        new msg[128];
        format(msg, sizeof(msg), "умма должна бт от 1 до %d", max_money);
        return SendClientMessage(playerid, -1, msg);
    }

    if(GetPlayerMoney(playerid) < money)
        return SendClientMessage(playerid, -1, " вас недостаточно денег!");

    GivePlayerMoneyEx(playerid, -money);
    GivePlayerMoneyEx(to_player, money);

    new fmt[128];
    format(fmt, sizeof(fmt), " передали %d руб. игроку %s[%d]", money, GetPlayerNameEx(to_player), to_player);
    SendClientMessage(playerid, -1, fmt);

    format(fmt, sizeof(fmt), "грок %s[%d] передал вам %d руб.", GetPlayerNameEx(playerid), playerid, money);
    SendClientMessage(to_player, -1, fmt);

    new msg_near[256];
    format(msg_near, sizeof(msg_near), "[еревод] %s[%d] передал %d руб. игроку %s[%d]",
           GetPlayerNameEx(playerid), playerid, money, GetPlayerNameEx(to_player), to_player);

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        if(i == playerid || i == to_player) continue; 

        if(IsPlayerInRangeOfPlayer(i, playerid, 10.0) || IsPlayerInRangeOfPlayer(i, to_player, 10.0))
        {
            SendClientMessage(i, 0xFFFF00AA, msg_near); 
        }
    }

    return 1;
}


stock ShowPlayerDonateMain(playerid)
{
    new Node:donate_outcoming_json = JSON_Object(), promotions_array_len;
    
    JSON_ArrayLength(g_player_donate_data[playerid][JSON_PROMOTIONS_ARRAY], promotions_array_len);
    
    if(promotions_array_len == 0)
    {
        RestorePlayerPromotions(playerid);
    }
    
    JSON_SetInt(donate_outcoming_json, "o", 1);
    JSON_SetInt(donate_outcoming_json, "lc", 6); 
    
    if(strcmp("None", GetPlayerData(playerid, P_EMAIL)))
    {
        JSON_SetString(donate_outcoming_json, "em", GetPlayerData(playerid, P_EMAIL));
    }
    
    JSON_SetString(donate_outcoming_json, "nm", GetPlayerNameEx(playerid));
    JSON_SetInt(donate_outcoming_json, "ds", 0);
    JSON_SetInt(donate_outcoming_json, "sv", 1);
    JSON_SetInt(donate_outcoming_json, "r", GetPlayerMoney(playerid));
    JSON_SetInt(donate_outcoming_json, "d", GetPlayerDonateRub(playerid));
    JSON_SetArray(donate_outcoming_json, "s", g_player_donate_data[playerid][JSON_PROMOTIONS_ARRAY]);
    JSON_SetInt(donate_outcoming_json, "p", 7200);
    
    ShowPlayerGUI(playerid, 22, donate_outcoming_json);
}

