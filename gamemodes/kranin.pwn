		"%s:\t\t\t%s\n\n"\
		"%s"\
		"абота / должност:\t\t%s\n"\
		"анг:\t\t\t\t%s\n\n"\
		"роживание:\t\t\t%s\n"\
		"изнес:\t\t\t%s\n"\
		"гровой статус:\t\t%s\n",
		GetPlayerNameEx(to_player),
		GetPlayerLevel(to_player),
		GetPlayerExp(to_player),
		GetExpToNextLevel(to_player),
		GetPlayerPhone(to_player),
		GetPlayerData(to_player, P_PHONE_BALANCE),
