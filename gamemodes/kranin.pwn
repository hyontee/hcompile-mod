		return SendClientMessage(playerid, 0xCECECEFF, " ас нет такого количества патронов");

	new fmt_text[80];

	if((GetPlayerData(to_player, P_AMMO) + give_ammo_count) > GetPlayerMaxStorage(to_player, STORAGE_AMMO))
	{
		format(fmt_text, sizeof fmt_text, "грок не может унести с собой столко патронов (максимум %d шт)", GetPlayerMaxStorage(to_player, STORAGE_AMMO));
		SendClientMessage(playerid, 0xCECECEFF, fmt_text);
	}

	AddPlayerData(playerid, P_AMMO, -, give_ammo_count);
	UpdatePlayerDatabaseInt(playerid, "ammo", GetPlayerData(playerid, P_AMMO));

	AddPlayerData(to_player, P_AMMO, +, give_ammo_count);
	UpdatePlayerDatabaseInt(to_player, "ammo", GetPlayerData(playerid, P_AMMO));

	format(fmt_text, sizeof fmt_text, "~b~-%d patr.", give_ammo_count);
	GameTextForPlayer(playerid, fmt_text, 4000, 1);

	format(fmt_text, sizeof fmt_text, "~b~+%d patr.", give_ammo_count);
	GameTextForPlayer(to_player, fmt_text, 4000, 1);

	format(fmt_text, sizeof fmt_text, " передали атрон игроку %s (%d шт.)", GetPlayerNameEx(to_player), give_ammo_count);
	SendClientMessage(playerid, 0x3399FFFF, fmt_text);

	format(fmt_text, sizeof fmt_text, "грок %s передал ам атрон (%d шт.)", GetPlayerNameEx(playerid), give_ammo_count);
	SendClientMessage(to_player, 0x3399FFFF, fmt_text);

	return 1;
}

CMD:givedrugs(playerid, params[])
{
	extract params -> new to_player, give_drugs_count; else return SendClientMessage(playerid, 0x999999FF, "сползуйте: /givedrugs [id игрока] [кол-во в г]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(give_drugs_count <= 0) return SendClientMessage(playerid, 0x999999FF, "еверное количество наркотиков");

	if(give_drugs_count > GetPlayerData(playerid, P_DRUGS))
		return SendClientMessage(playerid, 0xCECECEFF, " ас нет такого количества наркотиков");

	new fmt_text[80];

	if((GetPlayerData(to_player, P_DRUGS) + give_drugs_count) > GetPlayerMaxStorage(to_player, STORAGE_DRUGS))
	{
		format(fmt_text, sizeof fmt_text, "грок не может унести с собой столко наркотиков (максимум %d г)", GetPlayerMaxStorage(to_player, STORAGE_DRUGS));
		SendClientMessage(playerid, 0xCECECEFF, fmt_text);
	}

	AddPlayerData(playerid, P_DRUGS, -, give_drugs_count);
	UpdatePlayerDatabaseInt(playerid, "drugs", GetPlayerData(playerid, P_DRUGS));

	AddPlayerData(to_player, P_DRUGS, +, give_drugs_count);
	UpdatePlayerDatabaseInt(to_player, "drugs", GetPlayerData(playerid, P_DRUGS));

	format(fmt_text, sizeof fmt_text, "~b~-%d g.", give_drugs_count);
	GameTextForPlayer(playerid, fmt_text, 4000, 1);

	format(fmt_text, sizeof fmt_text, "~b~+%d g.", give_drugs_count);
	GameTextForPlayer(to_player, fmt_text, 4000, 1);

	format(fmt_text, sizeof fmt_text, " передали атрон наркотики %s (%d г.)", GetPlayerNameEx(to_player), give_drugs_count);
	SendClientMessage(playerid, 0x3399FFFF, fmt_text);

	format(fmt_text, sizeof fmt_text, "грок %s передал ам наркотики (%d г.)", GetPlayerNameEx(playerid), give_drugs_count);
	SendClientMessage(to_player, 0x3399FFFF, fmt_text);

	return 1;
}

CMD:msg(playerid, params[])
{
if(GetPlayerAdminEx(playerid) < 9) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /msg [текст]");

		if(IsAIP(params))
		{
	   		SendClientMessage(playerid, -1, "одозрени в рекламе!");
	       	return false;
	    }

		new fmt_str[128];

		format(fmt_str, sizeof fmt_str, "дминистратор %s: %s", GetPlayerNameEx(playerid), params);
		SendClientMessageToAll(0xFFCD00FF, fmt_str);

		SendLog(playerid, LOG_TYPE_OOC_CHAT, params);
	}

	return 1;
}

alias:msg("o")

CMD:prefix(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 4) return 1;

    if(!strlen(params))
        return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /prefix [id игрока] [префикс]");

    extract params -> new to_player, string: prefix[15];

    if(!IsPlayerConnected(to_player))
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

    if(!strlen(prefix))
        return SendClientMessage(playerid, 0x999999FF, "ведите префикс");

    if(GetPlayerAdminEx(to_player))
    {
        format(GetPlayerData(to_player, P_PREFIX), 15, prefix);
        new fmt_msg[144];
        UpdatePlayerDatabaseString(to_player, "prefix", prefix);

        format(fmt_msg, sizeof(fmt_msg), "[A] %s установил префикс '%s' администратору: %s", GetPlayerNameEx(playerid), GetPlayerData(to_player, P_PREFIX), GetPlayerNameEx(to_player));
        SendMessageToAdmins(fmt_msg, -1);
        SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);
        return 1;
    }
    else
        return SendClientMessage(playerid, 0x999999FF, "аннй игрок не администратор!");

    return 1;
}

CMD:ears(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	g_admin_ears = g_admin_ears ^ true;

	new fmt_text[70];

	format(fmt_text, sizeof fmt_text, " %s прослушку SMS", g_admin_ears ? "включили" : "включили");
	SendClientMessage(playerid, 0x3399FFFF, fmt_text);

	if(GetPlayerAdminEx(playerid) <= 5)
	{
		format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] %s прослушку SMS", GetPlayerNameEx(playerid), playerid, g_admin_ears ? "включил" : "включил");
		SendMessageToAdmins(fmt_text, 0x999999FF);
	}

	format(fmt_text, sizeof fmt_text, "%s прослушку SMS", g_admin_ears ? "ключил" : "ключил");

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:mp(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) >= 3)
	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /mp [текст]");

        new fmt_str[999];

		for(new i; i < MAX_PLAYERS; i ++)
		{
			if(!IsPlayerConnected(i)) continue;
			else if(!IsPlayerLogged(i)) continue;
			else if(GetPlayerData(i, P_LAST_MP) != 0) continue;

			format(fmt_str, sizeof fmt_str, "{FFCC33}[EVENT] дминистратор {d58300}%s{FFCC33}: %s", GetPlayerNameEx(playerid), params);
			SendClientMessage(playerid, 0x3399FFFF, fmt_str);
		}
	}
	return 1;
}

CMD:event(playerid, params[])
{
    new pname[MAX_PLAYER_NAME];
    GetPlayerName(playerid, pname, sizeof(pname));

    if(GetPlayerAdminEx(playerid) >= 2 || strcmp(pname, "", true) == 0)
    {
        if(!mp[MP_CREATE])
        {
            new title[128];
            format(title, sizeof(title), "{FF5252}%s {FFFFFF}| оздание мероприти", NameServer[SILE_NAME]);

            Dialog
            (
                playerid, DIALOG_EVENT_CREATE, DIALOG_STYLE_INPUT,
                title,
                "{FFFFFF}л создани мероприти введите его название и сумму приза\n"\
                "в одном сообщении, через заптую.\n\n"\
                "{FFFFFF}ример: {AFAFAF}со, 50000\n\n"\
                "{FFFFFF}- азвание: от 3 до 32 символов (русские/латинские букв, цифр)\n"\
                "- умма приза: толко число, не менее 0",
                "алее", "тмена"
            );
        }
        else
        {
            new fmt_str[1026];
            new teleport_text[32];

            if(mp[MP_POS_X])
                format(teleport_text, sizeof(teleport_text), "акрт");
            else
                format(teleport_text, sizeof(teleport_text), "ткрт");

            format(fmt_str, sizeof fmt_str,
                "{FF5252}01. {FFFFFF} азвание мероприти: {FF5252}%s\n"\
                "{FF5252}02. {FFFFFF} риз мероприти: {FF5252}%d игровх рублей\n"\
                "{FF5252}03. {FFFFFF} ат мероприти - /mp\n"\
                "{FF5252}04. {FFFFFF} %s телепорт на меропритие\n"\
                "{FF5252}05. {FFFFFF} акончит меропритие\n"\
                "{FF5252}06. {FFFFFF} дат всем участникам мероприти скин\n"\
                "{FF5252}07. {FFFFFF} дат всем участникам мероприти здорове\n"\
                "{FF5252}08. {FFFFFF} дат всем участникам мероприти броню\n"\
                "{FF5252}09. {FFFFFF} дат всем участникам мероприти дигл\n"\
                "{FF5252}10. {FFFFFF} дат всем участникам мероприти дробовики\n"\
                "{FF5252}11. {FFFFFF} дат всем участникам мероприти MP5\n"\
                "{FF5252}12. {FFFFFF} аморозит всех участников мероприти\n"\
                "{FF5252}13. {FFFFFF} азморозит всех участников мероприти\n"\
                "{FF5252}14. {FFFFFF} безоружит всех участников мероприти\n"\
                "{FF5252}15. {FFFFFF} дат приз победителю",
                mp[MP_NAME],
                mp[MP_PRIZE],
                teleport_text
            );

            new title[128];
            format(title, sizeof(title), "{FF5252}%s {FFFFFF}| еню меропритий", NameServer[SILE_NAME]);

            Dialog(playerid, DIALOG_EVENT_MENU, DIALOG_STYLE_LIST,
                title,
                fmt_str,
                "брат",
                "акрт"
            );
        }
    }
    return 1;
}

CMD:gevent(playerid, params[])
{
	if(!mp[MP_CREATE]) return SendClientMessage(playerid, 0xCECECEFF, "ероптитие не создано");

	if(!mp[MP_POS_X]) return SendClientMessage(playerid, 0xCECECEFF, "оординат мероптити не вставлен");

	SetPlayerPos(playerid, mp[MP_POS_X], mp[MP_POS_Y], mp[MP_POS_Z]);

	SendClientMessage(playerid, -1, " бли телепортирован на меропритие");

	SetPlayerData(playerid, P_LAST_MP, 1);

	return 1;
}

CMD:namelist(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) >= 2)
	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "сползуй: /namelist [id игрока]");

		extract params -> new to_player;

		if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
			return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

		if(!GetPVarInt(to_player, "change_name_status"))
			return SendClientMessage(playerid, 0xCECECEFF, "грок не подавал запрос на смену ника");

		new player_name[20 + 1];
		GetPVarString(to_player, "change_name", player_name, sizeof(player_name));

		if(ChangePlayerName(to_player, player_name, true))
		{
			Dialog
			(
				to_player, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
				"{FFCD00}м изменено",
				"{66FF00}авка на изменение имени одобрена, новое им установлено.\n\n"\
				"{FFFFFF} следующий раз при входе в игру исползуйте свое новое им. л\n"\
				"этого нужно изменит его в окне клиента CRMP. екомендуем прмо\n"\
				"сейчас свернут игру и сделат это.",
				"к", ""
			);
		}
		else SendClientMessage(playerid, 0xFF6600FF, "ри смене ника произошла ошибка");

		new fmt_text[75];

		format(fmt_text, sizeof fmt_text, "[A] %s[%d] одобрил завку на смену никнейма", GetPlayerNameEx(playerid), playerid);
		SendMessageToAdmins(fmt_text, 0x999999FF);

		DeletePVar(to_player, "change_name");
		DeletePVar(to_player, "change_name_status");

		format(fmt_text, sizeof fmt_text, "добрил завку смен никнейма дл %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
		SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);
	}

	return 1;
}

stock SendClearChat(playerid)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT8, 44);
    PR_SendRPC(bs, playerid, 168, PR_HIGH_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}

CMD:cc(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 10) return 1;

	foreach(new i : Player)
	{
   	SendClearChat(i);
	}
	SetTimerEx("ClearChat", 50, false, "ii", playerid, CH_ADMIN); 

    return 1;
}

forward ClearChat(playerid, chid);
public ClearChat(playerid, chid)
{
    switch(chid)
    {
        case CH_ADMIN:
        {
            SendClientMessageToAll(0xFFCD00FF, "{FFCD00}ат бл очищен администрацией");
            new fmt_text[65];
			format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] очистил чат", GetPlayerNameEx(playerid), playerid);
			SendMessageToAdmins(fmt_text, 0x999999FF);

			SendLog(playerid, LOG_TYPE_ADMIN_ACTION, "чистил чат");
        }
        case CH_RESTART1:
        {
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, сейчас произойдет технический рестарт сервера.");
   		SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, сейчас произойдет технический рестарт сервера.");
   		SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, сейчас произойдет технический рестарт сервера.");

   		new fmt_msg[128];
   		format(fmt_msg, sizeof fmt_msg, "роизвёл рестарт сервера");
   		SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

   		if(GetPlayerAdminEx(playerid) < 6)
   		{
       		format(fmt_msg, sizeof fmt_msg, "[A] дминистратор %s[%d] поставил сервер на рестарт", GetPlayerNameEx(playerid), playerid);
       		SendMessageToAdmins(fmt_msg, 0x999999FF);
   		 }
        }
        case CH_RESTART2:
        {
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, через 1 минуту пройдет технический рестарт сервера.");
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, через 1 минуту пройдет технический рестарт сервера.");
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, через 1 минуту пройдет технический рестарт сервера.");
        }
        case CH_RESTART3:
        {
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, через 30 секунд пройдет технический рестарт сервера.");
        }
        case CH_RESTART4:
        {
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, через 10 секунд пройдет технический рестарт сервера.");
        }
        case CH_RESTART5:
        {
       	new string[128];
       	format(string, sizeof(string), "{FF5533}важаеме игроки, через %d секунд пройдет технический рестарт сервера.", restart_countdown);
       	SendClientMessageToAll(0xFF5533FF, string);
        }
        case CH_RESTART6:
        {
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, через 5 минуту пройдет технический рестарт сервера.");
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, через 5 минуту пройдет технический рестарт сервера.");
       	SendClientMessageToAll(0xFF5533FF, "{FF5533}важаеме игроки, через 5 минуту пройдет технический рестарт сервера.");
        }
    }
    return 1;
}

CMD:leave(playerid, params[])
{
	if(GetPlayerData(playerid, P_IMPROVEMENTS) < 2) return SendClientMessage(playerid, 0x999999FF, "риобретите улучшение \"ешителност\", чтоб уволитс по собственному желанию");

	if(!GetPlayerTeamEx(playerid)) return ShowNotificationSile(playerid, 2, 6, 0, 0, " не состоите в организации", "");

	new fmt_text[999];

	format
	(
		fmt_text, sizeof fmt_text,
		""SC"аша организаци{FF5252}: \"%s\".\n\n"\
		"{ffffff} действително хотите покинут данную организацию по\n"\
		"{ffffff}собственному желанию?",
		GetTeamName(GetPlayerTeamEx(playerid))
	);
	new fmt[128];
	format(fmt, sizeof(fmt), "{FF5252}%s {ffffff} | одтверждение", NameServer[SILE_NAME]);

	Dialog(playerid, DIALOG_TEAM_LEAVE, DIALOG_STYLE_MSGBOX, fmt, fmt_text, "алее", "тмена");

	return 1;
}

CMD:avig(playerid, params[])
{

	if(GetPlayerAdminEx(playerid) < 9) return 1;
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /avig [id игрока] [причина (необзателно)]");

	extract params -> new to_player, string:reason[66];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!GetPlayerAdminEx(to_player))
	    return SendClientMessage(playerid, 0xCECECEFF, "грок не влетс администратором");

	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "елз вдат предупреждение админу вше по рангу");

	AddPlayerData(to_player, P_ADMIN_WARN, +, 1);

	new fmt_msg[144];
	format(fmt_msg, sizeof fmt_msg, "[A] %s вдал предупреждение администратору %s [%d|3]. ричина: %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), GetPlayerData(to_player, P_ADMIN_WARN), reason);

	SendMessageToAdmins(fmt_msg, 0xFF5533FF);

	new uid = GetPlayerAccountID(to_player);
	new warns = GetPlayerData(to_player, P_ADMIN_WARN);

	format(fmt_msg, sizeof fmt_msg, "дал аварн %s[acc:%d] (%d/3). ричина: %d", GetPlayerNameEx(to_player), uid, warns, reason);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	if(warns >= 3)
	{
		SendClientMessage(to_player, 0xFF5533FF, "аш администраторский уровен аннулирован");

		warns = 0;

		SetPlayerData(to_player, P_ADMIN, 0);
		UpdatePlayerDatabaseInt(to_player, "admin", 0);
	}
	else SendClientMessage(to_player, 0xFF5533FF, "ри получении 3-ёх предупреждений  будете снт с поста администратора");

	format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET admin_warn=%d WHERE id=%d", warns, uid);
	mysql_query(mysql, fmt_msg, false);

	return 1;
}
CMD:unavig(playerid, params[])
{

	if(GetPlayerAdminEx(playerid) < 9) return 1;
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /unavig [id игрока] [причина]");

	extract params -> new to_player, string: reason[66];
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

    if(!GetPlayerAdminEx(to_player))
	    return SendClientMessage(playerid, 0xCECECEFF, "грок не влетс администратором");

	SetPlayerData(to_player, P_ADMIN_WARN, 				0);

	UpdatePlayerDatabaseInt(to_player, "admin_warn", 	0);

	new fmt_msg[144];
	format(fmt_msg, sizeof fmt_msg, "[A] %s снл все предупреждени с администратора %s. ричина: %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player),reason);

	SendMessageToAdmins(fmt_msg, 0xFF5533FF);

	format(fmt_msg, sizeof fmt_msg, "нл все аварн %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:setleader(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6)
        return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

    if(sscanf(params, "u", params[0]))
        return SendClientMessage(playerid, 0xFFFFFFFF, ""SC"сползуйте /setleader [ID игрока]");

    if(!IsPlayerConnected(params[0]))
        return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

    new P_TARGET_PLAYER_ID;
    g_player[playerid][P_TARGET_PLAYER_ID] = params[0];

    new sile_title[128];
    format(sile_title, sizeof sile_title, "{FF6347}%s {FFFFFF}| дача постонного лидерства", NameServer[SILE_NAME]);

    Dialog
    (
        playerid, 19469, DIALOG_STYLE_LIST,
        sile_title,
        "{F0E68C}| равителство {008000}дат\n\
        {4169E1}|  {008000}дат\n\
        {4169E1}| тдел полиции №1 () {008000}дат\n\
        {4169E1}| тдел полиции №2 () {008000}дат\n\
        {8B4513}| рми {008000}дат\n\
        {FA8072}| олница {008000}дат\n\
        {FF4500}|  {008000}дат\n\
        {32CD32}| рзамасска  {008000}дат\n\
        {7B68EE}| атревска  {008000}дат\n\
        {FF5252}| ткаринска  {008000}дат\n\
        {FF5252}| H {008000}дат\n\
        {FFFFFF}| нт с поста",
        "брат",
        "ход"
    );
    return 1;
}

CMD:ahelp(playerid)
{
    if(GetPlayerAdminEx(playerid) < 1)
        return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

    new dialogstr[999];
    dialogstr[0] = '\0';

    strcat(dialogstr, "оманд ладшего модератора\n");
    strcat(dialogstr, "оманд одератора\n");
