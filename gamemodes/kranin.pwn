                    SendClientMessage(playerid, -1, "аксималное количество символов 128");

                    return Dialog(playerid, DIALOG_TEXT_QM, DIALOG_STYLE_INPUT, "{37B6CE}ведите сообщение:", " ", "охранит", "азад");
                }

                for( new j; j < 20; j++ )
                {
                    if(GetPVarInt(playerid, #dialog) == j+1)
                    {
                        format(quick_mes[playerid][j][line], 128, inputtext);
                        save_QuickMessage(playerid, j);
                    }
                }
                editMessage(playerid);

            }
