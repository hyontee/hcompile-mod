stock ShowHud(playerid)
{
    SendCustomRPC(playerid, 0x35);
}

stock HideHud(playerid)
{
    SendCustomRPC(playerid, 0x36);
}
CMD:changename(playerid)
{
	if(GetPlayerDonateRub(playerid) >= 50)
	{
		Dialog
		(
			playerid, DIALOG_DONATE_CHANGE_NAME, DIALOG_STYLE_INPUT,
			"{FFCD00}зменение имени",
			"{FFFFFF}ведите новое им в поле ниже:",
			"зменит", "акрт"
		);
	}
	else ShowNotificationSile(playerid, 2, 6, 0, 0, "едостаточно !", "");
	return 1;
}

CMD:unnwarn(playerid)
{
    if(GetPlayerData(playerid, P_WARN))
    {
        if(GetPlayerDonateRub(playerid) >= 100)
        {
            SetPlayerData(playerid, P_WARN, 0);
            SetPlayerData(playerid, P_WARN_TIME, 0);

            UpdatePlayerDatabaseInt(playerid, "warn", 0);
            UpdatePlayerDatabaseInt(playerid, "warn_time", 0);

            GivePlayerDonateRub(playerid, -100, "нтие предупреждений");

            ShowNotificationSile(playerid, 3, 6, 0, 0, "се предупреждени успешно снт", "");
            ShowNotificationSile(playerid, 3, 6, 0, 0, "епер  можете устроитс в организацию!", "");
        }
        else
        {
            new fmt_text[80];
            ShowNotificationSile(playerid, 2, 6, 0, 0, "л снти всех предупреждений необходимо имет на счету 100 руб!", "");
        }
    }
    else ShowNotificationSile(playerid, 2, 6, 0, 0, "а ашем аккаунте нет предупреждений!", "");

    return 1;
}
CMD:alllic(playerid)
{
						if(GetPlayerData(playerid, P_DRIVING_LIC) == 2 && GetPlayerData(playerid, P_WEAPON_LIC) == 1)
                          ShowNotification(playerid, 2, " ас уже ест все лицензии!", 4, "", "");

						else
						{
							if(GetPlayerDonateRub(playerid) >= 150)
							{
								SetPlayerData(playerid, P_DRIVING_LIC,	2);
								SetPlayerData(playerid, P_WEAPON_LIC,	1);

								UpdatePlayerDatabaseInt(playerid, "driving_lic", 2);
								UpdatePlayerDatabaseInt(playerid, "weapon_lic", 1);

								GivePlayerDonate(playerid, -150, "окупка пакета лицензий", true);

								ShowNotification(playerid, 3, " приобрели пакет лицензий. сползуйте: {FF5252}/lic!", 4, "", "");

							}
							else
							{
								return ShowNotification(playerid, 2, "л покупки всех лицензий необходимо имет на счету 150 руб!", 4, "", "");
							}
						}
						return 1;
}
CMD:powerbuy(playerid)
{
    new fmt_text[400];

						format
						(
							fmt_text, sizeof fmt_text,
							"1. ила\t\t%d%%\n"\
							"2. Colt 45\t%d%%\n"\
							"3. SD Pistol\t%d%%\n"\
							"4. Desert Eagle\t%d%%\n"\
							"5. Shotgun\t%d%%\n"\
							"6. MP5\t\t%d%%\n"\
							"7. AK47\t\t%d%%\n"\
							"8. M4\t\t%d%%\n"\
							"9. Sniper Rifle\t%d%%\n"\
							"10. Sawnoff\t%d%%\n"\
							"11. Combat SG\t%d%%\n"\
							"12. Micro Uzi\t%d%%",
							GetPlayerData(playerid, P_POWER),
							GetPlayerData(playerid, P_SKILL_COLT),
							GetPlayerData(playerid, P_SKILL_SDPISTOL),
							GetPlayerData(playerid, P_SKILL_DEAGLE),
							GetPlayerData(playerid, P_SKILL_SHOTGUN),
							GetPlayerData(playerid, P_SKILL_MP5),
							GetPlayerData(playerid, P_SKILL_AK47),
							GetPlayerData(playerid, P_SKILL_M4),
							GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE),
							GetPlayerData(playerid, P_SKILL_SAWNOFF),
							GetPlayerData(playerid, P_SKILL_COMBAT_SG),
							GetPlayerData(playerid, P_SKILL_MICRO_UZI)
						);

						Dialog(playerid, DIALOG_DONATE_SKILLS, DIALOG_STYLE_LIST, "{FF5252}берите навк", fmt_text, "бор", "тмена");
}
CMD:bomboxbuy(playerid)
{
	if(GetPlayerDonateRub(playerid) >= 1000)
						{
						    if(GetPlayerData(playerid, P_BOOMBOX) >= 1) return ShowNotification(playerid, 2, " вас уже ест бумбокс!", 4, "", "");

							GivePlayerDonateRub(playerid, -1000, "покупка бумбокса");

                            ShowNotification(playerid, 3, " успешно купили бумбокс(/boombox)", 4, "", "");

							SetPlayerData(playerid, P_BOOMBOX, 1);
							UpdatePlayerDatabaseInt(playerid, "boombox", 1);

						}
						else ShowNotificationSile(playerid, 2, 6, 0, 0, "едостаточно !", "");

	return 1;

}
CMD:buyslot(playerid)
{
						new fmt_text[80];

						if(GetPlayerDonateRub(playerid) < 100)
						{
						    ShowNotificationSile(playerid, 2, 6, 0, 0, "л покупки слота дл транспорта необходимо имет на счету 100 руб!", "");
						}
						else
						{
							AddPlayerData(playerid, P_CAR_SLOTS, +, 1);
							UpdatePlayerDatabaseInt(playerid, "car_slots", GetPlayerData(playerid, P_CAR_SLOTS));

							GivePlayerDonateRub(playerid, -100, "окупка слота дл транспорта", true, true);

							format(fmt_text, sizeof fmt_text, ""SC" увеличили количество слотов дл транспорта. екущее количество слотов: {FF5252}%d", GetPlayerData(playerid, P_CAR_SLOTS));

							ShowNotification(playerid, 3, fmt_text, 4, "", "");

						}

						return 1;
}
CMD:buynomber(playerid)
{
						if(GetPlayerOwnableCar(playerid) == INVALID_VEHICLE_ID)
						{
							if(GetPlayerOwnableCars(playerid) == 0)
								return ShowNotification(playerid, 2, " вас нет личного транспорта!", 4, "", "");
							else
								return ShowNotification(playerid, 2, "аш транспорт не загружен на сервер!", 4, "", "");
						}

									Dialog
					(
						playerid, DIALOG_DONATE_BUY_CAR_NUMBER, DIALOG_STYLE_INPUT,
						"{ffcd00}ведите номер дл личного ",
						"{FFFFFF}\
						ведите номер, которй\n\
						 хотите установит на личнй транспорт\n\n\
						- азрешено исползоват цифр, а так же букв: A, B, E, K, M, H, O, P, C, T, X\n\
						- ем болше одинаковх букв/цифр встречаетс в номере - тем он дороже\n\
						- омер должен бт в формате CNNNCC; де C - буква, где N - цифра\n\n\
						{888888}апример: B713EC\
						",
						"алее", "тмена"
					);

					return 1;

}
stock ShowDonateBuySimCard(playerid)
{
						if(GetPlayerDonateRub(playerid) >= 70)
						{
							Dialog
							(
								playerid, DIALOG_DONATE_BUY_NUMBER, DIALOG_STYLE_INPUT,
								"{FFCD00}окупка 4-х значного номера телефона",
								"{FFFFFF}ведите номер, которй\n"\
								" хотели б приобрести:",
								"алее", "тмена"
							);

							return 1;
						}
						else
						{

							ShowNotificationSile(playerid, 2, 6, 0, 0, "едостаточно !", "");
						}

						return 1;
}

CMD:vipsilv(playerid)
{
    Dialog
						(
							playerid,
							DIALOG_DONATE_VIP_HELP,
							DIALOG_STYLE_MSGBOX,
							"нформаци",
							"{CD7F32}______________________ SILVER VIP ______________________\n\
							{FF5252}1{FFFFFF} /togphone - тключит телефон\n\
							{FF5252}1{FFFFFF} /admins - росмотр администраторов онлайн\n\n\
							{C0C0C0}______________________ GOLD VIP ______________________\n\
							{FF5252}1{FFFFFF} се возможности SILVER VIP \n\
							{FF5252}2{FFFFFF} VIP чат  /v | /voff \n\
							{FF5252}3{FFFFFF} аз в сутки можно в 2 раза уменшит наказание в тюрме (/unj) \n\
							{FF5252}4{FFFFFF} +1 лот транспорта в подарок \n\
							{FF5252}______________________ PLATINUM VIP ______________________\n\
							{FF5252}1{FFFFFF} се возможности SILVER VIP \n\
