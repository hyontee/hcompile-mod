CMD:addpcar(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13)
    return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	extract params -> new model_id, color_1, color_2; else return SendClientMessage(playerid, 0xCECECEFF, "{FF5252}|{ffffff} сползуйте: /addpcar [id модели] [цвет кузова] [цвет шин]");

	if(!(400 <= model_id <= 30000)) return SendClientMessage(playerid, 0xCECECEFF, "{FF5252}|{ffffff}сползуйте модел от 400 до 2591");

	new status;

	sscanf(params, "{d}{d}{d}d", status);

	if(!(0 <= status <= 1))
		return SendClientMessage(playerid, 0x999999FF, "{FF5252}|{ffffff}оступ игроков к транспорту: 0 - ет доступа, 1 - оступно любому игроку");

	new Float: x,
		Float: y,
		Float: z,
		Float: a;

	GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, a);

	new vehicleid = CreateVehicle(model_id, x, y, z, a, color_1, color_2, -1, 0, VEHICLE_ACTION_TYPE_GIFT_CAR, 1);
	PutPlayerInVehicle(playerid, vehicleid, 0);
    ChangeVehicleColor(vehicleid, color_1, color_2);
	SetVehicleParam(vehicleid, V_ENGINE, VEHICLE_PARAM_ON);
	new fmt_text[999];

	format(fmt_text, sizeof fmt_text, "[A] %s[%d] создал меропритие ''д - получи транспорт'' (%d, %d, %d)",
	GetPlayerNameEx(playerid), playerid, model_id, color_1, color_2);
    SendMessageToAdmins(fmt_text, 0x999999FF);

	format(fmt_text, sizeof fmt_text, "оздал меропритие ''д - получи транспорт''(%d, %d, %d)", model_id, color_1, color_2);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

    format(fmt_text, sizeof fmt_text, "{ff00ff}дминистратор %s[%d] оздал меропритие ''д - получи транспорт''", GetPlayerNameEx(playerid), playerid);
    SendClientMessageToAll(0xFF5533FF, fmt_text);

    SetTimerEx("tp_price", 500, false, "d", playerid);

	return 1;
}

public tp_price(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float: x, Float: y, Float: z;
