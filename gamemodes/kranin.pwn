            else description = "{23dc1b}уплено";

		format(big_fmt, sizeof(big_fmt), "%s[%d] %s\t\t%s\t%d уб\n",big_fmt, i+1, g_admin_cmd_buy[i][CMD_NAME], description, g_admin_cmd_buy[i][CMD_PRICE]);
