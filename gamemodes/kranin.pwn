	if(!(9 <= GetPlayerJob(playerid) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна лидерам организации и их заместителм");
	switch(GetPlayerTeamEx(playerid))
	{
	    case TEAM_ARMY:
	    {
	    	if(strlen(interview[TEAM_ARMY][text_time]) == 0) return SendClientMessage(playerid,-1,"{FF5252}[нформаци]{FFFFFF} акансии не существует!");
			interview[TEAM_ARMY][text_time] = EOS; interview[TEAM_ARMY][text_crit] = EOS;
		}
		case TEAM_DPS:
		{
		    if(strlen(interview[TEAM_DPS][text_time]) == 0) return SendClientMessage(playerid,-1,"{FF5252}[нформаци]{FFFFFF} акансии не существует!");
		    interview[TEAM_DPS][text_time] = EOS; interview[TEAM_DPS][text_crit] = EOS;
		}
		case TEAM_HOSPITAL:
		{
		    if(strlen(interview[TEAM_HOSPITAL][text_time]) == 0) return SendClientMessage(playerid,-1,"{FF5252}[нформаци]{FFFFFF} акансии не существует!");
		    interview[TEAM_ARMY][text_time] = EOS; interview[TEAM_HOSPITAL][text_crit] = EOS;
		}
		case TEAM_FBI:
		{
		    if(strlen(interview[TEAM_FBI][text_time]) == 0) return SendClientMessage(playerid,-1,"{FF5252}[нформаци]{FFFFFF} акансии не существует!");
		    interview[TEAM_FBI][text_time] = EOS; interview[TEAM_FBI][text_crit] = EOS;
		}
		case TEAM_RADIO:
		{
		    if(strlen(interview[TEAM_RADIO][text_time]) == 0) return SendClientMessage(playerid,-1,"{FF5252}[нформаци]{FFFFFF} акансии не существует!");
		    interview[TEAM_RADIO][text_time] = EOS; interview[TEAM_RADIO][text_crit] = EOS;
		}
		case TEAM_GOVERNMENT:
		{
		    if(strlen(interview[TEAM_GOVERNMENT][text_time]) == 0) return SendClientMessage(playerid,-1,"{FF5252}[нформаци]{FFFFFF} акансии не существует!");
		    interview[TEAM_GOVERNMENT][text_time] = EOS; interview[TEAM_GOVERNMENT][text_crit] = EOS;
		}
		case TEAM_PPS:
		{
		    if(strlen(interview[TEAM_PPS][text_time]) == 0) return SendClientMessage(playerid,-1,"{FF5252}[нформаци]{FFFFFF} акансии не существует!");
		    interview[TEAM_PPS][text_time] = EOS; interview[TEAM_PPS][text_crit] = EOS;
		}
	}

	SendClientMessage(playerid, -1,"{FF5252}[нформаци]{FFFFFF}  успешно удалили вакансию из журнала собеседований");
	return 1;
}

