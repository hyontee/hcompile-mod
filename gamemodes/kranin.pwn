case DIALOG_GPS:
{
    if(response)
    {
        new title[128];
        format(title, sizeof(title), "{FF5252}%s{ffffff} | ажне места", NameServer[SILE_NAME]);

        switch(listitem + 1)
        {
            case 1:
            {
                Dialog
                (
                    playerid, DIALOG_GPS_PUBLIC_PLACES, DIALOG_STYLE_LIST,
                    title,
                    "1. равителство\n\
                    2. втошкола\n\
                    3. оенкомат\n\
