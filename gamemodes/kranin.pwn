      GetPlayerData(playerid, P_LAW_ABIDING)
     );

    return Dialog(to_player, DIALOG_PASSPORT, DIALOG_STYLE_LIST, fmt, fmt_text, "акрт", "");

	Action(playerid, "показал свой паспорт", _, false);

}

CMD:define(playerid)
