								SendClientMessage(playerid, 0xCECECEFF, " уже купили этот уровен улучшений");
							}
							else if(GetPlayerMoneyEx(playerid) < i_price)
							{
								new fmt_str[64];

								format(fmt_str, sizeof fmt_str, "л покупки %d уровн улучшений необходимо %d рублей", listitem + 1, i_price);
