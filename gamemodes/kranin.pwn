    if(PlayerToPoint(65.0, playerid, -903.419372,1178.619140,10.521624)) return true;
    if(PlayerToPoint(65.0, playerid, 1333.572143,2344.853759,17.544162)) return true;

    new Float:radius = 65.0;

    if(PlayerToPoint(radius, playerid, -1060.9310, 2208.5684, 38.0988)) return true;
    if(PlayerToPoint(radius, playerid, 21.0981,-7.3687,1380.9985)) return true;

    if(PlayerToPoint(radius, playerid, 1919.4528,2304.0503,15.5746)) return true;
    if(PlayerToPoint(radius, playerid, 498.1315,1490.2589,1501.0000)) return true;

    if(PlayerToPoint(radius, playerid, 2412.374755,-1841.697265,22.949813)) return true;
    if(PlayerToPoint(radius, playerid, 2002.2726,0.2222,1381.0035)) return true;

    if(PlayerToPoint(radius, playerid, -2561.979980,40.261657,27.879764)) return true;
    if(PlayerToPoint(radius, playerid, -605.49,-308.52,798.98)) return true;

    if(PlayerToPoint(radius, playerid, -2576.369628,2248.399169,58.666515)) return true;
    if(PlayerToPoint(radius, playerid, -899.061767,-1558.579101,1398.778808)) return true;
