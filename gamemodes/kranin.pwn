    CancelSelectTextDraw(playerid);
    TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_SHOW);
    return true;
}

if(clickedid == acss_fix_TD[2])
{
    for(new i; i < sizeof acss_fix_TD; i++)
    {
        TextDrawHideForPlayer(playerid, acss_fix_TD[i]);
    }

    new query[512], Cache:result;

    new inv_slot = GetPVarInt(playerid, "inv_slot");
    new item_id = GetPVarInt(playerid, "item_id");
    new target_slot = GetPVarInt(playerid, "target_slot");
    new target_bone = GetPVarInt(playerid, "target_bone");

    printf("[DEBUG] охранение аксессуара: inv_slot=%d, item_id=%d, target_slot=%d, bone=%d",
        inv_slot, item_id, target_slot, target_bone);

    if(GetPVarInt(playerid, "updateacs") == 0 && inv_slot != -1)
    {

        new count = g_PlayerInventory[playerid][inv_slot][inv_itemCount];
        new plate[32];
        strcpy(plate, g_PlayerInventory[playerid][inv_slot][inv_itemPlate], 32);

        new itemWeight = GetItemWeight(item_id);
        SetPlayerWeight(playerid, GetPlayerWeight(playerid) - itemWeight);

        g_PlayerInventory[playerid][inv_slot][inv_itemId] = 0;
        g_PlayerInventory[playerid][inv_slot][inv_itemCount] = 0;
        g_PlayerInventory[playerid][inv_slot][inv_itemPlate][0] = 0;

        mysql_format(mysql, query, sizeof(query),
            "DELETE FROM `player_inventory` WHERE `player_id` = %d AND `slot` = %d AND `is_active` = 0",
            GetPlayerAccountID(playerid), inv_slot);
        mysql_tquery(mysql, query);

        g_PlayerActiveSlots[playerid][target_slot][inv_itemId] = item_id;
        g_PlayerActiveSlots[playerid][target_slot][inv_itemCount] = 1;
        g_PlayerActiveSlots[playerid][target_slot][inv_itemSlot] = target_slot;
        strcpy(g_PlayerActiveSlots[playerid][target_slot][inv_itemPlate], plate, 32);
        g_PlayerActiveSlots[playerid][target_slot][inv_itemActive] = true;
        g_PlayerActiveSlots[playerid][target_slot][inv_activeSlot] = target_slot;
        g_PlayerActiveSlots[playerid][target_slot][inv_itemType] = 6;
        g_PlayerActiveSlots[playerid][target_slot][inv_itemWeight] = itemWeight;
        GetItemName(item_id, g_PlayerActiveSlots[playerid][target_slot][inv_itemName], 64);

        SaveActiveSlotItem(playerid, target_slot);

        mysql_format(mysql, query, sizeof query,
            "INSERT INTO accessories (id, slot, modelid, bone, x, y, z, rX, rY, rZ, scale) VALUES \
            ('%d', '%d', '%d', '%d', '%f', '%f', '%f', '%f', '%f', '%f', '%f')",
            GetPlayerAccountID(playerid),
            GetPVarInt(playerid, "slot"),
            GetPVarInt(playerid, "modelid"),
            GetPVarInt(playerid, "bone"),
            GetPVarFloat(playerid, "num_1"),
            GetPVarFloat(playerid, "num_2"),
            GetPVarFloat(playerid, "num_3"),
            GetPVarFloat(playerid, "num_4"),
            GetPVarFloat(playerid, "num_5"),
            GetPVarFloat(playerid, "num_6"),
            GetPVarFloat(playerid, "num_7")
        );
        ShowNotificationSile(playerid, 3, 5, -1, -1, "ксессуар надет", "");
		BlackPass_OnAccessoryWear(playerid);

    }
    else
    {

        mysql_format(mysql, query, sizeof query,
            "UPDATE accessories SET modelid=%d, bone=%d, x=%f, y=%f, z=%f, rX=%f, rY=%f, rZ=%f, scale=%f \
            WHERE id=%d AND slot=%d",
            GetPVarInt(playerid, "modelid"),
            GetPVarInt(playerid, "bone"),
            GetPVarFloat(playerid, "num_1"),
            GetPVarFloat(playerid, "num_2"),
            GetPVarFloat(playerid, "num_3"),
            GetPVarFloat(playerid, "num_4"),
            GetPVarFloat(playerid, "num_5"),
            GetPVarFloat(playerid, "num_6"),
            GetPVarFloat(playerid, "num_7"),
            GetPlayerAccountID(playerid),
            GetPVarInt(playerid, "slot")
        );

        SendClientMessage(playerid, -1, "{FFFF00}| {FFFFFF}ксессуар успешно обновлен.");
    }

    result = mysql_query(mysql, query, true);
    cache_delete(result);

    DeletePVar(playerid, "acs_use");
    DeletePVar(playerid, "acss_fix_TD_use");
    DeletePVar(playerid, "inv_slot");
    DeletePVar(playerid, "item_id");
    DeletePVar(playerid, "model_id");
    DeletePVar(playerid, "target_slot");
    DeletePVar(playerid, "target_bone");
    DeletePVar(playerid, "slot");
    DeletePVar(playerid, "modelid");
    DeletePVar(playerid, "bone");
    DeletePVar(playerid, "num_1");
    DeletePVar(playerid, "num_2");
    DeletePVar(playerid, "num_3");
    DeletePVar(playerid, "num_4");
    DeletePVar(playerid, "num_5");
    DeletePVar(playerid, "num_6");
    DeletePVar(playerid, "num_7");
    DeletePVar(playerid, "updateacs");

    PlayerTextDrawHide(playerid, acss_coords_fix_PTD[playerid][0]);
    CancelSelectTextDraw(playerid);
    TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_SHOW);
    return true;
}

    if(acss_fix_TD[3] <= clickedid <= acss_fix_TD[9])
    {
        new TD;
        for(new i = 3; i < 10; i++)
        {
            if(clickedid == acss_fix_TD[i])
            {
                TD = i;
                break;
            }
        }

        new td_use = GetPVarInt(playerid, "acss_fix_TD_use"),
            count_TD = TD - 3,
            Float:float_count;

        TextDrawHideForPlayer(playerid, acss_fix_TD[9 + td_use]);
        TextDrawShowForPlayer(playerid, acss_fix_TD[2 + td_use]);
        TextDrawHideForPlayer(playerid, acss_fix_TD[16 + td_use]);
        TextDrawHideForPlayer(playerid, acss_fix_TD[3 + count_TD]);
        TextDrawShowForPlayer(playerid, acss_fix_TD[10 + count_TD]);
        TextDrawShowForPlayer(playerid, acss_fix_TD[17 + count_TD]);
        SetPVarInt(playerid, "acss_fix_TD_use", count_TD + 1);

        switch(count_TD + 1)
        {
            case 1: float_count = GetPVarFloat(playerid, "num_3");
            case 2: float_count = GetPVarFloat(playerid, "num_1");
            case 3: float_count = GetPVarFloat(playerid, "num_2");
            case 4: float_count = GetPVarFloat(playerid, "num_7");
            case 5: float_count = GetPVarFloat(playerid, "num_4");
            case 6: float_count = GetPVarFloat(playerid, "num_5");
            case 7: float_count = GetPVarFloat(playerid, "num_6");
        }

        new acs_coords[18];
        format(acs_coords, sizeof acs_coords, "%.3f", float_count);
        PlayerTextDrawSetString(playerid, acss_coords_fix_PTD[playerid][0], acs_coords);

        return true;
    }

    if(clickedid == acss_fix_TD[24] || clickedid == acss_fix_TD[25])
    {
        new Float:x, Float:y, Float:z, Float:scale, Float:Rx, Float:Ry, Float:Rz, acs_coords[18];

        switch(GetPVarInt(playerid, "acss_fix_TD_use"))
        {
            case 1:
            {
                if(clickedid == acss_fix_TD[24])
                {
                    if(GetPVarFloat(playerid, "num_3") >= 0.500000) return true;
                    x += 0.01;
                }
                else
                {
                    if(GetPVarFloat(playerid, "num_3") <= -0.500000) return true;
                    x -= 0.01;
                }
                format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "num_3") + x);
            }
            case 2:
            {
                if(clickedid == acss_fix_TD[24])
                {
                    if(GetPVarFloat(playerid, "num_1") >= 1.000000) return true;
                    y += 0.01;
                }
                else
                {
                    if(GetPVarFloat(playerid, "num_1") <= -1.000000) return true;
                    y -= 0.01;
                }
                format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "num_1") + y);
            }
            case 3:
            {
                if(clickedid == acss_fix_TD[24])
                {
                    if(GetPVarFloat(playerid, "num_2") >= 0.500000) return true;
                    z += 0.01;
                }
                else
                {
                    if(GetPVarFloat(playerid, "num_2") <= -0.500000) return true;
                    z -= 0.01;
                }
                format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "num_2") + z);
            }
            case 4:
            {
                if(clickedid == acss_fix_TD[24])
                {
                    if(GetPVarFloat(playerid, "num_7") >= 2.000000) return true;
                    scale += 0.1;
                }
                else
                {
                    if(GetPVarFloat(playerid, "num_7") <= 0.100000) return true;
                    scale -= 0.1;
                }
                format(acs_coords, sizeof acs_coords, "%.2f", GetPVarFloat(playerid, "num_7") + scale);
            }
            case 5:
            {
                if(clickedid == acss_fix_TD[24])
                {
                    if(GetPVarFloat(playerid, "num_4") >= 360.000000)
                        SetPVarFloat(playerid, "num_4", -5.000000);
                    Rx += 5.0;
                }
                else
                {
                    if(GetPVarFloat(playerid, "num_4") <= -360.000000)
                        SetPVarFloat(playerid, "num_4", 5.000000);
                    Rx -= 5.0;
                }
                format(acs_coords, sizeof acs_coords, "%.0f", GetPVarFloat(playerid, "num_4") + Rx);
            }
            case 6:
            {
                if(clickedid == acss_fix_TD[24])
                {
                    if(GetPVarFloat(playerid, "num_5") >= 360.000000)
                        SetPVarFloat(playerid, "num_5", -5.000000);
                    Ry += 5.0;
                }
                else
                {
                    if(GetPVarFloat(playerid, "num_5") <= -360.000000)
                        SetPVarFloat(playerid, "num_5", 5.000000);
                    Ry -= 5.0;
                }
                format(acs_coords, sizeof acs_coords, "%.0f", GetPVarFloat(playerid, "num_5") + Ry);
            }
            case 7:
            {
                if(clickedid == acss_fix_TD[24])
                {
                    if(GetPVarFloat(playerid, "num_6") >= 360.000000)
                        SetPVarFloat(playerid, "num_6", -5.000000);
                    Rz += 5.0;
                }
                else
                {
                    if(GetPVarFloat(playerid, "num_6") <= -360.000000)
                        SetPVarFloat(playerid, "num_6", 5.000000);
                    Rz -= 5.0;
                }
                format(acs_coords, sizeof acs_coords, "%.0f", GetPVarFloat(playerid, "num_6") + Rz);
            }
        }

        PlayerTextDrawSetString(playerid, acss_coords_fix_PTD[playerid][0], acs_coords);

        SetPVarFloat(playerid, "num_1", GetPVarFloat(playerid, "num_1") + y);
        SetPVarFloat(playerid, "num_2", GetPVarFloat(playerid, "num_2") + z);
        SetPVarFloat(playerid, "num_3", GetPVarFloat(playerid, "num_3") + x);
        SetPVarFloat(playerid, "num_4", GetPVarFloat(playerid, "num_4") + Rx);
        SetPVarFloat(playerid, "num_5", GetPVarFloat(playerid, "num_5") + Ry);
        SetPVarFloat(playerid, "num_6", GetPVarFloat(playerid, "num_6") + Rz);
        SetPVarFloat(playerid, "num_7", GetPVarFloat(playerid, "num_7") + scale);

        SetPlayerAttachedObject(
            playerid,
            GetPVarInt(playerid, "slot"),
            GetPVarInt(playerid, "modelid"),
            GetPVarInt(playerid, "bone"),
            GetPVarFloat(playerid, "num_1"),
            GetPVarFloat(playerid, "num_2"),
            GetPVarFloat(playerid, "num_3"),
            GetPVarFloat(playerid, "num_4"),
            GetPVarFloat(playerid, "num_5"),
            GetPVarFloat(playerid, "num_6"),
            GetPVarFloat(playerid, "num_7"),
            GetPVarFloat(playerid, "num_7"),
            GetPVarFloat(playerid, "num_7"),
            0
        );

        return true;
    }

   	if(clickedid == cont_sell)
    {
        new cont = pInfo[playerid][BuyUseCont];
        if(!IsValidContainerSelection(playerid, cont)) return 1;
        if(cInfo[cont][BetedId] == playerid)
        {
            new sell_price_string[120];
            new sell_price = cInfo[cont][ItemPrice];
            GivePlayerMoneyEx(playerid, sell_price);

            new money_str[64];
            ConvertMoney(sell_price, money_str);
            format(money_str, sizeof(money_str), " получили %s рублей", money_str);
            ShowNotificationSile(playerid, 1, 6, 0, 0, money_str, " ");

            format(sell_price_string, sizeof(sell_price_string), " {ffffff} успешно продали содержимое контейнера {FF5252}#%d {ffffff}за {FF5252}%d {FF5252}рублей!", cont, sell_price);
            SendClientMessage(playerid, CLR_GREEN, sell_price_string);

            ResetPlayerContainerUI(playerid);

            DestroyObject(cInfo[cont][ContObjectId]);
            DestroyObject(cInfo[cont][ContObjectOdejdaId]);
            DestroyVehicle(cInfo[cont][ContVehicleId]);
            KillTimer(ContsTimer[cont]);
            ResetContInfo(cont);
            SetTimerEx("SpawnNewCont", 5000, false, "i", cont);
        }
    }
    if(clickedid == cont_take)
    {
        new cont = pInfo[playerid][BuyUseCont];
        if(!IsValidContainerSelection(playerid, cont)) return 1;
        if(cInfo[cont][BetedId] == playerid)
        {
            if (cInfo[cont][ItemType] == 1)
            {
                BuyPlayerSkin(playerid, cInfo[cont][Item], cInfo[cont][Item] );
                SendClientMessage(playerid, CLR_GREEN, " {ffffff} получили новй скин из контейнера!");
            }
            else if (cInfo[cont][ItemType] == 2)
            {
                new car_modelid = cInfo[cont][Item];
                new car_color = cInfo[cont][ContVehicleColor];
                new Float: pos_x = 13.035842;
                new Float: pos_y = 2549.344482;
                new Float: pos_z = 10.876162;
                new Float: angle = 358.785644;
                new query[256], Cache: result;

                format(query, sizeof query, "INSERT INTO ownable_cars (owner_id, model_id, color_1, color_2, pos_x, pos_y, pos_z, angle, create_time) VALUES ('%d', '%d', '%d', '%d', '%f', '%f', '%f', '%f', '%d')",
                    GetPlayerAccountID(playerid), car_modelid, car_color, car_color, pos_x, pos_y, pos_z, angle, gettime());

                result = mysql_query(mysql, query, true);
                cache_delete(result);
                SendClientMessage(playerid, CLR_GREEN, "{ffffff}оздравлем!  получили новй автомобил из контейнера!");
            }

            ResetPlayerContainerUI(playerid);

            DestroyObject(cInfo[cont][ContObjectId]);
            DestroyObject(cInfo[cont][ContObjectOdejdaId]);
            DestroyVehicle(cInfo[cont][ContVehicleId]);
            KillTimer(ContsTimer[cont]);
            ResetContInfo(cont);
            SetTimerEx("SpawnNewCont", 5000, false, "i", cont);
        }
    }

    if(clickedid == cont_close)
    {
        ResetPlayerContainerUI(playerid);
    }

    
    if(clickedid == shop_clothes_TD[1])
    {

        buffer = GetPlayerSelectSkin(playerid);
		if(!(0 <= ++buffer <= sizeof g_business_clothing_skins[] - 1))
		{
			buffer = 0;
		}
		SetPlayerSelectClothingSkin(playerid, buffer);

		CallLocalFunction("BuySkinPTDUpdate", "i", playerid);

	}
	if(clickedid == shop_clothes_TD[2])
    {

		buffer = GetPlayerSelectSkin(playerid);
		if(!(0 <= --buffer <= sizeof g_business_clothing_skins[] - 1))
		{
			buffer = sizeof g_business_clothing_skins[] - 1;
		}
		SetPlayerSelectClothingSkin(playerid, buffer);

		CallLocalFunction("BuySkinPTDUpdate", "i", playerid);
	}
	if(clickedid == shop_clothes_TD[3])
    {
        buffer = GetPlayerSelectSkin(playerid);
		if(buffer != -1)
		{
			Dialog
			(
				playerid, DIALOG_BIZ_CLOTHING_BUY, DIALOG_STYLE_MSGBOX,
				"{FFCD00}агазин одежд",
				"{FFFFFF} действително хотите приобрести этот набор одежд?",
				"а", "ет"
			);
		}
	}
	if(clickedid == shop_clothes_TD[4])
    {
        buffer = GetPlayerSelectSkin(playerid);
		if(buffer != -1)
		{
            ExitPlayerClothingShopPanel(playerid);
		}
	}
	if(clickedid == business_menu_TD[2])
    {
        if(businessid != -1)
		{
        	ShowPlayerBusinessDialog(playerid, BIZ_OPERATION_PROFIT_STATS);

        	HideBusinessMenuTextDraws(playerid);
		}
		else
		    return Send(playerid, -1, " вас нету бизнеса");
	}
	if(clickedid == business_menu_TD[3])
    {
        HideBusinessMenuTextDraws(playerid);
	}
	if(clickedid == Text:INVALID_TEXT_DRAW)
	{
		if(GetPlayerPinCodeState(playerid) != PIN_CODE_STATE_NONE)
		{
			HidePlayerPinCodePTD(playerid);
			if(!IsPlayerLogged(playerid))
			{
				Kick:(playerid);
			}
		}
		switch(GetPlayerData(playerid, P_USE_SELECT_PANEL))
		{
			case SELECT_PANEL_TYPE_CLOTHING:
			{
				ExitPlayerClothingShopPanel(playerid);
			}
			case SELECT_PANEL_TYPE_REG_SKIN:
			{
				if(!IsPlayerLogged(playerid))
				{
					if(GetPlayerData(playerid, P_ACCOUNT_STATE) == ACCOUNT_STATE_REG_SKIN)
					{
						SelectTextDraw(playerid, 0x009900FF);
					}
				}
			}
			case SELECT_PANEL_TYPE_CAR_MARKET:
						{
							if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;

							ShowBuyCarFamilyAndOwnable(playerid);
						}
					}
				}
	if(select_TD[0] <= clickedid <= select_TD[3])
	{
		new use_type = GetPlayerData(playerid, P_USE_SELECT_PANEL);
		if(use_type != SELECT_PANEL_TYPE_NONE)
		{
			buffer = 0;
			new index = _:(clickedid - select_TD[0]);

			switch(index)
			{
				case 2:
				{
					switch(use_type)
					{
						case SELECT_PANEL_TYPE_CLOTHING:
						{
							buffer = GetPlayerSelectSkin(playerid);
							if(buffer != -1)
							{
								Dialog
								(
									playerid, DIALOG_BIZ_CLOTHING_BUY, DIALOG_STYLE_MSGBOX,
									"{FFCD00}агазин одежд",
									"{FFFFFF} действително хотите приобрести этот набор одежд?",
									"а", "ет"
								);
							}
						}
						case SELECT_PANEL_TYPE_REG_SKIN:
						{
							if(!IsPlayerLogged(playerid))
							{
								if(GetPlayerData(playerid, P_ACCOUNT_STATE) == ACCOUNT_STATE_REG_SKIN)
								{
									new sex = GetPlayerSex(playerid);

									buffer = GetPlayerSelectSkin(playerid);

									if(buffer != -1)
									{
										SetPlayerData(playerid, P_SKIN, reg_skin_data[sex][buffer]);

										new query[90];
										mysql_format(mysql, query, sizeof query, "UPDATE accounts SET skin=%d,last_login=%d WHERE id=%d LIMIT 1", GetPlayerSkinEx(playerid), gettime(), GetPlayerAccountID(playerid));
										mysql_query(mysql, query, false);

				if (!mysql_errno())
				{

					SetPlayerData(playerid, P_MONEY, bonus_money);
					UpdatePlayerDatabaseInt(playerid, "money", bonus_money);

					SetPlayerData(playerid, P_SELECT_SKIN, -1);

					GiveDefaultLicenses(playerid);

					new reason[144];
					format(reason, sizeof(reason), "онус при регистрации");
					GivePlayerDonateRub(playerid, bonus_donate, reason, true, true);

					SetPlayerData(playerid, P_LEVEL, bonus_lvl);
					UpdatePlayerDatabaseInt(playerid, "level", bonus_lvl);

					SetPlayerData(playerid, P_PREMIUM, vip_type);
					SetPlayerData(playerid, P_PREMIUM_DATE, gettime() + 30 * 86400);
					UpdatePlayerDatabaseInt(playerid, "premium", vip_type);
					UpdatePlayerDatabaseInt(playerid, "premium_date", GetPlayerData(playerid, P_PREMIUM_DATE));

					new prem_year, prem_month, prem_day;
					timestamp_to_date(GetPlayerData(playerid, P_PREMIUM_DATE), prem_year, prem_month, prem_day);
					format(reason, sizeof(reason), " получили VIP Gold до %02d.%02d.%d при регистрации!", prem_day, prem_month, prem_year);
					SendClientMessage(playerid, 0xFF5252FF, reason);

					HidePlayerSelectPanel(playerid);
					HidePlayerSelectPanelPrice(playerid);

					SetPlayerInterior(playerid, 0);

					SetCameraBehindPlayer(playerid);

					TogglePlayerControllable(playerid, true);

					SetPlayerInit(playerid);

                    return 1;
                }
                else
                {
                    SendClientMessage(playerid, 0xFF6600FF, "шибка сохранени, повторите поптку {FF0000}(equ-code 01)");
                }
            }
        }
    }
}
						case SELECT_PANEL_TYPE_CAR_MARKET:
						{
							if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;

							ShowBuyCarFamilyAndOwnable(playerid);

						}
					}
				}
				case 1:
				{
					switch(use_type)
					{
						case SELECT_PANEL_TYPE_CLOTHING:
						{
							buffer = GetPlayerSelectSkin(playerid);
							if(!(0 <= ++buffer <= sizeof g_business_clothing_skins[] - 1))
							{
								buffer = 0;
							}
							SetPlayerSelectClothingSkin(playerid, buffer);
						}
						case SELECT_PANEL_TYPE_REG_SKIN:
						{
							if(!IsPlayerLogged(playerid))
							{
								if(GetPlayerData(playerid, P_ACCOUNT_STATE) == ACCOUNT_STATE_REG_SKIN)
								{
									new sex = GetPlayerSex(playerid);
									buffer = GetPlayerSelectSkin(playerid);

									if(!(0 <= ++buffer <= sizeof(reg_skin_data[])-1))
									{
										buffer = 0;
									}
									else if(!reg_skin_data[sex][buffer])
									{
										buffer = 0;
									}
									SetPlayerSelectSkin(playerid, buffer, reg_skin_data[sex][buffer]);
								}
							}
						}
						case SELECT_PANEL_TYPE_CAR_MARKET:
						{
							if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
							CarMarketShowNextCar(playerid, '+');
						}
					}
				}
				case 0:
				{
					switch(use_type)
					{
						case SELECT_PANEL_TYPE_CLOTHING:
						{
							buffer = GetPlayerSelectSkin(playerid);
							if(!(0 <= --buffer <= sizeof g_business_clothing_skins[] - 1))
							{
								buffer = sizeof g_business_clothing_skins[] - 1;
							}
							SetPlayerSelectClothingSkin(playerid, buffer);
						}
						case SELECT_PANEL_TYPE_REG_SKIN:
						{
							if(!IsPlayerLogged(playerid))
							{
								if(GetPlayerData(playerid, P_ACCOUNT_STATE) == ACCOUNT_STATE_REG_SKIN)
								{
									new sex = GetPlayerSex(playerid);
									buffer = GetPlayerSelectSkin(playerid);

									if(!(0 <= --buffer <= sizeof(reg_skin_data[])-1))
									{
										buffer = sizeof(reg_skin_data[])-1;
										if(!sex)
											buffer -= 2;
									}
									SetPlayerSelectSkin(playerid, buffer, reg_skin_data[sex][buffer]);
								}
							}
						}
						case SELECT_PANEL_TYPE_CAR_MARKET:
						{
							if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
							CarMarketShowNextCar(playerid, '-');
						}
					}
				}
				case 3:
				{
					switch(use_type)
					{
						case SELECT_PANEL_TYPE_CLOTHING:
						{
							ExitPlayerClothingShopPanel(playerid);
						}
						case SELECT_PANEL_TYPE_CAR_MARKET:
						{
							ExitPlayerBuyCarMarket(playerid);
						}
					}
				}
			}
		}
	}
    return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{

if(playertextid == PlayerText:INVALID_TEXT_DRAW)
        return 0;

if(playertextid == avtsln_PTD[playerid][0])
{
    if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
    ShowBuyCarFamilyAndOwnable(playerid);
}
if(playertextid == avtsln_PTD[playerid][1])
{
    if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
    ExitPlayerBuyCarMarket(playerid);
}

if(playertextid == avtsln_PTD[playerid][3])
{
    if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
    CarMarketShowNextCar(playerid, '+');
}
if(playertextid == avtsln_PTD[playerid][4])
{
    if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
    CarMarketShowNextCar(playerid, '-');
}

if(playertextid == avtsln_PTD[playerid][7])
{
		if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        new color2 = GetPlayerData(playerid, P_AUTOSALON_COLOR2);
        color2++;
        if(color2 > 255) color2 = 0;
        SetPlayerData(playerid, P_AUTOSALON_COLOR2, color2);
        ChangeVehicleColor(GetPlayerData(playerid, P_BUY_CAR), GetPlayerData(playerid, P_AUTOSALON_COLOR1), color2);
        CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
}

if(playertextid == avtsln_PTD[playerid][8])
{
		if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        new color1 = GetPlayerData(playerid, P_AUTOSALON_COLOR1);
        color1++;
        if(color1 > 255) color1 = 0;
        SetPlayerData(playerid, P_AUTOSALON_COLOR1, color1);
        ChangeVehicleColor(GetPlayerData(playerid, P_BUY_CAR), color1, GetPlayerData(playerid, P_AUTOSALON_COLOR2));
        CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
}

if(playertextid == avtsln_PTD[playerid][9])
{
		if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        new color2 = GetPlayerData(playerid, P_AUTOSALON_COLOR2);
        color2--;
        if(color2 < 0) color2 = 255;
        SetPlayerData(playerid, P_AUTOSALON_COLOR2, color2);
        ChangeVehicleColor(GetPlayerData(playerid, P_BUY_CAR), GetPlayerData(playerid, P_AUTOSALON_COLOR1), color2);
        CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
}

if(playertextid == avtsln_PTD[playerid][10])
{
	   if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;
        new color1 = GetPlayerData(playerid, P_AUTOSALON_COLOR1);
        color1--;
        if(color1 < 0) color1 = 255;
        SetPlayerData(playerid, P_AUTOSALON_COLOR1, color1);
        ChangeVehicleColor(GetPlayerData(playerid, P_BUY_CAR), color1, GetPlayerData(playerid, P_AUTOSALON_COLOR2));
        CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
}

if(playertextid == avtsln_PTD[playerid][15])
{

    if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;

 /*   new title[128];
    format(title, sizeof(title), "{FF5252}%s {ffffff}| ест-драйв", NameServer[SILE_NAME]);

    Dialog(playerid, 9878, DIALOG_STYLE_MSGBOX, title,
	"{FFFFFF} действително хотите начат тест-драйв?\n\
        тоимост: {FF5252}15000 руб.\n\
        \n\
        {FFFFFF}ам будет предоставлен вбраннй транспорт\n\
        дл ознакомлени на специалной трассе.\n\
        \n\
        ест-драйв закончитс, когда в вйдете из машин.",
       "а", "тмена");*/
       SendClientMessage(playerid, -1, "ременно не доступно");
    return 1;
}

	if(pin_code_PTD[playerid][0] <= playertextid <= pin_code_PTD[playerid][9])
	{
		new pc_state = GetPlayerPinCodeState(playerid);
		new index = _:(playertextid - pin_code_PTD[playerid][0]);

		if(pc_state != PIN_CODE_STATE_NONE && 0 <= index <= 9)
		{
			new ch[2];
			valstr(ch, GetPlayerPinCodeValue(playerid, index));
			strcat(pin_code_input[playerid], ch);

			if(strlen(pin_code_input[playerid]) >= 4)
			{
				if(pc_state == PIN_CODE_STATE_CHECK)
				{
					HidePlayerPinCodePTD(playerid, false);
				}
				else HidePlayerPinCodePTD(playerid);

				switch(pc_state)
				{
					case PIN_CODE_STATE_SET,PIN_CODE_STATE_CHANGE:
					{
						new query[75];

						mysql_format(mysql, query, sizeof query, "UPDATE accounts SET setting_pin_code='%e' WHERE id=%d LIMIT 1", pin_code_input[playerid], GetPlayerAccountID(playerid));
						mysql_query(mysql, query, false);

						if(!mysql_errno())
						{
							format(g_player[playerid][P_SETTING_PIN], 5, "%s", pin_code_input[playerid]);

							mysql_format(mysql, query, sizeof query, "PIN-код %s: {FF5252}%s", pc_state == PIN_CODE_STATE_SET ? ("успешно установлен") : ("изменен на"), GetPlayerData(playerid, P_SETTING_PIN));

							SendClientMessage(playerid, 0x66CC00FF, query);
							SendClientMessage(playerid, 0x66CC00FF, "апомните или запишите это число");

							ShowPlayerSecuritySettings(playerid);
						}
						else
						{
							SendClientMessage(playerid, 0xFF6600FF, "шибка сохранени, повторите поптку {FF0000}(equ-code 04)");
							ShowPlayerPinCodePTD(playerid, pc_state);
						}
					}
					case PIN_CODE_STATE_CHECK:
					{
						if(strcmp(pin_code_input[playerid], GetPlayerData(playerid, P_SETTING_PIN)) != 0)
						{
							SendClientMessage(playerid, 0xFF6600FF, "PIN-код введен неверно");
							ShowPlayerSecuritySettings(playerid);
						}
						else ShowPlayerPinCodePTD(playerid, PIN_CODE_STATE_CHANGE);
					}
					case PIN_CODE_STATE_LOGIN_CHECK:
					{
						if(!IsPlayerLogged(playerid))
						{
							if(GetPlayerData(playerid, P_ACCOUNT_STATE) == ACCOUNT_STATE_LOGIN)
							{
								new step = GetPlayerData(playerid, P_ACCOUNT_STEP_STATE);
								new bool: wrong_pass = false;

								if
								(
									!strlen(GetPlayerData(playerid, P_SETTING_PIN))
									|| strcmp(GetPlayerData(playerid, P_SETTING_PIN), pin_code_input[playerid]) != 0
								)
								{
									wrong_pass = true;
									step --;
								}
								ShowPlayerLoginDialog(playerid, step + 1, wrong_pass);
							}
						}
					}
				}
				pin_code_input[playerid][0] = 0;
			}
		}
	}
	if(GetPlayerData(playerid, P_USE_SELECT_PANEL) == SELECT_PANEL_TYPE_CAR_MARKET)
	{
		if(playertextid == buy_car_PTD[playerid][2])
		{
			new type = buy_car_select_color_type[playerid];
			buy_car_select_color_type[playerid] = type ? 0 : 1;

			CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
		}
		else if(playertextid == buy_car_PTD[playerid][3])
		{

			CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
		}
		else if(playertextid == buy_car_PTD[playerid][5])
		{

			CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
		}
	}
    return 1;
}

public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
	for(new i = 0; i < sizeof miner_job_chop_cp; i++)
    {
        if(checkpointid == miner_job_cp[playerid][i])
        {
       		if(GetPlayerTempJob(playerid) == TEMP_JOB_MINER)
				{
					if(GetPlayerTempJobState(playerid) != TEMP_JOB_STATE_MINER_LOAD)
           			return 1; 
						if(!IsPlayerInAnyVehicle(playerid))
						{
							if(MiningTimer[playerid] != -1)
               			 {
               			 	KillTimer(MiningTimer[playerid]);
               				 MiningTimer[playerid] = -1;
               			 }	
							ApplyAnimationEx(playerid, "BASEBALL", "Bat_4", 3.1, 1, 1, 1, 0, 0, 0, USE_ANIM_TYPE_NONE - 1);
							MiningTimer[playerid] = SetTimerEx("SetPlayerMinerJobTakeOre", 10000, false, "i", playerid);
							ShowPlayerProgressGUI(playerid, 1, 0, 100, 100, 1, 100, "уда добваетс..");
						}
				}
        } 
    }
    if(checkpointid == miner_un_job_cp[playerid])
    {
   			if(GetPlayerTempJobState(playerid) != TEMP_JOB_STATE_MINER_UNLOAD)
       			return 1; 
                new fmt_str[64];
                new rand = random(10) + 5;
                new items = GetPlayerJobLoadItems(playerid) + rand;
                new pay_sum = items * GetTempJobInfo(TEMP_JOB_MINER, TJ_PAY_FOR_LOAD);
                if(g_doubling[DOUBLING_WAGE])
					pay_sum = pay_sum * 2;
                RemovePlayerAttachedObjectEx(playerid, A_OBJECT_SLOT_SPINE, A_OBJECT_SLOT_HAND + 1);
                RemovePlayerAttachedObjectEx(playerid, A_OBJECT_SLOT_SPINE + 1, A_OBJECT_BONE_SPINE);
                ApplyAnimationEx(playerid, "CARRY", "putdwn", 4.0, 0, 0, 0, 0, 0, 1);
                SetPlayerJobLoadItems(playerid, items);
                SetPlayerTempJobState(playerid, TEMP_JOB_STATE_MINER_LOAD);
                format(fmt_str, sizeof fmt_str, " доставили {FF9900}%d кг {32a44b}руд", rand);
                SendClientMessage(playerid, 0x32a44bFF, fmt_str);
                format(fmt_str, sizeof fmt_str, "бщее количество добтого ср: {FF9900}%d кг", items);
                SendClientMessage(playerid, 0x1E90FFFF, fmt_str);
                format(fmt_str, sizeof fmt_str, "+ %d кг", rand);
                SetPlayerChatBubble(playerid, fmt_str, 0x32a44bFF, 10.0, 2000);
				new type = GetRepositoryData(REPOSITORY_TYPE_MINER, REPOSITORY_ACTION_MINER_ORE, R_AMOUNT);
				DestroyDynamicCP(miner_un_job_cp[playerid]);
				AddZP(playerid, pay_sum);
				UpdateTextDrawsZP(playerid);
				ShowTutorialHintGUI(playerid, "тправлйтес добват руду");
				SendDestroyWayPoint(playerid, 1);

				SetRepositoryData(REPOSITORY_TYPE_MINER, REPOSITORY_ACTION_MINER_ORE, R_AMOUNT, type + 50);
				UpdateRepository(REPOSITORY_TYPE_MINER, REPOSITORY_ACTION_MINER_ORE);
                SetPlayerMinerJobLoadCP(playerid);

                AddPlayerData(playerid, P_QUEST_EXP_4, +, 1);
				UpdatePlayerDatabaseInt(playerid, "quest_exp_4", GetPlayerData(playerid, P_QUEST_EXP_4));
				
				if(GetPlayerData(playerid, P_QUEST_EXP_4) == 20)
				{
				    SendClientMessage(playerid, COR_SERVER, "{ffffff} успешно вполнили квест {009900}'жела професси'. {ffffff}аша награда: {009900}3500000 руб, 5 exp");
				                                SendClientMessage(playerid, COR_SERVER, "{ffffff}ведите {009900}/quest{ffffff},дл подробной информации по ашим квестам");
				    GivePlayerMoneyEx(playerid, 3500000, "полнение квеста");
				
					AddPlayerData(playerid, P_EXP, +, 5);
					UpdatePlayerDatabaseInt(playerid, "exp", GetPlayerData(playerid, P_EXP)); 

				    SetPlayerData(playerid, P_QUEST_4, 1);
				    UpdatePlayerDatabaseInt(playerid, "quest_4", 1);

				    AddPlayerData(playerid, P_TOP_5, +, 1);
					UpdatePlayerDatabaseInt(playerid, "TOP_Quest", GetPlayerData(playerid, P_TOP_5));
				}
            }
	if(checkpointid == markerhelp)
	{
		callcmd::help(playerid, "");
	}
	if(checkpointid == markerhelp1)
	{
		callcmd::help(playerid, "");
	}
	else if(factory_desk[0][FD_CHEK_ID] <= checkpointid <= factory_desk[sizeof(factory_desk)-1][FD_CHEK_ID])
	{
		new index = checkpointid - factory_desk[0][FD_CHEK_ID];
		SetPlayerFactoryDeskUse(playerid, index, true);
	}
	else if(checkpointid == GetBusinessInteriorInfo(BUSINESS_INTERIOR_CLUB, BT_BUY_CHECK_ID))
	{
		new businessid = GetPlayerInBiz(playerid);
