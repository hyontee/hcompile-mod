									"та система безопасности поможет защитит аш аккаунт, если на\n"\
									"компютер попадет вирус-кейлоггер, которй перехватвает данне с\n"\
									"клавиатур.  нопки всегда располагаютс в случайном пордке, что не даст\n"\
									"злоумшленникам возможност узнат ваш PIN-код.",
									"алее", "азад"
								);
							}
						}
						case 3:
						{
							new fmt[128];
							format(fmt, sizeof(fmt), "{FF5252}%s{FFFFFF} | зменение парол", NameServer[SILE_NAME]);
							Dialog
							(
