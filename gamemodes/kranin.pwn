					}
						format(fmt_text, sizeof(fmt_text),
						"{FFFFFF} вошли как администратор сервера\n"\
						"{f43713}евернй парол! сталос попток: %d\n\n"\
						"{FFFFFF}л того, чтоб продолжит далше - введите свой актуалнй\n"\
						"{FFFFFF}парол от панели администратора в диалоговое поле ниже:",
						3 - GetPVarInt(playerid, "AdminPass"));

