				SendClientMessage(to_player, 0x3399FFFF, fmt_str);

				ShowNotificationSile(to_player, 4, 5, OFFER_YES, 0, "редложение от игрока", ">>");

				format(fmt_str, sizeof fmt_str, " предложили игроку %s взт ключи от своего транспорта", GetPlayerNameEx(to_player));
				SendClientMessage(playerid, 0x3399FFFF, fmt_str);
			}
			case OFFER_TYPE_GIVE_MIC:
			{
