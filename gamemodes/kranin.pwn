							Send(playerid,COR_SERVER,"[информаци]: "c_b"а каждй килл в будете получат 25.000 rub!  еще за кажде 10 кииллов - 1 DONATE RUB!");

							SetPlayerData(playerid, P_DMZ_STATUS, 1);
