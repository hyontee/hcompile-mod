            JSON_SetInt(response, "k", 1);
            JSON_SetString(response, "n", "едостаточно средств.");
            SendPacketToClient(playerid, 22, response);
            JSON_Cleanup(response);
        }
    }
}
	if(dialogid == 9500)
	{
     	if(!response) return 1;

	     switch(listitem)
         {
         case 0:
         {
              ShowPlayerPlatesGUI(playerid, 0);
         }
         }
	}

			if(dialogid == DIALOG_WORKDAY_START)
{
    if(response)
    {
        SetPlayerData(playerid, P_WORK_DAY, 1);
        UpdatePlayerDatabaseInt(playerid, "work_day", 1);
        SetPlayerSkin(playerid, GetPlayerData(playerid, P_OSKIN));
        ShowNotificationSile(playerid, 3, 5, 0, 0, "абочий ден начат.", "");
    }
    return 1;
}

if(dialogid == DIALOG_WORKDAY_END)
{
    if(response)
    {
        SetPlayerData(playerid, P_WORK_DAY, 0);
        UpdatePlayerDatabaseInt(playerid, "work_day", 0);
        SetPlayerSkin(playerid, GetPlayerData(playerid, P_SKIN));
        ShowNotificationSile(playerid, 3, 5, 0, 0, "абочий ден закончен.", "");
    }
    return 1;
}
	if(dialogid == DIALOG_KICK_SPEC)
	{
		  utf8_to_cp1251(inputtext);
	       if(!response) return 1;

	       new to_player = GetPlayerSpectateData(playerid, S_PLAYER);
	       if(to_player == -1 || !IsPlayerConnected(to_player))
	       {
	               SendClientMessage(playerid, -1,  "грок не найден");
	               return 1;
	       }

			if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "елз кикнут администратора вше по рангу");

           if(strlen(inputtext) < 3)
           {
                  ShowPlayerDialog(playerid, DIALOG_KICK_SPEC, DIALOG_STYLE_INPUT, "{ffcc00}SILE RUSSIA | {FFFFFF}ик игрока",
						   "кажите причину исключени игрока\n\
							бзателно укажите причину (минимум 3 символа)\n\
							\n\
							ример: AFK\n\
                            {FF0000}кажите причину (минимум 3 символа).",
						   "алее", "акрт");
           }

           new fmt_msg[128];
		   format(fmt_msg, sizeof fmt_msg, "дминистратор: %s кикнул игрока %s. ричина: %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), inputtext);

		   SendClientMessageToAll(0xFF5533FF, fmt_msg);

	       format(fmt_msg, sizeof fmt_msg, "икнул %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	       SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	      Kick(to_player);
     	HidePlayerGUI(playerid, 66);
	}
	if(dialogid == DIALOG_MUTE_SPEC)
	{
		   utf8_to_cp1251(inputtext);
	       if(!response) return 1;

	       new to_player = GetPlayerSpectateData(playerid, S_PLAYER);
	       if(to_player == -1 || !IsPlayerConnected(to_player))
	       {
	               SendClientMessage(playerid, -1,  "грок не найден");
	               return 1;
	       }

	       if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "елз вдат мут администратору вше по рангу");

			new mute_time, prichina[32];

  		 if(sscanf(inputtext, "is[32]", mute_time, prichina))
	     {
     		  ShowPlayerDialog(playerid, DIALOG_MUTE_SPEC, DIALOG_STYLE_INPUT, "{FFCC00}SILE RUSSIA | {FFFFFF}ут игрока",
      	     "ведите врем и причину мута\n\
          	 \n\
         	  рем указваетс в минутах\n\
      	     ричина должна содержат минимум 5 символов\n\
    	       \n\
       	    ример: 30 скорбление",
    	       "брат", "тмена");

 		      return 1;
	   }

    if(!(10 <= mute_time <= 360))
    {
        SendClientMessage(playerid, -1, "рем мута должно бт не менее 10 минут и не более 360 минут");
        return 1;
    }

    if(strlen(prichina) < 5)
    {
        SendClientMessage(playerid, -1, "ричина должна содержат минимум 5 символов");
        return 1;
    }

          new fmt_msg[128];
	      format(fmt_msg, sizeof fmt_msg, "дминистратор: %s вдал мут игроку %s на %d мин. ричина: %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), mute_time, prichina);

           SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SetPlayerData(to_player, P_MUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "mute", mute_time * 60);

	SendClientMessage(to_player, 0xCECECEFF, "рем до окончани бана чата: {CCCC00}/time");

	format(fmt_msg, sizeof fmt_msg, "дал %s[acc:%d] мут на %d мин. ричина: %s",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time, prichina);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	}
	if(dialogid == DIALOG_JAIL_SPEC)
	{
		   utf8_to_cp1251(inputtext);
	       if(!response) return 1;

	       new to_player = GetPlayerSpectateData(playerid, S_PLAYER);
	       if(to_player == -1 || !IsPlayerConnected(to_player))
	       {
	               SendClientMessage(playerid, -1,  "грок не найден");
	               return 1;
	       }

	       if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "елз посадит администратора вше по рангу");

			new jail_time, prichina[32];

  		 if(sscanf(inputtext, "is[32]", jail_time, prichina))
	     {
     		  ShowPlayerDialog(playerid, DIALOG_JAIL_SPEC, DIALOG_STYLE_INPUT, "{FFCC00}SILE RUSSIA | {FFFFFF}еморган игрока",
      	     "ведите врем заключени и причину\n\
