stock ProxDetectorS(Float:radi, playerid, to_player, spec = 0)
{
	new Float:p[3];

	if(!IsPlayerConnected(playerid)) return false;

	if(!IsPlayerConnected(to_player)) return false;

	if(!spec)
	{
		if(GetPlayerState(playerid) == 9) return false;

		if(GetPlayerState(to_player) == 9) return false;
	}
	if(!GetPlayerPos(to_player, p[0], p[1], p[2])) return false;
	if(!IsPlayerInRangeOfPoint(playerid, radi, p[0], p[1], p[2])) return false;

	return true;
}

