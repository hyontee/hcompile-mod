    return 1;
}

CMD:spoff(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1 && GetPlayerYouTubeEx(playerid) < 1) return 1;

    if(GetPlayerSpectateData(playerid, S_PLAYER) != -1)
    {
        StopSpectate(playerid);
        HidePlayerGUI(playerid, 66);
    }

    return 1;
}

CMD:stats(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /stats [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	new fmt_text[512];
	new rank_value[3] = "—";
	new Float:armour;
	GetPlayerArmour(to_player, armour);

	if(1 <= GetPlayerTeamEx(to_player) < MAX_ORG)
	{
		if(1 <= GetPlayerJob(to_player) <= 10)
			valstr(rank_value, GetPlayerJob(to_player));
		else
			rank_value = "1";
	}

	format
	(
		fmt_text, sizeof fmt_text,
		"м: %s[%d]\n"\
		"ровен: %d (%d/%d EXP)\n"\
		"HP/ARM: %.1f / %.1f\n"\
		"енги: %d | анк: %d\n"\
		"атериал/атрон/аркотики: %d / %d / %d\n"\
		"озск: %d | лучшени: %d\n"\
		"ракци: %s\n"\
		"абота/должност: %s\n"\
		"анг: %s",
		GetPlayerNameEx(to_player),
		to_player,
		GetPlayerLevel(to_player),
		GetPlayerExp(to_player),
		GetExpToNextLevel(to_player),
		GetPlayerData(to_player, P_HEALTH),
		armour,
		GetPlayerMoneyEx(to_player),
		GetPlayerBankMoney(to_player),
		GetPlayerData(to_player, P_METALL),
		GetPlayerData(to_player, P_AMMO),
		GetPlayerData(to_player, P_DRUGS),
		GetPlayerSuspect(to_player),
		GetPlayerData(to_player, P_IMPROVEMENTS),
		GetPlayerTeamStats(to_player),
		GetPlayerJobAndRankName(to_player),
		rank_value
	);

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCC00}татистика игрока", fmt_text, "акрт", "");

	format(fmt_text, sizeof fmt_text, "мотрит stats %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:eventpriz(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return 1;
	if(!mp[MP_CREATE]) return SendClientMessage(playerid, 0xCECECEFF, "еропритие не создано");

	new title[128];
	format(title, sizeof(title), "{FF5252}%s {FFFFFF}| риз победителю", NameServer[SILE_NAME]);

	Dialog
	(
		playerid, DIALOG_EVENT_WINNER, DIALOG_STYLE_INPUT,
		title,
        "{FFFFFF}ведите ID игрока и сумму приза через заптую:\n\n{FFFFFF}ример: {AFAFAF}5, 5000000",
		"дат", "тмена"
	);
	return 1;
}
CMD:weap(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /weap [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	new fmt_text[625],
		text[45];

	format
	(
		fmt_text,
		sizeof fmt_text,
		"\
		лот\tружие\t\tатрон\n{FFFFFF}\
		"
	);

	for(new i = 0; i < 13; i++)
	{
		new weapon_id, weapon_ammo;
		new weapon_name[24];
		new tabulation[7];

		GetPlayerWeaponData(to_player, i, weapon_id, weapon_ammo);

		if(weapon_id == GetPlayerWeapon(to_player) && weapon_ammo == 0)
			weapon_ammo = GetPlayerAmmo(to_player);

		if(0 <= weapon_id < sizeof weapon_names)
		{
			format(weapon_name, sizeof weapon_name, "%s", GetWeaponName(weapon_id));
			format(tabulation, sizeof tabulation, "%s", weapon_dialog_tabulation[weapon_id]);
		}
		else
		{
			format(weapon_name, sizeof weapon_name, "ID:%d", weapon_id);
			tabulation = "	";
		}

		format(text, sizeof text, "\n%d	%s%s%d", i + 1, weapon_name, tabulation, weapon_ammo);
		strcat(fmt_text, text);
	}

	Dialog
	(
		playerid,
		INVALID_DIALOG_ID,
		DIALOG_STYLE_LIST,
		"{FFCC00}ружи у игрока",
		fmt_text,
		"акрт",
		""
	);

	format(fmt_text, sizeof fmt_text, "мотрит оружие %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:a(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) >= 1)
    {
        if(!strlen(params))
            return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /a [текст]");

        new fmt_str[999];
        new fmt_text[32];
        new Admin = GetPlayerAdminEx(playerid);

        if(strlen(GetPlayerData(playerid, P_PREFIX)) > 0)
        {
            format(fmt_text, sizeof(fmt_text), "[%s]", GetPlayerData(playerid, P_PREFIX));
        }
        else
        {

            switch(Admin)
            {
                case 1: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL1_NAME); }
                case 2: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL2_NAME); }
                case 3: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL3_NAME); }
                case 4: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL4_NAME); }
                case 5: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL5_NAME); }
                case 6: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL6_NAME); }
                case 7: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL7_NAME); }
                case 8: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL8_NAME); }
                case 9: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL9_NAME); }
                case 10: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL10_NAME); }
                case 11: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL11_NAME); }
                case 12: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL12_NAME); }
                case 13: { format(fmt_text, sizeof(fmt_text), "[%s]", ADM_LVL13_NAME); }
                default: { format(fmt_text, sizeof(fmt_text), "---"); }
            }
        }

        format(fmt_str, sizeof fmt_str, "%s %s[%d]: %s", fmt_text, GetPlayerNameEx(playerid), playerid, params);
        SendMessageToAdmins(fmt_str, 0x40E0D0FF);

        SendLog(playerid, LOG_TYPE_ADMIN_CHAT, params);
    }

    return 1;
}

CMD:admins(playerid, params[])
{
    new vip = GetPlayerPremium(playerid);
	if(vip < 1 || vip > 3) return SendClientMessage(playerid, 0xCECECEFF, " ас нет VIP аккаунта.");

    new fmt_text[150];
    new list[1500] = "{FF5252}икнейм\t{FF5252}олжност\t{FF5252}нформаци\n";

    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i)) continue;
        if(!IsPlayerLogged(i)) continue;

        new Admin = GetPlayerAdminEx(i);
        new YouTube = GetPlayerYouTubeEx(i);

        if(Admin == 0 && YouTube == 0) continue;

        new rank_name[64];

        if(Admin > 0)
        {
            switch(Admin)
            {
                case 1:  rank_name = ADM_LVL1_NAME;
                case 2:  rank_name = ADM_LVL2_NAME;
                case 3:  rank_name = ADM_LVL3_NAME;
                case 4:  rank_name = ADM_LVL4_NAME;
                case 5:  rank_name = ADM_LVL5_NAME;
                case 6:  rank_name = ADM_LVL6_NAME;
                case 7:  rank_name = ADM_LVL7_NAME;
                case 8:  rank_name = ADM_LVL8_NAME;
                case 9:  rank_name = ADM_LVL9_NAME;
                case 10: rank_name = ADM_LVL10_NAME;
                case 11: rank_name = ADM_LVL11_NAME;
                case 12: rank_name = ADM_LVL12_NAME;
                case 13: rank_name = ADM_LVL13_NAME;
                default: rank_name = "---";
            }
        }
        else if(YouTube > 0)
        {

            format(rank_name, sizeof(rank_name), "тубер");
        }
        else
        {
            rank_name = "---";
        }

        format(fmt_text, sizeof fmt_text, "%s[%d]\t%s\tв игре\n", GetPlayerNameEx(i), i, rank_name);
        strcat(list, fmt_text);
    }

    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_TABLIST_HEADERS, "{FF5252}дминистраци в сети (стр.1)", list, "брат", "акрт");

    return 1;
}

