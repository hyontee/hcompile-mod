new RPtest[8][tRPinfo] = {
    {"то обозначает термин RolePlay ? ","(1) бийство без причин\n(2) олева гра\n(3) сползование реалной информации в игровой чат",2},
    {"то обозначает термин MetaGaming ? ","(1) бийство с /\n(2) оображение из себ супер геро\n(3) бийство своих членов организации\n(4) сползование реалной информации в игровой чат",4},
    {"то обозначает термин SpawnKill ? ","(1) бийство на месте повлени (Spawn)\n(2) бийство с /\n(3) уд мод - т.е. бессмертие.\n(4) головнй одекс",1},
    {"то обозначает термин RepeatKill ? ","(1) амеренное, повторное возвращение на место смерти.\n(2) NonRP бег с пржками ( shift+space )\n(3) кадемический одекс\n(4) бийство без причин.",1},
    {"то обозначает термин DeathMatch ? ","(1) бийство с ранспортного средства\n(2) бийство своих членов организации\n(3) бийство без причин",3},
    {"то обозначает термин DriveBy ? ","(1) бийство своих членов организации\n(2) бийство с ранспортного средства\n(3) бийство без причин",2},
    {"то обозначает термин PowerGaming ? ","(1) NonRP бег с пржками ( shift+space )\n(2) кадемический одекс\n(3) сползование реалной информации и игровой чат\n(4) зображение из себ супер геро",4},
    {"его  стоит делат на посту администратора? ","(1) твечат на вопрос\n(2) роводит \n(3) частвоват в  процессе\n(4) омогат игрокам",3}
};

