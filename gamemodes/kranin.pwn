}

alias:goto("g")

CMD:goto(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1 && GetPlayerYouTubeEx(playerid) < 1)
    return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команд", " ");

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /goto [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

    if(GetPlayerSecretEx(to_player) >= 1)
	    return SendClientMessage(playerid, 0xCECECEFF, " игрока ест привелеги скртност");

	new Float: x, Float: y, Float: z, interior, virtual_world;
	GetPlayerPos(to_player, x, y, z);
	interior = GetPlayerInterior(to_player);
	virtual_world = GetPlayerVirtualWorld(to_player);

	SetPlayerPosEx(playerid, x + 1, y + 1, z, 0.0, interior, virtual_world, false);

	SetPlayerInHouse(playerid, GetPlayerInHouse(to_player));
	SetPlayerInBiz(playerid, GetPlayerInBiz(to_player));

	new fmt_msg[999];
    format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] телепортировалс к %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
    SendMessageToAdmins(fmt_msg, 0x999999FF);

	format(fmt_msg, sizeof fmt_msg, "{1E90FF} успешно телепортировалис к игроку %s[%d]", GetPlayerNameEx(to_player), to_player);
	SendClientMessage(playerid, 0x66CC00FF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "{1E90FF}дминистратор %s[%d] успешно к ам телепортировалс.", GetPlayerNameEx(playerid), playerid);
	SendClientMessage(to_player, 0x66CC00FF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "елепортировалс к %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

alias:gethere("gh")

CMD:gethere(playerid, params[])
{
    if(!(GetPlayerAdminEx(playerid) >= 2 || GetPlayerYouTubeEx(playerid) >= 1))
    return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /gethere [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	if(GetPlayerSecretEx(to_player) >= 1)
		return SendClientMessage(playerid, 0xCECECEFF, " игрока ест привелеги скртност");

	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid))
	{
		SendClientMessage(playerid, 0x66CC33FF, " птаетес телепортироват к себе администратора ше рангом, он должен подтвердит аше действие");
		SendPlayerOffer(playerid, to_player, OFFER_TYPE_GETHERE);
	}
	else
	{
		new Float: x, Float: y, Float: z;
		GetPlayerPos(playerid, x, y, z);
		SetPlayerPosEx(to_player, x + 1, y + 1, z, 0.0, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid), false);

		SetPlayerInHouse(to_player, GetPlayerInHouse(playerid));
		SetPlayerInBiz(to_player, GetPlayerInBiz(playerid));

		new fmt_msg[999];
		format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] телепортировал к себе %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
		SendMessageToAdmins(fmt_msg, 0x999999FF);

		format(fmt_msg, sizeof fmt_msg, "{1E90FF} успешно телепортировали %s[%d] к себе", GetPlayerNameEx(to_player), to_player);
		SendClientMessage(playerid, -1, fmt_msg);

	    format(fmt_msg, sizeof fmt_msg, "{1E90FF}дминистратор %s[%d] успешно телепортировал ас к себе.", GetPlayerNameEx(playerid), playerid);
    	SendClientMessage(to_player, 0x66CC00FF, fmt_msg);

		format(fmt_msg, sizeof fmt_msg, "елепортировал к себе %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
		SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);
	}

	return 1;
}

CMD:vtp(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return 1;

