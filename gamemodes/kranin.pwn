        return SendClientMessage(playerid, 0xFFFFFFFF, "{FF0000}| {FFFFFF}оступно толко администраторам 3-его уровн.");

    new sile_title[128];
    format(sile_title, sizeof sile_title, "{FF5252}%s{ffffff} | еню временного лидерства",NameServer[SILE_NAME] );

    Dialog
    (
        playerid, 19470, DIALOG_STYLE_LIST,
        sile_title,
        "{F0E68C}| равителство {008000}дат\n\
        {4169E1}|  {008000}дат\n\
        {4169E1}| тдел полиции №1 () {008000}дат\n\
        {4169E1}| тдел полиции №2 () {008000}дат\n\
        {8B4513}| рми {008000}дат\n\
        {FA8072}| олница {008000}дат\n\
        {FF4500}|  {008000}дат\n\
        {32CD32}| рзамасска  {008000}дат\n\
        {7B68EE}| атревска  {008000}дат\n\
        {FF5252}| ткаринска  {008000}дат\n\
        {FF5252}| C {008000}дат\n\
        {FFFFFF}| нт с поста",
        "брат",
        "ход"
    );
    return 1;
