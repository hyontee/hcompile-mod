public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    if (newkeys & KEY_CROUCH)
    {
        for (new i = 0; i < sizeof GateFractionData; i++)
        {
            if (IsPlayerInRangeOfPoint(playerid, GateFractionData[i][TriggerRadius], GateFractionData[i][TriggerX], GateFractionData[i][TriggerY], GateFractionData[i][TriggerZ]))
            {
                ToggleGate(playerid, i);
                return 1;
            }
        }
    }

if(newkeys == KEY_CROUCH && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    new stationid = GetNearestFuelStation(playerid, 10.0);

    if(stationid != -1 && vehicleid != INVALID_VEHICLE_ID && !IsABike(vehicleid))
    {
        FuelStationFillCar(playerid, vehicleid, stationid);
    }
}

   if((newkeys & KEY_FIRE) || ((newkeys & 128) && (oldkeys & 128) && (newkeys & KEY_SECONDARY_ATTACK)))
        {
            if(GreenZone(playerid))
            {
                if(!IsPlayerInAnyVehicle(playerid))
                        {
                            ApplyAnimation(playerid, "FAT", "IDLE_tired", 4.0, 1, 0, 0, 0, 1000, 1);
                            ClearAnimations(playerid);
                            ShowDialogGZ(playerid);
                        }
            }
        }
           			   if(newkeys == KEY_CROUCH)
   {
       if(IsPlayerInRangeOfPoint(playerid,  10.0, -1827.21, -2634.129, 8.58))
       {
       					if(!openfsinvorota)
		{
		if(GetPlayerTeamEx(playerid) != TEAM_FSIN) return ShowNotificationSile(playerid, 2, 5, 1, 10, " не сотрудник C!", "");
MoveObject(vorotafsinkpp, -1820.11, -2632.95, 8.58, 3.0, 0.0, 0.0, 15.0);
        MoveObject(vorotafsinkpp1, -1827.21, -2634.129, 8.58,  3.0, 0.0, 0.0, 15.0);
        ShowNotificationSile(playerid, 3, 5, 1, 10, "орота закроютс через 5 секунд", "");
        SetTimerEx("pisunchik1", 7000, false, "i", playerid);
        openfsinvorota = 1;
        }else{
		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
		{
			SendClientMessage(playerid, 0x6B6B6BFF, "е флудите");

			if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
				SendClientMessage(playerid, 0x6B6B6BFF, "ожалуйста, подождите несколко секунд...");
		return 1;
        			}
        			}
        			}
        			}
        			        			   if(newkeys == KEY_CROUCH)
   {
       if(IsPlayerInRangeOfPoint(playerid,  15.0, -1820.49, -2651.36, 10.9))
       {
       					if(!openfsinvorota1)
		{
		if(GetPlayerTeamEx(playerid) != TEAM_FSIN) return ShowNotificationSile(playerid, 2, 5, 1, 10, " не сотрудник C!", "");
MoveObject(vorotki, -1828.0, -2652.7, 10.9, 5.0, 0.0, 0.0, 99.5);
        ShowNotificationSile(playerid, 3, 5, 1, 10, "орота закроютс через 5 секунд", "");
        SetTimerEx("pisunchik", 7000, false, "i", playerid);
        openfsinvorota1 = 1;
        }else{
		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
		{
			SendClientMessage(playerid, 0x6B6B6BFF, "е флудите");

			if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
				SendClientMessage(playerid, 0x6B6B6BFF, "ожалуйста, подождите несколко секунд...");
		return 1;
        			}
        			}
        			}
}
    if((newkeys & KEY_JUMP))
    {
        if(!IsPlayerInAnyVehicle(playerid))
        {
            if(GetPlayerTeamEx(playerid) != TEAM_FSIN)
            {
                if(IsPlayerInRangeOfPoint(playerid, 250.0, -1778.83, -2754.59, 7.58))
                {
                    TogglePlayerControllable(playerid, false);
                    SetTimerEx("unFreezePlayerExExFsin", 300, false, "i", playerid);
                }
            }
        }
        return 1;
    }
if(newkeys & KEY_CROUCH)
{
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		for(new i = 0; i < 3; i++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 6.0, g_TuningEnter[i][0], g_TuningEnter[i][1], g_TuningEnter[i][2]))
			{
				/*if(strcmp(GetPlayerNameEx(playerid), "Danya_Coder", true) != 0)
       			return ShowNotificationSile(playerid, 2, 6, -1, -1, "ременно не доступно.", "");*/
				ShowTuningStylingGUI(playerid);
				return 1;
			}
			else if(IsPlayerInRangeOfPoint(playerid, 6.0, g_TuningEnter2[i][0], g_TuningEnter2[i][1], g_TuningEnter2[i][2]))
			{
				/*if(strcmp(GetPlayerNameEx(playerid), "Danya_Coder", true) != 0)
