CMD:setap(playerid, params[])
{

    if(GetPlayerAdminEx(playerid) < 8) return 1;

    extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /sethelper [id игрока]");

    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

    if(GetPlayerHelperEx(to_player))
        return SendClientMessage(playerid, 0x999999FF, "грок уже стоит на посту хелпера");

    SetPlayerData(to_player, P_HELPER, 2);
    UpdatePlayerDatabaseInt(to_player, "helper", 2);

    new fmt_text[128];

    format(fmt_text, sizeof fmt_text, "{1E90FF} бли назначен на пост лавного хелпера администратором", GetPlayerNameEx(playerid), playerid);
    SendClientMessage(to_player, 0xFF5533FF, fmt_text);

    format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] поставил %s[%d] на пост следщего хелпера",
    GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);

    SendMessageToAdmins(fmt_text, 0xFF5533FF);

