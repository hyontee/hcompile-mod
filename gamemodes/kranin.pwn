					"2. иво\t\t\t{00CC00}100 руб\n"\
					"3. ино\t\t\t{00CC00}200 руб\n"\
					"4. ампанское\t\t{00CC00}270 руб\n"\
					"5. одка\t\t{00CC00}300 руб\n"\
					"6. онк\t\t{00CC00}450 руб\n"\
					"7. иски\t\t{00CC00}630 руб\n"\
					"8. бсент\t\t{00CC00}750 руб\n"\
					"{CC9900}9. акуска\t\t{00CC00}50 руб\n"\
					"{CC9900}10. игара\t\t{00CC00}80 руб",
					"упит", "тмена"
				);
			}
		}
	}
	else if(checkpointid == GetBusinessInteriorInfo(BUSINESS_INTERIOR_CASINO, BT_BUY_CHECK_ID))
	{
		new businessid = GetPlayerInBiz(playerid);
		if(businessid != -1)
