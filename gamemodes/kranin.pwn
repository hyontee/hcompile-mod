stock LoadWhitelist()
{
    new FileID = ini_openFile(g_WhitelistFile);
    if(FileID < 0)
    {
        printf("[Whitelist] айл %s не найден, будет создан.", g_WhitelistFile);
        SaveWhitelist();
        return 0;
    }

    new status = 0;
    ini_getInteger(FileID, "status", status);
    g_WhitelistEnabled = (status == 1);

    ini_getInteger(FileID, "count", g_WhitelistCount);

    new key[32];
    for(new i = 0; i < g_WhitelistCount && i < MAX_PLAYERS; i++)
    {
        format(key, sizeof(key), "player_%d", i);
        ini_getString(FileID, key, g_WhitelistNames[i], MAX_PLAYER_NAME);
    }

    ini_closeFile(FileID);

    printf("[Whitelist] агружено %d игроков. татус: %s",
        g_WhitelistCount, g_WhitelistEnabled ? "" : "");
    return 1;
}

stock SaveWhitelist()
{
    new FileID = ini_openFile(g_WhitelistFile);
    if(FileID < 0)
    {
        printf("[Whitelist] шибка открти файла %s дл записи!", g_WhitelistFile);
        return 0;
    }

    ini_setInteger(FileID, "status", g_WhitelistEnabled ? 1 : 0);

    ini_setInteger(FileID, "count", g_WhitelistCount);

    new key[32];
    for(new i = 0; i < g_WhitelistCount; i++)
    {
        format(key, sizeof(key), "player_%d", i);
        ini_setString(FileID, key, g_WhitelistNames[i]);
    }

    ini_closeFile(FileID);

    printf("[Whitelist] охранено %d игроков. татус: %s",
        g_WhitelistCount, g_WhitelistEnabled ? "" : "");
    return 1;
}

stock IsPlayerInWhitelist(playerid)
{
    new playerName[MAX_PLAYER_NAME];
    GetPlayerName(playerid, playerName, sizeof(playerName));

    for(new i = 0; i < g_WhitelistCount; i++)
    {
        if(strcmp(g_WhitelistNames[i], playerName, true) == 0)
        {
            return 1;
        }
    }
    return 0;
}

public OnIncomingRPC(playerid, rpcid, BitStream:bs)
{
    if(rpcid == 97)
    {
        new action;
        new actionSubtype;

        if(!BS_ReadUint32(bs, action))
        {
            return 1;
        }
       
        if(action == 1)
        {
            new vehicleid;
            new Float:damage;
            new damagedPiece;

            if(!BS_ReadUint16(bs, vehicleid)) return 1;
            if(!BS_ReadFloat(bs, damage)) return 1;
            if(!BS_ReadUint16(bs, damagedPiece)) return 1;

           new Float:hp = GetVehicleData(vehicleid, V_HEALTH);
       
      	 hp -= damage;

       	if(hp < 250.0) hp = 250.0;
       	if(hp > 1000.0) hp = 1000.0;

       	SetVehicleData(vehicleid, V_HEALTH, hp);
       	SetVehicleHealth(vehicleid, hp);
      	 if(hp <= 320.0 && GetVehicleParam(vehicleid, V_ENGINE) == 1)
       	{
           	SetVehicleParam(vehicleid, V_ENGINE, 0);
           	ShowNotificationSile(playerid, 2, 5, 0, 0, "вигател бл заглушен!", " ");
       	}
        }

		if(action == 3)
    {
        new vehicleid;
        new turnStatus;

        if(!BS_ReadUint16(bs, vehicleid)) return 1;
        if(!BS_ReadUint8(bs, turnStatus)) return 1;

        if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 1;
        if(!IsValidVehicle(vehicleid)) return 1;
        if(GetPlayerVehicleID(playerid) != vehicleid) return 1;
        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
        if(turnStatus < 1 || turnStatus > 3) return 1;

        if(TurnSignalState[vehicleid] == turnStatus && TurnSignalDriver[vehicleid] == playerid)
        {
            StopVehicleTurnSignal(vehicleid);
            printf("[TurnSignal] Player %d turned OFF turn signal on vehicle %d", playerid, vehicleid);
        }
        else
        {
            StopVehicleTurnSignal(vehicleid);
            StartVehicleTurnSignal(playerid, vehicleid, turnStatus);
            
            new statusText[16];
            if(turnStatus == 1) statusText = "LEFT";
            else if(turnStatus == 2) statusText = "RIGHT";
            else if(turnStatus == 3) statusText = "HAZARD";
            
            printf("[TurnSignal] Player %d turned ON %s turn signal on vehicle %d (Model: %d)", 
                   playerid, statusText, vehicleid, GetVehicleModel(vehicleid));
        }
        return 1;
    }

        if(action == 14)
        {
            if(!BS_ReadUint8(bs, actionSubtype))
            {
                return 1;
            }

            switch(actionSubtype)
            {
                case 0:
                {
                    DonateBlackPassTasks(playerid);
                }
                case 1:
                {
                    DonateBlackPassTasks(playerid);
                }
                case 2:
                {
                    callcmd::donate(playerid);
                }
				case 4:
                {
                    ShowTabletGUI(playerid);
                }
            }
        }

        switch(action)
        {
            case 4:
            {
                ShowVehicleRadial(playerid);
            }
            case 18:
            {
                if(IsPlayerNearMikhail(playerid))
                {
                    return callcmd::quest(playerid, "");
                }
               	if(IsPlayerNearContainer(playerid))
               	{
                   	return callcmd::cont(playerid, "");
                }
                if(IsPlayerAtATM(playerid))
                {
                	ShowPlayerATM(playerid);
                } 

                if(IsPlayerNearHelper(playerid))
                {
                    return callcmd::help(playerid, "");
                }
            }
        }
        return 1;
    }
    return 1;
}

stock ShowRestartDialog(playerid)
{
    new dialog_string[512];

    new hour, minute, second;
    gettime(hour, minute, second);

    ShowPlayerDialog(playerid, DIALOG_RESTART, DIALOG_STYLE_LIST, "берите когда произвести рестарт",
                     "рмо сейчас\n\
        ерез 1 минуту\n\
        ерез 5 минут\n\
        ерез 10 минут\n\
        вое врем (ведите в минутах)", "брат", "акрт");
}

stock StartRestartImmediately(playerid)
{

    SendClearChat(playerid);
    SetTimerEx("ClearChat", 50, false, "ii", playerid, CH_RESTART2);
    SetTimer("RestartServer", 2000, false);
}

stock StartRestartTimer(playerid, minutes)
{
    if(restart_active)
    {
        ShowNotificationSile(playerid, 2, 7, -1, -1, "естарт уже запланирован! тмените текущий рестарт.", "");
        return;
    }

    restart_active = true;
    restart_countdown = minutes * 60;

    new hour, minute, second;
    gettime(hour, minute, second);

    new restart_hour = hour;
    new restart_minute = minute + minutes;
    new restart_second = second;

    while(restart_minute >= 60)
    {
        restart_minute -= 60;
        restart_hour++;
    }
    while(restart_hour >= 24)
    {
        restart_hour -= 24;
    }

    new announce_string[256];
    format(announce_string, sizeof(announce_string),
           "{FF5533}[]: {FFFFFF}дминистратор %s[%d] запланировал рестарт сервера через %d минут. естарт будет вполнен в %02d:%02d:%02d.",
           GetPlayerNameEx(playerid), playerid, minutes, restart_hour, restart_minute, restart_second);
    SendClientMessageToAll(0xFFFFFFFF, announce_string);

    new fmt_msg[128];
    format(fmt_msg, sizeof fmt_msg, "апланировал рестарт сервера через %d минут (%02d:%02d:%02d)", minutes, restart_hour, restart_minute, restart_second);
    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

    if(GetPlayerAdminEx(playerid) < 6)
    {
        format(fmt_msg, sizeof fmt_msg, "[A] дминистратор %s[%d] запланировал рестарт сервера через %d минут", GetPlayerNameEx(playerid), playerid, minutes);
        SendMessageToAdmins(fmt_msg, 0x999999FF);
    }

    restart_timer = SetTimer("RestartCountdown", 1000, true);
}

forward RestartCountdown();
public RestartCountdown()
{
    if(restart_countdown <= 0)
    {

        KillTimer(restart_timer);
        restart_timer = -1;
        restart_active = false;

        for(new i = 0; i < MAX_PLAYERS; i++)
        {
        SendClearChat(i);
        SetTimerEx("ClearChat", 50, false, "ii", i, CH_RESTART1);
       }
        SetTimer("RestartServer", 2000, false);
        return;
    }

    if(restart_countdown == 60)
    {
   	for(new i = 0; i < MAX_PLAYERS; i++)
        {
     	  SendClearChat(i);
     	  SetTimerEx("ClearChat", 50, false, "ii", i, CH_RESTART2);
        }
    }
    else if(restart_countdown == 30)
    {
   	 for(new i = 0; i < MAX_PLAYERS; i++)
        {
     	  SendClearChat(i);
    	   SetTimerEx("ClearChat", 50, false, "ii", i, CH_RESTART3);
        }
    }
    else if(restart_countdown == 10)
    {
   	 for(new i = 0; i < MAX_PLAYERS; i++)
        {
        SendClearChat(i);
        SetTimerEx("ClearChat", 50, false, "ii", i, CH_RESTART4);
        }
    }
    else if(restart_countdown <= 5 && restart_countdown > 0)
    {
   	 for(new i = 0; i < MAX_PLAYERS; i++)
        {
       	SendClearChat(i);
       	SetTimerEx("ClearChat", 50, false, "ii", i, CH_RESTART5);
        }
    }
    else if(restart_countdown == 300)
    {
   	 for(new i = 0; i < MAX_PLAYERS; i++)
        {
       	SendClearChat(i);
       	SetTimerEx("ClearChat", 50, false, "ii", i, CH_RESTART6);
        }
    }

    restart_countdown--;
}

forward RestartServer();
public RestartServer()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
        {
            for(new gui = 1; gui < 255; gui++)
            {
                    HidePlayerGUI(i, gui);
            }
            
            SendClientMessage(i, -1, "ервер перезапускаетс...");
            Kick(i);
        }
    }
    
    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(IsValidVehicle(i))
        {
            DestroyVehicle(i);
        }
    }
    
    if(restart_timer != -1)
    {
        KillTimer(restart_timer);
        restart_timer = -1;
    }
    restart_active = false;
    server_restart = true;
    GameModeExit(); 
    return 1;
}

stock strreplace(string[], find[], replace[])
{
    new len = strlen(string);
    new find_len = strlen(find);
    new replace_len = strlen(replace);
    new result[512];
    new idx = 0;

    for(new i = 0; i < len; i++)
    {
        if(strcmp(string[i], find, true, find_len) == 0)
        {
            strcat(result, replace);
            i += find_len - 1;
            idx += replace_len;
        }
        else
        {
            result[idx++] = string[i];
            result[idx] = '\0';
        }
    }

    strcat(string, result);
    return 1;
}

