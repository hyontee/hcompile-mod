alias:e("en")

stock ToggleEngine(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xFF0000FF, "{FF5252}|{FFFFFF}  не в транспорте.");

    new vehicleid = GetPlayerVehicleID(playerid);

    if(IsABike(vehicleid))
        return SendClientMessage(playerid, 0xFF0000FF, "{FF5252}|{FFFFFF} а байке двигател не нужен.");

    if(!IsPlayerDriver(playerid))
        return SendClientMessage(playerid, 0xFF0000FF, "{FF5252}|{FFFFFF}  не за рулем.");

    new Float:veh_hp = GetVehicleData(vehicleid, V_HEALTH);
    if(veh_hp <= 270.0) {
        ShowNotificationSile(playerid, 2, 5, 0, 0, "аш двигател неисправен.", " ");
        return 1;
    }
    if(GetVehicleData(vehicleid, V_FUEL) <= 0.0)
        return ShowNotificationSile(playerid, 2, 5, -1, -1, "ет бензина.", "");

    new engine = GetVehicleParam(vehicleid, V_ENGINE) ^ 1;
    SetVehicleParam(vehicleid, V_ENGINE, engine);

	new idx = GetVehicleData(vehicleid, V_ACTION_ID);
    if(idx != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[idx][OC_HORN_ID] != 0)
        {
            SetVehicleHornSound(vehicleid, g_ownable_car[idx][OC_HORN_ID], 1);
        }
        if(g_ownable_car[idx][OC_EXHAUST] != 0)
        {
            SetVehicleExhaust(vehicleid, g_ownable_car[idx][OC_EXHAUST], 1);
        }
        if(g_ownable_car[idx][OC_OBCLEARANCE] != -1)
        {
                new suspension = max(g_ownable_car[idx][OC_OBCLEARANCE] / 50.0, 0.2);
                SetVehicleSuspensionForce(vehicleid, suspension, 0);
        }
        if(g_ownable_car[idx][OC_NITRO] != -1)
        {
            switch(g_ownable_car[idx][OC_NITRO])
            {
                case 0: AddVehicleComponent(vehicleid, 1008);
                case 1: AddVehicleComponent(vehicleid, 1009);
                case 2: AddVehicleComponent(vehicleid, 1010);
            }
        }
		if(g_ownable_car[idx][OC_ENABLE_HAND] != 0)
		{
			switch(g_ownable_car[idx][OC_ENABLE_HAND])
			{
				case 0: SetVehicleStockFP(playerid, vehicleid);
				case 1: SetVehicleComfortFP(playerid, vehicleid);
				case 2: SetVehicleDriftFP(playerid, vehicleid);
				case 3: SetVehicleSportFP(playerid, vehicleid);
				case 4: SetVehicleSportPlusFP(playerid, vehicleid);
				default: SetVehicleStockFP(playerid, vehicleid);
			}
		}
	}

    return 1;
}


CMD:e(playerid, params[])
{
    return ToggleEngine(playerid);
}

alias:l("lights")
CMD:l(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return SendClientMessage(playerid, 0xCECECEFF, " не за рулем");

		lights = (GetVehicleParam(vehicleid, V_LIGHTS) ^ VEHICLE_PARAM_ON);
		SetVehicleParam(vehicleid, V_LIGHTS, lights);
	}
	return 1;
}

CMD:sl(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return SendClientMessage(playerid, 0xCECECEFF, " не за рулем");

		new limit = (GetVehicleData(vehicleid, V_LIMIT) ^ VEHICLE_PARAM_ON);
		SetVehicleData(vehicleid, V_LIMIT, limit);
	}
	return 1;
}


CMD:i(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return SendClientMessage(playerid, 0xCECECEFF, " не за рулем");

		new stationid = GetNearestFuelStation(playerid, 10.0);
		if(stationid != -1)
		{
			FuelStationFillCar(playerid, vehicleid, stationid);
		}
		else SendClientMessage(playerid, 0xCECECEFF, "облизости нет заправочнх станций");
	}
	return 1;
}

CMD:alarm(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return SendClientMessage(playerid, 0xCECECEFF, " не за рулем");

		alarm = (GetVehicleData(vehicleid, V_ALARM) ^ VEHICLE_PARAM_ON);
		SetVehicleData(vehicleid, V_ALARM, alarm);
	}
	return 1;
}

CMD:charity(playerid, params[])
{
	new Cache: result;
	new rows;
	new money;
	new fmt_str[75];
	new string[512];

	cache_set_active(charity_cache_data);
	rows = cache_num_rows();

	string = "умма\t\tм\n\n{FFFFFF}";
	for(new idx; idx < rows; idx ++)
	{
		cache_get_row(idx, 0, fmt_str);
		money = cache_get_row_int(idx, 1);

		format(fmt_str, sizeof fmt_str, "%d руб\t\t%s\n", money, fmt_str);
		strcat(string, fmt_str);
	}
	cache_set_active(Cache:0);

	format(fmt_str, sizeof fmt_str, "SELECT SUM(money) as money FROM charity WHERE uid=%d LIMIT 1", GetPlayerAccountID(playerid));
	result = mysql_query(mysql, fmt_str, true);

	money = cache_get_row_int(0, 0);
	cache_delete(result);

	format(fmt_str, sizeof fmt_str, "\n{999999}умма аших пожертвований: %d руб", money);
	strcat(string, fmt_str);

	return Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{00CC00}оп 25 благотворителей", string, "акрт", "");
}

