				if(GetPlayerInko(playerid) >= 1)
				{
					if(inko[playerid] >= 1)
					{
						inko[playerid] = 0;
						napinko[playerid] = -1;
						blist[playerid] = 0;

						napinko[napinko[playerid] ] = -1;
						blist[napinko[playerid]] = 0;
						DestroyVehicle(vehidinko[playerid]);
						vehidinko[playerid] = INVALID_VEHICLE_ID;
						SetPlayerSkin(playerid, GetPlayerSkinEx(playerid));
						ResetPlayerWeapons(playerid);
					}
					else
					{
						inko[playerid] = 1;
						SetPlayerSkin(playerid, 81);
						GivePlayerWeapon(playerid, 30, 100);
						GivePlayerWeapon(playerid, 24, 100);
						SendClientMessage(playerid, 0xFF5252, "| абочий ден инкассатора успешно начат");
					}
				}
			}
			case 2: callcmd::inkotops(playerid);
			case 3: SendClientMessage(playerid, 0xFF0000, " разработке");
			case 4:
			{
				if(GetPlayerInko(playerid) == 1)
				{
					new fmt[260], str[96];
					format(str, sizeof str, "ична карточка инкассатора %s", GetPlayerNameEx(playerid));

					format(fmt, sizeof fmt, "{FF5252}#1.\t{FFFFFF}анимаема должност: {FF5252}инкассатор %d класса{FFFFFF}\n\
					{FF5252}#2.\t{FFFFFF}екущий навк инкассатора: {FF5252}%d{FFFFFF}\n\
					{FF5252}#3.\t{FFFFFF}еобходимое количество навков дл открти следующего класса{FF5252}0/%d{FFFFFF}",
					GetPlayerRang(playerid), GetPlayerZakazInko(playerid), infoinko[GetPlayerRang(playerid)]);
					ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, str, fmt, "акрт", "");
				}
				else return 1;
			}
			case 5:
			{
				if(GetPlayerLevel(playerid) < 15 && GetPlayerData(playerid, P_WEAPON_LIC) == 0 && GetPlayerData(playerid, P_DRIVING_LIC) == 0) return SendClientMessage(playerid, -1, "| едоступно!");
				if(GetPlayerInko(playerid) == 0)
				{
					new query[128];
					mysql_format(mysql, query, sizeof query, "SELECT * FROM inko WHERE id=%d", GetPlayerAccountID(playerid));
					mysql_query(mysql, query, true);
					if(cache_num_rows())
					{
						mysql_format(mysql, query, sizeof query, "UPDATE inko SET work=1 WHERE id=%d", GetPlayerAccountID(playerid));
						mysql_query(mysql, query, true);
					}
					else
					{
						mysql_format(mysql, query, sizeof query, "INSERT INTO inko(id, zakaz, rang, work) VALUES (%d, 0, 1, 1)", GetPlayerAccountID(playerid));
						mysql_query(mysql, query, true);
					}
					SendClientMessage(playerid, 0xFF0000, "|  успешно устроилис инкассатором. ачните рабочий ден");
				}
				else if(GetPlayerInko(playerid) == 1)
				{
					SetPlayerInko(playerid, 0);
					if(inko[playerid] >= 1)
					{
						inko[playerid] = 0;
						napinko[playerid] = -1;
						blist[playerid] = 0;

						napinko[napinko[playerid] ] = -1;
						blist[napinko[playerid]] = 0;
						DestroyVehicle(vehidinko[playerid]);
						vehidinko[playerid] = INVALID_VEHICLE_ID;
						SetPlayerSkin(playerid, GetPlayerSkinEx(playerid));
						ResetPlayerWeapons(playerid);
					}
					SendClientMessage(playerid, 0xFF0000, "|  уволилис с инкассатора.");
				}
			}
		}
	}
	if(dialogid == 87654)
	{
		if(!response) return 1;
		switch(listitem)
		{
			case 0:
			{
				if(GetPlayerMoneyEx(playerid) < 5000) return 1;
				if(napinko[playerid] == -1) return 1;
				if(inko[playerid] == 0) return 1;
				new Float: x, Float: y, Float: z;
