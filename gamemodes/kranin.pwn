           	JSON_SetInt(JSONObject, "y", 0);
               JSON_SetInt(JSONObject, "k", -1);

				JSON_SetString(JSONObject, "n", "веденнй ами номер уже занто.");
        		JSON_SetString(JSONObject, "m", "шибка!");

				SendPacketToClient(playerid, 22, JSONObject);
                return 1;
            }

            new freeSlot = Inventory_GetFreeSlot(playerid);
            if(freeSlot == -1)
            {
                new Node:JSONObject = JSON_Object();

				JSON_SetInt(JSONObject, "t", 0);
           	JSON_SetInt(JSONObject, "y", 0);
               JSON_SetInt(JSONObject, "k", -1);

				JSON_SetString(JSONObject, "n", " ас нет свободнх слотов в инвентаре.");
        		JSON_SetString(JSONObject, "m", "шибка!");

				SendPacketToClient(playerid, 22, JSONObject);
                return 1;
            }

            new price = 70;
            if(GetPlayerDonateRub(playerid) < price)
            {
                new Node:JSONObject = JSON_Object();

				JSON_SetInt(JSONObject, "t", 0);
           	JSON_SetInt(JSONObject, "y", 0);
               JSON_SetInt(JSONObject, "k", -1);

				JSON_SetString(JSONObject, "m", "едостаточно средств.");
                JSON_SetString(JSONObject, "n", "ополните счет чтоб купит!");

				SendPacketToClient(playerid, 22, JSONObject);
                return 1;
            }

            GivePlayerDonateRub(playerid, -price, "окупка 4-значной SIM-карт", true, true);

            Inventory_AddSIM(playerid, freeSlot, number);

            format(query, sizeof query, " успешно приобрели SIM-карту с номером {0099FF}%d", number);
            new Node:JSONObject = JSON_Object();

			JSON_SetInt(JSONObject, "t", 0);
			JSON_SetInt(JSONObject, "y", 1);

			JSON_SetString(JSONObject, "m", query);
    		JSON_SetString(JSONObject, "n", "сползуйте её через инвентар.");

    		JSON_SetInt(JSONObject, "r", GetPlayerMoney(playerid));
    		JSON_SetInt(JSONObject, "s", GetPlayerDonateRub(playerid) - 50);
    		SendPacketToClient(playerid, 22, JSONObject);

        }
        else
        {
            new Node:JSONObject = JSON_Object();

				JSON_SetInt(JSONObject, "t", 0);
           	JSON_SetInt(JSONObject, "y", 0);
               JSON_SetInt(JSONObject, "k", -1);

				JSON_SetString(JSONObject, "m", "едопустимй формат ввода! омер должен бт 4-значнм.");
        		JSON_SetString(JSONObject, "n", "шибка!");

				SendPacketToClient(playerid, 22, JSONObject);
        }
    }
}
			case DIALOG_DONATE_SKILLS:
			{
				if(response)
				{
					SetPVarInt(playerid, "skill_index", listitem);

					new skill_amount = GetPlayerSkillAmount(playerid, listitem);

					new title[48],
						fmt_text[200];

					format(title, sizeof title, "{FFCD00}рокачат навк: %s", skill_name[listitem]);

					format
					(
						fmt_text, sizeof fmt_text,
						"{FFCD00}%s:\t\t\t{FFFFFF}%d%%\n\n"\
						"тоимост 1 ед.:\t{6699cc}%d руб.\n"\
						"{FFFFFF}ведите количество единиц, на которое\n"\
						" хотите прокачат аш навк:",
						skill_name[listitem],
						skill_amount,
						GetDonatePrice(DONATE_PRICE_SKILLS)
					);

					Dialog(playerid, DIALOG_DONATE_SKILL_BUY, DIALOG_STYLE_INPUT, title, fmt_text, "алее", "тмена");
				}
			}
			case DIALOG_DONATE_SKILL_BUY:
			{
				if(response)
				{
					new skill_index = GetPVarInt(playerid, "skill_index"),
						skill_amount = strval(inputtext);

					if(!(0 <= skill_index <= 11))
						return ShowNotificationSile(playerid, 2, 6, 0, 0, "еизвестна ошибка!", "");

					if(skill_amount > 0 && IsNumeric(inputtext))
					{
						new skill_max = 100 - GetPlayerSkillAmount(playerid, skill_index);

						new fmt_text[90];

						if(skill_amount <= skill_max)
						{
							new skill_price = GetDonatePrice(DONATE_PRICE_SKILLS) * skill_amount;

							if(GetPlayerDonateRub(playerid) >= skill_price)
							{
								GivePlayerDonateRub(playerid, -skill_price, "рокачка навков", true, true);

								SetPlayerSkillAmount(playerid, skill_index, GetPlayerSkillAmount(playerid, skill_index) + skill_amount);

								new skill_db_name[12][20] =
								{
									"power",
									"skill_colt",
									"skill_sdpistol",
									"skill_deagle",
									"skill_shotgun",
									"skill_mp5",
									"skill_ak47",
									"skill_m4",
									"skill_sniper_rifle",
									"skill_sawnoff",
									"skill_combat_sg",
									"skill_micro_uzi"
								};

								UpdatePlayerDatabaseInt(playerid, skill_db_name[skill_index], GetPlayerSkillAmount(playerid, skill_index));

								format(fmt_text, sizeof fmt_text, " прокачали навк %s на %d ед. екущее значение: %d ед.",
								skill_name[skill_index], skill_amount, GetPlayerSkillAmount(playerid, skill_index));

								ShowNotification(playerid, 3, fmt_text, 4, "", "");

							}
							else
							{
								format(fmt_text, sizeof fmt_text, "л прокачки %d ед. навка требуетс %d.00 руб. на счету", skill_amount, skill_price);
								ShowNotification(playerid, 2, fmt_text, 4, "", "");
							}
						}
						else
						{
							format(fmt_text, sizeof fmt_text, "аксималное значение навка: 100 ед.,  можете прокачат еще %d ед.", skill_max);
							ShowNotification(playerid, 2, fmt_text, 4, "", "");
						}
					}
					else ShowNotification(playerid, 3, "ведите корректное значение!", 4, "", "");
				}

			}

			case DIALOG_TEAM_CHANGE_SKIN:
			{
				if(!response) return 1;

				new to_player = GetPVarInt(playerid, "change_team_skin_playerid");
				new team_id = GetPlayerTeamEx(playerid);

				if(team_id < 1 || team_id >= MAX_ORG || GetPlayerJob(playerid) < 9 || GetPlayerJob(playerid) > 10)
					return SendClientMessage(playerid, 0x999999FF, "ет прав на изменение внешности");

				if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || team_id != GetPlayerTeamEx(to_player))
					return SendClientMessage(playerid, 0x999999FF, "грок не состоит в организации");

				if(GetPlayerSex(to_player))
					return SendClientMessage(playerid, 0x999999FF, "елз изменит внешност игрокам с женским полом");

				new index = GetPlayerListitemValue(playerid, listitem);
				new skin_id = GetTeamData(team_id, O_SKINS)[index];

				SetPlayerData(to_player, P_OSKIN, skin_id);

				new query[128];
				mysql_format(mysql, query, sizeof query,
					"UPDATE accounts SET org_skin=%d WHERE id=%d",
					skin_id, GetPlayerAccountID(to_player));
				mysql_query(mysql, query, false);

				ResetSkin(to_player);

				format(query, sizeof query, "аша внешност бла изменена %s организации %s[%d]",
					GetPlayerJob(playerid) >= 10 ? ("лидером") : ("заместителем"), GetPlayerNameEx(playerid), playerid);
				SendClientMessage(to_player, 0x3399FFFF, query);

				format(query, sizeof query, " изменили внешност %s[%d]", GetPlayerNameEx(to_player), to_player);
				SendClientMessage(playerid, 0x3399FFFF, query);

				return 1;
			}

