		SetVehicleSuspensionForce(vehicleid, suspension, 1);
	}
    SetVehicleParam(vehicleid, V_LOCK, bool:cache_get_field_content_int(0, "status"));
    SetVehicleData(vehicleid, V_MILEAGE, cache_get_field_content_float(0, "mileage"));
    SetVehicleData(vehicleid, V_FUEL, cache_get_field_content_float(0, "fuel"));
    SetVehicleData(vehicleid, V_LAST_LOAD_TIME, gettime());
    SetVehicleData(vehicleid, V_HEALTH, cache_get_field_content_float(0, "health"));
    SetVehicleHealth(vehicleid, cache_get_field_content_float(0, "health"));

    LoadVehicleTuningFromCache(vehicleid, 0, result);
    Trunk_LoadVehicle(vehicleid, tmp_sql_id);

	for(new i; i < MAX_PLAYERS; i++)
	{
		SetTimerEx("DelayedSyncVehicleTuning", 400, false, "dd", vehicleid, i);
	}

    cache_delete(result);
    g_ownable_car_loaded++;

    return vehicleid;
}

public: LoadOwnableCarLastPos(oc_id)
{
    if(g_ownable_car_loaded + 1 > MAX_OWNABLE_CARS)
    {
        printf("[OwnableCars] шибка: ревшен лимит личного транспорта (%d) при загрузке ID %d.", MAX_OWNABLE_CARS, oc_id);
        return -1;
    }

    new query[128];
    mysql_format(mysql, query, sizeof query, "SELECT * FROM ownable_cars WHERE id='%d' LIMIT 1", oc_id);
    new Cache:result = mysql_query(mysql, query, true);

    if(cache_num_rows() != 1)
    {
        printf("[OwnableCars] шибка: апис с id %d не найдена или запрос вернул %d строк.", oc_id, cache_num_rows());
        cache_delete(result);
        return -1;
    }

    new idx = GetFreeOwnableCarID();
    if(idx == -1)
    {
        printf("[OwnableCars] шибка: е удалос найти свободнй слот дл загрузки машин ID %d.", oc_id);
        cache_delete(result);
        return -1;
