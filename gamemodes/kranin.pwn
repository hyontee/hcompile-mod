        {FFFFFF}-ит(вред) - ан на 10-30 дней.\n\
        {FFFFFF}-ффтоп/флуд в репорт - 5-15мин мута\n\
        {FFFFFF}-heat - ан 5-30\n\
        {FFFFFF}-еклама - /banpc 30 дней.\n\
        {FFFFFF}-агоюз -  /jail 10-20мин.\n\
        {FFFFFF}-Non rp cop - /warn или /jail 15-30 минут.",
        "рочитал", "");
        return 1;
}
forward golodbr(playerid);
public golodbr(playerid)
{
	golod[playerid] -= 5;
	ShowNotification(playerid, 3, " проголодалис,ваше здорове ухудшилос", 4, "", "");
	new hp;
	GetPlayerHealth(playerid, hp);
	SetPlayerHealth(playerid, hp-5);
	return 1;
}

CMD:helpers(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) == 0)
    {
        if(GetPlayerPremium(playerid) == 0)
            return SendClientMessage(playerid, 0xCECECEFF, " ас нет VIP аккаунта.");
    }

    new fmt_text[100],
    list[sizeof fmt_text * 10 + 50] = "икнейм\t\t\t\t\tолжност\t\t\t\tнформаци\n";

    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i)) continue;
        else if(!IsPlayerLogged(i)) continue;
        else if(!GetPlayerHelperEx(i)) continue;

        new Helper = GetPlayerHelperEx(i);
        switch(Helper)
        {
            case 1: format(fmt_text, sizeof fmt_text, "%s[%d]\t\t\t\t\tелпер(1)\t\t\t\t{66CC33}в игре\n", GetPlayerNameEx(i), i);
            default: format(fmt_text, sizeof fmt_text, "%s[%d]\t\t\t\t\tлавнй хелпер(2)\t\t\t\t{66CC33}в игре\n", GetPlayerNameEx(i), i);
        }
        strcat(list, fmt_text);
    }

    new title[128];
    format(title, sizeof(title), "{FF5252}%s{ffffff} | омощники в сети", NameServer[SILE_NAME]);

    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, title, list, "акрт", "");

    return 1;
}

CMD:dm(playerid, params[])

{

	if(GetPlayerAdminEx(playerid) < 1) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /dm [ID игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))

	return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	new jail_time = 60;

    if(GetPlayerData(to_player, P_JAIL) > 0) return SendClientMessage(playerid, 0xCECECEFF, ""SC"тот игрок уже сидит в тюрме");

	if(AntiSliv(playerid, "/dm")) return true;

	new fmt_msg[999];

	format(fmt_msg, sizeof fmt_msg, "дминистратор %s посадил в тюрму игрока %s на %d мин", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), jail_time);

	format(fmt_msg, sizeof fmt_msg, "%s. ричина: Death Match (DM)", fmt_msg);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SendClientMessage(to_player, 0xCECECEFF, ""SC"рем до окончани заключени: {CCCC00}/time");
    SendClientMessage(to_player, 0xCECECEFF, ""SC"оветуем ознакомитс с правилами сервера, чтоб не получат подобнх наказаний.");
    ShowNotificationSile(to_player, 2, 6, 0, 0, "{FFFFFF}рем до окончани заключени: {CCCC00}/time", "");

	JailPlayer(to_player, jail_time);

	format(fmt_msg, sizeof fmt_msg, "осадил в тюрму %s[acc:%d] на %d мин. ричина: DM",

	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), jail_time);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;

}

