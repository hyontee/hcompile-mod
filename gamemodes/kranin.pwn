                    format(fmt_str, sizeof fmt_str, "{FFFFFF}а ваш баланс бло вдано {FF5252}%d рублей (50%% от гос. цен)", sell_price);
                    SendClientMessage(playerid, -1, "{FFFFFF} успешно продали транспорт государству.");
                    SendClientMessage(playerid, -1, fmt_str);
                }
            }
            else
            {
                SendClientMessage(playerid, -1, "{00CC00}шибка: цена дл этого транспортного средства не найдена в базе даннх");
            }
        }
