        }
        else
        {
            price = GetVehicleInfo(model_id - 400, VI_PRICE);
            price_auto = price * 1 / 100;
            SetPVarInt(playerid, "price_rent", price_auto);

            format(w_str, sizeof w_str,
            "1. тметит транспорт на GPS {FF6600}(300 руб)\n\
			{FFFFFF}2. агрузит транспорт на этой парковке (%d руб)", price_auto);
        }
    }
    else
    {
        if (g_ownable_car_loaded + 1 > MAX_OWNABLE_CARS)
        {

            format(w_str, sizeof w_str,
			"1. тметит транспорт на GPS {FF6600}(300 руб)\n"\
			"2. агрузит транспорт на месте {FF6600}вгрузки\n"\
			"3. агрузит транспорт на месте {FF6600}парковки\n"\
			"4. бросит парковку автомобил");
        }
        else
        {
            format(w_str, sizeof w_str,
			"1. тметит транспорт на GPS {FF6600}(300 руб)\n"\
			"2. агрузит транспорт на месте {FF6600}вгрузки\n"\
			"3. агрузит транспорт на месте {FF6600}парковки\n"\
			"4. бросит парковку автомобил");
        }
    }

    Dialog(playerid, DIALOG_OWNABLE_CAR_LOAD, DIALOG_STYLE_LIST,
        "{FFCD00}истема управлени транспортом",
        w_str,
        "брат", "акрт");
