            SendClientMessage(playerid, -1, " вас недостаточно денег дл создани семи! ужно 3.000.000 рублей.");
            return 1;
        }

        if(GetPlayerIdFamily(playerid) != -1)
        {
            SendClientMessage(playerid, -1, ""c_f_r" уже состоите в семе.");
            return 1;
        }

        Dialog
        (
            playerid, 2238, DIALOG_STYLE_INPUT,
