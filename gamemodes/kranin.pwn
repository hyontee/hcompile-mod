public: ShowPlayerLotteryDialog(playerid)
{
	if(GetPlayerData(playerid, P_LOTTERY) >= 100)
	{
		new hour;
		new fmt_str[632];

		gettime(hour);
		format
		(
			fmt_str, sizeof fmt_str,
			"аше счастливое число: {FFCD00}%d\n\n"\
			"{FFFFFF} зарегистрирован в лотерее, резултат будет известен во\n"\
			"врем ближайшего розгрша, которй пройдёт в %d:02\n"\
			"е входите из игр чтоб принт в нём участие.\n\n"\
			"игрш будет зависет от того, сколко чисел совпало в\n"\
			"вашем счастливом числе и в числе, которое впадет во\n"\
			"врем розгрша (по пордку слева направо):\n\n"\
			"ет совпадений:\t{FF6633}0 руб\n"\
			"{FFFFFF}1 число:\t\t{66FF00}2000 руб\n"\
			"{FFFFFF}2 числа:\t\t{66FF00}15000 руб\n"\
			"{FFFFFF}се числа:\t\t{66FF00}50000 руб\n\n"\
			"{FFFFFF}сли  хотите изменит счастливое число, введите нове\n"\
			"3 цифр.  противном случае просто нажмите \"к\"",
			GetPlayerData(playerid, P_LOTTERY),
			GetElapsedTime(gettime(), g_last_lottery_time) >= 1 ? hour : hour+1
		);
		Dialog(playerid, DIALOG_BIZ_LOTTERY, DIALOG_STYLE_INPUT, "{66CC00}отере", fmt_str, "к", "");
	}
}

