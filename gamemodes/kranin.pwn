CMD:flood(playerid, params[])
{

	if(GetPlayerAdminEx(playerid) < 3) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /flood [id игрока]");
	extract params -> new to_player;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");
	new mute_time = 30;

	if(GetPlayerData(to_player, P_MUTE) > 0) return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест мут");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "елз поставит заблокироват чат администратору вше по рангу");

	if(AntiSliv(playerid, "/flood")) return true;
	new fmt_msg[999];
	format(fmt_msg, sizeof fmt_msg, "дминистратор %s вдал блокировку чата игроку %s на %d мин", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), mute_time);
	format(fmt_msg, sizeof fmt_msg, "%s. ричина: луд", fmt_msg);
	SendClientMessageToAll(0xFF5533FF, fmt_msg);
	SetPlayerData(to_player, P_MUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "mute", mute_time * 60);
	SendClientMessage(to_player, 0xCECECEFF, ""SC"рем до окончани бана чата: {CCCC00}/time");
	SendClientMessage(to_player, 0xCECECEFF, ""SC"оветуем ознакомитс с правилами сервера, чтоб не получат подобнх наказаний.");
	ShowNotificationSile(to_player, 2, 5, 0, 0, "{FFFFFF} вас имеетс активнй мут. рем до\n{FFFFFF}разблокировки: {CCCC00}/time", " ");
	format(fmt_msg, sizeof fmt_msg, "дал %s[acc:%d] блокировку чата на %d мин. ричина: луд",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);
	return 1;
}

CMD:mat(playerid, params[])
{

	if(GetPlayerAdminEx(playerid) < 4) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"сползуйте: /mat [ID игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	new mute_time = 30;
	if(GetPlayerData(to_player, P_MUTE) > 0) return SendClientMessage(playerid, 0xCECECEFF, ""SC" этого игрока уже ест мут");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"елз вдат мут администратору вше вашего ранга");

	if(AntiSliv(playerid, "/mat")) return true;

	new fmt_msg[999];
	format(fmt_msg, sizeof fmt_msg, "дминистратор %s вдал блокировку чата игроку %s на %d минут", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), mute_time);

	format(fmt_msg, sizeof fmt_msg, "%s. ричина: ат в вип чат", fmt_msg);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SetPlayerData(to_player, P_MUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "mute", mute_time * 60);

	SendClientMessage(to_player, 0xCECECEFF, ""SC"рем до окончани бана чата: {CCCC00}/time");
	SendClientMessage(to_player, 0xCECECEFF, ""SC"оветуем ознакомитс с правилами сервера, чтоб не получат подобнх наказаний.");
	ShowNotificationSile(to_player, 2, 5, 0, 0, "{FFFFFF} вас имеетс активнй мут. рем до\n{FFFFFF}разблокировки: {CCCC00}/time", " ");

	format(fmt_msg, sizeof fmt_msg, "дал %s[acc:%d] блокировку чата на %d минут. ричина: ат в вип чат",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}
CMD:delveh(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 4) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");
    if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""USC" должн бт за рулем автомобил");
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return true;
    if(GetVehicleData(GetPlayerVehicleID(playerid), V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN_CAR)
    {
	    RemovePlayerFromVehicle(playerid);
	    n_veh_DestroyVehicle(GetPlayerVehicleID(playerid));
	    SendClientMessage(playerid, 0xCECECEFF, ""SC" удалили созданнй транспорт");

	    new fmt_msg[999];

    	format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] удалил созданнй транспорт", GetPlayerNameEx(playerid), playerid);
    	SendMessageToAdmins(fmt_msg, 0x999999FF);
	}
	return true;
}

CMD:reset_cash(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	extract params -> new to_player, cash; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /reset_cash [ID игрока] [cумма]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	new reason[999];
	new fmt_msg[999];
	format(reason, sizeof reason, "{1E90FF}дминистратор %s[%d] обнулил вам денги", GetPlayerNameEx(playerid), playerid);
	GivePlayerMoneyEx(to_player, -cash, reason, true, true);
	SendClientMessage(to_player, 0x66CC00FF, reason);

    format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] обнулил денги игроку %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
    SendMessageToAdmins(fmt_msg, 0x999999FF);

	format(reason, sizeof reason, "{1E90FF} обнулили %s %d рублей", GetPlayerNameEx(to_player), cash);
	SendClientMessage(playerid, 0x66CC00FF, reason);

	format(reason, sizeof reason, "бнулил %s[%d] %d руб", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), cash);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, reason);
	return 1;
}

CMD:reset_donate(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	extract params -> new to_player, donate; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /reset_donate [ID игрока] [cумма]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	new reason[999];
	new fmt_msg[999];
	format(reason, sizeof reason, "{1E90FF}дминистратор %s[%d] обнулил вам донат", GetPlayerNameEx(playerid), playerid);
	GivePlayerDonateRub(to_player, -donate, reason, true, true);
	SendClientMessage(to_player, 0x66CC00FF, reason);

    format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] обнулил донат игроку %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
    SendMessageToAdmins(fmt_msg, 0x999999FF);

	format(reason, sizeof reason, "{1E90FF} обнулили %s %d доната", GetPlayerNameEx(to_player), donate);
	SendClientMessage(playerid, 0x66CC00FF, reason);

	format(reason, sizeof reason, "бнулил %s[%d] %d доната", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), donate);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, reason);
	return 1;
}

CMD:givevip(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return ShowNotificationSile(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");
	extract params -> new to_player, premium, days; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /givevip [ID игрока] [уровен премиум-аккаунта] [врем (в днх)]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotificationSile(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

	if(!(1 <= premium <= 3)) return SendClientMessage(playerid, 0x999999FF, "ровен премиум-аккаунта от 1 до 3 (чтоб отобрат, исползуйте кол-во дней: 0)");

	if(!(0 <= days <= 30)) return SendClientMessage(playerid, 0x999999FF, "оличество дней от 0 до 30");

	new fmt_msg[999];

	new premium_rank[3][17] =
	{
		"{C0C0C0}Silver",
		"{FF5252}Gold",
		"{E5E4E2}Platinum"
	};

	SetPlayerData(to_player, P_PREMIUM, premium);
	SetPlayerData(to_player, P_PREMIUM_TIME, gettime() + days * 86400);

	UpdatePlayerDatabaseInt(to_player, "premium", premium);
	UpdatePlayerDatabaseInt(to_player, "premium_time", gettime() + days * 86400);

	format(fmt_msg, sizeof fmt_msg, "%s вдал ам %s {3399FF}премиум-аккаунт на %d дн.", GetPlayerNameEx(playerid), premium_rank[premium - 1], days);
	SendClientMessage(to_player, 0x3399FFFF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, " вдали %s %s {3399FF}премиум-аккаунт на %d дн.", GetPlayerNameEx(to_player), premium_rank[premium - 1], days);
	SendClientMessage(playerid, 0x3399FFFF, fmt_msg);

	return 1;
}

CMD:epoints(playerid)
{
	if(GetPlayerAdminEx(playerid) < 1) return 0;

	new fmt_str[300];

	format(str, sizeof str, "{FF5252}%s{ffffff} | аллов: {FF5252}%d", NameServer[SILE_NAME], GetPlayerData(playerid, P_ACOINS));

	Dialog
		(
			playerid, DIALOG_ADMSHOP, DIALOG_STYLE_LIST,
			str,
			"{FF5252} #1 {FFFFFF}иртуална алюта\t\t\t\t\t {888888} нажмите дл взаимодействи\n"\
			"{FF5252} #2 {FFFFFF}онатна алюта\t\t\t\t\t {888888} нажмите дл взаимодействи\n"\
			"{FF5252} #3 {FFFFFF}ип статус\t\t\t\t\t {888888} нажмите дл взаимодействи\n"\
			"{FF5252} #4 {FFFFFF}ейс\t\t\t\t\t {888888} нажмите дл взаимодействи\n"\
			"{FF5252} #5 {FFFFFF}никалне аксессуар\t\t\t\t\t {888888} нажмите дл взаимодействи",
			"брат", "акрт"
		);
}
CMD:giveepoints(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return 1;

	extract params -> new to_player, acoins; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /giveepoints [id игрока] [cумма]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(-1 <= acoins <= 100_000)) return SendClientMessage(playerid, 0xCECECEFF, "ожно вдават от 1 до 10000 аллов за один раз");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, -1, ""USC" грок не в сети!");

	new fmt_text[999];

    format(fmt_text, sizeof fmt_text, "{FFFFFF}дминистратор {FF5252}%s {FFFFFF}вдал ам {FF5252}%d {FFFFFF}балла(-ов) обмена.", GetPlayerNameEx(playerid), acoins);
	SendClientMessage(to_player, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, "{FFFFFF}тоб потратит балл восползуйтес специалной командой: {FF5252}/epoints");
	SendClientMessage(to_player, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, "[A] %s[%d] вдал балл дл обмена %s[%d] кол-во %d баллов, в итоге у игрока %d баллов", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, acoins, GetPlayerMoneyEx(to_player));
	SendMessageToAdmins(fmt_text, 0xCECECEFF);

    AddPlayerData(playerid, P_ACOINS, +, acoins);
	UpdatePlayerDatabaseInt(playerid, "acoins", GetPlayerData(to_player, P_ACOINS) - 450);
	return 1;
}

stock GivePlayerCar(playerid, modelid, color_1, color_2)
{

		if((GetPlayerOwnableCars(playerid) + 1) > GetPlayerCarSlots(playerid))
		{
			SendClientMessage(playerid, 0x3399FFFF, "се слот дл транспорта зант.  можете увеличит их: {FF5252}/menu > ополнително");
			return -1;
		}

		if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
		{
			SendClientMessage(playerid, 0x999999FF, "л покупки транспорта нужно вгрузит уже загруженнй транспорт с сервера");
			return -1;
		}

		new buy_cars_count = cars_after_purchase_count[2]++;

		if(buy_cars_count >= 4)
			cars_after_purchase_count[2] = 0;

		new Float: pos_x = cars_pos_after_purchase[2][buy_cars_count][0];
		new Float: pos_y = cars_pos_after_purchase[2][buy_cars_count][1];
		new Float: pos_z = cars_pos_after_purchase[2][buy_cars_count][2];
		new Float: angle = cars_pos_after_purchase[2][buy_cars_count][3];

		new query[220],
			Cache: result,
			idx;

		idx = GetFreeOwnableCarID();

		SetOwnableCarData(idx, OC_OWNER_ID, 	GetPlayerAccountID(playerid));

		SetOwnableCarData(idx, OC_MODEL_ID, 	modelid);
		SetOwnableCarData(idx, OC_COLOR_1, 		color_1);
		SetOwnableCarData(idx, OC_COLOR_2, 		color_2);

		SetOwnableCarData(idx, OC_POS_X, 		pos_x);
		SetOwnableCarData(idx, OC_POS_Y, 		pos_y);
		SetOwnableCarData(idx, OC_POS_Z, 		pos_z);
		SetOwnableCarData(idx, OC_ANGLE, 		angle);

		strmid(g_ownable_car[idx][OC_NUMBER], "", 0, 8, 8);

		SetOwnableCarData(idx, OC_ALARM, 		false);
		SetOwnableCarData(idx, OC_KEY_IN, 		false);

		SetOwnableCarData(idx, OC_CREATE, 		gettime());

		format(g_ownable_car[idx][OC_OWNER_NAME], 21, GetPlayerNameEx(playerid));

		new vehicleid = CreateVehicle
		(
			GetOwnableCarData(idx, OC_MODEL_ID),
			GetOwnableCarData(idx, OC_POS_X),
			GetOwnableCarData(idx, OC_POS_Y),
			GetOwnableCarData(idx, OC_POS_Z),
			GetOwnableCarData(idx, OC_ANGLE),
			GetOwnableCarData(idx, OC_COLOR_1),
			GetOwnableCarData(idx, OC_COLOR_2),
			-1,
			0,
			VEHICLE_ACTION_TYPE_OWNABLE_CAR,
			idx
		);
		if(vehicleid != INVALID_VEHICLE_ID)
		{

			format(g_ownable_car[idx][OC_NUMBER], 12, g_ownable_car[idx][OC_NUMBER]);
			SetVehicleNumberPlateEx(vehicleid, g_ownable_car[idx][OC_NUMBER_TYPE], g_ownable_car[idx][OC_NUMBER], g_ownable_car[idx][OC_REGION]);
			SetVehicleParam(vehicleid, V_LOCK, false);

			SetVehicleData(vehicleid, V_MILEAGE, 0.0);
		}

		SetPlayerData(playerid, P_OWNABLE_CAR, vehicleid);

		format
		(
			query, sizeof query,
			"INSERT INTO ownable_cars \
			(owner_id,model_id,color_1,color_2,pos_x,pos_y,pos_z,angle,create_time) \
			VALUES \
			('%d','%d','%d','%d','%f','%f','%f','%f','%d')",
			GetPlayerAccountID(playerid),
			modelid,
			color_1,
			color_2,
			pos_x,
			pos_y,
			pos_z,
			angle,
			gettime()
		);
		result = mysql_query(mysql, query, true);

		SetOwnableCarData(idx, OC_SQL_ID, cache_insert_id());

		cache_delete(result);

		SendClientMessage(playerid, 0x66CC00FF, "{FFFFFF}л загрузки транспорта восползуйтес{FF5252} еню - ранспорт.");
	    SendClientMessage(playerid, 0x66CC00FF, "{FFFFFF}ли восползуйтес{FF5252} парковкой.");
		UnloadPlayerOwnableCar(playerid);

		return 1;
}

stock GetPromoPriz(playerid, code[])
{
    new query[144], Cache:result;

    mysql_format(mysql, query, sizeof query, "SELECT * FROM promocode WHERE code = '%s'", code);

    result = mysql_query(mysql, query, true);

    new rows = cache_num_rows(result);

    if (rows > 0)
    {
        new amount[32], paydays[32];
        new amountValue;
        new paydaysValue;

        amountValue = cache_get_field_content_int(0, "amount");
        paydaysValue = cache_get_field_content_int(0, "paydays");

        new fmt_e[210];
format(fmt_e, sizeof fmt_e, "{FF5252}%s\n \n {FFFFFF} получили наград:\n{FF5252}1. {FFFFFF}грова валюта {FF5252}%d\n \n{FFFFFF}абрат приз после отгрша-/promo-абрат приз!\n \nритной гр на {FF5252}", code, amountValue, paydaysValue);

cache_delete(result);

        return fmt_e;
    }

}

stock ShowPlayerATM(playerid)
{
