public OnGameModeInit()
{
	printf("начало OnGameModeInit");

	LoadWhitelist();
	
	SetTimer("CorrectTimerMinute", 60000, true);
	ContForNewCreate();
	LoadTextDraw();
	CreateTextDraws();
	LoadCarKeyTextDraw();
	LoadNEWSettings();

	if(!LoadMySQLSettings())
	{
		print("е удалос загрузит MySQL настройки из sile_mysql_settings.ini");
		return 0;
	}

	mysql_log();
	mysql = mysql_connect(MySQLSettings[SILE_HOST], MySQLSettings[SILE_USERNAME], MySQLSettings[SILE_DATABASE], MySQLSettings[SILE_PASSWORD]);

	if(mysql <= 0 || mysql_errno(mysql) != 0)
	{
		printf("MySQL connect failed. handle=%d, errno=%d", mysql, mysql_errno(mysql));
		return print("е удалос подключитс к базе даннх!");
	}

	mysql_set_charset("cp1251");
	mysql_tquery(mysql, "SET NAMES cp1251");

	Cases_Init();
	BPR_Init(mysql);
	Marketplace_Init(mysql);
	
	// CheckModeStatus();

	
	SetTimer("UpdateVehicleTurnSignals", 500, true);

    for(new i = 0; i < MAX_VEHICLES; i++)
    {
        TurnSignalDriver[i] = INVALID_PLAYER_ID;
        TurnSignalModel[i] = 0;
    }
    

	restart_timer = -1;
    restart_countdown = 0;
    restart_active = false;

	g_ownable_car_loaded = 0;

	printf("porno sex 2");
   	//SetTimer("CheckNearbyTrunk", 5000, true);
	printf("porno sex 1");

    pickupotd = CreatePickup(1239,23,499.268341,1509.874511,1501.000000,1);

    SetTimer("AutoRestart", 60000, 1);

	FamilyAreaID = CreateDynamicCircle(-886.708679, -1572.843261, 2.0);
	CreateDynamicPickup(1314, 23, -886.708679, -1572.843261, 1398.501098, -1, -1, -1, 50.0);
	CreateDynamic3DTextLabel(
