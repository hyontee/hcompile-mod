                            return SendClientMessage(playerid, -1, "екст дл данного сообщени не установлен, дл того чтоб задат текст перейдите в раздел {FFBF00}'едактироват'");

                        sendQuickMessage(playerid, quick_mes[playerid][listitem][line]);
                        callcmd::binder(playerid);
                    }
                    case 21:
                    {
                        for( new j; j < 5; j++)
                            sendQuickMessage(playerid, quick_mes[playerid][j][line]);
                    }
                    case 22: editMessage(playerid);
                }
                return 1;
            }
            case DIALOG_EDIT_QM:
            {
