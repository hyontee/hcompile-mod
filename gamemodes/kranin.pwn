			}
			if(g_ownable_car[idx][OC_OBCLEARANCE] != -1)
			{
                    new suspension = max(g_ownable_car[idx][OC_OBCLEARANCE] / 50.0, 0.2);
					SetVehicleSuspensionForce(vehicleid, suspension, 0);
			}
			foreach(new playerid : Player)
            {
				SetVehicleColorHexForPlayers(playerid, vehicleid, GetOwnableCarData(idx, OC_COLOR_BODY), GetOwnableCarData(idx, OC_COLOR_WHEEL));
			}
		}
	}
	g_ownable_car_loaded = rows;
	cache_delete(result);

	printf("[OwnableCars]: ичнх авто загружено: %d", g_ownable_car_loaded);
}

public: LoadOwnableCar(oc_id)
{
    if(g_ownable_car_loaded + 1 > MAX_OWNABLE_CARS)
    {
        printf("[OwnableCars] шибка: ревшен лимит личного транспорта (%d) при загрузке ID %d.", MAX_OWNABLE_CARS, oc_id);
        return -1;
    }

    new query[128];
    mysql_format(mysql, query, sizeof query, "SELECT * FROM ownable_cars WHERE id='%d' LIMIT 1", oc_id);
    new Cache:result = mysql_query(mysql, query, true);

    if(cache_num_rows() != 1)
    {
        printf("[OwnableCars] шибка: апис с id %d не найдена или запрос вернул %d строк.", oc_id, cache_num_rows());
        cache_delete(result);
        return -1;
    }

    new idx = GetFreeOwnableCarID();
    if(idx == -1)
    {
        printf("[OwnableCars] шибка: е удалос найти свободнй слот дл загрузки машин ID %d.", oc_id);
        cache_delete(result);
        return -1;
    }

    new tmp_owner_id, tmp_model_id, tmp_color_1, tmp_color_2, tmp_alarm, tmp_key_in, tmp_create, tmp_vinilcar,
    tmp_pt_engine, tmp_pt_brake, tmp_pt_stability, tmp_number_type, tmp_sql_id, tmp_firmware;
    new Float:tmp_pos_x, Float:tmp_pos_y, Float:tmp_pos_z, Float:tmp_angle, Float:tmp_l_x, Float:tmp_l_y, Float:tmp_l_z, Float:tmp_l_a;
    new tmp_number[8], tmp_region[8], tmp_owner_name[21], tmp_vinyl_name[64], tmp_strob, tmp_highlight, 
	tmp_horn_id, tmp_exhaust, tmp_vinyl_current, tmp_diski_id, tmp_gidra,
	tmp_obclearance, tmp_razclearance, tmp_body_color, tmp_wheel_color, tmp_toner_rr, tmp_toner_ft, tmp_lights_color,
	tmp_und_light, tmp_und_lights_lt, tmp_und_lights_rt, tmp_enable_neon, tmp_departure_ft, tmp_departure_rr,
	tmp_collapse_ft, tmp_collapse_rr, tmp_width_ft, tmp_width_rr, tmp_wheel_radius, tmp_pnevmo, tmp_enable_pnevmo,
	tmp_nitro, tmp_enable_hand,  tmp_sport, tmp_sportplus, 
	tmp_sport1, tmp_sportplus1, tmp_sport2, tmp_sportplus2, 
	tmp_sport3, tmp_sportplus3, tmp_sport4, tmp_sportplus4,
    tmp_comfort, tmp_comfort1, tmp_comfort2, tmp_comfort3, tmp_comfort4,
    tmp_drift, tmp_drift1, tmp_drift2, tmp_drift3, tmp_drift4, tmp_launch;

    tmp_sql_id = cache_get_field_content_int(0, "id");
    tmp_owner_id = cache_get_field_content_int(0, "owner_id");
    tmp_model_id = cache_get_field_content_int(0, "model_id");
    tmp_color_1 = cache_get_field_content_int(0, "color_1");
    tmp_color_2 = cache_get_field_content_int(0, "color_2");

    tmp_pos_x = cache_get_field_content_float(0, "pos_x");
    tmp_pos_y = cache_get_field_content_float(0, "pos_y");
    tmp_pos_z = cache_get_field_content_float(0, "pos_z");
    tmp_angle = cache_get_field_content_float(0, "angle");
	tmp_l_x = cache_get_field_content_float(idx, "pos_x_last");
	tmp_l_y = cache_get_field_content_float(idx, "pos_y_last");
	tmp_l_z = cache_get_field_content_float(idx, "pos_z_last");
	tmp_l_a = cache_get_field_content_float(idx, "angle_last");

    cache_get_field_content(0, "number", tmp_number, mysql, 32);
    cache_get_field_content(0, "region", tmp_region, mysql, 8);
    tmp_number_type = cache_get_field_content_int(0, "number_type");

    tmp_alarm = bool:cache_get_field_content_int(0, "alarm");
    tmp_key_in = bool:cache_get_field_content_int(0, "key_in");
    tmp_create = cache_get_field_content_int(0, "create_time");
    tmp_vinilcar = cache_get_field_content_int(0, "vinilcar");

    tmp_pt_engine = cache_get_field_content_int(0, "pt_engine");
    tmp_pt_brake = cache_get_field_content_int(0, "pt_brake");
    tmp_pt_stability = cache_get_field_content_int(0, "pt_stability");
    tmp_firmware = cache_get_field_content_int(0, "firmware");
	cache_get_field_content(0, "vinyl_name", tmp_vinyl_name, mysql, 64);
	tmp_strob = cache_get_field_content_int(0, "strob");
	tmp_highlight = cache_get_field_content_int(0, "highlight");
	tmp_horn_id = cache_get_field_content_int(0, "horn_id");
	tmp_exhaust = cache_get_field_content_int(0, "exhaust");
	tmp_vinyl_current = cache_get_field_content_int(0, "vinyl_current");
	tmp_diski_id = cache_get_field_content_int(0, "disk_id");
	tmp_gidra = cache_get_field_content_int(0, "gidra");
	tmp_obclearance = cache_get_field_content_int(0, "obclearance");
	tmp_razclearance = cache_get_field_content_int(0, "razclearance");
	tmp_departure_ft = cache_get_field_content_int(0, "departure_ft");
	tmp_departure_rr = cache_get_field_content_int(0, "departure_rr");
	tmp_collapse_ft = cache_get_field_content_int(0, "collapse_ft");
	tmp_collapse_rr = cache_get_field_content_int(0, "collapse_rr");
	tmp_width_ft = cache_get_field_content_int(0, "width_ft");
	tmp_width_rr = cache_get_field_content_int(0, "width_rr");
	tmp_wheel_radius = cache_get_field_content_int(0, "wheel_radius");
	tmp_body_color = cache_get_field_content_int(0, "body_color");
