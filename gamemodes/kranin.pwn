					{
						g_player[playerid][P_RELOADINGS_COUNT][10] = 0;

						AddPlayerData(playerid, P_SKILL_MICRO_UZI, +, 1);
						UpdatePlayerDatabaseInt(playerid, "skill_micro_uzi", GetPlayerData(playerid, P_SKILL_MICRO_UZI));

						SetPlayerSkillLevel(playerid, 6, GetPlayerData(playerid, P_SKILL_MICRO_UZI) * 10);
					}
				}
			}
		}
	}
	return 1;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
	return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
    if(oldstate == PLAYER_STATE_DRIVER && newstate != PLAYER_STATE_DRIVER)
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        if(vehicleid >= 1 && vehicleid < MAX_VEHICLES && TurnSignalDriver[vehicleid] == playerid)
        {
            TurnSignalDriver[vehicleid] = INVALID_PLAYER_ID;
        }
    }
    return 1;
}


stock SyncVehicleTuningForPlayer(playerid, vehicleid)
{
	new index = GetVehicleData(vehicleid, V_ACTION_ID);
	printf("[TUNING_DEBUG2] SyncVehicleTuningForPlayer called: vehicleid=%d playerid=%d index=%d action_type=%d", vehicleid, playerid, index, GetVehicleData(vehicleid, V_ACTION_TYPE));
	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
		printf("[TUNING_DEBUG2] OWNABLE branch: COLOR_BODY=%d COLOR_WHEEL=%d VINYL='%s' DISKI=%d STROB=%d ENABLE_STROB=%d", g_ownable_car[index][OC_COLOR_BODY], g_ownable_car[index][OC_COLOR_WHEEL], g_ownable_car[index][OC_VINYL_NAME], g_ownable_car[index][OC_DISKI_ID], g_ownable_car[index][OC_STROB], g_ownable_car[index][OC_ENABLE_STROB]);
		if(g_ownable_car[index][OC_UNDERLIGHTS] != -1 || g_ownable_car[index][OC_UNDERLIGHTS_LT] != -1 || g_ownable_car[index][OC_UNDERLIGHTS_RT] != -1)
		{
			if(g_ownable_car[index][OC_ENABLE_NEON] == 1)
			{
				SetVehicleNeonForPlayer(playerid, vehicleid,
					g_ownable_car[index][OC_UNDERLIGHTS],
					g_ownable_car[index][OC_UNDERLIGHTS_LT],
					g_ownable_car[index][OC_UNDERLIGHTS_RT]
				);
			}
		}
	}
    else if(vInfo[vehicleid][vNeon1] || vInfo[vehicleid][vNeon2] || vInfo[vehicleid][vNeon3])
    {
        SetVehicleNeonForPlayer(playerid, vehicleid,
            vInfo[vehicleid][vNeon1],
            vInfo[vehicleid][vNeon2],
            vInfo[vehicleid][vNeon3]
        );
    }
	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
		if(g_ownable_car[index][OC_COLLAPSE_FT] != -1 || g_ownable_car[index][OC_COLLAPSE_RR] != -1)
		{
			SetVehicleCollapseForPlayer(playerid, vehicleid, (g_ownable_car[index][OC_COLLAPSE_FT] / -200.0) , (g_ownable_car[index][OC_COLLAPSE_RR] / -200.0) );
		}
	}

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
		if(g_ownable_car[index][OC_ENABLE_HAND] != 0)
		{
			switch(g_ownable_car[index][OC_ENABLE_HAND])
			{
				case 0: SetVehicleStockFP(playerid, vehicleid);
				case 1: SetVehicleComfortFP(playerid, vehicleid);
				case 2: SetVehicleDriftFP(playerid, vehicleid);
				case 3: SetVehicleSportFP(playerid, vehicleid);
				case 4: SetVehicleSportPlusFP(playerid, vehicleid);
				default: SetVehicleStockFP(playerid, vehicleid);
			}
		}
	}
	

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
		if(g_ownable_car[index][OC_NITRO] != -1)
		{
			switch(g_ownable_car[index][OC_NITRO])
			{
				case 0: AddVehicleComponent(vehicleid, 1008);
				case 1: AddVehicleComponent(vehicleid, 1009);
				case 2: AddVehicleComponent(vehicleid, 1010);
			}
		}
	}

	
    if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_VINYL_NAME][0] != '\0')
        {
			SetVehicleVinylForPlayer(playerid, vehicleid, g_ownable_car[index][OC_VINYL_NAME]);
		}
	}

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
	{
		if(g_ownable_car[index][OC_DEPARTURE_FT] != -1 || g_ownable_car[index][OC_DEPARTURE_RR] != -1)
		{
			SetVehicleWheelDepartureFP(playerid, vehicleid, (g_ownable_car[index][OC_DEPARTURE_FT] / 400.0) + -0.125, (g_ownable_car[index][OC_DEPARTURE_RR] / 400.0) + -0.125);
		}
	}

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_LIGHTS_COLOR] != -1)
        {
			SetVehicleLightsColorForPlayers(playerid, vehicleid, g_ownable_car[index][OC_LIGHTS_COLOR]);
		}
	}
	else if(strlen(vInfo[vehicleid][viVinylTexture]) > 0)
    {
        SetVehicleVinylForPlayer(playerid, vehicleid, vInfo[vehicleid][viVinylTexture]);
    }
	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
		if(g_ownable_car[index][OC_COLOR_BODY] != 0 || g_ownable_car[index][OC_COLOR_WHEEL] != 0)
		{
			 SetVehicleColorHexForPlayers(playerid, vehicleid, g_ownable_car[index][OC_COLOR_BODY], g_ownable_car[index][OC_COLOR_WHEEL]);
			 printf("set vehicle color to sync");
		}
	}
	else if (vInfo[vehicleid][wheel_colors] != 0 || vInfo[vehicleid][body_colors] != 0)
        SetVehicleColorHexForPlayers(playerid, vehicleid, vInfo[vehicleid][body_colors], vInfo[vehicleid][wheel_colors]);

    if(vInfo[vehicleid][viTonerFront] || vInfo[vehicleid][viTonerRear])
    {
        SetVehicleTonerForPlayer(playerid, vehicleid,
            vInfo[vehicleid][viTonerFront],
            vInfo[vehicleid][viTonerRear]
        );
    }
	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
		if(g_ownable_car[index][OC_TONER_RR] != -1 || g_ownable_car[index][OC_TONER_FT] != -1)
		{
			SetVehicleTonerForPlayer(playerid, vehicleid, g_ownable_car[index][OC_TONER_FT], g_ownable_car[index][OC_TONER_RR]);
		}
	}
    if(vInfo[vehicleid][vSuspensionForce] != 0)
    {
        SetVehicleSuspensionForceForPlayer(playerid, vehicleid, vInfo[vehicleid][vSuspensionForce]);
    }

    if(vInfo[vehicleid][vCarMod] > 0)
    {
        SendCarMod(playerid, vInfo[vehicleid][vCarModParam], vehicleid, vInfo[vehicleid][vCarMod]);
    }

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_DISKI_ID] != -1)
        {
			SendCarMod(playerid, 0, vehicleid, g_ownable_car[index][OC_DISKI_ID]);
		}
	}

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_HIGHLIGHT] != 0 && g_ownable_car[index][OC_ENABLE_HIGHLIGHT])
        {
			SetVehicleHighLightForPlayer(playerid, vehicleid, g_ownable_car[index][OC_HIGHLIGHT]);
		}
	}

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_HORN_ID] != -1)
        {
			SetVehicleHornSoundForPlayer(playerid, vehicleid, g_ownable_car[index][OC_HORN_ID]);
		}
	} 
	if(g_ownable_car[index][OC_ENABLE_PNEVMO] != 0 && g_ownable_car[index][OC_PNEVMO] != 0)
	{
		switch(g_ownable_car[index][OC_ENABLE_PNEVMO])
		{
			case 1:
	        	SetVehicleSuspensionForceForPlayer(playerid, vehicleid, 0.55);
	        case 2:
	        	SetVehicleSuspensionForceForPlayer(playerid, vehicleid, 0.35);
	        case 3:
	        	SetVehicleSuspensionForceForPlayer(playerid, vehicleid, 0.2);
		}
	}

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
		if(g_ownable_car[index][OC_OBCLEARANCE] != -1 && g_ownable_car[index][OC_ENABLE_PNEVMO] == 0)
		{
			new suspension = max(g_ownable_car[index][OC_OBCLEARANCE] / 50.0, 0.2);
			SetVehicleSuspensionForceForPlayer(playerid, vehicleid, suspension);
			printf("car %d zone stream on tune %f to playerid %d", vehicleid, suspension, playerid);
		}
	}
	else if(vInfo[vehicleid][vSuspensionBias] != 0)
    {
        SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, vInfo[vehicleid][vSuspensionBias]);
    }

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
		if(g_ownable_car[index][OC_RAZCLEARANCE] != -1)
		{
			new suspension = min(max(g_ownable_car[index][OC_RAZCLEARANCE] / 100.0, 0.1), 0.9);
			SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, suspension);
			printf("car %d zone stream on tune %f to playerid %d", vehicleid, suspension, playerid);
		}
	}

    if(vInfo[vehicleid][vWheelSize] != 0)
    {
        SetVehicleWheelSizeForPlayer(playerid, vehicleid, vInfo[vehicleid][vWheelSize]);
    }

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
	{
		if(g_ownable_car[index][OC_WHEEL_RADIUS] != -1)
		{
			SetVehicleWheelRadiusFP(playerid, vehicleid, (g_ownable_car[index][OC_WHEEL_RADIUS]  / 250.0) + 0.7);
		}
	}

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
	{
		if(g_ownable_car[index][OC_WIDTH_FT] != -1 || g_ownable_car[index][OC_WIDTH_RR] != -1)
		{
			SetVehicleWheelAddForPlayer(playerid, vehicleid, (g_ownable_car[index][OC_WIDTH_FT] / 80.0) + 0.5 , (g_ownable_car[index][OC_WIDTH_RR] / 80.0) + 0.5);
		}
	}
	
	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_GIDRA] != -1 && g_ownable_car[index][OC_ENABLE_GIDRA])
        {
			SetVehicleHydraulicsForPlayer(playerid, vehicleid, g_ownable_car[index][OC_GIDRA]);
		}
	}
	else if(vInfo[vehicleid][viHydraulics] > 0)
    {
        SetVehicleHydraulicsForPlayer(playerid, vehicleid, vInfo[vehicleid][viHydraulics]);
    }

    if(vInfo[vehicleid][viLaunchControl] > 0)
    {
        SetVehicleLaunchControlFP(playerid, vehicleid, vInfo[vehicleid][viLaunchControl]);
    }

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_EXHAUST] != -1)
        {
			SetVehicleExhaustForPlayer(playerid, vehicleid, g_ownable_car[index][OC_EXHAUST]);
		}
	}

	if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_STROB] != -1 && g_ownable_car[index][OC_ENABLE_STROB])
        {
			SetVehicleStroboscopeForPlayer(playerid, vehicleid, g_ownable_car[index][OC_STROB]);
		}
	}
	else if(vInfo[vehicleid][viStrob] > 0)
    {
        SetVehicleStroboscopeForPlayer(playerid, vehicleid, vInfo[vehicleid][viStrob]);
    }

    if(vInfo[vehicleid][viSiren] > 0)
    {
        SetVehicleSirenForPlayer(playerid, vehicleid, vInfo[vehicleid][viSiren]);
    }

    if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_NUMBER_TYPE] != 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                g_ownable_car[index][OC_NUMBER_TYPE],
                g_ownable_car[index][OC_NUMBER],
                g_ownable_car[index][OC_REGION]
            );
        }
    }
    else if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
{
    if(index >= 0 && index < MAX_OWNABLE_CARS)
    {
        if(vehicle_family[index][V_F_NUMBER_TYPE] != 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                vehicle_family[index][V_F_NUMBER_TYPE],
                vehicle_family[index][V_F_NUMBER],
                vehicle_family[index][V_F_REGION]
            );
        }
    }
    else
    {
        printf("[ERROR] евалиднй индекс семейного  %d (max: %d)", index, MAX_OWNABLE_CARS);
    }
}
    else
    {
        if(vNumber[vehicleid][npType] > 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                vNumber[vehicleid][npType],
                vNumber[vehicleid][npNumber],
                vNumber[vehicleid][npRegion]
            );
        }
    }
}
public OnVehicleStreamIn(vehicleid, forplayerid)
{
	SetTimerEx("DelayedSyncVehicleTuning", 400, false, "dd", vehicleid, forplayerid);
    Iter_Add(streamed_players_in_veh[vehicleid], forplayerid);
	Iter_Add(vehicle_in_stream[forplayerid], vehicleid);

	sc_OnVehicleStreamIn(vehicleid, forplayerid);
	return 1;
}

forward DelayedSyncVehicleTuning(vehicleid, forplayerid);
public DelayedSyncVehicleTuning(vehicleid, forplayerid)
{
	printf("[TUNING_DEBUG2] Timer fired for vehicleid=%d forplayerid=%d | IsValidVehicle=%d IsPlayerConnected=%d", vehicleid, forplayerid, IsValidVehicle(vehicleid), IsPlayerConnected(forplayerid));
	if(!IsValidVehicle(vehicleid)) return 0;
	if(!IsPlayerConnected(forplayerid)) return 0;
	SyncVehicleTuningForPlayer(forplayerid, vehicleid);
	return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
	sc_OnVehicleStreamIn(vehicleid, forplayerid);

	Iter_Remove(streamed_players_in_veh[vehicleid], forplayerid);
	Iter_Remove(vehicle_in_stream[forplayerid], vehicleid);
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if(dialogid == DIALOG_ADM_STDI)
	{
		if(response)
		{
			AdminAuthorization(playerid);
			SetPlayerData(playerid, P_ADM_STDI, 1);
			UpdatePlayerDatabaseInt(playerid, "adm_st", 1);
		}
		else
		{
			AdminAuthorization(playerid);
			SetPlayerData(playerid, P_ADM_STDI, 1);
			UpdatePlayerDatabaseInt(playerid, "adm_st", 1);
		} 
	} 
	if(dialogid == DIALOG_TRADE_SELECT)
    {
        if(!response) return 1;
        
        new Float:posX, Float:posY, Float:posZ;
        GetPlayerPos(playerid, posX, posY, posZ);
        
        new to_player = -1;
        new count = 0;
        
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i)) continue;
            if(i == playerid) continue;
            if(IsPlayerInTrade(i)) continue;
            
            new Float:distance = GetPlayerDistanceFromPoint(i, posX, posY, posZ);
            if(distance > 20.0) continue;
            
            if(count == listitem)
            {
                to_player = i;
                break;
            }
            count++;
        }
        
        if(to_player == -1)
        {
            ShowNotificationSile(playerid, 2, 5, -1, -1, "грок не найден.", "");
            return 1;
        }
        
        if(IsPlayerInTrade(playerid))
        {
            ShowNotificationSile(playerid, 2, 5, -1, -1, "рейд уже запущен.", "");
            return 1;
        }
        
        if(IsPlayerInTrade(to_player))
        {
            ShowNotificationSile(playerid, 2, 5, -1, -1, "грок уже в трейде.", "");
            return 1;
        }
        
        // охранем ID вбранного игрока в PVar
        SetPVarInt(playerid, "Trade_Target", to_player);
        
        // оказваем диалог согласи второму игроку
        new string[256];
        new name[32];
        GetPlayerName(playerid, name, sizeof(name));
        
		format(string, sizeof(string), "грок %s предлагает вам обмен.", name);
        ShowNotificationSile(to_player, 5, 7, OFFER_TRADE, OFFER_TRADE_NO, string, "огласитс");
        
      /*  ShowPlayerDialog(
            to_player, 
            DIALOG_TRADE_ACCEPT, 
            DIALOG_STYLE_MSGBOX, 
            "редложение об обмене", 
            string, 
            "огласитс", 
            "тказатс"
        );*/
        
        ShowNotificationSile(playerid, 2, 4, 0, 0, "апрос на трейд отправлен. жидайте ответа.", "");
        
        return 1;
    }
    
    // ====================================================================
    //  Я  
    // ====================================================================
    if(dialogid == DIALOG_TRADE_ACCEPT)
    {
        new senderid = GetPVarInt(playerid, "Trade_Target");
        
        if(!IsPlayerConnected(senderid))
        {
            SendClientMessage(playerid, -1, "грок, предложивший трейд, отключилс.");
            DeletePVar(playerid, "Trade_Target");
            return 1;
        }
        
        if(!response) // тказ
        {
            new msg[128];
            format(msg, sizeof(msg), "грок %s отказалс от трейда.", GetPlayerNameEx(playerid));
            SendClientMessage(senderid, -1, msg);
            
            DeletePVar(playerid, "Trade_Target");
            return 1;
        }
        
        // огласие
        if(IsPlayerInTrade(playerid))
        {
            SendClientMessage(playerid, -1, " уже в трейде.");
            DeletePVar(playerid, "Trade_Target");
            return 1;
        }
        
        if(IsPlayerInTrade(senderid))
        {
            SendClientMessage(playerid, -1, "грок уже в трейде.");
            DeletePVar(playerid, "Trade_Target");
            return 1;
        }
        
        // оздаем трейд
        new tradeId = -1;
        for(new i = 0; i < MAX_PLAYER_TRADES; i++)
        {
            if(!g_TradeData[i][trade_active])
            {
                tradeId = i;
                break;
            }
        }
        
        if(tradeId == -1)
        {
            SendClientMessage(playerid, -1, "ервер перегружен. опробуйте позже.");
            DeletePVar(playerid, "Trade_Target");
            return 1;
        }
        
        g_TradeData[tradeId][trade_player1] = senderid;
        g_TradeData[tradeId][trade_player2] = playerid;
        g_TradeData[tradeId][trade_status1] = 1;
        g_TradeData[tradeId][trade_status2] = 1; // разу принл
        g_TradeData[tradeId][trade_money1] = 0;
        g_TradeData[tradeId][trade_money2] = 0;
        g_TradeData[tradeId][trade_time] = gettime();
        g_TradeData[tradeId][trade_active] = true;
        g_TradeData[tradeId][trade_both_ready] = false;
        
        g_PlayerTradeID[senderid] = tradeId;
        g_PlayerTradeID[playerid] = tradeId;
        
        ResetPlayerTradeItems(senderid);
        ResetPlayerTradeItems(playerid);
        g_PlayerTradeMoney[senderid] = 0;
        g_PlayerTradeMoney[playerid] = 0;
        
        // ткрваем GUI трейда обоим
        ShowPlayerTradeGUI(senderid, playerid);
        ShowPlayerTradeGUI(playerid, senderid);
        
        new msg[128];
        format(msg, sizeof(msg), "грок %s согласилс на трейд.", GetPlayerNameEx(playerid));
        SendClientMessage(senderid, -1, msg);
        SendClientMessage(playerid, -1, " согласилис на трейд.");
        
        DeletePVar(playerid, "Trade_Target");
        
        return 1;
    }
	if(dialogid == DIALOG_RESTART)
    {
        if(!response) return 1;

        new minutes = 0;

        switch(listitem)
        {
            case 0:
            {
                minutes = 0;
                StartRestartImmediately(playerid);
                return 1;
            }
            case 1:
            {
                minutes = 1;
                StartRestartTimer(playerid, minutes);
            }
            case 2:
            {
                minutes = 5;
                StartRestartTimer(playerid, minutes);
            }
            case 3:
            {
                minutes = 10;
                StartRestartTimer(playerid, minutes);
            }
            case 4:
            {
                ShowPlayerDialog(playerid, DIALOG_RESTART_CUSTOM, DIALOG_STYLE_INPUT,
                                "ведите врем до рестарта",
                                "ведите количество минут до рестарта (от 1 до 60):",
                                "апустит", "азад");
                return 1;
            }
        }
        return 1;
    }
     if(dialogid == DIALOG_RESTART_CUSTOM)
    {
        if(!response)
        {
            ShowRestartDialog(playerid);
            return 1;
        }

        new minutes = strval(inputtext);
        if(minutes < 1 || minutes > 60)
        {
            ShowNotificationSile(playerid, 2, 7, -1, -1, "рем должно бт от 1 до 60 минут.", "");
            ShowPlayerDialog(playerid, DIALOG_RESTART_CUSTOM, DIALOG_STYLE_INPUT,
                            "ведите врем до рестарта",
                            "ведите количество минут до рестарта (от 1 до 60):",
                            "апустит", "азад");
            return 1;
        }

        StartRestartTimer(playerid, minutes);
    }
	new f = GetPlayerIdFamily(playerid);
	if(dialogid == DIALOG_SMENA_NAZVANIA_FAM)
    {
        if(response)
        {
            new fam_name[32];

            if(sscanf(inputtext, "s[32]", fam_name) || strlen(inputtext) < 3)
            {
           		new Node:response = JSON_Object();
                        JSON_SetInt(response, "t", 0);
                        JSON_SetInt(response, "y", 0);
                        JSON_SetInt(response , "k", 1);
                        JSON_SetString(response, "n", "азвание семи должно состот от 3 до 32 символов");
                        SendPacketToClient(playerid, 22, response);
                        return 1;
            }

            for(new i; i < strlen(fam_name); i++) if(fam_name[i] == '-' && fam_name[i+7] == '}') fam_name[i] = '{';

            format(family[f][family_name], 32, fam_name);
            mysql_format(mysql, f_string144, sizeof f_string144, "UPDATE family SET name='%s' WHERE id = %d", GetFamily(f, family_name), GetFamily(f, family_database));
            mysql_query(mysql, f_string144, false);

            GivePlayerDonateRub(playerid, -100);

            FSendClientMessage(f_string144, playerid, -1, ""c_f_g" изменили название вашей семи на %s.", GetFamily(f, family_name));
            new fmtfam[512];
            format(fmtfam, sizeof(fmtfam), "овое название вашей семи %s", GetFamily(f, family_name));
            new Node:JSONObject = JSON_Object();

			JSON_SetInt(JSONObject, "t", 0);
        	JSON_SetInt(JSONObject, "y", 1);

			JSON_SetString(JSONObject, "m", " успешно изменили им семи.");
    		JSON_SetString(JSONObject, "n", fmtfam);

        	JSON_SetInt(JSONObject, "r", GetPlayerMoney(playerid));
    		JSON_SetInt(JSONObject, "s", GetPlayerDonateRub(playerid) - 50);
         	SendPacketToClient(playerid, 22, JSONObject);

            foreach(new i : Player)
            {
                if(GetPlayerIdFamily(i) != f) continue;

                UpdateDynamic3DTextLabelText(GetPlayerFamily(f, TEXT_FAMILY), -1, fam_name);
            }

            format(f_string144, sizeof f_string144, "идер семи %s[%d] изменил название семи на %s.", GetPlayerNameEx(playerid), playerid, fam_name);
            SendFamilyMessage(f, f_string144);
        }
    }
    if(dialogid == DIALOG_PEREDACHA_FAM)
{
    if(response)
    {
        if(GetPlayerDonateRub(playerid) >= 100)
        {
            new to_player = strval(inputtext);

            if(!IsPlayerConnected(to_player) || to_player == playerid)
            {
                new Node:response = JSON_Object();
                JSON_SetInt(response, "t", 0);
                JSON_SetInt(response, "y", 0);
                JSON_SetInt(response, "k", 1);
                JSON_SetString(response, "n", "аннй игрок не в сети.");
                SendPacketToClient(playerid, 22, response);
                JSON_Cleanup(response);
                return 1;
            }

            if(GetPlayerIdFamily(to_player) != -1)
            {
                new Node:response = JSON_Object();
                JSON_SetInt(response, "t", 0);
                JSON_SetInt(response, "y", 0);
                JSON_SetInt(response, "k", 1);
                JSON_SetString(response, "n", "грок уже состоит в семе.");
                SendPacketToClient(playerid, 22, response);
                JSON_Cleanup(response);
                return 1;
            }

            if(!IsPlayerInRangeOfPlayer(playerid, to_player, 5.0))
            {
                new Node:response = JSON_Object();
                JSON_SetInt(response, "t", 0);
                JSON_SetInt(response, "y", 0);
                JSON_SetInt(response, "k", 1);
                JSON_SetString(response, "n", "грок слишком далеко");
                SendPacketToClient(playerid, 22, response);
                JSON_Cleanup(response);
                return 1;
            }

            new f = GetPlayerIdFamily(playerid);
            if(f == -1)
            {
                new Node:response = JSON_Object();
                JSON_SetInt(response, "t", 0);
                JSON_SetInt(response, "y", 0);
                JSON_SetInt(response, "k", 1);
                JSON_SetString(response, "n", " не состоите в семе.");
                SendPacketToClient(playerid, 22, response);
                JSON_Cleanup(response);
                return 1;
            }

            if(GetPlayerRangFamily(playerid) != 5)
            {
                new Node:response = JSON_Object();
                JSON_SetInt(response, "t", 0);
                JSON_SetInt(response, "y", 0);
                JSON_SetInt(response, "k", 1);
                JSON_SetString(response, "n", " не лидер семи.");
                SendPacketToClient(playerid, 22, response);
                JSON_Cleanup(response);
                return 1;
            }

           if(playerid == to_player)
            {
                new Node:response = JSON_Object();
                JSON_SetInt(response, "t", 0);
                JSON_SetInt(response, "y", 0);
                JSON_SetInt(response, "k", 1);
                JSON_SetString(response, "n", " не можете передат семю самому себе.");
                SendPacketToClient(playerid, 22, response);
                JSON_Cleanup(response);
                return 1;
            }

            GivePlayerDonateRub(playerid, -100);

            new family_sql = GetFamily(f, family_database);

            SetPlayerFamily(to_player, ID_FAMILY, f);
            SetPlayerFamily(to_player, ID_SQL_FAMILY, family_sql);
            SetPlayerFamily(to_player, RANG_FAMILY, 5);

            UpdatePlayerDatabaseInt(to_player, "family_id", family_sql);
            UpdatePlayerDatabaseInt(to_player, "family_rang", 5);

            SetPlayerFamily(playerid, RANG_FAMILY, 1);
            UpdatePlayerDatabaseInt(playerid, "family_rang", 1);

            UpdateColumnFamilyInt(family_sql, "owner", GetPlayerAccountID(to_player));
            SetFamily(f, family_owner, GetPlayerAccountID(to_player));

            LoadPlayerFamily(playerid);
            LoadPlayerFamily(to_player);

            format(f_string144, sizeof f_string144, "%s передал полномочи лидера семи %s",
                GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));
            SendFamilyMessage(f, f_string144);
            SendFamilyLog(type_log_rang, playerid, to_player, f_string144);

            new toname[64];
            GetPlayerName(to_player, toname, sizeof(toname));
            new fmtfam[512];
            format(fmtfam, sizeof(fmtfam), "овй лидер семи: %s", toname);
            new Node:JSONObject = JSON_Object();

			JSON_SetInt(JSONObject, "t", 0);
        	JSON_SetInt(JSONObject, "y", 1);

			JSON_SetString(JSONObject, "m", " успешно передали семю.");
    		JSON_SetString(JSONObject, "n", fmtfam);

        	JSON_SetInt(JSONObject, "r", GetPlayerMoney(playerid));
    		JSON_SetInt(JSONObject, "s", GetPlayerDonateRub(playerid) - 50);
         	SendPacketToClient(playerid, 22, JSONObject);

            ShowNotificationSile(to_player, 2, 5, -1, -1, " стали лидером семи!", "");
        }
        else
        {
            new Node:response = JSON_Object();
            JSON_SetInt(response, "t", 0);
