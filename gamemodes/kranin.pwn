											SendClientMessage(playerid, 0x999999FF, "оход от этого будут перечислтс на баланс предприти");

											BusinessHealthPickupInit(businessid);
										}
										case 3:
										{
											SendClientMessage(playerid, 0x66CC00FF, "лагодар пониженному налогу, в будете платит за аренду помещени в 2 раза менше");
											SendClientMessage(playerid, 0x999999FF, "лагодар этому, в сможете получат болшую прибл");
										}
