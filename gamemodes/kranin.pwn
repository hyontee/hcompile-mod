CMD:vleave(playerid, params[])
{
	if(GetPlayerData(playerid, P_IMPROVEMENTS) < 2) return SendClientMessage(playerid, 0x999999FF, "риобретите улучшение \"ешителност\", чтоб уволитс по собственному желанию");

	if(!GetPlayerTeamEx(playerid)) return ShowNotificationSile(playerid, 2, 6, 0, 0, " не состоите в организации", "");

	new fmt_text[999];

	format
	(
		fmt_text, sizeof fmt_text,
		""SC"аша организаци{FF5252}: \"%s\".\n\n"\
		"{ffffff} действително хотите покинут данную организацию по\n"\
		"{ffffff}собственному желанию?",
		GetTeamName(GetPlayerTeamEx(playerid))
	);

	Dialog(playerid, DIALOG_TEAM_LEAVE, DIALOG_STYLE_MSGBOX, "одтверждение", fmt_text, "алее", "тмена");

	return 1;
}


CMD:setpremium(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new to_player, premium; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /setpremium [id игрока] [врем (в днх)]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(0 <= premium <= 30)) return SendClientMessage(playerid, 0xCECECEFF, "оличество дней от 0 до 30");

	new fmt_msg[100];

	SetPlayerData(to_player, P_PREMIUM_DATE, gettime() + premium * 86400);

	UpdatePlayerDatabaseInt(to_player, "premium", GetPlayerData(to_player, P_PREMIUM));

	format(fmt_msg, sizeof fmt_msg, "%s вдал ам подписку %s+ на %d дн.", GetPlayerNameEx(playerid), NameServer[SILE_NAME], premium);
	SendClientMessage(to_player, 0x1E90FFFF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, " вдали %s подписку %s+ на %d дн.", GetPlayerNameEx(to_player), NameServer[SILE_NAME], premium);
	SendClientMessage(playerid, 0x1E90FFFF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "становил %s[acc:%d] подписку %s+ на %d дн.", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), NameServer[SILE_NAME], premium);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:togphone(playerid, params[])
{
	if(!GetPlayerPhone(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, " ас нет телефона. го можно купит в сотовом салоне");
	if(!GetPlayerPremium(playerid))
	    return   SendClientMessage(playerid, 0xCECECEFF, " ас нет VIP аккаунта.");

	if(GetPlayerPhoneCall(playerid, PC_INCOMING_PLAYER) != INVALID_PLAYER_ID || GetPlayerPhoneCall(playerid, PC_OUTCOMING_PLAYER) != INVALID_PLAYER_ID)
		return SendClientMessage(playerid, 0xCECECEFF, "акончите текущий разговор");

	if(GetPlayerPhoneCall(playerid, PC_ENABLED))
	{
		SetPlayerPhoneCall(playerid, PC_ENABLED, false);
		SendClientMessage(playerid, 0xCECECEFF, "елефон отключен");
	}
	else
	{
		SetPlayerPhoneCall(playerid, PC_ENABLED, true);
		SendClientMessage(playerid, 0x32a44bFF, "елефон включен");
	}
	return 1;
}
new vCooldown[MAX_PLAYERS];

CMD:v(playerid, params[])
{
    new currentTime = gettime();

    if(vCooldown[playerid] > currentTime)
    {
        new remaining = vCooldown[playerid] - currentTime;
        new msg[64];
        format(msg, sizeof(msg), "одождите %d секунд перед следующим сообщением.", remaining);
        ShowNotificationSile(playerid, 2, 6, 0, 0, msg, " ");
        return 1;
    }

    vCooldown[playerid] = currentTime + 5;

    if(GetPlayerPremium(playerid) < 1)
    {
        ShowNotificationSile(playerid, 2, 6, 0, 0, " ас нет VIP аккаунта", " ");
        return 1;
    }

    if(IsPlayerMuted(playerid) > 0)
    {
        ShowNotificationSile(playerid, 2, 6, 0, 0, "оступ в чат заблокирован. рем до разблокировки: /time", " ");
        return 1;
    }

    if(!strlen(params))
    {
        ShowNotificationSile(playerid, 2, 6, 0, 0, "сползуйте: /v [текст]", " ");
        return 1;
    }

    new fmt_msg[160];
    new prefix[32];
    new name[MAX_PLAYER_NAME];

    GetPlayerName(playerid, name, sizeof(name));

    switch(GetPlayerPremium(playerid))
    {
        case 1: format(prefix, sizeof(prefix), "[Silver VIP]");
        case 2: format(prefix, sizeof(prefix), "[Gold VIP]");
        case 3: format(prefix, sizeof(prefix), "[Platinum VIP]");
        default: format(prefix, sizeof(prefix), "[VIP]");
    }

    format(fmt_msg, sizeof(fmt_msg), "%s %s[%d]: %s",
        prefix, name, playerid, params);

    foreach(new i : Player)
    {
        if(!IsPlayerLogged(i)) continue;
        if(!GetPlayerPremium(i)) continue;
        if(!GetPlayerData(i, P_PREMIUM_CHAT)) continue;

        SendClientMessage(i, 0xFF5252AA, fmt_msg);
    }
    return 1;
}
CMD:voff(playerid, params[])
{
	if(GetPlayerPremium(playerid) < 1) return SendClientMessage(playerid, 0xCECECEFF, " ас нет VIP аккаунта ");
	if(GetPlayerData(playerid, P_PREMIUM_CHAT))
	{
		SendClientMessage(playerid,-1," отключили VIP чат");
		SetPlayerData(playerid, P_PREMIUM_CHAT, 0);
		return 1;
	}
	if(!GetPlayerData(playerid, P_PREMIUM_CHAT))
	{
		SendClientMessage(playerid,-1," включили VIP чат");
		SetPlayerData(playerid, P_PREMIUM_CHAT, 1);
		return 1;
	}
	return 1;
}
stock SendMessageToYouTubers(message[], color, y_level = 1)
{
    if(y_level < 1)
        y_level = 1;

    new count;
    foreach(new playerid : Player)
    {
        if(!IsPlayerLogged(playerid)) continue;
        if(GetPlayerYouTubeEx(playerid) < y_level) continue;

        SendClientMessage(playerid, color, message);
        count ++;
    }
    return count;
}

