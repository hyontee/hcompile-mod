					"тарший администратор", "/", "уратор администрации", "ехнический специалист",
					"ам. главного администратора", "лавнй администратор", "оманда проекта",
					"аместител основател", "сновател"
				};

				if (GetPlayerAdminEx(playerid) >= 1)
