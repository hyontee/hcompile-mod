				SendClientMessage(napinko[playerid], 0xFF5252, "|  успешно сели в авто к напарнику. л принти заказов введите {FF5252}/blist");
				GivePlayerMoney(playerid, -5000);
				inko[playerid] = 2;
				inko[napinko[playerid]] = 2;
			}
			default: SendClientMessage(playerid, 0x808080, "едоступно");
		}
	}

