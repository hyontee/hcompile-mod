		GetPVarString ( playerid, pvar_string, pl_name, MAX_PLAYER_NAME - 4 ) ;
		if ( strval ( inputtext ) < 1 || strval ( inputtext ) > gFracionCountRank[ pInfo[playerid][pMember] - 1 ]) return ShowPlayerDialog(playerid, D_FRACTION_FUNC_11, DIALOG_STYLE_INPUT, ""colserver"Изменение ранга игрока", "{FFFFFF}Введите номер ранга, который хотите установить для игрока:", "Выбрать", "Назад");
		if ( strval ( inputtext ) >= pInfo[playerid][pRank]) {
