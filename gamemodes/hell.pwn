			format(t_string, sizeof t_string, ""colserver"Сообщения:\t\t\n"colwhi"- %s", fInfo[fraction_id][fMessage]);
			ShowPlayerDialog(playerid, D_FRACTION_FUNC_5, DIALOG_STYLE_MSGBOX, " ", t_string, "Удалить", "Назад");
			}
			else ShowPlayerDialog(playerid, D_FRACTION_FUNC_6, DIALOG_STYLE_INPUT, " ", ""colwhi"Это сообщение будут видеть сотруднки Вашей организации\nКаждый раз при входе в игру:", "Принять", "Отмена");
                    return true;
		}
	        case 2 .. 7:
	        {
	            SetPVarInt(playerid,"RankListItemID", listitem);
	            t_string[0] = EOS;
	            for(new i; i < gFracionCountRank[fraction_id - 1]; i++)
			{
			if (i+1 < fInfo[fraction_id][fHelper][listitem - 2]) format(t_string, sizeof t_string,"%s[%d] %s\n", t_string, i+1, fFractionRank[fraction_id][i]);
			else format(t_string, sizeof t_string,"%s[%d] "collime"%s"colwhi"\n", t_string, i+1, fFractionRank[fraction_id][i]);
			}
