		case CASINO_LANGUAGE_ENGLISH: SendClientMessage(playerid, COLOR_WHITE, !"Вы выбрали английский язык для интерфейса.");
		case CASINO_LANGUAGE_RUSSIAN: SendClientMessage(playerid, COLOR_WHITE, !"Вы выбрали русский язык для интерфейса.");
