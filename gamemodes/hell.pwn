		V_IDX = GetPVarInt(playerid, "selectCarIDlist"),
		fraction_id = pInfo[playerid][pMember]; 
		if (VehicleInfo[V_IDX][vModel] == 482) return SendClientMessage(playerid, COLOR_GREY, !"Запрещено продавать фуру для погрузки/разгрузки боеприпасов"); 
		if (FractionInfo[fraction_id][fPoints] < gang_car[select_car][1]) return SendClientMessage(playerid, COLOR_GREY, !"В Вашей банде недостаточно G-POINTS для аренды Т/С");
		VehicleInfo[V_IDX][vTempModel] = gang_car[select_car][0];
		VehicleInfo[V_IDX][vTimeModel] = gettime() + 7*86400;
		SaveFractionVehicleServer(V_IDX);
		FractionInfo[fraction_id][fPoints] -= gang_car[select_car][0];  
		SendClientMessage(playerid, COLOR_GREEN, !"Автомобиль успешно арендован на 7 дней");
		UpdateFractionCar(V_IDX, VehicleInfo[V_IDX][vID]);
		UpdateFractionStore(fraction_id);
