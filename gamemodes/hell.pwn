public OnPlayerLeaveDynamicArea(playerid, areaid)
{
	#if defined _duels_inc
	if (duels_OnPlayerLeaveDynamicArea(playerid, areaid)) return true;
	#endif
	#if defined _casino_included
	if (casino_OnPlayerLeaveDynamicArea(playerid, areaid)) return true;
	#endif
	//if (family_OnPlayerLeaveDynamicArea(playerid, areaid)) return true;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_SPECTATING )
	{
	    if (areaid >= gAreas[arGreenZone][0] && areaid <= gAreas[arGreenZone][37])
	    {
	        pTemp[playerid][InGreenZonePlayer] = false;
			for(new i; i < sizeof (gz_TD); i++) {
				TextDrawHideForPlayer(playerid, gz_TD[i]); 
			} 			
	    } 
	else if (areaid >= non_parking_area[0] && areaid <= non_parking_area[MAX_NONPARKING_ZONES - 1] && GetPVarInt ( playerid, "tp_area_used" ) == 0)
	{
		is_player_nonpark_zone { playerid } = 0 ;
		SetPVarInt ( playerid, "leavenp_td_status", 1);
		if ( GetPVarInt ( playerid, "np_td_status") == 1)
		{
		DeletePVar ( playerid, "np_td_status" ) ;
		for ( new j = 0 ; j < 6 ; j ++ )
		{
			TextDrawHideForPlayer ( playerid, np_td [ j ] );
		}
		}
		for ( new j = 0 ; j < 6 ; j ++ )
		{
		TextDrawShowForPlayer ( playerid, np_td [ j ] ) ;
		SetTimerEx ( "clear_leave_np_td", 3300, false, "d", playerid );
		}
		return 1 ;
	}
	}
	
	new area_id, area_type, area_extra_id;
	GetDynamicAreaTypeID(areaid, area_id, area_type, area_extra_id);
	if (area_id == areaid) {
	
	switch (area_type) {
		case AREA_TYPE_BOOMBOX: {
		StopAudioStreamForPlayer(playerid);
		}
		case AREA_TYPE_ACTOR_BIZ: {
		pTemp[playerid][tActorBusinessID] = 0;
		}
		case AREA_TYPE_CAPTURE: {
		if (pInfo[playerid][pAdmin]) HideTextDrawCapture(playerid, area_extra_id);
		}
		case AREA_TYPE_PRESSKEYTD: TextDrawHideForPlayer(playerid, PressKeyTD);
		
		case AREA_TYPE_ARMY_JOB:  
		{
			if (pTemp[playerid][tArmyDuty] != 0)  
			{
			SendClientMessage(playerid, COLOR_GREY, !"Вернитесь на территорию ЛСа!");
			SetPVarInt(playerid, "TimerCountWoods", MAX_COUNT_POLYGON_ZONE);
			}
		}
		
		case AREA_TYPE_FAMILY_HOUSE: {
		pTemp[playerid][tSelectFamilyHouseArea] = false; 
		HideMenuFamilyHouse(playerid);
		}
		case AREA_TYPE_ATM: {
		pTemp[playerid][tSelectAreaATM] = false;
		pTemp[playerid][tSelectATMID] = -1;
		//END ATM
		}
		case AREA_TYPE_STALL_MARKET: {
		if (pTemp[playerid][tRentStallID] != -1) {
			new	
			S_IDX = pTemp[playerid][tRentStallID];
			ClearMarketRent(playerid, S_IDX);
		}
		pTemp[playerid][tSelectAreaStall] = false;
		pTemp[playerid][tSelectStallID] = -1;
		}
		case AREA_TYPE_HOUSE: { 
		pTemp[playerid][tSelectHouseArea] = false;
		//pTemp[playerid][tSelectHouseID] = -1; 
		}
		case AREA_TYPE_ROB_HOUSE: {

		}
		case AREA_TYPE_FACTORY_SORT: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {  
			if (gFactorySortInfo[area_extra_id][sortPlaceToggle] != INVALID_PLAYER_ID) { 
			if(PlayerInConnected(gFactorySortInfo[area_extra_id][sortPlaceToggle])) {
				pTemp[playerid][tUseFactorySordID] = -1;  
			}
			gFactorySortInfo[area_extra_id][sortPlaceToggle] = INVALID_PLAYER_ID;
			//
			}  
		}
		}
		case AREA_TYPE_HOTDOG_SALLER: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {  
		}
		}
	}
	}
    /*if (areaid == DynamicRectangGhettoLobby)
        TextDrawHideForPlayer(playerid, PressKeyTD);
	if (areaid >= DynamicRectangLVa[0] && areaid <= DynamicRectangLVa[8] || areaid == DynamicRectangLSPD || areaid == DynamicRectangSFA || areaid == DynamicRectangFBI)
        TextDrawHideForPlayer(playerid, PressKeyTD);*/
    if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
	{
	if ( areaid == gAreas[arTruckerFreeArea][LOADING_SAWMILL_0] || areaid == gAreas[arTruckerFreeArea][LOADING_SAWMILL_1] || areaid == gAreas[arTruckerFreeArea][LOADING_COAL_0] || 
		gAreas[arTruckerFreeArea][LOADING_COAL_1] || gAreas[arTruckerFreeArea][LOADING_OIL_0] || gAreas[arTruckerFreeArea][LOADING_OIL_1])
	{
		if (pInfo[playerid][pJob] == JOB_TRUCKER && pTemp[playerid][tTruckerLeaveTime] > 0)
		{
		if (areaid == gAreas[arTruckerFreeArea][LOADING_SAWMILL_0]) TurnLoadingPlayerID[LOADING_SAWMILL_0] = INVALID_PLAYER_ID;
		else if (areaid == gAreas[arTruckerFreeArea][LOADING_SAWMILL_1]) TurnLoadingPlayerID[LOADING_SAWMILL_1] = INVALID_PLAYER_ID;
		else if (areaid == gAreas[arTruckerFreeArea][LOADING_COAL_0]) TurnLoadingPlayerID[LOADING_COAL_0] = INVALID_PLAYER_ID;
		else if (areaid == gAreas[arTruckerFreeArea][LOADING_COAL_1]) TurnLoadingPlayerID[LOADING_COAL_1] = INVALID_PLAYER_ID;
		else if (areaid == gAreas[arTruckerFreeArea][LOADING_OIL_0]) TurnLoadingPlayerID[LOADING_OIL_0] = INVALID_PLAYER_ID;
		else if (areaid == gAreas[arTruckerFreeArea][LOADING_OIL_1]) TurnLoadingPlayerID[LOADING_OIL_1] = INVALID_PLAYER_ID;

		SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Отправляйтесь в один из портов для разгрузки");
		pTemp[playerid][tTruckerLeaveTime] = -1;
		HideTruckerMainMenu(playerid, .main = false, .timer = true); 
		}
	} 

	return 1 ;
	}
	if (areaid >= TagInfo[1][tSphere] && areaid <= TagInfo[GRAFFITI_COUNT-1][tSphere])
	{
	    if (pTemp[playerid][PlayerSpray] == true)
	    {
		pTemp[playerid][PlayerSpray] = false;
	    DeletePVar(playerid,"ColorFire");
	}
	DeletePVar(playerid,"TagInfoID");
	}	
	
	return 1;
}
