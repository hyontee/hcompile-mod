				pInfo[playerid][pWantedLevel] ++;
				SetPlayerWantedLevelEx(playerid, pInfo[playerid][pWantedLevel]);

				SetPlayerCriminal(playerid,"Неизвестный", "Нелегальная рыбалка");
			}*/
			}
			else if (!Flood[playerid]) SendClientMessage(playerid, 0x81DA99AA, !"Вы ничего не поймали");
		}
		}
	    }
	} 
    //+c
	if(PRESSED(KEY_FIRE | KEY_CROUCH))
	{
	    switch(GetPlayerWeapon(playerid))
	    {
    	     case 24, 25, 27, 29, 30, 31, 33, 34: // Если у игрока: Дигл, Шотган, Винтовка, Снайперка
             {
                 //ShowPlayerDialog(playerid,0000,DIALOG_STYLE_MSGBOX,"[+C Detect]", "Использования +C бага запрещено\n\nВы можете купить эту элитную способность(+С) для его использования!", "Понял", "");
	             ClearAnimations(playerid);
                 ApplyAnimation(playerid,"PED","getup_front",4.0,0,0,1,0,0);//активируем игроку анимацию падения
	         }
	    }
	}
	//gruz//
	#if defined _poffer_inc
	if (newkeys & KEY_HANDBRAKE  && newkeys & KEY_SECONDARY_ATTACK )
	{
	if (IsAMafia(playerid))
	{
		new giveplayerid = GetPlayerTargetPlayer(playerid);
		if (giveplayerid != INVALID_PLAYER_ID && 
		GetPlayerState(playerid) == PLAYER_STATE_ONFOOT &&
		GetPlayerState(giveplayerid) == PLAYER_STATE_ONFOOT &&
		IsPlayerInRangeOfPlayer(8.0, playerid, giveplayerid) &&
		PlayerOffer[ giveplayerid ][YN_TYPE_DEBT][TargetParams][0] != 0)
		{
		if (GetPlayerHP(giveplayerid) <= 30 && pInfo[giveplayerid][pJob] != 0)
		{
			SendClientMessage(playerid,COLOR_GREEN, !"Вы избили должника до 25 хп, крыша была автоматически установлена!");
			SendClientMessage(playerid,COLOR_GREEN, !"Мафиози %s запугал Вас, теперь ");
			pInfo[giveplayerid][pKrisha] = pInfo[playerid][pMember];
			new query_[128];
			format(query_, sizeof(query_), "UPDATE `s_users` SET `pKrisha` = '%d' WHERE `Name` = '%s' LIMIT 1", pInfo[giveplayerid][pKrisha], pInfo[giveplayerid][pName]);
			mysql_tquery(dbHandle, query_, "", "");

			PlayerOffer[ giveplayerid ][YN_TYPE_DEBT][TargetParams][0] = 0;
			OnPlayerQuestProgress(playerid, QUEST_MAFIA, QUEST_TASK_RACKET);
			return 1;
		}
		}
	}
	}
	#endif
	if (newkeys & KEY_SECONDARY_ATTACK || (newkeys & KEY_SUBMISSION && newkeys & KEY_SECONDARY_ATTACK))
	{
	if (pTemp[playerid][PlayerTreningBox] >= 500)
	{
		SendClientMessage(playerid, COLOR_GRAD1, !"Урок закончен, чтобы продолжить начните новый урок у тренера");
		ApplyAnimation(playerid, "FAT", "IDLE_tired",4.0,0,0,0,0,0,1);
		SetPlayerChatBubble(playerid,"Устал",COLOR_PURPLE,30.0,10000);
		SetPVarInt(playerid, #TreningStop, 1);
	}
	}
	if (newkeys & KEY_HANDBRAKE && newkeys & KEY_SECONDARY_ATTACK )
	{
	    new string_[64];
	if (IsPlayerInRangeOfPoint(playerid,3.0, 768.5205,-2.8860,1000.7214))
	{
	    if (GetPVarInt(playerid, #TreningStop) == 1) return SendClientMessage(playerid, COLOR_GREY, !"Урок закончен, чтобы продолжить начните новый урок у тренера");
		if (pInfo[playerid][pBoxSkill] >= 5000) return SendClientMessage(playerid, COLOR_GRAD1, !"Вы уже владеете данным стилем искусства");
		if (pInfo[playerid][pBoxstyle] == 1)
		{
		if (pInfo[playerid][pBoxSkill] >= 2500)
		{
			if (pInfo[playerid][pBoxSkill] == 2500) SendClientMessage(playerid, COLOR_GREEN, !"Ваш навык владения техникой стиля повысился");
			SetPlayerFightingStyle (playerid, FIGHT_STYLE_BOXING);
			pInfo[playerid][pBoxSkill] += 1;
			pTemp[playerid][PlayerTreningBox] +=2;
			format(string_, sizeof string_, "~w~+ %d / 5000 BOX", pInfo[playerid][pBoxSkill]);
			GameTextForPlayer(playerid, string_, 2000, 3);
			return 1;
		}
		pInfo[playerid][pBoxSkill] += 1;
		pTemp[playerid][PlayerTreningBox] += 2;
		format(string_, sizeof string_, "~w~+ %d / 5000 BOX", pInfo[playerid][pBoxSkill]);
		GameTextForPlayer(playerid, string_, 2000, 3);
		SetPlayerFightingStyle (playerid, FIGHT_STYLE_NORMAL);
		return 1;
		}
		else
		{
		SendClientMessage(playerid, COLOR_GRAD1, "Тренер не проводил с Вами занятий по Box");
		ApplyAnimation(playerid, "FAT", "IDLE_tired",4.0,0,0,0,0,0,1);
		return 1;
		}
	}
	else if (IsPlayerInRangeOfPoint(playerid,3.0,761.1723,11.3122,1001.1639))
	{
	    if (GetPVarInt(playerid, #TreningStop) == 1) return SendClientMessage(playerid, COLOR_GREY, !"Урок закончен, чтобы продолжить начните новый урок у тренера");
		if (pInfo[playerid][pKickboxSkill] >= 5000) return SendClientMessage(playerid, COLOR_GRAD1, !"Вы уже владеете данным стилем искусства");
		if (pInfo[playerid][pKickstyle] == 1)
		{
		if (pInfo[playerid][pKickboxSkill] >= 2500)
		{
			if (pInfo[playerid][pKickboxSkill] == 2500) SendClientMessage(playerid, COLOR_GREEN, !"Ваш навык владения техникой стиля повысился");
			SetPlayerFightingStyle (playerid, FIGHT_STYLE_KNEEHEAD);
			pInfo[playerid][pKickboxSkill] += 1;
			pTemp[playerid][PlayerTreningBox] +=2;
			format(string_, sizeof string_, "~w~+ %d / 5000 KICKBOX", pInfo[playerid][pKickboxSkill]);
			GameTextForPlayer(playerid, string_, 2000, 3);
			return 1;
		}
		pInfo[playerid][pKickboxSkill] += 1;
		pTemp[playerid][PlayerTreningBox] +=2;
		format(string_, sizeof string_, "~w~+ %d / 5000 KICKBOX", pInfo[playerid][pKickboxSkill]);
		GameTextForPlayer(playerid, string_, 2000, 3);
		SetPlayerFightingStyle (playerid, FIGHT_STYLE_NORMAL);
		return 1;
		}
		else
		{
		SendClientMessage(playerid, COLOR_GRAD1, !"Тренер не проводил с Вами занятий по Kick Box");
		ApplyAnimation(playerid, "FAT", "IDLE_tired",4.0,0,0,0,0,0,1);
		return 1;
		}
	}
	else if (IsPlayerInRangeOfPoint(playerid,3.0,769.8723,14.4393,1000.6978))
	{
	    if (GetPVarInt(playerid, #TreningStop) == 1) return SendClientMessage(playerid, COLOR_GREY, !"Урок закончен, чтобы продолжить начните новый урок у тренера");
		if (pInfo[playerid][pKongfuSkill] >= 5000) return SendClientMessage(playerid, COLOR_GRAD1, !"Вы уже владеете данным стилем искусства");
		if (pInfo[playerid][pKstyle] == 1 )
		{
		if (pInfo[playerid][pKongfuSkill] >= 2500)
		{
			if (pInfo[playerid][pKongfuSkill] == 2500) SendClientMessage(playerid, COLOR_GREEN, !"Ваш навык владения техникой стиля повысился");
			pInfo[playerid][pKongfuSkill] += 1;
			pTemp[playerid][PlayerTreningBox] += 2;
			format(string_, sizeof string_, "~w~+ %d / 5000 KONG FU", pInfo[playerid][pKongfuSkill]);
			GameTextForPlayer(playerid, string_, 2000, 3);
			SetPlayerFightingStyle (playerid, FIGHT_STYLE_KUNGFU);
			return 1;
		}
		pInfo[playerid][pKongfuSkill] += 1;
		pTemp[playerid][PlayerTreningBox] += 2;
		format(string_, sizeof string_, "~w~+ %d / 5000 KONG FU", pInfo[playerid][pKongfuSkill]);
		GameTextForPlayer(playerid, string_, 2000, 3);
		SetPlayerFightingStyle (playerid, FIGHT_STYLE_NORMAL);
		}
		else
		{
		SendClientMessage(playerid, COLOR_GRAD1, "Тренер не проводил с Вами занятий по Kong Fu");
		ApplyAnimation(playerid, "FAT", "IDLE_tired",4.0,0,0,0,0,0,1);
		return 1;
		}
	}
	}
	SettingServer[1] = GetTickCount() - PlayerKeyStateChangeCount;
	return 1;
