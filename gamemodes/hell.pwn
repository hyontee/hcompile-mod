		case D_CONVERTMONEY:
		{
			if (!response) return 1;
			new money_count = strval(inputtext), string_[128];
			if(sscanf(inputtext, "d",money_count)) return false;
			if(money_count > 5000) return SendClientMessage(playerid, COLOR_GREY,"Можно за раз обменивать не больше 5000 "DonatePoint"");
			if(money_count < -1) return 1;
			if (kLibGetPlayerMoney(playerid) < money_count*75000) return SendClientMessage(playerid, COLOR_GREY, "У Вас недостаточно денег!");
			if(money_count < 1) return 1;
			kLibGivePlayerMoney(playerid, -money_count*75000);
			format(string_, sizeof string_, "Вы обменяли "collime"%d"colwhi" на "collime"%d"colwhi" "DonatePoint".", money_count*75000, money_count);
			SendClientMessage(playerid, COLOR_WHITE, string_);
			pInfo[playerid][pDonate] += money_count;
			SavePlayerInteger(playerid, "u_donate", pInfo[playerid][pDonate]); 
			return 1 ;
		}
