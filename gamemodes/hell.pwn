publics: HideDamageInformer(targetid, PlayerText3D:label) return DeletePlayer3DTextLabel(targetid, label);


public OnPlayerEnterDynamicCP(playerid, checkpointid) { 
	if (checkpointid == pTemp[playerid][tRaceCP]) {
	srace_end(playerid, 0);
	}
	return 1;
}
public OnPlayerLeaveDynamicCP(playerid, checkpointid) {
	return 1;
}
public OnPlayerEnterRaceCheckpoint(playerid)
{
    if (GetPVarInt(playerid,"FloodPickUpPickupRace") > gettime()) return 1;
	SetPVarInt(playerid,"FloodPickUpPickupRace",gettime()+1);
	DisablePlayerRaceCheckpoint(playerid);
	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
	
		if (pTemp[playerid][TypeCheckpoint] == 1 &&
			(IsAGang(playerid) || IsAMafia(playerid)) &&
			VehicleInfo[ vehicleid - 1][vType] == VEHICLE_TYPE_DYNAMIC &&
			VehicleInfo[ vehicleid - 1][vFraction] == DYNAMIC_VEH_MATS)
		{
			static Float:unloading_delivery_mats[8][3] = {

				{2644.6416,-2024.3840,13.5469}, // unloading ballas
				{2782.0908,-1609.1428,10.9219}, // unloading vagos
				{2504.0674,-1682.7295,13.5469}, // unloading grove
				{1669.4633,-2112.7056,13.5469}, // unloading aztec
				{2173.0042,-1804.0236,13.3696}, // unloading rifa
				{1447.3246,758.7495,10.8203}, // unloading LCN
				{1466.8739,2773.6145,10.6719}, // unloading yakuza
				{961.2510,1732.4156,8.6484} // unloading rm

			};

			new tmp_id = capture_band(pInfo[playerid][pMember]);

			if (IsPlayerInRangeOfPoint(playerid, 7.0,unloading_delivery_mats[tmp_id][0],unloading_delivery_mats[tmp_id][1],unloading_delivery_mats[tmp_id][2]))
			{
				pTemp[playerid][TypeCheckpoint] = 0 ;
				new str_tmp[38 + MAX_PLAYER_NAME];

				new tmp_mats;

				if (FractionInfo[pInfo[playerid][pMember]][fMaterials] + VehicleInfo[ vehicleid - 1 ][vMaterials] >  STORE_LIMITS_MATERIALS){
					new tmp_mats_ =  FractionInfo[pInfo[playerid][pMember]][fMaterials] + VehicleInfo[ vehicleid - 1 ][vMaterials] - STORE_LIMITS_MATERIALS;
					tmp_mats =  VehicleInfo[ vehicleid - 1 ][vMaterials]-tmp_mats_;
				}
				else tmp_mats = VehicleInfo[ vehicleid - 1 ][vMaterials];

				if (tmp_mats > 0)
				{
					VehicleInfo[ vehicleid - 1 ][vMaterials] -= tmp_mats; 

					FractionInfo[pInfo[playerid][pMember]][fMaterials] += tmp_mats;

					format(str_tmp,sizeof(str_tmp),"%s разгрузил %d материалов на склад %s",pInfo[playerid][pName],tmp_mats,IsAGang(playerid) == 1 ? ("банды"):("мафии"));
					SendFamilyMessage(pInfo[playerid][pMember], 0x6BB3FFAA, str_tmp);

					SaveFractionInfoID(FractionInfo[pInfo[playerid][pMember]][fID]);
					UpdateFractionStore(pInfo[playerid][pMember]);

					if (VehicleInfo[ vehicleid - 1 ][vMaterials] < 1)
					{
						SetVehicleToRespawn(vehicleid);
					}
				}

			}
		} 
	    if (GetPVarInt(playerid,"farm_status") == 5)
	    {
	        pPressed[playerid]++;
		new
		idx_ = pPressed[playerid],
		FARM_ID = pTemp[playerid][TempFermID],
		string_[128];
	        switch(FARM_ID)
	    	{
      		case 1:
		{
		    if (pPressed[playerid] == sizeof(Farmcombine_coord_one))
		    {
		        FarmInfo[FARM_ID][fGrain_Sown] = 5000;
		        FarmInfo[FARM_ID][fGrain]-=5000;
			format(string_, sizeof string_, "На поле 5000 / 5000 зерна. На складе %d / 10000",FarmInfo[FARM_ID][fGrain]);
			SendClientMessage(playerid,COLOR_GREEN,string_);
		        DeletePVar(playerid,"farm_status");
		        pPressed[playerid] = 0;
			}
		    else if (pPressed[playerid] == sizeof(Farmcombine_coord_one)-1)
			{
			SetPlayerRaceCheckpoint(playerid,1,Farmcombine_coord_one[idx_][0],Farmcombine_coord_one[idx_][1],Farmcombine_coord_one[idx_][2],0,0,0,5.0);
			}
			else
			{
			SetPlayerRaceCheckpoint(playerid,0,Farmcombine_coord_one[idx_][0],Farmcombine_coord_one[idx_][1],Farmcombine_coord_one[idx_][2],Farmcombine_coord_one[idx_+1][0],Farmcombine_coord_one[idx_+1][1],Farmcombine_coord_one[idx_+1][2],5.0);
			}
		}
		case 2:
		{
		    if (pPressed[playerid] == sizeof(Farmcombine_coord_two))
		    {
		        FarmInfo[FARM_ID][fGrain_Sown] = 5000;
		        FarmInfo[FARM_ID][fGrain]-=5000;
		        format(string_, sizeof string_, "На поле 5000 / 5000 зерна. На складе %d / 10000",FarmInfo[FARM_ID][fGrain]);
			SendClientMessage(playerid,COLOR_GREEN,string_);
		        DeletePVar(playerid,"farm_status");
		        pPressed[playerid] = 0;
			}
		    else if (pPressed[playerid] == sizeof(Farmcombine_coord_two)-1)
			{
			SetPlayerRaceCheckpoint(playerid,1, Farmcombine_coord_two[idx_][0], Farmcombine_coord_two[idx_][1], Farmcombine_coord_two[idx_][2], 0, 0, 0, 5.0);
			}
			else
			{
			SetPlayerRaceCheckpoint(playerid,0,Farmcombine_coord_two[idx_][0],Farmcombine_coord_two[idx_][1],Farmcombine_coord_two[idx_][2],Farmcombine_coord_two[idx_+1][0],Farmcombine_coord_two[idx_+1][1],Farmcombine_coord_two[idx_+1][2],5.0);
			}
		}
		case 3:
		{
		    if (pPressed[playerid] == sizeof(Farmcombine_coord_three))
		    {
		        FarmInfo[FARM_ID][fGrain_Sown] = 5000;
		        FarmInfo[FARM_ID][fGrain]-=5000;
		        format(string_, sizeof string_, "На поле 5000 / 5000 зерна. На складе %d / 10000",FarmInfo[FARM_ID][fGrain]);
			SendClientMessage(playerid,COLOR_GREEN,string_);
		        DeletePVar(playerid,"farm_status");
		        pPressed[playerid] = 0;
			}
		    else if (pPressed[playerid] == sizeof(Farmcombine_coord_three)-1)
			{
			SetPlayerRaceCheckpoint(playerid,1,Farmcombine_coord_three[idx_][0],Farmcombine_coord_three[idx_][1],Farmcombine_coord_three[idx_][2],0,0,0,5.0);
			}
			else
			{
			SetPlayerRaceCheckpoint(playerid,0,Farmcombine_coord_three[idx_][0],Farmcombine_coord_three[idx_][1],Farmcombine_coord_three[idx_][2],Farmcombine_coord_three[idx_+1][0],Farmcombine_coord_three[idx_+1][1],Farmcombine_coord_three[idx_+1][2],5.0);
			}
		}
		case 4:
		{
		    if (pPressed[playerid] == sizeof(Farmcombine_coord_four))
		    {
		        FarmInfo[FARM_ID][fGrain_Sown] = 5000;
		        FarmInfo[FARM_ID][fGrain]-= 5000;
		        format(string_, sizeof string_, "На поле 5000 / 5000 зерна. На складе %d / 10000",FarmInfo[FARM_ID][fGrain]);
			SendClientMessage(playerid,COLOR_GREEN,string_);
		        DeletePVar(playerid,"farm_status");
		        pPressed[playerid] = 0;
			}
		    else if (pPressed[playerid] == sizeof(Farmcombine_coord_four)-1)
		    {
			SetPlayerRaceCheckpoint(playerid,1,Farmcombine_coord_four[idx_][0],Farmcombine_coord_four[idx_][1],Farmcombine_coord_four[idx_][2],0,0,0,5.0);
			}
			else
			{
			SetPlayerRaceCheckpoint(playerid,0,Farmcombine_coord_four[idx_][0],Farmcombine_coord_four[idx_][1],Farmcombine_coord_four[idx_][2],Farmcombine_coord_four[idx_+1][0],Farmcombine_coord_four[idx_+1][1],Farmcombine_coord_four[idx_+1][2],5.0);
			}
		}
		case 5:
		{
		    if (pPressed[playerid] == sizeof(Farmcombine_coord_five))
		    {
		        FarmInfo[FARM_ID][fGrain_Sown] = 5000;
		        FarmInfo[FARM_ID][fGrain] -= 5000;
		        format(string_, sizeof string_, "На поле 5000 / 5000 зерна. На складе %d / 10000",FarmInfo[FARM_ID][fGrain]);
			SendClientMessage(playerid,COLOR_GREEN,string_);
		        DeletePVar(playerid,"farm_status");
		        pPressed[playerid] = 0;
			}
		    else if (pPressed[playerid] == sizeof(Farmcombine_coord_five)-1)
		    {
			SetPlayerRaceCheckpoint(playerid, 1, Farmcombine_coord_five[idx_][0],Farmcombine_coord_five[idx_][1],Farmcombine_coord_five[idx_][2],0,0,0,5.0);
			}
			else
			{
			SetPlayerRaceCheckpoint(playerid, 0, Farmcombine_coord_five[idx_][0],Farmcombine_coord_five[idx_][1],Farmcombine_coord_five[idx_][2],Farmcombine_coord_five[idx_+1][0],Farmcombine_coord_five[idx_+1][1],Farmcombine_coord_five[idx_+1][2],5.0);
			}
		}
		}
		SaveFermID(FARM_ID);
	}
	    if (GetPVarInt(playerid,"farm_status") == 3)
	    {
		TogglePlayerControllable(playerid, 0);
		GameTextForPlayer(playerid,"Wait...",3000,3);
		return SetTimerEx("Farmduty" , 3000, false, "i", playerid);
	}
	if (pTemp[playerid][TestAutoShcool] 
		&& VehicleInfo[ vehicleid - 1][vType] == VEHICLE_TYPE_FRACTION && VehicleInfo[ vehicleid - 1][vFraction] == FRACTION_AUTOSCHOOL && VehicleInfo[ vehicleid - 1][vModel] == 426)
      //  if (pTemp[playerid][TestAutoShcool])
	{
		/*if (GetPlayerState(playerid) != 2) return SendClientMessage(playerid, COLOR_GREY, !"Вы должны находиться за рулем!");
		if (VehicleInfo[v_idx][vFraction] == FRACTION_AUTOSCHOOL && VehicleInfo[v_idx][vModel] == 426 )
		if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_FRACTION && (VehicleInfo[ vehicleid - 1 ][vFraction] == FRACTION_AUTOSCHOOL)) {

		}*/
		if (pTemp[playerid][CheckpointPressed] == 63)
		{
		    new Float:health;
		GetVehicleHealth(vehicleid,health);
		if (health >= 850)
		{ 
			GivePlayerLicense(playerid, DRIVE_LIC, 30);
			SendClientMessage(playerid, COLOR_WHITE, !"Поздравляем вас! Вы сдали экзамен по вождению");
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Теперь вы можете устроить на работу в Мэрии << Используйте /GPS >>"); 
			OnPlayerAchievProgress(playerid, 13);
			OnPlayerQuestProgress(playerid, QUEST_GUEST, QUEST_TASK_LICENCE_CAR);
			//OnPlayerQuestProgress(playerid, QUEST_GUEST, QUEST_TASK_LICENCE_CAR,1);
		}
		else SendClientMessage(playerid, COLOR_GRAD1, !"Вы недостаточно хорошо водите, чтобы получить права");
                pTemp[playerid][TestAutoShcool] = false;
		pTemp[playerid][TakingLesson] = false;
		pTemp[playerid][CheckpointPressed] = 0;
		SetVehicleToRespawn(GetPlayerVehicleID(playerid));
		DisablePlayerRaceCheckpoint(playerid);
		}
		else
		{
		pTemp[playerid][CheckpointPressed]++;
		new i = pTemp[playerid][CheckpointPressed];
		if (pPressed[playerid] < 63) SetPlayerRaceCheckpoint(playerid, 0, DriverTest[i][0],DriverTest[i][1],DriverTest[i][2],DriverTest[i][3],DriverTest[i][4],DriverTest[i][5], 5.0);
		else SetPlayerRaceCheckpoint(playerid,1, DriverTest[i][0],DriverTest[i][1],DriverTest[i][2],DriverTest[i][3],DriverTest[i][4],DriverTest[i][5], 5.0);
		}
	}
	#if defined _job_inc
		if (job_OnPlayerEnterRaceCheckpoint(playerid)) return true;
	#endif
	if (EV_OnPlayerEnterRaceCheckpoint(playerid)) return true;
	}
	return 1;
}
public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	if (ispassenger == 0) {
	if (!GetPlayerUseCar(playerid, vehicleid, true))
	{
		TogglePlayerControllable(playerid, 0);
		ClearAnimations(playerid);
		TogglePlayerControllable(playerid, 1);
		SetVehicleParamsForPlayer(vehicleid, playerid, 0, 1);
		SetTimerEx("ChangeStatusVehicle", 3200,false, "ii", playerid,vehicleid);
		new veh_id = GetPlayerVehicleID(playerid);
		new pos = -1;
		if (VehicleInfo[ veh_id - 1 ][vType] == VEHICLE_TYPE_FRACTION && VehicleInfo[ veh_id - 1 ][vFraction] == pInfo[playerid][pMember]) pos = 3;
		if (pos == -1 ) return SendClientMessage(playerid,CGRAY2,!"У вас нет ключей от данной машины");
		return 0;
	}
	}

	SetPlayerArmedWeapon(playerid,0);

	if (usemats[playerid] > 0)
	{
	    if (usemats[playerid] == 1) FractionInfo[3][fMaterials] += 250, SaveFractionInfoID(FractionInfo[3][fID], false);
	    if (usemats[playerid] == 2)
	{
		//SetPVarInt(playerid, "Player:ArmyAreaID", area_extra_id);
		gEconomyServer[eMaterialsLSa][ GetPVarInt(playerid, "Player:ArmyAreaID") ] += 500;
		DeletePVar(playerid, "Player:ArmyAreaID");
		SetUpdate3DTextLabel();
	}
	    if (usemats[playerid] == 3) FractionInfo[19][fMaterials] += 250, SaveFractionInfoID(FractionInfo[19][fID], false);
	    usemats[playerid] = 0;
	if (IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
	SendClientMessage(playerid, COLOR_REDD, !"Вы уронили ящик");
	SetPlayerSpecialAction (playerid, SPECIAL_ACTION_NONE);
	}
	if (pTemp[playerid][tGruzJob] == true && pTemp[playerid][tPlayerUseItemJob] == true)
	{
	SendClientMessage(playerid, COLOR_REDD, !"Вы уронили мешок!");
	if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
	DisablePlayerCheckpoint(playerid);
	pTemp[playerid][tPlayerUseItemJob] = false;
	ClearAnimations(playerid);
	switch(random(6)) {
		case 0: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2239.3193,-2276.5266,14.3958-1.0,1.5));//Вагон 3
		case 1: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2233.3889,-2282.1833,14.3958-1.0,1.5));//Вагон 4
		case 2: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2227.5889,-2288.2412,14.3958-1.0,1.5));//Вагон 5
		case 3: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2221.9451,-2294.1477,14.3958-1.0,1.5));//Вагон 6
		case 4: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2216.0876,-2299.7507,14.3958-1.0,1.5));//Вагон 7
		default: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2210.2498,-2305.5447,14.3958-1.0,1.5));//Вагон 8
	} 
	}
	if (pTemp[playerid][tJobHunter] && pTemp[playerid][tPlayerUseItemJob]) {
	if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1); 
	pTemp[playerid][tPlayerUseItemJob] = false;
	SendClientMessage(playerid,COLOR_REDD, !"Вы уронили мешок с мясом!");
	ClearAnimations(playerid);
	}
	#if defined _ac_ser_inc
	AC_Info[playerid][acEnterVehicleID] = vehicleid;
	#endif
	return 1;
}
public OnPlayerExitVehicle(playerid, vehicleid)
{
    if (pTemp[playerid][TypeCheckpoint] == 1) {
	DisablePlayerRaceCheckpoint(playerid);
	pTemp[playerid][TypeCheckpoint] = 0;
	}
	if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_FRACTION && (VehicleInfo[ vehicleid - 1 ][vFraction] == FRACTION_ARMY_SF))
	//if (VehicleInfo[ vehicleid - 1 ][vFraction] == FRACTION_ARMY_SF)
	{
	if (VehicleInfo[ vehicleid - 1 ][vModel] == 548) {  
		DisablePlayerCheckpoint(playerid);
		SetPVarInt(playerid, #LoadGunArmy, 0);
		SetPVarInt(playerid, #LoadTypeArmy, 0);
	} 
	}
    //pTemp[playerid][PlayerAFK] = 0;
    if (GetPVarInt(playerid,#AutoShopShow) != 0) {
	ExitCar(playerid);
	SendClientMessage(playerid, COLOR_LIGHTRED, !"Вы вышли из машины, выбор машин завершен!");
	} 
	#if defined _theft_inc
	theft_OnPlayerExitVehicle(playerid, vehicleid);
	#endif
	if (pTemp[playerid][PlayerEfir] == true)
	{
	SendClientMessage(playerid, COLOR_WHITE, !"Вы вышли из прямого эфира");
	pTemp[playerid][PlayerEfir] = false;
	}
	if (Pefir[playerid] == 1 || Pefir[playerid] == 2 || Pefir[playerid] == 3)
	{
	pTemp[playerid][PlayerEfir] = false;
	SendClientMessage(playerid, COLOR_WHITE, !"Вы вышли из прямого эфира");
	}
	pTemp[playerid][PlayerVehicle] = INVALID_VEHICLE_ID; 
	VehicleInfo[ vehicleid - 1 ][vDriverID] = INVALID_PLAYER_ID;
	//vehicle_OnPlayerExitVehicle(playerid, vehicleid);
	pTemp[playerid][pSLimit] = 0;
	#if defined _job_inc
	if (job_OnPlayerExitVehicle(playerid, vehicleid)) return true;
	#endif
	if (Event_OnPlayerExitVehicle(playerid)) return true;
	return 1;
}
public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
	return 1;
}
public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    new PlayerKeyStateChangeCount = GetTickCount(),
    	V_IDX = GetPlayerVehicleID(playerid);
    if (newkeys & 16)
	{
	if (pSpecture[playerid][sID] != INVALID_PLAYER_ID) {
	    	SelectTextDraw(playerid, 0xFF9933FF);
	    }
	}
	#if defined _casino_included
	if (casino_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _poker_included
	if (poker_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _blackjack_included
	if (blackjack_OnPlayerKStateChange(playerid, newkeys, oldkeys)) return true;
	#endif

	if (md_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	if (Family_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	if (ATM_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	if (items_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	if (Fraction_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#if defined _mapeditor_included
	if (ME_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _businesses_inc
	if (business_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	#if defined _hospital_inc
	if (hospital_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	if (House_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#if defined _dice_game_inc
	if (bone_OnPlayerKeyStateChange(playerid, newkeys, oldkeys)) return true;
	#endif
	//House_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
	SeatDown_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
	drg_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
	Intrct_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
	AirDrop_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
	cont_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
    if (IsPlayerInAnyVehicle(playerid))//В машине
 	{
	if (GetPlayerState ( playerid ) ==  PLAYER_STATE_DRIVER)
	{
 		if ( newkeys & KEY_JUMP )
		player_holding_key_down [ playerid ] = GetTickCount() ;
		if ( oldkeys & KEY_JUMP )
		player_holding_key_down [ playerid ] = 0x7FFFFFFF;
	}
 	    if ((newkeys & KEY_SUBMISSION && !(oldkeys & KEY_SUBMISSION)) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		pc_cmd_en(playerid);
	}	
	if ((newkeys & 1 && !(oldkeys & 1)) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		if (pTemp[playerid][tVehicleRC] != INVALID_VEHICLE_ID) {
		RemovePlayerFromVehicle(playerid);
		//new Float: x_, Float: y_, Float: z_;
		//GetVehiclePos(pTemp[playerid][tVehicleRC], x_, y_, z_);
		//SetPlayerPosAC(playerid, x_, y_, z_, 0, 0);
		//	SetCameraBehindPlayer(playerid);
		_DestroyVehicle(pTemp[playerid][tVehicleRC]);
		pTemp[playerid][tVehicleRC] = INVALID_VEHICLE_ID;
		SetPVarInt(playerid, "AntiKickGarage", gettime()+2);
		SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Вы закончили управление RC игрушкой, она была убрана в инвентарь");
		}
		callcmd::slimit(playerid);
	}
	if (PRESSED(KEY_FIRE))//Левая кнопка мыши
    	{
    	    if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
		if (v_velo(V_IDX) || IsAPlane(V_IDX) || IsABoat(V_IDX)) return 1;
		ToggleLights(V_IDX);
	}
	if (PRESSED(KEY_YES))//Левая кнопка мыши
    {
		new idx = 0;
		t_string[0] = EOS;
		strcat(t_string, ""colserver"[№] Название(кол-во)\t"colserver"[Тип]\n");
		for(new i = 0, string_[128]; i < MAX_ITEMS_SLOTS; i++)
		{   
			if (!pInfo[playerid][PlayerItems][i]) continue; 
			new 
				typeItems = inventory_items[ pInfo[playerid][PlayerItems][i] ][accesoryType];
			format(string_, sizeof string_, ""colwhi"[%d] %s(%d шт.)\t{%s}[%s]\n", idx, 
				inventory_items[ pInfo[playerid][PlayerItems][i] ][ITEM_NAME], 
				pInfo[playerid][PlayerItemsCount][i], 
				colorItems[typeItems - 1], 
				nameItems[typeItems - 1]
			);
			strcat(t_string, string_); 
			playerListItem[playerid][idx] = pInfo[playerid][PlayerItems][i]; 
			playerSelectSlot[playerid][idx] = i;
			idx++;
		}
		if (idx == 0) {
			SendClientMessage(playerid, COLOR_GREY, !"Ваш инвентарь пуст!");
			playerListItem[playerid][idx] = -1;
			playerSelectSlot[playerid][idx] = -1;
			return 1;
		}
		else ShowPlayerDialog(playerid, D_INV, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Инвентарь: "colwhi"Аксессуары", t_string, "Выбрать", "Отмена"); 
	}	
	if (PRESSED(KEY_CROUCH) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetPlayerVirtualWorld(playerid) == 0)//KEY H
	{
		if(IsACop(playerid) && IsPlayerInRangeOfPoint(playerid, 3.0, 1622.6132,-1130.8430,23.9063)) //JOPAADMINA
		{
			new GET_TRAILER = GetVehicleTrailer(GetPlayerVehicleID(playerid));
			if (VehicleInfo[ GET_TRAILER - 1 ][vType] == VEHICLE_TYPE_PLAYER)
			{
				new query_[156];
				format(query_, sizeof query_,"UPDATE `s_vehicle_player` SET `vFuel` = '%f',`vMillage` = '%f',`vFine` = '1',`vDayFine` = '1' WHERE `vID` = '%d' LIMIT 1",
				VehicleInfo[ GET_TRAILER - 1 ][vFuel],
				VehicleInfo[ GET_TRAILER - 1 ][vMillage],
				VehicleInfo[ GET_TRAILER - 1 ][vID]) ;
				mysql_tquery(dbHandle, query_);

				new t_playerid = - 1 ;
				foreach(new i: PlayerInLogin)
				{
					if (VehicleInfo[ GET_TRAILER - 1 ][vFraction] == pInfo[i][pID])
					{
						t_playerid = i;
					}
				}



				VehicleInfo[ GET_TRAILER - 1 ][vFraction] = 0;
				VehicleInfo[ GET_TRAILER - 1 ][vSubFraction] = 0;
				VehicleInfo[ GET_TRAILER - 1 ][vRank] = 0;
				VehicleInfo[ GET_TRAILER - 1 ][vType] = 0;
				VehicleInfo[ GET_TRAILER - 1 ][vMoney] = 0;
				VehicleInfo[ GET_TRAILER - 1 ][vFillBag] = 0;
				VehicleInfo[ GET_TRAILER - 1 ][vRepair] = 0;
				VehicleInfo[ GET_TRAILER - 1 ][vDrugs] = 0;
				VehicleInfo[ GET_TRAILER - 1 ][vMaterials] = 0;
				for(new t = 0; t < 6; t++)
				{
					VehicleInfo[ GET_TRAILER - 1 ][vBootGun][t] = 0;
					VehicleInfo[ GET_TRAILER - 1 ][vBootAmmo][t] = 0;
				}
				DetachTrailerFromVehicle(GET_TRAILER);
				_DestroyVehicle(GET_TRAILER);

				if (t_playerid != -1)
				{
					if (VehicleInfo[ GET_TRAILER - 1 ][vJacker] == 0)
					{
						Iter_Remove(StreamedVehicles[t_playerid], GET_TRAILER);
						SendClientMessage(t_playerid, COLOR_WHITE, !"Ваш транспорт был доставлен на "colserver"Штрафстоянку");
						Iter_Remove(PlayerListVehicle[t_playerid], GET_TRAILER);
						SetVehicleToRespawn(GET_TRAILER);

					} else {
						_DestroyVehicle(GET_TRAILER);
					}
				}
				//DisablePlayerCheckpoint(playerid);
			}
			else
			{
				SendClientMessage(playerid, COLOR_WHITE, "Джимми Уилсон[1001]: Так у неё даже владельца нет, ты чего сюда привёз?!");
				DisablePlayerCheckpoint(playerid);
			}
		}
	}
		if (PRESSED(KEY_CROUCH) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetPlayerVirtualWorld(playerid) == 0)//KEY H
	    { 
		
		
		if (IsPlayerInRangeOfPoint(playerid, 7.0,2198.5261,-2659.9502,13.6378))
		{
		if (pTemp[playerid][tRobVeh] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREY, !"Вы не в рабочем транспорте!");
		if (VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Ваш фургон пуст!"); 
		new	
			amountsell = (VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount]*250),
			string_[128];
		kLibGivePlayerMoney(playerid, amountsell, "Rob House");
		SetMoveCashServer(IN_SERVER, amountsell);

		format(string_, sizeof string_, "Вы сдали "colmaline"%d %s "colwhi"техники за "collime"$%d", 
			VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount], Declension_ReturnWord(VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount], "единицу", "единицы", "единиц"),
			amountsell
		);
		VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount] = 0;
		SendClientMessage(playerid, COLOR_WHITE, string_);
		OnPlayerQuestProgress(playerid, QUEST_GHETTO, QUEST_TASK_ROBHOUSE);
		OnPlayerAchievProgress(playerid, 17);
		OnPlayerAchievProgress(playerid, 18); 
		} 
		if (IsAGosFraction(playerid) || GetPlayerSkin(playerid) == 287 || GetPlayerSkin(playerid) == 191)
		{
		if (IsPlayerInRangeOfPoint(playerid, 3.0,-2438.7942,524.3234,29.6306))
		{
	       		SetVehiclePos(V_IDX, -2501.9170,524.2781,491.5463);
	           	SetVehicleZAngle(V_IDX, 273.4404);
			SetPVarInt(playerid,"AntiKickGarage",gettime()+2);
	      	}
	      	else if (IsPlayerInRangeOfPoint(playerid, 3.0,-2500.6748,534.4558,491.7077))
	      	{
	      	    SetVehiclePos(V_IDX, -2443.1113,524.0466,29.6310);
	           	SetVehicleZAngle(V_IDX, 180.2442);
			SetPVarInt(playerid,"AntiKickGarage",gettime()+2);
	      	}
		else if (IsPlayerInRangeOfPoint(playerid, 10.0, 346.29, 1798.12, 18.43))
		{
			UpdateStatusGate(0, 1);
		}
		else if (IsPlayerInRangeOfPoint(playerid, 10.0, 140.814,1941.065,19.745))
		{
			UpdateStatusGate(1, 1);
		}
		/*else if (IsPlayerInDynamicArea(playerid, DynamicRectangLVa[7])){
			UpdateStatusGate(2, 1);
		    }*/
		else if (IsPlayerInRangeOfPoint(playerid, 10.0, 1544.703, -1630.804, 13.021))
		{ 
			UpdateStatusGate(4, 1);
		    }
		/*else if (IsPlayerInRangeOfPoint(playerid, 10.0, -1526.374, 481.389, 6.863))
		{
			UpdateStatusGate(5,1);
		    }*/
		else if (IsPlayerInRangeOfPoint(playerid, 10.0, -2436.865, 495.447, 29.647))
		{
			UpdateStatusGate(6, 1);
		} 
		}
	    }
	}
	else
	{
	if ( pTemp[playerid][tActionType] > ACTION_NONE )
	{
		if ( newkeys & pTemp[playerid][tActionKey] )
		{ 
		pTemp[playerid][tActionStep] ++ ; 
		switch(pTemp[playerid][tActionType]) {
			case ACTION_ROB_HOUSE, ACTION_HUNTER_DEER: SetActionGameProgressBar(playerid, pTemp[playerid][tActionStep]);  
			case ACTION_TAKE_ATM_CASH, ACTION_FACTORY_SORT: SetActionGameProgressBar(playerid, pTemp[playerid][tActionStep], false);  
		}//pTemp[playerid][tActionStep]
		
		if ( pTemp[playerid][tActionStep] >= 10 )
		{
			switch ( pTemp[playerid][tActionType] )
			{
			case ACTION_ROB_HOUSE:
			{   
				pTemp[playerid][tActionStep] = 0 ;
				ActionMiniGamePlayer(playerid, false);
