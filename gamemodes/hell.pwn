		SetPlayerArmour(target_id,0);
		SetPlayerHealth(target_id, 100);
		pInfo[target_id][PlayerSpawn] = 2;
		SetPlayerSkinEx(target_id, pInfo[target_id][pModel]);
		pTemp[target_id][tDutyWork] = 1;
		format(query_, sizeof query_ , "UPDATE `s_users` SET `pLeader` = '%d', `pMember` = '%d', `pRank` = '%d', `pJob` = '%d', `pModel` = '%d', `InGameMember` = '%d' WHERE `Name` = '%s' LIMIT 1 ",
			pInfo[target_id][pLeader], pInfo[target_id][pMember], pInfo[target_id][pRank], pInfo[target_id][pJob], pInfo[target_id][pModel], pInfo[target_id][pInGameMember], pInfo[target_id][pName]);
		mysql_tquery(dbHandle, query_, "", "");
		//PlayerSpawnEx(target_id);
