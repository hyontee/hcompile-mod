		if (!IsPlayerInRangeOfPoint(playerid, 10.0, 2196.0544,-2264.8630,13.5469)) return SendClientMessage(playerid, COLOR_GREY, !"В данном месте нельзя заказать продукты");
		if (kLibGetPlayerMoney(playerid) < strval(inputtext)*4) return SendClientMessage(playerid, COLOR_WHITE,!"У вас не хватает денег!");
		new Float:x, Float:y, Float:z, string_[64];
		GetVehicleParamsEx(V_IDX, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
		    SetVehicleParamsEx(V_IDX, false, false, false, doors3, false, false, false);
		SetVehicleVelocity(V_IDX, 0.0, 0.0, 0.0);
		GetVehiclePos(V_IDX, x, y, z);
		GetXYInBackOfPlayer(playerid, x, y,3.5);
		car_pickup[V_IDX] = CreateDynamicPickup(19197, 23, x, y, z+0.3);
		car_grain[V_IDX][1] = strval(inputtext);
		car_grain[V_IDX][2] = car_grain[V_IDX][0];
		format(string_, sizeof string_, "Загружено\n{ffffff}%d / %d", car_grain[V_IDX][0], car_grain[V_IDX][1]);
		if (VehicleInfo[ V_IDX - 1 ][vFarmText] == Text3D:-1) { 
			VehicleInfo[ V_IDX - 1 ][vFarmText] = CreateDynamic3DTextLabel(string_,0xFFFF00FF,x,y,z+0.6,15.0);
		}  
		SendClientMessage(playerid, COLOR_GREEN, !"Ожидайте пока ваш автомобиль загрузят грузчики!");
		RemovePlayerFromVehicle(playerid);
		}
		else SendClientMessage(playerid, COLOR_GREY, !"Вы должны находиться в фургоне");
		return 1;
	}
	case D_JOB_FUNC_4:
	{
	    if (!response || pInfo[playerid][pJob] != PLAYER_JOB_DELIVERY) return 1;
	    new V_IDX = GetPlayerVehicleID(playerid);
		if (VehicleInfo[ V_IDX - 1 ][vType] == VEHICLE_TYPE_JOB && (VehicleInfo[ V_IDX - 1 ][vFraction] == PLAYER_JOB_DELIVERY && VehicleInfo[ V_IDX - 1 ] [vSubFraction] == DELIVERY_TYPE_0))
		{
		if (pTemp[playerid][pRentCar] != GetPlayerVehicleID(playerid)) return SendClientMessage(playerid, COLOR_GREY, !"Это не ваш автомобиль!");

		//if (!(6 <= strlen(inputtext) <= 32))//
		if (!strlen(inputtext) || strval(inputtext) < 0 || strval(inputtext) > car_grain[GetPlayerVehicleID(playerid)][0]) return SendClientMessage(playerid, COLOR_GREY, !"В автомобиле недостаточно зерна!");
		new i = -1;
		for(new farm_id = 1; farm_id <= TOTALFARM; farm_id++)
		{
			if (IsPlayerInDynamicArea(playerid, FarmInfo[farm_id][fSphere])) i = farm_id;
		}
		if (i == -1) return SendClientMessage(playerid, COLOR_GREY, !"Вы должны находиться возле фермы");
		if (!strcmp(FarmInfo[i][fOwner],"None", true))
			return SendClientMessage(playerid, COLOR_GREY, !"У фермы нет владельца");
	   		if (FarmInfo[i][fGrain]+strval(inputtext) > 10000)
		   	return SendClientMessage(playerid, COLOR_GREY, !"На ферме достаточно зерна");
		if (FarmInfo[i][fBank] < strval(inputtext)*FarmInfo[i][fGrain_Price]) return SendClientMessage(playerid, COLOR_GREY, !"На балансе фермы недостаточно средств");
		FarmInfo[i][fBank] -= strval(inputtext)*FarmInfo[i][fGrain_Price];
		FarmInfo[i][fGrain] += strval(inputtext);
		kLibGivePlayerMoney(playerid, strval(inputtext)*FarmInfo[i][fGrain_Price], "продал зерна");
		car_grain[GetPlayerVehicleID(playerid)][0] -= strval(inputtext);
		SaveFermID(i);
	      	SendMes(playerid, COLOR_GREEN, "Вы продали %d зерна за $%d!",strval(inputtext),strval(inputtext)*FarmInfo[i][fGrain_Price]);
      	}
      	else
      	{
      	    SendClientMessage(playerid, COLOR_GREY, !"Вы должны находиться в фургоне");
		RemovePlayerFromVehicle(playerid);
      	}
      	return 1;
	}
