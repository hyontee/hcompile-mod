	case D_PLAYER_RADIO:
	{
		if (!response) return 1;
		if (listitem == 10)
		{
		if (IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
		StopAudioStreamForPlayer(playerid);
		}
		else
		{
		    
		static const Radio_List[10][64] = {
			"http://ic1.h-rp.su:8001/live",
			"http://online.radiorecord.ru:8101/rr_128" ,			// Radio Record
			"http://stream.trap.fm:6004/;stream.mp3" ,			// TRAP FM
