		if (!response) return 1;
	   
		new H_IDX = pTemp[playerid][tCurrentHouseID];
	  

		if(!strlen(inputtext)) return ShowPlayerDialog(playerid, 12409, DIALOG_STYLE_INPUT,"Стоимость аренды","{FFFFFF}Введите Сумму, которую желаете установить за аренду в доме:" ,"Далее","Назад");
		if(1 < strval(inputtext) > 500)	
		{
		SCM(@p,-1,"Ошибка cумма должна быть в пределах от 1 до 500 $");	
		//ShowPlayerDialog(playerid, 12409, DIALOG_STYLE_INPUT,"Стоимость аренды","{FFFFFF}Введите Сумму, которую желаете установить за аренду в доме:" ,"Далее","Назад");
		ShowPlayerDialog(playerid,12409,DIALOG_STYLE_INPUT,"Стоимость аренды","{ffffff}Ввведите новую цену в поле ниже:","Изменить","Отмена");	
		return 1;
		} 
	
		new query_[128];

		HouseInfo[H_IDX][rentsumma] = strval(inputtext);
		static const str0[] = "Вы успешно изменили стоимость аренды вашего дома. Теперь она составляет %d $ в час.";
		new str[sizeof(str0)+3];
		format(str,sizeof(str),str0,strval(inputtext));
		SCM(@p,-1,str);
		
		format(query_, sizeof query_, "`rentsumma`= '%d'", strval(inputtext));
            SaveHouse(H_IDX, query_);

            SaveHouseID(H_IDX);
		return 1;
	} 
	case D_MAINMENU_FUNC_0:
	{
