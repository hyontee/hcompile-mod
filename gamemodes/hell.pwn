		SetPVarInt(playerid, "fPanel_Count_Vehicle", count_v);
		if (listitem == 0) {
		if (FractionInfo[ pInfo[playerid][pMember] ][fMoney] < count_v*1000)
		{
			SendClientMessage(playerid, -1, !"В банке организации недостаточно средств"); 
			format(t_string, sizeof t_string, "Респавн всех фракционных машин\t"collime"$%d\n", count_v*1000);
			new 
			veh_point = 0;
			for(new vehicleid = 0 ; vehicleid < S_VEHICLE_COUNT ; vehicleid ++)
			{
			if (!IsValidVehicle(vehicleid + 1)) continue;
			if (VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_FRACTION || VehicleInfo[vehicleid][vFraction] != pInfo[playerid][pMember]) continue ;

			veh_point ++ ;
			new line_string [ 62 ] ; 
			if (VehicleInfo[vehicleid][vTempModel] != 0) {
				format(line_string, sizeof line_string, ""colwhi"[%d] %s(%d)\t"collime"$%d\n", 
				veh_point, VehicleNames[VehicleInfo[vehicleid][vTempModel]-400], VehicleInfo[vehicleid][vTempModel]
				) ; 	
			}
			else {
				format(line_string, sizeof line_string, ""colwhi"[%d] %s(%d)\t"collime"$%d\n", 
				veh_point, VehicleNames[VehicleInfo[vehicleid][vModel]-400], VehicleInfo[vehicleid][vModel]
				) ; 
			}
			strcat(t_string, line_string);
			ShowPlayerDialog(playerid, D_FRACTION_FUNC_14, DIALOG_STYLE_TABLIST, ""colserver"Респавн фракционных машин", t_string, "Выбрать", "Назад");
			}
			return 1 ;
		}
		for(new vehicleid = 0 ; vehicleid < S_VEHICLE_COUNT ; vehicleid ++)
		{
			if (!IsValidVehicle(vehicleid + 1)) continue;
			if (VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_FRACTION || VehicleInfo[vehicleid][vFraction] != pInfo[playerid][pMember]) continue ;
			if (IsVehicleOccupied ( vehicleid + 1 ) != -1) continue ;

			SetVehicleToRespawn ( vehicleid + 1 ) ;
		}
		SendClientMessage ( playerid, -1, "Весь незанятый транспорт был отбуксирован");
		callcmd::lpanel(playerid);

		FractionInfo[ pInfo[playerid][pMember] ][fMoney] -= count_v*1000 ;
		}
