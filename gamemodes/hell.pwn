	case D_ADMIN_FUNC_17:
	{
		if (!response) return 1;
		new aLicensesNames[6][32] = {"Водительские права","Лицензию на полеты","Лицензию на водный ТС","Лицензию на охоту","Лицензию на оружие","Лицензию на бизнес"};
		new lic_select = GetPVarInt(playerid,#selectAlic), param_id, string_[128];
            if (sscanf(inputtext, "u",param_id)) return ShowPlayerDialog(playerid, D_ADMIN_FUNC_17, DIALOG_STYLE_INPUT, "Выдать лицензию", "Введите ID того, кому вы хотите выдать лицензию", "Выдать", "Отмена");
            if (!PlayerInConnected(param_id)) return ShowPlayerDialog(playerid, D_ADMIN_FUNC_17, DIALOG_STYLE_INPUT, "Выдать лицензию", "Введите ID того, кому вы хотите выдать лицензию", "Выдать", "Отмена");
		switch(lic_select)
		{
		    case 0..4:
		    {
			if (pInfo[param_id][pLicense][lic_select] == 1) return SendClientMessage(playerid, COLOR_GREY, !"У этого игрока есть данная лицензию!");
			f(string_, "Вы выдали %s %s[%d].",aLicensesNames[lic_select],pInfo[param_id][pName], param_id);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, string_); 
			GivePlayerLicense(param_id, lic_select, 30); 
			f(string_, "Администратор %s выдал Вам %s",pInfo[playerid][pName],aLicensesNames[lic_select]);
			SendClientMessage(param_id, COLOR_LIGHTBLUE, string_);
		} 
		case 5:
		{
			GivePlayerLicense(param_id, DRIVE_LIC, 30, false);
			GivePlayerLicense(param_id, FLY_LIC, 30, false);
			GivePlayerLicense(param_id, BOAT_LIC, 30, false);
			GivePlayerLicense(param_id, FISH_LIC, 10, false);
			GivePlayerLicense(param_id, GUN_LIC, 30); // Тут сохраняем верхние 5
			f(string_, "Администратор %s выдал Вам комплект лицензий сроком на 30 суток",pInfo[playerid][pName]);
			SendClientMessage(param_id, COLOR_LIGHTBLUE, string_);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, !"Вы выдали комплект всех лицензий");
		}
		} 
		DeletePVar(playerid,#selectAlic);
		return 1;
	}
