	case D_ATM_FUNC_1:
	{
		if (!response) return ShowBankDialog(playerid, pTemp[playerid][tSelectATMID]);
		new 
                A_IDX = pTemp[playerid][tSelectATMID],
		amount = strval(inputtext);
		if (amount < 1 || amount > 5_000_000) { 
		format(t_string, sizeof t_string, 
			"\n"colwhi"Введите сумму которую хотите положить на счёт:\n\
			"col_li_red"Внимание: "colwhi"Комиссия за перевод: "C_PODS"%.1f%%\n\n",
			ATMInfo[A_IDX][aCommission]
		);
		ShowPlayerDialog(playerid, D_ATM_FUNC_1, DIALOG_STYLE_INPUT, ""colserver"ATM: "colwhi"Пополнить счёт", t_string, "Выбрать", "Назад"), t_string[0] = EOS;
		SendClientMessage(playerid, COLOR_GREY, !"Сумма не может быть меньше $1 и больше 5.000.000"); 
		return 1;
		}
		if (amount <= 0) return SendClientMessage(playerid, COLOR_GREY, !"Неверное кол-во");
		new
		percent = floatround(amount/100*ATMInfo[A_IDX][aCommission]);
		if (kLibGetPlayerMoney(playerid) < (amount+percent)) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько денег"); 
		kLibGivePlayerMoney(playerid, -(amount+percent), "пополнил банкомат");
		pInfo[playerid][pBank] += amount;
		ATMInfo[A_IDX][aTotalCash] += percent;
		SavePlayerInteger(playerid, "pBank", pInfo[playerid][pBank]);
		new
