	case D_RENT_TRUCKER_0:
	{
		if (response)
		{
		new V_IDX = GetPlayerVehicleID(playerid);
		if (VehicleInfo[ V_IDX - 1 ][vType] == VEHICLE_TYPE_JOB
			&& (VehicleInfo[ V_IDX - 1 ][vFraction] == PLAYER_JOB_TRUCKER && VehicleInfo[ V_IDX - 1 ] [vSubFraction] == TRUCKER_SKILL_0))
		{
			if (pInfo[playerid][pDLevel] >= 0)
			{
			if (kLibGetPlayerMoney(playerid) < 2500)
			{
				SendClientMessage(playerid, COLOR_WHITE, !"Недостаточно денег");
				RemovePlayerFromVehicle(playerid);
				return 1;
			} 
			kLibGivePlayerMoney(playerid, -2500, "аренда трака 1");
			SetMoveCashServer(OUT_SERVER, 2500);  
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Чтобы открыть/закрыть арендованный транспорт введите: "colserver"\"/rlock\""); 
			
			VehicleInfo[ V_IDX - 1 ][ id_arender_truck ] = playerid;
			pTemp[ playerid ][ id_arended_truck ] = V_IDX; 
			}
			return 1;
		}
		else if (VehicleInfo[ V_IDX - 1 ][vType] == VEHICLE_TYPE_JOB
			&& (VehicleInfo[ V_IDX - 1 ][vFraction] == PLAYER_JOB_TRUCKER && VehicleInfo[ V_IDX - 1 ] [vSubFraction] == TRUCKER_SKILL_1))
		{ 
			if (pInfo[playerid][pDLevel] >= 25) {
			if (kLibGetPlayerMoney(playerid) < 5000) {
				SendClientMessage(playerid, COLOR_WHITE, !"Недостаточно денег");
				RemovePlayerFromVehicle(playerid); 
				return 1;
			}

			kLibGivePlayerMoney(playerid, -5000, "аренда трака 2");
			SetMoveCashServer(OUT_SERVER, 5000);
			SendClientMessage(playerid, COLOR_WHITE, !"Вы начали работу! Покупайте и отвозите грузы!"); 
			VehicleInfo[ V_IDX - 1 ][ id_arender_truck ] = playerid;
			pTemp[ playerid ][ id_arended_truck ] = V_IDX; 
			}
			else {
			SendClientMessage(playerid, COLOR_WHITE, !"Этот грузовик 25 уровня Дальнобойщика!");
			RemovePlayerFromVehicle(playerid);
			}
			return 1;
		}
		return 1;
		}
		else
		{
		RemovePlayerFromVehicle(playerid);
		TogglePlayerControllable(playerid, 1);
		return 1;
		}
	}
