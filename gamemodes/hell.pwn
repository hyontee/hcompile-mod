		case D_PLAYER_HUNTER_0: {
			if (!response) {
				return 1;
			}

			/*
			0Ж
			- Выдать нож, записать слот
			- Сделать Таймер для входа в зону
			1:
			- Продажа лицухи на 7 дней
			2:
			- Продажа Рифлы

			*/
			switch(listitem) {
				case 0: {//Начать/ Завершить
					if (!pTemp[playerid][tJobHunter])
					{
						if (pInfo[playerid][pLicense][3] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет лицензии на охоту!");
						if (pTemp[playerid][tJobHunter]) return SendClientMessage(playerid, COLOR_GREY, !"Вы уже работаете охотником!");
						pTemp[playerid][tJobHunter] = true;
						pTemp[playerid][tSalaryJob][0] =
						pTemp[playerid][tSalaryJob][1] = 0;
						SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Отправляйтесь в заповедник, где разрешена охота на оленей");
						SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Вам выдан нож, для разделки мяса");
						GivePlayerWeapon(playerid, 4, 1);
						MeAction(playerid, "устроился(ась) на работу", SELECT_ACTION_IN_BUBBLE);
					} else {
						if (!pTemp[playerid][tJobHunter]) return SendClientMessage(playerid, COLOR_GREY, !"Вы не работаете охотником!");
						pTemp[playerid][tJobHunter] = false;
						new salary = pTemp[playerid][tSalaryJob][0]*SALARY_HUNTER_JOB,
							salary_ = pTemp[playerid][tSalaryJob][1]*SALARY_HUNTER_MEET_JOB,
							string_[128];
						salary = GetVipBoostMaxPlayerValue(playerid, vPercentSalary, bPercentSalary, salary);
						salary_ = GetVipBoostMaxPlayerValue(playerid, vPercentSalary, bPercentSalary, salary_);
						SetMoveCashServer(IN_JOB, (salary+salary_));

						format(string_, sizeof string_, "Вы убили оленей: "colserver"%d"colwhi" и заработали "collime"$%d",
							pTemp[playerid][tSalaryJob][0], salary
						);
						SendClientMessage(playerid, COLOR_WHITE, string_);
						format(string_, sizeof string_, "Вы обработали мяса: "colserver"%d"colwhi" и заработали "collime"$%d",
							pTemp[playerid][tSalaryJob][1], salary_
						);
						SendClientMessage(playerid, COLOR_WHITE, string_);
						SendClientMessage(playerid, COLOR_GREEN, !"Рабочий день окончен, заработанные деньги вы получили на руки");
						kLibGivePlayerMoney(playerid, (salary+salary_), "зп за охоту");
						pTemp[playerid][tSalaryJob][0] =
						pTemp[playerid][tSalaryJob][1] = 0;
						ResetPlayerWeapons(playerid);
						MeAction(playerid, "уволился(ась) с работы", SELECT_ACTION_IN_BUBBLE);
					}
				}
				case 1: {//ЛИЦ
					if (pInfo[playerid][pLicense][FISH_LIC]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас есть лицензии на охоту!");
					if (kLibGetPlayerMoney(playerid) < COST_HUNTER_LICENSESS) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько денег");
					GivePlayerLicense(playerid, FISH_LIC, 7, true);
					kLibGivePlayerMoney(playerid, -COST_HUNTER_LICENSESS, "Lic Hunter");
					SendClientMessage(playerid, COLOR_GREEN, !"Вы приобрели лицензию на охоту сроком на 7 дней!");
				}
				case 2: {//Rifle
					if (pInfo[playerid][pLevel] < 3) return SendClientMessage(playerid, COLOR_GREY, !"Доступно с 3 уровня");
					if (!pTemp[playerid][tJobHunter]) return SendClientMessage(playerid, COLOR_GREY, !"Вы не работаете охотником!");
					if (pInfo[playerid][pLicense][GUN_LIC] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет лицензии на оружие!");
					if (kLibGetPlayerMoney(playerid) < MediumCost(BUSINESS_TYPE_AMMO, 1)) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько денег");
					GivePlayerWeapon(playerid, 33, 20);
					kLibGivePlayerMoney(playerid, -MediumCost(BUSINESS_TYPE_AMMO, 1), "Lic Hunter");
					SendClientMessage(playerid, COLOR_GREEN, !"Вы приобрели Rifle 20 патрон!");
				}
				case 3: {
					format(t_string, sizeof t_string,
