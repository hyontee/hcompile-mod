	case D_SAFE_FAMILY_4:
	{
		if (!response) return 1;
		new value = strval(inputtext);
		new h = pTemp[playerid][tCurrentHouseID];
		if (pTemp[playerid][tCurrentHouseID] == -1) {
		DeletePVar(playerid, "GunSafeListitem");
		SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка");
		return 1;
		}
		new slotid = GetPVarInt(playerid, "GunSafeListitem");
		if (value > HouseInfo[h][hSafeAmmo][slotid] || value <= 0) {
		SendClientMessage(playerid, -1, "В данном слоте нет столько патронов!"); 
		ShowPlayerDialog(playerid, D_SAFE_FAMILY_4, DIALOG_STYLE_INPUT, "Взять оружие", "Введите количество патронов:", "Ввести", "Отмена");
		return 1;
		}
		GivePlayerWeapon(playerid, HouseInfo[h][hSafeGun][slotid], value);
		new str[128], gunname[32];
		GetWeaponName(HouseInfo[h][hSafeGun][slotid], gunname, 32);
		format(str, sizeof(str), "Вы взяли со слота №%d %s. Количество патронов: %d.", slotid + 1, gunname, value);
		scm(playerid, COLOR_YELLOW, str);
		if (HouseInfo[h][hSafeAmmo][slotid] - value <= 0)
		{
		HouseInfo[h][hSafeAmmo][slotid] = 0;
		HouseInfo[h][hSafeGun][slotid] = 0;
		}
		else HouseInfo[h][hSafeAmmo][slotid] -= value;
		UpdateHouseSafe(h);
		DeletePVar(playerid, "GunSafeListitem");
		return 1;
	}
