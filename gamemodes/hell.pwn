			format(betType, sizeof (betType), "{DC143C}%d", pTemp[playerid][tCasinoRouletteChipsPos]);
		}
		case 2, 4, 6, 8, 10, 11, 13, 15, 17, 20, 22, 24, 26, 28, 29, 31, 33, 35: {
			format(betType, sizeof (betType), "{2E2E2E}%d", pTemp[playerid][tCasinoRouletteChipsPos]);
		}
		case 38: betType = "{DC143C}красное";
		case 37: betType = "{2E2E2E}черное";
		case 39: betType = "1-е 12";
		case 40: betType = "2-е 12";
		case 41: betType = "3-е 12";
		case 42: betType = "1 - 18";
		case 43: betType = "19 - 36";
		case 44: betType = "четное";
		case 45: betType = "нечетное";
		case 46: betType = "1-я линия";
		case 47: betType = "2-я линия";
		case 48: betType = "3-я линия";
		default: return true;
		}
