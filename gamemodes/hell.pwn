      		SaveFractionString(listitem+1, "fLeader", pInfo[target_id][pName]);

		SendMes(target_id, 0x6BB3FFAA, "Администратор %s[%d] назначил вас контролировать организацию %s", pInfo[playerid][pName], playerid,  fInfo[listitem+1][fName]);
		SendClientMessage(target_id, 0x6BB3FFAA, !"Рабочий день начат");
