    		gFracionSkinLeaderW[] = {76, 141, 191, 219, 214, 169, 150, 21, 211, 76, 172, 195, 190, 214, 56, 211, 41, 226, 191, 211, 74, 219, 219, 298, 298, 298},
    		t_gen = pInfo[target_id][pSex] == 1 ? 0 : 1,

