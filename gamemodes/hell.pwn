		return SendClientMessage(playerid, CGRAY2, !"[Диспетчер] С вами плохая связь, возможно вам нужно выйти из здания");
		}
		if (Iter_Count(JobTaxi) == 0) {
		SendClientMessage(playerid, COLOR_GREY, !"В данный момент нет таксистов на дежурстве!");
		SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
		return 1;
		}
		if (strlen(inputtext) < 3) {
   		ShowPlayerDialog(playerid, D_SELECT_SERVICE_3, DIALOG_STYLE_INPUT, "Вызов такси", ""colwhi"Вы позвонили в городской таксопарк.\nКратко опишите где вы сейчас находитесь:", !"Вызов", !"Отмена");
		    return SendClientMessage(playerid, COLOR_GREY, !"Ваше сообщение слишком короткое!");
		}
		new id_t = pTemp[playerid][pTaxiDriver];
		if (id_t != INVALID_PLAYER_ID && IsPlayerConnected(id_t)) {
		return SendClientMessage(playerid, CGRAY2, !"Вы уже заказали такси. Для отмены используйте \"/cancel\"");
		}
		else pTemp[playerid][pTaxiDriver] = INVALID_PLAYER_ID;

		new str_call_taxi[50];
		strcat(str_call_taxi,inputtext);
		FindSpecifiersInString(str_call_taxi);
		new
		Float: x,
		Float: y,
		Float: z;
		GetPlayerPos(playerid, x, y, z); 
		new 
		string_[144], taxi_beside = 0; 
		foreach(new i: JobTaxi)
		{
		new 
			V_IDX = GetPlayerVehicleID(i);
		if (VehicleInfo[ V_IDX - 1 ][vType] == VEHICLE_TYPE_JOB && VehicleInfo[ V_IDX - 1 ][vFraction] == PLAYER_JOB_TAXI) {
			new Float: fDistance = GetPlayerDistanceFromPoint(i,x,y,z);
			if(fDistance < 1400.0) {
			format(string_, sizeof string_, "%s вызывает такси в Вашем районе. Сообщение: \"%s\"", pInfo[playerid][pName], str_call_taxi);
			SendClientMessage(i, COLOR_YELLOW, string_);
			format(string_, 115, "Расстояние до клиента: {9966FF}%0.2f{FFFFFF}. Введите {FBD428}\"/to %d\" {FFFFFF}что бы принять вызов",fDistance,playerid);
			SendClientMessage(i, COLOR_WHITE, string_);
			taxi_beside++;
			}
		} 
		}
		if (taxi_beside == 0) return SendClientMessage(playerid, CGRAY2, !"[Диспетчер] В вашем районе нет таксистов");
		SetPVarInt(playerid, !"call_taxi", 1);
		SendClientMessage(playerid,COLOR_BLUE, !"[Диспетчер] Подождите пока примут Ваш вызов...");
		format(string_,sizeof string_,"[Диспетчер] Всего таксистов в вашем районе: {9966FF}%d", taxi_beside);
		SendClientMessage(playerid, COLOR_WHITE, string_);
		return 1;
	    }
