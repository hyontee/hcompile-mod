		case 4:
		{ 
			static const listRulesOne[] = "1. Игровой процесс.\n\
			Запрещено:\n\
			- Использование любого софта, дающего преимущество над другими игроками.\n\
			- Использование и злоупотребление ошибками, багами мода.\n\
			- Использование клавиши ESC в целях ухода от погони / смерти.\n\
			- Убийство игроков на спавне (место возрождения, базы организаций).\n\
			- Убийство игроков при помощи транспорта (давить, наносить урон с помощью кара, стрелять с водительского места).\n\
			- Убийство / нанесение физического вреда игрокам без веской для этого причины.\n\
			- Злоупотребление игровыми возможностями, дабы создать неудобства для аудитории сервера.\n\
			2. Ник в игре:\n\
			- Ник должен соответствовать следующему формату: Nick_Name.\n\
			- Cменить ник можно через /mm > Настройки > Смена NonRp ника.\n\
			- Одобрение смены ника со стороны администрации произойдёт лишь в том случае, если ваш ник не соответствует вышеуказанному формату.\n\
			Запрещено:\n\
			- Использование чужих, либо кем-то занятых ников.\n\
			- Использование ников, содержащих нецензурную лексику, оскорбительные слова.\n\
			- Флуд в заявку на смену ника (один запрос в час. Исключение: просьба администрации).\n\
			- Если вам отказали в смене ника и вы не согласны с вердиктом администрации - пишите жалобу через специальный раздел на форуме проекта.\n";	
			ShowPlayerDialog(playerid, D_MAINMENU_FUNC_5, DIALOG_STYLE_MSGBOX, ""colserver"Правила: "colwhi"Сервера", listRulesOne, "Согласен", "Выйти");
			return 1;
		}
		case 5:
		{
		    new string_[100];
		    if (GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, !"Нельзя вызывать сервисы в здании!");
			format(string_, sizeof(string_), "%s достает телефон",pInfo[playerid][pName]);
			SendBeside(playerid, COLOR_PURPLE, string_, 30.0);
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
			ShowPlayerDialog(playerid, D_SELECT_SERVICE_0, DIALOG_STYLE_LIST, ""colserver"Выберите сервис", "[1] Полиция \n[2] Скорая помощь \n[3] Таксопарк\n[4] Автомастерская", "Выбор", "Отмена");
		}
		case 6: {
