				SendClientMessage(playerid, COLOR_YELLOW, string_);
			} else {
				pInfo[playerid][pChar][listitem] = GetPlayerSkin(playerid);
				format(string_, sizeof string_, "[Подсказка] "colwhi"Вы заменили одежду (№%d), на (№%d)", old_skin, pInfo[playerid][pChar][listitem]);
				SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
			PressedPickup[playerid] = BusinessInfo[id][bBuyPickup];

			SetPlayerPosAC(playerid,
				BusinessInteriorInfo[interior_id][bIntMenuPos][0],
				BusinessInteriorInfo[interior_id][bIntMenuPos][1],
				BusinessInteriorInfo[interior_id][bIntMenuPos][2], BusinessInfo[id][bWorld],
				BusinessInteriorInfo[interior_id][bIntInterior]
			);
			SetPlayerFacingAngle(playerid, 0.000);

			TogglePlayerControllable(playerid, true);
			SetCameraBehindPlayer(playerid);

			SendClientMessage(playerid, COLOR_BLUE, !"[Продавец] "colwhi"Спасибо за покупку. Вы сделали хороший выбор!");
			PlayerTextDrawHide(playerid, sk_info_text[playerid]);
			for(new t = 0; t < sizeof (SkinShopMenu); t++) {
				TextDrawHideForPlayer(playerid, SkinShopMenu[t]);
			}
			pTemp[playerid][tSelectSkinShop] = -1;
			SetCameraBehindPlayer(playerid);
			TogglePlayerControllable(playerid, 1);
			CancelSelectTextDraw(playerid);

			save_player_skins(playerid);

			OnPlayerQuestProgress(playerid, QUEST_GUEST, QUEST_TASK_VICTIM);
			return 1;
		}
	case D_SELECT_SUSPECT: {
		if (!response) {
		callcmd::editsu(playerid);
		return true;
		}
		//printf("3 pTempSuID %d", pTemp[playerid][pEditSuspectID]);
		switch (listitem) {
		case 0: { // (reason)
			format(t_string, sizeof (t_string), "\
			Введите новую причину наказания:\n\n\
			\tТекущая причина: %s\n\
			\tТекущий уровень розыска: %d",
			pTemp[playerid][pEditSuspectReason], 
			pTemp[playerid][pEditSuspectLevel]
			);
			ShowPlayerDialog(playerid, D_EDIT_SUSPECT_REASON, DIALOG_STYLE_INPUT, ""colserver"Изменение: "colwhi"Наказания", t_string, "Принять", "Отмена");
		}
		case 1: { // (level)
			format(t_string, sizeof (t_string), "\
			Введите новый уровень розыска наказания (1 - 6):\n\n\
			\tТекущая причина: %s\n\
			\tТекущий уровень розыска: %d",
			pTemp[playerid][pEditSuspectReason], 
			pTemp[playerid][pEditSuspectLevel]
			);
			ShowPlayerDialog(playerid, D_EDIT_SUSPECT_LEVEL, DIALOG_STYLE_INPUT, ""colserver"Изменение: "colwhi"Наказания", t_string, "Принять", "Отмена");
		}
		case 2: {
			new query_[64];
			format(query_, sizeof query_, "DELETE FROM `s_suspect` WHERE `id` = '%d'", pTemp[playerid][pEditSuspectID]);
			mysql_tquery(dbHandle, query_);
			//print(query_);
			SendClientMessage(playerid, -1, !"Удалено!");
		}
		}
		t_string[0] = EOS;
		return true;
	}
	case D_EDIT_SUSPECT_REASON: {
		if (!response) {
		callcmd::editsu(playerid);
		return true;
		}
		if (!(3 <= strlen(inputtext) < 32)) {
		format(t_string, sizeof (t_string), "\
			Введите новую причину наказания:\n\n\
			\tТекущая причина: %s\n\
			\tТекущий уровень розыска: %d",
			pTemp[playerid][pEditSuspectReason], 
			pTemp[playerid][pEditSuspectLevel]
		);
		ShowPlayerDialog(playerid, D_EDIT_SUSPECT_REASON, DIALOG_STYLE_INPUT, ""colserver"Изменение: "colwhi"Наказания", t_string, "Принять", "Отмена");
		t_string[0] = EOS;
		return true;
		}
		format(pTemp[playerid][pEditSuspectReason], 32, inputtext);

		new query_[128];
		mysql_format(dbHandle, query_, sizeof query_, "UPDATE `s_suspect` SET suspectReason = '%e' WHERE id = %d", 
		pTemp[playerid][pEditSuspectReason],
		pTemp[playerid][pEditSuspectID]
		);
		mysql_tquery(dbHandle, query_, "", "");
		callcmd::editsu(playerid);
		SendClientMessage(playerid, -1, !"Вы успешно изменили параметры наказания.");
		return true;
	}
	case D_EDIT_SUSPECT_LEVEL: {
		if (!response) {
		callcmd::editsu(playerid);
		return true;
		}
		new level = strval(inputtext);
		if (!(1 <= level <= 6)) {
		format(t_string, sizeof (t_string), "\
			Введите новый уровень розыска наказания (1 - 6):\n\n\
			\tТекущая причина: %s\n\
			\tТекущий уровень розыска: %d",
			pTemp[playerid][pEditSuspectReason], 
			pTemp[playerid][pEditSuspectLevel]
		);
		ShowPlayerDialog(playerid, D_EDIT_SUSPECT_LEVEL, DIALOG_STYLE_INPUT, ""colserver"Изменение: "colwhi"Наказания", t_string, "Принять", "Отмена");
		t_string[0] = EOS;
		return true;
		}
		pTemp[playerid][pEditSuspectLevel] = level;

		new query_[128];
		format(query_, sizeof (query_), "UPDATE `s_suspect` SET wantedLevel = '%d' WHERE id = %d", 
		pTemp[playerid][pEditSuspectLevel],
		pTemp[playerid][pEditSuspectID]
		);
		mysql_tquery(dbHandle, query_, "", "");
		callcmd::editsu(playerid);
		SendClientMessage(playerid, -1, !"Вы успешно изменили параметры наказания.");
		return true;
	}
