			if (!pInfo[i][pLogin] || AntiCheatIsKickedWithDesync(i)) continue;
			if (!pTemp[i][tDMArea][0]) continue;
			if (pTemp[i][tDMArea][3] == pTemp[playerid][tDMArea][3])
			{
				SendClientMessage(i, -1, string_);
			} 
			}
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Для выхода из DM-Арены,используйте: "colserver"\"/dmexit\""); 
			ResetPlayerWeapons(playerid);
			GivePlayerWeapon(playerid, DM_ArenaGun[0], 1000);
			new rand = random(sizeof(DM_Arena_ThreeSpawnPos));
			SetPlayerPosAC(playerid, DM_Arena_ThreeSpawnPos[rand][0], DM_Arena_ThreeSpawnPos[rand][1], DM_Arena_ThreeSpawnPos[rand][2], 1, AIM_DEAGLE_DM);
			SetPlayerFacingAngle(playerid, DM_Arena_ThreeSpawnPos[rand][3]);		
			SetPlayerHealth(playerid, 160.0);
			SetPlayerColor(playerid, 0x56FB4EFF);
			format(string_, sizeof string_,
			"{1bd12f}Убийств:{ffffff}%d\n{1bd12f}Смертей:{ffffff}%d",
			pTemp[playerid][tDMArea][1], pTemp[playerid][tDMArea][2]
			);
			if (pTemp[playerid][tDMLabel]) {
			DestroyDynamic3DTextLabel(pTemp[playerid][tDMLabel]);
			pTemp[playerid][tDMLabel] = Text3D:0;
			}
			pTemp[playerid][tDMLabel] = CreateDynamic3DTextLabel(string_, 0xFF6347FF, 0,0,0.4,10.0,playerid,INVALID_VEHICLE_ID,1,-1,-1,-1,10);
		} 
		} 
	}
