	return false;
}
public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{  
    if (pInfo[playerid][pLogin] == 0) return 1;
	#if defined _items_inc
	if (items_OnPlayerClickPTD(playerid, playertextid)) return true;
	#endif
	#if defined _voting_inc
	if (voting_OnPlayerClickPlayerTD(playerid, playertextid)) return true;
	#endif
	#if defined _poker_included
	if (poker_OnPlayerClickPTextDraw(playerid, playertextid)) return true;
	#endif
	t_string[0] = EOS;
	if (SpecAd[playerid] != INVALID_PLAYER_ID &&  pInfo[playerid][pAdmin] > 1)
	{
	    if (ReconPlayer[playerid][7] == playertextid) return ShowPlayerDialog(playerid, D_ADMIN_FUNC_0, 1, "Ид игрока ", "Введите ид игрока", "Готово", "Отмена");
        else if (ReconPlayer[playerid][8] == playertextid)
        {
            DisableEnableReconButton(playerid, ReconSelect[playerid], false);
            for(new i = 16; i < 34; i++) PlayerTextDrawHide(playerid, ReconPlayer[playerid][i]);
            for(new i = 16; i < 20; i++) PlayerTextDrawShow(playerid, ReconPlayer[playerid][i]);
    	ReconBounds[playerid][0] = 16;
    	ReconBounds[playerid][1] = 19;
    	ReconSelectSub[playerid] = ReconBounds[playerid][0];
    	DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
        }
        else if (ReconPlayer[playerid][9] == playertextid)
        {
            DisableEnableReconButton(playerid, ReconSelect[playerid], false);
            for(new i = 16; i < 34; i++) PlayerTextDrawHide(playerid, ReconPlayer[playerid][i]);
            for(new i = 20; i < 25; i++) PlayerTextDrawShow(playerid, ReconPlayer[playerid][i]);
    	ReconBounds[playerid][0] = 20;
    	ReconBounds[playerid][1] = 24;
    	ReconSelectSub[playerid] = ReconBounds[playerid][0];
    	DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
        }
        else if (ReconPlayer[playerid][10] == playertextid)
        {
            DisableEnableReconButton(playerid, ReconSelect[playerid], false);
            for(new i = 16; i < 34; i++) PlayerTextDrawHide(playerid, ReconPlayer[playerid][i]);
		PlayerTextDrawShow(playerid, ReconPlayer[playerid][25]);
		PlayerTextDrawShow(playerid, ReconPlayer[playerid][26]);
		ReconBounds[playerid][0] = 25;
    	ReconBounds[playerid][1] = 26;
    	ReconSelectSub[playerid] = ReconBounds[playerid][0];
    	DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
        }
        else if (ReconPlayer[playerid][12] == playertextid)
        {
            DisableEnableReconButton(playerid, ReconSelect[playerid], false);
            for(new i = 16; i < 34; i++) PlayerTextDrawHide(playerid, ReconPlayer[playerid][i]);
            for(new i = 27; i < 30; i++) PlayerTextDrawShow(playerid, ReconPlayer[playerid][i]);
    	ReconBounds[playerid][0] = 27;
    	ReconBounds[playerid][1] = 29;
    	ReconSelectSub[playerid] = ReconBounds[playerid][0];
    	DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
        }
        else if (ReconPlayer[playerid][13] == playertextid)
        {
            DisableEnableReconButton(playerid, ReconSelect[playerid], false);
            for(new i = 16; i < 34; i++) PlayerTextDrawHide(playerid, ReconPlayer[playerid][i]);
            for(new i = 30; i < 34; i++) PlayerTextDrawShow(playerid, ReconPlayer[playerid][i]);
    	ReconBounds[playerid][0] = 30;
    	ReconBounds[playerid][1] = 33;
    	ReconSelectSub[playerid] = ReconBounds[playerid][0];
    	DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
        }
	else if (ReconPlayer[playerid][11] == playertextid)
	{
		SubTextDelete(playerid);
		SendClientMessage(playerid, COLOR_GREY, !"PUSTO 11");
		ShowPlayerDialog(playerid, D_ADMIN_FUNC_5, 1,"Причина","'             Введите причину             '","Готово","Отмена");
		return 1;
	}
  	else if (ReconPlayer[playerid][14] == playertextid)
  	{
	  	SubTextDelete(playerid);
	  	StartSpectate(playerid, SpecAd[playerid]);
	  	return 1;
	 	}
	else if (ReconPlayer[playerid][15] == playertextid)
	{
		SubTextDelete(playerid);
		StopSpectate(playerid);
		return 1;
	}
	else if (ReconPlayer[playerid][16] == playertextid)
	{
		new Float:boomx, Float:boomy, Float:boomz;
		//SendClientMessage(playerid, COLOR_GREY, !"PUSTO 16");
		GetPlayerPos(SpecAd[playerid],boomx, boomy, boomz);
		return CreateExplosion(boomx, boomy , boomz-8.9, 5, 0.5);
	}
	else if (ReconPlayer[playerid][17] == playertextid)
	{
	    SetPlayerHealth(SpecAd[playerid], GetPlayerHP(SpecAd[playerid]) - 10.0);
		return 1;
	}
	else if (ReconPlayer[playerid][18] == playertextid)
	{
	    new Float: hp;
	    //SendClientMessage(playerid, COLOR_GREY, !"PUSTO 18");
	    GetVehicleHealth(GetPlayerVehicleID(SpecAd[playerid]), hp);
		_SetVehicleHealth(GetPlayerVehicleID(SpecAd[playerid]), hp-10.0);
		return 1;
	}
	else if (ReconPlayer[playerid][19] == playertextid)
	{
	    pSpecture[SpecAd[playerid]][sShout][1] = 0;
	    pSpecture[SpecAd[playerid]][sShout][3] = 0;
	}
	else if (ReconPlayer[playerid][20] == playertextid)
	{
	    if (pInfo[playerid][pAdmin] < 1 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
		if (pInfo[SpecAd[playerid]][pMuted] > 0)
		{
		pInfo[SpecAd[playerid]][pMuted] = 0;
		SendMesAll(COLOR_LIGHTRED, "Администратор %s снял бан чата у %s",pInfo[playerid][pName], pInfo[SpecAd[playerid]][pName]);
		return 1;
		}
		pInfo[SpecAd[playerid]][pMuted] = 5*60;
		SendMesAll(COLOR_LIGHTRED, "Администратор: %s выдал бан чата игроку %s.",pInfo[playerid][pName],pInfo[SpecAd[playerid]][pName]);
		SendClientMessage(SpecAd[playerid], COLOR_WHITE, !"Вам дали бан чата!");
		return 1;
	}
	else if (ReconPlayer[playerid][21] == playertextid)
	{
	    if (pInfo[playerid][pAdmin] < 3 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
		new Float:slx, Float:sly, Float:slz;
		SetPlayerHealth(SpecAd[playerid], GetPlayerHP(SpecAd[playerid])-5);
		GetPlayerPos(SpecAd[playerid], slx, sly, slz);
		SetPlayerPosAC(SpecAd[playerid], slx, sly, slz+5);
		//SetPlayerPosAC(playerid, Float:x, Float:y, Float:z, world, interior, setUP = false)
		PlayerPlaySound(SpecAd[playerid], 1130, slx, sly, slz+5);
		format(t_string, sizeof t_string, "Админ: %s дал поджопник %s",pInfo[playerid][pName], pInfo[SpecAd[playerid]][pName]);
		ABroadCast(COLOR_LIGHTRED, t_string, 1);
		SendClientMessage(SpecAd[playerid], COLOR_LIGHTRED, t_string);
	    return 1;
	}
	else if (ReconPlayer[playerid][22] == playertextid)
	{
	    if (pInfo[playerid][pAdmin] < 2 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
	    if (!PlayerInConnected(SpecAd[playerid])) return 1;
		SendMes(playerid, COLOR_LIGHTRED,  "Вы поместили %s в форт ДеМорган на 60 минут", pInfo[SpecAd[playerid]][pName]);
		ResetPlayerWeapons(SpecAd[playerid]); 
		SetPlayerPosAC(SpecAd[playerid], 2.4973,803.3113,1033.0717, 10, MAD_HOUSE_INT);
		SetPlayerFacingAngle(SpecAd[playerid], 271.8828);
		pInfo[ SpecAd[playerid] ][pMestoJail] = 4; 
		pInfo[ SpecAd[playerid] ][pJailTime] = 3600;
		new 
		query_[128];
		format(query_,sizeof query_,
		"UPDATE s_users SET MadTime = MadTime + %d, pMestoJail = '%d' WHERE pID = '%d' LIMIT 1", pInfo[SpecAd[playerid]][pJailTime],
		pInfo[SpecAd[playerid]][pMestoJail], pInfo[SpecAd[playerid]][pID]
		);
		mysql_tquery(dbHandle, query_, "", ""), query_[0] = EOS;
		mysql_tquery (dbHandle, "SELECT `Name`,`MadTime` FROM `s_users` WHERE `MadTime` != 0 ORDER BY `MadTime` DESC LIMIT 5", "LoadTopMadHouse");
		return SendClientMessage(SpecAd[playerid], COLOR_LIGHTRED, !"Вы помещены в форт ДеМорган администратором на 60 минут");
	}
	else if (ReconPlayer[playerid][23] == playertextid)
	{
	    if (pInfo[playerid][pAdmin] < 3 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
		if (!pTemp[ SpecAd[playerid] ][tFreezePlayer]) {
		    format(t_string, sizeof t_string, "%s был заморожен администратором %s",pInfo[SpecAd[playerid]][pName],pInfo[playerid][pName]);
		    GameTextForPlayer(SpecAd[playerid], "~r~Freeze", 5000, 1);
		TogglePlayerControllable(SpecAd[playerid], 0);
		pTemp[ SpecAd[playerid] ][tFreezePlayer] = true;
		} else {
		    format(t_string, sizeof t_string, "%s был разаморожен администратором %s",pInfo[SpecAd[playerid]][pName],pInfo[playerid][pName]);
		    GameTextForPlayer(SpecAd[playerid], "~g~UnFreeze", 5000, 1);
		TogglePlayerControllable(SpecAd[playerid], 1);
		pTemp[ SpecAd[playerid] ][tFreezePlayer] = false;
		}
		ABroadCast(COLOR_LIGHTRED, t_string, 1);
		return 1;
	}
	else if (ReconPlayer[playerid][24] == playertextid)
	{
	    if (pInfo[playerid][pAdmin] < 3 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
		if (!pTemp[ SpecAd[playerid] ][tFreezePlayer]) {
		    format(t_string, sizeof t_string, "%s был заморожен администратором %s",pInfo[SpecAd[playerid]][pName],pInfo[playerid][pName]);
		    GameTextForPlayer(SpecAd[playerid], "~r~Freeze", 5000, 1);
		TogglePlayerControllable(SpecAd[playerid], 0);
		pTemp[ SpecAd[playerid] ][tFreezePlayer] = true;
		} else {
		    format(t_string, sizeof t_string, "%s был разаморожен администратором %s",pInfo[SpecAd[playerid]][pName],pInfo[playerid][pName]);
		    GameTextForPlayer(SpecAd[playerid], "~g~UnFreeze", 5000, 1);
		TogglePlayerControllable(SpecAd[playerid], 1);
		pTemp[ SpecAd[playerid] ][tFreezePlayer] = false;
		}
		ABroadCast(COLOR_LIGHTRED, t_string, 1);
		return 1;
	}
	else if (ReconPlayer[playerid][25] == playertextid)
	{
	    if (pInfo[playerid][pAdmin] < 4 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
	    SubTextDelete(playerid);
		StopSpectate(playerid);
	    if (pInfo[playerid][pAdmin] < pInfo[SpecAd[playerid]][pAdmin]) return SendClientMessage(playerid, COLOR_GREY, !"Нельзя использовать на администратора, который старше вас!");
	    if (0 == CheckBanedNickName(playerid, pInfo[SpecAd[playerid]][pName]) ) return 1;
		format(t_string, sizeof t_string, "[SKICK] %s[%d] тихо кикнул игрока %s[%d].", pInfo[playerid][pName], playerid, pInfo[SpecAd[playerid]][pName], SpecAd[playerid]);
		ABroadCast(COLOR_YELLOW, t_string, 1);
		Kick(SpecAd[playerid]);
	    return 1;
	}
	else if (ReconPlayer[playerid][26] == playertextid)
	{
		SubTextDelete(playerid);
		ShowPlayerDialog(playerid, D_ADMIN_FUNC_1, 1, "Обычный кик", "'\t\t\tВведите причину\t\t\t'", "Готово", "Отмена");
		return 1;
	}
	else if (ReconPlayer[playerid][27] == playertextid)
	{
		SubTextDelete(playerid);
		SendClientMessage(playerid, COLOR_GREY, !"PUSTO 27");
		ShowPlayerDialog(playerid, D_ADMIN_FUNC_2,DIALOG_STYLE_INPUT,"Причина","'\t\t\tВведите причину\t\t\t'","Готово","Отмена");
		return 1;
	}
  	else if (ReconPlayer[playerid][28] == playertextid)
  	{
	  	SubTextDelete(playerid);
	  	SendClientMessage(playerid, COLOR_GREY, !"PUSTO 28");
	  	ShowPlayerDialog(playerid, D_ADMIN_FUNC_3,DIALOG_STYLE_INPUT,"Причина","'             Введите причину             '","Готово","Отмена");
	  	return 1;
	}
  	else if (ReconPlayer[playerid][29] == playertextid)
  	{
	  	SubTextDelete(playerid);
	  	ShowPlayerDialog(playerid, D_ADMIN_FUNC_4,DIALOG_STYLE_INPUT,"Причина","'             Введите причину             '","Готово","Отмена");
	  	return 1;
	}
    	else if (ReconPlayer[playerid][30] == playertextid)
	{
	    SubTextDelete(playerid);
	    if (!IsPlayerConnected(SpecAd[playerid])) return 1;
		ShowStats(playerid, SpecAd[playerid]);
	    return 1;
	}
	else if (ReconPlayer[playerid][31] == playertextid)
	{
	    SubTextDelete(playerid);
	    if (pInfo[playerid][pAdmin] < 2 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
	    if (!PlayerInConnected(SpecAd[playerid])) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден!");
	    new Gun[13], Ammo[13];
	    GetPlayerWeaponData(SpecAd[playerid], 0, Gun[0], Ammo[0]);
	    GetPlayerWeaponData(SpecAd[playerid], 1, Gun[1], Ammo[1]);
	    GetPlayerWeaponData(SpecAd[playerid], 2, Gun[2], Ammo[2]);
	    GetPlayerWeaponData(SpecAd[playerid], 3, Gun[3], Ammo[3]);
	    GetPlayerWeaponData(SpecAd[playerid], 4, Gun[4], Ammo[4]);
	    GetPlayerWeaponData(SpecAd[playerid], 5, Gun[5], Ammo[5]);
	    GetPlayerWeaponData(SpecAd[playerid], 6, Gun[6], Ammo[6]);
	    GetPlayerWeaponData(SpecAd[playerid], 7, Gun[7], Ammo[7]);
	    GetPlayerWeaponData(SpecAd[playerid], 8, Gun[8], Ammo[8]);
	    GetPlayerWeaponData(SpecAd[playerid], 9, Gun[9], Ammo[9]);
	    GetPlayerWeaponData(SpecAd[playerid], 10, Gun[10], Ammo[10]);
	    GetPlayerWeaponData(SpecAd[playerid], 11, Gun[11], Ammo[11]);
	    GetPlayerWeaponData(SpecAd[playerid], 12, Gun[12], Ammo[12]);
	    format(t_string, sizeof t_string, "{ff00ff}State:   %s\n\n\
	            0: Ид оружия: %d    Патрон: %d\
	            \n1: Ид оружия: %d    Патрон: %d\
	            \n2: Ид оружия: %d    Патрон: %d\
	            \n3: Ид оружия: %d    Патрон: %d\
	            \n4: Ид оружия: %d    Патрон: %d\
	            \n5: Ид оружия: %d    Патрон: %d\
	            \n6: Ид оружия: %d    Патрон: %d\
	            \n7: Ид оружия: %d    Патрон: %d\
	            \n8: Ид оружия: %d    Патрон: %d\
	            \n9: Ид оружия: %d    Патрон: %d\
	            \n10: Ид оружия: %d    Патрон: %d\
	            \n11: Ид оружия: %d    Патрон: %d\
	            \n12: Ид оружия: %d    Патрон: %d"
	            , pInfo[SpecAd[playerid]][pName], Gun[0], Ammo[0], Gun[1], Ammo[1], Gun[2], Ammo[2], Gun[3], Ammo[3], Gun[4], Ammo[4], Gun[5], Ammo[5], Gun[6], Ammo[6], Gun[7], Ammo[7], Gun[8], Ammo[8], Gun[9], Ammo[9], Gun[10], Ammo[10], Gun[11], Ammo[11], Gun[12], Ammo[12]);
	    ShowPlayerDialog(playerid,D_NULL,DIALOG_STYLE_MSGBOX,"Информация оружия", t_string, "Готово","");
	    return 1;
	}
	else if (ReconPlayer[playerid][32] == playertextid)
	{
	    SubTextDelete(playerid);
	    if (pInfo[playerid][pAdmin] < 4 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
		if (!IsPlayerConnected(SpecAd[playerid])) return 1;
	    new ip[15];
		GetPlayerIp(SpecAd[playerid],ip, sizeof ip);
		SendMes(playerid, 0x6BB3FFAA,  "Nik [%s]   R-IP [%s]   L-IP [%s]   IP [%s]",pInfo[SpecAd[playerid]][pName], pInfo[SpecAd[playerid]][RegIP], pInfo[SpecAd[playerid]][LastIP], ip);
	    return 1;
	}
	else if (ReconPlayer[playerid][33] == playertextid)
	{
	    SubTextDelete(playerid);
	    SendClientMessage(playerid, COLOR_GREY, !"PUSTO 33");
	    return 1;
	} 
	}
	return 1;
}
public OnPlayerClickTextDraw(playerid, Text:clickedid)
{ 
	
	#if defined _items_inc
	if (items_OnPlayerClickTextDraw(playerid, clickedid)) return true;
	#endif
	#if defined _voting_inc
	if (voting_OnPlayerClickTextDraw(playerid, clickedid)) return true;
	#endif
	#if defined _poker_included
	if (poker_OnPlayerClickTextDraw(playerid, clickedid)) return true;
	#endif
	#if defined _blackjack_included
	if (blackjack_OnPlayerClickTextDraw(playerid, clickedid)) return true;
	#endif
	#if defined _businesses_inc
	// if(clickedid == TDEditor_TD[52])
	// {
	// ShowPlayerDialog(playerid, 7777, DIALOG_STYLE_INPUT, "Репорт", "Введите ID и суть жалобы!","Отправить", "");
	// return true;
	// }

    if(clickedid == Text:INVALID_TEXT_DRAW)
    {
        if(stall_menu[playerid] == true) return HideMenuStall(playerid);
    }
	if(clickedid == food_TD[6]) //cola
	{	
		GivePlayerSatiety(playerid, 1000);
		ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.0, 0, 0, 0, 0, 0, 1);
		MeAction(playerid, "перекусил(а) у лавки", SELECT_ACTION_IN_BUBBLE);
		
		HideMenuStall(playerid);
	}
	else if(clickedid == food_TD[7]) //hotdog
	{
		GivePlayerSatiety(playerid, 1000);
		ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.0, 0, 0, 0, 0, 0, 1);
		MeAction(playerid, "перекусил(а) у лавки", SELECT_ACTION_IN_BUBBLE);		

		HideMenuStall(playerid);
	}
	else if(clickedid == food_TD[8]) //sprite
	{
		GivePlayerSatiety(playerid, 1000);
		ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.0, 0, 0, 0, 0, 0, 1);
		MeAction(playerid, "перекусил(а) у лавки", SELECT_ACTION_IN_BUBBLE);	

		HideMenuStall(playerid);	
	}		

	if (pTemp[playerid][tGasMenuShowed]) {
	
	if (clickedid == Text:INVALID_TEXT_DRAW) {
		HideMenuGas(playerid);
		return true;
	}
	if (clickedid == BusinessGAS_TD[6]) { // -
		pTemp[playerid][tGasMenuProgress] -= 10.0;
		if (pTemp[playerid][tGasMenuProgress] < 1.0) pTemp[playerid][tGasMenuProgress] = 1.0; 
		SetGasMenuProgressBar(playerid, pTemp[playerid][tGasMenuProgress]);
		return true;
	}
	else if (clickedid == BusinessGAS_TD[7]) { // +
		pTemp[playerid][tGasMenuProgress] += 10.0;
		if (pTemp[playerid][tGasMenuProgress] > 200.0) pTemp[playerid][tGasMenuProgress] = 200.0;
		SetGasMenuProgressBar(playerid, pTemp[playerid][tGasMenuProgress]);
		return true;
	}
	else if (clickedid == BusinessGAS_TD[10]) { // /fill buy
		new vehicleid = GetPlayerVehicleID(playerid);
		new amount = floatround(pTemp[playerid][tGasMenuProgress] - VehicleInfo[vehicleid - 1][vFuel]);

		BuyBusinessItem(playerid, 0, amount);
		HideMenuGas(playerid);
		return true;
	}
	}
	#endif
	#if defined _dice_game_inc
	if (bone_OnPlayerClickTextDraw(playerid, clickedid)) return true;
	#endif
    if (clickedid == Text:INVALID_TEXT_DRAW)
    {
        if (pTemp[playerid][tPlayerReg]) return SelectTextDraw(playerid, 0xFF4040AA);
        if (GetPVarInt(playerid, "tuning_opened")) return SelectTextDraw(playerid, 0xFF4040AA);
	//if (GetPVarInt(playerid, "BoneStol")) return SelectTextDraw(playerid, 0x33AAFFFF);
    }
	if (pTemp[playerid][tPlayerReg] == 1) //SetPVarInt(playerid,"Register", 1);
    {
        if (clickedid == SelectSkinTD[8])
		{
	  		ChangeSkin[playerid] = GetPVarInt(playerid,"skinid");
			ChangeSkin[playerid]--;
			if (ChangeSkin[playerid] < 0)
			{
	  			if (pInfo[playerid][pSex] == 1)
				{
	   				ChangeSkin[playerid] = 5;
				    SetPlayerSkinEx(playerid,BomjPedMale[ChangeSkin[playerid]]);
				}
				if (pInfo[playerid][pSex] == 2)
				{
	   				ChangeSkin[playerid] = 3;
				    SetPlayerSkinEx(playerid,BomjPedFeMale[ChangeSkin[playerid]]);
				}
			}
			if (pInfo[playerid][pSex] == 1) SetPlayerSkinEx(playerid,BomjPedMale[ChangeSkin[playerid]]);
			if (pInfo[playerid][pSex] == 2) SetPlayerSkinEx(playerid,BomjPedFeMale[ChangeSkin[playerid]]);
	  		SetPVarInt(playerid,"skinid",ChangeSkin[playerid]);
		}
		if (clickedid == SelectSkinTD[7])//SelectSkinTD[26]
		{
			ChangeSkin[playerid] = GetPVarInt(playerid,"skinid");
			ChangeSkin[playerid]++;
			if (pInfo[playerid][pSex] == 1)
			{
	  			if (ChangeSkin[playerid] >= 5) ChangeSkin[playerid] = 0;
		    	SetPlayerSkinEx(playerid,BomjPedMale[ChangeSkin[playerid]]);
			}
			if (pInfo[playerid][pSex] == 2)
			{
	  			if (ChangeSkin[playerid] >= 3) ChangeSkin[playerid] = 0;
		    	SetPlayerSkinEx(playerid,BomjPedFeMale[ChangeSkin[playerid]]);
			}
			SetPVarInt(playerid,"skinid",ChangeSkin[playerid]);
		}
		if (clickedid == SelectSkinTD[6])//SelectSkinTD[34]ChosePlayerSkin
		{
	 		GetPlayerIp(playerid, pInfo[playerid][RegIP], 16);
	 		new
			 	skinid = GetPlayerSkin(playerid),
			 	query_[512];

	   		pInfo[playerid][pChar][0] = skinid;
	   		pInfo[playerid][PlayerNumber] = 100000 + random(899999);
			if (AntiCheatGetDialog(playerid) != -1) {
				scmKick(playerid, "Вы были кикнуты по подозрению в читерстве (AC - D6)");
				printf("Call AntiCheatGetDialog(playerid) [Reg = 0] ID: %d | Kick D6", playerid);
				return 1;
			}
	   		if (pTemp[playerid][tPlayerCurrentID] == -1 && !player_mobile[playerid]) {
				scmKick(playerid, "Вы были кикнуты по подозрению в читерстве (AC - D5)");
				printf("Call SelectSkinTD[10] [Reg = 0] ID: %d | Kick D5", playerid);
				return 1;
			}
			mysql_format(dbHandle, query_, sizeof query_,
				"INSERT INTO `s_users` (`Name`, `pKey`, `pSex`, `DataReg`, `pIpReg`, `pDrug`, `pPnumber`, `pChars`) VALUES ('%s', md5(md5('%s')), '%d', '%d', '%s', '%s', '%d', '%d,0,0,0,0,0')",
				pInfo[playerid][pName], pInfo[playerid][pKey],
				pInfo[playerid][pSex], gettime(), pInfo[playerid][RegIP],
				pInfo[playerid][Referal], pInfo[playerid][PlayerNumber], pInfo[playerid][pChar][0]
			);
			mysql_tquery(dbHandle, query_, "player_register", "i", playerid);
			pTemp[playerid][tPlayerReg] = 0;
			SetPVarInt(playerid, #FirstSpawnPlayer, 1);
	        for(new i = 0; i < 29; i++)
				TextDrawHideForPlayer(playerid, SelectSkinTD[i]);
			CancelSelectTextDraw(playerid);
			return 1;
		}
		return 1;
    }
    if (pInfo[playerid][pLogin] == 0) return 1;
	//AutoSalon
    if (SpecAd[playerid] != INVALID_PLAYER_ID && pInfo[playerid][pAdmin] > 1)
    {
	    if (clickedid == Text:INVALID_TEXT_DRAW)
	    DisableEnableReconButton(playerid, ReconSelect[playerid], true);
	    return 1;
    }
    else if (pTemp[playerid][tSelectSkinShop] == 1) {
 		if (clickedid == Text:INVALID_TEXT_DRAW || clickedid == SkinShopMenu[13]) Hide_SkinShop(playerid);
		if (clickedid == SkinShopMenu[19]) { // (-)
			SetBusinessSkinPage(playerid, 1);
			return true;
		}
		if (clickedid == SkinShopMenu[15]) { // (+)
			SetBusinessSkinPage(playerid, 0);
			return true;
		}
		if (clickedid == SkinShopMenu[13]) {
			SendClientMessage(playerid, COLOR_BLUE, !"Продавец: "colwhi"Всего хорошего, приходите еще! * Жаль что Вы ничего не подобрали");
			TogglePlayerControllable(playerid, 1);
			new
				id = pTemp[playerid][tBusinessID],
				interior_id = BusinessInfo[id][bInteriorID];

			PressedPickup[playerid] = BusinessInfo[id][bBuyPickup];

			SetPlayerPosAC(playerid,
				BusinessInteriorInfo[interior_id][bIntMenuPos][0],
				BusinessInteriorInfo[interior_id][bIntMenuPos][1],
				BusinessInteriorInfo[interior_id][bIntMenuPos][2], BusinessInfo[id][bWorld],
				BusinessInteriorInfo[interior_id][bIntInterior]
			);
			SetPlayerFacingAngle(playerid, 0.000);
			SetCameraBehindPlayer(playerid);
			SetPlayerSkinEx(playerid, pInfo[playerid][pChar][0]);

			if (GetPlayerSkin(playerid) != pInfo[playerid][pChar][0]) {
				printf("%s(%d) использовал sobeit (NOP SetPlayerSkin)", pInfo[playerid][pName], playerid);
			}

			PlayerTextDrawHide(playerid, sk_info_text[playerid]);
			for(new t; t < sizeof (SkinShopMenu); t++) TextDrawHideForPlayer(playerid, SkinShopMenu[t]);
			pTemp[playerid][tSelectSkinShop] = -1;
			CancelSelectTextDraw(playerid);
			return 1;
		}
		if (clickedid == SkinShopMenu[8]) {
			new price = GetBusinessSkinPrice(playerid);
			if (kLibGetPlayerMoney(playerid) < price)  {
				SendClientMessage(playerid, COLOR_BLUE, !"Продавец: "colwhi"Данная одежда Вам не по карману!");
				return true;
			}
			new
				id = pTemp[playerid][tBusinessID],
				interior_id = BusinessInfo[id][bInteriorID];

			if (BusinessInfo[id][bProducts] < 10) {
				SendClientMessage(playerid, COLOR_GREY, !"Недостаточно продуктов!");
				return true;
			}
			if (!GetPlayerCountClothes(playerid)) {
				SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"У Вас заняты все слоты! Выберите, что хотите заменить.");
				t_string[0] = EOS;
				for(new j = 0, str_[64]; j < 6 ; j ++) {
					if (j == 0) {
						format(str_, sizeof str_, ""colwhi"[%d] Одежда: %d "collime"[В ней пришли]\n", j, pInfo[playerid][pChar][j]);
					} else {
						format(str_, sizeof str_, ""colwhi"[%d] Одежда: %d\n", j, pInfo[playerid][pChar][j]);
					}
					strcat(t_string, str_);
				}
				ShowPlayerDialog(playerid, D_CHANGE_SKIN_BUSINESS_0, DIALOG_STYLE_LIST, ""colserver"Замена: "colwhi"Одежды", t_string, "Выбрать", "Закрыть" );
				return 1;
			} else {
				new
					select_slot = GetPlayerSlotClothes(playerid);
				if (select_slot == -1) {
					SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка, сообщите на форум CODE: GetPlayerSlotClothes");
					return 1;
				}
				pInfo[playerid][pChar][select_slot] = pInfo[playerid][pChar][0];
				pInfo[playerid][pChar][0] = GetPlayerSkin(playerid);//даём скин
				SetPlayerSkinEx(playerid, pInfo[playerid][pChar][0]);
				PressedPickup[playerid] = BusinessInfo[id][bBuyPickup];

				SetPlayerPosAC(playerid,
					BusinessInteriorInfo[interior_id][bIntMenuPos][0],
					BusinessInteriorInfo[interior_id][bIntMenuPos][1],
					BusinessInteriorInfo[interior_id][bIntMenuPos][2], BusinessInfo[id][bWorld],
					BusinessInteriorInfo[interior_id][bIntInterior]
				);
				SetPlayerFacingAngle(playerid, 0.000);

				TogglePlayerControllable(playerid, true);
				SetCameraBehindPlayer(playerid);

				BusinessInfo[id][bProducts] -= 10;
				PayBusinessItem(playerid, id, 0, 1, price);

				SendClientMessage(playerid, COLOR_BLUE, !"[Продавец] "colwhi"Спасибо за покупку. Вы сделали хороший выбор!");
				PlayerTextDrawHide(playerid, sk_info_text[playerid]);
				for(new t = 0; t < sizeof (SkinShopMenu); t++) {
					TextDrawHideForPlayer(playerid, SkinShopMenu[t]);
				}
				pTemp[playerid][tSelectSkinShop] = -1;
				SetCameraBehindPlayer(playerid);
				TogglePlayerControllable(playerid, 1);
				CancelSelectTextDraw(playerid);

				save_player_skins(playerid);

				OnPlayerQuestProgress(playerid, QUEST_GUEST, QUEST_TASK_VICTIM);
			}
			return 1;
		}
	} 


			
	else if (pTemp[playerid][tSelectVehicleShop] != -1)
	{
    	if (clickedid == AutoShopText[0]) return BackCar(playerid);
    	else if (clickedid == AutoShopText[1]) return NextCar(playerid);
    	else if (clickedid == AutoShopText[2]) return NextColor(playerid,0);
    	else if (clickedid == AutoShopText[3]) return NextColor(playerid,1);
    	else if (clickedid == AutoShopText[4]) return BackColor(playerid,1);
    	else if (clickedid == AutoShopText[5]) return BackColor(playerid,0);
