	case D_GOV_CHARITY_0:
	{
		if (!response) return 1;
		new 
		money_ = strval(inputtext),
		string_[128];
		if (money_ < 1000 || money_ > 1000000) { 
		return ShowPlayerDialog(playerid, D_GOV_CHARITY_0, DIALOG_STYLE_INPUT, 
			""colserver"Мэрия: "colwhi"Благотворительность",
			"\n"colwhi"Введите сумму, которую хотите пожертвовать на развития штат\nВсе средства пойдут в казну штата\n\
			Минимальная сумма "collime"1000 $ "colwhi"до "collime"1.000.000 $",
			"Перевести", "Отмена"
		);
		}
		if (kLibGetPlayerMoney(playerid) < money_) return SendClientMessage(playerid, COLOR_GREY, !"У Вас недостаточно средств");
		kLibGivePlayerMoney(playerid, -money_, "пожертвование");
		pInfo[playerid][pCharity] += money_;
		//SetMoveCashServer(OUT_SERVER, VehicleInfo[ V_IDX - 1 ][vSellCost]);
		SavePlayerInteger(playerid, "pCharity", pInfo[playerid][pCharity]);//pCharity
		FractionInfo[FRACTION_CITYHALL][fMoney] += money_;
		OnPlayerAchievProgress(playerid, 26, money_);
		OnPlayerAchievProgress(playerid, 27, money_);
		OnPlayerAchievProgress(playerid, 28, money_);
		OnPlayerAchievProgress(playerid, 29, money_);
		UpdateFractionStore(FRACTION_CITYHALL);
		SaveFractionInfoID(FractionInfo[FRACTION_CITYHALL][fID], false);
		format(string_, sizeof string_, "Вы успешно пожертвовали "collime"$%d"colwhi" в казну штата", money_);
		SendClientMessage(playerid, COLOR_WHITE, string_);
		mysql_tquery (dbHandle, "SELECT `Name`,`pLevel`,`pCharity` FROM `s_users` WHERE `pLevel` != 0 ORDER BY `pCharity` DESC LIMIT 5", "LoadTopServer");
	}
	case D_MAFIA_FUNC_0: {
		if (!response) {
		return 1;
		}
		switch(listitem) {
		case 0: {
			new
			m_bzStats[3];
			for (new i = 0; i < sizeof (BusinessInfo); i++) { 
			if (!IsValidBusiness(i)) 
				continue;
			if (BusinessInfo[i][bMafia] == 5)
				m_bzStats[0]++;
			else if (BusinessInfo[i][bMafia] == 6)
				m_bzStats[1]++;
			else if (BusinessInfo[i][bMafia] == 14)
				m_bzStats[2]++;
			}
			
			format(t_string, sizeof t_string, 
			""colmain"Мафия\t\t   Бизнесов\t\tРепутация{FFFFFF}\n\n- LCN: \t\t\t%d\t\t\t%d\n- Yakuza: \t\t%d\t\t\t%d\n- Russian Mafia: \t%d\t\t\t%d", 
