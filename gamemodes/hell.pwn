		}
		PlayAudioStreamForPlayer(playerid, Radio_List[listitem]);
		}
		return 1;
	}
	case D_PLAYER_SPAWNCHANGE:
	{
//0 - Бомжатня / 1 - Дом / 2 - Фракция
	
		if (!response) return 1;
		switch(listitem)
		{
		case 0:
		{
			if (pInfo[playerid][PlayerSpawn] == 0) return SendMes(playerid, COLOR_YELLOW, "[Подсказка] "colwhi"Ваш текущий спавн %s!", GetPlayerSpawnName(playerid));
			if (pInfo[playerid][pMember] == 3 && pInfo[playerid][pRank] < 3 || pInfo[playerid][pMember] == 19 && pInfo[playerid][pRank] < 3) {
	      		return SendClientMessage(playerid, COLOR_WHITE, !"Ваш ранг меньше 3, вам еще не доступно!"); 
			}
			SendClientMessage(playerid, COLOR_WHITE, !"Теперь вы будете возраждаться в обычном месте!");
		}
		case 1:
		{
			if (pInfo[playerid][PlayerSpawn] == 1) return SendMes(playerid, COLOR_YELLOW, "[Подсказка] "colwhi"Ваш текущий спавн %s!", GetPlayerSpawnName(playerid));
		    if (pInfo[playerid][pHouseID] == -1 && pInfo[playerid][pRentHouse] == -1) return SendClientMessage(playerid, COLOR_GREY, !"Вы не имеете дома/квартиры!");
			if (pInfo[playerid][pMember] == 3 && pInfo[playerid][pRank] < 3 || pInfo[playerid][pMember] == 19 && pInfo[playerid][pRank] < 3) {
	      		return SendClientMessage(playerid, COLOR_WHITE, !"Ваш ранг меньше 3, вам еще не доступно!"); 
			}
			SendClientMessage(playerid, COLOR_WHITE, !"Теперь вы будете возраждаться в Доме/Квартире!");
		}
		case 2:
		{
			if (pInfo[playerid][PlayerSpawn] == 2) return SendMes(playerid, COLOR_YELLOW, "[Подсказка] "colwhi"Ваш текущий спавн %s!", GetPlayerSpawnName(playerid));
		    if (pInfo[playerid][pMember] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Вы должны состоять в организации!"); 

			SendClientMessage(playerid, COLOR_WHITE, !"Теперь вы будете возраждаться на базе организации!");
		}
		case 3:
		{
			if (pInfo[playerid][PlayerSpawn] == 3) return SendMes(playerid, COLOR_YELLOW, "[Подсказка] "colwhi"Ваш текущий спавн %s!", GetPlayerSpawnName(playerid));
			new yacht_id = 0;
			if (Iter_Count(PlayerListVehicle[playerid]) != 0)foreach(new veh_id:PlayerListVehicle[playerid])
			{
				if (!IsVehicleInterior(veh_id)) continue;
				yacht_id = IsVehicleInterior(veh_id);
				break;
			}
			if (yacht_id != 2) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет дома на колёсах!");
			SendClientMessage(playerid, COLOR_WHITE, !"Теперь Вы будете возраждаться в доме на колёсах!");
		}
		case 4:
		{
			if (pInfo[playerid][PlayerSpawn] == 4) return SendMes(playerid, COLOR_YELLOW, "[Подсказка] "colwhi"Ваш текущий спавн %s!", GetPlayerSpawnName(playerid));
		    new yacht_id = 0;
			if (Iter_Count(PlayerListVehicle[playerid]) != 0)foreach(new veh_id:PlayerListVehicle[playerid])
			{
			if (!IsVehicleInterior(veh_id)) continue;
			yacht_id = IsVehicleInterior(veh_id);
			break;
			}
			if (yacht_id != 1) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет Яхты!");
			SendClientMessage(playerid, COLOR_WHITE, !"Теперь Вы будете возраждаться в Яхте!");
		}
		case 5: {
			if (pInfo[playerid][PlayerSpawn] == 5) return SendMes(playerid, COLOR_YELLOW, "[Подсказка] "colwhi"Ваш текущий спавн %s!", GetPlayerSpawnName(playerid));
			if (pInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Вы не состоите в семье");
			if (FamilyInfo[ pInfo[playerid][pFamily] - 1 ][fHouse] == -1) return SendClientMessage(playerid, COLOR_GREY, !"У Вашей семьи нет особняка!");

			SendClientMessage(playerid, COLOR_WHITE, !"Теперь вы будете возраждаться в Семейной особняка!");
		}
		case 6: {
			if (pInfo[playerid][PlayerSpawn] == 6) return SendMes(playerid, COLOR_YELLOW, "[Подсказка] "colwhi"Ваш текущий спавн %s!", GetPlayerSpawnName(playerid));
			if (pInfo[playerid][pFamily] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Вы не состоите в семье");
			if (FamilyInfo[ pInfo[playerid][pFamily] - 1 ][fDefHouse] == -1) return SendClientMessage(playerid, COLOR_GREY, !"У Вашей семьи нет дома!");

			SendClientMessage(playerid, COLOR_WHITE, !"Теперь вы будете возраждаться в Семейной доме!");
		}
		default:{
		    new  
			string_[156]; 
		    format(string_, sizeof string_,
			"[0] Стандартный спавн\n\
			[1] Дом/Квартира\n\
			[2] Организация\n\
			[3] В доме на колёсах\n\
			[4] На Яхте\n\
			[5] В Семейном особняка\n\
			[6] В Семейном доме"colserver"- Текущий спавн: %s", GetPlayerSpawnName(playerid)
			);
			return ShowPlayerDialog(playerid, D_PLAYER_SPAWNCHANGE, DIALOG_STYLE_LIST, ""colserver"Место респавна", string_, "Выбрать", "Закрыть");
