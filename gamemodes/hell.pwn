			ttextt[32], 
			string_[200];
		sscanf(fInfo[ listitem+1 ][fLeader], "u", status_);
		if (IsPlayerConnected(status_)) ttextt = "("collime"Online"colwhi")";
		else ttextt = "("colwarn"Offline"colwhi")";
		SetPVarInt(playerid, "SetTempLeaderSelect", listitem + 1);
		format(string_, sizeof string_, ""colwhi"У данной организации уже имееться лидер "colserver"%s "colwhi"%s\n\n"colwhi"Хотите снять его?",fInfo[ listitem+1 ][fLeader], ttextt);
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_15, DIALOG_STYLE_MSGBOX, ""colserver"Организации: "colwhi"Снять лидера", string_, "Снять", "Отмена");
		}
	}
