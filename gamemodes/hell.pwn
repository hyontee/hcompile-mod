	case D_ADMIN_FUNC_15:
	{
    	if (!response) return 1;
    	if (!strlen(inputtext)) 
		return ShowPlayerDialog(playerid, D_ADMIN_FUNC_15, DIALOG_STYLE_PASSWORD, ""colserver"Авторизация: "colwhi"Администратор", ""colwhi"Введите пароль\n\nПароль должен состоять из латинских букв и цифр\n\tразмером от 6 до 15 символов", "Вход", "Отмена");
    	if (GetPVarInt(playerid, "AdminloginServer") == 1)//первый вход
    	{
    	    new pass2[64],
			query_[256] ;
        	if (sscanf(inputtext, "s[64]", pass2)) ShowPlayerDialog(playerid, D_ADMIN_FUNC_15, DIALOG_STYLE_PASSWORD, ""colserver"Авторизация: "colwhi"Администратор", ""colwhi"Введите пароль\n\nПароль должен состоять из латинских букв и цифр\n\tразмером от 6 до 15 символов", "Вход", "Отмена");
        	if (!strcmp(inputtext, "qwerty", true)) return ShowPlayerDialog(playerid, D_ADMIN_FUNC_15, DIALOG_STYLE_PASSWORD, ""colserver"Авторизация: "colwhi"Администратор", ""colwhi"Введите пароль\n\nПароль должен состоять из латинских букв и цифр\n\tразмером от 6 до 15 символов", "Вход", "Отмена");

		if (strlen(inputtext) < 6 || strlen(inputtext) > 32) 
			return ShowPlayerDialog(playerid, D_ADMIN_FUNC_15, DIALOG_STYLE_PASSWORD, ""colserver"Авторизация: "colwhi"Администратор", ""colwhi"Введите пароль\n\nПароль должен состоять из латинских букв и цифр\n\tразмером от 6 до 15 символов", "Вход", "Отмена");
		for(new i = strlen(inputtext)-1; i != -1; --i){
			switch(inputtext[i]){
			    case 'a'..'z', 'A'..'Z', '0'..'9':
			        continue;
			default:
			    return SendClientMessage(playerid, COLOR_GREY, !"Вы использовали запрещенные символы!");
			}
		}
		new 
			player_ip[16];
		GetPlayerIp(playerid, player_ip, sizeof player_ip);
		mysql_format(dbHandle, query_, sizeof query_, "UPDATE `s_admin` SET  password = '%s', IP = '%s', LastIP = '%s' WHERE Name = '%s' LIMIT 1", 
			pass2, player_ip, player_ip, pInfo[playerid][pName]
		);
		mysql_tquery(dbHandle, query_, "", ""); 
		mysql_format(dbHandle, query_, sizeof query_, "SELECT * FROM `s_admin` WHERE `Name` = '%s'", pInfo[playerid][pName]);
		mysql_tquery(dbHandle, query_, "SetLoadAdminInfo", "ii", playerid, GetPVarInt(playerid, "AdminloginServer")); 
		DeletePVar(playerid,#LoadAdminLevel);
        	DeletePVar(playerid,#AdminloginServer);
        	return 1;
    	}
    	else if (GetPVarInt(playerid, "AdminloginServer") == 2)//После релога
    	{
		new 
			string_[64], 
			str[64], 
			query_[128]; 
                GetPVarString(playerid, "password", str, 64); 
        	if (strcmp(inputtext, str, true)) 
		{
			format(string_, sizeof string_, "<ALogin> %s[%d]: ввел неверный пароль",pInfo[playerid][pName],playerid);
			SendAdminMessage(0xF4B800AA, string_);
			return SendClientMessage(playerid, COLOR_GREY, !"Вы ввели неверный пароль");
		}
		mysql_format(dbHandle, query_, sizeof query_, "SELECT * FROM `s_admin` WHERE `Name` = '%s'", pInfo[playerid][pName]);
		mysql_tquery(dbHandle, query_, "SetLoadAdminInfo", "ii", playerid, GetPVarInt(playerid, "AdminloginServer")); 
		DeletePVar(playerid, #adminsIP);
        	DeletePVar(playerid, #password); 
        	DeletePVar(playerid, #AdminloginServer);
        	return 1;
    	} 
	}
	case D_ADMIN_FUNC_16:
	{
		if (!response) return 1;
