			mysql_tquery(dbHandle, t_query, "", "");
		}
		case 2: {
			if (SystemConfig[gCaptureEveryOneHour] == 1) {
			SystemConfig[gCaptureEveryOneHour] = 2;
			} else {
			SystemConfig[gCaptureEveryOneHour] = 1;
			} 
			new 
			str_[128];
			format(str_, sizeof str_, "Теперь /capture будет доступен раз в %d час(а)", SystemConfig[gCaptureEveryOneHour]);
			SendClientMessage(playerid, COLOR_WHITE, str_);
			new t_query[64];
			format(t_query, sizeof t_query,"UPDATE `s_others` SET gCaptureEveryOneHour= '%d'", 
			SystemConfig[gCaptureEveryOneHour]
			);
			mysql_tquery(dbHandle, t_query, "", "");
		}
		}
		return 1;
	}

