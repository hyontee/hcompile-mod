		"Древесины", "Древесины", "Угля", "Угля", "Топлива", "Топлива"
		}; 
		format(string_, sizeof string_, "[Оповещение] "colwhi"Куплено: %s %d т. за "collime"$%d", corge_name[dorm_id], strval(inputtext), all_cost);
		SendClientMessage(playerid, COLOR_LI_RED, string_);
		format(string_, sizeof string_, "[Оповещение] "colwhi"Ваш номер "colmaline"%d "colwhi"в очереди", queue_id);
		SendClientMessage(playerid, COLOR_LI_RED, string_);
		kLibGivePlayerMoney(playerid, -all_cost, "load corge");
		return 1;
	}
	case D_PLAYER_HOTDOG: {
		if (!response) {
		return 1;
		}
		switch (listitem) {
		case 0: {
			if (pTemp[playerid][tJobHotDogSaller]) {
			ShowPlayerDialog(playerid, D_PLAYER_HOTDOG_JOB, DIALOG_STYLE_MSGBOX, ""colserver"Рабочий день: "colwhi"Завершить",
				"\n\n"colwhi"Вы действительно желаете завершить рабочий день?\n", "Выбрать", "Отмена"
			);
			} else {
			ShowPlayerDialog(playerid, D_PLAYER_HOTDOG_JOB, DIALOG_STYLE_MSGBOX, ""colserver"Рабочий день: "colwhi"Начать",
				"\n\n"colwhi"Вы действительно желаете начать рабочий день?\n", "Выбрать", "Отмена"
			);
			}
		}
		case 1: {
			for (new id = 0; id < sizeof (BusinessInfo); id++) {
			if (!IsValidBusiness(id)) continue;

			if (!IsPlayerInRangeOfPoint(playerid, 5.0, BusinessInfo[id][bPos][0], BusinessInfo[id][bPos][1], BusinessInfo[id][bPos][2])) 
				continue; 
			if (BusinessInfo[id][bType] != BUSINESS_TYPE_CLUCKIN_BELL && BusinessInfo[id][bType] != BUSINESS_TYPE_PIZZA && BusinessInfo[id][bType] != BUSINESS_TYPE_BURGER_SHOT) continue;
			if (!strcmp(BusinessInfo[id][bOwner], "None", true)) {
				SendClientMessage(playerid, -1, !"Бизнес не имеет владельца!");
				break;
			}  
			format(t_string, sizeof t_string, "Вы действительно желаете заключить контракт с закусочной %s, вы будете получать 25%% от стоимость товара", BusinessInfo[id][bName]);
			ShowPlayerDialog(playerid, D_PLAYER_HOTDOG_CONTRACT, DIALOG_STYLE_PASSWORD, ""colserver"Бизнес: "colwhi"Контракт", t_string, "Принять", "Закрыть");
			SetPVarInt(playerid, "targetHotDogID", id);
			break;	
			}
		}
		}
		return 1;
	}
	case D_PLAYER_HOTDOG_CONTRACT: {
		if (!response) {
		DeletePVar(playerid, "targetHotDogID");
		return 1;
		}
		new 
		id = GetPVarInt(playerid, "targetHotDogID");
		pTemp[playerid][tPlayerConractBizzHD] = id;
		SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Отправляйтесь продавать еду, в людные места");
		return 1;
	}
	case D_PLAYER_HOTDOG_JOB: {
		if (!response) {
		return 1;
		}
		if (pTemp[playerid][tJobHotDogSaller]){
		SendClientMessage(playerid, COLOR_GREEN, !"Вы завершили рабочий день");
		//pay amount
		pTemp[playerid][tJobHotDogSaller] = false;
		} else {
		if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) {
			SendClientMessage(playerid, COLOR_GREY, !"Вы должны быть за рулем транспорта");
			return 1;
		} 
		new Float:angle,Float:distance,Float:vehx, Float:vehy, Float:vehz;
		GetVehicleModelInfo(VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vModel], 1, vehx, distance, vehz);
		distance = distance/4 + 0.1;
		GetVehiclePos(pTemp[playerid][pRentCar], vehx, vehy, vehz); 
		GetVehicleZAngle(pTemp[playerid][pRentCar], angle);
		vehx += (distance * floatsin(-angle+90, degrees));
		vehy += (distance * floatcos(-angle+90, degrees));
		//360 270 +90 
		VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobPickup] = CreateDynamicPickup(19346,1, vehx, vehy, vehz); 
		VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobArea] = CreateDynamicSphere(vehx, vehy, vehz, 1.0, 0, INTERIOR_NONE);
		SetDynamicAreaType(VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobArea], AREA_TYPE_HOTDOG_SALLER, pTemp[playerid][pRentCar]);  
		VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobLoad] = true;

		VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobAmount][0] = playerid;
		VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobAmount][1] = 0;
		//vJobAmount[2]
		//if (IsValidDynamicObject(VehicleInfo[v_idx ][v_object][0]))
		//VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobArea] = CreateDynamicSphere(vehx, vehy, vehz, 1.0, 0, INTERIOR_NONE);
        		//	SetDynamicAreaType(VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobArea], AREA_TYPE_ROB_HOUSE, pTemp[playerid][tRobVeh]); 
		SendClientMessage(playerid, COLOR_GREEN, !"Вы начали рабочий день");
		}
		return 1;
	}
	    default: {
		#if defined _businesses_inc
		if (business_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _duels_inc
		if (duels_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _items_inc
		if (items_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _poffer_inc
		if (poffer_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _quest_inc
		if (quest_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif 
		#if defined _achiev_inc
		if (achiev_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif 
		#if defined _vote_inc
		if (votepick_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _theft_inc
		if (theft_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _ac_ser_inc
		if (ac_ser_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _voting_inc
		if (voting_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		#if defined _promo_referal_inc
		if (Promo_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		if (Family_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#if defined _a_event_inc
		if (Event:OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
		if (Fraction_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		if (House_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		if (ATM_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#if defined _dice_game_inc
		if (bone_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return true;
		#endif
	}
	    //Конец диалогов
	}
	while(strfind(inputtext, "%s",true)!=-1)
	{
	strdel(inputtext,strfind(inputtext, "%s",true),strfind(inputtext, "%s",true)+2);
	}
	//}	//Диалоги конец
	return 1;
}
public OnGameModeExit()
{ 
	#if defined debug_mode 
	print("[GM debug] OnGameModeExit()"); 
	#endif
	#if defined _poker_included
	Iter_Clear(pokerTables);
	#endif
	#if defined _blackjack_included
	Iter_Clear(blackjackTables);
	#endif
	for(new i = 1; i <= TOTAL_FRACTION; i++) {
	Iter_Clear(DicePlayers[i]);  
	}
	//Iter_Clear(DicePlayers[MAX_BONE_TABLE]);
	Iter_Clear(PlayerInLogin);
	Iter_Clear(AdminsTeam);
	Iter_Clear(SupportsTeam);
	for(new i = 1; i <= TOTAL_FRACTION; i++) {
	Iter_Clear(PlayerTeam[i]);  
	}
	KillTimer(GlobalTimerServer); 
	mysql_close(dbHandle); 
	print("База данных потеряла соединение.");
	return 1;
}

