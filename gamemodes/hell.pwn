		SavePlayerInteger(playerid, "u_donate", pInfo[playerid][pDonate]);
		SendMes(playerid, COLOR_WHITE, "Вы получаете кэшбек, в размере %i "DonatePoint" на донат счет!", boostCashBack);
		}
		for (new i = 0; i < sizeof (LicensesName); i++) {
		if (!BoostPlayer[select_idx + 1][bLicenses]) continue; 
		GivePlayerLicense(playerid, i, 90);
		SendMes(playerid, COLOR_BLUE, "Вы получили в пакете - \"%s\".", LicensesName[i]);
		} 
		SendClientMessage(playerid, COLOR_WHITE, !"На срок 30 дней, Желаем Вам приятной игры на Hell Role Play!");
		DeletePVar(playerid, "BoostPackSelect");
		return 1;

