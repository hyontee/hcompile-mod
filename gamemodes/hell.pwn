public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{ 


	#if defined debug_mode 
	printf("[GM debug] OnDialogResponse(%s(%d), %d, %d, %d, %s)", pInfo[playerid][pName], playerid, dialogid, response, listitem, inputtext); 
	#endif 

	if ((dialogid < D_REG_PASSWORD || dialogid > D_TG_GUARD_INPUT) && !pInfo[playerid][pLogin]) { 
	scmKick(playerid, "Вы были кикнуты по подозрению в читерстве (AC - D7)");
	printf("Call OnDialogResponse [pLogin = 1] ID: %d (%s) | Kick D7", playerid, pInfo[playerid][pName]);
	return 1; 
	} /*else {
	if (!pInfo[playerid][pLogin]) {
		scmKick(playerid, "Вы были кикнуты по подозрению в читерстве (AC - D8)");
		printf("Call OnDialogResponse [pLogin = 0] ID: %d (%s) | Kick D8", playerid, pInfo[playerid][pName]);
		return 1;
	}
	}*/
	if (strlen(inputtext) && (strfind(inputtext,"`") != -1 || /*strfind(inputtext,"'") != -1 ||*/ strfind(inputtext,"=") != -1 || strfind(inputtext,"{") != -1)) 
	{
	if (dialogid < D_VK_GUARD_CONFIRMATION || dialogid > D_TG_GUARD_INPUT) {
		scmKick(playerid, "Вы были кикнуты по подозрению в читерстве (AC - D15)");
		printf("Call OnDialogResponse [pLogin = 1] ID: %d (%s) | Kick D15", playerid, pInfo[playerid][pName]);
		return 1;
	}
	return SendClientMessage(playerid, COLOR_GREY, !"[Ошибка] Вы использовали запрещенные символы.");
	}
	

	switch (dialogid) {
	
	case D_NULL: return 1;
	case 9995:
	{
		if(IsACop(playerid))
		{
			SendClientMessage(playerid, COLOR_LIGHTGREEN, "Удачного дня Вам сотрудник!");
			SetPlayerHealth(playerid, 100);
			SetPlayerArmour(playerid, 100);
			GivePlayerWeapon(playerid, 24, 150);
			GivePlayerWeapon(playerid, 31, 250);
			GivePlayerWeapon(playerid, 29, 250);
			GivePlayerWeapon(playerid, 3, 1);
		}
		else
		{
			SendClientMessage(playerid, COLOR_LIGHTRED, "Вам не доступно.");
		}
		return 1;
	}
	case 9997:
	{
		switch(listitem)
		{
		case 0: SetPlayerSkin(playerid, 70);
		case 1: SetPlayerSkin(playerid, 308);
		case 2: SetPlayerSkin(playerid, 274);
		case 3: SetPlayerSkin(playerid, 276);
		}
	}
	case 9999:
	{
		switch(listitem)
		{
		case 0: SetPlayerSkin(playerid, 70);
		case 1: SetPlayerSkin(playerid, 308);
		case 2: SetPlayerSkin(playerid, 274);
		case 3: SetPlayerSkin(playerid, 276);
		}
	}
	case 9998:
	{
		SetPlayerHealth(playerid, 100);
	}
	/*case 9999:
	{
		SendAdminMessage(COLOR_RED, inputtext);
	}*/
	   	case D_LOGIN_PLAYER:
	{
		if (!response) {
		scmKick(playerid, "Для выхода из игры используйте /q(uit)"); 
		return 1;
		}
		if (pInfo[playerid][pLogin] == 1) {
		return 1;
		}
		if (!strlen(inputtext) || strlen(inputtext) < 6 || strlen(inputtext) > 24) {
		ShowLoginAccountServer(playerid);
		return 1;
		}
		if (IsARussianText(inputtext)){
		SendClientMessage(playerid, COLOR_GREY, !"Введенный вами пароль содержит русские буквы. Смените раскладку клавиатуры!");
		ShowLoginAccountServer(playerid);
		return 1;
		} 
		mysql_escape_string(inputtext, pInfo[playerid][pKey], 40, dbHandle); 
		
		new 
		query_[256];
		printf("strlen pass %d Current %d", strlen(inputtext), pTemp[playerid][tPlayerCurrentID]);
		mysql_format(dbHandle, query_, sizeof query_, "SELECT * FROM `s_users` WHERE `pID` = '%d' AND `pKey`= md5(md5('%e')) LIMIT 1",pTemp[playerid][tPlayerCurrentID], inputtext);
		mysql_tquery(dbHandle, query_, "LoadPlayer", "i", playerid);  
		return 1; 
	}
	case D_LOGIN_TRANSFER: {
		if (!response) { 
			return 1;
		}
		if (!strlen(inputtext) || strlen(inputtext) < 6 || strlen(inputtext) > 24) {
			ShowLoginTransfer(playerid);
			return 1;
		}
		if (IsARussianText(inputtext)){
			SendClientMessage(playerid, COLOR_GREY, !"Введенный вами пароль содержит русские буквы. Смените раскладку клавиатуры!");
			ShowLoginTransfer(playerid);
			return 1;
		}  
		if (pTransfer[playerid][tID_Users] == -1) {
			SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка, попробуйте позже");
			return 1;
		}
		new 
			query_[256]; 
		mysql_format(dbHandle, query_, sizeof query_, "SELECT * FROM `s_users_old` WHERE `pID` = '%d' AND `pKey`= md5(md5('%e')) LIMIT 1", pTransfer[playerid][tID_Users], inputtext);
		mysql_tquery(dbHandle, query_, "LoadPlayerTransfer", "i", playerid);  
		return 1;
	}
	case D_LOGIN_TRANSFER_0: {
		if (!response) {
		SendClientMessage(playerid, COLOR_GREY, !"Вы отменили восстановления вашего аккаунта");
		pTransfer[playerid] = defaultTransferInfo;
		return 1;
		}
		if (pTransfer[playerid][tID_Users] == -1) {
		SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка, попробуйте позже");
		return 1;
		}
		pInfo[playerid][pLevel] += pTransfer[playerid][tLevel];
		SetPlayerScore(playerid, pInfo[playerid][pLevel]); 
		pInfo[playerid][pExp] = pTransfer[playerid][tEXP];
		if (pTransfer[playerid][tVIP] < pInfo[playerid][VIPRank]) {
		pInfo[playerid][VIPRank] = pTransfer[playerid][tVIP]; 
		new unboost = gettime() + (60 * 86400);
		pInfo[playerid][VIPTime] = unboost; 
		}
		if (pTransfer[playerid][tBoost] < pInfo[playerid][BoostRank]) {
		pInfo[playerid][BoostRank] = pTransfer[playerid][tBoost];
		new unboost = gettime() + (60 * 86400);
		pInfo[playerid][BoostTime] = unboost; 
		}
		pInfo[playerid][PlayerNumber] = pTransfer[playerid][tNumber];
		kLibGivePlayerMoney(playerid, pTransfer[playerid][tCash], "transfer"); 
		pInfo[playerid][pBank] += pTransfer[playerid][tBank];
		pInfo[playerid][pDeposit] += pTransfer[playerid][tDeposit];
		if (pTransfer[playerid][tMember] != 0) {
		if (pInfo[playerid][pMember] != 0) {
			leave_team(playerid, pInfo[playerid][pMember]);
		}
		pInfo[playerid][pJob] = 0;
		pInfo[playerid][pMember] = pTransfer[playerid][tMember];
		pInfo[playerid][pRank] = pTransfer[playerid][tRank];
		pInfo[playerid][pModel] = pTransfer[playerid][tModel]; 
		}
		pInfo[playerid][pMats] += pTransfer[playerid][tMaterials];
		pInfo[playerid][pDrugs] += pTransfer[playerid][tDrugs];
		for(new i = 0; i < 6; i ++) {
		pInfo[playerid][pChar][i] = pTransfer[playerid][tChar][i];
		if (pTransfer[playerid][tGunSkills][i] < pInfo[playerid][pGunSkill][i]) {
			pInfo[playerid][pGunSkill][i] = pTransfer[playerid][tGunSkills][i];
		}
		}
		SetPlayerSkills(playerid); 
		for(new i = 0; i < MAX_ITEMS_SLOTS; i ++) {
		pInfo[playerid][PlayerItems][i] = pTransfer[playerid][tPlayerItems][i];
		pInfo[playerid][PlayerItemsCount][i] = pTransfer[playerid][tPlayerItemsCount][i];
		}  
		SavePlayerInventory(playerid);
		if (pTransfer[playerid][tMember] != 0) {
		invite_team(playerid, pInfo[playerid][pMember]);
		pTemp[playerid][tDutyWork] = 1;
		SetPlayerSkinEx(playerid, pInfo[playerid][pModel]);
		SetPlayerColor(playerid, gFractionColor[pInfo[playerid][pMember]]);
		}
		pInfo[playerid][pDonate] += pTransfer[playerid][tDonate];   
		new
		query_[128], 
		bonus = (pTransfer[playerid][tLevel]*30000);
		pInfo[playerid][p_Transfer] = 1; 
		format(query_, sizeof query_,"pTransfer = '%i', boost_time = '%i', vip_time = '%i', pLevel = '%i', pPnumber = '%i'",//pPnumber
		pInfo[playerid][p_Transfer], pInfo[playerid][BoostTime], pInfo[playerid][VIPTime], pInfo[playerid][pLevel], pInfo[playerid][PlayerNumber]
		);
		SavePlayerStr(playerid, query_); 
		format(query_, sizeof query_, "DELETE FROM `s_users_old` WHERE `pID` = '%d'", pTransfer[playerid][tID_Users]);
    	mysql_tquery(dbHandle, query_);
		SavePlayerID(playerid);
		GivePlayerLicense(playerid, DRIVE_LIC, 90, true);
		GivePlayerLicense(playerid, FISH_LIC, 90, true); 
		SendClientMessage(playerid, COLOR_YELLOW, !"Ваш аккаунт успешно восстановлен!");
		SendMes(playerid, COLOR_GREEN, "Так-же мы выплатили Вам компенсацию в размере $%d. за каждый уровень вам выделено $30.000", bonus);
		kLibGivePlayerMoney(playerid, bonus, "transfer bonus");
		pTransfer[playerid] = defaultTransferInfo;
		return 1; 
	}
	case DIALOG_ANTICHEAT_SETTINGS: // Главное меню настроект анти-чита
        {
            if (!response) {
                pAntiCheatSettingsPage{playerid} = 0; // Присваиваем значение 0 переменной, хранящей номер страницы настроек анти-чита, на которой находится игрок
                return 1; // Закрываем диалог
            }

            if (!strcmp(inputtext, ">>> Следующая страница")) // Если игрок нажал на кнопку перелистывания на следующую страницу
            {
                pAntiCheatSettingsPage{playerid}++; // Инкрементируем (прибавляем 1) значение переменной, хранящей номер страницы настроек анти-чита, на которой находится игрок
            }
            else if (!strcmp(inputtext, "<<< Предыдущая страница")) // Если игрок нажал на кнопку перелистывания на предыдущую страницу
            {
                pAntiCheatSettingsPage{playerid}--; // Декрементируем (убавляем 1) значение переменной, хранящей номер страницы настроек анти-чита, на которой находится игрок
            }
            else // Если игрко выбрал какой-либо из кодов анти-чита
            {
                pAntiCheatSettingsEditCodeId[playerid] = pAntiCheatSettingsMenuListData[playerid][listitem]; // Присваиваем переменной, хранящей номер кода анти-чита, который редактирует игрок, номер кода, который он выбрал
                return ShowPlayer_AntiCheatEditCode(playerid, pAntiCheatSettingsEditCodeId[playerid]); // Показываем игроку диалог настройки кода анти-чита
            }
            return ShowPlayer_AntiCheatSettings(playerid); // Относится к выбору следующей и предыдущей страницы. Заново показываем игроку главное меню настройки анти-чита.
        }
        case DIALOG_ANTICHEAT_EDIT_CODE: // Меню настройки определённого кода анти-чита
        {
            if (!response) // Если игрок закрыл диалог
            {
                pAntiCheatSettingsEditCodeId[playerid] = -1; // Присваиваем переменной, хранящей идентификатор (ID) кода анти-чита, который редактирует игрок, занчение -1
                return ShowPlayer_AntiCheatSettings(playerid); // Показываем игроку главное меню настроек анти-чита
            }

            new
                item = pAntiCheatSettingsEditCodeId[playerid]; // Создаём локальную переменную item, которая примет значение кода анти-чита, который редактирует игрок

            if (AC_CODE_TRIGGER_TYPE[item] == listitem) // Если игрок пытается присвоить коду уже присвоенный ему тип срабатывания
                return ShowPlayer_AntiCheatSettings(playerid); // Показываем главное меню настроек анти-чита

            if (AC_CODE_TRIGGER_TYPE[item] == AC_CODE_TRIGGER_TYPE_DISABLED && listitem != AC_CODE_TRIGGER_TYPE_DISABLED)
                EnableAntiCheat(item, 1);

            AC_CODE_TRIGGER_TYPE[item] = listitem; // Если же игрок выбрал другой тип срабатывания - присваиваем его переменной

            new
                sql_query[101 - 4 + 1 + 2];

            // Форматируем запрос об обновлении данных указаного кода анти-чита в базу данных
            format(sql_query, sizeof(sql_query), "UPDATE anticheat_settings SET `ac_code_trigger_type` = '%d' WHERE `ac_code` = '%d'",
                listitem,
                item);

            mysql_tquery(dbHandle, sql_query); // Отправляем запрос в базу данных
            return ShowPlayer_AntiCheatSettings(playerid); // Показываем главное меню настроек анти-чита
        } 
	case D_REG_RULES:
	{
		if (!response) {
		scmKick(playerid, "Для выхода из игры используйте /q(uit)");
		return 1;
		} 
		static const server_rulles1[] = ""colserver"3. Чат:"colwhi"\n- OOC (Out Of Charter) - это всё, что касается реального мира.\n\
		- IC (In Charter) - это всё, что касается виртульного мира, то есть игры.\n\
		Запрещено:\n- Ругательство, оскорбления или нецензурная речь.\n\
		- Угрозы игрокам (Не относящиеся к игровому процессу)\n\
		- Писать сообщения в верхнем регистре (Caps Lock)\n\
		- Писать в чат объявлений сообщения не относящихся к Role Play.\n\
		- Писать одно и тоже сообщение слишком часто.\n\
		- Обсуждать, критиковать действия администрации.\n- Реклама сторонних ресурсов.\n\n\
		"colserver"4. Администрация сервера:\n\
		"colwhi"- Необходимо сообщать администрации о каких либо нарушениях из данных правил (/mm > Репорт)\n\
		- Администрация самостоятельно выбирает штрафные санкции для каждого из случаев.\n\
		- Запрещено препятствовать администрации в работе.\n\
		- Решение администрации является окончательным и не подлежит обсуждению.\n\n\
		"colserver"5. Торговля:"colwhi"\n- Запрещены любые денежные махинации.\n\
		- Запрещена продажа / покупка чего либо, за реальные деньги.\n\
		- Запрещен обмен внеигровых предметов в любой форме, на игровые.\n\
		- Запрещен обмен чего либо между игровыми серверами.\n- Запрещена продажа / передача аккаунтов.\n";

		ShowPlayerDialog(playerid, D_REG_RULES_0,DIALOG_STYLE_MSGBOX, ""colserver"Правила сервера", server_rulles1, "Согласен", "Выйти");
		return 1;
	}
	case D_REG_RULES_0:
	{
	    if (!response)
		return scmKick(playerid, "Для выхода из игры используйте /q(uit)");
            t_string[0] = EOS;
	    format(t_string, sizeof t_string, ""colwhi"____________________________________________________\n\n\
		\tДобро пожаловать на сервер "colserver##NameServer##colwhi"\n\
		\t\tРегистрация нового персонажа\n\n\
		Логин: "colserver"%s"colwhi"\n\n\
		Примечание:\n\
		\t- Пароль чувствителен к регистру\n\
		\t- Длина пароля может быть от 6 до 24 символов.\n\
		Введите пароль:\n____________________________________________________",pInfo[playerid][pName]);
		return ShowPlayerDialog(playerid, D_REG_PASSWORD, DIALOG_STYLE_INPUT, ""colserver"Регистрация", t_string, "Готово", "Отмена");
	}
	case D_REG_PASSWORD:
	{
	    if (!response)
		return scmKick(playerid, "Для выхода из игры используйте /q(uit)");
		t_string[0] = EOS;
		if (!strlen(inputtext) || strlen(inputtext) < 6 || strlen(inputtext) > 24){
		    format(t_string, sizeof t_string, ""colwhi"____________________________________________________\n\n\
			\tДобро пожаловать на сервер "colserver##NameServer##colwhi"\n\
			\t\tРегистрация нового персонажа\n\n\
