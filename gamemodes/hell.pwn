			SaveFractionInteger(fraction_id, "fAntiTK", fInfo[fraction_id][fAntiTK]);
		}
	    }
	}
	case D_FRACTION_FUNC_2:
	{
	   	if (!response) return 1;
	    new target_id;
	    if (sscanf(inputtext, "u", target_id)) return ShowPlayerDialog(playerid, D_FRACTION_FUNC_2, 1, ""colserver"Назначить заместителя", ""colwhi"Введите ID или имя игрока:", "Принять", "Отмена");
           	if (!PlayerInConnected(target_id) || playerid == target_id) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден/Вы указали свой ID!");
		if (pInfo[target_id][pMember] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Игрок не находиться в организации!");
		if (pInfo[target_id][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, !"Игрок лидер другой организации!");
		if (pInfo[target_id][pMember] != pInfo[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, !"Игрок находиться в другой организации!");
            strmid(fInfo[pInfo[playerid][pMember]][fAssistant], pInfo[target_id][pName], 0, strlen(pInfo[target_id][pName]),MAX_PLAYER_NAME);
            SaveFractionString(pInfo[playerid][pMember], "fAssistant", pInfo[target_id][pName]);
		SendMes(playerid, COLOR_WHITE, "Вы назначили заместителя: "colserver"%s", pInfo[target_id][pName]);
		return SendMes(target_id, COLOR_WHITE, ""colserver"%s %s "colwhi"назначил Вас заместителем: "colserver"%s",fFractionRank[pInfo[playerid][pMember]][pInfo[playerid][pRank] - 1], pInfo[playerid][pName], fInfo[pInfo[playerid][pMember]][fName]);
	}
