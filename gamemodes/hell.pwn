				VehicleNames[VehicleInfo[vehicleid][vModel]-400], VehicleInfo[vehicleid][vModel], fFractionRank[fraction_id][ VehicleInfo[vehicleid][vRank] - 1], VehicleInfo[vehicleid][vRank]
				);
				ShowPlayerDialog(playerid, D_FRACTION_FUNC_41, DIALOG_STYLE_MSGBOX, ""colserver"Транспорт: "colwhi"Доступ",
				string_, "Да", "Нет"
				);
				SetPVarInt(playerid, "selectCarIDlist", vehicleid);
				DeletePVar(playerid, "listCarIDX"); 
				return 1 ;
			}
			}
		} 
		case 2: {//Метка GPS 
			if (CP[playerid] == 777) {
			DisablePlayerCheckpoint(playerid);
			CP[playerid] = 0;
			}
			new 
			select_list = GetPVarInt(playerid, "listCarIDX"); 
			new veh_point = 0 ;
			for(new vehicleid = 0 ; vehicleid < S_VEHICLE_COUNT ; vehicleid ++)
			{
			if (!IsValidVehicle(vehicleid + 1)) continue;
			if (VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_FRACTION || VehicleInfo[vehicleid][vFraction] != pInfo[playerid][pMember]) continue;
			veh_point ++ ;
			if (select_list == veh_point)
			{
				new 
				string_[128]; 
				format(string_, sizeof string_, 
				"[Информация] "colwhi"Транспорт "colserver"%s(%d)"colwhi" отмечен на карте красной меткой!", 
				VehicleNames[VehicleInfo[vehicleid][vModel]-400], VehicleInfo[vehicleid][vModel]
				);
				SendClientMessage(playerid, COLOR_LI_RED, string_);
				CP[playerid] = 777;

				new Float:vehx, Float:vehy, Float:vehz;
				GetVehiclePos(vehicleid + 1, vehx, vehy, vehz);
				SetPlayerCheckpoint(playerid, vehx, vehy, vehz, 8);// личное ТС
				SetPVarInt(playerid, "selectCarIDlist", vehicleid);
				DeletePVar(playerid, "listCarIDX"); 
				return 1 ;
			}
			} 
		}	
		case 3: {
			new 
			select_list = GetPVarInt(playerid, "listCarIDX"); 
			new veh_point = 0 ;
			for(new vehicleid = 0 ; vehicleid < S_VEHICLE_COUNT ; vehicleid ++)
			{
			if (!IsValidVehicle(vehicleid + 1)) continue;
			if (VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_FRACTION || VehicleInfo[vehicleid][vFraction] != pInfo[playerid][pMember]) continue;
			veh_point ++ ;
			if (select_list == veh_point)
			{
				new 
				string_[128];
				format(string_, sizeof string_, ""colwhi"Вы действительно хотите заменить транспорт "colserver"%s(%d)"colwhi", на другой ?", 
				VehicleNames[VehicleInfo[vehicleid][vModel]-400], VehicleInfo[vehicleid][vModel]
				);
				ShowPlayerDialog(playerid, D_FRACTION_FUNC_30, DIALOG_STYLE_MSGBOX, ""colserver"Организация: "colwhi"Транспорт",
