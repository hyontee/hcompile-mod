		SendClientMessage(playerid, COLOR_BLUE, "Вы купили быструю еду!");
		}
		GivePlayerSatiety(playerid, StallMenuInfo[itemid][stallMenuSatiety]);
		ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.0, 0, 0, 0, 0, 0, 1);
		MeAction(playerid, "перекусил(а) у лавки", SELECT_ACTION_IN_BUBBLE);
		return true;
	}
