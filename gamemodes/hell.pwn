{
	#if defined debug_mode 
	printf("[GM debug] OnVehicleDamageStatusUpdate(%d, %s(%d))", vehicleid, pInfo[playerid][pName], playerid);
	#endif
	new Float: carhp;
	GetVehicleHealth(vehicleid, carhp);
	if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB && (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_BUS)) {
	SetPVarInt(playerid,"BusRepairMoney", (1000-floatround(carhp))*5);
	} //
	/*if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB && (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_HUNTER)) {
	return 0;
	}*/
	if (VehicleInfo[ vehicleid - 1 ][vHealth] > 0 && VehicleInfo[ vehicleid - 1 ][vHealth] < 400 && !VehicleInfo[ vehicleid - 1 ][vEngBreaked]) {
 	GameTextForPlayer(playerid, !"~r~ENGINE HAS BROKENED", 5000, 3); 
	VehicleInfo[ vehicleid - 1 ][vEngBreaked] = true;
 	_SetVehicleHealth(vehicleid, 300.0);
 	GetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1); 
	SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, alarm2, doors3, bonnet2, boot1, objective1);
	}
	/*if (random(30) < 3)
	{
 	if (pInfo[playerid][pDrivingSkill] <= 1800 && !IsANoLimiter(GetPlayerVehicleID(playerid)) && random(10) == 1
 	&& VehicleBlinkStatus[GetPlayerVehicleID(playerid)] == false && !IsACop(playerid) && !IsAArmy(playerid))
	{
		switch(pInfo[playerid][pDrivingSkill])
		{
		case 0..1: pInfo[playerid][pDrivingSkill] = 300;
		case 2..299: pInfo[playerid][pDrivingSkill] = 600;
		case 300..599: pInfo[playerid][pDrivingSkill] = 900;
		case 900..1199: pInfo[playerid][pDrivingSkill] = 1200;
		}
		switch(pInfo[playerid][pDrivingSkill])
		{
		case 300, 600, 900, 1200: SendClientMessage(playerid,COLOR_RED, !"Ваш навык вождения был понижен. Соблюдайте /pdd для его повышения!");
		}
	}
	}*/
	return 1;
}
public OnVehicleDeath(vehicleid, killerid)
{ 
	#if defined debug_mode 
	printf("[GM debug] OnVehicleDeath(%d,%d)", vehicleid, killerid); 
	#endif
	if(pTemp[killerid][tRacePlayer]) race_vehicledeath(killerid);
	if (GetVehicleModel(vehicleid) == 450 || GetVehicleModel(vehicleid) == 584 || GetVehicleModel(vehicleid) == 435)
	{
	foreach(new i: PlayerInLogin)
	{
		if (pTemp[i][tTruckerTrailerBuy] != vehicleid) continue;
		/*
		Страховка груза
		*/
		trailer_count[ vehicleid - 1 ] = 0;
		_DestroyVehicle(vehicleid) ;
		SendClientMessage(i, COLOR_GREY, !"Ваш груз был уничтожен");
		if (GetPVarInt(i, "truck_waiting") > 0)
		{
		for (new j = 0 ; j < LOADING_ALL ; j ++) { 
			if (TurnLoadingPlayerID[j] == i) {
			TurnLoadingPlayerID[j] = INVALID_PLAYER_ID;  
			DeletePVar(i, "truck_waiting");
			}
		}
		}
		HideTruckerMainMenu(i, .main = true, .timer = true); 
		pTemp[i][tTruckerTrailerBuy] = INVALID_VEHICLE_ID;
		break; 
	}
	}
	return 1;
}
public OnVehicleMod(playerid, vehicleid, componentid) {
	new model = GetVehicleModel(vehicleid);
	if (!IsLegalCarMod(model, componentid)) {
	RemoveVehicleComponent(vehicleid, componentid);
	return 0;
	}
	return 1;
}
public OnVehicleSpawn(vehicleid)
{
	if (VehicleBlinkStatus[vehicleid] == true) StopVehicleBling(vehicleid); 
	if (car_pickup[vehicleid] > 0) { 
	DestroyDynamicPickup(car_pickup[vehicleid]);
	car_pickup[vehicleid] = 0;
	}
	if (VehicleInfo[ vehicleid - 1 ][vFarmText] != Text3D:-1) {
	DestroyDynamic3DTextLabel(VehicleInfo[ vehicleid - 1 ][vFarmText]);
	VehicleInfo[ vehicleid - 1 ][vFarmText] = Text3D:-1;
	}
	if (Farmcar_pickup[vehicleid] > 0) { 
	DestroyDynamicPickup(Farmcar_pickup[vehicleid]);
	Farmcar_pickup[vehicleid] = 0;
	}
	VehicleInfo[ vehicleid - 1 ][vHealth] = 1000.0;
	if (VehicleInfo[ vehicleid - 1 ][vPT_Engine][1] > 0 && VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_PLAYER && VehicleInfo[ vehicleid - 1 ][vSellCost] == 0 && !IsAPlane(vehicleid)) {
	_SetVehicleHealth(vehicleid, vehicleCountArmour[VehicleInfo[ vehicleid - 1 ][vPT_Engine][1]]);
	}	
	VehicleInfo[ vehicleid - 1 ][vEngBreaked] = false;
	VehicleInfo[ vehicleid - 1 ][vDriverID] = INVALID_PLAYER_ID;
	if (VehicleInfo[ vehicleid - 1 ][vLocked]) {
	GetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	SetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, true, bonnet2, boot1, objective1);
	}  
	ChangeVehicleColor(vehicleid, VehicleInfo[ vehicleid - 1 ][vColor][0], VehicleInfo[ vehicleid - 1 ][vColor][1]); 
	if (VehicleInfo[ vehicleid - 1 ][vPaint] != 3) {
	ChangeVehiclePaintjob(vehicleid, VehicleInfo[ vehicleid - 1 ][vPaint]);
	} 
	if (VehicleInfo[ vehicleid - 1 ][vInt] != 0) LinkVehicleToInterior(vehicleid, VehicleInfo[ vehicleid - 1 ][vInt]);
	if (VehicleInfo[ vehicleid - 1 ][vWorld] != 0) SetVehicleVirtualWorld(vehicleid, VehicleInfo[ vehicleid - 1 ][vWorld]); 
	if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_PLAYER && VehicleInfo[ vehicleid - 1 ][vSellCost] == 0 && !IsAPlane(vehicleid))
	{ 
	for(new j ; j < MAX_NONPARKING_ZONES; j ++)
	{
		if (IsVehicleInQuad(VehicleInfo[ vehicleid - 1 ][vPos][0], VehicleInfo[ vehicleid - 1 ][vPos][1], non_parking_pos[j][0], non_parking_pos[j][1],
		non_parking_pos[j][2], non_parking_pos[j][3]) && VehicleInfo[ vehicleid - 1 ][vFine] == 0/* && VehicleInfo[ vehicleid - 1 ][vJakcer] == 0*/)
		{
		new query_[156];
		format(query_, sizeof query_, "UPDATE "TABLE_VEHICLE_PLAYER" SET vFuel = '%f', vMillage = '%f', vFine = '1', vDayFine = '1' WHERE vID = '%d' LIMIT 1",
			VehicleInfo[ vehicleid - 1 ][vFuel], VehicleInfo[ vehicleid - 1 ][vMillage], VehicleInfo[ vehicleid - 1 ][vID]
		);
		mysql_tquery(dbHandle, query_);

		new playerid = - 1 ;
		foreach(new i: PlayerInLogin) {
			if (VehicleInfo[ vehicleid - 1 ][vFraction] == pInfo[i][pID]) {
			playerid = i;
		    }
		}
		Iter_Remove(StreamedVehicles[playerid], vehicleid);
		SendClientMessage(playerid, COLOR_WHITE, !"Ваш транспорт был отбуксирован на "colserver"Штрафстоянку");

		VehicleInfo[ vehicleid - 1 ][vFraction] = 0;
		VehicleInfo[ vehicleid - 1 ][vSubFraction] = 0;
		VehicleInfo[ vehicleid - 1 ][vRank] = 0;
		VehicleInfo[ vehicleid - 1 ][vType] = 0;
		VehicleInfo[ vehicleid - 1 ][vMoney] = 0;
		VehicleInfo[ vehicleid - 1 ][vFillBag] = 0;
		VehicleInfo[ vehicleid - 1 ][vRepair] = 0;
		VehicleInfo[ vehicleid - 1 ][vDrugs] = 0;
		VehicleInfo[ vehicleid - 1 ][vMaterials] = 0;
		for(new t = 0; t < 6; t++)  {
		        VehicleInfo[ vehicleid - 1 ][vBootGun][t] = 0;
		        VehicleInfo[ vehicleid - 1 ][vBootAmmo][t] = 0;
		}
		_DestroyVehicle(vehicleid);
		Iter_Remove(PlayerListVehicle[playerid], vehicleid);
		}
	}
	for (new j = 0; j < 10; j ++) {
		if (VehicleInfo[ vehicleid - 1 ][vComponent][j] == 0) continue;
		AddVehicleComponent(VehicleInfo[ vehicleid - 1 ][vVehicle], VehicleInfo[ vehicleid - 1 ][vComponent][j]);
	}
	}
	if (VehicleInfo[ vehicleid - 1 ][vFine] > 0) VehicleInfo[ vehicleid - 1 ][vFine] = 0;
	if (GetVehicleModel(vehicleid) == 450 || GetVehicleModel(vehicleid) == 584 || GetVehicleModel(vehicleid) == 435)
	{
	foreach(new i: PlayerInLogin)
	{
		if (pTemp[i][tTruckerTrailerBuy] != vehicleid) continue;
		trailer_count[ vehicleid - 1 ] = 0;
		_DestroyVehicle(vehicleid) ;
		pTemp[i][tTruckerLoadTime] = -1;
		SendClientMessage(i, COLOR_GREY, !"Ваш груз был возвращён на базу");
		if (pTemp[i][tTruckerLeaveTime] > 0 ) pTemp[i][tTruckerLeaveTime] = -1; 
		if (GetPVarInt(i, "truck_waiting" ) > 0)
		{
		for ( new j = 0 ; j < LOADING_ALL ; j ++) {
			if (TurnLoadingPlayerID[j] == i ) {
			TurnLoadingPlayerID[j] = INVALID_PLAYER_ID;
			DeletePVar(i, "truck_waiting");
			}
		}
		}
		HideTruckerMainMenu(i, .main = true, .timer = true);
		pTemp[i][tTruckerTrailerBuy] = INVALID_VEHICLE_ID;
		break;
	}
	}
	
	if (GetVehicleModel(vehicleid) == 450 || GetVehicleModel(vehicleid) == 584 || GetVehicleModel(vehicleid) == 435)
	{
	foreach(new i: PlayerInLogin)
	{
		if (pTemp[i][tTruckerTrailerBuy] != vehicleid) continue;
		/*
		Страховка груза
		*/
		trailer_count[ vehicleid - 1 ] = 0;
		_DestroyVehicle(vehicleid) ;
		SendClientMessage(i, COLOR_GREY, !"Ваш груз был уничтожен");

		if (GetPVarInt(i, "truck_waiting") > 0)
		{
		for (new j = 0 ; j < LOADING_ALL ; j ++) { 
			if (TurnLoadingPlayerID[j] == i) {
			TurnLoadingPlayerID[j] = INVALID_PLAYER_ID;  
			DeletePVar(i, "truck_waiting");
			}
		}
		}
		HideTruckerMainMenu(i, .main = true, .timer = true); 
		pTemp[i][tTruckerTrailerBuy] = INVALID_VEHICLE_ID;
		break;
	}
	}
	trailer_count [ vehicleid - 1 ] = 0;
	trailer_type [ vehicleid - 1 ] = -1; 

	if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_FRACTION) {
	VehicleInfo[ vehicleid - 1 ][vFuel] = GetModelMaxFuel(VehicleInfo[ vehicleid - 1 ][vModel]);
	}
    if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB) {
	VehicleInfo[ vehicleid - 1 ][vLocked] = false;
	GetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	SetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, false, bonnet2, boot1, objective1);
	VehicleInfo[ vehicleid - 1 ][vFuel] = GetModelMaxFuel(VehicleInfo[ vehicleid - 1 ][vModel]);
	AttachJobVehicleObjects(vehicleid - 1,1); // обновление объектов 
	if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_MECHANIC) {
		foreach(new i: PlayerInLogin) {
		if (pTemp[i][pRentCar] == vehicleid) {
			new R_CAR_JOB = pTemp[i][pRentCar];
			pTemp[i][pRentCar] = INVALID_VEHICLE_ID;
			SetVehicleToRespawn(R_CAR_JOB);
			if (pTemp[i][Mechanic3DText] != Text3D:-1) {
			DestroyDynamic3DTextLabel(pTemp[i][Mechanic3DText]);
			pTemp[i][Mechanic3DText] = Text3D:-1;
			}
			DeletePVar(i, "CostBenzMeh");
			pTemp[i][gContract] = INVALID_PLAYER_ID;
			SendClientMessage(i, COLOR_GREY, !"Арендованный транспорт был отбуксирован");
			break;
		}
		}
	}
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_COLLECTOR) {
		foreach(new i: PlayerInLogin) {
		if (pTemp[i][pRentCar] == vehicleid) {
			new R_CAR_JOB = pTemp[i][pRentCar];
			pTemp[i][pRentCar] = INVALID_VEHICLE_ID;
			SetVehicleToRespawn(R_CAR_JOB);  
			if (VehicleInfo[ R_CAR_JOB - 1 ][vJobLoad]) {
			if (VehicleInfo[ R_CAR_JOB - 1 ][vFarmText] != Text3D:-1) { 
				DestroyDynamic3DTextLabel(VehicleInfo[ R_CAR_JOB - 1 ][vFarmText]); 
				VehicleInfo[ R_CAR_JOB  - 1 ][vFarmText] = Text3D:-1;
			} 
			DestroyDynamicArea(VehicleInfo[ R_CAR_JOB - 1 ][vJobArea]);
			DestroyDynamicPickup(VehicleInfo[ R_CAR_JOB - 1 ][vJobPickup]);
			VehicleInfo[ R_CAR_JOB - 1 ][vJobLoad] = false;  
			//clear mass player 
			pTemp[i][tTakeCashATM] = false; 
			}  
			VehicleInfo[ R_CAR_JOB - 1 ][vJobAmount] = 0;  
			_SetVehicleHealth(R_CAR_JOB, 3000.0); 
			SendClientMessage(i, COLOR_GREY, !"Арендованный транспорт был отбуксирован");
			break;
		}
		}
	}
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_HUNTER) {

	}
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_TAXI) {
		foreach(new i: PlayerInLogin) {
		if (pTemp[i][pRentCar]== vehicleid) {
			pTemp[i][pRentCar] = INVALID_VEHICLE_ID;
			SendClientMessage(i, COLOR_GREY, !"Арендованный транспорт был отбуксирован");
			if (GetPlayerTaxi{i} == 1) {
			LeavePlayerTaxi(i);
			SendClientMessage(i, 0x6BB3FFAA, !"Рабочий день окончен");
			} 
			break;
		}
		}
	}
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_TRUCKER) {
		foreach(new i: PlayerInLogin) {
		if (pTemp[i][id_arended_truck] == vehicleid) {
			new R_CAR_JOB = pTemp[i][id_arended_truck];
			pTemp[i][id_arended_truck] = INVALID_VEHICLE_ID;
			if (pTemp[i][tTruckerTrailerBuy] != INVALID_VEHICLE_ID) {
			new	
				trailer_id = pTemp[i][tTruckerTrailerBuy];
			trailer_count[ trailer_id - 1 ] = 0;
			_DestroyVehicle(trailer_id);
			SendClientMessage(i, COLOR_GREY, !"Вы не смогли доставить груз, затраты не будут возмещены");
			pTemp[i][tTruckerLoadTime] = -1; 
			if (GetPVarInt(i, "truck_waiting") > 0) {
				for (new j = 0 ; j < LOADING_ALL ; j ++) { 
				if (TurnLoadingPlayerID[j] == i) {
					TurnLoadingPlayerID[j] = INVALID_PLAYER_ID;  
					DeletePVar(i, "truck_waiting");
				}
				}
			} 
			pTemp[i][tTruckerTrailerBuy] = INVALID_VEHICLE_ID;
			}
			HideTruckerMainMenu(i, .main = true, .timer = true); 
			VehicleInfo[ R_CAR_JOB - 1 ][id_arender_truck] = INVALID_PLAYER_ID;
			SetVehicleToRespawn(R_CAR_JOB);   
			SendClientMessage(i, COLOR_GREY, !"Арендованный транспорт был отбуксирован");
			break;
		}
		}
	} else {
		foreach(new i: PlayerInLogin) {
		if (pTemp[i][pRentCar]== vehicleid) {
			pTemp[i][pRentCar] = INVALID_VEHICLE_ID;
			SendClientMessage(i, COLOR_GREY, !"Арендованный транспорт был отбуксирован");
			/*if (GetPlayerTaxi{i} == 1)
			{
			LeavePlayerTaxi(i);
			SendClientMessage(i, 0x6BB3FFAA, !"Рабочий день окончен");
			}*/
			LeavePlayerBus(i);
			break;
		}
		}
	}

	}
	if (VehicleInfo[ vehicleid - 1][vType] == VEHICLE_TYPE_DYNAMIC)
	{
	if (VehicleInfo[ vehicleid - 1 ][vFraction] == DYNAMIC_VEH_ADMINS) {
		_DestroyVehicle(vehicleid);
	}
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == DYNAMIC_VEH_MATS) {
		_DestroyVehicle(vehicleid);
	}
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == DYNAMIC_VEH_ROB_HOUSE) {
		if (VehicleInfo[ vehicleid - 1 ][vJobLoad]) {
		if (VehicleInfo[ vehicleid - 1 ][vFarmText] != Text3D:-1) { 
			DestroyDynamic3DTextLabel(VehicleInfo[ vehicleid - 1 ][vFarmText]); 
			VehicleInfo[ vehicleid  - 1 ][vFarmText] = Text3D:-1;
		} 
		DestroyDynamicArea(VehicleInfo[ vehicleid - 1 ][vJobArea]);
		DestroyDynamicPickup(VehicleInfo[ vehicleid - 1 ][vJobPickup]);
		VehicleInfo[ vehicleid - 1 ][vJobLoad] = false; 
		}  
		VehicleInfo[ vehicleid - 1 ][vJobAmount] = 0;
		foreach(new i: PlayerInLogin)
		{
		if (pTemp[i][tRobVeh] == vehicleid) {
			pTemp[i][tRobVeh] = INVALID_VEHICLE_ID;
			SendClientMessage(i, COLOR_GREY, !"Ваш грузовик был удален!");
			break;
		}
		}
	} 
	}
	if (VehicleInfo[ vehicleid - 1][vType] == VEHICLE_TYPE_JOB_FARM) {
	    VehicleInfo[ vehicleid - 1 ][vFuel] = GetModelMaxFuel(VehicleInfo[ vehicleid - 1 ][vModel]);
	}
	
	//VEHICLE_TYPE_DYNAMIC
	if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_RENTCAR)
	{
	VehicleInfo[ vehicleid - 1 ][vLocked] = false;
	GetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	SetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, VEHICLE_PARAMS_OFF, bonnet2, boot1, objective1);
	VehicleInfo[ vehicleid - 1 ][vFuel] = GetModelMaxFuel(VehicleInfo[ vehicleid - 1 ][vModel]);
	//if (VehicleInfo[ vehicleid - 1 ][vFraction] == RENT_CAR_SANTA_MARIA) VehicleInfo[ vehicleid - 1 ][vFuel] = 200.0;
	if (VehicleInfo[ vehicleid - 1 ][vFraction] == RENT_CAR_SAN_FIERO || VehicleInfo[ vehicleid - 1 ][vFraction] == RENT_CAR_LOS_SANTOS
		|| VehicleInfo[ vehicleid - 1 ][vFraction] == RENT_CAR_SANTA_MARIA || VehicleInfo[ vehicleid - 1 ][vFraction] == RENT_CAR_LAS_VETURAS)
	{
		foreach(new i: PlayerInLogin)
		{
		if (arenda[i] == vehicleid) {
			arenda[i] = INVALID_VEHICLE_ID;
			SendClientMessage(i, COLOR_GREY, !"Арендованный транспорт был отбуксирован");
			break;
		}
		}
		return 1 ;
	}//RENT_CAR_BOAT
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == RENT_CAR_FAGGIO && VehicleInfo[ vehicleid - 1 ][vModel] == 462)
	{
		_DestroyVehicle(vehicleid);
		foreach(new i: PlayerInLogin)
		{
		if (arenda[i] == vehicleid) {
			arenda[i] = INVALID_VEHICLE_ID;
			SendClientMessage(i, COLOR_GREY, !"Арендованный скутер был отбуксирован");
			break;
		}
		}
		return 1 ;
	}
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == RENT_CAR_BOAT && VehicleInfo[ vehicleid - 1 ][vModel] == 452)
	{
		_DestroyVehicle(vehicleid);
		foreach(new i: PlayerInLogin)
		{
		if (arenda[i] == vehicleid) {
			arenda[i] = INVALID_VEHICLE_ID;
			SendClientMessage(i, COLOR_GREY, !"Арендованный катер был отбуксирован");
			break;
		}
		}
		return 1 ;
	}
	else if (VehicleInfo[ vehicleid - 1 ][vFraction] == RENT_CAR_FAGGIO_THEFT && VehicleInfo[ vehicleid - 1 ][vModel] == 462)
	{
	    _DestroyVehicle(vehicleid);
	    foreach(new i: PlayerInLogin)
	    {
	        if (tookmoped[i] == vehicleid) {
	            tookmoped[i] = INVALID_VEHICLE_ID;
	            SendClientMessage(i, COLOR_GREY, !"Выданый Вам мопед был отбуксирован");
			break;
	        }
	    }
	    return 1;
	}
	else
	{
		foreach(new i: PlayerInLogin)
		{
		if (arenda[i] == vehicleid)
		{
			SendClientMessage(i, COLOR_GREY, !"Арендованный транспорт был отбуксирован");
			break;
		}
		}
	}
	}
	return 1;
}
public OnVehicleStreamIn(vehicleid, forplayerid)
{
	//if(vehicleid == INVALID_VEHICLE_ID) return 0;
	//else if(forplayerid == INVALID_PLAYER_ID) return 0;
	UpdateVehiclePos(vehicleid, false);
	Iter_Add(StreamedVehicles[forplayerid], vehicleid);
	return 1;
}
public OnVehicleStreamOut(vehicleid, forplayerid)
{
	if(vehicleid == INVALID_VEHICLE_ID) return 0;
	else if(forplayerid == INVALID_PLAYER_ID) return 0;

	Iter_Remove(StreamedVehicles[forplayerid], vehicleid);
	return 1;
}
