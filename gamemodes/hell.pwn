}

stock GivePlayerMoneyEx(playerid)
{
	GivePlayerMoney(playerid, pInfo[playerid][pCash]);
}

stock GetPlayerCameraLookAt(playerid, &Float:rX, &Float:rY, &Float:rZ, Float:dist = 10.0)
{
	new Float: locAt[6];
	GetPlayerCameraFrontVector(playerid, locAt[0], locAt[1], locAt[2]);
	GetPlayerCameraPos(playerid, locAt[3], locAt[4], locAt[5]);
	rX = locAt[0] * dist + locAt[3];
	rY = locAt[1] * dist + locAt[4];
	rZ = locAt[2] * dist + locAt[5];
}

publics: LoadTOFF(playerid)
{
    for(new i; i < 3; i ++) PlayerTextDrawHide(playerid, Load_Textures[playerid][i]);
	TogglePlayerControllable(playerid, 1);
	return 1;
}
stock LoadTextures(playerid)
{
    TogglePlayerControllable(playerid, 0);
    SetTimerEx("LoadTOFF" , 3000, false, "i", playerid);
    for(new i; i < 3; i ++) PlayerTextDrawShow(playerid, Load_Textures[playerid][i]);
    return 1;
}

publics: HideAdminPush(playerid)
{
    for(new i; i < 5; i ++) PlayerTextDrawHide(playerid, Push_PTD[playerid][i]);
	return 1;
}
stock ShowAdminPush(playerid)
{
    SetTimerEx("HideAdminPush" , 5000, false, "i", playerid);
    for(new i; i < 5; i ++) PlayerTextDrawShow(playerid, Push_PTD[playerid][i]);
    return 1;
}

stock Reklama(playerid, const string_massive[])
{
	if(strfind(string_massive, "ш л ю х", false) != -1 || strfind(string_massive, "шлюх", false) != -1 || strfind(string_massive, "IP", false) != -1 ||
	strfind(string_massive, "шлюш", false) != -1 || strfind(string_massive, "ш л ю ш", false) != -1 || strfind(string_massive, ".ru", false) != -1 ||
	strfind(string_massive, "NEW IP", false) != -1 || strfind(string_massive, ".com", false) != -1 || strfind(string_massive, "sglban", false) != -1 ||
	strfind(string_massive, ":7777", false) != -1 || strfind(string_massive, "мать", false) != -1 || strfind(string_massive, "маму", false) != -1 ||
	strfind(string_massive, "мамку", false) != -1 || strfind(string_massive, "mamy", false) != -1 || strfind(string_massive, "mamky", false) != -1 ||
	strfind(string_massive, "matb", false) != -1 || strfind(string_massive, "уебок", false) != -1 || strfind(string_massive, "уебак", false) != -1 ||
	strfind(string_massive, "mQ", false) != -1 || strfind(string_massive, "Mq", false) != -1 || strfind(string_massive, "qm", false) != -1 ||
	strfind(string_massive, "Qm", false) != -1 || strfind(string_massive, "MQ", false) != -1)
	{
		if(pInfo[playerid][pMuted]) return 0;
		pInfo[playerid][pMuted] = 18000;
		SavePlayerInteger(playerid, "pMuted", pInfo[playerid][pMuted]);
		format(totalstring, sizeof(totalstring), "[A] %s[%d] подозревается в рекламе [IP: %s]", pInfo[playerid][pName], playerid, pInfo[playerid][LastIP]);
		SendAdminMessage(COLOR_LIGHTRED, totalstring);
		format(totalstring, sizeof(totalstring), "[A] Текст отправителя: %s", string_massive);
		SendAdminMessage(COLOR_GREY, totalstring);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Вы получили блокировку чата по подозрению в использований запрещённых слов.");
		return 0;
	}
	return 1;
}

stock FixText(string[])
{
new result[256];
for (new i=0; i < 256; i++)
{
switch (string[i])
{
case 'а', 'А': result[i] = 'A';
case 'б', 'Б': result[i] = 'Ђ';
case 'в', 'В': result[i] = 'B';
case 'г', 'Г': result[i] = '‚';
case 'д', 'Д': result[i] = 'ѓ';
case 'е', 'Е': result[i] = 'E';
case 'ё', 'Ё': result[i] = 'E';
case 'ж', 'Ж': result[i] = '„';
case 'з', 'З': result[i] = '3';
case 'и', 'И': result[i] = '…';
case 'й', 'Й': result[i] = '†';
case 'к', 'К': result[i] = 'K';
case 'л', 'Л': result[i] = '‡';
case 'м', 'М': result[i] = 'M';
case 'н', 'Н': result[i] = 'H';
case 'о', 'О': result[i] = 'O';
case 'п', 'П': result[i] = 'Њ';
case 'р', 'Р': result[i] = 'P';
case 'с', 'С': result[i] = 'C';
case 'т', 'Т': result[i] = 'T';
case 'у', 'У': result[i] = 'Y';
case 'ф', 'Ф': result[i] = 'Ѓ';
case 'х', 'Х': result[i] = 'X';
case 'ц', 'Ц': result[i] = '‰';
case 'ч', 'Ч': result[i] = 'Ќ';
case 'ш', 'Ш': result[i] = 'Ћ';
case 'щ', 'Щ': result[i] = 'Љ';
case 'ъ', 'Ъ': result[i] = 'ђ';
case 'ы', 'Ы': result[i] = '‘';
case 'ь', 'Ь': result[i] = '’';
case 'э', 'Э': result[i] = '“';
case 'ю', 'Ю': result[i] = '”';
case 'я', 'Я': result[i] = '•';
default: result[i] = string[i];
}
}
return result;
}

publics: ChangeServerName()
{
	new hostname[][128] =
	{
	    {"hostname Hell Role Play | t.me/HellRolePlay"},
	    {"hostname Hell Role Play | Играй вместе с нами!"},
	    {"hostname Hell Role Play | Ждём только тебя!"},
	    {"hostname Hell Role Play | Вперед к новым победам!"}
	};
	SendRconCommand(hostname[RandomFIX(0, 3)]);
}

IsPlayerInBandOnline(bandid)//тест капта
{
	new total;
	foreach(Player, i)
	{
		if(!pInfo[i][pLogin]) continue;
		if(pInfo[i][pMember] == bandid) total++;
	}
	return total;
}