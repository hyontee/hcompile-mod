		new price = GetPVarInt(playerid, "bild_price"),
	    	query_[256],
		p_var = GetPVarInt(playerid,"SelectBildID");
		DeletePVar(playerid, "bild_price");
	    if (kLibGetPlayerMoney(playerid) < price)
		{
		    SendClientMessage(playerid, COLOR_GREY, !"У вас нет столько денег!");
		    return BildExit(playerid);
		}
		new time_rent = gettime() + (7*86400);
		BildInfo[p_var][bDay] = time_rent;

		FractionInfo[fraction_][fMoney] += price; 
		kLibGivePlayerMoney(playerid, -price, "аренда биллборда");

		format(BildInfo[p_var][bOwner], MAX_PLAYER_NAME, pInfo[playerid][pName]);
		BildInfo[p_var][bOwned] = 1;
		ShowPlayerEditMenu(playerid);
		format(query_, sizeof query_, "UPDATE `s_billboards` SET `bDay` = '%d', `bOwned` = '%d', `bOwner` = '%s' WHERE `id` = '%d' LIMIT 1",
		time_rent, BildInfo[p_var][bOwned], pInfo[playerid][pName], p_var);
		mysql_tquery(dbHandle, query_);

		SendClientMessage(playerid, COLOR_WHITE,"Вы успешно арендовали биллборд на "colserver"7 дней");
	}
