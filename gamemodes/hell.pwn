		switch (listitem) {
			case 0: {
			ShowPlayerDialog(playerid, D_BOOMBOX_RADIO, DIALOG_STYLE_LIST, ""colserver"Бумбокс: "colwhi"включение", "\
				"colwhi"[0] Свой URL музыки\n\
				[1] Radio Record\n\
				[2] TRAP.FM\n\
				[3] Europa Plus\n\
				[4] Retro FM\n\
				[5] Jazz FM\n\
				[6] Pop FM\n\
				[7] Rap FM\n\
				[8] Rock FM\n\
				[9] Country FM\n\
