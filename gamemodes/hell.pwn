public OnDynamicObjectMoved(objectid) { 
	if (GetGVarType("GruzConv", objectid) == 1) {
    	DeleteGVar("GruzConv", objectid);
    	DestroyDynamicObject(objectid); 
    } 
	if (GetGVarType("FactoryConveyorLeft", objectid) == GLOBAL_VARTYPE_INT) {//Left line 
	DeleteGVar("FactoryConveyorLeft", objectid);
    	DestroyDynamicObject(objectid); 
	gFactorySortInfo[0][sortBoxCount] ++; 
	UpdateFactoryText();
    }
	if (GetGVarType("FactoryConveyorRight", objectid) == GLOBAL_VARTYPE_INT) {
	DeleteGVar("FactoryConveyorRight", objectid);
    	DestroyDynamicObject(objectid); 
	gFactorySortInfo[2][sortBoxCount] ++; 
	UpdateFactoryText();
    }
	if (GetGVarType("FactoryConveyorOneTape0", objectid) == GLOBAL_VARTYPE_INT) {
	DeleteGVar("FactoryConveyorOneTape0", objectid);
    	DestroyDynamicObject(objectid); 
	gFactorySortInfo[1][sortBoxCount] ++; 
	UpdateFactoryText();
    }
	if (GetGVarType("FactoryConveyorOneTape1", objectid) == GLOBAL_VARTYPE_INT) {
	DeleteGVar("FactoryConveyorOneTape1", objectid);
    	DestroyDynamicObject(objectid); 
	gFactorySortInfo[3][sortBoxCount] ++; 
	UpdateFactoryText();
    }  
	if (GetGVarType("FactoryConveyorTwoTape", objectid) == GLOBAL_VARTYPE_INT) { //
	DeleteGVar("FactoryConveyorTwoTape", objectid);
    	DestroyDynamicObject(objectid); 
	}
	return 1;
}
public OnObjectMoved(objectid)
{
	return 1;
}
