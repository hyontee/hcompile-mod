		    t_string[0] = EOS;
			new tmp_str[80];
		    new C_BD = 1;
			strcat(t_string, !""colserver"Место размещения\t"colserver"Статус\t"colserver"Арендатор\n");
			for(new B_IDX; B_IDX < TOTALBILBOARD; B_IDX++)
		    {
			if (BildInfo[B_IDX][bMember] != fraction_) continue;
			if (!BildInfo[B_IDX][bOwned]){
				format(tmp_str, sizeof(tmp_str), ""colwhi"[%d] %s\t"collime"Свободен\t"colwhi"Отсутствует\n", C_BD, BildInfo[B_IDX][bPosText]);
			}
			else{
			    format(tmp_str, sizeof(tmp_str), ""colwhi"[%d] %s\t"colwarn"Арендован\t"colwhi"%s\n",
				C_BD,BildInfo[B_IDX][bPosText],BildInfo[B_IDX][bOwner]);
			}
			strpack(tmp_str, tmp_str);
			strcat(t_string, tmp_str);
			playerListItem[playerid][C_BD-1] = B_IDX;
			C_BD++;
		    }
		    ShowPlayerDialog(playerid, D_NEWS_FUNC_0, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Заказ биллборда", t_string, "Выбрать", "Закрыть");
		}
		}
	}
