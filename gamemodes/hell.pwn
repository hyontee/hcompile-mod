	case D_DEV_FUNC_3:
	{
		if (response)
		{
		new price,type, Float:x,Float:y,Float:z;
		if (sscanf(inputtext,"p<,>ii",price,type))
		{
			new string1[128];
			strcat(string1,"ВАЖНО: Цена , Класс\n\nПРИМЕР: 100000 , 1\n\nID: 0 [Nope]\nID: 1 [D]\nID: 2 [C]\nID: 3 [B]\nID: 4 [A]\nID: 5 [S]\n");
