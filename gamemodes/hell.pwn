	case D_ACTOR_PASS:
	{
		if (response)
		{
		switch(listitem)
		{
			case 0:
			{
			if (Iter_Count(PlayerListVehicle[playerid]) == 0) 
				return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет транспорта, который можно зарегистрировать");
			//if (kLibGetPlayerMoney(playerid) < 5000)
				//return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет транспорта, который можно зарегистрировать");

			new veh_slot = 0,
				string_[128];
			t_string[0] = EOS;
			foreach(new veh_id:PlayerListVehicle[playerid])
			{
				if (!GetString(VehicleInfo[ veh_id - 1 ][vNumber], "None")) continue;
				new pvar_string [8];
				format(pvar_string, 8, "rv_%d", veh_slot);
				SetPVarInt(playerid, pvar_string, veh_id);
				veh_slot ++ ;
				format(string_, sizeof string_, "[%d] %s(%d) - Номер: %s\n", veh_slot, VehicleNames[ VehicleInfo[ veh_id - 1 ] [vModel] - 400 ], VehicleInfo[ veh_id - 1 ] [vModel], VehicleInfo[ veh_id - 1 ][vNumber]);
				strcat(t_string, string_); 
			}
			ShowPlayerDialog(playerid, D_FRAC_FUNC_6, DIALOG_STYLE_LIST, ""colserver"LSPD: "colwhi"Регистрация транспорта", t_string, "Выбрать", "Назад");

			if (veh_slot == 0) return SendClientMessage(playerid, COLOR_GREY, !"Весь Ваш транспорт уже зарегистрирован");
			SetPVarInt(playerid, "rv_listitems", veh_slot);
			}
			case 1:
			{
			new team = GetPVarInt(playerid, !"KEY_PASS");
			new dostup = 0;
			switch(team)
			{
				case 1,2,10,21: dostup = 1;
			}
			if (dostup == 0) return 1;
			if (IsACop(playerid) || pInfo[playerid][pMember] == 7)
			{
				if (pInfo[playerid][pFracIntKeys][team-1] > 0 || pInfo[playerid][pMember] == team)
				return SendClientMessage(playerid, COLOR_GREY, !"У Вас уже есть пропуск!");
				pInfo[playerid][pFracIntKeys][team-1] = 322;
				SendClientMessage(playerid, COLOR_GREY, !"Вам выдали временный пропуск");
			}
			else SendClientMessage(playerid, COLOR_GREY, !"Вам не удалось получить пропуск!");
			DeletePVar(playerid, "KEY_PASS");
			}
			case 2:
			{
			if (!pInfo[playerid][pWantedLevel]) return SendClientMessage(playerid, COLOR_GREY, !"Вы не находитесь в розыске");
			t_string[0] = EOS;
			format(t_string, sizeof t_string, ""colwhi"Вы собираетесь сдаться с повинной\nЭто сократит Ваш срок вдвое\nВаш уровень розыска: "colwarn"%d\n\
				"colwhi"Примерное время заключения: "colwarn"%d сек\n\
				"colwhi"При добровольной сдаче время заключения составит: "collime"%d сек\n\n\
				"colwhi"Вы действительно хотите сдаться добровольно?", 
				pInfo[playerid][pWantedLevel], pInfo[playerid][pWantedLevel]*600, (pInfo[playerid][pWantedLevel]*600)/2 );  
			ShowPlayerDialog(playerid, D_ACTOR_PASS_0, DIALOG_STYLE_MSGBOX, ""colserver"Регистрация: "colwhi"Сдача с повинной", t_string, "Да", "Отмена");
			}
		}
		}
		DeletePVar(playerid, !"KEY_PASS");
	}
	case D_ACTOR_PASS_0: {
		if (!response) return 1;
		/*SetPlayerPosAC(playerid, 2742.6187, 1396.9856, 1100.9045, 1, 6);
		SetPlayerFacingAngle(playerid, 274.99);*/
		pInfo[playerid][pJailTime] = (pInfo[playerid][pWantedLevel] * 600)/2; 
		pInfo[playerid][pMestoJail] = 1;
		pInfo[playerid][pWantedLevel] = 0;
		SetPlayerWantedLevelEx(playerid, pInfo[playerid][pWantedLevel]);  
		PlayerSpawnEx(playerid);
	} 
	case D_TEMPLEADER: 
	{
		if (!response)
		return true;

		static fractionsArray[27] = {
		INVALID_FRACTION_ID,
		FRACTION_LSPD,
		FRACTION_FBI,
		FRACTION_ARMY_SF,
		FRACTION_HOSPITAL_SF,
		FRACTION_LCN,
		FRACTION_YAKUZA,
		FRACTION_CITYHALL,
		FRACTION_SF_NEWS,
		FRACTION_SFPD,
		FRACTION_AUTOSCHOOL,
		FRACTION_BALLAS,
		FRACTION_VAGOS,
		FRACTION_RUSSIAN,
		FRACTION_GROVE,
		FRACTION_LS_NEWS,
		FRACTION_AZTEC,
		FRACTION_RIFA,
		FRACTION_ARMY_LV,
		FRACTION_LV_NEWS,
		FRACTION_LVPD,
		FRACTION_HOSPITAL_LS,
		FRACTION_HOSPITAL_LV,
		FRACTION_MONGOLS_MC,
		FRACTION_BANDIDOS_MC,
		FRACTION_OUTLAWS_MC,
		//FRACTION_PIRUS
		};

		if (listitem == 0) {
		SendClientMessage(playerid, 0x66cc00AA, !"Временная лидерка снята");
		uninvite_player(playerid);

		return 1;
		}
		else if (pInfo[playerid][pMember] != 0 ){
		uninvite_player(playerid);
		}

		new fractionIndex = fractionsArray[listitem];
//		new string_[144];

		pInfo[playerid][pMember] = fractionIndex;
		pInfo[playerid][pRank] = gFracionCountRank[fractionIndex - 1];
		pInfo[playerid][PlayerSpawn] = 2;
		pTemp[playerid][tDutyWork] = 1;
		pInfo[playerid][pModel] = gFractionSkin[fractionIndex - 1][0];
		SavePlayerInteger(playerid, "pModel", pInfo[playerid][pModel]);
		
		invite_team(playerid, pInfo[playerid][pMember]);
		SendClientMessage(playerid, COLOR_LIME, !"Чтобы быстро телепортироваться на спавн введите команду \"/spawn\"");
	}
	case D_ANTICHEAT: 
	{
		if (!response) 
		return true;

		#if !defined _hkac_included

		if (listitem) antiCheatConfiguration[listitem]++;
