	case D_SAFE_FAMILY_0:
	{
		if (!response) return 0;

		if (listitem == 4) ShowFamilyGunSafe(playerid);
		else ShowFamilySafeUsingMenu(playerid, listitem);

		return 1;
	}
	case D_SAFE_FAMILY_1:
	{
		if (!response) {
		DeletePVar(playerid, "SAFEUSEID");
		return 1;
		}
		if (! strlen(inputtext)) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID"));
		new 
		id = GetPVarInt(playerid, "SAFEUSEID"),
		h = pTemp[playerid][tCurrentHouseID];
		if (pTemp[playerid][tCurrentHouseID] == -1) {
		SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка");
		return 1;
		}
		new string[12], string_[128];
		strmid(string, inputtext, 1, strlen(inputtext));
		new value = strval(string);
		if (value <= 0) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"Недопустимое число.");
		if (inputtext[0] == '-')
		{
		switch(id)
		{
			case 0:
			{
			if (HouseInfo[h][hSafe][0] < value) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"В сейфе нет столько материалов!");
                        if (value + pInfo[playerid][pMats] > GetVIPLimitMaterials(playerid)) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"Вы не можете взять столько материалов!");
			pInfo[playerid][pMats] += value; 
			HouseInfo[h][hSafe][0] -= value;
			format(string_, sizeof string_, "Вы взяли %d материалов из сейфа. Остаток: %d", value, HouseInfo[h][hSafe][0]);
			SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
			case 1:
			{
			if (HouseInfo[h][hSafe][1] < value) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"В сейфе нет столько наркотиков!");
			if (value + pInfo[playerid][pDrugs] > GetVIPLimitDrugs(playerid)) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"Вы не можете взять столько наркотиков!");
			pInfo[playerid][pDrugs] += value; 
			HouseInfo[h][hSafe][1] -= value;
			format(string_, sizeof string_, "Вы взяли %d наркотиков из сейфа. Остаток: %d", value, HouseInfo[h][hSafe][1]);
			SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
			case 2:
			{
			if (HouseInfo[h][hSafe][2] < value) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"В сейфе нет столько ключей!");
			if (value + pInfo[playerid][pFracIntKeys][FRACTION_LSPD - 1] > 10) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"Вы не можете взять столько ключей!");
			if (pInfo[playerid][pFracIntKeys][FRACTION_LSPD - 1] + value > 5)
			    return SendClientMessage(playerid, COLOR_GREY, !"Вы не можете взять с собой больше 5 ключей!");
			pInfo[playerid][pFracIntKeys][FRACTION_LSPD - 1] += value;
			HouseInfo[h][hSafe][2] -= value;
			format(string_, sizeof string_, "Вы взяли %d ключей из сейфа. Остаток: %d", value, HouseInfo[h][hSafe][2]);
			SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
			case 3:
			{
			if (HouseInfo[h][hSafe][3] < value) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"В сейфе нет столько готовой рыбы!");
			if (value + pInfo[playerid][pFishesPach] > 50) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"Вы не можете взять столько готовой рыбы!");
			pInfo[playerid][pFishesPach] += value;
			SavePlayerInteger(playerid, "pFishesPach", pInfo[playerid][pFishesPach]);
			HouseInfo[h][hSafe][3] -= value;
			format(string_, sizeof string_, "Вы взяли %d готовой рыбы из сейфа. Остаток: %d", value, HouseInfo[h][hSafe][3]);
			SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
		}
		}
		else if (inputtext[0] == '+')
		{
		switch(id)
		{
			case 0:
			{
			if (pInfo[playerid][pMats] < value) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько материалов!");
			if (value + HouseInfo[h][hSafe][0] > 20_000) return SendClientMessage(playerid, -1, !"Сейф заполнен.");
			HouseInfo[h][hSafe][0] += value;
			pInfo[playerid][pMats] -= value; 
			format(string_, sizeof string_, "Вы положили в сейф %d материалов.", value);
			SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
			case 1:
			{
			if (pInfo[playerid][pDrugs] < value) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько наркотиков!");
			if (value + HouseInfo[h][hSafe][1] > 5_000) return SendClientMessage(playerid, -1, "Сейф заполнен.");
			HouseInfo[h][hSafe][1] += value;
			pInfo[playerid][pDrugs] -= value; 
			format(string_, sizeof string_, "Вы положили в сейф %d грамм наркотиков.", value);
			SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
			case 2:
			{
			if (pInfo[playerid][pFracIntKeys][FRACTION_LSPD - 1] < value) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько ключей!");
			if (value + HouseInfo[h][hSafe][2] > 300) return SendClientMessage(playerid, -1, "Сейф заполнен.");
			HouseInfo[h][hSafe][2] += value;
			pInfo[playerid][pFracIntKeys][FRACTION_LSPD - 1] -= value;
			format(string_, sizeof string_, "Вы положили в сейф %d ключей.", value);
			SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
			case 3:
			{
			if (pInfo[playerid][pFishesPach] < value) return ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID")), SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько готовой рыбы!");
			if (value + HouseInfo[h][hSafe][3] > 5_000) return SendClientMessage(playerid, -1, "Сейф заполнен.");
			HouseInfo[h][hSafe][3] += value;
			pInfo[playerid][pFishesPach] -= value;
			SavePlayerInteger(playerid, "pFishesPach", pInfo[playerid][pFishesPach]);
			format(string_, sizeof string_, "Вы положили в сейф %d готовой рыбы.", value);
			SendClientMessage(playerid, COLOR_YELLOW, string_);
			}
		}
		}
		else ShowFamilySafeUsingMenu(playerid, GetPVarInt(playerid, "SAFEUSEID"));
		UpdateHouseSafe(h);
		return 1;
	}
	case D_SAFE_FAMILY_2:
	{
