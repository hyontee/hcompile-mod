      	SendMes(playerid, COLOR_WHITE, "Вы сняли с должности заместителя: "colserver"%s", fInfo[pInfo[playerid][pMember]][fAssistant]);
      	strmid(fInfo[pInfo[playerid][pMember]][fAssistant], "None", 0, strlen("None"), MAX_PLAYER_NAME);
            SaveFractionString(pInfo[playerid][pMember], "fAssistant", "None");
		return 1;
	}
	case D_FRACTION_FUNC_4:
	{
		if (!response) return 1;
		new fraction_id = pInfo[playerid][pMember],
		select_list = GetPVarInt(playerid, #RankListItemID),
		list_name[16];
		switch(select_list)
            {
		case 2: list_name = "принимать";
		case 3: list_name = "уволнять";
		case 4: list_name = "повышать";
		case 5: list_name = "понижать";
		case 6: list_name = "снимать деньги";
		case 7: list_name = "менять скин";
            }
		fInfo[fraction_id][fHelper][select_list - 2] = listitem + 1;
		new setting_str[32];
		format(setting_str, sizeof setting_str, "%d, %d, %d, %d, %d, %d, %d", fInfo[fraction_id][fHelper][0], fInfo[fraction_id][fHelper][1], fInfo[fraction_id][fHelper][2], fInfo[fraction_id][fHelper][3], fInfo[fraction_id][fHelper][4], fInfo[fraction_id][fHelper][5], fInfo[fraction_id][fHelper][6]);
		SaveFractionString(fraction_id, "fHelper", setting_str);
		return SendMes(playerid, COLOR_WHITE, "Теперь возможно "colserver"%s"colwhi" с "colserver"%s[%d]", list_name, fFractionRank[fraction_id][listitem], listitem + 1);
	}
	case D_FRACTION_FUNC_5:
	{
	    if (!response) return callcmd::lpanel(playerid);
	        new fraction_id = pInfo[playerid][pMember];
	        format(fInfo[fraction_id][fMessage], 256, "None");
		SendInfo(!"Вы удалили сообщение для своей организации!");
		SaveFractionString(fraction_id, "fMessage", fInfo[fraction_id][fMessage]);
	    return 1;
	}
	case D_FRACTION_FUNC_6:
	{
	    if (!response) return 1;
	    new 
		fraction_id = pInfo[playerid][pMember];
		if (!strlen(inputtext))
		{
		SendClientMessage(playerid, COLOR_LIME, !"Введите текст сообщения");
		return ShowPlayerDialog(playerid, D_FRACTION_FUNC_6, DIALOG_STYLE_INPUT, " ", ""colwhi"Это сообщение будут видеть сотруднки Вашей организации\nКаждый раз при входе в игру:", "Принять", "Отмена");
		}
		else
		{
		format(fInfo[fraction_id][fMessage], 256, "%s", inputtext);
		new string_[256];
		format(string_, sizeof string_, "Приветствие: "colwhi"", fInfo[fraction_id][fMessage]);
		SendClientMessage(playerid, COLOR_SERVER, string_);
		SendClientMessage(playerid, COLOR_LIME, !"Вы успешно установили сообщение при входе!");
		SaveFractionString(pInfo[playerid][pMember], "fMessage", fInfo[fraction_id][fMessage]);
		}
		return 1;
	}
	case D_FRACTION_FUNC_7:
	{
	    if (!response) return 1; 
	    new fraction_id = pInfo[playerid][pMember];
	    t_string[0] = EOS ;
	    switch(listitem)
	    {//
	        case 0://[0] Основные настройки
		{
			if (GetPlayerData(playerid, pLeader) == INVALID_FRACTION_ID && pInfo[playerid][pAdmin] < 1)  return SendClientMessage(playerid, COLOR_GREY, !"Вы не лидер организации!");
			new
			assistan_name[MAX_PLAYER_NAME],
			string_[146],
		        mes_text[12];
			if (!strcmp(fInfo[fraction_id][fAssistant],"None",true)) assistan_name = ""colwarn"Нет";
			else format(assistan_name, MAX_PLAYER_NAME, ""collime"%s",fInfo[fraction_id][fAssistant]);

			if (!strcmp(fInfo[fraction_id][fMessage], "None",true)) mes_text = ""colwarn"Нет";
			else format(mes_text, 12, ""collime"%s", fInfo[fraction_id][fMessage]);
			
			strcat(t_string, ""colserver"[№] Описание\t"colserver"Настройка\n");
			format(string_, sizeof string_, ""colwhi"[0] Заместитель:\t%s\n", assistan_name);
			strcat(t_string, string_) ;
			format(string_, sizeof string_, ""colwhi"[1] Сообщение при входе:\t"colserver"%s\n", fInfo[fraction_id][fMessage]);
			strcat(t_string, string_) ;
			format(string_, sizeof string_, ""colwhi"[2] Разрешение принимать:\t"colserver"%s\n", fFractionRank[fraction_id][ fInfo[fraction_id][fHelper][0] - 1 ]);
			strcat(t_string, string_) ;
			format(string_, sizeof string_, ""colwhi"[3] Разрешение увольнять:\t"colserver"%s\n", fFractionRank[fraction_id][ fInfo[fraction_id][fHelper][1] - 1 ]);
			strcat(t_string, string_) ;
			format(string_, sizeof string_, ""colwhi"[4] Разрешение повышать:\t"colserver"%s\n", fFractionRank[fraction_id][ fInfo[fraction_id][fHelper][2] - 1 ]);
			strcat(t_string, string_) ;
			format(string_, sizeof string_, ""colwhi"[5] Разрешение понижать:\t"colserver"%s\n", fFractionRank[fraction_id][ fInfo[fraction_id][fHelper][3] - 1 ]);
			strcat(t_string, string_) ;
			format(string_, sizeof string_, ""colwhi"[6] Разрешение снимать деньги:\t"colserver"%s\n", fFractionRank[fraction_id][ fInfo[fraction_id][fHelper][4] - 1 ]);
			strcat(t_string, string_) ;
			format(string_, sizeof string_, ""colwhi"[7] Разрешение менять скин:\t"colserver"%s\n", fFractionRank[fraction_id][ fInfo[fraction_id][fHelper][5] - 1 ]);
			strcat(t_string, string_) ;
			format(string_, sizeof string_, ""colwhi"[8] Анти Team-Kill:\t"colserver"%s\n", fInfo[fraction_id][fAntiTK]?(""collime"Включен"):(""colwarn"Выключен"));
			strcat(t_string, string_) ;
			ShowPlayerDialog(playerid, D_FRACTION_FUNC_1, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Настройки организации", t_string, "Выбрать", "Закрыть");
		}
		case 1://[1] Участники организации
		{
		    ShowPlayerDialog(playerid, D_FRACTION_FUNC_8, DIALOG_STYLE_LIST, ""colserver"Участники организации", "[0] Все участники организации [OFFLINE]\n[1] Фильтр по рангу\n[2] Участники организации [ONLINE]\n[3] Очистить Черный список\n[4] Посмотреть Черный список", "Выбрать", "Назад");
		}
		case 2://[2] Управление транспортом
		{
		    new count_v = 0 ;
			for(new vehicleid = 0 ; vehicleid < S_VEHICLE_COUNT ; vehicleid ++)
			{
			if ( ! IsValidVehicle ( vehicleid + 1 ) ) continue ;
			if (VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_FRACTION || VehicleInfo[vehicleid][vFraction] != pInfo[playerid][pMember]) continue ;
			count_v ++ ;
			}
			SetPVarInt(playerid, "fPanel_Count_Vehicle", count_v);
			
			format(t_string, sizeof t_string, "Респавн всех фракционных машин\t$%d\n", count_v*1000) ;
			new veh_point = 0 ;
			for(new vehicleid = 0, line_string[100]; vehicleid < S_VEHICLE_COUNT ; vehicleid ++)
			{
			if (!IsValidVehicle(vehicleid + 1)) continue;
			if (VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_FRACTION || VehicleInfo[vehicleid][vFraction] != pInfo[playerid][pMember]) continue;
			veh_point ++; 
			if (IsAGang(playerid))
			{
				if (VehicleInfo[vehicleid][vTempModel] != 0) {
				format(line_string, sizeof line_string, ""colwhi"[%d] %s(%d) до: "collime"%s\t"colwhi"Доступен с %d ранга\n", 
					veh_point, 
					VehicleNames[VehicleInfo[vehicleid][vTempModel]-400], 
					VehicleInfo[vehicleid][vTempModel],
					date("%dd.%mm, %hh:%ii", VehicleInfo[vehicleid][vTimeModel]),
					VehicleInfo[vehicleid][vRank] 
				);
				} 
				else {
				format(line_string, sizeof line_string, ""colwhi"[%d] %s(%d)\tДоступен с %d ранга\n", 
					veh_point, 
					VehicleNames[VehicleInfo[vehicleid][vModel]-400], 
					VehicleInfo[vehicleid][vModel],
					VehicleInfo[vehicleid][vRank]
				);
				}
			}
			else //format(line_string, sizeof line_string, "[%d] %s(%d)\t"collime"$1000\n", veh_point, VehicleNames[ VehicleInfo[vehicleid][vModel] - 400 ], VehicleInfo[vehicleid][vModel]);
			{
				format(line_string, sizeof line_string, ""colwhi"[%d] %s(%d)\tДоступен с %d ранга\n", 
				veh_point, 
				VehicleNames[VehicleInfo[vehicleid][vModel]-400], 
				VehicleInfo[vehicleid][vModel],
				VehicleInfo[vehicleid][vRank]
				);
			} 
			strcat(t_string, line_string);
			ShowPlayerDialog(playerid, D_FRACTION_FUNC_14, DIALOG_STYLE_TABLIST, ""colserver"Управления транспортом", t_string, "Выбрать", "Назад");
			}
		}
		case 3: //[3] Управление рангами:
		{
			if (GetPlayerData(playerid, pLeader) == INVALID_FRACTION_ID && pInfo[playerid][pAdmin] < 1)  return SendClientMessage(playerid, COLOR_GREY, !"Вы не лидер организации!");
		    ShowPlayerDialog(playerid, D_FRACTION_FUNC_16, 2, ""colserver"Настройка: "colwhi"Рангов","[0] Изменить название рангов\n[1] Вернуть стандартные ранги","Далее","Отмена");
		}
		case 4: {//[4] Управление бюджетом: || Управление дипломатией
			if (GetPlayerData(playerid, pLeader) == INVALID_FRACTION_ID && pInfo[playerid][pAdmin] < 1)  return SendClientMessage(playerid, COLOR_GREY, !"Вы не лидер организации!");
			if (!IsAGang(playerid) && !IsAMafia(playerid) && !IsABiker(playerid)) {
			ShowEconomyFraction(playerid); 
			}
			else {
			if(!IsAGang(playerid) && !IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, !"В данный момент команда не доступна байкерам!");
			ShowDialogDiplomationCriminals(playerid);
			}
		}
		}
		return 1;
	}
		
	case D_FRACTION_FUNC_SELECT: {
		if (!response) {
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_SALARY, DIALOG_STYLE_LIST, ""colserver"Настройка: "colwhi"Зарплаты","\
			[0] Изменить зарплаты рангов\n\
			[1] Изменить зарплату по формуле (мин. - макс.)\n\
			[2] Вернуть стандартные зарплаты",
			"Далее","Отмена"
		);
		return true;
		}
		playerListItem[playerid][0] = listitem;

		ShowPlayerDialog(playerid, D_FRACTION_FUNC_EDIT, DIALOG_STYLE_INPUT, ""colserver"Настройка зарплат: "colwhi"Изменение", "\
		"colwhi"Введите новую зарплату название для ранга:\n\n", 
		"Изменить", "Oтмена"
		);
		return true;
	}
	case D_FRACTION_FUNC_EDIT: {
		if (!response) {
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_SALARY, DIALOG_STYLE_LIST, ""colserver"Настройка: "colwhi"Зарплаты","\
			[0] Изменить зарплаты рангов\n\
			[1] Изменить зарплату по формуле (мин. - макс.)\n\
			[2] Вернуть стандартные зарплаты",
			"Далее","Отмена"
		);
		return true;
		}
		new salary = strval(inputtext);
		if (!(FRACTION_MIN_SALARY <= salary <= FRACTION_MAX_SALARY)) {
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_EDIT, DIALOG_STYLE_INPUT, ""colserver"Настройка зарплат: "colwhi"Изменение", "\
			"colwhi"Введите новую зарплату название для ранга\n", 
			"Изменить", "Oтмена"
		);
		SendMes(playerid, COLOR_GREY, "Ошибка! Введите значение от $%d до $%d.", FRACTION_MIN_SALARY, FRACTION_MAX_SALARY);
		return true;
		}
		new fraction_id = pInfo[playerid][pMember], rank = playerListItem[playerid][0];
		fFractionSalary[fraction_id][rank] = salary;

		SaveFractionSalary(fraction_id);

		t_string[0] = EOS;
		for (new i = 0; i < gFracionCountRank[fraction_id - 1]; i++) {
	
		format(t_string, sizeof (t_string), "%s\
			[%d] %s\t[$%d]\n", t_string, i + 1, fFractionRank[fraction_id][i], fFractionSalary[fraction_id][i]
		);
		}
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_SELECT, DIALOG_STYLE_TABLIST, ""colserver"Настройка зарплат: "colwhi"Выберите ранг", 
		t_string, "Выбрать", "Отмена"
		);
		t_string[0] = EOS;
		SendClientMessage(playerid, COLOR_WHITE, !"Вы установили новую зарплату!");
		return true;
	}
	case D_FRACTION_FUNC_FORMULE: {
		if (!response) {
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_SALARY, DIALOG_STYLE_LIST, ""colserver"Настройка: "colwhi"Зарплаты","\
			[0] Изменить зарплаты рангов\n\
			[1] Изменить зарплату по формуле (мин. - макс.)\n\
			[2] Вернуть стандартные зарплаты",
			"Далее","Отмена"
		);
		return true;
		}
		new fraction_id = pInfo[playerid][pMember], min_salary, max_salary;
		if (sscanf(inputtext, "p<,>ii", min_salary, max_salary) || max_salary < (min_salary + 1000) || min_salary < FRACTION_MIN_SALARY || max_salary > FRACTION_MAX_SALARY) {
		SendMes(playerid, COLOR_GREY, "Ошибка! Введите значение от $%d до $%d.", FRACTION_MIN_SALARY, FRACTION_MAX_SALARY);

		ShowPlayerDialog(playerid, D_FRACTION_FUNC_FORMULE, DIALOG_STYLE_INPUT, ""colserver"Настройка зарплат: "colwhi"Изменить по формуле", 
			"Введите минимальную и максимальную зарплаты через запятую:\n\n\
			Примечание: система сама выстроит по формуле зарплаты (Например: 1000, 5000)", "Принять", "Отмена"
		);
		return true;
		}
		new 
		max_rank = gFracionCountRank[fraction_id - 1], 
		step_pay = (max_salary + min_salary) / 2 / (max_rank - 1);

		for (new i = 0, pay_check; i < max_rank; i++) {
		if (i == 0) 
			pay_check = min_salary;
		/*else if (i == (max_rank - 1)) 
			pay_check = max_rank;*/
		else pay_check += step_pay;

		fFractionSalary[fraction_id][i] = pay_check;
		if (fFractionSalary[fraction_id][i] < 0) fFractionSalary[fraction_id][i] = 0;
		}
		SaveFractionSalary(fraction_id);

		ShowPlayerDialog(playerid, D_FRACTION_FUNC_SALARY, DIALOG_STYLE_LIST, ""colserver"Настройка: "colwhi"Зарплаты","\
		[0] Изменить зарплаты рангов\n\
		[1] Изменить зарплату по формуле (мин. - макс.)\n\
		[2] Вернуть стандартные зарплаты",
		"Далее","Отмена"
		);
		SendClientMessage(playerid, COLOR_WHITE, !"Вы установили зарплаты в организации!");
		return true;
	}

	

	case D_FRACTION_FUNC_SALARY: {
		if (!response) {
		callcmd::lpanel(playerid);
		return true;
		}
		new fraction_id = pInfo[playerid][pMember];
		
		switch (listitem) {
		case 0: { // select (rank) -> edit
			t_string[0] = EOS;
			for (new i = 0; i < gFracionCountRank[fraction_id - 1]; i++) {
			format(t_string, sizeof (t_string), "%s\
				[%d] %s\t[$%d]\n", t_string, i + 1, fFractionRank[fraction_id][i], fFractionSalary[fraction_id][i]
			);
			}
			ShowPlayerDialog(playerid, D_FRACTION_FUNC_SELECT, DIALOG_STYLE_TABLIST, ""colserver"Настройка зарплат: "colwhi"Выберите ранг", 
			t_string, "Выбрать", "Отмена"
			);
			t_string[0] = EOS;
		}
		case 1: { // formule
			ShowPlayerDialog(playerid, D_FRACTION_FUNC_FORMULE, DIALOG_STYLE_INPUT, ""colserver"Настройка зарплат: "colwhi"Изменить по формуле", 
			"Введите минимальную и максимальную зарплаты через запятую:\n\n\
			Примечание: система сама выстроит по формуле зарплаты.)", "Принять", "Отмена"
			);
		}
		case 2: { // default
			t_string[0] = EOS;
		
			new 
			min_salary = gFractionDefaultSalary[fraction_id][0], max_salary = gFractionDefaultSalary[fraction_id][1],
			max_rank = gFracionCountRank[fraction_id - 1], 
			step_pay = (max_salary + min_salary) / 2 / (max_rank - 1);

			for (new i = 0, pay_check; i < max_rank; i++) {
			if (i == 0) 
				pay_check = min_salary;
			/*else if (i == (max_rank - 1)) 
				pay_check = max_rank;*/
			else pay_check += step_pay;

			fFractionSalary[fraction_id][i] = pay_check;
			if (fFractionSalary[fraction_id][i] < 0) fFractionSalary[fraction_id][i] = 0;
			}
			
			SaveFractionSalary(fraction_id);
			SendClientMessage(playerid, COLOR_WHITE, !"Вы установили стандартные зарплаты в организации!");

			ShowPlayerDialog(playerid, D_FRACTION_FUNC_SALARY, DIALOG_STYLE_LIST, ""colserver"Настройка: "colwhi"Зарплаты","\
			[0] Изменить зарплаты рангов\n\
			[1] Изменить зарплату по формуле (мин. - макс.)\n\
			[2] Вернуть стандартные зарплаты",
			"Далее","Отмена"
			);
		}
		}
		return true;
	}
	case D_FRACTION_FUNC_8:
	{
		if (!response) return callcmd::lpanel(playerid);
		switch(listitem)
		{
