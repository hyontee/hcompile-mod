	}
	case D_SELECT_JOB_GOV_1:
	{
		if (!response) return 1;
		LeavePlayerTaxi(playerid);
		switch(listitem)
		{
		case 0:
		{
			if (pInfo[playerid][pLevel] < 2) return	SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 2 лвл");
			pInfo[playerid][pJob] = 1;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Водителя автобуса");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /route - начать/закончить работу водителя автобуса ))");
		}
		case 1:
		{
			if (pInfo[playerid][pLevel] < 2) return SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 2 лвл");
			pInfo[playerid][pJob] = PLAYER_JOB_TAXI;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Водителя такси");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /fare - начать/закончить работу водителя такси, /f - рация ))");
		}
		case 2:
		{
			if (pInfo[playerid][pLevel] < 2) return	SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 2 лвл");
			pInfo[playerid][pJob] = 3;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Продавца Хот-Догов");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /hcontract - подписать контракт с закусочной для продажи Хот Догов ))");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /selleat - продать хот дог, /hcounter - занять прилавок для продажи Хот Догов ))");
		}
		case 3:
		{
			if (pInfo[playerid][pLevel] < 3) return	SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 3 лвл");
			pInfo[playerid][pJob] = 5;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Развозчика продуктов");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /prodmenu - закупка продуктов ))");
		}
		case 4:
		{
			if (pInfo[playerid][pLevel] < 3) return SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 3 лвл");
			pInfo[playerid][pJob] = PLAYER_JOB_MECHANIC;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Механика");
                    SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /mcontract - заключить контракт с заправкой, /repair - починить, /refill - заправить ))");
		}
                case 5:
		{
			if (pInfo[playerid][pLevel] < 3) return	SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 3 лвл");
			pInfo[playerid][pJob] = 8;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Инкассатора");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Доберитесь до стоянки и приступайте к работе ))");
		}
		case 6:
		{
			if (pInfo[playerid][pLevel] < 5) return	SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 5 лвл");
			pInfo[playerid][pJob] = 9;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Прораба");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /gcontract - выдать контракт, /gpayday - выдать зарплату ))");
		}
		case 7:
		{
			if (pInfo[playerid][pLevel] < 6) return	SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 6 лвл");
			pInfo[playerid][pJob] = 6;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Тренера");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /fgstyle - обучение стилям боя ))");
		}
		case 8:
		{
			if (pInfo[playerid][pLevel] < 6) return SendClientMessage(playerid, COLOR_GRAD1, !"Вам требуется 6 лвл");
			pInfo[playerid][pJob] = JOB_TRUCKER;
			SendClientMessage(playerid, 0x6495EDFF, !"Вас успешно приняли на работу Дальнобойщика");
			SendClientMessage(playerid, 0x6495EDFF, !"(( Команды: /tskill - информация, /tmonitor - мониторинг цен, /f - рация ))"); 
		}
		}
		return 1;
	}
	case D_TAKELIST_PD_0:
	{
	    if (!response) return 1;
		if (response)
		{
		switch(listitem)
		{
			case 0:	ShowPlayerDialog(playerid, D_TAKELIST_PD_1, DIALOG_STYLE_INPUT, "Видительские права", "Введите ид игрока", "Изъять", "Отмена");
			case 1:	ShowPlayerDialog(playerid, D_TAKELIST_PD_1, DIALOG_STYLE_INPUT, "Лицензия пилота", "Введите ид игрока", "Изъять", "Отмена");
			case 2: ShowPlayerDialog(playerid, D_TAKELIST_PD_1, DIALOG_STYLE_INPUT, "Лицензия на лодки", "Введите ид игрока", "Изъять", "Отмена");
			case 3:	ShowPlayerDialog(playerid, D_TAKELIST_PD_1, DIALOG_STYLE_INPUT, "Лицензия на охоту", "Введите ид игрока", "Изъять", "Отмена");
			case 4:	ShowPlayerDialog(playerid, D_TAKELIST_PD_1, DIALOG_STYLE_INPUT, "Лицензия на оружие", "Введите ид игрока", "Изъять", "Отмена");
			case 5:	ShowPlayerDialog(playerid, D_TAKELIST_PD_1, DIALOG_STYLE_INPUT, "Материалы", "Введите ид игрока", "Изъять", "Отмена");
			case 6:	ShowPlayerDialog(playerid, D_TAKELIST_PD_1, DIALOG_STYLE_INPUT, "Наркотики", "Введите ид игрока", "Изъять", "Отмена");
			case 7: ShowPlayerDialog(playerid, D_TAKELIST_PD_1, DIALOG_STYLE_INPUT, "Оружие", "Введите ид игрока", "Изъять", "Отмена");
		}
		SetPVarInt(playerid,#TakeListItem,listitem);
		}
		return 1;
	}
	case D_TAKELIST_PD_1:
	{
	    if (!response) return 1;
		if (response)
		{
		    new take_id = strval(inputtext),string_[128];
		if (take_id == INVALID_PLAYER_ID) return	SendClientMessage(playerid, COLOR_GREY, !"Игрок не найден");
		if (!IsPlayerInRangeOfPlayer(8.0, playerid, take_id)) return SendClientMessage(playerid, COLOR_GREY, !"Нарушитель не возле вас!");
		switch(GetPVarInt(playerid,#TakeListItem))
		{
		    case 0:
		    {
		        if (pInfo[take_id][pLicense][0] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У человека нет данной лицензии!");
		        format(string_, sizeof(string_), "%s забрал(а) у %s водительские права", pInfo[playerid][pName],pInfo[take_id][pName]);
			ClearPlayerLicense(take_id, DRIVE_LIC); 
		    }
			case 1: //Воздушная лица
			{
			    if (pInfo[take_id][pLicense][1] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У человека нет данной лицензии!");
                        format(string_, sizeof(string_), "%s забрал(а) у %s лицензию пилота", pInfo[playerid][pName],pInfo[take_id][pName]);
			ClearPlayerLicense(take_id, FLY_LIC);
			}
			case 2: //Лодки
			{
			    if (pInfo[take_id][pLicense][2] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У человека нет данной лицензии!");
			    format(string_, sizeof(string_), "%s забрал(а) у %s лицензию на лодки", pInfo[playerid][pName],pInfo[take_id][pName]);
			    ClearPlayerLicense(take_id, BOAT_LIC);
			}
			case 3: //Рыбалку
			{
			    if (pInfo[take_id][pLicense][3] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У человека нет данной лицензии!");
			    format(string_, sizeof(string_), "%s забрал(а) у %s лицензию на охоту", pInfo[playerid][pName],pInfo[take_id][pName]);
			    ClearPlayerLicense(take_id, FISH_LIC);
			}
			case 4: //Лиц Ганы
			{
			    if (pInfo[take_id][pLicense][4] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У человека нет данной лицензии!");
			    format(string_, sizeof(string_), "%s забрал(а) у %s лицензию на оружие", pInfo[playerid][pName],pInfo[take_id][pName]);
			    ClearPlayerLicense(take_id, GUN_LIC);
			}
			case 5: //Маты
			{
			    if (pInfo[take_id][pMats] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У человека нет метериалов!");
			    format(string_, sizeof(string_), "%s забрал(а) у %s материалы", pInfo[playerid][pName],pInfo[take_id][pName]);
			    pInfo[take_id][pMats] = 0; 
			}
			case 6: //Нарко
			{ 
			if (pInfo[take_id][pDrugs] == 0) return SendClientMessage(playerid, COLOR_GREY, !"У человека нет наркотиков!");

			if (pInfo[playerid][pRank] > 3) {
				OnPlayerQuestProgress(playerid, QUEST_PD, QUEST_TASK_PD_DRUGS, pInfo[take_id][pDrugs]);
				OnPlayerQuestProgress(playerid, QUEST_FBI, QUEST_TASK_FBI_DRUGS, pInfo[take_id][pDrugs]);
			}
			if (IsAGosFraction(take_id)) {
				OnPlayerQuestProgress(playerid, QUEST_FBI, QUEST_TASK_FBI_TAKE, pInfo[take_id][pDrugs]);
			}

			    format(string_, sizeof(string_), "%s забрал(а) у %s наркотики", pInfo[playerid][pName],pInfo[take_id][pName]);
			    pInfo[take_id][pDrugs] = 0; 
			}
			case 7: //Нагы
			{
			    format(string_, sizeof(string_), "%s забрал(а) у %s оружие", pInfo[playerid][pName],pInfo[take_id][pName]);
			    ResetPlayerWeapons(take_id);
			}
		} 
		SendBeside(playerid,COLOR_PURPLE,string_,10.0);
		DeletePVar(playerid,#TakeListItem);
		return 1;
		}
	}  
	#if defined _stalls_inc
	case D_STALL_MENU: {
		if (!response) {
		return true;
		}
		new 
		// id = pTemp[playerid][tStallID], 
		itemid = playerListItem[playerid][listitem],
		price = StallMenuInfo[itemid][stallMenuPrice] ;

		ShowStallMenu(playerid);

		if (!price) {
		SendClientMessage(playerid, COLOR_BLUE, "Вы поели бесплатную быструю еду!");
		
