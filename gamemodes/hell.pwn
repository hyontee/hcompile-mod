	#if defined _poker_included
	case DIALOG_POKER_LEAVE: {
		if (!response)
		return true;
		if (pInfo[playerid][pPokerTutorialStep])
		poker_StopTutorial(playerid);
		else poker_LeaveGame(playerid);

		return true;
	}
	case DIALOG_POKER_CALL: {
		pInfo[playerid][pPokerActionActive] = 0;

		if (!response)
		return true;
		new
		tableid = (pInfo[playerid][pPokerTableID] - 1),
		poker_actual_bet = (pokerTableInfo[tableid][pokerTableBet] - pInfo[playerid][pPokerBet])
		;
		new poker_text_td[MAX_PLAYER_NAME + 22];
		if (poker_actual_bet > (pInfo[playerid][pPokerChips] + pInfo[playerid][pPokerBet])) {
		pInfo[playerid][pPokerBet] += pInfo[playerid][pPokerChips];
		pInfo[playerid][pPokerChips] = 0;
		}
		else {
		pInfo[playerid][pPokerChips] -= poker_actual_bet;
		pInfo[playerid][pPokerBet] = pokerTableInfo[tableid][pokerTableBet];
		}
		//SetPlayerInt(GetName(playerid), "casino_chips", pInfo[playerid][pPokerChips]);
		pokerTableInfo[tableid][pokerTablePot] += pInfo[playerid][pPokerBet];
		format(pInfo[playerid][pPokerStatus_STR], 32, "~p~%d~n~~y~CALLED", pInfo[playerid][pPokerBet]);

		pInfo[playerid][pPokerRaisedTime] = 0;

		format(poker_text_td, sizeof(poker_text_td), "%s ~y~CALLED TO ~p~%d", GetName(playerid), pInfo[playerid][pPokerBet]);
		poker_SendChat(tableid, poker_text_td);
		poker_NextTurn(tableid);

		ApplyAnimation(playerid, "CASINO", "cards_raise", 4.1, 0, 1, 1, 1, 1, 1);

		return true;
	}
	case DIALOG_POKER_RAISE: {
		pInfo[playerid][pPokerActionActive] = 0;

		if (!response)
		return true;
		new
		tableid = (pInfo[playerid][pPokerTableID] - 1),
		poker_actual_raise = strval(inputtext) - pInfo[playerid][pPokerBet]
		;
		if (strval(inputtext) >= pokerTableInfo[tableid][pokerTableBet] + pokerTableInfo[tableid][pokerTableBlind] / 2 && strval(inputtext) <= pInfo[playerid][pPokerBet] + pInfo[playerid][pPokerChips]) {
		pInfo[playerid][pPokerRaised] = pokerTableInfo[tableid][pokerTableCardsActive];
		pInfo[playerid][pPokerRaisedTime]++;
		pokerTableInfo[tableid][pokerTableLastRaiseID] = playerid;

		pInfo[playerid][pPokerChips] -= poker_actual_raise;
		pInfo[playerid][pPokerBet] = (pokerTableInfo[tableid][pokerTableBet] = strval(inputtext));
		format(pInfo[playerid][pPokerStatus_STR], 32, "~p~%d~n~~y~RAISED", pInfo[playerid][pPokerBet]);

		//SetPlayerInt(GetName(playerid), "casino_chips", pInfo[playerid][pPokerChips]);
		pokerTableInfo[tableid][pokerTablePot] += poker_actual_raise;
		pokerTableInfo[tableid][pokerTableRot] = 0;

		new poker_text_td[MAX_PLAYER_NAME + 22];
		format(poker_text_td, sizeof(poker_text_td), "%s ~y~RAISED TO ~p~%d", GetName(playerid), pInfo[playerid][pPokerBet]);
		poker_SendChat(tableid, poker_text_td);

		poker_NextTurn(tableid);

		ApplyAnimation(playerid, "CASINO", "cards_raise", 4.1, 0, 1, 1, 1, 1, 1);
		}
		else poker_ShowMenu(playerid, PM_MENU_RAISE);

		return true;
	}
	#endif

	#if defined _blackjack_included
	case DIALOG_BLACKJACK_BET: {
