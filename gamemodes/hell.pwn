		{
		    if (VacancyInfo[i][VacancyStatus] == true) items++;
		    if (items - 1 == listitem)
		{
		        t_string[0] = EOS;
			format(t_string, sizeof t_string, 
			""colwhi"Организация: %s, Автор: "collime"%s\n"colmaline"- Критерии:\n\t"colwhi"%s\n", 
			fInfo[ VacancyInfo[i][VacancyFraction] ] [fName], VacancyInfo[i][VacancyOwner], VacancyInfo[i][VacancyText]
			);
			
			if (VacancyInfo[i][VacancyFraction] != pInfo[playerid][pLeader]) {
			return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""colserver"Вакансия", t_string, "Закрыть", ""), t_string[0] = EOS;
			}
			return ShowPlayerDialog(playerid, D_VACANCY_2, DIALOG_STYLE_MSGBOX, ""colserver"Вакансия", t_string, "Удалить", "Закрыть"), t_string[0] = EOS;
		    }
		}
	}
