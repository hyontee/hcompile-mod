        case D_GPS_FUNC_3:
	{
            if (!response) return callcmd::gps(playerid); 
            new
                distance,
                string_[64];
            t_string[0] = EOS;
            format(t_string, sizeof t_string, ""colserver"[№] Название\t"colserver"Расстояние\n"); 
            for (new id = 0, idx = 0; id < sizeof (BusinessInfo); id++)
            {
                if (!IsValidBusiness(id)) continue;
                if (listitem == 0) {
                    if (BusinessInfo[id][bType] != BUSINESS_TYPE_24_7) continue;
                }
                if (listitem == 1) {
                    if (BusinessInfo[id][bType] != BUSINESS_TYPE_CLUCKIN_BELL && BusinessInfo[id][bType] != BUSINESS_TYPE_PIZZA && BusinessInfo[id][bType] != BUSINESS_TYPE_BURGER_SHOT) continue;
                }
                if (listitem == 2) {
                    if (BusinessInfo[id][bType] != BUSINESS_TYPE_BAR && BusinessInfo[id][bType] != BUSINESS_TYPE_CLUB) continue;
                }
                if (listitem == 3) {
                    if (BusinessInfo[id][bType] != BUSINESS_TYPE_AMMO) continue;
                }
                if (listitem == 4) {
                    if (BusinessInfo[id][bType] != BUSINESS_TYPE_VICTIM && BusinessInfo[id][bType] != BUSINESS_TYPE_ZIP 
                        && BusinessInfo[id][bType] != BUSINESS_TYPE_SUB_URBAN && BusinessInfo[id][bType] != BUSINESS_TYPE_BINCO 
                        && BusinessInfo[id][bType] != BUSINESS_TYPE_PROLAPS && BusinessInfo[id][bType] != BUSINESS_TYPE_DIDIER_SACH) continue;
                }
                if (listitem == 5) {
                    if (BusinessInfo[id][bType] != BUSINESS_TYPE_GAS) continue;
                }
                if (listitem == 6) {
                    if (BusinessInfo[id][bType] != BUSINESS_TYPE_CUSTOMS && BusinessInfo[id][bType] != BUSINESS_TYPE_CARAVAN 
                        && BusinessInfo[id][bType] != BUSINESS_TYPE_CASINO) continue;
                }
                distance = floatround(floatsqroot(floatpower(BusinessInfo[id][bPos][0] - pTemp[playerid][tPos][0], 2) + floatpower(BusinessInfo[id][bPos][1] - pTemp[playerid][tPos][1], 2) + floatpower(BusinessInfo[id][bPos][2] - pTemp[playerid][tPos][2], 2)));
                format(string_, sizeof string_, "[%d] %s\t%d м.\n", id, BusinessInfo[id][bName], distance);
                strcat(t_string, string_);
                playerListItem[playerid][idx++] = id;
            }
            ShowPlayerDialog(playerid, D_GPS_FUNC_11, DIALOG_STYLE_TABLIST_HEADERS, ""colmain"Бизнесы", t_string, "Выбрать", "Назад"); 
		return 1;
	}
