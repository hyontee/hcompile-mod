public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
	#if defined _ac_ser_inc
	if (AC_Info[playerid][acSetPos] > GetTickCount() && 
	!IsPlayerInRangeOfPoint(playerid,30.0,AC_Info[playerid][acPosX],AC_Info[playerid][acPosY],AC_Info[playerid][acPosZ])) return 1;
	#endif

	if (pInfo[playerid][pLogin] != 1) return ackick(playerid, !"Вы не залогинены! [#1]");
    if (pickupid == PressedPickup[playerid]) return 1;
    PressedPickup[playerid] = pickupid;
	new PlayerPickUpPickupCount = GetTickCount();
	if (GetTickCount() - teleport_tick[playerid] < 3000) return 1;
	#if defined _businesses_inc
	if (business_OnPlayerPickUpPickup(playerid, pickupid)) return true;
	#endif
	if (Family_OnPlayerPickUpPickup(playerid, pickupid)) return true;

	if (Event_OnPlayerPickUpPickup(playerid, pickupid)) return true;
	
	#if defined _gym_inc
	if (gym_OnPlayerPickUpPickup(playerid, pickupid)) return true;
	#endif 

	/* new fractionMember = pInfo[playerid][pMember];

	static pickupIDs[3][3] = {
	{FRACTION_HOSPITAL_LS, 225, 226},
	{FRACTION_HOSPITAL_SF, 316, 317},
	{FRACTION_HOSPITAL_LV, 229, 230}
	};

	for (new i; i < 3; i++)
	{
	if (pickupid == pickupIDs[i][1] || pickupid == pickupIDs[i][2]) {
		if (fractionMember != pickupIDs[i][0]) {
		return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас нет ключей от данной двери.");
		}
	}
	} */
	for(new i = 1; i < MAX_VEHICLES ; i ++)
	{
	    new
		FARM_ID = pTemp[playerid][TempFermID];
	    
	    if (VehicleInfo[ i - 1 ][vType] == VEHICLE_TYPE_JOB_FARM
		&& (VehicleInfo[ i - 1 ][vFraction] == FARM_ID && VehicleInfo[ i - 1 ] [vSubFraction] == F_VEHILE_FARM_SEEDCAR))
	    {
	    
	    if (pickupid == Farmcar_pickup[i]/* && null*/)
	    {
		if (pTemp[playerid][JobInFarmRank] == 0) return SendClientMessage(playerid, CGRAY2, !"Сначала Вам нужно устроится на ферму!");
	        new Float:x, Float:y, Float:z;//FARM_ID = pTemp[playerid][TempFermID],
	        //if (FARM_ID != null) return 1;
		if (GetPVarInt(playerid,"farm_status") == 0)
		{
			DisablePlayerCheckpoint(playerid);
			RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_0);
			GetVehiclePos(i, x, y, z);
			GetXYInBackOfPlayer(i,x,y,3.0);
			if (random(2) == 0)
			{
			Farm_coord[playerid][0] = x+random(3)+2;
			Farm_coord[playerid][1] = y+random(3)+2;
			Farm_coord[playerid][2] = z;
			}
			else
			{
			Farm_coord[playerid][0] = x-random(3)-2;
			Farm_coord[playerid][1] = y-random(3)-2;
			Farm_coord[playerid][2] = z;
			}
			CP[playerid] = 0;
			SetPlayerCheckpoint(playerid, Farm_coord[playerid][0], Farm_coord[playerid][1], Farm_coord[playerid][2], 1.25);
			SetPVarInt(playerid,"farm_status", 1);
			SendClientMessage(playerid, COLOR_GREEN, !"Для начала соберите урожай{ffffff} (( Встаньте на красный чекпоинт, и ждите 15 секунд ))");
	   		SendClientMessage(playerid, COLOR_GREEN, !"Когда соберете положите в кузов автомобиля{ffffff} (( Встаньте на желтую стрелку ))");
	      	SendClientMessage(playerid, COLOR_GREEN, !"Если захотите завершить работу, пройдите к раздевалке{ffffff} (( Встаньте на синий пикап у фермы ))");
	        	SendClientMessage(playerid, COLOR_GREEN, !"Если вы фермер, то просто сядьте в машину для завершения сбора урожая");
		}
		else if (GetPVarInt(playerid,"farm_status") == 1) return SendClientMessage(playerid, COLOR_GREY, !"Вы ещё не собрали урожай");
		else if (GetPVarInt(playerid,"farm_status") == 2)
		{
			Farmcar_prods[i] += 5;

		    if (Farmcar_prods[i] >= 1000)
			{
			SendClientMessage(playerid, COLOR_GREY, !"Машина заполнена!");
			Farmcar_prods[i] = 1000;
			if (VehicleInfo[ i - 1 ][vFarmText] != Text3D:-1) {
				UpdateDynamic3DTextLabelText(VehicleInfo[ i - 1 ][vFarmText], 0x5CABBDFF, "Загружено\n{ffffff}1000 / 1000");
			} 
			return 1;
			}

		//	FarmStatHour[null][2] += 5;
			
			SetPVarInt(playerid,"farm_zp", GetPVarInt(playerid,"farm_zp") + FarmInfo[FARM_ID][fZp]);
			new string_[64];
			format(string_, sizeof string_, "~b~count:~w~%d$",GetPVarInt(playerid,"farm_zp"));
			GameTextForPlayer(playerid, string_, 3000, 1);
			DisablePlayerCheckpoint(playerid);
			SetPVarInt(playerid,"farm_status",1);
			RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_0);
	            GetVehiclePos(i, x, y, z);
	            GetXYInBackOfPlayer(i,x,y,3.0);
		    if (random(2) == 0) Farm_coord[playerid][0] = x+random(3)+2, Farm_coord[playerid][1] = y+random(3)+2, Farm_coord[playerid][2] = z;
			else Farm_coord[playerid][0] = x-random(3)-2, Farm_coord[playerid][1] = y-random(3)-2, Farm_coord[playerid][2] = z;
			SetPlayerCheckpoint(playerid,Farm_coord[playerid][0],Farm_coord[playerid][1],Farm_coord[playerid][2], 1.0);
			format(string_, sizeof string_, "Загружено\n{ffffff}%d / 1000",Farmcar_prods[i]);
			if (VehicleInfo[ i - 1 ][vFarmText] != Text3D:-1) {
			UpdateDynamic3DTextLabelText(VehicleInfo[ i - 1 ][vFarmText], 0x5CABBDFF, string_);
			}   
			//OLD QUEST
		}
		}
	}
	if ((VehicleInfo[ i - 1 ][vType] == VEHICLE_TYPE_JOB && VehicleInfo[ i - 1 ][vSubFraction] == DELIVERY_TYPE_0) && car_pickup[i] == pickupid)
	{
	    if (!IsPlayerInAnyVehicle(playerid) && pTemp[playerid][tGruzJob] == true && pTemp[playerid][tPlayerUseItemJob] == true)
		{ 
		    if (car_grain[i][0] + 100 > 1000) return SendClientMessage(playerid, COLOR_GREY, !"В авто нет места"), car_grain[i][0] = 1000;
		car_grain[i][0] += 100; 
		if (car_grain[i][0] > car_grain[i][1]) car_grain[i][0] = car_grain[i][1];
		
		if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
		pTemp[playerid][tSalaryJob][0] ++;
		DisablePlayerCheckpoint(playerid);
		ClearAnimations(playerid);
		new string_[64];
		format(string_, sizeof string_, "Мешков перетащено: %d", pTemp[playerid][tSalaryJob][0]);
		SendClientMessage(playerid, COLOR_GREEN, string_);
		ClearAnimations(playerid);
		pTemp[playerid][tPlayerUseItemJob] = false;
		SetPVarInt(playerid, "DownTickMeshki", GetTickCount());
		switch(random(6)) {
			case 0: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2239.3193,-2276.5266,14.3958-1.0,1.5));//Вагон 3
			case 1: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2233.3889,-2282.1833,14.3958-1.0,1.5));//Вагон 4
			case 2: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2227.5889,-2288.2412,14.3958-1.0,1.5));//Вагон 5
			case 3: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2221.9451,-2294.1477,14.3958-1.0,1.5));//Вагон 6
			case 4: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2216.0876,-2299.7507,14.3958-1.0,1.5));//Вагон 7
			default: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2210.2498,-2305.5447,14.3958-1.0,1.5));//Вагон 8
		} 
		string_[0] = EOS;
		format(string_, sizeof string_, "Загружено\n{ffffff}%d / 1000", car_grain[i][0]);
		if (VehicleInfo[ i - 1 ][vFarmText] != Text3D:-1) {
			UpdateDynamic3DTextLabelText(VehicleInfo[ i - 1 ][vFarmText], 0xFFFF00FF, string_);
		}  
		OnPlayerQuestProgress(playerid, QUEST_GUEST, QUEST_TASK_LOADER_BAGS);
		}
	}
	}
	for(new idx = 1; idx <= TOTALFARM; idx++)
	{
	if (pickupid == FarmInfo[idx][fPickup][0]) return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "Информация о работе", "Здесь вы можете поработать сборщиком урожая.\n\nЧто бы начать работу найдите фермера,\nон вам всё объяснит.\n\nНеподалеку находится раздевалка,\nтам же получать деньги.\n\nЧтобы начать работу необходимо переодеться в рабочую форму,\nдалее вам укажут где брать груз.\n\nКак только вы захотите завершить рабочий день,\nподойдите к раздевалке.", "Скрыть", "");
	if (pickupid == FarmInfo[idx][fPickup][1])
	{
		if (pTemp[playerid][TempFermID] != -1 && pTemp[playerid][TempFermID] != idx) return SendClientMessage(playerid,COLOR_GRAD1,!"Вы уже работаете на другой ферме");
		pTemp[playerid][TempFermID] = idx;
		ShowPlayerDialog(playerid, D_JOB_FARM, DIALOG_STYLE_MSGBOX, "Раздевалка", "Вы хотите начать рабочий день, или завершить?", "Начать", "Завершить");
	}
	}
	if(pickupid == gunlspd)
	{
		ShowPlayerDialog(playerid, 9995, DIALOG_STYLE_MSGBOX,"Набор сотрудника","Вы действительно хотите взять набор сотрудника депарматента?","Да","Нет");
	}
	/*if(pickupid == ammolspdd)
	{
		SetPlayerPos(playerid, 2266.6863,2208.3669,-90.6982);
		return 1;
	}
	if(pickupid == ammolspddd)
	{
		SetPlayerPos(playerid, 1529.0890,-1677.3572,5.8906);
		return 1;
	}*/
	if(pickupid == pickupodejda)
	{
		ShowPlayerDialog(playerid, 9997,DIALOG_STYLE_LIST, "Выберите номер одежды:","Одежда №1\nОдежда №2\nОдежда №3\nОдежда №4","Да","Нет");
		return 1;
	}
    if (pickupid == ChangeNameWed)
	{
	ShowPlayerDialog(playerid, D_DONATE_NAME_2, 1,""colserver"Смена: "colwhi"Смена имени","{ffffff}Вы желаете добавить заявку на смену имени?\nСтоимость смены имени "collime"$3.000.000.\n\
	Введите игровой ник, на который вы хотите поменять:","Далее","Отмена");
	return 1;
	}
	/*if (pickupid == ChangeFamiliaWed)
	{
	ShowPlayerDialog(playerid, D_DONATE_FAMILIA_2, 1,""colserver"Смена: "colwhi"Смена фамилии","{ffffff}Вы желаете добавить заявку на смену фамилии?\nСтоимость смены фамилии "collime"$3.000.000.\n\
	Введите фамилию, на который вы хотите поменять:","Далее","Отмена");
