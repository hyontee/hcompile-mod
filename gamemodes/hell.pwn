	case D_BIZZ_AUCTION_0:
	{
	    if (!response) return 1;
	    bizselect[playerid] = playerListItem[playerid][listitem];
		new
		str_[32],
		string_[256];
	    if (FarmInfo[bizselect[playerid]][fAuction][1] == 0) format(str_, sizeof str_,"%d",FarmInfo[bizselect[playerid]][fAuction][0]);
	    else format(str_, sizeof str_,"Скрыта");
	    format(string_, sizeof string_,"{FFFF00}Бизнес: Ферма [%d].\tДо окончания: %d час(а/ов)\n{ffffff}Предыдущая ставка: %d\n{ffffff}Текущая ставка: %s\n{33AA33}Сделать ставку",FarmInfo[bizselect[playerid]][fID]-1,FarmInfo[bizselect[playerid]][fAuction][2],FarmInfo[bizselect[playerid]][fAuction][1], str_);
	    ShowPlayerDialog(playerid, D_BIZZ_AUCTION_2, DIALOG_STYLE_LIST, ""colserver"Аукцион: "colwhi"Ферм", string_, "Далее", "Отмена");
		return 1;
	}
	case D_BIZZ_AUCTION_1:
	{
	    if (!response) return 1;
	    new string_[128], query_[128];
	    for(new i = 1; i <= TOTALFARM; i++)
		{
		if (!strcmp(pInfo[playerid][pName], FarmInfo[i][fAuctionName], true) && FarmInfo[i][fAuction][0] > 0)
		{
			return SendClientMessage(playerid, COLOR_GREY, !"Вы уже делали ставку на один из бизнесов");
		}
		}
	    if (pTemp[playerid][PlayerFarmID] != -1) return SendClientMessage(playerid, COLOR_GREY, !"У вас уже есть бизнес");
	    if (GetPlayerID(FarmInfo[bizselect[playerid]][fAuctionName]) == playerid && FarmInfo[bizselect[playerid]][fAuction][0] > 0)
		{
		return SendClientMessage(playerid, COLOR_GREY, !"Ваша ставка актуальна");
		}
	    if (strval(inputtext) < FarmInfo[bizselect[playerid]][fAuction][3]) return SendClientMessage(playerid, COLOR_WHITE, !"Вам не удалось перебить ставку.");
		if (strval(inputtext) < 100000 && FarmInfo[bizselect[playerid]][fAuction][3] == 0) return SendClientMessage(playerid, COLOR_WHITE, !"Вам не удалось перебить ставку.");
		if (pInfo[playerid][pBank] < strval(inputtext)) return SendClientMessage(playerid, COLOR_GREY, !"На вашем банковском счету недостаточно средств");
		if (strval(inputtext)-FarmInfo[bizselect[playerid]][fAuction][0] < 100000) return SendClientMessage(playerid, COLOR_GREY, !"Вам не удалось перебить ставку");
		if (FarmInfo[bizselect[playerid]][fAuction][3] == 0) FarmInfo[bizselect[playerid]][fAuction][3] = strval(inputtext)/2;
		FarmInfo[bizselect[playerid]][fAuction][1] = FarmInfo[bizselect[playerid]][fAuction][0];
		FarmInfo[bizselect[playerid]][fAuction][0] = strval(inputtext);
	        FarmInfo[bizselect[playerid]][fAuction][2] = 6;
		if (IsPlayerConnected(GetPlayerID(FarmInfo[bizselect[playerid]][fAuctionName])) && FarmInfo[bizselect[playerid]][fAuction][1] > 0)
		{
		    format(string_, sizeof string_,"Игрок %s перебил вашу ставку за Ферму [%d]",pInfo[playerid][pName],FarmInfo[bizselect[playerid]][fID]-1);
		SendClientMessage(GetPlayerID(FarmInfo[bizselect[playerid]][fAuctionName]),COLOR_INDIGO,string_);
		pInfo[GetPlayerID(FarmInfo[bizselect[playerid]][fAuctionName])][pBank] += FarmInfo[bizselect[playerid]][fAuction][1];
		SavePlayerInteger(GetPlayerID(FarmInfo[bizselect[playerid]][fAuctionName]), "pBank", pInfo[GetPlayerID(FarmInfo[bizselect[playerid]][fAuctionName])][pBank]);
		}
		else if (!IsPlayerConnected(GetPlayerID(FarmInfo[bizselect[playerid]][fAuctionName])) && FarmInfo[bizselect[playerid]][fAuction][1] > 0)
		{
		    mysql_format(dbHandle, query_, sizeof query_, "UPDATE `s_users` SET `pBank` = `pBank` + %d WHERE `Name` = '%e' LIMIT 1", FarmInfo[bizselect[playerid]][fAuction][1], FarmInfo[bizselect[playerid]][fAuctionName]);
                mysql_tquery(dbHandle, query_, "", "");
		}
	        strmid(FarmInfo[bizselect[playerid]][fAuctionName],pInfo[playerid][pName], 0, strlen(pInfo[playerid][pName]), MAX_PLAYER_NAME);
	        pInfo[playerid][pBank] -= strval(inputtext);
	        SavePlayerInteger(playerid, "pBank", pInfo[playerid][pBank]);
	
	        //LogingTargetMoney(playerid, playerid, strval(inputtext), "Перебил ставку за ферму");
		LogMoney(playerid, strval(inputtext), "Перебил ставку за ферму");
	        SaveActionsFerm(bizselect[playerid]);
	        format(string_, sizeof string_, "Вы перебили ставку за Ферму [%d]", FarmInfo[bizselect[playerid]][fID]-1);
		return SendClientMessage(playerid, COLOR_INDIGO, string_);
	}
	case D_BIZZ_AUCTION_2: if (response && listitem == 3) return ShowPlayerDialog(playerid,D_BIZZ_AUCTION_1,DIALOG_STYLE_INPUT,"Аукцион","Введите сумму ставки", "Поставить", "Отмена");
	case D_BUY_GOV_GUN:
	{
		if (!response) return DeletePVar(playerid,"lsaammo");
		if (GetPVarInt(playerid,"lsaammo") && lsamatbi < 100) return SendClientMessage(playerid, COLOR_GREY, !"На складе недостаточно материалов");
		else if (pInfo[playerid][pMember] == 1 && FractionInfo[1][fMaterials] < 100) return SendClientMessage(playerid, COLOR_GREY, !"На складе недостаточно материалов");
		else if (pInfo[playerid][pMember] == 2 && FractionInfo[2][fMaterials] < 100) return SendClientMessage(playerid, COLOR_GREY, !"На складе недостаточно материалов");
		else if (pInfo[playerid][pMember] == FRACTION_CITYHALL && FractionInfo[FRACTION_CITYHALL][fMaterials] < 100) return SendClientMessage(playerid, COLOR_GREY, !"На складе недостаточно материалов");
		else if (pInfo[playerid][pMember] == 10 && FractionInfo[10][fMaterials] < 100) return SendClientMessage(playerid, COLOR_GREY, !"На складе недостаточно материалов");
		else if (pInfo[playerid][pMember] == 21 && FractionInfo[21][fMaterials] < 100) return SendClientMessage(playerid, COLOR_GREY, !"На складе недостаточно материалов");
		else if (pInfo[playerid][pMember] == 3 && FractionInfo[3][fMaterials] < 100) return SendClientMessage(playerid, COLOR_GREY, !"На складе недостаточно материалов");
		else if (pInfo[playerid][pMember] == 19 && FractionInfo[19][fMaterials] < 100) return SendClientMessage(playerid, COLOR_GREY, !"На складе недостаточно материалов");
		new guns[2];
   		switch(listitem)
	    	{
      		case 0:
