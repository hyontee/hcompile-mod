		new
			report_id = GetPVarInt(playerid, "report_id_to_answer"),
			target_id = aReportInfo[report_id][rPlayerID];
		if (pInfo[playerid][pAdmin] >=1) {
		        SendMes(target_id, 0xD97700AA,  "Администратор %s[%d] отказался отвечать на вашу жалобу. Ожидайте ответа от другого администратора", pInfo[playerid][pName], playerid);
