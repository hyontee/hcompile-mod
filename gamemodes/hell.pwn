#include "../source/publics/vehicle/onvehiclestreamin.pwn"
#include "../source/publics/vehicle/onvehiclestreamout.pwn"*/
public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z)
{
	//printf("[DEBUG] OnUnoccupiedVehicleUpdate(vehicleid:%d | playerid:%d | passenger_seat:%d)", vehicleid, playerid, passenger_seat);
	#if defined _ac_inc
	s_ac_OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, new_x, new_y, new_z, vel_x, vel_y, vel_z);
	#endif
	new Float:Pos[3];
	GetVehiclePos(vehicleid, Pos[0], Pos[1], Pos[2]);
	new Float:Count[2];
	Count[0] = Difference(Pos[0], VehPos[vehicleid][0]);
	Count[1] = Difference(Pos[1], VehPos[vehicleid][1]);
	switch(GetVehicleModel(vehicleid))
	{
	case 435, 450, 584, 591, 606 .. 608, 610 .. 611: {
		
		goto UPDATE;
	}
	}
	if((Count[0] > 4 || Count[1] > 4) && !UseCar(vehicleid) && !BanCar[vehicleid]) {
	SetVehiclePosition(vehicleid, VehPos[vehicleid][0], VehPos[vehicleid][1], VehPos[vehicleid][2]);
	SetVehicleZAngle(vehicleid, VehPos[vehicleid][3]);
	} else {
	UPDATE:
	UpdateVehiclePos(vehicleid, false);
	}


	static Float: __z;
	GetVehiclePos(vehicleid, __z, __z, __z ) ;

	if (passenger_seat > 0)
	{
	static Float:ac_zdiff ;
	ac_zdiff = new_z - __z ;
	if ( ( floatabs ( vel_x ) >= floatabs ( VehicleInfo[ vehicleid - 1 ] [vVelocity][0]) > 0.3 ||
	floatabs ( vel_y ) >= floatabs ( VehicleInfo[ vehicleid - 1 ] [vVelocity] [ 1 ] ) > 0.3 || floatabs ( vel_x - VehicleInfo[ vehicleid - 1 ][vVelocity][0]) > 25.0 ||
	floatabs ( vel_y - VehicleInfo[ vehicleid - 1 ] [vVelocity][1]) > 25.0 ) && ac_zdiff > -5.0 )
	{
		scmKick(playerid, "Вы были кикнуты по подозрению в читерстве (AC - D10)");
		printf("Call OnPlayerWeaponShot [pLogin = 1] ID: %d (%s) | Kick D10 (%f)", playerid, pInfo[playerid][pName], ac_zdiff);
		/*if ( ++ carshot_cheat_count { playerid } > 3 )
		{ 
		scmKick(playerid,"Вы были отсоеденены от сервера! (Car SHOT) CODE: S1");
		}*/
	}
	}
	VehicleInfo[ vehicleid - 1 ][vNewPos][0] = new_x;
    VehicleInfo[ vehicleid - 1 ][vNewPos][1] = new_y;
    VehicleInfo[ vehicleid - 1 ][vNewPos][2] = new_z;


    VehicleInfo[ vehicleid - 1 ][vVelocity][0] = vel_x;
    VehicleInfo[ vehicleid - 1 ][vVelocity][1] = vel_y;

	if (GetVehicleDistanceFromPoint(vehicleid,new_x, new_y, new_z) < 0.0) return 0;
	GetVehiclePos(vehicleid, new_x, new_y, new_z);
	if (!IsPlayerInRangeOfPoint(playerid, 10, new_x, new_y, new_z)) return 0;

	if ( GetVehicleDistanceFromPoint ( vehicleid, new_x, new_y, new_z ) > 15.0 )
	{
	new Float:pos_x, Float:pos_y, Float:pos_z;
	GetVehiclePos(vehicleid, pos_x, pos_y, pos_z);
	printf("[DEBUG] GetVehicleDistanceFromPoint(vehicleid:%d | playerid:%d | passenger_seat:%d)", vehicleid, playerid, passenger_seat);
	if (pos_z > -70.0) SetVehiclePos(vehicleid, pos_x, pos_y, pos_z ) ;
	return 0;
 	}
	return 1;
}
