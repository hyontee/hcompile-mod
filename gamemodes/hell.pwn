			string_[200];
		sscanf(fInfo[ listitem+1 ][fLeader], "u", status_);
		if (IsPlayerConnected(status_)) ttextt = "("collime"Online"colwhi")";
		else ttextt = "("colwarn"Offline"colwhi")";
