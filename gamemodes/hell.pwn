		HouseInfo[TOTALHOUSE][hEnter][0] = x;
		HouseInfo[TOTALHOUSE][hEnter][1] = y;
		HouseInfo[TOTALHOUSE][hEnter][2] = z;
                switch(type)
		{
			case 0: HouseInfo[TOTALHOUSE][hIntID] = 1;
			case 1: HouseInfo[TOTALHOUSE][hIntID] = 5;
			case 2: HouseInfo[TOTALHOUSE][hIntID] = 11;
			case 3: HouseInfo[TOTALHOUSE][hIntID] = 22;
			case 4: HouseInfo[TOTALHOUSE][hIntID] = 27;
			case 5: HouseInfo[TOTALHOUSE][hIntID] = 34;
		}
		sscanf(coordh,"p<,>ffff", HouseInfo[TOTALHOUSE][hCar][0],HouseInfo[TOTALHOUSE][hCar][1],HouseInfo[TOTALHOUSE][hCar][2],HouseInfo[TOTALHOUSE][hCar][3]);
		HouseInfo[TOTALHOUSE][hValue] = price;//hValue
                HouseInfo[TOTALHOUSE][hKlass] = type;
		strmid(HouseInfo[TOTALHOUSE][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
		HouseInfo[TOTALHOUSE][hMIcon] = CreateDynamicMapIcon(HouseInfo[TOTALHOUSE][hEnter][0], HouseInfo[TOTALHOUSE][hEnter][1], HouseInfo[TOTALHOUSE][hEnter][2], 31, COLOR_WHITE, 0, -1, -1);
		HouseInfo[TOTALHOUSE][hPickup][0] = CreateDynamicPickup(1273, 23, HouseInfo[TOTALHOUSE][hEnter][0], HouseInfo[TOTALHOUSE][hEnter][1], HouseInfo[TOTALHOUSE][hEnter][2], 0, 0);
    		new idx = HouseInfo[TOTALHOUSE][hIntID];
		HouseInfo[TOTALHOUSE][hPickup][1] = CreateDynamicPickup(1275, 23, HouseInt[idx][hClothes][0], HouseInt[idx][hClothes][1], HouseInt[idx][hClothes][2], TOTALHOUSE+50, HouseInt[idx][hIntInterior]);
		new query_[300], string_[32];
		format(query_, sizeof query_, "INSERT INTO `house` (`hID`, `enterx`, `entery`, `enterz`, `hCarx`, `hCary`, `hCarz`, `hCarc`, `hValue`, `hLock`, `hKlass`, `hIntID`) VALUES ('%d', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%d', '1', '%d', '%d')",
		 	TOTALHOUSE, HouseInfo[TOTALHOUSE][hEnter][0], HouseInfo[TOTALHOUSE][hEnter][1], HouseInfo[TOTALHOUSE][hEnter][2], HouseInfo[TOTALHOUSE][hCar][0],HouseInfo[TOTALHOUSE][hCar][1],HouseInfo[TOTALHOUSE][hCar][2],HouseInfo[TOTALHOUSE][hCar][3], HouseInfo[TOTALHOUSE][hValue],
		 	HouseInfo[TOTALHOUSE][hKlass], HouseInfo[TOTALHOUSE][hIntID]);
		 	mysql_tquery(dbHandle, query_, "", "");
		printf("%s", query_);
		format(string_, sizeof string_, "Дом N%d Успешно создан", TOTALHOUSE);
		return scm(playerid, COLOR_YELLOW, string_);
		}
		CreateDynamicServerHome[playerid] = false;
	}
