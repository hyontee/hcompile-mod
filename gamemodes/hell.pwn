		if (FarmInfo[i][fLandTax] + params_ > 84000) return SendClientMessage(playerid, COLOR_GREY, !"Неверная сумма. Максимально допустимая сумма $84000 (7 дней)"), ShowPlayerDialog(playerid, D_FARM_FUNC_4, DIALOG_STYLE_INPUT, "Пополнить 'LandTax' счёт","Введите сумму для пополнения","Пополнить","Назад");
		if (params_ < 0 || params_ > pInfo[playerid][pBank]) return ShowPlayerDialog(playerid, D_FARM_FUNC_4, DIALOG_STYLE_INPUT, "Пополнить 'LandTax' счёт","Введите сумму для пополнения","Пополнить","Назад");
		FarmInfo[i][fLandTax] += params_;
		pInfo[playerid][pBank] -= params_;
		LogMoney(playerid, -params_, "перевел LandTax");
		SavePlayerInteger(playerid, "pBank", pInfo[playerid][pBank]);
		SaveFermID(i);
		format(string_,sizeof(string_)," Вы перевели на 'LandTax' счёт фермы $%d", params_);
		SendClientMessage(playerid,0x6BB3FFAA,string_);
		return ShowFarmPanel(playerid);
		}
