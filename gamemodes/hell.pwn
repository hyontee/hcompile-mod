		    if (gVehicleGun[vehicleid][vGunAmmo] <= 0) return SendClientMessage(playerid, COLOR_GRAD1, !"В матовозе нет оружия!");
		FractionInfo[19][fMaterials] += gVehicleGun[vehicleid][vGunAmmo];
		SaveFractionInfoID(FractionInfo[19][fID], false);
		gVehicleGun[vehicleid][vGunAmmo] = 0;
		format(string_, sizeof string_, "Материалы выгружены! В грузовике: %d/30000", gVehicleGun[vehicleid][vGunAmmo]);
		SendClientMessage(playerid, TEAM_GROVE_COLOR, string_);
		}
	}
	DisablePlayerCheckpoint(playerid);
	MatsArmyCar[playerid] = 0;
	}

	if (GetPVarInt(playerid,"GruzCheckpointImport") && pTemp[playerid][tGruzJob] == true) {
	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, !"Выйдите из т.с!");
	if (!pTemp[playerid][tGruzJob]) {
		DeletePVar(playerid,"GruzCheckpointImport");
		DisablePlayerCheckpoint(playerid);
	}
	else if (!pTemp[playerid][tPlayerUseItemJob]) 
	{
		DisablePlayerCheckpoint(playerid);
		DeletePVar(playerid,"GruzCheckpointImport");   
		static const Float:GruzSkladRand[][4] = { 
		{ 2160.9199,-2281.5935,13.3906, 1.0}, //3
		{ 2168.1482,-2274.2910,13.3900, 1.0}, //2
		{ 2175.5151,-2266.8533,13.3894, 1.0}//1
		}; 
		new rand = random(sizeof(GruzSkladRand));
		SetPVarInt(playerid, "GruzCheckpointTop",_:SetPlayerCheckpoint(playerid, GruzSkladRand[rand][0],GruzSkladRand[rand][1],GruzSkladRand[rand][2],GruzSkladRand[rand][3])); 
		SetPVarInt(playerid, "IDConveirGruz", rand);

		pTemp[playerid][tPlayerUseItemJob] = true;
		ApplyAnimation(playerid,"CARRY","liftup",1.0,0,1,1,0,0,1);
		SetTimerEx("CarryDelay",1000,false,"d",playerid);
		SetPlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1 , 2060, 1,0.11,0.36,0.0,0.0,90.0);
		MeAction(playerid, "поднял(а) мешок", SELECT_ACTION_IN_BUBBLE);
		return 1;
	}
	}
	if (GetPVarInt(playerid,"GruzCheckpointTop") && pTemp[playerid][tGruzJob] == true) {
	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, !"Выйдите из т.с!");
	if (!pTemp[playerid][tGruzJob]) {
		DeletePVar(playerid,"GruzCheckpointTop");
		DisablePlayerCheckpoint(playerid);
	}
	else if (pTemp[playerid][tPlayerUseItemJob]) 
	{
		
		DisablePlayerCheckpoint(playerid);
		DeletePVar(playerid,"GruzCheckpointTop");
		if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
		pTemp[playerid][tSalaryJob][0] ++;  
		if (GetPVarInt(playerid, "IDConveirGruz") == 0) {
		new obj = CreateDynamicObject(2060, 2160.496826, -2281.091308, 13.548438, 0.000000, 0.000000, 44.199993);
		SetGVarInt("GruzConv", 1, obj);
		MoveDynamicObject(obj, 2156.069335, -2276.539550, 13.548438,1,0.00000, 0.00000, 44.199993);
		} 
		else if (GetPVarInt(playerid, "IDConveirGruz") == 1) {
		new obj = CreateDynamicObject(2060, 2167.644042, -2273.695800, 13.548438, 0.000000, 0.000000, 44.199993);
		SetGVarInt("GruzConv", 1, obj);
		MoveDynamicObject(obj,2163.237060, -2269.165039, 13.548438,1,0.00000, 0.00000, 44.199993);
		}
		else if (GetPVarInt(playerid, "IDConveirGruz") == 2) {
		new obj = CreateDynamicObject(2060, 2175.161621, -2266.328857, 13.548438, 0.000000, 0.000000, 44.199993); 
		SetGVarInt("GruzConv", 1, obj);
		MoveDynamicObject(obj,2170.532226, -2261.565917, 13.548438,1,0.00000, 0.00000, 44.199993);
		}
		DeletePVar(playerid, "IDConveirGruz");
		string_[0] = EOS;
		format(string_, sizeof string_, "Мешков перетащено: %d", pTemp[playerid][tSalaryJob][0]);
		SendClientMessage(playerid, COLOR_GREEN, string_);
		ApplyAnimation(playerid,"PED","IDLE_tired",4.1,0,1,1,0,1);
		pTemp[playerid][tPlayerUseItemJob] = false;
		switch(random(6)) {
		case 0: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2239.3193,-2276.5266,14.3958-1.0,1.5));//Вагон 3
		case 1: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2233.3889,-2282.1833,14.3958-1.0,1.5));//Вагон 4
		case 2: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2227.5889,-2288.2412,14.3958-1.0,1.5));//Вагон 5
		case 3: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2221.9451,-2294.1477,14.3958-1.0,1.5));//Вагон 6
		case 4: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2216.0876,-2299.7507,14.3958-1.0,1.5));//Вагон 7
		default: SetPVarInt(playerid,"GruzCheckpointImport",_:SetPlayerCheckpoint(playerid, 2210.2498,-2305.5447,14.3958-1.0,1.5));//Вагон 8
		} 
		MeAction(playerid,"положил(а) мешок на конвейер", SELECT_ACTION_IN_BUBBLE);
		ApplyAnimation(playerid,"PED","IDLE_tired",4.1,0,1,1,0,1);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		OnPlayerQuestProgress(playerid, QUEST_GUEST, QUEST_TASK_LOADER_BAGS, 1);
		return 1;
	}
	} 
	else if (CP[playerid] == 500)
	{
	kLibGivePlayerMoney(playerid,600, "Премия 2");
	CP[playerid] = 0;
	SetMoveCashServer(IN_SERVER, 600);
	GameTextForPlayer(playerid,"~g~+600", 5000, 1);
	DisablePlayerCheckpoint(playerid);
	}
	else
	{
	    if (GetPVarInt(playerid, #CheckpointHome) == 1)
	    {
	        PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
		DisablePlayerCheckpoint(playerid);
		DeletePVar(playerid, #CheckpointHome);
		GameTextForPlayer(playerid, "~w~Is in~n~~y~House", 5000, 1);
	    }
	}
	return 1;
}
public OnPlayerEnterDynamicArea(playerid, areaid)
{
	#if defined _casino_included
	if (casino_OnPlayerEnterDynamicArea(playerid, areaid)) return true;
	#endif
	//if (family_OnPlayerEnterDynamicArea(playerid, areaid)) return true;
	new area_id, area_type, area_extra_id;
	GetDynamicAreaTypeID(areaid, area_id, area_type, area_extra_id);
	if (area_id == areaid) {
	switch (area_type) {
		#if defined _stalls_inc
		case AREA_TYPE_STALL: {
		if(pInfo[playerid][pLevel] < 3)
		{
			pTemp[playerid][tStallID] = area_extra_id;
			ShowStallMenu(playerid);
		}
		else SendClientMessage(playerid,CGRAY2,!"Бесплатная еда доступна до 3 lvl");
		}
		#endif
		case AREA_TYPE_CAPTURE: {

		if (pInfo[playerid][pAdmin] && SpecAd[playerid] == INVALID_PLAYER_ID) ShowTextDrawCapture(playerid, area_extra_id);
		}

		case AREA_TYPE_TAKE_MEET: {
			if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {
				new
					V_IDX = area_extra_id;
				if (VehicleInfo[ V_IDX - 1 ][vType] == VEHICLE_TYPE_JOB && VehicleInfo[ V_IDX - 1 ][vFraction] == PLAYER_JOB_HUNTER && VehicleInfo[ V_IDX - 1 ][vJobLoad]) {
					if (!pTemp[playerid][tPlayerUseItemJob]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас в руках ничего нет!");
					if (VehicleInfo[ V_IDX - 1 ][vJobAmount][0] + 1 > 25) return SendClientMessage(playerid, COLOR_GREY, !"Фургон заполнен!");
					if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
					ApplyAnimation(playerid,"CARRY","putdwn",1.0,0,1,1,0,0,1);
					VehicleInfo[ V_IDX - 1 ][vJobAmount][0] ++;
					pTemp[playerid][tPlayerUseItemJob] = false;
					pTemp[playerid][tSalaryJob][1] ++;
					new
						string_[128];
					format(string_, sizeof string_, "Мясо: "colmaline"%d/25 ед",
					VehicleInfo[ V_IDX - 1 ][vJobAmount][0]
					);
					if (VehicleInfo[ V_IDX - 1 ][vFarmText] != Text3D:-1) {
						UpdateDynamic3DTextLabelText(VehicleInfo[ V_IDX - 1 ][vFarmText], COLOR_WHITE, string_);
					}
				}
			}
		}

		case AREA_TYPE_HUNTER_JOB: {
			if (pTemp[playerid][tJobHunter] != false) SetPVarInt(playerid, "TimerCountHunter", 0);
		}

		case AREA_TYPE_ARMY_JOB: {
		if (pTemp[playerid][tArmyDuty] != 0) SetPVarInt(playerid, "TimerCountWoods", 0);
		}
		
		case AREA_TYPE_SPIKE_STRIPS: {
		if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			new panels, tires, doors, lights;
			GetVehicleDamageStatus(GetPlayerVehicleID(playerid), panels, doors, lights, tires);
			UpdateVehicleDamageStatus(GetPlayerVehicleID(playerid), panels, doors, lights, 15);
		}
		}
		case AREA_TYPE_BOOMBOX: {
		if (pTemp[area_extra_id][tBoomboxArea]) {
			PlayAudioStreamForPlayer(playerid, pTemp[area_extra_id][tBoomboxURL], 
			pTemp[area_extra_id][tBoomboxPos][0], pTemp[area_extra_id][tBoomboxPos][1], 
			pTemp[area_extra_id][tBoomboxPos][2], pTemp[area_extra_id][tBoomboxRange], 1
			);
		}
		}
		#if defined _businesses_inc
		case AREA_TYPE_FILLING: {
		if (pTemp[playerid][tFillBusinessID] != area_extra_id) {
			pTemp[playerid][tFillBusinessID] = area_extra_id;
			if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			GameTextForPlayer(playerid, "~w~PRESS ~y~H ~w~FOR FILLING", 5000, 1);
			}
		}
		}
		case AREA_TYPE_ACTOR_BIZ: {
		pTemp[playerid][tActorBusinessID] = area_extra_id;
		}
		#endif
		
		case AREA_TYPE_PRESSKEYTD:
		{
		if (areaid == DynamicRectangGhettoLobby){
			TextDrawSetString(PressKeyTD, "~w~Press ~y~Alt~w~ to start a dialog");
			TextDrawShowForPlayer(playerid, PressKeyTD);
		}
		/*else if (areaid >= DynamicRectangLVa[0] && areaid <= DynamicRectangLVa[4] && (IsAGosFraction(playerid) || pTemp[playerid][PlayerInArmyForm] == true || pTemp[playerid][ac_card])){
			TextDrawSetString(PressKeyTD, "~w~Press ~y~Alt~w~ to open gate");
			TextDrawShowForPlayer(playerid, PressKeyTD);
		}*/
		else if (pInfo[playerid][pMember] == area_extra_id)
		{
			TextDrawSetString(PressKeyTD, "~w~Press ~y~Alt~w~  to open barrier");
        		TextDrawShowForPlayer(playerid, PressKeyTD);
		}
		}
		case AREA_TYPE_FAMILY_HOUSE: { 
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			if (pTemp[playerid][tSelectFamilyHouse] != area_extra_id) {  
			pTemp[playerid][tSelectFamilyHouseArea] = true;
			pTemp[playerid][tSelectFamilyHouse] = area_extra_id;   
			ShowMenuFamilyHouse(playerid, area_extra_id); 
			}
			else {
			pTemp[playerid][tSelectFamilyHouseArea] = true;
			ShowMenuFamilyHouse(playerid, area_extra_id); 
			}
		}
		}
		case AREA_TYPE_ATM: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			pTemp[playerid][tSelectAreaATM] = true;
			pTemp[playerid][tSelectATMID] = area_extra_id;
		}
		if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
			pTemp[playerid][tSelectATMID] = area_extra_id;
		}
		}
		
		case AREA_TYPE_STALL_MARKET: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			pTemp[playerid][tSelectAreaStall] = true;
			pTemp[playerid][tSelectStallID] = area_extra_id;
		}
		}
		case AREA_TYPE_HOUSE: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			if ( pTemp [ playerid ] [ tIgnorePick ] != 0 ) return 1;
			pTemp[playerid][tSelectHouseArea] = true;
			pTemp[playerid][tSelectHouseID] = area_extra_id; 
			ShowPlayerHouseMenu(playerid, area_extra_id);
			SetPVarInt(@p,#P_House_Id,area_extra_id);

		}
		}
		case AREA_TYPE_ROB_HOUSE: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			if (pTemp[playerid][tRobVeh] == area_extra_id) {//VehicleInfo[ area_extra_id - 1 ][vJobLoad]
			if (!pTemp[playerid][tRobItems]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет ничего в руках!");
			VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount]++; 
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
			ApplyAnimation(playerid,"CARRY","putdwn",1.0,0,1,1,0,0,1); 
			pTemp[playerid][tRobItems] = false;
			new 
				string_[64];  
			format(string_, sizeof string_, "Техника: "colmaline"%dед", VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount][0]);
			if (VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vFarmText] != Text3D:-1) { 
				UpdateDynamic3DTextLabelText(VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vFarmText], COLOR_WHITE, string_); 
			}  
			} 
		}
		}
		case AREA_TYPE_TAKE_MONEY: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			if (pTemp[playerid][pRentCar] == area_extra_id) {//VehicleInfo[ area_extra_id - 1 ][vJobLoad]
			if (!pTemp[playerid][tTakeCashATM]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет ничего в руках!"); 
			new	
				amount = 1;
			if (VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobAmount][0] + amount > 20) return SendClientMessage(playerid, COLOR_GREY, !"Фургон заполнен!");
			VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobAmount][0]++; 
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
			ApplyAnimation(playerid,"CARRY","putdwn",1.0,0,1,1,0,0,1); 
			pTemp[playerid][tTakeCashATM] = false;
			new 
				string_[64];  
			format(string_, sizeof string_, "Суммок: "colmaline"%d/20 шт", VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobAmount][0]);
			if (VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vFarmText] != Text3D:-1) { 
				UpdateDynamic3DTextLabelText(VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vFarmText], COLOR_WHITE, string_); 
			}  
			} 
		} 
		}
		case AREA_TYPE_TAKE_DRUGS: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			new	
			V_IDX = area_extra_id;
			if (VehicleInfo[ V_IDX - 1 ][vModel] == 459 && VehicleInfo[ V_IDX - 1 ][vJobLoad]) {
			if (!pTemp[playerid][tTakeDrugsType]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас в руках ничего нет!");
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
			ApplyAnimation(playerid,"CARRY","putdwn",1.0,0,1,1,0,0,1); 
			/*if (pTemp[playerid][tTakeDrugsType] == 1) {
				if (VehicleInfo[ V_IDX - 1 ][vJobAmount][0] > 10) {
				VehicleInfo[ V_IDX - 1 ][vJobAmount][0] ++; 
				} else {
				return SendClientMessage(playerid, COLOR_GREY, !"Фургон полон верните сумку на склад");
				}
			}
			if (pTemp[playerid][tTakeDrugsType] == 2) {
				if (VehicleInfo[ V_IDX - 1 ][vJobAmount][1] > 10) {
				VehicleInfo[ V_IDX - 1 ][vJobAmount][1] ++; 
				} else {
				return SendClientMessage(playerid, COLOR_GREY, !"Фургон полон верните сумку на склад");
				}
				
			}*/ 
			if (pTemp[playerid][tTakeDrugsType] == 1) {
				if (VehicleInfo[ V_IDX - 1 ][vJobAmount][0] > 10) 
				return SendClientMessage(playerid, COLOR_GREY, !"Фургон полон верните сумку на склад");

				VehicleInfo[ V_IDX - 1 ][vJobAmount][0] ++; 
			}
			if (pTemp[playerid][tTakeDrugsType] == 2) {
				if (VehicleInfo[ V_IDX - 1 ][vJobAmount][1] > 10) 
				return SendClientMessage(playerid, COLOR_GREY, !"Фургон полон верните сумку на склад");

				VehicleInfo[ V_IDX - 1 ][vJobAmount][1] ++; 
			}
			pTemp[playerid][tTakeDrugsType] = 0;
			new 
				string_[128];  
			format(string_, sizeof string_, ""colwhi"Тяжелые наркотики: "colmaline"%d/10 сумок\n"colwhi"Легкие наркотики: "colmaline"%d/10 сумок", 
				VehicleInfo[ V_IDX - 1 ][vJobAmount][0], VehicleInfo[ V_IDX - 1 ][vJobAmount][1]
			);
			if (VehicleInfo[ V_IDX - 1 ][vFarmText] != Text3D:-1) { 
				UpdateDynamic3DTextLabelText(VehicleInfo[ V_IDX - 1 ][vFarmText], COLOR_WHITE, string_); 
			}
			}/*B
			if (GetNearstFractionVehicleModel(playerid, pInfo[playerid][pMember], 459) == area_extra_id) {//VehicleInfo[ area_extra_id - 1 ][vJobLoad]
			SendClientMessage(playerid, -1, "|"); 
			}*/
		}
		}
		case AREA_TYPE_EMPTY_BIKERS: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			if (!IsABiker(playerid)) return 1;
			new	
			V_IDX = area_extra_id;
			if (VehicleInfo[ V_IDX - 1 ][vModel] == 433 && VehicleInfo[ V_IDX - 1 ][vJobLoad]) {
			
			if (VehicleInfo[ V_IDX - 1 ][vJobMaterials] == 0) return SendClientMessage(playerid, COLOR_GREY, !"В фургоне нет материалов");
			VehicleInfo[ V_IDX - 1 ][vJobMaterials] -= 700;
			if (pTemp[playerid][tTakeEmptyBikers]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас в руках уже есть ящик!");
			ClearAnimations(playerid);
			pTemp[playerid][tTakeEmptyBikers] = 1;
			ApplyAnimation(playerid,"CARRY","liftup",1.0,0,1,1,0,0,1); 
			SetTimerEx("CarryDelay",1000,false,"i",playerid);
			SetPlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1,2358,6,0.0,0.10,-0.2, -110.0,0.0,78.0);
			new 
				string_[128];  
			format(string_, sizeof string_, ""colwhi"Материалы: "colmaline"%d", 
				VehicleInfo[ V_IDX - 1 ][vJobMaterials]
			);
			if (VehicleInfo[ V_IDX - 1 ][vFarmText] != Text3D:-1) { 
				UpdateDynamic3DTextLabelText(VehicleInfo[ V_IDX - 1 ][vFarmText], COLOR_WHITE, string_); 
			}
			} 
		}
		}
		case AREA_TYPE_SELLER_DEALER_DEN: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			pTemp[playerid][tSelectDealerArea] = true;
			pTemp[playerid][tSelectDealerID] = area_extra_id;   
		}
		}

		case AREA_TYPE_FACTORY_TABLE: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			if (!pTemp[playerid][tJobFactory]) return SendClientMessage(playerid, COLOR_GREY, !"Вы не работаете в цехе!");
			if (pTemp[playerid][tFactoryUseBox]) return SendClientMessage(playerid, COLOR_GREY, "У Вас уже в руках есть ящик!");
			if (gFactoryInfo[area_extra_id][tableToggle] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, !"Данный стол уже занят другим рабочим"); 
			gFactoryInfo[area_extra_id][tableToggle] = playerid;
			//Anti Sbiv
			ClearAnimations(playerid);
			//ApplyAnimation(playerid, "CAR_CHAT", "CAR_Sc4_BL", 4.0, 1, 1, 1, 1, 5800, 0); 
			ApplyAnimation(playerid, !"CAR_CHAT", !"CAR_Sc4_BL", 4.0, 1, 1, 1, 0, 5800, 0);
			DestroyDynamicObject(gFactoryInfo[area_extra_id][tableObjectStatus]);
			gFactoryInfo[area_extra_id][tableObjectStatus] = CreateDynamicTrigger(gFactoryInfo[area_extra_id][tablePos][0], gFactoryInfo[area_extra_id][tablePos][1], gFactoryInfo[area_extra_id][tablePos][2], 
			.worldid = 1, .interiorid = FACTORY_INT, .t_type = 1
			);//1 - red //2 - green
			gFactoryInfo[area_extra_id][tableObject] = CreateDynamicObject(3052, 
			gFactoryInfo[area_extra_id][tObjectPos][0], gFactoryInfo[area_extra_id][tObjectPos][1], gFactoryInfo[area_extra_id][tObjectPos][2], 
			gFactoryInfo[area_extra_id][tObjectPos][3], gFactoryInfo[area_extra_id][tObjectPos][4], gFactoryInfo[area_extra_id][tObjectPos][5], 
			1, FACTORY_INT, -1, 50.00, 50.00
			);
			SetPlayerFacingAngle(playerid, gFactoryInfo[area_extra_id][tablePos][3]);
			Streamer_Update(playerid);
			pTemp[playerid][tJobTimer] = SetTimerEx ("MainJobsTimers", 5800, false, "ii", playerid, area_extra_id);
		}
		}
		case AREA_TYPE_STEAL_MATERIALS: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
			if (!IsAGang(playerid)) return SendClientMessage(playerid, COLOR_GREY, !"Доступно только для банд");
			if (gEconomyServer[eMaterialsLSa][area_extra_id] < 500) return SendClientMessage(playerid,COLOR_GRAD1, !"Склад армии пуст");
			if (usemats[playerid] != 0) return SendClientMessage(playerid,COLOR_GRAD1, !"Вы не можете взять больше");
			SendClientMessage(playerid, 0x6495EDFF, !"Вы взяли 500 материалов со склада армии");
			SendClientMessage(playerid, COLOR_WHITE, !"Несите ящик в грузовик, используйте /materials put, чтобы положить материалы в фургон");
			SetPlayerSpecialAction (playerid, SPECIAL_ACTION_CARRY);
			SetPlayerAttachedObject(playerid, 1 , 2358, 1,0.11,0.36,0.0,0.0,90.0);
			usemats[playerid] = 2;
			SetPVarInt(playerid, "Player:ArmyAreaID", area_extra_id);
			gEconomyServer[eMaterialsLSa][area_extra_id] -= 500;
			SetUpdate3DTextLabel();
		}
		}
		case AREA_TYPE_FACTORY_SORT: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {  
			if (gFactorySortInfo[area_extra_id][sortBoxCount] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Пока нечего проверять");
			if (!pTemp[playerid][tJobFactory]) return SendClientMessage(playerid, COLOR_GREY, !"Вы не работаете в цехе!");
			if (pTemp[playerid][tFactoryUseBox]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас уже в руках есть ящик!");
			if (gFactorySortInfo[area_extra_id][sortPlaceToggle] != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, !"Данный стол уже занят другим рабочим"); 
			gFactorySortInfo[area_extra_id][sortPlaceToggle] = playerid;
			
			/* 0, 1 - left && 3, 4 - right */
			pTemp[playerid][tActionType] = ACTION_FACTORY_SORT;
			pTemp[playerid][tActionStep] = 0;
			ApplyAnimation(playerid, "CASINO", "Slot_Plyr", 4.1, 0, 0, 0, 0, 0, 1);
			SetPlayerFacingAngle(playerid, gFactorySortInfo[area_extra_id][sortPos][3]);
			ActionMiniGamePlayer(playerid, true);
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Для завершения сортировки введите "col_li_red"\"/cancel\"");
			pTemp[playerid][tUseFactorySordID] = area_extra_id;   
		}
		}
		case AREA_TYPE_HOTDOG_SALLER: {
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {  
			format(t_string, sizeof t_string, "");
			ShowPlayerDialog(playerid, D_PLAYER_HOTDOG_SELLER, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Выберите: "colwhi"Еду", t_string, "Выбрать", "Закрыть"), t_string[0] = EOS;
		}
		}
	}
