		ShowPlayerDialog(playerid, D_FRACTION_FUNC_15, DIALOG_STYLE_MSGBOX, ""colserver"Организации: "colwhi"Снять лидера", string_, "Снять", "Отмена");
		}
	}
	case D_FRACTION_FUNC_1:
	{
	    if (!response) return callcmd::lpanel(playerid);
	    new fraction_id = pInfo[playerid][pMember];
	    switch(listitem)
	    {
	        case 0:
		{
			new string_[128], str_[64];
		    if (!strcmp(fInfo[fraction_id][fAssistant], "None",true))
			{
			    format(string_, sizeof string_, ""colserver"Назначить заместителя: "colwhi"%s", fInfo[fraction_id][fName]);
			ShowPlayerDialog(playerid, D_FRACTION_FUNC_2, 1, string_, ""colwhi"Введите ID или имя игрока:", "Принять", "Отмена");
		    }
		    else
			{
			    format(str_, sizeof str_, ""colserver"Снять заместителя: "colwhi"%s",fInfo[fraction_id][fName]);
			    format(string_, sizeof string_, ""colwhi"Вы хотите снять с должности заместителя: "colserver"%s\n\n"colwhi"Вы согласны?",fInfo[fraction_id][fAssistant]);
			ShowPlayerDialog(playerid, D_FRACTION_FUNC_3, 0, str_, string_, "Да", "Нет");
			}
		}
		case 1:
		{
		    t_string[0] = EOS;
			if (strcmp("None", fInfo[fraction_id][fMessage], true))
