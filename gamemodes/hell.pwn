		ShowPlayerDialog(playerid, D_VACANCY_1, DIALOG_STYLE_INPUT, 
			""colserver"Вакансии: "colwhi"Добавить вакансию",
			""colgrey"Длина сообщения не может составлять более 120 символов\n\n"colwhi"Укажите требования для приёма в Вашу организацию:",
			"Принять", "Отмена"
		);
		return 1;
