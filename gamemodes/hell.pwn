			mysql_tquery(dbHandle, query_, "ShowBlackList", "d", playerid);
		}
		}
	}
	
	case D_FRACTION_FUNC_9:
	{
	    if (!response)return ShowPlayerDialog(playerid, D_FRACTION_FUNC_8, DIALOG_STYLE_LIST, ""colserver"Участники организации", "[0] Все участники организации [OFFLINE]\n[1] Фильтр по рангу", "Выбрать", "Назад");
		if (strval(inputtext) < 1 || strval(inputtext) > gFracionCountRank[ pInfo[playerid][pMember] - 1 ]) return ShowPlayerDialog(playerid, D_FRACTION_FUNC_9, DIALOG_STYLE_INPUT, ""colserver"Участники организации", "{FFFFFF}- Неверный номер ранга!\n\nВведите ранг для фильтра:", "Далее", "Назад" ) ;
		SetPVarInt(playerid, "ofm_type", strval(inputtext));

