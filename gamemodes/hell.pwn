			SendClientMessage(playerid, COLOR_GREY, !"[Ошибка] "colgrey"Не меньше 1 и не более 50000");
			ShowPlayerDialog(playerid, D_EU_2, DIALOG_STYLE_INPUT, ""colwhi"Покупка Euro", ""colwhi"Введите в каком кол-ве хотите приобрести Euro", "Приобрести", "Отмена");
			return 1;
		}
		new count_eu = money_count*priceeu;
		if(kLibGetPlayerMoney(playerid) < count_eu)
		{
			ShowPlayerDialog(playerid, D_EU_2, DIALOG_STYLE_INPUT, ""colwhi"Покупка Euro", ""colwhi"Введите в каком кол-ве хотите приобрести Euro\n\n"colgrey"У вас недостаточно средств для приобретения такого количества Euro", "Приобрести", "Отмена");
			return 1;
		}
		kLibGivePlayerEuro(playerid, money_count);
		kLibGivePlayerMoney(playerid, -count_eu, "покупка euro)", playerid);

		new format_str[144];
		format(format_str, sizeof(format_str), "Вы успешно купили %d Euro за $%d", money_count, count_eu);
		SendClientMessage(playerid, COLOR_GREY, format_str);					
	}	
