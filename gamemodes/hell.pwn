		SetMoveCashServer(IN_SERVER, boostMoney);
		SendMes(playerid, COLOR_WHITE, "Вы получаете в пакете "collime"$%i", boostMoney);
		}
		if(boostGiveMats && boostGiveDrugs) {
		pInfo[playerid][pDrugs] += boostGiveDrugs; 
		pInfo[playerid][pMats] += boostGiveMats;  
		format(query_, sizeof query_, "`pDrugs` = '%i', `pMats` = '%i'", 
