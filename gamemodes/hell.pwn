	case D_DIPLOMATION: {
		if (!response) { 
		return 1;
		}
		new 
		header_string[64];  
		SetPVarInt ( playerid, "d_listitem", listitem); 
		format(header_string, sizeof header_string, "{%s} %s", gFraction[ back_capture_band(listitem) ][fRGBColor], gFraction[ back_capture_band(listitem) ][fName]); 
		ShowPlayerDialog(playerid, D_DIPLOMATION_2, DIALOG_STYLE_LIST, header_string, "[0] Нейтралитет\n[1] Война\n[2] Союз", "Выбрать", "Отмена");
	}
	case D_DIPLOMATION_2: {
		new temp = capture_band( pInfo[playerid][pMember] );
		if (temp != INVALID_PLAYER_ID) {
		if (capture_now[temp] != 0) return SendClientMessage(playerid, COLOR_GREY, !"Нельзя использовать во время капта!");
		}
		if ((pInfo[playerid][pMember] == mafia_frac_id[0] || pInfo[playerid][pMember] == mafia_frac_id[1]) && ZoneTimer > 0)
		return SendClientMessage(playerid, COLOR_GREY, !"Нельзя использовать во время стрелы!"); 
		if(!response) {
		ShowDialogDiplomationCriminals(playerid);
		return 1;
		} 
		new fr_id = GetPVarInt(playerid, "d_listitem");
		if(listitem == 2) { 
		if (crimeDiplomation[ capture_band(pInfo[playerid][pMember]) ][ fr_id ] == sDIP_ALLIANCE_GET) {
			crimeDiplomation[ capture_band(pInfo[playerid][pMember]) ][ fr_id ] = sDIP_ALLIANCE;
			crimeDiplomation[ fr_id ][ capture_band(pInfo[playerid][pMember]) ] = sDIP_ALLIANCE;
			
			ShowDialogDiplomationCriminals(playerid);
			SaveDiplomationCriminals(playerid, capture_band(pInfo[playerid][pMember]));
			SaveDiplomationCriminals(playerid, fr_id);
			return 1;
		}
		crimeDiplomation[ capture_band(pInfo[playerid][pMember]) ][fr_id ] = sDIP_ALLIANCE_SET;
		crimeDiplomation[ fr_id ][capture_band(pInfo[playerid][pMember]) ] = sDIP_ALLIANCE_GET;
			
		ShowDialogDiplomationCriminals(playerid);
		SaveDiplomationCriminals(playerid, capture_band(pInfo[playerid][pMember]));
		SaveDiplomationCriminals(playerid, fr_id);
		return 1 ;
		}
		crimeDiplomation[ capture_band(pInfo[playerid][pMember]) ][ fr_id ] = listitem;
		crimeDiplomation[ fr_id ][ capture_band(pInfo[playerid][pMember]) ] = listitem;		
	
		ShowDialogDiplomationCriminals(playerid);
		SaveDiplomationCriminals(playerid, capture_band(pInfo[playerid][pMember]));
		SaveDiplomationCriminals(playerid, fr_id);
	}
