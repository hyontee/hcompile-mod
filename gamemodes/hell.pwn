			case 1: {
			if (DestroyBoombox(playerid)) return SendClientMessage(playerid, -1, "Бумбокс успешно удален!");
			}
		}
		return true;
		}
		foreach(new i: PlayerInLogin) {
		if (!pTemp[i][tBoomboxArea]) continue;
		if (IsPlayerInDynamicArea(playerid, pTemp[i][tBoomboxArea] - 1, 1)) {
			SendClientMessage(playerid, COLOR_GREY, "Поблизости уже установлен бумбокс!");
			return true;
		}
		}
		new boomboxid = playerListItem[playerid][listitem], Float:playerPos[4];
		GetPlayerPos(playerid, playerPos[0], playerPos[1], playerPos[2]);
		GetPlayerFacingAngle(playerid, playerPos[3]);
		playerPos[0] += (2 * floatsin(-playerPos[3], degrees));
		playerPos[1] += (2 * floatcos(-playerPos[3], degrees));
		playerPos[2] -= 1.0;

		static const Float:BoomboxRangeDistance[] = { 10.0, 20.0, 30.0 };
		format(t_string, sizeof (t_string), ""colserver"Бумбокс\n"colwhi"Поставил: "colserver"%s", 
		pInfo[playerid][pName]
		);
		pTemp[playerid][tBoomboxObject] = CreateDynamicObject(DonateAccesoryInfo[boomboxid][accesoryModel],
		playerPos[0], playerPos[1], playerPos[2], 0.0, 0.0, 0.0, 
		.worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)
		);
		if (IsValidDynamic3DTextLabel(pTemp[playerid][tBoomboxText])) {
		DestroyDynamic3DTextLabel(pTemp[playerid][tBoomboxText]);
		pTemp[playerid][tBoomboxText] = Text3D:0;
		}
		pTemp[playerid][tBoomboxText] = CreateDynamic3DTextLabel(t_string, 0xFFFFFFFF,
		playerPos[0], playerPos[1], playerPos[2] + 0.50, 3.0,
		.worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)
		);
		pTemp[playerid][tBoomboxArea] = 1 + CreateDynamicSphere(
		playerPos[0], playerPos[1], playerPos[2], BoomboxRangeDistance[boomboxid],  
		.worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)
		);
		SetDynamicAreaType(pTemp[playerid][tBoomboxArea] - 1, AREA_TYPE_BOOMBOX, playerid);
	
		pTemp[playerid][tBoomboxRange] = BoomboxRangeDistance[boomboxid];
		pTemp[playerid][tBoomboxPos][0] = playerPos[0];
		pTemp[playerid][tBoomboxPos][1] = playerPos[1];
		pTemp[playerid][tBoomboxPos][2] = playerPos[2];

		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
		ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);

		SendClientMessage(playerid, COLOR_BLUE, "Вы установили бумбокс, для включения используйте: /boombox");
		Streamer_Update(playerid);
		t_string[0] = EOS;
		return true;
	}
