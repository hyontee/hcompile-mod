		SendBeside(playerid,COLOR_PURPLE,string_,30.0);
		if (GetPVarInt(playerid, #PlayerAnimation ) == 0 && !pTemp[playerid][tFreezePlayer])
		{
			if (GetPVarInt(playerid, "ClearAnimSI") <= gettime()){
			ApplyAnimation(playerid, "GHANDS", "gsign1LH",4.1, 0, 1, 1, 1, 1);
			SetTimerEx("ClearAnim", 2000, false, "d", playerid);
			}
		}
		return 0;
		}
		case 3, 19:
		{
		    if (0 == pTemp[playerid][tDutyWork]) return 0;
		SetPlayerChatBubble(playerid,"Выполнил воинское приветствие",COLOR_PURPLE,30.0,10000);
		format(string_, sizeof string_, "%s выполнил воинское приветствие", pInfo[playerid][pName]);
		SendBeside(playerid,COLOR_PURPLE,string_,30.0);
		if (GetPVarInt(playerid, #PlayerAnimation ) == 0 && !pTemp[playerid][tFreezePlayer])
		{
			if (GetPVarInt(playerid, "ClearAnimSI") <= gettime()){
			ApplyAnimation(playerid, "GHANDS", "gsign1LH",4.1, 0, 1, 1, 1, 1);
			SetTimerEx("ClearAnim", 2000, false, "d", playerid);
			}
		}
		return 0;
		}
	}

	//return 0;
	}
	for(new i; i < SMILE_COUNT; i++)
	{
	if (strcmp(text, SmileInfo[i][smInput], true) == 0)
	{
		if (pInfo[playerid][pSex] == 1)
		{
		f(string_,"%s %s", pInfo[playerid][pName],SmileInfo[i][smOutput_M]);
		SetPlayerChatBubble(playerid, SmileInfo[i][smOutput_M], COLOR_PURPLE, 13.0, 10000);
		}
		else
		{
		f(string_,"%s %s", pInfo[playerid][pName],SmileInfo[i][smOutput_F]);
		SetPlayerChatBubble(playerid, SmileInfo[i][smOutput_F], COLOR_PURPLE, 13.0, 10000);
		}
		SendBeside(playerid,COLOR_PURPLE,string_,30.0);
		return 0;
	}
	} 
	if (pTemp[playerid][tDiceTable] != -1)
	{
	    format(string_, sizeof string_, "- %s: %s", pInfo[playerid][pName], text);
	new
		idx = pTemp[playerid][tDiceTable];
	foreach(new i: DicePlayers[idx]) {
            SendClientMessage(i, COLOR_PURPLE, string_); 
	  	} 
	    if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && !pTemp[playerid][tFreezePlayer])
	{
	    if (GetPVarInt(playerid, "ClearAnimSI") <= gettime()){
		ApplyAnimation(playerid, "PED", "IDLE_CHAT",4.1,0,1,1,1,1,1);
		SetTimerEx("ClearAnim", 2400, false, "d", playerid);
		}
	}
	SetPlayerChatBubble(playerid, text, 0x6495EDFF, 20.0, 10000);
	pTemp[playerid][AntiFloodText] = gettime()+1;
	    return 0;
	}
	new bool:realchat = true;
	if (realchat)
	{
	if (pInfo[playerid][pLevel] <= 1) {
		new succ;
		for(new i; i <strlen(text); i++) if (PText[playerid][i] == text[i]) succ++;
		if (succ == strlen(text)) {
		SendClientMessage(playerid, 0xFFD5BBAA, !"Не флуди!");
		return 0;
		}
	}
	strmid(PText[playerid], text, 0, 256, 256);

        if (!IsPlayerInAnyVehicle(playerid)) {
		if (GetPVarInt(playerid, #PlayerAnimation ) == 0 && !pTemp[playerid][tFreezePlayer]) {
		    if (GetPVarInt(playerid, "ClearAnimSI") <= gettime()){
			ApplyAnimation(playerid, "PED", "IDLE_CHAT",4.1,0,1,1,1,1,1);
			SetTimerEx("ClearAnim", 2400, false, "d", playerid);
		}
		}
	}
	format(string_, sizeof string_, "- %s[%d]: %s", pInfo[playerid][pName], playerid, text);
	SetPlayerChatBubble(playerid, text, 0x6495EDFF, 20.0, 10000);
	ProxDetector(playerid, 20.0, 0xFFFFFFFF, string_);
	pTemp[playerid][AntiFloodText] = gettime()+1;
	return 0;
	}
	return 1;
}
public OnPlayerUpdate(playerid)
{ 
	if (pTemp[playerid][PlayerAFK] > -2)
	{
	if (pTemp[playerid][PlayerAFK] > 2)
	{
	    SetPlayerChatBubble(playerid, "[AFK: Завершено.]", COLOR_GREEN, 30.0, 1100);
		//SendClientMessage(playerid, -1, "off afk");
		pTemp[playerid][acWeaponTick] = GetTickCount() + 1250; 
	}
	pTemp[playerid][PlayerAFK] = -2;
	}
	pTemp[playerid][tPlayerGTC] = GetTickCount();
	new target = GetPlayerTargetPlayer(playerid);
	if(target != INVALID_PLAYER_ID && IsACop(playerid) && IsALicenser(playerid) && pTemp[playerid][tPaintTeam] == 0)
	{
	if (IsPlayerInRangeOfPoint(playerid, 3.0, pTemp[playerid][tPos][0], pTemp[playerid][tPos][1], pTemp[playerid][tPos][2])) {
		GameTextForPlayer(playerid, !"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~PRESS_~g~ALT", 1000, 3);	
	}
	} 
	#if defined _casino_included
	if (
	pTemp[playerid][tCasinoRouletteTable] && pTemp[playerid][tCasinoRouletteChipsObject] != -1 &&
	pTemp[playerid][tCasinoRouletteBet] == 0 && GetPlayerInterior(playerid) == CASINO_INTERIOR_ID
	) {
	new Keys, ud, ld;
	GetPlayerKeys(playerid, Keys, ud, ld);
	if (ud < 0) casino_MoveRouletteChips(playerid, CHIPS_MOVE_TYPE_UP);
	else if (ud > 0) casino_MoveRouletteChips(playerid, CHIPS_MOVE_TYPE_DOWN);
	if (ld < 0) casino_MoveRouletteChips(playerid, CHIPS_MOVE_TYPE_LEFT);
	else if (ld > 0) casino_MoveRouletteChips(playerid, CHIPS_MOVE_TYPE_RIGHT);
	}
	#endif

	// Анти-сбив система:
	if (drugsInfo[playerid][fltHealth] > 0.0)
	{
	if(drugsInfo[playerid][nTimer] < GetTickCount() ) {
		new AnimIndexID = GetPlayerAnimationIndex(playerid);
		/*new fmt_Str[80];
		format(fmt_Str,sizeof(fmt_Str),"анимка %d",AnimIndexID);
		SendClientMessage(i,-1,fmt_Str);*/
		if ((IsPlayerInAnyVehicle(playerid) || AnimIndexID == 1462) && !IsPlayerDeath(playerid) && pTemp[playerid][PlayerAFK] <= 2) {
		SetPlayerHealth(playerid, drugsInfo[playerid][fltHealth]);
		}
		drugsInfo[playerid][nTimer] = 0;
		drugsInfo[playerid][fltHealth] = 0;
	}
	} 
	new carid = GetPlayerVehicleID(playerid); 
	//Start
	if (GetPVarInt(playerid,"ColorFire"))
	{
	    if (GetPlayerWeapon(playerid) == 41 && IsAGang(playerid))
	    {
	        new tag_g = GetPVarInt(playerid,"TagInfoID");
	        if (GetPVarInt(playerid,"TagInfoID"))
	        {
	            if (IsPlayerInRangeOfPoint(playerid,3.0,TagInfo[tag_g][tPos][0],TagInfo[tag_g][tPos][1],TagInfo[tag_g][tPos][2]))
		{
		    new Float:angle;
		    GetPlayerFacingAngle(playerid, angle);
			if (angle < TagInfo[tag_g][tRPos][2]-60.0 || angle > TagInfo[tag_g][tRPos][2]+120.0)
		    {
			new ammo = GetPVarInt(playerid,"ColorFire") - 500;
			if (GetPlayerAmmo(playerid) > ammo)
			{
			    /*33new str_[12];
                            format(str_, sizeof str_, "~r~%d",GetPlayerAmmo(playerid) - ammo);
           			GameTextForPlayer(playerid, str_, 500, 2);*/
			}
			else
			{
			    if (TagInfo[tag_g][tFraction] != 0)
				{
				DestroyDynamicObject(TagInfo[tag_g][tID]);
				tFractionGraffiti[TagInfo[tag_g][tFraction]] --;
				GiveFractionRepute(TagInfo[tag_g][tFraction], -10);
				}
				else
				{
				DestroyDynamic3DTextLabel(TagInfo[tag_g][tText]);
				}
				TagInfo[tag_g][tFraction] = pInfo[playerid][pMember];
				tFractionGraffiti[TagInfo[tag_g][tFraction]] ++;
				
				new query_[128];
				mysql_format(dbHandle, query_,sizeof query_,"UPDATE s_users SET GraffitiCount = GraffitiCount + 1 WHERE pID = '%d' LIMIT 1", pInfo[playerid][pID]);
				mysql_tquery(dbHandle, query_, "", "");
		    		switch(pInfo[playerid][pMember])
				{
				
				    case FRACTION_GROVE: TagInfo[tag_g][tID] = CreateDynamicObject(18659,TagInfo[tag_g][tPos][0],TagInfo[tag_g][tPos][1],TagInfo[tag_g][tPos][2],TagInfo[tag_g][tRPos][0],TagInfo[tag_g][tRPos][1],TagInfo[tag_g][tRPos][2]);
				    case FRACTION_BALLAS: TagInfo[tag_g][tID] = CreateDynamicObject(18664,TagInfo[tag_g][tPos][0],TagInfo[tag_g][tPos][1],TagInfo[tag_g][tPos][2],TagInfo[tag_g][tRPos][0],TagInfo[tag_g][tRPos][1],TagInfo[tag_g][tRPos][2]);
				    case FRACTION_RIFA: TagInfo[tag_g][tID] = CreateDynamicObject(18663,TagInfo[tag_g][tPos][0],TagInfo[tag_g][tPos][1],TagInfo[tag_g][tPos][2],TagInfo[tag_g][tRPos][0],TagInfo[tag_g][tRPos][1],TagInfo[tag_g][tRPos][2]);
				    case FRACTION_AZTEC: TagInfo[tag_g][tID] = CreateDynamicObject(18661,TagInfo[tag_g][tPos][0],TagInfo[tag_g][tPos][1],TagInfo[tag_g][tPos][2],TagInfo[tag_g][tRPos][0],TagInfo[tag_g][tRPos][1],TagInfo[tag_g][tRPos][2]);
				    case FRACTION_VAGOS: TagInfo[tag_g][tID] = CreateDynamicObject(18665,TagInfo[tag_g][tPos][0],TagInfo[tag_g][tPos][1],TagInfo[tag_g][tPos][2],TagInfo[tag_g][tRPos][0],TagInfo[tag_g][tRPos][1],TagInfo[tag_g][tRPos][2]);
				case FRACTION_PIRUS: TagInfo[tag_g][tID] = CreateDynamicObject(18666,TagInfo[tag_g][tPos][0],TagInfo[tag_g][tPos][1],TagInfo[tag_g][tPos][2],TagInfo[tag_g][tRPos][0],TagInfo[tag_g][tRPos][1],TagInfo[tag_g][tRPos][2]);
				} 
				GiveFractionRepute(pInfo[playerid][pMember], 10);
				GiveFractionPoints(pInfo[playerid][pMember], 1);
				SetPlayerArmedWeapon(playerid, 0);
				SaveGraffiti(tag_g);
				Streamer_Update(playerid, STREAMER_TYPE_OBJECT); 
	    		ApplyAnimation(playerid,"RIOT","Riot_Angry",4.1,0,0,0,0,0,0);
				SetTimerEx("ClearAnim", 2000, false, "d", playerid); 
				OnPlayerQuestProgress(playerid, QUEST_GHETTO, QUEST_TASK_GPOINT_100);
				OnPlayerQuestProgress(playerid, QUEST_GHETTO, QUEST_TASK_PAINT);
			}
			}
	            }
            }
	    	else
		{
		DeletePVar(playerid,"TagInfoID");
		DeletePVar(playerid,"ColorFire");
		}
	    }
	    else DeletePVar(playerid,"ColorFire");
	}
	//Finish 
	if (pTemp[playerid][tDiceTable] == -1 && IsPlayerNearBone(playerid) != -1)
	{
	GameTextForPlayer(playerid,"~g~PRESS ENTER",1300,4);
	}

	GetVehicleParamsEx(carid,engine1,lights2,alarm2,doors3,bonnet2,boot1,objective1);
	new Keys,ud,lr;
	GetPlayerKeys(playerid,Keys,ud,lr);
	if(pTemp[playerid][tDrugsRun])
	{ 
	if((ud || lr) && Keys & KEY_SPRINT) {
		ApplyAnimation(playerid, "PED", "RUN_PLAYER", 4, 1, 1, 1, 1, 1);
	}
	}
	//
	if (LastReconClick[playerid][0] != ud) LastReconClick[playerid][0] = 0;
	if (LastReconClick[playerid][1] != lr) LastReconClick[playerid][1] = 0;
	if (SpecAd[playerid] != INVALID_PLAYER_ID && lr == KEY_LEFT && !LastReconClick[playerid][1])
	{
 	LastReconClick[playerid][1] = lr;
   	PlayerPlaySound(playerid, 1084, 0.0, 0.0, 0.0);
	    SubTextDelete(playerid);
	    DisableEnableReconButton(playerid, ReconSelect[playerid], true);
	    return 1;
	}
	if (SpecAd[playerid] != INVALID_PLAYER_ID && lr == KEY_RIGHT && !LastReconClick[playerid][1])
	{
 	LastReconClick[playerid][1] = lr;
   	PlayerPlaySound(playerid, 1084, 0.0, 0.0, 0.0);
	    if (ReconSelectSub[playerid] == INVALID_TEXT_DRAW) OnPlayerClickPlayerTextDraw(playerid, ReconPlayer[playerid][ReconSelect[playerid]]);
    	else OnPlayerClickPlayerTextDraw(playerid, ReconPlayer[playerid][ReconSelectSub[playerid]]);
    	return 1;
	}
	if (SpecAd[playerid] != INVALID_PLAYER_ID && ud == KEY_UP && !LastReconClick[playerid][0])
	{
 	PlayerPlaySound(playerid, 1083, 0.0, 0.0, 0.0);
	LastReconClick[playerid][0] = ud;
 	if (ReconSelectSub[playerid] == INVALID_TEXT_DRAW)
  	{
    	DisableEnableReconButton(playerid, ReconSelect[playerid], false);
    	if (ReconSelect[playerid] <= 7)
    	{
	    	ReconSelect[playerid] = 15;
   		DisableEnableReconButton(playerid, ReconSelect[playerid], true);
   	 	}
   	 	else
   	 	{
	   	 	ReconSelect[playerid]--;
	    	DisableEnableReconButton(playerid, ReconSelect[playerid], true);
    	}
    	return 1;
	}
	else
	{
  		DisableEnableReconButton(playerid, ReconSelectSub[playerid], false);
		if (ReconSelectSub[playerid] <= ReconBounds[playerid][0])
		{
		ReconSelectSub[playerid] = ReconBounds[playerid][1];
   		DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
		}
		else
		{
		ReconSelectSub[playerid]--;
   		DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
		}
	}
	} 
	if (pTemp[playerid][InGreenZonePlayer] == true)
	{
 	if (GetPlayerWeapon(playerid) > 1) SetPlayerArmedWeapon(playerid,0);
	}
	if (SpecAd[playerid] != INVALID_PLAYER_ID && ud == KEY_DOWN && !LastReconClick[playerid][0])
	{
 	PlayerPlaySound(playerid, 1083, 0.0, 0.0, 0.0);
	LastReconClick[playerid][0] = ud;
 	if (ReconSelectSub[playerid] == INVALID_TEXT_DRAW)
  	{
    	DisableEnableReconButton(playerid, ReconSelect[playerid], false);
    	if (ReconSelect[playerid] >= 15)
    	{
   		ReconSelect[playerid] = 7;
  	 		DisableEnableReconButton(playerid, ReconSelect[playerid], true);
    	}
    	else
    	{
   		ReconSelect[playerid]++;
	    	DisableEnableReconButton(playerid, ReconSelect[playerid], true);
    	}
    	return 1;
	}
	else
	{
  		DisableEnableReconButton(playerid, ReconSelectSub[playerid], false);
		if (ReconSelectSub[playerid] >= ReconBounds[playerid][1])
		{
		ReconSelectSub[playerid] = ReconBounds[playerid][0];
   		DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
		}
		else
		{
		ReconSelectSub[playerid]++;
   		DisableEnableReconButton(playerid, ReconSelectSub[playerid], true);
		}
	}
	}
	//if (SpecAd[playerid] != INVALID_PLAYER_ID) return PlayerTextDrawShow(playerid, ReconPlayer[playerid][33]);
	if (ServerSounds)
	{
	new distance = floatround( GetPlayerDistanceFromPoint( playerid, streampos[0], streampos[1], streampos[2]) );
	if (!pTemp[playerid][UseSound] && distance <= rads)
	{
		PlayAudioStreamForPlayer(playerid, stream, streampos[0], streampos[1], streampos[2], rads, 1);
		pTemp[playerid][UseSound] = true;
	}
	if (pTemp[playerid][UseSound] && distance > rads)
	{
		pTemp[playerid][UseSound] = false;
	}
	}
	if (IsPlayerInAnyVehicle(playerid) && GetPlayerWeapon(playerid) == WEAPON_DEAGLE) SetPlayerArmedWeapon(playerid,0);
	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER && (GetPlayerWeapon(playerid) == WEAPON_DEAGLE || GetPlayerWeapon(playerid) == WEAPON_SHOTGSPA || GetPlayerWeapon(playerid) == WEAPON_SAWEDOFF || GetPlayerWeapon(playerid) == WEAPON_MINIGUN || GetPlayerWeapon(playerid) == WEAPON_MP5  )) SetPlayerArmedWeapon(playerid,0);
	return 1;
}
public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	#if defined debug_mode 
	printf("[GM debug] OnPlayerWeaponShot(%s(%d), %d)", pInfo[playerid][pName], playerid, weaponid);
	#endif
    if (pInfo[playerid][pLogin] == 0) return 0;

	pSpecture[playerid][sShout][0]++;
	pSpecture[playerid][sShout][1]++;
	if (hittype == 1)
	{
	pSpecture[playerid][sShout][2]++;
	pSpecture[playerid][sShout][3]++;
	} 

	new Float:fOriginX, Float:fOriginY, Float:fOriginZ, Float:fHitPosX, Float:fHitPosY, Float:fHitPosZ;
	new Float:x, Float:y, Float:z;

	GetPlayerPos(playerid, x, y, z);
	GetPlayerLastShotVectors(playerid, fOriginX, fOriginY, fOriginZ, fHitPosX, fHitPosY, fHitPosZ); 
	new Float:origin_dist = VectorSize(fOriginX - x, fOriginY - y, fOriginZ - z);
	if (origin_dist == 0.0) {
	scmKick(playerid, "Вы были кикнуты по подозрению в читерстве (AC - D9)");
	printf("Call OnPlayerWeaponShot [pLogin = 1] ID: %d (%s) | Kick D9 (%f)", playerid, pInfo[playerid][pName], origin_dist);
	return 0;
	}
	//SendMes(playerid, -1, "length(%f) | origin_dist(%f)", length, origin_dist);

	if (DAMAGER_INFO) {
	if (weaponid != 38)
	{
		if (gettime() - DamagerTime[playerid] < 1) {
		Damager{playerid} += 1;
		} else {
		Damager{playerid} = 0;
		}
		if (Damager{playerid} > 10)
		{
		new Weap = GetPlayerWeapon(playerid);
		if (Weap != 32 && Weap != 28)
		{
			new
			string_[128];
			format(string_, sizeof string_, "<Warning> %s[%d] Damager by Shot (0)[!]: Проверить", pInfo[playerid][pName], playerid);
			SendAdminMessage(COLOR_REDD, string_);
			//return 1;
		}
		else
		{
			Damager{playerid} = 0;
		}
		}
		DamagerTime[playerid] = gettime();
	}
	if (FirstFire[playerid] == 0) FirstFire[playerid] = GetTickCount();
	else {
		SecondFire[playerid] = FirstFire[playerid];
		FirstFire[playerid] = GetTickCount();
		if (FirstFire[playerid] - SecondFire[playerid] < 30/* && weaponid == 24 */) { 
		new
			string_[128];
		format(string_, sizeof string_, "<Warning> %s[%d] Damager by Shot (1)[!]: Проверить", pInfo[playerid][pName], playerid);
		SendAdminMessage(COLOR_REDD, string_);
		}
	}
	} 
	if (weaponid != player_weapon_id[playerid][GetWeaponSlot[weaponid]] && !IsPlayerKicked(playerid) )
	{
	new	
		string_[128];
	format(string_, sizeof string_, "<Warning> %s[%d] был кикнут по подозрению: WeaponHack [code: S:3 Shot].", pInfo[playerid][pName],playerid);
	SendAdminMessage(CGRAY2, string_); 
	scmKick(playerid, "<Warning> Вы были кикнуты по подозрению: WeaponHack [code: S:3 Shot]", COLOR_REDD);
	return 0;
	}
    if (hittype > 4) return false;
	if ((hittype == BULLET_HIT_TYPE_NONE) && GetPlayerDistanceFromPoint(playerid, fX, fY, fZ) > 340.0 && (fX != 0.0 && fY != 0.0 && fZ != 0.0)) return false;
	if (
	(hittype == BULLET_HIT_TYPE_PLAYER && ! IsPlayerConnected(hitid)) || 
	(hittype == BULLET_HIT_TYPE_VEHICLE && !IsValidVehicle(hitid)) || 
	(hittype == BULLET_HIT_TYPE_OBJECT && !IsValidVehicle(hitid)) || 
	(hittype == BULLET_HIT_TYPE_PLAYER_OBJECT && !IsValidPlayerObject(playerid, hitid))
	) return false;  


	if (hittype == BULLET_HIT_TYPE_PLAYER)
	{
	new	
		string_[128];
	if (fX == -0.009999 && fY == -0.019999 && fZ == 0.039999)
	{
		format(string_, sizeof string_, "<Warning> %s[%d] был кикнут по подозрению: Eclipse Crasher", pInfo[playerid][pName],playerid);
		SendAdminMessage(CGRAY2, string_); 
		scmKick(playerid, "<Warning> Вы были кикнуты по подозрению: Eclipse Crasher", COLOR_REDD);
		return false;
	}
	if ((floatcmp(floatabs(fX), 20.0) == 1) || (floatcmp(floatabs(fY), 20.0) == 1) || (floatcmp(floatabs(fZ), 20.0) == 1))
	{
		format(string_, sizeof string_, "<Warning> %s[%d] был кикнут по подозрению: Bullet Crasher", pInfo[playerid][pName],playerid);
		SendAdminMessage(CGRAY2, string_); 
		scmKick(playerid, "<Warning> Вы были кикнуты по подозрению: Bullet Crasher", COLOR_REDD);
		return false;
	}

	if (0 <= weaponid <= 46 && playerid != INVALID_PLAYER_ID && hitid != INVALID_PLAYER_ID)
	{ 
		if (/*pTemp[hitid][PlayerAFK] >= 3 ||*/ pInfo[hitid][pJailTime]) return false;
		else if (pTemp[hitid][PlayerUseAdminGM]) return false;
		else if (weaponid == 41) return false;
		else if ((weaponid == 4 || weaponid == 33) && pTemp[playerid][tJobHunter]) {
		SendClientMessage(playerid, COLOR_ORANGE, !"[Охота] "colwhi"Оружие не для стрельбы по людям!");
		return false;
		} 
		else if ((weaponid == 24 || weaponid == 25) && NewTazer[playerid] == true && IsACop(playerid) )
		{
		if (pTemp[hitid][tPlayerCuffed] != 2)
		{
			ApplyAnimation(hitid, "PED", "KO_skid_front", 6.0, 0, 1, 1, 1, 0);
			pTemp[hitid][tPlayerCuffed] = 1;
			PlayerCuffedTime[hitid] = 10;
			pTemp[hitid][tFreezePlayer] = true;
			TogglePlayerControllable(hitid, 0);
			GameTextForPlayer(hitid, !"~r~freeze", 5000, 3);
			if (GetPlayerWantedLevel(hitid) > 0 ) {
			OnPlayerQuestProgress(playerid, QUEST_PD, QUEST_TASK_PD_TAZER);
			}
		}
		return false;
		}
	}
	}
	new skil_id = GetWeaponSkill(weaponid);
	if (skil_id != 0xFFFF)
    {
        if (pInfo[playerid][pGunSkill][skil_id] < 100)
        {
            if (pTemp[playerid][TempGunSkill][skil_id] > GetShotsSkillLevel(skil_id)-1)
            {
                pTemp[playerid][TempGunSkill][skil_id] = 0;
		if (pInfo[playerid][VIPRank] != 0 || pInfo[playerid][BoostRank] != 0) {
			pInfo[playerid][pGunSkill][skil_id] += GetVipBoostMaxPlayerValue(playerid, vSkillGun, bSkillGun, 1); // vSkillGun
		}
		else pInfo[playerid][pGunSkill][skil_id]++;
                 
		new
			weapon_name[32],
			string_[128];
		WC_GetWeaponName(weaponid, weapon_name);
                format(string_, sizeof string_,"~w~~n~~n~~n~~n~~n~~n~~n~~n~~g~%s~n~~r~%d/100", weapon_name, pInfo[playerid][pGunSkill][skil_id]);
		GameTextForPlayer(playerid, string_, 2000, 3);

                if (pInfo[playerid][pGunSkill][skil_id] > 99) pInfo[playerid][pGunSkill][skil_id] = 100;
    		
                SetPlayerSkillLevel(playerid, GetSkillLevel(weaponid), pInfo[playerid][pGunSkill][skil_id]*10);

		if (IsAArmy(playerid) && pInfo[playerid][pGunSkill][skil_id] > 99 ) {
			if (IsPlayerProgress(playerid, QUEST_TASK_ARMY_KMB)) OnPlayerQuestProgress(playerid, QUEST_ARMY, QUEST_TASK_ARMY_KMB);
		}
            }
            else pTemp[playerid][TempGunSkill][skil_id]++;
        }
    } 
	if (SystemConfig[gAntiCBug] && (!IsPlayerInAnyVehicle(playerid) && IsCbugTime(weaponid) > 1 && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0 && !IsPlayerToGhetto(playerid))/* && !IsPlayerToMafiaWar(playerid)*/)
    {
	if (GetTickCount() - lastDShot[playerid] < IsCbugTime(weaponid) && GetTickCount() - lastDShot[playerid] > 0)//IsPlayerToMafiaWar(playerid)
	{               
		SetPlayerArmedWeapon(playerid,0);
		ApplyAnimation(playerid, !"PED", !"getup_front",4.0,0,0,0,0,0);
		GameTextForPlayer(playerid, !"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ANTI_+C", 2000, 3);
		return 0;
	}
	lastDShot[playerid] = GetTickCount();
    } 
    return 1;
}  
// #include "../source/publics/query/onqueryerror.pwn"
public OnQueryError(errorid, const error[], const callback[], const query[], MySQL:handle)
{
	//ABroadCast(COLOR_YELLOW, "[DEV] [MYSQL ERROR]. Сообщите разработчикам!", 5);
	printf("[MySQL ERRORID]: %d", errorid);
	//printf("[MySQL ERROR]: %s", error);
	printf("[MySQL CALLBACK]: %s", callback);
	printf("[MySQL QUERY]: %s", query);
	return 1;
}
public OnRconCommand(cmd[])
{
	return 1;
}
public OnRconLoginAttempt(ip[], password[], success)
{
	if (!success) //Если пароль введёный игроком был неправильный.
    {
        printf("RCON Login: Неудачная попытка входа %s использованный пароль %s",ip, password);
        new pip[16];
	foreach (new i: Player) 
        {
            GetPlayerIp(i, pip, sizeof(pip));
            if (!strcmp(ip, pip, true)) //Если, IP игрока, который ввёл неверный пароль нашёлся.
            {
                SendClientMessage(i, 0xFFFFFFFF, "Неверный пароль. Удачи"); //Отправить сообщение
                BanEx(i, !"попытка rcon login");
            }
        }
    }
	return 1;
}
