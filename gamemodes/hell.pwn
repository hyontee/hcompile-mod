			logicalString[antiCheatConfiguration[AC_INVALID_SURF_OBJECT]],
			logicalString[antiCheatConfiguration[AC_INVALID_WEAPONS_UPDATE]],
			logicalString[antiCheatConfiguration[AC_INVALID_WEAPON_SHOT]],
			logicalString[antiCheatConfiguration[AC_INVALID_AMMO_SHOT]]
			
			);

		ShowPlayerDialog(playerid, D_ANTICHEAT, DIALOG_STYLE_LIST, "Конфигурация анти-чита", dialogBuffer,
		"Изменить", "Отмена");

		AC_UpdateSettings(listitem);

		#endif
	}
	case D_PLAYER_TATGET_0: {
		if (!response) {
		pTemp[playerid][tPlayerTargetID] = INVALID_PLAYER_ID;
		return 1;
		}
		new target_id = pTemp[playerid][tPlayerTargetID];
		switch(listitem) {
		case 0: {
			if (IsACop(target_id)) return SendClientMessage(playerid, COLOR_GREY, !"Вы не можете задержать законника");
			new 
			string_[128];
			format(string_, sizeof string_, "проводит задержание подозреваемого %s", pInfo[target_id][pName]);
			MeAction(playerid, string_, SELECT_ACTION_IN_BUBBLE);
			MeAction(playerid, ""colwhi"Вы имеете право хранить молчание. Всё, что вы скажете, может и будет использовано против вас. Вы понимаете свои права?", SELECT_ACTION_IN_CHAT); 
		}
		case 1: { 
			MeAction(playerid, "показал(a) удостоверение полицейского", SELECT_ACTION_IN_BUBBLE); 
			MeAction(playerid, "показал(a) удостоверение полицейского", SELECT_ACTION_IN_CHAT);  
			SetPlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1, 1581, 5,0.092000,0.030999,-0.006000,15.399999,82.499771,178.099761,0.195999,0.114999,0.221000);
			if(HideObjHands[playerid] != -1) {
			KillTimer(HideObjHands[playerid]);
			HideObjHands[playerid] = -1;
			}
			HideObjHands[playerid] = SetTimerEx("HideObjectsHands", 1255, false, "ii", playerid, ATTACHED_SLOT_JOB_1);
			ApplyAnimation(playerid,"GHANDS", "gsign5LH", 4.1,0,0,0,0,0,1); 
			ShowPlayerCertificate(target_id, playerid);
		}
		case 2: {
			if (IsACop(target_id)) return SendClientMessage(playerid, COLOR_GREY, !"Вы не можете оглушить законника");
			if (pTemp[target_id][tPlayerCuffed] == 2) return SendClientMessage(playerid, COLOR_GREY, !"Игрок уже в наручниках");  
			SetPlayerHealth(target_id, GetPlayerHP(playerid));
			ApplyAnimation(target_id, "PED", "KO_skid_front", 6.0, 0, 1, 1, 1, 0);
			pTemp[target_id][tPlayerCuffed] = 1;
			PlayerCuffedTime[target_id] = 10;
			GameTextForPlayer(target_id, !"~r~freeze", 5000, 3);
			if (GetPlayerWantedLevel(target_id) > 0 ) {
			OnPlayerQuestProgress(playerid, QUEST_PD, QUEST_TASK_PD_TAZER);
			} 
			MeAction(playerid, "оглушил(а) подозреваемого", SELECT_ACTION_IN_BUBBLE); 
		}
		case 3: {
			pc_cmd_cuff(playerid, IntToStr(target_id));
		}
		case 4: {
			pc_cmd_frisk(playerid, IntToStr(target_id));
		}
		case 5: {
			pc_cmd_follow(playerid, IntToStr(target_id));
		}
		}
		return 1;
	}
