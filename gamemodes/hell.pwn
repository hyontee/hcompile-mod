			"[0] Респавн транспорта\n[1] Настроить доступ к транспорту\n[2] Поставить метку "col_li_red"GPS\n"colwhi"[3] Купить новый ТС за "collime"G-Points", 
			"Выбрать", "Назад"
			);
			SetPVarInt(playerid, "listCarIDX", listitem);
		}
		else
