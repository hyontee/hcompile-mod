			format(string_,sizeof(string_),"- Диспетчер: Вам вызов от %s. Местонахождение: г.%s %s",pInfo[playerid][pName],pos,str_pos2);
			scm(i, COLOR_RED, string_);
			format(string_,sizeof(string_),"Примерное расстояние %.1f метр(-ов). Введите \"(/ac)cept medic\" чтобы принять вызов", odist);
			scm(i, COLOR_RED, string_);
		}
		}
		SendClientMessage(playerid, COLOR_RED, "- Диспетчер: ваше сообщение доставлено, подождите пока примут вызов");
		MedicCall = playerid;
		SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
		return 1;
