		ShowPlayerDialog(playerid, D_FRACTION_FUNC_13, DIALOG_STYLE_LIST, pvar_string, "[0] Информация об игроке\n[1] Уволить из организации\n[2] Повысить/понизить игрока", "Выбрать", "Назад" ) ;
