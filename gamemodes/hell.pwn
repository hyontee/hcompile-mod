		if (VehicleInfo[ V_IDX - 1 ][vFraction] == RENT_CAR_LOS_SANTOS)
		{
		    if (arenda[playerid] != V_IDX) {
			ShowPlayerDialog(playerid, D_RENT_CAR_1,DIALOG_STYLE_MSGBOX, " ", ""colwhi"<< Автосалон Лос Сантос >>\nЦена аренды: "collime"$1500\n\n"colwhi"Вы хотите взять автомобиль на прокат?", "Да", "Нет");
		}
		}
		if (VehicleInfo[ V_IDX - 1 ][vFraction] == RENT_CAR_LAS_VETURAS)
		{
		    if (arenda[playerid] != V_IDX) {
			ShowPlayerDialog(playerid, D_RENT_CAR_1,DIALOG_STYLE_MSGBOX, " ", ""colwhi"<< Автосалон Лас Вентурас >>\nЦена аренды: "collime"$1500\n\n"colwhi"Вы хотите взять автомобиль на прокат?", "Да", "Нет");
		}
		}
	}

	if (VehicleInfo[ V_IDX - 1 ][vType] == VEHICLE_TYPE_PLAYER)
	{
		if (pTemp[playerid][tTheftIDCar] != INVALID_VEHICLE_ID/* && pInfo[playerid][pJob] == 10*/)
		{
		if (V_IDX == pTemp[playerid][tTheftIDCar])
		{
			rabotaon[playerid] = true;
			VehicleInfo[ V_IDX - 1 ][vJacker] = 1;
			new rand = random(sizeof(acarsd));
			if (pTemp[playerid][tTheftSkladID] == -1)
			{
			SendClientMessage(playerid, COLOR_BLUE, !"[SMS]: Это то что нам нужно! Гони её на склад!");
			SetPlayerCheckpoint(playerid, acarsd[rand][0], acarsd[rand][1], acarsd[rand][2], 8);
			pTemp[playerid][tTheftSkladID] = rand;
			GangZoneDestroy(pTemp[playerid][tTheftGZ]);
			pTemp[playerid][tTheftGZ] = INVALID_GANGZONE_ID;
			} 
			else
			{
			new 
				id_sklad = pTemp[playerid][tTheftSkladID];
			SetPlayerCheckpoint(playerid, acarsd[id_sklad][0], acarsd[id_sklad][1], acarsd[id_sklad][2], 8); 
			}
		}
		}
	}


	if (VehicleInfo[ V_IDX - 1 ][vType] == VEHICLE_TYPE_JOB_FARM)
	{
		if (Farmcar_prods[V_IDX]) {
		SendMes(playerid, -1, "В транспорте %d ед. урожая.", Farmcar_prods[V_IDX]);
		}
            new farm_id_car = VehicleInfo[ V_IDX - 1 ][vFraction];
            if (VehicleInfo[ V_IDX - 1 ][vSubFraction] == F_VEHILE_FARM_SEEDCAR)
            {
                if (VehicleInfo[ V_IDX - 1 ][vJobLoad]) {
                    ShowPlayerDialog(playerid, D_JOB_FERM_LOAD,DIALOG_STYLE_MSGBOX, " ", ""colwhi"Вы хотите закончить сбор урожая?", "Да", "Нет");
                }
                else ShowPlayerDialog(playerid,D_JOB_FERM_LOAD,DIALOG_STYLE_MSGBOX, " ", ""colwhi"Вы хотите начать сбор урожая?", "Да", "Нет");
            }
            else if (VehicleInfo[ V_IDX - 1 ][vSubFraction] == F_VEHILE_FARM_COMBINE)
            {
                if (FarmInfo[farm_id_car][fGrain_Sown] > 0) {
                    RemovePlayerFromVehicle(playerid);
                    SendClientMessage(playerid, COLOR_GREY, !"На поле ещё есть урожай");
                    return 1;
                }
                if (FarmInfo[farm_id_car][fGrain] < 5000) {
                    RemovePlayerFromVehicle(playerid);
                    SendClientMessage(playerid, COLOR_GREY, !"На складе фермы недостаточно зерна");
                }
                SetPVarInt(playerid,"farm_status",5);
                pPressed[playerid] = 0;
                new idx_ = pPressed[playerid];
                switch(farm_id_car)
                {
                    case 1: SetPlayerRaceCheckpoint(playerid,0, Farmcombine_coord_one[idx_][0], Farmcar_coord_one[idx_][1], Farmcar_coord_one[idx_][2], Farmcombine_coord_one[idx_ +1][0], Farmcar_coord_one[idx_+1][1], Farmcar_coord_one[idx_+1][2],5.0);
                    case 2: SetPlayerRaceCheckpoint(playerid,0, Farmcombine_coord_two[idx_][0], Farmcombine_coord_two[idx_][1], Farmcombine_coord_two[idx_][2], Farmcombine_coord_two[idx_+1][0], Farmcombine_coord_two[idx_+1][1], Farmcombine_coord_two[idx_+1][2],5.0);
                    case 3: SetPlayerRaceCheckpoint(playerid,0, Farmcombine_coord_three[idx_][0], Farmcombine_coord_three[idx_][1], Farmcombine_coord_three[idx_][2], Farmcombine_coord_three[idx_+1][0], Farmcombine_coord_three[idx_+1][1], Farmcombine_coord_three[idx_+1][2],5.0);
                    case 4: SetPlayerRaceCheckpoint(playerid,0, Farmcombine_coord_four[idx_][0], Farmcombine_coord_four[idx_][1], Farmcombine_coord_four[idx_][2], Farmcombine_coord_four[idx_+1][0], Farmcombine_coord_four[idx_+1][1], Farmcombine_coord_four[idx_+1][2],5.0);
                    case 5: SetPlayerRaceCheckpoint(playerid,0, Farmcombine_coord_five[idx_][0], Farmcombine_coord_five[idx_][1], Farmcombine_coord_five[idx_][2], Farmcombine_coord_five[idx_+1][0], Farmcombine_coord_five[idx_+1][1], Farmcombine_coord_five[idx_+1][2],5.0);
                }
            }
	}
	// tyt
	if (VehicleInfo[ V_IDX - 1][vType] == VEHICLE_TYPE_DYNAMIC && VehicleInfo[ V_IDX - 1][vFraction] == DYNAMIC_VEH_MATS)
	{
		if (IsAGang(playerid) || IsAMafia(playerid))
		{
		new str_tmp[28];
		format(str_tmp, sizeof str_tmp, "В фургоне %d материалов",VehicleInfo[ V_IDX - 1 ][vMaterials]);
		SendClientMessage(playerid, COLOR_INF, str_tmp);

		static Float:unloading_delivery_mats[8][3] = {

			{2644.6416,-2024.3840,13.5469}, // unloading ballas
			{2782.0908,-1609.1428,10.9219}, // unloading vagos
			{2504.0674,-1682.7295,13.5469}, // unloading grove
			{1669.4633,-2112.7056,13.5469}, // unloading aztec
			{2173.0042,-1804.0236,13.3696}, // unloading rifa
			{1447.3246,758.7495,10.8203}, // unloading LCN
			{1466.8739,2773.6145,10.6719}, // unloading yakuza
			{961.2510,1732.4156,8.6484} // unloading rm

		};

		pTemp[playerid][TypeCheckpoint] = 1;

		new tmp_id = capture_band(pInfo[playerid][pMember]);

		SetPlayerRaceCheckpoint(playerid,1,
			unloading_delivery_mats[tmp_id][0],
			unloading_delivery_mats[tmp_id][1],
			unloading_delivery_mats[tmp_id][2],
			0.0,0.0,0.0, 6.0);
		}
	}
	}
    if (newstate == PLAYER_STATE_ONFOOT)//Пешком
	{
	   	if (pTemp[playerid][TestAutoShcool])//Автошкола
	{
		SendClientMessage(playerid, COLOR_RED, !"Автосдача прекращена, вы покинули автомобиль");
		DisablePlayerRaceCheckpoint(playerid);
		pTemp[playerid][TestAutoShcool] = false;
	    	pTemp[playerid][CheckpointPressed] = 0;
	    	pTemp[playerid][TakingLesson] = false;
		SetVehicleToRespawn(V_IDX);
		return 1;
	}
	if (GetPVarInt(playerid,"farm_status") == 3 || GetPVarInt(playerid,"farm_status") == 5)
	{
		DisablePlayerRaceCheckpoint(playerid);
		DeletePVar(playerid,"farm_status");
	}
	if (pInfo[playerid][pJob] == PLAYER_JOB_MECHANIC && pTemp[playerid][gContract])
	{
		if (pTemp[playerid][Mechanic3DText] != Text3D:-1) {
		DestroyDynamic3DTextLabel(pTemp[playerid][Mechanic3DText]);
		pTemp[playerid][Mechanic3DText] = Text3D:-1;
		}
		pTemp[playerid][gContract] = INVALID_PLAYER_ID;
		DeletePVar(playerid,"CostBenzMeh");
	}
	if (TalkingLive[playerid] == 2)
	{
		SendClientMessage(playerid, 0x6495EDFF, !"Прямой эфир завершён");
		SendClientMessage(TalkingLive[playerid], 0x6495EDFF, !"Прямой эфир завершён");
		TogglePlayerControllable(playerid, 1);
		TogglePlayerControllable(TalkingLive[playerid], 1);
		TalkingLive[TalkingLive[playerid]] = 255;
		TalkingLive[playerid] = 255;
		return 1;
	}
	else if (TalkingLivels[playerid] == 2)
	{
		SendClientMessage(playerid, 0x6495EDFF, !"Прямой эфир завершён");
		SendClientMessage(TalkingLivels[playerid], 0x6495EDFF, !"Прямой эфир завершён");
		TogglePlayerControllable(playerid, 1);
		TogglePlayerControllable(TalkingLivels[playerid], 1);
		TalkingLivels[TalkingLivels[playerid]] = 255;
		TalkingLivels[playerid] = 255;
		return 1;
	}
	else if (TalkingLivelv[playerid] == 2)
	{
		SendClientMessage(playerid, 0x6495EDFF, !"Прямой эфир завершён");
		SendClientMessage(TalkingLivelv[playerid], 0x6495EDFF, !"Прямой эфир завершён");
		TogglePlayerControllable(playerid, 1);
		TogglePlayerControllable(TalkingLivelv[playerid], 1);
		TalkingLivelv[TalkingLivelv[playerid]] = 255;
		TalkingLivelv[playerid] = 255;
		return 1;
	}
	}
	return 1;
}
public OnPlayerStreamIn(playerid, forplayerid)
{
    if (!(pInfo[forplayerid][PlayerSettings] & setShowNickname)) ShowPlayerNameTagForPlayer(forplayerid, playerid,0);
	return 1;
}
public OnPlayerStreamOut(playerid, forplayerid)
{
	if(forplayerid == INVALID_PLAYER_ID) return 0;
	else if(playerid == INVALID_PLAYER_ID) return 0;
	return 1;
} 
public OnPlayerText(playerid, text[])
{
   	if (pInfo[playerid][pLogin] == 0) return 0; 
	#if defined debug_mode  
	printf("[GM debug] OnPlayerText(%s(%d), %s)", pInfo[playerid][pName], playerid, text);
	#endif
    new ip[26], string_[256];
	GetPlayerIp(playerid,ip,sizeof(ip));

	if(!Reklama(playerid, text)) return 0;

	if (pInfo[playerid][pMuted] > 0)
	{
	f(string_, "У Вас бан чата! До снятия: %d секунд(ы)",pInfo[playerid][pMuted]);
	SendClientMessage(playerid, COLOR_LIGHTRED, string_);
	MeAction(playerid, "Пытаеться что-то сказать", SELECT_ACTION_IN_BUBBLE);
	return 0;
	}
	if (pTemp[playerid][AntiFloodText] > gettime()) return SendClientMessage(playerid, 0xFFD5BBAA, "Не флуди!"), false;
	/*if (IsAIP(text) || CheckString(text) || IsValidTextEx(text))
	{ 
	format(string_, sizeof string_, "Сказал: %s: %s",pInfo[playerid][pName],text);
	ABroadCast(COLOR_LIGHTRED, string_,1);
	format(string_, sizeof string_, "ID: %d | IP: [%s] (МУТ НЕ ВЫДАЛ)",playerid,ip);
	ABroadCast(COLOR_LIGHTRED, string_, 1);  
	}*/
	if (TalkingLive[playerid] == 1)
	{
	format(string_, sizeof string_, "< [Тел] SF News > %s: %s", pInfo[playerid][pName], text);
	OOCNews(COLOR_GREEN, string_);
	pTemp[playerid][AntiFloodText] = gettime()+1;
	}
	if (TalkingLivels[playerid] == 1)
	{
	format(string_, sizeof string_, "< [Тел] LS News %s: %s", pInfo[playerid][pName], text);
	LSNews(0x0073B7AA, string_);
	pTemp[playerid][AntiFloodText] = gettime()+1;
	}
	if (TalkingLivelv[playerid] == 1)
	{
	format(string_, sizeof string_, "< [Тел] LV News > %s: %s", pInfo[playerid][pName], text);
	LVNews(TEAM_CYAN_COLOR, string_);
	pTemp[playerid][AntiFloodText] = gettime()+1;
	}
	if (TalkingLive[playerid] == 2)
	{
	if (pInfo[playerid][pMember] == 9)
	{
		format(string_, sizeof string_, "< SF News > Ведущий %s: %s", pInfo[playerid][pName], text);
		OOCNews(COLOR_GREEN, string_);
		pTemp[playerid][AntiFloodText] = gettime()+1;
		return 0;
	}
	else
	{
		format(string_, sizeof string_, "< SF News > Гость %s: %s", pInfo[playerid][pName], text);
		OOCNews(COLOR_GREEN, string_);
		pTemp[playerid][AntiFloodText] = gettime()+1;
		return 0;
	}
	}
	if (TalkingLivels[playerid] == 2)
	{
	if (pInfo[playerid][pMember] == 16)
	{
		format(string_, sizeof string_, "< LS News > Ведущий %s: %s", pInfo[playerid][pName], text);
		LSNews(0x0073B7AA, string_);
		pTemp[playerid][AntiFloodText] = gettime()+1;
		return 0;
	}
	else
	{
		format(string_, sizeof string_, "< LS News > Гость %s: %s", pInfo[playerid][pName], text);
		LSNews(0x0073B7AA, string_);
		pTemp[playerid][AntiFloodText] = gettime()+1;
		return 0;
	}
	}
	if (TalkingLivelv[playerid] == 2)
	{
	if (pInfo[playerid][pMember] == 20)
	{
		format(string_, sizeof string_, "< LV News > Ведущий %s: %s", pInfo[playerid][pName], text);
		LVNews(TEAM_CYAN_COLOR, string_);
		pTemp[playerid][AntiFloodText] = gettime()+1;
		return 0;
	}
	else
	{
		format(string_, sizeof string_, "< LV News > Гость %s: %s", pInfo[playerid][pName], text);
		LVNews(TEAM_CYAN_COLOR, string_);
		pTemp[playerid][AntiFloodText] = gettime()+1;
		return 0;
	}
	}
	if (Tel[playerid] == 1)
	{
	format(string_, sizeof string_, "[Телефон] %s: %s", pInfo[playerid][pName], text);
	ProxDetector(playerid, 20.0, 0xFFFFFFFF, string_);
	return 0;
	}
	if (Mobile[playerid] != 999)
	{
	format(string_, sizeof string_, "[Телефон] %s: %s", pInfo[playerid][pName], text);
	ProxDetector(playerid, 20.0, 0xFFFFFFFF, string_);
	if (IsPlayerConnected(Mobile[playerid]) && Mobile[Mobile[playerid]] == playerid) SendClientMessage(Mobile[playerid], COLOR_YELLOW, string_);
	return 0;
	}
	if (pTemp[playerid][PlayerEfir] == true)
	{
	if (pInfo[playerid][pMember] == 9 || pInfo[playerid][pLeader] == 9)
	{
		format(string_, sizeof string_, "< SF News > %s: %s", pInfo[playerid][pName], text);
		OOCNews(COLOR_GREEN, string_);
	}
	if (pInfo[playerid][pMember] == 20 || pInfo[playerid][pLeader] == 20)
	{
		format(string_, sizeof string_, "< LV News > %s: %s", pInfo[playerid][pName], text);
		LVNews(TEAM_CYAN_COLOR, string_);
	}
	if (pInfo[playerid][pMember] == 16 || pInfo[playerid][pLeader] == 16)
	{
		format(string_, sizeof string_, "< LS News > %s: %s", pInfo[playerid][pName], text);
		LSNews(0x0073B7AA, string_);
	}
	if (Pefir[playerid] == 1)
	{
		format(string_, sizeof string_, "< SF News > %s: %s", pInfo[playerid][pName], text);
		OOCNews(COLOR_GREEN, string_);
	}
	if (Pefir[playerid] == 2)
	{
		format(string_, sizeof string_, "< LS News > %s: %s", pInfo[playerid][pName], text);
		LSNews(0x0073B7AA, string_);
	}
	if (Pefir[playerid] == 3)
	{
		format(string_, sizeof string_, "< LV News > %s: %s", pInfo[playerid][pName], text);
		LSNews(TEAM_CYAN_COLOR, string_);
	}
	pTemp[playerid][AntiFloodText] = gettime()+1;
	return 0;
	}
	if (strcmp(text, "ку", true) == 0|| strcmp(text, "й", true) == 0 || strcmp(text, "q", true) == 0)
	{
	switch(pInfo[playerid][pMember])
	{
		case 13:
		{
		SetPlayerChatBubble(playerid, "показал(a) распальцовку Los Santos Vagos Gang", COLOR_PURPLE,30.0,10000);
		format(string_, sizeof string_, "%s показал(a) распальцовку Los Santos Vagos Gang", pInfo[playerid][pName]);
		SendBeside(playerid,COLOR_PURPLE,string_,30.0);
		if (GetPVarInt(playerid, #PlayerAnimation ) == 0 && !pTemp[playerid][tFreezePlayer])
		{
		    if (GetPVarInt(playerid, "ClearAnimSI") <= gettime()){
			ApplyAnimation(playerid, "GHANDS", "gsign1LH",4.1, 0, 1, 1, 1, 1);
			SetTimerEx("ClearAnim", 2000, false, "d", playerid);
			}
		}
		return 0;
		}
		case 15:
		{
		SetPlayerChatBubble(playerid,"показал(a) распальцовку Grove Street Gang", COLOR_PURPLE,30.0,10000);
		format(string_, sizeof string_, "%s показал(a) распальцовку Grove Street Gang", pInfo[playerid][pName]);
		SendBeside(playerid,COLOR_PURPLE,string_,30.0);
		if (GetPVarInt(playerid, #PlayerAnimation ) == 0 && !pTemp[playerid][tFreezePlayer])
		{
			if (GetPVarInt(playerid, "ClearAnimSI") <= gettime()){
			ApplyAnimation(playerid, "GHANDS", "gsign1LH",4.1, 0, 1, 1, 1, 1);
			SetTimerEx("ClearAnim", 2000, false, "d", playerid);
			}
		}
		return 0;
		}
		case 17:
		{
		SetPlayerChatBubble(playerid, "показал(a) распальцовку Varios Los Aztecas Gang",COLOR_PURPLE,30.0,10000);
		format(string_, sizeof string_, "%s показал(a) распальцовку Varios Los Aztecas Gang", pInfo[playerid][pName]);
		SendBeside(playerid,COLOR_PURPLE,string_,30.0);
		if (GetPVarInt(playerid, #PlayerAnimation ) == 0 && !pTemp[playerid][tFreezePlayer])
		{
			if (GetPVarInt(playerid, "ClearAnimSI") <= gettime()){
			ApplyAnimation(playerid, "GHANDS", "gsign1LH",4.1, 0, 1, 1, 1, 1);
			SetTimerEx("ClearAnim", 2000, false, "d", playerid);
