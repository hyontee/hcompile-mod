		format(str_, sizeof str_, "%s взял со склада %d материалов", pInfo[playerid][pName], d_amount);
		SendBeside(playerid, COLOR_PURPLE, str_, 10.0);
           // SendFamilyMessage(pInfo[playerid][pMember], 0x6BB3FFAA, str_);
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_22, DIALOG_STYLE_LIST, ""colserver"Склад: "colwhi"организации", "[0] Положить материалы\n[1] Положить деньги\n[2] Взять материалы\n[3] Взять деньги", "Выбрать", "Закрыть");
            UpdateFractionStore(fraction_id);
            return 1;
	}
	case D_FRACTION_FUNC_26:
	{
		if (!response) return ShowPlayerDialog(playerid, D_FRACTION_FUNC_22, DIALOG_STYLE_LIST, ""colserver"Склад: "colwhi"организации", "[0] Положить материалы\n[1] Положить деньги\n[2] Взять материалы\n[3] Взять деньги", "Выбрать", "Закрыть");
		new d_amount = strval(inputtext),
		fraction_id = pInfo[playerid][pMember],
		str_[64];

		if (d_amount < 1 || d_amount > 10000000) return ShowPlayerDialog(playerid, D_FRACTION_FUNC_26, DIALOG_STYLE_INPUT,""colserver"Взять: "colwhi"Деньги",""colwhi"Введите количество денег, которое желаете взять:","Взять","Назад");
		if (FractionInfo[fraction_id][fMoney] < d_amount)
		{
		    SendClientMessage(playerid, COLOR_GREY, !"На складе нет столько денег!");
		    return ShowPlayerDialog(playerid, D_FRACTION_FUNC_26, DIALOG_STYLE_INPUT,""colserver"Взять: "colwhi"Деньги",""colwhi"Введите количество денег, которое желаете взять:","Взять","Назад");
		} 
		if (gFraction[fraction_id][fLimitWareHouse] + d_amount > 500_000) {
		new string_[128];
		format(string_, sizeof string_, "Можно снять $%d. Дневной лимит (500.000)", 500_000 - gFraction[fraction_id][fLimitWareHouse]);
		return SendClientMessage(playerid, 0x6495EDFF, string_);
		}
		FractionInfo[fraction_id][fMoney] -= d_amount;
		gFraction[fraction_id][fLimitWareHouse] += d_amount;
		kLibGivePlayerMoney(playerid, d_amount, "взял со склада");
		SaveFractionInfoID(FractionInfo[fraction_id][fID], false);

		format(str_, sizeof str_, "Вы взяли со склада "colserver"%d денег", d_amount);
		SendClientMessage(playerid, COLOR_WHITE, str_);

		//format(str_, sizeof str_, "%s взял со склада $%d", pInfo[playerid][pName], d_amount);
            //SendFamilyMessage(pInfo[playerid][pMember], 0x6BB3FFAA, str_); 
		HistoryStoreLog(playerid, d_amount, "взял со склада");
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_22, DIALOG_STYLE_LIST, ""colserver"Склад: "colwhi"организации", "[0] Положить материалы\n[1] Положить деньги\n[2] Взять материалы\n[3] Взять деньги", "Выбрать", "Закрыть");
            UpdateFractionStore(fraction_id);
            return 1;
	}
	case D_FRACTION_FUNC_27:
	{
		if (!response) return 1;
		new
		target_id = GetPVarInt(playerid, "PlayerChangeSkin");
		if (!IsPlayerConnected(target_id) || pInfo[target_id][pMember] != pInfo[playerid][pMember]) return 1;
		new
		fraction_ = pInfo[target_id][pMember] - 1,
		skinid = gFractionSkin[fraction_][listitem];
		if (skinid == pInfo[target_id][pModel]) return 1;
		SendMes(target_id, COLOR_WHITE, "%s "colserver"%s "colwhi"Изменил Вашу внешность", fFractionRank[pInfo[playerid][pMember]][pInfo[playerid][pRank] - 1] ,pInfo[playerid][pName]);
		SendMes(playerid, COLOR_WHITE, "Вы изменили внешность игрока "colserver"%s",pInfo[target_id][pName]);
		pInfo[target_id][pModel] = skinid;
		SavePlayerInteger(target_id, "pModel", pInfo[target_id][pModel]);
		if (pTemp[target_id][tDutyWork] == 1)
		{
		SetPlayerSkinEx(target_id, skinid);
		}
		DeletePVar(playerid, "PlayerChangeSkin");
	}
	case D_FRACTION_FUNC_28:
	{
		if (!response) return 1;
		if (pInfo[playerid][pLeader]) return SendClientMessage(playerid, COLOR_GREY, !"Данную команду запрещенно использовать лидеру");
		if (!pInfo[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, !"Вы не состоите в организации");
		if (kLibGetPlayerMoney(playerid) < 15_000) return SendClientMessage(playerid, COLOR_GREY, !"У Вас недостаточно средств");
		kLibGivePlayerMoney(playerid, -15_000, "cmd:leave");
		FractionInfo[pInfo[playerid][pMember]][fMoney] += 15_000; 
		UpdateFractionStore(pInfo[playerid][pMember]);
		SaveFractionInfoID(pInfo[playerid][pMember], false);
		uninvite_player(playerid);
		return 1;
	}
	case D_FRACTION_FUNC_29:
	{
		if (!response) {
		DeletePVar(playerid, "listCarIDX");
		return 1;
		}
		switch(listitem)
		{
		case 0:
		{
			new 
			select_list = GetPVarInt(playerid, "listCarIDX");
			if (FractionInfo[ pInfo[playerid][pMember] ][fMoney] < 1000) return SendClientMessage(playerid, COLOR_GREY, !"В банке организации недостаточно средств");
			new veh_point = 0 ;
			for(new vehicleid = 0 ; vehicleid < S_VEHICLE_COUNT ; vehicleid ++)
			{
			if (!IsValidVehicle(vehicleid + 1)) continue;
			if (VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_FRACTION || VehicleInfo[vehicleid][vFraction] != pInfo[playerid][pMember]) continue;
			veh_point ++ ;
			if (select_list == veh_point)
			{
				if (IsVehicleOccupied(vehicleid + 1 ) != -1) return SendClientMessage(playerid, -1, !"Транспорт используется");
				SetVehicleToRespawn(vehicleid + 1 ) ;
				SendClientMessage(playerid, -1, !"Транспорт отремонтирован и отбуксирован к месту стоянки");
				FractionInfo[ pInfo[playerid][pMember] ][fMoney] -= 1000;
				callcmd::lpanel(playerid);
				DeletePVar(playerid, "listCarIDX"); 
				return 1 ;
			}
			}
		}
		case 1: { 
			new 
			select_list = GetPVarInt(playerid, "listCarIDX"),
			fraction_id = pInfo[playerid][pMember]; 
			new veh_point = 0 ;
			for(new vehicleid = 0 ; vehicleid < S_VEHICLE_COUNT ; vehicleid ++)
			{
			if (!IsValidVehicle(vehicleid + 1)) continue;
			if (VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_FRACTION || VehicleInfo[vehicleid][vFraction] != pInfo[playerid][pMember]) continue;
			veh_point ++ ;
