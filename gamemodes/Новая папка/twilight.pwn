stock SendQuestion(playerid)
{

	if(questp[playerid] == 15){
	    if(answersp[playerid] >= 12){
			ShowEndTest(playerid, 1, answersp[playerid]);
		}else{
            ShowEndTest(playerid, 0, answersp[playerid]);
		}

	    return true;
	}else{
	SetAnswers(playerid, answersp[playerid]);
	
	new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
    BS_WriteValue(bitstream, PR_UINT32, 0x95);

    BS_Send(bitstream, playerid);

    BS_Delete(bitstream);


    
	print("send to java next quest...");
   // return true;
	}
}
