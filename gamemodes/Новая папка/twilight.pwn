stock ShowPlayerStats(playerid, to_player = -1)
{
	if(to_player < 0)
		to_player = playerid;

	new fmt_str[1024],
	    rank_value[3] = "?";

    if(1 <= GetPlayerTeamEx(playerid) < MAX_ORG)
	{
		if(1 <= GetPlayerJob(playerid) <= 10)
			valstr(rank_value, GetPlayerJob(playerid));
		else
			rank_value = "1";
	}

	new day, month, year;
    getdate(year, month, day);    

	format
	(
