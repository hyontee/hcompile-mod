			new description[64];

			description = "???? ???";

			format
			(
				fmt_text, sizeof fmt_text,
				"INSERT INTO return_money \
				(uid, money, description, status)\
				VALUES ('%d', '%d', '%s', 0)",
				owner_id,
				GetFuelStationData(i, FS_PRICE) / 10,
				description
			);

			mysql_query(mysql, fmt_text, true);
		}
	}
//	return 1;
}

