stock selectInvItem(playerid, id, model){
	new query[200], Cache: result, rows;
	
	new fmt_text[90];

		//	format(fmt_text, sizeof fmt_text, "?????? %d", pInfo[playerid][model5555]);
		//	SendClientMessage(playerid, -1, fmt_text);

	mysql_format(mysql, query, sizeof query, "SELECT * FROM inv WHERE owner_id=%d AND idInv=%d", GetPlayerAccountID(playerid), id);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();
 	new ij = cache_get_field_content_int(0, "modelId");
 	//format(fmt_text, sizeof fmt_text, "?????????: %d %d %d", id, model, ij);
	//SendClientMessage(playerid, -1, fmt_text);
	SetTimerEx("odetAks", 300, false, "iii", playerid, ij, 8);
	cache_delete(result);
	}
IPacket:0x48(playerid, BitStream:bs)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	new header, rpcid, liters, cost;
	BS_ReadValue(bs, PR_UINT8, header, PR_UINT32, rpcid);
	BS_ReadValue(bs, PR_INT32, liters);
	BS_ReadValue(bs, PR_INT32, cost);

	if(GetVehicleData(vehicleid, V_FUEL) + liters > 149)
	{
	   	 ShowNotification(playerid, 2, "? ???? ?? ??????? ?????!", 5, "", "");
	}
	else
	{
	 	 new mess[100];
	 	 format(mess, sizeof(mess), "{ffffff}?? ??????? ????????? ?????????? ?? {ffd700}%d {ffffff}?????? ?? {ffd700}%d {ffffff}??????!", liters, cost);
	 	 SendClientMessage(playerid, -1, mess);
	 	 SetVehicleData(vehicleid, V_FUEL, GetVehicleData(vehicleid, V_FUEL) + liters);
		 SetFuelProgresss(playerid, GetVehicleData(vehicleid, V_FUEL));
		 GivePlayerMoneyEx(playerid, -cost,  "?????? ??????", true, true);
	}

	return 1;
}
cmd:wheel(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);
	if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, COLOR_WHITE, "???????");
	SetVehicleWheelSize(vehicleid, params[0]);
	}
cmd:bonnet(playerid)
