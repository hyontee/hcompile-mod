stock ShowFuel(playerid, type, price1, price2, price3, price4, price5, maxCount)
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
    BS_WriteValue(bitstream, PR_UINT32, 0x48);
    
    BS_WriteValue(bitstream, PR_INT32, type);
    BS_WriteValue(bitstream, PR_INT32, price1);
    BS_WriteValue(bitstream, PR_INT32, price2);
    BS_WriteValue(bitstream, PR_INT32, price3);
    BS_WriteValue(bitstream, PR_INT32, price4);
    BS_WriteValue(bitstream, PR_INT32, price5);
    BS_WriteValue(bitstream, PR_INT32, maxCount);
    
    BS_Send(bitstream, playerid);

    BS_Delete(bitstream);

    return true;
}
cmd:inv(playerid){show_inv(playerid);loadInv(playerid);}
cmd:invadd(playerid, params[]){
	if(sscanf(params, "dddd",params[0],params[1],params[2],params[3])) return SendClientMessage(playerid, COLOR_WHITE, "??????? id, modelid, dr, col");
	AddInv(playerid, params[0],params[1],params[2],params[3]);
}
stock loadInv(playerid){

	new query[200],
		Cache: result,
		rows;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM inv WHERE owner_id=%d", GetPlayerAccountID(playerid));
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	new id = cache_get_field_content_int(0, "idInv"),
 		ij = cache_get_field_content_int(0, "modelId"),
		dr = cache_get_field_content_int(0, "dr");
	new fmt_text[90];
	//	if(!rows)
	//	return for(new i; i < 12; i++){updInv(playerid,1,id,ij,0,0);}
	updInv(playerid,0,0,0,0,0);
    for(new i = 0; i < rows; i++)
	{   id = cache_get_field_content_int(i, "idInv");
 		ij = cache_get_field_content_int(i, "modelId");
		dr = cache_get_field_content_int(i, "dr");
		updInv(playerid,1,id,ij,dr,1);
		//format(fmt_text, sizeof fmt_text, "?????????: %d %d %d", id, ij, dr);
	//	SendClientMessage(playerid, -1, fmt_text);
	}
	for(new i = 0; i < 12 - rows; i++)
		{
			updInv(playerid,1,9999,0,0,0);
		}
	updInv(playerid, 2, 0 ,0,0,0);
	cache_delete(result);
}
stock updInv(playerid, ction,  id,  modelId,  dr,  col)
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
    BS_WriteValue(bitstream, PR_UINT32, 0x76);

    BS_WriteValue(bitstream, PR_INT32, ction);

    BS_WriteValue(bitstream, PR_INT32, id);

    BS_WriteValue(bitstream, PR_INT32, modelId);

    BS_WriteValue(bitstream, PR_INT32, dr);

    BS_WriteValue(bitstream, PR_INT32, col);

    BS_Send(bitstream, playerid);

    BS_Delete(bitstream);

 return true;
}
