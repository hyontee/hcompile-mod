IPacket:0x94(playerid, BitStream:bs) //sendautoschoolanswer
{
    new header, rpcid, quest, answer;

    BS_ReadValue(bs, PR_UINT8, header, PR_UINT32, rpcid);

    BS_ReadValue(bs,PR_INT32, quest);
    BS_ReadValue(bs,PR_INT32, answer);
    

    new questtt[100];

		format(questtt,  sizeof(questtt), "quest %d", quest);

		print(questtt);
    if(quest > 499){
		classAuto[playerid] = quest; //500 - m????, 501 - ????????, 502 - ????????, 503 - ???????, 504 - ????? ????

	}
    
	if(quest == 52){
		if(classAuto[playerid] == 501){
			new veh = AddStaticVehicle(400, 0.0, 0.0, 0.0, 0.0, 3, 3);
			SetVehiclePos(veh, -2600.5, 79.6, 27.5);
			SetVehicleZAngle(veh, 60);
		///	LinkVehicleToInt(veh, playerid);
			SetPlayerVirtualWorld(playerid, playerid);
			PutPlayerInVehicle(playerid, veh, 0);


		
		}
	}
	else
	{
		questp[playerid] = quest;

	    if(answersYes[quest] == answer){
	   		answersp[playerid] += 1;
		}

		SendQuestion(playerid);

		new questt[100];

		format(questt,  sizeof(questt), "playerid %d, quest %d, answer %d", playerid, quest, answer);

		print(questt);
	}
    
    
}
IPacket:0x97(playerid, BitStream:bs)
{
    new header, rpcid, music, is;

    BS_ReadValue(bs, PR_UINT8, header, PR_UINT32, rpcid);

    BS_ReadValue(bs,PR_INT32, music);
    
    
    
    switch(music){
		case 0:{
			PlayStreamInVehicle(playerid, "http://radio-srv1.11one.ru/record192k.mp3");is = 1;}
    	case 1:{
			PlayStreamInVehicle(playerid, "http://pub0201.101.ru/stream/air/aac/64/99");is = 1;}
    	case 2:{
			PlayStreamInVehicle(playerid, "http://pub0201.101.ru/stream/air/aac/64/99");is = 1;}
    	case 3:{
			PlayStreamInVehicle(playerid, "http://emgregion.hostingradio.ru:8064/moscow.europaplusf.mp3");is = 1;}
		default:{
			StopStreamInVehicle(playerid);
			is = 0;
		}
	}

	sendMusic(playerid, 0,  4,  1,  0,  is, music);
	PlayedMusic[playerid] = music;
}
stock sendMusic(playerid, page1,  num,  page2,  but,  isPlay, currentMusic)
{
	new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
    BS_WriteValue(bitstream, PR_UINT32, 0x150);
    
    BS_WriteValue(bitstream, PR_INT32, page1);
    BS_WriteValue(bitstream, PR_INT32, num);
    BS_WriteValue(bitstream, PR_INT32, page2);
    BS_WriteValue(bitstream, PR_INT32, but);
    BS_WriteValue(bitstream, PR_INT32, isPlay);
    BS_WriteValue(bitstream, PR_INT32, currentMusic);

    BS_Send(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);

    BS_Delete(bitstream);

    return true;
}

