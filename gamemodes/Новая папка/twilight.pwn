stock UpdateAuto(playerid, const text0[], const text1[], const text2[], const text3[])
{
    new BitStream:bitstream = BS_New();
    
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
    BS_WriteValue(bitstream, PR_UINT32, 0x70);

	BS_WriteValue(bitstream, PR_UINT16, strlen(text0));
    BS_WriteValue(bitstream, PR_STRING, text0);

	BS_WriteValue(bitstream, PR_UINT16, strlen(text1));
    BS_WriteValue(bitstream, PR_STRING, text1);
    
    BS_WriteValue(bitstream, PR_UINT16, strlen(text2));
    BS_WriteValue(bitstream, PR_STRING, text2);
    
    BS_WriteValue(bitstream, PR_UINT16, strlen(text3));
    BS_WriteValue(bitstream, PR_STRING, text3);

    BS_Send(bitstream, playerid);

    BS_Delete(bitstream);

    return true;
}
