stock AddInv(playerid, idd, modelId,  dr,  col){
    new query[200],
		Cache: result,
		rows;
	mysql_format(mysql, query, sizeof query, "SELECT * FROM inv WHERE owner_id=%d", GetPlayerAccountID(playerid));
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	new id = cache_get_field_content_int(0, "idInv");
	
	new idf = cache_get_field_content_int(-1, "idInv");

	cache_delete(result);

	if(!rows)
		return mysql_format(mysql, query, sizeof query, "INSERT INTO inv(owner_id, idInv, modelId, dr, col) VALUES (%d, %d, %d, %d, %d)",GetPlayerAccountID(playerid), 0, modelId, dr, col), mysql_query(mysql, query, false);
	
			mysql_format(mysql, query, sizeof query, "DELETE FROM inv WHERE owner_id=%d AND idInv=%d", GetPlayerAccountID(playerid), idf+1);
			mysql_query(mysql, query, false);
			
	
	mysql_format(mysql, query, sizeof query, "INSERT INTO inv(owner_id, idInv, modelId, dr, col) VALUES (%d, %d, %d, %d, %d)",GetPlayerAccountID(playerid), idf+1, modelId, dr, col);
	 mysql_query(mysql, query, false);
	ShowNotification(playerid,1, "??????? ??? ???????? ??? ? ?????????.", 3, "", "");

  return 1;
}
stock SveKs(playerid, ksid, Float:posX, Float:posY, Float:posZ, Float:Scale, rotX, rotY, rotZ, slot, j){
    new query[200],
		Cache: result,
		rows;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM ks WHERE owner_id=%d", GetPlayerAccountID(playerid));
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();
	
	new slot2 = cache_get_field_content_int(0, "slot");

	cache_delete(result);

	if(!rows)
		return mysql_format(mysql, query, sizeof query, "INSERT INTO ks(owner_id, Model, PosX, PosY, PosZ, Scale, RotX, RotY, RotZ, Slot, Het) VALUES (%d, %d, %f, %f, %f, %f, %d, %d, %d, %d, %d)",GetPlayerAccountID(playerid), ksid, posX, posY,posZ, Scale,rotX,rotY,rotZ, slot, j), mysql_query(mysql, query, false);

	
	mysql_format(mysql, query, sizeof query, "DELETE FROM ks WHERE owner_id=%d AND slot=%d", GetPlayerAccountID(playerid), slot);
		mysql_query(mysql, query, false);
	mysql_format(mysql, query, sizeof query, "INSERT INTO ks(owner_id, Model, PosX, PosY, PosZ, Scale, RotX, RotY, RotZ, Slot, Het) VALUES (%d, %d, %f, %f, %f, %f, %d, %d, %d, %d, %d)",GetPlayerAccountID(playerid), ksid, posX, posY,posZ, Scale,rotX,rotY,rotZ, slot, j);
	 mysql_query(mysql, query, false);
	
  return 1;
}
