IPacket:0x93(playerid, BitStream:bs)
{
	    new header, rpcid, g, t;

	        BS_ReadValue(bs,PR_UINT8, header,PR_UINT32, rpcid);
	        
	        BS_ReadValue(bs,PR_INT32, t);
	        BS_ReadValue(bs,PR_INT32, g);
	    switch(t){
			case 200914: selectSkinReg(playerid, g);
			case 200915: SetPlayerSkin(playerid, g);
		}
	
	    if(t == 0){SveKs(playerid, pInfo[playerid][pShmotObjectModelId], pInfo[playerid][pShmotObjectPosX], pInfo[playerid][pShmotObjectPosY], pInfo[playerid][pShmotObjectPosZ], pInfo[playerid][pShmotObjectScale], pInfo[playerid][pShmotObjectRotX],pInfo[playerid][pShmotObjectRotY], pInfo[playerid][pShmotObjectRotZ], pInfo[playerid][pShmotObjectSlot], pInfo[playerid][pShmotObjectAttach]);}
        if(g == 0){
			switch(t){
			
			case 1:{
                pInfo[playerid][pShmotObjectPosZ] += 0.05;}
                case 2:{
                pInfo[playerid][pShmotObjectPosX] += 0.05;}
                case 3:{
                pInfo[playerid][pShmotObjectPosY] += 0.05;}
                case 4:{
                if(pInfo[playerid][pShmotObjectScale] < 2.85){
                pInfo[playerid][pShmotObjectScale] += 0.05;}}
                case 5:{
                pInfo[playerid][pShmotObjectRotX] += 5;}
                case 6:{
                pInfo[playerid][pShmotObjectRotY] += 5;}
                case 7:{
                pInfo[playerid][pShmotObjectRotZ] += 5;}
			}
			
        }
        if(g == 1){
			switch(t){
			case 1:{
                pInfo[playerid][pShmotObjectPosZ] -= 0.05;}
                case 2:{
                pInfo[playerid][pShmotObjectPosX] -= 0.05;}
                case 3:{
                pInfo[playerid][pShmotObjectPosY] -= 0.05;}
                case 4:{
                if(pInfo[playerid][pShmotObjectScale] > 0.2){
                pInfo[playerid][pShmotObjectScale] -= 0.05;}}
                case 5:{
                pInfo[playerid][pShmotObjectRotX] -= 5;}
                case 6:{
                pInfo[playerid][pShmotObjectRotY] -= 5;}
                case 7:{
                pInfo[playerid][pShmotObjectRotZ] -= 5;}
			}
        }

        SetPlayerAttachedObject(playerid, pInfo[playerid][pShmotObjectSlot], pInfo[playerid][pShmotObjectModelId], pInfo[playerid][pShmotObjectAttach], pInfo[playerid][pShmotObjectPosX], pInfo[playerid][pShmotObjectPosY], pInfo[playerid][pShmotObjectPosZ], pInfo[playerid][pShmotObjectRotX], pInfo[playerid][pShmotObjectRotY], pInfo[playerid][pShmotObjectRotZ], pInfo[playerid][pShmotObjectScale], pInfo[playerid][pShmotObjectScale], pInfo[playerid][pShmotObjectScale]);
}

