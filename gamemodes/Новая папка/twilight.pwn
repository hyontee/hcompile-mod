CMD:e(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return ShowNotification(playerid, 2, "?? ?? ?? ?????", 6, " ", " ");

		if(IsAOwnableCar(vehicleid))
		{
			new index = GetVehicleData(vehicleid, V_ACTION_ID);
			if(!GetOwnableCarData(index, OC_KEY_IN))
			{
				return ShowNotification(playerid, 4, "???? ?? ???????? ? ??????????", 4, "/key", "????????");
			}
		}
		else if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_RENT_CAR && !(GetPlayerRentCar(playerid) == vehicleid && rent_cars_data[vehicleid - first_rent_car_id][rent_car_tenant_id] == playerid))
		{
			TogglePlayerControllable(playerid, true);
			return RemovePlayerFromVehicle(playerid);
		}
		else if(IsAJobCar(vehicleid))
		{
			if(GetPlayerJobCar(playerid) != vehicleid)
			{
				return RemovePlayerFromVehicle(playerid);
			}
		}

	    engine = (GetVehicleParam(vehicleid, V_ENGINE) ^ VEHICLE_PARAM_ON);
		SetVehicleParam(vehicleid, V_ENGINE, engine);
	}
	return 1;
}

CMD:rem(playerid, params[])
{
 	if(!IsPlayerInAnyVehicle(playerid)) return ShowNotification(playerid, 2, "?? ?????? ?????????? ? ??????????", 6, " ", " ");
	if(remen[playerid] == 0)
	{
	    Action(playerid, "?????????? ?????? ????????????");
		ShowNotification(playerid, 2, "?? ??????????? ?????? ????????????", 6, " ", " ");
		remen[playerid] = 1;
	}
	else
	{
	    Action(playerid, "????????? ?????? ????????????");
		ShowNotification(playerid, 2, "?? ?????????? ?????? ????????????", 6, " ", " ");
		remen[playerid] = 0;
	}
	return 1;
}

CMD:checkrem(playerid, params[])
{
    if(!IsPlayerInPoliceTeam(playerid)) return ShowNotification(playerid, 2, "??? ?? ???????? ?????? ???????", 6, " ", " ");
    new magid;
    {
     	if(sscanf(params, "i", magid)) return SCM(playerid, COLOR_GREY, "?????????: /checkrem [ID ??????]");
     	if(!ProxDetectorS(10.0, playerid, magid)) return SCM(playerid, COLOR_WHITE, "?? ??????? ??????.");
     	if(remen[magid] == 0)
     	{
        	ShowNotification(playerid, 2, "????? ?? ?????????? ?????? ????????????", 6, " ", " ");
