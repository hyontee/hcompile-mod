forward PovorotnikAlexey();
public PovorotnikAlexey(){
	for(new i; i < MAX_PLAYERS; i ++)
	{
		new veh = GetPlayerVehicleID(i);

        if(povor2[i] == 9){
		    return 1;
	    	}
		if(povor2[i] == 0){
		    if(povor[i] == 0){
	    		SetVehicleToner(veh, 0, 2);
	    		povor[i] = 1;
	    		}
	        else if(povor[i] == 1){
	    		SetVehicleToner(veh, 0, 3);
	    		povor[i] = 0;
	    		}
	    	}

	    if(povor2[i] == 1){
		    if(povor[i] == 0){
	    		SetVehicleToner(veh, 0, 0);
	    		povor[i] = 1;

	    		}
	        else if(povor[i] == 1){
	    		SetVehicleToner(veh, 0, 1);
	    		povor[i] = 0;
	    		}
		 }
	}
	return 1;
}
	
