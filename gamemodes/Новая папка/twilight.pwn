CMD:music(playerid,params[])
{
    if (!IsPlayerInAnyVehicle(playerid)) return 0;
    new is;
	showMusic(playerid);
	switch(PlayedMusic[playerid]){
		case 0:{is = 1;}
    	case 1:{is = 1;}
    	case 2:{is = 1;}
    	case 3:{is = 1;}
		default:{
			is = 0;
		}
	}
	sendMusic(playerid, 0,  4,  1,  0,  is, PlayedMusic[playerid]);
	return 1;
}

