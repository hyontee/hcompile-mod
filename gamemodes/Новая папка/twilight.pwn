	{
		format(fmt_text, sizeof fmt_text, "[A] ????????????? %s[%d] ????? %s[%d] %s [%d ????]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, GetWeaponName(weapon_id), weapon_ammo);
