CMD:time(playerid, params[])
{
	
	new fmt_msg[50];
	if(GetPlayerData(playerid, P_WARN_TIME) > 0)
	{
		format(fmt_msg, sizeof fmt_msg, "????? ?? ?????? ??????????????: %d ????", ((GetPlayerData(playerid, P_WARN_TIME) - gettime()) / 86400) + 1);
		SendClientMessage(playerid, 0x66CC00FF, fmt_msg);
	}
    if(GetPlayerData(playerid, P_FMUTE) > 0)
	{
		format(fmt_msg, sizeof fmt_msg, "????? ?? ????????????? ????????? ????: %d:%02d", floatround(GetPlayerData(playerid, P_FMUTE) / 60) /* % 60 */, (GetPlayerData(playerid, P_FMUTE) % 60));
		SendClientMessage(playerid, 0x32a44bFF, fmt_msg);
	}
	if(GetPlayerData(playerid, P_MUTE) > 0)
	{
		format(fmt_msg, sizeof fmt_msg, "????? ?? ????????????? ????: %d:%02d", floatround(GetPlayerData(playerid, P_MUTE) / 60) /* % 60 */, (GetPlayerData(playerid, P_MUTE) % 60));
		SendClientMessage(playerid, 0x66CC00FF, fmt_msg);
	}

	if(GetPlayerData(playerid, P_JAIL) > 0)
	{
		format(fmt_msg, sizeof fmt_msg, "????? ?? ????? ??????????: %d:%02d", floatround(GetPlayerData(playerid, P_JAIL) / 60) /* % 60 */, (GetPlayerData(playerid, P_JAIL) % 60));
		SendClientMessage(playerid, 0x66CC00FF, fmt_msg);
	}
	
	ShowCurrentTime(playerid);

	return 1;
}

