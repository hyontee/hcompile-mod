   			Dialog
			(
				playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
    			"{FF0000}???????? ? MySQL",
				"{FFFFFF}??? ?????? ?? ????? ?????????? ???? ??????\n"\
				"????? ? ??? ??? ????? MYSQL_HOST, ???? ????? ?????? MySQL ?????? ???????",
				"????", ""
			);
			Kick:(playerid, "", 3000);
		}
		cache_delete(result);

		#if defined _MAP_INCLUDED
		RemoveBuildings(playerid);
		#endif

	}
	return 1;
}

