	    new header, rpcid, typefuel, literfuel;

	        BS_ReadValue(bs, PR_UINT8, PACKET_CUSTOMRPC);
    		BS_ReadValue(bs, PR_UINT8, 0x129);
	        BS_ReadValue(bs,
	        PR_INT32, typefuel);
	        BS_ReadValue(bs,
	        PR_INT32, literfuel);

		format(string, sizeof(string), "?? ??????? ????????? %d ? ?? %d ??????!", literfuel, typefuel);
    	SendClientMessage(playerid, COLOR_ADM, string);

	    return 1;
}
