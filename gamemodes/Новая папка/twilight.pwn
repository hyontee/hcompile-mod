	GetPlayerPos(playerid, x, y, z);
	GetPlayerInterior(playerid, intt);
	GetPlayerVirtualWorld(playerid, vw);
	SetVehiclePos(GetPlayerOwnableCar(to_player), x + 2.0, y + 2.0, z);
	SetVehicleVirtualWorld(GetPlayerOwnableCar(to_player), vw);
	LinkVehicleToInterior(GetPlayerOwnableCar(to_player), intt);
	format(fmt_text, sizeof fmt_text, "?? ??????????????? ? %s ??? ?????? ?????????", GetPlayerNameEx(to_player));
