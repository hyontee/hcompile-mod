stock ShowOwnableCarPass(playerid, vehicleid)
{
	new model_id = GetVehicleData(vehicleid, V_MODELID);

	if(model_id && IsAOwnableCar(vehicleid))
	{
		new fmt_str[600];
		new Float: health;
		new index = GetVehicleData(vehicleid, V_ACTION_ID);
		new fuel = 0;
		new number[30];
		if(GetVehicleInfo(model_id-400, VI_FUEL) == 0){
			fuel = 92;
		}
		if(GetVehicleInfo(model_id-400, VI_FUEL) == 1){
			fuel = 95;
		}
		if(GetVehicleInfo(model_id-400, VI_FUEL) == 2){
			fuel = 98;
		}
		if(GetVehicleInfo(model_id-400, VI_FUEL) == 3){
			fuel = 100;
		}
		if(GetVehicleInfo(model_id-400, VI_FUEL) == 4){
			fuel = 1488;
		}
		if(strlen(GetOwnableCarData(index, OC_NUMBER)) < 3){
			format(number, sizeof number, "------ [-]");
		}else{
			format(number, sizeof number, "%s [-]", GetOwnableCarData(index, OC_NUMBER));
	}
		GetVehicleHealth(vehicleid, health);
        
		format
		(
		fmt_str, sizeof fmt_str,
		"{FFFFFF}????????:\t\t\t\t{FFD700}%s\n"\
		"{FFFFFF}?????????:\t\t\t\t{FFD700}%s\n"\
		"{FFFFFF}?????:\t\t\t{FFD700}%s\n"\
		"{FFFFFF}??????:\t\t\t\t\t{FFD700}%i ??.\n"\
		"{FFFFFF}???. ?????????:\t\t\t{FFD700}%d ???.\n"\
		"{FFFFFF}????????:\t\t\t{FFD700}???\n"\
		"{FFFFFF}????????:\t\t\t{FFD700}???\n"\
		"{FFFFFF}??? ???????:\t\t\t{FFD700}%d\n"\
		"{FFFFFF}?????:\t\t\t{FFD700}???\n",
		GetPlayerName(playerid),
		GetVehicleInfo(model_id-400, VI_NAME),
		number,
		floatround(GetVehicleData(vehicleid, V_MILEAGE), floatround_ceil),
		GetVehicleInfo(model_id-400, VI_PRICE),
		fuel
		);
				
			
		
		Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "???. ???????", fmt_str, "???????", "");

		return 1;
	}
	return 0;
}

