		format(fmt_msg, sizeof fmt_msg, "????????????? %s[%d] ???????? ??? ??????? ????????????? \"%s\", ??????????? \"%s\"", GetPlayerNameEx(playerid), playerid, GetPlayerSubdivisionName(to_player), GetPlayerTeamName(to_player));
