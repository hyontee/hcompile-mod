			if(GetPVarInt(playerid, !"xyibobra") == 0)
        	DestroyVehicle(GetPVarInt(playerid, !"xyibobra"));
        	DeletePVar(playerid, !"xyibobra");
			DisablePlayerCheckpoint(playerid);
			rokin[playerid] = 0;
			return 1;
		}
	}
    if(checkk[playerid] == 1)
    {
    new vehicleid = GetPlayerVehicleID(playerid);
    if(GetVehicleModel(vehicleid) == 435)
