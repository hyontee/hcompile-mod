cmd:lowertest(playerid, params[]){
    if(sscanf(params, "d",params[0])) return 0;
    
    new Float:t = float(params[0]) / 1000.0;
    
    new veh = GetPlayerVehicleID(playerid);
    
    SetVehicleSuspensionLower(veh, t);
    
	new pon[100];
	
	format(pon, sizeof(pon), "%f", t);
    
    print(pon);
    
    SCM(playerid, -1, "yspesno");
}
