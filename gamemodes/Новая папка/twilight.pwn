					mysql_format(mysql, query, sizeof query, "SELECT 1 FROM ytpromocode_activations WHERE uip='%e' AND code='%s'", GetPlayerIpEx(playerid), inputtext);
					result = mysql_query(mysql, query, true);
					rows = cache_num_rows();
