    }
    else
    {
    	ShowNotification(playerid, 4, "?? ?? ????????? ??????", 3, "", "");
    }
    return 1;
}
	if(checkk2[playerid] == 1)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(GetVehicleModel(vehicleid) == 435)
		{
		    DisablePlayerCheckpoint(playerid);
		    checkk[playerid] = 0;
		    SetPlayerCheckpoint(playerid, -1042.4738, 2179.5237, 38.0768, 271.7734, 4.0);
		    SendClientMessage(playerid,COLOR_WHITE, "?? ??????? ????????? ????, ??????? {FF6347}15.000 {FFFFFF}??????");
		    GivePlayerMoney(playerid, 15000);
        }
		else
  		{
    		ShowNotification(playerid, 4, "????????? ???????? ??? ??????", 3, "", "");
      	}
        return 1;
}

	new action_type = GetPlayerCPInfo(playerid, CP_ACTION_TYPE);
	if(IsPlayerInCheckpoint(playerid))
