stock PayDay()
{
    GetBizz();
    //Profiler_Dump();

    if(ghour == 00)
	{
		RentHouse();
	}

	save_server_info();

    /////////
    foreach(Player,i)
    {
        if(PI[i][PromoInfo][3] != 0) {
            ++PI[i][PromoHours];
            UpdatePlayerData(i, "promo_hours", PI[i][PromoHours]);
        }
        if(PI[i][get_adm_status])
        {
            PI[i][get_adm_hour] ++;
            UpdatePlayerData(i, "get_adm_hour", PI[i][get_adm_hour]);
        }
        if(PI[i][pWanted] >= 1)
        {
            PI[i][pWanted] -=1;
            SetPlayerWantedLevel(i, PI[i][pWanted]);
        }
        if(armmatbi < 0) armmatbi = 1000;
        else if(armmatsf < 0) armmatsf = 1000;
        else if(kazna < 0) kazna = 0;
        else if(lspdmatbi < 0) lspdmatbi = 1000;
        else if(sfpdmats < 0) sfpdmats = 1000;
        else if(lvpdmats < 0) lvpdmats = 1000;
        else if(fbimats < 0) fbimats = 1000;
        else if(yakuzamats < 0) yakuzamats = 1000;
        else if(rmmats < 0) rmmats = 1000;
        else if(lcnmats < 0) lcnmats = 1000;

        PI[i][pPayCheck] += 250000*PI[i][pRank];

        PI[i][pExp] += 1*PayDayBoost;

        PI[i][pDonatemoney2] += DonateGive;
        new checks = PI[i][pPayCheck];
        if(PI[i][pDonateRank] >=1) GameTextForPlayer(i, "PayDay", 5000, 1);
        else GameTextForPlayer(i, "~w~PayDay", 5000, 1);
        //-------------------------- Работам -------------------
        if(PI[i][pDonateRank] >=1) SendClientMessage(i, 0xeac700aa,  "{FFFFFF}БАНКОВСКИЙ ЧЕК.");
        else SendClientMessage(i, COLOR_GRAD1, " {FFFFFF}БАНКОВСКИЙ ЧЕК.");
        SendClientMessage(i, COLOR_GRAD1, "{FFFFFF}____________________________________");
        SendClientMessage(i, COLOR_GRAD1, "");
        SendMes(i,0xFF8C37AA," {FFFFFF}Налог государству: {11e922}%s", formatInt(nalog));
        PI[i][pBank] -= nalog;
        kazna +=nalog;
        if(PI[i][pDonateRank] >=1)
        {
            SendMes(i,0xFF8C37AA," {FFFFFF}Счет за телефон: {11e922}%d",PI[i][pMobile]);
            SendClientMessage(i, 0xeac700aa, " ");
            SendMes(i,0xFF8C37AA," {FFFFFF}Зарплата: {11e922}%s", formatInt(checks));
            GiveBank(i, checks);
            SendMes(i,0xeac700aa," {FFFFFF}Текущий баланс: {11e922}%s", formatInt(PI[i][pBank]));
            PI[i][pZakonp] += 1;
            PI[i][pBank] += PI[i][pMobile];
            PI[i][pMobile] = 0;
            if(PI[i][pDonateRank] == 3)
            {
                PI[i][pExp]++;
                SendClientMessage(i, COLOR_LIGHTBLUE, " Вы получили дополнительный Респект, за счет VIP Аккаунта.");
            }
            kazna +=1000;
        }
        else
        {
            SendMes(i,0xFF8C37AA," {FFFFFF}Счет за телефон: {11e922}%d",PI[i][pMobile]);
            SendClientMessage(i, COLOR_WHITE, " ");
            SendMes(i,COLOR_WHITE," Зарплата: {11e922}%s", formatInt(checks));
            GiveBank(i, checks);
            SendMes(i,COLOR_WHITE," Текущий баланс: {11e922}%s", formatInt(PI[i][pBank]));
            PI[i][pZakonp] += 1;
            PI[i][pBank] += PI[i][pMobile];
            PI[i][pMobile] = 0;
            kazna +=1000;
        }
        if(PI[i][pAdmin] > 0) {
            PI[i][pDonatemoney2] += 100;
            SCM(i, 4, "Вы получили админ зарплату, в размере 100 донат-очков!");

        }
        if(PI[i][pPremium]) {
            PI[i][pDonateRubNew]++;
            PI[i][pExp] += 3;
            SCM(i, 2, "За наличие Premium-статуса на Ваш аккаунт зачислен 1 донат-рубль!");
            SCM(i, 2, "За наличие Premium-статуса на Ваш аккаунт зачислено дополнительных 3 очка опыта!");
        }
        if(PI[i][pDonateRank] >=1) SendClientMessage(i, 0xeac700aa,"{FFFFFF}____________________________________");
        else SendClientMessage(i,COLOR_GRAD1,"{FFFFFF}____________________________________");
        if(PI[i][punWarns] == 1) { PI[i][punWarnstime] += 1; if(PI[i][punWarnstime] < 10) SendMes(i,COLOR_LIGHTRED,"- [UNWARN] Автоматическое снятие варна через %d час(ов)", 10 - PI[i][punWarnstime]); }
        if(PI[i][punWarns] == 1 && PI[i][punWarnstime] >=10)
        {
            if(PI[i][pWarns] == 1) PI[i][punWarnstime] = 0, PI[i][punWarns] = 0, PI[i][pWarns] -= 1;
            else if(PI[i][pWarns] > 1) PI[i][punWarnstime] = 0, PI[i][punWarns] = 1, PI[i][pWarns] -= 1;
            SendClientMessage(i,COLOR_LIGHTRED, "- [UNWARN] С Вас было снято одно предупреждение!");
        }
        if(GetPVarInt(i, "GetBizz") == 2 && GetPlayerBizz(i) == 1)
        {
            SendMes(i, COLOR_LIGHTRED, "Ваш бизнес {ffffff}%s{fad201} был закрыт по причине: отсутствие продуктов или отсутствие лицензии",BizzInfo[GetPVarInt(i, "PlayerBizz")][bName],BizzInfo[GetPVarInt(i, "PlayerBizz")][bLockTime]);
            SendClientMessage(i, COLOR_LIGHTRED, "Если по истечению {ffffff}12 {fad201}часов бизнес будет закрыт, он будет продан гос-ву");
            DeletePVar(i, "GetBizz");
        }
        else if(GetPVarInt(i, "GetBizz") == 3 && GetPlayerBizz(i) == 1)
        {
            SendMes(i, COLOR_LIGHTRED, "Ваш бизнес {ffffff}%s{fad201} закрыт уже {ffffff}%i {fad201}час(а/ов)",BizzInfo[GetPVarInt(i, "PlayerBizz")][bName],BizzInfo[GetPVarInt(i, "PlayerBizz")][bLockTime]);
            SendClientMessage(i, COLOR_LIGHTRED, "Если по истечению {ffffff}12 {fad201}часов бизнес будет закрыт, он будет продан гос-ву");
            DeletePVar(i, "GetBizz");
        }
        else if(GetPVarInt(i, "GetBizz") == 1)
        {
            SendClientMessage(i, COLOR_LIGHTRED,"Ваш бизнес был продан гос-ву за неуплату налогов");
            SendClientMessage(i, COLOR_LIGHTRED,"Ваши деньги за бизнес были перечислены на ваш счет");
            DeletePVar(i, "GetBizz");
        }
        seans[i] = 0;
        PI[i][pPayCheck] = 0;
        PI[i][pPayDayHad] += 1;
        if(PI[i][pPayDayHad] == 2)
        {
			 ShowNotification(i, 2, "Вы выполнили квест \"Знакомство с сервером\"! Ваша награда: 10 DONATE-RUB", 4, "", "");
		    PI[i][pDonateRubNew] += 10;
		    UpdatePlayerData(i, "pDonateRubNew", PI[i][pDonateRubNew]);
		    PI[i][P_QUEST][1] = 1;
		    UpdatePlayerData(i, "quest_1", PI[i][P_QUEST][1]);
        }
         if(PI[i][pPayDayHad] == 10)
        {
			 ShowNotification(i, 2, "Вы выполнили квест \"Играю уже сто лет!\"! Ваша награда: 40 DONATE-RUB", 4, "", "");
		    PI[i][pDonateRubNew] += 40;
		    UpdatePlayerData(i, "pDonateRubNew", PI[i][pDonateRubNew]);
		    PI[i][P_QUEST][2] = 1;
		    UpdatePlayerData(i, "quest_2", PI[i][P_QUEST][2]);
        }
        PI[i][total_hour] += 1;
        UpdatePlayerData(i, "total_hour", PI[i][total_hour]);

      /*  if(PI[i][total_hour] == 5)
        {
            SendClientMessage(i, COLOR_LIGHTRED,"За 5 отыгранных часов вам было начислено 15 донат-рублей, используйте /donaterub");
            PI[i][pRub] += 15;
        }
        if(PI[i][total_hour] == 100)
        {
            SendClientMessage(i, COLOR_LIGHTRED,"За 100 отыгранных часов вам было начислено 100 донат-рублей, используйте /donaterub");
            PI[i][pRub] += 100;
            PI[i][P_QUEST][1] = 1;
            UpdatePlayerData(i, "quest_1", 1);
        }
        UpdatePlayerData(i, "pRub", PI[i][pRub]);*/
        if(PI[i][Texts][1] > 0) PI[i][Texts][1] --;
        VipNews[i] = 0;
        new exp = PI[i][pExp];
        new nxtlevel = PI[i][pLevel]+1;
        new expamount = nxtlevel*levelexp;
        if(exp >= expamount)
        {
            PI[i][pLevel] += 1;
            PI[i][pExp] = 0;
            SendClientMessage(i,COLOR_WHITE,"Ваш игровой lvl повысился.");
        }
    
        new string[144];

        if(PI[i][PromoHours] >= PI[i][PromoInfo][3] && PI[i][PromoInfo][3])
        {   
            format(string, sizeof(string), "Вы выполнили условия промокода (отыграть %d часов) и получили:",
                PI[i][PromoInfo][3]);

            SCM(i, 2, string);

            if(PI[i][PromoInfo][2] != 0) {
                format(string, sizeof(string), "- Одежду номер %d",
                    PI[i][PromoInfo][2]);

                SendClientMessage(i, -1, string);

                PI[i][pChar] = PI[i][PromoInfo][2];
                SetPlayerSkinEx(i, PI[i][PromoInfo][2]);
            }

            if(PI[i][PromoInfo][0] != 0) {
                format(string, sizeof(string), "- %d донат-очков",
                    PI[i][PromoInfo][0]);

                SendClientMessage(i, -1, string);

                PI[i][pDonatemoney2] += PI[i][PromoInfo][0];
            }

            if(PI[i][PromoInfo][1] != 0) {
                format(string, sizeof(string), "- %d донат-рублей",
                    PI[i][PromoInfo][1]);

                SendClientMessage(i, -1, string);

                PI[i][pDonateRubNew] += PI[i][PromoInfo][1];
            }

            if(PI[i][PromoInfo][4] != 0) {
                format(string, sizeof(string), "- Личный транспорт номер %d",
                    PI[i][PromoInfo][4]);

                SendClientMessage(i, -1, string);

                new Float:cx, Float:cy, Float:cz, Float:ca;
                GetPlayerPos(i, cx, cy, cz);
                GetPlayerFacingAngle(i, ca);

                format
                (
                stringer, sizeof stringer,
                "INSERT INTO ownable_cars \
                    (owner_id,model_id,color_1,color_2,pos_x,pos_y,pos_z,angle,create_time) \
                    VALUES \
                    ('%d','%d','%d','%d','%f','%f','%f','%f','%d')",
                PI[i][pID],
                PI[i][PromoInfo][4],
                random(100),
                random(100),
                cx,
                cy,
                cz,
                ca,
                gettime()
                );

                mysql_tquery(connects, stringer);
            }

            for(new s = 0; s < 5; ++s) {
                PI[i][PromoInfo][s] = 0;
            }

            PI[i][PromoHours] = 0;
            UpdatePlayerData(i, "promo_hours", PI[i][PromoHours]);

            mysql_format(connects, mysql_query_, sizeof(mysql_query_), "UPDATE `accounts` SET `promo_info` = '0,0,0,0,0' \
                WHERE `Name` = '%e'", PI[i][pNames]);

            mysql_tquery(connects, mysql_query_);
        }
    }
    format(stringer1,sizeof(stringer1),"{C2A2DA}Казна штата: "SERVER"%s\n{C2A2DA}Налог государства: "SERVER"%s\n{C2A2DA}Пожертвовать денег введите '/putkazna'", formatInt(kazna), formatInt(nalog));
    Update3DTextLabelText(kaznameria, 0xC2A2DAFF, stringer1);
    ggtime = 0;

	new query_string [ 128 ];
	format ( query_string, sizeof query_string, "UPDATE `family_system` SET `fam_rating` = `fam_rating`+'10'");
	mysql_tquery ( connects, query_string);

    return 1;
}

