cmd:spbikes(playerid) {
    if(PI[playerid][pAdmin] < 10) return 1;
    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(GetVehicleData(i, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_NRG)
        SetVehicleToRespawn(i);
    }
    new string[144];
    format(string, sizeof(string), "Администратор %s[%d] зареспавнил незанятые транспортные средства возле больниц / Спавнов", PI[playerid][pNames], playerid);
    SendClientMessageToAll(COLOR_ORANGE, string);
    return 1;
}
cmd:mpwin(playerid, params[])
{
    if(PI[playerid][pAdmin] < 4) return 1;

    if(sscanf(params,"dd",params[0],params[1])) return SCM(playerid, 1, "Введите: /mpwin [ID] [Очки]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
    if(params[1] > 1000 || params[1] < 50) return SendClientMessage(playerid,COLOR_WHITE,"Нельзя меньше 50 и больше 1000!");
    PI[params[0]][pDonatemoney2] += params[1];
    format(stringer1, sizeof(stringer1), "Администратор %s: МП окончено, победил %s! Он получает %d DonateMoney (/donate)", PI[playerid][pNames],PI[params[0]][pNames], params[1]);
    SendClientMessageToAll(0xFFCD00ff, stringer1);
    SendMes(params[0],COLOR_WHITE, "Ваш донатный счёт: %d DonatMoney {FFFFFF}(( Используйте /donate ))", PI[params[0]][pDonatemoney2]);

    return 1;
}
cmd:mpfd(playerid, params[])
{
    if(!FD[playerid]) return 1;

    if(sscanf(params,"dd",params[0],params[1])) return SCM(playerid, 1, "Введите: /mpfd [ID] [Количество]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
    if(params[1] > 50 || params[1] < 5) return SendClientMessage(playerid,COLOR_WHITE,"Нельзя меньше 5 и больше 50!");
    PI[params[0]][pDonateRubNew] += params[1];
    format(stringer1, sizeof(stringer1), "Основатель %s: МП окончено, победил %s! Он получает %d донат-рублей (/donaterub)", PI[playerid][pNames],PI[params[0]][pNames], params[1]);
    SendClientMessageToAll(0xFFCD00ff, stringer1);
    SendMes(params[0],COLOR_WHITE, "Ваш донатный счёт: %d донат-рублей {FFFFFF}(( Используйте /donaterub ))", PI[params[0]][pDonateRubNew]);

    return 1;
}
cmd:ceject(playerid, params[])
{
    if(sscanf(params, "d",params[0])) return SCM(playerid, 1, "Введите: /ceject [id игрока]");
    if(!ProxDetectorS(8.0, playerid, params[0])) return SCM(playerid,0, "Игрок не рядом с вами!");
    if(PI[playerid][pMember] == 1 || PI[playerid][pMember] == 2 || PI[playerid][pMember] == 10 || PI[playerid][pMember] == 21 || PI[playerid][pMember] == 25) {
        if(IsPlayerInRangeOfPoint(playerid, 10.0,1568.2023,-1694.1594,5.8906)) {
            SetPlayerInteriorEx(params[0],6);
            SetPPos(params[0],253.9933,86.9706,1002.4453);
            SetPlayerFacingAngle(params[0], 278.0311); }
        else if(IsPlayerInRangeOfPoint(playerid, 10.0,-1590.8289,716.0479,-5.2422)) {
            SetPlayerInteriorEx(params[0],10);
            SetPPos(params[0],217.3147,121.3382,999.0156);
            SetPlayerFacingAngle(params[0], 272.8898); }
        else if(IsPlayerInRangeOfPoint(playerid, 10.0,2295.1934,2451.8459,10.8203)) {
            SetPlayerInteriorEx(params[0],3);
            SetPlayerVirtualWorldEx(params[0], 122);
            SetPPos(params[0],238.5033,141.1578,1003.0234);
            SetPlayerFacingAngle(params[0], 359.1617); }
        else return SendClientMessage(playerid, 0x6ab1ffaa, "Вы затолкали приступника в участок."); }
    return 1;
}
cmd:withdraw(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 10.0,2308.8201,-13.2660,26.7422))
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /withdraw [Сумма]");
    if(params[0] < 1 || params[0] > 10000000) { SCM(playerid,0, "Нельзя снять 1 рубль и более 10000000!"); return 1; }
    if(PI[playerid][pBank] < params[0]) return SCM(playerid, 0,"Недостаточно средств!");
    GiveMoney(playerid, params[0]);
    PI[playerid][pBank] -= params[0];
    UpdatePlayerData(playerid, "pBank", PI[playerid][pBank]);
    format(stringer1, sizeof(stringer1), "Вы сняли %s руб.. Остаток: %s руб.",formatInt(params[0]), formatInt(PI[playerid][pBank]));
    SendClientMessage(playerid, COLOR_YELLOW, stringer1);
    return 1;
}
cmd:newswithdraw(playerid, params[])
{
    if(PI[playerid][pMember] != 16 || PI[playerid][pRank] < 12) return 1;
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /newswithdraw [Сумма]");
    if(params[0] < 1 || params[0] > 10000000) return SCM(playerid,0, "Нельзя снять меньше 1 и более 1000000 руб.!");
    if(FracBank[0][fLsnews] < params[0]) return SCM(playerid,0, "В банке Россия 24 нет столько денег");
    FracBank[0][fLsnews] -= params[0];
    GiveMoney(playerid, params[0]);
    SendMes(playerid, 0x6ab1ffaa, "Вы сняли с банка Россия 24: %s руб.", formatInt(params[0]));
    SetOtherInt("FracBank[0][fLsnews]", FracBank[0][fLsnews]);
    return 1;
}
cmd:shield(playerid)
{
    if(TeamPain[playerid] != 0 && StartPaintBall == 2) return SCM(playerid,0,"Использовать щит на PaintBall запрещено.");
    if(IsACop(playerid) || IsAArm(playerid))
    {
        if(shield[playerid] == 0)
        {
			SetPlayerHealth(playerid, 999), shield[playerid] = 1;
			SCM(playerid,0, "Вы надели щит. Ваше здоровье увеличено до 999.");
        }
        else { SCM(playerid,0, "Вы сняли щит. Ваше здоровье уменьшено до 50."), SetPlayerHealth(playerid, 50), shield[playerid] = 0; }
    }
    else return SCM(playerid,0, "Вы не Полицейский/Военный/ФБР");
    return 1;
}
cmd:gomp(playerid)
{
    if(Teleport == 0) return SendClientMessage(playerid, -1, "{AC0000}{ffffff}На данный момент мероприятий нет.");
    else ShowPlayerDialog(playerid, 3333, DIALOG_STYLE_MSGBOX, "{FFCD00}Телепортация", "{ffffff}Вы уверены, что хотите попасть в место проведения мероприятия?", "Да", "Нет");
    return 1;
}
cmd:news(playerid, params[])
{
    if(gag[playerid] == 1) return   SCM(playerid, 0, "У Вас кляп, вы не можете говорить!");
    if(PI[playerid][pMuteTime] > gettime()) return SendClientMessage(playerid, TEAM_CYAN_COLOR, "У Вас бан чата!");
    if(sscanf(params, "s[128]", params[0])) return SCM(playerid, 1, "Введите: /news [текст]");
    if(gag[playerid] == 1) return   SCM(playerid, 0, "У Вас кляп, вы не можете говорить!");
    switch(PI[playerid][pMember])
    {
    case 16:
        {
            new newcar = GetPlayerVehicleID(playerid);
            if(GetVehicleData(newcar, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_NEWS || IsPlayerInRangeOfPoint(playerid, 60.0, -2648.7813,-1827.8384,4.1045)) { } else { SendClientMessage(playerid, COLOR_GRAD1, "Вы не в репортёрской машине / вертолёте / офисе!"); return 1;}
            format(stringer1, sizeof(stringer1), "<  > %s[%d]: %s",PI[playerid][pNames], playerid, params[0]);
            SendClientMessageToAll(0x0073b7AA, stringer1);
        }
    }
    return 1;
}

cmd:live(playerid, params[])
{
    if(PI[playerid][pMuteTime] > gettime()) return SendClientMessage(playerid, TEAM_CYAN_COLOR, "У Вас бан чата!");
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /live [id/name]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Этого игрока нет, или вы указали свой ид");
    if(!ProxDetectorS(5.0, playerid, params[0])) return SCM(playerid,0, "Человек далеко от вас!");
    new newcar = GetPlayerVehicleID(playerid);
    switch(PI[playerid][pMember])
    {
    case 16:
        {
            if(GetVehicleData(newcar, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_NEWS || IsPlayerInRangeOfPoint(playerid, 60.0,1985.5892,0.5061,1381.0035)) { } else { SCM(playerid,0, "Вы не в репортёрской машине / вертолёте / офисе!"); return 1;}
            if(TalkingLivels[playerid] != INVALID_PLAYER_ID)
            {
                SendClientMessage(playerid, 0x6495EDFF, "Прямой эфир завершён");
                SendClientMessage(TalkingLivels[playerid], 0x6495EDFF, "Прямой эфир завершён");
                TogglePlayerControllable(playerid, 1);
                TogglePlayerControllable(TalkingLivels[playerid], 1);
                TalkingLivels[TalkingLivels[playerid]] = INVALID_PLAYER_ID;
                TalkingLivels[playerid] = INVALID_PLAYER_ID;
                return 1;
            }
            format(stringer1, sizeof(stringer1), "Вы предложили %s снять интервью",PI[params[0]][pNames]);
            SendClientMessage(playerid, 0x6495EDFF, stringer1);
            format(stringer1, sizeof(stringer1), "%s предлагает вам снять интервью",PI[playerid][pNames]);
            SendClientMessage(params[0], 0x6495EDFF, stringer1);
            SendClientMessage(params[0], COLOR_WHITE, "Введите /accept livels, чтобы согласиться");
            LiveOfferls[params[0]] = playerid;
        }
    }
    return 1;
}
alias:live("l");

cmd:npanel(playerid, params[])
{
    if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 582 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 488 || IsPlayerInRangeOfPoint(playerid, 150.0,-2659.8176,-1820.6653,4.1045)) {
        if(PI[playerid][pMember] == 16) SPD(playerid,2224, DIALOG_STYLE_LIST, ""SERVER"Россия 24 | {FFFFFF}Бортовой компьютер", "{B8B8B8}Обьявления\n [ 1 ] Прямой эфир\n [ 2 ] Выйти из прямого эфира\n [ 3 ] Начать принимать звонки / смс\n [ 4 ] Завершить принимать звонки / смс\n [ 5 ] Установить цену за звонки и смс\n [ 6 ] Установить цену за объявления", "Принять", "Отмена"); }
    else return SCM(playerid,0, "Вы не в служебном транспорте/офисе!");
    return 1;
}
cmd:advertise(playerid, params[])
{
    if(sscanf(params, "s[128]",params[0])) return SCM(playerid, 1, "Введите: (/ad)vertise [текст]");
    new len = strlen(params[0]);
    if(len > 100) return SCM(playerid,0,"Максимальная длина объявления - 100 символов");
    if(PI[playerid][pMuteTime] > gettime()) return SendClientMessage(playerid, TEAM_CYAN_COLOR, "У Вас бан чата!");
    if(gAdvertCount >= MAX_ADVERT_COUNT) return SCM(playerid,0,"К сожалению, очередь на объявления занята, попробуйте позже");
    if(adverttime > gettime()) return SendClientMessage(playerid,COLOR_WHITE,"Нельзя посылать больше одного сообщения в 30 секунд!");
    if(IsAIP(params[0])) {
        SendClientMessage(playerid, -1, "Подозрения в рекламе!");
        return 0;
    }
    SetPVarString(playerid,"advert",params[0]);
    format(stringer,sizeof(stringer),"{B8B8B8}Цена объявления: {00FF5E}$%d.\n{B8B8B8}Вы действительно хотите отправить объявление?",len*addd);
    SPD(playerid,8454,0,"Объявление",stringer,"Да","Нет");
    return 1;
}

cmd:vipad(playerid, params[])
{
    if(PI[playerid][pDonateRank] == 0) return SendClientMessage(playerid,COLOR_WHITE,"У вас нет VIP аккаунта!");
    if(sscanf(params, "s[128]",params[0])) return SCM(playerid,0, "Используйте: /v(ip)ad [текст]");
    new len = strlen(params[0]);
    if(len > 100) return SCM(playerid,0,"Максимальная длина объявления - 100 символов");
    if(PI[playerid][pMuteTime] > gettime()) return SendClientMessage(playerid, TEAM_CYAN_COLOR, "У Вас бан чата!");
    if(gVipAdvertCount >= MAX_VIP_ADVERT_COUNT) return SCM(playerid,0,"К сожалению, очередь на объявления занята, попробуйте позже");
    if(vipadverttime > gettime()) return SendClientMessage(playerid,COLOR_WHITE,"Нельзя посылать больше одного VIP-объявления в 1 минуту!");
    if(IsAIP(params[0])) {
        SCM(playerid,0, "Обнаружено подозрение в рекламе!");
        return 0;
    }
    SetPVarString(playerid,"advert",params[0]);
    format(stringer,sizeof(stringer),"{FFFFFF}Текст объявления: "SERVER"%s\n{FFFFFF}Количество символов: "SERVER"%d\n\n{afafaf}Вы действительно желаете отправить объявление?", params[0], len);
    SPD(playerid, 8455, DIALOG_STYLE_MSGBOX, ""SERVER"VIP-Объявление", stringer, "Отправить", "Отменить");
    return 1;
}
alias:vipad("vad");

cmd:edit(playerid)
{
	if(PI[playerid][pAdmin] < 8) return SCM(playerid,0, "Редактировать VIP-объявления можно с 8 уровня админки.");
	return ShowVipAdvertList(playerid);
}

stock ShowVipAdvertList(playerid)
{
	stringer[0] = EOS;
    new data[3][30],index;
    format(data[0],30,"[{33AA33}Проверено{FFFFFF}]");
    format(data[1],30,"[{66CC33}Проверяется{FFFFFF}]");
    for(new i = 0; i < MAX_VIP_ADVERT_COUNT; i++)
    {
        if(!gVipAdvert[i][vadBusy]) format(stringer,sizeof(stringer),"%s%d. -\n",stringer,i+1);
        else
        {
            if(gVipAdvert[i][vadCheking]) index = 1;
            else if(gVipAdvert[i][vadCheked]) index = 0;
            else index = 2;
            format(stringer,sizeof(stringer),"%s%d. %s %s\n",stringer,i+1,gVipAdvert[i][vadSender],data[index]);
        }
    }
    return SPD(playerid, 11550, DIALOG_STYLE_LIST, ""SERVER"VIP-объявления",stringer, "Далее", "Закрыть");
}

cmd:viphelp(playerid)
{
    stringer[0] = 0;
    strcat(stringer,"{66CC33}1. Bronze VIP{FFFFFF} - Выдается навсегда:\n\n{32CD32}Команды:\n{FFFFFF}- /togphone\n\n");
    strcat(stringer,"{32CD32}Привилегии:\n{FFFFFF}- Максимальная блокировка аккаунта на 5 дней;\n- Возможно подавать объявления в /vipad три раза в час.\n\n");
    strcat(stringer,"{66CC33}Silver VIP{FFFFFF} - Выдается на 10 дней:\n\n{32CD32}Команды:\n{FFFFFF}- /togphone\n- /admins\n\n");
    strcat(stringer,"{32CD32}Привилегии:\n{FFFFFF}- Максимальная блокировка аккаунта на 4 дня;\n- Возможно подавать объявления в /vipad семь раза в час.\n\n");
    strcat(stringer,"{66CC33}Gold VIP{FFFFFF} - Выдается на 7 дней:\n\n{32CD32}Команды:\n{FFFFFF}- /togphone\n- /admins\n- /leave\n\n");
    strcat(stringer,"{32CD32}Привилегии:\n{FFFFFF}- Максимальная блокировка аккаунта на 2 дня;\n- Безлимитная подача обьявлений;\n");
    strcat(stringer,"- Полная сытость при спавне;\n- Двойной EXP при зарплате.");
    SPD(playerid, 0, 0, ""SERVER"Помощь по управлению VIP статусом", stringer, "Закрыть", "");
    return 1;
}
cmd:skin(playerid, params[])
{
    if(PI[playerid][pAdmin] < 1)
    {
         if(!YouTube(playerid))
		        return 1;
    }
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /skin [id скина]");
    if(params[0] > 289 || params[0] < 1) { SCM(playerid,0, "Неправильный ID скина!"); return 1; }
    //PI[playerid][pChar] = params[0];
    SetPlayerSkinEx(playerid, params[0], false);
    return 1;
}

cmd:buyadm(playerid)
{
    new fstring[129],big_fmt[620];
    if(PI[playerid][pAdmin] >= 12) return SCM(playerid,0, "У вас максимальный уровень админ-прав.");
    for(new i = PI[playerid][pAdmin]; i < 11; i++)
    {
        format(fstring, sizeof(fstring), "{ffffff}%i уровень\t{8BD032}%i донат-рублей{FFFFFF}\n", i + 1, ((i + 1) - PI[playerid][pAdmin]) * adminprice);
        strcat(big_fmt, fstring);

    }
    /*for(new i = PI[playerid][pAdmin]; i =< 12; i++)
    {
        if(!i) format(fstring, sizeof(fstring), "{ffffff}%i уровень\t{8BD032}%i донат-рублей{FFFFFF}", i + 1, ((i + 1) - PI[playerid][pAdmin]) * adminprice);
        else format(fstring, sizeof(fstring), "%s\n%i уровень\t{8BD032}%i донат-рублей", fstring, i + 1, ((i + 1) - PI[playerid][pAdmin]) * adminprice);
    }
    */
    strcat(big_fmt, "{FF4500}12 уровень\t{8BD032} 2500 донат-рублей");
    //format(fstring, sizeof(fstring), "%s\n{FF4500}12 уровень\t{8BD032} 2500 донат-рублей", fstring);
    SPD(playerid, 9641, DIALOG_STYLE_LIST, ""SERVER"Покупка админки", big_fmt, "Выбор", "Отмена");
    return 1;
}


cmd:setskin(playerid, params[])
{
    if(PI[playerid][pAdmin] < 11) return 1;
    if(sscanf(params, "dd", params[0],params[1])) return SCM(playerid, 1, "Введите: /setskin [id игрока/ник] [id скина]");
    if(params[1] > 289 || params[1] < 1) { SCM(playerid,0, "Неправильный ID скина!"); return 1; }

	if(params[1] == 271) return SCM(playerid, 0, "Нельзя использовать этот скин!");

    if(!IsPlayerConnected(params[0])) return 1;
    PI[params[0]][pChar] = params[1];
    format(stringer1, sizeof(stringer1), "Ваш скин был изменен администратором %s", PI[playerid][pNames]);
    SendClientMessage(params[0], 0x6495EDFF, stringer1);
    format(stringer1, sizeof(stringer1), "Вы изменили скин %s на номер: %i",PI[params[0]][pNames],params[1]);
    SendClientMessage(playerid, 0x6495EDFF, stringer1);
    SetPlayerSkinEx(params[0], PI[params[0]][pChar], true);
    return 1;
}
cmd:pay(playerid, params[])
{
    if(PI[playerid][pPayDayHad] < 2) return SCM(playerid,0, "{66CC33}Необходимо отыграть {00cc00}2 {66CC33}часа на сервере");
    if(sscanf(params, "dd", params[0],params[1])) return    SCM(playerid, 1, "Введите: /pay [id] [сумма]");
    if(params[1] < 1 || params[1] > 100000) return SendClientMessage(playerid, COLOR_GRAD1, "Нельзя передать меньше 1 рубля и больше 99999 руб..");
    if(PI[playerid][pPayDayHad] < 4) return SCM(playerid,0, "Вы должны пробыть в игре ещё 3 часа (/mm - Статистика персонажа).");
    if(!IsPlayerConnected(params[0])) return 1;
    if(!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GRAD1, "Вы слишком далеко.");
    if(PI[playerid][pCash] < params[1]) return 1;
    GiveMoney(params[0], params[1]);
    PI[playerid][pCash] -= params[1];
    format(stringer1, sizeof(stringer1), "Вы передали %s[%i], %s руб..",PI[params[0]][pNames],params[0],formatInt(params[1]));
    PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
    SendClientMessage(playerid, COLOR_GRAD1, stringer1);
    format(stringer1, sizeof(stringer1), "Вы получили %s руб. от %s[%i].",formatInt(params[1]),PI[playerid][pNames], playerid);
    SendClientMessage(params[0], COLOR_GRAD1, stringer1);
    PlayerPlaySound(params[0], 1052, 0.0, 0.0, 0.0);
    format(stringer1,sizeof(stringer1), "достал бумажник и передал деньги %s",PI[params[0]][pNames]);
    SetPlayerChatBubble(playerid,stringer1,COLOR_PURPLE,30.0,10000);
    return 1;
}
cmd:mxpell(playerid, params[])
{
    if(PI[playerid][pMember] != 7 && PI[playerid][pMember] != 16) return SendClientMessage(playerid,COLOR_WHITE,"Вы не сотрудник мэрии / новостей!");
    if(sscanf(params, "ds[128]",params[0],params[1])) return SCM(playerid, 1, "Введите: /mxpell [id] [причина]");
    if(!ProxDetectorS(15.0, playerid, params[0])) return SCM(playerid,0, "Игрок слишком далеко!");
    if(IsACop(params[0]) || IsAArm(params[0]) || PI[params[0]][pMember] == 4 || PI[params[0]][pMember] == 7) return SendClientMessage(playerid, COLOR_RED, "Вы не можете выгнать Госсударственного работника!");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
    if(PI[playerid][pMember] == 7)
    {
        if(!IsPlayerInRangeOfPoint(playerid, 60.0,1482.1993,-1799.5953,2995.6289)) return SCM(playerid,0, "Необходимо находится в мэрии!");
        SetPlayerInteriorEx(params[0],0);
        SetPPos(params[0],1480.8832,-1769.0471,18.7958);
        SetPlayerFacingAngle(params[0], 0.3133);
        DisablePlayerCheckpoint(params[0]);
        CP[params[0]] = 0;
        SetPVarInt(params[0],"MerEnter",gettime()+300);
        format(stringer1,100,"Сотрудник: %s выставил вас за дверь мэрии. Причина: %s",PI[playerid][pNames],params[1]);
        SendClientMessage(params[0],COLOR_WHITE,stringer1);
        format(stringer1,100,"Вы выставили %s за дверь.",PI[params[0]][pNames]);
        SendClientMessage(playerid,COLOR_WHITE,stringer1);
    }
    else
    {
        if(!IsPlayerInRangeOfPoint(playerid, 60.0,1745.7302,-1915.4186,1961.1769)) return SCM(playerid,0, "Необходимо находится в студии!");
        SetPlayerInteriorEx(params[0],0);
        SetPPos(params[0],1658.2383,-1693.4553,15.6094);
        SetPlayerFacingAngle(params[0], 175.8234);
        SetPlayerVirtualWorldEx(params[0], 0);
        DisablePlayerCheckpoint(params[0]);
        CP[params[0]] = 0;
        SetPVarInt(params[0],"NewsEnter",gettime()+300);
        format(stringer1,100,"Сотрудник: %s выставил вас за дверь студии. Причина: %s",PI[playerid][pNames],params[1]);
        SendClientMessage(params[0],COLOR_WHITE,stringer1);
        format(stringer1,100,"Вы выставили %s за дверь.",PI[params[0]][pNames]);
        SendClientMessage(playerid,COLOR_WHITE,stringer1);
    }
    return 1;
}
cmd:axpell(playerid, params[])
{
    if(PI[playerid][pMember] != 11) return SendClientMessage(playerid,COLOR_WHITE,"Вы не сотрудник автошколы!");
    if(sscanf(params, "ds[128]",params[0],params[1])) return SCM(playerid, 1, "Введите: /axpell [id] [причина]");
    if(!ProxDetectorS(15.0, playerid, params[0])) return SCM(playerid,0, "Игрок слишком далеко!");
    if(IsACop(params[0]) || IsAArm(params[0]) || PI[params[0]][pMember] == 4 || PI[params[0]][pMember] == 7) return SendClientMessage(playerid, COLOR_RED, "Вы не можете выгнать Госсударственного работника!");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
    if(IsPlayerInRangeOfPoint(playerid, 30.0,-790.2884,1546.5732,1139.2369))
    {
        SetPlayerInteriorEx(params[0],0);
        SetPlayerVirtualWorldEx(params[0], 0);
        SetPPos(params[0],-2026.9436,-99.6266,35.1641);
        SetPlayerFacingAngle(params[0], 355.8038);
        SetPVarInt(params[0],"AvtoEnter",gettime()+300);
        format(stringer1,100,"Сотрудник: %s выставил вас за дверь автошколы. Причина: %s",PI[playerid][pNames],params[1]);
        SendClientMessage(params[0],COLOR_WHITE,stringer1);
        format(stringer1,100,"Вы выставили %s за дверь.",PI[params[0]][pNames]);
        SendClientMessage(playerid,COLOR_WHITE,stringer1);
    }
    return 1;
}
cmd:mdpell(playerid, params[])
{
    if(PI[playerid][pMember] != 4) return SendClientMessage(playerid,COLOR_WHITE,"Вы не врач!");
    if(sscanf(params, "ds[128]",params[0],params[1])) return SCM(playerid, 1, "Введите: /mdpell [id] [причина]");
    if(!ProxDetectorS(15.0, playerid, params[0])) return SCM(playerid,0, "Игрок слишком далеко!");
    if(IsACop(params[0]) || IsAArm(params[0]) || PI[params[0]][pMember] == 4 || PI[params[0]][pMember] == 7) return SendClientMessage(playerid, COLOR_RED, "Вы не можете выгнать Госсударственного работника!");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
    if(!IsPlayerInRangeOfPoint(playerid, 50.0,347.8218,400.8753,1022.8019)) return SCM(playerid,0, "Вы находитесь не на территории больницы.");
    PI[params[0]][pHospital] = 0;
    UpdatePlayerData(params[0], "pHospital", PI[params[0]][pHospital]);
    SetPPos(params[0],1177.1721,-1323.3220,14.0576);
    SetPlayerInteriorEx(params[0],0);
    SetPlayerFacingAngle(params[0], 270);
    SetPlayerVirtualWorldEx(params[0], 0);
    SetPVarInt(params[0],"MdEnter",gettime()+300);
    format(stringer1,100,"Сотрудник: %s выставил вас за дверь больницы. Причина: %s",PI[playerid][pNames],params[1]);
    SendClientMessage(params[0],COLOR_WHITE,stringer1);
    format(stringer1,100,"Вы выставили %s за дверь.",PI[params[0]][pNames]);
    SendClientMessage(playerid,COLOR_WHITE,stringer1);
    return 1;
}
cmd:money(playerid, params[])
{
    if(FD[playerid])
    {
        if(sscanf(params, "dd",params[0],params[1])) return SCM(playerid, 1, "Введите: /money [ид] [сумма]");
        if(!IsPlayerConnected(params[0])) return 1;
        format(stringer1, sizeof(stringer1), "%s руб. переведены на счёт игроку %s",formatInt(params[1]),PI[params[0]][pNames]);
        SCM(playerid,0, stringer1);
        GiveBank(params[0], params[1]);
        format(stringer1, sizeof(stringer1), "Пополнение счёта на сумму: %s руб.", formatInt(params[1]));
        SendClientMessage(params[0], COLOR_WHITE, stringer1);
        format(stringer1, sizeof(stringer1), "Новый баланс в банке: %s руб.", formatInt(PI[params[0]][pBank]));
        SendClientMessage(params[0], COLOR_WHITE, stringer1);
        return 1;
    }
    SendClientMessage(playerid, -1, "Команда изъята из доступа");
    return 1;
}

cmd:avig(playerid, params[])
{
    if(!PI[playerid][pAdmin]) return 1;
    if(!is_cmd_allow(playerid, CMD_avig)) return SendClientMessage(playerid, COLOR_GRAD1,"{66CC33}У Вас нет доступа к данной команде. Для покупки используйте — {FF4500}/adonate");
    new nicks[24];
    if(sscanf(params, "s[24]s[100]",nicks, params[1])) return SCM(playerid,0, "Используйте: /avig [ник] [причина]");

    AdminFastUse(playerid, 7);
    if(!strcmp(nicks, "Mett_Clementine") || !strcmp(nicks, "Kirill_Ivanov")) return DelAdmin(playerid, "Подозрительные действия");

    AdminCheckReason(playerid, params[1]);

    new ids = GetPlayerID(nicks);
    if(IsPlayerConnected(ids))
    {
        if(!PI[ids][pLeader] && !PI[ids][pAdmin]) return SCM(playerid,0, "Игрок не является администратором / лидером");
        if(FD[ids]) return DelAdmin(playerid, "Подозрительные действия");
        if(playerid == ids) return SCM(playerid,0, "Невозможно выдать выговор самому себе.");
        PI[ids][pVigs] ++;
        if(PI[ids][pVigs] >= 3)
        {
            if(PI[ids][pLeader] && !PI[ids][pAdmin])
            {
                format(stringer1, sizeof(stringer1), "Администратор %s снял лидера фракции %s: %s (3/3). Причина: %s", PI[playerid][pNames], GetPlayerFracName[PI[ids][pMember]], PI[ids][pNames], params[1]);
                SendClientMessageToAll(COLOR_LIGHTRED, stringer1);
                format(stringer1, sizeof(stringer1), "снял лидеры фракции %s по причине (3/3): %s", GetPlayerFracName[PI[ids][pMember]], params[1]);
                Admin_Log(playerid, stringer1, nicks, gettime());
                SetPlayerSkinEx(ids, PI[ids][pChar], true);
                SetPlayerArmour(ids,0);
                SetPlayerHealth(ids,100);
                ResetWeapons(ids);
                PI[ids][pLeader] = 0;
                PI[ids][pMember] = 0;
                PI[ids][pRank] = 0;
                PI[ids][pVigs] = 0;
                PI[ids][pOdet] = 0;
                SetPlayerToTeamColor(ids);
                format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `pMember` = '0', `pLeader` = '0', `pRank` = '0', `odet` = '0' , `vigs` = '0' WHERE `pID` = '%d'",PI[ids][pID]);
                mysql_tquery(connects, mysql_query_, "", "");
            }
            else if(PI[ids][pAdmin])
            {
                format(stringer1, sizeof(stringer1), "Главный администратор %s снял с %s права администратора (3/3). Причина: %s", PI[playerid][pNames], PI[ids][pNames], params[1]);
                SendAdminMessage(COLOR_LIGHTRED, stringer1);
                format(stringer1, sizeof(stringer1), "снял права администратора (3/3), по причине: %s", params[1]);
                Admin_Log(playerid, stringer1, nicks, gettime());
                DelAdmin(ids, "снят администратором");
            }
        }
        else
        {
            if(PI[ids][pLeader] && !PI[ids][pAdmin])
            {
                format(stringer1, sizeof(stringer1), "Администратор %s выдал выговор лидеру фракции %s: %s (%d/3). Причина: %s", PI[playerid][pNames], GetPlayerFracName[PI[ids][pMember]], PI[ids][pNames],PI[ids][pVigs], params[1]);
                SendClientMessageToAll(COLOR_LIGHTRED, stringer1);
                format(stringer1, sizeof(stringer1), "выдал выговор лидеру фракции %s (%d/3) по причине: %s", GetPlayerFracName[PI[ids][pMember]],PI[ids][pVigs], params[1]);
                Admin_Log(playerid, stringer1, nicks, gettime());
                format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `vigs` = '%d' WHERE `pID` = '%d'",PI[ids][pVigs], PI[ids][pID]);
                mysql_tquery(connects, mysql_query_, "", "");
            }
            else if(PI[ids][pAdmin])
            {
                format(stringer1, sizeof(stringer1), "Главный администратор %s выдал администратору %s выговор (%d/3). Причина: %s", PI[playerid][pNames], PI[ids][pNames],PI[ids][pVigs], params[1]);
                SendAdminMessage(COLOR_LIGHTRED, stringer1);
                format(stringer1, sizeof(stringer1), "выдал выговор (%d/3), по причине: %s", PI[ids][pVigs], params[1]);
                Admin_Log(playerid, stringer1, nicks, gettime());
                format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `vigs` = '%d' WHERE `pID` = '%d'",PI[ids][pVigs],PI[ids][pID]);
                mysql_tquery(connects, mysql_query_, "", "");
            }
        }
        return 1;
    }
    format(mysql_query_,sizeof(mysql_query_), "SELECT `pAdmin`, `pLeader`, `vigs` FROM `"TABLE_ACCOUNT"` WHERE Name = '%s'", nicks);
    mysql_tquery(connects, mysql_query_, "SetVig_Date", "dssd", playerid,nicks,params[1],2);
    return 1;
}
cmd:aunvig(playerid, params[])
{
    if(!is_cmd_allow(playerid, CMD_aunvig)) return SendClientMessage(playerid, COLOR_GRAD1,"{66CC33}У Вас нет доступа к данной команде. Для покупки используйте — {FF4500}/adonate");
    new nicks[24];
    if(sscanf(params, "s[24]s[100]",nicks, params[1])) return SCM(playerid,0, "Используйте: /aunvig [ник] [причина]");

    AdminFastUse(playerid, 2);

    new ids = GetPlayerID(nicks);
    if(IsPlayerConnected(ids))
    {
        if(!PI[ids][pLeader] && !PI[ids][pAdmin]) return SCM(playerid,0, "Игрок не является администратором / лидером");
        if(playerid == ids && !FD[playerid]) return SCM(playerid,0, "Невозможно снять выговор самому себе.");
        if(PI[ids][pVigs] <= 0) return SCM(playerid,0, "Выговоры отсутствуют.");
        PI[ids][pVigs] --;
        if(PI[ids][pLeader] && !PI[ids][pAdmin])
        {
            format(stringer1, sizeof(stringer1), "Администратор %s снял выговор лидеру фракции %s: %s (%d/3). Причина: %s", PI[playerid][pNames], GetPlayerFracName[PI[ids][pMember]], PI[ids][pNames],PI[ids][pVigs], params[1]);
            SendClientMessageToAll(COLOR_LIGHTRED, stringer1);
            format(stringer1, sizeof(stringer1), "снял выговор лидеру фракции (%s) (%d/3) по причине: %s", GetPlayerFracName[PI[ids][pMember]],PI[ids][pVigs], params[1]);
            Admin_Log(playerid, stringer1, nicks, gettime());
            format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `vigs` = '%d' WHERE `pID` = '%d'",PI[ids][pVigs], PI[ids][pID]);
            mysql_tquery(connects, mysql_query_, "", "");
        }
        else if(PI[ids][pAdmin])
        {
            format(stringer1, sizeof(stringer1), "Главный администратор %s снял администратору %s выговор (%d/3). Причина: %s", PI[playerid][pNames], PI[ids][pNames],PI[ids][pVigs], params[1]);
            SendAdminMessage(COLOR_LIGHTRED, stringer1);
            format(stringer1, sizeof(stringer1), "снял выговор (%d/3), по причине: %s", PI[ids][pVigs], params[1]);
            Admin_Log(playerid, stringer1, nicks, gettime());
            format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `vigs` = '%d' WHERE `pID` = '%d'",PI[ids][pVigs],PI[ids][pID]);
            mysql_tquery(connects, mysql_query_, "", "");
        }
        return 1;
    }
    format(mysql_query_,sizeof(mysql_query_), "SELECT `pAdmin`, `pLeader`, `vigs` FROM `"TABLE_ACCOUNT"` WHERE Name = '%s'", nicks);
    mysql_tquery(connects, mysql_query_, "SetVig_Date", "dssd", playerid,nicks,params[1],1);
    return 1;
}
cmd:fvig(playerid, params[])
{
    if(!PI[playerid][pMember]) return 1;
    if(PI[playerid][pRank] < gFractionRank[PI[playerid][pMember]-1][3]) return SendMes(playerid, -1, "Доступно с %i ранга", gFractionRank[PI[playerid][pMember]-1][3]);
    if(sscanf(params, "ds[100]",params[0],params[1])) return SCM(playerid, 1, "Введите: /fvig [id] [причина]");
    if(!IsPlayerConnected(params[0])) return 1;
    if(PI[params[0]][pMember] != PI[playerid][pMember] || PI[params[0]][pAdmin] || PI[params[0]][pRank] >= gFractionRank[PI[playerid][pMember]-1][3]) return SCM(playerid,0,"Игрок не в вашей фракции / администратор / лидер / зам");
    PI[params[0]][pVigs] ++;
    if(PI[params[0]][pVigs] >= 3)
    {
        format(stringer1, sizeof(stringer1), "[F] %s уволил игрока %s (3/3). Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
        SendFamilyMessage(PI[playerid][pMember],COLOR_LIGHTRED, stringer1);
        SetPlayerSkinEx(params[0], PI[params[0]][pChar], true);
        SetPlayerArmour(params[0],0);
        SetPlayerHealth(params[0],100);
        ResetWeapons(params[0]);
        PI[params[0]][pMember] = 0;
        PI[params[0]][pRank] = 0;
        PI[params[0]][pVigs] = 0;
        PI[params[0]][pOdet] = 0;
        SetPlayerToTeamColor(params[0]);
        format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `pMember` = '0', `pRank` = '0', `odet` = '0' , `vigs` = '0' WHERE `pID` = '%d'",PI[params[0]][pID]);
        mysql_tquery(connects, mysql_query_, "", "");
    }
    format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `vigs` = '%d' WHERE `pID` = '%d'",PI[params[0]][pVigs],PI[params[0]][pID]);
    mysql_tquery(connects, mysql_query_, "", "");
    format(stringer1, sizeof(stringer1), "[F] %s выдал выговор игроку %s (%d/3). Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], PI[params[0]][pVigs], params[1]);
    SendFamilyMessage(PI[playerid][pMember],COLOR_LIGHTRED, stringer1);
    return 1;
}
cmd:funvig(playerid, params[])
{
    if(!PI[playerid][pMember]) return 1;
    if(PI[playerid][pRank] < gFractionRank[PI[playerid][pMember]-1][3]) return SendMes(playerid, -1, "Доступно с %i ранга", gFractionRank[PI[playerid][pMember]-1][3]);
    if(sscanf(params, "ds[100]",params[0],params[1])) return SCM(playerid, 1, "Введите: /funvig [id] [причина]");
    if(!IsPlayerConnected(params[0])) return 1;
    if(PI[params[0]][pMember] != PI[playerid][pMember] || PI[params[0]][pAdmin] || PI[params[0]][pRank] >= gFractionRank[PI[playerid][pMember]-1][3]) return SCM(playerid,0,"Игрок не в вашей фракции / администратор / лидер / зам");
    if(PI[params[0]][pVigs] <= 0) return 1;
    PI[params[0]][pVigs] --;
    format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `vigs` = '%d' WHERE `pID` = '%d'",PI[params[0]][pVigs],PI[params[0]][pID]);
    mysql_tquery(connects, mysql_query_, "", "");
    format(stringer1, sizeof(stringer1), "[F] %s снял выговор игроку %s (%d/3). Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], PI[params[0]][pVigs], params[1]);
    SendFamilyMessage(PI[playerid][pMember],COLOR_LIGHTRED, stringer1);
    return 1;
}
alias:jail("prison");
cmd:jail(playerid, params[])
{
    if(PI[playerid][pAdmin] < 4) return 1;
    if(PI[playerid][pVigs] > 2) return SendClientMessage(playerid, -1, "{FF6600}На вашем аккаунте выговор, некоторые команды были заблокированы. Снимите выговор — {FFFFFF}/adonate, {FF6600}чтобы снять блокировку команд.");
    if(sscanf(params, "dds[128]",params[0],params[1],params[2])) return SCM(playerid, 1, "Введите: /jail [id] [минуты] [причина]");
    AdminFastUse(playerid, 5);
    AdminCheckReason(playerid, params[2]);
    if(!IsPlayerConnected(params[0])) return 1;
    if(params[1] > 70 || params[1] <= 0) return SendClientMessage(playerid,COLOR_WHITE,"Нельзя меньше 1 и больше 70");
   // if((FD[params[0]] && !FD[playerid]) || IsIpFound(params[2])) return 1;
    //RemoveBadWords(params[2]);
    ResetWeapons(params[0]);
    SetPlayerInteriorEx(params[0], 0);
    switch(random(2)) {
    case 0: SetPPos(params[0],524.0659,333.5089,1201.8594), SetPlayerFacingAngle(params[0], 120.3213);
    case 1: SetPPos(params[0],523.9069,339.0927,1201.8594), SetPlayerFacingAngle(params[0], 102.7743);
    }
    TogglePlayerControllable(params[0], false);
    SetTimerEx("UnFreez", 2900, 0, "d", params[0]);
    PI[params[0]][pJailed] = 4;
    PI[params[0]][pMestoJail] = 0;
    PI[params[0]][pJailTime] = gettime() + params[1]*60;
    PI[playerid][pJailAdm]++;
    if(!strcmp(params[2], "Нарушение правил сервера", true)) {
	    format(stringer1, sizeof(stringer1), "Администратор %s посадил вас в деморган на %i минут(ы).",PI[playerid][pNames],params[1]);
	    SendClientMessage(params[0], COLOR_LIGHTRED, stringer1);

     	format(stringer1, sizeof(stringer1), "%s посадил игрока %s в деморган на %i минут(ы).", PI[playerid][pNames],PI[params[0]][pNames], params[1]);
	    SendAdminMessage(COLOR_GREY,stringer1);
	}
	else {
		format(stringer1, sizeof(stringer1), "Администратор %s посадил вас в деморган на %i минут(ы). Причина: %s",PI[playerid][pNames],params[1], params[2]);
		SendClientMessage(params[0], COLOR_LIGHTRED, stringer1);

		format(stringer1, sizeof(stringer1), "%s посадил игрока %s в деморган на %i минут(ы). Причина: %s", PI[playerid][pNames],PI[params[0]][pNames], params[1], params[2]);
	    SendAdminMessage(COLOR_GREY,stringer1);
	}

    Admin_Log(playerid, stringer1, PI[params[0]][pNames], gettime());
    return 1;
}

cmd:offjail(playerid, params[])
{
    if(PI[playerid][pAdmin] < 8) return 1;
    if(GetPVarInt(playerid,"MuteTime") > gettime())return SCM(playerid,0,"Посадить/Заткнуть игрока можно раз в 10 секунд");

	AdminFastUse(playerid, 5);
    new NameA[24], time,description[128];
    if(sscanf(params,"s[24]ds[128]",NameA,time,description)) return SCM(playerid, 1, "Введите: /offjail [Имя] [minute] [причина]");

    if(time > 60 || time < 0) return SendClientMessage(playerid,COLOR_WHITE,"Нельзя меньше 0 и больше 60");

    //if((FD[params[0]] && !FD[playerid]) || IsIpFound(params[2])) return 1;
    //RemoveBadWords(params[2]);

    new query[144];
    format(query, sizeof(query), "SELECT * FROM `accounts` WHERE `Name` = '%s' AND `pAdmin` = 0 LIMIT 1", NameA);
    mysql_tquery(connects, query);
    if(cache_num_rows())
    {
        new mystring[250];
        mysql_format(connects, mystring, sizeof mystring, "UPDATE accounts SET pJailTime = %d, pJailed = 4, pMestoJail = 2 WHERE name = '%s'", time*60, NameA);
        mysql_tquery(connects, mystring);

        PI[playerid][pMuteAdm]++;
        format(stringer1, sizeof(stringer1), "[A-OFF] %s посадил игрока %s в деморган на %i минут(ы). Причина: %s",PI[playerid][pNames],NameA, time, description);
        SendAdminMessageToAll(COLOR_LIGHTRED ,stringer1,params[0]);
        Admin_Log(playerid, stringer1, NameA, gettime());
        SetPVarInt(playerid,"MuteTime",gettime()+10);
    }
    else
    SendClientMessage(playerid, -1, "Ник нейм не найден в базе данных или игрок администратор!");
    return 1;
}

alias:unjail("unprison");
cmd:unjail(playerid, params[]) {
    if(PI[playerid][pAdmin] < 4) return 1;
    if(PI[playerid][pVigs] > 2) return SendClientMessage(playerid, -1, "{FF6600}На вашем аккаунте выговор, некоторые команды были заблокированы. Снимите выговор — {FFFFFF}/adonate, {FF6600}чтобы снять блокировку команд.");
    if(sscanf(params, "d",params[0])) return SCM(playerid, 1, "Введите: /unjail [id]");
    if(!IsPlayerConnected(params[0])) return 1;
    AdminFastUse(playerid, 3);
    format(stringer1, sizeof(stringer1), "Вы были освобождены администратором %s",PI[playerid][pNames]);
    SendClientMessage(params[0], COLOR_LIGHTRED, stringer1);
    format(stringer1, sizeof(stringer1), "%s освободил игрока %s из деморгана", PI[playerid][pNames],PI[params[0]][pNames], params[1]);
    SendAdminMessage(COLOR_GREY,stringer1);
    if(PI[params[0]][pJailed] != 4) PI[params[0]][pUsedJail] = 0;
    PI[params[0]][pJailed] = 0;
    PI[params[0]][pJailTime] = 0;
    SpawnPlayerEx(params[0]);
    return 1;
}
cmd:rang(playerid, params[])
{
    if(!PI[playerid][pMember]) return 1;
    if(PI[playerid][pRank] < gFractionRank[PI[playerid][pMember]-1][2]) return SendMes(playerid, -1, "Доступно с %i ранга", gFractionRank[PI[playerid][pMember]-1][2]);
    if(sscanf(params, "dd",params[0],params[1])) return SCM(playerid, 1, "Введите: /rang [id] [ранг]");
    switch(PI[playerid][pMember])
    {
		case 1,10,3,19,21: if(params[1] > 14 || params[1] < 1) return SCM(playerid,0, "Нельзя меньше 1 и больше 14!");
		case 2,26,4,5,6,11,12,13,14,15,17,18,22,24,25,7: if(params[1] > 9 || params[1] < 1) return SCM(playerid,0, "Нельзя меньше 1 и больше 9!");
		case 27,28: if(params[1] > 4 || params[1] < 1) return SCM(playerid,0, "Нельзя меньше 1 и больше 4!");
		case 16: if(params[1] > 12 || params[1] < 1) return SCM(playerid,0, "Нельзя меньше 1 и больше 12!");
		case 23: if(params[1] > 11 || params[1] < 1) return SCM(playerid,0, "Нельзя меньше 1 и больше 11!");
    }
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;

	if(PI[playerid][pRank] <= PI[params[0]][pRank])
		return SendClientMessage(playerid, COLOR_WHITE, "Вы не можете изменить ранг этого игрока!");
	
    switch(PI[playerid][pMember])
    {
    case 1..4, 7, 10, 11, 19, 21, 25:
        {
            if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
            if(PI[params[0]][pRank] <= 5 && params[1] > 5)
            {
            //    if(PI[params[0]][pMedCard] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Для получения данного ранга, у игрока должна быть медицинская карта.");
                if((PI[params[0]][pMember] == 1 || PI[params[0]][pMember] == 2 || PI[params[0]][pMember] == 10 || PI[params[0]][pMember] == 21 || PI[params[0]][pMember] == 25) && PI[params[0]][pVoenBill] == 0)
                {
                    return SendClientMessage(playerid,COLOR_WHITE,"Для получения данного ранга, у игрока должен быть военный билет.");
                }
            }
        }
    }
    if((PI[params[0]][pMember] == 3 || PI[params[0]][pMember] == 19) && params[1] >= 3 && PI[params[0]][pVoenBill] == 0)
    {
        PI[params[0]][pVoenBill] = 1;
        SendClientMessage(params[0], COLOR_GRAD1, "Поздравляем! Вы получили военный билет!");
        format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `voenbill` = '1' WHERE `pID` = '%d'",PI[params[0]][pID]);
        mysql_tquery(connects, mysql_query_, "", "");
    }
    if (PI[params[0]][pLeader] >= 1) return SCM(playerid,0, "Вы указали ID лидера");
    if(PI[playerid][pMember] != PI[params[0]][pMember]) return SCM(playerid,0, "Данный игрок не в вашей фракции!");
    if(PI[playerid][pMember] > 0 && PI[playerid][pRank] <= params[1]) return SCM(playerid,0,"Ошибка");
    if(PI[playerid][pLeader] <= 0 && PI[playerid][pRank] <=  PI[params[0]][pRank]) return SCM(playerid,0, "Ошибка");
    format(stringer1, sizeof(stringer1), "Вас повысил/понизил до %d ранга %s",params[1], PI[playerid][pNames]);
    SendClientMessage(params[0], 0x6BB3FFAA, stringer1);
    format(stringer1, sizeof(stringer1), "Вы повысили %s до %d ранга.", PI[params[0]][pNames],params[1]);
    SendClientMessage(playerid, 0x6BB3FFAA, stringer1);
    PI[params[0]][pRank] = params[1];
    return 1;
}

cmd:uninvite(playerid, params[])
{

    if(!PI[playerid][pMember]) return 1;
    switch(PI[playerid][pMember]) { case 1..4, 7, 10, 11, 19, 21, 25: if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!"); }
    if(PI[playerid][pRank] < gFractionRank[PI[playerid][pMember]-1][1]) return SendMes(playerid, -1, "Доступно с %i ранга", gFractionRank[PI[playerid][pMember]-1][1]);
    if(sscanf(params, "ds[128]",params[0],params[1])) return SendClientMessage(playerid, COLOR_GRAD2, "Используйте: /uninvite [id] [причина]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
    if(PI[playerid][pRank] == PI[params[0]][pRank]) return SCM(playerid,0, "Вы не можете уволить этого игрока");
    if(PI[playerid][pLeader] <= 0 && PI[playerid][pRank] <= PI[params[0]][pRank]) return SCM(playerid,0, "Вы не можете уволить этого игрока");
    if(PI[params[0]][pMember] == PI[playerid][pLeader] || PI[params[0]][pMember] == PI[playerid][pMember])
    {
        if(PI[params[0]][pMember] <= 0 || PI[params[0]][pLeader] >= 1) return 1;
        if(IsPlayerStartCroupier(params[0]))
        {
            if(CroupierTable[params[0]] != -1)
            {
                switch(CroupierGame[params[0]])
                {
                case 1: OnPlayerExitDiceTable(params[0], CroupierTable[params[0]]);
                case 2: OnPlayerExitRouleTable(params[0], CroupierTable[params[0]]);
                case 3: OnPlayerExitBlackJackTable(params[0], CroupierTable[params[0]]);
                }
            }
            StartDuty[params[0]] = 0;
        }
        format(stringer1, sizeof(stringer1), "%s выгнал вас из организации. Причина: %s",PI[playerid][pNames],params[1]);
        SendClientMessage(params[0], 0x6495EDFF, stringer1);
        SetPlayerSkinEx(params[0], PI[params[0]][pChar]);
        format(stringer1, sizeof(stringer1), "Вы выгнали %s из организации с причиной: %s",PI[params[0]][pNames],params[1]);
        SendClientMessage(playerid, 0x6495EDFF, stringer1);
        SendClientMessage(params[0], COLOR_WHITE, "Теперь вы обычный гражданин...");
        SetPlayerArmour(params[0],0);
        ResetWeapons(params[0]);
        PI[params[0]][pMember] = 0;
        PI[params[0]][pLeader] = 0;
        PI[params[0]][pRank] = 0;
        SetPlayerColor(params[0], 0xFFFFFF80);
        SetPlayerSkinEx(params[0], PI[params[0]][pChar]);
        format(stringer1, sizeof(stringer1), "Игрок %s[%d] уволил из организации %s[%d]. Причина: %s", PI[playerid][pNames], playerid,PI[params[0]][pNames], params[0], params[1]);
        SendAdminMessage(COLOR_GREY,stringer1);
        PI[params[0]][pOdet] = 0;
        format(stringer, sizeof(stringer), "UPDATE `"TABLE_ACCOUNT"` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `odet` = '0' WHERE `pID` = '%d'",PI[params[0]][pID]);
        mysql_tquery(connects, stringer, "", "");
    }
    return 1;
}
cmd:mp(playerid, params[])
{
    if(PI[playerid][pAdmin] < 9) return SCM(playerid,0,"У вас нет прав!");
    SPD(playerid, 5343, DIALOG_STYLE_LIST,""SERVER"Создание МП", "1. Включить/Выключить телепорт\n2. Раздать оружие(В радиусе 50)\n3. Раздать жизни(В радиусе 50)\n4. Обезоружить всех(В радиусе 50)\n5. Выдать временный скин(В радиусе 50)", "Выбрать", "Отмена");
    return 1;
}
cmd:bugs(playerid, params[])
{
    if(GetPVarInt(playerid, "bug_time") > gettime()) return SendClientMessage(playerid, -1, "Отправлять информацию о баге можно только раз в 30 секунд.");
    ShowPlayerDialog(playerid, 22831, DIALOG_STYLE_INPUT, ""SERVER"Сообщение об ошибке игрового мода", "{FFFFFF}| Напишите в окно баг который Вы нашли. Мы обязательно исправим |","Отправить","Отмена");
    return 1;
}
cmd:sms(playerid, params[])
{
    if(PI[playerid][pPayDayHad] < 2) return SCM(playerid,0, "Вы должны пробыть в игре 2 часа (/mm - Статистика персонажа).");
    if(sscanf(params, "ds[128]",params[0],params[1])) return SCM(playerid, 1, "Введите: /sms [id] [текст]");
    if(gag[playerid] == 1) return SCM(playerid,0, "У вас стоит кляп");
    if(PI[playerid][pMuteTime] > gettime()) return SCM(playerid, 0, "У вас бан чата!");
    if(takephone[playerid] == 1) return SCM(playerid, 0, "У Вас нет телефона");
    if(strlen(params[1]) > 95) return SCM(playerid,0,"Сообщение слишком длинное!");
    if(IsAIP(params[1])) {
        SendClientMessage(playerid, -1, "Подозрения в рекламе!");
        return 0;
    }
    switch (params[0])
    {
    case 11888:
        {
            if(smsls == 0) return SCM(playerid,0, "Приём SMS отключен");
            if(PI[playerid][pBank] <= 0)
            {
                format(stringer1, sizeof(stringer1), "[Исходящее SMS]: %s | Получатель: Россия 24",params[1]);
                SendClientMessage(playerid,  COLOR_YELLOW, stringer1);
                SendClientMessage(playerid,  COLOR_GRAD1, "Сообщение не доставлено, не достаточно средств");
                format(stringer1, sizeof(stringer1), "%s достаёт мобильник", PI[playerid][pNames]);
                SetPlayerChatBubble(playerid,stringer1,COLOR_PURPLE,5.0,10000);
                return 1;
            }
            format(stringer1, sizeof(stringer1), "[Эфир] %s. Отправитель: %s[%i]",params[1],PI[playerid][pNames], playerid);
            SendFamilyMessage(16, COLOR_YELLOW, stringer1);
            format(stringer1, sizeof(stringer1), "[Исходящее SMS]: %s | Получатель: Россия 24",params[1]);
            SendClientMessage(playerid,  COLOR_YELLOW, stringer1);
            PI[playerid][pMobile] -= smspricels;
            FracBank[0][fLsnews] += smspricels;
        }
    }
    if (IsPlayerConnected(params[0]))
    {
        if(params[0] != INVALID_PLAYER_ID)
        {
            if(PhoneOnline[params[0]] > 0)
            {
                SCM(playerid,0, "Телефон абонента выключен...");
                format(stringer1, sizeof(stringer1), "%s достаёт мобильник", PI[playerid][pNames]);
                SetPlayerChatBubble(playerid,stringer1,COLOR_PURPLE,5.0,10000);
                return 1;
            }
            if(PI[params[0]][AFK_Time] > 1) return SCM(playerid,0, "Данный игрок AFK");
            PI[playerid][pBank] -=20;
            format(stringer1, sizeof(stringer1), "[Входящее SMS]: %s | Отправитель: %s[%d]",params[1],PI[playerid][pNames], playerid);
            SendClientMessage(params[0], COLOR_YELLOW, stringer1);
            SetPlayerChatBubble(params[0],"SMS <<<",COLOR_YELLOW,5.0,10000);
            foreach(Player,i)
            {
                if(BigEarSms[i] != 0)
                {
                    format(stringer1, sizeof(stringer1), "» Входящее к %s[%d]: %s. Отправитель: %s[%d].",PI[params[0]][pNames],params[0],params[1],PI[playerid][pNames],playerid);
                    SendClientMessage(i, COLOR_YELLOW, stringer1);
                }
            }
            PlayerPlaySound(params[0], 1052, 0.0, 0.0, 0.0);
            PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
            format(stringer1, sizeof(stringer1), "[Исходящее SMS]: %s | Получатель: %s[%d]",params[1], PI[params[0]][pNames], params[0]);
            SendClientMessage(playerid,  COLOR_YELLOW, stringer1);
            SetPlayerChatBubble(playerid,"SMS >>>",COLOR_YELLOW,5.0,10000);
            return 1;
        }
    }
    return 1;
}
