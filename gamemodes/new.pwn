          g_PlayerCheckpointStageInkos[playerid] = 0;
} 

CMD:setsell(playerid, params[])
{
    new price;

    if(sscanf(params, "d", price))
        return SCM(playerid, 1, "Введите: /setsell <цена>");

    if(price < 1 || price > 100000000)
        return SCM(playerid, 0, "Цена должна быть не меньше 1 и не больше 100.000.000!");

    if (!IsPlayerInAnyVehicle(playerid))
        return SCM(playerid, 0, "Сядьте в машину, чтобы поставить ее на продажу!");

    Veh[playerid] = GetPlayerVehicleID(playerid);

    SetVehicleParamsEx(GetPlayerVehicleID(playerid), VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
    zavodis[playerid] = 0;
        GameTextForPlayer(playerid, "~r~ENGINE OFF", 2000, 4);
    SellPrice[playerid] = price;
    g_PlayerOnSale[playerid] = 1;

    // Создаем 3D текст, который будет висеть рядом с машиной
    new stringer[128];
    format(stringer, sizeof(stringer), "{3399ff}Машина на продаже\n{66CC33}Цена: %d рублей", SellPrice[playerid]);
    g_3DTextLabel[playerid] = Create3DTextLabel(stringer, COLOR_YELLOW, 9999.0, 9999.0, 9999.0, 30.0, 0, 1);
    Attach3DTextLabelToVehicle(g_3DTextLabel[playerid], Veh[playerid], 0, 0, 1.5);

    // Сообщение игроку, что машина теперь на продаже
    SCM(playerid, 1, "Машина успешно поставлена на продажу!");
    return 1;
}


forward CheckAuctions();
public CheckAuctions()
{
    for(new i = 0; i < MAX_AUCTIONS; i++)
    {
        if(Auction[i][aActive] && gettime() >= Auction[i][aEndTime])
        {
            new winner = Auction[i][aCurrentBidder];
            new owner = Auction[i][aOwner];
            new itemid = Auction[i][aItemID];
            new type = Auction[i][aType];

            if(winner != INVALID_PLAYER_ID)
            {
                if(type == 1) { PI[owner][pPhousekey] = 255; PI[winner][pPhousekey] = itemid; }
                //передача биза
				// SetPlayerBizz(owner, 0); SetPlayerBizz(winner, itemid);
				else if(type == 2) { return 1; }
                //передача авто 
				else if(type == 3) { return 1; }

                new typename[16];
                switch(type)
                {
                    case 1: typename = "дом";
                    case 2: typename = "бизнес";
                    case 3: typename = "автомобиль";
                }

                new msg[128];
                format(msg, sizeof(msg), "Аукцион завершён! Победитель: %s[%d]. Ему передан %s ID %d.", PI[winner][pNames], winner, typename, itemid);
                SendClientMessageToAll(COLOR_LIGHTBLUE, msg);
            }
            else
            {
                new typename[16];
                switch(type)
                {
                    case 1: typename = "дом";
                    case 2: typename = "бизнес";
                    case 3: typename = "автомобиль";
                }

                new msg[128];
                format(msg, sizeof(msg), "Аукцион на %s ID %d завершился без победителя.", typename, itemid);
                SendClientMessageToAll(COLOR_GREY, msg);
            }

            Auction[i][aActive] = false;
        }
    }
    return 1;
}