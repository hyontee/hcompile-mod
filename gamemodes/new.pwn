    if(isnull(params)) return SCM(playerid, 1, "Введите: /getbanip [IP адрес]");
   // if(!IsIpFound(params)) return SCM(playerid,0, "Введенное вами значение не соотвествует структуре IP - адреса.");
    mysql_format(connects, mysql_query_, sizeof(mysql_query_), "SELECT * FROM `baniplog` WHERE `ip` = '%e'", params);
