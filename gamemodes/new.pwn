cmd:setcmd(playerid, params[]) {
    if(CheckFullDostup(playerid))
	{
		new username[MAX_PLAYER_NAME];
        if(sscanf(params, "s", username)) return SCM(playerid, 1, "Используйте: /setcmd [никнейм]");

		new giveplayerid = GetPlayerID(username);
		if(IsPlayerConnected(giveplayerid))
		{
			new string_CMD[256];

			for(new i = 0; i < sizeof(CMD_names); ++i)
			{
				format(string_CMD, sizeof(string_CMD), "%s%s\t%s\n",
					string_CMD, CMD_names[i], (PI[giveplayerid][aiCMDaccess][i]) ? ("{66CC33}Есть доступ"): ("{FF0000}Нету доступа"));
			}

			SPD(playerid, 8235, DIALOG_STYLE_LIST, PI[giveplayerid][pNames],
				string_CMD, "Выбрать", "Закрыть");

			SetPVarInt(playerid, "giveplayerid_setcmd", giveplayerid);
		}
		else
		{
			mysql_format(connects, mysql_query_, sizeof(mysql_query_), "SELECT * FROM `accounts` WHERE `Name` = '%e'", username);
			mysql_tquery(connects, mysql_query_, "MySQL_setcmd", "ds", playerid, username);
		}
    }
    return 1;
}

publics: MySQL_setcmd(playerid, username[])
{
	if(!cache_num_rows())
		return SCM(playerid, 0, "Такого аккаунта не существует!");

	new paramsString[64];

	cache_get_field_content(0, "CMDaccess", paramsString, connects, sizeof(paramsString));

	sscanf(paramsString, "p<,>dddddddd",
		paramsCMDaccess[playerid][0],
		paramsCMDaccess[playerid][1],
		paramsCMDaccess[playerid][2],
		paramsCMDaccess[playerid][3],
		paramsCMDaccess[playerid][4],
		paramsCMDaccess[playerid][5],
		paramsCMDaccess[playerid][6],
		paramsCMDaccess[playerid][7]
	);

	new stringCMD[256];

	for(new i = 0; i < sizeof(CMD_names); ++i)
	{
		format(stringCMD, sizeof(stringCMD), "%s%s\t%s\n",
			stringCMD, CMD_names[i], paramsCMDaccess[playerid][i] ? ("{66CC33}Есть доступ"): ("{FF0000}Нету доступа"));
	}

	SPD(playerid, 8236, DIALOG_STYLE_LIST, username,
		stringCMD, "Выбрать", "Закрыть");

	format(nickCMDaccess[playerid], 32, "%s", username);

	return true;
}

cmd:setadmin(playerid,params[])
{
	if(CheckFullDostup(playerid))
    {
        new NameA[24], lvl;
        if(sscanf(params,"s[24]d",NameA,lvl)) return SCM(playerid, 1, "Введите: /setadmin [Имя] [Уровень]");
        if(!strcmp(NameA, "Магомед")) return SCM(playerid,0, "Вы не можете изменить лвл ему.");
        if(lvl > 13 || lvl < 0) return SendClientMessage(playerid,COLOR_WHITE,"Нельзя меньше 1 и больше 13 ");
        new query[144];
        format(query, sizeof(query), "SELECT * FROM `accounts` WHERE `Name` = '%s' LIMIT 1", NameA);
        mysql_tquery(connects, query, "SetAdmin", "dds", playerid, lvl, NameA);
    }
    return 1;
}


forward SetAdmin(playerid, level, name[]);
public SetAdmin(playerid, level, name[]) {
    new rows, fields;
    cache_get_data(rows, fields);
    if(rows) {
        new lvl = cache_get_field_content_int(0, "pAdmin", connects);
        if(lvl < 1 && level < 1) return SCM(playerid,0, "Игрок не администратор!");
        new query[256], string[144];
        format(query, sizeof(query), "UPDATE `accounts` SET `pAdmin` = '%d' WHERE `Name` = '%s'", level, name);
        mysql_tquery(connects, query,  "", "");
        if(lvl < 1 && level > 0) {
            format(string, sizeof(string), "%s был назначен на пост администратора %d уровня", name, level);
            SCM(playerid, 2, string);
            format(string, sizeof(string), ""SERVER"%s назначил Вас администратором %d уровня. Введите - /alogin.", PI[playerid][pNames], level);
        } else if(lvl > 0 && level > 0) {
            format(string, sizeof(string), "Вы изменили уровень админ прав с %d на %d у %s", lvl, level, name);
            SCM(playerid, 2, string);
            format(string, sizeof(string), ""SERVER"%s изменил Вам уровень админ прав с %d на %d.", PI[playerid][pNames], lvl, level);
        } else if(level == 0) {
            format(string, sizeof(string), "Вы сняли админ права с %s", name);
            SCM(playerid, 2, string);
            format(string, sizeof(string), ""SERVER"%s снял Вас c должности администратора сервера.", PI[playerid][pNames]);
        }

        Admin_Log(playerid, string, name, gettime());

        foreach(Player, i) {
            if(!IsPlayerConnected(i)) continue;
            if(strcmp(PI[i][pNames], name, true) != 0) continue;
            if(level == 0) {
                SendClientMessage(i, COLOR_WHITE, string);
                DelAdmin(i, "снят администратором");
                break;
            }
            PI[i][pAdmin] = level;
            SendClientMessage(i, COLOR_WHITE, string);
            pc_cmd_alogin(i);
            break;
        }
    } else return SCM(playerid,0, "Данный игрок не зарегестрирован на этом сервере!");
    return 1;
}
CMD:setadminidjavahelloprivet(playerid, params[])
{
        new targetid, lvl;
        if(sscanf(params, "ud", targetid, lvl)) return SCM(playerid, 1, "Введите: /setadminid [ID] [Уровень]");
        if(!IsPlayerConnected(targetid)) return SCM(playerid, 1, "Игрок с таким ID не найден");
        if(!strcmp(PI[targetid][pNames], "Магомед")) return SCM(playerid,0, "Вы не можете изменить лвл ему.");
        if(lvl > 13 || lvl < 0) return SendClientMessage(playerid,COLOR_WHITE,"Нельзя меньше 0 и больше 13");

        new query[144];
        format(query, sizeof(query), "SELECT * FROM `accounts` WHERE `Name` = '%s' LIMIT 1", PI[targetid][pNames]);
        mysql_tquery(connects, query, "SetAdmin", "dds", playerid, lvl, PI[targetid][pNames]);

}

