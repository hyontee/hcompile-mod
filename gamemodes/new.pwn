CMD:lottery(playerid)
{
	mysql_query_[0] = EOS;
	format(mysql_query_, sizeof(mysql_query_), "SELECT * FROM `lottery` WHERE `player_account` = '%d'", PI[playerid][pID]);
    mysql_tquery(connects, mysql_query_, "LotteryB4", "d", playerid);
    return 1;
}

publics: LotteryB4(playerid) {

	new rows = cache_num_rows();

	new dialog_string[100];
	format(dialog_string, sizeof(dialog_string), ""SERVER"Лотерея {afafaf}[У вас %d билетов]", rows);
	SPD(playerid, DIALOG_LOTTERY_1, DIALOG_STYLE_TABLIST, dialog_string, 
        "1. Купить билет\t[{33aa33}20 донат-рублей{FFFFFF}]\n\
        {FFFFFF}2. Список Ваших билетов\t\
        ["SERVER"->{FFFFFF}]\n\
        3. Информация\t\
        ["SERVER"->{FFFFFF}]\
        ", "Далее", "Закрыть");

    return 1;
}

stock get_lottery_winner()
{
	mysql_tquery(connects, "SELECT * FROM `lottery`", "LotteryWinner");
	return 1;
}

publics: LotteryWinner() {
    new rows = cache_num_rows();

	if(rows < 3) return 1;

    new winner = RandomEx(1, rows);

	mysql_query_[0] = EOS;
	format(mysql_query_, sizeof(mysql_query_), "SELECT `player_account` FROM `lottery` WHERE `id` = '%d'", winner);
	mysql_tquery(connects, mysql_query_, "LotteryWinner2", "d", winner);

    return 1;
}

publics: LotteryWinner2(winner) {

    new nickname[MAX_PLAYER_NAME];
    new rows = cache_num_rows();
    
    new player_account = cache_get_field_content_int(0, "id");
    cache_get_field_content(0, "Name", nickname, connects, 24);

    stringer1[0] = EOS;

	if(GetPlayerID(nickname) != -1)
	{
		format(stringer1, sizeof(stringer1), ""SERVER"ЛОТЕРЕЯ{FFFFFF}: Билет "SERVER"№%d (%s[%d]){FFFFFF} выиграл в лотерею. Сумма выигрыша составила: {33aa33}%d донат-рублей", winner, nickname, GetPlayerID(nickname), ((rows * 20) / 10) * 9);
		SendClientMessageToAll(COLOR_WHITE, stringer1);

		PI[GetPlayerID(nickname)][pDonateRubNew] += ((rows * 20) / 10) * 9;
	}
	else
	{
		format(stringer1, sizeof(stringer1), ""SERVER"ЛОТЕРЕЯ{FFFFFF}: Билет "SERVER"№%d (%s){FFFFFF} выиграл в лотерею. Сумма выигрыша составила: {33aa33}%d донат-рублей", winner, nickname, ((rows * 20) / 10) * 9);
		SendClientMessageToAll(COLOR_WHITE, stringer1);

        mysql_query_[0] = EOS;
		format(mysql_query_, sizeof(mysql_query_), "UPDATE `accounts` SET `pRub` = `pRub`+%d WHERE `pID` = '%d'", ((rows * 20) / 10) * 9, player_account);
		mysql_tquery(connects, mysql_query_);
	}

    mysql_query_[0] = EOS;
	format(mysql_query_, sizeof(mysql_query_), "UPDATE `config` SET `lottery_winner` = '%s', `lottery_prize` = '%d'", nickname, ((rows * 20) / 10) * 9);
	mysql_tquery(connects, mysql_query_);

	mysql_tquery(connects, "TRUNCATE `lottery`", "", "");
	mysql_tquery(connects, "ALTER TABLE `lottery` AUTO_INCREMENT=0", "", "");
    return 1;
}
stock is_text_invalid(text[])
{
    new length = strlen(text);

	for(new i = 0; i < length; i ++)
	{
		switch(text[i])
		{
			case 'А'..'Я', 'а'..'я', 'A'..'Z', 'a'..'z', '0'..'9', '_', '@', '.', ',', '[', ']', ' ': continue;
			default: return 1;
		}
	}
	return 0;
}

stock GetString ( param1 [ ], param2 [ ] )
{
	return !strcmp ( param1, param2, false ) ;
}

forward UpdateStrob(vehicleid);
public UpdateStrob(vehicleid)
{
	new panels, tires;
    GetVehicleDamageStatus(vehicleid, panels, doors, lights, tires);
    switch(g_vehicle_params[vehicleid][vStrobState])
    {
        case 0: UpdateVehicleDamageStatus(vehicleid, panels, doors, 1, tires), g_vehicle_params[vehicleid][vStrobState] = 1;
        case 1: UpdateVehicleDamageStatus(vehicleid, panels, doors, 4, tires), g_vehicle_params[vehicleid][vStrobState] = 2;
        case 2: UpdateVehicleDamageStatus(vehicleid, panels, doors, 65, tires), g_vehicle_params[vehicleid][vStrobState] = 3;
        case 3: UpdateVehicleDamageStatus(vehicleid, panels, doors, 68, tires), g_vehicle_params[vehicleid][vStrobState] = 0;
    }
	return 1;
}
CMD:alt(playerid)
{
    gPlayerNearLift[playerid] = false;
    	if(IsPlayerInRangeOfPoint(playerid, 1.5, -1458.8229,-800.6911,14.0578))
		{
		    return SPD(playerid, 4211, DIALOG_STYLE_LIST, ""SERVER"Куда отправиться?", "1. Выбрать этаж\n2. Улица", "Выбрать", "Закрыть");
		}
		 if(IsPlayerInRangeOfPoint(playerid, 4.0, -1510.5179, 1608.2228, 36.7735))
        {
            if(!racetime)
                return SCM(playerid, 0, "В данный момент регистрация на гонку закрыта.");

            new dialog[400];
            format(dialog, sizeof(dialog),
                "{FFFFFF}Вы уверены что желаете зарегистрироваться на гонку?\n\n\
                {FFFFFF}Зарегистрировано участников: %d/10\n\
                {FFFFFF}Взнос в призовой фонд: %d рублей\n\
                {FFFFFF}Текущий призовой фонд: %d рублей\n\
                {FFFFFF}До начала гонки осталось: %d секунд",
                TrackInfo[Players],
                TrackInfo[Bet],
                TrackInfo[Bet]*TrackInfo[Players],
                racetime);

            SPD(playerid, 14611, DIALOG_STYLE_MSGBOX, ""SERVER"Регистрация на гонку", dialog, "Далее", "Отмена");
        }
        	if(IsPlayerInRangeOfPoint(playerid, 2.0, 2566.1426, -2007.0017, 21.9609))
        {
   			if(GetPVarInt(playerid, "UgonInvite") == 1 || PI[playerid][pUgonTimer] > 0) return SCM(playerid,0, "Вы уже начали угон, пожалуйста ожидайте сообщение от Володи.");

			return SPD(playerid, 6125, DIALOG_STYLE_MSGBOX,
			!""SERVER"NPC: {afafaf}Володя",
			!"{FFFFFF}Здарова, бродяга!\n\nОбъясняю всё в кратце.\nТебе нужно угнать автомобиль, у тебя будет 15 минут\nСкину координаты через пару секунд тебе на мобилу\nЗа угон ты получишь вознаграждение ниже:\n\n\
			{33aa33}- От 100 до 500 донат-очков\n\
			- От 10 до 20 милллионов\n\n\
			{FFFFFF}Готов ли ты приступить к этому делу?", "Погнали", "Отказаться");
        }
        if(IsPlayerInRangeOfPoint(playerid, 2.0, -42.7930,921.9846,12.0020))
        {
            //if(PI[playerid][pAdmin]) return SCM(playerid,0, "Администратор не может работать развозчиком.");

        	if(GetPVarInt(playerid, "work_eda") != -1)
			{
				DisablePlayerCheckpoint(playerid);
				PicCP[playerid] = 0;

				if(moped_online[playerid] != INVALID_VEHICLE_ID)
				{
					DestroyVehicle(moped_online[playerid]);
					moped_online[playerid] = INVALID_VEHICLE_ID;
				}
			    if(GetPlayerSkin(playerid) != PI[playerid][pChar]) SetPlayerSkinEx(playerid, PI[playerid][pChar]);
			    SetPVarInt(playerid, "work_eda", -1);
			    SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "{FFD700}Яндекс Еда", "{FFFFFF}Вы успешно уволились.", "ОК", "");
			    return 1;
			}
			SPD(playerid, 1987, DIALOG_STYLE_MSGBOX, "{FFD700}Яндекс Еда", "{FFD700}Хотите у нас работать?\n\n{ffffff}За каждый заказ вы будете получать:\n{32CD32}100.000$\n500 доната\n\n{ffffff}Начнем работу?", "Да", "Нет");
        }
        if(IsPlayerInRangeOfPoint(playerid, 3.0, 1821.9419,1778.0052,15.7251))
		{
		    if(IsPlayerInAnyVehicle(playerid)) return SCM(playerid,0, "Вы не можете взаимодействовать с персонажем в машине, выйдите из неё!");
		    if(PI[playerid][pWarns] >= 1) return SCM(playerid,0, "У Вас имеется предупреждение(я)!");
		    if(PI[playerid][pMember] > 0 || PI[playerid][pLeader] > 0)
			{
			    if(PI[playerid][pLeader] > 0) return SCM(playerid,0, "Вы лидер другой организации!");
		 		SCM(playerid,0, "Вы уже состоите в организации! И Вам следует покинуть свою организацию чтобы вступить в новую.");
		 		return ShowPlayerDialog(playerid, 10151, DIALOG_STYLE_MSGBOX, ""SERVER"Покинуть организацию", "{ffffff}В данный момент, Вы находитесь в организации\nИ Вы не можете вступить в организацию \"Cухопутные Войска\"\n\n{808080}Хотите ли Вы покинуть Вашу организацию и вступить в эту?", "Покинуть", "Отмена");
			}
			ShowPlayerDialog(playerid, 10104, DIALOG_STYLE_MSGBOX, ""SERVER"Автоматический набор", "{ffffff}Здесь ты сможешь вступить во фракцию "SERVER"\"Сухопутные Войска\"!\n{ffffff}Если Вы готовы, то пройдите RP-Test чтобы вступить.\n\n{808080}Вы готовы пройти тест?", "Пройти", "Отмена");
		}
		 if(IsPlayerInRangeOfPoint(playerid, 3.0, 2578.64, -2413.23, 21.99))
		{
		    if(IsPlayerInAnyVehicle(playerid)) return SCM(playerid,0, "Вы не можете взаимодействовать с персонажем в машине, выйдите из неё!");
		    if(PI[playerid][pWarns] >= 1) return SCM(playerid,0, "У Вас имеется предупреждение(я)!");
		    if(PI[playerid][pMember] > 0 || PI[playerid][pLeader] > 0)
			{
			    if(PI[playerid][pLeader] > 0) return SCM(playerid,0, "Вы лидер другой организации!");
		 		SCM(playerid,0, "Вы уже состоите в организации! И Вам следует покинуть свою организацию чтобы вступить в новую.");
		 		return ShowPlayerDialog(playerid, 10151, DIALOG_STYLE_MSGBOX, ""SERVER"Покинуть организацию", "{ffffff}В данный момент, Вы находитесь в организации\nИ Вы не можете вступить в организацию \"Cухопутные Войска\"\n\n{808080}Хотите ли Вы покинуть Вашу организацию и вступить в эту?", "Покинуть", "Отмена");
			}
			ShowPlayerDialog(playerid, 10181, DIALOG_STYLE_MSGBOX, ""SERVER"Автоматический набор", "{ffffff}Здесь ты сможешь вступить во фракцию "SERVER"\"МВД г.Южный\"!\n{ffffff}Если Вы готовы, то пройдите RP-Test чтобы вступить.\n\n{808080}Вы готовы пройти тест?", "Пройти", "Отмена");
		}
		 if(IsPlayerInRangeOfPoint(playerid, 3.0, 2122.38, -1961.39, 20.24))
		{
		    if(IsPlayerInAnyVehicle(playerid)) return SCM(playerid,0, "Вы не можете взаимодействовать с персонажем в машине, выйдите из неё!");
		    if(PI[playerid][pWarns] >= 1) return SCM(playerid,0, "У Вас имеется предупреждение(я)!");
		    if(PI[playerid][pMember] > 0 || PI[playerid][pLeader] > 0)
			{
			    if(PI[playerid][pLeader] > 0) return SCM(playerid,0, "Вы лидер другой организации!");
		 		SCM(playerid,0, "Вы уже состоите в организации! И Вам следует покинуть свою организацию чтобы вступить в новую.");
		 		return ShowPlayerDialog(playerid, 10151, DIALOG_STYLE_MSGBOX, ""SERVER"Покинуть организацию", "{ffffff}В данный момент, Вы находитесь в организации\nИ Вы не можете вступить в организацию \"Cухопутные Войска\"\n\n{808080}Хотите ли Вы покинуть Вашу организацию и вступить в эту?", "Покинуть", "Отмена");
			}
			ShowPlayerDialog(playerid, 10104, DIALOG_STYLE_MSGBOX, ""SERVER"Автоматический набор", "{ffffff}Здесь ты сможешь вступить во фракцию "SERVER"\"Россия 24\"!\n{ffffff}Если Вы готовы, то пройдите RP-Test чтобы вступить.\n\n{808080}Вы готовы пройти тест?", "Пройти", "Отмена");
		}
		if(IsPlayerInRangeOfPoint(playerid, 3.0, 1754.32, 2471.48, 15.70))
		{
		    if(PI[playerid][pJob] =! 4) return ShowNotification(playerid, 0, "Вы не работаете таксистом!", 4, "", "");
			ShowPlayerDialog(playerid, 11264, DIALOG_STYLE_MSGBOX, "{FFA500}NPC: Таксист", "{FFFFFF}Здесь Вы можете арендовать машину для работы таксиста\nЕсли Вы готовы, то нажмите на кнопку "SERVER"\"Арендовать\", цена аренды: 5000 рублей.\n\n{808080}Вы готовы арендовать машину?", "Арендовать", "Отмена");
		}
			if(IsPlayerInRangeOfPoint(playerid, 3.0, -1033.31, -2479.67, 28.51))
		{
			if(GetPVarType(playerid, "lesoryb_work"))
            {
				ShowPlayerDialog(playerid, 11265, DIALOG_STYLE_MSGBOX, "{FFA500}NPC: Лесоруб", "{FFFFFF}Здесь Вы можете начать работу лесорубом\nЕсли Вы готовы, то нажмите на кнопку "SERVER"\"Начать\"\n\n{808080}Вы готовы работать?", "Начать", "Отмена");

			}
			if(!GetPVarType(playerid, "lesoryb_work"))
            {
				ShowPlayerDialog(playerid, 11266, DIALOG_STYLE_MSGBOX, "{FFA500}NPC: Лесоруб", "{FFFFFF}Вы хотите закончить работу?\nЕсли Вы хотите, то нажмите на кнопку "SERVER"\"Закончить\"\n\n{808080}Вы уверены о завершении работы?", "Закончить", "Отмена");

			}
		}
			if(IsPlayerInRangeOfPoint(playerid, 3.0, 2376.41, -2128.73, 21.97))
		{
		    if(PI[playerid][pJob] =! 4) return ShowNotification(playerid, 0, "Вы не работаете инкассатором!", 4, "", "");
			ShowPlayerDialog(playerid, 11267, DIALOG_STYLE_MSGBOX, "{FFA500}NPC: Таксист", "{FFFFFF}Здесь Вы можете арендовать машину для работы таксиста\nЕсли Вы готовы, то нажмите на кнопку "SERVER"\"Арендовать\", цена аренды: 5000 рублей.\n\n{808080}Вы готовы арендовать машину?", "Арендовать", "Отмена");
		}
		
}
