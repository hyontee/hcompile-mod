cmd:allrub(playerid, params[])
{
    if(FD[playerid])
    {
        if(sscanf(params,"d",params[0]))return SendClientMessage(playerid, 0xFFFFFFF, "• "SERVER"[Подсказка] {ffffff}/allrub [Количество]");
        // Старое - foreach(new i: Player) // Старое - if(!IsPlayerConnected(i)) continue; // Старое - PI[i][pDonateRubNew] += params[0];
        {
            if(!IsPlayerConnected(playerid)) return 1;
            PI[playerid][pDonateRubNew] += params[0];
            if(params[0] > 500 || params[0] < 10) return SendClientMessage(playerid,COLOR_LIGHTRED,"{FFFFFF}Нельзя меньше 10 и больше 500");
            format(stringer1,sizeof(stringer1), "{FF4500}[РАЗДАЧА донат-рублей] {FFFFFF}[Основатель] %s - выдал всем %d донат-рублей ! =)", PI[playerid][pNames], params[0]);
            SendClientMessageToAll(COLOR_LIGHTRED,stringer1);
            format(stringer1,sizeof(stringer1), "• "SERVER"[Открыть донат-меню] {ffffff}/donaterub | Проверить свой баланс - /myrub");
            SendClientMessageToAll(COLOR_LIGHTRED,stringer1);
        }
    }
    return 1;
}

cmd:alldonate(playerid, params[])
{
    if(FD[playerid])
    {
        if(sscanf(params,"d",params[0]))return SendClientMessage(playerid, 0xFFFFFFF, "• "SERVER"[Подсказка] {ffffff}/alldonate [Количество]");
        {
            if(!IsPlayerConnected(playerid)) return 1;
            PI[playerid][pDonatemoney2] += params[0];
