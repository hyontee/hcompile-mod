CMD:resultgoodsaw(playerid)
{
    isDeliveringLes[playerid] = true;
    SetPlayerCheckpoint(playerid, deliveryPosLes[0], deliveryPosLes[1], deliveryPosLes[2], 3.0);
    ShowNotification(playerid, 1, "Отнесите дрова на склад!", 4, "", "");

    // Через 1 секунду проигрываем анимацию подбора
    SetTimerEx("PlayPickupAnimation", 1000, false, "d", playerid);

