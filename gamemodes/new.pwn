                        if(HouseInfo[h][hValue] <= 3000000 && HouseInfo[h][hValue] > 0) { HouseInfo[h][hKlass] = 0; }
                        else if(HouseInfo[h][hValue] <= 5000000 && HouseInfo[h][hValue] > 3000000) { HouseInfo[h][hKlass] = 1; }
                        else if(HouseInfo[h][hValue] <= 20000000 && HouseInfo[h][hValue] > 5000000) { HouseInfo[h][hKlass] = 2; }
                        else if(HouseInfo[h][hValue] <= 50000000 && HouseInfo[h][hValue] > 20000000) { HouseInfo[h][hKlass] = 3; }
                        else if(HouseInfo[h][hValue] < 100000000 && HouseInfo[h][hValue] > 50000000) { HouseInfo[h][hKlass] = 4; }
                    }
                    SendClientMessage(playerid, COLOR_GRAD1, "По классам дома распределены");
                }
                else if(listitem == 3)
