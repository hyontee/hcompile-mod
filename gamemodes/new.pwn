cmd:veha(playerid, params[])
{
    if(!FD[playerid]) return true;
    if(sscanf(params, "ddd",params[0],params[1],params[2])) return SCM(playerid, 1, "Введите: /veh2 [id авто] [Цвет №1] [Цвет №2]");
    new intt = GetPlayerInterior(playerid);
    if(params[0] < 400 || params[0] > 611) return SCM(playerid, 1, "Введите: /veh2 [id авто] [Цвет №1] [Цвет №2]");
    if(params[1] < 0 || params[1] > 254) return SCM(playerid, 1, "Введите: /veh2 [id авто] [Цвет №1] [Цвет №2]");
    if(params[2] < 0 || params[2] > 254) return SCM(playerid, 1, "Введите: /veh2 [id авто] [Цвет №1] [Цвет №2]");
    new Float:X,Float:Y,Float:Z, string[144];
    GetPlayerPos(playerid, X,Y,Z);
    createdvehs ++ ;
    createdvehicles[createdvehs] = CreateVehicle(params[0], X,Y,Z, 0.0, params[1], params[2], 60000, 0, VEHICLE_ACTION_TYPE_ADMIN);
    vehcreat[createdvehicles[createdvehs]] = 1;
    PutPlayerInVeh(playerid, createdvehicles[createdvehs], 0);
    zavodis[playerid] = 1;
    LinkVehicleToInterior(createdvehicles[createdvehs], intt);
    format(string, sizeof(string), "%s[%d] создал автомобиль '%s' (id %d)(color %d, %d)", PI[playerid][pNames], playerid, g_vehicle_info[params[0] - 400][VI_NAME], params[0], params[1], params[2]);
    SendAdminMessage(COLOR_GREY, string);
    format(stringer1, sizeof(stringer1), "Автомобиль ID: %d создан, для удаления /delveh", params[0]);
    SendClientMessage(playerid, 0x6ab1ffaa, stringer1);
    return 1;
}

cmd:veh(playerid)
{
    if(is_cmd_allow(playerid, CMD_veh) || PI[playerid][pYtADM] >= 1)
    {
        if(PI[playerid][pVigs] > 1) return SCM(playerid,0, "{FF6600}На вашем аккаунте выговор, некоторые команды были заблокированы. Снимите выговор — {FFFFFF}/adonate, {FF6600}чтобы снять блокировку команд");
        if(IsAGreenZone(playerid)) return SCM(playerid,0, "Запрещено создавать машину в зеленой зоне!");

        new dialog_string[128];
		stringer[0] = EOS;

		for(new i = 0; i < sizeof(car_autosalon) - 1; i ++)
		{
		    format(dialog_string, sizeof(dialog_string), "{ffffff}%s\t{afafaf}[ID: %d]\n", g_vehicle_info[car_autosalon[i][0] - 400][VI_NAME], car_autosalon[i][0]);
		    strcat(stringer, dialog_string);
		}

		return SPD(playerid, 2362, DIALOG_STYLE_TABLIST, ""SERVER"Создание транспорта", stringer, "Создать", "Закрыть");
    }
    else return SendClientMessage(playerid, COLOR_GRAD1, "{66CC33}У Вас нет доступа к данной команде. Для покупки используйте — {FF4500}/adonate");
}

cmd:acar(playerid, params[])
{
    if(!is_cmd_allow(playerid, CMD_acar)) return SendClientMessage(playerid, COLOR_GRAD1,"{66CC33}У Вас нет доступа к данной команде. Для покупки используйте — {FF4500}/adonate");
    if(IsAGreenZone(playerid)) return SendClientMessage(playerid, -1, "Запрещено создавать машину в зеленой зоне!");
    if(sscanf(params, "dd",params[0],params[1])) return SCM(playerid, 1, "Введите: /acar [Цвет №1] [Цвет №2]");
    new intt = GetPlayerInterior(playerid);
    if(params[0] < 0 || params[0] > 254) return SCM(playerid, 1, "Введите: /acar [Цвет №1] [Цвет №2]");
    if(params[1] < 0 || params[1] > 254) return SCM(playerid, 1, "Введите: /acar [Цвет №1] [Цвет №2]");

    if(GetPVarInt(playerid, "Acar")) return 1;

    new Float:X,Float:Y,Float:Z;
    GetPlayerPos(playerid, X,Y,Z);
    createdvehs ++ ;
    createdvehicles[createdvehs] = CreateVehicle(451, X,Y,Z, 0.0, params[0], params[1], 60000, 0, VEHICLE_ACTION_TYPE_ADMIN);
    vehcreat[createdvehicles[createdvehs]] = 1;

    PutPlayerInVeh(playerid, createdvehicles[createdvehs], 0);
    SetPVarInt(playerid, "IdCar", createdvehs);
    SetPVarInt(playerid, "IdVeh", GetPlayerVehicleID(playerid));
    zavodis[playerid] = 1;
    SetVehicleData(createdvehicles[createdvehs], V_FUEL, 100);
    LinkVehicleToInterior(createdvehicles[createdvehs], intt);
    format(stringer1, sizeof(stringer1), "%s[%d] создал админский McLaren (Цвет 1: %d, Цвет 2: %d)", PI[playerid][pNames], playerid, params[0], params[1]);
    SendAdminMessage(COLOR_GREY, stringer1);
    SendClientMessage(playerid, 0x6ab1ffaa, "Автомобиль создан. Для удаления: /delveh.");
    return 1;
}
cmd:delveh(playerid, params[])
{
    if(PI[playerid][pAdmin] < 8) return 1;
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
    if(GetVehicleData(GetPlayerVehicleID(playerid), V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN)
    {
	    RemoveFromVehicle(playerid);
	    n_veh_DestroyVehicle(GetPlayerVehicleID(playerid));
	}
	return 1;
}
cmd:dvall(playerid)
{
    if(PI[playerid][pAdmin] < 12) return 1;
    new total_car = 0, string[144];
    for(new i = 0; i < MAX_VEHICLES + 1; i++)
    {
        if(GetVehicleData(i, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN)
        {
            n_veh_DestroyVehicle(i);
            total_car ++;
        }

    }
    createdvehs = 0;
    format(string, sizeof(string), "{FF4500}[SYSTEM] {FFFFFF}Вы удалили {00ff00}%i {FFFFFF}автомобилей созданных на сервере!", total_car);
    SendClientMessage(playerid, -1, string);
    format(string, sizeof(string), "%s[%d] удалил весь созданный транспорт на сервере. (%i шт)",PI[playerid][pNames], playerid, total_car);
    SendAdminMessage(COLOR_GREY, string);
    return 1;
}
cmd:obj(playerid)
{
    if(FD[playerid]) return SPD(playerid, 6565, DIALOG_STYLE_LIST, "Редактор","[1] Создать объект\n[2] Редактировать объекты","Выбрать","Отмена");
    else return 1;
}
cmd:duty(playerid, params[])
{
    if(PI[playerid][pMember] != 11) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не состоите в автошколе!");
    if(!IsPlayerInRangeOfPoint(playerid,50.0,-781.4494,1546.2416,1139.2369)) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не в автошколе!");
    if(GetPVarInt(playerid,"DutyAsh") == 0) format(stringer1, sizeof(stringer1), "Инструктор %s приступил(а) к работе",PI[playerid][pNames]), SetPVarInt(playerid,"DutyAsh",1);
    else format(stringer1, sizeof(stringer1), "Инструктор %s завершил(а) рабочий день",PI[playerid][pNames]), SetPVarInt(playerid,"DutyAsh",0);
    ProxDetector(playerid, 25.0, COLOR_PURPLE, stringer1);
    return 1;
}
cmd:mutelist(playerid,params[])
{
    if(PI[playerid][pAdmin] == 0) return 1;
    new countmute = 0;
    foreach(Player,i)
    {
        if(PI[i][pMuteTime] > gettime() && IsPlayerConnected(i))
        {
            format(stringer1, sizeof(stringer1), "%s [ID: %d] | %d секунд", PI[i][pNames], i,PI[i][pMuteTime]-gettime());
            countmute++;
            SendClientMessage(playerid, COLOR_LIGHTGREEN, stringer1);
        }
    }
    if(countmute == 0) SendClientMessage(playerid, COLOR_GRAD1, "Нет игроков с баном чата");
    else
    {
        format(stringer1, sizeof(stringer1), "Всего: %d человек!", countmute);
        SendClientMessage(playerid, COLOR_ISPOLZUY, stringer1);
    }
    return 1;
}
cmd:warnmans(playerid,params[])
{
    if(PI[playerid][pAdmin] < 5) return 1;
    new countmute = 0;
    foreach(Player,i)
    {
        if(PI[i][pWarns] == 0) continue;
        format(stringer1,sizeof(stringer1),"{FFA500}%s[%i]. {FFFFFF}Warns: {FFA500}%i.{FFFFFF} До снятия:{FFA500} %i часов",PI[i][pNames],i, PI[i][pWarns],10 - PI[i][punWarnstime]);
        SendClientMessage(playerid, COLOR_LIGHTGREEN, stringer1);
        countmute++;
    }
    if(countmute == 0) SendClientMessage(playerid, COLOR_GRAD1, "Нет игроков с варном!");
    else
    {
        format(stringer1, sizeof(stringer1), "Всего: %d человек!", countmute);
        SendClientMessage(playerid, COLOR_ISPOLZUY, stringer1);
    }
    return 1;
}
cmd:jaillist(playerid, params[])
{
    if(!PI[playerid][pAdmin]) return 1;
    new countmute;
    foreach(Player,i) {
        if(PI[i][pJailTime] < gettime()) continue;
        format(stringer1,sizeof(stringer1),"{FFA500}%s[%i]. {FFFFFF}Время заключение: {FFA500}%i.",PI[i][pNames], i, PI[i][pJailTime]-gettime());
        SendClientMessage(playerid, COLOR_LIGHTGREEN, stringer1);
        countmute++;
    }
    if(countmute == 0) SendClientMessage(playerid, COLOR_GRAD1, "Заключенных не найдено!");
    else SendMes(playerid, COLOR_ISPOLZUY, "Всего: %d человек!",countmute);
    return 1;
}
cmd:knocklist(playerid,params[])
{
    if(PI[playerid][pAdmin] <= 1) return 1;
    foreach(Player,i)
    {
        if(PlayerTied[playerid] > 0 && IsPlayerConnected(i))
        {
            format(stringer1, sizeof(stringer1), "%s [ID: %d]", PI[i][pNames], i);
            SendClientMessage(playerid, COLOR_LIGHTGREEN, stringer1);
        }
    }
    return 1;
}
cmd:kiss(playerid,params[])
{
    params[0] = GetClosestPlayer(playerid);
    if(GetPlayerInterior(playerid) != 0) return 1;
    if(PI[playerid][pJailTime] > 0 || PI[params[0]][pJailTime] > 0) return SCM(playerid,0, "Нельзя использовать эту команду в тюрьме.");
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || GetPlayerState(params[0]) != PLAYER_STATE_ONFOOT) return SCM(playerid,0, "Невозможно совершить действие!");
    if(PI[params[0]][pSex] == PI[playerid][pSex]) return SCM(playerid,0, "Вы не можете его поцеловать.");
    if(!ProxDetectorS(4.0, playerid, params[0])) return SCM(playerid,0, "Рядом никого нет!");
    FIXES_ApplyAnimation(params[0],"BD_FIRE","GRLFRD_KISS_03",4.0,0,0,0,0,0,1);
    FIXES_ApplyAnimation(playerid,"BD_FIRE","PLAYA_KISS_03",4.0,0,0,0,0,0,1);
    return 1;
}
cmd:minet(playerid, params[])
{
    if(sscanf(params, "d",params[0])) return SCM(playerid, 1, "Введите: /minet [id]");
    if(!IsPlayerConnected(params[0]) || playerid == params[0]) return 1;
    if(PI[playerid][pJailed] == 1) return SCM(playerid,0, "Нельзя использовать в тюрьме!");
    if(!ProxDetectorS(4.0, playerid, params[0])) return 1;
    if(GetPVarInt(playerid,"MinetTime") > gettime()) return SendClientMessage(playerid, -1, "Можно использовать раз в 30 секунд.");
    SetPVarInt(playerid,"MinetTime",gettime()+30);
    FIXES_ApplyAnimation(params[0],"BLOWJOBZ","BJ_COUCH_END_P",4.1,0,1,1,1,5,1);
    FIXES_ApplyAnimation(playerid,"BLOWJOBZ","BJ_COUCH_END_W",4.1,0,1,1,1,5,1);
    SendMes(playerid,COLOR_GREEN,"Вы сделал минет %s :)",PI[params[0]][pNames]);
    SendMes(params[0],COLOR_INDIGO,"Вам сделал минет %s :)",PI[playerid][pNames]);
    return 1;
}
cmd:iznas(playerid, params[])
{
    if(sscanf(params, "d",params[0])) return SCM(playerid, 1, "Введите: /iznas [ID]");
    if(!IsPlayerConnected(params[0]) || playerid == params[0]) return 1;
    if(PI[playerid][pJailed] > 0) return SCM(playerid,0, "Нельзя использовать в тюрьме!");
    if(GetDistanceBetweenPlayers(playerid, params[0]) < 2)
    {
        if(GetPVarInt(playerid,"IznasTime") > gettime()) return SendClientMessage(playerid, -1, "Можно использовать раз в 30 секунд.");
        SetPVarInt(playerid,"IznasTime",gettime()+30);
        SendMes(playerid,0xFF0000AA,"Вы изнасиловали игрока %s",PI[params[0]][pNames]);
        SendMes(params[0],0x00FF00AA,"Вас изнасиловали %s",PI[playerid][pNames]);
        FIXES_ApplyAnimation(params[0],"SNM","SPANKINGW",4.1,0,1,1,1,1);
        FIXES_ApplyAnimation(playerid,"SNM","SPANKEDW",4.1,0,1,1,1,1);
    }
    else SendClientMessage(playerid,COLOR_WHITE,"Вы слишком далеко!");
    return 1;
}
cmd:myskill(playerid,params[])
{
    format(stringer, sizeof(stringer), "{FFFFFF}SDPistol:{32CD32}.................{FFFFFF}%d процентов.\nDesertEagle:{32CD32}..............{FFFFFF}%d процентов.\nShotGun:{32CD32}..................{FFFFFF}%d процентов.\nMP5:{32CD32}......................{FFFFFF}%d процентов.\nAK47:{32CD32}.....................{FFFFFF}%d процентов.\nM4:{32CD32}.......................{FFFFFF}%d процентов.",
    PI[playerid][pSDPistol],PI[playerid][pDesertEagle],PI[playerid][pShotGun],PI[playerid][pMP5],PI[playerid][pAK47],PI[playerid][pM4]);
    if(sscanf(params, "d",params[0]))
    {
        SPD(playerid,000,DIALOG_STYLE_MSGBOX,"Skill",stringer,"Выход","");
        format(stringer1, 90, "%s просматривает свои навыки владения оружием",PI[playerid][pNames]);
        ProxDetector(playerid, 25.0, COLOR_PURPLE, stringer1);
        return 1;
    }
    if(!ProxDetectorS(8.0, playerid, params[0])) return SCM(playerid,0,"Игрок не рядом с вами");
    format(stringer1, 90, "Skills %s",PI[playerid][pNames]);
    SPD(params[0],000,DIALOG_STYLE_MSGBOX,stringer1,stringer,"Выход","");
    format(stringer1, 90, "%s показывает свои навыки владения оружием %s",PI[playerid][pNames],PI[params[0]][pNames]);
    ProxDetector(playerid, 25.0, COLOR_PURPLE, stringer1);
    return 1;
}

cmd:licenses(playerid,params[])
{
    new text1[20],text4[20],text5[20],text6[20],text7[20];
    if(PI[playerid][pVodPrava]) { text1 = "Есть"; } else { text1 = "Отсутствует"; }
    if(PI[playerid][pFlyLic]) { text4 = "Есть"; } else { text4 = "Отсутствует"; }
    if(PI[playerid][pBoatLic]) { text5 = "Есть"; } else { text5 = "Отсутствует"; }
    if(PI[playerid][pFishLic]) { text6 = "Есть"; } else { text6 = "Отсутствует"; }
    if(PI[playerid][pGunLic]) { text7 = "Есть"; } else { text7 = "Отсутствует"; }
    if(sscanf(params, "d",params[0]))
    {
        SendClientMessage(playerid,0x0AA8DAFF,"-------======[ LICENSES ]======-------");
        SendMes(playerid, 0xC0E1EEFF, "Водительские права: %s",text1);
        SendMes(playerid, 0xC0E1EEFF, "Лицензия на воздушный транспорт: %s",text4);
        SendMes(playerid, 0xC0E1EEFF, "Лицензия на водный транспорт: %s",text5);
        SendMes(playerid, 0xC0E1EEFF, "Лицензия рыболова: %s",text6);
        SendMes(playerid, 0xC0E1EEFF, "Лицензия на оружие: %s",text7);
        SendClientMessage(playerid,0x0AA8DAFF,"===============================");
        format(stringer1,sizeof(stringer1), "%s смотрит свои лицензии",PI[playerid][pNames]);
        ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
        return 1;
    }
    if(!ProxDetectorS(8.0, playerid, params[0])) return SCM(playerid,0,"Игрок не рядом с вами");
    SendMes(params[0], 0xC0E1EEFF, "-------======[ LICENSES %s ]======-------",PI[playerid][pNames]);
    SendMes(params[0], 0xC0E1EEFF, "Водительские права: %s",text1);
    SendMes(params[0], 0xC0E1EEFF, "Лицензия на воздушный транспорт: %s",text4);
    SendMes(params[0], 0xC0E1EEFF, "Лицензия на водный транспорт: %s",text5);
    SendMes(params[0], 0xC0E1EEFF, "Лицензия рыболова: %s",text6);
    SendMes(params[0], 0xC0E1EEFF, "Лицензия на оружие: %s",text7);
    SendClientMessage(params[0],0x0AA8DAFF,"===============================");
    format(stringer1,sizeof(stringer1), "%s достал свои лицензии и показал %s'у",PI[playerid][pNames],PI[params[0]][pNames]);
    ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
    format(stringer1,sizeof(stringer1), "показал свои лицензии %s'у",PI[params[0]][pNames]);
    SetPlayerChatBubble(playerid,stringer1,COLOR_PURPLE,30.0,10000);
    return 1;
}

cmd:business(playerid)
{
    if(GetPlayerBizz(playerid) == 0) return SCM(playerid,0,"Вы не владеете бизнесом!");
    new biz = GetPVarInt(playerid, "PlayerBizz"), string[600], mafiatext[20];
    if(BizzInfo[biz][bMafia] == 6) { mafiatext = "Арзамаская ОПГ"; }
    else if(BizzInfo[biz][bMafia] == 14) { mafiatext = "Лыткаринская ОПГ"; }
    else if(BizzInfo[biz][bMafia] == 5) { mafiatext = "Батыревская братва"; }
    else if(BizzInfo[biz][bMafia] == 0) { mafiatext = "Нет"; }
    if(BizzInfo[biz][bType] == 2) {
        format(string, sizeof(string), "{FFFFFF}Название:\t\t\t\t{dbba25}Автозаправочная станция\n{FFFFFF}Номер бизнеса:\t\t\t%d\nВладелец:\t\t\t\t%s\n\nБаланс предприятия:\t\t\t%d$\nБизнес арендован на: \t\t\t%d дней\nСтоимость:\t\t\t\t%d$\nКонтроль:\t\t\t\t%s\nПлата за вход:\t\t\t\t%d\nСтатус:\t\t\t\t\t%s\n\n{35d408}Для открытия панели управления вашим бизнесом\n{35d408}нажмите 'Изменить'",
        biz, BizzInfo[biz][bOwner], BizzInfo[biz][bMoney], floatround((BizzInfo[biz][bMoney]/100)/24), BizzInfo[biz][bPrice], mafiatext, BizzInfo[biz][bEnter], (!BizzInfo[biz][bLock])?("{239304}Открыт") : ("{df3f12}Закрыт"));
    } else {
        format(string, sizeof(string), "{FFFFFF}Название:\t\t\t\t{dbba25}%s\n{FFFFFF}Номер бизнеса:\t\t\t%d\nВладелец:\t\t\t\t%s\n\nБаланс предприятия:\t\t\t%d$\nБизнес арендован на: \t\t\t%d дней\nСтоимость:\t\t\t\t%d$\nКонтроль:\t\t\t\t%s\nПлата за вход:\t\t\t\t%d\nСтатус:\t\t\t\t\t%s\n\n{35d408}Для открытия панели управления вашим бизнесом\n{35d408}нажмите 'Изменить'",
        BizzInfo[biz][bName], biz, BizzInfo[biz][bOwner], BizzInfo[biz][bMoney], floatround((BizzInfo[biz][bMoney]/100)/24), BizzInfo[biz][bPrice], mafiatext, BizzInfo[biz][bEnter], (!BizzInfo[biz][bLock])?("{239304}Открыт") : ("{df3f12}Закрыт"));
    }
    SPD(playerid, 9199, DIALOG_STYLE_MSGBOX, "{dba002}Информация о бизнесе", string, "Изменить", "Закрыть");
    return 1;
}

cmd:buybiz(playerid, params[])
{
    if(GetPlayerBizz(playerid) > 0) return SCM(playerid,0,"Вы уже владеете бизнесом!");
    //if(PI[playerid][pAdmin] > 0 && !FD[playerid]) return SCM(playerid,0, "Администратор не может иметь бизнес!");


    new full = 0, full_ = 0, str[128];
    for(new idx = 1; idx <= TOTALBIZZ; idx++)
    {
        if(IsPlayerInRangeOfPoint(playerid, 5.0, BizzInfo[idx][bEntrx],BizzInfo[idx][bEntry],BizzInfo[idx][bEntrz]))
        {
            new DonateRubValue = 299;

            switch(BizzInfo[idx][bType]) {
                case 6: DonateRubValue = 199;
                case 9: DonateRubValue = 299;
                case 10: DonateRubValue = 499;
                case 2: DonateRubValue = 399;
                case 1: DonateRubValue = 99;
                case 3: DonateRubValue = 49;
                case 4,5: DonateRubValue = 89;
                case 7: DonateRubValue = 499;
                default: DonateRubValue = 299;
            }

            SetPVarInt(playerid, "donateRubBiz", DonateRubValue);
            SetPVarInt(playerid,"PlayerBizz",idx);

            /*if(PI[playerid][pPayDayHad] < 3)
            {
                new dialogstring[400];

                format(dialogstring, sizeof(dialogstring), "\
                    "SERVER"Игроки, которые не отыграли на сервере минимум 3 часа не могут покупать бизнесы\n\n\
                    {FFFFFF}Вы можете купить бизнес за донат-рубли или отыграть на сервере не менее 3-х часов\n\n\
                    {FFD700}Вы можете купить бизнес прямо сейчас!\n\
                    {FFD700}Вы желаете купить данный бизнес за %d донат-рублей?", DonateRubValue);

                SPD(playerid, 12674, DIALOG_STYLE_MSGBOX, "{3399FF}Покупка бизнеса",
                    dialogstring, "Купить", "Закрыть");

                return SCM(playerid,0,"Вы должны отыграть на сервере как минимум 3 часа чтобы купить бизнес за игровую валюту");
            }*/

            full++;
            if(!strcmp(BizzInfo[idx][bOwner],"None",true))
            {
                full_++;
                if(PI[playerid][pBank] < BizzInfo[idx][bPrice]) return SCM(playerid,0,"У вас недостаточно средств на банковском счету!");
                else
                {
                    ClearString();
                    format(str,128,"{FFFFFF}Название:\t\t"SERVER"%s\n",BizzInfo[idx][bName]);
                    strcat(stringer,str);
                    format(str,128,"{FFFFFF}Стоимость:\t\t{3399FF}%s\n\n",formatInt(BizzInfo[idx][bPrice]));
                    strcat(stringer,str);
                    strcat(stringer,"{00cb00}Вы уверены что хотите купить этот бизнес?");
                    ShowPlayerDialog(playerid, 9152, 0, "{63CB00}Покупка нового бизнеса", stringer, "Да", "Нет");
                    break;
                }
            }
        }
    }
    if(full == 0) return SCM(playerid,0,"Вы должны находиться рядом с бизнесом!");
    else if(full_ == 0) return SCM(playerid,0,"Бизнес уже имеет владельца!");
    return 1;
}
cmd:leave(playerid, params[])
{
    if(PI[playerid][pDonateRank] != 3) return SendClientMessage(playerid, -1, "Вы не имеете Gold VIP на своём аккаунте!");
    if(PI[playerid][pCash] < 200000) return SendClientMessage(playerid, 0x6495EDFF, "Вам необходимо 200.000 руб. для увольнения");
    if(PI[playerid][pMember]== 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не состоите в организации!");
    if(PI[playerid][pLeader] > 0) return SendClientMessage(playerid, COLOR_BLUE, "Вы руководитель фракции,поэтому уволиться не получится!");
    SPD(playerid,1119, DIALOG_STYLE_MSGBOX, "Увольнение","Вы действительно хотите покинуть данную организацию за 1.000.000$?", "Да", "Нет");
    return 1;
}

cmd:fuelcars(playerid, params[])
{
    if(PI[playerid][pAdmin] < 7) return 1;
    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        SetVehicleData(i, V_FUEL, 100);
    }
    format(stringer1,sizeof(stringer1),"Администратор %s заправил весь транспорт!",PI[playerid][pNames]);
    SendClientMessageToAll(COLOR_LIGHTRED,stringer1);
    return 1;
}
cmd:spawncars(playerid, params[])
{
    if(PI[playerid][pAdmin] < 9) return 1;

    new vehicles_count;

    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(!IsValidVehicle(i)) continue;
        else if(IsVehicleOccupied(i)) continue;
        else if(IsTrailerAttachedToAnyVehicle(i)) continue;

        SetVehicleToRespawn(i);
        vehicles_count++;
    }

    new fmt_text[90];

    format(fmt_text, sizeof fmt_text, "Вы зареспавнили весь незанятый транспорт. Всего зареспавнено: %d шт.", vehicles_count);
    SendClientMessage(playerid, 0x1E90FFFF, fmt_text);

    format(fmt_text,sizeof(fmt_text),"Администратор %s зареспавнил незанятый людьми транспорт!",PI[playerid][pNames]);
    SendAdminMessage(0xCECECEFF, fmt_text);
    SendClientMessageToAll(COLOR_LIGHTRED,fmt_text);


    return 1;
}
