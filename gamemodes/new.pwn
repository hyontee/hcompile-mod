    case 8454:
        {
            if(!response) return DeletePVar(playerid,"advert");
            if(gAdvertCount >= MAX_ADVERT_COUNT) return SCM(playerid, 0,"К сожалению, очередь на объявления занята, попробуйте позже");
            new texts1[100];
            GetPVarString(playerid,"advert",texts1,100);
            DeletePVar(playerid,"advert");
            new price = strlen(texts1) * addd;
            if(PI[playerid][pCash] < price) return SCM(playerid, 0,  "У Вас не достаточно денег");
            gAdvertCount ++;
            new slot = -1;
            for(new i;i<MAX_ADVERT_COUNT;i++)
            {
                if(!gAdvert[i][adBusy]) {slot = i; break;}
            }
            if(slot == -1) return SCM(playerid, 0,"Ошибка (#111)");
            PI[playerid][pCash] -= price;
            FracBank[0][fLsnews] += price;
            gAdvert[slot][adMoney] = price;
            format(gAdvert[slot][adSender],24,"%s",PI[playerid][pNames]);
            gAdvert[slot][adPhone] = PI[playerid][pPnumber];
            format(gAdvert[slot][adText],100,"%s",texts1);
            gAdvert[slot][adBusy] = true;
            adverttime = gettime()+30;
            SCM(playerid, 2,"Ваше объявление отправлено на обработку.");
            SendFamilyMessage(16,CBLUE, "[R] Пришло новое объявление | Смотрите: /n");
        }
