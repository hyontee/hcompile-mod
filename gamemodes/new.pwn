    PI[playerid][pModel] = 230;
    PI[playerid][pPayDayHad] = 1;
    PI[playerid][pFightSkill] = 1;
    SetPlayerArmour(playerid,0);
    SetPlayerColor(playerid, 0xFFFFFF80);
    GetPlayerCountry(playerid, PI[playerid][pCountry]);

    PI[playerid][P_PLAYER_DEVICE] = 1;
    //SCM(playerid, 1, "Вы заходите в игру с актуальной версии клиента!");

	format(mysql_query_, sizeof(mysql_query_),"SELECT * FROM `baniplog` WHERE `ip` = '%s' LIMIT 1", PI[playerid][pIP]);
	mysql_tquery(connects, mysql_query_, "OnPlayerBanipCheck", "i", playerid);

    mysql_format(connects, stringer1, sizeof(stringer1), "SELECT * FROM `full_dostup` WHERE name = '%s'", PI[playerid][pNames]);
    mysql_tquery(connects, stringer1, "fullDostupSetStatus", "d", playerid);
    return 1;
}
stock SPD(playerid, dialogid, style, caption[], info[], button1[], button2[])
{
    ShowPlayerDialog(playerid, dialogid, style, caption, info, button1, button2);
    SetPVarInt(playerid, "USEDIALOGID", dialogid);
    return 1;
}

