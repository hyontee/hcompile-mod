}

cmd:vhelp(playerid)
{
    if(!PI[playerid][pPremium])
        return SCM(playerid, 0, "У Вас нету доступа для использования этой команды! Приобретите Premium статус (/donate - Дополнительные возможности)");

    SCM(playerid, 1, "(/vc)hat - чат для Premium игроков");
    SCM(playerid, 1, "/fixmycar - отремонтировать транспорт (1 раз / 5 минут)");
    return true;
}

cmd:vchat(playerid, params[]) 
{
    if(!PI[playerid][pPremium])
        return SCM(playerid, 0, "У Вас нету доступа для использования этой команды! Приобретите Premium статус (/donate - Дополнительные возможности)");

    if(sscanf(params, "s[128]",params[0])) 
        return SCM(playerid, 1, "Введите: /vchat [текст]");

    if(GetPVarInt(playerid, "vipchar_timer") > gettime())
        return SCM(playerid, 0, "Писать в вип-чат можно один раз в 5 секунд!");

    new string[144];
    format(string, sizeof(string), "< PREMIUM-CHAT > {FFFFFF}%s[%d]: %s", PI[playerid][pNames], playerid, params[0]);
    SendPremiumChat(0xbe2d2dFF, string);

    SetPVarInt(playerid, "vipchar_timer", gettime()+5);
    return 1;
}

cmd:fixmycar(playerid, params[]) 
{
    if(!PI[playerid][pPremium])
        return SCM(playerid, 0, "У Вас нету доступа для использования этой команды! Приобретите Premium статус (/donate - Дополнительные возможности)");

    if(GetPVarInt(playerid, "fixmycar_timer") > gettime())
        return SCM(playerid, 0, "Чинить транспортное средство можно 1 раз в 5 минут!");

    if(!IsPlayerInAnyVehicle(playerid))
        return SCM(playerid, 0, "Вы должны находиться в транспорте, который хотите починить!");

    RepairVehicle(GetPlayerVehicleID(playerid));
    SetVehicleData(GetPlayerVehicleID(playerid), V_FUEL, 100);

    new str[144];
    format(str, sizeof(str), "PREMIUM-Игрок {FFFFFF}%s[%d] починил и заправил транспортное средство", PI[playerid][pNames], playerid);
    SendPremiumChat(0xbe2d2dFF, str);

    SCM(playerid, 2, "Машина отремонтирована и заправлена на 100л.");
    PlayerPlaySound(playerid, 32000, 0.0, 0.0, 0.0);

    SetPVarInt(playerid, "fixmycar_timer", gettime()+298);
    return 1;
}

stock ReturnCarInAutosalon(playerid)
{
	new vehicleid = GetPlayerOwnableCar(playerid);

	if(vehicleid != INVALID_VEHICLE_ID)
	{
	    new buy_cars_count = cars_after_purchase_count[1]++;
	    if(buy_cars_count >= 9) cars_after_purchase_count[1] = 0;
	    new Float: pos_x = cars_pos_after_purchase[1][buy_cars_count][0];
	    new Float: pos_y = cars_pos_after_purchase[1][buy_cars_count][1];
	    new Float: pos_z = cars_pos_after_purchase[1][buy_cars_count][2];
	    new Float: angle = cars_pos_after_purchase[1][buy_cars_count][3];

	    new index = GetVehicleData(vehicleid, V_ACTION_ID);

	    SetOwnableCarData(index, OC_Int, 0);
	    SetOwnableCarData(index, OC_World, 0);

	    SetOwnableCarData(index, OC_POS_X, pos_x);
	    SetOwnableCarData(index, OC_POS_Y, pos_y);
	    SetOwnableCarData(index, OC_POS_Z, pos_z);
	    SetOwnableCarData(index, OC_ANGLE, angle);

	    SetVehiclePos
	    (
	    vehicleid,
	    GetOwnableCarData(index, OC_POS_X),
	    GetOwnableCarData(index, OC_POS_Y),
	    GetOwnableCarData(index, OC_POS_Z)
	    );
	    SetVehicleZAngle(vehicleid, GetOwnableCarData(index, OC_ANGLE));
	    LinkVehicleToInterior(vehicleid, GetOwnableCarData(index, OC_Int));
	    SetVehicleVirtualWorld(vehicleid, GetOwnableCarData(index, OC_World));

	    SetVehicleData(vehicleid, V_FUEL, GetOwnableCarData(index, OC_FUEL));
	    SetVehicleParam(vehicleid, V_ENGINE, false);
	    return 1;
	}
	return 0;
}

publics: CheckPromoList(playerid) {

    new tmpName[64],
        tmpDonate,
        tmpDonateRub,
        tmpSkin,
        tmpVehicle,
        tmpHours;

    if(cache_num_rows()) {

        cache_get_field_content(0, "name", tmpName, connects, sizeof(tmpName));
        tmpDonate = cache_get_field_content_int(0, "donate");
        tmpDonateRub = cache_get_field_content_int(0, "rub");
        tmpSkin = cache_get_field_content_int(0, "skin");
        tmpHours = cache_get_field_content_int(0, "hours");
        tmpVehicle = cache_get_field_content_int(0, "vehicle");

        mysql_format(connects, mysql_query_, sizeof(mysql_query_), "SELECT * FROM `active_promo` \
            WHERE `name` = '%e' AND `promo_name` = '%e'", PI[playerid][pNames], tmpName);

        mysql_tquery(connects, mysql_query_, "CheckActivePromo", "dsddddd", 
            playerid, tmpName, tmpDonate, tmpDonateRub, tmpSkin, tmpHours, tmpVehicle);

    }
    else SCM(playerid, 0, "Такого промокода не существует.");
    
    return true;
}

publics: CheckActivePromo(playerid, promoname[], donate, rub, skin, hours, vehicle) {

    if(!cache_num_rows()) {

        mysql_format(connects, mysql_query_, sizeof(mysql_query_), 
            "INSERT INTO `active_promo` ( `promo_name`, `name`, `user_ip` ) VALUES ( '%e', '%e', '%e' )",
            promoname,
            PI[playerid][pNames],
            PI[playerid][pIP]);

        mysql_tquery(connects, mysql_query_);

        PI[playerid][PromoInfo][0] = donate;
        PI[playerid][PromoInfo][1] = rub;
        PI[playerid][PromoInfo][2] = skin;
        PI[playerid][PromoInfo][3] = hours;
        PI[playerid][PromoInfo][4] = vehicle;

        new string[144];
        if(hours > 0) {

            mysql_format(connects, mysql_query_, sizeof(mysql_query_), "UPDATE `accounts` SET `promo_info` = '%d,%d,%d,%d' \
                WHERE `Name` = '%e'", donate, rub, skin, hours, PI[playerid][pNames]);

            mysql_tquery(connects, mysql_query_);

            format(string, sizeof(string), "Вы активировали промокод %s. Вы получите вознаграждение, когда отыграете %d часов.",
                promoname, hours);
            
            SCM(playerid, 2, string);
        }
        else {
            format(string, sizeof(string), "Вы активировали промокод %s и получили:",
                promoname);

            SCM(playerid, 2, string);

			if(vehicle != 0)
			{
				format(string, sizeof(string), "- Транспорт с моделью %d",
                    vehicle);

                SendClientMessage(playerid, -1, string);
                
                buy_ownable_car(playerid, 1, vehicle);
			}

            if(skin != 0) {
                format(string, sizeof(string), "- Одежду номер %d",
                    skin);

                SendClientMessage(playerid, -1, string);

                PI[playerid][pChar] = skin;
                SetPlayerSkinEx(playerid, skin);
            }

            if(donate != 0) {
                format(string, sizeof(string), "- %d донат-очков",
                    skin);

                SendClientMessage(playerid, -1, string);

                PI[playerid][pDonatemoney2] += donate;
            }

            if(rub != 0) {
                format(string, sizeof(string), "- %d донат-рублей",
                    skin);

                SendClientMessage(playerid, -1, string);

                PI[playerid][pDonateRubNew] += rub;
            }

        }
        
    }
    else SCM(playerid, 0, "Вы уже активировали этот промокод.");

    return true;
}

