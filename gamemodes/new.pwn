    case 2929:
        {
            if(!response) return 1;

            if(strval(inputtext) > 7 || strval(inputtext) < 1)
				return SCM(playerid,0,"Укажите количество дней от 1 до 7");

			if((BizzInfo[GetPlayerBizz(playerid)][bMoney]/100)/24+strval(inputtext) > 7)
				return SCM(playerid,0,"Максимальный срок оплаты бизнеса - 7 дней");

            if(PI[playerid][pBank] < 100*(strval(inputtext)*24))
				return SCM(playerid,0,"Недостаточно средств на банковском счету");

            PI[playerid][pBank] -= 100*(strval(inputtext)*24);

            BizzInfo[GetPlayerBizz(playerid)][bMoney] += (strval(inputtext)*24)*100;

            format(stringer1,168,"\
			__________________________________\n\
			Вы пополнили баланс бизнеса на %dр.\n\
			этого хватит на %i дней для оплаты налога на бизнес\n\
			Старый баланс:\t%i руб.\n\
			Новый баланс:\t%i руб.\n\
			__________________________________", (strval(inputtext)*24)*100, floatround((BizzInfo[GetPVarInt(playerid,"PlayerBizz")][bMoney]/100)/24),PI[playerid][pBank]+(100*strval(inputtext))*24,PI[playerid][pBank]);
            ShowPlayerDialog(playerid, 000,DIALOG_STYLE_MSGBOX, "Баланс основного счета",stringer1, "Закрыть", "");
        }
