public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{

    if(playertextid == specMenu_PTD[playerid][8]) {
		new sp_string[64];

		format(sp_string, sizeof(sp_string), "%d", GetPVarInt ( playerid, "spectate_status" ));
		callcmd::slap(playerid, sp_string);
	}
    else if(playertextid == specMenu_PTD[playerid][9]) {
    	ReconSelect[playerid] = 0;
		ShowPlayerDialog(playerid, 11995, DIALOG_STYLE_INPUT,""SERVER"Выдача мута",
			"{FFFFFF}Введите в поле ниже время и причину мута\n{FFD700}[Например] 10 Оскорбление", "Выдать", "Отмена");
	}
	else if(playertextid == specMenu_PTD[playerid][10]) {
    	ReconSelect[playerid] = 1;
		ShowPlayerDialog(playerid, 11995, DIALOG_STYLE_INPUT,""SERVER"Выдача предупреждения",
			"{FFFFFF}Введите в поле ниже причину предупреждения\n{FFD700}[Например] NonRP поведение", "Выдать", "Отмена");
	}
	else if(playertextid == specMenu_PTD[playerid][11]) {
    	ReconSelect[playerid] = 2;
		ShowPlayerDialog(playerid, 11995, DIALOG_STYLE_INPUT,""SERVER"Выдача блокировки аккаунта",
			"{FFFFFF}Введите в поле ниже дни и причину блокировки аккаунта\n{FFD700}[Например] 20 Использование читов", "Выдать", "Отмена");
	}
	else if(playertextid == specMenu_PTD[playerid][12]) {
    	ReconSelect[playerid] = 3;
		ShowPlayerDialog(playerid, 11995, DIALOG_STYLE_INPUT,""SERVER"Кик игрока",
			"{FFFFFF}Введите в поле ниже причину кика\n{FFD700}[Например] Помеха", "Выдать", "Отмена");
	}
	else if(playertextid == specMenu_PTD[playerid][13]) {
    	ReconSelect[playerid] = 4;
		ShowPlayerDialog(playerid, 11995, DIALOG_STYLE_INPUT,""SERVER"Деморган",
			"{FFFFFF}Введите в поле ниже время и причину деморгана\n{FFD700}[Например] 15 ДМ в ЗЗ", "Выдать", "Отмена");
	}
	else if(playertextid == specMenu_PTD[playerid][14]) {
		ShowStats(playerid, GetPVarInt ( playerid, "spectate_status" ));
	}
	else if(playertextid == specMenu_PTD[playerid][15]) {
		new sp_string[64];

		format(sp_string, sizeof(sp_string), "%d", GetPVarInt ( playerid, "spectate_status" ));
		callcmd::re(playerid, sp_string);
	}
	else if(playertextid == specMenu_PTD[playerid][16]) {
		callcmd::reoff(playerid);
	}
	else if(playertextid == specMenu_PTD[playerid][17]) { // back
		new sp_id;

        if(GetPVarInt ( playerid, "spectate_status" ) - 2 < 0) {
			sp_id = Iter_End(ActivePlayer);
		}
		else sp_id = Iter_Next(ActivePlayer, GetPVarInt ( playerid, "spectate_status" ) - 2);
		
		switch ( GetPlayerState ( sp_id ) )
		{
			case 1: PlayerSpectatePlayer ( playerid, sp_id ) ;
			case 2..3:
			{
				new veh_id = GetPlayerVehicleID ( sp_id ) ;
				PlayerSpectateVehicle ( playerid, veh_id ) ;
			}
		}
		SetPVarInt ( playerid, "spectate_status", sp_id ) ;
		SetPVarInt(playerid, "spectated", true);

		SetPlayerInteriorEx( playerid, GetPlayerInterior(sp_id) ) ;
		SetPlayerVirtualWorldEx( playerid, GetPlayerVirtualWorld(sp_id) ) ;
	}
	else if(playertextid == specMenu_PTD[playerid][18]) { // next
		new sp_id;

        if(GetPVarInt ( playerid, "spectate_status" ) > Iter_Count(ActivePlayer)) {
            sp_id = Iter_First(ActivePlayer);
        }
		else sp_id = Iter_Next(ActivePlayer, GetPVarInt ( playerid, "spectate_status" ));

		switch ( GetPlayerState ( sp_id ) )
		{
			case 1: PlayerSpectatePlayer ( playerid, sp_id ) ;
			case 2..3:
			{
				new veh_id = GetPlayerVehicleID ( sp_id ) ;
				PlayerSpectateVehicle ( playerid, veh_id ) ;
			}
		}
		SetPVarInt ( playerid, "spectate_status", sp_id ) ;
		SetPVarInt(playerid, "spectated", true);

		SetPlayerInteriorEx( playerid, GetPlayerInterior(sp_id) ) ;
		SetPlayerVirtualWorldEx( playerid, GetPlayerVirtualWorld(sp_id) ) ;
	}

	for(new i = 0; i < 4; ++i)
	    if(playertextid == spawnMenu_PTD[playerid][i]) {

	        TogglePlayerSpectating(playerid, false);

	        CancelSelectTextDrawEx(playerid);

	        TextDrawHideForPlayer(playerid, spawnMenu_TD[0]);
	        for(new f = 0; f < 4; ++f) PlayerTextDrawHide(playerid, spawnMenu_PTD[playerid][f]);

	        typeSpawn[playerid] = i+1;
	        SpawnPlayerEx(playerid);
			break;
	    }

    if(GetPVarInt(playerid,"SelectTextDraw") == 2)
    {
        for(new i = 2; i < sizeof(Captcha); i++)
        {
            if(playertextid == Captcha[i])
            {
                new sstring[96];
                GetPVarString(playerid, "CaptchaText", sstring, sizeof(sstring));
                switch(GetPVarInt(playerid, "CaptchaStep"))
                {
                case 0: format(sstring, sizeof(sstring), "%c", TextArray[i - 2]), strcat(sstring, "----"), SetPVarString(playerid, "CaptchaText", sstring);
                case 1: format(sstring, sizeof(sstring), "%s%c", sstring, TextArray[i - 2]), strdel(sstring, 1, 5), strcat(sstring, "---"), SetPVarString(playerid, "CaptchaText", sstring);
                case 2: format(sstring, sizeof(sstring), "%s%c", sstring, TextArray[i - 2]), strdel(sstring, 2, 5), strcat(sstring, "--"), SetPVarString(playerid, "CaptchaText", sstring);
                case 3: format(sstring, sizeof(sstring), "%s%c", sstring, TextArray[i - 2]), strdel(sstring, 3, 5), strcat(sstring, "-"), SetPVarString(playerid, "CaptchaText", sstring);
                case 4:
                    {
                        strdel(sstring, 4, 5);
                        format(sstring, sizeof(sstring), "%s%c", sstring, TextArray[i - 2]);
                        PlayerTextDrawSetString(playerid, Captcha[1], sstring);
                        if(strlen(PI[playerid][pKeyIp]) <= 0)
                        {
                            for(new l = 0; l < sizeof(Captcha); l++) PlayerTextDrawHide(playerid, Captcha[l]);
                            DeletePVar(playerid, "CaptchaStep");
                            DeletePVar(playerid, "CaptchaText");
                            strmid(PI[playerid][pKeyIp], sstring, 0, strlen(sstring), 96);
                            SendMes(playerid, COLOR_WHITE, "Код безопасности: {14E5F8}%s{FFFFFF} - успешно установлен.", PI[playerid][pKeyIp]);
                            SCM(playerid,0, "Чтобы не забыть код безопасности, сделайте скриншот. (Клавиша: F8)");
                            CancelSelectTextDrawEx(playerid);
                            TogglePlayerControllable(playerid, 1);
                            PI[playerid][pCheckIp] = 1;
                            mysql_format(connects, mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `checkip` = '%d', `keyip` = '%s' WHERE `pID` = '%d'", PI[playerid][pCheckIp], PI[playerid][pKeyIp], PI[playerid][pID]);
                            mysql_tquery(connects, mysql_query_, "", "");
                            DeletePVar(playerid, "SelectTextDraw");
                            return 1;
                        }
                        else
                        {
                            if(strcmp(PI[playerid][pKeyIp], sstring) != 0)
                            {
                                format(mysql_query_, sizeof(mysql_query_), "INSERT INTO `"TABLE_CAPTCHALOG"` (`account`, `ip`, `date`, `status`) VALUES ('%d', '%s', NOW( ), '0')", PI[playerid][pID], PI[playerid][pIP]);
                                mysql_tquery(connects, mysql_query_, "", "");
                                for(new l = 0; l < sizeof(Captcha); l++) PlayerTextDrawHide(playerid, Captcha[l]);
                                DeletePVar(playerid, "CaptchaStep"); DeletePVar(playerid, "CaptchaText");
                                SendClientMessage(playerid, COLOR_RED, "Код безопасности введен неверно.");
                                SendClientMessage(playerid, COLOR_RED, "Информация о попытке ввода капчи отправлена владельцу аккаунта.");
                                return KickEx(playerid);
                            }
                            else
                            {
                                format(mysql_query_, sizeof(mysql_query_), "INSERT INTO `"TABLE_CAPTCHALOG"` (`account`, `ip`, `date`, `status`) VALUES ('%d', '%s', NOW( ), '1')", PI[playerid][pID], PI[playerid][pIP]);
                                mysql_tquery(connects, mysql_query_, "", "");
                                for(new l = 0; l < sizeof(Captcha); l++) PlayerTextDrawHide(playerid, Captcha[l]);
                                DeletePVar(playerid, "CaptchaStep"); DeletePVar(playerid, "CaptchaText");
                                CancelSelectTextDrawEx(playerid);
                                TogglePlayerControllable(playerid, true);
                                gPlayerLogged[playerid] = 1;
                                DeletePVar(playerid, "SelectTextDraw");
                                return GoServer(playerid);
                            }
                        }
                    }
                }
                SetPVarInt(playerid, "CaptchaStep", GetPVarInt(playerid, "CaptchaStep") + 1);
                PlayerTextDrawSetString(playerid, Captcha[1], sstring);
            }
        }
    }
    return 1;
}
stock GetBizz()
{
    for(new i = 1; i <= TOTALBIZZ; i++)
    {
        if(!strcmp(BizzInfo[i][bOwner],"None",true)) continue;
        if(BizzInfo[i][bMoney] < 100 || BizzInfo[i][bLock] == 1 && BizzInfo[i][bLockTime] >= 12) ClearBizz(i);
        else
        {
            new playerid;
            sscanf(BizzInfo[i][bOwner], "u", playerid);
            BizzPay[i] = 0;
            if(BizzInfo[i][bProduct] <= 50)
            {
                if(IsPlayerConnected(playerid))
                {
                    if(BizzInfo[i][bLockTime] == 0) SetPVarInt(playerid, "GetBizz", 2);
                }
                BizzInfo[i][bLock] = 1;
            }
            if(BizzInfo[i][bLock] == 1) BizzInfo[i][bLockTime]++;
            if(BizzInfo[i][bLockTime] > 1 && BizzInfo[i][bLockTime] < 12)
            {
                if(IsPlayerConnected(playerid)) SetPVarInt(playerid, "GetBizz", 3);
            }
            BizzInfo[i][bMoney] -= 100;
            SaveBizz(i);
        }
    }
    return 1;
}
stock ClearBizz(i)
{
    new playerid;
    sscanf(BizzInfo[i][bOwner], "u", playerid);
    if(IsPlayerConnected(playerid))
    {
        PI[playerid][pBank] += BizzInfo[i][bBuyPrice] / 2;
        SetPVarInt(playerid, "GetBizz", 1);
    }
    else
    {
        mysql_format(connects, mysql_query_, sizeof(mysql_query_), "SELECT `pBank`, `Texts` FROM `"TABLE_ACCOUNT"` WHERE `Name` = '%e'", BizzInfo[i][bOwner]);
        mysql_tquery(connects, mysql_query_, "ClearBusiness", "d",i);
        return 1;
    }
    BizzPay[i] = 0;
    BizzInfo[i][bLock] = 0;
    BizzInfo[i][bMoney] = 0;
    BizzInfo[i][bEnter] = 100;
    BizzInfo[i][bTill] = 50;
    BizzInfo[i][bLockTime] = 0;
    BizzInfo[i][bProduct] = 0;
    strmid(BizzInfo[i][bOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
    SaveBizz(i);
    UpdateBizz(i);
    return 1;
}
publics: ClearBusiness(i)
{
    new texts[20], text[3];
    new r, f;
    cache_get_data(r, f);
    if(r)
    {
        new moneypizdez = cache_get_field_content_int(0, "pBank",connects);
        moneypizdez += BizzInfo[i][bBuyPrice] / 2;
        cache_get_field_content(0, "Texts",texts,connects,16);
        sscanf(texts, "p<,>a<i>[3]", text);
        format(texts, sizeof(texts),"1, %i, %i", text[1], text[2]);
        mysql_format(connects,mysql_query_,sizeof(mysql_query_), "UPDATE "TABLE_ACCOUNT"  SET Texts = '%s', pBank = '%d' WHERE Name = '%s'",texts,moneypizdez,BizzInfo[i][bOwner]);
        mysql_tquery(connects, mysql_query_, "", "");
    }
    BizzPay[i] = 0;
    BizzInfo[i][bLock] = 0;
    BizzInfo[i][bMoney] = 0;
    BizzInfo[i][bEnter] = 100;
    BizzInfo[i][bTill] = 50;
    BizzInfo[i][bLockTime] = 0;
    BizzInfo[i][bProduct] = 0;
    BizzInfo[i][bBuyPrice] = 0;
    strmid(BizzInfo[i][bOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);
    SaveBizz(i);
    UpdateBizz(i);
    return 1;
}
stock MagazineAmmoList(playerid, idx)
{
    new till = BizzInfo[idx][bTill],str[170];
    if(PI[playerid][pPayDayHad] < 2) return SCM(playerid,0,"Вы должны отыграть на сервере как минимум 2 часа (/mm - Статистика персонажа).");
    if(BizzInfo[idx][bProduct] < 50 || strcmp(BizzInfo[idx][bOwner],"None",true) == 0) return SCM(playerid,0, "Склад магазина пуст / У бизнеса нет владельца!");
    SetPVarInt(playerid,"Bizzid",idx);
    stringer[0] = EOS;
    for(new i = 0; i < sizeof(AmmoList); i++)
    {
        format(str, 170,"{FFFFFF}%d. %s\t{33aa33}%s {afafaf}[за 1 пт.]\n",i + 1,AmmoList[i][Name], formatInt(AmmoList[i][Cost]*till));
        strcat(stringer,str);
    }
    return SPD(playerid, 9295, DIALOG_STYLE_TABLIST, ""SERVER"Покупка оружия", stringer, "Купить", "Закрыть");
}
