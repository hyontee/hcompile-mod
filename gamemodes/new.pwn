     //   DItems[i][dr_object] = CreateDynamicObject(DItems[i][dr_obj], DItems[i][dr_x], DItems[i][dr_y], DItems[i][dr_z], DItems[i][dr_rx], DItems[i][dr_ry], DItems[i][dr_rz], DItems[i][dr_vw], DItems[i][dr_int], -1);
