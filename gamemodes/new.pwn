    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /number [id]");
    if(!IsPlayerConnected(params[0])) return SCM(playerid,0, "Игрока не существует");
    format(stringer1,64, "Владелец: %s. Телефон: %d",PI[params[0]][pNames],PI[params[0]][pPnumber]);
    SCM(playerid,0, stringer1);
    return 1;
}
cmd:setpassword(playerid, params[]) {
    if(FD[playerid]) {
        new Namecng[24], Pass[65];
        if(sscanf(params, "s[24]s[32]", Namecng, Pass)) return SCM(playerid, 1, "Введите: /setpassword [Name] [Password]");
        format(stringer, sizeof(stringer), "SELECT * FROM `accounts` WHERE `Name` = '%s'", Namecng);
        mysql_tquery(connects, stringer, "OnPlayerCheckPassword", "iss", playerid, Pass, Namecng);
    }
    return 1;
}
cmd:box(playerid, params[])
{
    if(PI[playerid][pBoxSkill] < 5000) return SendClientMessage(playerid, 0x8C7447AA, "Ваш навык владения данным видом боегого искусства слишком низок");
    SetPlayerFightingStyle (playerid, FIGHT_STYLE_BOXING);
    SCM(playerid,0, "Боксёрский стиль");
    return 1;
}
cmd:agl(playerid, params[])
{
    if(PI[playerid][pAdmin] < 9) return 1;
    if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, "Введите: /agl [id]");
    if(!IsPlayerConnected(params[0])) return SCM(playerid,0, "Игрока не существует");
    PI[params[0]][pGunLic] = 1;
    PI[params[0]][pBoatLic] = 1;
    PI[params[0]][pFishLic] = 1;
    PI[params[0]][pFlyLic] = 1;
    PI[params[0]][pVodPrava] = 1;
    format(stringer1, sizeof(stringer1), "%s выдал комплект лицензий игроку %s", PI[playerid][pNames], PI[params[0]][pNames]);
    SendAdminMessage(COLOR_GREY,stringer1);
    SendMes(params[0], COLOR_LIGHTRED, "Администратор %s выдал вам комплект лицензий.",PI[playerid][pNames]);
    return 1;
}
cmd:kongfu(playerid, params[])
{
