CMD:bq(playerid, params[])
{
	new String144[144];

	if(sscanf(params, "d",params[0]))
		return SendClientMessage(playerid, COLOR_WHITE, "/bq [1-20]");

	if(params[0] < 1 || params[0] > 20)
		return SendClientMessage(playerid, COLOR_WHITE, "Клавиша бинда от 1 до 20");

	load_binder_player(playerid);

	switch(params[0])
	{
		case 1:
		{
			if(strlen(PI[playerid][pBinderCommand_1]) < 2)
				return SendClientMessage(playerid, COLOR_WHITE, "Данный бинд не настроен");

			format(String144, sizeof(String144), "%s", PI[playerid][pBinderCommand_1]);
