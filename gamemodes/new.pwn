stock GiveEveryPrize(playerid, day)
{
	new string[144];
	format(string, 144, "Вы получили ежедневный приз за 3 часа игры - "SERVER"%s", everyPrizes[day]);
	SCM(playerid, 0x3399FFFF, string);

	switch(day)
	{
	    case 1:
	    {
        	AddPlayerData(playerid, pRub, +, 8);
           	UpdatePlayerData(playerid, "pRub", PI[playerid][pRub]);
            GameTextForPlayer(playerid, "~g~+8RUB~n~~y~+200 DONATE", 3000, 1);
            //SendClientMessage(playerid, -1, "5 рублей за 3 часа!");
	    }
	    case 2:
	    {
        	AddPlayerData(playerid, pRub, +, 12);
           	UpdatePlayerData(playerid, "pRub", PI[playerid][pRub]);
            GameTextForPlayer(playerid, "~g~+12RUB~n~~y~+400 DONATE", 3000, 1);

            PI[playerid][pDonatemoney2] += 400;
	    }
	    case 3:
	    {
        	AddPlayerData(playerid, pRub, +, 16);
           	UpdatePlayerData(playerid, "pRub", PI[playerid][pRub]);
            GameTextForPlayer(playerid, "~g~+16RUB~n~~y~+600 DONATE", 3000, 1);

            PI[playerid][pDonatemoney2] += 600;
	    }
	    case 4:
	    {
            GameTextForPlayer(playerid, "~y~+800 DONATE", 3000, 1);
            PI[playerid][pDonatemoney2] += 800;
	    }
	    case 5:
	    {
            GameTextForPlayer(playerid, "~y~+1000 DONATE", 3000, 1);
            PI[playerid][pDonatemoney2] += 1000;
	    }
	    case 6:
	    {
	   		PI[playerid][boombox] = 1;
        	UpdatePlayerData(playerid, "boombox", 1);
	    }
	    case 7:
	    {
            PI[playerid][P_CAR_SLOT] += 1;
            UpdatePlayerData(playerid, "car_slot", PI[playerid][P_CAR_SLOT]);

        	AddPlayerData(playerid, pRub, +, 20);
           	UpdatePlayerData(playerid, "pRub", PI[playerid][pRub]);
            GameTextForPlayer(playerid, "~g~+20RUB~n~~y~+1 CAR SLOT", 3000, 1);
	    }
		default: printf("ПРОИЗОШЛА ОШИБКА ПРИ ВЫДАЧЕ ПРИЗА [playerid: %d]\n", playerid);
	}
	return 1;
}

