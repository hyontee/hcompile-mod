forward PlayPickupAnimation(playerid);
public PlayPickupAnimation(playerid)
{
    // Анимация — наклониться и поднять
    ApplyAnimation(playerid, "CARRY", "liftup", 4.1, 0, 0, 0, 0, 0);

    // Через 1.5 секунды — прикрепляем дрова и включаем анимацию ношения
    SetTimerEx("AttachWoodAndCarry", 1500, false, "d", playerid);
    return 1;
}

forward AttachWoodAndCarry(playerid);
public AttachWoodAndCarry(playerid)
{
    // Прикрепляем объект (дрова)
    SetPlayerAttachedObject(playerid, 0, 1463, 6, 0.1, 0.1, 0.0, 0.0, 90.0, 90.0);

    // Включаем анимацию несения (двумя руками)
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

    return 1;
}


