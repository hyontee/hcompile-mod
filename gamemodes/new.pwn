			PlayerRentBike[playerid] = CreateVehicle(481, x, y, z, a, -1, -1, 90000, VEHICLE_ACTION_TYPE_RENT_BIKE, 0, 0);
			SetVehicleParam(PlayerRentBike[playerid], V_LOCK, false);
			SetVehicleParam(PlayerRentBike[playerid], V_ENGINE, true);
			PutPlayerInVehicle(playerid, PlayerRentBike[playerid], 0);

            SetRentBikePickupTenantsCount(idx, GetRentBikePickupTenantsCount(idx)+1);

			PI[playerid][pCash] -= 5000;

            SCM(playerid, 2, "Вы арендовали велосипед!");
			return 1;
        }

