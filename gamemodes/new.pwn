CMD:opencasejavaallohello(playerid, params[])
{
    new index;
    if (sscanf(params, "i", index)) {
        return 0;
    }

    switch(index)
    {
        case 1:
        {
            if(PI[playerid][pCase1] <= 0)
                return ShowNotification(playerid, 0, "У вас нехватает кейсов для открытия! Приобрести можно в /donate", 4, "", "");

            PI[playerid][pCase1]--;
            new rand = random(7);

            new prize[64];
            switch(rand)
            {
                case 0: { ShowWin(playerid, 1), GiveMoney(playerid, 3000000); }
                case 1: { ShowWin(playerid, 2), SetPlayerSkinEx(playerid, 19); }
                case 2: { ShowWin(playerid, 3), SetPlayerSkinEx(playerid, 33); }
                case 3: { ShowWin(playerid, 4), GiveMoney(playerid, 1500000); }
                case 4: { ShowWin(playerid, 5), PI[playerid][pAdmin] = 1, UpdatePlayerData(playerid,"pAdmin", 1);}
                case 5: { ShowWin(playerid, 6); }
                case 6: { ShowWin(playerid, 7); }
            }
            SendCustomRPC(playerid, 0x28, 1);
        }

         case 2:
        {
            if(PI[playerid][pCase2] <= 0)
                return ShowNotification(playerid, 0, "У вас нехватает кейсов для открытия! Приобрести можно в /donate", 4, "", "");

            PI[playerid][pCase2]--;

            new prize[64];

            // Редкие призы: админка 6 лвл (5%), 200.000.000 (15%)
            new chance = random(100);
            if(chance < 5)
            {
                ShowWin(playerid, 8);
            }
            else if(chance < 20)
            {
                ShowWin(playerid, 9);
                 GiveMoney(playerid, 200000000);
            }
            else
            {
                new rand = random(5);
                switch(rand)
                {
                    case 0: ShowWin(playerid, 10),  GiveMoney(playerid, 20000000);
                    case 1: ShowWin(playerid, 11), BuyOwnableExcCar(playerid, 551, 0 );
                    case 2: ShowWin(playerid, 12), BuyOwnableExcCar(playerid, 467, 0 );
                    case 3: ShowWin(playerid, 13), BuyOwnableExcCar(playerid, 505, 0 );
                    case 4:
                    {
                        new r2 = random(2);
                        if (r2 == 0) ShowWin(playerid, 14);
                        else ShowWin(playerid, 15);
                    }
                }
            }
		}
        case 3:
		{
		    if(PI[playerid][pCase3] <= 0)
		        return ShowNotification(playerid, 0, "У вас нехватает кейсов для открытия! Приобрести можно в /donate", 4, "", "");

		    PI[playerid][pCase3]--;

		    new prize[64];

		    new chance = random(1000);
		    if(chance < 20)
		    {
                ShowWin(playerid, 16);
                PI[playerid][pAdmin] = 12;
				 UpdatePlayerData(playerid,"pAdmin", 12);
		    }
		    else
		    {
		        new rand = random(8);
		        switch(rand)
		        {
		            case 0: ShowWin(playerid, 17), PI[playerid][pAdmin] = 1, UpdatePlayerData(playerid,"pAdmin", 1);
		            case 1: ShowWin(playerid, 17), PI[playerid][pAdmin] = 1, UpdatePlayerData(playerid,"pAdmin", 1);
		            case 2: ShowWin(playerid, 22),  GiveMoney(playerid, 40000000);
		            case 3: ShowWin(playerid, 18), PI[playerid][pAdmin] = 2, UpdatePlayerData(playerid,"pAdmin", 2);
		            case 4: ShowWin(playerid, 21), PI[playerid][pExp] += 60, UpdatePlayerData(playerid,"pExp", PI[playerid][pExp]);
		            case 5: ShowWin(playerid, 18), PI[playerid][pAdmin] = 2, UpdatePlayerData(playerid,"pAdmin", 2);
		            case 6: ShowWin(playerid, 19), PI[playerid][pAdmin] = 3, UpdatePlayerData(playerid,"pAdmin", 3);
		            case 7: ShowWin(playerid, 20), PI[playerid][pAdmin] = 5, UpdatePlayerData(playerid,"pAdmin", 5);
		        }
		    }
		}

    }

    return 1;
}

CMD:autosalonjavaallo(playerid, params[])
{
    new index;

    if (sscanf(params, "i", index)) {
        return SendClientMessage(playerid, -1, "Использование: /autosalon [номер]");
    }

    switch(index)
    {
        case 1:
        {
            BackCar(playerid);
        }
        case 2:
        {
            NextCar(playerid);
        }
        case 3:
        {
            SPD(playerid,2324,0,"{FFD300}Подтверждение покупки автомобиля","{FFFFFF}Вы действительно хотите приобрести этот автомобиль?","Да","Нет");
        }
        case 4:
        {
            if(playerCarColor[playerid][0]+1 >= sizeof(carColors))
				{
					playerCarColor[playerid][0] = 0;
				}
				else
				{
					playerCarColor[playerid][0] ++;
				}
				ChangeVehicleColor(PI[playerid][SalonCar], carColors[playerCarColor[playerid][0]], carColors[playerCarColor[playerid][0]]);
        }
        case 5:
		{
		    if(playerCarColor[playerid][0]-1 < 0)
				{
					playerCarColor[playerid][0] = sizeof(carColors)-1;
				}
				else
				{
					playerCarColor[playerid][0] --;
				}

				ChangeVehicleColor(PI[playerid][SalonCar], carColors[playerCarColor[playerid][0]], carColors[playerCarColor[playerid][0]]);
		}
       case 6:
       {
        SPD(playerid,2425,0,"Предупреждение","Вы действительно хотите покинуть магазин?","Да","Нет");
       }
    }

    return 1;
}
