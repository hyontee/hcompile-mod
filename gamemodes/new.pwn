{
    TextDrawShowForPlayer(playerid, RouleBox);
    TextDrawShowForPlayer(playerid, RouleBorder[0]);
    TextDrawShowForPlayer(playerid, RouleBorder[1]);
    TextDrawShowForPlayer(playerid, RouleGamersTitle);
