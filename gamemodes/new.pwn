}

publics: CheckFullDostup(playerid)
{
	for(new i = 0; i < sizeof(full_dostup_list); ++i)
	{
		if(!strcmp(PI[playerid][pNames], full_dostup_list[i], true))
			return true;
	}
	return false;
}
stock ChangeVinil(playerid, number)
{
    new vehId = GetPlayerOwnableCar(playerid);

    vinylid[vehId] = number;

    SetVinylOnCar(playerid, vehId, number);

    ChangeVehicleColor(vehId, 1, 1);

    return 1;
}

stock DeleteVinil(playerid)
{
    new vehId = GetPlayerVehicleID(playerid);
    new index = GetVehicleData(vehId, V_ACTION_ID);

    vinylid[vehId] = 0;

    SetVinylOnCar(playerid, vehId, 0);

    ChangeVehicleColor(vehId, GetOwnableCarData(index, OC_COLOR_1), GetOwnableCarData(index, OC_COLOR_1));

    return 1;
}

stock SetVinylOnCar(playerid, vehId, number)
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
    BS_WriteValue(bitstream, PR_UINT32, 0x39);

    BS_WriteValue(bitstream, PR_INT32, number);
    BS_WriteValue(bitstream, PR_INT32, vehId);

    BS_Send(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);

    BS_Delete(bitstream);

	return true;
}
stock SetTonerOnCar(playerid, vehId, number)
{
    if (vehId == INVALID_VEHICLE_ID) return false;

    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
    BS_WriteValue(bitstream, PR_UINT32, 0x33);

    BS_WriteValue(bitstream, PR_INT32, number);
    BS_WriteValue(bitstream, PR_INT32, vehId);

    BS_Send(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);
    BS_Delete(bitstream);

    return true;
}
stock SendCustomRPC(playerid, rpcid, ...)

{

    new BitStream:bitstream = BS_New();

    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);

	BS_WriteValue(bitstream, PR_UINT32, rpcid);

    for (new i = 0; i < numargs()-2; ++i)

    {

        BS_WriteValue(bitstream, PR_UINT32, getarg(i+2));

    }



    BS_Send(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);



	BS_Delete(bitstream);

}
forward StrobFlash(vehicleid);
public StrobFlash(vehicleid)
{
    if (!IsValidVehicle(vehicleid)) return 0;

    strobState[vehicleid] = !strobState[vehicleid];

    new r = 0, g = 0, b = 0;
    if (strobState[vehicleid] == 0)
        r = 255;
    else
        b = 255;

    foreach (new playerid : Player)
    {
        if (IsPlayerInRangeOfVehicle(playerid, vehicleid, 50.0))
        {
            SetHeadlightsColor(playerid, vehicleid, r, g, b);
        }
    }

    return 1;
}
stock SetFuelProgresss(playerid, current)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
	BS_WriteValue(bitstream, PR_UINT32, RPC_CUSTOM_SET_FUEL);

	BS_WriteValue(bitstream, PR_FLOAT, current);

	BS_Send(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);

	BS_Delete(bitstream);

	return 1;
}
new updateCounter[MAX_PLAYERS];

stock UpdateSpeedometr(playerid)
{
    if(IsPlayerDriver(playerid))
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        if(!IsABike(vehicleid))
        {
            new fuels = GetVehicleData(vehicleid, V_FUEL);

            GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);

            SetVehicleParamsInit(vehicleid);
            SetVehicleData(vehicleid, V_MILEAGE, GetVehicleData(vehicleid, V_MILEAGE) + SpeedVehicle(vehicleid) / 3600.0);

            if(GetVehicleParamEx(vehicleid, V_ENGINE) == VEHICLE_PARAM_ON)
            {
                if(updateCounter[playerid] >= 20)
                {
                    if(fuels <= 0)
                    {
                        SetVehicleParam(vehicleid, V_ENGINE, false);
                        GameTextForPlayer(playerid, "~r~no fuel", 4000, 1);
                    }
                    else SetVehicleData(vehicleid, V_FUEL, fuels - 1);

                    updateCounter[playerid] = 0;
                    SendCustomRPC(playerid, 0x129, GetVehicleData(vehicleid, V_FUEL));
                }
                else
                {
                    updateCounter[playerid]++;
                }
            }
        }
    }

    return 1;
}
forward AddTaxiFare(playerid, driverid);
public AddTaxiFare(playerid, driverid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerConnected(driverid)) return 0;
    if(!IsPlayerInVehicle(playerid, GetPlayerVehicleID(playerid))) return 0;

    TransportTotal[playerid] += TransportValue[driverid];

    // (Не обязательно, но можно отображать)
    SendMes(playerid, COLOR_GREEN, "Текущая сумма оплаты за поездку: %d руб.", TransportTotal[playerid]);

    return 1;
}
forward DestroyPlayerTaxi(playerid);
public DestroyPlayerTaxi(playerid)
{
    if(IsValidVehicle(playerTaxiVehicle[playerid]))
    {
        DestroyVehicle(playerTaxiVehicle[playerid]);
        SendClientMessage(playerid, 0xFF0000FF, "Вы не вернулись. Такси было удалено.");
        playerTaxiVehicle[playerid] = INVALID_VEHICLE_ID;
    }
    return 1;
}
CMD:quest(playerid)
{
    ShowQuestShowPlayerDialog(playerid);
}
stock ShowQuestShowPlayerDialog(playerid)
{
    new dialogText[2048];
    new statusText[32];
    new statusText2[32];
    new statusText3[32];
    new statusText4[32];
    new statusText5[32];
    new statusText6[32];
    new tempText[128];

    if(PI[playerid][P_QUEST][1] == 1)
    {
        format(statusText, sizeof(statusText), "{00FF00}Выполнен");
    }
    else
    {
        format(statusText, sizeof(statusText), "{FF0000}Не выполнен");
    }
    if(PI[playerid][P_QUEST][2] == 1)
    {
        format(statusText2, sizeof(statusText2), "{00FF00}Выполнен");
    }
    else
    {
        format(statusText2, sizeof(statusText2), "{FF0000}Не выполнен");
    }

    if(PI[playerid][P_QUEST][3] == 1)
    {
        format(statusText3, sizeof(statusText3), "{00FF00}Выполнен");
    }
    else
    {
        format(statusText3, sizeof(statusText3), "{FF0000}Не выполнен");
    }
    if(PI[playerid][P_QUEST][4] == 1)
    {
        format(statusText4, sizeof(statusText4), "{00FF00}Выполнен");
    }
    else
    {
        format(statusText4, sizeof(statusText4), "{FF0000}Не выполнен");
    }

    if(PI[playerid][P_QUEST][5] == 1)
    {
        format(statusText5, sizeof(statusText5), "{00FF00}Выполнен");
    }
    else
    {
        format(statusText5, sizeof(statusText5), "{FF0000}Не выполнен");
    }

    format(dialogText, sizeof(dialogText), "{FFFFFF}1. "SERVER"Квест: Знакомство с сервером. {FFFFFF}Статус: %s\n", statusText);

    format(tempText, sizeof(tempText), "{FFFFFF}2. "SERVER"Квест: Играю уже сто лет!. {FFFFFF}Статус: %s\n", statusText2);
    strcat(dialogText, tempText);

    format(tempText, sizeof(tempText), "{FFFFFF}3. "SERVER"Освоил автобус на всё сто! {FFFFFF}Статус: %s\n", statusText3);
    strcat(dialogText, tempText);

    format(tempText, sizeof(tempText), "{FFFFFF}4. "SERVER"Рубаю деревья, как мой дед! {FFFFFF}Статус: %s\n", statusText4);
    strcat(dialogText, tempText);

    format(tempText, sizeof(tempText), "{FFFFFF}5. "SERVER"Здоровье - это главное (получить мед.карту). {FFFFFF}Статус: %s\n", statusText5);
    strcat(dialogText, tempText);

    ShowPlayerDialog(playerid, D_QUEST, DIALOG_STYLE_LIST, "{FFFFFF}Квесты", dialogText, "Выполнить", "Отмена");
    return 1;
}
