cmd:lock(playerid, params[])
{
    if(GetPlayerOwnableCar(playerid) == INVALID_VEHICLE_ID)
    {
        if(GetPlayerOwnableCars(playerid) == 0)
        return SendClientMessage(playerid, 0x999999FF, "У Вас нет личного транспорта");
        else
        return SendClientMessage(playerid, 0x999999FF, "Ваш личный транспорт не загружен на сервер");
    }
    new Float: x, Float: y, Float: z;
    GetVehiclePos(GetPlayerOwnableCar(playerid), x, y, z);

    if(IsPlayerInRangeOfPoint(playerid, 10.0, x, y, z))
    {
        ToggleLock(playerid, GetPlayerOwnableCar(playerid));
    }
    else SendClientMessage(playerid, 0x999999FF, "Вы должны стоять рядом с транспортом");
    return 1;
}
alias:lock("lk");

cmd:flock(playerid, params[])
{
    new Float: x, Float: y, Float: z;
    foreach(new vehicleid : family_vehicles[player_family [ playerid ]])
    {
        
        GetVehiclePos(vehicleid, x, y, z);
        if(IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z))
        {
            ToggleLock(playerid, vehicleid);
            break;
        }
    }

    return 1;
}

cmd:getvw(playerid)
{
    new string[ 32 ];
    format(string, sizeof(string), "Your virtual world: %i AND Inter %d", GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid) );
    SendClientMessage(playerid, 0xFFFFFFF, string);
}

cmd:park(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, -1, "Вы не в транспорте!");

	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid == INVALID_VEHICLE_ID)
	{
		if(GetPlayerOwnableCars(playerid) == 0) return SendClientMessage(playerid, 0x999999FF, "У Вас нет личного транспорта");
		else return SendClientMessage(playerid, 0x999999FF, "Ваш личный транспорт не загружен на сервер");
	}

	if(vehicleid != GetPlayerVehicleID(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "Вы должны находиться в личном транспорте");

	new index = GetVehicleData(vehicleid, V_ACTION_ID);

	new Float: cPos[4];

	GetVehiclePos(vehicleid, cPos[0], cPos[1], cPos[2]);// GetOwnableCarData(index, OC_POS_X), GetOwnableCarData(index, OC_POS_Y), GetOwnableCarData(index, OC_POS_Z));
	GetVehicleZAngle(vehicleid, cPos[3]);//GetOwnableCarData(index, OC_ANGLE));


	SetOwnableCarData(index, OC_POS_X,        cPos[0]);
    SetOwnableCarData(index, OC_POS_Y,        cPos[1]);
    SetOwnableCarData(index, OC_POS_Z,        cPos[2]);
    SetOwnableCarData(index, OC_ANGLE,        cPos[3]);

	SetOwnableCarData(index, OC_World, GetPlayerVirtualWorld(playerid));

	SetOwnableCarData(index, OC_Int, GetPlayerInterior(playerid));

	n_veh_DestroyVehicle(vehicleid);

	vehicleid = CreateVehicle
	(
		GetOwnableCarData(index, OC_MODEL_ID),
		GetOwnableCarData(index, OC_POS_X),
		GetOwnableCarData(index, OC_POS_Y),
		GetOwnableCarData(index, OC_POS_Z),
		GetOwnableCarData(index, OC_ANGLE),
		GetOwnableCarData(index, OC_COLOR_1),
		GetOwnableCarData(index, OC_COLOR_2),
		-1,
		0,
		VEHICLE_ACTION_TYPE_OWNABLE_CAR,
		index
	);

	SaveOwnableCar(vehicleid);

	PlayerOwnableCarInit(playerid);

	AddTune(index, vehicleid);
	
	SCM(playerid, 2, "Транспорт припаркован");

    return 1;
}
cmd:alogin(playerid)
{

    if(PI[playerid][pAdmin] && !dostup[playerid]) {
        if(PI[playerid][pDostup] == 0) return SPD(playerid, 2991, DIALOG_STYLE_INPUT, "{FF4500}Админ регистрация", "{FFFFFF}Придумайте пароль из 4-х цифр для авторизации в админ панеле\n{FFFFFF}Введите его в поле ниже:\n", "Далее", "Выход");
        else return SPD(playerid,2934,DIALOG_STYLE_PASSWORD,""SERVER"Админ авторизация","{FFFFFF}Вы вошли как администратор сервера\nПожалуйста, введите Ваш пароль от админки в поле ниже","Вход","Выход");
    }
    return 1;
}

cmd:asellhouse(playerid, params[])
{
    if(PI[playerid][pAdmin] != 13) return 1;
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /asellhouse [houseid]");
    if(params[0] < 0 || params[0] > 1999) return 1;
    format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `pPhousekey` = '255' WHERE `Name` = '%s'",HouseInfo[params[0]][hOwner]);
    mysql_tquery(connects, mysql_query_, "", "");

	new ownerid = GetPlayerID(HouseInfo[params[0]][hOwner]);
	if(ownerid >= 0)
	{
        if(IsOwnableCarInGarage(playerid))
        {
            if(ReturnCarInAutosalon(playerid)) SCM(playerid, 4, "Ваш автомобиль был доставлен к автосалону!");
		}
	}
	else
	{
	    new buy_cars_count = cars_after_purchase_count[1]++;
	    if(buy_cars_count >= 9) cars_after_purchase_count[1] = 0;
	    new Float: pos_x = cars_pos_after_purchase[1][buy_cars_count][0];
	    new Float: pos_y = cars_pos_after_purchase[1][buy_cars_count][1];
	    new Float: pos_z = cars_pos_after_purchase[1][buy_cars_count][2];
	    new Float: angle = cars_pos_after_purchase[1][buy_cars_count][3];

	    new Cache:res, id, stri[300];
		format(stri, 300, "SELECT pID FROM accounts WHERE Name='%s'", HouseInfo[params[0]][hOwner]);
		res = mysql_query(connects, stri);
		id = cache_get_field_content_int(0, "pID");
		cache_delete(res);

		new Cache: result, rows;
        format(stri, 300, "SELECT id,pos_x,pos_y,pos_z FROM `ownable_cars` WHERE `owner_id`='%d'", id);
        result = mysql_query(connects, stri);
        rows = cache_num_rows();

        for(new i = 0; i < rows; i++)
        {
			new Float:cx, Float:cy, Float:cz;
			cx = cache_get_field_content_float(i, "pos_x");
			cy = cache_get_field_content_float(i, "pos_y");
			cz = cache_get_field_content_float(i, "pos_z");

			if(GetDistanceBetweenPoints(-1029.1243,-2616.5549,18.3313, cx,cy,cz) <= 5.0)
			{
				format(stri, 300, "UPDATE ownable_cars SET pos_x=%f,pos_y=%f,pos_z=%f,angle=%f WHERE id=%d",
					pos_x, pos_y, pos_z, angle, cache_get_field_content_int(i, "id"));
				mysql_tquery(connects, stri);
			    break;
			}
        }

        cache_delete(result);
	}

	HouseInfo[params[0]][hHel] = 0;
    HouseInfo[params[0]][hLock] = 1;
    HouseInfo[params[0]][hOwned] = 0;
    SCM(playerid,0, "Дом продан");
    format(stringer1, sizeof(stringer1), "продал дом (ID: %d)", params[0]);
    Admin_Log(playerid, stringer1, HouseInfo[params[0]][hOwner], gettime());
    strmid(HouseInfo[params[0]][hOwner], "The State", 0, strlen("The State"), 255);
    BuyHouse(params[0]);
    return 1;
}
cmd:dj(playerid, params[])
{
    if(PI[playerid][pJob] != 15) return SCM(playerid,0,"Вы не работаете Диджеем.");
    if(IsPlayerInRangeOfPoint(playerid, 2.0,487.35198974609,-2.1640000343323,1002.3829956055))
    {
        if(AlhambraDJID == INVALID_PLAYER_ID) AlhambraDJ = true, AlhambraDJID = playerid;
        else if(AlhambraDJID != playerid) return SCM(playerid,0,"DJ уже работает и он находиться в клубе.");
    }
    else if(IsPlayerInRangeOfPoint(playerid, 1.0,-2648.001953125,1422.7509765625,906.46099853516))
    {
        if(JizzyDJID == INVALID_PLAYER_ID) JizzyDJ = true, JizzyDJID = playerid;
        else if(JizzyDJID != playerid) return SCM(playerid,0,"DJ уже работает и он находиться в клубе.");
    }
    else return SCM(playerid,0,"Вы не у стойки для DJ.");
    SPD(playerid, 5350, DIALOG_STYLE_LIST, "Панель управления DJ.", "Включить свой трек\nВыключить музыку\nОставить пульт", "Выбрать", "Отмена");
    return 1;
}
stock EditBreak(playerid)
{
    if(PI[playerid][pMember] == 1 && PI[playerid][pRank] >= 3 || PI[playerid][pMember] == 10 && PI[playerid][pRank] >= 3 || PI[playerid][pMember] == 21 && PI[playerid][pRank] >= 3
            || PI[playerid][pMember] == 2 && PI[playerid][pRank] >= 1 || PI[playerid][pMember] == 25 && PI[playerid][pRank] >= 1) {
        if(GetPVarInt(playerid,"rbinfo"))
        {
            DestroyDynamicObject(GetPVarInt(playerid, "rb_obkect"));
            DeletePVar(playerid, "rbinfo");
            DeletePVar(playerid, "rb_obkect");
            Delete3DTextLabel(Text3D:blocktext[playerid]);
            SendClientMessage(playerid,-1,"Вы убрали дорожное заграждение.");
            return 1;
        }
        ShowPlayerDialog(playerid, 22800, DIALOG_STYLE_LIST, "{ffcd00}Выберите объект", "{ffffff}1. Круглое ограждение\n{ffffff}2. Раскладное ограждение\n{ffffff}3. Будка КПП\n{ffffff}4. Метал. ограждение\n{ffffff}5. Отбойник\n{ffffff}6. Ограждение с красной лентой\n{ffffff}7. Лежачий полицейский\n{99bbff}8. Система оповещения\n{99bbff}9. Камера контроля скорости\n{ff9999}10. Знак *Направо*\n{ff9999}11. Знак *Налево*\n{ff9999}12. Знак *Движение прямо запрещено*\n{ff9999}13. Знак *Движение налево запрещено*\n{ff9999}14. Знак *Движение направо запрещено*\n{ff9999}15. Знак *Движение прямо*\n{ff9999}16. Знак *Кирпич*\n{ff9999}17. Знак *STOP*\n{ff9999}18. Знак *Камера*\n{ff9999}19. Знак *Работает эвакуатор*\n{ff9999}20. Знак *Уступить дорогу*\n{ff9999}21. Знак *Дорожные работы*\n", "Выбрать", "Закрыть");
        SetPVarInt(playerid, "B_TICK", gettime()+5);
    }
    return 1;
}
alias:break("rb");
cmd:break(playerid,params[])
{
    if(GetPVarInt(playerid, "B_TICK") > gettime())
    return SCM(playerid,0, "Команду можно использовать раз в 5 секунды");

    return EditBreak(playerid);
}
cmd:rbinfo(playerid, params[])
{
    if(PI[playerid][pMember] == 1 && PI[playerid][pRank] >= 3 || PI[playerid][pMember] == 10 && PI[playerid][pRank] >= 3 || PI[playerid][pMember] == 21 && PI[playerid][pRank] >= 3
            || PI[playerid][pMember] == 2 && PI[playerid][pRank] >= 1 || PI[playerid][pMember] == 25 && PI[playerid][pRank] >= 1)
    {
        if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
        new full;
        foreach(Player,i)
        {
            if(!GetPVarInt(i,"rbinfo")) continue;
            full ++;
            SendMes(playerid,-1,"[№%d] Установил %s, будет убран через %d секунд",i,PI[i][pNames],rbtime[i]);
        }
        if(full == 0) return SendClientMessage(playerid, -1, "Информаия не найдена");
    }
    return 1;
}
cmd:removerb(playerid, params[])
{
    if(PI[playerid][pMember] == 1 && PI[playerid][pRank] >= 12 || PI[playerid][pMember] == 10 && PI[playerid][pRank] >= 12 || PI[playerid][pMember] == 21 && PI[playerid][pRank] >= 12
            || PI[playerid][pMember] == 2 && PI[playerid][pRank] >= 9 || PI[playerid][pMember] == 25 && PI[playerid][pRank] >= 9)
    {
        if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
        if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /removerb [номер поста]");
        if(!IsPlayerConnected(params[0])) return SCM(playerid,0, "Данного дорожного заграждение не существует.");
        if(GetPVarInt(params[0],"rbinfo"))
        {
            DestroyDynamicObject(GetPVarInt(params[0], "rb_obkect"));
            DeletePVar(params[0], "rbinfo");
            DeletePVar(params[0], "rb_obkect");
            rbtime[params[0]] = 0;
            DestroyDynamic3DTextLabel(Text3D:blocktext[params[0]]);
            SendMes(params[0],-1,"%s %s[%d] убрал ваше дорожное заграждение.",fRankName[PI[playerid][pMember]-1][PI[playerid][pRank]-1],PI[playerid][pNames],playerid);
            SendMes(playerid, COLOR_WHITE, "Вы убрали дорожное заграждение №%d",params[0]);
        }
        else return SCM(playerid,0, "Данного дорожного заграждение не существует.");
    }
    return 1;
}
cmd:removerball(playerid, params[])
{
    if(PI[playerid][pMember] == 1 && PI[playerid][pRank] >= 12 || PI[playerid][pMember] == 10 && PI[playerid][pRank] >= 12 || PI[playerid][pMember] == 21 && PI[playerid][pRank] >= 12
            || PI[playerid][pMember] == 2 && PI[playerid][pRank] >= 9 || PI[playerid][pMember] == 25 && PI[playerid][pRank] >= 9)
    {
        if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
        format(stringer1,sizeof(stringer1),"[%s] %s %s[%d] убрал все дорожные заграждения.",GetPlayerFracName[PI[playerid][pMember]],fRankName[PI[playerid][pMember]-1][PI[playerid][pRank]-1],PI[playerid][pNames],playerid);
        SendTeamMessage(0x4169E1FF, stringer1);
        foreach(Player,i)
        {
            if(!GetPVarInt(i,"rbinfo")) continue;
            DestroyDynamicObject(GetPVarInt(i, "rb_obkect"));
            DeletePVar(i, "rbinfo");
            DeletePVar(i, "rb_obkect");
            rbtime[i] = 0;
            DestroyDynamic3DTextLabel(Text3D:blocktext[i]);
        }
    }
    return 1;
}

cmd:teleport(playerid)
{
    if(!PI[playerid][pAdmin]) return 1;
	return show_teleport_dialog(playerid);
}
alias:teleport("tp");

stock show_teleport_dialog(playerid)
{
	SPD(playerid, 9000, DIALOG_STYLE_LIST, ""SERVER"Меню телепортации", "{FFFFFF}1. Основные\n{FFFFFF}2. Автосалоны\n{FFFFFF}3. Работы\n{FFFFFF}4. Базы организаций\n{FFFFFF}5. Банки", "Выбрать", "Закрыть");
	return 1;
}

cmd:gps(playerid)
{
	if(GetPVarInt(playerid, "work_eda") != -1) return SCM(playerid,0, "Вы не можете использовать GPS-Навигатор во время работы развозчиком!");
	if(PI[playerid][pRaceMoney]) return SCM(playerid,0, "Вы не можете использовать GPS-Навигатор во время гонки");
    if(GetPVarInt(playerid, "UgonInvite") == 1 || PI[playerid][pUgonTimer] > 0) return SCM(playerid,0, "Вы начали угон. Команда /gps Вам недоступна.");
    SPD(playerid, 9624, DIALOG_STYLE_LIST, ""SERVER"GPS - Навигатор",
        ""SERVER"Найти ближайший 24/7\n"SERVER"Найти ближайшую АЗС\n"SERVER"Найти ближайший банкомат\n\
        {FFFFFF}1. {FFFFFF}Основные\n{FFFFFF}2. {FFFFFF}Автосалоны\n{FFFFFF}3. {FFFFFF}Бизнесы\n\
        {FFFFFF}4. {FFFFFF}Работы\n{FFFFFF}5. {FFFFFF}Базы организаций\n{FFFFFF}6. {FFFFFF}Банки\n\
        {FFFFFF}7. NPC: Володя {afafaf}[автоугон]\n{FFFFFF}8. NPC: Артём {afafaf}[Яндекс Еда]\n\
        {FFFFFF}9. Контейнеры\n{FFFFFF}10. Склады организаций\n{FFFFFF}11. Ночной клуб\n\
		{FFFFFF}12. Гоночный трек\n{FFFFFF}13. Дуэли\n{FFFFFF}14. "SERVER"[NEW] {FFFFFF}Автобазар", "Выбрать", "Закрыть");

	SendCustomRPC(playerid, 0x127, 3);
	DisablePlayerCheckpoint(playerid);
    PicCP[playerid] = 0;
    return 1;
}

CMD:hm(playerid, params[])
{
    if(PI[playerid][pPhousekey] == 255) return SCM(playerid,0,"У вас нет дома");
    if(GetPlayerVirtualWorld(playerid) != PI[playerid][pPhousekey]+50 || !IsPlayerInRangeOfPoint(playerid, 90.0,HouseInfo[PI[playerid][pPhousekey]][hExitx], HouseInfo[PI[playerid][pPhousekey]][hExity], HouseInfo[PI[playerid][pPhousekey]][hExitz])) return SCM(playerid,0,"Вы должны быть внутри своего дома");
    new string[600], tstext[10], idhm = PI[playerid][pPhousekey];
    switch(HouseInfo[idhm][hKlass])
    {
    case 1: tstext = "D";
    case 2: tstext = "C";
    case 3: tstext = "B";
    case 4: tstext = "A";
    case 5: tstext = "S";
    default: tstext = "Nope";
    }
    format(string, sizeof(string), "{FFFFFF}Тип / название:\t\t\t\t{dba002}%s\n{FFFFFF}Номер дома:\t\t\t\t%d\n{FFFFFF}Стоимость:\t\t\t\t%d\n{FFFFFF}На счету дома:\t\t\t\t$%d\n\n{FFFFFF}Квартплата:\t\t\t\t%d$\n{FFFFFF}Аптечки: \t\t\t\t%d\n{FFFFFF}Статус: \t\t\t\t\t%s\n\n{35d408}Для открытия панели управления вашим домом\nнажмите 'Изменить'",
    tstext, idhm, HouseInfo[idhm][hValue], HouseInfo[idhm][hTakings], (HouseInfo[idhm][hKlass] < 1) ? 300 : HouseInfo[idhm][hKlass] * 300,
    HouseInfo[idhm][hHel], (HouseInfo[idhm][hLock] > 0) ? "{FF4500}Закрыт" : "{0aed1c}Открыт");
    SPD(playerid, 7425, DIALOG_STYLE_MSGBOX, "{dba002}Информация о доме", string, "Изменить", "Закрыть");
    return 1;
}

cmd:healme(playerid, params[])
{
    if(HealmeObject[playerid] > gettime()) return SCM(playerid,0, "Не флуди");
    if(TeamPain[playerid] != 0 && StartPaintBall == 2) return SCM(playerid,0,"Использовать аптечки на PaintBall запрещено.");
    if(!PI[playerid][pHeal]) return SCM(playerid,0,"У вас нет аптечки");
    if(PI[playerid][pDrugtime] > gettime()) return  SendClientMessage(playerid,COLOR_GRAD1,""error"Нельзя слишком часто использывать аптечки!");
    new Float:health;
    GetPlayerHealth(playerid,health);
    if(health + 60.0 <= 100) SetPlayerHealth(playerid,health+60.0);
    else SetPlayerHealth(playerid,100.0);
    format(stringer1, sizeof(stringer1), "%s перебинтовал(а) рану",PI[playerid][pNames]);
    ProxDetector(playerid, 30.0, COLOR_YELLOW, stringer1);
    SetPlayerChatBubble(playerid,"+60 HP",COLOR_YELLOW,20.0,10000);
    if(PlayerCuffed[playerid] == 0 && !IsPlayerInAnyVehicle(playerid)) {
        ApplyAnimation(playerid,"PED","gum_eat",4.0,0,0,0,0,0,1);
        HealmeObject[playerid] = gettime() + 5;
        AntiSbiv[playerid] = gettime()+10;
    }
    PI[playerid][pHeal] --;
    PI[playerid][pDrugtime] = gettime() + 10;
    return 1;
}
cmd:healhouse(playerid, params[])
{
    for(new i = 0; i < sizeof(HouseInfo); i++)
    {
        if(IsPlayerInRangeOfPoint(playerid, 5.0,HouseInfo[i][hExitx], HouseInfo[i][hExity], HouseInfo[i][hExitz]))
        {
            if(GetPlayerVirtualWorld(playerid) == i+50)
            {
                if(HouseInfo[i][hHel] == 0) return SCM(playerid,0, "В этом месте нет аптечек");
                SCM(playerid,0, "Вы были вылечены до 100 процентов");
                format(stringer1, sizeof(stringer1), "Осталось %d аптечек", HouseInfo[i][hHel]);
                SendClientMessage(playerid, 0x6495EDFF, stringer1);
                HouseInfo[i][hHel] -= 1;
                SetPlayerHealth(playerid, 100);
                SetPlayerChatBubble(playerid, "использовал аптечку", COLOR_PURPLE, 30.0, 10000);
                return 1;
            }
        }
    }
    return 1;
}
cmd:pgetip(playerid,params[])
{
    if(FD[playerid]) {
        if(sscanf(params,"s[32]",params[0])) return SCM(playerid, 1, "Введите: /pgetip [ip]");
      //  if(!IsIpFound(params[0])) return SCM(playerid,0, "Введенное вами значение не соотвествует структуре IP-адреса.");
        strmid(check_getip, params[0], 0, strlen(params[0]), 32);
        format(mysql_query_, sizeof(mysql_query_), "SELECT `Name`, `pGetonDate`, `pOnline` FROM `"TABLE_ACCOUNT"` WHERE `pGetonIP` = '%s' ORDER BY `Name` DESC LIMIT 0,15", params[0]);
        mysql_tquery(connects, mysql_query_, "Logs","ddd", playerid, 3, 1);
    }
    return 1;
}
cmd:apass(playerid,params[])
{
    if(PI[playerid][pAdmin] < 12) return 1;
    if(sscanf(params,"dd",params[1])) return SendClientMessage(playerid, 0xFFFFFFF, "• "SERVER"[Подсказка] {ffffff}/apass [Новый Пароль] | Если вы забыли пароль >> vk.com/hellcatbenzo");
    {
        PI[playerid][pDostup] = params[1];
        SendMes(playerid, 0x00CCFFFF, "Вы сменили свой Админ.Пароль на: "SERVER"%d{00CCFF} Обязательно запишите его ", params[1]);
    }
    format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `pDostup` = '%d' WHERE `pID` = '%d'", params[1], PI[playerid][pID]);
    mysql_tquery(connects, mysql_query_, "", "");
    format(stringer1, sizeof(stringer1), "Администратор %s изменил свой административный пароль | {FF4500}ВНИМАНИЕ ", PI[playerid][pNames]);
    SendAdminMessage(0xAFAFAFFF,stringer1);
    format(stringer1, sizeof(stringer1), "... беспл.смена админ-пароля доступна на 12-ом уровне административных прав ! =)", PI[playerid][pNames]);
    SendAdminMessage(0xAFAFAFFF,stringer1);
    return 1;
}
cmd:secretcmd(playerid)
{
    SCM(playerid,0, "Список секеретных команд "SERVER"| "SERVER_NAME"");
    if(PI[playerid][pAdmin] >= 11) SendClientMessage(playerid, 0xB8860BFF, "1 - /gzcolor /givebilet /agiverank /skick /givemedcard");
    if(PI[playerid][pAdmin] >= 11) SendClientMessage(playerid, 0xB8860BFF, "2 - /setbizmafia /setmats /money /unbanip /agetipreg");
    if(PI[playerid][pAdmin] >= 11) SendClientMessage(playerid, 0xB8860BFF, "3 - /ban /warn /unwarn /pgetip /offban /offwarn");
    if(PI[playerid][pAdmin] >= 11) SendClientMessage(playerid, 0xB8860BFF, "4 - /noooc /sban | Правила > /ANAK /APRAV");
    if(PI[playerid][pAdmin] >= 11) SendClientMessage(playerid, 0xB8860BFF, "5 - /as /az | /AS - Открытие телепорта, /az - Телепортироваться");
    return 1;
}
cmd:acmds(playerid)
{
    SCM(playerid,0, "Список всех спрятанных комманд "SERVER"| "SERVER_NAME"");
    if(PI[playerid][pAdmin] >= 13) SendClientMessage(playerid, 0xB8860BFF, "Часть комманд может быть связана с постами ГС / ЗГС / ПГС");
    if(PI[playerid][pAdmin] >= 13) SendClientMessage(playerid, 0xB8860BFF, "Список 3 основных комманд - /fulldostup /cmdfd /secretcmd /piar /giverub");
    if(PI[playerid][pAdmin] >= 13) SendClientMessage(playerid, 0xB8860BFF, "Соглашения для донатеров - /sponsor /anak /aprav");
    return 1;
}
cmd:hack(playerid, params[])
{
    SCM(playerid,0, "- Используйте: \""SERVER"/goadm | /gohelp /rubla{ffffff}\".");
    return 1;
}
cmd:rubla(playerid, params[])
{
    if(PI[playerid][pPayDayHad] < 10) return SCM(playerid,0, "{FFFFFF}Команда доступна только после 10-и отыгранных часов.");
    SendClientMessage(playerid,-1,"За получением админ. прав обратитесь в Личные Сообщения группы. \""SERVER""VKG_NAME"{ffffff}\".");
    SendClientMessage(playerid,-1,"После обращения, и ответа вам выдадут 10 донат-рублей ! =)");
    return 1;
}
cmd:cliston(playerid)
{
    if(PI[playerid][pClist] == 0) return SendClientMessage(playerid, 0xFFFF00AA, "[Информация]: {FFFFFF}Вы не пробрели Радужный Клист, купите его: {00FF00}/donate");
    Color1Pu(playerid);
    SendClientMessage(playerid, 0xCC0000AA, "[Предупреждение] {FFFFFF}Выключить Радужный Клист вы не сможете - только при перезаходе, вы запустили Радужный Клист");
    return 1;
}
cmd:buycmds(playerid)
{
    SCM(playerid,0, "Список покупных команд"SERVER"| "SERVER_NAME"");
    if(PI[playerid][pAdmin] >= 4) SendClientMessage(playerid, 0xB8860BFF, "1 - /setadmin /setleader /ban /warn");
