					case 4:
					{
						ShowPlayerDialog(playerid, 9652, DIALOG_STYLE_MSGBOX, !""SERVER"Установка гидравлики", !"{FFFFFF}Вы действительно желаете установить 'Гидравлика'?\n\n{afafaf}Стоимость установки: {33aa33}50 000 000 руб.", !"Да", !"Нет");
					}
					case 5:
					{
						ShowPlayerDialog(playerid, 9896, DIALOG_STYLE_LIST, !""SERVER"Смена цвета фар", !"1. {0000ff}Синий\n{FFFFFF}2. {FF0000}Красный\n{FFFFFF}3. {33aa33}Зелёный\n{FFFFFF}4. Белый\n5. {ffc0cb}Розовый\n{FFFFFF}6. {FFFF00}Жёлтый", !"Установить", !"Назад");
					}
						case 6:
					{
						ShowPlayerDialog(playerid, 9897, DIALOG_STYLE_LIST, !""SERVER"Винилы", !"1. {FFFFFF}Далее\n2. {FFFFFF}Назад\n3. Купить винил{FFFFFF}", !"Установить", !"Назад");
					}
					case 7:
					{
						ShowPlayerDialog(playerid, 9898, DIALOG_STYLE_LIST, !""SERVER"Тонировка", !"1. {FFFFFF}Далее\n2. {FFFFFF}Назад{FFFFFF}\n3. {FFFFFF}Купить тонировку{FFFFFF}", !"Установить", !"Назад");
					}
					case 8:
					{
						ShowPlayerDialog(playerid, 9899, DIALOG_STYLE_INPUT, !""SERVER"Размер колес", !"Введите размер колёс, который Вы хотите установить (от 0.5 до 1.5)", !"Установить", !"Назад");
					}
						case 9:
					{
						ShowPlayerDialog(playerid, 9900, DIALOG_STYLE_LIST, !""SERVER"Неон под машиной", !"1. {FFFFFF}Далее\n2. {FFFFFF}Назад\n{FFFFFF}", !"Установить", !"Назад");
					}
				}
			}
			else
			{
				new veh = GetPlayerOwnableCar(playerid);
				
				TogglePlayerControllable(playerid, true);
				DeletePVar(playerid, "playerTune");
				
				if(veh == INVALID_VEHICLE_ID)
					return KickEx(playerid);

				new randpos = random(3);

				SetVehiclePos(veh, pos_tuning [ randpos ] [ 0 ], pos_tuning [ randpos ] [ 1 ], pos_tuning [ randpos ] [ 2 ]);
				SetVehicleZAngle(veh, pos_tuning [ randpos ] [ 3 ]);

				SetCameraBehindPlayer(playerid);
				LinkVehicleToInterior(veh, 0);
				SetVehicleVirtualWorld(veh, 0);

				SetPlayerInteriorEx(playerid, 0);
				SetPlayerVirtualWorldEx(playerid, 0);
				SaveVehicleTuning(playerid);

				SaveOwnableCar(GetPlayerOwnableCar(playerid));
				new tonerid = g_ownable_car[GetPlayerOwnableCar(playerid)][OC_TONIROVKA];

			    if (tonerid > 0)
			    {
			        SetTonerOnCar(playerid, GetPlayerOwnableCar(playerid), tonerid);
			    }
			}

		}
    	case 9000:
        {
			if(!response) return 1;
            switch(listitem)
            {
				case 0: SPD(playerid, 9001, DIALOG_STYLE_LIST, ""SERVER"Основное", "1. {FFFFFF}Мэрия\n2. {FFFFFF}Автовокзал\n3. {FFFFFF}Церковь\n4. {FFFFFF}Автосервис\n5. {FFFFFF}Лион\n6. {FFFFFF}Казино", "Выбрать", "Назад");
