CMD:b14(playerid)
{
	load_bind_command_player(playerid);

	if(strlen(PI[playerid][bind_command_14]) < 2)
		return SendClientMessage(playerid, -1, "У вас не настроен биндер на данную команду. Настройка - /binder");
	
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && robbankstime[playerid] == 0 && PlayerTied[playerid] == 0 && PlayerCuffedTime[playerid] == 0 && GetPVarInt(playerid,"Animation") == 0 && AntiSbiv[playerid] < gettime())
	{
		if(PI[playerid][Settings][4] == 0) FIXES_ApplyAnimation(playerid,"ped",Talk[PI[playerid][Settings][4]],4.1,1,1,1,1,1,1);
		else if(PI[playerid][Settings][4] != 0) FIXES_ApplyAnimation(playerid,"GANGS",Talk[PI[playerid][Settings][4]],4.1,1,1,1,1,1,1);
		SetTimerEx("ClearPlayerChatAnim", strlen(PI[playerid][bind_command_14]) * 400, false, "i", playerid);
	}
	
	if(strlen(PI[playerid][pAccent]) < 2) format(stringer1, sizeof(stringer1), "- %s {%s}(%s)[%d]", PI[playerid][bind_command_14], colorchat(playerid, 1), PI[playerid][pNames], playerid);
	else format(stringer1, sizeof(stringer1), "- %s {%s}| %s | (%s)[%d]", PI[playerid][bind_command_14], colorchat(playerid, 1), PI[playerid][pAccent], PI[playerid][pNames], playerid);
	SetPlayerChatBubble(playerid, PI[playerid][bind_command_14], 0x6ab1ffaa, 20.0, 10000);
	ProxDetector(playerid, 20.0, COLOR_FADE1, stringer1);
	
	return true;
}

