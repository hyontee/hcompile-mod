        SetPPos(playerid,303.6572,-159.7246,999.5938);
        SetPlayerFacingAngle(playerid, 88.7500);
        return 1;
    }
    else if(pickupid == mapa)
    {
        if(PI[playerid][pIzol] > 0) return SendClientMessage(playerid, -1, "Вы уже голосовали на этих выборах!");
        return ShowPlayerDialog(playerid, 8924, 0, "Выборы президента", "{ffffff}Вы хотите взять свой избирательный бюллетень и проголосовать ?", "Да", "Нет");
    }
    else if(pickupid >= Pickup1[0] && pickupid <= Pickup1[2])
    {
        if(viborplayer[playerid] == 0) return SendClientMessage(playerid, -1, "Возьмите избирательный бюллитень");
        return GetPick(playerid, 0);
    }
    for(new h = 0; h < TOTALHOUSE; h++)
    {
        if(pickupid == HouseInfo[h][hPickup])
        {
			new stringhouse[300];
	        if(HouseInfo[h][hOwned] == 1)
	        {
	            new ttextt[32], ids = GetPlayerID(HouseInfo[h][hOwner]);
	            if(IsPlayerConnected(ids)) { ttextt = "43dc10"; }
	            else if(!IsPlayerConnected(ids)) { ttextt = "d62f16"; }
	            new tstext[10], takings, rooms;
	            switch(HouseInfo[h][hKlass])
	            {
	            case 1: {
	                    tstext = "D";
	                    rooms = 4;
	                }
	            case 2: {
	                    tstext = "C";
	                    rooms = 3;
	                }
	            case 3: {
	                    tstext = "B";
	                    rooms = 5;
	                }
	            case 4: {
	                    tstext = "A";
	                    rooms = 3;
	                }
	            case 5: {
	                    tstext = "S";
	                    rooms = 3;
	                }
	            default: {
	                    tstext = "Nope";
	                    rooms = 1;
	                }
	            }
	            switch(HouseInfo[h][hKlass]) {
	            case 0: takings = 300;
	            case 1: takings = 600;
	            case 2: takings = 900;
	            case 3: takings = 1200;
	            case 4: takings = 1500;
	            case 5: takings = 1800;
	            }//b - 5, a - 3, nope - 1, d - 4, c - 3, s - 3
	            format(stringhouse, sizeof(stringhouse), "{FFFFFF}Владелец:\t\t\t{%s}%s{ffffff}\n\nКласс:\t\t\t\t%s\nНомер дома:\t\t\t№ %d\nКоличество комнат:\t\t%d\nСтоимость:\t\t\t%d$\nЕжедневная квартплата:\t%d$\nДомашний счёт:\t\t%d$",ttextt,HouseInfo[h][hOwner],tstext,h,rooms,HouseInfo[h][hValue],takings,HouseInfo[h][hTakings]);
	            SPD(playerid,10075,DIALOG_STYLE_MSGBOX,""SERVER"Дом занят",stringhouse,"Войти","Отмена");
	            break ;
	        }
	        else
	        {
	            new tstext[10], takings, rooms;
	            switch(HouseInfo[h][hKlass])
	            {
	            case 1: {
	                    tstext = "D";
	                    rooms = 4;
	                }
	            case 2: {
	                    tstext = "C";
	                    rooms = 3;
	                }
	            case 3: {
	                    tstext = "B";
	                    rooms = 5;
	                }
	            case 4: {
	                    tstext = "A";
	                    rooms = 3;
	                }
	            case 5: {
	                    tstext = "S";
	                    rooms = 3;
	                }
	            default: {
	                    tstext = "Nope";
	                    rooms = 1;
	                }
	            }
	            switch(HouseInfo[h][hKlass]) {
	            case 0: takings = 300;
	            case 1: takings = 600;
	            case 2: takings = 900;
	            case 3: takings = 1200;
	            case 4: takings = 1500;
	            case 5: takings = 1800;
	            }
	            format(stringhouse, sizeof(stringhouse), "{FFFFFF}Стоимость:\t\t\t%s\n{FFFFFF}Класс:\t\t\t\t%s\n{FFFFFF}Номер дома:\t\t\t№ %d\n{FFFFFF}Количество комнат:\t\t%d\n{FFFFFF}Ежедневная квартплата:\t%d$\n{FFFFFF}Домашний счет:\t\t%d$",formatInt(HouseInfo[h][hValue]),tstext,h,rooms,takings,HouseInfo[h][hTakings]);
	            SPD(playerid,10026,DIALOG_STYLE_MSGBOX,"{63CB00}Дом свободен",stringhouse,"Купить","Отмена");
	            break ;
	        }
        }
    }
    for(new idx = 1; idx <= TOTALBIZZ; idx++)
    {
        if(pickupid == BizzInfo[idx][bPickup])
        {
            PicCP[playerid] = 0;
            if(!strcmp(BizzInfo[idx][bOwner],"None",true))
            {
                SetPVarInt(playerid, "PlayerBizz", idx);
                format(stringer1,156,"{ffffff}Название:\t\t\t"SERVER"%s\n{FFFFFF}Стоимость:\t\t\t{3399FF}%s\n\n{00cb00}Вы уверены, что хотите войти сюда?",BizzInfo[idx][bName], formatInt(BizzInfo[idx][bPrice]));
                if(BizzInfo[idx][bType] != 2 && BizzInfo[idx][bType] != 8) return ShowPlayerDialog(playerid, 9291, 0, "{63CB00}Бизнес", stringer1, "Да", "Нет");
            }
            else
            {
                SetPVarInt(playerid, "PlayerBizz", idx);
                if(BizzInfo[idx][bEnter] > 0) format(stringer1, 128, "{ffffff}Вход платный и составляет {FFA500}%s р.\n{00cb00}Вы уверены, что хотите войти сюда?", formatInt(BizzInfo[idx][bEnter]));
                else format(stringer1, 78, "{ffffff}Вход свободный\n{00cb00}Вы уверены, что хотите войти сюда?");
                ShowPlayerDialog(playerid, 9291, 0, "Бизнес", stringer1, "Да", "Нет");
                return 1;
            }
        }
        if(pickupid == BizzInfo[idx][bPickupExit])
        {
            SetPVarInt(playerid, "PlayerBizz", idx);
            return ShowPlayerDialog(playerid, 9292, 0, "Бизнес", "{ffffff}Вы хотите выйти из бизнеса?", "Да", "Нет");
        }
        if(pickupid == BizzInfo[idx][bMenu])
        {
            if(BizzInfo[idx][bType] == 1) return MagazineList(playerid, idx);
            else if(BizzInfo[idx][bType] == 3) return EatList(playerid, idx);
            else if(BizzInfo[idx][bType] == 4 || BizzInfo[idx][bType] == 5) return ClubList(playerid, idx);
            else if(BizzInfo[idx][bType] == 7) return MagazineAmmoList(playerid, idx);
        }
    }
    if(pickupid == RealtorPickupExit)
    {
        new realtor = GetPlayerVirtualWorld(playerid) - 1000;
        SetPlayerInteriorEx(playerid, 0);
        SetPlayerVirtualWorldEx(playerid, 0);
        SetPPos(playerid,818.631,-1056.18,26.0533);
        SetPlayerFacingAngle(playerid, RI[realtor][bAngle]);
        SetCameraBehindPlayer(playerid);
        return 1;
    }
    else if(pickupid == realtorFreeBusiness)
    {
        new itters = 0, fstring[2000] = "{ffffff}";
        for(new i = 1; i < TOTALBIZZ + 1; i++)
        {
            if(!strcmp(BizzInfo[i][bOwner], "None", true))
            {
                format(fstring, sizeof(fstring), "%s[%i] %s\n", fstring, i, BizzInfo[i][bName]);
                itters++;
            }
        }
        if(!itters) return SCM(playerid,0, "В штате не найдено свободных бизнесов!");
        SPD(playerid, 24151, DIALOG_STYLE_LIST, "{00FF00}Список свободных бизнесов", fstring, "Закрыть", "");
        return 1;
    }
    else if(pickupid == adons)
    {
        pc_cmd_adonate(playerid);
        return 1;
    }
    //Донат-Очки
    else if(pickupid == donateoch)
    {
        pc_cmd_donate(playerid);
        return 1;
    }//
    else if(pickupid == realtorInfo)
    {
        SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{63CB00}Информация", "{ffffff}\
        В риелторском агенстве Вы сможете узать дома, которые будут слетать в скором времени.\n\
        {ffffff}Если на счету дому находится меньше {e6ed11}двух проплат {ffffff}за дом(в соответствии с классом дома), то он будет продан государтсву.\n\n\
        {ffffff}Используйте: {63CB00}/gethome {ffffff}- Узнать счет дома.\n\
        {ffffff}Используйте: {63CB00}/real {ffffff}- Узнать местоположение дома.\
        ", "Закрыть", "");
        return 1;
    }
    else if(pickupid == realtorFreePickup)
    {
        new fstring[1700] = "{ffffff}", count = 1, takings;
        for(new i = 0; i < sizeof HouseInfo; i++)
        {
            if(count < 30)
            {
                if(HouseInfo[i][hID])
                {
                    if(HouseInfo[i][hOwned])
                    {
                        switch(HouseInfo[i][hKlass])
                        {
                        case 0: takings = 300;
                        case 1: takings = 600;
                        case 2: takings = 900;
                        case 3: takings = 1200;
                        case 4: takings = 1500;
                        }
                        if(HouseInfo[i][hTakings] < takings * 2)
                        {
                            format(stringer1, 64, "№ дома %d\tСлетит через %d Деней\t Гос.стоимость %d\n", i, HouseInfo[i][hTakings]/takings, HouseInfo[i][hValue]);
                            strcat(fstring, stringer1);
                            //if(count % 10 == 0 && count != 0) format(fstring, sizeof fstring, "%s\t%i\n", fstring, i);
                            //else format(fstring, sizeof fstring, "%s\t%i", fstring, i);
                            count++;
                        }
                    }
                }
                //continue;
            }
        }
        if(count > 1) SPD(playerid, 0, DIALOG_STYLE_LIST, "{00FF00}Номера должников", fstring, "Закрыть", "");
        else SendClientMessage(playerid, -1, "В штате нет должников!");
        return 1;
    }
	else if(TOTALREALTORS > 0)
    {
        if(pickupid >= RI[0][bPickup] && pickupid <= RI[TOTALREALTORS-1][bPickup])
        {
            for(new i = 0; i < TOTALREALTORS; i++)
            {
                if(pickupid == RI[i][bPickup])
                {
                    SetPlayerInteriorEx(playerid, 3);
                    SetPlayerVirtualWorldEx(playerid, 1000 + i);
                    SetPPos(playerid, 1494.325195,1304.942871,1093.289062);
                    SetPlayerFacingAngle(playerid, 0.0);
                    SetCameraBehindPlayer(playerid);
                    return 1;
                }
            }
        }
    }
    return 1;
}
