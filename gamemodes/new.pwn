cmd:limit(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid,0,"Вы должны быть за рулем");
    if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, "• "SERVER"[Подсказка] {ffffff}Используйте /limit [скорость]");
    if(!params[0])
    {
        if(PI[playerid][pLimit])
        {
            PI[playerid][pLimit] = 0;
            SendClientMessage(playerid,COLOR_GREEN,"Ограничение скорости снято");
        }
        else SCM(playerid,0,"• "SERVER"[Подсказка] {ffffff}Используйте /limit [скорость]");
        return 1;
    }
    if(params[0] < 10 || params[0] > 150) return SCM(playerid,0,"Ограничение должно быть от 10 до 150");
    PI[playerid][pLimit] = params[0];
    SendClientMessage(playerid,COLOR_GREEN,"Установлено ограничение скорости");
    return 1;
}
CMD:en(playerid, params[])
{
    if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 481)
        return false;

    if(GetPlayerVehicleID(playerid) == INVALID_VEHICLE_ID) return SCM(playerid,0, "Вы не в машине.");
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;

    if(zavodis[playerid] == 0)
    {
        new idd = GetPlayerVehicleID(playerid);

        if(GetVehicleData(idd, V_FUEL) <= 0) return SendClientMessage(playerid,COLOR_RED,"В машине нет бензина");

        GetVehicleParamsEx(GetPlayerVehicleID(playerid),engine,lights,alarm,doors,bonnet,boot,objective);
        SetVehicleParamsEx(GetPlayerVehicleID(playerid), VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective);
        zavodis[playerid] = 1;
        GameTextForPlayer(playerid, "~g~ENGINE ON", 2000, 4);

       
        if (g_PlayerOnSale[playerid] == 1)
        {
            Delete3DTextLabel(g_3DTextLabel[playerid]);
            g_PlayerOnSale[playerid] = 0;
            SellPrice[playerid] = 0;
            SCM(playerid, 1, "Машина заведена, продажа отменена.");
        }
    }
    else if(zavodis[playerid] == 1)
    {
        GetVehicleParamsEx(GetPlayerVehicleID(playerid),engine,lights,alarm,doors,bonnet,boot,objective);
        SetVehicleParamsEx(GetPlayerVehicleID(playerid), VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
        zavodis[playerid] = 0;
        GameTextForPlayer(playerid, "~r~ENGINE OFF", 2000, 4);
    }
    return 1;
}

cmd:togphone(playerid)
{
    if(PI[playerid][pDonateRank] >= 1 || PI[playerid][pAdmin] >= 1 || PI[playerid][pLeader] >= 1)
    {
        if(!PhoneOnline[playerid]) PhoneOnline[playerid] = 1,SCM(playerid,0, "Вы выключили телефон");
        else if(PhoneOnline[playerid]) PhoneOnline[playerid] = 0,SCM(playerid,0, "Вы включили телефон");
    }
    else return SCM(playerid,0, "Вы не VIP/Админ/Лидер!");
    return 1;
}
cmd:divorce(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 1879.8152,1170.2408,30.0091)) return SCM(playerid,0, "Вы не в церкви!");
    if(PI[playerid][pMarried] < 1) return SCM(playerid,0, "Вы не женаты (замужем)!");
    SCM(playerid,0, "Вы развелись, ваш(а) супруг(а) должна сделать тоже самое");
    PI[playerid][pMarried] = 0;
    return 1;
}
cmd:propose(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 1879.8152,1170.2408,30.0091)) return SCM(playerid,0, "Вы не в церкви!");
    if(PI[playerid][pCash] < 100000) return SCM(playerid,0, "Вам нужно 100 000 на свадьбу!");
    if(PI[playerid][pMarried] > 0) return SCM(playerid,0, "Вы уже женаты/замужем!");
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /propose [id]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Игрока не существует или это Вы");
    if(PI[params[0]][pMarried] > 0) return SCM(playerid,0, "Человек уже состоит в браке!");
    if(!ProxDetectorS(8.0, playerid, params[0])) return SCM(playerid,0, "Человек не рядом с вами!");
    format(stringer1, sizeof(stringer1), "Вы предложили руку и сердце %s.", PI[params[0]][pNames]);
    SendClientMessage(playerid, 0x6ab1ffaa, stringer1);
    format(stringer1, sizeof(stringer1), "%s предлагает вам руку и сердце. (( Введите: /accept marriage, чтобы принять )).", PI[playerid][pNames]);
    SendClientMessage(params[0], COLOR_BLUE, stringer1);
    ProposeOffer[params[0]] = playerid;
    return 1;
}
cmd:witness(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 1879.8152,1170.2408,30.0091)) return SCM(playerid,0, "Вы не в церкви!");
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /witness [id]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Игрока не существует или это Вы");
    if (!ProxDetectorS(8.0, playerid, params[0])) return SCM(playerid,0, "Человек не рядом с Вами!");
    format(stringer1, sizeof(stringer1), "Вы преложили %s быть свидетелем на вашей свадьбе.", PI[params[0]][pNames]);
    SendClientMessage(playerid, COLOR_BLUE, stringer1);
    format(stringer1, sizeof(stringer1), "%s предлагает Вам быть свидетелем на его/её свадьбе.(( Введите /accept witness, чтобы принять )).", PI[playerid][pNames]);
    SendClientMessage(params[0], COLOR_BLUE, stringer1);
    MarryWitnessOffer[params[0]] = playerid;
    return 1;
}
cmd:take(playerid, params[])
{
    if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
    new memberrs = PI[playerid][pMember], rankk = PI[playerid][pRank], lead = PI[playerid][pLeader];
    if (memberrs == 1 && rankk >= 10 || lead == 1 || memberrs == 2 && rankk >= 3 || lead == 2 || memberrs == 10 && rankk >= 10 || lead == 10 || memberrs == 21 && rankk >= 10 || lead == 21 || memberrs == 25 && rankk >= 5 || lead == 25 || memberrs == 11 && rankk >= 4)
    {
        if(PlayerTied[playerid] > 0)  return SCM(playerid,0, "Вы связаны!");
        SPD(playerid, 7779, DIALOG_STYLE_LIST, "Отобрать лицензии:", "- Отобрать водительские права\n- Отобрать лицензию на полёты \n- Отобрать лицензию на рыболовлю\n- Отобрать лицензию на вождение водного транспорта\n- Отобрать лицензия на оружие\n- Наркотики\n- Оружие\n- Материалы", "Ок", "Отмена");
    }
    else return SCM(playerid,0, "Вы не можете использовать данную команду!");
    return 1;
}
cmd:home(playerid, params[])
{
    if(PI[playerid][pPhousekey] == 255) return 1;
    SetPlayerCheckpoint(playerid,HouseInfo[PI[playerid][pPhousekey]][hEntrancex], HouseInfo[PI[playerid][pPhousekey]][hEntrancey], HouseInfo[PI[playerid][pPhousekey]][hEntrancez], 4.0);
    SCM(playerid,0, "Ваш дом обозначен на карте красной меткой");
    gPlayerCheckpointStatus[playerid] = 12;
    PicCP[playerid] = 0;
    return 1;
}
cmd:frisk(playerid, params[])
{
    if(!IsACop(playerid)) return SCM(playerid,0, "Вы не член Полиции/ФБР/Армии!");
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /frisk [id]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Игрока не существует или это Вы");
    if(!ProxDetectorS(3.0, playerid, params[0])) return SCM(playerid,0, "Этого игрока рядом с вами нет ");
    new text1[20], text2[20];
    if(PI[params[0]][p_drugs][0] > 0 || PI[params[0]][p_drugs][1] > 0 || PI[params[0]][p_drugs][2] > 0 || PI[params[0]][p_drugs][3] > 0
            || PI[params[0]][p_drugs][4] > 0 || PI[params[0]][p_drugs][5] > 0 || PI[params[0]][p_drugs][6] > 0) text1 = "| Наркотики.";
    else text1 = "| Пустой карман.";
    if(PI[params[0]][pMats] > 0) { text2 = "| Материалы."; } else { text2 = "| Пустой карман."; }
    SendMes(playerid, COLOR_WHITE, ":::: Вещи %s ::::", PI[params[0]][pNames]);
    SendMes(playerid, COLOR_GREY, "%s.", text1);
    SendMes(playerid, COLOR_GREY, "%s.", text2);
    format(stringer1, sizeof(stringer1), "%s обыскал %s", PI[playerid][pNames] ,PI[params[0]][pNames]);
    ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
    return 1;
}
cmd:wanted(playerid, params[])
{
    if(!IsACop(playerid)) return SCM(playerid,0, "Вы не коп / ФСБ / Армия.");
    SCM(playerid,0, "Внимание, розыскиваются:");
    foreach(Player,i) if(PI[i][pWanted] > 0) SendMes(playerid, COLOR_WHITE, "Имя: {6495ED}%s {FFFFFF}ID: {6495ED}%d {FFFFFF}Уровень розыска: {6495ED}%d", PI[i][pNames],i,PI[i][pWanted]);
    return 1;
}
cmd:house(playerid, params[])
{
    if(PI[playerid][pAdmin] < 9) return 1;
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /house [номер дома]");
    if(params[0] < 0 || params[0] > 1999) return 1;
    SetPPos(playerid,HouseInfo[params[0]][hEntrancex],HouseInfo[params[0]][hEntrancey],HouseInfo[params[0]][hEntrancez]);
    GameTextForPlayer(playerid, "~w~HOUSE", 5000, 1);
    return 1;
}
cmd:padik(playerid, params[])
{
    if(PI[playerid][pAdmin] < 4) return 1;
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /padik [номер падика]");
    if(params[0] < 1 || params[0] > MAX_PODEZD) return 1;

    PI[playerid][PICKUP_TIME] = gettime() + 3;

	SetPPos ( playerid, pod_info [ params[0] ] [ pod_pos ] [ 0 ], pod_info [ params[0] ] [ pod_pos ] [ 1 ], pod_info [ params[0] ] [ pod_pos ] [ 2 ]) ;

    SetPlayerVirtualWorldEx(playerid, 0), SetPlayerInteriorEx(playerid, 0);

    GameTextForPlayer(playerid, "~w~PADIK", 5000, 1);
    return 1;
}
cmd:gethome(playerid, params[]) {
    if(!IsPlayerInRangeOfPoint(playerid, 20.0, 1495.3583,1306.8704,1093.2936)) return SCM(playerid,0, "Вы должны находится в риэлторском агенстве (/gps -> 1 -> 8)");
    if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, "Используйте: /gethome [id дома]");
    if(params[0] < 0 || params[0] > 1999) return SendClientMessage(playerid, -1, "Дом с таким ID не существует");
    if(HouseInfo[params[0]][hOwned] > 0) return SendClientMessage(playerid, -1, "Дом не продаётся");
    new string[144];
    format(string, sizeof(string), "{FFFFFF}Счет дома: %d$\nНеобходимо для проплаты за раз: %d$", HouseInfo[params[0]][hTakings], (HouseInfo[params[0]][hKlass] + 1) * 300);
    SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Информация о доме", string, "Закрыть", "");
    return 1;
}
cmd:biz(playerid, params[])
{
    if(PI[playerid][pAdmin] < 9) return 1;
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /biz [номер бизнеса]");
    if(params[0] < 1 || params[0] > TOTALBIZZ) return 1;
    SetPPos(playerid,BizzInfo[params[0]][bEntrx],BizzInfo[params[0]][bEntry],BizzInfo[params[0]][bEntrz]);
    GameTextForPlayer(playerid, "~w~BUSINES", 5000, 1);
    return 1;
}
cmd:chat(playerid, params[])
{
    if(PI[playerid][pAdmin] < 10) return 1;
    if (!BigEar[playerid]) BigEar[playerid] = 1,SendClientMessage(playerid, COLOR_GRAD2, "Слушать чат ON");
    else if (BigEar[playerid]) BigEar[playerid] = 0,SendClientMessage(playerid, COLOR_GRAD2, "Слушать чат OFF");
    return 1;
}
cmd:chatsms(playerid, params[])
{
    if(PI[playerid][pAdmin] < 10) return 1;
    if (!BigEarSms[playerid]) BigEarSms[playerid] = 1,SendClientMessage(playerid, COLOR_GRAD2, "Слушать смс чат ON");
    else if (BigEarSms[playerid]) BigEarSms[playerid] = 0,SendClientMessage(playerid, COLOR_GRAD2, "Слушать смс чат OFF");
    return 1;
}
cmd:iinvite(playerid, params[])
{
    if(PI[playerid][pOdet] == 0 || PI[playerid][pMember] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
    if(PI[playerid][pRank] < gFractionRank[PI[playerid][pMember]-1][0]) return SendMes(playerid, -1, "Доступно с %i ранга", gFractionRank[PI[playerid][pMember]-1][0]);
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /iinvite [id]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
    if(IsPlayerInAnyVehicle(params[0])) return SCM(playerid,0, "Игрок в машине.");
    if(!ProxDetectorS(10.0, playerid, params[0]) || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendClientMessage(playerid,COLOR_WHITE,"Вы далеко друг от друга");
    if(PI[params[0]][pLeader] != 0) return SCM(playerid,0, "Нельзя пригласить лидера.");
    switch(PI[playerid][pMember])
    {
    case 1, 10, 21: if(!IsAArm(params[0]) || PI[params[0]][pRank] < 3) return SCM(playerid,0, "Ранг игрока недостаточен для перевода");
    case 2: if((!IsAArm(params[0]) && !IsACop(params[0])) || PI[params[0]][pRank] < 5) return SCM(playerid,0, "Ранг игрока недостаточен для перевода");
    case 25: if((!IsAArm(params[0]) && !IsACop(params[0])) || PI[params[0]][pRank] < 4) return SCM(playerid,0, "Ранг игрока недостаточен для перевода");
    default: return SCM(playerid,0,"Вам не доступна данная функция.");
    }
    format(stringer1,sizeof(stringer1),"{FFFFFF}%s предлагает Вам вступить в организацию: {FF6F00}%s{FFFFFF}\n\nНажмите \"Да\" для согласия или \"Нет\" для отказа!",PI[playerid][pNames],GetPlayerFracName[PI[playerid][pMember]]);
    SPD(params[0], 76, DIALOG_STYLE_MSGBOX, "{FF6F00}Вступление во фракцию",stringer1,"Да","Нет");
    SendMes(playerid, -1, "Вы предложили {FF6F00}%s{FFFFFF} вступить в организацию {FF6F00}%s",PI[params[0]][pNames],GetPlayerFracName[PI[playerid][pMember]]);
    SetPVarInt(params[0],"Player",playerid);
    return 1;
}
cmd:invite(playerid, params[])
{
    if(PI[playerid][pMember] == 0) return 1;
    if(PI[playerid][pRank] < gFractionRank[PI[playerid][pMember]-1][0]) return SendMes(playerid, -1, "Доступно с %i ранга", gFractionRank[PI[playerid][pMember]-1][0]);
    switch(PI[playerid][pMember]) { case 1..4, 7, 10, 11, 19, 21, 25: if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!"); }
    if(sscanf(params,"d",params[0])) return SCM(playerid, 1, "Введите: /invite [id]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
    if(IsPlayerInAnyVehicle(params[0])) return SCM(playerid,0, "Игрок в машине.");
    if(PI[params[0]][pMember] > 0 || PI[params[0]][pLeader] > 0) return SendClientMessage(playerid, -1,"Игрок уже где то состоит");
    if(PI[params[0]][pWarns] >= 1) return SendClientMessage(playerid, -1,"У игрока есть предупреждение");
    if(!ProxDetectorS(10.0, playerid, params[0]) || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendClientMessage(playerid,COLOR_WHITE,"Вы далеко друг от друга");
    format(stringer1,sizeof(stringer1),"{FFFFFF}%s предлагает Вам вступить в организацию: {FF6F00}%s{FFFFFF}\n\nНажмите \"Да\" для согласия или \"Нет\" для отказа!",PI[playerid][pNames],GetPlayerFracName[PI[playerid][pMember]]);
    SPD(params[0], 76, DIALOG_STYLE_MSGBOX, "{FF6F00}Вступление во фракцию",stringer1,"Да","Нет");
    SendMes(playerid, -1, "Вы предложили {FF6F00}%s{FFFFFF} вступить в организацию {FF6F00}%s",PI[params[0]][pNames],GetPlayerFracName[PI[playerid][pMember]]);
    SetPVarInt(params[0],"Player",playerid);
    return 1;
}
cmd:demote(playerid, params[])
{
    if(PI[playerid][pMember] != 2) return SCM(playerid,0, YouCanNot);
    if(PI[playerid][pRank] < 7) return SCM(playerid,0, YouCanNot);
    if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /demote [id]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Игрока не существует или это Вы");
    switch(PI[params[0]][pMember])
    {
    case 2,4,5..9,11..18,23: return SCM(playerid,0, "Этот человек не состоит в армии/ПД!");
    }
    if(PI[params[0]][pMember] == 1 || PI[params[0]][pMember] == 3 || PI[params[0]][pMember] == 10 || PI[params[0]][pMember] == 19 || PI[params[0]][pMember] == 21 || PI[params[0]][pMember] == 25)
    {
        if(PI[params[0]][pLeader] != 0) return SCM(playerid,0, "Вы не можете уволить лидера!");
        if(PI[playerid][pLeader] != 2) { if(PI[params[0]][pRank] > 10) { return SCM(playerid,0, "У этого человека ранг больше 10!"); } }
        if(PI[params[0]][pRank] < 10 || PI[params[0]][pRank] > 1)
        {
            new rankdemote = PI[params[0]][pRank];
            rankdemote -= 1;
            if(rankdemote == 0)
            {
                if(PI[params[0]][pMember] == 1 || PI[params[0]][pMember] == 10 || PI[params[0]][pMember] == 21 || PI[params[0]][pMember] == 25)
                {
                    PI[params[0]][pMember] = 19;
                    PI[params[0]][pRank] = 3;
                    InviteSkin[params[0]] = 287;
                    ResetWeapons(params[0]);
                    format(stringer1, sizeof(stringer1), "Агент ФСБ %s перевел вас обратно в армию", PI[playerid][pNames]);
                    SendClientMessage(params[0], 0x6ab1ffaa, stringer1);
                    format(stringer1, sizeof(stringer1), "Вы перевели %s обратно в армию.", PI[params[0]][pNames],rankdemote);
                    SendClientMessage(playerid, 0x6ab1ffaa, stringer1);
                    SendClientMessage(params[0], 0xbc2c2caa, "Используйте клавишу 'Быстрый бег' (пробел по умолчанию)");
                    SendClientMessage(params[0], 0xbc2c2caa, "Используйте клавишу 'Вверх,вниз' (W,S по умолчанию)");
                    SendClientMessage(params[0], COLOR_GREY, "Если вы случайно нажали 'Enter' и меню пропало, нажмите 'Enter' еще раз");
                    SetPlayerInteriorEx(params[0],5);
                    SetPlayerVirtualWorldEx(params[0],1);
                    //ShowMenuForPlayer(ChoseSkin,params[0]);
                    new rand = random(sizeof(gInviteSpawns));
                    SetPPos(params[0], gInviteSpawns[rand][0], gInviteSpawns[rand][1], gInviteSpawns[rand][2]); // Warp the player
                    SetPlayerFacingAngle(params[0], gInviteSpawns[rand][3]);
                    SetPlayerCameraPos(params[0],gInviteSpawns[rand][0] + 3, gInviteSpawns[rand][1], gInviteSpawns[rand][2]);
                    SetPlayerCameraLookAt(params[0],gInviteSpawns[rand][0], gInviteSpawns[rand][1], gInviteSpawns[rand][2]);
                    TogglePlayerControllable(params[0], 0);
                    SelectChar[params[0]] = INVALID_PLAYER_ID;
                    PI[params[0]][pJob] = 0;
                    SelectCharID[params[0]] = PI[params[0]][pMember];
                    SelectCharPlace[params[0]] = 1;
                    PI[params[0]][pModel] = InviteSkin[params[0]];
                    SetPlayerSkinEx(params[0], InviteSkin[params[0]], true);
                    format(stringer1, sizeof(stringer1), "(Агент ФБР) %s[%d] перевел в армию игрока %s[%d].", PI[playerid][pNames], playerid,PI[params[0]][pNames], params[0]);
                    SendAdminMessage(COLOR_GREY,stringer1);
                    return 1;
                }
                PI[params[0]][pRank] = 0;
                PI[params[0]][pMember] = 0;
                PI[params[0]][pLeader] = 0;
                if(!PI[params[0]][pAdmin]) PI[params[0]][pVigs] = 0;
                SetPlayerArmour(params[0],0);
                SpawnPlayerEx(params[0]);
                ResetWeapons(params[0]);
                format(stringer1, sizeof(stringer1), "Агент ФСБ %s уволил вас из армии", PI[playerid][pNames]);
                SendClientMessage(params[0], 0x6ab1ffaa, stringer1);
                format(stringer1, sizeof(stringer1), "Вы снова гражданский", PI[playerid][pNames]);
                SendClientMessage(params[0], 0x6ab1ffaa, stringer1);
                format(stringer1, sizeof(stringer1), "Вы уволили %s из армии.", PI[params[0]][pNames]);
                SendClientMessage(playerid, 0x6ab1ffaa, stringer1);
                format(stringer1, sizeof(stringer1), "(Агент ФБР) %s[%d] уволил %s[%d].", PI[playerid][pNames], playerid,PI[params[0]][pNames], params[0], params[1]);
                SendAdminMessage(COLOR_GREY,stringer1);
                PI[params[0]][pOdet] = 0;
                format(stringer, sizeof(stringer), "UPDATE `"TABLE_ACCOUNT"` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `odet` = '0', `vigs` = '0' WHERE `pID` = '%d'",PI[params[0]][pID]);
                mysql_tquery(connects, stringer, "", "");
                return 1;
            }
            PI[params[0]][pRank] = rankdemote;
            format(stringer1, sizeof(stringer1), "Агент ФСБ %s понизил вас до %d ранга", PI[playerid][pNames], rankdemote);
            SendClientMessage(params[0], 0x6ab1ffaa, stringer1);
            format(stringer1, sizeof(stringer1), "Вы понизили %s до %d ранга.", PI[params[0]][pNames],rankdemote);
            SendClientMessage(playerid, 0x6ab1ffaa, stringer1);
        }
    }
    return 1;
}
cmd:toggotome(playerid, params[])
{
    if(PI[playerid][pAdmin] < 9) return 1;
    if (!toggotome[playerid]) toggotome[playerid] = 1, SendClientMessage(playerid, COLOR_BLUE, "[Система] Запрет на телепорт включен ");
    else if (toggotome[playerid]) toggotome[playerid] = 0, SendClientMessage(playerid, COLOR_BLUE, "[Система] Запрет на телепорт выключен ");
    return 1;
}
cmd:goto(playerid, params[])
{
    if(PI[playerid][pAdmin] < 2 || PI[playerid][pYtADM] <= 0) return true;
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /g(oto) [id игрока]");
	if(!strcmp(PI[params[0]][pNames], "Магомед")) return SCM(playerid,0, "Вы не можете телепортироваться к нему.");
    if(!IsPlayerConnected(params[0])) return SCM(playerid,0, "Игрока не существует");
    new Float:plocx,Float:plocy,Float:plocz;
    if(PI[params[0]][pInv] > 0 && !FD[playerid]) return SendClientMessage(playerid, COLOR_GRAD1, "У игрока куплена функция 'скрытность'!");
    if(toggotome[params[0]] == 1  && PI[playerid][pAdmin] != 12) return SendClientMessage(playerid,COLOR_RED,"Администратор запретил к нему телепортироваться!");
    if(GetPlayerState(params[0]) != 1 && GetPlayerState(params[0]) != 2 && GetPlayerState(params[0]) != 3) return SendClientMessage(playerid, COLOR_GRAD1, "Игрок не вступил в игру!");
    GetPlayerPos(params[0], plocx, plocy, plocz);
    if(GetPlayerState(playerid) == 2)
    {
        new tmpcar = GetPlayerVehicleID(playerid);
        SetVehiclePos(tmpcar, plocx, plocy+4, plocz);
    }
    else
    {
        SetPPos(playerid,plocx,plocy+2, plocz);
        SetPlayerVirtualWorldEx(playerid, GetPlayerVirtualWorld(params[0]));
        SetPlayerInteriorEx(playerid, GetPlayerInterior(params[0]));
    }
    SCM(playerid, 2, "Вы были телепортированы!");
    return 1;
}
cmd:gethere(playerid, params[])
{
    if(PI[playerid][pAdmin] < 2 || PI[playerid][pYtADM] <= 0) return 1;
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /gethere [id игрока]");
    if(!IsPlayerConnected(params[0])) return SCM(playerid,0, "Игрока не существует");
    new Float:plocx,Float:plocy,Float:plocz;
    new inter = GetPlayerInterior(playerid);
    new worldd = GetPlayerVirtualWorld(playerid);
    if(GetPlayerState(params[0]) != 1 && GetPlayerState(params[0]) != 2 && GetPlayerState(params[0]) != 3) return SendClientMessage(playerid, COLOR_GRAD1, "Игрок не вступил в игру!");
    if(PI[params[0]][pInv] > 0 && !FD[playerid]) return SendClientMessage(playerid, COLOR_GRAD1, "У игрока куплена функция 'скрытность'!");
    if(PI[playerid][pAdmin] < PI[params[0]][pAdmin])
    {
        SCM(playerid,0,"Нельзя телепортиповать администратора, который старше вас!");
        return 1;
    }
    if(PI[params[0]][AFK_Time] > 2) return SCM(playerid,0, "Игрок находится в AFK");
    GetPlayerPos(playerid, plocx, plocy, plocz);
    if(PI[playerid][pInt] > 0)
    {
        SetPlayerInteriorEx(params[0],inter);
        PI[params[0]][pLocal] = PI[playerid][pLocal];
        SetPlayerVirtualWorldEx(params[0],worldd);
    }
    if(PI[playerid][pInt] == 0)
    {
        SetPlayerInteriorEx(params[0], PI[playerid][pInt]);
        SetPlayerInteriorEx(params[0],inter);
        SetPlayerVirtualWorldEx(params[0],worldd);
    }
    if(plocz > 930.0 && PI[playerid][pInt] == 0) //the highest land point in sa = 526.8
    {
        SetPlayerInteriorEx(params[0],inter);
    }
    if (GetPlayerState(params[0]) == 2)
    {
        SetPlayerInteriorEx(params[0],inter);
        new tmpcar = GetPlayerVehicleID(params[0]);
        SetPlayerVirtualWorldEx(params[0],worldd);
        SetVehiclePos(tmpcar, plocx, plocy+4, plocz);
    }
    else
    {
        SetPPos(params[0],plocx,plocy+2, plocz);
        SetPlayerInteriorEx(params[0],inter);
        SetPlayerVirtualWorldEx(params[0],worldd);
    }
    format(stringer1, sizeof(stringer1), "%s[%d] телепортировал к себе %s[%d]",PI[playerid][pNames],playerid,PI[params[0]][pNames],params[0]);
    SendAdminMessage(COLOR_GREY,stringer1);
    SendMes(params[0], COLOR_WHITE, "Вы были телепортированы администратором %s[%d].", PI[playerid][pNames], playerid);
    return 1;
}
cmd:lights(playerid)
{
    if (GetPlayerVehicleID(playerid) == INVALID_VEHICLE_ID) return 1;
    if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;

    new vehicleid = GetPlayerVehicleID(playerid);
	new colorfar = GetOwnableCarData(vehicleid, OC_COLORFAR);

    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
    if (!lights)
    {
        SetVehicleParamsEx(vehicleid, engine, VEHICLE_PARAMS_ON, alarm, doors, bonnet, boot, objective);
        GameTextForPlayer(playerid, "~g~LIGHT ON", 2000, 4);
        if(colorfar == 1)
        {
            SetOwnableCarData(vehicleid, OC_COLORFAR, 1);
            SetHeadlightsColor(playerid, vehicleid, 0, 0, 255);
        }
        if(colorfar == 2)
        {
             SetOwnableCarData(vehicleid, OC_COLORFAR, 2);
            SetHeadlightsColor(playerid, vehicleid, 255, 0, 0);
        }

         if(colorfar == 3)
        {
              SetOwnableCarData(vehicleid, OC_COLORFAR, 3);
            SetHeadlightsColor(playerid, vehicleid, 0, 255, 0);
        }

         if(colorfar == 4)
        {
           SetOwnableCarData(vehicleid, OC_COLORFAR, 4);
            SetHeadlightsColor(playerid, vehicleid, 255, 255, 255);

        }
         if(colorfar == 5)
        {
           SetOwnableCarData(vehicleid, OC_COLORFAR, 5);
            SetHeadlightsColor(playerid, vehicleid, 252, 15, 192);

        }
         if(colorfar == 6)
        {
             SetOwnableCarData(vehicleid, OC_COLORFAR, 6);
            SetHeadlightsColor(playerid, vehicleid, 255, 255, 0);
        }

    }
    else
    {
        SetVehicleParamsEx(vehicleid, engine, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
        GameTextForPlayer(playerid, "~r~LIGHT OFF", 2000, 4);
    }

    return 1;
}




cmd:light(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 3.0,2143.0061,1620.307,1000.969))
    {
        new membersss = PI[playerid][pMember];
        if(membersss==5 || membersss==6 || membersss==12 || membersss==13 || membersss==14 || membersss==15
                || membersss==17 || membersss==18 || membersss==23 || membersss==26 || PI[playerid][pJob]==12)
        {
            if(lights1 == 1) return SCM(playerid, 0, "Электропитание уже отключено.");
            FIXES_ApplyAnimation(playerid,"OTB","betslp_lkabt",4.1,0,1,1,0,0);
            lights1 = 1;
            lighttime[playerid] = 300;
            format(stringer1, sizeof(stringer1), "Незнакомец отключает электропитание банка.");
            ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
            FIXES_ApplyAnimation(playerid,"OTB","betslp_lkabt",4.1,0,1,1,0,0);
            FIXES_ApplyAnimation(playerid,"OTB","betslp_lkabt",4.1,0,1,1,0,0);
        }
        else SCM(playerid, 0, "Вы не можете отключить электропитание");
    }
    else SCM(playerid, 0, "Вы не у блока электропитания.");
    return 1;
}
cmd:bankdoor(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 3.0,2144.178,1627.082,994.2620))
    {
        if(IsACop(playerid))
        {
            if(bankdoors == 1) return SCM(playerid, 0, "Банковская дверь уже открыта.");
            FIXES_ApplyAnimation(playerid,"OTB","betslp_lkabt",4.1,0,1,1,0,0);
            FIXES_ApplyAnimation(playerid,"OTB","betslp_lkabt",4.1,0,1,1,0,0);
            bankdoors = 1;
            bankdoortime[playerid] = 240;
            MoveObject (DoorOpen[0], 2146.0,1627.082,994.2620, 0.3);
        }
        else
        {
            if(lights1 == 0) return SCM(playerid, 0, "Для начала надо отключить электропитание.");
            if(bankdoors == 1) return SCM(playerid, 0, "Банковская дверь уже открыта.");
            FIXES_ApplyAnimation(playerid,"OTB","betslp_lkabt",4.1,0,1,1,0,0);
            bankdoors = 1;
            bankdoortime[playerid] = 120;
            FIXES_ApplyAnimation(playerid,"OTB","betslp_lkabt",4.1,0,1,1,0,0);
            SCM(playerid,0, "Дверь банковского сейфа открыта на 2 минуты, спешите!");
            MoveObject (DoorOpen[0], 2146.0,1627.082,994.2620, 0.3);
            format(stringer1, sizeof(stringer1), "Незнакомец открывает дверь банковского сейфа.");
            ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
        }
    }
    else SCM(playerid, 0, "Вы далеко от банковской двери");
    return 1;
}
cmd:tie(playerid, params[])
{
    if(!ISAMAFIA(playerid) && PI[playerid][pMember] != 23) return SCM(playerid,0, "Вам недоступна данная команда.");
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /tie [id игрока]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Игрока не существует или это Вы");
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid,0,"Вы не водитель!");
    if(PlayerTied[playerid] > 0)  return SCM(playerid,0, "Вы связаны!");
    if(PlayerTied[params[0]] > 0) return SCM(playerid,0, "Человек уже связан!");
    if(PI[playerid][pVerevka] <= 0) return SCM(playerid,0, "У тебя нет веревки, купи её в 24/7!");
    if (ProxDetectorS(8.0, playerid, params[0]))
    {
        new car = GetPlayerVehicleID(playerid);
        if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == 2 && IsPlayerInVehicle(params[0], car))
        {
            format(stringer1, sizeof(stringer1), "%s достал веревку и завязал %s на узел.", PI[playerid][pNames] ,PI[params[0]][pNames]);
            ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
            TogglePlayerControllable(params[0], 0);
            PI[playerid][pVerevka]--;
            PlayerTied[params[0]] = 1;
        }
        else return SCM(playerid,0, "Человек не в мащине!");
    }
    else return SCM(playerid,0, "Человек не рядом с вами!");
    return 1;
}
cmd:klyap(playerid, params[])
{
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /klyap [id игрока]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Игрока не существует или это Вы");
    if(PlayerTied[params[0]] == 0)  return SCM(playerid,0, "Игрок не связан!");
    if(PlayerTied[playerid] > 0)  return SCM(playerid,0, "Вы связаны");
    if(!ProxDetectorS(8.0, playerid, params[0])) return SCM(playerid,0, "Человек не рядом с вами!");
    if(gag[params[0]] > 0)
    {
        gag[params[0]] = 0;
        format(stringer1, sizeof(stringer1), "%s вытащил кляп у %s'a", PI[playerid][pNames] ,PI[params[0]][pNames]);
        ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
    }
    else
    {
        if(!ISAMAFIA(playerid) && PI[playerid][pMember] != 23) return SCM(playerid,0, "Вам недоступна данная команда.");
        gag[params[0]] = 1;
        TieTime[params[0]] = gettime() + 600;
        format(stringer1, sizeof(stringer1), "%s вставил кляп в рот %s'у", PI[playerid][pNames] ,PI[params[0]][pNames]);
        ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
        PI[playerid][TIE_TIMER] = SetTimerEx("tietimer",600000, false , "i" ,playerid);
    }
    return 1;
}
publics: tietimer(playerid)
{
    gag[playerid] = 0;
    SCM(playerid,0, "Кляп стал мокрым и выпал, вы снова можете говорить!");
    return KillTimer(PI[playerid][TIE_TIMER]);
}
cmd:klyapoff(playerid, params[])
{
    if(gag[playerid] == 1)
    {
        if(PlayerTied[playerid] > 0)  return SCM(playerid,0, "Вы связаны!");
        gag[playerid] = 0;
        format(stringer1, sizeof(stringer1), "%s выплевывает кляп из рта.", PI[playerid][pNames]);
        ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
    }
    else  return SCM(playerid,0, "У Вас нет кляпа");
    return 1;
}
cmd:untie(playerid, params[])
{
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /untie [id игрока]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Игрока не существует или это Вы");
    if(!ProxDetectorS(8.0, playerid, params[0])) return SCM(playerid,0, "Человек не рядом с вами!");
    if(PlayerTied[playerid] > 0)  return SCM(playerid,0, "Вы связаны!");
    if(PlayerTied[params[0]] == 0)  return SCM(playerid,0, "Игрок не связан!");
    if(PlayerTied[params[0]])
    {
        format(stringer1, sizeof(stringer1), "%s развязал %s", PI[playerid][pNames] ,PI[params[0]][pNames]);
        ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
        TogglePlayerControllable(params[0], 1);
        PI[playerid][pVerevka]++;
        PlayerTied[params[0]] = 0;

    }
    else return SCM(playerid,0, "Этот человек не связан!");
    return 1;
}

CMD:breakcar(playerid)
{
    if(GetPVarInt(playerid,"AntiFloodJack") > gettime()) return SCM(playerid,0, "Подождите 1 минуту, прежде чем пытаться взломать автомобиль снова.");
	if(GetPVarInt(playerid, "JackCar_use") == 1) return SCM(playerid,0, "Вы уже взламываете транспорт!");
    if(!PI[playerid][pOtmbI4ka]) return SendClientMessage(playerid, COLOR_GRAD1, "У вас нет отмычек!");
    if(IsPlayerInAnyVehicle(playerid)) return SCM(playerid,0, "Нельзя использовать в машине!");
    new tacha = GetNearestVehicle(playerid);
    if(tacha == -1) return SCM(playerid,0, "Необходимо находится возле машины!");
	new Float:X,Float:Y,Float:Z;
	GetVehiclePos(tacha, X, Y, Z);
	if(!IsPlayerInRangeOfPoint(playerid, 2.0, X, Y, Z)) return SCM(playerid,0, "Необходимо неходится возле машины!");
	if(tacha != PI[playerid][pUgonVehicle]) return SCM(playerid,0, "Вы не можете взломать чужой транспорт!");
	if(PlayerTied[playerid] || PlayerCuffed[playerid]) return SCM(playerid,0, "Вы не можете двигаться!");
	PI[playerid][pOtmbI4ka]--;

	new Random_1 = RandomEx(2, 5),
		Random_2 = RandomEx(6, 10);

	SetPVarInt(playerid, "random_code", Random_1 * Random_2);

	new scm_string[160];
	format(scm_string, sizeof(scm_string), "{ffffff}Защита транспорта требует код-пароль для взлома.\n{32CD32}Напишите, сколько будет: {B22222}%d умножить на %d?\n{cccccc}(У вас 1 попытка).", Random_1, Random_2);
	SPD(playerid, 6975, DIALOG_STYLE_INPUT, ""SERVER"Спутниковая сигнализация", scm_string, "Далее", "Отмена");

 	/*timer_jack[playerid] = SetTimerEx("JackCar", 5000, 0, "dd", playerid, tacha);
	TogglePlayerControllable(playerid, false);
	FIXES_ApplyAnimation(playerid,"ROB_BANK","CAT_Safe_Rob",4.1, 0, 1, 1, 1, 0, 1);
	SetPVarInt(playerid, "JackCar_use", 1);

	stringer1[0] = EOS;
	format(stringer1, 90, "%s взламывает автомобиль", PI[playerid][pNames]);
	ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);*/

	return 1;
}

publics: JackCar(playerid, vehicleid)
{
	if(PI[playerid][pUgonTimer] > 0)
	{
		stringer1[0] = EOS;
		format(stringer1, 90, "%s дверь автомобиля взломана {33aa33}| Удачно",PI[playerid][pNames]);
		ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);

	    SetVehicleParam(vehicleid, V_LOCK, 0);
	    GameTextForPlayer(playerid, "~w~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~CAR~g~ UNLOCKED", 3000, 3);

	    SetPVarInt(playerid, "AntiFloodJack", gettime() + 60);
		ClearAnimations(playerid);
	    TogglePlayerControllable(playerid, true);
	    KillTimer(timer_jack[playerid]);
	    DeletePVar(playerid, "JackCar_use");

		SetPlayerCheckpoint(playerid, 2568.9939,-1892.1960,21.9077,8);

		stringer1[0] = EOS;
		format(stringer1, sizeof(stringer1), "[SMS от Володи]: Всё идёт по плану! Координаты места сбыта отправил на твой радар. Отправитель: Володя.");
		SendClientMessage(playerid, COLOR_YELLOW, stringer1);

	    return SCM(playerid,0, "{33aa33}Вы успешно взломали автомобиль. Угоните его и сдайте в место сбыта {afafaf}[/dropcar]");
	}
	return 1;
}

CMD:dropcar(playerid)
{
	if(PI[playerid][pUgonTimer] > 0)
	{
		SetPlayerCheckpoint(playerid,2568.9939,-1892.1960,21.9077,8);
		SCM(playerid,0, "{33aa33}Место сдачи транспорта отмечено на карте.");
	}
	else return 1;
    return true;
}

cmd:present(playerid,params[])
{
    if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /present [id]");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SCM(playerid,0, "Этого игрока нет, или вы указали свой ид");
    if(!ProxDetectorS(5.0, playerid, params[0])) return SCM(playerid,0, "Этого игрока рядом с вами нет!");
    if(GetPlayerWeapon(playerid) != 14) return SCM(playerid,0, "У тебя в руках должен быть цветы");
    ApplyAnimation(playerid,"Kissing","gift_give",4.0,0,0,0,0,0,1);
    GiveWeapon(params[0], 14, 1);
    PI[playerid][Weapon][10] = 0;
    PI[playerid][Ammo][10] = 0;
    ResetPlayerWeapons(playerid);
    SetPlayerWeaponss(playerid);
    format(stringer1, sizeof(stringer1), "%s подарил(а) %s цветы",PI[playerid][pNames],PI[params[0]][pNames]);
    ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
    return 1;
}
cmd:spy(playerid)
{
    if(PI[playerid][pOdet] == 0 && PI[playerid][pMember] == 2) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
    if((PI[playerid][pMember] != 2 || PI[playerid][pRank] < 3) && PI[playerid][pMember] != 23) return SendClientMessage(playerid, COLOR_GRAD1, "Вам не доступна данная команда!");
    if(GetPVarInt(playerid,"mask"))
    {
        SetPlayerSkinEx(playerid,PI[playerid][pModel]);
        SetPlayerToTeamColor(playerid);
        DeletePVar(playerid,"mask");
        return 1;
    }
    stringer[0] = 0;
    for(new i = 1; i < 29; i ++) format(stringer, sizeof(stringer), "%s%s\n", stringer, GetPlayerFracName[i]);
    SPD(playerid, 4819, DIALOG_STYLE_LIST, "Выберите фракцию", stringer, "Выбрать", "Закрыть");
    return 1;
}
cmd:block(playerid, params[])
{
    if(PI[playerid][pMember] == 1 && PI[playerid][pRank] >= 5 || PI[playerid][pMember] == 10 && PI[playerid][pRank] >= 5 || PI[playerid][pMember] == 21 && PI[playerid][pRank] >= 5
            || PI[playerid][pMember] == 2 && PI[playerid][pRank] >= 3)
    {
        if(PI[playerid][pOdet] == 0) return SendClientMessage(playerid,COLOR_WHITE,"Вы не на службе!");
        if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, -1, "Данную команду нельзя использовать в интерьере.");
        if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "нельзя использовать в машине.");
        if(spike_objects[playerid] == 0)
        {
            new Float:x, Float:y, Float:z, Float:a;
            GetPlayerPos(playerid, x, y, z);
            GetPlayerFacingAngle(playerid, a);
            //spike_objects[playerid] = CreateDynamicObject(2899, x, y, z-0.8, 0, 0, a);
            spike_areas[playerid] = CreateDynamicSphere(x, y, z, 3.0, -1, -1, -1);
            FIXES_ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 1, 1, 1, 1);
            SetTimerEx("ClearPlayerChatAnim", 300, false, "i", playerid);
            SendClientMessage(playerid, 0x0bda51FF, "Вы установили шипы с дистанционным управлением.");
            return SendClientMessage(playerid, 0x0bda51FF, "Используйте команду {007fff}/block{0bda51}, чтобы дезактивировать их.");
        }
        else
        {
            DestroyDynamicObject(spike_objects[playerid]);
            DestroyDynamicArea(spike_areas[playerid]);
            spike_objects[playerid] = 0;
            spike_areas[playerid] = 0;
            return SCM(playerid,0, "Шипы дезактивированы.");
        }
    }
    else return SendClientMessage(playerid, -1, "Вам недоступна данная команда");
}
cmd:robbank(playerid, params[])
{
    if(PI[playerid][pRobTime] == 0)
    {
        if(kazna < 500000) return SCM(playerid, 0, "Казна штата слишком мала, чтобы её грабить.");
        if(IsPlayerInRangeOfPoint(playerid, 2.0,2147.2971,1637.2709,993.5759))
        {
            new membersss = PI[playerid][pMember];
            if(membersss==5 || membersss==6 || membersss==12 || membersss==13 || membersss==14 || membersss==15 || membersss==17 || membersss==18)
            {
                if(IsACop(playerid)) return SCM(playerid, 0, "Вы коп! Вам нельзя взламывать банковский сейф.");
                if(robbanks == 1) return SCM(playerid, 0, "Банковский сейф, уже взламывают.");
                TogglePlayerControllable(playerid, 0);
                FIXES_ApplyAnimation(playerid,"ROB_BANK","CAT_Safe_Rob",4.1,1,1,1,0,0);
                robbanks = 1; robbankstime[playerid] = 10;
                FIXES_ApplyAnimation(playerid,"ROB_BANK","CAT_Safe_Rob",4.1,1,1,1,0,0);
                format(stringer1, sizeof(stringer1), "Незнакомец пытается взломать банковский сейф.");
                ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
            }
            else SCM(playerid,0, "Вам не доступна данная функция.");
        }
        else SCM(playerid, 0, "Вы не у банковского сейфа.");
    }
    else SCM(playerid, 0, "Грабить банк можно раз в 3 часа.");
    return 1;
}
cmd:weather(playerid, params[])
{
    if(FD[playerid]) {
        if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /weather [id погоды]");
        if(params[0] < 0 || params[0] > 45) return SCM(playerid,0, "ID Погоды не может быть меньше 0 и больше 45!");
        SetWeather(params[0]);
        format(stringer1, sizeof(stringer1), "%s сменил погоду", PI[playerid][pNames]);
        SendAdminMessage(COLOR_GREY,stringer1);
    }
    return 1;
}
cmd:agm(playerid)
{
    if(PI[playerid][pAdmin] < 1) return 1;
    if(!PI[playerid][pGM]) PI[playerid][pGM] = 1,SetPlayerHealth(playerid, 10000000);
    else PI[playerid][pGM] = 0, SetPlayerHealth(playerid, 100);
    SendMes(playerid, COLOR_WHITE, "Вы %s {FFFFFF}режим бессмертия.", PI[playerid][pGM] ? ("{32CD32}включили") : ("{FF4500}выключили"));
    return 1;
}
cmd:id(playerid, params[])
{
    if(isnull(params)) return SCM(playerid, 1, "Введите: /id [id/часть ника]");
    new ids = strval(params);
    SendClientMessage(playerid,COLOR_YELLOW,"Игроки онлайн:");
    new idd=-1;
    if(!IsNumericc(params))
    {
        foreach(new i:Player)
        {
            if(strfind(PI[i][pNames],params,true) != -1)
            {
                if(idd >= 9) {
                    idd++;
                    continue;
                }
                if(PI[i][AFK_Time] > 2) format(stringer1,sizeof(stringer1),"%s {66CC66}id %d {FF4500}AFK",PI[i][pNames],i);
                else format(stringer1,sizeof(stringer1),"%s {66CC66}id %d",PI[i][pNames],i);
                SendClientMessage(playerid,COLOR_WHITE,stringer1);
                idd++;
            }
        }
        if(idd == -1) return SCM(playerid,0,"Не найдено");
        else if(idd >= 9) {
            format(stringer1,sizeof(stringer1),"Показано 10 найденных из %d", idd-2);
            SCM(playerid,0, stringer1);
        }
    }
    else
    {
        if(!IsPlayerConnected(ids)) return SCM(playerid,0,"Не верный ID");
        if(PI[ids][AFK_Time] > 2) format(stringer1,sizeof(stringer1),"%s {66CC66}id %d {FF4500}AFK",PI[ids][pNames],ids);
        else format(stringer1,sizeof(stringer1),"%s {66CC66}id %d",PI[ids][pNames],ids);
        SendClientMessage(playerid,COLOR_WHITE,stringer1);
    }
    return 1;
}
cmd:fare(playerid, params[])
{
    new randomrub;
    new Veh = GetPlayerVehicleID(playerid);
    if(PI[playerid][pJob] == 4)
    {
        if(TransportDuty[playerid] > 0)
        {
            if(TransportDuty[playerid] == 1)
            {
                TaxiDrivers -= 1;
            }
            new moneyyys = 32 + random(2);
            Delete3DTextLabel(taxi3d[Veh]);
            TransportDuty[playerid] = 0;
            SendMes(playerid, 0x6495EDFF, "Вы закончили рабочий день, ваш бонус: %d", moneyyys);
            PI[playerid][pRub] += randomrub;
            TransportValue[playerid] = 0; TransportMoney[playerid] = 0;
            return 1;
        }
        if(GetVehicleData(Veh, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_TAXI)
        {
            if(GetPlayerState(playerid) == 2)
            {
                if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /fare [Тариф]");
                if(params[0] < 1 || params[0] > 10000) return SCM(playerid,0, "Не меньше 1 и не больше $10000");
                TaxiDrivers += 1;
                TransportDuty[playerid] = 1;
                TransportValue[playerid] = params[0];

                format(stringer1, sizeof(stringer1), "{3399ff}Такси\n{66CC33}Тариф: %d$", TransportValue[playerid]);
                taxi3d[Veh] = Create3DTextLabel(stringer1, COLOR_YELLOW, 9999.0, 9999.0, 9999.0, 30.0, 0, 1);
                Attach3DTextLabelToVehicle(taxi3d[Veh], Veh, 0, 0, 1.5);

            }
            else return SCM(playerid,0, "{F36223}[!]{ADAEAD}Вы не таксист или вы не в машине.");
        }
        else return SCM(playerid,0, "{F36223}[!]{ADAEAD}Вы не начали рабочий день");
    }
    else return SCM(playerid,0, "{F36223}[!]{ADAEAD}Вы не таксист или вы не в машине.");
    return 1;
}
cmd:carmat(playerid, params[])
{
    switch(PI[playerid][pMember])
