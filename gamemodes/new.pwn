    "SERVER"10. {FFFFFF}Бинд чата - B10\t /b10\n\
    "SERVER"11. {FFFFFF}Бинд чата - B11\t /b11\n\
    "SERVER"12. {FFFFFF}Бинд чата - B12\t /b12\n\
    "SERVER"13. {FFFFFF}Бинд чата - B13\t /b13\n\
