public OnPlayerConnect(playerid)
{
	/*drifting = CreatePlayerTextDraw(playerid, 320.0, 320.0, "~y~Points:");
	PlayerTextDrawAlignment(playerid, drifting, 2);
	PlayerTextDrawBackgroundColor(playerid, drifting, 77);
	PlayerTextDrawFont(playerid, drifting, 1);
	PlayerTextDrawLetterSize(playerid, drifting, 0.66, 1.7);
	PlayerTextDrawColor(playerid, drifting, 99);
	PlayerTextDrawSetOutline(playerid, drifting, 1);
	PlayerTextDrawSetProportional(playerid, drifting, 1);
	PlayerTextDrawUseBox(playerid, drifting, 0);
	PlayerTextDrawTextSize(playerid, drifting, 19.0, -210.0);
*/

    playerCheckpointLes[playerid] = -1;
    PI[playerid][car_audio] = 0;

    CreateTextDraw(playerid);

	if(Iter_Count(Player) > ronline_server) ronline_server = Iter_Count(Player);

	AdminGuard[playerid] = typeSpawn[playerid] = 0;

    FD[playerid] = false;

    OwnableCarsLoaded[playerid] = 0;
SetPVarInt(playerid, "lesoryb_work", 0);
	SetPVarInt(playerid, "work_eda_house", 0);
	SetPVarInt(playerid, "work_eda", -1);
    SetPVarInt(playerid,"AutoShop",-1);

    // NEW ANTICHEAT

    //  for(new i = 0; i < AC_MAX_CODES; i++)
    //    pAntiCheatLastCodeTriggerTime[playerid][i] = -1;

    // pAntiCheatSettingsPage{playerid} = 0; // Присваиваем значение 0 переменной, хранящей номер страницы настроек анти-чита, на которой находится игрок
    //   pAntiCheatSettingsEditCodeId[playerid] = -1; // Присваиваем переменной, хранящей идентификатор (ID) кода анти-чита, который редактирует игрок, занчение -1

    PI[playerid] = NULL_PI;

    new buffer[40+1];
    gpci(playerid, buffer);
    GetPlayerName(playerid, PI[playerid][pNames], 24);
    player_family [ playerid ] = 0;

    PI[playerid][pFamilyText] = Text3D:INVALID_3DTEXT_ID;
    PI[playerid][pPremiumText] = Text3D:INVALID_3DTEXT_ID;

	if( GetServerVarAsInt("port") == 1505 )
	{
		if(!strcmp(PI[playerid][pNames], "Nick_Name"))
		{
			SCM(playerid, 0, "Смените никнейм в настройках лаунчера. (Пример: Ivan_Ivanov)");
			SPD(playerid, 0000, 0, ""SERVER"Смените никнейм", ""SERVER"Смените никнейм в настройках лаунчера. (Пример: Ivan_Ivanov)", "Закрыть", "");
			return KickEx(playerid);
		}
	}
	else if( GetServerVarAsInt("port") == 7777 )
	{
		if(!strcmp(PI[playerid][pNames], "Black_Bonus"))
		{
			SCM(playerid, 0, "Смените никнейм в настройках лаунчера. (Пример: Ivan_Ivanov)");
			SPD(playerid, 0000, 0, ""SERVER"Смените никнейм", ""SERVER"Смените никнейм в настройках лаунчера. (Пример: Ivan_Ivanov)", "Закрыть", "");
			return KickEx(playerid);
		}
	}
	else if( GetServerVarAsInt("port") == 7778 || GetServerVarAsInt("port") == 1505 )
	{
		if(!strcmp(PI[playerid][pNames], "Sueta_Rp"))
		{
			SCM(playerid, 0, "Смените никнейм в настройках лаунчера. (Пример: Ivan_Ivanov)");
			SPD(playerid, 0000, 0, ""SERVER"Смените никнейм", ""SERVER"Смените никнейм в настройках лаунчера. (Пример: Ivan_Ivanov)", "Закрыть", "");
			return KickEx(playerid);
		}
	}

    // printf("name %s gpci %s", PI[playerid][pNames], buffer);

    PI[playerid][P_PLAYER_DEVICE] =
    PlayerReportFix[playerid] = 0;

    casino[playerid][d_nextPlayer] = INVALID_PLAYER_ID;

    switch_fp[playerid] = false;

 /*   if(strcmp(buffer, "3952314F524834355456464955525858554F3353") && !FD[playerid] && allow_pc == false)
    {
        KickEx(playerid);
        return SCM(playerid,0, "Вы не можете играть с ПК на нашем сервере.");
    }*/

    SetPlayerData(playerid, P_OWNABLE_CAR, INVALID_VEHICLE_ID);

    gIsRequestClassCalled{playerid} = false;
    if(!strcmp(buffer, "44355A5834564C393054584655524D4F52584B41"))
    {
        KickEx(playerid);
        return 1;
    }

    PI[playerid][pClist] =
    PlayerPPKFix[playerid] =
    SpawnReset[playerid] = 0;

    KillTimer(PI[playerid][P_CLIST_TIMER]);


