}

cmd:mydon(playerid)
{
    SendMes(playerid,COLOR_WHITE,"[Донат-Монеты] У Вас всего {FF4500}%i Донат-Монет{FFFFFF} | Приятной игры =)",PI[playerid][pDonatemoney2]);
    SendMes(playerid,COLOR_WHITE,"[Информация] Чтобы пополнить свой счет вам нужно перейти на сайт во вкладку 'Донат' | "SITE_NAME"",PI[playerid][pDonateRubNew]);
    return 1;
