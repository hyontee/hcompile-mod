cmd:unban(playerid, params[])
{
    if(PI[playerid][pAdmin] < 9) return 1;
    if(PI[playerid][pcBan] < 1) return SCM(playerid, 0, "У Вас нет доступа к этой команде. Вы можете купить его, используйте /adonate");
    if(PI[playerid][pVigs] > 1) return SendClientMessage(playerid, 0xFF6600AA, "{FF6600}На вашем аккаунте выговор, некоторые команды были заблокированы. Снимите выговор — {FFFFFF}/adonate, {FF6600}чтобы снять блокировку команд.");
    if(sscanf(params, "s[24]",params[0])) return SCM(playerid, 1, "Введите: /unban [ник]");
    mysql_format(connects, mysql_query_, sizeof(mysql_query_), "SELECT 1 FROM `"TABLE_BANLOG"` WHERE `name` = '%e'", params[0]);
    mysql_tquery(connects, mysql_query_, "UnBan", "dsd", playerid, params[0], 0);
    return 1;
}
cmd:givedonate(playerid, params[])
{
    if(CheckFullDostup(playerid))
	{

        new donatenick[MAX_PLAYER_NAME], donate[11];
        if(sscanf(params, "s[24]d",donatenick, donate)) return SCM(playerid, 1, "Введите: /givedonate [ник] [кол-во очков]");
        mysql_format(connects, mysql_query_,sizeof(mysql_query_), "SELECT `pRub` FROM `"TABLE_ACCOUNT"` WHERE Name = '%e'", donatenick);
        mysql_tquery(connects, mysql_query_, "Givedonate", "dsd", playerid,donatenick,donate);
    }
    return 1;
}

cmd:givepremium(playerid, params[])
{
	if(!CheckFullDostup(playerid)) return 1;

	if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /givepremium [playerid]");

	if(PI[params[0]][pPremium])
		return SCM(playerid, 0, "У игрока уже есть Premium статус!");

	if(GetPlayerVirtualWorld(params[0]) || GetPlayerInterior(params[0]))
		return SCM(playerid, 0, "Игрок должен находиться вне интерьера!");

	SCM(playerid, 2, "Статус выдан!");

	SCM(params[0], 2, "Вам выдан Premium статус!");
	SCM(params[0], 1, "Подробный список возможностей можно узнать в меню доната "SERVER"/donate > Дополнительные возможности");

	PI[params[0]][pPremium] = 1;
	UpdatePlayerData(params[0], "pPremium", PI[params[0]][pPremium]);

	PI[playerid][P_CAR_SLOT] += 2;
	UpdatePlayerData(params[0], "car_slot", PI[params[0]][P_CAR_SLOT]);

	new Float:cx, Float:cy, Float:cz, Float:ca;
	GetPlayerPos(params[0], cx, cy, cz);
	GetPlayerFacingAngle(params[0], ca);

	format
	(
	stringer, sizeof stringer,
	"INSERT INTO ownable_cars \
		(owner_id,model_id,color_1,color_2,pos_x,pos_y,pos_z,angle,create_time) \
		VALUES \
		('%d','576','%d','%d','%f','%f','%f','%f','%d')",
	PI[params[0]][pID],
	random(100),
	random(100),
	cx,
	cy,
	cz,
	ca,
	gettime()
	);
	mysql_tquery(connects, stringer);

	PI[params[0]][pPremiumText] = CreateDynamic3DTextLabel( "PREMIUM {FFFFFF}Игрок", 0xbe2d2dFF, 0.0, 0.0, 0.0, 12.0, params[0], INVALID_VEHICLE_ID, 1);

	Iter_Add(PremiumPlayers, params[0]);

	SCM(params[0], 1, "Для того чтобы посмотреть список доступных возможностей используйте - "SERVER"/vhelp");
    return true;
}

cmd:gmx(playerid, params[]) {

	if(CheckFullDostup(playerid)) {
        if(sscanf(params, "d", params[0])) return SCM(playerid, 1, "Введите: /gmx [время до рестарта (в секундах)]");

        if(!params[0] && gmxtime) {
            gmxtime = 0;

            SendClientMessageToAll(COLOR_LIGHTRED, "Внимание! Внеплановая перезагрузка сервера отменена.");
            return false;
        }

        if(params[0] < 15 || params[0] > 18000)
            return SCM(playerid, 0, "Время до рестарта должно быть от 15 до 18000 секунд. (0 отключить рестарт)");
        
        gmxtime = params[0]+1;

        new string[144];
        format(string, sizeof(string), "Внимание! Через %d секунд будет внеплановая перезагрузка сервера.", params[0]);
        SendClientMessageToAll(COLOR_LIGHTRED, string);
    }
    return 1;
}

cmd:createpromo(playerid, params[]) {
    if(CheckFullDostup(playerid))
	{

        new promoname[64];
        if(sscanf(params, "sddddd", promoname, params[1], params[2], params[3], params[4], params[5]))
            return SCM(playerid, 1, "Введите: /createpromo [имя промокода] [донат-очки] [донат-рубли] [скин id] [сколько отыграть часов] [машина id]");

        mysql_format(connects, mysql_query_, sizeof(mysql_query_),
            "INSERT INTO `promocode_list` (`name`, `donate`, `rub`, `skin`, `hours`, `vehicle`) VALUES ('%e', '%d', '%d', '%d', '%d', '%d')",
            promoname, params[1], params[2], params[3], params[4], params[5]);

        mysql_tquery(connects, mysql_query_);

        new string[128];
        format(string, sizeof(string), "Вы создали промокод %s", promoname);
        SCM(playerid, 2, string);

        format(string, sizeof(string), "Донат-очки %d | Донат-рубли %d | Скин id %d | Отыграть %d часов | Машина id %d", 
            params[1], params[2], params[3], params[4], params[5]);

        SendClientMessage(playerid, -1, string);
    }
    return true;
}
CMD:auction(playerid, params[])
{
    new type[8], itemid, startprice;
    if(sscanf(params, "s[8]dd", type, itemid, startprice)) return SCM(playerid, -1, "Используйте: /auction [house/bizz/car] [ID] [начальная цена]");
    if(startprice < 1000) return SCM(playerid, -1, "Минимальная цена — 1000 руб.");

    new itemType;
    if(strcmp(type, "house", true) == 0) itemType = 1;
    else if(strcmp(type, "bizz", true) == 0) itemType = 2;
    else if(strcmp(type, "car", true) == 0) itemType = 3;
    else return SCM(playerid, -1, "Тип может быть только: house, bizz, car");

    if(itemType == 1 && PI[playerid][pPhousekey] != itemid) return SCM(playerid, -1, "У вас нет этого дома.");
    if(itemType == 2 && GetPlayerBizz(playerid) != itemid) return SCM(playerid, -1, "У вас нет этого бизнеса.");
    if(itemType == 3)
    {
        new vehicleid = GetPlayerOwnableCar(playerid);
        if(vehicleid == INVALID_VEHICLE_ID || GetVehicleData(vehicleid, V_ACTION_ID) != itemid) return SCM(playerid, -1, "У вас нет этого авто.");
    }

    for(new i = 0; i < MAX_AUCTIONS; i++)
    {
        if(!Auction[i][aActive])
        {
            Auction[i][aActive] = true;
            Auction[i][aType] = itemType;
            Auction[i][aItemID] = itemid;
            Auction[i][aOwner] = playerid;
            Auction[i][aStartPrice] = startprice;
            Auction[i][aCurrentBid] = startprice;
            Auction[i][aCurrentBidder] = INVALID_PLAYER_ID;
            Auction[i][aEndTime] = gettime() + 43200;

            new msg[128];
            format(msg, sizeof(msg), "%s[%d] выставил на аукцион %s ID %d за %d руб.", PI[playerid][pNames], playerid, type, itemid, startprice);
            SendClientMessageToAll(COLOR_YELLOW, msg);
            return SCM(playerid, -1, "Вы успешно выставили лот на аукцион на 12 часов.");
        }
    }
    return SCM(playerid, -1, "Слишком много активных аукционов.");
}

CMD:auctions(playerid, params[])
{
    new dialog[2048];
    new count = 0;

    for(new i = 0; i < MAX_AUCTIONS; i++)
    {
        if(Auction[i][aActive])
        {
            new typename[16];
            switch(Auction[i][aType])
            {
                case 1: typename = "Дом";
                case 2: typename = "Бизнес";
                case 3: typename = "Авто";
            }

            new timeLeft = Auction[i][aEndTime] - gettime();
            new hours = timeLeft / 3600;
            new minutes = (timeLeft % 3600) / 60;

            format(dialog, sizeof(dialog), "%s%s ID: %d | Ставка: %d руб. | Осталось: %02d:%02d\n",
                dialog, typename, Auction[i][aItemID], Auction[i][aCurrentBid], hours, minutes);
            count++;
        }
    }

    if(count == 0) return SCM(playerid, -1, "Нет активных аукционов.");
    ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_LIST, "?? Активные аукционы", dialog, "Выбрать", "Закрыть");
    return 1;
}
