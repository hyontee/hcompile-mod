CMD:setbankomat(playerid, params[])
{
    new idx = random(sizeof(g_DeliveryPointsInkos));

    // Сохраняем текущий чекпоинт в переменную
    SavedCheckpointInkos[0] = g_DeliveryPointsInkos[idx][0];
    SavedCheckpointInkos[1] = g_DeliveryPointsInkos[idx][1];
    SavedCheckpointInkos[2] = g_DeliveryPointsInkos[idx][2];

    DisablePlayerCheckpoint(playerid);
    SetPlayerCheckpoint(playerid,
        g_DeliveryPointsInkos[idx][0],
        g_DeliveryPointsInkos[idx][1],
        g_DeliveryPointsInkos[idx][2],
        5.0);

    g_PlayerCheckpointStageInkos[playerid] = 1 + idx;

    printf("[BANKOMAT] Player %d > Set CP to idx %d: %f, %f, %f",
        playerid, idx,
        g_DeliveryPointsInkos[idx][0],
        g_DeliveryPointsInkos[idx][1],
        g_DeliveryPointsInkos[idx][2]);

    ShowNotification(playerid, 1, "Чекпоинт к банкомату установлён, направляйтесь туда!", 4, "", "");
    return 1;
}
