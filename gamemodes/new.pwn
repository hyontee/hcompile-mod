	"SERVER"2. {FFFFFF}Биндер для чата\n\
	","Выбрать","Отмена"); 	
}

stock load_binder_player(playerid)
{
    new mysql_string[256];
	format(mysql_string, sizeof(mysql_string), "SELECT * FROM `player_binder` WHERE `userid` = '%i'", PI[playerid][pID]);
	new Cache: result = mysql_query(connects, mysql_string);

    new rows = cache_num_rows();

	if(rows) 
	{
        cache_get_field_content(0, "command1", PI[playerid][pBinderCommand_1], connects, 144);
