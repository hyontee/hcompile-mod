alias:animlist("anim");
CMD:animlist(playerid, params[]) {
	new animid;
	if (sscanf(params, "i", animid) || !(1 <= animid <= sizeof (animationList))) {
		ShowAnimlistMenu(playerid);
	}
	else {
		if (!ApplyAnimlistID(playerid, (animid - 1))) ShowAnimlistMenu(playerid);
	}
	return true;
}

stock ShowAnimlistMenu(playerid, category = 0) {
	stringer[0] = EOS;

	switch (category) {
		case 0: {
			new amount[ANIM_TYPE_SIZEOF];
			for (new i = 0, type; i < sizeof (animationList); i++) {
				type = animationList[i][anim_type];
				amount[type]++;
			}
			format(stringer, sizeof (stringer), "\
				"SERVER"1. {FFFFFF}Танцы {afafaf}[%i шт.]\n\
				"SERVER"2. {FFFFFF}Сесть {afafaf}[%i шт.]\n\
				"SERVER"3. {FFFFFF}Лечь {afafaf}[%i шт.]\n\
				"SERVER"4. {FFFFFF}Жесты {afafaf}[%i шт.]\n\
				"SERVER"5. {FFFFFF}Разговор {afafaf}[%i шт.]\n\
				"SERVER"6. {FFFFFF}Приветствие {afafaf}[%i шт.]\n\
				"SERVER"7. {FFFFFF}Стоять {afafaf}[%i шт.]\n\
				"SERVER"8. {FFFFFF}Плохое состояние {afafaf}[%i шт.]\n\
				"SERVER"9. {FFFFFF}Походки {afafaf}[%i шт.]\n\
				"SERVER"10. {FFFFFF}Читать рэп {afafaf}[%i шт.]\n\
				"SERVER"11. {FFFFFF}Поцеловать {afafaf}[%i шт.]\n\
				"SERVER"12. {FFFFFF}Эмоции {afafaf}[%i шт.]\n\
				"SERVER"13. {FFFFFF}Курить {afafaf}[%i шт.]\n\
				"SERVER"14. {FFFFFF}Диллер {afafaf}[%i шт.]\n\
				"SERVER"15. {FFFFFF}Другое {afafaf}[%i шт.]",
				amount[ANIM_TYPE_DANCE],
				amount[ANIM_TYPE_SIT],
				amount[ANIM_TYPE_LIE],
				amount[ANIM_TYPE_GESTURES],
				amount[ANIM_TYPE_TALK],
				amount[ANIM_TYPE_HI],
				amount[ANIM_TYPE_STAND],
				amount[ANIM_TYPE_BAD_CONDITION],
				amount[ANIM_TYPE_WALK],
				amount[ANIM_TYPE_RAP],
				amount[ANIM_TYPE_KISS],
				amount[ANIM_TYPE_EMOJI],
				amount[ANIM_TYPE_SMOKE],
				amount[ANIM_TYPE_DEALER],
				amount[ANIM_TYPE_OTHER]
			);
			ShowPlayerDialog(playerid, 8876, DIALOG_STYLE_LIST, ""SERVER"Выберите категорию анимаций", stringer, "Выбрать", "Отмена");
		}
		default: {
			for (new i = 0, idx = 0; i < sizeof (animationList); i++) {
				if (animationList[i][anim_type] != category)
					continue;
				format(stringer, sizeof (stringer), "%s\
					"SERVER"%i. {FFFFFF}%s {afafaf}[ID: %i]\n", stringer, idx + 1, animationList[i][anim_text], i + 1
				);
				playerListitemID[playerid][idx++] = i;
			}
			ShowPlayerDialog(playerid, 8877, DIALOG_STYLE_LIST, ""SERVER"Выберите анимацию", stringer, "Выбрать", "Назад");
		}
	}
	stringer[0] = EOS;

	return true;
}

stock ApplyAnimlistID(playerid, anim_id) {
	if (!(0 <= anim_id < sizeof (animationList)))
		return false;

	switch (animationList[anim_id][anim_time]) {
		case 101: SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DANCE1);
		case 102: SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DANCE4);
		default: {
			GoAnim(playerid,
				animationList[anim_id][anim_lib], animationList[anim_id][anim_name],
				animationList[anim_id][anim_fDelta], animationList[anim_id][anim_loop],
				animationList[anim_id][anim_lockx], animationList[anim_id][anim_locky],
				animationList[anim_id][anim_Freeze], animationList[anim_id][anim_time], 1
			);
		}
	}
	SetPVarInt(playerid, "Animation", 2);
	TextDrawShowForPlayer(playerid, AnimDraw);

	return true;
}

new PlayerVeh[MAX_PLAYERS] = 0, VehicleOrg[MAX_PLAYERS] = 0, VehicleTeam[MAX_VEHICLES] = 0, VehicleOwner[MAX_VEHICLES] = 0;

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	 if(dialogid == 5000 && response)
    {
        new idx = -1;
        for(new i = 0, count = 0; i < MAX_AUCTIONS; i++)
        {
            if(Auction[i][aActive])
            {
                if(count == listitem)
                {
                    idx = i;
                    break;
                }
                count++;
            }
        }

        if(idx != -1)
        {
            SetPVarInt(playerid, "AuctionIndex", idx);
            new msg[128];
            format(msg, sizeof(msg), "Введите вашу ставку. Минимум: %d руб.", Auction[idx][aCurrentBid] + 1);
            ShowPlayerDialog(playerid, 5001, DIALOG_STYLE_INPUT, "?? Ваша ставка", msg, "Сделать ставку", "Отмена");
        }
        return 1;
    }

    if(dialogid == 5001 && response)
    {
        new idx = GetPVarInt(playerid, "AuctionIndex");
        if(idx < 0 || idx >= MAX_AUCTIONS || !Auction[idx][aActive]) return SCM(playerid, -1, "Аукцион больше не активен.");

        new bid = strval(inputtext);
        if(bid <= Auction[idx][aCurrentBid]) return SCM(playerid, -1, "Ставка должна быть выше текущей.");

        Auction[idx][aCurrentBid] = bid;
        Auction[idx][aCurrentBidder] = playerid;

        new typename[16];
        switch(Auction[idx][aType])
        {
            case 1: typename = "дом";
            case 2: typename = "бизнес";
            case 3: typename = "авто";
        }

        new msg[128];
        format(msg, sizeof(msg), "%s[%d] поставил %d руб. на %s ID %d!", PI[playerid][pNames], playerid, bid, typename, Auction[idx][aItemID]);
        SendClientMessageToAll(COLOR_GREEN, msg);
        return 1;
    }
    //printf("[NICK: %s] [DIALOG: %d] [RESPONSE: %d] [LISTITEM: %i] [INPUTTEXT: %s]", PI[playerid][pNames], dialogid, response, listitem, inputtext);

    SetPVarInt(playerid, "USEDIALOGID", 0);
    for(new i=0;i<strlen(inputtext);i++)if(inputtext[i]=='%')inputtext[i]='#';
    while(strfind(inputtext,"%s",true)!=-1)
    {
        strdel(inputtext,strfind(inputtext,"%s",true),strfind(inputtext,"%s",true)+2);
    }
    while(strfind(inputtext,"%",true)!=-1)
    {
        strdel(inputtext,strfind(inputtext,"%",true),strfind(inputtext,"%",true)+2);
    }
    new gun,ammo, money;
    new gunname[32];

    switch(dialogid)
    {
		case 8235:
		{
			if(!response) return true;

			new giveplayerid = GetPVarInt(playerid, "giveplayerid_setcmd");

			if(PI[giveplayerid][aiCMDaccess][listitem]) PI[giveplayerid][aiCMDaccess][listitem] = 0;
			else PI[giveplayerid][aiCMDaccess][listitem] = 1;

			new string_CMD[256];

			for(new i = 0; i < sizeof(CMD_names); ++i)
			{
				format(string_CMD, sizeof(string_CMD), "%s%s\t%s\n",
					string_CMD, CMD_names[i], (PI[giveplayerid][aiCMDaccess][i]) ? ("{66CC33}Есть доступ"): ("{FF0000}Нету доступа"));
			}

			SPD(playerid, 8235, DIALOG_STYLE_LIST, PI[giveplayerid][pNames],
				string_CMD, "Выбрать", "Закрыть");

			SaveAdmCmds(giveplayerid);
		}
		case 8236:
		{
			if(!response) return true;

			if(paramsCMDaccess[playerid][listitem]) paramsCMDaccess[playerid][listitem] = 0;
			else paramsCMDaccess[playerid][listitem] = 1;

			new updateString[256];
			mysql_format(connects, updateString, sizeof(updateString), "UPDATE `accounts` SET `CMDaccess` = '%d,%d,%d,%d,%d,%d,%d,%d' WHERE `Name` = '%s' LIMIT 1",
				paramsCMDaccess[playerid][0],
				paramsCMDaccess[playerid][1],
				paramsCMDaccess[playerid][2],
				paramsCMDaccess[playerid][3],
				paramsCMDaccess[playerid][4],
				paramsCMDaccess[playerid][5],
				paramsCMDaccess[playerid][6],
				paramsCMDaccess[playerid][7],
				nickCMDaccess[playerid]
			);

			mysql_tquery(connects, updateString);

			callcmd::setcmd(playerid, nickCMDaccess[playerid]);
		}
		case 7322:
		{
			switch(listitem)
			{
				case 0: // Свой дом
				{
					if(PI[playerid][APARTMENT] != -1)
					{
						new h = PI[ playerid ] [ APARTMENT ] ;

						switch(ap_info[h - 1][ap_type])
						{
							case 1:
							{
								SetPPos ( playerid, apartment_spawn_bich [ 0 ], apartment_spawn_bich [ 1 ], apartment_spawn_bich [ 2 ] ) ;
								SetPlayerFacingAngle(playerid, apartment_spawn_bich [ 3 ]);
							}
							case 2:
							{
								SetPPos ( playerid, apartment_spawn_medium [ 0 ], apartment_spawn_medium [ 1 ], apartment_spawn_medium [ 2 ] ) ;
								SetPlayerFacingAngle(playerid, apartment_enter_bich [ 3 ]);
							}
							case 3:
							{
								SetPPos ( playerid, apartment_spawn_top [ 0 ], apartment_spawn_top [ 1 ], apartment_spawn_top [ 2 ] ) ;
								SetPlayerFacingAngle(playerid, apartment_spawn_top [ 3 ]);
							}
							default: return 1;
						}

						SetPlayerInteriorEx(playerid, 1);
						SetPlayerVirtualWorldEx(playerid, ap_info [ h - 1 ] [ ap_id ]);

						SetPVarInt ( playerid, "apartment_id", PI[ playerid ] [ APARTMENT ] ) ;
						SetPVarInt ( playerid, "p_podezd_id", ap_info [ h - 1 ] [ ap_podezd ] ) ;
						SetPVarInt ( playerid, "p_floor_podezd", ap_info [ h - 1 ] [ ap_floor ] ) ;
						SetPlayerSkinEx(playerid, PI[playerid][pChar]);
					}
					else if(PI[playerid][pPhousekey] != 255)
					{

						SetPlayerSkinEx(playerid, PI[playerid][pChar]);
						TogglePlayerControllable(playerid, false);
						SetTimerEx("UnFreez", 2900, 0, "d", playerid);

						new house = PI[playerid][pPhousekey] != 255 ? (PI[playerid][pPhousekey]) : (PI[playerid][pHomez]),
						Float:z_coord = HouseInfo[house][hExitz];

						SetPlayerPosEx(playerid, HouseInfo[house][hExitx], HouseInfo[house][hExity], z_coord, 0.0);
						SetPlayerInteriorEx(playerid, HouseInfo[house][hInt]);
						PI[playerid][pLocal] = house;
						SetPlayerVirtualWorldEx(playerid, house+50);
						SetPlayerSkinEx(playerid, PI[playerid][pChar]);
					}
				}
				case 1: // Семейный дом
				{
					if(family_info [ player_family [ playerid ] - 1 ] [ f_house ] != -1)
					{
						SetPlayerSkinEx(playerid, PI[playerid][pChar]);
						TogglePlayerControllable(playerid, false);
						SetTimerEx("UnFreez", 2900, 0, "d", playerid);

						new house = family_info [ player_family [ playerid ] - 1 ] [ f_house ], Float:z_coord = HouseInfo[house][hExitz];

						SetPlayerPosEx(playerid, HouseInfo[house][hExitx], HouseInfo[house][hExity], z_coord, 0.0);
						SetPlayerInteriorEx(playerid, HouseInfo[house][hInt]);
						PI[playerid][pLocal] = house;
						SetPlayerVirtualWorldEx(playerid, house+50);
						SetPlayerSkinEx(playerid, PI[playerid][pChar]);
					}
				}
			}
		}
  		case 7655:
		{
			new player_id = GetPVarInt(playerid, "duel_id_player") - 1;

			if(!response)
			{
				SendClientMessage(player_id, -1, !"Игрок отказался выходить с Вами на дуэль.");

				DeletePVar(playerid, "duel_sum");
				DeletePVar(player_id, "duel_sum");

				DeletePVar(playerid, "duel_gun_id");
				DeletePVar(player_id, "duel_gun_id");

				DeletePVar(player_id, "duel_id_player");
				DeletePVar(playerid, "duel_id_player");

				return 1;
			}

			if(!IsPlayerConnected(player_id))return SendClientMessage(playerid, -1, "Игрок не найден!" ) ;
			if(!ProxDetectorS(10.0, playerid, player_id)) return SendClientMessage(playerid, COLOR_GRAD1, "Игрок находится слишком далеко от Вас.");

			PI[player_id][pCash] -= GetPVarInt(player_id, "duel_sum");
			PI[playerid][pCash] -= GetPVarInt(playerid, "duel_sum");

			SetPVarInt(playerid, "duel_started", 1);
			SetPVarInt(player_id, "duel_started", 1);

			ResetPlayerWeapons(playerid), ResetPlayerWeapons(player_id);

			GivePlayerWeapon(playerid, GetPVarInt(playerid, "duel_gun_id"), 999);
			GivePlayerWeapon(player_id, GetPVarInt(player_id, "duel_gun_id"), 999);

			SetPlayerHealth(playerid, 100), SetPlayerHealth(player_id, 100);
			TogglePlayerControllable(playerid, false);
			TogglePlayerControllable(player_id, false);

			SetTimerEx("UnFreez", 2000, 0, "d", playerid);
			SetTimerEx("UnFreez", 2000, 0, "d", player_id);

			SetPPos(playerid, -112.9262,1345.5579,15.4225);
			SetPlayerFacingAngle(playerid, 5.7267);

			SetPPos(player_id, -111.0529,1416.8232,15.2352);
			SetPlayerFacingAngle(player_id, 176.4803);

			SetPlayerVirtualWorldEx(playerid, playerid + 1000);
			SetPlayerVirtualWorldEx(player_id, playerid + 1000);

			return 1;
		}
		case 7654:
		{
			new player_id = GetPVarInt(playerid, "duel_id_player") - 1,
				sum_duel = strval(inputtext);

			if(!response)
			{
				DeletePVar(playerid, "duel_gun_id");
				DeletePVar(player_id, "duel_gun_id");

				DeletePVar(player_id, "duel_id_player");
				DeletePVar(playerid, "duel_id_player");

				return 1;
			}

			if(sum_duel < 1000 || sum_duel > 10000000) return ShowPlayerDialog(playerid, 7654, DIALOG_STYLE_INPUT, !""SERVER"Введите ставку [Дуэль]", "{FFFFFF}Введите ставку дуэли в окно ниже:\n\n{afafaf}Минимальная сумма ставки: 1,000 руб.\nМаксимальная сумма ставки: 10,000,000 руб.", !"Далее", !"Отмена");
			if(!IsPlayerConnected(player_id))return SendClientMessage(playerid, -1, "Игрок не найден!" ) ;
			if(!ProxDetectorS(10.0, playerid, player_id)) return SendClientMessage(playerid, COLOR_GRAD1, "Игрок находится слишком далеко от Вас.");

			SetPVarInt(playerid, "duel_sum", sum_duel);
			SetPVarInt(player_id, "duel_sum", sum_duel);
			SendClientMessage(playerid, -1, !"Вы успешно отправили запрос дуэли игроку. Ожидайте подтверждения");
			new gun_name[32];
			new gunsss = GetPVarInt(playerid, "duel_gun_id");
			switch(gunsss)
			{
				case 0: gun_name = "На кулаках";
				case 24: gun_name = "Desert Eagle";
				case 25: gun_name = "Shotgun";
				case 31: gun_name = "M4A1";
				case 30: gun_name = "AK-47";
			}

			format(String1024, sizeof(String1024), "{FFFFFF}Игрок "SERVER"%s[%d]{FFFFFF} предлагает Вам выйти с ним на дуэль.\n\n\
			Сумма ставки: {33aa33}%d руб.\n\
			Выбранное оружие: %s\n\n\
			{afafaf}Если вы согласны, то нажмите клавишу - 'Да',\nиначе нажмите - 'Нет'.", PI[playerid][pNames], playerid, sum_duel, gun_name);
			ShowPlayerDialog(player_id, 7655, DIALOG_STYLE_MSGBOX, !""SERVER"Вызов на дуэль", String1024, !"Да", !"Нет");

			return 1;
		}
		case 7653:
		{
			new player_id = GetPVarInt(playerid, "duel_id_player") - 1,
				gun_id = 0;

			if(!response)
			{
				DeletePVar(player_id, "duel_id_player");
				DeletePVar(playerid, "duel_id_player");
				return 1;
			}
			switch(listitem)
			{
				case 0: gun_id = 0;
				case 1: gun_id = 31;
				case 2: gun_id = 24;
				case 3: gun_id = 30;
				case 4: gun_id = 25;
			}
			SetPVarInt(playerid, "duel_gun_id", gun_id);
			SetPVarInt(player_id, "duel_gun_id", gun_id);
			ShowPlayerDialog(playerid, 7654, DIALOG_STYLE_INPUT, !""SERVER"Введите ставку [Дуэль]", "{FFFFFF}Введите ставку дуэли в окно ниже:\n\n{afafaf}Минимальная сумма ставки: 1,000 руб.\nМаксимальная сумма ставки: 10,000,000 руб.", !"Далее", !"Отмена");
			return 1;
		}
		case 7652:
		{
			if(!response) return 1;
			new id_player = strval(inputtext);
			if(id_player == playerid) return SendClientMessage(playerid, -1, "Вы не можете звать самого себя на дуэль!" ) ;
			if(!IsNumericc(inputtext)) return SendClientMessage(playerid, -1, "Буквы запрещены!" ) ;
			if(!IsPlayerConnected(id_player))return SendClientMessage(playerid, -1, "Игрок не найден!" ) ;
			if(!ProxDetectorS(10.0, playerid, id_player)) return SendClientMessage(playerid, COLOR_GRAD1, "Игрок находится слишком далеко от Вас.");
			SetPVarInt(playerid, "duel_id_player", id_player + 1);
			SetPVarInt(id_player, "duel_id_player", playerid + 1);
			ShowPlayerDialog(playerid, 7653, DIALOG_STYLE_LIST, !""SERVER"Выберите оружие [Дуэль]", !"На кулаках\nM4\nDeagle\nAK-47\nДробовик", !"Далее", !"Отмена");
			return 1;
		}
  		case 5271:
		{
			if(!response) return DeletePVar(playerid, "car_audio");
			if(listitem == 50) // ОФФНУТО
			{
				SetPVarInt(playerid, "ofm_list_page", 1);

				SetPVarInt(playerid, "ofm_list_rows", MAX_MUSICS);
				new rows_list = GetPVarInt(playerid, "ofm_list_page") - 1;

				String2048[0] = EOS;
				new line_string[128], music_type;
				for(new i = rows_list * 10; i < rows_list * 10 + 10; i ++)
				{
					SetPlayerListitemValue(playerid, i - rows_list * 10, music_type);

					music_type ++;

					if(i >= MAX_MUSICS) break;

					format(line_string, sizeof line_string, "%d. %s\n", i + 1, music_list[i][0]);
					strcat(String2048, line_string);
				}
				if(rows_list > 0) strcat(String2048, ""SERVER"Предыдущая страница\n");
				if(ofm_formula(GetPVarInt(playerid, "ofm_list_page")) < GetPVarInt(playerid, "ofm_list_rows")) strcat(String2048, ""SERVER"Следующая страница\n");
				ShowPlayerDialog(playerid, 5272, DIALOG_STYLE_LIST, !""SERVER"Выберите песню", String2048, "Выбор", "Выход");
				return 1;
			}
			else if(listitem == 0)
			{
		 		ShowPlayerDialog(playerid, 5274, DIALOG_STYLE_LIST, !""SERVER"Выберите радиостанцию", !""SERVER"1. {FFFFFF}Europa Plus\n"SERVER"2. {FFFFFF}Радио Рекорд", "Выбор", "Выход");
			}
			else if(listitem == 1)
			{
				if(PI[playerid][car_audio] == 1)
				{
					foreach(new i: streamed_players[playerid])
					{
						if(GetPlayerVehicleID(playerid) == GetPlayerVehicleID(i))
						{
							StopAudioStreamForPlayer(i);
							SendClientMessage(i, -1, !""SERVER"Аудио-система в транспорте отключена.");
						}
					}
					StopAudioStreamForPlayer(playerid);
					DeletePVar(playerid, "BBStation");
					return 1;
				}

				StopAudioStreamForPlayer(playerid);
				if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
			}
		}
