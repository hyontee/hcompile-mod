            format(stringer1,sizeof(stringer1), ""SERVER"[РАЗДАЧА ДОНАТ-МОНЕТ] {FFFFFF}[Основатель] %s - выдал всем %d донат-монет ! =)", PI[playerid][pNames], params[0]);
            SendClientMessageToAll(COLOR_LIGHTRED,stringer1);
            format(stringer1,sizeof(stringer1), "• {FF4500}[Открыть донат-меню] {ffffff}/donate | Проверить свой баланс - /mydon");
            SendClientMessageToAll(COLOR_LIGHTRED,stringer1);
