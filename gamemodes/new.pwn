    "SERVER"17. {FFFFFF}Бинд чата - B17\t /b17\n\
    "SERVER"18. {FFFFFF}Бинд чата - B18\t /b18\n\
    "SERVER"19. {FFFFFF}Бинд чата - B19\t /b19\n\
    "SERVER"20. {FFFFFF}Бинд чата - B20\t /b20");

   	ShowPlayerDialog(playerid, 5333, DIALOG_STYLE_TABLIST_HEADERS,!""SERVER"Настройка биндера:",String1024,!"Открыть",!"Закрыть"); 	

	return true;
}

stock set_bind_command_config(playerid, type)
{

	bind_command_params[playerid] = type;

	SendClientMessage(playerid, -1, "Вы успешно выбрали пункт чата, на которую будете устанавливать биндер!");


	return set_bind_type_config(playerid, type);
}


stock set_bind_type_config(playerid, type)
{

	bind_command_types[playerid] = type;

	SendClientMessage(playerid, -1, "Вы успешно выбрали пункт чата, на который будете устанавливать биндер!");
	SendClientMessage(playerid, -1, "Далее Вам следует ввести текст, который будет выводиться при использовании!");
	SendClientMessage(playerid, -1, "Текст должен быть до 128 символов! Минимум - 6 символов!");
	

	return dialog_input_bind_command(playerid);
}

stock dialog_input_bind_command(playerid)
{
	new 
		fmt_str[350];

	format(fmt_str, 350, \
		""SERVER"-{FFFFFF} Минимальное количество символов - 6 символов\n\
		"SERVER"-{FFFFFF} Максимальное количество символов - 128 символов");
	ShowPlayerDialog(playerid, 5334, DIALOG_STYLE_INPUT, !""SERVER"Текст для биндера:", fmt_str, !"Войти", !"Отмена");

	return true;
}


stock get_name_bind_type(type_id)
{
	new 
		name[35];

	switch(type_id)
	{

		case 1: name = "/me";
		case 2: name = "/do";
		case 3: name = "/try";
		default: name = "Не выбран";
	}
	return name;
}

stock get_name_bind_command(type_id)
{
	new 
		name[35];

	switch(type_id)
	{

		case 1: name = "/b1";
		case 2: name = "/b2";
		case 3: name = "/b3";
		case 4: name = "/b4";
		case 5: name = "/b5";
		case 6: name = "/b6";	
		case 7: name = "/b7";
		case 8: name = "/b8";	
		case 9: name = "/b9";
		case 10: name = "/b10";
		case 11: name = "/b11";
		case 12: name = "/b12";
		case 13: name = "/b13";
		case 14: name = "/b14";	
		case 15: name = "/b15";
		case 16: name = "/b16";	
		case 17: name = "/b17";
		case 18: name = "/b18";	
		case 19: name = "/b19";
		case 20: name = "/b20";	

		default: name = "Не выбран";
	}
	return name;
}

CMD:b1(playerid)
{
	load_bind_command_player(playerid);

	if(strlen(PI[playerid][bind_command_1]) < 2)
		return SendClientMessage(playerid, -1, "У вас не настроен биндер на данную команду. Настройка - /binder");
	
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && robbankstime[playerid] == 0 && PlayerTied[playerid] == 0 && PlayerCuffedTime[playerid] == 0 && GetPVarInt(playerid,"Animation") == 0 && AntiSbiv[playerid] < gettime())
	{
		if(PI[playerid][Settings][4] == 0) FIXES_ApplyAnimation(playerid,"ped",Talk[PI[playerid][Settings][4]],4.1,1,1,1,1,1,1);
		else if(PI[playerid][Settings][4] != 0) FIXES_ApplyAnimation(playerid,"GANGS",Talk[PI[playerid][Settings][4]],4.1,1,1,1,1,1,1);
		SetTimerEx("ClearPlayerChatAnim", strlen(PI[playerid][bind_command_1]) * 400, false, "i", playerid);
	}
	
	if(strlen(PI[playerid][pAccent]) < 2) format(stringer1, sizeof(stringer1), "- %s {%s}(%s)[%d]", PI[playerid][bind_command_1], colorchat(playerid, 1), PI[playerid][pNames], playerid);
	else format(stringer1, sizeof(stringer1), "- %s {%s}| %s | (%s)[%d]", PI[playerid][bind_command_1], colorchat(playerid, 1), PI[playerid][pAccent], PI[playerid][pNames], playerid);
	SetPlayerChatBubble(playerid, PI[playerid][bind_command_1], 0x6ab1ffaa, 20.0, 10000);
	ProxDetector(playerid, 20.0, COLOR_FADE1, stringer1);
	
	return true;
}

