                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_LVPD:
            {
                if(PI[playerid][pMember] != 21)
                {
                    SCM(playerid,0, "Вы состоите в LVPD");
                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_NEWS:
            {
                if(PI[playerid][pMember] != 16)
                {
                    SCM(playerid,0, "Вы не работник Россия 24!");
                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_MAYOR:
            {
                if(PI[playerid][pMember] != 7)
                {
                    SCM(playerid,0, "Транспорт пренадлежит Правительству!");
                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_MECHANIK:
            {
                if(PI[playerid][pJob] != 2)
                {
                    SendClientMessage(playerid, COLOR_GRAD1, "Вы не механик! /gps - Мэрия");
                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_LIC:
            {
                if(PI[playerid][pMember] != 11 && TakingLesson[playerid] != 1)
                {
                    SCM(playerid,0, "Вы не школьный инструктор!");
                    RemoveFromVehicle(playerid);
                    return 1;
                }


            }
        case VEHICLE_ACTION_TYPE_YAKUDZA:
            {
                if(PI[playerid][pMember] != 6)
                {
                    SCM(playerid,0, "Транспорт пренадлежит Арзамаская ОПГ!");
                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_LSPD:
            {
                if(PI[playerid][pMember] != 1)
                {
                    SendClientMessage(playerid, COLOR_GRAD1, "Транспорт пренадлежит МВД Г. Южный!");
                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_FBI:
            {
                if(PI[playerid][pMember] != 2)
                {
                    SendClientMessage(playerid, COLOR_GRAD1, "Транспорт пренадлежит ФСБ!");
                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_FOOD..VEHICLE_ACTION_TYPE_FUEL:
            {
                if(PI[playerid][pJob] != 5)
                {
                    SCM(playerid,0, "Вы не развозчик продуктов!");
                    RemoveFromVehicle(playerid);
                    return 1;
                }

                if(GetPVarInt(playerid,"JobVehicle") != GetPlayerVehicleID(playerid))
                return SPD(playerid,1202,DIALOG_STYLE_MSGBOX,"Аренда","Заключение контракта:\n\nАвтомобиль для должности: Развозчика продуктов и бензина.\nСтоимость аренды автомобиля: 250 руб..\n\nВы согласны?","Да","Нет");

                if(GetPVarInt(playerid,"ProductTime") > 0)
                {
                    new Float:VPos[3], i = ProductInfo[GetPVarInt(playerid, "ProductID")][pBizzid];
                    DeletePVar(playerid,"ProductTime");
                    GetPlayerPos(playerid, VPos[0], VPos[1], VPos[2]);
                    DisablePlayerRaceCheckpoint(playerid);
                    SetPlayerRaceCheckpoint(playerid, 1, BizzInfo[i][bEntrx], BizzInfo[i][bEntry], BizzInfo[i][bEntrz], 0.0,0.0,0.0,6);
                }
            }
        case VEHICLE_ACTION_TYPE_SWAT:
            {
                if(PI[playerid][pMember] != 25)
                {
                    SCM(playerid,0, "Вам недоступен этот транспорт!");
                    RemoveFromVehicle(playerid);
                }
            }
        case VEHICLE_ACTION_TYPE_ARMY:
            {
                if(PI[playerid][pMember] != 3 && PI[playerid][pMember] != 19)
                {
                    SendClientMessage(playerid, COLOR_GRAD1, "Транспорт пренадлежит Армии");
                    RemoveFromVehicle(playerid);
                }

                if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 533)
                {
                    SendMes(playerid,TEAM_GROVE_COLOR,"Оружия: %d/%d", MatHaul[GetVehicleData(newcar, V_ACTION_ID)][mLoad],MatHaul[GetVehicleData(newcar, V_ACTION_ID)][mCapasity]);
                    SCM(playerid,0, "(( Для загрузки/разгрузки Оружия  Введите: /carm ))");
                }

                if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 548) SCM(playerid,0, ":: Для загрузки/разгрузки материалов  Введите: /carmat");
            }

       case VEHICLE_ACTION_TYPE_INKOS:
		{
		    SetPlayerCheckpoint(playerid, g_InitialCheckpointInkos[0], g_InitialCheckpointInkos[1], g_InitialCheckpointInkos[2], 5.0);
		    ShowNotification(playerid, 1, "Загрузитесь деньгами в банке!", 4, "", "");
		    g_PlayerCheckpointStageInkos[playerid] = 0;
		    isDeliveringInkos[playerid] = true;
		    PicCP[playerid] = 0;
		}


        }

        /*

        else if(newcar >= grovecar[0] && newcar <= grovecar[1])
        {
            if(PI[playerid][pLeader] == 15 || PI[playerid][pMember] == 15) { }
            else { SCM(playerid,0, "Транспорт пренадлежит Grove Street Gang!"); RemoveFromVehicle(playerid); }
        }

        else if(newcar >= rifacar[0] && newcar <= rifacar[1])
        {
            if(PI[playerid][pLeader] == 18 || PI[playerid][pMember] == 18) { }
            else { SCM(playerid,0, "Транспорт пренадлежит The Rifa Gang!"); RemoveFromVehicle(playerid); }
        }

        else if(newcar >= ballascar[0] && newcar <= ballascar[1])
        {
            if(PI[playerid][pLeader] == 12 || PI[playerid][pMember] == 12) { }
            else { SCM(playerid,0, "Транспорт пренадлежит The Ballas Gang!"); RemoveFromVehicle(playerid); }
        }
        else if(newcar >= armcar[0] && newcar <= armcar[1])
        {
            if(PI[playerid][pMember] == 19 && PI[playerid][pOdet] == 1 || keys[playerid] == 1 || proverkaforma[playerid] == 1) { }
            else { SendClientMessage(playerid, COLOR_GRAD1, "Транспорт пренадлежит Army LV!"); RemoveFromVehicle(playerid); }
        }
        */
        /// end people system

        SetPVarInt(playerid, "CheckCar", newcar);
        if(!IsAPlane(newcar) && !IsABoat(newcar) && !IsABike(newcar) && !IsANoSpeed(newcar))
        {
    //        UpdateSpeedometr(playerid);
			UpdateSpeedometer(playerid, 2, GetVehicleData(newcar, V_FUEL));
			SendCustomRPC(playerid, 0x129, GetVehicleData(newcar, V_FUEL));
		}
        if(GetVehicleData(newcar, V_FUEL) <= 0)
        {
            SCM(playerid,0, "В Т.С закончился бензин.");
            PI[playerid][pFuelcar] = 0;
        }
        if(IsABike(newcar) && zavodis[playerid] == 0) pc_cmd_en(playerid, "");

        SendClientMessage(playerid, 0xfad201FF, "Нажмите клавишу {FFFFFF}'CTRL'"SERVER" чтобы завести двигатель. {FFFFFF}(/en - завести транспорт командой)");
        SendClientMessage(playerid, 0xfad201FF, "Используйте команду {FFFFFF}'/lock (/lk)'"SERVER" чтобы закрыть личный транспорт.");
        SendClientMessage(playerid, 0xfad201FF, "Используйте команду {FFFFFF}'/radio'"SERVER" чтобы включить музыку в машине.");

        if(IsABoat(newcar))
        {
            if(PI[playerid][pBoatLic] < 1) return SCM(playerid,0, ""error"(( У Вас нет лицензии на водный транспорт! (/gps - Автошкола или /donate ))"), RemoveFromVehicle(playerid);
        }
        if(IsAPlane(newcar))
        {
            if(PI[playerid][pFlyLic] < 1)
            {
                if(TakingLesson[playerid] == 1) { }
                else return SCM(playerid,0, "У Вас нет лицензии на воздушный транспорт! (/gps - Автошкола или /donate)"), RemoveFromVehicle(playerid);
            }
        }
        if(VodPrava(newcar))
        {
            if(PI[playerid][pVodPrava] == 0)
            {
                if(TakingLesson[playerid] != 1) return SCM(playerid,0, "У Вас нет водительских прав! (/gps - Автошкола или /donate)"), RemoveFromVehicle(playerid);
            }
        }
        if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 520) // Гидра
        {
            if (PI[playerid][pMember] == 3 && PI[playerid][pRank] >= 8 && PI[playerid][pOdet] == 1 || PI[playerid][pMember] == 19 && PI[playerid][pRank] >= 12 && PI[playerid][pOdet] == 1) { }
            else {
                RemoveFromVehicle(playerid);
                SendClientMessage(playerid, COLOR_GRAD1, "Вам недоступна боевая техника!");
            }
        }
        else if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 425)//Апач
        {
            if (PI[playerid][pMember] == 3 && PI[playerid][pRank] >= 8 && PI[playerid][pOdet] == 1 || PI[playerid][pMember] == 19 && PI[playerid][pRank] >= 8 && PI[playerid][pOdet] == 1) { }
            else {
                RemoveFromVehicle(playerid);
                SendClientMessage(playerid, COLOR_GRAD1, "Вам недоступна боевая техника!"); }
        }
        else if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 432)//Танк
        {
            if ((PI[playerid][pMember] == 19 || PI[playerid][pMember] == 3) && PI[playerid][pRank] >= 12 && PI[playerid][pOdet] == 1) { }
            else {
                RemoveFromVehicle(playerid);
                SendClientMessage(playerid, COLOR_GRAD1, "Вам недоступна боевая техника!"); }
        }
        /*      else if(newcar == matsfuraactek)
        {
            if(PI[playerid][pLeader] == 17 || PI[playerid][pMember] == 17) { }
            else { SCM(playerid,0, "Транспорт пренадлежит Varios Los Aztecas Gang!"); RemoveFromVehicle(playerid); }
        }
        else if(newcar >= coronoscar[0] && newcar <= coronoscar[1])
        {
            if(PI[playerid][pLeader] == 17 || PI[playerid][pMember] == 17) { }
            else { SCM(playerid,0, "Транспорт пренадлежит Varios Los Aztecas Gang!"); RemoveFromVehicle(playerid); }
        }
        else if(newcar == matsfuravagos)
        {
            if(PI[playerid][pLeader] == 13 || PI[playerid][pMember] == 13) { }
            else { SCM(playerid,0, "Транспорт пренадлежит Los Santos Vagos Gang!"); RemoveFromVehicle(playerid); }
        }
        else if(newcar == matsfuragrove)
        {
            if(PI[playerid][pLeader] == 15 || PI[playerid][pMember] == 15) { }
            else { SCM(playerid,0, "Транспорт пренадлежит Grove Street Gang!"); RemoveFromVehicle(playerid); }
        }
        else if(newcar == matsfurarifa)
        {
            if(PI[playerid][pLeader] == 18 || PI[playerid][pMember] == 18) { }
            else { SCM(playerid,0, "Транспорт пренадлежит The Rifa Gang!"); RemoveFromVehicle(playerid); }
        }
        else if(newcar == matsfuraballas)
        {
            if(PI[playerid][pLeader] == 12 || PI[playerid][pMember] == 12) { }
            else { SCM(playerid,0, "Транспорт пренадлежит The Ballas Gang!"); RemoveFromVehicle(playerid); }
        }*/

    }
    else if(newstate == PLAYER_STATE_PASSENGER) // TAXI & BUSSES
	{
		minigun[playerid]+=2;
		foreach(Player,i)
		{
			if(IsPlayerInVehicle(i, newcar) && GetPlayerState(i) == 2 && PI[i][car_audio] == 1)
			{
				new get_station[128];
				GetPVarString(i, "BBStation", get_station, 128);
				if(!isnull(get_station))
				{
					StopAudioStreamForPlayer(playerid);
					PlayAudioStreamForPlayer(playerid, get_station);
					SendClientMessage(playerid, -1, !"{33aa33}В транспорте включена аудио-система.");
				}
			}
			if(IsPlayerInVehicle(i, newcar) && GetPlayerState(i) == 2 && TransportDuty[i] > 0)
			{
				if(PI[playerid][pCash] < TransportValue[i])
				{
					SendMes(playerid,0x6ab1ffaa,"Вам нужно %d руб., чтобы сесть в машину.", TransportValue[i]);
					RemoveFromVehicle(playerid);
					return 1;
				}
				if(TransportDuty[i] == 1)
				{
					if(PI[playerid][pLevel] > 1 && PI[playerid][pCash] < TransportValue[i])
					{
						SendMes(playerid,COLOR_GREEN,"Вам нужно %d руб., чтобы сесть в такси.", TransportValue[i]);
						RemoveFromVehicle(playerid);
						return 1;
					}
					SendMes(playerid,0x6ab1ffaa,"Вы заплатили таксисту %d руб..", TransportValue[i]);
					SendMes(i,0x6ab1ffaa,"Пасcажир %s сел в ваше такси.", PI[playerid][pNames]);
					PI[playerid][pCash] -=  TransportValue[i];
					GiveMoney(i, TransportValue[i]);
					TransportTotal[playerid] = 0;
					TransportTimer[playerid] = SetTimerEx("AddTaxiFare", 60000, true, "dd", playerid, i); // каждая минута

					return 1;
				}
			}
		}
    }
    return 1;
}
public OnPlayerExitVehicle(playerid, vehicleid)
{
      if (g_PlayerCheckpointStageInkos[playerid] >= 1 && g_PlayerCheckpointStageInkos[playerid] <= 3)
    {
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        new idx = g_PlayerCheckpointStageInkos[playerid] - 1;
        if (IsPlayerInRangeOfPoint(playerid, 5.0, g_DeliveryPointsInkos[idx][0], g_DeliveryPointsInkos[idx][1], g_DeliveryPointsInkos[idx][2]))
        {
            SendClientMessage(playerid, COLOR_GREEN, "Едем дальше.");
            SetPlayerCheckpoint(playerid, g_InitialCheckpointInkos[0], g_InitialCheckpointInkos[1], g_InitialCheckpointInkos[2], 5.0);
            g_PlayerCheckpointStageInkos[playerid] = 0;
        }
    }
     if(vehicleid == playerTaxiVehicle[playerid])
    {
        // Запускаем таймер удаления через 30 секунд
        if(playerTaxiTimer[playerid]) KillTimer(playerTaxiTimer[playerid]);
        playerTaxiTimer[playerid] = SetTimerEx("DestroyPlayerTaxi", 30000, false, "d", playerid);
        SendClientMessage(playerid, 0xFFFF00FF, "Вы вышли из такси. Если не вернётесь за 30 секунд, оно исчезнет.");
    }
     if(TransportTotal[playerid] > 0)
    {
        new driver = INVALID_PLAYER_ID;
		for (new i = 0; i < MAX_PLAYERS; i++)
		{
		    if (IsPlayerInVehicle(i, vehicleid) && GetPlayerState(i) == PLAYER_STATE_DRIVER)
		    {
		        driver = i;
		        break;
		    }
		}

        if(driver != INVALID_PLAYER_ID && IsPlayerConnected(driver))
        {
            if(PI[playerid][pCash] >= TransportTotal[playerid])
            {
                PI[playerid][pCash] -= TransportTotal[playerid];
                GiveMoney(driver, TransportTotal[playerid]);

                SendMes(playerid, COLOR_GREEN, "Вы оплатили %d руб. за поездку.", TransportTotal[playerid]);
                SendMes(driver, COLOR_GREEN, "Вы получили %d руб. за поездку.", TransportTotal[playerid]);
            }
            else
            {
                SendMes(playerid, COLOR_RED, "У вас недостаточно денег для оплаты поездки!");
                SendMes(driver, COLOR_RED, "Пассажир не смог оплатить %d руб.!", TransportTotal[playerid]);
            }
        }

        KillTimer(TransportTimer[playerid]); // остановить таймер
        TransportTimer[playerid] = 0;
        TransportTotal[playerid] = 0;
    }
	if(PI[playerid][car_audio] == 1)
	{
		foreach(new i: streamed_players[playerid])
		{
			if(GetPlayerVehicleID(playerid) == GetPlayerVehicleID(i))
			{
   				StopAudioStreamForPlayer(i);
				SendClientMessage(i, -1, !""SERVER"Аудио-система в транспорте отключена.");
			}
		}
		PI[playerid][car_audio] = 0;
		DeletePVar(playerid, "BBStation");
	}
	StopAudioStreamForPlayer(playerid);

	CheckVehicle[playerid] = gettime() + 2;
    VehicleID[playerid] = INVALID_VEHICLE_ID;
    SetPVarInt(playerid, "GunCheck", 3);
    PI[playerid][AFK_Time] = 0;
    race_exitvehicle(playerid);
    if(PEfir[playerid] != 255)
    {
        SendClientMessage(playerid,COLOR_WHITE, "Вы вышли из прямого эфира");
        PEfir[playerid] = 255;
    }
    if(GetPVarInt(playerid, "rentrc") == 1)
    {
        SetPPos(playerid, -2231.7776,133.5524,1035.4210);
        SetCameraBehindPlayer(playerid);
        SetPlayerVirtualWorldEx(playerid, 33);
        SetPlayerInteriorEx(playerid, 6);
        SetPlayerFacingAngle(playerid, 87.0766);
        n_veh_DestroyVehicle(vehiclerc[playerid]);
        DeletePVar(playerid, "rentrc");
        SendClientMessage(playerid, 0xafafafff, "Вы отказалить от аренды транспорта");
    }
    if(Pefir[playerid] == 1 || Pefir[playerid] == 2)
    {
        Pefir[playerid] = 0;
        PEfir[playerid] = 255;
        SendClientMessage(playerid,COLOR_WHITE, "Вы вышли из прямого эфира");
    }
    if(TransportDuty[playerid] > 0)
    {
        if(TransportDuty[playerid] == 1) TaxiDrivers -= 1;
        Delete3DTextLabel(taxi3d[vehicleid]);
    }
    if(VertMats[playerid] != 0) VertMats[playerid] = 0, DisablePlayerCheckpoint(playerid);
    if(MatsArmyCar[playerid] != 0) MatsArmyCar[playerid] = 0, DisablePlayerCheckpoint(playerid);
    return 1;
}

public OnPlayerRequestClass(playerid, classid)
{


    if(gPlayerLogged[playerid] == 1) {
        SpawnPlayerEx(playerid);
        return 1;
    }
    gIsRequestClassCalled{playerid} = true;
    return 1;
}

stock UpdateSpeedometer(playerid, element, Float:value)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT8, element);
    BS_WriteValue(bs, PR_FLOAT, value);

    #if defined PR_SendRPC
        PR_SendRPC(bs, playerid, 210);
    #else
        BS_RPC(bs, playerid, 210);
    #endif

    BS_Delete(bs);
    return true;
}

publics: OnPlayerBanipCheck(playerid)
{
	SetPlayerCameraPos(playerid, AUTH_CAMERA_POS);
	SetPlayerCameraLookAt(playerid, AUTH_CAMERA_LOOK);
    new rows, fields;
    cache_get_data(rows,fields);
    if(rows)
    {
        new unbandate_IP = cache_get_field_content_int(0, "unbandate", connects),
        bandate_IP = cache_get_field_content_int(0, "date", connects),
        reason_IP[50], admin[24];
        cache_get_field_content(0, "reason", reason_IP, connects, 50);
        cache_get_field_content(0, "admin", admin, connects, 24);
        if(unbandate_IP > gettime())
        {
            new ban_date[6], unban_date[6];
            gmtime(bandate_IP, ban_date[0], ban_date[1], ban_date[2], ban_date[3], ban_date[4], ban_date[5]);
            gmtime(unbandate_IP, unban_date[0], unban_date[1], unban_date[2], unban_date[3], unban_date[4], unban_date[5]);

            format(stringer,sizeof(stringer),"{fad201}Ваш IP адрес заблокирован\n\nАдминистратор: %s\nДата блокировки: %02d.%02d.%04d в %02d:%02d:%02d\nДата снятия блокировки: %02d.%02d.%04d в %02d:%02d:%02d\n\
            Причина: %s\n\nПосле снятия блокировки, просим не нарушать правила сервера\n\
            Вы можете подать апелляцию на снятие блокировки в спец.разделе на форуме",
            admin, ban_date[2], ban_date[1], ban_date[0], ban_date[3]+3, ban_date[4], ban_date[5],
            unban_date[2], unban_date[1], unban_date[0], unban_date[3]+3, unban_date[4], unban_date[5], reason_IP);

            SPD(playerid, 0, DIALOG_STYLE_MSGBOX,"{fad201}IP адрес заблокирован", stringer, "Отмена", "");
            return KickEx(playerid);
        }
        else
        {
            format(mysql_query_, sizeof(mysql_query_),"DELETE FROM `baniplog` WHERE `ip` = '%s' LIMIT 1", PI[playerid][pIP]);
            mysql_tquery(connects, mysql_query_, "", "");
        }
    }
    mysql_format(connects, mysql_query_, sizeof(mysql_query_),"SELECT `password`, `salt` FROM `"TABLE_ACCOUNT"` WHERE `Name` = '%e' LIMIT 1", PI[playerid][pNames]);
    mysql_tquery(connects, mysql_query_, "OnPlayerRegCheck", "i", playerid);
    return 1;
}
stock rentrc(targetid, arenda, idavto)
{
    if(PI[targetid][pCash] < arenda) return SendMes(targetid, 0xFF0000AA, "{ffffff}У Вас недостаточно денег для аренды, необходимо %d$",arenda);
    SendMes(targetid,-1,"{ffffff}Вы арендовали %s за {66cc00}%i$", g_vehicle_info[idavto - 400][VI_NAME], arenda);
    SendClientMessage(targetid, -1, "{63CB00}Чтобы вернуться в магазин пропишите {FFCD00}/cancelrc{63CB00} или {FFCD00}нажмите 'F'");
    SetPlayerVirtualWorldEx(targetid, 0);
    SetPlayerInteriorEx(targetid, 0);
    Hook_GivePlayerMoney(targetid, -arenda);
    vehiclerc[targetid] = CreateVehicle(idavto, 1382.9015,-1757.5061,13.5469,358.0287, 77, 77,7200, 0);
    zavodis[targetid] = 1;
    SetVehicleData(vehiclerc[targetid], V_FUEL, 100);
    LinkVehicleToInterior(vehiclerc[targetid], 0);
    PutPlayerInVeh(targetid, vehiclerc[targetid], 0);
    UpdatePlayerData(targetid, "pCash", PI[targetid][pCash]);
    SetPVarInt(targetid, "rentrc", 1);
    return 1;
}
stock SetPlayerExtra(playerid, declare, level, reason[])
{
    if(declare != INVALID_PLAYER_ID) SendMes(playerid,COLOR_LIGHTRED,"Вы совершили преступление: [%s]. Сообщил: %s.",reason,PI[declare][pNames]);
    else SendMes(playerid,COLOR_LIGHTRED,"Вы совершили преступление: [%s]. Сообщил: Неизвестный.",reason);
    if((PI[playerid][pWanted] + level) < 6) PI[playerid][pWanted] += level;
    else PI[playerid][pWanted] = 6;
    SendMes(playerid,COLOR_YELLOW,"Текущий уровень розыска: %d", PI[playerid][pWanted]);
    SetPlayerWantedLevel(playerid, PI[playerid][pWanted]);
    if(declare != INVALID_PLAYER_ID) format(stringer1, sizeof(stringer1),"Рация: Cообщает: %s. Преступление: %s. Подозреваемый: %s",PI[declare][pNames],reason,PI[playerid][pNames]);
    else format(stringer1, sizeof(stringer1),"Рация: Cообщает: Неизвестный. Преступление: %s. Подозреваемый: %s",reason, PI[playerid][pNames]);
    foreach (new i : Player)
    {
        if(!IsPlayerConnected(i) || gPlayerLogged[i] == 0) continue;
        if(PI[i][pMember] == 1 || PI[i][pMember] == 2 || PI[i][pMember] == 10 || PI[i][pMember] == 21 || PI[i][pMember] == 25)
        {
            SendClientMessage(i, 0xFEBC41AA, stringer1);
        }
    }
    return 1;
}

cmd:premcar(playerid)
{
	if(PI[playerid][pPremiumCar] != 1) return SCM(playerid,0, "Для вас нет премиум автомобиля");
	if(PI[playerid][pPayDayHad] < PI[playerid][pPremiumHours])
	{
		new scm_string[94];
		format(scm_string, sizeof(scm_string), "Необходимо отыграть %d часов чтобы забрать премиум автомобиль [У вас отыграно: %d часов]", PI[playerid][pPremiumHours], PI[playerid][pPayDayHad]);
 		return SCM(playerid,0, scm_string);
	}
	BuyOwnableExcCar(playerid, 415, 1 ) ;

	PI[playerid][pPremiumHours] = 0;
	UpdatePlayerData(playerid, "pPremiumHours", PI[playerid][pPremiumHours]);

	PI[playerid][pPremiumCar] = 0;
	UpdatePlayerData(playerid, "pPremiumCar", PI[playerid][pPremiumCar]);
	return 1;
}

publics: minute_timer()
{
    GlobalMinuteTimer = SetTimer("minute_timer", 60000, false);

	for(new i = 1; i < TOTALBIZZ + 1; i++)
	{
	    if(BizzInfo[i][bMoney] >= 1000000000) BizzInfo[i][bMoney] = 1000000000;
	}

    if(settings_name != 0)
    {
        switch(random(3))
        {
        case 0: if(NameEnabled[0] > 0) SendRconCommand(ServerName[0]);
        case 1: if(NameEnabled[1] > 0) SendRconCommand(ServerName[1]);
        case 2: if(NameEnabled[2] > 0) SendRconCommand(ServerName[2]);
        }
    }

    new newhour, newminute, newsecond;
    gettime(newhour, newminute, newsecond);

    if(newminute == 57)
    {
		mysql_tquery(connects, "SELECT `fam_name`, `fam_rating` FROM `family_system` ORDER BY `family_system`.`fam_rating` DESC LIMIT 1", "timerFamUPD");
    }


	/*if(newminute == 5 || newminute == 30 || newminute == 50)
	{
  		new Cache:result = mysql_query(connects, "SELECT * FROM `lottery`");
		new rows = cache_num_rows();
        cache_delete(result);

		SendClientMessageToAll(COLOR_WHITE, ""SERVER"ЛОТЕРЕЯ{FFFFFF}: Уважаемые игроки, вам нужен всего "SERVER"ОДИН{FFFFFF} шаг до богатства!");
		SendClientMessageToAll(COLOR_WHITE, ""SERVER"ЛОТЕРЕЯ{FFFFFF}: Участвуйте в ЛОТЕРЕЕ {afafaf}(/lottery){FFFFFF} и покупайте счастливые билеты!");

		new scm_string[76];
		format(scm_string,sizeof(scm_string), ""SERVER"ЛОТЕРЕЯ{FFFFFF}: Призовой фонд Лотереи: {33aa33}%d донат-рублей", ((rows * 20) / 10) * 9);
		SendClientMessageToAll(COLOR_WHITE, scm_string);
	}*/
    if ((newhour > ghour) || (newhour == 0 && ghour == 23))
    {
        new time[64];
        format(time,sizeof(time), "{FFFFFF}Текущее время: {3399FF}%d:00",newhour);
        SendAdminMessage(COLOR_LIGHTRED,time);
        ghour = newhour;
        PayDay();
        SetWorldTime(newhour);
        if(newhour == 20 && newminute == 00) get_lottery_winner();
    }

    if(!(newminute % 2)) {
        SendClientMessageToAll(-1, "Донат-услуги сервера: "SERVER"/donate > Дополнительно (донат-рубли)");
        SendClientMessageToAll(-1, "Пополнить счёт можно на сайте "SERVER""SITE_NAME"");
    }

	if(newhour == 5 && newminute == 00)
	{
		SendClientMessageToAll(0xFF0000FF, "Через 10 минут произойдёт глобальный рестарт!");
	}

	if(newhour == 5 && newminute == 09)
	{
		save_server_info();
		SendClientMessageToAll(0xFF0000FF, "Внимание! Через 60 секунд сервер будет перезагружен без дополнительных уведомлений!");
        SendClientMessageToAll(0xFF0000FF, "Полная перезагрузка сервера обычно занимает от 2-х до 5 минут!");

        SaveAccounts(); SaveOther(); SaveHousee();
        SaveAll();
	}

    //if(newhour == 5 && newminute == 10) SendRconCommand("exit");

	if(newminute == 30 || newminute == 58)
	{
		if(onx == 1)
		{
			SendClientMessageToAll(0xFFCD00ff, "Администратор Lincoln_Mullerov: Сегодня включена акция х3 донат ! Пополнить счёт: "SITE_NAME"");
			SendClientMessageToAll(0xFFCD00ff, "Администратор Lincoln_Mullerov: Пополняешь игровой аккаунт на 100 рублей - получаешь 300 !");
			SendClientMessageToAll(0xFFCD00ff, "Администратор Lincoln_Mullerov: Донат-услуги: /donaterub, приятной игры!");
		}
	}

	if(newminute == 20 || newminute == 40 || newminute == 55)
	{
		if(oonx == 1)
		{
			SendClientMessageToAll(0xFFCD00ff, "Администратор Lincoln_Mullerov: сегодня в 14:00 будет слёт всех квартир в подъездах!");
		}

		switch(random(2)) // 0xfad201ff
		{
			case 0: SendClientMessageToAll(0xfad201ff, "[Уведомление] {FFFFFF}Скидки на все Донат-Услуги только сегодня! (/donaterub)");
			case 1: SendClientMessageToAll(0xfad201ff, "[Уведомление] {FFFFFF}Уникальные скины и машины только в донате! (/donaterub)");
			case 2: SendClientMessageToAll(0xfad201ff, "[Уведомление] {FFFFFF}Сегодня спецпредложения на донат-услуги! (/donaterub)");
		}
	}
	if(newhour == 17 && newminute == 55)
	{
	    SendClientMessageToAll(0xFF0000FF, "Через 5 минут начнётся аукцион на контейнеры. {afafaf}[/gps - > 9. Контейнеры]");
	}

	if(newhour == 18 && newminute == 00)
	{
	    SendClientMessageToAll(0xFF0000FF, "Торги за контейнеры начались. {afafaf}[/gps - > 9. Контейнеры]");
	}

    if(newminute == 2) {
        racetime = 365;
    }

	switch(newminute)
	{
	    case 47:
	    {
	        SendClientMessageToAll(COLOR_YELLOW, !"Вы можете приобрести скин Томаса Шелби, Моргенштерна, Бустера и других знаменитостей по скидке только сегодня!");
        	SendClientMessageToAll(COLOR_YELLOW, !"Больше информации /donate - Дополнительные услуги - Уникальные скины");
	    }
	    case 42:
	    {
	        SendClientMessageToAll(COLOR_YELLOW, !"Вы можете приобрести Бугатти Диво, Майбах, т-34 и др. авто по скидке только сегодня!");
        	SendClientMessageToAll(COLOR_YELLOW, !"Больше информации /donate - дополнительные услуги - уникальные автомобили");
	    }
	    case 31:
	    {
	        SendClientMessageToAll(COLOR_YELLOW,"SMS: Привет, нужна халявная админка или рубли? | Отправитель: "SERVER_NAME" Telecom");
	        SendClientMessageToAll(COLOR_YELLOW,"SMS: Напиши в группу ВКонтакте | Отправитель: "SERVER_NAME" Telecom");
	        SendClientMessageToAll(COLOR_YELLOW,"SMS: Туда напиши в сообщения группы слово #подарок именно точно так же! | Отправитель: "SERVER_NAME" Telecom");
            SendClientMessageToAll(COLOR_YELLOW,"SMS: Я так написал и мне дало 950 рублей, тема работает крч) | Отправитель: "SERVER_NAME" Telecom");
		}
		case 21:
		{
  			SendClientMessageToAll(COLOR_WHITE, !""SERVER"Если вы нашли баг на сервере, введите пожалуйста команду {FFFFFF}/bag");
        	SendClientMessageToAll(COLOR_WHITE, !""SERVER"Придумайте своё обновление, введите команду {FFFFFF}/update");
		}
		case 52:
		{
  			SendClientMessageToAll(COLOR_WHITE, !""SERVER"Lincoln_Mullerov: {FFFFFF}Привет, хочешь купить полный-доступ? Введи {afafaf}/full");
  			SendClientMessageToAll(COLOR_WHITE, !""SERVER"Lincoln_Mullerov: {FFFFFF}Покупать на сайте {afafaf}(/sait)");
  			SendClientMessageToAll(COLOR_WHITE, !""SERVER"Lincoln_Mullerov: {FFFFFF}Цена фуллки 2499 рублей, через 7 дней будет 4999 рублей.");
		}
		case 38:
		{
		    SendClientMessageToAll(COLOR_ORANGE, !"Срочная связь с основателем сервера: {FFFFFF}/osnovatel");
		}
	}

    switch(newminute)
    {
        case 8, 16, 32, 40, 50, 54:
        {
            foreach(new premiumid : PremiumPlayers)
            {
                SCM(premiumid, 1, "У Вас включена акция X3 Доната из-за Premium VIP");
            }
        }
        case 12,24,36,48,59:
        {

            RandomReklama(random(3));
        }
        case 01,07,13,19,25,31,37,43,49,55:
        {
            SendAdminMessage(0xB8FF1AFF, "Ув. админы, не игнорируйте репорт! В случае игнора вы получите административный выговор ");
            SendAdminMessage(0xB8FF1AFF, "Также существуют 'неотвеченные репорты', которые сохраняются и при вводе команды /reps Вы можете ответить на них.");
            SendAdminMessage(0xB8FF1AFF, ">>>> за игнор /reps выдаются админ-выговоры всем! <<<<");
            SendAdminMessage(0xB8FF1AFF, "Снять свой админ-выговор, купить команду или новые функции можно только в > /adonate ");
            SendAdminMessage(0xB8FF1AFF, "Администрации запрещено участвовать в розыгрышах или мероприятиях. Получить донат-рублей можно только пополнив свой донат-счет ");
        }
    }

    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i)) continue;

		AttachAcsToPlayer(i, GetPlayerSkin(i));

        if(PlayerRentBike[i] != -1 && GetPVarInt(i, "RentBikeTime") < gettime())
        {
			new idx = GetPVarInt(i, pVar__RentBike_PickupIDX);

            new vehicleid = PlayerRentBike[i];

            DestroyVehicle(vehicleid);
            SetRentBikePickupTenantsCount(idx, GetRentBikePickupTenantsCount(idx)-1);

            RentBikePickupIDX[vehicleid] =
            RentBikeOwner[vehicleid] = -1;

            PlayerRentBike[i] = 0;
        }
  	}

  	return 1;
}


publics: second_timer()
{
    GlobalSecondTimer = SetTimer("second_timer", 1000, false);

    if(racestatus) {

        new counter = 0;
        foreach(new pid : TrackPlayers) {
            TrackPlayersAr[counter][0] = pid;
            TrackPlayersAr[counter][1] = TrackBool[pid];
            counter++;
        }


        new Swapper;
        for(new s = 1; s < 10; ++s) {
            if(TrackPlayersAr[s][1] > TrackPlayersAr[s-1][1]) {
                Swapper = TrackPlayersAr[s][0];
                TrackPlayersAr[s][0] = TrackPlayersAr[s-1][0];
                TrackPlayersAr[s-1][0] = Swapper;

                Swapper = TrackPlayersAr[s][1];
                TrackPlayersAr[s][1] = TrackPlayersAr[s-1][1];
                TrackPlayersAr[s-1][1] = Swapper;
            }
        }

        new strtxd[48];
        
        for(new s = 0; s < 10; ++s ) {
            if(TrackPlayersAr[s][0] != INVALID_PLAYER_ID) {
                format(strtxd, sizeof(strtxd), "%d", TrackPlayersAr[s][1]+1);
                PlayerTextDrawSetString(TrackPlayersAr[s][0], raceing_PTD[TrackPlayersAr[s][0]][0], strtxd);
            }
        }

        format(strtxd, sizeof(strtxd), "%s", PI[TrackPlayersAr[0][0]][pNames]);
        TextDrawSetString(raceing_TD[16], strtxd);

        format(strtxd, sizeof(strtxd), "%s", PI[TrackPlayersAr[2][0]][pNames]);
        TextDrawSetString(raceing_TD[20], strtxd);

        format(strtxd, sizeof(strtxd), "%s", PI[TrackPlayersAr[1][0]][pNames]);
        TextDrawSetString(raceing_TD[21], strtxd);
        
    }

    if(racetime) {

        switch(racetime) {
            case 361: {
                new trackvehicles[] = {571, 410, 415, 401, 436};

                TrackInfo[vehID] = trackvehicles[random(4)];

                TrackInfo[Bet] = (random(9)+1)*1000000;

                TrackInfo[Players] = 0;

                for(new d = 0; d < 10; ++d) TrackInfo[winID][d] = INVALID_PLAYER_ID;

                new string[128];

                format(string, sizeof(string), "Внимание! Через 6 минут начинается гонка на ''%s'' [/gps - > 12. Гоночный трек]", 
                    g_vehicle_info[TrackInfo[vehID]-400][VI_NAME]
                );

                SendClientMessageToAll(0x3399FFFF, string);

                format(string, sizeof(string), "Максимальное количество участников: 10. Взнос в призовой фонд: %d рублей", 
                    TrackInfo[Bet]);

                SendClientMessageToAll(-1, string);

                Iter_Clear(TrackPlayers);
            }
            case 181: {
                new string[128];

                format(string, sizeof(string), "Внимание! Через 3 минуты начинается гонка на ''%s'' [/gps - > 12. Гоночный трек]", 
                    g_vehicle_info[TrackInfo[vehID]-400][VI_NAME]
                );

                SendClientMessageToAll(0x3399FFFF, string);

                format(string, sizeof(string), "Зарегистрировано участников: %d/10. Взнос в призовой фонд: %d рублей", 
                    TrackInfo[Players], TrackInfo[Players]*TrackInfo[Bet]);

                SendClientMessageToAll(-1, string);
            }
            case 1: {
                new string[128];

                if(TrackInfo[Players] < 3) // min players
                { 
                    format(string, sizeof(string), "Внимание! Гонка на ''%s'' отменена из-за недостатка участников (менее 3-х участников).", 
                        g_vehicle_info[TrackInfo[vehID]-400][VI_NAME]
                    );

                    SendClientMessageToAll(0x3399FFFF, string);

                    racetime = 0;
                }
                else {

                    racestatus = 1;

                    format(string, sizeof(string), "Внимание! Гонка на ''%s'' началась, регистрация закрыта!", 
                        g_vehicle_info[TrackInfo[vehID]-400][VI_NAME]
                    );

                    SendClientMessageToAll(0x3399FFFF, string);

                    format(string, sizeof(string), "Зарегистрировано участников: %d/10. Текущий призовой фонд: %d рублей", 
                        TrackInfo[Players], TrackInfo[Players]*TrackInfo[Bet]);

                    SendClientMessageToAll(-1, string);

                    new slot = 0;

                    foreach( new i : TrackPlayers) {

                        SetPPos(i, TrackSlots[slot][0], TrackSlots[slot][1], TrackSlots[slot][2]);
                        SetPlayerFacingAngle(i, 180.7493);
                        SetPlayerVirtualWorldEx(i, 1777);
                        SetPlayerInteriorEx(i, 0);

                        TrackCar[slot] = AddStaticVehicleEx(TrackInfo[vehID],
                            TrackSlots[slot][0], TrackSlots[slot][1], TrackSlots[slot][2], 180.7493,
                            random(8), random(8), 1200, 0, 0, 0, 0);

                        SetVehicleVirtualWorld(TrackCar[slot], 1777);
                        LinkVehicleToInterior(TrackCar[slot], 0);
                        
                        SetVehicleData(TrackCar[slot], V_FUEL, 100);
                        SetVehicleParam(TrackCar[slot], V_ENGINE, true);

                        TogglePlayerControllable(i, false);

                        PutPlayerInVehicle(i, TrackCar[slot], 0);

                        TrackTimer[i] = 15;

                        ++slot;

                        for(new h = 0; h < 23; ++h) TextDrawShowForPlayer(i, raceing_TD[h]);
                        PlayerTextDrawShow(i, raceing_PTD[i][0]);
                    }
                }
            }
        }

        --racetime;
    }

    if(gmxtime) {
        if(gmxtime == 301) SendClientMessageToAll(COLOR_LIGHTRED, "Внимание! Через 5 минут будет внеплановая перезагрузка сервера.");
        if(gmxtime == 61) SendClientMessageToAll(COLOR_LIGHTRED, "Внимание! Через 1 минуту будет внеплановая перезагрузка сервера.");
        if(gmxtime == 31) SendClientMessageToAll(COLOR_LIGHTRED, "Внимание! Через 30 секунд будет внеплановая перезагрузка сервера.");
        if(gmxtime == 12) SendClientMessageToAll(COLOR_LIGHTRED, "Внимание! Через 10 секунд будет внеплановая перезагрузка сервера.");
        if(gmxtime == 8) {
            SaveAccounts(); SaveOther(); SaveHousee();
            SaveAll();
        }
        if(gmxtime == 6) SendClientMessageToAll(COLOR_LIGHTRED, "Все аккаунты успешно сохранены!");
        if(gmxtime == 5) SendClientMessageToAll(COLOR_LIGHTRED, "Все дома успешно сохранены!");
        if(gmxtime == 5) SendClientMessageToAll(COLOR_LIGHTRED, "Все бизнесы успешно сохранены!");
        if(gmxtime == 4) SendClientMessageToAll(COLOR_LIGHTRED, "Полное сохранение сервера было завершено.");
        if(gmxtime == 2) SendClientMessageToAll(COLOR_LIGHTRED, "Внимание! Внеплановая перезагрузка сервера.");
        if(gmxtime == 1) gmxtime = 0, SendRconCommand("gmx");

        --gmxtime;
    }

	if (BizWarTime[0] > 0)
	{
		BizWarTime[0]--;
		if (BizWarTime[0] == 180)
		{
			SendFamilyMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, "Приготовьтесь! До начала встречи осталось 3 минуты");
			SendFamilyMessage(MZInfo[bNapad], COLOR_LIGHTRED, "Приготовьтесь! До начала встречи осталось 3 минуты");
		}
		if (BizWarTime[0] == 60)
		{
			SendFamilyMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, "Внимание! До начала встречи осталась 1 минута");
			SendFamilyMessage(MZInfo[bNapad], COLOR_LIGHTRED, "Внимание! До начала встречи осталась 1 минута");
		}
		if (BizWarTime[0] == 0) MafiaTimeCapture(MZInfo[bFrakVlad], MZInfo[bNapad]);
	}
	if (BizWarTime[1]) BizWarTimer();


    //  PlantTimer();

    new hour, minute, second;
    gettime(hour, minute, second);

    if(hour == 0 && minute == 0)
    {
        ClearEveryDayPrizes();
        everyCleared = 1;
    }
    if(hour == 0 && minute == 1)
    {
        everyCleared = 0;
    }

    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i)) continue;

		
		if ( GetPVarInt ( i, "spectated" ) )
		{
			SetPlayerInterior(i, GetPlayerInterior(GetPVarInt(i, "spectate_status")));
			SetPlayerVirtualWorld(i, GetPlayerVirtualWorld(GetPVarInt(i, "spectate_status")));
		}

        if (PlayerClearAnim[i] == 1) {
			PlayerClearAnim[i] = 0;
			ApplyAnimation(i, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1);
		}

        if(PI[i][pVirt] != GetPlayerVirtualWorld(i)) SetPlayerVirtualWorld(i, PI[i][pVirt]);
        //if(PI[i][pInt] != GetPlayerInterior(i)) SetPlayerInterior(i, PI[i][pInt]);

        if(AdminGuard[i] > 0) --AdminGuard[i];

        if(TrackTimer[i] > 0) {
            new gtfptext[16];

            if(TrackTimer[i] == 2) {
                GameTextForPlayer(i, "~g~READY...", 2000, 3);
            }
            else if(TrackTimer[i] == 1) {
                GameTextForPlayer(i, "~g~GO...", 1800, 3);

                TogglePlayerControllable(i, true);

                TrackTimer[i] = 0;

                SetPlayerRaceCheckpoint(i, 0, TrackBools[0][0], TrackBools[0][1], TrackBools[0][2], TrackBools[1][0], TrackBools[1][1], TrackBools[1][2], 10.0);
            }
            else {
                format(gtfptext, sizeof(gtfptext), "~g~%d", TrackTimer[i]);

                GameTextForPlayer(i, gtfptext, 900, 3);
            }
            --TrackTimer[i];
        }
        
         new vid = GetPlayerVehicleID(i);
         if(IsPlayerInAnyVehicle(i) && GetPlayerState(i) == 2)
        	{
		            if(!IsAPlane(vid) && !IsABoat(vid) && !IsANoSpeed(vid))
		            {
		                UpdateSpeedometr(i);
		            }
		        }

		if(PI[i][pGivePizzaTimer] > 0)
		{
		    PI[i][pGivePizzaTimer]--;

			DisablePlayerCheckpoint(i);
			PicCP[i] = 0;

			new scm_string[16];
			format(scm_string, sizeof(scm_string), "~g~%d", PI[i][pGivePizzaTimer]);
			GameTextForPlayer(i, scm_string, 1000, 4);

if (PI[i][pGivePizzaTimer] <= 0 && GetPVarInt(i, "work_eda_house") != 1)
{
    PI[i][pGivePizzaTimer] = 0;

    SPD(i, 0000, DIALOG_STYLE_MSGBOX, "{FFD700}Яндекс Еда",
        "{ffffff}Отлично.\nТеперь вам нужно отвезти заказ клиенту!\nПоторопитесь, пока еда не остыла!\n\n{FF4500}Метка отмечена красным цветом на карте.",
        "ОК", "");

    TogglePlayerControllable(i, 1);

    new houseList[70], count = 0;
    new Float:pX, Float:pY, Float:pZ;
    GetPlayerPos(i, pX, pY, pZ);

    // Сохраняем в список все дома, находящиеся дальше 50.0 от игрока
    for (new j = 0; j < 70; j++)
    {
        if (HouseInfo[j][hEntrancex] == 0.0 && HouseInfo[j][hEntrancey] == 0.0) continue; // защита от пустых координат

        new Float:dist = GetPlayerDistanceFromPoint(i, HouseInfo[j][hEntrancex], HouseInfo[j][hEntrancey], HouseInfo[j][hEntrancez]);
        if (dist > 50.0) // ограничение — не слишком близко
        {
            houseList[count] = j;
            count++;
        }
    }

    if (count > 0)
    {
        new randIndex = random(count);
        new house = houseList[randIndex];

        // Устанавливаем чекпоинт
        SetPlayerCheckpoint(i, HouseInfo[house][hEntrancex], HouseInfo[house][hEntrancey], HouseInfo[house][hEntrancez], 10.0);
        SetPVarInt(i, "work_eda_house", 1);
    }
    else
    {
        // Если не найден ни один подходящий дом — fallback
        SendClientMessage(i, 0xFF0000FF, "Ошибка: не удалось найти подходящий дом для доставки.");
    }
}


			if(PI[i][pGivePizzaTimer] <= 0 && GetPVarInt(i, "work_eda_house_done") == 1)
			{
			    PI[i][pGivePizzaTimer] = 0;

				DisablePlayerCheckpoint(i);
				PicCP[i] = 0;

			    PI[i][pZakazov]++;
			    TogglePlayerControllable(i, 1);
			    new scm_string_2[356];
			    if(PI[i][pZakazov] <= 20)
			    {
				    format(scm_string_2, sizeof(scm_string_2), "\
	   				{ffffff}Клиент оценил вашу работу на: {32CD32}%d баллов!\n\
					{ffffff}Вы заработали: {32CD32}100.000$\n\
					{ffffff}Вы заработали: {32CD32}500 донат-очков.\n\n\
					{ffffff}Выполнено: {32CD32}%d/20 заказов\n\nЕзжайте за пиццей, и отвезите её клиенту.\n\n{FF0000}Метка отмечена красным цветом на карте.", random(5) + 5, PI[i][pZakazov]);

				/*	if(PI[i][pZakazov] == 20)
					{
						new random_rub = RandomEx(10, 40);
						PI[i][pRub] += random_rub;

						new str_frmt[128];
						format(str_frmt, sizeof(str_frmt), "{6495ED}Поздравляю! Вы получили {7CFC00}%d рублей. 6495ED}Продолжайте работать в том же духе!", random_rub);
						SendClientMessage(i, COLOR_WHITE, str_frmt);
						SendClientMessage(i, COLOR_WHITE, "{6495ED}Рубли можете потратить на админку (если хватает) {7CFC00}/donate");
					}*/
				}
				else
				{
					format(scm_string_2, sizeof(scm_string_2), "\
					{ffffff}Клиент оценил вашу работу на: {32CD32}%d баллов!\n\
					{ffffff}Вы заработали: {32CD32}100.000$\n\
					{ffffff}Вы заработали: {32CD32}500 донат-очков.\n\n\
					{6495ED}Выполняйте заказы, иногда мы даем за это бонусы!\n\nЕзжайте за пиццей, и отвезите её клиенту.\n\n{FF0000}Метка отмечена красным цветом на карте.", random(5) + 5);
				}
				SPD(i, 0000, DIALOG_STYLE_MSGBOX, "{FFD700}Яндекс Еда", scm_string_2, "ОК", "");

				PI[i][pCash] += 100000;
				PI[i][pDonatemoney2] += 500;
				OnPlayerUpdateRL(i);

                SetPVarInt(i, "work_eda_house", 0);
                DeletePVar(i, "work_eda_house_done");

				new Float:distance = 1000000.0, biz = -1, Float:pX, Float:pY, Float:pZ;
				GetPlayerPos(i, pX, pY, pZ);
				for(new j = 0; j < sizeof(BizzInfo); j++)
				{
					if(BizzInfo[j][bType] == 3)
					{
						if(GetPlayerDistanceFromPoint(i, BizzInfo[j][bEntrx], BizzInfo[j][bEntry], BizzInfo[j][bEntrz]) < distance)
						{
							distance = GetPlayerDistanceFromPoint(i, BizzInfo[j][bEntrx], BizzInfo[j][bEntry], BizzInfo[j][bEntrz]);
							biz = j;
						}
					}
				}
				if(biz != -1) SetPVarInt(i, "work_eda", biz), SetPlayerCheckpoint(i, BizzInfo[biz][bEntrx], BizzInfo[biz][bEntry], BizzInfo[biz][bEntrz], 10.0);
				return 1;
			}
		}

		if(PI[i][pUgonTimer] > 0)
		{
		    PI[i][pUgonTimer]--;

			new scm_string[32];
			format(scm_string, sizeof(scm_string), "~r~Time: %02i:%02i", (PI[i][pUgonTimer]/60), PI[i][pUgonTimer] - (60 * (floatround(PI[i][pUgonTimer])/60)));
			GameTextForPlayer(i, scm_string, 1000, 4);

			if(PI[i][pUgonTimer] <= 0)
			{
				stringer1[0] = EOS;
                SendClientMessage(i, COLOR_YELLOW, "[SMS от Володи]: Ты не справился с заданием, нас чуть не засекли.");

			    DestroyVehicle(PI[i][pUgonVehicle]);

			    PI[i][pUgonTimer] =
			    PI[i][pUgonVehicle] = 0;

			    DisablePlayerCheckpoint(i);
			}
		}


		if(IsAGreenZone(i))
		{
		    if(GetPVarInt(i, "TD_grshowed") != 1)
			{
		    	SendCustomRPC(i, 0x127, 2);
		    	SetPVarInt(i, "TD_grshowed", 1);
			}
		}
		else
		{
		    if(GetPVarInt(i, "TD_grshowed") == 1)
		    {
		        DeletePVar(i, "TD_grshowed");
		        SendCustomRPC(i, 0x127, 4);
		    }
		}

	    new CheckGun[13], CheckAmmo[13];
		for(new j = 0; j < 13; j ++)
		{
			GetPlayerWeaponData(i, j, CheckGun[j], CheckAmmo[j]);
			if(CheckGun[j] == 38)
			{
	  			format(stringer1, sizeof(stringer1), "{0095FF}[ANTICHEAT] {FF4500}%s[%d]{FFFFFF} был кикнут по подозрению в использовании чит-программ: {FF4500}WEAPON HACK.", PI[i][pNames], i);
	            SendAdminMessage(-1, stringer1);
	            KickEx(i);
			    break;
			}
		}

        if(PI[i][pCash] != GetPlayerMoney(i))
		{
	 		ResetPlayerMoney(i);
		  	GivePlayerMoney(i, PI[i][pCash]);
		}

        if(PI[i][AFK_Time] < 3) onlinecheck[i]++;
        if(onlinecheck[i] >= 59)
        {
            PI[i][pDayOnline]++;
			if(PI[i][pDayOnline] >= 180 && PI[i][pPrizeAvailable])
			{
			    GiveEveryPrize(i, PI[i][pEPDay]);
			    if(PI[i][pEPDay] < sizeof(everyPrizes)-1)
			    {
			    	PI[i][pEPDay] ++;
				}
				PI[i][pPrizeAvailable] = 0;

				new stri[150];
				format(stri, 150, "UPDATE accounts SET epday=%d,eprizeavail=%d WHERE Name='%s'", PI[i][pEPDay], PI[i][pPrizeAvailable], PI[i][pNames]);
				mysql_tquery(connects, stri);
			}
            onlinecheck[i] = 0;
        }
        if(PI[i][AFK_Time] >= 3)
        {
            new string[144];
            format(string,144,""SERVER"AFK: {FFFFFF}%s",Convert(PI[i][AFK_Time]-2));
            SetPlayerChatBubble(i,string,-1,10.0,1600);
		}
        if(PI[i][AFK_Tick] > 10000) PI[i][AFK_Tick] = 1, PI[i][AFK_Check] = 0;
        if(PI[i][AFK_Check] < PI[i][AFK_Tick] && GetPlayerState(i)) PI[i][AFK_Check] = PI[i][AFK_Tick], PI[i][AFK_Time] = 0;
        if(PI[i][AFK_Check] == PI[i][AFK_Tick] && GetPlayerState(i))
        {
            PI[i][AFK_Time] += 1;
            if(PI[i][AFK_Time] > 2)
            {
                afkcheck[i]++;
                if(afkcheck[i] >= 60) {
                    PI[i][pDayAfk]++;
                    afkcheck[i] = 0;
                }
                format(stringer1, 30,""SERVER"AFK: {FFFFFF}%s",Convert(PI[i][AFK_Time]-2));
                SetPlayerChatBubble(i,stringer1,-1,30.0,3000);
            }
        }

        if(PI[i][pJailed] > 0)
        {
            if(PI[i][pJailTime] <= gettime())
            {
                SetPPos(i,2580.6282,-2419.1113,21.9574);//Тюрьма
                SetPlayerFacingAngle(i, 268.3480);

                SetPlayerInteriorEx(i, 0);
                PI[i][pJailed] = 0;
                PI[i][pJailTime] = 0;
                PI[i][pMestoJail] = 0;
                PI[i][pWanted] = 0;
                PI[i][pUsedJail] = 0;
                SetPlayerWantedLevel(i, 0);
                SetPlayerVirtualWorldEx(i, 0);
                GameTextForPlayer(i, "~g~Freedom", 5000, 1);
                SetPlayerToTeamColor(i);
                SendClientMessage(i, COLOR_ISPOLZUY,"Вы отбыли свой срок и можете идти на свободу.");
            }
        }
    }
    return 1;
}
stock ShowStats(playerid,targetid)
{
    if(IsPlayerConnected(playerid)&&IsPlayerConnected(targetid))
    {
        new atext[20];
        if(PI[targetid][pSex] == 1) { atext = "Мужской"; }
        else if(PI[targetid][pSex] == 2) { atext = "Женский"; }
        new drank[20];
        new day, month, year;
        getdate(year, month, day);
        if(PI[targetid][pDonateRank] == 1) { drank = "Bronze VIP"; }
        else if(PI[targetid][pDonateRank] == 2) { drank = "Silver VIP"; }
        else if(PI[targetid][pDonateRank] == 3) { drank = "Gold VIP"; }
        else { drank = "Обычный"; }
        new prank[23];
        switch(PI[targetid][pLevel])
        {
        case 1..3: { prank = "Новичок"; }
        case 4..6: { prank = "Начинающий"; }
        case 7..9: { prank = "Уверенный"; }
        case 10..14: { prank = "Постоянный игрок"; }
        case 15..19: { prank = "Освоившийся"; }
        case 20..24: { prank = "Освоившийся"; }
        case 25..49: { prank = "Дед"; }
        }
        new wanted = PI[targetid][pWanted];
        new zavisimostitext[20];
        if(PI[targetid][pNarcoLomka] == 0) { zavisimostitext = "Стадия отсутствует"; }
        else if(PI[targetid][pNarcoLomka] >= 1 && PI[targetid][pNarcoLomka] < 3000) { zavisimostitext = "1 стадия"; }
        else if(PI[targetid][pNarcoLomka] >= 3000 && PI[targetid][pNarcoLomka] < 5000) { zavisimostitext = "2 стадия"; }
        else if(PI[targetid][pNarcoLomka] >= 5000) { zavisimostitext = "3 стадия"; }
        new nxtlevel = PI[targetid][pLevel]+1;
        new tiee = PI[targetid][pVerevka];
        new otmi = PI[targetid][pOtmbI4ka];
        new expamount = nxtlevel*levelexp;
        new PayDayHad = PI[targetid][pPayDayHad];
        new str[166],sctring[1450];
        format(str,sizeof(str),"{ffffff}Имя: \t\t\t\t{3399FF}%s \n\n",PI[targetid][pNames]);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Уровень: \t\t\t{ffffff}%d (%d/%d) \n",PI[targetid][pLevel],PI[targetid][pExp],expamount);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Пол: \t\t\t\t{ffffff}%s \n",atext);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Статус в штате: \t\t{ffffff}%s \n\n",prank);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Статус {66CC33}VIP{ffffff}: \t\t\t%s \n\n",drank);
        strcat(sctring,str);
        if(PI[targetid][pAdmin] >= 1)
        {
            format(str,sizeof(str),"{fad201}Уровень Администратора: \t{ffffff}%d (%d/3) \n",PI[targetid][pAdmin],PI[targetid][pVigs]);
            strcat(sctring,str);
        }
      /*  else if(PI[targetid][pHelper] >= 1)
        {
            format(str,sizeof(str),"{fad201}Уровень Хелпера: \t{ffffff}%d \n",PI[targetid][pHelper]);
            strcat(sctring,str);
        }*/
        format(str,sizeof(str),"{ffffff}Законопослушность: \t\t{ffffff}%d \n",PI[targetid][pZakonp]);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Варн(ов): \t\t\t{ffffff}%d/{fad201}3 \n",PI[targetid][pWarns]);
        strcat(sctring,str);
        if(PI[targetid][punWarns] == 1) format(str,sizeof(str),"\t{fad201}Часов до снятия варна:\t{ffffff}%d \n",10-PI[targetid][punWarnstime]), strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Уровень Преступлений: \t{ffffff}%d/{fad201}6 \n",wanted);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Убийств: \t\t\t{ffffff}%d \n",PI[targetid][pKills]);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Наркозависимость: \t\t{ffffff}%s (%d) \n",zavisimostitext,PI[targetid][pNarcoLomka]);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Аптечек при себе: \t\t{ffffff}%d \n",PI[playerid][pHeal]);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Материалы при себе: \t\t{ffffff}%d \n",PI[targetid][pMats]);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Отмычек при себе: \t\t{ffffff}%d \n",otmi);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Веревок при себе: \t\t{ffffff}%d \n",tiee);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Масок при себе: \t\t{ffffff}%d \n",PI[targetid][Texts][2]);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Часов в игре: \t\t\t{ffffff}%d \n",PayDayHad);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Работа: \t\t\t{ffffff}%s \n",GetPlayerJobName(PI[targetid][pJob]));
        strcat(sctring,str);
        if(!PI[targetid][pAdmin]) format(str,sizeof(str),"{ffffff}Организация: \t\t\t{ffffff}%s (%d/3) \n",GetPlayerFracName[PI[targetid][pMember]],PI[targetid][pVigs]);
        else format(str,sizeof(str),"{ffffff}Организация: \t\t\t{ffffff}%s \n",GetPlayerFracName[PI[targetid][pMember]]);
        strcat(sctring,str);
        if(PI[targetid][pMember] > 0 && PI[targetid][pRank] > 0) format(str,sizeof(str),"{ffffff}Ранг: \t\t\t\t{ffffff}%s(%d) \n\n",fRankName[PI[targetid][pMember]-1][PI[targetid][pRank]-1],PI[targetid][pRank]); ///
        else format(str,sizeof(str),"{ffffff}Ранг: \t\t\t\t{ffffff}Неизвестно \n\n"); ///
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Денег: \t\t\t\t{ffffff}%s \n",formatInt(PI[targetid][pCash]));
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}В банке: \t\t\t{ffffff}%s \n",formatInt(PI[targetid][pBank]));
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Донат очков: \t\t\t{ffffff}%s \n\n",formatInt(PI[targetid][pDonatemoney2]));
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Телефон: \t\t\t{ffffff}%d \n",PI[targetid][pPnumber]);
        strcat(sctring,str);
        format(str,sizeof(str),"{ffffff}Баланс на телефоне: \t\t{ffffff}%d{66CC33}$ \n\n",PI[targetid][pMobile]);
        strcat(sctring,str);
        format(str,sizeof(str),"{fad201}донат-рублей: \t\t{ffffff}%d{66CC33} \n\n",PI[targetid][pDonateRubNew]);
        strcat(sctring,str);
        format(str,sizeof(str),"\t{FFFFFF}"SERVER_NAME"\n");
        strcat(sctring,str);
        format(str,sizeof(str),"\t{FFFFFF}Статистика за %02d/%02d/%d", day, month, year);
        strcat(sctring,str);
        format(stringer1,sizeof(stringer1),""SERVER"Статистика игрока",PI[targetid][pNames]);
        SPD(playerid,1932,0,stringer1,sctring,"ОК","");
    }
}
stock SetPlayerToTeamColor(playerid)//ЦВЕТА Фракциям
{
    switch(PI[playerid][pMember])
    {
    case 0: SetPlayerColor(playerid, 0xFFFFFF80);
    case 1: SetPlayerColor(playerid, COLOR_DBLUE);
    case 2: SetPlayerColor(playerid, 0x313131AA);
    case 3: SetPlayerColor(playerid, COLOR_GREEN);
    case 4: SetPlayerColor(playerid, 0xA52A2AFF);
    case 5: SetPlayerColor(playerid, 0xDDA701FF);
    case 6: SetPlayerColor(playerid, COLOR_REDD);
    case 7: SetPlayerColor(playerid, 0x114D71FF);
    case 8: SetPlayerColor(playerid, 0xB313E7FF);
    case 10: SetPlayerColor(playerid, COLOR_DBLUE);
    case 11: SetPlayerColor(playerid, 0x139BECFF);
    case 12: SetPlayerColor(playerid, 0x8813E7FF);
    case 13: SetPlayerColor(playerid, 0xDBD604AA);
    case 14: SetPlayerColor(playerid, COLOR_GRAD1);
    case 15: SetPlayerColor(playerid, 0x009F00AA);
    case 16: SetPlayerColor(playerid, 0x40848BAA);
    case 17: SetPlayerColor(playerid, TEAM_AZTECAS_COLOR);
    case 18: SetPlayerColor(playerid, 0x83BFBFAA);
    case 19: SetPlayerColor(playerid, COLOR_GREEN);
    case 21: SetPlayerColor(playerid, COLOR_DBLUE);
    case 23: SetPlayerColor(playerid, 0x708090FF);
    case 24: SetPlayerColor(playerid, 0xF45000FF);
    case 25: SetPlayerColor(playerid, 0x2E8B57FF);
    case 26: SetPlayerColor(playerid, 0x708090AA);
    case 27,28: SetPlayerColor(playerid, 0xFF0000AA);
    }
    return 1;
}

stock GameModeExitFunc()
{
    SaveAccounts();
    GameModeExit();
    return 1;
}

public OnGameModeExit()
{
	ronline_server = 0;

	if (GlobalSecondTimer != -1) {
		KillTimer(GlobalSecondTimer);
		printf("[KillTimer 18] GlobalSecondTimer = '%d' killed",
			GlobalSecondTimer
		);
	}
	GlobalSecondTimer = -1;

	if (GlobalMinuteTimer != -1) {
		KillTimer(GlobalMinuteTimer);
		printf("[KillTimer 18] GlobalMinuteTimer = '%d' killed",
			GlobalMinuteTimer
		);
	}
	GlobalMinuteTimer = -1;

    format(mysql_query_, sizeof(mysql_query_), "UPDATE `"TABLE_ACCOUNT"` SET `pOnline` = '1001'");
    mysql_tquery(connects, mysql_query_, "", "");
    foreach(Player,i)
    {
        if(IsPlayerConnected(i)) OnPlayerUpdateRL(i);
    }
    mysql_close();
    return 1;
}

publics: timerFamUPD(playerid) {
    new rows = cache_num_rows();
    new fam_name[32], fam_rating;

    cache_get_field_content(0, "fam_name", fam_name, connects, sizeof(fam_name));
    fam_rating = cache_get_field_content_int(0, "fam_rating");

    if(rows)
    {
        new scm_string[144];
        format(scm_string, sizeof(scm_string), "Лучшая семья на данный момент - "SERVER"%s {afafaf}[Рейтинг: %d]", fam_name, fam_rating);
        SendClientMessageToAll(-1, scm_string);
    }
    return 1;
}

publics: aLeaders(playerid, query[])
{
    new rows,fields;
    cache_get_data(rows,fields,connects);
    if(!rows) return SendClientMessage(playerid, 0xFF0000FF, "Не найдено не одного аккаунта!");
    new string[5000],online[20],name[24],leadername[35],ttextt[32];
    string="";
    for(new i = 0; i < rows; i ++)
    {
        PI[i][pLeader] = cache_get_field_content_int (i, "pLeader", connects);
        cache_get_field_content(i,"Name", name, connects, 24);
        cache_get_field_content(i, "pGetonDate", online, connects, 20);
        if(IsPlayerConnected(GetPlayerID(name))) { ttextt = "[{2CE40C}Онлайн{ffffff}]"; }
        else if(!IsPlayerConnected(GetPlayerID(name))) { ttextt = "[{E40C0C}Оффлайн{ffffff}]"; }
        format(string,sizeof(string),"%s%s {FFFFFF}%s {FFFFFF}%s Дата последнего посещения: %s\n",string,leadername,name,ttextt,online);
    }
    switch(PI[playerid][pLeader])
    {
    case 1: leadername = "{2641FE}МВД Г. Южный";
    case 2: leadername = "{313131}ФБР";
    case 3: leadername = "{33AA33}Армия: Авианосец";
    case 4: leadername = "{A52A2A}МЧС";
    case 5: leadername = "{DDA701}Батыревская братва";
    case 6: leadername = "{FF4500}Арзамаская ОПГ";
    case 7: leadername = "{114D71}Губернатор";
    case 8: leadername = "{B313E7}Casino Rich";
    case 10: leadername = "{2641FE}SFPD";
    case 11: leadername = "{139BEC}Инструкторы";
    case 12: leadername = "{8813E7}The Ballas";
    case 13: leadername = "{DBD604}The Vagos";
    case 14: leadername = "{B4B5B7}Лыткаринская ОПГ";
    case 15: leadername = "{009F00}The Grove";
    case 16: leadername = "{40848B}ТРЦК Ритм";
    case 17: leadername = "{01FCFF}The Aztecas";
    case 18: leadername = "{83BFBF}The Rifa";
    case 19: leadername = "{33AA33}Армия: Сухопутная";
    case 21: leadername = "{2641FE}LVPD";
    case 23: leadername = "{708090}Хитман";
    case 24: leadername = "{F45000}Street Rasers";
    case 25: leadername = "{2E8B57}SWAT";
    case 26: leadername = "{708090}Правительство";
    case 27: leadername = "{B313E7}Casino Four Dragons";
    case 28: leadername = "{B313E7}Casino Caligulas";
    default: leadername = "{FF4500}Неизвестно";
    }
    SPD(playerid,0000,DIALOG_STYLE_MSGBOX,"{FFC100}Лидеры организаций:\t",string,"Закрыть","");
    return 1;
}
publics: LoadHouses()
{
    static rows, fields;
    cache_get_data(rows, fields);
    new temp[64];

    TOTALHOUSE = cache_num_rows();
    if(rows)
    {
        for(new he = 0; he < rows; he++)
        {
            HouseInfo[he][hID] = he;

            // Вход
            HouseInfo[he][hEntrancex] = cache_get_field_content_float(he, "hEntrancex");
            HouseInfo[he][hEntrancey] = cache_get_field_content_float(he, "hEntrancey");
            HouseInfo[he][hEntrancez] = cache_get_field_content_float(he, "hEntrancez");

            // Выход
            HouseInfo[he][hExitx] = cache_get_field_content_float(he, "hExitx");
            HouseInfo[he][hExity] = cache_get_field_content_float(he, "hExity");
            HouseInfo[he][hExitz] = cache_get_field_content_float(he, "hExitz");

            cache_get_field_content(he, "hOwner", HouseInfo[he][hOwner], connects, 24);

            // Настройки
            HouseInfo[he][hValue] = cache_get_field_content_int(he, "hValue");
            HouseInfo[he][hHel] = cache_get_field_content_int(he, "hHel");
            HouseInfo[he][hInt] = cache_get_field_content_int(he, "hInt");
            HouseInfo[he][hLock] = cache_get_field_content_int(he, "hLock");
            HouseInfo[he][hOwned] = cache_get_field_content_int(he, "hOwned");
            HouseInfo[he][hTakings] = cache_get_field_content_int(he, "hTakings");
            HouseInfo[he][hKlass] = cache_get_field_content_int(he, "hKlass");

            //Авто
            HouseInfo[he][hCarx] = cache_get_field_content_float(he, "hCarx");
            HouseInfo[he][hCary] = cache_get_field_content_float(he, "hCary");
            HouseInfo[he][hCarz] = cache_get_field_content_float(he, "hCarz");
            HouseInfo[he][hCarc] = cache_get_field_content_float(he, "hCarc");

            //Шкаф
            HouseInfo[he][hNark] = cache_get_field_content_int(he, "hNark");
            HouseInfo[he][hMoney] = cache_get_field_content_int(he, "hMoney");
            HouseInfo[he][hMatel] = cache_get_field_content_int(he, "hMatel");
            HouseInfo[he][hduggl] = cache_get_field_content_int(he, "hduggl");
            HouseInfo[he][hak47] = cache_get_field_content_int(he, "hak47");

            HouseInfo[he][hshotgun] = cache_get_field_content_int(he, "hshotgun");
            HouseInfo[he][hm4] = cache_get_field_content_int(he, "hm4");
            HouseInfo[he][hsdpist] = cache_get_field_content_int(he, "hsdpist");
            HouseInfo[he][hrifle] = cache_get_field_content_int(he, "hrifle");
            HouseInfo[he][hsmg] = cache_get_field_content_int(he, "hsmg");
            cache_get_row(he, 31, temp), sscanf(temp, "a<i>[7]", HouseInfo[he][hdrugs]);

            // гараж
			HouseInfo[he][hGarageExit][0] = cache_get_field_content_float(he, "hGX");
			HouseInfo[he][hGarageExit][1] = cache_get_field_content_float(he, "hGY");
			HouseInfo[he][hGarageExit][2] = cache_get_field_content_float(he, "hGZ");
			HouseInfo[he][hGarageExit][3] = cache_get_field_content_float(he, "hGAngle");
			CreateDynamic3DTextLabel(""SERVER"Посигнальте, {ffffff}чтобы заехать в гараж", -1, HouseInfo[he][hGarageExit][0], HouseInfo[he][hGarageExit][1], HouseInfo[he][hGarageExit][2], 10.0);

            HouseInfo[he][hRobhouse] = false;

            CreateDynamic3DTextLabel("Выход\nКоманда: /exit", -1,HouseInfo[he][hExitx],HouseInfo[he][hExity],HouseInfo[he][hExitz],9.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,HouseInfo[he][hInt],he+50);

            HouseInfo[he][hSquare] = CreateDynamicSphere(HouseInfo[he][hEntrancex], HouseInfo[he][hEntrancey], HouseInfo[he][hEntrancez], 1.5, -1, -1, -1);
            if(HouseInfo[he][hOwned] == 0)
            {
                HouseInfo[he][hPickup] = CreatePickup(1273, 23, HouseInfo[he][hEntrancex], HouseInfo[he][hEntrancey], HouseInfo[he][hEntrancez],0);
                HouseInfo[he][hMIcon] = CreateDynamicMapIcon(HouseInfo[he][hEntrancex], HouseInfo[he][hEntrancey], HouseInfo[he][hEntrancez], 31, COLOR_WHITE, 0, -1, -1, 150.0);
            }
            if(HouseInfo[he][hOwned] == 1)
            {
                HouseInfo[he][hPickup] = CreatePickup(1272, 23, HouseInfo[he][hEntrancex], HouseInfo[he][hEntrancey], HouseInfo[he][hEntrancez],0);
                HouseInfo[he][hMIcon] = CreateDynamicMapIcon(HouseInfo[he][hEntrancex], HouseInfo[he][hEntrancey], HouseInfo[he][hEntrancez], 32, COLOR_WHITE, 0, -1, -1, 150.0);
            }
        }
		CreateDynamic3DTextLabel(""SERVER"Посигнальте, {ffffff}чтобы выехать", -1, -1029.1632,-2619.1821,18.6245, 10.0);
        // CreateDynamic3DTextLabel("Выход с подвала\nКлавиша "SERVER"'ALT' (Команда: /exit)", -1, 499.7690,2495.9626,1503.7925,9.0);

        printf("[ %d ] Дома успешно загружены.",TOTALHOUSE);
    }
    else printf("Дома не загружены.");
    for(new i; i != MAX_PAYNSPRAY; i++)
    {
        PaynSpray[i] = CreateDynamicSphere(paynspray[i][0],paynspray[i][1],paynspray[i][2],10.0);
    }
    AreaBase = CreateDynamicSphere(492.6442,-153.7014,611.1124,50.0);
    door_fbi_area = CreateDynamicSphere(584.0284,1270.3948,1080.3250,4.0);
    jail_area[0] = CreateDynamicSphere(5512.0732,1249.1172,23.1886, 50.0); // demorgan
    jail_area[1] = CreateDynamicSphere(264.1425,77.4712,1001.0391, 40.0); // xz
    jail_area[2] = CreateDynamicSphere(219.5400,109.9767,999.0156, 40.0); // xz
    jail_area[3] = CreateDynamicSphere(198.3642,161.8103,1003.0300, 40.0); // xz
    return 1;
}
publics: LoadBizz()
{
    new time = GetTickCount();
    static rows, fields;
    cache_get_data(rows, fields);
    new idx;
    for(idx = 1; idx <= rows; idx++)
    {
        BizzInfo[idx][bID] = cache_get_row_int(idx-1,0, connects);
        cache_get_row(idx-1, 1, BizzInfo[idx][bOwner], connects, 32);
        BizzInfo[idx][bType] = cache_get_row_int(idx-1,2, connects);
        BizzInfo[idx][bPrice] = cache_get_row_int(idx-1,3, connects);
        BizzInfo[idx][bBuyPrice] = cache_get_row_int(idx-1,4, connects);
        BizzInfo[idx][bMoney] = cache_get_row_int(idx-1,5, connects);
        BizzInfo[idx][bEntrx] = cache_get_row_float(idx-1,7, connects);
        BizzInfo[idx][bEntry] = cache_get_row_float(idx-1,8, connects);
        BizzInfo[idx][bEntrz] = cache_get_row_float(idx-1,9, connects);
        BizzInfo[idx][bExitx] = cache_get_row_float(idx-1,10, connects);
        BizzInfo[idx][bExity] = cache_get_row_float(idx-1,11, connects);
        BizzInfo[idx][bExitz] = cache_get_row_float(idx-1,12, connects);
        BizzInfo[idx][bMenux] = cache_get_row_float(idx-1,13, connects);
        BizzInfo[idx][bMenuy] = cache_get_row_float(idx-1,14, connects);
        BizzInfo[idx][bMenuz] = cache_get_row_float(idx-1,15, connects);
        BizzInfo[idx][bInt] = cache_get_row_int(idx-1,16, connects);
        BizzInfo[idx][bVirtual] = cache_get_row_int(idx-1,17, connects);
        BizzInfo[idx][bMIcon] = cache_get_row_int(idx-1,18, connects);
        cache_get_row(idx-1, 19, BizzInfo[idx][bName], connects, 32);
        BizzInfo[idx][bEnter] = cache_get_row_int(idx-1,20, connects);
        BizzInfo[idx][bLock] = cache_get_row_int(idx-1,21, connects);
        BizzInfo[idx][bProduct] = cache_get_row_int(idx-1,22, connects);
        BizzInfo[idx][bTill] = cache_get_row_int(idx-1,23, connects);
        BizzInfo[idx][bLockTime] = cache_get_row_int(idx-1,24, connects);
        BizzInfo[idx][bMafia] = cache_get_row_int(idx-1,25, connects);

        if(BizzInfo[idx][bType] > 1 && BizzInfo[idx][bType] != 10) BizzInfo[idx][bIcon] = CreateDynamicMapIcon(BizzInfo[idx][bEntrx],BizzInfo[idx][bEntry],BizzInfo[idx][bEntrz], BizzInfo[idx][bMIcon], 0,-1,-1,-1,200.0);
        if(BizzInfo[idx][bType] != 2 && BizzInfo[idx][bType] != 8)
        {
            BizzInfo[idx][bPickup] = CreatePickup(1318,1, BizzInfo[idx][bEntrx],BizzInfo[idx][bEntry],BizzInfo[idx][bEntrz]);
            BizzInfo[idx][bPickupExit] = CreatePickup(1318, 1, BizzInfo[idx][bExitx],BizzInfo[idx][bExity],BizzInfo[idx][bExitz], BizzInfo[idx][bVirtual]);
            if(BizzInfo[idx][bType] == 1) {
                BizzInfo[idx][bMenu] = CreatePickup(1239, 1, BizzInfo[idx][bMenux],BizzInfo[idx][bMenuy],BizzInfo[idx][bMenuz], BizzInfo[idx][bVirtual]);
                CreateDynamic3DTextLabel("{0aa40d}Список\nтоваров",-1,BizzInfo[idx][bMenux],BizzInfo[idx][bMenuy],BizzInfo[idx][bMenuz],4.0);
                BizzInfo[idx][bIcon] = CreateDynamicMapIcon(BizzInfo[idx][bEntrx],BizzInfo[idx][bEntry],BizzInfo[idx][bEntrz], 52, 0, -1,-1,-1,200.0);
            } else {
                BizzInfo[idx][bMenu] = CreatePickup(1239, 1, BizzInfo[idx][bMenux],BizzInfo[idx][bMenuy],BizzInfo[idx][bMenuz], BizzInfo[idx][bVirtual]);
            }
            if(!strcmp(BizzInfo[idx][bOwner],"None",true))
            {
                format(stringer, sizeof(stringer), "{66CC33}%s (№%d)\n{66CC33}Бизнес продаётся\n{FFD700}Цена бизнеса: %s рублей\n\n"SERVER"Купить бизнес: /buybiz", BizzInfo[idx][bName], idx, formatInt(BizzInfo[idx][bPrice]));
                LABELBIZZ[idx] = CreateDynamic3DTextLabel(stringer,0xFFFFFFF,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0,-1, 100.0);
            }
            else
            {
                if(BizzInfo[idx][bEnter] > 0) format(stringer, sizeof(stringer), "{66CC33}%s (№%d)\n{ffffff}Владелец: {3399FF}%s\n{FFFFFF}Крыша: {%s}%s\n{00cb00}Вход: "SERVER"%sр.", BizzInfo[idx][bName], idx, BizzInfo[idx][bOwner], colorchat(BizzInfo[idx][bMafia], 2), GetPlayerFracName[BizzInfo[idx][bMafia]], formatInt(BizzInfo[idx][bEnter]));
                else format(stringer, sizeof(stringer), "{66CC33}%s (№%d)\n{ffffff}Владелец: {3399FF}%s\n{FFFFFF}Крыша: {%s}%s\n{00cb00}Вход: "SERVER"Бесплатный", BizzInfo[idx][bName], idx, BizzInfo[idx][bOwner], colorchat(BizzInfo[idx][bMafia], 2), GetPlayerFracName[BizzInfo[idx][bMafia]]);
                LABELBIZZ[idx] = CreateDynamic3DTextLabel(stringer,0xFFFFFFF,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0,-1, 100.0);
            }
        }
        else
        {
            if(!strcmp(BizzInfo[idx][bOwner],"None",true))
            {
                if(BizzInfo[idx][bType] == 2) format(stringer, sizeof(stringer), "{3399FF}Автозаправочная станция\n{66CC33}Бизнес продаётся\n{FFD700}Цена бизнеса: %s рублей\n{FFFFFF}Цена за 1 литр - {f9f906}%s\n\n{66CC33}Используйте /fill чтобы заправиться\n{66CC33}Используйте /buybiz чтобы купить заправку", formatInt(BizzInfo[idx][bPrice]), formatInt(BizzInfo[idx][bTill] / 3));
                else format(stringer, sizeof(stringer), "{66CC33}Бизнес продаётся\n{FFD700}Цена бизнеса: %d рублей\nНазвание: %s\nИспользуйте гудок для вьезда (/tune)", BizzInfo[idx][bPrice], BizzInfo[idx][bName]);
                LABELBIZZ[idx] = CreateDynamic3DTextLabel(stringer,0xFFFFFFF,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0,-1,100.0);
            }
            else
            {
                if(BizzInfo[idx][bType] == 2) format(stringer, sizeof(stringer), "{3399FF}Автозаправочная станция\n{FFFFFF}Владелец: {66CC33}%s\n{FFFFFF}Цена за 1 литр - {f9f906}%s\n\n{66CC33}Используйте /fill чтобы заправиться\n{66CC33}Используйте /buybiz чтобы купить заправку", BizzInfo[idx][bOwner], formatInt(BizzInfo[idx][bTill] / 3));
                else format(stringer, sizeof(stringer), "Владелец: %s\nНазвание: %s\nКрыша: {%s}%s\nИспользуйте гудок для вьезда (/tune)",  BizzInfo[idx][bOwner], BizzInfo[idx][bName], colorchat(BizzInfo[idx][bMafia], 2), GetPlayerFracName[BizzInfo[idx][bMafia]]);
                LABELBIZZ[idx] = CreateDynamic3DTextLabel(stringer,0xFFFFFFF,BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0,-1,100.0);
            }
        }
        TOTALBIZZ++;
    }
    printf("[Загружено бизнесов]: <%d>. Потрачено: <%d мс>.",TOTALBIZZ,GetTickCount()-time);
}
stock SaveBizz(idx)
{
    mysql_query_[0] = EOS;
    format(mysql_query_, sizeof(mysql_query_),"UPDATE `"TABLE_BIZZ"` SET `bOwner` = '%s', `bBuyPrice` = '%d', `bMoney` = '%d', `bEnter` = '%d', `bLock` = '%d', `bProduct` = '%d', `bTill` = '%d', `bLockTime` = '%d',`bMafia` = '%d' WHERE `bID` = '%d'",
    BizzInfo[idx][bOwner], BizzInfo[idx][bBuyPrice], BizzInfo[idx][bMoney], BizzInfo[idx][bEnter], BizzInfo[idx][bLock], BizzInfo[idx][bProduct], BizzInfo[idx][bTill], BizzInfo[idx][bLockTime], BizzInfo[idx][bMafia], BizzInfo[idx][bID]);
    return mysql_tquery(connects, mysql_query_, "", "");
}
stock SaveHouse(houseid)
{
    new drugs[128];
    for(new i = 0; i < 7; i++) format(drugs, sizeof(drugs), "%s%d ", drugs, HouseInfo[houseid][hdrugs][i]);
    format(mysql_query_, sizeof(mysql_query_),"UPDATE `"TABLE_HOUSE"` SET `hOwner` = '%s', `hValue` = '%d', `hHel` = '%d', `hInt` = '%d', `hLock` = '%d', `hOwned` = '%d', `hTakings` = '%d', `hKlass` = '%d',\
    `hNark` = '%d',`hMoney` = '%d',`hMatel` = '%d',`hduggl` = '%d',`hak47` = '%d', `hshotgun` = '%d', `hm4` = '%d',`hsdpist` = '%d',`hrifle` = '%d',`hsmg` = '%d', `hdrugs` = '%s' WHERE `hID` = '%d'",
    HouseInfo[houseid][hOwner],HouseInfo[houseid][hValue],HouseInfo[houseid][hHel],HouseInfo[houseid][hInt],HouseInfo[houseid][hLock], HouseInfo[houseid][hOwned],HouseInfo[houseid][hTakings],HouseInfo[houseid][hKlass],
    HouseInfo[houseid][hNark],HouseInfo[houseid][hMoney],HouseInfo[houseid][hMatel],HouseInfo[houseid][hduggl],
    HouseInfo[houseid][hak47],HouseInfo[houseid][hshotgun],HouseInfo[houseid][hm4],HouseInfo[houseid][hsdpist],HouseInfo[houseid][hrifle],
    HouseInfo[houseid][hsmg],drugs,houseid+1);
    mysql_tquery(connects, mysql_query_, "", "");
    return 1;
}
publics: LoadZone()
{
    new time = GetTickCount();
    new r, f;
    cache_get_data(r, f);
    new idx;
    for(idx = 1; idx <= r; idx++)
    {
        GREENZONE[idx][grid] = cache_get_row_int(idx-1,0, connects);
        GREENZONE[idx][grX] = cache_get_row_float(idx-1,1, connects);
        GREENZONE[idx][grY] = cache_get_row_float(idx-1,2, connects);
        GREENZONE[idx][grZ] = cache_get_row_float(idx-1,3, connects);
        GREENZONE[idx][grD] = cache_get_row_float(idx-1,4, connects);
        cache_get_row(idx-1, 5, GREENZONE[idx][grName], connects, 32);
        GREENZONE[idx][grVirt] = cache_get_row_int(idx-1,6, connects);
        TOTALZONE++;
    }
    printf("[Загружено зеленых зон]: <%i>. Потрачено: <%i мс>.",TOTALZONE,GetTickCount()-time);
}
stock SaveZone(idx)
{
    mysql_format(connects,mysql_query_, sizeof(mysql_query_), "UPDATE "TABLE_GREENZONE" SET grx = '%f', gry = '%f', grz = '%f', grd = '%f', grname = '%s', grvirt = '%i' WHERE id = %i",
    GREENZONE[idx][grX],GREENZONE[idx][grY],GREENZONE[idx][grZ],GREENZONE[idx][grD],GREENZONE[idx][grName],GREENZONE[idx][grVirt], idx);
    mysql_tquery(connects, mysql_query_, "", "");
    return 1;
}
forward UnBanBy(playerid, adm[]);
public UnBanBy(playerid, adm[])
{
    new rows, fields, fstring[144];
    cache_get_data(rows, fields, connects);
    if(rows)
    {
        format(fstring, sizeof(fstring), "[SYSTEM] {FFFFFF}Вы разбанили %i игроков забаненных администратором - %s", rows, adm);
        SendClientMessage(playerid, COLOR_RED, fstring);
        mysql_format(connects, fstring, sizeof(fstring), "DELETE FROM `banlog` WHERE `admin` = '%e'", adm);
        mysql_tquery(connects, fstring, "", "");
    }
    else SendClientMessage(playerid, COLOR_RED, "[SYSTEM] {FFFFFF}Не найдено аккаунтов забаненных этим администратором");
    return 1;
}

CMD:savecor(playerid, params[])
{
	new Float:x, Float:y, Float:z, Float:rot;
	if(!IsPlayerInAnyVehicle(playerid))
	{
		GetPlayerPos(playerid, x,y,z);
		GetPlayerFacingAngle(playerid, rot);
		printf("[ONFOOT COORDS] %f,%f,%f,%f | %s", x,y,z,rot,params);
		SendClientMessage(playerid, -1, "OnFoot pos saved");
	}
	else
	{
		GetVehiclePos(GetPlayerVehicleID(playerid), x,y,z);
		GetVehicleZAngle(GetPlayerVehicleID(playerid), rot);
		printf("[INCAR COORDS] %f,%f,%f,%f | %s", x,y,z,rot,params);
		SendClientMessage(playerid, -1, "InCar pos saved");
	}
	return 1;
}

cmd:unbanby(playerid, params[])
{
    if(CheckFullDostup(playerid))
	{
	    if(sscanf(params, "s[24]", params[0])) return SendClientMessage(playerid, -1,"• "SERVER"[Подсказка] {ffffff}/unbanby [Ник Администратора]");
	    new query_mysql[144];
	    mysql_format(connects, query_mysql, sizeof(query_mysql), "SELECT * FROM `banlog` WHERE `admin` = '%e'", params[0]);
	    mysql_tquery(connects, query_mysql, "UnBanBy", "ds", playerid, params[0]);
	}
	return 1;
}
publics: CheckBanks(playerid)
{
    ClearBank(playerid);
    new rows,fields;
    cache_get_data(rows,fields);
    if(rows)
    {
        for(new i; i < rows; i++)
        {
            _INFO[playerid][ID][i] = cache_get_field_content_int(i, "id", connects);
            cache_get_field_content(i, "name", _INFONAME[playerid][i], connects, 20);
            _INFO[playerid][NUMBER][i] = cache_get_field_content_int(i, "number", connects);
            cache_get_field_content(i, "owner", _INFO[playerid][OWNER][i], connects, 24);
            _INFO[playerid][BALANCE][i] = cache_get_field_content_int(i, "balance", connects);
            _INFO[playerid][PASSWORD][i] = cache_get_field_content_int(i, "password", connects);
            _PLAYERBANK[playerid]++;
        }
    }
    return 1;
}
stock ClearBank(playerid)
{
    for(new i; i < 3; i++) {
        _INFO[playerid][ID][i] = 0;
        _INFO[playerid][NUMBER][i] = 0;
        _INFO[playerid][BALANCE][i] = 0;
        _INFO[playerid][PASSWORD][i] = 0;
        _INFO[playerid][gBALANCE][i] = 0;
        _INFO[playerid][OWNER][i] = 0;
        _INFO[playerid][gOWNER][i] = 0;
        strmid(_INFONAME[playerid][i], "0", 0, 1, 20);
    }
    _PLAYERBANK[playerid] = 0;
}
stock SaveAll()
{
    for(new idx = 1; idx <= TOTALBIZZ; idx++) SaveBizz(idx);
    return 1;
}
stock SaveHousee()
{
    for(new h = 0; h < sizeof(HouseInfo); h++) SaveHouse(h);
    return 1;
}
stock CreateActorEx(name[],text[], skinid, Float:posx,Float:posy,Float:posz,Float:rot,virt = 0,inter = 0,inv = 1)
{
    for(new i = 0; i < MAX_ACTORS; i++)
    {
        if(IsValidActor(i)) continue;
        CreateActor(skinid,posx,posy,posz,rot);
        new string[144];
        SetActorVirtualWorld(i,virt);
        SetActorInvulnerable(i,inv);
        if(strlen(name) || strlen(text))
        {
            format(string,sizeof(string),"{FFFFFF}%s\n%s",name,text);
            CreateDynamic3DTextLabel(string,COLOR_BLUE,posx,posy,posz+1.2,10.0,INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, virt, inter);
        }
        return i;
    }
    return -1;
}

