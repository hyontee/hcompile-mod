    new buy_skin [ 64 ] ;
    for(new i = 0 ; i < MAX_SKIN_EXC; i ++)
    {
        if(i == MAX_SKIN_EXC - 1)
        {
            format(buy_skin, sizeof buy_skin, "{FFFFFF}%d. %s \t{9994EB}%d донат-рублей", i + 1, exc_skin_name [ i ], exc_skin_price_rub [ i ]);
            strcat(stringer, buy_skin);
        }
        else
        {
            format(buy_skin, sizeof buy_skin, "{FFFFFF}%d. %s \t{9994EB}%d донат-рублей\n", i + 1, exc_skin_name [ i ], exc_skin_price_rub [ i ]);
            strcat(stringer, buy_skin);
        }
    }

    return ShowPlayerDialog(playerid, 1952, DIALOG_STYLE_TABLIST, !""SERVER"Покупка эксклизивного скина |{FF4500} СКИДКИ !", stringer, "Купить", "Назад");
}

stock ShowExcCar ( playerid )
