stock DoAction(playerid, text[])
{
    format(stringer1, sizeof(stringer1), "%s (( %s ))",text,PI[playerid][pNames]);
    ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
    SetPlayerChatBubble(playerid,text,COLOR_YELLOW,60.0,10000);
	return 1;
}

stock MeActionEx(playerid, text[])
{
    format(stringer1, sizeof(stringer1), "{ea8df7}%s %s", PI[playerid][pNames], text);
    ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
    SetPlayerChatBubble(playerid,text,COLOR_PURPLE,30.0,10000);
	return 1;
}

stock TryAction(playerid, text[])
{
    new temptryrand = random(2);
    if(temptryrand == 1) format(stringer1, 90, "%s %s {1CEF00}| Удачно",PI[playerid][pNames],text);
    else format(stringer1, 90, "%s %s {FF4500}| Неудачно",PI[playerid][pNames],text);
    ProxDetector(playerid, 30.0, COLOR_PURPLE, stringer1);
	return 1;
}

// АКСЫ

stock start_select_aks_shop(playerid, type_shop, type_aks)
{
	switch(type_shop)
	{
		case BUISNES_ACCESSORIES:
		{
			switch(type_aks)
			{

				case 0:
				{
					SetPlayerVirtualWorld(playerid, playerid+1);
					show_aks_start_1(playerid, 1);
					TogglePlayerControllable(playerid, false);
					textdraw_aks_select(playerid, TEXTDRAW_SHOW, BUISNES_ACCESSORIES);
					SetPVarInt(playerid, "type_select_aks", 1);
				}
				case 1:
				{
					SetPlayerVirtualWorld(playerid, playerid+1);
					show_aks_start_1(playerid, 2);
					TogglePlayerControllable(playerid, false);
					textdraw_aks_select(playerid, TEXTDRAW_SHOW, BUISNES_ACCESSORIES);
					SetPVarInt(playerid, "type_select_aks", 2);
				}
				case 2:
				{
					SetPlayerVirtualWorld(playerid, playerid+1);
					show_aks_start_1(playerid, 3);
					TogglePlayerControllable(playerid, false);
					SetPVarInt(playerid, "type_select_aks_shop", BUISNES_ACCESSORIES);
					SetPVarInt(playerid, "type_select_aks", 3);
				}
			}
		}
	}

	return true;
}

//

stock create_aks_shop_price(playerid)
{
	if( GetServerVarAsInt("port") == 7776 ) 
	{
		if(sr_akschoose_PTD[playerid][0] == PlayerText:INVALID_TEXT_DRAW)
		{
			sr_akschoose_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 293.000000, 360.000000, "99_999_999");
			PlayerTextDrawLetterSize(playerid, sr_akschoose_PTD[playerid][0], 0.309666, 2.234667);
			PlayerTextDrawAlignment(playerid, sr_akschoose_PTD[playerid][0], 1);
			PlayerTextDrawColor(playerid, sr_akschoose_PTD[playerid][0], -1);
			PlayerTextDrawSetShadow(playerid, sr_akschoose_PTD[playerid][0], 0);
			PlayerTextDrawBackgroundColor(playerid, sr_akschoose_PTD[playerid][0], 255);
			PlayerTextDrawFont(playerid, sr_akschoose_PTD[playerid][0], 2);
			PlayerTextDrawSetProportional(playerid, sr_akschoose_PTD[playerid][0], 1);
		}
	}
	else if( GetServerVarAsInt("port") == 7777 ) 
	{
		if(sr_akschoose_PTD[playerid][0] == PlayerText:INVALID_TEXT_DRAW)
		{
			sr_akschoose_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 262.0000, 377.0000, "_~n~100000_RUB"); // ?????
			PlayerTextDrawLetterSize(playerid, sr_akschoose_PTD[playerid][0], 0.3543, 1.7368);
			PlayerTextDrawTextSize(playerid, sr_akschoose_PTD[playerid][0], 2.0000, 0.0000);
			PlayerTextDrawAlignment(playerid, sr_akschoose_PTD[playerid][0], 1);
			PlayerTextDrawColor(playerid, sr_akschoose_PTD[playerid][0], -1);
			PlayerTextDrawBackgroundColor(playerid, sr_akschoose_PTD[playerid][0], 255);
			PlayerTextDrawFont(playerid, sr_akschoose_PTD[playerid][0], 1);
			PlayerTextDrawSetProportional(playerid, sr_akschoose_PTD[playerid][0], 1);
			PlayerTextDrawSetShadow(playerid, sr_akschoose_PTD[playerid][0], 0);
		}
	}
	else if( GetServerVarAsInt("port") == 7778 || GetServerVarAsInt("port") == 1505 )
	{
		if(sr_akschoose_PTD[playerid][0] == PlayerText:INVALID_TEXT_DRAW)
		{
			sr_akschoose_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 293.000000, 360.000000, "99_999_999");
			PlayerTextDrawLetterSize(playerid, sr_akschoose_PTD[playerid][0], 0.309666, 2.234667);
			PlayerTextDrawAlignment(playerid, sr_akschoose_PTD[playerid][0], 1);
			PlayerTextDrawColor(playerid, sr_akschoose_PTD[playerid][0], -1);
			PlayerTextDrawSetShadow(playerid, sr_akschoose_PTD[playerid][0], 0);
			PlayerTextDrawBackgroundColor(playerid, sr_akschoose_PTD[playerid][0], 255);
			PlayerTextDrawFont(playerid, sr_akschoose_PTD[playerid][0], 2);
			PlayerTextDrawSetProportional(playerid, sr_akschoose_PTD[playerid][0], 1);
		}
	}


	return true;
}

//


stock textdraw_aks_select(playerid, status, type_salon)
{
	
	switch(status)
	{
		case TEXTDRAW_SHOW:
		{
			switch(type_salon)
			{
				case BUISNES_ACCESSORIES:
				{
					create_aks_shop_price(playerid);
				
					for(new i = 0; i < 5; i ++) TextDrawShowForPlayer(playerid, sr_akschoose_TD[i]);
					PlayerTextDrawShow(playerid, sr_akschoose_PTD[playerid][0]);
				}
			}
			SelectTextDraw(playerid, 0xFFFF00FF);


		}
		case TEXTDRAW_HIDE:
		{
			for(new i = 0; i < 5; i ++) TextDrawHideForPlayer(playerid, sr_akschoose_TD[i]);
			PlayerTextDrawHideEx(playerid, sr_akschoose_PTD[playerid][0]);

			CancelSelectTextDraw(playerid);

		}
		case TEXTDRAW_UPDATE:
		{
			new 
				format_str[32];

			new 
				aks_id = aks_select_count[playerid];


		 	format(format_str, sizeof(format_str),"%d", get_aks_price(playerid, aks_id));
		 	PlayerTextDrawSetString(playerid, sr_akschoose_PTD[playerid][0], format_str);

		}
	}

	return true;
}

//

stock show_aks_start_1(playerid, type)
{

	switch(type)
	{
		case 1:
		{
			InterpolateCameraPos(playerid, -652.416687, -712.183105, 1202.757324, -649.101318, -713.672790, 1202.706176, 2000);
			InterpolateCameraLookAt(playerid, -651.544372, -717.102661, 1202.565307, -644.281311, -715.002136, 1202.693237, 2000);
			SetPPos(playerid, -647.5887,-714.1224,1201.9475);
			SetPlayerFacingAngle(playerid, 41.0516);
			TogglePlayerControllable(playerid, false);

			aks_select_count[playerid] = 0;

			textdraw_aks_select(playerid, TEXTDRAW_SHOW, BUISNES_ACCESSORIES);
			//textdraw_aks_select(playerid, TEXTDRAW_UPDATE, BUISNES_ACCESSORIES);

			new 
				skin = GetPlayerSkin(playerid);
			temp_magazin_aks_slot_0[playerid] = get_aks_id(playerid, aks_select_count[playerid]);
			AttachAcsToPlayerMagazin(playerid, skin);

		}
		case 2:
		{
			InterpolateCameraPos(playerid, -652.039978, -713.426818, 1202.789794, -648.435974, -713.340148, 1202.606323, 2000);
			InterpolateCameraLookAt(playerid, -650.059997, -718.012939, 1202.572998, -644.792358, -716.763244, 1202.687011, 2000);
			SetPPos(playerid, -647.5887,-714.1224,1201.9475);
			SetPlayerFacingAngle(playerid, 41.0516);
			TogglePlayerControllable(playerid, false);

			aks_select_count[playerid] = 0;

			textdraw_aks_select(playerid, TEXTDRAW_SHOW, BUISNES_ACCESSORIES);
			//textdraw_aks_select(playerid, TEXTDRAW_UPDATE, BUISNES_ACCESSORIES);

			new 
				skin = GetPlayerSkin(playerid);
			temp_magazin_aks_slot_1[playerid] = get_aks_id(playerid, aks_select_count[playerid]);
			AttachAcsToPlayerMagazin(playerid, skin);


		}
		case 3:
		{
			InterpolateCameraPos(playerid, -651.272399, -713.939880, 1202.620117, -647.914855, -715.678222, 1202.529296, 2000);
			InterpolateCameraLookAt(playerid, -648.857849, -718.317626, 1202.692626, -646.380065, -710.934936, 1202.147338, 2000);
			SetPPos(playerid, -647.5887,-714.1224,1201.9475);
			SetPlayerFacingAngle(playerid, 41.0516);
			TogglePlayerControllable(playerid, false);

			aks_select_count[playerid] = 0;

			textdraw_aks_select(playerid, TEXTDRAW_SHOW, BUISNES_ACCESSORIES);
			//textdraw_aks_select(playerid, TEXTDRAW_UPDATE, BUISNES_ACCESSORIES);

			new 
				skin = GetPlayerSkin(playerid);
			temp_magazin_aks_slot_2[playerid] = get_aks_id(playerid, aks_select_count[playerid]);
			AttachAcsToPlayerMagazin(playerid, skin);

		}
	}
				
	for(new i; i<7; i++)
	{
		if(IsPlayerAttachedObjectSlotUsed(playerid, i))
			RemovePlayerAttachedObject(playerid, i);
	}
	return true;
}

stock get_aks_price(playerid, index) 
{
	new 
		price;

	if(GetPVarInt(playerid, "type_select_aks") == 1)
	{
		switch(index)
		{
			case 0: price = 25000;
			case 1: price = 25000;
			case 2: price = 100000;
			case 3: price = 75000;
			case 4: price = 50000;
			case 5, 6: price = 10000000;
			default: price = 100000;
		}
		return price;
	}
	else if(GetPVarInt(playerid, "type_select_aks") == 2)
	{
		switch(index)
		{
			case 0: price = 50000;
			case 1: price = 50000;
			case 2: price = 25000;
			case 3: price = 150000;
			case 4: price = 500000;
			case 5: price = 350000;
			case 6: price = 300000;
			case 7: price = 800000;
			case 8: price = 1000000;
			case 9: price = 100000;
			case 10: price = 1500000;
			case 11: price = 1500000;
			case 12: price = 50000000;
			case 13..17: price = 10000000;
			case 18: price = 100000000;
			case 19: price = 10000000;
			case 20, 21: price = 10000000;
			default: price = 1500000;
		}
		return price;
	}
	else if(GetPVarInt(playerid, "type_select_aks") == 3)
	{
		switch(index)
		{
			case 0: price = 25000;
			case 1: price = 25000;
			case 2: price = 100000;
			case 3: price = 100000;
			case 4: price = 50000;
			case 5: price = 50000;
			case 6: price = 50000;
			default: price = 1500000;
		}
		return price;
	}	
	return true;
}

stock get_aks_id(playerid, index) 
{
	if(GetPVarInt(playerid, "type_select_aks") == 1)
	{
		return all_aks_params_kap[index];
	}
	else if(GetPVarInt(playerid, "type_select_aks") == 2)
	{
		return all_aks_params_mask[index];
	}	
	else if(GetPVarInt(playerid, "type_select_aks") == 3)
	{
		return all_aks_params_back[index];
	}
	return true;	
}

stock ValidAcsSlot(playerid)
{
	for(new i; i<7; i++)
	{
		if(IsPlayerAttachedObjectSlotUsed(playerid, i))
			RemovePlayerAttachedObject(playerid, i);
	}
	return true;
}

stock AttachAcsToPlayerMagazin(playerid, skin)
{
	ValidAcsSlot(playerid);// Проверяем занятые слоты аттачей

