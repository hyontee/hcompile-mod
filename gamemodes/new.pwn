{
    if(PI[playerid][pAdmin] > 0 && !number) return 1;
    /*) new string[144],name[24];
    GetPlayerName(playerid, name, 24);
    switch(number)
    {
        case 6,8,9:
        {
            format(string, sizeof(string), "{FF6600}[ANTICHEAT] %s Подозревается в коде: %d, /re %d",name, number, playerid);
            SendAdminMessage(COLOR_LIGHTRED, string);
            return 1;
