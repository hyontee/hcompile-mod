    case 8810:
        {
            if(response)
            {
                switch(listitem)
                {
                case 0: return SPD(playerid, 3245, DIALOG_STYLE_LIST,"Управление счетами", "1. Мои счета\n2. Открыть новый счет", "Выбрать", "Назад");
                case 1:
                    {
                        if(GetPlayerBizz(playerid) > 0) ShowPlayerDialog(playerid, 2929, 1, "Пополнить счет бизнеса", "Введите колличество дней для оплаты бизнеса\n\nПримечание:\tОт 1 до 7 дней", "Пополнить", "Назад");
                        else SCM(playerid, 0, "Вы не бизнесмен!");
                        return 1;
                    }
                case 2:
                    {
                        if(PI[playerid][pPhousekey] == 255) return SCM(playerid, 0, "У вас нет дома");
                        SPD(playerid, 9521, DIALOG_STYLE_LIST, ""SERVER"Банкомат","- на 2 дней\n- на 7 дней\n- на 30 дней","Перевести", "Выход");
                        return 1;
                    }
                case 3:
                    {
                        if(PI[playerid][pHousecash] <=0) return SCM(playerid, 0, "Нет денег за ваш дом");
                        GiveMoney(playerid, PI[playerid][pHousecash]);
                        SendMes(playerid,COLOR_WHITE,"::: Вам возвращены %d руб. за ваш дом :::", PI[playerid][pHousecash]);
                        PI[playerid][pHousecash] = 0;
                        return 1;
                    }
	                case 4:
					{
						new bizz = GetPlayerBizz(playerid);
						if(bizz == 0) return SCM(playerid, 0,"У вас нет бизнеса");
						format(stringer1, sizeof(stringer1), "\
							{ffffff}1 единица продукции стоит {3399FF}50 рублей\n\
							{ffffff}Максимальное количество продуктов которое можно сейчас заказать {3399FF}%d ед.\n\n\
							{ffffff}Введите кол-во продуктов:", 20000-BizzInfo[bizz][bProduct]);

						SPD(playerid, 2928, DIALOG_STYLE_INPUT, "Продукты", stringer1, "Принять", "Назад");
					}
				}
            }
            else return GameTextForPlayer(playerid, "~g~Good Luck", 1000, 1);
        }
