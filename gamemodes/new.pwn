cmd:unloadmats(playerid) {

    if(PI[playerid][pMember] != 19)
        return 1;

    new vehicleid = GetPlayerVehicleID(playerid);

    if(GetVehicleModel(vehicleid) != 433) return 1;

    if(MatHaul[vehicleid][mLoad] == 0)
        return 1;

    if(IsPlayerInRangeOfPoint(playerid, 5.0, 1752.2721, 1736.0911, 15.8086)) {
        SCM(playerid, 2, "Вы разгрузили грузовик на складе армии.");
        MatHaul[vehicleid][mLoad] = 0;
        Iter_Remove(mcVehicles, GetPlayerVehicleID(playerid));
    }
    else if(IsPlayerInRangeOfPoint(playerid, 5.0, 2544.5447, -2440.3582, 22.0056)) {
        SCM(playerid, 2, "Вы разгрузили грузовик на складе МВД г. Южный.");
        MatHaul[vehicleid][mLoad] = 0;
        Iter_Remove(mcVehicles, GetPlayerVehicleID(playerid));
    }
    else if(IsPlayerInRangeOfPoint(playerid, 5.0, 1820.8096, 2129.1072, 15.8462)) {
        SCM(playerid, 2, "Вы разгрузили грузовик на складе ФСБ.");
        MatHaul[vehicleid][mLoad] = 0;
        Iter_Remove(mcVehicles, GetPlayerVehicleID(playerid));
    }
    else if(IsPlayerInRangeOfPoint(playerid, 5.0, 1906.8932, -2203.4888, 11.2457)) {
        SCM(playerid, 2, "Вы разгрузили грузовик на складе армии.");
        MatHaul[vehicleid][mLoad] = 0;
        Iter_Remove(mcVehicles, GetPlayerVehicleID(playerid));
    }

    return true;
}

