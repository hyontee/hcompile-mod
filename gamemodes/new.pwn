cmd:kickbox(playerid, params[])
{
    if(PI[playerid][pKickboxSkill] < 5000) return SendClientMessage(playerid, 0x8C7447AA, "Ваш навык владения данным видом боегого искусства слишком низок");
    SetPlayerFightingStyle (playerid, FIGHT_STYLE_KNEEHEAD);
