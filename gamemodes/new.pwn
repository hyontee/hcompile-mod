stock job_rent_bus(playerid)
{

	new
		price = 5000;

	if(PI[playerid][pCash] < price)
	{
		SendClientMessage(playerid, COLOR_WHITE, !"~ Недостаточно денежных средств!");
		return true;
	}
	PI[playerid][pCash] -= price;

	work_bus_create(playerid);

	if(GetPVarInt(playerid, "bus_route_1") == 1)
	{
		driver_bus_route_1++;
	}
	if(GetPVarInt(playerid, "bus_route_2") == 1)
	{
		driver_bus_route_2++;
	}

	SetPVarInt(playerid, "bus_job_cp", 1);

	DisablePlayerCheckpoint(playerid);
	PicCP[playerid] = 0;
	DisablePlayerRaceCheckpoint(playerid);

	bus_next_cp(playerid);

	SendClientMessage(playerid, COLOR_WHITE, "Для того чтобы отменить аренду, используйте команду: /unrent");
	return true;
}

stock bus_station_count(playerid)
{
	SetPVarInt(playerid,"bus_job_salary", GetPVarInt(playerid,"bus_job_salary") + BUS_JOB_SALARY_PER_CP);
	SetPVarInt(playerid,"bus_job_cp_count", GetPVarInt(playerid,"bus_job_cp_count") + 1);
	return true;
}

stock ProxDetector_NEW(Float:radius, playerid, string[], color1 = -1, color2 = -1, color3 = -1, color4 = -1, color5 = -1)
{
	new Float: X,
		Float: Y,
		Float: Z,
		virtual_world = GetPlayerVirtualWorld(playerid);
	GetPlayerPos(playerid, X, Y, Z);
	foreach(new i: Player)
	{
		if(virtual_world == GetPlayerVirtualWorld(i))
		{
			if(IsPlayerInRangeOfPoint(i, radius/5.0*5.0, X, Y, Z)) SendClientMessage(i, color1, string);
			else if(IsPlayerInRangeOfPoint(i, radius/5.0*4.0, X, Y, Z)) SendClientMessage(i, color2, string);
			else if(IsPlayerInRangeOfPoint(i, radius/5.0*3.0, X, Y, Z)) SendClientMessage(i, color3, string);
			else if(IsPlayerInRangeOfPoint(i, radius/5.0*2.0, X, Y, Z)) SendClientMessage(i, color4, string);
			else if(IsPlayerInRangeOfPoint(i, radius/5.0*1.0, X, Y, Z)) SendClientMessage(i, color5, string);
		}
	}
	return 1;
}

stock bus_station_for_driver(playerid)
{
	create_bus_timer_p(playerid);

	SetPVarInt(playerid, "bus_in_station", 1);

	DisablePlayerRaceCheckpoint(playerid);
	bus_station_count(playerid);
	TogglePlayerControllable(playerid, false);
	SetTimerEx("bus_station", 1000, false, "ii", playerid, BUS_JOB_STATION_TIME);

	SetPVarInt(playerid, "bus_station_name", GetPVarInt(playerid, "bus_station_name")+1);

	if(GetPVarInt(playerid, "bus_route_1") == 1)
	{
		new
			bus_name_st_count = GetPVarInt(playerid, "bus_station_name");

		ProxDetector_NEW(30.0,playerid,"",0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF);
		format(String256, sizeof(String256),"• {00CC00}[Остановка] {FFFFFF}Маршрутка отправляется через {00CC00}%d{FFFFFF} секунд!", BUS_JOB_STATION_TIME);
		ProxDetector_NEW(30.0,playerid,String256,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF);
		format(String256, sizeof(String256),"• {00CC00}[Остановка] {FFFFFF}Следующая остановка - {00CC00}%s{FFFFFF}", get_name_next_st_bus_1(bus_name_st_count));
		ProxDetector_NEW(30.0,playerid,String256,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF);
		format(String256, sizeof(String256),"• {00CC00}[Остановка] {FFFFFF}Пожалуйста, оплатите проезд и займите свои места!");
		ProxDetector_NEW(30.0,playerid,String256,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF);
	}

	return true;
}

stock bus_station_final(playerid)
{
	new
		final_salary,
		fmt_str[200];

	DisablePlayerRaceCheckpoint(playerid);
	bus_station_count(playerid);

	new
		job_count_rout = SetPVarInt(playerid, "job_count_route", GetPVarInt(playerid, "job_count_route")+1);

	if(GetPVarInt(playerid, "bus_route_1") == 1)
	{
		final_salary = job_count_rout*2000000;
	}
	else if(GetPVarInt(playerid, "bus_route_2") == 1)
	{
		final_salary = job_count_rout*2500000;
	}
	
	if(PI[playerid][pReisAutobus] == 10)
	{
	 ShowNotification(playerid, 2, "Вы выполнили квест \"Автобусник\"! Ваша награда: 25 DONATE-RUB", 4, "", "");
    PI[playerid][pDonateRubNew] += 25;
    UpdatePlayerData(playerid, "pDonateRubNew", PI[playerid][pDonateRubNew]);
		    PI[playerid][P_QUEST][3] = 1;
		    UpdatePlayerData(playerid, "quest_3", PI[playerid][P_QUEST][3]);
	}
	PI[playerid][pReisAutobus] += 1;
	UpdatePlayerData(playerid, "pReisAutobus", PI[playerid][pReisAutobus]);

	format(fmt_str, 200, "\
		{FFFFFF}Хотите проехать еще раз маршрут?\n\
		Вы уже проехали "SERVER"%i{FFFFFF} раз и заработали: {33aa33}%i{FFFFFF} рублей", job_count_rout, final_salary);
	return ShowPlayerDialog(playerid, 8714, DIALOG_STYLE_MSGBOX, !""SERVER"Продолжение работы", fmt_str, !"Согласен", !"Закончить");
}

stock bus_next_cp(playerid)
{
	new
		cp = GetPVarInt(playerid, "bus_job_cp"),
		len_str = sizeof bus_checkpoints_1 - 1,
		cp_next = cp + 1;


	if(cp_next > len_str) cp_next = 1;
	if(len_str < cp < 1)
		return true;


	if(bus_checkpoints_1[cp][3] == STATION)
		return bus_station_for_driver(playerid);

	if(bus_checkpoints_1[cp][3] == FINAL_STATION)
		return bus_station_final(playerid);



	SetPlayerRaceCheckpoint(playerid, 3,
		bus_checkpoints_1[cp][0], bus_checkpoints_1[cp][1], bus_checkpoints_1[cp][2],
		bus_checkpoints_1[cp_next][0], bus_checkpoints_1[cp_next][1], bus_checkpoints_1[cp_next][2] - 2.0, 4.0);

	cp++;
	if(cp > len_str) cp = 1;


	bus_station_count(playerid);
	SetPVarInt(playerid, "bus_job_cp", cp);

	return true;
}

stock bus_next_cp_2(playerid)
{
	new
		cp = GetPVarInt(playerid, "bus_job_cp"),
		len_str = sizeof bus_checkpoints_2 - 1,
		cp_next = cp + 1;


	if(cp_next > len_str) cp_next = 1;
	if(len_str < cp < 1)
		return true;


	if(bus_checkpoints_2[cp][3] == FINAL_STATION)
		return bus_station_final(playerid);



	SetPlayerRaceCheckpoint(playerid, 3,
		bus_checkpoints_2[cp][0], bus_checkpoints_2[cp][1], bus_checkpoints_2[cp][2],
		bus_checkpoints_2[cp_next][0], bus_checkpoints_2[cp_next][1], bus_checkpoints_2[cp_next][2] - 2.0, 4.0);

	cp++;
	if(cp > len_str) cp = 1;


	bus_station_count(playerid);
	SetPVarInt(playerid, "bus_job_cp", cp);

	return true;
}

stock create_bus_timer_p(playerid)
{
	bus_timer_p[playerid] = CreatePlayerTextDraw(playerid, 555.000000, 215.288894, "10"); // Text element
	PlayerTextDrawLetterSize(playerid, bus_timer_p[playerid] , 0.607666, 2.541628);
	PlayerTextDrawAlignment(playerid, bus_timer_p[playerid] , 2);
	PlayerTextDrawColor(playerid, bus_timer_p[playerid] , 1304556543);
	PlayerTextDrawUseBox(playerid, bus_timer_p[playerid] , true);
	PlayerTextDrawBoxColor(playerid, bus_timer_p[playerid] , 0);
	PlayerTextDrawSetShadow(playerid, bus_timer_p[playerid] , 2);
	PlayerTextDrawSetOutline(playerid, bus_timer_p[playerid] , 0);
	PlayerTextDrawBackgroundColor(playerid, bus_timer_p[playerid] , 20);
	PlayerTextDrawFont(playerid, bus_timer_p[playerid] , 1);
	PlayerTextDrawSetProportional(playerid, bus_timer_p[playerid] , 1);

	return true;
}

publics: bus_station(i, time)
{
	new
		Float:x, Float:y, Float:z;

	GetPlayerPos(i, x, y, z);


	time--;

	format(String64, 32,"%i", time);
	PlayerTextDrawSetString(i, bus_timer_p[i], String64);
	PlayerTextDrawShow(i, bus_timer_p[i]);

	if(!time)
	{
		SetPVarInt(i, "bus_job_cp", GetPVarInt(i, "bus_job_cp")+1);
		TogglePlayerControllable(i, true);


		PlayerTextDrawHide(i, bus_timer_p[i]);
		PlayerTextDrawDestroy(i, bus_timer_p[i]);

		DeletePVar(i, "bus_in_station");

		if(GetPVarInt(i, "bus_route_1") == 1)
		{
			bus_next_cp(i);
		}
		else if(GetPVarInt(i, "bus_route_2") == 1)
		{
			bus_next_cp_2(i);
		}
	}
	else
	{
		SetTimerEx("bus_station", 1000, false, "ii", i, time);
	}

	return true;
}

stock work_bus_create(playerid)
{
	new
		c1,
		c2;

	if(GetPVarInt(playerid, "bus_route_1") == 1)
	{
		c1 = 7,
		c2 = 7;
	}
	else if(GetPVarInt(playerid, "bus_route_1") == 2)
	{
		c1 = 3,
		c2 = 3;
	}

	new
		bus_veh = CreateVehicle(418, -575.2104,888.6608,12.3600,181.5192, c1, c2, 600);

	PutPlayerInVehicle(playerid, bus_veh, 0);

	moped_online[playerid] = bus_veh;

	TogglePlayerControllable(playerid, true);

	return true;

}

stock work_bus_unrent(playerid)
{
	if(!GetPVarInt(playerid, "bus_job_cp")) return true;
	new
		v = moped_online[playerid];

	if(v == INVALID_VEHICLE_ID)
		return true;

	DestroyVehicle(v);
	DisablePlayerRaceCheckpoint(playerid);

	moped_online[playerid] = INVALID_VEHICLE_ID;

	if(GetPVarInt(playerid, "bus_route_1") == 1)
	{
		driver_bus_route_1--;
	}
	if(GetPVarInt(playerid, "bus_route_2") == 1)
	{
		driver_bus_route_2--;
	}

	DeletePVar(playerid, "bus_route_1");
	DeletePVar(playerid, "bus_route_2");

	DeletePVar(playerid, "bus_station_name");

	DeletePVar(playerid, "bus_job_cp");
	DeletePVar(playerid, "bus_job_salary");
	DeletePVar(playerid, "bus_job_cp_count");
	DeletePVar(playerid, "job_count_route");
	return true;
}

