stock menu_bind_command_general(playerid)
{
    format(String1024,sizeof(String1024),"{afafaf}Наименование\t{afafaf}Команда\t\n\
    "SERVER"1. {FFFFFF}Бинд чата - B1\t /b1\n\
    "SERVER"2. {FFFFFF}Бинд чата - B2\t /b2\n\
    "SERVER"3. {FFFFFF}Бинд чата - B3\t /b3\n\
    "SERVER"4. {FFFFFF}Бинд чата - B4\t /b4\n\
    "SERVER"5. {FFFFFF}Бинд чата - B5\t /b5\n\
    "SERVER"6. {FFFFFF}Бинд чата - B6\t /b6\n\
    "SERVER"7. {FFFFFF}Бинд чата - B7\t /b7\n\
    "SERVER"8. {FFFFFF}Бинд чата - B8\t /b8\n\
