stock EncodeSelectedHouseProperty(bool:is_flat, property_id)
{
	return is_flat ? (property_id + 1000000) : property_id;
}

stock DecodeSelectedHouseProperty(selected, &bool:is_flat)
{
	if(selected >= 1000000)
	{
		is_flat = true;
		return selected - 1000000;
	}

	is_flat = false;
	return selected;
}


