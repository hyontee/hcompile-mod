stock bool:GetVehicleJsonNameByModelId(modelid, name[], size)
{
    for(new i = 0; i < sizeof(g_json_vehicle_names); i++)
    {
        if(g_json_vehicle_names[i][JVN_MODELID] == modelid)
        {
            format(name, size, "%s", g_json_vehicle_names[i][JVN_NAME]);
            return true;
        }
    }

    return false;
}


