CMD:addpadik(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 8) return SendClientMessage(playerid, 0xFF0000FF, "У вас недостаточно прав для использования этой команды.");

    extract params -> new type, price, rent_price; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /addpadik [тип всех квартир] [цена всех квартир] [цена аренды всех квартир]");

    if(!(1 <= type <= 2) && type != 5)
	{
		SendClientMessage(playerid, 0x999999FF, "Типы квартир:");
		SendClientMessage(playerid, 0x999999FF, "1. Квартира эконом класса");
        SendClientMessage(playerid, 0x999999FF, "2. Квартира среднего класса");
		SendClientMessage(playerid, 0x999999FF, "5. Квартира наивысшего класса");
		SendClientMessage(playerid, 0x999999FF, "Примечание: использовать исключительно указанные типы");
		return 1;
	}

    new new_entrance_idx = g_entrance_loaded;
    g_entrance_loaded++;

    GetPlayerPos(playerid, g_entrance[new_entrance_idx][E_POS_X], g_entrance[new_entrance_idx][E_POS_Y], g_entrance[new_entrance_idx][E_POS_Z]);
    GetPlayerPos(playerid, g_entrance[new_entrance_idx][E_EXIT_POS_X], g_entrance[new_entrance_idx][E_EXIT_POS_Y], g_entrance[new_entrance_idx][E_EXIT_POS_Z]);
    GetPlayerFacingAngle(playerid, g_entrance[new_entrance_idx][E_EXIT_ANGLE]);

    SetEntranceData(new_entrance_idx, E_FLOORS, 2);

    new fmt_text[512];
    format(fmt_text, sizeof fmt_text, "INSERT INTO entrances (floors, pos_x, pos_y, pos_z, exit_x, exit_y, exit_z, exit_angle) " \
        "VALUES ('%d', '%f', '%f', '%f', '%f', '%f', '%f', '%f')",
        GetEntranceData(new_entrance_idx, E_FLOORS),
        GetEntranceData(new_entrance_idx, E_POS_X),
        GetEntranceData(new_entrance_idx, E_POS_Y),
        GetEntranceData(new_entrance_idx, E_POS_Z),
        GetEntranceData(new_entrance_idx, E_EXIT_POS_X),
        GetEntranceData(new_entrance_idx, E_EXIT_POS_Y),
        GetEntranceData(new_entrance_idx, E_EXIT_POS_Z),
        GetEntranceData(new_entrance_idx, E_EXIT_ANGLE)
    );

    new Cache: result = mysql_query(mysql, fmt_text, true);
    if(cache_affected_rows() > 0)
    {
        new sql_id = cache_insert_id();
        SetEntranceData(new_entrance_idx, E_SQL_ID, sql_id);

        UpdateEntrance(new_entrance_idx, new_entrance_idx); 
 
        new city[MAX_ZONES_NAME + 1], area[MAX_ZONES_NAME + 1];
        GetCityName(GetEntranceData(new_entrance_idx, E_POS_X), GetEntranceData(new_entrance_idx, E_POS_Y), city);
        GetAreaName(GetEntranceData(new_entrance_idx, E_POS_X), GetEntranceData(new_entrance_idx, E_POS_Y), area);
        
        format(fmt_text, sizeof fmt_text, "[A] %s[%d] создал подъезд №%d (SQL ID: %d) (%s / %s)", GetPlayerNameEx(playerid), playerid, new_entrance_idx, sql_id, city, area);
        SendMessageToAdmins(fmt_text, 0x66CC33FF);
        
        SendClientMessage(playerid, 0x66CC33FF, "Подъезд успешно создан!");
        SendClientMessage(playerid, 0x3399FFFF, "Используйте {FFFF00}/esetexitpos {3399FF}- чтобы установить точные координаты выхода.");

        new query[256];
		new flat_number_counter;

		for(new floor = 1; floor <= GetEntranceData(new_entrance_idx, E_FLOORS); floor++)
        {
            flat_number_counter = 1; // Сбрасываем счетчик квартир для каждого нового этажа
            for(new i = 0; i < 4; i++)
            {
                format(query, sizeof(query), "INSERT INTO houses (price, rent_price, type, entrance, flat_floor, flat_number)" \
                    "VALUES ('%d', '%d', '%d', '%d', '%d', '%d')",
                    price,
                    rent_price,
                    type,
                    sql_id,
                    floor, // Используем переменную цикла floor
                    flat_number_counter // Используем счетчик flat_number_counter
                );
                mysql_query(mysql, query, false);
                flat_number_counter++;
            }
        }
        SendClientMessage(playerid, 0x66CC33FF, "Все квартиры для подъезда успешно созданы!");
        // =============================================================
    }
    else
    {
        g_entrance_loaded--;
        
        printf("Ошибка выполнения запроса: %s", mysql_errno(mysql));
        SendClientMessage(playerid, 0xFF0000FF, "Ошибка при добавлении подъезда.");
    }

    return 1;
}

CMD:esetexitpos(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Данная команда не доступна на ТЕСТ СЕРВЕРЕ!");
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new house_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /esetexitpos [id подъезда]");

	if(!(0 <= house_id <= g_entrance_loaded - 1)) return SendClientMessage(playerid, 0x999999FF, "Данного подъезда не существует на сервере");

	GetPlayerPos(playerid, g_entrance[house_id][E_EXIT_POS_X], g_entrance[house_id][E_EXIT_POS_Y], g_entrance[house_id][E_EXIT_POS_Z]);
	GetPlayerFacingAngle(playerid, g_entrance[house_id][E_EXIT_ANGLE]);

	new fmt_text[144];

	format
	(
		fmt_text, sizeof fmt_text,
		"UPDATE entrances SET exit_x='%f', exit_y='%f', exit_z='%f', exit_angle='%f' WHERE id=%d",
		GetEntranceData(house_id, E_EXIT_POS_X),
		GetEntranceData(house_id, E_EXIT_POS_Y),
		GetEntranceData(house_id, E_EXIT_POS_Z),
		GetEntranceData(house_id, E_EXIT_ANGLE),
		GetEntranceData(house_id, E_SQL_ID)
	);

	mysql_query(mysql, fmt_text, false);

	format(fmt_text, sizeof fmt_text, "Вы успешно изменили координаты выхода у подэезда №%d", house_id);

	SendClientMessage(playerid, 0x66CC33FF, fmt_text);

	return 1;
}

public: LoadFamilyCars()
{
    new rows, vehicleid;
    new Cache: result;
    result = mysql_query(mysql, "SELECT * FROM `family_auto` WHERE 1", true);
    rows = cache_num_rows();
    for(new idx; idx < rows; idx ++)
    {
        SetFamilyCarData(idx, F_SQL_ID,       cache_get_field_content_int(idx, "id"));
        new idm = GetFamilyData(idx, F_SQL_ID);
        SetFamilyCarData(idm, F_OWNER_ID,     cache_get_field_content_int(idx, "owner_id"));
        SetFamilyCarData(idm, F_MODEL_ID,     cache_get_field_content_int(idx, "model_id"));
        SetFamilyCarData(idm, F_COLOR_1,      cache_get_field_content_int(idx, "color_1"));
        SetFamilyCarData(idm, F_COLOR_2,      cache_get_field_content_int(idx, "color_2"));
        SetFamilyCarData(idm, F_RANG,         cache_get_field_content_int(idx, "rang"));
        SetFamilyCarData(idm, F_POS_X,        cache_get_field_content_float(idx, "pos_x"));
        SetFamilyCarData(idm, F_POS_Y,        cache_get_field_content_float(idx, "pos_y"));
        SetFamilyCarData(idm, F_POS_Z,        cache_get_field_content_float(idx, "pos_z"));
        SetFamilyCarData(idm, F_ANGLE,        cache_get_field_content_float(idx, "angle"));
        SetFamilyCarData(idm, OC_FUEL,        cache_get_field_content_float(idx, "mileage"));
        
        vehicleid = CreateVehicle
        (
            GetFamilyCarData(idm, F_MODEL_ID),
            GetFamilyCarData(idm, F_POS_X),
            GetFamilyCarData(idm, F_POS_Y),
            GetFamilyCarData(idm, F_POS_Z),
            GetFamilyCarData(idm, F_ANGLE),
            GetFamilyCarData(idm, F_COLOR_1),
            GetFamilyCarData(idm, F_COLOR_2),
            -1, 0,
            VEHICLE_ACTION_TYPE_FAMILY_CAR,
            GetFamilyData(idx, F_SQL_ID)
        );
        
        if(vehicleid != INVALID_VEHICLE_ID)
        {
            CreateVehicleLabel(vehicleid, GetFamilyData(GetFamilyCarData(idm, F_OWNER_ID), F_NAME), 0x6666CCEE, 0.0, 0.0, 1.3, 20.0);
            SetVehicleParam(vehicleid, V_LOCK, bool: cache_get_field_content_int(0, "status"));
            SetVehicleData(vehicleid, V_MILEAGE, cache_get_field_content_float(0, "mileage"));
        }
    }
    g_family_car_loaded = rows;
    cache_delete(result);
    printf("[FamilyCars]: Aвто загружено: %d", g_family_car_loaded);
}

stock GetFreeFamilyCarID()
{
    for(new idx; idx < sizeof g_ownable_car; idx ++)
    {
        if(GetOwnableCarData(idx, OC_CREATE)) continue;

        return idx;
    }

    return -1;
}

public: SaveFamilyCar(vehicleid)
{
    if(IsAFamilyCar(vehicleid))
    {
        new query[300];
        new index = GetVehicleData(vehicleid, V_ACTION_ID);
        new Float: health;
        GetVehicleHealth(vehicleid, health);
        mysql_format(mysql, query, sizeof query,
            "UPDATE `family_auto` SET pos_x=%f, pos_y=%f, pos_z=%f, angle=%f WHERE id=%d LIMIT 1",
            GetFamilyCarData(index, F_POS_X),
            GetFamilyCarData(index, F_POS_Y),
            GetFamilyCarData(index, F_POS_Z),
            GetFamilyCarData(index, F_ANGLE),
            index-1
        );
        mysql_query(mysql, query, false);
        return mysql_errno();
    }
    return -1;
}

public OnIncomingRPC(playerid, rpcid, BitStream:bs)
{
    if(rpcid != 97) return 1;

    new action;
    if(!BS_ReadUint32(bs, action)) return 1;

    switch(action)
    {
        case 3:
        {
            new vehicleid;
            new turnStatus;

            if(!BS_ReadUint16(bs, vehicleid)) return 1;
            if(!BS_ReadUint8(bs, turnStatus)) return 1;

            if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 1;
            if(!IsValidVehicle(vehicleid)) return 1;
            if(GetPlayerVehicleID(playerid) != vehicleid) return 1;
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
            if(turnStatus < 1 || turnStatus > 3) return 1;

            if(TurnSignalState[vehicleid] == turnStatus && TurnSignalDriver[vehicleid] == playerid)
            {
                StopVehicleTurnSignal(vehicleid);
                printf("[TurnSignal] Player %d turned OFF turn signal on vehicle %d", playerid, vehicleid);
            }
            else
            {
                StopVehicleTurnSignal(vehicleid);
                StartVehicleTurnSignal(playerid, vehicleid, turnStatus);

                new statusText[16];
                if(turnStatus == 1) statusText = "LEFT";
                else if(turnStatus == 2) statusText = "RIGHT";
                else statusText = "HAZARD";

                printf("[TurnSignal] Player %d turned ON %s turn signal on vehicle %d (Model: %d)",
                       playerid, statusText, vehicleid, GetVehicleModel(vehicleid));
            }
            return 1;
        }

        case 4:
        {
            callcmd::radial(playerid);
            return 1;
        }
    }

    return 1;
}

stock SetVehicleVinyl(vehicleid, texture[], setvalue=0)
{
	if(setvalue) format(vInfo[vehicleid][vVinylTexture], 16, texture); 
	foreach(new playerid : streamed_players_in_veh[vehicleid]) SetVehicleVinylForPlayer(playerid, vehicleid, texture);
} 

stock SetVehicleVinylForPlayer(playerid, vehicleid, texture[])
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, vehicleid);
	BS_WriteValue(bitstream, PR_UINT8, 12);

	BS_WriteValue(bitstream, PR_UINT8, strlen(texture));
	BS_WriteValue(bitstream, PR_STRING, texture); 

	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
}

CMD:setvinyl(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsPlayerInAnyVehicle(playerid)) return 1;
  
    new texture[32];
    if(sscanf(params, "s[32]", texture)) 
        return SendClientMessage(playerid, -1, "Использование: /setvinyl [текстура]");
    
    SetVehicleVinyl(vehicleid, texture, 1);
    SendClientMessage(playerid, -1, "Винил установлен!");
    return 1;
}

stock BT_GetTuneVehicle(playerid)
{
	if(!IsPlayerInAnyVehicle(playerid))
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Вы должны находиться в транспорте");
		return INVALID_VEHICLE_ID;
	}

	new vehicleid = GetPlayerVehicleID(playerid);
	if(!IsValidVehicle(vehicleid))
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Транспорт не найден");
		return INVALID_VEHICLE_ID;
	}
	return vehicleid;
}

stock BT_RGBAtoARGB(rgba)
{
	return ((rgba & 0xFFFFFF00) >> 8) | ((rgba & 0xFF) << 24);
}


stock BT_SetToner(veh, front, rear, front_side, back_side)
{
	foreach(new i : streamed_players_in_veh[veh])
	{
		BT_SetTonerFP(i, veh, front, rear, front_side, back_side);
	}
	return 1;
}

stock BT_SetTonerFP(playerid, veh, front, rear, front_side, back_side)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 0);
	BS_WriteValue(bitstream, PR_UINT32, front);
	BS_WriteValue(bitstream, PR_UINT32, rear);
	BS_WriteValue(bitstream, PR_UINT32, front_side);
	BS_WriteValue(bitstream, PR_UINT32, back_side);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

stock BT_SetClearance(veh, clearance)
{
	foreach(new i : streamed_players_in_veh[veh])
	{
		BT_SetClearanceFP(i, veh, clearance);
	}
	return 1;
}

stock BT_SetClearanceFP(playerid, veh, clearance)
{
	new BitStream:bitstream = BS_New();
	new Float:change = clearance / 50.0;
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 1);
	BS_WriteValue(bitstream, PR_FLOAT, change);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

