stock GetQuestLineName(quest_id, output[], output_size)
{
	switch(quest_id)
	{
		case 1: format(output, output_size, "Первый шаг");
		case 2: format(output, output_size, "Без связи никуда");
		case 3: format(output, output_size, "Первая тачка");
		case 4: format(output, output_size, "Пора приодеться");
		case 5: format(output, output_size, "Модный приговор");
		case 6: format(output, output_size, "Самый активный");
		case 7: format(output, output_size, "Среди своих");
		case 8: format(output, output_size, "Новые возможности");
		case 9: format(output, output_size, "Подводный исследователь");
		case 10: format(output, output_size, "Шины и колеса");
		case 11: format(output, output_size, "Развозчик вкуснятины");
		case 12: format(output, output_size, "Киберспортсмен");
		case 13: format(output, output_size, "Почти лидер");
		case 14: format(output, output_size, "Сам себе механик");
		case 15: format(output, output_size, "Полноценный лидер");
		default: format(output, output_size, "Неизвестный квест");
	}
	return 1;
}

stock GetQuestLineStatus(playerid, quest_id)
{
	switch(quest_id)
	{
		case 1: return GetPlayerData(playerid, P_QUEST_1);
		case 2: return GetPlayerData(playerid, P_QUEST_2);
		case 3: return GetPlayerData(playerid, P_QUEST_3);
		case 4: return GetPlayerData(playerid, P_QUEST_4);
		case 5: return GetPlayerData(playerid, P_QUEST_5);
		case 6: return GetPlayerData(playerid, P_QUEST_6);
		case 7: return GetPlayerData(playerid, P_QUEST_7);
		case 8: return GetPlayerData(playerid, P_QUEST_8);
	}
	return 0;
}

