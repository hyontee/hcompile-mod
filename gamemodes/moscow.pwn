							buses[playerid] = AddStaticVehicleEx(414, -133.871093,938.719665,11.914908,62.030265, 6, 1, -1, 0, VEHICLE_ACTION_TYPE_BUS_DRIVER);
							PutPlayerInVehicle(playerid, buses[playerid], 0);
							Dialog
