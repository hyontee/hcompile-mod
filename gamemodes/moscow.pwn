							{
								callcmd::park(playerid, "");
							}
							case 7: // Выгрузить транспорт
{
    new vehicleid = GetPlayerOwnableCar(playerid);
    if(vehicleid != INVALID_VEHICLE_ID)
    {
        // Сохраняем текущую позицию как координаты выгрузки
        new index = GetVehicleData(vehicleid, V_ACTION_ID);
        GetVehiclePos(vehicleid, 
            g_ownable_car[index][OC_UNLOAD_X],
            g_ownable_car[index][OC_UNLOAD_Y],
            g_ownable_car[index][OC_UNLOAD_Z]
        );
        GetVehicleZAngle(vehicleid, g_ownable_car[index][OC_UNLOAD_ANGLE]);
        
        // Обновляем в БД
        new query[256];
        mysql_format(mysql, query, sizeof query,
            "UPDATE ownable_cars SET unload_x=%f, unload_y=%f, unload_z=%f, unload_angle=%f WHERE id=%d",
            g_ownable_car[index][OC_UNLOAD_X],
            g_ownable_car[index][OC_UNLOAD_Y],
            g_ownable_car[index][OC_UNLOAD_Z],
            g_ownable_car[index][OC_UNLOAD_ANGLE],
            GetOwnableCarData(index, OC_SQL_ID)
        );
        mysql_query(mysql, query, false);
        
        if(UnloadPlayerOwnableCar(playerid))
        {
            launch[playerid] = 0;
            diski[playerid] = 0;
            fars[playerid] = 0;
            nitro[playerid] = 0;
            tune_highlight[playerid] = 0;
            tune_stroboscope[playerid] = 0;
            
            new fmt_msg[128];
            format(fmt_msg, sizeof(fmt_msg), ""SC"Транспорт выгружен. Позиция выгрузки сохранена для следующей загрузки.");
            SendClientMessage(playerid, 0x66CC33FF, fmt_msg);
        }
    }
}
                            case 8: // Добавить авто в семью
{
  								if(GetPlayerRangFamily(playerid) == 5 && GetPlayerIdFamily(playerid) != -1)
   							   {
       								new f = GetPlayerIdFamily(playerid);

       								new current_cars = GetFamily(f, family_count_veh);
       								new max_slots = GetFamily(f, family_slot_veh);

       								if(current_cars == max_slots)
       								{
           								SendClientMessage(playerid, -1, ""c_f_r"В семье нет свободных слотов для транспорта!");
           								return 1;
       								}

      								 new index = GetVehicleData(vehicleid, V_ACTION_ID);
       								MoveOwnableCar(playerid, GetOwnableCarData(index, OC_SQL_ID), GetFamily(f, family_database));
