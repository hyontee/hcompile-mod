#define CheckMoney(%0,%1) \
    if(!HasPlayerMoney(%0, %1)) \
        return SendClientMessage(%0, 0xFF6600FF, ""USC"Недостаточно денег!");

#define CheckBank(%0,%1) \
    if(GetPlayerBankMoney(%0) < %1) \
        return SendClientMessage(%0, 0xFF6600FF, ""USC"Недостаточно средств на банковском счете!");


