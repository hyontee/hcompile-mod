			case DIALOG_FIND_HOUSE:
{
    if(!response) return 1;
    
    new house_id = GetPVarInt(playerid, "find_house_id");
    
    if(!(0 <= house_id <= g_house_loaded - 1))
        return SendClientMessage(playerid, 0x999999FF, ""USC"Дома с таким номером не существует на сервере");
    
    if(GetPlayerMoneyEx(playerid) < 300)
        return SendClientMessage(playerid, 0x999999FF, ""USC"У вас недостаточно денег (нужно 300 рублей)");
    
    GivePlayerMoneyEx(playerid, -300, "Отметка дома на GPS", true, true);
    
    ShowNotificationNew(playerid, 2, 5, -1, -1, "Вы потратили 300 рублей", "");
    ShowNotificationNew(playerid, 3, 5, -1, -1, "Местоположение дома отмечено на GPS.", "");
    
    new Float: x, Float: y, Float: z;
    new entranceid = GetHouseData(house_id, H_ENTRACE);
    
    if(entranceid != -1)
    {
        x = GetEntranceData(entranceid, E_POS_X);
        y = GetEntranceData(entranceid, E_POS_Y);
        z = GetEntranceData(entranceid, E_POS_Z);
