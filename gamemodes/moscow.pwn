        }
        case 6: // Команда проекта (7 уровень)
        {
            if(admin_level < 7) return ShowNotification(playerid, 2, "Вам недоступен этот раздел! Нужен 7+ уровень", 4, "", "");
            
            format(helpadmcmd, sizeof(helpadmcmd),
                "{FF8A8A}Номер\t{FF8A8A}Команда\t{FF8A8A}Описание\n\
                {FFFFFF}1\t/givevip\tВыдать VIP-права\n\
