            "{FFFFFF}Чтобы покинуть мероприятие — {FF5252}\"/cevent\"",
            mp[MP_NAME], GetPlayerNameEx(playerid)
        );

        gEventLabel = Create3DTextLabel(labelText, 0xFFFFFFFF,
            mp[MP_POS_X], mp[MP_POS_Y], mp[MP_POS_Z] + 1.0, 40.0, 0, 1);

        new query[256];
        format(query, sizeof query, "Уважаемые игроки, сейчас пройдёт мероприятие под названием {d58300}\"%s\".", mp[MP_NAME]);
        SendClientMessageToAll(0xFFCC33FF, query);
        format(query, sizeof query, "{FFCC33}Доступное количество участников: {d58300}55 {FFCC33}, будьте аккуратнее, оружие может быть отобрано.");
        SendClientMessageToAll(0xFFCC33FF, query);
        format(query, sizeof query, "Ровно через несколько минут доступ к телепортации на место проведения мероприятия будет автоматически закрыт.");
        SendClientMessageToAll(0xFFCC33FF, query);
        format(query, sizeof query, "Для того, чтобы поучаствовать в мероприятии - воспользуйтесь командой: {d58300}/gevent");
        SendClientMessageToAll(0xFFCC33FF, query);
    }
    else
    {
        mp[MP_POS_X] = 0.0;
        mp[MP_POS_Y] = 0.0;
        mp[MP_POS_Z] = 0.0;

        if(gEventLabel)
        {
            Delete3DTextLabel(gEventLabel);
            gEventLabel = Text3D:0;
        }

        new query[256];
        format(query, sizeof query, "{FFCC33}Администратор {d58300}%s[%d] {FFCC33}закрыл телепорт на мероприятие под названием {d58300}\"%s\".",
            GetPlayerNameEx(playerid), playerid, mp[MP_NAME]);
        SendClientMessageToAll(0xFFCC33FF, query);
    }
}
            case 5:
            {
                Dialog
                (
