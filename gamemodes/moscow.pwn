                        format(fmt_str, sizeof fmt_str, "{FFCC33}Администратор {d58300}%s {FFCC33}установил всем максимальное значение брони.", GetPlayerNameEx(playerid));
                        SendClientMessage(i, 0x3399FFFF, fmt_str);
                    }
