						//callcmd::car(playerid, "");
					}
				}
			}
			case DIALOG_OWNABLE_CAR_LOAD:
{
    if(response)
    {
        new idx = GetPVarInt(playerid, "ownablecar_id"),
            Float: x,
            Float: y,
            Float: z,
            Float: angle,
            Cache: result,
            query[100];

        mysql_format(mysql, query, sizeof query, "SELECT pos_x, pos_y, pos_z, angle, unload_x, unload_y, unload_z, unload_angle FROM ownable_cars WHERE id='%d'", idx);
        result = mysql_query(mysql, query, true);

        if(cache_num_rows())
        {
            // Парковка
            x = cache_get_row_float(0, 0);
            y = cache_get_row_float(0, 1);
            z = cache_get_row_float(0, 2);
            angle = cache_get_row_float(0, 3);
            
            // Выгрузка
            new Float:unload_x = cache_get_row_float(0, 4);
            new Float:unload_y = cache_get_row_float(0, 5);
            new Float:unload_z = cache_get_row_float(0, 6);
            new Float:unload_angle = cache_get_row_float(0, 7);
        }

        cache_delete(result);

        switch(listitem + 1)
        {
            case 1: // GPS
            {
                if(GetPlayerGPSInfo(playerid, G_ENABLED) == GPS_STATUS_OFF)
                {
                    if(GetPlayerMoneyEx(playerid) >= 300)
                    {
                        GivePlayerMoneyEx(playerid, -300, "Метка ТС на GPS", true, true);
                        EnablePlayerGPS(playerid, 55, x, y, z, "Местоположение Вашего транспорта отмечено на GPS");
                        return 1;
                    }
                    else SendClientMessage(playerid, 0x999999FF, "Недостаточно денег");
                }
                else SendClientMessage(playerid, 0xCECECEFF, "На Вашем GPS уже отмечено место");
            }
            case 2: // Загрузка на месте парковки
            {
                if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
                {
                    SendClientMessage(playerid, 0x999999FF, "Системная ошибка. Транспорт уже загружен.");
                    return 1;
                }
                else
                {
                    if(LoadOwnableCar(idx) != -1)
                    {
                        PlayerOwnableCarInit(playerid);
                        LoadTun(playerid);
                        SendClientMessage(playerid, COLOR_USUPOVRP_WHITE, "Ваша машина была загружена на месте парковки.");
                    }
                    else SendClientMessage(playerid, 0x999999FF, "Ошибка при загрузке личного транспорта");
                }
            }
            case 3: // Загрузка на месте выгрузки (НОВОЕ)
            {
                if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
                {
                    SendClientMessage(playerid, 0x999999FF, "Системная ошибка. Транспорт уже загружен.");
                    return 1;
                }
                
                // Проверяем, есть ли координаты выгрузки
                new Float:unload_x, Float:unload_y, Float:unload_z, Float:unload_angle;
                new query2[128], Cache:result2;
                
                mysql_format(mysql, query2, sizeof query2, "SELECT unload_x, unload_y, unload_z, unload_angle FROM ownable_cars WHERE id='%d'", idx);
                result2 = mysql_query(mysql, query2, true);
                
                if(cache_num_rows())
                {
                    unload_x = cache_get_row_float(0, 0);
                    unload_y = cache_get_row_float(0, 1);
                    unload_z = cache_get_row_float(0, 2);
                    unload_angle = cache_get_row_float(0, 3);
                }
                cache_delete(result2);
                
                // Если координаты выгрузки не установлены - используем координаты парковки
                if(unload_x == 0.0 && unload_y == 0.0 && unload_z == 0.0)
                {
                    SendClientMessage(playerid, 0xFF6600FF, "Координаты выгрузки не установлены. Сначала выгрузите транспорт на нужном месте.");
                    return 1;
                }
                
                if(LoadOwnableCarAtUnload(idx, unload_x, unload_y, unload_z, unload_angle) != -1)
                {
                    PlayerOwnableCarInit(playerid);
                    LoadTun(playerid);
                    SendClientMessage(playerid, COLOR_USUPOVRP_WHITE, "Ваша машина была загружена на месте выгрузки.");
                }
                else SendClientMessage(playerid, 0x999999FF, "Ошибка при загрузке личного транспорта");
            }
        }
    }
    else
    {
        if(GetPVarInt(playerid, "show_menu"))
        {
            DeletePVar(playerid, "show_menu");
            callcmd::car(playerid, "");
        }
    }
    
    return 1;
}
			case DIALOG_OWNABLE_CAR_LIST:
			{
