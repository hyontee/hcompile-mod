public OnPlayerPickUpPickupEx(playerid, pickupid, action_type, action_id)
{
	if(OnPlayerPickUpTaksoPickup(playerid, pickupid)) return 1;
    if(pickupid == quest)
    {
        ShowPlayerQuestMenu(playerid);
	}
	
	if(pickupid == gorod)
    {
   SetPlayerInterior(playerid, 1);
   SetPlayerPos(playerid, 693.005554,-5.022826,1392.100219);
    }
    
    if(pickupid == gorod1)
    {
   SetPlayerInterior(playerid, 0);
   SetPlayerPos(playerid, 2562.621093,-2065.421630,21.960937);
    }
    
    if(pickupid == army_material_pickup)
    {
        // Проверяем, не берет ли уже игрок
        if(g_PlayerTakingMat[playerid])
        {
            SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы уже берете материалы! Подождите.");
            return 1;
        }
        
        // Проверяем, не достиг ли игрок лимита
        if(GetPlayerData(playerid, P_METALL) >= MAX_ARMY_MAT_TAKE)
        {
            SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы уже взяли максимум материалов (20 кг)!");
            return 1;
        }
        
        // Проверяем, есть ли материалы на складе ВЧ
        new army_metal = GetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT);
        if(army_metal <= 0)
        {
            SendClientMessage(playerid, 0xFF6600FF, ""USC"На складе ВЧ нет материалов!");
            return 1;
        }
        
        // Начинаем процесс кражи
        StartTakingMaterials(playerid);
        return 1;
    }
    
    if(pickupid == FarmerPickup)
    {
        // Проверяем кулдаун (чтобы не спамило при быстром нажатии)
        new current_time = GetTickCount();
        if(current_time - g_FarmerPickupCooldown[playerid] < FARMER_DIALOG_COOLDOWN)
            return 1;
        
        g_FarmerPickupCooldown[playerid] = current_time;
        
        // ===== ЕДИНСТВЕННЫЙ ВЫЗОВ ДИАЛОГА =====
        ShowFarmerMainMenu(playerid);
        return 1;
    }

	if(pickupid == kpzenter)
    {
   SetPlayerInterior(playerid, 1);
   SetPlayerVirtualWorld(playerid, 1);
   SetPlayerPos(playerid, -1100.954223,1459.646972,1491.491943,171.415206);
    }
    
    if(pickupid == kpzexit)
    {
   SetPlayerInterior(playerid, 0);
   SetPlayerVirtualWorld(playerid, 0);
   SetPlayerPos(playerid, 2563.803466,-2428.568603,21.919586,190.833770);
    }

	if(pickupid == PickupPoint)
    {
        PickupCreated = 0;
        DestroyPickup(PickupPoint);
        RemovePlayerMapIcon(playerid, 25);
        return 1;
    }

	if(pickupid == mexpick)
	{
		if(GetPlayerJob(playerid) == JOB_MECHANIC)
		{
			new job_car = GetPlayerJobCar(playerid);

				Dialog
				(
					playerid, DIALOG_MECHANIC_RENT_CAR, DIALOG_STYLE_MSGBOX,
					"{FFCD00}Автопарк",
					"{FFFFFF}Чтобы взять машину, необходимо заплатить городскому автопарку 180 рублей\n"\
					"Вы действительно хотите заключить договор аренды?",
					"Да", "Нет"
				);
		}
		else
		{
			RemovePlayerFromVehicle(playerid);
			SendClientMessage(playerid, 0xCECECEFF, "Вы не автомеханик");
		}
	}
	
    if(pickupid == razdkyr)
	{
		if(GetPlayerJob(playerid) == 2)
		{
		    if(!GetPVarInt(playerid, "PizzaCheck"))
		    {
		    	Dialog(playerid, 17173, DIALOG_STYLE_MSGBOX, "{ffff00}Работа курьера", "Вы хотите начать работу курьера?", "Да", "Отмена");
			}
			else
			{
			    Dialog(playerid, 17174, DIALOG_STYLE_MSGBOX, "{ffff00}Работа курьера", "Вы хотите завершить работу курьера?", "Да", "Отмена");
			}
		}
		else return SendClientMessage(playerid, 0xCECECEFF, ""USC"Вы не курьер");

	}
		
	if(pickupid == buspick1)
	{
		if(GetPlayerJob(playerid) == JOB_BUS_DRIVER)
		{
			new job_car = GetPlayerJobCar(playerid);
			new vehicleid = GetPlayerVehicleID(playerid);

			if(!IsPlayerInJob(playerid) && job_car != vehicleid && action_id == VEHICLE_ACTION_ID_NONE)
			{
				Dialog
				(
					playerid, DIALOG_BUS_RENT_CAR, DIALOG_STYLE_MSGBOX,
					"{FFCD00}Автобусный парк",
					"{FFFFFF}Чтобы взять машину, необходимо заплатить городскому автопарку 180 рублей\n"\
