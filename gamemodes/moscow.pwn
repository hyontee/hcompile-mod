            );
            format(sile_title, sizeof(sile_title), "{FF8A8A}Сокращенные команды {FFFFFF}(Наказания)");
        }
    }
    
    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, sile_title, helpadmcmd, "Закрыть", "");
    return true;
}

if(dialogid == 5000) // ВАРН
    {
        if(!response) return 1;

