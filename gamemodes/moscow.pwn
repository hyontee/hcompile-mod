stock Tune_GetPlayerOwnableSql(playerid)
{
    new idx = GetPVarInt(playerid, "ownablecar_id");
    if(idx > 0) return idx;

    new vehicleid = GetPlayerOwnableCar(playerid);
    if(vehicleid != INVALID_VEHICLE_ID && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        new own_index = GetVehicleData(vehicleid, V_ACTION_ID);
        if(own_index != -1)
        {
            idx = GetOwnableCarData(own_index, OC_SQL_ID);
            if(idx > 0) SetPVarInt(playerid, "ownablecar_id", idx);
        }
    }
    return idx;
}

stock GordeevRadial_GetOwnableSqlByVehicle(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID) return 0;
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR) return 0;

    new own_index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(own_index == -1) return 0;

    return GetOwnableCarData(own_index, OC_SQL_ID);
}

stock SetLaunchControl(playerid)
{
    new fmt_text[256],
    idx = Tune_GetPlayerOwnableSql(playerid);
    if(idx <= 0) return 0;

	launch[playerid] = 1;
	mysql_format(mysql, fmt_text, sizeof fmt_text, "UPDATE ownable_cars SET launch='1'  WHERE id='%d' LIMIT 1", idx);
	mysql_query(mysql, fmt_text, false);
    return 1;
}

stock DelLaunchControl(playerid)
{
    new fmt_text[256],
    idx = Tune_GetPlayerOwnableSql(playerid);
    if(idx <= 0) return 0;

    launch[playerid] = 0;
    mysql_format(mysql, fmt_text, sizeof fmt_text, "UPDATE ownable_cars SET launch='0'  WHERE id='%d' LIMIT 1", idx);
	mysql_query(mysql, fmt_text, false);
    return 1;
}

stock TuneLighting_EnsureSchema()
{
	mysql_query(mysql,
		"CREATE TABLE IF NOT EXISTS ownable_cars_lighting (\
		oc_id INT NOT NULL,\
		high_light TINYINT NOT NULL DEFAULT 0,\
		stroboscope_type INT NOT NULL DEFAULT 0,\
		PRIMARY KEY (oc_id)\
		) ENGINE=InnoDB DEFAULT CHARSET=cp1251", false);
	return 1;
}

stock TuneRadial_EnsureSchema()
{
    mysql_query(mysql,
        "CREATE TABLE IF NOT EXISTS ownable_cars_radial (\
        oc_id INT NOT NULL,\
        chip_drift TINYINT NOT NULL DEFAULT 0,\
        chip_comfort TINYINT NOT NULL DEFAULT 0,\
        chip_sport TINYINT NOT NULL DEFAULT 0,\
        chip_sportplus TINYINT NOT NULL DEFAULT 0,\
        has_pneumo TINYINT NOT NULL DEFAULT 0,\
        has_hydraulics TINYINT NOT NULL DEFAULT 0,\
        PRIMARY KEY (oc_id)\
        ) ENGINE=InnoDB DEFAULT CHARSET=cp1251", false);
    return 1;
}

stock GordeevRadialSaveLighting(vehicleid, high_light, stroboscope_type)
{
    new idx = GordeevRadial_GetOwnableSqlByVehicle(vehicleid);
    if(idx <= 0) return 0;

    if(high_light > 0) high_light = 1;
    else high_light = 0;

    if(stroboscope_type < 1 || stroboscope_type > 4) stroboscope_type = 0;

    new query[220];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ownable_cars_lighting (oc_id, high_light, stroboscope_type) VALUES (%d, %d, %d) ON DUPLICATE KEY UPDATE high_light=VALUES(high_light), stroboscope_type=VALUES(stroboscope_type)",
        idx,
        high_light,
        stroboscope_type
    );
    mysql_query(mysql, query, false);
    return 1;
}

stock GordeevRadialSaveChipUnlock(vehicleid, chip_type, enabled)
{
    new idx = GordeevRadial_GetOwnableSqlByVehicle(vehicleid);
    if(idx <= 0) return 0;

    new column[24];
    column[0] = EOS;

    switch(chip_type)
    {
        case GORDEEV_RADIAL_OP_DRIFT: format(column, sizeof column, "chip_drift");
        case GORDEEV_RADIAL_OP_COMFORT: format(column, sizeof column, "chip_comfort");
        case GORDEEV_RADIAL_OP_SPORT: format(column, sizeof column, "chip_sport");
        case GORDEEV_RADIAL_OP_SPORTPLUS: format(column, sizeof column, "chip_sportplus");
    }

    if(!strlen(column)) return 0;

    enabled = (enabled > 0) ? 1 : 0;

    new query[256];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ownable_cars_radial (oc_id, %s) VALUES (%d, %d) ON DUPLICATE KEY UPDATE %s=VALUES(%s)",
        column,
        idx,
        enabled,
        column,
        column
    );
    mysql_query(mysql, query, false);
    return 1;
}

stock GordeevRadialSaveSuspensionUnlock(vehicleid, suspension_type, enabled)
{
    new idx = GordeevRadial_GetOwnableSqlByVehicle(vehicleid);
    if(idx <= 0) return 0;

    new column[24];
    column[0] = EOS;

    if(suspension_type == GORDEEV_RADIAL_OP_HYDRAULICS)
    {
        format(column, sizeof column, "has_hydraulics");
    }
    else if(suspension_type >= GORDEEV_RADIAL_OP_PNEUMO_1 && suspension_type <= GORDEEV_RADIAL_OP_PNEUMO_3)
    {
        format(column, sizeof column, "has_pneumo");
    }

    if(!strlen(column)) return 0;

    enabled = (enabled > 0) ? 1 : 0;

    new query[256];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ownable_cars_radial (oc_id, %s) VALUES (%d, %d) ON DUPLICATE KEY UPDATE %s=VALUES(%s)",
        column,
        idx,
        enabled,
        column,
        column
    );
    mysql_query(mysql, query, false);
    return 1;
}

stock GordeevRadialLoadVehicleData(vehicleid, &high_light, &stroboscope_type, &chip_drift, &chip_comfort, &chip_sport, &chip_sportplus, &has_pneumo, &has_hydraulics, &has_launch)
{
    high_light = 0;
    stroboscope_type = 0;
    chip_drift = 0;
    chip_comfort = 0;
    chip_sport = 0;
    chip_sportplus = 0;
    has_pneumo = 0;
    has_hydraulics = 0;
    has_launch = 0;

    new idx = GordeevRadial_GetOwnableSqlByVehicle(vehicleid);
    if(idx <= 0) return 0;

    new query[320], Cache:result;

    mysql_format(mysql, query, sizeof query, "SELECT high_light, stroboscope_type FROM ownable_cars_lighting WHERE oc_id='%d' LIMIT 1", idx);
    result = mysql_query(mysql, query, true);
    if(cache_num_rows())
    {
        high_light = cache_get_row_int(0, 0);
        stroboscope_type = cache_get_row_int(0, 1);
    }
    cache_delete(result);

    mysql_format(mysql, query, sizeof query,
        "SELECT IFNULL(r.chip_drift,0), IFNULL(r.chip_comfort,0), IFNULL(r.chip_sport,0), IFNULL(r.chip_sportplus,0), IFNULL(r.has_pneumo,0), IFNULL(r.has_hydraulics,0), IFNULL(oc.launch,0) FROM ownable_cars oc LEFT JOIN ownable_cars_radial r ON r.oc_id=oc.id WHERE oc.id='%d' LIMIT 1",
        idx
    );
    result = mysql_query(mysql, query, true);
    if(cache_num_rows())
    {
        chip_drift = cache_get_row_int(0, 0);
        chip_comfort = cache_get_row_int(0, 1);
        chip_sport = cache_get_row_int(0, 2);
        chip_sportplus = cache_get_row_int(0, 3);
        has_pneumo = cache_get_row_int(0, 4);
        has_hydraulics = cache_get_row_int(0, 5);
        has_launch = cache_get_row_int(0, 6);
    }
    cache_delete(result);

    return 1;
}

stock TuneLighting_Save(playerid)
{
	new idx = Tune_GetPlayerOwnableSql(playerid), query[220];
	if(idx <= 0) return 0;

	mysql_format(mysql, query, sizeof query,
		"INSERT INTO ownable_cars_lighting (oc_id, high_light, stroboscope_type) VALUES (%d, %d, %d) ON DUPLICATE KEY UPDATE high_light=VALUES(high_light), stroboscope_type=VALUES(stroboscope_type)",
		idx,
		tune_highlight[playerid],
		tune_stroboscope[playerid]
	);
	mysql_query(mysql, query, false);
	return 1;
}

stock LoadTun(playerid)
{
	new idx = Tune_GetPlayerOwnableSql(playerid),
	Cache: result,
	query[180];

	nitro[playerid] = 0;
	launch[playerid] = 0;
	fars[playerid] = 0;
	diski[playerid] = 0;
	tune_highlight[playerid] = 0;
	tune_stroboscope[playerid] = 0;

	if(idx <= 0) return 0;

	mysql_format(mysql, query, sizeof query, "SELECT nitro, launch, fars, diski FROM ownable_cars WHERE id='%d'", idx);
	result = mysql_query(mysql, query, true);

	if(cache_num_rows())
	{
		nitro[playerid] = cache_get_row_int(0, 0);
		launch[playerid] = cache_get_row_int(0, 1);
		fars[playerid] = cache_get_row_int(0, 2);
		diski[playerid] = cache_get_row_int(0, 3);
	}
	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT high_light, stroboscope_type FROM ownable_cars_lighting WHERE oc_id='%d' LIMIT 1", idx);
	result = mysql_query(mysql, query, true);

	if(cache_num_rows())
	{
		tune_highlight[playerid] = cache_get_row_int(0, 0);
		tune_stroboscope[playerid] = cache_get_row_int(0, 1);
	}
	cache_delete(result);

	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid == INVALID_VEHICLE_ID) return 1;

	if(nitro[playerid] == 1) AddVehicleComponent(vehicleid, Nitro[0][0]);
	if(nitro[playerid] == 2) AddVehicleComponent(vehicleid, Nitro[1][0]);
	if(nitro[playerid] == 3) AddVehicleComponent(vehicleid, Nitro[2][0]);
	if(fars[playerid] == 0) SetVehicleLightsColors(vehicleid, 255, 255, 254);
	if(fars[playerid] == 1) SetVehicleLightsColors(vehicleid, 255, 0, 0);
	if(fars[playerid] == 2) SetVehicleLightsColors(vehicleid, 0, 255, 0);
	if(fars[playerid] == 3) SetVehicleLightsColors(vehicleid, 0, 0, 255);
	if(fars[playerid] == 4) SetVehicleLightsColors(vehicleid, 255, 0, 132);
	if(fars[playerid] == 5) SetVehicleLightsColors(vehicleid, 255, 191, 0);
	if(fars[playerid] == 6) SetVehicleLightsColors(vehicleid, 255, 102, 0);
	if(diski[playerid] == 1) AddVehicleComponent(vehicleid, 1073);
	if(diski[playerid] == 2) AddVehicleComponent(vehicleid, 1074);
	if(diski[playerid] == 3) AddVehicleComponent(vehicleid, 1075);

	BT_SetHighLight(vehicleid, tune_highlight[playerid]);
	BT_SetStroboscope(vehicleid, tune_stroboscope[playerid]);
	Tune_ApplyOwnableVinyl(vehicleid);
	return 1;
}

forward SecondTimes(playerid);
public SecondTimes(playerid)
{
    if(GetPVarInt(playerid, "PizzaCheck") != 0 && GetPVarInt(playerid, "PizzaTime") <= gettime())
	{
		new s[30];
		format(s, sizeof(s), "ВЫ заработали %d руб", GetPVarInt(playerid, "PizzaMoney"));
		SendClientMessage(playerid, -1, s);
		GivePlayerMoneyEx(playerid, GetPVarInt(playerid, "PizzaMoney"), "kyr", true, true);
		SetPlayerSkin(playerid, GetPVarInt(playerid, "GetPlayerSkin"));
		DisablePlayerCheckpoint(playerid);
		DeletePVar(playerid, "PizzaTime");
		DeletePVar(playerid, "PizzaCheck");
		DeletePVar(playerid, "PizzaMoney");
		DeletePVar(playerid, "GetPlayerSkin");
		return 1;
	}
	return 1;
}

