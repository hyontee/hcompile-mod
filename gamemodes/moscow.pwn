CMD:suboff(playerid, params[])
{
    StopAudioStream(playerid);
    
    new vehicleid = g_PlayerSubwooferVehicle[playerid];
    
    g_PlayerSubwooferActive[playerid] = false;
    g_PlayerSubwooferStation[playerid] = -1;
    g_PlayerSubwooferVehicle[playerid] = INVALID_VEHICLE_ID;
    
    // Обновляем DLSB для всех игроков у кого включен
    foreach(new i : Player)
    {
        if(g_SubwooferDebugActive[i])
        {
            UpdateDLSB(i);
        }
    }
    
    SendClientMessage(playerid, -1, "{FF0000}Сабвуфер выключен");
    return 1;
}

stock CreateSubwooferLabel(playerid)
{
    // Удаляем старый лейбл если был
    DestroySubwooferLabel(playerid);
    
    if(!g_PlayerSubwooferActive[playerid]) return 1;
    
    new vehicleid = g_PlayerSubwooferVehicle[playerid];
    if(!IsValidVehicle(vehicleid)) return 1;
    
    // Получаем позицию авто для создания текста
    new Float:x, Float:y, Float:z;
    GetVehiclePos(vehicleid, x, y, z);
    
    // Формируем текст
    new label_text[128];
    format(label_text, sizeof(label_text), 
        "{FFFFFF}Сейчас играет:{FA8072} %s", 
        g_subwoofer_stations[g_PlayerSubwooferStation[playerid]][0]);
    
    // Создаем 3D текст НАД АВТОМОБИЛЕМ (ВИДЕН ВСЕМ)
    // Используем INVALID_PLAYER_ID чтобы видели все
    g_SubwooferLabel[playerid] = CreateDynamic3DTextLabel(
        label_text,
        0xFFFFFFFF,
        x, y, z + 2.5,      // Над автомобилем
        30.0,               // Дистанция видимости
        INVALID_PLAYER_ID,  // ВИДЯТ ВСЕ!
        INVALID_VEHICLE_ID, // Не привязываем к авто (обновляем позицию в таймере)
        0,
        0,
        -1,
        30.0
    );
    
    return 1;
}

// ===== УДАЛЕНИЕ ТЕКСТА =====
stock DestroySubwooferLabel(playerid)
{
    if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
    {
        DestroyDynamic3DTextLabel(g_SubwooferLabel[playerid]);
        g_SubwooferLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
    }
    return 1;
}


forward UpdateSubwooferTimer();
public UpdateSubwooferTimer()
{
    foreach(new playerid : Player)
    {
        if(!IsPlayerLogged(playerid)) continue;
        if(!g_PlayerSubwooferActive[playerid]) continue;

        new vehicleid = g_PlayerSubwooferVehicle[playerid];
        if(!IsValidVehicle(vehicleid))
        {
            callcmd::suboff(playerid, "");
            continue;
        }

        // Обновляем позицию текста (двигаем за авто)
        if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
        {
            new Float:x, Float:y, Float:z;
            GetVehiclePos(vehicleid, x, y, z);
            
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, g_SubwooferLabel[playerid], E_STREAMER_X, x);
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, g_SubwooferLabel[playerid], E_STREAMER_Y, y);
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, g_SubwooferLabel[playerid], E_STREAMER_Z, z + 2.5);
        }
    }
    return 1;
}

// ===== ФУНКЦИЯ ОСТАНОВКИ =====
stock StopSubwoofer(playerid)
{
    if(!g_PlayerSubwooferActive[playerid]) return 1;

    foreach(new i : Player)
    {
        if(GetPVarInt(i, "subwoofer_listening") && GetPVarInt(i, "subwoofer_source") == playerid)
        {
            StopAudioStream(i);
            DeletePVar(i, "subwoofer_listening");
            DeletePVar(i, "subwoofer_source");
            SendClientMessage(i, 0xFF6600FF, "Музыка из автомобиля остановлена.");
        }
    }

    StopAudioStream(playerid);

    if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
    {
        DestroyDynamic3DTextLabel(g_SubwooferLabel[playerid]);
        g_SubwooferLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
    }

    g_PlayerSubwooferActive[playerid] = false;
    g_PlayerSubwooferStation[playerid] = -1;
    g_PlayerSubwooferVehicle[playerid] = INVALID_VEHICLE_ID;

    SendClientMessage(playerid, 0xFF6600FF, ""USC"Сабвуфер выключен.");
    return 1;
}

// ===== ФУНКЦИЯ ВКЛЮЧЕНИЯ =====
stock StartSubwoofer(playerid, station_index)
{
    new vehicleid = GetPlayerVehicleID(playerid);

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы должны быть за рулем транспортного средства");

    if(g_PlayerSubwooferActive[playerid])
    {
        callcmd::suboff(playerid, "");
        if(g_PlayerSubwooferStation[playerid] == station_index)
            return 1;
    }

    g_PlayerSubwooferActive[playerid] = true;
    g_PlayerSubwooferStation[playerid] = station_index;
    g_PlayerSubwooferVehicle[playerid] = vehicleid;

    new station_url[128];
    format(station_url, sizeof(station_url), g_subwoofer_stations[station_index][1]);
    PlayAudioStreamURL(playerid, station_url);

    new Float:x, Float:y, Float:z;
    GetVehiclePos(vehicleid, x, y, z);

    new label_text[128];
    format(label_text, sizeof(label_text), "{00FF00}САБВУФЕР\n{FFFFFF}Играет: %s", g_subwoofer_stations[station_index][0]);

    if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
        DestroyDynamic3DTextLabel(g_SubwooferLabel[playerid]);

    g_SubwooferLabel[playerid] = CreateDynamic3DTextLabel(
        label_text,
        0x00FF00FF,
        x, y, z + 2.5,
        30.0,
        INVALID_PLAYER_ID,
        INVALID_VEHICLE_ID,
        0,
        0,
        -1,
        30.0
    );

    new station_name[32];
    format(station_name, sizeof(station_name), "%s", g_subwoofer_stations[station_index][0]);
    
    new msg[128];
    format(msg, sizeof(msg), "Вы включили сабвуфер. Играет: {00FF00}%s", station_name);
    SendClientMessage(playerid, 0xFFFFFFFF, msg);
    SendClientMessage(playerid, 0xFFFF00FF, "Игроки в радиусе 30 метров слышат вашу музыку!");

    UpdateSubwooferTimer();
    return 1;
}

CMD:subwoofer(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы должны находиться в автомобиле");

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы должны быть за рулем");

    new vehicleid = GetPlayerVehicleID(playerid);
    
    if(GetPlayerOwnableCar(playerid) != vehicleid)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Сабвуфер можно включить только в личном автомобиле");

    new dialog_text[512];
    format(dialog_text, sizeof(dialog_text),
        "{FFFF00}1.{FFFFFF} РОССИЙСКОЕ РАДИО\n\
        {FFFF00}2.{FFFFFF} РАДИО ЕВРОПА+\n\
        {FFFF00}3.{FFFFFF} РАДИО ХИТ FM\n\
        {FFFF00}4.{FFFFFF} РАДИО РЕКОРД\n\
        {FFFF00}5.{FFFFFF} РАДИО Д-ФМ\n\
        {FF0000}6.{FFFFFF} ВЫКЛЮЧИТЬ РАДИО"
    );

    new title[64];
    format(title, sizeof(title), "{FFFF00}Меню сабвуфера");

    ShowPlayerDialog(playerid, DIALOG_CAR_SUBWOOFER, DIALOG_STYLE_LIST, title, dialog_text, "Выбрать", "Отмена");
    return 1;
}
alias:subwoofer("sb")

CMD:sub(playerid, params[])
{
PlayAudioStreamURL(playerid, "http://rusradio.hostingradio.ru/rusradio128.mp3");
    return 1;
}

CMD:dlsb(playerid)
{
    new info[128], 
    Float:x,
    Float:y,
    Float:z, 
    count = GetVehiclePoolSize() + 1;
    
    if(!g_SubwooferDebugActive[playerid])
    {
        g_SubwooferDebugActive[playerid] = true;
        
        for(new i = 1; i < count; i++)
        {
            GetVehiclePos(i, x, y, z);
            
            new bool:has_subwoofer = false;
            new station_name[32] = "";
            
            foreach(new p : Player)
            {
                if(!IsPlayerLogged(p)) continue;
                if(!g_PlayerSubwooferActive[p]) continue;
                if(g_PlayerSubwooferVehicle[p] != i) continue;
                
                has_subwoofer = true;
                format(station_name, sizeof(station_name), g_subwoofer_stations[g_PlayerSubwooferStation[p]][0]);
                break;
            }
            
            if(has_subwoofer)
            {
                format(info, sizeof info, "{FFFFFF}Сейчас играет:{FA8072} %s", station_name);
            }
            else
            {
                format(info, sizeof info, " ");
            }
            
            Veh_3DTEXT[playerid][i] = CreateDynamic3DTextLabel(info, 0xFFFFFFFF, x, y, z + 1.0, 20.0, _, i, 0, -1, -1, playerid);
        }
        
        SendClientMessage(playerid, -1, ""SC" Информация о сабвуфере включена");
    }
    else
    {   
        g_SubwooferDebugActive[playerid] = false;  
        SendClientMessage(playerid, -1, ""USC" Информация о сабвуфере выключена");
        
        for(new i = 1; i < count; i++)
        {
            DestroyDynamic3DTextLabel(Veh_3DTEXT[playerid][i]);
            Veh_3DTEXT[playerid][i] = Text3D:0;
        }
    }
    return 1;
}

stock UpdateDLSB(playerid)
{
    if(!g_SubwooferDebugActive[playerid]) return 1;
    
    new info[128], 
    Float:x,
    Float:y,
    Float:z, 
    count = GetVehiclePoolSize() + 1;
    
    for(new i = 1; i < count; i++)
    {
        GetVehiclePos(i, x, y, z);
        
        new bool:has_subwoofer = false;
        new station_name[32] = "";
        
        foreach(new p : Player)
        {
            if(!IsPlayerLogged(p)) continue;
            if(!g_PlayerSubwooferActive[p]) continue;
            if(g_PlayerSubwooferVehicle[p] != i) continue;
            
            has_subwoofer = true;
            format(station_name, sizeof(station_name), g_subwoofer_stations[g_PlayerSubwooferStation[p]][0]);
            break;
        }
        
        if(has_subwoofer)
        {
            format(info, sizeof info, "{FFFFFF}Сейчас играет:{FA8072} %s", station_name);
        }
        else
        {
            format(info, sizeof info, " ");
        }
        
        if(Veh_3DTEXT[playerid][i] != Text3D:0)
        {
            UpdateDynamic3DTextLabelText(Veh_3DTEXT[playerid][i], 0xFFFFFFFF, info);
        }
        else
        {
            Veh_3DTEXT[playerid][i] = CreateDynamic3DTextLabel(info, 0xFFFFFFFF, x, y, z + 1.0, 20.0, _, i, 0, -1, -1, playerid);
        }
    }
    return 1;
}


forward UpdateDLSBTimer();
public UpdateDLSBTimer()
{
    foreach(new i : Player)
    {
        if(g_SubwooferDebugActive[i])
        {
            UpdateDLSB(i);
        }
    }
    return 1;
}


CMD:fcreate(playerid, params[])
{
    if(GetPlayerIdFamily(playerid) != -1)
        return SendClientMessage(playerid, 0xFF6600FF, ""c_f_r" Вы уже состоите в семье!");
    
    ShowPlayerDialog
    (
        playerid, 2238, DIALOG_STYLE_INPUT,
        "{FF5A5A}USUPOV RP {FFFFFF}| Создание семьи",
        "{FFFFFF}Введите название для вашей новой семьи:\n\
{FF9900}Стоимость создания: {FF0000}3.000.000 рублей\n\
{FF9900}Длина названия: {FFFFFF}от 6 до 32 символов",
        "Создать", "Отмена"
    );
    return 1;
}
alias:fcreate("createfamily", "newfamily")


stock SetVehicleColorForPlayer(playerid, vehicleid, body[], wheel[])
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, vehicleid);
	BS_WriteValue(bitstream, PR_UINT8, 18);

	BS_WriteValue(bitstream, PR_UINT32, body);
	BS_WriteValue(bitstream, PR_UINT32, wheel);
	BS_WriteValue(bitstream, PR_UINT32, wheel);
	BS_WriteValue(bitstream, PR_UINT32, body);

	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
}

stock SetVehicleNumberPlateEx(vehicleid, type, number[], region[])
{
    vNumber[vehicleid][npType] = type;
    format(vNumber[vehicleid][npNumber], 32, "%s", number);
    format(vNumber[vehicleid][npRegion], 8, "%s", region);

    foreach(new playerid: Player)
    {
        SetVehicleNumberPlateForPlayer(playerid, vehicleid, type, number, region);
    }
}

stock SetVehicleNumberPlateForPlayer(playerid, vehicleid, type, number[], region[])
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, 7);

    BS_WriteValue(bitstream, PR_UINT16, vehicleid);

    BS_WriteValue(bitstream, PR_UINT8, type);

    BS_WriteValue(bitstream, PR_UINT8, strlen(number));
    BS_WriteValue(bitstream, PR_STRING, number);

    BS_WriteValue(bitstream, PR_UINT8, strlen(region));
    BS_WriteValue(bitstream, PR_STRING, region);

    PR_SendRPC(bitstream, playerid, 168, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bitstream);
}

stock LoadVehicleTuningFromCache(vehicleid, row, Cache:result)
{
    if(!IsValidVehicle(vehicleid)) return 0;

    ResetVehicleTuning(vehicleid);

    
    return 1;
}

stock SyncVehicleTuningForPlayer(playerid, vehicleid)
{
    if(vInfo[vehicleid][vNeon1] || vInfo[vehicleid][vNeon2] || vInfo[vehicleid][vNeon3])
    {
        SetVehicleNeonForPlayer(playerid, vehicleid,
            vInfo[vehicleid][vNeon1],
            vInfo[vehicleid][vNeon2],
            vInfo[vehicleid][vNeon3]
        );
    }
    if(vInfo[vehicleid][vTint] > 0)
    {
        SetVehicleTintForPlayer(playerid, vehicleid, vInfo[vehicleid][vTint]);
    }
    if(strlen(vInfo[vehicleid][viVinylTexture]) > 0)
    {
        SetVehicleVinylForPlayer(playerid, vehicleid, vInfo[vehicleid][viVinylTexture]);
    }

    if(vInfo[vehicleid][viTonerFront] || vInfo[vehicleid][viTonerRear])
    {
        SetVehicleTonerForPlayer(playerid, vehicleid,
            vInfo[vehicleid][viTonerFront],
            vInfo[vehicleid][viTonerRear],
            vInfo[vehicleid][viTonerFrontSide],
            vInfo[vehicleid][viTonerRearSide]
        );
    }
    if(vInfo[vehicleid][vSuspensionForce] != 0)
    {
        SetVehicleSuspensionForceForPlayer(playerid, vehicleid, vInfo[vehicleid][vSuspensionForce]);
    }
    if(vInfo[vehicleid][vCarMod] > 0)
    {
        SendCarMod(playerid, vInfo[vehicleid][vCarModParam], vehicleid, vInfo[vehicleid][vCarMod]);
    }

    if(vInfo[vehicleid][vSuspensionBias] != 0)
    {
        SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, vInfo[vehicleid][vSuspensionBias]);
    }
    if(vInfo[vehicleid][vWheelSize] != 0)
    {
        SetVehicleWheelSizeForPlayer(playerid, vehicleid, vInfo[vehicleid][vWheelSize]);
    }

    if(vInfo[vehicleid][vWheelAddFront] || vInfo[vehicleid][vWheelAddRear])
    {
        SetVehicleWheelAdditiveForPlayer(playerid, vehicleid,
            vInfo[vehicleid][vWheelAddFront],
            vInfo[vehicleid][vWheelAddRear]
        );
	}
    if(vInfo[vehicleid][viHydraulics] > 0)
    {
        SetVehicleHydraulicsForPlayer(playerid, vehicleid, vInfo[vehicleid][viHydraulics]);
    }

    if(vInfo[vehicleid][viLaunchControl] > 0)
    {
        SetVehicleLaunchControlFP(playerid, vehicleid, vInfo[vehicleid][viLaunchControl]);
    }

    if(vInfo[vehicleid][viStrob] > 0)
    {
        SetVehicleStroboscopeForPlayer(playerid, vehicleid, vInfo[vehicleid][viStrob]);
    }

    if(vInfo[vehicleid][viSiren] > 0)
    {
        SetVehicleSirenForPlayer(playerid, vehicleid, vInfo[vehicleid][viSiren]);
    }

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_NUMBER_TYPE] != 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                g_ownable_car[index][OC_NUMBER_TYPE],
                g_ownable_car[index][OC_NUMBER],
                g_ownable_car[index][OC_REGION]
            );
        }
    }
    else if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
{
    if(index >= 0 && index < MAX_OWNABLE_CARS)
    {
        if(vehicle_family[index][V_F_NUMBER_TYPE] != 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                vehicle_family[index][V_F_NUMBER_TYPE],
                vehicle_family[index][V_F_NUMBER],
                vehicle_family[index][V_F_REGION]
            );
        }
    }
    else
    {
        printf("[ERROR] Невалидный индекс семейного ТС %d (max: %d)", index, MAX_OWNABLE_CARS);
    }
}
    else
    {
        if(vNumber[vehicleid][npType] > 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                vNumber[vehicleid][npType],
                vNumber[vehicleid][npNumber],
                vNumber[vehicleid][npRegion]
            );
        }
    }
}

stock ResetVehicleTuning(vehicleid)
{
	if(!IsValidVehicle(vehicleid)) return 0;
	
	format(vInfo[vehicleid][viVinylTexture], 64, "remapvehicles");
	vInfo[vehicleid][viVinyl] = 0;
    vInfo[vehicleid][viTonerFront] = 0;
    vInfo[vehicleid][viTonerRear] = 0;
    vInfo[vehicleid][viTonerFrontSide] = 0;
    vInfo[vehicleid][viTonerRearSide] = 0;
	vNumber[vehicleid][npType] = 0;
    format(vNumber[vehicleid][npNumber], 32, "none");
    format(vNumber[vehicleid][npRegion], 8, "--");
    vInfo[vehicleid][vCarMod] = 0;
    vInfo[vehicleid][vCarModParam] = 1;

    foreach(new playerid : Player)
    {
            SetVehicleVinylForPlayer(playerid, vehicleid, "remapvehicles");
            SetVehicleTonerForPlayer(playerid, vehicleid, 0, 0, 0, 0);
            SetVehicleNumberPlateForPlayer(playerid, vehicleid, 0, "", "");
            SendCarMod(playerid, 1, vehicleid, 0);
    }
    printf("[Внешний вид] Машина %d сброшена к заводским настройкам.", vehicleid);
    return 1;
}


stock SetVehicleNeonForPlayer(playerid, vehicleid, color1, color2, color3)
{
	new BitStream:bs = BS_New();
	BS_WriteValue(bs, PR_UINT16, vehicleid);
	BS_WriteValue(bs, PR_UINT8, 9);

	BS_WriteValue(bs, PR_UINT32, color1);
	BS_WriteValue(bs, PR_UINT32, color2);
	BS_WriteValue(bs, PR_UINT32, color3);

	PR_SendRPC(bs, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bs);
}

