forward UpdateAllAdminTime();
public UpdateAllAdminTime()
{
    foreach(new playerid : Player)
    {
        if(!IsPlayerConnected(playerid)) continue;
        if(!IsPlayerLogged(playerid)) continue;
        if(GetPlayerData(playerid, P_ADMIN_LOGGED) == 1)
        {
            UpdateAdminTimeTextDraw(playerid);
        }
    }
    return 1;
}


