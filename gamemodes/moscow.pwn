            );
            format(sile_title, sizeof(sile_title), "{FF8A8A}Команда проекта {FFFFFF}(Уровень 7)");
        }
        case 7: // Владелец (8 уровень)
        {
            if(admin_level < 8) return ShowNotification(playerid, 2, "Вам недоступен этот раздел! Нужен 8 уровень", 4, "", "");
            
            format(helpadmcmd, sizeof(helpadmcmd),
                "{FF8A8A}Номер\t{FF8A8A}Команда\t{FF8A8A}Описание\n\
