            SetHouseData(house_id, H_STORE_Y, GetHouseTypeInfo(new_type, HT_STORE_POS_Y));
            SetHouseData(house_id, H_STORE_Z, GetHouseTypeInfo(new_type, HT_STORE_POS_Z));

