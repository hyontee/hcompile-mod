public: LoadOwnableCarAtUnload(oc_id, Float:unload_x, Float:unload_y, Float:unload_z, Float:unload_angle)
{
    if(g_ownable_car_loaded + 1 > MAX_OWNABLE_CARS)
    {
        print("[OwnableCars]: Ошибка в загрузке. Превышен лимит личного транспорта (MAX_OWNABLE_CARS)");
        return -1;
    }

    new query[55],
        Cache: result,
        vehicleid;

    mysql_format(mysql, query, sizeof query, "SELECT * FROM ownable_cars WHERE id='%d' LIMIT 1", oc_id);
    result = mysql_query(mysql, query, true);

    new idx = GetFreeOwnableCarID();

    SetOwnableCarData(idx, OC_SQL_ID, 		cache_get_field_content_int(0, "id"));
    SetOwnableCarData(idx, OC_OWNER_ID, 	cache_get_field_content_int(0, "owner_id"));

    SetOwnableCarData(idx, OC_MODEL_ID, 	cache_get_field_content_int(0, "model_id"));
    SetOwnableCarData(idx, OC_COLOR_1, 		cache_get_field_content_int(0, "color_1"));
    SetOwnableCarData(idx, OC_COLOR_2, 		cache_get_field_content_int(0, "color_2"));

    // Используем координаты выгрузки
    SetOwnableCarData(idx, OC_POS_X, 		unload_x);
    SetOwnableCarData(idx, OC_POS_Y, 		unload_y);
    SetOwnableCarData(idx, OC_POS_Z, 		unload_z);
    SetOwnableCarData(idx, OC_ANGLE, 		unload_angle);
    
    // Сохраняем координаты выгрузки
    SetOwnableCarData(idx, OC_UNLOAD_X, 	unload_x);
    SetOwnableCarData(idx, OC_UNLOAD_Y, 	unload_y);
    SetOwnableCarData(idx, OC_UNLOAD_Z, 	unload_z);
    SetOwnableCarData(idx, OC_UNLOAD_ANGLE, unload_angle);

    cache_get_field_content(0, "number", g_ownable_car[idx][OC_NUMBER], mysql, 8);

    SetOwnableCarData(idx, OC_ALARM, 		bool: cache_get_field_content_int(0, "alarm"));
    SetOwnableCarData(idx, OC_KEY_IN, 		bool: cache_get_field_content_int(0, "key_in"));

    SetOwnableCarData(idx, OC_CREATE, 		cache_get_field_content_int(0, "create_time"));
    SetOwnableCarData(idx, OC_VINILCAR, 	cache_get_field_content_int(0, "vinilcar"));

    SetOwnableCarData(idx, OC_PT_BRAKE, 	cache_get_field_content_int(0, "pt_brake"));
    SetOwnableCarData(idx, OC_PT_STABILITY, cache_get_field_content_int(0, "pt_stability"));
    SetOwnableCarData(idx, OC_PT_ENGINE, 	cache_get_field_content_int(0, "pt_engine"));

    if(strlen(GetOwnableCarData(idx, OC_NUMBER)) != 6)
        strmid(g_ownable_car[idx][OC_NUMBER], "------", 0, 8, 8);

    vehicleid = CreateVehicle
    (
        GetOwnableCarData(idx, OC_MODEL_ID),
        GetOwnableCarData(idx, OC_POS_X),
        GetOwnableCarData(idx, OC_POS_Y),
        GetOwnableCarData(idx, OC_POS_Z),
        GetOwnableCarData(idx, OC_ANGLE),
        GetOwnableCarData(idx, OC_COLOR_1),
        GetOwnableCarData(idx, OC_COLOR_2),
        -1,
        0,
        VEHICLE_ACTION_TYPE_OWNABLE_CAR,
        idx
    );
    
    if(vehicleid != INVALID_VEHICLE_ID)
    {
        format(g_ownable_car[idx][OC_NUMBER], 12, g_ownable_car[idx][OC_NUMBER]);
        SetVehicleRuNumberPlate(vehicleid, g_ownable_car[idx][OC_NUMBER], "17");
        SetVehicleParam(vehicleid, V_LOCK, bool: cache_get_field_content_int(0, "status"));

        SetVehicleData(vehicleid, V_MILEAGE, cache_get_field_content_float(0, "mileage"));
        Tune_ApplyOwnableVinyl(vehicleid);

        SetVehicleData(vehicleid, V_LAST_LOAD_TIME, gettime());
        SetVehicleData(vehicleid, V_HEALTH, 1000);
        SetVehicleHealth(vehicleid, 1000);
    }

    cache_delete(result);

    LoadOwnableCarTrunk(vehicleid);

    return 1;
}


stock SendPlayerOfferNotification(playerid, to_player, type, value_1 = 0, value_2 = 0)
{
    if(GetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER) == INVALID_PLAYER_ID)
    {
        new fmt_text[144];
        new notify_id = -1;
        new extra = 0;
        
        switch(type)
        {
            case OFFER_TYPE_HANDSHAKE:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает пожать Вам руку", GetPlayerNameEx(playerid));
                notify_id = NOTIFY_OFFER_HANDSHAKE;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s пожать руку", GetPlayerNameEx(to_player));
            }
            case OFFER_TYPE_SELL_FUEL_ST:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает купить АЗС \"%s\" за %d руб", 
                    GetPlayerNameEx(playerid), GetFuelStationData(value_1, FS_NAME), value_2);
                notify_id = NOTIFY_OFFER_SELL_FUEL_ST;
                extra = value_1;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s купить Вашу АЗС \"%s\" за %d руб", 
                    GetPlayerNameEx(to_player), GetFuelStationData(value_1, FS_NAME), value_2);
            }
            case OFFER_TYPE_ACCESSORY:
            {
                new price = GetPVarInt(playerid, "owner_accept_price");
                new acs = GetPVarInt(playerid, "acs_id");
                format(fmt_text, sizeof fmt_text, "%s предлагает аксессуар %s за %d руб", 
                    GetPlayerNameEx(playerid), accessory[acs][NAME_ACCESSORY], price);
                notify_id = NOTIFY_OFFER_ACCESSORY;
                extra = GetPVarInt(playerid, "owner_accept_acs_sql");
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s аксессуар %s за %d руб", 
                    GetPlayerNameEx(to_player), accessory[acs][NAME_ACCESSORY], price);
            }
            case OFFER_TYPE_FILL_CAR:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает заправить транспорт на %d л за %d руб", 
                    GetPlayerNameEx(playerid), value_1, value_2);
                notify_id = NOTIFY_OFFER_FILL_CAR;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s заправку на %d л за %d руб", 
                    GetPlayerNameEx(to_player), value_1, value_2);
            }
            case OFFER_TYPE_REPAIR_CAR:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает починить транспорт за %d руб", 
                    GetPlayerNameEx(playerid), value_1);
                notify_id = NOTIFY_OFFER_REPAIR_CAR;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s ремонт за %d руб", 
                    GetPlayerNameEx(to_player), value_1);
            }
            case OFFER_TYPE_SELL_BUSINESS:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает купить бизнес \"%s\" за %d руб", 
                    GetPlayerNameEx(playerid), GetBusinessData(value_1, B_NAME), value_2);
                notify_id = NOTIFY_OFFER_SELL_BUSINESS;
                extra = value_1;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s купить бизнес \"%s\" за %d руб", 
                    GetPlayerNameEx(to_player), GetBusinessData(value_1, B_NAME), value_2);
            }
            case OFFER_TYPE_BUSINESS_MANAGER:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает стать сотрудником предприятия \"%s\"", 
                    GetPlayerNameEx(playerid), GetBusinessData(value_1, B_NAME));
                notify_id = NOTIFY_OFFER_BUSINESS_MANAGER;
                extra = value_1;
                SendClientMessage(playerid, 0x3399FFFF, "%s получил предложение стать Вашим сотрудником", 
                    GetPlayerNameEx(to_player));
            }
            case OFFER_TYPE_SELL_HOME:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает купить дом №%d за %d руб", 
                    GetPlayerNameEx(playerid), value_1, value_2);
                notify_id = NOTIFY_OFFER_SELL_HOME;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s купить дом за %d руб", 
                    GetPlayerNameEx(to_player), value_2);
            }
            case OFFER_TYPE_HOME_RENT_ROOM:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает поселиться в доме №%d", 
                    GetPlayerNameEx(playerid), value_1);
                notify_id = NOTIFY_OFFER_HOME_RENT_ROOM;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s поселиться в доме №%d", 
                    GetPlayerNameEx(to_player), value_1);
            }
            case OFFER_TYPE_SELL_OWNABLE_CAR:
            {
                new model_id = GetVehicleData(value_2, V_MODELID);
                format(fmt_text, sizeof fmt_text, "%s предлагает купить %s за %d руб", 
                    GetPlayerNameEx(playerid), GetVehicleInfo(model_id-400, VI_NAME), value_1);
                notify_id = NOTIFY_OFFER_SELL_OWNABLE_CAR;
                extra = value_2;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s купить %s за %d руб", 
                    GetPlayerNameEx(to_player), GetVehicleInfo(model_id-400, VI_NAME), value_1);
            }
            case OFFER_TYPE_INVITE:
            {
                format(fmt_text, sizeof fmt_text, "%s приглашает в организацию \"%s\"", 
                    GetPlayerNameEx(playerid), GetPlayerTeamName(playerid));
                if(IsTeamSubdivision(GetPlayerTeamEx(playerid)))
                    format(fmt_text, sizeof fmt_text, "%s, подразделение \"%s\"", fmt_text, GetPlayerSubdivisionName(playerid));
                notify_id = NOTIFY_OFFER_INVITE;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s вступить в организацию \"%s\"", 
                    GetPlayerNameEx(to_player), GetPlayerTeamName(playerid));
            }
            case OFFER_TYPE_FINVITE:
            {
                format(fmt_text, sizeof fmt_text, "%s приглашает в семью \"%s\"", 
                    GetPlayerNameEx(playerid), GetFamilyData(GetPlayerIdFamily(playerid), F_NAME));
                notify_id = NOTIFY_OFFER_FINVITE;
                SendClientMessage(playerid, 0x1E90FFFF, "Вы предложили %s вступить в семью \"%s\"", 
                    GetPlayerNameEx(to_player), GetFamilyData(GetPlayerIdFamily(playerid), F_NAME));
            }
            case OFFER_TYPE_MEDHELP:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает лечение за %d руб", 
                    GetPlayerNameEx(playerid), value_1);
                notify_id = NOTIFY_OFFER_MEDHELP;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s лечение за %d руб", 
                    GetPlayerNameEx(to_player), value_1);
            }
            case OFFER_TYPE_HEAL:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает курс лечения за %d руб", 
                    GetPlayerNameEx(playerid), value_1);
                notify_id = NOTIFY_OFFER_HEAL;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s лечение за %d руб", 
                    GetPlayerNameEx(to_player), value_1);
            }
            case OFFER_TYPE_CHANGE_SEX:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает операцию по смене пола за %d руб", 
                    GetPlayerNameEx(playerid), value_1);
                notify_id = NOTIFY_OFFER_CHANGE_SEX;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s операцию за %d руб", 
                    GetPlayerNameEx(to_player), value_1);
            }
            case OFFER_TYPE_SHOW_SKILL:
            {
                format(fmt_text, sizeof fmt_text, "%s хочет показать навыки владения оружием", 
                    GetPlayerNameEx(playerid));
                notify_id = NOTIFY_OFFER_SHOW_SKILL;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s посмотреть навыки", 
                    GetPlayerNameEx(to_player));
            }
            case OFFER_TYPE_CASINO_DICE:
            {
                format(fmt_text, sizeof fmt_text, "%s хочет сыграть в кости. Ставка: %d руб", 
                    GetPlayerNameEx(playerid), value_1);
                notify_id = NOTIFY_OFFER_CASINO_DICE;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s сыграть в кости. Ставка: %d руб", 
                    GetPlayerNameEx(to_player), value_1);
            }
            case OFFER_TYPE_GETHERE:
            {
                format(fmt_text, sizeof fmt_text, "%s хочет телепортировать Вас к себе", 
                    GetPlayerNameEx(playerid));
                notify_id = NOTIFY_OFFER_GETHERE;
                SendClientMessage(playerid, 0x3399FFFF, "Вы запросили у %s разрешение на телепорт", 
                    GetPlayerNameEx(to_player));
            }
            case OFFER_TYPE_GIVE_CAR_KEY:
            {
                format(fmt_text, sizeof fmt_text, "%s хочет дать ключи от транспорта", 
                    GetPlayerNameEx(playerid));
                notify_id = NOTIFY_OFFER_GIVE_CAR_KEY;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s взять ключи от транспорта", 
                    GetPlayerNameEx(to_player));
            }
            case OFFER_TYPE_GIVE_MIC:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает подключиться к радио-эфиру", 
                    GetPlayerNameEx(playerid));
                notify_id = NOTIFY_OFFER_GIVE_MIC;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s подключиться к радио-эфиру", 
                    GetPlayerNameEx(to_player));
            }
            case OFFER_TYPE_GIVE_LIC:
            {
                new lic_names[3][34] = {"вождение базового уровня", "вождение профессионального уровня", "оружие"};
                format(fmt_text, sizeof fmt_text, "%s предлагает купить лицензию на %s за %d руб", 
                    GetPlayerNameEx(playerid), lic_names[value_1 - 1], value_2);
                notify_id = NOTIFY_OFFER_GIVE_LIC;
                extra = value_1;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s лицензию на %s за %d руб", 
                    GetPlayerNameEx(to_player), lic_names[value_1 - 1], value_2);
            }
            case OFFER_TYPE_JAIL_FREE:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает пересмотреть дело за %d руб", 
                    GetPlayerNameEx(playerid), value_1);
                notify_id = NOTIFY_OFFER_JAIL_FREE;
                SendClientMessage(playerid, 0x3399FFFF, "Вы предложили %s пересмотреть дело за %d руб", 
                    GetPlayerNameEx(to_player), value_1);
            }
            default: return 1;
        }

        ShowNotificationNew(to_player, 4, 10, notify_id, extra, fmt_text, ">>");
        
        SetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER, to_player);
        SetPlayerOfferInfo(to_player, O_INCOMING_PLAYER, playerid);
        SetPlayerOfferInfo(to_player, O_INCOMING_TYPE, type);
        SetPlayerOfferValue(to_player, 0, value_1);
        SetPlayerOfferValue(to_player, 1, value_2);
    }
    else SendClientMessage(playerid, 0xFFFFFFFF, "Используйте {FF9900}/cancel {FFFFFF}чтобы отозвать предыдущее предложение");

    return 1;
}


stock CreateDPSZones()
{
    // Зона 1 (первая точка - начало, вторая - конец)
    // 1618.756835,-548.822021,39.154964 -> 1603.366577,-677.963439,39.727699
    g_DPSZones[0][DPS_MIN_X] = 1603.366577;
    g_DPSZones[0][DPS_MIN_Y] = -677.963439;
    g_DPSZones[0][DPS_MAX_X] = 1618.756835;
    g_DPSZones[0][DPS_MAX_Y] = -548.822021;
    g_DPSZones[0][DPS_WORLD] = 0;
    g_DPSZones[0][DPS_INTERIOR] = 0;
    g_DPSZones[0][DPS_AREA] = CreateDynamicRectangle(
        g_DPSZones[0][DPS_MIN_X],
        g_DPSZones[0][DPS_MIN_Y],
        g_DPSZones[0][DPS_MAX_X],
        g_DPSZones[0][DPS_MAX_Y],
        g_DPSZones[0][DPS_WORLD],
        g_DPSZones[0][DPS_INTERIOR]
    );

    // Зона 2 (первая точка - начало, вторая - конец)
    // 1624.010986,-675.274475,39.637569 -> 1638.144042,-534.162292,39.011795
    g_DPSZones[1][DPS_MIN_X] = 1624.010986;
    g_DPSZones[1][DPS_MIN_Y] = -675.274475;
    g_DPSZones[1][DPS_MAX_X] = 1638.144042;
    g_DPSZones[1][DPS_MAX_Y] = -534.162292;
    g_DPSZones[1][DPS_WORLD] = 0;
    g_DPSZones[1][DPS_INTERIOR] = 0;
    g_DPSZones[1][DPS_AREA] = CreateDynamicRectangle(
        g_DPSZones[1][DPS_MIN_X],
        g_DPSZones[1][DPS_MIN_Y],
        g_DPSZones[1][DPS_MAX_X],
        g_DPSZones[1][DPS_MAX_Y],
        g_DPSZones[1][DPS_WORLD],
        g_DPSZones[1][DPS_INTERIOR]
    );

    // Создаем 3D текст над зонами (для красоты)
    new Float:center_x, Float:center_y, Float:center_z = 39.0;
    
    // Центр зоны 1
    center_x = (g_DPSZones[0][DPS_MIN_X] + g_DPSZones[0][DPS_MAX_X]) / 2;
    center_y = (g_DPSZones[0][DPS_MIN_Y] + g_DPSZones[0][DPS_MAX_Y]) / 2;
    CreateDynamic3DTextLabel(
        "{FF0000}ДПС ПОСТ\n{FFFFFF}Ограничение скорости: {FF0000}60 км/ч",
        0xFFFFFFFF, center_x, center_y, center_z + 5.0, 30.0
    );

    // Центр зоны 2
    center_x = (g_DPSZones[1][DPS_MIN_X] + g_DPSZones[1][DPS_MAX_X]) / 2;
    center_y = (g_DPSZones[1][DPS_MIN_Y] + g_DPSZones[1][DPS_MAX_Y]) / 2;
    CreateDynamic3DTextLabel(
        "{FF0000}ДПС ПОСТ\n{FFFFFF}Ограничение скорости: {FF0000}60 км/ч",
        0xFFFFFFFF, center_x, center_y, center_z + 5.0, 30.0
    );

    printf("[DPS Zones]: Создано %d зон ДПС", sizeof(g_DPSZones));
    return 1;
}

stock SetPlayerVehicleSpeed(playerid, speed)
{
    if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return 0;
    
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float:current_speed = GetVehicleSpeed(vehicleid);
    
    // Если текущая скорость меньше лимита - не трогаем
    if(floatround(current_speed) <= speed)
        return 1;
    
    new Float:x, Float:y, Float:z, Float:angle;
    GetVehicleVelocity(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    
    new Float:new_speed = float(speed) / 100.0;
    x = new_speed * floatsin(-angle, degrees);
    y = new_speed * floatcos(-angle, degrees);
    
    SetVehicleVelocity(vehicleid, x, y, z - new_speed / 1000.0);
    
    return 1;
}


stock StartTakingMaterials(playerid)
{
    if(g_PlayerTakingMat[playerid])
        return 0;
    
    // Сбрасываем счетчик
    g_PlayerMatCount[playerid] = 0;
    g_PlayerTakingMat[playerid] = true;
    
    SendClientMessage(playerid, 0xFFFF00FF, ""SC"Вы начали кражу материалов из ВЧ...");
    ShowNotificationNew(playerid, 3, 3, -1, -1, "Кража материалов начата!", "");
    
    // Запускаем таймер для кражи
    g_PlayerMatTakeTimer[playerid] = SetTimerEx("TakeMaterialFromArmy", ARMY_MAT_TAKE_COOLDOWN, true, "i", playerid);
    
    return 1;
}

// ---- ТАЙМЕР КРАЖИ МАТЕРИАЛОВ ----
forward TakeMaterialFromArmy(playerid);
public TakeMaterialFromArmy(playerid)
{
    // Проверяем, не вышел ли игрок из зоны
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, 1562.394897, 1643.307983, 15.971530))
    {
        StopTakingMaterials(playerid);
        SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы вышли из зоны кражи! Процесс остановлен.");
        ShowNotificationNew(playerid, 2, 3, -1, -1, "Кража остановлена! Вы вышли из зоны.", "");
        return 1;
    }
    
    // Проверяем, не достиг ли игрок лимита
    if(GetPlayerData(playerid, P_METALL) >= MAX_ARMY_MAT_TAKE)
    {
        StopTakingMaterials(playerid);
        SendClientMessage(playerid, 0x00FF00FF, ""SC"Вы достигли лимита материалов (20 кг)!");
        ShowNotificationNew(playerid, 3, 3, -1, -1, "Кража завершена! Лимит достигнут.", "");
        return 1;
    }
    
    // Проверяем, есть ли материалы на складе
    new army_metal = GetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT);
    if(army_metal <= 0)
    {
        StopTakingMaterials(playerid);
        SendClientMessage(playerid, 0xFF6600FF, ""USC"На складе ВЧ закончились материалы!");
        ShowNotificationNew(playerid, 2, 3, -1, -1, "Материалы на складе закончились!", "");
        return 1;
    }
    
    // Берем 1 кг материалов (или сколько хочешь)
    new take_amount = 1;
    if(army_metal < take_amount)
        take_amount = army_metal;
    
    // Добавляем игроку
    AddPlayerData(playerid, P_METALL, +, take_amount);
    UpdatePlayerDatabaseInt(playerid, "metall", GetPlayerData(playerid, P_METALL));
    
    // Убираем со склада
    SetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT, army_metal - take_amount);
    UpdateRepository(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL);
    
    // Счетчик и уведомление
    g_PlayerMatCount[playerid] += take_amount;
    new total = GetPlayerData(playerid, P_METALL);
    
    new fmt_msg[128];
    format(fmt_msg, sizeof(fmt_msg), ""SC"Взято {FFFF00}%d кг {FFFFFF}материалов. Всего: {FFFF00}%d/{FF0000}20 кг", 
        take_amount, total);
    SendClientMessage(playerid, 0x00FF00FF, fmt_msg);
    
    ApplyAnimationEx(playerid, "CARRY", "liftup", 4.0, 0, 0, 0, 0, 0, 0);

    if(total >= MAX_ARMY_MAT_TAKE)
    {
        StopTakingMaterials(playerid);
        SendClientMessage(playerid, 0x00FF00FF, ""SC"Кража завершена! Вы взяли {FF0000}20 кг {FFFFFF}материалов!");
        ShowNotificationNew(playerid, 3, 3, -1, -1, "Кража завершена! Максимум материалов.", "");

        new fmt_msg2[128];
        format(fmt_msg2, sizeof(fmt_msg2), "{FF0000}[ВНИМАНИЕ] {FFFFFF}Неизвестный украл материалы со склада ВЧ!");
        SendMessageToTeam(TEAM_ARMY, fmt_msg2, 0xFF0000FF);
    }
    
    return 1;
}

stock StopTakingMaterials(playerid)
{
    if(!g_PlayerTakingMat[playerid])
        return 0;
    
    g_PlayerTakingMat[playerid] = false;
    
    if(g_PlayerMatTakeTimer[playerid] != -1)
    {
        KillTimer(g_PlayerMatTakeTimer[playerid]);
        g_PlayerMatTakeTimer[playerid] = -1;
    }
    
    // Анимация остановки
    ClearAnimations(playerid);
    
    return 1;
}


stock ShowBanDialog(playerid)
{
    new fmt_str[1024];
    new year, month, day, hour, minute, second;

    timestamp_to_date(g_BanInfo[playerid][1], year, month, day, hour, minute, second);
    new ban_date[32];
    format(ban_date, sizeof(ban_date), "%02d.%02d.%d в %02d:%02d", day, month, year, hour, minute);
    
    timestamp_to_date(g_BanInfo[playerid][2], year, month, day, hour, minute, second);
    new unban_date[32];
    format(unban_date, sizeof(unban_date), "%02d.%02d.%d в %02d:%02d", day, month, year, hour, minute);
    
    format(fmt_str, sizeof(fmt_str),
        "{FFFFFF}Ваш аккаунт был заблокирован администрацией за нарушение\n\
        правил сервера. Вы не можете играть на своем аккаунте во время действия блокировки.\n\n\
        {FFFF00}|{FFFFFF}Ваш никнейм: {FFFF00}%s\n\
        {FFFF00}|{FFFFFF}Никнейм администратора: {FFFF00}%s\n\
        {FFFF00}|{FFFFFF}Дата выданной блокировки: {FFFF00}%s\n\
        {FFFF00}|{FFFFFF}Дата разблокировки: {FFFF00}%s\n\
        {FFFF00}|{FFFFFF}Причина блокировки: {FFFF00}%s\n\n\
        {FFFFFF}Вы не согласны с решением администратора и считаете, что наказание\n\
        было выдано несправедливо или ошибочно? В таком случае,\n необходимо обратиться в специальный раздел с жалобой на\n официальном форуме проекта: {FFFF00}forum.usupovrp.ru.\n\n\
        {FFFFFF}Не забудьте прикрепить скриншот данного окна в жалобу.",
        g_BanPlayerName[playerid],
        g_BanAdmin[playerid],
        ban_date,
        unban_date,
        g_BanReason[playerid]
    );
    
    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, 
        "{FF5A5A}USUPOV RP {FFFFFF}| Аккаунт заблокирован", 
        fmt_str, 
        "Закрыть", "");
}

public KickPlayerAfterBan(playerid)
{
    Kick(playerid);
    return 1;
}


stock Date(timestamp)
{
    new year, month, day, hour, minute, second;
    timestamp_to_date(timestamp, year, month, day, hour, minute, second);
    new date_str[32];
    format(date_str, sizeof(date_str), "%02d.%02d.%d %02d:%02d", day, month, year, hour, minute);
    return date_str;
}

CMD:setminerpay(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    new pay;
    if(sscanf(params, "d", pay))
        return SendClientMessage(playerid, 0xCECECEFF, "Использование: /setminerpay [сумма за кг]");
    
    if(pay < 1 || pay > 100000)
        return SendClientMessage(playerid, 0xCECECEFF, "Сумма должна быть от 1 до 100000");
    
    g_temp_jobs[TEMP_JOB_MINER][TJ_PAY_FOR_LOAD] = pay;
    
    new fmt_msg[128];
    format(fmt_msg, sizeof(fmt_msg), "Зарплата шахтера изменена на %d рублей за кг", pay);
    SendClientMessage(playerid, 0x66CC33FF, fmt_msg);
    
    return 1;
}

CMD:giveallrub(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Данная команда не доступна на ТЕСТ СЕРВЕРЕ!");

    new amount;
    if(sscanf(params, "d", amount))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /giveallrub [сумма]");

    if(amount < 1 || amount > 10000)
        return SendClientMessage(playerid, 0xCECECEFF, "Сумма должна быть от 1 до 10000 донат-рублей");

    new count, fmt_msg[128];
    
    foreach(new i : Player)
    {
        if(!IsPlayerLogged(i)) continue;
        
        GivePlayerDonateRub(i, amount, "Выдача всем игрокам от администрации", true, true);
        count++;
    }

    format(fmt_msg, sizeof(fmt_msg), "[A] %s[%d] выдал всем игрокам %d донат-рублей! Всего получено: %d игроков", 
        GetPlayerNameEx(playerid), playerid, amount, count);
    SendClientMessageToAll(0xFFFF00FF, fmt_msg);
    
    // Лог
    format(fmt_msg, sizeof(fmt_msg), "Выдал всем игрокам %d донат-рублей (%d игроков)", amount, count);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_msg);

    return 1;
}

stock bool:CanUseMedkit(playerid)
{
    new bool:canUse = true;

    if(g_PlayerMedkitUsed[playerid] == true)
    {
        canUse = false;
    }

    return canUse;
}

stock SetPlayerMedkitUsed(playerid, bool:used)
{
    g_PlayerMedkitUsed[playerid] = used;
}

forward ResetMedkitCooldown(playerid);
public ResetMedkitCooldown(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        g_PlayerMedkitUsed[playerid] = false;
    }
}


stock SimInventory_EnsureSchema()
{
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS `player_sim_inventory` (\
        `id` INT(11) NOT NULL AUTO_INCREMENT,\
        `player_id` INT(11) NOT NULL,\
        `sim_number` VARCHAR(16) NOT NULL,\
        `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\
        PRIMARY KEY (`id`),\
        INDEX `player_id` (`player_id`)\
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci", false);
    if(mysql_errno())
    {
        printf("[SIM] schema init error: %d", mysql_errno());
    }
    return 1;
}

stock LoadPlayerSimResources(playerid)
{
    new query[160], Cache:result;
    g_player_sim_resource_count[playerid] = 0;
    mysql_format(mysql, query, sizeof query, "SELECT id, sim_number FROM player_sim_inventory WHERE player_id=%d ORDER BY id ASC LIMIT 32", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);
    for(new i; i < cache_num_rows() && i < 32; i++)
    {
        g_player_sim_resource_count[playerid]++;
        g_player_sim_resource[playerid][i][PSR_SQL_ID] = cache_get_field_content_int(i, "id");
        cache_get_field_content(i, "sim_number", g_player_sim_resource[playerid][i][PSR_NUMBER], mysql, 16);
    }
    cache_delete(result);
    return 1;
}

stock GivePlayerSimResource(playerid, number[])
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0) return 0;
    
    // Проверяем лимит
    if(g_player_sim_resource_count[playerid] >= 32)
    {
        SendClientMessage(playerid, 0x999999FF, "Ваш инвентарь SIM-карт переполнен!");
        return 0;
    }
    
    // Проверяем дубликаты в памяти
    for(new i = 0; i < g_player_sim_resource_count[playerid]; i++)
    {
        if(strcmp(g_player_sim_resource[playerid][i][PSR_NUMBER], number) == 0)
        {
            printf("[SIM] SIM-карта %s уже есть в памяти игрока %d", number, playerid);
            return 1; // Уже есть
        }
    }
    
    // Проверяем дубликаты в БД
    new query[256], Cache:result;
    mysql_format(mysql, query, sizeof(query),
        "SELECT id FROM player_sim_cards WHERE player_id=%d AND number='%s' LIMIT 1",
        account_id, number);
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows() > 0)
    {
        printf("[SIM] SIM-карта %s уже есть в БД для игрока %d", number, playerid);
        cache_delete(result);
        return 1; // Уже есть в БД
    }
    cache_delete(result);
    
    // Добавляем в память
    new count = g_player_sim_resource_count[playerid];
    format(g_player_sim_resource[playerid][count][PSR_NUMBER], 16, number);
    g_player_sim_resource[playerid][count][PSR_SQL_ID] = 0;
    g_player_sim_resource_count[playerid]++;
    
    // Сохраняем в БД
    mysql_format(mysql, query, sizeof(query),
        "INSERT INTO player_sim_cards (player_id, number) VALUES (%d, '%s')",
        account_id, number);
    mysql_query(mysql, query, false);
    
    // КРИТИЧЕСКИ ВАЖНО: Обновляем PSR_SQL_ID после сохранения!
    if(mysql_errno() == 0)
    {
        new Cache:insert_result;
        mysql_format(mysql, query, sizeof(query),
            "SELECT id FROM player_sim_cards WHERE player_id=%d AND number='%s' ORDER BY id DESC LIMIT 1",
            account_id, number);
        insert_result = mysql_query(mysql, query, true);
        
        if(cache_num_rows() > 0)
        {
            g_player_sim_resource[playerid][count][PSR_SQL_ID] = cache_get_field_content_int(0, "id");
            printf("[SIM] Добавлена SIM-карта %s с SQL ID %d для игрока %d", 
                number, g_player_sim_resource[playerid][count][PSR_SQL_ID], playerid);
        }
        cache_delete(insert_result);
    }
    else
    {
        printf("[SIM ERROR] Не удалось сохранить SIM-карту %s для игрока %d", number, playerid);
    }
    
    return 1;
}

stock DeletePlayerSimSlot(playerid, slot)
{
    if(slot < 0 || slot >= g_player_sim_resource_count[playerid]) return 0;
    
    new sql_id = g_player_sim_resource[playerid][slot][PSR_SQL_ID];
    new number[16];
    format(number, sizeof(number), "%s", g_player_sim_resource[playerid][slot][PSR_NUMBER]);
    
    // Удаляем из БД по SQL ID (если он есть)
    if(sql_id > 0)
    {
        new query[256];
        mysql_format(mysql, query, sizeof(query),
            "DELETE FROM player_sim_cards WHERE id=%d",
            sql_id);
        mysql_query(mysql, query, false);
        printf("[SIM] Удалена SIM-карта %s (SQL ID: %d) из БД", number, sql_id);
    }
    else
    {
        // Если SQL ID нет, удаляем по номеру
        new query[256];
        mysql_format(mysql, query, sizeof(query),
            "DELETE FROM player_sim_cards WHERE player_id=%d AND number='%s'",
            GetPlayerAccountID(playerid), number);
        mysql_query(mysql, query, false);
        printf("[SIM] Удалена SIM-карта %s по номеру из БД", number);
    }
    
    // Сдвигаем массив в памяти
    for(new i = slot; i < g_player_sim_resource_count[playerid] - 1; i++)
    {
        g_player_sim_resource[playerid][i] = g_player_sim_resource[playerid][i + 1];
    }
    
    // Очищаем последний элемент
    g_player_sim_resource_count[playerid]--;
    g_player_sim_resource[playerid][g_player_sim_resource_count[playerid]][PSR_NUMBER][0] = 0;
    g_player_sim_resource[playerid][g_player_sim_resource_count[playerid]][PSR_SQL_ID] = 0;
    
    printf("[SIM] Удалена SIM-карта %s из памяти игрока %d", number, playerid);
    return 1;
}

stock ShowPlayerSimResources(playerid)
{
    LoadPlayerSimResources(playerid);
    if(!g_player_sim_resource_count[playerid])
        return ShowNotification(playerid, 2, "У Вас нет сохраненных SIM-карт", 4, "", "");
    
    new fmt_text[2048], row[96];
    format(fmt_text, sizeof fmt_text, "№\tНомер SIM-карты\n");
    for(new i; i < g_player_sim_resource_count[playerid]; i++)
    {
        format(row, sizeof row, "%d\t%s\n", i + 1, g_player_sim_resource[playerid][i][PSR_NUMBER]);
        strcat(fmt_text, row);
        SetPlayerListitemValue(playerid, i, i);
    }
    return Dialog(playerid, DIALOG_INV_SIMS, DIALOG_STYLE_TABLIST_HEADERS, "{FA8072}Инвентарь {FFFFFF}| Мои SIM-карты", fmt_text, "Выбрать", "Закрыть");
}

stock ApplyPlayerSimResource(playerid, slot)
{
    new number[16];
    format(number, sizeof number, "%s", g_player_sim_resource[playerid][slot][PSR_NUMBER]);
    
    new phone_number = strval(number);
    
    // Проверяем, не занят ли номер
    new Cache:result;
    new query[128];
    mysql_format(mysql, query, sizeof query, "SELECT id FROM accounts WHERE phone=%d AND id!=%d", phone_number, GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows() > 0)
    {
        cache_delete(result);
        SendClientMessage(playerid, 0x999999FF, ""USC"Этот номер уже используется другим игроком!");
        return 0;
    }
    cache_delete(result);
    
    // Меняем номер телефона
    SetPlayerData(playerid, P_PHONE, phone_number);
    UpdatePlayerDatabaseInt(playerid, "phone", phone_number);
    
    // ===== КРАСИВОЕ СООБЩЕНИЕ В ЧАТ =====
    new fmt_text[128];
    format(fmt_text, sizeof(fmt_text), ""SC"Вы установили в телефон SIM-карту: {FFFF00}%d", phone_number);
    SendClientMessage(playerid, 0x66CC33FF, fmt_text);
    
    // Дополнительное уведомление
    ShowNotificationNew(playerid, 3, 5, -1, -1, fmt_text, "");
    
    // Анимация (опционально)
    ApplyAnimationEx(playerid, "COP_AMBIENT", "Coplook_watch", 4.0, false, 0, 0, 0, 0, 0);
    
    return 1;
}


CMD:banip(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6)
        return SendClientMessage(playerid, 0x999999FF, "У вас недостаточно прав (нужен 6+ уровень)");

    if(GetPlayerAdminWarn(playerid) > 0)
        return SendClientMessage(playerid, 0x999999FF, "Вы не можете использовать эту команду, так как у вас есть выговор");

    new target_id, days, reason[128];
    
    if(sscanf(params, "u d s[128]", target_id, days, reason))
    {
        SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /banip [id игрока] [дни] [причина]");
        SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}Пример:{FFFFFF} /banip 5 30 Читы");
        return 1;
    }

    if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
        return SendClientMessage(playerid, 0x999999FF, "Такого игрока нет");

    if(GetPlayerAdminEx(target_id) >= GetPlayerAdminEx(playerid))
        return SendClientMessage(playerid, 0x999999FF, "Нельзя забанить IP администратора выше по рангу");

    if(target_id == playerid)
        return SendClientMessage(playerid, 0x999999FF, "Нельзя забанить самого себя");

    if(days < 1 || days > 365)
        return SendClientMessage(playerid, 0x999999FF, "Количество дней должно быть от 1 до 365");

    new ip[16];
    GetPlayerIp(target_id, ip, sizeof ip);
    new admin_name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, admin_name, sizeof admin_name);
    new target_name[MAX_PLAYER_NAME];
    GetPlayerName(target_id, target_name, sizeof target_name);

    new query[512];
    new time = gettime();
    new unban_time = time + (days * 86400);

    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ban_list (user_id, time, ban_time, ip, description, admin, admin_name, player_name, unban_date) \
        VALUES (%d, %d, %d, '%s', '%s', '%s', '%s', '%s', %d)",
        GetPlayerAccountID(target_id),
        time,
        unban_time,
        ip,
        reason,
        admin_name,
        admin_name,
        target_name,
        unban_time
    );
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        SendClientMessage(playerid, 0xFF6600FF, "Ошибка при добавлении IP-бана в базу данных");
        return 1;
    }

    new fmt_str[256];
    format(fmt_str, sizeof fmt_str, "[A] %s[%d] забанил IP %s игрока %s[%d] на %d дней. Причина: %s",
        admin_name, playerid, ip, target_name, target_id, days, reason);
    SendMessageToAdmins(fmt_str, 0x999999FF);
    SendClientMessageToAll(0xFF5533FF, fmt_str);

    format(fmt_str, sizeof fmt_str, "Ваш IP-адрес был забанен администратором %s на %d дней. Причина: %s",
        admin_name, days, reason);
    SendClientMessage(target_id, 0xFF0000FF, fmt_str);
    ShowNotificationNew(target_id, 2, 5, -1, -1, "Ваш IP-адрес был забанен", "");

    format(fmt_str, sizeof fmt_str, "Забанил IP %s игрока %s[acc:%d] на %d дней. Причина: %s",
        ip, target_name, GetPlayerAccountID(target_id), days, reason);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_str);

    Kick(target_id);
    return 1;
}

CMD:unbanip(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6)
        return SendClientMessage(playerid, 0x999999FF, "У вас недостаточно прав (нужен 6+ уровень)");

    new ip[16];
    if(sscanf(params, "s[16]", ip))
    {
        SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /unbanip [IP-адрес]");
        return 1;
    }

    new query[128];
    mysql_format(mysql, query, sizeof query,
        "SELECT id FROM ban_list WHERE ip='%s' AND ban_time > %d LIMIT 1",
        ip, gettime());
    
    new Cache:result = mysql_query(mysql, query, true);
    
    if(!cache_num_rows())
    {
        cache_delete(result);
        SendClientMessage(playerid, 0x999999FF, "Данный IP-адрес не забанен");
        return 1;
    }

    cache_delete(result);

    mysql_format(mysql, query, sizeof query, "DELETE FROM ban_list WHERE ip='%s'", ip);
    mysql_query(mysql, query, false);

    new fmt_str[128];
    format(fmt_str, sizeof fmt_str, "[A] %s[%d] разбанил IP-адрес %s", GetPlayerNameEx(playerid), playerid, ip);
    SendMessageToAdmins(fmt_str, 0x999999FF);

    format(fmt_str, sizeof fmt_str, "Вы успешно разбанили IP-адрес %s", ip);
    SendClientMessage(playerid, 0x66CC33FF, fmt_str);

    format(fmt_str, sizeof fmt_str, "Разбанил IP-адрес %s", ip);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_str);

    return 1;
}

stock GetFreeHouseID()
{
    for(new idx = 0; idx < MAX_HOUSES; idx ++)
    {
        if(GetHouseData(idx, H_SQL_ID) <= 0)
            return idx;
    }
    return -1;
}


CMD:sex(playerid, params[])
{
    if(IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0x999999FF, "Вы не можете использовать это в транспорте");
    
    new to_player;
    if(sscanf(params, "u", to_player))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /sex [id игрока]");
    
    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
        return SendClientMessage(playerid, 0x999999FF, "Такого игрока нет");
    
    if(!IsPlayerInRangeOfPlayer(playerid, to_player, 3.0))
        return SendClientMessage(playerid, 0x999999FF, "Игрок слишком далеко");
    
    // Проверка пола (опционально)
    // if(GetPlayerSex(playerid) == GetPlayerSex(to_player))
    //     return SendClientMessage(playerid, 0x999999FF, "Вы не можете с человеком одного пола");
    
    // Анимация предложения
    ApplyAnimationEx(playerid, "STRIP", "PUL_01", 4.0, 0, 1, 1, 1, 0, 1);
    SetPlayerChatBubble(playerid, "Предлагает заняться сексом", 0xFF69B4FF, 15.0, 5000);
    
    return 1;
}


CMD:minet(playerid, params[])
{
    if(IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0x999999FF, "Вы не можете использовать это в транспорте");
    
    new to_player;
    if(sscanf(params, "u", to_player))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /minet [id игрока]");
    
    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
        return SendClientMessage(playerid, 0x999999FF, "Такого игрока нет");
    
    if(!IsPlayerInRangeOfPlayer(playerid, to_player, 2.0))
        return SendClientMessage(playerid, 0x999999FF, "Игрок слишком далеко");
    
    // Предложение (опционально)
    // Или сразу действие
    
    // Анимация "минет"
    ApplyAnimationEx(playerid, "STRIP", "PUL_01", 4.0, 0, 1, 1, 1, 0, 1); // Тот, кому делают
    ApplyAnimationEx(to_player, "STRIP", "STR_A2B", 4.0, 0, 1, 1, 1, 0, 1); // Тот, кто делает
    
    SendMessageInLocal(playerid, "*** Игроки занялись минетом ***", 0xFF69B4FF, 25.0);
    
    SetTimerEx("EndSex", 5000, false, "ii", playerid, to_player);
    
    return 1;
}

public EndSex(playerid, partnerid)
{
    // Останавливаем анимации
    ClearAnimations(playerid);
    ClearAnimations(partnerid);
    
    // Возвращаем цвета
    SetPlayerColorEx(playerid, GetPlayerTeamColor(playerid));
    SetPlayerColorEx(partnerid, GetPlayerTeamColor(partnerid));
    
    // Чат-баблы
    SetPlayerChatBubble(playerid, "Закончил(а)", 0xFF69B4FF, 10.0, 3000);
    SetPlayerChatBubble(partnerid, "Закончил(а)", 0xFF69B4FF, 10.0, 3000);
    
    return 1;
}


// Добавь в начале файла после define
stock bool:HasPlayerMoney(playerid, amount)
{
    if(amount <= 0) return true;
    if(GetPlayerMoneyEx(playerid) < amount) return false;
    return true;
}

// Проверка с учетом банка
stock bool:HasPlayerTotalMoney(playerid, amount)
{
    if(amount <= 0) return true;
    if((GetPlayerMoneyEx(playerid) + GetPlayerBankMoney(playerid)) < amount) return false;
    return true;
}

// Безопасное списание денег
stock bool:TakePlayerMoney(playerid, amount, const description[] = "Списание")
{
    if(amount <= 0) return true;
    if(GetPlayerMoneyEx(playerid) < amount)
    {
        new fmt_msg[128];
        format(fmt_msg, sizeof fmt_msg, ""USC"Недостаточно денег! Нужно: %d, у вас: %d", amount, GetPlayerMoneyEx(playerid));
        SendClientMessage(playerid, 0xFF6600FF, fmt_msg);
        return false;
    }
    
    GivePlayerMoneyEx(playerid, -amount, description, true, true);
    return true;
}


stock LogNegativeBalance(playerid)
{
    new fmt_str[128];
    format(fmt_str, sizeof fmt_str, "[NEGATIVE BALANCE] %s[%d] money=%d bank=%d ip=%s", 
        GetPlayerNameEx(playerid), playerid, 
        GetPlayerMoneyEx(playerid), GetPlayerBankMoney(playerid),
        GetPlayerIpEx(playerid));
    print(fmt_str);
    
    // Отправка админам
    SendMessageToAdmins(fmt_str, 0xFF5533FF);
}


// Функция проверки отрицательного баланса
stock CheckNegativeBalance(playerid)
{
    new current_time = gettime();
    
    // Проверяем раз в 5 секунд, чтобы не спамить
    if(current_time - g_LastBalanceCheck[playerid] < 5)
        return 0;
    
    g_LastBalanceCheck[playerid] = current_time;
    
    // Проверяем наличные
    new money = GetPlayerMoneyEx(playerid);
    if(money < 0)
    {
        // Срочное уведомление в админ чат
        new alert_msg[256];
        format(alert_msg, sizeof(alert_msg), 
            "{FF4500}[АНТИЧИТ] {FF0000}СРОЧНО СМОТРИ! {FFFFFF}У игрока {FF9900}%s[%d] {FFFFFF}ОТРИЦАТЕЛЬНЫЙ БАЛАНС: {FF0000}%d руб. {FFFFFF}(ID: %d)",
            GetPlayerNameEx(playerid), playerid, money, playerid);
        SendMessageToAdmins(alert_msg, 0xFF4500FF);
        
        // Логируем в консоль
        printf("[АНТИЧИТ] %s[%d] ОТРИЦАТЕЛЬНЫЙ БАЛАНС: %d руб.", GetPlayerNameEx(playerid), playerid, money);
        
        // Исправляем баланс
        SetPlayerData(playerid, P_MONEY, 0);
        ResetPlayerMoney(playerid);
        GivePlayerMoney(playerid, 0);
        
        // Уведомляем игрока
        SendClientMessage(playerid, 0xFF0000FF, ""USC"Ваш баланс был скорректирован системой античита (был отрицательным)!");
        
        // Сохраняем в БД
        UpdatePlayerDatabaseInt(playerid, "money", 0);
        
        return 1;
    }
    
    // Проверяем банковский баланс
    new bank = GetPlayerBankMoney(playerid);
    if(bank < 0)
    {
        new alert_msg[256];
        format(alert_msg, sizeof(alert_msg), 
            "{FF4500}[АНТИЧИТ] {FF0000}СРОЧНО СМОТРИ! {FFFFFF}У игрока {FF9900}%s[%d] {FFFFFF}ОТРИЦАТЕЛЬНЫЙ БАНКОВСКИЙ БАЛАНС: {FF0000}%d руб. {FFFFFF}(ID: %d)",
            GetPlayerNameEx(playerid), playerid, bank, playerid);
        SendMessageToAdmins(alert_msg, 0xFF4500FF);
        
        printf("[АНТИЧИТ] %s[%d] ОТРИЦАТЕЛЬНЫЙ БАНК: %d руб.", GetPlayerNameEx(playerid), playerid, bank);
        
        SetPlayerData(playerid, P_BANK, 0);
        UpdatePlayerDatabaseInt(playerid, "bank", 0);
        
        SendClientMessage(playerid, 0xFF0000FF, ""USC"Ваш банковский баланс был скорректирован системой античита (был отрицательным)!");
        
        return 1;
    }
    
    return 0;
}


stock bool:DeleteAccount(admin_id, account_id, target_id = INVALID_PLAYER_ID, target_name[], reason[])
{
    new query[512];
    new fmt_text[256];
    
    // ===== 1. ЛОГИРУЕМ УДАЛЕНИЕ =====
    new admin_name[24];
    format(admin_name, sizeof(admin_name), "%s", GetPlayerNameEx(admin_id));
    
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO logs_deleted_accounts (account_id, player_name, admin_id, admin_name, ip, time, reason) \
         VALUES (%d, '%s', %d, '%s', '%s', %d, '%s')",
        account_id, target_name, GetPlayerAccountID(admin_id), admin_name, GetPlayerIpEx(admin_id), 
        gettime(), reason);
    mysql_query(mysql, query, false);
    
    // ===== 2. УДАЛЯЕМ ВСЕ ДАННЫЕ ИЗ ТАБЛИЦ =====
    
    // ---------- ОСНОВНЫЕ ТАБЛИЦЫ ----------
    
    // Удаляем из accounts
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM accounts WHERE id=%d LIMIT 1", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из ownable_cars
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM ownable_cars WHERE owner_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из trunks
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM trunks WHERE oc_id IN (SELECT id FROM ownable_cars WHERE owner_id=%d)", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из houses
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM houses WHERE owner_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из houses_renters
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM houses_renters WHERE owner_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из business
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM business WHERE owner_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из fuel_stations
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM fuel_stations WHERE owner_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ---------- БАНКОВСКИЕ ТАБЛИЦЫ ----------
    
    // Удаляем из bank_accounts
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM bank_accounts WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из bank_accounts_log
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM bank_accounts_log WHERE acc_id IN (SELECT id FROM bank_accounts WHERE uid=%d)", account_id);
    mysql_query(mysql, query, false);
    
    // ---------- ТЕЛЕФОН ----------
    
    // Удаляем из phone_books
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM phone_books WHERE owner_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ---------- ИСТОРИЯ ----------
    
    // Удаляем из change_names
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM change_names WHERE owner_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из action_log
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM action_log WHERE acc_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из money_log
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM money_log WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из donate_log
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM donate_log WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из return_money
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM return_money WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ---------- ШТРАФЫ ----------
    
    // Удаляем из tickets
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM tickets WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ---------- ПОДАРКИ ----------
    
    // Удаляем из gift_lose
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM gift_lose WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ---------- ПРОМОКОДЫ ----------
    
    // Удаляем из promocode_activations
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM promocode_activations WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из ytpromocode_activations
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM ytpromocode_activations WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ---------- ЛИДЕРЫ ----------
    
    // Удаляем из leaders
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM leaders WHERE account_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ---------- ИНВЕНТАРЬ ----------
    
    // Удаляем из accessory_inventory
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM accessory_inventory WHERE player_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из accessories_players
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM accessories_players WHERE player_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из inventory_skins
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM inventory_skins WHERE owner_skin=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ===== НОВОЕ: ДОПОЛНИТЕЛЬНЫЕ ТАБЛИЦЫ =====
    
    // Удаляем из family
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM family WHERE u_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из family_auto
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM family_auto WHERE owner_id IN (SELECT id FROM family WHERE u_id=%d)", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из unitpay_payments
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM unitpay_payments WHERE account='%s'", target_name);
    mysql_query(mysql, query, false);
    
    // Удаляем из payments (QIWI)
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM payments WHERE user_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из ban_list
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM ban_list WHERE user_id=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из reports_list
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM reports_list WHERE sender_id=%d OR target_id=%d", account_id, account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из charity
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM charity WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из business_gps
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM business_gps WHERE bid IN (SELECT id FROM business WHERE owner_id=%d)", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из business_profit
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM business_profit WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // Удаляем из fuel_stations_profit
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM fuel_stations_profit WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    // ===== 3. ЕСЛИ ИГРОК ОНЛАЙН - ПОКАЗЫВАЕМ ДИАЛОГ =====
    if(target_id != INVALID_PLAYER_ID && IsPlayerConnected(target_id))
    {
        // Очищаем все данные игрока в памяти
        g_player[target_id] = g_player_default_values;
        
        // ===== ДИАЛОГ ДЛЯ ИГРОКА =====
        new dialog_text[1024];
        
        // Получаем текущую дату и время
        new year, month, day, hour, minute, second;
        getdate(year, month, day);
        gettime(hour, minute, second);
        
        new date_str[32];
        format(date_str, sizeof(date_str), "%02d.%02d.%d в %02d:%02d", day, month, year, hour, minute);
        
        format(dialog_text, sizeof(dialog_text),
            "{FFFFFF}Ваш аккаунт был удален администрацией за нарушение\n\
            правил сервера. Вы больше не можете играть на этом аккаунте.\n\n\
            {FFFF00}| {FFFFFF}Ваш никнейм: {FFFF00}%s\n\
            {FFFF00}| {FFFFFF}Никнейм администратора: {FFFF00}%s\n\
            {FFFF00}| {FFFFFF}Дата удаления: {FFFF00}%s\n\
            {FFFF00}| {FFFFFF}Причина удаления: {FFFF00}%s\n\n\
            {FF0000}ВНИМАНИЕ! Восстановление аккаунта невозможно!\n\n\
            {FFFFFF}Вы не согласны с решением администратора и считаете, что наказание\n\
            было выдано несправедливо или ошибочно? В таком случае,\n\
            необходимо обратиться в специальный раздел с жалобой на\n\
            официальном форуме проекта: {FFFF00}forum.usupovrp.ru.\n\n\
            {FFFFFF}Не забудьте прикрепить скриншот данного окна в жалобу.",
            GetPlayerNameEx(target_id),
            admin_name,
            date_str,
            reason
        );
        
        ShowPlayerDialog(target_id, 0, DIALOG_STYLE_MSGBOX,
            "{FF0000}? ВАШ АККАУНТ УДАЛЕН",
            dialog_text,
            "ОК", ""
        );
        
        // Кикаем игрока через 5 секунд
        SetTimerEx("KickPlayerAfterDelete", 5000, false, "i", target_id);
    }
    
    // ===== 4. СООБЩЕНИЕ В ЧАТ АДМИНАМ =====
    format(fmt_text, sizeof(fmt_text), 
        "{FF0000}[УДАЛЕНИЕ АККАУНТА] {FFFFFF}Администратор {FF9900}%s {FFFFFF}удалил аккаунт {FF9900}%s {FFFFFF}(ID: %d)",
        admin_name, target_name, account_id);
    SendMessageToAdmins(fmt_text, 0xFF0000FF);
    
    if(strlen(reason) > 0)
    {
        format(fmt_text, sizeof(fmt_text), "{FFFFFF}Причина: {FF9900}%s", reason);
        SendMessageToAdmins(fmt_text, 0xFFFFFFFF);
    }
    
    // ===== 5. ЛОГ В КОНСОЛЬ =====
    printf("[УДАЛЕНИЕ АККАУНТА] %s удалил аккаунт %s (ID: %d) Причина: %s", 
        admin_name, target_name, account_id, reason);
    
    if(mysql_errno())
    {
        printf("[ОШИБКА] При удалении аккаунта %d: %d", account_id, mysql_errno());
        return false;
    }
    
    return true;
}

public KickPlayerAfterDelete(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        // Очищаем данные перед киком
        ClearPlayerInfo(playerid);
        Kick(playerid);
    }
    return 1;
}





stock LoadPlayerSimCards(playerid)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0) return 0;
    
    // Очищаем старые SIM-карты
    g_player_sim_resource_count[playerid] = 0;
    for(new i = 0; i < 32; i++)
    {
        g_player_sim_resource[playerid][i][PSR_SQL_ID] = 0;
        g_player_sim_resource[playerid][i][PSR_NUMBER][0] = 0;
    }
    
    new query[256], Cache:result;
    mysql_format(mysql, query, sizeof(query),
        "SELECT id, number FROM player_sim_cards WHERE player_id=%d ORDER BY id ASC",
        account_id);
    result = mysql_query(mysql, query, true);
    
    new rows = cache_num_rows();
    for(new i = 0; i < rows && i < 32; i++)
    {
        g_player_sim_resource[playerid][i][PSR_SQL_ID] = cache_get_field_content_int(i, "id");
        cache_get_field_content(i, "number", g_player_sim_resource[playerid][i][PSR_NUMBER], mysql, 16);
        g_player_sim_resource_count[playerid]++;
        
        printf("[SIM] Загружена SIM-карта %s (SQL ID: %d) для игрока %d",
            g_player_sim_resource[playerid][i][PSR_NUMBER],
            g_player_sim_resource[playerid][i][PSR_SQL_ID],
            playerid);
    }
    
    cache_delete(result);
    return 1;
}

stock SavePlayerSimCards(playerid)
{
    new query[256];
    
    // Сначала удаляем старые SIM-карты игрока
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM player_sim_cards WHERE player_id=%d", 
        GetPlayerAccountID(playerid));
    mysql_query(mysql, query, false);
    
    // Сохраняем новые SIM-карты
    for(new i = 0; i < g_player_sim_resource_count[playerid]; i++)
    {
        mysql_format(mysql, query, sizeof query, 
            "INSERT INTO player_sim_cards (player_id, number) VALUES (%d, '%s')",
            GetPlayerAccountID(playerid), 
            g_player_sim_resource[playerid][i][PSR_NUMBER]);
        mysql_query(mysql, query, false);
        
        printf("[SIM] Сохранена SIM-карта для %s: %s", 
            GetPlayerNameEx(playerid), 
            g_player_sim_resource[playerid][i][PSR_NUMBER]);
    }
    
    return 1;
}


CMD:clearsim(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    new query[256];
    mysql_format(mysql, query, sizeof query, "TRUNCATE TABLE player_sim_cards");
    mysql_query(mysql, query, false);
    
    // Очищаем у всех игроков
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        g_player_sim_resource_count[i] = 0;
        for(new j = 0; j < 32; j++)
        {
            g_player_sim_resource[i][j][PSR_SQL_ID] = 0;
            g_player_sim_resource[i][j][PSR_NUMBER][0] = 0;
        }
    }
    
    SendClientMessage(playerid, 0x66CC33FF, "Все SIM-карты удалены!");
    return 1;
}


// ===== СИСТЕМА РАНЕНИЙ =====

stock SetPlayerWounded(playerid)
{
    if(g_PlayerWounded[playerid]) return 1;
    
    // Сохраняем позицию смерти
    GetPlayerPos(playerid, g_WoundPosition[playerid][0], g_WoundPosition[playerid][1], g_WoundPosition[playerid][2]);
    
    // Устанавливаем состояние
    g_PlayerWounded[playerid] = true;
    g_WoundNeedHelpTimer[playerid] = 0;
    
    // Телепортируем на место смерти
    SetPlayerPos(playerid, g_WoundPosition[playerid][0], g_WoundPosition[playerid][1], g_WoundPosition[playerid][2]);
    
    // Применяем анимацию
    ApplyAnimationEx(playerid, "SWAT", "gnstwall_injurd", 4.0, 1, 0, 0, 0, 0, 1, USE_ANIM_TYPE_NONE - 1);
    
    // Замораживаем игрока
    TogglePlayerControllable(playerid, false);
    
    // Создаем 3D текст над игроком
    new label_text[128];
    format(label_text, sizeof(label_text), "{FFFF00}СТАДИЯ РАНЕНИЯ\n{FFFFFF}Подойдите для оказания помощи");
    g_WoundLabel[playerid] = CreateDynamic3DTextLabel(
        label_text,
        0xFFFF00FF,
        g_WoundPosition[playerid][0],
        g_WoundPosition[playerid][1],
        g_WoundPosition[playerid][2] + 1.5,
        15.0,
        INVALID_PLAYER_ID,
        INVALID_VEHICLE_ID,
        0,
        0,
        -1,
        15.0
    );
    
    // Таймер для автоматической госпитализации через 60 секунд
    g_WoundTimer[playerid] = SetTimerEx("AutoHospitalizePlayer", 60000, false, "i", playerid);
    
    printf("[WOUND] Игрок %s[%d] ранен. Позиция: %.2f, %.2f, %.2f", 
        GetPlayerNameEx(playerid), playerid,
        g_WoundPosition[playerid][0], g_WoundPosition[playerid][1], g_WoundPosition[playerid][2]);
    
    return 1;
}

stock ClearPlayerWounded(playerid)
{
    if(!g_PlayerWounded[playerid]) return 1;
    
    if(g_WoundTimer[playerid] != -1)
    {
        KillTimer(g_WoundTimer[playerid]);
        g_WoundTimer[playerid] = -1;
    }
    
    if(IsValidDynamic3DTextLabel(g_WoundLabel[playerid]))
    {
        DestroyDynamic3DTextLabel(g_WoundLabel[playerid]);
        g_WoundLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
    }
    
    TogglePlayerControllable(playerid, true);
    ClearAnimations(playerid);
    
    g_PlayerWounded[playerid] = false;
    g_WoundNeedHelpTimer[playerid] = 0;
    
    return 1;
}

forward AutoHospitalizePlayer(playerid);
public AutoHospitalizePlayer(playerid)
{
    if(!IsPlayerConnected(playerid) || !g_PlayerWounded[playerid]) return 1;
    
    TeleportPlayerToHospital(playerid);
    
    return 1;
}

stock HealWoundedPlayer(healerid, targetid)
{
    if(!g_PlayerWounded[targetid]) 
        return SendClientMessage(healerid, 0x999999FF, "Этот игрок не ранен");
    
    if(!IsPlayerInRangeOfPoint(healerid, WOUND_HELP_RADIUS, 
        g_WoundPosition[targetid][0], 
        g_WoundPosition[targetid][1], 
        g_WoundPosition[targetid][2]))
    {
        return SendClientMessage(healerid, 0x999999FF, "Вы слишком далеко от раненого");
    }
    
    // Очищаем состояние ранения
    ClearPlayerWounded(targetid);
    
    // Восстанавливаем здоровье
    SetPlayerHealth(targetid, 50.0);
    SetPlayerData(targetid, P_HEALTH, 50.0);
    
    // Размораживаем
    TogglePlayerControllable(targetid, true);
    ClearAnimations(targetid);
    
    // Сообщения
    new fmt_msg[128];
    format(fmt_msg, sizeof(fmt_msg), "%s оказал помощь %s", 
        GetPlayerNameEx(healerid), GetPlayerNameEx(targetid));
    SendMessageInLocal(healerid, fmt_msg, 0x66CC33FF, 25.0);
    
    SendClientMessage(targetid, 0x66CC33FF, "Вам оказали помощь!");
    SendClientMessage(healerid, 0x66CC33FF, "Вы оказали помощь игроку!");
    
    // Даем опыт хилеру
    AddPlayerData(healerid, P_EXP, +, 5);
    
    printf("[WOUND] Игрок %s[%d] оказал помощь %s[%d]", 
        GetPlayerNameEx(healerid), healerid, 
        GetPlayerNameEx(targetid), targetid);
    
    return 1;
}


// Обработка команды помощи раненому
CMD:helpwound(playerid, params[])
{
    if(!strlen(params))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /helpwound [id игрока]");
    
    new targetid;
    if(sscanf(params, "d", targetid))
        return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /helpwound [id игрока]");
    
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
        return SendClientMessage(playerid, 0x999999FF, "Такого игрока нет");
    
    return HealWoundedPlayer(playerid, targetid);
}

// ===== СОХРАНЕНИЕ ТОПЛИВА В БД =====
stock SaveVehicleFuel(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0;
    
    // Проверяем, личное ли это авто
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return 0;
    
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index == -1) 
    {
        printf("[FUEL] ОШИБКА: index == -1 для vehicleid %d", vehicleid);
        return 0;
    }
    
    new Float:fuel = GetVehicleData(vehicleid, V_FUEL);
    new sql_id = GetOwnableCarData(index, OC_SQL_ID);
    new query[128];
    
    printf("[FUEL] СОХРАНЕНИЕ: SQL ID %d, топливо %.1f л.", sql_id, fuel);
    
    mysql_format(mysql, query, sizeof query, 
        "UPDATE ownable_cars SET fuel=%f WHERE id=%d", 
        fuel, 
        sql_id);
    mysql_query(mysql, query, false);
    
    if(mysql_errno() == 0)
        printf("[FUEL] СОХРАНЕНИЕ: Успешно! SQL ID %d, топливо %.1f л.", sql_id, fuel);
    else
        printf("[FUEL] СОХРАНЕНИЕ: Ошибка MySQL! errno=%d", mysql_errno());
    
    return 1;
}


// ===== ЗАГРУЗКА ТОПЛИВА ИЗ БД =====
stock LoadVehicleFuel(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0;
    
    // Проверяем, личное ли это авто
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return 0;
    
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index == -1) return 0;
    
    new query[128], Cache:result;
    new Float:fuel = 50.0; // Значение по умолчанию
    
    mysql_format(mysql, query, sizeof query, 
        "SELECT fuel FROM ownable_cars WHERE id=%d", 
        GetOwnableCarData(index, OC_SQL_ID));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        fuel = cache_get_field_content_float(0, "fuel");
    }
    cache_delete(result);
    
    // Защита от некорректных значений
    if(fuel < 0.0 || fuel > 150.0) fuel = 50.0;
    
    SetVehicleData(vehicleid, V_FUEL, fuel);
    
    printf("[FUEL] Загружено топливо для авто ID %d: %.1f л.", GetOwnableCarData(index, OC_SQL_ID), fuel);
    
    return 1;
}

// ===== ПОКАЗАТЬ МЕНЮ АЗС =====
stock ShowFuelMenu(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    
    // Проверка: игрок должен быть за рулем
    if(!IsPlayerDriver(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"Вы должны быть за рулем транспортного средства");
    
    new stationid = GetNearestFuelStation(playerid, 10.0);
    
    // Проверка: есть ли АЗС рядом
    if(stationid == -1)
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"Поблизости нет заправочной станции");
    
    // Проверка: stationid не выходит за пределы массива
    if(stationid < 0 || stationid >= g_fuel_station_loaded)
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"Ошибка: АЗС не найдена");
    
    new fuel_price = GetFuelStationData(stationid, FS_FUEL_PRICE);
    new dialog_text[512];
    
    format(dialog_text, sizeof(dialog_text),
        "{FFFF00}1.{FFFFFF} Заправка транспортного средства {32CD32}(1 литр - %d руб.)\n\
        {FFFF00}2.{FFFFFF} Покупка ремонтного комплекта для транспортного средства {32CD32}(250 руб.)\n\
        {FFFF00}3.{FFFFFF} Покупка канистры для заправки транспортного средства {32CD32}(200 руб.)",
        fuel_price
    );
    
    new title[64];
    format(title, sizeof(title), "{FFFF00} Меню АЗС #%d", stationid + 1);
    
    Dialog(playerid, DIALOG_FUEL_MENU, DIALOG_STYLE_LIST,
        title,
        dialog_text,
        "Выбрать",
        "Закрыть"
    );
}

// ===== ПОКАЗАТЬ ДИАЛОГ ВВОДА КОЛИЧЕСТВА =====
stock ShowFuelAmountDialog(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float:current_fuel = GetVehicleData(vehicleid, V_FUEL);
    new Float:max_fuel = 150.0;
    new Float:available = max_fuel - current_fuel;
    
    new dialog_text[256];
    format(dialog_text, sizeof(dialog_text),
        "{FFFFFF}Введите количество топлива, которое нужно заправить\n\n\
        {FFFFFF}Текущий уровень топлива: {FFFF00}%.1f {FFFFFF}/ 150 л.\n\
        {FFFFFF}Доступно для заправки: {32CD32}%.1f {FFFFFF}л.\n\n\
        {FF0000}Внимание: Двигатель должен быть выключен!",
        current_fuel, available
    );
    
    Dialog(playerid, DIALOG_FUEL_AMOUNT, DIALOG_STYLE_INPUT,
        "{FFFF00}Заправка транспортного средства",
        dialog_text,
        "Заправить", "Назад"
    );
}


forward FinishRefueling(playerid);
public FinishRefueling(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    
    if(!g_PlayerRefueling[playerid]) return 1;
    
    new vehicleid = g_RefuelVehicle[playerid];
    new Float:amount = g_RefuelAmount[playerid];
    
    if(!IsValidVehicle(vehicleid) || !IsPlayerInVehicle(playerid, vehicleid))
    {
        SendClientMessage(playerid, 0xFF6600FF, ""USC"Заправка прервана! Вы вышли из транспорта.");
        g_PlayerRefueling[playerid] = false;
        return 1;
    }
    
    // Добавляем топливо
    new Float:current_fuel = GetVehicleData(vehicleid, V_FUEL);
    SetVehicleData(vehicleid, V_FUEL, current_fuel + amount);
    
    // Сохраняем в БД
    SaveVehicleFuel(vehicleid);
    
    // Уведомления
    new msg[128];
    format(msg, sizeof(msg), ""SC"Заправка завершена! Добавлено {FFFF00}%.1f {FFFFFF}л. Текущий уровень: {FFFF00}%.1f {FFFFFF}/ 150 л.",
        amount, GetVehicleData(vehicleid, V_FUEL));
    SendClientMessage(playerid, 0x66CC33FF, msg);
    
    ShowNotificationNew(playerid, 3, 5, -1, -1, "Заправка завершена!", "");
    
    // Сброс
    g_PlayerRefueling[playerid] = false;
    g_RefuelTimer[playerid] = -1;
    g_RefuelAmount[playerid] = 0.0;
    g_RefuelVehicle[playerid] = INVALID_VEHICLE_ID;
    
    return 1;
}

CMD:fuelinfo(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"Вы должны быть в транспорте");
    
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float:fuel = GetVehicleData(vehicleid, V_FUEL);
    
    // Проверяем, личное ли авто
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        new index = GetVehicleData(vehicleid, V_ACTION_ID);
        new msg[256];
        format(msg, sizeof(msg),
            ""SC"Информация о топливе:\n\
            {FFFFFF}В памяти: {FFFF00}%.1f {FFFFFF}л.\n\
            {FFFFFF}В БД: {FFFF00}%.1f {FFFFFF}л.\n\
            {FFFFFF}ID авто: {FFFF00}%d",
            fuel,
            GetVehicleFuelFromDB(vehicleid),
            GetOwnableCarData(index, OC_SQL_ID)
        );
        SendClientMessage(playerid, 0x66CC33FF, msg);
    }
    else
    {
        new msg[128];
        format(msg, sizeof(msg), ""SC"Текущий уровень топлива: {FFFF00}%.1f {FFFFFF}/ 150 л.", fuel);
        SendClientMessage(playerid, 0x66CC33FF, msg);
    }
    
    return 1;
}

// ===== ПОЛУЧИТЬ ТОПЛИВО ИЗ БД ПО ID АВТО =====
stock Float:GetVehicleFuelFromDB(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0.0;
    
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return 0.0;
    
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index == -1) return 0.0;
    
    new query[128], Cache:result;
    new Float:fuel = 50.0;
    
    mysql_format(mysql, query, sizeof query, 
        "SELECT fuel FROM ownable_cars WHERE id=%d", 
        GetOwnableCarData(index, OC_SQL_ID));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        fuel = cache_get_field_content_float(0, "fuel");
    }
    cache_delete(result);
    
    return fuel;
}

// ===== СОХРАНЕНИЕ ТОПЛИВА ВСЕХ АВТО =====
stock SaveAllVehiclesFuel()
{
    new count = 0;
    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(IsValidVehicle(i) && GetVehicleData(i, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        {
            SaveVehicleFuel(i);
            count++;
        }
    }
    printf("[FUEL] Сохранено топливо для %d личных авто", count);
    return 1;
}


CMD:checkfueldb(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1) return 1;
    
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, "Вы должны быть в транспорте");
    
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return SendClientMessage(playerid, 0xCECECEFF, "Это не личное авто");
    
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    new sql_id = GetOwnableCarData(index, OC_SQL_ID);
    
    new query[128], Cache:result;
    new Float:db_fuel = 0.0;
    
    mysql_format(mysql, query, sizeof query, 
        "SELECT fuel FROM ownable_cars WHERE id=%d", sql_id);
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        db_fuel = cache_get_field_content_float(0, "fuel");
    }
    cache_delete(result);
    
    new Float:mem_fuel = GetVehicleData(vehicleid, V_FUEL);
    
    new msg[256];
    format(msg, sizeof(msg),
        ""SC"Проверка топлива:\n\
        {FFFFFF}В памяти: {FFFF00}%.1f {FFFFFF}л.\n\
        {FFFFFF}В БД: {FFFF00}%.1f {FFFFFF}л.\n\
        {FFFFFF}SQL ID: {FFFF00}%d",
        mem_fuel, db_fuel, sql_id);
    SendClientMessage(playerid, 0x66CC33FF, msg);
    
    return 1;
}

CMD:sub0(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы должны находиться в автомобиле");

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы должны быть за рулем");

    new vehicleid = GetPlayerVehicleID(playerid);
    
    if(GetPlayerOwnableCar(playerid) != vehicleid)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Сабвуфер можно включить только в личном автомобиле");

    // Если сабвуфер уже включен - выключаем
    if(g_PlayerSubwooferActive[playerid])
    {
        callcmd::suboff(playerid, "");
    }

    PlayAudioStreamURL(playerid, "http://rusradio.hostingradio.ru/rusradio128.mp3");
    
    g_PlayerSubwooferActive[playerid] = true;
    g_PlayerSubwooferStation[playerid] = 0;
    g_PlayerSubwooferVehicle[playerid] = vehicleid;
    
    // Обновляем DLSB для всех игроков у кого включен
    foreach(new i : Player)
    {
        if(g_SubwooferDebugActive[i])
        {
            UpdateDLSB(i);
        }
    }
    
    SendClientMessage(playerid, -1, "{00FF00}Включено Российское Радио");
    SendClientMessage(playerid, -1, "{FFFF00}Используйте /dlsb для отображения информации над авто");
    return 1;
}

