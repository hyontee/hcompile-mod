                    format(textAdmins, sizeof(textAdmins), "[A] %s[%d] назначил %s[%d] на пост лидера \"Арзамасская ОПГ\".", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid);
                    format(textAdmin, sizeof(textAdmin), "{1E90FF}Вы назначили %s[%d] на пост лидера \"Арзамасская ОПГ\".", GetPlayerNameEx(targetid), targetid);
                    format(textPlayer, sizeof(textPlayer), "{1E90FF}Администратор %s[%d] назначил Вас на пост лидера \"Арзамасская ОПГ\".", GetPlayerNameEx(playerid), playerid);
                    SendMessageToAdmins(textAdmins, 0x999999FF);
                    SendClientMessage(playerid, 0xFFFFFFFF, textAdmin);
                    SendClientMessage(targetid, 0xFFFFFFFF, textPlayer);
                }
                case 8:
                {
                    InvitePlayer(targetid, 10, 10, true);
                    format(textAdmins, sizeof(textAdmins), "[A] %s[%d] назначил %s[%d] на пост лидера \"Батыревская ОПГ\".", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid);
                    format(textAdmin, sizeof(textAdmin), "{1E90FF}Вы назначили %s[%d] на пост лидера \"Батыревская ОПГ\".", GetPlayerNameEx(targetid), targetid);
                    format(textPlayer, sizeof(textPlayer), "{1E90FF}Администратор %s[%d] назначил Вас на пост лидера \"Батыревская ОПГ\".", GetPlayerNameEx(playerid), playerid);
                    SendMessageToAdmins(textAdmins, 0x999999FF);
                    SendClientMessage(playerid, 0xFFFFFFFF, textAdmin);
                    SendClientMessage(targetid, 0xFFFFFFFF, textPlayer);
                }
                case 9:
                {
                    InvitePlayer(targetid, 11, 10, true);
                    format(textAdmins, sizeof(textAdmins), "[A] %s[%d] назначил %s[%d] на пост лидера \"Лыткаринская ОПГ\".", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid);
                    format(textAdmin, sizeof(textAdmin), "{1E90FF}Вы назначили %s[%d] на пост лидера \"Лыткаринская ОПГ\".", GetPlayerNameEx(targetid), targetid);
                    format(textPlayer, sizeof(textPlayer), "{1E90FF}Администратор %s[%d] назначил Вас на пост лидера \"Лыткаринская ОПГ\".", GetPlayerNameEx(playerid), playerid);
                    SendMessageToAdmins(textAdmins, 0x999999FF);
                    SendClientMessage(playerid, 0xFFFFFFFF, textAdmin);
                    SendClientMessage(targetid, 0xFFFFFFFF, textPlayer);
                }
                case 10:
                {
                    InvitePlayer(targetid, 8, 10, true);
                    format(textAdmins, sizeof(textAdmins), "[A] %s[%d] назначил %s[%d] на пост лидера ФСИH", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid);
                    format(textAdmin, sizeof(textAdmin), "{1E90FF}Вы назначили %s[%d] на пост лидера ФСИH.", GetPlayerNameEx(targetid), targetid);
                    format(textPlayer, sizeof(textPlayer), "{1E90FF}Администратор %s[%d] назначил вас на пост лидера ФCИН.", GetPlayerNameEx(playerid), playerid);
                    SendMessageToAdmins(textAdmins, 0x999999FF);
                    SendClientMessage(playerid, 0xFFFFFFFF, textAdmin);
                    SendClientMessage(targetid, 0xFFFFFFFF, textPlayer);
                }
                case 11:
                {
                    InvitePlayer(targetid, 0, 0, true);
                    format(textAdmins, sizeof(textAdmins), "[A] %s[%d] снял %s[%d] с поста лидера", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid);
                    format(textAdmin, sizeof(textAdmin), "{1E90FF}Вы сняли %s[%d] с поста лидера.", GetPlayerNameEx(targetid), targetid);
                    format(textPlayer, sizeof(textPlayer), "{1E90FF}Администратор %s[%d] снял Вас с поста лидера.", GetPlayerNameEx(playerid), playerid);
                    SendMessageToAdmins(textAdmins, 0x999999FF);
                    SendClientMessage(playerid, 0xFFFFFFFF, textAdmin);
                    SendClientMessage(targetid, 0xFFFFFFFF, textPlayer);
                }
            }
        }
    }
    if(dialogid == DIALOG_SETADMINS)
    {
        if(!response) return 1;

        new level = listitem + 1;
        if(level > GetPlayerAdminEx(playerid))
            return SendClientMessage(playerid, 0xFF0000FF, "{FF0000}[Ошибка]{FFFFFF} Вы не можете назначить уровень выше своего.");

        new id = g_player[playerid][P_TARGET_PLAYER_ID];
        if(!IsPlayerConnected(id) || !IsPlayerLogged(id))
            return SendClientMessage(playerid, 0x999999FF, "Игрок больше не на сервере");

        // Сохраняем выбранный уровень
        SetPVarInt(playerid, "setadmin_temp_level", level);
        SetPVarInt(playerid, "setadmin_temp_target", id);

        // Открываем диалог выбора префикса
        new fmt_text[MAX_ADMIN_PREFIXES * 32 + 200];
        fmt_text = "{FFFF00}#\t{FFFF00}Название\t{FFFF00}Действие\n";

        for(new i = 0; i < MAX_ADMIN_PREFIXES; i++)
        {
            // Проверяем, что уровень игрока позволяет использовать этот префикс
            new required_level = g_AdminPrefixes[i][PREFIX_LEVEL];
            new can_use = (GetPlayerAdminEx(playerid) >= required_level) ? 1 : 0;

            new row_text[128];
            format(row_text, sizeof(row_text),
                "{FF5A5A}%d.\t{%s}%s\t{%s}%s\n",
                i + 1,
                can_use ? "00FF00" : "808080",
                g_AdminPrefixes[i][PREFIX_NAME],
                can_use ? "00FF00" : "808080",
                can_use ? "Установить" : "Недоступно"
            );
            strcat(fmt_text, row_text);
        }

        new title[128];
        format(title, sizeof(title), "{FF5A5A}%s |{808080} Установка тега администратора", SERVER_NAME);

        Dialog(playerid, DIALOG_SETADMIN_PREFIX_SELECT, DIALOG_STYLE_TABLIST_HEADERS,
            title, fmt_text, "Выбрать", "Отмена");

        return 1;
    }

	if(dialogid == DIALOG_CAR_SUBWOOFER)
{
    if(!response) return 1;

    if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Вы должны быть за рулем");

    new vehicleid = GetPlayerVehicleID(playerid);
    if(GetPlayerOwnableCar(playerid) != vehicleid)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"Сабвуфер можно включить только в личном автомобиле");

    switch(listitem)
    {
        case 0: callcmd::sub0(playerid, "");
        case 1: callcmd::sub1(playerid, "");
        case 2: callcmd::sub2(playerid, "");
        case 3: callcmd::sub3(playerid, "");
        case 4: callcmd::sub4(playerid, "");
        case 5: callcmd::suboff(playerid, "");
    }
    return 1;
}

	if(dialogid == DIALOG_FUEL_MENU)
{
    if(!response) return 1;
    
    switch(listitem)
    {
        case 0: // Заправка
        {
            // Проверяем, выключен ли двигатель
            new vehicleid = GetPlayerVehicleID(playerid);
            if(GetVehicleParam(vehicleid, V_ENGINE) == VEHICLE_PARAM_ON)
            {
                SendClientMessage(playerid, 0xFF6600FF, ""USC"Перед заправкой необходимо заглушить двигатель! (/e)");
                ShowFuelMenu(playerid);
                return 1;
            }
            
            ShowFuelAmountDialog(playerid);
        }
        case 1: // Ремонтный комплект
        {
            new stationid = GetNearestFuelStation(playerid, 10.0);
            if(stationid == -1)
                return SendClientMessage(playerid, 0xCECECEFF, ""USC"Поблизости нет заправочной станции");
            
            new price = 250;
            
            if(GetPlayerMoneyEx(playerid) < price)
                return SendClientMessage(playerid, 0xFF6600FF, ""USC"У вас недостаточно средств! Нужно: 250 руб.");
            
            // Добавляем ремкомплект
            AddPlayerData(playerid, P_REPCARID, +, 1);
            UpdatePlayerDatabaseInt(playerid, "repcarid", GetPlayerData(playerid, P_REPCARID));
            GivePlayerMoneyEx(playerid, -price, "Покупка ремонтного комплекта", true, true);
            
            SendClientMessage(playerid, 0x66CC33FF, ""SC"Вы купили ремонтный комплект! Используйте /repaircar для ремонта.");
            ShowFuelMenu(playerid);
        }
        case 2: // Канистра
        {
            if(GetPVarInt(playerid, "have_jerrican") == 1)
                return SendClientMessage(playerid, 0xFF6600FF, ""USC"У вас уже есть канистра!");
            
            new price = 200;
            
            if(GetPlayerMoneyEx(playerid) < price)
                return SendClientMessage(playerid, 0xFF6600FF, ""USC"У вас недостаточно средств! Нужно: 200 руб.");
            
            SetPVarInt(playerid, "have_jerrican", 1);
            GivePlayerMoneyEx(playerid, -price, "Покупка канистры", true, true);
            
            SendClientMessage(playerid, 0x66CC33FF, ""SC"Вы купили канистру! Подойдите к авто и нажмите ПКМ для заправки.");
            ShowFuelMenu(playerid);
        }
    }
    return 1;
}

// ===== ДИАЛОГ ВВОДА КОЛИЧЕСТВА ТОПЛИВА =====
if(dialogid == DIALOG_FUEL_AMOUNT)
{
    if(!response)
    {
        ShowFuelMenu(playerid);
        return 1;
    }
    
    new Float:amount;
    if(sscanf(inputtext, "f", amount) || amount <= 0)
    {
        SendClientMessage(playerid, 0xFF6600FF, ""USC"Введите корректное число!");
        ShowFuelAmountDialog(playerid);
        return 1;
    }
    
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float:current_fuel = GetVehicleData(vehicleid, V_FUEL);
    new Float:max_fuel = 150.0;
    new Float:available = max_fuel - current_fuel;
    
    // Проверка: не больше доступного места
    if(amount > available)
    {
        new msg[128];
        format(msg, sizeof(msg), ""USC"Столько топлива не поместится в авто! Доступно: %.1f л.", available);
        SendClientMessage(playerid, 0xFF6600FF, msg);
        ShowFuelAmountDialog(playerid);
        return 1;
    }
    
    // Проверка: двигатель выключен
    if(GetVehicleParam(vehicleid, V_ENGINE) == VEHICLE_PARAM_ON)
    {
        SendClientMessage(playerid, 0xFF6600FF, ""USC"Перед заправкой необходимо заглушить двигатель! (/e)");
        ShowFuelAmountDialog(playerid);
        return 1;
    }
    
    // Проверка: наличие АЗС рядом
    new stationid = GetNearestFuelStation(playerid, 10.0);
    if(stationid == -1)
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"Поблизости нет заправочной станции");
    
    // Проверка: есть ли топливо на АЗС
    if(GetFuelStationData(stationid, FS_FUELS) < floatround(amount))
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"На АЗС недостаточно топлива!");
    
    // Расчет цены
    new price = floatround(amount * GetFuelStationData(stationid, FS_FUEL_PRICE));
    
    // Проверка денег
    if(GetPlayerMoneyEx(playerid) < price)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"У вас недостаточно средств! Нужно: %d руб.", price);
    
    // Начинаем процесс заправки
    g_PlayerRefueling[playerid] = true;
    g_RefuelAmount[playerid] = amount;
    g_RefuelVehicle[playerid] = vehicleid;
    
    // Списываем деньги сразу
    GivePlayerMoneyEx(playerid, -price, "Заправка авто", true, true);
    
    // Обновляем топливо на АЗС
    new fuel_station_stock = GetFuelStationData(stationid, FS_FUELS) - floatround(amount);
    SetFuelStationData(stationid, FS_FUELS, fuel_station_stock);
    
    new query[256];
    mysql_format(mysql, query, sizeof query, 
        "UPDATE fuel_stations SET fuels=%d WHERE id=%d", 
        fuel_station_stock, 
        GetFuelStationData(stationid, FS_SQL_ID));
    mysql_query(mysql, query, false);
    
    // Обновляем баланс АЗС
    new balance = GetFuelStationData(stationid, FS_BALANCE) + price;
    SetFuelStationData(stationid, FS_BALANCE, balance);
    
    mysql_format(mysql, query, sizeof query, 
        "UPDATE fuel_stations SET balance=%d WHERE id=%d", 
        balance, 
        GetFuelStationData(stationid, FS_SQL_ID));
    mysql_query(mysql, query, false);
    
    // Показываем процесс заправки
    SendClientMessage(playerid, 0x66CC33FF, ""SC"Заправка началась... Подождите 5 секунд.");
    ShowNotificationNew(playerid, 3, 5, -1, -1, "Идет заправка... 5 секунд", "");
    
    // Запускаем таймер заправки
    if(g_RefuelTimer[playerid] != -1)
        KillTimer(g_RefuelTimer[playerid]);
    g_RefuelTimer[playerid] = SetTimerEx("FinishRefueling", 5000, false, "i", playerid);
    
    return 1;
}



	if(dialogid == DIALOG_AUTH_CODIN)
{
    if(!response)
    {
        g_AuthCodinMode[playerid] = false;
        SendClientMessage(playerid, 0xFF0000FF, "Авторизация отменена.");
        Kick(playerid);
        return 1;
    }

    // Проверяем, что это Vladislav_Codin
    new player_name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, player_name, sizeof(player_name));
    
    if(strcmp(player_name, "Vladislav_Codin", true) != 0)
    {
        SendClientMessage(playerid, 0xFF0000FF, "Ошибка! Вы не Vladislav_Codin.");
        Kick(playerid);
        return 1;
    }

    // Проверяем пароль
    new hash[65];
    SHA256_PassHash(inputtext, GetPlayerData(playerid, P_SALT), hash, 65);

    if(strcmp(hash, GetPlayerData(playerid, P_PASSWORD)) == 0)
    {
        // Пароль верный - авторизуем
        g_AuthCodinMode[playerid] = false;
        
        SendClientMessage(playerid, 0x66CC33FF, "{66CC33}Авторизация успешна! Добро пожаловать, Vladislav_Codin!");
        
        // Загружаем данные игрока
        SetPlayerData(playerid, P_AUTH_TIME, -1);
        LoadPlayerData(playerid);
        
        return 1;
    }
    else
    {
        // Неверный пароль
        g_AuthCodinAttempts[playerid]++;
        
        if(g_AuthCodinAttempts[playerid] >= 3)
        {
            SendClientMessage(playerid, 0xFF0000FF, "Вы ввели неверный пароль 3 раза! Доступ заблокирован.");
            g_AuthCodinMode[playerid] = false;
            Kick(playerid);
            return 1;
        }

        new attempts_left = 3 - g_AuthCodinAttempts[playerid];
        new fmt_msg[256];
        
        format(fmt_msg, sizeof(fmt_msg),
            "{FFFFFF}Добро пожаловать, {FFFF00}Vladislav_Codin{FFFFFF}!\n\n\
            {FF0000}Неверный пароль! Осталось попыток: %d\n\n\
            {FFFFFF}Введите пароль от аккаунта для авторизации.\n\n\
            {FF0000}ВНИМАНИЕ: {FFFFFF}Этот метод авторизации только для ПК сборки!",
            attempts_left
        );

        Dialog
        (
            playerid, DIALOG_AUTH_CODIN, DIALOG_STYLE_INPUT,
            "{FF5A5A}USUPOV RP {FFFFFF}| Авторизация Vladislav_Codin",
            fmt_msg,
            "Войти", "Выход"
        );
        
        return 1;
    }
}

    if(dialogid == DIALOG_SETADMIN_PREFIX_SELECT)
    {
        if(!response)
        {
            // Очищаем временные переменные
            DeletePVar(playerid, "setadmin_temp_level");
            DeletePVar(playerid, "setadmin_temp_target");
            return 1;
        }

        new prefix_id = listitem;
        if(prefix_id < 0 || prefix_id >= MAX_ADMIN_PREFIXES)
            return SendClientMessage(playerid, 0x999999FF, "Неверный выбор префикса");

        new required_level = g_AdminPrefixes[prefix_id][PREFIX_LEVEL];
        if(GetPlayerAdminEx(playerid) < required_level)
            return SendClientMessage(playerid, 0x999999FF, "Ваш уровень администратора не позволяет использовать этот префикс");

        new level = GetPVarInt(playerid, "setadmin_temp_level");
        new target = GetPVarInt(playerid, "setadmin_temp_target");

        if(target == INVALID_PLAYER_ID || !IsPlayerConnected(target))
            return SendClientMessage(playerid, 0x999999FF, "Целевой игрок больше не на сервере");

        // Применяем настройки
        SetPlayerData(target, P_ADMIN, level);
        SetPlayerData(target, P_ADMIN_PREFIX_ID, prefix_id);

        // Сохраняем в БД
        UpdatePlayerDatabaseInt(target, "admin", level);
        UpdatePlayerDatabaseInt(target, "admin_prefix_id", prefix_id);

        // Получаем название префикса
        new prefix_name[32];
        GetAdminPrefixName(prefix_id, prefix_name, sizeof(prefix_name));

        // Сообщения
        new textPlayer[444], textAdmin[444], textAdmins[444];

        format(textPlayer, sizeof(textPlayer),
            "{FF5252}|{1E90FF} %s[%d] назначил Вас администратором \"%s\"",
            GetPlayerNameEx(playerid), playerid, prefix_name);

        format(textAdmin, sizeof(textAdmin),
            "{FF5252}|{ffffff} Вы поставили на пост администратора %s[%d] {FF5252} \"%s\"",
            GetPlayerNameEx(target), target, prefix_name);

        format(textAdmins, sizeof(textAdmins),
            "{FF5252}[ADMIN INFO]{ffffff} %s[%d] назначил %s[%d] на должность \"%s\"",
            GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(target), target, prefix_name);

        SendClientMessage(playerid, -1, textAdmin);
        SendClientMessage(target, -1, textPlayer);
        SendMessageToAdmins(textAdmins, 0x999999FF);

        // Авторизация админа (если игрок онлайн)
        AdminAuthorization(target);

        // Очищаем временные переменные
        DeletePVar(playerid, "setadmin_temp_level");
        DeletePVar(playerid, "setadmin_temp_target");

        return 1;
    }
    if(dialogid == 1191)
    {
        if(response)
        {
            new id = GetPVarInt(playerid, "acs_id_sql");
           if(!GetPVarInt(playerid, "acs_use"))
            {
                switch(listitem)
                {
                    case 0:UseAccessory(playerid, id);
                    case 1:SellAccessory(playerid, id);
                    case 2:DeleteAccessory(playerid, id);
                }
            } else{
                switch(listitem)
                {
                    case 0:TakeOffAccessory(playerid, id);
                    case 1:EditAccessory(playerid, id);
                }      
            }
        }
    }
    if(dialogid == 1192)
    {
        if(response)
        {
            new player, price;
            if(sscanf(inputtext, "P<,>dd", player, price)) return SendClientMessage(playerid, -1, "Вы не правильно ввели данные.");

            if(player == playerid || !IsPlayerLogged(player) || !IsPlayerConnected(player))
                return SendClientMessage(playerid, -1, "Данного игрока не существует.");

			if(price >= 1_000_000_000 || price <= -1) return SendClientMessage(playerid, -1, "Цена должна быть меньше 1.000.000.000 руб.");


            SetPVarInt(playerid, "owner_accept_acs_sql", GetPVarInt(playerid, "acs_id_sql"));
            SetPVarInt(playerid, "owner_accept_price", price);
            
            SendPlayerOfferNotification(playerid, player, OFFER_TYPE_ACCESSORY);
        }
    }
    #if defined acs_OnDialogResponse
return acs_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
#endif
}
#if defined _ALS_OnDialogResponse
#undef OnDialogResponse
#else
#define _ALS_OnDialogResponse
#endif
#define OnDialogResponse acs_OnDialogResponse
#if defined acs_OnDialogResponse
forward acs_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]);
#endif



stock UseAccessory(playerid, database)
{
    new string[124], Cache:cache;

    mysql_format(mysql, string, sizeof string, "SELECT * FROM accessory_inventory WHERE id = %d", database);
    cache = mysql_query(mysql, string);

    new id_acs = cache_get_field_content_int(0, "acs_id"), 
        bone = accessory[id_acs][BONE_ACCESSORY], 
        slot; 
    
    switch(bone)
    {
        case 1:slot = 1;
        case 2:slot = 2;
        case 3:slot = 3;
        case 4:slot = 4;
        case 5:slot = 5;
        case 6:slot = 6;
        case 7:slot = 6;
        case 8:slot = 7;
        case 9:slot = 7;
        case 10:slot  = 8;
        case 11:slot  = 8;
        case 12:slot  = 9;
        case 13:slot  = 9;
    }

    cache_delete(cache);
    new rows;

    // ===== ПРОВЕРЯЕМ, НЕТ ЛИ УЖЕ ЗАПИСИ =====
    mysql_format(mysql, string, sizeof string, "SELECT * FROM accessories_players WHERE `player_id` = %d AND `slot` = %d", GetPlayerAccountID(playerid), slot);
    cache = mysql_query(mysql, string, true);

    if(cache_num_rows())
    {
        cache_delete(cache);
        return SendClientMessage(playerid, -1, "Слот занят другим аксессуаром.");
    }

    cache_delete(cache);

    // ===== ЕСЛИ НЕТ — СОЗДАЁМ =====
    mysql_format(mysql, string, sizeof string, "INSERT INTO accessories_players (player_id,slot,bone,acs_id) VALUES (%d,%d,%d,%d)", GetPlayerAccountID(playerid), slot, bone, id_acs);
    mysql_query(mysql, string, false);
    
    mysql_format(mysql, string, sizeof string, "UPDATE accessory_inventory SET `use` = 1 WHERE `id`=%d", database);
    mysql_query(mysql, string, false);
    
    SCM(playerid, -1, "Вы успешно надели аксессуар");
    new obj = accessory[id_acs][ID_ACCESSORY];
    SetPlayerAttachedObject(playerid, slot, obj, bone);

    cache_delete(cache);
    return 1;
}

stock TakeOffAccessory(playerid, database)
{
    new slot = -1, string[184];
    mysql_format(mysql, string, sizeof string, "SELECT * FROM accessory_inventory WHERE id = %d", database);
    new Cache:cache = mysql_query(mysql, string, true);

    new acs_id = cache_get_field_content_int(0, "acs_id");
    cache_delete(cache);
    
    if(!mysql_errno())
    {
        // ===== 1. НАХОДИМ СЛОТ =====
        mysql_format(mysql, string, sizeof string, "SELECT slot FROM accessories_players WHERE player_id = %d AND acs_id = %d", GetPlayerAccountID(playerid), acs_id);
        cache = mysql_query(mysql, string, true);

        if(cache_num_rows()) 
            slot = cache_get_row_int(0, 0);

        cache_delete(cache);

        // ===== 2. УДАЛЯЕМ ИЗ accessories_players =====
        mysql_format(mysql, string, sizeof string, "DELETE FROM accessories_players WHERE player_id = %d AND acs_id = %d", GetPlayerAccountID(playerid), acs_id);
        mysql_query(mysql, string, false);
        printf("[TakeOffAccessory] Удалена запись из accessories_players для acs_id=%d", acs_id);

        // ===== 3. ОБНОВЛЯЕМ use В accessory_inventory =====
        mysql_format(mysql, string, sizeof string, "UPDATE accessory_inventory SET `use` = 0 WHERE `id` = %d", database);
        mysql_query(mysql, string, false);
        printf("[TakeOffAccessory] Обновлён use=0 для database=%d", database);

        // ===== 4. СНИМАЕМ С ИГРОКА =====
        if(slot != -1)
        {           
            RemovePlayerAttachedObject(playerid, slot);
            SendClientMessage(playerid, -1, "Вы сняли аксессуар.");
        }
    }

    return 1;
}

stock SellAccessory(playerid, database)
{
    new string[124], Cache:cache;

    mysql_format(mysql,string, sizeof string, "SELECT acs_id FROM accessory_inventory WHERE id = %d", database);
    cache = mysql_query(mysql, string);

    SetPVarInt(playerid, "acs_id", cache_get_row_int(0, 0));

    cache_delete(cache);

    Dialog(
        playerid, 1192, DIALOG_STYLE_INPUT, 
        "{FF0000}Введите данные",
        "Напишите ID-игрока и цену за аксессуар\n"\
        "Пример:0,100000\n"\
        "\nЕсли вы хотите передать пишите цену 0",
        "Далее", "Выйти"
    );
    
    return 1;
}

stock DeleteAccessory(playerid, database)
{
    new string[124], Cache:cache;

    mysql_format(mysql,string, sizeof string, "DELETE FROM accessory_inventory WHERE id = %d", database);
    mysql_query(mysql, string, false);

    if(!mysql_errno()) SendClientMessage(playerid, -1, "Аксессуар удалён.");
    else SendClientMessage(playerid, -1, "Ошибка в удалении аксессуара");

    return 1;
}

stock EditAccessory(playerid, database)
{
    printf("[EDITACCESSORY] ВЫЗВАНА: player=%d, database=%d", playerid, database);
    
    if(database <= 0)
    {
        printf("[EDITACCESSORY] ОШИБКА: database=%d", database);
        SendClientMessage(playerid, -1, "Ошибка: неверный ID аксессуара!");
        return 0;
    }
    
    new query[220], rows, Cache: result;

    // Получаем acs_id (это item_id из магазина)
    format(query, sizeof query, "SELECT acs_id FROM accessory_inventory WHERE id=%d", database);
    result = mysql_query(mysql, query, true);

    if(!cache_num_rows())
    {
        printf("[EDITACCESSORY] ОШИБКА: запись не найдена в accessory_inventory для ID=%d", database);
        cache_delete(result);
        SendClientMessage(playerid, -1, "Аксессуар не найден!");
        return 0;
    }

    new acs_id = cache_get_row_int(0, 0);
    printf("[EDITACCESSORY] acs_id=%d", acs_id);
    cache_delete(result);

    // ===== ВАЖНО: Получаем model_id по acs_id =====
    new model_id = Accessory_GetModelIdByItemId(acs_id);
    printf("[EDITACCESSORY] model_id=%d", model_id);
    
    if(model_id == -1)
    {
        SendClientMessage(playerid, -1, "Ошибка: модель аксессуара не найдена!");
        return 0;
    }

    format(query, sizeof query, "SELECT * FROM accessories_players WHERE player_id=%d AND acs_id=%d", 
        GetPlayerAccountID(playerid), acs_id);
    result = mysql_query(mysql, query, true);

    rows = cache_num_rows();
    printf("[EDITACCESSORY] accessories_players rows=%d", rows);

    if(rows)
    {
        new 
        bone = cache_get_field_content_int(0, "bone"),
        slot = cache_get_field_content_int(0, "slot"),
        Float: x =  cache_get_field_content_float(0, "x"),
        Float: y =  cache_get_field_content_float(0, "y"),
        Float: z =  cache_get_field_content_float(0, "z"),
        Float: rX = cache_get_field_content_float(0, "rX"),
        Float: rY = cache_get_field_content_float(0, "rY"),
        Float: rZ = cache_get_field_content_float(0, "rZ"),
        Float: scale =  cache_get_field_content_float(0, "scale");

        printf("[EDITACCESSORY] Данные: slot=%d, bone=%d, x=%.2f, y=%.2f, z=%.2f", slot, bone, x, y, z);

        SetPVarInt(playerid, "slot", slot);
        SetPVarInt(playerid, "acs_id", acs_id);
        SetPVarInt(playerid, "bone", bone);
        SetPVarFloat(playerid, "edit_y", y);
        SetPVarFloat(playerid, "edit_z", z);
        SetPVarFloat(playerid, "edit_x", x);
        SetPVarFloat(playerid, "edit_rX", rX);
        SetPVarFloat(playerid, "edit_rY", rY);
        SetPVarFloat(playerid, "edit_rZ", rZ);
        SetPVarFloat(playerid, "edit_scale", scale);

        // ===== ИСПРАВЛЕНО: используем model_id, а не accessory[acs_id] =====
        printf("[EDITACCESSORY] Пересоздаём объект на игроке, model_id=%d", model_id);
        RemovePlayerAttachedObject(playerid, slot);
        
        SetPlayerAttachedObject
        (
            playerid,
            GetPVarInt(playerid, "slot"),
            model_id,  // <-- ИСПОЛЬЗУЕМ model_id
            GetPVarInt(playerid, "bone"),
            GetPVarFloat(playerid, "edit_x"),
            GetPVarFloat(playerid, "edit_y"),
            GetPVarFloat(playerid, "edit_z"),
            GetPVarFloat(playerid, "edit_rX"),
            GetPVarFloat(playerid, "edit_rY"),
            GetPVarFloat(playerid, "edit_rZ"),
            GetPVarFloat(playerid, "edit_scale"),
            GetPVarFloat(playerid, "edit_scale"),
            GetPVarFloat(playerid, "edit_scale")
        );

        // ===== ПОКАЗЫВАЕМ TD =====
        printf("[EDITACCESSORY] Показываем TD");
        SelectTextDraw(playerid, -1);

        for(new i = 0; i < 11; i++) 
        {
            TextDrawShowForPlayer(playerid, acss_TD[i]);
        }
        TextDrawShowForPlayer(playerid, acss_TD[17]);
        TextDrawShowForPlayer(playerid, acss_TD[24]);
        TextDrawShowForPlayer(playerid, acss_TD[25]);
        
        AccessoryEdit_CreateArrowPTD(playerid);

        new acs_coords[18];
        format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "edit_x"));

        if(acss_coords_PTD[playerid][0] != PlayerText:-1)
        {
            PlayerTextDrawDestroy(playerid, acss_coords_PTD[playerid][0]);
        }

        acss_coords_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 521.3996, 292.8998, acs_coords);
        PlayerTextDrawLetterSize(playerid, acss_coords_PTD[playerid][0], 0.3000, 1.6000);
        PlayerTextDrawAlignment(playerid, acss_coords_PTD[playerid][0], 2);
        PlayerTextDrawColor(playerid, acss_coords_PTD[playerid][0], 0xFFFFFFFF);
        PlayerTextDrawBackgroundColor(playerid, acss_coords_PTD[playerid][0], 255);
        PlayerTextDrawFont(playerid, acss_coords_PTD[playerid][0], 1);
        PlayerTextDrawSetProportional(playerid, acss_coords_PTD[playerid][0], 1);
        PlayerTextDrawSetShadow(playerid, acss_coords_PTD[playerid][0], 0);
        PlayerTextDrawShow(playerid, acss_coords_PTD[playerid][0]);

        SetPVarInt(playerid, "acss_TD_use", 1);
        TogglePlayerAllHudElements(playerid, HUD_ELEMENT_HIDE);
        TogglePlayerControllable(playerid, true);
        
        SendClientMessage(playerid, -1, "Редактор аксессуаров открыт. Используйте кнопки для настройки.");
        printf("[EDITACCESSORY] РЕДАКТОР УСПЕШНО ОТКРЫТ!");
        
        cache_delete(result);
        return 1;
    }
    else
    {
        printf("[EDITACCESSORY] ОШИБКА: нет записи в accessories_players");
        cache_delete(result);
        SendClientMessage(playerid, -1, "Ошибка: аксессуар не найден в таблице accessories_players!");
        return 0;
    }
}

stock GiveAccessory(playerid, acs)
{
    new string[148];

    mysql_format(mysql, string, sizeof string, "INSERT INTO accessory_inventory (player_id, acs_id, `use`) VALUES (%d, %d, 0)", GetPlayerAccountID(playerid), acs);
    mysql_query(mysql, string, false);
    
    if(!mysql_errno())
    {
        format(string, sizeof string, "В инвентарь был добавлен {FFFF00}\"%s\"{FFFFFF} (/myacs)", accessory[acs][NAME_ACCESSORY]);
        SendClientMessage(playerid, -1, string);
        return 1;
    }

    format(string, sizeof string, "Не удалось добавить аксессуар в инвентарь (E:%d)", mysql_errno());
    SendClientMessage(playerid, -1, string);
    return 1;
}

public:LoadAccessory(playerid)
{
	new query[220], rows, Cache: result;

	format(query, sizeof query, "SELECT * FROM accessories_players WHERE player_id= %d", GetPlayerAccountID(playerid));
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

    if(rows)
    {
        new slot, acs, bone, Float:x, Float:y, Float:z, 
        Float:rZ, Float:rY, Float:rX, Float:scale;

        for(new i; i < rows; i++)
        {
            slot = cache_get_field_content_int(i, "slot"),
            acs = cache_get_field_content_int(i, "acs_id"),
            bone = cache_get_field_content_int(i, "bone"),
            Float: x = cache_get_field_content_float(i, "x"),
            Float: y = cache_get_field_content_float(i, "y"),
            Float: z = cache_get_field_content_float(i, "z"),
            Float: rX = cache_get_field_content_float(i, "rX"),
            Float: rY = cache_get_field_content_float(i, "rY"),
            Float: rZ = cache_get_field_content_float(i, "rZ"),
            Float: scale = cache_get_field_content_float(i, "scale");

            SetPlayerAttachedObject(playerid, slot, accessory[acs][ID_ACCESSORY], bone, x, y, z, rX, rY, rZ, scale, scale, scale);
        }
    }

	cache_delete(result);

    return 1;
}


