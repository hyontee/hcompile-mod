stock CreateDMZPlayerTextDraws(playerid)
{
    if(g_DMZTD_Created[playerid]) return 1;

    g_CAPTUREDM_TD_KILLS[playerid] = CreatePlayerTextDraw(playerid, 585.0000, 228.3703, "0~n~");
    PlayerTextDrawLetterSize(playerid, g_CAPTUREDM_TD_KILLS[playerid], 0.2850, 1.9474);
    PlayerTextDrawTextSize(playerid, g_CAPTUREDM_TD_KILLS[playerid], 595.0000, 0.0000);
    PlayerTextDrawAlignment(playerid, g_CAPTUREDM_TD_KILLS[playerid], 1);
    PlayerTextDrawColor(playerid, g_CAPTUREDM_TD_KILLS[playerid], 0x000000FF);
    PlayerTextDrawBackgroundColor(playerid, g_CAPTUREDM_TD_KILLS[playerid], 255);
    PlayerTextDrawFont(playerid, g_CAPTUREDM_TD_KILLS[playerid], 2);
    PlayerTextDrawSetProportional(playerid, g_CAPTUREDM_TD_KILLS[playerid], 1);
    PlayerTextDrawSetShadow(playerid, g_CAPTUREDM_TD_KILLS[playerid], 0);

    g_CAPTUREDM_TD_DEATHS[playerid] = CreatePlayerTextDraw(playerid, 610.0001, 228.3703, "0~n~");
    PlayerTextDrawLetterSize(playerid, g_CAPTUREDM_TD_DEATHS[playerid], 0.2850, 1.9474);
    PlayerTextDrawTextSize(playerid, g_CAPTUREDM_TD_DEATHS[playerid], 625.0000, 0.0000);
    PlayerTextDrawAlignment(playerid, g_CAPTUREDM_TD_DEATHS[playerid], 1);
    PlayerTextDrawColor(playerid, g_CAPTUREDM_TD_DEATHS[playerid], 0xFF0000FF);
    PlayerTextDrawBackgroundColor(playerid, g_CAPTUREDM_TD_DEATHS[playerid], 255);
    PlayerTextDrawFont(playerid, g_CAPTUREDM_TD_DEATHS[playerid], 2);
    PlayerTextDrawSetProportional(playerid, g_CAPTUREDM_TD_DEATHS[playerid], 1);
    PlayerTextDrawSetShadow(playerid, g_CAPTUREDM_TD_DEATHS[playerid], 0);

    g_DMZTD_Created[playerid] = true;
    return 1;
}

stock ShowDMZTD(playerid)
{
    if(!g_DMZTD_Created[playerid])
    {
        CreateDMZPlayerTextDraws(playerid);
    }

    UpdateDMZKills(playerid, g_DMZKills[playerid]);
    UpdateDMZDeaths(playerid, GetPlayerData(playerid, P_DMZ_KILL1));

    if(g_DMZTD_Shown[playerid]) return 1;

    for(new i = 0; i < 3; i++)
    {
        TextDrawShowForPlayer(playerid, g_CAPTUREDM_TD_TD[i]);
    }

    PlayerTextDrawShow(playerid, g_CAPTUREDM_TD_KILLS[playerid]);
    PlayerTextDrawShow(playerid, g_CAPTUREDM_TD_DEATHS[playerid]);

    g_DMZTD_Shown[playerid] = true;
    return 1;
}

stock HideDMZTD(playerid)
{
    if(!g_DMZTD_Created[playerid]) return 1;

    for(new i = 0; i < 3; i++)
    {
        TextDrawHideForPlayer(playerid, g_CAPTUREDM_TD_TD[i]);
    }

    PlayerTextDrawHide(playerid, g_CAPTUREDM_TD_KILLS[playerid]);
    PlayerTextDrawHide(playerid, g_CAPTUREDM_TD_DEATHS[playerid]);

    g_DMZTD_Shown[playerid] = false;
    return 1;
}

stock UpdateDMZKills(playerid, kills)
{
    if(!g_DMZTD_Created[playerid])
    {
        CreateDMZPlayerTextDraws(playerid);
    }

    g_DMZKills[playerid] = kills;

    new display_text[16];
    format(display_text, sizeof display_text, "%d~n~", kills);
    PlayerTextDrawSetString(playerid, g_CAPTUREDM_TD_KILLS[playerid], display_text);
    return 1;
}

stock UpdateDMZDeaths(playerid, deaths)
{
    if(!g_DMZTD_Created[playerid])
    {
        CreateDMZPlayerTextDraws(playerid);
    }

    g_DMZDeaths[playerid] = deaths;

    new display_text[16];
    format(display_text, sizeof display_text, "%d~n~", deaths);
    PlayerTextDrawSetString(playerid, g_CAPTUREDM_TD_DEATHS[playerid], display_text);
    return 1;
}

CMD:dmztd(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1)
        return SendClientMessage(playerid, 0xCECECEFF, "У вас нет прав.");

    g_DMZKills[playerid] = 0;
    g_DMZDeaths[playerid] = 0;

    UpdateDMZKills(playerid, 0);
    UpdateDMZDeaths(playerid, 0);
    ShowDMZTD(playerid);

    SendClientMessage(playerid, 0x66CC33FF, "DMZ статистика показана.");
    SendClientMessage(playerid, 0x3399FFFF, "Используйте /kdkill [число] - установить убийства");
    SendClientMessage(playerid, 0x3399FFFF, "Используйте /kddead [число] - установить смерти");
    return 1;
}

CMD:hidedmztd(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1)
        return SendClientMessage(playerid, 0xCECECEFF, "У вас нет прав.");

    HideDMZTD(playerid);
    SendClientMessage(playerid, 0x66CC33FF, "DMZ статистика скрыта.");
    return 1;
}

CMD:kdkill(playerid, params[])
{
    if(!g_DMZTD_Shown[playerid])
        return SendClientMessage(playerid, 0xCECECEFF, "Сначала покажите DMZ статистику: /dmztd");

    new kills;
    if(sscanf(params, "d", kills))
    {
        SendClientMessage(playerid, 0xFFFFFFFF, "Использование: /kdkill [число]");
        SendClientMessage(playerid, 0xFFFFFFFF, "Пример: /kdkill 15");
        return 1;
    }

    if(kills < 0 || kills > 99)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Число должно быть от 0 до 99");
        return 1;
    }

    UpdateDMZKills(playerid, kills);

    new fmt_msg[64];
    format(fmt_msg, sizeof fmt_msg, "Убийства обновлены: %d", kills);
    SendClientMessage(playerid, 0x66CC33FF, fmt_msg);
    return 1;
}

CMD:kddead(playerid, params[])
{
    if(!g_DMZTD_Shown[playerid])
        return SendClientMessage(playerid, 0xCECECEFF, "Сначала покажите DMZ статистику: /dmztd");

    new deaths;
    if(sscanf(params, "d", deaths))
    {
        SendClientMessage(playerid, 0xFFFFFFFF, "Использование: /kddead [число]");
        SendClientMessage(playerid, 0xFFFFFFFF, "Пример: /kddead 5");
        return 1;
    }

    if(deaths < 0 || deaths > 99)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Число должно быть от 0 до 99");
        return 1;
    }

    UpdateDMZDeaths(playerid, deaths);

    new fmt_msg[64];
    format(fmt_msg, sizeof fmt_msg, "Смерти обновлены: %d", deaths);
    SendClientMessage(playerid, 0x66CC33FF, fmt_msg);
    return 1;
}

CMD:dmzinfo(playerid, params[])
{
    ShowDMZTD(playerid);
    UpdateDMZKills(playerid, g_DMZKills[playerid]);
    UpdateDMZDeaths(playerid, GetPlayerData(playerid, P_DMZ_KILL1));

    SendClientMessage(playerid, 0x66CC33FF, "DMZ статистика показана.");
    return 1;
}

stock TopDMZKillsBuildLine(rank, const name[], kills, dest[], size)
{
    format(dest, size, "%d. Ник: %s | Убийств: %d\n", rank, name, kills);
    return 1;
}

public: TopDMZKills(playerid)
{
    new name[24], rows, fields, string[512], entry[128], kills;
    cache_get_data(rows, fields);
    string[0] = EOS;

    if(rows)
    {
        for(new i = 0; i < rows; i++)
        {
            name[0] = EOS;
            entry[0] = EOS;
            cache_get_field_content(i, "name", name, mysql);
            kills = cache_get_field_content_int(i, "dmz_kills", mysql);
            TopDMZKillsBuildLine(i + 1, name, kills, entry, sizeof entry);
            strcat(string, entry, sizeof string);
        }
    }
    else
    {
        format(string, sizeof string, "Нет данных.");
    }

    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "Топ 5 игроков DM ZONE", string, "Закрыть", "");
    return 1;
}



