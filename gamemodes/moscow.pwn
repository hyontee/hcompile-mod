SavePlayerGraphicSettings(playerid)
{
    new query[256];
    new playerid_db = GetPlayerAccountID(playerid);
    
    format(query, sizeof(query),
        "UPDATE players SET \
        gfx_water = '%d', \
        gfx_reflections = '%d', \
        gfx_distance = '%d', \
        gfx_sky = '%d', \
        gfx_aa = '%d', \
        gfx_lower_dd = '%d', \
        gfx_lower_cars = '%d' \
        WHERE id = '%d'",
        GetPVarInt(playerid, "gfx_water"),
        GetPVarInt(playerid, "gfx_reflections"), 
        GetPVarInt(playerid, "gfx_distance"),
        GetPVarInt(playerid, "gfx_sky"),
        GetPVarInt(playerid, "gfx_aa"),
        GetPVarInt(playerid, "gfx_lower_dd"),
        GetPVarInt(playerid, "gfx_lower_cars"),
        playerid_db
    );
    
    mysql_query(mysql, query, false);
}

LoadPlayerGraphicSettings(playerid)
{
    new query[128];
    new playerid_db = GetPlayerAccountID(playerid);

    format(query, sizeof(query),
        "SELECT gfx_water, gfx_reflections, gfx_distance, gfx_sky, gfx_aa, gfx_lower_dd, gfx_lower_cars FROM players WHERE id = '%d'",
        playerid_db
    );

    mysql_query(mysql, query, false);
    if(cache_num_rows() > 0)
    {
        SetPVarInt(playerid, "gfx_water", cache_get_field_content_int(0, "gfx_water"));
        SetPVarInt(playerid, "gfx_reflections", cache_get_field_content_int(0, "gfx_reflections"));
        SetPVarInt(playerid, "gfx_distance", cache_get_field_content_int(0, "gfx_distance"));
        SetPVarInt(playerid, "gfx_sky", cache_get_field_content_int(0, "gfx_sky"));
        SetPVarInt(playerid, "gfx_aa", cache_get_field_content_int(0, "gfx_aa"));
        SetPVarInt(playerid, "gfx_lower_dd", cache_get_field_content_int(0, "gfx_lower_dd"));
        SetPVarInt(playerid, "gfx_lower_cars", cache_get_field_content_int(0, "gfx_lower_cars"));
    }
    else
    {
        SetPVarInt(playerid, "gfx_water", 2);
        SetPVarInt(playerid, "gfx_reflections", 2);
        SetPVarInt(playerid, "gfx_distance", 75);
        SetPVarInt(playerid, "gfx_sky", 1);
        SetPVarInt(playerid, "gfx_aa", 1);
        SetPVarInt(playerid, "gfx_lower_dd", 0);
        SetPVarInt(playerid, "gfx_lower_cars", 0);
    }

    if(GetPVarInt(playerid, "gfx_sky") == 1)
    {
        SetPlayerWeather(playerid, 10);
    }
}


CMD:zdrift(playerid)
{
   new vehicleid = GetPlayerVehicleID(playerid);
   SetVehicleDriftForPlayerrrrr(playerid, vehicleid, 1);
}

stock SetVehicleDrifttt(vehicleid, bool:enable) // АВТОР ДАННЫХ РПС ВСЕХ И ТАКЖЕ АВТОР СЛИВА DEATHCODER @deathcoder_twink
{
    if (!IsValidVehicle(vehicleid))
        return 0;

    vInfo[vehicleid][vDrift] = enable; 

    foreach(new playerid : Player)
    {
        SetVehicleDriftForPlayerrrrr(playerid, vehicleid, enable);
    }
    return 1;
}

stock SetVehicleDriftForPlayerrrrr(playerid, vehicleid, bool:enable) // АВТОР ДАННЫХ РПС ВСЕХ И ТАКЖЕ АВТОР СЛИВА DEATHCODER @deathcoder_twink
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT8, 5); 
    BS_WriteValue(bs, PR_UINT16, vehicleid); 
    BS_WriteValue(bs, PR_UINT8, enable); 

    PR_SendRPC(bs, playerid, 168, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

new g_NewGuiOpened[MAX_PLAYERS] = {-1, ...};

stock NewGUI_OnPlayerConnect(playerid)
{
    g_NewGuiOpened[playerid] = -1;
    return 1;
}

stock NewGUI_OnPlayerDisconnect(playerid)
{
    g_NewGuiOpened[playerid] = -1;
    return 1;
}

stock NewGUI_Close(playerid, guiid)
{
    if(guiid < 0 || guiid > 65535) return 0;

    new Node:closePacket = JSON_Object(
        "c", JSON_Int(1),
        "t", JSON_Int(guiid)
    );
    OnPacketIncoming(playerid, guiid, closePacket);
    JSON_Cleanup(closePacket);
    return 1;
}


stock NewGUI_Open(playerid, guiid)
{
    if(guiid < 0 || guiid > 65535) return 0;

    if(g_NewGuiOpened[playerid] != -1 && g_NewGuiOpened[playerid] != guiid)
    {
        NewGUI_Close(playerid, g_NewGuiOpened[playerid]);
    }

    // Reopen from a clean state to avoid text stacking over character/vehicle previews.
    NewGUI_Close(playerid, guiid);

    new Node:openPacket = JSON_Object(
        "o", JSON_Int(1)
    );
    OnPacketIncoming(playerid, guiid, openPacket);
    JSON_Cleanup(openPacket);

    g_NewGuiOpened[playerid] = guiid;
    return 1;
}

CMD:gui(playerid, params[])
{
    new guiid;
    if(sscanf(params, "i", guiid))
        return ShowNotificationNew(playerid, 2, 5, 0, 0, "Используйте: /gui [id gui]", ""), 1;

    if(guiid < 0 || guiid > 65535)
        return ShowNotificationNew(playerid, 2, 5, 0, 0, "ид гуйца должен быть от 0 до 65535", ""), 1;

    NewGUI_Open(playerid, guiid);

    new message[64];
    format(message, sizeof(message), "гуйцо %d открыт", guiid);
    ShowNotificationNew(playerid, 1, 5, 0, 0, message, "");
    return 1;
}

stock ShowRentBikeMenu(playerid, park_id)
{
	if(!(0 <= park_id < sizeof(rent_bike)))
		park_id = 0;

	SetPVarInt(playerid, "autopark_pickup_id", park_id);

	Dialog
	(
		playerid, DIALOG_RENT_BIKE, DIALOG_STYLE_TABLIST_HEADERS,
		"{E26B6B}Автовокзал {FFFFFF}| Транспорт",
		"{FF8A8A}номер\t{FF8A8A}доступное действие\t{FF8A8A}стоимость\n"\
		"{FFFFFF}#1\tАрендовать мопед\t1500 рублей\n"\
		"{FFFFFF}#2\tВызвать личный транспорт\t3000 рублей",
		"Выбрать", "Отмена"
	);
	return 1;
}

stock TryOpenRentBikeMenu(playerid)
{
	new pickupid = GetPlayerData(playerid, P_LAST_PICKUP);
	if(pickupid == -1 || !IsPickupExists(pickupid))
		return 0;

	if(GetPickupInfo(pickupid, P_ACTION_TYPE) != PICKUP_ACTION_RENT_BIKE)
		return 0;

	if(!IsPlayerInRangeOfPoint(playerid, 1.7, GetPickupInfo(pickupid, P_POS_X), GetPickupInfo(pickupid, P_POS_Y), GetPickupInfo(pickupid, P_POS_Z)))
		return 0;

	ShowRentBikeMenu(playerid, GetPickupInfo(pickupid, P_ACTION_ID));
	return 1;
}

stock TryOpenRentBikeNotifyMenu(playerid)
{
	if(GetPVarType(playerid, "rent_moped_notify_pickup") == PLAYER_VARTYPE_NONE)
		return TryOpenRentBikeMenu(playerid);

	if(GetPVarType(playerid, "rent_moped_notify_tick") != PLAYER_VARTYPE_NONE && GetTickCount() > GetPVarInt(playerid, "rent_moped_notify_tick"))
		return 0;

	new pickupid = GetPVarInt(playerid, "rent_moped_notify_pickup");
	if(pickupid == -1 || !IsPickupExists(pickupid))
		return 0;

	if(GetPickupInfo(pickupid, P_ACTION_TYPE) != PICKUP_ACTION_RENT_BIKE)
		return 0;

	if(!IsPlayerInRangeOfPoint(playerid, 2.5, GetPickupInfo(pickupid, P_POS_X), GetPickupInfo(pickupid, P_POS_Y), GetPickupInfo(pickupid, P_POS_Z)))
		return 0;

	ShowRentBikeMenu(playerid, GetPickupInfo(pickupid, P_ACTION_ID));
	return 1;
}

stock GRadialSaveSuspUnlock(vehicleid, suspension_type, enabled)
{
    new idx = GRadial_GetOwnableSqlByVeh(vehicleid);
    if(idx <= 0) return 0;

    new column[24];
    column[0] = EOS;

    if(suspension_type == GORDEEV_RADIAL_OP_HYDRAULICS)
    {
        format(column, sizeof column, "has_hydraulics");
    }
    else if(suspension_type >= GORDEEV_RADIAL_OP_PNEUMO_1 && suspension_type <= GORDEEV_RADIAL_OP_PNEUMO_3)
    {
        format(column, sizeof column, "has_pneumo");
    }

    if(!strlen(column)) return 0;

    enabled = (enabled > 0) ? 1 : 0;

    new query[256];
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ownable_cars_radial (oc_id, %s) VALUES (%d, %d) ON DUPLICATE KEY UPDATE %s=VALUES(%s)",
        column,
        idx,
        enabled,
        column,
        column
    );
    mysql_query(mysql, query, false);
    return 1;
}

stock GRadial_GetOwnableSqlByVeh(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID) return 0;
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR) return 0;

    new own_index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(own_index == -1) return 0;

    return GetOwnableCarData(own_index, OC_SQL_ID);
}

