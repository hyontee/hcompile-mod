        if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            return ShowNotificationNew(playerid, 2, 5, -1, -1, "Игрок больше не на сервере.", "");

        new reason[66];
        format(reason, sizeof(reason), "%s", inputtext);
        if(!strlen(reason)) reason = "Не указана";

        // Вызов команды warn
        new params[128];
        format(params, sizeof(params), "%d %s", target_id, reason);
        callcmd::warn(playerid, params);

        return 1;
    }

    if(dialogid == 5001) // МУТ -> Своя причина
