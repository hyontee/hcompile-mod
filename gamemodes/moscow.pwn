		case 2: { SetPlayerData(playerid, P_QUEST_EXP_2, value); UpdatePlayerDatabaseInt(playerid, "quest_exp_2", value); }
		case 3: { SetPlayerData(playerid, P_QUEST_EXP_3, value); UpdatePlayerDatabaseInt(playerid, "quest_exp_3", value); }
