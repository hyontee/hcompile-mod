									strmid(CheckPass[playerid], inputtext, 0, strlen(inputtext), 65);

									//pformat(g_player[playerid][P_PASSWORD], 16, "%s", inputtext);
								}
							}
							else reg_step --;
						}
						case REGISTER_STATE_REFER: 		// ввод ника пригласившего игрока
