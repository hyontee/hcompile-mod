                new park_id = GetPVarInt(playerid, "autopark_pickup_id");
                if(!(0 <= park_id < sizeof(rent_bike)))
                    park_id = 0;

                if(GetPlayerMoneyEx(playerid) < 3000)
                    return ShowNotification(playerid, 2, "Недостаточно средств для вызова!", 4, "", "");

                new vehicleid = GetOwnableCarBySqlID(ownable_sql_id);

                if(vehicleid == INVALID_VEHICLE_ID)
                {
                    if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
                    {
                        SaveOwnableCar(GetPlayerOwnableCar(playerid));
                        UnloadPlayerOwnableCar(playerid);
                    }

                    if(LoadOwnableCar(ownable_sql_id) == -1)
                        return SendClientMessage(playerid, 0x999999FF, "Ошибка загрузки личного транспорта");

                    PlayerOwnableCarInit(playerid);
                    LoadTun(playerid);

                    vehicleid = GetOwnableCarBySqlID(ownable_sql_id);
                    if(vehicleid == INVALID_VEHICLE_ID)
                        return SendClientMessage(playerid, 0x999999FF, "Не удалось вызвать транспорт");
                }
                else
                {
                    SetPlayerData(playerid, P_OWNABLE_CAR, vehicleid);
                }

                if(IsVehicleOccupied(vehicleid) && GetPlayerVehicleID(playerid) != vehicleid)
                    return SendClientMessage(playerid, 0x999999FF, "Этот транспорт сейчас занят");

                new spawn_id = autopark_spawn_index[park_id]++;
                if(spawn_id >= autopark_spawn_count[park_id])
                {
                    spawn_id = 0;
                    autopark_spawn_index[park_id] = 1;
                }

                new Float:pos_x = autopark_spawn_pos[park_id][spawn_id][0];
                new Float:pos_y = autopark_spawn_pos[park_id][spawn_id][1];
                new Float:pos_z = autopark_spawn_pos[park_id][spawn_id][2];
                new Float:angle = autopark_spawn_pos[park_id][spawn_id][3];

                SetVehiclePos(vehicleid, pos_x, pos_y, pos_z);
                SetVehicleZAngle(vehicleid, angle);
                LinkVehicleToInterior(vehicleid, 0);
                SetVehicleVirtualWorld(vehicleid, 0);

                new index = GetVehicleData(vehicleid, V_ACTION_ID);
                SetOwnableCarData(index, OC_POS_X, pos_x);
                SetOwnableCarData(index, OC_POS_Y, pos_y);
                SetOwnableCarData(index, OC_POS_Z, pos_z);
                SetOwnableCarData(index, OC_ANGLE, angle);
                SaveOwnableCar(vehicleid);

                GivePlayerMoneyEx(playerid, -1500, "Вызов личного транспорта", true, true);
                ShowNotification(playerid, 4, "Вы потратили -1.500 рублей.", 4, "", "");
                return 1;
            }
