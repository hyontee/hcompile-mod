stock ProxDetectorS(Float:radi, playerid, targetid, spec = 0)
{
	new Float:p[3];

	if(!IsPlayerConnected(playerid)) return false;

	if(!IsPlayerConnected(targetid)) return false;

	if(!spec)
	{
		if(GetPlayerState(playerid) == 9) return false;

		if(GetPlayerState(targetid) == 9) return false;
	}
	if(!GetPlayerPos(targetid, p[0], p[1], p[2])) return false;
	if(!IsPlayerInRangeOfPoint(playerid, radi, p[0], p[1], p[2])) return false;

	return true;
}

stock DMZ_SaveWeapons(playerid)
{
    for(new slot = 0; slot < 13; slot++)
    {
        new weaponid, ammo;
        GetPlayerWeaponData(playerid, slot, weaponid, ammo);
        g_DMZBackupWeaponID[playerid][slot] = weaponid;
        g_DMZBackupWeaponAmmo[playerid][slot] = ammo;
    }
    return 1;
}

stock DMZ_RestoreWeapons(playerid)
{
    ResetPlayerWeapons(playerid);

    for(new slot = 0; slot < 13; slot++)
    {
        if(g_DMZBackupWeaponID[playerid][slot] > 0 && g_DMZBackupWeaponAmmo[playerid][slot] > 0)
        {
            GivePlayerWeapon(playerid, g_DMZBackupWeaponID[playerid][slot], g_DMZBackupWeaponAmmo[playerid][slot]);
        }
        g_DMZBackupWeaponID[playerid][slot] = 0;
        g_DMZBackupWeaponAmmo[playerid][slot] = 0;
    }
    return 1;
}

stock DMZ_SendToPlayers(color, const message[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && GetPlayerData(i, P_DMZ_STATUS) == 1)
        {
            SendClientMessage(i, color, message);
        }
    }
    return 1;
}

stock DMZ_ShowExitDialog(playerid)
{
    if(GetPlayerData(playerid, P_DMZ_STATUS) != 1)
        return SendClientMessage(playerid, 0xCECECEFF, "Вы не находитесь в DM ZONE."), 1;

    Dialog(playerid, DIALOG_DMZ_EXIT_CONFIRM, DIALOG_STYLE_MSGBOX, "DM ZONE", "Вы уверены что хотите покинуть ДМ ЗОНУ?", "Покинуть", "Остаться");
    return 1;
}

stock DMZ_ExitPlayer(playerid)
{
    if(GetPlayerData(playerid, P_DMZ_STATUS) != 1)
        return 1;
        
    HideDMZTD(playerid);
    SetPlayerData(playerid, P_DMZ_STATUS, 0);
    SetPlayerData(playerid, P_DMZ_KILL1, 0);
    g_DMZKills[playerid] = 0;
    g_DMZRespawnPending[playerid] = false;
    g_DMZSpawnSlot[playerid] = -1;
    PlayerDMZArena[playerid] = 0; // <--- Сбрасываем арену
    
    DMZ_RestoreWeapons(playerid);
    RemovePlayerFromVehicle(playerid);
    SetPlayerPosEx(playerid, -33.8257, 618.0629, 12.1541, 0.0, 0, 0, false);
    SetPlayerHealth(playerid, 100.0);
    return 1;
}

stock DMZ_ApplySpawnState(playerid)
{
    new arena = PlayerDMZArena[playerid];
    if(arena == 1) SetPlayerInterior(playerid, DMZ_INTERIOR);
    else if(arena == 2) SetPlayerInterior(playerid, DMZ_INTERIOR_2);
    else SetPlayerInterior(playerid, 0);
    
    SetPlayerVirtualWorld(playerid, DMZ_WORLD);
    SetPlayerHealth(playerid, 100.0);
    SetPlayerArmour(playerid, 0.0);
    ResetPlayerWeapons(playerid);
    GivePlayerWeapon(playerid, 24, 500);
    ShowDMZTD(playerid);
    return 1;
}

stock SpawnDeathMatch(playerid)
{
    new arena = PlayerDMZArena[playerid];
    
    if(arena == 1) // Карта CS:GO
    {
        if(g_DMZSpawnSlot[playerid] < 0 || g_DMZSpawnSlot[playerid] >= sizeof(g_DMZSpawnData))
            g_DMZSpawnSlot[playerid] = random(sizeof(g_DMZSpawnData));

        SetPlayerPosEx
        (
            playerid,
            g_DMZSpawnData[g_DMZSpawnSlot[playerid]][0],
            g_DMZSpawnData[g_DMZSpawnSlot[playerid]][1],
            g_DMZSpawnData[g_DMZSpawnSlot[playerid]][2],
            g_DMZSpawnData[g_DMZSpawnSlot[playerid]][3],
            DMZ_INTERIOR, // Интерьер 1
            DMZ_WORLD,    // Виртуальный мир 1
            false
        );
    }
    else if(arena == 2) // Открытая местность
    {
        if(g_DMZSpawnSlot[playerid] < 0 || g_DMZSpawnSlot[playerid] >= sizeof(g_DMZSpawnData2))
            g_DMZSpawnSlot[playerid] = random(sizeof(g_DMZSpawnData2));

        SetPlayerPosEx
        (
            playerid,
            g_DMZSpawnData2[g_DMZSpawnSlot[playerid]][0],
            g_DMZSpawnData2[g_DMZSpawnSlot[playerid]][1],
            g_DMZSpawnData2[g_DMZSpawnSlot[playerid]][2],
            g_DMZSpawnData2[g_DMZSpawnSlot[playerid]][3],
            DMZ_INTERIOR_2, // Интерьер 0
            DMZ_WORLD,      // Виртуальный мир 1 (чтобы игроки видели друг друга)
            false
        );
    }
    
    DMZ_ApplySpawnState(playerid);
    return 1;
}

forward DMZ_RespawnPlayer(playerid);
public DMZ_RespawnPlayer(playerid)
{
    if(!g_DMZRespawnPending[playerid])
        return 0;
    g_DMZRespawnPending[playerid] = false;
    
    if(!IsPlayerConnected(playerid))
        return 0;
    
    if(!IsPlayerLogged(playerid))
        return 0;
    
    if(GetPlayerData(playerid, P_DMZ_STATUS) != 1)
        return 0;
    
    SetPlayerData(playerid, P_HOSPITAL, false);
    SetPlayerSpawnInit(playerid);
    ClearAnimations(playerid);
    
    // DMZ-респавн без hospital/wound GUI
    SpawnPlayer(playerid);
    SpawnDeathMatch(playerid);
    return 1;
}
stock DMZ_EnterPlayer(playerid)
{
    if(GetPlayerData(playerid, P_DMZ_STATUS) == 1)
        return SendClientMessage(playerid, 0xCECECEFF, "Вы уже находитесь в DM ZONE."), 1;

    DMZ_SaveWeapons(playerid);
    SetPlayerData(playerid, P_DMZ_STATUS, 1);
    SetPlayerData(playerid, P_DMZ_KILL1, 0);
    g_DMZKills[playerid] = 0;
    g_DMZRespawnPending[playerid] = false;
    g_DMZSpawnSlot[playerid] = -1;

    SetPlayerSpawnInit(playerid);
    RemovePlayerFromVehicle(playerid);
    SpawnPlayer(playerid);
    SpawnDeathMatch(playerid);

    SendClientMessage(playerid, 0x33CCFFFF, "[Информация] Все ваше оружие было отобрано, при выходе из дм зоны оно вам вернётся.");
    SendClientMessage(playerid, 0x33CCFFFF, "[Информация] Для выхода используйте /newdmzexit, для просмотра ТОПа - /newdmztop.");
    return 1;
}

CMD:dmzstart(playerid)
{
    if(GetPlayerData(playerid, P_DMZ_STATUS) == 1)
        return SendClientMessage(playerid, 0xCECECEFF, "Вы уже находитесь в DM ZONE."), 1;

    Dialog(playerid, DIALOG_DMZ_ARENA_SELECT, DIALOG_STYLE_LIST, "{FF5A5A}USUPOV RP {FFFFFF}| DM ZONE", "Карта CS:GO\nОткрытая местность", "Выбрать", "Отмена");
    return 1;
}

CMD:newdmzexit(playerid)
{
    return DMZ_ShowExitDialog(playerid);
}

CMD:dmzexit(playerid)
{
    return DMZ_ShowExitDialog(playerid);
}

stock ShowDMZTop(playerid)
{
    new fmt_text[80];
    format(fmt_text, sizeof fmt_text, "{FFFF00}У вас {FFFFFF}%d {FFFF00}киллов на DM ZONE.", GetPlayerData(playerid, P_DMZ_KILL));
    SendClientMessage(playerid, 0xFF5533FF, fmt_text);

    new string[256];
    format(string, 256, "SELECT * FROM `accounts` ORDER BY dmz_kills DESC LIMIT 5");
    mysql_tquery(mysql, string, "TopDMZKills", "d", playerid);
    return 1;
}

CMD:newdmztop(playerid)
{
    return ShowDMZTop(playerid);
}

CMD:dmztop(playerid)
{
    return ShowDMZTop(playerid);
}

