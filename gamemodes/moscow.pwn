stock SetQuestLineStatus(playerid, quest_id, value)
{
	switch(quest_id)
	{
		case 1: { SetPlayerData(playerid, P_QUEST_1, value); UpdatePlayerDatabaseInt(playerid, "quest_1", value); }
		case 2: { SetPlayerData(playerid, P_QUEST_2, value); UpdatePlayerDatabaseInt(playerid, "quest_2", value); }
		case 3: { SetPlayerData(playerid, P_QUEST_3, value); UpdatePlayerDatabaseInt(playerid, "quest_3", value); }
		case 4: { SetPlayerData(playerid, P_QUEST_4, value); UpdatePlayerDatabaseInt(playerid, "quest_4", value); }
		case 5: { SetPlayerData(playerid, P_QUEST_5, value); UpdatePlayerDatabaseInt(playerid, "quest_5", value); }
		case 6: { SetPlayerData(playerid, P_QUEST_6, value); UpdatePlayerDatabaseInt(playerid, "quest_6", value); }
		case 7: { SetPlayerData(playerid, P_QUEST_7, value); UpdatePlayerDatabaseInt(playerid, "quest_7", value); }
		case 8: { SetPlayerData(playerid, P_QUEST_8, value); UpdatePlayerDatabaseInt(playerid, "quest_8", value); }
	}
	return 1;
}

stock SetQuestLineProgress(playerid, quest_id, value)
{
