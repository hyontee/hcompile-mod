{
    SetPVarInt(playerid, "ownablecar_id", id);

    if(show_menu)
        SetPVarInt(playerid, "show_menu", 1);

    Dialog
    (
        playerid, DIALOG_OWNABLE_CAR_LOAD, DIALOG_STYLE_TABLIST_HEADERS,
        "{FF5A5A}USUPOVRP {FFFFFF}| Управление транспортом",
        "{FF8A8A}Номер\t{FF8A8A}Доступное действие\n\
        {FFFFFF}#1\tОтметить транспорт на GPS {FF6600}(300 руб)\n\
