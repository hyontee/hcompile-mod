stock CollectHarvest(playerid, zone_id)
{
    if(!g_FarmerWorkStarted[playerid]) return 0;
    if(g_FarmerJob[playerid] != FARMER_JOB_COMBINE) return 0;
    if(g_FarmerCurrentZone[playerid] != zone_id) return 0;
    if(g_FarmerDeliveryMode[playerid]) return 0;
    
    if(g_FarmerHarvestCount[playerid] >= COMBINE_CAPACITY)
    {
        SendClientMessage(playerid, 0xFF6600FF, "|{FFFFFF} Ваш комбайн полностью заполнен! Отвезите урожай на склад!");
        ShowDeliveryZone(playerid);
        return 1;
    }
    
    g_FarmerHarvestCount[playerid]++;
    
    if(g_FarmerSkill[playerid] < MAX_FARMER_SKILL)
        g_FarmerSkill[playerid]++;
    
    new fmt_text[128];
    format(fmt_text, sizeof(fmt_text), "|{FFFFFF} Вы собрали пшеницу! Вместимость: %d/%d", 
        g_FarmerHarvestCount[playerid], COMBINE_CAPACITY);
    SendClientMessage(playerid, 0x66CC33FF, fmt_text);
    
    GameTextForPlayer(playerid, "~g~~h~+ Собрал пшеницу!", 1500, 3);
    SetPlayerChatBubble(playerid, "+ Собрал пшеницу!", 0x66CC33FF, 10.0, 1500);
    
    if(g_FarmerHarvestCount[playerid] >= COMBINE_CAPACITY)
    {
        SendClientMessage(playerid, 0xFFFF00FF, "[Ферма] Комбайн заполнен! Отвезите урожай на склад!");
        ShowDeliveryZone(playerid);
    }
    else
    {
        ShowFarmerNextZone(playerid);
    }
    
    return 1;
}

stock ShowDeliveryZone(playerid)
{
    g_FarmerDeliveryMode[playerid] = true;
    g_FarmerCurrentZone[playerid] = -1;
    
    SetPlayerCheckpoint(
        playerid,
        g_FarmerDeliveryZone[0],
        g_FarmerDeliveryZone[1],
        g_FarmerDeliveryZone[2],
        5.0
    );
    
    SendClientMessage(playerid, 0xFFFF00FF, "|{FFFFFF} На карте отмечен пункт сдачи урожая. Отправляйтесь туда!");
    return 1;
}

stock DeliverHarvest(playerid)
{
    if(!g_FarmerWorkStarted[playerid]) return 0;
    if(!g_FarmerDeliveryMode[playerid]) return 0;
    
    if(g_FarmerHarvestCount[playerid] < COMBINE_CAPACITY)
    {
        SendClientMessage(playerid, 0xFF6600FF, "|{FFFFFF} Вы не собрали полный комбайн!");
        return 0;
    }
    
    new salary = COMBINE_SALARY + (g_FarmerSkill[playerid] * 10);
    GivePlayerMoneyEx(playerid, salary, "Сдача урожая на ферме", true, true);
    
    new fmt_text[128];
    format(fmt_text, sizeof(fmt_text), "Вы заработали %d рублей", 
        salary, g_FarmerSkill[playerid], MAX_FARMER_SKILL);
    ShowNotificationNew(playerid, 3, 5, -1, -1, fmt_text, "");
    
    GameTextForPlayer(playerid, "~g~~h~+ Урожай сдан!", 2000, 3);
    PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
    
    g_FarmerHarvestCount[playerid] = 0;
    g_FarmerDeliveryMode[playerid] = false;
    
    ShowFarmerNextZone(playerid);
    
    return 1;
}

stock ShowFarmerNextZone(playerid)
{
    if(!g_FarmerWorkStarted[playerid]) return 0;
    if(g_FarmerHarvestCount[playerid] >= COMBINE_CAPACITY)
    {
        ShowDeliveryZone(playerid);
        return 1;
    }
    
    new random_zone = random(sizeof(g_FarmerHarvestZones));
    
    new attempts = 0;
    while(attempts < 20)
    {
        new bool:zone_used = false;
        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(!IsPlayerConnected(i)) continue;
            if(!g_FarmerWorkStarted[i]) continue;
            if(g_FarmerCurrentZone[i] == random_zone && i != playerid)
            {
                zone_used = true;
                break;
            }
        }
        
        if(!zone_used) break;
        random_zone = random(sizeof(g_FarmerHarvestZones));
        attempts++;
    }
    
    g_FarmerCurrentZone[playerid] = random_zone;
    g_FarmerDeliveryMode[playerid] = false;
    
    SetPlayerCheckpoint(
        playerid,
        g_FarmerHarvestZones[random_zone][0],
        g_FarmerHarvestZones[random_zone][1],
        g_FarmerHarvestZones[random_zone][2],
        4.0
    );
    
    new fmt_text[128];
format(fmt_text, sizeof(fmt_text), "собрано: %d/%d", 
    g_FarmerHarvestCount[playerid], COMBINE_CAPACITY);
ShowNotificationNew(playerid, 3, 5, -1, -1, fmt_text, "");
    
    return 1;
}

// Начать/закончить работу
stock ToggleFarmerCombineJob(playerid)
{
    if(g_FarmerWorkStarted[playerid])
    {
        // ===== ЗАКОНЧИТЬ РАБОТУ =====
        if(g_FarmerCombineVehicle[playerid] != INVALID_VEHICLE_ID)
        {
            DestroyVehicle(g_FarmerCombineVehicle[playerid]);
            g_FarmerCombineVehicle[playerid] = INVALID_VEHICLE_ID;
        }
        
        // Возвращаем старый скин
        if(g_FarmerOldSkin[playerid] > 0)
        {
            SetPlayerSkin(playerid, g_FarmerOldSkin[playerid]);
            g_FarmerOldSkin[playerid] = 0;
        }
        
        g_FarmerWorkStarted[playerid] = false;
        g_FarmerJob[playerid] = FARMER_JOB_NONE;
        g_FarmerCurrentZone[playerid] = -1;
        g_FarmerHarvestCount[playerid] = 0;
        g_FarmerDeliveryMode[playerid] = false;
        
        DisablePlayerCheckpoint(playerid);
        ShowNotificationNew(playerid, 3, 5, -1, -1, "Вы успешно завершили работу на ферме!", "");
    }
    else
    {
        // ===== НАЧАТЬ РАБОТУ =====
        if(!DrivingSchoolPlayerHasCategory(playerid, DRIVING_SCHOOL_CATEGORY_B))
        {
            ShowNotificationNew(playerid, 2, 5, -1, -1, "Для работы на ферме необходима лицензия категории B!", "");
            return 0;
        }
        
        // Сохраняем старый скин
        g_FarmerOldSkin[playerid] = GetPlayerSkin(playerid);
        SetPlayerSkin(playerid, FARMER_WORK_SKIN);
        
        // ===== ВЫБИРАЕМ СЛУЧАЙНУЮ ТОЧКУ СПАВНА =====
        new spawn_index = random(FARMER_COMBINE_SPAWN_COUNT);
        
        // Создаем комбайн на случайных координатах
        new vehicleid = CreateVehicle(
            532, // Модель комбайна
            g_FarmerCombineSpawns[spawn_index][0],
            g_FarmerCombineSpawns[spawn_index][1],
            g_FarmerCombineSpawns[spawn_index][2],
            g_FarmerCombineSpawns[spawn_index][3],
            6, 6, // Цвета
            300   // Время респавна
        );
        
        if(vehicleid == INVALID_VEHICLE_ID)
        {
            ShowNotificationNew(playerid, 2, 5, -1, -1, "Ошибка создания комбайна! Попробуйте позже.", "");
            SetPlayerSkin(playerid, g_FarmerOldSkin[playerid]);
            g_FarmerOldSkin[playerid] = 0;
            return 0;
        }
        
        g_FarmerCombineVehicle[playerid] = vehicleid;
        g_FarmerJob[playerid] = FARMER_JOB_COMBINE;
        g_FarmerWorkStarted[playerid] = true;
        g_FarmerHarvestCount[playerid] = 0;
        g_FarmerDeliveryMode[playerid] = false;
        
        // Садим в комбайн
        PutPlayerInVehicle(playerid, vehicleid, 0);
        
        // Очищаем чат
        for(new i = 0; i < 20; i++)
            SendClientMessage(playerid, -1, "");
        
        ShowNotificationNew(playerid, 3, 5, -1, -1, "Вы успешно устроились на работу \"Водитель комбайна\".", "");
        ShowNotificationNew(playerid, 3, 5, -1, -1, "На игровой карте отмечены специальные зоны для работы, направляйтесь туда.", "");
        
        // Показываем первую зону
        ShowFarmerNextZone(playerid);
    }
    return 1;
}

stock CreateFarmerSystem()
{
    // Создаем НПС Дитюкович (скин 258)
    FarmerNPC = CreateActor(258, 1640.030273, 1297.462280, 12.098575, 325.950439);
    
    // Создаем 3D текст над НПС
    FarmerLabel = CreateDynamic3DTextLabel(
        "{008B8B}[NPC]\nДитюкович\n{FFFFFF}Подойдите для взаимодействия",
        0x008B8BFF,
        1640.030273, 1297.462280, 12.098575 + 1.5,
        10.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID,
        0, 0, -1, 50.0
    );
    
    // Создаем зону вокруг НПС для проверки приближения
    CreateDynamicSphere(1640.030273, 1297.462280, 12.098575, 3.0);
    
    // Создаем метки для зон сбора урожая
    for(new i = 0; i < sizeof(g_FarmerHarvestZones); i++)
    {
        CreateDynamicMapIcon(
            g_FarmerHarvestZones[i][0],
            g_FarmerHarvestZones[i][1],
            g_FarmerHarvestZones[i][2],
            53,
            0, 0, 0,
            -1,
            100.0,
            MAPICON_GLOBAL
        );
        
        new label_text[64];
        format(label_text, sizeof(label_text), "{00FF00}Поле #%d\n{FFFFFF}Соберите урожай!", i + 1);
        CreateDynamic3DTextLabel(
            label_text,
            0x00FF00FF,
            g_FarmerHarvestZones[i][0],
            g_FarmerHarvestZones[i][1],
            g_FarmerHarvestZones[i][2] + 2.0,
            10.0,
            INVALID_PLAYER_ID, INVALID_VEHICLE_ID,
            0, 0, -1, 50.0
        );
    }
    
    // Создаем метку для зоны сдачи
    CreateDynamicMapIcon(
        g_FarmerDeliveryZone[0],
        g_FarmerDeliveryZone[1],
        g_FarmerDeliveryZone[2],
        54,
        0, 0, 0,
        -1,
        100.0,
        MAPICON_GLOBAL
    );
    
    CreateDynamic3DTextLabel(
        "{FFFF00}Пункт сдачи урожая\n{FFFFFF}Привезите сюда пшеницу!",
        0xFFFF00FF,
        g_FarmerDeliveryZone[0],
        g_FarmerDeliveryZone[1],
        g_FarmerDeliveryZone[2] + 2.0,
        10.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID,
        0, 0, -1, 50.0
    );
    
    // Создаем метки для точек спавна комбайнов
    for(new i = 0; i < FARMER_COMBINE_SPAWN_COUNT; i++)
    {
        CreateDynamicMapIcon(
            g_FarmerCombineSpawns[i][0],
            g_FarmerCombineSpawns[i][1],
            g_FarmerCombineSpawns[i][2],
            53,
            0, 0, 0,
            -1,
            50.0,
            MAPICON_GLOBAL
        );
        
        new label_text[64];
        format(label_text, sizeof(label_text), "{FFFF00}Комбайн #%d\n{FFFFFF}Место выдачи", i + 1);
        CreateDynamic3DTextLabel(
            label_text,
            0xFFFF00FF,
            g_FarmerCombineSpawns[i][0],
            g_FarmerCombineSpawns[i][1],
            g_FarmerCombineSpawns[i][2] + 2.0,
            10.0,
            INVALID_PLAYER_ID, INVALID_VEHICLE_ID,
            0, 0, -1, 50.0
        );
    }
    
    printf("[FARMER] Система фермера загружена! Зон сбора: %d, Точки спавна комбайнов: %d", 
        sizeof(g_FarmerHarvestZones), FARMER_COMBINE_SPAWN_COUNT);
    return 1;
}

