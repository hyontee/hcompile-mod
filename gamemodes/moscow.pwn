CMD:tunecmds(playerid, params[])
{
	SendClientMessage(playerid, -1, "{1E90FF}[TUNE]: {FFFFFF}/numberplate /toner /clearance /separateclearance /wheelradius");
	SendClientMessage(playerid, -1, "{1E90FF}[TUNE]: {FFFFFF}/lightcolor /lighting /wheelalign /vinyl /speedoinfo /hornsound");
	SendClientMessage(playerid, -1, "{1E90FF}[TUNE]: {FFFFFF}/wheeldeparture /wheelwidth /vehcolor /stroboscope /chiptune");
	SendClientMessage(playerid, -1, "{1E90FF}[TUNE]: {FFFFFF}/hydraulics /highlight /setlaunchtype /exhaust /siren /enablesiren");
	return 1;
}

CMD:numberplate(playerid, params[])
{
	new veh = BT_GetTuneVehicle(playerid);
	if(veh == INVALID_VEHICLE_ID) return 1;

	new plate_type, number[16], region[8];
	if(sscanf(params, "is[16]s[8]", plate_type, number, region))
		return SendClientMessage(playerid, -1, "Использование: /numberplate [type] [number] [region]");

	BT_SetNumPlate(veh, plate_type, number, region);
	SendClientMessage(playerid, -1, "{66CC00}Номер применен");
	return 1;
}

CMD:toner(playerid, params[])
{
	new veh = BT_GetTuneVehicle(playerid);
	if(veh == INVALID_VEHICLE_ID) return 1;

	new front, rear, front_side, back_side;
	if(sscanf(params, "iiii", front, rear, front_side, back_side))
		return SendClientMessage(playerid, -1, "Использование: /toner [front] [rear] [front_side] [back_side]");

	BT_SetToner(veh, front, rear, front_side, back_side);
	SendClientMessage(playerid, -1, "{66CC00}Тонировка применена");
	return 1;
}

CMD:clearance(playerid, params[])
{
	new veh = BT_GetTuneVehicle(playerid);
	if(veh == INVALID_VEHICLE_ID) return 1;

	new value;
	if(sscanf(params, "i", value))
		return SendClientMessage(playerid, -1, "Использование: /clearance [value]");

	BT_SetClearance(veh, value);
	SendClientMessage(playerid, -1, "{66CC00}Клиренс применен");
	return 1;
}

