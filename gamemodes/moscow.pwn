						Dialog
						(
							playerid, DIALOG_BANK_ACCOUNT_CHANGE_NAME, DIALOG_STYLE_INPUT,
							"{FFCD00}Переименование счета",
							"{FFFFFF}Введите новое название для этого счета.\n"\
