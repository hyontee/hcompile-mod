	}
	return 0;
}

stock GetQuestLineGoal(quest_id)
{
	switch(quest_id)
	{
		case 1, 2, 3, 4, 7, 8, 10, 13, 15: return 1;
		case 5: return 2;
		case 6: return 10;
		case 9: return 10;
		case 11: return 7;
		case 12: return 10;
		case 14: return 5;
	}
	return 1;
}

