stock BT_SetHornFP(playerid, veh, horn_id)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 15);
	BS_WriteValue(bitstream, PR_UINT8, horn_id);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

stock BT_SetWheelDeparture(veh, front, rear)
{
	foreach(new i : Player)
	{
		BT_SetWheelDepartureFP(i, veh, front, rear);
	}
	return 1;
}

stock BT_SetWheelDepartureFP(playerid, veh, front, rear)
{
	new BitStream:bitstream = BS_New();
	new Float:change;
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 16);
	change = (front / 400.0) + -0.125;
	BS_WriteValue(bitstream, PR_FLOAT, change);
	change = (rear / 400.0) + -0.125;
	BS_WriteValue(bitstream, PR_FLOAT, change);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

stock BT_SetWheelWidth(veh, front, rear)
{
	foreach(new i : Player)
	{
		BT_SetWheelWidthFP(i, veh, front, rear);
	}
	return 1;
}

stock BT_SetWheelWidthFP(playerid, veh, front, rear)
{
	new BitStream:bitstream = BS_New();
	new Float:change;
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 17);
	change = (front / 80.0) + 0.5;
	BS_WriteValue(bitstream, PR_FLOAT, change);
	change = (rear / 80.0) + 0.5;
	BS_WriteValue(bitstream, PR_FLOAT, change);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

