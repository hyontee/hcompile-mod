stock BT_SetNeonColor(veh, center, right, left)
{
	foreach(new i : streamed_players_in_veh[veh])
	{
		BT_SetNeonColorFP(i, veh, BT_RGBAtoARGB(center), BT_RGBAtoARGB(right), BT_RGBAtoARGB(left));
	}
	return 1;
}

stock BT_SetNeonColorFP(playerid, veh, center, right, left)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 9);
	BS_WriteValue(bitstream, PR_UINT32, center);
	BS_WriteValue(bitstream, PR_UINT32, right);
	BS_WriteValue(bitstream, PR_UINT32, left);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

stock BT_SetWheelAlign(veh, front, rear)
{
	foreach(new i : streamed_players_in_veh[veh])
	{
		BT_SetWheelAlignFP(i, veh, front, rear);
	}
	return 1;
}

stock BT_SetWheelAlignFP(playerid, veh, front, rear)
{
	new BitStream:bitstream = BS_New();
	new Float:change;
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 10);
	change = front / -200.0;
	BS_WriteValue(bitstream, PR_FLOAT, change);
	change = rear / -200.0;
	BS_WriteValue(bitstream, PR_FLOAT, change);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

stock BT_SetSpeedoInfo(veh, Float:fuel = 0.0, Float:mileage = 0.0)
{
	foreach(new i : Player)
	{
		if(GetPlayerVehicleID(i) == veh && GetPlayerState(i) == PLAYER_STATE_DRIVER)
		{
			BT_SetSpeedoInfoFP(i, veh, fuel, mileage);
		}
	}
	return 1;
}

stock BT_SetSpeedoInfoFP(playerid, veh, Float:fuel = 0.0, Float:mileage = 0.0)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 14);
	BS_WriteValue(bitstream, PR_UINT32, fuel);
	BS_WriteValue(bitstream, PR_UINT32, mileage);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

