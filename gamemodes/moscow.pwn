            format(sile_title, sizeof(sile_title), "{FF8A8A}Владелец {FFFFFF}(Уровень 8)");
        }
        case 8: // Сокращенные команды (наказания)
        {
            if(admin_level < 3) return ShowNotification(playerid, 2, "Вам недоступен этот раздел! Нужен 3+ уровень", 4, "", "");
            
            format(helpadmcmd, sizeof(helpadmcmd),
                "{FF8A8A}Номер\t{FF8A8A}Команда\t{FF8A8A}Описание\n\
                {FFFFFF}1\t/sliv\tБлокировка за слив\n\
                2\t/cheat\tБлокировка за стороннее ПО\n\
                3\t/sk\tТюрьма за SpawnKill\n\
                4\t/caps\tМут за CapsLock\n\
