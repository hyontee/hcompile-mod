            format(sile_title, sizeof(sile_title), "{FF8A8A}Администратор {FFFFFF}(Уровень 3)");
        }
        case 3: // Куратор администрации (4 уровень)
        {
            if(admin_level < 4) return ShowNotification(playerid, 2, "Вам недоступен этот раздел! Нужен 4+ уровень", 4, "", "");
            
