stock SpawnAimBot1(index) {
    if(AimBotID1[index] != -1) DestroyActor(AimBotID1[index]);
    new skin = random(299) + 1; // Случайный скин от 1 до 299
    AimBotID1[index] = CreateActor(skin, AimBotCoords1[index][0], AimBotCoords1[index][1], AimBotCoords1[index][2], AimBotCoords1[index][3]);
    SetActorVirtualWorld(AimBotID1[index], floatround(AimBotCoords1[index][5]));
    
    // SetActorInterior не нужен! Интерьер определяется самими координатами X, Y, Z
    
    SetActorInvulnerable(AimBotID1[index], false); // Чтобы боты получали урон
    AimBotHP1[index] = 100.0;
}

stock SpawnAimBot2(index) {
    if(AimBotID2[index] != -1) DestroyActor(AimBotID2[index]);
    new skin = random(299) + 1;
    AimBotID2[index] = CreateActor(skin, AimBotCoords2[index][0], AimBotCoords2[index][1], AimBotCoords2[index][2], AimBotCoords2[index][3]);
    SetActorVirtualWorld(AimBotID2[index], floatround(AimBotCoords2[index][5]));
    
    // SetActorInterior не нужен! Интерьер определяется самими координатами X, Y, Z
    
    SetActorInvulnerable(AimBotID2[index], false);
    AimBotHP2[index] = 100.0;
}

stock InitAimBots() {
    for(new i = 0; i < sizeof(AimBotCoords1); i++) SpawnAimBot1(i);
    for(new i = 0; i < sizeof(AimBotCoords2); i++) SpawnAimBot2(i);
    print("[AimTraining] Боты успешно заспавнены.");
}

