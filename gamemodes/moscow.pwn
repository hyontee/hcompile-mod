CMD:dl(playerid)
{
    if(GetPlayerAdminEx(playerid) <= 0) return 0;
    
	new info[34], 
	Float:x,
	Float:y,
	Float:z, 
	count = GetVehiclePoolSize() + 1;
	
	if(!(DebugPlayer[playerid]))
	{
		SendClientMessage(playerid, -1, ""SC" Подождите, загружается инофрмация...");
		DebugPlayer[playerid] = true;

		for(new i = 1; i < count; i++)
		{
			GetVehiclePos(i, x, y, z);
			format(info, sizeof info, "VEH ID:%d \n MODEL ID:%d", i, GetVehicleModel(i));
			Veh_3DTEXT[playerid][i] =  CreateDynamic3DTextLabel(info, 0xFFFFFFFF, x, y, z + 1.0, 20.0, _, i, 0, -1, -1, playerid);
		}
	}
	else
	{	
		SendClientMessage(playerid, -1, ""USC" Вы выключили отображение информации о транспорте");
		DebugPlayer[playerid] = false;	
		for(new i = 1; i < count; i++)
		{
			DestroyDynamic3DTextLabel(Veh_3DTEXT[playerid][i]);
			Veh_3DTEXT[playerid][i] = Text3D:0;
		}

	}
	return 1;
}

stock YouTubeAuthorization(playerid)
{
    if(!GetPlayerData(playerid, P_YOUTUBE) || GetPlayerData(playerid, P_YT_LOGGED))
        return 0;
    
    // Проверяем наличие пароля в базе
    new query[128], Cache:result;
    mysql_format(mysql, query, sizeof query, "SELECT `yt_password` FROM `accounts` WHERE `id`=%d LIMIT 1", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        new db_password[32];
        cache_get_field_content(0, "yt_password", db_password, sizeof db_password);
        cache_delete(result);
        
        if(strlen(db_password) > 0)
        {
            // Пароль установлен - показываем окно входа
            Dialog(playerid, DIALOG_YT_LOGIN, DIALOG_STYLE_PASSWORD, 
                "{00FFFF}Ютуберская панель", 
                "{FFFFFF}Вы вошли как ютубер сервера\nВведите пароль от ютуберской панели в поле ниже", 
                "Войти", "Выход");
        }
        else
        {
            // Пароля нет - показываем окно регистрации
            Dialog(playerid, DIALOG_YT_REG, DIALOG_STYLE_PASSWORD, 
                "{00FFFF}Регистрация в ютуберской панели", 
                "{FFFFFF}Придумайте пароль из 4-х цифр для доступа к ютуберской панели\nВведите его в поле ниже:\n", 
                "Далее", "Выход");
        }
    }
    else
    {
        cache_delete(result);
        // На всякий случай показываем регистрацию
        Dialog(playerid, DIALOG_YT_REG, DIALOG_STYLE_PASSWORD, 
            "{00FFFF}Регистрация в ютуберской панели", 
            "{FFFFFF}Придумайте пароль из 4-х цифр для доступа к ютуберской панели\nВведите его в поле ниже:\n", 
            "Далее", "Выход");
    }
    return 1;
}

CMD:offsetyt(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Данная команда не доступна на ТЕСТ СЕРВЕРЕ!");
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    extract params -> new string:player_name[24]; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /offsetyt [ник игрока]");
    
    if(IsPlayerConnected(GetPlayerID(player_name)))
        return SendClientMessage(playerid, 0xCECECEFF, "Игрок с таким именем находится на сервере. Используйте /setyt [id]");
    
    // Ищем игрока в БД
    new query[256], Cache:result, rows, uid, youtube_status;
    mysql_format(mysql, query, sizeof query, "SELECT `id`, `youtube` FROM `accounts` WHERE `name`='%e' LIMIT 1", player_name);
    result = mysql_query(mysql, query, true);
    rows = cache_num_rows();
    
    if(rows)
    {
        uid = cache_get_field_content_int(0, "id");
        youtube_status = cache_get_field_content_int(0, "youtube");
        
        if(youtube_status)
        {
            cache_delete(result);
            return SendClientMessage(playerid, 0xCECECEFF, "У этого игрока уже есть ютуберская админка");
        }
        
        // Выдаем ютуберку
        mysql_format(mysql, query, sizeof query, 
            "UPDATE `accounts` SET `youtube`=1, `yt_password`='' WHERE `id`=%d LIMIT 1", uid);
        mysql_query(mysql, query, false);
        
        cache_delete(result);
        
        new fmt_text[128];
        format(fmt_text, sizeof fmt_text, "Вы выдали ютуберскую админку игроку %s [Офлайн]", player_name);
        SendClientMessage(playerid, 0x00FFFFFF, fmt_text);
        
        format(fmt_text, sizeof fmt_text, "[A] %s[%d] выдал игроку %s[acc:%d] ютуберскую админку [Офлайн]",
            GetPlayerNameEx(playerid), playerid, player_name, uid);
        SendMessageToAdmins(fmt_text, 0xFF5533FF);
        
        format(fmt_text, sizeof fmt_text, "Выдал офлайн %s[acc:%d] пост ютубера", player_name, uid);
        SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);
    }
    else
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0xCECECEFF, "Игрок с таким именем не найден");
    }
    
    return 1;
}

CMD:offdelyt(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Данная команда не доступна на ТЕСТ СЕРВЕРЕ!");
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    extract params -> new string:player_name[24]; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[Подсказка]:{FFFFFF} /offdelyt [ник игрока]");
    
    if(IsPlayerConnected(GetPlayerID(player_name)))
        return SendClientMessage(playerid, 0xCECECEFF, "Игрок с таким именем находится на сервере. Используйте /delyt [id]");
    
    // Ищем игрока в БД
    new query[256], Cache:result, rows, uid, youtube_status;
    mysql_format(mysql, query, sizeof query, "SELECT `id`, `youtube` FROM `accounts` WHERE `name`='%e' LIMIT 1", player_name);
    result = mysql_query(mysql, query, true);
    rows = cache_num_rows();
    
    if(rows)
    {
        uid = cache_get_field_content_int(0, "id");
        youtube_status = cache_get_field_content_int(0, "youtube");
        
        if(!youtube_status)
        {
            cache_delete(result);
            return SendClientMessage(playerid, 0xCECECEFF, "У этого игрока нет ютуберской админки");
        }
        
        // Снимаем ютуберку
        mysql_format(mysql, query, sizeof query, 
            "UPDATE `accounts` SET `youtube`=0, `yt_password`='' WHERE `id`=%d LIMIT 1", uid);
        mysql_query(mysql, query, false);
        
        cache_delete(result);
        
        new fmt_text[128];
        format(fmt_text, sizeof fmt_text, "Вы забрали ютуберскую админку у игрока %s [Офлайн]", player_name);
        SendClientMessage(playerid, 0x00FFFFFF, fmt_text);
        
        format(fmt_text, sizeof fmt_text, "[A] %s[%d] забрал у игрока %s[acc:%d] ютуберскую админку [Офлайн]",
            GetPlayerNameEx(playerid), playerid, player_name, uid);
        SendMessageToAdmins(fmt_text, 0xFF5533FF);
        
        format(fmt_text, sizeof fmt_text, "Забрал офлайн %s[acc:%d] пост ютубера", player_name, uid);
        SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);
    }
    else
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0xCECECEFF, "Игрок с таким именем не найден");
    }
    
    return 1;
}

