stock DrivingSchoolResetGuiState(playerid)
{
	g_player_driving_school_gui[playerid][DS_SELECTED_CATEGORY] = -1;
	g_player_driving_school_gui[playerid][DS_TEST_ACTIVE] = false;
	g_player_driving_school_gui[playerid][DS_CURRENT_QUESTION] = 0;
	g_player_driving_school_gui[playerid][DS_CORRECT_ANSWERS] = 0;
	g_player_driving_school_gui[playerid][DS_PAID_CATEGORY] = false;
	return 1;
}

stock DrivingSchoolGetCategoryFlag(category)
{
	switch(category)
	{
		case DRIVING_SCHOOL_CATEGORY_A: return DRIVING_LIC_FLAG_A;
		case DRIVING_SCHOOL_CATEGORY_B: return DRIVING_LIC_FLAG_B;
		case DRIVING_SCHOOL_CATEGORY_C: return DRIVING_LIC_FLAG_C;
		case DRIVING_SCHOOL_CATEGORY_D: return DRIVING_LIC_FLAG_D;
		case DRIVING_SCHOOL_CATEGORY_SHIP: return DRIVING_LIC_FLAG_SHIP;
	}
	return 0;
}

stock DrivingSchoolGetCategoryName(category, output[], size)
{
	static const category_names[5][5] =
	{
		"A",
		"B",
		"C",
		"D",
		"Ship"
	};
	if(category >= 0 && category < sizeof category_names)
	{
		format(output, size, "%s", category_names[category]);
	}
	else
	{
		format(output, size, "Unknown");
	}
	return 1;
}

stock DrivingSchoolNormalizeLicenseValue(value)
{
	if(value <= 0) return 0;
	if(value & (DRIVING_LIC_FLAG_A | DRIVING_LIC_FLAG_B | DRIVING_LIC_FLAG_C | DRIVING_LIC_FLAG_D | DRIVING_LIC_FLAG_SHIP))
	{
		return value;
	}

	switch(value)
	{
		case DRIVING_LIC_LEGACY_BASIC: return DRIVING_LIC_FLAG_B;
		case DRIVING_LIC_LEGACY_PROFESSIONAL, DRIVING_LIC_LEGACY_SPECIAL: return DRIVING_LIC_FLAGS_ALL;
	}
	return value;
}

stock bool:DrivingSchoolHasCategoryByValue(value, category)
{
	value = DrivingSchoolNormalizeLicenseValue(value);
	return (value & DrivingSchoolGetCategoryFlag(category)) != 0;
}

stock bool:DrivingSchoolPlayerHasCategory(playerid, category)
{
	return DrivingSchoolHasCategoryByValue(GetPlayerData(playerid, P_DRIVING_LIC), category);
}

stock bool:DrivingSchoolPlayerHasAnyCategory(playerid)
{
	new value = DrivingSchoolNormalizeLicenseValue(GetPlayerData(playerid, P_DRIVING_LIC));
	return (value & (DRIVING_LIC_FLAG_A | DRIVING_LIC_FLAG_B | DRIVING_LIC_FLAG_C | DRIVING_LIC_FLAG_D | DRIVING_LIC_FLAG_SHIP)) != 0;
}

stock bool:DrivingSchoolPlayerHasProfessionalLicense(playerid)
{
	new value = DrivingSchoolNormalizeLicenseValue(GetPlayerData(playerid, P_DRIVING_LIC));
	return (value & DRIVING_LIC_FLAGS_ALL) == DRIVING_LIC_FLAGS_ALL;
}

stock DrivingSchoolSetLicenseValue(playerid, value, bool:save = true)
{
	SetPlayerData(playerid, P_DRIVING_LIC, value);
	if(save)
	{
		UpdatePlayerDatabaseInt(playerid, "driving_lic", value);
	}
	return 1;
}

stock DrivingSchoolSetCategory(playerid, category, bool:enabled, bool:save = true)
{
	new value = DrivingSchoolNormalizeLicenseValue(GetPlayerData(playerid, P_DRIVING_LIC));
	new flag = DrivingSchoolGetCategoryFlag(category);
	if(!flag) return 0;

	if(enabled) value |= flag;
	else value &= ~flag;

	return DrivingSchoolSetLicenseValue(playerid, value, save);
}

stock DrivingSchoolGiveBasicLicense(playerid, bool:save = true)
{
	return DrivingSchoolSetCategory(playerid, DRIVING_SCHOOL_CATEGORY_B, true, save);
}

stock DrivingSchoolGiveProfessionalLicense(playerid, bool:save = true)
{
	return DrivingSchoolSetLicenseValue(playerid, DRIVING_LIC_FLAGS_ALL, save);
}

stock DrivingSchoolBuildCategoriesString(playerid, output[], size)
{
	output[0] = '\0';
	new category_name[8];

	for(new category; category <= DRIVING_SCHOOL_CATEGORY_D; category++)
	{
		if(!DrivingSchoolPlayerHasCategory(playerid, category))
		{
			continue;
		}

		if(output[0] != '\0')
		{
			strcat(output, ", ", size);
		}

		DrivingSchoolGetCategoryName(category, category_name, sizeof category_name);
		strcat(output, category_name, size);
	}

	if(!strlen(output))
	{
		format(output, size, "{FF9900}Отсутствуют");
	}
	else
	{
		new formatted[64];
		format(formatted, sizeof formatted, "{00CC33}%s", output);
		format(output, size, "%s", formatted);
	}
	return 1;
}

stock DrivingSchoolGetGuiCategoryStatus(playerid, category)
{
	if(DrivingSchoolPlayerHasCategory(playerid, category))
	{
		return 2;
	}

	if(category == DRIVING_SCHOOL_CATEGORY_SHIP)
	{
		return 0;
	}
	return 1;
}

stock DrivingSchoolGetPlayerTotalMoney(playerid)
{
	return GetPlayerMoneyEx(playerid) + GetPlayerBankMoney(playerid);
}

stock bool:DrivingSchoolTakeMoney(playerid, amount)
{
	if(amount <= 0)
	{
		return true;
	}

	new player_cash = GetPlayerMoneyEx(playerid);
	new player_bank = GetPlayerBankMoney(playerid);
	if((player_cash + player_bank) < amount)
	{
		return false;
	}

	new take_from_cash = min(player_cash, amount);
	new take_from_bank = amount - take_from_cash;

	if(take_from_cash > 0)
	{
		GivePlayerMoneyEx(playerid, -take_from_cash, "Автошкола GUI", true, true);
	}

	if(take_from_bank > 0)
	{
		AddPlayerData(playerid, P_BANK, -, take_from_bank);
		UpdatePlayerDatabaseInt(playerid, "bank", GetPlayerBankMoney(playerid));
	}

	return true;
}

stock DrivingSchoolFindCategoryByString(input[])
{
	if(!strcmp(input, "A", true)) return DRIVING_SCHOOL_CATEGORY_A;
	if(!strcmp(input, "B", true)) return DRIVING_SCHOOL_CATEGORY_B;
	if(!strcmp(input, "C", true)) return DRIVING_SCHOOL_CATEGORY_C;
	if(!strcmp(input, "D", true)) return DRIVING_SCHOOL_CATEGORY_D;
	if(!strcmp(input, "SHIP", true)) return DRIVING_SCHOOL_CATEGORY_SHIP;
	return -1;
}

stock DrivingSchoolSendQuestionPacket(playerid)
{
	new question_number = g_player_driving_school_gui[playerid][DS_CURRENT_QUESTION] + 1;
	new quest_id = question_number;

	new Node:json = JSON_Object();
	JSON_SetInt(json, "t", 3);
	JSON_SetInt(json, "s", DRIVING_SCHOOL_PACKET_UPDATE_QUEST);
	JSON_SetInt(json, "cq", question_number);
	JSON_SetInt(json, "a", g_player_driving_school_gui[playerid][DS_CORRECT_ANSWERS]);
	JSON_SetInt(json, "b", quest_id);
	OnPacketIncoming(playerid, GUIDrivingSchool, json);
	JSON_Cleanup(json);
	return 1;
}

stock DrivingSchoolFinishGuiTest(playerid, bool:passed)
{
	new correct_answers = g_player_driving_school_gui[playerid][DS_CORRECT_ANSWERS];
	new selected_category = g_player_driving_school_gui[playerid][DS_SELECTED_CATEGORY];

	if(passed && selected_category >= 0 && selected_category <= DRIVING_SCHOOL_CATEGORY_D)
	{
		DrivingSchoolSetCategory(playerid, selected_category, true);
	}

	new Node:json = JSON_Object();
	JSON_SetInt(json, "t", 3);
	JSON_SetInt(json, "s", DRIVING_SCHOOL_PACKET_TEST_RESULT);
	JSON_SetInt(json, "cq", DRIVING_SCHOOL_PACKET_TEST_RESULT);
	JSON_SetInt(json, "a", passed ? 1 : 0);
	JSON_SetInt(json, "b", correct_answers);
	OnPacketIncoming(playerid, GUIDrivingSchool, json);
	JSON_Cleanup(json);

	DrivingSchoolResetGuiState(playerid);
	return 1;
}

stock DrivingSchool_ShowMenu(playerid)
{
	new Node:json = JSON_Object();
	new Node:state_array = JSON_Array
	(
		JSON_Int(DrivingSchoolGetGuiCategoryStatus(playerid, DRIVING_SCHOOL_CATEGORY_A)),
		JSON_Int(DrivingSchoolGetGuiCategoryStatus(playerid, DRIVING_SCHOOL_CATEGORY_B)),
		JSON_Int(DrivingSchoolGetGuiCategoryStatus(playerid, DRIVING_SCHOOL_CATEGORY_C)),
		JSON_Int(DrivingSchoolGetGuiCategoryStatus(playerid, DRIVING_SCHOOL_CATEGORY_D)),
		JSON_Int(DrivingSchoolGetGuiCategoryStatus(playerid, DRIVING_SCHOOL_CATEGORY_SHIP))
	);
	new Node:price_array = JSON_Array
	(
		JSON_Int(g_driving_school_prices[DRIVING_SCHOOL_CATEGORY_A]),
		JSON_Int(g_driving_school_prices[DRIVING_SCHOOL_CATEGORY_B]),
		JSON_Int(g_driving_school_prices[DRIVING_SCHOOL_CATEGORY_C]),
		JSON_Int(g_driving_school_prices[DRIVING_SCHOOL_CATEGORY_D]),
		JSON_Int(g_driving_school_prices[DRIVING_SCHOOL_CATEGORY_SHIP])
	);
	new json_debug[256];

	JSON_SetArray(json, "a", state_array);
	JSON_SetArray(json, "p", price_array);
	JSON_SetInt(json, "o", 1);
	JSON_Stringify(json, json_debug, sizeof json_debug);
	printf("[DrivingSchool][Open] player=%d money=%d bank=%d json=%s", playerid, GetPlayerMoneyEx(playerid), GetPlayerBankMoney(playerid), json_debug);

	DrivingSchoolResetGuiState(playerid);
	ShowPlayerGUI(playerid, GUIDrivingSchool, json);
	JSON_Cleanup(json);
	return 1;
}

stock DrivingSchool_HandleGuiPacket(playerid, Node:json)
{
	new packet_type = -1;
	new json_debug[256];
	JSON_Stringify(json, json_debug, sizeof json_debug);
	printf("[DrivingSchool][Incoming] player=%d json=%s", playerid, json_debug);
	JSON_GetInt(json, "t", packet_type);
	if(packet_type == -1)
	{
		printf("[DrivingSchool][Incoming] player=%d packet without valid field t", playerid);
		return 1;
	}

	switch(packet_type)
	{
		case 0, 5:
		{
			DrivingSchoolResetGuiState(playerid);
		}
		case 1:
		{
			new category;
			JSON_GetInt(json, "s", category);
			new category_price = -1;
			if(category >= 0 && category < sizeof g_driving_school_prices)
			{
				category_price = g_driving_school_prices[category];
			}
			printf("[DrivingSchool][Select] player=%d category=%d money=%d bank=%d total=%d price=%d", playerid, category, GetPlayerMoneyEx(playerid), GetPlayerBankMoney(playerid), DrivingSchoolGetPlayerTotalMoney(playerid), category_price);

			new Node:response = JSON_Object();
			JSON_SetInt(response, "t", 1);

			if(category < DRIVING_SCHOOL_CATEGORY_A || category > DRIVING_SCHOOL_CATEGORY_D)
			{
				JSON_SetInt(response, "s", 0);
				OnPacketIncoming(playerid, GUIDrivingSchool, response);
				JSON_Cleanup(response);
				return 1;
			}

			if(DrivingSchoolPlayerHasCategory(playerid, category))
			{
				ShowNotification(playerid, 2, "У Вас уже есть эта категория", 4, "", "");
				JSON_SetInt(response, "s", 0);
				OnPacketIncoming(playerid, GUIDrivingSchool, response);
				JSON_Cleanup(response);
				return 1;
			}

			if(DrivingSchoolGetPlayerTotalMoney(playerid) < g_driving_school_prices[category])
			{
				new fmt_text[144], category_name[8];
				DrivingSchoolGetCategoryName(category, category_name, sizeof category_name);
				format(fmt_text, sizeof fmt_text, "Недостаточно средств. Категория %s стоит %d руб. Наличные: %d, банк: %d.", category_name, g_driving_school_prices[category], GetPlayerMoneyEx(playerid), GetPlayerBankMoney(playerid));
				ShowNotification(playerid, 2, fmt_text, 5, "", "");
				JSON_SetInt(response, "s", 0);
				OnPacketIncoming(playerid, GUIDrivingSchool, response);
				JSON_Cleanup(response);
				return 1;
			}

			DrivingSchoolTakeMoney(playerid, g_driving_school_prices[category]);
			g_player_driving_school_gui[playerid][DS_SELECTED_CATEGORY] = category;
			g_player_driving_school_gui[playerid][DS_PAID_CATEGORY] = true;
			g_player_driving_school_gui[playerid][DS_TEST_ACTIVE] = false;
			g_player_driving_school_gui[playerid][DS_CURRENT_QUESTION] = 0;
			g_player_driving_school_gui[playerid][DS_CORRECT_ANSWERS] = 0;

			JSON_SetInt(response, "s", 1);
			OnPacketIncoming(playerid, GUIDrivingSchool, response);
			JSON_Cleanup(response);
		}
		case 2:
		{
			new Node:response = JSON_Object();
			JSON_SetInt(response, "t", 2);

			if(g_player_driving_school_gui[playerid][DS_SELECTED_CATEGORY] < DRIVING_SCHOOL_CATEGORY_A ||
				g_player_driving_school_gui[playerid][DS_SELECTED_CATEGORY] > DRIVING_SCHOOL_CATEGORY_D ||
				!g_player_driving_school_gui[playerid][DS_PAID_CATEGORY])
			{
				JSON_SetInt(response, "s", 0);
				OnPacketIncoming(playerid, GUIDrivingSchool, response);
				JSON_Cleanup(response);
				return 1;
			}

			g_player_driving_school_gui[playerid][DS_TEST_ACTIVE] = true;
			g_player_driving_school_gui[playerid][DS_CURRENT_QUESTION] = 0;
			g_player_driving_school_gui[playerid][DS_CORRECT_ANSWERS] = 0;

			JSON_SetInt(response, "s", 1);
			JSON_SetInt(response, "q", sizeof driving_exam);
			OnPacketIncoming(playerid, GUIDrivingSchool, response);
			JSON_Cleanup(response);

			DrivingSchoolSendQuestionPacket(playerid);
		}
		case 3:
		{
			if(!g_player_driving_school_gui[playerid][DS_TEST_ACTIVE])
			{
				return 1;
			}

			new answer;
			JSON_GetInt(json, "cq", answer);

			new question_index = g_player_driving_school_gui[playerid][DS_CURRENT_QUESTION];
			if(question_index >= 0 && question_index < sizeof driving_exam)
			{
				if(driving_exam[question_index][DE_CORRECT_ANSWER] == (answer + 1))
				{
					g_player_driving_school_gui[playerid][DS_CORRECT_ANSWERS]++;
				}
			}

			g_player_driving_school_gui[playerid][DS_CURRENT_QUESTION]++;

			if(g_player_driving_school_gui[playerid][DS_CURRENT_QUESTION] >= sizeof driving_exam)
			{
				return DrivingSchoolFinishGuiTest(playerid, g_player_driving_school_gui[playerid][DS_CORRECT_ANSWERS] >= DRIVING_SCHOOL_TEST_MIN_CORRECT);
			}

			DrivingSchoolSendQuestionPacket(playerid);
		}
		case 4:
		{
			if(g_player_driving_school_gui[playerid][DS_TEST_ACTIVE])
			{
				return DrivingSchoolFinishGuiTest(playerid, false);
			}
		}
	}
	return 1;
}

stock DrivingSchoolInit()
{
	new buffer[5];

	driving_exam_CP = CreateDynamicCP(1644.4178,928.7159,1001.0000, 1.5, 1, 1, -1, 15.0); // автошкола


	for(new idx = buffer[0]; idx <= buffer[4]; idx ++)
		CreateDynamic3DTextLabel("Учебный", 0xFF0000FF, 0.0, 0.0, 1.2, 16.0, INVALID_PLAYER_ID, idx);

	new fmt_str[64];
	for(new idx; idx < sizeof driving_tutorial; idx ++)
	{
		format(fmt_str, sizeof fmt_str, "{CC9900}Раздел %d: ", idx + 1);
		strins(driving_tutorial[idx][DT_TITLE], fmt_str, 0, 64);
	}

	for(new idx; idx < sizeof driving_exam; idx ++)
	{
		strins(driving_exam[idx][DE_TITLE], "{00CC66}", 0, 64);
	}
}

