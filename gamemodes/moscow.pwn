                    new money = GetFamilyData(GetPlayerIdFamily(playerid), F_MONEY);

                    if(money >= put_sum)
                    {
                        format(fmt_str, sizeof fmt_str, "UPDATE accounts a,family f SET a.money=%d,f.money=f.money - %d WHERE a.id=%d AND f.id=%d", money-put_sum, put_sum, GetPlayerAccountID(playerid), GetPlayerIdFamily(playerid));
                        mysql_query(mysql, fmt_str, false);

