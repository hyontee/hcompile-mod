								UpdatePlayerDatabaseInt(playerid, "admin_warn", GetPlayerAdminWarn(playerid));

								format(fmt_text, sizeof fmt_text, "Вы сняли админ выговор. Текущее количество выговоров: %d", GetPlayerData(playerid, P_ADMIN_WARN));
