#include <custom/speedometr>

new bool: speedometr_menu [ MAX_PLAYERS ] ;
stock show_packet_speedometr ( playerid, _param1, _json_data [ ] )
{
	new Node: json = JSON_Object();
	JSON_Parse ( _json_data, json ) ;
	
	new _param2 ;
	JSON_GetInt ( json, "position", _param2 ) ;
	
	if ( _param1 == 0 )
	{
		if ( _param2 == 1 )
		{
			new _v_id = GetPlayerVehicleID ( playerid ), _v_turn = veh_info [ _v_id - 1 ] [ v_turn ],
				engine, lights, alarm, doors, bonnet, boot, objective ;
					
			GetVehicleParamsEx ( _v_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
			
			if ( speedometr_menu [ playerid ] ) speedometr_menu [ playerid ] = false ;
			else speedometr_menu [ playerid ] = true ;
			BarSpeedometr ( playerid, 1, ( engine ) ? ( true ) : ( false ), ( lights ) ? ( true ) : ( false ), ( doors ) ? ( true ) : ( false ), speedometr_menu [ playerid ] ) ;
			BarSpeedometr ( playerid, 0, ( _v_turn == 1 ) ? ( true ) : ( false ), ( _v_turn == 3 ) ? ( true ) : ( false ), ( _v_turn == 2 ) ? ( true ) : ( false ), speedometr_menu [ playerid ] ) ;
		}
	}
	else if ( _param1 == 2 )
	{
		new _v_id = GetPlayerVehicleID ( playerid ), engine, lights, alarm, doors, bonnet, boot, objective ;
		if ( _param2 == 1 ) toggle_engine ( playerid, _v_id ) ;
		else if ( _param2 == 2 ) toggle_lights ( playerid, _v_id ) ;
		else if ( _param2 == 3 ) toggle_locked ( playerid, _v_id ) ;
		
		GetVehicleParamsEx ( _v_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;	
		BarSpeedometr ( playerid, 1, ( engine ) ? ( true ) : ( false ), ( lights ) ? ( true ) : ( false ), ( doors ) ? ( true ) : ( false ), true ) ;
	}
	else if ( _param1 == 3 )
	{
		new _v_id = GetPlayerVehicleID ( playerid ), _v_turn = veh_info [ _v_id - 1 ] [ v_turn ] ;
		if ( _v_turn == 1 )
		{
			TurnSpeedometr ( playerid, _v_id, TURN_OFF ) ;
			veh_info [ _v_id - 1 ] [ v_turn ] = TURN_OFF ;
		}
		else if ( _v_turn == 2 )
		{
			TurnSpeedometr ( playerid, _v_id, TURN_OFF ) ;
			veh_info [ _v_id - 1 ] [ v_turn ] = TURN_OFF ;
		}
		else if ( _v_turn == 3 )
		{
			TurnSpeedometr ( playerid, _v_id, TURN_OFF ) ;
			veh_info [ _v_id - 1 ] [ v_turn ] = TURN_OFF ;
		}
		
		if ( _v_turn != _param2 )
		{
			if ( _param2 == 1 )
			{
				TurnSpeedometr ( playerid, _v_id, TURN_LEFT ) ;
				veh_info [ _v_id - 1 ] [ v_turn ] = _param2 ;
			}
			else if ( _param2 == 2 )
			{
				TurnSpeedometr ( playerid, _v_id, TURN_RIGHT ) ;
				veh_info [ _v_id - 1 ] [ v_turn ] = _param2 ;
			}
			else if ( _param2 == 3 )
			{
				TurnSpeedometr ( playerid, _v_id, TURN_ALL ) ;
				veh_info [ _v_id - 1 ] [ v_turn ] = _param2 ;
			}
		}
		_v_turn = veh_info [ _v_id - 1 ] [ v_turn ] ;
		BarSpeedometr ( playerid, 0, ( _v_turn == 1 ) ? ( true ) : ( false ), ( _v_turn == 3 ) ? ( true ) : ( false ), ( _v_turn == 2 ) ? ( true ) : ( false ), true ) ;
	}
	return 1 ;
}