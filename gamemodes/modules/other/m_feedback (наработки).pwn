			        break ;
			    }
			    return 1 ;
			}
		}

		if ( areaid >= radar_info [ 0 ] [ r_area ] && areaid <= radar_info [ radar_count - 1 ] [ r_area ] )
		{
			for ( new r = 0 ; r < radar_count ; r ++ )
			{
			    if ( ! IsPlayerInRangeOfPoint ( playerid, 30, radar_info [ r ] [ r_x ], radar_info [ r ] [ r_y ], radar_info [ r ] [ r_z ] ) ) continue ;
			    if ( p_info [ playerid ] [ hour_played ] < 3 ) break ;
			    if ( p_t_info [ playerid ] [ radar_time ] > gettime ( ) ) break ;

				new vehicle_id = GetPlayerVehicleID ( playerid ) ;
				if ( veh_info [ vehicle_id - 1 ] [ v_pantera_radar ] ) break ;
				if ( ( ! v_velo ( vehicle_id ) && ! v_plane ( vehicle_id ) && ! v_boat ( vehicle_id ) ) && GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
				{
					if ( GetVehicleSpeed ( vehicle_id ) > radar_info [ r ] [ r_speed ] )
					{
					    if ( GetVehicleSpeed ( vehicle_id ) - radar_info [ r ] [ r_speed ] > 20 )
					    {
							if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) )
							{
								p_t_info [ playerid ] [ radar_time ] = gettime ( ) + 30 ;

								new _ticket_error = floatround ( ( GetVehicleSpeed ( vehicle_id ) * radar_info [ r ] [ r_speed ] ) / 5 ) ;
								if ( p_info [ playerid ] [ family ] )
							    {
								   	new family_id = p_info [ playerid ] [ family ] ;
								   	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 5 ] )
								   	{
								   	    _ticket_error = floatround ( ( GetVehicleSpeed ( vehicle_id ) * radar_info [ r ] [ r_speed ] ) / 10 ) ;
								   	}
								}

								new scm_string [ 256 ] ;

								format(scm_string, 128, "* Разрешенная скорость %d км/ч, вы ехали %d км/ч. Наказание: штраф в размере %d$.", radar_info [ r ] [ r_speed ], GetVehicleSpeed ( vehicle_id ), _ticket_error ) ;
								SendClientMessage(playerid, col_blue, scm_string);

								mysql_format ( sql_connection, scm_string, sizeof ( scm_string ), "INSERT INTO `users_tickets` (`t_player`,`t_player_name`,`t_cop_name`,`t_reason`,`t_count`,`t_date`) VALUES ('%d','%s','Радар','Превышение скорости','%d',NOW())",
								p_info [ playerid ] [ id ], p_info [ playerid ] [ name ], _ticket_error ) ;
								mysql_tquery ( sql_connection, scm_string ) ;
								return 1 ;
							}
						}
						else
						{
	      					p_t_info [ playerid ] [ radar_time ] = gettime ( ) + 30 ;

							new scm_string [ 144 ] ;

							format(scm_string, sizeof scm_string, "* Разрешенная скорость %d км/ч, вы ехали %d км/ч. Наказание: устное предупреждение.", radar_info [ r ] [ r_speed ], GetVehicleSpeed ( vehicle_id ) );
							SendClientMessage(playerid, col_blue, scm_string);
