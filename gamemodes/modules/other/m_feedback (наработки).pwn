						else if ( b_info [ t ] [ b_radio_status ] == 2 )
						{
						    SendClientMessage ( playerid, col_gray, "* В этом бизнесе имеется аудио-система. Чтобы отключить аудио-систему используйте {"#cGN"}/bstop{"#cGR"}");
						    if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ), StopAudioStreamForPlayer ( playerid ) ;
						    PlayAudioStreamForPlayer ( playerid, b_info [ t ] [ b_radio_url ] ) ;
						}

						p_t_info [ playerid ] [ pickup_time ] = b_info [ t ] [ b_pickup ] ;
