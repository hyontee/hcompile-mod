				if ( b_info [ t - 1 ] [ b_owner_inc ] == -1 ) return SendClientMessage ( playerid,col_gray,"{"#cRInfo"}* {"#cGR"}У данной заправки нет владельца, она не работает." ) ;

			    new dialog_string [ 180 ] ;
			    format ( dialog_string, sizeof dialog_string, "{"#cWH"}Стоимость починки: {"#cGN"}%d${"#cWH"}.\n\n{"#cGR"}* Вы хотите починить транспортное средство?", b_price_market [ t - 1 ] [ 2 ] ) ;
				show_dialog ( playerid, d_filling_repair, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Заправочная станция", dialog_string, "Выбрать", "Закрыть" ) ;
