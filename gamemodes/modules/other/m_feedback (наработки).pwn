		    if ( conf_farm_time > 0 )
		    {
			    if ( fbi_player ( playerid ) )
			    {
			        if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) )return SendClientMessage ( playerid, col_gray,"{"#cRInfo"}* {"#cGR"}У Вас уже есть что-то в руках." ) ;

