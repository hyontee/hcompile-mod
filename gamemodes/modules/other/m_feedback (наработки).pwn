				        format ( global_string, 356, "{"#cGR"}Стоимость: {"#cWH"}%i{"#cGR"} "family_title"\nКласс: {"#cWH"}%s{"#cGR"}\nНомер дома: {"#cWH"}%d{"#cGR"}\nРайон: {"#cWH"}%s{"#cGR"}\n",
						h_info [ h ] [ h_price_ticket ], house_classes [ house_int [ hint ] [ hint_class ] ], h_info [ h ] [ h_id ], raion ) ;
				    }
				    else
					{
						format ( global_string, 356, "{"#cGR"}Стоимость: {"#cWH"}%i${"#cGR"}\nКласс: {"#cWH"}%s{"#cGR"}\nНомер дома: {"#cWH"}%d{"#cGR"}\nРайон: {"#cWH"}%s{"#cGR"}\n",
						h_info [ h ] [ h_price ] * for_tax [ 0 ], house_classes [ house_int [ hint ] [ hint_class ] ], h_info [ h ] [ h_id ], raion ) ;
					}
					if ( h_info [ h ] [ h_garage ] > 0 ) strcat ( global_string, "\n{"#cGR"}* В доме есть обустроенный гараж" ) ;
					if ( check_house_date ( h + 1 ) )
					{
						strcat ( global_string, "\n\n{"#cRD"}* Дом опечатан" ) ;
