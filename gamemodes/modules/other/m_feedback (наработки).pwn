			if(!isnull(get_station))
			{
				PlayStream(playerid, get_station, GetPVarFloat(i, "BBX"), GetPVarFloat(i, "BBY"), GetPVarFloat(i, "BBZ"), 30.0, 1);
				SendClientMessage(playerid, col_gray, "{"#cBInfo"}* {"#cGR"}Вы попали в игровую зону магнитофона.");
			}
			return 1;
		}
	}
	
// Также нужен будет отдельный массив для подсейва ID
// Например: str_id [ 1000 ] ; его можно не обнулять, т.к. будет перезапись
new str_massive [ 1000 ] [ 128 ] ;
CMD:test_str ( playerid )
{
    new line_string [ 100 ] ;
	for ( new i = 0 ; i < 10 ; i ++ )
	{
	    str_massive [ i ] [ 0 ] = EOS ;
	    format ( str_massive [ i ], 128, "asdqweasvascqweqszxc" ) ;
	}
	
	global_string [ 0 ] = EOS ;
	for ( new i = 0 ; i < 10 ; i ++ )
	{
	    format ( line_string, sizeof line_string, "%s\n", str_massive [ i ] ) ;
	    strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_LIST, "asdqwe", global_string, "asd", "asd" ) ;
	return 1 ;
}

CMD:test_str1 ( playerid )
{
	for ( new i = 0 ; i < 10 ; i ++ )
	{
	    str_massive [ i ] [ 0 ] = EOS ;
	    format ( str_massive [ i ], 128, "thqwetvxcdfsdfxcvx" ) ;
	}

	global_string [ 0 ] = EOS ;
	for ( new i = 0 ; i < 10 ; i ++ )
	{
	    new line_string [ 100 ] ;
