		    {
		        if ( ! IsPlayerInRangeOfPoint ( playerid, 2, market_seller_pickup [ i ] [ 0 ], market_seller_pickup [ i ] [ 1 ], market_seller_pickup [ i ] [ 2 ] ) ) continue ;
