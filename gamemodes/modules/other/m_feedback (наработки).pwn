						PlayerTextDrawSetString ( pl_id, family_ptd [ pl_id ] [ 4 ], scm_string ) ;

						format ( scm_string, sizeof scm_string, "%d", family_score [ family_defender [ family_id ] ] ) ;
						PlayerTextDrawSetString ( pl_id, family_ptd [ pl_id ] [ 3 ], scm_string ) ;

