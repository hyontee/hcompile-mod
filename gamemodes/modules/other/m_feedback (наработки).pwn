		 	{
			  	new family_id = p_info [ playerid ] [ family ] ;
			 	if ( family_info [ family_id - 1 ] [ fam_enhancement ] [ 7 ] ) _family_step = 1 ;
			}

			if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) && _family_step == 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRInfo"}* {"#cGR"}Кража доступна только для криминальных организаций." ) ;
			if ( steal_timer [ playerid ] != -1 ) return 1 ;
		  	for ( new i = 0 ; i < MAX_ARMY_MATS ; i ++ )
		    {
		        if ( areaid != army_mats_area [ i ] ) continue ;
		        steal_timer [ playerid ] = SetTimerEx ( "steal_mats", 1000, true, "iii", playerid, army_mats [ i ] [ army_id ], i ) ;
		        informer_td_status ( playerid, true ) ;
		        break ;
		    }
		    return 1 ;
		}
		if ( bus_station_count )
		{
			if ( areaid >= bus_station [ 0 ] [ b_area ] && areaid <= bus_station [ bus_station_count - 1 ] [ b_area ] )
			{
			    for ( new i = 0 ; i < bus_station_count ; i ++ )
			    {
			        if ( areaid != bus_station [ i ] [ b_area ] ) continue ;

					if ( bus_station [ i ] [ b_player ] < 0 ) bus_station [ i ] [ b_player ] = 0 ;
			        bus_station [ i ] [ b_player ] ++ ;

			        new station_string [ 300 ] ;
					format ( station_string, sizeof station_string, "** Автобусная остановка №%d **\n{"#cWH"}Ожидают перевозки: {"#cLY"}%d{"#cWH"} человек(а)\n{"#cWH"}Вознаграждение: {"#cGN"}%d${"#cWH"} за человека\n\n{"#cGR"}Есть игроки, которые нуждаются в перевозке. Водители могут\n{"#cGR"}взять себе пассажиров и получить вознаграждение.", bus_station [ i ] [ b_id ], bus_station [ i ] [ b_player ], bus_station [ i ] [ b_price ] ) ;
					UpdateDynamic3DTextLabelText ( bus_station [ i ] [ b_text ], col_blue, station_string ) ;

					new driver_player = 0 ;
					foreach(new veh_id: streamed_vehicles[playerid])
					{
					    if ( veh_info [ veh_id - 1 ] [ v_driver ] == INVALID_PLAYER_ID ) continue ;

					    driver_player ++ ;
					}
					if ( driver_player )
					{
						format ( station_string, sizeof station_string, "{"#cBInfo"}* {"#cGR"}В Вашем районе есть {"#cBL"}%d транспортн(ое)(ых) средств{"#cGR"} в движении.", driver_player ) ;
						SendClientMessage ( playerid, col_gray, station_string ) ;
