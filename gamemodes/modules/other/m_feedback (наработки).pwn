			}
		}

		foreach(new t: business_types[bizz_type_gas])
		{
		    if ( b_info [ t - 1 ] [ b_type ] != bizz_type_gas ) continue ;
		    if ( ! IsPlayerInRangeOfPoint ( playerid, 25.0, b_info [ t - 1 ] [ b_position ] [ 0 ], b_info [ t - 1 ] [ b_position ] [ 1 ], b_info [ t - 1 ] [ b_position ] [ 2 ])) continue;
			if ( areaid == b_info [ t - 1 ] [ b_area_gas ] )
			{
