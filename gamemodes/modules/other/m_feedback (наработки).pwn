			    {
			        new _family_id = family_attacker [ p_info [ playerid ] [ family ] ] ;
			        if ( family_wheels_pickup [ _family_id ] [ i ] == 0 ) break ;

			        new family_id = p_info [ playerid ] [ family ] ;
				    if ( family_attacker [ family_id ] == family_id )
					{
						family_score [ family_attacker [ family_id ] ] ++ ;

						p_info [ playerid ] [ family_kills ] ++ ;
						if ( p_info [ playerid ] [ family_status ] > 1 )
						{
						    new query_string [ 8 ] ;
							format ( query_string, 8, "%d", p_info [ playerid ] [ family_kills ] ) ;
							PlayerTextDrawSetString ( playerid, family_ptd [ playerid ] [ 5 ], query_string ) ;
