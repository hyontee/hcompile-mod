	    {
	        if ( areaid == post_area [ fraction_id - 1 ] [ i ] )
	        {
				new count_post = 0 ;
	            foreach(new p: fraction_players[fraction_id])
	            {
	                if ( p_t_info [ p ] [ player_post ] == i ) count_post ++ ;
	            }
	            if ( count_post >= post_player [ fraction_id - 1 ] [ i ] ) return SendClientMessage ( playerid, col_gray, "{"#cRInfo"}* {"#cGR"}На данном посту максимальное количество человек!" ) ;

	            if ( ! p_t_info [ playerid ] [ post_timer ] )
	            {
		            new scm_string [ 144 ] ;
		            if ( p_info [ playerid ] [ subleader ] ) format ( scm_string, sizeof scm_string, "[R] %s %s[%d] [%s] прибыл(а) на пост %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, unit_name [ fraction_id - 1 ] [ p_info [ playerid ] [ subleader ] - 1 ], post_name [ fraction_id - 1 ] [ i ] ) ;
					else format ( scm_string, sizeof scm_string, "[R] %s %s[%d] прибыл(а) на пост %s.", f_rank [ fraction_id - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, post_name [ fraction_id - 1 ] [ i ] ) ;
