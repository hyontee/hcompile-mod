					}

					p_t_info [ playerid ] [ player_station ] = bus_station [ i ] [ b_id ] ;
			        break ;
			    }
			    return 1 ;
			}
		}
		if ( areaid == farm_unload )
		{
		    if ( conf_farm_time > 0 )
		    {
			    if ( fbi_player ( playerid ) )
			    {
			        if ( IsPlayerAttachedObjectSlotUsed ( playerid, 0 ) )return SendClientMessage ( playerid, col_gray,"{"#cRInfo"}* {"#cGR"}У Вас уже есть что-то в руках." ) ;

			        if ( AmbarDrugs > 500 ) AmbarDrugs -= 500 ;

			        SetPVarInt ( playerid, "have_box", 1 ) ;
					SetPlayerAttachedObject ( playerid, 0, 3013,6,0.0,0.10,-0.2, -110.0,0.0,78.0 ) ;
