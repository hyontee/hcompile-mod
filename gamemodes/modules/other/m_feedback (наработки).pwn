			if ( areaid == b_info [ t - 1 ] [ b_area_gas ] )
			{
				if ( filling_count { playerid } != 0 ) return SendClientMessage(playerid,col_gray,"{"#cRInfo"}* {"#cGR"}Вы уже заправляете транспортное средство." ) ;

				if ( b_info [ t - 1 ] [ b_price ] == 0 ) return SendClientMessage ( playerid,col_gray,"{"#cRInfo"}* {"#cGR"}Цена за 1 литр не назначена владельцем заправки." ) ;
				if ( b_info [ t - 1 ] [ b_owner_inc ] == -1 ) return SendClientMessage ( playerid,col_gray,"{"#cRInfo"}* {"#cGR"}У данной заправки нет владельца, она не работает." ) ;

				SetPVarInt ( playerid, "f_biz", t - 1 ) ;
				show_dialog ( playerid, d_filling, DIALOG_STYLE_LIST, "{"#cBHD"}Заправочная станция", "{"#cBL"}1. {"#cWH"}Заправить транспорт\n{"#cBL"}2. {"#cWH"}Канистра", "Выбрать", "Закрыть" ) ;
				return 1 ;
			}
