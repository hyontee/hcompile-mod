		    if ( steal_timer [ playerid ] != -1 ) return 1 ;
		    if ( bank_robbery_time [ p_t_info [ playerid ] [ t_robbery ] ] < 2 ) return 1 ;
		    if ( GetPlayerVirtualWorld ( playerid ) != bank_world [ p_t_info [ playerid ] [ t_robbery ] ] ) return 1 ;

		    if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) SetPlayerAttachedObject ( playerid, 1, 1550, 1,   0.160001, -0.234000, -0.009998, 1.100002, 95.899940, -17.500007  ) ;

