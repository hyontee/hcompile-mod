					if(veh_info [ vehid - 1 ] [ v_drugs ] <= 0) return SendClientMessage ( playerid, col_gray, "{"#cRInfo"}* {"#cGR"}В вашей машине нету наркотиков.");
					AmbarDrugs += veh_info [ vehid - 1 ] [ v_drugs ];
					format(global_string, 128, "{"#cGInfo"}* {"#cWH"}Вы привезли {"#cGN"}%i{"#cWH"} грамм.", veh_info [ vehid - 1 ] [ v_drugs ]);
