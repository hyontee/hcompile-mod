                        format ( global_string, 1024, "{"#cGR"}Владелец: {"#cWH"}%s {"#cGR"}(%s{"#cGR"})\nКласс: {"#cWH"}%s{"#cGR"}\nНомер дома: {"#cWH"}%d{"#cGR"}\nРайон: {"#cWH"}%s{"#cGR"}\nАренда дома: {"#cWH"}%d${"#cGR"} в час\n{"#cGR"}* Для аренды дома используйте /renthome",
						h_info [ h ] [ h_owner_name ], status_online, house_classes [ house_int [ hint ] [ hint_class ] ], h_info [ h ] [ h_id ], raion, h_info [ h ] [ h_rent_price ] ) ;

						strcat(global_string, "\n\n{"#cBL"}** Установки: **{"#cGR"}\n\n");
						strcat(global_string, ( h_info [ h ] [ h_improve ] [ 0 ] ) ? ("Аудио система: {"#cWH"}Есть{"#cGR"}\n") : ("Аудио система: {"#cWH"}Нет{"#cGR"}\n"));
						strcat(global_string, ( h_info [ h ] [ h_improve ] [ 1 ] ) ? ("Автом. двери: {"#cWH"}Есть{"#cGR"}\n") : ("Автом. двери: {"#cWH"}Нет{"#cGR"}\n"));
						strcat(global_string, ( h_info [ h ] [ h_improve ] [ 2 ] ) ? ("Холодильник: {"#cWH"}Есть{"#cGR"}\n") : ("Холодильник: {"#cWH"}Нет{"#cGR"}\n"));
						strcat(global_string, ( h_info [ h ] [ h_improve ] [ 3 ] ) ? ("Гардероб: {"#cWH"}Есть{"#cGR"}\n") : ("Гардероб: {"#cWH"}Нет{"#cGR"}\n"));
						strcat(global_string, ( h_info [ h ] [ h_improve ] [ 4 ] ) ? ("Домашний сейф: {"#cWH"}Есть{"#cGR"}\n") : ("Домашний сейф: {"#cWH"}Нет{"#cGR"}\n"));
						strcat(global_string, ( h_info [ h ] [ h_improve ] [ 5 ] ) ? ("Спальные места: {"#cWH"}Есть{"#cGR"}\n") : ("Спальные места: {"#cWH"}Нет{"#cGR"}\n"));
						strcat(global_string, ( h_info [ h ] [ h_improve ] [ 6 ] ) ? ("Субсидии: {"#cWH"}Есть{"#cGR"}\n") : ("Субсидии: {"#cWH"}Нет{"#cGR"}\n"));
						strcat(global_string, ( h_info [ h ] [ h_improve ] [ 7 ] ) ? ("Наличие подвала: {"#cWH"}Есть{"#cGR"}\n") : ("Наличие подвала: {"#cWH"}Нет{"#cGR"}\n"));

						if ( h_info [ h ] [ h_garage ] > 0 ) strcat ( global_string, "\n\n{"#cGR"}* В доме есть обустроенный гараж" ) ;
						show_dialog ( playerid, d_house, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Недвижимость занята", global_string, "Войти", "Отмена" ) ;
						SetPVarInt ( playerid, "house_dialog", 2 ) ;
					}
				}
				SetPVarInt ( playerid, "house_id", h + 1 ) ;
				SetPVarInt ( playerid, "tp_area_used", 1 ) ;
				break;
			}
		}

		if ( areaid >= b_info [ 0 ] [ b_area ] && areaid <= b_info [ b_count - 1 ] [ b_area ] )
		{
		    if ( p_info [ playerid ] [ optimization_settings ] [ 1 ] ) return 1 ;
			for ( new t = 0 ; t < b_count ; t ++ )
			{
				if ( b_info [ t ] [ b_area ] == areaid )
				{
     				new dialog_string [ 230 + MAX_PLAYER_NAME + 7 + 32 + 1 ], line_string [ 128 ] ;

					new business_status [ 19 + 1 ] = "{"#cRD"}Закрыт" ;
					if ( ! b_info [ t ] [ b_close ] ) business_status = "{"#cGN"}Открыт" ;
					if ( b_info [ t ] [ b_owner_inc ] == -1)
					{
						format ( dialog_string, sizeof ( dialog_string ), "{"#cBL"}Бизнес продаётся:\n\n{"#cGR"}Название:{"#cWH"} %s\n{"#cGR"}Контроль:{"#cWH"} %s\n{"#cGR"}Цена:{"#cWH"} %d$\n{"#cGR"}Состояние: %s",
						b_info [ t ] [ b_name ], f_info [ b_info [ t ] [ b_mafia ] - 1 ] [ f_name ], b_info [ t ] [ b_price ] * for_tax [ 1 ], business_status ) ;
						if ( check_business_date ( t + 1 ) )
						{
							strcat ( dialog_string, "\n\n{"#cRD"}* Бизнес опечатан" ) ;
							format ( line_string, sizeof line_string, "\n{"#cRD"}* Станет доступен %s", get_business_date ( t + 1 ) ) ;
							strcat ( dialog_string, line_string ) ;
						}
						show_dialog ( playerid, d_b_buy, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация о бизнесе", dialog_string, "Купить", "Закрыть" ) ;
					}
					else
					{
						new bis_int = b_info [ t ] [ b_int ] ;
						if ( bis_int == -1 ) return SendClientMessage ( playerid, col_gray,"{"#cRInfo"}* {"#cGR"}Произошла ошибка при входе в бизнес!" ) ;
						if ( b_info [ t ] [ b_close ] == 1 ||  b_info [ t ] [ b_owner_inc ] == -1 ) return GameTextForPlayer ( playerid, "~r~BUSINESS CLOSED", 2000, 4 ) ;

						if ( b_info [ t ] [ b_type ] == bizz_type_casino )
						{
						    if ( p_info [ playerid ] [ hour_played ] < 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGR"}Для входа в казино нужно отыграть 3 часа.");
						}

						if ( b_info [ t ] [ b_fee ] > 0 )
						{
							format ( dialog_string, sizeof ( dialog_string ), "{"#cWH"}Вы действитель желаете войти в %s?\n\n{"#cGR"}* Стоимость входа составляет {"#cBL"}%d$", b_info [ t ] [ b_name ], b_info [ t ] [ b_fee ] ) ;
							show_dialog ( playerid, d_b_fee_enter, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Вход в бизнес", dialog_string, "Войти", "Отмена" ) ;
							SetPVarInt ( playerid, "p_biz_id", t + 1 ) ;
							return 1 ;
						}

						set_pos ( playerid, b_interior [ bis_int ] [ i_position ] [ 0 ] , b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ], b_interior [ bis_int ] [ i_position ] [ 3 ], b_interior [ bis_int ] [ i_interior ], b_info [ t ] [ b_id ] + 1000 ) ;
						SetPVarInt ( playerid, "tp_area_used", 1 ) ;
