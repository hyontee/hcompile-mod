#include 									<custom/shop_inc>

new player_shop_manager [ MAX_PLAYERS char ] ;
stock use_shop_manager ( playerid, _id, _id2, _id3, _id4 )
{
	if ( _id4 == 1 )
	{
		if ( _id == 255 && _id2 == 255 )
		{
			SetShopHide ( playerid, 1 ) ;
			
			player_shop_manager { playerid } = 0 ;
			toggle_controlable ( playerid, true ) ;
			SetCameraBehindPlayer ( playerid ) ;

			TogglePlayerHudElement ( playerid, HUD_ELEMENT_CHAT, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_WIDGETS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_BUTTONS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_HUD, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_KILL_LIST, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_TEXTLABELS, true ) ;
			
			for ( new i = 5 ; i < 10 ; i ++ ) if ( IsPlayerAttachedObjectSlotUsed ( playerid, i ) ) RemovePlayerAttachedObject ( playerid, i ) ;
			for ( new j = 0 ; j < MAX_ACCESORIES ; j ++ )
			{
				if ( acc_player [ playerid ] [ acc_used ] [ j ] == 0 ) continue ;
				GiveItem ( playerid, acc_player [ playerid ] [ acc_model ] [ j ], 1, j ) ;
			}
			return 1 ;
		}
		else if ( _id == 253 && _id2 == 253 )
		{
			if ( player_shop_manager { playerid } == 1 )
			{
				player_shop_manager { playerid } = 0 ;
				SetShopReset ( playerid ) ;
				ShowAcessoriesCategory ( playerid ) ;
				return 1 ;
			}
			
			SetShopHide ( playerid, 1 ) ;
			
			toggle_controlable ( playerid, true ) ;
			SetCameraBehindPlayer ( playerid ) ;

			TogglePlayerHudElement ( playerid, HUD_ELEMENT_CHAT, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_WIDGETS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_BUTTONS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_HUD, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_KILL_LIST, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_TEXTLABELS, true ) ;
			
			if ( player_shop_manager { playerid } == 1 && GetPVarInt ( playerid, "p_acc_id" ) > 0 ) close_buy_accessories ( playerid ) ;
			else if ( player_shop_manager { playerid } == 2 ) close_buy_skins ( playerid ) ;
			return 1 ;
		}
		else if ( _id == 254 && _id2 == 254 )
		{
			SetShopHide ( playerid, 1 ) ;
			toggle_controlable ( playerid, true ) ;
			SetCameraBehindPlayer ( playerid ) ;

			TogglePlayerHudElement ( playerid, HUD_ELEMENT_CHAT, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_WIDGETS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_BUTTONS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_HUD, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_KILL_LIST, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_TEXTLABELS, true ) ;
			
			if ( player_shop_manager { playerid } == 1 && GetPVarInt ( playerid, "p_acc_id" ) > 0 )
			{
				SetPVarInt ( playerid, "p_acc_id", GetPVarInt ( playerid, "p_acc_id" ) - 1 ) ;
				player_shop_manager { playerid } = 0 ;
				accept_buy_accessories ( playerid ) ;
			}
			else if ( player_shop_manager { playerid } == 2 )
			{
				player_shop_manager { playerid } = 0 ;
				accept_buy_skins ( playerid ) ;
			}
			return 1 ;
		}

		if ( player_shop_manager { playerid } == 1 )
		{
			new _iType = GetPVarInt ( playerid, "p_acc_listitem" ) - 1 ;
			if ( _iType == -1 )
			{
				for ( new i = 0 ; i < accessories_category_count ; i ++ )
				{
					if ( accessories_items [ i ] [ 0 ] != _id2 ) continue ;
			
					SetShopReset ( playerid ) ;
					ShowAcessoriesSet ( playerid, i ) ;
					player_shop_manager { playerid } = 1 ;
					SetPVarInt ( playerid, "p_acc_listitem", i + 1 ) ;
					break ;
				}
			}
			else
			{
				GiveItem ( playerid, _id2, 2, 0 ) ;
				for ( new i = 0 ; i < 20 ; i ++ )
				{
					if ( accessories_items [ _iType ] [ i ] != _id2 ) continue ;
					
					SetPVarInt ( playerid, "p_acc_id", i + 1 ) ;
					break ;
				}
			}
		}
		else if ( player_shop_manager { playerid } == 2 )
		{
			new _iType = p_info [ playerid ] [ gender ] ;
			for ( new i = 0 ; i < MAX_SKIN_IN_SHOP ; i ++ )
			{
				if ( shop_skins [ _iType ] [ i ] != _id2 ) continue ;
				
				SetPlayerSkinEx ( playerid, shop_skins [ _iType ] [ i ] ) ;
				SetPVarInt ( playerid, "skin_select_number", i ) ;
				player_shop_manager { playerid } = 2 ;
				break ;
			}
		}
	}
	else if ( _id4 == 2 )
	{
		if ( _id == 0 && _id2 == 0 )
		{
			SetShopHide ( playerid, 2 ) ;
			
			player_shop_manager { playerid } = 0 ;
			toggle_controlable ( playerid, true ) ;

			TogglePlayerHudElement ( playerid, HUD_ELEMENT_CHAT, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_WIDGETS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_BUTTONS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_HUD, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_KILL_LIST, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_TEXTLABELS, true ) ;
			return 1 ;
		}
		else if ( _id == 1 && _id2 == 1 )
		{
			new _b_id = GetPVarInt ( playerid, "p_biz_id" ), _b_type = b_info [ _b_id - 1 ] [ b_type ], line_string [ 24 ], _price = b_price_market [ _b_id - 1 ] [ _id3 ] ;
			if ( _b_type == bizz_type_shop )
			{
				new _maxmoney = floatround ( p_info [ playerid ] [ money ] / _price ),
					_maxitem = floatround ( b_info [ _b_id - 1 ] [ b_product ] / b_shop [ _id3 ] [ bs_product ] ) ;
					
				if ( mafia_player ( playerid ) )
				{
					if ( b_info [ _b_id - 1 ] [ b_mafia ] == p_info [ playerid ] [ member ] )
					{
						_price = floatround ( _price / 2 ) ;
					}
				}
				if ( b_price_market [ _b_id - 1 ] [ _id3 ] > get_b_price_market ( _id3, _b_id ) ) format ( line_string, sizeof line_string, "{"#cRD"}завышена" ) ;
				else format ( line_string, sizeof line_string, "{"#cOR"}рыночная" ) ;
			
				if ( b_shop [ _id3 ] [ bs_count ] )
				{
					global_string [ 0 ] = EOS ;
					format ( global_string, 512, "\
					{"#cWH"}Предмет: {"#cOR"}%s\n\
					{"#cWH"}Стоимость: {"#cGN"}%s"valute_title_" за 1 шт.\n\
					{"#cWH"}В наличии: {"#cGN"}%d шт.\n\
					{"#cWH"}Цена %s\n\n\
					{"#cGRDialog"}* Введите какое количество Вы хотите купить:\n\
					{"#cGRDialog"}* Ваших денег хватает на %d ед. товара.", 
					b_shop [ _id3 ] [ bs_name ], GetPlayerCashValueToSmile ( _price ),
					_maxitem, line_string,
					( _maxmoney > _maxitem ) ? ( _maxitem ) : ( _maxmoney ) ) ;
					
					show_dialog ( playerid, d_shop, DIALOG_STYLE_INPUT, "{"#cBHD"}Покупка предмета", global_string, "Купить", "Отмена" ) ;
				}
				else
				{
					global_string [ 0 ] = EOS ;
					format ( global_string, 512, "\
					{"#cWH"}Предмет: {"#cOR"}%s\n\
					{"#cWH"}Стоимость: {"#cGN"}%s"valute_title_" за 1 шт.\n\
					{"#cWH"}В наличии: {"#cGN"}%d шт.\n\
					{"#cWH"}Цена %s", 
					b_shop [ _id3 ] [ bs_name ], GetPlayerCashValueToSmile ( _price ),
					_maxitem, line_string ) ;
					
					show_dialog ( playerid, d_shop, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка предмета", global_string, "Купить", "Отмена" ) ;
				}
			}
			/*else if ( _b_type == bizz_type_pharm )
			{
				new _maxmoney = floatround ( p_info [ playerid ] [ money ] / _price ),
					_maxitem = floatround ( b_info [ _b_id - 1 ] [ b_product ] / b_pharmacy_shop [ _id3 ] [ bs_product ] ) ;
					
				if ( mafia_player ( playerid ) )
				{
					if ( b_info [ _b_id - 1 ] [ b_mafia ] == p_info [ playerid ] [ member ] )
					{
						_price = floatround ( _price / 2 ) ;
					}
				}
				if ( b_price_market [ _b_id - 1 ] [ _id3 ] > get_b_price_market ( _id3, _b_id ) ) format ( line_string, sizeof line_string, "{"#cRD"}завышена" ) ;
				else format ( line_string, sizeof line_string, "{"#cOR"}рыночная" ) ;
			
				if ( b_pharmacy_shop [ _id3 ] [ bs_count ] )
				{
					global_string [ 0 ] = EOS ;
					format ( global_string, 512, "\
					{"#cWH"}Предмет: {"#cOR"}%s\n\
					{"#cWH"}Стоимость: {"#cGN"}%s"valute_title_" за 1 шт.\n\
					{"#cWH"}В наличии: {"#cGN"}%d шт.\n\
					{"#cWH"}Цена %s\n\n\
					{"#cGRDialog"}* Введите какое количество Вы хотите купить:\n\
					{"#cGRDialog"}* Ваших денег хватает на %d ед. товара.", 
					b_pharmacy_shop [ _id3 ] [ bs_name ], GetPlayerCashValueToSmile ( _price ),
					_maxitem, line_string,
					( _maxmoney > _maxitem ) ? ( _maxitem ) : ( _maxmoney ) ) ;
					
					show_dialog ( playerid, d_pharmshop, DIALOG_STYLE_INPUT, "{"#cBHD"}Покупка предмета", global_string, "Купить", "Отмена" ) ;
				}
				else
				{
					global_string [ 0 ] = EOS ;
					format ( global_string, 512, "\
					{"#cWH"}Предмет: {"#cOR"}%s\n\
					{"#cWH"}Стоимость: {"#cGN"}%s"valute_title_" за 1 шт.\n\
					{"#cWH"}В наличии: {"#cGN"}%d шт.\n\
					{"#cWH"}Цена %s", 
					b_pharmacy_shop [ _id3 ] [ bs_name ], GetPlayerCashValueToSmile ( _price ),
					_maxitem, line_string ) ;
					
					show_dialog ( playerid, d_pharmshop, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Покупка предмета", global_string, "Купить", "Отмена" ) ;
				}
			}*/
			else if ( _b_type == bizz_type_ammo )
			{
				new _maxmoney = floatround ( p_info [ playerid ] [ money ] / _price ),
					_maxitem = floatround ( b_info [ _b_id - 1 ] [ b_product ] / b_gun_shop [ _id3 ] [ bs_product ] ) ;
					
				if ( mafia_player ( playerid ) )
				{
					if ( b_info [ _b_id - 1 ] [ b_mafia ] == p_info [ playerid ] [ member ] )
					{
						_price = floatround ( _price / 2 ) ;
					}
				}
				if ( b_price_market [ _b_id - 1 ] [ _id3 ] > get_b_price_market ( _id3, _b_id ) ) format ( line_string, sizeof line_string, "{"#cRD"}завышена" ) ;
				else format ( line_string, sizeof line_string, "{"#cOR"}рыночная" ) ;
			
				global_string [ 0 ] = EOS ;
				format ( global_string, 512, "\
				{"#cWH"}Предмет: {"#cOR"}%s\n\
				{"#cWH"}Стоимость: {"#cGN"}%s"valute_title_" за 1 шт.\n\
				{"#cWH"}В наличии: {"#cGN"}%d шт.\n\
				{"#cWH"}Цена %s\n\n\
				{"#cGRDialog"}* Введите какое количество Вы хотите купить:\n\
				{"#cGRDialog"}* Ваших денег хватает на %d ед. товара.", 
				b_gun_shop [ _id3 ] [ bs_name ], GetPlayerCashValueToSmile ( _price ),
				_maxitem, line_string,
				( _maxmoney > _maxitem ) ? ( _maxitem ) : ( _maxmoney ) ) ;
				
				show_dialog ( playerid, d_ammo_shop, DIALOG_STYLE_INPUT, "{"#cBHD"}Покупка предмета", global_string, "Купить", "Отмена" ) ;
			}
			
			set_player_use_listitem ( playerid, _id3 ) ;
		}
	}
	return 1 ;
}

stock clear_player_shop_manager ( playerid )
{
	player_shop_manager { playerid } = 0 ;
	return 1 ;
}

stock shop_OnPlayerDisconnect ( playerid )
{
	if ( player_shop_manager { playerid } > 0 )
	{
		DeletePVar ( playerid, "p_acc_listitem" ) ;
		DeletePVar ( playerid, "skin_select_number" ) ;
	}
	return 1 ;
}