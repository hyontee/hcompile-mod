stock tuning_ClickTextDraw ( playerid, Text:clickedid )
{
	if ( clickedid == td_tuning [ 37 ] ) // Право
	{
	    if ( used_default_tuning { playerid } >= 12 ) return 1 ;
	    
		used_default_tuning { playerid } += 1 ;
	    new tuning_page = used_default_tuning { playerid } ;
		
		if ( tuning_page == 1 )
		{
			new cam_pos = tuning_page ;
			if ( cam_pos != 0 && cam_pos != 1) switch_camera ( playerid, cam_pos - 1, 0 ) ;
			delete_tuning ( playerid, tuning_page ) ;

			SetPVarInt ( playerid, "color_id", 1 ) ;

			p_t_info [ playerid ] [ car_color ] [ 0 ] = 0 ;

			new _v_id = p_t_info [ playerid ] [ tuning_vehicle ] ;
			new _color = p_t_info [ playerid ] [ car_color ] [ 0 ] ;
			new _color2 = p_t_info [ playerid ] [ car_color ] [ 1 ] ;
	        ChangeVehicleColor ( _v_id, _color, _color2 ) ;
	        
	        tuning_td_update ( playerid, tuning_page ) ;
			
			PlayerTextDrawSetString ( playerid, ptd_tuning [ playerid ] [ 2 ], "CAR_COLOR" ) ;
		}
		else if ( tuning_page == 2 )
		{
		    #if defined CRMP
		        PlayerTextDrawSetString ( playerid, ptd_tuning [ playerid ] [ 2 ], "PAINT_JOBS" ) ;
                return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}В данный момент мы готовим для Вас кое-что интересное, поэтому тюнинг не работает." ) ;
			#endif
		
		    /*PlayerTextDrawSetString ( playerid, ptd_tuning [ playerid ] [ 2 ], "PAINT_JOBS" ) ;
		    if( ! paintjob_available ( GetVehicleModel ( p_t_info [ playerid ] [ tuning_vehicle ] ) ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRInfo"}* {"#cGRInfo"}Аэрография недоступна для модели вашего транспорта." ) ;
            new cam_pos = tuning_page ;
			if ( cam_pos != 0 && cam_pos != 1) switch_camera ( playerid, tuning_page - 1, 1 ) ;
			delete_tuning ( playerid, tuning_page - 1 ) ;
			
			tuning_td_update ( playerid, tuning_page ) ;*/
		}
		else if ( tuning_page == 3 )
		{
