		{
		    new comp_id = p_t_info [ playerid ] [ component_id ] [ i ] ;
			if ( comp_id == 0 ) continue ;

			set_player_listitem_values ( playerid, _select_id, i ) ;
			
			_select_id ++ ;
			
		    if ( i == 0 && comp_id != 0 )
		    {
		        format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}Покраска внешняя - {"#cGN"}%d$\n", i + 1, tuning_price [ i ] * b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_cost ] ) ;
		    	strcat ( global_string, line_string ) ;
		        continue ;
		    }
		    else if ( i == 12 && comp_id != 0 )
		    {
		        format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}Покраска внутренняя - {"#cGN"}%d$\n", i + 1, tuning_price [ i ] * b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_cost ] ) ;
		    	strcat ( global_string, line_string ) ;
		        continue ;
		    }
		    
		    new _detail_name [ 32 ], _detail_type [ 32 ] ;
			format ( _detail_type, sizeof _detail_type, "%s", tuning_details ( comp_id ) ) ;
			format ( _detail_name, sizeof _detail_name, "%s", tuning_details_1 ( comp_id ) ) ;
		    format ( line_string, sizeof line_string, "{"#cBL"}%d. {"#cWH"}%s {"#cGRDialog"}(%s){"#cWH"} - {"#cGN"}%d$\n", _select_id - 2, _detail_name, _detail_type, tuning_price [ i ] * b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_cost ] ) ;
		    strcat ( global_string, line_string ) ;
		}
		show_dialog ( playerid, d_tune, DIALOG_STYLE_LIST, "{"#cBHD"}Корзина", global_string, "Выбрать", "Закрыть" ) ;
		return 1 ;
	}
	return 0 ;
}

stock show_tuning_td ( playerid, bool: status )
{
	if ( status )
	{
		if ( player_device { playerid } != 2 )
		{
			show_dialog ( playerid, d_tun_open, DIALOG_STYLE_MSGBOX, "{"#cBHD"}Информация", "{"#cBL"}** Автосервис **\n\n\
																	{"#cGRDialog"}* Нажимайте на названия разделов в панели справа.\n\
																	{"#cGRDialog"}* Выбирайте всё, что Вам нужно нажимая на стрелки.\n\
																	{"#cGRDialog"}* Всё, что Вы наберёте перенсётся в корзину и будет ждать оплаты.\n\n\
																	{"#cBL"}** Номенклатура **\n\n\
																	{"#cGRDialog"}* SELECT - Выбрать и отправить в корзину.\n\
																	{"#cGRDialog"}* BUY - Корзина.\n\
																	{"#cGRDialog"}* EXIT - Покинуть тюнинг.\n\n\
																	{"#cRInfo"}* {"#cGRInfo"}Если пропал курсор мыши, то используйте /open_stick", "Принять", "" ) ;

			ptd_tuning[playerid][0] = CreatePlayerTextDraw(playerid, 340.5000, 362.2333, "TOTAL_PRICE:_0$"); // пусто
			PlayerTextDrawLetterSize(playerid, ptd_tuning[playerid][0], 0.1246, 0.8988);
			PlayerTextDrawTextSize(playerid, ptd_tuning[playerid][0], 0.0000, 62.0000);
			PlayerTextDrawAlignment(playerid, ptd_tuning[playerid][0], 2);
			PlayerTextDrawColor(playerid, ptd_tuning[playerid][0], color_box);
			PlayerTextDrawBackgroundColor(playerid, ptd_tuning[playerid][0], 255);
			PlayerTextDrawFont(playerid, ptd_tuning[playerid][0], 2);
			PlayerTextDrawSetProportional(playerid, ptd_tuning[playerid][0], 1);
			PlayerTextDrawSetShadow(playerid, ptd_tuning[playerid][0], 0);

			ptd_tuning[playerid][1] = CreatePlayerTextDraw(playerid, 278.6664, 362.3034, "PRICE:_0$"); // пусто
			PlayerTextDrawLetterSize(playerid, ptd_tuning[playerid][1], 0.1243, 0.8615);
			PlayerTextDrawTextSize(playerid, ptd_tuning[playerid][1], 0.0000, 39.0000);
			PlayerTextDrawAlignment(playerid, ptd_tuning[playerid][1], 2);
			PlayerTextDrawColor(playerid, ptd_tuning[playerid][1], color_box);
			PlayerTextDrawBackgroundColor(playerid, ptd_tuning[playerid][1], 255);
			PlayerTextDrawFont(playerid, ptd_tuning[playerid][1], 2);
			PlayerTextDrawSetProportional(playerid, ptd_tuning[playerid][1], 1);
			PlayerTextDrawSetShadow(playerid, ptd_tuning[playerid][1], 0);
			
			ptd_tuning[playerid][2] = CreatePlayerTextDraw(playerid, 314.7998, 408.6017, "FRONT_BUMPER"); // пусто
			PlayerTextDrawLetterSize(playerid, ptd_tuning[playerid][2], 0.1650, 0.9071);
			PlayerTextDrawAlignment(playerid, ptd_tuning[playerid][2], 2);
			PlayerTextDrawColor(playerid, ptd_tuning[playerid][2], color_box);
			PlayerTextDrawBackgroundColor(playerid, ptd_tuning[playerid][2], 255);
			PlayerTextDrawFont(playerid, ptd_tuning[playerid][2], 2);
			PlayerTextDrawSetProportional(playerid, ptd_tuning[playerid][2], 1);
			PlayerTextDrawSetShadow(playerid, ptd_tuning[playerid][2], 0);

			ptd_tuning[playerid][3] = CreatePlayerTextDraw(playerid, 314.7998, 379.3999, "BUMPER"); // пусто
			PlayerTextDrawLetterSize(playerid, ptd_tuning[playerid][3], 0.1650, 0.9071);
			PlayerTextDrawAlignment(playerid, ptd_tuning[playerid][3], 2);
			PlayerTextDrawColor(playerid, ptd_tuning[playerid][3], color_box);
			PlayerTextDrawBackgroundColor(playerid, ptd_tuning[playerid][3], 255);
			PlayerTextDrawFont(playerid, ptd_tuning[playerid][3], 2);
			PlayerTextDrawSetProportional(playerid, ptd_tuning[playerid][3], 1);
			PlayerTextDrawSetShadow(playerid, ptd_tuning[playerid][3], 0);
			
			used_default_tuning { playerid } = 1 ;
			SetPVarInt ( playerid, "color_id", 1 ) ;
			
			tuning_td_update ( playerid, 1 ) ;

			PlayerTextDrawSetString ( playerid, ptd_tuning [ playerid ] [ 2 ], "CAR_COLOR" ) ;

			for ( new i = 0 ; i < 59 ; i ++ )
			{
				TextDrawShowForPlayer ( playerid, td_tuning [ i ] ) ;
				if ( i < 4 ) PlayerTextDrawShow ( playerid, ptd_tuning [ playerid ] [ i ] ) ;
			}
		
			SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
			player_custom_page { playerid } = 0 ;

			p_t_info [ playerid ] [ car_color ] [ 0 ] = 0 ;
				
			new _v_id = p_t_info [ playerid ] [ tuning_vehicle ] ;
			new _color = p_t_info [ playerid ] [ car_color ] [ 0 ] ;
			new _color2 = p_t_info [ playerid ] [ car_color ] [ 1 ] ;
			ChangeVehicleColor ( _v_id, _color, _color2 ) ;
			
			p_t_info [ playerid ] [ total_price ] = 0 ;
			for ( new i = 0 ; i < 13 ; i ++ ) p_t_info [ playerid ] [ component_id ] [ i ] = 0 ;
			
			page_count [ playerid ] = 1 ;
			page_rows [ playerid ] = 0 ;
		}
		else if ( player_device { playerid } == 2 )
		{
			new _veh_id = p_t_info [ playerid ] [ tuning_vehicle ] ;
			if ( _veh_id == INVALID_VEHICLE_ID )
			{
				new bool: _accept_cars = false ;
				foreach(new _vh_id: player_vehicles[playerid])
				{
					new Float: _x_v, Float: _x_y, Float: _x_z ;
					GetVehiclePos ( _vh_id, _x_v, _x_y, _x_z ) ;
					
					if ( ! IsPlayerInRangeOfPoint ( playerid, 15.0, _x_v, _x_y, _x_z ) ) continue ;
					
					p_t_info [ playerid ] [ tuning_vehicle ] = _vh_id ;
					_veh_id = _vh_id ;
					
					_accept_cars = true ;
					break ;
				}
				
				if ( _accept_cars == false )
				{
					send_check_cinfo ( playerid, "Загоните т/с заново!", 0, 300, CINFO_TUNING_ID, CINFO_TYPE_AREA, PICTURE_INFO_ERROR, "", "" ) ;
					return 1 ;
				}
			}
	
			showTuning ( playerid, false ) ;
		}
		
		TogglePlayerControllable ( playerid, false ) ;
			
		new _pos ;
		if ( p_t_info [ playerid ] [ tune_pos ] [ 0 ] ) _pos = 0 ;
		else _pos = 1 ;
		SetPlayerCameraPos ( playerid, tuning_camera_positions [ _pos ] [ 0 ] [ 0 ], tuning_camera_positions [ _pos ] [ 0 ] [ 1 ], tuning_camera_positions [ _pos ] [ 0 ] [ 2 ] ) ;
		SetPlayerCameraLookAt ( playerid, tuning_camera_positions [ _pos ] [ 0 ] [ 3 ], tuning_camera_positions [ _pos ] [ 0 ] [ 4 ], tuning_camera_positions [ _pos ] [ 0 ] [ 5 ] ) ;
			
	}
	else
	{
		if ( player_device { playerid } != 2 )
		{
			for ( new i = 0 ; i < 59 ; i ++ )
			{
				TextDrawHideForPlayer ( playerid, td_tuning [ i ] ) ;
				if ( i < 4 )
				{
					PlayerTextDrawDestroy ( playerid, ptd_tuning [ playerid ] [ i ] ) ;
					ptd_tuning [ playerid ] [ i ] = PlayerText:-1 ;
				}
			}
			
			DeletePVar ( playerid, "paintjob_id" ) ;
			DeletePVar ( playerid, "color_id" ) ;
			
			component_tuning { playerid } = 0 ;
				
			new vehicle_id = p_t_info [ playerid ] [ tuning_vehicle ] ;

			CancelSelectTextDraw ( playerid ) ;
			SetCameraBehindPlayer ( playerid ) ;

			new point = 0,
				_v_model = veh_info [ vehicle_id - 1 ] [ v_model ] ;

			for ( new i = 0; i <= 91 ; i ++ )
			{
				if ( _v_model == legal_tuns [ i ] [ 0 ] )
				{
					point = i;
					break ;
				}
			}
			for ( new j = 0; j <= 57  ; j ++ )
			{
				RemoveVehicleComponent ( vehicle_id, legal_tuns [ point ] [ j ] ) ;
			}
			for ( new i = 0 ; i < 10 ; i ++ )
			{
				p_t_info [ playerid ] [ component_id ] [ i ] = 0 ;
				
				if ( veh_info [ vehicle_id - 1 ] [ v_component ] [ i ] == 0 ) continue ;
				AddVehicleComponent ( vehicle_id, veh_info [ vehicle_id - 1 ] [ v_component ] [ i ] ) ;
			}
			if ( veh_info [ vehicle_id - 1 ] [ v_paint ] != 3 )
			{
				n_ChangeVehicleColor ( vehicle_id, veh_info [ vehicle_id - 1 ] [ v_color ] [ 0 ], veh_info [ vehicle_id - 1 ] [ v_color ] [ 1 ] ) ;
				ChangeVehiclePaintjob ( vehicle_id, veh_info [ vehicle_id - 1 ] [ v_paint ] ) ;
			}
			else
			{
				ChangeVehiclePaintjob ( vehicle_id, 3 ) ;
				n_ChangeVehicleColor ( vehicle_id, veh_info [ vehicle_id - 1 ] [ v_color ] [ 0 ], veh_info [ vehicle_id - 1 ] [ v_color ] [ 1 ] ) ;
			}
			
			used_default_tuning { playerid } = 0 ;
		}
		else if ( player_device { playerid } == 2 )
		{
			TogglePlayerControllable ( playerid, true ) ;
			SetCameraBehindPlayer ( playerid ) ;
		
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_CHAT, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_WIDGETS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_BUTTONS, true ) ;
			TogglePlayerHudElement ( playerid, HUD_ELEMENT_HUD, true ) ;
		}
	}
	return 1 ;
}

stock tuning_td_update ( playerid, tuning_page, _component_id = 0 )
{
    new td_string [ 64 ] ;
	format ( td_string, sizeof td_string, "PRICE:_%d$", tuning_price [ tuning_page - 1 ] * b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_cost ] ) ;
	PlayerTextDrawSetString ( playerid, ptd_tuning [ playerid ] [ 1 ], td_string ) ;

	if ( ! _component_id ) PlayerTextDrawSetString ( playerid, ptd_tuning [ playerid ] [ 3 ], "SELECT" ) ;
	else
	{
	    format ( td_string, sizeof td_string, "%s", tuning_details_1 ( _component_id ) ) ;
		PlayerTextDrawSetString ( playerid, ptd_tuning [ playerid ] [ 3 ], td_string ) ;
	}
	return 1 ;
}

stock add_tuning ( playerid, tuning_page )
{
    if ( ! p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] )
    {
	    p_t_info [ playerid ] [ total_price ] += tuning_price [ tuning_page - 1 ] * b_info [ GetPVarInt ( playerid, "p_biz_id" ) - 1 ] [ b_cost ] ;

		if ( player_device { playerid } != 2 )
		{
			new td_string [ 20 + 9 ] ;
			format ( td_string, sizeof td_string, "TOTAL_PRICE:_%d$", p_t_info [ playerid ] [ total_price ] ) ;
			PlayerTextDrawSetString ( playerid, ptd_tuning [ playerid ] [ 0 ], td_string ) ;
		}
	}
	
	if ( tuning_page > 2 && tuning_page < 11 )
	{
		if ( component_tuning { playerid } <= 0 ) return 1 ;
	}
	
    if ( tuning_page == 1 ) p_t_info [ playerid ] [ component_id ] [ 0 ] = p_t_info [ playerid ] [ car_color ] [ 0 ] + 1, p_t_info [ playerid ] [ component_id ] [ 12 ] = p_t_info [ playerid ] [ car_color ] [ 1 ] + 1 ;
    else if ( tuning_page == 2 ) p_t_info [ playerid ] [ component_id ] [ 1 ] = p_t_info [ playerid ] [ paint_jobs ] ;
	else if ( tuning_page == 3 ) p_t_info [ playerid ] [ component_id ] [ 2 ] = exhaust_models [ component_tuning { playerid } - 1 ] ;
	else if ( tuning_page == 4 ) p_t_info [ playerid ] [ component_id ] [ 3 ] = bullbar_models [ component_tuning { playerid } - 1 ] ;
	else if ( tuning_page == 5 ) p_t_info [ playerid ] [ component_id ] [ 4 ] = roof_models [ component_tuning { playerid } - 1 ] ;
	else if ( tuning_page == 6 ) p_t_info [ playerid ] [ component_id ] [ 5 ] = front_bumper_models [ component_tuning { playerid } - 1 ] ;
	else if ( tuning_page == 7 ) p_t_info [ playerid ] [ component_id ] [ 6 ] = rear_bumper_models [ component_tuning { playerid } - 1 ] ;
	else if ( tuning_page == 8 ) p_t_info [ playerid ] [ component_id ] [ 7 ] = spoiler_models [ component_tuning { playerid } - 1 ] ;
	else if ( tuning_page == 9 ) p_t_info [ playerid ] [ component_id ] [ 8 ] = sideskirt_models [ component_tuning { playerid } - 1 ] ;
	else if ( tuning_page == 10 ) p_t_info [ playerid ] [ component_id ] [ 9 ] = tuning_wheels [ component_tuning { playerid } - 1 ] ;
	else if ( tuning_page == 11 ) p_t_info [ playerid ] [ component_id ] [ 10 ] = 1087 ;
    else if ( tuning_page == 12 ) p_t_info [ playerid ] [ component_id ] [ 11 ] = 1010 ;
	return 1 ;
}

stock delete_tuning ( playerid, tuning_page, type = 0 )
{
    new _v_id = p_t_info [ playerid ] [ tuning_vehicle ] ;
   	SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
   	
   	if ( type == 1 )
	{
		if ( tuning_page == 0 || tuning_page == 1 || tuning_page == 12 )
		{
		    if ( veh_info [ _v_id - 1 ] [ v_paint ] != 3 )
			{
				ChangeVehiclePaintjob ( _v_id, veh_info [ _v_id - 1 ] [ v_paint ] ) ;
			}
			else
			{
				ChangeVehiclePaintjob ( _v_id, 3 ) ;
				ChangeVehicleColor ( _v_id, veh_info [ _v_id - 1 ] [ v_color ] [ 0 ], veh_info [ _v_id - 1 ] [ v_color ] [ 1 ] ) ;
			}
			return 1 ;
		}
	    RemoveVehicleComponent ( _v_id, p_t_info [ playerid ] [ component_id ] [ tuning_page ] ) ;
	    return 1 ;
	}
   	
   	new comp_id = component_tuning { playerid } - 1 ;
   	if ( comp_id == -1 ) return 1 ;
    switch ( tuning_page )
    {
		case 1:
		{
			if ( veh_info [ _v_id - 1 ] [ v_paint ] != 3 )
			{
			    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == p_t_info [ playerid ] [ paint_jobs ] ) return 1 ;
			
				ChangeVehiclePaintjob ( _v_id, veh_info [ _v_id - 1 ] [ v_paint ] ) ;
			}
			else
			{
			    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == p_t_info [ playerid ] [ car_color ] [ 0 ] ||
					p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == p_t_info [ playerid ] [ paint_jobs ] ) return 1 ;
			
				ChangeVehiclePaintjob ( _v_id, 3 ) ;
				ChangeVehicleColor ( _v_id, veh_info [ _v_id - 1 ] [ v_color ] [ 0 ], veh_info [ _v_id - 1 ] [ v_color ] [ 1 ] ) ;
			}
		}
		case 2:
		{
			if ( veh_info [ _v_id - 1 ] [ v_paint ] != 3 )
			{
				ChangeVehiclePaintjob ( _v_id, veh_info [ _v_id - 1 ] [ v_paint ] ) ;
			}
			else
			{
				ChangeVehiclePaintjob ( _v_id, 3 ) ;
				ChangeVehicleColor ( _v_id, veh_info [ _v_id - 1 ] [ v_color ] [ 0 ], veh_info [ _v_id - 1 ] [ v_color ] [ 1 ] ) ;
			}
		}
		case 3:
		{
		    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == exhaust_models [ comp_id ] ) return 1 ;
		    RemoveVehicleComponent ( _v_id, exhaust_models [ comp_id ] ) ;
		}
		case 4:
		{
		    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == bullbar_models [ comp_id ] ) return 1 ;
		    RemoveVehicleComponent ( _v_id, bullbar_models [ comp_id ] ) ;
		}
		case 5:
		{
		    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == roof_models [ comp_id ] ) return 1 ;
		   	RemoveVehicleComponent ( _v_id, roof_models [ comp_id ] ) ;
		}
		case 6:
		{
		    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == front_bumper_models [ comp_id ] ) return 1 ;
		    RemoveVehicleComponent ( _v_id, front_bumper_models [ comp_id ] ) ;
		}
		case 7:
		{
		    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == rear_bumper_models [ comp_id ] ) return 1 ;
		    RemoveVehicleComponent ( _v_id, rear_bumper_models [ comp_id ] ) ;
		}
		case 8:
		{
		    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == spoiler_models [ comp_id ] ) return 1 ;
		    RemoveVehicleComponent ( _v_id, spoiler_models [ comp_id ] ) ;
		}
		case 9:
		{
		    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == sideskirt_models [ comp_id ] ) return 1 ;
		    RemoveVehicleComponent ( _v_id, sideskirt_models [ comp_id ] ) ;
		}
		case 10:
		{
		    if ( p_t_info [ playerid ] [ component_id ] [ tuning_page - 1 ] == tuning_wheels [ comp_id ] ) return 1 ;
		    RemoveVehicleComponent ( _v_id, tuning_wheels [ comp_id ] ) ;
		}
		default: return 1 ;
	}
	return 1 ;
}

stock save_tuning ( playerid )
{
    new _v_id = p_t_info [ playerid ] [ tuning_vehicle ] ;
	if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_player )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, 266, "UPDATE `users_vehicles` SET `v_components` = '%d|%d|%d|%d|%d|%d|%d|%d|%d|%d',`v_color_1` = '%d',`v_color_2` = '%d',`v_paint`='%d' WHERE `v_id` = '%d' LIMIT 1",
		veh_info [ _v_id - 1 ] [ v_component ] [ 0 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 1 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 2 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 3 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 4 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 5 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 6 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 7 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 8 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 9 ],
		veh_info [ _v_id - 1 ] [ v_color ] [ 0 ],
		veh_info [ _v_id - 1 ] [ v_color ] [ 1 ],
		veh_info [ _v_id - 1 ] [ v_paint ],
		veh_info [ _v_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
		SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
	}
	else if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_family )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, 266, "UPDATE `familys_vehicles` SET `v_components` = '%d|%d|%d|%d|%d|%d|%d|%d|%d|%d',`sv_color_1` = '%d',`sv_color_2` = '%d',`sv_paint`='%d' WHERE `sv_id` = '%d' LIMIT 1",
		veh_info [ _v_id - 1 ] [ v_component ] [ 0 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 1 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 2 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 3 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 4 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 5 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 6 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 7 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 8 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 9 ],
		veh_info [ _v_id - 1 ] [ v_color ] [ 0 ],
		veh_info [ _v_id - 1 ] [ v_color ] [ 1 ],
		veh_info [ _v_id - 1 ] [ v_paint ],
		veh_info [ _v_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
		SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
	}
	else if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_rentcar )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, 266, "UPDATE `rent_vehicles` SET `v_components` = '%d|%d|%d|%d|%d|%d|%d|%d|%d|%d',`sv_color_1` = '%d',`sv_color_2` = '%d',`sv_paint`='%d' WHERE `sv_id` = '%d' LIMIT 1",
		veh_info [ _v_id - 1 ] [ v_component ] [ 0 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 1 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 2 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 3 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 4 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 5 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 6 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 7 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 8 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 9 ],
		veh_info [ _v_id - 1 ] [ v_color ] [ 0 ],
		veh_info [ _v_id - 1 ] [ v_color ] [ 1 ],
		veh_info [ _v_id - 1 ] [ v_paint ],
		veh_info [ _v_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
		SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
	}
	else if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_house )
	{
		global_string [ 0 ] = EOS ;
		format ( global_string, 266, "UPDATE `house_vehicles` SET `v_components` = '%d|%d|%d|%d|%d|%d|%d|%d|%d|%d',`sv_color_1` = '%d',`sv_color_2` = '%d',`sv_paint`='%d' WHERE `sv_id` = '%d' LIMIT 1",
		veh_info [ _v_id - 1 ] [ v_component ] [ 0 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 1 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 2 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 3 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 4 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 5 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 6 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 7 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 8 ],
		veh_info [ _v_id - 1 ] [ v_component ] [ 9 ],
		veh_info [ _v_id - 1 ] [ v_color ] [ 0 ],
		veh_info [ _v_id - 1 ] [ v_color ] [ 1 ],
		veh_info [ _v_id - 1 ] [ v_paint ],
		veh_info [ _v_id - 1 ] [ v_id ] ) ;
		mysql_tquery ( sql_connection, global_string ) ;
		SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
	}
	return 1 ;
}

find_available_spoiler_slot ( modelid, stage, bool:type )
{
	if ( type )
	{
		new point = 0 ;
		for ( new i = 0; i <= 91 ; i ++ )
		{
			if ( modelid == legal_tuns [ i ][ 0 ] )
			{
				point = i;
				break ;
			}
		}
		if ( point == 0 ) return false ;
		for ( new i = 0; i <= 19 ; i ++ )
		{
			for ( new j = 0; j <= 57  ; j ++ )
			{
				if ( i <= stage ) continue ;
		        if ( legal_tuns [ point ] [ j ] == spoiler_models [ i ] )return i + 1;
			}
		}
		for ( new i = 0; i <= 19; i ++ )
		{
	 		for ( new j = 0; j <= 57  ; j ++ )
			{
	       		if ( legal_tuns [ point ] [ j ] == spoiler_models [ i ] )return i + 1;
	       	}
		}
	}
	else
	{
		new point = 0 ;
		for ( new i = 0; i <= 91 ; i ++ )
		{
			if ( modelid == legal_tuns [ i ][ 0 ] )
			{
				point = i;
				break ;
			}
		}
		if ( point == 0 ) return false ;
		for ( new i = 19; i != 0 ; i -- )
		{
			for ( new j = 0; j <= 57  ; j ++ )
			{
				if ( i >= stage ) continue ;
		        if ( legal_tuns [ point ] [ j ] == spoiler_models [ i ] )return i + 1;
			}
		}
		for ( new i = 19; i != 0 ; i -- )
		{
	 		for ( new j = 0; j <= 57  ; j ++ )
			{
	       		if ( legal_tuns [ point ] [ j ] == spoiler_models [ i ] )return i + 1;
	       	}
		}
	}
	return false ;
}

