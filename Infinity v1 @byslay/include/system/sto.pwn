stock RaceSto_NotifyError(playerid, const text[])
{
    if(IsPlayerConnected(playerid))
        SendClientMessage(playerid, 0xFF3333FF, text);
    return 0;
}

stock RaceSto_GetOwnedVehicleIndexCompat(playerid, vehicleid)
{
    if(!IsPlayerConnected(playerid) || !IsValidVehicle(vehicleid)) return -1;
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR) return -1;

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index < 0) return -1;

    // ИСПРАВЛЕНО: раньше проверка владельца была закомментирована (TODO).
    // По твоему tuning.pwn это точный рабочий паттерн проверки — включаю его.
    if(GetOwnableCarData(index, OC_OWNER_ID) != GetPlayerAccountID(playerid)) return -1;

    return index;
}

stock RaceSto_GetVehicleNameCompat(vehicleid, name[], size = sizeof name)
{
    // ИСПРАВЛЕНО: используем GetVehicleData(vehicleid, V_MODELID), как везде
    // в твоём tuning.pwn, а не нативный GetVehicleModel.
    new modelid = GetVehicleData(vehicleid, V_MODELID);
    GetVehicleModelName(modelid, name, size);
    return 1;
}

// ИСПРАВЛЕНО: GetVehicleInfoByModel/VI_PRICE, которые я использовал раньше,
// в твоём проекте не существуют. Реальная функция стоимости —
// GetVehicleJsonCostByModelId(modelid, price) — именно её использует
// tuning.pwn во всех трёх своих экранах (out-параметр, не return-значение).
stock RaceSto_GetVehiclePriceCompat(vehicleid)
{
    new modelid = GetVehicleData(vehicleid, V_MODELID);
    new price;
    GetVehicleJsonCostByModelId(modelid, price);
    return price;
}

new bool:InStailing[MAX_PLAYERS];

// Запоминаем позицию/мир/интерьер игрока и его текущую машину, чтобы можно
// было вернуть его обратно после выхода из тюнинг-центра.
new Float:RaceStyleReturnPos[MAX_PLAYERS][3];
new RaceStyleReturnVW[MAX_PLAYERS];
new RaceStyleReturnInterior[MAX_PLAYERS];
new RaceStyleReturnVehicle[MAX_PLAYERS];

stock RaceSto_SaveReturnCompat(playerid, vehicleid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    GetPlayerPos(playerid, RaceStyleReturnPos[playerid][0], RaceStyleReturnPos[playerid][1], RaceStyleReturnPos[playerid][2]);
    RaceStyleReturnVW[playerid] = GetPlayerVirtualWorld(playerid);
    RaceStyleReturnInterior[playerid] = GetPlayerInterior(playerid);
    RaceStyleReturnVehicle[playerid] = vehicleid;
    RaceStyleReturnSaved[playerid] = true;
    return 1;
}

// Переносит водителя и всех пассажиров машины в нужный virtual world/interior.
stock RaceSto_SetOccupantsEnvironmentCompat(vehicleid, virtualworld, interiorid)
{
    if(!IsValidVehicle(vehicleid)) return 0;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        if(GetPlayerVehicleID(i) != vehicleid) continue;
        SetPlayerVirtualWorld(i, virtualworld);
        SetPlayerInterior(i, interiorid);
    }
    return 1;
}

stock RaceSto_GetTuneIdFromItem(id)
{
    if(id < 0 || id > RACE_STO_MAX_TUNE_ITEM_ID) return 0;
    return RaceStoItemTuneId[id];
}

stock RaceSto_GetVehicleClientJsonIdFromModel(modelid)
{
    // The client expects the first model index, exactly as in LAST(3).
    for(new i = 0; i <= RACE_STO_MAX_VEHICLE_JSON_ID; i++)
    {
        if(RaceStoVehicleIdToModelId[i] == modelid) return i;
    }
    return -1;
}

stock RaceSto_GetVehicleJsonIdFromModel(modelid)
{
    // The component list may be stored in a later duplicate entry.
    // Supra A90 (2392), for example, uses the first ID for the GUI
    // and the later populated ID for its 24 body-kit components.
    for(new i = RACE_STO_MAX_VEHICLE_JSON_ID; i >= 0; i--)
    {
        if(RaceStoVehicleIdToModelId[i] == modelid) return i;
    }
    return -1;
}

stock RaceSto_GetVehicleComponents(model, &start, &count)
{
    if(model < 0 || model >= sizeof(RaceStoVehicleComponentOffset))
        return 0;

    start = RaceStoVehicleComponentOffset[model];
    count = RaceStoVehicleComponentCount[model];

    if(start == -1 || count == 0)
        return 0;

    return 1;
}

// ДОБАВЛЕНО: этой функции не хватало в присланном файле — она вызывалась
// в ShowRaceStoGUI, но нигде не была объявлена (гарантированная ошибка
// компиляции "undefined symbol").
stock RaceSto_GetVehicleComponentAt(index)
{
    if(index < 0 || index >= sizeof(RaceStoVehicleComponentList)) return 0;
    return RaceStoVehicleComponentList[index];
}

stock RaceSto_EnsureDatabaseTable()
{
    // Create synchronously: the table must exist before cars and tuning are loaded.
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS `vehicle_store_components` (`vehicleid` INT NOT NULL,`componentid` INT NOT NULL,`state` TINYINT NOT NULL DEFAULT 0,PRIMARY KEY (`vehicleid`,`componentid`)) ENGINE=InnoDB DEFAULT CHARSET=cp1251", false);
    return 1;
}

stock RaceSto_GetSqlId(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID || vehicleid == 0) return 0;
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR) return 0;
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index < 0) return 0;
    return GetOwnableCarData(index, OC_SQL_ID);
}

// ИСПРАВЛЕНО: раньше здесь был самодельный RPC с полями
// (action u8, vehicleid u16, componentid u16), не совпадающий с тем, что
// ждёт клиент. Теперь используется твоя же существующая
// SetVehicleBodyKitsForPlayer на том же RPC 168/подкоде 15.
// type=0 — рабочее предположение (см. предупреждение в шапке файла).
stock RaceSto_SendComponentAction(playerid, vehicleid, action, componentid)
{
    #pragma unused action
    if(!IsPlayerConnected(playerid) || !IsValidVehicle(vehicleid)) return 0;
    SetVehicleBodyKitsForPlayer(playerid, vehicleid, 0, componentid);
    return 1;
}

stock RaceSto_ApplyComponentToStream(vehicleid, itemid, bool:install)
{
    new componentid = RaceSto_GetTuneIdFromItem(itemid);
    if(componentid <= 0) return 0;
    for(new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        if(IsPlayerConnected(playerid) && IsVehicleStreamedIn(vehicleid, playerid))
            RaceSto_SendComponentAction(playerid, vehicleid, install ? 0 : 3, componentid);
    }
    return 1;
}

stock RaceSto_IsItemAvailable(vehicleid, itemid)
{
    new modelid = GetVehicleData(vehicleid, V_MODELID);
    new jsonid = RaceSto_GetVehicleJsonIdFromModel(modelid);
    new start, count;
    if(jsonid < 0 || !RaceSto_GetVehicleComponents(jsonid, start, count)) return 0;
    for(new i = 0; i < count; i++)
        if(RaceStoVehicleComponentList[start + i] == itemid) return 1;
    return 0;
}

stock RaceSto_SyncForPlayer(playerid, vehicleid)
{
    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0 || !IsVehicleStreamedIn(vehicleid, playerid)) return 0;

    new query[180], Cache:result;
    mysql_format(mysql, query, sizeof(query),
        "SELECT `componentid` FROM `vehicle_store_components` WHERE `vehicleid`=%d AND `state`=2",
        sql_id
    );
    result = mysql_query(mysql, query, true);
    new rows = cache_num_rows();
    for(new row = 0; row < rows; row++)
    {
        new itemid = cache_get_field_content_int(row, "componentid");
        new componentid = RaceSto_GetTuneIdFromItem(itemid);
        if(componentid > 0) RaceSto_SendComponentAction(playerid, vehicleid, 0, componentid);
    }
    cache_delete(result);
    return 1;
}

forward RaceSto_DelayedSync(playerid, vehicleid);
public RaceSto_DelayedSync(playerid, vehicleid)
{
    if(IsPlayerConnected(playerid) && IsValidVehicle(vehicleid))
    {
        RaceSto_SyncForPlayer(playerid, vehicleid);
    }
    return 1;
}

stock RaceSto_GetComponentState(vehicleid, itemid)
{
    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0) return -1;

    new query[180], Cache:result, component_state = 0;
    mysql_format(mysql, query, sizeof(query),
        "SELECT `state` FROM `vehicle_store_components` WHERE `vehicleid`=%d AND `componentid`=%d LIMIT 1",
        sql_id, itemid
    );
    result = mysql_query(mysql, query, true);
    if(cache_num_rows() > 0) component_state = cache_get_field_content_int(0, "state");
    cache_delete(result);
    return component_state;
}

// ИСПРАВЛЕНО: раньше стоимость считалась через несуществующую
// GetBodyPaintCost(RaceSto_GetVehiclePriceCompat(vehicleid)). Теперь —
// фиксированная цена RACE_STO_COMPONENT_PRICE (см. шапку файла, настрой
// под свою экономику).
stock RaceSto_BuyComponent(playerid, vehicleid, itemid)
{
    if(RaceSto_GetOwnedVehicleIndexCompat(playerid, vehicleid) == -1) return 0;
    if(!RaceSto_IsItemAvailable(vehicleid, itemid)) return 0;
    new componentid = RaceSto_GetTuneIdFromItem(itemid);
    if(componentid <= 0) return 0;

    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0 || RaceSto_GetComponentState(vehicleid, itemid) == 2) return 0;

    new pay = RACE_STO_COMPONENT_PRICE;
    if(GetPlayerMoneyEx(playerid) < pay) return 0;
    GivePlayerMoneyEx(playerid, -pay, "Установка обвеса на СТО", true, true);

    new query[220];
    mysql_format(mysql, query, sizeof(query),
        "INSERT INTO `vehicle_store_components` (`vehicleid`,`componentid`,`state`) VALUES (%d,%d,2) ON DUPLICATE KEY UPDATE `state`=2",
        sql_id, itemid
    );
    // LAST(3) writes the installed state immediately. A synchronous write also
    // guarantees persistence when the player reconnects right after purchase.
    mysql_query(mysql, query, false);
    RaceSto_ApplyComponentToStream(vehicleid, itemid, true);
    return 1;
}

stock RaceSto_RemoveComponent(playerid, vehicleid, itemid)
{
    if(RaceSto_GetOwnedVehicleIndexCompat(playerid, vehicleid) == -1) return 0;
    if(!RaceSto_IsItemAvailable(vehicleid, itemid)) return 0;
    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0 || RaceSto_GetComponentState(vehicleid, itemid) != 2) return 0;

    new query[180];
    mysql_format(mysql, query, sizeof(query),
        "UPDATE `vehicle_store_components` SET `state`=0 WHERE `vehicleid`=%d AND `componentid`=%d",
        sql_id, itemid
    );
    mysql_query(mysql, query, false);
    RaceSto_ApplyComponentToStream(vehicleid, itemid, false);
    return 1;
}

stock ShowRaceStoGUI(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID || vehicleid == 0)
        return RaceSto_NotifyError(playerid, "Вы должны быть в машине!");
    new index = RaceSto_GetOwnedVehicleIndexCompat(playerid, vehicleid);
    if(index == -1)
        return RaceSto_NotifyError(playerid, "Это не ваш личный транспорт!");

    new modelid = GetVehicleData(vehicleid, V_MODELID);

    new jsonid = RaceSto_GetVehicleJsonIdFromModel(modelid);
    new start, count;

    new sql_id = RaceSto_GetSqlId(vehicleid);
    if(sql_id <= 0) return RaceSto_NotifyError(playerid, "Ошибка: у машины нет ID в базе данных.");

    new query[220], Cache:result;
    mysql_format(mysql, query, sizeof(query),
        "SELECT `componentid`,`state` FROM `vehicle_store_components` WHERE `vehicleid`=%d",
        sql_id
    );
    result = mysql_query(mysql, query, true);
    new rows = cache_num_rows();

    new Node:tuning_json = JSON_Object();
    new Node:component_array = JSON_Array();
    new Node:detail_array = JSON_Array();

    for(new x = 0; x < count; x++)
    {
        new itemid = RaceSto_GetVehicleComponentAt(start + x);
        new component_state = 0, found = 0;
        for(new row = 0; row < rows; row++)
        {
            if(cache_get_field_content_int(row, "componentid") == itemid)
            {
                component_state = cache_get_field_content_int(row, "state");
                found = 1;
                break;
            }
        }
        component_array = JSON_Append(component_array, JSON_Array(JSON_Int(itemid)));
        component_array = JSON_Append(component_array, JSON_Array(JSON_Int(component_state)));
        if(!found)
        {
            mysql_format(mysql, query, sizeof(query),
                "INSERT IGNORE INTO `vehicle_store_components` (`vehicleid`,`componentid`,`state`) VALUES (%d,%d,0)",
                sql_id, itemid
            );
            mysql_query(mysql, query, false);
        }
    }
    cache_delete(result);

    for(new i = 0; i < 7; i++)
        detail_array = JSON_Append(detail_array, JSON_Array(JSON_Int(100)));

    new name[64];
    GetVehicleModelName(modelid, name, sizeof(name));

    JSON_SetInt(tuning_json, "o", 1);
    JSON_SetInt(tuning_json, "w", 1);
    JSON_SetInt(tuning_json, "s", 5);
    JSON_SetInt(tuning_json, "j", RaceSto_GetVehiclePriceCompat(vehicleid));
    JSON_SetString(tuning_json, "nm", GetPlayerNameEx(playerid));
    JSON_SetString(tuning_json, "n", name);
    JSON_SetInt(tuning_json, "m", GetPlayerMoneyEx(playerid));
    JSON_SetArray(tuning_json, "d", detail_array);
    JSON_SetArray(tuning_json, "k", component_array);

    new bool:already_inside = (RaceStyleCenterType[playerid] == 1 && RaceStyleReturnSaved[playerid]);
    InStailing[playerid] = false;

    if(!already_inside)
    {
        RaceSto_SaveReturnCompat(playerid, vehicleid);
        RaceStyleCenterType[playerid] = 1;

        new vw = vehicleid;
        SetPlayerVirtualWorld(playerid, vw);
        SetVehicleVirtualWorld(vehicleid, vw);
        LinkVehicleToInterior(vehicleid, 1);
        SetPlayerInterior(playerid, 1);
        RaceSto_SetOccupantsEnvironmentCompat(vehicleid, vw, 1);
        SetVehiclePos(vehicleid, 2508.3931, 1504.2278, 1497.5000);
        SetVehicleZAngle(vehicleid, 0.0);
        PutPlayerInVehicle(playerid, vehicleid, 0);
    }

    SetPVarInt(playerid, "RaceStoSession", 1);
    TogglePlayerControllable(playerid, false);
    RaceSto_SyncForPlayer(playerid, vehicleid);
    SetTimerEx("RaceSto_DelayedSync", 700, false, "dd", playerid, vehicleid);
    SetPlayerCameraPos(playerid, 2501.2969, 1511.0194, 1500.2665);
    SetPlayerCameraLookAt(playerid, 2502.0427, 1510.3536, 1500.0214);

    ShowPlayerGUI(playerid, 28, tuning_json);
    JSON_Cleanup(tuning_json);
    return 1;
}

stock bool:RaceSto_TryPurchase(playerid, vehicleid, itemid)
{
    if(RaceSto_GetComponentState(vehicleid, itemid) == 2)
        return RaceSto_RemoveComponent(playerid, vehicleid, itemid);
    return RaceSto_BuyComponent(playerid, vehicleid, itemid);
}

// Вход по гудку (KEY_HORN) рядом со СТО — вызови RaceSto_TryEnterOnHorn()
// из своего OnPlayerKeyStateChange (см. инструкцию в чате).
#define RACE_STO_ENTER_RADIUS (7.0)

// Фиксированная точка выезда со СТО (выездные ворота), а не позиция до
// входа — так машина всегда появляется в одном и том же известном месте.
#define RACE_STO_EXIT_X         (1855.477050)
#define RACE_STO_EXIT_Y         (-124.081649)
#define RACE_STO_EXIT_Z         (15.735312)
#define RACE_STO_EXIT_ANGLE     (107.083328)
#define RACE_STO_EXIT_INTERIOR  (0)
#define RACE_STO_EXIT_WORLD     (0)

// Возвращает игрока и машину из СТО на фиксированную точку выезда. Без этой
// функции машина навсегда оставалась в изолированном virtual_world (равном
// vehicleid) и interior 1 — именно поэтому машины "пропадали" на СТО: они
// физически никуда не девались, но вернуться оттуда было нечем.
stock RaceSto_ExitCompat(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(RaceStyleCenterType[playerid] != 1 || !RaceStyleReturnSaved[playerid]) return 0;

    new vehicleid = RaceStyleReturnVehicle[playerid];
    new vw = RACE_STO_EXIT_WORLD;
    new interiorid = RACE_STO_EXIT_INTERIOR;

    if(IsValidVehicle(vehicleid))
    {
        SetVehicleVirtualWorld(vehicleid, vw);
        LinkVehicleToInterior(vehicleid, interiorid);
        SetVehiclePos(vehicleid, RACE_STO_EXIT_X, RACE_STO_EXIT_Y, RACE_STO_EXIT_Z);
        SetVehicleZAngle(vehicleid, RACE_STO_EXIT_ANGLE);
        RaceSto_SetOccupantsEnvironmentCompat(vehicleid, vw, interiorid);
    }

    SetPlayerVirtualWorld(playerid, vw);
    SetPlayerInterior(playerid, interiorid);

    if(IsValidVehicle(vehicleid) && GetPlayerVehicleID(playerid) != vehicleid)
    {
        PutPlayerInVehicle(playerid, vehicleid, 0);
    }
    else
    {
        SetPlayerPos(playerid, RACE_STO_EXIT_X, RACE_STO_EXIT_Y, RACE_STO_EXIT_Z);
        SetPlayerFacingAngle(playerid, RACE_STO_EXIT_ANGLE);
    }

    TogglePlayerControllable(playerid, true);
    // ДОБАВЛЕНО: у твоего CloseTuningGUI (для стайлинга/теха) выход из
    // экрана также восстанавливает камеру и HUD — раньше здесь этого не
    // было, и после выхода со СТО у игрока могла остаться "outside HUD"
    // камера тюнинга.
    SetCameraBehindPlayer(playerid);
    ShowHud(playerid);
    DeletePVar(playerid, "RaceStoSession");
    InStailing[playerid] = false;
    RaceStyleCenterType[playerid] = 0;
    RaceStyleReturnSaved[playerid] = false;
    RaceStyleReturnVehicle[playerid] = INVALID_VEHICLE_ID;

    return 1;
}

stock RaceSto_TryEnterOnHorn(playerid)
{
    // Если игрок уже внутри СТО — второй гудок выходит обратно, чтобы
    // машина не оставалась заперта в техническом virtual_world навеки.
    if(RaceStyleCenterType[playerid] == 1 && RaceStyleReturnSaved[playerid])
    {
        return RaceSto_ExitCompat(playerid);
    }

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 0;

    if(IsPlayerInRangeOfPoint(playerid, RACE_STO_ENTER_RADIUS, 1869.313354, -118.503799, 15.751611))
    {
        ShowRaceStoGUI(playerid);
        return 1;
    }
    return 0;
}

// Страховка: если игрок отключился (вылет, закрытие игры и т.д.), пока
// находился внутри СТО, возвращаем его машину на место ДО disconnect'а,
// иначе она так и останется в изолированном virtual_world навсегда.
stock RaceSto_OnDisconnectCompat(playerid)
{
    if(RaceStyleCenterType[playerid] == 1 && RaceStyleReturnSaved[playerid])
    {
        RaceSto_ExitCompat(playerid);
    }
    return 1;
}

CMD:stocar(playerid)
{
    ShowRaceStoGUI(playerid);
    return 1;
}