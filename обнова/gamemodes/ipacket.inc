                    ShowNotificationNew(playerid, 3, 6, 0, 0, "Неверный ID компонента для детали!", "OK");
                    JSON_SetInt(json_packet_data, "t", type);
                    JSON_SetInt(json_packet_data, "s", 0);
                    JSON_SetString(json_packet_data, "m", "Неверный ID компонента!");
                }
            }
            else
            {
                printf("[DEBUG] Игрок %d не находится в транспорте", playerid);
                ShowNotificationNew(playerid, 3, 6, 0, 0, "Вы должны быть в транспорте!", "OK");
                JSON_SetInt(json_packet_data, "t", type);
                JSON_SetInt(json_packet_data, "s", 0);
                JSON_SetString(json_packet_data, "m", "Вы должны быть в транспорте!");
            }
        }

        case 11: // OPERATION_BUY_DIFFERENTIAL
        {
            new differential_price = (price > 0) ? price : 6000; // Default price for differential if not specified in JSON
            new differential_type = data_value; // Use data_value directly as type
            new differential_name[] = "Дифференциал";
            
            printf("[DEBUG] Попытка покупки дифференциала (тип: %d, %s) для игрока %d", differential_type, differential_name, playerid);

            if(IsPlayerInAnyVehicle(playerid))
            {
                new vehicleid = GetPlayerVehicleID(playerid);
                
                if(data_value == 3) // Differential
                {
                    if(currency_type == 0) // Оплата рублями
                    {
                        if(GetPlayerMoney(playerid) >= differential_price)
                        {
                            GivePlayerMoney(playerid, -differential_price);
                            vInfo[vehicleid][vDifferential] = differential_type; // Store differential type
                            format(caption, sizeof(caption), "%s установлен за %d рублей!", differential_name, differential_price);
                            ShowNotificationNew(playerid, 2, 6, 0, 0, caption, "OK");
                            printf("[DEBUG] Дифференциал (тип: %d, %s) установлен для игрока %d за %d рублей", differential_type, differential_name, playerid, differential_price);

                            // Save to database (adjust to your system)
                            /*
                            format(query, sizeof(query), "UPDATE vehicles SET differential_type = %d WHERE vehicleid = %d", differential_type, vehicleid);
                            mysql_tquery(mysql, query, "", "");
                            */

                            JSON_SetInt(json_packet_data, "t", type);
                            JSON_SetInt(json_packet_data, "s", 1); // Success
                            JSON_SetInt(json_packet_data, "d", data_value);
                            JSON_SetInt(json_packet_data, "r", GetPlayerMoney(playerid));
                        }
                        else
                        {
                            printf("[DEBUG] Недостаточно рублей для покупки дифференциала (игрок: %d)", playerid);
                            ShowNotificationNew(playerid, 3, 6, 0, 0, "Недостаточно рублей для покупки!", "OK");
                            JSON_SetInt(json_packet_data, "t", type);
                            JSON_SetInt(json_packet_data, "s", 0);
                            JSON_SetString(json_packet_data, "m", "Недостаточно рублей!");
                        }
                    }
                    else if(currency_type == 1) // Оплата донат-рублями
                    {
                        if(GetPlayerDonateRub(playerid) >= differential_price)
                        {
                            GivePlayerDonateRub(playerid, -differential_price);
                            vInfo[vehicleid][vDifferential] = differential_type;
                            format(caption, sizeof(caption), "%s установлен за %d донат-рублей!", differential_name, differential_price);
                            ShowNotificationNew(playerid, 2, 6, 0, 0, caption, "OK");
                            printf("[DEBUG] Дифференциал (тип: %d, %s) установлен для игрока %d за %d донат-рублей", differential_type, differential_name, playerid, differential_price);

                            // Save to database
                            /*
                            format(query, sizeof(query), "UPDATE vehicles SET differential_type = %d WHERE vehicleid = %d", differential_type, vehicleid);
                            mysql_tquery(mysql, query, "", "");
                            */

                            JSON_SetInt(json_packet_data, "t", type);
                            JSON_SetInt(json_packet_data, "s", 1); // Success
                            JSON_SetInt(json_packet_data, "d", data_value);
                            JSON_SetInt(json_packet_data, "d", GetPlayerDonateRub(playerid));
                        }
                        else
                        {
                            printf("[DEBUG] Недостаточно донат-рублей для покупки дифференциала (игрок: %d)", playerid);
                            ShowNotificationNew(playerid, 3, 6, 0, 0, "Недостаточно донат-рублей для покупки!", "OK");
                            JSON_SetInt(json_packet_data, "t", type);
                            JSON_SetInt(json_packet_data, "s", 0);
                            JSON_SetString(json_packet_data, "m", "Недостаточно донат-рублей!");
                        }
                    }
                    else
                    {
                        printf("[DEBUG] Неверный тип валюты (currency_type: %d) для игрока %d", currency_type, playerid);
                        ShowNotificationNew(playerid, 3, 6, 0, 0, "Неверный тип валюты!", "OK");
                        JSON_SetInt(json_packet_data, "t", type);
                        JSON_SetInt(json_packet_data, "s", 0);
                        JSON_SetString(json_packet_data, "m", "Неверный тип валюты!");
                    }
                }
                else
                {
                    printf("[DEBUG] Неверный data_value для дифференциала (%d) для игрока %d", data_value, playerid);
                    ShowNotificationNew(playerid, 3, 6, 0, 0, "Неверный ID дифференциала!", "OK");
                    JSON_SetInt(json_packet_data, "t", type);
                    JSON_SetInt(json_packet_data, "s", 0);
                    JSON_SetString(json_packet_data, "m", "Неверный ID дифференциала!");
                }
            }
            else
            {
                printf("[DEBUG] Игрок %d не находится в транспорте", playerid);
                ShowNotificationNew(playerid, 3, 6, 0, 0, "Вы должны быть в транспорте!", "OK");
                JSON_SetInt(json_packet_data, "t", type);
                JSON_SetInt(json_packet_data, "s", 0);
                JSON_SetString(json_packet_data, "m", "Вы должны быть в транспорте!");
            }
        }

        case 26:
        {
            printf("Винил %s выбран", vinyl);
            ShowNotificationNew(playerid, 2, 6, 0, 0, "Винил успешно выбран!", "OK");
            JSON_SetInt(json_packet_data, "t", type);
            JSON_SetString(json_packet_data, "v", vinyl);
        }
    }

    OnPacketIncoming(playerid, 28, json_packet_data);
    JSON_Cleanup(json_packet_data, true);
}

        default:
        {
            // Очистка по умолчанию (как в примере), плюс логика для Case модели
            JSON_Cleanup(JSONObject);
            JSON_Cleanup(json);
            JSON_Cleanup(json_packet_data);
        }
    }
}
