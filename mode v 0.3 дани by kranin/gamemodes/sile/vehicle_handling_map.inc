stock GetVehicleHandlingByModelId(modelid, &speed, &Float:acceleration, &fuel, &license, &weight, &class_id, &epp, handlingStock[2], handlingComfort[2], handlingSport[2], handlingDrift[2], handlingSportPlus[2])
{
    for(new i = 0; i < sizeof(g_vehicle_handling); i++)
    {
        if(g_vehicle_handling[i][VH_MODELID] == modelid)
        {
            speed = g_vehicle_handling[i][VH_SPEED];
            acceleration = g_vehicle_handling[i][VH_ACCELERATION];
            fuel = g_vehicle_handling[i][VH_FUEL];
            license = g_vehicle_handling[i][VH_LICENSE];
            weight = g_vehicle_handling[i][VH_WEIGHT];
            class_id = g_vehicle_handling[i][VH_CLASS];
            epp = g_vehicle_handling[i][VH_EPP];
            
            handlingStock[0] = g_vehicle_handling[i][VH_HANDLING_STOCK][0];
            handlingStock[1] = g_vehicle_handling[i][VH_HANDLING_STOCK][1];
            handlingComfort[0] = g_vehicle_handling[i][VH_HANDLING_COMFORT][0];
            handlingComfort[1] = g_vehicle_handling[i][VH_HANDLING_COMFORT][1];
            handlingSport[0] = g_vehicle_handling[i][VH_HANDLING_SPORT][0];
            handlingSport[1] = g_vehicle_handling[i][VH_HANDLING_SPORT][1];
            handlingDrift[0] = g_vehicle_handling[i][VH_HANDLING_DRIFT][0];
            handlingDrift[1] = g_vehicle_handling[i][VH_HANDLING_DRIFT][1];
            handlingSportPlus[0] = g_vehicle_handling[i][VH_HANDLING_SPORTPLUS][0];
            handlingSportPlus[1] = g_vehicle_handling[i][VH_HANDLING_SPORTPLUS][1];
            
            return true;
        }
    }
    
    return false;
}

