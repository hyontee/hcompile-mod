stock bool:GetVehicleJsonCostByModelId(modelid, &cost)
{
    for(new i = 0; i < sizeof(g_json_vehicle_prices); i++)
    {
        if(g_json_vehicle_prices[i][JVP_MODELID] == modelid)
        {
            cost = g_json_vehicle_prices[i][JVP_COST];
            return true;
        }
    }

    return false;
}
