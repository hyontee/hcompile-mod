stock RespawnVehicleNow(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return;

    SetVehiclePos(vehicleid, VehicleSpawnPosX[vehicleid], VehicleSpawnPosY[vehicleid], VehicleSpawnPosZ[vehicleid]);
    SetVehicleAngle(vehicleid, VehicleSpawnAngle[vehicleid]);
    SetVehicleVirtualWorld(vehicleid, VehicleVirtualWorld[vehicleid]);
    LinkVehicleToInterior(vehicleid, VehicleInterior[vehicleid]);
    SetVehicleEngineState(vehicleid, false);
    SetVehicleVelocity(vehicleid, 0.0, 0.0, 0.0);
}
