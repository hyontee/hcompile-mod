stock LoadMarket(playerid,type,show=0) {
    STRING_GLOBAL[0] = EOS;
    for(new i=0,j=sizeof(Lavka:list);i<j;i++) {
        printf("%d | %d | %d",type,i,Lavka:list[i][LAV_TYPE]);
        if(Lavka:list[i][LAV_TYPE] != type) continue;
        format(STRING_GLOBAL,sizeof STRING_GLOBAL,"%s[\"%s\",\"%s\",%d,%d],",STRING_GLOBAL,Lavka:list[i][LAV_ICON],Lavka:list[i][LAV_NAME],Lavka:list[i][LAV_PRICE],i);
    }
    new str_len = strlen(STRING_GLOBAL);
    strdel(STRING_GLOBAL,str_len-1,str_len);
    if(show==1) {
        format(STRING_GLOBAL,sizeof STRING_GLOBAL,"[\"Магазин\",[\"Аксессуары\",\"Скины\",\"Аксессуары на Т/С\", \"Автомобили\", \"Кейсы\", \"Предметы\"], [%s]]",STRING_GLOBAL);
        MoralPacket_2(playerid, s_CefInterface, t_CefShow, "ItemStore", STRING_GLOBAL);
    }
    else {
        format(STRING_GLOBAL, sizeof STRING_GLOBAL, "interface('ItemStore').setItems('[%s]')", STRING_GLOBAL);
        MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, STRING_GLOBAL);
    }
    return 1;
}
public: ItemStoreMenu_OnCategory(playerid,event) return LoadMarket(playerid,Lavka:pages[event]);
public: ItemStoreMenu_OnBuy(playerid, event) {
    if(!(0 <= event <= sizeof(Lavka:list))) return 1;
	if(GetPlayerCoins(playerid) < Lavka:list[event][LAV_PRICE]) {
        GameText(playerid,"~r~НЕДОСТАТОЧНО "SERVER_COINS_NAME"",5000,2);
    }
    else {
        GameText(playerid,"~g~УСПЕШНО",5000,2);
        GivePlayerCoins(playerid, -Lavka:list[event][LAV_PRICE]);
        if(Lavka:list[event][LAV_TYPE] == 2) GiveSkin(playerid, Lavka:list[event][LAV_ACSID]);
        if(Lavka:list[event][LAV_TYPE] == 3 || Lavka:list[event][LAV_TYPE] == 4) GiveAcs(playerid, Lavka:list[event][LAV_ACSID], Lavka:list[event][LAV_INDEX]);
		if(Lavka:list[event][LAV_TYPE] == 5) GiveCar(playerid, Lavka:list[event][LAV_ACSID], 1, 1, -1, -1, 110.8994, 322.3508, 11.2202, 251.4996, 0, 0, 0.0);
		if(Lavka:list[event][LAV_TYPE] == 1) GiveIteam(playerid, Lavka:list[event][LAV_ACSID], 1, 20, 0);
		if(Lavka:list[event][LAV_TYPE] == 6) GiveIteam(playerid, Lavka:list[event][LAV_ACSID], 1, 10, 0);
	}
    ItemStoreMenu_OnClose(playerid);
    return 1;
}
stock ItemStoreMenu_OnClose(playerid) return MoralPacket_1(playerid,s_CefInterface, t_CefHide,"ItemStore");
public: BS_OnPlayerBuyItem(playerid,index) {
    new listid = -1;
    for(new i,j=sizeof(Lavka:list);i<j;i++) {
        if(Lavka:list[i][LAV_ID] != index) continue;
        listid = i;
        break;
    }
    if(GetPlayerCoins(playerid) < Lavka:list[listid][LAV_PRICE]) {
        GameText(playerid,"~r~НЕДОСТАТОЧНО "SERVER_COINS_NAME"",5000,2);
    }
    else {
        GameText(playerid,"~g~УСПЕШНО",5000,2);
        GivePlayerCoins(playerid, -Lavka:list[listid][LAV_PRICE]);
        if(Lavka:list[listid][LAV_TYPE] == 2) GiveSkin(playerid, Lavka:list[listid][LAV_ACSID]);
        if(Lavka:list[listid][LAV_TYPE] == 3) GiveAcs(playerid, Lavka:list[listid][LAV_ACSID], Lavka:list[listid][LAV_INDEX]);
	}
    BS_OnCloseInterface(playerid);
    return 1;
}
stock Business_OnPlayerEnter(playerid)
{
	new businessid = GetNearestBusiness(playerid, 5.0);
	if(businessid != -1) EnterPlayerToBiz(playerid, businessid);
}
stock GetCountFracMembersOnline(f_id)
{
	static query[80],
		Cache: result;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM PlayersMorallwens WHERE team=%d AND online=1", f_id);
	result = mysql_query(mysql, query, true);

	new rows = cache_num_rows();

	cache_delete(result);

	return rows;
}
stock GetCountFracMembers(f_id)
{
	static query[80],
		Cache: result;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM PlayersMorallwens WHERE team=%d", f_id);
	result = mysql_query(mysql, query, true);

	new rows = cache_num_rows();

	cache_delete(result);

	return rows;
}
stock SendClientEvent(playerid, CefType:type, string[])
{
    new
    BitStream:bsn = BS_New();

    BS_WriteValue(bsn, PR_UINT8, ID_CEF_RPC);
    BS_WriteValue(bsn, PR_UINT16, 2);
  	BS_WriteValue(bsn, PR_UINT32, _:type);
 	BS_WriteValue(bsn, PR_UINT8, 1);
  	BS_WriteValue(
    bsn,
    PR_UINT32, strlen(string),
    PR_STRING, string, strlen(string)
  	);

    PR_SendPacket(bsn, playerid);
    BS_Delete(bsn);
  	return true;
}

stock Music_Start(playerid,type,name[],index,volume)
{
    #pragma unused index
    new vehicleid = GetPlayerVehicleID(playerid);
    switch(type)
    {
        case 0:
        {
			SendClientEventF(playerid,s_CefInterface,t_CefUpdate, "interface('Music').srv_onReceiveData([[[\"%s\",173]],[],0,0,0,%d],0)",name,g_subwoofer[vehicleid][E_VOLUME]);
            format(g_subwoofer[vehicleid][E_NAME],64, "%s",name);
            string_replace(name," ","%20",_,true);
            new Float:x,Float:y,Float:z;
            g_subwoofer[vehicleid][E_MUSIC_START] = true;
            GetVehiclePos(vehicleid,x,y,z);
            foreach(new i : Player)
                SendClientEventF(i, s_CefInterface, t_CefUpdate, "window.createSound3D(%d, 'https://music.radmir.online/audio/%s.mp3', %.2f, %.2f, %.2f, 0.50, 7.00, 30.00, true, false) || window.setSound3DPosition(10009, 0.000000) || window.attachSoundToVehicle(%d, %d, 0.00, 0.00, 0.00, 0.00)",vehicleid,name,x,y,z,vehicleid,vehicleid);
        }
        case 1:
        {
            g_subwoofer[vehicleid][E_MUSIC_START] = false;
            MoralPacket_1(playerid,s_CefInterface,t_CefUpdate, "interface('Music').srv_onReceiveData([[],[],0,0,0,50],0)");
            SendClientEventF(playerid,s_CefInterface,t_CefUpdate,"window.destroySound(%d,30)",vehicleid);
        }
        case 7:
        {
            g_subwoofer[vehicleid][E_VOLUME] = volume;
            SendClientEventF(playerid,s_CefInterface,t_CefUpdate,"interface('Music').srv_onReceiveData(%d,2)",volume);
            SendClientEventF(playerid,s_CefInterface,t_CefUpdate, "window.soundSlideAttribute(%d, 2, %.2f, 200)",vehicleid,float(volume)/100);
        }
    }
}
public:MusicCarPlayer(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SCM(playerid, 0xFF6600FF, "Вы должны находиться в автомобиле");
    new vehicleid = GetPlayerVehicleID(playerid);
    if(g_subwoofer[vehicleid][E_MUSIC_START] == false)
        MoralPacket_2(playerid, s_CefInterface, t_CefShow, "Music", "[\"https://music.radmir.online/\",[[],[],0,0,0,50]]");
    else
        SendClientEventWithArgF(playerid, s_CefInterface, t_CefShow, "Music", "[\"https://music.radmir.online/\",[[[\"%s\",180]],[],0,0,0,%d]]",g_subwoofer[vehicleid][E_NAME],g_subwoofer[vehicleid][E_VOLUME]);
    return true;
}

string_replace(inputvar[], const searchstring[], const replacestring[],
                bool:ignorecase=true, bool:replaceall=false)
{
    if (strfind(replacestring, searchstring, ignorecase) != -1)
        return -1;
    new pos = strfind(inputvar, searchstring, ignorecase);
    if (pos == -1)
        return 0;
    if (replaceall == true)
    {
        while (strfind(inputvar, searchstring, ignorecase) != -1)
        {
            pos = strfind(inputvar, searchstring, ignorecase);
            strdel(inputvar, pos, pos + strlen(searchstring));
            strins(inputvar, replacestring, pos, strlen(inputvar));
        }
    }
    else
    {
        strdel(inputvar, pos, pos + strlen(searchstring));
        strins(inputvar, replacestring, pos, strlen(inputvar));
    }
    return 1;
}

stock SendClientEventWithArg(playerid, CefType:type, string[], string1[])
{
    new
    BitStream:bsn = BS_New();

    BS_WriteValue(bsn, PR_UINT8, ID_CEF_RPC);
    BS_WriteValue(bsn, PR_UINT16, 2);
  	BS_WriteValue(bsn, PR_UINT32, _:type);
  	BS_WriteValue(bsn, PR_UINT8, 2);
  	BS_WriteValue(
    bsn,
    PR_UINT32, strlen(string),
    PR_STRING, string, strlen(string)
  	);
  	BS_WriteValue(
    bsn,
    PR_UINT32, strlen(string1),
    PR_STRING, string1, strlen(string1)
  	);

    PR_SendPacket(bsn, playerid);
    BS_Delete(bsn);
}
