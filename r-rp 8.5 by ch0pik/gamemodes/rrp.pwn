		static query[250];
		mysql_format(mysql, query, sizeof query, "UPDATE family SET NorthMansion=1 WHERE id=%d LIMIT 1", fam_id);
		mysql_query(mysql, query, false);

		NorthMansionCapture = false;
		ActiveWar = false;

		HackerID3 = INVALID_PLAYER_ID;

		MansionOwner();

		foreach(new i:Player)
        {
	        STRING_GLOBAL[0] = EOS;
		    format(STRING_GLOBAL, 150, "[\"`Японский особняк` окончена. Теперь он под контролем:\", \"%s\", 5000]", GetFamilyData(fam_id, F_NAME));
		    MoralPacket_2(i, s_CefInterface, t_CefShow, "BattleMansionEnd", STRING_GLOBAL);
	    }
	}
	if(PelaBaseCapture == true)
    {
		DellMansionOwner();

	    format(fmt_text, sizeof fmt_text, "Группировка {FFDD00}\"%s\" {ffffff}успешно захватывает {ff6666}\"База Пела\"", GetFamilyData(fam_id, F_NAME));
		SendClientMessageToAll(-1, fmt_text);

