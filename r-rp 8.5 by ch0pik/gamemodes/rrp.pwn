stock Jail_OnSecondTimer()
{
    for(new i; i < sizeof(Toilet_Positions); i++)
    {
        if(ToiletStatus[i][0] == 1)
        {
            ToiletStatus[i][1]--;

            if(ToiletStatus[i][1] == 0) ToiletStatus[i][0] = 0;
        }
    }
}
stock JailUseDoor(playerid, type)
{
    if(type == 0)
    {
        for(new i; i <  sizeof(J_IntDoors); i++)
        {
            if(IsPlayerInRangeOfPoint(playerid, 2.0, J_IntDoors[i][J_PosX], J_IntDoors[i][J_POS_Y], J_IntDoors[i][J_POS_Z]))
            {
                STRING_GLOBAL[0] = EOS;

                if(J_IntDoors[i][J_Status] == true)
                {
                    MoveDynamicObject(J_IntDoors[i][J_ObjID], J_IntDoors[i][J_PosX], J_IntDoors[i][J_POS_Y], J_IntDoors[i][J_POS_Z] + 0.05, 0.05, 0.0, 0.0, J_IntDoors[i][J_POS_RZ]);
                    J_IntDoors[i][J_Status] = false;

                    if(J_IntDoors[i][J_ModelID] != 17134) format(STRING_GLOBAL, sizeof STRING_GLOBAL, "закрыл(а) дверь");
                    else format(STRING_GLOBAL, sizeof STRING_GLOBAL, "закрыл(а) дверь клетки");

                    return Action(playerid, STRING_GLOBAL);
                }
                if(J_IntDoors[i][J_Status] == false)
                {
                    MoveDynamicObject(J_IntDoors[i][J_ObjID], J_IntDoors[i][J_PosX], J_IntDoors[i][J_POS_Y], J_IntDoors[i][J_POS_Z], 0.05, 0.0, 0.0, J_IntDoors[i][J_POS_RZ] - 150.0);
                    J_IntDoors[i][J_Status] = true;

                    if(J_IntDoors[i][J_ModelID] != 17134) format(STRING_GLOBAL, sizeof STRING_GLOBAL, "открыл(а) дверь");
                    else format(STRING_GLOBAL, sizeof STRING_GLOBAL, "открыл(а) дверь клетки");

                    return Action(playerid, STRING_GLOBAL);
                }
            }
        }
    }
    if(type == 1)
    {
        for(new i; i <  sizeof(J_WorldDoors); i++)
        {
            if(IsPlayerInRangeOfPoint(playerid, 10.0, J_WorldDoors[i][J_PosX], J_WorldDoors[i][J_POS_Y], J_WorldDoors[i][J_POS_Z]))
            {
                switch(J_WorldDoors[i][J_Status])
                {
                    case true:
                    {
                        MoveDynamicObject(J_WorldDoors[i][J_ObjID], J_WorldDoors[i][J_PosX], J_WorldDoors[i][J_POS_Y], J_WorldDoors[i][J_POS_Z] + 0.05, 0.05, 0.0, 0.0, J_WorldDoors[i][J_POS_RZ]);
                        J_WorldDoors[i][J_Status] = false;
                    }
                    case false:
                    {
                        MoveDynamicObject(J_WorldDoors[i][J_ObjID], J_WorldDoors[i][J_PosX], J_WorldDoors[i][J_POS_Y], J_WorldDoors[i][J_POS_Z], 0.05, 0.0, 0.0, J_WorldDoors[i][J_POS_RZ] + 90.0);
                        J_WorldDoors[i][J_Status] = true;
                    }
                }
            }
        }
		for(new i; i <  sizeof(J_WorldDoor_2); i++)
        {
            if(IsPlayerInRangeOfPoint(playerid, 15.0, J_WorldDoor_2[i][J_PosX], J_WorldDoor_2[i][J_POS_Y], J_WorldDoor_2[i][J_POS_Z]))
            {
                switch(J_WorldDoor_2[i][J_Status])
                {
                    case true:
                    {
                        MoveDynamicObject(J_WorldDoor_2[i][J_ObjID], J_WorldDoor_2[i][J_PosX], J_WorldDoor_2[i][J_POS_Y], J_WorldDoor_2[i][J_POS_Z] + 0.05, 0.05, 0.0, 0.0, J_WorldDoor_2[i][J_POS_RZ]);
                        J_WorldDoor_2[i][J_Status] = false;
                    }
                    case false:
                    {
                        MoveDynamicObject(J_WorldDoor_2[i][J_ObjID], J_WorldDoor_2[i][J_PosX], J_WorldDoor_2[i][J_POS_Y], J_WorldDoor_2[i][J_POS_Z], 0.05, 0.0, 0.0, J_WorldDoor_2[i][J_POS_RZ] - 90.0);
                        J_WorldDoor_2[i][J_Status] = true;
                    }
                }
            }
        }
    }
    return 1;
}
enum E_JAIL_CAM_STRUCT
{
    J_CAM_NAME[32],
    Float: J_CAM_POS_X,
    Float: J_CAM_POS_Y,
    Float: J_CAM_POS_Z,
    Float: J_CAM_LOOK_X,
    Float: J_CAM_LOOK_Y,
    Float: J_CAM_LOOK_Z,

}

new JailCamera[][E_JAIL_CAM_STRUCT] =
{
    {"Главный Вход", 2338.8494,-1741.0640,1008.0981},
    {"Коридор 1", 2332.5134,-1769.4998,1008.9316, 2327.5615,-1746.6108,1008.9163},
    {"Коридор 2", 2342.1409,-1777.3671,1008.5259},
    {"Раздевалка", 2317.8887,-1765.8091,1007.5259, 2326.9395,-1770.6605,1007.8438}
};
stock ShowCamera(playerid)
{
    UpdateJCamera(playerid, 0);

    SendClientEventWithArg(playerid, t_CefShow, "JailCamera", "[[0, \"Камеры ФСБ\"], [\"Главный Вход\", \"Коридор 1\", \"Коридор 2\", \"Раздевалка\"]]");
}
stock UpdateJCamera(playerid, camID)
{
    SetPlayerCameraPos(playerid, JailCamera[camID][J_CAM_POS_X], JailCamera[camID][J_CAM_POS_Y], JailCamera[camID][J_CAM_POS_Z]);
    SetPlayerCameraLookAt(playerid, JailCamera[camID][J_CAM_LOOK_X], JailCamera[camID][J_CAM_LOOK_Y], JailCamera[camID][J_CAM_LOOK_Z]);
    MoralPacket_2(playerid, s_CefInterface, t_CefUpdate, "interface('JailCamera').setCurrentCamera('[0, \"Фсб\"]')", JailCamera[camID][J_CAM_NAME]);

    return 1;
}
public: JailCamera_OnCameraChange(playerid, cameraID) UpdateJCamera(playerid, cameraID);
public: JailCamera_OnPlayerClose(playerid) SetCameraBehindPlayer(playerid);
forward Rub_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]);
public Rub_OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    switch(dialogid)
    {
        case DIALOG_RUB_MAIN:
		{
		    if (!response) return 1;

		    string_mrllwns[0] = EOS;

		    format(string_mrllwns, sizeof(string_mrllwns),
		        "Категория\t\n\
		{FFFFFF}Персонаж ({"SERVER_COLOR"}улучшение)\t\n\
		{FFFFFF}Игровые привилегии ({"SERVER_COLOR"}Admin, VIP)\t\n\
		{FFFFFF}Транспорт ({"SERVER_COLOR"}Покупка и Улучшение)\t\n\
		{FFFFFF}Остальное ({"SERVER_COLOR"}Остальные услуги)\t\n\
		{FFFFFF}Пополнить {"SERVER_COLOR"}Donate {FFFFFF}счёт\t"
		    );

		    Dialog(playerid, DIALOG_RUB_CATEGORY, DIALOG_STYLE_TABLIST_HEADERS,
		        "{FFCD00}ВЫБЕРИТЕ КАТЕГОРИЮ",
		        string_mrllwns,
		        "Выбрать", "Закрыть"
		    );
		    return 1;
		}
        case DIALOG_RUB_CATEGORY:
        {
            if (!response) return 1;
            switch (listitem)
            {
                case 0:
                {
                    static str[2048];
                    format(str, sizeof(str),
                        "{FFDA23}Приобрести Donate можно на нашем сайте {"SERVER_COLOR"}" SERVER_SITE "\n\n"\
                        "{"SERVER_COLOR"}1. {FFFFFF}Изменить Имя {"SERVER_COLOR"}(50 Donate)\n"\
                        "{"SERVER_COLOR"}2. {FFFFFF}Снятие Предупреждения {"SERVER_COLOR"}(100 Donate)\n"\
                        "{"SERVER_COLOR"}3. {FFFFFF}Покупка Игрового уровня {"SERVER_COLOR"}(25 Donate)\n"\
                        "{"SERVER_COLOR"}4. {FFFFFF}Покупка Военного Билета {"SERVER_COLOR"}(100 Donate)\n"\
                        "{"SERVER_COLOR"}5. {FFFFFF}Покупка Наколки(Вор в законе) {"SERVER_COLOR"}(250 Donate)\n"\
                        "{"SERVER_COLOR"}6. {FFFFFF}Покупка Навыков на все оружие {"SERVER_COLOR"}(100 Donate)\n"\
                        "{"SERVER_COLOR"}7. {FFFFFF}Покупка Эксклюзивной Сим-Карты {"SERVER_COLOR"}(1000 Donate)\n"\
                        "{"SERVER_COLOR"}8. {FFFFFF}Покупка Скина (id) {"SERVER_COLOR"}(1699 Donate)\n"\
                        "{"SERVER_COLOR"}9. {FFFFFF}Покупка Ценной Бумаги {"SERVER_COLOR"}(500 Donate)\n"\
                        "{"SERVER_COLOR"}10. {FFFFFF}Увеличить слоты транспорта {"SERVER_COLOR"}(300 Donate)\n"\
                        "{"SERVER_COLOR"}11. {FFFFFF}Увеличить слоты дома {"SERVER_COLOR"}(500 Donate)\n"\
                        "{"SERVER_COLOR"}12. {FFFFFF}Увеличить слоты бизнеса {"SERVER_COLOR"}(500 Donate)\n"\
                        "{"SERVER_COLOR"}13. {FFFFFF}Увеличить слоты гаража{"SERVER_COLOR"}(500 Donate)"
                    );
                    Dialog(playerid, DIALOG_RUB_CHARACTER, DIALOG_STYLE_TABLIST_HEADERS,
                        "{FFCD00}МЕНЮ ДОПОЛНИТЕЛЬНЫХ ВОЗМОЖНОСТЕЙ",
                        str,
                        "Выбрать", "Отмена"
                    );
                }
                case 1:
                {
                    static str[2048];
                    format(str, sizeof(str),
                        "{FFDA23}Приобрести Donate можно на нашем сайте {"SERVER_COLOR"}" SERVER_SITE "\n\n"\
                        "{"SERVER_COLOR"}1. {FFFFFF}Покупка {"SERVER_COLOR"}VIP Привелегий {FFFFFF}250 {"SERVER_COLOR"}Donate\n"\
                        "{"SERVER_COLOR"}2. {FFFFFF}Покапка {"SERVER_COLOR"}Админ привелегий {FFFFFF}500 {"SERVER_COLOR"}Donate"
                    );
                    Dialog(playerid, DIALOG_RUB_VIP_MENU, DIALOG_STYLE_TABLIST_HEADERS,
                        "{FFCD00}МЕНЮ ДОПОЛНИТЕЛЬНЫХ ВОЗМОЖНОСТЕЙ",
                        str,
                        "Выбрать", "Отмена"
                    );
                }
                case 2:
                {
                    static str[2048];
                    format(str, sizeof(str),
                        "{FFDA23}Приобрести Donate можно на нашем сайте {"SERVER_COLOR"}" SERVER_SITE "\n\n"\
                        "{FFFFFF}1. Покупка Эксклюзивных номеров {"SERVER_COLOR"}1875 {FFFFFF}Donate\n"\
                        "{FFFFFF}2. Покупка Такси номеров {"SERVER_COLOR"}500 {FFFFFF}Donate\n"\
                        "{FFFFFF}3. Покупка Полицейских номеров {"SERVER_COLOR"}1000 {FFFFFF}Donate\n"\
						"{FFFFFF}4. Покупка автомобиля (id) {"SERVER_COLOR"}1999 {FFFFFF}Donate\n"\
                        "{FFFFFF}5. Покупка Ковша для автомобиля {"SERVER_COLOR"}2500 {FFFFFF}Donate"
                    );
                    Dialog(playerid, DIALOG_RUB_EXTRA_MENU, DIALOG_STYLE_TABLIST_HEADERS,
                        "{FFCD00}МЕНЮ ДОПОЛНИТЕЛЬНЫХ ВОЗМОЖНОСТЕЙ",
                        str,
                        "Выбрать", "Отмена"
                    );
                }
                case 3:
                {
                    static str[2048];
                    format(str, sizeof(str),
                        "{FFDA23}Приобрести RCoins можно на нашем сайте {"SERVER_COLOR"}" SERVER_SITE "\n\n"\
                        "{FFFFFF}1.Охотник \t{"SERVER_COLOR"}500 Donate\n"\
                        "{FFFFFF}2.Тупой\t{"SERVER_COLOR"}800 Donate\n"\
                        "{FFFFFF}3.Мажор\t{"SERVER_COLOR"}700 Donate\n"\
                        "{FFFFFF}4.Бандит\t{"SERVER_COLOR"}1000 Donate"
                    );
                    Dialog(playerid, DIALOG_RUB_PACK, DIALOG_STYLE_TABLIST_HEADERS,
                        "{FFCD00}МЕНЮ ДОПОЛНИТЕЛЬНЫХ ВОЗМОЖНОСТЕЙ",
                        str,
                        "Выбрать", "Отмена"
                    );
                }
                case 4:
                {
                    SCM(playerid, 0xFF0000FF, "Переходи на сайт что-бы пополнить баланс");
                }
            }
        }
        case DIALOG_RUB_PACK:
        {
            if (!response) return 1;
            switch (listitem)
            {
                case 0:
                {
                    if (GetPlayerData(playerid, P_DONATE_CURRENT) < 500) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    GivePlayerDonate(playerid, -500);
                    GiveSkin(playerid, 269);
                    GiveIteam(playerid, 294, 1, 1, 0);
                    SCM(playerid, COLOR_GREEN, "Вы купили набор 'Охотник'!");
					static fmt_text[144];
					format(fmt_text, sizeof fmt_text,
					"Игрок %s[%d] приобрел пак 'Охотник' через /rub",
					GetPlayerNameEx(playerid), playerid
					);
					SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 1:
                {
                    if (GetPlayerData(playerid, P_DONATE_CURRENT) < 800) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    GivePlayerDonate(playerid, -800);
                    GiveSkin(playerid, 15360);
                    GiveCar(playerid, 15696, 1, 1, -1, -1, 1882.5557, 2832.2222, 12.0596, 89.8854, gettime());
                    SCM(playerid, COLOR_GREEN, "Вы купили набор 'Тупой'!");
					static fmt_text[144];
					format(fmt_text, sizeof fmt_text,
					"Игрок %s[%d] приобрел пак 'Тупой' через /rub",
					GetPlayerNameEx(playerid), playerid
					);
					SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 2:
                {
                    if (GetPlayerData(playerid, P_DONATE_CURRENT) < 700) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    GivePlayerDonate(playerid, -700);
                    GiveSkin(playerid, 15535);
                    GiveCar(playerid, 15679, 1, 1, -1, -1, 1882.5557, 2832.2222, 12.0596, 89.8854, gettime());
                    SCM(playerid, COLOR_GREEN, "Вы купили набор 'Мажор'!");
					static fmt_text[144];
					format(fmt_text, sizeof fmt_text,
					"Игрок %s[%d] приобрел пак 'Мажор' через /rub",
					GetPlayerNameEx(playerid), playerid
					);
					SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 3:
                {
                    if (GetPlayerData(playerid, P_DONATE_CURRENT) < 1000) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    GivePlayerDonate(playerid, -1000);
                    GiveSkin(playerid, 15333);
                    GiveCar(playerid, 15678, 1, 1, -1, -1, 1882.5557, 2832.2222, 12.0596, 89.8854, gettime());
                    SCM(playerid, COLOR_GREEN, "Вы купили набор 'Бандит'!");
					static fmt_text[144];
					format(fmt_text, sizeof fmt_text,
					"Игрок %s[%d] приобрел пак 'Бандит' через /rub",
					GetPlayerNameEx(playerid), playerid
					);
					SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                default: return 1;
            }
            UpdatePlayerDatabaseInt(playerid, "donate_current", GetPlayerData(playerid, P_DONATE_CURRENT));
            return 1;
        }
        case DIALOG_RUB_CHARACTER:
        {
            if (!response) return 1;
            new current = GetPlayerData(playerid, P_DONATE_CURRENT);
            new price;
			static fmt_text[150];
            switch (listitem)
            {
                case 0:
                {
                    price = 50;
                    if (GetPlayerData(playerid, P_DONATE_CURRENT) < price)
                        return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    Dialog(playerid, DIALOG_CHANGE_NAMES, DIALOG_STYLE_INPUT,
                        "{FFD83D}Изменение имени",
                        "{FFFFFF}Вы можете изменить имя своего персонажа.\n"\
                        "Формат: Имя_Фамилия (только латиница и '_').\n"\
                        "Пример: Andrey_Kalinin\n\n"\
                        "Введите новое имя:",
                        "Изменить", "Отмена"
                    );
					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел изменение имени через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                    return 1;
                }
                case 1:
                {
                    price = 100;
                    if (current < price)
                        return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    if (GetPlayerData(playerid, P_WARN) == 0)
                        return SCM(playerid, COLOR_RED, "* У вас нет предупреждений.");
                    SetPlayerData(playerid, P_DONATE_CURRENT, current - price);
                    UpdatePlayerDatabaseInt(playerid, "donate_current", current - price);
                    SetPlayerData(playerid, P_WARN, 0);
                    SetPlayerData(playerid, P_WARN_TIME, 0);
                    UpdatePlayerDatabaseInt(playerid, "warn", 0);
                    UpdatePlayerDatabaseInt(playerid, "warn_time", 0);
                    SCM(playerid, -1, "{ffffff}Вы успешно сняли все предупреждения со своего аккаунта");

					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел снятие предупреждений через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 2:
                {
                    price = 25;
                    if (GetPlayerData(playerid, P_DONATE_CURRENT) < price)
                        return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    Dialog(playerid, DIALOG_BUY_LEVEL, DIALOG_STYLE_INPUT,
                        "{FFD83D}Покупка уровня",
                        "{FFFFFF}Цена: {"SERVER_COLOR"}25 Donate {FFFFFF}за 1 уровень.\n"\
                        "Введите желаемый уровень (от 1 до 999):",
                        "Купить", "Отмена"
                    );
					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел уровень через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                    return 1;
                }
                case 3:
                {
                    price = 100;
                    if (current < price) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    SetPlayerData(playerid, P_DONATE_CURRENT, current - price);
                    SetPlayerData(playerid, P_VOEN, 1);
                    UpdatePlayerDatabaseInt(playerid, "donate_current", current - price);
                    UpdatePlayerDatabaseInt(playerid, "voennik", 1);
                    SCM(playerid, -1, "{ffffff}Вы успешно приобрели Военный билет");

					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел Военный билет через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 4:
                {
                    price = 250;
                    if (current < price) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    SetPlayerData(playerid, P_DONATE_CURRENT, current - price);
                    SetPlayerData(playerid, P_NAKOLKA, 9);
                    UpdatePlayerDatabaseInt(playerid, "donate_current", current - price);
                    UpdatePlayerDatabaseInt(playerid, "nakolka", 9);
                    SCM(playerid, -1, "{ffffff}Вы успешно приобрели наколку 'Вор в законе'");

					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел наколку 'Вор в законе' через /rub",
                	GetPlayerNameEx(playerid), playerid
					);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 5:
                {
                    price = 100;
                    if (current < price) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    SetPlayerData(playerid, P_DONATE_CURRENT, current - price);
                    UpdatePlayerDatabaseInt(playerid, "donate_current", current - price);
                    SetPlayerSkillsInit(playerid);
                    SCM(playerid, -1, "{ffffff}Вы успешно приобрели все скилы на оружие");

					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел все скилы на оружие через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 6:
                {
                    price = 1000;
                    if (GetPlayerData(playerid, P_DONATE_CURRENT) < price)
                        return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    Dialog(playerid, DIALOG_DONATE_BUY_NUMBER, DIALOG_STYLE_INPUT,
                        "{FFCD00}Покупка 4-х значного номера телефона",
                        "{FFFFFF}Введите номер, который\n"\
                        "Вы хотели бы приобрести:",
                        "Далее", "Отмена"
                    );
					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел 4-х значный номер телефона через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                    return 1;
                }
                case 7:
                {
					Dialog
					(
						playerid, DIALOG_COINS_SKIN, DIALOG_STYLE_INPUT,
						"Покупка эксклюзивной одежды (по id)",
						"{FFFFFF}Цена эксклюзивной одежды - {ffb841}1699 "SERVER_COINS_NAME"\n"\
						"{FFFFFF}Укажите id одежды которую хотите приобрести",
						"Далее", "Назад"
					);
					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел эксклюзивную одежду через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 8:
                {
                    price = 500;
                    if (current < price) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");
                    SetPlayerData(playerid, P_DONATE_CURRENT, current - price);
                    UpdatePlayerDatabaseInt(playerid, "donate_current", current - price);
                    GiveIteam(playerid, 288, 1, 1, 0);
                    SCM(playerid, -1, "{ffffff}Вы успешно приобрели Ценную Бумагу.");
					
					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел Ценную Бумагу через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                }
                case 9: 
        		{
        		    price = 300;
        		    if (current < price) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");

        		    AddPlayerData(playerid, P_CAR_SLOTS, +, 1);
        		    UpdatePlayerDatabaseInt(playerid, "car_slots", GetPlayerData(playerid, P_CAR_SLOTS) - GetPlayerCarSlots(GetPlayerData(playerid, P_PREMIUM)));

        		    SetPlayerData(playerid, P_DONATE_CURRENT, current - price);
        		    UpdatePlayerDatabaseInt(playerid, "donate_current", current - price);

        		    SCM(playerid, -1, "{ffffff}Вы успешно приобрели 1 слот для транспорта");

        		    format(fmt_text, sizeof fmt_text,
        		        "Игрок %s[%d] приобрел 1 слот для транспорта через /rub",
        		        GetPlayerNameEx(playerid), playerid
        		    );
        		    SendMessageToAdmins(fmt_text, 0x999999FF);

        		    return 1;
        		}
        		case 10: 
        		{
        		    price = 500;
        		    if (current < price) return SCM(playerid, COLOR_RED, "* Недостаточно Donate!");

        		    AddPlayerData(playerid, P_HOUSE_SLOTS, +, 1);
