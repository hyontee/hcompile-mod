public: DestroyInteraction(index)
{
    format(g_interactions[index][E_I_NAME], 32, "");

    g_interactions[index][E_I_TYPE] = 0;
    g_interactions[index][E_I_INDEX] = -1;
    g_interactions[index][E_I_POS_X] = 0.0;
    g_interactions[index][E_I_POS_Y] = 0.0;
    g_interactions[index][E_I_POS_Z] = 0.0;
    g_interactions[index][E_WORLD] = 0;

    DestroyDynamicArea(g_interactions[index][E_AREA]);
}
stock IsValidMail(email[], len = sizeof email)
{
    new count[2];
    if(!(5 <= len <= 60)) return 0;
    for(new i; i != len; i++)
    {
		switch(email[i])
		{
			case '@':
			{
				count[0]++;
				if(count[0] != 1 || i == len - 1 || i == 0) return 0;
			}
			case '.':
			{
				if(count[0] == 1 && count[1] == 0 && i != len - 1)
				{
					count[1] = 1;
				}
			}
			case '0'..'9', 'a'..'z', 'A'..'Z', '_', '-':
			{
				continue;
			}
			default:
				return 0;
		}
    }
    if(count[1] == 0) return 0;
    return 1;
}

stock GetPlayerJobkNameTeam(playerid)
{
	new team = GetPlayerTeamEx(playerid);
	new rang = GetPlayerJobName(playerid);
	new fmt_rank[32];

	if(TEAM_GOVERNMENT <= team <= TEAM_MAFIA_ITALIAN)
	{
		if(!(1 <= rang <= 10))
			rang = 1;

		format(fmt_rank, sizeof fmt_rank, rank_names[team - 1][rang - 1]);
	}

	return fmt_rank;
}
stock UpdateMoneyDonate(playerid)
{
 format(STRING_GLOBAL, sizeof STRING_GLOBAL, "window.setPlayerNickName('%s') || \
     window.setPlayerLevel('%d') || \
     window.setPlayerMoney('%s') || \
  	 window.setPlayerPassedHours('%d') || \
     window.setPlayerBankMoney('%d') || \
     window.setPlayerDonate('%d') || \
     window.setGameVersion('"SERVER_VERSION"') || \
     window.setPlayerSkinId('%d')|| \
	 window.setCurrentServer('"NUMBER_SERVER"')",
  GetPlayerNameEx(playerid), GetPlayerLevel(playerid), GetPlayerMoneyEx(playerid), \
  ConvertUnixTime(GetPlayerData(playerid, P_GAME_FOR_DAY), CONVERT_TIME_TO_HOURS), \
  GetPlayerData(playerid, P_BANK), GetPlayerCurrentDonate(playerid), GetPlayerSkin(playerid));
 MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, STRING_GLOBAL);
}
