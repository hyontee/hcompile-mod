				ceno[vehicleid] = 10;
				FermerRepositoryUpdate();
				FermaCarUpdate(vehicleid);
				SendClientMessage(playerid, -1, "* Сено загружено в вашу машину. Отправляйтесь на отмеченое место.");
				SetPVarInt(playerid,"zagruz",gettime() + 300);
				SetPlayerRaceCheckpoint
