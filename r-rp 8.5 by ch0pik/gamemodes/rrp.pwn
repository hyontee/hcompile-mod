	MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "client.setHudStatus(true)");
	MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "interface('Hud')");
	MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "interface('Hud').updateHungerLevel(100)");
