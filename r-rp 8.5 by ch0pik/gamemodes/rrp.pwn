            new level = strval(inputtext);
            if (level < 1 || level > 999)
                return SCM(playerid, COLOR_RED, "Уровень должен быть от 1 до 999.");
            new current_level = GetPlayerScore(playerid);
            if (level <= current_level)
                return SCM(playerid, COLOR_RED, "Нельзя понизить уровень.");
            new price = (level - current_level) * 25;
            if (GetPlayerData(playerid, P_DONATE_CURRENT) < price)
            {
                new msg[128];
                format(msg, sizeof(msg), "Недостаточно Donate! Нужно: %d.", price);
                return SCM(playerid, COLOR_RED, msg);
            }
            SetPlayerData(playerid, P_DONATE_CURRENT, GetPlayerData(playerid, P_DONATE_CURRENT) - price);
            UpdatePlayerDatabaseInt(playerid, "donate_current", GetPlayerData(playerid, P_DONATE_CURRENT) - price);
            SetPlayerScore(playerid, level);
            SetPlayerData(playerid, P_LEVEL, level);
            UpdatePlayerDatabaseInt(playerid, "level", level);
            new msg[128];
            format(msg, sizeof(msg), "* Уровень повышен до %d. Потрачено %d Donate.", level, price);
            SCM(playerid, COLOR_GREEN, msg);
            return 1;
