        case DIALOG_CHANGE_NAMES:
        {
            if (!response || !strlen(inputtext))
                return 1;
            new len = strlen(inputtext);
            if (len < 4 || len > 20)
                return SCM(playerid, COLOR_RED, "Имя должно быть от 4 до 20 символов.");
            new bool: valid = true;
            for (new i = 0; i < len; i++)
            {
                new c = inputtext[i];
                if (('a' <= c <= 'z') || ('A' <= c <= 'Z') || c == '_')
                    continue;
                valid = false;
                break;
            }
            if (!valid)
                return SCM(playerid, COLOR_RED, "Имя может содержать только латинские буквы и символ '_' (цифры запрещены).");
            if (!strcmp(inputtext, GetPlayerNameEx(playerid), true))
                return SCM(playerid, COLOR_RED, "Вы уже используете это имя.");
            new query[128], Cache:result, rows;
            mysql_format(mysql, query, sizeof(query), "SELECT id FROM PlayersMorallwens WHERE name='%e' LIMIT 1", inputtext);
            result = mysql_query(mysql, query, true);
            rows = cache_num_rows();
            cache_delete(result);
            if (rows)
                return SCM(playerid, COLOR_RED, "Это имя уже используется.");
            if (GetPlayerData(playerid, P_DONATE_CURRENT) < 50)
                return SCM(playerid, COLOR_RED, "Недостаточно Donate!");
            SetPlayerData(playerid, P_DONATE_CURRENT, GetPlayerData(playerid, P_DONATE_CURRENT) - 50);
            UpdatePlayerDatabaseInt(playerid, "donate_current", GetPlayerData(playerid, P_DONATE_CURRENT) - 50);
            if (ChangePlayerName(playerid, inputtext, true))
            {
                SCM(playerid, COLOR_GREEN, "Вы успешно изменили имя");
                Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
                    "{FFD83D}Имя изменено",
                    "{66FF00}Ваше имя успешно изменено.\n\n"\
                    "{FFFFFF}В следующий раз при входе используйте новое имя в клиенте CRMP.",
                    "Ок", ""
                );
            }
            else
            {
                SCM(playerid, COLOR_RED, "Ошибка при изменении имени.");
            }
            return 1;
        }
