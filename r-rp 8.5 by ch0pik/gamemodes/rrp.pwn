public: Float:PointToPoint(Float:x,Float:y,Float:z,Float:x2,Float:y2,Float:z2)
{
	return floatsqroot(floatpower(floatabs(floatsub(x2,x)),2)+floatpower(floatabs(floatsub(y2,y)),2)+floatpower(floatabs(floatsub(z2,z)),2));
}
stock VoiceSetVolume(playerid, handle, volume)
{
    new BitStream:bsV = BS_New();

    BS_WriteValue(bsV,
        PR_UINT8, 215,
        PR_UINT16, 34,
        PR_UINT32, handle,
        PR_FLOAT, float(volume)
    );
    PR_SendPacket(bsV, playerid);
    BS_Delete(bsV);
    return 1;
}
stock VoiceSetVolumeGlobal(playerid, volume)
{
    new BitStream:bsV = BS_New();

    BS_WriteValue(bsV,
        PR_UINT8, 215,
        PR_UINT16, 6,
        PR_UINT32, (5*volume)
    );

    PR_SendPacket(bsV, playerid);
    BS_Delete(bsV);
    return 1;
}

stock CreatePacketRadio(playerid,  handle, Float:volume=1.0) {
    new BitStream:bsV = BS_New();
    BS_WriteValue(bsV,
        PR_UINT8, 215,
        PR_UINT16, 4,
        PR_UINT32, handle,
        PR_FLOAT, volume,
        PR_BOOL, false,
        PR_UINT8, 0
    );

    PR_SendPacket(bsV, playerid);
    BS_Delete(bsV);
    return 1;
}

stock VoiceOpenStream(playerid, handle, Float:volume = 100.0, bool: use3D = false, attach_to = -1)
{
    new BitStream:bsV = BS_New();
    BS_WriteValue(bsV,
        PR_UINT8, 215,
        PR_UINT16, 4,
        PR_UINT32, handle,
        PR_FLOAT, volume,
        PR_BOOL, use3D,
        PR_UINT8, 2,
        PR_UINT32, attach_to
    );
    PR_SendPacket(bsV, playerid);
    BS_Delete(bsV);
    return 1;
}

stock VoiceCloseStream(playerid, handle)
{
    new BitStream:bsV = BS_New();

    BS_WriteValue(bsV,
        PR_UINT8, 215,
        PR_UINT16, 5,
        PR_UINT32, handle
    );

    PR_SendPacket(bsV, playerid);
    BS_Delete(bsV);
    return 1;
}

