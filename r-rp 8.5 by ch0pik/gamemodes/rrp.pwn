stock GetVehicleCarMarketID(vehicleid)
{
	if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_RENT_CAR) return -1;
	else return GetVehicleData(vehicleid, V_ACTION_ID);
}
stock AdminTeleportList(playerid)
{
	Dialog
	(
		playerid, DIALOG_TELEPORT_LIST, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации",
		"{FAFAD2}[0] Мои Телепорты\n"\
		"{FAFAD2}[1] Админ места\n"\
		"{FAFAD2}[2] Города и поселки\n"\
		"{FAFAD2}[3] Организации\n"\
		"{FAFAD2}[4] Работы\n"\
		"{FAFAD2}[5] Начальные Работы\n"\
		"{FAFAD2}[6] Важные Места\n"\
		"{FAFAD2}[7] Бизнесы\n"\
		"{FAFAD2}[8] Спавны",
		"Далее", "Закрыть"
	);
	return 1;
}

stock Tplist_OnDialogResponse(playerid, dialogid, response, listitem)
{
    switch(dialogid)
    {
        case DIALOG_MY_TELEPORT_LIST:
        {
            if(response)
            {
                SetPlayerPosEx
                (
                    playerid,
                    g_player_my_tplist[playerid][listitem][Tplist_X],
                    g_player_my_tplist[playerid][listitem][Tplist_Y],
                    g_player_my_tplist[playerid][listitem][Tplist_Z],
                    0.0, 0, 0
                );
            }
            return 1;
        }

        case DIALOG_TELEPORT_LIST:
        {
            if(!response) return 1;

            switch(listitem)
            {
                case 0: // Личные телепорты
                {
                    string_global[0] = EOS;

                    mysql_format(mysql, string_global, sizeof string_global, "SELECT * FROM `mytplist` WHERE `owner_id` = %d", GetPlayerAccountID(playerid));
                    mysql_query(mysql, string_global, true);

                    new rows = cache_num_rows();

                    if(rows == 0)
                    {
                        SCM(playerid, 0xffdf87FF, "У Вас нет личных телепортов. Создать: /add_tplist");
                        return 1;
                    }

                    new name[33];
                    string_minimal[0] = EOS;

                    for(new i = 0; i < rows; i++)
                    {
                        cache_get_field_content(i, "name", name, mysql, sizeof(name));

                        g_player_my_tplist[playerid][i][Tplist_X] = cache_get_field_content_float(i, "x");
                        g_player_my_tplist[playerid][i][Tplist_Y] = cache_get_field_content_float(i, "y");
                        g_player_my_tplist[playerid][i][Tplist_Z] = cache_get_field_content_float(i, "z");

                        format(string_minimal, sizeof string_minimal, "%s{FFFFFF}%d. %s\n", string_minimal, i + 1, name);
                    }

                    Dialog(playerid, DIALOG_MY_TELEPORT_LIST, DIALOG_STYLE_LIST, "{FFD83D}Список личных телепортов", string_minimal, "Выбрать", "Закрыть");
                }
                case 1: // Города
                {
                    Dialog
                    (
                        playerid, DIALOG_TELEPORT_CITY, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации | {FAFAD2}Города",
                        "{FAFAD2}[1] Арзамас\n"\
                        "{FAFAD2}[2] Армейское\n"\
                        "{FAFAD2}[3] Барвиха\n"\
                        "{FAFAD2}[4] Батырево\n"\
                        "{FAFAD2}[5] Бусаево\n"\
                        "{FAFAD2}[6] Гарель\n"\
                        "{FAFAD2}[7] Корякино\n"\
                        "{FAFAD2}[8] Лесное\n"\
                        "{FAFAD2}[9] Лыткарино\n"\
                        "{FAFAD2}[10] Майами\n"\
                        "{FAFAD2}[11] Мирное\n"\
                        "{FAFAD2}[12] Нижегородск\n"\
                        "{FAFAD2}[13] Простоквасино\n"\
                        "{FAFAD2}[14] Рублевка\n"\
                        "{FAFAD2}[15] Шахтерское\n"\
                        "{FAFAD2}[16] Эдово\n"\
                        "{FAFAD2}[17] Южный",
                        "Далее", "Закрыть"
                    );
                }
                case 2: // Организации
                {
                    Dialog
                    (
                        playerid, DIALOG_TELEPORT_GOSS, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации | {FAFAD2}Организации",
                        "{FAFAD2}[1] Министерство Внутренних Дел\n"\
                        "{FAFAD2}[2] Министерство здравохранения\n"\
                        "{FAFAD2}[3] Министерство Обороны\n"\
                        "{FAFAD2}[4] Правительство\n"\
                        "{FAFAD2}[5] ТРК Ритм\n"\
                        "{FAFAD2}[6] Федеральная Служба Безопасности\n"\
                        "{FAFAD2}[7] Федеральная Служба Исполнения Наказаний\n"\
                        "{FAFAD2}[8] Министерство Чрезвычайных Ситуаций",
                        "Далее", "Закрыть"
                    );
                }
                case 3: // Работы
                {
                    Dialog
                    (
                        playerid, DIALOG_TELEPORT_WORKS, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации | {FAFAD2}Работы",
                        "{FAFAD2}[1] Автобусник\n"\
                        "{FAFAD2}[2] Машинист\n"\
                        "{FAFAD2}[3] Пирс\n"\
                        "{FAFAD2}[4] Пилот\n"\
                        "{FAFAD2}[5] Электрик\n"\
                        "{FAFAD2}[6] Дорожная служба",
                        "Далее", "Закрыть"
                    );
                }
                case 4: // Начальные работы
                {
                    Dialog
                    (
                        playerid, DIALOG_TELEPORT_LOW_WORKS, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации | {FAFAD2}Начальные Работы",
                        "{FAFAD2}[1] Лесопилка\n"\
                        "{FAFAD2}[2] Ферма\n"\
                        "{FAFAD2}[3] Шахта\n"\
                        "{FAFAD2}[4] Завод",
                        "Далее", "Закрыть"
                    );
                }
                case 5: // Важные места
                {
                    Dialog
                    (
                        playerid, DIALOG_TELEPORT_LOCATION, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации | {FAFAD2}Важные Места",
                        "{FAFAD2}[1] Контейнеры\n"\
                        "{FAFAD2}[2] Праздничная Локация\n"\
                        "{FAFAD2}[3] Свалка\n"\
                        "{FAFAD2}[4] Торговый Центр",
                        "Далее", "Закрыть"
                    );
                }
                case 6: // Бизнесы
                {
                    Dialog
                    (
                        playerid, DIALOG_TELEPORT_BUSINESS, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации | {FAFAD2}Бизнесы",
