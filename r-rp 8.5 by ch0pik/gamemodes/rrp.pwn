					static fmt_text[144];
					format(fmt_text, sizeof fmt_text,
                	"Игрок %s[%d] приобрел 'Ковш' на автомобиль через /rub",
                	GetPlayerNameEx(playerid), playerid
            		);
            		SendMessageToAdmins(fmt_text, 0x999999FF);
                }
            }
            return 1;
        }
        case DIALOG_RUB_NUM_EXCLUS:
        {
            if (!response || !strlen(inputtext))
                return 1;
            if (!IsValidRussianCarNumber(inputtext))
                return SCM(playerid, COLOR_RED, "Неверный формат номера! Пример: A123BC77");
            new number[8], region[3];
            format(number, sizeof(number), "%.*s", 6, inputtext);
            format(region, sizeof(region), "%.*s", 2, inputtext[6]);
            if (IsVehicleNumberExists(number, region, 5))
                return SCM(playerid, COLOR_RED, "Такой номер уже существует!");
            if (GetPlayerData(playerid, P_DONATE_CURRENT) < 1875)
                return SCM(playerid, COLOR_RED, "Недостаточно Donate!");
            SetPlayerData(playerid, P_DONATE_CURRENT, GetPlayerData(playerid, P_DONATE_CURRENT) - 1875);
            UpdatePlayerDatabaseInt(playerid, "donate_current", GetPlayerData(playerid, P_DONATE_CURRENT) - 1875);
            CreateItemsCarNumber(GetPlayerAccountID(playerid), 0, 1, GetInventorySlots(playerid), number, region, 1, -1, -1, 0, 1);
            new msg[128];
            format(msg, sizeof(msg), "Эксклюзивный номер %s %s добавлен в инвентарь.", number, region);
            SCM(playerid, COLOR_GREEN, msg);
			static fmt_text[144];
			format(fmt_text, sizeof fmt_text,
			"Игрок %s[%d] приобрел Эксклюзивный номер на автомобиль через /rub",
			GetPlayerNameEx(playerid), playerid
			);
			SendMessageToAdmins(fmt_text, 0x999999FF);
            return 1;
        }
        case DIALOG_RUB_NUM_POLICE:
        {
            if (!response || !strlen(inputtext))
                return 1;
            if (!IsValidRussianCarNumber(inputtext))
                return SCM(playerid, COLOR_RED, "Неверный формат номера! Пример: A123BC77");
            new number[8], region[3];
            format(number, sizeof(number), "%.*s", 6, inputtext);
            format(region, sizeof(region), "%.*s", 2, inputtext[6]);
            if (IsVehicleNumberExists(number, region, 6))
                return SCM(playerid, COLOR_RED, "Такой номер уже существует!");
            if (GetPlayerData(playerid, P_DONATE_CURRENT) < 1000)
                return SCM(playerid, COLOR_RED, "Недостаточно Donate!");
            SetPlayerData(playerid, P_DONATE_CURRENT, GetPlayerData(playerid, P_DONATE_CURRENT) - 1000);
            UpdatePlayerDatabaseInt(playerid, "donate_current", GetPlayerData(playerid, P_DONATE_CURRENT) - 1000);
            CreateItemsCarNumber(GetPlayerAccountID(playerid), 0, 1, GetInventorySlots(playerid), number, region, 6, -1, -1, 0, 1);
            new msg[128];
            format(msg, sizeof(msg), "Полицейский номер %s %s добавлен в инвентарь.", number, region);
            SCM(playerid, COLOR_GREEN, msg);
			static fmt_text[144];
			format(fmt_text, sizeof fmt_text,
			"Игрок %s[%d] приобрел Полицейский номер на автомобиль через /rub",
			GetPlayerNameEx(playerid), playerid
			);
			SendMessageToAdmins(fmt_text, 0x999999FF);
            return 1;
        }
        case DIALOG_RUB_NUM_TAXI:
        {
            if (!response || !strlen(inputtext))
                return 1;
            if (!IsValidRussianCarNumber(inputtext))
                return SCM(playerid, COLOR_RED, "Неверный формат номера! Пример: A123BC77");
            new number[8], region[3];
            format(number, sizeof(number), "%.*s", 6, inputtext);
            format(region, sizeof(region), "%.*s", 2, inputtext[6]);
            if (IsVehicleNumberExists(number, region, 7))
                return SCM(playerid, COLOR_RED, "Такой номер уже существует!");
            if (GetPlayerData(playerid, P_DONATE_CURRENT) < 500)
                return SCM(playerid, COLOR_RED, "Недостаточно Donate!");
            SetPlayerData(playerid, P_DONATE_CURRENT, GetPlayerData(playerid, P_DONATE_CURRENT) - 500);
            UpdatePlayerDatabaseInt(playerid, "donate_current", GetPlayerData(playerid, P_DONATE_CURRENT) - 500);
            CreateItemsCarNumber(GetPlayerAccountID(playerid), 0, 1, GetInventorySlots(playerid), number, region, 7, -1, -1, 0, 1);
            new msg[128];
            format(msg, sizeof(msg), "Такси-номер %s %s добавлен в инвентарь.", number, region);
            SCM(playerid, COLOR_GREEN, msg);
			static fmt_text[144];
			format(fmt_text, sizeof fmt_text,
			"Игрок %s[%d] приобрел Такси номер на автомобиль через /rub",
			GetPlayerNameEx(playerid), playerid
			);
			SendMessageToAdmins(fmt_text, 0x999999FF);
            return 1;
        }
    }
    return 1;
}
public: Jail_DialogRespones(playerid, dialogid, listitem, response, inputtext[])
{
    switch(dialogid)
    {
        case DIALOG_JAIL_ALERT:
        {
            if(!response) return 1;

            foreach(new i : Player)
            {
                if(IsPlayerConnected(i) && IsPlayerLogged(i) && IsPlayerInDynamicArea(i, AreaJailInterior) || IsPlayerConnected(i) && IsPlayerLogged(i) && IsPlayerInDynamicArea(i, AreaJail)) SCMF(i, 0x7ca2cbFF, "[Громкоговоритель] %s[%d]: {FFFFFF}%s", GetPlayerNameEx(playerid), playerid, inputtext);
            }
        }
    }
    return 1;
}
