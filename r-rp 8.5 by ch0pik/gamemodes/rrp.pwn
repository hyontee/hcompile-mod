stock SCINT_OnPlayerConfirm(playerid, id)
{
    new player_rank = GetPlayerJobName(playerid);
    new team_id = GetPlayerTeamEx(playerid);

    new count = 0;
    new last_skin = -1;
    new skin = -1;

    for (new i = 0; i < 10; i++) {
        new cur_skin = GetTeamData(team_id, O_SKINS)[i];
        if (cur_skin <= 0) continue;

        new required_rank = i + 1; 

        if (player_rank < required_rank) continue; 

        if (cur_skin == last_skin) continue; 

        if (count == id) {
            skin = cur_skin;
            break;
        }

        last_skin = cur_skin;
        count++;
    }

    if (skin <= 0) {
        return SCM(playerid, -1, "* Неверный выбор скина");
    }

    new skin_index = -1;
    for (new i = 0; i < 10; i++) {
        if (GetTeamData(team_id, O_SKINS)[i] == skin) {
            skin_index = i;
            break;
        }
    }

    if (skin_index != -1 && player_rank < skin_index + 1) {
        return SCM(playerid, COLOR_GREY, "Вы не можете использовать эту униформу по вашему рангу.");
    }

    SetPlayerSkin(playerid, skin);
    SetPlayerData(playerid, P_OSKIN, skin);
    SCM(playerid, COLOR_GREY, "* Вы успешно сменили униформу");
    return 1;
}
