public OnPlayerSpawn(playerid)
{
    if(GetPVarInt(playerid, "Login_1") != 1) 
    {
        printf("{FFFFFF}["SERVER_NAME_RP"]:: Игрок %s попытался заспавниться не авторизовавшись", GetPlayerNameEx(playerid)); 
        Kick(playerid);
        return 1;
    }

	if(Iter_Contains(DmZonePlayers, playerid))
    {
        return SpawnInDmZone(playerid);
    }

    callcmd::return_acsses(playerid);
    ResetWeapons(playerid);

    SetPlayerData(playerid, P_IN_ENTRANCE,        -1);
    SetPlayerData(playerid, P_IN_ENTRANCE_FLOOR, -1);

    return 1;
}
stock SpawnInDmZone(playerid)
{
	new index = random(sizeof g_dmzone_player_pos);

	SetPlayerPosEx(playerid, g_dmzone_player_pos[index][0], g_dmzone_player_pos[index][1], g_dmzone_player_pos[index][2], 0.0, 0, 4, false);

	GivePlayerWeapon(playerid, 24, 100);

	SetPlayerHealth(playerid, 100.0);

	SetPlayerSkin(playerid, 230);

	g_player[playerid][P_DM_TAKE_GUN] = 0;

	return 1;
}
public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
	if(!newinteriorid)
    {
        new hour;
        gettime(hour, _, _);
        SetPlayerTime(playerid, hour, 0);
        return 1;
    }
    SetPlayerTime(playerid, 12, 0);
	return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	Donate_OnPlayerKeyStateChange(playerid, newkeys);
	Mvd_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
	if(PRESSED(KEY_WALK))
	{
		if(HasUgonTask[playerid] && !IsPlayerInAnyVehicle(playerid) && !IsVehicleHacked[playerid])
		{
			new Float:uv_x, Float:uv_y, Float:uv_z;
			GetVehiclePos(PlayerUgonVeh[playerid], uv_x, uv_y, uv_z);
			if(IsPlayerInRangeOfPoint(playerid, 5.0, uv_x, uv_y, uv_z))
			{
				TogglePlayerControllable(playerid, false);
				ApplyAnimation(playerid, "PED", "ATM", 4.1, 1, 0, 0, 0, 0);
				ShowCarHacking(playerid);
				return 1;
			}
		}
	}
	Kz_OnPlayerKeyStateChange(playerid, newkeys, oldkeys);
	Sob_OnPlayerKeyStateChange(playerid, newkeys);
	dmzone_OnPlayerKeyStateChange(playerid, newkeys);
	CallLocalFunction("MetalSearch_OnKeyStateChange", "ii", playerid, newkeys);
	if(newkeys & KEY_HANDBRAKE || PRESSED(KEY_HANDBRAKE))
	{
		if(GetPlayerData(playerid, P_TARGET_ID) == INVALID_PLAYER_ID)
		{
			new targetid = GetPlayerTargetPlayer(playerid);

			if(targetid != INVALID_PLAYER_ID)
			{
				SetPlayerData(playerid, P_TARGET_ID, targetid);
				MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "interface('ScreenNotification').add('[1,\"Взаимодействие с человеком\",\"Для взаимодействия используйте клавишу {FF5B1D}R\",\"F9B82E\",5000]')");
				SCM(playerid, 0xf9b82eFF, "[Взаимодействие с человеком] {FFFFFF}Для взаимодействия используйте клавишу {ff5b1d}R");
			}
		}
	}
	if(newkeys & 1024)
    {
		if(GetPVarInt(playerid, "CameraActive") == 1)
		{
	        new Float:x, Float:y, Float:z; 
	        new Float:lock_x, Float:lock_y, Float:lock_z;

	        GetPlayerCameraPos(playerid, x, y, z);
	        GetPlayerCameraLookAt(playerid, lock_x, lock_y, lock_z);

	        SetPlayerCameraPos(playerid, x, y, z);
		    SetPlayerCameraLookAt(playerid, lock_x, lock_y, lock_z);

		    DiskiStyling(playerid);
			DeletePVar(playerid, "CameraActive"); 
			SendClientEvent(playerid, t_CefHide, "Interactions");
		}
	}
	if(newkeys == 1024)
	{
		if(IsPlayerInRangeOfPoint(playerid, 2.0, -2898.9446,1698.5298,1001.0000)) KeyWalkWeaponShop(playerid);
	}
	if(newkeys & 1024)
    {
        if(IsPlayerInRangeOfPoint(playerid, 3.0, -677.9808,-1744.6123,41.6159))
        {
                    if(snowjob[playerid][0] == 0)
                    {
                          Dialog(playerid, DIALOG_JOB_SNOW, DIALOG_STYLE_MSGBOX, "Работа снегоуборщика", "Вы действительно хотите устроиться на работу снегоуборщика?" , "Далее", "Отмена");
                    }
                    else
                    {
                          Dialog(playerid, DIALOG_JOB_SNOW_END, DIALOG_STYLE_MSGBOX, "Работа снегоуборщика", "Вы действительно хотите уволиться с работы снегоуборщика?" , "Далее", "Отмена");
                          snowjob[playerid][0] = 1;
                    }
    	}
    }
	if(PRESSED(KEY_WALK))
	{
	if(IsPlayerInRangeOfPoint(playerid, 2.0, 2356.2046,-1769.8857,23.6749))
	{
		if (GetPlayerTeamEx(playerid) != TEAM_FSB && GetPVarInt(playerid, "undercover_active") != 1)
		{
			SendClientMessage(playerid, -1, "* Данный вход предназначен только для сотрудников ФСБ");
			GameText(playerid, "~r~Нет доступа", 3000, 3);
			return 1;
		}
		SetPlayerPosEx(playerid, 2340.0442,-1774.6420,1006.7908,88.1460, 5, 0);
	}
	if(IsPlayerInRangeOfPoint(playerid, 2.0, 2342.9490,-1774.8019,1006.7834))
	{
		if (GetPlayerTeamEx(playerid) != TEAM_FSB && GetPVarInt(playerid, "undercover_active") != 1)
		{
			SendClientMessage(playerid, -1, "* Данный выход предназначен только для сотрудников ФСБ");
			GameText(playerid, "~r~Нет доступа", 3000, 3);
			return 1;
		}
		SetPlayerPosEx(playerid, 2350.6182,-1769.8749,21.9652,88.6366, 0, 0);
	}
	if(IsPlayerInRangeOfPoint(playerid, 2.0, 1611.3949,1836.6571,996.5703))
  	{
    	if (GetPlayerTeamEx(playerid) != TEAM_GOVERNMENT)
    	{
      		SendClientMessage(playerid, -1, "* Данный выход предназначен только для сотрудников Правительства");
      		GameText(playerid, "~r~Нет доступа", 3000, 3);
      		return 1;
    	}
    	SetPlayerPosEx(playerid, -2575.7424,1460.8621,48.7025,112.1126, 0, 0);
    	}
 	}
	if(PRESSED(KEY_WALK))
	{
	if(IsPlayerInRangeOfPoint(playerid, 2.0, -1677.5779,-2839.4141,1001.4022))
	{
		if(GetPlayerTeamEx(playerid) != TEAM_FSIN) return GameText(playerid, "~r~Нет доступа", 1000,2);
		SetPlayerPosEx(playerid, -1789.1770,-2761.0176,11.1008,17.7154, 0, 0);
	}
	if(IsPlayerInRangeOfPoint(playerid, 1.0, -1788.4897,-2763.7178,12.1247))
	{
		if(GetPlayerTeamEx(playerid) != TEAM_FSIN) return GameText(playerid, "~r~Нет доступа", 1000,2);
		SetPlayerPosEx(playerid, -1677.3516,-2837.5862,1001.4022,0.9508, 4, 2);
	}
	if(IsPlayerInRangeOfPoint(playerid, 2.0, -1828.2269,-2796.1123,11.4216))
	{
		if(GetPlayerTeamEx(playerid) != TEAM_FSIN) return GameText(playerid, "~r~Нет доступа", 1000,2);
		SetPlayerPosEx(playerid, -1825.5643,-2772.4827,11.1027,17.2917, 0, 0);
	}
	if(IsPlayerInRangeOfPoint(playerid, 1.0, -1824.7676,-2775.0286,12.1247))
	{
		if(GetPlayerTeamEx(playerid) != TEAM_FSIN) return GameText(playerid, "~r~Нет доступа", 1000,2);
		SetPlayerPosEx(playerid, -1830.6410,-2798.5276,11.3626,134.9088, 0, 0);
		}
	}
	if(newkeys & 1024)
	{
		for(new i; i < MAX_DIVER_GIFT; i++)
	{
		if(g_diver_work[i][E_DIVER_PICKED]) continue; // уже подобран

		if(IsPlayerInRangeOfPoint(playerid, 4.0,
			g_diver_pos[i][E_DIVER_POS_X],
			g_diver_pos[i][E_DIVER_POS_Y],
			g_diver_pos[i][E_DIVER_POS_Z]))
		{
			if(GetPlayerSkin(playerid) != 15576)
				return SendClientMessage(playerid,COLOR_RED,
					"Чтобы работать драйвером, нужно иметь 'Одежду Дайвера'.");

			if(GetInventorySlots(playerid) == -1)
				return GameText(playerid, "В инвентаре нет свободного места", 3000, 0);

			if(IsValidDynamicObject(g_diver_work[i][E_DIVER_OBJECT]))
				DestroyDynamicObject(g_diver_work[i][E_DIVER_OBJECT]);

			if(IsValidDynamic3DTextLabel(g_diver_work[i][E_DIVER_3DTEXT]))
				DestroyDynamic3DTextLabel(g_diver_work[i][E_DIVER_3DTEXT]);

			g_diver_work[i][E_DIVER_PICKED] = true;

			diver_item[playerid] = g_diver_items[random(sizeof g_diver_items)];
			GiveIteam(playerid, diver_item[playerid], 1, 1, 0, "Работа дайвера");
			GiveRandCase(playerid);
			format(string_mrllwns, sizeof string_mrllwns, "Из сундука вам выпало '%s' ", ItemsInfo[diver_item[playerid]], diver_item[playerid]);
			SendClientMessage(playerid, COLOR_GOLD, string_mrllwns);
			diver_item[playerid] = -1;
			break;
			}
		}
	}
	if(PRESSED( KEY_SPRINT | KEY_JUMP ))
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(!IsABike(vehicleid))
		{
			if(IsPlayerDriver(playerid))
			{
				if(GetVehicleData(vehicleid, V_TWIN) == 1 && GetVehicleData(vehicleid, V_TWIN_ACTIVE) == 1)
				{
					new panels, doors, lights, tires;
					GetVehicleDamageStatus(GetPlayerVehicleID(playerid), panels, doors, lights, tires);

					if(tires == 0)
					{

						g_twin_start{playerid} = 1;
						MoralPacket_1(playerid, s_CefInterface, t_CefShow, "ScreenNotification");

						string_mrllwns[0] = EOS;

						string_mrllwns[0] = EOS; format(string_mrllwns, 200, "interface('ScreenNotification').add('[1,\"%s\",\"%s\",\"63ff85\", 10000]')", "Нагнетатель", "Удерживайте до 7-ми тысяч оборотов");
						MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, string_mrllwns);

						MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "interface('Hud').showTachometer(1)");

						string_mrllwns[0] = EOS;

						string_mrllwns[0] = EOS; format(string_mrllwns, 200, "interface('Hud').setTachometerData(%d, 8000, 1, 1)", g_twin_start{playerid} * 1000);

						MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, string_mrllwns);
					}
					else
					{
						return SendClientMessage(playerid, 0xC0C0C0FF, "У вашей машины проколоты колёса");
					}
				}
			}
		}
	}
	if(RELEASED( KEY_SPRINT | KEY_JUMP ))
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(!IsABike(vehicleid))
		{
			if(IsPlayerDriver(playerid))
			{
				if(GetVehicleData(vehicleid, V_TWIN) == 1)
				{
					if(g_twin_start{playerid} > 3)
					{

						new Float:veh_speed = GetVehicleSpeed(GetPlayerVehicleID(playerid));

						SetVehicleSpeed(GetPlayerVehicleID(playerid), veh_speed + float(g_twin_start{playerid} * 30));

						g_twin_start{playerid} = 0;

						MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "interface('Hud').hideTachometer()");

					}
					else if(1 <= g_twin_start{playerid} <= 3)
					{
						g_twin_start{playerid} = 0;
						//SendClientMessage(playerid, -1, "Недодержал");

						MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "interface('Hud').hideTachometer()");
					}
				}
			}
		}
	}
	if(g_player_progress_bar_type[playerid] != 0)
	{
		if(newkeys & 65536)
		{
			OnPlayerProgressBar(playerid);
		}
	}
	if(newkeys == 1024) Derbi(playerid);

	if(newkeys & 1024)
	{
	openRaffleShop(playerid);

	if(vehicle_house_id[playerid] != 0) ExitVehicleHouse(playerid);
	else if(IsVehicleIdHouse(playerid)) EnterVehicleHouse(playerid);


	if(g_player_status_fish[playerid] != 0)
	{
		if(g_player_status_fish[playerid] == 1) return SCM(playerid, 0xfcdb70FF, "Сначала намотайте леску на вашу удочку.");
		if(g_player_status_fish[playerid] == 2) return SCM(playerid, 0xfcdb70FF, "Сначала насадите наживку на вашу удочку.");

		if(g_player_status_fish[playerid] == 3)
		{
			SCM(playerid, 0xa2d5f9FF, "Нажмите {FFFFFF}\"пробел\" {a2d5f9}чтобы подсечь рыбу, когда посчитаете нужным.");
			SCM(playerid, 0xa2d5f9FF, "Нажмите {FFFFFF}\"Enter\" {a2d5f9}если захотите закончить рыбалку.");

			MoralPacket_1(playerid, s_CefInterface, t_CefHide, "Interactions");

			MoralPacket_2(playerid, s_CefInterface, t_CefShow, "Fishing", "[0, 0, 0.0, false, 45]");

			MoralPacket_2(playerid, s_CefInterface, t_CefShow, "Interactions", "[[1, \"Подсечь рыбу\"], [2, \"Закончить рыбалку\"]]");

			g_player_deteling_id[playerid] = 1;

			g_player_status_fish[playerid] = 4;

			g_player_fish_timer[playerid] = RandomEx(6,12);

			new Float:cam_x,
				Float:cam_y;

			new Float:x,
				Float:y,
				Float:z,
				Float:angle;
			
			
			GetPlayerPos(playerid, x, y, z);
			GetPlayerFacingAngle(playerid, angle);

			cam_x = x + (2 * floatsin(-angle, degrees));
			cam_y = y + (2 * floatsin(-angle, degrees));

			SetPlayerCameraPos(playerid, x,y,z),
			SetPlayerCameraLookAt(playerid, cam_x, cam_y, z);

			TogglePlayerControllable(playerid,false);

			return true;
			}
		}
	}
	if(newkeys & 1024) // ALT
	{
		for(new i = 0; i < MAX_BOMBA; i++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 5.0, MO_BOBMA[i][0], MO_BOBMA[i][1], MO_BOBMA[i][2]))
			{
				if(!WallDestroyed)
				{
					if(GetPlayerTeamEx(playerid) == TEAM_ARMY) return 1;
					if(BombaStatus[i][0] == 1) return GameText(playerid, "~b~Стена уже была подорвана", 4000, 2);
                    if(GetIteam(playerid, 371) < 1) return SendClientMessage(playerid, 0xFF0000, "У Вас нет бомбы");
                    GiveIteam(playerid, 371, 0,1,0);
					GameText(playerid, "~w~Вы заложили бомбу взрыв~r~~n~через 20 секунд", 4000, 2);
					ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0, 1);
					BombaStatus[i][0] = 1;
					SetTimerEx("ExplodeWall", 20000, false, "d", i);
					SetTimer("RestoreWall", 600000, false);
				}
				else
				{
					if(GetPlayerTeamEx(playerid) != TEAM_ARMY) return SendClientMessage(playerid, -1, "* Вы не служите в МО");
					g_player_progress_bar_type[playerid] = 1;
					g_player_progress_bar[playerid] = 0;
					MoralPacket_2(playerid, s_CefInterface, t_CefShow, "ProgressBar", "[[\"Нажимайте Y<br>с небольшим интервалом\", 0, 1000]]");
					ApplyAnimationEx(playerid, "ped", "a_dig", 4.0, true, 0, 0, 1, 0, 0, USE_ANIM_TYPE_NONE);
					MoralPacket_1(playerid, s_CefInterface, t_CefHide, "Interactions");
					SetTimerEx("RestoreWall", 10000, false, "d", i);
				}
				return 1;
			}
		}
	}
	if(newkeys & 1024)
	{
		if(GetPlayerTempJob(playerid) == TEMP_JOB_MINER)
		{
			for(new i; i < sizeof g_mine_rack; i++)
			{
				if(!IsPlayerInRangeOfPoint(playerid, 2.5, g_mine_rack[i][0], g_mine_rack[i][1], g_mine_rack[i][2])) continue;

				if(g_player_mine_status[playerid] == 0)
				{
					g_player_mine_status[playerid] = 1;
					SCM(playerid, 0xb1cbe5FF, "Теперь вам необходимо найти рудное месторождение: осматривайте стены.");
					GameText(playerid, "Вы взяли инструмент~n~Отыщите рудное месторождение", 3000, 2);

					//прописать инструмент
					RemovePlayerAttachedObjects(playerid);
					SetPlayerAttachedObject(playerid, 0, 17114, 6, 0.0290, 0.1280, 0.1020, -24.0000, -14.8000, 0.0000, 1.0000, 1.0000, 1.0000, 0, 0);
					ApplyAnimationEx(playerid, "CARRY", "crry_prtial", 4.1, 1, 1, 1, 1, 1, 0, USE_ANIM_TYPE_NONE - 1);

					MoralPacket_1(playerid, s_CefInterface, t_CefHide, "Interactions");
				}
			}

			for(new i; i < MAX_MINE_ORE; i++)
			{
				if(IsPlayerInRangeOfPoint(playerid, 2.5, g_mine_ore_pos[i][MOP_DOWN][0], g_mine_ore_pos[i][MOP_DOWN][1], g_mine_ore_pos[i][MOP_DOWN][2]))
				{
					if(g_player_mine_status[playerid] == 1)
					{
						if(g_mine_ore[i][MO_OWNER_ID] != -1 && g_mine_ore[i][MO_OWNER_ID] != playerid) return 1;

						if(g_mine_ore[i][MO_OWNER_ID] == -1)
							g_player_mine_ore[playerid] = i,
							g_mine_ore[i][MO_OWNER_ID] = playerid;

						g_player_progress_bar_type[playerid] = 3;
						g_player_progress_bar[playerid] = 0;
						MoralPacket_2(playerid, s_CefInterface, t_CefShow, "ProgressBar", "[[\"Нажимайте Y<br>с небольшим интервалом\", 0, 1000]]");

						MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "window.playSound('sounds/mine/sfx_drilling_mine_long_loop2.wav', 1, 6, 0.50)");

						ApplyAnimationEx(playerid, "SHOP", "SHP_GUN_AIM", 4.0, true, 0, 0, 1, 0, 0, USE_ANIM_TYPE_NONE);

						SetPlayerAttachedObject(playerid, 0, 17114, 6, 0.010, -0.02, 0.02, 64.0, -100.8, 0.0, 1.0, 1.0, 1.0, 0, 0);

						MoralPacket_1(playerid, s_CefInterface, t_CefHide, "Interactions");
					}
					break;
				}
			}
			if(IsPlayerInDynamicArea(playerid, g_player_mine_sphere[playerid]))
			{
				if(g_player_mine_status[playerid] == 8)
				{
					g_player_mine_status[playerid] = 9;

					new id = g_player_mine_ore[playerid];

					if(IsValidDynamicObject(g_player_mine_object[playerid])) 
					DestroyDynamicObject(g_player_mine_object[playerid]);
			
					g_player_mine_object[playerid] = INVALID_OBJECT_ID;

					if(IsValidDynamic3DTextLabel(g_mine_ore[id][MO_LABEL])) 
					DestroyDynamic3DTextLabel(g_mine_ore[id][MO_LABEL]);

					g_mine_ore[id][MO_LABEL] = Text3D: INVALID_3DTEXT_ID;

					RemovePlayerAttachedObjectEx(playerid, A_OBJECT_SLOT_HAND, A_OBJECT_SLOT_HAND + 1);
					SetPlayerAttachedObject(playerid, A_OBJECT_SLOT_SPINE, 17108, A_OBJECT_BONE_SPINE, -0.9, 0.7, 0.02, 0.0, 90.0, 0.0, 1.0, 1.0, 1.0, 0);
					GameText(playerid, "Отвезите тележку к вагонетке", 3000, 2);
					ApplyAnimationEx(playerid, "CARRY", "liftup", 8.0, 0, 0, 0, 0, 0, 0);

					new random_vagon = random(4);

					g_player_mine_cp[playerid] = 10;
					SetPlayerCheckpoint(playerid, g_mine_vagon[random_vagon][0], g_mine_vagon[random_vagon][1], g_mine_vagon[random_vagon][2], 2.0);

					MoralPacket_1(playerid, s_CefInterface, t_CefHide, "Interactions");
				}
			}
		}
    }
	if(IsPlayerInRangeOfPoint(playerid, 3.0, -416.9680,-1650.0635,40.3984))
	    {
			Dialog
			(
			playerid, DIALOG_EGGSHOP, DIALOG_STYLE_LIST,
			"{FFA500}Пасхальная лавка",
			"{FFFFFF}1. <t><t>{FFA500}500 Яиц - Ёкарный Бабай [ID: 594]{FFFFFF}\n"\
			"{FFFFFF}2. <t><t>{FFA500}50 Яиц - КЛЮЧ ОТ КЕЙСА{FFFFFF}\n"\
			"{FFFFFF}3. <t><t>{FFA500}25 Яиц - КЕЙС ОПЕРСКОЙ{FFFFFF}\n"\
			"{FFFFFF}4. <t><t>{FFA500}1000 Яиц - Хасбик №2 [ID: 15563]{FFFFFF}\n"\
			"{FFFFFF}5. <t><t>{FFA500}1000 Яиц - Хасбик №3 [ID: 15564]{FFFFFF}\n"\
			"{FFFFFF}6. <t><t>{FFA500}750 Яиц - Хасбик №4 [ID: 15565]{FFFFFF}\n"\
			"{FFFFFF}7. <t><t>{FFA500}750 Яиц - ЭКСКЛЮЗИВНЫЙ СКИН АРАБА [ID: 116]{FFFFFF}\n"\
			"{FFFFFF}8. <t><t>{FFA500}750 Яиц - ЭКСКЛЮЗИВНЫЙ СКИН ЗУБЕНКО [ID: 15455]{FFFFFF}\n"\
			"{FFFFFF}9. <t><t>{FFA500}1750 Яиц - ЭКСКЛЮЗИВНЫЙ СКИН БУСТЕРА [ID: 15528]{FFFFFF}\n"\
			"{FFFFFF}10. <t><t>{FFA500}4500 Яиц - Mercedes-Benz SLS AMG [ID: 15176]{FFFFFF}\n"\
			"{FFFFFF}11. <t><t>{FFA500}5000 Яиц - Mercedes Brabus P900 [ID: 15297]{FFFFFF}\n"\
			"{FFFFFF}12. <t><t>{FFA500}5000 Яиц - Mercedes-Benz 280 SL [ID: 15190]{FFFFFF}\n"\
			"{FFFFFF}13. <t><t>{FFA500}5000 Яиц - Mercedes Benz CLK-GTR [ID: 15229]{FFFFFF}\n"\
			"{FFFFFF}14. <t><t>{FFA500}15000 Яиц - Mercedes AMG Project One [ID: 15294]{FFFFFF}\n"\
			"{FFFFFF}15. <t><t>{FFA500}20000 Яиц - Mercedes GLS Mybach [ID: 15678]{FFFFFF}\n"\
			"{FFFFFF}16. <t><t>{FFA500}30000 Яиц - Mercedes_Maybach Bision 6 [ID: 15177]{FFFFFF}",
			"Далее", "Закрыть"
			);
		}
	if(newkeys & 1024)
	 {
		OpenPlayersContainers(playerid);

		OpenItemContainers(playerid);

		for(new i; i < MAX_SVALKA_CARS; i++)
		{
			if(g_svalka_cars[i][S_CAR_TIME] == 0) continue;
			if(IsPlayerInRangeOfPoint(playerid, 4.0, g_svalka_pos_cars[i][0], g_svalka_pos_cars[i][1], g_svalka_pos_cars[i][2])) return OnPlayerOpenDump(playerid, i, 1);
		}
		for(new i; i < MAX_SVALKA_ITEMS; i++)
		{
			if(g_svalka_items[i][S_ITEM_TIME] == 0) continue;
