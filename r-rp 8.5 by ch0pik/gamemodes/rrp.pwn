public: StopHorn(playerid)
{
	MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "window.destroySound(10311, 30)");
	return 1;
}
stock AutoRWC()
{
	if(timer_rwc != -1)
	{
		timer_rwc--;
	}
	if(timer_rwc == 60)
	{
		SendClientMessageToAll(0xFFCD00FF, "(РВС): Внимание...");
		SendClientMessageToAll(0xFFCD00FF, "(РВС): Уважаемые игроки, через минутку пройдет респавн незадейственного транспорта...");
		SendClientMessageToAll(0xFFCD00FF, "(РВС): Просим Вас занять Ваши автомобили, что бы они не пропали...");
	}
	if(timer_rwc == 30)
	{
		SendClientMessageToAll(0xFFCD00FF, "(РВС): Респавн незадейственного транспорта пройдет через 30 секунд...");
	}
	if(timer_rwc == 0)
	{
		SendClientMessageToAll(0xFFCD00FF, "(РВС): Проходит респавн незадействованного транспорта...");
		new vehicles_count;
		for(new i = 1; i < MAX_VEHICLES; i++)
		{
		if(!IsValidVehicle(i)) continue;
		else if(IsVehicleOccupied(i)) continue;
		else if(IsTrailerAttachedToAnyVehicle(i)) continue;
		SetVehicleToRespawn(i);
		vehicles_count++;
		}
		SendClientMessageToAll(0xFFCD00FF, "(РВС): Респавн незадействованного транспорта прошел успешно.");
		timer_rwc = 1800;
	}
}
stock SetOrgCarStage(playerid, vehicleid)
{
    new modelid = GetVehicleData(vehicleid, V_MODELID);
    new hangl_id = GetVehicleHandlingID(modelid);
    new data_id = GetVehicleHandling(hangl_id);
    new Float: engine_acel = g_handling_data[data_id][E_ENGINE_ACCELERATION]+50.0;
    SetVehicleHandling(playerid, vehicleid, 15, 0.0, 0.0, 25.0, engine_acel * 4, 0.0, 50.0, 0.0);
    return 1;
}
stock SetOrgCarToner(playerid, vehicleid) {         
    for(new i = 0; i < 3; i++)
    {
        Sendpacket_toner(playerid, vehicleid, i, 0, 0, 0, 255);
    }
}
//лиzард лох ебанный
stock SetOrgCarStrob(playerid, vehicleid)
{
    {
        if(IsPlayerInVehicle(playerid, vehicleid)) 
        {
            MakeStroboskopes(playerid);
        }
    }

    return 1;
}

public: StartGiveaway()
{
    new playerCount = GetPlayerPoolSize();
    if (playerCount > 0)
    {
        new randomPlayer = GetRandomPlayer();
        if (IsPlayerConnected(randomPlayer))
        {
            SendClientMessageToAll(COLOR_ORANGE, "[Информация] {FFFFFF}Приз получит случайный игрок.");
			SendClientMessageToAll(COLOR_ORANGE, "[Информация] {FFFFFF}Через 30 минут снова случайный  игрок получит приз.");
            GivePrizes(randomPlayer);
            new playerName[MAX_PLAYER_NAME];
            GetPlayerName(randomPlayer, playerName, sizeof(playerName));
            new message[128];
            format(message, sizeof(message), "[Информация] {FFFFFF}Выиграл игрок: {C3C3C3}%s", playerName);
            SendClientMessageToAll(COLOR_ORANGE, message);
			SendClientMessageToAll(COLOR_ORANGE, "[Информация] {FFFFFF}Приз Кейсы/Ключи, денги и Донат-монеты!");
        }
    }
    return 1;
}
stock GetRandomPlayer()
{
    new playerList[MAX_PLAYERS], count = 0;
    for (new i = 0; i < MAX_PLAYERS; i++)
    {
        if (IsPlayerConnected(i))
        {
            playerList[count++] = i;
        }
    }
    return playerList[random(count)];
}
stock GivePrizes(playerid)
{
    GiveIteam(playerid, 355, 1, 10, 0);
    GiveIteam(playerid, 259, 1, 10, 0);
    GiveIteam(playerid, 258, 1, 10, 0);
	GiveIteam(playerid, 360, 1, 20, 0);
    GivePlayerDonate(playerid, RandomEx(100, 400));
    GivePlayerMoneyEx(playerid, RandomEx(2000000, 25000000));
}
stock Vzriv_MO()
{
    for(new i = 0; i < MAX_BOMBA; i++)
    {
		CreateDynamic3DTextLabel(WallDestroyed ? "Стена\n{FFFFFF}Подойдите для реконструкции" : "{FFFF00}-В стене есть маленькая брошь-",
        0xFFFF00FF, MO_BOBMA[i][0], MO_BOBMA[i][1], MO_BOBMA[i][2], 2.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 
        WallDestroyed ? TEAM_ARMY : -1);
    }
}

forward RestoreWall(i, playerid);
public RestoreWall(i, playerid)
{
    if(WallDestroyed)
    {
        DestroyDynamicObject(ObjectIDS[i]);
        ObjectIDS[i] = CreateDynamicObject(18538, MO_BOBMA[i][0], MO_BOBMA[i][1], MO_BOBMA[i][2], 0.0, 0.0, 0.0);
        WallDestroyed = false;
        BombaStatus[i][0] = 0;
		g_player_progress_bar_type[playerid] = 0;
    	}
	}

forward ExplodeWall(i, playerid);
public ExplodeWall(i, playerid)
{
    if(BombaStatus[i][0] == 1)
    {
        WallDestroyed = true;
        DestroyDynamicObject(ObjectIDS[i]);
        ObjectIDS[i] = CreateDynamicObject(18539, MO_BOBMA[i][0], MO_BOBMA[i][1], MO_BOBMA[i][2], 0.0, 0.0, 0.0);
        CreateExplosion(MO_BOBMA[i][0], MO_BOBMA[i][1], MO_BOBMA[i][2], 2, 1);
        SetTimerEx("RestoreWall", 600000, false, "d", i);
    	}
	}
public: GrinderUse(playerid) 
{
    new Float:player_x, Float:player_y, Float:player_z;
    GetPlayerPos(playerid, player_x, player_y, player_z);
    
    if(GetDistanceBetweenPoints(player_x, player_y, player_z, grate_x, grate_y, grate_z) > 3.0)
    {
        SendClientMessage(playerid, 0x999999FF, "* Вы должны находиться рядом с решёткой, чтобы использовать болгарку.");
		if(GetIteam(playerid, 369) < 1) return SendClientMessage(playerid, 0xFF0000, "У Вас нет болгарки");
        return 0;
    }
    
    if(g_grate_cut)
    {
        SendClientMessage(playerid, 0x999999FF, "* Эта решётка уже разрезана.");
        return 0;
    }
    
    g_player_progress_bar_type[playerid] = 1;
	g_player_progress_bar[playerid] = 0;
    MoralPacket_2(playerid, s_CefInterface, t_CefShow, "ProgressBar", "[[\"Нажимайте Y<br>с небольшим интервалом\", 0, 1000]]");
    
    SetTimerEx("FinishCutting", 10000, false, "i", playerid);
	SetTimerEx("RestoreGrate", 600000, false, "i", 0);
	
    return 1;
}

forward FinishCutting(playerid);
public FinishCutting(playerid)
{
    new Float:player_x, Float:player_y, Float:player_z;
    GetPlayerPos(playerid, player_x, player_y, player_z);
    if(GetDistanceBetweenPoints(player_x, player_y, player_z, grate_x, grate_y, grate_z) > 3.0)
    {
        GameText(playerid, "~b~~h~Вы отошли от решётки, резка прервана", 4000, 2);
        return;
    }
    
    if(g_grate_object != INVALID_OBJECT_ID)
    {
        DestroyDynamicObject(g_grate_object); 
        g_grate_object = INVALID_OBJECT_ID;
        g_grate_cut = true; 
    }

	if (g_grate_object) 
    {     
        CreateDynamic3DTextLabel("{FFFF00}-В решётке есть маленькая брошь-",
        0xFFFF00FF, grate_x, grate_y, grate_z, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0);
    }
	GiveIteam(playerid, 369, 0, 1, 0, "Болгарка");
    GameText(playerid, "~g~Успешная срезка", 4000, 1);
}

forward RestoreGrate(i);
public RestoreGrate(i)
{
    if(g_grate_cut)
    {
        g_grate_object = CreateDynamicObject(17113, grate_x, grate_y, grate_z, 0, 0, 89.9999);
        g_grate_cut = false;  
    }
}
stock CheckCarMaxSpeedByID(vehicleid)
{
	new speed;

	new modelid = GetVehicleData(vehicleid, V_MODELID);
	new model_index = GetVehicleHandlingID(modelid);
	new handling = GetVehicleHandling(model_index);

	speed = floatround(g_handling_data[handling][E_MAXGEAR_VELOCITY]);

	return speed;
}
public: ShowUpdateServer(playerid)
{
	static fmt_str[64];
	new rows = cache_num_rows();

	if(!rows)
	{
		return Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "Доступ обновлений", "{FFFFFF}Пусто", "Закрыть", "");
	}

	string_dialog = "{FFFFFF}";
	for(new idx; idx < rows; idx ++)
	{
		cache_get_row(idx, 0, fmt_str);
		strcat(fmt_str, "\n");

		strcat(string_dialog, fmt_str);
	}
	return Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "Доступ обновлений", string_dialog, "Закрыть", "");
}
forward CheckCaptureEvents();
public CheckCaptureEvents()
{
    new hour, minute, second;
    gettime(hour, minute, second);

    new year, month, day;
    getdate(year, month, day);

    new weekday = GetDayOfWeek(day, month, year);

    if(hour == 18 && minute == 0)
    {
        switch(weekday)
        {
            case 0: CentralMansionCapture = true;
            case 3: WestMansionCapture = true;
            case 5: NorthMansionCapture = true;
            case 6: PelaBaseCapture = true;
        }
    }
	else if (hour == 18 && minute == 45)
    {
		switch(weekday)
        {
            case 0: CentralMansionCapture = false;
            case 3: WestMansionCapture = false;
            case 5: NorthMansionCapture = false;
            case 6: PelaBaseCapture = false;
        }
	}
    return 1;
}
