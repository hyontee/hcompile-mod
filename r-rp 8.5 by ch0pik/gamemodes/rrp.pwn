                        "Далее", "Закрыть"
                    );
                }
                case 7: // Спавны
                {
                    Dialog
                    (
                        playerid, DIALOG_TELEPORT_SPAWN, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации | {FAFAD2}Спавны",
                        "{FAFAD2}[1] Главный спавн Аразамаса\n"\
