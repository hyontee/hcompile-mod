		SCM(playerid, COLOR_ORANGE, "Новое задание: Угоните ментовскую гранту с стоянки списанных машин и привезите бандитам!(если машины нет, значит кто то уже выполняет это задание, подождите спавна машины)");
		EnablePlayerGPS(playerid, 55, -2831.3577,-1398.4966,9.7797, "Машина отмечена на вашем GPS");
		MoralPacket_2(playerid, s_CefInterface, t_CefShow, "QuestsProgressInfo", "[0, 0, 1, \"Текущее Задание\", \"Угнать ментовскую машину\", 0]");
		SetPlayerData(playerid, P_QUESTS, 3);

