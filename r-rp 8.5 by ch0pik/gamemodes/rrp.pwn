forward OnLoadRChannels(playerid);
public OnLoadRChannels(playerid)
{
	new rows = cache_num_rows();
	if(rows == 0)
	{
		SendClientMessage(playerid, 0xCECECEFF, "У вашей организации нет созданных каналов");
		return 1;
	}

	static string[2048];
	format(string, sizeof(string), "Ид\tНазвание\tВолна\tКол-во человек в волне\tСтатус\n");

	for(new i = 0; i < rows; i++)
	{
		new id = cache_get_field_content_int(i, "id");
		new channel_name[64];
		cache_get_field_content(i, "channel_name", channel_name);

		new wave_frequency = 100 + i;
		new players_count = 0;

		foreach(new j: Player)
		{
			if(GetPlayerTeamEx(j) == GetPlayerTeamEx(playerid) && rChannelPlayer{j} == (i + 1))
			{
				players_count++;
			}
		}

		format(string, sizeof(string), "%s%d\t%s\t%d.0\t%d\tАктивен\n", string, id, channel_name, wave_frequency, players_count);
	}

	Dialog(playerid, DIALOG_RCHANNEL, DIALOG_STYLE_TABLIST_HEADERS, "Каналы организации", string, "Выбрать", "Отмена");
	return 1;
}

forward OnCreateRChannel(playerid);
public OnCreateRChannel(playerid)
{
	SendClientMessage(playerid, 0x00FF00FF, "Канал успешно создан!");
	return 1;
}
stock FixTableChat(playerid, forplayer) {
	new type = GetPVarInt(forplayer,"voice_active");
	switch(type) {
		case 1: {
			format(STRING_GLOBAL,sizeof STRING_GLOBAL, "interface('Hud').removeVoiceChatEntry([[%d,%d]])",forplayer,forplayer);
			SendClientEvent(playerid, t_CefUpdate, STRING_GLOBAL);
		}
		case 2: {
			format(STRING_GLOBAL,sizeof STRING_GLOBAL, "interface('Hud').removeVoiceChatEntry([[%d,1000]])",(forplayer+1000));
			SendClientEvent(playerid, t_CefUpdate, STRING_GLOBAL);
		}
	}
}
stock SetSpeakerPlayer(playerid, type) {
	if(type) {
		SetPVarInt(playerid, #Speaker, 1);
		SendClientEvent(playerid, t_CefUpdate, "interface('Hud').showVoiceChatButton(2)");
		foreach(VoicePlayers[playerid], id)
			VoiceOpenStream(id, playerid+2000, 1500.0, true, playerid);
	}
	else {
		if(!GetPVarInt(playerid, #Speaker)) return 1;
		DeletePVar(playerid, #Speaker);
		SendClientEvent(playerid, t_CefUpdate, "interface('Hud').hideVoiceChatButton(2)");
		foreach(VoicePlayers[playerid], id)
			VoiceCloseStream(id, playerid+2000);
	}
	return 1;
}

stock SendPacketVoice(playerid, BitStream: bs)
{
    new BitStream:bsV = BS_New(), bytes;

    BS_WriteValue(bsV,
        PR_UINT8, 215,
        PR_UINT16, 3,
        PR_UINT32, playerid
    );

    BS_SetReadOffset(bs, 24);
    BS_GetNumberOfBytesUsed(bs, bytes);

    BS_WriteValue(bsV, PR_UINT32, bytes);

    for (new i, uint8; i < bytes; i++)
        BS_ReadUint8(bs, uint8), BS_WriteValue(bsV, PR_UINT8, uint8);
    
    BS_Delete(bsV);
    return 1;
}
stock SendPacketRadio(playerid, handle, BitStream: bs)
{
    new BitStream:bsV = BS_New(), bytes;

    BS_WriteValue(bsV,
        PR_UINT8, 215,
        PR_UINT16, 3,
        PR_UINT32, handle
    );

    BS_SetReadOffset(bs, 24);
    BS_GetNumberOfBytesUsed(bs, bytes);

    BS_WriteValue(bsV, PR_UINT32, bytes - 3);

    foreach(new i: Player) {
        if(i == playerid) continue;
        if(GetPlayerTeamEx(playerid) != GetPlayerTeamEx(i) || rChannelPlayer{playerid} != rChannelPlayer{i}) continue;
        PR_SendPacket(bsV, i);
    }
    BS_Delete(bsV);
    return 1;
}
