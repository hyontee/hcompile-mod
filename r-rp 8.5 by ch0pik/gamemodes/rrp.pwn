stock SendPacket_Chat(playerid, states)
{
    new
        BitStream:bsn = BS_New();

    BS_WriteValue(bsn, PR_UINT8, ID_CEF_RPC);
    BS_WriteValue(bsn, PR_UINT16, 29);
    BS_WriteValue(bsn, PR_UINT32, playerid);
	BS_WriteValue(bsn, PR_UINT32, states);

    PR_SendPacketToPlayerStream(bsn, playerid);
    BS_Delete(bsn);
}
public: OnVoiceChatEndRecord(playerid,key) {
	if(!GetPVarInt(playerid, "voice_active")) return 1;
	DeletePVar(playerid, "voice_active");
	STRING_GLOBAL[0] = EOS;
	if(key == 85 && rChannelPlayer{playerid}) {
		format(STRING_GLOBAL,sizeof STRING_GLOBAL, "interface('Hud').removeVoiceChatEntry([[%d,1000]])",(playerid+1000));
		foreach(new i: Player) {
			if(GetPlayerTeamEx(playerid) != GetPlayerTeamEx(i) || rChannelPlayer{playerid} != rChannelPlayer{i}) continue;

			SendClientEvent(i, t_CefUpdate, STRING_GLOBAL);
		}
		return 1;
	}
	return 0; 
}
public: OnVoiceChatStartRecord(playerid,key) {
	STRING_GLOBAL[0] = EOS;
	
	if(key == 85 && rChannelPlayer{playerid}) {
		SetPVarInt(playerid,"voice_active", 2);
		format(STRING_GLOBAL,sizeof STRING_GLOBAL, "interface('Hud').addVoiceChatEntry([1,\"%s\",%d,1,\"10%d.0\",1000])",GetPlayerNameEx(playerid),(playerid+1000), rChannelPlayer{playerid}-1);
		foreach(new i: Player) {
			if(GetPlayerTeamEx(playerid) != GetPlayerTeamEx(i) || rChannelPlayer{playerid} != rChannelPlayer{i}) continue;

			SendClientEvent(i, t_CefUpdate, STRING_GLOBAL);
		}
		return 1;
	}
	return 0; 
}
stock SendPacket_Voice_Table(playerid)
{
    new
        BitStream:bsn = BS_New();

    BS_WriteValue(bsn, PR_UINT8, ID_CEF_RPC);
    BS_WriteValue(bsn, PR_UINT16, 3);
    BS_WriteValue(bsn, PR_UINT32, playerid);
	BS_WriteValue(bsn, PR_UINT32, 1);

    PR_SendPacketToPlayerStream(bsn, playerid);
    BS_Delete(bsn);
}
stock SendVoice(playerid, bytes)
{
	new
		BitStream:bsn = BS_New();  

	BS_WriteValue(bsn, PR_UINT8, 215);
	BS_WriteValue(bsn, PR_UINT16, 3);
	BS_WriteValue(bsn, PR_UINT32, playerid);
	BS_WriteValue(bsn, PR_UINT32, bytes);
	BS_WriteValue(bsn, PR_UINT8, 123);
	BS_WriteValue(bsn, PR_UINT8, 133);
	
	PR_SendPacket(bsn, playerid);

	PR_SendPacketToPlayerStream(bsn, playerid);
	
	BS_Delete(bsn);
}
stock SendVolumeVoice(forplayer, index, idx)
{
 	new
		BitStream:bsn = BS_New();

	BS_WriteValue(bsn, PR_UINT8, 215);
	BS_WriteValue(bsn, PR_UINT16, 4);
	BS_WriteValue(bsn, PR_UINT32, forplayer);
	BS_WriteValue(bsn, PR_UINT16, index);
	BS_WriteValue(bsn, PR_UINT16, idx);
	PR_SendPacket(bsn, forplayer);
	//printf("player %d index %d idx %d",forplayer,index,idx);
	PR_SendPacketToPlayerStream(bsn, forplayer);
	BS_Delete(bsn);
}

new count_cef_rpc[MAX_PLAYERS];

public OnIncomingPacket(playerid, packetid, BitStream:bs)
{
	//SCMF(playerid, -1, "OnIncomingPacket(playerid, %d, BitStream:%d)", packetid, bs);

	switch (packetid) {
		case 207: {

			if(!IsPlayerLogged(playerid))
			{
				if(GetPlayerPing(playerid) > 250)
				{
					printf("{FFFFFF}["SERVER_NAME_RP"]: Обнаружено подключение бота на сервер | %s", GetPlayerNameEx(playerid));
					Kick(playerid);
					return 1;
				}
			}
		}
		case ID_CEF_RPC: {

			new bytes;

			BS_GetNumberOfBytesUsed(bs, bytes);

			if (bytes < 6) {
			return 0;
			}

			new
			style, types;

			BS_IgnoreBits(bs, 8);
			BS_ReadUint16(bs, style);
			BS_ReadUint32(bs, types);
			
			if(style == 29)
			{
				SendPacket_Chat(playerid,types);
			}
			if (style == 3)
            {
                if (bytes < 20) return 1;
                new type = GetPVarInt(playerid, #voice_active);

                if(type == 1) SendPacketVoice(playerid, bs);
                else if(type == 2 && rChannelPlayer{playerid}) SendPacketRadio(playerid, (playerid + 1000), bs);
                return 1;
            }
			if(style == 1)
			{
				new hardware[250],
					test[250],
						xz;
				BS_ReadUint8(bs, xz);
				if(types == 50) {//MOBILE
					online[2]++;
				}
				else {
					online[1]++;
				}
				BS_ReadString32(bs, hardware);
				BS_ReadString32(bs, test);
				format(g_player[playerid][P_HARDWARE_ID_TEMP], 250, "%s", hardware);
				GetHardwareIDBanned(playerid, hardware);
			}

			if (style == _:s_CefInterface) {

				new
					call[64 + 1];

				BS_ReadString32(bs, call);


	            if (strcmp(call, "EndedInitializeBrowser") == 0) {

					#if defined EndedInitializeBrowser
						EndedInitializeBrowser(playerid);
					#endif
				}else if(strcmp(call, "Business_OnPlayerEnter") == 0) {
	                Business_OnPlayerEnter(playerid);
				}else if(strcmp(call, "ClickPlayerContainerItemBox") == 0) {

					new
						event;

	                BS_IgnoreBits(bs, 40);

	                BS_ReadUint32(bs, event);


					#if defined ClickPlayerContainerItemBox
						ClickPlayerContainerItemBox(playerid, event);
					#endif
				}else if(strcmp(call, "OnVoiceChatEndRecord") == 0) {
				    new event;

	                BS_IgnoreBits(bs, 40);
	                BS_ReadUint32(bs, event);

					#if defined OnVoiceChatEndRecord
						OnVoiceChatEndRecord(playerid, event);
					#endif
				}else if(strcmp(call, "OnVoiceChatStartRecord") == 0) {
				    new event;

	                BS_IgnoreBits(bs, 40);
	                BS_ReadUint32(bs, event);

					#if defined OnVoiceChatStartRecord
						OnVoiceChatStartRecord(playerid, event);
					#endif
				}else if(strcmp(call, "P3_OnPlayerChangeVolume") == 0) { 
          
					new volume, type;

					BS_IgnoreBits(bs, 40);
					BS_ReadUint32(bs, type);
					BS_IgnoreBits(bs, 8);
					BS_ReadUint32(bs, volume);

					#if defined P3_OnPlayerChangeVolume
						P3_OnPlayerChangeVolume(playerid, type, volume);
					#endif
				}else if(strcmp(call, "P3_OnPlayerCloseInterface") == 0) { 
          
					new event;

					BS_IgnoreBits(bs, 8);
					BS_ReadUint32(bs, event);

					#if defined P3_OnPlayerCloseInterface
						P3_OnPlayerCloseInterface(playerid, event);
					#endif
				}else if(strcmp(call, "OnContainersChangeBet") == 0) {

	                new
						bet;

	                BS_IgnoreBits(bs, 40);
	                BS_ReadUint32(bs, bet);

					#if defined OnContainersChangeBet
						OnContainersChangeBet(playerid, bet);
					#endif
				}else if(strcmp(call, "OnPlayerOpenMenuPause") == 0){

		            #if defined OnPlayerOpenMenuPause
		                OnPlayerOpenMenuPause(playerid);
					#endif
				} else if(strcmp(call, "OnContainersCloseBet") == 0) {

