			if(GetVehicleInfo(GetOwnableCarData(index, OC_MODEL_ID), VI_TYPE) != 0) return SCM(playerid, 0xFF6600FF, "* Данный класс авто не подходит под этот авторынок!");

			new business = GetNearestBusiness(playerid, 60.0);
