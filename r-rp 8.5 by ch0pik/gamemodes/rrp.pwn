cmd:unrentmoto(playerid)
{
	if(GetPlayerData(playerid, P_RENT_MOPED) == INVALID_VEHICLE_ID) return SendClientMessage(playerid, -1, "* У вас нет арендованного мотоцикла!");
	new veh_id = GetPlayerData(playerid, P_RENT_MOPED);
