public: ActionBot_OnPressButton(playerid, event, id_actor)
{
    MoralPacket_1(playerid, s_CefInterface, t_CefHide, "ActorDialog");
	if(event == 0 && id_actor == 1)
	{
		SendClientEventWithArg(playerid, t_CefShow, "ActorDialog","[2, \"Молодой человек, помогите мне, я играл в казино на свои честно заработанные деньги и бандиты обокрали меня!\", \"\", \"Егор\", [[\"Чем я могу вам помочь?\",\"Agressive\",\"\"]],[\"\"]]");
	}
	if(event == 0 && id_actor == 2)
	{
  		SendClientEventWithArg(playerid, t_CefShow, "ActorDialog","[3, \"Отправляйся в казино г.Южный у узнай про бандитов у крупье, он был свидетелем!\", \"\", \"Егор\", [[\"Хорошо, постараюсь помочь вам!\",\"Agressive\",\"\"]],[\"\"]]");
	}
	if(event == 0 && id_actor == 3)
	{
		MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "closeInterface('ActorDialog')");
		SCM(playerid, COLOR_ORANGE, "Новое задание: Отправляйтесь в казино 'Роял' и получите полезную информацию у крупье!");
		EnablePlayerGPS(playerid, 98, 1925.7467,-1936.9495,31.7932, "Крупье отмечен на вашем GPS");
		MoralPacket_2(playerid, s_CefInterface, t_CefShow, "QuestsProgressInfo", "[0, 0, 1, \"Текущее Задание\", \"Отправляйтесь в казино 'Royal' к крупье\", 0]");
		

	}
	if(event == 0 && id_actor == 4)
	{
  		SendClientEventWithArg(playerid, t_CefShow, "ActorDialog","[5, \"Какой у вас вопрос?\", \"\", \"Крупье\", [[\"Я от Егора, его обокрали и он сказал мне что вы можете дать информацию про бандитов.\",\"Agressive\",\"\"]],[\"\"]]");
		MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "closeInterface('QuestsProgressInfo')");
	}
	if(event == 0 && id_actor == 5)
	{
  		SendClientEventWithArg(playerid, t_CefShow, "ActorDialog","[6, \"Да, знаю я этих бандитов, не первый раз тут такое происходит. Это местные бандюки и нахоядятся они около сгоревшого дома\", \"\", \"Крупье\", [[\"Понял, спасибо вам за информацию!\",\"Agressive\",\"\"]],[\"\"]]");
	}
	if(event == 0 && id_actor == 6)
	{
		MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "closeInterface('ActorDialog')");
		SCM(playerid, COLOR_GREEN, "Задание: Поговорить с крупье, выполнено!");
		SCM(playerid, COLOR_ORANGE, "Новое задание: Отправляйтесь к дому пэла и попробуйте поговорить с бандитом!");
		EnablePlayerGPS(playerid, 55, 1461.3097,-1146.3622,11.9644, "Бандит отмечен на вашем GPS");
		MoralPacket_2(playerid, s_CefInterface, t_CefShow, "QuestsProgressInfo", "[0, 0, 1, \"Текущее Задание\", \"Поговорить с бандитами у сгоревшего дома \", 0]");

	}
	if(event == 0 && id_actor == 7)
	{
  		SendClientEventWithArg(playerid, t_CefShow, "ActorDialog","[8, \"Нифига ты захотел, теряйся давай пока рожу не набили\", \"\", \"Бандит\", [[\"Ну давайте я что-нибудь сделаю чтобы вы вернули вещи Егора\",\"Agressive\",\"\"]],[\"\"]]");
		MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "closeInterface('QuestsProgressInfo')");
	}
	if(event == 0 && id_actor == 8)
	{
  		SendClientEventWithArg(playerid, t_CefShow, "ActorDialog","[9, \"Ну ладно сопляк, все равно наше задание не выполнишь.\", \"\", \"Бандит\", [[\"Я готов!\",\"Agressive\",\"\"]],[\"\"]]");
	}
	if(event == 0 && id_actor == 9)
	{
  		SendClientEventWithArg(playerid, t_CefShow, "ActorDialog","[10, \"Тебе нужно угнать ментовскую гранту, именно гранту! и привезти ее к нам.\", \"\", \"Бандит\", [[\"Хорошо, я постараюсь выполнить ваше задание.\",\"Agressive\",\"\"]],[\"\"]]");
	}
