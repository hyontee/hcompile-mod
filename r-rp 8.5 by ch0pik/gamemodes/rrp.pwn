	E_TYPE_WAID_DIAGNOSTIC,
	E_TYPE_ROULETTE,
	E_TYPE_TOILET_CLEAR,
	E_TYPE_JAIL_DOORS,
	E_TYPE_JAIL_DOORS_WORLD,
	E_TYPE_JAIL_ALERT,
	E_TYPE_JAIL_CAMERA,
	E_TYPE_JAIL_TRADE,
	E_TYPE_ADVENT,
	E_TYPE_HACKING,
	E_TYPE_UGONKA,
	E_TYPE_STAGE_END_TEST_DRIVE,
	E_TYPE_FUELBIZ,
}
stock InteractionUse(playerid, type)
{
    switch(g_interactions[type][E_I_TYPE])
    {
		
		case E_TYPE_TOILET_CLEAR: ToiletJail(playerid);
		case E_TYPE_JAIL_DOORS: JailUseDoor(playerid, 0);
		case E_TYPE_JAIL_DOORS_WORLD: JailUseDoor(playerid, 1);
		case E_TYPE_JAIL_CAMERA: ShowCamera(playerid);
		case E_TYPE_JAIL_TRADE: ShowDialogJTrade(playerid);
		case E_TYPE_FUELBIZ: callcmd::i(playerid, "");
	}
	return 1;
}
