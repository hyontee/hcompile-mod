                        "{FAFAD2}[6] Спавн Эдово",
                        "Далее", "Закрыть"
                    );
                }
                case 8: // Админ зона
                {
                    Dialog
                    (
                        playerid, DIALOG_TELEPORT_ADMIN, DIALOG_STYLE_LIST, "{FFFFFF} Меню Телепортации | {FAFAD2}Админ зона",
                        "{FAFAD2}[1] Админ зона",
                        "Далее", "Закрыть"
                    );
                }
            }
            return 1;
        }

        case DIALOG_TELEPORT_BUSINESS:
        {
            if(!response) return AdminTeleportList(playerid);
            switch(listitem + 1)
            {
                case 1: SetPlayerPosEx(playerid, 1868.9000,2822.1799,12.0000, 0.0, 0, 0);
