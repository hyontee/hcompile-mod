			static fmt_text[144];
			mysql_format(mysql, fmt_text, sizeof fmt_text, "SELECT * FROM arenda_cars WHERE vehicleid='%d'", vehicleid);
			result = mysql_query(mysql, fmt_text, true);

			SetRentCarData(idm, R_SQL_ID, 		cache_get_field_content_int(0, "id"));

