public:CB_RemoveMCoinsOff(playerid, count, name[])
{
    if(!cache_num_rows()) return SCM(playerid, COLOR_GREY, "Игрок с таким именем не найден.");

    new acc_id = cache_get_row_int(0, 0);

    string_mrllwns[0] = EOS;
    format(string_mrllwns, sizeof string_mrllwns, "UPDATE PlayersMorallwens SET coins=coins-%d WHERE id=%d",count, acc_id);
    mysql_pquery(mysql, string_mrllwns);

    SCMF(playerid, COLOR_GOLD, "Вы успешно сбросили %s %d "SERVER_COINS_NAME"", name, count);

    string_mrllwns[0] = EOS;
	format(string_mrllwns, 200, "%s сбросил оффлайн %s [acc_id %d] %d "SERVER_COINS_NAME"",GetPlayerNameEx(playerid),name,acc_id, count);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, string_mrllwns);    

    return true;
}

public: Plain.OnPlayerDeath(playerid)
{
	if(PlayerIsPlain[playerid] == 1)
	{
		DestroyVehicle(PlainVeh[playerid]);
		PlayerIsPlain[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
	}
    return 1;
}
public: Plain.OnPlayerExitVehicleEx(playerid)
{
	if(PlayerIsPlain[playerid] == 1)
	{
		DestroyVehicle(PlainVeh[playerid]);
		PlayerIsPlain[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
		SetPlayerPos(playerid, 2813.6899,-2036.2950,21.3944);
		GameText(playerid, "Рейс окончен!",3,5000);
	}
    return 1;
}
public: PlainStoped(playerid)
{
	SCM(playerid, 0x999999FF, "* Отправляйтесь в Россию для высадки пассажиров!");
	SCM(playerid, 0x999999FF, "* По пути Вы будет получать вознаграждение!");
	SCM(playerid, 0x999999FF, "* Чтобы закончить рейс выпрыгните из самолёта.");
	GameText(playerid, "Высадка прошла успешно!",2000,3);
	SetPlayerRaceCheckpoint(playerid,3,gPlainPoints[23][0], gPlainPoints[23][1], gPlainPoints[23][2],gPlainPoints[23][3], gPlainPoints[23][4], gPlainPoints[23][5],20.0,2001);
	TogglePlayerControllable(playerid,true);
}
public: PlainMaimiGo(playerid)
{
	SCM(playerid, 0x999999FF, "* Отправляйтесь в Майами для высадки пассажиров!");
	SCM(playerid, 0x999999FF, "* По пути Вы будет получать вознаграждение!");
	SCM(playerid, 0x999999FF, "* Чтобы закончить рейс выпрыгните из самолёта.");
	GameText(playerid, "Посадка прошла успешно!",2000,3);
	SetPlayerRaceCheckpoint(playerid,3,gPlainPoints[4][0], gPlainPoints[4][1], gPlainPoints[4][2],gPlainPoints[4][3], gPlainPoints[4][4], gPlainPoints[4][5],20.0,RCP_ACTION_TYPE_PILOT_1);
	TogglePlayerControllable(playerid,true);
}
stock PrizePlain(playerid)
{
	GivePlayerMoneyEx(playerid, RandomEx(250000, 500000));
}

stock GetActiveAcsName(acs_id)
{
	static fmt_text[24];
	for(new i; i < sizeof g_info_active_accessories; i++)
	{
		if(g_info_active_accessories[i][ACTIVE_ACS_ID] != acs_id)
			continue;

		format(fmt_text, sizeof fmt_text, "%s", g_info_active_accessories[i][ACTIVE_ACS_NAME]);
		break;
	}

	return fmt_text;
}

stock IsActiveAcsID(acs_id)
{
	for(new i; i < sizeof g_info_active_accessories; i++)
	{
		if(g_info_active_accessories[i][ACTIVE_ACS_ID] != acs_id)
			continue;

		return 1;
	}
	return 0;
}

