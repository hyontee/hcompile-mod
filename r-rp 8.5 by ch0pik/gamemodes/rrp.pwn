new zone_war_a[MAX_BUSINESS];

enum E_FAMILY_STRUCT // структура семьи
{
    F_SQL_ID,       // ид аккаунта
    F_NAME[63 + 1], // название семьи
    F_USER_ID,      // создатель семьи
    F_TIME,         // время создания
    F_COLOR,        // цвет семьи
    F_LEVEL,        // уровень семьи
    F_EXP,          // опыт семьи
    F_RANK1[32],    // ранг 1
    F_RANK2[32],    // ранг 2
    F_RANK3[32],    // ранг 3
    F_RANK4[32],    // ранг 4
    F_RANK5[32],    // ранг 5
