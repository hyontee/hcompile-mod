	format(STRING_GLOBAL, sizeof STRING_GLOBAL,"[\"%s\"]",text);
	MoralPacket_2(playerid, s_CefInterface, t_CefShow, "DisplayText", STRING_GLOBAL);
	SetTimerEx("CloseDisplayText", time, false, "i", playerid);
}
