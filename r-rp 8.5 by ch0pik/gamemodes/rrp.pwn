		MoralPacket_2(playerid, s_CefInterface, t_CefShow, "QuestsProgressInfo", "[0, 0, 1, \"Текущее Задание\", \"Отдать Егору его вещи!\", 0]");
		SetPlayerData(playerid, P_QUESTS, 6);

	}
	if(event == 0 && id_actor == 12)
	{
  		SendClientEventWithArg(playerid, t_CefShow, "ActorDialog","[13, \"Ура, спасибо тебе большое, за то, что вернул мои вещи я хочу дать тебе награду в виде 333 coins!\", \"\", \"Егор\", [[\"Спасибо Егор, удачи тебе!\",\"Agressive\",\"\"]],[\"\"]]");
	}
	if(event == 0 && id_actor == 13)
	{
		static query[122];

		MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "closeInterface('ActorDialog')");
		MoralPacket_1(playerid, s_CefInterface, t_CefUpdate, "closeInterface('QuestsProgressInfo')");
		SCM(playerid, COLOR_GREEN, "Вы успешно завершили прохождение квестовой линии с Егором и получили награду: 1100 RUB! и 25.000.000р");
