		}
		if(IsPlayerInRangeOfPoint(playerid, 2.5, 191.6914,-293.2050,1012.8684))
		{
			InterpolateCameraPos(playerid, 191.293655, -295.537445, 1014.428344, 191.2720, -293.0270, 1014.7610, 2000);
