stock DellMansionOwner()
{
	for(new fam_id = 0; fam_id <= g_family_loaded; fam_id++)
	{
		if(CentralMansionCapture == true)
        {
		    if(GetFamilyData(fam_id, F_CENTRAL_MANSION) == 1) 
            {
                SetFamilyData(fam_id, F_CENTRAL_MANSION, 0);

		        static query[250];
		        mysql_format(mysql, query, sizeof query, "UPDATE family SET CentralMansion=0 WHERE id=%d LIMIT 1", fam_id);
		        mysql_query(mysql, query, false);
			}
        }
		if(WestMansionCapture == true)
        {
		    if(GetFamilyData(fam_id, F_WEST_MANSION) == 1) 
            {
                SetFamilyData(fam_id, F_WEST_MANSION, 0);

		        static query[250];
		        mysql_format(mysql, query, sizeof query, "UPDATE family SET WestMansion=0 WHERE id=%d LIMIT 1", fam_id);
		        mysql_query(mysql, query, false);
			}
        }
		if(NorthMansionCapture == true)
        {
		    if(GetFamilyData(fam_id, F_NORTH_MANSION) == 1) 
            {
                SetFamilyData(fam_id, F_NORTH_MANSION, 0);

		        static query[250];
		        mysql_format(mysql, query, sizeof query, "UPDATE family SET NorthMansion=0 WHERE id=%d LIMIT 1", fam_id);
		        mysql_query(mysql, query, false);
			}
        }
		if(PelaBaseCapture == true)
        {
            if(GetFamilyData(fam_id, F_PELA_BASE) == 1) 
            {
                SetFamilyData(fam_id, F_PELA_BASE, 0);

		        static query[250];
		        mysql_format(mysql, query, sizeof query, "UPDATE family SET PelaBase=0 WHERE id=%d LIMIT 1", fam_id);
		        mysql_query(mysql, query, false);
			}
        }
	}
}

stock MansionOwner()
{
	for(new fam_id = 0; fam_id <= g_family_loaded; fam_id++)
	{
		if(GetFamilyData(fam_id, F_CENTRAL_MANSION) == 1) 
        {
            static str[128];
            format(str, sizeof(str), "{FF8000}Центральный Особняк\n{ffffff}Контролирует: {a9acaf}%s", GetFamilyData(fam_id, F_NAME));
            UpdateDynamic3DTextLabelText(CentralMansion, 0xFFFFFFFF, str);
        }
		if(GetFamilyData(fam_id, F_WEST_MANSION) == 1) 
        {
            static str[128];
            format(str, sizeof(str), "{FF8000}Западный Особняк\n{ffffff}Контролирует: {a9acaf}%s", GetFamilyData(fam_id, F_NAME));
            UpdateDynamic3DTextLabelText(WestMansion, 0xFFFFFFFF, str);
        }
		if(GetFamilyData(fam_id, F_NORTH_MANSION) == 1) 
        {
            static str[128];
            format(str, sizeof(str), "{FF8000}Японский Особняк\n{ffffff}Контролирует: {a9acaf}%s", GetFamilyData(fam_id, F_NAME));
            UpdateDynamic3DTextLabelText(NorthMansion, 0xFFFFFFFF, str);
        }
        if(GetFamilyData(fam_id, F_PELA_BASE) == 1) 
        {
            static str[128];
            format(str, sizeof(str), "{FF8000}База Пела\n{ffffff}Контролирует: {a9acaf}%s", GetFamilyData(fam_id, F_NAME));
            UpdateDynamic3DTextLabelText(PelaBase, 0xFFFFFFFF, str);
        }
	}
}
forward RemoveVenumLabel(playerid);
public RemoveVenumLabel(playerid)
{
	if(IsValidDynamic3DTextLabel(venumLabel[playerid]))
	{
		Delete3DTextLabel(venumLabel[playerid]);
		venumLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
	}
	return 1;
}

public: CB_GetOwnableCarForBuyTwin(playerid)
{
	new rows, id;

	rows = cache_num_rows();

	if(!rows)
		SendClientMessage(playerid, 0x999999FF, "У Вас нет личного транспорта");

	else
	{
		{
			new
				model_id,
				car_number[7];

			string_mrllwns[0] = EOS;

			for(new i = 0; i < rows; i ++)
			{
				id = cache_get_field_content_int(i, "id");
				model_id = cache_get_field_content_int(i, "model_id");
				cache_get_field_content(i, "number", car_number);

				format(string_mrllwns, sizeof string_mrllwns, "%s{FFFFFF}%d. %s {888888}(%d)\n", string_mrllwns, i + 1, GetVehicleInfo(model_id, VI_NAME), model_id);
				SetPlayerListitemValue(playerid, i, id);
			}

			Dialog
			(
				playerid, DIALOG_OWNABLE_LIST_BUY_TWIN, DIALOG_STYLE_LIST,
				"{0099FF}Выберите транспорт",
				string_mrllwns,
				"Выбрать", "Закрыть"
			);
		}
	}
}
#include "modules/player/auth_overlay.inc"

stock Diver:RespawnDiverGift() 
{
    for(new i; i < MAX_DIVER_GIFT; i++)
    {
        if(IsValidDynamicObject(g_diver_work[i][E_DIVER_OBJECT]))
            DestroyDynamicObject(g_diver_work[i][E_DIVER_OBJECT]);

        if(IsValidDynamic3DTextLabel(g_diver_work[i][E_DIVER_3DTEXT]))
            DestroyDynamic3DTextLabel(g_diver_work[i][E_DIVER_3DTEXT]);

        g_diver_work[i][E_DIVER_OBJECT] = CreateDynamicObject(16500,
            g_diver_pos[i][E_DIVER_POS_X],
            g_diver_pos[i][E_DIVER_POS_Y],
            g_diver_pos[i][E_DIVER_POS_Z], 0.0, 0.0, 0.0);

        g_diver_work[i][E_DIVER_3DTEXT] = CreateDynamic3DTextLabel("Сундук\nL.ALT Чтобы поднять",
            COLOR_GOLD,
            g_diver_pos[i][E_DIVER_POS_X],
            g_diver_pos[i][E_DIVER_POS_Y],
            g_diver_pos[i][E_DIVER_POS_Z] + 0.8, 5.0);

        g_diver_work[i][E_DIVER_PICKED] = false; 
    }
}
stock checkplayerbukva(playerid, bukvaid) return g_player[playerid][P_LATTERNAME][bukvaid] != '-';

stock Float:GetDistanceBetweenCoords(Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2)
{
    return floatsqroot(
        floatpower(x1 - x2, 2.0) +
        floatpower(y1 - y2, 2.0) +
        floatpower(z1 - z2, 2.0)
    );
}
stock Market_OnSelect(playerid, item)
{
    if(item == 18297)
    {
        if(GetIteam(playerid,347) < 250) return GameText(playerid,"~r~Недостаточно мандаринок",4000,3);
        GiveAcs(playerid,18297,7);
        GiveIteam(playerid,347,0,250,0);
        GameText(playerid,"~g~Вы приобрели декоративный поезд",4000,3);
    }
    if(item == 18296)
    {
        if(GetIteam(playerid,347) < 250) return GameText(playerid,"~r~Недостаточно мандаринок",4000,3);
        GiveAcs(playerid,18296,7);
        GiveIteam(playerid,347,0,250,0);
        GameText(playerid,"~g~Вы приобрели декоративный мопед",4000,3);
    }
    if(item == 18298)
