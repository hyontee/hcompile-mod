		    MoralPacket_2(i, s_CefInterface, t_CefShow, "BattleMansionEnd", STRING_GLOBAL);
	    }
	}
	if(NorthMansionCapture == true)
    {
		DellMansionOwner();

	    format(fmt_text, sizeof fmt_text, "Группировка {FFDD00}\"%s\" {ffffff}успешно захватывает {ff6666}\"Японский Особняк\"", GetFamilyData(fam_id, F_NAME));
		SendClientMessageToAll(-1, fmt_text);

