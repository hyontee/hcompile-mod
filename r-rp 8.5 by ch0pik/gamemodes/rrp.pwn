		{
			SetPVarInt(playerid, "akstype", 0);
			SetPVarInt(playerid, "category_bs", 0);
			MoralPacket_2(playerid, s_CefInterface, t_CefShow, "Accessories", "[[[\"Очки\",0],[\"Банданы\",1],[\"Маски\",2],[\"Береты\",3],[\"Шляпы\",4],[\"Сумка\",5],[\"Аксессуар на пояс\",6],[\"Часы\",7],[\"Рюкзак\",8],[\"Чокер\",10]],[[19006,\"Красные\",300000,0,0],[19007,\"Желтые\",350000,0,1],[19008,\"Зеленые\",350000,0,2],[19009,\"Синие\",350000,0,3],[19010,\"Розовые\",350000,0,4],[19011,\"Гипноз\",350000,0,5],[19012,\"Черные\",350000,0,6],[19013,\"Глаза\",350000,0,7],[19014,\"Шахматы\",350000,0,8],[19015,\"Обычные\",350000,0,9],[19016,\"X-ray\",350000,0,10],[13953,\"Для сноуборда\",8750000,0,11],[13995,\"Gucci\",1050000,0,12],[13996,\"American\",1050000,0,13],[13997,\"С обводкой\",1050000,0,14],[13998,\"Синий тигр\",1050000,0,15],[13999,\"Желтые\",1050000,0,16],[14462,\"Модные очки\",1665000,0,187]]]");
			SetPlayerVirtualWorld(playerid, playerid + 10);
			SetPlayerPos(playerid, 1238.4243,-2777.9377,1001.0000);
