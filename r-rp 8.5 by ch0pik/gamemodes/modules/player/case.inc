stock Case_GetPrizeWeight(case_index, prize_index)
{
    return CASE_PRIZES[case_index][prize_index][E_PRIZE_CHANCE];
}

stock CASE_IsPrizeVisible(case_index, prize_index)
{
    if (!CASE_PRIZES[case_index][prize_index][E_ITEM_PRIZE] && CASE_PRIZES[case_index][prize_index][E_NAME_PRIZE][0] == '\0') return 0;
    return 1;
}

stock Case_PickPrizeIndex(case_index)
{
    new total_weight;
    for (new j; j < MAX_PRIZES_PER_CASE; j++)
    {
        if (!CASE_IsPrizeVisible(case_index, j)) continue;
        total_weight += Case_GetPrizeWeight(case_index, j);
    }
    if (total_weight <= 0) return -1;
    new roll = random(total_weight);
    new acc;
    for (new j; j < MAX_PRIZES_PER_CASE; j++)
    {
        if (!CASE_IsPrizeVisible(case_index, j)) continue;
        acc += Case_GetPrizeWeight(case_index, j);
        if (roll < acc) return j;
    }
    return -1;
}

stock Case_Open(playerid, case_index)
{
    if (case_index < 0 || case_index >= sizeof(Cases_Full)) return 0;
    new real_prize_index = player_case_prize_index_saved[playerid];
    if (real_prize_index == -1) real_prize_index = Case_PickPrizeIndex(case_index);
    if (real_prize_index == -1) return 0;

    player_prize_index[playerid] = real_prize_index;
    player_case_prize_index_saved[playerid] = -1;

    new display_index = -1;
    for (new i; i < MAX_PRIZES_PER_CASE; i++)
    {
        if (player_prize_index_map[playerid][i] == real_prize_index)
        {
            display_index = i;
            break;
        }
    }
    if (display_index == -1)
    {
        display_index = 0;
        for (new j; j < real_prize_index; j++)
        {
            if (CASE_IsPrizeVisible(case_index, j)) display_index++;
        }
    }

    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "[%d,\"%s\",\"%s\",%d,%d,%d,[],%d]",
           CASE_PRIZES[case_index][real_prize_index][E_PRICE_PRIZE],
           CASE_PRIZES[case_index][real_prize_index][E_NAME_PRIZE],
           Cases_Full[case_index][CASE_NAME],
           CASE_PRIZES[case_index][real_prize_index][E_TYPE_PRIZE],
           display_index,
           case_index,
           CASE_PRIZES[case_index][real_prize_index][E_SIZE_PRIZE]
          );

    SendClientEventWithArg(playerid, t_CefShow, "CaseResult", STRING_GLOBAL);
    return 1;
}

stock ShowCase(playerid, case_index)
{
    for(new i; i < MAX_PRIZES_PER_CASE; i++)
    {
        player_prize_index_map[playerid][i] = -1;
    }

    STRING_GLOBAL[0] = EOS;
    new idx = case_index;
    if(idx < 0 || idx >= sizeof(Cases_Full)) return 0;

    new haveKey = (GetIteam(playerid, 259) >= 1);
    new price = Cases_Full[idx][CASE_OPEN_PRICE];
    new is_fast_open = 0;
    new is_open_keys = haveKey;
    new case_count = GetIteam(playerid, Cases_Full[idx][CASE_ITEM_ID]);

    format(string_minimal, sizeof(string_minimal), "[%d,\"%s\",%d,%d,%d,%d,1,0,[",
        idx,
        Cases_Full[idx][CASE_NAME],
        price,
        is_fast_open,
        is_open_keys,
        case_count
    );
    strcat(STRING_GLOBAL, string_minimal);

    new display_index = 0;
    for(new j; j < MAX_PRIZES_PER_CASE; j++)
    {
        if(!CASE_IsPrizeVisible(idx, j)) continue;
        if(display_index > 0) strcat(STRING_GLOBAL, ",");
        player_prize_index_map[playerid][display_index] = j;

        new rarity = CASE_PRIZES[idx][j][E_TYPE_PRIZE];
        format(string_inventory, sizeof(string_inventory), "[%d,%d,\"%s\",%d]",
            rarity,
            display_index,
            CASE_PRIZES[idx][j][E_NAME_PRIZE],
            CASE_PRIZES[idx][j][E_TYPE_PRIZE]
        );
        strcat(STRING_GLOBAL, string_inventory);
        display_index++;
    }
    strcat(STRING_GLOBAL, "]]");

    SendClientEventWithArg(playerid, t_CefShow, "Case", STRING_GLOBAL);
    return 1;
}
stock Case_OpenLid(playerid, case_index)
{
    if (case_index < 0 || case_index >= sizeof(Cases_Full)) return 0;

    new Float:X, Float:Y, Float:Z, Float:angle;

    GetPlayerPos(playerid, X, Y, Z);

    GetPlayerFacingAngle(playerid, angle);

    new Float:case_x, Float:case_y, Float:lid_z;

    switch (case_index)
    {
        case 0: case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), lid_z = Z-0.7;

        case 1: case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), lid_z = Z-0.8;

        case 2: case_x = X + (1.455 * floatsin(-angle, degrees)), case_y = Y + (1.455 * floatcos(-angle, degrees)), lid_z = Z-0.2;

        case 3: case_x = X + (1.63 * floatsin(-angle, degrees)), case_y = Y + (1.63 * floatcos(-angle, degrees)), lid_z = Z-0.6;

        case 4: case_x = X + (1.45 * floatsin(-angle, degrees)), case_y = Y + (1.45 * floatcos(-angle, degrees)), lid_z = Z-0.69;

        case 15: case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), lid_z = Z-0.7;

        default:
            case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), lid_z = Z - 0.7;
    }
    MoveDynamicObject(kase_krishka[playerid], case_x, case_y, lid_z, 0.2, -75.0, 0, angle);
    return 1;

}
stock Cases_OnPlayerInterfaceRequest(playerid, event, fast)
{
    if (event != 0) return 0;
    new case_type = GetPVarInt(playerid, "case_type");
    new case_index = case_type - 1;
    if (case_type <= 0) case_index = player_case_index[playerid];

    if (case_index < 0 || case_index >= sizeof(Cases_Full)) return 0;
    if (GetIteam(playerid, Cases_Full[case_index][CASE_ITEM_ID]) <= 0)
    {
        SendClientEventWithArg(playerid, t_CefHide, "Case", "");
        return SendClientMessage(playerid, 0xCECECEFF, "* У вас нет кейса в инвентаре");
    }

    new have_key = (GetIteam(playerid, 259) >= 1);
    new have_donate = (GetPlayerCurrentDonate(playerid) >= Cases_Full[case_index][CASE_OPEN_PRICE]);
    if (!have_key && !have_donate) return SendClientMessage(playerid, 0xCECECEFF, "* У вас нет ключа или доната для открытия кейса");

    new use_donate = !have_key;
    if (use_donate && !have_donate) return SendClientMessage(playerid, 0xCECECEFF, "[Ошибка] Недостаточно донат валюты");
    player_case_fast_mode[playerid] = fast;

    SendClientEventWithArg(playerid, t_CefHide, "Case", "");

    if (fast == 1)
    {
        kase_open[playerid] = 1;
        GiveIteam(playerid, Cases_Full[case_index][CASE_ITEM_ID], 0, 1, 0, "Открытие кейса");
        if (use_donate) GivePlayerDonate(playerid, -Cases_Full[case_index][CASE_OPEN_PRICE], "Кейс", true, true);
        else GiveIteam(playerid, 259, 0, 1, 0, "Открытие кейса");
        player_case_prize_index_saved[playerid] = -1;
        player_case_index[playerid] = case_index;
        Case_Open(playerid, case_index);
        return 1;
    }
    TogglePlayerControllable(playerid, false);
    Case_StartOpen(playerid, case_index, 0, !use_donate);
    return 1;
}

stock Case_StartOpen(playerid, case_index, is_fast_open, is_open_keys)
{
    if (case_index < 0 || case_index >= sizeof(Cases_Full)) return 0;
    new cost = Cases_Full[case_index][CASE_OPEN_PRICE];
    if (GetIteam(playerid, Cases_Full[case_index][CASE_ITEM_ID]) <= 0) return 0;

    if (is_open_keys)
    {
        if (GetIteam(playerid, 259) <= 0) return 0;
        GiveIteam(playerid, 259, 0, 1, 0, "Открытие кейса");
        GiveIteam(playerid, Cases_Full[case_index][CASE_ITEM_ID], 0, 1, 0, "Открытие кейса");
    }
    else
    {
        if (GetPlayerCurrentDonate(playerid) < cost) return 0;
        GivePlayerDonate(playerid, -cost, "Кейс", true, true);
        GiveIteam(playerid, Cases_Full[case_index][CASE_ITEM_ID], 0, 1, 0, "Открытие кейса (донат)");
    }

    player_case_index[playerid] = case_index;

    if (is_fast_open)
    {
        return Case_Open(playerid, case_index);
    }

    new Float:X, Float:Y, Float:Z, Float:angle;
    GetPlayerPos(playerid, X, Y, Z);
    GetPlayerFacingAngle(playerid, angle);
    new Float:case_x, Float:case_y, Float:case_z, Float:lid_x, Float:lid_y, Float:lid_z;
    switch (case_index)
    {
        case 0: case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), case_z = Z-0.8, lid_x = case_x, lid_y = case_y, lid_z = case_z;
        case 1: lid_x = X + (1.41 * floatsin(-angle, degrees)), lid_y = Y + (1.41 * floatcos(-angle, degrees)), case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), case_z = Z-0.8, lid_z = Z-0.81;
        case 2: case_x = X + (1.44 * floatsin(-angle, degrees)), case_y = Y + (1.44 * floatcos(-angle, degrees)), case_z = Z-0.8, lid_x = X + (1.455 * floatsin(-angle, degrees)), lid_y = Y + (1.455 * floatcos(-angle, degrees)), lid_z = Z-0.82;
        case 3: lid_x = X + (1.6 * floatsin(-angle, degrees)), lid_y = Y + (1.6 * floatcos(-angle, degrees)), case_x = X + (1.37 * floatsin(-angle, degrees)), case_y = Y + (1.37 * floatcos(-angle, degrees)), case_z = Z-0.8, lid_z = Z-0.6;
        case 4: case_x = X + (1.3 * floatsin(-angle, degrees)), case_y = Y + (1.3 * floatcos(-angle, degrees)), case_z = Z-1, lid_x = X + (1.45 * floatsin(-angle, degrees)), lid_y = Y + (1.45 * floatcos(-angle, degrees)), lid_z = Z-0.71;
        case 5: case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), case_z = Z-0.7, lid_x = case_x, lid_y = case_y, lid_z = case_z;
        case 6: case_x = X + (1.45 * floatsin(-angle, degrees)), case_y = Y + (1.45 * floatcos(-angle, degrees)), case_z = Z-0.7, lid_x = case_x, lid_y = case_y, lid_z = case_z;
        case 7: case_x = X + (1.7 * floatsin(-angle, degrees)), case_y = Y + (1.7 * floatcos(-angle, degrees)), case_z = Z-1.0, lid_x = X + (1.85 * floatsin(-angle, degrees)), lid_y = Y + (1.85 * floatcos(-angle, degrees)), lid_z = Z-0.74;
        case 8, 9, 10, 11, 12, 13, 14:
            case_x = X + (1.45 * floatsin(-angle, degrees)), case_y = Y + (1.45 * floatcos(-angle, degrees)), case_z = Z - 0.7, lid_x = case_x, lid_y = case_y, lid_z = case_z;
        case 15: case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), case_z = Z-0.8, lid_x = case_x, lid_y = case_y, lid_z = case_z;
        default:
            case_x = X + (1.4 * floatsin(-angle, degrees)), case_y = Y + (1.4 * floatcos(-angle, degrees)), case_z = Z - 0.8, lid_x = case_x, lid_y = case_y, lid_z = case_z;
    }
    kase_open[playerid] = 0;
    kase_krishka[playerid] = CreateDynamicObject(Cases_Full[case_index][CASE_LID_MODEL], lid_x, lid_y, lid_z, 0.0, 0.0, angle);
    kase_osnova[playerid] = CreateDynamicObject(Cases_Full[case_index][CASE_BASE_MODEL], case_x, case_y, case_z, 0.0, 0.0, angle);

    new prize_index = Case_PickPrizeIndex(case_index);
    player_case_prize_index_saved[playerid] = prize_index;

    if (prize_index != -1)
    {
        new Float:prize_x = case_x - (0.15 * floatsin(-angle, degrees));
        new Float:prize_y = case_y - (0.15 * floatcos(-angle, degrees));
        kase_prize[playerid] = CreateDynamicObject(CASE_PRIZES[case_index][prize_index][E_BLOCK_PRIZE], prize_x, prize_y, case_z, 0.0, 0.0, angle);
    }
    new Float:cam_x = X + (1.3 * floatsin(-angle + 90.0, degrees));
    new Float:cam_y = Y + (1.3 * floatcos(-angle + 90.0, degrees));
    new Float:cam_z = Z + 0.3;
    Streamer_UpdateEx(playerid, X, Y, Z, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
    InterpolateCameraPos(playerid, cam_x, cam_y, cam_z, X + (0.95 * floatsin(-angle, degrees)), Y + (0.95 * floatcos(-angle, degrees)), Z + 0.2, 5000, CAMERA_MOVE);
    InterpolateCameraLookAt(playerid, X + (0.5 * floatsin(-angle, degrees)), Y + (0.5 * floatcos(-angle, degrees)), Z - 0.5, case_x, case_y, case_z - 0.05, 5000, CAMERA_MOVE);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);

    SetTimerEx("Case_OpenLidTimer", 7000, false, "ii", playerid, case_index);
    return 1;
}

public: Case_OpenLidTimer(playerid, case_index)
{
    Case_OpenLid(playerid, case_index);
    SetTimerEx("Case_SelectPrizeTimer", 1500, false, "ii", playerid, case_index);
    return 1;
}

public: Case_SelectPrizeTimer(playerid, case_index)
{
    DestroyDynamicObject(kase_osnova[playerid]);
    DestroyDynamicObject(kase_krishka[playerid]);
    DestroyDynamicObject(kase_prize[playerid]);

    Case_Open(playerid, case_index);
    return 1;
}

stock Cases_OnPlayerCloseInterface(playerid, id)
{
    if (player_prize_index[playerid] == -1) return 0;

    new case_index = player_case_index[playerid];
    new prize_index = player_prize_index[playerid];
    if (case_index < 0 || case_index >= sizeof(Cases_Full) || prize_index < 0 || prize_index >= MAX_PRIZES_PER_CASE) return 0;

    SendClientEventWithArg(playerid, t_CefHide, "CaseResult", "");

    if (id == 1)
    {
        new fmt_msg[144];
        new prize_name[96];
        format(prize_name, sizeof(prize_name), "%s", CASE_PRIZES[case_index][prize_index][E_NAME_PRIZE]);

        format(fmt_msg, sizeof fmt_msg, "Вы успешно открыли {ffffff}кейс '%s' {6495ED}и получили {ffffff}'%s'",
               Cases_Full[case_index][CASE_NAME],
               prize_name
              );
        SendClientMessage(playerid, 0x6495EDFF, fmt_msg);
        SendClientMessage(playerid, 0x6495EDFF, "Приз был добавлен в ваши награды");

        GivePlayerMyPrizes(playerid,
                           prize_name,
                           CASE_PRIZES[case_index][prize_index][E_SIZE_PRIZE],
                           CASE_PRIZES[case_index][prize_index][E_ITEM_PRIZE],
                           CASE_PRIZES[case_index][prize_index][E_TYPE_PRIZE],
                           1,
                           CASE_PRIZES[case_index][prize_index][E_INDX_PRIZE]
                          );
    }
    if (id == 0)
    {
        new price = CASE_PRIZES[case_index][prize_index][E_PRICE_PRIZE];
        if (price > 0)
        {
            GivePlayerMoneyEx(playerid, price, "продажа с кейса", true, true);
            SCMF(playerid, 0x6495EDFF, "Вы продали приз за {ffffff}%d {6495ED}рублей!", price);
        }
        else
        {
            SCM(playerid, -1, "Этот предмет нельзя продать!");
        }
    }

    player_prize_index[playerid] = -1;
    if (kase_open[playerid] == 0)
    {
        DestroyDynamicObject(kase_osnova[playerid]);
        DestroyDynamicObject(kase_krishka[playerid]);
        DestroyDynamicObject(kase_prize[playerid]);
        TogglePlayerControllable(playerid, true);
        SetCameraBehindPlayer(playerid);
    }

    if (GetIteam(playerid, Cases_Full[case_index][CASE_ITEM_ID]) > 0)
    {
        for (new i; i < MAX_PRIZES_PER_CASE; i++)
        {
            player_prize_index_map[playerid][i] = -1;
        }
        ShowCase(playerid, case_index);
    }
    return 1;
}

stock Case_OnInventoryItemUse(playerid, item_id)
{
    for (new i; i < sizeof(Cases_Full); i++)
    {
        if (Cases_Full[i][CASE_ITEM_ID] != item_id) continue;
        new count = GetIteam(playerid, item_id);
        if (count <= 0) return 0;
        player_case_index[playerid] = i;
        ShowCase(playerid, i);
        return 1;
    }
    return 0;
}