stock GetVehicleInfoModel(modelid)
{
    for (new i; i < sizeof g_vehicle_info; i++)
    {
        if (modelid != g_vehicle_info[i][VI_ID]) continue;

        modelid = i;
        break;
    }
    return modelid;
}
