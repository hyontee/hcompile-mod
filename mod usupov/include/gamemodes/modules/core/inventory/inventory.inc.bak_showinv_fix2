    UpdatePlayerDatabaseInt(playerid, "Skin", targetSkin);

    if(Inventory_IsValidSkinModel(oldSkin) && oldSkin > 0)
    {
        g_PlayerInventory[playerid][slot][inv_itemCount] = 1;
        format(g_PlayerInventory[playerid][slot][inv_itemPlate], 32, "%d", oldSkin);
