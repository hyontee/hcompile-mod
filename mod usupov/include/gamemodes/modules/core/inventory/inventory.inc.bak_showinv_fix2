            ok = Inventory_MoveItem(playerid, old_pos, pos) != 0;

            JSON_SetInt(response, "t", 23);
            JSON_SetInt(response, "s", ok ? 1 : 0);
            if(ok) JSON_SetInt(response, "i", pos);
        }
        case 32:
        {
            JSON_GetInt(JSONObject, "s", pos);
            if(pos == -1) JSON_GetInt(JSONObject, "sl", pos);
            if(pos == -1) JSON_GetInt(JSONObject, "i", pos);

            new mappedSlot = Inv_MapSrvSlotToInt(pos);
            if(mappedSlot == SIM_SLOT || pos == SIM_SLOT || pos == SIM_SERVER_SLOT)
            {
                ok = Inventory_MoveSIMToInventory(playerid) != 0;
            }
            else
            {
                ok = Inventory_EquipSIM(playerid, pos) != 0;
            }

            JSON_SetInt(response, "t", 32);
            JSON_SetInt(response, "s", ok ? 1 : 0);
            JSON_SetFloat(response, "w", GetPlayerWeight(playerid));
            if(ok)
            {
                JSON_SetInt(response, "i", g_PlayerActiveSlots[playerid][SIM_SLOT][inv_itemId] == 58 ? SIM_SERVER_SLOT : SIM_SLOT);
            }
        }
        case 33:
        {
            JSON_GetInt(JSONObject, "ga", item_id);
            JSON_GetInt(JSONObject, "s", pos);
            if(pos == -1) JSON_GetInt(JSONObject, "sl", pos);
            if(pos == -1) JSON_GetInt(JSONObject, "i", pos);
            if(pos >= 0 && pos < MAX_INVENTORY_SLOTS && g_PlayerInventory[playerid][pos][inv_itemId] > 0 && item_id != g_PlayerInventory[playerid][pos][inv_itemId]) item_id = g_PlayerInventory[playerid][pos][inv_itemId];

            if(item_id == 0 && pos >= 0 && pos < MAX_INVENTORY_SLOTS)
            {
                item_id = g_PlayerInventory[playerid][pos][inv_itemId];
            }

            if(item_id == 134)
            {
                new skinModel;
                ok = Inventory_UseSkinFromSlot(playerid, pos, skinModel);
            }

            JSON_SetInt(response, "t", 33);
            JSON_SetInt(response, "s", ok ? 1 : 0);
            JSON_SetFloat(response, "w", GetPlayerWeight(playerid));
            if(ok)
            {
                JSON_SetInt(response, "ps", GetPlayerData(playerid, P_SKIN));
            }
        }
        default:
        {
            JSON_SetInt(response, "t", type);
            JSON_SetInt(response, "s", 0);
        }
    }

    Inventory_ValidateActiveSlots(playerid);
    Inventory_SyncMedChestFlag(playerid);
    if(ok) Inventory_Save(playerid);
    if(ok && (type == 19 || type == 32 || type == 33)) ShowPlayerInventory(playerid);

    OnPacketIncoming(playerid, 33, response);
    JSON_Cleanup(response);

    return true;
}

CMD:giveitem(playerid, params[])
{
    new to_player, item_id, skin_id, count;

    if(GetPlayerAdminEx(playerid) < 1)
    {
        return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}Команда доступна только администрации.");
    }

    if(!sscanf(params, "uiii", to_player, item_id, skin_id, count))
    {
        if(!IsPlayerConnected(to_player))
        {
            SendClientMessage(playerid, -1, "Player not found");
            return 1;
        }

        if(!IsPlayerLogged(to_player) || GetPlayerAccountID(to_player) <= 0)
        {
            SendClientMessage(playerid, -1, "Target player is not logged in");
            return 1;
        }

        if(item_id != 134)
        {
            SendClientMessage(playerid, -1, "Usage: /giveitem [playerid] [134] [skin_id] [count]");
            return 1;
        }

        if(skin_id < 1 || skin_id > 311)
        {
            SendClientMessage(playerid, -1, "Invalid skin id (1-311)");
            return 1;
        }

        if(count <= 0) count = 1;

        if(!Inventory_AddSkinItems(to_player, skin_id, count))
        {
            SendClientMessage(playerid, -1, "No free slots");
            return 1;
        }

        Inventory_Save(to_player);
        ShowPlayerInventory(to_player);

        new msg_skin[144];
        format(msg_skin, sizeof(msg_skin), "You gave skin %d x%d to %s", skin_id, count, GetPlayerNameEx(to_player));
        SendClientMessage(playerid, -1, msg_skin);
        return 1;
    }

    if(sscanf(params, "uii", to_player, item_id, count))
    {
        SendClientMessage(playerid, -1, "Usage: /giveitem [playerid] [item_id] [count]");
        SendClientMessage(playerid, -1, "Skin format: /giveitem [playerid] [134] [skin_id] [count]");
        return 1;
    }

    if(!IsPlayerConnected(to_player))
    {
        SendClientMessage(playerid, -1, "Player not found");
        return 1;
    }

    if(!IsPlayerLogged(to_player) || GetPlayerAccountID(to_player) <= 0)
    {
        SendClientMessage(playerid, -1, "Target player is not logged in");
        return 1;
    }

    if(count <= 0) count = 1;

    if(item_id == 134)
    {
        SendClientMessage(playerid, -1, "For skins use: /giveitem [playerid] [134] [skin_id] [count]");
        return 1;
    }

    if(!Inventory_AddItem(to_player, item_id, count))
    {
        SendClientMessage(playerid, -1, "No free slots");
        return 1;
    }

    Inventory_Save(to_player);
    ShowPlayerInventory(to_player);

    new msg[128];
    format(msg, sizeof(msg), "You gave item %d x%d to %s", item_id, count, GetPlayerNameEx(to_player));
    SendClientMessage(playerid, -1, msg);
    return 1;
}




