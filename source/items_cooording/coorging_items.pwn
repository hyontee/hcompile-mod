stock SelectPlayerItem(playerid, modelid, slot)
{
	if (modelid < 0 || modelid > MAX_ITEMS_COUNT) return true;  
	new 
		str_[128]; 
	SetPVarInt(playerid, "PlayerInventory", modelid);
	SetPVarInt(playerid, "PlayerSelectSlot", slot);
	format(str_, sizeof str_, ""colserver"Предмет: "colwhi"%s", inventory_items[modelid][ITEM_NAME]);
	if (modelid == 102)
	{
		ShowPlayerDialog(playerid, D_INV_INFO, DIALOG_STYLE_LIST, str_,
			"[0] Информация", "Выбор", "Назад");
	} 
	else if (modelid >= 133 && modelid <= 137) {
		//SendClientMessage(playerid, -1, "RC toys");
		ShowPlayerDialog(playerid, D_INV_RC, DIALOG_STYLE_LIST, str_, 
			"[0] Использовать как элемент одежды\n\
			[1] Использовать как транспорт\n\
			[2] Снять\n\
			[3] Выбросить\n\
			[4] "col_li_red"Удалить из инвентаря", "Выбор", "Назад"
		);
	}
	else {
		ShowPlayerDialog(playerid, D_INV_, DIALOG_STYLE_LIST, str_, 
			"[0] Использовать\n\
			[1] Снять\n\
			[2] Выбросить\n\
			[3] "col_li_red"Удалить из инвентаря", "Выбор", "Назад"
		);
	}
	
	return true;
}
stock GetSearchItems(playerid, modelid) {
	new 
		Items = 0;
	for(new i = 0; i < MAX_ITEMS_SLOTS; i++) {
		if (pInfo[playerid][PlayerItems][i] == modelid) {
			Items++; 
		}
	}
	if (!Items) return false;
	else return true; 
}
stock SearchUseItem(playerid, modelid) {
	new bool: UsePlayer = false;
	for(new i = 0; i < 20; i++) {
		if (pInfo[playerid][PlayerUseItems][i] == modelid) {
			UsePlayer = true;
			break;
		}
	}
	return UsePlayer;
}
stock DropPlayerItem(playerid, modelid, slot, save = 1)
{
	if (pTemp[playerid][tRentStallID] != -1) return SendClientMessage(playerid, COLOR_GREY, "В данный момент Вы не можете выбросить аксессуар.");
	if (SearchUseItem(playerid, modelid)) return SendClientMessage(playerid, COLOR_GREY, !"Данный предмет одет на Ваш скин!");  
	if (pInfo[playerid][PlayerItems][slot] == 0 && pInfo[playerid][PlayerItemsCount][slot] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка слота или кол-во");  
	new 
		bool: count = false,
		str_[64],
		Float: x,
		Float: y,
		Float: z;
	GetPlayerPos(playerid, x, y, z); 
	for(new i; i != MAX_OBJECTS_DROP; i ++)
	{
		if (DropObjectInfo[i][objDrop][0] == 0 && DropObjectInfo[i][objDrop][1] == 0) {
			DropObjectInfo[i][objDrop][0] = pInfo[playerid][PlayerItems][slot];
			DropObjectInfo[i][objDrop][1] = pInfo[playerid][PlayerItemsCount][slot];//Drop Count
			DropObjectInfo[i][objPos][0] = x;
			DropObjectInfo[i][objPos][1] = y;
			DropObjectInfo[i][objPos][2] = z;
			MeAction(playerid, "выкинул(-а) что-то на землю", SELECT_ACTION_IN_BUBBLE);
			ApplyAnimation(playerid, "WUZI", "Wuzi_grnd_chk",4.0, 0, 1, 1, 0, 0, 1);
			new
				drop_model = inventory_items[modelid][ITEM_MODEL_ID];
			if (drop_model == 6865) {
				drop_model = 2845;
			}
			DropObjectInfo[i][objObject] = CreateDynamicObject(drop_model, 
				DropObjectInfo[i][objPos][0], DropObjectInfo[i][objPos][1], DropObjectInfo[i][objPos][2]-1, 
				80.0, 0.0, 0.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid)
			); 
			format(str_, sizeof str_, "Предмет: %s\nПоднять: ALT", inventory_items[modelid][ITEM_NAME]);
			DropObjectInfo[i][objText] = CreateDynamic3DTextLabel(str_, 0xFFFFFF50, 
				DropObjectInfo[i][objPos][0], DropObjectInfo[i][objPos][1], DropObjectInfo[i][objPos][2] - 1,
				2.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 
				GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid)
			);
			Streamer_Update(playerid);
			count = true;
			break;
		}
	}
	if (!count) return SendClientMessage(playerid, COLOR_GREY, !"Простите, но лимит на объекты исчерпан!");

	pInfo[playerid][PlayerItems][slot] = 0;
	pInfo[playerid][PlayerItemsCount][slot] = 0; 
	if (save) SavePlayerInventory(playerid);
	return 1;
}
stock UnUsePlayerItem(playerid, modelid, save = 1)
{ 
	if (inventory_items[modelid][accesoryItemType] == TYPE_ITEMS_SUIT) {
		for(new i = ATTACHED_SLOT_ITEMS_0; i < ATTACHED_SLOT_ITEMS_6; i++) {
			if (IsPlayerAttachedObjectSlotUsed(playerid, i)) {
				RemovePlayerAttachedObject(playerid, i);
			}
		}
		pInfo[playerid][PlayerUseItems][0] = pInfo[playerid][PlayerUseItems][1] = 
		pInfo[playerid][PlayerUseItems][2] = pInfo[playerid][PlayerUseItems][3] = 
		pInfo[playerid][PlayerUseItems][4] = pInfo[playerid][PlayerUseItems][5] = 
		pInfo[playerid][PlayerUseItems][6] = pInfo[playerid][PlayerUseItems][7] = 
		pInfo[playerid][PlayerUseItems][8] = pInfo[playerid][PlayerUseItems][9] = pInfo[playerid][PlayerUseItems][10] = 0; 
		if (save) SavePlayerInventory(playerid);
		return 1;
	}
	switch(inventory_items[modelid][ITEM_MODEL_ID])
	{//
		case 18636, 18906, 18910, 18921 .. 18935, 18939 .. 18951, 18953, 18954, 18970 .. 18973, 19064 .. 19066, 19137, 19197, 19352, 19528://UsePlayerItem
		{
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_ITEMS_0)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_0);
			if (save) pInfo[playerid][PlayerUseItems][0] = 0;
		} 
		case 1599, 18911 .. 18920, 19421 .. 19424: // 1 .. 10: //inventory_items[modelid][ITEM_MODEL_ID]
		{
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_ITEMS_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_1);

			if (save) pInfo[playerid][PlayerUseItems][1] = 0;
		}
		case 368, 888, 19007,19011 .. 19019,19024,19027 .. 19029,19022,19035,19031 .. 19033,19139,19140: //25 .. 45:
		{
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_ITEMS_2)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_2);
			if (save) pInfo[playerid][PlayerUseItems][2] = 0; 
		}

		
		case 441, 464, 465, 501, 564, 19039 .. 19053, 7093: //61 .. 73:
		{
			//watch / RC VEHICLE
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_ITEMS_3)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_3);
			if (save) pInfo[playerid][PlayerUseItems][3] = 0;
		}
		case 6865, 11704, 19472, 19036 .. 19038: {
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_ITEMS_4)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_4);

			if (save) pInfo[playerid][PlayerUseItems][4] = 0;
		} 
		case 2511, 1609, 2406, 326, 338, 339, 355, 1146, 2045, 8492, 2226, 2102, 2103, 2453, 2690, 11712, 18633 .. 18635, 19086, 19317 .. 19319, 19339, 19590: // 54, 55, 74 .. 85: 
		{
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_ITEMS_5)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_5);

			if (save) pInfo[playerid][PlayerUseItems][5] = 0; 
			//UNUSUAL
		}  
		case 19079, 19314, 19332 .. 19338: {
			if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_ITEMS_6)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_6);

			if (save) pInfo[playerid][PlayerUseItems][6] = 0;
		}
	}
	if (save) SavePlayerInventory(playerid);
	return true;
}

