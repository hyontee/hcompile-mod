						case 247 .. 250: SetPlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_3, 364, 6, 0.0790, 0.0190, 0.0090, 0.0000, -93.2999, 5.0000, 1.0000, 1.0000, 1.0000, -1, -1);
						case 251 .. 288: SetPlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_3, 364, 6, 0.0790, 0.0190, 0.0090, 0.0000, -93.2999, 5.0000, 1.0000, 1.0000, 1.0000, -1, -1);
						case 289 .. 297: SetPlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_3, 364, 6, 0.0790, 0.0190, 0.0090, 0.0000, -93.2999, 5.0000, 1.0000, 1.0000, 1.0000, -1, -1);
						case 298 .. 311: SetPlayerAttachedObject(playerid, ATTACHED_SLOT_ITEMS_3, 364, 6, 0.0790, 0.0190, 0.0090, 0.0000, -93.2999, 5.0000, 1.0000, 1.0000, 1.0000, -1, -1); 
					}
					if (save) pInfo[playerid][PlayerUseItems][3] = modelid;
				}
			}
		}
	}
	if (save) SavePlayerInventory(playerid);
	return true;
}

/*
	* При выходе/покупке, при сбиве tAccesoryBuySelectID - возвращаем аксессуары игрока обратно
	* При выборе tAccesoryBuySelectID - надеваем объект на игрока
*/
// new pTemp[MAX_PLAYERS]:
/*
	tAccesoryBuyMenuShowed,
	tAccesoryBuyPage,
	tAccesoryBuySelectID,
	tAccesoryBuyType,
*/


items_OnGameModeInit() {
	for (new i = 0, idx, type; i < sizeof (inventory_items); i++) {//INDEX_SELL_OTHER
		if (inventory_items[i][accesoryIndex] == INDEX_SELL_OTHER) continue;
		type = inventory_items[i][accesoryType];
		if (!type) continue;
		
		idx = AccesoryTypeInfo[type - 1][typeItemsCount]++;
		AccesoryTypeInfo[type - 1][typeItemID][idx] = i;
	}
	for (new type = 1; type <= MAX_ACCESORY_TYPE; type++) {
		AccesoryTypeInfo[type - 1][typePages] = 1 + AccesoryTypeInfo[type - 1][typeItemsCount] / MAX_ACCESORY_BUY_MAX_ITEMS_PAGE;
	}
	CreateStallChangeStar(0, 1109.515747, -1414.501953, 13.739741, -179.500305, 200, "Палатка скупки\nЗвезд");
	r_ObjStar = random(59);
	id_dObj[0] = CreateDynamicObject(1247, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2], HNYIOne[r_ObjStar][3], 0.00000, 0.00000); 
	id_dObj[1] = CreateDynamicObject(18728, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2],   0.0, 0.00000, 0.00000);


	/*CreateStallChangeStar(1, 1454.061279, -1749.580322, 13.726862, 157.400054, 200, "Палатка обмена\nПодарков");
	CreateDynamicObject(19054, 1452.237792, -1747.684936, 13.156855, 0.000000, 0.000000, 0.000000, 0, 0, -1, 200.00, 200.00); // 1
	CreateDynamicObject(19055, 1451.605102, -1746.501586, 13.242227, 0.000000, -11.200004, 0.000000, 0, 0, -1, 200.00, 200.00); // 2
	CreateDynamicObject(19057, 1452.855590, -1746.516601, 12.876860, 0.000000, 0.000000, 0.000000, 0, 0, -1, 200.00, 200.00); // 3
	ChristmasBoxObject[0] =
	ChristmasBoxObject[1] =
	ChristmasBoxObject[2] = INVALID_DYNAMIC_OBJECT_ID;
	GetCristmasBoxID();  */

	CreateMarketPlace();
	CreateAccesoryBuyTD();
}
items_OnPlayerClickTextDraw(playerid, Text:clickedid) {
	if (!pTemp[playerid][tAccesoryBuyMenuShowed]) 
		return false;
	if (clickedid == BuyAccesoryTD[8]) { // (click EXIT)
		HideAccesoryBuyMenu(playerid);
		return true;
	}
	else if (clickedid == BuyAccesoryTD[9]) { // (click BUY)
		new itemid, id = pTemp[playerid][tAccesoryBuySelectID];
		if (id == -1) {
			SendClientMessage(playerid, COLOR_GREY, !"Сначала выберите аксессуар из ассортимента!");
			return true;
		}
		itemid = AccesoryTypeInfo[pTemp[playerid][tAccesoryBuyType] - 1][typeItemID][id + ((pTemp[playerid][tAccesoryBuyPage] - 1) * MAX_ACCESORY_BUY_MAX_ITEMS_PAGE)];
		// SendMes(playerid, -1, "Покупка: itemid = %i | %s | цена: %i вирт.", itemid, inventory_items[itemid][ITEM_NAME], inventory_items[itemid][accesoryPrice]);
		if (!FreeSlotPlayerItem(playerid)) return 1; 
		new price = inventory_items[itemid][accesoryPrice];
		new 
			balance_ = (inventory_items[itemid][accesoryPrice]*80)/100; // 80 % даем бизнесу
		if (kLibGetPlayerMoney(playerid) < price)  {
			SendClientMessage(playerid, COLOR_BLUE, !"Продавец: "colwhi"Данный предмет вам не по карману!");
			return true;
		}
		new business_id = pTemp[playerid][tBusinessID];
		if (BusinessInfo[business_id][bProducts] < 100) {
			SendClientMessage(playerid, COLOR_GREY, !"Недостаточно продуктов!");
			return true;
		}
		BusinessInfo[business_id][bProducts] -= 100;
		PayBusinessItem(playerid, business_id, 0, 1, balance_);

		// Apply and Save New Accesory
		GivePlayerItem(playerid, itemid, 1);
		printf("modelid: %d", itemid);
		SendClientMessage(playerid, COLOR_BLUE, !"Продавец: "colwhi"Спасибо за покупку. Вы сделали хороший выбор!");
		SendClientMessage(playerid, COLOR_BLUE, !"Используйте /inv, чтобы надеть аксессуар!");

		//OnPlayerQuestProgress(playerid, QUEST_GUEST, QUEST_TASK_VICTIM);
		return true;
	}
	else if (clickedid == Text:INVALID_TEXT_DRAW) {
		SelectTextDraw(playerid, 0xFF7F50FF);
		return true;
	}
	return false;
}
stock SavePlayerInventory(playerid) {
 	if (!pInfo[playerid][pLogin]) 
		return false;
	format(t_string, sizeof (t_string), "UPDATE s_users SET \
		playerItems='%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d',\
		playerItemsCount='%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d',\
		playerUseItems='%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d' \ 
		WHERE pID = %i LIMIT 1", 
		pInfo[playerid][PlayerItems][0], pInfo[playerid][PlayerItems][1], pInfo[playerid][PlayerItems][2], pInfo[playerid][PlayerItems][3], 
		pInfo[playerid][PlayerItems][4], pInfo[playerid][PlayerItems][5], pInfo[playerid][PlayerItems][6], pInfo[playerid][PlayerItems][7], 
		pInfo[playerid][PlayerItems][8], pInfo[playerid][PlayerItems][9], pInfo[playerid][PlayerItems][10], pInfo[playerid][PlayerItems][11], 
		pInfo[playerid][PlayerItems][12], pInfo[playerid][PlayerItems][13], pInfo[playerid][PlayerItems][14], pInfo[playerid][PlayerItems][15], 
		pInfo[playerid][PlayerItems][16], pInfo[playerid][PlayerItems][17], pInfo[playerid][PlayerItems][18], pInfo[playerid][PlayerItems][19], 
		pInfo[playerid][PlayerItems][20], pInfo[playerid][PlayerItems][21], pInfo[playerid][PlayerItems][22], pInfo[playerid][PlayerItems][23],
		pInfo[playerid][PlayerItems][24], pInfo[playerid][PlayerItems][25], pInfo[playerid][PlayerItems][26], pInfo[playerid][PlayerItems][27], 
		pInfo[playerid][PlayerItems][28], pInfo[playerid][PlayerItems][29],
		pInfo[playerid][PlayerItemsCount][0], pInfo[playerid][PlayerItemsCount][1], pInfo[playerid][PlayerItemsCount][2], pInfo[playerid][PlayerItemsCount][3], 
		pInfo[playerid][PlayerItemsCount][4], pInfo[playerid][PlayerItemsCount][5], pInfo[playerid][PlayerItemsCount][6], pInfo[playerid][PlayerItemsCount][7], 
		pInfo[playerid][PlayerItemsCount][8], pInfo[playerid][PlayerItemsCount][9], pInfo[playerid][PlayerItemsCount][10], pInfo[playerid][PlayerItemsCount][11], 
		pInfo[playerid][PlayerItemsCount][12], pInfo[playerid][PlayerItemsCount][13], pInfo[playerid][PlayerItemsCount][14], pInfo[playerid][PlayerItemsCount][15], 
		pInfo[playerid][PlayerItemsCount][16], pInfo[playerid][PlayerItemsCount][17], pInfo[playerid][PlayerItemsCount][18], pInfo[playerid][PlayerItemsCount][19], 
		pInfo[playerid][PlayerItemsCount][20], pInfo[playerid][PlayerItemsCount][21], pInfo[playerid][PlayerItemsCount][22], pInfo[playerid][PlayerItemsCount][23],
		pInfo[playerid][PlayerItemsCount][24], pInfo[playerid][PlayerItemsCount][25], pInfo[playerid][PlayerItemsCount][26], pInfo[playerid][PlayerItemsCount][27], 
		pInfo[playerid][PlayerItemsCount][28], pInfo[playerid][PlayerItemsCount][29],
		pInfo[playerid][PlayerUseItems][0], pInfo[playerid][PlayerUseItems][1], pInfo[playerid][PlayerUseItems][2], pInfo[playerid][PlayerUseItems][3], 
		pInfo[playerid][PlayerUseItems][4], pInfo[playerid][PlayerUseItems][5], pInfo[playerid][PlayerUseItems][6], pInfo[playerid][PlayerUseItems][7], 
		pInfo[playerid][PlayerUseItems][8], pInfo[playerid][PlayerUseItems][9], pInfo[playerid][PlayerUseItems][10], pInfo[playerid][PlayerUseItems][11], 
		pInfo[playerid][PlayerUseItems][12], pInfo[playerid][PlayerUseItems][13], pInfo[playerid][PlayerUseItems][14], pInfo[playerid][PlayerUseItems][15], 
		pInfo[playerid][PlayerUseItems][16], pInfo[playerid][PlayerUseItems][17], pInfo[playerid][PlayerUseItems][18], pInfo[playerid][PlayerUseItems][19],
		pInfo[playerid][pID]
	);
	mysql_tquery(dbHandle, t_string), t_string[0] = EOS;

	return true;
}
items_OnPlayerClickPTD(playerid, PlayerText:playertextid) {
	if (!pTemp[playerid][tAccesoryBuyMenuShowed]) 
		return false;
	if (playertextid == BuyAccesoryPTD[playerid][12]) { // (click TYPE)
		t_string = ""colwhi"";
		for (new i = 1; i <= MAX_ACCESORY_TYPE; i++) {
			format(t_string, sizeof (t_string), "%s\
				[%i] %s\t[%i шт.]\n", t_string,
				i, nameItems[i - 1], AccesoryTypeInfo[i - 1][typeItemsCount]
			);
		}
		ShowPlayerDialog(playerid, D_ITEMS_BUY_TYPE, DIALOG_STYLE_TABLIST, ""colserver"Аксессуары: "colwhi"Выберите редкость", t_string,
			"Выбрать", "Отмена"
		);
		t_string[0] = EOS;
		return true;
	}
	new bool:isReturn = false;
	for (new i = 0; i < MAX_ACCESORY_BUY_MAX_PAGE; i++) { // (click PAGE:1-7)
		if (playertextid != BuyAccesoryPTD[playerid][i + 26]) continue;
		UpdateAccesoryBuyMenuPage(playerid, i + 1);
		isReturn = true;
		break;
	}
	if (isReturn) return true;

	for (new i = 0, itemid; i < MAX_ACCESORY_BUY_MAX_ITEMS_PAGE; i++) {
		if (playertextid != BuyAccesoryPTD[playerid][i]) 
			continue;
		if (i == pTemp[playerid][tAccesoryBuySelectID]) 
			continue;
		itemid = AccesoryTypeInfo[pTemp[playerid][tAccesoryBuyType] - 1][typeItemID][i + ((pTemp[playerid][tAccesoryBuyPage] - 1) * MAX_ACCESORY_BUY_MAX_ITEMS_PAGE)];
		
		
		// SendMes(playerid, -1, "Выбран аксессуар (%s) (ID:%i) | одеваем на персонаж", inventory_items[itemid][ITEM_NAME], itemid);
		// SetPlayerAttachedObject(..)

		items_OnPlayerSpawn(playerid);
		UsePlayerItem(playerid, itemid, .save = 0);

		if (pTemp[playerid][tAccesoryBuySelectID] != -1) {
			PlayerTextDrawBackgroundColor(playerid, BuyAccesoryPTD[playerid][pTemp[playerid][tAccesoryBuySelectID]], COLOR_SERVER);
			PlayerTextDrawShow(playerid, BuyAccesoryPTD[playerid][pTemp[playerid][tAccesoryBuySelectID]]);
		}
		PlayerTextDrawBackgroundColor(playerid, BuyAccesoryPTD[playerid][i], -2139094785);
		PlayerTextDrawShow(playerid, BuyAccesoryPTD[playerid][i]);
		pTemp[playerid][tAccesoryBuySelectID] = i;

		isReturn = true;
		break;
	}
	if (isReturn) return true;
	return false;
}
stock SetAccesoryBuyType(playerid, type) {
	switch (type) {
		case TYPE_ITEMS_COMMON: t_string = "COMMON";
		case TYPE_ITEMS_RARE: t_string = "RARE";
		case TYPE_ITEMS_MYTHICAL: t_string = "MYTHICAL";
		case TYPE_ITEMS_LEGENDARY: t_string = "LEGENDARY";
		case TYPE_ITEMS_UNIQUE: t_string = "UNIQUE";
		case TYPE_ITEMS_ARCANA: t_string = "ARCANA";
	}
	PlayerTextDrawSetString(playerid, BuyAccesoryPTD[playerid][13], t_string), t_string[0] = EOS;
	pTemp[playerid][tAccesoryBuyPage] = 0;
	pTemp[playerid][tAccesoryBuyType] = type;

	PlayerTextDrawShow(playerid, BuyAccesoryPTD[playerid][33]);
	UpdateAccesoryBuyMenuPage(playerid);
	return true;
}
stock UpdateAccesoryBuyMenu(playerid, type) {
	new page = pTemp[playerid][tAccesoryBuyPage];
	pTemp[playerid][tAccesoryBuySelectID] = -1;

	items_OnPlayerSpawn(playerid);

	for (new i = 0, itemid; i < MAX_ACCESORY_BUY_MAX_ITEMS_PAGE; i++) {
		itemid = AccesoryTypeInfo[type - 1][typeItemID][i + ((page - 1) * MAX_ACCESORY_BUY_MAX_ITEMS_PAGE)];
		
		// printf("[LIST] itemid = %i | itemType = %i | type = %i", itemid, inventory_items[itemid][accesoryType], type);

		if (itemid < sizeof (inventory_items) && inventory_items[itemid][accesoryType] == type) {
			PlayerTextDrawBackgroundColor(playerid, BuyAccesoryPTD[playerid][i], COLOR_SERVER);
			PlayerTextDrawSetPreviewModel(playerid, BuyAccesoryPTD[playerid][i], inventory_items[itemid][ITEM_MODEL_ID]);
			PlayerTextDrawSetPreviewRot(playerid, BuyAccesoryPTD[playerid][i], 
				inventory_items[itemid][ITEM_ROT_X], inventory_items[itemid][ITEM_ROT_Y],
				inventory_items[itemid][ITEM_ROT_Z], inventory_items[itemid][ITEM_ROT_ZOOM]
			);
			PlayerTextDrawSetSelectable(playerid, BuyAccesoryPTD[playerid][i], true);
			format(t_string, sizeof (t_string), "%i", inventory_items[itemid][accesoryPrice]);
			PlayerTextDrawSetString(playerid, BuyAccesoryPTD[playerid][i + 14], t_string), t_string[0] = EOS;
		} else {
			PlayerTextDrawBackgroundColor(playerid, BuyAccesoryPTD[playerid][i], 0x000000FF);
			PlayerTextDrawSetPreviewModel(playerid, BuyAccesoryPTD[playerid][i], 0);
			PlayerTextDrawSetPreviewRot(playerid, BuyAccesoryPTD[playerid][i], 0.000000, 0.000000, 0.000000, 100.000000);
			PlayerTextDrawSetSelectable(playerid, BuyAccesoryPTD[playerid][i], false);
			PlayerTextDrawSetString(playerid, BuyAccesoryPTD[playerid][i + 14], " ");
		}
		PlayerTextDrawShow(playerid, BuyAccesoryPTD[playerid][i]);
	}
	pTemp[playerid][tAccesoryBuyType] = type;
} 
stock UpdateAccesoryBuyMenuPage(playerid, page = 1) {
	new 
		type = pTemp[playerid][tAccesoryBuyType],
		maxPage = AccesoryTypeInfo[type - 1][typePages];

	if (page > maxPage) page = maxPage;
	if (page == pTemp[playerid][tAccesoryBuyPage]) return;

	for (new i = 0; i < MAX_ACCESORY_BUY_MAX_PAGE; i++) {
		if (i >= maxPage)
			PlayerTextDrawColor(playerid, BuyAccesoryPTD[playerid][i + 26], 0x000000FF);
		else if (page == (i + 1)) 
			PlayerTextDrawColor(playerid, BuyAccesoryPTD[playerid][i + 26], COLOR_SERVER);
		else PlayerTextDrawColor(playerid, BuyAccesoryPTD[playerid][i + 26], -2139062017);

		PlayerTextDrawShow(playerid, BuyAccesoryPTD[playerid][i + 26]);
	}
	pTemp[playerid][tAccesoryBuyPage] = page; 
	UpdateAccesoryBuyMenu(playerid, type);
} 
stock HideAccesoryBuyMenu(playerid) { 
	if (!pTemp[playerid][tAccesoryBuyMenuShowed]) return false;

	for (new td_id = 0; td_id < sizeof (BuyAccesoryTD); td_id++) 
		TextDrawHideForPlayer(playerid, BuyAccesoryTD[td_id]);
	for (new td_id = 0; td_id < sizeof (BuyAccesoryPTD[]); td_id++) 
		PlayerTextDrawDestroy(playerid, BuyAccesoryPTD[playerid][td_id]);
	pTemp[playerid][tAccesoryBuyMenuShowed] = false;
	TogglePlayerControllable(playerid, true);
	CancelSelectTextDraw(playerid);

	new 
		id = pTemp[playerid][tBusinessID],
		interior_id = BusinessInfo[id][bInteriorID];
	
	PressedPickup[playerid] = BusinessInfo[id][bBuyPickup];

	SetPlayerPosAC(playerid, 
		BusinessInteriorInfo[interior_id][bIntMenuPos][0],
		BusinessInteriorInfo[interior_id][bIntMenuPos][1],
		BusinessInteriorInfo[interior_id][bIntMenuPos][2], BusinessInfo[id][bWorld], BusinessInteriorInfo[interior_id][bIntInterior]
	);//BusinessInteriorInfo[interior_id][bIntInterior]
	SetPlayerFacingAngle(playerid, 0.000);
	
	items_OnPlayerSpawn(playerid);

	TogglePlayerControllable(playerid, true);
	SetCameraBehindPlayer(playerid);
	
	return true;
}
