						ChristmasInfo[playerid][cGift] += 50;
						return true;
					} 
					SavePlayerCristmasInteger(playerid, "cGift", ChristmasInfo[playerid][cGift]);
					new 
						string_[128];
					format(string_, sizeof string_, "[Информация] "colwhi"Вы обменяли 50 подарков на "colwarn"%s", inventory_items[ listGiveItems[rand_modelid] ][ITEM_NAME]);
					SendClientMessage(playerid, COLOR_LI_RED, string_);
					SendClientMessage(playerid, COLOR_RED, !"[Санта] "colwhi"Продолжай искать в том же духе! Я много чего приготовил для Вас!");
				}
				case 2: {
					if (ChristmasInfo[playerid][cBlockGift] > gettime()) {
						SendClientMessage(playerid, COLOR_GREY, !"У Вас заблокирован сбор подарков / обмен / продажа!");
						return 1;
					}
					new	
						idx = 0;
					t_string[0] = EOS;
					for(new i = 0; i < SKIN_ALL_COUNT; i++) {
						if (gSkinInfo[i][SkinGiftCost] == 0) continue;
						if(pInfo[playerid][pSex] == gSkinInfo[i][SkinGender]) {
							format(t_string, sizeof t_string, "%s"colwhi"[%d] Скин ID: "colrose"%d\tЦена: "collime"%d подарков\n", t_string, idx, gSkinInfo[i][SkinID], gSkinInfo[i][SkinGiftCost]);
							playerListItem[playerid][idx] = gSkinInfo[i][SkinID]; 
							playerSelectSlot[playerid][idx] = i;
