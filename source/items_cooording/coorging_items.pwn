			StallMarketInfo[S_IDX][sSlot][select_slot] = pInfo[playerid][PlayerItems][playerSelectSlot[playerid][GetPVarInt(playerid, "SelectIndexSlot")]];
			StallMarketInfo[S_IDX][sSlotCount][select_slot] = GetPVarInt(playerid, "StallSalerCount");
			StallMarketInfo[S_IDX][sSlotCost][select_slot] = cost_;
			pInfo[playerid][PlayerItems][playerSelectSlot[playerid][GetPVarInt(playerid, "SelectIndexSlot")]] = 0;
			pInfo[playerid][PlayerItemsCount][playerSelectSlot[playerid][GetPVarInt(playerid, "SelectIndexSlot")]] = GetPVarInt(playerid, "StallSalerCount");//Drop Count
			SavePlayerInventory(playerid);
			DeletePVar(playerid, "SelectSlotMarket");
			DeletePVar(playerid, "StallSalerCount");
			DeletePVar(playerid, "SelectIndexSlot");
			UpdateMarketPlace(S_IDX);
			return 1;
		}
		case D_INV_UNADD_STALL_ITEMS: {
			if (!response) { 
				return 1;
			}
			if (pTemp[playerid][tRentStallID] == -1) return SendClientMessage(playerid, COLOR_GREY, !"Данный киоск больше не работает");
			new	
				select_ = GetPVarInt(playerid, "SelectOffItem"),
				S_IDX = pTemp[playerid][tSelectStallID];
			if (StallMarketInfo[ S_IDX ][sSlot][select_] == -1) return SendClientMessage(playerid, COLOR_GREY, !"Данная полка пуста!");
			GivePlayerItem(playerid, StallMarketInfo[ S_IDX ][sSlot][select_], StallMarketInfo[ S_IDX ][sSlotCount][select_]);  
			StallMarketInfo[ S_IDX ][sSlotCount][select_] = -1;
			StallMarketInfo[ S_IDX ][sSlotCost][select_] = -1;
			StallMarketInfo[ S_IDX ][sSlot][select_] = -1;
			//UpdateMarketList(S_IDX);
			UpdateMarketPlace(S_IDX);
			SendClientMessage(playerid, COLOR_WHITE, !"Вы успешно сняли товар с продажи!"); 
			return 1;
		}
		case D_CHANGE_STAR_0: {
			if (!response) {
				return true;
			}
			
			switch(listitem) {
				case 0: {//Cash
					if (pInfo[playerid][gStars] < 3) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько звезд!");
					pInfo[playerid][gStars] -= 3;
					if(random(20) == 15) {
						SendClientMessage(playerid, COLOR_LI_RED, !"[Информация] "colwhi"Дорогой друг, коробочка оказалась пустой, мне очень жаль");
						return true;
					}
					new	//listMaxGiveMoney[random(sizeof(listMaxGiveMoney))]
						listMaxGiveMoney[] = {80_000, 80_000, 80_000, 150_000, 80_000, 80_000, 80_000, 150_000, 80_000, 300_000},
						listGivePlayer = RandomFIX(35_000, listMaxGiveMoney[random(sizeof(listMaxGiveMoney))]);
					kLibGivePlayerMoney(playerid, listGivePlayer, "Обменял звезды");
					SavePlayerInteger(playerid, "gStars", pInfo[playerid][gStars]);
					new 
						string_[128];
					format(string_, sizeof string_, "[Информация] "colwhi"Вы обменяли 3 Звезды на "collime"$%d", listGivePlayer);
					SendClientMessage(playerid, COLOR_LI_RED, string_);
					SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Продолжайте искать в том же духе!");
				}
				case 1: {//Item
					if (pInfo[playerid][gStars] < 6) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько звезд!");
					pInfo[playerid][gStars] -= 6;
					if(random(25) == 15) {
