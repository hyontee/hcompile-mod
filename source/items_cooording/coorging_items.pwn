						return true;
					}
					new	 
						listGiveItems[] = {
							/*TYPE_ITEMS_ARCANA - */110, 109, 108, 107, 106, 105, 104, 99,
							/*TYPE_ITEMS_LEGENDARY - */98, 85, 84,
							/*TYPE_ITEMS_UNIQUE - */97, 96,
							/*TYPE_ITEMS_RARE - */94, 93, 92, 91, 90, 89, 88, 87, 86, 
							/*TYPE_ITEMS_UNIQUE - */83, 82, 81, 80, 79, 78
						},
						rand_modelid = random(sizeof(listGiveItems)); 
					if(!GivePlayerItem(playerid, listGiveItems[rand_modelid], 1)) {
						SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Ваш инвентарь полный, Мики вернул тебе звезды!");
						pInfo[playerid][gStars] += 6;
						return true;
					} 
					SavePlayerInteger(playerid, "gStars", pInfo[playerid][gStars]);
					new 
						string_[128];
					format(string_, sizeof string_, "[Информация] "colwhi"Вы обменяли 6 Звезды на "colwarn"%s", inventory_items[ listGiveItems[rand_modelid] ][ITEM_NAME]);
					SendClientMessage(playerid, COLOR_LI_RED, string_);
					SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Продолжайте искать в том же духе!");
				}
				case 2: {
					return true;
				}
			}
			return true;
		}
		case D_CHANGE_STAR_1: {
			if (!response) {
				return true;
			}
			
			switch(listitem) {
				case 0: {//Cash
					if (ChristmasInfo[playerid][cBlockGift] > gettime()) {
						SendClientMessage(playerid, COLOR_GREY, !"У Вас заблокирован сбор подарков / обмен / продажа!");
						return 1;
					}
					if (ChristmasInfo[playerid][cGift] < 10) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько подарков!");
					ChristmasInfo[playerid][cGift] -= 10; 
					new	//listMaxGiveMoney[random(sizeof(listMaxGiveMoney))]
						listMaxGiveMoney[] = {80_000, 80_000, 80_000, 150_000, 80_000, 80_000, 80_000, 150_000, 80_000, 300_000},
						listGivePlayer = RandomFIX(35_000, listMaxGiveMoney[random(sizeof(listMaxGiveMoney))]);
					kLibGivePlayerMoney(playerid, listGivePlayer, "Обменял подарки");
					SavePlayerCristmasInteger(playerid, "cGift", ChristmasInfo[playerid][cGift]);
					new 
						string_[128];
					format(string_, sizeof string_, "[Информация] "colwhi"Вы обменяли 10 Подарков на "collime"$%d", listGivePlayer);
					SendClientMessage(playerid, COLOR_LI_RED, string_);
					SendClientMessage(playerid, COLOR_RED, !"[Санта] "colwhi"Продолжай искать в том же духе! Я много чего приготовил для Вас!");
				}
				case 1: {//Item
					if (ChristmasInfo[playerid][cBlockGift] > gettime()) {
						SendClientMessage(playerid, COLOR_GREY, !"У Вас заблокирован сбор подарков / обмен / продажа!");
						return 1;
					}
					if (ChristmasInfo[playerid][cGift] < 50) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько подарков!");
					ChristmasInfo[playerid][cGift] -= 50;  
					new	 
						listGiveItems[] = {
							/*TYPE_ITEMS_ARCANA - */110, 109, 108, 107, 106, 105, 104, 99,
							/*TYPE_ITEMS_LEGENDARY - */98, 85, 84,
							/*TYPE_ITEMS_UNIQUE - */97, 96,
							/*TYPE_ITEMS_RARE - */94, 93, 92, 91, 90, 89, 88, 87, 86, 
							/*TYPE_ITEMS_UNIQUE - */83, 82, 81, 80, 79, 78
						},
						rand_modelid = random(sizeof(listGiveItems)); 
					if(!GivePlayerItem(playerid, listGiveItems[rand_modelid], 1)) {
