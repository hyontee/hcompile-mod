stock CreateStallChangeStar(id, Float:x, Float:y, Float:z, Float:angle, Float:stream_distance = 100.0, const name[]) {
	new Float:obj_s_Pos[6]; 

	StallStarsChange[id][sObjectID][0] = CreateDynamicObject(3862, x, y, z, 0.000, 0.000, angle, 0, 0, -1, stream_distance); // MainObj
	new 
		rand_text = random(2);
	if (rand_text == 0) {
		SetDynamicObjectMaterial(StallStarsChange[id][sObjectID][0], 0, 19058, "xmasboxes", "wrappingpaper1", 0x00000000);
		SetDynamicObjectMaterial(StallStarsChange[id][sObjectID][0], 1, 19523, "sampicons", "oranggrad32", 0x00000000);
	}
	else if (rand_text == 1) {
		SetDynamicObjectMaterial(StallStarsChange[id][sObjectID][0], 0, 19058, "xmasboxes", "wrappingpaper28", 0x00000000);
		SetDynamicObjectMaterial(StallStarsChange[id][sObjectID][0], 1, 19523, "sampicons", "reeedgrad32", 0x00000000);
	}
	else  {
		SetDynamicObjectMaterial(StallStarsChange[id][sObjectID][0], 0, 19058, "xmasboxes", "wrappingpaper4-2", 0x00000000);
		SetDynamicObjectMaterial(StallStarsChange[id][sObjectID][0], 1, 19523, "sampicons", "yellograd32", 0x00000000);
	}  
	SetDynamicObjectMaterial(StallStarsChange[id][sObjectID][0], 2, 19787, "samplcdtvs1", "samplcdtv1screen", 0x00000000);
	
	

	AttachPosToDynamicObject(StallStarsChange[id][sObjectID][0], 0.069458, -1.406372, 1.460308, 0.000000, 0.000000, 0.000000,
		obj_s_Pos[0], obj_s_Pos[1], obj_s_Pos[2], obj_s_Pos[3], obj_s_Pos[4], obj_s_Pos[5]
	);

	StallStarsChange[id][sObjectID][1] = CreateDynamicObject(19329, obj_s_Pos[0], obj_s_Pos[1], obj_s_Pos[2], obj_s_Pos[3], obj_s_Pos[4], obj_s_Pos[5], 0, 0, -1, stream_distance); 
	SetDynamicObjectMaterial(StallStarsChange[id][sObjectID][1], 0, 19523, "sampicons", "oranggrad32", 0x00000000);

	AttachPosToDynamicObject(StallStarsChange[id][sObjectID][0], 0.069458, -1.436401, 1.460308, 0.000000, 0.000000, 0.000000,
		obj_s_Pos[0], obj_s_Pos[1], obj_s_Pos[2], obj_s_Pos[3], obj_s_Pos[4], obj_s_Pos[5]
	);

	StallStarsChange[id][sObjectID][2] = CreateDynamicObject(19329, obj_s_Pos[0], obj_s_Pos[1], obj_s_Pos[2], obj_s_Pos[3], obj_s_Pos[4], obj_s_Pos[5], 0, 0, -1, stream_distance); 
	new	
		string_[128];
	format(string_, sizeof string_, "%s", name, id);
	SetDynamicObjectMaterialText(StallStarsChange[id][sObjectID][2], 0, string_, 120, "Arial", 34, 1, 0xFFFFFFFF, 0x00000000, 1);
} 


