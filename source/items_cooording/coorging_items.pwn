CMD:teobj(playerid, params[])
{
	if (pInfo[playerid][pAdmin] < 10 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");//2226
	if (sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /teobj [object] [bone]");
	SetPlayerAttachedObject(playerid,0, params[0], params[1], 0.299999,0.099999,0.000000,0.000000,-83.000000,0.000000,1.000000,1.000000,1.000000);
	EditAttachedObject(playerid, 0);
	SetPlayerSkin(playerid, 1);
 
	/*ApplyAnimation(playerid,"CARRY","liftup",1.0,0,1,1,0,0,1);
	SetTimerEx("CarryDelay",1000,false,"d",playerid);*/
	//SetPlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1 , 2060, 1,0.11,0.36,0.0,0.0,90.0);
	return 1;
}
CMD:teobject(playerid, params[])
{
	if (pInfo[playerid][pAdmin] < 5 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
	if (sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /teobject [id object] [bone]");
	new skin = GetPlayerSkin(playerid);
	if (IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid,0);//FishingMedal
	SetPlayerAttachedObject(playerid, 0, params[0], params[1], 
		FishingMedal[skin][0], 
		FishingMedal[skin][1], 
		FishingMedal[skin][2], 
		FishingMedal[skin][3],
		FishingMedal[skin][4], 
		FishingMedal[skin][5],
		FishingMedal[skin][6],
		FishingMedal[skin][7],
		FishingMedal[skin][8]
	);
	/*SetPlayerAttachedObject(playerid, 0, params[0], params[1], 
		MagicHand[skin][0], 
		MagicHand[skin][1], 
		MagicHand[skin][2], 
		MagicHand[skin][3],
		MagicHand[skin][4], 
		MagicHand[skin][5],
		MagicHand[skin][6],
		MagicHand[skin][7],
		MagicHand[skin][8]
	);
	SetPlayerAttachedObject(playerid, 0, params[0], params[1], 
		LomSpine[skin][0], 
		LomSpine[skin][1], 
		LomSpine[skin][2], 
		LomSpine[skin][3],
		LomSpine[skin][4], 
		LomSpine[skin][5],
		LomSpine[skin][6],
		LomSpine[skin][7],
		LomSpine[skin][8]);*/
	return 1;
}

items_OnDialogResponse(playerid, dialogid, response, listitem, const inputtext[]) 
{
	//#pragma unused inputtext
	switch(dialogid)
	{
		case D_ITEMS_BUY_TYPE: {
			if (!response || !pTemp[playerid][tAccesoryBuyMenuShowed]) {
				return true;
			}
			if (!AccesoryTypeInfo[listitem][typeItemsCount]) {
				SendClientMessage(playerid, COLOR_GREY, !"Данный вид аксессуара недоступен!");
				return true;
			}
			SetAccesoryBuyType(playerid, listitem + 1);
			return true;
		}
		case D_ITEMS_BUY:
		{
			if (!response) return 1; 
			new 
				idx = 0,
				count = 0,
				string_[128];
			t_string[0] = EOS;
			for (new i = 0; i < sizeof (inventory_items); i++)
			{
				if (inventory_items[i][accesoryIndex] == listitem/*INDEX_SLOT_ITEMS_0*/)
				{
					format(string_, sizeof string_, ""colwhi"[%d] %s\n", count, inventory_items[i][ITEM_NAME]);
					strcat(t_string, string_);
					playerListItem[playerid][idx++] = i;
				} 
				count++;
			}
			ShowPlayerDialog(playerid, D_ITEMS_BUY_, DIALOG_STYLE_LIST, "Купить объект", t_string, "Купить", "Закрыть"); 
		}
		case D_ITEMS_BUY_:
		{
			if (!response) return 1; 
			new 
				modelid = playerListItem[playerid][listitem],
				string_[128];
			GivePlayerItem(playerid, modelid/*inventory_items[modelid][ITEM_MODEL_ID]*/, 1);
			format(string_, sizeof string_, "Вы купили аксесуар: %s, за %d", inventory_items[modelid][ITEM_NAME], inventory_items[modelid][accesoryPrice]);
			SendClientMessage(playerid, COLOR_GREY, string_);
			//SendClientMessage(playerid, COLOR_BLUE, "Вы установили бумбокс, для включения используйте: /boombox");
		}
		case D_INV:
		{
			if (!response) return 1; 
			if (playerListItem[playerid][listitem] == -1) return 1;
			new 
				modelid = playerListItem[playerid][listitem],
				select_slot = playerSelectSlot[playerid][listitem];
			printf("modelid: %d | slot: %d", modelid, select_slot);
			SelectPlayerItem(playerid, modelid, select_slot); 
			return 1;
		}
		case D_INV_:
		{
			if (!response)
			{
				//callcmd::inventory(playerid);
				DeletePVar(playerid, "PlayerInventory");
				return true;
			}
			new 
				modelid = GetPVarInt(playerid, "PlayerInventory"),
				select_slot = GetPVarInt(playerid, "PlayerSelectSlot"); 
			switch(listitem)
			{
				case 0:
				{
					UsePlayerItem(playerid, modelid);
					DeletePVar(playerid, "PlayerInventory");
				}
				case 1:
				{
					UnUsePlayerItem(playerid, modelid);
					DeletePVar(playerid, "PlayerInventory");
				}
				case 2:
				{
					DropPlayerItem(playerid, modelid, select_slot);
					DeletePVar(playerid, "PlayerInvetory");
					DeletePVar(playerid, "PlayerSelectSlot");
				}
				case 3: {
					if (pInfo[playerid][PlayerItems][select_slot] == 0 && pInfo[playerid][PlayerItemsCount][select_slot] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка слота или кол-во");
					if (SearchUseItem(playerid, modelid)) return SendClientMessage(playerid, COLOR_GREY, !"Данный предмет одет на Ваш скин!"); 
					pInfo[playerid][PlayerItems][select_slot] 		= 
					pInfo[playerid][PlayerItemsCount][select_slot]	= 0; 
					new	
						string_[128];
					format(string_, sizeof string_, "[Оповещение] "colwhi"Вы успешно удалили предмет "colrose"\"%s\" "colwhi"из инвентаря!", inventory_items[modelid][ITEM_NAME]);
					SendClientMessage(playerid, COLOR_LI_RED, string_);
					SavePlayerInventory(playerid);   
				}
				case 4://sell
				{

					/*new	
						str_[64];
					format(str_, sizeof str_, ""colserver"Продажа: "colwhi"Предмета: %s", inventory_items[modelid][ITEM_NAME]);
					ShowPlayerDialog(playerid, D_INV_SELL, DIALOG_STYLE_INPUT, str_, 
						""colwhi"Укажите ID игрока и цену на предмет который хотите продать\n\nПример: 30, 100000", "Выбрать", "Назад");*/
					DeletePVar(playerid, "PlayerInventory");
				}
			}
		}
		case D_INV_RC:
		{
			if (!response) { 
				DeletePVar(playerid, "PlayerInventory");
				return true;
			}
			new 
				modelid = GetPVarInt(playerid, "PlayerInventory"),
				select_slot = GetPVarInt(playerid, "PlayerSelectSlot"); 
			switch(listitem)
			{
				case 0: {
					UsePlayerItem(playerid, modelid);
					DeletePVar(playerid, "PlayerInventory");
				}
				case 1: {//Использовать как транспорт 
					if (pTemp[playerid][tVehicleRC] != INVALID_VEHICLE_ID) {
						SendClientMessage(playerid, COLOR_GREY, !"Вы уже управлете одной из игрушек");
						SendClientMessage(playerid, COLOR_GREY, !"[Подсказка] "colwhi"Используйте "colserver"\"CTRL\" - для выхода");
						return 1;
					}
					if (GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendClientMessage(playerid, COLOR_GREY, !"Вы должны быть не в транспорте!");
					if (GetPlayerInterior(playerid) != INTERIOR_NONE) return SendClientMessage(playerid, COLOR_GREY, !"Вы должны быть на улице");
					new 
						Float:pl_posX, 
						Float:pl_posY, 
						Float:pl_posZ, 
						Float:pl_posA;
					GetPlayerPos(playerid, pl_posX, pl_posY, pl_posZ);
					GetPlayerFacingAngle(playerid, pl_posA);

					if (pTemp[playerid][tVehicleRC] != INVALID_VEHICLE_ID) _DestroyVehicle(pTemp[playerid][tVehicleRC]);

					pTemp[playerid][tVehicleRC] = _CreateVehicle(inventory_items[modelid][ITEM_MODEL_ID], pl_posX, pl_posY, pl_posZ, pl_posA, random(100), random(100), 900);
					VehicleInfo[pTemp[playerid][tVehicleRC] - 1][vFuel] = GetModelMaxFuel(VehicleInfo[ pTemp[playerid][tVehicleRC] - 1 ][vModel]);
					
					SetVehicleVirtualWorld(pTemp[playerid][tVehicleRC], 0);
					LinkVehicleToInterior(pTemp[playerid][tVehicleRC], 0);
					PutPlayerInVehicle(playerid, pTemp[playerid][tVehicleRC], 0);
				
					SetVehicleParamsEx(pTemp[playerid][tVehicleRC], true, lights2, alarm2, doors3, bonnet2, boot1, objective1); 
					SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Для выхода из RC игрушки, используйте клавишу "colserver"\"CTRL\"");
					DeletePVar(playerid, "PlayerInventory");
				}
				case 2: {
					UnUsePlayerItem(playerid, modelid);
					DeletePVar(playerid, "PlayerInventory");
				}
				case 3: {
					DropPlayerItem(playerid, modelid, select_slot);
					DeletePVar(playerid, "PlayerInvetory");
					DeletePVar(playerid, "PlayerSelectSlot");
				}
				case 4: {
					if (pInfo[playerid][PlayerItems][select_slot] == 0 && pInfo[playerid][PlayerItemsCount][select_slot] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка слота или кол-во");
					if (SearchUseItem(playerid, modelid)) return SendClientMessage(playerid, COLOR_GREY, !"Данный предмет одет на Ваш скин!"); 
					pInfo[playerid][PlayerItems][select_slot] 		= 
					pInfo[playerid][PlayerItemsCount][select_slot]	= 0; 
					new	
						string_[128];
					format(string_, sizeof string_, "[Оповещение] "colwhi"Вы успешно удалили предмет "colrose"\"%s\" "colwhi"из инвентаря!", inventory_items[modelid][ITEM_NAME]);
					SendClientMessage(playerid, COLOR_LI_RED, string_);
					SavePlayerInventory(playerid);   
				} 
			}
		}
		case D_INV_INFO:
		{
			if (!response) { 
				DeletePVar(playerid, "PlayerInventory");
				return true;
			}
			new 
				modelid = GetPVarInt(playerid, "PlayerInventory");
			switch(listitem) {
				case 0: {
					new	
						str_[64];
					format(str_, sizeof str_, ""colserver"Информация: "colwhi"Предмета: %s", inventory_items[modelid][ITEM_NAME]);
					t_string[0] = EOS;
					format(t_string, sizeof t_string, "\n"colwhi"%s", inventory_items[modelid][ITEM_INFO]);
					ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, str_, t_string, "Закрыть", "");
					DeletePVar(playerid, "PlayerInventory");
				}
				case 1: {//Информация:

				}
			}
			return 1;
		}
		case D_INV_RENT_STALL: {
			if (!response) {
				SendClientMessage(playerid, COLOR_WHITE, !"Вы отказались от аренды киоска!");
				return 1;
			}
			else {
				if (pTemp[playerid][tSelectStallID] == -1) return SendClientMessage(playerid, COLOR_GREY, !"В зоне стрима нет киоска!");
				ShowMarketArenda(playerid, pTemp[playerid][tSelectStallID]);
			}
		}
		case D_INV_UNRENT_STALL_0: {
			if (!response) {
				SendClientMessage(playerid, COLOR_BLUE, !"Вы сильный торговец на нашем рынке!");
			} else {
				SendClientMessage(playerid, COLOR_BLUE, !"Вы успешно освободили \"Киоск\" рынка!");
				new	
					S_IDX = pTemp[playerid][tRentStallID]; 
				if (S_IDX == -1) return 1;
				StallMarketInfo[S_IDX][sID] = -1;
				for(new i; i < MAX_STALL_SLOTS; i ++)
				{
					if (StallMarketInfo[S_IDX][sSlot][i] != -1) {
						GivePlayerItem(playerid, StallMarketInfo[S_IDX][sSlot][i], StallMarketInfo[S_IDX][sSlotCount][i]); 
					}
					StallMarketInfo[S_IDX][sSlot][i] = -1;
					StallMarketInfo[S_IDX][sSlotCost][i] = -1;
					StallMarketInfo[S_IDX][sSlotCount][i] = -1; 
				}
				new	
					string_[128];
				format(string_, sizeof string_, "Киоск: №%d\nПродавец: Отсутствует", S_IDX);
				SetDynamicObjectMaterialText(StallMarketInfo[S_IDX][sObjectID][2], 0, string_, 120, "Arial", 34, 1, 0xFFFFFFFF, 0x00000000, 1); 

				format(string_, sizeof string_, 
					""colserver"Киоск №: %d\n\
					"colwhi"Стоимость аренды: "collime"$%d", 
					S_IDX, COST_STALL
				);
				UpdateDynamic3DTextLabelText(StallMarketInfo[S_IDX][sText],-1, string_);
				
				pTemp[playerid][tRentStallID] = -1; 
			}
			return true;
		}
		case D_INV_ADD_STALL_ITEMS: {
			if (!response) {
				return 1;
			}
			new 
				S_IDX = pTemp[playerid][tSelectStallID],
				select_ = listitem; 
			if (StallMarketInfo[ S_IDX ][sID] == -1) return SendClientMessage(playerid, COLOR_GREY, !"Данный киоск больше не работает");
			if (pTemp[playerid][tRentStallID] == S_IDX) { /* OWNER RENT */
				if (listitem == 5) {
					ShowPlayerDialog(playerid, D_INV_UNRENT_STALL_0, DIALOG_STYLE_MSGBOX, 
						""colserver"Киоск: "colwhi"Освободить",
						""colwhi"Вы действительно желаете освободить данный столик?",
						"Да", "Нет"
					);
					return 1;
				}
				if (StallMarketInfo[ pTemp[playerid][tRentStallID] ][sSlot][select_] != -1)
				{
					/* OFF SALE */
					//StallMarketInfo[ S_IDX ][sSlotAction][select_] = true; 
					SetPVarInt(playerid, "SelectOffItem", select_);
					ShowPlayerDialog(playerid, D_INV_UNADD_STALL_ITEMS, DIALOG_STYLE_MSGBOX, ""colserver"Киоск: "colwhi"Снять с продажи", ""colwhi"Вы действительно хотите снять данный товар с продажи?", "Да", "Нет");
					return 1;
				}  
				new idx = 0;
				t_string[0] = EOS;
				strcat(t_string, ""colserver"[№] Название(кол-во)\t"colserver"[Тип]\n");
				for(new i = 0, string_[128]; i < MAX_ITEMS_SLOTS; i++)
				{   
					if (!pInfo[playerid][PlayerItems][i]) continue; 
					new 
						typeItems = inventory_items[ pInfo[playerid][PlayerItems][i] ][accesoryType];
					format(string_, sizeof string_, ""colwhi"[%d] %s(%d шт.)\t{%s}[%s]\n", idx, 
						inventory_items[ pInfo[playerid][PlayerItems][i] ][ITEM_NAME], 
						pInfo[playerid][PlayerItemsCount][i], 
						colorItems[typeItems - 1], 
						nameItems[typeItems - 1]
					);
					strcat(t_string, string_); 
					playerListItem[playerid][idx] = pInfo[playerid][PlayerItems][i]; 
					playerSelectSlot[playerid][idx] = i;
					idx++;
				}
				if (idx == 0) {
					SendClientMessage(playerid, COLOR_GREY, !"Ваш инвентарь пуст!");
					playerListItem[playerid][idx] = -1;
					playerSelectSlot[playerid][idx] = -1;
					return 1;
				}
				else ShowPlayerDialog(playerid, D_INV_ADD_STALL_ITEMS_0, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Инвентарь: "colwhi"Аксессуары", t_string, "Выбрать", "Отмена"); 
				SetPVarInt(playerid, "SelectSlotMarket", listitem);
				SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Выберети предмет который желаете продать");
			} else {
				if (StallMarketInfo[ S_IDX ][sSlot][select_] == -1) return SendClientMessage(playerid, COLOR_GREY, !"Данная полка пуста");
				if (kLibGetPlayerMoney(playerid) < StallMarketInfo[ S_IDX ][sSlotCost][select_]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько денег!");
				kLibGivePlayerMoney(playerid, -StallMarketInfo[ S_IDX ][sSlotCost][select_], "Купил предмет рынок");
				kLibGivePlayerMoney(StallMarketInfo[ S_IDX ][sID], StallMarketInfo[ S_IDX ][sSlotCost][select_], "Продал предмет рынок");
				GivePlayerItem(playerid, StallMarketInfo[ S_IDX ][sSlot][select_], StallMarketInfo[ S_IDX ][sSlotCount][select_]); 
				format(t_string, sizeof t_string, "Поздравляем Вас с покупкой (%s) за "collime"$%d", inventory_items[ StallMarketInfo[ S_IDX ][sSlot][select_] ][ITEM_NAME], StallMarketInfo[ S_IDX ][sSlotCost][select_]);
				SendClientMessage(playerid, COLOR_BLUE, t_string);
				format(t_string, sizeof t_string, "%s купил у Вас (%s) за "collime"$%d", pInfo[playerid][pName], inventory_items[ StallMarketInfo[ S_IDX ][sSlot][select_] ][ITEM_NAME], StallMarketInfo[ S_IDX ][sSlotCost][select_]);
				SendClientMessage(StallMarketInfo[ S_IDX ][sID], COLOR_BLUE, t_string), t_string[0] = EOS;
				StallMarketInfo[ S_IDX ][sSlotCount][select_] --;
				if (StallMarketInfo[ S_IDX ][sSlotCount][select_] < 0) {
					StallMarketInfo[ S_IDX ][sSlotCount][select_] = -1;
					StallMarketInfo[ S_IDX ][sSlot][select_] = -1;
					StallMarketInfo[ S_IDX ][sSlotCost][select_] = -1;
				}
				UpdateMarketList(S_IDX);
				ShowMarketList(playerid, S_IDX);

			}
			return 1;	
		}
		case D_INV_ADD_STALL_ITEMS_0: {
			if (!response) {
				DeletePVar(playerid, "SelectSlotMarket"); 
				return 1;
			}
			if (pTemp[playerid][tRentStallID] == -1) return SendClientMessage(playerid, COLOR_GREY, !"Данный киоск больше не работает");
			new 
				select_slot = playerSelectSlot[playerid][listitem]; 
			SetPVarInt(playerid, "SelectIndexSlot", listitem);
			//SendMes(playerid, -1, "IDX %d | Select %d", GetPVarInt(playerid, "SelectIndexSlot"), select_slot);
			if (pInfo[playerid][PlayerItems][select_slot] <= 0) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет такого предмета в инвентаре"); 
			if (SearchUseItem(playerid, pInfo[playerid][PlayerItems][select_slot])) return SendClientMessage(playerid, COLOR_GREY, !"Данный предмет одет на Ваш скин!");   
			ShowPlayerDialog(playerid, D_INV_ADD_STALL_ITEMS_1, DIALOG_STYLE_INPUT, ""colserver"Киоск: "colwhi"Укажите количество", ""colwhi"Введите кол-во предметов, которые хотите выставить на продажу", "Далее", "Отмена"); 
			return 1;
		}
		case D_INV_ADD_STALL_ITEMS_1: {
			if (!response) {
				DeletePVar(playerid, "SelectSlotMarket");
				DeletePVar(playerid, "SelectIndexSlot");
				return 1;
			}
			if (pTemp[playerid][tRentStallID] == -1) return SendClientMessage(playerid, COLOR_GREY, !"Данный киоск больше не работает");
			new 
				amount = strval(inputtext),
				select_slot = playerSelectSlot[playerid][GetPVarInt(playerid, "SelectIndexSlot")];
			if ((!amount || amount < 1 || amount > pInfo[playerid][PlayerItemsCount][select_slot])) {
				SendClientMessage(playerid, COLOR_GREY, !"У вас нет столько предметов в инвентаре");
				ShowPlayerDialog(playerid, D_INV_ADD_STALL_ITEMS_1, DIALOG_STYLE_INPUT, ""colserver"Киоск: "colwhi"Укажите количество", ""colwhi"Введите кол-во предметов, которые хотите выставить на продажу", "Далее", "Отмена"); 
				return 1;
			}
			//if (amount > pInfo[playerid][PlayerItemsCount][select_slot]) return SendClientMessage(playerid, COLOR_GREY, !"У вас нет столько предметов в инвентаре");
			SetPVarInt(playerid, "StallSalerCount", amount);
			ShowPlayerDialog(playerid, D_INV_ADD_STALL_ITEMS_2, DIALOG_STYLE_INPUT, ""colserver"Киоск: "colwhi"Укажите цену", ""colwhi"Введите цену за один предмет", "Далее", "Отмена"); 
			return 1; 
		}
		case D_INV_ADD_STALL_ITEMS_2: {
