							"colwhi"Мы хотели бы извиниться и просим прощения!\n\n\
							"colrose"Статистика: "collime"%d игроков "colwhi"нас простили, "col_li_red"%d игроков "colwhi"не простили\n\n\
							Вам выбирать заслужим мы его или нет", pInfo[playerid][pName], HelllowenSorry, HelllowenNoSorry
						);
						ShowPlayerDialog(playerid, D_CHANGE_STAR_3, DIALOG_STYLE_MSGBOX, ""colserver"Обращение от руководства", t_string, "Прощаю", "Не прощения");
						return 1;
					} 
					ShowPlayerDialog(playerid, D_CHANGE_STAR_4, DIALOG_STYLE_TABLIST, ""colserver"Обмен: "colwhi"Подарков", 
						""colwhi"[0] Предмет: "colrose"Деревянный гроб\tЦена: "collime"120 подарков\n\
						"colwhi"[1] Предмет: "colrose"Череп дьявола\tЦена: "collime"150 подарков\n\
						"colwhi"[2] Предмет: "colrose"Бензопила \"Дилдо\"\tЦена: "collime"250 подарков\n\
						"colwhi"[3] Предмет: "colrose"Церковный крест\tЦена: "collime"50 подарков\n", "Купить", "Закрыть"
					);
					return 1;
				}
				case 4: {
					ShowPlayerDialog(playerid, D_CHANGE_STAR_5, DIALOG_STYLE_MSGBOX, ""colserver"Лу: "colwhi"Спидранер", 
						""colwhi"Смотрю ты быстр и энергичен?\nТогда я могу тебе предложить купить у меня за "collime"$10.000 "colwhi"координаты подарка\n\
						Есть одно но! Ты можешь быть не первым кто его найдет!", 
						"Покупаю", "Закрыть"
					);
					return true;
				}
				case 5: {
					return true;
				}
			}
			return true;
		} 
		case D_CHANGE_STAR_5: {
			if (!response) {
				return true;
			}
			if (kLibGetPlayerMoney(playerid) < 10_000) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько денег");
			kLibGivePlayerMoney(playerid, -10000, "speedrun Ly");
			new bool: IsNull = false;
			for(new i = 0; i < MAX_BOX_COUNT; i++) { 
				if (ChristmasBoxInfo[i][xGetTime] > gettime()) continue; 
				if (!ChristmasBoxInfo[i][xSpawn]) continue;  
				SetPlayerCheckpoint(playerid, ChristmasBoxInfo[i][xCooord][0], ChristmasBoxInfo[i][xCooord][1], ChristmasBoxInfo[i][xCooord][2], 5.0);
				CP[playerid] = 777; 
				IsNull = true;
				break;
			}
		//	SendActorMessage(playerid, "Беги форест! беги!");
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Вам надо успеть раньше всех");
			if (!IsNull) {
				SendClientMessage(playerid, COLOR_GREY, !"В данный момент подарков нет, подойдите позже");
				SendClientMessage(playerid, COLOR_GREY, !"Лу, вернул Вам деньги");
				kLibGivePlayerMoney(playerid, 10000, "return Ly");
			}
			return true;
		}
		case D_CHANGE_STAR_2: {
			if (!response) {
				return true;
			}
			new 
				modelid = playerListItem[playerid][listitem],
				select_slot = playerSelectSlot[playerid][listitem];
			printf("modelid: %d | slot: %d | Skin ID %d", modelid, select_slot, gSkinInfo[select_slot][SkinID]);
			SendClientMessage(playerid, COLOR_RED, !"[Санта] "colwhi"Тебя интересуют данные скины? Тогда собирай подарки и скоро ты сможешь получить данную одежду!");
			SendClientMessage(playerid, COLOR_RED, !"[Санта] "colwhi"За каждые три часа игры ты получаешь один подарок от меня!");
			return 1;
		}
		case D_CHANGE_STAR_3: {
			new t_query[64];
			if (response) {
				HelllowenSorry++; 
				format(t_query, sizeof(t_query),"UPDATE `s_others` SET `hellowen_sorry`= '%d'", HelllowenSorry);
				mysql_tquery(dbHandle, t_query, "", "");
			}
			else {
				HelllowenNoSorry++;
				format(t_query, sizeof(t_query),"UPDATE `s_others` SET `hellowen_Nosorry`= '%d'", HelllowenSorry);
				mysql_tquery(dbHandle, t_query, "", "");
			}
			SendClientMessage(playerid, COLOR_RED, !"[Санта] "colwhi"Йо-хо-хо, Ты в этом году вел себя лучше чем руководство проекта!");
			SendClientMessage(playerid, COLOR_RED, !"[Санта] "colwhi"По этому я дарю тебе 3 подарка!");
			ChristmasInfo[playerid][cGift] += 3;
			ChristmasInfo[playerid][cPoll] = 1;
			SavePlayerCristmasInteger(playerid, "cGift", ChristmasInfo[playerid][cGift]);
			SavePlayerCristmasInteger(playerid, "cPoll", ChristmasInfo[playerid][cPoll]);
			ShowPlayerDialog(playerid, D_CHANGE_STAR_4, DIALOG_STYLE_TABLIST, ""colserver"Обмен: "colwhi"Подарков", 
				""colwhi"[0] Предмет: "colrose"Деревянный гроб\tЦена: "collime"120 подарков\n\
				"colwhi"[1] Предмет: "colrose"Череп дьявола\tЦена: "collime"150 подарков\n\
				"colwhi"[2] Предмет: "colrose"Бензопила \"Дилдо\"\tЦена: "collime"250 подарков\n\
				"colwhi"[3] Предмет: "colrose"Церковный крест\tЦена: "collime"50 подарков\n", "Купить", "Закрыть"
			);
			return 1;
		}
		case D_CHANGE_STAR_4: {
			if (!response) {
				return true;
			}
			new
				costGift[] = {120, 150, 250, 50},
				giveItem[] = {111, 112, 120, 122};
			if (ChristmasInfo[playerid][cGift] < costGift[listitem]) return SendClientMessage(playerid, COLOR_GREY, !"У Вас нет столько подарков!");
			ChristmasInfo[playerid][cGift] -= costGift[listitem];
			if(!GivePlayerItem(playerid, giveItem[listitem], 1)) {
				SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Ваш инвентарь полный, Лу вернул Вам подарки!");
				ChristmasInfo[playerid][cGift] += costGift[listitem];
				SavePlayerCristmasInteger(playerid, "cGift", ChristmasInfo[playerid][cGift]);
				return true;
			} 
			SavePlayerCristmasInteger(playerid, "cGift", ChristmasInfo[playerid][cGift]);
			new 
				string_[128];
			format(string_, sizeof string_, "[Информация] "colwhi"Вы обменяли %d подарков на "colwarn"%s", costGift[listitem], inventory_items[ giveItem[listitem] ][ITEM_NAME]);
			SendClientMessage(playerid, COLOR_LI_RED, string_);
			SendClientMessage(playerid, COLOR_RED, !"[Санта] "colwhi"Продолжай искать в том же духе! Я много чего приготовил для Вас!");
			return 1;

		}
	} 


	return false;
} 
CMD:givestar(playerid, params[])
{
    if (pInfo[playerid][pAdmin] < 10 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
	if (sscanf(params, "ud",params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /givestar [ид] [сумма]");
	if (!PlayerInConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден!");
	if (params[1] < 1 || params[1] > 15) return SendClientMessage(playerid, COLOR_GREY, !"Значение Выходит за допустимые пределы");
	new 
		str_[128];
	pInfo[params[0]][gStars] += params[1];
	format(str_, sizeof str_, "[A] Вы выдали %d звезд игроку %s[%d]", params[1], pInfo[params[0]][pName], params[0]);
	SendClientMessage(playerid, COLOR_WHITE, str_); 
	LogingAdmins(playerid, pInfo[params[0]][pName], "givestar", params[1],"/givestar");
	return 1;
}
CMD:findstars(playerid){
    if (pInfo[playerid][pAdmin] < 9 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
    SetPlayerCheckpoint(playerid, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2], 5.0);
	return SendClientMessage(playerid, -1, #Метка установлена на карте!);
}
CMD:sgoto(playerid, params[])
{
	if (pInfo[playerid][pAdmin] < 8 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
	if (sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /sgoto [tag number]");
	if (params[0] < 1 || params[0] > 60) return SendClientMessage(playerid, COLOR_GREY, !"Значение Выходит за допустимые пределы");
	SetPlayerPosAC(playerid, HNYIOne[params[0]][0], HNYIOne[params[0]][1], HNYIOne[params[0]][2], 0, 0);
	SetPlayerFacingAngle(playerid, 0.0);
	return 1;
}
CMD:gstars(playerid){
	if (!pInfo[playerid][pLogin]) return true;
	if (pInfo[playerid][gStars] >= 15) return SendClientMessage(playerid, COLOR_GREY, !"Вы нашли максимально кол-во звезд!");
	if (IsPlayerInRangeOfPoint(playerid, 300.0, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2])){
	    new string_[70];
		if (IsPlayerInRangeOfPoint(playerid, 5.0, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2])){
			pInfo[playerid][gStars]++;
			SavePlayerInteger(playerid, "gStars", pInfo[playerid][gStars]);
            r_ObjStar = random(59);
            DestroyDynamicObject(id_dObj[0]);
			DestroyDynamicObject(id_dObj[1]);
			OnPlayerAchievProgress(playerid, 1);
			id_dObj[0] = CreateDynamicObject(1247, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2], HNYIOne[r_ObjStar][3], 0.00000, 0.00000);
			id_dObj[1] = CreateDynamicObject(18728, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2], 0.0, 0.00000, 0.00000); 
			format(string_, sizeof string_, "Вы нашли звезду! На данный момент у Вас %d %s", pInfo[playerid][gStars], Declension_ReturnWord(pInfo[playerid][gStars], "звезда", "звезды", "звезд"));
			SendClientMessage(playerid, -1, string_);
		}
		else{
			format(string_, sizeof string_, "Не по далеку от Вас находится звезда! Расстояние до неё: %0.2f", GetPlayerDistanceFromPoint(playerid, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2]));
			SendClientMessage(playerid, -1, string_);
		}
	}
	else SendClientMessage(playerid, -1, !"Рядом с Вами нет звезд!");
	return 1;
}
items_OnPlayerDisconnect(playerid) {
	if (pTemp[playerid][tRentStallID] != -1) {
		new	
			S_IDX = pTemp[playerid][tRentStallID];
		ClearMarketRent(playerid, S_IDX);
	}
	pTemp[playerid][tSelectAreaStall] = false;
	pTemp[playerid][tSelectStallID] = -1;
}
