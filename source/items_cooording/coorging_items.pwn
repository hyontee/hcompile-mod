			}
			if (pTemp[playerid][tRentStallID] == -1) return SendClientMessage(playerid, COLOR_GREY, !"Данный киоск больше не работает");
			new 
				cost_ = strval(inputtext);
			if (cost_ < 1 || cost_ > 50_000_000) return SendClientMessage(playerid, COLOR_GREY, !"От 1 до 50.000.000");
			new 
