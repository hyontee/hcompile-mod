	BuyAccesoryPTD[playerid][31] = CreatePlayerTextDraw(playerid, 109.21616 - ((11.199829+11.199829/1.25)/2), 255.592651, "LD_BEAT:chit");
	BuyAccesoryPTD[playerid][32] = CreatePlayerTextDraw(playerid, 120.41598 - ((11.199829+11.199829/1.25)/2), 255.592651, "LD_BEAT:chit");

	for (new td_id = 0; td_id < MAX_ACCESORY_BUY_MAX_ITEMS_PAGE; td_id++) {
		PlayerTextDrawTextSize(playerid, BuyAccesoryPTD[playerid][td_id], 31.000000, 34.000000);
		PlayerTextDrawAlignment(playerid, BuyAccesoryPTD[playerid][td_id], 1);
		PlayerTextDrawColor(playerid, BuyAccesoryPTD[playerid][td_id], -1);
		PlayerTextDrawSetShadow(playerid, BuyAccesoryPTD[playerid][td_id], 0);
		PlayerTextDrawBackgroundColor(playerid, BuyAccesoryPTD[playerid][td_id], COLOR_SERVER);
		PlayerTextDrawFont(playerid, BuyAccesoryPTD[playerid][td_id], 5);
		PlayerTextDrawSetProportional(playerid, BuyAccesoryPTD[playerid][td_id], 0);
		PlayerTextDrawSetSelectable(playerid, BuyAccesoryPTD[playerid][td_id], true);
		PlayerTextDrawSetPreviewModel(playerid, BuyAccesoryPTD[playerid][td_id], 0);
		PlayerTextDrawSetPreviewRot(playerid, BuyAccesoryPTD[playerid][td_id], 0.000000, 0.000000, 0.000000, 100.000000);
		
		PlayerTextDrawLetterSize(playerid, BuyAccesoryPTD[playerid][td_id + 14], 0.175411, 0.759998);
		PlayerTextDrawAlignment(playerid, BuyAccesoryPTD[playerid][td_id + 14], 3);
		PlayerTextDrawColor(playerid, BuyAccesoryPTD[playerid][td_id + 14], 255);
		PlayerTextDrawSetShadow(playerid, BuyAccesoryPTD[playerid][td_id + 14], 0);
		PlayerTextDrawBackgroundColor(playerid, BuyAccesoryPTD[playerid][td_id + 14], 255);
		PlayerTextDrawFont(playerid, BuyAccesoryPTD[playerid][td_id + 14], 1);
		PlayerTextDrawSetProportional(playerid, BuyAccesoryPTD[playerid][td_id + 14], 1);

		if (td_id >= MAX_ACCESORY_BUY_MAX_PAGE) continue;

		PlayerTextDrawTextSize(playerid, BuyAccesoryPTD[playerid][td_id + 26], 12.000000, 12.000000);
		PlayerTextDrawAlignment(playerid, BuyAccesoryPTD[playerid][td_id + 26], 1);
		PlayerTextDrawSetShadow(playerid, BuyAccesoryPTD[playerid][td_id + 26], 0);
		PlayerTextDrawBackgroundColor(playerid, BuyAccesoryPTD[playerid][td_id + 26], 255);
		PlayerTextDrawFont(playerid, BuyAccesoryPTD[playerid][td_id + 26], 4);
		PlayerTextDrawSetProportional(playerid, BuyAccesoryPTD[playerid][td_id + 26], 0);
		PlayerTextDrawSetSelectable(playerid, BuyAccesoryPTD[playerid][td_id + 26], true);
	}
	BuyAccesoryPTD[playerid][33] = CreatePlayerTextDraw(playerid, 57.916667, 284.148101, "particle:lamp_shad_64");
	PlayerTextDrawTextSize(playerid, BuyAccesoryPTD[playerid][13], 51.000000, 16.000000);
	PlayerTextDrawAlignment(playerid, BuyAccesoryPTD[playerid][33], 1);
	PlayerTextDrawColor(playerid, BuyAccesoryPTD[playerid][33], -120);
	PlayerTextDrawSetShadow(playerid, BuyAccesoryPTD[playerid][33], 0);
	PlayerTextDrawBackgroundColor(playerid, BuyAccesoryPTD[playerid][33], 0);
	PlayerTextDrawFont(playerid, BuyAccesoryPTD[playerid][33], 4);
	PlayerTextDrawSetProportional(playerid, BuyAccesoryPTD[playerid][33], 0);

	for (new td_id = 0; td_id < sizeof (BuyAccesoryTD); td_id++) 
		TextDrawShowForPlayer(playerid, BuyAccesoryTD[td_id]);
	for (new td_id = 0; td_id < sizeof (BuyAccesoryPTD[]); td_id++) 
		PlayerTextDrawShow(playerid, BuyAccesoryPTD[playerid][td_id]);

	pTemp[playerid][tAccesoryBuyType] = TYPE_ITEMS_COMMON;
	pTemp[playerid][tAccesoryBuyPage] = 0;
	UpdateAccesoryBuyMenuPage(playerid);
	SelectTextDraw(playerid, 0xFF7F50FF);

	TogglePlayerControllable(playerid, false);
	SetCameraBehindPlayer(playerid);
	new 
		id = pTemp[playerid][tBusinessID];
	if (BusinessInfo[id][bType] == BUSINESS_TYPE_VICTIM) {
		SetPlayerPosAC(playerid, 222.3489, -8.5845, 1002.2109, playerid, 5);
		SetPlayerFacingAngle(playerid, 266.7302);
		SetPlayerCameraPos(playerid, 225.3489, -8.5845, 1002.2109);
		SetPlayerCameraLookAt(playerid, 222.3489, -8.5845, 1002.2109);

		//InterpolateCameraPos(playerid, 225.3489 + (2.5 * floatsin(-89.8527, degrees)), -8.5845 + (2.5 * floatcos(-89.8527, degrees)), 1002.2109, 222.3489, -8.5845, 1002.2109, 1300);
		//InterpolateCameraLookAt(playerid, 225.3489, -8.5845, 1002.2109, 222.3489, -8.5845, 1002.2109, 1300);
	}
	else if (BusinessInfo[id][bType] == BUSINESS_TYPE_ZIP) {
		SetPlayerPosAC(playerid, 176.6238, -72.6065, 1001.8047, playerid, 18); 
		SetPlayerFacingAngle(playerid,85.0518); 
		SetPlayerCameraPos(playerid, 171.7000,-72.6568,1001.8047);
		SetPlayerCameraLookAt(playerid, 176.6238,-72.6065,1001.8047);
	}  
	else if (BusinessInfo[id][bType] == BUSINESS_TYPE_PROLAPS) {
		SetPlayerPosAC(playerid, 199.0974, -127.3947, 1003.5152, playerid, 3); 
		SetPlayerFacingAngle(playerid, 176.2323);
		SetPlayerCameraPos(playerid, 199.2118,-131.6095,1003.5152);
		SetPlayerCameraLookAt(playerid, 199.0974,-127.3947,1003.5152);  
	}
	return pTemp[playerid][tAccesoryBuyMenuShowed] = true;
}
