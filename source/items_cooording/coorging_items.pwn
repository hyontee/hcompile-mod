stock CreateMarketPlace() {
	for(new S_IDX ; S_IDX < MAX_STALL_MARKET; S_IDX ++)
	{
	    for(new b; b < MAX_STALL_SLOTS; b ++)
	    {
			StallMarketInfo[S_IDX][sID] = -1;
			StallMarketInfo[S_IDX][sSlot][b] = -1;
			StallMarketInfo[S_IDX][sSlotCost][b] = -1;
			StallMarketInfo[S_IDX][sSlotCount][b] = -1;
		}
	    StallMarketInfo[S_IDX][sText] = CreateDynamic3DTextLabel(
			" ", -1, 
			ObjectCoordMarketPos[S_IDX][0], ObjectCoordMarketPos[S_IDX][1], ObjectCoordMarketPos[S_IDX][2], 
			5.0,INVALID_PLAYER_ID,INVALID_PLAYER_ID,1,0,-1,-1, 8.0
		);
	    StallMarketInfo[S_IDX][sAreaZone] = CreateDynamicSphere(
            ObjectCoordMarketPos[S_IDX][0], ObjectCoordMarketPos[S_IDX][1], ObjectCoordMarketPos[S_IDX][2], 
            4.5, 0, 0
        );
        SetDynamicAreaType(StallMarketInfo[S_IDX][sAreaZone], AREA_TYPE_STALL_MARKET, S_IDX);  
		CreateStallMarket(S_IDX, ObjectCoordMarketPos[S_IDX][0], ObjectCoordMarketPos[S_IDX][1], ObjectCoordMarketPos[S_IDX][2], ObjectCoordMarketPos[S_IDX][3]);
		UpdateMarketPlace(S_IDX);
	} 
}
stock UpdateMarketList(idx)
{
	for(new i; i < MAX_STALL_SLOTS; i ++)
	{
		if (StallMarketInfo[idx][sSlot][i] != -1 && StallMarketInfo[idx][sSlotCount][i] <= 0)
		{
			StallMarketInfo[idx][sSlot][i] = -1;
			UpdateMarketPlace(idx);
		}
	} 
}
stock UpdateMarketPlace(place_id)
{ 
	t_string[0] = EOS;
	if (StallMarketInfo[place_id][sID] == -1) {

        format(t_string, sizeof t_string, 
			""colserver"Киоск №: %d\n\
			"colwhi"Стоимость аренды: "collime"$%d", 
			place_id, COST_STALL
		);
		UpdateDynamic3DTextLabelText(StallMarketInfo[place_id][sText],-1, t_string), t_string[0] = EOS;
	}
	else
	{ 
	    format(t_string, sizeof t_string, 
			""colserver"Киоск №: %d\n\
			"colwhi"Арендатор киоска: "collime"%s\n\
			"colwhi"Товары на продаже:\n", 
			place_id, pInfo[ StallMarketInfo[place_id][sID] ][pName]
		);
		for(new i, str_[128]; i < MAX_STALL_SLOTS; i ++)
		{
		    if (StallMarketInfo[place_id][sSlot][i] != -1)
		    {
				format(str_, sizeof str_, "- %s\n", inventory_items[ StallMarketInfo[place_id][sSlot][i] ][ITEM_NAME]);
				strcat(t_string, str_);
		    }
		}  
		UpdateDynamic3DTextLabelText(StallMarketInfo[place_id][sText],-1, t_string), t_string[0] = EOS;
	}
	
	return true;
}
stock ClearMarketRent(playerid, idx)
{ 
	if (idx != -1)
	{
	    StallMarketInfo[idx][sID] = -1;
	    for(new i; i < MAX_STALL_SLOTS; i ++)
	    {
	        if (StallMarketInfo[idx][sSlot][i] != -1) {
				GivePlayerItem(playerid, StallMarketInfo[idx][sSlot][i], StallMarketInfo[idx][sSlotCount][i]); 
			}
	        StallMarketInfo[idx][sSlot][i] = -1;
	        StallMarketInfo[idx][sSlotCost][i] = -1;
	        StallMarketInfo[idx][sSlotCount][i] = -1;
	    }
		new	
			string_[128];
		format(string_, sizeof string_, "Киоск: №%d\nПродавец: Отсутствует", idx);
		SetDynamicObjectMaterialText(StallMarketInfo[idx][sObjectID][2], 0, string_, 120, "Arial", 34, 1, 0xFFFFFFFF, 0x00000000, 1); 
	    UpdateMarketPlace(idx);
	}
	SendClientMessage(playerid, -1, !""colwarn"[Внимание] "colwhi"Вы далеко отошли от киоска, Ваш киоск был сдан в аренду!");
	pTemp[playerid][tRentStallID] = -1; 
}
stock ShowMarketList(playerid, idx)
{
	t_string[0] = EOS; 
	strcat(t_string, ""colserver"[№] Название\t"colserver"Цена\t"colserver"Количество\n");
	for(new i, str_[128]; i < MAX_STALL_SLOTS; i ++)
	{
		if (StallMarketInfo[idx][sSlot][i] != -1)
		{
			new 
				typeItems = inventory_items[ StallMarketInfo[idx][sSlot][i] ][accesoryType];
			format(str_, sizeof str_, ""colwhi"[%d] %s({%s}[%s]"colwhi")\t"collime"$%d\t"colwarn"%d\n", 
				i,  
				inventory_items[ StallMarketInfo[idx][sSlot][i] ][ITEM_NAME],
				colorItems[typeItems - 1], 
				nameItems[typeItems - 1],
				StallMarketInfo[idx][sSlotCost][i],
				StallMarketInfo[idx][sSlotCount][i]
				
			); 
		}
		else format(str_, sizeof str_, "- Пустая полка\n"); 
		strcat(t_string, str_);
	}
	if (idx == pTemp[playerid][tRentStallID]) {
		strcat(t_string, ""colmaline"- Освободить столик");
	}
	new 
		title_[64];
	format(title_, sizeof title_, ""colserver"Киоск: "colwhi"№%d", idx);
	ShowPlayerDialog(playerid, D_INV_ADD_STALL_ITEMS, DIALOG_STYLE_TABLIST_HEADERS, title_, t_string, "Выбрать", "Закрыть"), t_string[0] = EOS;  
}
		
stock ShowMarketArenda(playerid, idx)
{
	if (StallMarketInfo[idx][sID] != -1) return SendClientMessage(playerid, COLOR_GREY, !"Данный киоск уже кто-то аредовал!");
	if (kLibGetPlayerMoney(playerid) < COST_STALL) return SendClientMessage(playerid, COLOR_WHITE, !"У Вас недостаточно денег!"); 
	if (pTemp[playerid][tRentStallID] != -1) return SendClientMessage(playerid, COLOR_GREY, !"У Вас уже есть в аредне один из киосков!");
	kLibGivePlayerMoney(playerid, -COST_STALL, "аренда киоска"); 
	pTemp[playerid][tRentStallID] = idx; 
	StallMarketInfo[idx][sID] = playerid;
	new	
		string_[128];
	format(string_, sizeof string_, "Киоск: №%d\nПродавец: %s", idx, pInfo[playerid][pName]);
	SetDynamicObjectMaterialText(StallMarketInfo[idx][sObjectID][2], 0, string_, 120, "Arial", 34, 1, 0xFFFFFFFF, 0x00000000, 1); 
	UpdateMarketPlace(idx);
	SendMes(playerid, COLOR_WHITE, "Вы успешно арендовали "colmaline"Киоск: №: %d", idx); 
	SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Если вы покинете рынок, Ваш киоск будет обнулен!");
	return true;
}
stock items_OnPlayerKeyStateChange(playerid, newkeys, oldkeys) {
	new bool:isReturn = false;
	if ((oldkeys & newkeys))
		return isReturn;
	switch (newkeys) {
		case KEY_WALK: {
			if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { 
				for(new i; i != MAX_OBJECTS_DROP; i ++) {
					if (DropObjectInfo[i][objDrop][0] == 0) continue;
					if (IsPlayerInRangeOfPoint(playerid, 1.0, DropObjectInfo[i][objPos][0], DropObjectInfo[i][objPos][1], DropObjectInfo[i][objPos][2])) {
						if (!FreeSlotPlayerItem(playerid)) return 1; 
						ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 0, 0, 0, 0, 0,1);
						DestroyDynamicObject(DropObjectInfo[i][objObject]);
						GivePlayerItem(playerid, DropObjectInfo[i][objDrop][0], DropObjectInfo[i][objDrop][1]);
						DestroyDynamic3DTextLabel(DropObjectInfo[i][objText]);
						DropObjectInfo[i][objDrop][0] = DropObjectInfo[i][objDrop][1] = 0;
						DropObjectInfo[i][objPos][0] = DropObjectInfo[i][objPos][1] = DropObjectInfo[i][objPos][2] = 0.0;
						break;
					}
				}

			/*	for(new i = 0; i < MAX_BOX_COUNT; i++) {
					if (!ChristmasBoxInfo[i][xSpawn]) continue;
					if (IsPlayerInRangeOfPoint(playerid, 2.0, ChristmasBoxInfo[i][xCooord][0], ChristmasBoxInfo[i][xCooord][1], ChristmasBoxInfo[i][xCooord][2])) {
						if (ChristmasInfo[playerid][cBlockGift] > gettime()) {
							SendClientMessage(playerid, COLOR_GREY, !"У Вас заблокирован сбор подарков / обмен / продажа!");
							return 1;
						}
						if(GetPVarInt(playerid, "AntiFloodGift") > gettime()) {
							ChristmasInfo[playerid][cBlockGift] = (gettime()+86400);
							SavePlayerCristmasInteger(playerid, "cBlockGift", ChristmasInfo[playerid][cBlockGift]);
							OnPlayerWarning(playerid,"Ловец подарков через скрипт");
							SendClientMessage(playerid, COLOR_GREY, !"Сбор подарков заблокирован на 24 часа!");
							return true;
						}
						if (GetPlayerAdminSearch(playerid) != 0 && GetPlayerAdminSearch(playerid) < 5) return SendClientMessage(playerid, COLOR_GREY, !"На вопросы отвечайте, а не подарки собирайте.");
						DestroyDynamicObject(ChristmasBoxObject[ChristmasBoxInfo[i][xIndexID]]); 
						ChristmasBoxObject[ChristmasBoxInfo[i][xIndexID]] = INVALID_DYNAMIC_OBJECT_ID;
						ChristmasBoxInfo[i][xGetTime] = gettime()+(60 + random(60));
						ReSpawnBox(ChristmasBoxInfo[i][xIndexID], i);
						ChristmasBoxInfo[i][xIndexID] = -1;
						ChristmasInfo[playerid][cGift] ++;
						SavePlayerCristmasInteger(playerid, "cGift", ChristmasInfo[playerid][cGift]);
						SendClientMessage(playerid, COLOR_RED, "[Санта] "colwhi"Йо-хо-хо! Ты нашел мой подарок! Мои подарки можно обменять в лавки возле Мэрии!");
						new 
							string_[128];
						format(string_, sizeof string_, "[Санта] "colwhi"На данный момент у Вас "colyellow"%d %s", 
							ChristmasInfo[playerid][cGift], Declension_ReturnWord(ChristmasInfo[playerid][cGift], "подарок", "подарка", "подарков")
						);
						SendClientMessage(playerid, COLOR_RED, string_); 
						ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 0, 0, 0, 0, 0,1);
						SetPVarInt(playerid, "AntiFloodGift", gettime() + RandomFIX(5, 10));
						break;
					}
				}*/
				/*for(new idx = 0; idx < MAX_BOX_SPAWN_IDX; idx++) {

				}*/
				if (pTemp[playerid][tSelectStallID] != -1) {
					new 
						S_IDX = pTemp[playerid][tSelectStallID]; 
					if (IsPlayerInRangeOfPoint(playerid, 2.5, ObjectCoordMarketPos[S_IDX][0], ObjectCoordMarketPos[S_IDX][1], ObjectCoordMarketPos[S_IDX][2]) 
						&& GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
					{   
						if (StallMarketInfo[S_IDX][sID] != -1) {  
							ShowMarketList(playerid, S_IDX); 
						} else {
							format(t_string, sizeof t_string, ""colwhi"Вы действительно желаете арендовать данный киоск за "collime"$%d "colwhi"?", COST_STALL);
							ShowPlayerDialog(playerid, D_INV_RENT_STALL, DIALOG_STYLE_MSGBOX, ""colserver"Аренда: "colwhi"Киоска", t_string, "Да", "Нет"), t_string[0] = EOS;
						} 
						isReturn = true;
					}  
				}
				if (IsPlayerInRangeOfPoint(playerid, 5.0, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2])
					&& GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0) {
					if (pInfo[playerid][gStars] >= 15) {
						SendClientMessage(playerid, COLOR_GREY, !"Вы нашли максимально кол-во звезд!");
						return true;
					}
					pInfo[playerid][gStars]++;
					OnPlayerAchievProgress(playerid, 1);
					ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 0, 0, 0, 0, 0,1);
					SavePlayerInteger(playerid, "gStars", pInfo[playerid][gStars]);
					r_ObjStar = random(59);
					DestroyDynamicObject(id_dObj[0]);
					DestroyDynamicObject(id_dObj[1]);
					id_dObj[0] = CreateDynamicObject(1247, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2], HNYIOne[r_ObjStar][3], 0.00000, 0.00000);
					id_dObj[1] = CreateDynamicObject(18728, HNYIOne[r_ObjStar][0], HNYIOne[r_ObjStar][1], HNYIOne[r_ObjStar][2], 0.0, 0.00000, 0.00000); 
					new 
						string_[128];
					format(string_, sizeof string_, "[Подсказка] "colwhi"Вы нашли звезду! На данный момент у Вас "colyellow"%d %s", pInfo[playerid][gStars], Declension_ReturnWord(pInfo[playerid][gStars], "звезда", "звезды", "звезд"));
					SendClientMessage(playerid, COLOR_YELLOW, string_);
					isReturn = true;
				}
				/*if () {

				}*/

					/*pTemp[playerid][tSelectAreaStall] = true;
					pTemp[playerid][tSelectStallID] = area_extra_id;*/


			}
			if (isReturn) return true; 
		}
	}
	return isReturn;
}
stock GetCristmasBoxID() {
	new 
		ObjectBoxID[] = {19054, 19055, 19056, 19057, 19058},
		randBox = random( sizeof(ObjectBoxID) );
	for(new i = 0; i < MAX_BOX_COUNT; i++) { 
		if (ChristmasBoxInfo[i][xSpawn]) continue;
		for(new idx = 0; idx < MAX_BOX_SPAWN_IDX; idx++) {
			if (ChristmasBoxInfo[i][xSpawn]) continue;
			if (ChristmasBoxObject[idx] != INVALID_DYNAMIC_OBJECT_ID) continue;
			ChristmasBoxInfo[i][xSpawn] = true;
			ChristmasBoxInfo[i][xIndexID] = idx;
			ChristmasBoxObject[idx] = CreateDynamicObject(ObjectBoxID[randBox], 
				ChristmasBoxInfo[i][xCooord][0], ChristmasBoxInfo[i][xCooord][1], ChristmasBoxInfo[i][xCooord][2], 
				ChristmasBoxInfo[i][xCooord][3], ChristmasBoxInfo[i][xCooord][4], ChristmasBoxInfo[i][xCooord][5]
			); 
			//printf("i = %d, idx = %d",i ,idx);
		}
	}
} 
stock ReSpawnBox(index, old_idx) {
	new 
		ObjectBoxID[] = {19054, 19055, 19056, 19057, 19058},
		randBox = random( sizeof(ObjectBoxID) ),
		bool: IsNull = false;
	for(new i = 0; i < MAX_BOX_COUNT; i++) { 
		if (ChristmasBoxInfo[i][xGetTime] > gettime()) continue; 
		if (ChristmasBoxInfo[i][xSpawn]) continue; 
		if (ChristmasBoxObject[index] != INVALID_DYNAMIC_OBJECT_ID) continue;
		ChristmasBoxInfo[i][xSpawn] = true;
		ChristmasBoxInfo[i][xIndexID] = index;
		ChristmasBoxObject[index] = CreateDynamicObject(ObjectBoxID[randBox], 
			ChristmasBoxInfo[i][xCooord][0], ChristmasBoxInfo[i][xCooord][1], ChristmasBoxInfo[i][xCooord][2], 
			ChristmasBoxInfo[i][xCooord][3], ChristmasBoxInfo[i][xCooord][4], ChristmasBoxInfo[i][xCooord][5]
		); 
		IsNull = true;
		printf("[debug] re spawn i = %d, idx = %d, old_idx = %d",i ,index, old_idx); 
	}
	ChristmasBoxInfo[old_idx][xSpawn] = false;
	if (!IsNull && ChristmasAllSpawn == false) {
		ChristmasAllSpawn = true;
		SetTimerEx("GoChristmasAllSpawn", 60_000, false, ""); 
	}
}
publics: GoChristmasAllSpawn() {
	for(new i = 0; i < MAX_BOX_COUNT; i++) { 
		if (!ChristmasBoxInfo[i][xSpawn]) continue;
		ChristmasBoxInfo[i][xGetTime] = 0;
	}
	GetCristmasBoxID();
	ChristmasAllSpawn = false;
	SendClientMessageToAll(COLOR_RED, !"[Санта] "colwhi"Йо-хо-хо, я привез подарки! Успейти все найти!");
	SendClientMessageToAll(COLOR_RED, !"[Санта] "colwhi"Моя Лавка находиться не далеко от Мэрии!");
	return 1;
}

stock SavePlayerCristmasInteger(playerid, const field[], var) {
	new query_[128];
	format(query_, sizeof query_, "UPDATE `s_christmas` SET `%s` = '%d' WHERE `cID` = '%d' LIMIT 1", field, var, pInfo[playerid][pID]);
	mysql_tquery(dbHandle, query_, "", ""); 
	return 1;
} 
publics: LoadPlayerCristmas(playerid) {
	new
		rows;
	cache_get_row_count(rows);
	if (!rows) {
		new 
			query_[128];
		format(query_, sizeof query_, "INSERT INTO s_christmas (`cID`, `cGift`) VALUES ('%d', '0')", pInfo[playerid][pID]);
		mysql_tquery(dbHandle, query_);  
	}
	else { 
		cache_get_value_name_int(0, "cGift", ChristmasInfo[playerid][cGift]);
		cache_get_value_name_int(0, "cPoll", ChristmasInfo[playerid][cPoll]);
		cache_get_value_name_int(0, "cBlockGift", ChristmasInfo[playerid][cBlockGift]);
		cache_get_value_name_int(0, "aCirtificationHome", ChristmasInfo[playerid][aCirtificationHome]);
	}
	return 1;
}
CMD:cleardrop(playerid) {
	if (pInfo[playerid][pAdmin] < 3 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
	new count = 0;
	for(new i; i != MAX_OBJECTS_DROP; i ++) 
	{
		if (DropObjectInfo[i][objDrop][0] == 0) continue;  
		DestroyDynamicObject(DropObjectInfo[i][objObject]); 
		DestroyDynamic3DTextLabel(DropObjectInfo[i][objText]);
		DropObjectInfo[i][objDrop][0] = DropObjectInfo[i][objDrop][1] = 0;
		DropObjectInfo[i][objPos][0] = DropObjectInfo[i][objPos][1] = DropObjectInfo[i][objPos][2] = 0.0;
		count++;
		break; 
	}
	SendMes(playerid, COLOR_GREY, "Вы удалили все дроп объекты: %d", count);
	return 1;
}//ApplyAnimation(playerid, "WUZI", "Wuzi_grnd_chk",4.0, 0, 1, 1, 0, 0, 1);
