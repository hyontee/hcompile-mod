CMD:getitem(playerid, params[]) {
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /getitem [playerid] [item]");	
	if (params[1] < 1 || params[1] > 148) return SendClientMessage(playerid, COLOR_GREY, !"Ид предмета от 1 до 145");
	GivePlayerItem(params[0], params[1], 1);
	return 1;
}


alias:accesory("inv", "inventory"); 
CMD:accesory(playerid)
{ 
	//if (pInfo[playerid][pAdmin] < 3 || !pTemp[playerid][PlayerADostup]) return SendClientMessage(playerid, COLOR_GREY, !""colwarn"[Ошибка]"colwhi" Вам недоступна данная возможность");
	new idx = 0;
	t_string[0] = EOS;
	strcat(t_string, ""colserver"[№] Название(кол-во)\t"colserver"[Тип]\n");
	for(new i = 0, string_[128]; i < MAX_ITEMS_SLOTS; i++)
	{   
		if (!pInfo[playerid][PlayerItems][i]) continue; 
		new 
			typeItems = inventory_items[ pInfo[playerid][PlayerItems][i] ][accesoryType];
		format(string_, sizeof string_, ""colwhi"[%d] %s(%d шт.)\t{%s}[%s]\n", idx, 
			inventory_items[ pInfo[playerid][PlayerItems][i] ][ITEM_NAME], 
			pInfo[playerid][PlayerItemsCount][i], 
			colorItems[typeItems - 1], 
			nameItems[typeItems - 1]
		);
		strcat(t_string, string_); 
		playerListItem[playerid][idx] = pInfo[playerid][PlayerItems][i]; 
		playerSelectSlot[playerid][idx] = i;
		idx++;
	}
	if (idx == 0) {
		SendClientMessage(playerid, COLOR_GREY, !"Ваш инвентарь пуст!");
		playerListItem[playerid][idx] = -1;
		playerSelectSlot[playerid][idx] = -1;
		return 1;
	}
	else ShowPlayerDialog(playerid, D_INV, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Инвентарь: "colwhi"Аксессуары", t_string, "Выбрать", "Отмена"); 
	return true;
}
		
stock FreeSlotPlayerItem(playerid) {
	new 
		bool: itemkol = false;
	for(new i; i != MAX_ITEMS_SLOTS; i++) {
		if (pInfo[playerid][PlayerItems][i] == 0) {
			itemkol = true; 
			break;
		}
	}
	if (itemkol == false) {
		SendClientMessage(playerid, COLOR_GREY, "У Вас недостаточно места для этого предмета!");
		return false;
	}
	return true;
} 

stock GivePlayerItem(playerid, item, count) {
	new 
		bool: itemkol = false;
	new string_[128];
	for(new i; i != MAX_ITEMS_SLOTS; i++) {
		if (pInfo[playerid][PlayerItems][i] == 0) {
			itemkol = true;
			pInfo[playerid][PlayerItems][i] = item;
			pInfo[playerid][PlayerItemsCount][i] = count;  
			//SaveInventory(playerid);
			SavePlayerInventory(playerid);
			format(string_, sizeof string_, "Вам в инвентарь был добавлен аксессуар `%s`", inventory_items[item][ITEM_NAME]);
			SendClientMessage(playerid, COLOR_GREY, string_);
			break;
		}
	}
	if (itemkol == false) {
		SendClientMessage(playerid, COLOR_GREY, "У Вас недостаточно места для этого предмета!");
		return false;
	}
	return true;
} 
