					ShowPlayerDialog(playerid, D_CHANGE_STAR_2, DIALOG_STYLE_TABLIST, ""colserver"Обмен: "colwhi"Подарков", t_string, "Информация", "Закрыть");
				}
				case 3: {
					if (ChristmasInfo[playerid][cBlockGift] > gettime()) {
						SendClientMessage(playerid, COLOR_GREY, !"У Вас заблокирован сбор подарков / обмен / продажа!");
						return 1;
					}
					if (ChristmasInfo[playerid][cPoll] == 0 && pInfo[playerid][pLevel] > 5) {
