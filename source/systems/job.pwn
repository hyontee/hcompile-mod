stock Start_StopBus(playerid,route,i)
{
    GameTextForPlayer(playerid, !"~r~Stop", 4000, 1);
	PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
	//const size_route = 26;
	new	
		string_[128];
	static const name_bus_route[6][32] = {
	    "Городской-Лос Сантос",
		"Городской Сан-Фиееро",
		"Городской Лас-Вентурас",
		"Лас-Вентурас — Лос-Сантос",
		"Лос-Сантос — Сан-Фиерро",
		"Сан-Фиерро — Лас-Вентурас"
	};
	/*new str_route_start_now[50+size_route char] = !"Автобус по маршруту ";
	strcat(str_route_start_now,name_bus_route[route]);
	strcat(str_route_start_now,!" отправляется через 10 секунд");*/
	//new string_[128];
	format(string_, sizeof string_, "Автобус по маршруту %s отправляется через 10 секунд", name_bus_route[route]);
    SendBeside(playerid, 0x669999FF, string_, 35.0);// 0x669999FF 0x89B88BFF
    SetTimerEx("CheckBusRun", 9000, false,"ii", playerid, i);
	return 1;
}

publics:CheckBusRun(const playerid, i)
{
	if (GetPlayerBus{playerid} == 1 && pTemp[playerid][pRentCar] == GetPlayerVehicleID(playerid))
	{
		SetPlayerRaceCheckpoint(playerid, RouteBusPosition[i][BUSSTATION], RouteBusPosition[i][BUS_COORD][0],
		RouteBusPosition[i][BUS_COORD][1],RouteBusPosition[i][BUS_COORD][2],RouteBusPosition[i+1][BUS_COORD][0],
		RouteBusPosition[i+1][BUS_COORD][1],RouteBusPosition[i+1][BUS_COORD][2],6.0);
		GameTextForPlayer(playerid, !"~b~GO", 1000, 6);
	}
	return 1;
}

stock  job_OnPlayerEnterRaceCheckpoint(playerid)
{
	if (GetPlayerBus{playerid} == 1)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if (vehicleid == pTemp[playerid][pRentCar] && VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB)
		{
			DisablePlayerRaceCheckpoint(playerid);
			new route = VehicleInfo[ vehicleid - 1 ][vSubFraction] - 1;
			pPressed[playerid] ++ ;
			new i = pPressed[playerid] ;
			if (pPressed[playerid] == MaxPlayerRoute[route][1])
			{
				i = pPressed[playerid] = MaxPlayerRoute[route][0];
			}
			else if (RouteBusPosition[i-1][BUSSTATION] == 1)
			{
				Start_StopBus(playerid,route,i);
				return 1;
			}
			
			SetPlayerRaceCheckpoint(playerid, RouteBusPosition[i][BUSSTATION],RouteBusPosition[i][BUS_COORD][0],
			RouteBusPosition[i][BUS_COORD][1],RouteBusPosition[i][BUS_COORD][2],RouteBusPosition[i+1][BUS_COORD][0],
			RouteBusPosition[i+1][BUS_COORD][1],RouteBusPosition[i+1][BUS_COORD][2],6.0);

			static const money_route[6] = {
				84, // BUS_TYPE_LS  17
				90, // BUS_TYPE_SF 20
				97, //  BUS_TYPE_LV 11
				94, // BUS_TYPE_LV_LS 7,5
				94, // BUS_TYPE_LS_SF 6
				85 //BUS_TYPE_SF_LV 7,5
			};

			pInfo[playerid][pPayCheck] += money_route[route];
			OnPlayerAchievProgress(playerid, 6, money_route[route]);
			OnPlayerQuestProgress(playerid, QUEST_GUEST, QUEST_TASK_BUS,money_route[route]);
			return 1;
		}
	}
	return 0;
}

stock job_SetPlayerDataToDefault(playerid)
{
	GetPlayerTaxi{playerid} = 0;
	GetPlayerBus{playerid} = 0;
	return 1;
}


stock job_OnPlayerExitVehicle(playerid, vehicleid)
{
	if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB)
	{
		if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_BUS && GetPlayerBus{playerid} == 1)
		{
			DisablePlayerRaceCheckpoint(playerid);
			ShowPlayerDialog(playerid,D_JOB_START_ROUTE,DIALOG_STYLE_MSGBOX, 
			!""colserver"Водитель автобуса", !""colwhi"Вы хотите завершить рабочий день?", !"Да", !"Нет");
			return 1;
		}
		
		else if (VehicleInfo[ vehicleid - 1 ][vFraction] ==  PLAYER_JOB_TAXI)
		{
			if (pTemp[playerid][pTaxiDriver] != INVALID_PLAYER_ID)
			{
				new id_taxi = pTemp[playerid][pTaxiDriver];
				if (GetPlayerTaxi{id_taxi} == 1 && vehicleid == pTemp[id_taxi][pRentCar])
				{
					OnPlayerAchievProgress(id_taxi, 2);
					OnPlayerAchievProgress(id_taxi, 4);
					SendClientMessage(id_taxi, COLOR_BLUE, !"Пассажир вышел из вашего Такси. Деньги будут зачислены во время зарплаты");
					ShowPlayerDialog(playerid, D_JOB_TAXI_CLIENT, DIALOG_STYLE_MSGBOX, !"Такси", !"Как вас обслужили?", !"Хорошо", !"Плохо");
				}
				else pTemp[playerid][pTaxiDriver] = INVALID_PLAYER_ID;
				return 1;
			}
		}
	}
	return 0;
}

stock job_OnPlayerStateChange(playerid, newstate, oldstate, vehicleid)
{
	if (newstate == PLAYER_STATE_DRIVER)
	{
		if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB)
		{
			if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_BUS)
			{
				if (pTemp[playerid][pRentCar] == vehicleid)
				{
				    CheckBusRun(playerid, pPressed[playerid]);
				}
				else {
					ShowPlayerDialog(playerid,D_JOB_RENT_CAR,DIALOG_STYLE_MSGBOX, 
					!""colserver"Аренда транспорта: "colwhi"Автобус",
					!""colwhi"Стоимость аренды этого автомобиля "collime"$500"colwhi"\n\nВы хотите взять автомобиль на прокат?", !"Да", !"Нет");
				}
				return 1;
			}
		}
	}
	if (newstate == PLAYER_STATE_PASSENGER)
	{
		if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB && VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_TAXI)
		{
			foreach(new i: JobTaxi)
			{
				if (vehicleid == pTemp[i][pRentCar] && IsPlayerInVehicle(i, vehicleid) && GetPlayerState(i) == 2)
				{
					pTemp[playerid][pTaxiDriver] = i;
					new tmp_str[94];
					format(tmp_str,sizeof(tmp_str),"Пассажир %s сел в Ваше Такси. Довезите его и государство заплатит Вам",pInfo[playerid][pName]);
					SendClientMessage(i, COLOR_BLUE, tmp_str);
					if (pInfo[playerid][pLevel] == 1 && pInfo[playerid][pExp] < 4)
					{
						callcmd::taxigps(i);
					}
					break;
				}
			}
			return 1;
		}
	}
	/*
	if (oldstate == PLAYER_STATE_PASSENGER)
	{
		if (pTemp[playerid][pTaxiDriver] != INVALID_PLAYER_ID)
		{
			new id_taxi = pTemp[playerid][pTaxiDriver];
			if (GetPlayerTaxi{id_taxi} == 1 && pTemp[playerid][PlayerVehicle] == pTemp[id_taxi][pRentCar])
			{
				SendClientMessage(id_taxi, COLOR_BLUE, !"Пассажир вышел из вашего Такси. Деньги будут зачислены во время зарплаты");
				ShowPlayerDialog(playerid, D_JOB_TAXI_CLIENT, DIALOG_STYLE_MSGBOX, !"Такси", !"Как вас обслужили?", !"Хорошо", !"Плохо");
			}
			else pTemp[playerid][pTaxiDriver] = INVALID_PLAYER_ID;
		}
		// RETURN 1 - НЕ СТАВИТЬ pTemp[playerid][PlayerVehicle] = INVALID_VEHICLE_ID;
	}*/
	
	if (oldstate == PLAYER_STATE_DRIVER)
	{
	}
	return 0;
}

stock SendPlayerLaborOffice(const playerid,const vehicleid, const type)
{
	static const jobs_type[9][20] = {
		"Водитель автобуса",
		"Таксит",
		"Продавец Хот-Догов",
		"Развозчик продуктов",
		"Механик",
		"Инкассатор",
		"Прораб",
		"Тренер",
		"Дальнобойщик"
	};
	new str_tpm[70],
		fine,
		Float:hp_car;
	if (pTemp[playerid][pRentCar] == vehicleid )
	{
		GetVehicleHealth(vehicleid, hp_car);
		if (hp_car < 800.0 && hp_car > 299.0){

			hp_car = 1000.0-hp_car;
			fine = floatround((hp_car/100)*200);
		}
	}
	pTemp[playerid][pRentCar] = INVALID_VEHICLE_ID;

	format(str_tpm,sizeof(str_tpm),"--------===[ Биржа труда: %s ]===-------",jobs_type[type]);
	SendClientMessage(playerid,0xffc61aAA,str_tpm);
	format(str_tpm,sizeof(str_tpm),"В депозите: $%d",pInfo[playerid][pPayCheck]);
	SendClientMessage(playerid,COLOR_WHITE,str_tpm);
	format(str_tpm,sizeof(str_tpm),"Штраф за порчу имущества: $%d",fine);
	SendClientMessage(playerid,COLOR_WHITE,str_tpm);
	pInfo[playerid][pPayCheck] -= fine;
	SendClientMessage(playerid,0xffc61aAA,!"========================================");
	if (type == 1) {
		DisablePlayerRaceCheckpoint(playerid);
	}
	SetVehicleToRespawn(vehicleid);
	return 1;
}