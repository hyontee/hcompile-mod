#if defined _job_inc
	#endinput
#endif
#define _job_inc


/*const max_online_taxi = 70+1;
const max_online_bus = 70+1;*/
new Iterator:JobTaxi<MAX_PLAYERS>;
new Iterator:JobBus<MAX_PLAYERS>;


new GetPlayerTaxi[MAX_PLAYERS char];
new GetPlayerBus[MAX_PLAYERS char];

stock InvitePlayerTaxi(playerid)
{
	if (GetPlayerTaxi{playerid} == 1) LeavePlayerTaxi(playerid);
	GetPlayerTaxi{playerid} = 1;
	Iter_Add(JobTaxi, playerid);
	return 1;
}

stock LeavePlayerTaxi(playerid)
{
	if (GetPlayerTaxi{playerid} == 1){
		Iter_Remove(JobTaxi, playerid);
		GetPlayerTaxi{playerid} = 0;
		SendPlayerLaborOffice(playerid,pTemp[playerid][pRentCar],1);
	}
    return 1;
}


stock InvitePlayerBus(playerid)
{
	if (GetPlayerBus{playerid} == 1) LeavePlayerBus(playerid);
	GetPlayerBus{playerid} = 1;
	Iter_Add(JobBus, playerid);
	return 1;
}

stock LeavePlayerBus(playerid)
{
	if (GetPlayerBus{playerid} == 1){
		Iter_Remove(JobBus, playerid);
		GetPlayerBus{playerid} = 0;
		SendPlayerLaborOffice(playerid,pTemp[playerid][pRentCar],0);
	}
    return 1;
}


