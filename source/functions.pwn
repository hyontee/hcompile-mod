	else if (pInfo[playerid][pLevel] < 10) SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Следующую награду вы получите при достижении 10 уровня.");
	else if (pInfo[playerid][pLevel] < 20) SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Следующую награду вы получите при достижении 20 уровня.");
	format(query_, sizeof query_, 
