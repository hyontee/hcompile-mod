publics: player_register(playerid) {
	PlayerRegister(playerid);
	return 1;
}
publics: PlayerRegister(playerid) {
	pInfo[playerid][pID] = cache_insert_id();
	pTemp[playerid][tPlayerCurrentID] = cache_insert_id();
	new
		query[100];
	SetPVarInt(playerid, "First_Enter", 1);
	format(query,sizeof query,"SELECT * FROM `s_users` WHERE `pID` = '%d' LIMIT 1",pInfo[playerid][pID]);
	mysql_tquery(dbHandle, query, "OnPlayerLoginAuth", "d", playerid);
	pTemp[playerid][tSelectSkin] = false;
	SetPlayerCheckpoint(playerid, 1243.0922,-1701.3489,14.8672, 1.0);//ЧП на квест ботиху
	return 1;
}
/* Удалить pText*/
publics: OnPlayerLoginAuth(playerid)
{
    new rows;
	cache_get_row_count(rows);
	if (rows)
	{
	    cache_get_value_name_int(0, "pID", pInfo[playerid][pID]);
		if (pTemp[playerid][tPlayerCurrentID] != pInfo[playerid][pID]) {
			scmKick(playerid, "Вы были кикнуты по подозрению в читерстве (AC - D4)");
			printf("Call OnPlayerLoginAuth [pID != CurrentID] ID: %d | Kick D4", playerid); 
			return 1;
		}
		cache_get_value_name_int(0, "pLeader", pInfo[playerid][pLeader]);
		cache_get_value_name_int(0, "pMember", pInfo[playerid][pMember]);
		cache_get_value_name_int(0, "pRank", pInfo[playerid][pRank]);
		cache_get_value_name_int(0, "pModel", pInfo[playerid][pModel]);
		new kickout[300];
		cache_get_value_name(0, "pChars", kickout, sizeof kickout);
		sscanf(kickout, "p<,>a<d>[6]", pInfo[playerid][pChar]);
		for(new i = 0; i < 6; i++) {   
			if (pInfo[playerid][pChar][i] > 311) {
				pInfo[playerid][pChar][i] = 292;
				SendClientMessage(playerid, COLOR_WHITE, !"Произошла ошибка при загрузке скину, сообщите в тех. раздел");
			} 
		}
		cache_get_value_name_int(0, "playerspawn", pInfo[playerid][PlayerSpawn]);
		cache_get_value_name_int(0, "pLevel", pInfo[playerid][pLevel]);
		cache_get_value_name_int(0, "pHouseID", pInfo[playerid][pHouseID]);
		cache_get_value_name_int(0, "pTransfer", pInfo[playerid][p_Transfer]); 
		new captureStats[14];
		cache_get_value_name(0, "pCaptureStats", captureStats, sizeof (captureStats));
		sscanf(captureStats, "p<|>iif", CaptureInfo[playerid][pKills], CaptureInfo[playerid][pDeaths], CaptureInfo[playerid][pDMG]);
	
	
		
		cache_get_value_name(0, "pFracIntBlock", kickout, sizeof (kickout));
		sscanf(kickout, "p<|>a<i>["#FRACTION_COUNT"]", pInfo[playerid][pFracIntBlock]);
