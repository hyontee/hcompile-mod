stock UpdatePlayerDonate(playerid)
{
	new 
		get_nodonate = 0,
		query_[128];
	format(query_, sizeof query_, "SELECT `u_nodonate` FROM s_users WHERE pID = '%d'", pInfo[playerid][pID]);
	new Cache:tempQuery = mysql_query (dbHandle, query_);
	/*printf("Выполнение запроса \"SELECT `u_nodonate` FROM s_users WHERE pID\" заняло %d м.с / %d мик.с	",
		cache_get_query_exec_time(MILLISECONDS), cache_get_query_exec_time(MICROSECONDS)
	);*/
	cache_get_value_name_int(0, "u_nodonate", get_nodonate);
	if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
	if (get_nodonate == 0) {
		SendClientMessage(playerid, 0xFF6600AA, !"Новых пополнений не найдено.");
		ShowDonateMaxPidaras(playerid); 
		return 1;
	}
	if (get_nodonate >= 1) {
		new
			string_[128];
		if (gBoostServer[sBoost]) {
			format(string_, sizeof string_, "Вы пополнили счет на "collime"%d "DonatePoint".", get_nodonate*gBoostServer[sBoostDonate]);
			SendClientMessage(playerid, COLOR_WHITE, string_);
			pInfo[playerid][pDonate] += get_nodonate*gBoostServer[sBoostDonate];
		}
		else {
			format(string_, sizeof string_, "Вы пополнили счет на "collime"%d "DonatePoint".", get_nodonate);
			SendClientMessage(playerid, COLOR_WHITE, string_);
			pInfo[playerid][pDonate] += get_nodonate;
		}  
		OnPlayerAchievProgress(playerid, 38, get_nodonate);
		pInfo[playerid][pNoDonate] = 0; 
		format(query_, sizeof query_, "`u_donate` = '%i', `u_nodonate` = '%i'", 
			pInfo[playerid][pDonate],pInfo[playerid][pNoDonate]
		);
		SavePlayerStr(playerid, query_); 
		ShowDonateMaxPidaras(playerid);
	} 
	return 1;
}
stock ShowDonateMaxPidaras(playerid)
{
	t_string[0] = EOS;
	new get_donate = 5120; 
	format(t_string, sizeof t_string, ""colserver"[№] Привилегия\t"colserver"Цена\n\
		"colwhi"[0] Игровая валюта\t"collime"1 "DonatePoint" = $%d\n\
		"colwhi"[1] Смена ника\t"collime"50 "DonatePoint"\n\
		"colwhi"[2] Снятие варна\t"collime"250 "DonatePoint"\n\ 
		"colwhi"[3] Анти-Голод\t"collime"150 "DonatePoint"\n\ 
		"colwhi"[4] Дополнительные привилегии\t"collime"от 3 "DonatePoint"\n\
		"colwhi"[5] Уникальные аксессуары\n\
		"colwhi"[6] Стартовые пакеты\t"collime"от 300 "DonatePoint"\n\
		"colwhi"[7] VIP пакеты\t"collime"от 500 "DonatePoint"\n\
		"colwhi"[8] SIM-карты Форматов(44444, 55555)\t"collime"от 1500 "DonatePoint"\n\
		"collime"Обновить баланс", 
		(gBoostServer[sBoost]) ? get_donate*gBoostServer[sBoostCash] : get_donate )
	; 
 	ShowPlayerDialog(playerid, D_DONATE_MENU_0, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Донат: "colwhi"Привилегии", t_string, "Далее", "Отмена");
	return 1;
}

stock v_velo(vehicleid)
{
	switch(GetVehicleModel(vehicleid))
	{
		case 481, 509, 510: return 1;
	}
	return 0;
}

stock ToggleLights(vehicleid)
{
	GetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	SetVehicleParamsEx(vehicleid, engine1, ( lights2 == VEHICLE_PARAMS_UNSET || lights2 == VEHICLE_PARAMS_OFF ) ? VEHICLE_PARAMS_ON : VEHICLE_PARAMS_OFF, alarm2, doors3, bonnet2, boot1, objective1);
	return 1;
}
stock toggle_engine1(playerid, vehicle_id)
{
	//new	Float: veh_health;
	//GetVehicleHealth(vehicle_id, veh_health);
	if (VehicleInfo[ vehicle_id - 1 ][vEngBreaked]) {
		SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Двигатель данного транспорта неисправен!");
		SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Используйте телефон "colserver"\"/call\" "colwhi"чтобы вызвать механика / таксиста");
		return GameTextForPlayer(playerid, !"~r~ENGINE HAS BROKENED", 5000, 3);
	}
	if (VehicleInfo[ vehicle_id - 1 ][vFineSlots] != -1) {
		NewFinePositionSlots[ VehicleInfo[ vehicle_id - 1 ][vFineSlots] ] = false;
		VehicleInfo[ vehicle_id - 1 ][vFineSlots] = -1;
	}
	GetVehicleParamsEx(vehicle_id, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	if (engine1 == VEHICLE_PARAMS_UNSET || engine1 == VEHICLE_PARAMS_OFF)
	{
		if (VehicleInfo[ vehicle_id - 1 ][vFuel] <= 0.1) {
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Используйте телефон "colserver"\"/call\" "colwhi"чтобы вызвать механика / таксиста");
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Используйте "colserver"\"/get fuel\" "colwhi"чтобы купить канистру возле АЗС");
			return SetVehicleParamsEx(vehicle_id, VEHICLE_PARAMS_OFF, lights2, alarm2, doors3, bonnet2, boot1, objective1);
		}
		else SetVehicleParamsEx(vehicle_id, VEHICLE_PARAMS_ON, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	}
	else SetVehicleParamsEx(vehicle_id, VEHICLE_PARAMS_OFF, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	return 1;
}

stock ShowPlayerReferals(playerid, page = 1) {
    format(t_string, sizeof (t_string), "SELECT Name, pLevel FROM s_users WHERE pDrug = '%s' ORDER BY `pLevel` DESC", 
        pInfo[playerid][pName]
    );
    new rows, Cache:tempQuery = mysql_query(dbHandle, t_string);
    cache_get_row_count(rows);
    t_string[0] = EOS;
    
    if (!rows) {
        SendClientMessage(playerid, COLOR_GREY, !"У вас нет действующих рефералов.");
        if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
        return true;
    }
    new max_page = (MAX_DIALOG_LIST_ITEMS + rows) / MAX_DIALOG_LIST_ITEMS, idx = 0;
    if (page < 1) page = 1;
    else if (page > max_page) page = max_page; 

    t_string = ""colserver"Никнейм\t"colserver"Уровень\n"colwhi"";
    for (new i = ((page - 1) * MAX_DIALOG_LIST_ITEMS), tempName[32], tempLevel; i < (page * MAX_DIALOG_LIST_ITEMS); i++) {
        if (i >= rows) continue;
        cache_get_value_name(i, "Name", tempName, sizeof (tempName));
        cache_get_value_name_int(i, "pLevel", tempLevel); 

        format(t_string, sizeof (t_string), "%s[%i] %s\t%d уровень\n", t_string, (page - 1) * MAX_DIALOG_LIST_ITEMS + idx, tempName, tempLevel);
        playerListItem[playerid][idx++] = -1;
    }
    if (page > 1) {
        strcat(t_string, "[<<<] Предыдущая страница\n");
        playerListItem[playerid][idx++] = 2; // (-)
    }
    if (page < max_page) {
        strcat(t_string, "Следующая страница [>>>] \n");
        playerListItem[playerid][idx++] = 1; // (+)
    }
    pTemp[playerid][tSelectPage] = page; 

    new titleSTR[46];
    format(titleSTR, sizeof (titleSTR), ""colserver"Список рефераллов (всего: %d)", rows);
    ShowPlayerDialog(playerid, D_REFERALS, DIALOG_STYLE_TABLIST_HEADERS, titleSTR, t_string, "Выбрать", "Закрыть");

    if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
    t_string[0] = EOS;
    return true;
}
stock FarmStats(playerid, idx)
{
	new str_[128],
		getid_ = GetCheckID(FarmInfo[idx][fOwner]); 
	t_string[0] = EOS;
	format(str_, sizeof str_,""colwhi"  Владелец: %s\n",FarmInfo[idx][fOwner], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);
	format(str_, sizeof str_," Баланс банка: %d\n",FarmInfo[idx][fBank]);
	strcat(t_string, str_);
	format(str_, sizeof str_," Баланс счета 'LandTax': %d\n",FarmInfo[idx][fLandTax]);
	strcat(t_string, str_);
	format(str_, sizeof str_," Цена за работу: %d\n\n",FarmInfo[idx][fZp]);
	strcat(t_string, str_);
	format(str_, sizeof str_," Цена зерна: %d\n",FarmInfo[idx][fGrain_Price]);
	strcat(t_string, str_);
	format(str_, sizeof str_," Зерна закуплено: %d / 10000\n",FarmInfo[idx][fGrain]);
	strcat(t_string, str_);
	format(str_, sizeof str_," Зерна засеяно: %d / 5000\n",FarmInfo[idx][fGrain_Sown]);
	strcat(t_string, str_);
	format(str_, sizeof str_," Продаваемый продукт: %s\n", (FarmInfo[idx][fProds_Selling] == 1)?("Картофель"):("Веселая трава"));
	strcat(t_string, str_);
	format(str_, sizeof str_," Количество на складе: %d / 10000\n",FarmInfo[idx][fProds]);
	strcat(t_string, str_);
	format(str_, sizeof str_," Цена продукта: %d\n\n",FarmInfo[idx][fProds_Price]);
	strcat(t_string, str_);//( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]")
	

	getid_ = GetCheckID(FarmInfo[idx][fDeputy_1]); 
	format(str_, sizeof str_,""colwhi" Заместитель: %s %s\n",FarmInfo[idx][fDeputy_1], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);
	
	getid_ = GetCheckID(FarmInfo[idx][fDeputy_2]); 
	format(str_, sizeof str_,""colwhi" Заместитель: %s %s\n",FarmInfo[idx][fDeputy_2], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);

	getid_ = GetCheckID(FarmInfo[idx][fDeputy_3]); 
	format(str_, sizeof str_,""colwhi" Заместитель: %s %s\n\n",FarmInfo[idx][fDeputy_3], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);
	
	getid_ = GetCheckID(FarmInfo[idx][fFarmer_1]); 
	format(str_, sizeof str_,""colwhi" Фермер: %s %s\n",FarmInfo[idx][fFarmer_1], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);

	getid_ = GetCheckID(FarmInfo[idx][fFarmer_2]); 
	format(str_, sizeof str_,""colwhi" Фермер: %s %s\n",FarmInfo[idx][fFarmer_2], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);

	getid_ = GetCheckID(FarmInfo[idx][fFarmer_3]); 
	format(str_, sizeof str_,""colwhi" Фермер: %s %s\n",FarmInfo[idx][fFarmer_3], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);

	getid_ = GetCheckID(FarmInfo[idx][fFarmer_4]); 
	format(str_, sizeof str_,""colwhi" Фермер: %s %s\n",FarmInfo[idx][fFarmer_4], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);

	getid_ = GetCheckID(FarmInfo[idx][fFarmer_5]); 
	format(str_, sizeof str_,""colwhi" Фермер: %s %s\n",FarmInfo[idx][fFarmer_5], ( getid_ == INVALID_PLAYER_ID ) ? ("[{ff001c}Offline"colwhi"]") : ("[{22ff00}Online"colwhi"]"));
	strcat(t_string, str_);
	return ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "Информация о Ферме", t_string, "Скрыть", "");
}
ShowFarmPanel(playerid)
{
    new message_[] =
	{"[0] Установить цену зерна\n\
	[1] Установить цену продуктов\n\
	[2] Установить цену работы\n\
	[3] Ввести деньги на счёт 'LandTax'\n\
