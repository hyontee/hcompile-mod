stock DialogBootVehicle(playerid, vehicleid)
{
	t_string[0] = EOS;
	new
	    str_[90],
		string_[128],
		count_gun = 0;
	strcat(t_string, ""colserver"[№] Наименование\t"colserver"Кол-во\n");

	format(string_, sizeof string_, ""colwhi"[0] Деньги\t"colserver"%d / 20.000.000 вирт\n", VehicleInfo[ vehicleid - 1 ][vMoney]);
	strcat(t_string, string_);
	format(string_, sizeof string_, ""colwhi"[1] Канистры\t"colserver"%d / 3 шт.\n", VehicleInfo[ vehicleid - 1 ][vFillBag]);
	strcat(t_string, string_);
	format(string_, sizeof string_, ""colwhi"[2] Рем. комплект\t"colserver"%d / 3 шт.\n", VehicleInfo[ vehicleid - 1 ][vRepair]);
	strcat(t_string, string_);
	format(string_, sizeof string_, ""colwhi"[3] Наркотики\t"colserver"%d / 500 ед.\n", VehicleInfo[ vehicleid - 1 ][vDrugs]);
	strcat(t_string, string_);
	format(string_, sizeof string_, ""colwhi"[4] Материалы\t"colserver"%d / 1500 ед\n", VehicleInfo[ vehicleid - 1 ][vMaterials]);
	strcat(t_string, string_);
	for(new t = 0; t < 6; t++) {
    	if (VehicleInfo[ vehicleid - 1 ][vBootGun][t] != 0) {
    		count_gun ++;
    	}
	}
	format(string_, sizeof string_, ""colwhi"[5] Оружие\t"colserver"%d / 6 Занято", count_gun);
	strcat(t_string, string_);

	format(str_, sizeof str_, ""colserver"Багажник: "colwhi"%s(%d)", VehicleNames[ GetVehicleModel(vehicleid) - 400], GetVehicleModel(vehicleid));
	ShowPlayerDialog(playerid, D_VEHICLE_FUNC_0, DIALOG_STYLE_TABLIST_HEADERS, str_, t_string, "Выбрать", "Закрыть");
}
stock ShowBootUsingMenu(playerid, listitem)
{
	new
		str_name[16];
	t_string[0] = EOS;
	switch(listitem)
	{
		case 0: str_name = "Деньги", SetPVarInt(playerid, #SelectBootID, 0);
		case 1: str_name = "Канистры", SetPVarInt(playerid, #SelectBootID, 1);
		case 2: str_name = "Рем. комплект", SetPVarInt(playerid, #SelectBootID, 2);
		case 3: str_name = "Наркотики", SetPVarInt(playerid, #SelectBootID, 3);
		case 4: str_name = "Материалы", SetPVarInt(playerid, #SelectBootID, 4);
	}
	format(t_string, sizeof t_string, "- "colserver"%s"colwhi"\n\
	Для того чтобы взять: \"-\" и количество.\n\
	Для того чтобы положить: \"+\" и количество.", str_name);
	return ShowPlayerDialog(playerid, D_VEHICLE_FUNC_1, DIALOG_STYLE_INPUT, ""colserver"Багажник", t_string, "Ввести", "Отмена");
}
stock ShowBootGunVehicle(playerid)
{
	new
		V_IDX = GetPVarInt(playerid, #PlayerVehicleID),
		gunname[32],
		str_[64];
	t_string[0] = EOS;
	strcat(t_string, ""colserver"[№] Оружие\t"colserver"Количество патронов\n");
	for(new x; x < 6; x ++)
	{
		if (VehicleInfo[V_IDX - 1][vBootGun][x] != 0)
		{
			GetWeaponName(VehicleInfo[V_IDX - 1][vBootGun][x], gunname, 32);
		}
		else gunname = ""collime"Свободный слот"colwhi"";
		format(str_, sizeof str_, ""colwhi"[%d] %s\t%d\n", x + 1, gunname, VehicleInfo[V_IDX - 1][vBootAmmo][x]);
		strcat(t_string, str_);
	}
	return ShowPlayerDialog(playerid, D_VEHICLE_FUNC_2, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Багажник: "colwhi"Оружие", t_string, "Выбрать", "Отмена");
}
