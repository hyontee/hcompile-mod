stock SendVk(const vk_id[], const message[]) {

    format(totalstring, sizeof totalstring, "https://api.vk.com/method/messages.send?domain=%s&message=%s&random_id=%d&access_token=vk1.a.sJICI80gkJeWbVpaR2ubnUZiLFMUUNmcP9f5s5Z7t02SsFRqWVgb-sGFJD7ZP2-KGLmlCqnKiqzMvHhDV-hnEeXZshCyNJM6flm7XYWAUkcKJHHZs-JyTnZRYQQL3fCkseqiLDbBKyRm4axL7TDsK-RlFXbWeOYnFgPuUnoi3m67sFXR7R2XO8hn-dSwVmxM",
        vk_id, message, RandomFIX(99999,10000));
    new index;

    for(new i = 0; totalstring[i] != '\0'; i++)
    {
        switch(totalstring[i])
        {
            case ' ': totalstring[index++] = '+';
            default: totalstring[index++] = totalstring[i];
        }
    }

   /* new RequestsClient:client = RequestsClient(totalstring, RequestHeaders(
