	);
    mysql_tquery(dbHandle, query_, "", ""); 
	return 1;
}
publics: PromoCodeCreate(playerid, code[])
{
    new
		free_slot = -1,
		query_[128];

    if (free_slot != -1)
	{
		SendClientMessage(playerid, COLOR_GREY, !"Указанный промокод уже есть в списке");
		return 0;
	}
    mysql_format(dbHandle, query_, sizeof query_, "INSERT INTO s_promocode (code) VALUES ('%s')", code);
	mysql_tquery(dbHandle, query_, "", "");

	query_[0] = EOS;
	format(query_, sizeof query_, ""colwhi"Промокод {FFFF00}%s"colwhi" успешно создан!\n", code);
    ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""colserver"Промокод: "colwhi"Успешно создан!", query_, "Закрыть", "");
	return 1;
} 
stock ShowPromoCodeList(playerid, page = 1) {
    format(t_string, sizeof (t_string), "SELECT * FROM s_promocode ORDER BY `used_count` DESC", 
        pInfo[playerid][pName]
    );
    new rows, Cache:tempQuery = mysql_query(dbHandle, t_string);
    cache_get_row_count(rows);
    t_string[0] = EOS;
    
    if (!rows) {
        SendClientMessage(playerid, COLOR_GREY, !"В данный момент нет промокодов");
		pc_cmd_setpromo(playerid);
        if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
        return true;
    }
    new max_page = (MAX_DIALOG_LIST_ITEMS + rows) / MAX_DIALOG_LIST_ITEMS, idx = 0;
    if (page < 1) page = 1;
    else if (page > max_page) page = max_page;  
    t_string = ""colserver"[№] Название\t"colserver"Активаций\n"colwhi"";
    for (new i = ((page - 1) * MAX_DIALOG_LIST_ITEMS), tempName[32], tempLevel; i < (page * MAX_DIALOG_LIST_ITEMS); i++) {
        if (i >= rows) continue;
        cache_get_value_name(i, "code", tempName, sizeof (tempName));
        cache_get_value_name_int(i, "used_count", tempLevel); 

        format(t_string, sizeof (t_string), "%s[%i] %s\t%d раз\n", t_string, (page - 1) * MAX_DIALOG_LIST_ITEMS + idx, tempName, tempLevel);
        playerListItem[playerid][idx++] = -1;
    }
    if (page > 1) {
        strcat(t_string, "[<<<] Предыдущая страница\n");
        playerListItem[playerid][idx++] = 2; // (-)
    }
    if (page < max_page) {
        strcat(t_string, "Следующая страница [>>>] \n");
        playerListItem[playerid][idx++] = 1; // (+)
    }
    pTemp[playerid][tSelectPage] = page; 

    new titleSTR[46];
    format(titleSTR, sizeof (titleSTR), ""colserver"Список промокодов (всего: %d)", rows);
    ShowPlayerDialog(playerid, D_PROMO_CODE_2, DIALOG_STYLE_TABLIST_HEADERS, titleSTR, t_string, "Выбрать", "Закрыть");

    if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
    t_string[0] = EOS;
    return true;
}
		
publics: GetPromoCodeDelete(playerid, code[])
{
	new
		rows,
		query_[128];
	cache_get_row_count(rows);
    if (!rows) return scm(playerid, COLOR_WHITE, !"Указанный промокод не найден");
    SendMes(playerid, COLOR_WHITE, "Промокод {FFFF00}%s{FFFFFF} успешно удалён", code);
    mysql_format(dbHandle, query_, sizeof query_, "DELETE FROM s_promocode WHERE code = '%s'", code);
    mysql_tquery(dbHandle, query_, "", "");
	return 1;
}
stock UpdateBuildText(b_id)
{
	new font_face[4][12] = {"Arial", "Calibri", "Tahoma", "Verdana"},
 		text[144+16];
	if (!BildInfo[b_id][bOwned])//fRGBColor
	{
		format(text,144+16,"{000000}Рекламное место свободно!\nВладелец: {%s}%s",gFraction[BildInfo[b_id][bMember]][fRGBColor],gFraction[BildInfo[b_id][bMember]][fName]);
		BildInfo[b_id][bAligment] = 1;
		BildInfo[b_id][bFontSize] = 25;
		BildInfo[b_id][bBackColor] = 1;
	}
	else format(text,144+16,"{000000}%s",BildInfo[b_id][bText]);
	return SetDynamicObjectMaterialText(BildInfo[b_id][bObjectID], 0,text, 130, font_face[BildInfo[b_id][bFontFace]], BildInfo[b_id][bFontSize], 0, 0xFF000000,Colors_BIG[BildInfo[b_id][bBackColor]], BildInfo[b_id][bAligment]);
}
stock ShowPlayerEditMenu(playerid)
{
	t_string[0] = EOS;
	new
		str_[64],
		p_var = GetPVarInt(playerid,"SelectBildID"),
		font_face[4][12] = {"Arial", "Calibri", "Tahoma", "Verdana"},
	    aligment_name[3][16] = {"По левому краю", "По центру", "По правому краю"};

	t_string = ""colserver"[№] Параметр\t"colserver"Значение\n";
	
	BildIntro(playerid, p_var, -13);
	
	strcat(t_string,"\n"colwhi"[0] Текст\tИзменить");
	format(str_, sizeof str_,"\n[1] Цвет фона\t{%s}[||||||]",Colors_LOW[BildInfo[p_var][bBackColor]]);
	strcat(t_string, str_);
	format(str_, sizeof str_,"\n"colwhi"[2] Шрифт текста\t%s",font_face[BildInfo[p_var][bFontFace]]);
	strcat(t_string, str_);
	format(str_, sizeof str_,"\n[3] Размер текста\t%d",BildInfo[p_var][bFontSize]);
	strcat(t_string, str_);
	format(str_, sizeof str_,"\n[4] Выравнивание текста\t%s",aligment_name[BildInfo[p_var][bAligment]]);
	strcat(t_string, str_);
	strcat(t_string,"\n[5] Разорвать договор аренды");
	strcat(t_string,"\n[6] Завершить редактирование");
	return ShowPlayerDialog(playerid, D_NEWS_FUNC_2, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Редактирование: "colwhi"Настройка рекламы", t_string, "Выбрать", "Закрыть");
}
stock BildIntro(playerid, b_id, c_dist)
{
	new
		Float: x = BildInfo[b_id][bPos][0],
		Float: y = BildInfo[b_id][bPos][1];
    GetXYInFront(x, y, BildInfo[b_id][bPos][3], c_dist);
    TogglePlayerControllable(playerid, false);
	SetPlayerPosAC(playerid, x, y, BildInfo[b_id][bPos][2]);
    SetPlayerCameraPos(playerid, x, y, BildInfo[b_id][bPos][2]);
    SetPlayerCameraLookAt(playerid, BildInfo[b_id][bPos][0], BildInfo[b_id][bPos][1], BildInfo[b_id][bPos][2]);
    return SetPlayerInterior(playerid, 0), 1;
}
stock BildExit(playerid)
{
	SetPlayerPosAC(playerid, GetPVarFloat(playerid,"bild_x"), GetPVarFloat(playerid,"bild_y"), GetPVarFloat(playerid,"bild_z"), GetPVarInt(playerid,"bild_world"), GetPVarInt(playerid,"bild_int"));
	SetPlayerFacingAngle(playerid,273.5792);
	SetCameraBehindPlayer(playerid);
	TogglePlayerControllable(playerid, 1);
    return 1;
}
stock GetXYInFront(&Float:x, &Float:y, Float:angle, Float:distance) {
    x += (distance * floatsin(-angle, degrees));
    y += (distance * floatcos(-angle, degrees));
}
stock ShowPlayer_Admin_Report_Answer(playerid, report_id)
{
	SetPVarInt(playerid, "report_id_to_answer", report_id);

	aReportInfo[report_id][adminID] = playerid;
	aReportInfo[report_id][rIsTooked] = true;
	new
	    string_[64];
	t_string[0] = EOS;
	format(string_, sizeof string_, ""colserver"Жалоба от: "colwhi"[%d] %s", 
		report_id, pInfo[ aReportInfo[report_id][rPlayerID] ][pName]
	);
	
	format(t_string, sizeof t_string, ""colwhi"Жалоба: %s\n\nОтправил: %s\nВремя отправки: %s\n\nВведите ваш ответ в диалоговое поле ниже:",
		aReportInfo[report_id][rText],
		pInfo[aReportInfo[report_id][rPlayerID]][pName],
		aReportInfo[report_id][rWhenWroted_Text]
	);

	ShowPlayerDialog(playerid, D_REPORT_1, DIALOG_STYLE_INPUT, string_, t_string, "Ответить", "Назад");
	return 1;
} 

stock IsVehicleInQuad(Float:veh_x, Float:veh_y, Float:q_minx, Float:q_miny, Float:q_maxx, Float:q_maxy )
{
	if ( veh_x >= q_minx && veh_x <= q_maxx && veh_y >= q_miny && veh_y <= q_maxy ) return 1;
	else return 0;
} 

publics: clear_leave_np_td ( playerid )
{
	DeletePVar ( playerid, "leavenp_td_status" ) ;
	for ( new j = 0 ; j < 6 ; j ++ )
	{
		TextDrawHideForPlayer ( playerid, np_td [ j ] ) ;
	}
	return 1 ;
}
publics: SearchFineVehiclePlayer(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if (!rows) return SendClientMessage(playerid, -1, !"У Вас нет арестованных транспортных средств") ;
	t_string[0] = EOS;
	for(new i = 0 ; i < rows ; i ++)
	{
		new veh_model,
			veh_plate[12],
			veh_id,
			veh_tax_fine;
        cache_get_value_name_int(i, "vID", veh_id);
        cache_get_value_name_int(i, "vModel", veh_model);
        cache_get_value_name(i, "vNumber", veh_plate, 12);
		cache_get_value_name_int(i, "vDayFine", veh_tax_fine);

		new line_string[120] ;
		format(line_string, sizeof line_string, ""colwhi"[%d] %s(%d)\tНомерной знак: %s\tСумма выкупа: "collime"$%d\n", 
			i, VehicleNames[ veh_model - 400 ], veh_model, veh_plate, (veh_tax_fine*fInfo[FRACTION_LSPD][fCost][0])
		);
		strcat(t_string, line_string) ;

		format(line_string, 16, "lf_listid_%d", i);
		SetPVarInt(playerid, line_string, veh_id);

		format(line_string, 16, "lf_listmodel_%d", i);
		SetPVarInt(playerid, line_string, veh_model);

		format(line_string, 16, "lf_listtax_%d", i);
		SetPVarInt(playerid, line_string, (veh_tax_fine*fInfo[FRACTION_LSPD][fCost][0]));
	}
	ShowPlayerDialog(playerid, D_FINE_CAR_0, DIALOG_STYLE_TABLIST, ""colserver"Штрафстоянка: "colwhi"Los Santos", t_string, "Выбрать", "Закрыть");
	return 1 ;
}
				
stock UpdateFractionStore(fraction_id)
{
	new
		c_gzGang[6],
		string_[512];
    for(new i = 1; i <= TOTALGZ; i++){
		if (GZInfo[i][gFrakVlad] == 12)
			c_gzGang[0]++;
		else if (GZInfo[i][gFrakVlad] == 13)
            c_gzGang[1]++;
		else if (GZInfo[i][gFrakVlad] == 15)
		    c_gzGang[2]++;
		else if (GZInfo[i][gFrakVlad] == 17)
		    c_gzGang[3]++;
		else if (GZInfo[i][gFrakVlad] == 18)
		    c_gzGang[4]++;
		else if (GZInfo[i][gFrakVlad] == 8)
		    c_gzGang[5]++;
	}
	
	if (fraction_id == FRACTION_LSPD || fraction_id == FRACTION_FBI || fraction_id == FRACTION_SFPD || fraction_id == FRACTION_LVPD) {
		format(string_, sizeof string_, "{FFD700}Склад оружия\n"colwhi"Материалов: {F58B11}%d ед.\n\n{CAFA0A}Используйте: ALT",
			FractionInfo[fraction_id][fMaterials]
		);
	} 
	else if (fraction_id == FRACTION_LCN)
	{
		if (FractionInfo[fraction_id][fMaterials] > STORE_MAFIA_MATERIALS) FractionInfo[fraction_id][fMaterials] = STORE_MAFIA_MATERIALS;
		if (FractionInfo[fraction_id][fMoney] > 1_000_000_000) {
			FractionInfo[fraction_id][fMoney] = 1_000_000_000;
		} 
		format(string_, sizeof string_, "{FFD700}Склад La Cosa Nostra\n\
			"colwhi"Материалы: {F58B11}%d\n\
