stock SetPlayerSatiety(playerid, Float:amount) {
	pInfo[playerid][Satiety] = amount;
    if (pInfo[playerid][PlayerSettings] & setShowEatBar) {
		SetPlayerProgressBarValue(playerid, EatBar[playerid],pInfo[playerid][Satiety]);
	}
	return 1;
}
stock GivePlayerSatiety(playerid, Float:amount) {
    pInfo[playerid][Satiety] += amount;
	if (pInfo[playerid][Satiety] > 1000) pInfo[playerid][Satiety] = 1000;
    if (pInfo[playerid][PlayerSettings] & setShowEatBar) {
		SetPlayerProgressBarValue(playerid, EatBar[playerid],pInfo[playerid][Satiety]);
	}
	return 1;
}

