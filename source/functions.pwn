}
stock SaveFermID(idx)
{
    new query_[400];
	format(query_, sizeof query_,"UPDATE `farms` SET `owner` = '%s', `bank` = '%d', `landtax` = '%d', `zp` = '%d', `grain_price` = '%d', `grain` = '%d', `grain_sown` = '%d', `prods_selling` = '%d', `prods` = '%d', `prods_price` = '%d'  WHERE `id` = '%d' LIMIT 1",
	FarmInfo[idx][fOwner], FarmInfo[idx][fBank], FarmInfo[idx][fLandTax], FarmInfo[idx][fZp],
	FarmInfo[idx][fGrain_Price], FarmInfo[idx][fGrain], FarmInfo[idx][fGrain_Sown],
	FarmInfo[idx][fProds_Selling], FarmInfo[idx][fProds], FarmInfo[idx][fProds_Price], FarmInfo[idx][fID]);
