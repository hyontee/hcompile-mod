	t_string[0] = EOS;
	strcat(t_string, "Оружие\tКоличество патронов\n");
	for (new x; x < 6; x ++)
	{
		if (HouseInfo[H_IDX][hSafeGun][x] != 0) GetWeaponName(HouseInfo[H_IDX][hSafeGun][x], gunname, 32);
