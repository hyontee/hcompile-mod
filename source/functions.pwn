stock IsDeputyPlayer(const nickname[], idx)
{
	if (!strcmp(nickname, FarmInfo[idx][fDeputy_1], true)) return true;
	else if (!strcmp(nickname, FarmInfo[idx][fDeputy_2], true)) return true;
	else if (!strcmp(nickname, FarmInfo[idx][fDeputy_3], true)) return true;
	return false;
}
stock IsFermerPlayer(const nickname[], idx)
{
	if (!strcmp(nickname, FarmInfo[idx][fFarmer_1], true)) return true;
	else if (!strcmp(nickname, FarmInfo[idx][fFarmer_2], true)) return true;
	else if (!strcmp(nickname, FarmInfo[idx][fFarmer_3], true)) return true;
	else if (!strcmp(nickname, FarmInfo[idx][fFarmer_4], true)) return true;
	else if (!strcmp(nickname, FarmInfo[idx][fFarmer_5], true)) return true;
	return false;
}

stock SaveGangZone(i)
{
    new query_[100];
	format(query_, sizeof query_, "UPDATE `s_gangzone` SET `gang_owner` = '%d' WHERE `id` = '%d'", GZInfo[i][gFrakVlad], GZInfo[i][gID]);
	mysql_tquery(dbHandle, query_, "", "");

	GangZoneHideForAll(GZInfo[i][gZone]);
	GangZoneShowForAll(GZInfo[i][gZone], GetGangZoneColor(i));
	return 1;
} 

publics: GzCheck(const i, const napad, const vlad)
{
    GZInfo[i][gCaptureTime]--;
    UpdateSeconds(i);
    if (GZInfo[i][gCaptureTime] < 1)
    {
        new count_on_zone[2] = {0, ...};

        foreach(new x: PlayerTeam[vlad])
        {
            if (GetPlayerState(x) == PLAYER_STATE_ONFOOT && pTemp[x][PlayerAFK] <= 2 && IsPlayerToSquare(x, GZInfo[i][gCoords][0], GZInfo[i][gCoords][1],GZInfo[i][gCoords][2],GZInfo[i][gCoords][3]))
            {
                count_on_zone[0]++; 
                if (count_on_zone[0] == CAPTURE_EXTENSION_MIN_PLAYER) break;
            }
        }
        foreach(new x: PlayerTeam[napad])
        {
            if (GetPlayerState(x) == PLAYER_STATE_ONFOOT && pTemp[x][PlayerAFK] <= 2 && IsPlayerToSquare(x, GZInfo[i][gCoords][0], GZInfo[i][gCoords][1], GZInfo[i][gCoords][2], GZInfo[i][gCoords][3])) 
            {
                count_on_zone[1]++; 
                if (count_on_zone[1] == CAPTURE_EXTENSION_MIN_PLAYER) break;
            }
        }
        if (count_on_zone[0] == CAPTURE_EXTENSION_MIN_PLAYER && count_on_zone[1] == CAPTURE_EXTENSION_MIN_PLAYER)
        {
			new 
				dop_time = RandomFIX(60, 120);
            GZInfo[i][gCaptureTime] = dop_time;//120; RandomFIX(60, 120)
			GZInfo[i][gCaptureOverTime] = 1;
            UpdateSeconds(i);
            SendFamilyMessage(napad, 0x00cc44FF, !"Война за территорию продлена");
			SendFamilyMessage(vlad, 0x00cc44FF, !"Война за территорию продлена"); 
			new 
				string_[128];
			format(string_, sizeof string_, "[Оповещение]: CAPTURE: %s/%s "colwhi"продлен на %d секунд [Счетчик: %d/%d]",
				name_band[capture_band(napad)], name_band[capture_band(vlad)], dop_time, capture_kills[capture_band(napad)], capture_kills[capture_band(vlad)]
			);
			SendAdminMessage(0xEB6B56FF, string_);  
            return 1;
        } 
		if (count_on_zone[0] < count_on_zone[1])
		{
			SendFamilyMessage(napad, 0x00B953AA, !"Вы взяли под свой контроль новую территорию (+ 10 G-Points)");
			GiveFractionPoints(napad, 10);
			SendFamilyMessage(vlad, 0xC56565AA, !"Вы потеряли контроль одной из своих территорий");
			GZInfo[i][gFrakVlad] = napad;
			GangZoneStopFlashForAll(GZInfo[i][gZone]);
			SaveGangZone(i);

			foreach(new idx: PlayerTeam[napad])
			{
				OnPlayerQuestProgress(idx, QUEST_GHETTO, QUEST_TASK_WIN_CAPTURE);
			}
		}
		else
		{
			SendFamilyMessage(vlad, 0x00B953AA, !"Вы отстояли свою территорию (+ 10 G-Points)");
			GiveFractionPoints(vlad, 10);
			SendFamilyMessage(napad, 0xC56565AA, !"Вам не удалось захватить территорию");
			GangZoneStopFlashForAll(GZInfo[i][gZone]);
		} 


        new bestPlayerID;
        foreach(new idx: PlayerTeam[napad]) {
			if (CaptureInfo[idx][pDMG]) {
				if (bestPlayerID == -1 || CaptureInfo[idx][pDMG] > CaptureInfo[bestPlayerID][pDMG]) {
					bestPlayerID = idx;
				}
			}
			/*for(new i_ = 0; i_ < 5; i_++) {
				if (!player_mobile[idx]) SendDeathMessageToPlayer(idx,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
			} */
            HideTextDrawCapture(idx,GZInfo[i][gTD]);
			new query_[128];
			mysql_format(dbHandle, query_,sizeof query_,"UPDATE s_users SET CapturesCount = CapturesCount + 1 WHERE pID = '%d' LIMIT 1", pInfo[idx][pID]);
			mysql_tquery(dbHandle, query_, "", "");
 		}
        foreach(new idx: PlayerTeam[vlad]) {
			if (CaptureInfo[idx][pDMG]) {
				if (bestPlayerID == -1 || CaptureInfo[idx][pDMG] > CaptureInfo[bestPlayerID][pDMG]) {
					bestPlayerID = idx;
				}
			}
			/*for(new i_ = 0; i_ < 5; i_++) {
				if (!player_mobile[idx]) SendDeathMessageToPlayer(idx,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
			} */
            HideTextDrawCapture(idx,GZInfo[i][gTD]);
			new query_[128];
			mysql_format(dbHandle, query_,sizeof query_,"UPDATE s_users SET CapturesCount = CapturesCount + 1 WHERE pID = '%d' LIMIT 1", pInfo[idx][pID]);
			mysql_tquery(dbHandle, query_, "", "");
 		}
		if (bestPlayerID != -1) {
			format(t_string, sizeof (t_string), "Лучший игрок - %s[%i], который совершил %d уб. и нанёс %.1f!",
				pInfo[bestPlayerID][pName], bestPlayerID, CaptureInfo[bestPlayerID][pKills], CaptureInfo[bestPlayerID][pDMG]
			);
			GiveFractionRepute(pInfo[bestPlayerID][pMember], 5);
		} 
		SendFamilyMessage(napad, 0x00B953AA, t_string);
		SendFamilyMessage(vlad, 0xC56565AA, t_string);

		ClearKillFeed(napad);
		ClearKillFeed(vlad);

		t_string[0] = EOS;

        capture_now[capture_band( napad )] = 0;
        capture_now[capture_band( vlad )] = 0;

        capture_start[capture_band( napad )] = CoolDownHourCapture();
        capture_start[capture_band( vlad )] = CoolDownHourCapture();

        g_capture_attack[capture_band( napad )] = false;
        g_capture_attack[capture_band( vlad )] = false;

        TotalGzB = 0, TotalGzV = 0, TotalGzG = 0, TotalGzA = 0, TotalGzR = 0, TotalGzP = 0;
        for(new x = 1; x <= TOTALGZ; x++)
		{
			if (GZInfo[x][gFrakVlad] == 8) TotalGzP++;
			if (GZInfo[x][gFrakVlad] == 12) TotalGzB++;
			if (GZInfo[x][gFrakVlad] == 13) TotalGzV++;
			if (GZInfo[x][gFrakVlad] == 15) TotalGzG++;
			if (GZInfo[x][gFrakVlad] == 17) TotalGzA++;
			if (GZInfo[x][gFrakVlad] == 18) TotalGzR++;
		}
		DestroyDynamicArea(GZInfo[i][gCaptureArea]);

		
		//captureid_slots[capture_id] = pInfo[playerid][pMember];
        if (GZInfo[i][gTimer] != 0)
		{
			KillTimer(GZInfo[i][gTimer]);
			GZInfo[i][gTimer] = 0;
        } 
		#if defined _capture_stats_inc
			if (CAPTURE_STATS_ENABLED) {
				//new capture_id = GetGangCaptureID(napad);
				new capture_id = GZInfo[i][gTD];
				if (capture_id != -1) {
					#if !defined CAPTURE_SHOW_ALWAYS
					if (capture_band(capture_gangs[capture_id][0]) < sizeof (capture_band_captureid))
						capture_band_captureid[capture_band(capture_gangs[capture_id][0])] = -1;
					if (capture_band(capture_gangs[capture_id][1]) < sizeof (capture_band_captureid))
						capture_band_captureid[capture_band(capture_gangs[capture_id][1])] = -1;
					#endif
					captureid_slots[capture_id] = 
					capture_gangs[capture_id][0] = 
					capture_gangs[capture_id][1] = 0;
				}
			}
			setCaptureFreeID[ GZInfo[i][gTD] ] = -1;
        #endif
    }
	return 1;
}

publics: MzCheck(i,napad,vlad)
{
	if (ZoneID < 1 || ZoneID > sizeof (MafiaWarZonePos))
	{
		KillTimer(MzCheckTimer); 
		return 1;
	}
	ZoneTimer--;
	UpdateMafiaWarSeconds();
 
	if (ZoneTimer == 600) {
	    SendFamilyMessage(napad,0x114D71AA, !"У вас осталось 10 минут на подготовку!");
	    SendFamilyMessage(vlad,0x114D71AA, !"У вас осталось 10 минут на подготовку!");
	}
	if (ZoneTimer == 120) {
	    SendFamilyMessage(napad,COLOR_RED, !"Пора решать кому будет принадлежать бизнес. Осталось 2 минуты");
	    SendFamilyMessage(vlad,COLOR_RED, !"Пора решать кому будет принадлежать бизнес. Осталось 2 минуты");
	}

	if (ZoneTimer < 1) 
	{ 
		new count_on_zone[2] = {0, ...};
        
        foreach(new x: PlayerTeam[vlad])
        {
            if (GetPlayerState(x) == PLAYER_STATE_ONFOOT && pTemp[x][PlayerAFK] <= 2 && IsPlayerToMafiaWar(x))
            {
                count_on_zone[0]++; 
                if (count_on_zone[0] == MAFIAWAR_EXTENSION_MIN_PLAYER) break;
            }
        }
        foreach(new x: PlayerTeam[napad])
        {
            if (GetPlayerState(x) == PLAYER_STATE_ONFOOT && pTemp[x][PlayerAFK] <= 2 && IsPlayerToMafiaWar(x))
            {
                count_on_zone[1]++; 
                if (count_on_zone[1] == MAFIAWAR_EXTENSION_MIN_PLAYER) break;
            }
        }

		new str_biz_name[64],str_control[68+sizeof(str_biz_name)];
		format(str_biz_name,sizeof(str_biz_name),"%s",BusinessInfo[i][bName]);

		if (count_on_zone[0] == MAFIAWAR_EXTENSION_MIN_PLAYER && count_on_zone[1] == MAFIAWAR_EXTENSION_MIN_PLAYER) 
        {
            ZoneTimer = 120;
			format( str_control,sizeof(str_control),"Вам добавлено 2 минуты для решения: кто будет контролировать бизнес %s.",str_biz_name);
			SendFamilyMessage(napad, 0x00cc44FF,str_control);
			SendFamilyMessage(vlad, 0x00cc44FF,str_control);
            return 1;
        }
		if (count_on_zone[0] < count_on_zone[1])
       // if (kills_mafia[0] > kills_mafia[1])
        {
			format(str_control,sizeof(str_control),"Вы взяли под контроль бизнес %s",str_biz_name);
			SendFamilyMessage(napad, 0x114D71AA,str_control);
			format(str_control,sizeof(str_control),"Вы потеряли контроль над бизнесом %s",str_biz_name);
			SendFamilyMessage(vlad, 0xC56565AA,str_control);
			BusinessInfo[i][bMafia] = napad;

			new qury_[60];
			format(qury_, sizeof (qury_), "bMafia = %i", BusinessInfo[i][bMafia]);
			SaveBusiness(i, qury_);

			StopWar();
        }
        else
        {
			format(str_control,sizeof(str_control), "Вы отстояли бизнес %s",str_biz_name);
           	SendFamilyMessage(vlad,0x114D71AA,str_control);
			format(str_control,sizeof(str_control), "Вам не удалось захватить  бизнес %s",str_biz_name);
			SendFamilyMessage(napad,0xC56565AA,str_control);
			StopWar();
        }
		ClearKillFeed(napad);
		ClearKillFeed(vlad);

		capture_now[capture_band( napad )] = 0;
        capture_now[capture_band( vlad )] = 0;

        capture_start[capture_band( napad )] = 2;
        capture_start[capture_band( vlad )] = 2;

        gang_capture--;

		#if defined _capture_stats_inc
			if (CAPTURE_STATS_ENABLED) {
				new capture_id = TYPE_WAR_MAFIA;
				if (capture_id != -1) {
					#if !defined CAPTURE_SHOW_ALWAYS
					if (capture_band(capture_gangs[capture_id][0]) < sizeof (capture_band_captureid))
						capture_band_captureid[capture_band(capture_gangs[capture_id][0])] = -1;
					if (capture_band(capture_gangs[capture_id][1]) < sizeof (capture_band_captureid))
						capture_band_captureid[capture_band(capture_gangs[capture_id][1])] = -1;
					#endif
					captureid_slots[capture_id] = 
					capture_gangs[capture_id][0] = 
					capture_gangs[capture_id][1] = 0;
				}
			}
        #endif

	}
	return 1;
}

stock StopWar()
{ 
    foreach(new idx: PlayerTeam[mafia_frac_id[0]])
	{
		/*for(new i_ = 0; i_ < 5; i_++) {
			if (!player_mobile[idx]) SendDeathMessageToPlayer(idx,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
		}*/
		HideTextDrawCapture(idx, TYPE_WAR_MAFIA); 
		OnPlayerQuestProgress(idx, QUEST_MAFIA, QUEST_TASK_MAFIA_WAR);
	}
	foreach(new idx: PlayerTeam[mafia_frac_id[1]])
	{
		/*for(new i_ = 0; i_ < 5; i_++) {
			if (!player_mobile[idx]) SendDeathMessageToPlayer(idx,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
		}*/
		HideTextDrawCapture(idx, TYPE_WAR_MAFIA);

		OnPlayerQuestProgress(idx, QUEST_MAFIA, QUEST_TASK_MAFIA_WAR);
	}
 
	ZoneID = 0;
	ZoneTimer = 0;
	mafia_frac_id[0] = 0;
	mafia_frac_id[1] = 0;
	kills_mafia[0] = 0;
	kills_mafia[1] = 0; 
	GangZoneStopFlashForAll(ZoneWar);
	GangZoneHideForAll(ZoneWar);
	KillTimer(MzCheckTimer);
}  

publics: BzCheck(i,napad,vlad)
{ //), 7, 1, -1, 111122)
	BikersTimer--;
	UpdateBikersWarSeconds();

	if (BikersTimer == 600) {//Пора выяснить, кто завоюет крышу клиентуры. До конца стрелы осталось 10 минут.
	    SendFamilyMessage(napad,0x114D71AA, !"Пора выяснить, кто завоюет крышу клиентуры. До конца стрелы осталось 10 минут.", .dliv = true);
	    SendFamilyMessage(vlad,0x114D71AA, !"Пора выяснить, кто завоюет крышу клиентуры. До конца стрелы осталось 10 минут.", .dliv = true);
		SendAdminMessage(0x114D71AA, "Пора выяснить, кто завоюет крышу клиентуры. До конца стрелы осталось 10 минут.");
	}
	if (BikersTimer == 120) {
	    SendFamilyMessage(napad, 0x114D71AA, !"Поторопитесь, до конца стрелы осталось 2 минуты.", .dliv = true);
	    SendFamilyMessage(vlad, 0x114D71AA, !"Поторопитесь, до конца стрелы осталось 2 минуты.", .dliv = true);
		SendAdminMessage(0x114D71AA, "Поторопитесь, до конца стрелы осталось 2 минуты.");
	}

	if (BikersTimer < 1) 
	{ 
		new count_on_zone[2] = {0, ...};
        
        foreach(new x: PlayerTeam[vlad])
        {
            if (GetPlayerState(x) == PLAYER_STATE_ONFOOT && pTemp[x][PlayerAFK] <= 2 && IsPlayerToBikersWar(x, i))
            {
                count_on_zone[0]++; 
                if (count_on_zone[0] == BIKERWAR_EXTENSION_MIN_PLAYER) break;
            }
        }
        foreach(new x: PlayerTeam[napad])
        {
            if (GetPlayerState(x) == PLAYER_STATE_ONFOOT && pTemp[x][PlayerAFK] <= 2 && IsPlayerToBikersWar(x, i))
            {
                count_on_zone[1]++; 
                if (count_on_zone[1] == BIKERWAR_EXTENSION_MIN_PLAYER) break;
            }
        } 
		new string_[128]; 

		if (count_on_zone[0] == BIKERWAR_EXTENSION_MIN_PLAYER && count_on_zone[1] == BIKERWAR_EXTENSION_MIN_PLAYER) 
        {
            BikersTimer = 120; 
			SendFamilyMessage(napad, 0x114D71AA, "Война за клиентуру продлена на 2 минуты.", .dliv = true);
			SendFamilyMessage(vlad, 0x114D71AA, "Война за клиентуру продлена на 2 минуты.", .dliv = true);
			SendAdminMessage(0x114D71AA, "Война за клиентуру продлена на 2 минуты.");
            return 1;
        }
        if (kills_bikers[0] > kills_bikers[1])
        {
			format(string_, sizeof string_, "Вы взяли под контроль дом семьи: %s", FamilyHouse[i][fhOwner]);
			SendFamilyMessage(napad, 0x114D71AA, string_);
			format(string_, sizeof string_, "Вы потеряли контроль над домом семьи: %s", FamilyHouse[i][fhOwner]);
			SendFamilyMessage(vlad, 0xC56565AA, string_);
			FamilyHouse[i][fhBikers] = napad;

			new query_[64];
			format(query_, sizeof query_, "hBikers = '%d'", FamilyHouse[i][fhBikers]);
			SaveFamilyHouse(i, query_);  

			StopBikersWar();
        }
        else
        {
			format(string_, sizeof string_, "Вы отстояли свою крышу %s",FamilyHouse[i][fhOwner]);
           	SendFamilyMessage(vlad,0x114D71AA, string_);
			format(string_, sizeof string_, "Вам не удалось завоевать крышу семейного особняка: %s",FamilyHouse[i][fhOwner]);
			SendFamilyMessage(napad,0xC56565AA, string_);
			StopBikersWar();
        }
		capture_now[capture_band( napad )] = 0;
        capture_now[capture_band( vlad )] = 0;

        capture_start[capture_band( napad )] = 2;
        capture_start[capture_band( vlad )] = 2;
		#if defined _capture_stats_inc
			if (CAPTURE_STATS_ENABLED) {
				new capture_id = TYPE_WAR_BIKERS;
				if (capture_id != -1) {
					#if !defined CAPTURE_SHOW_ALWAYS
					if (capture_band(capture_gangs[capture_id][0]) < sizeof (capture_band_captureid))
						capture_band_captureid[capture_band(capture_gangs[capture_id][0])] = -1;
					if (capture_band(capture_gangs[capture_id][1]) < sizeof (capture_band_captureid))
						capture_band_captureid[capture_band(capture_gangs[capture_id][1])] = -1;
					#endif
					captureid_slots[capture_id] = 
					capture_gangs[capture_id][0] = 
					capture_gangs[capture_id][1] = 0;
				}
			}
        #endif

	}
	return 1;
}

stock StopBikersWar()
{ 
    foreach(new idx: PlayerTeam[bikers_frac_id[0]])
	{
		/*for(new i_ = 0; i_ < 5; i_++) {
			if (!player_mobile[idx]) SendDeathMessageToPlayer(idx,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
		}*/
		HideTextDrawCapture(idx, TYPE_WAR_BIKERS); 
	}
	foreach(new idx: PlayerTeam[bikers_frac_id[1]])
	{
		/*for(new i_ = 0; i_ < 5; i_++) {
			if (!player_mobile[idx]) SendDeathMessageToPlayer(idx,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
		}*/
		HideTextDrawCapture(idx, TYPE_WAR_BIKERS);
	}
  
	BikersTimer = 0;
	UpdateFamilyHouse(BikersFamilyHouseID);
	BikersFamilyHouseID = -1;
	bikers_frac_id[0] = 0;
	bikers_frac_id[1] = 0;
	kills_bikers[0] = 0;
	kills_bikers[1] = 0; 
	GangZoneStopFlashForAll(BikersWarGZ);
	GangZoneHideForAll(BikersWarGZ);
	GangZoneDestroy(BikersWarGZ);
	BikersWarGZ = INVALID_GANGZONE_ID;
	KillTimer(BzCheckTimer);
}  

stock GetIDOwnerGangZone(playerid) {
	new 
		bool: IsReturn = false;
	for(new idx = 1; idx <= TOTALGZ; idx++) {
		if(IsPlayerToSquare(playerid, GZInfo[idx][gCoords][0], GZInfo[idx][gCoords][1], GZInfo[idx][gCoords][2], GZInfo[idx][gCoords][3]) && pInfo[playerid][pMember] == GZInfo[idx][gFrakVlad]) {
			IsReturn = true; 
			break;
		}
	} 
	if (IsReturn) return true;
	return false;
}

stock IsPlayerInVehicleHome(playerid)
{
	if (!pTemp[playerid][tPlayerTrailerHome]) return 0;
	if (VehicleInfo[ pTemp[playerid][tPlayerTrailerHome] - 1 ][vFraction] == pInfo[playerid][pID]) return 1; 
	return 0;
}

publics: ShowNewsStatsAdvert(playerid, id_fraction, type_)
{
	new rows,
		edited_ads_,
		member_,
		NameShooter_[MAX_PLAYER_NAME],
		string_[164] ;
	t_string[0] = EOS;
	cache_get_row_count(rows);
	if (rows)
	{
        if (type_ == 0) strcat(t_string, ""colserver"[№] Никнейм\t"colserver"Отредактировал\n");
        else strcat(t_string, ""colserver"[№] Никнейм\t"colserver"Отредактировал\t"colserver"Организация\n");
		for ( new idx = 0 ; idx < rows ; idx ++ )
		{
		    cache_get_value_name(idx, "Name", NameShooter_, MAX_PLAYER_NAME);
		    cache_get_value_name_int(idx, "pMember", member_);
			cache_get_value_name_int(idx, "edited_ads", edited_ads_);
			if (member_ == 9 || member_ == 16 || member_ == 20)
			{
				if (type_ == 0)
				{
				    if (member_ == id_fraction)
				    {
						format(string_, sizeof string_, ""colwhi"[%d] %s\t%d объявлений\n", idx, NameShooter_, edited_ads_);
						strcat(t_string, string_);
					}
				}
				else
				{
				    format(string_, sizeof string_, ""colwhi"[%d] %s\t%d объявлений\t{%s}%s\n", idx, NameShooter_, edited_ads_, gFraction[member_][fRGBColor], fInfo[member_][fName]);
					strcat(t_string, string_);
				}
			}
		}
		ShowPlayerDialog(playerid, D_NEWS_PANEL_20, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Топ репортеров", t_string, "Назад", "Закрыть" ) ;
	}
	else err("Данные не найдены!");
	return 1 ;
}

stock IsPlayerInBlackList(name_player[], member_)
{
	new query_[128],
		rows ;
	format(query_, sizeof query_, "SELECT * FROM `s_blacklist` WHERE `NameBlack` = '%s' and `Fraction` = '%d'", name_player, member_);
	mysql_query(dbHandle, query_, true);
	cache_get_row_count(rows);

	if (!rows)
		return 0;
	else
		return 1;
}
publics: ShowBlackList(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if (rows < 1)
	{
	    SendClientMessage(playerid, COLOR_GREY, !"Черный список Вашей организации пустой!");
	    ShowPlayerDialog(playerid, D_FRACTION_FUNC_8, DIALOG_STYLE_LIST, ""colserver"Участники организации", "[0] Все участники организации [OFFLINE]\n\
			[1] Фильтр по рангу\n[2] Участники организации [ONLINE]\n[3] Очистить Черный список\n[4] Посмотреть Черный список", "Выбрать", "Назад");
		return 1;
	}
	t_string[0] = EOS;
	new str_[128],
		nameleader[MAX_PLAYER_NAME],
		moneylist,
		reasonlist[64];
	strcat(t_string, ""colserver"Занёс\t\t\tСумма\t\tПричина\n\n");
	for(new idx; idx != rows; idx++)
	{
	    cache_get_value_name(idx, "NameLeader", nameleader, MAX_PLAYER_NAME);
	    cache_get_value_name(idx, "Reason", reasonlist, 64);
		cache_get_value_name_int(idx, "Money", moneylist);
		format(str_, sizeof str_, ""colwhi"%s\t"collime"$%d"colwhi"\t\t%s\n", nameleader, moneylist, reasonlist);
		strcat(t_string, str_);
	}
	ShowPlayerDialog(playerid, D_FRACTION_FUNC_21, 0, ""colserver"Чёрный список", t_string, "Назад", "Закрыть");
	return 1;
}
publics: LoadAccountBlackList(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if (rows < 1)
	{
	    SendClientMessage(playerid, COLOR_GREY, !"Вы не найдены не в одном черном списке");
		return ShowBankCenterDialog(playerid);
	}
	t_string[0] = EOS;
	new str_[128],
		player_name[MAX_PLAYER_NAME],
		money_,
		fraction_;
	strcat(t_string, ""colserver"[№] Организация\t"colserver"Сумма\t"colserver"Занёс\n");
	for(new idx; idx != rows; idx++)
	{
		cache_get_value_name(idx, "NameLeader", player_name, MAX_PLAYER_NAME);
		cache_get_value_name_int(idx, "Money", money_);
		cache_get_value_name_int(idx, "Fraction", fraction_);
		format(str_, sizeof str_, "[%d] %s\t$%d\t%s\n",idx, fInfo[fraction_][fName], money_, player_name);
		strcat(t_string, str_);
	}
	ShowPlayerDialog(playerid, D_BANK_FUNC_7, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Выход из: "colwhi"Черного списка", t_string, "Выбрать", "Отмена");
	return 1;
}
publics: EnterSearchBlackList(playerid, list_)
{
	new rows;
	cache_get_row_count(rows);
	if (rows < 1) return SendClientMessage(playerid, COLOR_GREY, !"Error (EnterSearchBlackList)");
	new
		str_[140],
		player_name[MAX_PLAYER_NAME],
		money_,
		fraction_;
    cache_get_value_name(list_, "NameLeader", player_name, MAX_PLAYER_NAME);
	cache_get_value_name_int(list_, "Money", money_);
	cache_get_value_name_int(list_, "Fraction", fraction_);
	
	SetPVarInt(playerid, "BlackListPlayerList", list_);
	SetPVarInt(playerid, "BlackListMoney", money_);
	SetPVarInt(playerid, "BlackListFraction", fraction_);
	SetPVarString(playerid, "BlackListNameLeader", player_name);
	
	format(str_, sizeof str_, ""colwhi"Вы желаете оплатить выход из черного списка в организации "colserver"%s\n"colwhi"За "collime"$%d"colwhi", Вы уверены?",fInfo[fraction_][fName], money_);
	ShowPlayerDialog(playerid, D_BANK_FUNC_8, DIALOG_STYLE_MSGBOX, ""colserver"Выход из: "colwhi"Черного списка", str_, "Да", "Нет");
	return 1;
}

stock uninvite_player(playerid)
{
    SendClientMessage(playerid, 0x6BB3FFAA, !"Вы снова гражданский");
	if (pTemp[playerid][tDutyWork] == 1){
    	SendClientMessage(playerid, 0x6BB3FFAA, !"Рабочий день окончен");
	}
    leave_team(playerid, pInfo[playerid][pMember]);
	LeavePlayerTaxi(playerid); 

	pInfo[playerid][pMember] =
	pInfo[playerid][pLeader] = 
	pInfo[playerid][pRank] =
	pTemp[playerid][tDutyWork] = 
	pInfo[playerid][FractionMute] =
	pInfo[playerid][FractionWarn] =
	pInfo[playerid][pJob] = 0;

	SetPlayerColor(playerid, TEAM_HIT_COLOR);
	SetPlayerSkinEx(playerid, pInfo[playerid][pChar][0]);
	if (pInfo[playerid][PlayerSpawn] == 2)
	{
	    if (pInfo[playerid][pHouseID] == -1) pInfo[playerid][PlayerSpawn] = 0;
		else pInfo[playerid][PlayerSpawn] = 1;
	    SavePlayerInteger(playerid, "playerspawn", pInfo[playerid][PlayerSpawn]);
	}
	SetPlayerArmour(playerid,0);
	ResetPlayerWeapons(playerid);
    new query_[140];
	mysql_format(dbHandle,query_, sizeof query_ , "UPDATE `s_users` SET `pLeader` = '0', `pMember` = '0', `pRank` = '0', `pJob` = '0' WHERE `Name` = '%e' LIMIT 1", pInfo[playerid][pName]);
	mysql_tquery(dbHandle, query_, "", "");

	#if defined _businesses_inc
		if (pTemp[playerid][tPlayerStartRob] != 0)
		{
			TextDrawHideForPlayer(playerid,Loading[0]);
			TextDrawHideForPlayer(playerid,Loading[1]);
			TextDrawHideForPlayer(playerid,BusinessInfo[pTemp[playerid][tPlayerStartRob]][LoadingProgress]);
			pTemp[playerid][tPlayerStartRob] = 0;
		}
	#endif

	return 1;
}

publics: TestOffmembers(playerid)
{
	new
		rows,
		get_name[MAX_PLAYER_NAME],
		get_rank,
		get_date[32],
		string_[128];
	cache_get_row_count(rows);
	if (rows)
	{
	    SendClientMessage(playerid, 0x059BD3FF, !"Список игроков: [Ник] [Ранг] [Последний вход]");
	    for(new i; i < rows; i++)
		{
		    cache_get_value_name(i, "Name", get_name);
		 	cache_get_value_name_int(i, "pRank", get_rank);
			cache_get_value_name(i, "pGetonDate", get_date);
			format(string_, sizeof string_, "[%s] [%d] [%s]",get_name, get_rank, get_date);
			SendClientMessage(playerid, 0x059BD3FF, string_);
		}
	}
	else return SendClientMessage(playerid, COLOR_GREY, !"Все члены организации в сети!");
	return 1;
}
publics: callback_offmembers(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if (!rows) {
		SendClientMessage(playerid, COLOR_GREY, !"Участники с данными параметрами не найдены") ;
		//ShowLeaderMenu ( playerid ) ;
		DeletePVar ( playerid, "ofm_list_page" ) ;
		return 1 ;
	}
	new rows_list = GetPVarInt(playerid, "ofm_list_page") - 1;
	SetPVarInt ( playerid, "ofm_list_rows", rows ) ; 
	t_string[0] = EOS;
	strcat(t_string, ""colserver"<< Предыдущая страница\t \t \n"colserver">> Следующая страница\t \t \n"); 
	for(new i = rows_list * 10, pl_ofm_name[MAX_PLAYER_NAME], pl_ofm_rank, string_[128], pl_ofm_online[16]; i <  rows_list * 10 + 10; i++)
	{
		if (i >= rows) break;
		cache_get_value_name(i, "Name", pl_ofm_name);
		cache_get_value_name_int(i, "pRank", pl_ofm_rank);
		cache_get_value_name(i, "pGetonDate", pl_ofm_online);

		new pvar_string[8];
		format(pvar_string, sizeof (pvar_string), "ofm_%d", i - rows_list * 10 ) ;
		SetPVarString(playerid, pvar_string, pl_ofm_name);

		format(string_, sizeof string_, "%s"colserver"\t%s(%d)"colwhi"\t%s\n",
			pl_ofm_name, fFractionRank[pInfo[playerid][pMember]][ pl_ofm_rank - 1 ],
			pl_ofm_rank, pl_ofm_online 
		);
		strcat(t_string, string_);
	}
	ShowPlayerDialog(playerid, D_FRACTION_FUNC_10, DIALOG_STYLE_TABLIST, ""colserver"Участники организации [OFFLINE]", t_string, "Выбрать", "Назад");
	return 1 ;
}
publics: callback_offmembers_info(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if (rows)
	{
		new pl_rank, last_date [ 16 ]; 
		cache_get_value_name_int(0, "pRank", pl_rank);
		cache_get_value_name(0, "pGetonDate", last_date);
		new pvar_string[20], pl_name[MAX_PLAYER_NAME] ;
		format(pvar_string, sizeof pvar_string, "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ));
		GetPVarString(playerid, pvar_string, pl_name, MAX_PLAYER_NAME);
		new 
			dialog_string[186];
		format(dialog_string, sizeof dialog_string, ""colwhi"Имя: %s\nРанг:%s [%d]\nПоследний вход: %s",
			pl_name, fFractionRank[pInfo[playerid][pMember]][ pl_rank - 1 ],
			pl_rank, last_date
		);
		ShowPlayerDialog(playerid, D_FRACTION_FUNC_12, DIALOG_STYLE_MSGBOX, ""colserver"Информация об игроке", dialog_string, "Назад", "" );
	}
	if (!rows) {
		new 
			query_[128];
		DeletePVar(playerid, "ofm_listitem");
		if (!GetPVarInt(playerid, "ofm_type"))
		{
			mysql_format(dbHandle, query_, sizeof query_, "SELECT `Name`,`pRank`,`pGetonDate` FROM `s_users` WHERE `pMember` = '%d' AND `pLogin` = '0'", pInfo[playerid][pMember]);
			mysql_tquery(dbHandle, query_, "callback_offmembers", "i", playerid);
			return 1;
		}
		mysql_format(dbHandle, query_, sizeof query_, "SELECT `Name`,`pRank`,`pGetonDate` FROM `s_users` WHERE `pMember` = '%d' AND `pRank` = '%d' AND `pLogin` = '0'", pInfo[playerid][pMember], GetPVarInt(playerid, "ofm_type"));
		mysql_tquery(dbHandle, query_, "callback_offmembers", "i", playerid);

	}
	return 1 ;
}

stock OnPlayerServerBanWarn(playerid, nick[], reason[])
{
	new unwarndate, string[300];
	unwarndate = gettime() + (14 * 86400);
	mysql_format(dbHandle, string, sizeof(string), "INSERT INTO `s_ban`  ( `Text`, `Name`, `NameAdmin`, `Date`, `Unban`) VALUES ('%e', '%s', '%s', '%d', '%d')",reason, nick, pInfo[playerid][pName], gettime(), unwarndate);
	mysql_tquery(dbHandle, string);
	return 1;
}

stock OnPlayerServerBan(playerid, targetid = INVALID_PLAYER_ID, const reason[], temp_day)
{
	new unwarndate;

	unwarndate = gettime() + temp_day * 86400;

	mysql_format(dbHandle, 
        totalstring, 
        sizeof totalstring, 
        "INSERT INTO `s_ban`  ( `Text`, `Name`, `NameAdmin`, `Date`, `Unban`) VALUES ('%e', '%e', '%e', '%d', '%d')",
        reason, 
        pInfo[targetid][pName], 
        pInfo[playerid][pName], 
        gettime(), 
        unwarndate
    );
	mysql_tquery(dbHandle, totalstring);

	Kick(targetid);

    totalstring[0] = EOS;

	return 1;
}

stock HistoryPlayerBan(player_id, const newname[], const reason[])
{
	mysql_format(
        dbHandle, 
        totalstring, sizeof totalstring, "\
        INSERT INTO `sh_ban` (`pID`, `NameAdmin`, `Date`, `Text` ) VALUES ('%d', '%e', NOW(), '%e')", 
        player_id, 
        newname, 
        reason
    );
	mysql_tquery(dbHandle, totalstring);

    totalstring[0] = EOS;

    return 1;
}

stock HistoryPlayerWarn(player_id, const newname[], const reason[])
{
	mysql_format(
        dbHandle, 
        totalstring, 
        sizeof totalstring, "\
        INSERT INTO `sh_warn` (`pID`, `NameAdmin`, `Date`, `Text` ) VALUES ('%d', '%e', NOW(), '%e')", 
        player_id, 
        newname, 
        reason
    );
	mysql_tquery(dbHandle, totalstring);

    totalstring[0] = EOS;

    return 1;
}

stock SetPlayerHistoryName(player_id, const newname[], const oldname[])
{
	new query[156];
	format(query, sizeof(query), "INSERT INTO `sh_login` (`pID`, `PlayerName`, `OldName`, `Data`) VALUES ('%d', '%s', '%s', NOW())", player_id, newname, oldname);
	return mysql_tquery(dbHandle, query);
}

stock SetPlayerConnection(player_id, newname[], player_ip[])
{
	new query[156];
	format(query, sizeof(query), "INSERT INTO `sh_connect` (`pID`, `PlayerName`, `PlayerIP`, `Data`) VALUES ('%d', '%s', '%s', NOW())", player_id, newname, player_ip);
	return mysql_tquery(dbHandle, query);
}

publics: GetIDAccountNameStore(playerid, nick[], type)
{
	new rows, query[128], id_player;
	cache_get_row_count(rows);
	if (!rows) return 1;
	else
	{
        cache_get_value_name_int(0, "pID", id_player);
        if (type == 0)
        {
	        mysql_format(dbHandle, query, sizeof query, "SELECT * FROM `sh_ban` WHERE `pID` = '%d'", id_player);
			mysql_tquery(dbHandle, query, "LoadHistoryNameList", "dsd", playerid,nick, type);
		}
		else if (type == 1)
		{
		    mysql_format(dbHandle, query, sizeof query, "SELECT * FROM `sh_warn` WHERE `pID` = '%d'", id_player);
			mysql_tquery(dbHandle, query, "LoadHistoryNameList", "dsd", playerid,nick, type);
		}
		else if (type == 2)
		{
	        mysql_format(dbHandle, query, sizeof query, "SELECT * FROM `sh_login` WHERE `pID` = '%d' ORDER BY `Data` DESC LIMIT 0, 15", id_player);
			mysql_tquery(dbHandle, query, "LoadHistoryNameList", "dsd", playerid, nick, type);
		}
        else if (type == 3)
		{
	        mysql_format(dbHandle, query, sizeof query, "SELECT * FROM `sh_connect` WHERE `pID` = '%d' ORDER BY `Data` DESC LIMIT 0, 15", id_player);
			mysql_tquery(dbHandle, query, "LoadHistoryNameList", "dsd", playerid, nick, type);
		}
	}
	return 1;
}
publics: LoadHistoryNameList(playerid, nick[], type)
{
	new rows;
	cache_get_row_count(rows);
	new string_[128],
		NameAdm[MAX_PLAYER_NAME],
		BanDate[32],
		Reason[64],
		SetIP[16],
		SetLogin[MAX_PLAYER_NAME],
		SetOldLogin[MAX_PLAYER_NAME];
    t_string[0] = EOS ;
	if (type == 0)
	{
	    if (!rows)
	        return SendClientMessage(playerid, COLOR_GREY, !"У игрока нет банов!");
		strcat(t_string, ""colserver"[№] Дата блокировки\tПричина\tЗаблокировал\n");
		for(new idx; idx != rows; idx++)
		{
		    cache_get_value_name(idx, "Text", Reason, 64);
			cache_get_value_name(idx, "Date", BanDate, 32);
			cache_get_value_name(idx, "NameAdmin", NameAdm, MAX_PLAYER_NAME);
			format(string_, sizeof string_, ""colwhi"[%d] %s\t%s\t%s\n", idx, BanDate, Reason, NameAdm);
			strcat(t_string, string_);
		}
		ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"История блокировок", t_string, "Закрыть","");
	}
	else if (type == 1)
	{
	    if (!rows)
	        return SendClientMessage(playerid, COLOR_GREY, !"У игрока нет варнов!");
	    strcat(t_string, ""colserver"[№] Дата предупреждения\t"colserver"Причина\t"colserver"Выдал предупреждение\n");
		for(new idx; idx != rows; idx++)
		{
		    cache_get_value_name(idx, "Text", Reason, 64);
			cache_get_value_name(idx, "Date", BanDate, 32);
			cache_get_value_name(idx, "NameAdmin", NameAdm, MAX_PLAYER_NAME);
			format(string_, sizeof string_, ""colwhi"[%d] %s\t%s\t%s\n", idx, BanDate, Reason, NameAdm);
			strcat(t_string, string_);
		}
		ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"История предупреждений", t_string, "Закрыть","");
	}
	else if (type == 2)
	{
	    if (!rows)
	        return SendClientMessage(playerid, COLOR_GREY, !"Никнейм не менялся!");
	    strcat(t_string, ""colserver"[№] Старый Никнейм\t"colserver"Новый Никнейм\t"colserver"Дата смены\n");
		for(new idx; idx != rows; idx++)
		{
		    cache_get_value_name(idx, "PlayerName", SetLogin, MAX_PLAYER_NAME);
		    cache_get_value_name(idx, "OldName", SetOldLogin, MAX_PLAYER_NAME);
			cache_get_value_name(idx, "Data", BanDate, 32);
			format(string_, sizeof string_, ""colwhi"[%d] %s\t%s\t%s\n", idx, SetOldLogin, SetLogin, BanDate);
			strcat(t_string, string_);
		}
		new f_nickname[50];
		format(f_nickname, sizeof f_nickname, ""colserver"Текущий никнейм: "colwhi"%s",nick);
		ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, f_nickname, t_string, "Закрыть","");
	}
	else if (type == 3)
	{
	    if (!rows) return SendClientMessage(playerid, COLOR_GREY, !"История не найдена");
	    strcat(t_string, ""colserver"[№] Никнейм\t"colserver"IP\t"colserver"Дата авторизации\n");
		for(new idx; idx != rows; idx++)
		{
		    cache_get_value_name(idx, "PlayerName", SetLogin, MAX_PLAYER_NAME);
		    cache_get_value_name(idx, "PlayerIP", SetIP, MAX_PLAYER_NAME);
			cache_get_value_name(idx, "Data", BanDate, 32);
			format(string_, sizeof string_, ""colwhi"[%d] %s\t%s\t%s\n", idx, SetLogin, SetIP, BanDate);
			strcat(t_string, string_);
		}
		ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"История авторизации", t_string, "Закрыть","");
	}
	return 1;
}

ShowEconomyFraction(playerid)
{
	new 
		string_[256],
		str_[32],
		fraction_id = pInfo[playerid][pMember];
	t_string[0] = EOS;
	if (FractionInfo[fraction_id][fCDPrize] > gettime()) {
		format(str_, sizeof str_, "Через: "collime"%s", Convert(FractionInfo[pInfo[playerid][pMember]][fCDPrize] - gettime()) );
	} 
	else str_ = ""collime"Доступно";
	strcat(t_string, ""colserver"[№] Описание\t"colserver"Информация\n"); 
	strcat(t_string, ""colwhi"[0] Положить на счет организации\n[1] Снять со счета организации\n[2] Управление зарплатами");

	if (IsAMayor(playerid)) {
		new Cache:_result = mysql_query(dbHandle, "SELECT * FROM s_economy_mayor COUNT");
		new count_sender = cache_num_rows();
		if (cache_is_valid(_result)) cache_delete(_result);
		format(string_, sizeof string_, 
			"\n[3] Заявки на бюджет организаций\t["colwarn"Заявок: %d"colwhi"]\n\
			"colwhi"[4] Выдать премии\t%s\n\
			"colwhi"[5] Установить налог:\t"collime"$%d\n\
			"colwhi"[6] Установить налог на транспорт:\t"collime"$%d\n\
			"colwhi"[7] Управление пенсией:\tПенсия: "collime"$%d", 
			count_sender, str_, FractionInfo[fraction_id][fTaxState], fInfo[fraction_id][fCost][0], GetEconomyServer(ePension)
		); 
	}
	else if (pInfo[playerid][pMember] == FRACTION_LSPD) {
		format(string_, sizeof string_, 
			"\n[3] Запросить деньги у Мэрии\tБюджет: "collime"$%s\n\
			"colwhi"[4] Выдать премии\t%s\n\
			[5] Цена за сутки на штрафстоянке\t"collime"$%d", 
			convert_money(FractionInfo[fraction_id][fMoney]) , str_, fInfo[FRACTION_LSPD][fCost][0]
		);
	}
	else 
	{ 
		format(string_, sizeof string_, "\n[3] Запросить деньги у Мэрии\tБюджет: "collime"$%s\n\
			"colwhi"[4] Выдать премии\t%s", convert_money(FractionInfo[fraction_id][fMoney]), str_);
	} 
	strcat(t_string, string_);
	ShowPlayerDialog(playerid, D_FRACTION_FUNC_33, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Управление бюджетом", t_string, "Выбрать", "Закрыть");
	return 1;
}
stock ShowSenderFraction(playerid) 
{
	new query_[128]; 
	new 
		rows, 
		idx, 
		Cache:tempQuery = mysql_query(dbHandle, "SELECT id, eReason, eMoney,eFrac,eOwner FROM `s_economy_mayor` ORDER BY `id`");

	query_[0] = EOS;
	cache_get_row_count(rows);
	if (!rows) {
		SendClientMessage(playerid, COLOR_GREY, !"Запросов не найдено");
		if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
		return true;
	}
	format(t_string, sizeof (t_string), ""colserver"[№] Организация(Отправитель)\t"colserver"Финансирование\t"colserver"Сумма\n");

	for (new i = 0, reason[32 + 1], id, money, sender[MAX_PLAYER_NAME], frac; i < rows; i++) {
		cache_get_value_name_int(i, "id", id);
		cache_get_value_name(i, "eReason", reason, sizeof (reason));
		cache_get_value_name_int(i, "eMoney", money);
		cache_get_value_name_int(i, "eFrac", frac);
		cache_get_value_name(i, "eOwner", sender);
		//printf("ShowSuspectList: i %d id = %d", i, id);
		playerListItem[playerid][idx] = id;
		format(t_string, sizeof (t_string), "%s"colwhi"[%d] %s(%s)\t%s\t"collime"%d $\n", 
			t_string, idx++, gFraction[frac][fName], sender, reason, money
		);
	} 
	ShowPlayerDialog(playerid, D_FRACTION_FUNC_38, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Казна: "colwhi"Заявки на бюджет", t_string, "Выбрать", "Отмена");
	t_string[0] = EOS;
	if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
	return true;
}
stock GetPlayerFractionMoney(playerid)
{
	new _veh_count = 0,
		query_[78];
	format(query_, sizeof query_,"SELECT * FROM s_economy_mayor WHERE eFrac = '%d'", pInfo[playerid][pMember]);
	new Cache: result = mysql_query(dbHandle, query_);
	_veh_count = cache_num_rows( );
	if (cache_is_valid(result)) cache_delete(result);
	return _veh_count;
}
