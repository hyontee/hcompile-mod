stock GetPlayerNearestVehicle(playerid)
{
    if (IsPlayerInAnyVehicle(playerid)) return GetPlayerVehicleID(playerid);
	new closest_vehicle = INVALID_VEHICLE_ID;
	new	
		Float: pos_x,
		Float: pos_y, 
		Float: pos_z;
	GetPlayerPos(playerid, pos_x, pos_y, pos_z);
	foreach(new i:StreamedVehicles[playerid])
	{
		if (!IsValidVehicle(i)) continue;
		if (GetVehicleDistanceFromPoint ( i, pos_x, pos_y, pos_z) > 4 ) continue;
		if (closest_vehicle == INVALID_VEHICLE_ID)
		{
			closest_vehicle = i;
			continue ;
		}
		if (GetVehicleDistanceFromPoint (i, pos_x, pos_y, pos_z) < GetVehicleDistanceFromPoint(closest_vehicle, pos_x, pos_y, pos_z))
        {
            closest_vehicle = i;
        }
    }
    return closest_vehicle;
}


stock ConvertTimeAFK(playerid, result_str[],length,size = sizeof(result_str))
{
    result_str[0] = '\0';
    if (length > size) {
        length = size - 1;
    }
    if (length < 1) {
        return 0;
    }
    new seconds = pTemp[playerid][PlayerAFK],
		minutes,
		sec;
    if (seconds > 59){
        minutes = seconds/60;
        sec = (seconds - (minutes*60));
        format(result_str, 10, "%d:%02d]", minutes, sec);
    }
    else{
        format(result_str, 9, "%d сек]", seconds);
    }
    strins(result_str, "[На паузе: ", 0,10);
    return 1;
}

publics: Fresh()
{
   	new 
	   	tickcount1 = GetTickCount();
    if (GrandEndOK > 0) {
	    printf("[TIMER DEBUG] Упал таймер Fresh. Этап: %d", GrandEndOK);
	}
    GrandEndOK = 1;
	gettime(hour, minute, second);
	TickRateUpdate3DTextServer();
	LoadingTrucker();

	SetTimer("ChangeServerName", 1000, true);

	GrandEndOK = 2;
	#if defined _casino_included
		casino_Timer();
	#endif
	GrandEndOK = 3;
	#if defined _poker_included
		poker_Timer();
	#endif
	GrandEndOK = 4;
	#if defined _blackjack_included
		blackjack_Timer();
	#endif
	GrandEndOK = 5;
	#if defined _capture_stats_inc
		CaptureStatsTimer(); 
	#endif
	GrandEndOK = 6;
	if (++SettingGlobalServer > 1200)//Каждые 20 минут
	{
	    printf("Последнее время прокрутки Fresh: %d мс. пик: %d мс.\n", SettingServer[2], SettingServer[3]);
	 	SettingGlobalServer = 0;
	} 
	GetMoney();
	md_Timer();
	GrandEndOK = 7;
	#if defined _voting_inc
		OnVotingTimer();
	#endif
	GrandEndOK = 8;
	#if defined _hospital_inc
		OnHospitalTimer();
	#endif
	GrandEndOK = 9;
	dicetable_Timer(); 
	GrandEndOK = 10;
 	foreach(new i: Player)
	{
		if (!pInfo[i][pLogin]) {
			if (pTemp[i][tWelcomeTimer] != -1){
				pTemp[i][tWelcomeTimer] ++;
				if(pTemp[i][tWelcomeTimer] == 15){hide_welcome_interface(i);}
			}			
     		if (pTemp[i][tTimeLogin] > 0) {
       			pTemp[i][tTimeLogin] --; 
         		if (pTemp[i][tTimeLogin] == 0)
          		{ 
           			SendClientMessage(i, COLOR_LIGHTRED, !"Время на ввод пароля ограничено!"); 
              		Kick(i);
					continue;
				}
           	}
	    }
		else
		{
			if ( pTemp [ i ] [ tIgnorePick ] != 0 )
				pTemp [ i ] [ tIgnorePick ] --;
				
			if (++pTemp[i][PlayerAFK] >= 3) { 
				new 
					afk_str_time[26];
			    ConvertTimeAFK(i, afk_str_time, sizeof(afk_str_time)-1);
		        SetPlayerChatBubble(i, afk_str_time, COLOR_GREEN, 30.0, 1100); 
				gOnlinePlayerAFK[i][0]++; 
			}
			else {
			    pTemp[i][TimeNoAFK]++;
				pTemp[i][gTimeNoAFK]++;
				gOnlinePlayer[i][0]++; 
			}//pInfo[playerid][gStars]
			
			if (pTemp[i][gTimeNoAFK] >= 10800) {
				pTemp[i][gTimeNoAFK] = 0;
				GiveFreeRoulette(i);
			}

			GrandEndOK = 11;
			#if defined _casino_included
				casino_PlayerTimer(i);
			#endif
			GrandEndOK = 12;
			Family_PlayerTime(i);
			GrandEndOK = 13;
			if (pTemp[i][tBoomboxArea] && !IsPlayerInDynamicArea(i, pTemp[i][tBoomboxArea] - 1)) {
				DestroyBoombox(i);
			}
			GrandEndOK = 14;
			if (pInfo[i][PlayerSettings] & setShowUseKeys)
			{
				if (pInfo[i][pCash] > 3_000_000 && GetPlayerWeapon(i) == 0 && pTemp[i][tTakeDrugsType] == 0 && GetPlayerState(i) == PLAYER_STATE_ONFOOT && pInfo[i][pLogin] == 1) {
					SetPlayerAttachedObject(i, ATTACHED_SLOT_JOB_2, 1210, 5, 0.299999, 0.099999, 0.000000, 0.000000, -83.000000, 0.000000, 1.000000, 1.000000, 1.000000);
				}
				else {
					if (IsPlayerAttachedObjectSlotUsed(i, ATTACHED_SLOT_JOB_2)) RemovePlayerAttachedObject(i, ATTACHED_SLOT_JOB_2);
				}
			} 
			GrandEndOK = 15;
			if (++pTemp[i][tPlayerUpdate] > 300) {
				pTemp[i][tPlayerUpdate] = 0;
				SavePlayerID(i); 
			}
			GrandEndOK = 15;
			if (++pTemp[i][tPlayerGiveStars] > 10800) {
				pTemp[i][tPlayerGiveStars] = 0;
				pInfo[i][gStars]++;
				ChristmasInfo[i][cGift]++;
				SavePlayerCristmasInteger(i, "cGift", ChristmasInfo[i][cGift]);
				SavePlayerInteger(i, "gStars", pInfo[i][gStars]);
				SendClientMessage(i, COLOR_YELLOW, !"[Подсказка] "colwhi"Вы отыграли 3 часа подряд вы получили звезду!"); 
				SendClientMessage(i, COLOR_YELLOW, !"[Подсказка] "colwhi"Обменять звезды можно в Палатке Мики на центральном рынке"); 
			}
			GrandEndOK = 16;
			if (pInfo[i][FullSatiety] == 0) { 
				if (++pTemp[i][tSatietyUpdate] > 15)
				{  
					pTemp[i][tSatietyUpdate] = 0;
					pInfo[i][Satiety] -= 1.0;
					if (pInfo[i][Satiety] < 50) SetPlayerHealth(i, GetPlayerHP(i) - 1.0); 

					if (pInfo[i][PlayerSettings] & setShowEatBar) {
						SetPlayerProgressBarValue(i, EatBar[i], pInfo[i][Satiety]);
					}
					if (pInfo[i][Satiety] <= 0) {
						pInfo[i][Satiety] = 0;
					}
					if (pInfo[i][Satiety] == 24 || pInfo[i][Satiety] == 49) {
						SendClientMessage(i, COLOR_ISPOLZUY, !"Вы проголодались! Посетите бар, закусочную или купите ХотДог. Узнать свою «Сытость» можно командой /satiety");
					}
				}
			}
			GrandEndOK = 17;
			if(GetPlayerDrunkLevel(i) > 0)
			{
				SetPVarInt(i, "DrunkTime", GetPVarInt(i, "DrunkTime") + 1);
				if(GetPVarInt(i, "DrunkTime") >= 100)
				{
					SetPlayerDrunkLevel(i, GetPlayerDrunkLevel(i) - 1000);
					SetPVarInt(i, "DrunkTime", 0);
				}
			}
			GrandEndOK = 18;
			if (GetPVarInt(i,"TimerCountWoods") != 0) {
				SetPVarInt(i,"TimerCountWoods", GetPVarInt(i,"TimerCountWoods") - 1);
				new 
					string[32];
				format(string, sizeof string, "~r~RETURN: %d SEC", GetPVarInt(i,"TimerCountWoods"));
				GameTextForPlayer(i, string, 1000, 6);
				pTemp[i][tArmyJob] = 0;
				if (GetPVarInt(i,"TimerCountWoods") == 0) { 
					if (pTemp[i][tArmyDuty] == 1) {
						SendClientMessage(i,COLOR_GREY, !"Ваше дежурство в карауле окончено!");
						pTemp[i][tArmyDuty] = 0; 
						pTemp[i][tArmyJob] = 0;
					}
				}
			}
			GrandEndOK = 19;
			if (GetPVarInt(i,"TimerCountHunter") != 0) {
				SetPVarInt(i,"TimerCountHunter", GetPVarInt(i,"TimerCountHunter") - 1);
				new 
					string[32];
				format(string, sizeof string, "~r~RETURN: %d SEC", GetPVarInt(i,"TimerCountHunter"));
				GameTextForPlayer(i, string, 1000, 6); 
				if (GetPVarInt(i,"TimerCountHunter") == 0) { 
					if (pTemp[i][tJobHunter] == true) { 
						LeaveJobPlayer(i, .text = true);
					}
				}
			} 
			GrandEndOK = 20;
			if (pTemp[i][tArmyDuty] == 1 && pTemp[i][PlayerAFK] <= 2) {
				pTemp[i][tArmyJob]++;
				if (pTemp[i][tArmyJob] == 60) { 
					GameTextForPlayer(i, !"Army Job ~g~+$100", 5000, 1);
					kLibGivePlayerMoney(i, 100, "Караул", .save = false);
					SetMoveCashServer(IN_SERVER, 100);
					OnPlayerAchievProgress(i, 21);
					pTemp[i][tArmyJob] = 0;
				}
			}
			if (pInfo[i][pDepInTime] > 0) {
				pInfo[i][pDepInTime] --; 
			}
			if (pInfo[i][pDepPutTime] > 0) {
				pInfo[i][pDepPutTime] --; 
			}
			if (pInfo[i][pDepCashBack] > 0 && pInfo[i][pDeposit] >= 10_000) {
				pInfo[i][pDepCashBack] --;  
				if (pInfo[i][pDepCashBack] == 0) {
					new 
						str_[100],
						deposit_old = floatround(pInfo[i][pDeposit]/100*DepCurrentCommission[ pInfo[i][VIPRank] ]),
						deposit = floatround(pInfo[i][pDeposit]/100*DepCurrentCommission[ pInfo[i][VIPRank] ]) + pInfo[i][pDeposit],
						dep_limit = 100_000_000;  
					pInfo[i][pDeposit] = deposit; 
					switch(pInfo[i][VIPRank]) {
						case VIP_PACK_NONE .. VIP_PACK_BRONZE: dep_limit = 100_000_000;
						case VIP_PACK_SILVER .. VIP_PACK_GOLD: dep_limit = 150_000_000;
						case VIP_PACK_PLATINUM .. VIP_PACK_DIAMOND: dep_limit = 200_000_000;
					}
				//	UPDATE s_users SET pDeposit = '100000000' WHERE pDeposit > '100000000' AND AND pLogin = '0'
					if (pInfo[i][pDeposit] >= dep_limit){
						
						pInfo[i][pDeposit] = dep_limit;
						format(str_, sizeof str_, "[Выписка из банка] "colwhi"Ваш счет депозита, достинг лимита в "collime"$%d", dep_limit);
						SendClientMessage(i, 0x6495EDFF, str_);
						SendClientMessage(i, 0x6495EDFF, "[Выписка из банка] "colwhi"Снимите средства со счета!");
					} 
					format(str_, sizeof str_, "[Выписка из банка] "colwhi"Пополнение депозита на "collime"$%d! Депозит: "collime"$%d", deposit_old, pInfo[i][pDeposit]);
					SendClientMessage(i, 0x6495EDFF, str_); 
					pInfo[i][pDepCashBack] = 3600;
				}
			} 
			GrandEndOK = 21;
			if(gFollowInfo[i][gtID] != INVALID_PLAYER_ID) {
				new cuffed = gFollowInfo[i][gtID];
				if(!PlayerInConnected(cuffed)) {
					gFollowInfo[i][gtID] = INVALID_PLAYER_ID;
					gFollowInfo[i][gtTPX] = 0.0;
