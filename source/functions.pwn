        }
        case 15:
        {
        	strcat(t_string,"<< Законопослушность >>\n\n");
         	strcat(t_string,"У каждого игрока есть индикатор, который показывает как вы относитесь к закону.\n");
          	strcat(t_string,"-100 и +100 Минимум и максимум. Узнать можно заглянув в ваш пасспорт \"/showpass [ид]\"\n");
           	strcat(t_string,"С плохим отношением к закону вас могут не принять во многии Фракции, но в банду\n");
           	strcat(t_string,"попасть легче.\n\n");
            strcat(t_string,"Законопослушность повышается каждый час на 1, однако может резко упасть если\n");
            strcat(t_string,"совершите преступление");
            return ShowPlayerDialog(playerid, D_PLAYER_HELP, 0,"Законопослушность",t_string,"Далее","Меню");
        }
        case 16:
        {
        	strcat(t_string,"<< Дома >>\n\n");
         	strcat(t_string,"Вы можете в любой момент купить себе дом, тогда при смерти или входе в игру\n");
            strcat(t_string,"вы будете появляться там. По мимо этого у вас появиться место для парковки машины,\n");
            strcat(t_string,"а значит вы можете купить себе красивое авто.\n");
            strcat(t_string,"Дома поделенны по классам - [Nope] [D] [C] [B] [A] [S]. Класс говорит о цене и красоте\n");
            strcat(t_string,"дома как внутри, так и снаружи.");
            return ShowPlayerDialog(playerid, D_PLAYER_HELP, 0,"Дома",t_string,"Далее","Меню");
        }
        case 17:
        {
            strcat(t_string,"После покупки дома с вашего банковского счета будут сниматься Кварплата, она зависит от класса дома.\n");
            strcat(t_string,"Важное примечание! Деньги снимаются каждый час даже когда вы оффлайн.\n\n");
            strcat(t_string,"<< Личный транспорт >>\n\n");
            strcat(t_string,"У нас есть несколько Автосалонов, где вы можете приобрести себе машину. Все они\n");
            strcat(t_string,"указаны в \"/GPS\". Транспорт как и дома разделены по классам.\n");
        	strcat(t_string,"Чтобы выбрать себе машину, воспользуйтесь командой \"/Buycar\". Далее вы\n");
        	strcat(t_string,"увидете подсказку по клавишам с правой стороны, а снизу цену и цвет.");
            return ShowPlayerDialog(playerid, D_PLAYER_HELP, 0,"Дома часть 2",t_string,"Далее","Меню");
		}
	}
	return 1;
}
publics: Farmduty(playerid)
{
	new
		string_[64],
		V_IDX = GetPlayerVehicleID(playerid);
    DisablePlayerRaceCheckpoint(playerid);
    SetVehicleParamsEx(V_IDX, false, false, false, false, false, false, false);
	SetVehicleVelocity(V_IDX, 0.0, 0.0, 0.0);
	new
		Float: veh_pos[4];
	GetVehiclePos(V_IDX, veh_pos[0], veh_pos[1], veh_pos[2]);
	GetVehicleZAngle(V_IDX,veh_pos[3]);

	GetXYInBackOfPlayer(playerid, veh_pos[0], veh_pos[1],3.0);

	Farmcar_pickup[V_IDX] = CreateDynamicPickup(19197, 23, veh_pos[0], veh_pos[1], veh_pos[2]+0.3);
	DeletePVar(playerid,"farm_status");

	format(string_, sizeof string_, "Загружено\n{ffffff}%d / 1000", Farmcar_prods[V_IDX]); 
	if (VehicleInfo[ V_IDX - 1 ][vFarmText] == Text3D:-1) { 
		VehicleInfo[ V_IDX - 1 ][vFarmText] = CreateDynamic3DTextLabel(string_, 0x5CABBDFF, veh_pos[0], veh_pos[1], veh_pos[2]+0.6, 15.0);//, INVALID_PLAYER_ID, V_IDX);
	}  
	VehicleInfo[ V_IDX - 1 ][vJobLoad] = true;
	RemovePlayerFromVehicle(playerid);
	TogglePlayerControllable(playerid, 1);
	return 1;
}
publics: Farm_Duty(playerid)
{
	TogglePlayerControllable(playerid, 1);
	ClearAnim(playerid);
	KillTimer(Farmtimer[playerid]);
	DisablePlayerCheckpoint(playerid);
	DeletePVar(playerid,"farm_status");
	if (!IsPlayerInRangeOfPoint(playerid,2.0, Farm_coord[playerid][0], Farm_coord[playerid][1], Farm_coord[playerid][2])) 
		return SendClientMessage(playerid,COLOR_RED,"Вы должны находиться на красной метке");
    new
		FARM_ID = pTemp[playerid][TempFermID];
	if (!FarmInfo[FARM_ID][fGrain_Sown]) return SendClientMessage(playerid,COLOR_RED,"На поле недостаточно урожая");
	if (FarmInfo[FARM_ID][fBank] < FarmInfo[FARM_ID][fZp]) return SendClientMessage(playerid,COLOR_RED,"На балансе фермы недостаточно средств");
	SetPVarInt(playerid,"farm_status",2);
	SetPlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_0, 856, 6, 0.086999, 0.036999, 0.000000, 0.000000, 0.000000, 0.000000, 0.010999, 0.009000, 0.085999);
	FarmInfo[FARM_ID][fGrain_Sown]--;
	return 1;
}
 
stock SetPlayerCriminal(playerid, const killerid[], const reason[])
{
	new string_[145], query_[128];
	pInfo[playerid][pCrimes] ++;
	strmid(PlayerCrime[playerid][pVictim], killerid, 0, strlen(killerid), 50);
	strmid(PlayerCrime[playerid][pAccusedof], reason, 0, strlen(reason), 50);
	if (pInfo[playerid][pWantedLevel] > 6) pInfo[playerid][pWantedLevel] = 6;
	format(string_, sizeof string_, "Вы совершили преступление: [%s]. Сообщает: %s.",reason, killerid);
	SendClientMessage(playerid,COLOR_LIGHTRED, string_);
	format(string_, sizeof string_, "Ваш уровень розыска: %d", pInfo[playerid][pWantedLevel]);
	SendClientMessage(playerid,COLOR_YELLOW, string_);
	foreach(new i: PlayerInLogin)
	{
		if (!pInfo[i][pLogin]) continue;
		if (pInfo[i][pMember] == 1 || pInfo[i][pMember] == 10 || pInfo[i][pMember] == 2 || pInfo[i][pMember] == 21)
		{
			format(string_, sizeof string_, "Рация: Cообщает: %s. Преступление: %s. Подозреваемый: %s. Розыскиваемость: %d",killerid,reason,pInfo[playerid][pName],pInfo[playerid][pWantedLevel]);
			SendClientMessage(i, 0xFEBC41AA, string_);
		}
	}
	format(query_, sizeof(query_), "UPDATE `s_users` SET `pCrimes` = '%d' WHERE `pID` = '%d'", pInfo[playerid][pCrimes], pInfo[playerid][pID]);
	mysql_tquery(dbHandle, query_, "", "");
	return 1;
}

stock GetCasino(playerid, idx)
{
	if (strcmp(pInfo[playerid][pName],CasinoInfo[idx][caManager],true) == 0 
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caManager2],true) == 0
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caManager3],true) == 0) return 2;
    if (strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie],true) == 0 
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie2],true) == 0 
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie3],true) == 0
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie4],true) == 0 
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie5],true) == 0 
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie6],true) == 0 
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie7],true) == 0
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie8],true) == 0 
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie9],true) == 0 
		|| strcmp(pInfo[playerid][pName],CasinoInfo[idx][caKrupie10],true) == 0) return 1;
    return 0;
}


