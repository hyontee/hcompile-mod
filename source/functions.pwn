	/*if (pInfo[playerid][pMember] == 5 || pInfo[playerid][pMember] == 6 || pInfo[playerid][pMember] == 12
	|| pInfo[playerid][pMember] == 13 || pInfo[playerid][pMember] == 14|| pInfo[playerid][pMember] == 15
