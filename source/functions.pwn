			pTemp[playerid][tTimeAddiction] = (gettime()+60);
		}
		else {
			pTemp[playerid][tTimeAddiction] = (gettime()+2400);
		}
		cache_get_value_name_int(0, "pHospital", pInfo[playerid][pHospital]);
