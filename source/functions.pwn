stock GetNearestVehicle(playerid)
{
	new Float:X,
		Float:Y,
		Float:Z;
	for(new veh = 1; veh < MAX_VEHICLES; veh++)
	{
		if (GetVehicleModel(veh))
		{ 
			if (GetVehicleVirtualWorld(veh) != GetPlayerVirtualWorld(playerid)) continue;
			GetVehiclePos(veh, X, Y,Z);
			if (IsPlayerInRangeOfPoint(playerid, 3.5, X, Y, Z)) return veh;
		}
	}
	return -1;
} 

stock ShowTextDrawCapture(playerid, index)
{
    for(new i = 0; i < sizeof (CaptureTD[]); i++)
        TextDrawShowForPlayer(playerid, CaptureTD[index][i]); 
    return 1;
}
stock HideTextDrawCapture(playerid,index)
{
    for(new i = 0; i < sizeof (CaptureTD[]); i++)
        TextDrawHideForPlayer(playerid, CaptureTD[index][i]); 
    return 1;
}

stock UpdateSeconds(i)
{
	new str[64];
	{
		new str_time[32];
		Convert_GZ(GZInfo[i][gCaptureTime],str_time);
		
		new index = GZInfo[i][gTD];

		format(str,sizeof(str),"%s",str_time);
		TextDrawSetString(CaptureTD[index][3], str);
	}
    
    return 1;
}

stock UpdateKillsCapture(i)
{
    new index = GZInfo[i][gTD];
    new m1,m2,sr[12];
    m1 = GZInfo[i][gNapad];
    m2 = GZInfo[i][gFrakVlad];

    format(sr, sizeof(sr), "%d",capture_kills[capture_band(m1)]);
    TextDrawSetString(CaptureTD[index][9], sr);

    format(sr, sizeof(sr), "%d",capture_kills[capture_band(m2)]);
    TextDrawSetString(CaptureTD[index][10], sr);
	
    return 1;
}
Convert_GZ(number, const str[])
{
    new mins = 0, secs = 0;
    mins = floatround((number / 60));
    secs = floatround(number - (mins * 60));
    format(str, 32, "%02d:%02d", mins, secs);
}
//
new	Text: ActionGame_TD[7]; 
stock LeaveRobHouse(playerid) {
	if(rob_veh[playerid] != INVALID_VEHICLE_ID) {
		A_DestroyVehicle(rob_veh[playerid]);
		rob_veh[playerid] = INVALID_VEHICLE_ID;
	}
	if(IsValidDynamicPickup(RobPlayer[playerid][RobPickup])) {
		DestroyDynamicPickup(RobPlayer[playerid][RobPickup]);
		DestroyDynamicArea(RobPlayer[playerid][RobArea]);
		DestroyDynamic3DTextLabel(RobPlayer[playerid][RobText]);
	}
}

stock ActionMiniGamePlayer(playerid, bool:status)
{
	if (status)
	{
		//SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Для выхода используйте клавишу "colserver"\"F\"");
		TogglePlayerControllable(playerid, false); 
		for (new i = 0; i < sizeof (ActionGame_TD); i++) 
			TextDrawShowForPlayer(playerid, ActionGame_TD[i]);
		action_ptd[playerid][1]  = CreatePlayerTextDraw(playerid, 229.999938, 371.011047, "PRESS:_Y");
		PlayerTextDrawLetterSize(playerid, action_ptd[playerid][1] , 0.202915, 0.894814);
		PlayerTextDrawTextSize(playerid, action_ptd[playerid][1] , 423.000000, 0.000000);
		PlayerTextDrawAlignment(playerid, action_ptd[playerid][1] , 1);
		PlayerTextDrawColor(playerid, action_ptd[playerid][1] , -1);
		PlayerTextDrawSetShadow(playerid, action_ptd[playerid][1] , 0);
		PlayerTextDrawSetOutline(playerid, action_ptd[playerid][1] , 1);
		PlayerTextDrawBackgroundColor(playerid, action_ptd[playerid][1] , 255);
		PlayerTextDrawFont(playerid, action_ptd[playerid][1] , 1);
		PlayerTextDrawSetProportional(playerid, action_ptd[playerid][1] , 1);
		switch ( random ( 5 ) )
		{
			case 0 .. 2:pTemp[playerid][tActionKey] = KEY_YES, PlayerTextDrawSetString ( playerid, action_ptd [ playerid ] [ 1 ], "PRESS:_Y" ) ;
			case 3 .. 5:pTemp[playerid][tActionKey] = KEY_NO, PlayerTextDrawSetString ( playerid, action_ptd [ playerid ] [ 1 ], "PRESS:_N" ) ;
		}
		//SendMes(playerid, -1, "action_key: %d", pTemp[playerid][tActionKey]);
		action_ptd[playerid][2] = CreatePlayerTextDraw(playerid, 242.300125, 384.951919, "LD_SPAC:white");
		PlayerTextDrawTextSize(playerid, action_ptd[playerid][2], 0.000000, 16.000000);
		PlayerTextDrawAlignment(playerid, action_ptd[playerid][2], 1);
		PlayerTextDrawColor(playerid, action_ptd[playerid][2], 255);
		PlayerTextDrawSetShadow(playerid, action_ptd[playerid][2], 0);
		PlayerTextDrawBackgroundColor(playerid, action_ptd[playerid][2], 255);
		PlayerTextDrawFont(playerid, action_ptd[playerid][2], 4);
		PlayerTextDrawSetProportional(playerid, action_ptd[playerid][2], 0);

		action_ptd[playerid][0] = CreatePlayerTextDraw(playerid, 319.583343, 387.298614, "_");
		PlayerTextDrawLetterSize(playerid, action_ptd[playerid][0], 0.195500, 1.161481);
		PlayerTextDrawAlignment(playerid, action_ptd[playerid][0], 2);
		PlayerTextDrawColor(playerid, action_ptd[playerid][0], -1);
		PlayerTextDrawSetShadow(playerid, action_ptd[playerid][0], 0);
		PlayerTextDrawSetOutline(playerid, action_ptd[playerid][0], 1);
		PlayerTextDrawBackgroundColor(playerid, action_ptd[playerid][0], 255);
		PlayerTextDrawFont(playerid, action_ptd[playerid][0], 2);
		PlayerTextDrawSetProportional(playerid, action_ptd[playerid][0], 1);
		for ( new i = 0 ; i < 3 ; i ++ ) {
			PlayerTextDrawShow ( playerid, action_ptd [ playerid ] [ i ] ) ;
		}  
		TextDrawHideForPlayer(playerid, ActionGame_TD[6]); 
	}
	else
	{
		TogglePlayerControllable(playerid, true);
		for (new i = 0; i < sizeof (ActionGame_TD); i++) 
			TextDrawHideForPlayer(playerid, ActionGame_TD[i]);
		for (new i = 0; i < 3; i++) {
			PlayerTextDrawDestroy(playerid, action_ptd[playerid][i]);
			action_ptd[playerid][i] = PlayerText:-1; 
		}
		pTemp[playerid][tActionType] = 0 ;
		pTemp[playerid][tActionStep] = 0 ;
		pTemp[playerid][tActionKey] = 0;
	}
	return 1 ;
}  
stock SetActionGameProgressBar(playerid, fuel, bool:random_key = true) { 
	if (fuel <= 0)  {
		fuel = 0/* + 1*/;
		//Проиграл
	} 
	else if (fuel > 10) {
		fuel = 10;
	}

	pTemp[playerid][tActionStep] = fuel;
	//SendMes(playerid, -1, "%d", pTemp[playerid][tActionStep]); 
	switch (pTemp[playerid][tActionType])
	{
		case ACTION_ROB_HOUSE: {   
			ApplyAnimation(playerid,"BD_FIRE","wash_up",4.1,1,0,0,1,1, 1);
		}
		case ACTION_TAKE_ATM_CASH, ACTION_HUNTER_DEER: {
			ApplyAnimation( playerid, "BOMBER", "BOM_Plant_Crouch_In", 4.1, 0, 1, 1, 1, 0 );
		}
		case ACTION_FACTORY_SORT: {
			ApplyAnimation(playerid, "CASINO", "Slot_Plyr", 4.1, 0, 0, 0, 0, 0, 1);
		}
	}
	if (random_key) {
		switch ( random ( 5 ) )
		{
			case 0 .. 2: pTemp[playerid][tActionKey] = KEY_YES, PlayerTextDrawSetString(playerid, action_ptd[playerid][1], "PRESS:_Y");
			case 3 .. 5: pTemp[playerid][tActionKey] = KEY_NO, PlayerTextDrawSetString(playerid, action_ptd[playerid][1], "PRESS:_N");
		}
	}
	/*else {

	}*/
	 
	new Float: progress = pTemp[playerid][tActionStep] * (2.5 * 1.652);
	if (progress > 95.0) 
		TextDrawShowForPlayer(playerid, ActionGame_TD[6]);
	else TextDrawHideForPlayer(playerid, ActionGame_TD[6]);
	
	progress *= (2.5 * 1.652); // (>95%)
	if (progress > 157.0) progress = 157.0; 
	PlayerTextDrawTextSize(playerid, action_ptd[playerid][2], progress, 16.000000);
	PlayerTextDrawShow(playerid, action_ptd[playerid][2]);  
	return true;
} 

