stock UpdateHouseSafe(idx)
{
	new query_[164];
	format(query_, sizeof query_, "UPDATE `house` SET `hSafe` = '%d,%d,%d,%d', `hSafeGun` = '%d,%d,%d,%d,%d,%d', `hSafeAmmo` = '%d,%d,%d,%d,%d,%d' WHERE `hID` = '%d' LIMIT 1",
	HouseInfo[idx][hSafe][0],HouseInfo[idx][hSafe][1],HouseInfo[idx][hSafe][2],HouseInfo[idx][hSafe][3],
	HouseInfo[idx][hSafeGun][0],HouseInfo[idx][hSafeGun][1],HouseInfo[idx][hSafeGun][2],HouseInfo[idx][hSafeGun][3],HouseInfo[idx][hSafeGun][4],HouseInfo[idx][hSafeGun][5],
	HouseInfo[idx][hSafeAmmo][0],HouseInfo[idx][hSafeAmmo][1],HouseInfo[idx][hSafeAmmo][2],HouseInfo[idx][hSafeAmmo][3],HouseInfo[idx][hSafeAmmo][4],HouseInfo[idx][hSafeAmmo][5],
	HouseInfo[idx][hID]);
	mysql_tquery(dbHandle, query_, "", "");
	return 1;
}
ShowFamilyGunSafe(playerid)
{
