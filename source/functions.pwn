		ShowTruckerMainMenu(TurnLoadingTrucker[LOADING_COAL_0][0], trailer_id, .timer = true);
		DeletePVar ( TurnLoadingTrucker[LOADING_COAL_0][0], "truck_count" ) ;
	}

	TurnLoadingCD[LOADING_COAL_1] += 1 ;
	if (TurnLoadingCD[LOADING_COAL_1] == 125 ) TurnLoadingPlayerID[ LOADING_COAL_1 ] = INVALID_PLAYER_ID;
	if (TurnLoadingPlayerID [ LOADING_COAL_1 ] == INVALID_PLAYER_ID && TurnLoadingTrucker[LOADING_COAL_1][0] != INVALID_PLAYER_ID )
	{
		TurnLoadingPlayerID [ LOADING_COAL_1 ] = TurnLoadingTrucker[LOADING_COAL_1][0] ;
		TurnLoadingCD[ LOADING_COAL_1 ] = 0 ;
		SendClientMessage ( TurnLoadingTrucker[LOADING_COAL_1][0], COLOR_GREY, !"Ваша фура загружена. У вас есть 2 минуты, чтобы прицепить её");
		SendClientMessage ( TurnLoadingTrucker[LOADING_COAL_1][0], COLOR_GREY, !"Если вы не успеете, деньги не будут возвращены"); 
		new trailer_id = _CreateVehicle(450,-1881.3596,-1689.1852,22.3543,172.1823,1,1, -1); 
		pTemp[ TurnLoadingTrucker[LOADING_COAL_1][0] ][tTruckerTrailerBuy] = trailer_id;

		trailer_type [ trailer_id - 1 ] = LOADING_COAL_1;
		trailer_count [ trailer_id - 1 ] = GetPVarInt ( TurnLoadingTrucker[LOADING_COAL_1][0], "truck_count" ) ;
 
		pTemp[ TurnLoadingTrucker[LOADING_COAL_1][0] ][tTruckerLoadTime] = 120; 
		ShowTruckerMainMenu(TurnLoadingTrucker[LOADING_COAL_1][0], trailer_id, .timer = true);
		DeletePVar ( TurnLoadingTrucker[LOADING_COAL_1][0], "truck_count" ) ;
	}

	TurnLoadingCD[LOADING_OIL_0] += 1 ;
	if (TurnLoadingCD[LOADING_OIL_0] == 125) TurnLoadingPlayerID[ LOADING_OIL_0 ] = INVALID_PLAYER_ID;
	if (TurnLoadingPlayerID [ LOADING_OIL_0 ] == INVALID_PLAYER_ID && TurnLoadingTrucker[LOADING_OIL_0][0] != INVALID_PLAYER_ID )
	{
		TurnLoadingPlayerID [ LOADING_OIL_0 ] = TurnLoadingTrucker[LOADING_OIL_0][0] ;
		TurnLoadingCD[ LOADING_OIL_0 ] = 0 ;
		SendClientMessage(TurnLoadingTrucker[LOADING_OIL_0][0], COLOR_GREY, !"Ваша фура загружена. У вас есть 2 минуты, чтобы прицепить её");
		SendClientMessage(TurnLoadingTrucker[LOADING_OIL_0][0], COLOR_GREY, !"Если вы не успеете, деньги не будут возвращены"); 
		new trailer_id = _CreateVehicle(584, 249.1628,1420.7445,11.1698,269.4982,1,1, -1); 
		pTemp[ TurnLoadingTrucker[LOADING_OIL_0][0] ][tTruckerTrailerBuy] = trailer_id;

		trailer_type [ trailer_id - 1 ] = LOADING_OIL_0;
		trailer_count [ trailer_id - 1 ] = GetPVarInt ( TurnLoadingTrucker[LOADING_OIL_0][0], "truck_count" ) ;
 
		pTemp[ TurnLoadingTrucker[LOADING_OIL_0][0] ][tTruckerLoadTime] = 120; 
		ShowTruckerMainMenu(TurnLoadingTrucker[LOADING_OIL_0][0], trailer_id, .timer = true);
		DeletePVar ( TurnLoadingTrucker[LOADING_OIL_0][0], "truck_count" ) ;
	}

	TurnLoadingCD[LOADING_OIL_1] += 1 ;
	if (TurnLoadingCD[LOADING_OIL_1] == 125 ) TurnLoadingPlayerID[ LOADING_OIL_1 ] = INVALID_PLAYER_ID;
	if (TurnLoadingPlayerID [ LOADING_OIL_1 ] == INVALID_PLAYER_ID && TurnLoadingTrucker[LOADING_OIL_1][0] != INVALID_PLAYER_ID )
	{
		TurnLoadingPlayerID [ LOADING_OIL_1 ] = TurnLoadingTrucker[LOADING_OIL_1][0] ;
		TurnLoadingCD[ LOADING_OIL_1 ] = 0 ;
		SendClientMessage ( TurnLoadingTrucker[LOADING_OIL_1][0], COLOR_GREY, !"Ваша фура загружена. У вас есть 2 минуты, чтобы прицепить её");
		SendClientMessage ( TurnLoadingTrucker[LOADING_OIL_1][0], COLOR_GREY, !"Если вы не успеете, деньги не будут возвращены"); 
		new trailer_id = _CreateVehicle(584,-1043.4102,-686.8473,32.6164,1.1470,1,1, -1); 
		pTemp[ TurnLoadingTrucker[LOADING_OIL_1][0] ][tTruckerTrailerBuy] = trailer_id;

		trailer_type [ trailer_id - 1 ] = LOADING_OIL_1;
		trailer_count [ trailer_id - 1 ] = GetPVarInt ( TurnLoadingTrucker[LOADING_OIL_1][0], "truck_count" ) ;
 
		pTemp[ TurnLoadingTrucker[LOADING_OIL_1][0] ][tTruckerLoadTime] = 120;

		ShowTruckerMainMenu(TurnLoadingTrucker[LOADING_OIL_1][0], trailer_id, .timer = true);
		DeletePVar ( TurnLoadingTrucker[LOADING_OIL_1][0], "truck_count" ) ;
	}
}
 
publics: UpdateTruckerTrailerMinute(playerid)
{
	for(new i = 0; i < LOADING_ALL; i++) {
		if (TurnLoadingTrucker[i][0] == playerid) {
			TurnLoadingTrucker[i][0] = INVALID_PLAYER_ID;
		} 
	} 
}  
stock ShowTruckerMainMenu(playerid, vehicleid, bool: main = true, bool: timer = true) {
	if (main) {
		for(new i = 0; i < sizeof trucker_TD; i++) {
			TextDrawShowForPlayer(playerid, trucker_TD[i]);
		}
		trucker_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 502.9992, 124.8587, "CARGO_TYPE: ~w~WOOD"); // ?CAB>
		PlayerTextDrawLetterSize(playerid, trucker_PTD[playerid][0], 0.2194, 0.9900);
		PlayerTextDrawTextSize(playerid, trucker_PTD[playerid][0], 738.0000, 0.0000);
		PlayerTextDrawAlignment(playerid, trucker_PTD[playerid][0], 1);
		PlayerTextDrawColor(playerid, trucker_PTD[playerid][0], COLOR_SERVER);
		PlayerTextDrawSetOutline(playerid, trucker_PTD[playerid][0], -1);
		PlayerTextDrawBackgroundColor(playerid, trucker_PTD[playerid][0], -754100980);
		PlayerTextDrawFont(playerid, trucker_PTD[playerid][0], 1);
		PlayerTextDrawSetProportional(playerid, trucker_PTD[playerid][0], 1);
		PlayerTextDrawSetShadow(playerid, trucker_PTD[playerid][0], 0);

		trucker_PTD[playerid][1] = CreatePlayerTextDraw(playerid, 502.9992, 136.4956, "AMOUNT: ~w~40/40 TON"); // ?CAB>
		PlayerTextDrawLetterSize(playerid, trucker_PTD[playerid][1], 0.2194, 0.9900);
		PlayerTextDrawTextSize(playerid, trucker_PTD[playerid][1], 738.0000, 0.0000);
		PlayerTextDrawAlignment(playerid, trucker_PTD[playerid][1], 1);
		PlayerTextDrawColor(playerid, trucker_PTD[playerid][1], COLOR_SERVER);
		PlayerTextDrawSetOutline(playerid, trucker_PTD[playerid][1], -1);
		PlayerTextDrawBackgroundColor(playerid, trucker_PTD[playerid][1], -754100980);
		PlayerTextDrawFont(playerid, trucker_PTD[playerid][1], 1);
		PlayerTextDrawSetProportional(playerid, trucker_PTD[playerid][1], 1);
		PlayerTextDrawSetShadow(playerid, trucker_PTD[playerid][1], 0);

		static const name_cargo[][] = {
			"WOOD",
			"WOOD",
			"COAL",
			"COAL",
			"OIL",
			"OIL"
		};
		new str_[32];
		format(str_, sizeof str_, "CARGO_TYPE: ~w~%s", name_cargo[ trailer_type [ vehicleid - 1 ] ]);
		PlayerTextDrawSetString(playerid, trucker_PTD[playerid][0], str_);

		format(str_, sizeof str_, "AMOUNT: ~w~%d/%d TON", trailer_count [ vehicleid - 1 ], pInfo[playerid][pDMgruz]);
		PlayerTextDrawSetString(playerid, trucker_PTD[playerid][1], str_);


		PlayerTextDrawShow(playerid, trucker_PTD[playerid][0]);
		PlayerTextDrawShow(playerid, trucker_PTD[playerid][1]);
	}
	if (timer) {
		for(new i = 0; i < sizeof TimerTrucker_TD; i++) {
			TextDrawShowForPlayer(playerid, TimerTrucker_TD[i]);
		}
		if (TimerTrucker_PTD[playerid] == PlayerText: -1) {
			TimerTrucker_PTD[playerid] = CreatePlayerTextDraw(playerid, 559.0000, 159.7998, "Time:_~y~00:00"); // ?CAB>
			PlayerTextDrawLetterSize(playerid, TimerTrucker_PTD[playerid], 0.2556, 1.0105);
			PlayerTextDrawTextSize(playerid, TimerTrucker_PTD[playerid], 686.0000, 0.0000);
			PlayerTextDrawAlignment(playerid, TimerTrucker_PTD[playerid], 1);
			PlayerTextDrawColor(playerid, TimerTrucker_PTD[playerid], -1);
			PlayerTextDrawBackgroundColor(playerid, TimerTrucker_PTD[playerid], 6);
			PlayerTextDrawFont(playerid, TimerTrucker_PTD[playerid], 1);
			PlayerTextDrawSetProportional(playerid, TimerTrucker_PTD[playerid], 1);
			PlayerTextDrawSetShadow(playerid, TimerTrucker_PTD[playerid], 0);
		}  
		PlayerTextDrawShow(playerid, TimerTrucker_PTD[playerid]);
	}
}

stock HideTruckerMainMenu(playerid, bool: main = true, bool: timer = true) {
	if (main) {
		for(new i = 0; i < sizeof trucker_TD; i++) {
			TextDrawHideForPlayer(playerid, trucker_TD[i]);
		}
		if (trucker_PTD[playerid][0] != PlayerText: -1) {
			PlayerTextDrawDestroy(playerid, trucker_PTD[playerid][0]);
		}
		if (trucker_PTD[playerid][1] != PlayerText: -1) {
			PlayerTextDrawDestroy(playerid, trucker_PTD[playerid][1]);
		} 
		trucker_PTD[playerid][0] = PlayerText: -1; 
		trucker_PTD[playerid][1] = PlayerText: -1;
	}
	if (timer) {
		for(new i = 0; i < sizeof TimerTrucker_TD; i++) {
			TextDrawHideForPlayer(playerid, TimerTrucker_TD[i]);
		}
		if (TimerTrucker_PTD[playerid] != PlayerText: -1) {
			PlayerTextDrawDestroy(playerid, TimerTrucker_PTD[playerid]);
		}
		TimerTrucker_PTD[playerid] = PlayerText: -1;
	}
}  
stock GetPlayerPromoCodeSearch(promoid)
{
	new 
        query_[84];
	format(query_, sizeof query_,"SELECT * FROM s_promocode WHERE id = '%d' LIMIT 1", promoid);
	new Cache: result = mysql_query(dbHandle, query_); 
	new 
		value = cache_num_rows(),
		promo_name[32];
	if (!value) {
		promo_name = "None";
	} else {
		cache_get_value_name(0, "code", promo_name);
	} 
	if (cache_is_valid(result)) cache_delete(result);
	return promo_name;
}

stock SetPosInFrontOfPlayer(playerid, targetid, Float:distance) {
	new 
		Float: x,
		Float: y,
		Float: z,
		Float: a;
	GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, a);
	x += (distance * floatsin(-a, degrees));
	y += (distance * floatcos(-a, degrees));
	SetPlayerPosAC(targetid, x, y, z, pTemp[playerid][tVirtualWorld], pTemp[playerid][tInterior]);
	SetPlayerFacingAngle(targetid, a);
}
stock srace_end(playerid, type) {
	DestroyDynamicCP(pTemp[playerid][tRaceCP]);
	DestroyDynamicCP(pTemp[ pTemp[playerid][tRaceID] ][tRaceCP]);
	CP[ playerid ] = 777;
	DisablePlayerCheckpoint(playerid);
	CP[ pTemp[playerid][tRaceID] ] = 777;
	DisablePlayerCheckpoint(pTemp[playerid][tRaceID]);
	switch(type) {
		case 0: {
			new string[144];
			format(string, sizeof(string), "Вы одержали победу в гонках над "C_PODS"%s"c_offer". Вознаграждение: "collime"$%d",
				pInfo[ pTemp[playerid][tRaceID] ][pName], pTemp[playerid][tRaceMoney]*2
			);
			SendClientMessage(playerid, C_OFFER, string);
			GameTextForPlayer(playerid, !"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~YOU WIN", 3000, 3);
			if (pInfo[playerid][pFamily]) GiveFamilyRepute(pInfo[playerid][pFamily], 1); //Проиграл гонку
			format(string, sizeof(string), "Вы проиграли "collime"$%d"c_offer" игроку "C_PODS"%s"c_offer" в гонках",
				pTemp[playerid][tRaceMoney]*2, pInfo[playerid][pName]
			);
			SendClientMessage(pTemp[playerid][tRaceID], C_OFFER, string); 
			GameTextForPlayer(pTemp[playerid][tRaceID], !"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~YOU LOSE", 3000, 3);
			kLibGivePlayerMoney(playerid, pTemp[playerid][tRaceMoney] * 2, "победа в уличных гонках");
			if (pInfo[pTemp[playerid][tRaceID]][pFamily]) GiveFamilyRepute(pInfo[pTemp[playerid][tRaceID]][pFamily], -1);
			
		}
		case 1, 2: {
			new string[144];
			if (type == 1) {
				format(string,sizeof(string),"Игрок покинул сервер. Вы одержали победу в гонках над "C_PODS"%s"c_offer". Вознаграждение: "collime"$%d",
					pInfo[playerid][pName], pTemp[playerid][tRaceMoney]*2
				);
				SendClientMessage(pTemp[playerid][tRaceID], C_OFFER, string);
				GameTextForPlayer(pTemp[playerid][tRaceID], !"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~YOU WIN", 3000, 3);
				if (pInfo[pTemp[playerid][tRaceID]][pFamily]) GiveFamilyRepute(pInfo[pTemp[playerid][tRaceID]][pFamily], 1);
			}
			if (type == 2) {
				format(string,sizeof(string),"Игрок покинул транспорт. Вы одержали победу в гонках над "C_PODS"%s"c_offer". Вознаграждение: "collime"$%d",
					pInfo[playerid][pName], pTemp[playerid][tRaceMoney]*2
				);
				SendClientMessage(pTemp[playerid][tRaceID], C_OFFER, string);
				GameTextForPlayer(pTemp[playerid][tRaceID], !"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~YOU WIN", 3000, 3);
				if (pInfo[pTemp[playerid][tRaceID]][pFamily]) GiveFamilyRepute(pInfo[pTemp[playerid][tRaceID]][pFamily], 1); //Проиграл гонку
				format(string,sizeof(string),"Вы покинули транспорт во время гонке. Победитель в гонке: "C_PODS"%s",
					pInfo[ pTemp[playerid][tRaceID] ][pName]
				);
				SendClientMessage(playerid, C_OFFER, string);
				if (pInfo[playerid][pFamily]) GiveFamilyRepute(pInfo[playerid][pFamily], -1); //Проиграл гонку
				GameTextForPlayer(playerid, !"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~YOU LOSE", 3000, 3);
			}
			kLibGivePlayerMoney(pTemp[playerid][tRaceID], pTemp[playerid][tRaceMoney]*2, "победа в уличных гонках");
			
		}
	}
	pTemp[playerid][tRaceMoney] = pTemp[pTemp[playerid][tRaceID]][tRaceMoney] = 0;
	pTemp[playerid][tRaceID] = pTemp[pTemp[playerid][tRaceID]][tRaceID] = INVALID_PLAYER_ID;
}

stock IsPlayerInMedical(playerid)
{
    if(
        IsPlayerInRangeOfPoint(playerid, 100.0,835.0920,1348.3275,1071.479) &&  GetPlayerInterior(playerid) == 7 ||
        IsPlayerInRangeOfPoint(playerid, 100.0,-2601.2571,603.7801,1338.9753) &&  GetPlayerInterior(playerid) == HOSPITAL_SF_INT ||
        IsPlayerInRangeOfPoint(playerid, 100.0,1672.6567,1781.9744,1098.1624) &&  GetPlayerInterior(playerid) == HOSPITAL_LV_INT
    )
    {
        return 1;
    }
    return 0;
}

