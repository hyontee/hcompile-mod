stock SetSpawnInfoEx(playerid, skin, Float:x, Float:y, Float:z, Float:angle)
{
	setX[playerid] = x;
	setY[playerid] = y;
	setZ[playerid] = z;
	SetSpawnInfo(playerid, GetPlayerTeam(playerid), skin, x, y, z, angle, -1, -1, -1, -1, -1, -1);
} 

stock SetPlayerPosAC(playerid, Float:x, Float:y, Float:z, worldid = -1, interiorid = -1, setUP = false)
{
    if (playerid == INVALID_PLAYER_ID) return false; 
	if (!setUP)
	{
		if (worldid != -1)
		{
			pTemp[playerid][tVirtualWorld] = worldid;
			SetPlayerVirtualWorld(playerid, worldid);
		}
		if (interiorid != -1)
		{
			pTemp[playerid][tInterior] = interiorid;
			SetPlayerInterior(playerid, interiorid);
			if (!interiorid) SetPlayerTime(playerid, hour, minute);
			else SetPlayerTime(playerid, 11, 00);
		}
	}
	else
	{
		if (worldid != -1) SetPlayerVirtualWorld(playerid, worldid);
		if (interiorid != -1) SetPlayerInterior(playerid, interiorid);
		if (!interiorid) SetPlayerTime(playerid, hour, minute);
		else SetPlayerTime(playerid, 11, 00);
	} 
	SetPlayerPos(playerid, x, y, z);
	SetCameraBehindPlayer(playerid);
	#if defined _ac_ser_inc
		AC_Info[playerid][acSetPos] = GetTickCount() + 3250;
	#endif
	pTemp [ playerid ] [ tIgnorePick ] = 5;

	LoadTextures(playerid);

	return true; 
}

stock ac_Kick(playerid)
{
	//SavePlayerID(playerid);
	SetTimerEx("PlayerKick", 500, false, "d", playerid);
	return 1;
}
publics: PlayerKick(playerid) return Kick(playerid);
#define Kick ac_Kick
stock scmKick(playerid, const reason[], color = COLOR_LIGHTRED) {
	SendClientMessage(playerid, color, reason);
	KickEx(playerid);
	return 1;
}
stock SetPlayerWantedLevelEx(playerid, wantedlevel)
{
    if (pInfo[playerid][pWantedLevel] > 6) pInfo[playerid][pWantedLevel] = 6;
	else pInfo[playerid][pWantedLevel] = wantedlevel;
	
	return SetPlayerWantedLevel(playerid, pInfo[playerid][pWantedLevel]);
} 

