stock GetVehicleTT(playerid) {
	new V_IDX = GetPlayerVehicleID(playerid),
		bool: tt_ = false;
	if (VehicleInfo[ V_IDX - 1 ][vPT_Engine][1] > 0) {
		tt_ = true;
	}
	return tt_;
}
publics: UpdateSpeedometr(playerid)
{
	if (GetPlayerState(playerid) != 2)
	{
		if (IsPlayerGetSettings(playerid, setTypeSpeedometr)) {
			for(new tj = 0; tj < 18; tj++) {
				TextDrawHideForPlayer(playerid, tSpeedometr[ tj ]); 
			}
			for(new tx = 0; tx < 7; tx++) { 
				PlayerTextDrawHide(playerid, gSpeedometr[playerid][tx]);
			}
		} else {
			for(new tx = 0; tx < 8; tx++) { 
				PlayerTextDrawHide(playerid, TextDrawSpeedP[playerid][tx]);
			}
			for(new tj = 0; tj < 55; tj++) {
				TextDrawHideForPlayer(playerid, TextDrawSpeed[tj]);
			}
			/*for(new tj = 0; tj < 38; tj++) {
				PlayerTextDrawDestroy(playerid, tNewSpeedometr[playerid][ tj ]); 
			}*/
		} 
		return 1;
	}
	new V_IDX = GetPlayerVehicleID(playerid);

	GetVehicleParamsEx(V_IDX, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	
	new
		Float: _coord[3];
	GetVehicleVelocity(V_IDX, _coord[0], _coord[1], _coord[2]);
	new
		Float: v_speed = floatsqroot(floatpower(floatabs(_coord[0]), 2.0) + floatpower(floatabs(_coord[1]), 2.0) + floatpower(floatabs(_coord[2]), 2.0)) * 100.3 ;
		//Float: v_speed = GetVehicleSpeed(V_IDX);
	new
		Float: veh_health_now;
	GetVehicleHealth(V_IDX, veh_health_now);
	GetVehicleRotation(V_IDX, _coord[0], _coord[1], _coord[2]);
//	new Float:speedcar = _GetVehicleSpeed(vehicleid);
	/*if (pTemp[playerid][tSLimit]) {
		if (speedcar > pTemp[playerid][tSLimit]) {
			new Float:dif = pTemp[playerid][tSLimit] / speedcar;
			SetVehicleVelocity(vehicleid,Xx*dif,Yy*dif,Zz*dif);
			speedcar = pTemp[playerid][tSLimit];
		}
	}
	if (pTemp[playerid][pSLimit]) {
		new Float: speed_limit = floatround(GetVehicleSpeed(V_IDX));
		if (speed_limit > pTemp[playerid][pSLimit]) {
			new Float:dif = pTemp[playerid][pSLimit];
			SetVehicleSpeed(V_IDX, dif);  
		}
	}*/
	if ( veh_health_now - VehicleInfo[ V_IDX - 1 ] [ vHealth ] == 0/* && VehicleInfo[ vehicleid - 1 ] [ v_ems ] == false */)
	{ 
		new key_pressed, ud, lr;
	    GetPlayerKeys(playerid, key_pressed, ud, lr); 
		if (VehicleInfo[ V_IDX - 1 ][vPT_Engine][0] > 0) {
			if (key_pressed == KEY_SPRINT && v_speed > 5 && v_speed < GetModelStaticSpeed(VehicleInfo[ V_IDX - 1 ][vModel]) && engine1 == 1) { 
				if (v_speed < 250) {
					SetVehicleSpeed(V_IDX, v_speed + (engine1_ptune_boost [ VehicleInfo[ V_IDX - 1 ][vPT_Engine][0] ] * 2));  
					VehicleInfo[ V_IDX - 1 ][vOldZAngle] = _coord[2];
				}
				
			}
		}	
		if (VehicleInfo[ V_IDX - 1 ][vPT_Engine][3] > 0) {
			if (key_pressed == KEY_JUMP && v_speed > 30 && (_coord[2] - VehicleInfo[ V_IDX - 1 ][vOldZAngle] < 0.3 && _coord[2] - VehicleInfo[ V_IDX - 1 ][vOldZAngle] > - 0.3)) { 
				SetVehicleSpeed(V_IDX, v_speed - (brake_name_boost[VehicleInfo[ V_IDX - 1 ][vPT_Engine][3]] * 2)); 
				VehicleInfo[ V_IDX - 1 ][vOldZAngle] = _coord[2];
			}
		}
		VehicleInfo[ V_IDX - 1 ][vOldZAngle] = _coord[2];
	} 
	VehicleInfo[ V_IDX - 1 ][vOldZAngle] = _coord[2];
	VehicleInfo[ V_IDX - 1 ][vHealth] = veh_health_now; 
	
	UpdateVehicleHud(playerid, V_IDX);
	 
	
	new
		str_0[16],
		str_1[16],
		str_2[16],
		str_3[16],
		str_4[16];
	//VehicleInfo[ V_IDX - 1 ][vPT_Engine][0] //turbo
	if (IsPlayerGetSettings(playerid, setTypeSpeedometr)) {
		format(str_0, sizeof str_0, "%.0f%s", GetVehicleSpeed(V_IDX), (VehicleInfo[ V_IDX - 1 ][vPT_Engine][0] == 0) ? ("_"):("_~g~TURBO"));
		PlayerTextDrawSetString(playerid, gSpeedometr[playerid][0], str_0);//
		
		if (VehicleInfo[ V_IDX - 1 ][vFuel] <= 15) format(str_1, sizeof str_1, "~r~%.0f L", VehicleInfo[ V_IDX - 1 ][vFuel]);
		else if (VehicleInfo[ V_IDX - 1 ][vFuel] <= 25) format(str_1, sizeof str_1, "~y~%.0f L", VehicleInfo[ V_IDX - 1 ][vFuel]);
		else format(str_1, sizeof str_1, "~g~%.0f L", VehicleInfo[ V_IDX - 1 ][vFuel]);
		PlayerTextDrawSetString(playerid, gSpeedometr[playerid][1], str_1);
		
		format(str_2, sizeof str_2, "%.2f KM", VehicleInfo[ V_IDX - 1 ][vMillage]);
		PlayerTextDrawSetString(playerid, gSpeedometr[playerid][2], str_2);
		
		format(str_3, sizeof str_3, "%.0f", VehicleInfo[ V_IDX - 1 ][vHealth]);
		PlayerTextDrawSetString(playerid, gSpeedometr[playerid][3], str_3);
	} else {
		/*if (VehicleInfo[ V_IDX - 1 ][vFuel] <= 15) format(str_1, sizeof str_1, "~r~%.0f", VehicleInfo[ V_IDX - 1 ][vFuel]);
		else if (VehicleInfo[ V_IDX - 1 ][vFuel] <= 25) format(str_1, sizeof str_1, "~y~%.0f", VehicleInfo[ V_IDX - 1 ][vFuel]);
		else format(str_1, sizeof str_1, "~g~%.0f", VehicleInfo[ V_IDX - 1 ][vFuel]);
		PlayerTextDrawSetString(playerid, gOldSpeedometr[playerid][3], str_1); */

		format(str_1, sizeof str_1, "fuel:_%.0f%", VehicleInfo[ V_IDX - 1 ][vFuel]);
		PlayerTextDrawSetString(playerid, TextDrawSpeedP[playerid][6], str_1);



		if (!doors3) PlayerTextDrawColor(playerid,TextDrawSpeedP[playerid][2], -16776961), PlayerTextDrawShow(playerid,TextDrawSpeedP[playerid][2]);
		else PlayerTextDrawColor(playerid,TextDrawSpeedP[playerid][2], 0x20B220AA), PlayerTextDrawShow(playerid,TextDrawSpeedP[playerid][2]);

		if (!engine1) PlayerTextDrawColor(playerid,TextDrawSpeedP[playerid][1], -16776961), PlayerTextDrawShow(playerid,TextDrawSpeedP[playerid][1]);
		else PlayerTextDrawColor(playerid,TextDrawSpeedP[playerid][1], 0x20B220AA), PlayerTextDrawShow(playerid,TextDrawSpeedP[playerid][1]);

		if (!lights2) PlayerTextDrawColor(playerid,TextDrawSpeedP[playerid][3], -16776961), PlayerTextDrawShow(playerid,TextDrawSpeedP[playerid][3]);
		else PlayerTextDrawColor(playerid,TextDrawSpeedP[playerid][3], 0x20B220AA), PlayerTextDrawShow(playerid,TextDrawSpeedP[playerid][3]);
		
		format(str_0, sizeof str_0, "%.0f%s", GetVehicleSpeed(V_IDX), (VehicleInfo[ V_IDX - 1 ][vPT_Engine][0] == 0) ? ("_"):("_~g~TURBO"));
		PlayerTextDrawSetString(playerid,TextDrawSpeedP[playerid][4], str_0);

		format(str_4, sizeof str_4, "%s", VehicleNames[ GetVehicleModel(V_IDX) - 400 ]);
		PlayerTextDrawSetString(playerid,TextDrawSpeedP[playerid][0], str_4);

		format(str_2, sizeof str_2, "%.2f KM", VehicleInfo[ V_IDX - 1 ][vMillage]);
		PlayerTextDrawSetString(playerid, TextDrawSpeedP[playerid][5], str_2);

		PlayerTextDrawTextSize(playerid, TextDrawSpeedP[playerid][7], VehicleInfo[V_IDX - 1][vHealth]*0.052, 3.0);
		PlayerTextDrawShow(playerid, TextDrawSpeedP[playerid][7]);

		/*if (pInfo[playerid][pDrivingSkill] == 0) PlayerTextDrawSetString(playerid,gOldSpeedometr[playerid][7],"MAX");
		else PlayerTextDrawSetString(playerid,gOldSpeedometr[playerid][7],"~r~MAX"); */
	} 

	


	static
		Float:speed,
		Float:tmp___;

	speed = GetVehicleSpeed(V_IDX);
	tmp___ = VehicleInfo[ V_IDX - 1 ][vTempMillage] += (speed / 1.4) / 1000.0; 
	if (tmp___ >= TDW_VEHICLE_MILEAGE_MILE_FLOAT) {
		VehicleInfo[ V_IDX - 1 ][vMillage] += tmp___;
		VehicleInfo[ V_IDX - 1 ][vTempMillage] -= TDW_VEHICLE_MILEAGE_MILE_FLOAT;
	} 
	if (engine1 == 1) {
		if (VehicleInfo[ V_IDX - 1 ][vFuel] <= 0.1) { 
			toggle_engine1(playerid, V_IDX);
			VehicleInfo[ V_IDX - 1 ][vFuel] = 0.0; 
		} else {
			VehicleInfo[ V_IDX - 1 ][vFuel] -= (GetVehicleSpeed(V_IDX) + 0.1)/TDW_VEHICLE_FUEL_FLOAT;
		}
	} 
	return SetTimerEx("UpdateSpeedometr", SPEEDOMETR_TIMER_UPDATE, false, "d", playerid);
}  

