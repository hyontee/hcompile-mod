stock UpdateFish(playerid)
{
	new string_[128];
	if (GetPVarInt(playerid,"fish_sonar")) {
		format(string_, sizeof string_,
		"~y~Tackle: ~w~%d~n~~y~Worms: ~w~%d~n~~y~Sonar: ~w~%.2f~n~~n~~y~Press: ~g~L.ALT",
		pInfo[playerid][pFishesTicle], pInfo[playerid][pFishesWorms], Sonar[playerid]);
	}
	else format(string_, sizeof string_,"~y~Tackle: ~w~%d~n~~y~Worms: ~w~%d~n~~n~~y~Press: ~g~L.ALT", pInfo[playerid][pFishesTicle], pInfo[playerid][pFishesWorms]);
	PlayerTextDrawSetString(playerid,FishingText[playerid], string_);
	return 1;
}
stock PlayerLeaveCollector(playerid) { 
	if (pTemp[playerid][tTakeCashATM]) {
		if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
		pTemp[playerid][tTakeCashATM] = false;
	} 
	if (pTemp[playerid][pRentCar] != INVALID_VEHICLE_ID)
    {
		new 
            vehicleid = pTemp[playerid][pRentCar];
		if (IsValidVehicle(vehicleid)) {
			if (VehicleInfo[vehicleid - 1][vType] == VEHICLE_TYPE_JOB && VehicleInfo[vehicleid - 1][vFraction] == PLAYER_JOB_COLLECTOR)     
			{
				SetVehicleToRespawn(vehicleid);
				if (VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobLoad]) {
					if (VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vFarmText] != Text3D:-1) { 
						DestroyDynamic3DTextLabel(VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vFarmText]); 
						VehicleInfo[ pTemp[playerid][pRentCar]  - 1 ][vFarmText] = Text3D:-1;
					} 
					DestroyDynamicArea(VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobArea]);
					DestroyDynamicPickup(VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobPickup]);
					VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobLoad] = false; 
				}  
				VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobAmount] = 0;
				pTemp[playerid][pRentCar] = INVALID_VEHICLE_ID;
			}
		}
    }
        
}
stock PlayerLeaveRobHouse(playerid) { 
	if (pTemp[playerid][tRobVeh] != INVALID_VEHICLE_ID)
	{
		_DestroyVehicle(pTemp[playerid][tRobVeh]);
		if (VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobLoad]) {
			if (VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vFarmText] != Text3D:-1) { 
				DestroyDynamic3DTextLabel(VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vFarmText]); 
				VehicleInfo[ pTemp[playerid][tRobVeh]  - 1 ][vFarmText] = Text3D:-1;
			} 
			DestroyDynamicArea(VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobArea]);
			DestroyDynamicPickup(VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobPickup]);
			VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobLoad] = false; 

			new	
				H_IDX = GetPVarInt(playerid, "playerRobIDX");
			DestroyDynamicPickup(HouseInfo[H_IDX][hPickupRob]); 
			DestroyDynamic3DTextLabel(HouseInfo[H_IDX][hTextRob]);
			UpdateHouseInfo(H_IDX);
			HouseInfo[H_IDX][hCountItemRob][0] = 0;
			HouseInfo[H_IDX][hCountItemRob][1] = 0; 
			//clear mass player 
			pTemp[playerid][tRobItems] = false;
			DeletePVar(playerid, "playerRobIDX"); 
		}  
		VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount] = 0;
		pTemp[playerid][tRobVeh] = INVALID_VEHICLE_ID;
	}
}

stock SetWeaponFraction(playerid)
{
 	if (pInfo[playerid][pLevel] <= 1) return 1;

	#if defined _ac_inc

	player_weapon_id[playerid][0] = 0;
	player_weapon_ammo[playerid][0] = 0;
	player_weapon_id[playerid][1] = 0;
	player_weapon_ammo[playerid][1] = 0;
	player_weapon_id[playerid][9] = 0;
	player_weapon_ammo[playerid][9] = 0;

	player_weapon_id[playerid][11] = 0;
	player_weapon_ammo[playerid][11] = 0;

	switch(pInfo[playerid][pMember])
	{
		case 5:{
			player_weapon_id[playerid][1] = 2;
			player_weapon_ammo[playerid][1] = 1;
		}
		case 6:{
			player_weapon_id[playerid][1] = 8;
			player_weapon_ammo[playerid][1] = 1;
		}
		case 7: {
		    if (pInfo[playerid][pRank] > 2 && pInfo[playerid][pRank] < 5) {
				player_weapon_id[playerid][2] = 24;
				player_weapon_ammo[playerid][2] = 28;
			    SetPlayerArmour(playerid, 100);
			}
		}
		case 9: {
		    gNews[playerid] = false;
			player_weapon_id[playerid][9] = 43;
			player_weapon_ammo[playerid][9] = 40;
		}
		case 12, 13, 15, 17, 18:{
			player_weapon_id[playerid][1] = 5;
			player_weapon_ammo[playerid][1] = 1;
		}
		case 14: {
			player_weapon_id[playerid][0] = 1;
			player_weapon_ammo[playerid][0] = 1;
		}
		case 16: {
		    lNews[playerid] = false;
			player_weapon_id[playerid][9] = 43;
			player_weapon_ammo[playerid][9] = 40;
		}
		case 20: {
		    LvNews[playerid] = false;
			player_weapon_id[playerid][9] = 43;
			player_weapon_ammo[playerid][9] = 40;
		}
	}
	GetWeaponClear(playerid);

	#else

	switch(pInfo[playerid][pMember])
	{
		case 5: GivePlayerWeapon(playerid,2,1);
		case 6: GivePlayerWeapon(playerid,8,1);
		case 7: {
		    if (pInfo[playerid][pRank] > 2 && pInfo[playerid][pRank] < 5) {
				GivePlayerWeapon(playerid, 24, 29);
			    SetPlayerArmour(playerid, 100);
			}
		}
		case 9: {
		    gNews[playerid] = false;
			GivePlayerWeapon(playerid, 43, 60);
		}
		case 12, 13, 15, 17, 18: GivePlayerWeapon(playerid,5,1);
		case 14: GivePlayerWeapon(playerid,1,1);
		case 16: {
		    lNews[playerid] = false;
			GivePlayerWeapon(playerid, 43, 60);
		}
		case 20: {
		    LvNews[playerid] = false;
			GivePlayerWeapon(playerid, 43, 60);
		}
	}

	#endif
	return 1;
}

stock SettingSpawn(const playerid)
{
    #if defined debug_mode 
		printf("[GM debug] stock SettingSpawn(%d)", playerid); 
	#endif
    if (/*pTemp[playerid][tPaintTeam] != 0 || */pTemp[playerid][tPlayerReg] == 1 || SpecAd[playerid] != INVALID_PLAYER_ID) return 1;

    SetPlayerScore(playerid, pInfo[playerid][pLevel]);

	pTemp[playerid][tVirtualWorld] = 0;
    pTemp[playerid][tInterior] = 0;

	new
		skin;
	if (pInfo[playerid][pMember] && pTemp[playerid][tDutyWork])
	{
		skin = pInfo[playerid][pModel];
	}
	else skin = pInfo[playerid][pChar][0]; 
	if (pInfo[playerid][pJailTime] > 0)
	{ 
		static const Float: PrisonPositionSpawn[][3] = {
			{2743.4106, 1392.7045, 1100.9045},
			{219.5400, 109.9767, 999.0156},
			{198.3642, 161.8103, 1003.0300}
		};  
		if (pInfo[playerid][pMestoJail] < 4) {
			new rand = pInfo[playerid][pMestoJail]-1;
			SetSpawnInfoEx(playerid, skin, PrisonPositionSpawn[ rand ][0], PrisonPositionSpawn[rand][1], PrisonPositionSpawn[rand][2], 1.0);
			pTemp[playerid][tVirtualWorld] = 6;
			pTemp[playerid][tInterior] = 1;
		} else {
			SetSpawnInfoEx(playerid, skin, 2.4973,803.3113,1033.0717,271.8828);
			pTemp[playerid][tVirtualWorld] = 10;
			pTemp[playerid][tInterior] = MAD_HOUSE_INT;
		} 
		return 1;
	}  
	
	if (pTemp[playerid][tDMArea][0]) { 
		if (pTemp[playerid][tDMArea][3] == 1) {
			new rand = random(sizeof(DM_Arena_OneSpawnPos));
			SetSpawnInfoEx(playerid, skin, DM_Arena_OneSpawnPos[rand][0], DM_Arena_OneSpawnPos[rand][1], DM_Arena_OneSpawnPos[rand][2], DM_Arena_OneSpawnPos[rand][3]);
			GivePlayerWeapon(playerid, DM_ArenaGun[pTemp[playerid][tDMArea][4]], 1000);
			pTemp[playerid][tVirtualWorld] = 1;
			pTemp[playerid][tInterior] = INTERIOR_NONE;
		} 
		if (pTemp[playerid][tDMArea][3] == 2) 
		{
			new rand = random(sizeof(DM_Arena_TwoSpawnPos));
			SetSpawnInfoEx(playerid, skin, DM_Arena_TwoSpawnPos[rand][0], DM_Arena_TwoSpawnPos[rand][1], DM_Arena_TwoSpawnPos[rand][2], DM_Arena_TwoSpawnPos[rand][3]);
			GivePlayerWeapon(playerid, DM_ArenaGun[pTemp[playerid][tDMArea][4]], 1000);
			pTemp[playerid][tVirtualWorld] = 1;
			pTemp[playerid][tInterior] = INTERIOR_NONE;
		}
		if (pTemp[playerid][tDMArea][3] == 3) 
		{
			new rand = random(sizeof(DM_Arena_ThreeSpawnPos));
			SetSpawnInfoEx(playerid, skin, DM_Arena_ThreeSpawnPos[rand][0], DM_Arena_ThreeSpawnPos[rand][1], DM_Arena_ThreeSpawnPos[rand][2], DM_Arena_ThreeSpawnPos[rand][3]);
			GivePlayerWeapon(playerid, DM_ArenaGun[pTemp[playerid][tDMArea][4]], 1000);
			pTemp[playerid][tVirtualWorld] = 1;
			pTemp[playerid][tInterior] = AIM_DEAGLE_DM;
		} 
		SetPlayerColor(playerid, 0x56FB4EFF);
		SetPlayerHealth(playerid, 160);
		return 1;
	}  
	if (pTemp[playerid][tPaintTeam] && StartPaintBall != 1)
	{
		if (!StartPaintBall) {
			pTemp[playerid][tPaintTeam] 	=
			pTemp[playerid][tPaintKills] 	=
			pTemp[playerid][tPaintDeath] 	= 0;
			pTemp[playerid][tPaintDMG] 		= 0.0;
			for(new td; td < sizeof (paint_TD); td++) {
				TextDrawHideForPlayer(playerid, paint_TD[td]); 
			} 
			PlayerTextDrawDestroy(playerid, tPaintStats[playerid]);
			tPaintStats[playerid] = PlayerText:-1 ;
			SetSpawnInfoEx(playerid, skin, 286.1364, -30.7176, 1001.5156, 181.0381);
			pTemp[playerid][tVirtualWorld] = 1;
			pTemp[playerid][tInterior] = 1; 
		}
		else if (StartPaintBall == 2) {
			skin = SetPlayerSkin(playerid, SkinPaint[ pInfo[playerid][pSex] ][ pTemp[playerid][tPaintTeam] - 1 ] );  
			GivePlayerWeapon(playerid, 24, 1000);
			GivePlayerWeapon(playerid, 25, 1000);
			GivePlayerWeapon(playerid, 31, 1000);

			new rand = random(9); 
			switch(pTemp[playerid][tPaintTeam]) {
				case 1: {  
					SetSpawnInfoEx(playerid, skin, SpawnBlueTeam[PaintBallMap-1][rand][0], SpawnBlueTeam[PaintBallMap-1][rand][1], SpawnBlueTeam[PaintBallMap-1][rand][2], SpawnBlueTeam[PaintBallMap-1][rand][3]);	
				}
				case 2: {  
					SetSpawnInfoEx(playerid, skin, SpawnRedTeam[PaintBallMap-1][rand][0], SpawnRedTeam[PaintBallMap-1][rand][1], SpawnRedTeam[PaintBallMap-1][rand][2], SpawnRedTeam[PaintBallMap-1][rand][3]);
				}
			} 
			
			pTemp[playerid][tVirtualWorld] = 10;
			pTemp[playerid][tInterior] = INTERIOR_NONE;
			SetPlayerColor(playerid, (pTemp[playerid][tPaintTeam] == 1) ? (0x33AAFFFF) : (0xAA3333FF));
			SetPlayerHealth(playerid, 100);
		} 
		SetCameraBehindPlayer(playerid);
		return 1;
	}
	if (pInfo[playerid][pHospital] != 0) {
		new 
			hospital_loc = pInfo[playerid][pHospital];
		switch(hospital_loc) {/* 255 Error, 1 SF, 2 LS, 3 LV */
			
			case 4: {//SF
				static const Float: pos_hospital[][] = {
					{141.7930,1640.4346,995.5758, 0.0},
					{140.0364,1644.9146,995.5768, 270.0},
					{143.5682,1645.1893,995.5768, 90.0}
				}; 
				new rand = random(sizeof(pos_hospital));
				SetSpawnInfoEx(playerid, skin, pos_hospital[rand][0], pos_hospital[rand][1], pos_hospital[rand][2], pos_hospital[rand][3]);
				pTemp[playerid][tVirtualWorld] = 1;
				pTemp[playerid][tInterior] = HOSPITAL_ARMY_INT;
			}
			case 5: {//LV
				static const Float: pos_hospital[][] = {
					{141.7930,1640.4346,995.5758, 0.0},
					{140.0364,1644.9146,995.5768, 270.0},
					{143.5682,1645.1893,995.5768, 90.0}
				}; 
				new rand = random(sizeof(pos_hospital));
				SetSpawnInfoEx(playerid, skin, pos_hospital[rand][0], pos_hospital[rand][1], pos_hospital[rand][2], pos_hospital[rand][3]);
				pTemp[playerid][tVirtualWorld] = 2;
				pTemp[playerid][tInterior] = HOSPITAL_ARMY_INT;
			}
			default: /*case 1, 2, 3: */{ 
				if (hospital_loc == 1) {//sf
					static const Float: pos_hospital[][] = {//sf
						{-2619.8391,616.7123,1338.9753,175.9508},
						{-2619.9187,597.7809,1338.9753,359.5425},
						{-2632.0356,597.7874,1338.9773,0.8193},
