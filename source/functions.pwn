		FractionInfo[15][fMoney] += TotalGzG*300;
		FractionInfo[17][fMoney] += TotalGzA*300;
		FractionInfo[18][fMoney] += TotalGzR*300; 
		GetHome(); 
		GetFarm();
		GetFamilyHome();
		#if defined _businesses_inc
			CheckBusiness();
		#endif
	}
	if (minute == 15 && second == 01) {
		SendGangMessage(0xEEDC82FF, "« Через 15 минут в порт Los Santos Army прибудет поставка боеприпасов »");
	}
	if (minute == 30 && second == 00) {
		gEconomyServer[eMaterialsLSa][0] = 
    	gEconomyServer[eMaterialsLSa][1] = 400_000; 
		SendGangMessage(0xEEDC82FF, "« В порт Los Santos Army прибыли боеприпасы »");
	}
	if (minute == 30 && second == 50) {
		if(Spawncartime) {
			SetTimer ( "spawn_carsooc", 15000, false) ;
 			SendClientMessageToAll(COLOR_YELLOW, "* Через 30 секунд произойдет респавн незанятого транспорта.");
	        SendClientMessageToAll(COLOR_YELLOW, "* Чтобы транспорт не пропал - сядьте в него.");
		}
	}
	if (minute == 25 && second == 00 || minute == 35 && second == 00 || minute == 55 && second == 00) {
		if(ReklamaOOC) {

			    SendClientMessageToAll(COLOR_LIGHTGREEN,!"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
			    SendClientMessageToAll(COLOR_GREEN,!"Получение дополнительных средств "Namesait"/donate.");
			    SendClientMessageToAll(COLOR_LIGHTGREEN,!"Приведи друга, получи деньги. При регистрации необходимо указать ваш ник.");
			    SendClientMessageToAll(COLOR_GREEN,!"Для связи с администрацией введите /mm  Далее выберите репорт.");
			    SendClientMessageToAll(COLOR_LIGHTGREEN,!"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");
		}
	}	

	GrandEndOK = 37;
	if ((hour > ghour) || (hour == 0 && ghour == 23))
	{
		SendMesAll(-1, " Сейчас времени %d:00 часов", hour);
		capture_fix = gettime() + RandomFIX(10, 70);
		ghour = hour;
		curdate = getdate(year, month, day);
		if (hour == 00) {
			PayDayTemp(true);
			CheckBusinessToday();
		}
		else {
			PayDayTemp();
			if (VACANCY_COUNT) SendClientMessageToAll(COLOR_YELLOW, "[Подсказка] "colwhi"Доступные вакансии в организации \"/vacancy\"");
		}
		
		SetWorldTime(hour);
		if (hour == 18 && getDay() == 1) {//Воскресенье 
			mysql_tquery (dbHandle, "SELECT `fID`, `fRepute` FROM `s_fractionbank` WHERE `fID` IN (12,13,15,17,18) ORDER BY `fRepute` DESC LIMIT 3", "ItogWeekGangStats");
		}
		
		if (hour == 14 || hour == 16 || hour == 18) {
			StartDeliveryMats();
		}
	}
	GrandEndOK = 38;
	getdate(year, month, day);
	format(t_string, 56, "%02d:%02d:%02d %02d/%02d/%02d",hour,minute,second,day,month,year);
	TextDrawSetString(CamsTD[11], t_string), t_string[0] = EOS;
	/*for(new i; i < S_ACTOR_COUNT; i++) {
		if(ActorsInfo[i][aTalkTime] > 0 ) {
			ActorsInfo[i][aTalkTime]--;
			if(ActorsInfo[i][aTalkTime] == 0) {
				UpdateDynamic3DTextLabelText(ActorsInfo[i][aTalk], COLOR_GREY, "");
				ApplyDynamicActorAnimation(ActorsInfo[i][aID], "BD_FIRE", "BD_Fire1", 4.1, 0, 0, 0, 0, 1);
				if(i == 6 || i == 7 || i == 8 || i == 9 || i == 10 || i == 11 || i == 12) ApplyDynamicActorAnimation(ActorsInfo[i][aID], "DEALER","Dealer_idle",4.1,0,0,0,1,1);
			}
		}
	}*/

	if (++CheckDeerReSpawn > 120) {
		for(new i = 0; i < S_DEER_COUNT; i++) {
			if (gDeerHunterInfo[i][deerSpawned] && gDeerHunterInfo[i][deerKilled] && !gDeerHunterInfo[i][deerUsePlayer]) {
				if (++gDeerHunterInfo[i][deerCoolDown] > 3) {
					DestroyHunter(i);
				}
			}
			if (!gDeerHunterInfo[i][deerSpawned])  {
				gDeerHunterInfo[i][deerObject] = CreateDynamicObject(19315, gDeerHunterInfo[i][deerPos][0], gDeerHunterInfo[i][deerPos][1], gDeerHunterInfo[i][deerPos][2], 0.000000, 0.000000, 0.000000, 0, 0, -1, 200.00, 200.00);
				gDeerHunterInfo[i][deerSpawned] = true;
				gDeerHunterInfo[i][deerUsePlayer] = false;
			}
		}
		CheckDeerReSpawn = 0;
		//SendClientMessageToAll(COLOR_RED, !"Spawn Deer");
	}

	GrandEndOK = 39;
	//старый
	/*if (hour == 05 && minute == 01 && (second == 15 || second == 16))
	{
		ServerRestart();
		SetTimer("GameModeExitDelay", 30_000, false);
		SendClientMessageToAll(COLOR_RED, !"");
		SendClientMessageToAll(COLOR_RED, !"");
		SendClientMessageToAll(COLOR_RED, !"_______________=======[Внимание!Рестарт сервера через 30 секунд]=======_______________");
		SendClientMessageToAll(COLOR_RED, !"");
		SendClientMessageToAll(COLOR_RED, !"");
	}*/
	//новый
	if(hour == 05 && minute == 01 && second == 05)
	{
		ServerRestart();
		SetTimer("GameModeExitDelay",5000,false);
		SendClientMessageToAll(COLOR_RED, !"");
		SendClientMessageToAll(COLOR_RED, !"");
		SendClientMessageToAll(COLOR_RED, !"_______________=======[Внимание!Рестарт сервера через 5 секунд]=======_______________");
		SendClientMessageToAll(COLOR_RED, !"");
		SendClientMessageToAll(COLOR_RED, !"");
	}
	GrandEndOK = 40;
	Event_SecondTimer();  
	#if defined _a_event_inc 
		Event:OnSecondTimer();
	#endif
	Fraction_SecondTimer();
	GrandEndOK = 41;
	MoveCash_SecondTimer();
	SettingServer[2] = GetTickCount() - tickcount1;
	if (SettingServer[2] > SettingServer[3]) SettingServer[3] = SettingServer[2];
	GrandEndOK = 0;
	return 1;
}
stock ShowStats(playerid, targetid)
{
	if (!PlayerInConnected(targetid)) return 1;
	SetPlayerUpdateRating(targetid);
	new 
		drank[20], 
		vip_name[25], boost_name[25]; 
	switch(pInfo[targetid][pLevel])
	{
		case 1 .. 5: drank = "Новичок";
		case 6 .. 15: drank = "Освоившийся";
		case 16: drank = "Постоянный игрок";
		default: drank = "Дед";
	} 
	GetVIPRankName(targetid, vip_name);
	
	new exp = pInfo[targetid][pExp],
		nxtlevel = pInfo[targetid][pLevel]+1,
		expamount = nxtlevel * 4,
		Float: fishes = pInfo[targetid][pFishes],
		str_[128];
    t_string[0] = EOS;
	new temp_warn[40];

	new date_[6];
	if (pInfo[targetid][punWarns] != 0)
	{
		TimestampToDate(pInfo[targetid][punWarns],date_[0],date_[1],date_[2],date_[3],date_[4],date_[5],3);
		format(temp_warn,sizeof(temp_warn),"%02d/%02d/%02d %02d:%02d:%02d",date_[2],
		date_[1],date_[0],date_[3],date_[4],date_[5]);
	}
	format(str_, sizeof str_,""colwhi"Донат счётчик::\t\t\t"colwarn"%d\n", pInfo[targetid][pDonate]);
	strcat(t_string, str_);
	format(str_, sizeof str_,""colwhi"Устройство:\t\t\t%s\n", player_mobile[targetid] ? ("Mobile") : ("PC"));
	strcat(t_string, str_);
	format(str_, sizeof str_, ""colwhi"Имя:\t\t\t%s\n", pInfo[targetid][pName]);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Уровень:\t\t\t%d\nРейтинг:\t\t\t%.2f\n", pInfo[targetid][pLevel], pInfo[targetid][pRating]);
	strcat(t_string, str_); 
	format(str_, sizeof(str_),""colwhi"Exp:\t\t\t\t%d/%d\n", exp,expamount);
	strcat(t_string, str_);
	format(str_, sizeof str_, ""colwhi"Статус VIP:\t\t\t%s\n", vip_name);
	strcat(t_string, str_);
	GetBoostRankName(targetid, boost_name);
	format(str_, sizeof str_, ""colwhi"Стартовый пакет:\t\t%s\n", boost_name);//convert_money(
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Деньги:\t\t\t$%s\n", convert_money(pInfo[targetid][pCash]));
	strcat(t_string, str_); 
	format(str_, sizeof str_,""colwhi"Деньги в банке:\t\t\t$%s\n", convert_money(pInfo[targetid][pBank]));
	strcat(t_string, str_);
	if (pInfo[playerid][pAdmin] > 0) {  
		format(str_, sizeof str_,""colwhi"Деньги на депозите:\t\t%d\n", pInfo[targetid][pDeposit]);
		strcat(t_string, str_);  
	}
	format(str_, sizeof(str_),""colwhi"Телефон:\t\t\t%d\n", pInfo[targetid][PlayerNumber]);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Варнов:\t\t\t%d\n", pInfo[targetid][pWarns]);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Снятие варна:\t\t\t%s\n", !pInfo[targetid][punWarns] ? ("нет варна") : temp_warn);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Законопослушность:\t\t%d\n", pInfo[targetid][pZakonp]);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Преступлений:\t\t\t%d\n", pInfo[targetid][pCrimes]);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Арестов:\t\t\t%d\n", pInfo[targetid][pArrested]);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Смертей в розыске:\t\t%d\n", pInfo[targetid][pWantedDeaths]);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Уровень розыска:\t\t%d\n", pInfo[targetid][pWantedLevel]);
	strcat(t_string, str_);
	TimestampToDate(pInfo[targetid][DataReg],date_[0],date_[1],date_[2],date_[3],date_[4],date_[5],3);
	format(temp_warn,sizeof(temp_warn),"%02d/%02d/%02d %02d:%02d:%02d",date_[2],
	date_[1],date_[0],date_[3],date_[4],date_[5]);
	format(str_, sizeof(str_),""colwhi"Дата регистрации:\t\t%s\n", temp_warn);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Зависимость:\t\t\t%d\n", pInfo[targetid][pAddiction]);
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Тяжелые наркотики:\t\t%d/%d\n", pInfo[targetid][pDrugs], GetVIPLimitDrugs(targetid));
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Легкие наркотики:\t\t%d/%d\n", pInfo[targetid][pLDrugs], GetVIPLimitDrugs(targetid));
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Материалы:\t\t\t%d/%d\n", pInfo[targetid][pMats], GetVIPLimitMaterials(targetid));
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Рыб поймано:\t\t\t%.1f кг\n", fishes);
	strcat(t_string, str_);///

	format(str_, sizeof(str_),""colwhi"Организация:\t\t\t%s\n", gFraction[pInfo[targetid][pMember]][fName]);
	strcat(t_string, str_);
	if (pInfo[targetid][pMember] != 0)
	{
		format(str_, sizeof(str_),""colwhi"Ранг:\t\t\t\t%s (%d)\n", fFractionRank[pInfo[targetid][pMember]][pInfo[targetid][pRank] - 1], pInfo[targetid][pRank]);
		strcat(t_string, str_);
		format(str_, sizeof(str_),""colwhi"Выговоры:\t\t\t(%d/3)\n", pInfo[targetid][FractionWarn]);
		strcat(t_string, str_);
	}
	format(str_, sizeof(str_),""colwhi"Работа:\t\t\t\t%s\n", gJobNames[ pInfo[targetid][pJob] ] );
	strcat(t_string, str_);
	format(str_, sizeof(str_),""colwhi"Статус:\t\t\t\t%s\n", drank);
	strcat(t_string, str_);


	if (!GetString(pInfo[targetid][pMarriedTo],"-")) format(str_, sizeof(str_),""colwhi"%s:\t\t\t\t%s\n", (pInfo[targetid][pSex] == 1)?("Жена"):("Муж"),  pInfo[targetid][pMarriedTo]);
	else format(str_, sizeof(str_),""colwhi"%s:\t\t\t\tНе состоит в браке\n", (pInfo[targetid][pSex] == 1)?("Жена"):("Муж"));
	strcat(t_string, str_);

	format(str_, sizeof str_, ""colwhi"Пол:\t\t\t\t%s\n", (pInfo[targetid][pSex] == 1)?("Мужской"):("Женский"));
	strcat(t_string, str_);



	if (pInfo[targetid][pHouseID] != -1) { 
		format(str_, sizeof str_, ""colwhi"Дом:\t\t\t\t"collime"%d\n", pInfo[targetid][pHouseID]);
		strcat(t_string, str_);
	}  
	else strcat(t_string, ""colwhi"Дом:\t\t\t\t"colwarn"Отсутствует\n");
	if (pInfo[targetid][pRentHouse] != -1) {
		format(str_, sizeof str_, ""colwhi"Прописка в доме:\t\t"collime"%d\n", pInfo[targetid][pRentHouse]);
		strcat(t_string, str_); 
	}  
	else strcat(t_string, ""colwhi"Прописка в доме:\t\t"colwarn"Отсутствует\n");  

	new
        strTitle[122]; 
    format(strTitle, sizeof strTitle, ""colserver"Рейтинг:\t\t"colwhi"%.2f "colserver"| %s", pInfo[targetid][pRating]);

	/*if (Iter_Count(PlayerListVehicle[targetid]) != 0) {
		foreach(new V_IDX:PlayerListVehicle[targetid]) {
			GetVehicleParamsEx(V_IDX, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
			format(str_, sizeof str_, "\n{AFAFAF}%s(%d)\nСтатус блокировки: [%s] \nНе оплаченый налог: [$%d]\n",
				VehicleNames[ VehicleInfo[ V_IDX - 1 ][vModel] - 400], VehicleInfo[ V_IDX - 1 ][vModel], doors3 >= 1 ? ("Закрыт"):("Открыт"), VehicleInfo[ V_IDX - 1 ][vTax]
			);
			strcat(t_string, str_);
		}
	}*/
	
	/*if (pInfo[playerid][pAdmin] > 0)
	{
		#if defined _promo_referal_inc PromoCode:getPlayerPromoName(PromoCode:GetPlayerData(targetid, uCodeID))
			format(str_, sizeof str_,
				""colserver"Промокод указаный при регистрации: %s.\n", 
				PromoCode:getPlayerPromoName(PromoCode:GetPlayerData(targetid, uCodeID))
			);
			strcat(t_string, str_);
		#else
			format(str_,sizeof(str_),""colserver"Промокод указаный при регистрации: %s.\n", GetPlayerPromoCodeSearch(pInfo[targetid][PromoCode]));
			strcat(t_string, str_);
		#endif
		 промо
	    format(str_,sizeof(str_),"\n\n\n"colserver"В игре с момента последнего входа уже: %s.\n", Convert(pInfo[targetid][pInGame]));
		strcat(t_string, str_);
		format(str_,sizeof(str_),""colserver"В игре пробыл в последний день входа: %s.\n", Convert(pInfo[targetid][pInGameDay]));
		strcat(t_string, str_);
		format(str_,sizeof(str_),""colserver"С момента регистрации уже играет: %s.\n\n", Convert(pInfo[targetid][pInGameAllTime]));
		strcat(t_string, str_);
		format(str_,sizeof(str_),""colserver"ID Аккаунта: %d\n", pInfo[targetid][pID]);
		strcat(t_string, str_);
		if (pInfo[targetid][pMember] > 0) {
		    format(str_,sizeof(str_),""colserver"В организации состоит уже: %s.\n\n", Convert(pInfo[targetid][pInGameMember]));
			strcat(t_string, str_);
		}
	}*/
	ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_LIST, ""colserver"Статистика: "colwhi"Персонажа", t_string, "Готово", "");
	return 1;
}


stock ShowStatsMDC(playerid,targetid)
{
	if (IsPlayerConnected(playerid) && IsPlayerConnected(targetid))
	{
		new ttext[21];
		switch(pInfo[targetid][pMember])
		{
		    case 1: ttext = "LSPD";
		    case 2: ttext = "ФБР";
		    case 3: ttext = "Армия СФ";
		    case 4: ttext = "Медики СФ";
		    case 5: ttext = "La Cosa Nostra";
		    case 6: ttext = "Yakuza";
		    case 7: ttext = "Мэрия";
		    case 8: ttext = "Casino";
		    case 9: ttext = "SF News";
		    case 10: ttext = "SFPD";
		    case 11: ttext = "Автошкола";
		    case 12: ttext = "Ballas Gang";
		    case 13: ttext = "Vagos Gang";
		    case 14: ttext = "Русская Мафия";
		    case 15: ttext = "Grove Street";
		    case 16: ttext = "LS News";
		    case 17: ttext = "Aztecas Gang";
		    case 18: ttext = "Rifa Gang";
		    case 19: ttext = "Армия ЛВ";
		    case 20: ttext = "LV News";
		    case 21: ttext = "LVPD";
		    case 22: ttext = "Медики ЛС";
		    case 23: ttext = "Медики ЛВ";
		    case 24: ttext = "Mongols MC";
		    case 25: ttext = "Bandidos MC";
		    case 26: ttext = "Outlaws MC";
			default: ttext = "Нет";
		}
		new str_[64];
		t_string[0] = EOS;
		format(str_, sizeof(str_),"Имя:\t\t\t\t%s\n", pInfo[targetid][pName]);
		strcat(t_string, str_);
		format(str_, sizeof(str_),"Пол:\t\t\t\t%s\n", (pInfo[targetid][pSex] == 1)?("Мужской"):("Женский"));
		strcat(t_string, str_);
		format(str_, sizeof(str_),"Телефон:\t\t\t%d\n\n", pInfo[targetid][PlayerNumber]);
		strcat(t_string, str_);
		format(str_, sizeof(str_),"Преступлений:\t\t%d\n", pInfo[targetid][pCrimes]);
		strcat(t_string, str_);
		format(str_, sizeof(str_),"Арестов:\t\t\t%d\n", pInfo[targetid][pArrested]);
		strcat(t_string, str_);
		format(str_, sizeof(str_),"Уровень розыска:\t\t%d\n", pInfo[targetid][pWantedLevel]);
		strcat(t_string, str_);
		format(str_, sizeof(str_),"Организация:\t\t\t%s\n", ttext);
		strcat(t_string, str_);
		if (pInfo[targetid][pMember] != 0)
		{
			format(str_, sizeof(str_),"Ранг:\t\t\t\t%s\n", fFractionRank[ pInfo[targetid][pMember]][pInfo[targetid][pRank] - 1]);
			strcat(t_string, str_);
		}
		format(str_, sizeof(str_),"Работа:\t\t\t%s\n", gJobNames[pInfo[targetid][pJob]]);
		strcat(t_string, str_);
		format(str_, sizeof(str_),"Жена/Муж:\t\t\t%s\n", pInfo[targetid][pMarriedTo]);
		strcat(t_string, str_);
		ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, "Подробная информация", t_string, "Закрыть", "");
	}
	return 1;
}

new lastDShot[MAX_PLAYERS];

#define CBUG_INTERVAL_DEAGLE    700
#define CBUG_INTERVAL_SHOTGUN   1000
//#define CBUG_INTERVAL_COMBATSG  340
//#define CBUG_INTERVAL_COUNTRY   850
//#define CBUG_INTERVAL_SNIPER    850

stock IsCbugWeapon(weaponID)
{
    if(weaponID == 22 || weaponID == 24 || weaponID == 25 || weaponID == 27)
    {
        return 1;
    }
    return 0;
}

stock IsCbugTime(weaponid)
{
	switch (weaponid)
	{
		case 24: return CBUG_INTERVAL_DEAGLE;
		case 25: return CBUG_INTERVAL_SHOTGUN;
	}
	return 0;
}

stock GetWeaponSkill(weaponid)
{
    switch(weaponid)
    {
        case 23: return 0;
        case 24: return 1;
        case 25: return 2;
        case 29: return 3;
        case 30: return 4;
        case 31: return 5;
        default: return 0xFFFF;
    }
    return 0xFFFF;
}
stock GetShotsSkillLevel(type)
{
    switch(type)
    {
        case 0: return 10;
        case 1: return 7;
        case 2: return 5;
        case 3: return 25;
        default: return 35;
    }
    return 35;
}


stock GetSkillLevel(weaponid)
{
    switch(weaponid)
    {
        case 23: return WEAPONSKILL_PISTOL_SILENCED;
        case 24: return WEAPONSKILL_DESERT_EAGLE;
        case 25: return WEAPONSKILL_SHOTGUN;
        case 29: return WEAPONSKILL_MP5;
        case 30: return WEAPONSKILL_AK47;
        case 31: return WEAPONSKILL_M4;
        default: return 0;
    }
    return 0;
}


stock MySQLConnectToServerDataBase()
{
	dbHandle = mysql_connect("", "", "", ""); // dragon
    mysql_log(ERROR);
	switch(mysql_errno(dbHandle))
	{
	    case 0:
		{
			print(!"[MySQL] Подключение к базе данных удалось");
			mysql_set_charset("cp1251");
            mysql_tquery(dbHandle, "SET CHARACTER SET 'utf8'", "", "");
		    mysql_tquery(dbHandle, "SET NAMES 'utf8'", "", "");
		    mysql_tquery(dbHandle, "SET character_set_client = 'cp1251'", "", "");
		    mysql_tquery(dbHandle, "SET character_set_connection = 'cp1251'", "", "");
		    mysql_tquery(dbHandle, "SET character_set_results = 'cp1251'", "", "");
		    mysql_tquery(dbHandle, "SET SESSION collation_connection = 'utf8_general_ci'", "", "");
			
			// Очистка логов позднее 30 суток
			mysql_query(dbHandle, "DELETE FROM `s_logs_money` WHERE date < NOW() - INTERVAL 30 DAY;");
			mysql_query(dbHandle, "DELETE FROM `s_logs_f_money` WHERE date < NOW() - INTERVAL 30 DAY;");
			mysql_query(dbHandle, "DELETE FROM `sh_connect` WHERE Timestamp < NOW() - INTERVAL 30 DAY;");
			mysql_query(dbHandle, "DELETE FROM `sl_users` WHERE timestsamp < NOW() - INTERVAL 30 DAY;");
			mysql_query(dbHandle, "DELETE FROM `sl_admins` WHERE timestsamp < NOW() - INTERVAL 30 DAY;");

			LoadBusinesses(); // 
			House_OnGameModeInit();
			SeatDown_OnGameModeInit();
			MoveCash_OnGameModeInit(); 
			OnLoadDiplomationCriminals();//Cache
			mysql_tquery(dbHandle, "SELECT * FROM `s_fraction`", "OnMySQL_QUERY", "iis", MYSQL_LOAD_FRACTION, -1, "");  
			mysql_tquery(dbHandle, "SELECT * FROM `farms`", "OnMySQL_QUERY", "iis", MYSQL_LOAD_FARMS, -1, "");// AND `vJakcer` > '0'
			Vehicle_OnGameModeInit(); 
		    mysql_tquery(dbHandle, "SELECT * FROM `casino`", "OnMySQL_QUERY", "iis", MYSQL_LOAD_CASINO, -1, ""); 
		    mysql_tquery(dbHandle, "SELECT * FROM `s_stall`", "OnMySQL_QUERY", "iis", MYSQL_LOAD_OTHER_STALL, -1, "");
		    mysql_tquery(dbHandle, "SELECT * FROM `s_gangzone`", "OnMySQL_QUERY", "iis", MYSQL_LOAD_GANGZONE, -1, "");
		    mysql_tquery(dbHandle, "SELECT * FROM `s_graffiti`", "OnMySQL_QUERY", "iis", MYSQL_LOAD_GRAFFITI, -1, "");
		    mysql_tquery(dbHandle, "SELECT * FROM `s_fractionbank`", "OnMySQL_QUERY", "iis", MYSQL_LOAD_FRACTION_BANK, -1, ""); 
			mysql_tquery(dbHandle, "SELECT * FROM `s_billboards`", "LoadBilbords",""); 
  			mysql_tquery(dbHandle, "SELECT * FROM anticheat_settings ORDER BY ac_code","UploadAntiCheatSettings");
			mysql_tquery(dbHandle, "SELECT * FROM `ac_settings`", "LoadAcSettings","");	
			Family_OnGameModeInit();
			Fraction_OnGameModeInit();
			BoostServer_OnGameModeInit();
			ATM_OnGameModeInit();
			LoadBoostPack(); 
			LoadVIPPack();

			if ((((gettime()+2*3600)/86400)%7) == 4){
				mysql_tquery(dbHandle, "\
					UPDATE `s_admin` SET `s_Reports` = '0', `s_Ask` = '0', `s_Bans` = '0', `s_Warns` = '0', \
					`s_Mutes` = '0', `s_Reputes` = '0', `s_Jails` = '0', `s_Prisons` = '0', `s_OTime` = '0'", "", ""
				);
				mysql_tquery(dbHandle, "UPDATE "TABLE_SUPPORTS" SET sOnline = '0'");
			}
			if (day == 1) {
				mysql_tquery(dbHandle, "UPDATE s_users SET MadTime = '0', pCharity = '0'"); 
			}
			mysql_tquery (dbHandle, "SELECT `Name`,`pLevel`,`pCharity` FROM `s_users` WHERE `pLevel` != 0 ORDER BY `pCharity` DESC LIMIT 5", "LoadTopServer");
			mysql_tquery (dbHandle, "SELECT `Name`,`MadTime` FROM `s_users` WHERE `MadTime` != 0 ORDER BY `MadTime` DESC LIMIT 5", "LoadTopMadHouse");
		}
	    case 1044: print(!"[MySQL] Подключение к базе данных не удалось [Указано неизвестное имя пользователя]");
	    case 1045: print(!"[MySQL] Подключение к базе данных не удалось [Указан неизвестный пароль]");
	    case 1049: print(!"[MySQL] Подключение к базе данных не удалось [Указана неизвестная база данных]");
	    case 2003: print(!"[MySQL] Подключение к базе данных не удалось [Хостинг с базой данных недоступен]");
	    case 2005: print(!"[MySQL] Подключение к базе данных не удалось [Указан неизвестный адрес хостинга]");
	    default: printf("[MySQL] Подключение к базе данных не удалось [Неизвестная ошибка. Код ошибки: %d]", mysql_errno());
	}
	return 1;
}

publics: GetClosestforeach(p1)
{
	new Float:dis,Float:dis2,player;
	player = -1;
	dis = 99999.99;
	foreach(new x: PlayerInLogin)
	{
		if (x != p1)
		{
			dis2 = GetDistanceBetweenPlayers(x,p1);
			if (dis2 < dis && dis2 != -1.00)
			{
				dis = dis2;
				player = x;
			}
		}
	}
	return player;
}
stock PayChecks(i)
{
    if (pInfo[i][pZakonp] < 100) pInfo[i][pZakonp]++;
    if (pInfo[i][pZakonp] > 100) pInfo[i][pZakonp] = 100;
    //if (pTemp[i][tDutyWork] == 0) return 0;
	/*if (IsACop(i) && IsAArmy(i) && IsAMedic(i) && IsAMayor(i) && IsALicenser(i) && IsANews(i)) {
		SendClientMessageToAll(-1, "GOS FRACTINO");
		if (FractionInfo[7][fMoney] <=0) {
			scm(i, COLOR_GREY, !"[Мэрия] Казна штата пуста, зарплаты нет...");
			return 0;
		}
	} */
	if (!IsAMafia(i) && !IsAGang(i) && pInfo[i][pMember] && fFractionSalary[pInfo[i][pMember]][pInfo[i][pRank] - 1]) 
	{
		new salary = 0;
		if (FractionInfo[7][fMoney] <=0) {
			SendClientMessage(i, COLOR_GREY, !"[Мэрия] Казна штата пуста, зарплаты нет...");
			return salary;
		}
		salary = fFractionSalary[pInfo[i][pMember]][pInfo[i][pRank] - 1];
		if (salary > FRACTION_MAX_SALARY) salary = FRACTION_MAX_SALARY;
		return salary;
	}
	else if (IsAMafia(i)) return 3500+(pInfo[i][pRank]*1000); 
	else if (IsAGang(i))
	{
	    new null = 0;
        for(new idx = 1; idx <= TOTALGZ; idx++) {
			if (GZInfo[idx][gFrakVlad] == pInfo[i][pMember]) {
				null++;
			}
		}
        return null*50;
	}
	return 0;
}
stock PayDayTemp(bool: newday = false)
{
    for(new i; i < max_war_capture; i++) {
	    if (capture_now[i] == 0 && capture_start[i] > 0) {
	        capture_start[i] --;
	    }
	}
	for(new i; i < FRACTION_COUNT; i++ )
	{
		if(gFraction[ i ][fPrizeTime] > 0 ){
			gFraction[ i ][fPrizeTime]--;
		}
	}
	foreach(new i: PlayerInLogin)
	{
		if (!IsPlayerConnected(i) || (!pInfo[i][pLogin])) continue;
		PayDay(i);
		Sonar[i] = random(2000);
		pTemp[i][tTimeInHour] = 0;
		if (newday == true) {
			gOnlinePlayer[i][1]      = gOnlinePlayer[i][0];
			gOnlinePlayerAFK[i][1]   = gOnlinePlayerAFK[i][0];
			gOnlinePlayer[i][0]      = 0;
			gOnlinePlayerAFK[i][0]   = 0;
		}
	    if (pInfo[i][pWantedLevel] > 0)
		{
   			new tip_city = -1; 
			if (AC_Info[i][acPosX] < 0) tip_city = 1;
			else if (AC_Info[i][acPosY] > 100.0) tip_city = 2;
			else tip_city = 0;
			switch(tip_city)
			{
			  case 0: INFOPD[0]++;
			  case 1: INFOPD[1]++;
			  case 2: INFOPD[2]++;
			  default: INFOPD[3]++;
			} 
		}
		traning[i] = false;
		if (GetPlayerTaxi{i} == 1) UpdatePlayerTaxiExp(i,1);
	}
	return 1;
}

stock UpdatePlayerExp(playerid, count_exp = 1)
{ 
	OnPlayerAchievProgress(playerid, 0);
	OnPlayerAchievProgress(playerid, 3);
	OnPlayerAchievProgress(playerid, 5); 
	new query_[128];
	pInfo[playerid][pExp] += count_exp;
	if (pInfo[playerid][pExp] >= ((pInfo[playerid][pLevel]+1)*4)-1)
	{
		pInfo[playerid][pLevel] ++;
		pInfo[playerid][pExp] = 0;

		PromoCode:CheckingForPromoCodePlayer(playerid);
		//#endif
		if (pInfo[playerid][pLevel] == REFERAL_LEVEL_AWARD){
			new referalid; 
			sscanf(pInfo[playerid][Referal], "u", referalid);
	
			if (!strcmp(pInfo[playerid][Referal], "-", false)) {
				SendClientMessage(playerid, COLOR_BLUE, !"Вы не указали своего реферала. А он мог получить $"#REFERAL_MONEY_AWARD"");
			}
			else if (IsPlayerConnected(referalid) && pInfo[referalid][pLogin] && !strcmp(pInfo[referalid][pName], pInfo[playerid][Referal], true)) {
				pInfo[referalid][pBank] += REFERAL_MONEY_AWARD;
				SavePlayerInteger(referalid, "pBank", pInfo[referalid][pBank]);

				LogMoney(playerid, REFERAL_MONEY_AWARD, "за рефералла");
				
				format(t_string, sizeof t_string, "Вы получили за приглашения %s. +$%d на банковский счет!",
					pInfo[playerid][pName], REFERAL_MONEY_AWARD
				);
				SendClientMessage(referalid, COLOR_GREEN, t_string), t_string[0] = EOS;
			} else {
				mysql_format(dbHandle, query_, sizeof query_, "UPDATE `s_users` SET `pBank` = `pBank`+"#REFERAL_MONEY_AWARD" WHERE `Name` = '%s' LIMIT 1",
					pInfo[playerid][Referal]
				);
				mysql_tquery(dbHandle, query_, "", "");
			}
		}

		format(query_, sizeof query_,"`pLevel` = '%i', `pExp` = '%i', `pBank` = '%i'",pInfo[playerid][pLevel], pInfo[playerid][pExp], pInfo[playerid][pBank]);
		SavePlayerStr(playerid, query_); 
		SendClientMessage(playerid, COLOR_LIGHTGREEN, !"Поздравляем! Ваш уровень повысился");
	 	SetPlayerScore(playerid, pInfo[playerid][pLevel]);
		// обновление ЛВЛ
	}
	else {
		format(query_, sizeof query_,"`pExp` = '%i', `pBank` = '%i'", pInfo[playerid][pExp], pInfo[playerid][pBank]);
		SavePlayerStr(playerid, query_); 
	}
	return 1;
}
publics: OnPlayerGivePromoItems(playerid) {
	if (cache_num_rows()) {
		new	
			items_id; 
		cache_get_value_name_int(0, "items", items_id);
		if (items_id != 0) {
			GivePlayerItem(playerid, items_id, 1); 
			new 
				string_[128];
			format(string_, sizeof string_, "Поздравляем! За активацию промо-кода вы получили акссесуар: %s", 
				inventory_items[ items_id ][ITEM_NAME]);
			SendClientMessage(playerid, COLOR_BLUE, string_);
		}
	}
	return 1;
}
stock UpdatePlayerTaxiExp(playerid, count_exp = 1)
{
	pInfo[playerid][pTaxiExp] += count_exp;
	if (pInfo[playerid][pTaxiExp] >= ((pInfo[playerid][pTaxiLevel]+1)*4)-1)
	{
		pInfo[playerid][pTaxiLevel]++;
		pInfo[playerid][pTaxiExp] = 0;
		SendClientMessage(playerid, COLOR_BLUE, !"Поздравляем! Ваш лвл таксиста повысился"); 
	} 
}

stock GetPlayerBoostName(playerid,result_str[],length,size = sizeof(result_str))
{
	result_str[0] = '\0';
    if (length > size) {
        length = size - 1;
    }
    if (length < 1) {
        return 0;
    }
	static const boost_name[6][19] = {
		"[server]",
		"[Стартовый]",
		"[Профессиональный]",
		"[Авторитет]",
		"[Босс]",
		"[Гетто тащер]"
	};
	if(pInfo[playerid][BoostRank] < 0 || pInfo[playerid][BoostRank] > 5) format(result_str,19,"[ERROR]");
	else { 
		format(result_str,19,"%s",boost_name[pInfo[playerid][BoostRank]]);
	}
	return 1;
}

stock GetPlayerVipName(playerid,result_str[],length,size = sizeof(result_str))
{
	result_str[0] = '\0';
    if (length > size) {
        length = size - 1;
    }
    if (length < 1) {
        return 0;
    }
	static const vip_name[5][19] = {
		"{D2691E}[BRONZE]",
		"{C0C0C0}[SILVER]",
		"{FFD700}[GOLD]",
		"{FF00FF}[PLATINUM]",
		"{4285b4}[DIAMOND]"
	};
	if(pInfo[playerid][VIPRank] < 1 || pInfo[playerid][VIPRank] > 5) format(result_str,19,"[ERROR]");
	else {
		format(result_str,19,"%s",vip_name[pInfo[playerid][VIPRank]-1]); 
	}
	return 1;
}

stock PayDay(playerid)
{ 
 	new
		string_[160];
  	if (pInfo[playerid][pLastData] != curdate)
	{
		mysql_format(dbHandle, string_, sizeof string_, 
			"UPDATE `s_users` SET `LastData` = '%d', `InGameDay` = '0', `pGetonDate` = '%d/%d/%d %d:%d' WHERE `pID` = '%d' LIMIT 1",
			curdate, day, month, year, hour, minute, pInfo[playerid][pID]
		);
		mysql_tquery(dbHandle, string_, "", "");
		pInfo[playerid][pInGameDay] = 0;
		pInfo[playerid][pLastData] = curdate;
	}
	PlayerTraning[playerid] = false;
    pTemp[playerid][TempUseHealth] = 0;
	
	new pay_checks = pInfo[playerid][pPayCheck]; 
	pay_checks += PayChecks(playerid);
	SendClientMessage(playerid, COLOR_GRAD1, !"--------===[ КЛИЕНТ БАНКА SA ]===-------"); 
	GameTextForPlayer(playerid, !"PayDay", 5000, 1);
	if (!NoNalog(playerid))
	{
		if (pay_checks >= 500)
		{ 
			format(string_, sizeof(string_), "***** Налог государству: -$%d *****", FractionInfo[7][fTaxState]);
			SendClientMessage(playerid, 0xFF8C37AA, string_);
			pay_checks -= FractionInfo[7][fTaxState];
			SetMoveCashServer(IN_NALOG_SERVER, FractionInfo[7][fTaxState]); 
			FractionInfo[7][fMoney] += FractionInfo[7][fTaxState];
		}
		else SendClientMessage(playerid, 0xFF8C37AA, !"***** Налог государству: -$0 *****");
	}//20000
	
	if (pInfo[playerid][pBank] > 50 && pInfo[playerid][pKrisha] != 0)
	{
		pInfo[playerid][pBank] -= 50;
		pInfo[playerid][pDolg] += 50;
	}
	if (kLibGetPlayerMoney(playerid) > 50 && pInfo[playerid][pKrisha] != 0)
	{
		kLibGivePlayerMoney(playerid, -50, "[pKrisha] [pDolg] += 50;", .save = false);
		pInfo[playerid][pDolg] += 50;
	}
	format(string_, sizeof(string_), " Счёт за телефон: -$%d", pInfo[playerid][pMobile]);
	SendClientMessage(playerid, 0xFF8C37AA, string_);
	pInfo[playerid][pBank] -= pInfo[playerid][pMobile]; 
	pInfo[playerid][pMobile] = 0;
	SendClientMessage(playerid, COLOR_WHITE, !" ");

	new pay_checks_default = pay_checks,
		pay_checks_vip;

	if(gBoostServer[sBoost] || pInfo[playerid][BoostRank] > 1) pay_checks = GetVipBoostMaxPlayerValue(playerid, vPercentfSalary, bPercentfSalary, pay_checks);

	if(pay_checks > pay_checks_default) pay_checks_default = pay_checks-pay_checks_default;
	else pay_checks_default = 0;

	pay_checks_vip = pay_checks;

	pay_checks += GetVipPackPlayerValue(playerid, vMoney);
	if(pay_checks > pay_checks_vip) pay_checks_vip = pay_checks-pay_checks_vip;
	else pay_checks_vip = 0; 

	new pay_check_no_boost = pay_checks-pay_checks_default-pay_checks_vip;

	switch(pInfo[playerid][pMember])
	{
		case 1, 10, 21: format(string_, sizeof string_, " Зарплата Полиции: $%d", pay_check_no_boost);
		case 2: format(string_, sizeof string_, " Зарплата ФБР: $%d", pay_check_no_boost);
		case 3, 19: format(string_, sizeof string_, " Зарплата Армии: $%d", pay_check_no_boost);
		case 4, 22, 23: format(string_, sizeof string_, " Зарплата Медиков: $%d", pay_check_no_boost);
		case 5, 6, 14: format(string_, sizeof string_, " Зарплата организации: $%d", pay_check_no_boost);
		case 7: format(string_, sizeof string_, " Зарплата Мэрии: $%d", pay_check_no_boost);
		case 9, 16, 20: format(string_, sizeof string_, " Зарплата Новостей: $%d", pay_check_no_boost);
		case 11: format(string_, sizeof string_, " Зарплата Автошколы: $%d", pay_check_no_boost);
		case 8, 12, 13, 15, 17, 18: {
			format(string_, sizeof string_, " Зарплата Бандитов: $%d + за граффити $%d", pay_check_no_boost, tFractionGraffiti[pInfo[playerid][pMember]] * 20);
			pInfo[playerid][pBank] += tFractionGraffiti[pInfo[playerid][pMember]] * 20;
		}
		default: format(string_, sizeof string_, " Зарплата: $%d", pay_check_no_boost);
	}
	SendClientMessage(playerid, COLOR_WHITE, string_); 
	if(pInfo[playerid][pLevel] >= GetEconomyServer(ePensionAge) && !GetString(fInfo[FRACTION_CITYHALL][fLeader], "None")) {
		format(string_, sizeof string_, " Пенсия: $%i", GetEconomyServer(ePension));
		SendClientMessage(playerid, COLOR_WHITE, string_);
		pInfo[playerid][pBank] += GetEconomyServer(ePension);
		SetMoveCashServer(IN_PENSION, GetEconomyServer(ePension)); 
	}
	if (pay_checks_default > 0 ) {
		new pack_boost[19];
		GetPlayerBoostName(playerid,pack_boost,sizeof(pack_boost)-1);

		format(string_, sizeof string_, " Зарплата от %s pack'a : $%d", pack_boost,pay_checks_default);
		SendClientMessage(playerid, COLOR_WHITE, string_);
	}
	if (pay_checks_vip > 0 ) {
		new vip_boost[19];
		GetPlayerVipName(playerid,vip_boost,sizeof(vip_boost)-1);

		format(string_, sizeof string_, " Зарплата от %s {FFFFFF}pack'a : $%d", vip_boost,pay_checks_vip);
		SendClientMessage(playerid, COLOR_WHITE, string_);
	}


	pInfo[playerid][pBank] += pay_checks;
	LogMoney(playerid, pay_checks, "зарплата PayDay");

	if (SupportInfo[playerid][sDuty]) {
	    SendClientMessage(playerid, -1, !" Зарплата Support's: {66CC00}$5.000");
		pInfo[playerid][pBank] += 5000;
		LogMoney(playerid, pay_checks, "зарплата Supports");
	}
	if (pInfo[playerid][pAdmin] && pInfo[playerid][pMember] == 0) {
		new 
			salary_adm = (pInfo[playerid][pAdmin]*10000);
		format(string_, sizeof string_, " Зарплата администратора: {66CC00}$%d", salary_adm);
		SendClientMessage(playerid, -1, string_), pInfo[playerid][pBank] += salary_adm;
		LogMoney(playerid, salary_adm, "зарплата администратора");
	}  
	if (pInfo[playerid][pHouseID] != -1) {
		format(string_, sizeof(string_), " Текущий баланс: $%d", pInfo[playerid][pBank]);
		SendClientMessage(playerid, COLOR_WHITE, string_);
		format(string_, sizeof(string_), " Домашний счёт: $%d", HouseInfo[ pInfo[playerid][pHouseID] ][hTakings]);
		SendClientMessage(playerid, COLOR_WHITE, string_); 
	} else {
		format(string_, sizeof(string_), " Текущий баланс: $%d", pInfo[playerid][pBank]);
		SendClientMessage(playerid, COLOR_WHITE, string_); 
	} 
	if (Iter_Count(PlayerListVehicle[playerid]) != 0 && fInfo[FRACTION_CITYHALL][fCost][0] != 0)
	{
		foreach(new V_IDX: PlayerListVehicle[playerid])
		{
			if(GetString(VehicleInfo[ V_IDX - 1 ][vNumber], "None")) {
				VehicleInfo[ V_IDX - 1 ][vTax] += (fInfo[FRACTION_CITYHALL][fCost][0]*2); 
				format(string_, sizeof string_, "[Оповещение] "colwhi"транспорт %s не стоит на учете, сумма налога повышена в 2 раза", VehicleNames[ VehicleInfo[ V_IDX - 1 ][vModel] - 400 ]);
				SendClientMessage(playerid, COLOR_LI_RED, string_); 
			} else {
				VehicleInfo[ V_IDX - 1 ][vTax] += fInfo[FRACTION_CITYHALL][fCost][0];
			}
			if (VehicleInfo[ V_IDX - 1 ][vTax] > MAX_VALUE_FOR_SALE_GOS) {
				SendClientMessage(playerid, COLOR_WHITE, !"Ваш транспорт был продан государству за неуплату налогов!");
				format(string_, sizeof string_, "DELETE FROM "TABLE_VEHICLE_PLAYER" WHERE vID = '%d'", VehicleInfo[ V_IDX - 1 ][vID]);
				mysql_tquery(dbHandle, string_, "", ""); 
				Iter_Remove(PlayerListVehicle[playerid], V_IDX);
				_DestroyVehicle(V_IDX);
			} 
		}
	}
	SendClientMessage(playerid,COLOR_GRAD1, !"================================"); 

	new exp = 1, vbExp = GetVipBoostMaxPlayerValue(playerid, vPayDayExp, bPayDayExp, 0);
    if (gBoostServer[sBoost]) exp = gBoostServer[sBoostExp];
    if (vbExp > exp) exp = vbExp;

	UpdatePlayerExp(playerid, exp);

	if (pTemp[playerid][GetHomePlayer] == true)
	{
		SendClientMessage(playerid, COLOR_LIGHTRED, !" Вы были выселены за неуплату квартплаты");
		SendClientMessage(playerid, COLOR_LIGHTRED, !" Ваши деньги за дом были перечислены на ваш счет");
		pTemp[playerid][GetHomePlayer] = false;
		pInfo[playerid][pHouseID] = -1;
	} 
	if (pTemp[playerid][GetFarmPlayer] == true)
	{
		SendClientMessage(playerid, COLOR_LIGHTRED, !" Ваша ферма была выставлена на аукцион за неуплату налогов");
		SendClientMessage(playerid, COLOR_LIGHTRED, !" Деньги с банка автомастерской были перечислены на ваш счет");
		pTemp[playerid][PlayerFarmID] = -1;
		pTemp[playerid][GetFarmPlayer] = false;
	}
	seans[playerid] = false;
	if (pInfo[playerid][pRobHouse] == 1) {
		pInfo[playerid][pRobHouse] = 0; 
	}
	pInfo[playerid][pPayCheck] = 0;

	new rand_up_down = random(2);// рандом вырастет курс или упадет
	if(!rand_up_down)
	{// упадет
		priceeu -= random(100);		
	}
	else
	{// вырастет
		priceeu += random(100);								
	}		

	CheckPlayerVipTime(playerid);
	CheckPlayerLicenseTime(playerid);
	CheckPlayerBoostTime(playerid); 
	if (mysql_unprocessed_queries() > SettingServer[6]) {
		SettingServer[6] = mysql_unprocessed_queries(); 
	}
	return 1;
}
stock split(const strsrc[], strdest[][], delimiter)
{
	new i, li;
	new aNum;
	new len;
	while(i <= strlen(strsrc))
	{
		if (strsrc[i] == delimiter || i == strlen(strsrc))
		{
			len = strmid(strdest[aNum], strsrc, li, i, 128);
			strdest[aNum][len] = 0;
			li = i+1;
			aNum++;
		}
		i++;
	}
	return 1;
}
