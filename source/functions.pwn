		if (pInfo[playerid][pFamily] != 0) { 
			Invite_Family(playerid, pInfo[playerid][pFamily]); 
		}
		cache_get_value_name_int(0, "pFamilyRank", pInfo[playerid][pFamilyRank]);
		cache_get_value_name_int(0, "pFamilyMute", pInfo[playerid][pFamilyMute]);
		//cache_get_value_name_int(0, "pFamilyWarn", pInfo[playerid][pFamilyWarn]);
