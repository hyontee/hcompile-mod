        OnGetDataVkSSL_ID = Request(
            client,
            "",
            HTTP_METHOD_GET,
            "OnGetDataVkSSL",
        .headers = RequestHeaders()
    ); */
    totalstring[0] = EOS;
    return 1;
} 

