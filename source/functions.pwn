stock IsGosVehicle(const vehicleid)
{
	if (!(1 <= vehicleid < MAX_VEHICLES)) return 0;
	if (VehicleInfo[ vehicleid ][vType] == VEHICLE_TYPE_FRACTION)
	{
		switch(VehicleInfo[ vehicleid  ][vFraction])
		{
			case 1,2,10,21: return 1;
		}
	}
	return 0;
} 
publics: LoadTopServer() {
	new 
		top_name[MAX_PLAYER_NAME],
		rows,
		top_level,
		top_charity; 
	cache_get_row_count(rows);
	if (rows) {
		t_string[0] = EOS;
		strcat(t_string, ""colwhi"Благотворительность:\n(( Статистика за месяц ))\n\n"); 
		for(new i, str_[128]; i < rows; i ++) {
			cache_get_value_name(i, "Name", top_name, MAX_PLAYER_NAME);
			cache_get_value_name_int(i, "pLevel", top_level);
			cache_get_value_name_int(i, "pCharity", top_charity); 
			format(str_, sizeof str_,""C_PODS"%d. "colwhi"%s ["collime"$%s"colwhi"], В штате: "colmaline"%d %s\n", i+1, top_name, convert_money(top_charity), top_level, Declension_ReturnWord(top_level, "год", "года", "лет")),
			strcat(t_string, str_);
			UpdateDynamic3DTextLabelText(TopCharity, -1, t_string);
		}
	} 
	else {
		strcat(t_string, ""colwhi"Благотворительность:\n(( Статистика за месяц ))\n\nИнформации еще нет\n");
		UpdateDynamic3DTextLabelText(TopCharity, -1, t_string);
	} 
	return 1;
}

publics: LoadTopMadHouse()
{
	new 
		top_name[MAX_PLAYER_NAME],
		rows, 
		all_time; 
	cache_get_row_count(rows);
	t_string[0] = EOS;
	if (rows) { 
		strcat(t_string, ""colwhi"Больше всех посетили нашу лечебницу:\n(( Статистика за месяц ))\n\n");
		for(new i, str_[128]; i < rows; i ++) {
			cache_get_value_name(i, "Name", top_name, MAX_PLAYER_NAME);
			cache_get_value_name_int(i, "MadTime", all_time);
 
			format(str_, sizeof str_,""C_PODS"%d. "colwhi"%s Провел за месяц: "collime"%s"colwhi"\n", 
				i+1, top_name, ConvertsCmdTime(all_time)),
			strcat(t_string, str_);
			UpdateDynamic3DTextLabelText(TopMadHouse, -1, t_string);
		}
	}
	else {
		strcat(t_string, ""colwhi"Больше всех посетили нашу лечебницу:\n(( Статистика за месяц ))\n\nИнформации еще нет\n");
		UpdateDynamic3DTextLabelText(TopMadHouse, -1, t_string);
	} 
	return 1;
}
stock UpdateInfoTD(playerid) {
	new string[128];
    if (pTemp[playerid][tDMArea][0]) format(string,sizeof(string),"~r~Kills:~w~ %d~n~~r~Deaths:~w~ %d",pTemp[playerid][tDMArea][1], pTemp[playerid][tDMArea][2]); 
	if (!strlen(string)) PlayerTextDrawHide(playerid, DmArenaTextDraw[playerid]);
	else {
	    switch(string[0]) {
			case '~': strdel(string,0,3);
		}
	    PlayerTextDrawSetString(playerid,DmArenaTextDraw[playerid], string);
		PlayerTextDrawShow(playerid,DmArenaTextDraw[playerid]);
	}
	return 1;
}

stock MessagePlayerOffline(const MySQLID, const message[])
{
	static const str_mess_[] = "INSERT INTO `s_user_message` (`pID`,`message`) VALUES ('%d','%s')";

	new str_tmp_query[sizeof(str_mess_) + 152 ];

	format(str_tmp_query, sizeof str_tmp_query , str_mess_, MySQLID, message);
	mysql_tquery(dbHandle, str_tmp_query, "", "");
	return 1;
}

stock LoadMessagePlayerOffline(const playerid)
{
	static const str_mess_get[] = "SELECT `id`,`pID`,`message` FROM `s_user_message` WHERE `pID` = '%d'";

	new str_tmp_query[sizeof(str_mess_get) + 11 ];

	format(str_tmp_query, sizeof(str_tmp_query), str_mess_get,pInfo[playerid][pID]);
	mysql_tquery(dbHandle, str_tmp_query, "LoadPlayerMessage", "i", playerid);
	return 1;
}

publics:LoadPlayerMessage(const playerid)
{
	new rows;
	cache_get_row_count(rows);
    if (rows)
	{
		new id,message[144];
		static const delete_message[] = "DELETE FROM `s_user_message` WHERE `id` = '%d' LIMIT 1";
		//new str_tmp[sizeof(delete_message) + 11];
		for(new i; i < rows; i++)
    	{
			cache_get_value_name_int(i,"id", id);
        	cache_get_value_name(i,"message", message, 144);

			SendClientMessage(playerid, COLOR_LI_RED, message);

			format(message,70,delete_message,id); 
			mysql_tquery(dbHandle, message, "", "");
		}
	}
	return 1;
}

publics:UpdateStatusGate(const gate_id, const type)
{
	if (gate_id == 0) // gate_lva[0]
	{
		static lva_go,lva_type;

		if (type == 2)
		{
			lva_type = 0;
			if (lva_go == 1) goto close_gate_lva;
			return 1;
		}
		if (lva_go == 0)
		{
			lva_go = 1; // открывается 
			MoveDynamicObject(gate_lva[0], 343.24249, 1796.24011, 17.025+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[1], 344.45901, 1797.08557, 17.025+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[2], 345.86121, 1798.04834, 17.025+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[3], 347.20370, 1798.97168, 17.025+0.04, 0.24, 0.000, 0.000, 0.0);
			if (type == 1 && lva_type == 0)
			{
				lva_type = 1;
				SetTimerEx("UpdatewStatusGate", 10_000, false, "ii",0,2);
			}
		}
		else
		{
			close_gate_lva:
			if(type == 3) return 1;
			lva_go = 0; // закрывается 968, 343.184, 1796.366, 17.924, 0.000000, 88.399, 35.200

			MoveDynamicObject(gate_lva[0], 343.24249, 1796.24011, 18.05-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[1], 344.45901, 1797.08557, 18.05-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[2], 345.86121, 1798.04834, 18.05-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[3], 347.20370, 1798.97168, 18.05-0.04, 0.24, 0.000, 0.000, 0.0);

		}
	}
	else if (gate_id == 1)
	{
		static lva_go1,lva_type1;

		if (type == 2)
		{
			lva_type1 = 0;
			if (lva_go1 == 1) goto close_gate_lva1;
			return 1;
		}
		if (lva_go1 == 0)
		{
			lva_go1 = 1; // открывается
			MoveDynamicObject(gate_lva[4], 139.38071, 1941.12976, 17.6+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[5], 137.88071, 1941.12976, 17.6+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[6], 136.38071, 1941.12976, 17.6+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[7], 134.88071, 1941.12976, 17.6+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[8], 133.38071, 1941.12976, 17.6+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[9], 131.88071, 1941.12976, 17.6+0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[10], 130.38071, 1941.12976,17.6+0.04, 0.24, 0.000, 0.000, 0.0);
			if (type == 1 && lva_type1 == 0)
			{
				lva_type1 = 1;
				SetTimerEx("UpdateStatusGate", 10_000, false, "ii",1,2);
			}
		}
		else
		{
			close_gate_lva1:
			if(type == 3) return 1;
			lva_go1 = 0; // закрывается 286.070, 1827.317, 19.410, 0.000, 0.000, 89.699
			MoveDynamicObject(gate_lva[4], 139.38071, 1941.12976, 18.813-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[5], 137.88071, 1941.12976, 18.813-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[6], 136.38071, 1941.12976, 18.813-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[7], 134.88071, 1941.12976, 18.813-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[8], 133.38071, 1941.12976, 18.813-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[9], 131.88071, 1941.12976, 18.813-0.04, 0.24, 0.000, 0.000, 0.0);
			MoveDynamicObject(gate_lva[10], 130.38071, 1941.12976, 18.813-0.04, 0.24, 0.000, 0.000, 0.0);
		}
	}
	/*else if (gate_id == 2)
	{
		static lva_go2,lva_type2;

		if (type == 2)
		{
			lva_type2 = 0;
			if (lva_go2 == 1) goto close_gate_lva2;
			return 1;
		}
		if (lva_go2 == 0)
		{
			lva_go2 = 1; // открывается
			MoveDynamicObject(gate_lva[2], 121.963,1941.384,20.953+0.04, 2.2, 0.000, 0.000, 0.0);
			if (type == 1 && lva_type2 == 0)
			{
				lva_type2 = 1;
				SetTimerEx("UpdateStatusGate", 10_000, false, "ii",2,2);
			}
		}
		else
		{
			close_gate_lva2:
			lva_go2 = 0; // закрывается 286.070, 1827.317, 19.410, 0.000, 0.000, 89.699
			MoveDynamicObject(gate_lva[2],134.483,1941.384,20.953-0.04,2.2,0.000, 0.000, 0.0);
		}
	}
	else if (gate_id == 3)
	{
		static lva_go3,lva_type3;
		if (type == 2)
		{
			lva_type3 = 0;
			if (lva_go3 == 1) goto close_gate_lva3;
			return 1;
		}
		if (lva_go3 == 0)
		{
			lva_go3 = 1; // открывается
			MoveDynamicObject(gate_lva[3], 2552.7066, -1417.3065, 1499.8870+0.04, 3.5);
			if (type == 1 && lva_type3 == 0)
			{
				lva_type3 = 1;
				SetTimerEx("UpdateStatusGate", 10_000, false, "ii",3,2);
			}
		}
		else
		{
			close_gate_lva3:
			lva_go3 = 0; // закрывается 286.070, 1827.317, 19.410, 0.000, 0.000, 89.699
			MoveDynamicObject(gate_lva[3], 2551.226562, -1417.306518, 1499.886962-0.04, 3.5);
		}
	}*/
	if (gate_id == 4)
	{
		static lspd_go,lspd_type;
		if (type == 2)
		{
			lspd_type = 0;
			if (lspd_go == 1) goto close_gate_lspd;
			return 1;
		}
		if (lspd_go == 0)
		{
			lspd_go = 1; // открывается
			MoveDynamicObject(gate_lspd, 1544.703, -1630.804,13.021+0.04,0.04, -0.399, -3.299, -89.899);
			if (type == 1 && lspd_type == 0)
			{
				lspd_type = 1;
				SetTimerEx("UpdateStatusGate", 10_000, false, "ii",gate_id,2);
			} 
		}
		else
		{
			close_gate_lspd:
			lspd_go = 0; 
            MoveDynamicObject(gate_lspd, 1544.703, -1630.804, 13.021-0.04,0.04, -0.399, -88.899, -89.899);
		}
	}
	/*else if (gate_id == 5)
	{
		static sfa_go,sfa_type;
		if (type == 2)
		{
			sfa_type = 0;
			if (sfa_go == 1) goto close_gate_sfa;
			return 1;
		}
		if (sfa_go == 0)
		{
			sfa_go = 1; // открывается -1526.374 481.389 6.863 0.000 -1.299 0.000
			MoveDynamicObject(gate_sfa, -1526.374, 481.389, 6.863+0.04,0.04, 0.000, -1.299, 0.000);
			if (type == 1 && sfa_type == 0)
			{
				sfa_type = 1;
				SetTimerEx("UpdateStatusGate", 10_000, false, "ii",gate_id,2);
			}
		}
		else
		{
			close_gate_sfa:
			sfa_go = 0;  // -1526.374 481.389 6.863 0.000 -89.599 0.000
            MoveDynamicObject(gate_sfa, -1526.374, 481.389, 6.863-0.04,0.04, 0.000, -89.599, 0.000);
		}
	}*/
	else if (gate_id == 6)
	{
		static fbi_go,fbi_type;
		if (type == 2)
		{
			fbi_type = 0;
			if (fbi_go == 1) goto close_gate_fbi;
			return 1;
		}
		if (fbi_go == 0)
		{
			fbi_go = 1; // открывается  968 -2436.865 495.447 29.647 0.000 -0.300 24.999
			MoveDynamicObject(gate_fbi, -2436.865, 495.447,29.647+0.04,0.04, 0.000, -0.300, 24.999);
			if (type == 1 && fbi_type == 0)
			{
				fbi_type = 1;
				SetTimerEx("UpdateStatusGate", 10_000, false, "ii",gate_id,2);
			}
		}
		else
		{
			close_gate_fbi:
			fbi_go = 0;  // 968 -2436.865 495.447 29.647 0.000 89.099 24.999
            MoveDynamicObject(gate_fbi, -2436.865, 495.447, 29.647-0.04,0.04, 0.000, 89.099, 24.999);
		}
	}
	return 1;
}


