                    tFractionGraffiti[TagInfo[graffiti][tFraction]] ++;
				}
				else if (TagInfo[graffiti][tFraction] == FRACTION_BALLAS) {
					TagInfo[graffiti][tID] = CreateDynamicObject(18664,TagInfo[graffiti][tPos][0],TagInfo[graffiti][tPos][1],TagInfo[graffiti][tPos][2],TagInfo[graffiti][tRPos][0],TagInfo[graffiti][tRPos][1],TagInfo[graffiti][tRPos][2]); /// object (SprayTag4) (52) ///
