publics: HideObjectsHands(playerid,index) {
	if(HideObjHands[playerid] > -1) {
		if(IsPlayerAttachedObjectSlotUsed(playerid, index))RemovePlayerAttachedObject(playerid, index);
		HideObjHands[playerid] = -1;
	}
	return 1;
}
stock CheckPlayerGoCuff(playerid) {
    gFollowInfo[playerid][gtX] 		=
	gFollowInfo[playerid][gtY] 		=
	gFollowInfo[playerid][gtZ] 		=
	gFollowInfo[playerid][gtTPX] 	= 
	gFollowInfo[playerid][gtTPY] 	= 
	gFollowInfo[playerid][gtTPZ] 	= 0.0;
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	if(gFollowInfo[playerid][gtGoID] != INVALID_PLAYER_ID) gFollowInfo[gFollowInfo[playerid][gtGoID]][gtID] = INVALID_PLAYER_ID;

	gFollowInfo[playerid][gtID] 	= 
	gFollowInfo[playerid][gtGoID] 	= INVALID_PLAYER_ID;
	gFollowInfo[playerid][gtState] 	= 
	gFollowInfo[playerid][gtStayed] = 0;
    return true;
}
stock TurnPlayerFaceToPlayer(playerid, facingtoid) {
	new Float:x, Float:y, Float:z;
	GetPlayerPos(facingtoid, x, y, z);
	SetPlayerFaceToPoint(playerid, x, y);
	return true;
}
stock SetPlayerFaceToPoint(playerid, Float:X, Float:Y) {
    new Float:angle;
	new Float:misc = 5.0;
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	angle = 180.0-atan2(x-X,y-Y);
	angle += misc;
	misc *= -1;
	SetPlayerFacingAngle(playerid, angle+misc);
    return true;
}
stock ShiftCords(style, &Float:x, &Float:y, &Float:z, Float:a, Float:distance) {
	#pragma unused z
	switch(style) {
	    case 0: {
	        x += (distance * floatsin(-a, degrees));
			y += (distance * floatcos(-a, degrees));
	    }
	    case 1: {
		    x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		default: return false;
	}
	return true;
}
stock GoPlayerAnimation(playerid, Float:X, Float:Y, Float:Z) {
	if(IsPlayerInAnyVehicle(playerid)) return false; 
	else if(IsPlayerInRangeOfPoint(playerid, 2.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "IDLE_STANCE", 6.0, 1, 1, 1, 1, 0, 1);
	else if(IsPlayerInRangeOfPoint(playerid, 4.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "WALK_PLAYER", 6.0, 1, 1, 1, 1, 0, 1);
	else if(IsPlayerInRangeOfPoint(playerid, 7.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "RUN_GANG1", 6.0, 1, 1, 1, 1, 0, 1); 
	ApplyAnimation(playerid, "PED", "SPRINT_PANIC", 6.0, 1, 1, 1, 1, 0, 1);
	return true;
}
stock GivePlayerLicense(playerid, type, fordays, bool: save = true) {
	pInfo[playerid][pLicense][type] = 1;
	new 
		un_lic = gettime() + (fordays * 86400);
	pInfo[playerid][pLicenseTime][type] = un_lic;
	if (save) {
		new 
			query_[256];
		format(query_, sizeof query_, 
			"UPDATE `s_users` SET `licenses` = '%d,%d,%d,%d,%d,%d', `licensesTime` = '%d|%d|%d|%d|%d|%d' WHERE `pID` = '%d' LIMIT 1",
			pInfo[playerid][pLicense][0], pInfo[playerid][pLicense][1], pInfo[playerid][pLicense][2], 
			pInfo[playerid][pLicense][3], pInfo[playerid][pLicense][4], pInfo[playerid][pLicense][5],
			pInfo[playerid][pLicenseTime][0], pInfo[playerid][pLicenseTime][1], pInfo[playerid][pLicenseTime][2], 
			pInfo[playerid][pLicenseTime][3], pInfo[playerid][pLicenseTime][4], pInfo[playerid][pLicenseTime][5],
			pInfo[playerid][pID]
		);
		mysql_tquery(dbHandle, query_, "", "");
		printf("GivePlayerLicense -> strlen %d", query_);
	} 
} 
stock CheckPlayerLicenseTime(playerid) { 
	new
		current_time = gettime();
	if (current_time > pInfo[playerid][pLicenseTime][DRIVE_LIC] && pInfo[playerid][pLicense][DRIVE_LIC]) { 
		ClearPlayerLicense(playerid, DRIVE_LIC);
		SendClientMessage(playerid, COLOR_LI_RED, !"[Оповещения] "colwhi"Внимание! Время "collime"Водительского удостоверения "colwhi"истекло, обратитесь в Автошколу!");
	}
	if (current_time > pInfo[playerid][pLicenseTime][FLY_LIC] && pInfo[playerid][pLicense][FLY_LIC]) { 
		ClearPlayerLicense(playerid, FLY_LIC);
		SendClientMessage(playerid, COLOR_LI_RED, !"[Оповещения] "colwhi"Внимание! Время лицензии на "collime"Воздушный ТС "colwhi"истекло, обратитесь в Автошколу!");
	}
	if (current_time > pInfo[playerid][pLicenseTime][BOAT_LIC] && pInfo[playerid][pLicense][BOAT_LIC]) { 
		ClearPlayerLicense(playerid, BOAT_LIC);
		SendClientMessage(playerid, COLOR_LI_RED, !"[Оповещения] "colwhi"Внимание! Время лицензии на "collime"Водный ТС "colwhi"истекло, обратитесь в Автошколу!");
	}
	if (current_time > pInfo[playerid][pLicenseTime][FISH_LIC] && pInfo[playerid][pLicense][FISH_LIC]) { 
		ClearPlayerLicense(playerid, FISH_LIC);
		SendClientMessage(playerid, COLOR_LI_RED, !"[Оповещения] "colwhi"Внимание! Время лицензии на "collime"Охоту "colwhi"истекло, обратитесь в Автошколу!");
	}
	if (current_time > pInfo[playerid][pLicenseTime][GUN_LIC] && pInfo[playerid][pLicense][GUN_LIC]) { 
		ClearPlayerLicense(playerid, GUN_LIC);
		SendClientMessage(playerid, COLOR_LI_RED, !"[Оповещения] "colwhi"Внимание! Время лицензии на "collime"Оружие "colwhi"истекло, обратитесь в Автошколу!");
	}   
}
stock ClearPlayerLicense(playerid, type, bool: save = true) {
	pInfo[playerid][pLicense][type] = 0;
	pInfo[playerid][pLicenseTime][type] = 0;
	if (save) {
		new 
			query_[256];
		format(query_, sizeof query_, 
			"UPDATE `s_users` SET `licenses` = '%d,%d,%d,%d,%d,%d', `licensesTime` = '%d|%d|%d|%d|%d|%d' WHERE `pID` = '%d' LIMIT 1",
			pInfo[playerid][pLicense][0], pInfo[playerid][pLicense][1], pInfo[playerid][pLicense][2], 
			pInfo[playerid][pLicense][3], pInfo[playerid][pLicense][4], pInfo[playerid][pLicense][5],
			pInfo[playerid][pLicenseTime][0], pInfo[playerid][pLicenseTime][1], pInfo[playerid][pLicenseTime][2], 
			pInfo[playerid][pLicenseTime][3], pInfo[playerid][pLicenseTime][4], pInfo[playerid][pLicenseTime][5],
			pInfo[playerid][pID]
		);
		mysql_tquery(dbHandle, query_, "", "");
		printf("ClearPlayerLicense -> strlen %d", query_);
	}
}  
stock OnLoadDiplomationCriminals() {
	new 
		time = GetTickCount(),
		Cache:tempQuery = mysql_query(dbHandle, "SELECT * FROM `s_diplomation`"), rows;
	cache_get_row_count(rows);
	if (!rows) {
		print(!"[Загрузка ...] Данные из s_diplomation не получены!");
		if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
		return;
	} 
	for(new i = 0, str_[32]; i < rows; i++) {
		cache_get_value(i, "dStatus", str_ , sizeof str_);
		sscanf(str_, "p<|>iiiiiiiiiiii", 
			crimeDiplomation[i][0], crimeDiplomation[i][1], crimeDiplomation[i][2], crimeDiplomation[i][3], 
			crimeDiplomation[i][4], crimeDiplomation[i][5], crimeDiplomation[i][6], crimeDiplomation[i][7],
			crimeDiplomation[i][8], crimeDiplomation[i][9], crimeDiplomation[i][10], crimeDiplomation[i][11]);
	} 
    if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
	printf("[Загрузка ...] Данные из s_diplomation получены! (%d шт.) Время: %d", rows, GetTickCount() - time); 
}

stock SaveDiplomationCriminals(playerid, id) {
	new 
		string_[128];
	format(string_, sizeof string_, "UPDATE `s_diplomation` SET `dStatus` = '%d|%d|%d|%d|%d|%d|%d|%d' WHERE `dID` =  '%d' LIMIT 1",
		crimeDiplomation[capture_band(pInfo[playerid][pMember])][0], crimeDiplomation[capture_band(pInfo[playerid][pMember])][1], crimeDiplomation[capture_band(pInfo[playerid][pMember])][2], 
		crimeDiplomation[capture_band(pInfo[playerid][pMember])][3], crimeDiplomation[capture_band(pInfo[playerid][pMember])][4], crimeDiplomation[capture_band(pInfo[playerid][pMember])][5], 
		crimeDiplomation[capture_band(pInfo[playerid][pMember])][6], crimeDiplomation[capture_band(pInfo[playerid][pMember])][7], crimeDiplomation[capture_band(pInfo[playerid][pMember])][8],
		crimeDiplomation[capture_band(pInfo[playerid][pMember])][9], crimeDiplomation[capture_band(pInfo[playerid][pMember])][10], crimeDiplomation[capture_band(pInfo[playerid][pMember])][11], id
	);
	mysql_tquery(dbHandle, string_, "", "");
}
stock ShowDialogDiplomationCriminals(playerid, bool:edit_dip = true) {
	static const f_str[][] = { 
		""C_PODS"Нейтралитет",
		""colwarn"Война",
		""collime"Союз",
		""colrose"Запрос на союз",
		""colrose"Запрос на союз"
	};
	new pvar_string_[8], step;
	new string_[128]; 
	t_string[0] = EOS;
	strcat(t_string, ""colserver"[№] Организация\t"colserver"Статус\n");
	for(new i = 0 ; i < 12; i ++) {  
		format(pvar_string_, 8, "d_%d", step);
		SetPVarInt(playerid, pvar_string_, i); 
		format(string_, sizeof string_, "[%d] {%s} %s\t%s\n", i, gFraction[ back_capture_band(i) ][fRGBColor], gFraction[ back_capture_band(i) ][fName], f_str[ crimeDiplomation[ capture_band(pInfo[playerid][pMember]) ][i] ]);
		strcat(t_string, string_); 
		step++;
	}
	if(edit_dip) ShowPlayerDialog(playerid, D_DIPLOMATION, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Преступная: "colwhi"Дипломатия", t_string, "Выбрать", "Отмена");
	else ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Преступная: "colwhi"Дипломатия", t_string, "Закрыть", "");
	return 1;
}


