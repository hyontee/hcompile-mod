stock invite_team(playerid, teamid)
{
    if (teamid == 0 || teamid > FRACTIONBANK_COUNT-1) return 1;
	if (!Iter_Contains(PlayerTeam[teamid], playerid)) {
		Iter_Add(PlayerTeam[teamid], playerid);
	}
	if (IsABiker(playerid)) {
		if (BikersTimer > 0 && bikers_frac_id[0] > 0) {
			if (pInfo[playerid][pMember] == bikers_frac_id[0] || pInfo[playerid][pMember] == bikers_frac_id[1]) {
				ShowTextDrawCapture(playerid, TYPE_WAR_BIKERS);
				SetPlayerColor(playerid, gFractionColor[teamid]); 
			}
		}
		if (BikersWarGZ != INVALID_GANGZONE_ID) {
			GangZoneShowForPlayer(playerid, BikersWarGZ, 0xB2B2B2AA);
			GangZoneFlashForPlayer(playerid, BikersWarGZ, COLOR_RED);
		}
	}
	if (IsAMafia(playerid))
	{
		if (ZoneTimer > 0 && mafia_frac_id[0] > 0)
		{
			if (pInfo[playerid][pMember] == mafia_frac_id[0] || pInfo[playerid][pMember] == mafia_frac_id[1])
			{
				ShowTextDrawCapture(playerid, TYPE_WAR_MAFIA);
				SetPlayerColor(playerid, gFractionColor[teamid]);
			}
		}
	}
	if (IsAGang(playerid))
	{
		new band = capture_band(teamid);
		if (band != 0xFFFF) {
			if (capture_now[band] != 0)
			{
				new zone = capture_now[band]-1;
				GangZoneFlashForPlayer(playerid, GZInfo[zone][gZone], GetGZColorF(teamid)); 
				ShowTextDrawCapture(playerid,GZInfo[zone][gTD]);
				SetPlayerColor(playerid,gFractionColor[teamid]);
			}
		}
	}
	
	return 1;
}

stock leave_team(playerid, teamid)
{
    if (teamid == 0 || teamid > FRACTIONBANK_COUNT-1) return 1;
	Iter_Remove(PlayerTeam[teamid], playerid);
	if (IsABiker(playerid)) {
		if (BikersTimer > 0 && bikers_frac_id[0] > 0) {
			if (pInfo[playerid][pMember] == bikers_frac_id[0] || pInfo[playerid][pMember] == bikers_frac_id[1]) {
				HideTextDrawCapture(playerid, TYPE_WAR_BIKERS);
				/*for(new i_ = 0; i_ < 5; i_++)
				{
					if (!player_mobile[playerid])  SendDeathMessageToPlayer(playerid,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
				}*/
			}
		}
		if (BikersWarGZ != INVALID_GANGZONE_ID) {
			GangZoneStopFlashForPlayer(playerid, BikersWarGZ);
			GangZoneHideForPlayer(playerid, BikersWarGZ);
		} 
	}
	if (IsAMafia(playerid))
	{
		if (ZoneTimer > 0 && mafia_frac_id[0] > 0)
		{
			if (pInfo[playerid][pMember] == mafia_frac_id[0] || pInfo[playerid][pMember] == mafia_frac_id[1])
			{
				HideTextDrawCapture(playerid, TYPE_WAR_MAFIA);
				/*for(new i_ = 0; i_ < 5; i_++)
				{
					if (!player_mobile[playerid])  SendDeathMessageToPlayer(playerid,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
				}*/
			}
		}
	}
	if (IsAGang(playerid))
	{
		new band = capture_band(teamid);
		if (band != 0xFFFF) {
			if (capture_now[band] != 0)
			{
				/*for(new i_ = 0; i_ < 5; i_++)
				{
					if (!player_mobile[playerid]) SendDeathMessageToPlayer(playerid,INVALID_PLAYER_ID-1, INVALID_PLAYER_ID-1, 0);
				} */
				HideTextDrawCapture(playerid,GZInfo[capture_now[band]-1][gTD]);
			}
		}
	} 
	return 1;
}

main()
{
    new
		dd, mm, yy;
	gettime(hour,minute,second);
	getdate(yy,mm,dd);
	print("________________________________________________________________________________");
	print("—————————————    BOP    —————————————");
	print("________________________________________________________________________________");
	print("— "MODE_NAME" Loaded!");
	printf("— LIMITS: VEHICLE:%d", MAX_VEHICLES);
	printf("— Gamemode started in [%02d:%02d:%02d %02d/%02d/%02d]",hour,minute,second,dd,mm,yy);
	printf("— Current Pickups = %d",CountDynamicPickups());
	printf("— Current Objects = %d",CountDynamicObjects());
	printf("— Current 3DText  = %d",CountDynamic3DTextLabels());
	printf("— Current MapIcons = %d (SD: %f)",CountDynamicMapIcons(), STREAMER_MAP_ICON_SD);
	printf("— Current Checkpoints = %d",CountDynamicCPs());
	printf("— Current Race Checkpoints = %d",CountDynamicRaceCPs());
	printf("— Current Areas = %d", CountDynamicAreas());
	print("________________________________________________________________________________"); 
}
stock GetEngineStatus(vehicleid)
{
    GetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	return engine1;
}  
stock IsANews(playerid) {
	if (!IsPlayerConnected(playerid)) return 0;
	switch(pInfo[playerid][pMember]) {
		case FRACTION_SF_NEWS, FRACTION_LS_NEWS, FRACTION_LV_NEWS: return 1;
	}  
	return 0;
}
stock IsAMedic(playerid) {
	if (!IsPlayerConnected(playerid)) return 0;
	switch(pInfo[playerid][pMember]) {
		case FRACTION_HOSPITAL_SF, FRACTION_HOSPITAL_LS, FRACTION_HOSPITAL_LV: return 1;
	}  
	return 0;
} 
stock IsAMayor(playerid) {
	if (!IsPlayerConnected(playerid)) return 0;
	if (pInfo[playerid][pMember] == FRACTION_CITYHALL) return 1;
	return 0;
}
stock IsAFBI(playerid) {
	if (!IsPlayerConnected(playerid)) return 0;
	if (pInfo[playerid][pMember] == FRACTION_FBI) return 1;
	return 0;
}
stock IsALicenser(playerid) {
	if (!IsPlayerConnected(playerid)) return 0;
	if (pInfo[playerid][pMember] == FRACTION_AUTOSCHOOL) return 1;
	return 0;
}
stock IsACop(playerid)
{
	if (!IsPlayerConnected(playerid)) return 0;
	switch(pInfo[playerid][pMember]) {
		case FRACTION_LSPD, FRACTION_SFPD, FRACTION_LVPD, FRACTION_FBI: return 1;
	} 
	return 0;
}
stock IsAGosFraction(playerid)
{
	if (!IsPlayerConnected(playerid)) return 0;
	if (pInfo[playerid][pMember] == FRACTION_LSPD || pInfo[playerid][pMember] == FRACTION_FBI || pInfo[playerid][pMember] == FRACTION_SFPD 
		|| pInfo[playerid][pMember] == FRACTION_LVPD || pInfo[playerid][pMember] == FRACTION_ARMY_SF || pInfo[playerid][pMember] == FRACTION_ARMY_LV || pInfo[playerid][pMember] == FRACTION_CITYHALL) return 1; 
	return 0;
}
stock IsAArmy(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	if(pInfo[playerid][pMember] == 3 || pInfo[playerid][pMember] == 19) return 1;
	else if(pInfo[playerid][pLeader] == 3 || pInfo[playerid][pLeader] == 19) return 1;
	return 0;
}
