stock capture_band(id)
{
	switch (id)
	{
	    case FRACTION_BALLAS: return 0;
	    case FRACTION_VAGOS: return 1;
	    case FRACTION_GROVE: return 2;
	    case FRACTION_AZTEC: return 3;
	    case FRACTION_RIFA: return 4;
	    case FRACTION_LCN: return 5;
	    case FRACTION_YAKUZA: return 6;
	    case FRACTION_RUSSIAN: return 7;
		case FRACTION_MONGOLS_MC: return 8;
		case FRACTION_BANDIDOS_MC: return 9;
		case FRACTION_OUTLAWS_MC: return 10;
		case FRACTION_PIRUS: return 11;
	    default: return 0xFFFF;
	}
	return 0xFFFF;
}
stock back_capture_band(id)
{
	switch (id)
	{
	    case 0: return FRACTION_BALLAS;
	    case 1: return FRACTION_VAGOS;
	    case 2: return FRACTION_GROVE;
	    case 3: return FRACTION_AZTEC;
	    case 4: return FRACTION_RIFA;
	    case 5: return FRACTION_LCN;
	    case 6: return FRACTION_YAKUZA;
	    case 7: return FRACTION_RUSSIAN;
		case 8: return FRACTION_MONGOLS_MC;
		case 9: return FRACTION_BANDIDOS_MC;
		case 10: return FRACTION_OUTLAWS_MC;
		case 11: return FRACTION_PIRUS;
	    default: return 0xFFFF;
	}
	return 0xFFFF;
}//Bandidos BANDIDOS
