stock SendFamilyMessage(family, color, const str[], bool:dliv = false)
{
    foreach(new playerid : PlayerTeam[family])
	{
	    if (pTemp[playerid][tDutyWork] == 0) continue;
		if (dliv) {
			if (pInfo[playerid][pAdmin]) continue; 
		}
	    if (pInfo[playerid][PlayerSettings] & setFractionChat) SendClientMessage(playerid, color, str);
	}
	foreach(new i: AdminsTeam)
    {
		if (GetPVarInt(i, "Atisper") != family) continue;
        SendClientMessage(i, color, str);
    }
    return 1;
}
stock SendOOCMessage(color, const str[])
{
    foreach(new i: PlayerInLogin)
	{
		if (!pInfo[i][pLogin]) continue;
		if (pInfo[i][PlayerSettings] & setOOCChat) scm(i,color,str);
	}
	return 1;
}
