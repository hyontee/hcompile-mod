stock GetPlayerAdminSearch(playerid)
{
	new _veh_count = 0,
		query_[78];
	format(query_, sizeof query_,"SELECT * FROM s_admin WHERE Name = '%s' LIMIT 1", pInfo[playerid][pName]);
	new Cache: result = mysql_query(dbHandle, query_);
	_veh_count = cache_num_rows();
	cache_get_value_name_int(0, "level", _veh_count);
	if (cache_is_valid(result)) cache_delete(result);
	return _veh_count;
}

publics: AdminReportCleaner()
{
	for(new i = 1; i < MAX_REPORT_SLOTS; i++)
	{
		if (aReportInfo[i][rPlayerID] == -1) continue;
		if (gettime() - aReportInfo[i][rWhenWroted_Time] >= 10)
		{
			SendClientMessage(aReportInfo[i][rPlayerID], COLOR_SERVER, !"Ваша жалоба/вопрос для администрации было удалено системой.");
			DeletePVar(aReportInfo[i][rPlayerID], "report_id");
			aReportInfo[i][rIsTooked] = false;
			aReportInfo[i][rID] = i;
			aReportInfo[i][rPlayerID] = -1;
			aReportInfo[i][rText][0] = EOS;
			aReportInfo[i][rType] = TICKETS_TYPE_ASK;
			aReportInfo[i][rWhenWroted_Time] = -1;
			aReportInfo[i][rWhenWroted_Text][0] = EOS;
			aReportInfo[i][adminID] = 0; 
		}
	} 
	GameTextForAdmin("REPORT CLEAR");
	GameTextForSupport("REPORT CLEAR");
	return 1;
}
stock ShowReportForAdmin(playerid)
{
	t_string[0] = EOS;
	new R_IDX = 0;
    strcat(t_string, ""colserver"[№] Заявитель\t"colserver"Статус\t"colserver"Тип\n");
	for(new i = 1; i < MAX_REPORT_SLOTS; i++)
	{
		if (aReportInfo[i][rPlayerID] == -1) continue;
		
		format(t_string, sizeof t_string, ""colwhi"%s[%d] %s\t%s\t%s\n",
			t_string, i,
			pInfo[aReportInfo[i][rPlayerID]][pName], 
			(aReportInfo[i][rIsTooked] == true)?(""colwarn"Проверяется"):(""collime"Свободен"), 
			(aReportInfo[i][rType] == TICKETS_TYPE_REPORT)?(""colwarn"REPORT"):(""collime"ASK"));
		//pInfo[playerid][pSex] == 1 ? ("вышел") : ("вышла")	
		playerListItem[playerid][R_IDX] = i; 
		R_IDX++;
	}
	if (R_IDX == 0) return SendClientMessage(playerid, -1, !"На данный момент нет доступных жалоб/вопросов от игроков.");

	ShowPlayerDialog(playerid, D_REPORT_0, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Список жалоб", t_string, "Выбрать", "Отмена");
	return 1;
}


//AutoSalon
stock NextCar(playerid)
{
	if (pTemp[playerid][LoadShowCar] > gettime()) return GameTextForPlayer(playerid,"Loading...",1000,3); 
	pTemp[playerid][tSelectVehicleShop] ++;
	switch(GetPVarInt(playerid,"CarShop"))
	{
		case 0:if (pTemp[playerid][tSelectVehicleShop] > 19) pTemp[playerid][tSelectVehicleShop] = 0;//nope
		case 1:if (pTemp[playerid][tSelectVehicleShop] > 38) pTemp[playerid][tSelectVehicleShop] = 20;//c
		case 2:if (pTemp[playerid][tSelectVehicleShop] > 56) pTemp[playerid][tSelectVehicleShop] = 39;//d
		case 3:if (pTemp[playerid][tSelectVehicleShop] > 84) pTemp[playerid][tSelectVehicleShop] = 72;//a
		case 4:if (pTemp[playerid][tSelectVehicleShop] > 71) pTemp[playerid][tSelectVehicleShop] = 57;//b
	}
	return ShowingCar(playerid);
}
stock BackCar(playerid)
{
	if (pTemp[playerid][LoadShowCar] > gettime()) return GameTextForPlayer(playerid,"Loading...",1000,3);
	pTemp[playerid][tSelectVehicleShop] --;
	switch(GetPVarInt(playerid,"CarShop"))
	{
		case 0:if (pTemp[playerid][tSelectVehicleShop] < 0) pTemp[playerid][tSelectVehicleShop] = 19;//nope
		case 1:if (pTemp[playerid][tSelectVehicleShop] < 20) pTemp[playerid][tSelectVehicleShop] = 38;//c
		case 2:if (pTemp[playerid][tSelectVehicleShop] < 39) pTemp[playerid][tSelectVehicleShop] = 56;//d
		case 3:if (pTemp[playerid][tSelectVehicleShop] < 72) pTemp[playerid][tSelectVehicleShop] = 84;//a
		case 4:if (pTemp[playerid][tSelectVehicleShop] < 57) pTemp[playerid][tSelectVehicleShop] = 71;//b
	}
	return ShowingCar(playerid);
}
stock ShowingCar(playerid)
{//GetPVarInt(playerid,"BuyColor"), GetPVarInt(playerid,"BuyColor1"));
	if (pTemp[playerid][TempSalonCar] != INVALID_VEHICLE_ID) _DestroyVehicle(pTemp[playerid][TempSalonCar]);
	
	pTemp[playerid][TempSalonCar] = _CreateVehicle(ShopCar[ pTemp[playerid][tSelectVehicleShop] ][0],-1658.7123,1212.8981,20.9499,285.2443,1,1,-1);

	ChangeVehicleState(pTemp[playerid][TempSalonCar], 0, VEHICLE_STATE_ERROR);
	SetVehicleVirtualWorld(pTemp[playerid][TempSalonCar], playerid+1);
	PutPlayerInVehicle(playerid,pTemp[playerid][TempSalonCar],0);
	SetPlayerCameraPos(playerid,-1654.097045,1218.596679,22.708799);
	SetPlayerCameraLookAt(playerid,-1659.106201,1210.380737,19.987318);
	SetPVarInt(playerid,"BuyColor", 1);
	SetPVarInt(playerid,"BuyColor1", 1);
	update_info_salon(playerid);
	pTemp[playerid][LoadShowCar] = gettime()+1;
	return 1;
}
stock update_info_salon(playerid)
{
	new 
		string_[128];
	new cost = GetVipBoostMaxPlayerValueSale(playerid, vSaleCar, bSaleCar, ShopCar[ pTemp[playerid][tSelectVehicleShop] ][1]);
	

	format(string_, sizeof string_, "~n~~n~~n~~n~~n~~n~~n~~n~~b~NAME: ~w~%s~n~~g~COST: ~w~%d~n~~y~COLOR1: ~w~%d ~y~COLOR2: ~w~%d",
		VehicleNames[ShopCar[ pTemp[playerid][tSelectVehicleShop] ][0]-400],
		cost,
		GetPVarInt(playerid,"BuyColor"),
		GetPVarInt(playerid,"BuyColor1")
	);
	GameTextForPlayer(playerid, string_, 5000, 3);
	format(string_, sizeof string_, "Model: %s~n~Cost: %d",
		VehicleNames[ShopCar[ pTemp[playerid][tSelectVehicleShop] ][0]-400],
		cost
	);
	PlayerTextDrawSetString(playerid, ShopText[playerid], string_);
	return 1;
}
stock NextColor(playerid,whocolor)
{
	if (whocolor == 0) {
		SetPVarInt(playerid,"BuyColor",GetPVarInt(playerid,"BuyColor")+1);
		if (GetPVarInt(playerid,"BuyColor") > 255) SetPVarInt(playerid,"BuyColor",0);
	}
	else {
		SetPVarInt(playerid,"BuyColor1",GetPVarInt(playerid,"BuyColor1")+1);
		if (GetPVarInt(playerid,"BuyColor1") > 255) SetPVarInt(playerid,"BuyColor1",0);
	}
	ChangeVehicleColor(GetPlayerVehicleID(playerid), GetPVarInt(playerid,"BuyColor"), GetPVarInt(playerid,"BuyColor1"));
	update_info_salon(playerid);
	return 1;
}
stock BackColor(playerid,whocolor)
{
	if (whocolor == 0) {
		SetPVarInt(playerid,"BuyColor",GetPVarInt(playerid,"BuyColor")-1);
		if (GetPVarInt(playerid,"BuyColor") < 0) SetPVarInt(playerid,"BuyColor",255);
	}
	else {
		SetPVarInt(playerid,"BuyColor1",GetPVarInt(playerid,"BuyColor1")-1);
		if (GetPVarInt(playerid,"BuyColor1") < 0) SetPVarInt(playerid,"BuyColor1",255);
	}
	ChangeVehicleColor(GetPlayerVehicleID(playerid), GetPVarInt(playerid,"BuyColor"), GetPVarInt(playerid,"BuyColor1"));
	update_info_salon(playerid);
	return 1;
}
stock ShowBuyCar(playerid)
{
	new gAutoClassSelect[5] = {0, 20, 39, 72, 57};//20 c | 39 d | 72 a | 57 b
	new shop_id = GetPVarInt(playerid,"CarShop"); 
	pTemp[playerid][tSelectVehicleShop] = gAutoClassSelect[shop_id];
	ShopText[playerid] = CreatePlayerTextDraw(playerid,509.000000,180.000000,"Model: Landstalker");
	PlayerTextDrawBackgroundColor(playerid,ShopText[playerid],255);
	PlayerTextDrawFont(playerid,ShopText[playerid],1);
	PlayerTextDrawSetOutline(playerid,ShopText[playerid],1);
	PlayerTextDrawSetShadow(playerid,ShopText[playerid],0);
	PlayerTextDrawLetterSize(playerid,ShopText[playerid],0.270000,1.200000);
	PlayerTextDrawColor(playerid,ShopText[playerid],-1);
	PlayerTextDrawSetProportional(playerid,ShopText[playerid],1);

	PlayerTextDrawShow(playerid, ShopText[playerid]);
	for(new x; x < 12; x++) TextDrawShowForPlayer(playerid, AutoShopText[x]);
	SetPlayerVirtualWorld(playerid,playerid+1);
	SelectTextDraw(playerid, 0x0080FFFF);
 	return ShowingCar(playerid);
}
stock ExitCar(playerid)
{
    for(new x; x < 12; x++) TextDrawHideForPlayer(playerid, AutoShopText[x]);
	PlayerTextDrawHide(playerid, ShopText[playerid]);
	PlayerTextDrawDestroy(playerid, ShopText[playerid]);
	if (pTemp[playerid][TempSalonCar] != INVALID_VEHICLE_ID) _DestroyVehicle(pTemp[playerid][TempSalonCar]);
	pTemp[playerid][TempSalonCar] = INVALID_VEHICLE_ID;
	pTemp[playerid][LoadShowCar] = 0;
	pTemp[playerid][tSelectVehicleShop] = -1;
	DeletePVar(playerid,#CarShop);
	DeletePVar(playerid,#BuyColor);
	DeletePVar(playerid,#BuyColor1);
	CancelSelectTextDraw(playerid);
	new Float:gAutoShopSpawn[4][4] = {
		{539.5839,-1291.5419,17.2422,4.2049}, //ЛС
		{-1954.4395,293.9200,35.4688,89.5773}, // СФ возле вокзала
		{-1654.5570,1211.2758,7.2500,245.9087}, //СФ А/Б
		{2200.8931,1391.5768,10.8203,181.0480} //ЛВ Автосалон
	};
	if (GetPVarInt(playerid,#AutoShopShow) != 0)
	{
	    new
			salon_id = GetPVarInt(playerid,"AutoShopShow") - 1;
	    SetPlayerPosAC(playerid, gAutoShopSpawn[salon_id][0],gAutoShopSpawn[salon_id][1],gAutoShopSpawn[salon_id][2], 0, 0);
	    SetPlayerFacingAngle(playerid,gAutoShopSpawn[salon_id][3]);
	    SetCameraBehindPlayer(playerid);
		DeletePVar(playerid,#AutoShopShow);
	}
	return 1;
}

stock UpdateWeapon_AC(const playerid,const type_e )
{
	const MAX_SLOT_NOSAVE = 6;
	static const slot_nosave[MAX_SLOT_NOSAVE] = {0,7,9,10,11,12};

	if(type_e == 1)
	{
		const MAX_SLOT_SAVE = 2;
		static const slot_save[MAX_SLOT_SAVE] = {1,8};
		
		new weapon_id,
			weapon_ammo;

		for(new i; i < MAX_SLOT_SAVE; i++)
		{
			GetPlayerWeaponData(playerid, slot_save[i], weapon_id, weapon_ammo);

			if (weapon_id != player_weapon_id[playerid][slot_save[i]] && weapon_ammo > 1) {
				ResetPlayerWeapons(playerid);
			}
			if (weapon_ammo > player_weapon_ammo[playerid][slot_save[i]]) {
				ResetPlayerWeapons(playerid);
			}
			else player_weapon_ammo[playerid][slot_save[i]] = weapon_ammo; 
		}
	}
	else 
	{
		for(new i; i < MAX_SLOT_NOSAVE; i++)
		{
			player_weapon_ammo[playerid][slot_nosave[i]] = 0;
			player_weapon_id[playerid][slot_nosave[i]] = 0; 
		}
	}

	return 1;
}

kLibUpdatePlayerWeapons(playerid)
{
	static const save_weap[] =  "UPDATE `s_users` SET `pWeapons` = '0,%d,%d,%d,%d,%d,%d,0,%d,0,0,0,0', \
	`pAmmos` = '0,%d,%d,%d,%d,%d,%d,0,%d,0,0,0,0' WHERE `pID` = '%d' LIMIT 1";

	UpdateWeapon_AC(playerid,0);

	new query_[sizeof(save_weap)+84];

	format(query_,sizeof(query_), save_weap, 
	player_weapon_id[playerid][1],player_weapon_id[playerid][2], player_weapon_id[playerid][3],
	player_weapon_id[playerid][4], player_weapon_id[playerid][5], player_weapon_id[playerid][6],
	player_weapon_id[playerid][8],

	player_weapon_ammo[playerid][1],player_weapon_ammo[playerid][2], player_weapon_ammo[playerid][3],
	player_weapon_ammo[playerid][4], player_weapon_ammo[playerid][5], player_weapon_ammo[playerid][6],
	player_weapon_ammo[playerid][8], 
	
	pInfo[playerid][pID]);

	mysql_tquery(dbHandle, query_, "", "");

	if (MYSQL_DEBUG) printf("CALLBACK | kLibUpdatePlayerWeapons (%d) | Good", strlen(query_));
	return 1;
} 
stock SearchingHit(playerid)
{
	new full_ = 0, str_[128];
	t_string[0] = EOS;
	strcat(t_string, "Имя/ID\tЦена за голову\n");
	foreach(new i: PlayerInLogin)
	{
		if (!pInfo[i][pLogin]) continue;
		if (pInfo[i][pHeadValue] > 0 && ContractInfo[i][cHitman] == INVALID_PLAYER_ID)
		{
			format(str_, sizeof str_, "{FFFF00}%s[%d]{FFFFFF}\t[%d $]\n", pInfo[i][pName], i, pInfo[i][pHeadValue]);
			strcat(t_string, str_);
			full_++;
		}
	}
	if (!full_) return SendClientMessage(playerid, COLOR_GREY, !"Нет заказов.");
	return ShowPlayerDialog(playerid, D_ZAKAZ_KILL_4, DIALOG_STYLE_TABLIST_HEADERS, "Список заказов", t_string, "Выбрать", "Закрыть");
}
stock GetNameWithNumber(number)
{
	new str[24] = {"Offline/None"};
	foreach(new i: PlayerInLogin)
	{
		if (!pInfo[i][pLogin]) continue;
		if (pInfo[i][PlayerNumber] == number)
		{
			format(str, 24, "%s", pInfo[i][pName]);
			break;
		}
	}
	return str;
}

