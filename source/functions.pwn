}


stock SaveFermIDStats(idx)
{
    new Year, Month, Day, str[2][256];
	getdate(Year, Month, Day);
 	FarmBizStats[idx][4] = FarmBizStats[idx][3];
	FarmBizStats[idx][3] = FarmBizStats[idx][2];
	FarmBizStats[idx][2] = FarmBizStats[idx][1];
	FarmBizStats[idx][1] = FarmBizStats[idx][0];
	FarmBizStats[idx][0] = FarmInfo[idx][fStart];

	FarmBizStatsDate[idx][4] = FarmBizStatsDate[idx][3];
	FarmBizStatsDate[idx][3] = FarmBizStatsDate[idx][2];
	FarmBizStatsDate[idx][2] = FarmBizStatsDate[idx][1];
	FarmBizStatsDate[idx][1] = FarmBizStatsDate[idx][0];
	FarmBizStatsDate[idx][0] = gettime();


	format(str[0], 128, "%d|%d|%d|%d|%d", FarmBizStats[idx][0], FarmBizStats[idx][1], FarmBizStats[idx][2], FarmBizStats[idx][3], FarmBizStats[idx][4]);
	format(str[1], 256, "%d|%d|%d|%d|%d", FarmBizStatsDate[idx][0], FarmBizStatsDate[idx][1], FarmBizStatsDate[idx][2], FarmBizStatsDate[idx][3], FarmBizStatsDate[idx][4]);

	new query_[512];
    format(query_, sizeof query_,"UPDATE `farms` SET `farmBizStats`= '%s', `farmBizStatsDate`= '%s' WHERE `id` = '%d' LIMIT 1",
	str[0], str[1], FarmInfo[idx][fID]);
	mysql_tquery(dbHandle, query_, "", "");
	return 1;
}
stock SaveFermIDFarmers(idx)
{
 	new query_[512];
    format(query_, sizeof query_,"UPDATE `farms` SET `deputy_1`= '%s', `deputy_2`= '%s', `deputy_3`= '%s', `farmer_1`= '%s', `farmer_2`= '%s', `farmer_3`= '%s', `farmer_4`= '%s', `farmer_5`= '%s' WHERE id = '%d' LIMIT 1",
	FarmInfo[idx][fDeputy_1], FarmInfo[idx][fDeputy_2], FarmInfo[idx][fDeputy_3], FarmInfo[idx][fFarmer_1], FarmInfo[idx][fFarmer_2],FarmInfo[idx][fFarmer_3],FarmInfo[idx][fFarmer_4],
	FarmInfo[idx][fFarmer_5], FarmInfo[idx][fID]);
	mysql_tquery(dbHandle, query_, "", "");
