publics: SetLoadAdminInfo(playerid, type)
{
	new rows;
	cache_get_row_count(rows);
	if (!rows)
	{
		/*ADMIN ACC NOT FOUND */
		return 1;
	}
	cache_get_value_int(0, "id", aAdminInfo[playerid][aID]); 
	cache_get_value_int(0, "level", pInfo[playerid][pAdmin]); 
	cache_get_value_int(0, "s_Reports", aAdminInfo[playerid][aReport]); //++
	cache_get_value_int(0, "s_Reputes", aAdminInfo[playerid][aRepute]); //++
	cache_get_value_int(0, "s_Jails", aAdminInfo[playerid][aJail]); //++
	cache_get_value_int(0, "s_Mutes", aAdminInfo[playerid][aMute]); //++
	cache_get_value_int(0, "s_Prisons", aAdminInfo[playerid][aPrison]); //++
	cache_get_value_int(0, "s_Warns", aAdminInfo[playerid][aWarn]); //++
	cache_get_value_int(0, "s_Bans", aAdminInfo[playerid][aBan]); //++
	cache_get_value_name(0, "IP", aAdminInfo[playerid][aRegIP]);
	cache_get_value_name(0, "Prefix", aAdminInfo[playerid][aPrefix]);
	cache_get_value_name(0, "Color", aAdminInfo[playerid][aColor]);	
				//SetPVarString(playerid, "adminsIP", admins_ip);
  
	pTemp[playerid][PlayerADostup] = true;
	pTemp[playerid][PlayerUseAdminGM] = true;
	if (type == 1)
	{ 	 
		SendClientMessage(playerid, COLOR_GREEN, !"Вы получили доступ модератора");
		SendClientMessage(playerid, COLOR_GREEN, !"Автоматически включился GM (от пуль). Выключить >> (/agm)");   
	}
	else {
		new 
			player_ip[16],
			query_[128];
		GetPlayerIp(playerid, player_ip, sizeof player_ip);

		mysql_format(dbHandle, query_, sizeof query_, "UPDATE `s_admin` SET LastCon = '%d', LastIP = '%s' WHERE id = '%d' LIMIT 1", 
			gettime(), player_ip, aAdminInfo[playerid][aID]
		);
		mysql_tquery(dbHandle, query_, "", ""); 
	}
	new 
		string_[128];
	Iter_Add(AdminsTeam, playerid); 

		if(!strcmp(aAdminInfo[playerid][aPrefix], "None", true)){
			format(string_, sizeof(string_), "Вы успешно авторизовались как %s", adminPostNames[pInfo[playerid][pAdmin]]);
			SendClientMessage(playerid, 0xFFFFFFFF, string_);

			f(string_, "[A] %s %s в административной панели как %s", pInfo[playerid][pName], 

			pInfo[playerid][pSex] == 1 ? ("авторизовался") : ("авторизовалась"), adminPostNames[pInfo[playerid][pAdmin]]
			);
			SendAdminMessage(0xF4B800AA, string_); 			
		}
		else{
			format(string_, sizeof(string_), "Вы успешно авторизовались как {%s}%s", aAdminInfo[playerid][aColor], aAdminInfo[playerid][aPrefix]);

			SendClientMessage(playerid, 0xFFFFFFFF, string_);

			f(string_, "[A] %s %s в административной панели как {%s}%s", pInfo[playerid][pName], 

			pInfo[playerid][pSex] == 1 ? ("авторизовался") : ("авторизовалась"), aAdminInfo[playerid][aColor], aAdminInfo[playerid][aPrefix]
			);
			SendAdminMessage(0xF4B800AA, string_); 
		}


		for(new i; i < sizeof(CheatShow); i++) {
			TextDrawShowForPlayer(playerid, CheatShow[i]);
		} 
	return 1;
}

stock IsPlayerGetSettings(playerid, type) {
	return (pInfo[playerid][PlayerSettings] & type) ? true : false;
} 

stock StartDeliveryMats()
{
	new zone_delivery[28],
		zone_start,
		vehicleid;

	const max_spawn_position = 5;
	static Float:spawn_deliver_car[max_spawn_position][4] = {
		{1190.8505,238.9082,19.7070,334.3705},
		{2644.6152,729.9600,10.8844,90.00},
		{2866.4045,940.6224,10.8191,180.00},
		{2399.7021,2800.6113,10.8250,360.00},
		{1681.4958,2358.6951,10.8850,268.54}
	};

	static str_deliv[] = "Неподалёку от района \"%s\" был замечен фургон с материалами, заберите его и привезите на базу! (помечено на карте)";
	new tmp_str[sizeof(str_deliv) + sizeof(zone_delivery) - 2];

	zone_start = random(max_spawn_position);

	GetPos2DZone(spawn_deliver_car[zone_start][0],spawn_deliver_car[zone_start][1],zone_delivery,sizeof(zone_delivery));


	vehicleid = _CreateVehicle(609, spawn_deliver_car[zone_start][0],spawn_deliver_car[zone_start][1],spawn_deliver_car[zone_start][2],spawn_deliver_car[zone_start][3], 151, 122, -1);
	_SetVehicleHealth(vehicleid, 3000.0);
	VehicleInfo[ vehicleid - 1 ][vType] = VEHICLE_TYPE_DYNAMIC;
	VehicleInfo[ vehicleid - 1][vFraction] = DYNAMIC_VEH_MATS;
	VehicleInfo[ vehicleid - 1 ][vMaterials] = 200000;
	VehicleInfo[ vehicleid - 1 ][vFuel] = GetModelMaxFuel(VehicleInfo[ vehicleid - 1 ][vModel]);
	VehicleInfo[ vehicleid - 1 ][vLocked] = false;
	GetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, doors3, bonnet2, boot1, objective1);
	SetVehicleParamsEx(vehicleid, engine1, lights2, alarm2, false, bonnet2, boot1, objective1);

	format(tmp_str,sizeof(tmp_str),str_deliv,zone_delivery);

	SendGangMessage(0xE8EE7BFF, tmp_str);
	SendMafiaMessage(0xE8EE7BFF, tmp_str);

	foreach(new playerid: PlayerInLogin)
	{
		if (IsAGang(playerid) || IsAMafia(playerid))
		{
			SetPlayerMapIcon(playerid, 99,
				spawn_deliver_car[zone_start][0],
				spawn_deliver_car[zone_start][1],
				spawn_deliver_car[zone_start][2],
				51, 0xFCFCFCFF, MAPICON_GLOBAL_CHECKPOINT);
		}
	}
	SetTimer("ResetMapIconDelivery", 120_000, false);
	return 1;
}

publics:ResetMapIconDelivery()
{
	foreach(new playerid: PlayerInLogin)
	{
		RemovePlayerMapIcon(playerid, 99);
	}
	return 1;
}   

stock ShowPlayerInteractionMenu(playerid, target_id) {
	if (target_id == INVALID_PLAYER_ID) {
		SendClientMessage(playerid, COLOR_GREY, !"Игрок не найден!");
	}
	pTemp[playerid][tPlayerTargetID] = target_id;
	new 
		str_[64];
	format(str_, sizeof str_, ""colserver"Взаимодействия с "colwhi"%s[%d]", pInfo[target_id][pName], target_id);
	switch(pInfo[playerid][pMember]) {
		case FRACTION_LSPD, FRACTION_SFPD, FRACTION_LVPD: {
			ShowPlayerDialog(playerid, D_PLAYER_TATGET_0, DIALOG_STYLE_LIST, str_, 
				"[0] Зачитать права\n[1] Показать удостоверение\n[2] Оглушить электрошокером\n[3] Надеть наручники\n[4] Обыскать\n[5] Вести за собой", "Выбрать", "Закрыть"
			);
		}
		case FRACTION_FBI: {
			ShowPlayerDialog(playerid, D_PLAYER_TATGET_1, DIALOG_STYLE_LIST, str_, 
				"[0] Зачитать права\n[1] Показать удостоверение\n[2] Оглушить электрошокером\n[3] Надеть наручники\n[4] Обыскать\n[5] Вести за собой", "Выбрать", "Закрыть"
			);
		}
		case FRACTION_AUTOSCHOOL: {
			ShowPlayerDialog(playerid, D_PLAYER_TATGET_2, DIALOG_STYLE_LIST, str_, 
				"[0] Выдача лицензий\n[1] Показать удостоверение", "Выбрать", "Закрыть"
			);
		}
		case FRACTION_LV_NEWS, FRACTION_LS_NEWS, FRACTION_SF_NEWS: {

		}
	}
	return 1;
}

		
