stock IsAMafia(playerid)
{
	if (!IsPlayerConnected(playerid)) return 0;
	if (pInfo[playerid][pMember] == FRACTION_LCN || pInfo[playerid][pMember] == FRACTION_YAKUZA || pInfo[playerid][pMember] == FRACTION_RUSSIAN) return 1; 
	return 0;
}
stock IsABiker(playerid)
{
	if (!IsPlayerConnected(playerid)) return 0;
	if (pInfo[playerid][pMember]== 24 || pInfo[playerid][pMember]==25 || pInfo[playerid][pMember]==26) return 1; 
	return 0;
}
stock IsAGang(playerid)
{
	if (!IsPlayerConnected(playerid)) return 0;
	switch(pInfo[playerid][pMember])
	{
		case FRACTION_PIRUS, FRACTION_BALLAS, FRACTION_VAGOS, FRACTION_GROVE, FRACTION_RIFA, FRACTION_AZTEC: return 1;
		default: return 0;
	} 
	return 0;
}
stock IsATerra(playerid)
{
	if (pInfo[playerid][pMember] == FRACTION_BALLAS && IsPlayerInRangeOfPoint(playerid, 20.0,2651.4746,-2004.3387,13.3828) // Ballas
			||pInfo[playerid][pMember] == FRACTION_VAGOS && IsPlayerInRangeOfPoint(playerid, 20.0, 2770.7471,-1628.7227,12.1775) // Vagos
			||pInfo[playerid][pMember] == FRACTION_GROVE && IsPlayerInRangeOfPoint(playerid, 20.0, 2492.7532,-1676.3687,13.3380) // Groove
			||pInfo[playerid][pMember] == FRACTION_AZTEC && IsPlayerInRangeOfPoint(playerid, 20.0, 1672.0626,-2113.1340,13.5469) // Aztecas
			||pInfo[playerid][pMember] == FRACTION_RIFA && IsPlayerInRangeOfPoint(playerid, 20.0, 2184.1218,-1803.6334,13.3693)) return 1; // Rifa
	else return 0;
}
stock IsAMedKit(playerid)
{
    if (pInfo[playerid][pMember] == FRACTION_BALLAS && 	IsPlayerInRangeOfPoint(playerid, 20.0, -194.1146,88.6843,973.3170) && GetPlayerVirtualWorld(playerid) == 1 // Ballas Base
		||pInfo[playerid][pMember] == FRACTION_VAGOS && IsPlayerInRangeOfPoint(playerid, 20.0, 2794.1233,-1607.5570,-36.5231) // Vagos Base
		||pInfo[playerid][pMember] == FRACTION_GROVE && IsPlayerInRangeOfPoint(playerid, 20.0, 2496.0129,-1708.9232,1014.7422) // Groove Base
		||pInfo[playerid][pMember] == FRACTION_AZTEC && IsPlayerInRangeOfPoint(playerid, 20.0, -49.7558,1400.3553,1084.4297) // Aztecas Base
		||pInfo[playerid][pMember] == FRACTION_RIFA &&  IsPlayerInRangeOfPoint(playerid, 20.0, 2808.9631,-1169.0806,1025.5703) // rifa
		||pInfo[playerid][pMember] == FRACTION_LCN && GetPlayerInterior(playerid) == LCN_INTERIOR && GetPlayerVirtualWorld(playerid) == 1
		||pInfo[playerid][pMember] == FRACTION_YAKUZA && GetPlayerInterior(playerid) == YAKUZA_INTERIOR && GetPlayerVirtualWorld(playerid) == 1
		||pInfo[playerid][pMember] == FRACTION_RUSSIAN && GetPlayerInterior(playerid) == RM_INTERIOR && GetPlayerVirtualWorld(playerid) == 1) return 1;
	else return 0;
}  
