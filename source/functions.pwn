show_skill(playerid, targetid)
{
	new points[6], percent[2] = "%";
	t_string[0] = EOS;
	points[0] = 100 - pInfo[targetid][pGunSkill][0];
	points[1] = 100 - pInfo[targetid][pGunSkill][1];
	points[2] = 100 - pInfo[targetid][pGunSkill][2];
	points[3] = 100 - pInfo[targetid][pGunSkill][3];
	points[4] = 100 - pInfo[targetid][pGunSkill][4];
	points[5] = 100 - pInfo[targetid][pGunSkill][5];
	format(t_string, sizeof t_string, "\nSDPistol:\t[%s]%d%s\nDeagle:\t[%s]%d%s\nShotGun:\t[%s]%d%s\nMP5\t\t[%s]%d%s\nAK47:\t\t[%s]%d%s\nM4A1:\t\t[%s]%d%s\n",
	ToDevelopSkills(pInfo[targetid][pGunSkill][0],points[0]),pInfo[targetid][pGunSkill][0],percent,
	ToDevelopSkills(pInfo[targetid][pGunSkill][1],points[1]),pInfo[targetid][pGunSkill][1],percent,
	ToDevelopSkills(pInfo[targetid][pGunSkill][2],points[2]),pInfo[targetid][pGunSkill][2],percent,
	ToDevelopSkills(pInfo[targetid][pGunSkill][3],points[3]),pInfo[targetid][pGunSkill][3],percent,
	ToDevelopSkills(pInfo[targetid][pGunSkill][4],points[4]),pInfo[targetid][pGunSkill][4],percent,
	ToDevelopSkills(pInfo[targetid][pGunSkill][5],points[5]),pInfo[targetid][pGunSkill][5],percent);
	ShowPlayerDialog(playerid, D_NULL, DIALOG_STYLE_MSGBOX, ""colserver"Навыки: "colserver"Владения оружием", t_string, "Готово", "");
}
