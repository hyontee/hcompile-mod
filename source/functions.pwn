stock is_text_invalid (const text [ ] )
{
	if ( strfind ( text, "'", true ) != -1 ) return 1;
	if ( strfind ( text, "=", true ) != -1 ) return 1;
	if ( strfind ( text, "%", true ) != -1 ) return 1;
	if ( strfind ( text, "&", true ) != -1 ) return 1;
	if ( strfind ( text, "*", true ) != -1 ) return 1;
	if ( strfind ( text, "( ", true ) != -1 ) return 1;
	if ( strfind ( text, ")", true ) != -1 ) return 1;
	if ( strfind ( text, ",", true ) != -1 ) return 1;
	if ( strfind ( text, "`", true ) != -1 ) return 1;
	if ( strfind ( text, ";", true ) != -1 ) return 1;
	if ( strfind ( text, "|", true ) != -1 ) return 1;
	return 0 ;
}

stock Hide_SkinShop(playerid)
{ 
	new 
		id = pTemp[playerid][tBusinessID],
		interior_id = BusinessInfo[id][bInteriorID];

	PressedPickup[playerid] = BusinessInfo[id][bBuyPickup];

	SetPlayerPosAC(playerid, 
		BusinessInteriorInfo[interior_id][bIntMenuPos][0],
		BusinessInteriorInfo[interior_id][bIntMenuPos][1],
		BusinessInteriorInfo[interior_id][bIntMenuPos][2], BusinessInfo[id][bWorld], 
		BusinessInteriorInfo[interior_id][bIntInterior]
	);
	SetPlayerFacingAngle(playerid, 0.000);
    //if (PlayerInfo[playerid][pPlayerMember] != 0) SetPlayerSkinEx(playerid, PlayerInfo[playerid][pModel]);
	//else SetPlayerSkinEx(playerid, PlayerInfo[playerid][pChar]);
	SetPlayerSkinEx(playerid, pInfo[playerid][pChar][0]);
	PlayerTextDrawHide(playerid, sk_info_text[playerid]);
	for(new t; t != 33; t++) {
		TextDrawHideForPlayer(playerid, SkinShopMenu[t]);
	}
	pTemp[playerid][tSelectSkinShop] = -1;
	SetCameraBehindPlayer(playerid);
	TogglePlayerControllable(playerid, 1);
	CancelSelectTextDraw(playerid);
	return 1;
} 



stock IsPlayerInFractionInterior(playerid, memberid) {
	if (
		IsPlayerInRangeOfPoint(playerid, 100.0, gFraction[memberid][fPos][0], gFraction[memberid][fPos][1], gFraction[memberid][fPos][2]) &&
		GetPlayerInterior(playerid) == gFraction[memberid][fInt] && GetPlayerVirtualWorld(playerid) == gFraction[memberid][fWorld]
	) return true;
	return false;
}


stock IsFracIntBlocked(playerid, memberid) {
	if (
		!(0 <= memberid < FRACTION_COUNT) || /*pTemp[playerid][PlayerADostup] || */ 
		IsACop(playerid) || pInfo[playerid][pFracIntBlock][memberid - 1] - gettime() <= 0
	) return false;

	format(t_string, sizeof (t_string), "Вас недавно выгнали из помещения, войти можно будет через %s.", 
		Convert(pInfo[playerid][pFracIntBlock][memberid - 1] - gettime())
	);
	SendClientMessage(playerid, COLOR_GREY, t_string), t_string[0] = EOS;
	return true;
}
stock SaveFractionSalary(fraction_id) {
	new query_[256];
	mysql_format(dbHandle, query_, sizeof query_, "UPDATE `s_fraction` SET \
		`fSalary` = '%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i' WHERE `fID` = '%d' LIMIT 1",
		fFractionSalary[fraction_id][0], fFractionSalary[fraction_id][1], fFractionSalary[fraction_id][2], 
		fFractionSalary[fraction_id][3], fFractionSalary[fraction_id][4], fFractionSalary[fraction_id][5], 
		fFractionSalary[fraction_id][6], fFractionSalary[fraction_id][7], fFractionSalary[fraction_id][8], 
		fFractionSalary[fraction_id][9], fFractionSalary[fraction_id][10], fFractionSalary[fraction_id][11], 
		fFractionSalary[fraction_id][12], fFractionSalary[fraction_id][13], fFractionSalary[fraction_id][14], 
		fraction_id
	);
	mysql_tquery(dbHandle, query_, "", "");
}
stock ShowSuspectList(playerid, member, type = 1) {
	new query_[128];
	format(query_, sizeof (query_), "SELECT id, suspectReason, wantedLevel FROM \
		`s_suspect` WHERE fracID = %d ORDER BY `wantedLevel`", member
	);
	new rows, idx, Cache:tempQuery = mysql_query(dbHandle, query_);

	query_[0] = EOS;
	cache_get_row_count(rows);
	format(t_string, sizeof (t_string), ""colserver"[№] Наказание\t"colserver"Розыск\n");

	for (new i = 0, reason[32 + 1], id, level; i < rows; i++) {
		cache_get_value_name_int(i, "id", id);
		cache_get_value_name(i, "suspectReason", reason, sizeof (reason));
		cache_get_value_name_int(i, "wantedLevel", level);

		//printf("ShowSuspectList: i %d id = %d", i, id);
		playerListItem[playerid][idx] = id;
		format(t_string, sizeof (t_string), "%s"colwhi"[%d] %s\t%d\n", t_string, idx++, reason, level);
	}
	if (type == 1) {
		playerListItem[playerid][idx] = 100000_1;
		format(t_string, sizeof (t_string), "%s"collime"[%d] Добавить пункт\t \n", t_string, idx++);
	} 
	else if (type == D_GIVE_SUSPECT) {
		if (!rows) return SendClientMessage(playerid, COLOR_GREY, !"Лидер еще не настроил /suspect!");
		ShowPlayerDialog(playerid, D_GIVE_SUSPECT, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Выберите: "colwhi"Наказание", t_string, "Выбрать", "Отмена");
		t_string[0] = EOS;
		if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
		return true;
	}
	ShowPlayerDialog(playerid, D_LIST_SUSPECT, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Изменение: "colwhi"Наказаний", t_string, "Выбрать", "Отмена");

	
	t_string[0] = EOS;
	if (cache_is_valid(tempQuery)) cache_delete(tempQuery);
	return true;
}


stock GetDynamicAreaTypeID(areaid, &area_id, &type, &area_extra_id) {
	new areaType[3];
	Streamer_GetArrayData(STREAMER_TYPE_AREA, areaid, E_STREAMER_EXTRA_ID, areaType, sizeof (areaType));
	area_id = areaType[0];
	type = areaType[1];
	area_extra_id = areaType[2];
}
stock SetDynamicAreaType(areaid, type, extra_id = 0) {
	new areaType[3];
	areaType[0] = areaid;
	areaType[1] = type;
	areaType[2] = extra_id;
	Streamer_SetArrayData(STREAMER_TYPE_AREA, areaid, E_STREAMER_EXTRA_ID, areaType, sizeof (areaType));
}
