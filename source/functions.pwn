stock LoadPlayerDj(playerid)
{
    static get_dj[] = "SELECT * FROM `Creative_fm` WHERE `playerid` = '%d' LIMIT 1";
	new string[sizeof(get_dj) + ( -2 + MAX_PLAYER_NAME)+10];
	mysql_format(dbHandle,string, sizeof(string),get_dj, pInfo[playerid][pID]);
	mysql_tquery(dbHandle,string, "LoadCreativeDj","dddd",playerid,2,pInfo[playerid][pID],playerid);
    return 1;
}

publics:LoadCreativeDj( playerid, status, MySQLID, id )
{
	if(status == 0 )
	{
		if (cache_num_rows())
			return SendClientMessage(playerid, CGRAY2, !"Этот игрок уже есть в списке радиоведущих! ( Используйте /offDj [id аккаунта /getid ] )");

		new 
			query_[128];
		mysql_format(dbHandle, query_, sizeof query_, "INSERT INTO `Creative_fm` (`playerid`) VALUES ('%d')", MySQLID);
		mysql_tquery(dbHandle,query_, "LoadCreativeDj","dddd",playerid,1,pInfo[id][pID],id);
	}
	else if(status == 1)
	{
		pTemp[id][tRadioHost] = 1;
		SendMes(playerid,CGRAY2,"Вы назначили нового ведущего: %s",pInfo[id][pName]);
		SendMes(id,COLOR_GREEN,"Администратор %s назначил Вас ведущим радиостанции",pInfo[playerid][pName]);
	}
	else if(status == 2)
	{
		if (cache_num_rows())
			pTemp[playerid][tRadioHost] = 1;
	}
	else if(status == 3)
	{
		SendMes(playerid,CGRAY2,"Вы удалили доступ к радиостанции игроку MySQL id: %d",MySQLID);
		foreach(new i: PlayerInLogin)
    	{
			if(MySQLID == pInfo[i][pID] && pTemp[i][tRadioHost] != 0)
			{
				pTemp[i][tRadioHost] = 0;
				SendClientMessage(i,CGRAY2,!"У Вас забрали доступ к радиостанции Warrior FM");
				break;
			}
		}
	}
	return 1;
}

publics: get_user_id(const playerid, params[])
{
	new rows,
		string_[128];
	cache_get_row_count(rows);
	if(rows) {
		new 
			name[MAX_PLAYER_NAME], pid;
		cache_get_value_name_int(0, "pID",pid);
		cache_get_value_name(0, "Name", name, MAX_PLAYER_NAME);
 
		format(string_, sizeof string_,"Ник: %s. MySQL id: %d", name, pid);
		SendClientMessage(playerid, CGRAY2, string_);
	} else { 
		format(string_, sizeof string_, ""colwhi"По запросу %s не найден аккаунт", params);
		return ShowPlayerDialog(playerid, D_NULL, 0, "Запрос", string_, !"Закрыть", "");
	}

	return 1;
}
stock CheckFamilyHouseFree(idx) 
{	
    new 
		query_[100]; 
    format(query_, sizeof query_,"SELECT Name, pID FROM s_users WHERE playerspawn = '6' AND pFamily = '%d'", HouseInfo[idx][hFamily]);
    new Cache: result = mysql_query(dbHandle, query_), rows; 
    cache_get_row_count(rows);
    if (!rows) {
        if (cache_is_valid(result)) cache_delete(result);
        return 1;
    }
    for(new i = 0, account_id, name[MAX_PLAYER_NAME], get_id; i < rows; i++)
    {
        cache_get_value_name_int(i, "pID", account_id);
        cache_get_value_name(i, "Name", name, MAX_PLAYER_NAME + 1); 
        get_id = GetCheckID(name);
        if (get_id != INVALID_PLAYER_ID) {
            SendClientMessage(get_id, COLOR_YELLOW, !"[Подсказка] "colwhi"Дом семьи в котором Вы жили был продан");
            SendClientMessage(get_id, COLOR_YELLOW, !"[Подсказка] "colwhi"Ваш спавн был изменен на "colserver"Стандартный"); 
			if (pInfo[get_id][PlayerSpawn] == 6) {
				pInfo[get_id][PlayerSpawn] = 0;
			}       
        }
        format(query_, sizeof query_, "UPDATE s_users SET playerspawn = '0' WHERE pID = '%d'", account_id);
        mysql_query(dbHandle, query_);
    }
    FamilyInfo[ HouseInfo[idx][hFamily] - 1 ][fDefHouse] = -1;
    format(query_, sizeof query_, "UPDATE "TABLE_FAMILY" SET fDefHouse= '-1' WHERE fID = '%d'", HouseInfo[idx][hFamily]);
    mysql_query(dbHandle, query_);
	ClearFamilyVehicle(HouseInfo[idx][hFamily]);
    HouseInfo[idx][hFamily] = -1; 
	SaveHouse(idx, "hFamily = '-1'");
    if (cache_is_valid(result)) cache_delete(result);
    return 1;
} 


publics: OnPlayerSearchOld(playerid) {
	if (cache_num_rows()) {
		SendClientMessage(playerid, COLOR_YELLOW, "[Подсказка] "colwhi"Аккаунт найден, укажите Ваш пароль");
		ShowLoginTransfer(playerid);
		cache_get_value_name_int(0, "pID", pTransfer[playerid][tID_Users]);

	} else {
		SendClientMessage(playerid, COLOR_GREY, "Данный аккаунт не найден");
	}
	return 1;
}
stock ShowLoginTransfer(playerid) {
	t_string[0] = EOS;
	format(t_string, sizeof t_string, ""colwhi"____________________________________________________\n\n\
		\tДобро пожаловать на "colserver##NameServer##colwhi"\n\
		\tДанный аккаунт найден для восстановление\n\n\
		Введите пароль:\n\
		____________________________________________________",
		pInfo[playerid][pName]
	);
	ShowPlayerDialog(playerid, D_LOGIN_TRANSFER, DIALOG_STYLE_PASSWORD, ""colserver"Авторизация: "colwhi"Восстановление", t_string, "Войти", "Отмена");
}
publics: LoadPlayerTransfer(playerid)
{
	new
		rows, str_[128], 
		kickout[256], str_title[64];
	t_string[0] = EOS;
	cache_get_row_count(rows);
	if (!rows) {
		SendClientMessage(playerid, COLOR_GREY, !"Вы указали неверный пароль");
		ShowLoginTransfer(playerid);
	} else {
		new 
			name_transfer[MAX_PLAYER_NAME];
		cache_get_value_name(0, "Name", name_transfer, sizeof name_transfer);
		cache_get_value_name_int(0, "pID", pTransfer[playerid][tID_Users]);
	    cache_get_value_name_int(0, "pLevel", pTransfer[playerid][tLevel]);
	    cache_get_value_name_int(0, "pExp", pTransfer[playerid][tEXP]);
		
	    cache_get_value_name_int(0, "vip_rank", pTransfer[playerid][tVIP]);
		cache_get_value_name_int(0, "boost_rank", pTransfer[playerid][tBoost]);
	    cache_get_value_name_int(0, "pPnumber", pTransfer[playerid][tNumber]); 
		cache_get_value_name_int(0, "u_donate", pTransfer[playerid][tDonate]);
		cache_get_value_name_int(0, "pCash", pTransfer[playerid][tCash]);
		cache_get_value_name_int(0, "pBank", pTransfer[playerid][tBank]);
		cache_get_value_name_int(0, "pDeposit", pTransfer[playerid][tDeposit]);
		cache_get_value_name_int(0, "pMember", pTransfer[playerid][tMember]);
		cache_get_value_name_int(0, "pRank", pTransfer[playerid][tRank]);
		cache_get_value_name_int(0, "pModel", pTransfer[playerid][tModel]);
		cache_get_value_name_int(0, "pMats", pTransfer[playerid][tMaterials]);
		cache_get_value_name_int(0, "pDrugs", pTransfer[playerid][tDrugs]);
		cache_get_value_name(0, "pChars", kickout, sizeof kickout);
		sscanf(kickout, "p<,>a<d>[6]", pTransfer[playerid][tChar]);

		cache_get_value_name(0, "pGunSkills", kickout, sizeof kickout);
		sscanf(kickout, "p<,>a<d>[6]", pTransfer[playerid][tGunSkills]);
		cache_get_value_name(0, "playerItems", kickout, sizeof (kickout));
		sscanf(kickout, "p<|>a<i>["#MAX_ITEMS_SLOTS"]", pTransfer[playerid][tPlayerItems]);
			
		cache_get_value_name(0, "playerItemsCount", kickout, sizeof (kickout));
		sscanf(kickout, "p<|>a<i>["#MAX_ITEMS_SLOTS"]", pTransfer[playerid][tPlayerItemsCount]);
		new	
			count_item = 0;
		for(new i = 0; i < MAX_ITEMS_SLOTS ; i ++) {
			if (pTransfer[playerid][tPlayerItems][i] != 0) {
				count_item++;
			} 
		} 

	    format(str_, sizeof str_, "Уровень:\t%d\nExp:\t%d\n", pTransfer[playerid][tLevel], pTransfer[playerid][tEXP]);
		strcat(t_string, str_);
		format(str_, sizeof str_, "VIP:\t%d\nСтартовый пакет:\t%d\nНомер:\t%d\nДенег:\t$%d\nБанк:\t$%d\n", pTransfer[playerid][tVIP], pTransfer[playerid][tBoost], pTransfer[playerid][tNumber], pTransfer[playerid][tCash], pTransfer[playerid][tBank]);
		strcat(t_string, str_);
		format(str_, sizeof str_, "Депозит:\t$%d\n"DonatePoint":\t$%d\nМатериалы:\t%d\nНаркотики:\t%d\n", pTransfer[playerid][tDeposit], pTransfer[playerid][tDonate], pTransfer[playerid][tMaterials], pTransfer[playerid][tDrugs]);
		strcat(t_string, str_);
		format(str_, sizeof str_, "Организация:\t%d(%s)\nРанг:\t%d\nПредметов в инветаре\t%d\n", pTransfer[playerid][tMember], gFraction[pTransfer[playerid][tMember]][fName], pTransfer[playerid][tRank], count_item);
		strcat(t_string, str_);

		format(str_title, sizeof str_title, "ID: %d | Name: %s "colwhi"(Восстановление)", pTransfer[playerid][tID_Users], name_transfer);
		ShowPlayerDialog(playerid, D_LOGIN_TRANSFER_0, DIALOG_STYLE_TABLIST, str_title, t_string, "Перенести", "Отмена");
	}
	return 1;
}

#if defined _hkac_included 
publics: hkOnCheatDetected(playerid, code) {

	if (GetPlayerAdmin(playerid) > 0 || NEW_ANTICHEAT_ALF == 0) return 0;
	new buffer[144];
	format(buffer, sizeof(buffer), " Вы были кикнуты по подозрению в читерстве. (#hk-%i)", code);
	SendClientMessage(playerid, hkKICK_COLOR, buffer);

	SetTimerEx(#hkKick, 250, false, "ii", playerid, code);
	//иначе сообщение в чат + кик
	return 1;
} 

publics: hkOnSendWarning(playerid, const message[]) {

	if (/*GetPlayerAdmin(playerid) > 0 ||*/ NEW_ANTICHEAT_ALF == 0) return 1;
	//format(string_, sizeof string_, "<Warning> %s[%d] Damager by Shot (1)[!]: Проверить", pInfo[playerid][pName], playerid);
	SendAdminMessage(COLOR_REDD, message);
	return 1;
}

#endif

UpdateFactoryText() {
	for (new i, str_name[32], string_[128]; i < S_FACTORY_SORT_COUNT; i++) {
		str_name = "Неизвестно";
		switch(i) {
			case 0, 2: str_name = "На сортировке";
			case 1, 3: str_name = "На отправку";
		} 
		format(string_, sizeof string_, "%s: "colserver"%d", str_name, gFactorySortInfo[i][sortBoxCount]);
		UpdateDynamic3DTextLabelText(gFactorySortInfo[i][sortText], -1, string_);
		if(gFactorySortInfo[i][sortPlaceToggle] != INVALID_PLAYER_ID) {
			Streamer_Update(gFactorySortInfo[i][sortPlaceToggle]);
		}
	}
}
