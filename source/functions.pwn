publics: FlyCameraForPlayer(playerid) {
	for(new i; i < 5; i++){TextDrawShowForPlayer(playerid, Text:TD_welcome[i]);}
	//new rand = random(sizeof(cam_start_pos));
	SetPlayerWeather(playerid, 18);
	SetPlayerTime(playerid, hour, minute);

/*1720.840087,-1791.590942,25.770624

1711.797363,-1787.649414,27.412099*/

    InterpolateCameraPos(playerid, 1711.797363,-1787.649414,27.412099, 1711.797363,-1787.649414,27.412099, 30000);
    return InterpolateCameraLookAt(playerid, 1720.840087,-1791.590942,25.770624, 1720.840087,-1791.590942,25.770624, 30000);
}

publics: PlayerSpawnEx(playerid)
{
    if (IsPlayerNPC(playerid)) return true;
    if (IsPlayerInAnyVehicle(playerid))
	{
	    new
			Float:	pos_X,
			Float:	pos_Y,
			Float:	pos_Z;
	    GetPlayerPos(playerid, pos_X, pos_Y, pos_Z);
		SetPlayerPosAC(playerid, pos_X, pos_Y, pos_Z, pTemp[playerid][tVirtualWorld], pTemp[playerid][tInterior]);
	    SetTimerEx("PlayerSpawnEx", 50, false, "i", playerid);
	    return 1;
	}
	SettingSpawn(playerid);
	if (AC_Info[playerid][acSpectate] != 0) TogglePlayerSpectating(playerid, 0);
	else SpawnPlayer(playerid);
	return 1;
}
stock ChosePlayerSkin(playerid)
{
	pTemp[playerid][tSelectSkin] = true;
	print("ChosePlayerSkin");
	switch(pInfo[playerid][pSex])
	{
	    case 1: pInfo[playerid][pChar][0] = BomjPedMale[ChangeSkin[playerid]];
		case 2: pInfo[playerid][pChar][0] = BomjPedFeMale[ChangeSkin[playerid]];
	}
	//SetPlayerSkinEx(playerid, pInfo[playerid][pChar][0]);
	pTemp[playerid][tVirtualWorld] = playerid;
	pTemp[playerid][tInterior] = 0;
	SetSpawnInfo(playerid, 0, pInfo[playerid][pChar][0], 1716.1293,-1789.9769,26.3864,58.1617, 0, 0, 0, 0, 0, 0);
	if (AC_Info[playerid][acSpectate] != 0) TogglePlayerSpectating(playerid, 0);
	SetPlayerPos(playerid, 1716.1293,-1789.9769,26.3864);
	SetPlayerFacingAngle(playerid, 58.1617);
	setFreezePlayerForTime(playerid, 3);

	SetPlayerVirtualWorld(playerid, playerid);
	SetPlayerInterior(playerid, 0);
	ApplyAnimation(playerid, !"DEALER", !"DEALER_IDLE", 4.0, 1, 0, 0, 1, 1);

    InterpolateCameraPos(playerid, 1711.797363,-1787.649414,27.412099, 1711.797363,-1787.649414,27.412099, 30000);
    InterpolateCameraLookAt(playerid, 1720.840087,-1791.590942,25.770624, 1720.840087,-1791.590942,25.770624, 30000);

	pTemp[playerid][tPlayerReg] = 1;
	for(new i = 0; i < 29; i++)
		TextDrawShowForPlayer(playerid, SelectSkinTD[i]);

	SelectTextDraw(playerid, 0xFF4040AA);
	
    SendClientMessage(playerid, COLOR_WHITE, !"Используйте стрелки "collime"\"<\""colwhi" и "collime"\">\""colwhi" чтобы изменять одежду");
	SendClientMessage(playerid, COLOR_WHITE, !"Для подтверждения нажмите "collime"\"SELECT\"");
	return SetPlayerSkinEx(playerid, pInfo[playerid][pChar][0]);
}

publics: OnPlayerRequestSearch(playerid, time)
{ 
	ClearChatbox(playerid, 20);
	SendClientMessage(playerid, COLOR_WHITE, !"Добро пожаловать на "colserver##NameServer"");
    if (cache_num_rows()) { 
		
		cache_get_value_name_int(0, "pID", pTemp[playerid][tPlayerCurrentID]);
		cache_get_value_name(0, "pvIp", pInfo[playerid][LastIP], 17);
		cache_get_value_name_int(0, "pConfirmVK", pInfo[playerid][pConfirmVK]);
		cache_get_value_name(0, "pVK_ID", pInfo[playerid][pVK_ID], 32);
		cache_get_value_name_int(0, "pConfirmTG", pInfo[playerid][pConfirmTG]);
        cache_get_value_name(0, "pTG_ID", pInfo[playerid][pTG_ID], 32); 
		cache_get_value_name_int(0, "Settings", pInfo[playerid][PlayerSettings]);
		new	
			query_[128];
		mysql_format(dbHandle, query_, sizeof query_, "SELECT Text, NameAdmin, Date, Unban FROM `s_ban` WHERE `Name` = '%e' LIMIT 1", pInfo[playerid][pName]);
		mysql_tquery(dbHandle, query_, "StatusBan", "i", playerid);  

		PlayAudioStreamForPlayer(playerid, "http://www.mboxdrive.com/welcome.mp3");

	} else {
		static const server_rulles[] = ""colserver"1. Игровой процесс"colwhi"\nЗапрещено:\n\
			- Использование любых программ скриптов читов и.т.п. дающие нечестное преймущество в игре.\n\
			- Использование багов (Ошибок, Неисправностей мода)\n\
			- Использовать ESC в целях ухода от погони/смерти.\n\
			- Убивать игроков на спавне (Место возрождения, базы организаций)\n\
			- Убивать игроков при помощи транспорта (Давить, Стрелять с водительского места)\n\
			- Убийство/нанесение физического вреда игрокам без причины (ДМ - Death Match)\n\
			- Злоупотребление игровыми возможностями для создания неудобств игрокам.\n\n\
			"colserver"2. Ник в игре:\n\
			"colwhi"- (сменить ник можно через /mm >> Настройки >> Смена ника)\n\
			- Ник должен состоять из Имени_Фамилии с заглавных букв.\nЗапрещено:\n\
			- Запрещено использовать чужие (уже кем-то занятые) ники.\n\
			- Запрещено использовать ники, содержащие нецензурные или оскорбительные слова.\n\
			- Отправлять более одной заявки в час (Исключение: Просьба Администрации)\n\
			- Если вам отказали в смене ника, Значит нельзя.\n";
			
		ShowPlayerDialog(playerid, D_REG_RULES, DIALOG_STYLE_MSGBOX, ""colserver"Правила сервера", server_rulles, "Согласен", "Выйти"); 
	}
	printf("[UpTime ...] Данные из OnPlayerRequestSearch. Время: %d!", GetTickCount() - time);
	return 1;
}
ShowLoginAccountServer(playerid)
{
 	t_string[0] = EOS;
    format(t_string, sizeof t_string, ""colwhi"_______________________________________\n\n\
		Добро пожаловать на сервер "colserver"Warrior Role Play"colwhi"\n\
		Этот аккаунт зарегистрирован\n\n\
		Аккаунт: "colserver"%s"colwhi"\n\n\
		Введите пароль:\n\
		_______________________________________",
			pInfo[playerid][pName]
	);
	ShowPlayerDialog(playerid, D_LOGIN_PLAYER, DIALOG_STYLE_PASSWORD, ""colserver"{FFFFFF}Вход | "colserver"Авторизация", t_string, "Войти", "Отмена");
	return 1;
}  
publics: StatusBan(const playerid)
{
    new 
		query_[256]; 
	if (!cache_num_rows()) { 
		ShowLoginAccountServer(playerid);  
	}
    else {
	    new
			NameAdm[MAX_PLAYER_NAME],
			Reason[64],
			BanDate, UnBanDate;
	    cache_get_value_name(0, "Text", Reason, sizeof Reason);
	    cache_get_value_name(0, "NameAdmin", NameAdm, MAX_PLAYER_NAME);
		cache_get_value_name_int(0,"Date", BanDate);
		cache_get_value_name_int(0,"Unban", UnBanDate); 

		if (gettime() >= UnBanDate) { 
			mysql_format(dbHandle, query_, sizeof query_, "DELETE FROM `s_ban` WHERE `Name` = '%e'", pInfo[playerid][pName]);
            mysql_tquery(dbHandle, query_, "", ""); 
			printf(query_);
			ShowLoginAccountServer(playerid);  
		}
		else { 
			
			format(t_string, sizeof t_string, ""colwhi"Аккаунт: "colwarn"%s "colwhi"заблокирован!\n\n\
				Заблокировал: "colwarn"%s\n\
				"colwhi"Причина: "colwarn"%s\n\
				"colwhi"Дата блокировки: "colwarn"%s\n\
				"colwhi"Дата разблокировки: "colwarn"%s",
				pInfo[playerid][pName], NameAdm, Reason, 
				date("%dd.%mm.%yyyy", BanDate), 
				date("%dd.%mm.%yyyy", UnBanDate) 
			);
			ShowPlayerDialog(playerid, D_NULL, 0, ""colwarn"Аккаунт заблокирован!", t_string, !"Закрыть",""), t_string[0] = EOS;
			scmKick(playerid, !"Для выхода из игры используйте /q(uit)"); 
		}  
	} 
	return 1;
} 
publics: CheckEmailSmena(playerid, email[])
{
	new rows;
	cache_get_row_count(rows);
	if (rows) {
		SendClientMessage(playerid, COLOR_GREY, !"[Ошибка] Данный E-Mail уже используется!");
		ShowPlayerDialog(playerid, D_MAINMENU_FUNC_16, DIALOG_STYLE_INPUT, "Изменить E-Mail", "Введите ваш E-Mail:", "Ввести", "Отмена");
	}
	else
	{
		strmid(pInfo[playerid][pEmail], email, 0, strlen(email), 32);
    	new query_[128];
		mysql_format(dbHandle, query_, sizeof query_, "UPDATE `s_users` SET pEmail = '%e' WHERE pID = '%d'", pInfo[playerid][pEmail], pInfo[playerid][pID]);
		mysql_tquery(dbHandle, query_, "", "");
		SendClientMessage(playerid, COLOR_LI_RED, !"[Оповещение] "colwhi"Вы изменили свой E-Mail");
	}
	return 1;
}
publics: CheckReferal(playerid,refer[])
{
	new rows;
	cache_get_row_count(rows);
	if (rows)
	{
		strmid(pInfo[playerid][Referal], refer, 0, strlen(refer), MAX_PLAYER_NAME);
		ShowPlayerDialog(playerid,D_REG_SEX,DIALOG_STYLE_MSGBOX, ""colserver"Регистрация", ""colwhi"Выберите пол персонажа, за которого Вы будете отыгрывать роль!\n\n", "Мужчина", "Женщина");
	}
	else
	{
        SendClientMessage(playerid, COLOR_GREY, !"Аккаунт не найден в базе данных");
 		ShowPlayerDialog(playerid,D_REG_REFERAL,DIALOG_STYLE_INPUT, ""colserver"Реферал", "\
			"colwhi"Если на сервер Вас пригласил определенный человек, введите его ник.\n\
			Когда Вы достигните "#REFERAL_LEVEL_AWARD" игрового уровня, пригласивший Вас игрок получит игровую валюту в качестве вознаграждения!", 
			"Далее", "Пропуск"
		);
	}
	return 1;
} 

publics: LoadPlayer(const playerid)
{
    new rows, 
		query_[128]; 
	cache_get_row_count(rows);
	
    if (!rows) {//ORDER BY
		if (GetPVarInt(playerid, "wrongPass") == 2) {
			new 
				playersip[16];
			GetPlayerIp(playerid, playersip, sizeof playersip);
		    mysql_format(dbHandle,query_,sizeof query_, "UPDATE `s_users` SET `pIp` = '%e' WHERE Name = '%e' LIMIT 1", playersip, pInfo[playerid][pName]);
			mysql_tquery(dbHandle, query_, "", "");
			return scmKick(playerid, !"Неверный пароль. Используйте /q для выхода.");
		} 
		SetPVarInt(playerid, "wrongPass", GetPVarInt(playerid, "wrongPass")+1);
		format(query_, sizeof query_, "\
			\t{FFFFFF}У вас осталось (%d) %s\n\
			После Вы будете на время забанены", 
			3-GetPVarInt(playerid, "wrongPass"), 
			Declension_ReturnWord(3-GetPVarInt(playerid, "wrongPass"), "попытка", "попытки", "попыток")
		);
		ShowPlayerDialog(playerid, D_LOGIN_PLAYER, DIALOG_STYLE_MSGBOX, ""colserver"Ошибка: "colwhi"Неверный пароль!", query_, "Повтор", "Выйти");
		ShowNotification(playerid, 0xb00000DD, 0xFFFFFFDD, "Неверный пароль", 2000);
		PlayerPlaySound(playerid, 1150, 0.0, 0.0, 0.0); 
	}
	else {   
		new  
			player_ip[16],
			string_[256];
		GetPlayerIp(playerid, player_ip, sizeof player_ip); 
		if (pInfo[playerid][pConfirmVK] && strcmp(pInfo[playerid][LastIP], player_ip) != 0) {
			SetPVarInt(playerid, #ip_wrongpass, 2);
			new 
				number = random(999999) % 900000 + 100000;
			SetPVarInt(playerid, "VkGuardCodeAuth", number);
			format(bigstring, 144, 
				"%s, Your security code: %d IP: %s", pInfo[playerid][pName], number, player_ip
			);
			SendVk(pInfo[playerid][pVK_ID], bigstring); 
            bigstring[0] = EOS;

		    format(string_, sizeof string_, 
					""colwhi"Дорогой "collime"%s"colwhi"!\n\n\
					У Вас включена защита "col_VK"VK Guard"colwhi", мы уже отправили Вам код в "col_VK"сообщения\n\
					"colwhi"Введите шестизначный ключ в поле ниже и затем нажмите кнопку «Принять»\n\n", pInfo[playerid][pName]
				); 
			ShowPlayerDialog(playerid, D_VK_GUARD_INPUT, DIALOG_STYLE_INPUT, ""colserver"Авторизация: "col_VK"VK Guard", string_, "Принять", "Назад");
			return 1;
		} 
		else if (pInfo[playerid][pConfirmTG] && strcmp(pInfo[playerid][LastIP], player_ip, false)) {
			SetPVarInt(playerid, #ip_wrongpass, 2);
			new 
				number = random(999999) % 900000 + 100000;
			SetPVarInt(playerid, "TGGuardCodeAuth", number);
			format(query_, sizeof query_, 
				"%s, Ваш код для авторизации: %d IP: %s", pInfo[playerid][pName], number, player_ip
			);
			SendTelegramMessage(playerid, query_, pInfo[playerid][pTG_ID]); 

		    format(string_, sizeof string_, 
				""colwhi"Дорогой "collime"%s"colwhi"!\n\n\
				У Вас включена защита "col_TG"Telegram Guard"colwhi". мы уже отправили Вам код в "col_TG"сообщения\n\
				"colwhi"Введите шестизначный ключ в поле ниже и затем нажмите на кнопку «Принять»\n\n", pInfo[playerid][pName]
			); 
			ShowPlayerDialog(playerid, D_TG_GUARD_INPUT, DIALOG_STYLE_INPUT, ""colserver"Авторизация: "col_TG"Telegram Guard", string_, "Принять", "Назад");
			return 1;
		} 
		mysql_format(dbHandle, query_, sizeof query_, "SELECT * FROM `s_users` WHERE `Name` = '%e' LIMIT 1",pInfo[playerid][pName]);
		mysql_tquery(dbHandle, query_, "OnPlayerLoginAuth", "d", playerid); 
	}
	return 1;
}  
stock LoadRecon(playerid)
{
    ReconPlayer[playerid][0] = CreatePlayerTextDraw(playerid,530.000000, 180.000000, "x");
	PlayerTextDrawBackgroundColor(playerid, ReconPlayer[playerid][0], 0x000000AA);
