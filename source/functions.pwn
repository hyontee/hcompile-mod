stock EditBoomboxURL(playerid, const url[]) {
	if (!pTemp[playerid][tBoomboxArea]) return false;
	format(pTemp[playerid][tBoomboxURL], 128, url);

	foreach(new i: PlayerInLogin) {
		if (!pInfo[i][pLogin]) continue;
		if (!IsPlayerInDynamicArea(i, pTemp[playerid][tBoomboxArea] - 1)) 
			continue;
		PlayAudioStreamForPlayer(playerid, pTemp[playerid][tBoomboxURL], 
			pTemp[playerid][tBoomboxPos][0], pTemp[playerid][tBoomboxPos][1], 
			pTemp[playerid][tBoomboxPos][2], pTemp[playerid][tBoomboxRange], 1
		);
	}
	return true;
}
stock DestroyBoombox(playerid) {
	if (!pTemp[playerid][tBoomboxArea]) return false;
	new areaid = pTemp[playerid][tBoomboxArea] - 1;
	pTemp[playerid][tBoomboxArea] = 0;

	StopAudioStreamForPlayer(playerid);
	foreach(new i: PlayerInLogin) {
		if (!pInfo[i][pLogin]) continue;
		if (!IsPlayerInDynamicArea(i, areaid)) 
			continue;
		StopAudioStreamForPlayer(i);
	}
	if (IsValidDynamic3DTextLabel(pTemp[playerid][tBoomboxText])) {
		DestroyDynamic3DTextLabel(pTemp[playerid][tBoomboxText]);
		pTemp[playerid][tBoomboxText] = Text3D:0;
	}
	DestroyDynamicArea(areaid);
	DestroyDynamicObject(pTemp[playerid][tBoomboxObject]);
	return true;
}


stock GiveFractionRepute(fraction, point, bool: save = true) {
	
	FractionInfo[fraction][fRepute] += point;
	if (FractionInfo[fraction][fRepute] < 0) FractionInfo[fraction][fRepute] = 0;
	if (save) {
		SaveFractionInfoID(FractionInfo[fraction][fID]);
	}
	
}
stock GiveFractionPoints(fraction, point, bool: save = true) {
	FractionInfo[fraction][fPoints] += point;
	if (FractionInfo[fraction][fPoints] < 0) FractionInfo[fraction][fPoints] = 0;
	UpdateFractionStore(FractionInfo[fraction][fID]);
	if (save) {
		SaveFractionInfoID(FractionInfo[fraction][fID]);
	}
}  
stock GiveFractionPointsAdmin(fraction, point, bool: save = true) {
	FractionInfo[fraction][fPoints] = point;
	if (FractionInfo[fraction][fPoints] < 0) FractionInfo[fraction][fPoints] = 0;
	UpdateFractionStore(FractionInfo[fraction][fID]);
	if (save) {
		SaveFractionInfoID(FractionInfo[fraction][fID]);
	}
}  


stock AttachDynamic3DTextLabelToVeh(Text3D:labelid, vehicleid, Float:offsetx, Float:offsety, Float:offsetz)
{
	//В первый аргумент передали тип элемента - STREAMER_TYPE_3D_TEXT_LABEL
	//Во второй аргумент передали сам ID элемента - labelid
	//В третий аргумент тип данных, который хотим установить - E_STREAMER_ATTACHED_VEHICLE
	//В четвёртый аргумент сам ID машины - vehicleid
	Streamer_SetIntData(STREAMER_TYPE_3D_TEXT_LABEL, labelid, E_STREAMER_ATTACHED_VEHICLE, vehicleid);
	//В третий аргумент тип данных, который хотим установить - E_STREAMER_ATTACH_OFFSET_X
	//В четвёртый аргумент саму координату смещения аттача по x - offsetx
	Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, labelid, E_STREAMER_ATTACH_OFFSET_X, offsetx);
	//В третий аргумент тип данных, который хотим установить - E_STREAMER_ATTACH_OFFSET_Y
	//В четвёртый аргумент саму координату смещения аттача по y - offsety
	Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, labelid, E_STREAMER_ATTACH_OFFSET_Y, offsety);
	//В третий аргумент тип данных, который хотим установить - E_STREAMER_ATTACH_OFFSET_Z
	//В четвёртый аргумент саму координату смещения аттача по z - offsetz
	//По итогу: аттачим динамический 3D-текст к машине на заданные координаты и возвращаем результат выполнения функции
	return Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, labelid, E_STREAMER_ATTACH_OFFSET_Z, offsetz);
}

 
stock CheckPlayerPass(playerid)
{ 
	for(new i = 0; i < FRACTION_COUNT; i++)
	{ 
		if (pInfo[playerid][pFracIntKeys][i] == 322) { 
			pInfo[playerid][pFracIntKeys][i] = 0;
		}  
	}
	return 1;
}
 
publics: ItogWeekGangStats() { 
	new rows = cache_num_rows();
	new id,
		WinsMats[] = {100000, 50000, 25000},
		WinsMoney[] = {100000, 50000, 25000};
	if (rows) {
		for(new i, string[128]; i < rows; i ++) {
			cache_get_value_name_int(i, "fID", id);
			if (i == 0 || i == 1 || i == 2) {
				format(string,sizeof(string), "%s занимает "collime"%d место"colserver" в Gang-Top за текущую неделю", gFraction[id][fName], i + 1);
				SendGangMessage(COLOR_SERVER, string);

				FractionInfo[id][fMaterials] += WinsMats[i]; 
				FractionInfo[id][fMoney] += WinsMoney[i]; 
			}  
		}
	} 
	FractionInfo[FRACTION_BALLAS][fRepute] = 0;
	FractionInfo[FRACTION_VAGOS][fRepute] = 0;
	FractionInfo[FRACTION_GROVE][fRepute] = 0;
	FractionInfo[FRACTION_AZTEC][fRepute] = 0;
	FractionInfo[FRACTION_RIFA][fRepute] = 0; 
	UpdateFractionStore(FRACTION_BALLAS);
	UpdateFractionStore(FRACTION_VAGOS);
	UpdateFractionStore(FRACTION_RIFA);
	UpdateFractionStore(FRACTION_GROVE);
	UpdateFractionStore(FRACTION_AZTEC); 
}
  
stock CheckPlayerTaxiOff(playerid)
{
	if (GetPlayerTaxi{playerid} == 1)
	{
		for(new i; i < 3; i++)
		{
			if (pTemp[playerid][pTaxiCalled][i] != INVALID_PLAYER_ID)
			{
				new id_player = pTemp[playerid][pTaxiCalled][i];
				if (pTemp[id_player][pTaxiDriver]  == playerid || pTemp[playerid][pTaxiCalled][i] == playerid )
				{
					if (IsPlayerConnected(id_player))
					{
						SendClientMessage(id_player, 0xdc143cFF, !"[Диспетчер] Добрый день, таксист который к Вам направлялся попал в аварию!");
						SendClientMessage(id_player, 0xdc143cFF, !"[Диспетчер] Сделайте новый вызов!");
					}
					pTemp[id_player][pTaxiDriver] = INVALID_PLAYER_ID;
					pTemp[playerid][pTaxiCalled][i] = INVALID_PLAYER_ID;
					break;
				}
			}
		}
	}
	return 1;
}

stock CheckPlayerCalledTaxi(playerid)
{
	if (pTemp[playerid][pTaxiDriver] != INVALID_PLAYER_ID)
	{
		new id_player = pTemp[playerid][pTaxiDriver];
		for(new i; i < 3; i++)
		{
			if (pTemp[id_player][pTaxiCalled][i] == playerid)
			{
				CheckTaxiPlayer(playerid,id_player);
				break;
			}
		}
	}
	return 1;
}


stock CheckTaxiPlayer(playerid,id)
{
	if (IsPlayerConnected( id ))
	{
		for(new i; i < 3; i++)
		{
			if (pTemp[id][pTaxiCalled][i] == playerid)
			{
				pTemp[id][pTaxiCalled][i] = INVALID_PLAYER_ID;
				if (CP[id] == 777) {
					CP[id] = 0;
					DisablePlayerCheckpoint(playerid);
				}
				break;
			}
		}
		new str_tmp[64];
		format(str_tmp, sizeof str_tmp, "[Диспечер] %s отказался от вызова такси",pInfo[playerid][pName]);
		SendClientMessage(id, CGRAY2, str_tmp);
		SendClientMessage(id, CGRAY2, !"[Диспечер] Если у Вас уже есть активный вызов, то введите \"/to [id клиента]\"");
	}
	return 1;
}


stock GetPlayerUseCar(const playerid,const  vehicleid, bool: helper = false)
{
	///if (VehicleInfo[ vehicleid- 1 ][vLocked] == true) return 0;
	/*enum 
	{
		VEHICLE_STATE_ERROR,// Авто для просмотра передпокупкой
		VEHICLE_STATE_TRAILER, // трейлер
		VEHICLE_STATE_TRAIN, // поезд
		VEHICLE_STATE_LOW_BIKE, // велики
		VEHICLE_STATE_BOAT, // яхты
		VEHICLE_STATE_PLANE, // самалеты / вертолёты
		VEHICLE_STATE_BIKE, // мотоциклы мопед
		VEHICLE_STATE_CAR // авто
	}
	GetVehicleState(vehicleid)
	
	*/

	if ( (GetVehicleState(vehicleid) == VEHICLE_STATE_BOAT && pInfo[playerid][pLicense][2] == 0 || GetVehicleState(vehicleid) == VEHICLE_STATE_PLANE && pInfo[playerid][pLicense][1] == 0 
		|| GetVehicleState(vehicleid) >= VEHICLE_STATE_BIKE && pInfo[playerid][pLicense][0] == 0) && pTemp[playerid][TakingLesson] == false )
	{
		SendClientMessage(playerid, COLOR_WHITE, !"У Вас нет лицензии на управлением этим транспортом! (( /gps - Автошкола ))");
		return 0;
	}

	if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_FRACTION)
	{	
		if (pInfo[playerid][pAdmin] == 0) {
			if (VehicleInfo[ vehicleid - 1 ][vSubFraction] == 0)
			{
				if (VehicleInfo[ vehicleid - 1 ][vFraction] != pInfo[playerid][pMember])
				{
					if (
						(VehicleInfo[ vehicleid - 1 ][vFraction] == FRACTION_ARMY_SF  || 
						VehicleInfo[ vehicleid - 1 ][vFraction] == FRACTION_ARMY_LV) && pTemp[playerid][PlayerInArmyForm] == true
						){
						return 1;
					}
					else if 
						(VehicleInfo[ vehicleid - 1 ][vFraction] == FRACTION_AUTOSCHOOL && pInfo[playerid][pLicense][0] == 0 && pTemp[playerid][TakingLesson]) 
						{
						return 1;
					}
						SendClientMessage(playerid, COLOR_GREY, !"Этот транспорт недоступен для Вас");
					return 0;
				}
			}
			else if (VehicleInfo[ vehicleid - 1 ][vSubFraction] == 0)
			{
				if (pInfo[playerid][pMember] == FRACTION_ARMY_SF ||
				pInfo[playerid][pMember] == FRACTION_ARMY_LV  ||
				pTemp[playerid][PlayerInArmyForm] == true)
				{
					return 1;
				}
				SendClientMessage(playerid, COLOR_GREY, !"Этот транспорт недоступен для Вас");
				return 0;
			}
		}	
	}
	else if (VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB)
	{
		if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_BUS && pInfo[playerid][pJob] != PLAYER_JOB_BUS) {
			SendClientMessage(playerid, COLOR_WHITE, !"Данный автомобиль доступен сотрудникам работы {B4B5B7}\"Водитель автобуса\"");
			return 0;
		}
		else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_TAXI && pInfo[playerid][pJob] != PLAYER_JOB_TAXI) {
			SendClientMessage(playerid, COLOR_WHITE, !"Данный автомобиль доступен сотрудникам работы {CECECE}\"Таксист\"");
			return 0;
		}
		else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_DELIVERY && pInfo[playerid][pJob] != PLAYER_JOB_DELIVERY) {
			SendClientMessage(playerid, COLOR_WHITE, !"Данный автомобиль доступен сотрудникам работы {B4B5B7}\"Развозчик продуктов\"");
			return 0;
		}
		else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_HOTDOG_SALLER && pInfo[playerid][pJob] != PLAYER_JOB_HOTDOG_SALLER) {
			SendClientMessage(playerid, COLOR_WHITE, !"Данный автомобиль доступен сотрудникам работы {B4B5B7}\"Продавец Хот-Догов\"");
			return 0;
		}
		else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_MECHANIC && pInfo[playerid][pJob] != PLAYER_JOB_MECHANIC) {
			SendClientMessage(playerid, COLOR_WHITE, !"Данный автомобиль доступен сотрудникам работы {B4B5B7}\"Механик\"");
			return 0;
		}
		else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_TRUCKER && pInfo[playerid][pJob] != PLAYER_JOB_TRUCKER)
		{
			SendClientMessage(playerid, COLOR_WHITE, !"Данный автомобиль доступен сотрудникам работы {B4B5B7}\"Дальнобойщик\"");
			return 0;
		}
		else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_COLLECTOR && pInfo[playerid][pJob] != PLAYER_JOB_COLLECTOR)
		{
			if (pInfo[playerid][pJob] == PLAYER_JOB_COLLECTOR && pTemp[playerid][pRentCar] != vehicleid)
			{
				SendClientMessage(playerid, COLOR_WHITE, !"Данный автомобиль доступен сотрудникам работы {B4B5B7}\"Инкассатор\"");
				return 0;
			}
			else 
			{
				if (pTemp[playerid][pRentCar] == vehicleid) {
					if (VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobAmount] == 0 && helper) {
						SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Используйте команду \"/atmlist\" для поиска банкомата с наличкой");
					}
					if (VehicleInfo[ pTemp[playerid][pRentCar] - 1 ][vJobLoad]) {
						ShowPlayerDialog(playerid, D_ATM_FUNC_5, DIALOG_STYLE_MSGBOX, ""colserver"Работа: "colwhi"Инкассатора", ""colwhi"Вы действительно желаете завершить загрузку?", "Да", "Нет");
					}
				}
				
			} 
		}

		else if (VehicleInfo[ vehicleid - 1 ][vFraction] == PLAYER_JOB_HUNTER && !pTemp[playerid][tJobHunter]) {
			SendClientMessage(playerid, COLOR_WHITE, !"Данный автомобиль доступен работникам {B4B5B7}\"Мясника Сэма\"");
			return 0;
		}		
		
	}
	else if (
		VehicleInfo[ vehicleid - 1 ][vType] == VEHICLE_TYPE_JOB_FARM && 
		(VehicleInfo[ vehicleid - 1 ][vFraction] != pTemp[playerid][TempFermID] || pTemp[playerid][JobInFarmRank] < 2))
	{ 
		new 
			str_[100]; 
		format(str_, sizeof str_, "Данный автомобиль доступен сотрудникам {B4B5B7}\"Фермы %d\"", VehicleInfo[ vehicleid - 1 ][vFraction] - 1);
		SendClientMessage(playerid, COLOR_WHITE, str_);
		return 0;
	}
	else if (VehicleInfo[ vehicleid - 1][vType] == VEHICLE_TYPE_DYNAMIC && VehicleInfo[ vehicleid - 1][vFraction] == DYNAMIC_VEH_ROB_HOUSE) {
		if (VehicleInfo[ vehicleid - 1][vSubFraction] != playerid) {
			new 
				str_[100]; 
			format(str_, sizeof str_, "Данный автомобиль доступен {B4B5B7}\"%s\"", pInfo[ VehicleInfo[ vehicleid - 1][vSubFraction] ][pName]);
			SendClientMessage(playerid, COLOR_WHITE, str_);
			return 0;
		}
		else {
			if (VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobAmount] == 0 && helper) {
				SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Отправляйтесь к любому купленному дому и вынесите из него всё!");
			}
			if (VehicleInfo[ pTemp[playerid][tRobVeh] - 1 ][vJobLoad]) {
				ShowPlayerDialog(playerid, D_ROB_HOUSE_1, DIALOG_STYLE_MSGBOX, ""colserver"Ограбление: "colwhi"Завершение", ""colwhi"Вы действительно желаете завершить ограбление?", "Да", "Нет");
			}
			
		}

	}
	else if (VehicleInfo[ vehicleid - 1][vType] == VEHICLE_TYPE_FAMILY)
	{
		if (VehicleInfo[ vehicleid - 1 ][vFraction] != pInfo[playerid][pFamily])
		{
			new 
				string_[100];
			format(string_, sizeof string_, "Данный автомобиль доступен семье {%s}\"%s\"",
				family_chat_color[ FamilyInfo[ VehicleInfo[ vehicleid - 1 ][vFraction] - 1 ][fChatColor] ],
				FamilyInfo[ VehicleInfo[ vehicleid - 1 ][vFraction] - 1 ][fName]
			);
			SendClientMessage(playerid, COLOR_WHITE, string_);
			return 0;
		}
		else if (pInfo[playerid][pFamilyRank] < VehicleInfo[ vehicleid - 1 ][vRank] && VehicleInfo[ vehicleid - 1 ][vRank] > 0)
		{
			new 
				string_[100];
			format(string_, sizeof string_, "Данный автомобиль доступен с ранга {%s}\"%s\"",
				family_chat_color[ FamilyInfo[ VehicleInfo[ vehicleid - 1 ][vFraction] - 1 ][fChatColor] ],
				fFamilyRank[ VehicleInfo[ vehicleid - 1 ][vFraction] - 1 ][ VehicleInfo[ vehicleid - 1 ][vRank] - 1 ]
			);
			SendClientMessage(playerid, COLOR_WHITE, string_);
			return 0;
		}
	}
	//if (VehicleInfo[ V_IDX - 1][vType] == VEHICLE_TYPE_DYNAMIC && VehicleInfo[ V_IDX - 1][vFraction] == DYNAMIC_VEH_MATS)
	else 
	{
		 //
	}
	return 1;
}

stock OnPlayerWarning(const playerid,const result[],type = 0)
{ 
	if (pTemp[playerid][AntiFloodWarning] < gettime())
	{
		new string_[144];
		format(string_, sizeof string_, "<Warning> %s[%d]: %s", pInfo[playerid][pName], playerid, result);
		ABroadCast(COLOR_REDD, string_, 2);
		if (type == 1) AddCheater(playerid);
		pTemp[playerid][AntiFloodWarning] = gettime()+3;
	}
	return 1;
}


stock HaveWeapon(playerid, weaponid) {
	new weapon,
        ammo;
    GetPlayerWeaponData(playerid, GetWeaponSlot[weaponid], weapon, ammo);
		if ((weapon== weaponid) && ammo) return 1;
        
	return 0;
} 


stock ClearKillFeed(playerid = INVALID_PLAYER_ID)
{// by Londlem & Daniel_Cortez \\ pro-pawn.ru
    if ((playerid != INVALID_PLAYER_ID) && (0 == IsPlayerConnected(playerid)))
        return 0;
    goto L_start;
    // avoid possible stack overflow (due to using push.* opcodes)
    {
        new dummy[16/(cellbits/charbits)];
        #emit const.pri dummy
    }
#if __Pawn < 0x030A
    // optional sysreq.c bugfix
    SendDeathMessage(0, 0, 0),
    SendDeathMessageToPlayer(0, 0, 0, 0);
#endif
L_start:
    const CKF_MAGIC_ID = INVALID_PLAYER_ID - 1;
    // this variable is also used as weaponid parameter
    new i = 5;
    // push killer and killee IDs
    #emit    push.c    CKF_MAGIC_ID
    #emit    push.c    CKF_MAGIC_ID
    if (playerid == INVALID_PLAYER_ID)
    {
        #emit    push.c    12
        do{
            #emit    sysreq.c    SendDeathMessage
        }while(--i != 0);
        #emit    stack    12
    }
    else
    {
        #emit    push.s    playerid
        #emit    push.c    16
        do{
            #emit    sysreq.c    SendDeathMessageToPlayer
        }while(--i != 0);
        #emit    stack    16
    }
    return 1;
} 

stock GiveFreeRoulette(playerid)
{
	new
		string_[100];
	pInfo[playerid][pSpins]++;
	format(string_, sizeof string_, "Вы получили бесплатную прокрутку. У Вас %d прокрут(ов)", pInfo[playerid][pSpins]);
	SendClientMessage(playerid, COLOR_GREEN, string_);
}
