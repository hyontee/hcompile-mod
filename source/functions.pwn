stock kLibGivePlayerEuro(playerid, money) {
	pInfo[playerid][pEuro] += money;
	SavePlayerInteger(playerid, "pEuro", pInfo[playerid][pEuro]);
	return 1;
} 

stock kLibGetPlayerEuro(playerid) return pInfo[playerid][pEuro]; 

stock kLibGivePlayerMoney(playerid, money, const reason[] = ".", targetid = INVALID_PLAYER_ID, bool:save = true) {
	//if (pInfo[playerid][pAdmin] + money < 0) return SendClientMessage(playerid, COLOR_GREY, !"Произошла ошибка ( GivePlayerMoney < 0 )");
	pInfo[playerid][pCash] += money;
	if (pInfo[playerid][pCash] - money > pInfo[playerid][pCash]/* + money*/) {
		LogsUnGiveMoney(playerid, targetid, money, reason, Log_Money);
	} else {
		LogsGiveMoney(playerid, targetid, money, reason, Log_Money);
	} 
	
	ResetPlayerMoney(playerid);
	GivePlayerMoneyEx(playerid);
	if (save) {
		SavePlayerInteger(playerid, "pCash", pInfo[playerid][pCash]);
	}  
	if (targetid == INVALID_PLAYER_ID) {

	}
	//LogTransferAll(playerid, targetid, money, reason, Log_Money);
	//LogMoney(playerid, money, reason); 
	return 1;
} 

stock kLibGetPlayerMoney(playerid) return pInfo[playerid][pCash]; 
stock setFreezePlayerForTime(playerid, time)
{
	TogglePlayerControllable(playerid, 0);
	SetTimerEx("UnFreeze", time * 1000, false, "i", playerid);
}
publics: UnFreeze(playerid) return TogglePlayerControllable(playerid, 1);

stock IsVehicleOccupied(vehicleid)
{

	#if defined FOREACH_I_PlayerInVehicle

	foreach(PlayerInVehicle[vehicleid], i){
		if (IsPlayerInVehicle(i, vehicleid)) return i;
	}

	#else

	foreach(new i: PlayerInLogin) if (IsPlayerInVehicle(i, vehicleid)) return i;

	#endif

	return -1;
}
stock get_passenger_count(playerid)
{
	new passenger_count = 0,
		vehicleid = GetPlayerVehicleID ( playerid ) ; 
	foreach(new i: PlayerInLogin)
	{
		if (!pInfo[i][pLogin]) continue;
		if (GetPlayerState(i) == PLAYER_STATE_PASSENGER && GetPlayerVehicleID(i) == vehicleid) passenger_count ++ ;
	}
	return passenger_count ;
}
 
stock CreateDynamicTrigger(Float:x,Float:y,Float:z, worldid = 0, interiorid = 0, t_type = 0)//1 - red //2 - green
{
	new Trigger = CreateDynamicObject(1317,x ,y , z-1.78 ,0.0,0.0,0.0,worldid,interiorid);
	if (t_type == 1) SetDynamicObjectMaterial(Trigger, 0, 18646, "matcolours", "red-3", 0x00000000);
	else if (t_type == 2) SetDynamicObjectMaterial(Trigger, 0, 18646, "matcolours", "green", 0x00000000);
	else if (t_type == 3) SetDynamicObjectMaterial(Trigger, 0, 18646, "matcolours", "samporange", 0x00000000);
	else SetDynamicObjectMaterial(Trigger,0, 18646, "matcolours", "blue", 0xAA80FFDD);
	return Trigger;
} 
