	printf("[Clear Info ...] Данные из SetPlayerDataToDefault. Время: %d!", GetTickCount() - time); 
}
//Конец new

stock ProxDetector(playerid, Float:max_range, color, const string[], Float:max_ratio = 1.6)
{
    new
        Float:pos_x,
        Float:pos_y,
        Float:pos_z,
        Float:range,
        Float:range_ratio,
        Float:range_with_ratio,
        clr_r, clr_g, clr_b,
        Float:color_r, Float:color_g, Float:color_b;

    if (!GetPlayerPos(playerid, pos_x, pos_y, pos_z)) {
        return 0;
    }

    color_r = float(color >> 24 & 0xFF);
    color_g = float(color >> 16 & 0xFF);
    color_b = float(color >> 8 & 0xFF);
    range_with_ratio = max_range * max_ratio; 
    foreach(new i: PlayerInLogin)
    {
        if (!IsPlayerStreamedIn(playerid, i)) continue; 
        range = GetPlayerDistanceFromPoint(i, pos_x, pos_y, pos_z);
        if (range > max_range) continue;

        range_ratio = (range_with_ratio - range) / range_with_ratio;
        clr_r = floatround(range_ratio * color_r);
        clr_g = floatround(range_ratio * color_g);
        clr_b = floatround(range_ratio * color_b);

        SendClientMessage(i, (color & 0xFF) | (clr_b << 8) | (clr_g << 16) | (clr_r << 24), string);
    } 
    SendClientMessage(playerid, color, string);
    return 1;
} 

Convert(number)
{
	new hours = 0, mins = 0, secs = 0, str[100];
	hours = floatround(number / 3600);
	mins = floatround((number / 60) - (hours * 60));
	secs = floatround(number - ((hours * 3600) + (mins * 60)));
	if (hours > 0) format(str, 100, "%d:%02d:%02d", hours, mins, secs);
	else format(str, 100, "%d:%02d", mins, secs);
	return str;
}  
stock GetPlayerID(const str[])
{
	foreach(new i: PlayerInLogin)
	{
		if (!pInfo[i][pLogin]) continue;
		if (strcmp(pInfo[i][pName], str, true, strlen(str)) == 0) return i;
	}
	return INVALID_PLAYER_ID;
}
stock GetCheckID(const name[])
{
    new ID = INVALID_PLAYER_ID;
	sscanf(name, "u", ID);
	if (IsPlayerConnected(ID)) return ID;
	return INVALID_PLAYER_ID;
}
TickRateUpdate3DTextServer()
{
    if (lsamatbi > 1000000) lsamatbi = 1000000;
    if (FractionInfo[1][fMaterials] > 1000000) FractionInfo[1][fMaterials] = 1000000; 
    if (FractionInfo[2][fMaterials] > 1000000) FractionInfo[2][fMaterials] = 1000000;
    if (FractionInfo[3][fMaterials] > 1000000) FractionInfo[3][fMaterials] = 1000000;
    if (FractionInfo[10][fMaterials] > 1000000) FractionInfo[10][fMaterials] = 1000000;
    if (FractionInfo[21][fMaterials] > 1000000) FractionInfo[21][fMaterials] = 1000000;
   // if (FractionInfo[3][fMaterials] > 100000) FractionInfo[3][fMaterials] = 100000;
    if (FractionInfo[19][fMaterials] > 1000000) FractionInfo[19][fMaterials] = 1000000;

    if (lsamatbi < 0) lsamatbi = 0;
    if (FractionInfo[1][fMaterials] < 0) FractionInfo[1][fMaterials] = 0;
	if (FractionInfo[2][fMaterials] < 0) FractionInfo[2][fMaterials] = 0;
    if (FractionInfo[3][fMaterials] < 0) FractionInfo[3][fMaterials] = 0;
    if (FractionInfo[10][fMaterials] < 0) FractionInfo[10][fMaterials] = 0;
    if (FractionInfo[21][fMaterials] < 0) FractionInfo[21][fMaterials] = 0;
    if (FractionInfo[19][fMaterials] < 0) FractionInfo[19][fMaterials] = 0;
	UpdateFractionStore(FRACTION_LSPD);
	UpdateFractionStore(FRACTION_SFPD);
	UpdateFractionStore(FRACTION_LVPD);
	UpdateFractionStore(FRACTION_FBI);
	
	new str[256];  
    format(str, sizeof(str), "Склад армии ЛВ: {FFFFFF}%d", FractionInfo[19][fMaterials]);
    UpdateDynamic3DTextLabelText(LvaLable[0], 0x33AA33FF, str);

    format(str, sizeof(str), "LV ARMY: {FFFFFF}%d/300000\n{33AA33}SF ARMY: {FFFFFF}%d/100000\n{33AA33}LSPD: {FFFFFF}%d/100000\n{33AA33}SFPD: {FFFFFF}%d/100000\n{33AA33}LVPD: {FFFFFF}%d/100000\n{33AA33}FBI: {FFFFFF}%d/100000",
		FractionInfo[19][fMaterials],FractionInfo[3][fMaterials],FractionInfo[1][fMaterials],FractionInfo[10][fMaterials],FractionInfo[21][fMaterials],FractionInfo[2][fMaterials]
	);
    UpdateDynamic3DTextLabelText(LvaLable[1], 0x33AA33FF, str);
	return 1;
}
stock Expirence(playerid)
{
	new
		exp = pInfo[playerid][pDExp],
		nxtlevel = pInfo[playerid][pDLevel] + 1,
		expamount = nxtlevel*levelDexp;
	if (exp >= expamount)
	{
		pInfo[playerid][pDLevel] += 1;
		pInfo[playerid][pDMgruz] += 1;
		pInfo[playerid][pDExp] = 0;
	} 
	return 1;
}
stock ToDevelopSkills(Slashes,Points)
{
	new SlashesAndPoints[200];
	new Slash[2] = "|";
	new Point[2] = "'";
	for(new i = 0; i < Slashes; i++) strcat(SlashesAndPoints, Slash);
	for(new i = 0; i < Points; i++) strcat(SlashesAndPoints, Point);
	return SlashesAndPoints;
}
stock SetPlayerSkills(playerid)
{
	SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL_SILENCED, pInfo[playerid][pGunSkill][0]*10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_DESERT_EAGLE, pInfo[playerid][pGunSkill][1]*10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_SHOTGUN, pInfo[playerid][pGunSkill][2]*10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_MP5, pInfo[playerid][pGunSkill][3]*10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_AK47, pInfo[playerid][pGunSkill][4]*10);
	SetPlayerSkillLevel(playerid, WEAPONSKILL_M4, pInfo[playerid][pGunSkill][5]*10);
	return 1;
} 

stock SendAdvertToServer(playerid,newsid,advertid,type,text[])
{
	if (!IsANews(playerid) || newsid < 0 || newsid > 2) return 1;

	if (AdvertInfo[advertid][newsid][adPhone] == 0)
		return AdvertList(playerid);

	static AdvertTimeNews;
	new news_name[3][8] = {
		"LS News",
		"SF News",
		"LV News"
	};

	if (AdvertTimeNews > gettime())
	{
		if (type == 1)
		{
			if (AdvertInfo[advertid][newsid][adPhone] != 0) {
				format(AdvertInfo[advertid][newsid][adText],78,"%s",text);
				AdvertInfo[advertid][newsid][adEdit] = 1;
				SendClientMessage(playerid, COLOR_LIGHTGREEN, !"Объявление отредактировано и сохранено");
			}
			else SendClientMessage(playerid, CGRAY2, !"Объявление уже отправлено");
		}
		SendClientMessage(playerid, COLOR_GREY, !"Посылать объявление можно раз в 15 секунд!");
		return AdvertList(playerid);
	}
	AdvertTimeNews = gettime() + 15; 
	new
		string_[228];
	if (!AdvertInfo[advertid][newsid][adVIP]) {
		format(string_, sizeof string_, "Объявление: %s. Прислал: %s. Тел: %d",text, AdvertInfo[advertid][newsid][adName],AdvertInfo[advertid][newsid][adPhone]);
		SendAdvertMessage(TEAM_GROVE_COLOR, string_);
		format(string_, sizeof string_, "\t\t\tОтредактировал сотрудник %s: %s",news_name[newsid], pInfo[playerid][pName]); 
		SendAdvertMessage(TEAM_GROVE_COLOR, string_);
	}
	else {
		format(string_, sizeof string_,  "VIP Объявление: %s. Прислал: %s. Тел: %d",text, AdvertInfo[advertid][newsid][adName],AdvertInfo[advertid][newsid][adPhone]);
		SendAdvertMessage(COLOR_GOLD, string_);
		format(string_, sizeof string_,   "\t\t\tОтредактировал сотрудник %s: %s",news_name[newsid], pInfo[playerid][pName]);
		SendAdvertMessage(COLOR_GOLD, string_);
	}
	AdvertInfo[advertid][newsid][adPhone] = 0;
	AdvertInfo[advertid][newsid][adEdit] = 0; 
	kLibGivePlayerMoney(playerid, AdvertInfo[advertid][newsid][adPrice], "AD NEWS /edit");
	AdvertInfo[advertid][newsid][adPrice] = 0; 
	AdvertInfo[advertid][newsid][adVIP] = 0; 
	AdvertList(playerid);

	pInfo[playerid][edited_ads] ++; 

	format(string_, sizeof string_, "UPDATE `s_users` SET `edited_ads` = '%d' WHERE `pID` = '%d' LIMIT 1", pInfo[playerid][edited_ads], pInfo[playerid][pID]);
	mysql_tquery(dbHandle, string_);

	OnPlayerAchievProgress(playerid, 7);
	OnPlayerAchievProgress(playerid, 8);
	return 1;
}


stock AddToServerAdvertise(playerid,newsid)
{
	if (newsid < 0 || newsid > 2) return 1;
	new frac_id[3] = {16,9,20}; // id фракций news
	if (gFraction[ frac_id[newsid] ][fCoolDown] > gettime())
	{
		DeletePVar(playerid,"advert");
		SendClientMessage(playerid, COLOR_GREY, !"Посылать объявление можно раз в 15 секунд!");
		return AdvertList(playerid);
	}
	new
		text[78];
	GetPVarString(playerid,"advert", text, 78);
	DeletePVar(playerid,"advert");
	new price = GetPVarInt(playerid, "ad_price");
	if (kLibGetPlayerMoney(playerid) < price) return SendClientMessage(playerid, COLOR_WHITE, !"У Вас недостаточно денег");
	new pos_ad;
	for(new i; i < MAX_ADVERT_LIST ;i++)
	{
		if (AdvertInfo[i][newsid][adPhone] != 0) continue;
		AdvertInfo[i][newsid][adVIP] = pInfo[playerid][VIPRank];
		AdvertInfo[i][newsid][adPhone] = pInfo[playerid][PlayerNumber];
		format(AdvertInfo[i][newsid][adName],24,"%s",pInfo[playerid][pName]);
		format(AdvertInfo[i][newsid][adText],78,"%s",text);
		AdvertInfo[i][newsid][adPrice] = floatround(price/100*40);
		pos_ad = 1;
		break;
	}
	

	if (pos_ad == 0) return SendClientMessage(playerid, COLOR_GREY, !"Список объявлений заполнен. Попробуйте подать объявление позже.");

	kLibGivePlayerMoney(playerid, -price, "подача объявления");
	FractionInfo[ frac_id[newsid] ][fMoney] += floatround(price/100*50);
	SaveFractionInfoID(FractionInfo[ frac_id[newsid] ][fID], false);
	
	format(text, 16, "~r~-$%d", price);
	GameTextForPlayer(playerid, text, 5000, 1);
	DeletePVar(playerid, "ad_price");
	SendFamilyMessage(frac_id[newsid], COLOR_WHITE, !"[F] В редакцию поступило новое объявление!");
	SendClientMessage(playerid, COLOR_WHITE, !"Ваше обьявление будет подано после проверки");
	pInfo[playerid][tAdvertTimer] = gettime() + 60;

	gFraction[ frac_id[newsid] ][fCoolDown] = gettime()+15;
	return 1;
}


stock AdvertList(playerid)
{
	if (!IsANews(playerid)) return 1;
	new list_temp,
		pos_ad,
		full_str[940],
		temp_str[66];

	switch(pInfo[playerid][pMember])
	{
		case 16: list_temp = 0;
		case 9: list_temp = 1;
		case 20: list_temp = 2;
	}

	strcat(full_str, !""colserver"[№] Прислал\t"colserver"Номер телефона\n"); 

	for(new i; i < MAX_ADVERT_LIST ;i++)
	{
		if (AdvertInfo[i][list_temp][adPhone] == 0) continue;
		format(temp_str, sizeof (temp_str), 
			""colwhi"[%d] %s\t%d  %s", pos_ad + 1, AdvertInfo[i][list_temp][adName],
			AdvertInfo[i][list_temp][adPhone],
			AdvertInfo[i][list_temp][adEdit] == 1 ? (""c_green"Проверено\n"):("\n") 
		);
		strcat(full_str, temp_str);
		playerListItem[playerid][pos_ad] = i;
		pos_ad++;
	}
//floatround(price/100*40);
	format(temp_str, sizeof (temp_str), ""colserver"Объявления: "colwhi"%s", fInfo[pInfo[playerid][pMember]][fName]);
	if (pos_ad == 0) return ShowPlayerDialog(playerid, D_NULL, 0, temp_str, "\t"colwhi"Новых объявлений нет", "Назад", "");
	ShowPlayerDialog(playerid, D_NEWS_PANEL_0, DIALOG_STYLE_TABLIST_HEADERS, temp_str, full_str, "Принять", "Отмена");
	return 1;
}

stock ShowSettings(playerid)
{
	new string[148],
		gSettingName[SETTINGS_COUNT][22] = {
		"OOC оповещение",//0
		"Фракционный чат",//1
		"Отображение ников",//2
        "Hunger Бар",//3
        "Кейс с деньгами",//4
		"Damage Informer",//5
		"Семейный чат", //6
		"Чат начальных работ", // 7
		"Новостная волна", // 8
		"Объявления", // 9
		"Государственная волна", // 10
		"Чат VIP игроков", // 11
		"Тип Спидометра"		
	};
	/*if (pInfo[playerid][PlayerSpawn] > 4 || pInfo[playerid][PlayerSpawn] < 0){
		pInfo[playerid][PlayerSpawn] = 0;
		SavePlayerInteger(playerid, "playerspawn",0);
	}*/

	t_string[0] = EOS;
	strcat(t_string, ""colserver"[№] Настройка\t"colserver"Статус\n");
	for(new i; i < SETTINGS_COUNT; i++)
	{
		//new
		//	flag[32] = ""colwarn"Выключить"colwhi"";
		//if (pInfo[playerid][PlayerSettings] & (1 << i)) flag = ""collime"Включить"colwhi"";
		if (i != 12) {
			format(string, sizeof string, "[%d] %s\t%s\n", i, gSettingName[i], pInfo[playerid][PlayerSettings] & (1 << i) ?("{009933}Включено"): ("{ff3333}Выключено"));
		} else {
			format(string, sizeof string, "[%d] %s\t%s\n", i, gSettingName[i], pInfo[playerid][PlayerSettings] & (1 << i) ?("{009933}New"): ("{009933}Mobile"));
		}

		strcat(t_string, string);
	}
	strcat(t_string, "[13] Описание персонажа\n");	
	strcat(t_string, "[14] Сменить пароль\t[******]\n[15] Очистить чат\t[40 линий]\n");
	format(string, sizeof string,
		"[16] Место возрождения\t%s\n\
		[17] Смена NonRp ника\t[%s]\n[19] Смена пола\t{ffff66}%s",
		GetPlayerSpawnName(playerid),
		pInfo[playerid][pName], !pInfo[playerid][pSex] ? ("Ошибка/баг") : (pInfo[playerid][pSex] == 1 ? ("Мужской") : ("Женский")));
	strcat(t_string, string);
	strcat(t_string, "\n[20] "coldeport"Безопасность\t[Аккаунта]\n");
	return ShowPlayerDialog(playerid, D_MAINMENU_FUNC_7, DIALOG_STYLE_TABLIST_HEADERS, ""colserver"Настройки: "colwhi"Персональные", t_string, "Выбрать", "Отмена");
}


publics: Recognition()
{
	new 
		Float:x, 
		Float:y, 
		Float:z;
   	foreach(new i: PlayerInLogin)
 	{
        if (!pInfo[i][pWantedLevel] || !pInfo[i][pLogin]) continue;
        recognition[i] = 0;
        GetPlayerPos(i, x, y, z);//Посмотреть
        foreach(new p: PlayerInLogin)
        {
       		if (IsPlayerInRangeOfPoint(p, 150, x, y, z) && IsACop(p) && p != i) recognition[i]++;
		}
		if (!recognition[i])
		{
	 		scm(i,-1,!"Ваша узнаваемость понизилась");
	 		pInfo[i][pWantedLevel]--;
	 		SetPlayerWantedLevelEx(i, pInfo[i][pWantedLevel]);
	 		if (!pInfo[i][pWantedLevel])
			{
			    if (LabelOn[i] == 1)
			    {
			    	LabelOn[i] = 0;
					if (IsValidDynamic3DTextLabel(LabelRecognition[i])) {
						DestroyDynamic3DTextLabel(LabelRecognition[i]);
						LabelRecognition[i] = Text3D:0;
					}	
				}
			 	pInfo[i][pRecognition] = 0;
			}
	 		else
	 		{
	 		    if (pInfo[i][pRecognition] > 0) pInfo[i][pRecognition]--;
			}
		}
		else
		{
		    scm(i,-1,!"Ваша узнаваемость повысилась");
		    if (pInfo[i][pRecognition] < 3) pInfo[i][pRecognition]++;
		}
	}
}
stock ConvertSeconds(time)
{
	new str[128];
	if (time < 3600) format(str, sizeof(str), "%d", time);
	return str;
}
//DisableEnableReconButton(playerid, button, enable, show = 1)
stock DisableEnableReconButton(playerid, button, bool: enable, bool: show = true)
{
    PlayerTextDrawHide(playerid, ReconPlayer[playerid][button]);
	if (!enable) PlayerTextDrawBoxColor(playerid,ReconPlayer[playerid][button], 0x00000055);
	else PlayerTextDrawBoxColor(playerid,ReconPlayer[playerid][button], 0xD97700AA);
	if (show) PlayerTextDrawShow(playerid, ReconPlayer[playerid][button]);
	return 1;
}

stock SubTextDelete(playerid)
{
	for(new i = 16; i < 34; i++) {
		PlayerTextDrawHide(playerid, ReconPlayer[playerid][i]);
		DisableEnableReconButton(playerid, i, false, false);
	} 
    ReconSelectSub[playerid] = INVALID_TEXT_DRAW; 
    DisableEnableReconButton(playerid, ReconSelect[playerid], true);
	return 1;
}
publics: GetMoney() {
	foreach(new i: PlayerInLogin) {
		if (!pInfo[i][pLogin] || AntiCheatIsKickedWithDesync(i)) continue;
 		if (pInfo[i][pCash] != GetPlayerMoney(i) && pInfo[i][pLogin]) ResetPlayerMoney(i), GivePlayerMoneyEx(i);
	}
	return ;
}

stock CreateReconButtonn(playerid, Float:Xpos, Float:Ypos, const button_text[], txtInit)
{
	ReconPlayer[playerid][txtInit] = CreatePlayerTextDraw(playerid,Xpos, Ypos, button_text);
	PlayerTextDrawBackgroundColor(playerid,ReconPlayer[playerid][txtInit], 0x000000AA);
	PlayerTextDrawFont(playerid,ReconPlayer[playerid][txtInit], 1);
	PlayerTextDrawLetterSize(playerid,ReconPlayer[playerid][txtInit], 0.200, 1.100);
	PlayerTextDrawColor(playerid,ReconPlayer[playerid][txtInit], 0xAAAAAAAA);
	PlayerTextDrawSetOutline(playerid,ReconPlayer[playerid][txtInit], 0);
	PlayerTextDrawAlignment(playerid,ReconPlayer[playerid][txtInit], 2);
	PlayerTextDrawSetProportional(playerid,ReconPlayer[playerid][txtInit], 1);
	PlayerTextDrawSetShadow(playerid,ReconPlayer[playerid][txtInit], 0);
	PlayerTextDrawUseBox(playerid,ReconPlayer[playerid][txtInit], 1);
	PlayerTextDrawBoxColor(playerid,ReconPlayer[playerid][txtInit], 0x00000055);
	PlayerTextDrawTextSize(playerid,ReconPlayer[playerid][txtInit], 11.000, 60.000);
	PlayerTextDrawSetSelectable(playerid, ReconPlayer[playerid][txtInit], 1);
	return 1;
} 
