    return 1;
}

stock SendVKMessage(playerid, const message[], const vk_id[]) {
	format(bigstring, sizeof bigstring, "http://creative-rp.ru/api?secret=vk1.a.sJICI80gkJeWbVpaR2ubnUZiLFMUUNmcP9f5s5Z7t02SsFRqWVgb-sGFJD7ZP2-KGLmlCqnKiqzMvHhDV-hnEeXZshCyNJM6flm7XYWAUkcKJHHZs-JyTnZRYQQL3fCkseqiLDbBKyRm4axL7TDsK-RlFXbWeOYnFgPuUnoi3m67sFXR7R2XO8hn-dSwVmxM&method=vk&user=%s&mess=%s", vk_id, message); 
//
    new 
        index;

    for(new i = 0; bigstring[i] != '\0'; i++)
    {
        switch(bigstring[i])
        {
            case ' ': bigstring[index++] = '+';
            default: bigstring[index++] = bigstring[i];
        }
    }

    HTTP(playerid, HTTP_GET, bigstring, "", "SendMessageResponse"); 

    printf("%s", bigstring);

    bigstring[0] = EOS;

    return 1;
} 
stock SendTelegramMessage(playerid, const message[], const tg_id[]) { 
	new	
		inc_string[512];
	format(inc_string, sizeof inc_string, "http://h-rp.su/api?secret=d9d4adfc4d99842ed5d0b92d4b08387a&method=telegram&user=%s&mess=%s", tg_id, message); 
    for(new i, str = strlen(inc_string); i < str; i++) {
        if(inc_string[i] == ' ') inc_string[i] = '+';
    }

    HTTP(playerid, HTTP_GET, inc_string, "", ""); 
    return 1;
} 
stock SendMailMessage(playerid, const message[], const email[]) {
	new	
		inc_string[512];
	format(inc_string, sizeof inc_string, 
		"http://h-rp.su/api?secret=d9d4adfc4d99842ed5d0b92d4b08387a&method=mail&user=%s&type=confirm&code=%s", 
		email, message
	);  
    for(new i, str = strlen(inc_string); i < str; i++) {
        if(inc_string[i] == ' ') inc_string[i] = '+';
    }

    HTTP(playerid, HTTP_GET, inc_string, "", "SendMessageResponse"); 
	return 1;
}
publics: SendMessageResponse(index, response_code, data[])
{
	switch(response_code) {
		case 200: {
			return print("[Guard] Сообщение отправлено!"); 
		}
		case 500: {
			return print("[Guard] Ошибка сервера веб-части!"); 
		}
		default: {
			printf("[Guard] Сбой в запросе, код ответа: %d", response_code); 
		}
	} 
    return 1;
}


stock InsertCreateVehicleAC(model, Float:x,Float:y,Float:z,Float:r, c, c_, fraction, type)
{
	new
		query_[256],
		number_car[12];

	format(number_car, 12, "%dARMY%d", RandomEx(10), RandomFIX(100, 999));
	mysql_format(dbHandle, query_, sizeof query_,
		"INSERT INTO `s_vehicle_server` (`vType`,`vModel`,`vPos`,`vColor`,`vNumber`,`vFraction`,`vSubFraction`) VALUES ('%d','%d','%f|%f|%f|%f','%d,%d','%s','%d','0')",
		type, model, x, y, z, r, c, c_, number_car, fraction
	);
	printf(query_);
	mysql_tquery(dbHandle, query_, "", "");
    return 1;
}


stock IsPlayerToHunterZone(playerid) {
	return IsPlayerToSquare(playerid, .min_x = -811.8267, .min_y = -2544.8973, .max_x = -360.8267, .max_y = -2103.8973);
}

stock DestroyHunter(i) {
	//SendClientMessageToAll(COLOR_RED, !"Destroy Deer");
    DestroyDynamicObject(gDeerHunterInfo[i][deerObject]);
    DestroyDynamic3DTextLabel(gDeerHunterInfo[i][deerText]);
    gDeerHunterInfo[i][deerSpawned] = false;
    gDeerHunterInfo[i][deerKilled] = false;
	gDeerHunterInfo[i][deerUsePlayer] = false;
    gDeerHunterInfo[i][deerCoolDown] = 0;
}

stock LeavePlayerFactoryJob(playerid, bool: text = false) {
	if (pTemp[playerid][tJobFactory])
	{ 
		pTemp[playerid][tJobFactory] = false;  
		new salary = pTemp[playerid][tSalaryJob][0]*SALARY_FACTORY_JOB,
			salary_ = pTemp[playerid][tSalaryJob][1]*SALARY_FACTORY_BOX_JOB;
			
		salary = GetVipBoostMaxPlayerValue(playerid, vPercentSalary, bPercentSalary, salary); 
		salary_ = GetVipBoostMaxPlayerValue(playerid, vPercentSalary, bPercentSalary, salary_); 
		SetMoveCashServer(IN_JOB, (salary+salary_));
		if (text) {
			new 
				string_[128];
			format(string_, sizeof string_, "Вы собрали упаковок: "colserver"%d"colwhi" и заработали "collime"$%d", 
				pTemp[playerid][tSalaryJob][0], salary
			);
			SendClientMessage(playerid, COLOR_WHITE, string_); 
			format(string_, sizeof string_, "Вы отсортировали упаковок: "colserver"%d"colwhi" и заработали "collime"$%d", 
				pTemp[playerid][tSalaryJob][1], salary_
			);
			SendClientMessage(playerid, COLOR_WHITE, string_); 
			SendClientMessage(playerid, COLOR_GREEN, !"Рабочий день окончен, заработанные деньги вы получили на руки"); 
			MeAction(playerid, "уволился(ась) с работы", SELECT_ACTION_IN_BUBBLE);
		} 
		kLibGivePlayerMoney(playerid, (salary+salary_), "зп factory");
		pTemp[playerid][tSalaryJob][0] =
		pTemp[playerid][tSalaryJob][1] = 0;
		SetPlayerSkinEx(playerid, pInfo[playerid][pChar][0]); 
		if (IsPlayerAttachedObjectSlotUsed(playerid, ATTACHED_SLOT_JOB_1)) RemovePlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1);
		
		if (pTemp[playerid][tJobTimer] != -1) {
			KillTimer(pTemp[playerid][tJobTimer]);
		}
	}
	for(new i = 0; i < S_FACTORY_TABLE_COUNT; i++) {
		if (gFactoryInfo[i][tableToggle] == playerid) {
			gFactoryInfo[i][tableToggle] = INVALID_PLAYER_ID;
			if (IsValidDynamicObject(gFactoryInfo[i][tableObject])) {
				DestroyDynamicObject(gFactoryInfo[i][tableObject]);
			}
			if (IsValidDynamicObject(gFactoryInfo[i][tableObjectStatus])) {
				DestroyDynamicObject(gFactoryInfo[i][tableObjectStatus]);
				gFactoryInfo[i][tableObjectStatus] = CreateDynamicTrigger(gFactoryInfo[i][tablePos][0], gFactoryInfo[i][tablePos][1], gFactoryInfo[i][tablePos][2], 
					.worldid = 1, .interiorid = FACTORY_INT, .t_type = 2
				);
			} 
			
		} 
    }
	if (pTemp[playerid][tUseFactorySordID] != -1) {
		gFactorySortInfo[ pTemp[playerid][tUseFactorySordID] ][sortPlaceToggle] = INVALID_PLAYER_ID;
	} 
}
stock LeaveJobPlayer(playerid, bool:text = false) {
	if (pTemp[playerid][tJobHunter])
	{
		new 
			salary = pTemp[playerid][tSalaryJob][0] * SALARY_HUNTER_JOB,
			salary_ = pTemp[playerid][tSalaryJob][1] * SALARY_HUNTER_MEET_JOB;
		if (text) {
			new 
				string_[128];
			format(string_, sizeof string_, "Вы убили оленей: "colserver"%d"colwhi" и заработали "collime"$%d", 
				pTemp[playerid][tSalaryJob][0], salary
			);
			SendClientMessage(playerid, COLOR_WHITE, string_); 
			format(string_, sizeof string_, "Вы обработали мяса: "colserver"%d"colwhi" и заработали "collime"$%d", 
				pTemp[playerid][tSalaryJob][1], salary_
			);
			SendClientMessage(playerid, COLOR_WHITE, string_); 
			SendClientMessage(playerid, COLOR_GREEN, !"Рабочий день окончен, заработанные деньги вы получили на руки"); 
		}
		pTemp[playerid][tJobHunter] = false; 
		
		kLibGivePlayerMoney(playerid, (salary_+ salary), "spawn salary tJobHunter");
		SetMoveCashServer(IN_JOB, (salary_+ salary)); 
		pTemp[playerid][tSalaryJob][0] =
		pTemp[playerid][tSalaryJob][1] = 0;
		pTemp[playerid][tUseDeerKnifeID] = -1;
		ResetPlayerWeapons(playerid);
		
	}
}
publics: MainJobsTimers(playerid, index)
{ 
	//ClearAnimations(playerid);
	gFactoryInfo[index][tableToggle] = INVALID_PLAYER_ID; 
	DestroyDynamicObject(gFactoryInfo[index][tableObject]);
	DestroyDynamicObject(gFactoryInfo[index][tableObjectStatus]);
	gFactoryInfo[index][tableObjectStatus] = CreateDynamicTrigger(gFactoryInfo[index][tablePos][0], gFactoryInfo[index][tablePos][1], gFactoryInfo[index][tablePos][2], 
		.worldid = 1, .interiorid = FACTORY_INT, .t_type = 2
	);
	if(!IsPlayerInDynamicArea(playerid, gFactoryInfo[index][tableAreaID])) { 
		SendClientMessage(playerid, COLOR_GREY, !"Вы отвлекались от работы, и у Вас вышел бракованный ящик");
		return 1;
	}  
	Streamer_Update(playerid);
	SetPlayerAttachedObject(playerid, ATTACHED_SLOT_JOB_1, 3052, 6, 0.0, 0.10, -0.2, -110.0, 0.0, 78.0);
	SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Вы собрали ящик. Отнесите его на конвейерную ленту");
	pTemp[playerid][tFactoryUseBox] = true;
	pTemp[playerid][tJobTimer] = -1; 
	//SetPlayerSpecialAction (playerid, SPECIAL_ACTION_CARRY);
	ClearAnimations(playerid);
	ApplyAnimation(playerid, !"CARRY", !"crry_prtial", 4.0, 0, 1, 1, 1, 1, 1);
	//ApplyAnimation(playerid,"CARRY","crry_prtial", 4.1, 0, 1, 1, 1, 1); 
	//SetTimerEx("CarryDelay", 500, false, "i", playerid);  
	return 1;
}


LoadingTrucker() {
	new _str[356];
