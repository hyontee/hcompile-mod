IsValidEmailEx(const email_[]) {
	new	
		Regex: rEmail = Regex_New("[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?"),
		check = Regex_Check(email_, rEmail);
	Regex_Delete(rEmail);
	return check;
	/*static regex:rEmail;
	if ( !rEmail ) rEmail = regex_new("[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?");
	return regex_match_exid(email_, rEmail);*/
} 
IsValidURLVKEx(const url_[]) {
	new	
		Regex: rEmail = Regex_New("^[a-z0-9_.]{5,32}"),
		check = Regex_Check(url_, rEmail);
	Regex_Delete(rEmail);
	return check;
	/*static regex:url_;
	if ( !url_ ) url_ = regex_new("^[a-z0-9_.]{5,32}");
	return regex_match_exid(url_, url_);*/
} //((?:(?:25[0-5]|2[0-4]\d|((1\d{2})|([1-9]?\d)))\.){3}(?:25[0-5]|2[0-4]\d|((1\d{2})|([1-9]?\d)))) >> regular IP



stock ExpExp(playerid, countEXP)
{
	if (pInfo[playerid][JobDriverProdInfo][0] != 12) 
	{
		pInfo[playerid][JobDriverProdInfo][1] += countEXP;
		
		if (pInfo[playerid][JobDriverProdInfo][1] >= 100)
		{
			pInfo[playerid][JobDriverProdInfo][0]++;
			pInfo[playerid][JobDriverProdInfo][1] = 0;
			pInfo[playerid][JobDriverProdInfo][2] += 200;

			SendClientMessage(playerid, 0x00D26DFF, !"Поздравляем! Ваш навык развозчика улучшился.");
		}

		new query_[128];
		
		format(query_, sizeof(query_), "UPDATE s_users SET SkillProd = '%d,%d,%d' WHERE Name = '%s'",
			pInfo[playerid][JobDriverProdInfo][0], pInfo[playerid][JobDriverProdInfo][1], 
			pInfo[playerid][JobDriverProdInfo][2], pInfo[playerid][pName]);
			
		mysql_tquery(dbHandle, query_, "", "");
	}
}

stock GetPlayerZone(playerid, value)
{
	new zone[32],bool:getzone;
	new Float:x1,Float:y1,Float:z1;
	GetPlayerPos(playerid,x1,y1,z1);
	for(new i = 0; i < sizeof(gZoneInfo); i++)
	{
		switch(value)
		{
			case 0:
			{
				if (x1 >= gZoneInfo[i][SAZONE_AREA][0] && x1 <= gZoneInfo[i][SAZONE_AREA][3]
						&& y1 >= gZoneInfo[i][SAZONE_AREA][1] && y1 <= gZoneInfo[i][SAZONE_AREA][4])
				{
					settext(zone, gZoneInfo[i][SAZONE_NAME]);
					getzone = true;
					break;
				}
			}
			case 1: { 
				if (FamilyHouse[playerid][fhEnter][0] >= gZoneInfo[i][SAZONE_AREA][0] && FamilyHouse[playerid][fhEnter][0] <= gZoneInfo[i][SAZONE_AREA][3]
						&& FamilyHouse[playerid][fhEnter][1] >= gZoneInfo[i][SAZONE_AREA][1] && FamilyHouse[playerid][fhEnter][1] <= gZoneInfo[i][SAZONE_AREA][4])
				{
					settext(zone, gZoneInfo[i][SAZONE_NAME]);
					getzone = true;
					break;
				}
			}
		}
	}
	if (!getzone) zone = "Неизвестно";
	return zone;
} 
stock settext(str_[], const text[])
{
	strmid(str_, text, 0, strlen(text), 255);
	return 1;
}
