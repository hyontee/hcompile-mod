}

publics: LoadBilbords()
{
	new rows;
	cache_get_row_count(rows);
	new time = GetTickCount();
    if (!rows)
        return print("[Загрузка ...] Данные из s_bilboards не получены!");
    for(new b_idx; b_idx < rows; b_idx++)
    {
        cache_get_value_name_int(b_idx , "id", BildInfo[b_idx][bID]);
        cache_get_value_name(b_idx, "bText", BildInfo[b_idx][bText], 144);
        cache_get_value_name(b_idx, "bPosText", BildInfo[b_idx][bPosText], 32);
        cache_get_value_name(b_idx, "bOwner", BildInfo[b_idx][bOwner], MAX_PLAYER_NAME);

        cache_get_value_name_int(b_idx, "bOwned", BildInfo[b_idx][bOwned]);
        cache_get_value_name_int(b_idx, "bBackColor", BildInfo[b_idx][bBackColor]);
        cache_get_value_name_int(b_idx, "bFontFace",  BildInfo[b_idx][bFontFace]);
        cache_get_value_name_int(b_idx, "bAligment", BildInfo[b_idx][bAligment]);
        cache_get_value_name_int(b_idx, "bFontSize", BildInfo[b_idx][bFontSize]);
        //cache_get_value_name(b_idx - 1, "pos", data_, 128), sscanf(data_,"p<|>a<f>[3]", FarmInfo[x][fMenu]);
        cache_get_value_name_float(b_idx, "PosX", BildInfo[b_idx][bPos][0]);
        cache_get_value_name_float(b_idx, "PosY",  BildInfo[b_idx][bPos][1]);
        cache_get_value_name_float(b_idx, "PosZ", BildInfo[b_idx][bPos][2]);
        cache_get_value_name_float(b_idx, "PosA", BildInfo[b_idx][bPos][3]);
        cache_get_value_name_int(b_idx, "bMember", BildInfo[b_idx][bMember]);
        cache_get_value_name_int(b_idx, "bDay", BildInfo[b_idx][bDay]);
        cache_get_value_name_int(b_idx, "bModel", BildInfo[b_idx][bObjectModel]);
		BildInfo[b_idx][bObjectID] = CreateDynamicObjectEx(BildInfo[b_idx][bObjectModel],BildInfo[b_idx][bPos][0], BildInfo[b_idx][bPos][1], BildInfo[b_idx][bPos][2], 0.00000000, 0.00000000, BildInfo[b_idx][bPos][3],1000.000,1000.000); // bObject
        UpdateBuildText(b_idx);
		TOTALBILBOARD ++;
    }

	new curent_time = gettime(), bilbord_reset,query_[190];
	for(new i; i < TOTALBILBOARD; i++)
	{
		if (BildInfo[i][bOwned] != 1) continue;
		if (curent_time > BildInfo[i][bDay])
		{
			BildInfo[i][bFontSize] = 0;
		    BildInfo[i][bBackColor] = 0;
			BildInfo[i][bFontFace] = 0;
			BildInfo[i][bOwned] = 0;
			BildInfo[i][bDay] = 0;
			format(BildInfo[i][bOwner],2,"-");
			UpdateBuildText(i);

			format(query_, sizeof(query_), "UPDATE `s_billboards` SET `bDay` = '0',\
			`bOwned` = '0', `bOwner` = '-', `bText` = '-', `bFontSize` = 25, `bAligment` = 1, \
			`bBackColor` = '1', `bFontFace` = '0' WHERE `id` = '%i' LIMIT 1",i);
			mysql_tquery(dbHandle, query_);

			bilbord_reset++;
		}
	}

    printf("[Загрузка ...] Данные из BilBoards получены! (%d шт.) Обнулено: %d шт Время: %d",TOTALBILBOARD,bilbord_reset, GetTickCount() - time);
	return 1;
}
        
stock GetVehicleID()
{
	new veh_id = _AddStaticVehicleEx( 400, -100, -100, -100, 0, 0, 0, 0);
	_DestroyVehicle(veh_id);
	return veh_id;
}


stock IsAGreenZone(playerid)
{
    for(new i; i < sizeof(gAreas[arGreenZone]); i++) {
		if (IsPlayerInDynamicArea(playerid, gAreas[arGreenZone][i])) return 1;
	}
	return 0;
}

stock IsANoLimiter(carid)
{
	if (IsABoat(carid) || IsAPlane(carid) || IsARCVehicle(carid) || GetVehicleModel(carid) == 462 || GetVehicleModel(carid) == 481 || GetVehicleModel(carid) == 509 || GetVehicleModel(carid) == 510) return 1;
	return 0;
} 
   
stock GetPlayerFarm(playerid)
{
    new farm = 0;
	for(new i = 1; i <= TOTALFARM; i++)
	{
	    if (strcmp(FarmInfo[i][fOwner],"None",true) == 0) continue;
	    if (strcmp(FarmInfo[i][fOwner],pInfo[playerid][pName],false) == 0)
		{
	 		farm  = i;
	 		pTemp[playerid][PlayerFarmID] = i; 
	 	}
	} 
	return farm;
}

stock GetHome()
{
	for(new idx = 1; idx <= TOTALHOUSE; idx++)
	{
        if (strcmp("None", HouseInfo[idx][hOwner],true) == 0 || HouseInfo[idx][hKlass] == 5) continue;
		if (HouseInfo[idx][hTakings] < GetHouseOplata(idx))
		{
		    new
				playerid,
				query_[154];
			
			sscanf(HouseInfo[idx][hOwner], "u", playerid);
			if (IsPlayerConnected(playerid))
			{
			    pInfo[playerid][pBank] += HouseInfo[idx][hValue] / 2;
			    SavePlayerInteger(playerid, "pBank", pInfo[playerid][pBank]);
				LogMoney(playerid, HouseInfo[idx][hValue] / 2, "дом был продан");
			    pTemp[playerid][GetHomePlayer] = true;
				if (pInfo[playerid][PlayerSpawn] == 1) {
				    if (pInfo[playerid][pMember] != 0) pInfo[playerid][PlayerSpawn] = 2;
				    else pInfo[playerid][PlayerSpawn] = 0;
				    SavePlayerInteger(playerid, "playerspawn", pInfo[playerid][PlayerSpawn]);
				}
			}
			else//`answers` = `answers`+1
			{
				mysql_format(dbHandle, query_, sizeof query_, "SELECT `pID`,`pBank` FROM `s_users` WHERE `Name` = '%e' LIMIT 1", HouseInfo[idx][hOwner]);
    			mysql_tquery(dbHandle, query_, "OnPlayerSelectTextType", "iis", sqlTextSellHouse, idx, HouseInfo[idx][hOwner]);  
			}
			if (HouseInfo[idx][hValue] == 0) {
				HouseInfo[idx][hValue] = HouseInfo[idx][hReturnValue];
			}
			strmid(HouseInfo[idx][hOwner],"None", 0, strlen("None"), MAX_PLAYER_NAME);
			HouseInfo[idx][hTakings] = 0;
			HouseInfo[idx][hLock] = 1;
			//for(new h = 0; h < 10; h++) HouseInfo[i][hSafe][h] = 0;
			UpdateHouseInfo(idx, false);
			CheckEvictFree(idx);
			CheckFamilyHouseFree(idx);
		}
		else {
			HouseInfo[idx][hTakings] -= GetHouseOplata(idx);
			SetMoveCashServer(IN_NALOG_SERVER, GetHouseOplata(idx)); 
		}
		SaveHouseID(idx);
		HouseInfo[idx][hRobHouse] = false;
	}
	return 1;
}

publics: OnPlayerSelectTextType(type, index, owner[])
{
	new 
        rows;
	cache_get_row_count(rows);
	switch(type) {
		case sqlTextSellHouse: {
			if (!rows) {
				printf("OnPlayerSelectTextType: sqlTextSellHouse -> INVALID_PLAYER_ID (%s)", owner);
				return 1;
			}
			new bank_amount, 
				targetid,
				string_[144];
			cache_get_value_name_int(0, "pID", targetid);
			cache_get_value_name_int(0, "pBank", bank_amount); 
			format(string_, sizeof string_, ""colinfo"[Уведомления] "colwhi"Ваш дом был продан государству, Ваши деньги на банковском счету");
			MessagePlayerOffline(targetid, string_);

			bank_amount += HouseInfo[index][hValue] / 2;
			format(string_, sizeof string_, "UPDATE `s_users` SET `pBank` = '%d', `playerspawn` = '0', `pHouseID` = '-1' WHERE `pID` = '%d'", bank_amount, targetid);
			mysql_tquery(dbHandle, string_);
			printf("OnPlayerSelectTextType: sqlTextSellHouse -> (%s)", owner);
		} 
		case sqlTextBuyFerm: {
			if (!rows) {
				printf("OnPlayerSelectTextType: sqlTextBuyFerm -> INVALID_PLAYER_ID (%s) (Index: %d)", owner, index);
				return 1; 
			}
			new targetid,
				string_[144];
			cache_get_value_name_int(0, "pID", targetid); 
			format(string_, sizeof string_, ""colinfo"[Уведомления] "colwhi"Вы приобрели Ферму с аукциона!");
			MessagePlayerOffline(targetid, string_);
			printf("OnPlayerSelectTextType: sqlTextBuyFerm -> (%s)  (Index: %d)", owner, index);
		}
		case sqlTextSellFerm: {
			if (!rows) {
				printf("OnPlayerSelectTextType: sqlTextSellFerm -> INVALID_PLAYER_ID (%s) (Index: %d)", owner, index);
				return 1; 
			}
			new bank_amount, 
				targetid,
				string_[144];
			cache_get_value_name_int(0, "pID", targetid);
			cache_get_value_name_int(0, "pBank", bank_amount); 
			format(string_, sizeof string_, ""colinfo"[Уведомления] "colwhi"Ваша ферма была продана государству, Половина стоимости зачислена на Ваш счет");
			MessagePlayerOffline(targetid, string_);

			bank_amount += FarmInfo[index][fBank]+FarmInfo[index][fLandTax];
			format(string_, sizeof string_, "UPDATE `s_users` SET `pBank` = '%d' WHERE `pID` = '%d'", bank_amount, targetid);
			mysql_tquery(dbHandle, string_);
			printf("OnPlayerSelectTextType: sqlTextSellFerm -> (%s)", owner);
		}
	}
	return 1;
}

stock GetFarm()
{
	for(new i = 1; i <= TOTALFARM; i++)
	{
	    new query_[128];
	    if (FarmInfo[i][fAuction][0] > 0 && strcmp(FarmInfo[i][fOwner],"None",true) == 0 && FarmInfo[i][fAuction][2] > 0)
		{
			FarmInfo[i][fAuction][2]--;
			SaveActionsFerm(i);
		}
	    if (FarmInfo[i][fAuction][2] == 0 && FarmInfo[i][fAuction][0] > 0)
	    {
	       	format(query_, sizeof query_,"SELECT `Name` FROM `s_users` WHERE `Name` = '%s'",FarmInfo[i][fAuctionName]);
			mysql_tquery(dbHandle, query_, "OnMySQL_QUERY", "iis", 29, i, "");
		}
        if (strcmp("None",FarmInfo[i][fOwner],true) == 0) continue;
		if (FarmInfo[i][fLandTax] < 500)
		{
		    new playerid;
			sscanf(FarmInfo[i][fOwner], "u", playerid);
			if (IsPlayerConnected(playerid))
			{
				pTemp[playerid][GetFarmPlayer] = false;
				pInfo[playerid][pBank] += FarmInfo[i][fBank]+FarmInfo[i][fLandTax];
				SavePlayerInteger(playerid, "pBank", pInfo[playerid][pBank]);
				LogMoney(playerid, FarmInfo[i][fBank]+FarmInfo[i][fLandTax], "ферма была продана");
			}
			else { 
				mysql_format(dbHandle, query_, sizeof query_, "SELECT `pID`,`pBank` FROM `s_users` WHERE `Name` = '%e' LIMIT 1", FarmInfo[i][fOwner]);
				mysql_tquery(dbHandle, query_, "OnPlayerSelectTextType", "iis", sqlTextSellFerm, i, FarmInfo[i][fOwner]);  
			}
			strmid(FarmInfo[i][fOwner],"None",0,strlen("None"),MAX_PLAYER_NAME);
			strmid(FarmInfo[i][fDeputy_1],"None",0,strlen("None"),MAX_PLAYER_NAME);
			strmid(FarmInfo[i][fDeputy_2],"None",0,strlen("None"),MAX_PLAYER_NAME);
			strmid(FarmInfo[i][fDeputy_3],"None",0,strlen("None"),MAX_PLAYER_NAME);
			SaveFermIDFarmers(i);
			FarmInfo[i][fAuction][0] = 0;
			FarmInfo[i][fAuction][1] = 0;
			FarmInfo[i][fAuction][2] = 0;
			FarmInfo[i][fAuction][3] = 0;
			FarmInfo[i][fLandTax] = 0;
			FarmInfo[i][fBank] = 0;
			FarmInfo[i][fProds] = 0;
			FarmInfo[i][fZp] = 30;
			FarmInfo[i][fGrain_Price] = 5;
			FarmInfo[i][fGrain] = 0;
			FarmInfo[i][fGrain_Sown] = 0;
			FarmInfo[i][fProds_Selling] = 1;
			FarmInfo[i][fProds_Price] = 21;
		}
		else {
			FarmInfo[i][fLandTax] -= 500;
		}
		SaveFermID(i);
	}
	return 1;
}
stock GetFarmjob(playerid, idx)
{
    if (strcmp(pInfo[playerid][pName],FarmInfo[idx][fDeputy_1],true) == 0 || strcmp(pInfo[playerid][pName],FarmInfo[idx][fDeputy_2],true) == 0 || strcmp(pInfo[playerid][pName],FarmInfo[idx][fDeputy_3],true) == 0) return 2;
    if (strcmp(pInfo[playerid][pName],FarmInfo[idx][fFarmer_1],true) == 0 || strcmp(pInfo[playerid][pName],FarmInfo[idx][fFarmer_2],true) == 0 || strcmp(pInfo[playerid][pName],FarmInfo[idx][fFarmer_3],true) == 0
    || strcmp(pInfo[playerid][pName],FarmInfo[idx][fFarmer_4],true) == 0 || strcmp(pInfo[playerid][pName],FarmInfo[idx][fFarmer_5],true) == 0) return 1;
    return 0;
}



stock ShowHelpDialog(playerid, dialog)
{
	t_string[0] = EOS;
	if (dialog+2 != 19) SetPVarInt(playerid, "help_dialog", dialog + 2);
 	else SetPVarInt(playerid, "help_dialog", 2);
	switch(dialog)
 	{
  		case 0:
        {
              ShowPlayerDialog(playerid,D_PLAYER_HELP,2,"Помощь","[1] Общение\n[2] Список игроков\n[3] Транспорт\n[4] Транспорт часть 2\n[5] Общее\n[6] Оружие и Убийство\n[7] Role Play\n[8] Первые шаги\n[9] Первые шаги часть 2\n[10] Первые шаги часть 3\n[11] Часовая зарплата\n[12] Зарплата фракции\n[13] Бизнес\n[14] Местность\n[15] Законопослушность\n[16] Дома\n[17] Дом часть 2","Далее","Выход");
              return SetPVarInt(playerid,"help_dialog", 1);
       	}
        case 1:
        {
        	strcat(t_string,"<< Общение >>\n\n");
         	strcat(t_string,"Вы можете обращаться с другими игроками через чат в левом верхнем углу.\n");
          	strcat(t_string,"Чтобы напечатать сообщение нажмите клавишу \"F6\" или \"T\"(на латинеце)\n");
           	strcat(t_string,"Так же с помощью чата используются все команды сервера, к примеру \"/mm\".\n\n\n");
            strcat(t_string,"Используйте \"/mm\" для просмотра команд...\n");
            //strcat(t_string,"Более подробное описание вы найдете на нашем сайте warrior-rp.ru");
            return ShowPlayerDialog(playerid, D_PLAYER_HELP, 0,"Общение",t_string,"Далее","Меню");
        }
        case 2:
        {
       		strcat(t_string,"<< Список игроков >>\n\n");
            strcat(t_string,"Данный список можно посмотреть нажав клавишу \"TAB\".\n");
            strcat(t_string,"Там вы увидете:\n\n");
            strcat(t_string,"\"ID\" игрока(используется в командах)\n");
            strcat(t_string,"\"Ник(РП имя игрока)\"\n");
            strcat(t_string,"\"Уровень(lvl)\" в графе score(Повышается автоматически каждый отыгранный час)\n");
            strcat(t_string,"\"Пинг\" это не слишком важно, поэтому я не буду нагружать вас лишней информацией.\n\n");
            strcat(t_string,"Для просмотра списка полностью, используйте прокрутку с право.\n");
            strcat(t_string,"Вы в этой табличке всегда отображаетесь первым, независимо от ID.");
            return ShowPlayerDialog(playerid, D_PLAYER_HELP, 0,"Список игроков",t_string,"Далее","Меню");
		}
  		case 3:
    	{
     		strcat(t_string,"<< Транспорт >>\n\n");
       		strcat(t_string,"Я надеюсь вы умеете ездить, но даже если нет, наши Инструкторы вас научат.\n");
         	strcat(t_string,"В Автошколу вам придется идти в любом случае, поскольку езда разрешена только\n");
          	strcat(t_string,"с правами. Ну а пока вы можете воспользоваться мотороллером,\n");
           	strcat(t_string,"Или же общественным транспортом\n\n");
