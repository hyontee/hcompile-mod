	|| pInfo[playerid][pMember] == 25 || pInfo[playerid][pMember] == 26) return 1;
	if (pInfo[playerid][pLevel] > 3) */
	if (pInfo[playerid][pLevel] < 3) return 1;
	if (pInfo[playerid][pMember] == 0 && pInfo[playerid][pJob] == 0) return 1;
	if (pInfo[playerid][pMember] == 0 && pInfo[playerid][pKrisha] > 0) return 1;
	return 0;
} 

