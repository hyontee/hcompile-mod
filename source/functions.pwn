publics: ClearAnim(playerid){ 
	if (GetPVarInt(playerid, !"ClearAnimSI") > gettime()) return 1;
	return ApplyAnimation(playerid, "CARRY", "crry_prtial",4.0,0,0,0,0,0,1);
} 
publics: CarryDelay(playerid) ApplyAnimation(playerid,"CARRY","crry_prtial",4.0,1,1,1,1,1,1);


stock bool: UseCar(vehicleid) {
	foreach(new i: PlayerInVehicle[vehicleid]) {
		if (GetPlayerVehicleSeat(i) != -1) return true; 
	} 
    return false;
}
publics: UpdateVehiclePos(vehicleid, type)
{
    if(type == 1) {
        BanCar[vehicleid] = false;
    }
    GetVehiclePos(vehicleid, VehPos[vehicleid][0], VehPos[vehicleid][1], VehPos[vehicleid][2]);
    GetVehicleZAngle(vehicleid, VehPos[vehicleid][3]);
    return true;
}
stock Difference(Float:Value1, Float:Value2)
{
    return floatround((Value1 > Value2) ? (Value1 - Value2) : (Value2 - Value1));
}
stock SetVehiclePosition(vehicleid, Float:X, Float:Y, Float:Z)
{
    SetVehiclePos(vehicleid ,X,Y,Z);  
	UpdateVehiclePos(vehicleid, false); 
    return true;
}


