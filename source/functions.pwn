	else if (IsPlayerInRangeOfPoint(playerid, 2, -253.742,2597.95,62.2422)) return 1;
	else if (IsPlayerInRangeOfPoint(playerid, 2, 201.016,-107.617,0.898438)) return 1;
	else if (IsPlayerInRangeOfPoint(playerid, 2, 1277.84,372.516,18.9531)) return 1;
	else return 0;
}
stock IsABoat(carid){
	if (GetVehicleState(carid) == VEHICLE_STATE_BOAT) return 1;
	return 0;
}
stock IsAVehicle(carid) {
	if (GetVehicleState(carid) == VEHICLE_STATE_CAR) return 1;
	return 0;
}
stock IsARCVehicle(carid) {
	if (GetVehicleState(carid) == VEHICLE_RADIO_REMOTE) return 1;
	return 0;
}
stock IsANoSTO(carid) {
	switch(GetVehicleModel(carid)) {
		case 576: return 1;
	}
	return 0;
}

stock IsABike(carid){
	if (GetVehicleState(carid) == VEHICLE_STATE_BIKE) return 1;
	return 0;
} 
stock GetXYInBackOfPlayer(const playerid, &Float:x, &Float:y, const Float:distance)
{
	new Float:a;
	GetPlayerPos(playerid, x, y, a);
	GetPlayerFacingAngle(playerid, a);
	if (IsPlayerInAnyVehicle(playerid))
	{
		new vid=GetPlayerVehicleID(playerid);
		if (vid > 0 && vid <= MAX_VEHICLES)GetVehicleZAngle(vid, a);
	}
	x -= (distance * floatsin(-a, degrees)); y -= (distance * floatcos(-a, degrees));
}
stock IsAPlane(carid){
	if (GetVehicleState(carid) == VEHICLE_STATE_PLANE) return 1;
	return 0;
}

