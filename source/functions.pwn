	[7] Статистика за этот день\n\
	[8] Сменить продаваемый продукт\n\
	[9] Назначить Зама [1]\n\
	[10] Назначить Зама [2]\n\
	[11] Назначить Зама [3]\n\
	[12] Назначить Фермера [1]\n\
	[13] Назначить Фермера [2]\n\
	[14] Назначить Фермера [3]\n\
	[15] Назначить Фермера [4]\n\
