}
stock SaveActionsFerm(idx)
{
    new query_[256];
	format(query_, sizeof query_,"UPDATE `farms` SET `auctions` = '%d,%d,%d,%d,%d', `auction_name` = '%s'  WHERE `id` = '%d' LIMIT 1",
	FarmInfo[idx][fAuction][0], FarmInfo[idx][fAuction][1], FarmInfo[idx][fAuction][2], FarmInfo[idx][fAuction][3], FarmInfo[idx][fAuction][4], FarmInfo[idx][fAuctionName], FarmInfo[idx][fID]);
