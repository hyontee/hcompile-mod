		cache_get_value_name_int(0, "pRentHouse", pInfo[playerid][pRentHouse]);
		cache_get_value_name_int(0, "pTheftQuest", pInfo[playerid][pTheftQuest]); 
		cache_get_value_name_int(0, "pCharity", pInfo[playerid][pCharity]); 
		cache_get_value_name_int(0, "pLighter", pInfo[playerid][pLighter]);
		cache_get_value_name_int(0, "pCigarettes", pInfo[playerid][pCigarettes]);
		cache_get_value_name_int(0, "pRecognition", pInfo[playerid][pRecognition]);
		cache_get_value_name_int(0, "pRobHouse", pInfo[playerid][pRobHouse]);
		cache_get_value_name_int(0, "pFishesPach", pInfo[playerid][pFishesPach]);
		cache_get_value_name_int(0, "activate_mail", pInfo[playerid][MailConfirm]);
		cache_get_value_name_int(0, "pDrivingSkill", pInfo[playerid][pDrivingSkill]);  
		//Новый год - После сезона удалить.
		/*cache_get_value_name_int(0, "questtype", pInfo[playerid][questtype]);  
		cache_get_value_name_int(0, "pHPcoin", pInfo[playerid][pHPcoin]);  
		cache_get_value_name_int(0, "pPostcard", pInfo[playerid][pPostcard]); */ 
	
		cache_get_value_name(0, "licenses", kickout, sizeof kickout);
	 	sscanf(kickout, "p<,>a<d>[6]", pInfo[playerid][pLicense]);

		cache_get_value_name(0, "licensesTime", kickout, sizeof kickout);
	 	sscanf(kickout, "p<|>a<d>[6]", pInfo[playerid][pLicenseTime]);
	 	
		cache_get_value_name(0, "phoneList", kickout, 64);
		sscanf(kickout, "p<,>a<d>[8]", pInfo[playerid][PhoneBook]);
		 

		cache_get_value_name(0, "pGunSkills", kickout, 32);
		sscanf(kickout, "p<,>a<d>[6]", pInfo[playerid][pGunSkill]);

		cache_get_value_name(0, "pRecordArena", kickout, 32);
		sscanf(kickout, "p<|>a<d>[6]", pInfo[playerid][pRecordArena]);
		//pRecordArena[6],
		cache_get_value_name(0, "pWeapons", kickout, 48);
		sscanf(kickout, "p<,>a<d>[13]", player_weapon_id[playerid]);
		
		cache_get_value_name(0, "pAmmos", kickout, 48);
		sscanf(kickout, "p<,>a<d>[13]", player_weapon_ammo[playerid]);


		cache_get_value_name_int(0, "pDailyReward", pInfo[playerid][pDailyReward]);
		cache_get_value_name(0, "pRewardDate", pInfo[playerid][pRewardDate], 32);
		cache_get_value_name(0, "pRewardRegDate", pInfo[playerid][pRewardRegDate], 32);
 
		cache_get_value_name(0, "pQuestID", kickout, sizeof kickout);
		sscanf(kickout, "p<,>a<d>[8]", pQuest[playerid][pQuestID]); 


		cache_get_value_name(0, "pQuestTemp", kickout, sizeof kickout);
		sscanf(kickout, "p<,>a<d>[8]", pQuest[playerid][pQuestTemp]);

		cache_get_value_name_int(0, "gRoulleteTime", pTemp[playerid][gTimeNoAFK]);
		cache_get_value_name_int(0, "PromoCode", pInfo[playerid][PromoCode]);

		cache_get_value_name_int(0, "edited_ads", pInfo[playerid][edited_ads]);
		cache_get_value_name_int(0, "CaptureKills", pInfo[playerid][pCaptureKills]);
 
		cache_get_value_name(0, "SkillProd", kickout, 32);
		sscanf(kickout, "p<,>a<d>[3]", pInfo[playerid][JobDriverProdInfo]);
		
		
		cache_get_value_name(0, "pAchivID", kickout, sizeof kickout);
		sscanf(kickout, "p<|>a<d>[50]", pAchivID[playerid]);
		cache_get_value_int(0, "w_rSpins", pInfo[playerid][pSpins]);

 
		kickout[0] = EOS;



		#if defined _businesses_inc
			new tempBusinessID[MAX_PLAYER_BUSINESS];
			cache_get_value_name(0, "pBusinessID", kickout, sizeof (kickout));
			sscanf(kickout, "p<,>a<i>["#MAX_PLAYER_BUSINESS"]", tempBusinessID);
	
			for (new i = 0; i < MAX_PLAYER_BUSINESS; i++) 
				pInfo[playerid][pBusinessID][i] = 0;
			for (new id = 0; id < sizeof (BusinessInfo); id++) {
				if (!IsValidBusiness(id)) 
					continue;
				for (new i = 0; i < MAX_PLAYER_BUSINESS; i++) {
					if (tempBusinessID[i] && tempBusinessID[i] == BusinessInfo[id][bID]) {
						if (!strcmp(BusinessInfo[id][bOwner], pInfo[playerid][pName], true)) {
							pInfo[playerid][pBusinessID][i] = id + 1;
						}
						tempBusinessID[i] = 0;
					}
				}
			}
			for (new i = 0, id; i < MAX_PLAYER_BUSINESS; i++) {
				if (!pInfo[playerid][pBusinessID][i]) continue;
				id = pInfo[playerid][pBusinessID][i] - 1;
				if (strcmp(BusinessInfo[id][bOwner], pInfo[playerid][pName], true)) {
					pInfo[playerid][pBusinessID][i] = 0;
				}
			}
		#endif
		OW_OnPlayerLogin(playerid);
		#if defined _hpquest_inc
			LoadPlayerNYQuest(playerid);
		#endif
		#if defined _medcard_inc
			LoadPlayerMedcardData(playerid);
		#endif

		#if defined _inventory_inc
            InventoryMain:LoadPlayerData(playerid);
        #endif

		for(new gangzone = 1; gangzone <= TOTALGZ; gangzone++) {
			GangZoneShowForPlayer(playerid,GZInfo[gangzone][gZone],GetGangZoneColor(gangzone));
			if (GZInfo[gangzone][gTimer]) { 
				GangZoneStopFlashForPlayer(playerid, GZInfo[gangzone][gZone]);
				GangZoneFlashForPlayer(playerid, GZInfo[gangzone][gZone], COLOR_RED);
			}
		} 
		pTemp[playerid][tTimeLogin] = -2;
		pInfo[playerid][pLogin] = 1;
		/* Загрузка данных */
		ResetPlayerMoney(playerid);
		GivePlayerMoneyEx(playerid);
        if (pInfo[playerid][pCash] < 0) pInfo[playerid][pCash] = 0;  
		GetPlayerFarm(playerid);
		SetPlayerSkills(playerid);  

		new query_[256];/*SELECT * FROM s_vehicle_player WHERE vOwner = '%d' AND vSellCost = 0 AND `vFine`='0' LIMIT 5*/
		if (!GetPVarInt(playerid, "First_Enter")) {
			mysql_format(dbHandle, query_, sizeof query_, "SELECT * FROM s_vehicle_player WHERE (vOwner = '%d' AND vSellCost = 0) AND (vFine='0' OR vModel = '508') LIMIT 5", pInfo[playerid][pID]);
			mysql_tquery(dbHandle, query_, "OnPlayerTypeLoadVehicle", "iii", playerid, 0, 0);
		}
		
		format(query_, sizeof query_, "SELECT * FROM `s_christmas` WHERE `cID` = %d LIMIT 1", pInfo[playerid][pID]);
		mysql_tquery(dbHandle, query_, "LoadPlayerCristmas" , "i", playerid); 

		#if defined _promo_referal_inc
			format(query_, sizeof query_, "SELECT * FROM "TABLE_PROMO_TEMP" WHERE `promoID` = %d LIMIT 1", pInfo[playerid][pID]);
			mysql_tquery(dbHandle, query_, "OnLoadPlayerDataPromoCode" , "i", playerid); 
		#endif
		
		EatBar[playerid] = CreatePlayerProgressBar(playerid, 548.00, 58.00, 62.0, 3.9, COLOR_SERVER, 1000.0, BAR_DIRECTION_RIGHT);
		SetPlayerProgressBarMaxValue(playerid, EatBar[playerid], 1000.0);
		if (pInfo[playerid][PlayerSettings] & setShowEatBar) {
		    ShowPlayerProgressBar(playerid, EatBar[playerid]);
			SetPlayerProgressBarValue(playerid, EatBar[playerid], pInfo[playerid][Satiety]);
		}
		else HidePlayerProgressBar(playerid, EatBar[playerid]);
		
       	if (pInfo[playerid][punWarns] != 0) {
			if (pInfo[playerid][punWarns] <= gettime()) {
			    SendClientMessage(playerid, 0xFFCD00FF, !"- Время действия варна истекло! Приятной игры!");
			    pInfo[playerid][pWarns] 	=
				pInfo[playerid][punWarns] 	= 0; 
			}
		}

		if(pInfo[playerid][pRentHouse] != -1)
		{
			new days = floatround((pInfo[playerid][pRent][1]-gettime())/U_Day);
			if(days <= 0) 
			{
				    pInfo[playerid][pRentHouse] = -1;
					pInfo[playerid][pRent][0] = 0;
					pInfo[playerid][pRent][1] = 0;
					SavePlayerInteger(@p,"rent_0",0);
					SavePlayerInteger(@p,"rent_1",0);
					SavePlayerInteger(@p,"pRentHouse",-1);
					SCM(playerid, COLOR_LIGHTBLUE, "Вы выселились из дома!");

					new  query[128]; 
					format(query, sizeof query, "UPDATE `s_users` SET `pRentHouse`='-1', `rent_1` = '0', `rent_0` = '0' WHERE `pID`='%d'",  pInfo[playerid][pID]);
					mysql_query(dbHandle, query); 

					return 1;
			}
		}

		if(pInfo[playerid][pRentHouse] != -1)
		{
			new days = floatround((pInfo[playerid][pRent][1]-gettime())/U_Day);
			if(days) 
			{
				format(query_,sizeof(query_),"Вы арендуете дом. Напомнинаем вам, что до окончания срока аренды осталось %d дней(-я).",days);
				SCM(playerid,COLOR_LIGHTGREEN,query_);
				if(days < 3) SCM(playerid,COLOR_LIGHTGREEN,"Для продления аренды подойдите к дому и введите команду /rentable."),SetPVarInt(playerid,#P_HArend,1);
			}
			else 
			{
				SCM(playerid,COLOR_LIGHTGREEN,"Вы арендуете дом. Напомнинаем вам, что сегодня последний день аренды.");
				SCM(playerid,COLOR_LIGHTGREEN,"Для продления аренды подойдите к дому и введите команду /rent.");
				SetPVarInt(playerid,#P_HArend,1);
			}
		}

		//CheckPlayerUnWarn(playerid);
		CheckPlayerVipTime(playerid);
		CheckPlayerLicenseTime(playerid);
		CheckPlayerBoostTime(playerid);
        new
			playersip[16],
			strstre[50]; 
		GetPlayerIp(playerid, playersip, sizeof(playersip));
		
		gettime(hour, minute, second);
		
		format(strstre, sizeof strstre,"%d/%d/%d %d:%d",day,month,year,hour,minute);
        SetPlayerConnection(pInfo[playerid][pID], pInfo[playerid][pName], playersip);
		if (pInfo[playerid][pLastData] != curdate) {
			pInfo[playerid][pInGameDay] = 0;
			pInfo[playerid][pLastData] = curdate; 
			for(new i; i < sizeof(aInfo); i++) {
				if (aInfo[i][aType] != DAY_ACHIEV) continue; 
				pAchivID[playerid][i] = 0;
			}
		}

		format(query_,sizeof query_, "UPDATE `s_users` SET pWarns = '%d', punWarns = '%d', pGetonDate = '%s', InGameDay = '%d', pLogin = '1', pIp = '%s', pvIp = '%s', LastData = '%d' WHERE pID = '%d'",
			pInfo[playerid][pWarns], pInfo[playerid][punWarns], strstre, pInfo[playerid][pInGameDay], playersip, playersip, curdate, pInfo[playerid][pID]
		);
		mysql_tquery(dbHandle, query_, "", "");

		SendClientMessage(playerid, 0xFFCD00FF, !"Здравствуйте, уважаемый игрок!");
		new str_[40];
		format(str_, sizeof str_, "~w~Welcome ~n~~b~   %s", pInfo[playerid][pName]);
		GameTextForPlayer(playerid, str_, 5000, 1);

		StopAudioStreamForPlayer(playerid);

		/*if (!pInfo[playerid][pConfirmVK]) { VK Guard
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"У вас не подключен "col_VK"VK Guard!"); 
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Используйте {FFCD00}/mm"colwhi" -> [0] Настройки -> [10] Безопасность -> [0] VK Guard");
		}*/
		/*if (!pInfo[playerid][MailConfirm]) {
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"У вас не подтвержден {EB6B56}E-Mail "colwhi"Используйте {FFCD00}/mm"colwhi" -> [0] Настройки -> [10] Безопасность -> [1] E-Mail");
			SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Обратите внимание! В случае утери пароля, вы не сможете восстановить доступ с неподтвержденным {EB6B56}E-Mail");
		}*/

		ShowGoogleAuth(playerid);

		if(!GetString(pInfo[playerid][pPame], "None"))
    	{
	   		new format_str[200];
			format(format_str, sizeof(format_str),"%s", pInfo[playerid][pPame]);
			for(new i; i < strlen(format_str); i++) if(format_str[i] == '/') format_str[i] = '\n';
	    	pame_text[playerid] = CreateDynamic3DTextLabel(format_str, 0x999999FF, 0.0, 0.0, -1.0, 5, playerid,-1, 0, -1, -1, -1);
			format(format_str,sizeof(format_str), "Описание персонажа: {ffcc00}%s", pInfo[playerid][pPame]);
			for(new i; i < strlen(format_str); i++) if(format_str[i] == '/') format_str[i] = ' ';
			SendClientMessage(playerid, COLOR_GREY, format_str);
    	}

        OnPlayerLoginVoting(playerid);
		if (ZoneID != 0) GangZoneShowForAll(ZoneWar, 0xB2B2B2AA), GangZoneFlashForAll(ZoneWar,COLOR_RED);

		new sdate[32];
		format(sdate, sizeof sdate, "%d.%d.%d", year, month, day);

		if (pInfo[playerid][pDailyReward] == 0 && strcmp(pInfo[playerid][pRewardDate], sdate, true))
		{
		    SendClientMessage(playerid, COLOR_SERVER, "Ежедневный бонус:"colwhi" Зайдя завтра, Вы начнёте получать ежедневный бонус за вход, приятной игры!");
			format(pInfo[playerid][pRewardDate], 32, "%s", nextdate(year, month, day));
			SavePlayerString(playerid, "pRewardDate", pInfo[playerid][pRewardDate]);
			pInfo[playerid][pDailyReward] ++;
			SavePlayerInteger(playerid, "pDailyReward", pInfo[playerid][pDailyReward]);
			format(pInfo[playerid][pRewardRegDate], 32, "%s", sdate);
			SavePlayerString(playerid, "pRewardRegDate", pInfo[playerid][pRewardRegDate]);
		}
		else if (pInfo[playerid][pDailyReward] > 0 && !strcmp(pInfo[playerid][pRewardDate], sdate, true))
		{
			SendMes(playerid, COLOR_SERVER, "Ежедневный бонус:"colwhi" Вы вошли "collime"%d"colwhi" %s подряд, Ваше вознаграждение: "collime"$%d", pInfo[playerid][pDailyReward], Declension_ReturnWord(pInfo[playerid][pDailyReward], "день", "дня", "дней"), (1000 * pInfo[playerid][pDailyReward]));
			kLibGivePlayerMoney(playerid, 1000 * pInfo[playerid][pDailyReward], "ежедневный бонус 1");
			SetMoveCashServer(IN_SERVER, 1000 * pInfo[playerid][pDailyReward]);
			pInfo[playerid][pDailyReward] ++;
			SavePlayerInteger(playerid, "pDailyReward", pInfo[playerid][pDailyReward]);
			strdel(pInfo[playerid][pRewardDate], 0, 32);
			format(pInfo[playerid][pRewardDate], 32, "%s", nextdate(year, month, day));
			SavePlayerString(playerid, "pRewardDate", pInfo[playerid][pRewardDate]);
			strdel(pInfo[playerid][pRewardRegDate], 0, 32);
			format(pInfo[playerid][pRewardRegDate], 32, "%s", sdate);
			SavePlayerString(playerid, "pRewardRegDate", pInfo[playerid][pRewardRegDate]);
		}
		else if (pInfo[playerid][pDailyReward] > 0 && (strcmp(pInfo[playerid][pRewardDate], sdate, true) && strcmp(pInfo[playerid][pRewardRegDate], sdate, true)))
		{
			SendClientMessage(playerid, COLOR_SERVER, !"Ежедневный бонус:"colwhi" Вы пропустили ежедневный бонус, зайдите завтра чтобы начать получать его заново!");
			pInfo[playerid][pDailyReward] = 1;
			SavePlayerInteger(playerid, "pDailyReward", pInfo[playerid][pDailyReward]);
			strdel(pInfo[playerid][pRewardDate], 0, 32);
			format(pInfo[playerid][pRewardDate], 32, "%s", nextdate(year, month, day));
			SavePlayerString(playerid, "pRewardDate", pInfo[playerid][pRewardDate]);
			strdel(pInfo[playerid][pRewardRegDate], 0, 32);
			format(pInfo[playerid][pRewardRegDate], 32, "%s", sdate);
			SavePlayerString(playerid, "pRewardRegDate", pInfo[playerid][pRewardRegDate]);
		}
		
        if (strcmp("None", fInfo[ pInfo[playerid][pMember] ][fMessage], true) && pInfo[playerid][pMember] > 0) {
			SendClientMessage(playerid, COLOR_SERVER, !"- Сообщение от лидера фракции:");
			SendClientMessage(playerid, COLOR_SERVER, fInfo[ pInfo[playerid][pMember] ][fMessage]);
		} 

		SetPlayerScore(playerid, pInfo[playerid][pLevel]);
        SetPlayerHealth(playerid, pInfo[playerid][PlayerHealth]);
		invite_team(playerid, pInfo[playerid][pMember]);


		if (pInfo[playerid][pMember] > 0) {
			if (FractionInfo[ pInfo[playerid][pMember] ][fPosDuty][0] == 0.0) {
				pTemp[playerid][tDutyWork] = 1;
			}
		}  
		#if defined _ac_ser_inc 
			AC_Info[playerid][acSetPos] = GetTickCount() + 2850;

		#endif
			

		SendClientMessage(playerid, COLOR_YELLOW, !"[Подсказка] "colwhi"Не забывайте выполнять ежедневные достижения! (( "colserver"\"/achievement\""colwhi" ))");
		if (SPECPL_SPAWN_ON) TogglePlayerSpectating(playerid, 0);
		PlayerSpawnEx(playerid); 
		LoadMessagePlayerOffline(playerid);
		LoadPlayerDj(playerid);

		#if defined debug_mode 
			printf("[GM debug] [LOGIN] OnPlayerLoginAuth(%s(%d), %d, %d, %d, %s) NAME: %s", pInfo[playerid][pName], playerid); 
		#endif 
		
	}
	else return scmKick(playerid, "Для выхода из игры используйте /q(uit)");

	return 1;
}

publics: OnMySQL_QUERY(idx, playerid, str[])
{
    new
		rows;
	cache_get_row_count(rows);
	switch(idx)
	{ 
        case MYSQL_LOAD_CASINO:
        {
            new time = GetTickCount();
            if (!rows) return print("[Загрузка ...] Данные из Casino не получены!");
		    for(idx = 1; idx <= rows; idx++)
		    {
		    	cache_get_value_name_int(idx-1, "ID", CasinoInfo[idx][caID]);
		    	cache_get_value_name(idx-1, "Name", CasinoInfo[idx][caName], 32);
		    	cache_get_value_name_int(idx-1, "Mafia", CasinoInfo[idx][caMafia]);
		    	cache_get_value_name(idx-1, "Krupie", CasinoInfo[idx][caKrupie], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie2", CasinoInfo[idx][caKrupie2], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie3", CasinoInfo[idx][caKrupie3], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie4", CasinoInfo[idx][caKrupie4], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie5", CasinoInfo[idx][caKrupie5], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie6", CasinoInfo[idx][caKrupie6], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie7", CasinoInfo[idx][caKrupie7], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie8", CasinoInfo[idx][caKrupie8], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie9", CasinoInfo[idx][caKrupie9], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Krupie10", CasinoInfo[idx][caKrupie10], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Manager", CasinoInfo[idx][caManager], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Manager2", CasinoInfo[idx][caManager2], MAX_PLAYER_NAME);
		    	cache_get_value_name(idx-1, "Manager3", CasinoInfo[idx][caManager3], MAX_PLAYER_NAME);
		    	cache_get_value_name_float(idx-1, "posX", CasinoInfo[idx][caPos][0]);
		    	cache_get_value_name_float(idx-1, "posY", CasinoInfo[idx][caPos][1]);
		    	cache_get_value_name_float(idx-1, "posZ", CasinoInfo[idx][caPos][2]);
				new 
					data_[128],
					string_[128],
					map_icon = 25;
				//printf("Name: %s | IDX %d, cID %d", CasinoInfo[idx][caName], idx, CasinoInfo[idx][caID]);
				
				cache_get_value_name(idx-1, "enter", data_, sizeof data_), sscanf(data_,"p<|>a<f>[3]", CasinoInfo[idx][cEnter]);
				new mafiaName[16];
				switch(CasinoInfo[idx][caMafia]) {
					case INVALID_FRACTION_ID: mafiaName = "Свободна";
					case FRACTION_LCN: mafiaName = "LCN";
					case FRACTION_YAKUZA: mafiaName = "Yakuza";
					case FRACTION_RUSSIAN: mafiaName = "Русская Мафия";
				}
				format(string_, sizeof string_, ""colwhi"Казино:  "C_PODS"%s\n"colwhi"Управляет:  "C_PODS"%s", CasinoInfo[idx][caName], mafiaName);
				CasinoInfo[idx][cLabel] = CreateDynamic3DTextLabel(string_, 0xFFFFFFFF, 
					CasinoInfo[idx][cEnter][0], 
					CasinoInfo[idx][cEnter][1], 
					CasinoInfo[idx][cEnter][2]+0.7, 
					5.0,
					.worldid = 0, .interiorid = 0
				);
				if (CasinoInfo[idx][caID] == 1) map_icon = 43;
				else map_icon = 25;
				CasinoInfo[idx][cMapIcon] = CreateDynamicMapIcon(
					CasinoInfo[idx][cEnter][0], 
					CasinoInfo[idx][cEnter][1], 
					CasinoInfo[idx][cEnter][2], 
					map_icon, 0,
					.worldid = 0, .interiorid = 0
				); 
		    	TOTALCASINO++;
            } 
			CreateDynamic3DTextLabel("Устроиться: "colserver"\"Крупье\"", -1, 1963.7473,1063.2229,994.4688, 7.0, .worldid = 1, .interiorid = 10);
			CreateDynamic3DTextLabel("Устроиться: "colserver"\"Крупье\"", -1, 2150.5393,1603.1434,1006.1802, 7.0, .worldid = 999, .interiorid = 1);
			RouletCloakroom[0] = CreateDynamicPickup(1275, 23, 1963.7473,1063.2229,994.4688,-1); // Four Dragons
			RouletCloakroom[1] = CreateDynamicPickup(1275, 23, 2150.5393,1603.1434,1006.1802,-1); // Caligula

			caligula[0] = CreateDynamicPickup(19132,23,2233.9912,1714.6836,1012.3828,-1);// Выход Caligula
			caligula[1] = CreateDynamicPickup(19132,23,2196.9653,1677.1547,12.3672);// Вход Caligula

			dragons[0] = CreateDynamicPickup(19132,23,2018.2197,1017.6940,996.8750,-1);// Выход 4'Dragons
			dragons[1] = CreateDynamicPickup(19132,23,2019.3192,1007.7440,10.8203);// Вход 4'Dragons
            printf("[Загрузка ...] Данные из Casino получены! (%d шт.) Время: %d", TOTALCASINO, GetTickCount() - time);
		}  
		case MYSQL_LOAD_FRACTION_BANK://
		{
		    new time = GetTickCount();
		    if (!rows) return print("[Загрузка ...] Данные из Fraction Bank не получены!");
		    for(new bank = 1, position_mass[128]; bank <= rows; bank++)
		    {
		        cache_get_value_name_int(bank-1, "fID", FractionInfo[bank][fID]);
		        cache_get_value_name_int(bank-1, "fMats", FractionInfo[bank][fMaterials]);

				cache_get_value_name_int(bank-1, "fDrugs", FractionInfo[bank][fDrugs]);
				cache_get_value_name_int(bank-1, "fSpeedDrugs", FractionInfo[bank][fSpeedDrugs]);
		        cache_get_value_name_int(bank-1, "fMoney", FractionInfo[bank][fMoney]);
		        cache_get_value_name_int(bank-1, "fHeal", FractionInfo[bank][fHeal]);
		        cache_get_value_name_int(bank-1, "fLock", FractionInfo[bank][fLock]);
		        cache_get_value_name_int(bank-1, "fHouseLock", FractionInfo[bank][fHouseLock]);
		        cache_get_value_name_int(bank-1, "fRepute", FractionInfo[bank][fRepute]); 

		        cache_get_value_name(bank-1, "fPosWareHouse", position_mass, sizeof position_mass);
				sscanf(position_mass,"p<|>a<f>[3]", FractionInfo[bank][fPosWareHouse]);
				cache_get_value_name_int(bank-1, "fWorldWH", FractionInfo[bank][fWorldWH]);
				cache_get_value_name_int(bank-1, "fIntWH", FractionInfo[bank][fIntWH]);

				cache_get_value_name(bank-1, "fPosDuty", position_mass, sizeof position_mass);
				sscanf(position_mass,"p<|>a<f>[3]", FractionInfo[bank][fPosDuty]);
				cache_get_value_name_int(bank-1, "fWorldDuty", FractionInfo[bank][fWorldDuty]);
				cache_get_value_name_int(bank-1, "fIntDuty", FractionInfo[bank][fIntDuty]);
				cache_get_value_name_int(bank-1, "fPoints", FractionInfo[bank][fPoints]); 
				cache_get_value_name_int(bank-1, "fTaxState", FractionInfo[bank][fTaxState]); 
				cache_get_value_name_int(bank-1, "fCDPrize", FractionInfo[bank][fCDPrize]);
				FractionInfo[bank][fViolation][0] = FractionInfo[bank][fViolation][1] = FractionInfo[bank][fViolation][2] = FractionInfo[bank][fViolation][3] = 0; 
				if (FractionInfo[bank][fPosDuty][0] + FractionInfo[bank][fPosDuty][1] + FractionInfo[bank][fPosDuty][2] != 0.0)
				{
					CreateDynamic3DTextLabel(
						""colmaline"[ Переодеться ]", -1, 
						FractionInfo[bank][fPosDuty][0], 
						FractionInfo[bank][fPosDuty][1], 
						FractionInfo[bank][fPosDuty][2], 
						10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 
						FractionInfo[bank][fWorldDuty], 
						FractionInfo[bank][fIntDuty]
					);
					CreateDynamicPickup(1275, 23, 
						FractionInfo[bank][fPosDuty][0], 
						FractionInfo[bank][fPosDuty][1], 
						FractionInfo[bank][fPosDuty][2],
						FractionInfo[bank][fWorldDuty], 
						FractionInfo[bank][fIntDuty]
					);
					FractionInfo[bank][fDutySphere] = CreateDynamicSphere(
					FractionInfo[bank][fPosDuty][0], 
					FractionInfo[bank][fPosDuty][1], 
					FractionInfo[bank][fPosDuty][2], 1, 
					FractionInfo[bank][fWorldDuty], 
					FractionInfo[bank][fIntDuty]
					);	  
				}  
				if (FractionInfo[bank][fPosWareHouse][0] + FractionInfo[bank][fPosWareHouse][1] + FractionInfo[bank][fPosWareHouse][2] != 0.0)
				{// FractionInfo[bank][fPosWareHouse][0] + FractionInfo[bank][fPosWareHouse][1] + FractionInfo[bank][fPosWareHouse][2] != 0.0
				    new
				        string_[320];
					
				    if (FractionInfo[bank][fID] == FRACTION_LSPD || FractionInfo[bank][fID] == FRACTION_FBI 
						|| FractionInfo[bank][fID] == FRACTION_SFPD || FractionInfo[bank][fID] == FRACTION_LVPD) {
						format(string_, sizeof string_, "{FFD700}Склад оружия\nМатериалов: %d ед.\n \n{CAFA0A}Используйте: ALT",
							FractionInfo[bank][fMaterials]
						);
						FractionInfo[bank][fText] = CreateDynamic3DTextLabel(string_, -1, 
							FractionInfo[bank][fPosWareHouse][0], 
							FractionInfo[bank][fPosWareHouse][1], 
							FractionInfo[bank][fPosWareHouse][2], 
							10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 
							FractionInfo[bank][fWorldWH], FractionInfo[bank][fIntWH]
						);
				    } 
				    else if (FractionInfo[bank][fID] == FRACTION_LCN)
					{
						format(string_, sizeof string_, "{FFD700}Склад La Cosa Nostra\n{FFFFFF}Материалы: {F58B11}%d\n{FFFFFF}Аптечек: {F58B11}%d\n{FFFFFF}Деньги: {F58B11}$%s\n\n{CAFA0A}Используйте: ALT",
						FractionInfo[bank][fMaterials], FractionInfo[bank][fHeal], convert_money(FractionInfo[bank][fMoney]));
						FractionInfo[bank][fText] = CreateDynamic3DTextLabel(string_, -1, FractionInfo[bank][fPosWareHouse][0], FractionInfo[bank][fPosWareHouse][1], FractionInfo[bank][fPosWareHouse][2], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, FractionInfo[bank][fWorldWH], FractionInfo[bank][fIntWH]);
				    }
				    else if (FractionInfo[bank][fID] == FRACTION_YAKUZA)
				    {
