	for ( new i ; i < 10 ; i ++ )
	{
		if (TurnLoadingTrucker[LOADING_SAWMILL_0][i] != INVALID_PLAYER_ID && !IsPlayerConnected(TurnLoadingTrucker[LOADING_SAWMILL_0][i]) 
			|| (TurnLoadingTrucker[LOADING_SAWMILL_0][i] != INVALID_PLAYER_ID && !GetPVarInt(TurnLoadingTrucker[LOADING_SAWMILL_0][i], "truck_waiting"))) {
				TurnLoadingTrucker[LOADING_SAWMILL_0][i] = INVALID_PLAYER_ID;
		}
