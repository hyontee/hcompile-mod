stock GetString(const param1[], const param2[])
{
	return !strcmp(param1, param2, false);
}
stock SetString(param_1[], const param_2[], size = 300)
{
    return strmid(param_1, param_2, 0, strlen(param_2), size);
}

stock IsAAssis(playerid)
{
	if (IsABiker(playerid) && pInfo[playerid][pRank] >= 8
	|| IsAArmy(playerid) && pInfo[playerid][pRank] > 12
	|| pInfo[playerid][pMember] == 1 && pInfo[playerid][pRank] >= 13
	|| pInfo[playerid][pMember] == 10 && pInfo[playerid][pRank] >= 13
	|| pInfo[playerid][pMember] == 21 && pInfo[playerid][pRank] >= 13
	|| pInfo[playerid][pMember] == 2 && pInfo[playerid][pRank] >= 9
	|| IsAMedic(playerid) && pInfo[playerid][pRank] >= 9
	
	|| IsAMafia(playerid) && pInfo[playerid][pRank] >= 9
	|| pInfo[playerid][pMember] == 11 && pInfo[playerid][pRank] >= 7

	|| pInfo[playerid][pMember] == 12 && pInfo[playerid][pRank] >= 9
	|| pInfo[playerid][pMember] == 13 && pInfo[playerid][pRank] >= 9
	|| pInfo[playerid][pMember] == 15 && pInfo[playerid][pRank] >= 9
	|| pInfo[playerid][pMember] == 17 && pInfo[playerid][pRank] >= 9
	|| pInfo[playerid][pMember] == 18 && pInfo[playerid][pRank] >= 9

	|| IsANews(playerid) && pInfo[playerid][pRank] > 7
	|| IsAMayor(playerid) && pInfo[playerid][pRank] >= 5) return 1;
	return 0;
} 
stock IsUnInviteAssistant(playerid)
{
	new fraction_id = pInfo[playerid][pMember],
		rank = pInfo[playerid][pRank];
	if (rank >= fInfo[fraction_id][fHelper][1]) return 1;
	return 0;
}
stock IsGiveRankAssistant(playerid)
{
	new fraction_id = pInfo[playerid][pMember],
		rank = pInfo[playerid][pRank];
	if (rank >= fInfo[fraction_id][fHelper][2]) return 1;
	return 0;
}
stock IsUnGiveRankAssistant(playerid)
{
	new fraction_id = pInfo[playerid][pMember],
		rank = pInfo[playerid][pRank];
	if (rank >= fInfo[fraction_id][fHelper][3]) return 1;
	return 0;
} 
