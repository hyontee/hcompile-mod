stock SetVehicleBling(vehicleid_, speed_)
{
    VehicleBlinkStatus[vehicleid_] = true;
	VehicleBlinkTimer[vehicleid_] = SetTimerEx("vehicle_blink_start" , speed_, true, "i", vehicleid_);
}
stock StopVehicleBling(vehicleid_)
{
    new stat[4];
	KillTimer(VehicleBlinkTimer[vehicleid_]);
	VehicleBlinkStatus[vehicleid_] = false;
	GetVehicleDamageStatus(vehicleid_,stat[0],stat[1],stat[2],stat[3]);
	UpdateVehicleDamageStatus(vehicleid_,stat[0],stat[1],0,stat[3]);
}
publics: vehicle_blink_start(vehicleid_)
{
    new stat[4];
	GetVehicleDamageStatus(vehicleid_, stat[0], stat[1], stat[2], stat[3]);
	UpdateVehicleDamageStatus(vehicleid_, stat[0], stat[1], rand_blink_param[random(2)], stat[3]);
} 


stock SaveGraffiti(graffiti)
{
	new query_[128];
	format(query_, sizeof query_, "UPDATE `s_graffiti` SET `tFraction` = '%d' WHERE `tID` = '%d'",TagInfo[graffiti][tFraction],graffiti);
	return mysql_tquery(dbHandle, query_, "", "");
} 
stock convert_money(amount, const delimiter[2] = ".")
{
	new int_string[15];
	format(int_string, sizeof(int_string), "%d", amount >= 0 ? amount : -amount);

	new value = strlen(int_string);
	switch(value)
	{
		case 4..6:
			strins(int_string, delimiter, value - 3, 1);
		case 7..9:
			strins(int_string, delimiter, value - 3, 1),
			strins(int_string, delimiter, value - 6, 1);
		case 10..12:
			strins(int_string, delimiter, value - 3, 1),
			strins(int_string, delimiter, value - 6, 1),
			strins(int_string, delimiter, value - 9, 1);
	}

	if(amount < 0) strins(int_string, "-", 0);
	return int_string;
}
stock Declension_GetWord(result[], const size = sizeof(result), num, const word_1[], const word_2[], const word_3[])
{
    num %= 100;
    if (num > 19)
    {
        num %= 10;
    }
    result[0] = '\0';
    switch (num)
    {
        case 1: strcat(result, word_1, size);
        case 2..4: strcat(result, word_2, size);
        default: strcat(result, word_3, size);
    }
} 

#define MAX_LANG_VALUE_STRING 20
stock Declension_ReturnWord(num, const word_1[MAX_LANG_VALUE_STRING], const word_2[MAX_LANG_VALUE_STRING], const word_3[MAX_LANG_VALUE_STRING])
{
	new result[MAX_LANG_VALUE_STRING];
	Declension_GetWord(result, sizeof(result), num, word_1, word_2, word_3);
	return result;
} 
