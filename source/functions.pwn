GetPlayerSpawnName(playerid) {
	new spawnpos[36];
	switch(pInfo[playerid][PlayerSpawn])
	{
		case 0: spawnpos = "Стандартный";
		case 1: spawnpos = "Дом";
		case 2:
		{
		    if (pTemp[playerid][tDutyWork] == 1) spawnpos = "Организация (Рабочий день начат)";
			else spawnpos = "Организация (Рабочий день окончен)";
		}
		case 3: spawnpos = "Дом на колёсах";
		case 4: spawnpos = "Яхта";
		case 5: spawnpos = "Семейный особняк";
		case 6: spawnpos = "Семейный дом";		
		default: spawnpos = "ОШИБКА/БАГ";
	}
	return spawnpos;
}

CMD:switchskin(playerid, params[])
{
    if (pTemp[playerid][tSelectSkinShop] != -1) return true;
    if (!IsAGang(playerid)) return 1;
	if (forma[playerid] != 1) return SendClientMessage(playerid, COLOR_GRAD1, !"У вас нет военной формы!");
	SetPlayerSkinEx(playerid, pInfo[playerid][pSex] == 1 ? 287 : 191);
	SetPlayerColor(playerid, COLOR_GREEN);
	forma[playerid] = 0;
	pTemp[playerid][PlayerInArmyForm] = true;
	return 1;
}

CMD:getdebt(playerid, params[])
{
	if (!IsAMafia(playerid)) return 1;
	if (pInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREY, !"Доступно с 3 ранга!");
	if (sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, !"Введите: /getdebt [id]");
	if (!PlayerInConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден!");
	if (!IsPlayerInRangeOfPlayer(8.0, playerid, params[0])) return 1;
	new string_[128], query_[128];
	if (pInfo[playerid][pMember] == pInfo[params[0]][pKrisha])
	{
	    if (pInfo[params[0]][pDolg] < 50) return SendClientMessage(params[0], COLOR_GRAD1, "Не достаточная сумма, для возврата долга!");
	    if (kLibGetPlayerMoney(params[0]) < pInfo[params[0]][pDolg]) return SendClientMessage(playerid, COLOR_GREY, !"У игрока недостаточно денег!");
		kLibGivePlayerMoney(params[0], -pInfo[params[0]][pDolg], "/getdebt");
		scm(playerid, -1, "Вы выбили долг из должника!");
		scm(params[0], -1, "С вас выбили долг!");
        switch(pInfo[params[0]][pKrisha])
		{
			case 6:
			{
				SendClientMessage(params[0], COLOR_YELLOW, "Долг был возвращён мафии Yakuza!");
				format(string_, sizeof string_, "%s вернул долг в размере $%s",pInfo[params[0]][pName],pInfo[params[0]][pDolg]);
			}
			case 5:
			{
				SendClientMessage(params[0], COLOR_YELLOW, "Долг был возвращён LCN!");
				format(string_, sizeof string_, "%s вернул долг в размере $%s",pInfo[params[0]][pName],pInfo[params[0]][pDolg]);
			}
			case 14:
			{
				SendClientMessage(params[0], COLOR_YELLOW, "Долг был возвращён Русской мафии!");
				format(string_, sizeof string_, "%s вернул долг в размере $%s",pInfo[params[0]][pName],pInfo[params[0]][pDolg]);
			}
		}
		SendFamilyMessage(pInfo[params[0]][pKrisha], COLOR_YELLOW2, string_);
		FractionInfo[pInfo[params[0]][pKrisha]][fMoney] += pInfo[params[0]][pDolg] ;
		SaveFractionInfoID(FractionInfo[pInfo[params[0]][pKrisha]][fID], false);
		pInfo[params[0]][pDolg] = 0;
		format(query_, sizeof query_, "UPDATE `s_users` SET `pDolg` = '%d' WHERE `Name` = '%s'", pInfo[params[0]][pDolg], pInfo[params[0]][pName]);
		mysql_tquery(dbHandle, query_, "", "");
	}
	return 1;
}

CMD:hackbase(playerid, params[])
{
	if (!IsAMafia(playerid)) return 1;
    if (GetVehicleModel(GetPlayerVehicleID(playerid)) != 497 && GetVehicleModel(GetPlayerVehicleID(playerid)) != 427 && GetVehicleModel(GetPlayerVehicleID(playerid)) != 523 && GetVehicleModel(GetPlayerVehicleID(playerid)) != 415
	&& GetVehicleModel(GetPlayerVehicleID(playerid)) != 521 && GetVehicleModel(GetPlayerVehicleID(playerid)) != 596 && GetVehicleModel(GetPlayerVehicleID(playerid)) != 597 && GetVehicleModel(GetPlayerVehicleID(playerid)) != 598
	&& GetVehicleModel(GetPlayerVehicleID(playerid)) != 490 && GetVehicleModel(GetPlayerVehicleID(playerid)) != 560) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не в полицейской машине");
    if (sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /hackbase [id]");
	if (!PlayerInConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден!");
	new str_[128];
 	if (pInfo[params[0]][pWantedLevel] == 0) return SendClientMessage(playerid, COLOR_GREY, !"Человек не находиться в розыске!");
	format(str_, sizeof str_, "Вы сняли уровни розыска у %s.", pInfo[params[0]][pName]);
	SendClientMessage(playerid, 0x6495EDFF, str_);
	format(str_, sizeof str_, "Мафиози %s снял с Вас уровни розыска.", pInfo[playerid][pName]);
	SendClientMessage(params[0], 0x6495EDFF, str_);
	pInfo[params[0]][pWantedLevel] = 0;
	SetPlayerWantedLevelEx(params[0], pInfo[params[0]][pWantedLevel]);

	if (pInfo[params[0]][pMember] == pInfo[playerid][pMember])
		OnPlayerQuestProgress(playerid, QUEST_MAFIA, QUEST_TASK_HACKBASE);
	return 1;
}
CMD:tie(playerid, params[])
{
    if (!IsAMafia(playerid)) return 1;
	if (pInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREY, !"Вы должны быть 3 рангом");
	if (sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /tie [id]");
	if (!PlayerInConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден!");
	if (pTemp[params[0]][PlayerTied]) return SendClientMessage(playerid, COLOR_GREY, !"Человек уже связан!");
	if (!IsPlayerInRangeOfPlayer(8.0, playerid, params[0])) return 1;
	new car = GetPlayerVehicleID(playerid),
		str_[64];
	if (params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, !"Нельзя связать самого себя!");
	if (IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == 2 && IsPlayerInVehicle(params[0], car))
	{
		format(str_, sizeof str_, "Вас связал %s.",pInfo[playerid][pName]);
		SendClientMessage(params[0], 0x6495EDFF, str_);
		format(str_, sizeof str_, "%s связал %s", pInfo[playerid][pName] ,pInfo[params[0]][pName]);
		SendBeside(playerid,COLOR_PURPLE, str_,30.0);
		TogglePlayerControllable(params[0], 0);
		TieTime[params[0]] = 300;
		pTemp[params[0]][PlayerTied] = true;
		if (pInfo[params[0]][pMember] != pInfo[playerid][pMember]) {
			OnPlayerQuestProgress(playerid, QUEST_MAFIA, QUEST_TASK_MAFIA_TIE);//QUEST_TASK_PD_PATRUL
		}
			
	}
	else return SendClientMessage(playerid, COLOR_GREY, !"Человек не в машине!");
	return 1;
}
CMD:debtors(playerid, params[])
{
    if (!IsAMafia(playerid)) return 1;
	if (pInfo[playerid][pRank] < 6) return SendClientMessage(playerid, COLOR_GREY, !"Вы должны быть 6 рангом");
	SendClientMessage(playerid, COLOR_YELLOW2, "Должники:");
	new string_[100];
	foreach(new i: PlayerInLogin)
	{
		if (pInfo[i][pKrisha] == pInfo[playerid][pMember] && pInfo[i][pMember] == 0)
		{
			format(string_, sizeof string_, "Должник: %s | Долг: %s",pInfo[i][pName],pInfo[i][pDolg]);
			SendClientMessage(playerid, COLOR_WHITE, string_);
		}
	}
	return 1;
}
CMD:untie(playerid, params[])
{
    if (!IsAMafia(playerid) && pInfo[playerid][pMember] != 2) return 1;
	if (pInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREY, !"Вы должны быть 3 рангом");
	if (sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /untie [id]");
	if (!PlayerInConnected(params[0]) || playerid == params[0]) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден!");
	if (!pTemp[params[0]][PlayerTied]) return SendClientMessage(playerid, COLOR_GREY, !"Человек не связан!");
	if (!IsPlayerInRangeOfPlayer(8.0, playerid, params[0])) return 1;
	new string_[64];
	format(string_, sizeof string_, "Вы были развязаны %s.",pInfo[playerid][pName]);
	SendClientMessage(params[0], 0x6495EDFF, string_);
	format(string_, sizeof string_, "%s развязал %s", pInfo[playerid][pName] ,pInfo[params[0]][pName]);
	SendBeside(playerid,COLOR_PURPLE, string_,30.0);
	TogglePlayerControllable(params[0], 1);
	TieTime[params[0]] = 0;
	pTemp[params[0]][PlayerTied] = false;
	return 1;
}
CMD:showpass(playerid, params[])
{
	if (sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /showpass [id]");
	if (!PlayerInConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден!");
    if (!IsPlayerInRangeOfPlayer(8.0, playerid, params[0]) || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return 1;
    new ttext[21];
    if (pTemp[playerid][FBISpyAction] != -1)
	{
		switch(pTemp[playerid][FBISpyAction])
		{
  			case 1: ttext = "LSPD";
	    	case 2: ttext = "ФБР";
		    case 3: ttext = "Армия СФ";
		    case 4: ttext = "Медики СФ";
		    case 0, 5, 6, 12..15, 17, 18, 24..26: ttext = "Неизвестно";
		    case 7: ttext = "Мэрия";
		    case 8: ttext = "Casino";
		    case 9: ttext = "SF News";
		    case 10: ttext = "SFPD";
		    case 11: ttext = "Автошкола";
		    case 16: ttext = "LS News";
		    case 19: ttext = "Армия ЛВ";
		    case 20: ttext = "LV News";
		    case 21: ttext = "LVPD";
		    case 22: ttext = "Медики ЛС";
		    case 23: ttext = "Медики ЛВ";
		}
	}
	else
	{
	    switch(pInfo[playerid][pMember])
		{
  			case 1: ttext = "LSPD";
	    	case 2: ttext = "ФБР";
		    case 3: ttext = "Армия СФ";
		    case 4: ttext = "Медики СФ";
		    case 0, 5, 6, 8, 12..15, 17, 18, 24..26: ttext = "Неизвестно";
		    case 7: ttext = "Мэрия"; 
		    case 9: ttext = "SF News";
		    case 10: ttext = "SFPD";
		    case 11: ttext = "Автошкола";
		    case 16: ttext = "LS News";
		    case 19: ttext = "Армия ЛВ";
		    case 20: ttext = "LV News";
		    case 21: ttext = "LVPD";
		    case 22: ttext = "Медики ЛС";
		    case 23: ttext = "Медики ЛВ";
		}
	}
	new rangz[40];
	if (IsAGang(playerid) || IsAMafia(playerid) || IsABiker(playerid) || !pInfo[playerid][pMember] || pTemp[playerid][FBISpyAction] == 5 || pTemp[playerid][FBISpyAction] == 6
 		|| pTemp[playerid][FBISpyAction] == 12 || pTemp[playerid][FBISpyAction] == 13 || pTemp[playerid][FBISpyAction] == 14 || pTemp[playerid][FBISpyAction] == 15
	  	|| pTemp[playerid][FBISpyAction] == 17 || pTemp[playerid][FBISpyAction] == 18 || pTemp[playerid][FBISpyAction] == 24 || pTemp[playerid][FBISpyAction] == 25
	  	|| pTemp[playerid][FBISpyAction] == 26) rangz = "Неизвестно";
	else strmid(rangz,fFractionRank[pInfo[playerid][pMember]][pInfo[playerid][pRank] - 1], 0, strlen(fFractionRank[pInfo[playerid][pMember]][pInfo[playerid][pRank] - 1]), 32);
	new level = pInfo[playerid][pLevel];
	new string_[256];
	SendClientMessage(params[0], COLOR_YELLOW, "---------===[PASSPORT]===---------");
	format(string_, sizeof string_, "Имя: %s", pInfo[playerid][pName]);
	SendClientMessage(params[0], COLOR_YELLOW2, string_);
	format(string_, sizeof string_, "Возраст: %d",level);
	SendClientMessage(params[0], COLOR_YELLOW2, string_);
	format(string_, sizeof string_, "Телефон: %d",pInfo[playerid][PlayerNumber]);
	SendClientMessage(params[0], COLOR_YELLOW2, string_);
	format(string_, sizeof string_, "Организация: %s",ttext);
	SendClientMessage(params[0], COLOR_YELLOW2, string_);
	format(string_, sizeof string_, "Должность: %s",rangz);
	SendClientMessage(params[0], COLOR_YELLOW2, string_);
	format(string_, sizeof string_, "Работа: %s",gJobNames[pInfo[playerid][pJob]]);
	SendClientMessage(params[0], COLOR_YELLOW2, string_);

	if (pInfo[playerid][pHouseID] != -1) {
		format(string_, sizeof string_, "Дом №%d", pInfo[playerid][pHouseID]); 
		SendClientMessage(params[0], COLOR_YELLOW2, string_);
	}  
	if (pInfo[playerid][pRentHouse] != -1) {
		format(string_, sizeof string_, "Прописка в доме №%d", pInfo[playerid][pRentHouse]); 
		SendClientMessage(params[0], COLOR_YELLOW2, string_);
	}  
	format(string_, sizeof string_, "Законопослушность: %d",pInfo[playerid][pZakonp]);
	SendClientMessage(params[0], COLOR_YELLOW2, string_);
	SendClientMessage(params[0], COLOR_YELLOW, "========================");
	if (pInfo[playerid][pWantedLevel] > 0) SendClientMessage(params[0], COLOR_REDD, "Внимание! Этот человек в розыске!"); 
	MeAction(playerid, "показал(a) свой паспорт", SELECT_ACTION_GENERAL); 
	if (IsACopQuest(params[0])) {
		OnPlayerQuestProgress(params[0], QUEST_PD, QUEST_TASK_PD_NEWBIE);
	}
	return 1;
}
CMD:showudost(playerid, params[])
{
    if (!IsACop(playerid)) return 1;
	if (sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_WHITE, !"Введите: /showudost [id]");
	if (!PlayerInConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, !"Человек не найден!");
	if (!IsPlayerInRangeOfPlayer(8.0, playerid, params[0]) || GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return 1;
	new ttext[32];
	if (pInfo[playerid][pMember] == 0) { ttext = "Гражданин"; }
	else if (pInfo[playerid][pMember] == 1) { ttext = "LSPD"; }
	else if (pInfo[playerid][pMember] == 2) { ttext = "ФБР"; }
	else if (pInfo[playerid][pMember] == 10) { ttext = "SFPD"; }
	else if (pInfo[playerid][pMember] == 21) { ttext = "LVPD"; }
	new rank = pInfo[playerid][pRank],
		level = pInfo[playerid][pLevel],
		string_[128];
	format(string_, sizeof string_, "Имя: %s\nТелефон: %d\nВозвраст: %d\nПодразделение: %s\nРанг: %d", pInfo[playerid][pName],pInfo[playerid][PlayerNumber],level,ttext,rank);
	ShowPlayerDialog(params[0], D_NULL, DIALOG_STYLE_MSGBOX, "Удостоверение", string_, "Готово", "");
	format(string_, sizeof string_, "%s показал своё удостоверение %s'у",pInfo[playerid][pName],pInfo[params[0]][pName]);
	SendBeside(playerid,COLOR_PURPLE, string_, 30.0);
	format(string_, sizeof string_, "показал своё удостоверение %s'у",pInfo[params[0]][pName]);
	SetPlayerChatBubble(playerid, string_,COLOR_PURPLE,30.0,10000);
	return 1;
}

stock IsPlayerToGhetto(playerid) {
	return IsPlayerToSquare(playerid, .min_x = 1636.18, .min_y = -2180.56, .max_x = 2930.04, .max_y = -846.89);
}
stock IsPlayerToSquare(playerid,Float:min_x,Float:min_y,Float:max_x,Float:max_y)
{
	new Float:xxp,Float:yyp,Float:zzp;
	GetPlayerPos(playerid,xxp,yyp,zzp);
	if ((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return 1;
	return 0;
}
stock GetPlayerGangZone(playerid)
{
	for(new i = 1; i <= TOTALGZ; i++)
	{
	    if (IsPlayerToSquare(playerid, GZInfo[i][gCoords][0], GZInfo[i][gCoords][1], GZInfo[i][gCoords][2], GZInfo[i][gCoords][3]))
     	{
     	    return i;
     	}
	}
	return -1;
}

stock GetFreeSeat(vehicleid)
{
	if (!vehicleid) return -1;
	new model = GetVehicleModel(vehicleid);
	new maxs = GetMaxSeat(model) - 1;
	new bool:seat[3], cnt;
	foreach(new i: PlayerInLogin)
	{
		if (!pInfo[i][pLogin]) continue;
		if (pTemp[i][PlayerVehicle] != vehicleid) continue;
		new pseat = GetPlayerVehicleSeat(i);
		if (pseat < 1 || pseat > 3) continue;
		seat[pseat-1] = true;
		cnt++;
		if (cnt >= maxs) return -1;
	}
	for(new i; i < 3; i++) if (!seat[i]) return i+1;
	return -1;
}

stock GetMaxSeat(modelid)
{
	switch(modelid)
	{
		case 596..598, 427, 490: return 4;
		case 599, 497, 528: return 2;
	}
	return -1;
}


