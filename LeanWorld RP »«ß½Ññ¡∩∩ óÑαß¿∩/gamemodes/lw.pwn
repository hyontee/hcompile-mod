alias:diskjokey("dj");
cmd:diskjokey(playerid)
{
	if(PI[playerid][pJob] != 4) return ErrorMessage(playerid, "Вы не работаете Диджеем.");
	if(!PlayerToPoint(2, playerid, 1056.5503, -13.5629, 979.3359)) return ErrorMessage(playerid, "Вы не у стойки для DJ.");
	if(AlhambraDJID == INVALID_PLAYER_ID) AlhambraDJ = true, AlhambraDJID = playerid;
	else if(AlhambraDJID != playerid) return ErrorMessage(playerid, "DJ уже работает и он находиться в клубе.");
	ShowPlayerDialog(playerid, 5350, DIALOG_STYLE_LIST, ""SERVER"Панель управления DJ.", ""WHITE"Включить свой трек\nВыключить музыку\nОставить пульт", "Выбрать", "Отмена");
	return 1;
}
GetEngineStat(vehicleid)
{
	new engine, lights, alarm, doors, bonnet, boot, objective;
	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	return engine;

}
stock ToggleLock(vehicleid, bool:door_status = false, playerid)
{
    VehInfo[vehicleid-1][vLock] = door_status;
    foreach(Player, i) SetVehicleParamsForPlayer(vehicleid, i, 0, (door_status) ? (true) : (false));
    GameTextForPlayer(playerid, (door_status) ? ("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~CAR~r~ LOCK") : ("~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~CAR~g~ UNLOCK"), 4000, 3);
    PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
    return 0;
}
stock ToggleLockNotPlayer(vehicleid, bool:door_status = false)
{
    VehInfo[vehicleid-1][vLock] = door_status;
    foreach(Player, i) SetVehicleParamsForPlayer(vehicleid, i, 0, (door_status) ? (true) : (false));
    return 0;
}
cmd:dlock(playerid, params[])
{
    if(PI[playerid][pCar][0] != 508) return ErrorMessage(playerid, "Вам недоступна данная команда.");
   	new Float:PosCar_Lock[5][3];
	if(caridhouse[playerid][0]) GetVehiclePos(caridhouse[playerid][0], PosCar_Lock[0][0], PosCar_Lock[0][1], PosCar_Lock[0][2]);
    if(PlayerToPoint(3.0, playerid, PosCar_Lock[0][0], PosCar_Lock[0][1], PosCar_Lock[0][2])) ToggleLock(caridhouse[playerid][0], !VehInfo[caridhouse[playerid][0]-1][vLock],playerid);
	new doorstatus[2][] =
	{
		{""GREEN"Открыт"},
		{"{FF0000}Закрыт"}
	};

	new str[500];
	format(str, sizeof(str), ""WHITE"Дом на колёсах\n"WHITE"Владелец: "GREEN"%s\n"WHITE"Статус: %s",PI[playerid][pNames], doorstatus[VehInfo[caridhouse[playerid][0]-1][vLock]]);
	UpdateDynamic3DTextLabelText(VehInfo[caridhouse[playerid][0]][vTrailerDom3d], -1, str);
	return 1;
}
cmd:lock(playerid, params[])
{
	if(!PI[playerid][pLogin]) return 1;
	if(PI[playerid][pCar][0] == 508) return ErrorMessage(playerid, "У вас дом на колёсах. Чтобы открыть / закрыть дом на колесах введите: /dlock");
	if(sscanf(params, "d", params[0]))
	{
		SendClientMessage(playerid, COLOR_WHITE, "Введите: /lock [тип] (1 - 2)");
		SendClientMessage(playerid, COLOR_WHITE, ""SERVER"#1"WHITE" - [Домашний транспорт, воздушный транспорт, водный транспорт]");
		SendClientMessage(playerid, COLOR_WHITE, ""SERVER"#2"WHITE" - [Фракционный транспорт, рабочий транспорт]");
		return 1;
	}
	new Float:PosCar_Lock[5][3];
	if(caridhouse[playerid][0]) GetVehiclePos(caridhouse[playerid][0], PosCar_Lock[0][0], PosCar_Lock[0][1], PosCar_Lock[0][2]);
	if(caridhouse[playerid][1]) GetVehiclePos(caridhouse[playerid][1], PosCar_Lock[1][0], PosCar_Lock[1][1], PosCar_Lock[1][2]);
	if(caridhouse[playerid][2]) GetVehiclePos(caridhouse[playerid][2], PosCar_Lock[2][0], PosCar_Lock[2][1], PosCar_Lock[2][2]);
	if(caridhouse[playerid][3]) GetVehiclePos(caridhouse[playerid][3], PosCar_Lock[3][0], PosCar_Lock[3][1], PosCar_Lock[3][2]);
	if((GetPVarInt(playerid, "is_boat") - 1) != -1) GetVehiclePos(GetPVarInt(playerid, "is_boat") - 1, PosCar_Lock[4][0], PosCar_Lock[4][1], PosCar_Lock[4][2]);
	switch(params[0])
	{
		case 1:
		{
			if(PlayerToPoint(3.0, playerid, PosCar_Lock[0][0], PosCar_Lock[0][1], PosCar_Lock[0][2])) ToggleLock(caridhouse[playerid][0], !VehInfo[caridhouse[playerid][0]-1][vLock], playerid);
			else if(PlayerToPoint(3.0, playerid, PosCar_Lock[1][0], PosCar_Lock[1][1], PosCar_Lock[1][2])) ToggleLock(caridhouse[playerid][1], !VehInfo[caridhouse[playerid][1]-1][vLock], playerid);
			else if(PlayerToPoint(3.0, playerid, PosCar_Lock[2][0], PosCar_Lock[2][1], PosCar_Lock[2][2])) ToggleLock(caridhouse[playerid][2], !VehInfo[caridhouse[playerid][2]-1][vLock], playerid);
			else if(PlayerToPoint(4.0, playerid, PosCar_Lock[3][0], PosCar_Lock[3][1], PosCar_Lock[3][2])) ToggleLock(caridhouse[playerid][3], !VehInfo[caridhouse[playerid][3]-1][vLock], playerid);
			else if(PlayerToPoint(4.0, playerid, PosCar_Lock[4][0], PosCar_Lock[4][1], PosCar_Lock[4][2])) ToggleLock(GetPVarInt(playerid, "is_boat")-1, !VehInfo[(GetPVarInt(playerid, "is_boat") - 1) - 1][vLock], playerid);
		}
		case 2:
		{
			GetVehiclePos(GetNearestVehicle(playerid), PosCar_Lock[0][0], PosCar_Lock[0][1], PosCar_Lock[0][2]);
			if(PlayerToPoint(4.0, playerid, PosCar_Lock[0][0], PosCar_Lock[0][1], PosCar_Lock[0][2]) && GetVehicleKey(playerid, GetNearestVehicle(playerid))) ToggleLock(GetNearestVehicle(playerid), !VehInfo[GetNearestVehicle(playerid)-1][vLock], playerid);
		}
		default: return 1;
	}
	return 1;
}
alias:directory("dir");
cmd:directory(playerid) return ShowPlayerDialog(playerid, 5454, DIALOG_STYLE_LIST, ""SERVER"Справочник", ""WHITE"[0] Адвокаты\n[1] Крупье\n[2] Лидеры организаций\n[3] Инструкторы\n[4] Механики\n[5] Медики\n[6] Развозчики бензина\n[7] Проститутки", "Выбрать", "Отмена");
