			return true;

		ShowPlayerDialog(playerid, 1001, DIALOG_STYLE_LIST, ""SERVER"Панель Администратора", "\
		"SERVER"1. "WHITE"Команды администратора\n\
		"SERVER"2. "WHITE"Меню администратора\n\
		"SERVER"3. "WHITE"Магазин администратора\n\
