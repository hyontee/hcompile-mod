alias:ask("question");
cmd:ask(playerid, params[])
{
	new server_tick = GetTickCount(),
		message[144];

	if(PI[playerid][pMuteTime] || PI[playerid][pRepMuteTime])
		return ErrorMessage(playerid, "У Вас заблокирован чат, Вы не можете его использовать.");

	if(GetPVarInt(playerid, "CmdTime:Ask") > server_tick)
		return SendClientMessage(playerid, -1, ""net"Вы слишком часто используете данную команду, подождите.");

	if(sscanf(params, "s[128]", params[0]))
		return SendClientMessage(playerid, -1, ""information"Введите: /ask(question) [ текст ]");

	format(message, sizeof message, "{0CD600}[Вопрос] %s[%d]: {FFBE00}%s.", PI[playerid][pNames], playerid, params[0]);
	SendSupportsMessage(0xEE5555FF, message);

	SendClientMessage(playerid, -1, ""good"Вы успешно отправили запрос операторам поддержки.");

	format(message, sizeof message, ""information"Текст вопроса: {EE5555}%s", params[0]);
	SendClientMessage(playerid, -1, message);

	SetPVarInt(playerid, "CmdTime:Ask", server_tick + 60000);
	return true;
}

alias:radiob("rb");
cmd:radiob(playerid, params[])
{
	if(!IsACop(playerid) && !IsAArm(playerid) && !IsAMayor(playerid) && !IsAMedic(playerid) && PI[playerid][pMember] != 26 && PI[playerid][pMember] != 11 && PI[playerid][pMember] != 16) return ErrorMessage(playerid, "У вас нету рации");
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день");
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "(/rb)adiob [текст]");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		if(StartRabWork(playerid)) SetPVarInt(playerid, "StartRabWork", 0);
		PI[playerid][pMember] = 0;
		PI[playerid][pRank] = 0;
		PI[playerid][pLeader] = 0;
		PI[playerid][pJob] = 0;
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		SetPlayerSkin(playerid, PI[playerid][pChar]);
		SendClientMessage(playerid, COLOR_RED, "Вы были уволены. Если это произошло ошибочно, то пиши Анастасии. НЕ ЗАБУДЬ СКРИН СДЕЛАТЬ!!!");
		string = "";
		format(string, 144, "%s был уволен из фракции за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}
	if(!(PI[playerid][pSettings] & sFractionChat)) return ErrorMessage(playerid, "Включите чат фракции в личных настройках");
	if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У вас бан чата!");
	if(GetPVarInt(playerid, "gag")) return ErrorMessage(playerid, "У Вас кляп, вы не можете говорить!");
	format(string, 164, "[R] (( %s %s[%d]: %s ))", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], playerid, params[0]);
	SendFractionMessage(PI[playerid][pMember], 0x8D8DFFFF, string);
	SendSpyMessage(PI[playerid][pMember], 0xADFFEFFF, string);
	format(string, 64, "сказал(а) в рацию: "WHITE"%s", params[0]);
	SetPlayerChatBubble(playerid, string, COLOR_BLUE1, 15.0, 10000);
	PI[playerid][last_message] = params[0];
	return 1;
}
stock logs(type, text[], money)
{
	if(money == 0)
	{
		new log_str_query[331 + 1];
		format(log_str_query, sizeof(log_str_query), "INSERT INTO `lw_logs` (`lw_type`, `lw_text`, `lw_date`) VALUES ('%d', '%s', NOW())", type, text);
		mysql_tquery(1, log_str_query, "", "");
	}
	else
	{
		new log_str_query[357 + 1];
		format(log_str_query, sizeof(log_str_query), "INSERT INTO `lw_logs` (`lw_type`, `lw_text`, `lw_money`, `lw_date`) VALUES ('%d', '%s', '%d', NOW())", type, text, money);
		mysql_tquery(1, log_str_query, "", "");
	}
	return true;
}
cmd:strobelight(playerid)
{
	new bool: access = false, vehicleid;
	switch(PI[playerid][pMember])
	{
		case 1, 2, 4, 10, 21, 28, 29: access = true;
	}
	if(!access) return ErrorMessage(playerid, "Вам недоступна данная команда.");
	if(!(vehicleid = GetPlayerVehicleID(playerid))) return ErrorMessage(playerid, "Для использован команды, Вам необходимо находиться в транспорте.");
	if(!GetStrobeValidVehicle(vehicleid)) return ErrorMessage(playerid, "Вы не можете использовать данную команду в данном транспорте.");

	new localEngine,
		localLight,
		localOther1,
		localOther2,
		localOther3,
		localOther4,
		localOther5;

	GetVehicleParamsEx(vehicleid, localEngine, localLight, localOther1, localOther2, localOther3, localOther4, localOther5);
	if(strobelight_timer[vehicleid] == -1)
	{
		strobelight_timer[vehicleid] = SetTimerEx("OnVehicleStrobeLight", 250, true, "d", vehicleid);
		SendClientMessage(playerid, -1, ""#information"Вы включили стробоскопы.");

		GetVehicleParamsEx(vehicleid, localEngine, localLight, localOther1, localOther2, localOther3, localOther4, localOther5);
		SetVehicleParamsEx(vehicleid, localEngine, VEHICLE_PARAMS_ON, localOther1, localOther2, localOther3, localOther4, localOther5);
	}
	else
	{
		OnVehicleStrobeTimeOut(vehicleid);
		SendClientMessage(playerid, -1, ""#information"Вы выключили стробоскопы.");
	}

	return 1;
}
forward OnVehicleStrobeTimeOut(vehicleid);
public OnVehicleStrobeTimeOut(vehicleid)
{
	new localPanels,
		localDoors,
		localTires,
		localLights;

	new localEngine,
		localLight,
		localOther1,
		localOther2,
		localOther3,
		localOther4,
		localOther5;

	GetVehicleDamageStatus(vehicleid, localPanels, localDoors, localLights, localTires);
	UpdateVehicleDamageStatus(vehicleid, localPanels, localDoors, 0, localTires);

	GetVehicleParamsEx(vehicleid, localEngine, localLight, localOther1, localOther2, localOther3, localOther4, localOther5);
	SetVehicleParamsEx(vehicleid, localEngine, VEHICLE_PARAMS_OFF, localOther1, localOther2, localOther3, localOther4, localOther5);

	strobelight_flash{vehicleid} = 0;

	if(strobelight_timer[vehicleid])
	{
		KillTimer(strobelight_timer[vehicleid]);
		strobelight_timer[vehicleid] = -1;
	}

	if(strobelight_time_out[vehicleid])
	{
		KillTimer(strobelight_time_out[vehicleid]);
		strobelight_time_out[vehicleid] = -1;
	}
	return 1;
}
forward OnVehicleStrobeLight(vehicleid);
public OnVehicleStrobeLight(vehicleid)
{
	new localPanels,
		localDoors,
		localTires,
		localLights;

	GetVehicleDamageStatus(vehicleid, localPanels, localDoors, localLights, localTires);

	switch(strobelight_flash{vehicleid})
	{
		case 0: UpdateVehicleDamageStatus(vehicleid, localPanels, localDoors, 2, localTires);
		case 1: UpdateVehicleDamageStatus(vehicleid, localPanels, localDoors, 5, localTires);
		case 2: UpdateVehicleDamageStatus(vehicleid, localPanels, localDoors, 2, localTires);
		case 3: UpdateVehicleDamageStatus(vehicleid, localPanels, localDoors, 4, localTires);
		case 4: UpdateVehicleDamageStatus(vehicleid, localPanels, localDoors, 5, localTires);
		case 5: UpdateVehicleDamageStatus(vehicleid, localPanels, localDoors, 4, localTires);
	}
	strobelight_flash{vehicleid}++;
	if(strobelight_flash{vehicleid} > 5) strobelight_flash{vehicleid} = 0;
	return 1;
}
GetStrobeValidVehicle(vehicleid)
{
	if(MedCar[0] <= vehicleid <= MedCar[1]) return 1;
	else if(sapdpatrul[0] <= vehicleid <= sapdpatrul[1]) return 1;
	else if(sapdcar[0] <= vehicleid <= sapdcar[1]) return 1;
	else if(fbicar[0] <= vehicleid <= fbicar[1]) return 1;
	return 0;
}
alias:clearchatme("ccme");
cmd:clearchatme(playerid)
{
