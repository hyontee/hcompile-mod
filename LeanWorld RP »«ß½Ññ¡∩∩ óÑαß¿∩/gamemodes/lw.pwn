	    else gTeleportsAreaID[i][0] = CreatePickup(19132, 1, gTeleportsCoords[i][0][0], gTeleportsCoords[i][0][1], gTeleportsCoords[i][0][2], gTeleportsCoordsInformation[i][0][0]);
