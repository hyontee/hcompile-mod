	else if(PI[playerid][pMember] == 2 &&  PI[playerid][pRank] >= 2)
	{
		if(GetPlayerVehicleID(VehicleEnters[playerid]) >= fbicar[0] && GetPlayerVehicleID(VehicleEnters[playerid]) <= fbicar[4]) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не в машине FBI");
		format(string, 64, "Вы сняли уровни розыска у %s.", PI[params[0]][pNames]);
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		format(string, 64, "* Агент ФБР %s зашёл в базу данных", PI[playerid][pNames]);
