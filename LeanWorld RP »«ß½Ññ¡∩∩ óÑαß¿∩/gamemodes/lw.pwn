publics: OnPlayerCaptchaLoaded(playerid)
{
	new rows,fields;
	cache_get_data(rows,fields);
	if(!rows) return 1;
	new string_strcat[700], status[32], ip[32], _date[32];
	for(new z; z < rows; z ++)
	{
		cache_get_field_content(z, "clIP", ip);
		cache_get_field_content(z, "clDate", _date);
		cache_get_field_content(z, "clStatus", status);
		format(string_strcat, sizeof(string_strcat), ""WHITE"%d. Дата: %s | IP: %s - %s\n", z+1, _date, ip, (strval(status) ? ("{09B000}Удачно"WHITE"") : ("{FF0000}Неудачно"WHITE"")));
	}
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Информация о вводах капчи", string_strcat, "Принять", "");
	return 1;
}
UpdateFractionStore(fracid)
{
	mysql_format(1, string, 512, "UPDATE `fractions_store` SET `frac_money` = '%d', `frac_materials` = '%d', `frac_heal` = '%d' WHERE `id` = '%d'", frac_money[fracid], frac_materials[fracid], frac_heal[fracid], fracid);
	mysql_tquery(1, string);
	return 1;
}
stock Float:GetDistanceBetweenPlayers(p1, p2)
{
	new
		Float: X,
		Float: Y,
		Float: Z,
		Float: X_2,
		Float: Y_2,
		Float: Z_2;

	if(!IsPlayerConnected(p1) || !IsPlayerConnected(p2))
		return -1.00;

	GetPlayerPos(p1, X, Y, Z);
	GetPlayerPos(p2, X_2, Y_2, Z_2);
	return floatsqroot(floatpower(floatabs(floatsub(X_2, X)), 2) + floatpower(floatabs(floatsub(Y_2, Y)), 2) + floatpower(floatabs(floatsub(Z_2, Z)), 2));
}
stock Float: GetDistanceBetweenPoints(Float: x, Float: y, Float: z, Float: x_2, Float: y_2, Float: z_2)
{
	new
		Float: Distancee;

	Distancee = floatabs(floatsub(x, x_2)) + floatabs(floatsub(y, y_2)) + floatabs(floatsub(z, z_2));
 	return Distancee;
}
ISAMAFIA(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	return((PI[playerid][pMember]==5 || PI[playerid][pMember]==6 || PI[playerid][pMember]==14) || PI[playerid][pLeader]==5|| PI[playerid][pLeader]==6 || PI[playerid][pLeader]==14) ?true:false;
}
IsAGang(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	return ((PI[playerid][pMember]==12 || PI[playerid][pMember]==13 || PI[playerid][pMember]==15 || PI[playerid][pMember]==17 || PI[playerid][pMember]==18) || PI[playerid][pLeader]==12 || PI[playerid][pLeader]==13 || PI[playerid][pLeader]==15 || PI[playerid][pLeader]==17 || PI[playerid][pLeader]==18) ?true:false;
}
UpdateIconHouse(h)
{
    DestroyDynamicMapIcon(HouseInfo[h][hMIcon]);

	if(!HouseInfo[h][hOwned])
	{
		DestroyPickup(HouseInfo[h][hPickup]);
		HouseInfo[h][hPickup] = CreatePickup(1273, 23, HouseInfo[h][hEnter][0], HouseInfo[h][hEnter][1], HouseInfo[h][hEnter][2], 0);
		HouseInfo[h][hMIcon] = CreateDynamicMapIcon(HouseInfo[h][hEnter][0], HouseInfo[h][hEnter][1], HouseInfo[h][hEnter][2], 31, COLOR_WHITE, 0, -1, -1, 200.0);
		format(string, 215, "\
		"SERVER"Стоимость: "GREEN"$%d\n\n\
		"SERVER"Класс: "WHITE"%s\n\
		"SERVER"Гараж: "WHITE"%s\n\n\
		"SERVER"Номер дома: "WHITE"%d", HouseInfo[h][hValue], GetHouseClass[HouseInfo[h][hKlass]], (HouseInfo[h][hGarage]?("Есть"):("Нет")), HouseInfo[h][hID]);
		UpdateDynamic3DTextLabelText(HouseInfo[h][LabelText][1], -1, string);
	}
	else
	{
		DestroyPickup(HouseInfo[h][hPickup]);
		HouseInfo[h][hPickup] = CreatePickup(1272, 23, HouseInfo[h][hEnter][0], HouseInfo[h][hEnter][1], HouseInfo[h][hEnter][2], 0);
		HouseInfo[h][hMIcon] = CreateDynamicMapIcon(HouseInfo[h][hEnter][0], HouseInfo[h][hEnter][1], HouseInfo[h][hEnter][2], 32, COLOR_WHITE, 0, -1, -1, 200.0);
		format(string, 215, "\
		"SERVER"Владелец: "WHITE"%s\n\n\
		"SERVER"Класс: "WHITE"%s\n\
		"SERVER"Гараж: "WHITE"%s\n\n\
		"SERVER"Номер дома: "WHITE"%d", HouseInfo[h][hOwner], GetHouseClass[HouseInfo[h][hKlass]], (HouseInfo[h][hGarage]?("Есть"):("Нет")), HouseInfo[h][hID]);
		UpdateDynamic3DTextLabelText(HouseInfo[h][LabelText][1], -1, string);
	}
	return 1;
}

