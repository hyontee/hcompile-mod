	PI[playerid][pCarCash][1] = cache_get_field_content_int(0, "pCarCash2");
	PI[playerid][pCarCash][2] = cache_get_field_content_int(0, "pCarCash3");
	PI[playerid][pLomka] = cache_get_field_content_int(0, "pLomka");
	PI[playerid][P_AntiRadar] = cache_get_field_content_int(0, "P_AntiRadar");
	PI[playerid][pFuelCar] = cache_get_field_content_int(0, "pFuelCar");
	PI[playerid][pRem] = cache_get_field_content_int(0, "pRem");
	PI[playerid][pUsedPromo] = cache_get_field_content_int(0, "pUsedPromo");
	PI[playerid][pUsedKek] = cache_get_field_content_int(0, "pUsedKek");
	PI[playerid][pHealing] = cache_get_field_content_int(0, "pApteka");
	cache_get_field_content(0, "pPrefix", PI[playerid][pPrefix], 1, 60);
	PI[playerid][pWeather] = cache_get_field_content_int(0, "pWeather");
	PI[playerid][pImmunity] = bool:cache_get_field_content_int(0, "pImmunity");
	PI[playerid][pChests] = cache_get_field_content_int(0, "pChests");
	PI[playerid][pAnimDraw] = cache_get_field_content_int(0, "pAnimDraw");
	PI[playerid][pNastr] = cache_get_field_content_int(0, "pGhettoShow");
	PI[playerid][pSpawnGun] = cache_get_field_content_int(0, "pSpawnGun");
	PI[playerid][pPistolTime] = cache_get_field_content_int(0, "pPistolTime");
	PI[playerid][pNarcoLomka] = cache_get_field_content_int(0, "pNarcoLomka");
	cache_get_field_content(0, "Description", PI[playerid][pDescription], 1, 150);
	cache_get_field_content(0,"acessories",PI[playerid][pSlotItems], 1, 64), sscanf(PI[playerid][pSlotItems], "p<,>a<i>[6]",PI[playerid][pSlotItem]);

	new adm_query_str[61 + 1];
	mysql_format(1, adm_query_str, sizeof adm_query_str, "SELECT * FROM `admin` WHERE Name = '%s'", PI[playerid][pNames]);
	mysql_tquery(1, adm_query_str, "GetAdminLevel", "ds", playerid, PI[playerid][pNames]);

	if(PI[playerid][pBusiness] != -1)
	{
		if(strcmp( BizInfo[ PI[playerid][pBusiness] ][ bOwner ], PI[playerid][pNames] ) != 0)
		{
		    PI[playerid][pBusiness] = -1;
		    UpdatePlayerData(playerid, "pPbiskey", -1);
		}
	}
	for(new i = 0; i < sizeof(GZInfo); i++)
	{
		if(PI[playerid][pNastr] == 0) GangZoneShowForPlayer(playerid, GZInfo[i][gID], GetGangZoneColor(i));
		if(i<3) GangZoneShowForPlayer(playerid, ZonsWar[i],  0x00FF7FAA);
	}

	PI[playerid][pPassport] = true;
	switch(cache_get_field_content_int(0, "pText"))
	{
		case 1:
		{
			SendClientMessage(playerid, COLOR_LIGHTRED, "Ваш дом был продан государству, за неактив более 3-ёх дней.");
			UpdatePlayerData (playerid, "pText", 0);
		}
		case 2:
		{
			SendClientMessage(playerid, COLOR_LIGHTRED, "Вы были выселены из дома, за неактив более 3-ёх дней.");
			UpdatePlayerData (playerid, "pText", 0);
		}
		case 3:
		{
			SendClientMessage(playerid, COLOR_LIGHTRED, "Ваш бизнес был продан государству, за неактив более 3-ёх дней.");
			UpdatePlayerData (playerid, "pText", 0);
		}
		case 4:
		{
			SendClientMessage(playerid, COLOR_LIGHTRED, "Ваша заправочная станция была продан государству, за неактив более 3-ёх дней.");
			UpdatePlayerData (playerid, "pText", 0);
		}
		case 5:
		{
		    SCMF(playerid, -1, ""#information"Вы продали один из своих автомобилей на автоярмарке за %i$", cache_get_field_content_int(0, "SellCarMoney"));
		    Hook_GivePlayerMoney(playerid, cache_get_field_content_int(0, "SellCarMoney"));
		    UpdatePlayerData (playerid, "pText", 0), UpdatePlayerData (playerid, "SellCarMoney", 0);
		}
	}
	new l_guns [ 56 ], l_ammo [ 56 ];
	cache_get_field_content(0, "p_guns", l_guns, 1, 56 ) ;
	cache_get_field_content(0, "p_ammo", l_ammo, 1, 56 ) ;

	new g_data[ 13 ], a_data [ 13 ] ;
	sscanf ( l_guns, "p<,>a<i>[13]", g_data ) ;
	sscanf ( l_ammo, "p<,>a<i>[13]", a_data ) ;
	SetPVarInt(playerid, "BMRPG", 0);
	for(new i; i < 13; i ++) if(g_data[i])
	{
		GivePlayerWeapon(playerid, g_data [ i ], a_data [ i ]);
		if(g_data [ i ] == WEAPON_ROCKETLAUNCHER && a_data [i] == 1) SetPVarInt(playerid, "BMRPG", 1);
        SetPVarInt(playerid, "GunLoading", 1);
	}
	cache_get_field_content(0, "pMebel", string, 1, 80);
	sscanf(string, "p<,>iiiiiiiiiiiiiiii", PI[playerid][pMebel][0], PI[playerid][pMebel][1], PI[playerid][pMebel][2], PI[playerid][pMebel][3], PI[playerid][pMebel][4],
	PI[playerid][pMebel][5], PI[playerid][pMebel][6], PI[playerid][pMebel][7], PI[playerid][pMebel][8], PI[playerid][pMebel][9], PI[playerid][pMebel][10],
	PI[playerid][pMebel][11], PI[playerid][pMebel][12], PI[playerid][pMebel][13], PI[playerid][pMebel][14], PI[playerid][pMebel][15]);

	cache_get_field_content(0, "pMebelObject", string, 1, 128);
	sscanf(string, "p<,>iiiiiiiiiiiiiiii", PI[playerid][pMebelObject][0], PI[playerid][pMebelObject][1], PI[playerid][pMebelObject][2], PI[playerid][pMebelObject][3], PI[playerid][pMebelObject][4],
	PI[playerid][pMebelObject][5], PI[playerid][pMebelObject][6], PI[playerid][pMebelObject][7], PI[playerid][pMebelObject][8], PI[playerid][pMebelObject][9], PI[playerid][pMebelObject][10],
	PI[playerid][pMebelObject][11], PI[playerid][pMebelObject][12], PI[playerid][pMebelObject][13], PI[playerid][pMebelObject][14], PI[playerid][pMebelObject][15]);

	if(PI[playerid][pKeylog])
	{
		SendClientMessage(playerid, 0x17D4AEFF, "{17D4AE}[Система безопасности]"WHITE" Чтобы завершить стадию авторизации, вам необходимо пройти проверку.");
		SendClientMessage(playerid, 0x17D4AEFF, "{17D4AE}[Система безопасности]"WHITE" Для этого кликайте на цифры, которые вы указали в коде безопасности.");
		for(new i = 0, cindex = 0; i < sizeof(Captcha); i++)
		{
			if(i == 0)
			{
				Captcha[i] = CreatePlayerTextDraw(playerid, 321.0, 80.0, "SECURITY CODE:");
				PlayerTextDrawUseBox(playerid, Captcha[i], 1);
				PlayerTextDrawBoxColor(playerid, Captcha[i], 0x000000AA);
				PlayerTextDrawTextSize(playerid, Captcha[i], 800.0, 200.0);
			}
			if(i == 1)
			{
				Captcha[i] = CreatePlayerTextDraw(playerid, 321.0, 303.0, "-----");
				PlayerTextDrawUseBox(playerid, Captcha[i], 1);
				PlayerTextDrawBoxColor(playerid, Captcha[i], 0x000000AA);
				PlayerTextDrawTextSize(playerid, Captcha[i], 800.0, 200.0);
			}
			if(i > 1)
			{
				string = "";
				format(string, 128, "%c", TextArray[i - 2]);
				if(i >= 2) Captcha[i] = CreatePlayerTextDraw(playerid, 280.0 + (41.0 * cindex), 130.0, string);
				if(i == 5) cindex = 0, Captcha[i] = CreatePlayerTextDraw(playerid, 280.0 + (41.0 * cindex), 171.0, string);
				if(i > 5) Captcha[i] = CreatePlayerTextDraw(playerid, 280.0 + (41.0 * cindex), 171.0, string);
				if(i == 8) cindex = 0, Captcha[i] = CreatePlayerTextDraw(playerid, 280.0 + (41.0 * cindex), 212.0, string);
				if(i > 8) Captcha[i] = CreatePlayerTextDraw(playerid, 280.0 + (41.0 * cindex), 212.0, string);
				if(i == 11) cindex = 0, Captcha[i] = CreatePlayerTextDraw(playerid, 321.5 + (41.0 * cindex), 253.0, string);
				if(i > 11) Captcha[i] = CreatePlayerTextDraw(playerid, 321.5 + (41.0 * cindex), 253.0, string);
				PlayerTextDrawUseBox(playerid, Captcha[i], 1);
				PlayerTextDrawBoxColor(playerid, Captcha[i], 102);
				PlayerTextDrawTextSize(playerid, Captcha[i], 29.0, 29.0);
				PlayerTextDrawSetSelectable(playerid, Captcha[i], 1);
				cindex++;
			}
			PlayerTextDrawLetterSize(playerid, Captcha[i], 0.50, 2.5);
			PlayerTextDrawAlignment(playerid, Captcha[i], 2);
			PlayerTextDrawSetOutline(playerid, Captcha[i], 1);
			PlayerTextDrawShow(playerid, Captcha[i]);
			SelectTextDraw(playerid, 0xFDE39DFF);
		}
		SetPVarInt(playerid,"ShowKey",true);
	}
	else LoadPlayerAccount(playerid);
	return 1;
}
LoadPlayerAccount(playerid)
{
	ResetPlayerMoney(playerid);
	SetPlayerSkills(playerid);
	SetPlayerVirtualWorld(playerid, 0);
	string = "";
	Hook_GivePlayerMoney(playerid, PI[playerid][pCash]);
	if(PI[playerid][pCash] <= 0) PI[playerid][pCash] = 0;
	else if(PI[playerid][pCar][0] < 401) PI[playerid][pCar][0] = 510, UpdatePlayerData(playerid, "pCar", 510);
	else if(PI[playerid][pCar][1] < 401) PI[playerid][pCar][1] = 510, UpdatePlayerData(playerid, "pCar2", 510);
	else if(PI[playerid][pCar][2] < 401) PI[playerid][pCar][2] = 510, UpdatePlayerData(playerid, "pCar3", 510);
	else if(PI[playerid][pWanted] > 6)
	{
		PI[playerid][pWanted] = 6;
		UpdatePlayerData(playerid, "pWanted", PI[playerid][pWanted]);
	}
	else if(!PI[playerid][pChar]) PI[playerid][pChar] = 230, UpdatePlayerData(playerid, "pChar", PI[playerid][pChar]);
	else if(!PI[playerid][pModel]) PI[playerid][pModel] = 230, UpdatePlayerData(playerid, "pModel", PI[playerid][pModel]);
	else if(PI_MP_START{playerid}) GiveStatus_MP(playerid, GetPVarInt(playerid, "PI_MP_Staus"));
	else if(PI[playerid][pMember]) SetPlayerSkin(playerid, PI[playerid][pModel]);
	else SetPlayerSkin(playerid, PI[playerid][pChar]);
	if(PI[playerid][pHouse] != -1 && PI[playerid][pHouse] < MAX_HOUSE)
	{
		if(!strcmp(PI[playerid][pNames], HouseInfo[PI[playerid][pHouse]][hOwner], true))
		{
		    SCMF(playerid, COLOR_SERVER, "Вы проживаете в доме номер: "WHITE"%i", PI[playerid][pHouse]);
			mysql_format(1, string, 164, "UPDATE `house` SET `h_online` = '%i' WHERE `hOwner` = '%e'", getdate(), PI[playerid][pNames]);
			mysql_tquery(1, string);
			if(HouseInfo[PI[playerid][pHouse]][hGarage])
			{
			    LoadCarPlayer(playerid, 1);
			    LoadCarPlayer(playerid, 2);
			    LoadCarPlayer(playerid, 3);
			}
			else LoadCarPlayer(playerid, 1);
		}
		else PI[playerid][pHouse] = -1, UpdatePlayerData(playerid, "pPhousekey", -1);
	}
	if(PI[playerid][pArendaHouse] != -1)
	{
		if(!strcmp(PI[playerid][pNames], HouseInfo[PI[playerid][pArendaHouse]][hRent], true))
		{
			SCMF(playerid, COLOR_SERVER, "Вы проживаете в доме номер: "WHITE"%d | Жильцом №1", PI[playerid][pArendaHouse]);
			mysql_format(1, string, 164, "UPDATE `house` SET `h_online_arendator` = '%i' WHERE `hRent` = '%e'", getdate(), HouseInfo[PI[playerid][pArendaHouse]][hRent]);
			mysql_tquery(1, string);
			LoadCarPlayer(playerid, 1);
		}
		if(!strcmp(PI[playerid][pNames], HouseInfo[PI[playerid][pArendaHouse]][hRent1], true))
		{
			SCMF(playerid, COLOR_SERVER, "Вы проживаете в доме номер: "WHITE"%d | Жильцом №2", PI[playerid][pArendaHouse]);
			mysql_format(1, string, 164, "UPDATE `house` SET `h_online_arendator_1` = '%i' WHERE `hRent1` = '%e'", getdate(), HouseInfo[PI[playerid][pArendaHouse]][hRent1]);
			mysql_tquery(1, string);
			LoadCarPlayer(playerid, 1);
		}
	}
	if(PI[playerid][pBusiness] != -1)
	{
		if(!strcmp(BizInfo[PI[playerid][pBusiness]][bOwner], PI[playerid][pNames], true))
		{
			SCMF(playerid, COLOR_SERVER, "Вы являетесь владельцем бизнеса: "WHITE"%s", BizInfo[PI[playerid][pBusiness]][bName]);
			mysql_format(1, string, 164, "UPDATE `business` SET `h_online` = '%i' WHERE `bOwner` = '%e'", getdate(), PI[playerid][pNames]);
			mysql_tquery(1, string);
		}
	}
	if(PI[playerid][pFilling] != -1)
	{
		if(!strcmp(Filling[PI[playerid][pFilling]][fOwner], PI[playerid][pNames], true))
		{
			SCMF(playerid, COLOR_SERVER, "Вы являетесь владельцем заправки номер: "WHITE"%i", PI[playerid][pFilling]);
			mysql_format(1, string, 164, "UPDATE `filling` SET `f_online` = '%i' WHERE `fOwner` = '%e'", getdate(), PI[playerid][pNames]);
			mysql_tquery(1, string);
		}
	}
	if(player_family[playerid])
	{
		family_info[player_family[playerid]][f_online]++;
		SetPVarInt(playerid, "family_name_color", family_info [ player_family [ playerid ] ] [ f_name_color ]);
		SCMF(playerid, COLOR_SERVER, "Вы состоите в семье: "WHITE"%s.",family_info [ player_family [ playerid ] ] [ f_name ]);
	}
	if(PI[playerid][pWarns])
	{
	    if(PI[playerid][punWarnstime] > unix)
	    {
		    format(string, 164, "[Внимание]: "WHITE"У вас {"#cRED"}%d"WHITE" предупреждени%s. Дата снятия предупреждений: {"#cRED"}%s", PI[playerid][pWarns], (PI[playerid][pWarns]<=1) ? ("е"):("я"), date("%dd/%mm/%yyyy в %hh:%ii", PI[playerid][punWarnstime]));
			SendClientMessage(playerid, CRED, string);
		}
		else if(PI[playerid][punWarnstime] <= unix)
		{
		    SendClientMessage(playerid, COLOR_SERVER, " У Вас снято одно преждупрежение!");
		    PI[playerid][punWarnstime] = 0;
		    PI[playerid][pWarns] = 0;
		    UpdatePlayerData(playerid, "pWarns", 0);
		    UpdatePlayerData(playerid, "punWarnstime", 0);
		}
	}
	if(PI[playerid][pCar][0] == 508)
	{
		caridhouse[playerid][0] = CreateVehicle(PI[playerid][pCar][0], PI[playerid][CarPos][0], PI[playerid][CarPos][1], PI[playerid][CarPos][2], PI[playerid][CarPos][3], PI[playerid][CarColor], PI[playerid][CarColor], 36000);
		SetVehicleNumberPlate(caridhouse[playerid][0], NumberVehicle[playerid][0]);
  		ToggleLockNotPlayer(caridhouse[playerid][0], !VehInfo[caridhouse[playerid][0]-1][vLock]);

		if (IsValidDynamic3DTextLabel(VehInfo[caridhouse[playerid][0]][vTrailerDom3d]))
			DestroyDynamic3DTextLabel(VehInfo[caridhouse[playerid][0]][vTrailerDom3d]);
		VehInfo[caridhouse[playerid][0]][vTrailerDom3d] = CreateDynamic3DTextLabel("",-1, 0.0, 0.0, 0.0, 7.0, INVALID_PLAYER_ID, caridhouse[playerid][0], 1, 0, 0);
		new doorstatus[2][] =
		{
			{""GREEN"Открыт"},
			{"{FF0000}Закрыт"}
		};

		new str[500];
		format(str, sizeof(str), ""WHITE"Дом на колёсах\n"WHITE"Владелец: "GREEN"%s\n"WHITE"Статус: %s",PI[playerid][pNames], doorstatus[VehInfo[caridhouse[playerid][0]-1][vLock]]);
		UpdateDynamic3DTextLabelText(VehInfo[caridhouse[playerid][0]][vTrailerDom3d], -1, str);
	}

	new playersip[16];
	new year, month, day;
	getdate(year, month, day);
	GetPlayerIp(playerid, playersip, sizeof(playersip));
	mysql_format(1, string, sizeof(string), "UPDATE `accounts` SET `pGetonDate` = '%d/%d/%d', `pGetonIP` = '%e' WHERE `id` = '%d' LIMIT 1", day, month, year, playersip, PI[playerid][pID]);
	mysql_tquery(1, string);

	UpdatePlayerWeather(playerid);

    SetPlayerTime(playerid, tmphour, tmpminute);

	SpawnPlayer(playerid);
	//SendClientMessage(playerid, COLOR_GREEN, "На сервере работает система погоды, активировать - /weather.");

	SendClientMessage(playerid, COLOR_WHITE, ""SERVER"Подсказка: "WHITE"Для управления своим аккаунтом, используйте {"#cGREEN"}/mm (клавиша Y)");
	SendClientMessage(playerid, COLOR_WHITE, ""SERVER"Подсказка: "WHITE"Для управления донат системой, используйте {"#cGREEN"}/donate");
	if(PayDayBonus[0] || PayDayBonus[1]) SendClientMessage(playerid, -1, "{FFFF00}Подсказка: "WHITE"На сервере включена быстрая прокачка, используйте {"#cGREEN"}/boostinfo");
	UpdateDescription(playerid, "", 2);
	if(PI[playerid][pWanted]>=1)
	{
		SetPlayerWantedLevel(playerid, PI[playerid][pWanted]);
	}
	if(GetPVarInt(playerid,"reg_check")) RegistrationPlayer(playerid,PI[playerid][pChar],true);
	return 1;
}
public OnQueryError(errorid, error[], callback[], query[], connectionHandle)
{
	if(errorid == CR_SERVER_GONE_ERROR) mysql_reconnect(1);
	printf("[mysql] %d, %s, %s, %s, %d", errorid, error, callback, query, connectionHandle);
	return 1;
}
ShowPlayerMembers(playerid)
{
	if(!PI[playerid][pMember]) return ErrorMessage(playerid, "Вы нигде не состоите");
	new teamnumber;
	new tmpstring[550];
	if (PI[playerid][pLeader]) teamnumber = PI[playerid][pLeader];
	else if (PI[playerid][pMember]) teamnumber = PI[playerid][pMember];
	SCM(playerid, 0x059BD3AA, "Члены организации Online:");
	new countmember = 0;
	foreach(Player,i)
	{
	    if(IsPlayerConnected(i))
	    {
			if(PI[i][pMember] != teamnumber || !IsPlayerConnected(i) || PI[i][pAdmin]) continue;
			{
				format(tmpstring, sizeof(tmpstring), "");
				countmember++;
				if (PI[i][pLeader] == teamnumber) format(tmpstring, MAX_STR+50, ""WHITE"%s[%d] - Ранг 10 (Лидер) - Во фракции: %d %s - Выговоров: %d/3 %s"WHITE"\n", PI[i][pNames], i, PI[i][pPayDayMember], Skl(PI[i][pPayDayMember],"час","часа","часов"), PI[i][vig], (PI[i][pJailTime]?(""WHITE"| {FF0000}КПЗ"):("")));
				else if (PI[i][pMember] == teamnumber) format(tmpstring, MAX_STR+50, ""WHITE"%s[%d] - Ранг %d (%s) - Во фракции: %d %s - Выговоров: %d/3 %s"WHITE"\n", PI[i][pNames], i, PI[i][pRank], PlayerRank[PI[i][pMember]-1][PI[i][pRank]-1],PI[i][pPayDayMember],Skl(PI[i][pPayDayMember],"час","часа","часов"), PI[i][vig],(PI[i][pJailTime]?(""WHITE"| {FF0000}КПЗ"):("")));
				if (strlen(tmpstring) > 1) SCM(playerid, 0xC0E1EEFF, tmpstring);
			}
		}
	}
	if(countmember == 0) SCM(playerid, COLOR_GRAD1, "Нет игроков");
	else SCMF(playerid, COLOR_WHITE, "Всего: %d %s в организации {%s}%s.", countmember,Skl(countmember,"игрок","игрока","игроков"), GetFractionColor[teamnumber], FI[teamnumber][fName]);
	return 1;
}
ShowAMembers(playerid, orgid)
{
	new teamnumber;
	teamnumber = orgid;
	new countmember = 0;
	string = "";
	new tmpstring[128];
	foreach(Player, i)
	{
		if(PI[i][pMember] != teamnumber || !IsPlayerConnected(i) || PI[i][pAdmin]) continue;
		if(StartRabWork(i))
		{
			if (PI[i][pLeader] == teamnumber) format(tmpstring, MAX_STR+50, "{00B464}%s"WHITE"[{00B464}%d"WHITE"] ранг: {00B464}Лидер %s %s\n", PI[i][pNames], i, (GetPVarInt(i, "StartRabWork") ? ("- [{00B464}На работе{00B464}]") : ("- [{FF0000}Не на работе{00B464}]")), (PI[i][pJailTime]?("{FF0000}[КПЗ]"):("")));
			else if (PI[i][pMember] == teamnumber) format(tmpstring, MAX_STR+50, "{00B464}%s"WHITE"[{00B464}%d"WHITE"] ранг: {00B464}%d %s %s\n", PI[i][pNames], i, PI[i][pRank], (GetPVarInt(i, "StartRabWork") ? ("- [{00B464}На работе{00B464}]") : ("- [{FF0000}Не на работе{00B464}]")), (PI[i][pJailTime]?("{FF0000}[КПЗ]"):("")));
			if (strlen(tmpstring) > 1)
			{
				strcat(string, tmpstring);
				countmember++;
			}
		}
		else
		{
			if (PI[i][pLeader] == teamnumber) format(tmpstring, MAX_STR, "[{00B464}%d"WHITE"] {00B464}%s"WHITE" ранг: {00B464}Лидер %s\n", i, PI[i][pNames], (PI[i][pJailTime]?("{FF0000}[КПЗ]"):("")));
			else if (PI[i][pMember] == teamnumber) format(tmpstring, MAX_STR, "[{00B464}%d"WHITE"] {00B464}%s"WHITE" ранг: {00B464}%d %s\n", i, PI[i][pNames], PI[i][pRank], (PI[i][pJailTime]?("{FF0000}[КПЗ]"):("")));
			if (strlen(tmpstring) > 1)
			{
				strcat(string, tmpstring);
				countmember++;
			}
		}
	}
	format(tmpstring, sizeof tmpstring, ""WHITE"Всего: {00B464}%i"WHITE" человек.", countmember);
	strcat(string, tmpstring);
	ShowPlayerDialog(playerid, 3068, DIALOG_STYLE_MSGBOX, ""SERVER"Члены организации Online:", string, "OK", "");
	return 1;
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(result == -1)
	{
	    new string_warning[102];
	    format(string_warning, sizeof(string_warning), ""WARNING"| "WHITE"Команда /%s не существует! Используйте "SERVER"/mm > Команды сервера", cmd);
	    SCM(playerid, COLOR_GREY, string_warning);
	    return 0;
	}

	return 1;
}
public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
    if(ServerRestart[1]) return 0;
	if(!PI[playerid][pLogin] || !IsPlayerConnected(playerid)) return SendClientMessage(playerid,-1,""#net"Вы не авторизованы.") & 0;
	if(GetPVarInt(playerid,"AntiFlood") > unix) return SendClientMessage(playerid, COLOR_GREY, "Не флудите!") & 0;
	SetPVarInt(playerid,"AntiFlood",unix + 1);
	return 1;
}
cmd:pvp(playerid, params[])
{
	if(duel_t >= MAX_DUELS) return ErrorMessage(playerid, "В данный момент нельзя вести дуэли (ожидайте)");
	if(sscanf(params, "ddd", params[0], params[1], params[2])) return SendClientMessage(playerid, -1, ""#information"Введите /pvp [id игрока] [id оружие] [ставка]");
	else if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя с самим собой!");
	else if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок не в сети");
	else if(!IsPlayerStream(10.0, playerid, params[0]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return ErrorMessage(playerid, "Игрок не рядом с вами");
	else if(params[1] != 25 && params[1] != 29 && params[1] != 31 && params[1] != 24 && params[1] != 28 && params[1] != 30) return ErrorMessage(playerid, "Доступные ID оружия: Desert Eagle(24), ShotGun(25), Micro Uzi(28), MP5(29), AK-47(30), M4(31)");
	else if(params[2] < 1) return ErrorMessage(playerid, "Сумма не должна быть меньше 1");
	else if(PI[playerid][pCash] < params[2] || PI[params[0]][pCash] < params[2]) return ErrorMessage(playerid, "У вас нет столько денег / У противника нет столько денег");
 	format(string, 128, "%s {"#cINFO"}предлагает вам дуэль на "WHITE"%s", PI[playerid][pNames], WeaponNames[params[1]]);
	SendClientMessage(params[0], -1, string);
	SendClientMessage(params[0], CINFO, "Чтобы согласиться нажмите {"#cGREEN"}Y{"#cINFO"}, для отказа {"#cRED"}N");
	format(string, 128, "Вы предложили дуэль "WHITE"%s {"#cINFO"}на "WHITE"%s", PI[params[0]][pNames], WeaponNames[params[1]]);
	SendClientMessage(playerid, CINFO, string);
	SetPVarInt(playerid, "id_pvp", params[0]+1);
	SetPVarInt(playerid, "id_gun", params[1]);
	SetPVarInt(playerid, "money_pvp", params[2]);
	SetPVarInt(params[0], "id_pvp", playerid+1);
	return 1;
}
cmd:mm(playerid)
{
	new lvlexp[80];
	format(lvlexp,70,""WHITE"Управление аккаунтом - "SERVER"%s",PI[playerid][pNames]);
	ShowPlayerDialog(playerid, 9623, DIALOG_STYLE_LIST, lvlexp, "\
	"SERVER"1."WHITE" Статистика\n\
	"SERVER"2."WHITE" Настройки\n\
	"SERVER"3."WHITE" Безопасноть\n\
	"SERVER"4."WHITE" Команды сервера\n\
	"SERVER"5."WHITE" Администрация ("WARNING"Supports"WHITE")\n\
	"SERVER"6."WHITE" Аксессуары персонажа\n\
	"SERVER"7."WHITE" Указать промокод\n\
	"SERVER"8."WHITE" Донат магазин\n\
	"SERVER"9."WHITE" ТОП игроков", "Выбрать", "Отмена");
	return 1;
}
cmd:members(playerid) return ShowPlayerMembers(playerid);
cmd:amembers(playerid, params[])
{
	if(!IsPlayerConnected(playerid)) return false;
	if(GetAccessAdmin(playerid, 7))
	{
		new param;
		if(sscanf(params, "d", param)) return SendEsp(playerid, "/amembers [id организации]");
		if(param > 29 || param < 1) return ErrorMessage(playerid, "Нельзя меньше 1 или больше 29!");
		ShowAMembers(playerid, param);
	}
	return true;
}
cmd:fpanel(playerid)
{
	if(PI[playerid][pFilling] == -1 || strcmp(PI[playerid][pNames], Filling[PI[playerid][pFilling]][fOwner], true) != 0) return ErrorMessage(playerid, "У Вас нет заправки");
	if(!PlayerToPoint(5.0, playerid, Filling[PI[playerid][pFilling]][fPos][0], Filling[PI[playerid][pFilling]][fPos][1], Filling[PI[playerid][pFilling]][fPos][2])) return ErrorMessage(playerid, "Вы не возле заправки");
	ShowFilling(playerid);
	return 1;
}

ShowFilling(playerid)
{
	new f = PI[playerid][pFilling];
	format(string, 256, "Баланс:\t\t{"#cGREEN"}%d$\nЦена за 1 литр:\t\t{"#cGREEN"}%d$\nЗакупка бензина:\t{"#cGREEN"}90$[%d/%d]\nЗаправка:\t\t%s\nПродать заправку\nОбменять заправку\n{"#cYELLOW"}Продать заправку государству",
	    Filling[f][fBankMoney], Filling[f][fPriceBenz], Filling[f][fBenz], Filling[f][fMaxBenz], (Filling[f][fLock] ? ("{FF0000}Закрыта") : ("{"#cGREEN"}Открыта")));
	ShowPlayerDialog(playerid, DIALOG_FILLING, DIALOG_STYLE_LIST, "{"#cGREEN"}Меню заправки", string, "Выбрать", "Отмена");
	return 1;
}
cmd:addfilling(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		//if(gAdminReason[playerid][ADMIN_ADDFILLING]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
		if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, ""#information"/addfilling [price]");
		if(FILLING_TOTAL > MAX_FUEL) return ErrorMessage(playerid, "Внутриигровая ошибка, сообщите об этом гл. администратору!");
		new Float:p[3];
		GetPlayerPos(playerid, p[0], p[1], p[2]);
		FILLING_TOTAL++;
		Filling[FILLING_TOTAL][fPos][0] = p[0], Filling[FILLING_TOTAL][fPos][1] = p[1], Filling[FILLING_TOTAL][fPos][2] = p[2];
		Filling[FILLING_TOTAL][fPrice] = params[0], Filling[FILLING_TOTAL][fBenz] = 1000, Filling[FILLING_TOTAL][fMaxBenz] = 10000;
		Filling[FILLING_TOTAL][fBankMoney] = 0, Filling[FILLING_TOTAL][fPriceBenz] = 100, Filling[FILLING_TOTAL][fLock] = true;
		string = "";
		format(string, 320, "{"#cGREEN"}Заправочная станция №%i{FFFFFF}\n\nСтатус: {"#cGREEN"}[{FF0000}Закрыта{"#cGREEN"}]\n{FFFFFF}Стоимость: {"#cGREEN"}[%i$]{FFFFFF}\nБензина в цистерне: {"#cGREEN"}[%i/%i литра(-ов)]{FFFFFF}\nЦена за 1 литр: {"#cGREEN"}[%i$]{FFFFFF}\n\nДля покупки введите '/buyfuel'",
		    FILLING_TOTAL, Filling[FILLING_TOTAL][fPrice], Filling[FILLING_TOTAL][fBenz], Filling[FILLING_TOTAL][fMaxBenz], Filling[FILLING_TOTAL][fPriceBenz]);
	    Filling[FILLING_TOTAL][fText] = Create3DTextLabel(string, -1, Filling[FILLING_TOTAL][fPos][0], Filling[FILLING_TOTAL][fPos][1], Filling[FILLING_TOTAL][fPos][2]+1.0, 20.0, 0, 1);
		mysql_format(1, string, 524, "INSERT INTO `filling` (`fID`, `fOwner`, `fPrice`, `fPos`, `fPos1`, `fPos2`, `fLock`, `fBankMoney`, `fBenz`, `fMaxBenz`, `fPriceBenz`) VALUES ('%i', 'None', '%i', '%f', '%f', '%f', '1', '0', '1000', '10000', '100')",
		    FILLING_TOTAL, params[0], p[0], p[1], p[2]);
		mysql_tquery(1, string);
		SCMF(playerid, -1, "Заправка №%i успешно создана!", FILLING_TOTAL);

		new log_str[256 + 1];
		format(log_str, sizeof(log_str), "%s использовал команду /addfilling", PI[playerid][pNames]);
		logs(1, log_str, 0);
	}
	return 1;
}
cmd:giverank(playerid, params[])
{
	if(!CanRangPlayer(playerid)) return ErrorMessage(playerid, "Вам недоступна эта команда.");
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "dd", params[0], params[1])) return SendEsp(playerid, "/giverank [id] [ранг]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return 1;
	if(!IsValidRank(playerid, params[1])) return ErrorMessage(playerid, "Неправильный номер ранга.");
	if(PI[playerid][pRank] <= params[1]) return ErrorMessage(playerid, "Нельзя повысить выше своего ранга.");
	if(PI[params[0]][pLeader] >= 1) return ErrorMessage(playerid, "Неверный ID");
	if(PI[playerid][pMember] != PI[params[0]][pMember]) return ErrorMessage(playerid, "Данный игрок не в вашей фракции!");
	if(PI[playerid][pMember] > 0 && PI[playerid][pRank] <= params[1]) return ErrorMessage(playerid, "");
	if(PI[playerid][pLeader] <= 0 && PI[playerid][pRank] <=  PI[params[0]][pRank]) return ErrorMessage(playerid, "");
	string = "";
	format(string, MAX_STR, "Вас повысил/понизил до %d ранга %s", params[1], PI[playerid][pNames]);
	SendClientMessage(params[0], 0x6BB3FFAA, string);
	format(string, MAX_STR, "Вы повысили %s до %d ранга.", PI[params[0]][pNames], params[1]);
	SendClientMessage(playerid, 0x6BB3FFAA, string);
	if(params[1] > PI[params[0]][pRank]) format(string, 300, "[F] %s %s [%d] повысил %s [%d] с должности %s [%d] на должность %s [%d]", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], PI[playerid][pRank], PI[params[0]][pNames], params[0], PlayerRank[PI[params[0]][pMember]-1][PI[params[0]][pRank]-1], PI[params[0]][pRank], PlayerRank[PI[params[0]][pMember]-1][params[1]-1], params[1]);
	else format(string, 300, "[F] %s %s [%d] понизил %s [%d] с должности %s [%d] на должность %s [%d]", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], PI[playerid][pRank], PI[params[0]][pNames], params[0], PlayerRank[PI[params[0]][pMember]-1][PI[params[0]][pRank]-1], PI[params[0]][pRank], PlayerRank[PI[params[0]][pMember]-1][params[1]-1], params[1]);
	SendFractionMessage(PI[params[0]][pMember], 0x3399FFFF, string);
	PI[params[0]][pRank] = params[1];
	UpdatePlayerData(params[0], "pRank", PI[params[0]][pRank]);
	if(PI[params[0]][pMember] == 3 || PI[params[0]][pMember] == 19 || PI[params[0]][pMember] == 27) strmid(PI[params[0]][ArmyRank], PlayerRank[PI[params[0]][pMember]-1][PI[params[0]][pRank]-1], 0, strlen(PlayerRank[PI[params[0]][pMember]-1][PI[params[0]][pRank]-1]), 255), UpdatePlayerDataEx(params[0], "ArmyRank", PI[params[0]][ArmyRank]);
	return 1;
}
cmd:changeskin(playerid, params[])
{
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return SendClientMessage(playerid, COLOR_RED, "Вы не начали рабочий день!");
	switch(PI[playerid][pMember])
	{
	case 1, 3, 19, 10, 20, 21: if(PI[playerid][pRank] < 14) return SendClientMessage(playerid, COLOR_RED, "Вам не доступна данная команда");
	case 2: if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_RED, "Вам недоступна данная команда");
	case 4..6, 28, 29, 11..15, 17, 18, 22, 24..26: if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_RED, "Вам не доступна данная команда");
	case 7..9: if(PI[playerid][pRank] < 5) return SendClientMessage(playerid, COLOR_RED, "Вам не доступна данная команда");
	case 16: if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_RED, "Вам не доступна данная команда");
	case 23: if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_RED, "Вам не доступна данная команда");
	case 27: if(PI[playerid][pRank] < 10) return SendClientMessage(playerid, COLOR_RED, "Вам не доступна данная команда");
	default: return SendClientMessage(playerid, COLOR_RED, "Вам не доступна данная команда");
	}
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, "{FF0000}x {DDDDDD}Используйте: /changeskin [id игрока]");
	if(!ProxDetectorS(8.0, playerid, params[0]) || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendClientMessage(playerid, COLOR_WHITE, "{FF0000}x {DDDDDD}Вы далеко друг от друга");
	if(PI[params[0]][pMember] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_WHITE, "{FF0000}x {DDDDDD}Игрок не состоит в вашей организации");
	if(PI[params[0]][pRank] >= PI[playerid][pRank] && params[0] != playerid) return SendClientMessage(playerid, COLOR_WHITE, "{FF0000}x {DDDDDD}Ваш ранг недостаточен");
	new fractionid = PI[playerid][pMember] - 1;
	SetPVarInt(playerid, "actplayerid", params[0]);
	for(new i;i<20;i++)
	{
		new skinid = ChangeSkin[fractionid][i];
		if(!skinid) break;
		if(skinid == PI[params[0]][pModel])
		{
			if(!i) format(stringer, sizeof(stringer), "{33AA33}Скин %d [%d]", i+1, skinid);
			else format(stringer, sizeof(stringer), "%s\n{33AA33}Скин %d [%d]", stringer, i+1, skinid);
		}
		else
		{
			if(!i) format(stringer, sizeof(stringer), "Скин %d [%d]", i+1, skinid);
			else format(stringer, sizeof(stringer), "%s\nСкин %d [%d]", stringer, i+1, skinid);
		}
	}
	ShowPlayerDialog(playerid, 1145, 2, PI[params[0]][pNames], stringer, "OK", "Отмена");
	return true;
}
cmd:invite(playerid, params[])
{
	if(!CanInvitePlayer(playerid)) return ErrorMessage(playerid, "Вам недоступна эта команда.");
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/invite [id]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return 1;
	if(PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Запрещено принимать администратора!");
	if(IsPlayerInAnyVehicle(params[0])) return ErrorMessage(playerid, "Игрок в машине!");
	if(PI[params[0]][pMember] > 0 || PI[params[0]][pLeader] > 0) return ErrorMessage(playerid, "Игрок уже где то состоит");
	if(PI[params[0]][pWarns] >= 1) return ErrorMessage(playerid, "У игрока Warn.");
	if(!ProxDetectorS(10.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок, не рядом с вами!");
	if(!PI[params[0]][pPassport]) return ErrorMessage(playerid, "У игрока нет паспорта!");
	string = "";
	mysql_format(1, string, 144, "SELECT * FROM `blocks` WHERE `blockName` = '%e' AND `blockFraction` = '%i'", PI[params[0]][pNames], PI[playerid][pMember]);
	mysql_tquery(1, string, "BlocksCallback", "ddsd", playerid, params[0], "None", 3);
	return 1;
}
cmd:uninvite(playerid, params[])
{
	if(!IsUninviteRank(playerid)) return 1;
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "ds[128]", params[0], params[1])) return SendEsp(playerid, "/uninvite [playerid] [причина]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return 1;
	if(params[0] == playerid) return ErrorMessage(playerid, "Себя невозможно уволить");
	if(PI[params[0]][pLeader] >= 1) return ErrorMessage(playerid, "Неверный ID");
	if(PI[playerid][pLeader] <= 0 && PI[playerid][pRank] <= PI[params[0]][pRank]) return ErrorMessage(playerid, "Вы не можете уволить человека выше по рангу!");
	if(!PI[params[0]][pMember]) return ErrorMessage(playerid, "Этот человек гражданский");
	if(PI[params[0]][pMember] == PI[playerid][pLeader] || PI[params[0]][pMember] == PI[playerid][pMember])
	{
		if(IsPlayerInAnyVehicle(params[0])) RemovePlayerFromVehicle(params[0]);
	    format(string, 144, "%s %s уволил Вас из организации %s, с должности %s. Причина: %s", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], FI[PI[params[0]][pMember]][fName], PlayerRank[PI[params[0]][pMember]-1][PI[params[0]][pRank]-1], params[1]);
	    SendClientMessage(params[0], COLOR_REDD, string);

	    format(string, 144, "Вы уволили из организации %s, с должности %s. Причина: %s", PI[params[0]][pNames], PlayerRank[PI[params[0]][pMember]-1][PI[params[0]][pRank]-1], params[1]);
        SendClientMessage(playerid, COLOR_GREEN, string);

		format(string, 144, "%s %s уволил %s с должности %s. Причина: %s", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], PI[params[0]][pNames], PlayerRank[PI[params[0]][pMember]-1][PI[params[0]][pRank]-1], params[1]);
		SendAdminMessage(COLOR_SERVER, string);

		if(StartRabWork(params[0]))
		{
			SendClientMessage(params[0], COLOR_BLUE, "Ваш рабочий день окончен!");
			SetPVarInt(params[0], "StartRabWork", 0);
		}
		PI[params[0]][pMember] = 0;
		PI[params[0]][pRank] = 0;
		PI[params[0]][pLeader] = 0;
		PI[params[0]][pJob] = 0;
		PI[params[0]][pPayDayMember] = 0, UpdatePlayerData(params[0], "pPayDayMember", PI[params[0]][pPayDayMember]);
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%d'", PI[params[0]][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(params[0], FI[PI[params[0]][pMember]][fColor]);
		SetPlayerSkin(params[0], PI[params[0]][pChar]);
	}
	return 1;
}
CMD:ads(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(sscanf(params, "u", params[0])) return SCM(playerid, COLOR_WHITE, ""#information"/ads [id игрока]");
	{
	    if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок не найден!");
     	SetPlayerPos(params[0],3288.2507,2310.2617,35.7921);
		SCM(params[0],-1,""#good"Администратор телепортировал Вас на проверку!");
		string = "";
		format(string, MAX_STR, "Администратор %s телепортировал игрока %s на проверку", PI[playerid][pNames], PI[params[0]][pNames]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		if(PI[playerid][pAdmin]) return ShowPlayerDialog(params[0], 0000, DIALOG_STYLE_MSGBOX, "{FFFFFF}", ""WHITE"Здравствуйте, администратор телепортировал Вас на проверку.\n\n{E74B3F}- "WHITE"Если вы покинете игру, Ваш игровой аккаунт будет заблокирован.", "Понятно", "");
	}
 	SetPlayerPos(playerid,3288.2507,2310.2617,35.7921);
	return 1;
}
alias:apanel("ap");
cmd:apanel(playerid)
{
    if(FULL_1 || FULL_2 || FULL_3 || FULL_4 || FULL_5 || FULL_6)
    {
