}
CMD:av(playerid,params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(sscanf(params, "ui", params[0],params[1]))
	{
		SCM(playerid, COLOR_GREY, "Используйте: /av [id] [id шаблона]");
        SCM(playerid, COLOR_GREY, "Помощь по шаблонам: /avinfo");
        return true;
	}
	if(!IsPlayerConnected(playerid) || !PI[playerid][pLogin]) return 1;
	if(params[1] < 1 || params[1] > 12) return SCM(playerid,COLOR_GREY,"Нет такого шаблона. Помощь по шаблонам: /avinfo");
	new avtext[225];
	switch(params[1])
	{
	    case 1: strmid(avtext, "Добро пожаловать на LeanWorld Role Play!", 0, 225, 225);
		case 2: strmid(avtext, "Приятной игры на LeanWorld Role Play!", 0, 225, 225);
		case 3: strmid(avtext, "Слежу за игроком", 0, 225, 225);
		case 4: strmid(avtext, "Игрок был наказан. Спасибо за помощь!", 0, 225, 225);
		case 5: strmid(avtext, "Нарушений со стороны игрока не было обнаружено", 0, 225, 225);
		case 6: strmid(avtext, "С наступающим Вас Новым годом!", 0, 225, 225);
		case 7: strmid(avtext, "Сообщите пожалуйста об этой ошибке на форум: lwrp.ru/forum", 0,225, 225);
		case 8: strmid(avtext, "Здравствуйте, чем могу быть полезен?", 0, 225, 225);
		case 9: strmid(avtext, "Спасибо за помощь в развитии проекта. Мы это очень ценим", 0, 225, 225);
		case 10: strmid(avtext, "Пополняйте счёт с выгодой на нашем сайте: lwrp.ru", 0, 225, 225);
		case 11: strmid(avtext, "Наша группа ВКонтакте: vk.com/lean_world_rp", 0, 225, 225);
		case 12: strmid(avtext, "Сайт нашего сервера: "NAME_SAIT"", 0, 225, 225);
	}
	new format_string[225];

	format(format_string, sizeof format_string, ""information"Ответ от администратора %s[%d]: {EE5555}%s", PI[playerid][pNames], playerid, avtext);
	SCM(params[0], -1, format_string);

	gAdmin[playerid][ADMIN_PM]++;

	format(format_string, sizeof format_string, "[A] %s[%d] ответил %s[%d]: %s", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0], avtext);
	SendAdminMessage(0xFF9945AA, format_string);

	PlayerPlaySound(params[0], 1058, 0.0, 0.0, 0.0);
	return 1;
}
cmd:hstats(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 10))
		return true;

	if(sscanf(params, "s[24]", params[0]))
	    return SendClientMessage(playerid, -1, ""#information"Введите: /hstats [name]");

	new id = GetPlayerID(params[0]);

	if(0 == IsPlayerConnected(id))
	{
		mysql_format(1, string, 200, "SELECT `pHelperAns`, `pHelper` FROM `accounts` WHERE `Name` = '%e' LIMIT 1", params[0]);
		mysql_tquery(1, string, "OnCheckHelperAns", "is", playerid, params[0]);
		return 1;
	}

	if(0 == PI[id][pHelper])
	    return ErrorMessage(playerid, "Игрок не является помощником!");

    SCMF(playerid, -1, ""#information"Support %s ответил игрокам: "SERVER"%i раз!", params[0], PI[id][pHelperAns]);

	return 1;
}
publics:OnCheckHelperAns(playerid, name[])
{
	new rows, fields;
	cache_get_data(rows, fields);

	if(0 == rows)
		return ErrorMessage(playerid, "Не найдено информации о данном помощнике!");

	if(0 == cache_get_field_content_int(0, "pHelper"))
	    return ErrorMessage(playerid, "Игрок не является помощником!");

	SCMF(playerid, -1, ""#information"Support %s ответил игрокам: "SERVER"%i раз!", name, cache_get_field_content_int(0, "pHelperAns"));
	return 1;
}
cmd:hc(playerid, params[])
{
	if(!PI[playerid][pHelper]) return 1;
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "(/hc) [helpers chat]");
	new hrank[50];
	string = "";
	switch(PI[playerid][pHelper])
	{
		case 1: hrank = "{FFD700}(Support)";
		default: hrank = "{FFD700}(Support)";
	}
	format(string, 200, "*%s "WHITE"%s[%d]: %s", hrank, PI[playerid][pNames], playerid, params[0]);
	SendSupportsMessage(COLOR_GREEN, string);
	return 1;
}
cmd:sethpprice(playerid, params[])
{
	if(PI[playerid][pLeader] != 4) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/sethpprice [сумма]");
	if(params[0] < 1 || params[0] > 1000) return ErrorMessage(playerid, "Вы не можете поставить меньше 0 и больше 1000");
	healpric = params[0];
	SendClientMessageToAll(COLOR_WHITE, "---========== Государственные Новости ==========---");
	string = "";
	format(string, 200, "Цена лечения, в размере %d вирт. установлена Глав. Врачом: %s.", healpric, PI[playerid][pNames]);
	SendClientMessageToAll(0xA52A2AFF, string);
	SendClientMessageToAll(COLOR_WHITE, "---========== Государственные Новости ==========---");
	return 1;
}
