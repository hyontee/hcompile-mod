		"SERVER"2."WHITE" %s"WHITE" телепорт на мероприятие\n", texttelep);
		strcat(textmp, strmp);
		format(strmp, 900, "\
		"SERVER"3."WHITE" Установить HP игрокам (50m)\n\
		"SERVER"4."WHITE" Выдать оружие игрокам (50m)\n\
		"SERVER"5."WHITE" Обезоружить игроков (50m)\n\
		"SERVER"6."WHITE" Установить цвет\n\
		"SERVER"7."WHITE" Выдать всем маски\n\
		"SERVER"8."WHITE" Заморозить игроков\n\
		"SERVER"9."WHITE" Дать отсчет\n");
		strcat(textmp, strmp);
		strcat(textmp, "\
		"SERVER"10."WHITE" Огласить победителя\n\
		"SERVER"11."WHITE" Удалить мероприятие");
		ShowPlayerDialog(playerid, daddmp, DIALOG_STYLE_LIST, ""SERVER"Меню мероприятий", textmp, "Выбрать", "Закрыть");
	}
