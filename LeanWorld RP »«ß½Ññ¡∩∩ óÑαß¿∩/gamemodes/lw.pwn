TimeConverter(seconds)
{
	new strings[64];
	new minutes = floatround(seconds/60);
	seconds -= minutes*60;
	format(strings, 64, "%02d:%02d", minutes, seconds);
	return strings;
}
GetPlayer2DZone(playerid, zone[], len)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	for(new i = 0; i != sizeof(gSAZones); i++ )
	{
		if(x >= gSAZones[i][SAZONE_AREA][0] && x <= gSAZones[i][SAZONE_AREA][3] && y >= gSAZones[i][SAZONE_AREA][1] && y <= gSAZones[i][SAZONE_AREA][4]) return format(zone, len, gSAZones[i][SAZONE_NAME], 0);
	}
	return 0;
}
GetZonaName( Float: x, Float: y )
{
	for ( new i = 0; i != sizeof ( gSAZones ); i++ )
	{
		if ( x >= gSAZones[i][SAZONE_AREA][0] && x <= gSAZones[i][SAZONE_AREA][3] && y >= gSAZones[i][SAZONE_AREA][1] && y <= gSAZones[i][SAZONE_AREA][4]) return i;
	}
	return 1;
}
GetCityName ( Float: x, Float: y)
{
	for ( new i = 0; i != sizeof ( gSAZonesCity ); i++ )
	{
		if ( x >= gSAZonesCity[i][SAZONE_AREA][0] && x <= gSAZonesCity[i][SAZONE_AREA][3] && y >= gSAZonesCity[i][SAZONE_AREA][1] && y <= gSAZonesCity[i][SAZONE_AREA][4] ) return i;
	}
	return 1;
}
SendDead(ids, whoids, killerid, playerid, reason)
{
	foreach(Player, m)
	{
	    if(GetAccessAdmin(m, 1)) continue;
		if(PI[m][pMember] == ids || PI[m][pMember] == whoids) SendDeathMessageToPlayer(m, killerid, playerid, reason);
	}
	return 1;
}

SendDeadAdm(killerid, playerid, reason)
{
	foreach(Player, i)
		if(GetAccessAdmin(i, 1)) SendDeathMessageToPlayer(i, killerid, playerid, reason);
	return true;
}

publics: GzCheck(i, napad, vlad)
{
	foreach(Player, m)
	{
	    if(PI[m][kapture][0] && !IsAGang(m)) EndCapt(m);
	    else if(PI[m][pMember] == napad || PI[m][pMember] == vlad)
	    {
			if(!PI[m][kapture][0])
			{
				GangZoneFlashForPlayer(m, GZInfo[i][gID], GetGangColor(napad));
				TextDrawShowForPlayer(m, Capture[0]);
				TextDrawShowForPlayer(m, Capture[1]);
				TextDrawShowForPlayer(m, Capture[2]);
				TextDrawSetString(Capture[3],TimeConverter(GZInfo[i][gTime]));
				switch(napad)
				{
					case 12: TextDrawColor(Capture[4], 0x8813E7aa);
					case 13: TextDrawColor(Capture[4], 0xDBD604AA);
					case 15: TextDrawColor(Capture[4], 0x009F00AA);
					case 17: TextDrawColor(Capture[4], 0x01FCFFaa);
					case 18: TextDrawColor(Capture[4], 0x83BFBFAA);
				}
				switch(vlad)
				{
					case 12: TextDrawColor(Capture[7], 0x8813E7aa);
					case 13: TextDrawColor(Capture[7], 0xDBD604AA);
					case 15: TextDrawColor(Capture[7], 0x009F00AA);
					case 17: TextDrawColor(Capture[7], 0x01FCFFaa);
					case 18: TextDrawColor(Capture[7], 0x83BFBFAA);
				}
				TextDrawShowForPlayer(m, Capture[3]);
				TextDrawShowForPlayer(m, Capture[4]);
				TextDrawShowForPlayer(m, Capture[5]);
				TextDrawShowForPlayer(m, Capture[6]);
				TextDrawShowForPlayer(m, Capture[7]);
				TextDrawShowForPlayer(m, Capture[8]);
				TextDrawShowForPlayer(m, Capture[9]);
				TextDrawShowForPlayer(m, Capture[10]);
				PI[m][kapture][0] = true;
			}
			else
			{
			    TextDrawSetString(Capture[3],TimeConverter(GZInfo[i][gTime]));
				format(GZInfo[i][strcpt],30,"%d",CountOnZone[napad]);
				TextDrawSetString(Capture[9],GZInfo[i][strcpt]);
				format(GZInfo[i][strcpt],30,"%d",CountOnZone[vlad]);
				TextDrawSetString(Capture[10],GZInfo[i][strcpt]);
			}
		}
	}
	if(GZInfo[i][gTime]) GZInfo[i][gTime] --;
	if(GZInfo[i][gTime] <= 0)
	{
		if(GZInfo[i][ZoneOnBattle] == 1)
		{
			if(CountOnZone[vlad] == CountOnZone[napad] || CountOnZone[vlad] > CountOnZone[napad])
			{
				SendFractionMessage(GZInfo[i][gFrakVlad], COLOR_SERVER, "[Внимание] Вам удалось отстоять свою территорию.");
				SendFractionMessage(GZInfo[i][gNapad], COLOR_SERVER, "[Внимание] Вам не удалось завоевать территорию.");
			}
			else
			{
				SendFractionMessage(GZInfo[i][gFrakVlad], COLOR_SERVER, "[Внимание] Вам удалось отстоять свою территорию.");
				SendFractionMessage(GZInfo[i][gNapad], COLOR_SERVER, "[Внимание] Вам не удалось завоевать территорию.");
				GZInfo[i][gFrakVlad] = GZInfo[i][gNapad];
			}
			GZInfo[i][ZoneOnBattle] = 2;
		}
		if(GZInfo[i][ZoneOnBattle] == 2)
		{
	    	new best_frag, best_id, captprize, captst[340];
			foreach(Player, m)
			{
   				if(GetPVarInt(m, "CaptureKiller") > best_frag)
			    {
			        best_frag = GetPVarInt(m, "CaptureKiller");
					best_id = m;
					DeletePVar(m, "CaptureKiller");
			    }
				if(PI[m][pMember] == napad || PI[m][pMember] == vlad) EndCapt(m);
			}
			if(best_frag != -1 && best_id != -1)
			{
				format(string, sizeof(string), "Лучший игрок на капте "WHITE"%s "SERVER"который уничтожил "WHITE"%d человек(а)", PI[best_id][pNames], best_frag);
				captprize = random(1000), format(captst, sizeof(captst), "Вы стали лучшим игроком захвата территории, Ваша премия: "WHITE"%d "SERVER"Donate", captprize);
				PI[best_id][pDonate] +=captprize;
			}
			if(strlen(string)) foreach(Player, m) if(PI[m][pMember] == napad || PI[m][pMember] == vlad) SendClientMessage(m, COLOR_SERVER, string);
			SCM(best_id, COLOR_SERVER, captst);
			CountOnZone[napad] = 0;
			CountOnZone[vlad] = 0;
			GZInfo[i][ZoneOnBattle] = 0;
			GangZoneStopFlashForAll(GZInfo[i][gID]);
			GangZoneHideForAll(GZInfo[i][gID]);
			GangZoneShowForAll(GZInfo[i][gID],GetGangZoneColor(i));
			CaptureTime = 10;
			CaptureInfo = false;
			SaveGZ(i);
			KillTimer(GZInfo[i][gzTimer]);
			return 1;
		}
	}
	return 1;
}
EndCapt(m)
{
	TextDrawHideForPlayer(m, Capture[0]);
	TextDrawHideForPlayer(m, Capture[1]);
	TextDrawHideForPlayer(m, Capture[2]);
	TextDrawHideForPlayer(m, Capture[3]);
	TextDrawHideForPlayer(m, Capture[4]);
	TextDrawHideForPlayer(m, Capture[5]);
	TextDrawHideForPlayer(m, Capture[6]);
	TextDrawHideForPlayer(m, Capture[7]);
	TextDrawHideForPlayer(m, Capture[8]);
	TextDrawHideForPlayer(m, Capture[9]);
	TextDrawHideForPlayer(m, Capture[10]);
	for(new num; num < 10; num++) SendDeathMessageToPlayer(m, 6000, 5005, 255);
	PI[m][kapture][0] = false;
	return 1;
}
EndBizwar(m)
{
	for(new t = 0x0; t != 3;t++) PlayerTextDrawHide(m, Bizwar[m][t]);
	PI[m][kapture][1] = false;
	for(new num; num < 10; num++) SendDeathMessageToPlayer(m, 6000, 5005, 255);
	return 1;
}
GetGangName(nnid)
{
	new namegang[24];
	switch(nnid)
	{
		case 12: namegang = "Ballas";
		case 13: namegang = "Vagos";
		case 15: namegang = "Grove";
		case 17: namegang = "Aztecas";
		case 18: namegang = "Rifa";
	}
	return namegang;
}

OnPlayerAmmoChange(playerid, newammo, oldammo)
{
	if(newammo < oldammo)
	{
		GivePVarInt(playerid, "Shot", 1);
		switch(GetPlayerWeapon(playerid))
		{
		case 24: if(GetPVarInt(playerid, "Shot") >= 25 && PI[playerid][pSkills][1] < 100) PI[playerid][pSkills][1]++, DeletePVar(playerid, "Shot"), UpdatePlayerData(playerid, "pDesertEagle", PI[playerid][pSkills][1]);
		case 23: if(GetPVarInt(playerid, "Shot") >= 25 && PI[playerid][pSkills][0] < 100) PI[playerid][pSkills][0]++, DeletePVar(playerid, "Shot"), UpdatePlayerData(playerid, "pSDPistol", PI[playerid][pSkills][0]);
		case 25: if(GetPVarInt(playerid, "Shot") >= 50 && PI[playerid][pSkills][2] < 100) PI[playerid][pSkills][2]++, DeletePVar(playerid, "Shot"), UpdatePlayerData(playerid, "pShotGun", PI[playerid][pSkills][2]);
		case 29: if(GetPVarInt(playerid, "Shot") >= 50 && PI[playerid][pSkills][3] < 100) PI[playerid][pSkills][3]++, DeletePVar(playerid, "Shot"), UpdatePlayerData(playerid, "pMP5", PI[playerid][pSkills][3]);
		case 30: if(GetPVarInt(playerid, "Shot") >= 50 && PI[playerid][pSkills][4] < 100) PI[playerid][pSkills][4]++, DeletePVar(playerid, "Shot"), UpdatePlayerData(playerid, "pAK47", PI[playerid][pSkills][4]);
		case 31: if(GetPVarInt(playerid, "Shot") >= 50 && PI[playerid][pSkills][5] < 100) PI[playerid][pSkills][5]++, DeletePVar(playerid, "Shot"), UpdatePlayerData(playerid, "pM4", PI[playerid][pSkills][5]);
		}
	}
	return 1;
}

public OnDynamicObjectMoved(objectid)
{
	SaluteOnObjectMovedEx(objectid);
	return 1;
}

CreateSalut(Float:x, Float:y, Float:z)
{
	new sal = CheckSalut();
	if(sal == -1) return 0;
	Salut[sal][SaluteObject] = CreateDynamicObject(SaluteColorTypes[random(sizeof(SaluteColorTypes))], x, y, z, 0.0, 0.0, 0.0);
	Salut[sal][SaluteInUse] = true;
	Salut[sal][SaluteStatus] = 1;
	GetXYInFrontOfPosition(x, y, random(360), 18);
	MoveDynamicObject(Salut[sal][SaluteObject], x, y, z+45, 30);
	return 1;
}
CheckSalut()
{
	for(new i = 0; i < MAX_SALUTE; i++) if(!Salut[i][SaluteInUse]) return i;
	return -1;
}
DestroySalut(id)
{
	DestroyDynamicObject(Salut[id][SaluteObject]);
	Salut[id][SaluteInUse] = false;
}
SaluteOnObjectMovedEx(objectid)
{
	for(new id = 0; id < MAX_SALUTE; id++) if(Salut[id][SaluteInUse] && Salut[id][SaluteObject] == objectid && (1 <= Salut[id][SaluteStatus] <= 4))
	{
		new Float:x, Float:y, Float:z;
		GetDynamicObjectPos(objectid, x, y, z);
		GetXYInFrontOfPosition(x, y, Salut[id][SaluteLeanDir], Salut[id][SaluteWindOffset] / 5);
		z += Salut[id][height] / 5;
		Salut[id][SaluteStatus]++;
		MoveDynamicObject(Salut[id][SaluteObject], x, y, z, Salut[id][SaluteClimeSpeed]);
		GetDynamicObjectPos(objectid, x, y, z);
		CreateExplosion(x, y, z, Salut[id][SaluteExplType], Salut[id][SaluteExplSize]);
		DestroySalut(id);
	}
	return 1;
}
FindSalut()
{
	for (new i=0;i<sizeof(SALUTEINFOS);i++) if (!SALUTEINFOS[i][SaluteUse]) return i;
	return -1;
}
publics: SaluteMachineTimer(id, playerid)
{
	if(SALUTEINFOS[id][Salute])
	{
		CreateSalut(SALUTEINFOS[id][SalutePos][0]+random(3), SALUTEINFOS[id][SalutePos][1], SALUTEINFOS[id][SalutePos][2]);
		CreateSalut(SALUTEINFOS[id][SalutePos][0], SALUTEINFOS[id][SalutePos][1]+random(3), SALUTEINFOS[id][SalutePos][2]);
		CreateSalut(SALUTEINFOS[id][SalutePos][0]+random(3), SALUTEINFOS[id][SalutePos][1], SALUTEINFOS[id][SalutePos][2]);
		CreateSalut(SALUTEINFOS[id][SalutePos][0], SALUTEINFOS[id][SalutePos][1]+random(3), SALUTEINFOS[id][SalutePos][2]);
		CreateSalut(SALUTEINFOS[id][SalutePos][0]+random(3), SALUTEINFOS[id][SalutePos][1], SALUTEINFOS[id][SalutePos][2]);
		CreateSalut(SALUTEINFOS[id][SalutePos][0], SALUTEINFOS[id][SalutePos][1]+random(3), SALUTEINFOS[id][SalutePos][2]);
		CreateSalut(SALUTEINFOS[id][SalutePos][0]+random(3), SALUTEINFOS[id][SalutePos][1], SALUTEINFOS[id][SalutePos][2]);
		CreateSalut(SALUTEINFOS[id][SalutePos][0], SALUTEINFOS[id][SalutePos][1]+random(3), SALUTEINFOS[id][SalutePos][2]);
		SALUTEINFOS[id][Salute]--;
		SALUTEINFOS[id][SaluteTimer] = SetTimerEx("SaluteMachineTimer", floatround((400 + random(300)) * 0.26), false, "ii", id, playerid);
	}
	else
	{
		KillTimer(SALUTEINFOS[id][SaluteTimer]);
		SALUTEINFOS[id][SaluteTimer] = -1;
		SALUTEINFOS[id][SaluteUse] = false;
		DestroyDynamicObject(SALUTEINFOS[id][SaluteBox]);
		DeletePVar(playerid, "salut_check");
	}
}

publics:OnUnLeader (playerid, name[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SCMF(playerid, -1, ""#net"[ MySql ] Аккаунт %s не найден в базе данных.", name);
	string = "";
	mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pLeader` = '0', `pMember` = '0', `pRank` = '0' WHERE `Name` = '%e'", name);
	mysql_tquery(1, string);
	SCMF(playerid, COLOR_GREY, "[ MySql ] Аккаунт %s успешно снят с поста администратора.", name);
	return 1;
}
publics:OnUvalPlayer (playerid, name[], bool:isadmin)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SCMF(playerid, -1, ""#net"[ MySql ] Аккаунт %s не найден в базе данных.", name);
	if(!isadmin)
	{
		new tmp = cache_get_field_content_int(0, "pMember");
		if(tmp != PI[playerid][pMember]) return SCMF(playerid, COLOR_GREY, "[ MySql ] Аккаунт %s не является вашим членом фракции.", name);
	}
	string = "";
	mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0' WHERE `Name` = '%e'", name);
	mysql_tquery(1, string);
	SCMF(playerid, COLOR_GREY, "[ MySql ] Аккаунт %s успешно уволен из фракции.", name);
	return 1;
}
publics: DiceOff()
{
	foreach(Player, i)
	{
		if(!GetPVarInt(i, "OpustitRuki")) continue;
		DeletePVar(i, "OpustitRuki");
		if(IsPlayerAttachedObjectSlotUsed(i, 1)) RemovePlayerAttachedObject(i, 1);
		ClearAnimations(i);
		ApplyAnimation(i, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1);
	}
}
publics: ClearAnimText(playerid) return ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0);
