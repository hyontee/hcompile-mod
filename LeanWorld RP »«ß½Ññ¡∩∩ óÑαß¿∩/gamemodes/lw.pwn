@PromoCodeShow(playerid);
@PromoCodeShow(playerid)
{
    new rows, fields;
	cache_get_data(rows, fields);
    if(!rows)
	{
		SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Промокоды не найдены");
		return ShowPlayerDialog(playerid, 16094, DIALOG_STYLE_LIST, ""SERVER"Промокоды", ""SERVER"1."WHITE" Список промокодов\n"SERVER"2."WHITE" Создать промокод\n"SERVER"3."WHITE" Удалить промокод", "Выбрать", "Назад");
	}
    new code[32], code_money, code_adminka, code_helperka, code_days, code_players, used_count, code_rub;
    stringer[0] = EOS;
    strcat(stringer, ""WHITE"Название\t"GREEN"Деньги Админ Brilliant VIP Рубли\t"WHITE"Количество\t"WHITE"Использован\n");
    for(new i; i < rows; i++)
    {
		cache_get_row(i, 0, code, 1, 32);
        code_money = cache_get_row_int(i, 1, 1);
        code_adminka = cache_get_row_int(i, 7, 1);
        code_rub = cache_get_row_int(i, 8, 1);
        code_helperka = cache_get_row_int(i, 2, 1);
        code_days = cache_get_row_int(i, 3, 1);
        code_players = cache_get_row_int(i, 4, 1);
        used_count = cache_get_row_int(i, 6, 1);
        if(code_players > 0) format(stringer, sizeof(stringer),"%s%s\t%d %d %d %d\t%d игроков\t%d раз\n", stringer, code, code_money, code_adminka, code_helperka, code_rub, code_players, used_count);
       	else format(stringer, sizeof(stringer),"%s%s\t%d %d %d %d\t%d дней\t%d раз\n", stringer, code, code_money, code_adminka, code_helperka, code_rub, code_days, used_count);
    }
    ShowPlayerDialog(playerid, 16087, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"Список промокодов", stringer, "Назад", "Закрыть");
	return 1;
}

