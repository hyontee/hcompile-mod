OnPlayerSaveAccount(playerid)
{
	if(PI[playerid][pLogin] != true) return 1;
	string = "";
	mysql_format(1, string, 300, "UPDATE `accounts` SET `pCash` = '%d', `pChar` = '%d' WHERE `id` = '%i'", PI[playerid][pCash], PI[playerid][pChar], PI[playerid][pID]);
	mysql_tquery(1, string);
	return 1;
}
publics: OffWarn(playerid, tmp[], reason[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SCMF(playerid, COLOR_WHITE, ""#net"Аккаунт %s не найден в базе данных.", tmp);
	if ( GetPlayerID(tmp) != -1 ) return ErrorMessage(playerid, "Игрок онлайн");
	new pl_warns = cache_get_field_content_int(0, "pWarns");
 	if((pl_warns+1) < 3)
	{
		mysql_format(1, string, 264, "UPDATE `accounts` SET `pWarns` = `pWarns` + '1', `pLeader` = '0', `pMember` = '0', `pRank` = '0', `punWarnstime` = `punWarnstime` + '%i' WHERE `Name` = '%e'", unix + 7*86400, tmp);
		mysql_tquery(1, string);
		format(string, 144, "Администратор %s выдал warn %s в оффлайне [%d/3]. Причина: %s", PI[playerid][pNames], tmp, pl_warns, reason);
		SendClientMessageToAll(COLOR_LIGHTRED, string);

		gAdmin[playerid][ADMIN_WARN] += 1;
	}
	else
	{
		format(string, 128, "Администратор %s заблокировал %s [3 предупреждения] на 3 дня. Причина: %s", PI[playerid][pNames], tmp, reason);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pWarns` = '0', `pLeader` = '0', `pMember` = '0', `pRank` = '0', `punWarnstime` = '0' WHERE `Name` = '%e'", tmp);
		mysql_tquery(1, string);
		new data[16];
		new un_ban_date = unix + 3*86400;
		format(data, sizeof(data), "%s", date("%dd.%mm.%yyyy", unix));
		mysql_format(1, string, sizeof(string), "INSERT INTO `BanList` (`Nick`, `Admin`, `Date`, `Reason`, `Days`, `UnbanDate`, `Status`) VALUES ('%e', '%e', '%e', '%s (3 warns)', '3', '%d', '1')", tmp, PI[playerid][pNames], data, reason, un_ban_date);
		mysql_tquery(1, string);
		gAdmin[playerid][ADMIN_BAN] += 1;
		return 1;
	}

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offwarn на %s", PI[playerid][pNames], tmp);
	logs(1, log_str, 0);
	return 1;
}
publics: Delete(playerid, tmp[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SCMF(playerid, -1, ""#net"[ MySql ] Аккаунт %s не найден в базе данных.", tmp);
	string = "";
	mysql_format(1, string, MAX_STR, "DELETE FROM `accounts` WHERE `Name` = '%e'", tmp);
	mysql_tquery(1, string);
	SCMF(playerid, COLOR_SERVER, "Аккаунт с именем %s был успешно удален!", tmp);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /del на %s", PI[playerid][pNames], tmp);
	logs(1, log_str, 0);
	return 1;
}
publics: OffLeader(playerid, tmp[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SCMF(playerid, -1, ""#net"[ MySql ] Аккаунт %s не найден в базе данных.", tmp);
	string = "";
	mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pLeader` = '0', `pMember` = '0', `pRank` = '0' WHERE `Name` = '%e'", tmp);
	mysql_tquery(1, string);
	SCMF(playerid, COLOR_GREY, "Аккаунт %s был снят с поста лидера", tmp);
	
	format(string, sizeof(string), "[A] %s снял %s с поста лидера", PI[playerid][pNames], tmp);
	SendAdminMessage(COLOR_GREY, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offleader на %s", PI[playerid][pNames], tmp);
	logs(1, log_str, 0);

	return 1;
}
publics:base_police(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "В базе данных нет такого аккаунта!");
	new nicks[24], fraction_name[32], business_name[32], rank_name[32];
	cache_get_field_content(0, "Name", nicks, 1, 24);
	if(!cache_get_field_content_int(0, "pMember")) fraction_name = "Нет";
	else fraction_name = GetMember[cache_get_field_content_int(0, "pMember")-1];
	if(cache_get_field_content_int(0, "pRank")<=0 || cache_get_field_content_int(0, "pMember")<=0) rank_name = "Нет";
	else rank_name = PlayerRank[cache_get_field_content_int(0, "pMember")-1][cache_get_field_content_int(0, "pRank")-1];
	if(cache_get_field_content_int(0, "pPbiskey") == -1) business_name = "Нет";
	else business_name = BizInfo[cache_get_field_content_int(0, "pPbiskey")][bName];
	string = "";
	format(string, 400, ""WHITE"База данных полицейского департамента:\n- Имя:\t\t\t\t%s\n- Фракция:\t\t\t%s\n- Ранг (звание):\t\t\t%s\n- Номер дома:\t\t\t%d\n- Бизнес:\t\t\t%s\n- Номер заправки:\t\t%d",
	nicks, fraction_name, rank_name, cache_get_field_content_int(0, "pPhousekey"), business_name, cache_get_field_content_int(0, "pPsbiskey"));
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_LIST, ""SERVER"Ответ от базы данных:", string, "Закрыть", "");
	return 1;
}
publics: OffHelper(playerid, tmp[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SCMF(playerid, COLOR_WHITE, "Аккаунт %s не найден в базе данных.", tmp);
	string = "";
	mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pHelper` = '0', `pHelperAns` = '0' WHERE `Name` = '%e'", tmp);
	mysql_tquery(1, string);
	SCMF(playerid, COLOR_WHITE, "Аккаунт %s был снят с поста хелпера!", tmp);
	
	format(string, sizeof(string), "[A] %s снял %s с поста хелпера", PI[playerid][pNames], tmp);
	SendAdminMessage(COLOR_GREY, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offhelper на %s", PI[playerid][pNames], tmp);
	logs(1, log_str, 0);

	return 1;
}
publics: OffAdmin(playerid, tmp[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SCMF(playerid, COLOR_WHITE, "Аккаунт %s не найден в базе данных.", tmp);
	if(!strcmp(tmp, FD1) || !strcmp(tmp, FD4)) return SCMF(playerid, COLOR_WHITE, "Аккаунт %s невозможно снять.", tmp);
	string = "";
	mysql_format(1, string, MAX_STR, "DELETE FROM `admin` WHERE `name`='%e'", tmp);
	mysql_tquery(1, string);
	SCMF(playerid, COLOR_WHITE, "Аккаунт %s был снят с поста админа!", tmp);
	
	format(string, sizeof(string), "[A] %s снял %s с поста администратора", PI[playerid][pNames], tmp);
	SendAdminMessage(COLOR_GREY, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offadmin на %s", PI[playerid][pNames], tmp);
	logs(1, log_str, 0);

	return 1;
}
publics: getonDate(playerid, name[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Такого аккаунта не существует.");
	new GetonDate[30];
	cache_get_field_content(0, "pGetonDate", GetonDate, 1, 30);
	SCMF(playerid, COLOR_GREY, "Name: %s | Последний раз авторизовался: %s", name, GetonDate);
	return 1;
}
forward GetAdminLevel(playerid, name[]);
public GetAdminLevel(playerid, name[])
{
	new rows = cache_num_rows();
	if(rows) PI[playerid][pAdmin] = cache_get_field_content_int(0, "pAdmin");
	return true;
}
publics:LoginCallback(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		if(GetPVarInt(playerid, "wrongPass") == 2) return SCM(playerid,COLOR_GREY,"Вы кикнуты с сервера за неверный ввод пароля. Пожалуйста попробуйте позже!"), KickEx(playerid);
		SCMF(playerid, COLOR_LIGHTRED, "Вы ввели неверный пароль! У вас осталось (%d) попытки", 3 - GetPVarInt(playerid, "wrongPass"));
		SetPVarInt(playerid, "wrongPass", GetPVarInt(playerid, "wrongPass")+1);
		AuthenticationDialog(playerid);
		return true;
	}
	if(PI[playerid][pLoadNames] != PI[playerid][pNames])
	{
		SendClientMessage(playerid, COLOR_REDD, "Уважаемый игрок! В данный момент некие проблемы с сервером!");
		SendClientMessage(playerid, COLOR_REDD, "База данных перегружена и не может обработать Ваш аккаунт!");
		SendClientMessage(playerid, COLOR_REDD, "Зайдите через некоторое время (через 2-5 минут).");
		SendClientMessage(playerid, COLOR_REDD, "Мы делаем все, чтобы защитить Ваш аккаунт от слета!");
		SendClientMessage(playerid, COLOR_REDD, "По возможности отправьте скриншот с этой записью в раздел Баги/Ошибки.");
		SCMF(playerid, COLOR_GREEN, "Connect Name: %s | Load Name: %s | ID: %i", PI[playerid][pNames], PI[playerid][pLoadNames], PI[playerid][pID]);
		return KickEx(playerid);
	}
	PI[playerid][pLogin] = true;
	if(GetPVarInt(playerid, "reg_check")) PI[playerid][pID] = cache_get_field_content_int(0, "id");
	TogglePlayerSpectating(playerid, false);
	UpdatePlayerData(playerid, "pOnline", 1);
	/* pAchatFull, pSkritAlogin */
	cache_get_field_content(0, "pKey", PI[playerid][pKey], 1, 30);
	PI[playerid][pLevel] = cache_get_field_content_int(0, "pLevel");
	PI[playerid][pAdminzp] = cache_get_field_content_int(0, "pAdminzp");
	PI[playerid][pHouse] = cache_get_field_content_int(0, "pPhousekey");
	PI[playerid][pBusiness] = cache_get_field_content_int(0, "pPbiskey");
	PI[playerid][pFilling] = cache_get_field_content_int(0, "pPsbiskey");
	PI[playerid][pCar][0] = cache_get_field_content_int(0, "pCar");
	PI[playerid][pCar][1] = cache_get_field_content_int(0, "pCar2");
	PI[playerid][pCar][2] = cache_get_field_content_int(0, "pCar3");
	PI[playerid][pMats] = cache_get_field_content_int(0, "pMats");
	PI[playerid][pHelper] = cache_get_field_content_int(0, "pHelper");
	PI[playerid][pHelperAns] = cache_get_field_content_int(0, "pHelperAns");
	PI[playerid][pGhettoKillCount] = cache_get_field_content_int(0, "kill_capture");
	PI[playerid][pGhettoDeathCount] = cache_get_field_content_int(0, "pGhettoDeathCount");
	if (cache_get_field_content_int(0, "pDRInections") > unix) PI[playerid][pDRInections] = 1;
	else PI[playerid][pDRInections] = 0;
	PI[playerid][pSex] = cache_get_field_content_int(0, "pSex");
