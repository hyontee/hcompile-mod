cmd:alogin(playerid)
{
	if(!GetAccessAdmin(playerid, 1))
	{
		if(GetPVarInt(playerid, "CmdTime:Alogin") > unix)
			return true;

		new query_str[63 + 1];
		mysql_format(1, query_str, sizeof query_str, "SELECT * FROM `admin` WHERE `Name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, query_str, "alogin1", "ds", playerid, PI[playerid][pNames]);
		SetPVarInt(playerid, "CmdTime:Alogin", unix + 5);
	}
	return 1;
}

cmd:alogout(playerid)
{
	if(GetAccessAdmin(playerid, 1))
	{
		if(GetPVarInt(playerid, "CmdTime:ALogout") > unix)
			return true;

		new query_str[170 + 1];
		mysql_format(1, query_str, sizeof query_str, "UPDATE `admin` SET `kick` = '%d', `ban` = '%d', `mute` = '%d', `pm` = '%d', `warn` = '%d', `jail` = '%d' WHERE `Name` = '%e' LIMIT 1", gAdmin[playerid][0], gAdmin[playerid][1], gAdmin[playerid][2], gAdmin[playerid][3], gAdmin[playerid][4], gAdmin[playerid][5], PI[playerid][pNames]);
		mysql_tquery(1, query_str);

		new str[80 + 1];
		format(str, sizeof str, "[A] %s вышел из под админки [IP: %s]", PI[playerid][pNames], PI[playerid][pIP]);
		SendAdminMessage(0xEAC700FF, str);
		SetPVarInt(playerid, "playerAdmin", 0);
		SetPVarInt(playerid, "CmdTime:ALogout", unix + 5);
	}
	return true;
}

cmd:changekey(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	string = "";
	mysql_format(1, string, MAX_STR, "SELECT * FROM `admin` WHERE `name` = '%e'", PI[playerid][pNames]);
	mysql_tquery(1, string, "changekey", "ds", playerid, PI[playerid][pNames]);
	return 1;
}
cmd:offadminy(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "u", params[0])) return SendEsp(playerid, "/offadminy [ID]");
		if(!strcmp(PI[params[0]][pNames], FD1) || !strcmp(PI[params[0]][pNames], FD2) || !strcmp(PI[params[0]][pNames], FD3)
		|| !strcmp(PI[params[0]][pNames], FD4)) return ErrorMessage(playerid, "Запрещено снять разработчика!");
		if(PI[params[0]][pAdmin] < 1) return 1;
		DeleteAdministration(params[0], PI[params[0]][pNames]);
	}
	return 1;
}
cmd:setadmin(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		new Name[24], Level;
		if(sscanf(params, "s[24]d", Name, Level)) return SendEsp(playerid, "/setadmin [ИМЯ] [УРОВЕНЬ]");
		if((!strcmp(Name, FD1) || !strcmp(Name, FD2) || !strcmp(Name, FD3) || !strcmp(Name, FD4)) && Level < 1) return ErrorMessage(playerid, "Запрещено снять разработчика!");
		if(Level > 14 || Level < 0) return SendClientMessage(playerid, -1, ""#information"Значение не должно быть меньше 0 и больше 14!");
		string = "";
		mysql_format(1, string, MAX_STR, "SELECT * FROM `admin` WHERE `name` = '%e'", Name);
		mysql_tquery(1, string, "Moderator", "dsd", playerid, Name, Level);
		string = "";
		mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", Name);
		mysql_tquery(1, string);
	}
	return 1;
}
cmd:makeadmin(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;

	if(gAdminReason[playerid][ADMIN_MAKEADMIN]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	new nameadm[25];
	{
		if(sscanf(params,"dd", params[0], params[1])) return SCM(playerid, -1, ""#information"/makeadmin [id] [уровень] ");
		if(!IsPlayerConnected(params[0])) return SCM(playerid, -1 ,""#net"Игрок оффлайн");
		if((!strcmp(params[0], FD1, true) || !strcmp(params[0], FD2, true) || !strcmp(params[0], FD3, true) || !strcmp(params[0], FD4, true)) && params[1] < 1) return ErrorMessage(playerid, "Запрещено снимать разработчика!");
		GetPlayerName(params[0], nameadm, sizeof(nameadm));
		if(params[1] == 0)
		{
			if(D_FULL(PI[params[0]][pNames]))
			{
		        new strch[350];
				format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
				SendAdminMessage(COLOR_RED, strch);
		        KickEx(playerid);
		        return 1;
			}
		}
		if(params[1] > 13 || params[1] < 0) return SCM(playerid, -1, ""#information"Значение не должно быть меньше 0 и больше 13!");
	    SCMF(params[0], COLOR_SERVER, "Администратор %s повысил/понизил Вас до %d уровня администрирования.", PI[playerid][pNames], params[1]);
		mysql_format(1, string, MAX_STR, "SELECT * FROM `admin` WHERE `name` = '%e'", nameadm);
	 	mysql_tquery(1, string, "Moderator", "dsd",playerid,nameadm,params[1]);
		format(string, MAX_STR, "[A] %s назначил администратора: %s | lvl: %d", PI[playerid][pNames],PI[params[0]][pNames],params[1]);
	 	SendAdminMessage(COLOR_GREY, string);
		new str[120];
		format(str, sizeof(str), "выдал %i лвл админ-прав", params[1]);
		AddaLog(PI[playerid][pNames], str, PI[params[0]][pNames], "", "", "");
	}
	return 1;
}
cmd:setprefix(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(gAdminReason[playerid][ADMIN_SETPREFIX]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "ds[60]", params[0], params[1])) return SendClientMessage(playerid, COLOR_GRAD1, " Введите: /setprefix [id] [префикс]");
	SetPVarInt(playerid, "prefixid", params[0]);
	SetPVarString(playerid, "temp_prefix", params[1]);
	ShowPlayerDialog(playerid, 19982, DIALOG_STYLE_LIST, "Выберите цвет префикса", "{FFFFFF}Белый\n{089401}Зелёный\n{56FB4E}Светло зелёный\n{49E789}Ярко зелёный\n{2A9170}Бирюзовый\n{9ED201}Жёлто-зелёный\n{279B1E}Тёмно-зелёный\n{51964D}Серо-зелёный\n{FF0606}Красный\n{F68F67}Ярко-красный\n{F45000}Оранжевый\n{BE8A01}Коричневый\n{B30000}Тёмно-красный\n{954F4F}Cеро-красный\n{E7961D}Жёлто-оранжевый\n{E6284E}Малиновый\n{FF00EF}Розовый\n{110CE7}Синий\n{0CD7E7}Голубой\n{139BEC}Синяя сталь\n{2C9197}Сине-зелёный\n{114D71}Тёмно-синий\n{7700FF}Фиолетовый\n{B313E7}Индиго\n{758C9D}Серо-синий\n{FFDE24}Жёлтый\n{FFEE8A}Кукурузный\n{DDB201}Золотой\n{DDA701}Старое золото\n{B0B000}Оливковый\n{868484}Серый\n{B8B6B6}Серебро\n{333333}Чёрный", "ОК", "Закрыть");
	return 1;
}
cmd:asellhouse(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_GRAD1, " Введите: /asellhouse [houseid]");
		if(params[0] > MAX_HOUSE) return 1;
		if(IsPlayerConnected(HouseInfo[params[0]][hOwner])) return 1;
		string = "";
		mysql_format(1, string, 128, "UPDATE `accounts` SET `pPhousekey` = '-1' WHERE `Name` = '%e'", HouseInfo[params[0]][hOwner]);
		mysql_tquery(1, string);
		mysql_format(1, string, 128, "UPDATE `house` SET `hRent` = '-', `hRent` = '-' WHERE `hID` = '%d'", params[0]);
		HouseInfo[params[0]][hHel] = 0;
		HouseInfo[params[0]][hLock] = 1;
		HouseInfo[params[0]][hOwned] = 0;
		HouseInfo[params[0]][hSafe] = 0;
		new id = -1;
		foreach(Player, i)
		{
		    if(PI[i][pHouse] == params[0] && IsPlayerConnected(i)) id = i;
		}
		if(id!=-1) DestroyVehicle(caridhouse[id][0]), caridhouse[id][0] = 0, DestroyVehicle(caridhouse[id][1]), caridhouse[id][1] = 0, DestroyVehicle(caridhouse[id][2]), caridhouse[id][2]=0;
		for(new i = 0; i != 5; i++) HouseInfo[params[0]][hGun][i] = 0, HouseInfo[params[0]][hGunAmmo][i] = 0, HouseInfo[params[0]][hEat][i] = 0;
		HouseInfo[params[0]][hGarage] = 0;
		HouseInfo[params[0]][hSubsidions] = 0;
		strmid(HouseInfo[params[0]][hRent], "-", 0, strlen("-"), 255);
		strmid(HouseInfo[params[0]][hRent1], "-", 0, strlen("-"), 255);
		SendClientMessage(playerid, COLOR_GREY, "Дом продан.");
		strmid(HouseInfo[params[0]][hOwner], "The State", 0, strlen("The State"), 255);
		UpdateIconHouse(params[0]);
		DestroyDynamic3DTextLabel(HouseInfo[params[0]][LabelText][1]);
		string = "";
		format(string, 215, "Номер дома: {79F84B}%d"WHITE"\nГосударственная цена: {79F84B}%i$"WHITE"\nДом: {79F84B}%s"WHITE"", HouseInfo[params[0]][hID], HouseInfo[params[0]][hValue], (HouseInfo[params[0]][hOwned]?("Занят"):("Свободен")));
		HouseInfo[params[0]][LabelText][1] = CreateDynamic3DTextLabel(string, -1, HouseInfo[params[0]][hEnter][0], HouseInfo[params[0]][hEnter][1], HouseInfo[params[0]][hEnter][2], 9.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0);
		return 1;
	}
	else ErrorMessage(playerid, "Вы не главный администратор!");
	return 1;
}
cmd:hmenu(playerid)
{
	if(PI[playerid][pHouse] == -1 && PI[playerid][pArendaHouse] == -1) return SendClientMessage(playerid, -1, "Вы не владелец жилого дома");
	new Float: x, Float: y, house;
	if(PI[playerid][pArendaHouse] == -1) house = PI[playerid][pHouse];
	else house = PI[playerid][pArendaHouse];
	x = HouseInfo[house][hEnter][0];
	y = HouseInfo[house][hEnter][1];
	new ids = GetCityName ( x, y );
	if(!PlayerToPoint(50.0, playerid, HouseInfo[house][hExit][0], HouseInfo[house][hExit][1], HouseInfo[house][hExit][2]) && !PlayerToPoint(50.0, playerid, 958.6309,2148.0698,1004.6840) && !PlayerToPoint(5.0, playerid, HouseInfo[house][hEnter][0], HouseInfo[house][hEnter][1], HouseInfo[house][hEnter][2])) return SendClientMessage(playerid, -1, "Вы должны находится в доме / гараже");
	string = "";
	format(string, 700, ""WHITE"Класс дома:\t\t\t\t{FFE800}%s\n"WHITE"Дома:\t\t\t\t№%d\nГород/Село\t\t\t\t%s\nСтоимость:\t\t\t\t%d\nДвери:\t\t\t\t\t{FFB100}%s\n"WHITE"Модель домашнего авто #1:\t\t%s\n"WHITE"Модель домашнего авто #2:\t\t%s\n"WHITE"Модель домашнего авто #3:\t\t%s\n"WHITE"Аптечки:\t\t\t\t%d\n\n"WHITE"Гараж:\t\t\t\t\t%s\nСейф:\t\t\t\t\t%s\n\nЖилец №1:\t\t\t\t%s\nЖилец №2:\t\t\t\t%s",
	GetHouseClass[HouseInfo[PI[playerid][pHouse]][hKlass]], house, gSAZonesCity[ids][SAZONE_NAME], HouseInfo[house][hValue], (HouseInfo[house][hLock] ? ("Закрыты") : ("Открыты")), VehicleNames[PI[playerid][pCar][0]-400], VehicleNames[PI[playerid][pCar][1]-400], VehicleNames[PI[playerid][pCar][2]-400], HouseInfo[house][hHel], (HouseInfo[house][hGarage] ? ("Имеется") : ("Не имеется")), (HouseInfo[house][hSafe] ? ("Имеется") : ("Не имеется")), HouseInfo[house][hRent], HouseInfo[house][hRent1]);
	ShowPlayerDialog(playerid, 5301, DIALOG_STYLE_MSGBOX, ""SERVER"Панель управления домом", string, "Изменить", "Выйти");
	return 1;
}
cmd:sellhouse(playerid)
{
	new bouse = PI[playerid][pHouse];
	if(bouse != -1 && !strcmp(PI[playerid][pNames], HouseInfo[PI[playerid][pHouse]][hOwner], true))
	{
		if(PlayerToPoint(5, playerid, HouseInfo[bouse][hExit][0], HouseInfo[bouse][hExit][1], HouseInfo[bouse][hExit][2])) ShowPlayerDialog(playerid, 5033, DIALOG_STYLE_MSGBOX, ""SERVER"Продажа имущества", ""WHITE"Вы действительно хотите продать дом государству?", "Да", "Нет");
		else return ErrorMessage(playerid, "Вы не у себя дома");
	}
	else return ErrorMessage(playerid, "Вы не владелец дома");
	return 1;
}
cmd:mask(playerid)
{
	if(GetPVarInt(playerid, "MaskPlayer"))
	{
		format(string, 100, "%s снял(а) маску", PI[playerid][pNames]);
		SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 20.0, 10000);
		GameTextForPlayer(playerid, "~r~Invisible off", 5000, 3);
		ApplyAnimation(playerid, "shop", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 1);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		DeletePVar(playerid, "MaskPlayer");
		return 1;
	}
	if(!GetPVarInt(playerid, "U_Mask") && !PI[playerid][pDRInections]) return ErrorMessage(playerid, "У вас нет маски, купите ее в 24/7");
	SetPlayerColor(playerid, 0x7a766700);
	GameTextForPlayer(playerid, "~b~Invisible on", 5000, 3);
	ApplyAnimation(playerid, "shop", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 1);
	SetPlayerChatBubble(playerid, "надел(а) маску", 0xDD90FFFF, 30.0, 10000);
	SendClientMessage(playerid, COLOR_GREY, "Вы успешно надели маску, снять ее можно повторно введя /mask");
	SetPVarInt(playerid, "MaskPlayer", true);
	DeletePVar(playerid, "U_Mask");
	return 1;
}
cmd:healme(playerid)
{
	if(lastUseHealme[playerid] > unix) return SendClientMessage(playerid, -1, "Не так часто! (1 раз в 5 сек)");
	if(!PI[playerid][pHealing] && !PI[playerid][pDRInections]) return SendClientMessage(playerid, CGRAY, "У вас нет аптечки");
	new Float:health;
	GetPlayerHealth(playerid, health);
	SetPlayerHealth(playerid, (health+60.0 > 100.0 ? (100.0) : (health+60)));
	ClearAnimations(playerid);
	MeAction(playerid, "перебинтовал(а) рану");
	SetPlayerChatBubble(playerid, "+60 HP", COLOR_SERVER, 20.0, 10000);
	ApplyAnimation(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 1);
	if(!PI[playerid][pDRInections]) PI[playerid][pHealing] -= 1;
	UpdatePlayerData(playerid, "pApteka", PI[playerid][pHealing]);
	SetPVarInt(playerid, "anim_using", unix + 5);
	lastUseHealme[playerid] = unix + 5;
	return 1;
}
cmd:nheal(playerid, params[])
{
	if(!IsAMedic(playerid)) return 1;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/nheal [id]");
	if(params[0] == playerid) return 1;
	if(!ProxDetectorS(1.5, playerid, params[0])) return ErrorMessage(playerid, "Вы слишком далеко от игрока.");
	if(!GetPVarInt(playerid, "StartRabWork")) return SendClientMessage(playerid, -1, ""net"Вы не начала рабочий день!");
	string = "";
	format(string, 126, ""WHITE"Вы предложили вылечить %s от наркозависимости.", PI[params[0]][pNames], healpric);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, 64, ""WHITE"Вы желаете вылечиться от наркозависимости за %d вирт?", healpric);
	ShowPlayerDialog(params[0], 5523, DIALOG_STYLE_MSGBOX, ""SERVER"Лечение", string, "Да", "Нет");
	SetPVarInt(params[0], "HealOffer", playerid);
	SetPVarInt(params[0], "HealPrice", healpric);
	return 1;
}
cmd:healhouse(playerid)
{
	if(!GetPVarInt(playerid, "HouseID") && !PlayerToPoint(5, playerid, HouseInfo[GetPVarInt(playerid, "HouseID")][hExit][0], HouseInfo[GetPVarInt(playerid, "HouseID")][hExit][1], HouseInfo[GetPVarInt(playerid, "HouseID")][hExit][2]) && GetPlayerVirtualWorld(playerid) != GetPVarInt(playerid, "HouseID")+50) return 1;
	if(!HouseInfo[GetPVarInt(playerid, "HouseID")][hHel]) return ErrorMessage(playerid, "В этом месте нет аптечек");
	SendClientMessage(playerid, COLOR_WHITE, "Вы были вылечены до 100 процентов");
	format(string, 25, "Осталось %d аптечек", HouseInfo[GetPVarInt(playerid, "HouseID")][hHel]);
	SendClientMessage(playerid, 0x6495EDFF, string);
	HouseInfo[GetPVarInt(playerid, "HouseID")][hHel] --;
	SetPlayerHealth(playerid, 100);
	SetPlayerChatBubble(playerid, "использовал аптечку", 0xDD90FFFF, 30.0, 10000);
	return 1;
}
cmd:fixcar(playerid)
{
	if(PI[playerid][pHouse] == -1 && PI[playerid][pArendaHouse] == -1) return ErrorMessage(playerid, "Вы не имеете дома");
	if(PI[playerid][pCash] < 500) return ErrorMessage(playerid, "Не достаточно денег!");
	string = ""WHITE"Слот\t"WHITE"Название\n";
	format(string, 250, "%s\
	"WHITE"Транспортное средство #1\t[{"#cBLUE"}%s"WHITE"]\n\
	"WHITE"Транспортное средство #2\t[{"#cBLUE"}%s"WHITE"]\n\
	"WHITE"Транспортное средство #3\t[{"#cBLUE"}%s"WHITE"]",
	string,
	VehicleNames[PI[playerid][pCar][0]-400],
	VehicleNames[PI[playerid][pCar][1]-400],
	VehicleNames[PI[playerid][pCar][2]-400]);
	ShowPlayerDialog(playerid, 8237, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"Служба доставки автомобилей.", string, "Принять", "Отмена");
	return 1;
}
cmd:sellcar(playerid)
{
	new caren = PI[playerid][pCar][0];
	if(caren == 508)
	{
	    if(!IsPlayerInRangeOfPoint(playerid, 7.0, PI[playerid][CarPos][0], PI[playerid][CarPos][1], PI[playerid][CarPos][2])) return SCM(playerid, COLOR_GREY, "Надо находиться рядом с домом на колёсах");
		DestroyVehicle(caridhouse[playerid][0]);
		PI[playerid][pCar][0] = 510;
		UpdatePlayerData(playerid, "pCar", PI[playerid][pCar][0]);
		gPlayerTuning[playerid][0][0]  = -1;
		gPlayerTuning[playerid][0][1]  = 0;
		gPlayerTuning[playerid][0][2]  = -1;
		gPlayerTuning[playerid][0][3]  = -1;
		gPlayerTuning[playerid][0][4]  = -1;
		gPlayerTuning[playerid][0][5]  = -1;
		gPlayerTuning[playerid][0][6]  = -1;
		gPlayerTuning[playerid][0][7]  = -1;
		gPlayerTuning[playerid][0][8]  = -1;
		gPlayerTuning[playerid][0][9]  = -1;
		gPlayerTuning[playerid][0][10] = -1;
		gPlayerTuning[playerid][0][11] = -1;

		DestroyDynamic3DTextLabel(VehInfo[caridhouse[playerid][0]][vTrailerDom3d]);
		VehInfo[caridhouse[playerid][0]][vTrailerDom3d] = Text3D:-1;

		UpdateTuning(playerid, 1);
		LoadCarPlayer(playerid, 1);
		SCM(playerid, COLOR_WHITE, "Вы продали свой дом на колесах за "GREEN"$250.000");
		return Hook_GivePlayerMoney(playerid, 250000);
	}
	if(PI[playerid][pHouse] == -1 && PI[playerid][pArendaHouse] == -1) return SendClientMessage(playerid, COLOR_RED, "У вас нет дома");
	if(PI[playerid][pArendaHouse] == -1) format(string, sizeof(string), "{"#cBLUE"}Выберите автомобиль для продажи!\n"WHITE"Первое транспортное средство {"#cBLUE"}[%s]"WHITE"\nВторое транспортное средство {"#cBLUE"}[%s]\nТретье транспортное средство {"#cBLUE"}[%s]", VehicleNames[PI[playerid][pCar][0]-400], VehicleNames[PI[playerid][pCar][1]-400], VehicleNames[PI[playerid][pCar][2]-400]);
	else format(string, sizeof(string), "{"#cBLUE"}Выберите автомобиль для продажи!\n"WHITE"Первое транспортное средство {"#cBLUE"}[%s]", VehicleNames[PI[playerid][pCar][0]-400]);
	ShowPlayerDialog(playerid, dSellCar, DIALOG_STYLE_LIST, ""SERVER"Продажа транспортого средства", string, "Продать", "Отмена");
	return 1;
}
cmd:pgetip(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 3))
		return true;
	if(sscanf(params, "s[30]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/pgetip [ip]");
	SendClientMessage(playerid, COLOR_REDD, "Игроки с данного IP адреса:");
	if (!strcmp(params[0], "46.174.53.176", false)) return 1;
	foreach(Player, i)
	{
		if(!strcmp(PI[i][pIP], params[0])) { SCMF(playerid, COLOR_WHITE, "[%d] %s | IP %s", i, PI[i][pNames], PI[i][pIP]); }
	}
	return 1;
}
cmd:agetipreg(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 3))
		return true;
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/agetipreg [id]");
	if(!IsPlayerConnected(params[0])) return 1;
	SCMF(playerid, COLOR_GREY, "Ник: %s | IP Reg: %s", PI[params[0]][pNames], PI[params[0]][pIpReg]);
	return 1;
}
cmd:unprison(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 2))
		return true;
	new Reason[64];
	if(sscanf(params, "us[64]", params[0], Reason)) return SendEsp(playerid, "/unprison [ид] [Reason]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return 1;
	if(PI[params[0]][pPrisonTime]<=0 && PI[params[0]][pJailTime]<=0) return ErrorMessage(playerid, "Игрок не в деморгане/тюрьме");
	SCMF(playerid, 0x09B000AA, "Вы освободили %s. Причина: %s", PI[params[0]][pNames], Reason);
	PI[params[0]][pPrisonTime] = 0;
	PI[params[0]][pJailTime] = 0;
	PI[params[0]][pWanted] = 0;
	string = "";
	mysql_format(1, string, 155, "UPDATE `accounts` SET `pJailTime` = '0', `pPrisonTime` = '0', `pWanted` = '0' WHERE `id` = '%d'", PI[params[0]][pID]);
	mysql_tquery(1, string);
	SendClientMessage(params[0], 0x09B000AA, "Вы освобождены администратором "NAME_PROECT"."), SCMF(params[0], 0x09B000AA, "Причина освобождения: %s", Reason);
	format(string, 128, "Администратор %s[%d] освободил %s[%d] из тюрьмы. Причина: %s", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0], Reason);
	SendClientMessageToAll(COLOR_LIGHTRED, string);
	SpawnPlayer(params[0]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /unprison на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:uval(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 12))
		return true;
	if(sscanf(params, "ds[128]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/uval [id игрока] [причина]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return 1;
	if (PI[params[0]][pMember] < 1) return 1;
	if(IsPlayerInAnyVehicle(params[0])) RemovePlayerFromVehicle(params[0]);
	SCMF(params[0], 0x6ab1ffaa, "Администратор %s выгнал вас из организации. Причина: %s.", PI[playerid][pNames], params[1]);
	SCMF(playerid, 0x6ab1ffaa, "Вы выгнали %s из организации. Причина: %s.", PI[params[0]][pNames], params[1]);
	format(string, sizeof(string), "[A] %s[%i] уволил(-a) игрока %s[%i]. Причина: %s.", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0], params[1]);
    SendAdminMessage(COLOR_GREY, string);
	SendClientMessage(params[0], COLOR_WHITE, "Теперь вы обычный гражданин...");
	SetPlayerArmourAC(params[0], 0);
	ResetPlayerWeapons(params[0]);
	if(StartRabWork(params[0]))
	{
		SendClientMessage(params[0], COLOR_BLUE, "Ваш рабочий день окончен!");
		SetPVarInt(params[0], "StartRabWork", 0);
	}
	PI[params[0]][pMember] = 0;
	PI[params[0]][pLeader] = 0;
	PI[params[0]][pRank] = 0;
	PI[params[0]][vig] = 0;
	string = "";
	mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `vig` = '0' WHERE `id` = '%d'", PI[params[0]][pID]);
	mysql_tquery(1, string);

	PI[params[0]][pPayDayMember] = 0, UpdatePlayerData(params[0], "pPayDayMember", PI[params[0]][pPayDayMember]);

	SetPlayerColor(params[0], FI[PI[params[0]][pMember]][fColor]);
	SetPlayerSkin(params[0], PI[params[0]][pChar]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /uval на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}

cmd:vig(playerid, params[])
{
	if(!PI[playerid][pLeader]) return ErrorMessage(playerid, "Доступно только лидерам организации");
	if(sscanf(params, "dds[125]", params[0], params[1], params[2])) return SendEsp(playerid, "/vig [id] [кол-во] [причина]");
	if(!IsPlayerConnected(params[0]) || PI[params[0]][vig] > 2 || PI[params[0]][pLeader]) return 1;
	if(PI[params[0]][pMember] != PI[playerid][pMember]) return ErrorMessage(playerid, "Игрок не в Вашей организации");
	if(GetPVarInt(playerid, "AFvig") > unix) return ErrorMessage(playerid, "Использовать данную команду можно раз в 5 секунд");
 	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя выдать выговор самому себе");
	if(params[1] < 0 || params[1] > 3) return ErrorMessage(playerid, "Нельзя больше 3 и меньше 0");
	if(params[1] == 0)
	{
		PI[params[0]][vig] = 0;
		UpdatePlayerData(params[0], "vig", PI[params[0]][vig]);
		SCMF(playerid, COLOR_GREY, "Вы аннулировали выговоры игроку %s. Причина: %s", PI[params[0]][pNames], params[2]);
		SCMF(params[0], COLOR_SERVER, "Лидер организации %s аннулировал Вам все выговоры. Причина: %s", PI[playerid][pNames], params[2]);
	}
	PI[params[0]][vig] += params[1];
	UpdatePlayerData(params[0], "vig", PI[params[0]][vig]);
	SCMF(params[0], COLOR_SERVER, "Лидер организации %s выдал Вам %d выговора. Причина: %s", PI[playerid][pNames], params[1], params[2]);
	SCMF(playerid, COLOR_SERVER, "Вы выдали %d выговора игроку %s. Причина: %s", params[1], PI[params[0]][pNames], params[2]);
	SetPVarInt(playerid, "AFvig", unix+5);
	if(PI[params[0]][vig] >= 3)
	{
		SetPlayerArmourAC(params[0], 0);
		ResetPlayerWeapons(params[0]);
		PI[params[0]][pMember] = 0;
		PI[params[0]][pLeader] = 0;
		PI[params[0]][pRank] = 0;
		PI[params[0]][vig] = 0;
		PI[params[0]][pModel] = 0;
		SetPlayerInterior(params[0], 0);
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `vig` = '0', `pModel` = '0' WHERE `id` = '%d'", PI[params[0]][pID]);
		mysql_tquery(1, string);
		SpawnPlayer(params[0]);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Вы уволены из организации, поскольку получили 3-и выговора!");
	}
	return 1;
}
cmd:lvig(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(gAdminReason[playerid][ADMIN_LVIG]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "dds[125]", params[0], params[1], params[2])) return SendEsp(playerid, "/lvig [id] [кол-во] [причина]");
	if(GetPVarInt(playerid, "AFAvig") > unix) return ErrorMessage(playerid, "Использовать данную команду можно раз в 5 секунд");
	if(D_FULL(PI[params[0]][pNames]))
	{
        new strch[350];
		format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
		SendAdminMessage(COLOR_RED, strch);
        KickEx(playerid);
        return 1;
	}
	if(!PI[params[0]][pLeader]) return ErrorMessage(playerid, "Данный игрок не является лидером!");
	if(params[1] < 0 || params[1] > 3) return ErrorMessage(playerid, "Нельзя больше 3 и меньше 0");
	if(params[1] == 0)
	{
		PI[params[0]][vig] = 0;
		UpdatePlayerData(params[0], "vig", PI[params[0]][vig]);
		SCMF(playerid, COLOR_GREY, "Вы аннулировали выговоры игроку %s. Причина: %s", PI[params[0]][pNames], params[2]);
		SCMF(params[0], COLOR_SERVER, "Лидер организации %s аннулировал Вам все выговоры. Причина: %s", PI[playerid][pNames], params[2]);
	}
	PI[params[0]][vig] += params[1];
	UpdatePlayerData(params[0], "vig", PI[params[0]][vig]);
	SCMF(params[0], COLOR_SERVER, "Администратор %s выдал Вам %d выговора. Причина: %s", PI[playerid][pNames], params[1], params[2]);
	SCMF(playerid, COLOR_SERVER, "Вы выдали %d выговора лидеру %s. Причина: %s", params[1], PI[params[0]][pNames], params[2]);
	format(string, sizeof(string), "%s выдал лидеру %s %d выговора. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1], params[2]);
	SendAdminMessage(COLOR_LIGHTRED, string);
	SetPVarInt(playerid, "AFvig", unix+5);
	if(PI[params[0]][vig] >= 3)
	{
		SetPlayerArmourAC(params[0], 0);
		ResetPlayerWeapons(params[0]);
		PI[params[0]][pMember] = 0;
		PI[params[0]][pLeader] = 0;
		PI[params[0]][pRank] = 0;
		PI[params[0]][vig] = 0;
		PI[params[0]][pModel] = 0;
		SetPlayerInterior(params[0], 0);
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `vig` = '0', `pModel` = '0' WHERE `id` = '%d'", PI[params[0]][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(params[0], FI[PI[params[0]][pMember]][fColor]);
		SetPlayerSkin(params[0], PI[params[0]][pChar]);
		SpawnPlayer(params[0]);
		SendClientMessage(params[0], COLOR_LIGHTRED, "Вы были сняты с поста лидера, поскольку получили 3-и выговора!");
	}
	return 1;
}
cmd:ban(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 11))
		return true;
	if(EnableInfo[ban] == 0 && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return SendClientMessage(playerid, COLOR_LIGHTRED, "Бан временно отключен.");
	if(unix <= BanTime[playerid]) return SendClientMessage(playerid, COLOR_LIGHTRED, "Банить можно раз в 10 секунд!");
	if(gAdminReason[playerid][ADMIN_BAN]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "dds[256]", params[0], params[1], params[2])) return SendEsp(playerid, "/ban [id] [дни] [причина]");
	if(D_FULL(PI[params[0]][pNames]))
	{
        new strch[350];
		format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
		SendAdminMessage(COLOR_RED, strch);
        KickEx(playerid);
        return 1;
	}
	if(!strcmp(PI[params[0]][pNames], FD1) || !strcmp(PI[params[0]][pNames], FD2) || !strcmp(PI[params[0]][pNames], FD3)
	|| !strcmp(PI[params[0]][pNames], FD4)) return SendClientMessage(playerid, COLOR_WHITE, "Основателей запрещено банить");
	if(PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Администратора нельзя забанить");
	if(!PI[params[0]][pLogin] || GetPVarInt(params[0], "ShowKey")) return ErrorMessage(playerid, "ИДИ НА ХУЙ"), false;
	if(PI[params[0]][pLeader] > 0) return SendClientMessage(playerid, -1, "Лидера нельзя банить");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Игрок оффлайн");
	if(params[1] < 1 || params[1] > 30) return ErrorMessage(playerid, "День бана должен быть не меньше 1 и не больше 30.");
	if(!Reklama(playerid, params[2])) return 1;
	new ip[16];
	GetPlayerIp(params[0], ip, sizeof(ip));
	string = "";
	format(string, MAX_STR, "Администратор %s заблокировал аккаунт %s на %d дней. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1], params[2]);
	SendClientMessageToAll(COLOR_LIGHTRED, string);
	new data[16];
	SetPVarInt(playerid, "UnBanDate", unix + params[1]*86400), format(data, sizeof(data), "%s", date("%dd.%mm.%yyyy", unix));
	mysql_format(1, string, sizeof(string), "INSERT INTO `BanList` (`Nick`, `Admin`, `IP`, `Date`, `Reason`, `Days`, `UnbanDate`, `Status`) VALUES ('%e', '%e', '%e', '%e', '%e', '%d', '%d', '1')", PI[params[0]][pNames], PI[playerid][pNames], ip, data, params[2], params[1], GetPVarInt(playerid, "UnBanDate"));
	mysql_tquery(1, string);
	format(string, 512, "\t\t\t"WHITE"Ваш аккаунт заблокирован.\n"WHITE"Заблокирован: "SERVER"%s\n"WHITE"Заблокировал: "SERVER"%s\n"WHITE"Разбан через: "SERVER"%d дней"WHITE"\nПричина: "SERVER"%s\n"WHITE"Если вы считаете что бан выдан ошибочно.\nПодайте на администратора жалобу в группе вк (сделав скриншот F8)", PI[params[0]][pNames], PI[playerid][pNames], params[1], params[2]);
	ShowPlayerDialog(params[0], 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Блокировка аккаунта", string, "Да", "");
	format(string, 126, "Ник: %s, регистрационный IP: %s, текущий IP: %s.", PI[params[0]][pNames], PI[params[0]][pIpReg], PI[params[0]][pIP]);
	SendAdminMessage(COLOR_GREY, string);
	KickEx(params[0]);
	gAdmin[playerid][ADMIN_BAN] += 1;
	UpdateAdminData(playerid, "ban", gAdmin[playerid][ADMIN_BAN]);

	BanTime[playerid] = unix + 10;

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /ban на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);
	return 1;
}
cmd:iban(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 13))
		return true;
	if(D_FULL(PI[playerid][pNames]))
    {
		if(EnableInfo[ban] == 0 && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return SendClientMessage(playerid, COLOR_LIGHTRED, "Бан временно отключен.");
		if(sscanf(params, "ds[128]", params[0], params[1])) return SendClientMessage(playerid, -1, ""#information"Используйте: /iban [id] [причина]");
		if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
		if(!strcmp(PI[params[0]][pNames], FD1) || !strcmp(PI[params[0]][pNames], FD2) || !strcmp(PI[params[0]][pNames], FD3)
		|| !strcmp(PI[params[0]][pNames], FD4)) return SendClientMessage(playerid, COLOR_WHITE, "Основателей запрещено банить");
		if(PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Администратора нельзя забанить");
		if(!Reklama(playerid, params[1])) return 1;
		string = "";
		format(string, 200, "Администратор %s заблокировал игрока %s пожизненно. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		format(string, 126, "Ник: %s, регистрационный IP: %s, текущий IP: %s.", PI[params[0]][pNames], PI[params[0]][pIpReg], PI[params[0]][pIP]);
		SendAdminMessage(COLOR_GREY, string);
		new data[16], ip[16];
		GetPlayerIp(params[0], ip, sizeof(ip));
		SetPVarInt(playerid, "UnBanDate", unix + 604800), format(data, sizeof(data), "%s", date("%dd.%mm.%yyyy", unix));
		mysql_format(1, string, sizeof(string), "INSERT INTO `BanList` (`Nick`, `Admin`, `IP`, `Date`, `Reason`, `Days`, `UnbanDate`, `Status`) VALUES ('%e', '%e', '%e', '%e', '%e', '999', '%d', '1')", PI[params[0]][pNames], PI[playerid][pNames], ip, data, params[1], GetPVarInt(playerid, "UnBanDate"));
		mysql_tquery(1, string);
		format(string, 512, "\t\t\t"WHITE"Ваш аккаунт заблокирован.\n"WHITE"Заблокирован: "SERVER"%s\n"WHITE"Заблокировал: "SERVER"%s\n"WHITE"Разбан через: "SERVER"%d дней"WHITE"\nПричина: "SERVER"%s\n"WHITE"Если вы считаете что бан выдан ошибочно.\nПодайте на администратора жалобу в группе вк (сделав скриншот F8)", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
		ShowPlayerDialog(params[0], 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Блокировка аккаунта", string, "Да", "");

		format(string, SMALL_SIZE, "banip %s", PI[params[0]][pIpReg]);
		SendRconCommand(string);
		format(string, SMALL_SIZE, "banip %s", PI[params[0]][pIP]);
		SendRconCommand(string);
		SendRconCommand("reloadbans");

		KickEx(params[0]);
		gAdmin[playerid][ADMIN_BAN] += 1;

		new log_str[256 + 1];
		format(log_str, sizeof(log_str), "%s использовал команду /ibany на %s", PI[playerid][pNames], PI[params[0]][pNames]);
		logs(1, log_str, 0);
	}

	return 1;
}
cmd:unban(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 6)) return true;
	new Reason[64];
	if(sscanf(params, "s[24]s[64]", params[0], Reason)) return SendEsp(playerid, "/unban [ник] [причина]");
	mysql_format(1, string, sizeof(string), "SELECT * FROM `BanList` WHERE Nick = '%e'", params[0]), mysql_tquery(1, string, "UnBan", "ds", playerid, Reason);
	return 1;
}
cmd:templeader(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 9)) return true;
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/templeader [ID fraction]");
	if(params[0] > 29 || params[0] < 1) return ErrorMessage(playerid, "Нельзя меньше 1 или больше 29!");
	PI[playerid][pMember] = params[0];
	PI[playerid][pRank] = rangFractionID[params[0]-1];
	format(string, SMALL_SIZE, "Вы временно вступили в фракцию: {%s}%s", GetFractionColor[params[0]], GetMember[params[0]-1]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	SetPVarInt(playerid, "StartRabWork", 1);
	return 1;

}
cmd:makeleader(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1)) return true;
	if(gAdminReason[playerid][ADMIN_MAKELEADER]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/makeleader [ID]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || !PI[playerid][pAdmin]) return 1;
	if(PI[params[0]][pMember] > 0) return SendClientMessage(playerid, COLOR_WHITE, "Игрок во фракции");
	if(PI[params[0]][pAdmin] && PI[params[0]][pAdmin] != 14) return SCM(playerid, COLOR_WHITE, "Администратор не может быть лидером фракции ( /templeader [id фракции] )");
	if(PI[params[0]][pWarns] >= 1) return SendClientMessage(playerid, COLOR_GRAD1, "У игрока Warn.");
	string = "";
	for(new i;i!=sizeof(GetMember);i++)
	format(string, sizeof(string), "%s%s\n", string, GetMember[i]);
	ShowPlayerDialog(playerid, 1146, 2, PI[params[0]][pNames], string, "Далее", "Отмена");
	SetPVarInt(playerid, "actplayerid", params[0]);
	return 1;
}
cmd:demote(playerid, params[])
{
	if(PI[playerid][pMember] != 2 && !IsAMayor(playerid)) return ErrorMessage(playerid, "Вам недоступна эта функция!");
	if(PI[playerid][pMember] == 2 && PI[playerid][pRank] < 6) return ErrorMessage(playerid, "Вам недоступна эта функция!");
	else if(PI[playerid][pMember] >= 7 && PI[playerid][pMember] <= 9 && PI[playerid][pRank] < 5) return ErrorMessage(playerid, "Вам недоступна эта функция!");
	else if(PI[playerid][pMember] == 26 && PI[playerid][pRank] < 4) return ErrorMessage(playerid, "Вам недоступна эта функция!");
	if (sscanf(params, "us[128]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, "Введите: /demote [id игрока] [причина]");
	if (!IsPlayerConnected(params[0])) return 1;
	if (params[0] == INVALID_PLAYER_ID) return 1;
	switch (PI[params[0]][pMember])
	{
		case 2, 4, 5..9, 11..18, 22..24, 26: return ErrorMessage(playerid, "Этот человек не состоит в армии/ПД!");
	}
	if (PI[params[0]][pLeader]) return ErrorMessage(playerid, "Вы не можете уволить лидера!");
	if (!PI[params[0]][pMember]) return ErrorMessage(playerid, "Игрок не состоит во фракции!");
	if ((PI[params[0]][pMember] == 1 || PI[params[0]][pMember] == 10 || PI[params[0]][pMember] == 21) && PI[params[0]][pRank]-1 == 0)
	{
		PI[params[0]][pMember] = 19;
		PI[params[0]][pRank] = 3;
		ResetPlayerWeapons(params[0]);
		string = "";
		format(string, 128, "Агент FBI %s перевел вас обратно в армию. Причина: %s.", PI[playerid][pNames], params[1]);
		SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
		format(string, 128, "Агент FBI %s перевел %s обратно в армию. Причина: %s.", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
		SendAdminMessage(COLOR_LIGHTBLUE, string);
		format(string, 128, "Вы перевели %s обратно в армию. Причина: %s.", PI[params[0]][pNames], params[1]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		PI[params[0]][pJob]   = 0;
		PI[params[0]][pModel] = 287;
		mysql_format(1, string, 200, "UPDATE `accounts` SET `pMember` = '19', `pRank` = '3', `pModel` = '287', `pJob` = '0' WHERE `id` = '%d'", PI[params[0]][pID]);
		mysql_tquery(1, string);
		SetPlayerSkin(params[0], 287);
		return 1;
	}
	if (PI[params[0]][pRank]-1 == 0 && (PI[params[0]][pMember] == 3 || PI[params[0]][pMember] == 19 || PI[params[0]][pMember] == 27))
	{
		PI[params[0]][pRank] = 0;
		PI[params[0]][pMember] = 0;
		PI[params[0]][pLeader] = 0;
		PI[params[0]][pModel] = 0;
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pModel` = '0', `pLeader` = '0' WHERE `id` = '%d'", PI[params[0]][pID]);
		mysql_tquery(1, string);
		SetPlayerArmourAC(params[0], 0);
		SpawnPlayer(params[0]);
		ResetPlayerWeapons(params[0]);
		SetPlayerSkin(params[0], PI[params[0]][pChar]);
		format(string, 128, "Агент FBI %s уволил вас из армии. Причина: %s.", PI[playerid][pNames], params[1]);
		SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
		format(string, 128, "Агент FBI %s уволил %s из армии. Причина: %s.", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
		SendAdminMessage(COLOR_LIGHTBLUE, string);
		format(string, 128, "Вы снова гражданский", PI[playerid][pNames]);
		SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
		format(string, 128, "Вы уволили %s из армии. Причина: %s.", PI[params[0]][pNames], params[1]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		SetPVarInt(params[0], "StartRabWork", 0);
		return 1;
	}
	if(PI[params[0]][pRank] != 1)
	{
		PI[params[0]][pRank] --;
		string = "";
		format(string, 128, "Агент FBI %s понизил вас до %d ранга. Причина: %s.", PI[playerid][pNames], PI[params[0]][pRank], params[1]);
		SendClientMessage(params[0], COLOR_LIGHTBLUE, string);
		format(string, 128, "Агент FBI %s понизил %s до %d ранга. Причина: %s.", PI[playerid][pNames], PI[params[0]][pNames], PI[params[0]][pRank], params[1]);
		SendAdminMessage(COLOR_LIGHTBLUE, string);
		format(string, 128, "Вы понизили %s до %d ранга. Причина: %s.", PI[params[0]][pNames], PI[params[0]][pRank], params[1]);
		SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
		return 1;
	}
	return 1;
}
cmd:agiverank(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 9))
		return true;
	if(sscanf(params, "dd", params[0], params[1])) return SendEsp(playerid, "/agiverank [id игрока] [уровень (1 - 15)]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return 0;
	if(params[1] > 21 || params[1] < 0) return ErrorMessage(playerid, "Не менее 0 и не более 21!");
	PI[params[0]][pRank] = params[1];
	UpdatePlayerData(params[0], "pRank", params[1]);
	string = "";
	format(string, 126, "Вы были повышены в ранге администратором %s", PI[playerid][pNames]);
	SendClientMessage(params[0], 0x6495EDFF, string);
	format(string, 80, "Вы повысили %s до %d ранга.", PI[params[0]][pNames], params[1]);
	SendClientMessage(playerid, 0x6495EDFF, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /agiverank на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
CMD:agl(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 6))
		return true;
	if(sscanf(params, "d", params[0])) return SCM(playerid, -1, ""#information"/agl [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	PI[params[0]][pLicenses][0] = 1;
	PI[params[0]][pLicenses][1] = 1;
	PI[params[0]][pLicenses][2] = 1;
	PI[params[0]][pLicenses][3] = 1;
	format(string, sizeof(string), "[A] %s выдал комплект лицензий игроку %s", PI[playerid][pNames], PI[params[0]][pNames]);
	SendAdminMessage(COLOR_GREY,string);
	SCMF(params[0], COLOR_WARNING, "Администратор %s выдал вам комплект лицензий.",PI[playerid][pNames]);

	format(PI[params[0]][pLicense], 16, "%d, %d, %d, %d", PI[params[0]][pLicenses][0], PI[params[0]][pLicenses][1], PI[params[0]][pLicenses][2], PI[params[0]][pLicenses][3]);
	UpdatePlayerDataEx(params[0], "pLics", PI[params[0]][pLicense]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /agl на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:mark(playerid)
{
	if(GetAccessAdmin(playerid, 3))
	{
		GetPlayerPos(playerid, TeleportDest[playerid][0], TeleportDest[playerid][1], TeleportDest[playerid][2]);
		SendClientMessage(playerid, COLOR_WHITE, "Точка телепортирования установлена!");
	}
	return true;
}
cmd:armour(playerid)
{
	if(!IsPlayerInRangeOfPoint(playerid, 8.0, 1405.2754,-17.7662,1504.9657)) return 1;
	if(PI[playerid][pMember] != 1 && PI[playerid][pLeader] != 1) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	SetPlayerAttachedObject(playerid, 2, 19142, 1, 0.08, 0.04, 0.00, 0.0, 0.0, -7.4);
	SendClientMessage(playerid, COLOR_WHITE, "Чтобы снят введите: /armouroff");
	SetPlayerArmourAC(playerid, 100.0);
	return 1;
}
cmd:capoff(playerid)
{
	if(PI[playerid][pMember] != 1 && PI[playerid][pLeader] != 1) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	RemovePlayerAttachedObject(playerid, 3);
	return 1;
}
cmd:armouroff(playerid)
{
	if(PI[playerid][pMember] != 1 && PI[playerid][pLeader] != 1) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	RemovePlayerAttachedObject(playerid, 2);
	SetPlayerArmourAC(playerid, 0.0);
	return 1;
}
