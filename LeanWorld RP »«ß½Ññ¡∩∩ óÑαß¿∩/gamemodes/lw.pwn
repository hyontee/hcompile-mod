CMD:smp(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 8)) return true;
    if(CreateMP == false) return ErrorMessage(playerid, ""WHITE"Сначала создайте мероприятие");
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "/smp [сообщение]");

	if(!Reklama(playerid, params[0])) return 1;
	string = "";
	format(string, BIG_SIZE, "Администратор %s [МП]: %s", PI[playerid][pNames], params[0]);
	ProxDetector(100, playerid, string, 0xFFD700FF, 1);
	PI[playerid][last_reason] = params[0];
	return 1;
}
cmd:gomp(playerid, params[])
{
	if(PI[playerid][pPrisonTime] > 0) return SendClientMessage(playerid, COLOR_GREY, "Вы находитесь в ДеМоргане!");
	if(PI[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREY, "Вы находитесь в Тюрьме!");
	if(GetPVarInt(playerid, "PlayerCuffed") == 2) return SendClientMessage(playerid, COLOR_GREY, "Вы в наручниках");
	if(CreateMP == false) return SendClientMessage(playerid, COLOR_GREY, "На данный момент мероприятий нет");
	if(TeleportMP == false) return SendClientMessage(playerid, COLOR_GREY, "Телепорт на мероприятие закрыт");
	SetPlayerPos(playerid, PosMP[0], PosMP[1], PosMP[2]);
	SetPlayerInterior(playerid, IntMP);
	SetPlayerVirtualWorld(playerid, VirtMP);
	SetPlayerArmourAC(playerid, 0);
	ResetPlayerWeapons(playerid);
	SCM(playerid, COLOR_ORANGE, "- Вы были успешно телепортированы!");
	SCM(playerid, COLOR_ORANGE, "- Соблюдайте спокойствие на мероприятии во избежание кика или фриза.");
	return 1;
}
@EventTimer(count, starter);
@EventTimer(count, starter)
{
	new Float: x, Float: y, Float: z;
	GetPlayerPos(starter, x, y, z);
	if(count == 0)
	{
		foreach(new i: Player)
		{
			if(IsPlayerInRangeOfPoint(i, 50.0, x, y, z))
			{
				GameTextForPlayer(i, "~y~GO GO GO!", 1000, 6);
				PlayerPlaySound(i, 3200, 0.0, 0.0, 0.0);
				TogglePlayerControllable(i, 1);
			}
		}
	}
	else if(count > 0)
	{
		format(string, sizeof(string), "~y~MP STARTED: %d", count);
		foreach(new i: Player)
		{
			if(IsPlayerInRangeOfPoint(i, 50.0, x, y, z))
			GameTextForPlayer(i, string, 1000, 6);
		}
		SetTimerEx("@EventTimer", 1000, 0, "id", count-1, starter);
	}
	return 1;
}
stock CreateText(playerid)
{
	new texttype[128];
	switch(TypeMP)
	{
		case 1: format(texttype, sizeof(texttype), "Хелперка %i уровня", PrizMP);
		case 2: format(texttype, sizeof(texttype), "%i рублей", PrizMP);
		case 3: format(texttype, sizeof(texttype), "%i доната", PrizMP);
		case 4: format(texttype, sizeof(texttype), "Админка %i уровня", PrizMP);
	}

	format(string, sizeof(string), "{00FF7F}Мероприятие: "WHITE"%s\n{00FF7F}Приз: "WHITE"%s\n{00FF7F}Проводит мероприятие: "WHITE"%s[%d]", NameMP, texttype, PI[playerid][pNames], playerid);

	text3dmp = Create3DTextLabel(string, 0xFFFFFFFF, PosMP[0], PosMP[1], PosMP[2], 50.0, 0);
	objectmp[0] = CreateObject(18724, PosMP[0], PosMP[1], PosMP[2], 0.0, 0.0, 0.0);
	objectmp[1] = CreateObject(18728, PosMP[0], PosMP[1], PosMP[2], 0.0, 0.0, 0.0);
	return true;
}
stock getDayEx()
{
	new hour, minuite, second, year, month, day, w = gettime(), saturday = 1310155200, day_week;
	gettime(hour, minuite, second);
	getdate(year, month, day);
	while (w - saturday > 60 * 60 * 24)
	{
		w -= 60 * 60 * 24;
		day_week ++;
	}
	while (day_week >= 7) day_week -= 7;
	return day_week;
}
stock ConvertsCmdTime(number)
{
	new hours = 0, mins = 0, strfix[30];
	hours = number / 3600;
	mins = (number - hours * 3600) / 60;
	format(strfix, 30, "%d ч %d мин", hours, mins);
	return strfix;
}
stock UpdateDescription(playerid, string_desc[], connect = 0)
{
    if(connect == 1 && !GetString(PI[playerid][pDescription], "None")) return DestroyDynamic3DTextLabel(PlayerDescriptionText[playerid]);

    else if(connect == 2 && !GetString(PI[playerid][pDescription], "None"))
    {
    	new str[180];
    	format(str, sizeof(str), "%s", PI[playerid][pDescription]);
    	for(new i; i < strlen(str); i++) if(str[i] == '/') str[i] = '\n';
    	PlayerDescriptionText[playerid] = CreateDynamic3DTextLabel(str, 0xCCCCCCFF, 0.0, 0.0, -1.0, 5, playerid,-1, 0, -1, -1, -1);
    	SendClientMessage(playerid, COLOR_YELLOW, "Описание Вашего персонажа:");
    	SendClientMessage(playerid, COLOR_GREY, str);
    	return false;
    }
    if(GetString(PI[playerid][pDescription], "None") && !connect)
    {
    	if(strlen(string_desc) < 1 || strlen(string_desc) > 150) return ErrorMessage(playerid, "Вы ввели некорректный текст");
                                
        SetString(PI[playerid][pDescription], string_desc), UpdatePlayerDataStr(playerid, "Description", string_desc);

        SendClientMessage(playerid, COLOR_GREY, "Вы создали описание персонажа:"), SendClientMessage(playerid, COLOR_GREY, string_desc);

        for(new i; i < strlen(string_desc); i++) if(string_desc[i] == '/') string_desc[i] = '\n';

        new str_dialog[320];
        format(str_dialog, sizeof(str_dialog), ""WHITE"Вы создали описание для Вашего персонажа!\n\n{cccccc}%s", string_desc);
        ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Описание персонажа", str_dialog, "Закрыть", "");

        PlayerDescriptionText[playerid] = CreateDynamic3DTextLabel(string_desc, 0xCCCCCCFF, 0.0, 0.0, -1.0, 5, playerid,-1, 0, -1, -1, -1);
        SetPVarInt(playerid, "description", gettime() + 180);
    }
    else if(!connect)
    {
        SetString(PI[playerid][pDescription], "None"), UpdatePlayerDataStr(playerid, "Description", "None");
        SendClientMessage(playerid, COLOR_GREY, "Вы успешно удалили описание персонажа.");
        DestroyDynamic3DTextLabel(PlayerDescriptionText[playerid]);
    }
    return 1;
}
IsABike(vehicleid)
{
    new model = GetVehicleModel(vehicleid);
    switch(model)
    {
        case 481: return model;
        case 510: return model;
    }
    return 0;
}
CMD:az(playerid, params[])
{
	if (!GetAccessAdmin(playerid, 1)) return true;
	extract params -> new player:id;
	if(!isnull(params))
	{
		SetPlayerPos(playerid, AdminZone[adminzone][Zone_posX], AdminZone[adminzone][Zone_posY], AdminZone[adminzone][Zone_posZ]);
		SetPlayerInterior(playerid, AdminZone[adminzone][Zone_Interior]);
		SetPlayerVirtualWorld(playerid, AdminZone[adminzone][Zone_VirtualWorld]);
		
		SetPlayerPos(id, AdminZone[adminzone][Zone_posX], AdminZone[adminzone][Zone_posY], AdminZone[adminzone][Zone_posZ]);
		SetPlayerInterior(id, AdminZone[adminzone][Zone_Interior]);
		SetPlayerVirtualWorld(id, AdminZone[adminzone][Zone_VirtualWorld]);
		
		format(string, sizeof(string), "Администратор %s[%i] телепортировал вас на собеседование.", PI[playerid][pNames], playerid);
		SendClientMessage(id, 0x6495EDFF, string);
	}
	else
	{
	    id = playerid;
		format(string, sizeof(string), "Вы были телепортированы в админ-зону №%i (%s)", AdminZone[adminzone][Zone_ID], AdminZone[adminzone][Zone_Name]);
		SendClientMessage(id, COLOR_GREY, string);
		SetPlayerPos(id, AdminZone[adminzone][Zone_posX], AdminZone[adminzone][Zone_posY], AdminZone[adminzone][Zone_posZ]);
		SetPlayerInterior(id, AdminZone[adminzone][Zone_Interior]);
	}
	return SetPlayerVirtualWorld(id, AdminZone[adminzone][Zone_VirtualWorld]);
}
CMD:changeadminint(playerid, params[])
{
    if (!GetAccessAdmin(playerid, 14)) return true;
    format(string, sizeof(string), "/changeadminint [id (0-%i)]", sizeof(AdminZone)-1);
	extract params -> new adminint; else return SendEsp(playerid, string);
    if(!(0 <= adminint <= sizeof(AdminZone))) return SendEsp(playerid, string);
	adminzone = adminint;
	new strings[128];
   	format(strings, sizeof(strings), "Администратор %s[%i] сменил админ зону на №%i (%s)", PI[playerid][pNames], playerid, AdminZone[adminint][Zone_ID], AdminZone[adminint][Zone_Name]);
   	SendAdminMessage(COLOR_GREY, strings);
	return 1;
}
stock GetDay()
{
	new saturday = 1310155200;
	new w = gettime();
	new daysGet = 0;
	while(w - saturday > 60*60*24)
	{
		w-=60*60*24;
		daysGet++;
	}
	while(daysGet >=7)
	{
		daysGet-=7;
	}
	if(daysGet > 7 || daysGet < 0) daysGet = 0;
	return daysGet;
}
CMD:createobject(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames])) ShowPlayerDialog(playerid, 6565, DIALOG_STYLE_LIST, "{1294dd}Обьекты", "{FFFFFF}1. Создать объект\n2. Редактировать объекты\n3. Настройка обьекта", "Выбрать", "Отмена");
	return 1;
}
