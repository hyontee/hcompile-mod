public OnPlayerEditObject(playerid, playerobject, objectid, response, Float:fX, Float:fY, Float:fZ, Float:fRotX, Float:fRotY, Float:fRotZ)
{
	//print("EditObject called");
	if(!playerobject)
	{
		if(D_FULL(PI[playerid][pNames])) {
			if(!IsValidObject(objectid)) return 1;
			MoveObject(objectid, fX, fY, fZ, 10.0, fRotX, fRotY, fRotZ);
		}
	}
	return 1;
}
public OnPlayerSelectedMenuRow(playerid, row)
{
	new Menu:Current = GetPlayerMenu(playerid);
	if(Current == BuyClothes)
	{
		switch(row)
		{
		case 0://Листаем вперед
			{
				if(PI[playerid][pSex] == 1)
				{
					ChangeSkinv[playerid]++;
					if(ChangeSkinv[playerid] >= 62) ChangeSkinv[playerid] = 0;
					SetPlayerSkin(playerid, SkinMen[ChangeSkinv[playerid]][0]);
					SCMF(playerid, -1, "Продавец: Данная одежда обойдется вам всего в {00FF00}%d$"WHITE"", SkinMen[ChangeSkinv[playerid]][1]);
				}
				else
				{
					ChangeSkinv[playerid]++;
					if(ChangeSkinv[playerid] >= 14) ChangeSkinv[playerid] = 0;
					SetPlayerSkin(playerid, SkinMale[ChangeSkinv[playerid]][0]);
					SCMF(playerid, -1, "Продавец: Данная одежда обойдется вам всего в {00FF00}%d$"WHITE"", SkinMen[ChangeSkinv[playerid]][1]);
				}
				ShowMenuForPlayer(BuyClothes, playerid);
			}
		case 1://Листаем назад
			{
				if(PI[playerid][pSex] == 1)
				{
					if(ChangeSkinv[playerid] <= 0) ChangeSkinv[playerid] = 62;//7 - последний скин [М]
					ChangeSkinv[playerid]--;
					SetPlayerSkin(playerid, SkinMen[ChangeSkinv[playerid]][0]);
					SCMF(playerid, -1, "Продавец: Данная одежда обойдется вам всего в {00FF00}%d$"WHITE".", SkinMen[ChangeSkinv[playerid]][1]);
				}
				else
				{
					if(ChangeSkinv[playerid] <= 0) ChangeSkinv[playerid] = 14;//5 - последний скин [Ж]
					ChangeSkinv[playerid]--;
					SetPlayerSkin(playerid, SkinMale[ChangeSkinv[playerid]][0]);
					SCMF(playerid, -1, "Продавец: Данная одежда обойдется вам всего в {00FF00}%d$"WHITE"", SkinMen[ChangeSkinv[playerid]][1]);
				}
				ShowMenuForPlayer(BuyClothes, playerid);
			}
		case 2://Покупаем
			{
				new cost = SkinMen[ChangeSkinv[playerid]][1];
				if(PI[playerid][pHouse] == -1)
				{
					if(PI[playerid][pSex] == 1)
					{
						if(GetPlayerMoney(playerid) < cost) return SendClientMessage(playerid, -1, "Продавец: Данная одежда вам не по карману!"), ShowMenuForPlayer(BuyClothes, playerid);
						TogglePlayerControllable(playerid, true);
						SetCameraBehindPlayer(playerid);
      					if(GetPVarInt(playerid, "zips") == 2)
						{
							SetPlayerInterior(playerid, 5);
							SetPlayerPos(playerid, 221.7944, -8.4229, 1002.2109);
							SetPlayerFacingAngle(playerid, 273.5792);
							SetPlayerVirtualWorld(playerid, 0);
						}
						else
						{
							/*SetPlayerInterior(playerid, 18);
							SetPlayerPos(playerid, 176.1281, -88.9237, 1001.8047);
							SetPlayerFacingAngle(playerid, 89.4423);
							SetPlayerVirtualWorld(playerid, 0);*/
							SetPlayerInterior(playerid, 5);
							SetPlayerPos(playerid, 221.7944, -8.4229, 1002.2109);
							SetPlayerFacingAngle(playerid, 273.5792);
							SetPlayerVirtualWorld(playerid, 0);
						}
						PI[playerid][pChar] = GetPlayerSkin(playerid);
						SetPlayerSkin(playerid, PI[playerid][pChar]);
						Hook_GivePlayerMoney(playerid, -cost);
						SendClientMessage(playerid, -1, "Продавец: Спасибо за покупку. Вы сделали хороший выбор!");
					}
					else
					{
						if(GetPlayerMoney(playerid) < cost) return SendClientMessage(playerid, -1, "Продавец: Данная одежда вам не по карману!"), ShowMenuForPlayer(BuyClothes, playerid);
						TogglePlayerControllable(playerid, true);
						SetCameraBehindPlayer(playerid);
      					if(GetPVarInt(playerid, "zips") == 2)
						{
							SetPlayerInterior(playerid, 5);
							SetPlayerPos(playerid, 221.7944, -8.4229, 1002.2109);
							SetPlayerFacingAngle(playerid, 273.5792);
							SetPlayerVirtualWorld(playerid, 0);
						}
						else
						{
							/*SetPlayerInterior(playerid, 18);
							SetPlayerPos(playerid, 176.1281, -88.9237, 1001.8047);
							SetPlayerFacingAngle(playerid, 89.4423);
							SetPlayerVirtualWorld(playerid, 0);*/
							SetPlayerInterior(playerid, 5);
							SetPlayerPos(playerid, 221.7944, -8.4229, 1002.2109);
							SetPlayerFacingAngle(playerid, 273.5792);
							SetPlayerVirtualWorld(playerid, 0);
						}
						PI[playerid][pChar] = GetPlayerSkin(playerid);
						SetPlayerSkin(playerid, PI[playerid][pChar]);
						Hook_GivePlayerMoney(playerid, -cost);
						SendClientMessage(playerid, -1, "Продавец: Спасибо за покупку. Вы сделали хороший выбор!");
					}
				}
				else
				{
				    string = "";
				    format(string, 200, "Основная одежда - (%i)\nВешалка №1 (%i)\nВешалка №2 (%i)\nВешалка №3 (%i)\nВешалка №4 (%i)", PI[playerid][pChar], PI[playerid][pShSkin][0], PI[playerid][pShSkin][1], PI[playerid][pShSkin][2], PI[playerid][pShSkin][3]);
				    ShowPlayerDialog(playerid, 2471, DIALOG_STYLE_LIST, ""SERVER"Выберите слот", string, "Далее", "Отмена");
				    SetPVarInt(playerid, "Cost", cost);
				}
			}
		case 3://Выходим
			{
    			if(GetPVarInt(playerid, "zips") == 2)
				{
					SetPlayerInterior(playerid, 5);
					SetPlayerPos(playerid, 221.7944, -8.4229, 1002.2109);
					SetPlayerFacingAngle(playerid, 273.5792);
					SetPlayerVirtualWorld(playerid, 0);
				}
				else
				{
					/*SetPlayerInterior(playerid, 18);
					SetPlayerPos(playerid, 176.1281, -88.9237, 1001.8047);
					SetPlayerFacingAngle(playerid, 89.4423);
					SetPlayerVirtualWorld(playerid, 0);*/
					SetPlayerInterior(playerid, 5);
					SetPlayerPos(playerid, 221.7944, -8.4229, 1002.2109);
					SetPlayerFacingAngle(playerid, 273.5792);
					SetPlayerVirtualWorld(playerid, 0);
				}
				SetPlayerSkin(playerid, PI[playerid][pChar]);
				TogglePlayerControllable(playerid, true);
				SetCameraBehindPlayer(playerid);
				SendClientMessage(playerid, -1, "Продавец: Всего хорошего, приходите еще!");
			}
		}
	}
	return 1;
}

forward StartViktorina();
public StartViktorina()
{
    new a1,b1;
    a1 = random(1500);
    b1 = random(1500);

	new
	 a=random(100),
	  b=random(100),
	   c=random(5),
	    d=random(10),
		 f=random(100);

	switch(c)
	{
        case 0:
        {
		    Viktorina = a1 + b1;
		    format(string, sizeof(string), "Объявление: San News проводит регулярную викторину среди слушателей. Вопрос: %d + %d.", a1, b1);
			SendClientMessageToAll(0x1F7C65FF, string);
			SendClientMessageToAll(0x1F7C65FF, "Ответы принимает редакция через SMS на номер 1001.");
		}
        case 1:
        {
            Viktorina = a + b - d;
		    format(string, sizeof(string), "Объявление: San News проводит регулярную викторину среди слушателей. Вопрос: %d + %d - %d.", a, b, d);
			SendClientMessageToAll(0x1F7C65FF, string);
			SendClientMessageToAll(0x1F7C65FF, "Ответы принимает редакция через SMS на номер 1001.");
		}
        case 2:
        {
            Viktorina = a - b + d;
		    format(string, sizeof(string), "Объявление: San News проводит регулярную викторину среди слушателей. Вопрос: %d - %d + %d.", a, b, d);
			SendClientMessageToAll(0x1F7C65FF, string);
			SendClientMessageToAll(0x1F7C65FF, "Ответы принимает редакция через SMS на номер 1001.");
		}
        case 3:
        {
            Viktorina = a * b - f;
		    format(string, sizeof(string), "Объявление: San News проводит регулярную викторину среди слушателей. Вопрос: %d * %d - %d.", a, b, f);
			SendClientMessageToAll(0x1F7C65FF, string);
			SendClientMessageToAll(0x1F7C65FF, "Ответы принимает редакция через SMS на номер 1001.");
		}
        case 4:
        {
            Viktorina = a * b + f;
		    format(string, sizeof(string), "Объявление: San News проводит регулярную викторину среди слушателей. Вопрос: %d * %d + %d.", a, b, f);
			SendClientMessageToAll(0x1F7C65FF, string);
			SendClientMessageToAll(0x1F7C65FF, "Ответы принимает редакция через SMS на номер 1001.");
		}
	}
    return 1;
}

forward UpdateVehiclePos(playerid, vehicleid, type);
public UpdateVehiclePos(playerid, vehicleid, type)
{
    if(vehicleid-1 == -1 && playerid != -1) return KillTimer(TimeUpdate[playerid]);
    if(type == 1) BanCar[vehicleid] = false;
    GetVehiclePos(vehicleid, VehInfo[vehicleid - 1][vehicleX], VehInfo[vehicleid - 1][vehicleY], VehInfo[vehicleid - 1][vehicleZ]);
    GetVehicleZAngle(vehicleid, VehInfo[vehicleid - 1][vehicleA]);
    return 1;
}
public OnPlayerStateChange(playerid, newstate, oldstate)
{
    if(oldstate == PLAYER_STATE_DRIVER)
	{
	    if(BanCar[VehicleEnters[playerid]]) KillTimer(TimeUpdate[playerid]);
	    BanCar[VehicleEnters[playerid]] = true;
	    TimeUpdate[playerid] = SetTimerEx("UpdateVehiclePos", 10000, false, "ii", playerid, VehicleEnters[playerid], 1);
	}
	if(oldstate == 2 && PI[playerid][plveh]!=-1)
    {
        DestroyVehicle(PI[playerid][plveh]);
        PI[playerid][plveh]= -1;
    }
	if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER) VehicleEnters[playerid] = GetPlayerVehicleID(playerid);
	if(oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER) VehicleEnters[playerid] = 0;
	switch(newstate)
	{
	    case PLAYER_STATE_PASSENGER:
	    {
	        new vehicleid = VehicleEnters[playerid], model = GetVehicleModel(vehicleid);
			if(model == 508)
			{
				SetPlayerPos(playerid, 1160.4574,472.3724,1527.0601);
				SetPlayerFacingAngle(playerid, 180.0000);
				SetPlayerVirtualWorld(playerid, vehicleid);
				SetCameraBehindPlayer(playerid);
				SetPlayerInterior(playerid, 1);
				SetPVarInt(playerid, "Intropic", vehicleid);
			}
	    }
	    case PLAYER_STATE_DRIVER:
		{
			CarEnter(playerid, VehicleEnters[playerid]);
		}
		case PLAYER_STATE_ONFOOT:
		{
  			new vehicleid = VehicleEnters[playerid];
	        if(GetPVarInt(playerid, "ShowSpeed"))
			{
				for(new i = 0; i < 25; i++)
				{
				    PlayerTextDrawHide(playerid, SpeedPlayerText[playerid][i]);
				}
				DeletePVar(playerid,"ShowSpeed");
			}
    		if(PI[playerid][pJob] == 1 && GetPVarInt(playerid, "ContractMechanic")) Delete3DTextLabel(Meh3d[vehicleid]), DeletePVar(playerid, "ContractMechanic");
			if(GetPVarInt(playerid, "TalkingLive") == 2)
			{
				SendClientMessage(playerid, 0x6ab1ffaa, "Прямой эфир завершён");
				SendClientMessage(GetPVarInt(playerid, "TalkingLive"), 0x6ab1ffaa, "Прямой эфир завершён");
				TogglePlayerControllable(playerid, true);
				TogglePlayerControllable(GetPVarInt(playerid, "TalkingLive"), 1);
				SetPVarInt(GetPVarInt(playerid, "TalkingLive"), "TalkingLive", 999);
				SetPVarInt(playerid, "TalkingLive", 999);
			}
			else if(GetPVarInt(playerid, "TalkingLivels") == 2)
			{
				SendClientMessage(playerid, 0x6ab1ffaa, "Прямой эфир завершён");
				SendClientMessage(GetPVarInt(playerid, "TalkingLivels"), 0x6ab1ffaa, "Прямой эфир завершён");
				TogglePlayerControllable(playerid, true);
				TogglePlayerControllable(GetPVarInt(playerid, "TalkingLivels"), 1);
				SetPVarInt(GetPVarInt(playerid, "TalkingLivels"), "TalkingLivels", 999);
				SetPVarInt(playerid, "TalkingLivels", 999);
   			}
		}
	}
	return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
	if(player_belt_cars{playerid}) player_belt_cars{playerid} = false;
	GetPlayerPos(playerid, PlayerPos[playerid][0], PlayerPos[playerid][1], PlayerPos[playerid][2]);
	if(gPlayerProdText[playerid][0] != Text3D:-1 || gPlayerProdText[playerid][1] != Text3D:-1 || gPlayerProdCP[playerid] != -1)
	{
 		SetPVarInt(playerid, "ProdExit_Car", 15);
		SendClientMessage(playerid, 0xFF9900AA, "У Вас есть 15 секунд чтобы вернуться в автомобиль");
	}
    RaceExit(playerid, 1);
	if(GetVehicleModel(vehicleid)>=400)
	{
		UpdateVehiclePos(playerid, vehicleid, 0);
	}
	SetPVarInt(playerid, "check_car_kick", unix+5);
	if(GetPVarInt(playerid, "PEfir") != 999)
	{
		SendClientMessage(playerid, COLOR_WHITE, "Вы вышли из прямого эфира");
		SetPVarInt(playerid, "PEfir", 999);
	}
	if(GetPVarInt(playerid, "Pefir") == 1 || GetPVarInt(playerid, "Pefir") == 2)
	{
		DeletePVar(playerid, "Pefir");
		SetPVarInt(playerid, "PEfir", 999);
		SendClientMessage(playerid, COLOR_WHITE, "Вы вышли из прямого эфира");
	}
	if(strobelight_time_out[vehicleid])
		strobelight_time_out[vehicleid] = SetTimerEx("OnVehicleStrobeTimeOut", 900000, false, "d", vehicleid);

	return 1;
}

publics: duel_timer_death(playerid)
{
	SetPlayerPos(playerid, 2449.2708, -1979.1895, 13.5469);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
    return true;
}

publics: CheckBanList(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	string = "";
	if(rows)
	{
		new new_gettime = cache_get_field_content_int(0, "UnBanDate");
		new data[16], admin[24], email[32];
		cache_get_field_content(0, "Admin", admin, 1, sizeof(admin));
		cache_get_field_content(0, "Date", data, 1, sizeof(data));
		cache_get_field_content(0, "Reason", email, 1, sizeof(email));
		if(new_gettime && new_gettime < unix)
		{
			format(string, 256, "{29DF32}Ваш аккаунт разблокирован!\n\n"WHITE"Администратор: {29DF32}%s\n"WHITE"Дата блокировки: {29DF32}%s\n"WHITE"Количество дней: {29DF32}%i\n"WHITE"Причина: {29DF32}%s\n\n"WHITE"Для авторизации нажмите 'Далее'", admin, data, cache_get_field_content_int(0, "Days"), email);
			ShowPlayerDialog(playerid, DIALOG_LOGIN_UNBANE, DIALOG_STYLE_MSGBOX, "{29DF32}Ваш аккаунт разблокирован!", string, "Далее", "");
			mysql_format(1, string, sizeof(string), "UPDATE `BanList` SET `Status` = '0' WHERE `Nick` = '%e' && `Status` = '1'", PI[playerid][pNames]);
			mysql_tquery(1, string);
		}
		else
		{
			format(string, sizeof(string), "{DF3029}Данный аккаунт заблокирован!\n\n"WHITE"Администратор: {DF3029}%s\n"WHITE"Дата блокировки: {DF3029}%s\n"WHITE"Количество дней: {DF3029}%i\n"WHITE"Причина: {DF3029}%s\n\n"WHITE"Чтобы покинуть игру введите '/q'", admin, data, cache_get_field_content_int(0, "Days"), email);
			ShowPlayerDialog(playerid, DIALOG_LOGIN_BANE, DIALOG_STYLE_MSGBOX, "{DF3029}Данный аккаунт заблокирован!", string, "Выход", "");
			KickEx(playerid);
		}
		return 1;
	}
	mysql_format(1, string, 144, "SELECT * FROM `accounts` WHERE `Name` = '%e'", PI[playerid][pNames]);
	mysql_tquery(1, string, "FindPlayerInTable", "d", playerid);
	return 1;
}
publics: BNomer_Donate(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		PI[playerid][pPnumber] = GetPVarInt(playerid, "Nomer");
		PI[playerid][pDonate] -= GetPVarInt(playerid, "Price");
		UpdatePlayerData(playerid, "pDonate", PI[playerid][pDonate]);
		SCMF(playerid, -1, "Поздравляем! Вы установили новый номер телефона %i за {32cd32}%i донат монет", PI[playerid][pPnumber], GetPVarInt(playerid, "Price"));
		UpdatePlayerData(playerid, "pPnumber", PI[playerid][pPnumber]);
		DeletePVar(playerid, "Nomer");
		return DeletePVar(playerid, "Price");
	}
	DeletePVar(playerid, "Nomer");
	DeletePVar(playerid, "Price");
	string = "";
	format(string, 512, ""WHITE"Введите желаемый номер телефона, чтобы узнать цену\n     - "WHITE"1 цифра - 5000DM"WHITE"\n     - "WHITE"2 цифры - от 3500DM до 4000DM"WHITE"\n     - "WHITE"3 цифры - от 2000DM до 3000DM"WHITE"\n     - "WHITE"4 цифры - от 1000DM до 2000DM\n\n{FF0000}Данный номер уже кто-то купил");
	return ShowPlayerDialog(playerid, 9999, DIALOG_STYLE_INPUT, ""SERVER"Покупка элитного номера телефона", string, "Выбрать", "Назад");
}
publics: UnBan(playerid, reason_ban[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, COLOR_RED, "Игрок не забанен!");
	cache_get_field_content(0, "Nick", stringer, 1, sizeof(stringer));
	SCMF(playerid, -1, "Вы успешно разбанили аккаунт: %s. Причина: %s", stringer, reason_ban);
	mysql_format(1, string, sizeof(string), "DELETE FROM `BanList` WHERE `Nick` = '%e'", stringer), mysql_tquery(1, string);
	format(string, 128, "Администратор %s разбанил %s. Причина: %s", PI[playerid][pNames], stringer, reason_ban);
 	SendAdminMessage(COLOR_LIGHTRED, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /unban на %s", PI[playerid][pNames], stringer);
	logs(1, log_str, 0);

	return 1;
}
public OnPlayerRequestClass(playerid, classid)
{
	if(PI[playerid][pLogin]) return SpawnPlayer(playerid);
	for(new i; i < 9; i ++) TextDrawShowForPlayer(playerid, Logotype_TD[i]);

	string = "";
	mysql_format(1,string, 128, "SELECT * FROM `BanList` WHERE Nick = '%e' AND `Status` = '1'", PI[playerid][pNames]);
	mysql_tquery(1, string, "CheckBanList", "d", playerid);

	new Float:pHealth;
	GetPlayerHealth(playerid, pHealth);
	if(pHealth) ClearAnimations(playerid, 1);
	SetPlayerInterior(playerid,0);
	TogglePlayerControllable(playerid,0);
	SetPlayerTime(playerid, tmphour, tmpminute);
	return 0;
}
public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
	if(!newinteriorid)
	{
		playerNoSetTime{playerid} = 0;
		//if(GetPVarInt(playerid, "custom_time") > -1) SetPlayerTime(playerid, GetPVarInt(playerid, "custom_time"), tmpminute);
		SetPlayerTime(playerid, tmphour, tmpminute);
	}
	else
	{
		playerNoSetTime{playerid} = 1;
		SetPlayerTime(playerid, 12, 0);
	}
 	return 1;
}
FromFresh(playerid)
{
	if(BizWarTime > unix)
	{
		new kv1, kv2;
		if(PI[playerid][kapture][1] && !ISAMAFIA(playerid)) EndBizwar(playerid);
		if(MZInfo[bFrakVlad]!=PI[playerid][pMember] && MZInfo[bNapad]!=PI[playerid][pMember]) return 1;
		switch(MZInfo[bMesto])
		{
			case 1:
			{
				if(PlayerToKvadrat(playerid, -584.5829,-194.2383,-423.1804, -37.6722))
				{
					if(MZInfo[bFrakVlad]==PI[playerid][pMember]) kv1++;
					else kv2++;
				}
			}
			case 2:
			{
				if(PlayerToKvadrat(playerid, 18.2251, -219.5277, 202.4129, -343.2708))
				{
					if(MZInfo[bFrakVlad]==PI[playerid][pMember]) kv1++;
					else kv2++;
				}
			}
			case 3:
			{
				if(PlayerToKvadrat(playerid, 2416.9597, -239.1455, 2274.2729, -346.5710))
				{
					if(MZInfo[bFrakVlad]==PI[playerid][pMember]) kv1++;
					else kv2++;
				}
			}
		}
		if(PI[playerid][kapture][1] && !ISAMAFIA(playerid)) EndBizwar(playerid);
		if(!PI[playerid][kapture][1])
		{
			GangZoneFlashForPlayer(playerid, ZonsWar[MZInfo[bMesto]-1], GetColor(MZInfo[bNapad]));
			PlayerTextDrawShow(playerid, Bizwar[playerid][0]);
			format(string, 50, "~w~Time: ~g~%s", TimeConverter(BizWarTime-unix));
			PlayerTextDrawSetString(playerid, Bizwar[playerid][0], string);
			format(string, 50, "~w~%s ~g~0 ~w~Kill: ~g~0", GetMN(MZInfo[bFrakVlad]));
			PlayerTextDrawSetString(playerid, Bizwar[playerid][1], string);
			PlayerTextDrawShow(playerid, Bizwar[playerid][1]);
			format(string, 50, "~w~%s ~g~0 ~w~Kill: ~g~0", GetMN(MZInfo[bNapad]));
			PlayerTextDrawSetString(playerid, Bizwar[playerid][2], string);
			PlayerTextDrawShow(playerid, Bizwar[playerid][2]);
			PI[playerid][kapture][1] = true;
		}
		else
		{
			format(string, 50, "~w~Time: ~g~%s", TimeConverter(BizWarTime-unix));
			PlayerTextDrawSetString(playerid, Bizwar[playerid][0], string);
			format(string, 50, "~w~%s ~g~%d ~w~Kill: ~g~%d", GetMN(MZInfo[bFrakVlad]), kv1, MZInfo[bCountDead][MZInfo[bFrakVlad]]);
			PlayerTextDrawSetString(playerid, Bizwar[playerid][1], string);
			format(string, 50, "~w~%s ~g~%d ~w~Kill: ~g~%d", GetMN(MZInfo[bNapad]), kv2, MZInfo[bCountDead][MZInfo[bNapad]]);
			PlayerTextDrawSetString(playerid, Bizwar[playerid][2], string);
		}
	}
	else if(0 < BizWarTime <= unix && MZInfo[bBiz] != 255)
	{
		if(MZInfo[bCountDead][MZInfo[bFrakVlad]] > MZInfo[bCountDead][MZInfo[bNapad]])
		{
			format(string, 255, "%s не удалось отобрать у вас контроль над бизнесом %s. Бизнес отбит", GetMN(MZInfo[bNapad]), BizInfo[MZInfo[bBiz]][bName]);
			SendFractionMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, string);
			format(string, 255, "Вам не удалось отобрать у мафии %s котроль над бизнесом %s. Бизнес оставлен", GetMN(MZInfo[bFrakVlad]), BizInfo[MZInfo[bBiz]][bName]);
			SendFractionMessage(MZInfo[bNapad], COLOR_LIGHTRED, string);
		}
		else if(MZInfo[bCountDead][MZInfo[bFrakVlad]] == MZInfo[bCountDead][MZInfo[bNapad]])
		{
		    format(string, 255, "Стрела за бизнес %s закончилась ничьей. Бизнес оставлен", BizInfo[MZInfo[bBiz]][bName]);
			SendFractionMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, string);
			format(string, 255, "Стрела за бизнес %s закончилась ничьей. Бизнес оставлен", BizInfo[MZInfo[bBiz]][bName]);
			SendFractionMessage(MZInfo[bNapad], COLOR_LIGHTRED, string);
			BizInfo[MZInfo[bBiz]][bKrisha] = 0;

			UpdateBusinessData(MZInfo[bBiz], "bKrisha", BizInfo[MZInfo[bBiz]][bKrisha]);
			UpdateBizInfo(MZInfo[bBiz]);
		}
		else
		{
			format(string, 255, "%s забрала у вас контроль над бизнесом %s. Бизнес потерян", GetMN(MZInfo[bNapad]), BizInfo[MZInfo[bBiz]][bName]);
			SendFractionMessage(MZInfo[bFrakVlad], COLOR_LIGHTRED, string);
			format(string, 255, "Вы отобрали контроль над бизнесом %s у мафии %s. Бизнес захвачен", BizInfo[MZInfo[bBiz]][bName], GetMN(MZInfo[bFrakVlad]));
			SendFractionMessage(MZInfo[bNapad], COLOR_LIGHTRED, string);
			BizInfo[MZInfo[bBiz]][bKrisha] = MZInfo[bNapad];

			UpdateBusinessData(MZInfo[bBiz], "bKrisha", BizInfo[MZInfo[bBiz]][bKrisha]);
			UpdateBizInfo(MZInfo[bBiz]);
		}
		new id_killed = -1;
		new max_killed = -1;
		foreach(Player, i)
		{
		    if(GetPVarInt(i, "mafia_kill"))
		    {
		        if(GetPVarInt(i, "mafia_kill")>max_killed)
		        {
		            max_killed = GetPVarInt(i, "mafia_kill");
		            id_killed = i;
		        }
				DeletePVar(i, "mafia_kill");
		    }
		}


		foreach(Player, m)
		{
			if(MZInfo[bFrakVlad]!=PI[m][pMember] && MZInfo[bNapad]!=PI[m][pMember]) continue;
			if(id_killed != -1 && max_killed != -1)
			{
			    format(string, 128, "Лучший игрок на стреле {FF0000}%s "WHITE"который убил {FF0000}%i человек(а)", PI[id_killed][pNames], max_killed);
		    	SendClientMessage(m, CWHITE, string);
			}
			EndBizwar(m);
		}
		MZInfo[bFrakVlad] = 0;
		MafiaCapture[MZInfo[bNapad]] = 1;
		MZInfo[bNapad] = 0;
		MZInfo[bBiz] = 255;
		GangZoneStopFlashForAll(ZonsWar[MZInfo[bMesto]-1]);
		GangZoneHideForAll(ZonsWar[MZInfo[bMesto]-1]);
		GangZoneShowForAll(ZonsWar[MZInfo[bMesto]-1], 0x00FF7FAA);
		MZInfo[bMesto]=0;
		MZInfo[bCountDead][MZInfo[bNapad]] = 0;
		MZInfo[bCountDead][MZInfo[bFrakVlad]] = 0;
	}
	return 1;
}
Fresh()
{
	new hour, minute, second;
	gettime(hour, minute, second);

	if(hour == 08 && minute == 10 && second == 00 || hour == 10 && minute == 10 && second == 00 || hour == 12 && minute == 10 && second == 00 || hour == 14 && minute == 10 && second == 00 || hour == 16 && minute == 10 && second == 00 || hour == 18 && minute == 10 && second == 00 || hour == 20 && minute == 10 && second == 00 || hour == 22 && minute == 10 && second == 00)
	{
		DeathMatch_Time = 300;

		SendClientMessageToAll(0xFFD700FF, "[Центр развлечений] Через 5 минут пройдет соревнование по Counter Strike. (/gps > Основные места > Центр развлечений)");
	}
	if(hour == 07 && minute == 15 && second == 00 || hour == 9 && minute == 15 && second == 00 || hour == 11 && minute == 15 && second == 00 || hour == 13 && minute == 15 && second == 00 || hour == 15 && minute == 15 && second == 00 || hour == 17 && minute == 15 && second == 00 || hour == 19 && minute == 15 && second == 00 || hour == 21 && minute == 15 && second == 00)
	{
	    new RANDOM = RandomEx(0x0, sizeof(RACE_VEHICLE_ID)-1);
	    RACE_TIME_TO_START[0] = 300;RACE_VEHICLE = RACE_VEHICLE_ID[RANDOM]; RACE_MAP = RandomEx(1, 3);
	    if(RACE_MAP>=1) RACE_MAP--;
	    MAX_RACE_PLAYER = (RACE_MAP == 0 || RACE_MAP == 1) ? (40) : (15);

		SendClientMessageToAll(0xFFD700FF, "[Центр развлечений] Через 5 минут пройдут гоночные мероприятия. (/gps > Основные места > Центр развлечений)");
	}
	for(new i = 1, j = GetVehiclePoolSize(); i <= j; i++)
	{
		if(Start{i} && GetVehicleSpeed(i) > 10)
		{
			DestroyPickup(autopick_mats[i]);
			DestroyDynamic3DTextLabel(mats3Dtxt[i]);
			Start{i} = false;
		}
	}
	return 1;
}
stock SpeedVehicle(playerid)
{
	new Float:ST[4];
	if(IsPlayerInAnyVehicle(playerid)) GetVehicleVelocity(GetPlayerVehicleID(playerid),ST[0],ST[1],ST[2]);
	else GetPlayerVelocity(playerid,ST[0],ST[1],ST[2]);
	ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 213.3;
	return floatround(ST[3]);
}
ShowStats(playerid,targetid)
{
	if(!IsPlayerConnected(targetid)) return 1;

	new drank[20];
	switch(PI[targetid][pLevel])
	{
 		case 9..10: drank = "Новичок";
 		case 12..13: drank = "Начинающий";
	 	case 15..16: drank = "Уверенный";
	 	case 17..18: drank = "Постоянный игрок";
	 	case 20..21: drank = "Освоившийся";
	 	case 23..26: drank = "Дед";
	 	default: drank = "Ветеран";
	}

	if(PI[targetid][pLeader]) drank = "Лидер";
	if(PI[targetid][pAdmin]) drank = "Администратор";

	new house = PI[targetid][pHouse];
	string = "";
	format(stringer,MAX_STR,""WHITE"Текущее состояние счета:\t"WARNING"%i "WHITE"%s\n\n",PI[targetid][pRubInfo],Skl(PI[targetid][pRubInfo],"рубль","рубля","рублей"));
	strcat(string,stringer);

	format(stringer,MAX_STR,""WHITE"Имя:\t\t\t\t{3399FF}%s\n\n",PI[targetid][pNames]);
	strcat(string,stringer);

	format(stringer,MAX_STR,""WHITE"Уровень:\t\t\t%i (%d/%d)\n",PI[targetid][pLevel],PI[targetid][pExp],(PI[targetid][pLevel]+1)*4);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Отыграно часов:\t\t%d\n",PI[targetid][pPayDayHad]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Законопослушность:\t\t%i\n",PI[targetid][pZakonp]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Игровой статус:\t\t%s\n",drank);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Пол:\t\t\t\t%s\n",(PI[targetid][pSex] == 1 ? ("Мужской") : ("Женский")));
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Уровень розыска:\t\t%i\n",PI[targetid][pWanted]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Варн(ов):\t\t\t%d/3\n\n",PI[targetid][pWarns]);
	strcat(string,stringer);

	format(stringer,MAX_STR,""WHITE"Репутация:\t\t\t%i\n",PI[targetid][pReputation]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Номер телефона:\t\t%i\n",PI[targetid][pPnumber]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Донат очков:\t\t\t%i\n",PI[targetid][pDonate]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Материалы:\t\t\t%i\n",PI[targetid][pMats]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Аптечки:\t\t\t%i\n",PI[targetid][pHealing]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Канистры:\t\t\t%i\n",PI[targetid][pFuelCar]);
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Ремкомплект:\t\t\t%i\n\n",PI[targetid][pRem]);
	strcat(string,stringer);

	format(stringer,MAX_STR,""WHITE"Наличные:\t\t\t"GREEN"$%i\n",GetPlayerMoney(targetid));
	strcat(string,stringer);
	format(stringer,MAX_STR,""WHITE"Банк:\t\t\t\t"GREEN"$%i\n\n",PI[targetid][pBank]);
	strcat(string,stringer);

	if(PI[targetid][pMember] != 0)
	{
		format(stringer,MAX_STR,""WHITE"Организация:\t\t\t%s\n",FI[PI[targetid][pMember]][fName]);
		strcat(string,stringer);
		format(stringer,MAX_STR,""WHITE"Ранг:\t\t\t\t%s\n",PlayerRank[PI[targetid][pMember]-1][PI[targetid][pRank]-1]);
		strcat(string,stringer);
		format(stringer,MAX_STR,""WHITE"Выговоров:\t\t\t%d/3\n\n",PI[targetid][vig]);
		strcat(string,stringer);
	}

	format(stringer,MAX_STR,""WHITE"Дом:\t\t\t\t%s\n\n",((house == -1) ? ("Отсутствует") : (!house) ? ("Эконом класс") : (house == 1) ? ("Де-Люкс класс") : (house == 2) ? ("Люкс класс") : (house == 3) ? ("Премиум класс") : (house == 4) ? ("Бизнес класс") : ("Элитный класс")));
	strcat(string,stringer);
	if(PI[targetid][pCar][0] && PI[targetid][pCar][1] && PI[targetid][pCar][2])
	{
		strcat(string,""WHITE"Транспорт:\n");
		format(stringer,MAX_STR,""WHITE"[#1]:\t\t\t\t%s\n",VehicleNames[PI[targetid][pCar][0]-400]);
		strcat(string,stringer);
		format(stringer,MAX_STR,""WHITE"[#2]:\t\t\t\t%s\n",VehicleNames[PI[targetid][pCar][1]-400]);
		strcat(string,stringer);
		format(stringer,MAX_STR,""WHITE"[#3]:\t\t\t\t%s\n\n",VehicleNames[PI[targetid][pCar][2]-400]);
		strcat(string,stringer);
	}
	if(PI[targetid][pBusiness] != -1)
	{
		format(stringer,MAX_STR,""WHITE"Бизнес:\t\t\t%s\n\n",BizInfo[PI[targetid][pBusiness]][bName]);
		strcat(string,stringer);
	}
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Статистика персонажа", string, "Закрыть", "");
	return 1;
}
public OnGameModeExit()
{
    mysql_close();
	return 1;
}
