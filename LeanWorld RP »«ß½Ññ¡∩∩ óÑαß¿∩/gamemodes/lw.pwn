	if(params[0] == INVALID_PLAYER_ID) return ErrorMessage(playerid, "Человек не найден!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете снять розыск себе!");
	if(PI[playerid][pMember] == 1 &&  PI[playerid][pRank] >= 2)
