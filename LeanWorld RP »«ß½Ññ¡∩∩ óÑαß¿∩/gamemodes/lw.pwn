	}
	return 1;
}*/



CMD:giverub(playerid, params[])
{
    if(D_FULL(PI[playerid][pNames]))
    {
		new donatenick[MAX_PLAYER_NAME], donate[11], asdwsadaw[230];
		if(sscanf(params, "s[24]d",donatenick, donate)) return SendClientMessage(playerid, COLOR_WHITE, "Введите: /giverub [ник] [кол-во рублей]");
		//if(!IsValidRpName(donatenick)) return SendClientMessage(playerid, COLOR_WHITE, "Введенное вами значение не соотвествует структуре ника.");
		mysql_format(1, asdwsadaw,sizeof(asdwsadaw), "SELECT `pRub` FROM `accounts` WHERE `Name` = '%e'", donatenick);
		mysql_function_query(1, asdwsadaw, true, "GiveRubs", "dsd", playerid,donatenick,donate);
	}
	else
	{
	    SendMes(playerid, -1, "ERROR 2321");
	}
	return true;
}

publics: GiveRubs(playerid, tmp[], donate)
{
	new rows, fields, money[20];
	cache_get_data(rows, fields);
	if(!rows) return SendMes(playerid, COLOR_GREY, "[ MySQL ] Аккаунт %s не найден в базе данных.",tmp);
	new ids = GetPlayerID(tmp);
	if(IsPlayerConnected(ids))
	{
	    PI[ids][pRubInfo] += donate;
	    PI[ids][pRubDonateTotal][1] += donate;
	    format(stringer, sizeof(stringer),""SERVER"Администратор %s выдал "WHITE"%i"SERVER" рублей %s", PI[playerid][pNames], donate, tmp);
	    SendAdminMessage(COLOR_GREEN, stringer);
	    UpdatePlayerData(ids, "pRub", PI[ids][pRubInfo]);
    }
    else
    {
		cache_get_field_content(0, "pRub", money);
		new sdwasdw1[500];
		mysql_format(1, sdwasdw1, sizeof(sdwasdw1), "UPDATE `accounts` SET `pRub` = '%d' WHERE `Name` = '%e'",strval(money)+donate,tmp);
		mysql_function_query(1, sdwasdw1, false, "", "");
		mysql_format(1, sdwasdw1, sizeof(sdwasdw1), "UPDATE `accounts` SET `pRubDonateTotal1` = '%d' WHERE `Name` = '%e'",strval(money)+donate,tmp);
		mysql_function_query(1, sdwasdw1, false, "", "");
	    format(stringer, sizeof(stringer),""SERVER"Администратор %s выдал "WHITE"%i"SERVER" рублей %s", PI[playerid][pNames], donate, tmp);
	    SendAdminMessage(COLOR_LIGHTRED, stringer);
	}
	new str[120];
	format(str, sizeof(str), "выдал %i донат рублей", donate);
	AddaLog(PI[playerid][pNames], str, tmp, "", "", "");
	return true;
}

cmd:adonate(playerid)
{
	if(PI[playerid][pAdmin] < 1) return true;
	ShowPlayerDialog(playerid, 7632, DIALOG_STYLE_LIST, ""WHITE"Админ-магазин:",
	""ORANGE"1."WHITE" Покупка платных команд\n\
	 "ORANGE"2."WHITE" Покупка префикса\n\
	 "ORANGE"3."WHITE" Повысить админ-уровень "WARNING"(для 1+ лвл)\n\
	 "ORANGE"4."WHITE" Повысить админ-уровень "WARNING"(для 10+ лвл)\n\
	 "ORANGE"5."WHITE" Снять выговор", "Далее", "Отмена");
	return true;
}

cmd:alldonate(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
	    if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/alldonate [кол-во]");
	    if(params[0] < 1 || params[0] > 30000) return ErrorMessage(playerid, "Нельзя меньше 1 и больше 30000 Donate");
	    foreach(Player, i)
	    {
	        PI[i][pDonate] += params[0];
	        UpdatePlayerData(i, "pDonate", PI[i][pDonate]);
	    }
	    string = "";
	    format(string, 128, "Администратор %s выдал всем игрокам %i донат монет", PI[playerid][pNames], params[0]);
	    SendClientMessageToAll(COLOR_ORANGE, string);

		new log_str[256 + 1];
		format(log_str, sizeof(log_str), "%s использовал команду /alldonate", PI[playerid][pNames]);
		logs(1, log_str, 0);
	}
	return 1;
}
cmd:givedonate(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	//if(gAdminReason[playerid][ADMIN_GIVEDONATE]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "dd", params[0], params[1])) return SendEsp(playerid, "/givedonate [ID][КОЛ-ВО (0 - отобрать)]");
	if(!params[1])
	{
		PI[params[0]][pDonate] = 0;
		SCMF(params[0], COLOR_GREY, "Администратор: %s отобрал у Вас все донат монет", PI[playerid][pNames]);
		SCMF(playerid, COLOR_GREY, "Вы отобрали у: %s все донат монет", PI[params[0]][pNames]);
		UpdatePlayerData(params[0], "pDonate", PI[params[0]][pDonate]);
	}
	PI[params[0]][pDonate] += params[1];
	SCMF(params[0], COLOR_BLUE, "Администратор: %s выдал Вам %i донат.", PI[playerid][pNames], params[1]);
	SCMF(playerid, COLOR_BLUE, "Вы успешно выдали донат %s", PI[params[0]][pNames]);
	UpdatePlayerData(params[0], "pDonate", PI[params[0]][pDonate]);
	new str[120];
	format(str, sizeof(str), "выдал %i донат очков", params[1]);
	AddaLog(PI[playerid][pNames], str, PI[params[0]][pNames], "", "", "");

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /givedonate на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
