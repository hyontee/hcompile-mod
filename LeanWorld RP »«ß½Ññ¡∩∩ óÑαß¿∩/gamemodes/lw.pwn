GoAnim(playerid, const alib[], const aanim[], Float:atime, amove, ax, ay, az, af, ac)
{
	if(GetPVarInt(playerid, "PLAYERANIM")) return ErrorMessage(playerid, "Закончите прежнюю анимацию, перед использованием новой. Клавиша: L-ALT");
	ApplyAnimation(playerid, alib, aanim, atime, amove, ax, ay, az, af, ac);
	if(PI[playerid][pAnimDraw])
	{
		TextDrawShowForPlayer(playerid, Info_TD[playerid][0]);
		TextDrawSetString(Info_TD[playerid][4], "~w~Press ~r~ALT~w~ for~n~close animation");
		TextDrawShowForPlayer(playerid, Info_TD[playerid][1]);
		TextDrawShowForPlayer(playerid, Info_TD[playerid][2]);
		TextDrawShowForPlayer(playerid, Info_TD[playerid][3]);
		TextDrawShowForPlayer(playerid, Info_TD[playerid][4]);
	}
	SetPVarInt(playerid, "PLAYERANIM", 1);
	return 1;
}
DeleteAdministration(targetid, const name[])
{
	PI[targetid][pAvig] = 0;
	PI[targetid][pAdmin] = 0;
	SetPVarInt(targetid, "playerAdmin", 0);
	UpdatePlayerData(targetid, "pAvig", PI[targetid][pAvig]);
	mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pImmunity` = '0' WHERE `Name` = '%e'", name);
	mysql_tquery(1, string);
	mysql_format(1, string, MAX_STR, "DELETE FROM `admin` WHERE `name`='%e'", name);
	mysql_tquery(1, string);
	mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", name);
	mysql_tquery(1, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s был снят с админки", name);
	logs(1, log_str, 0);

	return 1;
}
stock UpdateStoreGang(fracid)
{
    if(fracid != 12 && fracid != 13 && fracid != 15 && fracid != 17 && fracid != 18) return 1;
	{
		format(string, 512, "\
		"WHITE"Количество территорий: "SERVER"%i/130\n\
		"WHITE"Денежных средств: "SERVER"%i$\n\
		"WHITE"Аптечек: "SERVER"%i\n\
		"WHITE"Материалов: "SERVER"%i шт.\n\
		"WHITE"Граффити закрашено: "SERVER"%i/39\n\n\
		"SERVER"Управление: ''F''",
		frac_gangzone[fracid], frac_money[fracid], frac_heal[fracid], frac_materials[fracid], TotalGraf[fracid]);
		Update3DTextLabelText(frac_text[fracid], 0xFFFFFFFF, string);
	}
	return 1;
}
publics:family_callback(playerid, text[])
{
	new temp [32], rows,fields;
	cache_get_data(rows,fields);
	family_count = rows;
	mysql_real_escape_string ( text, temp ) ;
	for ( new a = 1; a != family_count ; a++ )
	{
		if(strfind(temp, family_info[a][f_name],true) != -1)
		{
			SendClientMessage(playerid,-1,""#net"Семья с таким названием уже существует");
			return ShowPlayerDialog(playerid,993,DIALOG_STYLE_INPUT,""SERVER"Создание семьи","\n\n{6495ED}Внимание! Вы хотите создать семью.\nСоздание семьи стоит: 100 рублей\n\nЕсли Вы согласны, введите название семьи:","Создать","Отмена");
		}
		break;
	}
	if(player_family[ playerid ]) return ErrorMessage(playerid, "Вы уже состоите в семье!");
	if(PI[playerid][pRubInfo] < 100) return ErrorMessage(playerid, "У Вас не достаточно рублей.");
	mysql_format  ( 1, string, sizeof string, "INSERT INTO `family_system` ( `fam_id`, `fam_name`, `fam_creator`, `fam_members_amount`, `fam_data` ) VALUES ( '%d', '%e', '%e', '1', NOW( ))", family_count+1,temp, PI[playerid][pNames]) ;
 	mysql_query ( 1, string, false) ;
	player_family [ playerid ] = family_count + 1;
	family_info [ player_family [ playerid ] ] [ f_id ] = family_count + 1;
	format(family_info [ player_family [ playerid ] ] [ f_name ], 32 , temp);
	format(family_info [ player_family [ playerid ] ] [ f_creator ], 24, PI[playerid][pNames]);
	family_info [ player_family [ playerid ] ] [ f_chat_color ] = 0;
	family_info [ player_family [ playerid ] ] [ f_name_color ] = 1;
	family_info [ player_family [ playerid ] ] [ f_members_amount ] = 1;
	family_info [ player_family [ playerid ] ] [ f_online ] = 1;
	family_info [ player_family [ playerid ] ] [ f_money ] = 0;
	PI[playerid][pRubInfo] -= 100;
	new year, month,day;
	getdate(year, month, day);
	format(family_info [ player_family [ playerid ] ] [ f_creating_data ], 32,"%02d-%02d-%d",year, month, day);
	SCMF(playerid, -1, "Вы создали семью "SERVER"%s"WHITE". Чтобы открыть меню семьи введите "SERVER"/fmenu.",temp);
	mysql_format ( 1, string, sizeof string, "UPDATE `family_system` SET `fam_members_amount` = '%d' WHERE `fam_id` = '%d' LIMIT 1",family_info [player_family [ playerid ]] [ f_members_amount ], player_family [ playerid ]);
	mysql_tquery ( 1, string) ;
	UpdatePlayerData(playerid, "family", player_family[playerid]);
	UpdatePlayerData(playerid, "pRub", PI[playerid][pRubInfo]);
	family_count ++;
	return 1;
}
#define SPD ShowPlayerDialog
public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	for(new i=0;i<strlen(inputtext);i++)if(inputtext[i]=='%')inputtext[i]='#';
	new params[2];
	switch(dialogid)
	{
		case 6500:
		{
			if(NonSym(inputtext, 128, 1))
			{
				new dialog_str[246 + 1];
