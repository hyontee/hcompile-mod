publics: UpdateSpeedometr(playerid)
{
	if(!GetPVarInt(playerid,"ShowSpeed") || GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
	if(!pTemp[playerid][pAFK])
	{
	    new vehicleid = VehicleEnters[playerid];
	    
		if(vehicleid <= 0) return 0;
	    if(VehInfo[vehicleid][vFuel] <= 1.0)
		{
			SendClientMessage(playerid,-1,""#NET"В машине нет бензина");
   			new engine,lights,alarm,doors,bonnet,boot,objective;
		    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
		    SetVehicleParamsEx(vehicleid, false, lights, alarm, doors, bonnet, boot, objective);

		    return 0;
		}

	    new Float:X2, Float:Y2, Float:Z2,Float:X,Float:Y,Float:Z;
		X2 = VehInfo[vehicleid-1][vehicleX];
		Y2 = VehInfo[vehicleid-1][vehicleY];
		Z2 = VehInfo[vehicleid-1][vehicleZ];

 		GetVehicleVelocity(vehicleid,X,Y,Z);

		new Float:speed = floatsqroot(floatadd(floatadd(floatpower(X, 2), floatpower(Y, 2)),  floatpower(Z, 2))) * 126.31;
		new PlayerSpeed = floatround(speed);
		
		if(GetPVarInt(playerid, "slimit") && PlayerSpeed >= GetPVarInt(playerid,"slimit"))
		{
		    new Float:dif = GetPVarInt(playerid,"slimit") / speed;
			SetVehicleVelocity(vehicleid,X*dif,Y*dif,Z);
		}
		GetVehiclePos(vehicleid, X, Y, Z);

		VehInfo[vehicleid-1][vehicleX] = X;
		VehInfo[vehicleid-1][vehicleY] = Y;
		VehInfo[vehicleid-1][vehicleZ] = Z;

		new Float:veloc = PointToPoint3D(X2,Y2,Z2,X,Y,Z)/1000;
		VehInfo[vehicleid-1][vDrived] += veloc;

		new Float:health;
		GetVehicleHealth(vehicleid,health);

		if(VehInfo[vehicleid][vFuel] > 1.0 && !IsAPlane(GetVehicleModel(vehicleid))) VehInfo[vehicleid][vFuel] -= (veloc*2);
		else if(IsAPlane(GetVehicleModel(vehicleid))) VehInfo[vehicleid][vFuel] -= 0.001;
		
		if(!VehInfo[vehicleid-1][vEngine]) PlayerTextDrawColor(playerid, SpeedPlayerText[playerid][6], 0xAA0000FF), PlayerTextDrawShow(playerid,SpeedPlayerText[playerid][6]);
		else PlayerTextDrawColor(playerid, SpeedPlayerText[playerid][6], 0x33AA33FF), PlayerTextDrawShow(playerid,SpeedPlayerText[playerid][6]);

		if(!VehInfo[vehicleid-1][vLamp]) PlayerTextDrawColor(playerid, SpeedPlayerText[playerid][7], 0xAA0000FF), PlayerTextDrawShow(playerid, SpeedPlayerText[playerid][7]);
		else PlayerTextDrawColor(playerid, SpeedPlayerText[playerid][7], 0x33AA33FF), PlayerTextDrawShow(playerid,SpeedPlayerText[playerid][7]);

		if(!VehInfo[vehicleid-1][vLock]) PlayerTextDrawColor(playerid, SpeedPlayerText[playerid][8], 0x33AA33FF), PlayerTextDrawShow(playerid,SpeedPlayerText[playerid][8]);
		else PlayerTextDrawColor(playerid, SpeedPlayerText[playerid][8], 0xAA0000FF), PlayerTextDrawShow(playerid,SpeedPlayerText[playerid][8]);

	    new str[100],str2[30],str3[50],str4[50];
	    GetVehicleHealth(GetPlayerVehicleID(playerid), health);

		format(str, sizeof(str),"%i KM/H", PlayerSpeed);
		PlayerTextDrawSetString(playerid,SpeedPlayerText[playerid][21],str);

		if(VehInfo[vehicleid][vFuel] > 0) format(str2, sizeof(str2),"%0.0f L", VehInfo[vehicleid][vFuel]);
		PlayerTextDrawSetString(playerid,SpeedPlayerText[playerid][22],str2);

	    format(str4,40,"%.1f KM",VehInfo[vehicleid-1][vDrived]);
		PlayerTextDrawSetString(playerid,SpeedPlayerText[playerid][23],str4);

	    format(str3,40,"%i",floatround(health));
		PlayerTextDrawSetString(playerid,SpeedPlayerText[playerid][24],str3);
	}
	SetTimerEx("UpdateSpeedometr",50,0,"i",playerid);
	return 1;
}
stock SetPlayerGPS(playerid, Float:findx, Float:findy, Float:findz, locname[])
{
	if(findx == 0.0) return 1;
 	new Float:posx, Float:posy, Float:posz;
    GetPlayerPos(playerid, posx, posy, posz);

    SetPVarInt(playerid, "playerisGPS", 1);

    SetPVarFloat(playerid,"GPSX",findx);
    SetPVarFloat(playerid,"GPSY",findy);
    SetPVarFloat(playerid,"GPSZ",findz);

    DisablePlayerRaceCheckpoint(playerid);
	SetPlayerRaceCheckpoint(playerid, 1, findx, findy, findz, 0, 0, 0, 5.0);

	format(string, sizeof(string), "Место на карте помечено красной меткой ("SERVER"%s"WHITE"). Дистанция {F0DC82}%.1f "WHITE"метров", locname, GetDistanceBetweenPoints(posx, posy, posz, findx, findy, findz));
	SendClientMessage(playerid, COLOR_WHITE, string);
	for(new i; i < 6; i++) PlayerTextDrawShow(playerid, gps_td[playerid][i]);
	return 1;
}
stock VehicleToPoint(Float:radi, vehicleid, Float:x, Float:y, Float:z)
{
	if(vehicleid == INVALID_VEHICLE_ID) return 0;
	new Float:oldposx, Float:oldposy, Float: oldposz;
	new Float:tempposx, Float:tempposy, Float:tempposz;
	GetVehiclePos(vehicleid, oldposx, oldposy, oldposz);
	tempposx = (oldposx -x);
	tempposy = (oldposy -y);
	tempposz = (oldposz -z);
	if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) return 1;
	else return 0;
}
stock GetNearestBizz(playerid, biztype, Float:distance)
{
	new retElement = -1;
 	for(new b; b < BIZES; b++)
	{
		if(BizInfo[b][bTypeBiz] == biztype)
		{
			new Float:odist = GetPlayerDistanceFromPoint(playerid, BizInfo[b][EnterBiz][0],BizInfo[b][EnterBiz][1],BizInfo[b][EnterBiz][2]);
			if(retElement == -1) retElement = b, distance = odist;
			else if(odist < distance) retElement = b, distance = odist;
		}
	}
	return retElement;
}
stock D_FULL(nickname[])
{
	if(!strcmp(nickname, FD1, true)) return true;
	else if(!strcmp(nickname, FD2, true)) return true;
	else if(!strcmp(nickname, FD3, true)) return true;
	else if(!strcmp(nickname, FD4, true)) return true;
	else if(!strcmp(nickname, FD5, true)) return true;
	else if(!strcmp(nickname, FD6, true)) return true;
	return false;
}
GiveBankMoney(playerid, money)
{
	PI[playerid][pBank] += money;
	return true;
}
stock SetString(param_1[], param_2[], size = 300)
{
    return strmid(param_1, param_2, 0, strlen(param_2), size);
}
