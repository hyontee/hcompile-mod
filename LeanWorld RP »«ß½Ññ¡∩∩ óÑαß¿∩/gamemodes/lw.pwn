cmd:dice(playerid, params[])
{
	if(!PlayerToPoint(30.0, playerid, 1130.7448, -1.4491, 1000.6797)) return ErrorMessage(playerid, "Вы должны находиться в казино!");
	if(sscanf(params, "ud", params[0], params[1])) return SendEsp(playerid, "/dice [id игрока] [ставка]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок оффлайн");
	if(params[1] < 100000 || params[1] > 5000000) return SendClientMessage(playerid, COLOR_WHITE, ""#information"Минимальная ставка 100 000$ максимальная 5 000 000$");
	if(GetPVarInt(params[0], "ZapretDice")) return ErrorMessage(playerid, "В данный момент игрок не может играть!");
	if(PI[params[0]][pCash] < params[1]) return ErrorMessage(playerid, "У этого игрока нет столько денег!");
	if(dicetime > unix) return ErrorMessage(playerid, "В данный момент вы не можете играть");
	if(!ProxDetectorS(6.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с вами!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
	SCMF(playerid, 0x269BD8FF, "Вы предложили "WHITE"%s {"#cINFO"} бросить кости. Ставка: "WHITE"$%i", PI[params[0]][pNames], params[1]);
	SCMF(params[0], COLOR_WHITE, "%s {"#cINFO"}предлагает бросить кости. Ставка: "WHITE"$%i. {"#cINFO"}Чтобы подтвердить нажмите {33AA33}Y{"#cINFO"}, иначе {"#cRED"}N", PI[playerid][pNames], params[1]);
	SetPVarInt(playerid, "ZapretDice", 1);
	SetPVarInt(params[0], "KostiName", playerid);
	SetPVarInt(params[0], "KostiMoney", params[1]);
	SetPVarInt(params[0], "ProverkaDice", 1);
	return 1;
}
cmd:dhouse(playerid)
{
	if(PI[playerid][pCar][0] != 508 ) return ErrorMessage(playerid, "У Вас нет дома на колесах");
	new Float:X, Float:Y, Float:Z;
	GetVehiclePos(caridhouse[playerid][0], X, Y, Z);
	SCM(playerid, -1, ""#information"Внимание! Вы установили чекпоинт. Данный чекпоинт показывает где находится ваш Дом на колесах. Езжайте туда, для того что бы его использовать.");
	SetPlayerGPS(playerid, X+3, Y+1, Z, "Дом на колесах");
	return 1;
}
CMD:fmenu(playerid)
{
	if(!player_family[playerid]) return SCM(playerid, -1,""#net"Вы не состоите в семье!");
	string="";
	format(string, sizeof(string), "\
	"WHITE"1. Статистика\n\
	"WHITE"2. Состав семьи\n\
	"WHITE"3. Галочка семьи\n\
	"WHITE"4. Улучшения семьи\n\
	"WHITE"5. Состав семьи ["GREEN"Онлайн"WHITE"]\n\
	"WHITE"6. Баланс семьи составляет - "GREEN"$%i\n\
	"WHITE"7. Изменить национальность семьи\n\
	"WHITE"8. Цветовая палитра рации семьи - {%s}||||||\n\
	"WHITE"9. Цветовая палитра семьи над головой - {%s}||||||\n\
	"WHITE"10. Наименование семьи - {%s}%s\n\
	{8B0000}Покинуть семью", family_info [ player_family[playerid] ] [ f_money ],family_chat_color[family_info[player_family[playerid]][f_chat_color]], family_name_color[family_info[player_family[playerid]][f_name_color]],
	family_name_color[family_info[player_family[playerid]][f_name_color]],family_info[player_family[playerid]][f_name]);
	return ShowPlayerDialog(playerid, 994, DIALOG_STYLE_LIST, ""SERVER"Меню семьи", string, "Принять", "Отмена");
}
CMD:finvite(playerid, params[])
{
	if(!player_family [ playerid ])return SendClientMessage(playerid, -1,""#net"Вы не состоите в семье!");
	if( sscanf(params, "u", params [0]))return SendEsp(playerid, "/finvite [id]" ) ;
	if(strcmp(family_info [ player_family [ playerid ] ] [ f_creator ],PI[playerid][pNames]) != 0) return ErrorMessage(playerid, "Вы не являетесь владельцем семьи");
	if(!IsPlayerConnected(params [ 0 ]))return ErrorMessage(playerid, "Игрок не найден!" ) ;
	if(player_family[ params [ 0 ] ])return ErrorMessage(playerid, "Уже состоит в семье!" ) ;
	if(!ProxDetectorS(10.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок, не рядом с вами !");
	new fam_id = player_family [ playerid ];
	if(family_info [ fam_id ] [ f_members_amount ] >= 150) return ErrorMessage(playerid, "Максимальное количество игроков в семье - 50 чел.");
	format(string,sizeof(string),"Вы пригласили %s присоединиться к семье %s", PI[params[0]][pNames],family_info [ player_family [ playerid ] ] [ f_name ]);
	SendClientMessage(playerid,-1,string);
	format(string,128,""WHITE"%s приглашает вас присоединиться к семье %s.\nВы согласны присоединиться?",PI[playerid][pNames],family_info [ player_family [ playerid ] ] [ f_name ]);
	ShowPlayerDialog(params [ 0 ],999,DIALOG_STYLE_MSGBOX,""SERVER"Приглашение в семью",string,"Да","Нет");
	SetPVarInt(params [ 0 ],"family_id",player_family [ playerid ]);
	return 1;
}
CMD:funinvite(playerid, params[])
{
	if(!player_family[playerid]) return ErrorMessage(playerid, "Вы не состоите в семье!");
	if( sscanf(params, "u", params [0])) return SendEsp(playerid, "/funinvite [id]" ) ;
	if(strcmp(family_info [ player_family [ playerid ] ] [ f_creator ],PI[playerid][pNames]) != 0) return ErrorMessage(playerid, "Вы не являетесь владельцем семьи");
	if(!IsPlayerConnected(params [ 0 ])) return ErrorMessage(playerid, "Игрок не найден!" ) ;
	if(player_family[ params [ 0 ] ] != player_family [ playerid ]) return ErrorMessage(playerid, "Игрок состоит не в Вашей семьей");
	player_family [ params[0] ] = GetPVarInt(params[0],"family_id");
	DeletePVar(params[0],"family_id");
	format(string,sizeof(string),"{%s}%s: "WHITE"%s был выгнан из семьи.",family_chat_color [ family_info [ player_family [ params[0] ]] [ f_chat_color ] ],family_info [ player_family [ params[0] ] ] [ f_name ],PI[params[0]][pNames]);
	family_message(player_family [ playerid ],-1, string);
	family_info [ player_family [ params[0] ] ] [ f_online ] --;
	family_info [ player_family [ params[0] ] ] [ f_members_amount ] --;
	mysql_format(1, string, sizeof string, "UPDATE `family_system` SET `fam_members_amount` = '%d' WHERE `fam_id` = '%d' LIMIT 1",family_info [ player_family [ params[0] ] ] [ f_members_amount ], player_family [ params[0] ]);
	mysql_tquery ( 1, string) ;
	UpdatePlayerData(params[0], "family", 0);
	return 1;
}
CMD:k(playerid, params[])
{
	if(!player_family [ playerid ])return ErrorMessage(playerid, "Вы не состоите в семье!");
	if( sscanf(params, "s[128]", params [0]))return SendClientMessage(playerid, -1, "Ввведите: /k [текст]" ) ;
	format(string,sizeof(string),"{%s}%s: "WHITE"%s: %s",family_chat_color [ family_info [ player_family [ playerid ] ] [ f_chat_color ] ],family_info [ player_family [ playerid ] ] [ f_name ],PI[playerid][pNames],params [0]);
	family_message(player_family [ playerid ],-1, string);
	return 1;
}
cmd:restart(playerid)
{
	if(D_FULL(PI[playerid][pNames]))
	{
		ServerRestart[1] = 10;
		SendClientMessageToAll(COLOR_REDD, "< "NAME_PROECT" > - Перезагрузка игрового режима через 10 секунд!");
	}
	return 1;
}
