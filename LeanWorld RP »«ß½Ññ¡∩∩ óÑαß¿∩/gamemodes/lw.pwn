	        else ShowPlayerDialog(playerid, 16090, DIALOG_STYLE_INPUT, ""SERVER"Создание промокода", "{FFFFFF}На сколько игроков вы хотите создать промокод?\n\n{AFAFAF}Допустимое значение количества участников от 1 до 500", "Далее", "Отмена");
