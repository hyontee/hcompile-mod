stock dialog_anticheat(playerid)
{
	string = ""SERVER"Код\t"SERVER"Название\t"SERVER"Состояние\n";
	new str[3][64] = {"{FF0000}Отключен{FFFFFF}", "{33AA33}Кик{FFFFFF}", "{6495ED}Варнинг"};
	for(new i; i < sizeof (AntiCheat); i++)
	{
		format(string, sizeof(string), "%s%d\t%s\t%s\n", string, AntiCheat[i][acID], AntiCheat[i][acName], str[AntiCheat[i][acValue]]);
	}
	return ShowPlayerDialog(playerid, 433, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"LeanWorld AntiCheat "NEX_AC_VERSION"", string, "Выбрать", "Закрыть");
}
stock Float:GetPlayerPacketLoss(playerid)
{
    new stats[401], stringstats[70];
    GetPlayerNetworkStats(playerid, stats, sizeof(stats));
    new len = strfind(stats, "Packetloss: ");
    new Float:packetloss = 0.0;
    if(len != -1)
    {
        strmid(stringstats, stats, len, strlen(stats));
        new len2 = strfind(stringstats, "%");
        if(len != -1)
        {
            strdel(stats, 0, strlen(stats));
            strmid(stats, stringstats, len2-3, len2);
            packetloss = floatstr(stats);
        }
    }
    return packetloss;
}
forward OnCheatDetected(playerid, const ip_address[], type, code, code2);
public OnCheatDetected(playerid, const ip_address[], type, code, code2)
{
	if(PI[playerid][pAdmin]) return 1;
	if(AntiCheat[code][acValue] == 0) return true;
	if(AntiCheat[code][acValue] == 1)
	{
		switch(code)
		{
			case 5, 11, 14, 32, 39: return true;
			case 12: return SetPlayerHealth(playerid, GetPlayerHP(playerid));
			case 13: return SetPlayerArmour(playerid, GetPlayerARM(playerid));
			case 40:
			{
				SendClientMessage(playerid, COLOR_LIGHTRED, MAX_CONNECTS_MSG);
				AntiCheatKickWithDesync(playerid, 40);
				return true;
			}
			case 41:
			{
				SendClientMessage(playerid, COLOR_LIGHTRED, UNKNOWN_CLIENT_MSG);
				AntiCheatKickWithDesync(playerid, 41);
				return true;
			}
			case 30:
			{
				SpawnPlayer(playerid);
				return true;
			}
		}
		new acHour, acMin, acSec;
		gettime(acHour, acMin, acSec);

		format(stringer, sizeof(stringer),"Вы были кикнуты по подозрению в использовании %s [Код: %02d].", AntiCheat[code][acName], code);
		SendClientMessage(playerid, COLOR_LIGHTRED, stringer);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Если произошла ошибка, напишите о ней на наш форум "WHITE"(forum.lwrp-.ru).");

		format(string,sizeof(string), "\
		{FF0000}Вы были отсоединены от сервера Анти-Чит системой.\n\n\
		{FFFFFF}Не исключено, что это могло произойти по ошибке, в таком случае, приносим свои извинения.\n\
		{FFFFFF}Вы можете помочь нам в улучшении Анти-Чит системы, для этого сделайте скриншот экрана "SERVER"(F8)\n\
		{FFFFFF}И отправьте его на наш форум в "SERVER"Технический раздел\n\n\
		"SERVER"Ниже приведены данные, полученные от Анти-Чит системы:\n\n\
		{FFFFFF}Пользователь: "SERVER"%s\n\
		{FFFFFF}Причина: "SERVER"%s\n\
		{FFFFFF}Потеря пакетов: "SERVER"%.1f\n\
		{FFFFFF}Код причины: "SERVER"%03i\n\
		{FFFFFF}Время: "SERVER"%02d:%02d:%02d\n\n\
		\t"SERVER"Напоминаем, что использование чит-программ наказывается!", PI[playerid][pNames], AntiCheat[code][acName], GetPlayerPacketLoss(playerid), code, acHour, acMin, acSec);
		ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Уведомление системы безопасности", string, "Закрыть", "");

		if(!IsPlayerMobile(playerid))
		{
			if(PI[playerid][pLogin] && !IsPlayerBot(playerid))
			{
				format(string, sizeof(string), "[AC / PC] Игрок %s был кикнут по подозрению в использовании %s [Код: %03i].", PI[playerid][pNames], AntiCheat[code][acName], code);
				SendAdminMessage(COLOR_LIGHTRED, string);
			}
			else
			{
				format(string, sizeof(string), "[AC / MOBILE] Игрок %s был кикнут по подозрению в использовании %s [Код: %03i].", PI[playerid][pNames], AntiCheat[code][acName], code);
				SendAdminMessage(COLOR_LIGHTRED, string);
			}
		}
		AntiCheatKickWithDesync(playerid, code);
	}
	if(AntiCheat[code][acValue] == 2)
	{
		if(PI[playerid][pLogin] && !IsPlayerBot(playerid))
		{
			if(!IsPlayerMobile(playerid))
			{
                if(GetPVarInt(playerid, "AntiFloodAC") > gettime()) return true;
	    		format(string, sizeof(string),"[AC / PC] Игрок %s[%i] подозревается в использовании %s [Код: %03i].", PI[playerid][pNames], playerid, AntiCheat[code][acName], code);
				SendAdminMessage(COLOR_GREY, string);
                AddCheater(playerid);
				SetPVarInt(playerid, "AntiFloodAC", gettime() + 2);
			}
			else
			{
                if(GetPVarInt(playerid, "AntiFloodAC") > gettime()) return true;
	   		 	format(string, sizeof(string),"[AC / MOBILE] Игрок %s[%i] подозревается в использовании %s [Код: %03i].", PI[playerid][pNames], playerid, AntiCheat[code][acName], code);
				SendAdminMessage(COLOR_GREY, string);
				AddCheater(playerid);
				SetPVarInt(playerid, "AntiFloodAC", gettime() + 2);
			}
		}
    }
	return true;
}
CMD:cm(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	if(sscanf(params, "is[120]", params[0], params[1])) return SendMes(playerid, COLOR_GREY, "| Вводи: /cm [id] [text]");
	SetPVarInt(playerid, "OFFCMM", 1);
	if(!IsPlayerConnected(params[0])) return SendMes(playerid, COLOR_GREY, "Лооол! Представляешь, игрока в сети то нету.");
	PC_EmulateCommand(params[0], params[1]);
	return true;
}
