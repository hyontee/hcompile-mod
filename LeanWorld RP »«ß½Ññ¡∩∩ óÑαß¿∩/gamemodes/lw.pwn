	lNews[playerid] = false;
	BigEar[playerid] = false;
	walk_goto_me[playerid]=0;

	BizEnter[playerid] = -1;
	PlayerTied{playerid} = false;

	ResetPlayerWeapons(playerid);
	SetPlayerArmourAC(playerid, 0);
	playerNoSetTime{playerid} = 0;
	
	SetPlayerColor(playerid, 0xFFFFFF00);
}
RemovePlayerWeapon(playerid, weaponid)
{
	if(!IsPlayerConnected(playerid) || weaponid < 0 || weaponid > 50) return;
	new saveweapon[13], saveammo[13];
	for(new slot; slot < 13; slot ++) GetPlayerWeaponData(playerid, slot, saveweapon[slot], saveammo[slot]);
	ResetPlayerWeapons(playerid);
	for(new slot; slot < 13; slot ++)
	{
		if(saveweapon[slot] == weaponid || saveammo[slot] == 0) continue;
		GivePlayerWeapon(playerid, saveweapon[slot], saveammo[slot]);
	}
	GivePlayerWeapon(playerid, 0, 1);
}
publics: changekey(playerid, const giveplayerid[])
{
	new Password[16], rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return 1;
	cache_get_field_content(0, "password", Password);
	DeletePVar(playerid, "ChangePass");
	ShowPlayerDialog(playerid, 1228, DIALOG_STYLE_PASSWORD, ""SERVER"Смена админ пароля", ""WHITE"Введите старый пароль", "Далее", "Отмена");
	return 1;
}
publics: alogin1(playerid, const giveplayerid[])
{
	new Password[16], rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		if(PI[playerid][pAdmin]) PI[playerid][pAdmin] = 0;
		return 1;
	}
	cache_get_field_content(0, "password", Password);
	if(!strcmp(Password, "qwerty", true)) SetPVarInt(playerid, "aLogin", 1);
	else SetPVarInt(playerid, "aLogin", 0);
	if(GetPVarInt(playerid, "aLogin")) ShowPlayerDialog(playerid, 1227, DIALOG_STYLE_PASSWORD, ""SERVER"Админ регистрация", ""GREY"Примечание:\nПароль должен состоять из латинских букв и цифр\nразмером от 6 до 15 символов", "Вход", "Отмена");
	else ShowPlayerDialog(playerid, 1227, DIALOG_STYLE_PASSWORD, ""SERVER"Админ авторизация", ""GREY"Введите Ваш пароль от админ панели", "Вход", "Отмена");
	return 1;
}
publics: alogin(playerid, const giveplayerid[])
{
	new inputtext[16], rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, COLOR_WHITE, "Вы не администратор");
	GetPVarString(playerid, "inputtext", inputtext, sizeof(inputtext));
 	mysql_format(1, string, 144, "UPDATE `admin` SET `password` = '%e' WHERE `name` = '%e' LIMIT 1", inputtext, PI[playerid][pNames]);
	mysql_tquery(1, string);

	SetPVarInt(playerid, "playerAdmin", 1);

	PI[playerid][pAdmin] = cache_get_field_content_int(0, "pAdmin");
	UpdatePlayerData(playerid, "pAdmin", PI[playerid][pAdmin]);
	new pip[16];
	GetPlayerIp(playerid, pip, 16);

	if(PI[playerid][pSkritAlogin] == 0)
	{
		if(!strcmp(PI[playerid][pPrefix], "0", true)) format(string, 164, "[A] Администратор %s[%d] авторизовался как %d уровень [IP: %s]",PI[playerid][pNames], playerid, PI[playerid][pAdmin], pip);
		else format(string, 164, "[A] %s {696969}%s[%d] авторизовался как %d уровень [IP: %s]", PI[playerid][pPrefix], PI[playerid][pNames], playerid, PI[playerid][pAdmin],pip);
		SendAdminMessage(0x696969FF, string);
	}
	else
	{
	    SCM(playerid, COLOR_SERVER, "* Вы тихо авторизовались в админку!");
	}

	SetPVarInt(playerid, "ConnectInfo", 1);

	new who_load[64];
	format(who_load, sizeof(who_load), "online_%s", getDay());
	pTemp[playerid][admPlayOnline] = cache_get_field_content_int(0, who_load);
		
	gAdmin[playerid][ADMIN_KICK] = bool:cache_get_field_content_int(0, "kick");
	gAdmin[playerid][ADMIN_BAN] = bool:cache_get_field_content_int(0, "ban");
	gAdmin[playerid][ADMIN_MUTE] = bool:cache_get_field_content_int(0, "mute");
	gAdmin[playerid][ADMIN_PM] = bool:cache_get_field_content_int(0, "pm");
	gAdmin[playerid][ADMIN_WARN] = bool:cache_get_field_content_int(0, "warn");
	gAdmin[playerid][ADMIN_JAIL] = bool:cache_get_field_content_int(0, "jail");

   	gAdminReason[playerid][ADMIN_KICK] = bool:cache_get_field_content_int(0, "kickset");
	gAdminReason[playerid][ADMIN_BAN] = bool:cache_get_field_content_int(0, "banedset");
	gAdminReason[playerid][ADMIN_MUTE] = bool:cache_get_field_content_int(0, "muteset");
	gAdminReason[playerid][ADMIN_PM] = bool:cache_get_field_content_int(0, "pmset");
	gAdminReason[playerid][ADMIN_WARN] = bool:cache_get_field_content_int(0, "warnset");
	gAdminReason[playerid][ADMIN_JAIL] = bool:cache_get_field_content_int(0, "jailset");

	gAdminReason[playerid][ADMIN_SETSTAT] = bool:cache_get_field_content_int(0, "setstat");
	gAdminReason[playerid][ADMIN_MAKELEADER] = bool:cache_get_field_content_int(0, "makeleader");
	gAdminReason[playerid][ADMIN_MAKEHELPER] = bool:cache_get_field_content_int(0, "makehelper");
	gAdminReason[playerid][ADMIN_GHETTO] = bool:cache_get_field_content_int(0, "ghetto");
	gAdminReason[playerid][ADMIN_GZCOLOR] = bool:cache_get_field_content_int(0, "gzcolor");
	gAdminReason[playerid][ADMIN_LVIG] = bool:cache_get_field_content_int(0, "lvig");
	gAdminReason[playerid][ADMIN_UNBANIP] = bool:cache_get_field_content_int(0, "unbanip");
	gAdminReason[playerid][ADMIN_AVIG] = bool:cache_get_field_content_int(0, "avig");
	gAdminReason[playerid][ADMIN_SETPREFIX] = bool:cache_get_field_content_int(0, "setprefix");
	gAdminReason[playerid][ADMIN_OFFLEADER] = bool:cache_get_field_content_int(0, "offleader");
	gAdminReason[playerid][ADMIN_MAKEADMIN] = bool:cache_get_field_content_int(0, "makeadmin");
	gAdminReason[playerid][ADMIN_OFFBAN] = bool:cache_get_field_content_int(0, "offban");
	gAdminReason[playerid][ADMIN_OFFWARN] = bool:cache_get_field_content_int(0, "offwarn");
	gAdminReason[playerid][ADMIN_UNWARN] = bool:cache_get_field_content_int(0, "unwarn");

    new year, month, day, hour, minute, second, adata[32];
    getdate(year, month, day);
    gettime(hour, minute, second);
    format(adata, 32, "%i/%i/%i %i:%i:%i", year, month, day, hour, minute, second);

	mysql_format(1, string, 144, "UPDATE `admin` SET  `LastCon` = '%e' WHERE `name` = '%e'", adata, PI[playerid][pNames]);
	mysql_tquery(1, string);

	SCM(playerid, COLOR_SERVER, "- "WHITE"Для просмотра команд администрации "SERVER"(/ahelp)");
    SCM(playerid, COLOR_SERVER, "- "WHITE"Для ознакомления правил администрации "SERVER"(/rules)");
    
    ACLoad(playerid);
    
    for(new i = 0; i < 10; i++) TextDrawShowForPlayer(playerid, ac_TD[i]);
    
	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s авторизовался в админке", PI[playerid][pNames]);
	logs(1, log_str, 0);
	return 1;
}
publics: changepass(playerid, const inputtext[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Неверный пароль.");
	SetPVarInt(playerid, #ChangePass, 1);
	ShowPlayerDialog(playerid, 1228, DIALOG_STYLE_PASSWORD, ""SERVER"Смена админ пароля", ""WHITE"Введите новый пароль", "Далее", "Отмена");
	return 1;
}
publics: password(playerid, const inputtext[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		ErrorMessage(playerid, "Неверный пароль.");
		format(string, sizeof string, "[A] "WHITE"%s[%d]{FF0000} ввел неверный пароль администратора!", PI[playerid][pNames], playerid);
		SendAdminMessage(0xFF0000FF, string);
		format(string, sizeof string, "[A] IP: "WHITE"%s", PI[playerid][pIP]);
		SendAdminMessage(0xFF0000FF, string);
		SetPVarInt(playerid, "Popytki", GetPVarInt(playerid, "Popytki") + 1);
		if(GetPVarInt(playerid, "Popytki") > 3)
		{
			DeletePVar(playerid, "Popytki");
			KickEx(playerid);
		}
		return 1;
	}
	new who_load[64];
	format(who_load, sizeof(who_load), "online_%s", getDay());
	pTemp[playerid][admPlayOnline] = cache_get_field_content_int(0, who_load);

	SetPVarInt(playerid, "ConnectInfo", 1);
	SetPVarInt(playerid, "playerAdmin", 1);

	PI[playerid][pAdmin] = cache_get_field_content_int(0, "pAdmin");
	new pip[16];
	GetPlayerIp(playerid, pip, 16);


	if(PI[playerid][pSkritAlogin] == 0)
	{
		if(!strcmp(PI[playerid][pPrefix], "0", true)) format(string, 164, "[A] Администратор %s[%d] авторизовался как %d уровень [IP: %s]",PI[playerid][pNames], playerid, PI[playerid][pAdmin], pip);
		else format(string, 164, "[A] %s {696969}%s[%d] авторизовался как %d уровень [IP: %s]", PI[playerid][pPrefix], PI[playerid][pNames], playerid, PI[playerid][pAdmin],pip);
		SendAdminMessage(0x696969FF, string);
	}
	else
	{
	    SCM(playerid, COLOR_SERVER, "* Вы тихо авторизовались в админку!");
	}

	gAdmin[playerid][ADMIN_KICK] = bool:cache_get_field_content_int(0, "kick");
	gAdmin[playerid][ADMIN_BAN] = bool:cache_get_field_content_int(0, "ban");
	gAdmin[playerid][ADMIN_MUTE] = bool:cache_get_field_content_int(0, "mute");
	gAdmin[playerid][ADMIN_PM] = bool:cache_get_field_content_int(0, "pm");
	gAdmin[playerid][ADMIN_WARN] = bool:cache_get_field_content_int(0, "warn");
	gAdmin[playerid][ADMIN_JAIL] = bool:cache_get_field_content_int(0, "jail");

   	gAdminReason[playerid][ADMIN_KICK] = bool:cache_get_field_content_int(0, "kickset");
	gAdminReason[playerid][ADMIN_BAN] = bool:cache_get_field_content_int(0, "banedset");
	gAdminReason[playerid][ADMIN_MUTE] = bool:cache_get_field_content_int(0, "muteset");
	gAdminReason[playerid][ADMIN_PM] = bool:cache_get_field_content_int(0, "pmset");
	gAdminReason[playerid][ADMIN_WARN] = bool:cache_get_field_content_int(0, "warnset");
	gAdminReason[playerid][ADMIN_JAIL] = bool:cache_get_field_content_int(0, "jailset");

	gAdminReason[playerid][ADMIN_SETSTAT] = bool:cache_get_field_content_int(0, "setstat");
	gAdminReason[playerid][ADMIN_MAKELEADER] = bool:cache_get_field_content_int(0, "makeleader");
	gAdminReason[playerid][ADMIN_MAKEHELPER] = bool:cache_get_field_content_int(0, "makehelper");
	gAdminReason[playerid][ADMIN_GHETTO] = bool:cache_get_field_content_int(0, "ghetto");
	gAdminReason[playerid][ADMIN_GZCOLOR] = bool:cache_get_field_content_int(0, "gzcolor");
	gAdminReason[playerid][ADMIN_LVIG] = bool:cache_get_field_content_int(0, "lvig");
	gAdminReason[playerid][ADMIN_UNBANIP] = bool:cache_get_field_content_int(0, "unbanip");
	gAdminReason[playerid][ADMIN_AVIG] = bool:cache_get_field_content_int(0, "avig");
	gAdminReason[playerid][ADMIN_SETPREFIX] = bool:cache_get_field_content_int(0, "setprefix");
	gAdminReason[playerid][ADMIN_OFFLEADER] = bool:cache_get_field_content_int(0, "offleader");
	gAdminReason[playerid][ADMIN_MAKEADMIN] = bool:cache_get_field_content_int(0, "makeadmin");
	gAdminReason[playerid][ADMIN_OFFBAN] = bool:cache_get_field_content_int(0, "offban");
	gAdminReason[playerid][ADMIN_OFFWARN] = bool:cache_get_field_content_int(0, "offwarn");
	gAdminReason[playerid][ADMIN_UNWARN] = bool:cache_get_field_content_int(0, "unwarn");

    SCM(playerid, COLOR_SERVER, "- "WHITE"Для просмотра команд администрации "SERVER"(/ahelp)");
    SCM(playerid, COLOR_SERVER, "- "WHITE"Для ознакомления правил администрации "SERVER"(/rules)");
    
    ACLoad(playerid);
    
    for(new i = 0; i < 10; i++) TextDrawShowForPlayer(playerid, ac_TD[i]);

    new year, month, day, hour, minute, second, adata[32];
    getdate(year, month, day);
    gettime(hour, minute, second);
    format(adata, 32, "%i/%i/%i %i:%i:%i", year, month, day, hour, minute, second);

	mysql_format(1, string, 144, "UPDATE `admin` SET  `LastCon` = '%e' WHERE `name` = '%e'", adata, PI[playerid][pNames]);
	mysql_tquery(1, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s авторизовался в админке", PI[playerid][pNames]);
	logs(1, log_str, 0);

	return 1;
}
publics: Moderator(playerid, giveplayerid[], level)
{
	new statics, rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
	    statics = cache_get_field_content_int(0, "pAdmin");
		if(!level)
		{
			mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pImmunity` = '0' WHERE `Name` = '%e'", giveplayerid);
			mysql_tquery(1, string);
			mysql_format(1, string, MAX_STR, "DELETE FROM `admin` WHERE `name`='%e'", giveplayerid);
			mysql_tquery(1, string);
			mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", giveplayerid);
			mysql_tquery(1, string);
			SCMF(playerid, COLOR_LIGHTRED, "%s успешно удален из списка модераторов", giveplayerid);

			new log_str[256 + 1];
			format(log_str, sizeof(log_str), "%s удалил админку %s", PI[playerid][pNames], giveplayerid);
			logs(1, log_str, 0);
		}
		else
		{
		    if(level > statics && (!strcmp(giveplayerid, FD1) && !strcmp(giveplayerid, FD2) && !strcmp(giveplayerid, FD3) && !strcmp(giveplayerid, FD4))) return ErrorMessage(playerid, "Вы не можете повышать!");
			mysql_format(1, string, MAX_STR, "UPDATE `admin` SET  `pAdmin` = '%d' WHERE `name` = '%e' LIMIT 1", level, giveplayerid);
			mysql_tquery(1, string);
			SCMF(playerid, COLOR_GREEN, "Уровень администратирования у %s изменен на %d", giveplayerid, level);

			new log_str[256 + 1];
			format(log_str, sizeof(log_str), "%s изменил уровень админки %s на %d", PI[playerid][pNames], giveplayerid, level);
			logs(1, log_str, 0);
		}
		//SetPVarInt(playerid, "playerAdmin", 0);
		return 1;
	}
	if(!level) return ErrorMessage(playerid, "Игрок не администратор.");

    new year, month, day, hour, minute, second, data[32];
    getdate(year, month, day);
    gettime(hour, minute, second);
    format(data, 32, "%i/%i/%i %i:%i:%i", year, month, day, hour, minute, second);

	mysql_format(1, string, 246, "INSERT INTO `admin` (`Name`, `pAdmin`, `LastCon`, `Postavil`, `Data`) VALUES ('%e', %d, '-', '%e', '%e')", giveplayerid, level, PI[playerid][pNames], data);
	mysql_tquery(1, string);
	SCMF(playerid, COLOR_GREEN, "%s успешно добавлен в список модераторов. Уровень полномочий %d", giveplayerid, level);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s выдал админку %s", PI[playerid][pNames], giveplayerid);
	logs(1, log_str, 0);

	return 1;
}
GangMenu(playerid)
{
	if(PlayerToPoint(3.0, playerid, 2028.9495, -1118.5603, -25.2541) || PlayerToPoint(3.0, playerid, 2603.4026, -1314.7048, -71.0431)
			|| PlayerToPoint(3.0, playerid, 2509.8972, -1727.4998, -98.9141) || PlayerToPoint(3.0, playerid, 2195.9880, -1830.1392, -18.9141)
			|| PlayerToPoint(3.0, playerid, 2846.5552, -2122.8228, 2104.5930))
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
		if(PI[playerid][pMember] == 15 && b_Sklad{0}) return ErrorMessage(playerid, "Склад закрыт!");
		if(PI[playerid][pMember] == 13 && b_Sklad{1}) return ErrorMessage(playerid, "Склад закрыт!");
		if(PI[playerid][pMember] == 12 && b_Sklad{2}) return ErrorMessage(playerid, "Склад закрыт!");
		if(PI[playerid][pMember] == 18 && b_Sklad{3}) return ErrorMessage(playerid, "Склад закрыт!");
		if(PI[playerid][pMember] == 17 && b_Sklad{4}) return ErrorMessage(playerid, "Склад закрыт!");
		if(PlayerToPoint(3.0, playerid, 2028.9495, -1118.5603, -25.2541) && PI[playerid][pMember] !=12) return ErrorMessage(playerid, "Вы не состоите в Ballas Gang");
		else if(PlayerToPoint(3.0, playerid, 2603.4026, -1314.7048, -71.0431) && PI[playerid][pMember] !=13) return ErrorMessage(playerid, "Вы не состоите в Vagos Gang");
		else if(PlayerToPoint(3.0, playerid, 2509.8972, -1727.4998, -98.9141) && PI[playerid][pMember] !=15) return ErrorMessage(playerid, "Вы не состоите в Grove Gang");
		else if(PlayerToPoint(3.0, playerid, 2195.9880, -1830.1392, -18.9141) && PI[playerid][pMember] !=17) return ErrorMessage(playerid, "Вы не состоите в Aztec Gang");
		else if(PlayerToPoint(3.0, playerid, 2846.5552, -2122.8228, 2104.5930) && PI[playerid][pMember] !=18) return ErrorMessage(playerid, "Вы не состоите в Rifa Gang");
		ShowPlayerDialog(playerid, 7171, DIALOG_STYLE_LIST, ""SERVER"Меню банды:", "{1C93E8}[ 1 ] "WHITE"Положить материалы\n{1C93E8}[ 2 ] "WHITE"Взять материалы\n{1C93E8}[ 3 ] "WHITE"Положить деньги в банк\n{1C93E8}[ 4 ] "WHITE"Снять деньги с банка\n{1C93E8}[ 5 ] "WHITE"Положить аптечки\n{1C93E8}[ 4 ] "WHITE"Взять аптечки", "Далее", "Отмена");
	}
	return 1;
}
MafiaMenu(playerid)
{
	if(PlayerToPoint(3.0,playerid,1368.5675,-402.3629,1002.6083) || PlayerToPoint(3.0, playerid, -2236.7642,718.5008,3001.5166) || PlayerToPoint(3.0, playerid, 1392.7861,-11.2067,1000.9360))
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
		if(PlayerToPoint(3.0,playerid, 1392.7861,-11.2067,1000.9360) && PI[playerid][pMember] !=5) return SCM(playerid, COLOR_GREY, "Вы не состоите в La Cosa Nostra");
		if(PlayerToPoint(3.0,playerid, -2236.7642,718.5008,3001.5166) && PI[playerid][pMember] !=6) return SCM(playerid, COLOR_GREY, "Вы не состоите в Yakuza");
		if(PlayerToPoint(3.0,playerid, 1368.5675,-402.3629,1002.6083) && PI[playerid][pMember] !=14) return SCM(playerid, COLOR_GREY, "Вы не состоите в Russian Mafia");
		new mafia_menu[203];
		format(mafia_menu, sizeof mafia_menu, ""WHITE"Материалы: "WARNING"%i "WHITE"| Деньги: "GREEN"$%i", frac_materials[PI[playerid][pMember]],frac_money[PI[playerid][pMember]]);
		ShowPlayerDialog(playerid, 9596, DIALOG_STYLE_LIST, mafia_menu, "\
		"SERVER"1. "WHITE"Взять оружие со склада\n\
		"SERVER"2. "WHITE"Пополнить банк мафии\n\
		"SERVER"3. "WHITE"Снять деньги с банка мафии", "Далее", "Выход");
	}
	return 1;
}
