	strcat(stradm,"{FFFFFF}(2) Приятной игры на LeanWorld Role Play!\n\n");
	strcat(stradm,"{FFFFFF}(3) Слежу за игроком\n\n");
	strcat(stradm,"{FFFFFF}(4) Игрок был наказан. Спасибо за помощь!\n\n");
	strcat(stradm,"{FFFFFF}(5) Нарушений со стороны игрока не было обнаружено\n\n");
