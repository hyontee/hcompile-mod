{
	if(IsPlayerConnected(playerid))
	{
		if(PI[playerid][pMember]==11)
		{
			if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
			ShowPlayerDialog(playerid, 7777, DIALOG_STYLE_LIST, ""SERVER"Выдача лицензий:", ""WHITE"- Водительские права\n- Лицензия на полёты\n- Лицензия на вождение водного транспорта\n- Лицензия на оружие", "Отобрать", "Отмена");
			SetPVarInt(playerid, "ChosenPlayer", clickedplayerid);
		}
	}
	return 1;
}
VodPrava(carid)
{
	switch (GetVehicleModel(carid))
	{
	case 400..416, 418..424, 426..429, 431..445, 449, 451, 455, 456, 458, 459, 461: return 1;
	case 463, 466..468, 470, 471, 474, 475, 477..480, 482, 483, 485, 486, 489..492, 494..496, 498..508: return 1;
	case 514..518, 521..531, 533..537, 539..547, 549..551, 554..562, 564..568, 572..576, 578..583, 585..589, 596..605, 609: return 1;
	}
	return 0;
}

Megaphone(carid)
{
	switch (GetVehicleModel(carid))
	{
	case 425, 427, 433, 470, 490, 497, 500, 523, 528, 548, 563, 596, 597, 598, 599, 601, 560: return 1;
	}
	return 0;
}
publics: Helpers(playerid, query[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, -1, "Не найдено!");
	new online[20], name[MAX_PLAYER_NAME + 1], helper, ttextt[32], ttext[32];
	SendClientMessage(playerid, COLOR_SERVER, "OffLine список саппортов:");
	for(new i = 0; i < rows; i ++)
	{
		helper = cache_get_field_content_int (i, "pHelper");
		cache_get_field_content(i, "Name", name, 1, 24);
		cache_get_field_content(i, "pGetonDate", online, 1, 20);
		switch(helper)
		{
			case 1: ttext = "{FFD700}(Support)";
			default: ttext = "{FFD700}(Support)";
		}
		if(IsPlayerConnected(GetPlayerID(name))) { ttextt = "[{2CE40C}Онлайн"WHITE"]"; }
		else if(!IsPlayerConnected(GetPlayerID(name))) { ttextt = "[{E40C0C}Оффлайн"WHITE"]"; }
		SCMF(playerid, -1, "%s "WHITE"%s "WHITE"%s Дата последнего посещения: %s\n", ttext, name, ttextt, online);
	}
	return 1;
}
publics: Leaders(playerid, query[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Не найдено!");
	new online[20], name[MAX_PLAYER_NAME + 1], leader, ttextt[32], strings[3200];
	strcat(strings, ""SERVER"Организация\t"SERVER"Лидер\t"SERVER"Последнее посещение и статус\n");
	for(new i = 0; i < rows; i ++)
	{
		leader = cache_get_field_content_int (i, "pLeader");
		cache_get_field_content(i, "Name", name, 1, 24);
		cache_get_field_content(i, "pGetonDate", online, 1, 20);
		if(IsPlayerConnected(GetPlayerID(name))) { ttextt = "[{2CE40C}Онлайн"WHITE"]"; }
		else if(!IsPlayerConnected(GetPlayerID(name))) { ttextt = "[{E40C0C}Оффлайн"WHITE"]"; }
 		format(string, sizeof(string), "{%s}%s\t%s\t%s %s\n", GetFractionColor[leader], FI[leader][fName], name, online, ttextt);
		strcat(strings, string);
	}
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"Лидеры организаций", strings, "Закрыть", "");
	return 1;
}
