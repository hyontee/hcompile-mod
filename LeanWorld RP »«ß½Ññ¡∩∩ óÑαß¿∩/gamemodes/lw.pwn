publics: UpdateRaceTD(playerid)
{
	if(GetPVarInt(playerid, "PI_MP") != MP_Racing || !RACE_TIME_TO_START[1] && !RACE_START) return KillTimer(GetPVarInt(playerid, "UpdateRacing")), DeletePVar(playerid, "UpdateRacing"), 1;

	format(string, sizeof(string), "%i/%i", RACE_PLAYERS, MAX_RACE_PLAYER); PlayerTextDrawSetString(playerid, RTD_MText, string);
	format(string, sizeof(string), "%s", TimeConverter((RACE_TIME_TO_FINISH>unix?(RACE_TIME_TO_FINISH-unix):(RACE_TIME_TO_START[1]-1)))); PlayerTextDrawSetString(playerid, RTD_Time, string);
	format(string, sizeof(string), "POINT: %i/%i", GetPVarInt(playerid, "RACE_CHECKPOINT"), sizeof(RaceCheckPoint[])); PlayerTextDrawSetString(playerid, RTD_CP, string);

    new Float:mesto[4];
	foreach(Player, i)
	{
	    if(GetPVarInt(playerid, "PI_MP") != MP_Racing) continue;
		new Float: fDistance = GetPlayerDistanceFromPoint(i, RaceCheckPoint[RACE_MAP][sizeof(RaceCheckPoint[])-1][0], RaceCheckPoint[RACE_MAP][sizeof(RaceCheckPoint[])-1][1], RaceCheckPoint[RACE_MAP][sizeof(RaceCheckPoint[])-1][2]);
    	if(fDistance > mesto[1]) mesto[0] = fDistance, format(string, 64, "1. - ~w~%s", PI[i][pNames]), PlayerTextDrawSetString(i, RTD_MName[0], string);
		else if(fDistance > mesto[2]) mesto[1] = fDistance, format(string, 64, "2. - ~w~%s", PI[i][pNames]), PlayerTextDrawSetString(i, RTD_MName[1], string);
		else if(fDistance > mesto[3]) mesto[2] = fDistance, format(string, 64, "3. - ~w~%s", PI[i][pNames]), PlayerTextDrawSetString(i, RTD_MName[2], string);
		else if(fDistance < mesto[2]) mesto[3] = fDistance;
	}

	return 1;
}
RaceExit(playerid, type)
{
	if(GetPVarInt(playerid, "PI_MP") != MP_Racing || !RACE_START) return 1;

	string = "";
	switch(type)
	{
	    case 1: format(string, 128, ""SERVER"[RACE]: "WHITE"%s (%d) дисквалифицирован. (покинул автомобиль)", PI[playerid][pNames], playerid);
	    case 2: format(string, 128, ""SERVER"[RACE]: "WHITE"%s (%d) дисквалифицирован. (покинул игру)", PI[playerid][pNames], playerid);
	    case 3: format(string, 128, ""SERVER"[RACE]: "WHITE"%s (%d) дисквалифицирован. (смерть)", PI[playerid][pNames], playerid);
	    case 4: format(string, 128, ""SERVER"[RACE]: "WHITE"%s (%d) дисквалифицирован. (взрыв автомобиля)", PI[playerid][pNames], playerid);
		case 5:
		{
		 	RACE_WINNERS++;
			if(RACE_WINNERS >= 1 && RACE_WINNERS <= 3) format(string, 144, ""SERVER"[RACE]: "WHITE"%s (%d) занял %s место в гоночных мероприятиях!", PI[playerid][pNames], playerid, (RACE_WINNERS==1)?("первое"):(RACE_WINNERS==2)?("второе"):("третье"));
			else format(string, 144, ""SERVER"[RACE]: "WHITE"%s (%d) занял %i место в гоночных мероприятиях!", PI[playerid][pNames], playerid, RACE_WINNERS);
		}
		case 6: format(string, 128, ""SERVER"[RACE] "WHITE"%s (%d) дисквалифицирован. (не прибыл к финишу)", PI[playerid][pNames], playerid);
		case 7: format(string, 128, ""SERVER"[RACE] "WHITE"%s (%d) покинул гонку. (/exitrace)", PI[playerid][pNames], playerid);
	}
	foreach(Player, i)
	{
		if(GetPVarInt(i, "PI_MP") != MP_Racing) continue;
		SendClientMessage(i, COLOR_LIGHTBLUE, string);
	}
	KillTimer(GetPVarInt(playerid, "UpdateRacing")), DeletePVar(playerid, "UpdateRacing");
 	for(new i;i<sizeof(RTD_box);i++) TextDrawHideForPlayer(playerid, RTD_box[i]);
	PlayerTextDrawHide(playerid, RTD_MText);
	for(new i;i<sizeof(RTD_MName);i++) PlayerTextDrawHide(playerid, RTD_MName[i]);
	PlayerTextDrawHide(playerid, RTD_Time);
	PlayerTextDrawHide(playerid, RTD_CP);

	RACE_PLAYERS--;
	DeletePVar(playerid, "PI_MP"), DeletePVar(playerid, "RACE_POSITION"), DeletePVar(playerid, "RACE_CHECKPOINT");
	DestroyVehicle(GetPVarInt(playerid, "RACE_VEHICLE")), DeletePVar(playerid, "RACE_VEHICLE");

	SetPlayerPos(playerid, GetPVarFloat(playerid, "Pos_X_MP"), GetPVarFloat(playerid, "Pos_Y_MP"), GetPVarFloat(playerid, "Pos_Z_MP"));
	SetPlayerFacingAngle(playerid, GetPVarFloat(playerid, "Pos_A_MP"));
	SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "Pos_VW_MP"));
	SetPlayerInterior(playerid, GetPVarInt(playerid, "Pos_INT_MP"));

	DeletePVar(playerid, "Pos_X_MP");
	DeletePVar(playerid, "Pos_Y_MP");
	DeletePVar(playerid, "Pos_Z_MP");
	DeletePVar(playerid, "Pos_A_MP");
	DeletePVar(playerid, "Pos_VW_MP");
	DeletePVar(playerid, "Pos_INT_MP");

	if(RACE_PLAYERS <= 0)
	{
        RACE_START = false, RACE_MAP = 0, RACE_WINNERS = 0;
        RACE_PLAYERS = 0, RACE_VEHICLE = 0, RACE_TIME_TO_START[0] = 0, RACE_TIME_TO_START[1] = 0, RACE_TIME_TO_FINISH = 0, MAX_RACE_PLAYER = 0;
	    SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Гоночные мероприятия завершены.");
	    if(type==6) SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Некоторые участники гонки не доехали до финиша и были дисквалифицированы!");
	}

	return 1;
}
publics: StartFilling(playerid)
{
	if(GetPVarInt(playerid, #pFillingStarting))
	{
		new vehicleid = VehicleEnters[playerid];
		if(vehicleid && VehInfo[vehicleid][vFuel] < 200.0) VehInfo[vehicleid][vFuel] += 2.0;
		else if(vehicleid && VehInfo[vehicleid][vFuel] >= 200.0)
		{
			VehInfo[vehicleid][vFuel] = 200.0;
			TogglePlayerControllable(playerid, true);
			MeAction(playerid, "заправил(а) автомобиль");
			SendClientMessage(playerid, CGREEN, "Автомобиль заправлен, всего Вам доброго.");
			DeletePVar(playerid, #pFillingStarting);
			DeletePVar(playerid, #pFilling);
			DeletePVar(playerid, #pFillingID);
			KillTimer(GetPVarInt(playerid, "StartFilling")), DeletePVar(playerid, "StartFilling");
		}
	}
	else KillTimer(GetPVarInt(playerid, "StartFilling")), DeletePVar(playerid, "StartFilling");
}
UpdateRecon(playerid, i)
{
	if(!IsPlayerConnected(i))
	{
		TogglePlayerSpectating(playerid, false);
		DeletePVar(playerid, "Spectate"), SetPVarInt(playerid, "SpectateID", -1);
		TextDrawHideForPlayer(playerid, ReconText), PlayerTextDrawDestroy(playerid, PlayerText:ReconPlayerText[playerid][0]), PlayerTextDrawDestroy(playerid, PlayerText:ReconPlayerText[playerid][1]);
		SetPlayerPos(playerid, gPlayerPosition[playerid][0], gPlayerPosition[playerid][1], gPlayerPosition[playerid][2]);
		SetPlayerInterior(playerid, gPIrmation[playerid][0]);
		SetPlayerVirtualWorld(playerid, gPIrmation[playerid][1]);
		return 1;
	}
	new Float:healthcar, vehicleid=VehicleEnters[playerid];
	string = "";
	GetVehicleHealth(VehicleEnters[i], healthcar);
	new speedlimit;
	if(GetPlayerState(i) == PLAYER_STATE_DRIVER || GetPlayerState(i) == PLAYER_STATE_PASSENGER)
	{
	    new modelid = GetVehicleModel(VehicleEnters[i]);
	    if(modelid>=400) speedlimit=SpeedLimit[modelid-400] + 80;
		else speedlimit=28;
	}
	else speedlimit=28;
	new gun, ammo;
	GetPlayerWeaponData(playerid, GetWeaponSlot(GetPlayerWeapon(i)), gun, ammo);
    format(string, 70, "~w~%s~n~ID: %d %s", PI[i][pNames], i, (pTemp[i][pAFK]>=3) ? ("~r~AFK") : (""));
	PlayerTextDrawSetString(playerid, ReconPlayerText[playerid][0], string);
	new Float:health, Float:armour;
	GetPlayerHealth(playerid, health);
	GetPlayerArmour(playerid, armour);
	format(string, 200, "%d : %d / %d~n~%d~n~%d~n~%d~n~%d~n~%d / %d~n~%d~n~%d : %d ~n~%d / %d : %d%%~n~%d / %d : %d%%~n~%d",
	PI[i][pLevel], PI[i][pExp], (PI[i][pLevel]+1)*4, PI[i][pWarns], floatround(armour), floatround(health),
	GetPlayerState(i)!=2 && GetPlayerState(i) != 3 && vehicleid != INVALID_PLAYER_ID ? -1 : floatround(healthcar), // хп машины
	SpeedPlayer(i), // скорость
	(speedlimit >= 28) ? (speedlimit) : (28), // максимальная скорость
	GetPlayerPing(i), // пинг
	GetPlayerAmmo(i), (GetWeaponSlot(GetPlayerWeapon(i)) != -1) ? (gun) : (-1), // патроны
	GetPVarInt(i, "r_shot"), GetPVarInt(i, "r_shot_hit"),
	GetPVarInt(i, "r_shot_hit") > 1 && GetPVarInt(i, "r_shot") > 1 ? ((GetPVarInt(i, "r_shot_hit")+1)/(GetPVarInt(i, "r_shot")+1)*100) : (0),
	GetPVarInt(i, "r_shot_10"), GetPVarInt(i, "r_shot_hit_10"),
	GetPVarInt(i, "r_shot_hit") > 1 && GetPVarInt(i, "r_shot") > 1 ? ((GetPVarInt(i, "r_shot_hit_10")+1)/(GetPVarInt(i, "r_shot_10")+1)*100) : (0),
	(pTemp[i][pAFK] >= 3)?(pTemp[i][pAFK]):(0));
	PlayerTextDrawSetString(playerid, ReconPlayerText[playerid][1], string);
	return 1;
}
publics:_@RobBank(i)
{
	new rand = random(12), randmoney = random(60);
	switch(rand)
	{
		case 0..4:
		{
			if(randmoney != 37)
			{
				new kaznarob = Gos_Nalog[1]/40;
				PI[i][pRobTime] = unix+10800;
				ApplyAnimation(i, "ROB_BANK", "CAT_Safe_End", 4.1, 0, 1, 1, 0, 0);
				PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
    			PI[i][pWanted] += 4; SetPlayerWantedLevel(i, PI[i][pWanted]);
				UpdatePlayerData(i, "pWanted", PI[i][pWanted]);
				Hook_GivePlayerMoney(i, kaznarob);
				Gos_Nalog[1] -= kaznarob;
				format(string, sizeof(string), "~g~+$%d", kaznarob);
				GameTextForPlayer(i, string, 5000, 1);
				format(string, sizeof(string), "* Незнакомец взламывает банковский сейф на %d вирт.", kaznarob);
			}
			else
			{
				new kaznarob = Gos_Nalog[1]/20;
				PI[i][pRobTime] = unix+10800;
				ApplyAnimation(i, "ROB_BANK", "CAT_Safe_End", 4.1, 0, 1, 1, 0, 0);
				PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
 				PI[i][pWanted] += 4; SetPlayerWantedLevel(i, PI[i][pWanted]);
				UpdatePlayerData(i, "pWanted", PI[i][pWanted]);
				Hook_GivePlayerMoney(i, kaznarob);
				Gos_Nalog[1] -= kaznarob;
				format(string, sizeof(string), "~g~+$%d", kaznarob);
				GameTextForPlayer(i, string, 5000, 1);
				format(string, sizeof(string), "Срочные новости: Незнакомец вытащил из банковского сейфа %i$!", kaznarob);
				SendClientMessageToAll(0x9ACD32FF, string);
				format(string, sizeof(string), "* Незнакомец взламывает банковский сейф на %s вирт.", kaznarob);
			}
		}
		default:
		{
			if(BankLight_Status)
			{
				ApplyAnimation(i, "ROB_BANK", "CAT_Safe_End", 4.1, 0, 1, 1, 0, 0);
				PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
				SendClientMessage(i, COLOR_GREY, "Попробуйте еще раз. Электричество банка отключено, спешите!");
				string = "* Незнакомец неудачно взламывает банковский сейф.";
			}
			else
			{
				ApplyAnimation(i, "ROB_BANK", "CAT_Safe_End", 4.1, 0, 1, 1, 0, 0);
				PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
				SendClientMessage(i, COLOR_GREY, "Попробуйте еще раз.");
 				PI[i][pWanted] ++; SetPlayerWantedLevel(i, PI[i][pWanted]);
				UpdatePlayerData(i, "pWanted", PI[i][pWanted]);
				string = "* Незнакомец неудачно взламывает банковский сейф.";
			}
		}
	}
	if(strlen(string) > 8) ProxDetector(30.0, i, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	TogglePlayerControllable(i, 1);
	ClearAnimations(i, 1);
	BankRob_Status = false;
	KillTimer(GetPVarInt(i, "RobBankTimer")), DeletePVar(i, "RobBankTimer");
	UpdateText(2);
	return 1;
}
GivePlayer_Reputation(playerid, bonus = 1)
{
	SCMF(playerid, -1, ""#information"Ваша репутация повышена за выполнение квеста (+%i)", bonus), SCMF(playerid, -1, ""#information"Бонусом Вы получаете +%i донат монет!", (100*bonus));
	PI[playerid][pReputation] += bonus;
	UpdatePlayerData(playerid, "pReputation", PI[playerid][pReputation]);
	PI[playerid][pDonate] += (100*bonus);
	UpdatePlayerData(playerid, "pDonate", PI[playerid][pDonate]);
	return 1;
}

publics: LoadProd(playerid)
{
    format(string, 144, "{f0f0f0}[Продуктов: %d/5000]\n{5DD174}Бизнес: Не выбран", GetPVarInt(playerid, "count_prod"));
    UpdateDynamic3DTextLabelText(gPlayerProdText[playerid][0], 0xFFFFFF20, string);

	if(GetPVarInt(playerid, "count_prod") >= GetPVarInt(playerid, "count_prod2"))
	{
	    SendClientMessage(playerid, -1, ""#good"Продукты загружены, выберите бизнес куда вы хотите загрузить продукты.");
        string="{919191}[номер] - {A8413A}[имя бизнеса] - {5364A3}[цена за один продукт] - {5364A3}[к-во требуемых продуктов]\n\n";
		for(new i=1; i!=20; i++)
	    {
    		format(string, 2400, "%s{919191}%d. "WHITE"- {A8413A}\" %s \" "WHITE"- {5364A3}'%d' "WHITE"- {5364A3}'%d'\n", string, i, BizInfo[i][bName], BizInfo[i][bProdOrderPrice], BizInfo[i][bProdOrder]);
	    }
	    strcat(string, "\n\n"WHITE"Используйте {"#cGREEN"}номер "WHITE"бизнеса в поле ниже\n{A8413A}0 "WHITE"для выхода из меню");
	    ShowPlayerDialog(playerid, 1113, DIALOG_STYLE_INPUT, ""SERVER"Бизнес", string, "Выбрать", "Далее ->");
	    SetPVarInt(playerid, "prod_next", GetPVarInt(playerid, "prod_next")+20);
	    DeletePVar(playerid, "count_prod2");
	}
	else
	{
		SetTimerEx("LoadProd", 150, 0, "i", playerid);
		SetPVarInt(playerid, "count_prod", GetPVarInt(playerid, "count_prod") + 50);
	}
	return 1;
}
SetPlayerGPSS(playerid, iconid, Float:x, Float:y, Float:z, markertype, color, style)
{
    SendClientMessage(playerid, -1, "Чтобы снять метку Используйте "SERVER"/unmark");
	SetPVarFloat(playerid, "GPS_X", x);
	SetPVarFloat(playerid, "GPS_Y", y);
	SetPVarFloat(playerid, "GPS_Z", z);
	SetPlayerMapIcon(playerid, iconid, x, y, z, markertype, color, style);
	return 1;
}
public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
	if(checkpointid == gPlayerProdCP[playerid] && GetPVarInt(playerid, "prod_id"))
	{
	    new bizid = GetPVarInt(playerid, "prod_id")-1;
	    new prod = GetPVarInt(playerid, "count_prod");

        SendClientMessage(playerid, -1, ""#good"Продукты в бизнес доставлены:");
        SCMF(playerid, -1, ""#information"Доставлено: %d продуктов. Заработано: %d$", prod, (BizInfo[bizid][bProdOrderPrice]*prod));
        SendClientMessage(playerid, -1, ""#information"Чтобы доставить продукты к еще одному бизнесу следуйте за маркером на мини-карте");

	    SetPlayerRaceCheckpoint(playerid, 1, -116.87, -320.27, 1.42, 0.0, 0.0, 0.0, 5.0);

  		UpdateDynamic3DTextLabelText(gPlayerProdText[playerid][0], 0xFFFFFF20, "{f0f0f0}[Продуктов: 0/1000]\n{5DD174}Бизнес: Не выбран");
	    DestroyDynamic3DTextLabel(gPlayerProdText[playerid][1]);
	    DestroyDynamicCP(gPlayerProdCP[playerid]);

		Hook_GivePlayerMoney(playerid, (BizInfo[bizid][bProdOrderPrice]*prod));

   		BizInfo[bizid][bProdOrder] -= prod;
		BizInfo[bizid][bProd] += prod;
		SaveBusiness(bizid);

		DeletePVar(playerid, "prod_id");
	    DeletePVar(playerid, "count_prod");
	    return 1;
	}
	if(checkpointid == pomosh_bol)
	{
		ShowPlayerDialog(playerid, 12022, DIALOG_STYLE_MSGBOX, "Лечение", "Вы хотите полностью вылечится за 1000$?", "Да", "Нет");
	}
	return 1;
}
CarEnter(playerid, vehicleid)
{
	if(VodPrava(vehicleid) && !PI[playerid][pLicenses][0] && !pTemp[playerid][pOnExam]) return ErrorMessage(playerid, "У Вас нет лицензии на управление т/c."), RemovePlayerFromVehicle(playerid);
	else if(IsABoat(vehicleid) && !PI[playerid][pLicenses][2]) return ErrorMessage(playerid, "У Вас нет лицензии на управление водным транспортом"), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= SwatCar[0] && vehicleid <= SwatCar[1] && PI[playerid][pMember] != 25) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: SWAT."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= hitcar[0] && vehicleid <= hitcar[1] && PI[playerid][pMember] != 24) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Hitmans."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= lsnewscar[0] && vehicleid <= lsnewscar[1] && PI[playerid][pMember] != 16) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: LeanWorld News Network."), RemovePlayerFromVehicle(playerid);
	//else if(vehicleid >= sfpdcar[0] && vehicleid <= sfpdcar[1] && PI[playerid][pMember] != 10) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: SFPD."), RemovePlayerFromVehicle(playerid);
	//else if(vehicleid >= lvpdcar[0] && vehicleid <= lvpdcar[1] && PI[playerid][pMember] != 21) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: LVPD."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= ruscar[0] && vehicleid <= ruscar[2] && PI[playerid][pMember] != 14) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Russian Mafia."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= lcncar[0] && vehicleid <= lcncar[2] && PI[playerid][pMember] != 5) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: La Cosa Nostra."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= yakcar[0] && vehicleid <= yakcar[2] && PI[playerid][pMember] != 6) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Yakuza."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= govcar[0] && vehicleid <= govcar[1] && !IsAMayor(playerid)) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: Мэрия"), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= bikecar[0] && vehicleid <= bikecar[1] && PI[playerid][pMember] != 23) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Байкеры."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= matsfuraballas[0] && vehicleid <= matsfuraballas[0] && PI[playerid][pMember] != 12) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: The Ballas Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= fbicar[0] && vehicleid <= fbicar[4] && PI[playerid][pMember] != 2) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: FBI."), RemovePlayerFromVehicle(playerid);
	else if(((vehicleid >= sapdpatrul[0] && vehicleid <= sapdpatrul[1]) || (vehicleid >= sapdcar[0] && vehicleid <= sapdcar[1])) && PI[playerid][pMember] != 1) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: LSPD."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= MedCar[0] && vehicleid <= MedCar[1] && !IsAMedic(playerid)) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: Больница"), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= ministrcar[0] && vehicleid <= ministrcar[1] && PI[playerid][pMember] != 26) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: Правительству штата."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= mehanik[0] && vehicleid <= mehanik[1] && PI[playerid][pJob] != 1) return ErrorMessage(playerid, "Вы не работаете механиком."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= matsfuragrove[0] && vehicleid <= matsfuragrove[0] && PI[playerid][pMember] != 15) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Grove Street Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= matsfuraactek[0] && vehicleid <= matsfuraactek[0] && PI[playerid][pMember] != 17) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Varios Los Aztecas Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= matsfuravagos[0] && vehicleid <= matsfuravagos[0] && PI[playerid][pMember] != 13) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Los Santos Vagos Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= matsfurarifa[0] && vehicleid <= matsfurarifa[0] && PI[playerid][pMember] != 18) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: The Rifa Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= ballascar[0] && vehicleid <= ballascar[1] && PI[playerid][pMember] != 12) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: The Ballas Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= grovecar[0] && vehicleid <= grovecar[1] && PI[playerid][pMember] != 15) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Grove Street Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= coronoscar[0] && vehicleid <= coronoscar[1] && PI[playerid][pMember] != 17) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Varios Los Aztecas Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= vagoscar[0] && vehicleid <= vagoscar[1] && PI[playerid][pMember] != 13) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Los Santos Vagos Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= rifacar[0] && vehicleid <= rifacar[1] && PI[playerid][pMember] != 18) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: The Rifa Gang."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= armycar[0] && vehicleid <= armycar[1] && PI[playerid][pMember] != 3) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: Армии Авианосец."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= vmfcar[0] && vehicleid <= vmfcar[1] && PI[playerid][pMember] != 27) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: Военно Морскому Флоту."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= armcar[0] && vehicleid <= armcar[1] && PI[playerid][pMember] != 19 && !GetPVarInt(playerid, "Keys") && !GetPVarInt(playerid, "ArmySkin_Check")) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: Сухопутные Войска."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= liccar[0] && vehicleid <= liccar[1] && PI[playerid][pMember] != 11 && !pTemp[playerid][pOnExam]) return ErrorMessage(playerid, "Транспорт пренадлежит государственной организации: Инструкторы."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= StreetCar[0] && vehicleid <= StreetCar[6] && PI[playerid][pMember] != 22) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Street Racers Club."), RemovePlayerFromVehicle(playerid);
	else if(vehicleid >= USACar[0] && vehicleid <= USACar[1] && PI[playerid][pMember] != 20) return ErrorMessage(playerid, "Транспорт пренадлежит нелегальной организации: Армии U.S.A."), RemovePlayerFromVehicle(playerid);
 	if(vehicleid >= rentcarsf[0] && vehicleid <= rentcarsf[1])
	{
		if(RentCar[vehicleid] == -1)
		{
			ShowPlayerDialog(playerid, 9126, DIALOG_STYLE_MSGBOX, ""SERVER"Компания", ""WHITE"Предоставление услуг аренды автомобиля\nЖелаете арендовать у нас автомобиль?\n\n\t"WHITE"Стоимость аренды: {228B22}5000 вирт\n\n"WHITE"Если после вас эту машину арендует кто-то\n"WHITE"другой, ваш договор с компанией по аренде будет расторгнут.", "Аренда", "Отмена");
			TogglePlayerControllable(playerid, false);
		}
		else if(RentCar[vehicleid] != -1 && RentCar[vehicleid] != playerid) return ErrorMessage(playerid, "Транспорт уже арендуют."), RemovePlayerFromVehicle(playerid);
	}
	if(GetVehicleModel(vehicleid) == 520)//Гидра
	{
		if(!GetPVarInt(playerid, "StartRabWork") && StartRabWork(playerid)) return ErrorMessage(playerid, "Вы не начали рабочий день!"), RemovePlayerFromVehicle(playerid);
		if(!IsAArm(playerid) || PI[playerid][pRank] < 8)
		{
			new Float:slx, Float:sly, Float:slz;
			GetPlayerPos(playerid, slx, sly, slz);
			SetPlayerPos(playerid, slx, sly, slz+5);
			RemovePlayerFromVehicle(playerid);
			ErrorMessage(playerid, "Вам недоступна данная техника.");
		}
	}
	else if(GetVehicleModel(vehicleid) == 425)//Апач
	{
		if(!GetPVarInt(playerid, "StartRabWork") && StartRabWork(playerid)) return ErrorMessage(playerid, "Вы не начали рабочий день!"), RemovePlayerFromVehicle(playerid);
		if(!IsAArm(playerid) && PI[playerid][pRank] < 8)
		{
			new Float:slx, Float:sly, Float:slz;
			GetPlayerPos(playerid, slx, sly, slz);
			SetPlayerPos(playerid, slx, sly, slz+5);
			RemovePlayerFromVehicle(playerid);
			ErrorMessage(playerid, "Вам недоступна данная техника.");
		}
	}
	else if(GetVehicleModel(vehicleid) == 432)//Танк
	{
		if(!GetPVarInt(playerid, "StartRabWork") && StartRabWork(playerid)) return ErrorMessage(playerid, "Вы не начали рабочий день!"), RemovePlayerFromVehicle(playerid);
		if(!IsAArm(playerid) && PI[playerid][pRank] < 8)
		{
			new Float:slx, Float:sly, Float:slz;
			GetPlayerPos(playerid, slx, sly, slz);
			SetPlayerPos(playerid, slx, sly, slz+5);
			RemovePlayerFromVehicle(playerid);
			ErrorMessage(playerid, "Вам недоступна данная техника.");
		}
	}
	//else if(vehicleid == lcncar[2] || vehicleid == yakcar[2] || vehicleid == ruscar[2]) SendClientMessage(playerid, -1, ""#information"Для загрузки наркотиков введите: /loading, для разгрузки: /unload.");
	else if(GetPVarInt(playerid, "JOB_LSPD_1") == 1 && GetPVarInt(playerid, "JOB_LSPD_CAR") == -1 && GetVehicleModel(vehicleid) == 525)
	{
		SendClientMessage(playerid, -1, ""#information"Вы должны доставить автомобиль с г.San-Fierro в гараж полиции г.Los-Santos.");
		new RANDOM_FUNCTION = RandomEx(0, sizeof(Car_V)-1), RANDOM_CAR = RandomEx(0, sizeof(RACE_VEHICLE_ID)-1);
		FIX_BAG: RANDOM_FUNCTION = RandomEx(0, sizeof(Car_V)-1);
	 	if(IsValidVehicle(Car_V[RANDOM_FUNCTION])) goto FIX_BAG;
		else
		{
		    Car_V[RANDOM_FUNCTION] = CreateVehicle(RACE_VEHICLE_ID[RANDOM_CAR], Car_V_Position[RANDOM_FUNCTION][0], Car_V_Position[RANDOM_FUNCTION][1], Car_V_Position[RANDOM_FUNCTION][2], Car_V_Position[RANDOM_FUNCTION][3], 0, 0, 75000);
		    LinkVehicleToInterior(Car_V[RANDOM_FUNCTION], 0), SetVehicleVirtualWorld(Car_V[RANDOM_FUNCTION], 0), SetVehicleParamsForPlayer(Car_V[RANDOM_FUNCTION], 0, 0, true);

			SetPlayerCheckpoint(playerid, Car_V_Position[RANDOM_FUNCTION][0], Car_V_Position[RANDOM_FUNCTION][1], Car_V_Position[RANDOM_FUNCTION][2], 5.0);
			SendClientMessage(playerid, -1, ""#information"Чекпоинт установлен на место, где стоит автомобиль для эвакуации! Направляйтесь туда!");

			SetPVarInt(playerid, "JOB_LSPD_CAR", RANDOM_FUNCTION);
		}
	}
	else if(GetPVarInt(playerid, "JOB_LSPD_2") == 1 && vehicleid >= sapdcar[0] && vehicleid <= sapdcar[1])
	{
		SendClientMessage(playerid, -1, ""#information"Вы должны организовать пост ДПС на выезде из города г. Los-Santos.");
		new RANDOM_FUNCTION = RandomEx(0, 1);
		if(!RANDOM_FUNCTION) SetPlayerCheckpoint(playerid, 53.1254, -1538.2727, 4.8544, 3.0);
		else SetPlayerCheckpoint(playerid, 54.7376, -1524.8124, 4.7452, 3.0);
		SendClientMessage(playerid, -1, ""#good"Чекпоинт установлен на карте!");

		SendClientMessage(playerid, -1, ""#information"По приезду на место, установите ''/break (1/2/3/4)'' на место где установлен чекпоинт!");
		SetPVarInt(playerid, "JOB_LSPD_2", 2);
	}
	else if(vehicleid >= aProd[0] && vehicleid <= aProd[1])
	{
		if(PI[playerid][pJob] != 2)
		{
		    ErrorMessage(playerid, "Вы не работаете развозчиком продуктов.");
		    RemovePlayerFromVehicle(playerid);
		}
		else if(PI[playerid][pCash] < 450)
		{
			ErrorMessage(playerid, "Вам нужно {"#cGREEN"}450 $ "WHITE"для аренды");
			RemovePlayerFromVehicle(playerid);
		}
		else if(GetPVarInt(playerid, "prod_vehicle_id") > 0 && GetPVarInt(playerid, "prod_vehicle_id") != vehicleid)
		{
			ErrorMessage(playerid, "Вы уже арендуете т/c.");
			RemovePlayerFromVehicle(playerid);
		}
		else if(!GetPVarInt(playerid, "prod_vehicle_id"))
		{
			ShowPlayerDialog(playerid, 1112, DIALOG_STYLE_MSGBOX, ""SERVER"Аренда", ""WHITE"Вы хотите арендовать этот автомобиль за {"#cGREEN"}450 $"WHITE" ?", "Аренда", "Отмена");
		}
		else
		{
			foreach(Player, i)
			{
				if(GetPVarInt(i, "prod_vehicle_id") == vehicleid && i != playerid)
				{
				    ErrorMessage(playerid, "Этот автомобиль уже арендуют");
					RemovePlayerFromVehicle(playerid);
					break;
				}
			}
		}

	}
	else if(gVehicleGun[vehicleid][vGunLoading] || gVehicleGun[vehicleid][vGunUnloading])
	{
		if(vehicleid == lcncar[2] && PI[playerid][pMember] != 5) return 1;
		if(vehicleid == yakcar[2] && PI[playerid][pMember] != 6) return 1;
		if(vehicleid == ruscar[2] && PI[playerid][pMember] != 14) return 1;
		ShowPlayerDialog(playerid, 8571, DIALOG_STYLE_MSGBOX, ""SERVER"Погрузка", ""WHITE"Вы хотите прекратить загрузку наркотиков в грузовик?", "Принять", "Отмена");
	}
	for(new i; i < MAX_SELL; i ++)
	{
		if(!SellingCar[i][sellCarStatus] || GetVehicleModel(VehicleEnters[playerid]) != SellingCar[i][sCarID] || !PlayerToPoint(1.0, playerid, CoordSellCars[i][0], CoordSellCars[i][1], CoordSellCars[i][2]) ) continue;
		if(!strcmp(PI[playerid][pNames], SellingCar[i][sName]))
        {
            ShowPlayerDialog(playerid, 5133, DIALOG_STYLE_MSGBOX, ""SERVER"Снятия автомобиля с продажи", ""WHITE"Вы действительно хотите снять автомобиль с продажи?", "Да", "Отмена");
            SetPVarInt(playerid, "OwnerCar", true), SetPVarInt(playerid, "Car_Autoyar", i);
			return 1;
        }
		format(string, 300, ""SERVER"Автомобиль находится на продаже!\n"WHITE"Владелец: "SERVER"%s\n"WHITE"Цена: "SERVER"%i$\n"WHITE"Модель автомобиля: "SERVER"%s\n\n"WHITE"Вы хотите купить данный автомобиль?", SellingCar[i][sName], SellingCar[i][sMoney], VehicleNames[GetVehicleModel(VehicleEnters[playerid])-400]);
		ShowPlayerDialog(playerid, 5133, DIALOG_STYLE_MSGBOX, ""SERVER"Автоярмарка", string, "Да", "Отмена");
		SetPVarInt(playerid, "Car_Autoyar", i);
		break;
	}
 	if(GetPVarInt(playerid, "SelectAvto") == -1)
    {
		if(GetVehicleModel(vehicleid) == 462)
	    {
	        new engine,lights,alarm,doors,bonnet,boot,objective;
		    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
		    SetVehicleParamsEx(vehicleid, true, lights, alarm, doors, bonnet, boot, objective);
		    return 1;
	    }
	    if(IsABike(vehicleid))
		{
		    new lights,alarm,doors,bonnet,boot,objective;
			SetVehicleParamsEx(vehicleid, true, lights, alarm, doors, bonnet, boot, objective);
		}
	    if(!IsABike(vehicleid))
	    {
	        SCM(playerid, 0x696969FF, "Чтобы завести двигатель, нажмите "WHITE"'2'. {696969}Чтобы включить фары, нажмите "WHITE"'CTRL'.");
            playerLastLights{playerid} = 255;
		    SetTimerEx("UpdateSpeedometr", 50, 0, "i", playerid);
		    SetPVarInt(playerid, "ShowSpeed", true);
		    ShowSpeedometer(playerid);
		}
	}
	return 1;
}
publics: __@CheckDonate(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows && cache_get_field_content_int(0, "pRubDon") <= 0) return ErrorMessage(playerid, "Нет пополнений счета игрового аккаунта!");
	PI[playerid][pRubInfo] += cache_get_field_content_int(0, "pRubDon");
	UpdatePlayerData(playerid, "pRub", PI[playerid][pRubInfo]), UpdatePlayerData(playerid, "pRubDonate", 0);
	PI[playerid][pRubDonateTotal][1] += cache_get_field_content_int(0, "pRubDonate");
	UpdatePlayerData(playerid, "pRubDonateTotal1", PI[playerid][pRubDonateTotal][1]);
	SCMF(playerid, -1, ""#good"На Ваш счет зачислено: %i рублей, теперь у Вас %i рублей!", cache_get_field_content_int(0, "pRubDonate"), PI[playerid][pRubInfo]);
	SCMF(playerid, -1, ""#information"Всего на сервер Вами задоначено: %i рублей!", PI[playerid][pRubDonateTotal][1]);
	SCMF(playerid, -1, ""#information"На донат затрачено: %i рублей!", PI[playerid][pRubDonateTotal][0]);
	return 1;
}

CheckMapCords(Float:x, Float:y, &Float:X, &Float:Y)
{
    if(y < -3000) y = -3000;
    else if(y > 3000) y = 3000;
    if(x < -3000) x = -3000;
    else if(x > 3000) x = 3000;
    if(y > -3000 && y < 3000 && x > -3000 && x < 3000)
    {
        if(y < 0) Y = 230 + 138 * -y / 3000; //207
        else if(y >= 0) Y = 230 - 138 * y / 3000;
        if(x < 0) X = 473 - -x * 151 / 3000;//318
        else if(x >= 0) X = 473 + x * 151 / 3000;
    }
    return 1;
}
CreatePlayerMapDraws(playerid, giveplayerid)
{
    if(!ShowMap[playerid]) return 1;
    new Float:x[2], Float:y[2], Float:z[2], Float:Pos_X[2], Float:Pos_Y[2];
    GetPlayerPos(giveplayerid, x[0], y[0], z[0]);
    CheckMapCords(x[0], y[0], Pos_X[0], Pos_Y[0]);
    GetPlayerPos(playerid, x[1], y[1], z[1]);
    CheckMapCords(x[1], y[1], Pos_X[1], Pos_Y[1]);
    PlayerDraw[playerid][0] = CreatePlayerTextDraw(playerid, Pos_X[0], Pos_Y[0], ".");
    PlayerDraw[playerid][1] = CreatePlayerTextDraw(playerid, Pos_X[1], Pos_Y[1], ".");
    PlayerTextDrawFont(playerid, PlayerDraw[playerid][0], 1); PlayerTextDrawFont(playerid, PlayerDraw[playerid][1], 1);
    PlayerTextDrawLetterSize(playerid, PlayerDraw[playerid][0], 0.49, 2.9);	PlayerTextDrawLetterSize(playerid, PlayerDraw[playerid][1], 0.49, 2.9);
    PlayerTextDrawColor(playerid, PlayerDraw[playerid][0], 0x253fcfFF);	PlayerTextDrawColor(playerid, PlayerDraw[playerid][1], 0x253fcfFF);
    PlayerTextDrawSetOutline(playerid, PlayerDraw[playerid][0], 1); PlayerTextDrawSetOutline(playerid, PlayerDraw[playerid][1], 1);
    format(string, 128, "%s ID: %i ~y~ %s", (pTemp[giveplayerid][pAFK]>=3) ? ("AFK") : (""), giveplayerid, PI[giveplayerid][pNames]);
    StatsDraw[playerid][0] = CreatePlayerTextDraw(playerid, Pos_X[0]-10, Pos_Y[0]+10, string);
    format(string, 128, "ID: %i ~r~ %s", playerid, PI[playerid][pNames]);
    StatsDraw[playerid][1] = CreatePlayerTextDraw(playerid, Pos_X[1]-10, Pos_Y[1]+10, string);
    PlayerTextDrawFont(playerid, StatsDraw[playerid][0], 1); PlayerTextDrawFont(playerid, StatsDraw[playerid][1], 1);
    PlayerTextDrawLetterSize(playerid, StatsDraw[playerid][0], 0.16, 0.6); PlayerTextDrawLetterSize(playerid, StatsDraw[playerid][1], 0.16, 0.6);
    PlayerTextDrawColor(playerid, StatsDraw[playerid][0], 0xFFFFFFFF); PlayerTextDrawColor(playerid, StatsDraw[playerid][1], 0xFFFFFFFF);
    PlayerTextDrawSetOutline(playerid, StatsDraw[playerid][0], 1); PlayerTextDrawSetOutline(playerid, StatsDraw[playerid][1], 1);
    PlayerTextDrawShow(playerid, PlayerDraw[playerid][0]); PlayerTextDrawShow(playerid, PlayerDraw[playerid][1]);
    PlayerTextDrawShow(playerid, StatsDraw[playerid][0]); PlayerTextDrawShow(playerid, StatsDraw[playerid][1]);
    return 1;
}

DestroyPlayerMapDraws(playerid)
{
    PlayerTextDrawDestroy(playerid, PlayerText:PlayerDraw[playerid][0]);
    PlayerTextDrawDestroy(playerid, PlayerText:PlayerDraw[playerid][1]);
    PlayerTextDrawDestroy(playerid, PlayerText:StatsDraw[playerid][0]);
    PlayerTextDrawDestroy(playerid, PlayerText:StatsDraw[playerid][1]);
    return 1;
}

UpdateMap(playerid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
    {
        DestroyPlayerMapDraws(playerid);
        if(IsPlayerConnected(playerid)) CreatePlayerMapDraws(playerid, GetPVarInt(playerid, "give_id"));
    }
    return 1;
}
TogglePlayerMap(playerid, bool:toggle)
{
    if(toggle)
    {
        if(!ShowMap[playerid])
        {
            new Float:X, Float:Y, Float:Z;
            GetPlayerCameraPos(playerid, X, Y, Z);
            if(X == -1795 && Y == 1735 && Z == -99) return ErrorMessage(playerid, "Нельзя в данный момент...");
            TextDrawShowForPlayer(playerid, Map[0]);
            TextDrawShowForPlayer(playerid, Map[1]);
            TextDrawShowForPlayer(playerid, Map[2]);
            TextDrawShowForPlayer(playerid, Map[3]);
            ShowMap[playerid] = true;
            PlayerTextDrawShow(playerid, PlayerDraw[playerid][0]);
            PlayerTextDrawShow(playerid, PlayerDraw[playerid][1]);
            PlayerTextDrawShow(playerid, StatsDraw[playerid][0]);
            PlayerTextDrawShow(playerid, StatsDraw[playerid][1]);
        }
    }
    else
    {
        PlayerTextDrawHide(playerid, PlayerDraw[playerid][0]);
        PlayerTextDrawHide(playerid, PlayerDraw[playerid][1]);
        PlayerTextDrawHide(playerid, StatsDraw[playerid][0]);
        PlayerTextDrawHide(playerid, StatsDraw[playerid][1]);
        TextDrawHideForPlayer(playerid, Map[0]);
        TextDrawHideForPlayer(playerid, Map[1]);
        TextDrawHideForPlayer(playerid, Map[2]);
        TextDrawHideForPlayer(playerid, Map[3]);
        ShowMap[playerid] = false;
    }
    return 1;
}
weekday(day, month, year)
{
    if (month <= 2)
        month += 12, --year;
    new j = year % 100;
    new e = year / 100;
    return (day + (month+1)*26/10 + j + j/4 + e/4 - 2*e) % 7;
}
getDay()
{
	new days[][10] = {"saturday", "sunday", "monday", "tuesday", "wednesday", "thursday", "friday"};
	new year, month, day;
	getdate(year, month, day);
	return days[weekday(day, month, year)];
}
forward OnCheckStatsLeader(playerid, name[]);
public OnCheckStatsLeader(playerid, name[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
	    string = "";

	    new
			check_online_monday,
			check_online_tuesday,
			check_online_wednesday,
			check_online_thursday,
			check_online_friday,
			check_online_saturday,
			check_online_sunday,
			check_online_allday;

 		check_online_monday = cache_get_field_content_int(0, "online_monday");
 		check_online_tuesday = cache_get_field_content_int(0, "online_tuesday");
 		check_online_wednesday = cache_get_field_content_int(0, "online_wednesday");
 		check_online_thursday = cache_get_field_content_int(0, "online_thursday");
 		check_online_friday = cache_get_field_content_int(0, "online_friday");
 		check_online_saturday = cache_get_field_content_int(0, "online_saturday");
 		check_online_sunday = cache_get_field_content_int(0, "online_sunday");

	    format(string, sizeof(string), "{FF9900}Недельный онлайн\n\n");

	    format(stringer, sizeof(stringer), "{FFFFFF}Понедельник:\t\t{3399FF}%s {FFFFFF}| Норма онлайна - %s\n", ConvertsCmdTime(check_online_monday), (check_online_monday / 3600 >= 3) ? ("{228B22}Выполнена") : (check_online_monday / 3600 >= 2) ? ("{1294dd}Частично выполнена") : ("{F04245}Не выполнена"));
	    strcat(string, stringer);
	    format(stringer, sizeof(stringer), "{FFFFFF}Вторник\t\t{3399FF}%s {FFFFFF}| Норма онлайна - %s\n", ConvertsCmdTime(check_online_tuesday),  (check_online_tuesday / 3600 >= 3) ? ("{228B22}Выполнена") : (check_online_tuesday / 3600 >= 2) ? ("{1294dd}Частично выполнена") : ("{F04245}Не выполнена"));
	    strcat(string, stringer);
	    format(stringer, sizeof(stringer), "{FFFFFF}Среда\t\t\t{3399FF}%s {FFFFFF}| Норма онлайна - %s\n", ConvertsCmdTime(check_online_wednesday),  (check_online_wednesday / 3600 >= 3) ? ("{228B22}Выполнена") : (check_online_wednesday / 3600 >= 2) ? ("{1294dd}Частично выполнена") : ("{F04245}Не выполнена"));
	    strcat(string, stringer);
	    format(stringer, sizeof(stringer), "{FFFFFF}Четверг\t\t{3399FF}%s {FFFFFF}| Норма онлайна - %s\n", ConvertsCmdTime(check_online_thursday),  (check_online_thursday / 3600 >= 3) ? ("{228B22}Выполнена") : (check_online_thursday / 3600 >= 2) ? ("{1294dd}Частично выполнена") : ("{F04245}Не выполнена"));
	    strcat(string, stringer);
	    format(stringer, sizeof(stringer), "{FFFFFF}Пятница\t\t{3399FF}%s {FFFFFF}| Норма онлайна - %s\n", ConvertsCmdTime(check_online_friday),  (check_online_friday / 3600 >= 3) ? ("{228B22}Выполнена") : (check_online_friday / 3600 >= 2) ? ("{1294dd}Частично выполнена") : ("{F04245}Не выполнена"));
	    strcat(string, stringer);
	    format(stringer, sizeof(stringer), "{FFFFFF}Суббота\t\t{3399FF}%s {FFFFFF}| Норма онлайна - %s\n", ConvertsCmdTime(check_online_saturday),  (check_online_saturday / 3600 >= 3) ? ("{228B22}Выполнена") : (check_online_saturday / 3600 >= 2) ? ("{1294dd}Частично выполнена") : ("{F04245}Не выполнена"));
	    strcat(string, stringer);
	    format(stringer, sizeof(stringer), "{FFFFFF}Воскресенье\t\t{3399FF}%s {FFFFFF}| Норма онлайна - %s\n", ConvertsCmdTime(check_online_sunday),  (check_online_sunday / 3600 >= 3) ? ("{228B22}Выполнена") : (check_online_sunday / 3600 >= 2) ? ("{1294dd}Частично выполнена") : ("{F04245}Не выполнена"));
	    strcat(string, stringer);

	    check_online_allday = check_online_monday + check_online_tuesday + check_online_wednesday + check_online_thursday + check_online_friday + check_online_saturday + check_online_sunday;

	    format(stringer, sizeof(stringer), "\n{AFAFAF}Общий онлайн:\t{DD90FF}%s {FFFFFF}| Норма онлайна - %s\n\n", ConvertsCmdTime(check_online_allday), (check_online_allday / 3600 >= 21) ? ("{228B22}Выполнена") : (check_online_allday / 3600 >= 19) ? ("{1294dd}Частично выполнена") : ("{F04245}Не выполнена"));
	    strcat(string, stringer);

		new admcount[500]; format(admcount, sizeof admcount, ""SERVER"Лидер: %s | Организация: {%s}%s", name, GetFractionColor[PI[playerid][pMember]], FI[PI[playerid][pLeader]][fName]);
		ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, admcount , string, "Закрыть", "");
	}
	else ErrorMessage(playerid, "Лидер не найден!");
	return 1;
}
