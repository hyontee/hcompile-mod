CMD:alogs(playerid, params[])
{
	if(!D_FULL(PI[playerid][pNames])) return true;
	if(sscanf(params,"s[144]", params[0])) return SendClientMessage(playerid, -1,""#information"/alogs [text]");
	format(LogText[playerid], 144, params[0]);
	LogNomer[playerid] = 0;
	new lquery[256];
	format(lquery, 256, "SELECT * FROM `redlogs` WHERE `Text` LIKE '%s%s%s' ORDER BY `redlogs`.`ID` DESC LIMIT 0,20", "%", params[0], "%");
	mysql_tquery(1, lquery, "OnPlayerRedLogs", "i", playerid);
	return 1;
}
publics: OnPlayerRedLogs(playerid)
{
	new rows,fields;
	cache_get_data(rows,fields,1);
	if(!rows) return SendClientMessage(playerid, COLOR_RED, "Логи не найдены!");
	string="";
	printf("onplayerredlogs");
	new string_strcat[200], lid, ldate[32], ltext[144];
	for(new z; z < rows; z ++)
	{
		lid = cache_get_field_content_int(z, "ID",1);
		cache_get_field_content(z, "Date", ldate,1,32);
		cache_get_field_content(z, "Text", ltext,144);
		format(string_strcat, sizeof(string_strcat), "{FF4E4D}%d {FFFFFF}%s {4DFF52}[%s]\n", lid, ltext, ldate);
		strcat(string, string_strcat);
	}
	SPD(playerid, 22848, DIALOG_STYLE_MSGBOX, "Логи(Раздача привилегий)", string, "Далее", "Назад");
	return 1;
}
stock AddaLog(str1[], str2[], str3[], str4[], str5[], str6[])
{
	new lstr[210];
	new day,month,year,hour,minuite,second;
	getdate(year, month, day);
	gettime(hour,minuite,second);
	FixHour(hour);
	hour = shifthour;
	new data2[64];
	format(data2, 64, "%02d.%02d.%d в %02d:%d",day,month,year,hour,minuite);

	mysql_format(1, lstr, 4096, "INSERT INTO `redlogs` (`Text`, `Date`) VALUES ('%s %s %s %s %s %s', '%s')",
	str1, str2, str3, str4, str5, str6, data2);

	mysql_query(1, lstr, false);

	return 1;
}
stock FixHour(hour)
{
	hour = 0+hour;
	if (hour < 0) hour = hour+24;
	else if (hour > 23) hour = hour-24;
	shifthour = hour;
	return 1;
}
CMD:rclist(playerid)
{
	if(PI[playerid][pRainClist] != 1) return ErrorMessage(playerid, "Радужный клист не куплен, для покупки введите - /donate");
	if(IsAGang(playerid) && CaptureInfo) return ErrorMessage(playerid, "В данный момент идёт захват за территорию.");
	new enclisted;
	if(enclisted == 0)
	{
		RainBowTimer[playerid] = SetTimerEx("@__RainBowTimer", 1000, true, "d", playerid);
		SCM(playerid, COLOR_GREEN, "Вы успешно включили радужный клист!");
		enclisted++;
	}
	else
	{
	    KillTimer(RainBowTimer[playerid]);
	    SCM(playerid, COLOR_RED, "Вы успешно выключили радужный клист!");
	}
	return true;
}
@__RainBowTimer(playerid);
@__RainBowTimer(playerid)
