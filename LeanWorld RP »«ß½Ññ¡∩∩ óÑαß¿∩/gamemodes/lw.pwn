forward split(const strsrc[], strdest[][], delimiter);
public split(const strsrc[], strdest[][], delimiter)
{
    new i, li;
    new aNum;
    new len;
    while(i <= strlen(strsrc))
    {
	    if(strsrc[i]==delimiter || i==strlen(strsrc))
        {
	        len = strmid(strdest[aNum], strsrc, li, i, 128);
	        strdest[aNum][len] = 0;
	        li = i+1;
	        aNum++;
        }
        i++;
    }
    return 1;
}
stock LoadDisableables()
{
	mysql_tquery(1, "SELECT * FROM `FDenable` WHERE `name` = 'promo'", "@LoadPromoDS");
	mysql_tquery(1, "SELECT * FROM `FDenable` WHERE `name` = 'ban'", "@LoadBanDS");
	mysql_tquery(1, "SELECT * FROM `FDenable` WHERE `name` = 'warn'", "@LoadWarnDS");
	mysql_tquery(1, "SELECT * FROM `FDenable` WHERE `name` = 'pm'", "@LoadPMDS");
	mysql_tquery(1, "SELECT * FROM `FDenable` WHERE `name` = 'kick'", "@LoadKickDS");
	mysql_tquery(1, "SELECT * FROM `FDenable` WHERE `name` = 'bonus'", "@LoadBonusDS");
	return 1;
}

forward @LoadPromoDS();
public @LoadPromoDS()
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return print("Error!!");
	EnableInfo[promo] = cache_get_field_content_int(0, "enabled");
	return 1;
}

