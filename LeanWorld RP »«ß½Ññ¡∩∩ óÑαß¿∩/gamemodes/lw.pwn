		FriendDialog(playerid, true, friendname);
}

IsNoWindowsCar(vehicleid)
{
	switch(GetVehicleModel(vehicleid)) { case 481, 510, 509, 424, 448, 457, 461, 462, 463, 464, 465, 468, 471, 501, 521, 522, 523, 530, 531, 539, 568, 571, 572, 581, 586, 594: return 1; }
	return 0;
}
ShowUpdate(playerid)
{
	string = "";
	format(string, 246, "- Решительность\t\t%s\n- Рюкзак\t\t\t%s\n- Информация", (PI[playerid][pResh] ? ("{FFCD00}Активно") : ("{03c03c}требуется 5 уровень и 700 DM")), (PI[playerid][pSum] ? ("{FFCD00}Активно") : ("{03c03c}требуется 6 уровень и 1000 DM")));
	return ShowPlayerDialog(playerid, 2552, DIALOG_STYLE_LIST, ""SERVER"Улучшения", string, "Выбрать", "Назад");
}
NextBanner(playerid, id_banner)
{
	SetPlayerPos(playerid, Cam_Pos[id_banner][0], Cam_Pos[id_banner][1], Cam_Pos[id_banner][2]+1.5);
	InterpolateCameraPos(playerid, Cam_Pos[id_banner][0], Cam_Pos[id_banner][1], Cam_Pos[id_banner][2], Cam_Pos[id_banner][3], Cam_Pos[id_banner][4], Cam_Pos[id_banner][5], 1000, CAMERA_MOVE);
	InterpolateCameraLookAt(playerid, Cam_Pos[id_banner+1][0], Cam_Pos[id_banner+1][1], Cam_Pos[id_banner+1][2], Cam_Pos[id_banner+1][3], Cam_Pos[id_banner+1][4], Cam_Pos[id_banner+1][5], 1000, CAMERA_MOVE);
	return 1;
}
SetPlayerCash(playerid, money)
{
	PI[playerid][pCash] = money;
	ResetPlayerMoney(playerid);
	GivePlayerMoney(playerid, PI[playerid][pCash]);
	return 1;
}
SearchingHit(playerid)
{
	new d;
	string = "";
	format(string, sizeof(string), ""SERVER"Выберите и введите номер жертвы\n\n"WHITE"");
	foreach(Player, i)
	{
		if(PI[i][pHeadValue] && ContractInfo[i][cHitman] == INVALID_PLAYER_ID)
		{
			d++;
			if(d > 0 && d < 5) format(string, sizeof(string), "%s[{32CD32}%d"WHITE"] - Номер : %d ~ [{FFFF00}%s (%d вирт)"WHITE"]\n", string, d, i, PI[i][pNames], PI[i][pHeadValue]);
		}
	}
	if(!d) return ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Доступные контракты", ""WHITE"Нету доступных контрактов", "Закрыть", "");
	ShowPlayerDialog(playerid, 5230, DIALOG_STYLE_INPUT, ""SERVER"Доступные контракты", string, "Выбрать", "Назад");
	return 1;
}
publics: SleepTimer(playerid, id, Float:x, Float:y, Float:z)
{
	if(GetPlayerAnimationIndex(playerid) != 390) ApplyAnimation(playerid, "CRACK", "Crckidle2", 4.1, 1, 0, 0, 0, 0, 0);
	if(!PlayerToPoint(3.0, playerid, x, y, z)) return KillTimer(GetPVarInt(playerid, "SleepTimer")), DeletePVar(playerid, "SleepTimer"), DeletePVar(playerid, "StartSleep"), ClearAnimations(playerid, 1), ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1), TogglePlayerControllable(playerid, true);
	new Float:HealthPlayer;
	GetPlayerHealth(playerid, HealthPlayer);
	if(HealthPlayer >= 150.0) return KillTimer(GetPVarInt(playerid, "SleepTimer")), DeletePVar(playerid, "SleepTimer"), DeletePVar(playerid, "StartSleep"), ClearAnimations(playerid, 1), ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1), TogglePlayerControllable(playerid, true);
	SetPlayerHealth(playerid, HealthPlayer+1);
	GameTextForPlayer(playerid, "~g~+~w~1 HP", 850, 1);
	return 1;
}
public OnEnterExitModShop(playerid, enterexit, interiorid)
{
	if(enterexit) SetPVarInt(playerid, "Anti_OnEnterExitModShop", unix+60000);
	else SetPVarInt(playerid, "Anti_OnEnterExitModShop", unix+5);
	return 1;
}
DynamicObjectToPoint(Float:radi, objectid, Float:x, Float:y, Float:z)
{
	new Float:pos[3];
	GetDynamicObjectPos(objectid, pos[0], pos[1], pos[2]);
	pos[0] = (pos[0] -x);
	pos[1] = (pos[1] -y);
	pos[2] = (pos[2] -z);
	if(pos[0] < radi && pos[0] > -radi && pos[1] < radi && pos[1] > -radi && pos[2] < radi && pos[2] > -radi) return 1;
	return 0;
}
InteriorViewing(playerid, i)
{
	SetPlayerPos(playerid, Cam_Pos_Interior[i][0], Cam_Pos_Interior[i][1], Cam_Pos_Interior[i][2] + 1.5);
	InterpolateCameraPos(playerid, Cam_Pos_Interior[i][0], Cam_Pos_Interior[i][1], Cam_Pos_Interior[i][2], Cam_Pos_Interior[i][3], Cam_Pos_Interior[i][4], Cam_Pos_Interior[i][5], 6000, CAMERA_MOVE);
	InterpolateCameraLookAt(playerid, Cam_Pos_Interior[i+1][0], Cam_Pos_Interior[i+1][1], Cam_Pos_Interior[i+1][2], Cam_Pos_Interior[i+1][3], Cam_Pos_Interior[i+1][4], Cam_Pos_Interior[i+1][5], 6000, CAMERA_MOVE);
	return 1;
}
publics: Fraction_CallBack(playerid, page)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "В Вашей фракции никто не состоит!");
	if(GetPVarInt(playerid, "cFractionList"))
	{
	    for(new i; i < 15; i ++) StringName[playerid][i] = 0;
	    DeletePVar(playerid, "cFractionList");
	}
	new Name[24], Geton[32], t;
	format(string, sizeof(string), ""WHITE"Имя Фамилия\t"WHITE"Звание/Ранг\t"WHITE"Возраст\t"WHITE"Последний вход\n"SERVER"Перейти на следующую страницу\nПерейти на предыдущую страницу\n");
	for(new i = (page != 1 ? (page*15) : (0)); i < rows; i ++)
	{
     	if((rows > 15 && t >= 15) || (t >= rows)) break;
	    cache_get_field_content(i, "Name", Name, 1, sizeof(Name));
	    cache_get_field_content(i, "pGetonDate", Geton, 1, sizeof(Geton));
	    StringName[playerid][GetPVarInt(playerid, "cFractionList")] = cache_get_field_content_int(i, "id");
		SetPVarInt(playerid, "cFractionList", GetPVarInt(playerid, "cFractionList")+1);
	    format(string, sizeof(string), "%s%i."WHITE" %s\t["SERVER"%s (%i)"WHITE"]\t["SERVER"%i"WHITE" лет/год(-а)]\t["SERVER"%s"WHITE"]\n", string, (i<15 ? (i+1) : (i-14)), Name, PlayerRank[PI[playerid][pMember]-1][cache_get_field_content_int(i, "pRank")-1], cache_get_field_content_int(i, "pRank"), cache_get_field_content_int(i, "age"), Geton);
		t++;
	}
	if(!t) return ErrorMessage(playerid, "Нет страниц!"), callcmd::lmenu(playerid);
	SetPVarInt(playerid, "cList", (page != 1 ? (page) : (1)));
	format(stringer, 64, ""SERVER"Страница номер: %i", GetPVarInt(playerid, "cList"));
	ShowPlayerDialog(playerid, 8957, DIALOG_STYLE_TABLIST_HEADERS, stringer, string, "Далее", "Отмена");
	return 1;
}
publics: Fraction_CallBack_2(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Внутриигровая ошибка #1");
	new Name[24], Geton[32];
	cache_get_field_content(0, "Name", Name, 1, sizeof(Name));
	cache_get_field_content(0, "pGetonDate", Geton, 1, sizeof(Geton));
	format(string, 512, "\
	"WHITE"Имя Фамилия:\t\t\t"SERVER"%s"WHITE"\n\
	Звание/Ранг:\t\t\t["SERVER"%s (%i)"WHITE"]\n\
	Последний вход (Д/М/Г):\t["SERVER"%s"WHITE"]\n\
	- Повысить сотрудника\n\
	- Понизить сотрудника\n\
	- Уволить сотрудника",
	Name, PlayerRank[PI[playerid][pMember]-1][cache_get_field_content_int(0, "pRank")-1], cache_get_field_content_int(0, "pRank"), Geton);
	ShowPlayerDialog(playerid, 8952, DIALOG_STYLE_LIST, ""SERVER"Информация о игроке", string, "Принять", "Назад");
	return 1;
}
publics: Fraction_CallBack_3(playerid, type)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Внутриигровая ошибка #2");
	new Name[24];
	string = "";
	cache_get_field_content(0, "Name", Name, 1, sizeof(Name));
	if(IsPlayerConnected(GetPlayerID(Name)))
	{
		if(GetPVarInt(playerid, "cFractionList"))
		{
		    for(new i; i < 15; i ++) StringName[playerid][i] = 0;
		    DeletePVar(playerid, "cFractionList");
		}
		return ErrorMessage(playerid, "Игрок в сети!");
	}
	switch(type)
	{
	    case 0:
	    {
        	switch(cache_get_field_content_int(0, "pMember"))
			{
				case 1, 10, 21: if(cache_get_field_content_int(0, "pRank") >= 14) return ErrorMessage(playerid, "У игрока максимальный ранг!");
				case 2, 4, 5, 11..15, 17, 18, 22, 24..26: if(cache_get_field_content_int(0, "pRank") >= 9) return ErrorMessage(playerid, "У игрока максимальный ранг!");
				case 3, 19, 20: if(cache_get_field_content_int(0, "pRank") >= 14) return ErrorMessage(playerid, "У игрока максимальный ранг!");
				case 7: if(cache_get_field_content_int(0, "pRank") >= 5) return ErrorMessage(playerid, "У игрока максимальный ранг!");
				case 8: if(cache_get_field_content_int(0, "pRank") >= 5) return ErrorMessage(playerid, "У игрока максимальный ранг!");
				case 16: if(cache_get_field_content_int(0, "pRank") >= 12) return ErrorMessage(playerid, "У игрока максимальный ранг!");
				case 23: if(cache_get_field_content_int(0, "pRank") >= 8) return ErrorMessage(playerid, "У игрока максимальный ранг!");
				case 27: if(cache_get_field_content_int(0, "pRank") >= 10) return ErrorMessage(playerid, "У игрока максимальный ранг!");
			}
			mysql_format(1, string, 164, "UPDATE `accounts` SET `pRank` = `pRank` + '1' WHERE `id` = '%i'", StringName[playerid][GetPVarInt(playerid, "cFractionList")]);
			mysql_tquery(1, string);
			format(string, 164, "[Offline] Лидер организации %s повысил сотрудника %s до %d ранга", PI[playerid][pNames], Name, cache_get_field_content_int(0, "pRank")+1);
	    }
	    case 1:
	    {
	        if(cache_get_field_content_int(0, "pRank") <= 1) return ErrorMessage(playerid, "У игрока первый ранг!");
  			mysql_format(1, string, 164, "UPDATE `accounts` SET `pRank` = `pRank` - '1' WHERE `id` = '%i'", StringName[playerid][GetPVarInt(playerid, "cFractionList")]);
			mysql_tquery(1, string);
			format(string, 164, "[Offline] Лидер организации %s понизил сотрудника %s до %d ранга", PI[playerid][pNames], Name, cache_get_field_content_int(0, "pRank")-1);
		}
	    case 2:
	    {
  			mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0' WHERE `id` = '%i'", StringName[playerid][GetPVarInt(playerid, "cFractionList")]);
			mysql_tquery(1, string);
			format(string, 164, "Лидер организации %s уволил в оффлайне сотрудника %s", PI[playerid][pNames], Name);
	    }
	}
	if(strlen(string)) SendFractionMessage(PI[playerid][pMember], 0xFFBC00FF, string);
	else ErrorMessage(playerid, "Произошла ошибка, сообщите об этом администратору!");
	if(GetPVarInt(playerid, "cFractionList"))
	{
	    for(new i; i < 15; i ++) StringName[playerid][i] = 0;
	    DeletePVar(playerid, "cFractionList");
	}
	return 1;
}
GoPlayerAnimation(playerid, Float:X, Float:Y, Float:Z)
{
	if(IsPlayerInAnyVehicle(playerid)) return 0;
	if(IsPlayerInRangeOfPoint(playerid, 2.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "IDLE_STANCE", 4.1, 0, 1, 1, 0, 0, 1), 1;
	else if(IsPlayerInRangeOfPoint(playerid, 4.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "WALK_PLAYER", 4.1, 0, 1, 1, 0, 0, 1), 2;
	else if(IsPlayerInRangeOfPoint(playerid, 7.0, X, Y, Z)) return ApplyAnimation(playerid, "PED", "RUN_GANG1", 4.1, 0, 1, 1, 0, 0, 1), 3;
	else return ApplyAnimation(playerid, "PED", "SPRINT_PANIC", 4.1, 0, 1, 1, 0, 0, 1), 4;
}

SetPlayerFaceToPoint(playerid, Float:X, Float:Y)
{
    new Float:angle;
	new Float:misc = 5.0;
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	angle = 180.0-atan2(x-X, y-Y);
	angle += misc;
	misc *= -1;
	SetPlayerFacingAngle(playerid, angle+misc);
    return 1;
}

forward BlocksCallback(playerid, gplayerid, reason_chs[], status);
public BlocksCallback(playerid, gplayerid, reason_chs[], status)
{
	new rows, fields; string = "";
	cache_get_data(rows, fields);
	if(!status && rows) return ErrorMessage(playerid, "Игрок уже состоит в черном списке!");
	else if(!status && !rows)
	{
		mysql_format(1, string, 164, "INSERT INTO `blocks` (`blockName`, `blockFraction`, `blockReason`) VALUES ('%e', '%i', '%e')", PI[gplayerid][pNames], PI[gplayerid][pMember], reason_chs);
		mysql_query(1, string, false);
		SendClientMessage(playerid, -1, "* Игрок успешно добавлен в черный список Вашей фракции!");
		SetPlayerArmourAC(gplayerid, 0);
		ResetPlayerWeapons(gplayerid);
		SetPlayerColor(gplayerid, COLOR_WHITE);
		SetPlayerSkin(gplayerid, PI[gplayerid][pChar]);

		if(StartRabWork(gplayerid))
		{
			SendClientMessage(gplayerid, COLOR_BLUE, "Ваш рабочий день окончен!");
			SetPVarInt(gplayerid, "StartRabWork", 0);
		}

		PI[gplayerid][pMember] = 0;
		PI[gplayerid][pLeader] = 0;
		PI[gplayerid][pRank] = 0;
		PI[gplayerid][vig] = 0;

		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `vig` = '0' WHERE `id` = '%d'", PI[gplayerid][pID]);
		mysql_tquery(1, string);

		SetPlayerInterior(gplayerid, 0);
		SendClientMessage(gplayerid, COLOR_REDD, "* Лидер добавил Вас в черный список, Вы уволены и не сможете вступить в его фракцию!");
		SCMF(gplayerid, COLOR_REDD, "* Причина добавления: %s", reason_chs);
		return 1;
	}
	else if(status == 1 && !rows) return ErrorMessage(playerid, "Игрок не состоит в черном списке!");
	else if(status == 1 && rows)
	{
		mysql_format(1, string, 144, "DELETE FROM `blocks` WHERE `blockName` = '%e' AND `blockFraction` = '%i'", PI[gplayerid][pNames], PI[playerid][pMember]);
		mysql_tquery(1, string);
		SendClientMessage(playerid, -1, "* Игрок успешно удален из черного списка Вашей фракции!");
		return 1;
	}
	else if(status==3 && rows) return ErrorMessage(playerid, "Игрок находится в черном списке фракции!");
	else if(status==2)
	{
	    format(string, sizeof(string), ""WHITE"Номер\t\tИмя\t\tПричина добавления");
		new NAME[24], REASON[64];
		for(new i; i < rows; i ++)
		{
		    cache_get_field_content(i, "blockName", NAME, 1, sizeof(NAME)), cache_get_field_content(i, "blockReason", REASON, 1, sizeof(REASON));
		    if(!strcmp(NAME, "None")) format(string, sizeof(string), "%s\n\n%i - ПУСТО\n", string, i+1);
			else format(string, sizeof(string), "%s\n\n%i.\t\t%s\t\t%s\n", string, i+1, NAME, REASON);
		}
		ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Черный список фракции!", string, "Принять", "");
		return 1;
	}
	else if(status==3)
	{
		format(string, 200, ""WHITE"%s предлагает Вам вступить в организацию: "SERVER"%s"WHITE"\n\nНажмите Да для согласия.\nНажмите Нет для отказа!", PI[playerid][pNames], GetMember[PI[playerid][pMember]-1]);
		ShowPlayerDialog(gplayerid, 1147, DIALOG_STYLE_MSGBOX, ""SERVER"Предложение", string, "Да", "Нет");
		SCMF(playerid, -1, "Вы предложили "SERVER"%s"WHITE" вступить в организацию "SERVER"%s", PI[gplayerid][pNames], GetMember[PI[playerid][pMember]-1]);
		SetPVarInt(gplayerid, "pOfferFractionid", PI[playerid][pMember]);
		SetPVarInt(gplayerid, "Player", playerid);
		SetPVarInt(playerid, "actinplayerid", gplayerid);
		return 1;
	}
	return 1;
}

ShowCaptureTasher(playerid, listitem)
{
	new idg;
	switch(listitem)
	{
		case 0: idg = 17;
		case 1: idg = 18;
		case 2: idg = 12;
		case 3: idg = 15;
		case 4: idg = 13;
	}
	mysql_format(1, string, 144, "SELECT * FROM `accounts` WHERE `pMember` = '%i' AND `kill_capture` !=  '0' ORDER BY `kill_capture` DESC LIMIT 30", idg);
	mysql_tquery(1, string, "ShowTopCapture", "i", playerid);
	return 1;
}

