CMD:vozdush(playerid)
{
    if(!PI[playerid][pShar]) return ErrorMessage(playerid, "У вас нету воздушного шара. Купить его можно в /donate");
	CreateVozdushShar(playerid,19338);
	return true;
}
stock CreateVozdushShar(playerid,idobj)
{
    if(GetPlayerState(playerid)!=1) return ErrorMessage(playerid, "Вы уже находитесь в транспорте!");
   	if(GetPlayerInterior(playerid) > 0) return ErrorMessage(playerid, "Использовать в интерьере нельзя!");
	if(PI[playerid][plveh]!=-1)DestroyVehicle(PI[playerid][plveh]);
	new Float:X, Float:Y, Float:Z, Float:A;
	GetPlayerPos(playerid, X, Y, Z);
	GetPlayerFacingAngle(playerid, A);
	new yourvehicleid, Text3D:vehicletext;
	yourvehicleid = AddStaticVehicle(487, X, Y, Z, A, -1, -1);
	LinkVehicleToInterior(yourvehicleid, 100);
	VehInfo[yourvehicleid][vLock] = false;
	VehInfo[yourvehicleid][vEngine] = false;
	VehInfo[yourvehicleid][vLamp] = false;
	VehInfo[yourvehicleid][vFuel] = 200.0;
	DestroyDynamicObject(objectshar[playerid]);
	objectshar[playerid] = CreateDynamicObject(idobj, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, 0.000000, -1, -1, -1, 300.000000);
	AttachDynamicObjectToVehicle(objectshar[playerid], yourvehicleid, 0.000000, -0.000000, -1.000000, 0.000000, 0.000000, -0.000000);
	PutPlayerInVeh(playerid, yourvehicleid, 0);
	vehicletext = Create3DTextLabel(""SERVER"Воздушный шар 'LWRP'\n\n{FFBF00}Войти: {FFFFFF}'F'\n\n{FFBF00}Чтобы занять пассажирское место: {FFFFFF}`G`", -1, 7.77, 7.77, 7.77, 300.0, 0, 1 ); // Создаём текст
	Attach3DTextLabelToVehicle( vehicletext, yourvehicleid, 0.0, 0.0, 2.0 );
	return true;
}
cmd:drugs(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 3.0, 323.0342, 1118.5804, 1083.8828))
    {
        if(GetPVarInt(playerid, "NYAS"))
		{
			if(BizEnter[playerid] == -1) return ErrorMessage(playerid, "Перезайдите в бизнес!");
			if(BizInfo[BizEnter[playerid]][bKrisha] != PI[playerid][pMember]) return ErrorMessage(playerid, "Притон не пренадлежит вашей мафии!");
			PritonNarko += 100;
			RemovePlayerAttachedObject(playerid, 0);
			ApplyAnimation(playerid, "CARRY", "putdwn", 1.0, 0, 1, 1, 0, 0, 1);
			DeletePVar(playerid, "NYAS");
			SendClientMessage(playerid, COLOR_SERVER, "Вы принесли на склад притона 100 г. наркотических веществ.");
			string = "";
			mysql_format(1, string, 200, "UPDATE `mafiabalance` SET  `priton` = '%d' LIMIT 1", PritonNarko);
			mysql_tquery(1, string);
		}
		else
		{
            if(BizEnter[playerid] == -1) return ErrorMessage(playerid, "Перезайдите в бизнес!");
			if(!IsAGang(playerid) && !ISAMAFIA(playerid)) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не бандит!");
			if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/drugs [количество]");
			if(GetPlayerMoney(playerid) < 35 * params[0]) return ErrorMessage(playerid, "У Вас нет столько денег!");
			if(params[0] > 500 || params[0] < 1) return ErrorMessage(playerid, "Нельзя меньше 1 или больше 500!");
			if(PritonNarko < params[0]) return ErrorMessage(playerid, "В наркопритоне не хватает наркотиков");
			PritonNarko -= params[0];
			Hook_GivePlayerMoney(playerid, -35 * params[0]);
			PI[playerid][pDrugs] += params[0];
			UpdatePlayerData(playerid, "pDrugs", PI[playerid][pDrugs]);
			SCMF(playerid, -1, "Вы купили %d грамм наркотиков за %d вирт", params[0], params[0] * 35);
			if(PritonNarko < 50)
			{
				format(string, 144, "{FFC100}Внимание! "WHITE"В притоне заканчиваются наркотики.");
				SendFractionMessage(BizInfo[BizEnter[playerid]][bKrisha], COLOR_SERVER, string);
			}
			if(BizInfo[BizEnter[playerid]][bKrisha] == 5) frac_money[5] += 35*params[0];
			else if(BizInfo[BizEnter[playerid]][bKrisha] == 6) frac_money[6] += 35*params[0];
			else if(BizInfo[BizEnter[playerid]][bKrisha] == 14) frac_money[14] += 35*params[0];
			mysql_format(1, string, sizeof(string), "UPDATE `mafiabalance` SET  `priton` = '%d' LIMIT 1", PritonNarko);
			mysql_tquery(1, string);
			return 1;
		}
    }
    else ErrorMessage(playerid, "Вы должны находиться в притоне");
    return 1;
}
forward IdleKick();
public IdleKick()
{
	foreach(new i: Player)
	{
		if(PI[i][pLogin] == true)
		{
			if(PI[i][pLomka] >= 3000 && PI[i][pNarcoLomka] == 0 && PI[i][pNarcoLomka] != 2)
			{
				SendClientMessage(i, COLOR_RED, "(( У вашего персонажа началась ломка. Принять наркотик - /usedrugs ))");
				PI[i][pNarcoLomka] = 1;
			}
		}
	}
	return true;
}
