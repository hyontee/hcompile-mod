		SetPlayerWantedLevel(params[0], 0);
		UpdatePlayerData(params[0], "pWanted", PI[params[0]][pWanted]);
	}*/
	/*else if(PI[playerid][pMember] == 21 &&  PI[playerid][pRank] >= 2)
	{
		if(GetPlayerVehicleID(VehicleEnters[playerid]) >= lvpdcar[0] && GetPlayerVehicleID(VehicleEnters[playerid]) <= lvpdcar[1]) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не в полицейской машине");
		format(string, 64, "Вы сняли уровни розыска у %s.", PI[params[0]][pNames]);
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		format(string, 64, "* Офицер %s зашёл в базу данных", PI[playerid][pNames]);
		ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
