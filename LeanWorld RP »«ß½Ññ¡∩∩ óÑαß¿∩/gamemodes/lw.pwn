		mysql_tquery(1, string, "OffAdmin", "ds", playerid, params[0]);
	}
	return 1;
}
cmd:unwarn(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 10))
		return true;
	if(gAdminReason[playerid][ADMIN_UNWARN]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "ds[64]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/unwarn [id] [причина]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(PI[params[0]][pWarns] <= 0) return ErrorMessage(playerid, "Варнов нет");
	PI[params[0]][pWarns] = 0;
	PI[params[0]][punWarnstime] = 0;
	string = "";
	mysql_format(1, string, 250, "UPDATE `accounts` SET `pWarns` = '0', `punWarnstime` = '0' WHERE `id` = '%i'", PI[params[0]][pID]);
	mysql_tquery(1, string);
	format(string, SMALL_SIZE, "Предупреждения с %s сняты, причина: %s", PI[params[0]][pNames], params[1]);
	SendClientMessage(playerid, COLOR_RED, string);
	format(string, MAX_STR+32, "Администратор %s снял warn %s. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
	SendAdminMessage(COLOR_LIGHTRED, string);
	SCMF(params[0], COLOR_GREEN, "С Вас снято предупреждение. Причина: %s", params[1]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /unwarn на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
alias:sp("spawn");
cmd:sp(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 2))
		return true;
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/spawn [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(PI[params[0]][pAdmin] > 2 && (params[0] != playerid)) return true;
	SpawnPlayer(params[0]);

	new str[29 + MAX_PLAYER_NAME + MAX_PLAYER_NAME + 1];
	format(str, sizeof str, "[A] Администратор %s заспавнил %s", PI[playerid][pNames], PI[params[0]][pNames]);
	SendAdminMessage(0xAFAFAFFF, str);

	format(string, sizeof string, "Администратор %s заспавнил Вас", PI[playerid][pNames]);
	SendClientMessage(params[0], COLOR_WHITE, string);
	
	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /spawn на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);
	return 1;
}
cmd:freeze(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 4))
		return true;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/freeze [id]");
	if(PI[params[0]][pAdmin] > 0) return SendClientMessage(playerid, COLOR_GRAD2, "Администратор не может быть заморожен!");
	if(!IsPlayerConnected(params[0])) return 1;
	TogglePlayerControllable(params[0], (GetPVarInt(params[0], "AC_TogglePlayer") ? true : false));
	SetPVarInt(params[0], "AC_TogglePlayer", (GetPVarInt(params[0], "AC_TogglePlayer") ? false : true));
	string = "";
	if(GetPVarInt(params[0], "AC_TogglePlayer")) format(string, MAX_STR, "%s был заморожен администратором %s", PI[params[0]][pNames], PI[playerid][pNames]);
	else format(string, MAX_STR, "%s был разморожен администратором %s", PI[params[0]][pNames], PI[playerid][pNames]);
	SendAdminMessage(COLOR_LIGHTRED, string);
	return 1;
}
cmd:unbanip(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 8))
		return true;
	if(gAdminReason[playerid][ADMIN_UNBANIP]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "s[30]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, " Введите: /unbanip [IP адрес]");
	format(string, 64, "unbanip %s", params[0]);
	SendRconCommand(string);
	SendRconCommand("reloadbans");
	format(string, 100, "Администратор %s разблокировал IP адрес: %s", PI[playerid][pNames], params[0]);
	SendAdminMessage(COLOR_GREY, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /unbanip на %s", PI[playerid][pNames], params[0]);
	logs(1, log_str, 0);

	return 1;
}
cmd:banip(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 13))
		return true;
	if(gAdminReason[playerid][ADMIN_UNBANIP]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "s[30]", params[0]) || strfind(params[0], "*", true) != -1) return SendEsp(playerid, "/abanip [IP]");
	if(!strcmp(params[0], "46.174.53.176", false)) return SendClientMessage(playerid, COLOR_WHITE, "Данный IP адрес нельзя забанить.");
	foreach(Player, i) if(PI[i][pAdmin] > 0 && !strcmp(params[0], PI[i][pIP])) return SendClientMessage(playerid, COLOR_WHITE, "Данный IP адрес нельзя забанить.");
	format(string, MAX_STR, "Администратор %s заблокировал IP адрес: %s", PI[playerid][pNames], params[0]);
	SendAdminMessage(COLOR_GREY, string);
	format(string, SMALL_SIZE, "banip %s", params[0]);
	SendRconCommand(string);
	SendRconCommand("reloadbans");

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /banip на %s", PI[playerid][pNames], params[0]);
	logs(1, log_str, 0);

	return 1;
}
cmd:alock(playerid)
{
	if(!GetAccessAdmin(playerid, 2)) return true;
	for(new i = 1, j = GetVehiclePoolSize(); i <= j; i++)
	{
	    if(PlayerToPoint(4.0, playerid, VehInfo[i-1][vehicleX], VehInfo[i-1][vehicleY], VehInfo[i-1][vehicleZ]))
	    {
	        new model = GetVehicleModel(i);
	        if(!model) break;
			ToggleLockNotPlayer(i, !VehInfo[i-1][vLock]);
	        format(string, 128, ""#information"Автомобиль: <%s> [%i] - %s", VehicleNames[model-400], i, (!VehInfo[i-1][vLock]) ? ("{"#cGREEN"}открыта"WHITE"") : ("{"#cRED"}закрыта"WHITE""));
			SendClientMessage(playerid, -1, string);
			break;
		}
	}
	return 1;
}
cmd:takerub(playerid, params[])
{
	if(PI[playerid][pPayDayHad] < 10)
	{
	    SCM(playerid, -1, "Привет! Тебе нужно отыграть 10 часов, чтобы получить подарок!");
	    return SCM(playerid, -1, "Отыграй 10 часов и пиши команду снова, кстати подарок очень клевый!");
	}
	if(PI[playerid][pBonus] > 0) return ErrorMessage(playerid, "Вы уже получили 15 рублей на ваш аккаунт!");
	PI[playerid][pRubInfo] += 15;
	PI[playerid][pBonus] = 1, SCM(playerid, -1, ""#good"Вы получили 15 рублей на ваш аккаунт!");
	mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pBonus` = '1', `pRub` = '%i' WHERE `Name` = '%e'", PI[playerid][pRubInfo], PI[playerid][pNames]);
	mysql_tquery(1, string);
	return 1;
}
cmd:boostinfo(playerid, params[])
{
	SendClientMessage(playerid, -1, "Быстрая прокачка на LeanWorld RP:");
	SCMF(playerid, -1, ""#good"PayDay в двойном объеме: %s.", !PayDayBonus[0] ? ("{"#cRED"}выключен") : ("{"#cGREEN"}включен"));
	SCMF(playerid, -1, ""#good"Бонусный донат во время PayDay: %s.", !PayDayBonus[0] ? ("{"#cRED"}выключен") : ("{"#cGREEN"}включен"));
	return 1;
}
cmd:dmzone(playerid, params[])
{
	if(PI[playerid][pWanted] > 0) return SendClientMessage(playerid, -1, "Вы находитесь в розыске, разрешается игрокам без розыска");
	if(PI[playerid][pPrisonTime] > 0) return SendClientMessage(playerid, -1, "Вы находитесь в ДеМоргане!");
	if(PI[playerid][pJailTime] > 0) return SendClientMessage(playerid, -1, "Вы находитесь в Тюрьме!");
	if(GetPVarInt(playerid, "PlayerCuffed") == 2) return SendClientMessage(playerid, COLOR_WHITE, "Вы в наручниках");
	if(IsAGang(playerid) && CaptureInfo)
	{
		new isCaptParticipant = 0;
		for(new i= 0; i < sizeof(GZInfo); i++)
		{
			if(GZInfo[i][ZoneOnBattle] == 1)
			{
				if(PI[playerid][pMember] == GZInfo[i][gNapad] || PI[playerid][pMember] == GZInfo[i][gFrakVlad])
				{
					isCaptParticipant = 1;
					break;
				}
			}
		}
		if (isCaptParticipant) return SendClientMessage(playerid, -1, "Во время капта запрещено находиться в DM-Зоне!");
	}
	if(PI[playerid][pDMZ] > 0) return SendClientMessage(playerid, -1, "Вы уже находитесь в DM-Зоне, для того чтобы её покинуть, введите /dmexit");
	new DMPlayersCount[3] = 0;
	foreach(Player, i)
	{
		if(PI[i][pDMZ] > 0) DMPlayersCount[PI[i][pDMZ] - 1]++;
	}
	string = ""WHITE"Локация\t"WHITE"Игроков\n";
	format(string, sizeof(string), "%s\
	"WHITE"№1\t[%d/"WARNING"50"WHITE"]\n\
	"WHITE"№2\t[%d/"WARNING"50"WHITE"]\n\
	"WHITE"№3\t[%d/"WARNING"50"WHITE"]", string, DMPlayersCount[0], DMPlayersCount[1], DMPlayersCount[2]);
	ShowPlayerDialog(playerid, 9333, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"DeathMatch "WHITE"выбор локации", string, "Ок", "Выйти");
	return 1;
}
cmd:admeject(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 2))
		return true;
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/admeject [id]");
	if(PI[params[0]][pDMZ] < 1) return SendClientMessage(playerid, -1, "Данный игрок не находится в DM-зоне!");
	ExitDMZone(params[0]);
	SendClientMessage(params[0], COLOR_WHITE, "Вы были выкинуты из DM-зоны администратором "NAME_PROECT".");
	string = "";
	format(string, MAX_STR, "Администратор %s(%d) выкинул из DM-зоны: %s(%d)", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0]);
	SendAdminMessage(COLOR_GREY, string);
	return 1;
}

cmd:kickpb(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;
	if(sscanf(params, "ds[120]", params[0], params[1])) return ErrorMessage(playerid, "/kickpb [id] [Причина]");
	if(GetPVarInt(params[0], "PI_MP") != MP_DeathMatch || !PI_MP_START{params[0]}) return SendClientMessage(params[0], -1, "Данный игрок не находится в CS");

	ResetPlayerWeapons(params[0]);
	for(new i; i < 13; i++) TextDrawHideForPlayer(params[0], CounterSText[i]);
	DeletePVar(params[0], "PI_MP");
    SendClientMessage(params[0], 0xFFFFFFFF, string);
	PI_MP_START{params[0]} = false;
	SetPlayerPos(params[0], GetPVarFloat(params[0], "Pos_X_MP"), GetPVarFloat(params[0], "Pos_Y_MP"), GetPVarFloat(params[0], "Pos_Z_MP"));
	SetPlayerFacingAngle(params[0], GetPVarFloat(params[0], "Pos_A_MP"));
	SetPlayerVirtualWorld(params[0], GetPVarInt(params[0], "Pos_VW_MP"));
	SetPlayerInterior(params[0], GetPVarInt(params[0], "Pos_INT_MP"));
	DeletePVar(params[0], "Pos_X_MP");
	DeletePVar(params[0], "Pos_Y_MP");
	DeletePVar(params[0], "Pos_Z_MP");
	DeletePVar(params[0], "Pos_A_MP");
	DeletePVar(params[0], "Pos_VW_MP");
	DeletePVar(params[0], "Pos_INT_MP");
	DeletePVar(params[0], "PI_MP_Staus");
	if(PI[params[0]][pMember]) SetPlayerSkinEx(params[0], PI[params[0]][pModel]);
	else SetPlayerSkinEx(params[0], PI[params[0]][pChar]);
	SetPlayerColor(params[0], FI[PI[playerid][pMember]][fColor]);

	SendMes(params[0], COLOR_RED, "Вы были исключены из CS Администратором %s, причина: %s", PI[playerid][pNames], params[1]);
	string = "";
	format(string, MAX_STR, "[A] %s[%d] выкинул из CS: %s[%d], причина: %s", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0], params[1]);
	SendAdminMessage(COLOR_GREY, string);
	return 1;
}

cmd:dmexit(playerid)
{
	if(PI[playerid][pDMZ] < 1) return SendClientMessage(playerid, -1, "Вы не находитесь в DM-Зоне, для того чтобы туда попасть используйте команду /dmzone");
	ExitDMZone(playerid);
	return 1;
}
CMD:top(playerid)
{
	ShowPlayerDialog(playerid, 1115, DIALOG_STYLE_LIST,""SERVER"Топ игроки сервера","\
	"SERVER"1. "WHITE"Топ 30 игроков на дмзоне\n\
	"SERVER"2. "WHITE"Топ 10 самых активных игроков\n\
	"SERVER"3. "WHITE"Топ 10 самых богатых игроков\n\
	"SERVER"4. "WHITE"Топ 5 Администраторов" ,"Далее", "Отмена");
	return 1;
}
publics: KillDMZ(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Ничего не найдено");
	new nick[24];
	string = ""WHITE"Место\t"WHITE"Имя\t"WHITE"Убийства\n";
	for(new i; i < rows; i++)
	{
    	cache_get_field_content(i, "Name", nick, 1, 30);
    	format(string, sizeof(string), "%s"WHITE"%i\t"SERVER"%s\t"WHITE"%i\n", string, i+1, nick, cache_get_field_content_int(i, "pKillDMZ"));
	}
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_TABLIST_HEADERS, ""WHITE"Топ 30 игроков "SERVER"DeathMatch", string, "Принять", "");
	return 1;
}
publics: TopMoney(playerid)
{
	new rows, fields, name[MAX_PLAYER_NAME],moneys, string_money[700];
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Ничего не найдено");
	string_money = ""WHITE"Место\t"WHITE"Имя\t"WHITE"Деньги\n";
	for(new i; i < rows; i++)
	{
		cache_get_field_content(i, "Name", name);
		moneys = cache_get_field_content_int(i, "pCash");

		format(string_money, sizeof(string_money), "%s"WHITE"%d\t"SERVER"%s\t"WHITE"%d$\n", string_money, i + 1, name,moneys);
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"Топ 10 самых богатых игроков:", string_money, "Принять", "");
	return true;
}

publics: TopPaydayHad(playerid)
{
	new rows, fields, paydays, name[MAX_PLAYER_NAME], string_payday[700];
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Ничего не найдено");
	string_payday = ""WHITE"Место\t"WHITE"Имя\t"WHITE"Часов\n";
	for(new i; i < rows; i++)
	{
		cache_get_field_content(i, "Name", name);
		paydays = cache_get_field_content_int(i, "pPayDayHad");
		format(string_payday, sizeof(string_payday), "%s"WHITE"%d\t"SERVER"%s\t"WHITE"%d\n", string_payday, i + 1, name, paydays);
	}
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"Топ 10 самых активных игроков:", string_payday, "Принять", "");
	return true;
}
@AllAdmins(playerid);
@AllAdmins(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Ничего не найдено");
	new aname[MAX_PLAYER_NAME], alevel, alastcon[20], adata[20], admstr[4000];
	strcat(admstr, ""WHITE"Ник нейм\t"WHITE"Уровень админа\t"WHITE"Последний вход\t"WHITE"Поставлен\n");
	for(new i; i < rows; i++)
	{
	    cache_get_field_content(i, "Name", aname, 1, MAX_PLAYER_NAME);
		alevel = cache_get_field_content_int(i, "pAdmin");
		cache_get_field_content(i, "LastCon", alastcon, 1, 20);
		cache_get_field_content(i, "Data", adata, 1, 20);
		format(admstr, sizeof(admstr), "%s"WHITE"%s\t%d\t"SERVER"%s\t{FF0000}%s\n", admstr, aname, alevel, alastcon, adata);
	}
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"Список всех администраторов", admstr, "Закрыть", "");
	return 1;
}
publics: DisplayAdminTop(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Ничего не найдено");
	new nick[24];
	string = ""WHITE"Место\t"WHITE"Имя\t"WHITE"Отыгранное время\n";
	for(new i; i < rows; i++)
	{
    	cache_get_field_content(i, "Name", nick, 1, 30);
    	format(string, sizeof(string), "%s"WHITE"%i\t"SERVER"%s\t"WHITE"%i мин. (%i час.)\n", string, i+1, nick, cache_get_field_content_int(i, "online_sum")/60, cache_get_field_content_int(i, "online_sum")/3600);
	}
	ShowPlayerDialog(playerid, 4366, DIALOG_STYLE_TABLIST_HEADERS, ""WHITE"Топ 5 "SERVER"администраторов", string, "Принять", "");
	return 1;
}
