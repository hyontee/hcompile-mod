@PromoCodeCheck2(playerid, code[]);
@PromoCodeCheck2(playerid, code[])
{
	new stringer1[1000];
	new mysql_query_[300];
    new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
    {
        SendClientMessage(playerid, COLOR_GREY, "[Ошибка] Вы уже указывали данный промокод");
		DeletePVar(playerid, "code_money_");
		DeletePVar(playerid, "code_adminka_");
		DeletePVar(playerid, "code_rub_");
		DeletePVar(playerid, "code_helperka_");
		DeletePVar(playerid, "code_players_");
		DeletePVar(playerid, "code_data_");
		DeletePVar(playerid, "used_count_");
        return 1;
    }
	mysql_query_[0] = EOS;
	format(mysql_query_, sizeof(mysql_query_), "INSERT INTO promocode_used (idacca, code) VALUE (%d, '%s')", PI[playerid][pID], code);
	mysql_tquery(1, mysql_query_);
	new code_money, code_players, code_data, used_count, code_helperka, code_adminka, code_rub;
	code_money = GetPVarInt(playerid, "code_money_");
	code_helperka = GetPVarInt(playerid, "code_helperka_");
	code_adminka = GetPVarInt(playerid, "code_adminka_");
	code_players = GetPVarInt(playerid, "code_players_");
	code_data = GetPVarInt(playerid, "code_data_");
	code_rub = GetPVarInt(playerid, "code_rub_");
	used_count = GetPVarInt(playerid, "used_count_");
	//
	if(code_money > 0)
	{
	    Hook_GivePlayerMoney(playerid, code_money);
	    UpdatePlayerData(playerid, "pCash", PI[playerid][pCash]);
		format(stringer1, sizeof(stringer1), "Промокод {FFFF00}%s{FFFFFF} успешно использован. Вам зачислено: {63BD4E}%i долларов", code, code_money);
		SendClientMessage(playerid, COLOR_WHITE, stringer1);
		format(stringer1, sizeof(stringer1), "[PROMO] Игрок %s использовал промокод %s на %i долларов", PI[playerid][pNames], code, code_money);
		SendFDMessage(COLOR_SERVER, stringer1);
 	}
 	if(code_helperka > 0)
 	{
		format(stringer1, sizeof(stringer1), "Промокод {FFFF00}%s{FFFFFF} успешно использован. Вы получили: {63BD4E}%i дней Brilliant VIP", code, code_helperka);
		SendClientMessage(playerid, COLOR_WHITE, stringer1);
		SetPremium(playerid, code_helperka);
		format(stringer1, sizeof(stringer1), "[PROMO] Игрок %s использовал промокод %s на %i дней Brilliant VIP", PI[playerid][pNames], code, code_helperka);
		SendFDMessage(COLOR_SERVER, stringer1);
	}
	if(code_adminka > 0)
 	{
		format(stringer1, sizeof(stringer1), "Промокод {FFFF00}%s{FFFFFF} успешно использован. Вы получили: {63BD4E}%i уровень админки", code, code_adminka);
		SendClientMessage(playerid, COLOR_WHITE, stringer1);
		SendClientMessage(playerid, COLOR_BLUE, "Введите команду /alogin и придумайте пароль для админки.");
		PI[playerid][pAdmin] = code_adminka;
		new years, months, days, data[32]; getdate(years, months, days);
		format(data, 32, "%02d.%02d.%04d", days, months, years);
		mysql_format(1, string, 246, "INSERT INTO `admin` (`Name`, `pAdmin`, `LastCon`, `Postavil`, `Data`) VALUES ('%e', %d, '%e', 'Promo', '%e')", PI[playerid][pNames], code_adminka, data, data);
		mysql_tquery(1, string);
		UpdatePlayerData(playerid, "pAdmin", PI[playerid][pAdmin]);
		format(stringer1, sizeof(stringer1), "[PROMO] Игрок %s использовал промокод %s на %i ур. админки", PI[playerid][pNames], code, code_adminka);
		SendFDMessage(COLOR_SERVER, stringer1);
	}
	if(code_rub > 0)
	{
		format(stringer1, sizeof(stringer1), "Промокод {FFFF00}%s{FFFFFF} успешно использован. Вы получили: {63BD4E}%i рублей", code, code_rub);
		SendClientMessage(playerid, COLOR_WHITE, stringer1);
		PI[playerid][pRubInfo] += code_rub;
		UpdatePlayerData(playerid, "pRub", PI[playerid][pRubInfo]);
		format(stringer1, sizeof(stringer1), "[PROMO] Игрок %s использовал промокод %s на %i рублей", PI[playerid][pNames], code, code_rub);
		SendFDMessage(COLOR_SERVER, stringer1);
	}
	PI[playerid][pUsedPromo] += 1;
	UpdatePlayerData(playerid, "pUsedPromo", PI[playerid][pUsedPromo]);
	code_players --;
	used_count ++;
	mysql_query_[0] = EOS;
	format(mysql_query_, sizeof(mysql_query_), "UPDATE promocode SET players = %d, used_count = %d WHERE code = '%s'", code_players, used_count, code);
    mysql_tquery(1, mysql_query_);
    if(code_players == 0)
    {
    	mysql_query_[0] = EOS;
        format(mysql_query_, sizeof(mysql_query_), "DELETE FROM promocode WHERE code = '%s'", code);
        mysql_tquery(1, mysql_query_);
    }
    if(gettime() >= code_data && code_players == 0)
    {
        mysql_query_[0] = EOS;
		format(mysql_query_, sizeof(mysql_query_), "DELETE FROM promocode WHERE code = '%s'", code);
        mysql_tquery(1, mysql_query_);
    }
    DeletePVar(playerid, "code_money_");
    DeletePVar(playerid, "code_adminka_");
    DeletePVar(playerid, "code_rub_");
    DeletePVar(playerid, "code_helperka_");
	DeletePVar(playerid, "code_players_");
	DeletePVar(playerid, "code_data_");
	DeletePVar(playerid, "used_count_");
    return 1;
}
stock IsADomen(const text[])
{
	for(new i; i < sizeof(Domains); i ++)
	{
		new find = strfind(text, Domains[i], true);
		if(find != -1) if(IsASymbol(text, find - 2, find)) {
			printf("[DEBUG] Сработал антислив на тексте: %s", text);
			return true;
		}
	}
	return false;
}
stock IsASymbol(const text[], first, end)
{
	if(first < 0) first = 0;
	if(end >= strlen(text)) end = strlen(text) - 1;
	for(new i = first; i <= end; i ++) return true;
	return false;
}
