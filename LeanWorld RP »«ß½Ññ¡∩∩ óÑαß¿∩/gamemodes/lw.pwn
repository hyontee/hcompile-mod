cmd:smoke(playerid, params[])
{
	if(PI[playerid][pSiga] < 1 || PI[playerid][pSpal] < 1) return ErrorMessage(playerid, "У Вас нет зажигалки или сигарет. Купить их можно в 24/7");
	new marka[15];
	string = "";
	PI[playerid][pSiga]--, PI[playerid][pSpal]--;
	SetPVarInt(playerid, "SMOKE", unix+75);
	SetPlayerAttachedObject(playerid, 3, 19625, 6, 0.103999, 0.022999, 0.018999, -37.600025, 24.899974, 55.599994, 1.000000, 1.000000, 1.000000);
	SendClientMessage(playerid, COLOR_SERVER, "Чтобы сделать затяжку, нажмите {FF8282}ALT");
	switch(PI[playerid][pSgf])
	{
	case 1: marka = "Parlament";
	case 2: marka = "Kent";
	case 3: marka = "Winston";
	case 4: marka = "Lucky Strike";
	case 5: marka = "Marlboro";
	}
	format(string, 100, "* %s закурил(а) сигарету марки %s", PI[playerid][pNames], marka);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 30.0, 10000);
	return 1;
}
cmd:smokes(playerid, params[])
{
	new marka[15];
	string = "";
	switch(PI[playerid][pSgf])
	{
	case 1: marka = "Parlament";
	case 2: marka = "Kent";
	case 3: marka = "Winston";
	case 4: marka = "Lucky Strike";
	case 5: marka = "Marlboro";
	default: return ErrorMessage(playerid, "У Вас нет сигарет");
	}
	format(string, sizeof(string), ""WHITE"У Вас осталось: "SERVER"%i "WHITE"сигарет\nМарка: "SERVER"%s\n"WHITE"Зажигалка: на "SERVER"%i "WHITE"раз.", PI[playerid][pSiga], marka, PI[playerid][pSpal]);
	ShowPlayerDialog(playerid, 0000, 0, ""SERVER"Пачка сигарет", string, "Закрыть", "");
	format(string, sizeof(string), "* %s заглянул(а) в пачку сигарет марки %s", PI[playerid][pNames], marka);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 30.0, 10000);
	return 1;
}
cmd:exitcs(playerid, params[])
{
	if(GetPVarInt(playerid, "PI_MP") == MP_DeathMatch && PI_MP_START{playerid})
	{
		for(new i; i < 13; i++) TextDrawHideForPlayer(playerid, CounterSText[i]);
		DeletePVar(playerid, "PI_MP");
		PI_MP_START{playerid} = false;
		SetPlayerPos(playerid, GetPVarFloat(playerid, "Pos_X_MP"), GetPVarFloat(playerid, "Pos_Y_MP"), GetPVarFloat(playerid, "Pos_Z_MP"));
		SetPlayerFacingAngle(playerid, GetPVarFloat(playerid, "Pos_A_MP"));
		SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "Pos_VW_MP"));
		SetPlayerInterior(playerid, GetPVarInt(playerid, "Pos_INT_MP"));
		DeletePVar(playerid, "Pos_X_MP");
		DeletePVar(playerid, "Pos_Y_MP");
		DeletePVar(playerid, "Pos_Z_MP");
		DeletePVar(playerid, "Pos_A_MP");
		DeletePVar(playerid, "Pos_VW_MP");
		DeletePVar(playerid, "Pos_INT_MP");
		DeletePVar(playerid, "PI_MP_Staus");
		ResetPlayerWeapons(playerid);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		SendClientMessage(playerid, -1, "Вы покинули МП 'Counter Strike'");
	}
	return 1;
}
cmd:exitrace(playerid) return RaceExit(playerid, 7), 1;
cmd:startrace(playerid)
{
	if(!GetAccessAdmin(playerid, 12))
		return true;
	if(RACE_TIME_TO_START[0]) RACE_TIME_TO_START[0] = 10, SendClientMessage(playerid, -1, "До старта гоночных мероприятий осталось 10 секунд");
	else
	{
		RACE_TIME_TO_START[0] = 300; SendClientMessage(playerid, -1, "Регистрация на гоночные мероприятия открыта");
	    new RANDOM = RandomEx(0x0, sizeof(RACE_VEHICLE_ID)-1);
	    RACE_TIME_TO_START[0] = 300;RACE_VEHICLE = RACE_VEHICLE_ID[RANDOM]; RACE_MAP = RandomEx(1, 3);

	    if(RACE_MAP == 1) RACE_MAP = 0;
	    else if(RACE_MAP == 2) RACE_MAP = 1;
	    else if(RACE_MAP == 3) RACE_MAP = 2;

	    MAX_RACE_PLAYER = (RACE_MAP == 0 || RACE_MAP == 1) ? (40) : (15);

		SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Через 5 минут пройдут "SERVER"гоночные мероприятия. "WHITE"(/gps > Основные места > Центр развлечений)");
	}
	return 1;
}
cmd:startpb(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 12))
		return true;
	if(DeathMatch_Time) DeathMatch_Time = 10, SendClientMessage(playerid, -1, "До старта КС осталось 10 секунд");
	else
	{
		DeathMatch_Time = 300; SendClientMessage(playerid, -1, "Регистрация на КС открыта");
		SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Через 5 минут пройдет соревнование по "SERVER"Counter Strike. "WHITE"(/gps > Основные места > Центр развлечений)");
	}
	return 1;
}
CheckMP(playerid)
{
	if(PI_MP_START{playerid}) return SendClientMessage(playerid, -1, "Использовать во время мероприятия запрещено.");
	if(DeathMatch_Time) format(string, 200, " (%s)\t"WHITE"Игроков [%s%i/%i"WHITE"]", TimeConverter(DeathMatch_Time), (DeathMatch_Player < MAX_DMPLAYER ? ("{32cd32}") : ("{cd3232}")), DeathMatch_Player, MAX_DMPLAYER);
	else format(string, 200, "\t - ");
	if(RACE_TIME_TO_START[0]) format(stringer, 200, " (%s)\t"WHITE"Игроков [%s%i/%i"WHITE"]", TimeConverter(RACE_TIME_TO_START[0]), (RACE_PLAYERS < MAX_RACE_PLAYER ? ("{32cd32}") : ("{cd3232}")), RACE_PLAYERS, MAX_RACE_PLAYER);
	else format(stringer, 200, "\t- ");
	format(string, 512, ""WHITE"Название\t"WHITE"Регистрация\t"WHITE"Информация\n\
	"WHITE"Counter Strike\t%s"WHITE"%s\n\
	"WHITE"Гоночные мероприятия\t%s"WHITE"%s",
	(DeathMatch_Time ? ("{32cd32}Открыта") : ("{cd3232}Закрыта")), string,
	(RACE_TIME_TO_START[0] ? ("{32cd32}Открыта") : ("{cd3232}Закрыта")), stringer);
	ShowPlayerDialog(playerid, 9954, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"Мероприятия", string, "Выбрать", "Отменить");
	return 1;
}
Start_Race_MP()
{
	if(RACE_TIME_TO_START[1]) RACE_TIME_TO_START[1]--;

	if(RACE_TIME_TO_START[1] == 1)
	{
	    SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений]"WHITE" Гоночные мероприятия начались.");
	    RACE_START = true, RACE_TIME_TO_FINISH = unix+600;
	    foreach(Player, i)
	    {
	        if(GetPVarInt(i, "PI_MP") != MP_Racing) continue;

         	GameTextForPlayer(i, "~p~START~n~~g~GO GO GO", 3000, 4);
	        TogglePlayerControllable(i, true);
       		SetPlayerRaceCheckpoint(i, 0, RaceCheckPoint[RACE_MAP][0][0], RaceCheckPoint[RACE_MAP][0][1], RaceCheckPoint[RACE_MAP][0][2], RaceCheckPoint[RACE_MAP][0+1][0], RaceCheckPoint[RACE_MAP][0+1][1], RaceCheckPoint[RACE_MAP][0+1][2], 10.0);
	    }
	    RACE_TIME_TO_START[1] = 0;
	    return 1;
	}

	new str_race[10];
	foreach(Player, i)
	{
		if(GetPVarInt(i, "PI_MP") != MP_Racing) continue;

		if(RACE_TIME_TO_START[1] <= 10)
		{
			format(str_race, 10, "~g~%i", RACE_TIME_TO_START[1]);
			GameTextForPlayer(i, str_race, 1000, 4);
		}

		if(RACE_TIME_TO_START[1] == 5)
		{
			new Float:Pos_X, Float:Pos_Y, Float:Pos_Z, Float:Pos_A, engine, lights, alarm, doors, bonnet, boot, objective;
			GetPlayerPos(i, Pos_X, Pos_Y, Pos_Z);
			GetPlayerFacingAngle(i, Pos_A);
			SetPVarFloat(i, "Pos_X_MP", Pos_X);
			SetPVarFloat(i, "Pos_Y_MP", Pos_Y);
			SetPVarFloat(i, "Pos_Z_MP", Pos_Z);
			SetPVarFloat(i, "Pos_A_MP", Pos_A);
			SetPVarInt(i, "Pos_VW_MP", GetPlayerVirtualWorld(i));
			SetPVarInt(i, "Pos_INT_MP", GetPlayerInterior(i));
			DisablePlayerRaceCheckpoint(i);
			TogglePlayerControllable(i, false);
			new POSITION = GetPVarInt(i, "RACE_POSITION");
			SetPlayerPos(i, RaceVehicleRespawn[RACE_MAP][POSITION][0], RaceVehicleRespawn[RACE_MAP][POSITION][1], RaceVehicleRespawn[RACE_MAP][POSITION][2]);
			SetPVarInt(i, "RACE_VEHICLE", _:Forveh_AddStaticVehicle(RACE_VEHICLE, RaceVehicleRespawn[RACE_MAP][POSITION][0], RaceVehicleRespawn[RACE_MAP][POSITION][1], RaceVehicleRespawn[RACE_MAP][POSITION][2], RaceVehicleRespawn[RACE_MAP][POSITION][3], 0, 0));
			LinkVehicleToInterior(GetPVarInt(i, "RACE_VEHICLE"), 0);
			SetVehicleVirtualWorld(GetPVarInt(i, "RACE_VEHICLE"), 1);
   			VehInfo[GetPVarInt(i, "RACE_VEHICLE")][vFuel] = 200.0;
			SetPlayerInterior(i, 0);
			SetPlayerVirtualWorld(i, 1);
			PutPlayerInVehicle(i, GetPVarInt(i, "RACE_VEHICLE"), 0);
			GetVehicleParamsEx(GetPVarInt(i, "RACE_VEHICLE"), engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(GetPVarInt(i, "RACE_VEHICLE"), true, true, alarm, doors, bonnet, boot, objective);
   			for(new a;a<sizeof(RTD_box);a++) TextDrawShowForPlayer(i, RTD_box[a]);
			PlayerTextDrawShow(i, RTD_MText);
			for(new a; a < sizeof(RTD_MName); a++) PlayerTextDrawShow(i, RTD_MName[a]);
			PlayerTextDrawShow(i, RTD_Time);
			PlayerTextDrawShow(i, RTD_CP);
			SetPVarInt(i, "UpdateRacing", _:SetTimerEx("UpdateRaceTD", 1000, true, "d", i));
		}
	}
	return 1;
}
Start_MP_DM()
{
	new bool:TvTCommand;
	if(DeathMatch_Player < MIN_DMPLAYER) return SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Мероприятие "SERVER"Counter Strike "WHITE"отменено из-за нехватки количества участников");
	else SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Мероприятие "SERVER"Counter Strike "WHITE"началось, продолжительность 10 минут.");
	foreach(Player, playerid)
	{
		if(GetPVarInt(playerid, "PI_MP") != MP_DeathMatch) continue;
		if(DeathMatch_Player < MIN_DMPLAYER)
		{
			SendClientMessage(playerid, COLOR_SERVER, "[CS] "WHITE"Недостаточное количество участников.");
			DeletePVar(playerid, "PI_MP");
			PI_MP_START{playerid} = false;
			return 1;
		}
		else
		{
			for(new i; i < 13; i++) TextDrawShowForPlayer(playerid, CounterSText[i]);
			new Float:Pos_X, Float:Pos_Y, Float:Pos_Z, Float:Pos_A;
			GetPlayerPos(playerid, Pos_X, Pos_Y, Pos_Z);
			GetPlayerFacingAngle(playerid, Pos_A);
			SetPVarFloat(playerid, "Pos_X_MP", Pos_X);
			SetPVarFloat(playerid, "Pos_Y_MP", Pos_Y);
			SetPVarFloat(playerid, "Pos_Z_MP", Pos_Z);
			SetPVarFloat(playerid, "Pos_A_MP", Pos_A);
			SetPVarInt(playerid, "Pos_VW_MP", GetPlayerVirtualWorld(playerid));
			SetPVarInt(playerid, "Pos_INT_MP", GetPlayerInterior(playerid));
			if(!TvTCommand) SetPVarInt(playerid, "PI_MP_Staus", 1), TvTCommand = true;
			else SetPVarInt(playerid, "PI_MP_Staus", 2), TvTCommand = false;
			ResetPlayerWeapons(playerid);
			SetPlayerArmourAC(playerid, 0);
			GiveStatus_MP(playerid, GetPVarInt(playerid, "PI_MP_Staus"));
			PI_MP_START{playerid} = true;
			SendClientMessage(playerid, COLOR_SERVER, "Чтобы покинуть КС раньше времени, введите команду /exitcs");
			SendClientMessage(playerid, COLOR_SERVER, "Внимание! Если Вы выйдите с МП до его окончания, Вы не получите приз!");
		}
	}
	DeathMatch_Time_Start = 600;
	DeathMatch_Player = 0;
	DeathMatch_Score[0] = 0;
	DeathMatch_Score[1] = 0;
	return 1;
}
GiveStatus_MP(playerid, status)
{
	switch(status)
	{
	case 2:
		{
			SetPlayerColor(playerid, 0xFF0000FF);
			if(PI[playerid][pSex] == 1) SetPlayerSkin(playerid, 241);
			else SetPlayerSkin(playerid, 215);
		}
	case 1:
		{
			SetPlayerColor(playerid, 0x0000FFFF);
			if(PI[playerid][pSex] == 1) SetPlayerSkin(playerid, 242);
			else SetPlayerSkin(playerid, 131);
		}
	}
	GivePlayerWeapon(playerid, 24, 500);
	GivePlayerWeapon(playerid, 31, 500);
	if(status != 3)
	{
		SetPlayerPos(playerid, DM_Position[status-1][0], DM_Position[status-1][1], DM_Position[status-1][2]);
		SetPlayerFacingAngle(playerid, DM_Position[status-1][3]);
		SetPlayerInterior(playerid, 1);
		SetPlayerVirtualWorld(playerid, 1);
	}
	return 1;
}
End_MP_DM()
{
	new win_command;
	if(DeathMatch_Score[0] > DeathMatch_Score[1]) win_command = 2, SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Мероприятие "SERVER"Counter Strike"WHITE" успешно завершено. Победила красная команда.");
	else win_command = 1, SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Мероприятие "SERVER"Counter Strike"WHITE" успешно завершено. Победила синяя команда.");
	new best_frag, best_id;
	foreach(Player, i)
	{
   		if(GetPVarInt(i, "killed_shot") > best_frag)
  		{
    		best_frag = GetPVarInt(i, "killed_shot");
      		best_id = i;
      		DeletePVar(i, "killed_shot");
    	}
	}
	if(best_frag > 0) format(string, sizeof(string), "Лучший игрок на мероприятии Counter Strike "SERVER"%s "WHITE"который уничтожил "SERVER"%d "WHITE"человек(а)", PI[best_id][pNames], best_frag);
	else if(!best_frag) format(string, sizeof(string), "Лучший игрок во время мероприятия Counter Strike не был определён.");
	foreach(Player, playerid)
	{
		if(GetPVarInt(playerid, "PI_MP") != MP_DeathMatch || !PI_MP_START{playerid}) continue;
		ResetPlayerWeapons(playerid);
		for(new i; i < 13; i++) TextDrawHideForPlayer(playerid, CounterSText[i]);
		if(GetPVarInt(playerid, "PI_MP_Staus") == win_command) Hook_GivePlayerMoney(playerid, 1000000), SendClientMessage(playerid, -1, "Поздравляем Вас с победой. Ваш приз выдан! [+1000000$]");
		DeletePVar(playerid, "PI_MP");
        SendClientMessage(playerid, 0xFFFFFFFF, string);
		PI_MP_START{playerid} = false;
		SetPlayerPos(playerid, GetPVarFloat(playerid, "Pos_X_MP"), GetPVarFloat(playerid, "Pos_Y_MP"), GetPVarFloat(playerid, "Pos_Z_MP"));
		SetPlayerFacingAngle(playerid, GetPVarFloat(playerid, "Pos_A_MP"));
		SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "Pos_VW_MP"));
		SetPlayerInterior(playerid, GetPVarInt(playerid, "Pos_INT_MP"));
		DeletePVar(playerid, "Pos_X_MP");
		DeletePVar(playerid, "Pos_Y_MP");
		DeletePVar(playerid, "Pos_Z_MP");
		DeletePVar(playerid, "Pos_A_MP");
		DeletePVar(playerid, "Pos_VW_MP");
		DeletePVar(playerid, "Pos_INT_MP");
		DeletePVar(playerid, "PI_MP_Staus");
		if(PI[playerid][pMember]) SetPlayerSkinEx(playerid, PI[playerid][pModel]);
		else SetPlayerSkinEx(playerid, PI[playerid][pChar]);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
	}
	TextDrawSetString(CounterSText[8], "C.TERRORIST: ~w~0");
	TextDrawSetString(CounterSText[9], "TERRORIST: ~w~0");
	TextDrawSetString(CounterSText[10], "_");
	DeathMatch_Player = 0;
	DeathMatch_Score[0] = 0;
	DeathMatch_Score[1] = 0;
	return 1;
}
cmd:posf(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "d", params[0])) return 1;
		if(params[0] > FILLING_TOTAL) return 1;
		new Float:p_Pos[3];
		GetPlayerPos(playerid, p_Pos[0], p_Pos[1], p_Pos[2]);
		Filling[params[0]][fPos][0] = p_Pos[0];
		Filling[params[0]][fPos][1] = p_Pos[1];
		Filling[params[0]][fPos][2] = p_Pos[2];
		string = "";
		mysql_format(1, string, 250, "UPDATE `filling` SET `fPos` = '%f', `fPos1` = '%f', `fPos2` = '%f' WHERE `fID` = '%d'", Filling[params[0]][fPos][0], Filling[params[0]][fPos][1], Filling[params[0]][fPos][2], params[0]);
		mysql_tquery(1, string);
	}
	return 1;
}
cmd:posfuel(playerid)
{
	if(D_FULL(PI[playerid][pNames]))
	{
		new fillingid = -1;
		for(new b = 1; b != FILLING_TOTAL+1; b++)
		{
			if(!PlayerToPoint(8.0, playerid, Filling[b][fPos][0], Filling[b][fPos][1], Filling[b][fPos][2])) continue;
			fillingid = b;
			break;
		}
		if(fillingid == -1) return 1;
		new Float:p_Pos[3];
		GetPlayerPos(playerid, p_Pos[0], p_Pos[1], p_Pos[2]);
		Filling[fillingid][sFuelPos][0] = p_Pos[0];
		Filling[fillingid][sFuelPos][1] = p_Pos[1];
		Filling[fillingid][sFuelPos][2] = p_Pos[2];
		string = "";
		mysql_format(1, string, 250, "UPDATE `filling` SET `sFuelPos` = '%f', `sFuelPos1` = '%f', `sFuelPos2` = '%f' WHERE `fID` = '%d'", Filling[fillingid][sFuelPos][0], Filling[fillingid][sFuelPos][1], Filling[fillingid][sFuelPos][2], fillingid);
		mysql_tquery(1, string);
	}
	return 1;
}
cmd:fill(playerid)
{
	if(GetPVarInt(playerid, #pFilling)) return 1;
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, CGRAY, "Вы должны быть в т/с");
	new vehicleid = VehicleEnters[playerid];
	if(GetEngineStat(vehicleid)) return ErrorMessage(playerid, "Заправляться можно только с заглушенными двигателем");
	if(VehInfo[vehicleid][vFuel] >= 200.0) return ErrorMessage(playerid, "Вашему автомобилю не требуется заправка.");
	new fillingid = -1;
	for(new b = 1; b != FILLING_TOTAL+1; b++)
	{
		if(!PlayerToPoint(10.0, playerid, Filling[b][fPos][0], Filling[b][fPos][1], Filling[b][fPos][2])) continue;
		if(Filling[b][fLock]) return ErrorMessage(playerid, "Заправка не работает.");
		fillingid = b;
	}
	if(fillingid == -1) return ErrorMessage(playerid, "Вы не на заправке!");
	format(string, 56, ""SERVER"Заправка №%i", fillingid);
	ShowPlayerDialog(playerid, 8312, DIALOG_STYLE_LIST, string, ""SERVER"1."WHITE" Заправить автомобиль\n"SERVER"2."WHITE" Приобрести канистру "SERVER"[3500$]\n"SERVER"3."WHITE" Приобрести ремкомплект "SERVER"[10000$]", "Далее", "Отмена");
	SetPVarInt(playerid, #FillingID, fillingid);
	return 1;
}
cmd:fillcar(playerid)
{
    if(PI[playerid][pFuelCar] < 1) return ErrorMessage(playerid, "У Вас нет канистры купите её на заправке!");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "Вы не в автомобиле!");
	if(VehInfo[VehicleEnters[playerid]][vFuel] >= 200.0) return ErrorMessage(playerid, "Ваш бак полон!");

	if(VehInfo[VehicleEnters[playerid]][vFuel]+15 >= 200)
	{
		RemovePlayerAttachedObject(playerid, 0);
		VehInfo[VehicleEnters[playerid]][vFuel] = 200;
		format(string, 100, "* %s заправил(а) свой автомобиль до 200 л.", PI[playerid][pNames]);
		ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
		PI[playerid][pFuelCar] --;
		UpdatePlayerData(playerid, "pFuelCar", PI[playerid][pFuelCar]);
		return 1;
	}
	RemovePlayerAttachedObject(playerid, 0);
	VehInfo[VehicleEnters[playerid]][vFuel] += 15;
	format(string, 100, "* %s заправил(а) свой автомобиль на 200 л.", PI[playerid][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	PI[playerid][pFuelCar] --;
	UpdatePlayerData(playerid, "pFuelCar", PI[playerid][pFuelCar]);
	return 1;
}
CMD:remcar(playerid, params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "Вы не в автомобиле!");
	if(PI[playerid][pRem] < 1) return ErrorMessage(playerid, "У вас нет ремкомплекта купите его на заправке!");

	new Float:vh;
    GetVehicleHealth(VehicleEnters[playerid], vh);
	if(vh >= 1000) return ErrorMessage(playerid, "Ваш автомобиль целый!");

	format(string, 70, "* %s починил(а) свой автомобиль", PI[playerid][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);

	RepairVehicle(VehicleEnters[playerid]);

    PI[playerid][pRem] --, UpdatePlayerData(playerid, "pRem", PI[playerid][pRem]);
	return true;
}
cmd:fillbike(playerid)
{
	if(!PlayerToPoint(5.0, playerid, 681.4821, -445.6447, 16.3359)) return ErrorMessage(playerid, "Вы не у байк. клуба!");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "Вы должны быть в т/с!");
	if(PlayerToPoint(5.0, playerid, 681.4821, -445.6447, 16.3359) && PI[playerid][pMember] != 23) return ErrorMessage(playerid, "Доступно только участникам клуба!");
	if(VehInfo[VehicleEnters[playerid]][vFuel] >= 200.0) return ErrorMessage(playerid, "Ваш бак полон!");
	new Float:fuelcar_go = 200.0 - VehInfo[VehicleEnters[playerid]][vFuel];
	if(frac_materials[28] < fuelcar_go) return ErrorMessage(playerid, "На складе нету бензина!");
	VehInfo[VehicleEnters[playerid]][vFuel] += fuelcar_go;
	frac_materials[28] -= floatround(fuelcar_go), UpdateText(1);
	UpdateFractionStore(28);
	foreach(Player, i) { if(PI[i][pMember] == 23) SCMF(i, COLOR_SERVER, ""SERVER"[Канистры]"WHITE" %s(%d) заправил свой транспорт на %0.2f литров, со склада слито: %.0f литров бензина", PI[playerid][pNames], playerid, fuelcar_go, fuelcar_go); }
	return 1;
}
cmd:sellbiz(playerid, params[])
{
	if(PI[playerid][pBusiness] == -1) return ErrorMessage(playerid, "У Вас нет бизнеса.");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, "/sellbiz [ID] [Цена]");
	if(params[0] == INVALID_PLAYER_ID || params[0] == playerid) return 1;
	if(PI[params[0]][pBusiness] != -1) return ErrorMessage(playerid, "У него есть бизнес");
	if(PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Администрации запрещено продавать бизнес.");
	if(!IsPlayerInRangeOfPoint( playerid, 10.0, BizInfo[PI[playerid][pBusiness]][EnterBiz][0], BizInfo[PI[playerid][pBusiness]][EnterBiz][1], BizInfo[PI[playerid][pBusiness]][EnterBiz][2] ) ) return ErrorMessage(playerid, "Надо находится около бизнеса.");
	if(params[1] < 0) return ErrorMessage(playerid, "Неверная цена.");
	if(PI[params[0]][pCash] < params[1]) return ErrorMessage(playerid, "У него нет столько денег");
	if(GetPVarInt(params[0], "sellerbiz") != 999) return ErrorMessage(playerid, "Ему уже кто-то предлагает бизнес.");
	if(!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Вы находитесь далеко друг от друга");
	string = "";
	format(string, 200, ""WHITE"Здравствуйте!\nМеня зовут %s и Я хочу продать Вам свой бизнес %s\nЦена: %d $\n\nЖду Вашего ответа!", PI[playerid][pNames], BizInfo[PI[playerid][pBusiness]][bName], params[1]);
	ShowPlayerDialog(params[0], 82, DIALOG_STYLE_MSGBOX, ""SERVER"Покупка бизнеса", string, "Купить", "Отказаться");
	SetPVarInt(params[0], "sellerbiz", playerid);
	SetPVarInt(params[0], "bizcost", params[1]);
	SCMF(playerid, COLOR_BLUE, "Вы предложили купить %s Ваш бизнес %s за %d", PI[params[0]][pNames], BizInfo[PI[playerid][pBusiness]][bName], params[1]);
	return 1;
}
cmd:buyfuel(playerid)
{
	if(PI[playerid][pAdmin]) return SendClientMessage(playerid, -1, "Администрации запрещено иметь заправки");
	if(PI[playerid][pBusiness] != -1 || PI[playerid][pFilling] != -1)  return ErrorMessage(playerid, "У вас уже есть бизнес!");
	for(new b = 1; b != FILLING_TOTAL+1; b++)
	{
		if(!PlayerToPoint(10.0, playerid, Filling[b][fPos][0], Filling[b][fPos][1], Filling[b][fPos][2]) || strcmp(Filling[b][fOwner], "None", true) != 0) continue;
		if(PI[playerid][pBank] < Filling[b][fPrice]) return ErrorMessage(playerid, "У вас недостаточно денег в банке.");
		PI[playerid][pFilling] = b;
		PI[playerid][pJob] = 0;
		UpdatePlayerData(playerid, "pJob", 0);
		UpdatePlayerData(playerid, "pPsbiskey", PI[playerid][pFilling]);
		PI[playerid][pBank] -= Filling[b][fPrice];
		UpdatePlayerData(playerid, "pBank", PI[playerid][pBank]);
		strmid(Filling[b][fOwner], PI[playerid][pNames], 0, strlen(PI[playerid][pNames]), 255);
		UpdateFuelInfoEx(playerid, "fOwner", Filling[b][fOwner]);
		Filling[b][fBankMoney] = 100;
		UpdateFuelInfo(playerid, "fBankMoney", 100);
		Filling[b][fLock] = false;
		UpdateFuelInfo(playerid, "fLock", false);
		Filling[b][fPriceBenz] = 100;
		UpdateFuelInfo(playerid, "fPriceBenz", 100);
		SCMF(playerid, -1, ""#good"Поздравляем, вы купили "SERVER"заправочную станцию №%i.", b);
		SendClientMessage(playerid, -1, ""#information"Для управления заправочной станцией используйте команду "SERVER"/fpanel");

		string = "";
		format(string, 320, "{"#cGREEN"}Заправочная станция №%i{FFFFFF}\n\nВладелец: {"#cGREEN"}[%s]{FFFFFF}\nСтатус: {"#cGREEN"}[%s{"#cGREEN"}]\n{FFFFFF}Стоимость: {"#cGREEN"}[%i$]{FFFFFF}\nБензина в цистерне: {"#cGREEN"}[%i/%i литра(-ов)]{FFFFFF}\nЦена за 1 литр: {"#cGREEN"}[%i$]{FFFFFF}",
	    	b, Filling[b][fOwner], (Filling[b][fLock] ? ("{FF0000}Закрыта") : ("Открыта")), Filling[b][fPrice], Filling[b][fBenz], Filling[b][fMaxBenz], Filling[b][fPriceBenz]);
        if(!strcmp(Filling[b][fOwner], "None", true)) format(string, 360, "%s\n\nДля покупки введите '/buyfuel'", string);
		Delete3DTextLabel(Filling[b][fText]);
		Filling[b][fText] = Create3DTextLabel(string, -1, Filling[b][fPos][0], Filling[b][fPos][1], Filling[b][fPos][2]+1.0, 20.0, 0, 1);
		return 1;
	}
	return 1;
}
cmd:fuelpos(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/fuelpos [biznumber]");
		new Float:PosX, Float:PosY, Float:PosZ;
		GetPlayerPos(playerid, PosX, PosY, PosZ);
		Filling[params[0]][fPos][0] = PosX;
		Filling[params[0]][fPos][1] = PosY;
		Filling[params[0]][fPos][2] = PosZ;
		string = "";
		mysql_format(1, string, 200, "UPDATE `filling` SET `fPos` = '%f', `fPos1` = '%f', `fPos2` = '%f' WHERE fID = %i", PosX, PosY, PosZ, params[0]);
		mysql_tquery(1, string);
		string = "";
		format(string, 320, "{"#cGREEN"}Заправочная станция №%i{FFFFFF}\n\nВладелец: {"#cGREEN"}[%s]{FFFFFF}\nСтатус: {"#cGREEN"}[%s{"#cGREEN"}]\n{FFFFFF}Стоимость: {"#cGREEN"}[%i$]{FFFFFF}\nБензина в цистерне: {"#cGREEN"}[%i/%i литра(-ов)]{FFFFFF}\nЦена за 1 литр: {"#cGREEN"}[%i$]{FFFFFF}",
	    	params[0], Filling[params[0]][fOwner], (Filling[params[0]][fLock] ? ("{FF0000}Закрыта") : ("Открыта")), Filling[params[0]][fPrice], Filling[params[0]][fBenz], Filling[params[0]][fMaxBenz], Filling[params[0]][fPriceBenz]);
        if(!strcmp(Filling[params[0]][fOwner], "None", true)) format(string, 360, "%s\n\nДля покупки введите '/buyfuel'", string);
		Delete3DTextLabel(Filling[params[0]][fText]);
		Filling[params[0]][fText] = Create3DTextLabel(string, -1, Filling[params[0]][fPos][0], Filling[params[0]][fPos][1], Filling[params[0]][fPos][2]+1.0, 20.0, 0, 1);
	}
	return 1;
}
cmd:switchskin(playerid)
{
	if(!IsAGang(playerid)) return 1;
	if(!GetPVarInt(playerid, "ArmySkin_Player")) return SendClientMessage(playerid, COLOR_GRAD1, "У вас нет формы армейца");
	SetPlayerSkin(playerid, 287);
	SetPlayerColor(playerid, COLOR_GREEN);
	DeletePVar(playerid, "ArmySkin_Player");
	SetPVarInt(playerid, "ArmySkin_Check", true);
	return 1;
}
cmd:showpass(playerid, params[])
{
	//if(!PI[playerid][pPassport]) return ErrorMessage(playerid, "У Вас нет паспорта!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/showpass [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_RED, "Человек слишком далеко!");
	if(GetPVarInt(params[0], "Spectate")) return SendClientMessage(playerid, COLOR_RED, "Человек слишком далеко!");
	new text[196], Member[196];
	if(PI[playerid][pHouse] != -1 || PI[playerid][pArendaHouse] != -1)
	{
		new Float:x, Float:y, h;
		if(PI[playerid][pHouse] != -1) h = PI[playerid][pHouse];
		else h = PI[playerid][pArendaHouse];
		if(h < MAX_HOUSE)
		{
			x = HouseInfo[h][hEnter][0];
			y = HouseInfo[h][hEnter][1];
			new ids = GetCityName ( x, y );
			new id = GetZonaName ( x, y );
			format(text, 155, ""WHITE"Город/Деревня: {"#cBLUE"}%s"WHITE"\nРайон: {"#cBLUE"}%s"WHITE"\nДом: {"#cBLUE"}%d"WHITE"", gSAZonesCity[ids][SAZONE_NAME], gSAZones[id][SAZONE_NAME], PI[playerid][pHouse]);
		}
	}
	else format(text, 115, ""WHITE"Город: {"#cBLUE"}Отсутствует"WHITE"\nРайон: {"#cBLUE"}Отсутствует"WHITE"\nДом: {"#cBLUE"}Отсутствует"WHITE"");
	if(PI[playerid][pMember] != 0) format(Member, sizeof(Member), ""WHITE"Место работы: {"#cBLUE"}%s"WHITE"\nДолжность: {"#cBLUE"}%s"WHITE"", GetMember[PI[playerid][pMember]-1], PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1]);
	else format(Member, 100, ""WHITE"Место работы: {"#cBLUE"}Отсутствует"WHITE"\nДолжность: {"#cBLUE"}Отсутствует"WHITE"");
	new nationaly = PI[playerid][pNationaly];
	string = "";
	new fio[2][24];
	split(PI[playerid][pNames], fio, '_');
	format(string, sizeof(string), ""WHITE"\tПАСПОРТНЫЕ ДАННЫЕ\nИмя: {"#cBLUE"}%s"WHITE"\nФамилия: {"#cBLUE"}%s"WHITE"\nЛет в штате: {"#cBLUE"}%d"WHITE"\nВозраст: {"#cBLUE"}%d лет"WHITE"\nНациональность: {"#cBLUE"}%s"WHITE"\nЗаконопослушность: {"#cBLUE"}%d"WHITE"\n\
	Уровень розыска: {"#cBLUE"}%d"WHITE"\n\n\tМЕСТО ЖИТЕЛЬСТВА\n%s\n\n\tТРУДОВОЕ УСТРОЙСТВО\n%s",
	fio[0], fio[1], PI[playerid][pLevel], PI[playerid][pAge], ((!nationaly) ? ("Неизвестно") : (nationaly == 1) ? ("Американец") : (nationaly == 2) ? ("Японец") : (nationaly == 3) ? ("Итальянец") : (nationaly == 4) ? ("Мексиканец") : (nationaly == 5) ? ("Латиноамериканец") : (nationaly == 6) ? ("Испанец") : (nationaly == 7) ? ("Русский") : (nationaly == 8) ? ("Португалец") : ("Француз")), PI[playerid][pZakonp], PI[playerid][pWanted], text, Member);
	ShowPlayerDialog(params[0], 000, DIALOG_STYLE_MSGBOX, "{"#cBLUE"}Паспорт", string, "Принять", "");
	format(string, MAX_STR, "%s показал(-а) свой паспорт %s'у", PI[playerid][pNames], PI[params[0]][pNames]);
	SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 30.0, 10000);
	format(string, SMALL_SIZE, "* %s показал(-a) свой паспорт", PI[playerid][pNames]);
	ProxDetector(10.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	return 1;
}
cmd:database(playerid, params[]) {
