	else print("-> LoadGangZone не загружен");
    cache_delete(cache);

 	cache = mysql_query(1, "SELECT * FROM `mebel`"), rows = cache_num_rows();
 	if(rows)
 	{
	 	new Float:pos[4], model, home, type, number;
		for(new he; he < rows; he++)
