Maintenance()
{
	SendRconCommand("hostname « "NAME_PROECT" » | Перезагрузка сервера");
	SetGameModeText("Reloading....");
	foreach(Player, i) KickEx(i);
	for(new i; i < sizeof(BannerInfo); i++)
	{
		if(BannerInfo[i][tStatus] && BannerInfo[i][tDay]) BannerInfo[i][tDay] --, mysql_format(1, string, 100, "UPDATE `banners` SET `tDay` = '%d' WHERE `tID` = '%d'", BannerInfo[i][tDay], i);
		else if(BannerInfo[i][tStatus] && BannerInfo[i][tDay] <= 0)
		{
			BannerInfo[i][tStatus] = false;
			BannerInfo[i][tDay] = 0;
			strmid(BannerInfo[i][tOwner], "None", 0, strlen("None"), 255);
			strmid(BannerInfo[i][tText], "-", 0, strlen("-"), 255);
			format(string, sizeof(string), ""WHITE"%s", BannerInfo[i][tText]);
			SetDynamicObjectMaterialText(addnews[i], 0, string, 90, "Impact", 24, 0, -32256, -16777216, 1);
			mysql_format(1, string, 170, "UPDATE `banners` SET `tStatus` = '0', `tDay` = '0', `tText` = '-', `tOwner` = 'None' WHERE `tID` = '%d'", i);
		}
		mysql_query(1, string, false);
	}
	for(new i = 0; i < TOTAL_HOUSE; i++) SaveHouse(i);
	for(new i = 0; i < sizeof(GZInfo); i++) SaveGZ(i);
	for(new i = 1; i <= BIZES; i ++) SaveBusiness(i);
	ServerRestart[2] = 30;
	return 1;
}
AddAdmin(targetid, cena, lvl)
{
	if(PI[targetid][pAdmin]) return SCM(targetid, -1, ""#net"Вы уже являетесь администратором!");
	if(cena < 0) return SendClientMessage(targetid, -1, "ошибка #541");
	if(PI[targetid][pRubInfo] < cena) return SCMF(targetid, -1, ""#net"Для приобретения админ-прав данного уровня Вам нужно %d рублей", cena);
	//PI[targetid][pAdmin] = lvl;

	PI[targetid][pRubInfo] -= cena;
	UpdatePlayerData(targetid, "pRub", PI[targetid][pRubInfo]);
	PI[targetid][pRubDonateTotal][0] += cena;
	UpdatePlayerData(targetid, "pRubDonateTotal", PI[targetid][pRubDonateTotal][0]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s купил админ права", PI[targetid][pNames]);
	logs(2, log_str, cena);

	string = "";
	mysql_format(1, string, 230, "INSERT INTO `admin` (`Name`, `pAdmin`, `password`, `LastCon`, `Postavil`, `Data`) VALUES ('%e', '%d', 'qwerty', '0', 'System', NOW())", PI[targetid][pNames], lvl);
	mysql_tquery(1, string);
	SCMF(targetid, -1, "Вы успешно приобрели админ-права %d-го уровня.", lvl);
	SendClientMessage(targetid, -1, ""#information"Введите команду /alogin и придумайте себе пароль. (Обязательно его запишите)");
	return 1;
}
AdminLevel(playerid)
{
	print("[DEBUG] AdminLevel used.");
	if(!PI[playerid][pAdmin])
		return true;
	if(PI[playerid][pAdmin] >= 13) return ErrorMessage(playerid, "У Вас максимальный уровень админ-прав");
	switch(PI[playerid][pAdmin])
	{
		case 1..8: SetPVarInt(playerid, "AdmCost", 50);
		case 9..10: SetPVarInt(playerid, "AdmCost", 150);
		case 11..12: SetPVarInt(playerid, "AdmCost", 100);
	}
	format(string, sizeof(string), ""#net"Для повышения админ-уровня Вам требуется %d рублей на балансе", GetPVarInt(playerid, "AdmCost"));
	if(PI[playerid][pRubInfo] < GetPVarInt(playerid, "AdmCost")) return SendClientMessage(playerid, -1, string);
	PI[playerid][pAdmin] ++;

	PI[playerid][pRubInfo] -= GetPVarInt(playerid, "AdmCost");
	UpdatePlayerData(playerid, "pRub", PI[playerid][pRubInfo]);
	PI[playerid][pRubDonateTotal][0] += GetPVarInt(playerid, "AdmCost");
	UpdatePlayerData(playerid, "pRubDonateTotal", PI[playerid][pRubDonateTotal][0]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s купил повышение админ прав", PI[playerid][pNames]);
	logs(2, log_str, GetPVarInt(playerid, "AdmCost"));

	UpdatePlayerData(playerid, "pAdmin", PI[playerid][pAdmin]);
	mysql_format(1, string, MAX_STR, "UPDATE `admin` SET `pAdmin` = '%d' WHERE `Name` = '%e'", PI[playerid][pAdmin], PI[playerid][pNames]);
	mysql_tquery(1, string);
	SCMF(playerid, COLOR_GREEN, "Вы успешно повысили свой админ-уровень до %d.", PI[playerid][pAdmin]);
	SendClientMessage(playerid, -1, ""#information"Введите команду /alogin по новой, что бы Ваш уровень обновился.");
	return 1;
}
IsNumeric(const string_massive[])
{
	for (new i = 0, j = strlen(string_massive); i < j; i++) if(string_massive[i] > '9' || string_massive[i] < '0') return 0;
	return 1;
}
MatsArmyGive(playerid)
{
	new frc = PI[playerid][pMember];
	if(frc == 3 || frc == 12 || frc == 13 || frc == 15 || frc == 17 || frc == 18 || frc == 19 || frc == 5 || frc == 6 || frc == 14 || frc == 20 || frc == 27)
	{
		new plmats = random(5) + 1;
		if(PI[playerid][pSum] && PI[playerid][pMats] >= 1000) return ErrorMessage(playerid, "Больше вам не унести"), GameTextForPlayer(playerid, "Full Inventory", 2000, 4);
		else if(PI[playerid][pMats] >= 500 && !PI[playerid][pSum]) return ErrorMessage(playerid, "Больше вам не унести"), GameTextForPlayer(playerid, "Full Inventory", 2000, 4);
		if(PlayerToPoint(4.0, playerid, 312.4241, -165.9406, 1000.3010))
		{
			if(frac_materials[19] < plmats) return ErrorMessage(playerid, "На складе не достаточно материалов");
			frac_materials[19] -= plmats;
		}
		else if(PlayerToPoint(4.0, playerid, -1636.9213, 608.1162, -51.8141) && GetPlayerInterior(playerid) == 1 && GetPlayerVirtualWorld(playerid) == 1)
		{
			if(frac_materials[3] < plmats) return ErrorMessage(playerid, "На складе не достаточно материалов");
			frac_materials[3] -= plmats;
		}
		else if(PlayerToPoint(4.0, playerid, -1636.9213, 608.1162, -51.8141) && GetPlayerInterior(playerid) == 1 && GetPlayerVirtualWorld(playerid) == 4)
		{
			if(frac_materials[20] < plmats) return ErrorMessage(playerid, "На складе не достаточно материалов");
			frac_materials[20] -= plmats;
		}
		else if(PlayerToPoint(4.0, playerid, -1636.9213, 608.1162, -51.8141) && GetPlayerInterior(playerid) == 1 && GetPlayerVirtualWorld(playerid) != 0)
		{
			if(frac_materials[27] < plmats) return ErrorMessage(playerid, "На складе не достаточно материалов");
			frac_materials[27] -= plmats;
		}
		PI[playerid][pMats] += plmats;

		format(string, 70, "~y~Materials: +%d~n~~b~Total: %d", plmats, PI[playerid][pMats]);
		GameTextForPlayer(playerid, string, 2000, 4);
		format(string, 70, "+%d шт материалов.", plmats);
		SetPlayerChatBubble(playerid, string, COLOR_SERVER, 15.0, 1500);
		PlayerPlaySound(playerid, 17803, 0, 0, 0);
		UpdateText(0);
		if(GetPVarInt(playerid, #ticky_army) > unix) return 1;
		SetPVarInt(playerid, #ticky_army, unix+3);
		UpdatePlayerData(playerid, "pMats", PI[playerid][pMats]);
	}
	else return ErrorMessage(playerid, "У Вас нет доступа к данному складу");
	return 1;
}
UpdateText(i)
{
	if(!i)
	{
		format(string, sizeof(string), ""WHITE"Ед. Материалов: {"#cGREEN"}%d\n"WHITE"Армия: {"#cGREEN"}Сухопутные Войска\n"WHITE"Сборка оружия: {"#cGREEN"}'/makegun'", frac_materials[19]);
		Update3DTextLabelText(frac_text[19], COLOR_WHITE, string);
		format(string, sizeof(string), ""WHITE"Ед. Материалов: {"#cGREEN"}%d\n"WHITE"Армия: {"#cGREEN"}Авианосец\n"WHITE"Сборка оружия: {"#cGREEN"}'/makegun'", frac_materials[3]);
		Update3DTextLabelText(frac_text[3], COLOR_WHITE, string);
		format(string, sizeof(string), ""WHITE"Ед. Материалов: {"#cGREEN"}%d\n"WHITE"Армия: {"#cGREEN"}U.S.A\n"WHITE"Сборка оружия: {"#cGREEN"}'/makegun'", frac_materials[20]);
		Update3DTextLabelText(frac_text[20], COLOR_WHITE, string);
		format(string, sizeof(string), ""WHITE"Ед. Материалов: {"#cGREEN"}%d\n"WHITE"Армия: {"#cGREEN"}Военно Морской Флот\n"WHITE"Сборка оружия: {"#cGREEN"}'/makegun'", frac_materials[27]);
		Update3DTextLabelText(frac_text[27], COLOR_WHITE, string);
	}
	if(i & 1) format(string, 130, ""WHITE"Байкерский склад:\n- Бензина: {"#cGREEN"}%i литров\n-"WHITE" Материалов: {"#cGREEN"}%i штук", frac_materials[28], frac_materials[23]), UpdateDynamic3DTextLabelText(BikeText, COLOR_WHITE, string);
	if(i & 2) format(string, 256, "{"#cGRAY"}Налоги / Цены:\n- Проезд в такси: %i$ (1км)\n- Продажа бизнеса: %i процентов\n- Зарплата: %i$\n\nВ казне: %i$", TransportCompany_FareTaxi, Business_Nalog, Gos_Nalog[0], Gos_Nalog[1]), UpdateDynamic3DTextLabelText(nalog_info, COLOR_GREY, string);
	return 1;
}
cmd:bikepanel(playerid)
{
	if(PI[playerid][pMember] != 23) return ErrorMessage(playerid, "Доступно только байкерам!");
