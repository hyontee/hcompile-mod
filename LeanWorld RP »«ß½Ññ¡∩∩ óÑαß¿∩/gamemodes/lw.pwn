	TransportCompany_FareTaxi, House_Fare_Class[0], House_Fare_Class[1], House_Fare_Class[2], House_Fare_Class[3], House_Fare_Class[4], House_Fare_Class[5], Business_Nalog, Gos_Nalog[0], Gos_Nalog[1]);
