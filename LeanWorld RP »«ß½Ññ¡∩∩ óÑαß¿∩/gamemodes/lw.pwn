	else ShowPlayerDialog(playerid, 155, DIALOG_STYLE_PASSWORD, ""SERVER"Смена пароля", ""WHITE"Внимание! Для продолжения данного действия, введите Ваш прошлый пароль.", "Готово", "Отмена");
	return 1;
}
SaveBusiness(bizid)
{
	string = "";
	mysql_format(1, string, 400, "UPDATE `business` SET `bCena1` = '%d', `bCena2` = '%d', `bCena3` = '%d', `bCena4` = '%d', `bCena5` = '%d', `bCena6` = '%d', `bCena7` = '%d', `bCena8` = '%d', `bCena9` = '%d', `bVhod` = '%d', `bBank` = '%d', `bProd`='%d', `bProdOrder`='%d', `bProdOrderPrice`='%d', `bProdMax`='%d' WHERE `bID` = '%d'",
	BizInfo[bizid][bCena][0], BizInfo[bizid][bCena][1], BizInfo[bizid][bCena][2], BizInfo[bizid][bCena][3], BizInfo[bizid][bCena][4], BizInfo[bizid][bCena][5], BizInfo[bizid][bCena][6], BizInfo[bizid][bCena][7], BizInfo[bizid][bCena][8], BizInfo[bizid][bVhod], BizInfo[bizid][bBank],
	BizInfo[bizid][bProd], BizInfo[bizid][bProdOrder], BizInfo[bizid][bProdOrderPrice], BizInfo[bizid][bProdMax], bizid);
	mysql_tquery(1, string);
	return 1;
}
