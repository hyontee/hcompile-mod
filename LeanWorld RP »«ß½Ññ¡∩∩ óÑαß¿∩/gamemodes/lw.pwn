GetGangColor(g) return (g == 15) ? (0x009900AA) : (g == 17) ? (0x00b4e1AA) : (g == 12) ? (0xCC00FFAA) : (g == 18) ? (0x6666ffAA) : (0xffcd00AA);
GetGangZoneColor(gangzonex)  return (GZInfo[gangzonex][gFrakVlad] == 12) ? (0xCC00FFAA) : (GZInfo[gangzonex][gFrakVlad] == 18) ? (0x6666ffAA) : (GZInfo[gangzonex][gFrakVlad] == 13) ? (0xffcd00AA) : (GZInfo[gangzonex][gFrakVlad] == 15) ? (0x009900AA) : (0x00b4e1AA);
GetMN(fraca)
{
	new fraction_string[16];
	switch(fraca)
	{
		case 5: fraction_string = "La Cosa Nostra";
		case 6: fraction_string = "Yakuza";
		case 14: fraction_string = "Russian Mafia";
	}
	return fraction_string;
}
GetColor(fraca) return (fraca == 5) ? (0xDDA70140) : (fraca == 6) ? (0xFF000040) : (0x26262640);

Reklama(playerid, const string_massive[])
{
	if(strfind(string_massive, "ш л ю х", false) != -1 || strfind(string_massive, "шлюх", false) != -1 || strfind(string_massive, "IP", false) != -1 ||
	strfind(string_massive, "шлюш", false) != -1 || strfind(string_massive, "ш л ю ш", false) != -1 || strfind(string_massive, ".ru", false) != -1 ||
	strfind(string_massive, "NEW IP", false) != -1 || strfind(string_massive, ".com", false) != -1 || strfind(string_massive, "sglban", false) != -1 ||
	strfind(string_massive, ":7777", false) != -1 || strfind(string_massive, "мать", false) != -1 || strfind(string_massive, "маму", false) != -1 ||
	strfind(string_massive, "мамку", false) != -1 || strfind(string_massive, "mamy", false) != -1 || strfind(string_massive, "mamky", false) != -1 ||
	strfind(string_massive, "matb", false) != -1 || strfind(string_massive, "уебок", false) != -1 || strfind(string_massive, "уебак", false) != -1)
	{
		if(PI[playerid][pMuteTime]) return 0;
		PI[playerid][pMuteTime] = 60;
		UpdatePlayerData(playerid, "pMuteTime", PI[playerid][pMuteTime]);
		format(string, MAX_STR, "[A] %s[%d] подозревается в рекламе [IP: %s]", PI[playerid][pNames], playerid, PI[playerid][pIP]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		format(string, SMALL_SIZE, "[A] Текст отправителя: %s", string_massive);
		SendAdminMessage(COLOR_GREY, string);
		SendClientMessage(playerid, COLOR_LIGHTRED, "Вы получили блокировку чата по подозрению в рекламе посторонних ресурсов.");
		return 0;
	}
	return 1;
}
CanGiverankPlayer(playerid)
{
	if(PI[playerid][pLeader] >= 1) return 1;
	new rank = PI[playerid][pRank];
	switch(PI[playerid][pMember])
	{
		case 1, 10, 21: if(rank >= 14) return 1;
		case 2: if(rank >= 9) return 1;
		case 3, 19, 20: if(rank >= 14) return 1;
		case 4: if(rank >= 9) return 1;
		case 7..9: if(rank >= 5) return 1;
		case 16: if(rank >= 12) return 1;
		case 11: if(rank >= 9) return 1;
		case 22: if(rank >= 9) return 1;
		case 23: if(rank >= 8) return 1;
		case 24: if(rank >= 9) return 1;
		case 25: if(rank >= 9) return 1;
		case 26: if(rank >= 9) return 1;
		case 27: if(rank >= 10) return 1;
	}
	return 0;
}
IsUninviteRank(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new member = PI[playerid][pMember], rank = PI[playerid][pRank];
	switch(member)
	{
	case 1, 10, 21: if(rank >= 13) return 1;
	case 2: if(rank >= 9) return 1;
	case 3, 19, 20: if(rank >= 13) return 1;
	case 4: if(rank >= 9) return 1;
	case 5: if(rank >= 9) return 1;
	case 6: if(rank >= 9) return 1;
	case 7..9: if(rank >= 5) return 1;
	case 11..18, 22: if(rank >= 9) return 1;
	case 23: if(rank >= 8) return 1;
	case 24: if(rank >= 9) return 1;
	case 25: if(rank >= 9) return 1;
	case 26: if(rank >= 9) return 1;
	case 27: if(rank >= 10) return 1;
	}
	return 0;
}
IsValidRank(playerid, rank)
{
	new mem = 0;
	if(PI[playerid][pLeader] > 0) mem = PI[playerid][pLeader];
	else if(PI[playerid][pMember] > 0) mem = PI[playerid][pMember];
	switch(mem)
	{
		case 1, 3, 10, 19, 21, 20: { switch(rank) { case 1..14:return 1; } }
		case 26, 4, 5, 6, 11, 12, 13, 14, 15, 17, 18, 22, 25, 2: { switch(rank) { case 1..9: return 1; } }
		case 24: { switch(rank) { case 1..11:return 1; } }
		case 23: { switch(rank) { case 1..8:return 1; } }
		case 7..9: { switch(rank) { case 1..5:return 1; } }
		case 16: { switch(rank) { case 1..12:return 1; } }
		case 27: { switch(rank) { case 1..10:return 1; } }
	}
	return 0;
}
CanRangPlayer(playerid)
{
	if(PI[playerid][pLeader] >= 1) return 1;
	new rank = PI[playerid][pRank];
	switch(PI[playerid][pMember])
	{
		case 1, 10, 21: if(rank >= 12) return 1;
		case 2: if(rank >= 9) return 1;
		case 3, 19, 20: if(rank >= 12) return 1;
		case 4: if(rank >= 9) return 1;
		case 5: if(rank >= 9) return 1;
		case 6: if(rank >= 9) return 1;
		case 7..9: if(rank >= 5) return 1;
		case 16: if(rank >= 12) return 1;
		case 11: if(rank >= 9) return 1;
		case 12: if(rank >= 9) return 1;
		case 13: if(rank >= 9) return 1;
		case 14: if(rank >= 9) return 1;
		case 15: if(rank >= 9) return 1;
		case 17: if(rank >= 9) return 1;
		case 18: if(rank >= 9) return 1;
		case 22: if(rank >= 9) return 1;
		case 23: if(rank >= 8) return 1;
		case 24: if(rank >= 11) return 1;
		case 25: if(rank >= 9) return 1;
		case 26: if(rank >= 9) return 1;
		case 27: if(rank >= 10) return 1;
	}
	return 0;
}
CanInvitePlayer(playerid)
{
	if(PI[playerid][pLeader] >= 1) return 1;
	new rank = PI[playerid][pRank];
	switch(PI[playerid][pMember])
	{
	case 1, 10, 21: if(rank >= 14) return 1;
	case 2: if(rank >= 9) return 1;
	case 4..6, 11..15, 17, 18, 22, 24..26: if(rank >= 9) return 1;
	case 3, 19, 20: if(rank >= 14) return 1;
	case 7..9: if(rank >= 5) return 1;
	case 23: if(rank >= 8) return 1;
	case 16: if(rank >= 12) return 1;
	case 27: if(rank >= 10) return 1;
	}
	return 0;
}
