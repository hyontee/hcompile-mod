	case dAdvertSend:
		{
			if(!response) return 1;
			if(gAdvertCount >= MAX_ADVERT_COUNT) return SendClientMessage(playerid, CGRAY, "К сожалению, очередь на объявления занята, попробуйте позже");
			GetPVarString(playerid, "advert", string, 100);
			DeletePVar(playerid, "advert");
			new price = strlen(string) * gAdvertPrice;
			if(PI[playerid][pCash] < price) return SendClientMessage(playerid, CGRAY, "У вас недостаточно денег");
			gAdvertCount ++;
			new slot = -1;
			for(new i;i<MAX_ADVERT_COUNT;i++)
			{
				if(!gAdvert[i][adBusy]) {slot = i; break;}
			}
			if(slot == -1) return SendClientMessage(playerid, CGRAY, ""#net"(#111)");
			Hook_GivePlayerMoney(playerid, -price);
			gAdvert[slot][adMoney] = price;
			format(gAdvert[slot][adSender], 24, "%s", PI[playerid][pNames]);
			gAdvert[slot][adPhone] = PI[playerid][pPnumber];
			format(gAdvert[slot][adText], 100, "%s", string);
			gAdvert[slot][adBusy] = true;
			SetPVarInt(playerid, #pAdvertTime, unix+60);
			format(string, sizeof string, "[R] Пришло новое объявление от %s | Отредактируйте: /edit", gAdvert[slot][adSender]);
			SendFractionMessage(16, 0x139BECFF, string);
		}
	case dAdvertList:
		{
			if(!response || listitem < 0 || listitem >= MAX_ADVERT_COUNT) return 1;
			if(!gAdvert[listitem][adBusy] || gAdvert[listitem][adCheked] || gAdvert[listitem][adCheking]) return ShowAdvertList(playerid);
			SetPVarInt(playerid, "editadvert", listitem);
			gAdvert[listitem][adCheking] = true;
			SetPVarInt(playerid, "adchecking_fix", listitem+1);
			format(string, sizeof(string), "%s\n1.Отправить\n2.Редактировать\n3.Удалить и отправить администрации\n4.Удалить", gAdvert[listitem][adText]);
