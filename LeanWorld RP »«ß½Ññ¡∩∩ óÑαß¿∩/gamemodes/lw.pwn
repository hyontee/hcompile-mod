*/

forward UpdateTo1Sec();
public UpdateTo1Sec()
{


	GlobalUnix = gettime(GlobalHour, GlobalMinute, GlobalSecond);
	GlobalDaysYear = getdate(GlobalYear, GlobalMonth, GlobalDay);

	GlobalUnix = GlobalUnix + 1 - 1;
	GlobalDaysYear = GlobalDaysYear + 1 - 1;
	return 1;
}

forward UpdateTo1Min();
public UpdateTo1Min()
{
    new Float:Pos[3];
	for(new i; i < MAX_SELL; i ++) if(SellingCar[i][sellCarStatus])
	{
	    GetVehiclePos(SellingCar[i][sellVehicle], Pos[0], Pos[1], Pos[2]);
		if(Pos[0] != CoordSellCars[i][0] && Pos[1] != CoordSellCars[i][1] && Pos[2] != CoordSellCars[i][2]) SetVehiclePos(SellingCar[i][sellVehicle], CoordSellCars[i][0], CoordSellCars[i][1], CoordSellCars[i][2]);
    }
    MinuteTimer();
	return 1;
}
forward UpdateTo10Min();
public UpdateTo10Min()
{
	new alcoboy;
	switch(alcoboy)
	{
	    case 0:
	    {
	        SendClientMessageToAll(-1, "");
			SendClientMessageToAll(COLOR_SERVER, "Информация: {ffffff}Нашли баг или недоработку? Сообщите нам — "SERVER"/bug{ffffff} Мы обязательно исправим!");
			SendClientMessageToAll(COLOR_SERVER, "Информация: {ffffff}На нашем сервере Вы можете посмотреть ТОП игроков введя команду — "SERVER"/top!");
			SendClientMessageToAll(COLOR_SERVER, "Информация: {ffffff}Введя команду — "SERVER"/report{FFFFFF} Вы можете сообщить Нам о нарушителе или получить ответ на вопрос!");
			SendClientMessageToAll(-1, "");
			SendAdminMessage(COLOR_GREY, "[A] Админ-помощник: Вводи - /adonate для покупки повышения/команд и других штук!)");
	        alcoboy = 1;
	    }
	    case 1:
	    {
	        SendClientMessageToAll(-1, "");
	        SendClientMessageToAll(COLOR_SERVER, "Акция: {ffffff}Админ-права от 50 рублей "SERVER"(Скидка){FFFFFF}, скорее вводи — "SERVER"/donate");
	        SendClientMessageToAll(COLOR_SERVER, "Новинка: {ffffff}В /donate - Рубли, Вы можете приобрести: "SERVER"радужный клист, костюм на персонажа, VIP транспорт!");
	        SendClientMessageToAll(COLOR_SERVER, "Акция: {ffffff}Пополняй счёт легко и быстро:"SERVER"lwrp.ru");
	        SendClientMessageToAll(-1, "");
	        SendAdminMessage(COLOR_GREY, "[A] Админ-помощник: Вводи - /ahelp, для просмотра админ-команд!");
	        alcoboy = 2;
	    }
        case 2:
	    {
            SendClientMessageToAll(-1, "");
            SendClientMessageToAll(COLOR_SERVER, "Информация: {ffffff}Сайт нашего проекта:"SERVER"lwrp.ru");
            SendClientMessageToAll(COLOR_SERVER, "Информация: {ffffff}Форум нашего проекта:"SERVER"lwrp.ru/forum");
            SendClientMessageToAll(COLOR_SERVER, "Информация: {ffffff}Группа нашего проекта VK:"SERVER"vk.com/lean_world_rp");
            SendClientMessageToAll(-1, "");
            SendAdminMessage(COLOR_GREY, "[A] Админ-помощник: Проводите мероприятия, дабы игроки не скучали! :)");
	        alcoboy = 5;
	    }
	    case 4:
	    {
			SendClientMessageToAll(-1, "");
			SendClientMessageToAll(COLOR_SERVER, "Информация:"WHITE" Имеешь "SERVER"Tik/Tok/YouTube"WHITE" канал, на котором более 1000 подписчиков?");
			SendClientMessageToAll(COLOR_SERVER, "Информация:"WHITE" Скорее пиши нам в группу ВКонтакте "SERVER"(vk.com/lean_world_rp)"WHITE" и получай уникальные бонусы при "SERVER"сотрудничестве"WHITE" с нами!");
			SendClientMessageToAll(COLOR_SERVER, "Уникально:"WHITE" Не упусти свой шанс! Это "SERVER"действительно"WHITE" уникально!");
			SendClientMessageToAll(-1, "");
			alcoboy = 0;
	    }
		case 5:
		{
	        SendClientMessageToAll(-1, "");
	        SendClientMessageToAll(COLOR_SERVER, "Акция: {ffffff}Админ-права от 50 рублей "SERVER"(Скидка){FFFFFF}, скорее вводи — "SERVER"/donate");
	        SendClientMessageToAll(COLOR_SERVER, "Новинка: {ffffff}В /donate - Рубли, Вы можете приобрести: "SERVER"радужный клист, костюм на персонажа, VIP транспорт!");
	        SendClientMessageToAll(COLOR_SERVER, "Акция: {ffffff}Пополняй счёт легко и быстро:"SERVER"lwrp.ru");
	        SendClientMessageToAll(-1, "");
		    alcoboy = 4;
		}
	}

	new hour, minute, second;
	new year, month, day;

	getdate(year, month, day);
	gettime(hour, minute, second);

	new query_string[1024];
	mysql_format(1, query_string, sizeof(query_string), "UPDATE `app_gmap` SET `groveTerritories` = '%d', `groveOnline` = '%d', `ballasTerritories` = '%d', `ballasOnline` = '%d', `vagosTerritories` = '%d', `vagosOnline` = '%d', `rifaTerritories` = '%d', `rifaOnline` = '%d', `aztecTerritories` = '%d', `aztecOnline` = '%d', `lastUpdate` = '%d:%d:%d (%d.%d.%d)'", TotalGZCount(15), FracPlayersCount(15), TotalGZCount(12), FracPlayersCount(12), TotalGZCount(13), FracPlayersCount(13), TotalGZCount(18), FracPlayersCount(18), TotalGZCount(17), FracPlayersCount(17), hour, minute, second, day, month, year);
	mysql_tquery(1, query_string);
	return 1;
}
forward UpdateTo45Min();
public UpdateTo45Min()
{
    new weather ;
	weather = random(20) ;
	globalWeather = weather;
	foreach(Player, i)
	{
		if (!IsPlayerConnected(i))
			break;

		if (PI[i][pWeather] > 0)
			UpdatePlayerWeather(i);
	}
	SendWeatherMessage(COLOR_BLUE, "{1F7C65}[Новости штата] {FFFFFF}Уважаемые жители и гости штата LeanWorld, минуточку внимания!");
	SendWeatherMessage(COLOR_BLUE, "{1F7C65}[Новости штата] {FFFFFF}Прослушайте важную информацию о последнем прогнозе погоды.");
	switch(weather)
	{
		case 1, 2, 3, 5, 6, 10, 11, 13, 14, 17, 18: SendWeatherMessage(COLOR_BLUE, "{1F7C65}[Новости штата] {FFFFFF}В штате намечается потепление! Не забудьте надеть лёгкий головной убор.");
		case 8, 16, 19:SendWeatherMessage(COLOR_BLUE, "{1F7C65}[Новости штата] {FFFFFF}Штормовое предупреждение! Просим воздержаться от поездок и прогулок и переждать шторм дома.");
		case 4, 9:SendWeatherMessage(COLOR_BLUE, "{1F7C65}[Новости штата] {FFFFFF}На город налетел туман! Будьте бдительны на дорогах.");
		case 7, 12, 15, 20:SendWeatherMessage(COLOR_BLUE, "{1F7C65}[Новости штата] {FFFFFF}В штате намечается резкое похолодание. Готовьте тёплые вещи!");
	}
	SendWeatherMessage(COLOR_BLUE, "{1F7C65}[Новости штата] {FFFFFF}Спасибо за внимание!");
	return 1;
}
stock Second_Timer(playerid)
{
	if(player_family[playerid])
	{
		if(GetPVarInt(playerid, "family_name_color") != family_info [ player_family [ playerid ] ] [ f_name_color ])
	    {
			DestroyDynamic3DTextLabel(player_family_3dtext[playerid]);
			player_family_3dtext[playerid] = Text3D:-1;
			SetPVarInt(playerid, "family_name_color", family_info [ player_family [ playerid ] ] [ f_name_color ]);
	    }
		if(player_family_3dtext[playerid]==Text3D:-1)
		{
			format(string, 128, ""WHITE"[»] {%s}%s "WHITE"Family",family_name_color [ family_info [ player_family [ playerid ] ] [ f_name_color ] ], family_info [ player_family [ playerid ] ] [ f_name ]);
		    player_family_3dtext[playerid] = CreateDynamic3DTextLabel(string,-1,2.0,2.0,2.0,15.0,playerid);
			Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL,player_family_3dtext[playerid],E_STREAMER_ATTACH_OFFSET_X, 0.0);
			Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL,player_family_3dtext[playerid],E_STREAMER_ATTACH_OFFSET_Y, 0.0);
			Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL,player_family_3dtext[playerid],E_STREAMER_ATTACH_OFFSET_Z, 0.5);
		}
	}
	else if(!player_family[playerid] && player_family_3dtext[playerid]!=Text3D:-1)
	{
		DestroyDynamic3DTextLabel(player_family_3dtext[playerid]);
		player_family_3dtext[playerid] = Text3D:-1;
	}
	else if(player_family_3dtext[playerid]!=Text3D:-1)
	{
		DestroyDynamic3DTextLabel(player_family_3dtext[playerid]);
		player_family_3dtext[playerid] = Text3D:-1;
	}
	if(PI[playerid][pPrisonTime] || PI[playerid][pJailTime] || PI[playerid][pWanted] > 0)
	{
		if(player_prison_text[playerid]==Text3D:-1)
		{
		    SetPVarInt(playerid, "Type3DText", (PI[playerid][pPrisonTime] || PI[playerid][pJailTime]) ? (1) : (2));
		    player_prison_text[playerid] = CreateDynamic3DTextLabel((PI[playerid][pPrisonTime] || PI[playerid][pJailTime]) ? ("Заключенный") : ("В розыске"), COLOR_REDD, 2.0, 2.0, 2.0, 15.0, playerid);
			Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, player_prison_text[playerid], E_STREAMER_ATTACH_OFFSET_X, 0.0);
			Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, player_prison_text[playerid], E_STREAMER_ATTACH_OFFSET_Y, 0.0);
			Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, player_prison_text[playerid], E_STREAMER_ATTACH_OFFSET_Z, 0.8);
		}
	}
	else if((GetPVarInt(playerid, "Type3DText") == 1 && !PI[playerid][pPrisonTime] && !PI[playerid][pJailTime]) || (GetPVarInt(playerid, "Type3DText") == 2 && !PI[playerid][pWanted]))
	{
		DestroyDynamic3DTextLabel(player_prison_text[playerid]);
		player_prison_text[playerid] = Text3D:-1;
		DeletePVar(playerid, "Type3DText");
	}
	else if(player_prison_text[playerid]!=Text3D:-1)
	{
		DestroyDynamic3DTextLabel(player_prison_text[playerid]);
		player_prison_text[playerid] = Text3D:-1;
		DeletePVar(playerid, "Type3DText");
	}
	if(PI[playerid][pLogin])
	{
		pTemp[playerid][pAFK] ++;
		if(pTemp[playerid][pAFK] >= AFK_SECOND)
		{
			static const fmt_string1[] = "[AFK] [%s]";
			new str1[sizeof(fmt_string1)+10];
			format(str1, sizeof(str1), fmt_string1,TimeConverter(pTemp[playerid][pAFK] - 2));
			SetPlayerChatBubble(playerid,str1,0x20BA09FF,20.0,1200);
		}
		if(pTemp[playerid][pAFK] == 6000 && !PI[playerid][pAdmin])
		{
			SCM(playerid, COLOR_LIGHTRED, "Вы были кикнуты т.к были долгое время в АФК");
			KickEx(playerid);
		}
		if(GetPVarInt(playerid, "Spectate") && GetPVarInt(playerid, "SpectateID") != -1) UpdateRecon(playerid, GetPVarInt(playerid, "SpectateID"));
		else if(GetPVarInt(playerid, "Spectate") && GetPVarInt(playerid, "SpectateID") == -1) DeletePVar(playerid, "Spectate"), SetPVarInt(playerid, "SpectateID", -1), TextDrawHideForPlayer(playerid, ReconText), PlayerTextDrawDestroy(playerid, PlayerText:ReconPlayerText[playerid][0]), PlayerTextDrawDestroy(playerid, PlayerText:ReconPlayerText[playerid][1]);
		if(GetPVarInt(playerid, "ColorFire"))
		{
			if(GetPlayerWeapon(playerid) == 41)
			{
				if(GetPVarInt(playerid, "GZLogoID"))
				{
					if(IsPlayerInRangeOfPoint(playerid, 2.0, GZLogo[GetPVarInt(playerid, "GZLogoID")-1][0], GZLogo[GetPVarInt(playerid, "GZLogoID")-1][1], GZLogo[GetPVarInt(playerid, "GZLogoID")-1][2]))
					{
						new Float:angle;
						GetPlayerFacingAngle(playerid, angle);
						if(GZLogo[GetPVarInt(playerid, "GZLogoID")-1][4]-30 < angle < GZLogo[GetPVarInt(playerid, "GZLogoID")-1][4]+30)
						{
							new Float:ammo = GetPVarInt(playerid, "ColorFire") - GetPlayerAmmo(playerid);
							SetPVarInt(playerid, "ColorFire", GetPlayerAmmo(playerid));
							new i = GetPVarInt(playerid, "GZLogoID")-1;
							if(!GZLogoInfo[i][gOwner][1])
							{
								if(GZLogoInfo[i][gOwner][0] == PI[playerid][pMember]) return 1;
								if(GZLogoInfo[i][gFinish][0] < ammo) ammo = GZLogoInfo[i][gFinish][0];
								GZLogoInfo[i][gFinish][0] -= ammo;
								format(string, 11, "~g~%.1f%", GZLogoInfo[i][gFinish][0]);
								GameTextForPlayer(playerid, string, 500, 3);
								if(!GZLogoInfo[i][gFinish][0])
								{
									TotalGraf[GZLogoInfo[i][gOwner][1]]--;
									GZLogoInfo[i][gOwner][1] = PI[playerid][pMember];
									GZLogoInfo[i][gID][1] = CreateDynamicObjectEx(19353, GZLogo[i][0]+(0.1 * floatsin(-GZLogo[i][3]+90, degrees)), GZLogo[i][1]+(0.1 * floatcos(-GZLogo[i][3]+90, degrees)), GZLogo[i][2], 0.000, 0.000, GZLogo[i][3], 300.000);
									switch(GZLogoInfo[i][gOwner][1])
									{
									case 15: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1490, "tags2_lalae", "grove", 0);
									case 12: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1529, "tags_latemple", "temple", 0);
									case 18: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1526, "tags_larifa", "rifa", 0);
									case 17: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1531, "tags_laazteca", "aztecas", 0);
									case 13: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1530, "tags_lavagos", "vagos", 0);
									}
									TotalGraf[GZLogoInfo[i][gOwner][1]]++;
									GZLogoInfo[i][gFinish][1] = 1000;
									UpdateStoreGang(PI[playerid][pMember]);
									SaveGZLogo(i);
								}
							}
							else
							{
								if(GZLogoInfo[i][gOwner][1] == PI[playerid][pMember]) return 1;
								if(GZLogoInfo[i][gFinish][1] < ammo) ammo = GZLogoInfo[i][gFinish][1];
								GZLogoInfo[i][gFinish][1] -= ammo;
								format(string, 11, "~g~%.1f%", GZLogoInfo[i][gFinish][1]);
								GameTextForPlayer(playerid, string, 500, 3);
								if(!GZLogoInfo[i][gFinish][1])
								{
									DestroyDynamicObject(GZLogoInfo[i][gID][0]);
									DestroyDynamicObject(GZLogoInfo[i][gID][1]);
									TotalGraf[GZLogoInfo[i][gOwner][0]]--;
									GZLogoInfo[i][gOwner][0] = GZLogoInfo[i][gOwner][1];
									TotalGraf[GZLogoInfo[i][gOwner][1]]--;
									GZLogoInfo[i][gOwner][1] = PI[playerid][pMember];
									GZLogoInfo[i][gID][0] = CreateDynamicObjectEx(19353, GZLogo[i][0], GZLogo[i][1], GZLogo[i][2], 0.000, 0.000, GZLogo[i][3], 300.000);
									switch(GZLogoInfo[i][gOwner][0])
									{
									case 15: SetDynamicObjectMaterial(GZLogoInfo[i][gID][0], 0, 1490, "tags2_lalae", "grove", 0);
									case 12: SetDynamicObjectMaterial(GZLogoInfo[i][gID][0], 0, 1529, "tags_latemple", "temple", 0);
									case 18: SetDynamicObjectMaterial(GZLogoInfo[i][gID][0], 0, 1526, "tags_larifa", "rifa", 0);
									case 17: SetDynamicObjectMaterial(GZLogoInfo[i][gID][0], 0, 1531, "tags_laazteca", "aztecas", 0);
									case 13: SetDynamicObjectMaterial(GZLogoInfo[i][gID][0], 0, 1530, "tags_lavagos", "vagos", 0);
									}
									TotalGraf[GZLogoInfo[i][gOwner][0]]++;
									GZLogoInfo[i][gFinish][0] = 1000;
									GZLogoInfo[i][gID][1] = CreateDynamicObjectEx(19353, GZLogo[i][0]+(0.1 * floatsin(-GZLogo[i][3]+90, degrees)), GZLogo[i][1]+(0.1 * floatcos(-GZLogo[i][3]+90, degrees)), GZLogo[i][2], 0.000, 0.000, GZLogo[i][3], 300.000);
									switch(GZLogoInfo[i][gOwner][1])
									{
									case 15: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1490, "tags2_lalae", "grove", 0);
									case 12: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1529, "tags_latemple", "temple", 0);
									case 18: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1526, "tags_larifa", "rifa", 0);
									case 17: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1531, "tags_laazteca", "aztecas", 0);
									case 13: SetDynamicObjectMaterial(GZLogoInfo[i][gID][1], 0, 1530, "tags_lavagos", "vagos", 0);
									}
									TotalGraf[GZLogoInfo[i][gOwner][1]]++;
									GZLogoInfo[i][gFinish][1] = 1000;
									UpdateStoreGang(PI[playerid][pMember]);
									SaveGZLogo(i);
								}
							}
						}
					}
				}
				else DeletePVar(playerid, "GZLogoID"), DeletePVar(playerid, "ColorFire");
			}
			else DeletePVar(playerid, "ColorFire");
		}
		if(walk_goto_me[playerid] > 0)
		{
			new id = walk_goto_me[playerid] - 1;
			new Float:X, Float:Y, Float:Z, Float:R;
			if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
			{
		    	GetPlayerPos(id, X, Y, Z);
				SetPlayerFaceToPoint(playerid, X, Y);

		    	new Float:GotoPos[3];
		    	new anim = GoPlayerAnimation(playerid, X, Y, Z);

				if(GetPlayerInterior(id) != GetPlayerInterior(playerid) || GetPlayerVirtualWorld(id) != GetPlayerVirtualWorld(playerid))
				{
				    GetPlayerPos(id, X, Y, Z);
				    SetPlayerPos(playerid, X, Y, Z);
				    SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(id));
				    SetPlayerInterior(playerid, GetPlayerInterior(id));
				}

		    	if(anim != 1)
		    	{
			    	GotoPos[0]=GetPVarFloat(playerid, "CuffX");
			    	GotoPos[1]=GetPVarFloat(playerid, "CuffY");
			    	GotoPos[2]=GetPVarFloat(playerid, "CuffZ");

			    	if(IsPlayerInRangeOfPoint(playerid, 0.05, GotoPos[0], GotoPos[1], GotoPos[2]))
					{
						GetPlayerPos(playerid, X, Y, Z);
						GetPlayerFacingAngle(playerid, R);
	                 	X += (1.5 * floatsin(-R, degrees));
						Y += (1.5 * floatcos(-R, degrees));
						SetPlayerPos(playerid, X, Y, Z);
					}

		            GetPlayerPos(playerid, X, Y, Z);
			    	SetPVarFloat(playerid, "CuffX", X);
			    	SetPVarFloat(playerid, "CuffY", Z);
			    	SetPVarFloat(playerid, "CuffZ", Z);
		    	}
			}
		}
	}
	if(!PI[playerid][pLogin] || pTemp[playerid][pAFK] > AFK_SECOND) return 1;
	if(GetAccessAdmin(playerid, 1))
	{
	    if(PI[playerid][pAdmin] && pTemp[playerid][pAFK] < 3 && GetPVarInt(playerid, "playerAdmin")) pTemp[playerid][admPlayOnline]++;
	    
 		mysql_format(1, string, 128, "UPDATE `admin` SET `online_%s`='%d' WHERE Name='%e'", getDay(), pTemp[playerid][admPlayOnline], PI[playerid][pNames]);
		mysql_tquery(1, string);
    }
	PI[playerid][playOnline]++;
	if(BankDoor_Time_Close[playerid] > 0 && BankDoor_Status)
	{
		BankDoor_Time_Close[playerid]--;
		if(BankDoor_Time_Close[playerid] == 1) BankDoor_Status = false, MoveObject (DoorOpen, 2144.17, 1627.082, 994.2620, 0.3);
	}
	if(PI[playerid][pNarcoLomka] > 0 && PI[playerid][pNarcoLomka] != 2)
	{
		if(random(2) == 1) ApplyAnimation(playerid, "CRACK", "crckdeth1", 4.0, 0, 0, 1, 1, 1);
		else ApplyAnimation(playerid, "CRACK", "crckdeth3", 4.0, 0, 0, 1, 1, 1);
	}
	if(PI[playerid][pCash] >= 50000000 && PI[playerid][pSettings] & sCaseInHand)
	{
		new Keys = GetPVarInt(playerid, "KeysPlayer");
		if(!Keys)
		{
			SetPlayerAttachedObject(playerid, 8, 1210, 5, 0.299999, 0.099999, 0.000000, 0.000000, -83.000000, 0.000000, 1.000000, 1.000000, 1.000000);
			SetPVarInt(playerid, "KeysPlayer", true);
		}
		if(Keys)
		{
			if(GetPlayerWeapon(playerid) || GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
			{
				if(IsPlayerAttachedObjectSlotUsed(playerid, 8))
					RemovePlayerAttachedObject(playerid, 8);
			}
			else
			{
				if(!IsPlayerAttachedObjectSlotUsed(playerid, 8))
					SetPlayerAttachedObject(playerid, 8, 1210, 5, 0.299999, 0.099999, 0.000000, 0.000000, -83.000000, 0.000000, 1.000000, 1.000000, 1.000000);
			}
		}
	}
	else
	{
		RemovePlayerAttachedObject(playerid, 8);
	}
	if(PI[playerid][pCash] < 50000000 && IsPlayerAttachedObjectSlotUsed(playerid, 8) && GetPVarInt(playerid, "KeysPlayer"))
	{
		RemovePlayerAttachedObject(playerid, 8);
		DeletePVar(playerid, "KeysPlayer");
	}
	if(GetPVarFloat(playerid, "GPS_X")&&GetPVarFloat(playerid, "GPS_Y")&&GetPVarFloat(playerid, "GPS_Z"))
	{
        new Float:gps_X = GetPVarFloat(playerid, "GPS_X");
        new Float:gps_Y = GetPVarFloat(playerid, "GPS_Y");
        new Float:gps_Z = GetPVarFloat(playerid, "GPS_Z");

        new Float:kPos[3];
        GetPlayerPos(playerid, kPos[0], kPos[1], kPos[2]);

        new Float:distance = VectorSize(kPos[0]-gps_X, kPos[1]-gps_Y, kPos[2]-gps_Z);
		if(distance < 40)
		{
		    DeletePVar(playerid, "GPS_X");
		    DeletePVar(playerid, "GPS_Y");
		    DeletePVar(playerid, "GPS_Z");
		    RemovePlayerMapIcon(playerid, 80);
		    SendClientMessage(playerid, COLOR_GREEN, "Вы достигли места назначения, метка убрана.");
		}
	}
	if(GetPVarInt(playerid, "ProdExit_Car"))
	{
	    SetPVarInt(playerid, "ProdExit_Car", GetPVarInt(playerid, "ProdExit_Car")-1);
	    format(string, 10, "~r~~h~%i", GetPVarInt(playerid, "ProdExit_Car"));
	    GameTextForPlayer(playerid, string, 1000, 6);
	    if(GetPVarInt(playerid, "ProdExit_Car")==1)
	    {
            if(gPlayerProdText[playerid][0] != Text3D:-1 || gPlayerProdText[playerid][1] != Text3D:-1 || gPlayerProdCP[playerid] != -1)
            {
                if(gPlayerProdText[playerid][0] != Text3D:-1) DestroyDynamic3DTextLabel(gPlayerProdText[playerid][0]);
                if(gPlayerProdText[playerid][1] != Text3D:-1) DestroyDynamic3DTextLabel(gPlayerProdText[playerid][1]);
                if(gPlayerProdCP[playerid] != -1) DestroyDynamicCP(gPlayerProdCP[playerid]);

                gPlayerProdText[playerid][0] = Text3D:-1;
                gPlayerProdText[playerid][1] = Text3D:-1;
                gPlayerProdCP[playerid] = -1;

                SendClientMessage(playerid, 0xFFFF00AA, "Рабочий день завершен");

                SetVehicleToRespawn(GetPVarInt(playerid, "prod_vehicle_id"));
                DeletePVar(playerid, "prod_vehicle_id");
                DeletePVar(playerid, "prod_next");
                DeletePVar(playerid, "count_prod2");
            }

	        DeletePVar(playerid, "ProdExit_Car");
	    }
	}
	if(GetPVarInt(playerid, "NarkoTimer") <= unix && GetPVarInt(playerid, "NarkoTimer") != 0)
	{
		DeletePVar(playerid, "NarkoTimer");
		SetPlayerWeather(playerid, 1);
	}
	if(GetPVarInt(playerid, "SMOKE") > unix)
	{
		switch(GetPVarInt(playerid, "SMOKE")-unix)
		{
			case 60, 45, 30, 15:
			{
				format(string, 70, "* %s стряхнул(а) пепел с сигареты", PI[playerid][pNames]);
				ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
				SetPlayerChatBubble(playerid, "стряхнул(а) пепел с сигареты", 0xDD90FFFF, 30.0, 10000);
			}
		}
	}
	else if(GetPVarInt(playerid, "SMOKE") == unix)
	{
		DeletePVar(playerid, "SMOKE");
		DeletePVar(playerid, "ZatJ");
		RemovePlayerAttachedObject(playerid, 3);
		format(string, 50, "* %s выкинул(а) окурок", PI[playerid][pNames]);
		ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
		SetPlayerChatBubble(playerid, "выкинул(а) окурок", 0xDD90FFFF, 30.0, 10000);
	}
	if(PI[playerid][pMember] == 23 && !BikeGrab && GetPVarInt(playerid, #player_timer) && fuelID == -1) SendClientMessage(playerid, COLOR_REDD, "Байкерское ограбление завершено!"), PlayerTextDrawHide(playerid, GrabText[playerid]), DeletePVar(playerid, #player_timer);
	if(BikeGrab && TimeGrab > unix && !IsPlayerInRangeOfPoint(playerid, 2.0, Filling[fuelID][sFuelPos][0], Filling[fuelID][sFuelPos][1], Filling[fuelID][sFuelPos][2]) && Filling[fuelID][sStartGrab] && PI[playerid][pMember] == 23)
	{
		if(TotalUsers{playerid}) TotalUser--, TotalUsers{playerid} = false;
		if(GetPVarInt(playerid, #grab_check)) DeletePVar(playerid, #grab_check);
	}
	if(TimeGrab > unix && BikeGrab && PI[playerid][pMember] == 23) format(string, 50, "Time Left: %s", TimeConverter(TimeGrab-unix)), PlayerTextDrawSetString(playerid, GrabText[playerid], string);
	if(status_siren && PlayerToPoint(120.0, playerid, -1277.4569, 478.6797, 11.5860))
    {
        GetPlayerPos(playerid, PlayerPos[playerid][0], PlayerPos[playerid][1], PlayerPos[playerid][2]);
        PlayerPlaySound(playerid, 6001, PlayerPos[playerid][0], PlayerPos[playerid][1], PlayerPos[playerid][2]);
    }
	FromFresh(playerid);
	if(GetPVarInt(playerid, #icon_banner)) SelectTextDraw(playerid, 0xFFFFFFAA);
	if(GetPVarInt(playerid, #give_pts)) SelectTextDraw(playerid, 0xFFFFFF50);
	if(GetPVarInt(playerid, "bankmenu")) SelectTextDraw(playerid, 0xBDBDBDFF);
	if(Vip_Advertise_Time[playerid] == unix)
	{
		format(string, BIG_SIZE, "{99FFCC}[PREMIUM WAVE] %s. Отправитель: %s[%d]. Тел: %d", gVip[playerid][adText], gVip[playerid][adSender], gVip[playerid][adID], gVip[playerid][adNumber]);
		SendClientMessageToAll(0xEFAB0CFF, string);
		Vip_Advertise_Time[playerid] = 0;
		gVip[playerid][adID] = 0;
		gVip[playerid][adNumber] = 0;
		strdel(gVip[playerid][adText], 0, 100);
		strdel(gVip[playerid][adSender], 0, 24);
	}
	if(GetPVarInt(playerid, "AntiDM_Zone") && GetPlayerWeapon(playerid) != 3 && PI[playerid][pMember] != 1 && PI[playerid][pMember] != 2 && PI[playerid][pMember] != 10 && PI[playerid][pMember] != 21 && PI[playerid][pMember] != 25 && PI[playerid][pMember] != 26 && !IsAArm(playerid))
	{
		SetPlayerArmedWeapon(playerid, 0);
	}
	if((PlayerToPoint(2.0, playerid, 312.6434, -165.7492, 999.6010) || PlayerToPoint(2.0, playerid, -1636.9213, 608.1162, -51.8141)) && GetPVarInt(playerid, "Sklad")) MatsArmyGive(playerid);
	if(PI[playerid][pJailTime]>0)
	{
		if(!PlayerToPoint(70.0, playerid, 2897.9143,1788.0468,1088.4106) && PI[playerid][pMestoJail] == 1)
		{
			switch(random(8))
			{
				case 0: SetPlayerPos(playerid, 2897.9143,1788.0468,1088.4106),SetPlayerFacingAngle(playerid, 180.0);
				case 1: SetPlayerPos(playerid, 2901.2275,1788.0468,1088.4106),SetPlayerFacingAngle(playerid, 180.0);
				case 2: SetPlayerPos(playerid, 2904.6006,1788.0468,1088.4106),SetPlayerFacingAngle(playerid, 180.0);
				case 3: SetPlayerPos(playerid, 2907.9966,1788.0468,1088.4106),SetPlayerFacingAngle(playerid, 180.0);
				case 4: SetPlayerPos(playerid, 2908.1548,1782.2065,1088.4106),SetPlayerFacingAngle(playerid, 360.0);
				case 5: SetPlayerPos(playerid, 2904.4519,1782.2065,1088.4106),SetPlayerFacingAngle(playerid, 360.0);
				case 6: SetPlayerPos(playerid, 2901.1973,1782.2065,1088.4106),SetPlayerFacingAngle(playerid, 360.0);
				case 7: SetPlayerPos(playerid, 2897.9927,1781.2065,1088.4106),SetPlayerFacingAngle(playerid, 360.0);
			}
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid, 25);
			PI[playerid][pMestoJail] = 1;
			UpdatePlayerData(playerid, "pMestoJail", 1);
		}
		else if(!PlayerToPoint(40.0, playerid, 219.5400, 109.9767, 999.0156) && PI[playerid][pMestoJail] == 2)
		{
			SetPlayerInterior(playerid, 10);
			SetPlayerPos(playerid, 219.5400, 109.9767, 999.0156);
			SetPlayerFacingAngle(playerid, 1.0000);
			PI[playerid][pMestoJail] = 2;
			UpdatePlayerData(playerid, "pMestoJail", 2);
		}
		else if(!PlayerToPoint(40.0, playerid, 198.3642, 161.8103, 1003.0300) && PI[playerid][pMestoJail] == 3)
		{
			SetPlayerInterior(playerid, 3);
			SetPlayerPos(playerid, 198.3642, 161.8103, 1003.0300);
			SetPlayerFacingAngle(playerid, 1.0000);
			PI[playerid][pMestoJail] = 3;
			UpdatePlayerData(playerid, "pMestoJail", 3);
		}
		else if(!PlayerToPoint(40.0, playerid, 805.0851, -57.7863, 994.6209) && PI[playerid][pMestoJail] == 4)
		{
			SetPlayerInterior(playerid, 1);
			SetPlayerPos(playerid, 805.0851, -57.7863, 994.6209);
			SetPlayerFacingAngle(playerid, 271.1044);
			PI[playerid][pMestoJail] = 4;
			UpdatePlayerData(playerid, "pMestoJail", 4);
		}
	}
	if(PI[playerid][pMuteTime]>0)
	{
		PI[playerid][pMuteTime] --;
		if(PI[playerid][pMuteTime] <= 1)
		{
			PI[playerid][pMuteTime] = 0;
			UpdatePlayerData(playerid, "pMuteTime", 0);
			SendClientMessage(playerid, COLOR_WHITE, ""#information"Вам включили чат. Пожалуйста, больше не нарушайте правила.");
		}
	}
	if(PI[playerid][pRepMuteTime]>0)
	{
		PI[playerid][pRepMuteTime] --;
		if(PI[playerid][pRepMuteTime] <= 1)
		{
			PI[playerid][pRepMuteTime] = 0;
			UpdatePlayerData(playerid, "pRepMuteTime", 0);
			SendClientMessage(playerid, COLOR_WHITE, ""#information"Вам включили репорт. Пожалуйста, больше не нарушайте правила.");
		}
	}
	if(muteTime[playerid] - unix <= 0 && muteTime[playerid] != -1) muteTime[playerid] = -1, muteWarnings[playerid] = 0;
	if(PI[playerid][pPrisonTime]>0)
	{
		PI[playerid][pPrisonTime] --;
		if(PI[playerid][pPrisonTime]<=1)
		{
			SpawnPlayer(playerid);
			PI[playerid][pPrisonTime] = 0; UpdatePlayerData(playerid, "pPrisonTime", 0);
		}
	}
	if(GetPVarInt(playerid, "PlayerCuffed") == 1)
	{
		if(GetPVarInt(playerid, "PlayerCuffedTime") <= 0)
		{
			TogglePlayerControllable(playerid, 1);
			ClearAnimations(playerid, true);
			DeletePVar(playerid, "PlayerCuffed");
			DeletePVar(playerid, "PlayerCuffedTime");
		}
		else GivePVarInt(playerid, "PlayerCuffedTime", -1);
	}
	else if(GetPVarInt(playerid, "PlayerCuffed") == 2)
	{
		if(GetPVarInt(playerid, "PlayerCuffedTime") <= 0)
		{
			TogglePlayerControllable(playerid, 1);
			ClearAnimations(playerid, true);
			DeletePVar(playerid, "PlayerCuffed");
			DeletePVar(playerid, "PlayerCuffedTime");
		}
		else GivePVarInt(playerid, "PlayerCuffedTime", -1);
	}
	return 1;
}
PIrmation()
{
    for(new i=0; i<sizeof(Gates_Total); i++) if(Gates_Total[i]) Gates_Total[i]--;
	if(Gates_Total[0] == 1) MoveObject(lspdgate, 1544.69921875, -1630.7998046875, 13.10000038147-0.05, 0.05, 0.00000000, 89.00000000, 90.00000000), Gates_Total[0] = 0;
	//else if(Gates_Total[1] == 1) MoveObject(sfpdgate[0], -1572.1739502, 658.7340088, 6.7649999-0.05, 0.05, 0.0000000, 269.7497864, 270.5000000), Gates_Total[1] = 0;
	//else if(Gates_Total[2] == 1) MoveObject(sfpdgate[1], -1701.4420166, 687.6950073, 24.5750008-0.05, 0.05, 0.0000000, 270.0000000, 90.0000000), Gates_Total[2] = 0;
	//else if(Gates_Total[3] == 1) MoveObject(lvpdgate[1], 2238.1860352, 2450.4460449, 10.6000004-0.05, 0.05, 0.0000000, 270.2502441, 269.9999695), Gates_Total[3] = 0;
	else if(Gates_Total[4] == 1) MoveObject(armygate[0], 135.10, 1940.86, 21.09, 1.2), Gates_Total[4] = 0;
	else if(Gates_Total[5] == 1) MoveObject(fbigate, 927.5457270,-1741.1474656,14.2983097, 2), Gates_Total[5] = 0;
	else if(Gates_Total[6] == 1) MoveObject(vmfgate[0], -2278.5000000, 2395.5000000, 5.1000000, 1.2), Gates_Total[6] = 0;
	else if(Gates_Total[7] == 1) MoveObject(vmfgate[1], -2297.7000000, 2369.3000000, 7.2000000, 1.2), Gates_Total[7] = 0;
	else if(Gates_Total[8] == 1) MoveObject(medshlag[0], 1185.7998, -1342, 13.3-0.004, 0.004, 0, 88.995, 90), Gates_Total[8] = 0;
	else if(Gates_Total[9] == 1) MoveObject(medshlag[1], 1185.7002, -1305.40039, 13.3-0.004, 0.004, 0, 269.998, 90), Gates_Total[9] = 0;
	else if(Gates_Total[10] == 1) MoveObject(armygate[1], -1530.0350342, 482.5390015, 7.8540001, 1.2), Gates_Total[10] = 0;
	else if(Gates_Total[11] == 1) MoveObject(armygate[2], 345.11, 1797.59, 20.00, 1.2), Gates_Total[11] = 0;
	//else if(Gates_Total[12] == 1) MoveObject(lvpdgate[0], 2335.1560059, 2443.7409668, 7.0000000, 1.2), Gates_Total[12] = 0;
	else if(Gates_Total[13] == 1) MoveDynamicObject(UsaGate[0], 2720.595, -2401.096, 12.850, 1.2), Gates_Total[13] = 0;
	else if(Gates_Total[14] == 1) MoveDynamicObject(UsaGate[1], 2720.565, -2508.266, 12.875, 1.2), Gates_Total[14] = 0;
	else if(Gates_Total[15] == 1) MoveDynamicObject(medgategg[0], -1757.9042, -1998.9915, 1499.7488, 1.2), Gates_Total[15] = 0;
    else if(Gates_Total[16] == 1) MoveDynamicObject(medgategg[1], -1786.7758, -1998.9915, 1499.7488, 1.2), Gates_Total[16] = 0;
    else if(Gates_Total[17] == 1) MoveDynamicObject(medgategg[2], -1773.2739, -1995.1445, 1499.7488, 1.2), Gates_Total[17] = 0;

	if(ServerRestart[1] > 0)
	{
		ServerRestart[1]--;
		if(ServerRestart[1] == 1)
		{
			ServerRestart[1] = 0;
			Maintenance();
		}
	}
	if(ServerRestart[2] > 0)
	{
		ServerRestart[2]--;
		if(ServerRestart[2] == 1)
		{
			ServerRestart[2] = 0;
			GameModeExit();
		}
	}
	if(DeathMatch_Time_Start)
	{
		DeathMatch_Time_Start--;
		format(string, sizeof(string), "TIME: ~w~%s", TimeConverter(DeathMatch_Time_Start));
		TextDrawSetString(CounterSText[12], string);
		if(!DeathMatch_Time_Start) End_MP_DM();
	}
	else if(DeathMatch_Time)
	{
		DeathMatch_Time--;
		if(!DeathMatch_Time) Start_MP_DM();
	}
	if(RACE_TIME_TO_START[0])
	{
	    RACE_TIME_TO_START[0]--;
	    if(!RACE_TIME_TO_START[0])
		{
		    if(RACE_PLAYERS < MIN_RACEPLAYER)
			{
				SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Гоночные мероприятия отменены из-за нехватки количества участников.");
				RACE_PLAYERS = 0, RACE_MAP = 0, RACE_WINNERS = 0;
			}
			else SendClientMessageToAll(COLOR_SERVER, "[Центр развлечений] "WHITE"Гонщики начнут свой старт через 10 секунд."), Start_Race_MP(), RACE_GET_TIME = unix+1, RACE_TIME_TO_START[1] = 10;
		}
	}
	else if(!RACE_START && RACE_TIME_TO_START[1] != 1 && 0 < RACE_GET_TIME < unix)
	{
		Start_Race_MP();
		RACE_GET_TIME = unix+1;
	}

	if(0 < RACE_TIME_TO_FINISH <= unix)
	{
	    foreach(Player, playerid) RaceExit(playerid, 6);
	    RACE_TIME_TO_FINISH = 0;
	}

	if(gAdvertTime > 0) gAdvertTime--;
	for(new i;i<MAX_ADVERT_COUNT;i++)
	{
		if(gAdvert[i][adTime]) gAdvert[i][adTime]--;
		if(gAdvert[i][adCheked] && !gAdvert[i][adTime])
		{
			frac_money[16] += gAdvert[i][adMoney];
			format(string, sizeof(string), "Объявление: %s Прислал: %s. Тел: %d", gAdvert[i][adText], gAdvert[i][adSender], gAdvert[i][adPhone]);
			SendClientMessageToAll(0x00D900C8, string);
			format(string, sizeof(string), "        Отредактировал сотрудник San News: %s", gAdvert[i][adCheker]);
			SendClientMessageToAll(0x00D900C8, string);
			strdel(gAdvert[i][adSender], 0, 24);
			gAdvert[i][adPhone] = 0;
			strdel(gAdvert[i][adText], 0, 100);
			strdel(gAdvert[i][adCheker], 0, 24);
			gAdvert[i][adBusy] = false;
			gAdvert[i][adCheked] = false;
			gAdvert[i][adCheking] = false;
			gAdvert[i][adTime] = 0;
			if(gAdvertCount > 0) gAdvertCount--;
		}
	}
	return 1;
}
Other()
{
	stringer = "";
	strcat(stringer, "{"#cINFO"}  Очередь на экзамен:"WHITE"");
	for(new i;i<20;i++)
	{
		if(gDSTurn[i] != INVALID_PLAYER_ID && !IsPlayerConnected(gDSTurn[i]) || (gDSTurn[i] != INVALID_PLAYER_ID && !pTemp[gDSTurn[i]][pWaitingExam])) gDSTurn[i] = INVALID_PLAYER_ID;
		else if(i != 19 && gDSTurn[i] == INVALID_PLAYER_ID && gDSTurn[i+1] != INVALID_PLAYER_ID)
		{
			gDSTurn[i] = gDSTurn[i+1];
			gDSTurn[i+1] = INVALID_PLAYER_ID;
			if(!i)
			{
				format(string, 128, "%s ожидает Вызова на практический экзамен по вождению", PI[gDSTurn[0]][pNames]);
				foreach(Player, a)
				{
					if(!IsPlayerConnected(a) || !PI[a][pLogin]) continue;
					else if(PI[a][pMember] == 11) SendClientMessage(a, CINFO, string);
				}
			}
		}
		else if(gDSTurn[i] != INVALID_PLAYER_ID) format(stringer, sizeof(stringer), "%s\n%d. %s", stringer, i+1, PI[gDSTurn[i]][pNames]);
	}
	UpdateDynamic3DTextLabelText(gDSTurnText, CWHITE, stringer);
	return 1;
}
publics: DeleteBankReg_TextDraw(playerid)
{
	TextDrawHideForPlayer(playerid, Info_TD[playerid][0]);
	TextDrawHideForPlayer(playerid, Info_TD[playerid][1]);
	TextDrawHideForPlayer(playerid, Info_TD[playerid][2]);
	TextDrawHideForPlayer(playerid, Info_TD[playerid][3]);
	TextDrawHideForPlayer(playerid, Info_TD[playerid][4]);
	return 1;
}
publics: tieTime(playerid)
{
	if(GetPVarInt(playerid, "gag")) return 1;
	DeletePVar(playerid, "gag"), SendClientMessage(playerid, COLOR_GREY, "Кляп стал мокрым и выпал, вы снова можете говорить!");
	return 1;
}
public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    new tickcount1 = GetTickCount(), gstate = GetPlayerState(playerid);
	if(gstate == PLAYER_STATE_DRIVER)
	{
	    new vehicleid=VehicleEnters[playerid];
  		if(vehicleid && newkeys == KEY_SUBMISSION && !PlayerToPoint(50.0, playerid, 516.77, -2315.84, 18.43))
		{
			if(VehInfo[vehicleid][vFuel] <= 1.0 && !VehInfo[vehicleid-1][vEngine]) ErrorMessage(playerid, "В машине нет бензина");
			else ToggleEngine(vehicleid, playerid);
			return 1;
		}
   	}
	if(PRESSED(KEY_NO))
	{
	    if(PlayerToPoint(2.0, playerid, 1164.1655, -1751.9368, 13.5864)) ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Полезная информация", ""WHITE"Заметили баг или недоработку? - "SERVER"/bug\n"WHITE"Меню и путеводитель по серверу - "SERVER"/mm\n"WHITE"Появилась жалоба? Напишите в репорт - "SERVER"/report\n"WHITE"Так-же сейчас действуют "SERVER"ТОПОВЫЕ{FFFFFF} акции - "SERVER"/donate\n"WHITE"Приятной игры на "SERVER"LeanWorld Role Play", "Закрыть", "");
	    if(PlayerToPoint(2.0, playerid, 1164.4988, -1755.2468, 13.5901))
	    {
   			if(PI[playerid][pMember] > 0 || PI[playerid][pLeader] > 0) return ErrorMessage(playerid, "Вы уже состоите в организации.");
   			if(PI[playerid][pPayDayHad] < 2) return ErrorMessage(playerid, "Чтобы вступить во фракцию, требуется отыграть 2 часа.");
			if(PI[playerid][pAdmin] && PI[playerid][pAdmin] != 14) return ErrorMessage(playerid, "Администратор не может вступить в организацию.");
			if(PI[playerid][pWarns] >= 1) return ErrorMessage(playerid, "На Вашем игровом аккаунте присутствует Warn.");
	
			ShowPlayerDialog(playerid, 2005, DIALOG_STYLE_LIST, ""SERVER"Вступить во фракцию", "\
	    	{2641FE}Полиция Лос Сантос\n{313131}ФБР\n{964b00}Армия Авианосец\n{A52A2A}Федеральный госпиталь\n\
			{DDA701}La Cosa Nostra\n{FF0000}Yakuza\n{114D71}Мэрия Лос Сантос\n{114D71}Мэрия Сан Фиерро\n\
			{114D71}Мэрия Лас Вентурас\n{2641FE}Полиция Сан Фиерро\n{FFE7BA}Автошкола\n{8813E7}The Ballas\n\
            {DBD604}Los Santos Vagos\n{B4B5B7}Russian Mafia\n{009F00}Grove Street\n{40848B}San News\n\
			{01FCFF}Varrios Los Aztecas\n{83BFBF}The Rifa\n{964b00}Сухопутные войска\n{964b00}Армия U.S.A\n\
			{2641FE}Полиция Лас Вентурас\n{ffa500}Street Racers Club\n{65A6D1}Байкеры\n{708090}Hitmans\n\
			{4E4A75}S.W.A.T\n{CDED51}Администрация Президента\n{964b00}Военно Морской Флот\n\
			{A52A2A}Больница Сан Фиерро\n{A52A2A}Больница Лас Вентурас", "Далее", "Отмена");
	    }
	    if(PlayerToPoint(2.0, playerid, 1164.4998, -1757.9819, 13.5901))
		{
