cmd:business(playerid)
{
	if(PI[playerid][pBusiness] == -1) return ErrorMessage(playerid, "У вас нету бизнеса.");
	ShowPlayerDialog(playerid, dBusiness, DIALOG_STYLE_LIST, ""SERVER"Управление бизнесом", "1. Статистика бизнеса\n2. Открыть / закрыть бизнес\n3. Продать бизнес\n4. Установка цен\n5. Поставить маркер у входа в бизнес\n6. Касса\n7. Заказать рекламу бизнеса\n8. Заказ продуктов", "Далее", "Отмена");
	return 1;
}
cmd:sellprod(playerid)
{
	if(!GetPVarInt(playerid, "prod_id")) return 1;
 	new bizid = GetPVarInt(playerid, "prod_id")-1;
 	if(!PlayerToPoint(10.0, playerid, BizInfo[bizid][EnterBiz][0], BizInfo[bizid][EnterBiz][1], BizInfo[bizid][EnterBiz][2])) return ErrorMessage(playerid, "Вы не находитесь рядом с бизнесом!");
    new prod = GetPVarInt(playerid, "count_prod");
   	DeletePVar(playerid, "prod_id");
    DeletePVar(playerid, "count_prod");


    SendClientMessage(playerid, -1, ""#good"Продукты в бизнес доставлены:");
    format(string, 128, ""#information"Доставлено: %d продуктов. Заработано: %d$", prod, (BizInfo[bizid][bProdOrderPrice]*prod));
    SendClientMessage(playerid, -1, string);
    SendClientMessage(playerid, -1, ""#information"Чтобы доставить продукты к еще одному бизнесу следуйте за маркером на мини-карте");

    SetPlayerRaceCheckpoint(playerid, 1, -116.87, -320.27, 1.42, 0.0, 0.0, 0.0, 5.0);

	UpdateDynamic3DTextLabelText(gPlayerProdText[playerid][0], 0xFFFFFF20, "{f0f0f0}[Продуктов: 0/1000]\n{5DD174}Бизнес: Не выбран");
    DestroyDynamic3DTextLabel(gPlayerProdText[playerid][1]);
    DestroyDynamicCP(gPlayerProdCP[playerid]);

	Hook_GivePlayerMoney(playerid, (BizInfo[bizid][bProdOrderPrice]*prod));

	BizInfo[bizid][bProdOrder] -= prod;
	BizInfo[bizid][bProd] += prod;
	SaveBusiness(bizid);

	return 1;
}
cmd:mutelist(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;

	new countmute = 0, mutes[1030], str[130];
	foreach(new i:Player)
	{
		if(!PI[i][pLogin] || !IsPlayerConnected(i)) continue;
		if(PI[i][pMuteTime] > 0)
		{
			format(str, sizeof(str), ""WHITE"%d. "SERVER"%s"WHITE" | ID: "SERVER"%d"WHITE" | Секунд: "SERVER"%d\n",countmute+1,PI[i][pNames], i, PI[i][pMuteTime]),strcat(mutes,str);
			countmute++;
		}
	}
	if(countmute == 0) return SCM(playerid, COLOR_WHITE, ""#net"Нет игроков с баном чата");
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Игроки с баном чата", mutes, "Закрыть", "");
	return 1;
}
cmd:jailed(playerid)
{
	if(!GetAccessAdmin(playerid, 3))
		return true;
	new time, players_jail, players_prison;
	string = "";
	foreach(Player, i)
	{
	    if(PI[i][pJailTime] > 0 || PI[i][pPrisonTime] > 0)
	    {
			if(PI[i][pJailTime] > 0) time = PI[i][pJailTime], players_jail++;
			else if(PI[i][pPrisonTime] > 0) time = PI[i][pPrisonTime], players_prison++;
	        format(string, sizeof(string), "%s{FF0000}%s | "SERVER"%s[%i] "WHITE"осталось сидеть "SERVER"%s\n", string, (PI[i][pJailTime] ? ("JAIL") : ("PRISON")), PI[i][pNames], i, TimeConverter(time));
		}
	}
	if(!players_jail && !players_prison) format(string, sizeof(string), ""WHITE"Игроки в тюрьме и prison отсутствуют.", string);
	format(string, sizeof(string), "%s\n"WHITE"Игроков в тюрьме: "SERVER"%i\n"WHITE"Игроков в prison: "SERVER"%i", string, players_jail, players_prison);
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Игроков в тюрьме", string, "Выход", "");
	return 1;
}
cmd:timestat(playerid)
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	format(string, sizeof(string), "Последнее время прокрутки \"newkeys\": (%d ms). пик: (%d ms).", time_newkeys, time_newkeys_max);
	ShowPlayerDialog(playerid, 0, 0, ""SERVER"Нагрузка мода", string, "Okey", "");
	return 1;
}
