SaveGZ(i)
{
	mysql_format(1, string, sizeof(string), "UPDATE `gangzone` SET `gFrakVlad` = '%i' WHERE `gID` = '%i'", GZInfo[i][gFrakVlad], i);
	mysql_tquery(1, string);
	return 1;
}
SaveGZLogo(i)
{
	mysql_format(1, string, sizeof(string), "UPDATE `gzlogo` SET `Owner_1` = '%i', `Owner_2` = '%i' WHERE `ID` = '%d'", GZLogoInfo[i][gOwner][0], GZLogoInfo[i][gOwner][1], i+1);
	mysql_tquery(1, string);
	return 1;
}

