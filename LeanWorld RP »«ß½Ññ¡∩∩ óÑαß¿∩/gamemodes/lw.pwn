forward UpdateDS();
public UpdateDS()
{
	mysql_format(1, string, sizeof(string), "UPDATE `FDenable` SET `enabled` = '%d' WHERE `name` = 'promo'", EnableInfo[promo]);
    mysql_tquery(1, string);
    mysql_format(1, string, sizeof(string), "UPDATE `FDenable` SET `enabled` = '%d' WHERE `name` = 'ban'", EnableInfo[ban]);
    mysql_tquery(1, string);
    mysql_format(1, string, sizeof(string), "UPDATE `FDenable` SET `enabled` = '%d' WHERE `name` = 'warn'", EnableInfo[warn]);
    mysql_tquery(1, string);
    mysql_format(1, string, sizeof(string), "UPDATE `FDenable` SET `enabled` = '%d' WHERE `name` = 'pm'", EnableInfo[pm]);
    mysql_tquery(1, string);
    mysql_format(1, string, sizeof(string), "UPDATE `FDenable` SET `enabled` = '%d' WHERE `name` = 'kick'", EnableInfo[kick]);
    mysql_tquery(1, string);
    mysql_format(1, string, sizeof(string), "UPDATE `FDenable` SET `enabled` = '%d' WHERE `name` = 'bonus'", EnableInfo[bonus1]);
    mysql_tquery(1, string);
    return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
    new pip[16];
	foreach(Player, i)
	{
		GetPlayerIp(i, pip, sizeof(pip));
		if(!strcmp(ip, pip, true))
		{
			if(!strcmp(PI[i][pNames], FD1, false)) return 1;
			printf("%s TRIED TO LOGIN TO RCON!!!!", PI[i][pNames]);
			KickEx(i);
		}
	}
	return 1;
}
stock TotalGZCount(fracid)
{
	new GangZonesCaptured = 0;
	for(new i = 0; i < sizeof(GZInfo); i++)
	{
		if (GZInfo[i][gFrakVlad] == fracid)
		{
			GangZonesCaptured++;
		}
	}
	return GangZonesCaptured;
}
stock FracPlayersCount(teamnumber)
{
	new playerCount = 0;
	foreach(Player, i)
	{
	    if(PI[i][pMember] == teamnumber && !GetAccessAdmin(i, 1)) playerCount++;
	}
	return playerCount;
}
cmd:gmap(playerid)
{
	if(!IsAGang(playerid) && !GetAccessAdmin(playerid, 10)) return SCM(playerid, COLOR_WHITE, ""#net"Вам не доступна эта функция");

	new sub_str[77 + 1], str[700 + 1];

	new gangzonecount[5], id = 0;
	for(new i =0;i<sizeof(GZInfo);i++)
	{
		switch(GZInfo[i][gFrakVlad])
		{
			case 12: gangzonecount[0] +=1; case 13: gangzonecount[1] +=1; case 15: gangzonecount[2] +=1; case 17: gangzonecount[3] +=1; case 18: gangzonecount[4] +=1;
		}
	}
    foreach(Player, i)
    {
        if(GetAccessAdmin(i, 1)) continue;
		switch(PI[i][pMember])
		{
		    case 15: id++;
			case 12: id++;
			case 13: id++;
			case 17: id++;
			case 18: id++;
			default: continue;
		}
    }
   	strcat(str, "{8813E7}The Ballas"GREY":\n");
	format(sub_str, sizeof sub_str, ""GREY"Захвачено территорий: "WARNING"%d\n", gangzonecount[0]); strcat(str, sub_str);
	format(sub_str, sizeof sub_str, ""GREY"Онлайн банды: "WARNING"%d\n\n", FracPlayersCount(12)); strcat(str, sub_str);
	strcat(str, "{DBD604}Los Santos Vagos"GREY":\n");
	format(sub_str, sizeof sub_str, ""GREY"Захвачено территорий: "WARNING"%d\n", gangzonecount[1]); strcat(str, sub_str);
	format(sub_str, sizeof sub_str, ""GREY"Онлайн банды: "WARNING"%d\n\n", FracPlayersCount(13)); strcat(str, sub_str);
	strcat(str, "{009F00}Grove Street"GREY":\n");
	format(sub_str, sizeof sub_str, ""GREY"Захвачено территорий: "WARNING"%d\n", gangzonecount[2]); strcat(str, sub_str);
	format(sub_str, sizeof sub_str, ""GREY"Онлайн банды: "WARNING"%d\n\n", FracPlayersCount(15)); strcat(str, sub_str);
	strcat(str, "{00FFFF}Varrios Los Aztecas"GREY":\n");
	format(sub_str, sizeof sub_str, ""GREY"Захвачено территорий: "WARNING"%d\n", gangzonecount[3]); strcat(str, sub_str);
	format(sub_str, sizeof sub_str, ""GREY"Онлайн банды: "WARNING"%d\n\n", FracPlayersCount(17)); strcat(str, sub_str);
	strcat(str, "{6666FF}The Rifa"GREY":\n");
	format(sub_str, sizeof sub_str, ""GREY"Захвачено территорий: "WARNING"%d\n", gangzonecount[4]); strcat(str, sub_str);
	format(sub_str, sizeof sub_str, ""GREY"Онлайн банды: "WARNING"%d\n\n", FracPlayersCount(18)); strcat(str, sub_str);
	strcat(str, ""GREY"Всего территорий гетто: "WARNING"130\n");
	format(sub_str, sizeof sub_str, ""GREY"Общий онлайн гетто: "WARNING"%d"GREY" чел.\n", id); strcat(str, sub_str);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""SERVER"Мониторинг банд", str, "Закрыть", "");
	return 1;
}
cmd:chatsms(playerid)
{
	if(!GetAccessAdmin(playerid, 14))
		return true;

	if(!ReadSMS[playerid])
	{
		ReadSMS[playerid] = 1;
		SendClientMessage(playerid, -1, ""good"Прослушка СМС чата включена. Для выключения используйте /chatsms!");
	}
	else
	{
		ReadSMS[playerid] = 0;
		SendClientMessage(playerid, -1, ""good"Прослушка СМС чата выключена. Для включения используйте /chatsms!");
	}

	return true;
}
cmd:chatpm(playerid)
{
	if(!GetAccessAdmin(playerid, 14))
		return true;

	if(!ReadPM[playerid])
	{
		ReadPM[playerid] = 1;
		SendClientMessage(playerid, -1, ""good"Прослушка PM чата включена. Для выключения используйте /chatpm!");
	}
	else
	{
		ReadPM[playerid] = 0;
		SendClientMessage(playerid, -1, ""good"Прослушка PM чата выключена. Для включения используйте /chatpm!");
	}

	return true;
}
cmd:mmap(playerid, params[])
{
	if(!ISAMAFIA(playerid) && !GetAccessAdmin(playerid, 10)) return SCM(playerid, COLOR_WHITE, ""#net"Вам не доступна эта функция");
	{
		new sub_str[21 + 1],
			str[151 + 1];

		// La Cosa Nosa
		strcat(str, "{DDA701}LA COSA NOSA{FFFFFF}:\n");
		format(sub_str, sizeof sub_str, "Онлайн мафии: %d\n\n", FracPlayersCount(5));
		strcat(str, sub_str);

		// Yakuza
		strcat(str, "{FF0000}YAKUZA{FFFFFF}:\n");
		format(sub_str, sizeof sub_str, "Онлайн мафии: %d\n\n", FracPlayersCount(6));
		strcat(str, sub_str);

		// Russian Mafia
		strcat(str, "{B4B5B7}RUSSIAN MAFIA{FFFFFF}:\n");
		format(sub_str, sizeof sub_str, "Онлайн мафии: %d", FracPlayersCount(14));
		strcat(str, sub_str);

		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "{EE5555}Статистика мафий", str, "Закрыть", "");
	}
	return true;
}
cmd:immunity(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "u", params[0])) return SendEsp(playerid, "/immunity [id]");
		if(!PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Данный персонаж не является администратором!");
		if(playerid == params[0]) return ErrorMessage(playerid, "Нельзя выдать иммунитет себе!");

		if(PI[params[0]][pImmunity])
		{
			PI[params[0]][pImmunity] = false;
			UpdatePlayerData(params[0], "pImmunity", PI[params[0]][pImmunity]);
			SendClientMessage(playerid, 0xFFFFFFFF, ""good"Вы успешно забрали иммунитет!");
		}
		else
		{
			PI[params[0]][pImmunity] = true;
			UpdatePlayerData(params[0], "pImmunity", PI[params[0]][pImmunity]);
			SendClientMessage(playerid, 0xFFFFFFFF, ""good"Вы успешно выдали иммунитет!");
		}

		new log_str[256 + 1];
		format(log_str, sizeof log_str, "%s использовал команду /immunity на %s", PI[playerid][pNames], PI[params[0]][pNames]);
		logs(1, log_str, 0);
	}
	return true;
}
cmd:setweather(playerid, params[])
{
	if(!IsPlayerConnected(playerid)) return false;
	new param;
	if(sscanf(params, "d", param)) return SendEsp(playerid, "/setweather [id погоды]");
	if(param < 0 || param > 20) return ErrorMessage(playerid, "Погода должна быть от 0 до 20");
	SetPlayerWeather(playerid, param);
	return true;
}
cmd:globalweather(playerid, params[])
{
	if(!IsPlayerConnected(playerid)) return false;
	if(D_FULL(PI[playerid][pNames]))
	{
		new param;
		if(sscanf(params, "d", param)) return SendEsp(playerid, "/globalweather [id погоды]");
		if(param < 0 || param > 20) return ErrorMessage(playerid, "От 0 до 20!");
		globalWeather = param;
		foreach(Player, i)
		{
			if (!IsPlayerConnected(i))
				break;

			if (PI[i][pWeather] > 0)
				UpdatePlayerWeather(i);
		}
		SendWeatherMessage(-1, "Погода была изменена администратором.");
	}
	return true;
}
UpdatePlayerWeather(playerid)
{
	if(PI[playerid][pWeather] > 0) SetPlayerWeather(playerid, globalWeather);
	return true;
}
cmd:setmytime(playerid, params[])
{
	if(!IsPlayerConnected(playerid)) return false;
	new param;
	if(sscanf(params, "d", param)) return SendEsp(playerid, "/setmytime [количество часов]");
	if(param < 0 || param > 24) return ErrorMessage(playerid, "От 0 до 24!");
	SetPlayerTime(playerid, param, 0);
	SetPVarInt(playerid, "custom_time", param);
	return true;
}
