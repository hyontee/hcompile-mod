islegalcarmod(vehicleide, componentid) {

	new modok = false;
	if((iswheelmodel(componentid)) || (componentid == 1086) || (componentid == 1087) || ((componentid >= 1008) && (componentid <= 1010)))
	{
		new nosblocker = IllegalCarNitroIde(vehicleide);
		if(!nosblocker) modok = true;
	}
	else
	{
		for(new I = 0; I != 48; ++I) if (legalmods[I][0] == vehicleide)
  		{
			for(new J = 1; J < 22; J++) if(legalmods[I][J] == componentid) modok = true;
		}
	}
	return modok;
}

AC_AddVehicleComponent(vehicleid, componentid)
{
	new vehicleide = GetVehicleModel(vehicleid);
	new modok = islegalcarmod(vehicleide, componentid);
	if (!modok) return 0;
	AddVehicleComponent(vehicleid, componentid);
	return 1;
}
iswheelmodel(modelid) {

	new wheelmodels[17] = {1025, 1073, 1074, 1075, 1076, 1077, 1078, 1079, 1080, 1081, 1082, 1083, 1084, 1085, 1096, 1097, 1098};
	for (new I = 0; I != 17; ++I)  {

		if (modelid == wheelmodels[I])
			return true;

	}

	return false;
}

IllegalCarNitroIde(carmodel) {

	new illegalvehs[29] = { 581, 523, 462, 521, 463, 522, 461, 448, 468, 586, 509, 481, 510, 472, 473, 493, 595, 484, 430, 453, 452, 446, 454, 590, 569, 537, 538, 570, 449 };
	for (new I = 0; I != 29; ++I)  {

		if (carmodel == illegalvehs[I])
			return true;

	}
	return false;
}
forward MinusTimer( playerid, Nara );
public MinusTimer( playerid, Nara )
{
	new Float:health;
	GetPlayerHealth(playerid, health);
	new p_Bed = Nara;
	if(MyBed[ playerid ] != 255 )
	{
		if(health < 100.0) SetPlayerHealth(playerid, health + 3.0);
		format( string, sizeof( string ), "{FFFFFF}Койка №%d\n\n{FFD700}Пациент: %s", p_Bed+1, PI[playerid][pNames]);
		Update3DTextLabelText( Bed3D[ p_Bed ], 0xFFFFFF20, string );
		GameTextForPlayer(playerid, "~g~~h~+3HP", 1000, 4);
	}
	if(health >= 100.0)
	{
		KillTimer( PlayerTimerBolk[ playerid ] );
		if(MyBed[ playerid ] != 255 )
		{
			BedInfo[ p_Bed ][ Busy ] = false;
			ClearAnimations( playerid );
			DeletePVar(playerid, "pHospital");
			MyBed[ playerid ] = 255;
			TogglePlayerControllable(playerid, 1);
			SetPlayerDrunkLevel( playerid, 0 );
			format( string, sizeof( string ), "{FFFFFF}Койка №%d\n{33AA33}Свободна\n\n{AFAFAF}Используйте /heal чтобы занять её", p_Bed+1);
			Update3DTextLabelText( Bed3D[ p_Bed ], 0xFFFFFF20, string );
			SendClientMessage(playerid, -1, ""#information"Вы прошли полный курс лечения!");
			SendClientMessage(playerid, -1, ""#information"Теперь вы можете покинуть больницу!");
			p_Bed = 0;
		}
	}
	return 1;
}
