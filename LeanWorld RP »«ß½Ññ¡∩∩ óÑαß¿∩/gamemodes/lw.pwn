Hook_GivePlayerMoney(playerid, amount)
{
    new strm[50];
	if(amount != PI[playerid][pCash])
	PI[playerid][pCash] += amount;
	format(strm, 15, "~w~%d$", amount);
	GameTextForPlayer(playerid, strm, 5000, 1);
	return GivePlayerMoney(playerid, amount);
}
