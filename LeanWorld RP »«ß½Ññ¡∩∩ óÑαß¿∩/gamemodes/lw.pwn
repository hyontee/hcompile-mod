		format(string, 64, "Офицер %s снял с Вас уровни розыска.", PI[playerid][pNames]);
		SendClientMessage(params[0], 0x6ab1ffaa, string);
		PI[params[0]][pWanted] = 0;
		SetPlayerWantedLevel(params[0], 0);
		UpdatePlayerData(params[0], "pWanted", PI[params[0]][pWanted]);
	}
