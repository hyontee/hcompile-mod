cmd:gbank(playerid)
{
	if(!IsAGang(playerid)) return 1;
	SCMF(playerid, COLOR_SERVER, "В банке %s: %d вирт", FI[PI[playerid][pMember]][fName], frac_money[PI[playerid][pMember]]);
	return 1;
}
cmd:shield(playerid)
{
	if(!IsACop(playerid) && !IsAArm(playerid)) return ErrorMessage(playerid, "Вы не Полицейский/Военный/ФБР");
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(!GetPVarInt(playerid, "shield"))
	{
		SetPlayerAttachedObject(playerid, 1, 18637, 14, 0.0, 0.0, 0.0, 0.0, 180.0, 180.0);
		SetPlayerArmourAC(playerid, 100);
		SetPVarInt(playerid, "shield", 1);
		return 1;
	}
	RemovePlayerAttachedObject(playerid, 1);
	SetPlayerArmourAC(playerid, 0);
	DeletePVar(playerid, "shield");
	return 1;
}
cmd:ceject(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/ceject [id игрока]");
	if(!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с вами!");
	if(PI[playerid][pMember] == 1 || PI[playerid][pMember] == 2 || PI[playerid][pMember] == 10 || PI[playerid][pMember] == 21 || PI[playerid][pMember] == 25)
	{
		if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
		if(PlayerToPoint(10, playerid, 1568.2023, -1694.1594, 5.8906))
		{
			SetPlayerInterior(params[0], 6);
			SetPlayerPos(params[0], 253.9933, 86.9706, 1002.4453);
			SetPlayerFacingAngle(params[0], 278.0311);
		}
		if(PlayerToPoint(10, playerid, -1590.8289, 716.0479, -5.2422))
		{
			SetPlayerInterior(params[0], 10);
			SetPlayerPos(params[0], 217.3147, 121.3382, 999.0156);
			SetPlayerFacingAngle(params[0], 272.8898);
		}
		if(PlayerToPoint(10, playerid, 2295.1934, 2451.8459, 10.8203))
		{
			SetPlayerInterior(params[0], 3);
			SetPlayerVirtualWorld(params[0], 122);
			SetPlayerPos(params[0], 238.5033, 141.1578, 1003.0234);
			SetPlayerFacingAngle(params[0], 359.1617);
		}
		else return SendClientMessage(playerid, 0x6ab1ffaa, "Вы затолкали приступника в участок.");
	}
	return 1;
}
cmd:withdraw(playerid, params[])
{
	if(PlayerToPoint(10.0, playerid, 1296.6184, -1352.8342, 19.0469))
	{
		if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/withdraw [Сумма]");
		if(PI[playerid][pMember] >= 0)
		{
			if(params[0] < 1 || params[0] > 10000000000) return ErrorMessage(playerid, "Нельзя снять 1 вирта и более 10000000000!");
			if(PI[playerid][pBank] < params[0]) return ErrorMessage(playerid, "У вас нет столько денег!");
			Hook_GivePlayerMoney(playerid, params[0]);
			PI[playerid][pBank] -= params[0];
			UpdatePlayerData(playerid, "pBank", PI[playerid][pBank]);
			SCMF(playerid, COLOR_SERVER, "Вы сняли %d вирт. Остаток: %d вирт", params[0], PI[playerid][pBank]);
		}
	}
	return 1;
}
alias:live("l");
cmd:live(playerid, params[])
{
	new newcar = VehicleEnters[playerid];
	switch(PI[playerid][pMember])
	{
	case 16:
		{
			if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
			if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!");
			if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У Вас бан чата!");
			if(newcar >= lsnewscar[0] && newcar <= lsnewscar[1] || PlayerToPoint(30.0, playerid, 998.2922, 999.8779, 1999.7999)) { } else { ErrorMessage(playerid, "Вы не в репортёрской машине / вертолёте / офисе!"); return 1;}
			if(GetPVarInt(playerid, "TalkingLivels") != 999)
			{
				SendClientMessage(playerid, 0x6ab1ffaa, "Прямой эфир завершён");
				SendClientMessage(GetPVarInt(playerid, "TalkingLivels"), 0x6ab1ffaa, "Прямой эфир завершён");
				TogglePlayerControllable(playerid, 1);
				TogglePlayerControllable(GetPVarInt(playerid, "TalkingLivels"), 1);
				SetPVarInt(GetPVarInt(playerid, "TalkingLivels"), "TalkingLives", 999);
				SetPVarInt(playerid, "TalkingLivels", 999);
				return 1;
			}
			if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/live [id]");
			if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете брать интервью у себя!");
			if (ProxDetectorS(5.0, playerid, params[0])){} else return ErrorMessage(playerid, "Человек далеко от вас!");
			if(params[0] == INVALID_PLAYER_ID) return ErrorMessage(playerid, "Человек не найден!");
			SCMF(playerid, 0x6ab1ffaa, "Вы предложили %s снять интервью", PI[params[0]][pNames]);
			SCMF(params[0], 0x6ab1ffaa, "%s предлагает вам снять интервью", PI[playerid][pNames]);
			SendClientMessage(params[0], COLOR_GREY, "Введите /accept livels, чтобы согласиться");
			SetPVarInt(params[0], "LiveOfferls", playerid);
		}
	}
	return 1;
}
cmd:n(playerid)
{
	if(GetVehicleModel(VehicleEnters[playerid]) != 582 && GetVehicleModel(VehicleEnters[playerid]) != 488 && !PlayerToPoint(30.0, playerid, 286.5744, -1614.6272, 96.4978)) return ErrorMessage(playerid, "Вы не в служебном транспорте/офисе!");
	if(PI[playerid][pMember] == 16) return ShowPlayerDialog(playerid, 2224, DIALOG_STYLE_LIST, ""SERVER"[ NEWS MENU ]", ""WHITE"[1] Эфиры\n[2] Прием звонков ( Начать )\n[3] Прием звонков ( Завершить )\n[4] Установить цену за Звонки и SMS", "Далее", "Отмена");
	return 1;
}
cmd:selldrugs(playerid, params[])
{
	if(sscanf(params, "ddd", params[0], params[1], params[2])) return SendEsp(playerid, "/selldrugs [id] [Число] [Цена]");
	if(params[1] < 1 || params[1] > 150) return ErrorMessage(playerid, "Вес не может быть меньше 1 и больше 150!");
	if(params[2] < 1 || params[2] > 5000) return ErrorMessage(playerid, "Цена не может быть меньше 1 и больше $5000!");
	if(params[1] > PI[playerid][pDrugs]) return ErrorMessage(playerid, "У вас нету столько наркотиков!");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Этот Человек далеко от вас!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете продать себе наркотики!");
	SCMF(playerid, 0x6ab1ffaa, "Вы предложили %s купить %d грамм наркоты за %d вирт", PI[params[0]][pNames], params[1], params[2]);
	SCMF(params[0], 0x6ab1ffaa, "Бандит %s предлагает вам купить %d грам наркоты за %d вирт. (( Введите /accept drugs для покупки ))", PI[playerid][pNames], params[1], params[2]);
	SetPVarInt(params[0], "DrugOffer", playerid);
	SetPVarInt(params[0], "DrugPrice", params[2]);
	SetPVarInt(params[0], "DrugGram", params[1]);
	return 1;
}
cmd:fuelcars(playerid)
{
	if(GetAccessAdmin(playerid, 5))
	{
		for(new i = 1, j = GetVehiclePoolSize(); i <= j; i++) VehInfo[i][vFuel] = 200.0;
		string = "";
		format(string, 80, "Администратор %s заправил весь транспорт!", PI[playerid][pNames]);
		SendClientMessageToAll(COLOR_WARNING, string);
	}
	return 1;
}
cmd:bizwar(playerid)
{
	new t; gettime(t);
	if(t < 12 || t > 22 ) return SendClientMessage(playerid, 0xAFAFAFAA, "Использовать команду можно только с 12:00 до 22:00");
	if(!ISAMAFIA(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Вам не доступна данная команда.");
	if(BizWarTime > unix) return SendClientMessage(playerid, COLOR_WHITE, "Война за бизнес уже идет.");
	if(MafiaCapture[PI[playerid][pMember]]) return ErrorMessage(playerid, "Стрелы за бизнес проходят раз в час!");
	if(PI[playerid][pMember] == 5 && PI[playerid][pRank] < 7 || PI[playerid][pMember] == 6 && PI[playerid][pRank] < 7 || PI[playerid][pMember] == 14 && PI[playerid][pRank] < 7) return SCM(playerid, COLOR_WHITE, "Вам не доступна данная команда.");
	ShowPlayerDialog(playerid, 18, DIALOG_STYLE_LIST, ""SERVER"Выберите место войны", "\
		"SERVER"1."WHITE" Лесопилка\n\
		"SERVER"2."WHITE" Завод\n\
		"SERVER"3."WHITE" Железная дорога", "Выбрать", "Отмена");
	return 1;
}
cmd:bizlist(playerid, params[])
{
	if(!ISAMAFIA(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Вам не доступна данная команда.");
	string = "";
	for(new i = 1; i <= BIZES; i++)
	{
		if(BizInfo[i][bKrisha] != PI[playerid][pMember]) continue;
		format(stringer, 100, ""WHITE"%i. %s\n", i, BizInfo[i][bName]); strcat(string, stringer);
	}
	ShowPlayerDialog(playerid, 1019, DIALOG_STYLE_MSGBOX, ""SERVER"Бизнесы под контролем", string, "Выход", "");
	return 1;
}
cmd:setskill(playerid, params[])
{
	if (!GetAccessAdmin(playerid, 5))
		return true;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, "Введите: /setskill [id]");
	if(!IsPlayerConnected(params[0])) return 1;
	for(new i = 0; i != 6; i++) PI[params[0]][pSkills][i] = 100;
	string = "";
	mysql_format(1, string, 210, "UPDATE `accounts` SET `pSDPistol` = '%d', `pDesertEagle` = '%d', `pShotGun` = '%d', `pMP5` = '%d', `pAK47` = '%d', `pM4` = '%d' WHERE `id` = '%d'",
	PI[params[0]][pSkills][0], PI[params[0]][pSkills][1], PI[params[0]][pSkills][2], PI[params[0]][pSkills][3], PI[params[0]][pSkills][4], PI[params[0]][pSkills][5], PI[playerid][pID]);
	mysql_tquery(1, string);
	SendClientMessage(playerid, COLOR_SERVER, "Вы успешно выдали скиллы!");
	SendClientMessage(params[0], COLOR_SERVER, "Администратор выдал вам скиллы!");
	return 1;
}
cmd:slap(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 2))
		return true;
	//if(gAdminReason[playerid][ADMIN_SLAP]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/slap [id]");
	new Float:shealth;
	new Float:slx, Float:sly, Float:slz;
	if(!IsPlayerConnected(params[0])) return 1;
	GetPlayerHealth(params[0], shealth);
	SetPlayerHealth(params[0], shealth-5);
	GetPlayerPos(params[0], slx, sly, slz);
	SetPlayerPos(params[0], slx, sly, slz+5);
	PlayerPlaySound(params[0], 1130, slx, sly, slz+5);
	string = "";
	format(string, MAX_STR, "Администратор %s подкинул игрока %s", PI[playerid][pNames], PI[params[0]][pNames]);
	SendAdminMessage(COLOR_GRAD1, string);
	return 1;
}
cmd:astats(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1)) return true;
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/astats [id]");
	if(!IsPlayerConnected(params[0])) return 1;
	mysql_format(1, string, 200, "SELECT * FROM `admin` WHERE `Name` = '%e' LIMIT 1", PI[params[0]][pNames]);
	mysql_tquery(1, string, "OnCheckStatsAdmin", "is", playerid, PI[params[0]][pNames]);
	return 1;
}
cmd:lstats(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 10)) return true;
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/lstats [id]");
	if(!IsPlayerConnected(params[0])) return 1;
	if(PI[params[0]][pLeader] == 0) return SCM(playerid, COLOR_RED, "Игрок не является лидером");
	mysql_format(1, string, 200, "SELECT * FROM  `accounts` WHERE `Name` = '%e' LIMIT 1", PI[params[0]][pNames]);
	mysql_tquery(1, string, "OnCheckStatsLeader", "is", playerid, PI[params[0]][pNames]);
	return 1;
}
cmd:hhelp(playerid)
{
	if(!PI[playerid][pHelper]) return 1;
	if(PI[playerid][pHelper]) return SendClientMessage(playerid, COLOR_SERVER, "/ans, /hc, /hpanel");
	return 1;
}
cmd:makehelper(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(!IsPlayerConnected(playerid) || !PI[playerid][pLogin]) return 1;
	if(gAdminReason[playerid][ADMIN_MAKEHELPER]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "dd", params[0], params[1])) return SendEsp(playerid, "/makehelper [ID] [0-1]");
	if(!IsPlayerConnected(params[0])) return 1;
	if(params[1] < 0 || params[1] > 1) return ErrorMessage(playerid, "Не меньше '0' и не больше '1'.");
	if(0 == params[1]) PI[params[0]][pHelperAns] = 0, UpdatePlayerData(params[0], "pHelperAns", 0);
	PI[params[0]][pHelper] = params[1];
	UpdatePlayerData(params[0], "pHelper", PI[params[0]][pHelper]);
	SCMF(params[0], 0x6495EDFF, "Вы были назначены помощником уровня %d Администратором %s.", params[1], PI[playerid][pNames]);
	SCMF(playerid, COLOR_WHITE, "Вы назначили %s помощником %d уровня", PI[params[0]][pNames], params[1]);
	SendClientMessage(params[0], COLOR_WHITE, ""#information"Чтобы посмотреть команды, введите /hhelp");

	new str[90];
	format(str, sizeof(str), "выдал хелперку");
	AddaLog(PI[playerid][pNames], str, PI[params[0]][pNames], "", "", "");

	return 1;
}
cmd:trailer(playerid)
{
	if(PI[playerid][pMember] != 1 && PI[playerid][pJob] != 1) return ErrorMessage(playerid, "Вам не доступна данная функция.");
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(!IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "Вам нужно быть в автомобиле!");
	if(GetVehicleModel(VehicleEnters[playerid]) != 525) return ErrorMessage(playerid, "Вам нужно быть в эвакуаторе!");
	if(GetPlayerState(playerid)!=2)return ErrorMessage(playerid, "Вам нужно быть за рулём!");
	new Float:pX, Float:pY, Float:pZ;
	GetPlayerPos(playerid, pX, pY, pZ);
	new Float:vX, Float:vY, Float:vZ;
	for(new vid = GetVehiclePoolSize(); vid >= 0; vid--)
	{
		GetVehiclePos(vid, vX, vY, vZ);
		if ((floatabs(pX-vX)<7.0)&&(floatabs(pY-vY)<7.0)&&(floatabs(pZ-vZ)<7.0)&&(vid!=VehicleEnters[playerid]))
		{
			if(IsTrailerAttachedToVehicle(VehicleEnters[playerid])) DetachTrailerFromVehicle(VehicleEnters[playerid]);
			else AttachTrailerToVehicle(vid, VehicleEnters[playerid]);
			if(GetPVarInt(playerid, "JOB_LSPD_1") == 1 && GetPVarInt(playerid, "JOB_LSPD_CAR") != -1 && vid == Car_V[GetPVarInt(playerid, "JOB_LSPD_CAR")])
			{
			    SetPlayerCheckpoint(playerid, 1596.0675, -1694.3757, 5.8906, 3.0);
			    SendClientMessage(playerid, -1, ""#information"Вы зацепили нужный автомобиль! Везите его в гараж департамента г.Los-Santos!");
			    SetPVarInt(playerid, "JOB_LSPD_1", 2);
			}
			return 1;
		}
	}
	SendClientMessage(playerid, 0xFFFF00AA, "Рядом нет автомобиля");
	return 1;
}
cmd:untrailer(playerid)
{
	if(PI[playerid][pMember] == 1 && !GetPVarInt(playerid, "StartRabWork") && StartRabWork(playerid)) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	new vehplid=VehicleEnters[playerid];
	DetachTrailerFromVehicle(vehplid);
	SendClientMessage(playerid, 0x6ab1ffaa, "Вы отцепили автомобиль");
	return 1;
}
cmd:skin(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 2))
		return true;
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/skin [id скина]");
	if(params[0] > 311 || params[0] < 1) return ErrorMessage(playerid, "Неправильный ID скина!");
	if(params[0] == 74 || params[0] == 0) return 1;
	PI[playerid][pChar] = params[0];
	string = "";
	mysql_format(1, string, 144, "UPDATE `accounts` SET `pChar` = '%i' WHERE `id` = '%d'", PI[playerid][pChar], PI[playerid][pID]);
	mysql_tquery(1, string);
	SetPlayerSkin(playerid, PI[playerid][pChar]);
	PlayerPlaySound(playerid, 1132, 0.0, 0.0, 0.0);
	return 1;
}
alias:suspect("su");
cmd:suspect(playerid, params[])
{
	if(!IsACop(playerid)) return ErrorMessage(playerid, "Вы должны быть полицейским!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1, ""#information"Используйте: /su [ID]");
	if(!IsPlayerConnected(params[0]) || params[0] == playerid || params[0] == INVALID_PLAYER_ID) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(PI[params[0]][pJailTime]>0) return SendClientMessage(playerid, COLOR_GRAD2, ""#net"Человек в тюрьме!");
	if(IsACop(params[0])) return ErrorMessage(playerid, "Вы не можете давать розыск законникам!");
	if(PlayerTied{playerid}) return ErrorMessage(playerid, "Вы связаны!");
	SuspectList[ItemsSuspect] = 0; ItemsSuspect = 0; string = "";
	for(new i;i!=sizeof(sSuspect);i++) format(string, 500, "%s"SERVER"%d."WHITE" %s\n", string, i+1, sSuspect[i][sNames]), SuspectList[ItemsSuspect] = i, ItemsSuspect++;
	ShowPlayerDialog(playerid, 9681, DIALOG_STYLE_LIST, PI[params[0]][pNames], string, "Далее", "Отмена");
	SetPVarInt(playerid, #id_suspect, params[0]);
	return 1;
}
alias:wi("w");
cmd:wi(playerid, params[])
{
	if(PI[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас бан чата");
	if(sscanf(params, "s[128]", params[0])) return ErrorMessage(playerid, "/w [текст]");
	string = "";
	format(string, MAX_STR, "%s шепчет: %s", PI[playerid][pNames], params[0]);
	sendLongMessage(playerid, string, 0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA, 3.0);
	SetPlayerChatBubble(playerid, params[0], 0xAAAAAAAA, 3.0, 5000);
	return 1;
}
alias:shout("s");
cmd:shout(playerid, params[])
{
	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!");
	if(PI[playerid][pMuteTime]) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас бан чата");
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "(/s)hout [текст]");
	if(!Reklama(playerid, params[0])) return 1;
	string = "";
	format(string, 200, "%s[%d] кричит: %s", PI[playerid][pNames], playerid, params[0]);
	sendLongMessage(playerid, string, 0xE6E6E6E6, 0xE6E6E6E6, 0xC8C8C8C8, 0xAAAAAAAA, 0x8C8C8C8C, 35.0);
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) { if(!GetPVarInt(playerid, "PlayerCuffed") ) {   ApplyAnimation(playerid, "ON_LOOKERS", "shout_in", 9000.999, 0, 0, 0, 0, 0, 1); } }
	SetPlayerChatBubble(playerid, params[0], 0xE6E6E6E6, 35.0, 5000);
	return 1;
}
alias:gnews("gov");
cmd:gnews(playerid, params[])
{
	if(PI[playerid][pMember] == 24) return 1;
	if(IsAGang(playerid) || ISAMAFIA(playerid)) return 1;
	if(!CanGiverankPlayer(playerid)) return ErrorMessage(playerid, "Вам недоступна эта команда.");
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!");
	if(GetPVarInt(playerid, "AntiFloodGOV") > unix) return ErrorMessage(playerid, "Попробуйте снова через 2 секунды");
	if(PI[playerid][pMuteTime]) return SCMF(playerid, COLOR_LIGHTRED, "У Вас бан чата! До снятия: %d секунд(ы)", PI[playerid][pMuteTime]);
	if(sscanf(params, "s[128]", params[0])) return ErrorMessage(playerid, "/gnews (текст - свой текст, 1 - начало собеседования, 2 - напоминание, 3 - конец собеседования)");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		if(StartRabWork(playerid)) SetPVarInt(playerid, "StartRabWork", 0);
		PI[playerid][pMember] = 0;
		PI[playerid][pRank] = 0;
		PI[playerid][pLeader] = 0;
		PI[playerid][pJob] = 0;
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		SetPlayerSkin(playerid, PI[playerid][pChar]);
		SendClientMessage(playerid, COLOR_RED, "Вы были уволены. Если это произошло ошибочно, то пиши Анастасии. НЕ ЗАБУДЬ СКРИН СДЕЛАТЬ!!!");
		string = "";
		format(string, 144, "%s был уволен из фракции за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}
	if(!Reklama(playerid, params[0])) return 1;
	SetPVarInt(playerid, "AntiFloodGOV", unix + 2);
	PI[playerid][last_message] = params[0];

	new InterviewPlace[60];
	if(PI[playerid][pMember] == 1) format(InterviewPlace, sizeof(InterviewPlace), "офис LSPD.");
	else if(IsAArm(playerid)) format(InterviewPlace, sizeof(InterviewPlace), "военкомат г. Лос-Сантос.");
	else if(PI[playerid][pMember] == 16) format(InterviewPlace, sizeof(InterviewPlace), "офис СМИ.");
	else format(InterviewPlace, sizeof(InterviewPlace), "мэрия г. Лос-Сантос.");

	if(!strcmp(params[0], "1", true)) {
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Уважаемые жители и гости штата LeanWorld, минутку внимания!", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid);
		SendClientMessageToAll(COLOR_BLUE, string);
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Спешу сообщить вам о предстоящем собеседовании в %s.", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid, FI[PI[playerid][pMember]][fName]);
		SendClientMessageToAll(COLOR_BLUE, string);
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Место проведения собеседования: %s", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid, InterviewPlace);
		SendClientMessageToAll(COLOR_BLUE, string);
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Благодарим за внимание!", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid);
		SendClientMessageToAll(COLOR_BLUE, string);
		return 1;
	}
	else if(!strcmp(params[0], "2", true)) {
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Уважаемые жители и гости штата LeanWorld, минутку внимания!", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid);
		SendClientMessageToAll(COLOR_BLUE, string);
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Напоминаем, что проходит собеседование в %s.", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid, FI[PI[playerid][pMember]][fName]);
		SendClientMessageToAll(COLOR_BLUE, string);
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Место проведения собеседования: %s", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid, InterviewPlace);
		SendClientMessageToAll(COLOR_BLUE, string);
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Благодарим за внимание!", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid);
		SendClientMessageToAll(COLOR_BLUE, string);
		return 1;
	}
	else if(!strcmp(params[0], "3", true)) {
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Уважаемые жители и гости штата LeanWorld, минутку внимания!", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid);
		SendClientMessageToAll(COLOR_BLUE, string);
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Сообщаем, что собеседование в %s завершено.", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid, FI[PI[playerid][pMember]][fName]);
		SendClientMessageToAll(COLOR_BLUE, string);
		format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: Благодарим за внимание!", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid);
		SendClientMessageToAll(COLOR_BLUE, string);
		return 1;
	}
	string = "";
	format(string, MAX_STR, "Гос. Новости: [%s] "WHITE"%s[%d]: %s", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid, params[0]);
	SendClientMessageToAll(COLOR_BLUE, string);
	return 1;
}
cmd:news(playerid, params[])
{
	if(PI[playerid][pMember] != 16) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	new newcar = VehicleEnters[playerid];
	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!");
	if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У Вас бан чата!");
	if(newcar >= lsnewscar[0] && newcar <= lsnewscar[1] || PlayerToPoint(30.0, playerid, 286.5744, -1614.6272, 96.4978)) { } else { ErrorMessage(playerid, "Вы не в офисе / репортёрской машине / вертолёте!"); return 1;}
	if(sscanf(params, "s[128]", params[0])) return ErrorMessage(playerid, "/news [текст]");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		if(StartRabWork(playerid)) SetPVarInt(playerid, "StartRabWork", 0);
		PI[playerid][pMember] = 0;
		PI[playerid][pRank] = 0;
		PI[playerid][pLeader] = 0;
		PI[playerid][pJob] = 0;
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		SetPlayerSkin(playerid, PI[playerid][pChar]);
		SendClientMessage(playerid, COLOR_RED, "Вы были уволены. Если это произошло ошибочно, то пиши Анастасии. НЕ ЗАБУДЬ СКРИН СДЕЛАТЬ!!!");
		string = "";
		format(string, 144, "%s был уволен из фракции за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}

	if(!Reklama(playerid, params[0])) return 1;
	string = "";
	format(string, 150, "{1F7C65}[Новости штата] "WHITE"%s[%d]: %s", PI[playerid][pNames], playerid, params[0]);
	LSNews(0x1F7C65FF, string);
	lNews[playerid] = false;
	PI[playerid][last_message] = params[0];
	return 1;
}

cmd:ans(playerid, params[])
{
	new format_string[144];
	if(GetAccessAdmin(playerid, 1))
	{
		if(EnableInfo[pm] == 0 && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return SCM(playerid, -1, ""net"Ответы временно отключены.");

		if(sscanf(params, "ds[128]", params[0], params[1])) return SCM(playerid, -1, ""information"Введите: /ans [ id игрока ] [ текст ]");

		CheckDomain(playerid, params[1]);

		format(format_string, sizeof format_string, ""information"Ответ от администратора %s[%d]: {EE5555}%s", PI[playerid][pNames], playerid, params[1]);
		SendClientMessage(params[0], -1, format_string);

		format(format_string, sizeof format_string, "[A] %s[%d] ответил %s[%d]: %s", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0], params[1]);
		SendAdminMessage(0xFF9945AA, format_string);

		gAdmin[playerid][ADMIN_PM]++;
		new mysql_format_string[144];
		mysql_format(1, mysql_format_string, sizeof mysql_format_string, "UPDATE `admin` SET `pm` = '%d' WHERE `Name` = '%s' LIMIT 1", gAdmin[playerid][ADMIN_PM], PI[playerid][pNames]);
		mysql_tquery(1, mysql_format_string);

		PlayerPlaySound(params[0], 1058, 0.0, 0.0, 0.0);
	}
	else if(PI[playerid][pHelper])
	{
		if(EnableInfo[pm] == 0 && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return SCM(playerid, -1, ""net"Ответы временно отключены.");

		if(sscanf(params, "ds[128]", params[0], params[1])) return SCM(playerid, -1, ""information"Введите: /ans [ id игрока ] [ текст ]");

		if(IsADomen(params[1]))
		{
			PI[playerid][pHelper] = 0;
			UpdatePlayerData(playerid, "pHelper", PI[playerid][pHelper]);
			return KickEx(playerid);
		}

		format(format_string, sizeof format_string, ""information"Ответ от оператора %s[%d]: {EE5555}%s", PI[playerid][pNames], playerid, params[1]);
		SendClientMessage(params[0], -1, format_string);

		format(format_string, sizeof format_string, "[S] Оператор %s[%d] ответил %s[%d]: %s", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0], params[1]);
		SendSupportsMessage(0xFF9945AA, format_string);

		PI[playerid][pHelperAns] ++;
		UpdatePlayerData(playerid, "pHelperAns", PI[playerid][pHelperAns]);

		PlayerPlaySound(params[0], 4203, 0.0, 0.0, 0.0);
	}
	return 1;
}
