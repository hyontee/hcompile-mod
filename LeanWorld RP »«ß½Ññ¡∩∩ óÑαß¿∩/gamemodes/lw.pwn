	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	new text[196], Member[196];
	if(PI[params[0]][pHouse] != -1 || PI[params[0]][pArendaHouse] != -1)
	{
		new Float:x, Float:y, h;
		if(PI[params[0]][pHouse] != -1) h = PI[params[0]][pHouse];
		else h = PI[params[0]][pArendaHouse];
		if(h < MAX_HOUSE)
		{
			x = HouseInfo[h][hEnter][0];
			y = HouseInfo[h][hEnter][1];
			new ids = GetCityName ( x, y );
			new id = GetZonaName ( x, y );
