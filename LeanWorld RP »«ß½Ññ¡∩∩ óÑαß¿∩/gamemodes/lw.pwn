CMD:spawncars(playerid, params[])
{
    if(!GetAccessAdmin(playerid, 14)) return false;
    static const fmt_str[] = ""information"%s [%i] зареспавнил незанятый людьми транспорт.";
    
    new str[sizeof(fmt_str) + 16 - 2 + MAX_PLAYER_NAME - 2 + 3],
        occupied[(MAX_VEHICLES + 1) char] = {((0x00 << 24) | (0x00 << 16) | (0x00 << 8) | (0x00)), ...},
        vehicleid,
        i = GetMaxPlayers();

    format(str, sizeof(str), fmt_str, PI[playerid][pNames], playerid);
    SendClientMessageToAll(-1, str);

    do
    {
        if((vehicleid = GetPlayerVehicleID(--i)) == 0) continue;
        occupied{vehicleid} = 1;
        if((vehicleid = GetVehicleTrailer(vehicleid)) == 0) continue;
        occupied{vehicleid} = 1;
    }
    while(i);

    i = MAX_VEHICLES - 1;

    do
        if(occupied{i} == 0) SetVehicleToRespawn(i);
    while(--i);
    return true;
}
