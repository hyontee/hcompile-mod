		PI[params[0]][pRubInfo] += params[1];
		PI[params[0]][pRubDonateTotal][1] += params[1];
		UpdatePlayerData(params[0], "pRubDonateTotal1", PI[params[0]][pRubDonateTotal][1]);
		SCMF(params[0], COLOR_BLUE, "Администратор: %s выдал Вам %i донат рублей.", PI[playerid][pNames], params[1]);
		format(string, sizeof(string), "Администратор: %s выдал %s %i донат рублей.", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
		SendAdminMessage(COLOR_SERVER, string);
		SCMF(playerid, COLOR_BLUE, "Вы успешно выдали донат рубли %s", PI[params[0]][pNames]);
		UpdatePlayerData(params[0], "pRub", PI[params[0]][pRubInfo]);
		new log_str[256 + 1];
		format(log_str, sizeof(log_str), "%s использовал команду /giverub на %s", PI[playerid][pNames], PI[params[0]][pNames]);
