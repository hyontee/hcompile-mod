		    Buyitem[playerid] = -1;
		    DestroyPlayerObject(playerid, TempBGObject[playerid]);
		    PI[playerid][pType]=-1;
		    SetPVarInt(playerid,"timetobuy2",0);
		    PlayerTextDrawHide(playerid,InfoText[playerid]);
		    TextDrawHideForPlayer(playerid,Boxmenu0);
		    TextDrawHideForPlayer(playerid,ButtonLeft);
		    TextDrawHideForPlayer(playerid,ButtonRight);
		    TextDrawHideForPlayer(playerid,ButtonCancel);
		    TextDrawHideForPlayer(playerid,ButtonSelect);
		    TextDrawHideForPlayer(playerid,boxaccept);
		    TextDrawHideForPlayer(playerid,boxcancel);
		    CancelSelectTextDraw(playerid);
        }
        else if(clickedid == boxcancel)
        {
            new race = PI[playerid][pType],slot = PI[playerid][pType2],price = ItemsCost[race][Buyitem[playerid]];
	        new item = ItemsId[race][Buyitem[playerid]];
	        new i = GetPVarInt(playerid, "Bizzid");
            if(PI[playerid][pCash]<price) return SCM(playerid,-1,""#net"У вас не достаточто денег для покупки!");
 		    if(PI[playerid][pSlotItem][slot]!=0 && GetPVarInt(playerid,"timetobuy2")==0)
 		    {
			    SetPVarInt(playerid,"timetobuy2",1);
			    SCM(playerid,-1,""GREEN"[Информация] "WHITE"Нажмите 'ACCEPT' еще раз если хотите заменить старый на новый.");
			    return false;
		    }
	        GiveItem(playerid,item);
	        SCM(playerid,-1,""GREEN"[Информация] "WHITE"Вы купили аксессуар, хорошего Вам дня, и настроения!");
            ApplyAnimation(playerid,"goggles","goggles_put_on",4.1,0,0,0,0,0,1);
		    Hook_GivePlayerMoney(playerid, -price);
		    BizInfo[i][bBank] += price;
			BizInfo[i][bProdOrder] -= 50;
			SaveBusiness(i);
		    PI[playerid][pSlotItem][slot]=item;
		    format(PI[playerid][pSlotItems],64,"%d,%d,%d,%d,%d,%d",PI[playerid][pSlotItem][0],PI[playerid][pSlotItem][1],PI[playerid][pSlotItem][2],PI[playerid][pSlotItem][3],PI[playerid][pSlotItem][4],PI[playerid][pSlotItem][5]);
		    format(mysql_string, sizeof(mysql_string),"UPDATE `accounts` SET `acessories` = '%s' WHERE `id` = '%d'", PI[playerid][pSlotItems], PI[playerid][pID]);
            mysql_tquery(1, mysql_string, "", "");
		    DestroyPlayerObject(playerid, TempBGObject[playerid]);
            TogglePlayerControllable(playerid, true);
            PlayerPlaySound(playerid, 30802, 0.0, 0.0, 0.0);
		    SetCameraBehindPlayer(playerid);
		    Buyitem[playerid] = -1;
		    PI[playerid][pType]=-1;
		    SetPVarInt(playerid,"timetobuy2",0);
		    PlayerTextDrawHide(playerid,InfoText[playerid]);
		    TextDrawHideForPlayer(playerid,Boxmenu0);
		    TextDrawHideForPlayer(playerid,ButtonLeft);
		    TextDrawHideForPlayer(playerid,ButtonRight);
			TextDrawHideForPlayer(playerid,ButtonCancel);
			TextDrawHideForPlayer(playerid,ButtonSelect);
		    TextDrawHideForPlayer(playerid,boxaccept);
		    TextDrawHideForPlayer(playerid,boxcancel);
		    CancelSelectTextDraw(playerid);
		    DeletePVar(playerid,"Bizzid");
        }
	}
	return 1;
}

MessageCriminal(color, const string_massive[], bool:type)
{
	foreach(Player, i)
	{
		if((!type && !ISAMAFIA(i)) || (type && !IsAGang(i)) ) continue;
		SendClientMessage(i, color, string_massive);
	}
	return 1;
}

public OnGameModeInit()
{
    LoadMySQLSettings();
	print("Запуск игрового мода...\n");

    mysql_connect(MySQLSettings[MAZE_HOST], MySQLSettings[MAZE_USERNAME], MySQLSettings[MAZE_DATABASE], MySQLSettings[MAZE_PASSWORD]);

    mysql_log(LOG_ERROR | LOG_WARNING);

	switch(mysql_errno())
	{
		case 0, 1146: print("[!] Подключение к MySQL успешно завершено");
	    case 1044: return print("[?] Не удалось подключиться к MySQL [Указано несуществующее имя пользователя]");
	    case 1045: return print("[?] Не удалось подключиться к MySQL [Указан неправильный пароль]");
	    case 1049: return print("[?] Не удалось подключиться к MySQL [Указана несуществующая база данных]");
	    case 2003: return print("[?] Не удалось подключиться к MySQL [Хостинг с базой данных недоступен]");
	    case 2005: return print("[?] Не удалось подключиться к MySQL [Указан неправильный адрес хостинга]");
	    default: return printf("[?] Не удалось подключиться к MySQL [Неизвестная ошибка. Код ошибки: %d]", mysql_errno());
	}

	mysql_query(1, "SET NAMES cp1251", false);
	mysql_function_query(1, "SET CHARACTER SET 'cp1251'", false, "", "");
	mysql_set_charset("cp1251");
	
	mysql_pquery(1, "SELECT * FROM `hostnames`", "LoadNames");
	BonusLoad();

	for(new i=0;i<sizeof(SALUTEINFOS);i++) SALUTEINFOS[i][SaluteUse] = false;
	for(new i;i<20;i++) gDSTurn[i] = INVALID_PLAYER_ID;

	new gamemode_string[80];
	format(gamemode_string, sizeof(gamemode_string), "« LeanWorld Mode »");
	//SetGameModeText(gamemode_string);

	SendRconCommand("language Russian");
	SendRconCommand("sleep 2");
	SendRconCommand("chatlogging 0");
	SendRconCommand("cookielogging 0");
	SendRconCommand("ackslimit 7000");
	//SetTimer("ChangeHostname",1,1);
