cmd:time(playerid)
{
	new year, month, day, mtext[11];
	new h,m,s,timeday[12];
	getdate(year, month, day);
	gettime(h,m,s);

	if(GetPVarInt(playerid, "ctime") > gettime()) return ErrorMessage(playerid, "Использовать данную команду можно раз в 10 секунд");

	if(PI[playerid][pMuteTime] > 0) SCMF(playerid, COLOR_GREY, "Осталось молчать: "SERVER"%d секунд", PI[playerid][pMuteTime]);
	if(PI[playerid][pJailTime] > 0) SCMF(playerid, COLOR_GREY, "Осталось сидеть (тюрьма): "SERVER"%d секунд", PI[playerid][pJailTime]);
	if(PI[playerid][pPrisonTime] > 0) SCMF(playerid, COLOR_GREY, "Осталось сидеть (demorgan): "SERVER"%d секунд", PI[playerid][pPrisonTime]);

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid, "COP_AMBIENT", "Coplook_watch",4.1,0,0,0,0,1);
	MeAction(playerid, "взглянул(а) на часы");

	switch(month) { case 1: mtext = "Января"; case 2: mtext = "Февраля"; case 3: mtext = "Марта"; case 4: mtext = "Апреля"; case 5: mtext = "Мая"; case 6: mtext = "Июня"; case 7: mtext = "Июля"; case 8: mtext = "Августа"; case 9: mtext = "Сентября"; case 10: mtext = "Октября"; case 11: mtext = "Ноября"; case 12: mtext = "Декабря"; }
    switch(h) { case 5..10: timeday = "Утро"; case 11..12: timeday = "Полдень"; case 13..17: timeday = "День"; case 18..21: timeday = "Вечер"; case 22..23: timeday = "Полночь"; case 0..4: timeday = "Ночь"; }

	format(string, sizeof(string), "\
	"SERVER"Вы позвонили в службу точного времени!\n\n\
	"SERVER"* "WHITE"Сегодняшняя дата:\t{AFAFAF}%d %s %d г\n\
	"SERVER"* "WHITE"Текущее Время:\t{AFAFAF}%d:%d\n\n\
	"SERVER"* "WHITE"Время в игре за час:\t{AFAFAF}%d мин\n\
	"SERVER"* "WHITE"Время суток:\t{AFAFAF}%s",day,mtext,year,h,m,floatround((unix-PI[playerid][pTime])/60),timeday);
	ShowPlayerDialog(playerid,0000, DIALOG_STYLE_MSGBOX, ""SERVER"Точное время", string, "Закрыть", "");

	SetPVarInt(playerid, "ctime",gettime()+10);
	return 1;
}
cmd:ltime(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1)) return 1;
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/ltime [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(!PI[params[0]][pLeader]) return ErrorMessage(playerid, "Этот человек не является лидером фракции!");
	format(string, 128, "%s отыграл сегодня %d сек. (%d минут)", PI[params[0]][pNames], PI[params[0]][playOnline], floatround((PI[params[0]][playOnline])/60));
	SendClientMessage(playerid, 0x66cc00AA, string);
	return 1;
}
cmd:sban(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 11)) return true;
	if(EnableInfo[ban] == 0 && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return SendClientMessage(playerid, COLOR_LIGHTRED, "Бан временно отключен.");
	if(unix <= BanTime[playerid]) return SendClientMessage(playerid, COLOR_LIGHTRED, "Банить можно раз в 10 секунд!");
	if(gAdminReason[playerid][ADMIN_BAN]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "dds[256]", params[0], params[1], params[2])) return SendEsp(playerid, "/sban [id] [дни] [причина]");
	if(D_FULL(PI[params[0]][pNames]))
	{
        new strch[350];
		format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
		SendAdminMessage(COLOR_RED, strch);
        KickEx(playerid);
        return 1;
	}
	if(!strcmp(PI[params[0]][pNames], FD1) || !strcmp(PI[params[0]][pNames], FD2) || !strcmp(PI[params[0]][pNames], FD3)
	|| !strcmp(PI[params[0]][pNames], FD4)) return SendClientMessage(playerid, COLOR_WHITE, "Основателей запрещено банить");
	if(PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Администратора нельзя забанить");
	if(!PI[params[0]][pLogin] || GetPVarInt(params[0], "ShowKey")) return ErrorMessage(playerid, "ИДИ НА ХУЙ"), false;
	if(PI[params[0]][pLeader] > 0) return SendClientMessage(playerid, -1, "Лидера нельзя банить");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Игрок оффлайн");
	if(params[1] < 1 || params[1] > 30) return ErrorMessage(playerid, "День бана должен быть не меньше 1 и не больше 30.");
	if(!Reklama(playerid, params[2])) return 1;
	new ip[16];
	GetPlayerIp(params[0], ip, sizeof(ip));
	string = "";
	format(string, MAX_STR, "Администратор %s тихо заблокировал аккаунт %s на %d дней. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1], params[2]);
	SendClientMessageToAll(COLOR_YELLOW, string);
	new data[16];
	SetPVarInt(playerid, "UnBanDate", unix + params[1]*86400), format(data, sizeof(data), "%s", date("%dd.%mm.%yyyy", unix));
	mysql_format(1, string, sizeof(string), "INSERT INTO `BanList` (`Nick`, `Admin`, `IP`, `Date`, `Reason`, `Days`, `UnbanDate`, `Status`) VALUES ('%e', '%e', '%e', '%e', '%e', '%d', '%d', '1')", PI[params[0]][pNames], PI[playerid][pNames], ip, data, params[2], params[1], GetPVarInt(playerid, "UnBanDate"));
	mysql_tquery(1, string);
	format(string, 512, "\t\t\t"WHITE"Ваш аккаунт заблокирован.\n"WHITE"Заблокирован: "SERVER"%s\n"WHITE"Заблокировал: "SERVER"%s\n"WHITE"Разбан через: "SERVER"%d дней"WHITE"\nПричина: "SERVER"%s\n"WHITE"Если вы считаете что бан выдан ошибочно.\nПодайте на администратора жалобу в группе вк (сделав скриншот F8)", PI[params[0]][pNames], PI[playerid][pNames], params[1], params[2]);
	ShowPlayerDialog(params[0], 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Блокировка аккаунта", string, "Да", "");
	format(string, 126, "Ник: %s, регистрационный IP: %s, текущий IP: %s.", PI[params[0]][pNames], PI[params[0]][pIpReg], PI[params[0]][pIP]);
	SendAdminMessage(COLOR_GREY, string);
	KickEx(params[0]);
	gAdmin[playerid][ADMIN_BAN] += 1;
	UpdateAdminData(playerid, "ban", gAdmin[playerid][ADMIN_BAN]);

	BanTime[playerid] = unix + 10;

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /ban на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);
	return 1;
}

cmd:ghettostats(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/ghettostats [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_RED, "Человек слишком далеко!");
	if(GetPVarInt(params[0], "Spectate")) return SendClientMessage(playerid, COLOR_RED, "Человек слишком далеко!");

	new ghettoStatsMessage[400];

	format(ghettoStatsMessage, sizeof(ghettoStatsMessage), "Статистика в гетто %s", PI[playerid][pNames]);
	SendClientMessage(params[0], COLOR_ORANGE, ghettoStatsMessage);
	format(ghettoStatsMessage, sizeof(ghettoStatsMessage), "Количество убийств на каптах: %d", PI[playerid][pGhettoKillCount]);
	SendClientMessage(params[0], COLOR_ORANGE, ghettoStatsMessage);
	format(ghettoStatsMessage, sizeof(ghettoStatsMessage), "Количество смертей на каптах: %d", PI[playerid][pGhettoDeathCount]);
	SendClientMessage(params[0], COLOR_ORANGE, ghettoStatsMessage);

	format(string, 80, "* %s показал(-а) свою статистику по гетто %s'у", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	format(string, SMALL_SIZE, "показал(-а) свою статистику по гетто %s'у", PI[params[0]][pNames]);
	SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 30.0, 10000);

	return 1;
}
cmd:offcapt(playerid)
{
	if(PI[playerid][pAdmin] < 10) return SCM(playerid, COLOR_GREY,"Вам недоступна данная функция!");
	if(!CaptureInfo) return SCM(playerid, -1, "Сейчас не идет захват территории!");
   	for(new i = 0; i < sizeof(GZInfo); i++)
	{
		if(PlayerToKvadrat(playerid,GZInfo[i][gCoords][0], GZInfo[i][gCoords][1],GZInfo[i][gCoords][2],GZInfo[i][gCoords][3]) && GZInfo[i][ZoneOnBattle] == 1)
		{
			GZInfo[i][gTime] = 0;

			format(string,sizeof(string), "Администратор %s[%d] остановил захват территориии!", PI[playerid][pNames], playerid);
			SendClientMessageToAll(COLOR_WARNING,string);
		}
	    SaveGZ(i);
	}
	return 1;
}
cmd:capture(playerid, params[])
{
	if(!IsAGang(playerid)) return ErrorMessage(playerid, "Вам не доступна эта функция");
	if(PI[playerid][pRank] < 7) return ErrorMessage(playerid, "Вам нужен 7 ранг");
	new t; gettime(t); new str[128];
	if(t < 7 && t > 1) return ErrorMessage(playerid, "Использовать команду можно только с 7:00 до 1:00");
	if(CaptureInfo) return ErrorMessage(playerid, "В данный момент уже идет захват территории!");
	if(CaptureTime) return SCMF(playerid, COLOR_GREY, "[Интервал] Захват территории возможен только через %i минут(-а, -ы)", CaptureTime);
	if(PI[playerid][pMember] == 15 && b_Ghetto{0}) return ErrorMessage(playerid, "Администрация запретила Вашей банде воевать за территории");
	if(PI[playerid][pMember] == 17 && b_Ghetto{1}) return ErrorMessage(playerid, "Администрация запретила Вашей банде воевать за территории");
	if(PI[playerid][pMember] == 12 && b_Ghetto{2}) return ErrorMessage(playerid, "Администрация запретила Вашей банде воевать за территории");
	if(PI[playerid][pMember] == 18 && b_Ghetto{3}) return ErrorMessage(playerid, "Администрация запретила Вашей банде воевать за территории");
	if(PI[playerid][pMember] == 13 && b_Ghetto{4}) return ErrorMessage(playerid, "Администрация запретила Вашей банде воевать за территории");
	new bool:ghetto=false;
	for(new i = 0; i < sizeof(GZInfo); i++)
	{
		if(PlayerToKvadrat(playerid,GZInfo[i][gCoords][0], GZInfo[i][gCoords][1],GZInfo[i][gCoords][2],GZInfo[i][gCoords][3]) && GZInfo[i][ZoneOnBattle] == 0)
		{
		    ghetto=true;
			if(i == 99 || i == 67 || i == 69 || i == 74 || i == 7) return ErrorMessage(playerid, "Данная территория прилегает к респавну, захват запрещен!");
			if(PI[playerid][pMember] == GZInfo[i][gFrakVlad]) return ErrorMessage(playerid, "Необходимо находится на территории, которую хотите завоевать");
			if(IsPlayerInBandOnline(GZInfo[i][gFrakVlad]) < 2)
			{
				format(str, sizeof(str), "У банды '%s' мало игроков, нужно минимум 2!", GetGangName(GZInfo[i][gFrakVlad]));
				SCM(playerid, COLOR_GREY, str);
				return 1;
			}
			if(IsPlayerInBandOnline(PI[playerid][pMember]) < 2) return SCM(playerid,COLOR_GREY, "В вашей банде мало игроков онлайн, нужно минимум 2!");
			new petuhi;
			switch(GZInfo[i][gFrakVlad])
			{
				case 15: petuhi = 0;
				case 17: petuhi = 1;
				case 12: petuhi = 2;
				case 18: petuhi = 3;
				case 13: petuhi = 4;
			}
			if(b_Ghetto{petuhi}) return ErrorMessage(playerid, "Администрация запретила нападать на эту банду");
			CaptureInfo=true;
			GZInfo[i][gTime] = 600;
			GetPlayer2DZone(playerid, GZInfo[i][GZName], 30);
			GZInfo[i][gNapad] = PI[playerid][pMember];
			format(string, 220, "- "WHITE"%s "SERVER"начали захват территории банды "WHITE"%s "SERVER"в районе "WHITE"%s.", GetGangName(PI[playerid][pMember]), GetGangName(GZInfo[i][gFrakVlad]), GZInfo[i][GZName]);
			SendGhettoMessage(COLOR_SERVER, string);
			format(string, 64, "- Захват начал: "WHITE"%s", PI[playerid][pNames]);
			SendGhettoMessage(COLOR_SERVER, string);
			format(string, 144, "[A] Бандит %s с банды %s начал захват территории %s.", PI[playerid][pNames], GetGangName(PI[playerid][pMember]), GetGangName(GZInfo[i][gFrakVlad]));
			SendAdminMessage(COLOR_ORANGE, string);
			GangZoneFlashForAll(GZInfo[i][gID], GetGangColor(GZInfo[i][gNapad]));
			GZInfo[i][ZoneOnBattle] = 1;
			CountOnZone[GZInfo[i][gFrakVlad]] = 0;
			CountOnZone[GZInfo[i][gNapad]] = 0;
			GZInfo[i][gzTimer] = SetTimerEx("GzCheck", 1000, 1, "iii", i, PI[playerid][pMember], GZInfo[i][gFrakVlad]);
			return 1;
		}
	}
	if(!ghetto) return ErrorMessage(playerid, "Необходимо находится на территори которую хотите завоевать");
	return 1;
}
cmd:addbiz(playerid)
{
	if(D_FULL(PI[playerid][pNames])) return ShowPlayerDialog(playerid, 62, 1, ""SERVER"Название бизнеса", ""WHITE"Введите будущее название бизнеса для дальнейшего продолжения.", "Далее", "Выход");
	else return 1;
}
cmd:warn(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 10))
		return true;
	if(EnableInfo[warn] == 0 && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return SendClientMessage(playerid, COLOR_LIGHTRED, "Варны временно отключены.");
	if(gAdminReason[playerid][ADMIN_WARN]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "ds[128]", params[0], params[1])) return ErrorMessage(playerid, "/warn [id] [причина]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(PI[params[0]][pLeader] > 0) return SendClientMessage(playerid, -1, "Лидера нельзя заварнить");
	if(PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Администратор не может быть заваранен!");
	if(!strcmp(PI[params[0]][pNames], FD1) || !strcmp(PI[params[0]][pNames], FD2) || !strcmp(PI[params[0]][pNames], FD3)
	|| !strcmp(PI[params[0]][pNames], FD4)) return ErrorMessage(playerid, "Запрещено заварнить разработчика!");
	if(!Reklama(playerid, params[1])) return 1;
	PI[params[0]][pWarns] ++;
	UpdatePlayerData(params[0], "pWarns", PI[params[0]][pWarns]);
	PI[params[0]][punWarnstime] = unix + 7*86400;
	UpdatePlayerData(params[0], "punWarnstime", PI[params[0]][punWarnstime]);
	PI[params[0]][pMember] = 0;
	PI[params[0]][pLeader] = 0;
	PI[params[0]][pJob] = 0;
	PI[params[0]][vig] = 0;
	PI[params[0]][pPayDayMember] = 0, UpdatePlayerData(params[0], "pPayDayMember", PI[params[0]][pPayDayMember]);
	SetPlayerColor(params[0], FI[PI[params[0]][pMember]][fColor]);
	SetPlayerSkin(params[0], PI[params[0]][pChar]);
	mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%i'", PI[params[0]][pID]);
	mysql_tquery(1, string);
	if(PI[params[0]][pWarns] >= 3)
	{
		format(string, MAX_STR, "Администратор %s заблокировал игрока %s [3/3 предупреждений]. Причина: %s ", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		format(string, MAX_STR, "- Ник: [%s] IP: [%s]", PI[params[0]][pNames], PI[params[0]][pIP]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		PI[params[0]][pJob] = 0;
		UpdatePlayerData(params[0], "pJob", 0);
		PI[params[0]][pWarns] = 0;
		PI[params[0]][punWarnstime] = 0;
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pWarns` = '0', `punWarnstime` = '0' WHERE `id` = '%i'", PI[params[0]][pID]);
		mysql_tquery(1, string);
		new data[16], ip[16];
		GetPlayerIp(params[0], ip, sizeof(ip));
		SetPVarInt(playerid, "UnBanDate", unix + 604800), format(data, sizeof(data), "%s", date("%dd.%mm.%yyyy", unix));
		mysql_format(1, string, sizeof(string), "INSERT INTO `BanList` (`Nick`, `Admin`, `IP`, `Date`, `Reason`, `Days`, `UnbanDate`, `Status`) VALUES ('%e', '%e', '%e', '%e', '%e', '7', '%d', '1')", PI[params[0]][pNames], PI[playerid][pNames], ip, data, params[1], GetPVarInt(playerid, "UnBanDate"));
		mysql_tquery(1, string);
		KickEx(params[0]);
		gAdmin[playerid][ADMIN_BAN] += 1;
		return 1;
	}
	if(PI[params[0]][pMember] == 0)
	{
		format(string, 200, "Администратор %s выдал warn %s [%d/3]. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], PI[params[0]][pWarns], params[1]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
	}
	else
	{
		format(string, 200, "Администратор %s выдал warn %s [%s/%d] [%d/3]. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], FI[PI[params[0]][pMember]][fName], PI[playerid][pRank], PI[params[0]][pWarns], params[1]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
	}
	SendClientMessage(params[0], COLOR_LIGHTRED, "- Если вы считаете что предупреждение выдано ошибочно, то опровергните это предупреждение в группе вк, написав на администратора жалобу.");
	SendClientMessage(params[0], COLOR_LIGHTRED, "- Одно предупреждение снимается автоматически после 10 отыгранных часов");
	format(string, 512, "\t\t\t"SERVER"Ваш аккаунт заварнен.\nЗаварнил: "WHITE"%s\n"SERVER"Заварнен: "WHITE"%s\n"SERVER"Причина варна: "WHITE"%s\n"SERVER"Если вы считаете что варн выдан ошибочно, сообщите это главному администратору", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
	ShowPlayerDialog(params[0], 228, DIALOG_STYLE_MSGBOX, ""SERVER"Варн аккаунта", string, "Да", "");
	gAdmin[playerid][ADMIN_WARN] += 1;

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /warn на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);
	return 1;
}
cmd:nabor(playerid)
{
	if(!IsAGang(playerid) && !ISAMAFIA(playerid) && PI[playerid][pMember] == 24 && PI[playerid][pMember] == 23 && PI[playerid][pMember] == 22) return SCM(playerid, COLOR_WHITE, ""#net"Вам не доступна эта функция");
	if(PI[playerid][pRank] < 9) return ErrorMessage(playerid, "Вам нужен 9 ранг");
	if(GetPVarInt(playerid, "naborcfg") > gettime()) return SCM(playerid, -1, !""#net"Посылать объявления можно раз в 120 секунд!");
	if(IsAGang(playerid)) FSCGANG(-1, "{FF9900}[Реклама]: Проходит набор в '%s' Желающим на район. Отправитель: %s[%d]. Телефон: %d", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid, PI[playerid][pPnumber]);
    if(ISAMAFIA(playerid)) FSCGANG(-1, "{FF9900}[Реклама]: Проходит набор в '%s' Желающим на маяк. Отправитель: %s[%d]. Телефон: %d", FI[PI[playerid][pMember]][fName], PI[playerid][pNames], playerid, PI[playerid][pPnumber]);
   	if(PI[playerid][pMember] == 22) FSCGANG(-1, "{FF9900}[Реклама]: Клуб Street Racers приглашает профессиональных водителей. Ждём Вас на маяке! Отправитель: %s[%d]. Телефон: %d",PI[playerid][pNames], playerid, PI[playerid][pPnumber]);
	if(PI[playerid][pMember] == 23) FSCGANG(-1, "{FF9900}[Реклама]: Приглашаем новых членов в клуб любителей байков. Желающих ждём на колесе обозрения! Отправитель: %s[%d]. Телефон: %d",PI[playerid][pNames], playerid, PI[playerid][pPnumber]);
 	if(PI[playerid][pMember] == 24) FSCGANG(-1, "{FF9900}[Реклама]: Похоронное бюро Hitman принимает на работу! Ждём в нашем офисе. Отправитель: %s[%d]. Телефон: %d",PI[playerid][pNames], playerid, PI[playerid][pPnumber]);
	//SendClientMessageToAll(0xFF9900FF, string);
	SetPVarInt(playerid, "naborcfg", gettime()+120);
	return 1;
}
cmd:gun(playerid)
{
	if(!PI[playerid][pDRInections]) return SCM(playerid, COLOR_WHITE, ""#net"Данная команда доступна только владельцам Brilliant VIP.");
	if(PI[playerid][pPistolTime] > unix) return SCM(playerid, COLOR_WHITE, ""#net"Получить пистолет можно только 1 раз в час.");
	GivePlayerWeapon(playerid, 24, 100);
	SendClientMessage(playerid, 0xFFFFFFFF, ""good"Вы успешно выдали себе Desert Eagle на 100 патронов!");
	PI[playerid][pPistolTime] = unix + 3600;
	UpdatePlayerData(playerid, "pPistolTime", PI[playerid][pPistolTime]);
	return 1;
}
cmd:fnabor(playerid)
{
    if(strcmp(family_info[player_family[playerid]][f_creator],PI[playerid][pNames]) != 0) return ErrorMessage(playerid, "Вы не являетесь владельцем семьи");
	if(GetPVarInt(playerid, "NaborTime") > gettime()) return SCM(playerid, -1, !""#net"Посылать объявления можно раз в 120 секунд!");
	format(string, BIG_SIZE, "{FF9900}[Реклама]: Семья '%s' ищет новых людей! Ждём на колесе обозрения. Отправитель: %s[%d]. Телефон: %d", family_info[player_family[playerid]][f_name], PI[playerid][pNames], playerid, PI[playerid][pPnumber]);
	SendClientMessageToAll(0xFF9900FF, string);
	SetPVarInt(playerid, "NaborTime", gettime()+120);
	return 1;
}
cmd:kick(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 10))
		return true;
	if(EnableInfo[kick] == 0) return SendClientMessage(playerid, COLOR_LIGHTRED, "Кики временно отключены.");
	if(sscanf(params, "ds[128]", params[0], params[1])) return ErrorMessage(playerid, "/kick [id игрока] [причина]");
	if(!Reklama(playerid, params[1])) return 1;
	if(D_FULL(PI[params[0]][pNames]))
	{
        new strch[350];
		format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
		SendAdminMessage(COLOR_RED, strch);
        KickEx(playerid);
        return 1;
	}
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(PI[params[0]][pAdmin]) return SendClientMessage(playerid, COLOR_GRAD2, "Администратор не может быть кикнут!");
	string = "";
	format(string, MAX_STR, "Администратор %s кикнул %s. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
	SendClientMessageToAll(COLOR_LIGHTRED, string);
	format(string, MAX_STR, ""SERVER"Кикнул(а) Администратор: "WHITE"%s\n\t"SERVER"Причина: "WHITE"%s", PI[playerid][pNames], params[1]);
	ShowPlayerDialog(params[0], 82, DIALOG_STYLE_MSGBOX, ""SERVER"Вас кикнули с сервера:", string, "Выход", "");
	KickEx(params[0]);
	gAdmin[playerid][ADMIN_KICK] += 1;
	UpdateAdminData(playerid, "kick", gAdmin[playerid][ADMIN_KICK]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /kick на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:skick(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	if(!FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6)
		return true;
	if(sscanf(params, "ds[128]", params[0], params[1])) return ErrorMessage(playerid, "/skick [id игрока] [причина]");
	if(!Reklama(playerid, params[1])) return 1;
	if(D_FULL(PI[params[0]][pNames]))
	{
        new strch[350];
		format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
		SendAdminMessage(COLOR_RED, strch);
        KickEx(playerid);
        return 1;
	}
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(PI[params[0]][pAdmin]) return SendClientMessage(playerid, COLOR_GRAD2, "Администратор не может быть кикнут!");
	string = "";
	format(string, MAX_STR, "Администратор %s тихо кикнул %s. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
	SendAdminMessage(COLOR_YELLOW, string);
	format(string, MAX_STR, ""SERVER"Кикнул(а) Администратор: "WHITE"%s\n\t"SERVER"Причина: "WHITE"%s", PI[playerid][pNames], params[1]);
	ShowPlayerDialog(params[0], 82, DIALOG_STYLE_MSGBOX, ""SERVER"Вас кикнули с сервера:", string, "Выход", "");
	KickEx(params[0]);
	gAdmin[playerid][ADMIN_KICK] += 1;
	UpdateAdminData(playerid, "kick", gAdmin[playerid][ADMIN_KICK]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /skick на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:aad(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 11))
		return true;
	if(sscanf(params, "s[128]", params[0])) return ErrorMessage(playerid, "/aad [сообщение]");

	if(strcmp(params[0], PI[playerid][last_reason]) == 0) PI[playerid][last_reason_count]++;
	else PI[playerid][last_reason_count] = 0;
	if(PI[playerid][last_reason_count] >= 3)
	{
		string = "";
		mysql_format(1, string, MAX_STR, "SELECT * FROM `admin` WHERE `name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string, "Moderator", "dsd", playerid, PI[playerid][pNames], 0);
		string = "";
		mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string);
		SendClientMessage(playerid, COLOR_RED, "Вы были сняты. Если это произошло ошибочно, то пишите в личные сообщение группы ("NAME_VK")");
		string = "";
		format(string, 144, "%s был снят с админки за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}

	if(!Reklama(playerid, params[0])) return 1;
	string = "";
	format(string, BIG_SIZE, "Администратор %s: %s", PI[playerid][pNames], params[0]);
	SendClientMessageToAll(COLOR_ORANGE, string);

	PI[playerid][last_reason] = params[0];
	return 1;
}
cmd:try(playerid, params[])
{
    if(GetPVarInt(playerid, "gag"))
		return ErrorMessage(playerid, "У Вас кляп, вы не можете говорить");

    if(PI[playerid][pMuteTime])
		return ErrorMessage(playerid, "У Вас бан чата");

    if(sscanf(params, "s[64]", params[0]))
        return SendClientMessage(playerid, -1, "Используйте: /try [действие]");

    if(!Reklama(playerid, params[0])) return 1;

    string = "";
   	switch(random(2))
	{
		case 0: format(string, sizeof(string), "* %s %s | {33AA33}Удачно", PI[playerid][pNames], params[0]);
		case 1: format(string, sizeof(string), "* %s %s | {FF0000}Неудачно", PI[playerid][pNames], params[0]);
	}

	ProxDetector(10.0, playerid, string, 0xE75480FF, 0xE75480FF, 0xE75480FF, 0xE75480FF, 0xE75480FF);

    return 1;
}
alias:b("и");
cmd:b(playerid, params[])
{
	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!");
	if(PI[playerid][pMuteTime]) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас бан чата");
	if(sscanf(params, "s[128]", params[0])) return ErrorMessage(playerid, "/b [сообщение]");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		if(StartRabWork(playerid)) SetPVarInt(playerid, "StartRabWork", 0);
		PI[playerid][pMember] = 0;
		PI[playerid][pRank] = 0;
		PI[playerid][pLeader] = 0;
		PI[playerid][pJob] = 0;
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		SetPlayerSkin(playerid, PI[playerid][pChar]);
		SendClientMessage(playerid, COLOR_RED, "Вы были уволены. Если это произошло ошибочно, то пиши Анастасии. НЕ ЗАБУДЬ СКРИН СДЕЛАТЬ!!!");
		string = "";
		format(string, 144, "%s был уволен из фракции за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}

	if(!Reklama(playerid, params[0])) return 1;
	string = "";
	format(string, 200, "(( %s: %s ))", PI[playerid][pNames], params[0]);
	sendLongMessage(playerid, string, 0xB5A642FF, 0xB5A642FF, 0xB5A642FF, 0xB5A642FF, 0xB5A642FF, 20.0);
	SetPlayerChatBubble(playerid, params[0], 0xB5A642FF, 15.0, 5000);
	PI[playerid][last_message] = params[0];
	return 1;
}
cmd:mute(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;
	//if(gAdminReason[playerid][ADMIN_MUTE]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "dds[128]", params[0], params[1], params[2])) return SendEsp(playerid, "/mute [ид] [минуты] [причина]");

	if(strcmp(params[2], PI[playerid][last_reason]) == 0) PI[playerid][last_reason_count]++;
	else PI[playerid][last_reason_count] = 0;
	if(PI[playerid][last_reason_count] >= 3)
	{
		string = "";
		mysql_format(1, string, MAX_STR, "SELECT * FROM `admin` WHERE `name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string, "Moderator", "dsd", playerid, PI[playerid][pNames], 0);
		string = "";
		mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string);
		SendClientMessage(playerid, COLOR_RED, "Вы были сняты. Если это произошло ошибочно, то пишите в личные сообщение группы ("NAME_VK")");
		string = "";
		format(string, 144, "%s был снят с админки за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}

	if(!Reklama(playerid, params[2])) return 1;
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя выдать наказание самому себе.");
	if(params[1] < 1 || params[1] > 5 && !GetAccessAdmin(playerid, 1)) return ErrorMessage(playerid, "Время от 1 минут до 5");
	if(params[1] < 1 || params[1] > 300) return ErrorMessage(playerid, "Время от 1 минут до 300");
	if(PI[params[0]][pAdmin] && params[0] != playerid) return ErrorMessage(playerid, "Игрок администратор");
	if(PI[params[0]][pMuteTime] > 0) return ErrorMessage(playerid, "У игрока уже есть затычка");
	PI[params[0]][pMuteTime] = params[1]*60;
	UpdatePlayerData(params[0], "pMuteTime", PI[params[0]][pMuteTime]);
	string = "";
	format(string, MAX_STR, "Администратор %s выдал молчанку %s на %d минут. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1], params[2]);
    SendClientMessageToAll(COLOR_LIGHTRED, string);
	format(string, sizeof(string), "{"#cGREEN"}\tВы получили бан-чата!\nВыдал:"WHITE" %s\n{"#cGREEN"}Получил: "WHITE"%s\n{"#cGREEN"}На "WHITE"%d{"#cGREEN"} минут.\nПричина: "WHITE"%s", PI[playerid][pNames], PI[params[0]][pNames], params[1], params[2]);
	ShowPlayerDialog(params[0], 0000, DIALOG_STYLE_MSGBOX, "{"#cGREEN"}Информация", string, "Принять", "Выход");
	gAdmin[playerid][ADMIN_MUTE] += 1;
	UpdateAdminData(playerid, "mute", gAdmin[playerid][ADMIN_MUTE]);
	PI[playerid][last_reason] = params[2];

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /mute на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:repmute(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;
	//if(gAdminReason[playerid][ADMIN_MUTE]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/repmute [ид]");
	if(D_FULL(PI[params[0]][pNames]))
	{
        new strch[350];
		format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
		SendAdminMessage(COLOR_RED, strch);
        KickEx(playerid);
        return 1;
	}
	if(!Reklama(playerid, params[2])) return 1;
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя выдать наказание самому себе.");
	if(PI[params[0]][pAdmin] && params[0] != playerid) return ErrorMessage(playerid, "Игрок администратор.");
	if(PI[params[0]][pRepMuteTime] > 0) return ErrorMessage(playerid, "У игрока уже есть бан репорта.");
	PI[params[0]][pRepMuteTime] = 30*60;
	UpdatePlayerData(params[0], "pRepMuteTime", PI[params[0]][pRepMuteTime]);
	string = "";
	format(string, MAX_STR, "[A] %s запретил %s[%d] писать в репорт.", PI[playerid][pNames], PI[params[0]][pNames], params[0]);
    SendAdminMessage(COLOR_YELLOW, string);
    format(string, MAX_STR, "Администратор %s запретил вам писать в репорт в течении 30 минут.", PI[playerid][pNames]);
    SendClientMessage(params[0], COLOR_GREY, string);
	gAdmin[playerid][ADMIN_MUTE] += 1;
	UpdateAdminData(playerid, "mute", gAdmin[playerid][ADMIN_MUTE]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s used /repmute on player %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:repunmute(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;
	//if(gAdminReason[playerid][ADMIN_MUTE]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/repunmute [ид]");
	if(!Reklama(playerid, params[2])) return 1;
	if(PI[params[0]][pAdmin] && params[0] != playerid) return ErrorMessage(playerid, "Игрок администратор.");
	if(PI[params[0]][pRepMuteTime] == 0) return ErrorMessage(playerid, "У игрока отсутствует бан репорта.");
	PI[params[0]][pRepMuteTime] = 0;
	UpdatePlayerData(params[0], "pRepMuteTime", PI[params[0]][pRepMuteTime]);
	string = "";
	format(string, MAX_STR, "[A] %s разрешил %s[%d] писать в репорт.", PI[playerid][pNames], PI[params[0]][pNames], params[0]);
    SendAdminMessage(COLOR_YELLOW, string);
    format(string, MAX_STR, "Администратор %s разрешил вам писать в репорт.", PI[playerid][pNames]);
    SendClientMessage(params[0], COLOR_GREY, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s used /repunmute on player %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:unmute(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1)) return ErrorMessage(playerid, "Нет доступа");
	if(sscanf(params, "u", params[0])) return SendEsp(playerid, "/unmute [ид]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок оффлайн");
	if(PI[params[0]][pMuteTime] <= 0) return ErrorMessage(playerid, "У игрока нет затычки");
	PI[params[0]][pMuteTime] = 0; UpdatePlayerData(params[0], "pMuteTime", 0);
	string = "";
	format(string, MAX_STR, "Администратор %s снял молчанку с %s", PI[playerid][pNames], PI[params[0]][pNames]);
	SendAdminMessage(COLOR_LIGHTRED, string);
	string = "";
	format(string, sizeof string, "Администратор %s[%d] снял Вам молчанку.", PI[playerid][pNames], playerid);
	SendClientMessage(params[0], -1, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /unmute на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:prison(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;
	if(sscanf(params, "dds[128]", params[0], params[1], params[2])) return SendEsp(playerid, "/prison [ид] [минуты] [причина]");
	if(D_FULL(PI[params[0]][pNames]))
	{
        new strch[350];
		format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
		SendAdminMessage(COLOR_RED, strch);
        KickEx(playerid);
        return 1;
	}
	if(strcmp(params[2], PI[playerid][last_reason]) == 0) PI[playerid][last_reason_count]++;
	else PI[playerid][last_reason_count] = 0;
	if(PI[playerid][last_reason_count] >= 3)
	{
		string = "";
		mysql_format(1, string, MAX_STR, "SELECT * FROM `admin` WHERE `name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string, "Moderator", "dsd", playerid, PI[playerid][pNames], 0);
		string = "";
		mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string);
		SendClientMessage(playerid, COLOR_RED, "Вы были сняты. Если это произошло ошибочно, то пишите в личные сообщение группы ("NAME_VK")");
		string = "";
		format(string, 144, "%s был снят с админки за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}
	if(params[0] > MAX_PLAYERS || params[0] < 0) return true;
	if(params[1] < 1 || params[1] > 300) return ErrorMessage(playerid, "Время от 1 минут до 300");
	if(PI[params[0]][pAdmin] && params[0] != playerid) return ErrorMessage(playerid, "Игрок администратор");
	if(PI[params[0]][pJailTime]>0) return ErrorMessage(playerid, "Игрок в тюрьме");
	if(PI[params[0]][pDMZ] >= 1) PI[params[0]][pDMZ] = 0;
	ResetPlayerWeapons(params[0]);
	if(PI[params[0]][pDRInections])
	{
		params[1] = params[1]/2;
		SendClientMessage(params[0], 0x6ab1ffaa, "Поскольку вы владелец Brilliant VIP, время заключения уменьшено вдвое.");
		SCMF(params[0], 0x6ab1ffaa, "Вам необходимо отсидеть: %d секунд.", params[1]*60);
	}
	PI[params[0]][pPrisonTime] = params[1]*60;
	SpawnPlayer(params[0]);
	UpdatePlayerData(params[0], "pPrisonTime", PI[params[0]][pPrisonTime]);
	GameTextForPlayer(params[0], "~w~YOU IN ~R~PRISON", 5000, 4);
	string = "";
	format(string, MAX_STR, "Администратор %s посадил в тюрьму %s на %d минут. Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1], params[2]);
	SendClientMessageToAll(COLOR_LIGHTRED, string);
	format(string, MAX_STR, "Вы помещены в тюрьму администратором %s на %d минут. Причина: %s", PI[playerid][pNames], params[1], params[2]);
	SendClientMessage(params[0], COLOR_LIGHTRED, string);
	gAdmin[playerid][ADMIN_JAIL] += 1;
	UpdateAdminData(playerid, "jail", gAdmin[playerid][ADMIN_JAIL]);

	PI[playerid][last_reason] = params[2];

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /prison на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:offprison(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 2))
		return true;
	new name[MAX_PLAYER_NAME + 1], minute, reason[100];
	if(sscanf(params, "s[24]ds[128]", name, minute, reason)) return SendEsp(playerid, "/offprison [ИМЯ] [минуты] [причина]");
	if(minute < 1 || minute > 180) return ErrorMessage(playerid, "Время от 1 минут до 180");
 	mysql_format(1, string, sizeof(string), "SELECT * FROM `accounts` WHERE `Name` = '%e'", name);
 	mysql_tquery(1, string, "offprison", "isis", playerid, name, minute, reason);
	return 1;
}
publics:offprison(playerid, name[], minute, reason[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Вы указали несуществующий ник");
	if(GetPlayerID(name) != -1) return ErrorMessage(playerid, "Игрок онлайн");
	if(cache_get_field_content_int(0, "pAdmin") > 0) return ErrorMessage(playerid, "Игрок администратор");
	if(cache_get_field_content_int(0, "pJailTime") > 0) return ErrorMessage(playerid, "Игрок в тюрьме");
	mysql_format(1, string, sizeof(string), "UPDATE `accounts` SET `pPrisonTime` = '%d' WHERE `Name` = '%e'", minute * 60, name);
	mysql_tquery(1, string);
	format(string, MAX_STR, "Администратор %s посадил в тюрьму %s на %d минут в оффлайне. Причина: %s", PI[playerid][pNames], name, minute, reason);
	SendClientMessageToAll(COLOR_LIGHTRED, string);
	gAdmin[playerid][ADMIN_JAIL] += 1;
	UpdateAdminData(playerid, "jail", gAdmin[playerid][ADMIN_JAIL]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offprison на %s", PI[playerid][pNames], name);
	logs(1, log_str, 0);

	return 1;
}
cmd:loadmaterials(playerid)
{
	if(!IsAGang(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Вы не бандит!");
	new veh = VehicleEnters[playerid];
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_WHITE, "Вы должны быть в машине!");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_WHITE, "Вы не водитель!");
	if(!(veh == matsfuraballas[0] || veh == matsfurarifa[0] || veh == matsfuravagos[0] || veh == matsfuraactek[0] || veh == matsfuragrove[0])) return SendClientMessage(playerid, COLOR_WHITE, "Вы не в фургоне для развозки материалов.");
	switch(PI[playerid][pMember])
	{
	case 12: if(Furi[veh-matsfuraballas[0]][gBallas] >= 15000) return SendClientMessage(playerid, COLOR_RED, "Фургон заполнен!");
	case 13: if(Furi[veh-matsfuravagos[0]][gVagos] >= 15000) return SendClientMessage(playerid, COLOR_RED, "Фургон заполнен!");
	case 15: if(Furi[veh-matsfuragrove[0]][gGrove] >= 15000) return SendClientMessage(playerid, COLOR_RED, "Фургон заполнен!");
	case 17: if(Furi[veh-matsfuraactek[0]][gAztek] >= 15000) return SendClientMessage(playerid, COLOR_RED, "Фургон заполнен!");
	case 18: if(Furi[veh-matsfurarifa[0]][gRifa] >= 15000) return SendClientMessage(playerid, COLOR_RED, "Фургон заполнен!");
	}
	if(Start{veh} == true)
	{
		DestroyPickup(autopick_mats[veh]);
		DestroyDynamic3DTextLabel(mats3Dtxt[veh]);
		Start{veh} = false;
		SendClientMessage(playerid, COLOR_WHITE, "Вы отменили загрузку материалов.");
		return 1;
	}
	new tmpcar = VehicleEnters[playerid];
	new Float:X, Float:Y, Float:Z;
	GetVehiclePos(tmpcar, X, Y, Z);
	GetXYInFrontOfPlayer(playerid, X, Y, -4.5);
	new alarm, doors, bonnet, boot, objective;
	SetVehicleParamsEx(tmpcar, VEHICLE_PARAMS_OFF, VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
	autopick_mats[tmpcar] = CreatePickup(2358, 23, X, Y, Z+0.5);
    string = "";
	switch(PI[playerid][pMember])
	{
	case 12:
		{
			format(string, 32, "%d/15000", Furi[tmpcar-matsfuraballas[0]][gBallas]);
			mats3Dtxt[tmpcar] = CreateDynamic3DTextLabel(string, COLOR_SERVER, X, Y, Z+0.3, 40.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0);
		}
	case 13:
		{
			format(string, 32, "%d/15000", Furi[tmpcar-matsfuravagos[0]][gVagos]);
			mats3Dtxt[tmpcar] = CreateDynamic3DTextLabel(string, COLOR_SERVER, X, Y, Z+0.3, 40.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0);
		}
	case 15:
		{
			format(string, 32, "%d/15000", Furi[tmpcar-matsfuragrove[0]][gGrove]);
			mats3Dtxt[tmpcar] = CreateDynamic3DTextLabel(string, COLOR_SERVER, X, Y, Z+0.3, 40.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0);
		}
	case 17:
		{
			format(string, 32, "%d/15000", Furi[tmpcar-matsfuraactek[0]][gAztek]);
			mats3Dtxt[tmpcar] = CreateDynamic3DTextLabel(string, COLOR_SERVER, X, Y, Z+0.3, 40.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0);
		}
	case 18:
		{
			format(string, 32, "%d/15000", Furi[tmpcar-matsfurarifa[0]][gRifa]);
			mats3Dtxt[tmpcar] = CreateDynamic3DTextLabel(string, COLOR_SERVER, X, Y, Z+0.3, 40.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0);
		}
	}
	SendClientMessage(playerid, COLOR_WHITE, "Заполните фургон материалами...");
	RemovePlayerFromVehicle(playerid);
	Start{tmpcar} = true;
	return 1;
}
cmd:checkbelt(playerid, params[])
{
    if (!IsACop(playerid))
            return 1;

    new targetid;
    if (sscanf(params, "u", targetid))
            return SendClientMessage(playerid, -1, ""#information"Используйте: /checkbelt [ID]");

    if (PLAYER_STATE_DRIVER != GetPlayerState(targetid))
            return ErrorMessage(playerid, "Персонаж не в автомобиле!");

    if(GetPlayerDistanceToPlayer(playerid, targetid) > 2.0)
            return ErrorMessage(playerid, "Персонаж не рядом с вами!");

    SCMF(playerid, -1, ""#information"У %s %s ремень безопасности.", PI[playerid][pNames], player_belt_cars{targetid} ? ("пристёгнут") : ("не пристёгнут"));
    return 1;
}
cmd:accept(playerid, params[])
{
	if(sscanf(params, "s[30]", params[0])) return ErrorMessage(playerid, "/accept [name]");
 	string = "";
	if(!strcmp(params[0], "witness", true))
	{
		if(GetPVarInt(playerid, "MarryWitnessOffer") == 999) return ErrorMessage(playerid, "Вам не предлагали быть свидетелем!");
		if(!ProxDetectorS(10.0, playerid, GetPVarInt(playerid, "MarryWitnessOffer"))) return ErrorMessage(playerid, "Игрок, который просил, чтобы вы были свидетелем не рядом с вами!");
		format(string, MAX_STR, "Вы приняли предложение  %s's быть свидетелем на свадьбе", PI[GetPVarInt(playerid, "MarryWitnessOffer")][pNames]);
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		format(string, MAX_STR, "%s согласился быть вашим свидетелем на свадьбе.", PI[playerid][pNames]);
		SendClientMessage(GetPVarInt(playerid, "MarryWitnessOffer"), 0x6ab1ffaa, string);
		SetPVarInt(GetPVarInt(playerid, "MarryWitnessOffer"), "MarryWitness", playerid);
		SetPVarInt(playerid, "MarryWitnessOffer", 999);
		return 1;
	}
	else if(!strcmp(params[0], "marriage", true))
	{
		if(PlayerToPoint(10.0, playerid, 2238.2517, -36.0515, 606.8203) || PlayerToPoint(10.0, playerid, -1988.6638, 1117.8837, 54.4726))
		{
			if(GetPVarInt(playerid, "ProposeOffer") == 999) return ErrorMessage(playerid, "Вам ни кто не предлагал!");
			if(!ProxDetectorS(10.0, playerid, GetPVarInt(playerid, "ProposeOffer"))) return ErrorMessage(playerid, "Жених/Невеста не рядом с Вам!");
			if(GetPVarInt(GetPVarInt(playerid, "ProposeOffer"), "MarryWitness") == 999) return ErrorMessage(playerid, "У него/неё нет свидетеля!");
			if(ProxDetectorS(12.0, GetPVarInt(playerid, "ProposeOffer"), GetPVarInt(GetPVarInt(playerid, "ProposeOffer"), "MarryWitness")))
			{
				format(string, MAX_STR, "Вы приняли предложение от %s's", PI[GetPVarInt(playerid, "ProposeOffer")][pNames]);
				SendClientMessage(playerid, 0x6ab1ffaa, string);
				format(string, MAX_STR, "%s приняла Ваш запрос быть Вашей Женой.", PI[playerid][pNames]);
				SendClientMessage(GetPVarInt(playerid, "ProposeOffer"), 0x6ab1ffaa, string);
				format(string, MAX_STR, "[Зарегистрирован новый брак] %s с %s", PI[playerid][pNames], PI[GetPVarInt(playerid, "ProposeOffer")][pNames]);
				SendClientMessageToAll(0xFC6DECFF, string);
				Hook_GivePlayerMoney(GetPVarInt(playerid, "ProposeOffer"), -100000);
				PI[playerid][pMarried] = 1;
				PI[GetPVarInt(playerid, "ProposeOffer")][pMarried] = 1;
				strmid(PI[playerid][pFamilyName], PI[GetPVarInt(playerid, "ProposeOffer")][pNames], 0, strlen(PI[GetPVarInt(playerid, "ProposeOffer")][pNames]), 255), UpdatePlayerDataEx(playerid, "pFamilyName", PI[playerid][pFamilyName]);
				strmid(PI[GetPVarInt(playerid, "ProposeOffer")][pFamilyName], PI[playerid][pNames], 0, strlen(PI[playerid][pNames]), 255), UpdatePlayerDataEx(GetPVarInt(playerid, "ProposeOffer"), "pFamilyName", PI[GetPVarInt(playerid, "ProposeOffer")][pFamilyName]);
				UpdatePlayerData(playerid, "pMarried", 1);
				UpdatePlayerData(GetPVarInt(playerid, "ProposeOffer"), "pMarried", 1);
				SetPVarInt(playerid, "ProposeOffer", 999);
				SetPVarInt(playerid, "MarryWitness", 999);
			}
		}
		else ErrorMessage(playerid, "Вы не у церкви!");
	}
	else if(!strcmp(params[0], "ticket", true))
	{
		if(GetPVarInt(playerid, "TicketOffer") == 999) return ErrorMessage(playerid, "Вам не выписывали штраф!");
		if (!ProxDetectorS(5.0, playerid, GetPVarInt(playerid, "TicketOffer"))) return ErrorMessage(playerid, "Полицейскйи не рядом с вами!");
		format(string, MAX_STR, "Вы оплатили штраф в размере %d вирт офицеру %s.", GetPVarInt(playerid, "TicketMoney"), PI[GetPVarInt(playerid, "TicketOffer")][pNames]);
		SendClientMessage(playerid, COLOR_BLUE, string);
		format(string, MAX_STR, "%s оплатил штраф в размере %d вирт.", PI[playerid][pNames], GetPVarInt(playerid, "TicketMoney"));
		SendClientMessage(GetPVarInt(playerid, "TicketOffer"), COLOR_BLUE, string);
		Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "TicketMoney"));
		Hook_GivePlayerMoney(GetPVarInt(playerid, "TicketOffer"), -GetPVarInt(playerid, "TicketMoney"));
		SetPVarInt(playerid, "TicketOffer", 999);
		DeletePVar(params[0], "TicketMoney");
		return 1;
	}
	else if(!strcmp(params[0], "drugs", true))
	{
		if(GetPVarInt(playerid, "DrugOffer") == 999) return ErrorMessage(playerid, "Вам никто не предлагал купить наркотики!");
		if(PI[playerid][pCash] < GetPVarInt(playerid, "DrugPrice")) return ErrorMessage(playerid, "У вас нет столько денег!");
		if(PI[playerid][pDrugs] + GetPVarInt(playerid, "DrugGram") > 500) return ErrorMessage(playerid, "Нельзя иметь больше 500 наркотиков одного типа!");
		format(string, MAX_STR, "Вы купили %d грамм наркотиков за %d вирт у %s.", GetPVarInt(playerid, "DrugGram"), GetPVarInt(playerid, "DrugPrice"), PI[GetPVarInt(playerid, "DrugOffer")][pNames]);
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		format(string, MAX_STR, "%s купил у вас %d грамм наркотиков за %d вирт", PI[playerid][pNames], GetPVarInt(playerid, "DrugGram"), GetPVarInt(playerid, "DrugPrice"));
		SendClientMessage(GetPVarInt(playerid, "DrugOffer"), 0x6ab1ffaa, string);
		Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "DrugPrice"));
		Hook_GivePlayerMoney(GetPVarInt(playerid, "DrugOffer"), GetPVarInt(playerid, "DrugPrice"));
		PI[playerid][pDrugs] += GetPVarInt(playerid, "DrugGram");
		PI[GetPVarInt(playerid, "DrugOffer")][pDrugs] -= GetPVarInt(playerid, "DrugGram");
		SetPVarInt(playerid, "DrugOffer", 999);
		DeletePVar(playerid, "DrugGram");
		DeletePVar(playerid, "DrugPrice");
		return 1;
	}
	else if(!strcmp(params[0], "vehicle", true))
	{
		if(GetPVarInt(playerid, "CarOffer") == 999) return ErrorMessage(playerid, "Вам никто не предлагал купить машину!");
		if(!ProxDetectorS(8.0, playerid, GetPVarInt(playerid, "CarOffer"))) return ErrorMessage(playerid, "Игрок слишком далеко от вас!");
		if(PI[playerid][pCash] < GetPVarInt(playerid, "CarPrice")) return ErrorMessage(playerid, "У вас нет столько денег на руках!");
		PI[playerid][pCar][0] = PI[GetPVarInt(playerid, "CarOffer")][pCar][0];
		PI[GetPVarInt(playerid, "CarOffer")][pCar][0] = 510;
		UpdatePlayerData(GetPVarInt(playerid, "CarOffer"), "pCar", 510);
		Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "CarPrice"));
		Hook_GivePlayerMoney(GetPVarInt(playerid, "CarOffer"), GetPVarInt(playerid, "CarPrice"));
		format(string, MAX_STR, "Вы продали машину %s за %d вирт!", PI[playerid][pNames], GetPVarInt(playerid, "CarPrice"));
		SendClientMessage(GetPVarInt(playerid, "CarOffer"), 0x6ab1ffaa, string);
		format(string, MAX_STR, "Вы купили машину у %s за %d вирт!", PI[GetPVarInt(playerid, "CarOffer")][pNames], GetPVarInt(playerid, "CarPrice"));
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		if(caridhouse[playerid][0] != 0)
		{
			DestroyVehicle(caridhouse[playerid][0]);
			caridhouse[playerid][0] = 0;
		}
		DestroyVehicle(caridhouse[GetPVarInt(playerid, "CarOffer")][0]);
		SetPVarInt(playerid, "CarOffer", 999);
		DeletePVar(playerid, "CarPrice");
	}
	//pPnumber
	else if(!strcmp(params[0], "card, true"))
	{
		if(GetPVarInt(playerid, "CardOffer") == 999) return ErrorMessage(playerid, "Вам никто не предлагал купить номер телефона!");
		if(!ProxDetectorS(8.0, playerid, GetPVarInt(playerid, "CardOffer"))) return ErrorMessage(playerid, "Игрок слишком далеко от вас!");
		if(PI[playerid][pCash] < GetPVarInt(playerid, "CardPrice")) return ErrorMessage(playerid, "У вас нет столько денег на руках!");
		PI[playerid][pPnumber] = PI[GetPVarInt(playerid, "CardOffer")][pPnumber];
		PI[GetPVarInt(playerid, "CardOffer")][pPnumber] = RandomEx(100000, 999999);
		UpdatePlayerData(GetPVarInt(playerid, "CardOffer"), "pPnumber", PI[GetPVarInt(playerid, "CardOffer")][pPnumber]);
		UpdatePlayerData(playerid, "pPnumber", PI[playerid][pPnumber]);
		Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "CardPrice"));
		Hook_GivePlayerMoney(GetPVarInt(playerid, "CardOffer"), GetPVarInt(playerid, "CardPrice"));
		format(string, MAX_STR, "Вы продали номер %s за %d вирт! Ваш новый номер: %s.", PI[playerid][pNames], GetPVarInt(playerid, "CardPrice"), PI[GetPVarInt(playerid, "CardOffer")][pPnumber]);
		SendClientMessage(GetPVarInt(playerid, "CardOffer"), 0x6ab1ffaa, string);
		format(string, MAX_STR, "Вы купили номер у %s за %d вирт!", PI[GetPVarInt(playerid, "CardOffer")][pNames], GetPVarInt(playerid, "CardPrice"));
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		SetPVarInt(playerid, "CardOffer", 999);
		DeletePVar(playerid, "CardPrice");
	}
	else if(!strcmp(params[0], "house", true))
	{
		if(GetPVarInt(playerid, "hCena") < 90000 && GetPVarInt(playerid, "hProdaet") == 999) return ErrorMessage(playerid, "Вам не предлагали купить дом.");
		if(!ProxDetectorS(8.0, playerid, GetPVarInt(playerid, "hProdaet"))) return ErrorMessage(playerid, "Вы далеко от продавца.");
		new house = PI[GetPVarInt(playerid, "hProdaet")][pHouse];
		if(PI[playerid][pCash] < GetPVarInt(playerid, "hCena"))return ErrorMessage(playerid, "У вас нет столько денег на руках!");
		Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "hCena"));
		Hook_GivePlayerMoney(GetPVarInt(playerid, "hProdaet"), GetPVarInt(playerid, "hCena"));
		PI[playerid][pHouse] = PI[GetPVarInt(playerid, "hProdaet")][pHouse];
		PI[GetPVarInt(playerid, "hProdaet")][pHouse] = -1;
		UpdatePlayerData(playerid, "pPhousekey", PI[playerid][pHouse]);
		UpdatePlayerData(GetPVarInt(playerid, "hProdaet"), "pPhousekey", -1);
		strmid(HouseInfo[house][hOwner], PI[playerid][pNames], 0, strlen(PI[playerid][pNames]), 255);
		SCMF(playerid, COLOR_GREEN, "Вы купили дом у %s за %d вирт.", PI[GetPVarInt(playerid, "hProdaet")][pNames], GetPVarInt(playerid, "hCena"));
		SCMF(GetPVarInt(playerid, "hProdaet"), COLOR_GREEN, "Вы продали дом %s за %d вирт.", PI[playerid][pNames], GetPVarInt(playerid, "hCena"));
		if(caridhouse[GetPVarInt(playerid, "hProdaet")][0] != 0 || caridhouse[GetPVarInt(playerid, "hProdaet")][2] != 0 || caridhouse[GetPVarInt(playerid, "hProdaet")][3] != 0)
		{
			DestroyVehicle(caridhouse[GetPVarInt(playerid, "hProdaet")][0]), caridhouse[GetPVarInt(playerid, "hProdaet")][0] = 0;
			DestroyVehicle(caridhouse[GetPVarInt(playerid, "hProdaet")][2]), caridhouse[GetPVarInt(playerid, "hProdaet")][2] = 0;
			DestroyVehicle(caridhouse[GetPVarInt(playerid, "hProdaet")][3]), caridhouse[GetPVarInt(playerid, "hProdaet")][3] = 0;
		}
		mysql_format(1, string, sizeof(string), "UPDATE `house` SET `hOwner` = '%e' WHERE hID = '%i'", PI[playerid][pNames], PI[playerid][pHouse]);
		mysql_tquery(1, string);
		SetPVarInt(playerid, "hProdaet", 999);
		DeletePVar(playerid, "hCena");
		return 1;
	}
	else if(!strcmp(params[0], "livels", true))
	{
		if(GetPVarInt(playerid, "LiveOfferls") == 999) return ErrorMessage(playerid, "Вам никто не предлагал дать интервью");
		if(!ProxDetectorS(5.0, playerid, GetPVarInt(playerid, "LiveOfferls"))) return ErrorMessage(playerid, "Вы далеко от репортёра");
		SetPVarInt(GetPVarInt(playerid, "LiveOfferls"), "TalkingLivels", 2);
		SendClientMessage(GetPVarInt(playerid, "LiveOfferls"), -1, ""#information"Используйте /live чтобы закончить интервью");
		lNews[playerid] = false;
		lNews[GetPVarInt(playerid, "LiveOfferls")] = false;
		SetPVarInt(playerid, "LiveOfferls", 999);
		SetPVarInt(playerid, "TalkingLivels", 2);
		SendClientMessage(playerid, COLOR_SERVER, "Вы даёте интервью в прямом эфире радио Los Santos");
		return 1;
	}
	else if(!strcmp(params[0], "refill", true))
	{
		if(GetPVarInt(playerid, "RefillOffer") == 999) return ErrorMessage(playerid, "Вам не предлагали заправиться!");
		if(PI[playerid][pCash] < GetPVarInt(playerid, "RefillPrice")) return ErrorMessage(playerid, "Не достаточно денег!");
		new car = VehicleEnters[GetPVarInt(playerid, "RefillOffer")];
		format(string, MAX_STR, "Механик %s заправил вашу машину на 200 литров за %d вирт.", PI[GetPVarInt(playerid, "RefillOffer")][pNames], GetPVarInt(playerid, "RefillPrice"));
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		format(string, MAX_STR, "Вы заправили машину  %s за %d вирт.", PI[playerid][pNames], GetPVarInt(playerid, "RefillPrice"));
		SendClientMessage(GetPVarInt(playerid, "RefillOffer"), 0x6ab1ffaa, string);
		Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "RefillPrice"));
		Hook_GivePlayerMoney(GetPVarInt(playerid, "RefillOffer"), -GetPVarInt(playerid, "RefillPrice"));
		if(!IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetVehicleModel(car) == 481 || GetVehicleModel(car) == 509 || GetVehicleModel(car) == 510) return SendClientMessage(playerid, COLOR_SERVER, ".: Вы не в машине, или машина не требует бензина :.");
		if(VehInfo[car][vFuel] >= 200.0) return SendClientMessage(playerid, COLOR_GRAD1, "Ваш бак полон");
		else VehInfo[car][vFuel] = 200.0;
		return 1;
	}
	else if(!strcmp(params[0], "zone", true))
	{
		if(GetPVarInt(playerid, "ZoneOffer") == 999) return ErrorMessage(playerid, "Вам ни кто не предлагал территорию!");
		if(PI[playerid][pCash] < GetPVarInt(playerid, "ZonePrice")) return ErrorMessage(playerid, "У вас недостаточно денег!");
		for(new i = 0; i < sizeof(GZInfo); i++)
		{
			if(PlayerToKvadrat(playerid, GZInfo[i][gCoords][0], GZInfo[i][gCoords][1], GZInfo[i][gCoords][2], GZInfo[i][gCoords][3]))
			{
				if(GZInfo[i][gFrakVlad] != GetPVarInt(playerid, "sellzone")) return 	ErrorMessage(playerid, "Вам не предлагали купить эту территорию");
				GZInfo[i][gFrakVlad] = PI[playerid][pMember];
    			frac_gangzone[GZInfo[i][gFrakVlad]]--;
                frac_gangzone[PI[playerid][pMember]]++;
				GangZoneStopFlashForAll(GZInfo[i][gID]);
				GangZoneHideForAll(GZInfo[i][gID]);
				GangZoneShowForAll(GZInfo[i][gID], GetGangZoneColor(i));
				SaveGZ(i);
			}
		}
		format(string, MAX_STR, "Вы купили территорию у %s за %d вирт.", PI[GetPVarInt(playerid, "ZoneOffer")], GetPVarInt(playerid, "ZonePrice"));
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		format(string, MAX_STR, "Вы продали территорию %s за %d вирт.", PI[playerid][pNames], GetPVarInt(playerid, "ZonePrice"));
		SendClientMessage(GetPVarInt(playerid, "ZoneOffer"), 0x6ab1ffaa, string);
		Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "ZonePrice"));
		Hook_GivePlayerMoney(GetPVarInt(playerid, "ZoneOffer"), GetPVarInt(playerid, "DrugPrice"));
		SetPVarInt(playerid, "ZoneOffer", 999);
		DeletePVar(playerid, "ZonePrice");
		DeletePVar(playerid, "sellzone");
	}
	else if(!strcmp(params[0], "free", true))
	{
		if(GetPVarInt(playerid, "FreeOffer") == 999) return ErrorMessage(playerid, "Вам ни кто не предлагал услуши адвоката!");
		if(!GetPVarInt(playerid, "SposobOffer"))
		{
			if(PI[playerid][pCash] < GetPVarInt(playerid, "FreePrice")) return ErrorMessage(playerid, "У вас недостаточно денег!");
			format(string, MAX_STR, "Вы приняли услуги адвоката %s за %d вирт.", PI[GetPVarInt(playerid, "FreeOffer")][pNames], GetPVarInt(playerid, "FreePrice"));
			SendClientMessage(playerid, 0x6ab1ffaa, string);
			format(string, MAX_STR, " Вы выпустили %s из тюрьмы за %d вирт.", PI[playerid][pNames], GetPVarInt(playerid, "FreePrice"));
			SendClientMessage(GetPVarInt(playerid, "FreeOffer"), 0x6ab1ffaa, string);
			Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "FreePrice"));
			Hook_GivePlayerMoney(GetPVarInt(playerid, "FreeOffer"), GetPVarInt(playerid, "ZonePrice"));
			SetPVarInt(playerid, "FreeOffer", 999);
			DeletePVar(playerid, "FreePrice");
			DeletePVar(playerid, "SposobOffer");
			SetPlayerInterior(playerid, 0);
			SetPlayerPos(playerid, 1553.4962, -1675.2714, 16.1953);//Тюрьма
			SetPlayerFacingAngle(playerid, 95.0636);
			PI[playerid][pJailTime] = 0;
			PI[playerid][pWanted] = 0;
			mysql_format(1, string, 144, "UPDATE `accounts` SET `pJailTime` = '0', `pWanted` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
			mysql_tquery(1, string);
			SendClientMessage(playerid, COLOR_ISPOLZUY, "Вы заплатили свой долг обществу, теперь вы свободны!");
			SetPlayerWantedLevel(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);
			return 1;
		}
		if(GetPVarInt(playerid, "SposobOffer") == 1)
		{
			if(PI[playerid][pBank] < GetPVarInt(playerid, "FreePrice")) return ErrorMessage(playerid, "У вас недостаточно денег!");
			format(string, MAX_STR, "Вы приняли услуги адвоката %s за %d вирт.", PI[GetPVarInt(playerid, "FreeOffer")][pNames], GetPVarInt(playerid, "FreePrice"));
			SendClientMessage(playerid, 0x6ab1ffaa, string);
			format(string, MAX_STR, " Вы выпустили %s из тюрьмы за %d вирт.", PI[playerid][pNames], GetPVarInt(playerid, "FreePrice"));
			SendClientMessage(GetPVarInt(playerid, "FreeOffer"), 0x6ab1ffaa, string);
			PI[playerid][pBank] -=GetPVarInt(playerid, "FreePrice");
			UpdatePlayerData(playerid, "pBank", PI[playerid][pBank]);
			Hook_GivePlayerMoney(GetPVarInt(playerid, "FreeOffer"), GetPVarInt(playerid, "FreePrice"));
			SetPVarInt(playerid, "FreeOffer", 999);
			DeletePVar(playerid, "FreePrice");
			DeletePVar(playerid, "SposobOffer");
			SetPlayerInterior(playerid, 0);
			SetPlayerPos(playerid, 1553.4962, -1675.2714, 16.1953);//Тюрьма
			SetPlayerFacingAngle(playerid, 95.0636);
			PI[playerid][pJailTime] = 0;
			PI[playerid][pWanted] = 0;
			mysql_format(1, string, 144, "UPDATE `accounts` SET `pJailTime` = '0', `pWanted` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
			mysql_tquery(1, string);
			SendClientMessage(playerid, COLOR_ISPOLZUY, "Вы заплатили свой долг обществу, теперь вы свободны!");
			SetPlayerWantedLevel(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);
			return 1;
		}
		return 1;
	}
	else if(!strcmp(params[0], "repair", true))
	{
		if(GetPVarInt(playerid, "RepairOffer") == 999) return ErrorMessage(playerid, "Вам не предлагали чинить машину!");
		if(PI[playerid][pCash] < GetPVarInt(playerid, "RepairPrice")) return ErrorMessage(playerid, "У вас не хватает денег!");
		if(!IsPlayerInAnyVehicle(playerid)) return 1;
		SetVehicleHealth(VehicleEnters[playerid], 1000.0);
		RepairVehicle(VehicleEnters[playerid]);
		format(string, MAX_STR, "Механик %s починил вашу машину за %d вирт", PI[GetPVarInt(playerid, "RepairOffer")][pNames], GetPVarInt(playerid, "RepairPrice"));
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		format(string, MAX_STR, "Вы починили автомобиль %s за %d вирт", PI[playerid][pNames], GetPVarInt(playerid, "RepairPrice"));
		SendClientMessage(GetPVarInt(playerid, "RepairOffer"), 0x6ab1ffaa, string);
		Hook_GivePlayerMoney(playerid, -GetPVarInt(playerid, "RepairPrice"));
		Hook_GivePlayerMoney(GetPVarInt(playerid, "RepairOffer"), -GetPVarInt(playerid, "RefillPrice"));
		SetPVarInt(playerid, "RepairOffer", 999);
		DeletePVar(playerid, "RepairPrice");
		return 1;
	}
	return 1;
}
cmd:salut(playerid)
{
	if !GetPVarInt(playerid, "salute_zariad") *then return ErrorMessage(playerid, "У Вас нет салютов");
	if(GetPlayerInterior(playerid) != 0) return ErrorMessage(playerid, "Нельзя использовать в интерьере");
	if(IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "Нельзя запускать салют в машине");
	if(GetPVarInt(playerid, "salut_check") == 2) return ErrorMessage(playerid, "Нельзя поставить больше двух коробок салюта сразу");
	if GetPVarInt(playerid, "salute_zariad") == 50 *then
	{
		new Float:x, Float:y, Float:z, id;
		id = FindSalut();
		GetPlayerPos(playerid, x, y, z);
		SALUTEINFOS[id][SalutePos][0] = x+1.5;
		SALUTEINFOS[id][SalutePos][1] = y;
		SALUTEINFOS[id][SalutePos][2] = z;
		SALUTEINFOS[id][Salute] = 50;
		SALUTEINFOS[id][SaluteUse] = true;
		SALUTEINFOS[id][SaluteBox] = CreateDynamicObject(964, x+1.5, y, z-1, 0.0, 0.0, 0.0);
		SALUTEINFOS[id][SaluteTimer] = SetTimerEx("SaluteMachineTimer", floatround((400 + random(300)) * 0.26), false, "ii", id, playerid);
		SendClientMessage(playerid, COLOR_GREY, "Успешно: Отойдите подальше, что бы Вас не задело");
		GivePVarInt(playerid, "salut_check", 1);
		DeletePVar(playerid, "salute_zariad");
	}
	if GetPVarInt(playerid, "salute_zariad") == 150 *then
	{
		new Float:x, Float:y, Float:z, id;
		id = FindSalut();
		GetPlayerPos(playerid, x, y, z);
		SALUTEINFOS[id][SalutePos][0] = x+1.5;
		SALUTEINFOS[id][SalutePos][1] = y;
		SALUTEINFOS[id][SalutePos][2] = z;
		SALUTEINFOS[id][Salute] = 150;
		SALUTEINFOS[id][SaluteUse] = true;
		SALUTEINFOS[id][SaluteBox] = CreateDynamicObject(964, x+1.5, y, z-1, 0.0, 0.0, 0.0);
		SALUTEINFOS[id][SaluteTimer] = SetTimerEx("SaluteMachineTimer", floatround((400 + random(300)) * 0.26), false, "ii", id, playerid);
		SendClientMessage(playerid, COLOR_GREY, "Успешно: Отойдите подальше, что бы Вас не задело");
		GivePVarInt(playerid, "salut_check", 1);
		DeletePVar(playerid, "salute_zariad");
	}
	if GetPVarInt(playerid, "salute_zariad") == 350 *then
	{
		new Float:x, Float:y, Float:z, id;
		id = FindSalut();
		GetPlayerPos(playerid, x, y, z);
		SALUTEINFOS[id][SalutePos][0] = x+1.5;
		SALUTEINFOS[id][SalutePos][1] = y;
		SALUTEINFOS[id][SalutePos][2] = z;
		SALUTEINFOS[id][Salute] = 350;
		SALUTEINFOS[id][SaluteUse] = true;
		SALUTEINFOS[id][SaluteBox] = CreateDynamicObject(964, x+1.5, y, z-1, 0.0, 0.0, 0.0);
		SALUTEINFOS[id][SaluteTimer] = SetTimerEx("SaluteMachineTimer", floatround((400 + random(300)) * 0.26), false, "ii", id, playerid);
		SendClientMessage(playerid, COLOR_GREY, "Успешно: Отойдите подальше, что бы Вас не задело");
		GivePVarInt(playerid, "salut_check", 1);
		DeletePVar(playerid, "salute_zariad");
	}
	return 1;
}
cmd:minet(playerid, params[])
{
	if(PI[playerid][pJob] != 3) return ErrorMessage(playerid, "Вы не работаете проституткой!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREEN, "Введите: /minet [id]");
	if(!IsPlayerConnected(params[0])) return 1;
	if(params[0] == playerid) return 1;
	if(!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с Вами!");
	ApplyAnimation(params[0], "BLOWJOBZ", "BJ_COUCH_END_P", 4.1, 0, 1, 1, 1, 5, 1);
	ApplyAnimation(playerid, "BLOWJOBZ", "BJ_COUCH_END_W", 4.1, 0, 1, 1, 1, 5, 1);
	SCMF(playerid, COLOR_GREEN, "Вы сделали минет %s(%d)!", PI[params[0]][pNames], params[0]);
	SCMF(params[0], COLOR_SERVER, "Вам сделала минет проститутка %s(%d)!", PI[playerid][pNames], playerid);
	return 1;
}
cmd:sex(playerid, params[])
{
	if(PI[playerid][pJob] != 3) return ErrorMessage(playerid, "Вы не работаете проституткой!");
	if(GetPVarInt(playerid, "TimeSex") > unix) return ErrorMessage(playerid, "Вы еще не отошли от прошлого секса!");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_GREEN, "Введите: /sex [id] [цена]");
	if(!IsPlayerConnected(params[0])) return 1;
	//if(PI[params[0]][pSex] == 2) return ErrorMessage(playerid, "Игрок женского пола!");
	if(!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с Вами!");
	if(params[1] < 1 || params[1] > 50000) return ErrorMessage(playerid, "Цена должна быть не ниже 1 и не выше 50.000$!");
	if(PI[params[0]][pCash] < params[1]) return ErrorMessage(playerid, "У игрока нет денег!");
	string = "";
	format(string, 128, "%s[%d] предложил(-а) Вам заняться сексом за %i$. Вы согласны?", PI[playerid][pNames], playerid, params[1]);
	ShowPlayerDialog(params[0], 8584, DIALOG_STYLE_MSGBOX, ""SERVER"Интимное предложение", string, "Принять", "Отмена");
	SetPVarInt(params[0], "SexOffer", playerid);
	SetPVarInt(params[0], "SexMoney", params[1]);
	return 1;
}
cmd:connect(playerid)
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	SCMF(playerid, COLOR_SERVER, "Вы %s информацию о подключенных игроках", GetPVarInt(playerid, "ConnectInfo") ? ("отключили") : ("включили"));
	SetPVarInt(playerid, "ConnectInfo", GetPVarInt(playerid, "ConnectInfo") ? false : true);
	return 1;
}
cmd:contract(playerid, params[])
{
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, "/contract [ид] [сумма]");
	if(params[1] < 10000 || params[1] > 100000) return SendClientMessage(playerid, COLOR_GREY, "Сумма контракта должна быть минимум $10000, и максимум $100000!");
	if (!IsPlayerConnected(params[0])) return 1;
	if(PI[params[0]][pAdmin] > 7) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете заказать данного человека.");
	if(PI[playerid][pMember] == 24) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете заказать человека.");
	if(PI[params[0]][pMember] == 24) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете заказать данного человека.");
	if(IsACop(params[0]) && params[1] < 50000) return SendClientMessage(playerid, COLOR_GREY, "Голова данного человека стоит больше чем вы предлогаете.");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете заказать себя!");
	if(PI[params[0]][pContract]) return SendClientMessage(playerid, COLOR_GREY, "Данная жертва уже была заказана, хитманы не могут её принять.");
	if(PI[playerid][pCash] < params[1]) return SendClientMessage(playerid, COLOR_GREY, "Вы решили нас обмануть? У вас нету денег!");
	Hook_GivePlayerMoney(playerid, -params[1]);
	PI[params[0]][pHeadValue] += params[1];
	string = "";
	format(string, 100, "Внимание, поступил новый заказ цена головы заказчика %d вирт.", params[1]);
	SendFractionMessage(24, COLOR_SERVER, string);
	SCMF(playerid, COLOR_WHITE, "Вы успешно заказали %s за %d вирт.", PI[params[0]][pNames], params[1]);
	PI[params[0]][pContract] = 600;
	return 1;
}
cmd:hmask(playerid)
{
	if(!PlayerToPoint(50, playerid, 1070.0541, -319.6607, 73.9922)) return SendClientMessage(playerid, COLOR_GREY, "Вы не можете переодеваться на людях. Езжайте на свою базу.");
	if(PI[playerid][pLeader] == 24 || PI[playerid][pMember] == 24) ShowPlayerDialog(playerid, 4819, DIALOG_STYLE_LIST, ""SERVER"Маскировка", ""WHITE"Маскировка Фракций\nСнять маскировку", "Выбрать", "Выход");
	return 1;
}
cmd:menu(playerid)
{
	if(!PlayerToPoint(200, playerid, 1105.88, -309.35, 75.51)) return SendClientMessage(playerid, -1, "Вы не на базе");
	if(PI[playerid][pMember] == 24 || PI[playerid][pLeader] == 24)
	{
		ShowPlayerDialog(playerid, 7763, DIALOG_STYLE_LIST, "Портативный компьютер", ""SERVER"\
			[00] Доступные Контракты\n\
			[01] Проверить контракт\n\
			[02] Отменить заказ\n\
			[03] Приобрести оружие\n\
			[04] Члены агенства {32CD32}Online\n\
			[05] Надеть маску (Выключить клист)\n\
			", "Далее", "Закрыть");
	}
	return 1;
}
cmd:rep(playerid, params[])
{
	if(sscanf(params, "us[10]", params[0], params[1])) return SendClientMessage(playerid, -1, ""#information"Введите: /rep [id] [+/-]");
	if(strlen(params[1]) > 10) return 1;
	if(!IsPlayerConnected(params[0])) return 1;
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя самому себе!");
	if(PI[playerid][pPayDayHad] < 3) return ErrorMessage(playerid, "Вы не отыграли 3 часа");
	if(GetPVarInt(playerid, "AntiFloodRep") > unix) return ErrorMessage(playerid, "Попробуйте снова через 60 секунды");
	SetPVarInt(playerid, "AntiFloodRep", unix + 60);
	if(!strcmp(params[1], "+", true))
	{
		PI[params[0]][pReputation] ++;
		UpdatePlayerData(params[0], "pReputation", PI[params[0]][pReputation]);
		SCMF(playerid, -1, ""#good"Вы повысили репутацию %s(%d), теперь у него %i репутации!", PI[params[0]][pNames], params[0], PI[params[0]][pReputation]);
		SCMF(params[0], -1, ""#information"%s(%d) повысил Вам репутацию, Ваша репутация %i", PI[playerid][pNames], playerid, PI[params[0]][pReputation]);
		return 1;
	}
	if(!strcmp(params[1], "-", true))
	{
		PI[params[0]][pReputation] --;
		UpdatePlayerData(params[0], "pReputation", PI[params[0]][pReputation]);
		SCMF(playerid, -1, ""#good"Вы понизили репутацию %s(%d), теперь у него %i репутации!", PI[params[0]][pNames], params[0], PI[params[0]][pReputation]);
		SCMF(params[0], -1, ""#information"%s(%d) понизил Вам репутацию, Ваша репутация %i", PI[playerid][pNames], playerid, PI[params[0]][pReputation]);
		return 1;
	}
	else return 1;
}
cmd:getrep(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREEN, "Введите: /getrep [id]");
	if(!IsPlayerConnected(params[0])) return 1;
	SCMF(playerid, COLOR_GREEN, "Name: %s | Репутация: %i", PI[params[0]][pNames], PI[params[0]][pReputation]);
	return 1;
}
cmd:repadmin(playerid, params[])
{
	if(sscanf(params, "us[10]", params[0], params[1])) return SendClientMessage(playerid, -1, ""#information"Введите: /repadmin [id] [+/-]");
	if(strlen(params[1]) > 10) return 1;
	if(!IsPlayerConnected(params[0])) return 1;
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя самому себе!");
	if(PI[playerid][pPayDayHad] < 3) return ErrorMessage(playerid, "Вы не отыграли 3 часа");
	if(PI[playerid][pGiveAdmRep]) return ErrorMessage(playerid, "Вы уже выдавали, следующий раз только при получении нового уровня!");
	if(!strcmp(params[1], "+", true))
	{
		PI[params[0]][pAdmReputation] ++;
		UpdatePlayerData(params[0], "pAdmReputation", PI[params[0]][pAdmReputation]);
		SCMF(playerid, -1, ""#good"Вы повысили репутацию администратору %s(%d), теперь у него %i админ-репутации!", PI[params[0]][pNames], params[0], PI[params[0]][pAdmReputation]);
		SCMF(params[0], -1, ""#information"%s(%d) повысил Вам репутацию, Ваша админ-репутация %i", PI[playerid][pNames], playerid, PI[params[0]][pAdmReputation]);
		PI[playerid][pGiveAdmRep] = 1;
		UpdatePlayerData(playerid, "pGiveAdmRep", 1);
		return 1;
	}
	if(!strcmp(params[1], "-", true))
	{
		PI[params[0]][pAdmReputation] --;
		UpdatePlayerData(params[0], "pAdmReputation", PI[params[0]][pAdmReputation]);
		SCMF(playerid, -1, ""#good"Вы понизили репутацию администратору %s(%d), теперь у него %i админ-репутации!", PI[params[0]][pNames], params[0], PI[params[0]][pAdmReputation]);
		SCMF(params[0], -1, ""#information"%s(%d) понизил Вам репутацию, Ваша админ-репутация %i", PI[playerid][pNames], playerid, PI[params[0]][pAdmReputation]);
		PI[playerid][pGiveAdmRep] = 1;
		UpdatePlayerData(playerid, "pGiveAdmRep", 1);
		return 1;
	}
	else return 1;
}
