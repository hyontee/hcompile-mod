{
	string = "";
	for(new i;i<7;i++)
	{
		new gunnameD[24];
		GetWeaponName(gGunID[i], gunnameD, 24);
		if(!i) format(string, sizeof(string), "%s", gunnameD);
		else format(string, sizeof(string), "%s\n%s", string, gunnameD);
