cmd:pay(playerid, params[])
{
	if(sscanf(params, "dd", params[0], params[1])) return ErrorMessage(playerid, "/pay [id] [сумма]");
	if(params[1] < 1 || params[1] > 10000000) return SendClientMessage(playerid, COLOR_GRAD1, "Нельзя передать меньше $1 и больше $10000000.");
	if(playerid == params[0]) return 1;
	if (!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GRAD1, "Вы слишком далеко.");
	if(params[1] <= 0) return 1;
	if(PI[playerid][pCash] < params[1]) return SendClientMessage(playerid, COLOR_GRAD1, "У вас нет столько денег");
	if (params[1] < 0 && PI[playerid][pCash] < params[1]) return SendClientMessage(playerid, COLOR_GRAD1, "У вас нет столько денег");
	Hook_GivePlayerMoney(params[0], params[1]);
	Hook_GivePlayerMoney(playerid, -params[1]);
	string = "";
	format(string, MAX_STR, "Вы передали %s[%d], %d вирт.", PI[params[0]][pNames], params[0], params[1]);
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	SendClientMessage(playerid, COLOR_GRAD1, string);
	format(string, MAX_STR, "Вы получили %d вирт от %s[%d].", params[1], PI[playerid][pNames], playerid);
	SendClientMessage(params[0], COLOR_GRAD1, string);
	PlayerPlaySound(params[0], 1052, 0.0, 0.0, 0.0);
	format(string, SMALL_SIZE, "достал бумажник и передал деньги %s", PI[params[0]][pNames]);
	SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 30.0, 10000);
	return 1;
}
