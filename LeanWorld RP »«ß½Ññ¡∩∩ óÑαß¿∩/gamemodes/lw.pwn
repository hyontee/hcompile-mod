		return ShowPlayerDialog(playerid, 214, DIALOG_STYLE_MSGBOX, !""SERVER"Телепорт", ""WHITE"Вы уверены что хотите переместиться на поставленную точку?", "Да", "Нет");
	}
	return true;
}
