		}
	}
	else format(text, 115, ""WHITE"Город: {"#cBLUE"}Отсутствует"WHITE"\nРайон: {"#cBLUE"}Отсутствует"WHITE"\nДом: {"#cBLUE"}Отсутствует"WHITE"");
	if(PI[params[0]][pMember] != 0) format(Member, sizeof(Member), ""WHITE"Место работы: {"#cBLUE"}%s"WHITE"\nДолжность: {"#cBLUE"}%s"WHITE"", GetMember[PI[params[0]][pMember]-1], PlayerRank[PI[params[0]][pMember]-1][PI[params[0]][pRank]-1]);
	else format(Member, 100, ""WHITE"Место работы: {"#cBLUE"}Отсутствует"WHITE"\nДолжность: {"#cBLUE"}Отсутствует"WHITE"");
	new nationaly = PI[params[0]][pNationaly];
	string = "";
	new fio[2][24];
	split(PI[params[0]][pNames], fio, '_');
	format(string, sizeof(string), ""WHITE"\tПАСПОРТНЫЕ ДАННЫЕ\nИмя: {"#cBLUE"}%s"WHITE"\nФамилия: {"#cBLUE"}%s"WHITE"\nЛет в штате: {"#cBLUE"}%d"WHITE"\nВозраст: {"#cBLUE"}%d лет"WHITE"\nНациональность: {"#cBLUE"}%s"WHITE"\nЗаконопослушность: {"#cBLUE"}%d"WHITE"\n\
	Уровень розыска: {"#cBLUE"}%d"WHITE"\n\n\tМЕСТО ЖИТЕЛЬСТВА\n%s\n\n\tТРУДОВОЕ УСТРОЙСТВО\n%s",
	fio[0], fio[1], PI[params[0]][pLevel], PI[params[0]][pAge], ((!nationaly) ? ("Неизвестно") : (nationaly == 1) ? ("Американец") : (nationaly == 2) ? ("Японец") : (nationaly == 3) ? ("Итальянец") : (nationaly == 4) ? ("Мексиканец") : (nationaly == 5) ? ("Латиноамериканец") : (nationaly == 6) ? ("Испанец") : (nationaly == 7) ? ("Русский") : (nationaly == 8) ? ("Португалец") : ("Француз")), PI[params[0]][pZakonp], PI[params[0]][pWanted], text, Member);
	ShowPlayerDialog(playerid, 000, DIALOG_STYLE_MSGBOX, "{"#cBLUE"}База данных полиции", string, "Принять", "");
	return 1;
}
cmd:showudost(playerid, params[])
{
	if(!IsACop(playerid) && !IsAArm(playerid)) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/showudost [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Вы слишком далеко!");
	if(GetPVarInt(params[0], "Spectate")) return ErrorMessage(playerid, "Вы слишком далеко!");
	string = "";
	format(string, 150, "Имя: %s\nТелефон: %d\nВозраст: %d\nПодразделение: %s\nРанг: %s", PI[playerid][pNames], PI[playerid][pPnumber], PI[playerid][pLevel], FI[PI[playerid][pMember]][fName], PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1]);
	ShowPlayerDialog(params[0], 10036, DIALOG_STYLE_MSGBOX, ""SERVER"Удостоверение", string, "Закрыть", "");
	format(string, 80, "* %s показал(-а) своё удостоверение %s'у", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	format(string, SMALL_SIZE, "показал(-а) своё удостоверение %s'у", PI[params[0]][pNames]);
	SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 30.0, 10000);
	return 1;
}
cmd:switchmafia(playerid)
{
	if(!GetAccessAdmin(playerid, 11))
		return true;
	//if(gAdminReason[playerid][ADMIN_SWITCHMAFIA]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	string = "";
	for(new i = 1; i <= BIZES; i++) format(string, sizeof(string), "%sBusiness: %s - Владелец: %s\n", string, BizInfo[i][bName], GetMN(BizInfo[i][bKrisha]));
	ShowPlayerDialog(playerid, 5958, DIALOG_STYLE_LIST, ""SERVER"Выберите бизнес для измены владельца:", string, "Далее", "Отмена");
	return 1;
}
cmd:captcd(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 11))
		return true;

	new t; gettime(t);
	if(t < 7 && t > 1) return ErrorMessage(playerid, "Использовать команду можно только с 7:00 до 1:00");
	if(sscanf(params,"d",params[0])) return SendEsp(playerid, "/captcd [минуты]");
	if(params[0] < 0 || params[0] > 20) return SCM(playerid, COLOR_WHITE, "Время можно установить от 0 до 20.");
	CaptureTime = params[0];
	SCM(playerid, COLOR_GREY, "Время до захвата территорий успешно установлено.");

	format(string, 150, "Администратор %s[%d] установил время до начала капта: %i минут(-а, -ы)", PI[playerid][pNames], playerid, params[0]);
	SendAdminMessage(COLOR_GREY, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /captcd", PI[playerid][pNames]);
	logs(1, log_str, 0);

	return 1;
}
CMD:agm(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(sscanf(params, "u", params[0]))
	{
		if(AGM[playerid])
		{
			AGM[playerid] = false;
			return SCM(playerid, -1, "GM отключен");
		}
		else
		{
			AGM[playerid] = true;
			return SCM(playerid, -1, " GM включен");
		}
	}
	else
	{
	    if(PI[playerid][pAdmin] < 14) return true;
	    if(!IsPlayerConnected(params[0])) return SCM(playerid, COLOR_GREY, "Игрок оффлайн!");
		if(AGM[params[0]])
		{
		    AGM[params[0]] = false;
		    new strs[72];
		    format(strs, sizeof(strs), " GM для %s отключен", Name(params[0]));
		    SCM(playerid, -1, strs);
		}
		else
		{
			AGM[params[0]] = true;
		    new strs[72];
		    format(strs, sizeof(strs), " GM для %s включен", Name(params[0]));
		    SCM(playerid, -1, strs);
		}
	}
	return true;
}
cmd:gzcolor(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1)) return true;
	if(gAdminReason[playerid][ADMIN_GZCOLOR]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params,"d",params[0])) return SendEsp(playerid, "/gzcolor [банда]");
	if(params[0] != 12 && params[0] != 13 && params[0] != 15 && params[0] != 17 && params[0] != 18) return 1;
	for(new i = 0 ; i < sizeof(GZInfo); i++) if(PlayerToKvadrat(playerid,GZInfo[i][gCoords][0], GZInfo[i][gCoords][1],GZInfo[i][gCoords][2],GZInfo[i][gCoords][3]))
	{
		new str[79 + MAX_PLAYER_NAME + 40];
		format(str, sizeof str, "[A] Администратор %s отдал территорию %s банде %s. ID территории: (%d)", PI[playerid][pNames], FI[GZInfo[i][gFrakVlad]][fName], FI[params[0]][fName], i);
		SendAdminMessage(COLOR_GREY, str);
  		GZInfo[i][gFrakVlad] = params[0];
		frac_gangzone[GZInfo[i][gFrakVlad]]--;
		frac_gangzone[params[0]]++;
		UpdateStoreGang(GZInfo[i][gFrakVlad]), UpdateStoreGang(params[0]);
		GangZoneStopFlashForAll(GZInfo[i][gID]);
		GangZoneHideForAll(GZInfo[i][gID]);
		GangZoneShowForAll(GZInfo[i][gID],GetGangZoneColor(i));
		SendFractionMessage(params[0],COLOR_BLUE,"[F] Ваша банда захватила новую территорию");
		SaveGZ(i);
		break;
	}

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /gzcolor", PI[playerid][pNames]);
	logs(1, log_str, 0);
	return 1;
}
cmd:cuff(playerid, params[])
{
	if(!IsACop(playerid)) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/cuff [id]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Игрок оффлайн");
	if(PlayerTied{playerid} > false)  return SendClientMessage(playerid, COLOR_WHITE, "Вы связаны!");
	if(IsACop(params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Вы не можете надеть наручники на законника");
	if(GetPVarInt(params[0], "PlayerCuffed") == 2) return SendClientMessage(playerid, COLOR_WHITE, "На этого человека уже одеты наручники");
	if(!PI[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_WHITE, "Вы не можете надеть наручники на этого человека (он не в розыске)");
	if(!ProxDetectorS(2.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Рядом с вами никого нет!");
	if(!GetPVarInt(params[0], #tazer_dest)) return SendClientMessage(playerid, COLOR_WHITE, "Игрок не оглушен, используйте тазер.");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_WHITE, "Вы не можете надеть наручники на самого себя!");
	string = "";
	format(string, SMALL_SIZE, "На Вас надел наручники %s.", PI[playerid][pNames]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	format(string, SMALL_SIZE, "Вы надели наручники на %s.", PI[params[0]][pNames]);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, 100, "* %s надел(а) на %s наручники.", PI[playerid][pNames], PI[params[0]][pNames]);
	SetPlayerAttachedObject(params[0], 0, 19418, 6, -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035, 0.891999, 1.000000, 1.168000);
	GameTextForPlayer(params[0], "~r~Cuffed", 2500, 3);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_CUFFED);
	SetPVarInt(params[0], "PlayerCuffed", 2);
	SetPVarInt(params[0], "PlayerCuffedTime", 3600);
	return 1;
}
cmd:uncuff(playerid, params[])
{
	if(!IsACop(playerid)) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/uncuff [id]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Игрок оффлайн!");
	if(PlayerTied{playerid} > false)  return SendClientMessage(playerid, COLOR_WHITE, "Вы связаны!");
	if (!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Рядом с вами никого нет!");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_WHITE, "Вы не можете снять наручники с самого себя!");
	if(GetPVarInt(params[0], "PlayerCuffed") != 2) return SendClientMessage(playerid, COLOR_WHITE, "Этот игрок не в наручниках!");
	string = "";
	format(string, SMALL_SIZE, "С Вас снял наручники %s.", PI[playerid][pNames]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	GameTextForPlayer(params[0], "~g~Uncuffed", 2500, 3);
	format(string, SMALL_SIZE, "Вы сняли наручники с %s.", PI[params[0]][pNames]);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	SetPVarInt(params[0], "PlayerCuffed", 0);
	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE); RemovePlayerAttachedObject(params[0], 0); TogglePlayerControllable(params[0], true); DeletePVar(params[0], "PlayerCuffed");
	return 1;
}
cmd:find(playerid, params[])
{
	if(!IsACop(playerid) && PI[playerid][pMember] != 24 && PI[playerid][pMember] != 23 && PI[playerid][pMember] != 25) return 1;
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
    if(!ShowMap[playerid])
    {
        if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, ""#information"Используйте: /find [ID]");
       	if(GetPlayerInterior(params[0])) SendClientMessage(playerid, -1, ""#information"Человек возможно находиться в интерьере.");
		if(params[0] == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
        if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок не найден!");
        SetPVarInt(playerid, "give_id", params[0]);
        TogglePlayerMap(playerid, true);
    }
    else
    {
       DeletePVar(playerid, "give_id");
       TogglePlayerMap(playerid, false);
       SendClientMessage(playerid, -1, ""#good"Слежка за игроком окончена!");
    }
    return 1;
}
cmd:refill(playerid, params[])
{
	if(PI[playerid][pJob] != 1) return ErrorMessage(playerid, "Вы не механик!");
	if(!GetPVarInt(playerid, "ContractMechanic")) return ErrorMessage(playerid, "У Вас не подписан контракт с заправкой!");
	if(sscanf(params, "dd", params[0], params[1])) return ErrorMessage(playerid, "/refill [id] [цена]");
	if(params[1] < 1 || params[1] > 5000) return ErrorMessage(playerid, "Нельзя меньше 1, и больше 5000!");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(GetVehicleModel(VehicleEnters[playerid]) != 525) return ErrorMessage(playerid, "Вы не на эвакуаторе!");
	if(!ProxDetectorS(8.0, playerid, params[0]) && !IsPlayerInAnyVehicle(params[0])) return ErrorMessage(playerid, "Он не в машине!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы указали свой ID!");
	string = "";
	format(string, MAX_STR, "Вы предложили %s заправить его машину за %d вирт.", PI[params[0]][pNames], params[1]);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, MAX_STR, "Механик %s предлагает заправить вашу машину за %d вирт.(Введите /accept refill), чтобы потвердить заправку.", PI[playerid][pNames], params[1]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	SetPVarInt(params[0], "RefillOffer", playerid);
	SetPVarInt(params[0], "RefillPrice", params[1]);
	if(caridhouse[playerid][0] == VehicleEnters[playerid]) SetPVarInt(params[0], "id_car", 1);
	if(caridhouse[playerid][1] == VehicleEnters[playerid]) SetPVarInt(params[0], "id_car", 2);
	if(caridhouse[playerid][2] == VehicleEnters[playerid]) SetPVarInt(params[0], "id_car", 3);
	return 1;
}
cmd:changehouse(playerid, params[])
{
	if(sscanf(params, "dd", params[0], params[1]))  return SendClientMessage(playerid, COLOR_WHITE, ""#information"/changehouse [id] [цена]");
	if(PI[playerid][pHouse] == -1) return ErrorMessage(playerid, "У вас нету дома.");
	if(params[1] < 90000 || params[1] > 25000000) return ErrorMessage(playerid, "Цена не может быть меньше 90000 и больше 25000000.");
	if(!IsPlayerConnected(params[0])) return 1;
	if(!ProxDetectorS(5.0, playerid, params[0])) return ErrorMessage(playerid, "Вы далеко от покупателя.");
	if(PI[params[0]][pHouse] != -1) return ErrorMessage(playerid, "У игрока есть дом.");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете продать дом самому себе.");
	SCMF(params[0], COLOR_GREEN, "Игрок %s предлагает вам купить его дом за %d вирт. Введите /accept house.", PI[playerid][pNames], params[1]);
	SCMF(playerid, COLOR_GREEN, "Вы предложили %s купить ваш дом за %d вирт.", PI[params[0]][pNames], params[1]);
	SetPVarInt(params[0], "hProdaet", playerid);
	SetPVarInt(params[0], "hCena", params[1]);
	return 1;
}
cmd:changecar(playerid, params[])
{
	new caren = GetVehicleModel(caridhouse[playerid][0]);
	if(caren == 510) return ErrorMessage(playerid, "У Вас велосипед");
	if(PI[playerid][pHouse] == -1) return ErrorMessage(playerid, "У вас нет дома");
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/changecar [id] [цена]");
	if(params[1] < 1 || params[1] > 1000000000) return ErrorMessage(playerid, "Нельзя меньше 1, и больше 100000000!");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с вами!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете продать самому себе машину!");
	string = "";
	format(string, MAX_STR, "Вы предложили %s купить вашу машину за %d вирт.", PI[params[0]][pNames], params[1]);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, MAX_STR, "%s предлагает вам купить его машину за %d вирт.(( Введите /accept vehicle, чтобы совершить сделку )).", PI[playerid][pNames], params[1]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	format(string, MAX_STR, "* %s предложил(а) %s купить его машину", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	SetPVarInt(params[0], "CarOffer", playerid);
	SetPVarInt(params[0], "CarPrice", params[1]);
	return 1;
}
cmd:changecard(playerid, params[])
{
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/changecard [id] [цена]");
	if(params[1] < 1 || params[1] > 1000000000) return ErrorMessage(playerid, "Нельзя меньше 1, и больше 100000000!");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с вами!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете продать самому себе номер телефона!");
	string = "";
	format(string, MAX_STR, "Вы предложили %s купить ваш номер за %d вирт.", PI[params[0]][pNames], params[1]);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, MAX_STR, "%s предлагает вам купить его номер (%s) за %d вирт.(( Введите /accept card, чтобы совершить сделку )).", PI[playerid][pNames], PI[playerid][pPnumber], params[1]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	format(string, MAX_STR, "* %s предложил(а) %s купить его номер телефона", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	SetPVarInt(params[0], "CardOffer", playerid);
	SetPVarInt(params[0], "CardPrice", params[1]);
	return 1;
}
cmd:repair(playerid, params[])
{
	if(PI[playerid][pJob] != 1) return ErrorMessage(playerid, "Вы не механик!");
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_GRAD2, " Введите: /repair [id] [цена]");
	if(params[1] < 1 || params[1] > 1000) return ErrorMessage(playerid, "Нельзя меньше 1, и больше 1000!");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(GetVehicleModel(VehicleEnters[playerid]) != 525) return ErrorMessage(playerid, "Вы не на эвакуаторе!");
	if(!ProxDetectorS(8.0, playerid, params[0]) && !IsPlayerInAnyVehicle(params[0])) return ErrorMessage(playerid, "Он не в машине!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете чинить машину самому себе!");
	string = "";
	format(string, MAX_STR, "Вы предложили %s отремонтировать его машину за %d вирт.", PI[params[0]][pNames], params[1]);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, MAX_STR, "Механик %s предлагает отремонтировать ваш автомобиль за %d вирт.(Введите /accept repair), чтобы совершить починку.", PI[playerid][pNames], params[1]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	SetPVarInt(params[0], "RepairOffer", playerid);
	SetPVarInt(params[0], "RepairPrice", params[1]);
	return 1;
}
cmd:eject(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "Вы должны быть в машине!");
	if(GetPlayerState(playerid)!=PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "Вы не водитель!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/eject [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете выкинуть из машины себя!");
	if(!IsPlayerInVehicle(params[0], VehicleEnters[playerid])) return ErrorMessage(playerid, "Не рядом с вами!");
	string = "";
	if(GetPVarInt(params[0], "PlayerCuffed") > 0)
	{
		RemovePlayerFromVehicle(params[0]);
		format(string, MAX_STR, "Вы выкинули из машины %s, наручники сломались!", PI[params[0]][pNames]);
		SendClientMessage(playerid, 0x6495EDFF, string);
		format(string, MAX_STR, "Вас выкинул из машины %s, наручники сломались!!", PI[playerid][pNames]);
		SendClientMessage(params[0], 0x6495EDFF, string);
		TogglePlayerControllable(params[0], 1);
		SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(params[0], 0);
		DeletePVar(params[0], "PlayerCuffed");
	}
	else
	{
		format(string, MAX_STR, "Вы выкинули из машины %s!", PI[params[0]][pNames]);
		SendClientMessage(playerid, 0x6495EDFF, string);
		format(string, MAX_STR, "Вас выкинул из машины %s!", PI[playerid][pNames]);
		SendClientMessage(params[0], 0x6495EDFF, string);
		RemovePlayerFromVehicle(params[0]);
		PlayerTied{params[0]} = false;
		TogglePlayerControllable(params[0], 1);
	}
	return 1;
}
cmd:givemoney(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 12))
		return true;
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/money [ид] [сумма]");
	//if(gAdminReason[playerid][ADMIN_GIVEMONEY]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(!IsPlayerConnected(params[0])) return 1;
	string = "";
	format(string, 80, " %d вирт переведены на счёт игроку %s", params[1], PI[params[0]][pNames]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	PI[params[0]][pBank] += params[1];
	UpdatePlayerData(params[0], "pBank", PI[playerid][pBank]);
	format(string, SMALL_SIZE, "- Пополнение счёта на сумму: %d вирт", params[1]);
	SendClientMessage(params[0], COLOR_WHITE, string);
	format(string, SMALL_SIZE, "- Новый баланс в банке: %d вирт", PI[params[0]][pBank]);
	SendClientMessage(params[0], COLOR_WHITE, string);

	new str[120];
	format(str, sizeof(str), "выдал %i виртов", params[1]);
	AddaLog(PI[playerid][pNames], str, PI[params[0]][pNames], "", "", "");

	return 1;
}
cmd:setfracmoney(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 12))
		return true;
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/setfracmoney [ид организации] [сумма]");
	//if(gAdminReason[playerid][ADMIN_GIVEMONEY]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(params[0] < 1 || params[0] > 29) return SendClientMessage(playerid, COLOR_WHITE, ""#error"Неверный ID фракции");

	frac_money[params[0]] = params[1];
	UpdateFractionStore(params[0]);

	string = "";
	format(string, 200, "$%d - новый баланс счета фракции %s", params[1], GetMember[params[0] - 1]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	format(string, sizeof(string), "Администратор: %s установил счет фракции %s на $%d.", PI[playerid][pNames], GetMember[params[0] - 1], params[1]);
	SendAdminMessage(COLOR_SERVER, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /setfracmoney на %s", PI[playerid][pNames], GetMember[params[0] - 1]);
	logs(1, log_str, 0);

	return 1;
}
cmd:setfracheal(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 12)) return true;
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/setfracheal [ид организации] [сумма]");
	if(params[0] < 1 || params[0] > 29) return SendClientMessage(playerid, COLOR_WHITE, ""#error"Неверный ID фракции");

	frac_heal[params[0]] = params[1];
	UpdateFractionStore(params[0]);

	string = "";
	format(string, 200, "%d - новое количество аптечек у фракции %s", params[1], GetMember[params[0] - 1]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	format(string, sizeof(string), "Администратор: %s установил аптечки фракции %s на %d.", PI[playerid][pNames], GetMember[params[0] - 1], params[1]);
	SendAdminMessage(COLOR_SERVER, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /setfracheal на %s", PI[playerid][pNames], GetMember[params[0] - 1]);
	logs(1, log_str, 0);
	return 1;
}
cmd:id(playerid, params[])
{
	new Name[24], ids = 0;
	if(sscanf(params, "s[24]", Name)) return SendEsp(playerid, "/id [ name / id ]");
	SendClientMessage(playerid, COLOR_SERVER, "Игроки онлайн:");
	if(IsNumeric(Name))
	{
		if(IsPlayerConnected(strval(Name))) return SCMF(playerid, COLOR_WHITE, "%s id: %i", PI[strval(Name)][pNames], strval(Name));
	}
	foreach(Player, i)
	{
		if(strfind(PI[i][pNames], Name, true) == -1) continue;
		if(ids > 5) break;
		ids++;
		SCMF(playerid, COLOR_WHITE, "%i. %s [%i] | Ping: %i", ids, PI[i][pNames], i, GetPlayerPing(i));
	}
	if(!ids) return ErrorMessage(playerid, "Не найдено");
	else if(ids) SCMF(playerid, COLOR_GREY, "Найдено %i игроков", ids);
	return 1;
}
cmd:delete(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		new Name[24];
		if(sscanf(params, "s[24]", Name)) return SendClientMessage(playerid, COLOR_WHITE, " Введите: /del [name_akkaunt]");
		if(!strcmp(Name, FD1) || !strcmp(Name, FD2) || !strcmp(Name, FD3) || !strcmp(Name, FD4)) return 1;
		string = "";
		mysql_format(1, string, 120, "SELECT `Name` FROM `accounts` WHERE `Name` = '%e'", Name);
		mysql_tquery(1, string, "Delete", "ds", playerid, Name);
	}
	else ErrorMessage(playerid, "Вам недоступна эта функция!");
	return 1;
}
cmd:offban(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 13)) return true;
	if(EnableInfo[ban] == 0 && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return SendClientMessage(playerid, COLOR_LIGHTRED, "Бан временно отключен.");
	if(gAdminReason[playerid][ADMIN_OFFBAN]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(EnableInfo[ban] == 0) return SendClientMessage(playerid, COLOR_LIGHTRED, "Бан временно отключен.");
	new NAME[24], REASON[64];
	if(sscanf(params, "s[24]is[64]", NAME, params[0], REASON)) return SendClientMessage(playerid, -1, ""#information"Используйте: /offban [NAME] [DAYS] [REASON]");
    if(!strcmp(NAME, FD1) || !strcmp(NAME, FD2) || !strcmp(NAME, FD3) || !strcmp(NAME, FD4)) return SendClientMessage(playerid, COLOR_WHITE, "Основателей запрещено варнить");
	string = "";
	mysql_format(1, string, 128, "SELECT `Nick` FROM `BanList` WHERE `Nick` = '%e'", NAME);
	mysql_tquery(1, string, "OffBan", "isis", playerid, NAME, params[0], REASON);
	return 1;
}
publics:OffBan(playerid, NAME[], DAYS, REASON[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows) return ErrorMessage(playerid, "Игрок уже заблокирован!");
	if(GetPlayerID(NAME) != -1) return ErrorMessage(playerid, "Игрок онлайн");
	new data[16], un_ban_date = unix + DAYS*86400;
	format(data, sizeof(data), "%s", date("%dd.%mm.%yyyy", unix));
	mysql_format(1, string, sizeof(string), "INSERT INTO `BanList` (`Nick`, `Admin`, `Date`, `Reason`, `Days`, `UnbanDate`, `Status`) VALUES ('%e', '%e', '%e', '%e', '%i', '%d', '1')", NAME, PI[playerid][pNames], data, REASON, DAYS, un_ban_date);
	mysql_tquery(1, string);
	format(string, 164, "%s получил оффлайн блокировку от администратора: %s на %i дней. Причина: %s", NAME, PI[playerid][pNames], DAYS, REASON);
	SendClientMessageToAll(COLOR_LIGHTRED, string);
	gAdmin[playerid][ADMIN_BAN] += 1;
	UpdateAdminData(playerid, "ban", gAdmin[playerid][ADMIN_BAN]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offban на %s", PI[playerid][pNames], NAME);
	logs(1, log_str, 0);

	return 1;
}
cmd:offmute(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7)) return true;
	new name[24], reason[24];
	if(sscanf(params, "s[24]ds[24]", name, params[0], reason)) return SendEsp(playerid, "/offmute [ник] [минуты] [причина]");
    if(params[0] < 1 || params[0] > 180) return ErrorMessage(playerid, "Время от 1 минут до 180");
	if(!Reklama(playerid, reason)) return 1;
	string = "";
	mysql_format(1, string, 128, "SELECT * FROM `accounts` WHERE `Name` = '%e'", name);
	mysql_tquery(1, string, "OffMute", "isis", playerid, name, params[0], reason);
	return 1;
}
publics:OffMute(playerid, name[], min, reason[])
{
    new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Игрок не найден!");
	if(GetPlayerID(name) != -1) return ErrorMessage(playerid, "Игрок онлайн");
	mysql_format(1, string, 264, "UPDATE `accounts` SET `pMuteTime` = '%i' WHERE `Name` = '%e'", min * 60, name);
	mysql_tquery(1, string);
	format(string, MAX_STR, "Администратор %s заблокировал чат %s на %d минут offline. Причина: %s", PI[playerid][pNames], name, min, reason);
    SendClientMessageToAll(COLOR_LIGHTRED, string);
	gAdmin[playerid][ADMIN_MUTE] += 1;
	UpdateAdminData(playerid, "mute", gAdmin[playerid][ADMIN_MUTE]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offban на %s", PI[playerid][pNames], name);
	logs(1, log_str, 0);

	return 1;
}
cmd:avig(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1)) return true;
	if(gAdminReason[playerid][ADMIN_AVIG]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "ds[125]", params[0], params[1])) return SendEsp(playerid, "/avig [id] [причина]");
	if(GetPVarInt(playerid, "AFAvig") > unix) return ErrorMessage(playerid, "Использовать данную команду можно раз в 5 секунд");
	if(!PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Данный игрок не администратор");
	if(D_FULL(PI[params[0]][pNames]))
	{
        new strch[350];
		format(strch, sizeof(strch), "Администратор %s пытался выдать наказание %s, но лоханулся перед всеми и получил обратку :D", PI[playerid][pNames], PI[params[0]][pNames]);
		SendAdminMessage(COLOR_RED, strch);
        KickEx(playerid);
        return 1;
	}
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя выдать выговор самому себе");
	if(PI[params[0]][pImmunity] && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return ErrorMessage(playerid, "У администратора иммунитет!");
	if(!strcmp(PI[params[0]][pNames], FD1) || !strcmp(PI[params[0]][pNames], FD2) || !strcmp(PI[params[0]][pNames], FD3)
	|| !strcmp(PI[params[0]][pNames], FD4)) return SendClientMessage(playerid, COLOR_WHITE, "Основателей запрещено банить");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Данный игрок не найден");
	PI[params[0]][pAvig] ++;
	if(PI[params[0]][pAvig] >= 3)
	{
		format(string, sizeof(string), "Администратор %s выдал выговор администратору %s (3/3). Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], params[1]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		SCMF(params[0], COLOR_SERVER, "Администратор %s выдал Вам выговор и вы были сняты. Причина: %s", PI[playerid][pNames], params[1]);
		SCMF(playerid, COLOR_SERVER, "Вы сняли администратора %s. Причина: %s", PI[params[0]][pNames], params[1]);
		DeleteAdministration(params[0], PI[params[0]][pNames]);
	}
	else
	{
		UpdatePlayerData(params[0], "pAvig", PI[params[0]][pAvig]);
		format(string, sizeof(string), "Администратор %s выдал выговор администратору %s (%d/3). Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], PI[params[0]][pAvig], params[1]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		SCMF(params[0], COLOR_SERVER, "Администратор %s выдал Вам выговор. Причина: %s", PI[playerid][pNames], params[1]);
		SCMF(playerid, COLOR_SERVER, "Вы выдали выговор администратору %s. Причина: %s", PI[params[0]][pNames], params[1]);
	}
	SetPVarInt(playerid, "AFAvig", unix+5);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /avig на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:unavig(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(gAdminReason[playerid][ADMIN_AVIG]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "ds[125]", params[0], params[1])) return SendEsp(playerid, "/unavig [id] [причина]");
	if(GetPVarInt(playerid, "AFUNAvig") > unix) return ErrorMessage(playerid, "Использовать данную команду можно раз в 5 секунд");
	if(!PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Данный игрок не администратор");
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя снять выговор самому себе");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Данный игрок не найден");
	if(PI[params[0]][pAvig] == 0) return ErrorMessage(playerid, "У администратора нет выговоров");

	PI[params[0]][pAvig] --;
	UpdatePlayerData(params[0], "pAvig", PI[params[0]][pAvig]);
	format(string, sizeof(string), "Администратор %s снял выговор администратору %s (%d/3). Причина: %s", PI[playerid][pNames], PI[params[0]][pNames], PI[params[0]][pAvig], params[1]);
	SendAdminMessage(COLOR_LIGHTRED, string);
	SCMF(params[0], COLOR_SERVER, "Администратор %s снял Вам выговор. Причина: %s", PI[playerid][pNames], params[1]);
	SCMF(playerid, COLOR_SERVER, "Вы сняли выговор администратору %s. Причина: %s", PI[params[0]][pNames], params[1]);
	SetPVarInt(playerid, "AFUNAvig", unix+5);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /unavig на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:offavig(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1)) return true;
	if(gAdminReason[playerid][ADMIN_AVIG]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
    new name[24], reason[24];
	if(sscanf(params, "s[24]s[24]", name, reason)) return SendEsp(playerid, "/offavig [ник] [причина]");
	if(GetPVarInt(playerid, "AFAvig") > unix) return ErrorMessage(playerid, "Использовать данную команду можно раз в 5 секунд");
    if(!strcmp(name, FD1) || !strcmp(name, FD2) || !strcmp(name, FD3) || !strcmp(name, FD4)) return SendClientMessage(playerid, COLOR_WHITE, "Основателей запрещено банить");
    mysql_format(1, string, 128, "SELECT * FROM `accounts` WHERE `Name` = '%e'", name);
	mysql_tquery(1, string, "offAvig", "iss", playerid, name, reason);
	return 1;
}
cmd:offunavig(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1)) return true;
	if(gAdminReason[playerid][ADMIN_AVIG]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
    new name[24], reason[24];
	if(sscanf(params, "s[24]s[24]", name, reason)) return SendEsp(playerid, "/offunavig [ник] [причина]");
	if(GetPVarInt(playerid, "AFAvig") > unix) return ErrorMessage(playerid, "Использовать данную команду можно раз в 5 секунд");
    if(!strcmp(name, FD1) || !strcmp(name, FD2) || !strcmp(name, FD3) || !strcmp(name, FD4)) return SendClientMessage(playerid, COLOR_WHITE, "Основателей запрещено банить");
    mysql_format(1, string, 128, "SELECT * FROM `accounts` WHERE `Name` = '%e'", name);
	mysql_tquery(1, string, "offUNAvig", "iss", playerid, name, reason);
	return 1;
}
publics:offAvig(playerid, name[], reason[])
{
    new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Данный игрок не администратор");
	if(GetPlayerID(name) != -1) return ErrorMessage(playerid, "Игрок онлайн");
	new oldcount = cache_get_field_content_int(0, "pAvig");
	
    mysql_format(1, string, 264, "UPDATE `accounts` SET `pAvig` = '%i' WHERE `Name` = '%e'", oldcount + 1, name);
	mysql_tquery(1, string);

	if(oldcount >= 3)
	{
		format(string, sizeof(string), "Администратор %s выдал выговор администратору %s (3/3). Причина: %s", PI[playerid][pNames], name, reason);
		SendAdminMessage(COLOR_LIGHTRED, string);
		SCMF(playerid, COLOR_SERVER, "Вы сняли администратора %s. Причина: %s", name, reason);
		
		mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pImmunity` = '0' `pAvig` = '0' WHERE `Name` = '%e'", name);
		mysql_tquery(1, string);
		mysql_format(1, string, MAX_STR, "DELETE FROM `admin` WHERE `name`='%e'", name);
		mysql_tquery(1, string);
		mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", name);
		mysql_tquery(1, string);

		new log_str[256 + 1];
		format(log_str, sizeof(log_str), "%s был снят с админки", name);
		logs(1, log_str, 0);
	}
	else
	{
		format(string, sizeof(string), "Администратор %s выдал выговор администратору %s (%d/3). Причина: %s", PI[playerid][pNames], name, oldcount, reason);
		SendAdminMessage(COLOR_LIGHTRED, string);
		SCMF(playerid, COLOR_SERVER, "Вы выдали выговор администратору %s. Причина: %s", name, reason);
	}
	SetPVarInt(playerid, "AFAvig", unix+5);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offavig на %s", PI[playerid][pNames], name);
	logs(1, log_str, 0);
	return 1;
}
publics:offUNAvig(playerid, name[], reason[])
{
    new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Данный игрок не администратор");
	if(GetPlayerID(name) != -1) return ErrorMessage(playerid, "Игрок онлайн");
	new oldcount = cache_get_field_content_int(0, "pAvig");
	if(oldcount == 0) return ErrorMessage(playerid, "У администратора нет выговоров");

    mysql_format(1, string, 264, "UPDATE `accounts` SET `pAvig` = '%i' WHERE `Name` = '%e'", oldcount - 1, name);
	mysql_tquery(1, string);
	
	format(string, sizeof(string), "Администратор %s снял выговор администратору %s (%d/3). Причина: %s", PI[playerid][pNames], name, oldcount, reason);
	SendAdminMessage(COLOR_LIGHTRED, string);
	SCMF(playerid, COLOR_SERVER, "Вы сняли выговор администратору %s. Причина: %s", name, reason);
	SetPVarInt(playerid, "AFAvig", unix+5);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /offunavig на %s", PI[playerid][pNames], name);
	logs(1, log_str, 0);
	return 1;
}
cmd:offwarn(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 9)) return true;
	if(EnableInfo[warn] == 0 && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return SendClientMessage(playerid, COLOR_LIGHTRED, "Варны временно отключены.");
	if(gAdminReason[playerid][ADMIN_OFFWARN]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	new reason[32], Name[24];
	if(sscanf(params, "s[24]s[32]", Name, reason))  return SendEsp(playerid, "/offwarn [NAME] [REASON]");
	if(strlen(reason) > sizeof(reason)-1) return ErrorMessage(playerid, "Много символов!");
	if(!strcmp(Name, FD1) || !strcmp(Name, FD2) || !strcmp(Name, FD3) || !strcmp(Name, FD4)) return SendClientMessage(playerid, COLOR_WHITE, "Основателей запрещено варнить");
	string = "";
	mysql_format(1, string, 128, "SELECT `Name`, `pWarns` FROM `accounts` WHERE `Name` = '%e'", Name);
	mysql_tquery(1, string, "OffWarn", "iss", playerid, Name, reason);
	return 1;
}
cmd:offleader(playerid, params[])
{
 	if(gAdminReason[playerid][ADMIN_OFFLEADER]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	{
		if(sscanf(params, "s[30]", params[0])) return SendEsp(playerid, "/offleader [ник]");
		string = "";
		mysql_format(1, string, 100, "SELECT `Name` FROM `accounts` WHERE `Name` = '%e'", params[0]);
		mysql_tquery(1, string, "OffLeader", "ds", playerid, params[0]);
	}
	return 1;
}
