alias:sms("text");
cmd:nopromo(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(EnableInfo[promo] == 0)
		{
			SendClientMessage(playerid, COLOR_GREEN, "Промокоды включены!");
			EnableInfo[promo] = 1;
			mysql_tquery(1, "UPDATE `FDenable SET `enabled` = '1' WHERE `name` = 'promo'");
			return 1;
		}
		else
		{
			SendClientMessage(playerid, COLOR_RED, "Промокоды выключены!");
			EnableInfo[promo] = 0;
			mysql_tquery(1, "UPDATE `FDenable` SET `enabled` = '0' WHERE `name` = 'promo'");
			return 1;
		}
	}
	return 1;
}
cmd:nocmd(playerid, params[])
{
    if(D_FULL(PI[playerid][pNames]))
    {
	    string = ""WHITE"Параметр\t"WHITE"Значение\n";
	    format(stringer, sizeof(stringer), "{ffffff}Промо\t%s\n", (EnableInfo[promo])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
        format(stringer, sizeof(stringer), "{ffffff}Ban\t%s\n", (EnableInfo[ban])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}Warn\t%s\n", (EnableInfo[warn])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}Ответы\t%s\n", (EnableInfo[pm])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
        format(stringer, sizeof(stringer), "{ffffff}Kick\t%s\n", (EnableInfo[kick])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
        format(stringer, sizeof(stringer), "{ffffff}Бонус\t%s\n", (EnableInfo[bonus1])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
        format(stringer, sizeof(stringer), "{ffffff}Быстрая прокачка\t%s\n", (PayDayBonus[0])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
	    ShowPlayerDialog(playerid, 9723, DIALOG_STYLE_TABLIST_HEADERS, "Запретить команды:", string, "ОК", "Выйти");
	}
	return 1;
}
cmd:sms(playerid, params[])
{
	if(!PI[playerid][pPayDayHad]) return ErrorMessage(playerid, "Вы должны отыграть на сервере как минимум 1 час.");
	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, ""#net"У Вас кляп, вы не можете говорить!");
	if(PI[playerid][pMuteTime]) return SendClientMessage(playerid, COLOR_LIGHTRED, ""#net"У вас бан чата!");
	if(GetPVarInt(playerid, "takephone")) return SendClientMessage(playerid, COLOR_LIGHTRED, ""#net"У Вас нет телефона");
	if(GetPVarInt(playerid, "AntiFloodSMS") > unix) return SendClientMessage(playerid, COLOR_LIGHTRED, ""#net"Следущее SMS можно отправить через 10 секунд");
	if(sscanf(params, "ds[128]", params[0], params[1])) return ErrorMessage(playerid, "/sms [id] [текст]"), SendClientMessage(playerid, COLOR_WHITE, ""#information"Для OOC сообщений используйте /sendpm!");
	if(!Reklama(playerid, params[1])) return 1;
	if(params[0] == 1001)
	{
		SCMF(playerid, COLOR_YELLOW, "» Исходящее: %s. Получатель: San News тел. 1001", params[1]);
		SCM(playerid, COLOR_WHITE, "- Сообщение доставлено");
		if (Viktorina == -1) return SendClientMessage(playerid, COLOR_YELLOW, "» Входящее: К сожалению, в данный момент викторина не проводится. Отправитель: San News тел. 1001");
		else if (Viktorina == strval(params[1]))
		{
			Viktorina = -1;
			new prize = random(4);
			new prizeText[40];
			switch(prize)
			{
				case 0:
				{
					PI[playerid][pRubInfo] += 3;
					UpdatePlayerData(playerid, "pRub", PI[playerid][pRubInfo]);
					format(prizeText, 40, "3 донат-рубля");
				}
				case 1:
				{
					PI[playerid][pDonate] += 225;
					UpdatePlayerData(playerid, "pDonate", PI[playerid][pDonate]);
					format(prizeText, 40, "225 доната");
				}
				case 2:
				{
					Hook_GivePlayerMoney(playerid, 15000);
					format(prizeText, 40, "15000$");
				}
				case 3:
				{
					Hook_GivePlayerMoney(playerid, 500000);
					format(prizeText, 40, "500000$");
				}
			}
			SCMF(params[0], COLOR_YELLOW, "» Входящее: Вы выиграли %s! От имени San News мы вас поздравляем! Отправитель: San News тел. 1001", prizeText);
			string = "";
			format(string, sizeof(string), "Объявление: Приз текущей викторины (%s) выигрывает %s! Искренне поздравляем его от имени студии!", prizeText, PI[playerid][pNames]);
			SendClientMessageToAll(0x00D900C8, string);
		}
		else return SendClientMessage(playerid, COLOR_YELLOW, "» Входящее: К сожалению, ваш ответ неправильный. Попробуйте еще раз! Отправитель: San News тел. 1001");
	}
	if(!Reklama(playerid, params[1]) || !IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Абонент не в сети!");
	if(PhoneOnline{params[0]}) return ErrorMessage(playerid, "Телефон абонента выключен");
	PI[playerid][pBank] -= 20;
	UpdatePlayerData(playerid, "pBank", PI[playerid][pBank]);
	SCMF(params[0], COLOR_YELLOW, "» Входящее: %s. Отправитель: %s[%d] тел. %i", params[1], PI[playerid][pNames], playerid, PI[playerid][pPnumber]);
	PlayerPlaySound(params[0], 1052, 0.0, 0.0, 0.0);
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	SCMF(playerid, COLOR_YELLOW, "» Исходящее: %s. Получатель: %s[%d] тел. %i", params[1], PI[params[0]][pNames], params[0], PI[params[0]][pPnumber]);
	SendClientMessage(playerid, COLOR_WHITE, "- Сообщение доставлено");
	new stra[144];
	foreach(Player, i)
	{
		if(IsPlayerConnected(i) && ReadSMS[i])
		{
			format(stra, sizeof stra, "[SMS] %d -> %d: %s", playerid, params[0], params[1]);
			SendClientMessage(i, COLOR_GREEN, stra);
		}
	}
	string = "";
	format(string, SMALL_SIZE, "* %s отправил(-а) смс сообщение", PI[playerid][pNames]);
	ProxDetector(5.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	SetPVarInt(playerid, "AntiFloodSMS", unix + 10);
	return 1;
}
cmd:sendpm(playerid, params[])
{
	if(PI[playerid][pMuteTime]) return SendClientMessage(playerid, COLOR_LIGHTRED, ""#net"У вас бан чата!");
	if(GetPVarInt(playerid, "AntiFloodSMS") > unix) return SendClientMessage(playerid, COLOR_LIGHTRED, ""#net"Следущее сообщение можно отправить через 10 секунд");
	if(sscanf(params, "ds[128]", params[0], params[1])) return ErrorMessage(playerid, "/sendpm [id] [текст]");
	if(!Reklama(playerid, params[0])) return 1;
	if(params[0] > MAX_PLAYERS || params[0] < 0) return true;
	if(PMOnline{params[0]}) return ErrorMessage(playerid, "У игрока выключены личные сообщения.");
	SCMF(params[0], COLOR_YELLOW, ">> OOC Чат с %s[%d]: %s", PI[playerid][pNames], playerid, params[1]);
	PlayerPlaySound(params[0], 1052, 0.0, 0.0, 0.0);
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	SCMF(playerid, COLOR_YELLOW, ">> OOC Чат с %s[%d]: %s", PI[params[0]][pNames], params[0], params[1]);
	new stra[600];
	foreach(Player, i)
	{
		if(IsPlayerConnected(i) && ReadPM[i])
		{
			stra = "";
			format(stra, sizeof stra, "[PM] %d -> %d: %s", playerid, params[0], params[1]);
			SendClientMessage(i, COLOR_GREEN, stra);
		}
	}
	SetPVarInt(playerid, "AntiFloodSMS", unix + 10);
	return 1;
}
alias:m("megaphone");
cmd:m(playerid, params[])
{
	if(!IsACop(playerid) && !IsAArm(playerid)) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "(/m)egaphone [текст]");
	if(PI[playerid][pMuteTime]) return SCMF(playerid, -1, ""#net" У Вас бан чата! До снятия: %d секунд(ы)", PI[playerid][pMuteTime]);
	new vehicleid = VehicleEnters[playerid];
	string = "";
	switch(PI[playerid][pMember])
	{
	case 1:
		{
			if(!Megaphone(vehicleid)) return SendClientMessage(playerid, COLOR_GRAD2, ""SERVER"x {AFAFAF}Вы не в служебной машине!");
			format(string, MAX_STR, "{{ Офицер %s: %s }}", PI[playerid][pNames], params[0]);
			ProxDetector(80.0, playerid, string, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER);
		}
	case 2:
		{
			if(!Megaphone(vehicleid)) return SendClientMessage(playerid, COLOR_GRAD2, ""SERVER"x {AFAFAF}Вы не в служебной машине!");
			format(string, MAX_STR, "{{ Агент FBI %s: %s }}", PI[playerid][pNames], params[0]);
			ProxDetector(80.0, playerid, string, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER);
		}
	case 10:
		{
			if(!Megaphone(vehicleid)) return SendClientMessage(playerid, COLOR_GRAD2, ""SERVER"x {AFAFAF}Вы не в служебной машине!");
			format(string, MAX_STR, "{{ Офицер %s: %s }}", PI[playerid][pNames], params[0]);
			ProxDetector(80.0, playerid, string, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER);
		}
	case 3, 19, 20, 27:
		{
			if(!Megaphone(vehicleid)) return SendClientMessage(playerid, COLOR_GRAD2, ""SERVER"x {AFAFAF}Вы не в служебной машине!");
			format(string, MAX_STR, "{{ Солдат %s: %s }}", PI[playerid][pNames], params[0]);
			ProxDetector(80.0, playerid, string, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER);
		}
	case 21:
		{
			if(!Megaphone(vehicleid)) return SendClientMessage(playerid, COLOR_GRAD2, ""SERVER"x {AFAFAF}Вы не в служебной машине!");
			format(string, MAX_STR, "{{ Офицер %s: %s }}", PI[playerid][pNames], params[0]);
			ProxDetector(80.0, playerid, string, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER);
		}
	case 25:
		{
			if(vehicleid < SwatCar[0] || vehicleid > SwatCar[1]) return SendClientMessage(playerid, COLOR_GRAD2, ""SERVER"x {AFAFAF}Вы не в служебной машине!");
			format(string, MAX_STR, "{{ Спецподразделение SWAT %s: %s }}", PI[playerid][pNames], params[0]);
			ProxDetector(80.0, playerid, string, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER);
		}
	}
	return 1;
}
cmd:am(playerid, params[])
{
	if (!GetAccessAdmin(playerid, 3)) return 1;
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "/am [текст]");
	string = "";
	format(string, MAX_STR, "{{ Администратор %s: %s }}", PI[playerid][pNames], params[0]);
	ProxDetector(80.0, playerid, string, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER, COLOR_SERVER);
	return 1;
}
alias:radio("r");
cmd:radio(playerid, params[])
{
	if(!IsACop(playerid) && !IsAArm(playerid) && !IsAMayor(playerid) && !IsAMedic(playerid) && PI[playerid][pMember] != 26 && PI[playerid][pMember] != 11 && PI[playerid][pMember] != 16) return ErrorMessage(playerid, "У вас нету рации");
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день");
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "(/r)adio [текст]");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		if(StartRabWork(playerid)) SetPVarInt(playerid, "StartRabWork", 0);
		PI[playerid][pMember] = 0;
		PI[playerid][pRank] = 0;
		PI[playerid][pLeader] = 0;
		PI[playerid][pJob] = 0;
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		SetPlayerSkin(playerid, PI[playerid][pChar]);
		SendClientMessage(playerid, COLOR_RED, "Вы были уволены. Если это произошло ошибочно, то пиши Анастасии. НЕ ЗАБУДЬ СКРИН СДЕЛАТЬ!!!");
		string = "";
		format(string, 144, "%s был уволен из фракции за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}

	if(!(PI[playerid][pSettings] & sFractionChat)) return ErrorMessage(playerid, "Включите чат фракции в личных настройках");
	if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У вас бан чата!");
	if(GetPVarInt(playerid, "gag")) return ErrorMessage(playerid, "У Вас кляп, вы не можете говорить!");
	format(string, 164, "[R] %s %s[%d]: %s", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], playerid, params[0]);
	SendFractionMessage(PI[playerid][pMember], 0x8D8DFFFF, string);
	SendSpyMessage(PI[playerid][pMember], 0xADFFEFFF, string);
	format(string, 64, "сказал(а) в рацию: "WHITE"%s", params[0]);
	SetPlayerChatBubble(playerid, string, COLOR_BLUE1, 15.0, 10000);
	PI[playerid][last_message] = params[0];
	return 1;
}
cmd:badge(playerid) {
	if (PI[playerid][pMember] != 26) return 1;
	if ((PI[playerid][pRank] < 3 && PI[playerid][pRank] > 5) || (PI[playerid][pRank] < 7 && PI[playerid][pRank] > 8)) return 1;
	if (PI[playerid][pBadge] > 0) {
		PI[playerid][pBadge] = 0;
		format(string, 164, "[R] %s %s[%d] закончил работу.", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], playerid);
		SendFractionMessage(PI[playerid][pMember], 0x8D8DFFFF, string);
		return 1;
	}
	switch (PI[playerid][pRank]) {
		case 3: {
			PI[playerid][pBadge] = 1;
		}
		case 4, 7: {
			PI[playerid][pBadge] = 2;
		}
		case 5, 8: {
			PI[playerid][pBadge] = 3;
		}
	}
	format(string, 164, "[R] %s %s[%d] начал работу.", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], playerid);
	SendFractionMessage(PI[playerid][pMember], 0x8D8DFFFF, string);
	return 1;
}
cmd:falsecapt(playerid)
{
    if(!GetAccessAdmin(playerid, 7))
		return true;
	CaptureInfo=false;
	return 1;
}
cmd:tcapture(playerid)
{
    if(!GetAccessAdmin(playerid, 7))
		return true;
    if(GetPVarInt(playerid, "TCapture_Show"))
    {
   		TextDrawHideForPlayer(playerid, Capture[0]);
		TextDrawHideForPlayer(playerid, Capture[1]);
		TextDrawHideForPlayer(playerid, Capture[2]);
		TextDrawHideForPlayer(playerid, Capture[3]);
		TextDrawHideForPlayer(playerid, Capture[4]);
		TextDrawHideForPlayer(playerid, Capture[5]);
		TextDrawHideForPlayer(playerid, Capture[6]);
		TextDrawHideForPlayer(playerid, Capture[7]);
		TextDrawHideForPlayer(playerid, Capture[8]);
		TextDrawHideForPlayer(playerid, Capture[9]);
		TextDrawHideForPlayer(playerid, Capture[10]);
		DeletePVar(playerid, "TCapture_Show");
		return 1;
    }
	TextDrawShowForPlayer(playerid, Capture[0]);
	TextDrawShowForPlayer(playerid, Capture[1]);
	TextDrawShowForPlayer(playerid, Capture[2]);
	TextDrawShowForPlayer(playerid, Capture[3]);
	TextDrawShowForPlayer(playerid, Capture[4]);
	TextDrawShowForPlayer(playerid, Capture[5]);
	TextDrawShowForPlayer(playerid, Capture[6]);
	TextDrawShowForPlayer(playerid, Capture[7]);
	TextDrawShowForPlayer(playerid, Capture[8]);
	TextDrawShowForPlayer(playerid, Capture[9]);
	TextDrawShowForPlayer(playerid, Capture[10]);
	SetPVarInt(playerid, "TCapture_Show", true);
	return 1;
}
cmd:objreg(playerid)
{
	if(D_FULL(PI[playerid][pNames])) ShowPlayerDialog(playerid, 6565, DIALOG_STYLE_LIST, "Редактор", "[1] Создать объект\n[2] Редактировать объекты", "Выбрать", "Отмена");
	return 1;
}
cmd:lmenu(playerid)
{
	if(!PI[playerid][pLeader]) return 1;
	if(PI[playerid][pLeader] == 26) return econ_panel(playerid);
	if(ISAMAFIA(playerid)) format(string, 512, ""WHITE"1. Нанять нового работника\n2. Уволить работника\n3. Информация о притоне\n4. Список игроков состоящих во фракции");
	else format(string, 512, ""WHITE"1. Список игроков состоящих во фракции");
	if(IsAGang(playerid)) format(string, 512, "%s", string);
	return ShowPlayerDialog(playerid, (ISAMAFIA(playerid)) ? (5873) : (8383), DIALOG_STYLE_LIST, (ISAMAFIA(playerid)) ? (""SERVER"Меню притона") : (""SERVER"Меню управления организацией"), string, "Далее", "Отмена");
}
cmd:pdpanel(playerid)
{
	if(!IsACop(playerid)) return 1;
	ShowPlayerDialog(playerid, 8958, DIALOG_STYLE_INPUT, ""SERVER"База данных", ""WHITE"Введите Имя игрока, о котором хотите узнать подробную информацию:", "Далее", "Отмена");
	return 1;
}
alias:family("f");
cmd:family(playerid, params[])
{
	if(!IsAGang(playerid) && !ISAMAFIA(playerid) && PI[playerid][pMember] != 24 && PI[playerid][pMember] != 9 && PI[playerid][pMember] != 20 && PI[playerid][pMember] != 23 && PI[playerid][pMember] != 8 && PI[playerid][pMember] != 11 && PI[playerid][pMember] != 22) return ErrorMessage(playerid, "Вам недоступен этот чат.");
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У Вас бан чата!");
	if(GetPVarInt(playerid, "gag")) return ErrorMessage(playerid, "У Вас кляп, вы не можете говорить!");
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "(/f)amily [текст]");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		PI[playerid][pMuteTime] = 60;
		UpdatePlayerData(playerid, "pMuteTime", PI[playerid][pMuteTime]);
		SendClientMessage(playerid, COLOR_RED, "Вы получили мут за флуд.");
		string = "";
		format(string, 144, "%s получил мут за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		return 1;
	}

	if(!Reklama(playerid, params[0])) return 1;
	string = "";
	format(string, 150, "[F] %s %s[%d]: %s", PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], playerid, params[0]);
	SendFractionMessage(PI[playerid][pMember], 0x01FCFFFF, string);
	SendSpyMessage(PI[playerid][pMember], 0xADFFEFFF, string);
	SetPlayerChatBubble(playerid, "сказал(а) что-то в семейный чат", 0xDD90FFFF, 10.0, 3000);
	PI[playerid][last_message] = params[0];
	return 1;
}
alias:departments("d");
cmd:departments(playerid, params[])
{
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(PI[playerid][pMuteTime]) return SCMF(playerid, COLOR_LIGHTRED, "У Вас бан чата! До снятия: %d секунд(ы)", PI[playerid][pMuteTime]);
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "(/d)epartments [текст]");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		if(StartRabWork(playerid)) SetPVarInt(playerid, "StartRabWork", 0);
		PI[playerid][pMember] = 0;
		PI[playerid][pRank] = 0;
		PI[playerid][pLeader] = 0;
		PI[playerid][pJob] = 0;
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		SetPlayerSkin(playerid, PI[playerid][pChar]);
		SendClientMessage(playerid, COLOR_RED, "Вы были уволены. Если это произошло ошибочно, то пиши Анастасии. НЕ ЗАБУДЬ СКРИН СДЕЛАТЬ!!!");
		string = "";
		format(string, 144, "%s был уволен из фракции за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}

	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!");
	if(!Reklama(playerid, params[0])) return 1;
	switch(PI[playerid][pMember])
	{
		case 12, 13, 15, 14, 24:return 1;
		case 17, 18, 0, 5, 6, 16, 22, 23:return 1;
	}
	if(PI[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не уполномочены писать в департамент!");
	string = "";
	format(string, 250, "[D] [%s] %s %s[%d]: %s", FI[PI[playerid][pMember]][fName], PlayerRank[PI[playerid][pMember]-1][PI[playerid][pRank]-1], PI[playerid][pNames], playerid, params[0]);
	foreach(Player, i) if(IsADepartament(i)) SendClientMessage(i, COLOR_ALLDEPT, string);
	SendSpyMessage(PI[playerid][pMember], 0xADFFEFFF, string);
	PI[playerid][last_message] = params[0];
	return 1;
}
alias:o("ooc");
cmd:o(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;
	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!");
	if(PI[playerid][pMuteTime]) return SCMF(playerid, COLOR_LIGHTRED, "У Вас бан чата! До снятия: %d секунд(ы)", PI[playerid][pMuteTime]);
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "(/o)oc [текст]");

	if(strcmp(params[0], PI[playerid][last_reason]) == 0) PI[playerid][last_reason_count]++;
	else PI[playerid][last_reason_count] = 0;
	if(PI[playerid][last_reason_count] >= 3)
	{
		string = "";
		mysql_format(1, string, MAX_STR, "SELECT * FROM `admin` WHERE `name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string, "Moderator", "dsd", playerid, PI[playerid][pNames], 0);
		string = "";
		mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string);
		SendClientMessage(playerid, COLOR_RED, "Вы были сняты. Если это произошло ошибочно, то пишите в личные сообщение группы ("NAME_VK")");
		string = "";
		format(string, 144, "%s был снят с админки за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}

	if(!Reklama(playerid, params[0])) return 1;
	if(!strcmp(params[0], ooctext[playerid], true)) oocflood[playerid]++;
	if(oocflood[playerid] > 2)
	{
		string = "";
		format(string, sizeof(string), "[Внимание] %s подозревается в сливе через /o. Последнее сообщение: %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		return 1;
	}
	string = "";
	format(string, 250, "« %s[%d]: %s »", PI[playerid][pNames], playerid, params[0]);
	SendClientMessageToAll(COLOR_OOC, string);
	format(ooctext[playerid], 500, "%s", params[0]);
	PI[playerid][last_reason] = params[0];
	return 1;
}
cmd:ticket(playerid, params[])
{
	if(!IsACop(playerid)) return ErrorMessage(playerid, "Вы не полицейский!");
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "dds[128]", params[0], params[1], params[2])) return SendEsp(playerid, "/ticket [id] [цена] [причина]");
	if(params[1] < 1 || params[1] > 10000) return ErrorMessage(playerid, "Штраф не должен привышать 10000 и не должен быть меньше 0 вирт!");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Этот Человек далеко от вас!");
	if(PI[params[0]][pCash] < params[1]) return ErrorMessage(playerid, "У этого  нет столько денег!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
	string = "";
	format(string, MAX_STR, "Вы выписали штраф в размере %d вирт %s. Причина: %s", params[1], PI[params[0]][pNames], params[2]);
	SendClientMessage(playerid, COLOR_BLUE, string);
	format(string, MAX_STR, "Офицер %s выписал вам штраф в размере %d вирт. Причина: %s", PI[playerid][pNames], params[1], params[2]);
	SendClientMessage(params[0], COLOR_BLUE, string);
	SendClientMessage(params[0], COLOR_WHITE, ""#information"Введите: /accept ticket, чтобы оплатить штраф");
	SetPVarInt(params[0], "TicketOffer", playerid);
	SetPVarInt(params[0], "TicketMoney", params[1]);
	return 1;
}
alias:vmenu("vm");
cmd:vmenu(playerid)
{
	if (!PI[playerid][pDRInections]) return SCM(playerid, COLOR_RED, "У вас обычный аккаунт. Приобрести Brilliant VIP вы можете в /donate!");
	ShowPlayerDialog(playerid, 10126, DIALOG_STYLE_LIST, ""SERVER"Меню / Brilliant VIP", "\
	"SERVER"1. "WHITE"Команды\n\
	"SERVER"2. "WHITE"Смена цвета сообщений\n\
	"SERVER"3. "WHITE"Перевернуть автомобиль\n\
	"SERVER"4. "WHITE"Убрать видимость на карте\n\
	"SERVER"5. "WHITE"Заспавнить мотоцикл NRG-500\n\
	"SERVER"6. "WHITE"Включить/Выключить режим стрельбы двумя руками\n\
	"SERVER"7. "WHITE"Установить/убрать неон\n\
	"SERVER"8. "WHITE"Уволиться из организации\n\
	"SERVER"9. "WHITE"Включить/выключить личные сообщения\n\
	"SERVER"10. "WHITE"Выдать Desert Eagle на 50 патронов", "Выбрать", "Отмена");
	return true;
}
cmd:setchatcolor(playerid)
{
	if(!PI[playerid][pDRInections]) return ErrorMessage(playerid, "Данная команда доступна только владельцам Brilliant VIP.");
	return ShowPlayerDialog(playerid, 10131, DIALOG_STYLE_LIST, "Выберите цвет текста", "{000000} Черный\n {FFFFFF} Белый\n {800080} Фиолетовый\n {FF0000} Красный\n {FFFF00} Желтый\n {00FF00} Зеленый\n {0000FF} Синий\n{FF4500} Оранжевый\n {FF1493} Ярко-розовый\n{00FA9A} Ярко-зеленый\n {00FFFF} Голубой\n {F0E68C} Телесный\n {FF00FF} Пурпурный\n {4B0082} Индиго\n {FF6347} Светло-красный\n {F4A460} Песочный", "ОК", "Закрыть");
}
cmd:setstat(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(gAdminReason[playerid][ADMIN_SETSTAT]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "ddd", params[0], params[1], params[2]))
	{
		SendClientMessage(playerid, COLOR_WHITE, ""#information"/setstat [id] [номер] [количество]");
		SendClientMessage(playerid, COLOR_GREY, "[1] Уровень | [2] Законка |[3] Маты | [4] Скин | [5] Номер телефона | [6] Exp | [7] Работа игрока");
		SendClientMessage(playerid, COLOR_GREY, "[8] Деньги в банке | [9] Деньги | [10] Варны | [11] Член орг | [12] pModel | [13] Муж/Жена");
		SendClientMessage(playerid, COLOR_GREY, "[14] Машина 1 | [15] Машина 2 | [16] Машина 3");
		return 1;
	}
	if(IsPlayerConnected(params[0]))
	{
		switch (params[1])
		{
		case 1: { PI[params[0]][pLevel] = params[2]; SCMF(playerid, COLOR_GRAD1, "LVL игрока изменён на: %d", params[2]); UpdatePlayerData(params[0], "pLevel", PI[params[0]][pLevel]); }
		case 2: { PI[params[0]][pZakonp] = params[2]; SCMF(playerid, COLOR_GRAD1, "Законка: %d ", params[2]); UpdatePlayerData(params[0], "pZakonp", params[2]); }
		case 3: { PI[params[0]][pMats] = params[2]; SCMF(playerid, COLOR_GRAD1, "Маты: %d ", params[2]); UpdatePlayerData(params[0], "pMats", PI[params[0]][pMats]); }
		case 4: { PI[params[0]][pChar] = params[2]; SCMF(playerid, COLOR_GRAD1, "Скин: %d", params[2]); UpdatePlayerData(params[0], "pChar", PI[params[0]][pChar]); }
		case 5: { PI[params[0]][pPnumber] = params[2]; SCMF(playerid, COLOR_GRAD1, "Номер телефона: %d", params[2]); UpdatePlayerData(params[0], "pPnumber", params[2]); }
		case 6: { PI[params[0]][pExp] = params[2]; SCMF(playerid, COLOR_GRAD1, "EXP: %d", params[2]); UpdatePlayerData(params[0], "pExp", PI[params[0]][pExp]); }
		case 7: { PI[params[0]][pJob] = params[2]; SCMF(playerid, COLOR_GRAD1, "Работа %d", params[2]); UpdatePlayerData(params[0], "pJob", params[2]); }
		case 8: { PI[params[0]][pBank] = params[2]; SCMF(playerid, COLOR_GRAD1, "Деньги в банке изменены  на %d вирт", params[2]); UpdatePlayerData(params[0], "pBank", params[2]); }
		case 9: { PI[params[0]][pCash] = params[2]; Hook_GivePlayerMoney(params[0], params[2]); SCMF(playerid, COLOR_GRAD1, "Деньги изменены на %d вирт", params[2]); }
		case 10: { PI[params[0]][pWarns] = params[2]; SCMF(playerid, COLOR_GRAD1, "Количество варнов изменено на %d ", params[2]); UpdatePlayerData(params[0], "pWarns", params[2]); }
		case 11: { PI[params[0]][pMember] = params[2]; PI[params[0]][pRank] = 1; SCMF(playerid, COLOR_GRAD1, "pMember %d. ", params[2]); UpdatePlayerData(params[0], "pMember", params[2]); UpdatePlayerData(params[0], "pRank", 1); }
		case 12: { PI[params[0]][pModel] = params[2]; SCMF(playerid, COLOR_GRAD1, "pModel %d ", params[2]); UpdatePlayerData(params[0], "pModel", PI[params[0]][pModel]); }
		case 13: { PI[params[0]][pMarried] = params[2]; SCMF(playerid, COLOR_GRAD1, "pMarriedTo %d ", params[2]); UpdatePlayerData(params[0], "pMarried", params[2]); }
		case 14: { PI[params[0]][pCar][0] = params[2]; SCMF(playerid, COLOR_GRAD1, "Машина %d ", params[2]); UpdatePlayerData(params[0], "pCar", params[2]); }
		case 15: { PI[params[0]][pCar][1] = params[2]; SCMF(playerid, COLOR_GRAD1, "Машина %d ", params[2]); UpdatePlayerData(params[0], "pCar2", params[2]); }
		case 16: { PI[params[0]][pCar][2] = params[2]; SCMF(playerid, COLOR_GRAD1, "Машина %d ", params[2]); UpdatePlayerData(params[0], "pCar3", params[2]); }
		default: { SCMF(playerid, COLOR_GRAD1, ""#net"", params[2]); }
		}
	}
	string = "";
	format(string, MAX_STR, "Администратор %s изменил статистику игроку %s", PI[playerid][pNames], PI[params[0]][pNames]);
	SendAdminMessage(COLOR_GREY, string);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /setstat на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:setklass(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "dd", params[0], params[1])) return ErrorMessage(playerid, "/setklass [квартира] [класс]");
		HouseInfo[params[0]][hKlass] = params[1];
		SendClientMessage(playerid, COLOR_WHITE, "Класс установлен");
	}
	return 1;
}
cmd:setcena(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "dd", params[0], params[1])) return ErrorMessage(playerid, "/setcena [квартира] [цена]");
		HouseInfo[params[0]][hValue] = params[1];
		SendClientMessage(playerid, COLOR_WHITE, "Цена установлена");
	}
	return 1;
}
cmd:asetpos(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/asetpos [ House ID ]");
		new Float: lwx, Float:lwy, Float:lwz;
		GetPlayerPos(playerid, lwx, lwy, lwz);
		HouseInfo[params[0]][hEnter][0] = lwx;
		HouseInfo[params[0]][hEnter][1] = lwy;
		HouseInfo[params[0]][hEnter][2] = lwz;
		string = "";
		mysql_format(1, string, 160, "UPDATE `house` SET `hEntrancex` = '%f', `hEntrancey` = '%f', `hEntrancez` = '%f' WHERE hID = '%i'", lwx, lwy, lwz, params[0]);
		mysql_tquery(1, string);
		UpdateIconHouse(params[0]);
	}
	return 1;
}
cmd:owdelpos(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/adelpos [ Дом ]");
		new Float: lwx, Float:lwy, Float:lwz;
		GetPlayerPos(playerid, lwx, lwy, lwz);
		HouseInfo[params[0]][hEnter][0] = 0;
		HouseInfo[params[0]][hEnter][1]	= 0;
		HouseInfo[params[0]][hEnter][2] = 0;
		string = "";
		mysql_format(1, string, 100, "UPDATE `house` SET `hEntrancex` = '0', `hEntrancey` = '0', `hEntrancez` = '0' WHERE hID = '%i'", params[0]);
		mysql_tquery(1, string);
		UpdateIconHouse(params[0]);
	}
	return 1;
}
cmd:setposcar(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/setposcar [ дом ]");
		new Float:X, Float:Y, Float:Z, Float:Angle; GetPlayerPos(playerid, X, Y, Z); GetPlayerFacingAngle(playerid, Angle);
		HouseInfo[params[0]][hCar][0] = X;
		HouseInfo[params[0]][hCar][1] = Y;
		HouseInfo[params[0]][hCar][2] = Z;
		HouseInfo[params[0]][hCar][3] = Angle;
		SendClientMessage(playerid, COLOR_GREY, "Координаты машины установлены");
		string = "";
		mysql_format(1, string, 150, "UPDATE `house` SET `hCarx` = '%f', `hCary` = '%f', `hCarz` = '%f', `hCarc` = '%f' WHERE hID = '%i'", X, Y, Z, Angle, HouseInfo[params[0]][hID]);
		mysql_tquery(1, string);
	}
	return 1;
}
cmd:getip(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	//if(gAdminReason[playerid][ADMIN_GETIP]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/getip [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок не найден!");
	string = "";
	format(string, 126, "Ник: %s, регистрационный IP: %s, текущий IP: %s.", PI[params[0]][pNames], PI[params[0]][pIpReg], PI[params[0]][pIP]);
	SendClientMessage(playerid, 0x6495EDFF, string);
	return 1;
}
cmd:offgetip(playerid, params[])
{
    if(!GetAccessAdmin(playerid, 3))
		return true;
    new name[MAX_PLAYER_NAME + 1];
	if(sscanf(params, "s[24]", name)) return SendEsp(playerid, "/offgetip [ИМЯ]");
    mysql_format(1, string, sizeof(string), "SELECT * FROM `accounts` WHERE `Name` = '%e'", name);
 	mysql_tquery(1, string, "offgetip", "is", playerid, name);
 	return 1;
}
publics: offgetip(playerid, name)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return ErrorMessage(playerid, "Вы указали несуществующий ник");
	new ippp[16];
	cache_get_field_content(0, "pGetonIP", ippp);
	format(string, SMALL_SIZE, "[%s] IP: %s", name, ippp);
	SendClientMessage(playerid, 0x6495EDFF, string);
	return 1;
}
cmd:allgetipreg(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 4))
		return true;
	//if(gAdminReason[playerid][ADMIN_ALLGETIPREG]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	new ipp[16];
	if(sscanf(params, "s[16]", ipp)) return SendClientMessage(playerid, -1, "/allgetipreg [IP ВВЕДИ СЮДА]");
	mysql_format(1, string, 128, "SELECT * FROM accounts WHERE pGetonIP = '%e'", ipp);
	mysql_tquery(1, string, "RegIPCallBack", "i", playerid);
	return 1;
}
publics: RegIPCallBack(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, -1, "Мамой клянусь, твинков нету");
	new nick[24];
	string = "";
	for(new i; i < rows; i++)
	{
    	cache_get_field_content(i, "Name", nick, 1, 30);
    	strcat(string, nick);
    	strcat(string, "\n");
	}
	ShowPlayerDialog(playerid, 4365, DIALOG_STYLE_MSGBOX, "Аккаунты на этом IP", string, "Принять", "");
	return 1;
}
cmd:iwep(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 2))
		return true;
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/iwep [playerid]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок не найден!");
	new Gun[13][2];
	string = "";
	for(new i = 0; i != 12; i ++)
	{
		GetPlayerWeaponData(params[0], i, Gun[i][0], Gun[i][1]);
		format(string, sizeof(string), "%s%i\tWeapon: %d     Ammo: %d\n", string, i, Gun[i][0], Gun[i][1]);
	}
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, PI[params[0]][pNames], string, "Готово", "");
	return 1;
}
cmd:getstats(playerid, params[])
{
	if (!GetAccessAdmin(playerid, 2))
		return true;
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/getstats [id]");
	if(params[0] > MAX_PLAYERS || params[0] < 0) return true;
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	ShowStats(playerid, params[0]);
	return 1;
}
cmd:number(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/number [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	string = "";
	format(string, 70, "Владелец: %s. Телефон: %d", PI[params[0]][pNames], PI[params[0]][pPnumber]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	return 1;
}
cmd:fstyle(playerid, params[])
{
	if(GetAccessAdmin(playerid, 2) || PI[playerid][pDRInections])
	{
		if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/fstyle [style 1-4]");
		if(params[0] < 1 || params[0] > 4) return SendEsp(playerid, "/fstyle [style 1-4]");
		switch(params[0])
		{
		case 1: { SetPlayerFightingStyle (playerid, FIGHT_STYLE_NORMAL); SendClientMessage(playerid, COLOR_WHITE, "Обычный стиль"); }
		case 2: { SetPlayerFightingStyle (playerid, FIGHT_STYLE_BOXING); SendClientMessage(playerid, COLOR_WHITE, "Стиль RM"); }
		case 3: { SetPlayerFightingStyle (playerid, FIGHT_STYLE_KUNGFU); SendClientMessage(playerid, COLOR_WHITE, "Стиль Yakuza"); }
		case 4: { SetPlayerFightingStyle (playerid, FIGHT_STYLE_KNEEHEAD); SendClientMessage(playerid, COLOR_WHITE, "Стиль LCN"); }
		}
		return 1;
	}
	return 1;
}
CMD:usedrugs(playerid, params[])
{
	if(PI[playerid][pDrugs] <= 0) return ErrorMessage(playerid, "У вас нет наркотиков");
	if(PI[playerid][pHospital] && pTemp[playerid][pInHospital]) return ErrorMessage(playerid, "Во время лечения, нельзя употреблять наркотик");
	if(sscanf(params, "d", params[0]))
	{
		if(PI[playerid][pLomka] < 2000)
		{
			if(PI[playerid][pDrugs] >= 3) params[0] = 3;
			else params[0] = PI[playerid][pDrugs];
		}
		else if(PI[playerid][pLomka] < 3000)
		{
			if(PI[playerid][pDrugs] >= 6) params[0] = 6;
			else params[0] = PI[playerid][pDrugs];
		}
		else if(PI[playerid][pLomka] < 4000)
		{
			if(PI[playerid][pDrugs] >= 9) params[0] = 9;
			else params[0] = PI[playerid][pDrugs];
		}
		else if(PI[playerid][pLomka] < 5000)
		{
			if(PI[playerid][pDrugs] >= 12) params[0] = 12;
			else params[0] = PI[playerid][pDrugs];
		}
		else if(PI[playerid][pLomka] > 5000)
		{
			if(PI[playerid][pDrugs] >= 15) params[0] = 15;
			else params[0] = PI[playerid][pDrugs];
		}
	}
	if(PI[playerid][pDrugs] < params[0]) return ErrorMessage(playerid, "Недостаточно наркотиков");
	if(params[0] < 1) return ErrorMessage(playerid, "Неверное кол-во");
	if(PI[playerid][pLomka] < 2000 && params[0] > 3) return ErrorMessage(playerid, "Не более 3 грамм");
	else if(PI[playerid][pLomka] < 3000 && params[0] > 6) return ErrorMessage(playerid, "Не более 6 грамм");
	else if(PI[playerid][pLomka] < 4000 && params[0] > 9) return ErrorMessage(playerid, "Не более 9 грамм");
	else if(PI[playerid][pLomka] < 5000 && params[0] > 12) return ErrorMessage(playerid, "Не более 12 грамм");
	else if(params[0] > 15) return ErrorMessage(playerid, "Не более 15 грамм");
	new Float:MyHealth;
	GetPlayerHealth(playerid, MyHealth);
	if(PI[playerid][pLomka] < 2000 && MyHealth + 10 * params[0] > 120)
	{
		if(GetPVarInt(playerid,"drug_time") < gettime()) SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье пополнено до: 120 ))"), SetPlayerHealth(playerid,120);
		else SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else if(PI[playerid][pLomka] < 3000 && MyHealth + 10 * params[0] > 130)
	{
		if(GetPVarInt(playerid,"drug_time") < gettime()) SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье пополнено до: 130 ))"), SetPlayerHealth(playerid,130);
		else SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else if(PI[playerid][pLomka] < 4000 && MyHealth + 10 * params[0] > 140)
	{
		if(GetPVarInt(playerid,"drug_time") < gettime()) SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье пополнено до: 140 ))"), SetPlayerHealth(playerid,140);
		else SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else if(PI[playerid][pLomka] < 5000 && MyHealth + 10 * params[0] > 150)
	{
		if(GetPVarInt(playerid,"drug_time") < gettime()) SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье пополнено до: 150 ))"), SetPlayerHealth(playerid,150);
		else SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else if(PI[playerid][pLomka] > 5000 && MyHealth + 10 * params[0] > 160)
	{
		if(GetPVarInt(playerid,"drug_time") < gettime()) SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье пополнено до: 160 ))"), SetPlayerHealth(playerid,160);
		else SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else
	{
		if(GetPVarInt(playerid,"drug_time") < gettime()) SendMes(playerid, COLOR_WHITE, "(( Здоровье пополнено до: %.0f ))", MyHealth + 10 * params[0] > 120), SetPlayerHealth(playerid, MyHealth + 10 * params[0]);
		else SendClientMessage(playerid,COLOR_WHITE,"(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	PI[playerid][pNarcoLomka] = 0;
	SetPVarInt(playerid,"drug_time", gettime() + 30);
	PI[playerid][pDrugs] -= params[0];
	UpdatePlayerData(playerid, "pDrugs", PI[playerid][pDrugs]);
	UpdatePlayerData(playerid, "pNarcoLomka", PI[playerid][pNarcoLomka]);
	SendMes(playerid, -1, "(( Остаток: %d грамм ))", PI[playerid][pDrugs]);
	if(!GetPVarInt(playerid, "PlayerCuffed")) ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
	format(string,sizeof(string), "%s употребил(а) наркотики",PI[playerid][pNames]);
	ProxDetector(10.0, playerid,string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	PI[playerid][pLomka] += 4*params[0];
	UpdatePlayerData(playerid, "pLomka", PI[playerid][pLomka]);
	SetPVarInt(playerid, "anim_using", unix + 5);
	return 1;
}
cmd:sellgun(playerid, params[])
{
	for(new i = 0; i < sizeof(GZInfo); i++)
	{
		if(PI[playerid][pMember] == GZInfo[i][gFrakVlad])
		{
			if (IsAGang(playerid))
			{
				if(!IsARespa(playerid)) return ErrorMessage(playerid, "Вы не на своей базе.");
				if(sscanf(params, "dddd", params[0], params[1], params[2], params[3]))
				{
					SendEsp(playerid, "/sellgun [id] [ID оружие] [патроны] [цена]");
					SendClientMessage(playerid, COLOR_GREY, "Цена должна быть не меньше 5 вирт!");
					return 1;
				}
				if(params[0] == INVALID_PLAYER_ID) return ErrorMessage(playerid, "Не правильный id");
				if(params[1] == 24 || params[1] == 25 || params[1] == 29 || params[1] == 23 || params[1] == 30 || params[1] == 31 || params[1] == 33)
				{
					if(params[2] > 100||params[2] < 0) return ErrorMessage(playerid, "От 1 до 100 патронов!");
					if (!ProxDetectorS(5.0, playerid, params[0])) return SendClientMessage(playerid, COLOR_GRAD2, "Человек должен быть рядом с вами");
					if(params[3] < 4) { ErrorMessage(playerid, "/sellgun [id] [ID оружие] [патроны] [цена]");SendClientMessage(playerid, -1, ""#information"Не меньше 4 вирт!"); return 1; }
					if(PI[playerid][pMats] < (2*params[2])) return SendClientMessage(playerid, COLOR_GRAD2, "У вас недостаточно материалов");
					SellGun[4] = playerid;
					SellGun[0] = params[0];
					SellGun[1] = params[1];
					SellGun[2] = params[2];
					SellGun[3] = params[3];
					new dialogexx[80];
					if(params[1] == 24) format(dialogexx, sizeof(dialogexx), ""WHITE"Вам предложили купить оружие:\n- Deagle\n- Стоимость %d\n- Патроны %d", params[3], params[2]);
					if(params[1] == 25) format(dialogexx, sizeof(dialogexx), ""WHITE"Вам предложили купить оружие:\n- ShotGun\n- Стоимость %d\n- Патроны %d", params[3], params[2]);
					if(params[1] == 29) format(dialogexx, sizeof(dialogexx), ""WHITE"Вам предложили купить оружие:\n- nSMG\n- Стоимость %d\n- Патроны %d", params[3], params[2]);
					if(params[1] == 23) format(dialogexx, sizeof(dialogexx), ""WHITE"Вам предложили купить оружие:\n- Sdpistol\n- Стоимость %d\n- Патроны %d", params[3], params[2]);
					if(params[1] == 30) format(dialogexx, sizeof(dialogexx), ""WHITE"Вам предложили купить оружие:\n- Ak47\n- Стоимость %d\n- Патроны %d", params[3], params[2]);
					if(params[1] == 31) format(dialogexx, sizeof(dialogexx), ""WHITE"Вам предложили купить оружие:\n- M4A1\n- Стоимость %d\n- Патроны %d", params[3], params[2]);
					if(params[1] == 33) format(dialogexx, sizeof(dialogexx), ""WHITE"Вам предложили купить оружие:\n- Rifle\n- Стоимость %d\n- Патроны %d", params[3], params[2]);
					ShowPlayerDialog(params[0], 22572, DIALOG_STYLE_MSGBOX, ""SERVER"Покупка оружия", dialogexx, "Купить", "Отмена");
					SendClientMessage(playerid, 0x6ab1ffaa, "Вы предложили купить оружие!");
				}
			}
		}
	}
	return 1;
}
cmd:unloading(playerid)
{
	new tmpcar = VehicleEnters[playerid];
