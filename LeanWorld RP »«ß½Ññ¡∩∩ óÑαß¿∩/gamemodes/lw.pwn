ShowAdvertList(playerid)
{
	new data[3][30], index;
	format(data[0], 30, "[{"#cGREEN"}Проверено"WHITE"]"), format(data[1], 30, "[{"#cYELLOW"}Проверяется"WHITE"]");
	string = "";
	for(new i;i<MAX_ADVERT_COUNT;i++)
	{
		if(!gAdvert[i][adBusy]) format(string, sizeof(string), "%s%d. -\n", string, i+1);
		else
		{
			if(gAdvert[i][adCheking]) index = 1;
			else if(gAdvert[i][adCheked]) index = 0;
			else index = 2;
			format(string, sizeof(string), "%s%d. %s %s\n", string, i+1, gAdvert[i][adSender], data[index]);
		}
	}
	ShowPlayerDialog(playerid, dAdvertList, 2, ""SERVER"Объявления", string, "Принять", "Отмена");
	return 1;
}
stock SellCar(playerid, car_id)
{
	Hook_GivePlayerMoney(playerid, PI[playerid][pCarCash][car_id-1]);
	new name_car[20];
	switch(car_id)
	{
		case 1: name_car = "первое";
		case 2: name_car = "второе";
		case 3: name_car = "третье";
	}
	SCMF(playerid, COLOR_GREEN, "Вы успешно продали свое %s транспортное средство за %i$", name_car, PI[playerid][pCarCash][car_id-1]);
	PI[playerid][pCar][car_id-1] = 510;
	strmid(NumberVehicle[playerid][car_id-1], "Транзит", 0, strlen("Транзит"), 255);
	PI[playerid][pRegNumber][car_id-1] = 0;
	gPlayerTuning[playerid][car_id-1][0]  = -1;
	gPlayerTuning[playerid][car_id-1][1]  = 0;
	gPlayerTuning[playerid][car_id-1][2]  = -1;
	gPlayerTuning[playerid][car_id-1][3]  = -1;
	gPlayerTuning[playerid][car_id-1][4]  = -1;
	gPlayerTuning[playerid][car_id-1][5]  = -1;
	gPlayerTuning[playerid][car_id-1][6]  = -1;
	gPlayerTuning[playerid][car_id-1][7]  = -1;
	gPlayerTuning[playerid][car_id-1][8]  = -1;
	gPlayerTuning[playerid][car_id-1][9]  = -1;
	gPlayerTuning[playerid][car_id-1][10] = -1;
	gPlayerTuning[playerid][car_id-1][11] = -1;
	UpdateTuning(playerid, car_id);
	if(car_id == 1) UpdatePlayerData(playerid, "pCar", PI[playerid][pCar][car_id-1]), LoadCarPlayer(playerid, car_id), PI[playerid][pCarCash][car_id-1] = 0, UpdatePlayerData(playerid, "pCarCash", PI[playerid][pCarCash][car_id-1]), UpdatePlayerData(playerid, "numberReg", 0), UpdatePlayerDataEx(playerid, "numbercar", "Транзит");
	else if(car_id == 2) UpdatePlayerData(playerid, "pCar2", PI[playerid][pCar][car_id-1]), LoadCarPlayer(playerid, car_id), PI[playerid][pCarCash][car_id-1] = 0, UpdatePlayerData(playerid, "pCarCash2", PI[playerid][pCarCash][car_id-1]), UpdatePlayerData(playerid, "numberReg1", 0), UpdatePlayerDataEx(playerid, "numbercar1", "Транзит");
	else if(car_id == 3) UpdatePlayerData(playerid, "pCar3", PI[playerid][pCar][car_id-1]), LoadCarPlayer(playerid, car_id), PI[playerid][pCarCash][car_id-1] = 0, UpdatePlayerData(playerid, "pCarCash3", PI[playerid][pCarCash][car_id-1]), UpdatePlayerData(playerid, "numberReg2", 0), UpdatePlayerDataEx(playerid, "numbercar2", "Транзит");
	return 1;
}
ShowSettings(playerid)
{
	string = ""WHITE"Параметр\t"WHITE"Статус\n";
	for(new i;i<sizeof(nameSetting);i++)
	{
		new flag[20] = "{"#cRED"}Выключено";
		if(PI[playerid][pSettings] & (1 << i)) flag = "{"#cGREEN"}Включено";
		format(stringer, 100, ""WHITE"%d. %s\t%s\n", i+1, nameSetting[i], flag); strcat(string, stringer);
	}
	new sp[25], gter[25], drawanim[25], pogoda[25];
	switch(PI[playerid][pSpawnGun])
	{
		case 0: sp = "{"#cRED"}Выключено";
		case 1: sp = "{"#cGREEN"}Включено";
	}
	switch(PI[playerid][pNastr])
	{
		case 0: gter = "{"#cGREEN"}Включено";
		case 1: gter = "{"#cRED"}Выключено";
	}
	switch(PI[playerid][pAnimDraw])
	{
		case 0: drawanim = "{"#cRED"}Выключено";
		case 1: drawanim = "{"#cGREEN"}Включено";
	}
	switch(PI[playerid][pWeather])
	{
		case 0: pogoda = "{"#cRED"}Выключена";
		case 1: pogoda = "{"#cGREEN"}Включена";
	}
	format(stringer, sizeof(stringer), "\
	"WHITE"5. Оружие при спавне\t%s\n\
	"WHITE"6. Территории гетто\t%s\n\
	"WHITE"7. Текстдрав во время анимации\t%s\n\
	"WHITE"8. Система погоды\t%s\n\
	"WHITE"9. Пол персонажа\t%s\n\
	"WHITE"10. Описание персонажа", sp, gter, drawanim, pogoda, PI[playerid][pSex] == 1 ? ("{"#cGREEN"}Мужской"):("{"#cGREEN"}Женский")); strcat(string, stringer);
	ShowPlayerDialog(playerid, 116, DIALOG_STYLE_TABLIST_HEADERS, ""SERVER"Настройки", string, "Изменить", "Отмена");
	return 1;
}
FullFura(playerid, i)
{
	SendClientMessage(playerid, COLOR_RED, "Фургон заполнен, садитесь в него!");
	if(Start{i}) {
		DestroyPickup(autopick_mats[i]);
		DestroyDynamic3DTextLabel(mats3Dtxt[i]);
		Start{i} = false;
	}
	return 1;
}
GetVehicleKey(playerid, vehicleid)
{
	return ((PI[playerid][pMember] == 15 &&	((vehicleid >= grovecar[0] && vehicleid <= grovecar[1]) || vehicleid == matsfuragrove[0]))	|| (PI[playerid][pMember] == 12 &&
	((vehicleid >= ballascar[0] && vehicleid <= ballascar[1]) || vehicleid == matsfuraballas[0]))	|| (PI[playerid][pMember] == 13 &&	((vehicleid >= vagoscar[0] && vehicleid <= vagoscar[1]) || vehicleid == matsfuravagos[0]))	|| (PI[playerid][pMember] == 17 &&	((vehicleid >= coronoscar[0] && vehicleid <= coronoscar[1]) || vehicleid == matsfuraactek[0]))
	|| (PI[playerid][pMember] == 18 &&	((vehicleid >= rifacar[0] && vehicleid <= rifacar[1]) || vehicleid == matsfurarifa[0]))	|| (PI[playerid][pMember] == 5 &&	vehicleid >= lcncar[0] && vehicleid <= lcncar[1])	|| (PI[playerid][pMember] == 6 &&
	vehicleid >= yakcar[0] && vehicleid <= yakcar[1])	|| (PI[playerid][pMember] == 14 &&	vehicleid >= ruscar[0] && vehicleid <= ruscar[1])	|| (PI[playerid][pMember] == 16 &&	vehicleid >= lsnewscar[0] && vehicleid <= lsnewscar[1])
	|| (PI[playerid][pMember] == 11 &&	vehicleid >= liccar[0] && vehicleid <= liccar[1])	|| (PI[playerid][pMember] == 1 &&	vehicleid >= sapdcar[0] && vehicleid <= sapdcar[1])	|| (PI[playerid][pMember] == 2 &&
	vehicleid >= fbicar[0] && vehicleid <= fbicar[4])	|| (PI[playerid][pMember] == 3 &&	vehicleid >= armycar[0] && vehicleid <= armycar[1])	|| (IsAMayor(playerid) &&	vehicleid >= govcar[0] && vehicleid <= govcar[1])	|| (PI[playerid][pMember] == 19 &&	vehicleid >= armcar[0] && vehicleid <= armcar[1])
	|| (PI[playerid][pJob] == 1 &&	vehicleid >= mehanik[0] && vehicleid <= mehanik[1])	|| (RentCar[vehicleid] == playerid &&	vehicleid >= rentcarsf[0] && vehicleid <= rentcarsf[1])
	|| (PI[playerid][pMember] == 27 &&	vehicleid >= vmfcar[0] && vehicleid <= vmfcar[1]) || (PI[playerid][pMember] == 20 && vehicleid >= USACar[0] && vehicleid <= USACar[1]) || (PI[playerid][pMember] == 26 &&
	vehicleid >= ministrcar[0] && vehicleid <= ministrcar[1])  || (PI[playerid][pMember] == 1 && vehicleid >= sapdpatrul[0] && vehicleid <= sapdpatrul[1])
	|| (PI[playerid][pMember] == 24 && vehicleid >= hitcar[0] && vehicleid < hitcar[1])	|| (IsAMedic(playerid) &&	vehicleid >= MedCar[0] && vehicleid <= MedCar[1])) ? true : false;
}
RegistrationPlayer(playerid, skin_id, bool:type)
{
    new year, month, day, hour, minuite, second;
	if(!type)
	{
		if(!PI[playerid][pLogin]) return KickEx(playerid);
		new date_reg[50], playersip[16], drug_name[24], email_reg[16];
		GetPVarString(playerid, #reg_drug, drug_name, sizeof(drug_name));
		GetPVarString(playerid, #reg_email, email_reg, sizeof(email_reg));
		GetPlayerIp(playerid, playersip, sizeof(playersip));
		getdate(year, month, day); gettime(hour, minuite, second);
		format(date_reg, sizeof(date_reg), "%d/%d/%d %d:%d", day, month, year, hour, minuite);
		strmid(PI[playerid][pIpReg], playersip, 0, strlen(playersip), 255);
		strmid(PI[playerid][pLoadNames], PI[playerid][pNames], 0, 24, 255);
		PI[playerid][pLevel] = BONUSLVL;
		PI[playerid][pCash] = BONUSMONEY;
		PI[playerid][pDonate] = BONUSDONATE;
		PI[playerid][pHouse] = -1;
		PI[playerid][pBusiness] = -1;
		PI[playerid][pArendaHouse] = -1;
		PI[playerid][pFilling] = -1;
		PI[playerid][pPnumber] = RandomEx(100000, 999999);
		mysql_format(1, string, sizeof(string), "INSERT INTO `accounts` (`Name`,`pKey`,`pLevel`,`pPnumber`,`pBank`,`pCash`,`pChar`,`pDataReg`,`pIpReg`,`pRank`,`pEmail`,`pDrug`,`pSex`,`nationaly`,`age`,`pDonate`) VALUES ('%e', '%e', '%d', '%d', '0', '%d', '%d', '%e', '%e', '1', '%e', '%e', '%d', '%d', '%d', '%d')", PI[playerid][pNames],
		PI[playerid][pKey], BONUSLVL, PI[playerid][pPnumber], BONUSMONEY, skin_id, date_reg, playersip, email_reg, drug_name, GetPVarInt(playerid, #reg_pol), PI[playerid][pNationaly], GetPVarInt(playerid, #reg_age), BONUSDONATE);
		mysql_query(1, string, false);
		SetPVarInt(playerid, "reg_check", 1);
		string = "";
		mysql_format(1, string, 128, "SELECT * FROM `accounts` WHERE `Name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, string, "LoginCallback", "d", playerid);
		DeletePVar(playerid, #reg_drug), DeletePVar(playerid, #reg_age), DeletePVar(playerid, #reg_pol), DeletePVar(playerid, #reg_email);
		return 1;
	}
    DeletePVar(playerid, "reg_check");
	return 1;
}
stock LoadCarPlayer(playerid, carid)
{
	if(PI[playerid][pHouse] == -1 && PI[playerid][pArendaHouse] == -1) return 1;
	new house;
	if(PI[playerid][pHouse] != -1) house = PI[playerid][pHouse];
	else if(PI[playerid][pArendaHouse] != -1) house = PI[playerid][pArendaHouse];
	if(house == -1 || carid < 1 && carid > 3) return 1;
 	if(HouseInfo[house][hGarage])
	{
		if(PI[playerid][pArendaHouse] != -1)
		{
			if(caridhouse[playerid][0] != 0) DestroyVehicle(caridhouse[playerid][0]), caridhouse[playerid][0] = 0;
			if(!strcmp(PI[playerid][pNames], HouseInfo[PI[playerid][pArendaHouse]][hRent])) SetPVarInt(playerid, #arenda_true, 1);
			if(!strcmp(PI[playerid][pNames], HouseInfo[PI[playerid][pArendaHouse]][hRent1])) SetPVarInt(playerid, #arenda_true, 2);
			switch(GetPVarInt(playerid, #arenda_true))
			{
				case 1: caridhouse[playerid][0] = CreateVehicle(PI[playerid][pCar][carid-1], 1765.7814,-1902.5984,498.2116,270.4314, gPlayerTuning[playerid][carid-1][1], 0, 600_000);
				case 2: caridhouse[playerid][0] = CreateVehicle(PI[playerid][pCar][carid-1], 1773.2358,-1909.8566,498.2002,318.3326, gPlayerTuning[playerid][carid-1][1], 0, 600_000);
			}
			LinkVehicleToInterior(caridhouse[playerid][0], 1); SetVehicleVirtualWorld(caridhouse[playerid][0], house+50);
			SetVehicleNumberPlate(caridhouse[playerid][0], NumberVehicle[playerid][carid-1]);
			
			if(gPlayerTuning[playerid][carid-1][0] != 255) ChangeVehiclePaintjob(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][0]);
			for(new F = 2; F <= 11; F++) if(gPlayerTuning[playerid][carid-1][F] != -1) AC_AddVehicleComponent(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][F]);
			ChangeVehicleColor(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][1], 0);
			
			PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
			SetVehicleParamsForPlayer(caridhouse[playerid][0], 0, 0, false);
			DeletePVar(playerid, #arenda_true);
			return 1;
		}
		if(caridhouse[playerid][carid-1] != 0) DestroyVehicle(caridhouse[playerid][carid-1]), caridhouse[playerid][carid-1] = 0;
		switch(carid)
		{
			case 1: caridhouse[playerid][0] = CreateVehicle(PI[playerid][pCar][0], 958.3719,2141.3835,1004.4115, 90.0000, gPlayerTuning[playerid][carid-1][1], 0, 600_000);
			case 2: caridhouse[playerid][1] = CreateVehicle(PI[playerid][pCar][1], 958.4439,2134.9265,1004.4115, 90.0000, gPlayerTuning[playerid][carid-1][1], 0, 600_000);
			case 3: caridhouse[playerid][2] = CreateVehicle(PI[playerid][pCar][2], 958.5577,2125.3237,1004.4115, 90.0000, gPlayerTuning[playerid][carid-1][1], 0, 600_000);
		}
		if(caridhouse[playerid][carid-1] <= 0) return SendClientMessage(playerid, -1, "Критическая ошибка - LoadVehicleToHouse [ сообщите об этом в раздел баги / ошибки на форуме! ]");
		LinkVehicleToInterior(caridhouse[playerid][carid-1], 0);
		SetVehicleVirtualWorld(caridhouse[playerid][carid-1], house+50);
		SetVehicleNumberPlate(caridhouse[playerid][carid-1], NumberVehicle[playerid][carid-1]);
		
		if(gPlayerTuning[playerid][carid-1][0] != 255) ChangeVehiclePaintjob(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][0]);
		for(new F = 2; F <= 11; F++) if(gPlayerTuning[playerid][carid-1][F] != -1) AC_AddVehicleComponent(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][F]);
		ChangeVehicleColor(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][1], 0);
		
		SetVehicleParamsForPlayer(caridhouse[playerid][carid - 1], 0 ,0, false);
	}
	else if(!HouseInfo[house][hGarage] && PI[playerid][pArendaHouse] == -1)
	{
		if(caridhouse[playerid][0] != 0) DestroyVehicle(caridhouse[playerid][0]), caridhouse[playerid][0] = 0;
		else if(caridhouse[playerid][1] != 0) DestroyVehicle(caridhouse[playerid][1]), caridhouse[playerid][1] = 0;
		else if(caridhouse[playerid][2] != 0) DestroyVehicle(caridhouse[playerid][2]), caridhouse[playerid][2] = 0;
		
		caridhouse[playerid][carid-1] = CreateVehicle(PI[playerid][pCar][carid-1], HouseInfo[house][hCar][0],HouseInfo[house][hCar][1],HouseInfo[house][hCar][2],HouseInfo[house][hCar][3], gPlayerTuning[playerid][carid-1][1], 0, 600_000);
		LinkVehicleToInterior(caridhouse[playerid][carid-1], 0);
		SetVehicleVirtualWorld(caridhouse[playerid][carid-1], 0);
		SetVehicleNumberPlate(caridhouse[playerid][carid-1], NumberVehicle[playerid][carid-1]);

		if(gPlayerTuning[playerid][carid-1][0] != 255) ChangeVehiclePaintjob(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][0]);
		for(new F = 2; F <= 11; F++) if(gPlayerTuning[playerid][carid-1][F] != -1) AC_AddVehicleComponent(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][F]);
		ChangeVehicleColor(caridhouse[playerid][carid-1], gPlayerTuning[playerid][carid-1][1], 0);
		
		SetVehicleParamsForPlayer(caridhouse[playerid][carid - 1], 0 ,0, false);
	}
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	return 1;
}
