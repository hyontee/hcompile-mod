ToggleEngine(vehicleid, playerid)
{
    new engine,
		lights,
		alarm,
		doors,
		bonnet,
		boot,
		objective;

	if(!IsAVel(vehicleid))
	{
	    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	    SetVehicleParamsEx(vehicleid, (engine) ? (false) : (true), VehInfo[vehicleid-1][vLamp], alarm, VehInfo[vehicleid-1][vLock], bonnet, boot, objective);
	    GameTextForPlayer(playerid, (engine) ? ("~r~ENGINE OFF") : ("~g~ENGINE ON"), 5000, 3);
	}
	return 1;
}

SetSpawnInfoEx(playerid, skin, Float:x, Float:y, Float:z, Float:a)
    return SetSpawnInfo(playerid, 255, skin, x, y, z-0.2, a, 0, 0, 0, 0, 0, 0);

CreateTray(Float:x, Float:y, Float:z, Float:a, vw)
{
	new slot = -1;
	for(new i; i < sizeof(TrayData); i ++)
	{
		if(TrayData[i][trayPickupID]) continue;
		slot = i;
		break;
	}
	if(slot == -1) return 0;
	x += (2.0 * floatsin(-a, degrees));
	y += (2.0 * floatcos(-a, degrees));
	TrayData[slot][trayPickupID] = CreatePickup(2355, 23, x, y, z-0.6, vw);
	TrayData[slot][trayTimerID] = SetTimerEx("DestroyTray", 300000, false, "i", slot);
	return 1;
}

GetTray(playerid, tray)
{
    SetPVarInt(playerid, "TrayInfo_Use", true);
	SetPlayerSpecialAction(playerid, 25);
	SetPlayerAttachedObject(playerid, 0, 2355, 1, 0.096313, 0.334523, -0.267872, 109.200798, 122.924514, 313.923736, 1.025472, 1.000000, 1.000000 );
	SendClientMessage(playerid, -1, ""#information"Вы успешно взяли поднос с едой, съесть: "SERVER"/eat"WHITE", положить на пол: "SERVER"/put");
	DestroyPickup(TrayData[tray][trayPickupID]);
	KillTimer(TrayData[tray][trayTimerID]);
	TrayData[tray][trayPickupID] = 0;
	TrayData[tray][trayTimerID] = 0;
	return 1;
}

forward DestroyTray(tray);
public DestroyTray(tray)
{
	if(TrayData[tray][trayPickupID]) DestroyPickup(TrayData[tray][trayPickupID]);
	KillTimer(TrayData[tray][trayTimerID]);
	TrayData[tray][trayPickupID] = 0;
	TrayData[tray][trayTimerID] = 0;
	return 1;
}
