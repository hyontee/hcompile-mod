cmd:spveh(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 3))
		return true;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, ""#information"Используйте: /spveh [радиус]");
	if(params[0]>100) return ErrorMessage(playerid, "Слишком большой радиус");
	new spveh=0;
	for(new c = 1, j = GetVehiclePoolSize(); c <= j; c++)
	{
		if(!IsValidVehicle(c)) continue;
		if(PlayerToPoint(params[0], playerid, VehInfo[c-1][vehicleX], VehInfo[c-1][vehicleY], VehInfo[c-1][vehicleZ]))
		{
			if(IsVehicleOccupied(c)) continue;
           	SetVehicleToRespawn(c);
           	spveh++;
		}
	}
	format(string, 128, "[A] %s обновил весь транспорт стоящий рядом с ним ( %i машин )", PI[playerid][pNames], spveh);
	SendAdminMessage(COLOR_GREY, string);
	return 1;
}
cmd:arrest(playerid, params[])
{
	if(!IsACop(playerid)) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(!PlayerToPoint(6.0, playerid, 2896.3547,1785.2848,1088.4106) && !PlayerToPoint(6.0, playerid, 218.2263, 114.9286, 999.0156) && !PlayerToPoint(6.0, playerid, 198.3940, 157.9389, 1003.0234) && !PlayerToPoint(6.0, playerid, 808.5193, -57.5857, 994.6209)) return 1;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, ""#information"/arrest [кол-во минут]");
	if(params[0] < 10 || params[0] > 40) return ErrorMessage(playerid, "Количество минут от 10 до 40");
	new suspect = GetClosestPlayer(playerid);
	if(!IsPlayerConnected(suspect)) return ErrorMessage(playerid, "Игрок не найден");
	if(!ProxDetectorS(4.0, playerid, suspect)) return ErrorMessage(playerid, "Рядом с вами никого нет!");
	if(PI[suspect][pWanted] < 1) return ErrorMessage(playerid, "Человек должен иметь хотя бы один уровень розыска!");
	if(GetPVarInt(playerid, "walk_goto_me_player"))
	{
	    walk_goto_me[GetPVarInt(playerid, "walk_goto_me_player") - 1]=0;
	    ClearAnimations(GetPVarInt(playerid, "walk_goto_me_player") - 1, true);
		DeletePVar(playerid, "walk_goto_me_player");
	}
	SCMF(suspect, 0x6ab1ffaa, "Вас посадил в тюрьму %s на %d секунд", PI[playerid][pNames], params[0]*60);
	SCMF(playerid, 0x6ab1ffaa, "Вы посадили в тюрьму %s на %d секунд", PI[suspect][pNames], params[0]*60);
	if(PI[suspect][pDRInections]) {
		params[0] = params[0]/2;
		SendClientMessage(suspect, 0x6ab1ffaa, "Поскольку вы владелец Brilliant VIP, время заключения уменьшено вдвое.");
		SCMF(suspect, 0x6ab1ffaa, "Вам необходимо отсидеть: %d секунд.", params[0]*60);
	}
	if(GetPVarInt(playerid, "walk_goto_me_player"))
	{
	    walk_goto_me[GetPVarInt(playerid, "walk_goto_me_player") - 1]=0;
	    ClearAnimations(GetPVarInt(playerid, "walk_goto_me_player") - 1, true);
		DeletePVar(playerid, "walk_goto_me_player");
		SendClientMessage(playerid, -1, "Вы отключили ходьбу за игроком");
	}
	PI[playerid][pPayCheck] += (PI[suspect][pWanted]*200);
	ResetPlayerWeapons(suspect);
	SetPlayerSpecialAction(suspect, SPECIAL_ACTION_NONE);
	TogglePlayerControllable(suspect, 1);
	DeletePVar(suspect, "PlayerCuffed");
	SetPlayerWantedLevel(suspect, 0);
	PI[suspect][pJailTime] = params[0]*60;
	PI[suspect][pWanted] = 0;
	PI[suspect][pZakonp] --;
	if(PlayerToPoint(6.0, playerid, 2896.3547,1785.2848,1088.4106))
	{
		PI[suspect][pMestoJail] = 1;
		switch(random(8))
		{
			case 0: SetPlayerPos(suspect, 2897.9143,1788.0468,1088.4106),SetPlayerFacingAngle(suspect, 180.0);
			case 1: SetPlayerPos(suspect, 2901.2275,1788.0468,1088.4106),SetPlayerFacingAngle(suspect, 180.0);
			case 2: SetPlayerPos(suspect, 2904.6006,1788.0468,1088.4106),SetPlayerFacingAngle(suspect, 180.0);
			case 3: SetPlayerPos(suspect, 2907.9966,1788.0468,1088.4106),SetPlayerFacingAngle(suspect, 180.0);
			case 4: SetPlayerPos(suspect, 2908.1548,1782.2065,1088.4106),SetPlayerFacingAngle(suspect, 360.0);
			case 5: SetPlayerPos(suspect, 2904.4519,1782.2065,1088.4106),SetPlayerFacingAngle(suspect, 360.0);
			case 6: SetPlayerPos(suspect, 2901.1973,1782.2065,1088.4106),SetPlayerFacingAngle(suspect, 360.0);
			case 7: SetPlayerPos(suspect, 2897.9927,1781.2065,1088.4106),SetPlayerFacingAngle(suspect, 360.0);
		}
		SetPlayerInterior(suspect,0);
		SetPlayerVirtualWorld(suspect, 25);
	}
	else if(PlayerToPoint(6.0, playerid, 218.2263, 114.9286, 999.0156))
	{
		PI[suspect][pMestoJail] = 2;
		SetPlayerInterior(suspect, 10);
		SetPlayerPos(suspect, 219.5400, 109.9767, 999.0156);
		SetPlayerFacingAngle(suspect, 1.0000);
	}
	else if(PlayerToPoint(6.0, playerid, 198.3940, 157.9389, 1003.0234))
	{
		PI[suspect][pMestoJail] = 3;
		SetPlayerInterior(suspect, 3);
		SetPlayerPos(suspect, 198.3642, 161.8103, 1003.0300);
		SetPlayerFacingAngle(suspect, 1.0000);
	}
	else if(PlayerToPoint(6.0, playerid, 808.5193, -57.5857, 994.6209))
	{
		PI[suspect][pMestoJail] = 4;
		SetPlayerInterior(suspect, 1);
		SetPlayerPos(suspect, 805.0851, -57.7863, 994.6209);
		SetPlayerFacingAngle(suspect, 271.1044);
	}
	mysql_format(1, string, 164, "UPDATE `accounts` SET `pJailTime` = '%d', `pWanted` = '0', `pMestoJail` = '%d', `pZakonp` = '%d' WHERE `id` = '%d'", PI[suspect][pJailTime], PI[suspect][pMestoJail], PI[suspect][pZakonp], PI[suspect][pID]);
	mysql_tquery(1, string);
	return 1;
}
cmd:frisk(playerid, params[])
{
	if(!IsACop(playerid) && !IsAArm(playerid)) return ErrorMessage(playerid, "Вы не член Полиции/ФБР/Армии!");
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/frisk [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(3.0, playerid, params[0])) return ErrorMessage(playerid, "Этого игрока рядом с вами нет!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете обыскать себя!");
	new text1[30], text2[20];
	SCMF(playerid, COLOR_WHITE, "==== Вещи %s ====", PI[params[0]][pNames]);
	if(PI[params[0]][pDrugs] > 0) format(text1, 30, "Наркотиков: %i грамм", PI[params[0]][pDrugs]);
	else format(text1, 20, "- Пустой карман.");
	SendClientMessage(playerid, COLOR_GREY, text1);

	if(PI[params[0]][pMats] > 0) format(text2, 30, "Материалы: %i штук", PI[params[0]][pMats]);
	else format(text2, 20, "- Пустой карман.");
	SendClientMessage(playerid, COLOR_GREY, text2);
	SendClientMessage(playerid, COLOR_WHITE, "=================");
	format(string, 64, "* %s обыскал %s", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	return 1;
}
cmd:wanted(playerid)
{
	if(!IsACop(playerid)) return ErrorMessage(playerid, "Вы не коп / FBI / National Guard.");
	SendClientMessage(playerid, COLOR_WHITE, "Внимание, розыскиваются:");
	foreach(Player, i)
	{
		if(PI[i][pWanted] < 1) continue;
		SCMF(playerid, COLOR_WHITE, "Имя: {6495ED}%s "WHITE"ID: {6495ED}%d "WHITE"Уровень розыска: {6495ED}%d", PI[i][pNames], i, PI[i][pWanted]);
	}
	return 1;
}
cmd:patrul(playerid)
{
	if((PI[playerid][pMember] != 1 && PI[playerid][pMember] != 2 && PI[playerid][pMember] != 10 && PI[playerid][pMember] != 21) && PI[playerid][pRank] < 3) return ErrorMessage(playerid, "Вы не состоите в полиции или FBI.");
	if(GetPVarInt(playerid, "Patrul"))
	{
		DeletePVar(playerid, "Patrul");
		patrul_id[playerid] = -1;
		KillTimer(GetPVarInt(playerid, "StartWanted")), DeletePVar(playerid, "StartWanted");
		DisablePlayerCheckpoint(playerid);
		SendClientMessage(playerid, COLOR_GREEN, "Преследование окончено.");
		return 1;
	}
	WantedList(playerid);
	return 1;
}
cmd:shift(playerid)
{
	if(PI[playerid][pMember] != 1 && PI[playerid][pMember] != 2 && PI[playerid][pMember] != 10 && PI[playerid][pMember] != 21) return ErrorMessage(playerid, "Вы не состоите в полиции или FBI.");
	if(GetPVarInt(playerid, "OnShift") > -1)
	{
		SendClientMessage(playerid, COLOR_GREEN, "Патруль окончен.");
		format(string, sizeof(string), "[!] %s закончил патруль в районе %s.", PI[playerid][pNames], gSAZones[GetPVarInt(playerid, "OnShift")][SAZONE_NAME]);
		foreach(Player, i) if(IsACop(i)) SendClientMessage(i, 0x007FFFFF, string);
		SetPVarInt(playerid, "OnShift", -1);
		return 1;
	}
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	new id = GetZonaName ( x, y );
	SetPVarInt(playerid, "OnShift", id);
	format(string, sizeof(string), "[!] %s начал патруль в районе %s.", PI[playerid][pNames], gSAZones[GetPVarInt(playerid, "OnShift")][SAZONE_NAME]);
	foreach(Player, i) if(IsACop(i)) SendClientMessage(i, 0x007FFFFF, string);
	SendClientMessage(playerid, COLOR_GREEN, "Вы начали патруль. Чтобы закончить, напишите /shift еще раз.");
	return 1;
}
cmd:shiftlist(playerid)
{
	if((PI[playerid][pMember] != 1 && PI[playerid][pMember] != 2 && PI[playerid][pMember] != 10 && PI[playerid][pMember] != 21) && PI[playerid][pRank] < 5) return ErrorMessage(playerid, "Вы не состоите в полиции или FBI.");
	string = "";
	foreach(Player, i)
	{
		if(GetPVarInt(i, "OnShift") > -1) format(string, sizeof(string), "%s{20B2AA}%s "WHITE"патрулирует в районе {20B2AA}%s\n", string, PI[i][pNames], gSAZones[GetPVarInt(i, "OnShift")][SAZONE_NAME]);
	}
	if(!strlen(string)) format(string, sizeof(string), ""WHITE"Патрули в данный момент не ведутся.");
	ShowPlayerDialog(playerid, 3068, DIALOG_STYLE_MSGBOX, "{00B464}Текущие патрули:", string, "OK", "");
	return 1;
}
cmd:p(playerid)
{
	new callid =GetPVarInt(playerid, "called")-1;
	if(callid == playerid) return 1;
	if(!IsPlayerConnected(callid)) return ErrorMessage(playerid, "Вам никто не звонит");

	format(stringer, 128, "%s ответил(а) на ваш звонок", PI[playerid][pNames]);
	SendClientMessage(callid, CGREEN, stringer);
	SendClientMessage(playerid, CGREEN, "Вы подняли трубку");

	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
	SetPlayerAttachedObject(playerid, 2, 18873, 6, 0.09, 0.019, -0.011, 88.90, -176.40, 0.49, 0.787, 0.753, 0.562);

	MeAction(playerid, "ответил(а) на звонок");
	SetPVarInt(playerid, "talkcall", true);
	SetPVarInt(callid, "talkcall", true);
	return 1;
}

cmd:h(playerid)
{
	new callid =GetPVarInt(playerid, "called")-1;
	if(callid == playerid) return 1;
	if(!IsPlayerConnected(callid)) return ErrorMessage(playerid, "Вам никто не звонит");

	format(stringer, 128, "%s положил(а) трубку", PI[playerid][pNames]);
	SendClientMessage(callid, CRED, stringer);
	SendClientMessage(playerid, CGREEN, "Вы положили трубку");

	MeAction(playerid, "положил(а) трубку");

	CellTime{callid} = false;
	CellTime{playerid} = false;

	DeletePVar(playerid, "talkcall");
	DeletePVar(playerid, "called");
	DeletePVar(callid, "talkcall");
	DeletePVar(callid, "called");
	SetPVarInt(playerid, "TalkingLive", 999);
	SetPVarInt(playerid, "TalkingLivels", 999);
	DeletePVar(playerid, "Tel");
	DeletePVar(playerid, "zvonok");

 	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
 	SetPlayerSpecialAction(callid, SPECIAL_ACTION_STOPUSECELLPHONE);
  	RemovePlayerAttachedObject(playerid, 2);
  	RemovePlayerAttachedObject(callid, 2);
	return 1;
}
cmd:tpcor(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	new Float:x, Float:z, Float:y;
	if(sscanf(params, "p<,>fff", x, y, z))
		return SendClientMessage(playerid, 0xFFFFFFFF, ""#information"Используйте /tpcor [x] [y] [z]");
	SetPlayerPos(playerid, Float:x, Float:y, Float:z);
	return 1;
}
alias:re("recon");
cmd:re(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(!strcmp(params, "off") && GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && GetPVarInt(playerid, "Spectate")) return TogglePlayerSpectating(playerid, false);
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/re(con) [ид игрока]");
	if(params[0] > MAX_PLAYERS || params[0] < 0) return true;
	new ip[16];
	GetPlayerIp(params[0], ip, sizeof ip);
	if(!strcmp(ip, "46.174.53.176")) return true;
	if(!PI[playerid][pLogin]) return 1;
	if(PI[params[0]][pAdmin] > 13) return true;
	PlayerTextDrawDestroy(playerid, PlayerText:ReconPlayerText[playerid][0]);
	PlayerTextDrawDestroy(playerid, PlayerText:ReconPlayerText[playerid][1]);
 	ReconPlayerText[playerid][0] = CreatePlayerTextDraw(playerid, 589.00, 145.00, "Nik Anson~n~ID: 666");
	PlayerTextDrawAlignment(playerid, ReconPlayerText[playerid][0], 2);
	PlayerTextDrawLetterSize(playerid, ReconPlayerText[playerid][0], 0.240000, 0.899999);
	ReconPlayerText[playerid][1] = CreatePlayerTextDraw(playerid, 578.00, 165.00, "1 : 1 / 8~n~0~n~0~n~50~n~0~n~0 / 0~n~86~n~0 : 0 ~n~0 / 0 : 0%~n~0 / 0 : 0%~n~23 : 0");
	PlayerTextDrawLetterSize(playerid, ReconPlayerText[playerid][1], 0.199999, 0.899999);
	for(new x=0x0; x < 2; x ++)
	{
		PlayerTextDrawBackgroundColor(playerid, ReconPlayerText[playerid][x], 255);
		PlayerTextDrawFont(playerid, ReconPlayerText[playerid][x], 1);
		PlayerTextDrawColor(playerid, ReconPlayerText[playerid][x], -1);
		PlayerTextDrawSetOutline(playerid, ReconPlayerText[playerid][x], 1);
		PlayerTextDrawSetProportional(playerid, ReconPlayerText[playerid][x], 1);
		PlayerTextDrawSetShadow(playerid, ReconPlayerText[playerid][x], 0);
	}
	if(!GetPVarInt(playerid, "Spectate"))
	{
		GetPlayerPos(playerid, gPlayerPosition[playerid][0], gPlayerPosition[playerid][1], gPlayerPosition[playerid][2]);
		gPIrmation[playerid][0] = GetPlayerInterior(playerid);
		gPIrmation[playerid][1] = GetPlayerVirtualWorld(playerid);
	}
	TogglePlayerSpectating(playerid, true);
	SetPlayerInterior(playerid, GetPlayerInterior(params[0]));
	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(params[0]));
	if(IsPlayerInAnyVehicle(params[0])) PlayerSpectateVehicle(playerid, VehicleEnters[params[0]]);
	else PlayerSpectatePlayer(playerid, params[0]);
	for(new x; x < 2; x ++) PlayerTextDrawShow(playerid, PlayerText:ReconPlayerText[playerid][x]);
	TextDrawShowForPlayer(playerid, ReconText);
	SetPVarInt(playerid, "Spectate", true);
	SetPVarInt(playerid, "SpectateID", params[0]);
 	format(string, sizeof(string), "[A] %s [%i] начал слежку за %s [%i]", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0]);
 	SendAdminMessage(COLOR_GREY, string);
	SendClientMessage(playerid, COLOR_SERVER, "Для того чтобы закочить слежку за игроком, нажмите клавишу "WHITE"''ПРОБЕЛ''");
	SendClientMessage(playerid, COLOR_SERVER, "Чтобы переключаться между игроками, нажимайте клавиши "WHITE"NUM4 - назад | NUM6 - вперед");
	SendClientMessage(playerid, COLOR_SERVER, "Чтобы перепоказать игрока нажмите клавишу "WHITE"''ALT''");
	if(GetPVarInt(params[0], #icon_banner)) SendClientMessage(playerid, COLOR_SERVER, "Внимание! Этот игрок находится в меню выбора банеров!");
	return 1;
}
