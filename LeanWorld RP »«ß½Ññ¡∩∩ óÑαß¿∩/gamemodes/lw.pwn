cmd:ghetto(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(gAdminReason[playerid][ADMIN_GHETTO])
		return ErrorMessage(playerid, "У вас нету доступа к данной команде!");

	new str[211 + 1];
	format(str, sizeof str, "{FFFFFF}Grove:\t%s\nAztec:\t%s\nBallas:\t%s\nRifa:\t%s\nVagos:\t%s", (b_Ghetto{0} ? ("{FF2E31}Запрет включен{FFFFFF}") : ("{00CA2F}Запрет выключен{FFFFFF}")), (b_Ghetto{1} ? ("{FF2E31}Запрет включен{FFFFFF}") : ("{00CA2F}Запрет выключен{FFFFFF}")), (b_Ghetto{2} ? ("{FF2E31}Запрет включен{FFFFFF}") : ("{00CA2F}Запрет выключен{FFFFFF}")), (b_Ghetto{3} ? ("{FF2E31}Запрет включен{FFFFFF}") : ("{00CA2F}Запрет выключен{FFFFFF}")), (b_Ghetto{4} ? ("{FF2E31}Запрет включен{FFFFFF}") : ("{00CA2F}Запрет выключен{FFFFFF}")));
	ShowPlayerDialog(playerid, 969, DIALOG_STYLE_LIST, ""SERVER"Ghetto Menu", str, "Изменить", "Отмена");
	return 1;
}
cmd:payday(playerid)
{
	if(D_FULL(PI[playerid][pNames])) return PayDay();
	return 1;
}
cmd:selfie(playerid, params[])
{
	if(!GetPVarInt(playerid, "takingselfie"))
	{
	    new Float:PLAYER_POS[3];
	    GetPlayerPos(playerid, PLAYER_POS[0], PLAYER_POS[1], PLAYER_POS[2]);
	    SetPVarFloat(playerid, "lX", PLAYER_POS[0]);
	    SetPVarFloat(playerid, "lY", PLAYER_POS[1]);
	    SetPVarFloat(playerid, "lZ", PLAYER_POS[2]);

	    if(GetPVarFloat(playerid, "Degree") >= 360) DeletePVar(playerid, "Degree");
	    SetPVarFloat(playerid, "Degree", GetPVarFloat(playerid, "Degree") + Speed123);
		PLAYER_POS[0] = GetPVarFloat(playerid, "lX") + Radius * floatcos(GetPVarFloat(playerid, "Degree"), degrees);
		PLAYER_POS[1] = GetPVarFloat(playerid, "lY") + Radius * floatsin(GetPVarFloat(playerid, "Degree"), degrees);
		SetPlayerCameraPos(playerid, PLAYER_POS[0], PLAYER_POS[1], GetPVarFloat(playerid, "lZ") + Height);
		SetPlayerCameraLookAt(playerid, GetPVarFloat(playerid, "lX"), GetPVarFloat(playerid, "lY"), GetPVarFloat(playerid, "lZ")+1);
		SetPlayerFacingAngle(playerid, GetPVarFloat(playerid, "Degree") - 90.0);
		SetPVarInt(playerid, "takingselfie", true);
		SendClientMessage(playerid, COLOR_SERVER, "Используйте "WHITE"NUM 4"SERVER" или "WHITE"NUM 6"SERVER" чтобы двигать камеру");
		SendClientMessage(playerid, COLOR_SERVER, "Также используйте "WHITE"/headmove"SERVER" чтобы лицо смотрело прямо");
		SendClientMessage(playerid, -1, "F8"SERVER" - чтобы сделать скриншот, для выхода используйте "WHITE"/selfie");
		ApplyAnimation(playerid, "PED", "gang_gunstand", 4.1, 1, 1, 1, 1, 1, 1);
	}
    else
	{
	    TogglePlayerControllable(playerid, 1);
		SetCameraBehindPlayer(playerid);
	    DeletePVar(playerid, "takingselfie");
	    DeletePVar(playerid, "Degree");
	    DeletePVar(playerid, "lX");
	    DeletePVar(playerid, "lY");
	    DeletePVar(playerid, "lZ");
	    ApplyAnimation(playerid, "PED", "ATM", 4.1, 0, 1, 1, 0, 1, 1);
	}
    return 1;
}
cmd:ftazer(playerid, params[])
{
	if(PI[playerid][pMember] != 2) return 1;
    if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вам необходимо начать рабочий день на базе организаций");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, "Используйте: /ftazer [1/2/3]");
	new Float:X, Float:Y, Float:Z;
 	GetPlayerPos(playerid, X, Y, Z);
 	string = "";
	foreach(Player, i)
	{
        if(!PlayerToPoint(10.0, i, X, Y, Z) || i == playerid) continue;
        if((!IsAArm(i) || !IsACop(i) || !IsAMedic(i)) && params[0] == 2) continue;
        if((!PI[i][pMember] || !IsAGang(i) || !ISAMAFIA(i)) && params[0] == 3) continue;
        format(string, 144, " Агент ФБР %s оглушил %s", PI[playerid][pNames], (params[0]==1) ? ("всех"):(params[0]==2)?("всех рядомстоящих законников"):("рядомстоящих жителей"));
		SendClientMessage(i, 0xE75480FF, string);
		TogglePlayerControllable(i, false);
		ClearAnimations(i);
		ApplyAnimation(i, "PED", "KO_skid_front", 4.1, 0, 1, 1, 1, 0);
		SendClientMessage(i, -1, "Вы заморожены на 15 секунд");
		SetPVarInt(i, "PlayerCuffed", 1), SetPVarInt(i, "PlayerCuffedTime", 15);
		break;
	}
	return 1;
}
cmd:hi(playerid, params[])
{
	if(GetPVarInt(playerid, "hiFlood") > unix) return 1;
	if(sscanf(params, "u", params[0])) return SendEsp(playerid, "/hi [id]");
	if(!IsPlayerConnected(params[0]) || params[0] == playerid || IsPlayerInAnyVehicle(playerid)) return 1;
	if(!ProxDetectorS(2.0, playerid, params[0])) return 1;
	new Float:Boshka;
	GetPlayerFacingAngle(playerid, Boshka);
	SetPlayerFacingAngle(params[0], Boshka + 180);
	format(string, SMALL_SIZE+10, "* %s пожал(-а) руку %s", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(10.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	ApplyAnimation(playerid, "GANGS", "hndshkfa", 4.0, 0, 0, 0, 0, 0);
	ApplyAnimation(params[0], "GANGS", "hndshkfa", 4.0, 0, 0, 0, 0, 0);
	SetPVarInt(playerid, "hiFlood", unix+5);
	return 1;
}
cmd:flower(playerid, params[])
{
	if(GetPlayerWeapon(playerid) != 14) return ErrorMessage(playerid, "У Вас нет цветов!");
	if(sscanf(params, "u", params[0])) return SendEsp(playerid, "/flower [id]");
	if(!IsPlayerConnected(params[0]) || params[0] == playerid) return 1;
	if(!ProxDetectorS(2.0, playerid, params[0])) return 1;
	if(GetPlayerWeapon(params[0]) == 14) return ErrorMessage(playerid, "У игрока уже есть цветы!");
	RemovePlayerWeapon(playerid, 14);
	GivePlayerWeapon(params[0], 14, 1);
	SCMF(playerid, -1, "Вы успешно передали игроку {00CC00}%s(%d)"WHITE" Ваши цветы.", PI[params[0]][pNames], params[0]);
	SCMF(params[0], -1, "{00CC00}%s(%d)"WHITE" передал Вам свои цветы.", PI[playerid][pNames], playerid);
	return 1;
}
cmd:kiss(playerid, params[])
{
	if(GetPVarInt(playerid, "kissFlood") > unix) return 1;
	if(sscanf(params, "u", params[0])) return SendEsp(playerid, "/kiss [id]");
	if(IsPlayerInAnyVehicle(playerid) || !IsPlayerConnected(params[0]) || !ProxDetectorS(2.0, playerid, params[0])) return 1;
	new Float:Boshka;
	GetPlayerFacingAngle(playerid, Boshka);
	SetPlayerFacingAngle(params[0], Boshka + 180);
	format(string, SMALL_SIZE+10, "* %s поцеловал(-а) %s", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(10.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	ApplyAnimation(playerid, "KISSING", "Playa_Kiss_02", 3.0, 0, 0, 0, 0, 0);
	ApplyAnimation(params[0], "KISSING", "Playa_Kiss_02", 3.0, 0, 0, 0, 0, 0);
	SetPVarInt(playerid, "kissFlood", unix+5);
	return 1;
}
cmd:geton(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 3))
		return true;
	if(GetPVarInt(playerid, "AntiFloodGeton") > unix && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return ErrorMessage(playerid, "Не флудите!");
	new name[32];
	if(sscanf(params, "s[50]", name)) return SendEsp(playerid, "/geton [имя_аккаунта]");
	mysql_format(1, string, 128, "SELECT `Name`, `pGetonDate` FROM `accounts` WHERE `Name` = '%e'", name);
	mysql_tquery(1, string, "getonDate", "ds", playerid, name);
	SetPVarInt(playerid, "AntiFloodGeton", unix+5);
	return 1;
}
cmd:recorder(playerid, params[])
{
	if(!GetPVarInt(playerid, "boomBox")) return ErrorMessage(playerid, "У Вас нет магнитофона, купите его в 24/7");
	if(GetPVarInt(playerid, "PlacedBB")) return SendClientMessage(playerid, -1, "Вы уже установили магнитофон.");
	new Float:BBCoord[4];
	GetPlayerPos(playerid, BBCoord[0], BBCoord[1], BBCoord[2]);
	GetPlayerFacingAngle(playerid, BBCoord[3]);
	SetPVarFloat(playerid, "BBX", BBCoord[0]);
	SetPVarFloat(playerid, "BBY", BBCoord[1]);
	SetPVarFloat(playerid, "BBZ", BBCoord[2]);
	BBCoord[0] += (2 * floatsin(-BBCoord[3], degrees));
	BBCoord[1] += (2 * floatcos(-BBCoord[3], degrees));
	BBCoord[2] -= 1.0;
	foreach(Player, i)
	{
		if(!GetPVarType(i, "PlacedBB") || !IsPlayerInRangeOfPoint(playerid, 65.0, GetPVarFloat(i, "BBX"), GetPVarFloat(i, "BBY"), GetPVarFloat(i, "BBZ"))) continue;
		return SendClientMessage(playerid, COLOR_WHITE, "Магнитофон уже установлен на землю");
	}
	MeAction(playerid, "установил магнитофон");
	SetPVarInt(playerid, "PlacedBB", CreateDynamicObject(2226, BBCoord[0], BBCoord[1], BBCoord[2], 0.0, 0.0, 0.0, .worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)));
    string = "";
	format(string, 256, "Установил: %s [%d]\n/setrecorder - Сменить песню\n/giverecorder - Убрать", PI[playerid][pNames], playerid);
	SetPVarInt(playerid, "BBLabel", _:CreateDynamic3DTextLabel(string, -1, BBCoord[0], BBCoord[1], BBCoord[2]+0.6, 8, .worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)));
	SetPVarInt(playerid, "BBArea", CreateDynamicSphere(BBCoord[0], BBCoord[1], BBCoord[2], 30.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid)));
	SetPVarInt(playerid, "BBInt", GetPlayerInterior(playerid));
	SetPVarInt(playerid, "BBVW", GetPlayerVirtualWorld(playerid));
	ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
	ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
	Iter_Add(boxPlayer, playerid);
	return 1;
}
cmd:setrecorder(playerid, params[])
{
	if(!GetPVarType(playerid, "PlacedBB")) return SendClientMessage(playerid, -1, "Магнитофон не установлен");
	if(!IsPlayerInRangeOfPoint(playerid, 3.0, GetPVarFloat(playerid, "BBX"), GetPVarFloat(playerid, "BBY"), GetPVarFloat(playerid, "BBZ"))) return SendClientMessage(playerid, -1, "Вы не возле магнитофона");
	ShowPlayerDialog(playerid, 17504, DIALOG_STYLE_LIST, ""SERVER"Radio List", ""WHITE"Record FM\nZaycev FM - Dance\nШансон\nРадио мелодия\nKiss FM\nSky Radio\nСвоя мелодия\n"SERVER""NAME_PROECT"-FM"WHITE"\nZaycev FM - РЕП\nВыключить", "Выбрать", "Выключить");
	return 1;
}
cmd:giverecorder(playerid, params[])
{
	if(!GetPVarInt(playerid, "PlacedBB")) return SendClientMessage(playerid, -1, "Вы не ставили магнитофон");
	if(!IsPlayerInRangeOfPoint(playerid, 3.0, GetPVarFloat(playerid, "BBX"), GetPVarFloat(playerid, "BBY"), GetPVarFloat(playerid, "BBZ"))) return 1;
	foreach(Player, i) if(IsPlayerInDynamicArea(i, GetPVarInt(playerid, "BBArea"))) StopStream(i);
	Iter_Add(boxPlayer, playerid);
	DeletePVar(playerid, "BBArea");
	DestroyDynamicObject(GetPVarInt(playerid, "PlacedBB"));
	DestroyDynamic3DTextLabel(Text3D:GetPVarInt(playerid, "BBLabel"));
	DeletePVar(playerid, "PlacedBB"); DeletePVar(playerid, "BBLabel");
	DeletePVar(playerid, "BBX"); DeletePVar(playerid, "BBY"); DeletePVar(playerid, "BBZ");
	DeletePVar(playerid, "BBInt");
	DeletePVar(playerid, "BBVW");
	DeletePVar(playerid, "BBStation");
	SendClientMessage(playerid, -1, "Вы убрали магнитофон");
	return 1;
}
cmd:makegun(playerid)
{
	if(!IsAArm(playerid) && !IsAGang(playerid) && PI[playerid][pMember] != 23 && !ISAMAFIA(playerid)) return ErrorMessage(playerid, "Недоступно!");
	if(PI[playerid][pPrisonTime]>0 || PI[playerid][pJailTime]>0) return ErrorMessage(playerid, "В тюрьме запрещено использовать данную команду");
	ShowMakeGunList(playerid);
	return 1;
}
cmd:givemedcard(playerid, params[])
{
	if(!IsAMedic(playerid) && PI[playerid][pRank] < 3) return ErrorMessage(playerid, "Вы не мед.работник, или не достигли 3-го ранга.");
	if(sscanf(params, "dd", params[0], params[1])) return SendEsp(playerid, "/givemedcard [ИД] [ЦЕНА]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок не в сети.");
	if(PI[params[0]][pMedCard] == 1) return ErrorMessage(playerid, "Игрок уже имеет медицинскую карту.");
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя самому себе!");
	if(params[1] > 20000 || params[1] < 1) return ErrorMessage(playerid, "Сумма не должна быть больше 20.000$ и меньше 1$");
	if(!ProxDetectorS(2.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с вами!");
	if(PI[params[0]][pCash] < params[1]) return ErrorMessage(playerid, "У игрока не достаточно средств");
	format(string, sizeof string, ""WHITE"Медицинский работник: "SERVER"%s"WHITE"\nПредлагает Вам пройти мед.осмотр и получить медицинскую карту.\n\nДля этого Вам понадобится паспорт и "SERVER"%d$"WHITE" в кармане.\n- Вы согласны ?", PI[playerid][pNames], params[1]);
	ShowPlayerDialog(params[0], 9588, DIALOG_STYLE_MSGBOX, ""SERVER"Получение медицинской карты", string, "Приобрести", "Отмена");
	SCMF(playerid, COLOR_GREY, "Вы предложили %s получить медицинскую карту за %d$", PI[params[0]][pNames], params[1]);
	SetPVarInt(params[0], "myID", playerid);
	SetPVarInt(params[0], "myCenaCard", params[1]);
	return 1;
}
cmd:medcard(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/medcard [ИД]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок не в сети.");
	if(!ProxDetectorS(2.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с вами!");
	if(PI[playerid][pMember]) format(string, sizeof string, "\n"WHITE"Имя: "SERVER"%s"WHITE"\nЛет в штате: "SERVER"%d"WHITE"\nМедицинский осмотр: %s"WHITE"\nМесто работы: {%s}%s\n", PI[playerid][pNames], PI[playerid][pLevel], (PI[playerid][pMedCard] ? ("{"#cGREEN"}Пройден"):("{FF0000}Не пройден")), GetFractionColor[PI[playerid][pMember]], GetMember[PI[playerid][pMember]-1]);
	else format(string, sizeof string, "\n"WHITE"Имя: "SERVER"%s"WHITE"\nЛет в штате: "SERVER"%d"WHITE"\nМедицинский осмотр: %s"WHITE"\nМесто работы: Безработный\n", PI[playerid][pNames], PI[playerid][pLevel], (PI[playerid][pMedCard] ? ("{"#cGREEN"}Пройден"):("{FF0000}Не пройден")));
	ShowPlayerDialog(params[0], 0000, DIALOG_STYLE_MSGBOX, "{FFDD73}Медицинская карта", string, "Закрыть", "");
	return 1;
}
cmd:showarmy(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/showarmy [ID]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок не в сети.");
	if(!ProxDetectorS(2.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с вами!");
	if(GetPVarInt(params[0], "Spectate")) return ErrorMessage(playerid, "Вы слишком далеко от игрока!");
	if(PI[playerid][ArmyPlay]) format(string, sizeof(string), "\n"WHITE"Имя: "SERVER"%s"WHITE"\nВоинский учет: "SERVER"Служил"WHITE"\nДослужил до: "SERVER"%s\n", PI[playerid][pNames], PI[playerid][ArmyRank]);
	else format(string, sizeof(string), "\n"WHITE"Имя: "SERVER"%s"WHITE"\nВоинский учет: "SERVER"---"WHITE"\nНе служил!\n", PI[playerid][pNames]);
	ShowPlayerDialog(params[0], 0000, DIALOG_STYLE_MSGBOX, "{FFDD73}Военный билет", string, "Закрыть", "");
	return 1;
}
cmd:exam(playerid, params[])
{
	if(PI[playerid][pMember] != 11) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(pTemp[playerid][pOnExam])
	{
		new actplayerid = pTemp[playerid][pExamCandidate];
		if(!IsPlayerConnected(actplayerid) || !pTemp[actplayerid][pOnExam])
		{
			pTemp[playerid][pOnExam] = false;
			pTemp[playerid][pExamCandidate] = INVALID_PLAYER_ID;
			return SendClientMessage(playerid, CWHITE, "Экзаменуемый вышел. Экзамен завершен");
		}
		format(string, sizeof(string), "%s экзамен:\n{"#cGREEN"}Сдал\n{"#cRED"}Провалил", PI[actplayerid][pNames]);
		ShowPlayerDialog(playerid, dExamResult, 2, ""SERVER"Экзамен", string, "Принять", "Отмена");
		return 1;
	}
	if(gDSTurn[0] == INVALID_PLAYER_ID) return SendClientMessage(playerid, CGRAY, "В очереди на экзамен никого нет");
	new actplayerid = gDSTurn[0];
	if(!IsPlayerConnected(actplayerid) || !pTemp[actplayerid][pWaitingExam]) return SendClientMessage(playerid, CGRAY, "Игрок вышел из очереди");
	if(GetPlayerDistanceToPlayer(playerid, actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendClientMessage(playerid, CGRAY, "Вы далеко друг от друга");
	new type[24];
	switch(pTemp[actplayerid][pExamType])
	{
	case false: type = "Наземный";
	case true: type = "Воздушный";
	}
	format(string, sizeof(string), "Инструктор %s Вызвал Вас на прохождение экзамена, следуйте за ним", PI[playerid][pNames]);
	SendClientMessage(actplayerid, CINFO, string);
	format(string, sizeof(string), "Вы Вызвали %s на прохождение экзамена. [%s]", PI[actplayerid][pNames], type);
	SendClientMessage(playerid, CINFO, string);
	SendClientMessage(playerid, -1, ""#information"Чтобы поставить печать 'СДАЛ' или же 'ПРОВАЛИЛ' снова введите команду '/exam'");
	pTemp[actplayerid][pWaitingExam] = false;
	pTemp[actplayerid][pOnExam] = true;
	pTemp[playerid][pOnExam] = true;
	pTemp[playerid][pExamCandidate] = actplayerid;
	gDSTurn[0] = INVALID_PLAYER_ID;
	return 1;
}
cmd:loadfs(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	if(sscanf(params, "s[40]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Использование: /loadfs [Имя скрипта]");
	format(string, sizeof(string), "loadfs %s", params[0]);
	SendRconCommand(string);
	SCMF(playerid, COLOR_SERVER, "FilterScript %s успешно загружен", params[0]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /loadfs", PI[playerid][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:unloadfs(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	if(sscanf(params, "s[40]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Использование: /unloadfs [Имя скрипта]");
	format(string, sizeof(string), "unloadfs %s", params[0]);
	SendRconCommand(string);
	SCMF(playerid, COLOR_SERVER, "FilterScript %s успешно выгружен", params[0]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /unloadfs", PI[playerid][pNames]);
	logs(1, log_str, 0);

	return 1;
}
cmd:reloadfs(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	if(sscanf(params, "s[40]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Использование: /reloadfs [Имя скрипта]");
	format(string, sizeof(string), "reloadfs %s", params[0]);
	SendRconCommand(string);
	SCMF(playerid, COLOR_SERVER, "FilterScript %s успешно перезагружен", params[0]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /reloadfs", PI[playerid][pNames]);
	logs(1, log_str, 0);

	return 1;
}
alias:advertise("ad");
cmd:advertise(playerid, params[])
{
	if(gAdvertCount >= MAX_ADVERT_COUNT) return SendClientMessage(playerid, CGRAY, "К сожалению, очередь на объявления занята, попробуйте позже");
	if(GetPVarInt(playerid, #pAdvertTime) > unix) return SendClientMessage(playerid, CGRAY, "Нельзя посылать чаще одного объявления в минуту");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, CGRAY, "/ad [текст объявления]");
	SetPVarString(playerid, "advert", params[0]);
	new price = params[0] * gAdvertPrice;
	format(string, 128, ""WHITE"Цена объявления: {"#cRED"}$%d.\n"WHITE"Вы действительно хотите отправить объявление?", price);
	ShowPlayerDialog(playerid, dAdvertSend, 0, ""SERVER"Объявление", string, "Да", "Нет");
	return 1;
}
cmd:edit(playerid)
{
	if(PI[playerid][pMember] != 16 && !GetAccessAdmin(playerid, 12)) return SendClientMessage(playerid, CGRAY, "Эта функция доступна только сотрудникам новостной сети");
	if(!GetPVarInt(playerid, "StartRabWork") && !GetAccessAdmin(playerid, 12)) return ErrorMessage(playerid, "Вы не начали рабочий день!");
 	if(GetPVarInt(playerid, "adchecking_fix"))
    {
    	gAdvert[GetPVarInt(playerid, "adchecking_fix")-1][adCheking]=false;
    	DeletePVar(playerid, "adchecking_fix");
	}
	ShowAdvertList(playerid);
	return 1;
}
cmd:supports(playerid, params[])
{
	new ttext[32];
	string = "";
	foreach(Player, i)
	{
		if(!PI[i][pHelper]) continue;
		switch(PI[i][pHelper])
		{
			case 1: ttext = "{FFD700}(Support)";
			default: ttext = "{FFD700}(Support)";
		}
		format(string, sizeof(string), "%s%s"WHITE" %s[%d]\n", string, ttext, PI[i][pNames], i);
	}
	if(!strlen(string)) strcat(string, ""WHITE"Нет саппортов онлайн");
	ShowPlayerDialog(playerid, 1019, DIALOG_STYLE_MSGBOX, ""SERVER"Supports онлайн", string, "Закрыть", "");
	return 1;
}
cmd:premlist(playerid, params[])
{
	string = "";
	foreach(Player, i)
	{
		if(!PI[i][pDRInections]) continue;
		format(string, sizeof(string), "%s"WHITE" %s[%d]\n", string, PI[i][pNames], i);
	}
	if(!strlen(string)) strcat(string, ""WHITE"Нет игроков с Brilliant VIP онлайн");
	ShowPlayerDialog(playerid, 1019, DIALOG_STYLE_MSGBOX, ""SERVER"Brilliant VIP (online)", string, "Закрыть", "");
	return 1;
}
