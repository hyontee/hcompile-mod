public OnPlayerLeaveDynamicArea(playerid, areaid)
{
	if(areaid == siren_area)
	{
		for(new i; i < 2; i ++) TextDrawHideForPlayer(playerid, InfoDraw[i]);
		return 1;
	}
	if(antidmarea[0] <= areaid <= antidmarea[1])
	{
	    for(new i; i < 1; i ++) TextDrawHideForPlayer(playerid, AntiDM_Zone[i]);
	    DeletePVar(playerid, "AntiDM_Zone");
	    return 1;
	}
	foreach(new i:boxPlayer)
	{
		if(areaid != GetPVarInt(i, "BBArea")) continue;
		StopStream(playerid);
		break;
	}
    if(areaid == gPlayerInTower{playerid}) gPlayerInTower{playerid} = 0;
	return 1;
}

public OnPlayerEnterDynamicArea(playerid, areaid)
{
    if(antidmarea[0] <= areaid <= antidmarea[1])
	{
	    for(new i; i < 1; i ++) TextDrawShowForPlayer(playerid, AntiDM_Zone[i]);
	    SetPVarInt(playerid, "AntiDM_Zone", true);
	    return 1;
	}
	if(areaid >= Area_SpeedingCam[0] && areaid <= Area_SpeedingCam[MAX_CAM_AREA-1] && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		if(GetTickCount()-GetPVarInt(playerid, "TickArea")<2500||PI[playerid][P_AntiRadar]) return 1;
		SetPVarInt(playerid, "TickArea", GetTickCount());

		new Float:X, Float:Y, Float:Z;
		GetVehicleVelocity(VehicleEnters[playerid], X, Y, Z);
	    new Float:speed_player = VectorSize(X, Y, Z) * 126.31, pl_speed = floatround(speed_player);

		if(pl_speed<MAX_SPEED_RADAR||pl_speed-MAX_SPEED_RADAR<5) return 1;

		SetPVarInt(playerid, "RadarTicket", GetPVarInt(playerid, "RadarTicket")+1);

		new RADAR_COST_BIG_SPEED = (pl_speed * 102);

		SCMF(playerid, COLOR_WARNING, "[Радар]: "WHITE"Вы превысили скорость на "WARNING"%d"WHITE" км/ч, Ваша скорость: "WARNING"%i"WHITE" км/ч. Предупреждений: "WARNING"%i/3",pl_speed-MAX_SPEED_RADAR, pl_speed, GetPVarInt(playerid, "RadarTicket"));

		if(PI[playerid][pCash] > RADAR_COST_BIG_SPEED)
		{
			SCMF(playerid, COLOR_WARNING, "[Радар]: "WHITE"Вы получили штраф в размере: "GREEN"$%i", RADAR_COST_BIG_SPEED);
			Hook_GivePlayerMoney(playerid, -RADAR_COST_BIG_SPEED);
			Gos_Nalog[1] += (Gos_Nalog[1] < 800000000 ? (RADAR_COST_BIG_SPEED) : (0));
			UpdateText(2), SaveInstrument();
		}

		PlayerPlaySound(playerid, 1132, 0.0, 0.0, 0.0);

		if(GetPVarInt(playerid, "RadarTicket") >= 3 && !IsACop(playerid) && PI[playerid][pWanted] < 6)
		{
		    PI[playerid][pWanted] ++;
			SetPlayerWantedLevel(playerid, PI[playerid][pWanted]);
			UpdatePlayerData(playerid, "pWanted", PI[playerid][pWanted]);
			SendClientMessage(playerid, COLOR_WARNING, "Вы были объявлены в розыск за многочисленное превышение скорости!");
			DeletePVar(playerid, "RadarTicket");
		}
		return 1;
	}
	if(areaid >= Urna[0] && areaid <= Urna[1])
	{
		if(areaid == Urna[0])
		{
			if(PI[playerid][pPayDayHad] < 3) return ErrorMessage(playerid, "Голосование с 3 часов игры");
			if(GetPVarInt(playerid, "pGolos")) return ErrorMessage(playerid, "Вы уже голосовали");
			if(!GetPVarInt(playerid, "vote")) return ErrorMessage(playerid, "Возьмите бюллетень (( LALT ))");

			string = ""WHITE"";
			for(new i = 0; i < MAX_VOTES; i++)
			{
				if(strlen(vote_name[i]))
				{
					format(string, 2400, "%s%i. %s (Голосов: %i)\n", string, i+1, vote_name[i], vote_count[i]);
				}
				else format(string, 2400, "%s%i. -\n", string, i+1);
			}
			ShowPlayerDialog(playerid, 9271 + 2, DIALOG_STYLE_LIST, ""SERVER"Список кандитатов", string, "Выбрать", "Закрыть");
		}
		else
		{
			string = ""WHITE"Вы находитесь в избирательном участке, чтобы\nпроголосовать за одного из кандидатов возьмите\nизбирательный бюллетень и поместите его в одну из урн.\n\nСписок кандидатов:\n\n";
			for(new i = 0; i < MAX_VOTES; i++)
			{
				if(strlen(vote_name[i]))
				{
					format(string, 2400, "%s%i. %s (Голосов: %i)\n", string, i+1, vote_name[i], vote_count[i]);
				}
				else format(string, 2400, "%s%i. -\n", string, i+1);
			}
			ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Информация", string, "Закрыть", "");
		}
		return 1;
	}
	if(areaid == siren_area)
	{
		for(new i; i < 2; i ++) TextDrawShowForPlayer(playerid, InfoDraw[i]);
		return 1;
	}
	if(areaid == prodArea)
	{
	    if(VehicleEnters[playerid] && GetPVarInt(playerid, "prod_vehicle_id") == VehicleEnters[playerid] && !GetPVarInt(playerid, "prod_id"))
	    {
	        ToggleEngine(VehicleEnters[playerid], playerid);
	       	ShowPlayerDialog(playerid, 1114, DIALOG_STYLE_INPUT, ""SERVER"Продукты", ""WHITE"Используйте количество продуктов которое вы хотите закупить {"#cGRAY"}(от 100 до 5000)", "Ввод", "");
	        DisablePlayerRaceCheckpoint(playerid);
	    }
	    return 1;
	}
	foreach(new i:boxPlayer)
	{
		if(areaid != GetPVarInt(i, "BBArea")) continue;
		GetPVarString(i, "BBStation", string, sizeof(string));
		if(!isnull(string)) PlayStream(playerid, string, GetPVarFloat(i, "BBX"), GetPVarFloat(i, "BBY"), GetPVarFloat(i, "BBZ"), 30.0, 1);
		break;
	}
	return 1;
}

StopStream(playerid)
{
	DeletePVar(playerid, "pAudioStream");
	StopAudioStreamForPlayer(playerid);
}

PlayStream(playerid, const url[], Float:posX = 0.0, Float:posY = 0.0, Float:posZ = 0.0, Float:distance = 50.0, usepos = 0)
{
	if(GetPVarType(playerid, #pAudioStream)) StopAudioStreamForPlayer(playerid);
	else SetPVarInt(playerid, #pAudioStream, 1);
	PlayAudioStreamForPlayer(playerid, url, posX, posY, posZ, distance, usepos);
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	if(GetPVarInt(playerid, "ProdExit_Car"))
    {
        if(gPlayerProdText[playerid][0] != Text3D:-1 || gPlayerProdText[playerid][1] != Text3D:-1 || gPlayerProdCP[playerid] != -1)
        {
            DeletePVar(playerid, "ProdExit_Car");
		}
	}
	if(strobelight_time_out[vehicleid])
	{
		KillTimer(strobelight_time_out[vehicleid]);
		strobelight_time_out[vehicleid] = -1;
	}
	return 1;
}
public OnPlayerStreamIn(playerid, forplayerid) return 1;
public OnVehicleStreamIn(vehicleid, forplayerid)
{
	if(!IsValidVehicle(vehicleid)) return 1;
	if ( vehicleid != 0 )
	{
		SetVehicleParamsForPlayer(vehicleid,forplayerid,0,VehInfo[vehicleid-1][vLock]);
		UpdateVehiclePos(forplayerid, vehicleid, 0);
	}
	return 1;
}

IsADepartament(i) return (IsAArm(i) || IsAMedic(i) || IsAMayor(i) || PI[i][pMember] == 11 || PI[i][pMember] == 26 || PI[i][pMember] == 25 || PI[i][pMember] == 28 || IsACop(i)) ?true:false;
IsAMedic(playerid)
{
	if(!IsPlayerConnected(playerid)) return 1;
	return(PI[playerid][pMember]==4 || PI[playerid][pMember]==28 || PI[playerid][pMember]==29) ?true:false;
}
IsAMayor(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	return(PI[playerid][pMember] >= 7 && PI[playerid][pMember] <= 9 || PI[playerid][pMember] == 26) ?true:false;
}
IsACop(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new member = PI[playerid][pMember];
	return(member==1 || member==2 || member==21 || member ==25 || member==10 || member==26) ?true:false;
}
IsAArm(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new member = PI[playerid][pMember];
	return(member==3 || member==19 || member==20 || member==27) ?true:false;
}

SellBusiness(playerid)
{
	if(!IsPlayerInRangeOfPoint( playerid, 10.0, BizInfo[PI[playerid][pBusiness]][EnterBiz][0], BizInfo[PI[playerid][pBusiness]][EnterBiz][1], BizInfo[PI[playerid][pBusiness]][EnterBiz][2] ) ) return SendClientMessage(playerid, COLOR_GREY, "{d83927}•{e3e3e3} Надо находиться рядом с бизнесом");
	strmid(BizInfo[PI[playerid][pBusiness]][bOwner], "None", 0, strlen("None"), 255);
	BizInfo[PI[playerid][pBusiness]][bLock] = 0;
	BizInfo[PI[playerid][pBusiness]][bPribil] = 0;
	mysql_format(1, string, MAX_STR, "UPDATE `business` SET `bOwner` = 'None', `bLock` = '0', `bPribil` = '0' WHERE `bID` = '%d'", PI[playerid][pBusiness]);
	mysql_tquery(1, string);
	new nalog = BizInfo[PI[playerid][pBusiness]][bPrice]*Business_Nalog/100;
	Hook_GivePlayerMoney(playerid, BizInfo[PI[playerid][pBusiness]][bPrice] - nalog);
	Gos_Nalog[1] += (Gos_Nalog[1] < 800000000 ? (nalog) : (0));
	UpdateText(2), SaveInstrument();
	UpdateBizInfo (PI[playerid][pBusiness]);
	SaveBusiness(PI[playerid][pBusiness]);
	SCMF(playerid, COLOR_WHITE, "Вы продали свой бизнес за {FFFF00}%i$"WHITE" с учетом налога в размере: {FFFF00}%i"WHITE" процентов", BizInfo[PI[playerid][pBusiness]][bPrice] - nalog, Business_Nalog);
	format(string, 144, "[Продажа бизнеса]: Был продан один из бизнесов, в казну зачислен налог с продажи в размере: %i$", (Gos_Nalog[1] < 800000000 ? (nalog) : (0)));
	SendFractionMessage(26, COLOR_SERVER, string);
	DestroyDynamicObject(BizInfo[PI[playerid][pBusiness]][bObject][0]), DestroyDynamicObject(BizInfo[PI[playerid][pBusiness]][bObject][1]);
	BizInfo[PI[playerid][pBusiness]][bObject][0] = CreateDynamicObjectEx(2286, 1407.399, -1203.203, 158.406, 0.000, 0.000, 0.000, 300.000, 300.000, BizInfo[PI[playerid][pBusiness]][bVW]);
	SetDynamicObjectMaterial(BizInfo[PI[playerid][pBusiness]][bObject][0], 0, 18646, "matcolours", "grey-93-percent", 0x00000000);
	SetDynamicObjectMaterial(BizInfo[PI[playerid][pBusiness]][bObject][0], 1, 18646, "matcolours", "grey-93-percent", 0x00000000);
	SetDynamicObjectMaterialText(BizInfo[PI[playerid][pBusiness]][bObject][0], 0, BizInfo[PI[playerid][pBusiness]][bName], 40, "Ariel", 20, 1, 0xFF000000, 0x00000000, 0);
	BizInfo[PI[playerid][pBusiness]][bObject][1] = CreateDynamicObjectEx(19466, 1402.560, -1207.130, 157.932, 0.000, 0.000, -178.500, 300.000, 300.000, BizInfo[PI[playerid][pBusiness]][bVW]);
	SetDynamicObjectMaterialText(BizInfo[PI[playerid][pBusiness]][bObject][1], 0, BizInfo[PI[playerid][pBusiness]][bOwner], 80, "Ariel", 20, 1, 0xFFFFFFFF, 0x00000000, 0);
	PI[playerid][pBusiness] = -1;
	UpdatePlayerData(playerid, "pPbiskey", -1);
	return 1;
}

ShowBusinessInformation(playerid, bizid)
{
	format(string, BIG_SIZE, ""WHITE"Название бизнеса: "SERVER"\t%s\n\n"WHITE"Владелец: "SERVER"\t\t%s\n"WHITE"Гос. цена: "SERVER"\t\t$%i\n"WHITE"Состояние: \t\t%s\n\n"WHITE"Бюджет бизнеса: "SERVER"\t$%i\n"WHITE"Прибыль бизнеса: "SERVER"\t%i$\n"WHITE"Покупателей за час: "SERVER"\t%i"WHITE" человек(-а)\n"WHITE"Продуктов: "SERVER"\t%i"WHITE" шт",
	BizInfo[bizid][bName], BizInfo[bizid][bOwner], BizInfo[bizid][bPrice], (BizInfo[bizid][bLock] ? ("{"#cRED"}Закрыт") : ("{"#cGREEN"}Открыт")), BizInfo[bizid][bBank], BizInfo[bizid][bPribil], BuyingBusiness[bizid], BizInfo[bizid][bProd]);
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Информация о бизнесе", string, "Выход", "");
}

IsARespa(playerid)
{
	return (PlayerToPoint(50.0, playerid, 2456.3110, -1331.1024, 24.0000)// баллас
	|| PlayerToPoint(50.0, playerid, 2844.4348, -1556.0586, 11.0938) // вагос
	||PlayerToPoint(50.0, playerid, 2492.7532, -1676.3687, 13.3380) // грув
	||PlayerToPoint(50.0, playerid, 2165.5298, -1799.6377, 13.5394) // ацтек
	||PlayerToPoint(50.0, playerid, 2765.1191, -1942.8763, 13.2898) // рифа
	||PlayerToPoint(50.0, playerid, 2028.6213, -1116.5807, -25.2541) // база баллас
	||PlayerToPoint(50.0, playerid, 2507.3789, -1742.4026, -98.9141)// база грув
	||PlayerToPoint(50.0, playerid, 2187.3081, -1829.1321, -18.9141) // база ацтек
	||PlayerToPoint(50.0, playerid, 2842.5720, -2121.3655, 2104.5920) // база рифов
	||PlayerToPoint(50.0, playerid, 2600.1560, -1299.0173, -69.0431)) ? true : false; // база вагос
}
stock IsAPlane(vehicleid){switch(GetVehicleModel(vehicleid)){case 592,577,511,512,593,520,553,476,519,460,513,548,417,487,488,497,563,447,469:return 1;}return 0;}
stock IsABoat(carid){switch (GetVehicleModel(carid)){case 472, 473, 493, 595, 484, 430, 452..454, 446: return 1;}return 0;}
stock IsAVel(vehicleid)
{
	new modelid = GetVehicleModel(vehicleid);
	if(modelid == 509 || modelid == 510 || modelid == 481) return true;
	else return false;
}
