 	if(PI[playerid][pSex] == 1) SetPlayerChatBubble(playerid, "переоделся", COLOR_GREEN, 10.0, 5000);
	else SetPlayerChatBubble(playerid, "переоделась", COLOR_GREEN, 10.0, 5000);
	return true;
}
