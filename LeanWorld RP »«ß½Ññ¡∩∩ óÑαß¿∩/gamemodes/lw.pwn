   	"WHITE"2.15 - Срыв мероприятий\tDeMorgan\t"WARNING"60 минут\n\
   	"WHITE"2.16 - Неадекватный текст на билборде\tDeMorgan\t"WARNING"240 минут\n\
   	"WHITE"2.17 - Использование чит программ\tDeMorgan\t"WARNING"300 минут\n\
   	"WHITE"3.1 - nonRP ник (не по форме Имя_Фамилия) в организации\t"WARNING"Uval\n\
   	"WHITE"3.2 - nonRP причина увольнения | Увольнение из организации. (Исключение: Гетто)\t"WARNING"Uval||Vig\n\
   	"WHITE"3.3 - Мат/оскорбление в нике\t"WARNING"Kick\n\
   	"WHITE"3.4 - Передача аккаунта/Продажа аккаунта\tBan\t"WARNING"999 дней\n\
   	"WHITE"3.5 - Реклама стороннего ресурса\tBan+BanIP\t"WARNING"999 дней", "Принять", "Отмена");
	return 1;
}
CMD:admzp(playerid)
{
	if(!GetAccessAdmin(playerid, 1)) return true;
  	if(pTemp[playerid][admPlayOnline] < 18000) return ErrorMessage(playerid, "Вы должны отыграть норму (5 часов)");
	if(PI[playerid][pAdminzp] == 1) return SCM(playerid,-1,""#net"Вы уже получили зарплату!");
	SCM(playerid,-1,""#good"Спасибо за отличную работу! {FF0000}На ваш аккаунт зачислено 100 рублей");
	PI[playerid][pAdminzp] = 1, PI[playerid][pRubInfo] += 100, PI[playerid][pAdmReputation] ++;
	UpdatePlayerData(playerid, "pAdmReputation", PI[playerid][pAdmReputation]), UpdatePlayerData(playerid, "pAdminzp", PI[playerid][pAdminzp]),UpdatePlayerData(playerid, "pRub", PI[playerid][pRubInfo]);
	return 1;
}
cmd:gps(playerid)
{
	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SCM(playerid, COLOR_GREY, "GPS-навигатор не может установить соединение со спутником. Выйдите на улицу.");
	if(GetPVarInt(playerid,"playerisGPS") == 1)
	{
	    ShowPlayerDialog(playerid, 99, DIALOG_STYLE_MSGBOX, ""SERVER"GPS - Навигатор", ""WHITE"У вас уже включен GPS\nЖелаете отключить?", "Принять", "Отмена");
	    return 1;
	}
	string[0]=EOS;
	strcat(string, ""SERVER"1. "WHITE"Основные места\n");
	strcat(string, ""SERVER"2. "WHITE"Работы\n");
	strcat(string, ""SERVER"3. "WHITE"Государственные организации\n");
	strcat(string, ""SERVER"4. "WHITE"Нелегальные организации\n");
	strcat(string, ""SERVER"5. "WHITE"Автосалоны и тюнинги\n");
	strcat(string, ""SERVER"6. "WHITE"Бизнесы\n\t\n{669933}- Найти ближайшие места");
	return ShowPlayerDialog(playerid, 9624, DIALOG_STYLE_LIST, ""SERVER"GPS - Навигатор", string, "Выбрать","Отмена");
}

