}
cmd:gotomark(playerid)
{
	if (!GetAccessAdmin(playerid, 3))
		return true;
	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new tmpcar = VehicleEnters[playerid];
		AC_SetVehiclePos(tmpcar, TeleportDest[playerid][0], TeleportDest[playerid][1], TeleportDest[playerid][2]);
	}
	else SetPlayerPos(playerid, TeleportDest[playerid][0], TeleportDest[playerid][1], TeleportDest[playerid][2]);
	SendClientMessage(playerid, COLOR_WHITE, "Вы были телепортированы!");
	SetPlayerInterior(playerid, 0);
	return 1;
}
cmd:gotoderby(playerid)
{
	if(!GetAccessAdmin(playerid, 8))
		return true;
	SetPlayerPos(playerid, -1406.2530517578, 998.36901855469, 1024.1569824219);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerInterior(playerid, 15);
	SendClientMessage(playerid, COLOR_GREY, "Вы успешно телепортированы на стадион.");
	return 1;
}
alias:goto("g");
cmd:goto(playerid, params[])
{
    if(!GetAccessAdmin(playerid, 2))
		return true;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/g(oto) [id игрока]");
	if (!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(GetPlayerState(params[0]) != 1 && GetPlayerState(params[0]) != 2 && GetPlayerState(params[0]) != 3) return SendClientMessage(playerid, COLOR_GRAD1, "Игрок не вступил в игру!");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING) return SendClientMessage(playerid, COLOR_GRAD1, "Админ в режиме наблюдения");
	if(GetAccessAdmin(params[0], 14) && !GetAccessAdmin(playerid, 14)) return SendClientMessage(playerid, COLOR_GRAD1, "К этому администратору телепортироваться запрещено!");
	if(GetPVarInt(params[0], "blocktp") == 1) return SendClientMessage(playerid, COLOR_GRAD1, "К этому администратору телепортироваться запрещено!");
	new Float:plocx, Float:plocy, Float:plocz;
	GetPlayerPos(params[0], plocx, plocy, plocz);
	if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new tmpcar = VehicleEnters[playerid];
		AC_SetVehiclePos(tmpcar, plocx, plocy+4, plocz);
	}
	else
	{
		SetPlayerPos(playerid, plocx, plocy+2, plocz);
		SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(params[0]));
		SetPlayerInterior(playerid, GetPlayerInterior(params[0]));
	}
	SendClientMessage(playerid, COLOR_WHITE, "Вы были телепортированы!");
	return 1;
}
cmd:gethere(playerid, params[])
{
	if (!GetAccessAdmin(playerid, 3))
		return true;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/gethere [id игрока]");
	new Float:plocx, Float:plocy, Float:plocz;
	new inter = GetPlayerInterior(playerid);
	new worldd = GetPlayerVirtualWorld(playerid);
	if (!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(PI[params[0]][pDMZ] >= 1) return ErrorMessage(playerid, "Игрок находится в ДМ-зоне!");
	if(GetPlayerState(params[0]) != 1 && GetPlayerState(params[0]) != 2 && GetPlayerState(params[0]) != 3) return SendClientMessage(playerid, COLOR_GRAD1, "Игрок не вступил в игру!");
	if(PI[playerid][pAdmin] < PI[params[0]][pAdmin]) return ErrorMessage(playerid, "Нельзя телепортировать администратора, который старше вас!");
	if(GetAccessAdmin(params[0], 14)) return SendClientMessage(playerid, COLOR_GRAD1, "Нельзя телепортировать этого администратора!");
	GetPlayerPos(playerid, plocx, plocy, plocz);
	if(GetPlayerInterior(playerid) || !GetPlayerInterior(playerid))
	{
		SetPlayerInterior(params[0], inter);
		SetPlayerVirtualWorld(params[0], worldd);
	}
	if(plocz > 930.0 && !GetPlayerInterior(playerid)) SetPlayerInterior(params[0], inter);
	if (GetPlayerState(params[0]) == PLAYER_STATE_DRIVER)
	{
		SetPlayerInterior(params[0], inter);
		new tmpcar = VehicleEnters[params[0]];
		SetPlayerVirtualWorld(params[0], worldd);
		AC_SetVehiclePos(tmpcar, plocx, plocy+4, plocz);
	}
	else
	{
		SetPlayerPos(params[0], plocx, plocy+PLAYER_STATE_DRIVER, plocz);
		SetPlayerInterior(params[0], inter);
		SetPlayerVirtualWorld(params[0], worldd);
	}
	SendClientMessage(params[0], COLOR_WHITE, "Вы были телепортированы администратором "NAME_PROECT".");
	string = "";
	format(string, MAX_STR, "Администратор %s(%d) телепортировал к себе: %s(%d)", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0]);
	SendAdminMessage(COLOR_GREY, string);
	return 1;
}
cmd:atp(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/atp [id игрока]");
		new Float:plocx, Float:plocy, Float:plocz;
		new inter = GetPlayerInterior(playerid);
		new worldd = GetPlayerVirtualWorld(playerid);
		if (!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
		if(PI[params[0]][pDMZ] >= 1) return ErrorMessage(playerid, "Игрок находится в ДМ-зоне!");
		if(GetPlayerState(params[0]) != 1 && GetPlayerState(params[0]) != 2 && GetPlayerState(params[0]) != 3) return SendClientMessage(playerid, COLOR_GRAD1, "Игрок не вступил в игру!");
		GetPlayerPos(playerid, plocx, plocy, plocz);
		if(GetPlayerInterior(playerid) || !GetPlayerInterior(playerid))
		{
			SetPlayerInterior(params[0], inter);
			SetPlayerVirtualWorld(params[0], worldd);
		}
		if(plocz > 930.0 && !GetPlayerInterior(playerid)) SetPlayerInterior(params[0], inter);
		if (GetPlayerState(params[0]) == PLAYER_STATE_DRIVER)
		{
			SetPlayerInterior(params[0], inter);
			new tmpcar = VehicleEnters[params[0]];
			SetPlayerVirtualWorld(params[0], worldd);
			AC_SetVehiclePos(tmpcar, plocx, plocy+4, plocz);
		}
		else
		{
			SetPlayerPos(params[0], plocx, plocy+PLAYER_STATE_DRIVER, plocz);
			SetPlayerInterior(params[0], inter);
			SetPlayerVirtualWorld(params[0], worldd);
		}
		SendClientMessage(params[0], COLOR_WHITE, "Вы были телепортированы администратором "NAME_PROECT".");
		string = "";
		format(string, MAX_STR, "Администратор %s(%d) телепортировал к себе: %s(%d)", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0]);
		SendAdminMessage(COLOR_GREY, string);
	}
	return 1;
}
cmd:blocktp(playerid)
{
	if (!GetAccessAdmin(playerid, 13))
		return true;
	SetPVarInt(playerid, "blocktp", 1);
	return 1;
}
cmd:unblocktp(playerid)
{
	if (!GetAccessAdmin(playerid, 13))
		return true;
	SetPVarInt(playerid, "blocktp", 0);
	return 1;
}
cmd:givegun(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;
	//if(gAdminReason[playerid][ADMIN_GIVEGUN]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "ddd", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WHITE, "Используйте: /givegun [id] [id оружия] [патроны]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID || !(1 <= params[1] <= 46)) return SendClientMessage(playerid, COLOR_GRAD1, ""#net"error");
	if(params[1] == 9 || params[1] == 26 || params[1] == 16 || params[1] == 27 || params[1] == 37 || params[1] == 38 || params[1] == 35 || params[1] == 36 || params[1] == 39 || params[1] == 44 || params[1] == 45) return SendClientMessage(playerid, COLOR_GRAD1, "Нельзя выдавать запрещенное оружие");
	if(params[2] <1||params[2] > 9999) return SendClientMessage(playerid, COLOR_GRAD1, ""#net"Нельзя меньше 1 или больше 9999 патронов!");
	GivePlayerWeapon(params[0], params[1], params[2]);
	SendClientMessage(playerid, COLOR_GRAD1, "'Вы успешно Выдали оружие'");
	string = "";
	format(string, MAX_STR, "Администратор %s выдал %s с обоймой в %d патронов игроку %s", PI[playerid][pNames], WeaponNames[params[1]], params[2], PI[params[0]][pNames]);
	SendAdminMessage(COLOR_GREY, string);
	return 1;
}
cmd:gotome(playerid, params[])
{
	if(GetPVarInt(playerid, "walk_goto_me_player"))
	{
	    walk_goto_me[GetPVarInt(playerid, "walk_goto_me_player") - 1]=0;
	    ClearAnimations(GetPVarInt(playerid, "walk_goto_me_player") - 1, true);
		DeletePVar(playerid, "walk_goto_me_player");
		SendClientMessage(playerid, -1, "Вы отключили ходьбу за игроком");
		return 1;
	}
	if(!IsACop(playerid) && !IsAArm(playerid) && !IsAMayor(playerid) && !IsAMedic(playerid) && PI[playerid][pMember] != 11 && PI[playerid][pMember] != 26) return 1;
    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_GREY, "/gotome [id игрока]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок оффлайн");
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вам необходимо начать рабочий день на базе организаций");
	if(IsPlayerInAnyVehicle(playerid) || IsPlayerInAnyVehicle(params[0])) return ErrorMessage(playerid, "Игрок должен находится на улице, и вы тоже");
	if(!ProxDetectorS(10.0, playerid, params[0])) return ErrorMessage(playerid, "Игрок не рядом с вами!");
	if(PI[params[0]][pJailTime] > 0) return ErrorMessage(playerid, "Игрок находится в тюрьме.");
	if(IsACop(params[0])) return ErrorMessage(playerid, "Игрок - полицейский.");

    SetPVarInt(playerid, "walk_goto_me_player", params[0] + 1);
    walk_goto_me[params[0]]=playerid+1;

    SendClientMessage(playerid, -1, ""#good"Вы повели игрока за собой!");
    SendEsp(playerid, "/gotome еще раз чтобы отключить ходьбу игрока за Вами!");

	MeAction(playerid, "взял(а) преступника за руку");
 	MeAction(playerid, "повёл(а) преступника за собой");
	return 1;
}
cmd:cput(playerid, params[])
{
	if(!IsACop(playerid) && !ISAMAFIA(playerid)) return 1;
	new ta4a = 0, res, bool:next=false, carr = GetVehicleModel(VehicleEnters[playerid]), giveplayerid;
	if (sscanf(params, "i", giveplayerid)) return SendClientMessage(playerid, COLOR_GREY, "Используйте: /cput [id игрока]");
	if(!IsPlayerConnected(giveplayerid)) return SendClientMessage(playerid, COLOR_GREY, "Игрок не найден");
	if ((carr != 441) || (carr != 446) || (carr != 448) || (carr != 449) || (carr != 452) || (carr != 450) || (carr != 453) || (carr != 454) || (carr != 460) || (carr != 461) || (carr != 462) || (carr != 463) || (carr != 464) || (carr != 465) || (carr != 468) ||
			(carr != 472) || (carr != 473) || (carr != 481) || (carr != 484) || (carr != 493) || (carr != 501) || (carr != 509) || (carr != 510) || (carr != 521) || (carr != 522) || (carr != 523) || (carr != 539) || (carr != 564) || (carr != 568) || (carr != 569) ||
			(carr != 570) || (carr != 571) || (carr != 584) || (carr != 586) || (carr != 595))
	{
		if(IsPlayerInAnyVehicle(giveplayerid)) return ErrorMessage(playerid, "Игрок находится в машине.");
		if((!GetPVarInt(giveplayerid, "PlayerCuffed")) && IsACop(playerid)) return ErrorMessage(playerid, "Игрок без наручников.");
		if(!ProxDetectorS(3.0, playerid, giveplayerid)) return ErrorMessage(playerid, "Вы слишком далеко от игрока!");
		for(new i = 1, j = GetVehiclePoolSize(); i <= j; i++)
		{
			new disto = CheckPlayerDistanceToVehicle(3.0, playerid, i);
			if (disto)
			{
				res = i;
				ta4a++;
				break;
			}
		}
		for (new i = 1; i < 3; i++)
		{
			if (!next)
			{
				if (!IsAnyPlayerInVehicle(res, i))
				{
					next = true;
					PutPlayerInVeh(giveplayerid, res, i);
					TogglePlayerControllable(giveplayerid, false);
					SendClientMessage(giveplayerid, COLOR_WHITE, "Вас насильно затолкали в тачку!");
					format(string, 90, "* %s затащил(а) в авто %s", PI[playerid][pNames], PI[giveplayerid][pNames]);
					ProxDetector(7.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
					break;
				}
			}
		}
		if(!next) return SendClientMessage(playerid, COLOR_WHITE, "В тачке нет свободных мест!");
	}
	else return SendClientMessage(playerid, COLOR_WHITE, "Недоступный транспорт!");
	return 1;
}
cmd:tie(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/tie [id]");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "Вы должны быть на водительском месте.");
    if(GetPlayerVehicleID(playerid) != GetPlayerVehicleID(params[0])) return SendClientMessage(playerid, COLOR_GREY,"Вы не в одном транспорта с этим игроком.");
	if(!ISAMAFIA(playerid)) return SendClientMessage(playerid, -1, " "#net"Вам недоступна данная команда.");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(PlayerTied{playerid} > false)  return ErrorMessage(playerid, "Вы связаны!");
	if(PlayerTied{params[0]} > false) return ErrorMessage(playerid, "Человек уже связан!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя связать самого себя!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Человек не рядом с вами!");
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && GetPlayerState(params[0]) == PLAYER_STATE_ONFOOT)
	{
		string = "";
		format(string, 126, "* %s достал веревку и завязал %s на узел.", PI[playerid][pNames], PI[params[0]][pNames]);
		ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
		TogglePlayerControllable(params[0], false);
		PlayerTied{params[0]} = true;
		return 1;
	}
	if(GetPlayerState(playerid)!=PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "Вы не водитель!");
	new car = VehicleEnters[playerid];
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) != 2 && !IsPlayerInVehicle(params[0], car)) return ErrorMessage(playerid, "Человек не в машине!");
	string = "";
	format(string, 126, "* %s достал веревку и завязал %s на узел.", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	TogglePlayerControllable(params[0], false);
	PlayerTied{params[0]} = true;
	return 1;
}
cmd:untie(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/untie [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Вы далеко от этого человека!");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "Вы должны быть на водительском месте.");
    if(GetPlayerVehicleID(playerid) != GetPlayerVehicleID(params[0])) return SendClientMessage(playerid, COLOR_GREY,"Вы не в одном транспорта с этим игроком.");
	if(PlayerTied{playerid} > false)  return ErrorMessage(playerid, "Вы связаны!");
	if(PlayerTied{params[0]} == false)  return ErrorMessage(playerid, "Игрок не связан!");
	if(params[0] == playerid)  return ErrorMessage(playerid, "Нельзя связывать себя!");
	if(!PlayerTied{params[0]}) return ErrorMessage(playerid, "Этот человек не связан!");
	string = "";
	format(string, SMALL_SIZE, "* %s развязал %s", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	TogglePlayerControllable(params[0], 1);
	PlayerTied{params[0]} = false;
	if(GetPVarInt(params[0], "gag") > 0)
	{
		DeletePVar(params[0], "gag");
		format(string, 90, "* %s вытащил кляп у %s'a", PI[playerid][pNames], PI[params[0]][pNames]);
		ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	}
	return 1;
}
cmd:givephone(playerid, params[])
{
	if(!ISAMAFIA(playerid)) return ErrorMessage(playerid, "Вы не член мафии!");
	if(PI[playerid][pRank] < 3)return ErrorMessage(playerid, "Вам недоступна эта функция!");
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/givephone [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Человек не рядом с вами!");
	if(PlayerTied{params[0]} == false)  return ErrorMessage(playerid, "Игрок не связан!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя вернуть телефон самому себе!");
	string = "";
	format(string, SMALL_SIZE, "%s вернул вам телефон", PI[playerid][pNames]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	DeletePVar(params[0], "takephone");
	format(string, 100, "* %s вернул телефон %s 'y", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	return 1;
}
cmd:takephone(playerid, params[])
{
	if(!ISAMAFIA(playerid)) return ErrorMessage(playerid, "Вам недоступна данная команда!");
	if(PI[playerid][pRank] < 3)return ErrorMessage(playerid, "Вы должны быть 3 рангом");
	if(sscanf(params, "d", params[0])) return ErrorMessage(playerid, "/takephone [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(GetPVarInt(params[0], "takephone") > 0) return ErrorMessage(playerid, "У него нет телефона");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Человек не рядом с вами!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя забрать телефон у самого себя!");
	string = "";
	format(string, SMALL_SIZE, "%s забрал у Вас мобильный", PI[playerid][pNames]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	SetPVarInt(params[0], "takephone", 1);
	format(string, 80, "* %s забрал мобильный у %s", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	return 1;
}
cmd:gag(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/gag [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "Вы должны быть на водительском месте.");
    if(GetPlayerVehicleID(playerid) != GetPlayerVehicleID(params[0])) return SendClientMessage(playerid, COLOR_GREY,"Вы не в одном транспорта с этим игроком.");
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя у самого себя вытащить кляп.");
	if(PlayerTied{params[0]} == false)  return ErrorMessage(playerid, "Игрок не связан!");
	if(PlayerTied{playerid} > false)  return ErrorMessage(playerid, "Вы связаны");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Человек не рядом с вами!");
	string = "";
	if(GetPVarInt(params[0], "gag") > 0)
	{
		DeletePVar(params[0], "gag");
		format(string, 90, "* %s вытащил кляп у %s'a", PI[playerid][pNames], PI[params[0]][pNames]);
		ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
		return 1;
	}
	else
	{
		if(!ISAMAFIA(playerid)) return SendClientMessage(playerid, COLOR_WHITE, " Вам недоступна данная команда.");
		SetPVarInt(params[0], "gag", 1);
		SetTimerEx("tieTime", 600, 0, "d", params[0]);
		format(string, 90, "* %s вставил кляп в рот %s'у", PI[playerid][pNames], PI[params[0]][pNames]);
		ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	}
	return 1;
}
cmd:gagoff(playerid)
{
	if(!GetPVarInt(playerid, "gag")) return ErrorMessage(playerid, "У Вас нету кляпа");
	if(PlayerTied{playerid} > false)  return ErrorMessage(playerid, "Вы связаны!");
	DeletePVar(playerid, "gag");
	string = "";
	format(string, 90, "* %s выплевывает кляп из рта.", PI[playerid][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	return 1;
}
cmd:hp(playerid)
{
	if(!GetAccessAdmin(playerid, 1))
		return true;
	if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "Вы должны быть за рулем транспорта!");
	if(IsPlayerInAnyVehicle(playerid))
	{
		RepairVehicle(VehicleEnters[playerid]);
		SetVehicleHealth(VehicleEnters[playerid], 1000.0);
		VehInfo[VehicleEnters[playerid]][vFuel] = 200.0;
		SendClientMessage(playerid, COLOR_WHITE, "Машина отремонтирована!");
	}
	SetPlayerHealth(playerid, 100.0);
	return 1;
}
cmd:aremcar(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 10))
		return true;
	if(sscanf(params, "d", params[0])) return SCM(playerid, COLOR_WHITE, ""#information"/aremcar [ид]");
	if(IsPlayerInAnyVehicle(params[0]))
	{
		RepairVehicle(VehicleEnters[params[0]]);
		SetVehicleHealth(VehicleEnters[params[0]], 1000.0);
		VehInfo[VehicleEnters[params[0]]][vFuel] = 200.0;
		SendClientMessage(params[0], COLOR_WHITE, "Ваш автомобиль был отремонтирован администратором!");
	}
	SCM(playerid, COLOR_WHITE, "Вы успешно отремонтировали автомобиль игроку!");
	return 1;
}
cmd:usekey(playerid)
{
	if(!IsAGang(playerid)) return 1;
	if(PI[playerid][pJailTime]<=0) return SendClientMessage(playerid, COLOR_GRAD1, "Вы не в тюрьме!");
	if(GetPVarInt(playerid, "Keys")<=0) return SendClientMessage(playerid, COLOR_GRAD1, "У Вас нет ключа от тюрьмы!");
	SetPVarInt(playerid, "Keys", GetPVarInt(playerid, "Keys")-1);
	PI[playerid][pPrisonTime] = 0;
	PI[playerid][pJailTime] = 0;
	PI[playerid][pWanted] = 0;
	string = "";
	mysql_format(1, string, 155, "UPDATE `accounts` SET `pJailTime` = '0', `pPrisonTime` = '0', `pWanted` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
	mysql_tquery(1, string);
	SetPlayerInterior(playerid, 0);
	SetPlayerPos(playerid, 1553.4962, -1675.2714, 16.1953);
	SetPlayerFacingAngle(playerid, 95.0636);
	SendClientMessage(playerid, COLOR_SERVER, "::: Вы совершили побег из тюрьмы");
	return 1;
}
cmd:keys(playerid)
{
	if(!IsAGang(playerid)) return 1;
	if(GetPVarInt(playerid, "Keys")<=0) return SendClientMessage(playerid, COLOR_GRAD1, "У Вас нет ключей от тюрьмы!");
	string = "";
	format(string, 30, "У Вас %d ключей", GetPVarInt(playerid, "Keys"));
	SendClientMessage(playerid, COLOR_SERVER, string);
	format(string, 30, "* %s достаёт ключи", PI[playerid][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	return 1;
}
cmd:showskill(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendEsp(playerid, "/showskill [ID]");
	if(!ProxDetectorS(1.5, playerid, params[0])) return SendClientMessage(playerid, COLOR_GRAD1, "Вы слишком далеко от игрока.");
	if(GetPVarInt(params[0], "Spectate")) return ErrorMessage(playerid, "Вы слишком далеко от игрока!");
	string = "";
	format(string, 260, ""WHITE"SDPistol:\t\t%d процентов.\nDesertEagle:\t\t%d процентов.\nShotGun:\t\t%d процентов.\nMP5:\t\t\t%d процентов.\nAK47:\t\t\t%d процентов.\nM4:\t\t\t%d процентов.",
	PI[playerid][pSkills][0], PI[playerid][pSkills][1], PI[playerid][pSkills][2], PI[playerid][pSkills][3], PI[playerid][pSkills][4], PI[playerid][pSkills][5]);
	ShowPlayerDialog(params[0], 0000, DIALOG_STYLE_MSGBOX, ""SERVER"Skill", string, "Принять", "");
	return 1;
}
cmd:givecopkeys(playerid, params[])
{
	if(PI[playerid][pMember] != 1 && PI[playerid][pMember] != 2 && PI[playerid][pMember] != 10 && PI[playerid][pMember] != 21) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return 	SendClientMessage(playerid, COLOR_WHITE, ""#information"/givecopkeys [ид]");
	if(!ProxDetectorS(1.5, playerid, params[0])) return SendClientMessage(playerid, COLOR_GRAD1, "Вы слишком далеко от игрока.");
	if(!IsPlayerConnected(params[0])) return 1;
	SetPVarInt(params[0], "Keys", GetPVarInt(params[0], "Keys")+1);
	string = "";
	format(string, 126, "* Офицер %s выдал ключи от полицейского участка %s", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	return 1;
}
cmd:heal(playerid, params[])
{
    if (MyBed [playerid] == 255)
    {
		for (new j = 0; j < sizeof(BedInfo); j++) if (IsPlayerInRangeOfPoint (playerid, 2.0, BedInfo [j][b_X], BedInfo [j][b_Y], BedInfo[j][b_Z]))
		{
			if (BedInfo [j][Busy] == true)
			{
				SendClientMessage( playerid, -1, ""#net"Койка уже кем то занята." );
				break;
			}
			MyBed[ playerid ] = j;
			format (string, 200, "{FFFFFF}Вы действительно хотите арендовать данную койку за "SERVER"$%d", BedPrice);
			ShowPlayerDialog (playerid, BED_DIALOG, DIALOG_STYLE_MSGBOX, ""SERVER"Койка", string, "Да", "Нет" );
			break;
		}
	}
	if(!IsAMedic(playerid)) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/heal [id]");
	if(!ProxDetectorS(1.5, playerid, params[0])) return ErrorMessage(playerid, "Вы слишком далеко от игрока.");
	if(params[0] == INVALID_PLAYER_ID) return 1;
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы не можете вылечить себя!");
	new vehicleid = VehicleEnters[playerid];
	if(!vehicleid && !pTemp[playerid][pInHospital]) return ErrorMessage(playerid, "Вы должны быть в карете скорой помощи либо в больнице");
	string = "";
	format(string, 126, ""WHITE"Вы предложили вылечить %s за %d вирт.", PI[params[0]][pNames], healpric);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, 64, ""WHITE"Желаете вылечиться за %d вирт?", healpric);
	ShowPlayerDialog(params[0], 5522, DIALOG_STYLE_MSGBOX, ""SERVER"Лечение", string, "Да", "Нет");
	SetPVarInt(params[0], "HealOffer", playerid);
	SetPVarInt(params[0], "HealPrice", healpric);
	return 1;
}
cmd:sethp(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 4))
		return true;
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/sethp [id] [уровень hp]");
	if((params[1] < 0 || params[1] > 160) && !FULL_1 && !FULL_2 && !FULL_3 && !FULL_4 && !FULL_5 && !FULL_6) return 1;
	if(!IsPlayerConnected(params[0])) return 1;
	SetPlayerHealth(params[0], params[1]);
	SendClientMessage(playerid, COLOR_WHITE, "Уровень здоровья игроку установлен.");
	format(string, MAX_STR, "Администратор %s(%d) изменил уровень здоровья игроку %s(%d) на %d процент(а/ов)", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0], params[1]);
	SendAdminMessage(COLOR_GREY, string);
	return 1;
}
cmd:veh(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 7))
		return true;
	new playerID, modelID;
	//if(gAdminReason[playerid][ADMIN_VEH]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "dd", playerID, modelID))
	{
		playerID = playerid;
		modelID = 411;
		SendClientMessage(playerid, COLOR_GREY, "Если вы хотите создать авто на выбор, используйте /veh [id] [id машины].");
	}
	if(modelID < 400 || modelID > 611) return SendClientMessage(playerid, -1, "Номер машины не может быть меньше 400 и больше чем 611!");
	if(modelID == 538 || modelID == 449 || modelID == 570) return 1;
    if(GetPlayerState(playerID) != 1) return SendClientMessage(playerid, COLOR_GREY, "Игрок в машине!");
	new Float:mesto[4];
	GetPlayerPos(playerID, mesto[0], mesto[1], mesto[2]);
	GetPlayerFacingAngle(playerID, mesto[3]);
	if(PI[playerID][plveh] != -1) DestroyVehicle(PI[playerID][plveh]);
	PI[playerID][plveh] = Forveh_AddStaticVehicle(modelID, mesto[0], mesto[1], mesto[2], mesto[3], -1, -1);
	SetVehicleVirtualWorld(PI[playerID][plveh], GetPlayerVirtualWorld(playerid));
	PutPlayerInVehicle(playerID, PI[playerID][plveh], 0);
	format(string, 144, "Администратор %s(%d) создал автомобиль марки %s. Номер автомобиля: %i.", PI[playerid][pNames], playerid, VehicleNames[modelID-400], modelID);
	SendAdminMessage(COLOR_GREY, string);
	return 1;
}
cmd:spawnbike(playerid)
{
	if(!PI[playerid][pDRInections]) return ErrorMessage(playerid, "Данная команда доступна только владельцам Brilliant VIP.");
	if(GetPlayerState(playerid) != 1) return SendClientMessage(playerid, COLOR_GREY, "Вы в данный момент в машине!");
	new Float:mesto[4];
	GetPlayerPos(playerid, mesto[0], mesto[1], mesto[2]);
	GetPlayerFacingAngle(playerid, mesto[3]);
	if(PI[playerid][plveh] != -1) DestroyVehicle(PI[playerid][plveh]);
	PI[playerid][plveh] = CreateVehicle(522, mesto[0], mesto[1], mesto[2], mesto[3], -1, -1, -1);
	PutPlayerInVehicle(playerid, PI[playerid][plveh], 0);
	return 1;
}
cmd:doublehand(playerid)
{
	if(!PI[playerid][pDRInections]) return ErrorMessage(playerid, "Данная команда доступна только владельцам Brilliant VIP.");
	if(!GetPVarInt(playerid, "dhEnabled"))
	{
		SetPlayerSkillLevel(playerid, WEAPONSKILL_M4, 999);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_SPAS12_SHOTGUN, 999);
    	SetPlayerSkillLevel(playerid, WEAPONSKILL_MICRO_UZI, 999);
    	SetPVarInt(playerid, "dhEnabled", 1);
    	SendClientMessage(playerid, COLOR_LIGHTGREEN, "Режим стрельбы двумя руками активирован!");
	}
	else
	{
		SetPlayerSkillLevel(playerid, WEAPONSKILL_M4, 0);
		SetPlayerSkillLevel(playerid, WEAPONSKILL_SPAS12_SHOTGUN, 0);
    	SetPlayerSkillLevel(playerid, WEAPONSKILL_MICRO_UZI, 0);
    	SetPVarInt(playerid, "dhEnabled", 0);
    	SendClientMessage(playerid, COLOR_LIGHTRED, "Режим стрельбы двумя руками выключен!");
	}
	return 1;
}
cmd:giveprem(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	if(sscanf(params, "ddd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/giveprem [ид] [количество дней]");
	if(!IsPlayerConnected(params[0])) return 1;
	if(!params[1])
	{
		PI[params[0]][pDRInections] = 0;
		UpdatePlayerData(params[0], "pDRInections", 0);
		SendClientMessage(playerid, COLOR_WHITE, "- Вы забрали у игрока Brilliant VIP.");
	}
	else
	{
		SetPremium(params[0], params[1]);
		SendClientMessage(playerid, COLOR_WHITE, "- Вы выдали игроку Brilliant VIP.");
	}

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s использовал команду /giveprem на %s", PI[playerid][pNames], PI[params[0]][pNames]);
	logs(1, log_str, 0);

	return 1;
}

cmd:leave(playerid)
{
	if(!PI[playerid][pResh] && !PI[playerid][pDRInections]) return ErrorMessage(playerid, "Для использования необходимо улучшение решительности, либо Brilliant VIP.");
	if(!PI[playerid][pMember]) return ErrorMessage(playerid, "Вы не состоите в организации");
	if(PI[playerid][pLeader]) return ErrorMessage(playerid, "Лидер не может уволится по С/Ж.");
	if(StartRabWork(playerid))
	{
		SendClientMessage(playerid, COLOR_BLUE, "Ваш рабочий день завершен!");
		SetPVarInt(playerid, "StartRabWork", 0);
	}
	format(string, 300, ""WHITE"Вы состоите в организации ''%s''.\nВы хотите покинуть ее по собственному желанию.\nПри этом, все Ваши достижения останутся позади.\n\nВы уверены что хотите уволится из организации?",
	GetMember[PI[playerid][pMember]-1]);
	ShowPlayerDialog(playerid, 9191, DIALOG_STYLE_MSGBOX, ""SERVER"Предупреждение", string, "Да", "Нет");
	return 1;
}
alias:licenses("mylic");
cmd:licenses(playerid)
{
	SCMF(playerid, 0xC0E1EEFF, "Водительские права: %s", (PI[playerid][pLicenses][0] ? ("Есть") : ("Отсутствует")));
	SCMF(playerid, 0xC0E1EEFF, "Лицензия пилоты: %s", (PI[playerid][pLicenses][1] ? ("Есть") : ("Отсутствует")));
	SCMF(playerid, 0xC0E1EEFF, "Лицензия на катера: %s", (PI[playerid][pLicenses][2] ? ("Есть") : ("Отсутствует")));
	SCMF(playerid, 0xC0E1EEFF, "Лицензия на оружие: %s", (PI[playerid][pLicenses][3] ? ("Есть") : ("Отсутствует")));
	MeAction(playerid, "смотрит свои лицензии");
	return 1;
}
alias:showlicenses("sl");
cmd:showlicenses(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/showlicenses [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Человек не рядом с вами!");
	if(GetPVarInt(params[0], "Spectate")) return ErrorMessage(playerid, "Вы слишком далеко от игрока!");
	SendClientMessage(params[0], 0x0AA8DAFF, "-------======[ LICENSES ]======-------");
	SCMF(params[0], 0xC0E1EEFF, "Водительские права: %s", (PI[playerid][pLicenses][0] ? ("Есть") : ("Отсутствует")));
	SCMF(params[0], 0xC0E1EEFF, "Лицензия пилоты: %s", (PI[playerid][pLicenses][1] ? ("Есть") : ("Отсутствует")));
	SCMF(params[0], 0xC0E1EEFF, "Лицензия на катера: %s", (PI[playerid][pLicenses][2] ? ("Есть") : ("Отсутствует")));
	SCMF(params[0], 0xC0E1EEFF, "Лицензия на оружие: %s", (PI[playerid][pLicenses][3] ? ("Есть") : ("Отсутствует")));
	SendClientMessage(params[0], 0x0AA8DAFF, "===============================");
	format(string, 64, "* %s показал(-а) свои лицензии %s'у", PI[playerid][pNames], PI[params[0]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	format(string, 64, "показал(-а) свои лицензии %s'у", PI[params[0]][pNames]);
	SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 30.0, 10000);
	return 1;
}
cmd:divorce(playerid, params[])
{
	if(PI[playerid][pMarried] < 1) return ErrorMessage(playerid, "Вы не женаты (замужем)!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/divorce [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(strcmp(PI[playerid][pNames], PI[params[0]][pFamilyName], true) != 0) return ErrorMessage(playerid, "Он(а) не является Вашем Мужем / Женой.");
	if(PI[params[0]][pMarried] < 1) return ErrorMessage(playerid, "Человек не состоит в браке!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Человек не рядом с вами!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
	SendClientMessage(playerid, COLOR_GREY, "Вы развелись, ваш(а) супруг(а) должна сделать тоже самое");
	strmid(PI[playerid][pFamilyName], ("None"), 0, strlen("None"), 255);
	strmid(PI[params[0]][pFamilyName], ("None"), 0, strlen("None"), 255);
	UpdatePlayerDataEx(playerid, "pFamilyName", "None"); UpdatePlayerDataEx(params[0], "pFamilyName", "None");
	SCMF(params[0], -1, "%s[%d] подал заявление на развод, развод совершен!", PI[playerid][pNames], playerid);
	SCMF(playerid, -1, "Вы успешно расторгли брак с %s[%d]", PI[params[0]][pNames], params[0]);
	PI[params[0]][pMarried] = 0;
	PI[playerid][pMarried] = 0;
	UpdatePlayerData(params[0], "pMarried", 0);
	UpdatePlayerData(playerid, "pMarried", 0);
	return 1;
}
cmd:offdivorce(playerid)
{
	if(PI[playerid][pMarried] < 1) return ErrorMessage(playerid, "Вы не женаты (замужем)!");
	if(!strcmp(PI[playerid][pFamilyName], "None", true)) return ErrorMessage(playerid, "Вы не женаты (замужем)!");
	SendClientMessage(playerid, COLOR_GREY, "Вы развелись, ваш(а) супруг(а) должна сделать тоже самое");
	SCMF(playerid, -1, "Вы успешно расторгли брак с %s[%d]", PI[playerid][pFamilyName]);
	strmid(PI[playerid][pFamilyName], ("None"), 0, strlen("None"), 255);
	UpdatePlayerDataEx(playerid, "pFamilyName", "None");
	PI[playerid][pMarried] = 0;
	UpdatePlayerData(playerid, "pMarried", 0);
	return 1;
}
cmd:propose(playerid, params[])
{
	if(PI[playerid][pCash] < 100000) return ErrorMessage(playerid, "Вам нужно 100.000$ на свадьбу!");
	if(PI[playerid][pMarried] > 0) return ErrorMessage(playerid, "Вы уже женаты/замужем!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/propose [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if(PI[params[0]][pMarried] > 0) return ErrorMessage(playerid, "Человек уже состоит в браке!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Человек не рядом с вами!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
	format(string, 64, "Вы предложили руку и сердце %s.", PI[params[0]][pNames]);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, 126, "%s предлагает вам руку и сердце. (( Введите: /accept marriage, чтобы принять )).", PI[playerid][pNames]);
	SendClientMessage(params[0], COLOR_BLUE, string);
	SetPVarInt(params[0], "ProposeOffer", playerid);
	return 1;
}
cmd:witness(playerid, params[])
{
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/witness [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Человек не найден!");
	if (!ProxDetectorS(8.0, playerid, params[0])) return ErrorMessage(playerid, "Человек не рядом с вами!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
	format(string, 126, "Вы преложили %s быть свидетелем на вашей свадьбе.", PI[params[0]][pNames]);
	SendClientMessage(playerid, COLOR_BLUE, string);
	format(string, 126, "%s предлагает Вам быть свидетелем на его/её свадьбе.(( Введите /accept witness, чтобы принять )).", PI[playerid][pNames]);
	SendClientMessage(params[0], COLOR_BLUE, string);
	SetPVarInt(params[0], "MarryWitnessOffer", playerid);
	return 1;
}
cmd:ram(playerid)
{
	if(!IsACop(playerid) && !IsAArm(playerid) && !GetAccessAdmin(playerid, 1))
		return true;
	if(StartRabWork(playerid) && !GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	for(new i = 0; i < TOTAL_HOUSE; i++)
	{
		if (!PlayerToPoint(3, playerid, HouseInfo[i][hEnter][0], HouseInfo[i][hEnter][1], HouseInfo[i][hEnter][2])) continue;
		SetPVarInt(playerid, "HouseID", i);
		SetPlayerVirtualWorld(playerid, i+50);
		SetPlayerInterior(playerid, HouseInfo[i][hInt]);
		SetPlayerPos(playerid, HouseInfo[i][hExit][0], HouseInfo[i][hExit][1], HouseInfo[i][hExit][2]);
	}
	return 1;
}
cmd:take(playerid)
{
	if(PlayerTied{playerid} > false)  return ErrorMessage(playerid, "Вы связаны!");
	if(!IsACop(playerid) && PI[playerid][pMember] != 11) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	ShowPlayerDialog(playerid, 7779, DIALOG_STYLE_LIST, ""SERVER"Отобрать лицензии:", ""WHITE"- Отобрать водительские права\n- Отобрать лицензию на полёты \n- Отобрать лицензию на вождение водного транспорта\n- Отобрать лицензия на оружие\n- Наркотики\n- Оружие\n- Материалы", "Отобрать", "Отмена");
	return 1;
}
cmd:spawnchange(playerid)
{
	if(GetPVarInt(playerid, "pSpawnFlood") > unix) return ErrorMessage(playerid, "Использовать эту команду можно раз в 5 секунд.");
	PI[playerid][pSpawn] = (!PI[playerid][pSpawn] ? (1) : (0));
	UpdatePlayerData(playerid, "pSpawn", PI[playerid][pSpawn]);
	if(PI[playerid][pMember] == 11) SendClientMessage(playerid, COLOR_GREY, "Теперь вы будуте возраждаться в автошколе!");
	else SCMF(playerid, COLOR_GREY, "Теперь вы будете возраждаться %s", (!PI[playerid][pSpawn] ? ("в обычном месте") : ("дома")));
	SetPVarInt(playerid, "pSpawnFlood", unix+5);
	return 1;
}
cmd:home(playerid)
{
	if(PI[playerid][pHouse] == -1) return 1;
	SetPlayerGPS(playerid, HouseInfo[PI[playerid][pHouse]][hEnter][0], HouseInfo[PI[playerid][pHouse]][hEnter][1], HouseInfo[PI[playerid][pHouse]][hEnter][2], "Ваш дом обозначен на карте");
	SendClientMessage(playerid, COLOR_WHITE, "Ваш дом обозначен на карте красной меткой");
	SetPVarInt(playerid, "playerisGPS", 1);
	DeletePVar(playerid, "gps_pic");
	return 1;
}
