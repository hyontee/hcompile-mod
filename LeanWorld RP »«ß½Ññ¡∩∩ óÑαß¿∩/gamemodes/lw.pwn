		    SellingCar[i][sColor1] = cache_get_field_content_int(i, "sColor1");
		    SellingCar[i][sColor2] = cache_get_field_content_int(i, "sColor2");
		    SellingCar[i][sProbeg] = cache_get_field_content_float(i, "sProbeg");
		    SellingCar[i][sFueling] = cache_get_field_content_float(i, "sFueling");
		    cache_get_field_content(i, "sName", SellingCar[i][sName], 1, 24);
		    SellingCar[i][sMoney] = cache_get_field_content_int(i, "sMoney");
		    SellingCar[i][sCarID] = cache_get_field_content_int(i, "sCarID");
		    SellingCar[i][sellCarStatus] = bool:cache_get_field_content_int(i, "sellCarStatus");

			if(strcmp(SellingCar[i][sName], "None", true) != 0)
			{
				format(string, 300, ""SERVER"Место занято!\n"WHITE"Транспорт: "SERVER"%s\n"WHITE"Цена: "SERVER"%i$\n"WHITE"Продавец: "SERVER"%s", VehicleNames[SellingCar[i][sCarID]-400], SellingCar[i][sMoney], SellingCar[i][sName]);
	            SellingCar[i][sellVehicle] = CreateVehicle(SellingCar[i][sCarID], CoordSellCars[i][0], CoordSellCars[i][1], CoordSellCars[i][2], CoordSellCars[i][3], SellingCar[i][sColor1], SellingCar[i][sColor2], 10000);
	           	VehInfo[SellingCar[i][sellVehicle]-1][vDrived] = SellingCar[i][sProbeg];
				VehInfo[SellingCar[i][sellVehicle]][vFuel] = SellingCar[i][sFueling];
			}
			else format(string, 128, ""WHITE"Чтобы выставить автомобиль на продажу\nвведите: "SERVER"/autoyar");

			SellingCar[i][sText] = Create3DTextLabel(string, -1, CoordSellCars[i][0], CoordSellCars[i][1], CoordSellCars[i][2], 15.0, 0, 1);
		}
		printf("-> Автоярмарка загружена <%i шт авто.>", rows);
	}
	else print("-> Автоярмарка не загружена");
    cache_delete(cache);

	cache = mysql_query(1, "SELECT * FROM `vote`"), rows = cache_num_rows();
	if(rows)
	{
		CreateObject ( 19370, 511.162567, -1553.589721, 15.299374, -0.599999, -83.699966, 24.300001 ) ;
		for(new i; i < rows; i ++)
		{
			cache_get_field_content(i, "vote_name", vote_name[i], 1, 24);
			vote_count[i] = cache_get_field_content_int(i, "vote_count");
		}
		print("-> Выборы загружены успешно");
	}
	else print("-> Выборы не загружены");
	cache_delete(cache);

	cache = mysql_query(1, "SELECT * FROM `lw_ghetto`"), rows = cache_num_rows(), time = GetTickCount();
	if(cache_is_valid(cache) && rows)
	{
		b_Ghetto{0} = bool:cache_get_field_content_int(0, "lw_grove");
		b_Ghetto{1} = bool:cache_get_field_content_int(0, "lw_aztec");
		b_Ghetto{2} = bool:cache_get_field_content_int(0, "lw_ballas");
		b_Ghetto{3} = bool:cache_get_field_content_int(0, "lw_rifa");
		b_Ghetto{4} = bool:cache_get_field_content_int(0, "lw_vagos");
  		printf("-> Блокировка каптов успешно загружена. (%d ms)", GetTickCount() - time);
	}
	else
		print("-> Блокировка каптов не загружена");
	cache_delete(cache);


	cache = mysql_query(1, "SELECT `lw_amount`, `lw_status` FROM `lw_unitpay_payments`"), rows = cache_num_rows(), time = GetTickCount();
	if(cache_is_valid(cache))
	{
		if(rows)
		{
			new pay_check,
				pay_total,
				pay_dont_total,
				pay_dont_check;

			for(new i; i < rows; i ++)
			{
				if(cache_get_field_content_int(i, "lw_status"))
				{
					pay_total ++;
					pay_check += cache_get_field_content_int(i, "lw_amount");
				}
				else
					pay_dont_total ++,
					pay_dont_check += cache_get_field_content_int(i, "lw_amount");
			}
			printf("-> Заработок: %i рублей | Заработок при успешных транзакциях: %i рублей | Всего: %i рублей. (%d ms)", pay_check, pay_dont_check, (pay_check + pay_dont_check), GetTickCount() - time);
			printf("-> Успешные транзакции: %i | Неудачные транзакции: %i | Всего: %i. (%d ms)", pay_total, pay_dont_total, (pay_total + pay_dont_total), GetTickCount() - time);
			if(pay_check && pay_total && pay_dont_check && pay_dont_total) printf("-> Процент успешных заработков за все время: %i процентов | Неудачно: %i процентов. (%d ms)", (pay_check / pay_total), (pay_dont_check / pay_dont_total), GetTickCount() - time);
			printf("-> Процент спроса на рубли: %i процентов. (%d ms)\n", (pay_total * 100) / (pay_total + pay_dont_total), GetTickCount() - time);
		}
		else printf("-> 0 транзакций было совершено. (%d ms)\n", GetTickCount() - time);
	}
	else
	print("-> Статистика доната не загружается!\n");
    cache_delete(cache);

    for(new v = 1, j = GetVehiclePoolSize(); v <= j; v++)
	{
		RentCar[v] = -1;
		SetVehicleNumberPlate(v, "« LW-RP »");
	}
	printf("-> Динамических объектов: %d", CountDynamicObjects());
	printf("-> Видимых объектов (streamer): %d", Streamer_GetVisibleItems(STREAMER_TYPE_OBJECT));
	return 1;
}
GetClosestPlayer(p1)
{
	new Float:dis = 99999.99, Float:dis2, player = INVALID_PLAYER_ID;
	foreach(Player, x)
	{
		if(x != p1)
		{
			dis2 = GetDistanceBetweenPlayers(x, p1);
			if(dis2 < dis && dis2 != -1.00) dis = dis2, player = x;
		}
	}
	return player;
}
SalaryMafia()
{
	for(new h = 1; h <= BIZES; h++) BuyingBusiness[h-1] = 0;
	frac_money[12] += frac_gangzone[12]*25;
	frac_money[13] += frac_gangzone[13]*25;
	frac_money[15] += frac_gangzone[15]*25;
	frac_money[17] += frac_gangzone[17]*25;
	frac_money[18] += frac_gangzone[18]*25;
	new
		asd = MafiaJober[5][0]+MafiaJober[5][1]+MafiaJober[5][2]+MafiaJober[5][3]+MafiaJober[5][4],
		asd1 = MafiaJober[6][0]+MafiaJober[6][1]+MafiaJober[6][2]+MafiaJober[6][3]+MafiaJober[6][4],
		asd2 = MafiaJober[14][0]+MafiaJober[14][1]+MafiaJober[14][2]+MafiaJober[14][3]+MafiaJober[14][4]
	;
	for(new i; i != 5; i++)
	{
		if(MafiaJober[5][i] > 0 && frac_money[5] > asd*10000) MafiaNarko[5][i] += MafiaJober[5][i]*2;
		else
		{
			SendFractionMessage(5, COLOR_SERVER, "На банк. счету мафии не хватает денег на зарплату рабочим!");
			SendFractionMessage(5, COLOR_SERVER, "Рабочие отказались работать [+0 ящ]");
			return 1;
		}
		if(MafiaJober[6][i] > 0 && frac_money[6] > asd1*10000) MafiaNarko[6][i] += MafiaJober[6][i]*2;
		else
		{
			SendFractionMessage(6, COLOR_SERVER, "На банк. счету мафии не хватает денег на зарплату рабочим!");
			SendFractionMessage(6, COLOR_SERVER, "Рабочие отказались работать [+0 ящ]");
			return 1;
		}
		if(MafiaJober[14][i] > 0 && frac_money[14] > asd2*10000) MafiaNarko[14][i] += MafiaJober[14][i]*2;
		else
		{
			SendFractionMessage(14, COLOR_SERVER, "На банк. счету мафии не хватает денег на зарплату рабочим!");
			SendFractionMessage(14, COLOR_SERVER, "Рабочие отказались работать [+0 ящ]");
			return 1;
		}
	}
	frac_money[5] -= asd*10000, frac_money[6] -= asd1*10000, frac_money[14] -= asd2*10000;
	UpdateFractionStore(5), UpdateFractionStore(6), UpdateFractionStore(14);
	UpdateFractionStore(12), UpdateFractionStore(13), UpdateFractionStore(15), UpdateFractionStore(17), UpdateFractionStore(18);
	UpdateStoreGang(12); UpdateStoreGang(13); UpdateStoreGang(15); UpdateStoreGang(17); UpdateStoreGang(18);
	return 1;
}
PayDay()
{
	if(StartGrab != 0) StartGrab--;
	for(new i; i < sizeof(MafiaCapture); i ++) if(MafiaCapture[i]) MafiaCapture[i]--;
	new player_plats, year, month, day;
    getdate(year, month, day);
	foreach(Player, i)
	{
		if(!PI[i][pLogin] || !IsPlayerConnected(i)) continue;

        if(tmphour == 24 && tmpminute == 00) pTemp[i][admPlayOnline] = 0;
		if(tmphour == 24 && tmpminute == 00) PI[i][playOnline] = 0;

		if(PI[i][pWanted])
		{
			PI[i][pWanted] --; SetPlayerWantedLevel(i, PI[i][pWanted]);
			UpdatePlayerData(i, "pWanted", PI[i][pWanted]);
		}

  		new salary = 0;
		switch(PI[i][pMember])
		{
		    case 0: salary = Gos_Nalog[0] + 35;
      		case 1: salary = (PI[i][pRank] > 1) ? (10100 + (3050 * (PI[i][pRank]-1))) : (10100);
      		case 2: salary = (PI[i][pRank] > 1) ? (10700 + (6000 * (PI[i][pRank]-1))) : (10700);
      		case 3: salary = (PI[i][pRank] > 1) ? (9000 + (2050 * (PI[i][pRank]-1))) : (9000);
      		case 4: salary = (PI[i][pRank] > 1) ? (4000 + (4000 * (PI[i][pRank]-1))) : (4000);
      		case 5: salary = (/*frac_gangzone[PI[i][pMember]]*/60*(random(51)+50));
      		case 6: salary = (/*frac_gangzone[PI[i][pMember]]*/60*(random(51)+50));
      		case 7: salary = (PI[i][pRank] > 1) ? (1500 + (460 * (PI[i][pRank]-1))) : (1500);
      		case 8: salary = (PI[i][pRank] > 1) ? (1500 + (460 * (PI[i][pRank]-1))) : (1500);
      		case 9: salary = (PI[i][pRank] > 1) ? (1500 + (460 * (PI[i][pRank]-1))) : (1500);
      		case 10: salary = (PI[i][pRank] > 1) ? (1100 + (260 * (PI[i][pRank]-1))) : (1100);
      		case 11: salary = (PI[i][pRank] > 1) ? (700 + (200 * (PI[i][pRank]-1))) : (700);
			case 12: salary = (frac_gangzone[PI[i][pMember]]*60);
			case 13: salary = (frac_gangzone[PI[i][pMember]]*60);
			case 14: salary = (/*frac_gangzone[PI[i][pMember]]*/60*(random(51)+50));
			case 15: salary = (frac_gangzone[PI[i][pMember]]*60);
			case 16: salary = (PI[i][pRank] > 1) ? (1500 + (460 * (PI[i][pRank]-1))) : (5000);
			case 17: salary = (frac_gangzone[PI[i][pMember]]*60);
			case 18: salary = (frac_gangzone[PI[i][pMember]]*60);
			case 19: salary = (PI[i][pRank] > 1) ? (900 + (250 * (PI[i][pRank]-1))) : (900);
			case 20: salary = (PI[i][pRank] > 1) ? (400 + (400 * (PI[i][pRank]-1))) : (400);
			case 21: salary = (PI[i][pRank] > 1) ? (1100 + (260 * (PI[i][pRank]-1))) : (1100);
			case 22: salary = (PI[i][pRank] > 1) ? (400 + (400 * (PI[i][pRank]-1))) : (400);
			case 23: salary = (PI[i][pRank] > 1) ? (50 + (25 * (PI[i][pRank]-1))) : (50);
			case 24: salary = (PI[i][pRank] > 1) ? (500 + (200 * (PI[i][pRank]-1))) : (500);
			case 25: salary = (PI[i][pRank] > 1) ? (1400 + (500 * (PI[i][pRank]-1))) : (1400);
			case 26: salary = (PI[i][pRank] > 1) ? (2000 + (600 * (PI[i][pRank]-1))) : (2000);
		}

		PI[i][pPayDayHad] ++;
		UpdatePlayerData(i, "pPayDayHad", PI[i][pPayDayHad]);

		PI[i][pPayDayMember] ++;
		UpdatePlayerData(i, "pPayDayMember", PI[i][pPayDayMember]);

		PI[i][pExp] += (PI[i][pDRInections] || PayDayBonus[0] ? (2) : (1));

		if(PI[i][pDRInections]) PI[i][pExp] += (PI[i][pDRInections] || PayDayBonus[0] ? (2) : (1));
		UpdatePlayerData(i, "pExp", PI[i][pExp]);

		if(PI[i][pDRInections]) GameTextForPlayer(i, "PayDay", 5000, 1);
		else GameTextForPlayer(i, "~w~PayDay", 5000, 1);

		SendClientMessage(i, CWHITE, "==========[{"#cGRAY"}Банковский чек"WHITE"]=========");

		SCMF(i, COLOR_WHITE, " Государственный налог: {"#cGREEN"}%i$", Gos_Nalog[0]);

		SCMF(i, COLOR_WHITE, " Зарплата: {"#cGREEN"}%i$", (salary != 0)?(salary):(25));

		if(PI[i][pPayCheck]) SCMF(i, COLOR_WHITE, " Плата за аррест преступников: {"#cGREEN"}%i$", PI[i][pPayCheck]), salary = (salary + PI[i][pPayCheck]);

		SCMF(i, COLOR_WHITE, " Зарплата с учетом налога: {"#cGREEN"}%i$", salary-Gos_Nalog[0]);

		PI[i][pBank] += salary-Gos_Nalog[0];
		Gos_Nalog[1] += (Gos_Nalog[1] < 800000000 ? (Gos_Nalog[0]*player_plats) : (0));

		SCMF(i, COLOR_WHITE, " Текущий баланс: {"#cGREEN"}%d$", PI[i][pBank]);


		PI[i][pZakonp] += 1;
		if(PI[i][pZakonp] > 100) PI[i][pZakonp] = 100;
		UpdatePlayerData(i, "pZakonp", PI[i][pZakonp]);

		if(PI[i][pExp] >= ((PI[i][pLevel]+2)*2))
		{
			PI[i][pLevel] ++;
			UpdatePlayerData(i, "pLevel", PI[i][pLevel]);
			SetPlayerScore(i, PI[i][pLevel]);
			PI[i][pAge] ++;
			UpdatePlayerData(i, "age", PI[i][pAge]);
			PI[i][pExp] = 0;
			UpdatePlayerData(i, "pExp", 0);
			SendClientMessage(i, COLOR_SERVER, " ");
			SendClientMessage(i, COLOR_SERVER, "Ваш игровой уровень и возраст повысился");
			SendClientMessage(i, COLOR_SERVER, "Теперь Вы можете повысить администратору репутацию!");
			PI[i][pGiveAdmRep] = 0;
			UpdatePlayerData(i, "pGiveAdmRep", 0);
		}

		if(PayDayBonus[1])
		{
			PI[i][pDonate] += 500;

			UpdatePlayerData(i, "pDonate", PI[i][pDonate]);

			SendClientMessage(i, COLOR_WHITE, "Вы получили "SERVER"500"WHITE" бонусных донат монет");
		}

		SendClientMessage(i, CWHITE, "==================================");
		PI[i][pPayCheck] = 0;

		if(PI[i][pWarns])
		{
		    if(PI[i][punWarnstime] > unix) SCMF(i, CRED, "[Внимание]: "WHITE"У вас {"#cRED"}%d"WHITE" предупреждени%s. Дата снятия предупреждений: {"#cRED"}%s", PI[i][pWarns], (PI[i][pWarns]<1) ? ("е"):("я"), date("%dd/%mm/%yyyy в %hh:%ii", PI[i][punWarnstime]));
			else if(PI[i][punWarnstime] <= unix)
			{
			    SendClientMessage(i, COLOR_SERVER, " У Вас снято одно преждупрежение!");
			    PI[i][punWarnstime] = 0;
			    PI[i][pWarns] = 0;
			    UpdatePlayerData(i, "pWarns", 0);
			    UpdatePlayerData(i, "punWarnstime", 0);
			}
		}
	}
	format(string, 144, "[Государственный налог]: В казну зачислено: %i$ с %i человек выплативших налог!", (Gos_Nalog[1] < 800000000 ? (Gos_Nalog[0]*player_plats) : (0)), player_plats);
	SendFractionMessage(26, COLOR_SERVER, string);
	SalaryMafia(), SaveInstrument(), UpdateText(0), UpdateText(2);
	return 1;
}

SendAdminMessage(color, const message[])
{
	foreach(Player, i)
	{
		if (!IsPlayerConnected(i))
			break;

		if (GetAccessAdmin(i, 1))
			SendClientMessage(i, color, message);
	}
	return 1;
}

SendPremiumMessage(color, const message[])
{
	foreach(Player, i)
	{
		if (!IsPlayerConnected(i))
			break;

		if (PI[i][pDRInections] > 0)
			SendClientMessage(i, color, message);
	}
	return 1;
}

SendWeatherMessage(color, const message[])
{
	foreach(Player, i)
	{
		if (!IsPlayerConnected(i))
			break;

		if (PI[i][pWeather] > 0)
			SendClientMessage(i, color, message);
	}
	return 1;
}

SendSupportsMessage(color, const message[])
{
	foreach(Player, i)
	{
		if (!IsPlayerConnected(i))
			break;

		if (PI[i][pHelper] >= 1)
			SendClientMessage(i, color, message);
	}
	return 1;
}

stock SendGhettoMessage(color, const message[])
{
	foreach(Player, i)
	{
		if (!IsPlayerConnected(i))
		break;

		if(IsAGang(i)) SendClientMessage(i, color, message);
	}
	return 1;
}

SendFDMessage(color, const message[])
{
	foreach(Player, i)
	{
		if(!IsPlayerConnected(i)) break;
		if (!strcmp(PI[i][pNames], FD1, false) || !strcmp(PI[i][pNames], FD2, false) || !strcmp(PI[i][pNames], FD3, false)
		|| !strcmp(PI[i][pNames], FD4, false) || !strcmp(PI[i][pNames], FD5, false) || !strcmp(PI[i][pNames], FD6, false) && GetPVarInt(i, "playerAdmin")) SendClientMessage(i, color, message);
	}
	return 1;
}
stock GetWeaponSlot(weaponid)
{
	switch(weaponid)
	{
		case 1: return 0;
		case 2..9: return 1;
		case 22..24: return 2;
		case 25..27: return 3;
		case 28, 29, 32: return 4;
		case 30, 31: return 5;
		case 33, 34: return 6;
		case 35..38: return 7;
		case 16..18, 39: return 8;
		case 41..43: return 9;
		case 10..15: return 10;
		case 44..46: return 11;
		case 40: return 12;
	}
    return -1;
}
publics:IsVehicleOccupied(vehicleid)
{
	foreach(Player, i)
	{
		if(IsPlayerInVehicle(i,vehicleid)) return true;
	}
	return false;
}
LSNews(color, const string_massive[])
{
	foreach(Player, i)
	{
		if(!lNews[i]) SendClientMessage(i, color, string_massive);
	}
	return 1;
}
stock SendJobMessage(job, color, const string_massive[])
{
	foreach(Player, i)
	{
		if(PI[i][pJob] == job) SendClientMessage(i, color, string_massive);
	}
}

SendFractionMessage(fraction, color, const string_massive[])
{
	foreach(Player, i)
	{
	    if(StartRabWork(i) && !GetPVarInt(i, "StartRabWork") && ((!(PI[i][pSettings] & sFractionChat)))) continue;
		if(PI[i][pMember] == fraction || PI[i][pLeader] == fraction)
		{
			SendClientMessage(i, color, string_massive);
		}
		else if (PI[i][pBadge] == 1 && (fraction==4 || fraction==28 || fraction==29)) {
			SendClientMessage(i, color, string_massive);
		}
		else if (PI[i][pBadge] == 2 && (fraction==3 || fraction==19 || fraction==20 || fraction==27)) {
			SendClientMessage(i, color, string_massive);
		}
		else if (PI[i][pBadge] == 3 && (fraction==1 || fraction==2 || fraction==21 || fraction ==25 || fraction==10 || fraction==26)) {
			SendClientMessage(i, color, string_massive);
		}

	}
	return 1;
}

GetVehicleShiftPos(vehicleid, style, &Float:x, &Float:y, &Float:z, Float:distance)
{
    new Float:a;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, a);
	switch(style)
	{
	    case 0:
	    {
	        x += (distance * floatsin(-a, degrees));
			y += (distance * floatcos(-a, degrees));
	    }
	    case 1:
		{
		    x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		case 2:
	    {
	        a += 90.0;
	        x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
	    }
	    case 3:
		{
		    a -= 90.0;
      		x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		default: return 0;
	}
	return 1;
}
SendSpyMessage(fraca, color, mes[])
{
 	foreach(Player, i) if(StartRabWork(i) && GetPVarInt(i, "StartRabWork") && GetPVarInt(i, "tipster_listen") == fraca && GetPVarInt(i, "tipster_listen") > 0)
    {
		format(string, 144, "[TIPSTER] %s", mes);
        SendClientMessage(i, color, string);
	}
	return 1;
}
SendStreamMessage(Float:radius, playerid, const mes[], color)
{
	new Float:X, Float:Y, Float:Z;
 	GetPlayerPos(playerid, X, Y, Z);
	foreach(Player, i) if(GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid) && PlayerToPoint(radius, i, X, Y, Z)) SendClientMessage(i, color, mes);
}
IsPlayerStream(Float:radi, playerid, targetid)
{
	if(!IsPlayerConnected(targetid)) return 0;
	new Float:X, Float:Y, Float:Z;
	GetPlayerPos(targetid, X, Y, Z);
	return PlayerToPoint(radi, playerid, X, Y, Z);
}
ProxDetector(Float:radius = 30.0, playerid, const text[], col1 = 0xFFFFFFFF, col2 = 0xCCCCCCFF, col3 = 0x999999FF, col4 = 0x666666FF, col5 = 0x333333FF)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	new Float:dist, virtualworld = GetPlayerVirtualWorld(playerid), interior = GetPlayerInterior(playerid);
	foreach(Player, i)
	{
		if(BigEar[i]) SendClientMessage(i, col1, text);
		else
		{
			if(virtualworld != GetPlayerVirtualWorld(i) || interior != GetPlayerInterior(i)) continue;
			dist = GetPlayerDistanceFromPoint(i, x, y, z);
			if(dist < radius / 16) SendClientMessage(i, col1, text);
			else if(dist < radius / 8) SendClientMessage(i, col2, text);
			else if(dist < radius / 4) SendClientMessage(i, col3, text);
			else if(dist < radius / 2) SendClientMessage(i, col4, text);
			else if(dist < radius) SendClientMessage(i, col5, text);
		}
	}
	return 1;
}
ProxDetectorS(Float:rad, pl1, pl2)
{
	new Float:pos[3];
	GetPlayerPos(pl1, pos[0], pos[1], pos[2]);
	return(PlayerToPoint(rad, pl2, pos[0], pos[1], pos[2]))?true:false;
}

public OnPlayerText(playerid, text[])
{
	if(!PI[playerid][pLogin]) return 0;
	if(Empty_Message(text)) return ErrorMessage(playerid, "Невозможно отправить пустое сообщение!") & 0;
	if(GetPVarInt(playerid, "anim_using") > unix) return ErrorMessage(playerid, "Не пытайтесь сбить анимацию!") & 0;
	if(!Reklama(playerid, text)) return 0;
	if(GetPVarInt(playerid, #use_television)) return 0;
	if(GetPVarInt(playerid, "Spectate")) return 0;
	if(PI[playerid][pMuteTime])
	{
	    SendClientMessage(playerid, COLOR_GREY, "У Вас бан чата!");
		SetPlayerChatBubble(playerid, "пытается что-то сказать...", 0xDD90FFFF, 30.0, 10000);
		return 0;
	}
	if(PI[playerid][pLogin] || !PI[playerid][pAdmin])
	{
	    if(GetPVarInt(playerid, "OFFCMM")) return false;
		if(GetPVarInt(playerid, "AntiFlood123") > unix) return SCM(playerid, COLOR_GREY, "Не флудите!") & 0;
		SetPVarInt(playerid, "AntiFlood123", unix + 1);
	}
	if(GetPVarInt(playerid, "TalkingLivels") == 1)
	{
		if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У Вас бан чата!") & 0;
		format(string, 144, "[San News] %s [%d] (тел.): %s", PI[playerid][pNames], playerid, text);
		LSNews(0x0073b7AA, string);
	}
	if(GetPVarInt(playerid, "TalkingLivels") == 2)
	{
		if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У Вас бан чата!") & 0;
		if(PI[playerid][pMember] == 16)
		{
			format(string, 144, "[San News] %s [%d] (тел.): %s", PI[playerid][pNames], playerid, text);
			LSNews(0x6B8E23FF, string);
			return 0;
		}
		else
		{
			format(string, 144, "[San News (гость)] %s [%d] (тел.): %s", PI[playerid][pNames], playerid, text);
			LSNews(0x6B8E23FF, string);
			return 0;
		}
	}
 	if(GetPVarInt(playerid, "talkcall"))
	{
	    new callid =GetPVarInt(playerid, "called")-1;
	    if(IsPlayerConnected(callid))
	    {
	        if(GetPVarInt(callid, "talkcall"))
	        {
				format(stringer, 144, "[Тел] %s: %s", PI[playerid][pNames], text);
				sendLongMessage(callid, stringer, CYELLOW, CYELLOW, CYELLOW, CYELLOW, CYELLOW, 0.0, 0);
				sendLongMessage(playerid, stringer, CGRAY, CGRAY, CGRAY, CGRAY, CGRAY, 0.0, 0);
				return 0;
	        }
	    }
	}
	if(GetPVarInt(playerid, "Tel") == 1)
	{
		format(string, 256, "[Телефон] %s: %s", PI[playerid][pNames], text);
		SendStreamMessage(20.0, playerid, string, COLOR_FADE1);
		return 0;
	}
	if(GetPVarInt(playerid, "PEfir") != 999)
	{
		if(PI[playerid][pMember] == 16 || PI[playerid][pLeader] == 16)
		{
			if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У Вас бан чата!") & 0;
			string = "";
			format(string, MAX_STR, "< San News > %s: %s", PI[playerid][pNames], text);
			LSNews(0x0073b7AA, string);
		}
		else if(GetPVarInt(playerid, "Pefir") == 2)
		{
			if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У Вас бан чата!") & 0;
			string = "";
			format(string, MAX_STR, "< San News > %s: %s", PI[playerid][pNames], text);
			LSNews(0x0073b7AA, string);
		}
		return 0;
	}
	if(!strcmp(text, "эй", true)  || !strcmp(text, "э", true) || !strcmp(text, "эй бля", true)|| !strcmp(text, "блять", true) || !strcmp(text, "Блядь", true) || !strcmp(text, "мля", true))
	{
		SetPlayerChatBubble(playerid, "возмущается", 0xDD90FFFF, 30.0, 10000);
		if(!GetPVarInt(playerid, "PlayerCuffed") ) ApplyAnimation(playerid, "PED", "fucku", 4.0, 0, 0, 0, 0, 0, 1);
		return 0;
	}
	if(!strcmp(text, "мда", true) || !strcmp(text, "идиот", true) || !strcmp(text, "сука", true) || !strcmp(text, "пидр", true))
	{
		SetPlayerChatBubble(playerid, "Facepalm", 0xDD90FFFF, 30.0, 10000);
		if(!GetPVarInt(playerid, "PlayerCuffed") ) ApplyAnimation(playerid, "MISC", "plyr_shkhead", 4.0, 0, 0, 0, 0, 0, 1);
		return 0;
	}
	Speech(playerid, text);
	return 0;
}

GetString(param1[], param2[]) return !strcmp(param1, param2, false);

Float:GetPlayerDistanceToPlayer(playerid, nearplayerid)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(nearplayerid, x, y, z);
	return GetPlayerDistanceFromPoint(playerid, x, y, z);
}

Speech(playerid, text[])
{
	if(!PI[playerid][pLogin]) return 1;
	if(PI[playerid][pMuteTime]) return SendClientMessage(playerid, CGRAY, "У Вас бан чата");
	if(GetString(text, "xD")) return MeAction(playerid, "смеётся") & 0;
	if((GetString(text, "здравия") || GetString(text, "q")) && (PI[playerid][pMember] == 3 || PI[playerid][pMember] == 19 || PI[playerid][pMember] == 27)) return MeAction(playerid, "отдал(-а) воинское приветствие"), false;
	if(GetString(text, ":D")) return MeAction(playerid, "хохочет во весь голос"), false;
	if(GetString(text, ")")) return MeAction(playerid, "улыбается"), false;
	if(GetString(text, "))")) return MeAction(playerid, "смеётся"), false;
	if(GetString(text, "(")) return MeAction(playerid, "расстроился(-ась)"), false;
	if(GetString(text, "((")) return MeAction(playerid, "сильно расстроился(-ась)"), false;
	if((GetString(text, "q") || GetString(text, "ку")) && PI[playerid][pMember] == 12) return MeAction(playerid, "показал(а) распальцовку Ballas Gang") & 0;
	if((GetString(text, "q") || GetString(text, "ку")) && PI[playerid][pMember] == 13) return MeAction(playerid, "показал(а) распальцовку Vagos Gang") & 0;
	if((GetString(text, "q") || GetString(text, "ку")) && PI[playerid][pMember] == 15) return MeAction(playerid, "показал(а) распальцовку Grove Street Gang") & 0;
	if((GetString(text, "q") || GetString(text, "ку")) && PI[playerid][pMember] == 17) return MeAction(playerid, "показал(а) распальцовку Aztec Gang") & 0;
	if((GetString(text, "q") || GetString(text, "ку")) && PI[playerid][pMember] == 18) return MeAction(playerid, "показал(а) распальцовку The Rifa Gang") & 0;
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && PlayerTied{playerid} == false && !GetPVarInt(playerid, "PlayerCuffedTime"))
	{
		ApplyAnimation(playerid, "PED", "IDLE_CHAT", 4.1, 0, 1, 1, 1, 1, 1);
		SetTimerEx("AnimClear", 3000, 0, "d", playerid);
	}
	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!") & 0;

	if(GetPVarInt(playerid, "MaskPlayer")) {
		if(PI[playerid][pSettings] & sPlayerIDChat) format(string, sizeof(string), "- {7a7667}%s"WHITE": %s", PI[playerid][pNames], text);
		else format(string, sizeof(string), "- {7a7667}%s"WHITE"[%d]: %s", PI[playerid][pNames], playerid, text);
	}
	else {
		if(PI[playerid][pSettings] & sPlayerIDChat) format(string, sizeof(string), "- {%06x}%s"WHITE": %s", GetPlayerColor(playerid) >>> 8, PI[playerid][pNames], text);
		if (PI[playerid][pDRInections] && strcmp(PI[playerid][pChatColor], "0", true)) format(string, sizeof(string), "- {%06x}%s"WHITE"[%d]:{%s} %s", GetPlayerColor(playerid) >>> 8, PI[playerid][pNames], playerid, PI[playerid][pChatColor], text);
		else format(string, sizeof(string), "- {%06x}%s"WHITE"[%d]: %s", GetPlayerColor(playerid) >>> 8, PI[playerid][pNames], playerid, text);
	}

	GetPlayerPos(playerid, PlayerPos[playerid][0], PlayerPos[playerid][1], PlayerPos[playerid][2]);
	if(PlayerPos[playerid][0] == 0.0 || PlayerPos[playerid][1] == 0.0 || PlayerPos[playerid][2] == 0.0) return 0;
	foreach(Player, i)
	{
		if (BigEar[i]) {
			sendLongMessage(i, string, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0.0, 0);
			continue;
		}
	    if (GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(i) || GetPlayerInterior(playerid) != GetPlayerInterior(i)) continue;
		if(!PlayerToPoint(14.0, i, PlayerPos[playerid][0], PlayerPos[playerid][1], PlayerPos[playerid][2])) continue;
        new color = PlayerToPoint(4.0, i, PlayerPos[playerid][0], PlayerPos[playerid][1], PlayerPos[playerid][2]) ? (0xFFFFFFFF) : PlayerToPoint(8.0, i, PlayerPos[playerid][0], PlayerPos[playerid][1], PlayerPos[playerid][2]) ? (0xCCCCCCFF) : (0xAAAAAAFF);
		if(IsPlayerInAnyVehicle(playerid) && (VehicleEnters[playerid] == GetPVarInt(i, "tipster_vehicle") - 1) && GetPVarInt(i, "tipster_type") == 2)
		{
		    format(stringer, 144, "[TIPSTER] %s", string);
			sendLongMessage(i, stringer, color, color, color, color, color, 0.0, 0);
		}
		else
		{
			SetPVarInt(playerid, "chatMessage", 1);
			sendLongMessage(i, string, color, color, color, color, color, 0.0, 0);
		}
	}

	SetPlayerChatBubble(playerid, text, COLOR_WHITE, 20.0, 10000);
	return 1;
}
stock Float:PointToPoint3D(Float:x1,Float:y1,Float:z1,Float:x2,Float:y2,Float:z2) return VectorSize(x2-x1, y2-y1, z2-z1);
public OnPlayerUpdate(playerid)
{
	if(pTemp[playerid][pAFK] > 3) SCMF(playerid, COLOR_SERVER, "Вы простояли в AFK: %s", TimeConverter(pTemp[playerid][pAFK]));
	pTemp[playerid][pAFK] = 0;

	if(GetPVarInt(playerid,"playerisGPS") == 1)
	{
		new str[144], Float:p[3]; GetPlayerPos(playerid,p[0],p[1],p[2]);
	 	format(str,sizeof(str),"%.1f m",GetDistanceBetweenPoints(p[0], p[1], p[2], GetPVarFloat(playerid,"GPSX"), GetPVarFloat(playerid,"GPSY"), GetPVarFloat(playerid,"GPSZ")));
		PlayerTextDrawSetString(playerid, gps_td[playerid][4],str);
	}
	return 1;
}
publics: clearattach(playerid)
{
	if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
	if(IsPlayerAttachedObjectSlotUsed(playerid, 6)) RemovePlayerAttachedObject(playerid, 6);
	return 1;
}
MinuteTimer()
{
	foreach(Player, i)
	{
		if(!playerNoSetTime{i} && (GetPVarInt(i, "custom_time") == 0)) SetPlayerTime(i, tmphour, tmpminute);
		if(!IsPlayerConnected(i) || !PI[i][pLogin]) continue;

		if(tmphour == 23 && tmpminute == 59)
		{
			mysql_format(1,string, 128, "UPDATE `admin` SET `online_%s`='%d' WHERE Name='%e'", getDay(), pTemp[i][admPlayOnline], PI[i][pNames]);
			mysql_tquery(1, string);
			
			mysql_query(1, "UPDATE accounts SET pAdminzp ='0'",false);

			UpdatePlayerData(i, "playOnline", PI[i][playOnline] = 0);
		}
		if(PI[i][pMuteTime]>0)
		{
	    	UpdatePlayerData(i, "pMuteTime", PI[i][pMuteTime]);
		}
	 	if(PI[i][pJailTime]>0)
		{
			UpdatePlayerData(i, "pJailTime", PI[i][pJailTime]);
		}
		if(PI[i][pPrisonTime]>0)
		{
		    UpdatePlayerData(i, "pPrisonTime", PI[i][pPrisonTime]);
		}
		SetPVarInt(i, "r_shot_10", GetPVarInt(i, "r_shot"));
	    SetPVarInt(i, "r_shot_hit_10", GetPVarInt(i, "r_shot_hit"));
		if(PI[i][pCash] >= 800000001) ResetPlayerMoney(i), SetPlayerCash(i, 800000000), SendClientMessage(i, COLOR_WHITE, "У вас лимит {ffa500}денег"WHITE", больше {ffa500}800 млн. $ -"WHITE" нельзя!");
		else if(PI[i][pBank] >= 800000001) PI[i][pBank] = 800000000, UpdatePlayerData(i, "pBank", 800000000), SendClientMessage(i, COLOR_WHITE, "У вас лимит {ffa500}денег"WHITE", больше {ffa500}800 млн. $ -"WHITE" нельзя!");
		else if (GetPlayerMoney(i) > PI[i][pCash]) ResetPlayerMoney(i), SetPlayerCash(i, PI[i][pCash]);
		if(GetPVarInt(i, #grab_check) && BikeGrab)
		{
			if(TimeGrab <= unix)
			{
				Filling[fuelID][sStartGrab] = false;
				TotalUser = 0, BikeGrab = false, StartGrab = 1, fuelID = -1;
				DeletePVar(i, #grab_check);
				SendClientMessage(i, COLOR_GREEN, "Ограбление закончено! Отправляйтесь на место, где Вы начали ограбление, чтобы сдать бензин!");
				SendClientMessage(i, COLOR_GREEN, "Следующее ограбление будет доступно через 1 час!");
				SCMF(i, COLOR_BLUE, "У Вас с собой %i литров бензина", TotalFuel[i]);
				PlayerTextDrawHide(i, GrabText[i]);
			}
		}
		else if(TimeGrab > unix && BikeGrab)
		{
			if(TimeGrab <= unix && BikeGrab && TotalUser < 5 && PI[i][pMember] == 23)
			{
				SendClientMessage(i, COLOR_REDD, "Не было набрано 5 человек для ограбления, ограбление отменено! Следующее ограбление будет доступно через 3 часа!");
				TotalUsers{i} = false;
				TotalFuel[i] = 0;
				PlayerTextDrawHide(i, GrabText[i]);
				Filling[fuelID][sStartGrab] = false;
				TotalUser = 0, BikeGrab = false, StartGrab = 3, fuelID = -1;
			}
		}
	}
	if(CaptureTime) CaptureTime --;
	return 1;
}
forward GrandTimer();
public GrandTimer()
{
	unix = gettime(tmphour, tmpminute, tmpsecond);
	getdate(tmpyear, tmpmonth, tmpday);
	if(lasthour != tmphour)
	{
		lasthour = tmphour;
		format(string, 126, "Текущее время "WHITE"%d:00", tmphour);
		SendClientMessageToAll(COLOR_SERVER, string);
		PayDay();
	}
	PIrmation();
	for(new playerid; playerid<MAX_PLAYERS; playerid++)
	{
		Second_Timer(playerid);
		if(ShowMap[playerid]) UpdateMap(playerid);
		if(muteTime[playerid] - unix <= 0 && muteTime[playerid] != -1) muteTime[playerid] = -1, muteWarnings[playerid] = 0;
		if(PI[playerid][pPrisonTime]>0)
		{
			PI[playerid][pPrisonTime] --;
			if(PI[playerid][pPrisonTime]<=1)
			{
				SpawnPlayer(playerid);
				PI[playerid][pPrisonTime] = 0; UpdatePlayerData(playerid, "pPrisonTime", 0);
			}
		}
		if(PI[playerid][unfrz] != 0)
		{
			PI[playerid][unfrz]--;
			if(PI[playerid][unfrz] == 0) TogglePlayerControllable(playerid, 1);
		}
		if(PI[playerid][pJailTime]>0)
		{
			PI[playerid][pJailTime]--;
			if(PI[playerid][pJailTime] <= 1)
			{
				if(PI[playerid][pMestoJail] == 1)
				{
					SetPlayerInterior(playerid, 0);
					SetPlayerPos(playerid, 1547.11, -1675.76, 13.94);//Тюрьма
					SetPlayerFacingAngle(playerid, 95.0636);
				}
				if(PI[playerid][pMestoJail] == 2)
				{
					SetPlayerInterior(playerid, 0);
					SetPlayerPos(playerid, -1607.1873, 721.3649, 12.2721);//Тюрьма
					SetPlayerFacingAngle(playerid, 2.3026);
				}
				if(PI[playerid][pMestoJail] == 3)
				{
					SetPlayerInterior(playerid, 0);
					SetPlayerPos(playerid, 2334.8467, 2454.9456, 14.9688);//Тюрьма
					SetPlayerFacingAngle(playerid, 115.7874);
				}
				if(PI[playerid][pMestoJail] == 4)
				{
					SetPlayerInterior(playerid, 0);
					SetPlayerPos(playerid, 1076.0011, -1701.7863, 13.5701);//Тюрьма
					SetPlayerFacingAngle(playerid, 177.8555);
				}
				PI[playerid][pJailTime] = 0;
				SendClientMessage(playerid, COLOR_ISPOLZUY, "Вы заплатили свой долг обществу, теперь вы свободны!");
				PI[playerid][pMestoJail] = 0;
				PI[playerid][pWanted] = 0;
				mysql_format(1, string, 144, "UPDATE `accounts` SET `pJailTime` = '0', `pWanted` = '0', `pMestoJail` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
				mysql_tquery(1, string);
				SetPlayerWantedLevel(playerid, 0);
				SetPlayerVirtualWorld(playerid, 0);
				GameTextForPlayer(playerid, "~g~Freedom", 5000, 1);
				SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
			}
		}
	}
	Other(); Fresh();
	//SendClientMessageToAll(-1, "timer");
	return true;
}
