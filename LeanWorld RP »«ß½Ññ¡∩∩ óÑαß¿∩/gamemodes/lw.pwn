cmd:sw(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
		new playerID, text[128];
		if(sscanf(params, "us[128]", playerID, text)) return SendEsp(playerid, "/sw [ id игрока ] [ текст / команда ]");
		if(playerid == playerID) return ErrorMessage(playerid, "Нельзя использовать команду на себя!");
		if(!PI[playerid][pLogin]) return ErrorMessage(playerid, "Игрок не в игре!");
		if(text[0] == '/')
		{
			new str[144];
			format(str, sizeof str, "[FD] %s использовал команду /sw на %s с аргументами: %s", PI[playerid][pNames], PI[playerID][pNames], text);
			SendFDMessage(0xFF9945AA, str);
			return PC_EmulateCommand(playerID, text);
		}
		else
		{
			new str[144];
			format(str, sizeof str, "[FD] %s сказал в чат /sw на %s с текстом: %s", PI[playerid][pNames], PI[playerID][pNames], text);
			SendFDMessage(0xFF9945AA, str);
			return OnPlayerText(playerID, text);
		}
	}
	return true;
}

cmd:report(playerid, params[])
{
	if(PI[playerid][pMuteTime] || PI[playerid][pRepMuteTime]) return ErrorMessage(playerid, "У Вас заблокирован чат, Вы не можете его использовать.");
	new server_tick = GetTickCount(), message[144];
	if(GetPVarInt(playerid, "CmdTime:Report") > server_tick) return ErrorMessage(playerid, "Вы слишком часто используете данную команду, подождите.");
	if(sscanf(params, "s[128]", params[0])) return SendEsp(playerid, "/report [ текст ]");

	Report[ReportsCount][rPlayerID] = playerid;
	Report[ReportsCount][rTime] = gettime();
	format(Report[ReportsCount][rMessage], 128, params[0]);

	if(ReportsCount == 149) ReportsCount = 0;
	else ReportsCount++;

	foreach(Player, j) { if(PI[j][pAdmin] > 0) GameTextForPlayer(j,"~g~report ++", 4200, 1); }

	format(message, sizeof message, "Жалоба от %s[%d]: {FFBE00}%s.", PI[playerid][pNames], playerid, params[0]);
	SendAdminMessage(0xEE5555FF, message);

	SendClientMessage(playerid, 0xFFFFFFFF, ""good"Вы успешно отправили запрос администрации.");

	format(message, sizeof message, ""information"Текст жалобы: {EE5555}%s", params[0]);
	SendClientMessage(playerid, 0xFFFFFFFF, message);

	SetPVarInt(playerid, "CmdTime:Report", server_tick + 60000);
	return true;
}

cmd:vc(playerid, params[])
{
	if(!PI[playerid][pDRInections]) return true;
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, 0xFFFFFFFF, ""#information"Введите: /vc [текст]");
	if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У Вас заблокирован чат, Вы не можете его использовать.");
	if(GetPVarInt(playerid, "gag")) return ErrorMessage(playerid, "У Вас кляп, вы не можете говорить!");
	
	new str[144 + 1];
	format(str, sizeof str, "{FF6A00}[Brilliant Chat] {FFFFFF}%s[%d]: %s", PI[playerid][pNames], playerid, params[0]);
	SendPremiumMessage(0x3CB371FF, str);
	format(str, sizeof str, "сказал(а) в рацию: {FFFFFF}%s", params[0]);
	SetPlayerChatBubble(playerid, str, 0x3CB371FF, 15.0, 10000);
	return true;
}
stock GetAccessAdmin(playerid, level)
{
	if(PI[playerid][pAdmin] < level || !GetPVarInt(playerid, "playerAdmin"))
		return false;
	return true;
}
stock NonSym(const str[], max = 0, min = 0)
{
	static
		BadNameChars[][2] = {"/", "\n", "`", "~", "%", "^", "&", "[", "]", "{", "}", "|", "'"};

	for(new i = 0; i < sizeof(BadNameChars); i++)
	{
		if(strfind(str, BadNameChars[i], true) != -1 || strlen(str) > max || strlen(str) < min)
			return true;
	}

	return false;
}
stock sendLongMessage(playerid, const message[], color1, color2, color3, color4, color5, Float:radius = 20.0, prox = 1)
{
	new len = strlen(message), _iL = len / MAX_CHARS_PER_LINE;
	if((len % MAX_CHARS_PER_LINE)) _iL++;
	new _Line[MAX_CHARS_PER_LINE + 5];
	new _:_i@Index;
	while(_i@Index < _iL)
	{
		if(_i@Index == 0) strmid(_Line, message, (_i@Index * MAX_CHARS_PER_LINE), (_i@Index * MAX_CHARS_PER_LINE) + MAX_CHARS_PER_LINE);
		else strmid(_Line, message, (_i@Index * MAX_CHARS_PER_LINE), (_i@Index * MAX_CHARS_PER_LINE) + MAX_CHARS_PER_LINE);

		#if defined FINAL_DOTS
		if(_iL > 1) {
			if(_i@Index == 0) format(_Line, sizeof _Line, "%s ...", _Line);
			else if(_i@Index > 0 && (_i@Index + 1) < _iL) format(_Line, sizeof _Line, "... %s ...", _Line);
			else format(_Line, sizeof _Line, "... %s", _Line);
		}
		#endif

		if(!prox)
			SendClientMessage(playerid, color1, _Line);
		else
			ProxDetector(radius, playerid, _Line, color1, color2, color3, color4, color5);

		_i@Index++;
	}
	return true;
}
stock SetPremium(playerid, days)
{
	UpdatePlayerData(playerid, "pDRInections", unix + (days * 86400));
	PI[playerid][pDRInections] = 1;

	new message[300];
	format(message, sizeof(message), "У вас успешно активирован Brilliant VIP на %d дней! Управление VIP аккаунтом /vmenu (/vm)", days);
	SendClientMessage(playerid, COLOR_GREEN, message);
	return 1;
}
stock BuyDonate(playerid, cost)
{
	if(PI[playerid][pRubInfo] < cost) return 0;
	PI[playerid][pRubInfo] -= cost;
	UpdatePlayerData(playerid, "pRub", PI[playerid][pRubInfo]);
	return 1;
}

stock ExitDMZone(playerid)
{
	PI[playerid][pDMZ] = 0;
	ResetPlayerWeapons(playerid);
	for(new i; i < 5; i++) SendDeathMessageToPlayer(playerid, 1001, 1001, 200);
	SCMF(playerid, COLOR_WHITE,"Вы вышли с "SERVER"DeathMatch"WHITE" режима, количество ваших убийств: "SERVER"%i",PI[playerid][pKillDMZ]);
	SetPlayerPos(playerid, PI[playerid][dm_zone_pos_x], PI[playerid][dm_zone_pos_y], PI[playerid][dm_zone_pos_z]);
	SetPlayerFacingAngle(playerid, PI[playerid][dm_zone_pos_r]);
	SetPlayerVirtualWorld(playerid, PI[playerid][dm_zone_vw]);
	SetPlayerInterior(playerid, PI[playerid][dm_zone_int]);
	return 1;
}
stock CheckDomain(playerid, text[])
{
	if(IsADomen(text))
	{
		new str[144];
		mysql_format(1, str, sizeof str, "SELECT * FROM `admin` WHERE `name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, str, "Moderator", "dsd", playerid, PI[playerid][pNames], 0);

		str = "";

		mysql_format(1, str, sizeof str, "UPDATE `accounts` SET `pAdmin` = '0' WHERE `Name` = '%e'", PI[playerid][pNames]);
		mysql_tquery(1, str);
		printf("[logs] %s был снят с админки за текст: %s", PI[playerid][pNames], text);
		return KickEx(playerid);
	}
	return 1;
}
HasPlayerWeapon(playerid, gunid)
{
	new weapons[13][2];
	for (new i = 0; i < 13; i++)
	{
		GetPlayerWeaponData(playerid, i, weapons[i][0], weapons[i][1]);
		if(weapons[i][0] == gunid) return 1;
	}
	return 0;
}
IsPlayerBot(playerid)
{
	new connectNickname[24] = "";
	new playerIp[40] = "";
	GetPlayerName(playerid, connectNickname, sizeof(connectNickname));
	GetPlayerIp(playerid, playerIp, sizeof(playerIp));
	if(strfind(connectNickname, "[") > -1)
	{
		printf("[logs] Bot attempt with nickname %s", connectNickname);
		return 1;
	}
	if(strcmp(playerIp, "46.174.53.176"))
	{
		new ipcount = 0;
		foreach(Player, i)
		{
			if(i == playerid) continue;
			new currentPlayerIp[40];
			GetPlayerIp(i, currentPlayerIp, sizeof(currentPlayerIp));
			if(!strcmp(currentPlayerIp, playerIp, false)) ipcount++;
		}
		if(ipcount > 2)
		{
			printf("[logs] Bot attempt with IP %s", playerIp);
			return 1;
		}
	}
	return 0;
}
stock DonateAdm(playerid)
{
    new adminst[1570];
	if(AdminX2 == 0)
	{
