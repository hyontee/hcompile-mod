cmd:tv(playerid)
{
	if(PI[playerid][pHouse] == -1 && PI[playerid][pArendaHouse] == -1) return ErrorMessage(playerid, "У Вас нет дома!");
	if(GetPVarInt(playerid, #use_television)) return ShowPlayerDialog(playerid, 2221, DIALOG_STYLE_MSGBOX, ""SERVER"Телевизор", ""WHITE"Вы желаете выключить телевизор?", "Выкл", "Отмена");
	new h;
	if(PI[playerid][pHouse] != -1) h = PI[playerid][pHouse];
	else h = PI[playerid][pArendaHouse];
	new Float:pos[3], k; GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	for(new i; i<MAX_MEBEL_MODEL; i++)
	{
 		if(DynamicObjectToPoint(3.0, HouseMebel[h][MEBEL_TV][i], pos[0], pos[1], pos[2]) || DynamicObjectToPoint(3.0, HouseMebel[h][MEBEL_KINO][i], pos[0], pos[1], pos[2])) ShowPlayerDialog(playerid, 2221, DIALOG_STYLE_MSGBOX, ""SERVER"Телевизор", ""WHITE"Вы желаете включить телевизор?", "Вкл", "Отмена"), k++;
	}
	if(!k) return ErrorMessage(playerid, "Вы не у телевизора");
	return 1;
}
cmd:spy(playerid)
{
	if(PI[playerid][pMember] != 2) return ErrorMessage(playerid, "Доступно сотрудникам ФБР!");
	string = "";
	for(new i;i!=sizeof(GetMember);i++) format(string, 512, "%s%s\n", string, GetMember[i]);
	ShowPlayerDialog(playerid, 5515, 2, ""SERVER"Маскировка FBI", string, "Далее", "Отмена");
	return 1;
}
cmd:window(playerid)
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ErrorMessage(playerid, "Вы не на водительском месте.");
	if(IsNoWindowsCar(VehicleEnters[playerid])) return ErrorMessage(playerid, "На этом транспортном средстве нельзя открывать окна!");
	ShowPlayerDialog(playerid, 9968, DIALOG_STYLE_LIST, ""SERVER"Панель управлениями окнами авто", ""WHITE"Открыть/Закрыть водительское окно\nОткрыть/Закрыть пассажирское (переднее) окно\nОткрыть/Закрыть заднее левое окно\nОткрыть/Закрыть заднее правое окно", "Выбрать", "Отмена");
	return 1;
}
cmd:close(playerid)
{
	string = "";
	switch(PI[playerid][pLeader])
	{
		case 12: format(string, 144, ""WHITE"The Ballas Gang | Склад: "SERVER"%s", b_Sklad{0} ? ("Открыт") : ("Закрыт"));
		case 13: format(string, 144, ""WHITE"Los Santos Vagos Gang | Склад: "SERVER"%s", b_Sklad{1} ? ("Открыт") : ("Закрыт"));
		case 15: format(string, 144, ""WHITE"Grove Street Gang | Склад: "SERVER"%s", b_Sklad{2} ? ("Открыт") : ("Закрыт"));
		case 17: format(string, 144, ""WHITE"Varios Los Aztecas Gang | Склад: "SERVER"%s", b_Sklad{3} ? ("Открыт") : ("Закрыт"));
		case 18: format(string, 144, ""WHITE"The Rifa Gang | Склад: "SERVER"%s", b_Sklad{4} ? ("Открыт") : ("Закрыт"));
	}
	ShowPlayerDialog(playerid, 9995, DIALOG_STYLE_MSGBOX, ""SERVER"Управление складом", string, "Изменить", "Отмена");
	return 1;
}
cmd:vad(playerid, params[])
{
	if(sscanf(params, "s[144]", params[0])) return SendEsp(playerid, "/vad [текст]");
	if(PI[playerid][pMuteTime]) return ErrorMessage(playerid, "У вас бан чата!");
	if(!PI[playerid][pDRInections]) return ErrorMessage(playerid, "Данная команда доступна только владельцам Brilliant VIP.");
	if(Vip_Advertise_Time[playerid] > unix) return ErrorMessage(playerid, "Вы уже подали объявление на публикацию. Ожидайте...");
	if(!Reklama(playerid, params[0])) return 1;
	strmid(gVip[playerid][adSender], PI[playerid][pNames], 0, strlen(PI[playerid][pNames]), 255);
	gVip[playerid][adID] = playerid;
	strmid(gVip[playerid][adText], params[0], 0, strlen(params[0]), 255);
	Vip_Advertise_Time[playerid] = unix+gVipTime;
	gVipTime = unix+30;
	if(Vip_Advertise_Time[playerid] <= unix) Vip_Advertise_Time[playerid] = unix+30;
	gVip[playerid][adNumber] = PI[playerid][pPnumber];
	SCMF(playerid, COLOR_WHITE, "Ваше объявление успешно доставлено в службу проверки персональных объявлений. Примерное время ожидания публикации: %s.", TimeConverter(Vip_Advertise_Time[playerid]-unix));
	return 1;
}
cmd:flip(playerid)
{
	if(!PI[playerid][pDRInections]) return ErrorMessage(playerid, "Данная команда доступна только владельцам Brilliant VIP.");
    if(IsPlayerInAnyVehicle(playerid)) // Проверка на нахождения игрока в машине
    {
        new Float:angle;
        RepairVehicle(GetPlayerVehicleID(playerid));  // Функция чинит манину
        GetVehicleZAngle(GetPlayerVehicleID(playerid), angle); // Функция задаёт позицию
        SetVehicleZAngle(GetPlayerVehicleID(playerid), angle); // Функция вызывает позицию
    }
    return 1;
}
cmd:neon(playerid)
{
	if(!PI[playerid][pDRInections]) return ErrorMessage(playerid, "Данная команда доступна только владельцам Brilliant VIP.");
	if(IsPlayerInAnyVehicle(playerid)) ShowPlayerDialog(playerid,12221,DIALOG_STYLE_LIST,"Выберите цвет неона","Красный\nСиний\nЗелёный\nЖелтый\nРозовый\nБелый\nУдалить Неон","Выбрать","Отмена");
	return 1;
}
cmd:narkopriton(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 10))
		return true;
	//if(gAdminReason[playerid][ADMIN_NARKOPRITON]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, ""#information"Введите /narkopriton [количество]");
	if(params[0]<0||params[0]>5000) return ErrorMessage(playerid, "Нельзя меньше 0 и больше 5000");
	PritonNarko = params[0];
	mysql_format(1, string, sizeof(string), "UPDATE `mafiabalance` SET  `priton` = '%d' LIMIT 1", PritonNarko);
	mysql_tquery(1, string);
	SendClientMessage(playerid, -1, ""#good"Наркотики успешно были доставлены в наркопритон!");
	return 1;
}
cmd:pts(playerid, params[])
{
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_GRAD1, "Введите: /pts [car (1-2-3-4)] [id]");
	if(params[0] < 1 || params[0] > 4) return ErrorMessage(playerid, "Нельзя меньше 1 и больше 3!");
	if(!strcmp(NumberVehicle[playerid][params[0]-1], "Транзит", true)) return ErrorMessage(playerid, "У Вас нет номерного знака на этом авто!");
	if(!IsPlayerConnected(params[1])) return ErrorMessage(playerid, "Игрок оффлайн!");
	if(!ProxDetectorS(8.0, playerid, params[1])) return ErrorMessage(playerid, "Игрок далеко от Вас!");
	new house;
	if(PI[playerid][pHouse] != -1) house = PI[playerid][pHouse];
	else if(PI[playerid][pArendaHouse] != -1) house = PI[playerid][pArendaHouse];
	if(house == -1 || !house) return ErrorMessage(playerid, "У Вас нет недвижимости!");
	new str_car[28], str_car_1[28], str_car_2[28], str_car_3[28], str_car_4[28];
	PlayerTextDrawSetPreviewModel(params[1], PPTS[playerid][0], PI[playerid][pCar][params[0]-1]);
	PlayerTextDrawSetPreviewVehCol(params[1], PPTS[playerid][0], gPlayerTuning[playerid][params[0]-1][1], 0);
	format(str_car, sizeof(str_car), "%s", PI[playerid][pNames]);
	PlayerTextDrawSetString(params[1], PPTS[playerid][1], str_car);
	format(str_car_1, sizeof(str_car_1), "Age Owner:~w~ %i", PI[playerid][pAge]);
	PlayerTextDrawSetString(params[1], PPTS[playerid][2], str_car_1);
	format(str_car_2, sizeof(str_car_2), "Model Car:~w~  %s", VehicleNames[PI[playerid][pCar][params[0]-1]-400]);
	PlayerTextDrawSetString(params[1], PPTS[playerid][3], str_car_2);
	format(str_car_3, sizeof(str_car_3), "Number Car:~w~  %s", NumberVehicle[playerid][params[0]-1]);
	PlayerTextDrawSetString(params[1], PPTS[playerid][4], str_car_3);
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && VehicleEnters[playerid] == caridhouse[playerid][params[0]-1]) format(str_car_4, sizeof(str_car_4), "Mileage:~w~ %.1f", VehInfo[VehicleEnters[playerid]-1][vDrived]), PlayerTextDrawSetString(params[1], PPTS[playerid][5], str_car_4);
	string = "";
	format(string, 144, "%s показал(а) свой ПТС %s'у", PI[playerid][pNames], PI[params[1]][pNames]);
	SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 30.0, 10000);
	format(string, 144, "* %s показал(а) свой ПТС %s `у", PI[playerid][pNames], PI[params[1]][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	for(new x; x < 6; x ++) PlayerTextDrawShow(params[1], PPTS[playerid][x]);
	for(new x; x < 3; x ++) TextDrawShowForPlayer(params[1], STYLEPTS[x]);
	SelectTextDraw(params[1], 0xFFFFFF50);
	SetPVarInt(params[1], #give_pts, true);
	return 1;
}
cmd:money(playerid, params[])
{
    if(!GetAccessAdmin(playerid, 2))
		return true;
    if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Используйте: /money [id]");
    if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Данного игрока нет на сервере!");
    format(string, 120, ""WHITE"Банковский счет: "SERVER"%d$\n"WHITE"Наличные: "SERVER"%d$\n\n"WHITE"Всего: "SERVER"%d$", PI[params[0]][pBank], PI[params[0]][pCash], PI[params[0]][pCash]+PI[params[0]][pBank]);
    ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, PI[params[0]][pNames], string, "Закрыть", "");
    return 1;
}
cmd:givenick(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 14))
		return true;
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1, ""#information"Введите: /nick [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок оффлайн!");
	string = "";
	format(string, 150, ""WHITE"Администратор "SERVER"%s(%d)"WHITE" предложил Вам сменить игровой ник, вы согласны?", PI[playerid][pNames], playerid);
	ShowPlayerDialog(params[0], 3512, DIALOG_STYLE_MSGBOX, ""SERVER"Предложение о смене имени!", string, "Принять", "Отклонить");
	format(string, 150, "Администратор "SERVER"%s(%d)"WHITE" предложил сменить ник "SERVER"%s(%d)", PI[playerid][pNames], playerid, PI[params[0]][pNames], params[0]);
	SendAdminMessage(COLOR_WHITE, string);
	SetPVarInt(params[0], "aName", playerid);
	return 1;
}
cmd:chs(playerid, params[])
{
	if(!PI[playerid][pLeader]) return 1;
	if(sscanf(params, "us[64]", params[0], params[1])) return SendClientMessage(playerid, -1, "/chs [id] [причина]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок оффлайн!");
	if(PI[params[0]][pMember] != PI[playerid][pMember]) return ErrorMessage(playerid, "Игрок не в Вашей фракции!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя самого себя!");
	if(strlen(params[1])>64) return ErrorMessage(playerid, "Причина слишком большая!");
	string = "";
	mysql_format(1, string, 144, "SELECT * FROM `blocks` WHERE `blockName` = '%e' AND `blockFraction` = '%i'", PI[params[0]][pNames], PI[params[0]][pMember]);
	mysql_tquery(1, string, "BlocksCallback", "ddsd", playerid, params[0], params[1], 0);
	return 1;
}
cmd:cshowall(playerid)
{
	if(!PI[playerid][pLeader]) return 1;
	string = "";
	mysql_format(1, string, 144, "SELECT * FROM `blocks` WHERE `blockFraction` = '%i'", PI[playerid][pMember]);
	mysql_tquery(1, string, "BlocksCallback", "ddsd", playerid, playerid, "None", 2);
	return 1;
}
cmd:unchs(playerid, params[])
{
    if(!PI[playerid][pLeader]) return 1;
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1, "/unchs [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок оффлайн!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Нельзя самого себя!");
	string = "";
	mysql_format(1, string, 144, "SELECT * FROM `blocks` WHERE `blockName` = '%e' AND `blockFraction` = '%i'", PI[params[0]][pNames], PI[playerid][pMember]);
	mysql_tquery(1, string, "BlocksCallback", "ddsd", playerid, params[0], "None", 1);
	return 1;
}
cmd:limit(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, CGRAY, "Вы должны быть за рулем");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, ""#information"Используйте: /limit [скорость (0 - отключить)]");
	if(GetPVarInt(playerid, "slimit") && !params[0])
	{
	    SendClientMessage(playerid, COLOR_SERVER, "Вы отключили лимит скорости!");
	    DeletePVar(playerid, "slimit");
	    return 1;
	}
	if(params[0]<10||params[0]>200) return ErrorMessage(playerid, "Нельзя меньше 0 и больше 200");
	SetPVarInt(playerid, "slimit", params[0]);
	SendClientMessage(playerid, COLOR_SERVER, "Вы включили лимит скорости!");
	return 1;
}
cmd:eat(playerid)
{
	if(!GetPVarInt(playerid, "TrayInfo_Use")) return ErrorMessage(playerid, "У Вас нет подноса.");
	ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.1, 0, 1, 1, 1, 1);
	DeletePVar(playerid, "TrayInfo_Use");
	if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);
	SetPlayerSpecialAction(playerid, 0);
	MeAction(playerid, "перекусил(а)");
	new Float:health; GetPlayerHealth(playerid, health);
	SetPlayerHealth(playerid, health + 20);
	return 1;
}
cmd:put(playerid)
{
	if(!GetPVarInt(playerid, "TrayInfo_Use")) return ErrorMessage(playerid, "У Вас нет подноса.");
	new Float: b_pos[4];
	GetPlayerPos(playerid, b_pos[0], b_pos[1], b_pos[2]);
	GetPlayerFacingAngle(playerid, b_pos[3]);
	if(CreateTray(b_pos[0], b_pos[1], b_pos[2], b_pos[3], GetPlayerVirtualWorld(playerid)))
	{
		ApplyAnimation(playerid, "CARRY", "putdwn", 4.1, 0, 1, 0, 0, 1000, 1);
		DeletePVar(playerid, "TrayInfo_Use");
		if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);
		SetPlayerSpecialAction(playerid, 0);
		SCM(playerid, -1, ""#information"Вы положили поднос с едой на пол.");
	}
	else ErrorMessage(playerid, "Произошёл сбой, попробуйте повторить позже.");
	return 1;
}
alias:bandchat("bc");
cmd:bandchat(playerid, params[])
{
	if(!IsAGang(playerid)) return ErrorMessage(playerid, "Вы не бандит!");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, -1, ""#information"Введите: /bc [текст]");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		PI[playerid][pMuteTime] = 60;
		UpdatePlayerData(playerid, "pMuteTime", PI[playerid][pMuteTime]);
		SendClientMessage(playerid, COLOR_RED, "Вы получили мут за флуд.");
		string = "";
		format(string, 144, "%s получил мут за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		return 1;
	}

	if(!Reklama(playerid, params[0])) return 1;
	if(PI[playerid][pMuteTime] > 0) return ErrorMessage(playerid, "У вас бан чата!");
	new text[100];
	strmid(text, params[0], 0, 100);
	for(new pos, s; s < sizeof(ArchiNeMateritsa); s++)
	{
		pos = 0;
		while((pos = strfind(text, ArchiNeMateritsa[s], true)) != -1) for(new i = pos, j = pos + strlen(ArchiNeMateritsa[s]); i < j; i++) text[i] = '*';
	}
	new ttext[50], gtop[50];
	switch(PI[playerid][pGhettoKillCount])
	{
	    case 0..100: gtop = "{93C722}[Новичок]";
	    case 101..500: gtop = "{93C722}[Сообщник]";
	    case 501..1000: gtop = "{93C722}[Боевик]";
	    case 1001..1500: gtop = "{93C722}[Гангстер]";
	    case 1501..2500: gtop = "{93C722}[Психопат]";
	    case 2501..4000: gtop = "{93C722}[Заправляющий]";
	    case 4001..6000: gtop = "{93C722}[Уличный босс]";
	    case 6001..8000: gtop = "{93C722}[Король улиц]";
 	}
	switch(PI[playerid][pMember]) { case 12: ttext = "{8813E7}[Ballas]"; case 13: ttext = "{DBD604}[Vagos]"; case 15: ttext = "{009F00}[Grove Street]"; case 17: ttext = "{01FCFF}[Aztec]"; case 18: ttext = "{83BFBF}[Rifa]"; }
	format(string, MAX_STR, ""SERVER"[GC] %s "WHITE"%s[%d]: %s", ttext, PI[playerid][pNames], playerid, text);
	MessageCriminal(0xFFFFFFFF, string, true);
	PI[playerid][last_message] = params[0];
	return 1;
}
alias:mafiachat("mc");
cmd:mafiachat(playerid, params[])
{
	if(!ISAMAFIA(playerid)) return ErrorMessage(playerid, "Вы не мафиози!");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, -1, ""#information"Введите: /mafiachat [текст]");

	if(strcmp(params[0], PI[playerid][last_message]) == 0) PI[playerid][last_message_count]++;
	else PI[playerid][last_message_count] = 0;
	if(PI[playerid][last_message_count] >= 3)
	{
		if(StartRabWork(playerid)) SetPVarInt(playerid, "StartRabWork", 0);
		PI[playerid][pMember] = 0;
		PI[playerid][pRank] = 0;
		PI[playerid][pLeader] = 0;
		PI[playerid][pJob] = 0;
		string = "";
		mysql_format(1, string, 164, "UPDATE `accounts` SET `pMember` = '0', `pRank` = '0', `pLeader` = '0', `pJob` = '0' WHERE `id` = '%d'", PI[playerid][pID]);
		mysql_tquery(1, string);
		SetPlayerColor(playerid, FI[PI[playerid][pMember]][fColor]);
		SetPlayerSkin(playerid, PI[playerid][pChar]);
		SendClientMessage(playerid, COLOR_RED, "Вы были уволены. Если это произошло ошибочно, то пиши Анастасии. НЕ ЗАБУДЬ СКРИН СДЕЛАТЬ!!!");
		string = "";
		format(string, 144, "%s был уволен из фракции за сообщения %s", PI[playerid][pNames], params[0]);
		SendAdminMessage(COLOR_LIGHTRED, string);
		KickEx(playerid);
		return 1;
	}

	if(!Reklama(playerid, params[0])) return 1;
	if(PI[playerid][pMuteTime] > 0) return ErrorMessage(playerid, "У вас бан чата!");
	new text[100];
	strmid(text, params[0], 0, 100);
	for(new pos, s; s < sizeof(ArchiNeMateritsa); s++)
	{
		pos = 0;
		while((pos = strfind(text, ArchiNeMateritsa[s], true)) != -1) for(new i = pos, j = pos + strlen(ArchiNeMateritsa[s]); i < j; i++) text[i] = '*';
	}
	new ttext[50];
	switch(PI[playerid][pMember]) { case 5: ttext = "{DBD604}[LCN]"; case 6: ttext = "{FF1300}[Yakuza]"; case 14: ttext = "{B4B5B7}[Russian Mafia]";}
	format(string, MAX_STR, ""SERVER"[MAFIA CHAT] %s "WHITE"%s[%d]: %s", ttext, PI[playerid][pNames], playerid, text);
	MessageCriminal(0xFFFFFFFF, string, false);
	PI[playerid][last_message] = params[0];
	return 1;
}
cmd:bankdoor(playerid)
{
	if(!PlayerToPoint(3, playerid, 2144.178, 1627.082, 994.2620)) return ErrorMessage(playerid, "Вы далеко от банковской двери");
	if(IsACop(playerid))
	{
		if(BankDoor_Status) return ErrorMessage(playerid, "Банковская дверь уже открыта.");
		ApplyAnimation(playerid, "OTB", "betslp_lkabt", 4.1, 0, 1, 1, 0, 0);
		ApplyAnimation(playerid, "OTB", "betslp_lkabt", 4.1, 0, 1, 1, 0, 0);
		BankDoor_Status = true;
		BankDoor_Time_Close[playerid] = 240;
		MoveObject (DoorOpen, 2146.0, 1627.082, 994.2620, 0.3);
	}
	else
	{
		if(!BankLight_Status) return ErrorMessage(playerid, "Для начала надо отключить электропитание.");
		if(BankDoor_Status) return ErrorMessage(playerid, "Банковская дверь уже открыта.");
		ApplyAnimation(playerid, "OTB", "betslp_lkabt", 4.1, 0, 1, 1, 0, 0);
		BankDoor_Status = true;
		BankDoor_Time_Close[playerid] = 120;
		ApplyAnimation(playerid, "OTB", "betslp_lkabt", 4.1, 0, 1, 1, 0, 0);
		SendClientMessage(playerid, COLOR_GREY, "Дверь банковского сейфа открыта на 2 минуты, спешите!");
		MoveObject (DoorOpen, 2146.0, 1627.082, 994.2620, 0.3);
		ProxDetector(30.0, playerid, "* Незнакомец открывает дверь банковского сейфа.", 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	}
	return 1;
}
cmd:robbank(playerid)
{
	if(PI[playerid][pRobTime] > unix) return ErrorMessage(playerid, "Грабить банк можно раз в 3 часа.");
	if(Gos_Nalog[1] < 500000) return ErrorMessage(playerid, "Казна штата слишком мала, чтобы её грабить.");
	if(!PlayerToPoint(2.0, playerid, 2147.2971, 1637.2709, 993.5759)) return ErrorMessage(playerid, "Вы не у банковского сейфа.");
	new fraction = PI[playerid][pMember];
	switch(fraction)
	{
		case 5, 6, 12..15, 17, 18, 23, 26:
		{
			if(IsACop(playerid)) return ErrorMessage(playerid, "Вы коп! Вам нельзя взламывать банковский сейф.");
			if(BankRob_Status) return ErrorMessage(playerid, "Банковский сейф уже взламывают.");
			ApplyAnimation(playerid, "ROB_BANK", "CAT_Safe_Rob", 4.1, 1, 1, 1, 0, 0);
			SetPVarInt(playerid, "RobBankTimer", SetTimerEx("_@RobBank", 10000, false, "d", playerid)); BankRob_Status = true;
			ApplyAnimation(playerid, "ROB_BANK", "CAT_Safe_Rob", 4.1, 1, 1, 1, 0, 0);
			ProxDetector(30.0, playerid, "* Незнакомец пытается взломать банковский сейф.", 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
		}
		default: ErrorMessage(playerid, "Вам не доступна данная функция.");
	}
	return 1;
}
cmd:light(playerid)
{
	if(!PlayerToPoint(3.0, playerid, 2143.0061, 1620.307, 1000.969)) return ErrorMessage(playerid, "Вы не у блока электропитания.");
	new fraction = PI[playerid][pMember];
	switch(fraction)
	{
		case 5, 6, 12..15, 17, 18, 23, 26:
		{
			if(BankLight_Status) return ErrorMessage(playerid, "Электропитание уже отключено.");
			ApplyAnimation(playerid, "OTB", "betslp_lkabt", 4.1, 0, 1, 1, 0, 0);
			BankLight_Status = true;
			ProxDetector(30.0, playerid, "* Незнакомец отключает электропитание банка.", COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE);
			ApplyAnimation(playerid, "OTB", "betslp_lkabt", 4.1, 0, 1, 1, 0, 0);
			ApplyAnimation(playerid, "OTB", "betslp_lkabt", 4.1, 0, 1, 1, 0, 0);
		}
		default: ErrorMessage(playerid, "Вы не можете отключить электропитание");
	}
	return 1;
}
cmd:atipster(playerid, params[])
{
    if(!GetAccessAdmin(playerid, 1))
		return true;
    else if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, ""#information"/atipster [ID фракции]");
    else if(params[0]<1 || params[0] > 27) return SendClientMessage(playerid, -1, ""#information"/atipster [ID фракции]");
    else if(GetPVarInt(playerid, "tipster_listen"))
	{
	    SendClientMessage(playerid, COLOR_SERVER, "Вы отключили прослушку");
		DeletePVar(playerid, "tipster_listen");
		return 1;
	}
    SetPVarInt(playerid, "tipster_listen", params[0]);
    format(string, 128, "Вы начали прослушку фракции "WHITE"%s", FI[params[0]][fName]);
    SendClientMessage(playerid, COLOR_SERVER, string);
    SendClientMessage(playerid, -1, "Используйте /atipster еще раз чтобы отключить прослушку");
    return 1;
}
cmd:tipster(playerid, params[])
{
	if(PI[playerid][pMember] != 2) return ErrorMessage(playerid, "Доступно только ФБР");
	if(!GetPVarInt(playerid, "tipster")) return ErrorMessage(playerid, "У вас нету жучка. Подойдите к багажнику машины и нажмите 'H'");
    new param[40];
    if(sscanf(params, "s[32]S()[64]", param, params))
    {
        SendClientMessage(playerid, CWHITE, ""#information" "WHITE" /tipster [действие]");
        SendClientMessage(playerid, CINFO, "- "WHITE"SET {"#cINFO"} Прикрепить жучок к игроку");
        SendClientMessage(playerid, CINFO, "- "WHITE"VEHICLE {"#cINFO"} Прикрепить жучок к автомолию");
        SendClientMessage(playerid, CINFO, "- "WHITE"REMOVE {"#cINFO"} Деактивировать жучок");
        SendClientMessage(playerid, CINFO, "- "WHITE"LISTEN {"#cINFO"} Начать прослушивание чата фракции");
        return 1;
    }
    else if(!strcmp(param, "set"))
    {
  		new giveplayerid;
	    if(sscanf(params, "i", giveplayerid)) return ErrorMessage(playerid, "Используйте: /tipster set [ид игрока]");
	    if(!IsPlayerConnected(giveplayerid)) return ErrorMessage(playerid, "Игрок оффлайн");
     	if(!PI[giveplayerid][pMember]) return ErrorMessage(playerid, "Игрок не состоит в организации");
	    new Float:X, Float:Y, Float:Z;
	    GetPlayerPos(giveplayerid, X, Y, Z);
	    if(!PlayerToPoint(10.0, playerid, X, Y, Z)) return ErrorMessage(playerid, "Игрок не рядом с вами");
	    SetPVarInt(playerid, "tipster_set", giveplayerid + 1);
	    SetPVarInt(playerid, "tipster_type", 1);
	    format(string, 200, "Вы поставили жучок на "WHITE"%s {269BD8}Используйте "WHITE"/tipster listen {269BD8}для прослушки", PI[giveplayerid][pNames]);
	    SendClientMessage(playerid, CINFO, string);
    }
    else if(!strcmp(param, "vehicle"))
    {
        new Float:X, Float:Y, Float:Z, Float:PX, Float:PY, Float:PZ, Float:PA, vehicleid = -1;
		for(new i = 1, j = GetVehiclePoolSize(); i <= j; i++) if(PlayerToPoint(5.0, playerid, VehInfo[i-1][vehicleX], VehInfo[i-1][vehicleY], VehInfo[i-1][vehicleZ])) vehicleid = i;
		if(vehicleid==-1) return ErrorMessage(playerid, "Вы не рядом с автомобилем!");
		GetVehicleShiftPos(vehicleid, 1, X, Y, Z, 5.0); GetPlayerPos(playerid, PX, PY, PZ); GetPlayerFacingAngle(playerid, PA);
	    if(!PlayerToPoint(5.0, playerid, X, Y, Z)) return ErrorMessage(playerid, "Вы не рядом с багажником автомобиля");
		if(VehInfo[vehicleid - 1][vehicleA]-60 < PA < VehInfo[vehicleid -1][vehicleA]+60) return ErrorMessage(playerid, "Вы не стоите спиной к багажнику!");
		ApplyAnimation(playerid, "CAR", "fixn_car_loop", 4.1, 1, 0, 0, 0, 0, 0);
		SetTimerEx("AnimClear", 3000, false, "i", playerid);
	    SetPVarInt(playerid, "tipster_vehicle", vehicleid + 1);
	    SetPVarInt(playerid, "tipster_type", 2);
	    format(string, 200, "Вы поставили жучок на автомобиль "WHITE"%s {269BD8}Используйте "WHITE"/tipster listen {269BD8}для прослушки", VehicleNames[GetVehicleModel(vehicleid)-400]);
	    SendClientMessage(playerid, CINFO, string);
    }
    else if(!strcmp(param, "listen"))
    {
        if(!GetPVarInt(playerid, "tipster_set") && !GetPVarInt(playerid, "tipster_vehicle")) return ErrorMessage(playerid, "Сначала поставьте жучок {"#cBADINFO"}/tipster set/vehicle");

		if(GetPVarInt(playerid, "tipster_type") == 1)
		{
	        new giveplayerid = GetPVarInt(playerid, "tipster_set")-1;

			format(string, 128, "Вы начали прослушку за игроком "WHITE"%s", PI[giveplayerid][pNames]);
			SendClientMessage(playerid, CINFO, string);

			SetPVarInt(playerid, "tipster_listen", PI[giveplayerid][pMember]);
			DeletePVar(playerid, "tipster_set");
		}
		else if(GetPVarInt(playerid, "tipster_type") == 2)
		{
  			new vehicleid = GetPVarInt(playerid, "tipster_vehicle") - 1;
			format(string, 128, "Вы начали прослушку за происходящем в автомобиле "WHITE"%s", VehicleNames[GetVehicleModel(vehicleid)-400]);
			SendClientMessage(playerid, CINFO, string);
		}
	}
	else if(!strcmp(param, "remove"))
	{
		if(GetPVarInt(playerid, "tipster_set"))		DeletePVar(playerid, "tipster_set");
		if(GetPVarInt(playerid, "tipster_vehicle"))	DeletePVar(playerid, "tipster_vehicle");
		if(GetPVarInt(playerid, "tipster_listen"))	DeletePVar(playerid, "tipster_listen");
		if(GetPVarInt(playerid, "tipster_type"))		DeletePVar(playerid, "tipster_type");
		if(GetPVarInt(playerid, "tipster"))			DeletePVar(playerid, "tipster");
		SendClientMessage(playerid, COLOR_LIGHTRED, "Вы деактивировали жучок");
	}
	return 1;
}
cmd:dostup(playerid, params[])
{
	if(D_FULL(PI[playerid][pNames]))
	{
    	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/dostup [id]");
    	if(!IsPlayerConnected(params[0])) return 1;
		SetPVarInt(playerid, "agetadm", params[0]);
  		string = ""WHITE"Параметр\t"WHITE"Значение\n";
	    format(stringer, sizeof(stringer), "{ffffff}/setstat\t%s\n", (!gAdminReason[params[0]][29])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
	    format(stringer, sizeof(stringer), "{ffffff}/makeadmin\t%s\n", (!gAdminReason[params[0]][36])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
        format(stringer, sizeof(stringer), "{ffffff}/makeleader\t%s\n", (!gAdminReason[params[0]][14])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}/makehelper\t%s\n", (!gAdminReason[params[0]][17])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}/ghetto\t%s\n", (!gAdminReason[params[0]][35])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
        format(stringer, sizeof(stringer), "{ffffff}/gzcolor\t%s\n", (!gAdminReason[params[0]][16])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}/kick\t%s\n", (!gAdminReason[params[0]][0])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}/ban\t%s\n", (!gAdminReason[params[0]][1])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
    	format(stringer, sizeof(stringer), "{ffffff}/warn\t%s\n", (!gAdminReason[params[0]][4])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
    	format(stringer, sizeof(stringer), "{ffffff}/banip /unbanip\t%s\n", (!gAdminReason[params[0]][7])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}/unwarn\t%s\n", (!gAdminReason[params[0]][8])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}/offwarn\t%s\n", (!gAdminReason[params[0]][9])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}/offban\t%s\n", (!gAdminReason[params[0]][10])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
     	format(stringer, sizeof(stringer), "{ffffff}/avig\t\t%s\n", (!gAdminReason[params[0]][24])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		format(stringer, sizeof(stringer), "{ffffff}/lvig\t\t%s\n", (!gAdminReason[params[0]][37])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
  		format(stringer, sizeof(stringer), "{ffffff}/offleader\t%s\n", (!gAdminReason[params[0]][34])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
  		format(stringer, sizeof(stringer), "{ffffff}/setprefix\t%s\n", (!gAdminReason[params[0]][33])?("{2CE40C}Включено") : ("{E40C0C}Отключено")), strcat(string, stringer);
		ShowPlayerDialog(playerid, 8747,DIALOG_STYLE_TABLIST_HEADERS, PI[params[0]][pNames], string, "Далее", "Отмена");
	}
	return 1;
}
cmd:unmark(playerid)
{
    if(!GetPVarFloat(playerid, "GPS_X")) return 1;
    DeletePVar(playerid, "GPS_X");
    DeletePVar(playerid, "GPS_Y");
    DeletePVar(playerid, "GPS_Z");
    RemovePlayerMapIcon(playerid, 80);
	return 1;
}
cmd:givebiz(playerid, params[])
{
	if(PI[playerid][pBusiness] == -1) return 1;
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, -1, ""#information"Введите /givebiz [id]");
	if(!IsPlayerConnected(params[0])) return ErrorMessage(playerid, "Игрок оффлайн!");
	if(GetPVarInt(params[0], "BusinessID") == PI[playerid][pBusiness]) return ErrorMessage(playerid, "У игрока уже есть Ваш пропуск!");
	else SetPVarInt(params[0], "BusinessID", PI[playerid][pBusiness]), SCMF(playerid, -1, ""#good"Вы выдали пропуск в офис игроку %s", PI[params[0]][pNames]), SCMF(params[0], -1, ""#information"%s выдал Вам пропуск в офис его бизнеса "SERVER"(%s)", PI[playerid][pNames], BizInfo[GetPVarInt(params[0], "BusinessID")][bName]);
	return 1;
}
cmd:break(playerid)
{
	if(!IsACop(playerid)) return ErrorMessage(playerid, "Вы не полицейский!");
    for ( new i = 0 ; i < MAX_ODGADA_TD ; i++ )
    {
        PlayerTextDrawShow (playerid, lawyers_fence [ playerid ] [ i ]);
    	SelectTextDraw(playerid, 0x00000033);
    }
    return 1;
}
cmd:autoyar(playerid, params[])
{
	if(PI[playerid][pHouse] == -1) return ErrorMessage(playerid, "У Вас нет дома!");
	if(!IsPlayerInAnyVehicle(playerid)) return ErrorMessage(playerid, "Вы не в автомобиле!");

	new car_slot = -1;
	if(VehicleEnters[playerid] == caridhouse[playerid][0]) car_slot = 0;
	else if(VehicleEnters[playerid] == caridhouse[playerid][1]) car_slot = 1;
	else if(VehicleEnters[playerid] == caridhouse[playerid][2]) car_slot = 2;
	if(car_slot == -1) return ErrorMessage(playerid, "Вы должны находится в домашнем автомобиле!");

	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, -1, ""#information"Используйте: /autoyar [сумма продажи]");
	if(params[0] < 100000 || params[0] > 30000000) return ErrorMessage(playerid, "Нельзя меньше 100.000$ и больше 30.000.000$");

	new sell_id = -1;
	for(new i; i < MAX_SELL; i ++)
	{
	    if(strcmp(SellingCar[i][sName], "None") != 0 || !PlayerToPoint(1.5, playerid, CoordSellCars[i][0], CoordSellCars[i][1], CoordSellCars[i][2])) continue;
		sell_id = i;
		break;
	}

	if(sell_id == -1) return ErrorMessage(playerid, "Вы не на месте автоярмарки/место занято");

	SellingCar[sell_id][sColor1] = VehInfo[VehicleEnters[playerid]][vColor1];
	SellingCar[sell_id][sColor2] = VehInfo[VehicleEnters[playerid]][vColor2];

	SellingCar[sell_id][sProbeg] = VehInfo[VehicleEnters[playerid]-1][vDrived];
	SellingCar[sell_id][sFueling] = VehInfo[VehicleEnters[playerid]][vFuel];
	strmid(SellingCar[sell_id][sName], PI[playerid][pNames], 0, strlen(PI[playerid][pNames]), 255);

	SellingCar[sell_id][sMoney] = params[0];
	SellingCar[sell_id][sCarID] = GetVehicleModel(VehicleEnters[playerid]);

	SellingCar[sell_id][sellCarStatus] = true;

    SellingCar[sell_id][sellVehicle] = CreateVehicle(SellingCar[sell_id][sCarID], CoordSellCars[sell_id][0], CoordSellCars[sell_id][1], CoordSellCars[sell_id][2], CoordSellCars[sell_id][3], SellingCar[sell_id][sColor1], SellingCar[sell_id][sColor2], 10000);

	VehInfo[SellingCar[sell_id][sellVehicle]-1][vDrived] = SellingCar[sell_id][sProbeg];
	VehInfo[SellingCar[sell_id][sellVehicle]][vFuel] = SellingCar[sell_id][sFueling];

	DestroyVehicle(caridhouse[playerid][car_slot]);
	PI[playerid][pRegNumber][car_slot] = 0;
    strmid(NumberVehicle[playerid][car_slot], "Транзит", 0, strlen("Транзит"), 255);
	UpdatePlayerData(playerid, (!car_slot) ? ("numberReg") : (car_slot==1) ? ("numberReg1") : ("numberReg2"), 0), UpdatePlayerDataEx(playerid, (!car_slot) ? ("numbercar") : (car_slot==1) ? ("numbercar1") : ("numbercar2"), "Транзит");
	caridhouse[playerid][car_slot] = 0;
	PI[playerid][pCar][car_slot] = 510;
	UpdatePlayerData(playerid, (!car_slot) ? ("pCar") : (car_slot==1) ? ("pCar2") : ("pCar3"), PI[playerid][pCar][car_slot]);


	Delete3DTextLabel(SellingCar[sell_id][sText]);
   	format(string, 300, ""SERVER"Место занято!\n"WHITE"Транспорт: "SERVER"%s\n"WHITE"Цена: "SERVER"%i$\n"WHITE"Владелец: "SERVER"%s", VehicleNames[SellingCar[sell_id][sCarID]-400], params[0], SellingCar[sell_id][sName]);
	SellingCar[sell_id][sText] = Create3DTextLabel(string, -1, CoordSellCars[sell_id][0], CoordSellCars[sell_id][1], CoordSellCars[sell_id][2], 15.0, 0, 1);

	mysql_format(1, string, 400, "UPDATE `autoyar` SET `sColor1` = '%i', `sColor2` = '%i', `sProbeg` = '%.0f', `sFueling` = '%.0f', `sName` = '%e', `sMoney` = '%i', `sCarID` = '%i', `sellCarStatus` = '1' WHERE `ID` = '%i'",
	SellingCar[sell_id][sColor1], SellingCar[sell_id][sColor2], SellingCar[sell_id][sProbeg], SellingCar[sell_id][sFueling], SellingCar[sell_id][sName], SellingCar[sell_id][sMoney], SellingCar[sell_id][sCarID], sell_id+1);
	mysql_tquery(1, string);
	return 1;
}
cmd:admins(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 1) && !PI[playerid][pDRInections]) return true;
	string = "";
	new countadm = 0, strings[3200];
	strcat(strings, ""SERVER"Должность\t"SERVER"Администратор\t"SERVER"Выговоры\t"SERVER"Репутация\n");
	foreach(Player, i)
	{
		if(IsPlayerNPC(i) || !GetAccessAdmin(i, 1)) continue;
		if(pTemp[i][pAFK] > AFK_SECOND)
		{
			if(!strcmp(PI[i][pPrefix], "0", true)) format(string, sizeof(string), "%s[%d]\t"WHITE"%s[%d]\t[Выговоры {ffae39}%i из 3"WHITE"]\t[Репутация: {ffae39}%i"WHITE"] [{FF0000}AFK"WHITE"]\n", PlayerAdmin[PI[i][pAdmin]-1], PI[i][pAdmin], PI[i][pNames], i, PI[i][pAvig], PI[i][pAdmReputation]);
			else format(string, sizeof(string), "%s[%d]\t"WHITE"%s[%d]\t[Выговоры {ffae39}%i из 3"WHITE"]\t[Репутация: {ffae39}%i"WHITE"] [{FF0000}AFK"WHITE"]\n", PI[i][pPrefix], PI[i][pAdmin], PI[i][pNames], i, PI[i][pAvig], PI[i][pAdmReputation]);
			strcat(strings, string);
            countadm++;
		}
		else
		{
			if(!strcmp(PI[i][pPrefix], "0", true)) format(string, sizeof(string), "%s[%d]\t"WHITE"%s[%d]\t[Выговоры {ffae39}%i из 3"WHITE"]\t[Репутация: {ffae39}%i"WHITE"]\n", PlayerAdmin[PI[i][pAdmin]-1], PI[i][pAdmin],PI[i][pNames], i, PI[i][pAvig], PI[i][pAdmReputation]);
			else format(string, sizeof(string), "%s[%d]\t"WHITE"%s[%d]\t\t[Выговоры {ffae39}%i из 3"WHITE"]\t[Репутация: {ffae39}%i"WHITE"]\n", PI[i][pPrefix], PI[i][pAdmin], PI[i][pNames], i, PI[i][pAvig], PI[i][pAdmReputation]);
			strcat(strings, string);
            countadm++;
		}
	}
	if(GetAccessAdmin(playerid, 1))
	{
	    SCMF(playerid, COLOR_SERVER, "Время администратирования за сегодня: "WHITE"%s", ConvertsCmdTime(pTemp[playerid][admPlayOnline]));
	    SCMF(playerid, COLOR_SERVER, "Ваша репутация: "WHITE"%i", PI[playerid][pAdmReputation]);
	}
	if(!strlen(string)) strcat(string, ""WHITE"Нету администрации в сети");
	new admcount[120]; format(admcount, sizeof admcount, ""WHITE"Администрация проекта {"#cGREEN"}(всего админов в сети: %i)",countadm);
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_TABLIST_HEADERS, admcount , strings, "Закрыть", "");
	return 1;
}
cmd:ainfoip(playerid)
{
	if(!GetAccessAdmin(playerid, 6))
		return true;
	foreach(Player, i)
	{
		if(!GetAccessAdmin(i, 1)) continue;
		SCMF(playerid, COLOR_GRAD1, ""SERVER"• "WHITE"%s[%d] | ADM LVL: %d | IP: %s | R-IP: %s", PI[i][pNames], i, PI[i][pAdmin], PI[i][pIP], PI[i][pIpReg]);
	}
	return 1;
}
cmd:play(playerid)
{
	if(GetPVarInt(playerid, "Radio")) return StopAudioStreamForPlayer(playerid), SendClientMessage(playerid, -1, ""#good"Вы выключили радио!"), DeletePVar(playerid, "Radio");
 	PlayAudioStreamForPlayer(playerid, "http://air.radiorecord.ru:8102/yo_320");
	SendClientMessage(playerid, -1, ""#good"Вы включили радио!");
	SetPVarInt(playerid, "Radio", true);
	return 1;
}
cmd:aleaders(playerid)
{
	if(GetAccessAdmin(playerid, 1)) return mysql_tquery(1, "SELECT * FROM  `accounts` WHERE  `pLeader` != 0 ORDER BY  `accounts`.`pLeader` DESC", "Leaders", "i", playerid);
	return 1;
}
cmd:hpanel(playerid)
{
	if(GetAccessAdmin(playerid, 1) || PI[playerid][pHelper]) return mysql_tquery(1, "SELECT * FROM  `accounts` WHERE  `pHelper` != 0 ORDER BY  `accounts`.`pHelper` DESC", "Helpers", "i", playerid);
	return 1;
}
cmd:leaders(playerid)
{
	SendClientMessage(playerid, COLOR_SERVER, "Лидеры в сети:");
	new b;
	foreach(Player, i)
	{
		if(PI[i][pLeader]<=0) continue;
		++b, SCMF(playerid, FI[PI[i][pLeader]][fColor], "{%s}%s - %s[%d]", GetFractionColor[PI[i][pMember]], FI[PI[i][pLeader]][fName], PI[i][pNames], i);
	}
	if(b) SCMF(playerid, COLOR_GREY, "В сети всего %d лидеров.", b);
	else SendClientMessage(playerid, COLOR_GREY, "Нету ни кого из лидеров в сети.");
	return 1;
}
cmd:subleaders(playerid)
{
	SendClientMessage(playerid, COLOR_SERVER, "Заместители в сети:");
	new b;
	foreach(Player, i)
	{
	    if(PI[i][pMember]<=0) continue;
	    if(rangFractionID[PI[i][pMember]-1]-1 != PI[i][pRank]) continue;
	    ++b, SCMF(playerid, FI[PI[i][pMember]][fColor], "{%s}%s - "WHITE"%s[%d]", GetFractionColor[PI[i][pMember]], FI[PI[i][pMember]][fName], PI[i][pNames], i);
	}
	if(b) SCMF(playerid, COLOR_GREY, "В сети всего %i заместителей.", b);
	else SendClientMessage(playerid, COLOR_GREY, "Нету никого из заместителей в сети.");
	return 1;
}
cmd:yes(playerid, params[])
{
	if(PI[playerid][pMember] != 16) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0])) return SendEsp(playerid, "/yes [id]");
	if(!IsPlayerConnected(params[0])) return 1;
	if(!PhoneCall{params[0]}) return SendClientMessage(playerid, COLOR_GRAD1, "Этот человек не звонил в студию!");
	if(params[0] == playerid) return ErrorMessage(playerid, "Вы указали свой ID");
	format(string, 64, "Вы приняли звонок от %s", PI[params[0]][pNames]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	SetPVarInt(params[0], "Tel", 1);
	SendClientMessage(params[0], COLOR_SERVER, "Вы попали в прямой эфир, вы можете говорить.");
	SetPVarInt(params[0], "TalkingLivels", 2);
	PI[params[0]][pBank] -= smspricels;
	UpdatePlayerData(params[0], "pBank", PI[playerid][pBank]);
	frac_money[16] += smspricels;
	return 1;
}
cmd:off(playerid, params[])
{
	if(PI[playerid][pMember] != 16) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0]))  return SendEsp(playerid, "/off [id]");
	if(!IsPlayerConnected(params[0])) return 1;
	if(!PhoneCall{params[0]}) return SendClientMessage(playerid, COLOR_GRAD1, "Этот человек не звонил в студию!");
	format(string, 64, "Вы завершили звонок от %s", PI[params[0]][pNames]);
	SendClientMessage(playerid, COLOR_BLUE, string);
	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_STOPUSECELLPHONE);
	SendClientMessage(params[0], COLOR_SERVER, "Звонок завершён...");
	PhoneCall{params[0]} = false;
	DeletePVar(params[0], "Tel");
	if(PI[params[0]][pMember] == 16) SetPVarInt(params[0], "TalkingLivels", 999);
	return 1;
}
cmd:call(playerid, params[])
{
	if(PI[playerid][pBank] <= 0)
	{
		ErrorMessage(playerid, "[0] Сумма на вашем счету не достаточна для совершения звонка");
		format(string, 64, "* %s набирает телефонный номер", PI[playerid][pNames]);
		ProxDetector(5.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
		return 1;
	}
	if(GetPVarInt(playerid, "gag")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас кляп, вы не можете говорить!");
	if(GetPVarInt(playerid, "takephone")) return SendClientMessage(playerid, COLOR_LIGHTRED, "У Вас нет телефона");

	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/call [номер]");
	format(string, 64, "* %s достаёт телефон", PI[playerid][pNames]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	if(params[0] == PI[playerid][pPnumber])
	{
		SendClientMessage(playerid, COLOR_GRAD2, "Линия занята");
		SetPlayerSpecialAction(playerid, 13);
		return 1;
	}

	foreach(Player, i)
	{
		if(params[0] == 11888)
		{
			if(!smsls) return ErrorMessage(playerid, "Прямой эфир отключен...");
			format(string, 64, "[Звонок] В студию звонит %s: Введите /yes [%d], чтобы ответить", PI[playerid][pNames], playerid);
			SendFractionMessage(16, COLOR_SERVER, string);
			SendClientMessage(playerid, COLOR_WHITE, "Чтобы повесить трубку введите /h");
			SetPlayerSpecialAction(playerid, 11);
			PhoneCall{playerid} = true;
			PI[playerid][pBank] -= smspricels;
			UpdatePlayerData(playerid, "pBank", PI[playerid][pBank]);
			frac_money[16] += smspricels;
			return 1;
		}
		if(GetPVarInt(i, "called")) return SendClientMessage(playerid, COLOR_GRAD2, "Вы уже разговариваете по телефону ");
		if(!IsPlayerConnected(i)) return 1;
  		if(PI[i][pPnumber] == params[0])
	    {
	        if(GetPVarInt(i, "called")) return ErrorMessage(playerid, "Абонент занят");
	        if(PhoneOnline{i}) return ErrorMessage(playerid, "Телефон абонента отключен");

	        format(string, 128, "Исходящий звонок | Номер: "WHITE"%i"SERVER" | Ожидание ответа от "WHITE"%s", PI[i][pPnumber], PI[i][pNames]);
	        SendClientMessage(playerid, COLOR_SERVER, string);

	        format(string, 128, "Входящий звонок | Номер: "WHITE"%i", PI[playerid][pPnumber]);
	        SendClientMessage(i, CBLUE, string);
	        SendClientMessage(i, -1, "Чтобы поднять трубку Используйте {"#cGREEN"}/p"WHITE" для завершения Используйте {"#cRED"}/h");

			SetPVarInt(playerid, "called", i+1);
			SetPVarInt(i, "called", playerid+1);

			MeAction(playerid, "достал(а) телефон");

			format(string, 144, "* У %s звонит телефон", PI[i][pNames]);
			ProxDetector(10.0, i, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);

			SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
			SetPlayerAttachedObject(playerid, 2, 18873, 6, 0.09, 0.019, -0.011, 88.90, -176.40, 0.49, 0.787, 0.753, 0.562);
	        return 1;
	    }
	}
	SendClientMessage(playerid, COLOR_GRAD2, "Вы ошиблись номером.");
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
	return 1;
}
cmd:house(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 4))
		return true;
	//if(gAdminReason[playerid][ADMIN_HOUSE]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/house [housenumber]");
	if(params[0] > MAX_HOUSE-1) return 1;
	lastPickupTime[playerid] = (unix + 5);
	SetPlayerPos(playerid, HouseInfo[params[0]][hEnter][0], HouseInfo[params[0]][hEnter][1], HouseInfo[params[0]][hEnter][2]);
	GameTextForPlayer(playerid, "~w~HOUSE", 5000, 1);
	return 1;
}
cmd:chat(playerid)
{
	if(!GetAccessAdmin(playerid, 5))
		return true;
	//if(gAdminReason[playerid][ADMIN_CHATS]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if (!BigEar[playerid]) BigEar[playerid] = true, SendClientMessage(playerid, COLOR_GRAD2, "Слушать чат ON");
	else if (BigEar[playerid]) BigEar[playerid] = false, SendClientMessage(playerid, COLOR_GRAD2, "Слушать чат OFF");
	return 1;
}
cmd:newsbank(playerid)
{
	if(PI[playerid][pMember] != 16) return 1;
	else if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вам необходимо начать рабочий день на базе организаций");
	SCMF(playerid, COLOR_SERVER, "В банке San News: %d вирт", frac_money[PI[playerid][pMember]]);
	return 1;
}
cmd:newswithdraw(playerid, params[])
{
	if(PI[playerid][pLeader] != 16 && PI[playerid][pRank] < 7) return 1;
	if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
	if(sscanf(params, "d", params[0]))  return SendClientMessage(playerid, COLOR_WHITE, ""#information"/newswithdraw [количество]");
	if(frac_money[16] <= 0) return ErrorMessage(playerid, "В банке San News нет денег");
	if(frac_money[16] < params[0]) return ErrorMessage(playerid, "В банке San News нет столько денег");
	if(params[0] < 1 || params[0] > 100000000) return ErrorMessage(playerid, "Неправильное количество денег!");
	frac_money[16] -= params[0];
	Hook_GivePlayerMoney(playerid, params[0]);
	SCMF(playerid, 0x6ab1ffaa, "Вы сняли с банка San News: %d вирт", params[0]);
	UpdateFractionStore(16);
	return 1;
}
cmd:mafiabalance(playerid)
{
	if(!ISAMAFIA(playerid)) return 1;
	SCMF(playerid, COLOR_SERVER, "В банке %s: %i$", FI[PI[playerid][pMember]][fName], frac_money[PI[playerid][pMember]]);
	return 1;
}
cmd:getgun(playerid)
{
	if(IsAArm(playerid))
	{
	    if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вам необходимо начать рабочий день на базе организаций");
		if(GetVehicleModel(VehicleEnters[playerid]) != 470) return ErrorMessage(playerid, "Вы не в Хаммере");
		if(frac_materials[PI[playerid][pMember]] < 500) return ErrorMessage(playerid, "На складе нет оружия");

		GivePlayerWeapon(playerid, 30, 100);
		SetPlayerArmourAC(playerid, 100);
		SetPlayerHealth(playerid, 100);
		frac_materials[PI[playerid][pMember]] -= 500;
		UpdateFractionStore(PI[playerid][pMember]);
		SetPlayerChatBubble(playerid, "взял оружие из багажника", 0xE75480FF, 30.0, 10000);
		SendClientMessage(playerid, COLOR_SERVER, "Вы достали из багажника: AK-47 (100), Бронижелет, Сухой паёк");
	}
	return 1;
}
cmd:balance(playerid)
{
	if(!GetAccessAdmin(playerid, 4))
		return true;
	SCMF(playerid, COLOR_WHITE, "Yakuza: %i$", frac_money[6]);
	SCMF(playerid, COLOR_WHITE, "Russian Mafia: %i$", frac_money[14]);
	SCMF(playerid, COLOR_WHITE, "LCN: %i$", frac_money[5]);
	SCMF(playerid, COLOR_WHITE, "Sa News: %i$", frac_money[16]);
	return 1;
}
cmd:warehouse(playerid)
{
	if(!PI[playerid][pMember]) return 1;

	SendClientMessage(playerid, 0xF0F0F0FF, "-======= Склад =======-");

	SCMF(playerid, 0xF0F0F0FF, "			Материалы: {FFC100}%d шт.", frac_materials[PI[playerid][pMember]]);

	SendClientMessage(playerid, 0xF0F0F0FF, "-=====================-");
	return 1;
}
alias:clearchat("cc");
cmd:clearchat(playerid)
{
	if(!GetAccessAdmin(playerid, 5))
		return true;
	for(new i = 0; i < 100; i++) SendClientMessageToAll(COLOR_GREY, " ");
	SendClientMessageToAll(COLOR_GREY, "Чат очищен администрацией!");
	format(string, 80, "Администратор %s очистил чат.", PI[playerid][pNames]);
	SendAdminMessage(COLOR_WARNING, string);
	return 1;
}
cmd:free(playerid, params[])
{
	if(PI[playerid][pMember] == 28) return 1;
	if(IsAMayor(playerid) && PI[playerid][pRank] >= 2)
	{
		if(!GetPVarInt(playerid, "StartRabWork")) return ErrorMessage(playerid, "Вы не начали рабочий день!");
		if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/free [id] [цена]");
		if(!IsPlayerConnected(params[0])) return 1;
		if(PI[params[0]][pJailTime]<=0) return ErrorMessage(playerid, "Человек не в тюрьме!");
		if(params[1] < 100 || params[1] > 50000) return ErrorMessage(playerid, "Цена не может быть меньше 100 и больше 50000!");
		if(params[0] == playerid)  return ErrorMessage(playerid, "Вы указали свой ID");
		string = "";
		format(string, 126, "[Адвокат] Вы предложили %s выпустить его из тюрьмы за %d вирт", PI[params[0]][pNames], params[1]);
		SendClientMessage(playerid, 0x6ab1ffaa, string);
		format(string, 126, "[Адвокат] %s предлагает Вам освободится из тюрьмы за %d вирт", PI[playerid][pNames], params[1]);
		SendClientMessage(params[0], 0x6ab1ffaa, string);
		ShowPlayerDialog(params[0], 6622, DIALOG_STYLE_MSGBOX, ""SERVER"Адвокатские услуги", ""WHITE"Выберите способ оплаты:", "Наличные", "Банк");
		SetPVarInt(params[0], "FreeOffer", playerid);
		SetPVarInt(params[0], "FreePrice", params[1]);
		DeletePVar(params[0], "SposobOffer");
	}
	return 1;
}
cmd:setskin(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 5))
		return true;
	if(sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/setskin [id игрока] [номер скина (1-299)]");
	if(params[1] > 311 || params[1] < 1) return ErrorMessage(playerid, "Неправильный ID скина!");
	if(params[1] == 74 || params[1] == 0) return 1;
	if(!IsPlayerConnected(params[0])) return 1;
	PI[params[0]][pChar] = params[1];
	UpdatePlayerData(params[0], "pChar", PI[params[0]][pChar]);
	format(string, 64, "Ваш скин был изменен администратором %s ", PI[playerid][pNames]);
	SendClientMessage(params[0], 0x6ab1ffaa, string);
	format(string, 64, "Вы изменили скин %s на номер: %d.", PI[params[0]][pNames], params[1]);
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	SetPlayerSkin(params[0], PI[params[0]][pChar]);
	return 1;
}
cmd:setmats(playerid, params[])
{
	if(!GetAccessAdmin(playerid, 11))
		return true;
	//if(gAdminReason[playerid][ADMIN_SETMATS]) return ErrorMessage(playerid, "У вас нету доступа к данной команде!");
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""#information"/setmats [количество]");
	for(new i = 1; i != 28; i ++) frac_materials[i] = params[0], UpdateFractionStore(i);
	SCMF(playerid, COLOR_SERVER, "Материалы всем фракциям успешно установлены. (%i)", params[0]);
	UpdateText(0), UpdateText(1); UpdateStoreGang(12); UpdateStoreGang(13); UpdateStoreGang(15); UpdateStoreGang(17); UpdateStoreGang(18);
	return 1;
}
publics: CookTawersName(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows) return ErrorMessage(playerid, "Данный ник занят!");
	ChangichName(playerid);
	return 1;
}
ChangichName(playerid)
{
	new name[24];
	GetPlayerName(playerid, PI[playerid][pNames], 24);
	mysql_real_escape_string(PI[playerid][pNames], name);
	string = "";
	mysql_format(1, string, MAX_STR, "UPDATE `accounts` SET `Name`='%e' WHERE `Name` = '%e'", WantNickChange[playerid], name);
	mysql_tquery(1, string);

	mysql_format(1, string, MAX_STR, "UPDATE `admin` SET `Name`='%s' WHERE `Name` = '%s'",WantNickChange[playerid], name);
	mysql_tquery(1, string);

	if(PI[playerid][pHouse] != -1) strmid(HouseInfo[PI[playerid][pHouse]][hOwner], WantNickChange[playerid], 0, strlen(WantNickChange[playerid]), 255), SaveHouse(PI[playerid][pHouse]);
	if(PI[playerid][pBusiness] != -1) strmid(BizInfo[PI[playerid][pBusiness]][bOwner], WantNickChange[playerid], 0, strlen(WantNickChange[playerid]), 255), SaveBusiness(PI[playerid][pBusiness]);
	if(PI[playerid][pFilling] != -1) strmid(Filling[PI[playerid][pFilling]][fOwner], WantNickChange[playerid], 0, strlen(WantNickChange[playerid]), 255), UpdateFuelInfoEx(playerid, "fOwner", Filling[PI[playerid][pFilling]][fOwner]);
	format(string, 128, "Игрок: %s сменил игровое Имя на %s", PI[playerid][pNames], WantNickChange[playerid]);
	SendClientMessageToAll(0xFF8000FF, string);
	SendClientMessage(playerid, COLOR_GREEN, "Пропишите новый ник в окне SA-MP, и продолжайте игру на сервере.");
	format(PI[playerid][pNames], 24, "%s", WantNickChange[playerid]);
	SetPlayerName(playerid, WantNickChange[playerid]);

	PI[playerid][pRubInfo] -= 20;
	UpdatePlayerData(playerid, "pRub", PI[playerid][pRubInfo]);
	PI[playerid][pRubDonateTotal][0] += 20;
	UpdatePlayerData(playerid, "pRubDonateTotal", PI[playerid][pRubDonateTotal][0]);

	new log_str[256 + 1];
	format(log_str, sizeof(log_str), "%s изменил игровое имя на %s", PI[playerid][pNames], WantNickChange[playerid]);
	logs(4, log_str, 20);

	KickEx(playerid);
	return 1;
}
IsTextInvalid(const text[])
{
	return (strfind(text, "none", true) != -1 || strfind(text, "None", true) != -1 || strfind(text, "NONE", true) != -1 || strfind(text, "'", true) != -1 || strfind(text, "/", true) != -1 ||
	strfind(text, "%", true) != -1 || strfind(text, ".", true) != -1 || strfind(text, "&", true) != -1 || strfind(text, "*", true) != -1 || strfind(text, "@", true) != -1 || strfind(text, "(", true) != -1 ||
	strfind(text, ")", true) != -1 || strfind(text, "`", true) != -1 || strfind(text, "[", true) != -1 || strfind(text, "]", true) != -1 || strfind(text, ", ", true) != -1 || strfind(text, ".ru", true) != -1 ||
	strfind(text, ".com", true) != -1 || strfind(text, "roleplay", true) != -1 || strfind(text, "loh", true) != -1 || strfind(text, "pidar", true) != -1 || strfind(text, "noob", true) != -1 ||
	strfind(text, "huita", true) != -1 || strfind(text, "gavno", true) != -1 || strfind(text, "Admina", true) != -1 || strfind(text, "Ebal", true) != -1 || strfind(text, "Mamky", true) != -1 || strfind(text, "Мамку", true) != -1 ||
	strfind(text, "[Fuck This Server]", true) != -1 || strfind(text, "ARPBAN", true) != -1 || strfind(text, "DRPFAKT", true) != -1 || strfind(text, "RolePlay", true) != -1 || strfind(text, "GRP", true) != -1) ? true : false;
}
Deleted(playerid)
{
	for(new i; i < 20; i++)
	{
	    if(i<13) TextDrawHideForPlayer(playerid, CounterSText[i]);
	    else if(i< 3) PlayerTextDrawDestroy(playerid, Bizwar[playerid][i]), PlayerTextDrawDestroy(playerid, PTD_AS[playerid][i]);
	}
	PlayerTextDrawDestroy(playerid, GrabText[playerid]);
	HideSpeedometer(playerid);
	DeletePVar(playerid, "PI_MP");
	PI_MP_START{playerid} = false;
}
