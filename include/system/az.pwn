CMD:aprav(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1) return ShowNotification(playerid, 2, "У Вас нет доступа к использованию данной команды", 7, "", "");

    new fmt_str[2000];

    format
	(
		fmt_str,sizeof fmt_str,
	    "{ffffff}Администраторам сервера запрещается:\n\
	    1. Ненормативная лексика в чат, а особенно в сторону игрока(ов) {FF6600}(Наказание: ВЫГОВОР!){ffffff} \n\
	    2. Угрозы игрокам: баном, мутом, киком, джайлом {FF6600}(Наказание: Выговор){ffffff} \n\
	    3. Банить/Кикать/Сажать игрока(ов) из личной неприязни {FF6600}(Наказание: Выговор){ffffff} \n\
	    4. Банить/Кикать/Сажать игрока(ов) не проследив за ним и не сделав фрапс {FF6600}(Наказание: Предепреждение/Выговор){ffffff} \n\
	    5. Выдавать игроку(ам) запрещённое оружие {ffffff}Исключение: разрешено на мп {FF6600}(Наказание: Выговор){ffffff} \n\
	    6. Игнорить репорт (сейчас не запрещено) {FF6600}(Наказание: Выговор){ffffff} \n\
	    7. Оскорбление других модераторов/администраторов {FF6600}(Наказание: Выговор){ffffff} \n\
	    8. Допускать мат/оффтоп/metagaming в /ad,/vipad,/s {FF6600}(Наказание: Выговор){ffffff} \n\
	    9. Позволять игрокам оскорбление других игроков и бездействовать при этом {FF6600}(Наказание: Выговор){ffffff} \n\
	    10. Просить повышение {ffffff}Примечание: более 5-ти раз {FF6600}(Наказание: Выговор){ffffff} \n\
	    11. Находиться АФК больше 30 минут {FF6600}(Наказание: Выговор){ffffff} \n\
	    12. Флуд или оффтоп в /a более 5-ти раз {FF6600}(Наказание: Выговор){ffffff} \n\
	    13. Флуд или оффтоп в КФ ВК {FF6600}(Наказание: Выговор){ffffff} \n\
	    14. Помеха другим администраторам. {FF6600}(Наказание: Выговор){ffffff} \n\
	    15. Реклама сторонних ресурсов{FF6600}(Наказание: Снятие с админки){ffffff} \n\
	    16. ТП или помеха основателям {FF6600}(Наказание: ВЫГОВОР/КИК!){ffffff} \n\
	    17. Блат кого-то из игроков {FF6600}(Наказание: Снятие с админки){ffffff} \n\
	    18. Использавание адм.в личных целях. В таких как тп из джайла если вас посадили{FF6600}(Наказание: Выговор/Бан 3 дня){ffffff} \n\
	    19. Помеха РП процессу {FF6600}(Наказание: Выговор){ffffff} \n\
	    20. Влезать в РП процесс {FF6600}(Наказание: Выговор){ffffff} \n\
	    21. Читерить {FF6600}(Наказание: Снятие с админки + Бан на 360 дней){ffffff}"
	);

    Dialog(playerid,INVALID_DIALOG_ID,DIALOG_STYLE_MSGBOX,"{65c8ff}Правила Администраторов:",fmt_str,"Принять","");
    return true;
}

CMD:anak(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1) return ShowNotification(playerid, 2, "У Вас нет доступа к использованию данной команды", 7, "", "");

	new fmt_str[2000];

    format
	(
		fmt_str,sizeof fmt_str,
		"{ffffff}Наказания для правонарушителей/игроков:\n\
	    1. Читы - {FF6600}(Наказание: Бан на 360 дней.) - {00CC33}(Команда - /bcheat){ffffff} \n\
	    2. Оффтоп в любой чат - {FF6600}(Наказание: Mute 10 минут.){ffffff} \n\
	    3. Metagaming - {FF6600}(Наказание: Mute 30 минут.) - {00CC33}(Команда - /mg){ffffff} \n\
	    4. Powergaming - {FF6600}(Наказание: Jail 30 минут.) - {00CC33}(Команда - /pg){ffffff} \n\
	    5. DM - {FF6600}(Наказание: Jail 60 минут.) - {00CC33}(Команда - /dm){ffffff} \n\
	    6. DB - {FF6600}(Наказание: Jail 60 минут.) - {00CC33}(Команда - /db){ffffff} \n\
	    7. Реклама сторонних ресурсов - {FF6600}(Наказание: Бан на 360 дней){ffffff} \n\
	    8. Багоюз/сбив амин - {FF6600}(Наказание: Jail 10 минут.){ffffff} \n\
	    9. Попрошайничество - {FF6600}(Наказание: Mute10 минут.){ffffff} \n\
	    10. Оскорбления игроков - {FF6600}(Наказание: Mute 30 минут.) - {00CC33}(Команда - /osk){ffffff} \n\
	    11. Оскорбления администраторов - {FF6600}(Наказание: Mute 180 минут) - {00CC33}(Команда - /oskadm){ffffff} \n\
	    12. Оскорбления родителей/родни игрока - {FF6600}(Наказание: Бан 15 дней) - {00CC33}(Команда - /oskrod){ffffff} \n\
	    13. Упоминание родителей/родни игрока - {FF6600}(Наказание: Mute 120 минут.) - {00CC33}(Команда - /ypomrod){ffffff} \n\
	    14. Мат в /ad, /vipad, /r, /d, /s, /me, обычный чат - {FF6600}(Наказание: Mute 10 минут.){ffffff} \n\
	    15. DM в ЗЗ - {FF6600}(Наказание: Warn или Jail 30 минут.){ffffff}\n\
	    16. Запрещено NonRP Drive или же епп  - {FF6600}(Наказание: Jail 30 минут.) - {00CC33}(Команда - /ndrive){ffffff} \n\
	    17. Срыв/помеха на Мероприятия/и - {FF6600}(Наказание: Jail 10 минут.){ffffff}"
	);

    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{65c8ff}Наказания для игроков | Команды:",fmt_str,"Принять","");
    return true;
}


