кидать в public OnPlayerLeaveDynamicCP
if(areaid == ahelp)
	{
		ShowNotification(playerid, 4, "Взаимодействовать", 3, "/ahelp", ">>");
	}
	
	CMD:ahelp(playerid)
{
  if(GetPlayerAdminEx(playerid) <1)
  return SendClientMessage(playerid, 0xFFFFFFFF, "{FF0000}| {FFFFFF}Доступно только {FFFF00}администрации сервера{FFFFFF}.");

  Dialog
  (
 	  playerid, DIALOG_AHELP, DIALOG_STYLE_LIST,
 	  "{FF6347}""SERVER_NAME"" {FFFFFF}| Помощь для администрации",
 	  "{FFFF00}| {FFFFFF}Команды администрации\n\
 	  {FFFF00}| {FFFFFF}Статистика администратора\n\
       {FFFF00}| {FFFFFF}Наказания для игроков\n\
       {FFFF00}| {FFFFFF}Правила администраторов\n\
 	  {FFFF00}| {FFFFFF}История наказаний",
 	  "Далее",
 	  "Закрыть"
  );
  return 1;
}
CMD:cmdadmtest(playerid, params[])
{
  if(GetPlayerAdminEx(playerid) == 1)
						 {
							Dialog
							(
							   playerid, 12201, DIALOG_STYLE_LIST,
							   "{FFFF00}| {FFFFFF}Команды {FFFF00}«Младшего модератора»",
							   "{FFFF00}/a {FFFFFF}- чат администрации\n\
	                           {FFFF00}/admins {FFFFFF}- администраторы в сети\n\
	                           {FFFF00}/sp {FFFFFF}- начать слежку за игроком\n\
	                           {FFFF00}/house {FFFFFF}- телепортироватся к дому\n\
	                           {FFFF00}/slap {FFFFFF}- подбросить игрока\n\
