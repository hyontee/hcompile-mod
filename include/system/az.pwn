}

CMD:cmdadmsok(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1) return ShowNotification(playerid, 2, "У Вас нет доступа к использованию данной команды", 7, "", "");

    new fmt_str[2000];

    format
	(
		fmt_str,sizeof fmt_str,
	    "{ffffff}Сокращенные команды администраторов:\n\
	     {FFFF00}/dm [ид игрока] {FFFFFF}— Посадить в деморган за Death Match (DM){ffffff} \n\
	     {FFFF00}/db [ид игрока] {FFFFFF}— Посадить в деморган за Drive By (DB){ffffff} \n\
	     {FFFF00}/rk [ид игрока] {FFFFFF}— Посадить в деморган за Revenge Kill (RK){ffffff} \n\
	     {FFFF00}/sk [ид игрока] {FFFFFF}— Посадить в деморган за Spawn Kill (SK){ffffff} \n\
	     {FFFF00}/pg [ид игрока]{FFFFFF}— Посадить в деморган за Power Gaming (PG){ffffff} \n\
	     {FFFF00}/ndrive [ид игрока] {FFFFFF}— Посадить в деморган за NonRP вождение{ffffff} \n\
	     {FFFF00}/mg [ид игрока] {FFFFFF}— Выдать блокировку чата за Meta Gaming (MG){ffffff} \n\
	     {FFFF00}/caps [ид игрока] {FFFFFF}— Выдать блокировку чата за CapsLock{ffffff} \n\
	     {FFFF00}/osk [ид игрока] {FFFFFF}— Выдать блокировку чата за Оскорбление игроков{ffffff} \n\
	     {FFFF00}/flood [ид игрока] {FFFFFF}— Выдать блокировку чата за Флуд{ffffff} \n\
	     {FFFF00}/oskadm [ид игрока] {FFFFFF}— Выдать блокировку чата за Оскорбление администрации{ffffff} \n\
	     {FFFF00}/ypomrod [ид игрока] {FFFFFF}— Выдать блокировку чата за Упоминание родни{ffffff} \n\
	     {FFFF00}/oskrod [ид игрока] {FFFFFF}— Выдать блокировку аккаунта за Оскорбление родни{ffffff} \n\
	     {FFFF00}/oskp [ид игрока] {FFFFFF}— Выдать блокировку аккаунта за Оскорбление проекта{ffffff} \n\
	     {FFFF00}/tk [ид игрока] {FFFFFF}— Посадить в деморган за Team Kill (TK){ffffff} \n\
	     {FFFF00}/nnick [ид игрока] {FFFFFF}— Выдать блокировку аккаунта за NonRP ник{ffffff} \n\
	     {FFFF00}/rpromo [ид игрока] {FFFFFF}— Выдать блокировку аккаунта за Рекламу промокода{ffffff}"
	);

    Dialog(playerid,INVALID_DIALOG_ID,DIALOG_STYLE_MSGBOX,"{FF6347}""SERVER_NAME"" {FFFFFF}| Сокращенные команды",fmt_str,"Принять","");
    return true;
}

