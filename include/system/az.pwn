CMD:cmdadm1(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1) return 1;

    new fmt_str[2000];

    format
	(
		fmt_str,sizeof fmt_str,
	    "{ffffff}Команды администратора {00CC33}1 уровня:{ffffff}\n\
	     {FFFF00}/admins {FFFFFF}— Администраторы в сети{ffffff} \n\
	     {FFFF00}/a {FFFFFF}— Чат администрации{ffffff} \n\
	     {FFFF00}/sp [id игрока] {FFFFFF}— Начать слежку за игроком{ffffff} \n\
	     {FFFF00}/house [номер дома] {FFFFFF}— Телепортироватся к дому{ffffff} \n\
	     {FFFF00}/slap [id игрока]{FFFFFF}— Подбросить игрока{ffffff} \n\
	     {FFFF00}/tp {FFFFFF}— Телепорт меню{ffffff} \n\
	     {FFFF00}/agm {FFFFFF}— Административное бессмертие{ffffff} \n\
	     {FFFF00}/flip {FFFFFF}— Починить транспорт в котором вы сидите{ffffff} \n\
	     {FFFF00}/az {FFFFFF}— Телепортироватся в Админ-зону{ffffff} \n\
	     {FFFF00}/askin {FFFFFF}— Надеть/снять скин администратора{ffffff}\n\
	     {FFFFFF}Если нужно кого-то из игроков наказать баном, мутом, джайлом, пишите в админ чат. Фрапс иметь {ffff00}обязательно!{ffffff}"
	);

    Dialog(playerid,INVALID_DIALOG_ID,DIALOG_STYLE_MSGBOX,"{FF6347}""SERVER_NAME"" {FFFFFF}| Команды администратора 1 уровня",fmt_str,"Принять","");
    return true;
}

