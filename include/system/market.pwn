// Binary search for a skin's catalogue entry by its model (skin) id.
// Returns the index into g_MarketSkinModel/.../g_MarketSkinName, or -1 if
// the model id is not a known outfit (falls back to a generic name).
stock MarketSkin_FindIndex(model_id)
{
    new low = 0, high = MARKET_SKIN_DB_COUNT - 1;
    while(low <= high)
    {
        new mid = (low + high) / 2;
        new value = g_MarketSkinModel[mid];
        if(value == model_id) return mid;
        if(value < model_id) low = mid + 1;
        else high = mid - 1;
    }
    return -1;
}

// Fills name[] with the real outfit name (e.g. "Ð¤Ð¸Ñ€Ð¼ÐµÐ½Ð½Ð°Ñ Ð¾Ð´ÐµÐ¶Ð´Ð°", "ÐŸÐ¾ÑÐµÐ¹Ð´Ð¾Ð½")
// for the given skin model id. Returns 1 on a known skin, 0 otherwise (name[]
// is left untouched so the caller can fall back to a generic label).
stock MarketSkin_GetName(model_id, name[], name_size)
{
    new index = MarketSkin_FindIndex(model_id);
    if(index == -1) return 0;
    format(name, name_size, "%s", g_MarketSkinName[index]);
    return 1;
}

// Returns 1 and sets rarity if the skin model id is known, 0 otherwise.
stock MarketSkin_GetRarity(model_id, &rarity)
{
    new index = MarketSkin_FindIndex(model_id);
    if(index == -1) return 0;
    rarity = g_MarketSkinRarity[index];
    return 1;
}
// --- end skin database ---

