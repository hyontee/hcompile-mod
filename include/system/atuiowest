// ============================================================================
// OnDialogResponse
// ============================================================================

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == DIALOG_LICENSE)
    {
        if(!response) return 1;
        
        switch(listitem)
        {
            case 0: // Получить права
            {
                if(g_PlayerTest[playerid])
                {
                    SCM(playerid, -1, "Вы уже сдаете экзамен!");
                    return 1;
                }
                
                new dialog[512];
                format(dialog, sizeof(dialog),
                    "Выберите категорию:\n"\
                    "Категория A - Мотоцикл (%d$)\n"\
                    "Категория B - Легковой (%d$)\n"\
                    "Категория D - Грузовой (%d$)",
                    GetLicensePrice(LICENSE_A),
                    GetLicensePrice(LICENSE_B),
                    GetLicensePrice(LICENSE_D)
                );
                
                ShowPlayerDialog(playerid, DIALOG_CATEGORY, DIALOG_STYLE_LIST, "Выбор категории", dialog, "Выбрать", "Назад");
            }
            
            case 1: // Мои права
            {
                new dialog[256];
                format(dialog, sizeof(dialog),
                    "Ваши права:\n\n"\
                    "Категория A: %s\n"\
                    "Категория B: %s\n"\
                    "Категория D: %s",
                    g_PlayerLicense[playerid][LICENSE_A] ? "{00FF00}Есть" : "{FF0000}Нет",
                    g_PlayerLicense[playerid][LICENSE_B] ? "{00FF00}Есть" : "{FF0000}Нет",
                    g_PlayerLicense[playerid][LICENSE_D] ? "{00FF00}Есть" : "{FF0000}Нет"
                );
                ShowPlayerDialog(playerid, DIALOG_RESULT, DIALOG_STYLE_MSGBOX, "Мои права", dialog, "ОК", "");
            }
            
            case 2: // Информация
            {
                new dialog[512];
                format(dialog, sizeof(dialog),
                    "{FFD700}Информация об автошколе\n\n"\
                    "Для получения прав нужно:\n"\
                    "1. Выбрать категорию\n"\
                    "2. Оплатить экзамен\n"\
                    "3. Ответить на 10 вопросов\n"\
                    "4. Нужно 70%% правильных ответов\n\n"\
                    "Категории:\n"\
                    "A - Мотоцикл (%d$)\n"\
                    "B - Легковой (%d$)\n"\
                    "D - Грузовой (%d$)\n\n"\
                    "Команда: /school - автошкола",
                    GetLicensePrice(LICENSE_A),
                    GetLicensePrice(LICENSE_B),
                    GetLicensePrice(LICENSE_D)
                );
                ShowPlayerDialog(playerid, DIALOG_RESULT, DIALOG_STYLE_MSGBOX, "Информация", dialog, "ОК", "");
            }
        }
        return 1;
    }
    
    if(dialogid == DIALOG_CATEGORY)
    {
        if(!response) 
        {
            cmd_school(playerid);
            return 1;
        }
        
        if(g_PlayerTest[playerid])
        {
            SCM(playerid, -1, "Вы уже сдаете экзамен!");
            return 1;
        }
        
        new category = listitem;
        new price = GetLicensePrice(category);
        
        // Проверка есть ли уже права
        if(g_PlayerLicense[playerid][category])
        {
            SCM(playerid, -1, "У вас уже есть права этой категории!");
            return 1;
        }
        
        // Проверка денег
        if(GetPlayerMoney(playerid) < price)
        {
            new msg[128];
            format(msg, sizeof(msg), "Недостаточно денег! Нужно %d$", price);
            SCM(playerid, -1, msg);
            return 1;
        }
        
        // Списываем деньги
        GivePlayerMoney(playerid, -price);
        
        g_PlayerCategory[playerid] = category;
        g_PlayerTest[playerid] = 1;
        g_PlayerQuestion[playerid] = 0;
        g_PlayerScore[playerid] = 0;
        
        // Генерируем вопросы
        GenerateTest(playerid);
        
        // Показываем первый вопрос
        ShowQuestion(playerid);
        
        return 1;
    }
    
    if(dialogid == DIALOG_THEORY)
    {
        if(!response)
        {
            // Выход из экзамена
            g_PlayerTest[playerid] = 0;
            SCM(playerid, -1, "Вы вышли из экзамена. Деньги не возвращаются.");
            return 1;
        }
        
        // Проверяем ответ
        new qid = g_TestQuestions[playerid][g_PlayerQuestion[playerid]];
        if(listitem == g_Questions[qid][5])
        {
            g_PlayerScore[playerid]++;
            SCM(playerid, -1, "{00FF00}Правильно! +1 балл");
        }
        else
        {
            new msg[128];
            format(msg, sizeof(msg), "{FF0000}Неправильно! Правильный ответ: %s", g_Questions[qid][listitem + 1]);
            SCM(playerid, -1, msg);
        }
        
        // Следующий вопрос
        g_PlayerQuestion[playerid]++;
        ShowQuestion(playerid);
        
        return 1;
    }
    
    return 0;
}

