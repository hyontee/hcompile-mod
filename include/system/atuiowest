// ============================================================================
// ФУНКЦИИ
// ============================================================================

// Проверка наличия прав
stock HasLicense(playerid, category)
{
    return g_PlayerLicense[playerid][category] == 1;
}

// Получение названия категории
stock GetCategoryName(category)
{
    switch(category)
    {
        case LICENSE_A: return "A (Мотоцикл)";
        case LICENSE_B: return "B (Легковой)";
        case LICENSE_D: return "D (Грузовой)";
    }
    return "Неизвестно";
}

// Получение модели авто для экзамена
stock GetExamVehicle(category)
{
    switch(category)
    {
        case LICENSE_A: return 481; // BMX (заменить на мотоцикл)
        case LICENSE_B: return 445; // Admiral
        case LICENSE_D: return 403; // Linerunner
    }
    return 445;
}

// Получение цен
stock GetLicensePrice(category)
{
    switch(category)
    {
        case LICENSE_A: return 5000;
        case LICENSE_B: return 10000;
        case LICENSE_D: return 15000;
    }
    return 10000;
}

// ============================================================================
// ТЕСТИРОВАНИЕ
// ============================================================================

// Генерация 10 случайных вопросов
stock GenerateTest(playerid)
{
    new used[MAX_QUESTIONS];
    new count = 0;
    
    while(count < 10)
    {
        new qid = random(MAX_QUESTIONS);
        if(!used[qid])
        {
            used[qid] = 1;
            g_TestQuestions[playerid][count] = qid;
            count++;
        }
    }
}

// Показать вопрос
stock ShowQuestion(playerid)
{
    if(g_PlayerQuestion[playerid] >= 10)
    {
        // Тест закончен
        if(g_PlayerScore[playerid] >= 7) // 70% правильных
        {
            // Выдаем права
            g_PlayerLicense[playerid][g_PlayerCategory[playerid]] = 1;
            
            new msg[128];
            format(msg, sizeof(msg), "Поздравляем! Вы сдали экзамен на категорию %s!", GetCategoryName(g_PlayerCategory[playerid]));
            SCM(playerid, -1, msg);
            
            // Даем премию
            new reward = GetLicensePrice(g_PlayerCategory[playerid]) * 2;
            GivePlayerMoney(playerid, reward);
            
            format(msg, sizeof(msg), "Вы получили награду: %d$", reward);
            SCM(playerid, -1, msg);
            
            SCM(playerid, -1, "Права выданы! Используйте /licenses для просмотра.");
            
            // Сохраняем
            SaveLicense(playerid);
        }
        else
        {
            SCM(playerid, -1, "Вы не сдали экзамен. Нужно 70% правильных ответов.");
            SCM(playerid, -1, "Попробуйте снова через 5 минут.");
            
            // Штраф
            GivePlayerMoney(playerid, -500);
        }
        
        g_PlayerTest[playerid] = 0;
        return;
    }
    
    new qid = g_TestQuestions[playerid][g_PlayerQuestion[playerid]];
    new dialog[512];
    
    format(dialog, sizeof(dialog),
        "Вопрос %d/10\n\n{FFFFFF}%s\n\n{FFB6C1}1. %s\n{87CEEB}2. %s\n{98FB98}3. %s\n{FFD700}4. %s",
        g_PlayerQuestion[playerid] + 1,
        g_Questions[qid][0],
        g_Questions[qid][1],
        g_Questions[qid][2],
        g_Questions[qid][3],
        g_Questions[qid][4]
    );
    
    ShowPlayerDialog(playerid, DIALOG_THEORY, DIALOG_STYLE_LIST, "Экзамен ПДД", dialog, "Выбрать", "Выход");
}

// Сохранение прав
stock SaveLicense(playerid)
{
    // Здесь можно сохранять в БД если есть
    printf("[LICENSE] Игрок %d получил права", playerid);
    return 1;
}

