/*

	Component type functions

*/



stock GetVehicleComponentTypeId(const name[])

{

	for (new i = 0; i < sizeof(gComponentType); i++) {

		if (strcmp(gComponentType[i], name, true) == 0) {

			return i;

		}

	}



	return ZVEH_INVALID_COMPONENT_ID;

}



stock GetVehicleComponentTypeName(type, name[], size = sizeof(name))

{

	if (type < 0 || type >= sizeof(gComponentType)) {

		return 0;

	}



	return strunpack(name, gComponentType[type], size);

}



stock GetVehicleCompatibleTypes(model, array[ZVEH_MAX_COMPONENT_TYPES], &array_size)

{

	new

		components[ZVEH_MAX_COMPONENTS],

		components_size;



	new isok = GetVehicleCompatibleUpgrades(model, components, components_size);

	if (!isok) {

		return 0;

	}



	new

		type_id,

		bool:is_type_exist[ZVEH_MAX_COMPONENT_TYPES];



	array_size = 0;



	for (new i = 0; i < components_size; i++) {

		type_id = GetVehicleComponentType(components[i]);



		if (!is_type_exist[type_id]) {

			is_type_exist[type_id] = true;



			array[array_size++] = type_id;

		}

	}



	return 1;

}



/*

	Component upgrade functions

*/




stock GetVehicleCompatibleUpgrades(model, array[ZVEH_MAX_COMPONENTS], &array_size)

{

	if (!(400 <= model <= 611)) {

		return 0;

	}



	new

		index;



	index = model - 400;

	array_size = 0;



	for (new i = 0; i < ZVEH_MAX_COMPONENTS; i++) {

		if (gComponents[index]{i} == ZVEH_INVALID_COMPONENT_ID) {

			break;

		}



		array[array_size++] = gComponents[index]{i} + 1000;

	}



	return 1;

}



stock IsVehicleUpgradeCompatible(model, componentid)

{

	if (!(400 <= model <= 611)) {

		return 0;

	}



	new

		index,

		component_value;



	index = model - 400;

	component_value = componentid - 1000;



	for (new i = 0; i < ZVEH_MAX_COMPONENTS; i++) {

		if (gComponents[index]{i} == ZVEH_INVALID_COMPONENT_ID) {

			return 0;

		}



		if (gComponents[index]{i} == component_value) {

			return 1;

		}

	}



	return 0;

}



stock IsVehicleHaveUpgrades(model)
{
	if (!(400 <= model <= 611)) 
	{
		return 0;
	}
	return gComponents[model - 400]{0} == ZVEH_INVALID_COMPONENT_ID;
}



stock GetTypeModelComponent(playerid, MODEL, CAR_MODE)
{
	new COMPONENTS_SIZE;
	new COMPONENTS[ZVEH_MAX_COMPONENTS];
	GetVehicleCompatibleUpgrades(MODEL, COMPONENTS, COMPONENTS_SIZE);

	for(new i = 0; i != ZVEH_MAX_COMPONENTS; i ++)
	{
		if(i == 0)
		{
			TUNING_DATA[playerid][SIDESKIRT_COUNT] = -1;
			TUNING_DATA[playerid][SPOILER_COUNT] = -1;
			TUNING_DATA[playerid][EXHAUST_COUNT] = -1;
			TUNING_DATA[playerid][PBUMPER_COUNT] = -1;
			TUNING_DATA[playerid][ZBUMPER_COUNT] = -1;
		}
		TUNING_DATA[playerid][SPOILER][i] = 0;
		TUNING_DATA[playerid][SIDESKIRT][i] = 0;
		TUNING_DATA[playerid][EXHAUST][i] = 0;
		TUNING_DATA[playerid][PBUMPER][i] = 0;
		TUNING_DATA[playerid][ZBUMPER][i] = 0;
	}
	new REASON_COUNT = 0;
	for(new i = 0; i < COMPONENTS_SIZE; i++) 
	{
		if(CAR_MODE == GetVehicleComponentType(COMPONENTS[i]) && IsVehicleUpgradeCompatible(MODEL, COMPONENTS[i]) == 1) 
		{
			if(MODEL == 558)
			{
				if(COMPONENTS[i] == 1090) continue;
				if(COMPONENTS[i] == 1095) continue;
			}
			if(MODEL == 559)
			{
				if(COMPONENTS[i] == 1007) continue;
				if(COMPONENTS[i] == 1017) continue;
				if(COMPONENTS[i] == 1065) continue;
				if(COMPONENTS[i] == 1066) continue;
				if(COMPONENTS[i] == 1069) continue;
				if(COMPONENTS[i] == 1070) continue;
				if(COMPONENTS[i] == 1071) continue;
				if(COMPONENTS[i] == 1072) continue;
				if(COMPONENTS[i] == 1158) continue;
				if(COMPONENTS[i] == 1161) continue;
				if(COMPONENTS[i] == 1162) continue;
				if(COMPONENTS[i] == 1173) continue;
			}
			if(MODEL == 560)
			{	
				if(COMPONENTS[i] == 1007) continue;
				if(COMPONENTS[i] == 1017) continue;	
				if(COMPONENTS[i] == 1026) continue; 
				if(COMPONENTS[i] == 1029) continue;
				if(COMPONENTS[i] == 1031) continue;		
			}
			if(MODEL == 561)
			{
				if(COMPONENTS[i] == 1026) continue;
				if(COMPONENTS[i] == 1027) continue;	
				if(COMPONENTS[i] == 1030) continue;
				if(COMPONENTS[i] == 1031) continue;	
				if(COMPONENTS[i] == 1056) continue;
				if(COMPONENTS[i] == 1057) continue;	
			}
			if(MODEL == 562)
			{	
				if(COMPONENTS[i] == 1035) continue;
				if(COMPONENTS[i] == 1036) continue;		
				if(COMPONENTS[i] == 1041) continue;						
			}
			if(MODEL == 565)
			{	
				if(COMPONENTS[i] == 1047) continue;
				if(COMPONENTS[i] == 1048) continue;			
			}

			SendMes(playerid, -1, "COMPONENTS %d", COMPONENTS[i]);
			switch(CAR_MODE)
			{
				case CARMODTYPE_SPOILER:
				{
					TUNING_DATA[playerid][SPOILER][REASON_COUNT] = COMPONENTS[i];
					TUNING_DATA[playerid][SPOILER_COUNT] = REASON_COUNT;
				}
				case CARMODTYPE_SIDESKIRT:
				{
					TUNING_DATA[playerid][SIDESKIRT][REASON_COUNT] = COMPONENTS[i];
					TUNING_DATA[playerid][SIDESKIRT_COUNT] = REASON_COUNT;
				}
				case CARMODTYPE_EXHAUST:
				{
					TUNING_DATA[playerid][EXHAUST][REASON_COUNT] = COMPONENTS[i];
					TUNING_DATA[playerid][EXHAUST_COUNT] = REASON_COUNT;
				}
				case CARMODTYPE_FRONT_BUMPER:
				{
					TUNING_DATA[playerid][PBUMPER][REASON_COUNT] = COMPONENTS[i];
					TUNING_DATA[playerid][PBUMPER_COUNT] = REASON_COUNT;
				}
				case CARMODTYPE_REAR_BUMPER:
				{
					TUNING_DATA[playerid][ZBUMPER][REASON_COUNT] = COMPONENTS[i];
					TUNING_DATA[playerid][ZBUMPER_COUNT] = REASON_COUNT;
				}
			}
			REASON_COUNT += 1;
		}
	}
	return 0x1;
}
