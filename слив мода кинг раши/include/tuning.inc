stock GetUsedComponent(playerid, componentid)
{
	new reason = 0;
	for(new i = 0; i < 14; i++) 
	{
		if(C_DATA[playerid][c_vehcoms][i] == componentid && C_DATA[playerid][c_vehcoms][i] != 0)
		{
			reason = 1;
			break;
		}
	}
	return reason;
}
