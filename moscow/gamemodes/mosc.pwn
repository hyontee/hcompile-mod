stock TuneGui_OpenInput(playerid, dialogid, title[], text[], actionid)
{
    SetPVarInt(playerid, "tune_gui_action", actionid);
    Dialog(playerid, dialogid, DIALOG_STYLE_INPUT, title, text, "рименит", "азад");
    return 1;
}

stock TuneGui_ShowStyleMenu(playerid)
{
    if(BT_GetTuneVehicle(playerid) == INVALID_VEHICLE_ID) return 1;

    Dialog(playerid, DIALOG_TUNE_GUI_STYLE, DIALOG_STYLE_LIST,
        "{FFCD00}тайлинг-центр",
        "вет кузова и дисков\nонировка (4 стекла)\nвет фар\nодсветка (неон)\nинил\nтробоскоп\nомерной знак",
        "брат", "акрт");
    return 1;
}

stock TuneGui_ShowTechMenu(playerid)
{
    if(BT_GetTuneVehicle(playerid) == INVALID_VEHICLE_ID) return 1;

    Dialog(playerid, DIALOG_TUNE_GUI_TECH, DIALOG_STYLE_LIST,
        "{FFCD00}ехнический центр",
        "ип-тюнинг\nвук вхлопа\nвук сигнала\nидравлика\nHighLight\nип launch-control\nип сирен\nкл/вкл сирену",
        "брат", "акрт");
    return 1;
}

stock TuneGui_ShowWheelsMenu(playerid)
{
    if(BT_GetTuneVehicle(playerid) == INVALID_VEHICLE_ID) return 1;

    Dialog(playerid, DIALOG_TUNE_GUI_WHEELS, DIALOG_STYLE_LIST,
        "{FFCD00}иномонтаж",
        "олнй клиренс\nндивидуалнй клиренс\nадиус колес\nазвал колес\nлет колес\nирина колес",
        "брат", "акрт");
    return 1;
}

stock TuneGui_ShowSTOMenu(playerid)
{
    if(BT_GetTuneVehicle(playerid) == INVALID_VEHICLE_ID) return 1;

    Dialog(playerid, DIALOG_TUNE_GUI_STO, DIALOG_STYLE_LIST,
        "{FFCD00}",
        "иагностика\nолнй ремонт\nбновит данне спидометра\nброс подвески в базу\nостоние сирен (0/1)",
        "брат", "акрт");
    return 1;
}

stock Gordeev_OpenTuningCenter(playerid, center)
{
    switch(center)

    {
        case GORDEEV_TUNING_CENTER_STAIL: return TuneGui_ShowStyleMenu(playerid);
        case GORDEEV_TUNING_CENTER_TEX: return TuneGui_ShowTechMenu(playerid);
        case GORDEEV_TUNING_CENTER_SHINKA: return TuneGui_ShowWheelsMenu(playerid);
        case GORDEEV_TUNING_CENTER_STO: return TuneGui_ShowSTOMenu(playerid);
    }

    return 1;
}

CMD:stail(playerid, params[])
{
    #pragma unused params
    return Gordeev_OpenTuningCenter(playerid, GORDEEV_TUNING_CENTER_STAIL);
}

CMD:tex(playerid, params[])
{
    #pragma unused params
    return Gordeev_OpenTuningCenter(playerid, GORDEEV_TUNING_CENTER_TEX);
}

CMD:shinka(playerid, params[])
{
    #pragma unused params
    return Gordeev_OpenTuningCenter(playerid, GORDEEV_TUNING_CENTER_SHINKA);
}

CMD:stoooo(playerid, params[])
{
    #pragma unused params
    return Gordeev_OpenTuningCenter(playerid, GORDEEV_TUNING_CENTER_STO);
}
stock IsAFamilyCar(vehicleid)
{
    if(IsValidVehicleID(vehicleid))
    {
        if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
        {
            return 1;
        }
    }
    return 0;
}
stock RestoreOwnableCarColor(vehicleid)
{
    if(IsAOwnableCar(vehicleid))
    {
        new index = GetVehicleData(vehicleid, V_ACTION_ID);
        if(index != -1 && GetOwnableCarData(index, OC_SQL_ID) > 0)
        {
            new color1 = GetOwnableCarData(index, OC_COLOR_1);
            new color2 = GetOwnableCarData(index, OC_COLOR_2);
            if(color1 == -1 || color1 == 0) color1 = 1;
            if(color2 == -1 || color2 == 0) color2 = 1;
            ChangeVehicleColor(vehicleid, color1, color2);
            return 1;
        }
    }
    return 0;
}
stock RestoreFamilyCarColor(vehicleid)
{
    if(IsAFamilyCar(vehicleid))
    {
        new index = GetVehicleData(vehicleid, V_ACTION_ID);
        if(index != -1 && GetFamilyCarData(index, F_SQL_ID) > 0)
        {
            new color1 = GetFamilyCarData(index, F_COLOR_1);
            new color2 = GetFamilyCarData(index, F_COLOR_2);
            if(color1 == -1 || color1 == 0) color1 = 1;
            if(color2 == -1 || color2 == 0) color2 = 1;
            ChangeVehicleColor(vehicleid, color1, color2);
            return 1;
        }
    }
    return 0;
}
CMD:setfamilycar(playerid)
{
    if(GetPlayerIdFamily(playerid) != -1 && GetPlayerRangFamily(playerid) == 5)
    {
        ViewFamilyCar(playerid);
    }
    return 1;
}



CMD:fpark(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, " должн находитс в транспорте");
    
    new vehicleid = GetPlayerVehicleID(playerid);
    new action_id = GetVehicleData(vehicleid, V_ACTION_ID);
    new player_fam_sql = GetPlayerFamily(playerid, ID_SQL_FAMILY);
    
    if(player_fam_sql <= 0 || g_family_car[action_id][F_OWNER_ID] != player_fam_sql)
        return SendClientMessage(playerid, 0xCECECEFF, " должн находитс в транспорте семи");
    
    new query[256];
    new Float: veh_x, Float: veh_y, Float: veh_z, Float: veh_angle;
    
    GetVehiclePos(vehicleid, veh_x, veh_y, veh_z);
    GetVehicleZAngle(vehicleid, veh_angle);
    
    // бновлем данне в памти сервера
    SetFamilyCarData(action_id, F_POS_X, veh_x);
    SetFamilyCarData(action_id, F_POS_Y, veh_y);
    SetFamilyCarData(action_id, F_POS_Z, veh_z);
    SetFamilyCarData(action_id, F_ANGLE, veh_angle);
    
    // охранем в  (family_auto, %f дл координат!)
    mysql_format(mysql, query, sizeof query, 
        "UPDATE family_auto SET pos_x=%f, pos_y=%f, pos_z=%f, angle=%f WHERE id=%d LIMIT 1", 
        veh_x, veh_y, veh_z, veh_angle, GetFamilyCarData(action_id, F_SQL_ID));
    mysql_query(mysql, query, false);
    
    SaveFamilyCar(vehicleid);
    SendClientMessage(playerid, 0x66CC00FF, "ранспорт семи припаркован");
    return 1;
}

CMD:fparkk(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, " должн находитс в транспорте");

    new vehicleid = GetPlayerVehicleID(playerid);
    new action_id = GetVehicleData(vehicleid, V_ACTION_ID);

    if(g_family_car[action_id][F_OWNER_ID] != GetPlayerIdFamily(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, " должн находитс в транспорте семи");

	new green_zone_id = GetPVarInt(playerid, "player_in_green_zone") - 1;

	if(green_zone_id != -1)
	{
		if(!g_green_zones[green_zone_id][GZ_ALLOW_PARK])
		{
			new fmt_text[144];

			format(fmt_text, sizeof fmt_text, "а территории {FFFF00}'%s' {1E90FF}парковка личного транспорта запрещена. берите другое место дл парковки", g_green_zones[green_zone_id][GZ_NAME]);
			SendClientMessage(playerid, 0x1E90FFFF, fmt_text);

			return 1;
		}
	}

	new index = GetVehicleData(vehicleid, V_ACTION_ID);

	GetVehiclePos(vehicleid, GetFamilyCarData(index, F_POS_X), GetFamilyCarData(index, F_POS_Y), GetFamilyCarData(index, F_POS_Z));
	GetVehicleZAngle(vehicleid, GetFamilyCarData(index, F_ANGLE));

//	SetOwnableCarData(index, OC_World, GetPlayerVirtualWorld(playerid));

//	SetOwnableCarData(index, OC_Int, GetPlayerInterior(playerid));

	SaveFamilyCar(vehicleid);
	return SendClientMessage(playerid, 0x66CC00FF, "ранспорт семи припаркован");
}

stock ViewFamilyCar(playerid)
{
    new fmt_text[640], id, Cache: result;
    mysql_format(mysql, fmt_text, sizeof fmt_text, "SELECT * FROM `family_auto` WHERE owner_id='%d'", GetPlayerIdFamily(playerid));
    result = mysql_query(mysql, fmt_text, true);

    new rows = cache_num_rows();

    if(!rows)
        SendClientMessage(playerid, 0x999999FF, " ашей семи нет транспорта");

    else
    {
        new query[60],
            model_id,
            rang;

        format(fmt_text, sizeof fmt_text, "");

        for(new i = 0; i < rows; i ++)
        {
            id = cache_get_field_content_int(i, "id");
            model_id = cache_get_field_content_int(i, "model_id") - 400;
            rang = cache_get_field_content_int(i, "rang");

            format(query, sizeof query, "{FFFFFF}%d. %s {888888}\tоступ с %d ранга\n", i + 1, GetVehicleInfo(model_id, VI_NAME), rang);
            strcat(fmt_text, query);
            SetPVarInt(playerid, "sql_id", id);
            SetPlayerListitemValue(playerid, i, id);
        }

        Dialog
        (
            playerid, DIALOG_FAMILY_CAR_RANG, DIALOG_STYLE_LIST,
            "{FFCD00}ранспорт семи",
            fmt_text,
            "брат", "акрт"
        );
    }
    cache_delete(result);
    return 1;
}

