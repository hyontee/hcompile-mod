alias:vopros("ask")

CMD:define(playerid)
{
	new string[1500], null = 0;
	if(GetPlayerAdminEx(playerid) > 0) {
		foreach(new i:Player)
		{
			if(GetPVarInt(i, "RepUn") > 0)
			{
				null++;
				format(string, sizeof(string), "%s\n{FFFFFF}%i. %s[%d] | алоба: %s [%s]", string, null, GetPlayerNameEx(i),i,RepInfo[i][Reptex], date("%hh:%ii:%ss", RepInfo[i][RepTime]));
			}
		}
		strcat(string, "\n\n{FFCC00}тветит на жалобу: /pm [id] [ответ]");
		if(null == 0) return SendClientMessage(playerid, 0xAA3333AA,"писок репортов пуст");
		Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "епорт",string, "бновит", "акрт");
	} else if(GetPlayerHelperEx(playerid) > 0) {
		foreach(new i:Player)
		{
			if(GetPVarInt(i, "AskUn") > 0)
			{
				null++;
				format(string, sizeof(string), "%s\n{FFFFFF}%i. %s[%d] | опрос: %s [%s]", string, null, GetPlayerNameEx(i),i,AskInfo[i][Asktex], date("%hh:%ii:%ss", AskInfo[i][AskTime]));
			}
		}
		strcat(string, "\n\n{FFCC00}тветит на вопрос: /pm [id] [ответ]");
		if(null == 0) return SendClientMessage(playerid, 0xAA3333AA,"писок репортов пуст");
		Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_LIST, "епорт",string, "бновит", "акрт");
	}
	return 1;
}

