			case 29500: // ова ставка
{
    if(!response)
    {
        DeletePVar(playerid, "buy_biz_auction_id");
        return 1;
    }
    
    new biz_id = GetPVarInt(playerid, "buy_biz_auction_id");
    DeletePVar(playerid, "buy_biz_auction_id");
    
    if(biz_id < 0 || biz_id >= g_business_loaded)
        return SendClientMessage(playerid, 0x999999FF, "изнес болше не существует!");
    
    if(IsBusinessOwned(biz_id))
        return SendClientMessage(playerid, 0xFF6600FF, "аннй бизнес уже во владении!");
    
    if(g_BizAuctionActive[biz_id])
        return SendClientMessage(playerid, 0xCECECEFF, "а этот бизнес уже идет аукцион! сползуйте /buybiz дл перебити.");
    
    new bid = strval(inputtext);
    new min_price = GetBusinessData(biz_id, B_PRICE);
    
    if(bid < min_price)
    {
        new fmt_msg[128];
        format(fmt_msg, sizeof fmt_msg, ""USC"тавка должна бт не менше {FFFF00}%d {FFFFFF}рублей!", min_price);
        SendClientMessage(playerid, 0xFF6600FF, fmt_msg);
        callcmd::buybiz(playerid, "");
        return 1;
    }
    
    // ===== Я  =====
    if(GetPlayerMoneyEx(playerid) < bid)
    {
        new fmt_msg[128];
        format(fmt_msg, sizeof fmt_msg, ""USC" вас недостаточно денег дл ставки! ужно: {FFFF00}%d {FFFFFF}рублей", bid);
        SendClientMessage(playerid, 0xFF6600FF, fmt_msg);
        callcmd::buybiz(playerid, "");
        return 1;
    }
    
    // =====    () =====
    GivePlayerMoneyEx(playerid, -bid, "тавка на бизнес (заморожена)", true, true);
    SetPVarInt(playerid, "biz_auction_money", bid);
    
    // апускаем аукцион
    g_BizAuctionActive[biz_id] = true;
    g_BizAuctionPrice[biz_id] = bid;
    g_BizAuctionBidder[biz_id] = playerid;
    g_BizAuctionTime[biz_id] = gettime() + 30;
    
    g_BizAuctionTimer[biz_id] = SetTimerEx("OnBizAuctionEnd", 30000, false, "i", biz_id);
    
    new biz_name[64];
    format(biz_name, sizeof(biz_name), "%s №%d", GetBusinessData(biz_id, B_NAME), biz_id + 1);
    
    new fmt_msg[128];
    format(fmt_msg, sizeof fmt_msg, "{FFFFFF} поставили ставку на покупку {FFFF00}%s {FFFFFF}в размере {FFFF00}%d {FFFFFF}рублей!", biz_name, bid);
    SendClientMessage(playerid, 0x66CC33FF, fmt_msg);
    
    format(fmt_msg, sizeof fmt_msg, "{FFFF00}%s[%d] {FFFFFF}поставил ставку {FFFF00}%d {FFFFFF}рублей на бизнес {FFFF00}%s!",
        GetPlayerNameEx(playerid), playerid, bid, biz_name);
    SendClientMessageToAll(0xFFFF00FF, fmt_msg);
    
    return 1;
}

case 29501: // еребит ставку
{
    if(!response)
    {
        DeletePVar(playerid, "buy_biz_auction_id");
        return 1;
    }
    
    new biz_id = GetPVarInt(playerid, "buy_biz_auction_id");
    DeletePVar(playerid, "buy_biz_auction_id");
    
    if(biz_id < 0 || biz_id >= g_business_loaded)
        return SendClientMessage(playerid, 0x999999FF, "изнес болше не существует!");
    
    if(IsBusinessOwned(biz_id))
        return SendClientMessage(playerid, 0xFF6600FF, "аннй бизнес уже во владении!");
    
    if(!g_BizAuctionActive[biz_id])
        return SendClientMessage(playerid, 0xCECECEFF, "укцион на этот бизнес уже завершен!");
    
    if(GetPlayerAccountID(playerid) == g_BizAuctionBidder[biz_id])
        return SendClientMessage(playerid, 0xFF6600FF, ""USC" уже влетес текущим лидером торгов!");
    
    new bid = strval(inputtext);
    
    if(bid <= g_BizAuctionPrice[biz_id])
    {
        new fmt_msg[128];
        format(fmt_msg, sizeof fmt_msg, ""USC"тавка должна бт болше текущей ({FFFF00}%d {FFFFFF}рублей)!", g_BizAuctionPrice[biz_id]);
        SendClientMessage(playerid, 0xFF6600FF, fmt_msg);
        callcmd::buybiz(playerid, "");
        return 1;
    }
    
    // ===== Я  =====
    if(GetPlayerMoneyEx(playerid) < bid)
    {
        new fmt_msg[128];
        format(fmt_msg, sizeof fmt_msg, ""USC" вас недостаточно денег дл ставки! ужно: {FFFF00}%d {FFFFFF}рублей", bid);
        SendClientMessage(playerid, 0xFF6600FF, fmt_msg);
        callcmd::buybiz(playerid, "");
        return 1;
    }
    
    // =====     =====
    new old_bidder = g_BizAuctionBidder[biz_id];
    new old_price = g_BizAuctionPrice[biz_id];
    
    if(old_bidder != INVALID_PLAYER_ID && IsPlayerConnected(old_bidder))
    {
        GivePlayerMoneyEx(old_bidder, old_price, "озврат ставки на бизнес (перебита)", true, true);
        DeletePVar(old_bidder, "biz_auction_money");
        
        new biz_name[64];
        format(biz_name, sizeof(biz_name), "%s №%d", GetBusinessData(biz_id, B_NAME), biz_id + 1);
        
        new fmt_msg[128];
        format(fmt_msg, sizeof fmt_msg, "{FFFFFF}ашу ставку на покупку {FFFF00}%s {FFFFFF}перебили! енги возвращен.", biz_name);
        SendClientMessage(old_bidder, 0xFF6600FF, fmt_msg);
    }
    
    // =====      =====
    GivePlayerMoneyEx(playerid, -bid, "тавка на бизнес (заморожена)", true, true);
    SetPVarInt(playerid, "biz_auction_money", bid);
    
    // бновлем аукцион
    g_BizAuctionPrice[biz_id] = bid;
    g_BizAuctionBidder[biz_id] = playerid;
    g_BizAuctionTime[biz_id] = gettime() + 30;
    
    if(g_BizAuctionTimer[biz_id] != -1)
    {
        KillTimer(g_BizAuctionTimer[biz_id]);
    }
    g_BizAuctionTimer[biz_id] = SetTimerEx("OnBizAuctionEnd", 30000, false, "i", biz_id);
    
    new biz_name[64];
    format(biz_name, sizeof(biz_name), "%s №%d", GetBusinessData(biz_id, B_NAME), biz_id + 1);
    
    new fmt_msg[128];
    format(fmt_msg, sizeof fmt_msg, "{FFFF00}%s[%d] {FFFFFF}перебил ставку! ова ставка: {FFFF00}%d {FFFFFF}рублей на бизнес {FFFF00}%s!",
        GetPlayerNameEx(playerid), playerid, bid, biz_name);
    SendClientMessageToAll(0xFFFF00FF, fmt_msg);
    
    return 1;
}
