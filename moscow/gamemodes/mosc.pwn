	GetFamilyData(fam_id, F_TAKE_AMMO));

	Dialog(playerid, DIALOG_FAMILY_SETRANG_MENU, DIALOG_STYLE_LIST, "астройка доступа", fmt_text, "алее", "акрт");
}

