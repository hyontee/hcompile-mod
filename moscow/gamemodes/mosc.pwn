stock SyncPlayerSkinFromInventory(playerid)
{
    if(!IsPlayerLogged(playerid)) return 0;
    if(1 <= GetPlayerTeamEx(playerid) < MAX_ORG) return 0;

    new query[144], Cache:result;

    mysql_format(mysql, query, sizeof query, "SELECT skin_id FROM inventory_skins WHERE owner_skin=%d AND use_skin=1 ORDER BY id DESC LIMIT 1", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);

    if(cache_num_rows())
    {
        new skin_id = cache_get_field_content_int(0, "skin_id");
        if(0 <= skin_id <= 311 && skin_id != GetPlayerData(playerid, P_SKIN))
        {
            SetPlayerData(playerid, P_SKIN, skin_id);
            UpdatePlayerDatabaseInt(playerid, "skin", skin_id);
        }
    }

    cache_delete(result);
    return 1;
}
stock myskins(playerid)
{
    new fmt_text[2048], Cache: result, id;

    mysql_format(mysql, fmt_text, sizeof fmt_text, "SELECT * FROM inventory_skins WHERE owner_skin='%d'", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, fmt_text, true);

    new rows = cache_num_rows();

    if(!rows)
    {
        ShowNotification(playerid, 2, " ас нет никаких скинов", 5, "", "");
        CheckSkinPlayer(playerid);
    }
    else
    {
        new query[150], skin_id, use, skin_use[50];

        format(fmt_text, sizeof fmt_text, "№\t[гровой ID]\tтатус скина\n");

        for(new i67858 = 0; i67858 < rows; i67858++)
        {
            id = cache_get_field_content_int(i67858, "id");
            skin_id = cache_get_field_content_int(i67858, "skin_id");
            use = cache_get_field_content_int(i67858, "use_skin");

            if(use > 0) format(skin_use, sizeof skin_use, "{8EF674}[ надет ]");
            else format(skin_use, sizeof skin_use, "{BEBEBE}[ можно надет ]");

            format(query, sizeof query, "%d\t[%d]\t%s\n", i67858 + 1, skin_id, skin_use);
            strcat(fmt_text, query);
            SetPlayerListitemValue(playerid, i67858, id);
        }

        Dialog
        (
            playerid, DIALOG_INV_SKINS, DIALOG_STYLE_TABLIST_HEADERS,
            "{FA8072}нвентар {FFFFFF}| берите игровой скин из списка ниже",
            fmt_text,
            "брат", "акрт"
        );
    }

    cache_delete(result);
    return 1;
}

stock bool:IsPlayerNearOwnableCarTrunk(playerid, vehicleid)
{
    new Float:x, Float:y, Float:z;
    new Float:angle, Float:distance;
    GetCoordVehicle(vehicleid, VEHICLE_COORD_TYPE_BOOT, x, y, z, angle, distance);
    return IsPlayerInRangeOfPoint(playerid, 2.5, x, y, z);
}

stock NormalizePickupPlateText(text[])
{
    for(new i = 0; text[i] != EOS; i++)
    {
        text[i] = toupper(text[i]);
    }
    return 1;
}

stock bool:IsPickupPlateRegion(text[])
{
    new length = strlen(text);
    if(length < 2 || length > 3) return false;

    for(new i = 0; i < length; i++)
    {
        if(text[i] < '0' || text[i] > '9')
            return false;
    }

    return strval(text) > 0;
}

stock GeneratePickupNumberRegion(region[], len = sizeof(region))
{
    format(region, len, "%03d", random(900) + 100);
    return 1;
}

stock bool:IsPickupNumberPlateTaken(const plate_text[], const plate_region[])
{
    new plate_full[32], query[160], Cache:result;
    JoinPlate(plate_text, plate_region, plate_full, sizeof plate_full);

    mysql_format(mysql, query, sizeof query, "SELECT id FROM ownable_cars WHERE number='%e' AND region='%e' LIMIT 1", plate_text, plate_region);
    result = mysql_query(mysql, query, true);

    new bool:is_taken = cache_num_rows() > 0;
    cache_delete(result);

    if(is_taken)
        return true;

    mysql_format(mysql, query, sizeof query, "SELECT player_id FROM player_inventory WHERE item_id=%d AND item_plate='%e' LIMIT 1", PICKUP_NUMBER_ITEM_ID, plate_full);
    result = mysql_query(mysql, query, true);
    is_taken = cache_num_rows() > 0;
    cache_delete(result);

    return is_taken;
}

stock bool:RollPlayerPickupNumber(playerid)
{
    new plate_text[16], plate_region[8];

    for(new attempt = 0; attempt < 20; attempt++)
    {
        format(plate_text, sizeof plate_text, GenerateCarNumber());
        GeneratePickupNumberRegion(plate_region, sizeof plate_region);

        if(IsPickupNumberPlateTaken(plate_text, plate_region))
            continue;

        strcpy(g_pickup_number_text[playerid], plate_text, 16);
        strcpy(g_pickup_number_region[playerid], plate_region, 8);
        return true;
    }

    g_pickup_number_text[playerid][0] = EOS;
    g_pickup_number_region[playerid][0] = EOS;
    return false;
}

stock TryOpenPlayerPickupNumberDialog(playerid, pickupid)
{
    if(g_PlayerNumberPickupDialogShown[playerid])
        return 1;

    if(!IsPickupExists(pickupid))
        return 0;

    if(pickupid != numberbuy1 && pickupid != numberbuy2)
        return 0;

    if(!IsPlayerInRangeOfPoint(playerid, 2.0, GetPickupInfo(pickupid, P_POS_X), GetPickupInfo(pickupid, P_POS_Y), GetPickupInfo(pickupid, P_POS_Z)))
        return 0;

    g_PlayerNumberPickupDialogShown[playerid] = true;
    g_pickup_number_text[playerid][0] = EOS;
    g_pickup_number_region[playerid][0] = EOS;
    return ShowPlayerPickupNumberMainDialog(playerid);
}
stock ShowPlayerPickupNumberMainDialog(playerid)
{
    return Dialog(playerid, DIALOG_PICKUP_NUMBER_MAIN, DIALOG_STYLE_LIST,
        "{FF5A5A}SANTA MOBILE RP | окупка номера",
        "1. лучайнй номер\n2. астомнй номер",
        "брат", "акрт");
}

stock ShowPlayerPickupNumberCustomDialog(playerid)
{
    new fmt_text[192];
    format(fmt_text, sizeof fmt_text,
        "{FFFFFF}ведите желаемй номер в формате {FFCC00}A123BC 777\n{FFFFFF}тоимост покупки: {FFFF00}%d рублей",
        PICKUP_NUMBER_CUSTOM_RU);

    return Dialog(playerid, DIALOG_PICKUP_NUMBER_CUSTOM, DIALOG_STYLE_INPUT,
        "{FF5A5A}SANTA MOBILE RP | окупка номера",
        fmt_text,
        "родолжит", "азад");
}

stock ShowPlayerPickupNumberRandomDialog(playerid)
{
    if(!g_pickup_number_text[playerid][0] || !g_pickup_number_region[playerid][0])
    {
        if(!RollPlayerPickupNumber(playerid))
            return 0;
    }

    new plate_full[32], fmt_text[256];
    JoinPlate(g_pickup_number_text[playerid], g_pickup_number_region[playerid], plate_full, sizeof plate_full);

    format(fmt_text, sizeof fmt_text,
        "{FFFFFF}ам впал номер:{FFFF00}%s\n"\
        "{FFFFFF} можете приобрести либо повторит прокрут и вбит новй.\n\n"\
        "{FFFFFF}тоимост номера:{FFFF00}%d рублей\n"\
        "{FFFFFF}тоимост прокрута:{FFFF00}%d рублей",
        plate_full,
        PICKUP_NUMBER_BUY_RU,
        PICKUP_NUMBER_REROLL_RU);

    return Dialog(playerid, DIALOG_PICKUP_NUMBER_RANDOM, DIALOG_STYLE_MSGBOX,
        "{FF5A5A}SANTA MOBILE RP | окупка номера",
        fmt_text,
        "риобрести", "овторит");
}

stock BuyPlayerPickupNumber(playerid, const plate_text[], const plate_region[], price, const description[])
{
    if(!plate_text[0] || !plate_region[0])
        return ShowNotification(playerid, 2, "омер не бл подготовлен дл покупки", 4, "", "");

    if(IsPickupNumberPlateTaken(plate_text, plate_region))
        return ShowNotification(playerid, 2, "аннй номер уже зант. опробуйте еще раз", 4, "", "");

    if(GetPlayerMoneyEx(playerid) < price)
    {
        new fmt_text[128];
        format(fmt_text, sizeof fmt_text, "едостаточно денег. л покупки необходимо %d рублей", price);
        return ShowNotification(playerid, 2, fmt_text, 4, "", "");
    }

    new plate_full[32];
    new money_description[64];
    JoinPlate(plate_text, plate_region, plate_full, sizeof plate_full);
    format(money_description, sizeof money_description, "%s", description);

    if(Inventory_GiveNumberPlate(playerid, PICKUP_NUMBER_ITEM_ID, plate_full) == -1)
        return ShowNotification(playerid, 2, "едостаточно места в инвентаре", 4, "", "");

    GivePlayerMoneyEx(playerid, -price, money_description, true, true);

    new fmt_text[160];
    format(fmt_text, sizeof fmt_text, " успешно приобрели номер: %s", plate_full);

    g_pickup_number_text[playerid][0] = EOS;
    g_pickup_number_region[playerid][0] = EOS;

    return ShowNotification(playerid, 3, fmt_text, 5, "", "");
}

stock BuyPlayerPickupCustomNumber(playerid, const inputtext[])
{
    new plate_text[16], plate_region[8];
    SplitPlate(inputtext, plate_text, sizeof plate_text, plate_region, sizeof plate_region);
    NormalizePickupPlateText(plate_text);

    if(!IsACarNumber(plate_text) || !IsPickupPlateRegion(plate_region))
    {
        ShowNotification(playerid, 2, "казаннй номер не соответствует формату A123BC 777", 4, "", "");
        return ShowPlayerPickupNumberCustomDialog(playerid);
    }

    return BuyPlayerPickupNumber(playerid, plate_text, plate_region, PICKUP_NUMBER_CUSTOM_RU, "окупка кастомного номера");
}

stock ShowPlayerBuyNumberMainDialog(playerid)
{
    return Dialog(playerid, DIALOG_BUY_NUMBER_MAIN, DIALOG_STYLE_TABLIST_HEADERS, "{FF5A5A}окупка номеров",
        "№\tип номерного знака\tписание\n"\
        "1\tлучайнй номерной знак\tгенерироват случайнй номер\n"\
        "2\tндивидуалнй номерной знак\tвести собственнй номер",
        "брат", "акрт");
}

stock LoadPlayerNumberResources(playerid)
{
    new query[160], Cache:result;
    g_player_number_resource_count[playerid] = 0;

    mysql_format(mysql, query, sizeof query, "SELECT id, plate_number FROM player_number_inventory WHERE player_id=%d ORDER BY id ASC LIMIT 32", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);

    for(new i67910; i67910 < cache_num_rows() && i67910 < 32; i67910++)
    {
        g_player_number_resource_count[playerid]++;
        g_player_number_resource[playerid][i67910][PNR_SQL_ID] = cache_get_field_content_int(i67910, "id");
        cache_get_field_content(i67910, "plate_number", g_player_number_resource[playerid][i67910][PNR_NUMBER], mysql, 16);
    }
    cache_delete(result);
    return 1;
}

stock GivePlayerNumberResource(playerid, const number[])
{
    new query[160];
    mysql_format(mysql, query, sizeof query, "INSERT INTO player_number_inventory (player_id, plate_number) VALUES (%d, '%e')", GetPlayerAccountID(playerid), number);
    mysql_query(mysql, query, false);
    if(mysql_errno()) return 0;

    LoadPlayerNumberResources(playerid);
    return 1;
}

stock DeletePlayerNumResourceSlot(playerid, slot)
{
    if(!(0 <= slot < g_player_number_resource_count[playerid])) return 0;

    new query[96];
    mysql_format(mysql, query, sizeof query, "DELETE FROM player_number_inventory WHERE id=%d LIMIT 1", g_player_number_resource[playerid][slot][PNR_SQL_ID]);
    mysql_query(mysql, query, false);
    if(mysql_errno()) return 0;

    LoadPlayerNumberResources(playerid);
    return 1;
}

stock ShowPlayerNumberResources(playerid)
{
    new fmt_text[1024];
    new row_text[128];
    new count = 0;
    
    format(fmt_text, sizeof fmt_text, "{FF8A8A}№\t{FF8A8A}ип\t{FF8A8A}азвание\n");
    
    // оказваем номерне знаки
    for(new i = 0; i < g_player_number_resource_count[playerid]; i++)
    {
        format(row_text, sizeof row_text, 
            "{FFFFFF}%d.\tомер\t%s\n",
            count + 1,
            g_player_number_resource[playerid][i][PNR_NUMBER]
        );
        strcat(fmt_text, row_text);
        
        // охранем тип ресурса дл этого слота
        new pvar_name[32];
        format(pvar_name, sizeof pvar_name, "res_type_%d", count);
        SetPVarInt(playerid, pvar_name, RESOURCE_TYPE_NUMBER);
        SetPlayerListitemValue(playerid, count, i);
        count++;
    }
    
    // оказваем SIM-карт
    for(new i = 0; i < g_player_sim_resource_count[playerid]; i++)
    {
        format(row_text, sizeof row_text, 
            "{FFFFFF}%d.\tSIM-карта\t%s\n",
            count + 1,
            g_player_sim_resource[playerid][i][PSR_NUMBER]
        );
        strcat(fmt_text, row_text);
        
        new pvar_name[32];
        format(pvar_name, sizeof pvar_name, "res_type_%d", count);
        SetPVarInt(playerid, pvar_name, RESOURCE_TYPE_SIM);
        SetPlayerListitemValue(playerid, count, i);
        count++;
    }
    
    if(count == 0)
    {
        format(fmt_text, sizeof fmt_text, "{FFFFFF} вас нет ресурсов.");
    }
    
    Dialog
    (
        playerid, DIALOG_INV_RESOURCES, DIALOG_STYLE_TABLIST_HEADERS,
        "{FA8072}нвентар {FFFFFF}| ои ресурс",
        fmt_text,
        "брат", "акрт"
    );
    
    return 1;
}

stock BuyPlayerRandomNumberResource(playerid)
{
    new number[16], query[128], Cache:result;

    for(new attempt = 0; attempt < 20; attempt++)
    {
        format(number, sizeof number, GenerateCarNumber());

        mysql_format(mysql, query, sizeof query, "SELECT id FROM ownable_cars WHERE number='%e' LIMIT 1", number);
        result = mysql_query(mysql, query, true);

        if(!cache_num_rows())
        {
            cache_delete(result);
            break;
        }

        cache_delete(result);
        number[0] = EOS;
    }

    if(!number[0])
    {
        return ShowNotification(playerid, 2, "е удалос подобрат свободнй номер. опробуйте еще раз", 4, "", "");
    }

    if(GetPlayerMoneyEx(playerid) < NUMBER_PRICE_RANDOM_RU)
    {
        new fmt_text[128];
        format(fmt_text, sizeof fmt_text, "едостаточно денег. л покупки необходимо %d рублей", NUMBER_PRICE_RANDOM_RU);
        return ShowNotification(playerid, 2, fmt_text, 4, "", "");
    }

    if(!GivePlayerNumberResource(playerid, number))
        return SendClientMessage(playerid, -1, "шибка SQL при вдаче номерного знака");

    GivePlayerMoneyEx(playerid, -NUMBER_PRICE_RANDOM_RU, "окупка номерного знака", true, true);

    new fmt_text[144];
    format(fmt_text, sizeof fmt_text, " успешно купили номер '%s 17' за %d рублей", number, NUMBER_PRICE_RANDOM_RU);
    return ShowNotification(playerid, 3, fmt_text, 5, "", "");
}

stock BuyPlayerCustomNumberResource(playerid, const number[])
{
    new query[128], Cache:result;

    if(GetPlayerMoneyEx(playerid) < NUMBER_PRICE_CUSTOM_RU)
    {
        new fmt_text[128];
        format(fmt_text, sizeof fmt_text, "едостаточно денег. л покупки необходимо %d рублей", NUMBER_PRICE_CUSTOM_RU);
        return ShowNotification(playerid, 2, fmt_text, 4, "", "");
    }

    mysql_format(mysql, query, sizeof query, "SELECT id FROM ownable_cars WHERE number='%e' LIMIT 1", number);
    result = mysql_query(mysql, query, true);
    if(cache_num_rows())
    {
        cache_delete(result);
        return ShowNotification(playerid, 2, "аннй номер уже зант", 4, "", "");
    }
    cache_delete(result);

    if(!GivePlayerNumberResource(playerid, number))
        return SendClientMessage(playerid, -1, "шибка SQL при вдаче номерного знака");

    GivePlayerMoneyEx(playerid, -NUMBER_PRICE_CUSTOM_RU, "окупка номерного знака", true, true);

    new fmt_text[144];
    format(fmt_text, sizeof fmt_text, " успешно купили номер '%s 17' за %d рублей", number, NUMBER_PRICE_CUSTOM_RU);
    return ShowNotification(playerid, 3, fmt_text, 5, "", "");
}

stock GetPlayerOwnableCarSafe(playerid)
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid == INVALID_VEHICLE_ID)
	{
		return INVALID_VEHICLE_ID;
	}
	if(!IsAOwnableCar(vehicleid))
	{
		SetPlayerData(playerid, P_OWNABLE_CAR, INVALID_VEHICLE_ID);
		return INVALID_VEHICLE_ID;
	}
	new index = GetVehicleData(vehicleid, V_ACTION_ID);
	if(!(0 <= index < MAX_OWNABLE_CARS) || GetOwnableCarData(index, OC_OWNER_ID) != GetPlayerAccountID(playerid))
	{
		SetPlayerData(playerid, P_OWNABLE_CAR, INVALID_VEHICLE_ID);
		return INVALID_VEHICLE_ID;
	}
	return vehicleid;
}


stock ApplyPlayerNumberResource(playerid, slot)
{
    if(!(0 <= slot < g_player_number_resource_count[playerid]))
        return SendClientMessage(playerid, -1, "омерной знак не найден");

    new vehicleid = GetPlayerOwnableCarSafe(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");

    if(!(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(playerid) == vehicleid) && !IsPlayerNearOwnableCarTrunk(playerid, vehicleid))
        return SendClientMessage(playerid, 0x999999FF, " не можете установит номерной знак");

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(strcmp(g_ownable_car[index][OC_NUMBER], "------", true))
        return SendClientMessage(playerid, 0x999999FF, "начала снимите текущий номерной знак");

    format(g_ownable_car[index][OC_NUMBER], 8, g_player_number_resource[playerid][slot][PNR_NUMBER]);
    BT_SetNumPlate(vehicleid, 1, g_player_number_resource[playerid][slot][PNR_NUMBER], "17");

    new query[160];
    mysql_format(mysql, query, sizeof query, "UPDATE ownable_cars SET number='%e' WHERE id=%d LIMIT 1", g_player_number_resource[playerid][slot][PNR_NUMBER], GetOwnableCarData(index, OC_SQL_ID));
    mysql_query(mysql, query, false);

    DeletePlayerNumResourceSlot(playerid, slot);
    return ShowNotification(playerid, 3, "омерной знак успешно установлен на транспорт", 4, "", "");
}

stock RemovePlayerVehicleNumber(playerid)
{
    new vehicleid = GetPlayerOwnableCarSafe(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");

    if(!(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(playerid) == vehicleid) && !IsPlayerNearOwnableCarTrunk(playerid, vehicleid))
        return SendClientMessage(playerid, 0x999999FF, " не можете снт номерной знак");

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(!strcmp(g_ownable_car[index][OC_NUMBER], "------", true))
        return SendClientMessage(playerid, 0x999999FF, "а транспорте отсутствует номерной знак");

    if(!GivePlayerNumberResource(playerid, g_ownable_car[index][OC_NUMBER]))
        return SendClientMessage(playerid, -1, "шибка SQL при вдаче номерного знака");

    format(g_ownable_car[index][OC_NUMBER], 8, "------");
    BT_SetNumPlate(vehicleid, 1, "------", "17");

    new query[144];
    mysql_format(mysql, query, sizeof query, "UPDATE ownable_cars SET number='------' WHERE id=%d LIMIT 1", GetOwnableCarData(index, OC_SQL_ID));
    mysql_query(mysql, query, false);

    return ShowNotification(playerid, 3, "омерной знак снт и возвращен в инвентар", 4, "", "");
}
stock CheckSkinPlayer(playerid)
{
    new query[144], Cache:result;

    mysql_format(mysql, query, sizeof query, "SELECT * FROM inventory_skins WHERE owner_skin = %d", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);

    new rows = cache_num_rows();
    cache_delete(result);

    if(!rows)
    {
        mysql_format(mysql, query, sizeof query, "INSERT INTO inventory_skins (owner_skin,skin_id,use_skin) VALUES (%d,%d,1)", GetPlayerAccountID(playerid), GetPlayerSkinEx(playerid));
        mysql_query(mysql, query, false);

        if(mysql_errno()) return SCM(playerid, -1, "CheckSkinPlayer | SQL ERROR 1");

        ShowNotification(playerid, 3, "дежда добавлена в инвентар", 5, "", "");
        return 1;
    }

    return 0;
}

stock GivePlayerOwnableSkin(playerid, skinid)
{
    new query[144];

    mysql_format(mysql, query, sizeof query, "INSERT INTO inventory_skins (owner_skin,skin_id,use_skin) VALUES (%d,%d,0)", GetPlayerAccountID(playerid), skinid);
    mysql_query(mysql, query, false);

    if(mysql_errno()) return SCM(playerid, -1, "GivePlayerOwnableSkin | SQL ERROR");

    ShowNotification(playerid, 3, "дежда добавлена в инвентар", 5, "", "");
    return 1;
}

