	if(GetPlayerData(playerid, P_ACCOUNT_STATE) != ACCOUNT_STATE_REGISTER) return 0;
//SendClientMessage(playerid, 0xFFFF00FF, "{34C924}| {FFFFFF}обро пожаловат на {FF6347}"SERVER_NAME"!");
	switch(step)
	{
		case REGISTER_STATE_PASSWORD:
		{
			Dialog
			(
				playerid, DIALOG_REGISTER, DIALOG_STYLE_INPUT,
				"{66CCFF}егистраци",
				"{FFFFFF}обро пожаловат на {FF6347}"SERVER_NAME"{ffffff}!\n"\
				"тоб начат игру сначала необходимо зарегистрироватс\n\n"\
				"ожалуйста укажите парол дл ашего аккаунта\n"\
				"н будет запрашиватс каждй раз, когда в заходите на сервер\n\n"\
				"\t{66CC66}римечани:\n"\
				"\t- арол может состот из русских и латинских символов\n"\
				"\t- арол чувствителен к регистру\n"\
				"\t- лина парол от 6-ти до 15-ти символов",
				"алее", ""
			);
		}
		case REGISTER_STATE_REFER:
		{
			Dialog
			(
				playerid, DIALOG_REGISTER, DIALOG_STYLE_INPUT,
				"{66CCFF}ик пригласившего игрока",
				"{FFFFFF}сли  узнали о нашем сервере от своего друга\n"\
				"которй тут играет, укажите его ник в поле ниже\n\n"\
				"{66CC66}ри достижении вами 4-го уровн он получит вознаграждение",
				"вести", "ропустит"
			);
		}
		case REGISTER_STATE_SEX:
		{
			Dialog
			(
				playerid, DIALOG_REGISTER, DIALOG_STYLE_MSGBOX,
				"{66CCFF}ол",
				"{FFFFFF}берите пол вашего персонажа",
				"ужской", "енский"
			);
		}
		case REGISTER_STATE_RULES:
		{
			ShowServerRules(playerid, true);
		}
		case REGISTER_STATE_CREATE_ACC:
		{
			if(CreatePlayerAccount(playerid))
			{
				SetPlayerData(playerid, P_ACCOUNT_STATE, ACCOUNT_STATE_REG_SKIN);

				SetSpawnInfo(playerid, 0, 0, 332.2033, -174.1066, 999.6743, 1.0, 0, 0, 0, 0, 0, 0);
				SpawnPlayer(playerid);

				//SendClientMessage(playerid, 0xFFFFFFFF, "сталос совсем немного!");
				SendClientMessage(playerid, 0x66CC00FF, "берите внешност ашего персонажа");

			}
			else
			{
				SendClientMessage(playerid, 0xFF6600FF, "шибка создани аккаунта, попробуйте снова через пару секунд");
				Dialog
				(
					playerid, DIALOG_REGISTER, DIALOG_STYLE_INPUT,
					"{66CCFF}егистраци",
					"{FFFFFF}обро пожаловат на {FF6347}"SERVER_NAME"{ffffff}!\n"\
					"тоб начат игру сначала необходимо зарегистрироватс\n\n"\
					"ожалуйста укажите парол дл ашего аккаунта\n"\
					"н будет запрашиватс каждй раз, когда в заходите на сервер\n\n"\
					"\t{66CC66}римечани:\n"\
					"\t- арол может состот из русских и латинских символов\n"\
					"\t- арол чувствителен к регистру\n"\
					"\t- лина парол от 6-ти до 15-ти символов",
					"алее", ""
				);
				step = REGISTER_STATE_PASSWORD;
			}
		}
		default:
			return 1;
	}

	SetPlayerData(playerid, P_ACCOUNT_STEP_STATE, step);
	return 1;
}

stock ShowServerRules(playerid, bool: reg = false)
{
	Dialog
	(
		playerid, reg ? DIALOG_REGISTER : DIALOG_PLAYER_STATS, DIALOG_STYLE_MSGBOX,
		"{66CCFF}равила сервера",
		"{FFCD00}1. сновное\n"\
		"{FFFFFF}- апрещено исползоват любе чит или CLEO скрипт\n"\
		"- апрещен DM -нанесение вреда игрокам без причин\n"\
		"- апрещено убиват игроков на спавне\n"\
		"- апрещен убийства путем наезда на него\n"\
		"- апрещено уходит на паузу в целх спасени\n"\
		"- апрещено исползование возможностей сервера дл создани помех\n\n"\
		"{FFCD00}2. роцесс общени\n"\
		"{FFFFFF}- апрещено оскорбление игроков\n"\
		"- апрещен угроз вне игр\n"\
		"- апрещено писат транслитом\n"\
		"- апрещена люба реклама сторонних ресурсов\n"\
		"- апрещено флудит\n\n"\
		"{FFCD00}3. дминистраци\n"\
		"- еобходимо сообщат администрации сервера о нарушени даннх правил\n"\
		"- дминистраци самостотелно вбирает штрафне санкции\n"\
		"- анкции могут приментс сразу после нарушени или через врем\n"\
		"- ри неполадках, свжитес с администрацией",
		"родолжит", "тмена"
	);
}

stock GetPlayerHouseName(playerid)
{
	new name[32];
	new houseid = GetPlayerHouse(playerid);

	if(houseid != -1)
	{
		switch(GetPlayerData(playerid, P_HOUSE_TYPE))
		{
			case HOUSE_TYPE_HOME:
			{
				if(GetHouseData(houseid, H_ENTRACE) != -1)
				{
					format(name, sizeof name, "одъезд %d (№%d на %d этаже)", GetHouseData(houseid, H_ENTRACE) + 1, GetHouseData(houseid, H_FLAT_ID) + 1, GetHouseData(houseid, H_FLAT_ID) / 4 + 1);
				}
				else format(name, sizeof name, "%s (№%d)", GetHouseData(houseid, H_NAME), houseid);
			}
			case HOUSE_TYPE_ROOM:
			{
				format(name, sizeof name, " гостх (дом №%d)", houseid);
			}
			case HOUSE_TYPE_HOTEL:
			{
				format(name, sizeof name, "остиница (№%d на %d этаже)", (GetPlayerData(playerid, P_HOUSE_ROOM) % 12) + 1, (GetPlayerData(playerid, P_HOUSE_ROOM) / 12) + 1);
			}
		}
	}
	else name = "ездомнй";

	return name;
}

stock GetPlayerBizName(playerid)
{
	new name[32];
	new businessid = GetPlayerBusiness(playerid);

	if(businessid != -1)
	{
		format(name, sizeof name, "%s (№%d)", GetBusinessData(businessid, B_NAME),  businessid);
	}
	else name = "ет";

	return name;
}

stock GetPlayerJobAndRankName(playerid)
{
	new team = GetPlayerTeamEx(playerid);
	new rang = GetPlayerJob(playerid);
	new fmt_rank[32];

	if(TEAM_GOVERNMENT <= team <= TEAM_OPG_LYTKARINSKAYA)
	{
		if(!(1 <= rang <= 10))
			rang = 1;

		format(fmt_rank, sizeof fmt_rank, rank_names[team - 1][rang - 1]);
	}
	else
	{
	    format(fmt_rank, sizeof fmt_rank, GetPlayerJobName(playerid));
	}

	return fmt_rank;
}

stock IsTeamSubdivision(team)
{
	if(TEAM_DPS <= team <= TEAM_FBI)
	{
		return true;
	}
	return false;
}

stock GetPlayerSubdivisionName(playerid)
{
	new player_team = GetPlayerTeamEx(playerid);

	if(IsTeamSubdivision(player_team))
		return team_subdivision_name[player_team - 4];

	return team_subdivision_name[0];
}

stock GetPlayerTeamStats(playerid)
{
	new fmt_text[110];

	format(fmt_text, sizeof fmt_text, "рганизаци:\t\t\t%s\n", GetPlayerTeamName(playerid));

	if(IsTeamSubdivision(GetPlayerTeamEx(playerid)))
	{
	    format(fmt_text, sizeof fmt_text, "%sодразделение:\t\t%s\n", fmt_text, GetPlayerSubdivisionName(playerid));
	}

	return fmt_text;
}

stock GetPlayerGameStatus(playerid)
{
	new status[16];

	switch(GetPlayerLevel(playerid))
	{
	    case 0: status = "шибка";
	    case 1: status = "ез статуса";
	    case 2..5: status = "овичок";
	    case 6..9: status = "азвивающийс";
	    case 10..14: status = "своившийс";
	    case 15..19: status = "птнй игрок";
	    case 20..29: status = "ктивнй игрок";
	    default: status = "егендарнй";
	}

	if(GetPlayerTeamEx(playerid) && (GetPlayerJob(playerid) == 10)) status = "идер";
	if(GetPlayerAdminEx(playerid) != 0) status = "дминистратор";

	return status;
}

