    if(GetVehicleParam(vehicleid, V_LOCK))
    {
        new fmt_str[128];
        format(fmt_str, sizeof fmt_str,"%s открл(а) траснпорт", GetPlayerNameEx(playerid));
		SendMessageInLocal(playerid, fmt_str, 0xDD90FFFF, 25.0);
        SetVehicleParam(vehicleid, V_LOCK, 0);
        g_vehicle_lock_sent[vehicleid] = false;
        PlayAudioStreamURL(playerid, SOUND_DOOR_OPEN);
        ShowNotification(playerid, 3, " открли транспорт", 5, "", "");
        //GameTextForPlayer(playerid,"~w~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~ЏPAнCЊOPЏ~g~ OЏKP‘Џ", 3000, 3);
    }
    else
    {
        new fmt_str[128];
       	format(fmt_str, sizeof fmt_str,"%s закрл(а) траснпорт", GetPlayerNameEx(playerid));
		SendMessageInLocal(playerid, fmt_str, 0xDD90FFFF, 25.0);
