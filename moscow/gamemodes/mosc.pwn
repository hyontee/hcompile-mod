			}
			case DIALOG_DRIVING_TUTORIAL:
			{
				new step = GetPVarInt(playerid, "driving_tutorial_step");
				if(response)
				{
					step ++;
				}
				else step --;

				if(step >= sizeof driving_tutorial)
				{
					Dialog
					(
						playerid, DIALOG_DRIVING_TUTORIAL_END, DIALOG_STYLE_MSGBOX,
						"{0099FF}авершение",
						"{FFFFFF}адеемс в все внимателно прочли и готов приступит к сдаче экзамена\n"\
						"сли в сомневаетес в чем-либо, то рекомендуем не рисковат и прочитат нужнй раздел еще раз!\n\n"\
						"{CC9900}елаем ам удачи на экзамене!\n"\
						"л того, чтоб завершит обучение нажмите \"ход\"",
						"ход", "азад"
					);
				}
				else if(step < 0)
				{
					ShowPlayerDrivingTutorial(playerid);
				}
				else
				{
					ShowDrivingTutorialSection(playerid, step);

					if(step == 1)
					{
						ShowNotification(playerid, 2, "е попадайте в ", 5, "", "");
					}
				}
			}
			case DIALOG_DRIVING_TUTORIAL_END:
