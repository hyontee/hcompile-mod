CMD:dice(playerid, params[])
{
	if(GetPlayerInBiz(playerid) == -1)
		return SendClientMessage(playerid, 0x999999FF, " должн находитс в казино");

	if(GetBusinessData(GetPlayerInBiz(playerid), B_TYPE) != BUSINESS_TYPE_CASINO)
		return SendClientMessage(playerid, 0x999999FF, " должн находитс в казино");

	if(!IsPlayerInRangeOfAnyCasinoTable(playerid)) return SendClientMessage(playerid, 0x999999FF, " должн находитс возле игралного стола");

	extract params -> new to_player, money; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /dice [id игрока] [сумма]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 4.0))
		return SendClientMessage(playerid, 0x999999FF, "грок находитс слишком далеко");

	 if(!(1 <= money <= 1_000_000))
        return SendClientMessage(playerid, 0x999999FF, "умма должна бт не более 1.000.000 рублей");
    
    // ===== : роверка денег у обоих игроков =====
    if(!HasPlayerMoney(playerid, money))
        return SendClientMessage(playerid, 0x999999FF, ""USC" ас недостаточно денег!");
        
    if(!HasPlayerMoney(to_player, money))
        return SendClientMessage(playerid, 0x999999FF, ""USC" игрока недостаточно денег!");

    SendPlayerOfferNotification(playerid, to_player, OFFER_TYPE_CASINO_DICE, money);
    return 1;
}

CMD:ad(playerid, params[])
{
	if(!GetPlayerPhone(playerid))
		return SendClientMessage(playerid, 0x999999FF, " ас нет телефона, по которому могут с ами свзатс");

	new fmt_text[144];

	if(IsAIP(params))
	{
   		SendClientMessage(playerid, -1, "одозрени в рекламе!");
       	return false;
    }

	for(new idx; idx < g_advert_created; idx ++)
	{
		if(GetAdvertData(idx, A_CREATOR) != playerid) continue;

		format(fmt_text, sizeof fmt_text, "аше объвление уже находитс в очереди под {00CC99}номером %d", GetAdvertIndexInQueue(idx));
		SendClientMessage(playerid, 0xCECECEFF, fmt_text);

		return 1;
	}

	if(!strlen(params))
		return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /ad [текст объвлени]");

	if(GetPlayerMoneyEx(playerid) < ADVERT_SEND_PRICE)
		return SendClientMessage(playerid, 0x999999FF, "л отправки объвлени необходимо имет 250 руб");

	SendAdvert(playerid, params);

	GivePlayerMoneyEx(playerid, -250, "тправка объвлени", true, true);

	format(fmt_text, sizeof fmt_text, "екст: %s", params);
	SendClientMessage(playerid, 0x00CC99FF, fmt_text);

	SendClientMessage(playerid, -1, "аше объвление бло добавлено в очеред дл публикации");
	SendClientMessage(playerid, -1, "ставайтес на свзи, в противном случае объвление будет удалено из очереди");
	// SendClientMessage(playerid, -1, " можете ускорит его публикацию {FF9900}с помощю команд /up. {FFFFFF}слуга стоит {33CCFF}2000 руб");

	return 1;
}

CMD:edit(playerid, params[])
{
	if(GetPlayerTeamEx(playerid) != TEAM_RADIO) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");

	if(!g_advert_created) return SendClientMessage(playerid, 0xCECECEFF, "ет объвлений дл редактировани");

	new fmt_text[360],
		bool: ad_is_found;

	for(new idx; idx < g_advert_created; idx ++)
	{
		if(GetAdvertData(idx, A_EDIT) || GetAdvertData(idx, A_CREATOR) == INVALID_PLAYER_ID) continue;

		format
		(
			fmt_text, sizeof fmt_text,
			"{FFFFFF}тправител: %s\n\nекст:\n{FFCD00}%s\n\n"\
			"{FFFFFF}л редактировани объвлени введите новй текст и нажмите 'тправит'.\n"\
			"сли редактирование объвлению не нужно, оставте поле пустм.",
			GetPlayerNameEx(GetAdvertData(idx, A_CREATOR)), GetAdvertData(idx, A_TEXT)
		);

		Dialog(playerid, DIALOG_ADVERT_EDIT, DIALOG_STYLE_INPUT, "{00CC00}убликаци объвлени", fmt_text, "тправит", "тклонит");

		SetAdvertData(idx, A_EDIT, true);

		SetPVarInt(playerid, "advert_id", idx);

		ad_is_found = true;

		break;
	}

	if(!ad_is_found) return SendClientMessage(playerid, 0xCECECEFF, "ет объвлений дл редактировани");

	return 1;
}

CMD:t(playerid, params[])
{
	if(GetPlayerTeamEx(playerid) != TEAM_RADIO) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /t [текст]");

	new fmt_text[144];

	format(fmt_text, sizeof fmt_text, "[] %s: %s", GetPlayerNameEx(playerid), params);
	SendClientMessageToAll(0x6666FFFF, fmt_text);

	return 1;
}

CMD:u(playerid, params[])
{
	if(!GetPVarInt(playerid, "radio_mic")) return SendClientMessage(playerid, 0x999999FF, " не подключен к радио-эфиру");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /u [текст]");

	new fmt_text[144];

	format(fmt_text, sizeof fmt_text, "[] ост %s: %s", GetPlayerNameEx(playerid), params);
	SendClientMessageToAll(0x6666FFFF, fmt_text);

	return 1;
}

CMD:givemic(playerid, params[])
{
	if(GetPlayerTeamEx(playerid) != TEAM_RADIO) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /givemic [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!GetPVarInt(to_player, "radio_mic"))
		SendPlayerOfferNotification(playerid, to_player, OFFER_TYPE_GIVE_MIC);

	else
	{
		new fmt_text[128];

		format(fmt_text, sizeof fmt_text, "%s %s[%d] отключил ас от радио-эфира",
		GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid);

		SendClientMessage(to_player, 0xFF5533FF, fmt_text);

		format(fmt_text, sizeof fmt_text, " отключили %s[%d] от радио-эфира", GetPlayerNameEx(to_player), to_player);
		SendClientMessage(playerid, 0x3399FFFF, fmt_text);

		format(fmt_text, sizeof fmt_text, "[] %s %s[%d] отключил %s[%d] от радио-эфира",
		GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);

		SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_text, 0x99CC99FF, playerid);

		SetPVarInt(to_player, "radio_mic", 0);
	}

	return 1;
}

stock CreateGreenZones()
{
	for(new idx; idx < sizeof g_green_zones; idx ++)
		g_green_zones[idx][GZ_AREA] = CreateDynamicSphere
		(
			g_green_zones[idx][GZ_X], g_green_zones[idx][GZ_Y],
			g_green_zones[idx][GZ_Z], g_green_zones[idx][GZ_SIZE]
		);

	return 1;
}


