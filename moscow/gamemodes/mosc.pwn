CMD:owarn(playerid, params[])
{
	if(!(1 <= GetPlayerTeamEx(playerid) < MAX_ORG)) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");
	if(!(9 <= GetPlayerJob(playerid) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна лидерам организации и их заместителм");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /owarn [id игрока] [причина]");

	extract params -> new to_player, string:reason[32];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(1 <= strlen(reason) <= 32))
		return SendClientMessage(playerid, 0xCECECEFF, "ведите причину уволнени");

	if(GetPlayerTeamEx(to_player) != GetPlayerTeamEx(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей организации");

	if(GetPlayerJob(to_player) >= GetPlayerJob(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "елз вдат пред. заместителю/лидеру организации");
		
		
    AddPlayerData(to_player, P_OWARN, +, 1);

	new fmt_msg[128];

    format(fmt_msg, sizeof fmt_msg, "[ORG]: "c_b"%s[%d] вдал предупреждение игроку %s [%d/3]. ричина: %s",GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), GetPlayerData(to_player, P_OWARN), reason);

	SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_msg, 0x33CC66FF);

	new uid = GetPlayerAccountID(to_player);
	new warns = GetPlayerData(to_player, P_OWARN);

	if(warns >= 3)
	{
		SendClientMessage(to_player, 0xFF5533FF, " бли исключен из организации. ричина: 3 варна.");

		format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET owarn=0,team=0,job=0 WHERE id=%d", uid);
		mysql_query(mysql, fmt_msg, false);
		
		SetPlayerData(to_player, P_OWARN, 0);
		SetPlayerData(to_player, P_TEAM, 0);
		SetPlayerData(to_player, P_JOB, 0);
	}

	format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET owarn=%d WHERE id=%d", warns, uid);
	mysql_query(mysql, fmt_msg, false);


	return 1;
}

CMD:ounwarn(playerid, params[])
{
	if(!(1 <= GetPlayerTeamEx(playerid) < MAX_ORG)) return SendClientMessage(playerid, 0x999999FF, "ам недоступна данна функци");
	if(!(9 <= GetPlayerJob(playerid) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна лидерам организации и их заместителм");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /ounwarn [id игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");
		
    if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "елз снт варн с самого себ");


	if(GetPlayerTeamEx(to_player) != GetPlayerTeamEx(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей организации");


    AddPlayerData(to_player, P_OWARN, -, 1);

	new fmt_msg[128];

    format(fmt_msg, sizeof fmt_msg, "[ORG]: "c_b"%s[%d] снл предупреждение игроку %s [%d/3].",GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), GetPlayerData(to_player, P_OWARN));

	SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_msg, 0x33CC66FF);

	new uid = GetPlayerAccountID(to_player);
	new warns = GetPlayerData(to_player, P_OWARN);

	format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET owarn=%d WHERE id=%d", warns, uid);
	mysql_query(mysql, fmt_msg, false);


	return 1;
}


CMD:fwarn(playerid, params[])
{
    new fam_id = fam_id = GetPlayerIdFamily(playerid),
	    rang_id = GetPlayerData(playerid, P_FAMILY_RANK);

    new rank = GetFamilyData(GetPlayerIdFamily(playerid), F_RANG_WARN);

    if(!GetPlayerIdFamily(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "ам недоступна данна функци");

	if(GetPlayerData(playerid, P_FAMILY_RANK) < rank) return Send(playerid, COR_RED, "[шибка]: "c_b"  вас не достаточно нужнй ранг в семе, чтоб вдават семейное предупреждение.");


	if(GetPlayerAdminEx(playerid) < 2) return 1;
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /fwarn [id игрока] [причина (необзателно)]");

	extract params -> new to_player, string:reason[66];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

    if(GetPlayerData(to_player, P_FAMILY) != GetPlayerIdFamily(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей семе");

	if(GetPlayerData(to_player, P_FAMILY_RANK) >= GetPlayerData(playerid, P_FAMILY_RANK))
		return SendClientMessage(playerid, 0xCECECEFF, "елз вдат мут заместителю/лидеру семи");

	//if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "елз вдат предупреждение самому себе");

	AddPlayerData(to_player, P_FWARN, +, 1);

	new fmt_msg[128];

    format(fmt_msg, sizeof fmt_msg, "{%06x}[F] %s %s[%d] вдал предупреждение игроку %s [%d|3]. ричина: %s", family_colors[GetFamilyData(GetPlayerIdFamily(playerid), F_COLOR)] >>> 8, GetFamilyRang(fam_id, rang_id), GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), GetPlayerData(to_player, P_FWARN), reason);

	for(new i; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;
		if(GetPlayerData(i, P_FAMILY) == 0) continue;
		if(GetPlayerData(i, P_ADVISOR_BLOCK_CHAT)) continue;

		if(GetPlayerData(i, P_FAMILY) != GetPlayerIdFamily(playerid)) continue;

		SendClientMessage(i, 0x6699CCFF, fmt_msg);
	}

	new uid = GetPlayerAccountID(to_player);
	new warns = GetPlayerData(to_player, P_FWARN);

	if(warns >= 3)
	{
		SendClientMessage(to_player, 0xFF5533FF, " бли исключен из семи. ричина: 3 варна.");

		format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET fwarn=0,family=0,family_rank=1 WHERE id=%d", uid);
		mysql_query(mysql, fmt_msg, false);
		
		SetPlayerData(to_player, P_FWARN, 0);
		SetPlayerData(to_player, P_FAMILY, 0);
	}

	format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET fwarn=%d WHERE id=%d", warns, uid);
	mysql_query(mysql, fmt_msg, false);

	return 1;
}

CMD:funwarn(playerid, params[])
{
    new fam_id = fam_id = GetPlayerIdFamily(playerid),
	    rang_id = GetPlayerData(playerid, P_FAMILY_RANK);

    new rank = GetFamilyData(GetPlayerIdFamily(playerid), F_RANG_UNWARN);

    if(!GetPlayerIdFamily(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "ам недоступна данна функци");

	if(GetPlayerData(playerid, P_FAMILY_RANK) < rank) return Send(playerid, COR_RED, "[шибка]: "c_b"  вас не достаточно нужнй ранг в семе, чтоб снимат семейное предупреждение.");


	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /warn [id игрока] [причина (необзателно)]");

	extract params -> new to_player, string: reason[66];
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(GetPlayerData(to_player, P_FAMILY) != GetPlayerIdFamily(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей семе");

    if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "елз снт варн с самого себ");

	SetPlayerData(to_player, P_FWARN, 		0);
	UpdatePlayerDatabaseInt(to_player, "fwarn", 		0);

	new fmt_msg[128];

    format(fmt_msg, sizeof fmt_msg, "{%06x}[F] %s %s[%d] снл все предупреждени с игрока %s. ричина: %s", family_colors[GetFamilyData(GetPlayerIdFamily(playerid), F_COLOR)] >>> 8, GetFamilyRang(fam_id, rang_id), GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), reason);

	for(new i; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;
		if(GetPlayerData(i, P_FAMILY) == 0) continue;
		if(GetPlayerData(i, P_ADVISOR_BLOCK_CHAT)) continue;

		if(GetPlayerData(i, P_FAMILY) != GetPlayerIdFamily(playerid)) continue;

		SendClientMessage(i, 0x6699CCFF, fmt_msg);
	}

	return 1;
}

CMD:fmute(playerid, params[])
{
	new fam_id = fam_id = GetPlayerIdFamily(playerid),
	    rang_id = GetPlayerData(playerid, P_FAMILY_RANK);

    new rank = GetFamilyData(GetPlayerIdFamily(playerid), F_RANG_MUTE);

    if(!GetPlayerIdFamily(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "ам недоступна данна функци");

	if(GetPlayerData(playerid, P_FAMILY_RANK) < rank) return Send(playerid, COR_RED, "[шибка]: "c_b"  вас не достаточно нужнй ранг в семе, чтоб вдават бан семейного чата.");


	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /fmute [id игрока] [врем в минутах] [причина (необзателно)]");

	extract params -> new to_player, mute_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

    if(GetPlayerData(to_player, P_FAMILY) != GetPlayerIdFamily(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей семе");

	if(GetPlayerData(to_player, P_FAMILY_RANK) >= GetPlayerData(playerid, P_FAMILY_RANK))
		return SendClientMessage(playerid, 0xCECECEFF, "елз вдат мут заместителю/лидеру семи");

	if(!(1 <= mute_time <= 360)) return SendClientMessage(playerid, 0xCECECEFF, "рем должно бт не менше 1 и не болше 360 минут");
	if(GetPlayerData(to_player, P_FMUTE) > 0) return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест мут");
//	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "елз поставит затчку администратору вше по рангу");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "елз поставит затчку самому себе");

	new fmt_msg[150];

	format(fmt_msg, sizeof fmt_msg, "{%06x}[F] %s %s[%d] поставил затчку игроку %s на %d минут. ричина: %s", family_colors[GetFamilyData(GetPlayerIdFamily(playerid), F_COLOR)] >>> 8, GetFamilyRang(fam_id, rang_id), GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), mute_time, reason);

	for(new i; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;
		if(GetPlayerData(i, P_FAMILY) == 0) continue;
		if(GetPlayerData(i, P_ADVISOR_BLOCK_CHAT)) continue;

		if(GetPlayerData(i, P_FAMILY) != GetPlayerIdFamily(playerid)) continue;

		SendClientMessage(i, 0x6699CCFF, fmt_msg);
	}

	SetPlayerData(to_player, P_FMUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "fmute", mute_time * 60);

	SendClientMessage(to_player, 0xCECECEFF, "рем до окончани бана чата семейного чата: {CCCC00}/time");

	return 1;
}

CMD:funmute(playerid, params[])
{
    new fam_id = fam_id = GetPlayerIdFamily(playerid),
        rang_id = GetPlayerData(playerid, P_FAMILY_RANK);

    new rank = GetFamilyData(GetPlayerIdFamily(playerid), F_RANG_UNMUTE);

    if(!GetPlayerIdFamily(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "ам недоступна данна функци");

	if(GetPlayerData(playerid, P_FAMILY_RANK) < rank) return Send(playerid, COR_RED, "[шибка]: "c_b"  вас не достаточно нужнй ранг в семе, чтоб снимат бан семейного чата.");


	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /funmute [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

    if(GetPlayerData(to_player, P_FAMILY) != GetPlayerIdFamily(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей семе");

    if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "елз снт затчку с самого себ");

	else if(GetPlayerData(to_player, P_FMUTE) <= 0) return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет мута");

	new fmt_msg[100];

	format(fmt_msg, sizeof fmt_msg, "{%06x}[F] %s %s[%d] снл затчку с игрока %s", family_colors[GetFamilyData(GetPlayerIdFamily(playerid), F_COLOR)] >>> 8, GetFamilyRang(fam_id, rang_id), GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player));

	for(new i; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;
		if(GetPlayerData(i, P_FAMILY) == 0) continue;
		if(GetPlayerData(i, P_ADVISOR_BLOCK_CHAT)) continue;

		if(GetPlayerData(i, P_FAMILY) != GetPlayerIdFamily(playerid)) continue;

		SendClientMessage(i, 0x6699CCFF, fmt_msg);
	}

	SetPlayerData(to_player, P_FMUTE, 0);
	UpdatePlayerDatabaseInt(to_player, "fmute", 0);

	SendClientMessage(to_player, 0x32a44bFF, "оступ в чат восстановлен");

	return 1;
}

CMD:finvite(playerid, params[])
{
    new rank = GetFamilyData(GetPlayerIdFamily(playerid), F_RANG_INV);

	if(GetPlayerData(playerid, P_FAMILY_RANK) < rank) return Send(playerid, COR_RED, "[шибка]: "c_b"  вас не достаточно нужнй ранг в семе, чтоб приглашат людей в семю.");

	if(!GetPlayerIdFamily(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "ам недоступна данна функци");
//	if(!(9 <= GetPlayerData(playerid, P_FAMILY_RANK) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна сотздателю семи и его заместителм");
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /finvite [id игрока]");

	extract params -> new to_player;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");
	if(GetPlayerData(to_player, P_FAMILY)) return SendClientMessage(playerid, 0xCECECEFF, "тот игрок уже состоит в семе");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 10.0)) return SendClientMessage(playerid, 0xCECECEFF, "грок находитс слишком далеко");

	SendPlayerOfferNotification(playerid, to_player, OFFER_TYPE_FINVITE);
	return 1;
}

CMD:funinvite(playerid, params[])
{
    new rank = GetFamilyData(GetPlayerIdFamily(playerid), F_RANG_UNINV);

	if(GetPlayerData(playerid, P_FAMILY_RANK) < rank) return Send(playerid, COR_RED, "[шибка]: "c_b"  вас не достаточно нужнй ранг в семе, чтоб уволнт людей с семи.");

	if(!GetPlayerIdFamily(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "ам недоступна данна функци");
//	if(!(9 <= GetPlayerData(playerid, P_FAMILY_RANK) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна сотздателю семи и его заместителм");
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /funinvite [id игрока] [причина]");

	extract params -> new to_player, string:reason[32];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(1 <= strlen(reason) <= 32))
		return SendClientMessage(playerid, 0xCECECEFF, "ведите причину уволнени");

	if(GetPlayerData(to_player, P_FAMILY) != GetPlayerIdFamily(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей семе");

	if(GetPlayerData(to_player, P_FAMILY_RANK) >= GetPlayerData(playerid, P_FAMILY_RANK))
		return SendClientMessage(playerid, 0xCECECEFF, "елз уволит уволит заместител/лидера организации");

	FUnInvite(playerid, to_player, reason);

	return 1;
}

CMD:frang(playerid, params[])
{
	if(!GetPlayerIdFamily(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "ам недоступна данна функци");

	new rank = GetFamilyData(GetPlayerIdFamily(playerid), F_RANG_GIVER);

	if(GetPlayerData(playerid, P_FAMILY_RANK) < rank) return Send(playerid, COR_RED, "[шибка]: "c_b"  вас не достаточно нужнй ранг в семе, чтоб измент ранги в семе.");

	//if(!(9 <= GetPlayerData(playerid, P_FAMILY_RANK) <= 10)) return SendClientMessage(playerid, 0xCECECEFF, "ункци доступна сотздателю семи и его заместителм");
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /frang [id игрока] [ранг]");
	extract params -> new to_player, give_rang;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");
	if(GetPlayerData(to_player, P_FAMILY) != GetPlayerIdFamily(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не состоит в ашей семе");
	if(GetPlayerData(to_player, P_FAMILY_RANK) >= GetPlayerData(playerid, P_FAMILY_RANK)) return SendClientMessage(playerid, 0xCECECEFF, "елз уволит уволит заместител/лидера организации");
	if(1 < give_rang > 9) return SendClientMessage(playerid, 0xCECECEFF, "анг от 1 до 9");

	new fmt_msg[512];

	SetPlayerData(to_player, P_FAMILY_RANK, give_rang);
	format(fmt_msg, sizeof fmt_msg, "аш ранг в семе бл изменен на %d (%s)", GetPlayerData(to_player, P_FAMILY_RANK), GetFamilyRang(GetPlayerData(to_player, P_FAMILY), GetPlayerData(to_player, P_FAMILY_RANK)));
	SendClientMessage(to_player, 0x1E90FFFF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, " изменили ранг %s[%d] до %d (%s)",  GetPlayerNameEx(to_player), to_player, GetPlayerData(to_player, P_FAMILY_RANK), GetFamilyRang(GetPlayerData(to_player, P_FAMILY), GetPlayerData(to_player, P_FAMILY_RANK)));
	SendClientMessage(playerid, 0x1E90FFFF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "UPDATE accounts SET family_rank=%d WHERE id=%d", GetPlayerData(to_player, P_FAMILY_RANK), GetPlayerAccountID(to_player));
	mysql_query(mysql, fmt_msg, false);

	return 1;
}

CMD:f(playerid, params[])
{
	if(GetPlayerIdFamily(playerid) == 0) return SendClientMessage(playerid, 0xCECECEFF, " не состоите в семе");
	if(IsPlayerFMuted(playerid) > 0) return Send(playerid, -1, " вас бан семейного чата");
	if(IsPlayerMuted(playerid) > 0) return SendClientMessage(playerid, 0xCECECEFF, "оступ в чат заблокирован. рем до разблокировки: {66CC33}/time");
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /f [текст]");

	new fmt_msg[144],
		fam_id = GetPlayerIdFamily(playerid),
		rang_id = GetPlayerData(playerid, P_FAMILY_RANK) + 1;

	format(fmt_msg, sizeof fmt_msg, "{%06x}[F] %s %s[%d]: %s", family_colors[GetFamilyData(GetPlayerIdFamily(playerid), F_COLOR)] >>> 8, GetFamilyRang(fam_id + 1, rang_id), GetPlayerNameEx(playerid), playerid, params);

	for(new i; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;
		if(GetPlayerData(i, P_FAMILY) == 0) continue;
		if(GetPlayerData(i, P_ADVISOR_BLOCK_CHAT)) continue;

		if(GetPlayerData(i, P_FAMILY) != GetPlayerIdFamily(playerid)) continue;

		SendClientMessage(i, 0x6699CCFF, fmt_msg);
	}
	return 1;
}

CMD:fn(playerid, params[])
{
	if(GetPlayerIdFamily(playerid) == 0) return SendClientMessage(playerid, 0xCECECEFF, " не состоите в семе");
	if(IsPlayerMuted(playerid) > 0) return SendClientMessage(playerid, 0xCECECEFF, "оступ в чат заблокирован. рем до разблокировки: {66CC33}/time");
	if(IsPlayerFMuted(playerid) > 0) return Send(playerid, -1, " вас бан семейного чата");
	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /fn [текст]");

	new fmt_msg[144],
		fam_id = GetPlayerIdFamily(playerid),
		rang_id = GetPlayerData(playerid, P_FAMILY_RANK);

	format(fmt_msg, sizeof fmt_msg, "(( {%06x}OOC: [F] %s %s[%d]: %s ))", family_colors[GetFamilyData(GetPlayerIdFamily(playerid), F_COLOR)] >>> 8, GetFamilyRang(fam_id + 1, rang_id), GetPlayerNameEx(playerid), playerid, params);

	for(new i; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerLogged(i)) continue;
		if(GetPlayerData(i, P_FAMILY) == 0) continue;
		if(GetPlayerData(i, P_ADVISOR_BLOCK_CHAT)) continue;

		if(GetPlayerData(i, P_FAMILY) != GetPlayerIdFamily(playerid)) continue;

		SendClientMessage(i, 0x6699CCFF, fmt_msg);
	}
	return 1;
}

stock ShowChangeNameDialog(playerid)
{
	if(GetPlayerData(playerid, P_DONATE_RUB) < 100) return SendClientMessage(playerid, 0xCECECEFF, " ас недостаточно рублей, требуетс 100");

	Dialog
	(
		playerid, DIALOG_FAMILY_NCHANGE, DIALOG_STYLE_INPUT,
		"мена названи семи",
		"{FFFFFF}ведите название, которое  хотите {ffff00}установит:",
		"алее", "тмена"
	);

	return 1;
}

stock ShowFamilyRangSetMenu(playerid)
{
	new fmt_text[800],
		fam_id = GetPlayerIdFamily(playerid);

 	format(fmt_text, sizeof fmt_text,
	""c_server"[1] "c_b"оманда /finvite | анг доступа: "c_i"%d+\n\
	"c_server"[2] "c_b"оманда /funinvite | анг доступа: "c_i"%d+\n\
	"c_server"[3] "c_b"оманда /fmute | анг доступа: "c_i"%d+\n\
	"c_server"[4] "c_b"оманда /funmute | анг доступа: "c_i"%d+\n\
	"c_server"[5] "c_b"оманда /fwarn | анг доступа: "c_i"%d+\n\
	"c_server"[6] "c_b"оманда /funwarn | анг доступа: "c_i"%d+\n\
	"c_server"[7] "c_b"оманда /frang | анг доступа: "c_i"%d+\n\
	"c_server"[8] "c_b"зтие денег со склада | анг доступа: "c_i"%d+\n\
	"c_server"[9] "c_b"зтие наркотиков со склада | анг доступа: "c_i"%d+\n\
	"c_server"[10] "c_b"зтие атериала со склада | анг доступа: "c_i"%d+\n\
	"c_server"[11] "c_b"зтие патронов со склада | анг доступа: "c_i"%d+",
	GetFamilyData(fam_id, F_RANG_INV),
	GetFamilyData(fam_id, F_RANG_UNINV),
	GetFamilyData(fam_id, F_RANG_MUTE),
	GetFamilyData(fam_id, F_RANG_UNMUTE),
	GetFamilyData(fam_id, F_RANG_WARN),
	GetFamilyData(fam_id, F_RANG_UNWARN),
	GetFamilyData(fam_id, F_RANG_GIVER),
	GetFamilyData(fam_id, F_TAKE_MONEY),
