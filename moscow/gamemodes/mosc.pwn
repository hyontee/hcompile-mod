stock LairdAccEdit_Clear(playerid)
{
    DeletePVar(playerid, "laird_acc_edit_slot");
    DeletePVar(playerid, "laird_acc_edit_acs");
    DeletePVar(playerid, "laird_acc_edit_bone");
    DeletePVar(playerid, "laird_acc_edit_param");
    DeletePVar(playerid, "laird_acc_edit_x");
    DeletePVar(playerid, "laird_acc_edit_y");
    DeletePVar(playerid, "laird_acc_edit_z");
    DeletePVar(playerid, "laird_acc_edit_rx");
    DeletePVar(playerid, "laird_acc_edit_ry");
    DeletePVar(playerid, "laird_acc_edit_rz");
    DeletePVar(playerid, "laird_acc_edit_scale");
    return 1;
}

stock Float:LairdAccEdit_GetValue(playerid, param)
{
    switch(param)
    {
        case 0: return GetPVarFloat(playerid, "laird_acc_edit_x");
        case 1: return GetPVarFloat(playerid, "laird_acc_edit_y");
        case 2: return GetPVarFloat(playerid, "laird_acc_edit_z");
        case 3: return GetPVarFloat(playerid, "laird_acc_edit_rx");
        case 4: return GetPVarFloat(playerid, "laird_acc_edit_ry");
        case 5: return GetPVarFloat(playerid, "laird_acc_edit_rz");
        case 6: return GetPVarFloat(playerid, "laird_acc_edit_scale");
    }

    return 0.0;
}

stock LairdAccEdit_SetValue(playerid, param, Float:value)
{
    switch(param)
    {
        case 0: SetPVarFloat(playerid, "laird_acc_edit_x", value);
        case 1: SetPVarFloat(playerid, "laird_acc_edit_y", value);
        case 2: SetPVarFloat(playerid, "laird_acc_edit_z", value);
        case 3: SetPVarFloat(playerid, "laird_acc_edit_rx", value);
        case 4: SetPVarFloat(playerid, "laird_acc_edit_ry", value);
        case 5: SetPVarFloat(playerid, "laird_acc_edit_rz", value);
        case 6: SetPVarFloat(playerid, "laird_acc_edit_scale", value);
    }

    return 1;
}

stock LairdAccEdit_Apply(playerid)
{
    new slot = GetPVarInt(playerid, "laird_acc_edit_slot");
    new acs_id = GetPVarInt(playerid, "laird_acc_edit_acs");
    new bone = GetPVarInt(playerid, "laird_acc_edit_bone");

    if(slot < 0 || slot >= MAX_PLAYER_ATTACHED_OBJECTS)
        return 0;

    if(acs_id < 0 || acs_id >= sizeof accessory)
        return 0;

    new Float:scale = GetPVarFloat(playerid, "laird_acc_edit_scale");

    SetPlayerAttachedObject
    (
        playerid,
        slot,
        accessory[acs_id][ID_ACCESSORY],
        bone,
        GetPVarFloat(playerid, "laird_acc_edit_x"),
        GetPVarFloat(playerid, "laird_acc_edit_y"),
        GetPVarFloat(playerid, "laird_acc_edit_z"),
        GetPVarFloat(playerid, "laird_acc_edit_rx"),
        GetPVarFloat(playerid, "laird_acc_edit_ry"),
        GetPVarFloat(playerid, "laird_acc_edit_rz"),
        scale,
        scale,
        scale
    );

    return 1;
}

stock LairdAccEdit_ShowMain(playerid)
{
    new dialog_text[768];

    format
    (
        dialog_text,
        sizeof dialog_text,
        "%s: %.3f\n%s: %.3f\n%s: %.3f\n%s: %.3f\n%s: %.3f\n%s: %.3f\n%s: %.3f\n{33CC33}охранит\n{FF9900}бросит\n{FF0000}ход без сохранени",
        laird_acs_param_names[0], GetPVarFloat(playerid, "laird_acc_edit_x"),
        laird_acs_param_names[1], GetPVarFloat(playerid, "laird_acc_edit_y"),
        laird_acs_param_names[2], GetPVarFloat(playerid, "laird_acc_edit_z"),
        laird_acs_param_names[3], GetPVarFloat(playerid, "laird_acc_edit_rx"),
        laird_acs_param_names[4], GetPVarFloat(playerid, "laird_acc_edit_ry"),
        laird_acs_param_names[5], GetPVarFloat(playerid, "laird_acc_edit_rz"),
        laird_acs_param_names[6], GetPVarFloat(playerid, "laird_acc_edit_scale")
    );

    Dialog
    (
        playerid, DIALOG_LAIRD_ACS_EDIT_MAIN, DIALOG_STYLE_LIST,
        "{FFCD00}едактор аксессуара",
        dialog_text,
        "брат", "азад"
    );

    return 1;
}

stock LairdAccEdit_ShowAction(playerid, param)
{
    if(param < 0 || param >= sizeof laird_acs_param_names)
        return 0;

    SetPVarInt(playerid, "laird_acc_edit_param", param);

    new title[96], dialog_text[128];
    format(title, sizeof title, "{FFCD00}%s {FFFFFF}(%.3f)", laird_acs_param_names[param], LairdAccEdit_GetValue(playerid, param));
    format(dialog_text, sizeof dialog_text, "величит\nменшит\nвести вручную");

    Dialog
    (
        playerid, DIALOG_LAIRD_ACS_EDIT_ACTION, DIALOG_STYLE_LIST,
        title,
        dialog_text,
        "брат", "азад"
    );

    return 1;
}

stock LairdAccEdit_StartBySlot(playerid, slot)
{
    new query[256];

    mysql_format
    (
        mysql,
        query,
        sizeof query,
        "SELECT slot, bone, acs_id, x, y, z, rX, rY, rZ, scale FROM accessories_players WHERE player_id=%d AND slot=%d LIMIT 1",
        GetPlayerAccountID(playerid),
        slot
    );

    new Cache:result = mysql_query(mysql, query, true);

    if(!cache_num_rows())
    {
        cache_delete(result);
        return SendClientMessage(playerid, -1, "тот аксессуар не найден в базе."), 1;
    }

    SetPVarInt(playerid, "laird_acc_edit_slot", cache_get_field_content_int(0, "slot"));
    SetPVarInt(playerid, "laird_acc_edit_acs", cache_get_field_content_int(0, "acs_id"));
    SetPVarInt(playerid, "laird_acc_edit_bone", cache_get_field_content_int(0, "bone"));

    SetPVarFloat(playerid, "laird_acc_edit_x", cache_get_field_content_float(0, "x"));
    SetPVarFloat(playerid, "laird_acc_edit_y", cache_get_field_content_float(0, "y"));
    SetPVarFloat(playerid, "laird_acc_edit_z", cache_get_field_content_float(0, "z"));
    SetPVarFloat(playerid, "laird_acc_edit_rx", cache_get_field_content_float(0, "rX"));
    SetPVarFloat(playerid, "laird_acc_edit_ry", cache_get_field_content_float(0, "rY"));
    SetPVarFloat(playerid, "laird_acc_edit_rz", cache_get_field_content_float(0, "rZ"));
    SetPVarFloat(playerid, "laird_acc_edit_scale", cache_get_field_content_float(0, "scale"));

    cache_delete(result);

    LairdAccEdit_Apply(playerid);
    return LairdAccEdit_ShowMain(playerid);
}


stock LairdAccEdit_ShowList(playerid)
{
    new fmt_text[768], query[160], count;

    mysql_format(mysql, query, sizeof query, "SELECT slot, acs_id FROM accessories_players WHERE player_id=%d ORDER BY slot ASC", GetPlayerAccountID(playerid));
    new Cache:result = mysql_query(mysql, query, true);

    new rows = cache_num_rows();

    if(!rows)
    {
        cache_delete(result);
        return SendClientMessage(playerid, -1, "а вас нет надетх аксессуаров."), 1;
    }

    fmt_text[0] = EOS;

    for(new i; i < rows; i++)
    {
        new slot = cache_get_field_content_int(i, "slot");
        new acs_id = cache_get_field_content_int(i, "acs_id");

        if(acs_id < 0 || acs_id >= sizeof accessory)
            continue;

        new fmt_line[92];
        format(fmt_line, sizeof fmt_line, "лот %d - %s\n", slot, accessory[acs_id][NAME_ACCESSORY]);
        strcat(fmt_text, fmt_line);
        SetPlayerListitemValue(playerid, count, slot);
        count++;
    }

    cache_delete(result);

    if(!count)
    {
        return SendClientMessage(playerid, -1, "ксессуар не найден."), 1;
    }

    Dialog
    (
        playerid, DIALOG_LAIRD_ACS_EDIT_LIST, DIALOG_STYLE_LIST,
        "{FFCD00}берите аксессуар",
        fmt_text,
        "брат", "акрт"
    );

    return 1;
}

stock LairdAccEdit_Save(playerid)
{
    new query[320];

    mysql_format
    (
        mysql,
        query,
        sizeof query,
        "UPDATE accessories_players SET bone=%d, x=%f, y=%f, z=%f, rX=%f, rY=%f, rZ=%f, scale=%f WHERE player_id=%d AND slot=%d LIMIT 1",
        GetPVarInt(playerid, "laird_acc_edit_bone"),
        GetPVarFloat(playerid, "laird_acc_edit_x"),
        GetPVarFloat(playerid, "laird_acc_edit_y"),
        GetPVarFloat(playerid, "laird_acc_edit_z"),
        GetPVarFloat(playerid, "laird_acc_edit_rx"),
        GetPVarFloat(playerid, "laird_acc_edit_ry"),
        GetPVarFloat(playerid, "laird_acc_edit_rz"),
        GetPVarFloat(playerid, "laird_acc_edit_scale"),
        GetPlayerAccountID(playerid),
        GetPVarInt(playerid, "laird_acc_edit_slot")
    );

    mysql_query(mysql, query, false);

    return !mysql_errno();
}

stock LairdAccEdit_Reset(playerid)
{
    new acs_id = GetPVarInt(playerid, "laird_acc_edit_acs");

    if(acs_id >= 0 && acs_id < sizeof accessory)
    {
        SetPVarInt(playerid, "laird_acc_edit_bone", accessory[acs_id][BONE_ACCESSORY]);
    }

    SetPVarFloat(playerid, "laird_acc_edit_x", 0.0);
    SetPVarFloat(playerid, "laird_acc_edit_y", 0.0);
    SetPVarFloat(playerid, "laird_acc_edit_z", 0.0);
    SetPVarFloat(playerid, "laird_acc_edit_rx", 0.0);
    SetPVarFloat(playerid, "laird_acc_edit_ry", 0.0);
    SetPVarFloat(playerid, "laird_acc_edit_rz", 0.0);
    SetPVarFloat(playerid, "laird_acc_edit_scale", 1.0);

    return LairdAccEdit_Apply(playerid);
}

stock LairdAccOpenTDList(playerid)
{
    new query[192], fmt_text[1024], acc_line[96], count;

    mysql_format(mysql, query, sizeof query, "SELECT id, acs_id FROM accessory_inventory WHERE player_id=%d AND `use`=1 ORDER BY id DESC", GetPlayerAccountID(playerid));
    new Cache:result = mysql_query(mysql, query, true);
    new rows = cache_num_rows();

    if(!rows)
    {
        cache_delete(result);
        return SendClientMessage(playerid, -1, "а вас нет надетх аксессуаров."), 1;
    }

    fmt_text[0] = EOS;

    for(new i; i < rows; i++)
    {
        new inv_id = cache_get_field_content_int(i, "id");
        new acs_id = cache_get_field_content_int(i, "acs_id");

        if(acs_id < 0 || acs_id >= sizeof accessory)
            continue;

        format(acc_line, sizeof acc_line, "%s\n", accessory[acs_id][NAME_ACCESSORY]);
        strcat(fmt_text, acc_line);

        SetPlayerListitemValue(playerid, count, inv_id);
        count++;
    }

    cache_delete(result);

    if(!count)
        return SendClientMessage(playerid, -1, "адете аксессуар не найден."), 1;

    Dialog
    (
        playerid, DIALOG_LAIRD_ACS_TD_LIST, DIALOG_STYLE_LIST,
        "{FFCD00}берите аксессуар",
        fmt_text,
        "брат", "азад"
    );

    return 1;
}

CMD:editacs(playerid)
{
    return LairdAccOpenTDList(playerid);
}

stock LairdAccGetFreeSlot(playerid)
{
    for(new i; i < MAX_PLAYER_ATTACHED_OBJECTS; i++)
    {
        if(!IsPlayerAttachedObjectSlotUsed(playerid, i))
            return i;
    }
    return -1;
}

stock LairdAccGetSlotByBone(bone)
{
    switch(bone)
    {
        case 1: return 1;
        case 2: return 2;
        case 3: return 3;
        case 4: return 4;
        case 5: return 5;
        case 6, 7: return 6;
        case 8, 9: return 7;
        case 10, 11: return 8;
        case 12, 13: return 9;
    }
    return 1;
}

stock LairdAccGetAcsIdByModel(model_id)
{
    for(new i; i < sizeof accessory; i++)
    {
        if(accessory[i][ID_ACCESSORY] == model_id)
            return i;
    }
    return -1;
}

stock LairdAccGiveAndWear(playerid, acs_id, bool:open_editor = true)
{
    if(acs_id < 0 || acs_id >= sizeof accessory)
        return 0;

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
        return SendClientMessage(playerid, -1, "ккаунт не загружен."), 0;

    new query[384], Cache:result;
    new inv_id = -1, acs_use = 0;
    new bone = accessory[acs_id][BONE_ACCESSORY];
    new slot = LairdAccGetSlotByBone(bone);
    new old_acs_id = -1;

    new bool:has_attach_data = false;
    new Float:x = 0.01, Float:y = 0.01, Float:z = 0.01;
    new Float:rX = 0.01, Float:rY = 0.01, Float:rZ = 0.01;
    new Float:scale = 1.01;

    mysql_format(mysql, query, sizeof query,
        "SELECT id, `use` FROM accessory_inventory WHERE player_id=%d AND acs_id=%d ORDER BY id DESC LIMIT 1",
        account_id, acs_id
    );
    result = mysql_query(mysql, query, true);

    if(cache_num_rows())
    {
        inv_id = cache_get_field_content_int(0, "id");
        acs_use = cache_get_field_content_int(0, "use");
    }
    cache_delete(result);

    if(inv_id == -1)
    {
        GiveAccessory(playerid, acs_id);

        mysql_format(mysql, query, sizeof query,
            "SELECT id, `use` FROM accessory_inventory WHERE player_id=%d AND acs_id=%d ORDER BY id DESC LIMIT 1",
            account_id, acs_id
        );
        result = mysql_query(mysql, query, true);

        if(cache_num_rows())
        {
            inv_id = cache_get_field_content_int(0, "id");
            acs_use = cache_get_field_content_int(0, "use");
        }
        cache_delete(result);

        if(inv_id == -1)
            return SendClientMessage(playerid, -1, "е удалос добавит аксессуар в инвентар."), 0;
    }

    mysql_format(mysql, query, sizeof query,
        "SELECT acs_id FROM accessories_players WHERE player_id=%d AND slot=%d ORDER BY id DESC LIMIT 1",
        account_id, slot
    );
    result = mysql_query(mysql, query, true);
    if(cache_num_rows())
    {
        old_acs_id = cache_get_field_content_int(0, "acs_id");
    }
    cache_delete(result);

    if(old_acs_id != -1 && old_acs_id != acs_id)
    {
        if(IsPlayerAttachedObjectSlotUsed(playerid, slot))
            RemovePlayerAttachedObject(playerid, slot);

        mysql_format(mysql, query, sizeof query,
            "DELETE FROM accessories_players WHERE player_id=%d AND slot=%d",
            account_id, slot
        );
        mysql_query(mysql, query, false);

        mysql_format(mysql, query, sizeof query,
            "UPDATE accessory_inventory SET `use`=0 WHERE player_id=%d AND acs_id=%d",
            account_id, old_acs_id
        );
        mysql_query(mysql, query, false);

        acs_use = 0;
    }

    mysql_format(mysql, query, sizeof query,
        "SELECT slot, bone, x, y, z, rX, rY, rZ, scale FROM accessories_players WHERE player_id=%d AND acs_id=%d ORDER BY id DESC LIMIT 1",
        account_id, acs_id
    );
    result = mysql_query(mysql, query, true);

    if(cache_num_rows())
    {
        slot = cache_get_field_content_int(0, "slot");
        bone = cache_get_field_content_int(0, "bone");
        x = cache_get_field_content_float(0, "x");
        y = cache_get_field_content_float(0, "y");
        z = cache_get_field_content_float(0, "z");
        rX = cache_get_field_content_float(0, "rX");
        rY = cache_get_field_content_float(0, "rY");
        rZ = cache_get_field_content_float(0, "rZ");
        scale = cache_get_field_content_float(0, "scale");
        has_attach_data = true;
    }
    cache_delete(result);

    if(!has_attach_data)
    {
        UseAccessory(playerid, inv_id);

        mysql_format(mysql, query, sizeof query,
            "SELECT slot, bone, x, y, z, rX, rY, rZ, scale FROM accessories_players WHERE player_id=%d AND acs_id=%d ORDER BY id DESC LIMIT 1",
            account_id, acs_id
        );
        result = mysql_query(mysql, query, true);

        if(cache_num_rows())
        {
            slot = cache_get_field_content_int(0, "slot");
            bone = cache_get_field_content_int(0, "bone");
            x = cache_get_field_content_float(0, "x");
            y = cache_get_field_content_float(0, "y");
            z = cache_get_field_content_float(0, "z");
            rX = cache_get_field_content_float(0, "rX");
            rY = cache_get_field_content_float(0, "rY");
            rZ = cache_get_field_content_float(0, "rZ");
            scale = cache_get_field_content_float(0, "scale");
            has_attach_data = true;
        }
        cache_delete(result);
    }

    if(!has_attach_data)
    {
        mysql_format(mysql, query, sizeof query,
            "INSERT INTO accessories_players (player_id, slot, bone, acs_id, x, y, z, rX, rY, rZ, scale) VALUES (%d, %d, %d, %d, %f, %f, %f, %f, %f, %f, %f)",
            account_id, slot, bone, acs_id, x, y, z, rX, rY, rZ, scale
        );
        mysql_query(mysql, query, false);

        mysql_format(mysql, query, sizeof query,
            "UPDATE accessory_inventory SET `use`=1 WHERE id=%d",
            inv_id
        );
        mysql_query(mysql, query, false);

        has_attach_data = true;
    }
    else if(!acs_use)
    {
        mysql_format(mysql, query, sizeof query,
            "UPDATE accessory_inventory SET `use`=1 WHERE id=%d",
            inv_id
        );
        mysql_query(mysql, query, false);
    }

    if(has_attach_data)
    {
        if(IsPlayerAttachedObjectSlotUsed(playerid, slot))
            RemovePlayerAttachedObject(playerid, slot);

        SetPlayerAttachedObject
        (
            playerid,
            slot,
            accessory[acs_id][ID_ACCESSORY],
            bone,
            x,
            y,
            z,
            rX,
            rY,
            rZ,
            scale,
            scale,
            scale
        );
    }

    if(open_editor)
    {
        EditAccessory(playerid, inv_id);
    }

    return 1;
}
stock LairdAccTakeOffAll(playerid)
{
    new query[160];
    new account_id = GetPlayerAccountID(playerid);

    for(new i; i < MAX_PLAYER_ATTACHED_OBJECTS; i++)
    {
        if(IsPlayerAttachedObjectSlotUsed(playerid, i))
            RemovePlayerAttachedObject(playerid, i);
    }

    mysql_format(mysql, query, sizeof query, "UPDATE accessory_inventory SET `use`=0 WHERE player_id=%d", account_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query, "DELETE FROM accessories_players WHERE player_id=%d", account_id);
    mysql_query(mysql, query, false);

    SendClientMessage(playerid, -1, "се аксессуар снт.");
    return 1;
}
stock LoadMySQLSettings()
{
	format(MySQLSettings[REYTIZ_HOST], 128, "%s", REYTIZ_MYSQL_HOST);
	format(MySQLSettings[REYTIZ_USER], 128, "%s", REYTIZ_MYSQL_USER);
	format(MySQLSettings[REYTIZ_PASSWWORD], 128, "%s", REYTIZ_MYSQL_PASS);
	format(MySQLSettings[REYTIZ_DB], 128, "%s", REYTIZ_MYSQL_DB);
	return 1;
}

CMD:radial(playerid)
{
    Gordeev_OpenVehicleRadial(playerid);
    return 1;
}
stock bool:GordeevRadialResolveOwnableVehicle(playerid, &vehicleid)
{
    vehicleid = GetPlayerVehicleID(playerid);

    if(vehicleid == INVALID_VEHICLE_ID || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
    {
        SendClientMessage(playerid, -1, "{ff2400}| {ffffff} должн бт за рулем транспорта");
        return false;
    }

    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        SendClientMessage(playerid, -1, "{ff2400}| {ffffff}оманда доступна толко в личном транспорте");
        return false;
    }

    return true;
}

stock GordeevRadialGrantChip(playerid, chip_type, chip_name[])
{
    new vehicleid;
    if(!GordeevRadialResolveOwnableVehicle(playerid, vehicleid)) return 1;

    if(!GordeevRadialSaveChipUnlock(vehicleid, chip_type, 1))
    {
        SendClientMessage(playerid, -1, "{ff2400}| {ffffff}е удалос сохранит прошивку");
        return 1;
    }

    new msg[96];
    format(msg, sizeof msg, "{66cc00}| {ffffff}рошивка %s вдана. ереключайте в радиалке", chip_name);
    SendClientMessage(playerid, -1, msg);
    return 1;
}

stock GordeevRadialGrantSuspension(playerid, suspension_type, name[])
{
    new vehicleid;
    if(!GordeevRadialResolveOwnableVehicle(playerid, vehicleid)) return 1;

    if(!GordeevRadialSaveSuspensionUnlock(vehicleid, suspension_type, 1))
    {
        SendClientMessage(playerid, -1, "{ff2400}| {ffffff}е удалос сохранит подвеску");
        return 1;
    }

    if(suspension_type == GORDEEV_RADIAL_OP_HYDRAULICS) vInfo[vehicleid][vHydraulics] = 4;
    else if(vInfo[vehicleid][vHydraulics] <= 0) vInfo[vehicleid][vHydraulics] = 1;

    new msg[96];
    format(msg, sizeof msg, "{66cc00}| {ffffff}%s вдана. ереключайте в радиалке", name);
    SendClientMessage(playerid, -1, msg);
    return 1;
}

CMD:drifttuning(playerid, params[])
