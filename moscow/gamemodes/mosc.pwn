						"{CCCC00}рактическа част",
						"{FFFFFF}тлично, тепер приступим к практической части\n"\
						"ам нужно будет немного проехатс по городу на учебном авто\n"\
						"айти его можно на стонке слева от входа\n\n"\
						"{FF9900}нимание! облюдайте осторожност и не превшайте скорост\n"\
						"сли в повредите автомобил экзамен будет провален",
						"ачат", ""
					);
				}
			}
			// -----------------------------------------------------------------
			case DIALOG_ATM:
			{
				if(response)
				{
					switch(listitem+1)
					{
						case 1,2: // нт\оложит с банковского счета
						{
							ShowPlayerATMSelectSumDialog(playerid, !listitem);
						}
						case 3: // аланс банковского счета
						{
							new fmt_str[64];
							format(fmt_str, sizeof fmt_str, "{FFFFFF}а ашем банковском счету {%s}%d руб", GetPlayerBankMoney(playerid) > 0 ? ("00CC00") : ("FF6633"), GetPlayerBankMoney(playerid));

							Dialog
							(
								playerid, DIALOG_ATM_BALANCE, DIALOG_STYLE_MSGBOX,
								"{FFCD00}аланс счета",
								fmt_str,
								"азад", "йти"
							);
						}
						case 4: // нт со счета предприти
						{
							ShowPlayerATMCompanyDialog(playerid, true);
						}
						case 5: // оложит на счет предприти
						{
							ShowPlayerATMCompanyDialog(playerid, false);
						}
						case 6: // ополнит мобилнй телефон
						{
							if(GetPlayerPhone(playerid) != 0)
							{
								Dialog
								(
									playerid, DIALOG_ATM_PHONE_BALANCE, DIALOG_STYLE_INPUT,
									"{FFCD00}ополнение мобилного телефона",
									"{FFFFFF}кажите сумму, на которую хотите пополнит счёт:",
									"отово", "азад"
								);
							}
							else
							{
								SendClientMessage(playerid, 0x999999FF, " ас нет телефона. го можно купит в сотовом салоне");
								ShowPlayerATMDialog(playerid);
							}
						}
						case 7: // езналичнй перевод
						{
							if(GetPlayerLevel(playerid) >= 2)
							{
								Dialog
								(
									playerid, DIALOG_ATM_TRANSFER_MONEY_1, DIALOG_STYLE_INPUT,
									"{FFCD00}езналичнй перевод",
									"{FFFFFF}кажите номер банковского счета:",
									"алее", "тмена"
								);
							}
							else SendClientMessage(playerid, 0x999999FF, "еревод денег доступен со 2 уровн");
						}
						case 8:
						{
							Dialog
							(
								playerid, DIALOG_ATM_TICKET_SELECT, DIALOG_STYLE_LIST,
								"{FFCD00}плата штрафа",
								"1. брат штраф из списка\n"\
								"2. платит штраф по номеру",
								"алее", "тмена"
							);
						}
						case 9: // лаготворителност
						{
							ShowPlayerATMCharityDialog(playerid);
						}
						default:
							return 1;
					}
					ApplyAnimationEx(playerid, "CRIB", "CRIB_Use_Switch", 4.0, 0, 0, 0, 0, 0, 0);
