stock CreateSubwooferLabel(playerid)
{
    DestroySubwooferLabel(playerid);
    
    if(!g_PlayerSubwooferActive[playerid]) return 1;
    
    new vehicleid = g_PlayerSubwooferVehicle[playerid];
    if(!IsValidVehicle(vehicleid)) return 1;

    new Float:x, Float:y, Float:z;
    GetVehiclePos(vehicleid, x, y, z);

    new label_text[128];
    format(label_text, sizeof(label_text), 
        "{FFFFFF}ейчас играет:{FA8072} %s", 
        g_subwoofer_stations[g_PlayerSubwooferStation[playerid]][0]);
    
    g_SubwooferLabel[playerid] = CreateDynamic3DTextLabel(
        label_text,
        0xFFFFFFFF,
        x, y, z + 2.5,
        30.0,
        INVALID_PLAYER_ID,
        INVALID_VEHICLE_ID,
        0,
        0,
        -1,
        30.0
    );
    
    return 1;
}

stock DestroySubwooferLabel(playerid)
{
    if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
    {
        DestroyDynamic3DTextLabel(g_SubwooferLabel[playerid]);
        g_SubwooferLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
    }
    return 1;
}


forward UpdateSubwooferTimer();
public UpdateSubwooferTimer()
{
    foreach(new playerid : Player)
    {
        if(!IsPlayerLogged(playerid)) continue;
        if(!g_PlayerSubwooferActive[playerid]) continue;

        new vehicleid = g_PlayerSubwooferVehicle[playerid];
        if(!IsValidVehicle(vehicleid))
        {
            callcmd::suboff(playerid, "");
            continue;
        }

        if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
        {
            new Float:x, Float:y, Float:z;
            GetVehiclePos(vehicleid, x, y, z);
            
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, g_SubwooferLabel[playerid], E_STREAMER_X, x);
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, g_SubwooferLabel[playerid], E_STREAMER_Y, y);
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, g_SubwooferLabel[playerid], E_STREAMER_Z, z + 2.5);
        }
    }
    return 1;
}

stock StopSubwoofer(playerid)
{
    if(!g_PlayerSubwooferActive[playerid]) return 1;

    foreach(new i : Player)
    {
        if(GetPVarInt(i, "subwoofer_listening") && GetPVarInt(i, "subwoofer_source") == playerid)
        {
            StopAudioStream(i);
            DeletePVar(i, "subwoofer_listening");
            DeletePVar(i, "subwoofer_source");
            SendClientMessage(i, 0xFF6600FF, "узка из автомобил остановлена.");
        }
    }

    StopAudioStream(playerid);

    if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
    {
        DestroyDynamic3DTextLabel(g_SubwooferLabel[playerid]);
        g_SubwooferLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
    }

    g_PlayerSubwooferActive[playerid] = false;
    g_PlayerSubwooferStation[playerid] = -1;
    g_PlayerSubwooferVehicle[playerid] = INVALID_VEHICLE_ID;

    SendClientMessage(playerid, 0xFF6600FF, ""USC"абвуфер включен.");
    return 1;
}

stock StartSubwoofer(playerid, station_index)
{
    new vehicleid = GetPlayerVehicleID(playerid);

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC" должн бт за рулем транспортного средства");

    if(g_PlayerSubwooferActive[playerid])
    {
        callcmd::suboff(playerid, "");
        if(g_PlayerSubwooferStation[playerid] == station_index)
            return 1;
    }

    g_PlayerSubwooferActive[playerid] = true;
    g_PlayerSubwooferStation[playerid] = station_index;
    g_PlayerSubwooferVehicle[playerid] = vehicleid;

    new station_url[128];
    format(station_url, sizeof(station_url), g_subwoofer_stations[station_index][1]);
    PlayAudioStreamURL(playerid, station_url);

    new Float:x, Float:y, Float:z;
    GetVehiclePos(vehicleid, x, y, z);

    new label_text[128];
    format(label_text, sizeof(label_text), "{00FF00}\n{FFFFFF}грает: %s", g_subwoofer_stations[station_index][0]);

    if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
        DestroyDynamic3DTextLabel(g_SubwooferLabel[playerid]);

    g_SubwooferLabel[playerid] = CreateDynamic3DTextLabel(
        label_text,
        0x00FF00FF,
        x, y, z + 2.5,
        30.0,
        INVALID_PLAYER_ID,
        INVALID_VEHICLE_ID,
        0,
        0,
        -1,
        30.0
    );

    new station_name[32];
    format(station_name, sizeof(station_name), "%s", g_subwoofer_stations[station_index][0]);
    
    new msg[128];
    format(msg, sizeof(msg), " включили сабвуфер. грает: {00FF00}%s", station_name);
    SendClientMessage(playerid, 0xFFFFFFFF, msg);
    SendClientMessage(playerid, 0xFFFF00FF, "гроки в радиусе 30 метров слшат вашу музку!");

    UpdateSubwooferTimer();
    return 1;
}

CMD:subwoofer(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xFF6600FF, ""USC" должн находитс в автомобиле");

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC" должн бт за рулем");

    new vehicleid = GetPlayerVehicleID(playerid);
    
    if(GetPlayerOwnableCar(playerid) != vehicleid)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"абвуфер можно включит толко в личном автомобиле");

    new dialog_text[512];
    format(dialog_text, sizeof(dialog_text),
        "{FFFF00}1.{FFFFFF}  \n\
        {FFFF00}2.{FFFFFF}  +\n\
        {FFFF00}3.{FFFFFF}   FM\n\
        {FFFF00}4.{FFFFFF}  \n\
        {FFFF00}5.{FFFFFF}  -\n\
        {FF0000}6.{FFFFFF}  "
    );

    new title[64];
    format(title, sizeof(title), "{FFFF00}еню сабвуфера");

    ShowPlayerDialog(playerid, DIALOG_CAR_SUBWOOFER, DIALOG_STYLE_LIST, title, dialog_text, "брат", "тмена");
    return 1;
}
alias:subwoofer("sb")

CMD:sub(playerid, params[])
{
PlayAudioStreamURL(playerid, "http://rusradio.hostingradio.ru/rusradio128.mp3");
    return 1;
}

CMD:dlsb(playerid)
{
    new info[128], 
    Float:x,
    Float:y,
    Float:z, 
    count = GetVehiclePoolSize() + 1;
    
    if(!g_SubwooferDebugActive[playerid])
    {
        g_SubwooferDebugActive[playerid] = true;
        
        for(new i = 1; i < count; i++)
        {
            GetVehiclePos(i, x, y, z);
            
            new bool:has_subwoofer = false;
            new station_name[32] = "";
            
            foreach(new p : Player)
            {
                if(!IsPlayerLogged(p)) continue;
                if(!g_PlayerSubwooferActive[p]) continue;
                if(g_PlayerSubwooferVehicle[p] != i) continue;
                
                has_subwoofer = true;
                format(station_name, sizeof(station_name), g_subwoofer_stations[g_PlayerSubwooferStation[p]][0]);
                break;
            }
            
            if(has_subwoofer)
            {
                format(info, sizeof info, "{FFFFFF}ейчас играет:{FA8072} %s", station_name);
            }
            else
            {
                format(info, sizeof info, " ");
            }
            
            Veh_3DTEXT[playerid][i] = CreateDynamic3DTextLabel(info, 0xFFFFFFFF, x, y, z + 1.0, 20.0, _, i, 0, -1, -1, playerid);
        }
        
        SendClientMessage(playerid, -1, ""SC" нформаци о сабвуфере включена");
    }
    else
    {   
        g_SubwooferDebugActive[playerid] = false;  
        SendClientMessage(playerid, -1, ""USC" нформаци о сабвуфере включена");
        
        for(new i = 1; i < count; i++)
        {
            DestroyDynamic3DTextLabel(Veh_3DTEXT[playerid][i]);
            Veh_3DTEXT[playerid][i] = Text3D:0;
        }
    }
    return 1;
}

stock UpdateDLSB(playerid)
{
    if(!g_SubwooferDebugActive[playerid]) return 1;
    
    new info[128], 
    Float:x,
    Float:y,
    Float:z, 
    count = GetVehiclePoolSize() + 1;
    
    for(new i = 1; i < count; i++)
    {
        GetVehiclePos(i, x, y, z);
        
        new bool:has_subwoofer = false;
        new station_name[32] = "";
        
        foreach(new p : Player)
        {
            if(!IsPlayerLogged(p)) continue;
            if(!g_PlayerSubwooferActive[p]) continue;
            if(g_PlayerSubwooferVehicle[p] != i) continue;
            
            has_subwoofer = true;
            format(station_name, sizeof(station_name), g_subwoofer_stations[g_PlayerSubwooferStation[p]][0]);
            break;
        }
        
        if(has_subwoofer)
        {
            format(info, sizeof info, "{FFFFFF}ейчас играет:{FA8072} %s", station_name);
        }
        else
        {
            format(info, sizeof info, " ");
        }
        
        if(Veh_3DTEXT[playerid][i] != Text3D:0)
        {
            UpdateDynamic3DTextLabelText(Veh_3DTEXT[playerid][i], 0xFFFFFFFF, info);
        }
        else
        {
            Veh_3DTEXT[playerid][i] = CreateDynamic3DTextLabel(info, 0xFFFFFFFF, x, y, z + 1.0, 20.0, _, i, 0, -1, -1, playerid);
        }
    }
    return 1;
}


forward UpdateDLSBTimer();
public UpdateDLSBTimer()
{
    foreach(new i : Player)
    {
        if(g_SubwooferDebugActive[i])
        {
            UpdateDLSB(i);
        }
    }
    return 1;
}


