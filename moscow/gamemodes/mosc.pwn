// оказат текстдрав
stock ShowSpectatorNewTDs(playerid)
{
    if(specnew_Shown[playerid]) return 1;

    for(new i = 0; i < sizeof(specnew_TD); i++)
    {
        TextDrawShowForPlayer(playerid, specnew_TD[i]);
    }

    specnew_Shown[playerid] = true;
    SelectTextDraw(playerid, 0xFFFFFFFF);
    return 1;
}

stock HideSpectatorNewTDs(playerid)
{
    if(!specnew_Shown[playerid]) return 1;

    for(new i = 0; i < sizeof(specnew_TD); i++)
    {
        TextDrawHideForPlayer(playerid, specnew_TD[i]);
    }

    specnew_Shown[playerid] = false;
    specnew_TargetID[playerid] = INVALID_PLAYER_ID;
    CancelSelectTextDraw(playerid);
    return 1;
}

stock UpdateSpectatorNewNick(playerid)
{
    new target = specnew_TargetID[playerid];
    if(target == INVALID_PLAYER_ID || !IsPlayerConnected(target))
    {
        TextDrawSetString(specnew_TD[9], "ик не вбран");
        return 1;
    }

    new fmt_text[64];
    format(fmt_text, sizeof(fmt_text), "[%d] %s", target, GetPlayerNameEx(target));
    TextDrawSetString(specnew_TD[9], fmt_text);
    return 1;
}

CMD:admintool(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1) return 1;

    new target;
    if(sscanf(params, "d", target))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /admintool [id игрока]");

    if(!IsPlayerConnected(target) || !IsPlayerLogged(target))
        return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

    if(GetPlayerSecretEx(target) >= 1 && target != playerid) // кртност не работает на себ
        return SendClientMessage(playerid, 0xCECECEFF, " игрока ест привелеги скртност");

    specnew_TargetID[playerid] = target;

    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);

    SetPlayerSpectateData(playerid, S_START_POS_X, x);
    SetPlayerSpectateData(playerid, S_START_POS_Y, y);
    SetPlayerSpectateData(playerid, S_START_POS_Z, z);
    SetPlayerSpectateData(playerid, S_START_ANGLE, a);
    SetPlayerSpectateData(playerid, S_START_INTERIOR, GetPlayerInterior(playerid));
    SetPlayerSpectateData(playerid, S_START_VIRTUAL_WORLD, GetPlayerVirtualWorld(playerid));

    StartSpectate(playerid, target);

    ShowSpectatorNewTDs(playerid);
    UpdateSpectatorNewNick(playerid);

    new fmt_text[90];
    format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] следит за %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(target), target);
    SendMessageToAdmins(fmt_text, 0x999999FF);

    return 1;
}

CMD:admintooloff(playerid)
{
    if(GetPlayerAdminEx(playerid) < 1) return 1;

    if(GetPlayerSpectateData(playerid, S_PLAYER) != -1)
    {
        StopSpectate(playerid);
    }

    HideSpectatorNewTDs(playerid);
    SendClientMessage(playerid, -1, " вшли из режима слежки.");
    return 1;
}

CMD:admintoolrefresh(playerid)
{
    if(GetPlayerAdminEx(playerid) < 1) return 1;
    if(!specnew_Shown[playerid]) return SendClientMessage(playerid, -1, " не в режиме слежки");

    UpdateSpectatorNewNick(playerid);
    SendClientMessage(playerid, -1, "нформаци обновлена.");
    return 1;
}

CMD:testnotife(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return ShowNotificationNew(playerid, 2, 5, -1, -1, " должн бт в транспорте!", "");

    ShowNotificationNew(playerid, 4, 10, NOTIFY_ENGINE_START, 0, "авести двигател автомобил", ">>");
    
    return 1;
}

forward CheckPlayersNearOwnableCars();
public CheckPlayersNearOwnableCars()
{
    foreach(new playerid : Player)
    {
        if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) continue;
        if(IsPlayerInAnyVehicle(playerid)) 
        {
            g_PlayerNearCarNotified[playerid] = -1;
            continue;
        }
        
        new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
        
        new closest_vehicle = INVALID_VEHICLE_ID;
        new Float:min_distance = 999999.0;
        
        for(new vehicleid = 1; vehicleid < MAX_VEHICLES; vehicleid++)
        {
            if(!IsValidVehicle(vehicleid)) continue;
            if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR) continue;
            
            new index = GetVehicleData(vehicleid, V_ACTION_ID);
            if(index == -1) continue;
            if(GetOwnableCarData(index, OC_OWNER_ID) != GetPlayerAccountID(playerid)) continue;
            
            new Float:vx, Float:vy, Float:vz;
            GetVehiclePos(vehicleid, vx, vy, vz);
            
            new Float:distance = GetPlayerDistanceFromPoint(playerid, vx, vy, vz);
            if(distance < 3.0 && distance < min_distance)
            {
                min_distance = distance;
                closest_vehicle = vehicleid;
            }
        }
        
        if(closest_vehicle != INVALID_VEHICLE_ID)
        {
            if(g_PlayerNearCarNotified[playerid] != closest_vehicle)
            {
                new index = GetVehicleData(closest_vehicle, V_ACTION_ID);
                if(GetVehicleParam(closest_vehicle, V_LOCK) == VEHICLE_PARAM_ON)
                {
                    ShowNotificationNew(playerid, 4, 8, NOTIFY_OPEN_DOORS, 0, "ткрт двери автомобил", "ткрт");
                    g_PlayerNearCarNotified[playerid] = closest_vehicle;
                }
            }
        }
        else
        {
            g_PlayerNearCarNotified[playerid] = -1;
        }
    }
    return 1;
}

CMD:setmyprefix(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1)
        return SendClientMessage(playerid, 0x999999FF, " не администратор");

    if(!GetPlayerData(playerid, P_ADMIN_LOGGED))
        return SendClientMessage(playerid, 0x999999FF, "начала авторизуйтес в админ панели");

    new fmt_text[MAX_ADMIN_PREFIXES * 32 + 200];
    fmt_text = "{FFFF00}#\t{FFFF00}азвание\t{FFFF00}оступност\n";

    for(new i = 0; i < MAX_ADMIN_PREFIXES; i++)
    {
        new required_level = g_AdminPrefixes[i][PREFIX_LEVEL];
        new can_use = (GetPlayerAdminEx(playerid) >= required_level) ? 1 : 0;

        new row_text[128];
        format(row_text, sizeof(row_text),
            "{FF5A5A}%d.\t{%s}%s\t{%s}%s\n",
            i + 1,
            can_use ? "00FF00" : "808080",
            g_AdminPrefixes[i][PREFIX_NAME],
            can_use ? "00FF00" : "808080",
            can_use ? "оступен" : "едоступен"
        );
        strcat(fmt_text, row_text);
    }

    Dialog(playerid, DIALOG_SETADMIN_PREFIX_SELECT + 1, DIALOG_STYLE_TABLIST_HEADERS,
        "{FF5A5A}SANTA MOBILE RP |{808080} мена тега администратора",
        fmt_text, "брат", "тмена");

    return 1;
}


