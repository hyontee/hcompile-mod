        //GameTextForPlayer(playerid,"~w~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~ЏPAнCЊOPЏ~r~ €AKP‘Џ", 3000, 3);
    }
}

stock bool:TuneWorkshop_IsActive(playerid)
{
	return g_tune_workshop_active[playerid];
}

stock TuneWorkshop_SetCamera(playerid)
{
	SetPlayerCameraPos(playerid, TUNE_WORKSHOP_CAM_POS_X, TUNE_WORKSHOP_CAM_POS_Y, TUNE_WORKSHOP_CAM_POS_Z);
	SetPlayerCameraLookAt(playerid, TUNE_WORKSHOP_CAM_LOOK_X, TUNE_WORKSHOP_CAM_LOOK_Y, TUNE_WORKSHOP_CAM_LOOK_Z);
	return 1;
}

stock TuneWorkshop_SetOccInterior(vehicleid, interiorid, worldid)
{
	for(new i = 0; i < MAX_PLAYERS; i ++)
	{
		if(!IsPlayerConnected(i)) continue;
		if(!IsPlayerInVehicle(i, vehicleid)) continue;

		SetPlayerInterior(i, interiorid);
		SetPlayerVirtualWorld(i, worldid);
	}
	return 1;
}

stock TuneWorkshop_Enter(playerid, vehicleid)
{
	if(!IsValidVehicle(vehicleid)) return 0;
	if(TuneWorkshop_IsActive(playerid)) return 1;

	GetVehiclePos
	(
		vehicleid,
		g_tune_workshop_return_pos[playerid][0],
		g_tune_workshop_return_pos[playerid][1],
		g_tune_workshop_return_pos[playerid][2]
	);
	GetVehicleZAngle(vehicleid, g_tune_workshop_return_pos[playerid][3]);

	g_tune_workshop_vehicle[playerid] = vehicleid;
	g_tune_workshop_interior[playerid] = GetPlayerInterior(playerid);
	g_tune_workshop_world[playerid] = GetPlayerVirtualWorld(playerid);
	g_tune_workshop_active[playerid] = true;

	SetPVarInt(playerid, "playerTune", 1);
	if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
	{
		new own_index = GetVehicleData(vehicleid, V_ACTION_ID);
		if(own_index != -1)
		{
			SetPVarInt(playerid, "ownablecar_id", GetOwnableCarData(own_index, OC_SQL_ID));
		}
	}

	SetVehiclePos(vehicleid, TUNE_WORKSHOP_VEH_X, TUNE_WORKSHOP_VEH_Y, TUNE_WORKSHOP_VEH_Z);
	SetVehicleZAngle(vehicleid, TUNE_WORKSHOP_VEH_A);
	SetVehicleVelocity(vehicleid, 0.0, 0.0, 0.0);
	SetVehicleAngularVelocity(vehicleid, 0.0, 0.0, 0.0);

	LinkVehicleToInterior(vehicleid, TUNE_WORKSHOP_INTERIOR);
	SetVehicleVirtualWorld(vehicleid, g_tune_workshop_world[playerid]);
	TuneWorkshop_SetOccInterior(vehicleid, TUNE_WORKSHOP_INTERIOR, g_tune_workshop_world[playerid]);

	TogglePlayerControllable(playerid, false);
	TuneWorkshop_SetCamera(playerid);
	return 1;
}

stock TuneWorkshop_Exit(playerid)
{
	if(!TuneWorkshop_IsActive(playerid)) return 1;
	if(g_tune_vinyl_active[playerid]) TuneVinyl_Stop(playerid, false, false);

	new vehicleid = g_tune_workshop_vehicle[playerid];

	if(IsValidVehicle(vehicleid))
	{
		LinkVehicleToInterior(vehicleid, g_tune_workshop_interior[playerid]);
		SetVehicleVirtualWorld(vehicleid, g_tune_workshop_world[playerid]);
		SetVehiclePos
		(
			vehicleid,
			g_tune_workshop_return_pos[playerid][0],
			g_tune_workshop_return_pos[playerid][1],
			g_tune_workshop_return_pos[playerid][2]
		);
		SetVehicleZAngle(vehicleid, g_tune_workshop_return_pos[playerid][3]);
		TuneWorkshop_SetOccInterior(vehicleid, g_tune_workshop_interior[playerid], g_tune_workshop_world[playerid]);
	}

	SetPlayerInterior(playerid, g_tune_workshop_interior[playerid]);
	SetPlayerVirtualWorld(playerid, g_tune_workshop_world[playerid]);
	SetCameraBehindPlayer(playerid);
	TogglePlayerControllable(playerid, true);

	g_tune_workshop_active[playerid] = false;
	g_tune_workshop_vehicle[playerid] = INVALID_VEHICLE_ID;

	DeletePVar(playerid, "playerTune");
	return 1;
}

stock load_tuning()
{
	new text_string [ 56 ] ;
	for(new i = 0; i < 4; i ++)
	{
		CreateDynamicPickup(19135, 23, pos_tuning [ i ] [ 0 ], pos_tuning [ i ] [ 1 ], pos_tuning [ i ] [ 2 ], -1, -1 ) ;
		format(text_string, sizeof(text_string), ""SERVER"осигналте дл продолжени", i + 1);
		CreateDynamic3DTextLabel(text_string, -1, pos_tuning [ i ] [ 0 ], pos_tuning [ i ] [ 1 ], pos_tuning [ i ] [ 2 ], 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1);
	}
}

