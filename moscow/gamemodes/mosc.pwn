					case 1: return TuneGui_OpenInput(playerid, DIALOG_TUNE_GUI_STYLE_INPUT, "тайлинг: онировка", "ормат: front rear front_side back_side\nример: 0xAA000000 0xAA000000 0xAA000000 0xAA000000", TUNE_GUI_STYLE_TONER);
					case 2: return TuneGui_OpenInput(playerid, DIALOG_TUNE_GUI_STYLE_INPUT, "тайлинг: вет фар", "ормат: colorRGBA\nример: 0xFFFFFFFF", TUNE_GUI_STYLE_LIGHT);
					case 3: return TuneGui_OpenInput(playerid, DIALOG_TUNE_GUI_STYLE_INPUT, "тайлинг: еон", "ормат: center right left\nример: 0xFF0000FF 0x00FF00FF 0x0000FFFF", TUNE_GUI_STYLE_NEON);
					case 4: return TuneGui_OpenInput(playerid, DIALOG_TUNE_GUI_STYLE_INPUT, "тайлинг: инил", "ормат: texture\nример: v_cust_body_1", TUNE_GUI_STYLE_VINYL);
					case 5: return TuneGui_OpenInput(playerid, DIALOG_TUNE_GUI_STYLE_INPUT, "тайлинг: тробоскоп", "ормат: type\nример: 1", TUNE_GUI_STYLE_STROBO);
					case 6: return TuneGui_OpenInput(playerid, DIALOG_TUNE_GUI_STYLE_INPUT, "тайлинг: омер", "ормат: type number region\nример: 6 A777AA 77", TUNE_GUI_STYLE_PLATE);
