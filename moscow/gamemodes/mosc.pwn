CMD:addpadik(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    new floors, price, rent_price;
    if(sscanf(params, "ddd", floors, price, rent_price))
    {
        SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /addpadik [этажей] [цена квартир] [аренда в ден]");
        SendClientMessage(playerid, 0x999999FF, "ример: {FFFF00}/addpadik 2 650000 3000");
        return 1;
    }
    
    if(floors < 1 || floors > MAX_ENTRANCE_FLOORS)
    {
        new msg[128];
        format(msg, sizeof(msg), "оличество этажей должно бт от 1 до %d", MAX_ENTRANCE_FLOORS);
        return SendClientMessage(playerid, 0x999999FF, msg);
    }
    
    if(price < 1) return SendClientMessage(playerid, 0x999999FF, "ена квартир не может бт менше 1");
    if(rent_price < 1) return SendClientMessage(playerid, 0x999999FF, "рендна плата не может бт менше 1");
    
    // роверем лимит
    if(g_entrance_loaded >= MAX_ENTRANCES)
        return SendClientMessage(playerid, 0xFF6600FF, "остигнут лимит подъездов на сервере!");
    
    new idx = g_entrance_loaded;
    
    // олучаем позицию игрока
    new Float:x, Float:y, Float:z, Float:angle;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, angle);
    
    // аполнем данне
    SetEntranceData(idx, E_SQL_ID, 0);
    SetEntranceData(idx, E_FLOORS, floors);
    SetEntranceData(idx, E_POS_X, x);
    SetEntranceData(idx, E_POS_Y, y);
    SetEntranceData(idx, E_POS_Z, z);
    SetEntranceData(idx, E_EXIT_POS_X, x + 1.0);
    SetEntranceData(idx, E_EXIT_POS_Y, y + 1.0);
    SetEntranceData(idx, E_EXIT_POS_Z, z);
    SetEntranceData(idx, E_EXIT_ANGLE, angle);
    SetEntranceData(idx, E_STATUS, -1);
    
    // охранем в 
    new query[512];
    mysql_format
    (
        mysql, query, sizeof query,
        "INSERT INTO entrances (floors, pos_x, pos_y, pos_z, exit_x, exit_y, exit_z, exit_angle) \
        VALUES (%d, %f, %f, %f, %f, %f, %f, %f)",
        floors, x, y, z, x + 1.0, y + 1.0, z, angle
    );
    
    new Cache:result = mysql_query(mysql, query, true);
    
    if(mysql_errno())
    {
        printf("[addpadik] SQL ERROR: %d", mysql_errno());
        printf("[addpadik] QUERY: %s", query);
        cache_delete(result);
        return SendClientMessage(playerid, 0xFF6600FF, "шибка  при создании подъезда!");
    }
    
    new sql_id = cache_insert_id();
    cache_delete(result);
    
    if(sql_id <= 0)
    {
        SendClientMessage(playerid, 0xFF6600FF, "шибка: подъезд не получил ID в базе даннх!");
        return 1;
    }
    
    SetEntranceData(idx, E_SQL_ID, sql_id);
    g_entrance_loaded++;
    
    // оздаём пикап входа
    SetEntranceData(idx, E_PICKUP_ID, CreatePickup(1273, 23, x, y, z, 0, PICKUP_ACTION_TYPE_ENTRANCE_ENT, idx));
    SetEntranceData(idx, E_MAP_ICON, CreateDynamicMapIcon(x, y, z, 31, 0, 0, 0, -1, STREAMER_MAP_ICON_SD, MAPICON_LOCAL));
    
    // екст дл пикапа подъезда
    new label_text[256];
    format(label_text, sizeof(label_text), 
        "{FFFF00}«ход в подъезд»\n\
        {00FF7F}| {FFFFFF}омер подъезда: {FFFF00}%d\n\
        {00FF7F}| {FFFFFF}оличество этажей: {FFFF00}%d",
        idx + 1, floors);
    
    SetEntranceData(idx, E_LABEL, CreateDynamic3DTextLabel(label_text, 0x3399FFFF, x, y, z + 1.0, 15.0));
    
    // Ё 
    for(new floor = 0; floor < MAX_ENTRANCE_FLOORS; floor++)
    {
        for(new flat = 0; flat < 4; flat++)
        {
            g_flat_house_id[idx][floor][flat] = -1;
        }
    }
    
    new total_flats = 0;
    for(new floor = 0; floor < floors; floor++)
    {
        new floor_label[64];
        format(floor_label, sizeof(floor_label), "таж: %d", floor + 1);
        CreateDynamic3DTextLabel(floor_label, 0xFFCD00FF, 9.6966, 1376.0, 1508.4100 + 0.7, 8.0, _, _, _, _, floor + 2);
        
        for(new flat_on_floor = 0; flat_on_floor < 4; flat_on_floor++)
        {
            //     
            new flat_label[128];
            format(flat_label, sizeof(flat_label),
                "{FFFF00}«вартира»\n\
                {00FF7F}| {FFFFFF}омер квартир: {FFFF00}%d",
                total_flats + 1);
            
            CreateDynamic3DTextLabel(flat_label, 0x3399FFFF, 
                g_entrance_flat_pos[flat_on_floor][0], 
                g_entrance_flat_pos[flat_on_floor][1], 
                g_entrance_flat_pos[flat_on_floor][2] + 1.6, 
                6.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, floor + 2, -1, -1, 50.0);
            
            new flat_id = total_flats;
            
            //   - Я (1273)
            CreatePickup(
                1273,
                23,
                g_entrance_flat_pos[flat_on_floor][0],
                g_entrance_flat_pos[flat_on_floor][1],
                g_entrance_flat_pos[flat_on_floor][2],
                -1,
                PICKUP_ACTION_TYPE_ENTRANCE_FLA,
                flat_id
            );
            
            g_entrance_flat[idx][floor][flat_on_floor] = -1;
            
            total_flats++;
        }
    }
    
    // ог
    new city[MAX_ZONES_NAME + 1], area[MAX_ZONES_NAME + 1];
    GetCityName(x, y, city);
    GetAreaName(x, y, area);
    
    new msg[256];
    format(msg, sizeof(msg), "[A] %s[%d] создал подъезд №%d (%s / %s) | тажей: %d | ена: %d | ренда: %d",
        GetPlayerNameEx(playerid), playerid, idx, city, area, floors, price, rent_price);
    SendMessageToAdmins(msg, 0x66CC33FF);
    
    format(msg, sizeof(msg), ""SC"одъезд №%d успешно создан! SQL ID: %d", idx + 1, sql_id);
    SendClientMessage(playerid, 0x66CC33FF, msg);
    SendClientMessage(playerid, 0x3399FFFF, "вартир создан. сползуйте AEdit дл настройки цен.");
    
    return 1;
}

public: LoadFamilyCars()
{
    new rows, vehicleid;
    new Cache: result;
    result = mysql_query(mysql, "SELECT * FROM `family_auto` WHERE 1", true);
    rows = cache_num_rows();
    for(new idx; idx < rows; idx ++)
    {
        SetFamilyCarData(idx, F_SQL_ID,       cache_get_field_content_int(idx, "id"));
        new idm = GetFamilyData(idx, F_SQL_ID);
        SetFamilyCarData(idm, F_OWNER_ID,     cache_get_field_content_int(idx, "owner_id"));
        SetFamilyCarData(idm, F_MODEL_ID,     cache_get_field_content_int(idx, "model_id"));
        SetFamilyCarData(idm, F_COLOR_1,      cache_get_field_content_int(idx, "color_1"));
        SetFamilyCarData(idm, F_COLOR_2,      cache_get_field_content_int(idx, "color_2"));
        SetFamilyCarData(idm, F_RANG,         cache_get_field_content_int(idx, "rang"));
        SetFamilyCarData(idm, F_POS_X,        cache_get_field_content_float(idx, "pos_x"));
        SetFamilyCarData(idm, F_POS_Y,        cache_get_field_content_float(idx, "pos_y"));
        SetFamilyCarData(idm, F_POS_Z,        cache_get_field_content_float(idx, "pos_z"));
        SetFamilyCarData(idm, F_ANGLE,        cache_get_field_content_float(idx, "angle"));
        SetFamilyCarData(idm, OC_FUEL,        cache_get_field_content_float(idx, "mileage"));
        
        vehicleid = CreateVehicle
        (
            GetFamilyCarData(idm, F_MODEL_ID),
            GetFamilyCarData(idm, F_POS_X),
            GetFamilyCarData(idm, F_POS_Y),
            GetFamilyCarData(idm, F_POS_Z),
            GetFamilyCarData(idm, F_ANGLE),
            GetFamilyCarData(idm, F_COLOR_1),
            GetFamilyCarData(idm, F_COLOR_2),
            -1, 0,
            VEHICLE_ACTION_TYPE_FAMILY_CAR,
            GetFamilyData(idx, F_SQL_ID)
        );
        
        if(vehicleid != INVALID_VEHICLE_ID)
        {
            CreateVehicleLabel(vehicleid, GetFamilyData(GetFamilyCarData(idm, F_OWNER_ID), F_NAME), 0x6666CCEE, 0.0, 0.0, 1.3, 20.0);
            SetVehicleParam(vehicleid, V_LOCK, bool: cache_get_field_content_int(0, "status"));
            SetVehicleData(vehicleid, V_MILEAGE, cache_get_field_content_float(0, "mileage"));
        }
    }
    g_family_car_loaded = rows;
    cache_delete(result);
    printf("[FamilyCars]: Aвто загружено: %d", g_family_car_loaded);
}

stock GetFreeFamilyCarID()
{
    for(new idx; idx < sizeof g_ownable_car; idx ++)
    {
        if(GetOwnableCarData(idx, OC_CREATE)) continue;

        return idx;
    }

    return -1;
}

public: SaveFamilyCar(vehicleid)
{
    if(IsAFamilyCar(vehicleid))
    {
        new query[300];
        new index = GetVehicleData(vehicleid, V_ACTION_ID);
        new Float: health;
        GetVehicleHealth(vehicleid, health);
        mysql_format(mysql, query, sizeof query,
            "UPDATE `family_auto` SET pos_x=%f, pos_y=%f, pos_z=%f, angle=%f WHERE id=%d LIMIT 1",
            GetFamilyCarData(index, F_POS_X),
            GetFamilyCarData(index, F_POS_Y),
            GetFamilyCarData(index, F_POS_Z),
            GetFamilyCarData(index, F_ANGLE),
            index-1
        );
        mysql_query(mysql, query, false);
        return mysql_errno();
    }
    return -1;
}

public OnIncomingRPC(playerid, rpcid, BitStream:bs)
{
    if(rpcid != 97) return 1;

    new action;
    if(!BS_ReadUint32(bs, action)) return 1;

    switch(action)
    {
        case 3:
        {
            new vehicleid;
            new turnStatus;

            if(!BS_ReadUint16(bs, vehicleid)) return 1;
            if(!BS_ReadUint8(bs, turnStatus)) return 1;

            if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 1;
            if(!IsValidVehicle(vehicleid)) return 1;
            if(GetPlayerVehicleID(playerid) != vehicleid) return 1;
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
            if(turnStatus < 1 || turnStatus > 3) return 1;

            if(TurnSignalState[vehicleid] == turnStatus && TurnSignalDriver[vehicleid] == playerid)
            {
                StopVehicleTurnSignal(vehicleid);
                printf("[TurnSignal] Player %d turned OFF turn signal on vehicle %d", playerid, vehicleid);
            }
            else
            {
                StopVehicleTurnSignal(vehicleid);
                StartVehicleTurnSignal(playerid, vehicleid, turnStatus);

                new statusText[16];
                if(turnStatus == 1) statusText = "LEFT";
                else if(turnStatus == 2) statusText = "RIGHT";
                else statusText = "HAZARD";

                printf("[TurnSignal] Player %d turned ON %s turn signal on vehicle %d (Model: %d)",
                       playerid, statusText, vehicleid, GetVehicleModel(vehicleid));
            }
            return 1;
        }

        case 4:
        {
            callcmd::radial(playerid);
            return 1;
        }
    }

    return 1;
}

stock SetVehicleVinyl(vehicleid, texture[], setvalue=0)
{
	if(setvalue) format(vInfo[vehicleid][vVinylTexture], 16, texture); 
	foreach(new playerid : streamed_players_in_veh[vehicleid]) SetVehicleVinylForPlayer(playerid, vehicleid, texture);
} 

stock SetVehicleVinylForPlayer(playerid, vehicleid, texture[])
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, vehicleid);
	BS_WriteValue(bitstream, PR_UINT8, 12);

	BS_WriteValue(bitstream, PR_UINT8, strlen(texture));
	BS_WriteValue(bitstream, PR_STRING, texture); 

	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
}

CMD:setvinyl(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsPlayerInAnyVehicle(playerid)) return 1;
  
    new texture[32];
    if(sscanf(params, "s[32]", texture)) 
        return SendClientMessage(playerid, -1, "сползование: /setvinyl [текстура]");
    
    SetVehicleVinyl(vehicleid, texture, 1);
    SendClientMessage(playerid, -1, "инил установлен!");
    return 1;
}

stock BT_GetTuneVehicle(playerid)
{
	if(!IsPlayerInAnyVehicle(playerid))
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff} должн находитс в транспорте");
		return INVALID_VEHICLE_ID;
	}

	new vehicleid = GetPlayerVehicleID(playerid);
	if(!IsValidVehicle(vehicleid))
	{
		SendClientMessage(playerid, -1, "{ff2400}| {ffffff}ранспорт не найден");
		return INVALID_VEHICLE_ID;
	}
	return vehicleid;
}

stock BT_RGBAtoARGB(rgba)
{
	return ((rgba & 0xFFFFFF00) >> 8) | ((rgba & 0xFF) << 24);
}


stock BT_SetToner(veh, front, rear, front_side, back_side)
{
	foreach(new i : streamed_players_in_veh[veh])
	{
		BT_SetTonerFP(i, veh, front, rear, front_side, back_side);
	}
	return 1;
}

stock BT_SetTonerFP(playerid, veh, front, rear, front_side, back_side)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, veh);
	BS_WriteValue(bitstream, PR_UINT8, 0);
	BS_WriteValue(bitstream, PR_UINT32, front);
	BS_WriteValue(bitstream, PR_UINT32, rear);
	BS_WriteValue(bitstream, PR_UINT32, front_side);
	BS_WriteValue(bitstream, PR_UINT32, back_side);
	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
	return 1;
}

