		// -------------------------------------------------------------------------
		cache_delete(result);

		new
			Node:json_spawn = JSON_Object(),
			Node:json_spawn_array = JSON_Array(),
			outcoming_data[256];

		json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(1)));

		if(GetPlayerData(playerid, P_HOUSE) != -1)
		{
			json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(4)));
		}
		if (GetPlayerTeamEx(playerid))
		{
			json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(0)));
		}
		if(GetPlayerData(playerid, P_LAST_POS_X) != 0.0 && GetPlayerData(playerid, P_LAST_POS_Y) != 0.0 && GetPlayerData(playerid, P_LAST_POS_Z) != 0.0)
		{
			json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(2)));
		}
		if(GetPlayerIdFamily(playerid) != -1 && family[GetPlayerIdFamily(playerid)][family_house] != -1)
		{
			json_spawn_array = JSON_Append(json_spawn_array, JSON_Array(JSON_Int(6)));
		}

		JSON_SetArray(json_spawn, "m", json_spawn_array);
    	JSON_SetInt(json_spawn, "o", 1);

		ShowPlayerGUI(playerid, 50, json_spawn);

		SetPlayerSpawnInit(playerid);
		SpawnPlayer(playerid);
		LoadPlayerGraphicSettings(playerid);
		LoadPlayerSimCards(playerid);

			mysql_format(mysql, query, sizeof query, "UPDATE accounts SET last_ip='%e',last_login=%d, online = 1 WHERE id=%d LIMIT 1", GetPlayerIpEx(playerid), time, GetPlayerAccountID(playerid));
			mysql_tquery(mysql, query, "", "");


			if(IsPlayerHasDonations(playerid))
				SendClientMessage(playerid, 0x3399FFFF, " ас ест нове пополнени счёта. ведите {ff9900}/donat{3399ff}, чтоб зачислит их");

			new player_admin_rank = GetPlayerAdminEx(playerid);

			if(player_admin_rank)
			{
				AdminAuthorization(playerid);
			}

			SetTimerEx("LoadInvDanya", 500, false, "i", playerid);

            new player_premium = GetPlayerData(playerid, P_PREMIUM_DATE);

			if(player_premium)
			{
				if((player_premium - time) > 0)
				{
				    new premium_day,
				        premium_month,
				        premium_year;

					timestamp_to_date(player_premium, premium_year, premium_month, premium_day);

					format
					(
						query, sizeof query,
						"аш VIP статус действует до {FFFFFF}%02d.%02d.%d",
						premium_day, premium_month, premium_year
					);
					SendClientMessage(playerid, 0xEC174FFF, query);
				}
				else
				{
				    format(query, sizeof query, "рок действи VIP статуса истёк. л продлени подписки {1E90FF}[одсказка]:{FFFFFF} {FFFFFF}/mn > ополнително");
					SendClientMessage(playerid, 0xEC174FFF, query);

					SetPlayerData(playerid, P_PREMIUM, 					0);

					UpdatePlayerDatabaseInt(playerid, "premium", 		0);
				}
			}

			if(GetPlayerData(playerid, P_WARN) > 0)
			{
				if(time > GetPlayerData(playerid, P_WARN_TIME))
				{
					SetPlayerData(playerid, P_WARN, 0);
					SetPlayerData(playerid, P_WARN_TIME, 0);
				}
				else
				{
					format(query, sizeof query, "оличество предупреждений: %d из 3", GetPlayerData(playerid, P_WARN));
					SendClientMessage(playerid, 0xFF6600FF, query);
					SendClientMessage(playerid, 0xFF6600FF, "осле 3 предупреждени аккаунт будет заблокирован");
				}
			}
			if((buffer = GetPlayerHouse(playerid, HOUSE_TYPE_HOME)) != -1)
			{
				if(GetElapsedTime(GetHouseData(buffer, H_RENT_DATE), time, CONVERT_TIME_TO_DAYS) < 5)
				{
					SendClientMessage(playerid, 0xFFB500FF, "рок оплат ашего дома скоро заканчиваетс");
				}
			}
			if((buffer = GetPlayerHouse(playerid, HOUSE_TYPE_HOTEL)) != -1)
			{
				new room_id = GetPlayerData(playerid, P_HOUSE_ROOM);
				if(GetElapsedTime(GetHotelData(buffer, room_id, H_RENT_DATE), time, CONVERT_TIME_TO_DAYS) < 5)
				{
					SendClientMessage(playerid, 0xFFB500FF, " ас осталос мало оплаченнх дней в гостинице");
				}
			}
			if((buffer = GetPlayerBusiness(playerid)) != -1)
			{
				if(GetElapsedTime(GetBusinessData(buffer, B_RENT_DATE), time, CONVERT_TIME_TO_DAYS) < 5)
				{
					SendClientMessage(playerid, 0xFFB500FF, "рок аренд ашего бизнеса скоро заканчиваетс");
				}
			}
			if((buffer = GetPlayerFuelStation(playerid)) != -1)
			{
				if(GetElapsedTime(GetFuelStationData(buffer, FS_RENT_DATE), time, CONVERT_TIME_TO_DAYS) < 5)
				{
					SendClientMessage(playerid, 0xFFB500FF, "рок аренд ашей  скоро заканчиваетс");
				}
			}
			SetPlayerInit(playerid);
			SendPlayerLoginWelcome(playerid);
			//SetTimerEx("PlayerOwnableCarInit", 250, false, "i", playerid);

			//CallLocalFunction("PlayerOwnableCarInit", "i", playerid);
	}
}

public: ShowPlayerLoginDialog(playerid, step, wrong_pass)
{
    if(GetPVarInt(playerid, "gordeev_auth_gui")) return 1;
	if(GetPlayerData(playerid, P_ACCOUNT_STATE) != ACCOUNT_STATE_LOGIN) return 0;

	new fmt_str[256];
	switch(step)
	{
		case LOGIN_STATE_CHECK_BAN:
{
    new Cache: result;
    new query[128];

    format(query, sizeof query, "SELECT * FROM ban_list WHERE user_id=%d LIMIT 1", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);

    if(cache_num_rows())
    {
        new unban_time = cache_get_field_content_int(0, "ban_time");
        new ban_days = GetElapsedTime(unban_time, gettime(), CONVERT_TIME_TO_DAYS);
        
        if(ban_days > 0)
        {
            new reason[128];
            new admin_name[24];
            new admin_nick[24];
            new player_name[24];
            new ban_time = cache_get_field_content_int(0, "time");
            new ban_date_str[32];
            new unban_date_str[32];
            new year, month, day, hour, minute, second;
            
            cache_get_field_content(0, "description", reason, mysql, sizeof(reason));
            cache_get_field_content(0, "admin_name", admin_name, mysql, sizeof(admin_name));
            cache_get_field_content(0, "player_name", player_name, mysql, sizeof(player_name));
            
            // ата вдачи
            timestamp_to_date(ban_time, year, month, day, hour, minute, second);
            format(ban_date_str, sizeof(ban_date_str), "%02d.%02d.%d в %02d:%02d", day, month, year, hour, minute);
            
            // ата разблокировки
            timestamp_to_date(unban_time, year, month, day, hour, minute, second);
            format(unban_date_str, sizeof(unban_date_str), "%02d.%02d.%d в %02d:%02d", day, month, year, hour, minute);
            
            // охранем данне
            format(g_BanPlayerName[playerid], sizeof(g_BanPlayerName[]), "%s", player_name);
            format(g_BanAdmin[playerid], sizeof(g_BanAdmin[]), "%s", admin_name);
            format(g_BanReason[playerid], sizeof(g_BanReason[]), "%s", reason);
            g_BanInfo[playerid][0] = GetPlayerAccountID(playerid);
            g_BanInfo[playerid][1] = ban_time;
            g_BanInfo[playerid][2] = unban_time;
            g_BanInfo[playerid][5] = ban_days;
            
            // оказваем диалог
            ShowBanDialog(playerid);
            
            // икаем через 5 секунд, чтоб игрок успел прочитат
            SetTimerEx("KickPlayerAfterBan", 5000, false, "i", playerid);
            
            cache_delete(result);
            return 1;
        }
        else
        {
            // сли бан истек - удалем из 
            format(query, sizeof query, "DELETE FROM ban_list WHERE user_id=%d LIMIT 1", GetPlayerAccountID(playerid));
            mysql_tquery(mysql, query, "", "");
            
            // родолжаем вход
            CallLocalFunction("ShowPlayerLoginDialog", "iii", playerid, step + 1, false);
        }
    }
    else
    {
        CallLocalFunction("ShowPlayerLoginDialog", "iii", playerid, step + 1, false);
    }

    return cache_delete(result);
}
		case LOGIN_STATE_PASSWORD:
		{
			format
			(
				fmt_str, sizeof fmt_str,
				"{FFFFFF}обро пожаловат на {FF6347}"SERVER_NAME"{ffffff}!\n"\
				"ккаунт с ашим ником зарегистрирован\n\n"\
				"огин: {66CC66}%s\n",
				GetPlayerNameEx(playerid)
			);
			if(wrong_pass)
			{
				new ch[3];
				new attemps = GetPlayerData(playerid, P_PASS_ATTEMPS);

				valstr(ch, attemps);

				strcat(fmt_str, "{FF3300}евернй парол! сталос попток: ");
				strcat(fmt_str, ch);

				AddPlayerData(playerid, P_PASS_ATTEMPS, -, 1);
				switch(attemps)
				{
					case 0:
					{
						Dialog
						(
							playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
							"{FF9933}имит попток авторизации",
							"{FFFFFF} ввели неправилнй парол 3 раза подрд", // . аш IP адрес забанен на сутки
							"акрт", ""
						);
						Kick:(playerid, " ");

						return 1;

						// BanEx(playerid, "имит попток авторизации");
						// return AddBan(0, gettime(), 1, GetPlayerIpEx(playerid), "имит попток авторизации", "истема безопасности");
					}
					case 1:
					{
						SendClientMessage(playerid, 0xFF6600FF, "ри неправилном вводе парол  будете забанен");
					}
				}
				PlayerPlaySound(playerid, 1053, 0.0, 0.0, 0.0);
			}
			else strcat(fmt_str, "{FFFFFF}ведите парол от аккаунта:");

			Dialog(playerid, DIALOG_LOGIN, DIALOG_STYLE_INPUT, "{66CCFF}вторизаци", fmt_str, "ойти", "тмена");
		}
		case LOGIN_STATE_PHONE: // ввод 5 послед. цифр телефона
		{
			if(GetPlayerData(playerid, P_REQUEST_PHONE))
			{
				if(!wrong_pass)
				{
					new phone[13];

					strmid(phone, GetPlayerData(playerid, P_SETTING_PHONE), 0, strlen(GetPlayerData(playerid, P_SETTING_PHONE)) - 5);
					strcat(phone, "*****");

					format
					(
						fmt_str, sizeof fmt_str,
						"{FFFFFF}истема безопасности запрашивает ввод\n"\
						"ашего мобилного телефона\n\n{FFCD00}%s\n\n"\
						"{FFFFFF}ведите последние 5 цифр номера:",
						phone
					);
					Dialog(playerid, DIALOG_LOGIN, DIALOG_STYLE_INPUT, "{66CCFF}обилнй телефон", fmt_str, "вести", "ход");
				}
				else
				{
					SendClientMessage(playerid, 0xFF0000FF, "омер мобилного телефона введен неверно. оступ запрещен");
					Kick:(playerid);
				}
			}
			else
			{
				return CallLocalFunction("ShowPlayerLoginDialog", "iii", playerid, step + 1, false);
			}
		}
		case LOGIN_STATE_PIN_CODE: // ввод пин кода
		{
			if(GetPlayerData(playerid, P_REQUEST_PIN))
			{
				if(wrong_pass)
				{
					SendClientMessage(playerid, 0xFF0000FF, "PIN-код введен неверно. оступ запрещен");
					Kick:(playerid);
				}
				else ShowPlayerPinCodePTD(playerid, PIN_CODE_STATE_LOGIN_CHECK);
			}
			else
			{
				return CallLocalFunction("ShowPlayerLoginDialog", "iii", playerid, step + 1, false);
			}
		}
		case LOGIN_STATE_LOAD_ACC:
		{
			SetPlayerData(playerid, P_AUTH_TIME, -1);
			LoadPlayerData(playerid);
		}
	}
	SetPlayerData(playerid, P_ACCOUNT_STEP_STATE, step);

	return 1;
}

