		strdel(str, macros, macros + strlen("/todo "));
		return callcmd::todo(playerid, str);//pc_cmd_me (if pawn.cmd)
	}
	if(strfind(str, "/f", true) != -1)
	{
		new macros = strfind(str, "/f ");
