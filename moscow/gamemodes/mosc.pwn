stock GetNearestFlat(playerid)
{
    new Float: x_pos, Float: y_pos, Float: z_pos;
        GetPlayerPos(playerid, x_pos, y_pos, z_pos);
    new closest_apartment_index = -1;
    new Float: min_distance_sq = -1.0;

    for(new i = 0; i < sizeof(g_entrance_flat_pos); i++)
    {
        new Float: apt_x = g_entrance_flat_pos[i][0];
        new Float: apt_y = g_entrance_flat_pos[i][1];
        new Float: apt_z = g_entrance_flat_pos[i][2];

        new Float: distance_sq = ((apt_x - x_pos) * (apt_x - x_pos)) +
                                 ((apt_y - y_pos) * (apt_y - y_pos)) +
                                 ((apt_z - z_pos) * (apt_z - z_pos));

        if(closest_apartment_index == -1 || distance_sq < min_distance_sq)
        {
            min_distance_sq = distance_sq;
            closest_apartment_index = i;
        }
    }
    
    if(closest_apartment_index != -1)
    {
        printf("[DEBUG] GetClosestApartment: ама близка квартира - %d", closest_apartment_index + 1);
        return closest_apartment_index + 1;
    }

    printf("[DEBUG] GetClosestApartment: е удалос найти ближайшую квартиру.");
    return 0;
}

stock GetVehicleModelName(modelid, name[], size = 24)
{
    if (IsValidVehicleInfoModel(modelid))
    {
        format(name, size, "%s", GetVehicleInfo(modelid - 400, VI_NAME));
    }
    else
    {
        format(name, size, "?????? %d", modelid);
    }
}

stock ShowPlayerPrizeGUI(playerid, model_id, message[], header[], render_type, Float:rot_x, Float:rot_y, Float:rot_z, Float:zoom)
{
    new Node:json = JSON_Object();
   
    JSON_SetInt(json, "o", 1); 
    JSON_SetInt(json, "g", 0); 
    JSON_SetInt(json, "s", render_type); 
    JSON_SetInt(json, "r", model_id);
    JSON_SetFloat(json, "q1", rot_x);    
    JSON_SetFloat(json, "q2", rot_y); 
    JSON_SetFloat(json, "q3", rot_z); 
    JSON_SetFloat(json, "z", zoom);   
    JSON_SetString(json, "m", message, strlen(message));
    JSON_SetString(json, "h", header, strlen(header));
    JSON_SetString(json, "n", "");  
    
    SendPacketToClient(playerid, 31, json);
    JSON_Cleanup(json);
    return 1;
}

stock ShowTutorialHintGUI(playerid, text[])
{
    new Node:json = JSON_Object();
   
    JSON_SetInt(json, "o", 1);
    JSON_SetInt(json, "g", 0);
    JSON_SetInt(json, "m", 0);
    JSON_SetString(json, "s", text, strlen(text));
    
    SendPacketToClient(playerid, 39, json);
    JSON_Cleanup(json);
    return 1;
}


stock SendCreateWayPoint(playerid, waypoint_id, Float:x, Float:y, Float:z, icon_id, color, Float:dist, interior)
{
    new BitStream:bs = BS_New();
    BS_WriteValue
    (
        bs,
        PR_UINT16, waypoint_id,
        PR_FLOAT, x,
        PR_FLOAT, y,
        PR_FLOAT, z,
        PR_UINT32, icon_id,
        PR_UINT32, color,
        PR_FLOAT, dist,
        PR_UINT8, interior
    );

    PR_SendRPC(bs, playerid, 169, PR_HIGH_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
}

