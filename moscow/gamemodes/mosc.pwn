    CreateDynamic3DTextLabel("{ffff00}вест \n {ffffff}дл новичков", 0xFFFF00FF, gActorQuest[i9116][0], gActorQuest[i9116][1], gActorQuest[i9116][2], 10.0), 
    CreatePickup(18471, 23, gBook[i9116][0], gBook[i9116][1], gBook[i9116][2], -1, PICKUP_QUEST_BOOK), CreateActor(98, gActorHelp[i9116][0], gActorHelp[i9116][1], gActorHelp[i9116][2], gActorHelp[i9116][3]),
	CreateDynamic3DTextLabel("{ffff00}л новичков\n{ffffff}омощ по игре", 0xFFFF00FF, gActorHelp[i9116][0], gActorHelp[i9116][1], gActorHelp[i9116][2], 10.0),
	CreatePickup(1239, 23, InfoActor[i9116][0], InfoActor[i9116][1], InfoActor[i9116][2], -1, PICKUP_INFO);


	CreateDynamic3DTextLabel("{FFFFFF}- онтейнер -\n{FFFFFF}ласс контейнера: {cd853f}бчнй\n{FFFFFF}ена контейнера: {cd853f}500.000 рублей\n{FFFFFF}ведите /vz чтоб открт", 0xFFFF00FF, 609.434875,1729.022583,12.078809 + 1.8, 10.0);
