CMD:convert(playerid, params[])
{
    if(GetPlayerDonateRub(playerid) <= 0)
        return SendClientMessage(playerid, 0xCECECEFF, ""USC" вас нет донат-рублей дл конвертации!");

    new fmt_text[256];
    format(fmt_text, sizeof(fmt_text),
        "{FFFFFF} вас на счету: {FFFF00}%d {FFFFFF}донат-рублей\n\n\
        {FFFFFF}урс конвертации: {FFFF00}1 донат-рубл = 2000 игровх рублей\n\n\
        {FFFFFF}ведите количество донат-рублей дл конвертации:",
        GetPlayerDonateRub(playerid)
    );

    Dialog(
        playerid, 29001, DIALOG_STYLE_INPUT,
        "{FF5A5A}SANTA MOBILE RP {FFFFFF}| онвертаци",
        fmt_text,
        "онвертироват", "тмена"
    );
    return 1;
}








CMD:fssetpos(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6) return 1;

    new fs_id;
    if(sscanf(params, "d", fs_id))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /fssetpos [id ]");

    if(fs_id < 0 || fs_id >= g_fuel_station_loaded)
        return SendClientMessage(playerid, 0x999999FF, "анной  не существует на сервере");

    // охранем текущую позицию игрока как новую позицию 
    GetPlayerPos(playerid,
        g_fuel_station[fs_id][FS_POS_X],
        g_fuel_station[fs_id][FS_POS_Y],
        g_fuel_station[fs_id][FS_POS_Z]
    );

    // бновлем зону 
    if(IsValidDynamicArea(g_fuel_station[fs_id][FS_AREA]))
    {
        DestroyDynamicArea(g_fuel_station[fs_id][FS_AREA]);
        g_fuel_station[fs_id][FS_AREA] = CreateDynamicSphere(
            g_fuel_station[fs_id][FS_POS_X],
            g_fuel_station[fs_id][FS_POS_Y],
            g_fuel_station[fs_id][FS_POS_Z],
            15.0
        );
    }

    // бновлем 3D текст
    UpdateFuelStationLabel(fs_id);

    new query[256];
    mysql_format(mysql, query, sizeof query,
        "UPDATE fuel_stations SET x='%f', y='%f', z='%f' WHERE id=%d",
        g_fuel_station[fs_id][FS_POS_X],
        g_fuel_station[fs_id][FS_POS_Y],
        g_fuel_station[fs_id][FS_POS_Z],
        GetFuelStationData(fs_id, FS_SQL_ID)
    );
    mysql_query(mysql, query, false);

    new fmt_text[128];
    format(fmt_text, sizeof fmt_text, ""SC"озици  №%d обновлена на вашу позицию.", fs_id);
    SendClientMessage(playerid, 0x66CC33FF, fmt_text);

    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);
    return 1;
}


CMD:giveallvip(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 7) 
        return SendClientMessage(playerid, 0x999999FF, ""USC" вас недостаточно прав! ужен 7+ уровен.");

    new vip_level, days;
    if(sscanf(params, "dd", vip_level, days))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /giveallvip [уровен VIP (1-3)] [дней]");

    if(vip_level < 1 || vip_level > 3)
        return SendClientMessage(playerid, 0xCECECEFF, "VIP уровен должен бт от 1 до 3 (1-Bronze, 2-Silver, 3-Gold)");

    if(days < 1 || days > 365)
        return SendClientMessage(playerid, 0xCECECEFF, "оличество дней должно бт от 1 до 365");

    new vip_names[4][16] = {"", "Bronze", "Silver", "Gold"};
    new current_time = gettime();
    new count;

    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i) || !IsPlayerLogged(i)) continue;

        new vip_expire = GetPlayerData(i, P_PREMIUM_DATE);
        
        if(vip_expire > current_time)
        {
            // сли у игрока уже ест VIP - добавлем дни к текущему
            vip_expire += days * 86400;
        }
        else
        {
            // сли VIP нет - устанавливаем новую дату окончани
            vip_expire = current_time + (days * 86400);
        }

        // станавливаем уровен VIP
        SetPlayerData(i, P_PREMIUM, vip_level);
        SetPlayerData(i, P_PREMIUM_DATE, vip_expire);

        // охранем в 
        UpdatePlayerDatabaseInt(i, "premium", vip_level);
        UpdatePlayerDatabaseInt(i, "premium_date", vip_expire);

        // ообщение игроку
        new fmt_msg[128];
        format(fmt_msg, sizeof(fmt_msg), ""SC"ам вдан VIP {FFFF00}%s {FFFFFF}на {FFFF00}%d {FFFFFF}дней администратором {FFFF00}%s",
            vip_names[vip_level], days, GetPlayerNameEx(playerid));
        SendClientMessage(i, 0xEC174FFF, fmt_msg);

        count++;
    }

    // тчёт дл админа
    new fmt_msg[256];
    format(fmt_msg, sizeof(fmt_msg), ""SC" вдали VIP {FFFF00}%s {FFFFFF}на {FFFF00}%d {FFFFFF}дней {FFFF00}%d {FFFFFF}игрокам.",
        vip_names[vip_level], days, count);
    SendClientMessage(playerid, 0x66CC33FF, fmt_msg);

    // ог в админ чат
    format(fmt_msg, sizeof(fmt_msg), "[A] %s[%d] вдал VIP %s на %d дней всем игрокам (%d чел)",
        GetPlayerNameEx(playerid), playerid, vip_names[vip_level], days, count);
    SendMessageToAdmins(fmt_msg, 0x999999FF);

    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);
    return 1;
}

