CMD:home(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		new fmt_str[1024];
		new entranceid = GetHouseData(houseid, H_ENTRACE);
		new city[MAX_ZONES_NAME + 1], area[MAX_ZONES_NAME + 1];

		format(fmt_str, sizeof fmt_str, "{FFFFFF}ип / название:\t\t\t{339999}%s\n", GetHouseData(houseid, H_NAME));
		if(entranceid != -1)
		{
			GetCityName(GetEntranceData(entranceid, E_POS_X), GetEntranceData(entranceid, E_POS_Y), city);
			GetAreaName(GetEntranceData(entranceid, E_POS_X), GetEntranceData(entranceid, E_POS_Y), area);
			format
			(
				fmt_str, sizeof fmt_str,
				"%s{FFFFFF}омер подъезда:\t\t\t%d\n"\
				"омер квартир:\t\t\t%d\n"\
				"ород / област:\t\t\t%s\n"\
				"айон:\t\t\t\t\t%s\n",
				fmt_str,
				entranceid + 1,
				GetHouseData(houseid, H_FLAT_ID) + 1,
				city,
				area
			);
		}
		else
		{
			GetCityName(GetHouseData(houseid, H_POS_X), GetHouseData(houseid, H_POS_Y), city);
			GetAreaName(GetHouseData(houseid, H_POS_X), GetHouseData(houseid, H_POS_Y), area);
			format
			(
				fmt_str, sizeof fmt_str,
				"%s{FFFFFF}омер дома:\t\t\t\t%d\n"\
				"ород / област:\t\t\t%s\n"\
				"айон:\t\t\t\t\t%s\n",
				fmt_str,
				houseid,
				city,
				area
			);
		}

		format
		(
			fmt_str, sizeof fmt_str,
			"%sтоимост:\t\t\t\t%d руб\n"\
			"ом оплачен на:\t\t\t%d/30 дней\n"\
			"оличество комнат:\t\t\t%d\n"\
			"ровен улучшений:\t\t\t%d\n"\
			"одел домашнего авто:\t\t{FF3333}ет\n"\
			"{FFFFFF}вартплата:\t\t\t\t%d руб в ден\n"\
			"ип квартплат:\t\t\t%s\n"\
			"татус:\t\t\t\t\t%s\n\n"\
			"{669966}л открти панели управлени вашим домом\n"\
			"нажмите кнопку \"зменит\"",
			fmt_str,
			GetHouseData(houseid, H_PRICE),
			GetHouseData(houseid, H_RENT_DATE) <= gettime() ? 0 :
			GetElapsedTime(GetHouseData(houseid, H_RENT_DATE), gettime(), CONVERT_TIME_TO_DAYS),
			GetHouseTypeInfo(GetHouseData(houseid, H_TYPE), HT_ROOMS),
			GetHouseData(houseid, H_IMPROVEMENTS),
			GetHouseData(houseid, H_IMPROVEMENTS) < 4 ? (GetHouseData(houseid, H_RENT_PRICE)) : (GetHouseData(houseid, H_RENT_PRICE) / 2),
			GetHouseData(houseid, H_IMPROVEMENTS) < 4 ? ("бчна") : ("ониженна"),
			GetHouseData(houseid, H_LOCK_STATUS) ? ("{CC3333}ом закрт") : ("{66CC33}ом открт")
		);
		Dialog(playerid, DIALOG_HOUSE_INFO, DIALOG_STYLE_MSGBOX, "{33AACC}нформаци о доме", fmt_str, "зменит", "тмена");
	}
	else SendClientMessage(playerid, 0x999999FF, " ас нет дома");

	return 1;
}

CMD:sellhome(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		Dialog
		(
			playerid, DIALOG_HOUSE_SELL, DIALOG_STYLE_MSGBOX,
			"{FFCD00}родажа дома",
			"{FFFFFF} уверен что хотите продат свой дом государству?\n\n"\
			"ам будет возвращено ее стоимост за вчитом 30%\n"\
			"акже будет возвращено 60% от стоимости купленнх улучшений\n\n"\
			"сли  хотите продат дом другому игроку,\n"\
			"исползуйте команду /sellmyhome",
			"а", "ет"
		);
	}
	else SendClientMessage(playerid, 0x999999FF, " ас нет дома");

	return 1;
}

CMD:sellmyhome(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /sellmyhome [id игрока] [стоимост]");

		extract params -> new to_player, price;

		new house_price = GetHouseData(houseid, H_PRICE);

		if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
			return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

		if(GetPlayerHouse(to_player) != -1)
			return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест дом");

		if(!((house_price / 3) <= price <= (house_price * 3)))
			return SendClientMessage(playerid, 0xCECECEFF, "тоимост не должна бт дороже или дешевле в 3 раза от стоимости дома");

		if(GetPlayerMoneyEx(to_player) < price)
			return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет такой сумм");

		if(!(IsPlayerInRangeOfHouse(playerid, houseid, 10.0) && IsPlayerInRangeOfHouse(to_player, houseid, 10.0)))
			return SendClientMessage(playerid, 0xCECECEFF, " и покупател должн находитс около дома которй хотите продат");

		SendPlayerOfferNotification(playerid, to_player, OFFER_TYPE_SELL_HOME, houseid, price);
	}
	else SendClientMessage(playerid, 0x999999FF, " ас нет дома");

	return 1;
}

CMD:live(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		new type = GetHouseData(houseid, H_TYPE);
		new rooms = GetHouseTypeInfo(type, HT_ROOMS);

		if(GetHouseRentersCount(houseid) >= rooms)
			return SendClientMessage(playerid, 0x999999FF, "се комнат ашего дома уже зант");

		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /live [id игрока]"); // [кол-во дней] [цена (необзателно)]

		extract params -> new to_player, days, price;

		if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
			return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

		if(GetPlayerHouse(to_player) != -1)
			return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест дом");

		if(!(IsPlayerInRangeOfHouse(playerid, houseid, 10.0) && IsPlayerInRangeOfHouse(to_player, houseid, 10.0)))
			return SendClientMessage(playerid, 0xCECECEFF, " и арендатор должн находитс около дома которй хотите сдат в аренду");

		SendPlayerOfferNotification(playerid, to_player, OFFER_TYPE_HOME_RENT_ROOM, houseid);
	}
	else SendClientMessage(playerid, 0x999999FF, " ас нет дома");

	return 1;
}

CMD:liveout(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_ROOM);
	if(houseid != -1)
	{
		Dialog
		(
			playerid, DIALOG_HOUSE_EVICT, DIALOG_STYLE_MSGBOX,
			"{FF9900}селение из дома",
			"{FFFFFF} действително хотите вселитс из дома?",
			"а", "ет"
		);
	}
	else SendClientMessage(playerid, 0x999999FF, " нигде не проживаете");

	return 1;
}

CMD:makestore(playerid, params[])
{
	new houseid = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);
	if(houseid != -1)
	{
		if(GetHouseData(houseid, H_IMPROVEMENTS) >= 5)
		{
			if(GetPlayerInHouse(playerid) == houseid)
			{
				new type = GetHouseData(houseid, H_TYPE);
				if(IsPlayerInRangeOfPoint(playerid, 50.0, GetHouseTypeInfo(type, HT_ENTER_POS_X), GetHouseTypeInfo(type, HT_ENTER_POS_Y), GetHouseTypeInfo(type, HT_ENTER_POS_Z)))
				{
					Dialog
					(
						playerid, DIALOG_HOUSE_MOVE_STORE, DIALOG_STYLE_MSGBOX,
						"{FFCD00}каф",
						"{FFFFFF} хотите разместит шкаф в этом месте?",
						"а", "ет"
					);
				}
				else SendClientMessage(playerid, 0x999999FF, " должн находитс у себ в доме");
			}
			else SendClientMessage(playerid, 0x999999FF, " должн находитс у себ в доме");
		}
		else SendClientMessage(playerid, 0x999999FF, "еобходим 5 уровен улучшений дл дома");
	}
	else SendClientMessage(playerid, 0x999999FF, "ункци доступна владелцам недвижимости");

	return 1;
}

CMD:use(playerid, params[])
{
	new house_id = GetPlayerHouse(playerid, HOUSE_TYPE_HOME);

	if(house_id == -1) return SendClientMessage(playerid, 0x999999FF, "ункци доступна владелцам недвижимости");

	if(GetPlayerInHouse(playerid) != house_id) return SendClientMessage(playerid, 0x999999FF, " должн находитс в своём доме");

	if(GetHouseData(house_id, H_IMPROVEMENTS) < 5) return SendClientMessage(playerid, 0x999999FF, "еобходим 5 уровен улучшений дл дома");

	if(!IsPlayerInRangeOfPoint(playerid, 3.0, GetHouseData(house_id, H_STORE_X), GetHouseData(house_id, H_STORE_Y), GetHouseData(house_id, H_STORE_Z)))
		return SendClientMessage(playerid, 0xCECECEFF, " должн находитс у своего шкафа");

	Dialog
	(
		playerid, DIALOG_HOUSE_STORE, DIALOG_STYLE_LIST,
		"{FFCC00}каф",
		"1. оложит атериал\n\
		2. оложит наркотики\n\
		3. оложит оружие\n\
		4. оложит одежду\n\
		{99FF99}5. зт атериал\n\
		{99FF99}6. зт наркотики\n\
		{99FF99}7. зт оружие\n\
		{99FF99}8. зт одежду",
		"алее", "акрт"
	);

	return 1;
}

CMD:homelock(playerid, params[])
{
	new hotel_id = GetPlayerHouse(playerid, HOUSE_TYPE_HOTEL);
	new room_id = GetPlayerData(playerid, P_HOUSE_ROOM);

	if(hotel_id != -1)
	{
		if(GetHotelData(hotel_id, room_id, H_STATUS))
		{
			SetHotelData(hotel_id, room_id, H_STATUS, false);

			GameTextForPlayer(playerid, "~g~~h~OЏKP‘ЏO", 2000, 4);
			SendClientMessage(playerid, 0x66CC00FF, "омер открт");
		}
		else
		{
			SetHotelData(hotel_id, room_id, H_STATUS, true);

			GameTextForPlayer(playerid, "~r~~h~€AKP‘ЏO", 2000, 4);
			SendClientMessage(playerid, 0xFF6600FF, "омер закрт");
		}

		new query[64];
		format(query, sizeof query, "UPDATE hotels SET status=%d WHERE id=%d LIMIT 1", GetHotelData(hotel_id, room_id, H_STATUS), GetHotelData(hotel_id, room_id, H_SQL_ID));
		mysql_query(mysql, query, false);
	}
	else SendClientMessage(playerid, 0x999999FF, " не снимаете номер в гостинице");

	return 1;
}

CMD:exit(playerid, params[])
{
	if(GetPlayerInHouse(playerid) != -1)
	{
		new houseid = GetPlayerInHouse(playerid);
		if(GetHouseData(houseid, H_IMPROVEMENTS) > 5)
		{
			Dialog
			(
				playerid, DIALOG_ACTION_EXIT_HOUSE, DIALOG_STYLE_LIST,
				"{FFCC00}ход",
				"1. лица\n\
				2. араж",
				"алее", "акрт"
			);
		}
		else
			ExitPlayerFromHouse(playerid, 3.0);
	}
	else if(GetPlayerData(playerid, P_IN_HOTEL_ROOM) != -1)
	{
		ExitPlayerFromHotelRoom(playerid);
	}
	else if(!GetPlayerInterior(playerid))
	{
		SendClientMessage(playerid, 0xCECECEFF, " не в помещении");
	}

	return 1;
}

CMD:lift(playerid, params[])
{
	new entranceid = GetPlayerInEntrance(playerid);
	if(entranceid != -1)
	{
		new floor = GetPlayerInEntranceFloor(playerid);
		if(floor != -1)
		{
			if(!floor)
			{
				if(!IsPlayerInRangeOfPoint(playerid, 1.5, 30.5405, 1403.6593, 1508.4163))
					return SendClientMessage(playerid, 0xCECECEFF, " должн находитс около лифта");
			}
			else
			{
				if(!IsPlayerInRangeOfPoint(playerid, 1.5, 11.1776, 1377.5216, 1508.4163))
					return SendClientMessage(playerid, 0xCECECEFF, " должн находитс около лифта");
			}
			ShowPlayerEntranceFloorsLift(playerid, entranceid, floor);
		}
	}
	else SendClientMessage(playerid, 0xCECECEFF, " не в подъезде");

	return 1;
}
alias:lock("lk")
CMD:lock(playerid, params[])
{
    // роверем личнй транспорт
    if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
    {
        new vehicleid = GetPlayerOwnableCar(playerid);
        new Float: x, Float: y, Float: z;
        GetVehiclePos(vehicleid, x, y, z);

        if(IsPlayerInRangeOfPoint(playerid, 10.0, x, y, z))
        {
            new lock_status = GetVehicleParam(vehicleid, V_LOCK) ^ VEHICLE_PARAM_ON;
            SetVehicleParam(vehicleid, V_LOCK, lock_status);
            
            if(lock_status == VEHICLE_PARAM_OFF)
            {
                g_vehicle_lock_sent[vehicleid] = false;
                PlayAudioStreamURL(playerid, SOUND_DOOR_OPEN);
                ShowNotificationNew(playerid, 3, 5, -1, -1, " открли транспорт", "");
                
                new message[128];
                format(message, sizeof(message), "{BA55D3}%s открл(а) транспорт", GetPlayerNameEx(playerid));
                SendMessageInLocal(playerid, message, 0xBA55D3FF, 25.0);
            }
            else
            {
                PlayAudioStreamURL(playerid, SOUND_DOOR_CLOSE);
                ShowNotificationNew(playerid, 3, 5, -1, -1, " закрли транспорт", "");
                
                new message[128];
                format(message, sizeof(message), "{BA55D3}%s закрл(а) транспорт", GetPlayerNameEx(playerid));
                SendMessageInLocal(playerid, message, 0xBA55D3FF, 25.0);
            }
        }
        else SendClientMessage(playerid, 0x999999FF, ""USC" должн стот рдом с транспортом");
        
        return 1;
    }
    
    // ===== : роверем арендованнй скутер =====
    new rent_bike_id = GetPlayerData(playerid, P_RENT_BIKE);
    if(rent_bike_id != INVALID_VEHICLE_ID && IsValidVehicle(rent_bike_id))
    {
        new Float: x, Float: y, Float: z;
        GetVehiclePos(rent_bike_id, x, y, z);

        if(IsPlayerInRangeOfPoint(playerid, 10.0, x, y, z))
        {
            new lock_status = GetVehicleParam(rent_bike_id, V_LOCK) ^ VEHICLE_PARAM_ON;
            SetVehicleParam(rent_bike_id, V_LOCK, lock_status);
            
            if(lock_status == VEHICLE_PARAM_OFF)
            {
                PlayAudioStreamURL(playerid, SOUND_DOOR_OPEN);
                ShowNotificationNew(playerid, 3, 5, -1, -1, " открли скутер", "");
                
                new message[128];
                format(message, sizeof(message), "{BA55D3}%s открл(а) скутер", GetPlayerNameEx(playerid));
                SendMessageInLocal(playerid, message, 0xBA55D3FF, 25.0);
            }
            else
            {
                PlayAudioStreamURL(playerid, SOUND_DOOR_CLOSE);
                ShowNotificationNew(playerid, 3, 5, -1, -1, " закрли скутер", "");
                
                new message[128];
                format(message, sizeof(message), "{BA55D3}%s закрл(а) скутер", GetPlayerNameEx(playerid));
                SendMessageInLocal(playerid, message, 0xBA55D3FF, 25.0);
            }
        }
        else SendClientMessage(playerid, 0x999999FF, ""USC" должн стот рдом со скутером");
        
        return 1;
    }

    if(GetPlayerIdFamily(playerid) != -1)
    {
        new family_vehicleid = INVALID_VEHICLE_ID;
        new Float: family_radius = 10.0;
        new Float: player_x, Float: player_y, Float: player_z;
        GetPlayerPos(playerid, player_x, player_y, player_z);

        for(new idx; idx < MAX_VEHICLES; idx ++)
        {
            if(!IsValidVehicle(idx)) continue;
            if(!IsVehicleStreamedIn(idx, playerid)) continue;
            if(GetVehicleData(idx, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_FAMILY_CAR) continue;

            new family_car_idx = GetVehicleData(idx, V_ACTION_ID);
            if(family_car_idx == -1) continue;
            if(GetCarFamily(family_car_idx, OW_F_server) != GetPlayerIdFamily(playerid)) continue;
            if(GetPlayerRangFamily(playerid) < GetCarFamily(family_car_idx, V_F_RANG)) continue;

            new Float: distance = GetVehicleDistanceFromPoint(idx, player_x, player_y, player_z);
            if(distance > family_radius) continue;

            family_radius = distance;
            family_vehicleid = idx;
        }

        if(family_vehicleid != INVALID_VEHICLE_ID)
        {
            ToggleLock(playerid, family_vehicleid);
            return 1;
        }
    }
    
    // сли нет ни личного авто, ни арендованного скутера
    if(GetPlayerOwnableCars(playerid) == 0 && rent_bike_id == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0x999999FF, ""USC" ас нет личного транспорта или арендованного скутера");
    else if(GetPlayerOwnableCar(playerid) == INVALID_VEHICLE_ID && rent_bike_id == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0x999999FF, ""USC"аш транспорт не загружен на сервер");
    
    return 1;
}

CMD:key(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))
	{
		if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID || GetPlayerAllowedCar(playerid) != INVALID_VEHICLE_ID)
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(!IsABike(vehicleid))
			{
				if(vehicleid == GetPlayerOwnableCar(playerid) || vehicleid == GetPlayerAllowedCar(playerid))
				{
					new index = GetVehicleData(vehicleid, V_ACTION_ID);
					new bool: status = GetOwnableCarData(index, OC_KEY_IN);

					if(status)
					{
						if(GetVehicleParam(vehicleid, V_ENGINE) == VEHICLE_PARAM_ON)
						{
							SetVehicleParam(vehicleid, V_ENGINE, VEHICLE_PARAM_OFF);
						}
						Action(playerid, "втащил ключ из замка зажигани", _, false);
					}
					else Action(playerid, "вставил ключ в замок зажигани", _, false);

					SetOwnableCarData(index, OC_KEY_IN, status ^ true);
				//	SpeedometrKeyStatusInit(playerid, vehicleid);
				}
				else SendClientMessage(playerid, 0xCECECEFF, " должн находитс в личном/доверенном транспорте");
			}
		}
		else
		{
			if(GetPlayerOwnableCars(playerid) == 0)
				SendClientMessage(playerid, 0x999999FF, " ас нет личного/доверенного транспорта");
			else
				SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
		}
	}
	else SendClientMessage(playerid, 0xCECECEFF, " должн находитс в транспорте");

	return 1;
}

CMD:getmycar(playerid, params[])
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		new price = 300;
		new i_have_home = (GetPlayerHouse(playerid, HOUSE_TYPE_HOME) != -1 || GetPlayerHouse(playerid, HOUSE_TYPE_HOTEL) != -1);

		if(GetPlayerGPSInfo(playerid, G_ENABLED) == GPS_STATUS_OFF)
		{
			if(GetPlayerMoneyEx(playerid) >= price || i_have_home)
			{
				if(!i_have_home)
					GivePlayerMoneyEx(playerid, -price, "етка  на GPS", true, true);

				new Float: x, Float: y, Float: z;
				GetVehiclePos(vehicleid, x, y, z);

				EnablePlayerGPS(playerid, 55, x, y, z, "естоположение ашего транспорта отмечено на GPS");
				return 1;
			}
			else SendClientMessage(playerid, 0x999999FF, "едостаточно денег");
		}
		else SendClientMessage(playerid, 0xCECECEFF, "а ашем GPS уже отмечено место");
	}
	else
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
		else
			SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}

	return 0;
}

CMD:sellcar(playerid, params[])
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		new model_id = GetVehicleData(vehicleid, V_MODELID);
		if(model_id)
		{
			new fmt_str[256];

			new price = GetVehicleInfo(model_id-400, VI_PRICE);
			new percent = price * 20 / 100;

			format
			(
				fmt_str, sizeof fmt_str,
				"{FFFFFF}одел:\t%s (№%d)\n"\
				"тоимост:\t%d руб\n\n"\
				" уверен что хотите продат транспорт?\n"\
				"а аш банковский счет будет начислено %d руб\n\n"\
				"сли  хотите продат его другому игроку,\n"\
				"исползуйте команду /sellmycar",
				GetVehicleName(vehicleid),
				model_id,
				price,
				price - percent
			);
			Dialog(playerid, DIALOG_OWNABLE_CAR_SELL, DIALOG_STYLE_MSGBOX, "{FFCD00}родажа личного транспорта", fmt_str, "а", "ет");
		}
	}
	else
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
		else
			SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}

	return 1;
}

CMD:sellmycar(playerid, params[])
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		if(!strlen(params))
			return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /sellmycar [id игрока] [стоимост]");

		extract params -> new to_player, price;

		new model_id = GetVehicleData(vehicleid, V_MODELID);
		if(model_id)
		{
			new car_price = GetVehicleInfo(model_id-400, VI_PRICE);

			if(!IsPlayerConnected(to_player) || to_player == playerid)
				return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

			if((GetPlayerOwnableCars(to_player) + 1) > GetPlayerCarSlots(to_player))
				return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет свободнх слотов дл транспорта");

			if(GetPlayerOwnableCar(to_player) != INVALID_VEHICLE_ID)
				return SendClientMessage(playerid, 0xCECECEFF, "тот игрок должен вгрузит его личнй транспорт с сервера {888888}(/car > 7)");

			if(!(3000 <= price <= (car_price * 2)))
				return SendClientMessage(playerid, 0xCECECEFF, "тоимост должа бт от 3000 рублей и не дороже в 2 раза гос. стоимости ");

			if(GetPlayerMoneyEx(to_player) < price)
				return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет такой сумм");

			new  Float: car_x, Float: car_y, Float: car_z;
			GetVehiclePos(vehicleid, car_x, car_y, car_z);

			if(IsPlayerInRangeOfPoint(playerid, 15.0, car_x, car_y, car_z) && IsPlayerInRangeOfPoint(to_player, 15.0, car_x, car_y, car_z))
			{
				SendPlayerOfferNotification(playerid, to_player, OFFER_TYPE_SELL_OWNABLE_CAR, price, vehicleid);
			}
			else SendClientMessage(playerid, 0xCECECEFF, " и покупател должн находитс около ");
		}
	}
	else
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
		else
			SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}

	return 1;
}

CMD:allow(playerid, params[])
{
	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid == INVALID_VEHICLE_ID)
	{
		if(GetPlayerOwnableCars(playerid) == 0)
			return SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
		else
			return SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
	}

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /allow [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	new fmt_text[71];

	if(GetPlayerAllowedCar(to_player) == vehicleid)
	{
		format(fmt_text, sizeof fmt_text, " забрали у %s ключи от ашего личного транспорта", GetPlayerNameEx(to_player));
		SendClientMessage(playerid, 0x3399FFFF, fmt_text);

		format(fmt_text, sizeof fmt_text, "%s забрал у ас ключи от своего личного транспорта", GetPlayerNameEx(playerid));
		SendClientMessage(to_player, 0xFF5533FF, fmt_text);

		SetPlayerData(to_player, P_ALLOWED_CAR, INVALID_VEHICLE_ID);
	}
	else
	{
		if(!IsPlayerInRangeOfPlayer(playerid, to_player, 10.0)) return SendClientMessage(playerid, 0xCECECEFF, "грок находитс слишком далеко");

		SendPlayerOfferNotification(playerid, to_player, OFFER_TYPE_GIVE_CAR_KEY);
	}

	return 1;
}

CMD:park(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, " должн находитс в транспорте");

    new vehicleid = GetPlayerOwnableCar(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
    {
        if(GetPlayerOwnableCars(playerid) == 0)
            return SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
        else
            return SendClientMessage(playerid, 0x999999FF, "аш личнй транспорт не загружен на сервер");
    }

    if(vehicleid != GetPlayerVehicleID(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, " должн находитс в личном транспорте");

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index == -1) return SendClientMessage(playerid, 0xFF6600FF, "шибка: транспорт не найден в !");

    // ===== Я   =====
    new Float:x, Float:y, Float:z, Float:angle;
    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);

    // бновлем в памти
    SetOwnableCarData(index, OC_POS_X, x);
    SetOwnableCarData(index, OC_POS_Y, y);
    SetOwnableCarData(index, OC_POS_Z, z);
    SetOwnableCarData(index, OC_ANGLE, angle);

    // ===== Я   =====
    new query[256];
    mysql_format(mysql, query, sizeof query,
        "UPDATE ownable_cars SET pos_x=%f, pos_y=%f, pos_z=%f, angle=%f WHERE id=%d",
        x, y, z, angle, GetOwnableCarData(index, OC_SQL_ID)
    );
    mysql_query(mysql, query, false);

    SendClientMessage(playerid, 0x66CC00FF, "ранспорт припаркован! озици сохранена.");
    
    // оказваем координат дл отладки
    new debug_msg[128];
    format(debug_msg, sizeof(debug_msg), "оординат: %.2f, %.2f, %.2f | гол: %.2f", x, y, z, angle);
    SendClientMessage(playerid, 0x3399FFFF, debug_msg);

    return 1;
}

CMD:car(playerid, params[])
{
    if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
    {
        Dialog
        (
            playerid, DIALOG_OWNABLE_CAR, DIALOG_STYLE_TABLIST_HEADERS,
            "{FF5A5A}USUPOVRP {FFFFFF}| правление транспортом",
            "{FF8A8A}омер\t{FF8A8A}оступное действие\n\
            {FFFFFF}#1\t{669900}ткрт {FFFFFF}или {FF3300}закрт {FFFFFF}транспорт\n\
            {FFFFFF}#2\tставит / втащит ключи\n\
            {FFFFFF}#3\tтметит транспорт на GPS {FF6600}(300 руб)\n\
            {FFFFFF}#4\tодержимое багажника\n\
            {FFFFFF}#5\tокумент на транспорт\n\
            {FFFFFF}#6\t{888888}рипарковат транспорт\n\
            {FFFFFF}#7\t{888888}грузит транспорт с сервера\n\
            {FFFFFF}#8\t{888888}обавит авто в семю",
            "брат", "акрт"
        );
    }
    else
    {
        new fmt_text[640],
            Cache: result,
            id,
            query[128];

        mysql_format(mysql, query, sizeof query, "SELECT * FROM ownable_cars WHERE owner_id='%d'", GetPlayerAccountID(playerid));
        result = mysql_query(mysql, query, true);

        new rows = cache_num_rows();

        if(!rows)
        {
            SendClientMessage(playerid, 0x999999FF, " ас нет личного транспорта");
            cache_delete(result);
            return 1;
        }

        if(rows == 1)
        {
            id = cache_get_field_content_int(0, "id");
            ShowOwnableCarLoadDialog(playerid, id);
        }
        else
        {
            new query2[90],
                model_id,
                car_number[8],
                car_number_show[12];

            format(fmt_text, sizeof fmt_text, "{FF8A8A}ранспорт\t{FF8A8A}омерной знак\n");

            for(new i = 0; i < rows; i ++)
            {
                id = cache_get_field_content_int(i, "id");
                model_id = cache_get_field_content_int(i, "model_id");
                cache_get_field_content(i, "number", car_number);

                if(!IsValidVehicleInfoModel(model_id))
                    model_id = MIN_VEHICLE_INFO_MODEL_ID;

                if(strlen(car_number) != 6 || !strcmp(car_number, "------", true))
                    format(car_number_show, sizeof car_number_show, "[....]");
                else format(car_number_show, sizeof car_number_show, "[%s]", car_number);

                format(query2, sizeof query2, "{FFFFFF}%s\t%s\n", GetVehicleInfo(model_id - 400, VI_NAME), car_number_show);
                strcat(fmt_text, query2);
                SetPlayerListitemValue(playerid, i, id);
            }

            Dialog
            (
                playerid, DIALOG_OWNABLE_CAR_LIST, DIALOG_STYLE_TABLIST_HEADERS,
                "{FF5A5A}USUPOVRP {FFFFFF}| аш транспорт",
                fmt_text,
                "брат", "акрт"
            );
        }

        cache_delete(result);
    }

    return 1;
}
CMD:trunk(playerid, params[])
{
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		new vehicleid;
		new Float: x, Float: y, Float: z;
		new Float: angle, Float: distance;

		while((++vehicleid) < MAX_VEHICLES)
		{
			if(!GetVehicleData(vehicleid, V_MODELID)) continue;

			GetCoordVehicle(vehicleid, VEHICLE_COORD_TYPE_BOOT, x, y, z, angle, distance);
			if(!IsPlayerInRangeOfPoint(playerid, 1.0, x, y, z)) continue;

			ShowTrunkDialog(playerid, vehicleid, false);
			break;
		}
	}
	return 1;
}

CMD:dvall(playerid)
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
    if(GetPlayerAdminEx(playerid) < 4) return 1;

    new total_car = 0;
    for(new i = 0; i < MAX_VEHICLES; i++)
    {
        if(GetVehicleData(i, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN_CAR)
        {
            DestroyVehicle(i);
            total_car ++;
        }

    }

    format(sctring, sizeof(sctring), "{FF0000}[SYSTEM] {FFFFFF} удалили {00ff00}%i {FFFFFF}автомобилей созданнх на сервере!", total_car);
    SendClientMessage(playerid, -1, sctring);
    format(sctring, sizeof(sctring), "[A] %s[%d] удалил вес созданнй транспорт на сервере. (%i шт)",GetPlayerNameEx(playerid), playerid, total_car);
    SendMessageToAdmins(sctring, 0x999999FF);
    return 1;
}

CMD:veh(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4 && GetPlayerYouTubeEx(playerid) < 1) return ShowNotificationNew(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

	extract params -> new model_id, color_1, color_2; else return SendClientMessage(playerid, 0xCECECEFF, "{FF5252}|{ffffff} сползуйте: /veh [id модели] [цвет 1] [цвет 2]");

	if(!(400 <= model_id <= 30000)) return SendClientMessage(playerid, 0xCECECEFF, "{FF5252}|{ffffff}сползуйте модел от 400 до 2591");

	new status;

	sscanf(params, "{d}{d}{d}d", status);

	if(!(0 <= status <= 1))
		return SendClientMessage(playerid, 0x999999FF, "{FF5252}|{ffffff}оступ игроков к транспорту: 0 - ет доступа, 1 - оступно любому игроку");

	new Float: x,
		Float: y,
		Float: z,
		Float: a;

	GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, a);

	new vehicleid = CreateVehicle(model_id, x, y, z, a, color_1, color_2, -1, 0, VEHICLE_ACTION_TYPE_ADMIN_CAR, status);

	SetTimerEx("DelayedPutPlayerInVehicle", 150, false, "ii", playerid, vehicleid);
	new fmt_text[999];
	ChangeVehicleColor(vehicleid, color_1, color_2);

	format(fmt_text, sizeof fmt_text, "[A] %s[%d] создал транспорт (%d, %d, %d)",
	GetPlayerNameEx(playerid), playerid, model_id, color_1, color_2);
    SendMessageToAdmins(fmt_text, 0x999999FF);

	format(fmt_text, sizeof fmt_text, "оздал транспорт (%d, %d, %d)", model_id, color_1, color_2);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}
