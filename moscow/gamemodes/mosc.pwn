					}
				}
			}
		}
	}
	return 1;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
	return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
	return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
    Iter_Add(streamed_players_in_veh[vehicleid], forplayerid);
	Iter_Add(vehicle_in_stream[forplayerid], vehicleid);

	sc_OnVehicleStreamIn(vehicleid, forplayerid);
	RestoreOwnableCarColor(vehicleid);
	RestoreFamilyCarColor(vehicleid);
	SetVehicleVinylForPlayer(forplayerid, vehicleid, vInfo[vehicleid][vVinylTexture]);

	return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
	sc_OnVehicleStreamIn(vehicleid, forplayerid);

	Iter_Remove(streamed_players_in_veh[vehicleid], forplayerid);
	Iter_Remove(vehicle_in_stream[forplayerid], vehicleid);
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if(OnTaksoDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(GetPVarInt(playerid, "gordeev_auth_gui") && (dialogid == DIALOG_LOGIN || dialogid == DIALOG_REGISTER))
    {
        return 1;
    }
	switch(dialogid)
	{
        case DIALOG_WHITELIST_MENU:
        {
            if(!response) return 1;

            switch(listitem)
            {
                case 0: ShowWhitelistStatusDialog(playerid);
                case 1:
                {
                    Whitelist_SetEnabled(true);
                    SendClientMessage(playerid, 0x66CC33FF, "Whitelist включен");
                    ShowWhitelistStatusDialog(playerid);
                }
                case 2:
                {
                    Whitelist_SetEnabled(false);
                    SendClientMessage(playerid, 0x66CC33FF, "Whitelist включен");
                    ShowWhitelistStatusDialog(playerid);
                }
                case 3: ShowWhitelistListDialog(playerid);
                case 4: ShowWhitelistAddDialog(playerid);
                case 5: ShowWhitelistDelDialog(playerid);
            }
            return 1;
        }
        case DIALOG_WHITELIST_STATUS:
        {
            if(response) ShowWhitelistMenu(playerid);
            return 1;
        }
        case DIALOG_WHITELIST_LIST:
        {
            if(response) ShowWhitelistMenu(playerid);
            return 1;
        }
        case DIALOG_WHITELIST_INPUT_ADD:
        {
            if(!response) return 1;
            if(!strlen(inputtext))
            {
                SendClientMessage(playerid, 0x999999FF, "ведите ник");
                return ShowWhitelistAddDialog(playerid);
            }
            return Whitelist_AddName(playerid, inputtext);
        }
        case DIALOG_WHITELIST_INPUT_DEL:
        {
            if(!response) return 1;
            if(!strlen(inputtext))
            {
                SendClientMessage(playerid, 0x999999FF, "ведите ник");
                return ShowWhitelistDelDialog(playerid);
            }
            return Whitelist_DeleteName(playerid, inputtext);
        }
        case DIALOG_PLAY_AUDIO:
{
    if(!response) return 1;
    
    if(!strlen(inputtext))
    {
        SendClientMessage(playerid, 0x999999FF, ""USC" не ввели сслку");
        return 1;
    }
    
    if(strfind(inputtext, ".mp3", true) == -1 && strfind(inputtext, ".ogg", true) == -1)
    {
        SendClientMessage(playerid, 0x999999FF, ""USC"слка должна вести на .mp3 или .ogg файл");
        return 1;
    }
    
    PlayAudioStreamURL(playerid, inputtext);
    
    new notification_text[128];
    format(notification_text, sizeof(notification_text), "оспроизводитс: %s", inputtext);
    ShowNotificationNew(playerid, 3, 5, -1, -1, notification_text, "");
    
    SendClientMessage(playerid, 0x66CC33FF, ""SC"вук воспроизводитс. тоб остановит - введите {FFFF00}/stopaudio");
    return 1;
}

case DIALOG_YT_REG:
{
    if(!response)
    {
        Kick:(playerid);
        return 1;
    }
    
    // роверем длину парол (4 цифр)
    if(strlen(inputtext) != 4 || !IsNumeric(inputtext))
    {
        Dialog(playerid, DIALOG_YT_REG, DIALOG_STYLE_PASSWORD, 
            "{00FFFF}егистраци в ютуберской панели", 
            "{FF0000}арол должен состот ровно из 4-х цифр!\n{FFFFFF}ридумайте парол из 4-х цифр дл доступа к ютуберской панели\nведите его в поле ниже:\n", 
            "алее", "ход");
        return 1;
    }
    
    // охранем парол в 
    new query[256];
    mysql_format(mysql, query, sizeof query, 
        "UPDATE `accounts` SET `yt_password`='%e' WHERE `id`=%d LIMIT 1", 
        inputtext, GetPlayerAccountID(playerid));
    mysql_query(mysql, query, false);
    
    // охранем в памт
    format(GetPlayerData(playerid, P_YT_PASS), 32, "%s", inputtext);
    SetPlayerData(playerid, P_YT_LOGGED, 1);
    
    SendClientMessage(playerid, 0x00FFFFFF, "{00FFFF}[YouTube]{FFFFFF}  успешно зарегистрировалис в ютуберской панели!");
    SendClientMessage(playerid, 0x00FFFFFF, "{00FFFF}[YouTube]{FFFFFF} сползуйте {00FFFF}/yhelp{FFFFFF} дл просмотра команд");
    
    // ообщение в ютуберский чат
    new fmt_msg[128];
    format(fmt_msg, sizeof fmt_msg, "{00FFFF}тубер %s авторизовалс в панели ютубера.", GetPlayerNameEx(playerid));
    SendMessageToYouTubers(fmt_msg, 0x00FFFFFF);
    
    return 1;
}
case DIALOG_YT_LOGIN:
{
    if(!response)
    {
        Kick:(playerid);
        return 1;
    }
    
    // роверем парол
    if(!strlen(inputtext))
    {
        Dialog(playerid, DIALOG_YT_LOGIN, DIALOG_STYLE_PASSWORD, 
            "{00FFFF}туберска панел", 
            "{FF0000} не ввели парол!\n{FFFFFF} вошли как ютубер сервера\nведите парол от ютуберской панели в поле ниже", 
            "ойти", "ход");
        return 1;
    }
    
    // олучаем парол из 
    new query[128], Cache:result;
    mysql_format(mysql, query, sizeof query, "SELECT `yt_password` FROM `accounts` WHERE `id`=%d LIMIT 1", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        new db_password[32];
        cache_get_field_content(0, "yt_password", db_password, sizeof db_password);
        cache_delete(result);
        
        if(!strcmp(db_password, inputtext))
        {
            // арол вернй
            SetPlayerData(playerid, P_YT_LOGGED, 1);
            format(GetPlayerData(playerid, P_YT_PASS), 32, "%s", inputtext);
            
            SendClientMessage(playerid, 0x00FFFFFF, "{00FFFF}[YouTube]{FFFFFF}  успешно авторизовалис в ютуберской панели!");
            SendClientMessage(playerid, 0x00FFFFFF, "{00FFFF}[YouTube]{FFFFFF} сползуйте {00FFFF}/yhelp{FFFFFF} дл просмотра команд");
            
            // ообщение в ютуберский чат
            new fmt_msg[128];
            format(fmt_msg, sizeof fmt_msg, "{00FFFF}тубер %s авторизовалс в панели ютубера.", GetPlayerNameEx(playerid));
            SendMessageToYouTubers(fmt_msg, 0x00FFFFFF);
        }
        else
        {
            // арол невернй
            Dialog(playerid, DIALOG_YT_LOGIN, DIALOG_STYLE_PASSWORD, 
                "{00FFFF}туберска панел", 
                "{FF0000}евернй парол! опробуйте снова.\n{FFFFFF} вошли как ютубер сервера\nведите парол от ютуберской панели в поле ниже", 
                "ойти", "ход");
        }
    }
    else
    {
        cache_delete(result);
        Dialog(playerid, DIALOG_YT_LOGIN, DIALOG_STYLE_PASSWORD, 
            "{00FFFF}туберска панел", 
            "{FF0000}шибка проверки парол! опробуйте снова.\n{FFFFFF} вошли как ютубер сервера\nведите парол от ютуберской панели в поле ниже", 
            "ойти", "ход");
    }
    
    return 1;
}
        
        case DIALOG_INV_MAIN:
        {
            if(!response) return 1;

            switch(listitem)
            {
                case 0: return myskins(playerid);
                case 1: return callcmd::myacs(playerid);
                case 2: return ShowPlayerNumberResources(playerid);
            }
            return 1;
        }
        case DIALOG_INV_SKINS:
        {
            if(!response) return 1;

            new id = GetPlayerListitemValue(playerid, listitem);
            if(id <= 0) return SendClientMessage(playerid, -1, "кин не найден");

            return ShowOwnableSkinLoadDialog(playerid, id);
        }
        case DIALOG_INV_SKIN_ACTION:
        {
            if(!response) return 1;

            new id = GetPVarInt(playerid, "ownableskin_id");
            if(id <= 0) return SendClientMessage(playerid, -1, "кин не найден");

            new query[196], Cache: result;

            mysql_format(mysql, query, sizeof query, "SELECT skin_id, use_skin FROM inventory_skins WHERE id=%d LIMIT 1", id);
            result = mysql_query(mysql, query, true);

            if(!cache_num_rows())
            {
                cache_delete(result);
                return SendClientMessage(playerid, -1, "тот скин болше не существует");
            }

            new skin_id = cache_get_field_content_int(0, "skin_id");
            cache_delete(result);

            switch(listitem)
            {
                case 0:
                {
                    mysql_format(mysql, query, sizeof query, "UPDATE inventory_skins SET use_skin=0 WHERE owner_skin=%d", GetPlayerAccountID(playerid));
                    mysql_query(mysql, query, false);

                    mysql_format(mysql, query, sizeof query, "UPDATE inventory_skins SET use_skin=1 WHERE id=%d", id);
                    mysql_query(mysql, query, false);

                    SetPlayerData(playerid, P_SKIN, skin_id);
                    UpdatePlayerDatabaseInt(playerid, "skin", skin_id);
                    SetPlayerSkinInit(playerid);

                    ShowNotification(playerid, 3, " надели скин из инвентар", 5, "", "");
                }
                case 1:
                {
                    mysql_format(mysql, query, sizeof query, "DELETE FROM inventory_skins WHERE id=%d LIMIT 1", id);
                    mysql_query(mysql, query, false);
                    ShowNotification(playerid, 3, "кин удален из инвентар", 5, "", "");
                }
            }

            DeletePVar(playerid, "ownableskin_id");
            return myskins(playerid);
        }
        case DIALOG_INV_RESOURCES:
{
    if(!response) return 1;
    
    new slot = GetPlayerListitemValue(playerid, listitem);
    
    // олучаем тип ресурса из PVar
    new pvar_name[32];
    format(pvar_name, sizeof pvar_name, "res_type_%d", listitem);
    new res_type = GetPVarInt(playerid, pvar_name);
    
    SetPVarInt(playerid, "number_resource_slot", slot);
    SetPVarInt(playerid, "resource_type", res_type);
    
    if(res_type == RESOURCE_TYPE_NUMBER)
    {
        // иалог дл номерного знака
        return Dialog(playerid, DIALOG_INV_RESOURCE_ACT, DIALOG_STYLE_TABLIST_HEADERS, 
            "{FA8072}нвентар {FFFFFF}| омерной знак",
            "№\tействие\tписание действи\n\
            {FA8072}1.\t{FFFFFF}становит\tстановит номер на личное авто",
            "брат", "акрт");
    }
    else
    {
        // иалог дл SIM-карт
        return Dialog(playerid, DIALOG_INV_RESOURCE_ACT, DIALOG_STYLE_TABLIST_HEADERS, 
            "{FA8072}нвентар {FFFFFF}| SIM-карта",
            "№\tействие\tписание действи\n\
            {FA8072}1.\t{FFFFFF}сползоват\tстановит этот номер телефона\n\
            {FA8072}2.\t{FFFFFF}далит\tдалит SIM-карту из инвентар",
            "брат", "акрт");
    }
}
        case DIALOG_INV_RESOURCE_ACT:
{
    if(!response) return 1;
    
    new slot = GetPVarInt(playerid, "number_resource_slot");
    new res_type = GetPVarInt(playerid, "resource_type");
    
    if(res_type == RESOURCE_TYPE_NUMBER)
    {
        switch(listitem)
        {
            case 0: return ApplyPlayerNumberResource(playerid, slot);
        }
    }
    else // SIM-карта
    {
        switch(listitem)
        {
            case 0: 
            {
                // сползоват SIM-карту
                ApplyPlayerSimResource(playerid, slot);
                
                // бновлем список ресурсов
                ShowPlayerNumberResources(playerid);
                return 1;
            }
            case 1: 
            {
                DeletePlayerSimSlot(playerid, slot);
                ShowNotification(playerid, 3, "SIM-карта удалена из инвентар", 5, "", "");
                ShowPlayerNumberResources(playerid);
                return 1;
            }
        }
    }
    return 1;
}
        case DIALOG_BUY_NUMBER_MAIN:
        {
            if(!response) return 1;

            switch(listitem)
            {
                case 0: return BuyPlayerRandomNumberResource(playerid);
                case 1: return Dialog(playerid, DIALOG_BUY_NUMBER_INPUT, DIALOG_STYLE_INPUT, "{FF5A5A}окупка номера", "{FFFFFF}ведите желаемй номер в формате {FFCC00}A123BC", "родолжит", "азад");
            }
            return 1;
        }
        case DIALOG_BUY_NUMBER_INPUT:
        {
            if(!response) return ShowPlayerBuyNumberMainDialog(playerid);

            if(!IsACarNumber(inputtext)) return ShowNotification(playerid, 2, "казаннй номер не соответствует формату A123BC", 4, "", "");
            return BuyPlayerCustomNumberResource(playerid, inputtext);
        }
        case DIALOG_PICKUP_NUMBER_MAIN:
        {
            if(!response)
            {
                g_pickup_number_text[playerid][0] = EOS;
                g_pickup_number_region[playerid][0] = EOS;
                return 1;
            }

            switch(listitem)
            {
                case 0:
                {
                    if(!RollPlayerPickupNumber(playerid))
                        return ShowNotification(playerid, 2, "е удалос подобрат свободнй номер. опробуйте еще раз", 4, "", "");

                    return ShowPlayerPickupNumberRandomDialog(playerid);
                }
                case 1:
                {
                    return ShowPlayerPickupNumberCustomDialog(playerid);
                }
            }
            return 1;
        }
        case DIALOG_PICKUP_NUMBER_RANDOM:
        {
            if(response)
            {
                return BuyPlayerPickupNumber(playerid, g_pickup_number_text[playerid], g_pickup_number_region[playerid], PICKUP_NUMBER_BUY_RU, "окупка случайного номера");
            }

            if(GetPlayerMoneyEx(playerid) < PICKUP_NUMBER_REROLL_RU)
            {
                new fmt_text[128];
                format(fmt_text, sizeof fmt_text, "едостаточно денег. л повторного прокрута необходимо %d рублей", PICKUP_NUMBER_REROLL_RU);
                ShowNotification(playerid, 2, fmt_text, 4, "", "");
                return ShowPlayerPickupNumberRandomDialog(playerid);
            }

            GivePlayerMoneyEx(playerid, -PICKUP_NUMBER_REROLL_RU, "овторнй прокрут номера", true, true);

            if(!RollPlayerPickupNumber(playerid))
                return ShowNotification(playerid, 2, "е удалос подобрат свободнй номер. опробуйте еще раз", 4, "", "");

            return ShowPlayerPickupNumberRandomDialog(playerid);
        }
        case DIALOG_PICKUP_NUMBER_CUSTOM:
        {
            if(!response) return ShowPlayerPickupNumberMainDialog(playerid);
            return BuyPlayerPickupCustomNumber(playerid, inputtext);
        }
        
        
		case DIALOG_LAIRD_ACS_EDIT_LIST:
		{
			if(!response)
				return 1;

			new slot = GetPlayerListitemValue(playerid, listitem);
			return LairdAccEdit_StartBySlot(playerid, slot);
		}
		case DIALOG_LAIRD_ACS_EDIT_MAIN:
		{
			if(!response)
			{
				LairdAccEdit_Clear(playerid);
				return 1;
			}

			switch(listitem)
			{
				case 0..6:
				{
					return LairdAccEdit_ShowAction(playerid, listitem);
				}
				case 7:
				{
					if(LairdAccEdit_Save(playerid))
						SendClientMessage(playerid, -1, "астройки аксессуара сохранен.");
					else
						SendClientMessage(playerid, -1, "шибка сохранени аксессуара.");

					LairdAccEdit_Clear(playerid);
					return 1;
				}
				case 8:
				{
					LairdAccEdit_Reset(playerid);
					return LairdAccEdit_ShowMain(playerid);
				}
				case 9:
				{
					LairdAccEdit_Clear(playerid);
					return 1;
				}
			}

			return 1;
		}
		case DIALOG_LAIRD_ACS_EDIT_ACTION:
		{
			new param = GetPVarInt(playerid, "laird_acc_edit_param");

			if(!response)
				return LairdAccEdit_ShowMain(playerid);

			if(listitem == 2)
			{
				Dialog
				(
					playerid, DIALOG_LAIRD_ACS_EDIT_INPUT, DIALOG_STYLE_INPUT,
					"{FFCD00}ведите значение",
					"кажите точное числовое значение параметра.",
					"рименит", "азад"
				);
				return 1;
			}

			if(param < 0 || param >= sizeof laird_acs_param_names)
				return 1;

			new Float:new_value = LairdAccEdit_GetValue(playerid, param);

			if(listitem == 0)
				new_value += laird_acs_step[param];
			else if(listitem == 1)
				new_value -= laird_acs_step[param];
			else
				return 1;

			if(param >= 3 && param <= 5)
			{
				if(new_value > laird_acs_max[param]) new_value = laird_acs_min[param];
				if(new_value < laird_acs_min[param]) new_value = laird_acs_max[param];
			}
			else
			{
				if(new_value > laird_acs_max[param]) new_value = laird_acs_max[param];
				if(new_value < laird_acs_min[param]) new_value = laird_acs_min[param];
			}

			LairdAccEdit_SetValue(playerid, param, new_value);
			LairdAccEdit_Apply(playerid);

			return LairdAccEdit_ShowAction(playerid, param);
		}
		case DIALOG_LAIRD_ACS_EDIT_INPUT:
		{
			new param = GetPVarInt(playerid, "laird_acc_edit_param");

			if(!response)
				return LairdAccEdit_ShowAction(playerid, param);

			new Float:value;

			if(sscanf(inputtext, "f", value))
			{
				SendClientMessage(playerid, -1, "ведите корректное число.");
				return LairdAccEdit_ShowAction(playerid, param);
			}

			if(param < 0 || param >= sizeof laird_acs_param_names)
				return 1;

			if(value > laird_acs_max[param]) value = laird_acs_max[param];
			if(value < laird_acs_min[param]) value = laird_acs_min[param];

			LairdAccEdit_SetValue(playerid, param, value);
			LairdAccEdit_Apply(playerid);

			return LairdAccEdit_ShowAction(playerid, param);
		}
        case DIALOG_LAIRD_ACS_TD_LIST:
        {
            if(!response)
                return 1;

            new inv_id = GetPlayerListitemValue(playerid, listitem);
            if(inv_id <= 0)
                return SendClientMessage(playerid, -1, "шибка вбора аксессуара."), 1;

            EditAccessory(playerid, inv_id);
            return 1;
        }
        case 9999:
        {
            if(!response)
                return 1;

            if(listitem == sizeof(laird_acs_give_map))
            {
                LairdAccTakeOffAll(playerid);
                return 1;
            }

            if(listitem < 0 || listitem >= sizeof(laird_acs_give_map))
                return 1;

            new acs_id = laird_acs_give_map[listitem];

            if(acs_id < 0 || acs_id >= sizeof accessory)
            {
                return SendClientMessage(playerid, -1, "тот аксессуар отсутствует в базе new.pwn.");
            }

            LairdAccGiveAndWear(playerid, acs_id, true);
            return 1;
        }
        
        case DIALOG_AEDIT_MAIN:
        {
            if(!response) return 1;

            new entity_type = GetPlayerListitemValue(playerid, listitem);
            switch(entity_type)
            {
                case 0: return ShowAEditBizTypeDialog(playerid);
                case 1: return ShowAEditHouseTypeDialog(playerid);
                case 2: return ShowAEditEntranceListDialog(playerid);
            }
            return ShowAEditMainDialog(playerid);
        }
        case DIALOG_AEDIT_BIZ_TYPE:
        {
            if(!response) return ShowAEditMainDialog(playerid);

            new biz_type = GetPlayerListitemValue(playerid, listitem);
            if(!AEdit_IsValidBusinessType(biz_type))
                return ShowAEditBizTypeDialog(playerid);

            return ShowAEditBizListDialog(playerid, biz_type, 0);
        }
        case DIALOG_AEDIT_HOUSE_TYPE:
        {
            if(!response) return ShowAEditMainDialog(playerid);

            new house_type = GetPlayerListitemValue(playerid, listitem);
            if(!(0 <= house_type < sizeof g_house_type))
                return ShowAEditHouseTypeDialog(playerid);

            return ShowAEditHouseListDialog(playerid, house_type, 0);
        }
        case DIALOG_AEDIT_BIZ_LIST:
        {
            if(!response) return ShowAEditBizTypeDialog(playerid);

            new biz_type = GetPVarInt(playerid, "aedit_biz_type");
            new page = GetPVarInt(playerid, "aedit_biz_page");
            new biz_id = GetPlayerListitemValue(playerid, listitem);

            if(biz_id == AEDIT_LIST_PREV)
                return ShowAEditBizListDialog(playerid, biz_type, page - 1);

            if(biz_id == AEDIT_LIST_NEXT)
                return ShowAEditBizListDialog(playerid, biz_type, page + 1);

            if(!(0 <= biz_id <= g_business_loaded - 1))
                return ShowAEditBizListDialog(playerid, biz_type, page);

            return ShowAEditBizActionDialog(playerid, biz_id);
        }
        case DIALOG_AEDIT_HOUSE_LIST:
        {
            if(!response) return ShowAEditHouseTypeDialog(playerid);

            new house_type = GetPVarInt(playerid, "aedit_house_type");
            new page = GetPVarInt(playerid, "aedit_house_page");
            new house_id = GetPlayerListitemValue(playerid, listitem);

            if(house_id == AEDIT_LIST_PREV)
                return ShowAEditHouseListDialog(playerid, house_type, page - 1);

            if(house_id == AEDIT_LIST_NEXT)
                return ShowAEditHouseListDialog(playerid, house_type, page + 1);

            if(!(0 <= house_id <= g_house_loaded - 1))
                return ShowAEditHouseListDialog(playerid, house_type, page);

            return ShowAEditHouseActionDialog(playerid, house_id);
        }
        case DIALOG_AEDIT_ENTRANCE_LIST:
        {
            if(!response) return ShowAEditMainDialog(playerid);

            new page = GetPVarInt(playerid, "aedit_entrance_page");
            new entrance_id = GetPlayerListitemValue(playerid, listitem);

            if(entrance_id == AEDIT_LIST_CREATE)
            {
                new created_id = AEdit_CreateEntrance(playerid);
                if(created_id == -1)
                    return ShowAEditEntranceListDialog(playerid, page);

                SendClientMessage(playerid, 0x3399FFFF, "одъезд создан.  AEdit можно сразу настроит вход, вход и этажи.");
                return ShowAEditEntranceActionDialog(playerid, created_id);
            }

            if(entrance_id == AEDIT_LIST_PREV)
                return ShowAEditEntranceListDialog(playerid, page - 1);

            if(entrance_id == AEDIT_LIST_NEXT)
                return ShowAEditEntranceListDialog(playerid, page + 1);

            if(!(0 <= entrance_id <= g_entrance_loaded - 1))
                return ShowAEditEntranceListDialog(playerid, page);

            return ShowAEditEntranceActionDialog(playerid, entrance_id);
        }
        case DIALOG_AEDIT_ENTRANCE_ACTION:
        {
            new entrance_id = GetPVarInt(playerid, "aedit_entrance_id");
            if(!(0 <= entrance_id <= g_entrance_loaded - 1))
                return ShowAEditEntranceListDialog(playerid, GetPVarInt(playerid, "aedit_entrance_page"));

            if(!response)
                return ShowAEditEntranceListDialog(playerid, GetPVarInt(playerid, "aedit_entrance_page"));

            switch(listitem)
            {
                case 0:
                {
                    AEdit_MoveEntranceToPlayer(playerid, entrance_id);
                    SendClientMessage(playerid, 0x66CC33FF, "ход подъезда перенесен на вашу позицию.");
                    return ShowAEditEntranceActionDialog(playerid, entrance_id);
                }
                case 1:
                {
                    AEdit_SetEntranceExitToPlayer(playerid, entrance_id);
                    SendClientMessage(playerid, 0x66CC33FF, "озици входа подъезда успешно обновлена.");
                    return ShowAEditEntranceActionDialog(playerid, entrance_id);
                }
                case 2:
                {
                    return Dialog
                    (
                        playerid,
                        DIALOG_AEDIT_ENTRANCE_FLOORS_INPUT,
                        DIALOG_STYLE_INPUT,
                        "{3399FF}AEdit | тажи подъезда",
                        "ведите количество этажей подъезда:",
                        "охранит",
                        "азад"
                    );
                }
            }
            return 1;
        }
        case DIALOG_AEDIT_ENTRANCE_FLOORS_INPUT:
        {
            new entrance_id = GetPVarInt(playerid, "aedit_entrance_id");
            if(!(0 <= entrance_id <= g_entrance_loaded - 1))
                return ShowAEditEntranceListDialog(playerid, GetPVarInt(playerid, "aedit_entrance_page"));

            if(!response)
                return ShowAEditEntranceActionDialog(playerid, entrance_id);

            new new_floors;
            if(sscanf(inputtext, "d", new_floors) || !(1 <= new_floors <= MAX_ENTRANCE_FLOORS))
            {
                new message[96];
                format(message, sizeof message, "ведите число этажей от 1 до %d.", MAX_ENTRANCE_FLOORS);
                SendClientMessage(playerid, 0xFF6600FF, message);
                return Dialog(playerid, DIALOG_AEDIT_ENTRANCE_FLOORS_INPUT, DIALOG_STYLE_INPUT, "{3399FF}AEdit | тажи подъезда", "ведите количество этажей подъезда:", "охранит", "азад");
            }

            AEdit_SetEntranceFloors(entrance_id, new_floors);
            SendClientMessage(playerid, 0x66CC33FF, "оличество этажей подъезда успешно изменено.");
            return ShowAEditEntranceActionDialog(playerid, entrance_id);
        }
        case DIALOG_AEDIT_BIZ_ACTION:
        {
            new biz_id = GetPVarInt(playerid, "aedit_biz_id");
            if(!(0 <= biz_id <= g_business_loaded - 1))
                return ShowAEditBizTypeDialog(playerid);

            if(!response)
                return ShowAEditBizListDialog(playerid, GetPVarInt(playerid, "aedit_biz_type"));

            switch(listitem)
            {
                case 0:
                {
                    return Dialog
                    (
                        playerid,
                        DIALOG_AEDIT_BIZ_DELETE_CONFIRM,
                        DIALOG_STYLE_MSGBOX,
                        "{FF5533}AEdit | даление бизнеса",
                        "{FFFFFF} уверен, что хотите удалит бизнес?\n\n{FF9900}изнес будет сброшен в гос. собственност.",
                        "далит",
                        "азад"
                    );
                }
                case 1:
                {
                    return ShowAEditBizTypeSetDialog(playerid);
                }
                case 2:
                {
                    return Dialog
                    (
                        playerid,
                        DIALOG_AEDIT_BIZ_PRICE_INPUT,
                        DIALOG_STYLE_INPUT,
                        "{FFCD00}AEdit | ена бизнеса",
                        "ведите новую цену бизнеса (толко число):",
                        "охранит",
                        "азад"
                    );
                }
                case 3:
                {
                    new query[220];
                    new Float:angle;

                    GetPlayerPos(playerid, g_business[biz_id][B_POS_X], g_business[biz_id][B_POS_Y], g_business[biz_id][B_POS_Z]);
                    GetPlayerFacingAngle(playerid, angle);

                    SetBusinessData(biz_id, B_EXIT_POS_X, GetBusinessData(biz_id, B_POS_X) + 1.5 * floatsin(-angle, degrees));
                    SetBusinessData(biz_id, B_EXIT_POS_Y, GetBusinessData(biz_id, B_POS_Y) + 1.5 * floatcos(-angle, degrees));
                    SetBusinessData(biz_id, B_EXIT_POS_Z, GetBusinessData(biz_id, B_POS_Z));
                    SetBusinessData(biz_id, B_EXIT_ANGLE, angle + 180.0);

                    mysql_format
                    (
                        mysql,
                        query, sizeof query,
                        "UPDATE business SET x='%f',y='%f',z='%f',exit_x='%f',exit_y='%f',exit_z='%f',exit_angle='%f' WHERE id=%d",
                        GetBusinessData(biz_id, B_POS_X),
                        GetBusinessData(biz_id, B_POS_Y),
                        GetBusinessData(biz_id, B_POS_Z),
                        GetBusinessData(biz_id, B_EXIT_POS_X),
                        GetBusinessData(biz_id, B_EXIT_POS_Y),
                        GetBusinessData(biz_id, B_EXIT_POS_Z),
                        GetBusinessData(biz_id, B_EXIT_ANGLE),
                        GetBusinessData(biz_id, B_SQL_ID)
                    );
                    mysql_query(mysql, query, false);

                    if(IsValidDynamic3DTextLabel(GetBusinessData(biz_id, B_LABEL)))
                        DestroyDynamic3DTextLabel(GetBusinessData(biz_id, B_LABEL));

                    SetBusinessData(biz_id, B_LABEL, CreateDynamic3DTextLabel(GetBusinessData(biz_id, B_NAME), 0xFFFF00FF, GetBusinessData(biz_id, B_POS_X), GetBusinessData(biz_id, B_POS_Y), GetBusinessData(biz_id, B_POS_Z) + 1.0, 6.50));

                    CallLocalFunction("UpdateBusinessLabel", "i", biz_id);
                    AEdit_RecreateBizEnterPickup(biz_id);

                    SetPVarInt(playerid, "aedit_biz_enter_block_id", biz_id);
                    SetPVarInt(playerid, "aedit_biz_enter_block_time", gettime() + 5);

                    SendClientMessage(playerid, 0x66CC33FF, "изнес перемещен на вашу позицию. ход заблокирован на 5 секунд.");
                    SendClientMessage(playerid, 0x66CC33FF, "озици входа вставлена автоматически рдом со входом.");

                    return ShowAEditBizActionDialog(playerid, biz_id);
                }
                case 4:
                {
                    new query[170];

                    GetPlayerPos(playerid, g_business[biz_id][B_EXIT_POS_X], g_business[biz_id][B_EXIT_POS_Y], g_business[biz_id][B_EXIT_POS_Z]);
                    GetPlayerFacingAngle(playerid, g_business[biz_id][B_EXIT_ANGLE]);

                    mysql_format
                    (
                        mysql,
                        query, sizeof query,
                        "UPDATE business SET exit_x='%f',exit_y='%f',exit_z='%f',exit_angle='%f' WHERE id=%d",
                        GetBusinessData(biz_id, B_EXIT_POS_X),
                        GetBusinessData(biz_id, B_EXIT_POS_Y),
                        GetBusinessData(biz_id, B_EXIT_POS_Z),
                        GetBusinessData(biz_id, B_EXIT_ANGLE),
                        GetBusinessData(biz_id, B_SQL_ID)
                    );
                    mysql_query(mysql, query, false);

                    SendClientMessage(playerid, 0x66CC33FF, "озици входа бизнеса успешно обновлена.");
                    return ShowAEditBizActionDialog(playerid, biz_id);
                }
            }
            return 1;
        }
        case DIALOG_AEDIT_HOUSE_ACTION:
        {
            new house_id = GetPVarInt(playerid, "aedit_house_id");
            if(!(0 <= house_id <= g_house_loaded - 1))
                return ShowAEditHouseTypeDialog(playerid);

            if(!response)
                return ShowAEditHouseListDialog(playerid, GetPVarInt(playerid, "aedit_house_type"));

            switch(listitem)
            {
                case 0:
                {
                    return Dialog
                    (
                        playerid,
                        DIALOG_AEDIT_HOUSE_DELETE_CONFIRM,
                        DIALOG_STYLE_MSGBOX,
                        "{FF5533}AEdit | даление дома",
                        "{FFFFFF} уверен, что хотите удалит дом?\n\n{FF9900}ом будет сброшен в гос. собственност.",
                        "далит",
                        "азад"
                    );
                }
                case 1:
                {
                    return ShowAEditHouseTypeSetDialog(playerid);
                }
                case 2:
                {
                    return Dialog
                    (
                        playerid,
                        DIALOG_AEDIT_HOUSE_PRICE_INPUT,
                        DIALOG_STYLE_INPUT,
                        "{33AACC}AEdit | ена дома",
                        "ведите новую цену дома (толко число):",
                        "охранит",
                        "азад"
                    );
                }
                case 3:
                {
                    new query[255];
                    new Float:angle;

                    GetPlayerPos(playerid, g_house[house_id][H_POS_X], g_house[house_id][H_POS_Y], g_house[house_id][H_POS_Z]);
                    GetPlayerFacingAngle(playerid, angle);

                    SetHouseData(house_id, H_EXIT_POS_X, GetHouseData(house_id, H_POS_X) + 1.5 * floatsin(-angle, degrees));
                    SetHouseData(house_id, H_EXIT_POS_Y, GetHouseData(house_id, H_POS_Y) + 1.5 * floatcos(-angle, degrees));
                    SetHouseData(house_id, H_EXIT_POS_Z, GetHouseData(house_id, H_POS_Z));
                    SetHouseData(house_id, H_EXIT_ANGLE, angle + 180.0);

                    mysql_format
                    (
                        mysql,
                        query, sizeof query,
                        "UPDATE houses SET x='%f',y='%f',z='%f',exit_x='%f',exit_y='%f',exit_z='%f',exit_angle='%f' WHERE id=%d",
                        GetHouseData(house_id, H_POS_X),
                        GetHouseData(house_id, H_POS_Y),
                        GetHouseData(house_id, H_POS_Z),
                        GetHouseData(house_id, H_EXIT_POS_X),
                        GetHouseData(house_id, H_EXIT_POS_Y),
                        GetHouseData(house_id, H_EXIT_POS_Z),
                        GetHouseData(house_id, H_EXIT_ANGLE),
                        GetHouseData(house_id, H_SQL_ID)
                    );
                    mysql_query(mysql, query, false);

                    UpdateHouse(house_id);

                    SetPVarInt(playerid, "aedit_house_enter_block_id", house_id);
                    SetPVarInt(playerid, "aedit_house_enter_block_time", gettime() + 5);

