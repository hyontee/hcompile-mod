		format(fmt_text, sizeof fmt_text, "\nравителство - ицензёр - %s[%d] - тел. %d", GetPlayerNameEx(i), i, GetPlayerPhone(i));
		strcat(list, fmt_text);
	}

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCD00}ицензёр онлайн", list, "акрт", "");

	return 1;
}

