				case PICKUP_ACTION_TYPE_ENTRANCE_FLA:
{
    new flat_id = action_id; // никалнй ID квартир
    new entranceid = GetPlayerInEntrance(playerid);
    
    if(entranceid != -1)
    {
        // аходим ID дома по ID квартир
        new floor = flat_id / 4;
        new flat_on_floor = flat_id % 4;
        new houseid = g_flat_house_id[entranceid][floor][flat_on_floor];
        
        // роверем, ест ли дом в этом месте
        if(houseid != -1 && houseid < g_house_loaded && IsHouseOwned(houseid))
        {
            // ом уже куплен - показваем информацию
            ShowPlayerHouseInfo(playerid, houseid);
        }
        else
        {
            // =====   - Ё   =====
            new new_houseid = GetFreeHouseID();
            if(new_houseid == -1)
            {
                SendClientMessage(playerid, 0xFF0000FF, "шибка: остигнут лимит домов на сервере.");
                return 1;
            }
            
            // пределем тип квартир из подъезда (по умолчанию 0 - эконом)
            new apt_type = 0;
            
            // олучаем позицию входа (из подъезда)
            new Float:pos_x = GetEntranceData(entranceid, E_POS_X);
            new Float:pos_y = GetEntranceData(entranceid, E_POS_Y);
            new Float:pos_z = GetEntranceData(entranceid, E_POS_Z);
            
            // аполнем структуру дома
            SetHouseData(new_houseid, H_SQL_ID, 0);
            SetHouseData(new_houseid, H_OWNER_ID, 0);
            
            // сползуем цен из типа квартир
            SetHouseData(new_houseid, H_PRICE, g_apartment_types[apt_type][APT_PRICE]);
            SetHouseData(new_houseid, H_RENT_PRICE, g_apartment_types[apt_type][APT_RENT_PRICE]);
            
            // ип дома (интерер) - по умолчанию 0
            SetHouseData(new_houseid, H_TYPE, 0);
            SetHouseData(new_houseid, H_ENTRACE, entranceid);
            SetHouseData(new_houseid, H_IMPROVEMENTS, 0);
            SetHouseData(new_houseid, H_RENT_DATE, 0);
            SetHouseData(new_houseid, H_LOCK_STATUS, false);
            
            // опируем позицию из подъезда
            SetHouseData(new_houseid, H_POS_X, pos_x);
            SetHouseData(new_houseid, H_POS_Y, pos_y);
            SetHouseData(new_houseid, H_POS_Z, pos_z);
            
            // станавливаем позицию входа
            SetHouseData(new_houseid, H_EXIT_POS_X, pos_x + 1.0);
            SetHouseData(new_houseid, H_EXIT_POS_Y, pos_y + 1.0);
            SetHouseData(new_houseid, H_EXIT_POS_Z, pos_z);
            SetHouseData(new_houseid, H_EXIT_ANGLE, 0.0);
            
            // станавливаем позицию машин
            SetHouseData(new_houseid, H_CAR_POS_X, pos_x + 2.0);
            SetHouseData(new_houseid, H_CAR_POS_Y, pos_y + 2.0);
            SetHouseData(new_houseid, H_CAR_POS_Z, pos_z);
            SetHouseData(new_houseid, H_CAR_ANGLE, 0.0);
            
            // брасваем шкаф
            SetHouseData(new_houseid, H_STORE_X, 0.0);
            SetHouseData(new_houseid, H_STORE_Y, 0.0);
            SetHouseData(new_houseid, H_STORE_Z, 0.0);
            SetHouseData(new_houseid, H_STORE_METALL, 0);
            SetHouseData(new_houseid, H_STORE_DRUGS, 0);
            SetHouseData(new_houseid, H_STORE_WEAPON, 0);
            SetHouseData(new_houseid, H_STORE_AMMO, 0);
            SetHouseData(new_houseid, H_STORE_SKIN, 0);
            
            SetHouseData(new_houseid, H_STORE_LABEL, Text3D:-1);
            SetHouseData(new_houseid, H_LABEL, Text3D:-1);
            SetHouseData(new_houseid, H_ENTER_PICKUP, 0);
            SetHouseData(new_houseid, H_HEALTH_PICKUP, 0);
            SetHouseData(new_houseid, H_MAP_ICON, -1);
            SetHouseData(new_houseid, H_FLAT_ID, flat_id);
            SetHouseData(new_houseid, H_EVICTION, 0);
            
            format(g_house[new_houseid][H_NAME], 20, "вартира %d", flat_id + 1);
            format(g_house[new_houseid][H_OWNER_NAME], 21, "None");
            
            // ===== ЯЯ query  =====
            new query[1024];
            
            // охранем в 
            mysql_format
            (
                mysql, query, sizeof query,
                "INSERT INTO houses \
                (type, name, owner_id, improvements, rent_time, price, rent_price, `lock`, entrance, x, y, z, exit_x, exit_y, exit_z, exit_angle, car_x, car_y, car_z, car_angle, store_x, store_y, store_z, eviction, store_metall, store_drugs, store_weapon, store_ammo, store_skin)\
                VALUES ('%d', '%e', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%d', '%d', '%d', '%d', '%d', '%d')",
                GetHouseData(new_houseid, H_TYPE),
                g_house[new_houseid][H_NAME],
                GetHouseData(new_houseid, H_OWNER_ID),
                GetHouseData(new_houseid, H_IMPROVEMENTS),
                GetHouseData(new_houseid, H_RENT_DATE),
                GetHouseData(new_houseid, H_PRICE),
                GetHouseData(new_houseid, H_RENT_PRICE),
                GetHouseData(new_houseid, H_LOCK_STATUS),
                GetHouseData(new_houseid, H_ENTRACE),
                GetHouseData(new_houseid, H_POS_X),
                GetHouseData(new_houseid, H_POS_Y),
                GetHouseData(new_houseid, H_POS_Z),
                GetHouseData(new_houseid, H_EXIT_POS_X),
                GetHouseData(new_houseid, H_EXIT_POS_Y),
                GetHouseData(new_houseid, H_EXIT_POS_Z),
                GetHouseData(new_houseid, H_EXIT_ANGLE),
                GetHouseData(new_houseid, H_CAR_POS_X),
                GetHouseData(new_houseid, H_CAR_POS_Y),
                GetHouseData(new_houseid, H_CAR_POS_Z),
                GetHouseData(new_houseid, H_CAR_ANGLE),
                GetHouseData(new_houseid, H_STORE_X),
                GetHouseData(new_houseid, H_STORE_Y),
                GetHouseData(new_houseid, H_STORE_Z),
                GetHouseData(new_houseid, H_EVICTION),
                GetHouseData(new_houseid, H_STORE_METALL),
                GetHouseData(new_houseid, H_STORE_DRUGS),
                GetHouseData(new_houseid, H_STORE_WEAPON),
                GetHouseData(new_houseid, H_STORE_AMMO),
                GetHouseData(new_houseid, H_STORE_SKIN)
            );
            
            new Cache:result = mysql_query(mysql, query, true);
            
            if(mysql_errno())
            {
                printf("[PICKUP_ENTRANCE_FLA] SQL ERROR: %d", mysql_errno());
                printf("[PICKUP_ENTRANCE_FLA] QUERY: %s", query);
                cache_delete(result);
                SendClientMessage(playerid, 0xFF6600FF, "шибка создани квартир. братитес к администрации.");
                return 1;
            }
            
            new sql_id = cache_insert_id();
            cache_delete(result);
            
            if(sql_id <= 0)
            {
                SendClientMessage(playerid, 0xFF6600FF, "шибка: квартира не получила ID в базе даннх.");
                return 1;
            }
            
            SetHouseData(new_houseid, H_SQL_ID, sql_id);
            
            // охранем свз квартир с домом
            g_flat_house_id[entranceid][floor][flat_on_floor] = new_houseid;
            g_house_loaded++;
            
            // бновлем статус подъезда
            EntranceStatusInit(entranceid);
            
            // бновлем пикап квартир на зантую (красную)
            UpdateFlatPickup(entranceid, flat_id, true);
            
            // оказваем диалог покупки
            SetPlayerUseListitem(playerid, new_houseid);
            
            new string[512];
            
            // олучаем название типа квартир
            new apt_name[32];
            format(apt_name, sizeof(apt_name), "%s", g_apartment_types[apt_type][APT_NAME]);
            
            format(string, sizeof string, 
                "{FFFFFF}ип: \t\t\t{00FF00}%s\t\t\t\t\t\t\t\t\t\n\
                {FFFFFF}омер квартир: \t\t{00FF00}%d\t\t\t\t\t\t\t\t\t\n\
                {FFFFFF}омер подъезда: \t\t{00FF00}%d\t\t\t\t\t\t\t\t\t\n\
                {FFFFFF}таж: \t\t\t{00FF00}%d\t\t\t\t\t\t\t\t\t\n\
                {FFFFFF}оличество комнат: \t\t{00FF00}%d\t\t\t\t\t\t\t\t\t\n\
                {FFFFFF}тоимост: \t\t{00FF00}%d руб\t\t\t\t\t\t\t\t\t\n\
                {FFFFFF}жедневна квартплата: \t{00FF00}%d руб\t\t\t\t\t\t\t\t\t",
                apt_name,
                flat_id + 1,
                entranceid + 1,
                floor + 1,
                g_apartment_types[apt_type][APT_ROOMS],
                GetHouseData(new_houseid, H_PRICE),
                GetHouseData(new_houseid, H_RENT_PRICE)
            );
            
            Dialog(playerid, DIALOG_HOUSE_BUY, DIALOG_STYLE_LIST, 
                "{33CC00}вартира свободна", string, "упит", "тмена");
        }
    }
    else
    {
        SendClientMessage(playerid, 0xFF0000FF, "шибка:  не в подъезде.");
    }
}
				case PICKUP_ACTION_TYPE_ORG_CAR:
