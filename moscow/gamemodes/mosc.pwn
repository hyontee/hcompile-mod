                    GetPlayerNameEx(to_player), value_1);
            }
            default: return 1;
        }

        ShowNotificationNew(to_player, 4, 10, notify_id, extra, fmt_text, ">>");
        
        SetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER, to_player);
        SetPlayerOfferInfo(to_player, O_INCOMING_PLAYER, playerid);
        SetPlayerOfferInfo(to_player, O_INCOMING_TYPE, type);
        SetPlayerOfferValue(to_player, 0, value_1);
        SetPlayerOfferValue(to_player, 1, value_2);
    }
    else SendClientMessage(playerid, 0xFFFFFFFF, "сползуйте {FF9900}/cancel {FFFFFF}чтоб отозват преддущее предложение");

    return 1;
}


stock CreateDPSZones()
{
    g_DPSZones[0][DPS_MIN_X] = 1603.366577;
    g_DPSZones[0][DPS_MIN_Y] = -677.963439;
    g_DPSZones[0][DPS_MAX_X] = 1618.756835;
    g_DPSZones[0][DPS_MAX_Y] = -548.822021;
    g_DPSZones[0][DPS_WORLD] = 0;
    g_DPSZones[0][DPS_INTERIOR] = 0;
    g_DPSZones[0][DPS_AREA] = CreateDynamicRectangle(
        g_DPSZones[0][DPS_MIN_X],
        g_DPSZones[0][DPS_MIN_Y],
        g_DPSZones[0][DPS_MAX_X],
        g_DPSZones[0][DPS_MAX_Y],
        g_DPSZones[0][DPS_WORLD],
        g_DPSZones[0][DPS_INTERIOR]
    );

    g_DPSZones[1][DPS_MIN_X] = 1624.010986;
    g_DPSZones[1][DPS_MIN_Y] = -675.274475;
    g_DPSZones[1][DPS_MAX_X] = 1638.144042;
    g_DPSZones[1][DPS_MAX_Y] = -534.162292;
    g_DPSZones[1][DPS_WORLD] = 0;
    g_DPSZones[1][DPS_INTERIOR] = 0;
    g_DPSZones[1][DPS_AREA] = CreateDynamicRectangle(
        g_DPSZones[1][DPS_MIN_X],
        g_DPSZones[1][DPS_MIN_Y],
        g_DPSZones[1][DPS_MAX_X],
        g_DPSZones[1][DPS_MAX_Y],
        g_DPSZones[1][DPS_WORLD],
        g_DPSZones[1][DPS_INTERIOR]
    );

    // оздаем 3D текст над зонами (дл красот)
    new Float:center_x, Float:center_y, Float:center_z = 39.0;
    
    // ентр зон 1
    center_x = (g_DPSZones[0][DPS_MIN_X] + g_DPSZones[0][DPS_MAX_X]) / 2;
    center_y = (g_DPSZones[0][DPS_MIN_Y] + g_DPSZones[0][DPS_MAX_Y]) / 2;
    CreateDynamic3DTextLabel(
        "{FF0000} ",
        0xFFFFFFFF, center_x, center_y, center_z + 5.0, 30.0
    );

    // ентр зон 2
    center_x = (g_DPSZones[1][DPS_MIN_X] + g_DPSZones[1][DPS_MAX_X]) / 2;
    center_y = (g_DPSZones[1][DPS_MIN_Y] + g_DPSZones[1][DPS_MAX_Y]) / 2;
    CreateDynamic3DTextLabel(
        "{FF0000} ",
        0xFFFFFFFF, center_x, center_y, center_z + 5.0, 30.0
    );

    printf("[DPS Zones]: оздано %d зон ", sizeof(g_DPSZones));
    return 1;
}

stock SetPlayerVehicleSpeed(playerid, speed)
{
    if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return 0;
    
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float:current_speed = GetVehicleSpeed(vehicleid);
    
    if(floatround(current_speed) <= speed)
        return 1;
    
    new Float:x, Float:y, Float:z, Float:angle;
    GetVehicleVelocity(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    
    new Float:new_speed = float(speed) / 100.0;
    x = new_speed * floatsin(-angle, degrees);
    y = new_speed * floatcos(-angle, degrees);
    
    SetVehicleVelocity(vehicleid, x, y, z - new_speed / 1000.0);
    
    return 1;
}


stock StartTakingMaterials(playerid)
{
    if(g_PlayerTakingMat[playerid])
        return 0;

    g_PlayerMatCount[playerid] = 0;
    g_PlayerTakingMat[playerid] = true;
    
    SendClientMessage(playerid, 0xFFFF00FF, ""SC" начали кражу материалов из ...");
    ShowNotificationNew(playerid, 3, 3, -1, -1, "ража материалов начата!", "");
    
    g_PlayerMatTakeTimer[playerid] = SetTimerEx("TakeMaterialFromArmy", ARMY_MAT_TAKE_COOLDOWN, true, "i", playerid);
    
    return 1;
}

forward TakeMaterialFromArmy(playerid);
public TakeMaterialFromArmy(playerid)
{
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, 1562.394897, 1643.307983, 15.971530))
    {
        StopTakingMaterials(playerid);
        SendClientMessage(playerid, 0xFF6600FF, ""USC" вшли из зон кражи! роцесс остановлен.");
        ShowNotificationNew(playerid, 2, 3, -1, -1, "ража остановлена!  вшли из зон.", "");
        return 1;
    }
    
    if(GetPlayerData(playerid, P_METALL) >= MAX_ARMY_MAT_TAKE)
    {
        StopTakingMaterials(playerid);
        SendClientMessage(playerid, 0x00FF00FF, ""SC" достигли лимита материалов (20 кг)!");
        ShowNotificationNew(playerid, 3, 3, -1, -1, "ража завершена! имит достигнут.", "");
        return 1;
    }
    
    new army_metal = GetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT);
    if(army_metal <= 0)
    {
        StopTakingMaterials(playerid);
        SendClientMessage(playerid, 0xFF6600FF, ""USC"а складе  закончилис материал!");
        ShowNotificationNew(playerid, 2, 3, -1, -1, "атериал на складе закончилис!", "");
        return 1;
    }
    
    new take_amount = 1;
    if(army_metal < take_amount)
        take_amount = army_metal;
    
    AddPlayerData(playerid, P_METALL, +, take_amount);
    UpdatePlayerDatabaseInt(playerid, "metall", GetPlayerData(playerid, P_METALL));

    SetRepositoryData(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL, R_AMOUNT, army_metal - take_amount);
    UpdateRepository(REPOSITORY_TYPE_ARMY, REPOSITORY_ACTION_ARMY_METAL);
    
    g_PlayerMatCount[playerid] += take_amount;
    new total = GetPlayerData(playerid, P_METALL);
    
    new fmt_msg[128];
    format(fmt_msg, sizeof(fmt_msg), ""SC"зто {FFFF00}%d кг {FFFFFF}материалов. сего: {FFFF00}%d/{FF0000}20 кг", 
        take_amount, total);
    SendClientMessage(playerid, 0x00FF00FF, fmt_msg);
    
    ApplyAnimationEx(playerid, "CARRY", "liftup", 4.0, 0, 0, 0, 0, 0, 0);

    if(total >= MAX_ARMY_MAT_TAKE)
    {
        StopTakingMaterials(playerid);
        SendClientMessage(playerid, 0x00FF00FF, ""SC"ража завершена!  взли {FF0000}20 кг {FFFFFF}материалов!");
        ShowNotificationNew(playerid, 3, 3, -1, -1, "ража завершена! аксимум материалов.", "");

        new fmt_msg2[128];
        format(fmt_msg2, sizeof(fmt_msg2), "{FF0000}[] {FFFFFF}еизвестнй украл материал со склада !");
        SendMessageToTeam(TEAM_ARMY, fmt_msg2, 0xFF0000FF);
    }
    
    return 1;
}

stock StopTakingMaterials(playerid)
{
    if(!g_PlayerTakingMat[playerid])
        return 0;
    
    g_PlayerTakingMat[playerid] = false;
    
    if(g_PlayerMatTakeTimer[playerid] != -1)
    {
        KillTimer(g_PlayerMatTakeTimer[playerid]);
        g_PlayerMatTakeTimer[playerid] = -1;
    }
    ClearAnimations(playerid);
    
    return 1;
}


stock ShowBanDialog(playerid)
{
    new fmt_str[1024];
    new year, month, day, hour, minute, second;

    timestamp_to_date(g_BanInfo[playerid][1], year, month, day, hour, minute, second);
    new ban_date[32];
    format(ban_date, sizeof(ban_date), "%02d.%02d.%d в %02d:%02d", day, month, year, hour, minute);
    
    timestamp_to_date(g_BanInfo[playerid][2], year, month, day, hour, minute, second);
    new unban_date[32];
    format(unban_date, sizeof(unban_date), "%02d.%02d.%d в %02d:%02d", day, month, year, hour, minute);
    
    format(fmt_str, sizeof(fmt_str),
        "{FFFFFF}аш аккаунт бл заблокирован администрацией за нарушение\n\
        правил сервера.  не можете играт на своем аккаунте во врем действи блокировки.\n\n\
        {FFFF00}|{FFFFFF}аш никнейм: {FFFF00}%s\n\
        {FFFF00}|{FFFFFF}икнейм администратора: {FFFF00}%s\n\
        {FFFF00}|{FFFFFF}ата вданной блокировки: {FFFF00}%s\n\
        {FFFF00}|{FFFFFF}ата разблокировки: {FFFF00}%s\n\
        {FFFF00}|{FFFFFF}ричина блокировки: {FFFF00}%s\n\n\
        {FFFFFF} не согласн с решением администратора и считаете, что наказание\n\
        бло вдано несправедливо или ошибочно?  таком случае,\n необходимо обратитс в специалнй раздел с жалобой на\n официалном форуме проекта: {FFFF00}forum.usupovrp.ru.\n\n\
        {FFFFFF}е забудте прикрепит скриншот данного окна в жалобу.",
        g_BanPlayerName[playerid],
        g_BanAdmin[playerid],
        ban_date,
        unban_date,
        g_BanReason[playerid]
    );
    
    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, 
        "{FF5A5A}SANTA MOBILE RP {FFFFFF}| ккаунт заблокирован", 
        fmt_str, 
        "акрт", "");
}

public KickPlayerAfterBan(playerid)
{
    Kick(playerid);
    return 1;
}


stock Date(timestamp)
{
    new year, month, day, hour, minute, second;
    timestamp_to_date(timestamp, year, month, day, hour, minute, second);
    new date_str[32];
    format(date_str, sizeof(date_str), "%02d.%02d.%d %02d:%02d", day, month, year, hour, minute);
    return date_str;
}

CMD:setminerpay(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    new pay;
    if(sscanf(params, "d", pay))
        return SendClientMessage(playerid, 0xCECECEFF, "сползование: /setminerpay [сумма за кг]");
    
    if(pay < 1 || pay > 100000)
        return SendClientMessage(playerid, 0xCECECEFF, "умма должна бт от 1 до 100000");
    
    g_temp_jobs[TEMP_JOB_MINER][TJ_PAY_FOR_LOAD] = pay;
    
    new fmt_msg[128];
    format(fmt_msg, sizeof(fmt_msg), "арплата шахтера изменена на %d рублей за кг", pay);
    SendClientMessage(playerid, 0x66CC33FF, fmt_msg);
    
    return 1;
}

CMD:givealldrive(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6)
        return SendClientMessage(playerid, 0x999999FF, ""USC" вас недостаточно прав! ужен 6+ уровен.");

    if(strlen(params))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /givealldrive");

    new query[96];
    mysql_format(mysql, query, sizeof query, "UPDATE accounts SET driving_lic=(driving_lic | %d)", DRIVING_LIC_FLAGS_ALL);
    mysql_tquery(mysql, query, "", "");

    new online_count, updated_count, fmt_msg[160];

    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i) || !IsPlayerLogged(i)) continue;

        online_count++;

        new current_lic = DrivingSchoolNormalizeLicenseValue(GetPlayerData(i, P_DRIVING_LIC));
        if((current_lic & DRIVING_LIC_FLAGS_ALL) == DRIVING_LIC_FLAGS_ALL) continue;

        DrivingSchoolSetLicenseValue(i, current_lic | DRIVING_LIC_FLAGS_ALL, false);
        updated_count++;
        SendClientMessage(i, 0x66CC33FF, "{1E90FF}[ицензии]:{FFFFFF} дминистраци вдала ам водителские права категорий A, B, C, D.");
    }

    format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] вдал водителские права всем аккаунтам на сервере. нлайн обновлено: %d из %d", 
        GetPlayerNameEx(playerid), playerid, updated_count, online_count);
    SendMessageToAdmins(fmt_msg, 0x999999FF);

    format(fmt_msg, sizeof fmt_msg, "дал водителские права всем аккаунтам на сервере (онлайн обновлено: %d из %d)", updated_count, online_count);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_msg);

    SendClientMessage(playerid, 0x66CC00FF, "одителские права вдан всем аккаунтам на сервере.");
    return 1;
}
CMD:giveallrub(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");

    new amount;
    if(sscanf(params, "d", amount))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /giveallrub [сумма]");

    if(amount < 1 || amount > 10000)
        return SendClientMessage(playerid, 0xCECECEFF, "умма должна бт от 1 до 10000 донат-рублей");

    new count, fmt_msg[128];
    
    foreach(new i : Player)
    {
        if(!IsPlayerLogged(i)) continue;
        
        GivePlayerDonateRub(i, amount, "дача всем игрокам от администрации", true, true);
        count++;
    }

    format(fmt_msg, sizeof(fmt_msg), "[A] %s[%d] вдал всем игрокам %d донат-рублей! сего получено: %d игроков", 
        GetPlayerNameEx(playerid), playerid, amount, count);
    SendClientMessageToAll(0xFFFF00FF, fmt_msg);
    
    format(fmt_msg, sizeof(fmt_msg), "дал всем игрокам %d донат-рублей (%d игроков)", amount, count);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_msg);

    return 1;
}

stock bool:CanUseMedkit(playerid)
{
    new bool:canUse = true;

    if(g_PlayerMedkitUsed[playerid] == true)
    {
        canUse = false;
    }

    return canUse;
}

stock SetPlayerMedkitUsed(playerid, bool:used)
{
    g_PlayerMedkitUsed[playerid] = used;
}

forward ResetMedkitCooldown(playerid);
public ResetMedkitCooldown(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        g_PlayerMedkitUsed[playerid] = false;
    }
}


stock SimInventory_EnsureSchema()
{
    mysql_query(mysql, "CREATE TABLE IF NOT EXISTS `player_sim_inventory` (\
        `id` INT(11) NOT NULL AUTO_INCREMENT,\
        `player_id` INT(11) NOT NULL,\
        `sim_number` VARCHAR(16) NOT NULL,\
        `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\
        PRIMARY KEY (`id`),\
        INDEX `player_id` (`player_id`)\
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci", false);
    if(mysql_errno())
    {
        printf("[SIM] schema init error: %d", mysql_errno());
    }
    return 1;
}
stock ResetPlayerSimResourceState(playerid)
{
    g_player_sim_owner_id[playerid] = 0;
    g_player_sim_resource_count[playerid] = 0;

    for(new i = 0; i < 32; i++)
    {
        g_player_sim_resource[playerid][i][PSR_SQL_ID] = 0;
        g_player_sim_resource[playerid][i][PSR_NUMBER][0] = 0;
    }
    return 1;
}
stock LoadPlayerSimResources(playerid)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0) return 0;
    new query[160], Cache:result;
    g_player_sim_resource_count[playerid] = 0;
    mysql_format(mysql, query, sizeof query, "SELECT id, sim_number FROM player_sim_inventory WHERE player_id=%d ORDER BY id ASC LIMIT 32", account_id);
    result = mysql_query(mysql, query, true);
    for(new i; i < cache_num_rows() && i < 32; i++)
    {
        g_player_sim_resource_count[playerid]++;
        g_player_sim_resource[playerid][i][PSR_SQL_ID] = cache_get_field_content_int(i, "id");
        cache_get_field_content(i, "sim_number", g_player_sim_resource[playerid][i][PSR_NUMBER], mysql, 16);
    }
    cache_delete(result);
    return 1;
}

stock GivePlayerSimResource(playerid, number[])
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0) return 0;

    if(g_player_sim_resource_count[playerid] >= 32)
    {
        SendClientMessage(playerid, 0x999999FF, "аш инвентар SIM-карт переполнен!");
        return 0;
    }

    for(new i = 0; i < g_player_sim_resource_count[playerid]; i++)
    {
        if(strcmp(g_player_sim_resource[playerid][i][PSR_NUMBER], number) == 0)
        {
            printf("[SIM] SIM-карта %s уже ест в памти игрока %d", number, playerid);
            return 1;
        }
    }

    new query[256], Cache:result;
    mysql_format(mysql, query, sizeof(query),
        "SELECT id FROM player_sim_cards WHERE player_id=%d AND number='%s' LIMIT 1",
        account_id, number);
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows() > 0)
    {
        printf("[SIM] SIM-карта %s уже ест в  дл игрока %d", number, playerid);
        cache_delete(result);
        return 1;
    }
    cache_delete(result);

    new count = g_player_sim_resource_count[playerid];
    format(g_player_sim_resource[playerid][count][PSR_NUMBER], 16, number);
    g_player_sim_resource[playerid][count][PSR_SQL_ID] = 0;
    g_player_sim_resource_count[playerid]++;
    
    mysql_format(mysql, query, sizeof(query),
        "INSERT INTO player_sim_cards (player_id, number) VALUES (%d, '%s')",
        account_id, number);
    mysql_query(mysql, query, false);

    if(mysql_errno() == 0)
    {
        new Cache:insert_result;
        mysql_format(mysql, query, sizeof(query),
            "SELECT id FROM player_sim_cards WHERE player_id=%d AND number='%s' ORDER BY id DESC LIMIT 1",
            account_id, number);
        insert_result = mysql_query(mysql, query, true);
        
        if(cache_num_rows() > 0)
        {
            g_player_sim_resource[playerid][count][PSR_SQL_ID] = cache_get_field_content_int(0, "id");
            printf("[SIM] обавлена SIM-карта %s с SQL ID %d дл игрока %d", 
                number, g_player_sim_resource[playerid][count][PSR_SQL_ID], playerid);
        }
        cache_delete(insert_result);
    }
    else
    {
        printf("[SIM ERROR] е удалос сохранит SIM-карту %s дл игрока %d", number, playerid);
    }
    
    return 1;
}

stock DeletePlayerSimSlot(playerid, slot)
{
    if(slot < 0 || slot >= g_player_sim_resource_count[playerid]) return 0;
    
    new sql_id = g_player_sim_resource[playerid][slot][PSR_SQL_ID];
    new number[16];
    format(number, sizeof(number), "%s", g_player_sim_resource[playerid][slot][PSR_NUMBER]);
    
    if(sql_id > 0)
    {
        new query[256];
        mysql_format(mysql, query, sizeof(query),
            "DELETE FROM player_sim_cards WHERE id=%d",
            sql_id);
        mysql_query(mysql, query, false);
        printf("[SIM] далена SIM-карта %s (SQL ID: %d) из ", number, sql_id);
    }
    else
    {
        new query[256];
        mysql_format(mysql, query, sizeof(query),
            "DELETE FROM player_sim_cards WHERE player_id=%d AND number='%s'",
            GetPlayerAccountID(playerid), number);
        mysql_query(mysql, query, false);
        printf("[SIM] далена SIM-карта %s по номеру из ", number);
    }
    
    for(new i = slot; i < g_player_sim_resource_count[playerid] - 1; i++)
    {
        g_player_sim_resource[playerid][i] = g_player_sim_resource[playerid][i + 1];
    }
    
    g_player_sim_resource_count[playerid]--;
    g_player_sim_resource[playerid][g_player_sim_resource_count[playerid]][PSR_NUMBER][0] = 0;
    g_player_sim_resource[playerid][g_player_sim_resource_count[playerid]][PSR_SQL_ID] = 0;
    
    printf("[SIM] далена SIM-карта %s из памти игрока %d", number, playerid);
    return 1;
}

stock ShowPlayerSimResources(playerid)
{
    LoadPlayerSimResources(playerid);
    if(!g_player_sim_resource_count[playerid])
        return ShowNotification(playerid, 2, " ас нет сохраненнх SIM-карт", 4, "", "");
    
    new fmt_text[2048], row[96];
    format(fmt_text, sizeof fmt_text, "№\tомер SIM-карт\n");
    for(new i; i < g_player_sim_resource_count[playerid]; i++)
    {
        format(row, sizeof row, "%d\t%s\n", i + 1, g_player_sim_resource[playerid][i][PSR_NUMBER]);
        strcat(fmt_text, row);
        SetPlayerListitemValue(playerid, i, i);
    }
    return Dialog(playerid, DIALOG_INV_SIMS, DIALOG_STYLE_TABLIST_HEADERS, "{FA8072}нвентар {FFFFFF}| ои SIM-карт", fmt_text, "брат", "акрт");
}

stock ApplyPlayerSimResource(playerid, slot)
{
    new number[16];
    format(number, sizeof number, "%s", g_player_sim_resource[playerid][slot][PSR_NUMBER]);
    
    new phone_number = strval(number);
    
    new Cache:result;
    new query[128];
    mysql_format(mysql, query, sizeof query, "SELECT id FROM accounts WHERE phone=%d AND id!=%d", phone_number, GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows() > 0)
    {
        cache_delete(result);
        SendClientMessage(playerid, 0x999999FF, ""USC"тот номер уже исползуетс другим игроком!");
        return 0;
    }
    cache_delete(result);
    
    SetPlayerData(playerid, P_PHONE, phone_number);
    UpdatePlayerDatabaseInt(playerid, "phone", phone_number);
    UpdateInventoryPhoneFromPlayerData(playerid);
    
    new fmt_text[128];
    format(fmt_text, sizeof(fmt_text), ""SC" установили в телефон SIM-карту: {FFFF00}%d", phone_number);
    SendClientMessage(playerid, 0x66CC33FF, fmt_text);
    
    ShowNotificationNew(playerid, 3, 5, -1, -1, fmt_text, "");
    
    ApplyAnimationEx(playerid, "COP_AMBIENT", "Coplook_watch", 4.0, false, 0, 0, 0, 0, 0);
    
    return 1;
}


CMD:banip(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6)
        return SendClientMessage(playerid, 0x999999FF, " вас недостаточно прав (нужен 6+ уровен)");

    if(GetPlayerAdminWarn(playerid) > 0)
        return SendClientMessage(playerid, 0x999999FF, " не можете исползоват эту команду, так как у вас ест вговор");

    new target_id, days, reason[128];
    
    if(sscanf(params, "u d s[128]", target_id, days, reason))
    {
        SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /banip [id игрока] [дни] [причина]");
        SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}ример:{FFFFFF} /banip 5 30 ит");
        return 1;
    }

    if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

    if(GetPlayerAdminEx(target_id) >= GetPlayerAdminEx(playerid))
        return SendClientMessage(playerid, 0x999999FF, "елз забанит IP администратора вше по рангу");

    if(target_id == playerid)
        return SendClientMessage(playerid, 0x999999FF, "елз забанит самого себ");

    if(days < 1 || days > 365)
        return SendClientMessage(playerid, 0x999999FF, "оличество дней должно бт от 1 до 365");

    new ip[16];
    GetPlayerIp(target_id, ip, sizeof ip);
    new admin_name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, admin_name, sizeof admin_name);
    new target_name[MAX_PLAYER_NAME];
    GetPlayerName(target_id, target_name, sizeof target_name);

    new query[512];
    new time = gettime();
    new unban_time = time + (days * 86400);

    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ban_list (user_id, time, ban_time, ip, description, admin, admin_name, player_name, unban_date) \
        VALUES (%d, %d, %d, '%s', '%s', '%s', '%s', '%s', %d)",
        GetPlayerAccountID(target_id),
        time,
        unban_time,
        ip,
        reason,
        admin_name,
        admin_name,
        target_name,
        unban_time
    );
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        SendClientMessage(playerid, 0xFF6600FF, "шибка при добавлении IP-бана в базу даннх");
        return 1;
    }

    new fmt_str[256];
    format(fmt_str, sizeof fmt_str, "[A] %s[%d] забанил IP %s игрока %s[%d] на %d дней. ричина: %s",
        admin_name, playerid, ip, target_name, target_id, days, reason);
    SendMessageToAdmins(fmt_str, 0x999999FF);
    SendClientMessageToAll(0xFF5533FF, fmt_str);

    format(fmt_str, sizeof fmt_str, "аш IP-адрес бл забанен администратором %s на %d дней. ричина: %s",
        admin_name, days, reason);
    SendClientMessage(target_id, 0xFF0000FF, fmt_str);
    ShowNotificationNew(target_id, 2, 5, -1, -1, "аш IP-адрес бл забанен", "");

    format(fmt_str, sizeof fmt_str, "абанил IP %s игрока %s[acc:%d] на %d дней. ричина: %s",
        ip, target_name, GetPlayerAccountID(target_id), days, reason);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_str);

    Kick(target_id);
    return 1;
}

CMD:unbanip(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6)
        return SendClientMessage(playerid, 0x999999FF, " вас недостаточно прав (нужен 6+ уровен)");

    new ip[16];
    if(sscanf(params, "s[16]", ip))
    {
        SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /unbanip [IP-адрес]");
        return 1;
    }

    new query[128];
    mysql_format(mysql, query, sizeof query,
        "SELECT id FROM ban_list WHERE ip='%s' AND ban_time > %d LIMIT 1",
        ip, gettime());
    
    new Cache:result = mysql_query(mysql, query, true);
    
    if(!cache_num_rows())
    {
        cache_delete(result);
        SendClientMessage(playerid, 0x999999FF, "аннй IP-адрес не забанен");
        return 1;
    }

    cache_delete(result);

    mysql_format(mysql, query, sizeof query, "DELETE FROM ban_list WHERE ip='%s'", ip);
    mysql_query(mysql, query, false);

    new fmt_str[128];
    format(fmt_str, sizeof fmt_str, "[A] %s[%d] разбанил IP-адрес %s", GetPlayerNameEx(playerid), playerid, ip);
    SendMessageToAdmins(fmt_str, 0x999999FF);

    format(fmt_str, sizeof fmt_str, " успешно разбанили IP-адрес %s", ip);
    SendClientMessage(playerid, 0x66CC33FF, fmt_str);

    format(fmt_str, sizeof fmt_str, "азбанил IP-адрес %s", ip);
    SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_str);

    return 1;
}

stock GetFreeHouseID()
{
    for(new idx = 0; idx < MAX_HOUSES; idx ++)
    {
        if(GetHouseData(idx, H_SQL_ID) <= 0)
            return idx;
    }
    return -1;
}


CMD:sex(playerid, params[])
{
    if(IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0x999999FF, " не можете исползоват это в транспорте");
    
    new to_player;
    if(sscanf(params, "u", to_player))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /sex [id игрока]");
    
    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");
    
    if(!IsPlayerInRangeOfPlayer(playerid, to_player, 3.0))
        return SendClientMessage(playerid, 0x999999FF, "грок слишком далеко");
    
    ApplyAnimationEx(playerid, "STRIP", "PUL_01", 4.0, 0, 1, 1, 1, 0, 1);
    SetPlayerChatBubble(playerid, "редлагает зантс сексом", 0xFF69B4FF, 15.0, 5000);
    
    return 1;
}


CMD:minet(playerid, params[])
{
    if(IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0x999999FF, " не можете исползоват это в транспорте");
    
    new to_player;
    if(sscanf(params, "u", to_player))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /minet [id игрока]");
    
    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");
    
    if(!IsPlayerInRangeOfPlayer(playerid, to_player, 2.0))
        return SendClientMessage(playerid, 0x999999FF, "грок слишком далеко");
    
    ApplyAnimationEx(playerid, "STRIP", "PUL_01", 4.0, 0, 1, 1, 1, 0, 1);
    ApplyAnimationEx(to_player, "STRIP", "STR_A2B", 4.0, 0, 1, 1, 1, 0, 1); 
    
    SendMessageInLocal(playerid, " by vladik", 0xFF69B4FF, 25.0);
    
    SetTimerEx("EndSex", 5000, false, "ii", playerid, to_player);
    
    return 1;
}

public EndSex(playerid, partnerid)
{
    // станавливаем анимации
    ClearAnimations(playerid);
    ClearAnimations(partnerid);
    
    SetPlayerColorEx(playerid, GetPlayerTeamColor(playerid));
    SetPlayerColorEx(partnerid, GetPlayerTeamColor(partnerid));
    
    SetPlayerChatBubble(playerid, "акончил(а)", 0xFF69B4FF, 10.0, 3000);
    SetPlayerChatBubble(partnerid, "акончил(а)", 0xFF69B4FF, 10.0, 3000);
    
    return 1;
}

stock bool:HasPlayerMoney(playerid, amount)
{
    if(amount <= 0) return true;
    if(GetPlayerMoneyEx(playerid) < amount) return false;
    return true;
}

stock bool:HasPlayerTotalMoney(playerid, amount)
{
    if(amount <= 0) return true;
    if((GetPlayerMoneyEx(playerid) + GetPlayerBankMoney(playerid)) < amount) return false;
    return true;
}

stock bool:TakePlayerMoney(playerid, amount, const description[] = "писание")
{
    if(amount <= 0) return true;
    if(GetPlayerMoneyEx(playerid) < amount)
    {
        new fmt_msg[128];
        format(fmt_msg, sizeof fmt_msg, ""USC"едостаточно денег! ужно: %d, у вас: %d", amount, GetPlayerMoneyEx(playerid));
        SendClientMessage(playerid, 0xFF6600FF, fmt_msg);
        return false;
    }
    
    GivePlayerMoneyEx(playerid, -amount, description, true, true);
    return true;
}


stock LogNegativeBalance(playerid)
{
    new fmt_str[128];
    format(fmt_str, sizeof fmt_str, "[NEGATIVE BALANCE] %s[%d] money=%d bank=%d ip=%s", 
        GetPlayerNameEx(playerid), playerid, 
        GetPlayerMoneyEx(playerid), GetPlayerBankMoney(playerid),
        GetPlayerIpEx(playerid));
    print(fmt_str);
    
    SendMessageToAdmins(fmt_str, 0xFF5533FF);
}

stock CheckNegativeBalance(playerid)
{
    new current_time = gettime();
    
    if(current_time - g_LastBalanceCheck[playerid] < 5)
        return 0;
    
    g_LastBalanceCheck[playerid] = current_time;

    new money = GetPlayerMoneyEx(playerid);
    if(money < 0)
    {
        new alert_msg[256];
        format(alert_msg, sizeof(alert_msg), 
            "{FF4500}[] {FF0000} ! {FFFFFF} игрока {FF9900}%s[%d] {FFFFFF} : {FF0000}%d руб. {FFFFFF}(ID: %d)",
            GetPlayerNameEx(playerid), playerid, money, playerid);
        SendMessageToAdmins(alert_msg, 0xFF4500FF);
        
        printf("[] %s[%d]  : %d руб.", GetPlayerNameEx(playerid), playerid, money);
        
        SetPlayerData(playerid, P_MONEY, 0);
        ResetPlayerMoney(playerid);
        GivePlayerMoney(playerid, 0);

        SendClientMessage(playerid, 0xFF0000FF, ""USC"аш баланс бл скорректирован системой античита!");

        UpdatePlayerDatabaseInt(playerid, "money", 0);
        
        return 1;
    }
    
    new bank = GetPlayerBankMoney(playerid);
    if(bank < 0)
    {
        new alert_msg[256];
        format(alert_msg, sizeof(alert_msg), 
            "{FF4500}[] {FF0000} ! {FFFFFF} игрока {FF9900}%s[%d] {FFFFFF}  : {FF0000}%d руб. {FFFFFF}(ID: %d)",
            GetPlayerNameEx(playerid), playerid, bank, playerid);
        SendMessageToAdmins(alert_msg, 0xFF4500FF);
        
        printf("[] %s[%d]  : %d руб.", GetPlayerNameEx(playerid), playerid, bank);
        
        SetPlayerData(playerid, P_BANK, 0);
        UpdatePlayerDatabaseInt(playerid, "bank", 0);
        
        SendClientMessage(playerid, 0xFF0000FF, ""USC"аш банковский баланс бл скорректирован системой античита (бл отрицателнм)!");
        
        return 1;
    }
    
    return 0;
}


stock bool:DeleteAccount(admin_id, account_id, target_id = INVALID_PLAYER_ID, target_name[], reason[])
{
    new query[512];
    new fmt_text[256];

    new admin_name[24];
    format(admin_name, sizeof(admin_name), "%s", GetPlayerNameEx(admin_id));
    
    mysql_format(mysql, query, sizeof query,
