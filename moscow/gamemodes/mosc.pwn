                GetPlayerFacingAngle(playerid, g_family[family][F_SPAWN_POSITION][3]);

                g_family[family][F_SPAWN_IV][0] = GetPlayerInterior(playerid);
                g_family[family][F_SPAWN_IV][1] = GetPlayerVirtualWorld(playerid);

