CMD:addbiz(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new type, price, rent_price; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /addbiz [тип] [стоимост] [цена аренд]");

	new fmt_text[512];
	new business_name[24];
	new Cache: result;
	new sql_id;

	if(!(1 <= type <= 10000))
		return SendClientMessage(playerid, 0x999999FF, "ип бизнесов: 1-24/7, 2-луб, 3-правление стат., 4-иэлторск., 5-дежда, 6-тел, 7-вторнок, 8-азино, 9-отовй салон 10 - юнинг салон 11-агазин оружи");

	if(price < 1) return SendClientMessage(playerid, 0x999999FF, "тоимост бизнеса не может бт менше 1");

	if(rent_price < 1) return SendClientMessage(playerid, 0x999999FF, "тоимост аренд не может бт менше 1");

	new idx = g_business_loaded;

	GetPlayerPos(playerid, g_business[idx][B_POS_X], g_business[idx][B_POS_Y], g_business[idx][B_POS_Z]);

	GetBusinessTypeName(type, business_name, sizeof business_name);
	format(g_business[idx][B_NAME], 24, "%s", business_name);

	SetBusinessData(idx, B_OWNER_ID, 		0);
	SetBusinessData(idx, B_IMPROVEMENTS,	0);
	SetBusinessData(idx, B_PRODS,			0);
	SetBusinessData(idx, B_PROD_PRICE,		0);
	SetBusinessData(idx, B_BALANCE,			0);
	SetBusinessData(idx, B_RENT_DATE,		0);
	SetBusinessData(idx, B_PRICE,			price);
	SetBusinessData(idx, B_RENT_PRICE,		rent_price);
	SetBusinessData(idx, B_TYPE,			type);
	SetBusinessData(idx, B_INTERIOR,		type - 1);
	SetBusinessData(idx, B_ENTER_PRICE,		0);
	SetBusinessData(idx, B_ENTER_MUSIC,		0);
	SetBusinessData(idx, B_LOCK_STATUS,		false);
	SetBusinessData(idx, B_EXIT_POS_X,		0.0);
	SetBusinessData(idx, B_EXIT_POS_Y,		0.0);
	SetBusinessData(idx, B_EXIT_POS_Z,		0.0);
	SetBusinessData(idx, B_EXIT_ANGLE,		0.0);
	SetBusinessData(idx, B_EVICTION,			0);

	mysql_format
	(
		mysql,
		fmt_text,
		sizeof fmt_text,
		"INSERT INTO business (owner_id, name, improvements, products, prod_price, balance, rent_time, price, rent_price, type, interior, enter_price, enter_music, `lock`, x, y, z, exit_x, exit_y, exit_z, exit_angle, eviction) VALUES (%d, '%e', %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %f, %f, %f, %f, %f, %f, %f, %d)",
		GetBusinessData(idx, B_OWNER_ID),
		g_business[idx][B_NAME],
		GetBusinessData(idx, B_IMPROVEMENTS),
		GetBusinessData(idx, B_PRODS),
		GetBusinessData(idx, B_PROD_PRICE),
		GetBusinessData(idx, B_BALANCE),
		GetBusinessData(idx, B_RENT_DATE),
		GetBusinessData(idx, B_PRICE),
		GetBusinessData(idx, B_RENT_PRICE),
		GetBusinessData(idx, B_TYPE),
		GetBusinessData(idx, B_INTERIOR),
		GetBusinessData(idx, B_ENTER_PRICE),
		GetBusinessData(idx, B_ENTER_MUSIC),
		GetBusinessData(idx, B_LOCK_STATUS),
		GetBusinessData(idx, B_POS_X),
		GetBusinessData(idx, B_POS_Y),
		GetBusinessData(idx, B_POS_Z),
		GetBusinessData(idx, B_EXIT_POS_X),
		GetBusinessData(idx, B_EXIT_POS_Y),
		GetBusinessData(idx, B_EXIT_POS_Z),
		GetBusinessData(idx, B_EXIT_ANGLE),
		GetBusinessData(idx, B_EVICTION)
	);

	result = mysql_query(mysql, fmt_text, true);
	sql_id = cache_insert_id();
	cache_delete(result);

	if(sql_id < 1)
	{
		SendClientMessage(playerid, 0x999999FF, "е удалос сохранит бизнес в базу даннх");
		return 1;
	}

	SetBusinessData(idx, B_SQL_ID, 	sql_id);
	g_business_loaded ++;

	CreatePickup(19132, 23, GetBusinessData(idx, B_POS_X), GetBusinessData(idx, B_POS_Y), GetBusinessData(idx, B_POS_Z), 0, PICKUP_ACTION_TYPE_BIZ_ENTER, idx);

	UpdateBusinessLabel(idx);

	new city[MAX_ZONES_NAME + 1], area[MAX_ZONES_NAME + 1];
	GetCityName(GetBusinessData(idx, B_POS_X), GetBusinessData(idx, B_POS_Y), city);
	GetAreaName(GetBusinessData(idx, B_POS_X), GetBusinessData(idx, B_POS_Y), area);
	format(fmt_text, sizeof fmt_text, "[A] %s[%d] создал бизнес №%d (%s / %s)", GetPlayerNameEx(playerid), playerid, idx, city, area);

	SendMessageToAdmins(fmt_text, 0x66CC33FF);

	SendClientMessage(playerid, 0x3399FFFF, "сползуйте {FFFF00}/bsetexitpos{3399FF}, чтоб завершит создание бизнеса");

	return 1;
}
CMD:bsetexitpos(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new biz_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /bsetexitpos [id бизнеса]");

	if(!(0 <= biz_id <= g_business_loaded - 1)) return SendClientMessage(playerid, 0x999999FF, "анного бизнеса не существует на сервере");

	GetPlayerPos(playerid, g_business[biz_id][B_EXIT_POS_X], g_business[biz_id][B_EXIT_POS_Y], g_business[biz_id][B_EXIT_POS_Z]);
	GetPlayerFacingAngle(playerid, g_business[biz_id][B_EXIT_ANGLE]);

	new fmt_text[144];

	format
	(
		fmt_text, sizeof fmt_text,
		"UPDATE business SET exit_x='%f', exit_y='%f', exit_z='%f', exit_angle='%f' WHERE id=%d",
		GetBusinessData(biz_id, B_EXIT_POS_X),
		GetBusinessData(biz_id, B_EXIT_POS_Y),
		GetBusinessData(biz_id, B_EXIT_POS_Z),
		GetBusinessData(biz_id, B_EXIT_ANGLE),
		GetBusinessData(biz_id, B_SQL_ID)
	);

	mysql_query(mysql, fmt_text, false);

	format(fmt_text, sizeof fmt_text, " успешно изменили координат входа у бизнеса №%d", biz_id);

	SendClientMessage(playerid, 0x66CC33FF, fmt_text);

	return 1;
}

CMD:bsetpos(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new biz_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /bsetpos [id бизнеса]");

	if(!(0 <= biz_id <= g_business_loaded - 1)) return SendClientMessage(playerid, 0x999999FF, "анного бизнеса не существует на сервере");

	GetPlayerPos(playerid, g_business[biz_id][B_POS_X], g_business[biz_id][B_POS_Y], g_business[biz_id][B_POS_Z]);

	new fmt_text[144];

	format
	(
		fmt_text, sizeof fmt_text,
		"UPDATE business SET x='%f', y='%f', z='%f' WHERE id=%d",
		GetBusinessData(biz_id, B_POS_X),
		GetBusinessData(biz_id, B_POS_Y),
		GetBusinessData(biz_id, B_POS_Z),
		GetBusinessData(biz_id, B_SQL_ID)
	);

	mysql_query(mysql, fmt_text, false);

	format(fmt_text, sizeof fmt_text, " успешно изменили координат входа у бизнеса №%d (%s)", biz_id, GetBusinessData(biz_id, B_NAME));
	SendClientMessage(playerid, 0x66CC33FF, fmt_text);

	SendClientMessage(playerid, -1, "е забудте исползоват /bsetexitpos id л изменени координат входа");
	UpdateBusinessLabel(biz_id);
	return 1;
}

CMD:addfuelst(playerid, params[])
{
    if(TEST_SERVER == 1) 
        return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
    if(GetPlayerAdminEx(playerid) < 6) 
        return 1;

    new price, rent_price, fuel_price;
    
    if(sscanf(params, "ddd", price, rent_price, fuel_price))
    {
        SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /addfuelst [цена ] [цена аренд в ден] [цена топлива за 1 л]");
        SendClientMessage(playerid, 0x999999FF, "ример: {FFFF00}/addfuelst 500000 5000 16");
        return 1;
    }

    if(price < 1) 
        return SendClientMessage(playerid, 0xCECECEFF, "тоимост  не может бт менше 1");
    if(rent_price < 1) 
        return SendClientMessage(playerid, 0xCECECEFF, "тоимост аренд не может бт менше 1");
    if(fuel_price < 1 || fuel_price > 100) 
        return SendClientMessage(playerid, 0xCECECEFF, "ена топлива должна бт от 1 до 100 рублей");

    // роверем лимит
    if(g_fuel_station_loaded >= MAX_FUEL_STATIONS)
        return SendClientMessage(playerid, 0xFF6600FF, "остигнут лимит  на сервере!");

    new idx = g_fuel_station_loaded;
    new query[512];
    new Cache: result;
    new Float: x, Float: y, Float: z;

    GetPlayerPos(playerid, x, y, z);

    // аполнем структуру (исползуем прмое присваивание)
    g_fuel_station[idx][FS_SQL_ID] = 0;
    format(g_fuel_station[idx][FS_NAME], 20, "");
    g_fuel_station[idx][FS_OWNER_ID] = 0;
    g_fuel_station[idx][FS_IMPROVEMENTS] = 0;
    g_fuel_station[idx][FS_FUELS] = 1000;
    g_fuel_station[idx][FS_FUEL_PRICE] = fuel_price;
    g_fuel_station[idx][FS_BUY_FUEL_PRICE] = 0;
    g_fuel_station[idx][FS_BALANCE] = 0;
    g_fuel_station[idx][FS_RENT_DATE] = 0;
    g_fuel_station[idx][FS_PRICE] = price;
    g_fuel_station[idx][FS_RENT_PRICE] = rent_price;
    g_fuel_station[idx][FS_LOCK_STATUS] = 0;
    g_fuel_station[idx][FS_POS_X] = x;
    g_fuel_station[idx][FS_POS_Y] = y;
    g_fuel_station[idx][FS_POS_Z] = z;
    format(g_fuel_station[idx][FS_OWNER_NAME], 21, "None");
    g_fuel_station[idx][FS_ORDER_ID] = -1;
    g_fuel_station[idx][FS_EVICTION] = 0;

    // охранем в 
    mysql_format
    (
        mysql,
        query, sizeof query,
        "INSERT INTO fuel_stations \
        (name, owner_id, improvements, fuels, fuel_price, buy_fuel_price, balance, rent_time, price, rent_price, `lock`, x, y, z, eviction) \
        VALUES \
        ('%e', %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %f, %f, %f, %d)",
        "",
        0,
        0,
        1000,
        fuel_price,
        0,
        0,
        0,
        price,
        rent_price,
        0,
        x,
        y,
        z,
        0
    );

    result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[addfuelst] SQL ERROR: %d", mysql_errno());
        printf("[addfuelst] QUERY: %s", query);
        cache_delete(result);
        return SendClientMessage(playerid, 0xFF6600FF, "шибка  при создании !");
    }

    new sql_id = cache_insert_id();
    cache_delete(result);

    if(sql_id <= 0)
    {
        SendClientMessage(playerid, 0xFF6600FF, "шибка:  не получила ID в базе даннх!");
        return 1;
    }

    g_fuel_station[idx][FS_SQL_ID] = sql_id;
    g_fuel_station_loaded++;

    // оздаем 3D текст
    new label_text[256];
    format(label_text, sizeof(label_text),
        " №%d\n\
        {FFFFFF}ена за 10 литров: {FFCD00}%d руб\n\n\
        {CC9900}аправка продаетс\n\
        сползуйте /buyfuelst\n\
        ена: %d руб",
        idx + 1,
        fuel_price * 10,
        price
    );

    g_fuel_station[idx][FS_LABEL] = CreateDynamic3DTextLabel(
        label_text,
        0x3399FFFF,
        x, y, z + 1.5,
        15.0
    );

    // оздаем зону
    g_fuel_station[idx][FS_AREA] = CreateDynamicSphere(x, y, z, 15.0);

    // оздаем пикап
    CreatePickup(1650, 23, x, y, z, 0, PICKUP_ACTION_TYPE_FUEL_STATION, idx);
    CreateDynamicMapIcon(x, y, z, 47, 0, 0, 0, -1, STREAMER_MAP_ICON_SD, MAPICON_LOCAL);

    // ог
    new city[MAX_ZONES_NAME + 1], area[MAX_ZONES_NAME + 1];
    GetCityName(x, y, city);
    GetAreaName(x, y, area);
    
    new fmt_text[256];
    format(fmt_text, sizeof(fmt_text), 
        "[A] %s[%d] создал  №%d (%s / %s) | ена: %d | ренда: %d | опливо: %d",
        GetPlayerNameEx(playerid), playerid, idx, city, area, price, rent_price, fuel_price);
    SendMessageToAdmins(fmt_text, 0x66CC33FF);

    format(fmt_text, sizeof(fmt_text), 
        ""SC" №%d успешно создана! SQL ID: %d", idx + 1, sql_id);
    SendClientMessage(playerid, 0x66CC33FF, fmt_text);
    SendClientMessage(playerid, 0x3399FFFF, "л изменени цен исползуйте /fuelst (если купите)");

    return 1;
}


CMD:deletefuelst(playerid, params[])
{
    if(TEST_SERVER == 1) 
        return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
    if(GetPlayerAdminEx(playerid) < 6) return 1;

    new stationid;
    if(sscanf(params, "d", stationid))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /deletefuelst [id ]");

    if(stationid < 0 || stationid >= g_fuel_station_loaded)
        return SendClientMessage(playerid, 0x999999FF, " с таким ID не существует!");

    // далем из 
    new query[128];
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM fuel_stations WHERE id=%d", 
        g_fuel_station[stationid][FS_SQL_ID]);
    mysql_query(mysql, query, false);

    // далем 3D текст
    if(IsValidDynamic3DTextLabel(g_fuel_station[stationid][FS_LABEL]))
    {
        DestroyDynamic3DTextLabel(g_fuel_station[stationid][FS_LABEL]);
    }

    // далем зону
    if(IsValidDynamicArea(g_fuel_station[stationid][FS_AREA]))
    {
        DestroyDynamicArea(g_fuel_station[stationid][FS_AREA]);
    }

    // двигаем массив
    for(new i = stationid; i < g_fuel_station_loaded - 1; i++)
    {
        g_fuel_station[i] = g_fuel_station[i + 1];
    }
    g_fuel_station_loaded--;

    new fmt_text[128];
    format(fmt_text, sizeof(fmt_text), 
        "[A] %s[%d] удалил  №%d", 
        GetPlayerNameEx(playerid), playerid, stationid);
    SendMessageToAdmins(fmt_text, 0xFF5533FF);

    SendClientMessage(playerid, 0x66CC33FF, " успешно удалена!");
    return 1;
}

CMD:addhouse(playerid, params[])
{
	if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new type, price, rent_price; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /addhouse [тип] [стоимост] [цена аренд]");

	new fmt_text[1024];

	if(!(0 <= type <= sizeof g_house_type - 1))
	{
		SendClientMessage(playerid, 0x999999FF, "ип домов:");

		for(new house_type_idx; house_type_idx < sizeof g_house_type; house_type_idx ++)
		{
			format(fmt_text, sizeof fmt_text, "%d. %s", house_type_idx, GetHouseTypeInfo(house_type_idx, HT_NAME));

			SendClientMessage(playerid, 0xCECECEFF, fmt_text);
		}

		return 1;
	}

	if(price < 1) return SendClientMessage(playerid, 0x999999FF, "тоимост дома не может бт менше 1");

	if(rent_price < 1) return SendClientMessage(playerid, 0x999999FF, "тоимост аренд не может бт менше 1");

	new Cache: result,
		idx = g_house_loaded,
		sql_id;

	if(!(0 <= idx <= MAX_HOUSES - 1))
		return SendClientMessage(playerid, 0xFF6600FF, "остигнут лимит домов на сервере");

	GetPlayerPos(playerid, g_house[idx][H_POS_X], g_house[idx][H_POS_Y], g_house[idx][H_POS_Z]);

	SetHouseData(idx, H_PRICE,          price);
	SetHouseData(idx, H_RENT_PRICE,     rent_price);
	SetHouseData(idx, H_TYPE,           type);
	SetHouseData(idx, H_OWNER_ID,       0);
	SetHouseData(idx, H_IMPROVEMENTS,   0);
	SetHouseData(idx, H_RENT_DATE,      0);
	SetHouseData(idx, H_LOCK_STATUS,    false);
	SetHouseData(idx, H_ENTRACE,        -1);
	SetHouseData(idx, H_EXIT_POS_X,     GetHouseData(idx, H_POS_X));
	SetHouseData(idx, H_EXIT_POS_Y,     GetHouseData(idx, H_POS_Y));
	SetHouseData(idx, H_EXIT_POS_Z,     GetHouseData(idx, H_POS_Z));
	SetHouseData(idx, H_EXIT_ANGLE,     0.0);
	SetHouseData(idx, H_CAR_POS_X,      GetHouseData(idx, H_POS_X));
	SetHouseData(idx, H_CAR_POS_Y,      GetHouseData(idx, H_POS_Y));
	SetHouseData(idx, H_CAR_POS_Z,      GetHouseData(idx, H_POS_Z));
	SetHouseData(idx, H_CAR_ANGLE,      0.0);
	SetHouseData(idx, H_STORE_X,        0.0);
	SetHouseData(idx, H_STORE_Y,        0.0);
	SetHouseData(idx, H_STORE_Z,        0.0);
	SetHouseData(idx, H_EVICTION,       0);
	SetHouseData(idx, H_STORE_METALL,   0);
	SetHouseData(idx, H_STORE_DRUGS,    0);
	SetHouseData(idx, H_STORE_WEAPON,   0);
	SetHouseData(idx, H_STORE_AMMO,     0);
	SetHouseData(idx, H_STORE_SKIN,     0);
	SetHouseData(idx, H_STORE_LABEL,    Text3D:-1);
	SetHouseData(idx, H_LABEL,          Text3D:-1);
	SetHouseData(idx, H_ENTER_PICKUP,   0);
	SetHouseData(idx, H_HEALTH_PICKUP,  0);
	SetHouseData(idx, H_MAP_ICON,       -1);
	SetHouseData(idx, H_FLAT_ID,        0);
	format(g_house[idx][H_NAME], 20, "%s", GetHouseTypeInfo(type, HT_NAME));
	format(g_house[idx][H_OWNER_NAME], 21, "None");

	mysql_format
	(
		mysql,
		fmt_text, sizeof fmt_text,
		"INSERT INTO houses \
		(type, name, owner_id, improvements, rent_time, price, rent_price, `lock`, entrance, x, y, z, exit_x, exit_y, exit_z, exit_angle, car_x, car_y, car_z, car_angle, store_x, store_y, store_z, eviction, store_metall, store_drugs, store_weapon, store_ammo, store_skin)\
		VALUES ('%d', '%e', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%d', '%d', '%d', '%d', '%d', '%d')",
		type,
		GetHouseData(idx, H_NAME),
		GetHouseData(idx, H_OWNER_ID),
		GetHouseData(idx, H_IMPROVEMENTS),
		GetHouseData(idx, H_RENT_DATE),
		GetHouseData(idx, H_PRICE),
		GetHouseData(idx, H_RENT_PRICE),
		GetHouseData(idx, H_LOCK_STATUS),
		GetHouseData(idx, H_ENTRACE),
		GetHouseData(idx, H_POS_X),
		GetHouseData(idx, H_POS_Y),
		GetHouseData(idx, H_POS_Z),
		GetHouseData(idx, H_EXIT_POS_X),
		GetHouseData(idx, H_EXIT_POS_Y),
		GetHouseData(idx, H_EXIT_POS_Z),
		GetHouseData(idx, H_EXIT_ANGLE),
		GetHouseData(idx, H_CAR_POS_X),
		GetHouseData(idx, H_CAR_POS_Y),
		GetHouseData(idx, H_CAR_POS_Z),
		GetHouseData(idx, H_CAR_ANGLE),
		GetHouseData(idx, H_STORE_X),
		GetHouseData(idx, H_STORE_Y),
		GetHouseData(idx, H_STORE_Z),
		GetHouseData(idx, H_EVICTION),
		GetHouseData(idx, H_STORE_METALL),
		GetHouseData(idx, H_STORE_DRUGS),
		GetHouseData(idx, H_STORE_WEAPON),
		GetHouseData(idx, H_STORE_AMMO),
		GetHouseData(idx, H_STORE_SKIN)
	);

	result = mysql_query(mysql, fmt_text, true);

	if(mysql_errno())
	{
		printf("[ADD_HOUSE] SQL ERROR: %d", mysql_errno());
		printf("[ADD_HOUSE] QUERY: %s", fmt_text);
		cache_delete(result);
		return SendClientMessage(playerid, 0xFF6600FF, "шибка  при создании дома");
	}

	sql_id = cache_insert_id();
	cache_delete(result);

	if(sql_id <= 0)
		return SendClientMessage(playerid, 0xFF6600FF, "шибка: дом не получил ID в базе даннх");

	SetHouseData(idx, H_SQL_ID, sql_id);
	g_house_loaded ++;

	UpdateHouse(idx);

	new city[MAX_ZONES_NAME + 1], area[MAX_ZONES_NAME + 1];
	GetCityName(GetHouseData(idx, H_POS_X), GetHouseData(idx, H_POS_Y), city);
	GetAreaName(GetHouseData(idx, H_POS_X), GetHouseData(idx, H_POS_Y), area);
	format(fmt_text, sizeof fmt_text, "[A] %s[%d] создал дом №%d (%s / %s)", GetPlayerNameEx(playerid), playerid, idx, city, area);

	SendMessageToAdmins(fmt_text, 0x66CC33FF);
    ShowNotificationNew(playerid, 3, 5, -1, -1, " успешно создали дом", "");
	SendClientMessage(playerid, 0x3399FFFF, "сползуйте {FFFF00}/setexitpos и /setcarpos{3399FF}, чтоб завершит создание дома");

	return 1;
}

CMD:setexitpos(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new house_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /setexitpos [id дома]");

	if(!(0 <= house_id <= g_house_loaded - 1)) return SendClientMessage(playerid, 0x999999FF, "анного дома не существует на сервере");

	GetPlayerPos(playerid, g_house[house_id][H_EXIT_POS_X], g_house[house_id][H_EXIT_POS_Y], g_house[house_id][H_EXIT_POS_Z]);
	GetPlayerFacingAngle(playerid, g_house[house_id][H_EXIT_ANGLE]);

	new fmt_text[144];

	format
	(
		fmt_text, sizeof fmt_text,
		"UPDATE houses SET exit_x='%f', exit_y='%f', exit_z='%f', exit_angle='%f' WHERE id=%d",
		GetHouseData(house_id, H_EXIT_POS_X),
		GetHouseData(house_id, H_EXIT_POS_Y),
		GetHouseData(house_id, H_EXIT_POS_Z),
		GetHouseData(house_id, H_EXIT_ANGLE),
		GetHouseData(house_id, H_SQL_ID)
	);

	mysql_query(mysql, fmt_text, false);

	format(fmt_text, sizeof fmt_text, " успешно изменили координат входа у дома №%d", house_id);

format(fmt_text, sizeof(fmt_text), " успешно изменили координат входа у дома №%d", house_id);
ShowNotificationNew(playerid, 3, 5, -1, -1, fmt_text, "");

	return 1;
}

CMD:setcarpos(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new house_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /setcarpos [id дома]");

	if(!(0 <= house_id <= g_house_loaded - 1)) return SendClientMessage(playerid, 0x999999FF, "анного дома не существует на сервере");

	GetPlayerPos(playerid, g_house[house_id][H_CAR_POS_X], g_house[house_id][H_CAR_POS_Y], g_house[house_id][H_CAR_POS_Z]);
	GetPlayerFacingAngle(playerid, g_house[house_id][H_CAR_ANGLE]);

	new fmt_text[144];

	format
	(
		fmt_text, sizeof fmt_text,
		"UPDATE houses SET car_x='%f', car_y='%f', car_z='%f', car_angle='%f' WHERE id=%d",
		GetHouseData(house_id, H_CAR_POS_X),
		GetHouseData(house_id, H_CAR_POS_Y),
		GetHouseData(house_id, H_CAR_POS_Z),
		GetHouseData(house_id, H_CAR_ANGLE),
		GetHouseData(house_id, H_SQL_ID)
	);

	mysql_query(mysql, fmt_text, false);

	format(fmt_text, sizeof fmt_text, " успешно изменили координат спавна авто у дома №%d", house_id);

	ShowNotificationNew(playerid, 3, 5, -1, -1, fmt_text, "");

	return 1;
}

CMD:getname(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	extract params -> new user_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /getname [номер аккаунта]");

	new name[21],
		fmt_text[120];

	format(name, sizeof name, "%s", GetPlayerNameBySqlID(user_id));

	if(strcmp(name, "none", true))
	{
		format(fmt_text, sizeof fmt_text, "м: %s / омер аккаунта: %d", name, user_id);

		SendClientMessage(playerid, 0x3399FFFF, fmt_text);
	}
	else SendClientMessage(playerid, 0x999999FF, "аннй аккаунт не найден в базе даннх");

	return 1;
}

CMD:slap(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 1) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /slap [id игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	new Float: x, Float: y, Float: z, fmt_text[85];
	GetPlayerPos(to_player, x, y, z);

	SetPlayerPos(to_player, x, y, z + 5);
	PlayerPlaySound(to_player, 1130, 0.0, 0.0, 0.0);

	format(fmt_text, sizeof fmt_text, " подбросили игрока %s", GetPlayerNameEx(to_player));
	SendClientMessage(playerid, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, "дминистратор %s подбросил ас", GetPlayerNameEx(playerid));
	SendClientMessage(to_player, -1, fmt_text);

	if(GetPlayerAdminEx(playerid) <= 5)
	{
		format(fmt_text, sizeof fmt_text, "[A] %s[%d] подбросил игрока %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
		SendMessageToAdmins(fmt_text, 0x999999FF);
	}

	format(fmt_text, sizeof fmt_text, "одбросил %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:hp(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 2) return 1;

	extract params -> new to_player, health; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /hp [id игрока] [количество здоров]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	else if(GetPlayerAdminEx(playerid) == 1 && to_player != playerid)
		return SendClientMessage(playerid, 0x999999FF, "дминистраторам 1-го уровн доступно изменение толко своего уровн здоров");

	else if(!(0 <= health <= 100)) return SendClientMessage(playerid, 0x999999FF, "ровен здоров от 0 до 100");

	SetPlayerData(to_player, P_HEALTH, health);
	SetPlayerHealthEx(to_player, health);

	if(GetPlayerData(to_player, P_HOSPITAL))
		SetPlayerData(to_player, P_HOSPITAL, false);

	new fmt_msg[105];
	format(fmt_msg, sizeof fmt_msg, "дминистратор %s изменил ам уровен здоров", GetPlayerNameEx(playerid));
	SendClientMessage(to_player, -1, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, " изменили %s уровен здоров", GetPlayerNameEx(to_player));
	SendClientMessage(playerid, -1, fmt_msg);

	if(GetPlayerAdminEx(playerid) <= 5)
	{
		format(fmt_msg, sizeof fmt_msg, "[A] дминистратор %s[%d] изменил уровен здоров %s[%d] на %d", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, health);
		SendMessageToAdmins(fmt_msg, 0x999999FF);
	}

	format(fmt_msg, sizeof fmt_msg, "становил %s[acc:%d] уровен здоров на %d", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), health);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:spcars(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 3) return 1;

    new vehicles_count;
    new fmt_text[128];

    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(!IsValidVehicle(i)) continue;
        
        // ропускаем занте авто
        if(IsVehicleOccupied(i)) continue;
        
        // ропускаем прицеп
        if(IsTrailerAttachedToAnyVehicle(i)) continue;
        
        // далем всё осталное
        DestroyVehicle(i);
        vehicles_count++;
    }

    format(fmt_text, sizeof(fmt_text), ""SC" удалили вес незантй транспорт. сего удалено: {FFFF00}%d {FFFFFF}шт.", vehicles_count);
    SendClientMessage(playerid, 0x3399FFFF, fmt_text);

    if(GetPlayerAdminEx(playerid) <= 5)
    {
        format(fmt_text, sizeof(fmt_text), "[A] дминистратор %s[%d] удалил вес незантй транспорт (%d шт)", 
            GetPlayerNameEx(playerid), playerid, vehicles_count);
        SendMessageToAdmins(fmt_text, 0x999999FF);
    }

    SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

    return 1;
}

CMD:setleader(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6)
        return ShowNotificationNew(playerid, 2, 3, 0, 0, " вас нет доступа к исползованию данной команде", " ");

    if(sscanf(params, "u", params[0]))
        return SendClientMessage(playerid, 0xFFFFFFFF, ""SC"{1E90FF}[одсказка]:{FFFFFF}  /setleader [ID игрока]");

    if(!IsPlayerConnected(params[0]))
        return ShowNotificationNew(playerid, 2, 4, 0, 0, "акого игрока нет", " ");

    new P_TARGET_PLAYER_ID;
    g_player[playerid][P_TARGET_PLAYER_ID] = params[0];

    new sile_title[128];
    format(sile_title, sizeof sile_title, "{FF6347}%s {FFFFFF}| дача постонного лидерства", SERVER_NAME);

    Dialog
    (
        playerid, 19469, DIALOG_STYLE_LIST,
        sile_title,
        "{F0E68C}| равителство {008000}дат\n\
        {4169E1}|  {008000}дат\n\
        {4169E1}| тдел полиции №1 () {008000}дат\n\
        {4169E1}| тдел полиции №2 () {008000}дат\n\
        {8B4513}| рми {008000}дат\n\
        {FA8072}| олница {008000}дат\n\
        {FF4500}|  {008000}дат\n\
        {32CD32}| рзамасска  {008000}дат\n\
        {7B68EE}| атревска  {008000}дат\n\
        {FF5252}| ткаринска  {008000}дат\n\
        {FF5252}| H {008000}дат\n\
        {FFFFFF}| нт с поста",
        "брат",
        "ход"
    );
    return 1;
}

CMD:givegun(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	extract params -> new to_player, weapon_id, weapon_ammo; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /givegun [id игрока] [id оружи] [кол-во патронов]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!(1 <= weapon_id <= 46) || (19 <= weapon_id <= 21)) return SendClientMessage(playerid, 0x999999FF, "ID оружи от 1 до 46");
	if(!(1 <= weapon_ammo <= 1000)) return SendClientMessage(playerid, 0x999999FF, "оличество патронов от 1 до 1000");

	GivePlayerWeapon(to_player, weapon_id, weapon_ammo);

	new fmt_text[128];

	format(fmt_text, sizeof fmt_text, "дминистратор %s[%d] вдал ам %s и %d патр.", GetPlayerNameEx(playerid), playerid, GetWeaponName(weapon_id), weapon_ammo);
	SendClientMessage(to_player, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, " вдали игроку %s[%d] %s и %d патр.", GetPlayerNameEx(to_player), to_player, GetWeaponName(weapon_id), weapon_ammo);
	SendClientMessage(playerid, -1, fmt_text);

	if(GetPlayerAdminEx(playerid) <= 5)
	{
		format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] вдал %s[%d] %s [%d патр]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, GetWeaponName(weapon_id), weapon_ammo);
		SendMessageToAdmins(fmt_text, 0x999999FF);
	}

	format(fmt_text, sizeof fmt_text, "дал %s[acc:%d] %s[%d патр]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), GetWeaponName(weapon_id), weapon_ammo);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:templeader(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	if(!strlen(params))
	{
		SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /templeader [организаци]");

		SendClientMessage(playerid, 0xCECECEFF, "1 - равителство области");
		SendClientMessage(playerid, 0xCECECEFF, "2 - оинска част");
		SendClientMessage(playerid, 0xCECECEFF, "3 - ородска болница");
		SendClientMessage(playerid, 0xCECECEFF, "4 - ");
		SendClientMessage(playerid, 0xCECECEFF, "5 - тдел полиции №1 ()");
		SendClientMessage(playerid, 0xCECECEFF, "6 - тдел полиции №2 ()");
		SendClientMessage(playerid, 0xCECECEFF, "7 - ");
		SendClientMessage(playerid, 0xCECECEFF, "8 - рзамасска ");
		SendClientMessage(playerid, 0xCECECEFF, "9 - атревска ");
		SendClientMessage(playerid, 0xCECECEFF, "10- ткаринска ");

		return 1;
	}
	extract params -> new org_id;

	if(!(0 <= org_id < MAX_ORG)) return SendClientMessage(playerid, 0x999999FF, "евернй идентификатор организации");

	new fmt_msg[155];

	if(!org_id)
	{
		SendClientMessage(playerid, 0xFFFF00FF, " снли с себ временное лидерство");
		format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] снл с себ временное лидерство организации \"%s\"", GetPlayerNameEx(playerid), playerid, GetPlayerTeamName(playerid));
		SendMessageToAdmins(fmt_msg, 0x999999FF);
		return InvitePlayer(playerid, 0, 0, true);
	}

	InvitePlayer(playerid, org_id, 10, false);

	if(IsTeamSubdivision(org_id))
		format(fmt_msg, sizeof fmt_msg, " взли временное лидерство подразделени \"%s\", организации \"%s\"", GetPlayerSubdivisionName(playerid), GetPlayerTeamName(playerid));
	else
		format(fmt_msg, sizeof fmt_msg, " взли временное лидерство организации \"%s\"", GetPlayerTeamName(playerid));
	SendClientMessage(playerid, 0xFFFF00FF, fmt_msg);

	if(IsTeamSubdivision(org_id))
		format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] взл временное лидерство подразделени \"%s\", организации \"%s\"", GetPlayerNameEx(playerid), playerid, GetPlayerSubdivisionName(playerid), GetPlayerTeamName(playerid));
	else
		format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] взл временное лидерство организации \"%s\"", GetPlayerNameEx(playerid), playerid, GetPlayerTeamName(playerid));
	SendMessageToAdmins(fmt_msg, 0x999999FF);

	if(org_id)
		format(fmt_msg, sizeof fmt_msg, "зл временное лидерство %s[%d]", GetTeamName(org_id), org_id);
	else
		format(fmt_msg, sizeof fmt_msg, "Cнл себ с временного лидерства");
	SendLog(playerid, LOG_TYPE_SET_LEADER, fmt_msg);

	return 1;
}

CMD:agivelic(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new to_player, license; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /agivelic [id игрока] [тип] (1-B 2-A+B+C+D 3-оружие 4-A 5-B 6-C 7-D)");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	new fmt_text[144];

	switch(license)
	{
		case 1:
		{
			new bool:has_category = DrivingSchoolPlayerHasCategory(to_player, DRIVING_SCHOOL_CATEGORY_B);
			DrivingSchoolSetCategory(to_player, DRIVING_SCHOOL_CATEGORY_B, !has_category);

			format(fmt_text, sizeof fmt_text, "дминистратор %s[%d] %s категорию B", GetPlayerNameEx(playerid), playerid, !has_category ? "вдал ам" : "забрал у ас");
			SendClientMessage(to_player, 0x3399FFFF, fmt_text);

			format(fmt_text, sizeof fmt_text, " %s %s[%d] категорию B", !has_category ? "вдали" : "забрали у", GetPlayerNameEx(to_player), to_player);
			SendClientMessage(playerid, 0x66CC00FF, fmt_text);

			format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] %s %s[%d] категорию B", GetPlayerNameEx(playerid), playerid, !has_category ? "вдал" : "забрал у", GetPlayerNameEx(to_player), to_player);
			SendMessageToAdmins(fmt_text, 0x999999FF);
		}
		case 2:
		{
			new bool:has_professional = DrivingSchoolPlayerHasProfessionalLicense(to_player);
			if(has_professional) DrivingSchoolSetLicenseValue(to_player, 0);
			else DrivingSchoolGiveProfessionalLicense(to_player);

			format(fmt_text, sizeof fmt_text, "дминистратор %s[%d] %s профессионалне водителские категории", GetPlayerNameEx(playerid), playerid, !has_professional ? "вдал ам" : "забрал у ас");
			SendClientMessage(to_player, 0x3399FFFF, fmt_text);

			format(fmt_text, sizeof fmt_text, " %s %s[%d] профессионалне водителские категории", !has_professional ? "вдали" : "забрали у", GetPlayerNameEx(to_player), to_player);
			SendClientMessage(playerid, 0x66CC00FF, fmt_text);

			format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] %s %s[%d] профессионалне водителские категории", GetPlayerNameEx(playerid), playerid, !has_professional ? "вдал" : "забрал у", GetPlayerNameEx(to_player), to_player);
			SendMessageToAdmins(fmt_text, 0x999999FF);
		}
		case 3:
		{
			SetPlayerData(to_player, P_WEAPON_LIC, GetPlayerData(to_player, P_WEAPON_LIC) ^ 1);
			UpdatePlayerDatabaseInt(to_player, "weapon_lic", GetPlayerData(to_player, P_WEAPON_LIC));

			format(fmt_text, sizeof fmt_text, "дминистратор %s[%d] %s лицензию на оружие", GetPlayerNameEx(playerid), playerid, GetPlayerData(to_player, P_WEAPON_LIC) ? "вдал ам" : "забрал у ас");
			SendClientMessage(to_player, 0x3399FFFF, fmt_text);

			format(fmt_text, sizeof fmt_text, " %s %s[%d] лицензию на оружие", GetPlayerData(to_player, P_WEAPON_LIC) ? "вдали" : "забрали у", GetPlayerNameEx(to_player), to_player);
			SendClientMessage(playerid, 0x66CC00FF, fmt_text);

			format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] %s %s[%d] лицензию на оружие", GetPlayerNameEx(playerid), playerid, GetPlayerData(to_player, P_WEAPON_LIC) ? "вдал" : "забрал у", GetPlayerNameEx(to_player), to_player);
			SendMessageToAdmins(fmt_text, 0x999999FF);
		}
		case 4..7:
		{
			new category = license - 4;
			new bool:has_category = DrivingSchoolPlayerHasCategory(to_player, category);
			new category_name[8];

			DrivingSchoolGetCategoryName(category, category_name, sizeof category_name);
			DrivingSchoolSetCategory(to_player, category, !has_category);

			format(fmt_text, sizeof fmt_text, "дминистратор %s[%d] %s категорию %s", GetPlayerNameEx(playerid), playerid, !has_category ? "вдал ам" : "забрал у ас", category_name);
			SendClientMessage(to_player, 0x3399FFFF, fmt_text);

			format(fmt_text, sizeof fmt_text, " %s %s[%d] категорию %s", !has_category ? "вдали" : "забрали у", GetPlayerNameEx(to_player), to_player, category_name);
			SendClientMessage(playerid, 0x66CC00FF, fmt_text);

			format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] %s %s[%d] категорию %s", GetPlayerNameEx(playerid), playerid, !has_category ? "вдал" : "забрал у", GetPlayerNameEx(to_player), to_player, category_name);
			SendMessageToAdmins(fmt_text, 0x999999FF);
		}
		default: return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /agivelic [id игрока] [тип] (1-B 2-A+B+C+D 3-оружие 4-A 5-B 6-C 7-D)");
	}

	format(fmt_text, sizeof fmt_text, "дал %s[acc:%d] лицензию %d", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), license);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:agivedscat(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	new to_player, category_text[16];
	if(sscanf(params, "us[16]", to_player, category_text))
	{
		SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /agivedscat [id игрока] [A/B/C/D]");
		return 1;
	}

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	{
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");
	}

	new category = DrivingSchoolFindCategoryByString(category_text);
	if(category < DRIVING_SCHOOL_CATEGORY_A || category > DRIVING_SCHOOL_CATEGORY_D)
	{
		return SendClientMessage(playerid, 0x999999FF, "оступн толко категории A, B, C, D");
	}

	new bool:has_category = DrivingSchoolPlayerHasCategory(to_player, category);
	new category_name[8], fmt_text[144];
	DrivingSchoolGetCategoryName(category, category_name, sizeof category_name);
	DrivingSchoolSetCategory(to_player, category, !has_category);

	format(fmt_text, sizeof fmt_text, "дминистратор %s[%d] %s категорию %s", GetPlayerNameEx(playerid), playerid, !has_category ? "вдал ам" : "забрал у ас", category_name);
	SendClientMessage(to_player, 0x3399FFFF, fmt_text);

	format(fmt_text, sizeof fmt_text, " %s %s[%d] категорию %s", !has_category ? "вдали" : "забрали у", GetPlayerNameEx(to_player), to_player, category_name);
	SendClientMessage(playerid, 0x66CC00FF, fmt_text);

	format(fmt_text, sizeof fmt_text, "[A] %s[%d] %s %s[%d] категорию %s", GetPlayerNameEx(playerid), playerid, !has_category ? "вдал" : "забрал у", GetPlayerNameEx(to_player), to_player, category_name);
	SendMessageToAdmins(fmt_text, 0x999999FF);

	return 1;
}

CMD:drivingschool(playerid, params[])
{
	#pragma unused params
	return DrivingSchool_ShowMenu(playerid);
}

CMD:setskills(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new to_player, set_code, set_value; else {

	    SendClientMessage(playerid, 0xCECECEFF, "сползование: /setskills [id игрока] [навк] [значение]");
	    SendClientMessage(playerid, 0xCECECEFF, "од навков:");
		SendClientMessage(playerid, 0xCECECEFF, "1 - Colt 45");
	    SendClientMessage(playerid, 0xCECECEFF, "2 - SD Pistol");
	    SendClientMessage(playerid, 0xCECECEFF, "3 - Desert Eagle");
	    SendClientMessage(playerid, 0xCECECEFF, "4 - Shotgun");
	    SendClientMessage(playerid, 0xCECECEFF, "5 - MP5");
	    SendClientMessage(playerid, 0xCECECEFF, "6 - AK47");
	    SendClientMessage(playerid, 0xCECECEFF, "7 - M4");
	    SendClientMessage(playerid, 0xCECECEFF, "8 - Sniper Rifle");
		SendClientMessage(playerid, 0xCECECEFF, "9 - Sawnoff");
		SendClientMessage(playerid, 0xCECECEFF, "10 - Combat SG");
		SendClientMessage(playerid, 0xCECECEFF, "11 - Micro Uzi");
	    SendClientMessage(playerid, 0x999999FF, "12 - ила");
	    return 1;
	}

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!(0 <= set_value <= 100)) return SendClientMessage(playerid, 0x999999FF, "начение навка от 0 до 100");

	new tmp_skill_name[32], query[128];

	switch(set_code)
	{
		case 1:
	    {
	        SetPlayerData(to_player, P_SKILL_COLT, set_value);
			tmp_skill_name = "Colt 45";
			UpdatePlayerDatabaseInt(to_player, "skill_colt", set_value);
	    }
	    case 2:
	    {
	        SetPlayerData(to_player, P_SKILL_SDPISTOL, set_value);
			tmp_skill_name = "SD Pistol";
			UpdatePlayerDatabaseInt(to_player, "skill_sdpistol", set_value);
	    }
	    case 3:
	    {
	        SetPlayerData(to_player, P_SKILL_DEAGLE, set_value);
			tmp_skill_name = "Desert Eagle";
			UpdatePlayerDatabaseInt(to_player, "skill_deagle", set_value);
	    }
	    case 4:
	    {
	        SetPlayerData(to_player, P_SKILL_SHOTGUN, set_value);
			tmp_skill_name = "Shotgun";
			UpdatePlayerDatabaseInt(to_player, "skill_shotgun", set_value);
	    }
	    case 5:
	    {
	        SetPlayerData(to_player, P_SKILL_MP5, set_value);
			tmp_skill_name = "MP5";
			UpdatePlayerDatabaseInt(to_player, "skill_mp5", set_value);
	    }
	    case 6:
	    {
	        SetPlayerData(to_player, P_SKILL_AK47, set_value);
			tmp_skill_name = "AK47";
			UpdatePlayerDatabaseInt(to_player, "skill_ak47", set_value);
	    }
	    case 7:
	    {
	        SetPlayerData(to_player, P_SKILL_M4, set_value);
			tmp_skill_name = "M4";
			UpdatePlayerDatabaseInt(to_player, "skill_m4", set_value);
	    }
	    case 8:
	    {
	        SetPlayerData(to_player, P_SKILL_SNIPER_RIFLE, set_value);
			tmp_skill_name = "Sniper Rifle";
			UpdatePlayerDatabaseInt(to_player, "skill_sniper_rifle", set_value);
	    }
		case 9:
	    {
	        SetPlayerData(to_player, P_SKILL_SAWNOFF, set_value);
			tmp_skill_name = "Sawnoff";
			UpdatePlayerDatabaseInt(to_player, "skill_sawnoff", set_value);
	    }
		case 10:
	    {
	        SetPlayerData(to_player, P_SKILL_COMBAT_SG, set_value);
			tmp_skill_name = "Combat SG";
			UpdatePlayerDatabaseInt(to_player, "skill_combat_sg", set_value);
	    }
		case 11:
	    {
	        SetPlayerData(to_player, P_SKILL_MICRO_UZI, set_value);
			tmp_skill_name = "Micro Uzi";
			UpdatePlayerDatabaseInt(to_player, "skill_micro_uzi", set_value);
	    }
	    case 12:
	    {
	        SetPlayerData(to_player, P_POWER, set_value);
			tmp_skill_name = "ила";
			UpdatePlayerDatabaseInt(to_player, "power", set_value);
	    }
	    default: return SendClientMessage(playerid, 0x999999FF, "еверно введен код навка");
	}

	SetPlayerSkillsInit(to_player);

	format(query, sizeof query, "дминистратор %s изменил ам уровен навка %s на %d", GetPlayerNameEx(playerid), tmp_skill_name, set_value);
	SendClientMessage(to_player, 0x3399FFFF, query);

	format(query, sizeof query, " изменили игроку %s уровен навка %s на %d", GetPlayerNameEx(to_player), tmp_skill_name, set_value);
	SendClientMessage(playerid, 0x66CC00FF, query);

	if(GetPlayerAdminEx(playerid) <= 5)
	{
		format(query, sizeof query, "[A] дминистратор %s[%d] изменил %s[%d] уровен навка %s на %d", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, tmp_skill_name, set_value);
		SendMessageToAdmins(query, 0x999999FF);
	}

	format(query, sizeof query, "зменил %s[acc:%d] уровен навка %s на %d", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), tmp_skill_name, set_value);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, query);

	return 1;
}

CMD:admdown(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /admdown [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!GetPlayerAdminEx(to_player))
		return SendClientMessage(playerid, 0x999999FF, "грок не администратор");

	if(GetPlayerAdminEx(to_player) == 1)
		return SendClientMessage(playerid, 0x999999FF, "елз понизит до 0 уровн. сползуйте /deladmin дл снти");

	if(GetPlayerAdminEx(to_player) >= GetPlayerAdminEx(playerid))
		return SendClientMessage(playerid, 0x999999FF, " не можете понизит уровен администратора вше ас");

	AddPlayerData(to_player, P_ADMIN, -, 1);
	UpdatePlayerDatabaseInt(to_player, "admin", GetPlayerAdminEx(to_player));

	new fmt_text[128];

	format(fmt_text, sizeof fmt_text, "лавнй администратор %s[%d] понизил аш уровен администратора до %d",
	GetPlayerNameEx(playerid), playerid, GetPlayerAdminEx(to_player));

	SendClientMessage(to_player, 0x3399FFFF, fmt_text);

	format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] понизил уровен администратора %s[%d] до %d",
	GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, GetPlayerAdminEx(to_player));

	SendMessageToAdmins(fmt_text, 0xFF5533FF);

	format(fmt_text, sizeof fmt_text, "онизил %s[acc:%d] до адм. уровн %d",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), GetPlayerAdminEx(to_player));

	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);

	return 1;
}

CMD:admup(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /admup [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!GetPlayerAdminEx(to_player))
		return SendClientMessage(playerid, 0x999999FF, "грок не администратор");

	if(GetPlayerAdminEx(to_player) >= MAX_ADMIN_LEVEL)
		return SendClientMessage(playerid, 0x999999FF, "елз повсит игрока вше 8 уровн");

	if(GetPlayerAdminEx(to_player) >= GetPlayerAdminEx(playerid))
		return SendClientMessage(playerid, 0x999999FF, " не можете повсит уровен у главного администратора");

	AddPlayerData(to_player, P_ADMIN, +, 1);
	UpdatePlayerDatabaseInt(to_player, "admin", GetPlayerAdminEx(to_player));

	new fmt_text[128];

	format(fmt_text, sizeof fmt_text, "дминистратор %s[%d] повсил аш уровен администратора до %d",
	GetPlayerNameEx(playerid), playerid, GetPlayerAdminEx(to_player));

	SendClientMessage(to_player, 0x3399FFFF, fmt_text);

	format(fmt_text, sizeof fmt_text, "[A] %s[%d] повсил уровен администратора %s[%d] до %d",
	GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, GetPlayerAdminEx(to_player));

	SendMessageToAdmins(fmt_text, 0xFF5533FF);

	format(fmt_text, sizeof fmt_text, "овсил %s[acc:%d] до адм. уровн %d",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), GetPlayerAdminEx(to_player));

	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);

	return 1;
}

CMD:deladmin(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /deladmin [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	if(!GetPlayerAdminEx(to_player))
		return SendClientMessage(playerid, 0x999999FF, "грок не администратор");

	if(GetPlayerAdminEx(to_player) >= GetPlayerAdminEx(playerid))
		return SendClientMessage(playerid, 0x999999FF, "елз снт главного администратора");

	SetPlayerData(to_player, P_ADMIN, 0);
	UpdatePlayerDatabaseInt(to_player, "admin", 0);

	new fmt_text[128];

	format(fmt_text, sizeof fmt_text, "лавнй администратор %s[%d] снл ас с поста администратора", GetPlayerNameEx(playerid), playerid);
	SendClientMessage(to_player, 0xFF5533FF, fmt_text);

	format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] снл %s[%d] с поста администратора",
	GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);

	SendMessageToAdmins(fmt_text, 0xFF5533FF);

	format(fmt_text, sizeof fmt_text, "нл %s[acc:%d] с поста администратора", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);

	return 1;
}

// олучит название префикса по его ID
stock GetAdminPrefixName(prefix_id, dest[], size = sizeof dest)
{
    if(prefix_id < 0 || prefix_id >= MAX_ADMIN_PREFIXES)
    {
        format(dest, size, "дминистратор"); // fallback
        return 0;
    }
    format(dest, size, "%s", g_AdminPrefixes[prefix_id][PREFIX_NAME]);
    return 1;
}

// олучит префикс игрока
stock GetPlayerAdminPrefixName(playerid, dest[], size = sizeof dest)
{
    new prefix_id = GetPlayerData(playerid, P_ADMIN_PREFIX_ID);
    if(prefix_id < 0 || prefix_id >= MAX_ADMIN_PREFIXES)
        prefix_id = 0; // fallback на первй префикс "ладелец роекта"
    format(dest, size, "%s", g_AdminPrefixes[prefix_id][PREFIX_NAME]);
    return 1;
}

CMD:setadmin(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 8)
        return SendClientMessage(playerid, 0xFFFFFFFF, "{FF0000}| {FFFFFF}оступно толко администраторам 8-го уровн.");

    new to_player;
    if(sscanf(params, "u", to_player))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} сползуйте: {FF5252}/setadmin {ffffff}[id игрока]");

    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

    g_player[playerid][P_TARGET_PLAYER_ID] = to_player;

    new sile_title[128];
    format(sile_title, sizeof(sile_title), "{FF5252}%s{ffffff} | остановление на администратора", SERVER_NAME);

    Dialog(
        playerid, DIALOG_SETADMINS, DIALOG_STYLE_LIST,
        sile_title,
        "{FF5252}1.{FFFFFF}ладший модератор\n"\
        "{FF5252}2.{FFFFFF}одератор\n"\
        "{FF5252}3.{FFFFFF}дминистратор\n"\
        "{FF5252}4.{FFFFFF}уратор администрации\n"\
        "{FF5252}5.{FFFFFF}аместител главного администратора\n"\
        "{FF5252}6.{FFFFFF} лавнй дминистратор\n"\
        "{FF5252}7.{FFFFFF}оманда роекта\n"\
        "{FF5252}8.{FFFFFF}ладелец",
        "брат", "акрт"
    );

    return 1;
}

CMD:sendcmd(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new to_player, string:c_command[20], string:c_params[128]; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /sendcmd [id игрока] [команда] [параметр]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	new fmt_text[144];

	if(strfind(c_command, "w        	") != -1
	|| strfind(c_command, "ban") != -1
	|| strfind(c_command, "offban") != -1
	|| strfind(c_command, "warn") != -1)
	{
		//format(fmt_text, sizeof fmt_text, "[A] %s[%d] попталс исползоват от имени %s[%d] кмд: /%s %s",
		//GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, c_command, c_params);

		SendMessageToAdmins(fmt_text, 0x999999FF, 5);

		return 1;
	}

	format(fmt_text, sizeof fmt_text, "cmd_%s", c_command);

	CallLocalFunction(fmt_text, "is", to_player, c_params);

	format(fmt_text, sizeof fmt_text, "тправил от имени %s[acc:%d] кмд: /%s %s", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), c_command, c_params);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);

	return 1;
}

CMD:fly(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	new fmt_text[55],
		bool: fly_status;

	if(StartFly(playerid))
		fly_status = true;

	else
		StopFly(playerid);

	format(fmt_text, sizeof fmt_text, " %s Fly-режим", fly_status ? "включили" : "включили");
	SendClientMessage(playerid, 0x66CC33FF, fmt_text);

	if(GetPlayerAdminEx(playerid) <= 5)
	{
		format(fmt_text, sizeof fmt_text, "[A] %s[%d] %s Fly-режим", GetPlayerNameEx(playerid), playerid, fly_status ? "включил" : "включил");
		SendMessageToAdmins(fmt_text, 0x999999FF);
	}

	format(fmt_text, sizeof fmt_text, "%s Fly-режим", fly_status ? "ключил" : "ключил");
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:givecash(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 5) return 1;

	extract params -> new to_player, cash; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /givecash [id игрока] [cумма]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(-25_000_000 <= cash <= 2_000_000_000)) return ShowNotificationNew(playerid, 2, 5, -1, -1, " ввели слишком болшую сумму", "");

	new reason[144];
	format(reason, sizeof reason, "дача денег от админа %s", GetPlayerNameEx(playerid));
	GivePlayerMoneyEx(to_player, cash, reason, true, true);

	format(reason, sizeof(reason), "дминистратор %s вдал ам %d рублей", GetPlayerNameEx(playerid), cash);
    ShowNotificationNew(to_player, 3, 5, -1, -1, reason, "");

	format(reason, sizeof reason, "дал %s[acc:%d] %d руб", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), cash);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, reason);

	return 1;
}

CMD:givedonate(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 5) return 1;

	extract params -> new to_player, donate; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /givedonate [id игрока] [cумма]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(-25_000 <= donate <= 1_000)) return SendClientMessage(playerid, 0xCECECEFF, "ожно вдават от 1 до 1000 доната за один раз");

	new reason[144];
	format(reason, sizeof reason, "дача доната от админа %s", GetPlayerNameEx(playerid));
	GivePlayerDonate(to_player, donate, reason, true);

	format(reason, sizeof reason, "дминистратор %s вдал ам %d доната", GetPlayerNameEx(playerid), donate);
	SendClientMessage(to_player, 0xFFFFFFFF, reason);

	format(reason, sizeof reason, "[A] %s[%d] вдал донат %s[%d] кол-во %d руб, в итоге у игрока %d руб",
	GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, donate, GetPlayerDonateMoney(to_player));
	SendMessageToAdmins(reason, 0xFFFF00FF);

	format(reason, sizeof reason, "дал %s[acc:%d] %d руб доната", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), donate);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, reason);

	return 1;
}

CMD:giverub(playerid, params[])
{
 if(GetPlayerAdminEx(playerid) < 6) return 1;

 new name[MAX_PLAYER_NAME+1], donate;
 if(sscanf(params, "s[24]d", name, donate)) 
  return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /giverub [ник игрока] [cумма]");

 if(!(-1_000 <= donate <= 1_000_000)) 
  return SendClientMessage(playerid, 0xCECECEFF, "ожно вдават от 1 до 1000 донат-рублей за один раз");

 new Cache:result, query[128], target_id, target_name[MAX_PLAYER_NAME+1];

 // роверем, ест ли игрок онлайн
 new to_player = GetPlayerID(name);
 if(to_player != INVALID_PLAYER_ID && IsPlayerLogged(to_player))
 {
  // даём онлайн игроку
  new reason[144];
  format(reason, sizeof reason, "дача доната от админа %s", GetPlayerNameEx(playerid));
  GivePlayerDonateRub(to_player, donate, reason, true, true);

  format(reason, sizeof(reason), "дминистратор %s вдал ам %d донат-рублей", GetPlayerNameEx(playerid), donate);
  ShowNotificationNew(to_player, 3, 5, -1, -1, reason, "");

  format(reason, sizeof reason, "[A] %s[%d] вдал донат-рубли %s[%d] в кол-во %d руб, в итоге у игрока %d руб",
  GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, donate, GetPlayerDonateRub(to_player));
  SendMessageToAdmins(reason, 0xFFFF00FF);

  format(reason, sizeof reason, "дал %s[acc:%d] %d рублей", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), donate);
  SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, reason);

  return 1;
 }

 // сли игрок не в сети - ищем в 
 mysql_format(mysql, query, sizeof query, "SELECT id, name FROM accounts WHERE name='%e' LIMIT 1", name);
 result = mysql_query(mysql, query, true);

 if(!cache_num_rows())
 {
  cache_delete(result);
  return SendClientMessage(playerid, 0xCECECEFF, "грок с таким ником не найден");
 }

 target_id = cache_get_field_content_int(0, "id");
 cache_get_field_content(0, "name", target_name, mysql, sizeof target_name);
 cache_delete(result);

 // даём оффлайн игроку через UPDATE
 mysql_format(mysql, query, sizeof query, "UPDATE accounts SET rub=rub+%d WHERE id=%d", donate, target_id);
 mysql_query(mysql, query, false);

 if(mysql_errno())
 {
  SendClientMessage(playerid, 0xFF6600FF, "шибка при вдаче донат-рублей оффлайн игроку");
  return 1;
 }

 new reason[144];
 format(reason, sizeof reason, "[A] %s[%d] вдал донат-рубли %s[acc:%d] в кол-во %d руб (оффлайн)",
 GetPlayerNameEx(playerid), playerid, target_name, target_id, donate);
 SendMessageToAdmins(reason, 0xFFFF00FF);

 format(reason, sizeof reason, "дал оффлайн %s[acc:%d] %d донат-рублей", target_name, target_id, donate);
 SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, reason);

 SendClientMessage(playerid, -1, "онат-рубли успешно вдан оффлайн игроку");
 return 1;
}

CMD:setx2(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new to_player, value, tovalue; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /setx2 [id игрока] [value] [tovalue]");

	if(!IsPlayerConnected(to_player)) return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");
	if(!(0 <= value <= 255)) return SendClientMessage(playerid, 0x999999FF, "value от 0 до 255");
	if(!(0 <= tovalue <= 255)) return SendClientMessage(playerid, 0x999999FF, "tovalue от 0 до 255");

	SetPlayerX2(to_player, value, tovalue);

	new fmt_text[96];
	format(fmt_text, sizeof fmt_text, " установили X2 %d/%d игроку %s", value, tovalue, GetPlayerNameEx(to_player));
	SendClientMessage(playerid, 0x3399FFFF, fmt_text);

	format(fmt_text, sizeof fmt_text, "дминистратор %s установил ам X2 %d/%d", GetPlayerNameEx(playerid), value, tovalue);
	SendClientMessage(to_player, 0x3399FFFF, fmt_text);

	return 1;
}

