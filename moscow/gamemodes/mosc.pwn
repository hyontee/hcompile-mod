CMD:setstats(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 5) return 1;

	extract params -> new to_player, set_code, set_value; else {

		SendClientMessage(playerid, 0xCECECEFF, "сползование: /setstats [id игрока] [код] [значение]");
		SendClientMessage(playerid, 0xCECECEFF, "од: 1 - ровен | 2 - абота");

		return 1;
	}

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

	new fmt_msg[128];

	switch(set_code)
	{
		case 1:
		{
			if(!(1 <= set_value <= 25)) return SendClientMessage(playerid, 0xFF6600FF, "ровен от 1 до 25");

			SetPlayerData(to_player, P_LEVEL, set_value);

			SetPlayerScore(to_player, set_value);

			format(fmt_msg, sizeof fmt_msg, "дминистратор %s изменил ам уровен на %d", GetPlayerNameEx(playerid), set_value);
			SendClientMessage(to_player, 0x3399FFFF, fmt_msg);

			format(fmt_msg, sizeof fmt_msg, " изменили игроку %s уровен на %d", GetPlayerNameEx(to_player), set_value);
			SendClientMessage(playerid, 0x66CC00FF, fmt_msg);
		}
		case 2:
		{
			//if(!(0 <= set_value <= 6)) return SendClientMessage(playerid, 0xFF6600FF, "д работ от 0 до 6");
			SetPlayerData(to_player, P_JOB, set_value);

			format(fmt_msg, sizeof fmt_msg, "дминистратор %s установил ам работу %s", GetPlayerNameEx(playerid), GetPlayerJobAndRankName(to_player));
			SendClientMessage(to_player, 0x3399FFFF, fmt_msg);

			format(fmt_msg, sizeof fmt_msg, " установили игроку %s работу %s", GetPlayerNameEx(to_player), GetPlayerJobAndRankName(to_player));
			SendClientMessage(playerid, 0x66CC00FF, fmt_msg);
		}
		default: return SendClientMessage(playerid, 0xFF6600FF, "шибка: еверно введен код");
	}

	mysql_format(mysql, fmt_msg, sizeof fmt_msg, "UPDATE accounts SET level=%d,job=%d WHERE id=%d", GetPlayerLevel(to_player), GetPlayerJob(to_player), GetPlayerAccountID(to_player));
	mysql_query(mysql, fmt_msg, false);

	return 1;
    if(GetPlayerData(playerid, P_TOTALHOUR) < 3)
        return SendClientMessage(playerid, 0x999999FF, "ужно отграт 3 часа, чтоб передават денги");

}
CMD:pay(playerid, params[])
{
    new to_player, cash;
    
    if(sscanf(params, "dd", to_player, cash))
        return SendClientMessage(playerid, 0xCECECEFF, ""SC"{1E90FF}[одсказка]:{FFFFFF} /pay [id игрока] [сумма]");

    if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");

    if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0))
        return SendClientMessage(playerid, 0x999999FF, ""USC"грок находитс далеко от ас");

    if(to_player == playerid)
        return SendClientMessage(playerid, 0x999999FF, " не можете перевести денги сами себе!");

    new max_money = 50000;
    if(!(1 <= cash <= max_money))
    {
        new fmt_text[75];
        format(fmt_text, sizeof fmt_text, ""USC"умма должна бт от 1 до %d рублей", max_money);
        return SendClientMessage(playerid, 0xCECECEFF, fmt_text);
    }

    // =====   =====
    if(GetPlayerMoneyEx(playerid) < cash)
    {
        new fmt_text[75];
        format(fmt_text, sizeof fmt_text, ""USC"едостаточно денег! ужно: %d, у вас: %d", cash, GetPlayerMoneyEx(playerid));
        return SendClientMessage(playerid, 0xFF6600FF, fmt_text);
    }

    // =====   Я =====
    if(GetPlayerMoneyEx(to_player) + cash > 2_000_000_000)
    {
        return SendClientMessage(playerid, 0xFF6600FF, ""USC" игрока превшен лимит денег (2 млрд)!");
    }

    // ===== - =====
    static lastPayTime[MAX_PLAYERS];
    if(gettime() - lastPayTime[playerid] < 1)
    {
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"одождите 1 секунду перед следующим переводом!");
    }
    lastPayTime[playerid] = gettime();

    // =====   =====
    new fmt_text[75];
    
    // писваем
    format(fmt_text, sizeof fmt_text, "ередача денег игроку %s", GetPlayerNameEx(to_player));
    GivePlayerMoneyEx(playerid, -cash, fmt_text, true, true);
    
    // ачислем
    format(fmt_text, sizeof fmt_text, "ередача денег от %s", GetPlayerNameEx(playerid));
    GivePlayerMoneyEx(to_player, cash, fmt_text, true, true);

    // ===== - =====
    format(fmt_text, sizeof fmt_text, "+%d", cash);
    SetPlayerChatBubble(to_player, fmt_text, 0x00CC00FF, 10.0, 5000);

    format(fmt_text, sizeof fmt_text, "-%d", cash);
    SetPlayerChatBubble(playerid, fmt_text, 0xFF6600FF, 10.0, 5000);

    // ===== Я =====
    format(fmt_text, sizeof fmt_text, "%s передал ам денги %d руб", GetPlayerNameEx(playerid), cash);
    SendClientMessage(to_player, 0x3399FFFF, fmt_text);

    format(fmt_text, sizeof fmt_text, " передали игроку %s денги %d руб", GetPlayerNameEx(to_player), cash);
    SendClientMessage(playerid, 0x3399FFFF, fmt_text);

    // ===== Я =====
    Action(playerid, "достал кошелёк и передал денги", _, false);

    return 1;
}

CMD:agm(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 1) return 1;
    if(GetPVarInt(playerid,"agm") == 0)
    {
        SetPVarInt(playerid,"agm", 1);
        SetPlayerHealth(playerid, 0x7F800000);
        SendClientMessage(playerid, -1, "AGM ON");
    }
    else
    {
        SetPVarInt(playerid,"agm", 0);
        SetPlayerHealth(playerid, 100.0);
        SendClientMessage(playerid, -1, "AGM OFF");
    }
    return 1;
}

CMD:az(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 1) return 1;
	SetPlayerPos(playerid,-788.0145,-456.9666,741.1032);
	SetPlayerVirtualWorld(playerid,0);
	if(!sscanf(params,"u",params[0]))
	{
		SetPlayerPos(params[0],-788.0145,-456.9666,741.1032);
		SetPlayerInterior(params[0],0);
		SetPlayerVirtualWorld(params[0],0);
		SendClientMessage(params[0],-1, !"дминистратор телепортировал вас на собеседование.");
	}
	return true;
}

CMD:offdeladmin(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /offdeladmin [ник игрока]");

	extract params -> new string: player_name[21];

	if(IsPlayerConnected(GetPlayerID(player_name))) return SendClientMessage(playerid, 0x999999FF, "грок с таким именем находитс на сервере");

	new query[144],
		Cache: result,
		rows,
		uid,
		//admin,
		uip[16];

	mysql_format(mysql, query, sizeof query, "SELECT id, admin, last_ip FROM accounts WHERE name='%s'", player_name);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	if(rows)
	{
		uid = cache_get_row_int(0, 0);
	//	admin = cache_get_row_int(0, 1);
		cache_get_row(0, 2, uip);
	}

	cache_delete(result);

	if(!rows || !uid) return SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден");


	cache_delete(result);


	format(query, sizeof query, "дминистратор %s снл %s с поста администратора[флайн]", GetPlayerNameEx(playerid), player_name);

	SendMessageToAdmins(query, 0xFF5533FF);

	new id = GetPlayerID(player_name);
	if (id != INVALID_PLAYER_ID) {
		SetPlayerData(id, P_ADMIN, 0);
		UpdatePlayerDatabaseInt(id, "admin", 0);
	}
	mysql_format(mysql, query, sizeof query, "UPDATE `accounts` SER `admin`=0 WHERE `id`=%i LIMIT 1", uid);
	mysql_query(mysql, query, false);
	return 1;
}

