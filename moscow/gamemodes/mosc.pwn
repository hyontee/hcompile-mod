CMD:fh(playerid, params[])
{
    if(!strlen(params))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /fh [номер дома]");
    
    new house_id = strval(params);
    
    if(!(0 <= house_id <= g_house_loaded - 1))
        return SendClientMessage(playerid, 0x999999FF, ""USC"ома с таким номером не существует на сервере");
    
    if(GetPlayerGPSInfo(playerid, G_ENABLED) == GPS_STATUS_ON)
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"а вашем GPS уже отмечено место");
    
    SetPVarInt(playerid, "find_house_id", house_id);
    
    new dialog_text[256];
    format(dialog_text, sizeof(dialog_text),
        "{FFFFFF} действително хотите отметит дом {FFFF00}№%d {FFFFFF}на карте?\n\n"\
        "тоимост: {FFFF00}300р.",
        house_id
    );
    
    Dialog
    (
        playerid, 
        DIALOG_FIND_HOUSE, 
        DIALOG_STYLE_MSGBOX,
        "{FA8072}SANTA MOBILE RP {FFFFFF}| етка",
        dialog_text,
        "тметит",
        "акрт"
    );
    
    return 1;
}

CMD:smoke(playerid, params[])
{
    new cur_time = gettime();

    // роверка  (2 минут = 120 секунд)
    if(GetPVarInt(playerid, "smoke_time") > cur_time)
    {
        new remaining = GetPVarInt(playerid, "smoke_time") - cur_time;
        ShowNotificationNew(playerid, 2, 5, -1, -1, " недавно закурили сигарету!", "");
        return 1;
    }

    // роверка на транспорт
    if(IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, ""USC" не можете закурит сигарету в транспорте!");

    // роверка на анимацию (чтоб не спамит)
    if(GetPlayerData(playerid, P_USE_ANIM))
    {
        ShowNotificationNew(playerid, 2, 5, -1, -1, " не можете закурит сейчас!", "");
        return 1;
    }

    // енераци исцелени (40-70 HP)
    new heal = random(31) + 40; // 40..70

    // становка 
    SetPVarInt(playerid, "smoke_time", cur_time + 120);

    // становка анимации "аздуме" (курение)
    ApplyAnimationEx(playerid, "GANGS", "smkcig_prtl", 4.0, false, 0, 0, 0, 0, 0, USE_ANIM_TYPE_NONE);

    // ействие через /me
    Action(playerid, "закурил(а) сигарету", 25.0, true);

    // осстановление HP
    new Float:hp;
    GetPlayerHealth(playerid, hp);
    hp += heal;
    if(hp > 100.0) hp = 100.0;
    SetPlayerHealthEx(playerid, hp);

    // чистка анимации через 4 секунд
    SetTimerEx("ClearSmokeAnim", 4000, false, "i", playerid);

    return 1;
}

forward ClearSmokeAnim(playerid);
public ClearSmokeAnim(playerid)
{
    if(IsPlayerConnected(playerid) && IsPlayerLogged(playerid))
    {
        ClearAnimations(playerid);
        SetPlayerData(playerid, P_USE_ANIM, false);
        SetPlayerData(playerid, P_USE_ANIM_TYPE, USE_ANIM_TYPE_NONE);
    }
    return 1;
}

stock strcpy(dest[], const source[], len = sizeof(dest))
{
    dest[0] = 0;
    strcat(dest, source, len);
}


stock utf8_to_cp1251(string[]) {
    new len = strlen(string);
    for (new i = 0; i < len; i++) {
        if (string[i] == 0xD0 && i + 1 < len) {
            if (string[i + 1] >= 0x90 && string[i + 1] <= 0xBF) {
                string[i] = string[i + 1] + 0x30;
                strdel(string, i + 1, i + 2);
                len--;
            }
        }
        else if (string[i] == 0xD1 && i + 1 < len) {
            if (string[i + 1] >= 0x80 && string[i + 1] <= 0x8F) {
                string[i] = string[i + 1] + 0x70;
                strdel(string, i + 1, i + 2);
                len--;
            }
        }
    }
    return 1;
}


