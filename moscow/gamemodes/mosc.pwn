CMD:unnwarn(playerid)
{
    					if(GetPlayerData(playerid, P_WARN))
						{
							if(GetPlayerDonateRub(playerid) >= 100)
							{
								SetPlayerData(playerid, P_WARN, 		0);
								SetPlayerData(playerid, P_WARN_TIME, 	0);

								UpdatePlayerDatabaseInt(playerid, "warn", 		0);
								UpdatePlayerDatabaseInt(playerid, "warn_time", 	0);

								GivePlayerDonateRub(playerid, -100, "нтие предупреждений");

								ShowNotification(playerid, 3, "се предупреждени успешно снт", 4, "", "");
								ShowNotification(playerid, 3, "епер  можете устроитс в организацию!", 4, "", "");
								UpdateDonate(playerid, GetPlayerMoney(playerid), GetPlayerDonateRub(playerid));
								show_sc(playerid, -1, -1);
							}
							else
							{
								new fmt_text[80];
							 	ShowNotification(playerid, 2, "л снти всех предупреждений необходимо имет на счету 100 руб!", 4, "", "");
							}
						}
						else ShowNotification(playerid, 2, "а ашем аккаунте нет предупреждений!", 4, "", "");
						
						return 1;

}
CMD:alllic(playerid)
{
						if(DrivingSchoolPlayerHasProfessionalLicense(playerid) && GetPlayerData(playerid, P_WEAPON_LIC) == 1)
                          ShowNotification(playerid, 2, " ас уже ест все лицензии!", 4, "", "");

						else
						{
							if(GetPlayerDonateRub(playerid) >= 150)
							{
								DrivingSchoolGiveProfessionalLicense(playerid, false);
								SetPlayerData(playerid, P_WEAPON_LIC,	1);

								UpdatePlayerDatabaseInt(playerid, "driving_lic", GetPlayerData(playerid, P_DRIVING_LIC));
								UpdatePlayerDatabaseInt(playerid, "weapon_lic", 1);

								GivePlayerDonate(playerid, -150, "окупка пакета лицензий", true);

								ShowNotification(playerid, 3, " приобрели пакет лицензий. {1E90FF}[одсказка]:{FFFFFF} {FFFF00}/lic!", 4, "", "");
								UpdateDonate(playerid, GetPlayerMoney(playerid), GetPlayerDonateRub(playerid));
								show_sc(playerid, -1, -1);
							}
							else
							{
								return ShowNotification(playerid, 2, "л покупки всех лицензий необходимо имет на счету 150 руб!", 4, "", "");
							}
						}
						return 1;
}
