		{888888}| {FFFFFF} писок лидеров\n\
		{888888}| {FFFFFF} ехнический рестарт\t\t\t{FF5252}[1 мин]\n\
		{888888}| {FFFFFF} Whitelist\n\
		{888888}| {FFFFFF} ополнит бизнес товаром\t\t{FF5252}[]\n\
		{888888}| {FFFFFF} улим склад завода(timer)\t\t{FF5252}[райний случай]\n\
		{888888}| {FFFFFF}улим аправки\t\t\t{FF5252}[опливом]",
		"бор", "тмена"
	);

	return 1;
}


CMD:epoints(playerid)
{
	if(GetPlayerAdminEx(playerid) < 1) return 0;

	new fmt_str[300];

	format(str, sizeof str, "{FF5252}"SERVER_NAME"{ffffff} | аллов: {FF5252}%d", GetPlayerData(playerid, P_ACOINS));

	Dialog
		(
			playerid, DIALOG_ADMSHOP, DIALOG_STYLE_LIST,
			str,
