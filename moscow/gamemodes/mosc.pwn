stock report_UpdateCounter()
{
	mysql_tquery(mysql, "SELECT COUNT(*) AS total FROM "TABLE_REPORTS" WHERE status="#REPORT_STATUS_NONE" AND (admin=0 OR admin IS NULL)", "report_UpdateCounterCallback", "");
	return true;
}

public: report_UpdateCounterCallback()
{
	new queue_count = 0;
	if (cache_num_rows()) queue_count = cache_get_field_content_int(0, "total");
	format(stringer1, sizeof (stringer1), "REP: %d", queue_count);
	TextDrawSetString(report_edit_TD, stringer1);
    foreach(new i : Player)
    {
        if(!IsPlayerLogged(i)) continue;
        if(GetPlayerAdminEx(i) || GetPlayerHelperEx(i))
            TextDrawShowForPlayer(i, report_edit_TD);
    }
	return true;
}

stock report_Send(playerid, const text[])
{
	mysql_query_[0] = EOS;

    new report_id = 0, rows = 0, Cache:insert_result;

	// ариант 1: нова структура (status/admin/answer)
	mysql_format(mysql, mysql_query_, sizeof (mysql_query_), "INSERT INTO "TABLE_REPORTS" \
		(player_name, player_id, text, date, status, admin, answer) VALUES ('%e', %d, '%e', NOW(), %d, 0, '')", GetPlayerData(playerid,P_NAME), playerid, text, REPORT_STATUS_NONE
	);
	insert_result = mysql_query(mysql, mysql_query_);

	if(mysql_errno() != 0)
	{
		cache_delete(insert_result);

		// ариант 2: без пол answer
		mysql_format(mysql, mysql_query_, sizeof (mysql_query_), "INSERT INTO "TABLE_REPORTS" \
			(player_name, player_id, text, date, status, admin) VALUES ('%e', %d, '%e', NOW(), %d, 0)", GetPlayerData(playerid,P_NAME), playerid, text, REPORT_STATUS_NONE
		);
		insert_result = mysql_query(mysql, mysql_query_);

		if(mysql_errno() != 0)
		{
			cache_delete(insert_result);

			// ариант 3: минимална структура с NOW()
			mysql_format(mysql, mysql_query_, sizeof (mysql_query_), "INSERT INTO "TABLE_REPORTS" \
				(player_name, player_id, text, date) VALUES ('%e', %d, '%e', NOW())", GetPlayerData(playerid,P_NAME), playerid, text
			);
			insert_result = mysql_query(mysql, mysql_query_);

			if(mysql_errno() != 0)
			{
				cache_delete(insert_result);

				// ариант 4: минимална структура с CURDATE()
				mysql_format(mysql, mysql_query_, sizeof (mysql_query_), "INSERT INTO "TABLE_REPORTS" \
					(player_name, player_id, text, date) VALUES ('%e', %d, '%e', CURDATE())", GetPlayerData(playerid,P_NAME), playerid, text
				);
				insert_result = mysql_query(mysql, mysql_query_);

				if(mysql_errno() != 0)
				{
					printf("[REPORT] insert error (%d) from %s[%d]", mysql_errno(), GetPlayerData(playerid, P_NAME), playerid);
					print(mysql_query_);
					cache_delete(insert_result);
					SendClientMessage(playerid, COLOR_WHITE, !"{afafaf}шибка отправки запроса. опробуйте ещё раз через пару секунд.");
					return false;
				}
			}
		}
	}

	report_id = cache_insert_id();
	cache_delete(insert_result);

	if(report_id <= 0)
	{
		new Cache:last_id_result = mysql_query(mysql, "SELECT MAX(id) AS id FROM "TABLE_REPORTS"");
		if(cache_num_rows()) report_id = cache_get_field_content_int(0, "id");
		cache_delete(last_id_result);
	}

	new Cache:result = mysql_query(mysql, "SELECT COUNT(*) AS total FROM "TABLE_REPORTS" WHERE status="#REPORT_STATUS_NONE" AND (admin=0 OR admin IS NULL)");
	if(cache_num_rows()) rows = cache_get_field_content_int(0, "total");

	format(stringer1, sizeof (stringer1), "{afafaf}аш запрос №%d успешно отправлен администрации.  на %d месте в очереди!",
		report_id, rows
	);
	SendClientMessage(playerid, COLOR_WHITE, stringer1), stringer1[0] = EOS;

	cache_delete(result);

    format(stringer1, sizeof (stringer1), "{33CC66}[R] алоба от %s[%d]: {FFFF66}%s", GetPlayerData(playerid,P_NAME), playerid, text);
	
    SendMessageToAdmins(stringer1, 0x33CC66FF);

	report_UpdateCounter();

	return true;
}
stock report_Show(playerid) {
	new
		Cache:result, report_id, report_playerid, report_player_name[MAX_PLAYER_NAME + 1], report_date[20], report_text[144], report_ago_seconds;

	result = mysql_query(mysql, "SELECT *, TIMESTAMPDIFF(SECOND, date, NOW()) AS ago_sec FROM "TABLE_REPORTS" WHERE status="#REPORT_STATUS_NONE" AND (admin=0 OR admin IS NULL) LIMIT 1");

	mysql_query_[0] = EOS;

	new rows = cache_num_rows();

	if (!rows) {
		cache_delete(result);
		SendClientMessage(playerid, COLOR_WHITE, !"{afafaf} очереди нет запросов от игроков!");
		return true;
	}
	report_id = cache_get_field_content_int(0, "id");
	report_playerid = cache_get_field_content_int(0, "player_id");

	cache_get_field_content(0, "player_name", report_player_name, mysql, sizeof(report_player_name));

	cache_get_field_content(0, "text", report_text, mysql, sizeof (report_text));
	cache_get_field_content(0, "date", report_date, mysql, sizeof (report_date));
	report_ago_seconds = cache_get_field_content_int(0, "ago_sec");
	if (report_ago_seconds < 0) report_ago_seconds = 0;

	mysql_format(mysql, mysql_query_, sizeof (mysql_query_), "SELECT * FROM "TABLE_REPORTS" WHERE \
		status>"#REPORT_STATUS_NONE" AND player_name='%e' ORDER BY id DESC LIMIT 3", report_player_name
	);
	mysql_tquery(mysql, mysql_query_, "report_ShowDialog", "ddsdssd", playerid, report_id, report_player_name, report_playerid, report_text, report_date, report_ago_seconds);

	cache_delete(result);
	return true;
}
public: report_ShowDialog(playerid, report_id, const report_player_name[], report_playerid, const report_text[], const report_date[], report_ago_seconds) {
	new report_minutes = report_ago_seconds / 60;
	new report_seconds = report_ago_seconds % 60;

	mysql_format(mysql, mysql_query_, sizeof (mysql_query_),
		"UPDATE "TABLE_REPORTS" SET admin=%d WHERE id=%d LIMIT 1", playerid + 1, report_id
	);
	mysql_tquery(mysql, mysql_query_, "", ""), mysql_query_[0] = EOS;
	report_UpdateCounter();

	format(stringer, sizeof (stringer), "\
		{FFFFFF}омер запроса: "c_server"#%d\n\
		{FFFFFF}грок: {afafaf}%s[%d]\n\
		{FFFFFF}ата подачи: {afafaf}%d мин. %d сек. назад\n\
		{FFFFFF}апрос: "c_server"%s",
		report_id,
		report_player_name, report_playerid,
		report_minutes, report_seconds,
		report_text
	);

	TempReportInfo[playerid][reportID] = report_id;
	TempReportInfo[playerid][reportPlayerID] = report_playerid;
	strmid(TempReportInfo[playerid][reportText], report_text, 0, strlen(report_text), 144);
	strmid(TempReportInfo[playerid][reportDate], report_date, 0, strlen(report_date), 20);

	Dialog(playerid, 5512, DIALOG_STYLE_INPUT, !""c_server"твет на запрос игрока", stringer, !"тветит", !"ропустит");

	stringer[0] = EOS;
}

//alias:an("ans", "reps", "pm");

CMD:reps(playerid, params[])
{
    return callcmd::ans(playerid, params);
}

CMD:pm(playerid, params[])
{
    return callcmd::ans(playerid, params);
}

CMD:ans(playerid, params[])
{
    if(GetPlayerAdminEx(playerid))
    {
		new targetid, text[81];

		if (sscanf(params, "is[81]", targetid, text) || targetid < 0 ) {
			if (!report_Show(playerid) && strlen(params) > 2) {
				SendClientMessage(playerid, COLOR_WHITE, !"{afafaf}{1E90FF}[одсказка]:{FFFFFF} /ans [playerid / reportid] [текст / ответ]");
			}
			return true;
		}
		if (targetid >= MAX_PLAYERS) {

			new report_id = targetid, status = REPORT_STATUS_ANSWERED, Cache:result;

			mysql_query_[0] = EOS;

			mysql_format(mysql, mysql_query_, sizeof (mysql_query_), "SELECT * FROM "TABLE_REPORTS" \
				WHERE status=0 AND id=%i", report_id
			);
			result = mysql_query(mysql, mysql_query_, true);

			targetid = cache_get_field_content_int(0, "player_id");
			cache_get_field_content(0, "text", TempReportInfo[playerid][reportText], mysql, 144);
			cache_get_field_content(0, "date", TempReportInfo[playerid][reportDate], mysql, 20);

			mysql_query_[0] = EOS;
			new rows = cache_num_rows();

			if(!rows) {
				cache_delete(result);
				SendClientMessage(playerid, COLOR_WHITE, !"{afafaf}а даннй запрос уже бл дан ответ!");
				return true;
			}
			mysql_format(mysql, mysql_query_, sizeof (mysql_query_), "UPDATE "TABLE_REPORTS" SET \
				status=%d, answer='%e' WHERE status=0 AND id=%d", status, text, report_id
			);
			mysql_query(mysql, mysql_query_);
			report_UpdateCounter();

            format(stringer1, sizeof (stringer1), "{FF6347}аш запрос №%d: {FFFFFF}%s", report_id, TempReportInfo[playerid][reportText]);
            SendClientMessage(targetid, COLOR_WHITE, stringer1);
            format(stringer1, sizeof (stringer1), "{FF6347}твет от администратора %s[%d]: {FFFFFF}%s", GetPlayerNameEx(playerid), playerid, text);
            SendClientMessage(targetid, COLOR_WHITE, stringer1), stringer1[0] = EOS;

			format(stringer1, sizeof(stringer1), "{afafaf}[A] %s[%d] ответил игроку %s[%i]: %s",
				GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(targetid), targetid, text
			);
			SendMessageToAdmins(stringer1,0xFfa500AA);

			cache_delete(result);

		} else {
			if (!IsPlayerConnected(targetid))
				return SendClientMessage(playerid, COLOR_WHITE, !"{afafaf}грок не найден");

			if (strlen(text) > 80)
				return SendClientMessage(playerid, COLOR_WHITE, !"{afafaf}елз писат болше 80 символов!");

			if (targetid == playerid)
				return SendClientMessage(playerid, COLOR_WHITE, !"{afafaf}елз ответит самому себе");

			format(stringer1, sizeof(stringer1), ""c_server"твет от администратора %s[%d]: {FFFFFF}%s",
				GetPlayerNameEx(playerid), playerid, text
			);
			SendClientMessage(targetid, 0xffa141FF, stringer1);

			format(stringer1, sizeof(stringer1), "{afafaf}[A] %s[%d] ответил игроку %s[%d]: %s",
				GetPlayerNameEx(playerid), playerid, GetPlayerData(targetid, P_NAME), targetid, text
			);
			SendMessageToAdmins(stringer1,0xFfa500AA);

			stringer1[0] = EOS;
		}
	}
	return true;
}
stock report_EnsureSchema()
{
	mysql_query(mysql, "CREATE TABLE IF NOT EXISTS "TABLE_REPORTS" (\
		id INT(11) NOT NULL AUTO_INCREMENT,\
		status INT(11) NOT NULL DEFAULT 0,\
		answer TEXT NOT NULL,\
		player_name VARCHAR(24) NOT NULL,\
		player_id INT(11) NOT NULL DEFAULT 0,\
		text TEXT NOT NULL,\
		date DATETIME NOT NULL,\
		admin INT(11) NOT NULL DEFAULT 0,\
		PRIMARY KEY (id)\
	) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci", false);

	mysql_tquery(mysql,
		"SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='"TABLE_REPORTS"' AND COLUMN_NAME IN ('status','admin','answer')",
		"report_EnsureSchemaCallback", ""
	);
	return true;
}

public: report_EnsureSchemaCallback()
{
	new rows = cache_num_rows();
	new bool:has_status = false, bool:has_admin = false, bool:has_answer = false;
	new column_name[24];

	for(new i; i < rows; i++)
	{
		cache_get_field_content(i, "COLUMN_NAME", column_name, mysql, sizeof(column_name));
		if(!strcmp(column_name, "status", true)) has_status = true;
		else if(!strcmp(column_name, "admin", true)) has_admin = true;
		else if(!strcmp(column_name, "answer", true)) has_answer = true;
	}

	if(!has_status)
		mysql_query(mysql, "ALTER TABLE "TABLE_REPORTS" ADD COLUMN status INT(11) NOT NULL DEFAULT 0", false);

	if(!has_admin)
		mysql_query(mysql, "ALTER TABLE "TABLE_REPORTS" ADD COLUMN admin INT(11) NOT NULL DEFAULT 0", false);

	if(!has_answer)
		mysql_query(mysql, "ALTER TABLE "TABLE_REPORTS" ADD COLUMN answer TEXT NOT NULL", false);

	report_OnGameModeInit();
	return true;
}

report_OnGameModeInit() {
	mysql_tquery(mysql, "UPDATE "TABLE_REPORTS" SET status="#REPORT_STATUS_SKIPPED" WHERE status=0", "", "");
	mysql_tquery(mysql, "TRUNCATE "TABLE_REPORTS"", "", "");
	mysql_tquery(mysql, "ALTER TABLE "TABLE_REPORTS" AUTO_INCREMENT=1", "", "");
	report_UpdateCounter();
}
report_OnPlayerDisconnect(playerid) {
	mysql_query_[0] = EOS;

	mysql_format(mysql, mysql_query_, sizeof (mysql_query_),
		"DELETE FROM "TABLE_REPORTS" WHERE status="#REPORT_STATUS_NONE" AND player_id=%d", playerid
	);
	mysql_tquery(mysql, mysql_query_, "", ""), mysql_query_[0] = EOS;

	if (TempReportInfo[playerid][reportID]) {
		mysql_format(mysql, mysql_query_, sizeof (mysql_query_),
			"UPDATE "TABLE_REPORTS" SET admin=0 WHERE admin=%d LIMIT 1", playerid + 1
		);
		mysql_tquery(mysql, mysql_query_, "", ""), mysql_query_[0] = EOS;
		TempReportInfo[playerid][reportID] = 0;
	}

	report_UpdateCounter();
}


