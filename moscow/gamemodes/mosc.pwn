                SendClientMessage(playerid, 0x3399FFFF, " предложили %s подключитс к радио-эфиру", 
                    GetPlayerNameEx(to_player));
            }
            case OFFER_TYPE_GIVE_LIC:
            {
                new lic_names[3][34] = {"вождение базового уровн", "вождение профессионалного уровн", "оружие"};
                format(fmt_text, sizeof fmt_text, "%s предлагает купит лицензию на %s за %d руб", 
                    GetPlayerNameEx(playerid), lic_names[value_1 - 1], value_2);
                notify_id = NOTIFY_OFFER_GIVE_LIC;
                extra = value_1;
                SendClientMessage(playerid, 0x3399FFFF, " предложили %s лицензию на %s за %d руб", 
                    GetPlayerNameEx(to_player), lic_names[value_1 - 1], value_2);
            }
            case OFFER_TYPE_JAIL_FREE:
            {
                format(fmt_text, sizeof fmt_text, "%s предлагает пересмотрет дело за %d руб", 
                    GetPlayerNameEx(playerid), value_1);
                notify_id = NOTIFY_OFFER_JAIL_FREE;
