                        if(!CanPlayerReceiveInventorySim(playerid, default_phone))
                        {
                            return ShowNotificationNew(playerid, 2, 5, -1, -1, "свободите слот в инвентаре дл новой SIM-карт.", ""), 1;
                        }

                        if(GetPlayerMoneyEx(playerid) >= price)
                        {
