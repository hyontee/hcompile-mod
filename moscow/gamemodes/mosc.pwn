        "DELETE FROM charity WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM business_gps WHERE bid IN (SELECT id FROM business WHERE owner_id=%d)", account_id);
    mysql_query(mysql, query, false);
    
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM business_profit WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM fuel_stations_profit WHERE uid=%d", account_id);
    mysql_query(mysql, query, false);
    
    if(target_id != INVALID_PLAYER_ID && IsPlayerConnected(target_id))
    {
        g_player[target_id] = g_player_default_values;
        
        new dialog_text[1024];
        
        new year, month, day, hour, minute, second;
        getdate(year, month, day);
        gettime(hour, minute, second);
        
        new date_str[32];
        format(date_str, sizeof(date_str), "%02d.%02d.%d в %02d:%02d", day, month, year, hour, minute);
        
        format(dialog_text, sizeof(dialog_text),
            "{FFFFFF}аш аккаунт бл удален администрацией за нарушение\n\
            правил сервера.  болше не можете играт на этом аккаунте.\n\n\
            {FFFF00}| {FFFFFF}аш никнейм: {FFFF00}%s\n\
            {FFFF00}| {FFFFFF}икнейм администратора: {FFFF00}%s\n\
            {FFFF00}| {FFFFFF}ата удалени: {FFFF00}%s\n\
            {FFFF00}| {FFFFFF}ричина удалени: {FFFF00}%s\n\n\
            {FF0000}! осстановление аккаунта невозможно!\n\n\
            {FFFFFF} не согласн с решением администратора и считаете, что наказание\n\
            бло вдано несправедливо или ошибочно?  таком случае,\n\
            необходимо обратитс в специалнй раздел с жалобой на\n\
            официалном форуме проекта: {FFFF00}forum.usupovrp.ru.\n\n\
            {FFFFFF}е забудте прикрепит скриншот данного окна в жалобу.",
            GetPlayerNameEx(target_id),
            admin_name,
            date_str,
            reason
        );
        
        ShowPlayerDialog(target_id, 0, DIALOG_STYLE_MSGBOX,
            "{FF0000}  ",
            dialog_text,
            "", ""
        );
        
        SetTimerEx("KickPlayerAfterDelete", 5000, false, "i", target_id);
    }
    
    format(fmt_text, sizeof(fmt_text), 
        "{FF0000}[ ] {FFFFFF}дминистратор {FF9900}%s {FFFFFF}удалил аккаунт {FF9900}%s {FFFFFF}(ID: %d)",
        admin_name, target_name, account_id);
    SendMessageToAdmins(fmt_text, 0xFF0000FF);
    
    if(strlen(reason) > 0)
    {
        format(fmt_text, sizeof(fmt_text), "{FFFFFF}ричина: {FF9900}%s", reason);
        SendMessageToAdmins(fmt_text, 0xFFFFFFFF);
    }
    
    printf("[ ] %s удалил аккаунт %s (ID: %d) ричина: %s", 
        admin_name, target_name, account_id, reason);
    
    if(mysql_errno())
    {
        printf("[] ри удалении аккаунта %d: %d", account_id, mysql_errno());
        return false;
    }
    
    return true;
}

public KickPlayerAfterDelete(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        ClearPlayerInfo(playerid);
        Kick(playerid);
    }
    return 1;
}





stock LoadPlayerSimCards(playerid)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0) return 0;
    
    g_player_sim_resource_count[playerid] = 0;
    for(new i = 0; i < 32; i++)
    {
        g_player_sim_resource[playerid][i][PSR_SQL_ID] = 0;
        g_player_sim_resource[playerid][i][PSR_NUMBER][0] = 0;
    }
    
    new query[256], Cache:result;
    mysql_format(mysql, query, sizeof(query),
        "SELECT id, number FROM player_sim_cards WHERE player_id=%d ORDER BY id ASC",
        account_id);
    result = mysql_query(mysql, query, true);
    
    new rows = cache_num_rows();
    for(new i = 0; i < rows && i < 32; i++)
    {
        g_player_sim_resource[playerid][i][PSR_SQL_ID] = cache_get_field_content_int(i, "id");
        cache_get_field_content(i, "number", g_player_sim_resource[playerid][i][PSR_NUMBER], mysql, 16);
        g_player_sim_resource_count[playerid]++;
        
        printf("[SIM] агружена SIM-карта %s (SQL ID: %d) дл игрока %d",
            g_player_sim_resource[playerid][i][PSR_NUMBER],
            g_player_sim_resource[playerid][i][PSR_SQL_ID],
            playerid);
    }
    
    cache_delete(result);
    return 1;
}

stock SavePlayerSimCards(playerid)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0 || g_player_sim_owner_id[playerid] != account_id) return 0;

    new query[256];
    
    // начала удалем старе SIM-карт игрока
    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM player_sim_cards WHERE player_id=%d", 
        GetPlayerAccountID(playerid));
    mysql_query(mysql, query, false);
    
    for(new i = 0; i < g_player_sim_resource_count[playerid]; i++)
    {
        mysql_format(mysql, query, sizeof query, 
            "INSERT INTO player_sim_cards (player_id, number) VALUES (%d, '%s')",
            account_id, 
            g_player_sim_resource[playerid][i][PSR_NUMBER]);
        mysql_query(mysql, query, false);
        
        printf("[SIM] охранена SIM-карта дл %s: %s", 
            GetPlayerNameEx(playerid), 
            g_player_sim_resource[playerid][i][PSR_NUMBER]);
    }
    
    return 1;
}


CMD:clearsim(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    new query[256];
    mysql_format(mysql, query, sizeof query, "TRUNCATE TABLE player_sim_cards");
    mysql_query(mysql, query, false);

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        g_player_sim_resource_count[i] = 0;
        for(new j = 0; j < 32; j++)
        {
            g_player_sim_resource[i][j][PSR_SQL_ID] = 0;
            g_player_sim_resource[i][j][PSR_NUMBER][0] = 0;
        }
    }
    
    SendClientMessage(playerid, 0x66CC33FF, "се SIM-карт удален!");
    return 1;
}

stock SetPlayerWounded(playerid)
{
    if(g_PlayerWounded[playerid]) return 1;
    
    GetPlayerPos(playerid, g_WoundPosition[playerid][0], g_WoundPosition[playerid][1], g_WoundPosition[playerid][2]);
    
    g_PlayerWounded[playerid] = true;
    g_WoundNeedHelpTimer[playerid] = 0;
    
    SetPlayerPos(playerid, g_WoundPosition[playerid][0], g_WoundPosition[playerid][1], g_WoundPosition[playerid][2]);
    
    ApplyAnimationEx(playerid, "SWAT", "gnstwall_injurd", 4.0, 1, 0, 0, 0, 0, 1, USE_ANIM_TYPE_NONE - 1);

    TogglePlayerControllable(playerid, false);

    new label_text[128];
    format(label_text, sizeof(label_text), "{FFFF00}Я Я\n{FFFFFF}одойдите дл оказани помощи");
    g_WoundLabel[playerid] = CreateDynamic3DTextLabel(
        label_text,
        0xFFFF00FF,
        g_WoundPosition[playerid][0],
        g_WoundPosition[playerid][1],
        g_WoundPosition[playerid][2] + 1.5,
        15.0,
        INVALID_PLAYER_ID,
        INVALID_VEHICLE_ID,
        0,
        0,
        -1,
        15.0
    );
    g_WoundTimer[playerid] = SetTimerEx("AutoHospitalizePlayer", 60000, false, "i", playerid);
    
    printf("[WOUND] грок %s[%d] ранен. озици: %.2f, %.2f, %.2f", 
        GetPlayerNameEx(playerid), playerid,
        g_WoundPosition[playerid][0], g_WoundPosition[playerid][1], g_WoundPosition[playerid][2]);
    
    return 1;
}

stock ClearPlayerWounded(playerid)
{
    if(!g_PlayerWounded[playerid]) return 1;
    
    if(g_WoundTimer[playerid] != -1)
    {
        KillTimer(g_WoundTimer[playerid]);
        g_WoundTimer[playerid] = -1;
    }
    
    if(IsValidDynamic3DTextLabel(g_WoundLabel[playerid]))
    {
        DestroyDynamic3DTextLabel(g_WoundLabel[playerid]);
        g_WoundLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
    }
    
    TogglePlayerControllable(playerid, true);
    ClearAnimations(playerid);
    
    g_PlayerWounded[playerid] = false;
    g_WoundNeedHelpTimer[playerid] = 0;
    
    return 1;
}

forward AutoHospitalizePlayer(playerid);
public AutoHospitalizePlayer(playerid)
{
    if(!IsPlayerConnected(playerid) || !g_PlayerWounded[playerid]) return 1;
    
    TeleportPlayerToHospital(playerid);
    
    return 1;
}

stock HealWoundedPlayer(healerid, targetid)
{
    if(!g_PlayerWounded[targetid]) 
        return SendClientMessage(healerid, 0x999999FF, "тот игрок не ранен");
    
    if(!IsPlayerInRangeOfPoint(healerid, WOUND_HELP_RADIUS, 
        g_WoundPosition[targetid][0], 
        g_WoundPosition[targetid][1], 
        g_WoundPosition[targetid][2]))
    {
        return SendClientMessage(healerid, 0x999999FF, " слишком далеко от раненого");
    }
    
    ClearPlayerWounded(targetid);
    
    SetPlayerHealth(targetid, 50.0);
    SetPlayerData(targetid, P_HEALTH, 50.0);
    
    TogglePlayerControllable(targetid, true);
    ClearAnimations(targetid);

    new fmt_msg[128];
    format(fmt_msg, sizeof(fmt_msg), "%s оказал помощ %s", 
        GetPlayerNameEx(healerid), GetPlayerNameEx(targetid));
    SendMessageInLocal(healerid, fmt_msg, 0x66CC33FF, 25.0);
    
    SendClientMessage(targetid, 0x66CC33FF, "ам оказали помощ!");
    SendClientMessage(healerid, 0x66CC33FF, " оказали помощ игроку!");
    
    AddPlayerData(healerid, P_EXP, +, 5);
    
    printf("[WOUND] грок %s[%d] оказал помощ %s[%d]", 
        GetPlayerNameEx(healerid), healerid, 
        GetPlayerNameEx(targetid), targetid);
    
    return 1;
}

CMD:helpwound(playerid, params[])
{
    if(!strlen(params))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /helpwound [id игрока]");
    
    new targetid;
    if(sscanf(params, "d", targetid))
        return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /helpwound [id игрока]");
    
    if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
        return SendClientMessage(playerid, 0x999999FF, "акого игрока нет");
    
    return HealWoundedPlayer(playerid, targetid);
}

stock SaveVehicleFuel(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0;
    
    // роверем, личное ли это авто
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return 0;
    
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index == -1) 
    {
        printf("[FUEL] : index == -1 дл vehicleid %d", vehicleid);
        return 0;
    }
    
    new Float:fuel = GetVehicleData(vehicleid, V_FUEL);
    new sql_id = GetOwnableCarData(index, OC_SQL_ID);
    new query[128];
    
    printf("[FUEL] : SQL ID %d, топливо %.1f л.", sql_id, fuel);
    
    mysql_format(mysql, query, sizeof query, 
        "UPDATE ownable_cars SET fuel=%f WHERE id=%d", 
        fuel, 
        sql_id);
    mysql_query(mysql, query, false);
    
    if(mysql_errno() == 0)
        printf("[FUEL] : спешно! SQL ID %d, топливо %.1f л.", sql_id, fuel);
    else
        printf("[FUEL] : шибка MySQL! errno=%d", mysql_errno());
    
    return 1;
}

stock LoadVehicleFuel(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0;
    
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return 0;
    
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index == -1) return 0;
    
    new query[128], Cache:result;
    new Float:fuel = 50.0;
    
    mysql_format(mysql, query, sizeof query, 
        "SELECT fuel FROM ownable_cars WHERE id=%d", 
        GetOwnableCarData(index, OC_SQL_ID));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        fuel = cache_get_field_content_float(0, "fuel");
    }
    cache_delete(result);
    
    if(fuel < 0.0 || fuel > 150.0) fuel = 50.0;
    
    SetVehicleData(vehicleid, V_FUEL, fuel);

    return 1;
}

stock ShowFuelMenu(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    
    if(!IsPlayerDriver(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, ""USC" должн бт за рулем транспортного средства");
    
    new stationid = GetNearestFuelStation(playerid, 10.0);
    
    if(stationid == -1)
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"облизости нет заправочной станции");
    
    if(stationid < 0 || stationid >= g_fuel_station_loaded)
        return SendClientMessage(playerid, 0xCECECEFF, ""USC"шибка:  не найдена");
    
    new fuel_price = GetFuelStationData(stationid, FS_FUEL_PRICE);
    new dialog_text[512];
    
    format(dialog_text, sizeof(dialog_text),
        "{FFFF00}1.{FFFFFF} аправка транспортного средства {32CD32}(1 литр - %d руб.)\n\
        {FFFF00}2.{FFFFFF} окупка ремонтного комплекта дл транспортного средства {32CD32}(250 руб.)\n\
        {FFFF00}3.{FFFFFF} окупка канистр дл заправки транспортного средства {32CD32}(200 руб.)",
        fuel_price
    );
    
    new title[64];
    format(title, sizeof(title), "{FFFF00} еню  #%d", stationid + 1);
    
    Dialog(playerid, DIALOG_FUEL_MENU, DIALOG_STYLE_LIST,
        title,
        dialog_text,
        "брат",
        "акрт"
    );
}

stock ShowFuelAmountDialog(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float:current_fuel = GetVehicleData(vehicleid, V_FUEL);
    new Float:max_fuel = 150.0;
    new Float:available = max_fuel - current_fuel;
    
    new dialog_text[256];
    format(dialog_text, sizeof(dialog_text),
        "{FFFFFF}ведите количество топлива, которое нужно заправит\n\n\
        {FFFFFF}екущий уровен топлива: {FFFF00}%.1f {FFFFFF}/ 150 л.\n\
        {FFFFFF}оступно дл заправки: {32CD32}%.1f {FFFFFF}л.\n\n\
        {FF0000}нимание: вигател должен бт включен!",
        current_fuel, available
    );
    
    Dialog(playerid, DIALOG_FUEL_AMOUNT, DIALOG_STYLE_INPUT,
        "{FFFF00}аправка транспортного средства",
        dialog_text,
        "аправит", "азад"
    );
}


forward FinishRefueling(playerid);
public FinishRefueling(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    
    if(!g_PlayerRefueling[playerid]) return 1;
    
    new vehicleid = g_RefuelVehicle[playerid];
    new Float:amount = g_RefuelAmount[playerid];
    
    if(!IsValidVehicle(vehicleid) || !IsPlayerInVehicle(playerid, vehicleid))
    {
        SendClientMessage(playerid, 0xFF6600FF, ""USC"аправка прервана!  вшли из транспорта.");
        g_PlayerRefueling[playerid] = false;
        return 1;
    }
    
    new Float:current_fuel = GetVehicleData(vehicleid, V_FUEL);
    SetVehicleData(vehicleid, V_FUEL, current_fuel + amount);

    SaveVehicleFuel(vehicleid);

    new msg[128];
    format(msg, sizeof(msg), ""SC"аправка завершена! обавлено {FFFF00}%.1f {FFFFFF}л. екущий уровен: {FFFF00}%.1f {FFFFFF}/ 150 л.",
        amount, GetVehicleData(vehicleid, V_FUEL));
    SendClientMessage(playerid, 0x66CC33FF, msg);
    
    ShowNotificationNew(playerid, 3, 5, -1, -1, "аправка завершена!", "");
    
    // брос
    g_PlayerRefueling[playerid] = false;
    g_RefuelTimer[playerid] = -1;
    g_RefuelAmount[playerid] = 0.0;
    g_RefuelVehicle[playerid] = INVALID_VEHICLE_ID;
    
    return 1;
}

CMD:fuelinfo(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, ""USC" должн бт в транспорте");
    
    new vehicleid = GetPlayerVehicleID(playerid);
    new Float:fuel = GetVehicleData(vehicleid, V_FUEL);

    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        new index = GetVehicleData(vehicleid, V_ACTION_ID);
        new msg[256];
        format(msg, sizeof(msg),
            ""SC"нформаци о топливе:\n\
            {FFFFFF} памти: {FFFF00}%.1f {FFFFFF}л.\n\
            {FFFFFF} : {FFFF00}%.1f {FFFFFF}л.\n\
            {FFFFFF}ID авто: {FFFF00}%d",
            fuel,
            GetVehicleFuelFromDB(vehicleid),
            GetOwnableCarData(index, OC_SQL_ID)
        );
        SendClientMessage(playerid, 0x66CC33FF, msg);
    }
    else
    {
        new msg[128];
        format(msg, sizeof(msg), ""SC"екущий уровен топлива: {FFFF00}%.1f {FFFFFF}/ 150 л.", fuel);
        SendClientMessage(playerid, 0x66CC33FF, msg);
    }
    
    return 1;
}

stock Float:GetVehicleFuelFromDB(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0.0;
    
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return 0.0;
    
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index == -1) return 0.0;
    
    new query[128], Cache:result;
    new Float:fuel = 50.0;
    
    mysql_format(mysql, query, sizeof query, 
        "SELECT fuel FROM ownable_cars WHERE id=%d", 
        GetOwnableCarData(index, OC_SQL_ID));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        fuel = cache_get_field_content_float(0, "fuel");
    }
    cache_delete(result);
    
    return fuel;
}

stock SaveAllVehiclesFuel()
{
    new count = 0;
    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(IsValidVehicle(i) && GetVehicleData(i, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        {
            SaveVehicleFuel(i);
            count++;
        }
    }
    printf("[FUEL] охранено топливо дл %d личнх авто", count);
    return 1;
}


CMD:checkfueldb(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1) return 1;
    
    new vehicleid = GetPlayerVehicleID(playerid);
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, " должн бт в транспорте");
    
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR)
        return SendClientMessage(playerid, 0xCECECEFF, "то не личное авто");
    
    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    new sql_id = GetOwnableCarData(index, OC_SQL_ID);
    
    new query[128], Cache:result;
    new Float:db_fuel = 0.0;
    
    mysql_format(mysql, query, sizeof query, 
        "SELECT fuel FROM ownable_cars WHERE id=%d", sql_id);
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        db_fuel = cache_get_field_content_float(0, "fuel");
    }
    cache_delete(result);
    
    new Float:mem_fuel = GetVehicleData(vehicleid, V_FUEL);
    
    new msg[256];
    format(msg, sizeof(msg),
        ""SC"роверка топлива:\n\
        {FFFFFF} памти: {FFFF00}%.1f {FFFFFF}л.\n\
        {FFFFFF} : {FFFF00}%.1f {FFFFFF}л.\n\
        {FFFFFF}SQL ID: {FFFF00}%d",
        mem_fuel, db_fuel, sql_id);
    SendClientMessage(playerid, 0x66CC33FF, msg);
    
    return 1;
}

CMD:sub0(playerid, params[])
{
    if(!IsPlayerInAnyVehicle(playerid))
        return SendClientMessage(playerid, 0xFF6600FF, ""USC" должн находитс в автомобиле");

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC" должн бт за рулем");

    new vehicleid = GetPlayerVehicleID(playerid);
    
    if(GetPlayerOwnableCar(playerid) != vehicleid)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"абвуфер можно включит толко в личном автомобиле");

    if(g_PlayerSubwooferActive[playerid])
    {
        callcmd::suboff(playerid, "");
    }

    PlayAudioStreamURL(playerid, "http://rusradio.hostingradio.ru/rusradio128.mp3");
    
    g_PlayerSubwooferActive[playerid] = true;
    g_PlayerSubwooferStation[playerid] = 0;
    g_PlayerSubwooferVehicle[playerid] = vehicleid;
    
    // бновлем DLSB дл всех игроков у кого включен
    foreach(new i : Player)
    {
        if(g_SubwooferDebugActive[i])
        {
            UpdateDLSB(i);
        }
    }
    
    SendClientMessage(playerid, -1, "{00FF00}ключено оссийское адио");
    SendClientMessage(playerid, -1, "{FFFF00}сползуйте /dlsb дл отображени информации над авто");
    return 1;
}

