stock SetVehicleColorForPlayer(playerid, vehicleid, body[], wheel[])
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, vehicleid);
	BS_WriteValue(bitstream, PR_UINT8, 18);

	BS_WriteValue(bitstream, PR_UINT32, body);
	BS_WriteValue(bitstream, PR_UINT32, wheel);
	BS_WriteValue(bitstream, PR_UINT32, wheel);
	BS_WriteValue(bitstream, PR_UINT32, body);

	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
}

stock SetVehicleNumberPlateEx(vehicleid, type, number[], region[])
{
    vNumber[vehicleid][npType] = type;
    format(vNumber[vehicleid][npNumber], 32, "%s", number);
    format(vNumber[vehicleid][npRegion], 8, "%s", region);

    foreach(new playerid: Player)
    {
        SetVehicleNumberPlateForPlayer(playerid, vehicleid, type, number, region);
    }
}

stock bool:NormalizeOwnableCarPlateData(index)
{
    new number_len = strlen(g_ownable_car[index][OC_NUMBER]);
    new number_type = g_ownable_car[index][OC_NUMBER_TYPE];

    if(number_len == 0
        || !strcmp(g_ownable_car[index][OC_NUMBER], "none", true)
        || !strcmp(g_ownable_car[index][OC_NUMBER], "------", true))
    {
        format(g_ownable_car[index][OC_NUMBER], 32, "none");
        format(g_ownable_car[index][OC_REGION], 8, "--");
        g_ownable_car[index][OC_NUMBER_TYPE] = 0;
        return false;
    }

    if(number_type <= 0)
    {
        if(number_len == 6)
        {
            g_ownable_car[index][OC_NUMBER_TYPE] = 1;
            if(g_ownable_car[index][OC_REGION][0] == EOS || !strcmp(g_ownable_car[index][OC_REGION], "--", true))
            {
                format(g_ownable_car[index][OC_REGION], 8, "17");
            }
            number_type = 1;
        }
        else
        {
            format(g_ownable_car[index][OC_NUMBER], 32, "none");
            format(g_ownable_car[index][OC_REGION], 8, "--");
            g_ownable_car[index][OC_NUMBER_TYPE] = 0;
            return false;
        }
    }

    switch(number_type)
    {
        case 1, 4:
        {
            if(g_ownable_car[index][OC_REGION][0] == EOS || !strcmp(g_ownable_car[index][OC_REGION], "--", true))
            {
                if(number_type == 1 && number_len == 6)
                {
                    format(g_ownable_car[index][OC_REGION], 8, "17");
                }
                else
                {
                    format(g_ownable_car[index][OC_NUMBER], 32, "none");
                    format(g_ownable_car[index][OC_REGION], 8, "--");
                    g_ownable_car[index][OC_NUMBER_TYPE] = 0;
                    return false;
                }
            }
        }
        case 2, 3:
        {
            g_ownable_car[index][OC_REGION][0] = EOS;
        }
        default:
        {
            format(g_ownable_car[index][OC_NUMBER], 32, "none");
            format(g_ownable_car[index][OC_REGION], 8, "--");
            g_ownable_car[index][OC_NUMBER_TYPE] = 0;
            return false;
        }
    }

    return true;
}

stock LoadOwnableCarPlateFromCache(row, index)
{
    cache_get_field_content(row, "number", g_ownable_car[index][OC_NUMBER], mysql, 32);
    cache_get_field_content(row, "region", g_ownable_car[index][OC_REGION], mysql, 8);
    SetOwnableCarData(index, OC_NUMBER_TYPE, cache_get_field_content_int(row, "number_type"));

    return NormalizeOwnableCarPlateData(index);
}

stock ApplyOwnableCarPlate(vehicleid, index)
{
    if(!IsValidVehicle(vehicleid)) return 0;

    if(NormalizeOwnableCarPlateData(index))
    {
        SetVehicleNumberPlateEx(vehicleid,
            g_ownable_car[index][OC_NUMBER_TYPE],
            g_ownable_car[index][OC_NUMBER],
            g_ownable_car[index][OC_REGION]
        );
    }
    else
    {
        SetVehicleNumberPlateEx(vehicleid, 0, "------", "000");
    }

    return 1;
}

stock SetVehicleNumberPlateForPlayer(playerid, vehicleid, type, number[], region[])
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, 7);

    BS_WriteValue(bitstream, PR_UINT16, vehicleid);

    BS_WriteValue(bitstream, PR_UINT8, type);

    BS_WriteValue(bitstream, PR_UINT8, strlen(number));
    BS_WriteValue(bitstream, PR_STRING, number);

    BS_WriteValue(bitstream, PR_UINT8, strlen(region));
    BS_WriteValue(bitstream, PR_STRING, region);

    PR_SendRPC(bitstream, playerid, 168, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bitstream);
}

stock LoadVehicleTuningFromCache(vehicleid, row, Cache:result)
{
    if(!IsValidVehicle(vehicleid)) return 0;

    ResetVehicleTuning(vehicleid);

    
    return 1;
}

stock SyncVehicleTuningForPlayer(playerid, vehicleid)
{
    if(vInfo[vehicleid][vNeon1] || vInfo[vehicleid][vNeon2] || vInfo[vehicleid][vNeon3])
    {
        SetVehicleNeonForPlayer(playerid, vehicleid,
            vInfo[vehicleid][vNeon1],
            vInfo[vehicleid][vNeon2],
            vInfo[vehicleid][vNeon3]
        );
    }
    if(vInfo[vehicleid][vTint] > 0)
    {
        SetVehicleTintForPlayer(playerid, vehicleid, vInfo[vehicleid][vTint]);
    }
    if(strlen(vInfo[vehicleid][viVinylTexture]) > 0)
    {
        SetVehicleVinylForPlayer(playerid, vehicleid, vInfo[vehicleid][viVinylTexture]);
    }

    if(vInfo[vehicleid][viTonerFront] || vInfo[vehicleid][viTonerRear])
    {
        SetVehicleTonerForPlayer(playerid, vehicleid,
            vInfo[vehicleid][viTonerFront],
            vInfo[vehicleid][viTonerRear],
            vInfo[vehicleid][viTonerFrontSide],
            vInfo[vehicleid][viTonerRearSide]
        );
    }
    if(vInfo[vehicleid][vSuspensionForce] != 0)
    {
        SetVehicleSuspensionForceForPlayer(playerid, vehicleid, vInfo[vehicleid][vSuspensionForce]);
    }
    if(vInfo[vehicleid][vCarMod] > 0)
    {
        SendCarMod(playerid, vInfo[vehicleid][vCarModParam], vehicleid, vInfo[vehicleid][vCarMod]);
    }

    if(vInfo[vehicleid][vSuspensionBias] != 0)
    {
        SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, vInfo[vehicleid][vSuspensionBias]);
    }
    if(vInfo[vehicleid][vWheelSize] != 0)
    {
        SetVehicleWheelSizeForPlayer(playerid, vehicleid, vInfo[vehicleid][vWheelSize]);
    }

    if(vInfo[vehicleid][vWheelAddFront] || vInfo[vehicleid][vWheelAddRear])
    {
        SetVehicleWheelAdditiveForPlayer(playerid, vehicleid,
            vInfo[vehicleid][vWheelAddFront],
            vInfo[vehicleid][vWheelAddRear]
        );
	}
    if(vInfo[vehicleid][viHydraulics] > 0)
    {
        SetVehicleHydraulicsForPlayer(playerid, vehicleid, vInfo[vehicleid][viHydraulics]);
    }

    if(vInfo[vehicleid][viLaunchControl] > 0)
    {
        SetVehicleLaunchControlFP(playerid, vehicleid, vInfo[vehicleid][viLaunchControl]);
    }

    if(vInfo[vehicleid][viStrob] > 0)
    {
        SetVehicleStroboscopeForPlayer(playerid, vehicleid, vInfo[vehicleid][viStrob]);
    }

    if(vInfo[vehicleid][viSiren] > 0)
    {
        SetVehicleSirenForPlayer(playerid, vehicleid, vInfo[vehicleid][viSiren]);
    }

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        if(g_ownable_car[index][OC_NUMBER_TYPE] != 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                g_ownable_car[index][OC_NUMBER_TYPE],
                g_ownable_car[index][OC_NUMBER],
                g_ownable_car[index][OC_REGION]
            );
        }
    }
    else if(index != -1 && GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
{
    if(index >= 0 && index < MAX_OWNABLE_CARS)
    {
        if(vehicle_family[index][V_F_NUMBER_TYPE] != 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                vehicle_family[index][V_F_NUMBER_TYPE],
                vehicle_family[index][V_F_NUMBER],
                vehicle_family[index][V_F_REGION]
            );
        }
    }
    else
    {
        printf("[ERROR] евалиднй индекс семейного  %d (max: %d)", index, MAX_OWNABLE_CARS);
    }
}
    else
    {
        if(vNumber[vehicleid][npType] > 0)
        {
            SetVehicleNumberPlateForPlayer(playerid, vehicleid,
                vNumber[vehicleid][npType],
                vNumber[vehicleid][npNumber],
                vNumber[vehicleid][npRegion]
            );
        }
    }
}

stock ResetVehicleTuning(vehicleid)
{
	if(!IsValidVehicle(vehicleid)) return 0;
	
	format(vInfo[vehicleid][viVinylTexture], 64, "remapvehicles");
	vInfo[vehicleid][viVinyl] = 0;
    vInfo[vehicleid][viTonerFront] = 0;
    vInfo[vehicleid][viTonerRear] = 0;
    vInfo[vehicleid][viTonerFrontSide] = 0;
    vInfo[vehicleid][viTonerRearSide] = 0;
	vNumber[vehicleid][npType] = 0;
    format(vNumber[vehicleid][npNumber], 32, "none");
    format(vNumber[vehicleid][npRegion], 8, "--");
    vInfo[vehicleid][vCarMod] = 0;
    vInfo[vehicleid][vCarModParam] = 1;

    foreach(new playerid : Player)
    {
            SetVehicleVinylForPlayer(playerid, vehicleid, "remapvehicles");
            SetVehicleTonerForPlayer(playerid, vehicleid, 0, 0, 0, 0);
            SetVehicleNumberPlateForPlayer(playerid, vehicleid, 0, "", "");
            SendCarMod(playerid, 1, vehicleid, 0);
    }
    printf("[нешний вид] ашина %d сброшена к заводским настройкам.", vehicleid);
    return 1;
}


stock SetVehicleNeonForPlayer(playerid, vehicleid, color1, color2, color3)
{
	new BitStream:bs = BS_New();
	BS_WriteValue(bs, PR_UINT16, vehicleid);
