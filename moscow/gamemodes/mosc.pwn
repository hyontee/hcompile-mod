{

	return 1;
}

CMD:adonate(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) >= 1)
    {
		ShowPlayerAdminDonate(playerid);
	}
	return 1;
}

CMD:a(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) >= 1)
    {
        if(!strlen(params))
            return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /a [текст]");

        new prefix_name[32];
        GetPlayerAdminPrefixName(playerid, prefix_name, sizeof(prefix_name));

        new fmt_str[128];
        format(fmt_str, sizeof fmt_str, "[%s] %s[%d]: %s",
            prefix_name, GetPlayerNameEx(playerid), playerid, params);

        SendMessageToAdmins(fmt_str, 0x99CC00FF);
        SendLog(playerid, LOG_TYPE_ADMIN_CHAT, params);
    }
    return 1;
}

CMD:admins(playerid, params[])
{
    new vip = GetPlayerPremium(playerid);
	if(vip < 1 || vip > 3) return SendClientMessage(playerid, 0xCECECEFF, " ас нет VIP аккаунта.");

    new fmt_text[150];
    new list[1500] = "{FF5252}икнейм\t{FF5252}олжност\t{FF5252}нформаци\n";

    foreach(new i : Player)
    {
        if(!IsPlayerConnected(i)) continue;
        if(!IsPlayerLogged(i)) continue;

        new Admin = GetPlayerAdminEx(i);
        new YouTube = GetPlayerYouTubeEx(i);

        if(Admin == 0 && YouTube == 0) continue;

        new rank_name[64];

        if(Admin > 0)
        {
            switch(Admin)
            {
                case 1:  rank_name = ADM_LVL1_NAME;
                case 2:  rank_name = ADM_LVL2_NAME;
                case 3:  rank_name = ADM_LVL3_NAME;
                case 4:  rank_name = ADM_LVL4_NAME;
                case 5:  rank_name = ADM_LVL5_NAME;
                case 6:  rank_name = ADM_LVL6_NAME;
                case 7:  rank_name = ADM_LVL7_NAME;
                case 8:  rank_name = ADM_LVL8_NAME;
                default: rank_name = "---";
            }
        }
        else if(YouTube > 0)
        {

            format(rank_name, sizeof(rank_name), "тубер");
        }
        else
        {
            rank_name = "---";
        }

        format(fmt_text, sizeof fmt_text, "%s[%d]\t%s\tв игре\n", GetPlayerNameEx(i), i, rank_name);
        strcat(list, fmt_text);
    }

    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_TABLIST_HEADERS, "{FF5252}дминистраци в сети (стр.1)", list, "брат", "акрт");

    return 1;
}

CMD:admlist(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	new query[115],
		Cache: result,
		rows,
		admin,
		day_prev,
		day_last,
		name[21],
		admin_rank_name[64],
		last_login,
		last_date[6],
		list[sizeof query * 25 + 60] = "м\t\t\tанг\t игре вчера\t игре сегодн\tтатус\tоследний ход\n{FFFFFF}";

	mysql_format(mysql, query, sizeof query, "SELECT * FROM accounts WHERE admin > 0 ORDER BY last_login ASC");
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	for(new i; i < rows; i ++)
	{
		new day_time[4];

		admin = cache_get_field_content_int(i, "admin");
		day_prev = cache_get_field_content_int(i, "game_for_day_prev");
		day_last = cache_get_field_content_int(i, "game_for_day");

		day_time[0] = ConvertUnixTime(day_prev, CONVERT_TIME_TO_HOURS);
		day_time[1] = ConvertUnixTime(day_prev, CONVERT_TIME_TO_MINUTES);

		day_time[2] = ConvertUnixTime(day_last, CONVERT_TIME_TO_HOURS);
		day_time[3] = ConvertUnixTime(day_last, CONVERT_TIME_TO_MINUTES);

		last_login = cache_get_field_content_int(i, "last_login");
		timestamp_to_date(last_login, last_date[2], last_date[1], last_date[0], last_date[3], last_date[4], last_date[5]);


		cache_get_field_content(i, "name", name);
		GetAdminLevelName(admin, admin_rank_name, sizeof admin_rank_name);

		new fix_tabulation[21] = "                    ";

		format
		(
			query, sizeof query,
			"\n{FFFFFF}%s%s\t%s\t%s%d ч %d мин\t%s%d ч %d мин\t\t%s\t%02d.%02d.%d в %02d:%02d:%02d\n",
			name,
			fix_tabulation[strlen(name)],
			admin_rank_name,
			day_time[0] >= 3 ? day_time[0] > 3 ? "{66CC33}" : "{FFCD00}" : "{FF5533}",
			day_time[0],
			day_time[1],
			day_time[2] >= 3 ? day_time[0] > 3 ? "{66CC33}" : "{FFCD00}" : "{FF5533}",
			day_time[2],
			day_time[3],
			IsPlayerConnected(GetPlayerID(name)) ? "{66CC33}Online" : "{FF5533}Offline",
			last_date[0], last_date[1], last_date[2],
			last_date[3], last_date[4], last_date[5]
		);

		strcat(list, query);
	}

	cache_delete(result);

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCD00}писок администрации", list, "акрт", "");

	return 1;
}

CMD:admlist1(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	new query[115],
		Cache: result,
		rows,
		admin,
		day_prev,
		day_last,
		name[21],
		admin_rank_name[64],
		list[sizeof query * 25 + 60] = "м\t\t\tанг\t игре вчера\t игре сегодн\tтатус\n{FFFFFF}";

	mysql_format(mysql, query, sizeof query, "SELECT * FROM accounts WHERE admin > 0 ORDER BY admin DESC");
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	for(new i; i < rows; i ++)
	{
		new day_time[4];

		admin = cache_get_field_content_int(i, "admin");
		day_prev = cache_get_field_content_int(i, "game_for_day_prev");
		day_last = cache_get_field_content_int(i, "game_for_day");

		day_time[0] = ConvertUnixTime(day_prev, CONVERT_TIME_TO_HOURS);
		day_time[1] = ConvertUnixTime(day_prev, CONVERT_TIME_TO_MINUTES);

		day_time[2] = ConvertUnixTime(day_last, CONVERT_TIME_TO_HOURS);
		day_time[3] = ConvertUnixTime(day_last, CONVERT_TIME_TO_MINUTES);

		cache_get_field_content(i, "name", name);
		GetAdminLevelName(admin, admin_rank_name, sizeof admin_rank_name);

		new fix_tabulation[21] = "                    ";

		format
		(
			query, sizeof query,
			"\n{FFFFFF}%s%s\t%s\t%s%d ч %d мин\t%s%d ч %d мин\t\t%s",
			name,
			fix_tabulation[strlen(name)],
			admin_rank_name,
			(day_time[0] >= 3) ? ((day_time[0] > 3) ? ("{66CC33}") : ("")) : ("{FF5533}"),
			day_time[0],
			day_time[1],
			(day_time[2] >= 3) ? ((day_time[2] > 3) ? ("{66CC33}") : ("")) : ("{FF5533}"),
			day_time[2],
			day_time[3],
			IsPlayerConnected(GetPlayerID(name)) ? "{66CC33}Online" : "{FF5533}Offline"
		);

		strcat(list, query);
	}

	cache_delete(result);

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "писок администрации", list, "акрт", "");

	return 1;
}

CMD:get(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	if(!strlen(params))
		return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /get [им игрока]");

	if(!(3 <= strlen(params) <= 20))
		return SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден");

	extract params -> new string: name[21];

	new query[100];
	new Cache: result, user_id;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM accounts WHERE name='%e' LIMIT 1", name);
	result = mysql_query(mysql, query);

	if(cache_num_rows())
		user_id = cache_get_field_content_int(0, "id");

	if(!cache_num_rows() || !user_id)
		return SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден"), cache_delete(result);

	new reg_ip[16],
		last_ip[16],
		reg_date[6],
		reg_time = cache_get_field_content_int(0, "reg_time"),
		game_for_day = cache_get_field_content_int(0, "game_for_day"),
		game_for_day_prev = cache_get_field_content_int(0, "game_for_day_prev"),
		car_slots = cache_get_field_content_int(0, "car_slots");

	cache_get_field_content(0, "reg_ip", reg_ip);
	cache_get_field_content(0, "last_ip", last_ip);

	timestamp_to_date(reg_time, reg_date[2], reg_date[1], reg_date[0], reg_date[3], reg_date[4], reg_date[5]);

	new fmt_text[512];

	format
	(
		fmt_text, sizeof fmt_text,
		"\
		омер аккаунта:\t\t%d\n\
		аличне:\t\t\t%d\n\
		сн. банк счет:\t\t%d\n\
		ровен:\t\t\t%d\n\
		IP адрес (регистр.):\t\t%s\n\
		IP адрес (послед.):\t\t%s\n\
		ата и врем регистрации:\t\%02d.%02d.%d в %02d:%02d:%02d\n\
		онат:\t\t\t\t%d (сего: %d)\n\
		 игре сегодн:\t\t%d ч %d мин\n\
		 игре вчера:\t\t\t%d ч %d мин\n\n\
		лот дл транспорта:\t%d\n\
		",
		user_id,
		cache_get_field_content_int(0, "money"),
		cache_get_field_content_int(0, "bank"),
		cache_get_field_content_int(0, "level"),
		reg_ip,
		last_ip,
		reg_date[0], reg_date[1], reg_date[2],
		reg_date[3], reg_date[4], reg_date[5],
		cache_get_field_content_int(0, "donate_current"),
		cache_get_field_content_int(0, "donate_total"),
		ConvertUnixTime(game_for_day, CONVERT_TIME_TO_HOURS),
		ConvertUnixTime(game_for_day, CONVERT_TIME_TO_MINUTES),
		ConvertUnixTime(game_for_day_prev, CONVERT_TIME_TO_HOURS),
		ConvertUnixTime(game_for_day_prev, CONVERT_TIME_TO_MINUTES),
		car_slots
	);

	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT * FROM ownable_cars WHERE owner_id=%d", user_id);
	result = mysql_query(mysql, query, true);

	if(cache_num_rows())
	{
		for(new idx; idx < cache_num_rows(); idx ++)
		{
			new id = cache_get_field_content_int(idx, "id"),
				modelid = cache_get_field_content_int(idx, "model_id"),
				Float: x = cache_get_field_content_float(idx, "pos_x"),
				Float: y = cache_get_field_content_float(idx, "pos_y"),
				Float: z = cache_get_field_content_float(idx, "pos_z"),
				Float: health = cache_get_field_content_float(idx, "health"),
				number[7];

			cache_get_field_content(idx, "number", number);

			format(query, sizeof query, "\n%s [%d] - %s (%.1f, %.1f, %.1f) HP: %.1f", GetVehicleInfo(modelid - 400, VI_NAME), id, number, x, y, z, health);
			strcat(fmt_text, query);
		}
	}

	cache_delete(result);

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, name, fmt_text, "акрт", "");

	format(fmt_text, sizeof fmt_text, "мотрит информацию об аккаунте %s[acc:%d]", name, user_id);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);

	return 1;
}

CMD:money(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	if(!strlen(params))
		return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /money [им игрока]");

	if(!(3 <= strlen(params) <= 20))
		return SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден");

	extract params -> new string: name[21];

	new query[90];
	new Cache: result, user_id;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM accounts WHERE name='%e' LIMIT 1", name);
	result = mysql_query(mysql, query);

	if(cache_num_rows())
		user_id = cache_get_field_content_int(0, "id");

	if(!cache_num_rows() || !user_id)
		return SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден"), cache_delete(result);

	new player_cash = cache_get_field_content_int(0, "money"),
		player_bank = cache_get_field_content_int(0, "bank"),
		player_wage = cache_get_field_content_int(0, "wage"),
		player_business = cache_get_field_content_int(0, "business"),
		player_fuel_st = cache_get_field_content_int(0, "fuel_st"),
		bank_accounts_money,
		fmt_text[310];

	cache_delete(result);

	mysql_format(mysql, query, sizeof query, "SELECT * FROM bank_accounts WHERE uid='%d'", user_id);
	result = mysql_query(mysql, query);

	if(cache_num_rows())
	{
		for(new i = 0; i < cache_num_rows(); i++)
			bank_accounts_money += cache_get_field_content_int(i, "balance");
	}

	cache_delete(result);

	format
	(
		fmt_text, sizeof fmt_text,
		"\
		аличне денги:\t\t\t%d руб\n\
		сн.банковский счёт:\t\t\t%d руб\n\
		ременнй / счёт:\t\t\t%d руб\n\n\
		а всех доп. банк. счетах:\t\t%d руб\n\n\
		",
		player_cash, player_bank, player_wage, bank_accounts_money
	);

	if(player_business != -1)
	{
		mysql_format(mysql, query, sizeof query, "SELECT balance FROM business WHERE owner_id='%d' LIMIT 1", user_id);
		result = mysql_query(mysql, query);

		format(query, sizeof query, "а счету бизнеса:\t\t\t%d руб\n", cache_get_row_int(0, 0));
		strcat(fmt_text, query);

		cache_delete(result);
	}
	else strcat(fmt_text, "ет бизнеса\n");
	cache_delete(result);
	if(player_fuel_st != -1)
	{
		mysql_format(mysql, query, sizeof query, "SELECT balance FROM fuel_stations WHERE owner_id='%d' LIMIT 1", user_id);
		result = mysql_query(mysql, query);

		format(query, sizeof query, "а счету :\t\t\t\t%d руб", cache_get_row_int(0, 0));
		strcat(fmt_text, query);

		cache_delete(result);
	}
	else strcat(fmt_text, "ет ");

	Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, name, fmt_text, "акрт", "");

	format(fmt_text, sizeof fmt_text, "мотрит информацию о денгах %s[acc:%d]", params, user_id);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);

	return 1;
}

CMD:whitelist(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	if(!strlen(params))
		return ShowWhitelistMenu(playerid);

	if(!strcmp(params, "menu", true))
		return ShowWhitelistMenu(playerid);

	if(!strcmp(params, "status", true))
		return ShowWhitelistStatusDialog(playerid);

	if(!strcmp(params, "list", true))
		return ShowWhitelistListDialog(playerid);

	if(!strcmp(params, "on", true))
	{
		Whitelist_SetEnabled(true);
		SendClientMessage(playerid, 0x66CC33FF, "Whitelist включен");
		return ShowWhitelistStatusDialog(playerid);
	}

	if(!strcmp(params, "off", true))
	{
		Whitelist_SetEnabled(false);
		SendClientMessage(playerid, 0x66CC33FF, "Whitelist включен");
		return ShowWhitelistStatusDialog(playerid);
	}

	if(!strcmp(params, "add", true))
		return ShowWhitelistAddDialog(playerid);

	if(!strcmp(params, "del", true) || !strcmp(params, "delete", true) || !strcmp(params, "remove", true))
		return ShowWhitelistDelDialog(playerid);

	return ShowWhitelistMenu(playerid);
}
CMD:getlog(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 5) return 1;

	if(!strlen(params))
	{
		SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /getlog [им игрока] [идентификатор лога] [кол-во дней]");
		SendClientMessage(playerid, 0xCECECEFF, "дентификатор:");
		SendClientMessage(playerid, 0xCECECEFF, "1 - дминистраторский чат");
		SendClientMessage(playerid, 0xCECECEFF, "2 - твет на репорт");
		SendClientMessage(playerid, 0xCECECEFF, "3 - дминистраторские действи");
		SendClientMessage(playerid, 0xCECECEFF, "4 - дача администраторских прав");
		SendClientMessage(playerid, 0xCECECEFF, "5 - дача лидерских прав");
		SendClientMessage(playerid, 0xCECECEFF, "6 -  сообщени");
		SendClientMessage(playerid, 0xCECECEFF, "7 - ообщени в общий чат");
		SendClientMessage(playerid, 0xCECECEFF, "8 - опрос/жалоб в репорт");
		SendClientMessage(playerid, 0xCECECEFF, "9 - ействи на посту лидера/заместител");
		SendClientMessage(playerid, 0xCECECEFF, "10 - ействи главного администратора");

		return 1;
	}

	extract params -> new string:name[21], log_id, time_limit;

	if(!(LOG_TYPE_ADMIN_CHAT <= log_id <= LOG_TYPE_SUPERADMIN_ACTION))
		return SendClientMessage(playerid, 0x999999FF, "евернй идентификатор");

	if(!(0 <= time_limit <= 30))
		return SendClientMessage(playerid, 0x999999FF, "оличество дней от 1 до 30. сползуйте 0 дл отображени всех действий");

	if(!(3 <= strlen(name) <= 20))
		return SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден");

	new query[144];
	new Cache: result,
		rows,
		user_id,
		admin;

	mysql_format(mysql, query, sizeof query, "SELECT id, admin FROM accounts WHERE name='%e' LIMIT 1", name);
	result = mysql_query(mysql, query);

	rows = cache_num_rows();

	if(rows)
	{
		user_id = cache_get_row_int(0, 0);
		admin = cache_get_row_int(0, 1);
	}

	cache_delete(result);

	if(rows && user_id)
	{
		if(GetPlayerAdminEx(playerid) >= admin)
		{
			mysql_format(mysql, query, sizeof query, "SELECT * FROM action_log WHERE acc_id=%d AND type=%d", user_id, log_id);

			new fmt_text[35];

			if(time_limit)
			{
				format(fmt_text, sizeof fmt_text, " AND time >= %d", gettime() - (time_limit * 86400));
				strcat(query, fmt_text);
			}

			result = mysql_query(mysql, query, true);

			rows = cache_num_rows();

			if(rows)
			{
				new log_name[10][37] =
				{
					"дминистраторский чат",
					"твет на репорт",
					"дминистраторские действи",
					"дача администраторских прав",
					"дача лидерских прав",
					" сообщени",
					"ообщени в общий чат",
					"опрос/жалоб в репорт",
					"ействи на посту лидера/заместител",
					"ействи главного администратора"
				};

				format(query, sizeof query, "айденне записи по параметру \"%s\" дл игрока %s", log_name[log_id - 1], name);

				if(time_limit)
				{
					format(fmt_text, sizeof fmt_text, " за последние %d дн.", time_limit);
					strcat(query, fmt_text);
				}

				SendClientMessage(playerid, 0x66CC33FF, query);

				for(new idx; idx < rows; idx ++)
				{
					new desc[144],
						time[6],
						uip[17];

					cache_get_field_content(idx, "description", desc);
					cache_get_field_content(idx, "uip", uip);

					timestamp_to_date(cache_get_field_content_int(idx, "time"), time[2], time[1], time[0], time[3], time[4], time[5]);

					format
					(
						query, sizeof query,
						"#%d | %02d.%02d.%d в %02d:%02d:%02d | %s | %s",
						cache_get_field_content_int(idx, "id"),
						time[0], time[1], time[2], time[3], time[4], time[5],
						uip, desc
					);

					SendClientMessage(playerid, 0xFFCD00FF, query);
				}

				format(query, sizeof query, "бщее количество записей: %d", rows);
				SendClientMessage(playerid, 0x66CC33FF, query);
			}
			else SendClientMessage(playerid, 0x999999FF, "аписи в базе даннх по даннм параметрам не найден");

			cache_delete(result);
		}
		else SendClientMessage(playerid, 0x999999FF, " не можете просматриват логи администратора вше ас рангом");
	}
	else SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден");

	return 1;
}

CMD:accip(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 8) return 1;

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /accip [IP адрес]");

	new query[130],
		fmt_text[2300],
		Cache: result,
		rows;

	mysql_format(mysql, query, sizeof query, "SELECT name, reg_ip FROM accounts WHERE reg_ip = '%s' OR last_ip = '%s'", params, params);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	if(rows)
	{
		new l_acc_count;

		format(fmt_text, sizeof fmt_text, "IP: %s\n", params);

		for(new idx; idx < rows; idx ++)
		{
			new name[21],
				ip[17];

			cache_get_row(idx, 0, name);
			cache_get_row(idx, 1, ip);

			new bool: is_reg = false;

			if(!strcmp(ip, params, true))
				is_reg = true;

			else
				l_acc_count ++;

			format
			(
				query, sizeof query,
				"\n{FFFFFF}%d. %s - %s %s",
				idx + 1,
				name,
				is_reg ? "Reg" : "Last",
				IsPlayerConnected(GetPlayerID(name)) ? "{66CC33}[online]" : "{888888}[offline]"
			);

			strcat(fmt_text, query);
		}

		format(query, sizeof query, "{FF9900}айдено аккаунтов: %d / %d", l_acc_count, rows);

		Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, query, fmt_text, "акрт", "");
	}
	else SendClientMessage(playerid, 0x999999FF, "аннй IP адрес не найден в базе даннх");

	cache_delete(result);

	return 1;
}

CMD:kick(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 1) return 1;
	

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /kick [id игрока] [причина (необзателно)]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player)) return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");
	else if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "елз кикнут администратора вше по рангу");

	new reason[31];
	sscanf(params, "{d}s[30]", reason);

	if(AntiSliv(playerid, "/kick")) return true;

	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, "дминистратор %s кикнул игрока %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));

	if(strlen(reason) > 0)
		format(fmt_msg, sizeof fmt_msg, "%s. ричина: %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "икнул %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	Kick(to_player);

	return 1;
}

CMD:skick(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /skick [id игрока]");

	if(!IsPlayerConnected(to_player)) return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");
	else if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "елз кикнут администратора вше по рангу");

	new fmt_msg[128];

	if(GetPlayerAdminEx(playerid) < 6)
	{
		format(fmt_msg, sizeof fmt_msg, "[A] дминистратор %s[%d] кикнул %s[%d] без лишнего шума", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
		SendMessageToAdmins(fmt_msg, 0x999999FF);
	}

	format(fmt_msg, sizeof fmt_msg, "ез шума кикнул %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	Kick(to_player);
	return 1;
}

CMD:mute(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 1) return 1;
	

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /mute [id игрока] [врем в минутах] [причина (необзателно)]");

	extract params -> new to_player, mute_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(1 <= mute_time <= 360)) return SendClientMessage(playerid, 0xCECECEFF, "рем должно бт не менше 1 и не болше 360 минут");
	if(GetPlayerData(to_player, P_MUTE) > 0) return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест мут");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, "елз поставит затчку администратору вше по рангу");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "елз поставит затчку самому себе");

	if(AntiSliv(playerid, "/mute")) return true;

	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, "дминистратор %s поставил затчку игроку %s на %d мин", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), mute_time);

	if(strlen(reason))
		format(fmt_msg, sizeof fmt_msg, "%s. ричина: %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SetPlayerData(to_player, P_MUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "mute", mute_time * 60);

	SendClientMessage(to_player, 0xCECECEFF, "рем до окончани бана чата: {CCCC00}/time");

	format(fmt_msg, sizeof fmt_msg, "дал %s[acc:%d] блокировку чата на %d мин. ричина: %s",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time, reason);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:unmute(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 1) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /unmute [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	else if(GetPlayerData(to_player, P_MUTE) <= 0) return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет мута");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "елз снт затчку с самого себ");

	new fmt_msg[80];
	format(fmt_msg, sizeof fmt_msg, "дминистратор %s снл затчку с игрока %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));
	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SetPlayerData(to_player, P_MUTE, 0);
	UpdatePlayerDatabaseInt(to_player, "mute", 0);

	SendClientMessage(to_player, 0x66CC00FF, "оступ в чат восстановлен");

	format(fmt_msg, sizeof fmt_msg, "нл блокировку чата у %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:jail(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 1) return 1;
	

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /jail [id игрока] [врем в минутах] [причина (необзателно)]");

	extract params -> new to_player, jail_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(1 <= jail_time <= 360)) return SendClientMessage(playerid, 0xCECECEFF, "рем должно бт не менше 1 и не болше 360 минут");
	if(GetPlayerData(to_player, P_JAIL) > 0) return SendClientMessage(playerid, 0xCECECEFF, "тот игрок уже сидит в тюрме");

	if(AntiSliv(playerid, "/jail")) return true;

	new fmt_msg[128];
	format(fmt_msg, sizeof fmt_msg, "дминистратор %s посадил в тюрму игрока %s на %d мин", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), jail_time);

	if(strlen(reason))
		format(fmt_msg, sizeof fmt_msg, "%s. ричина: %s", fmt_msg, reason);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SendClientMessage(to_player, 0xCECECEFF, "рем до окончани заключени: {CCCC00}/time");

	JailPlayer(to_player, jail_time);

	format(fmt_msg, sizeof fmt_msg, "осадил в тюрму %s[acc:%d] на %d мин. ричина: %s",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), jail_time, reason);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:unjail(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 1) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /unjail [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	else if(GetPlayerData(to_player, P_JAIL) <= 0) return SendClientMessage(playerid, 0xCECECEFF, "тот игрок не сидит в тюрме");
	//else if(to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "елз снт затчку с самого себ");

	new fmt_msg[80];
	format(fmt_msg, sizeof fmt_msg, "дминистратор %s впустил из тюрм игрока %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));
	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SendClientMessage(to_player, 0x66CC00FF, " бли впущен на свободу");

	UnjailPlayer(to_player);

	format(fmt_msg, sizeof fmt_msg, "пустил из тюрм %s[acc:%d]", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player));
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}
CMD:getcam(playerid, params[])
{
						new
                        Float:fPX, Float:fPY, Float:fPZ,
                        Float:fVX, Float:fVY, Float:fVZ,
                        Float:object_x, Float:object_y, Float:object_z;

		                const
		                Float:fScale = 5.0;

		                GetPlayerCameraPos(playerid, fPX, fPY, fPZ);
		                GetPlayerCameraFrontVector(playerid, fVX, fVY, fVZ);

		                object_x = fPX + floatmul(fVX, fScale);
		                object_y = fPY + floatmul(fVY, fScale);
		                object_z = fPZ + floatmul(fVZ, fScale);

		                format(sctring, sizeof(sctring), "CameraPos: %f,%f,%f | LookAt: %f,%f,%f",fPX,fPY,fPZ,object_x,object_y,object_z);
		                print(sctring);
		                SendClientMessage(playerid, -1, sctring);
						return 1;
}
CMD:ban(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 3) 
        return SendClientMessage(playerid, 0x999999FF, " вас недостаточно прав");

    new target[24], days, reason[128], targetid = -1;
    
    // арсим параметр: /ban [ник или id] [дни] [причина]
    if(sscanf(params, "s[24]ds[128]", target, days, reason))
        return SendClientMessage(playerid, 0x999999FF, "сползуйте: /ban [ник или id] [дни] [причина]");
    
    if(days < 1 || days > 365)
        return SendClientMessage(playerid, 0x999999FF, "ни должн бт от 1 до 365");
    
    // робуем найти игрока по ID
    if(IsNumeric(target))
    {
        targetid = strval(target);
        if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
            targetid = -1;
    }
    
    new account_id = -1;
    new player_name[24];
    
    // сли игрок онлайн - берем его данне
    if(targetid != -1 && IsPlayerConnected(targetid) && IsPlayerLogged(targetid))
    {
        account_id = GetPlayerAccountID(targetid);
        format(player_name, sizeof(player_name), "%s", GetPlayerNameEx(targetid));
        
        // икаем игрока
        SendClientMessage(targetid, 0xFF0000FF, " бли забанен на сервере!");
        SetTimerEx("KickPlayerAfterBan", 1000, false, "i", targetid);
    }
    else
    {
        // щем в оффлайне по нику
        new query[128], Cache: result;
        mysql_format(mysql, query, sizeof query, "SELECT id, name FROM accounts WHERE name='%s' LIMIT 1", target);
        result = mysql_query(mysql, query, true);
        
        if(cache_num_rows(result))
        {
            account_id = cache_get_field_content_int(0, "id");
            cache_get_field_content(0, "name", player_name, mysql, sizeof(player_name));
        }
        cache_delete(result);
        
        if(account_id == -1)
            return SendClientMessage(playerid, 0x999999FF, "грок с таким ником не найден");
    }
    
    // роверем, не забанен ли уже
    new check_query[128], Cache: check_result;
    mysql_format(mysql, check_query, sizeof check_query, "SELECT id FROM ban_list WHERE user_id=%d AND ban_time > %d LIMIT 1", account_id, gettime());
    check_result = mysql_query(mysql, check_query, true);
    
    if(cache_num_rows(check_result))
    {
        cache_delete(check_result);
        return SendClientMessage(playerid, 0x999999FF, "тот игрок уже забанен!");
    }
    cache_delete(check_result);
    
    // обавлем бан
    new query[512];
    new time = gettime();
    new unban_time = time + (days * 86400);
    new admin_name[24];
    format(admin_name, sizeof(admin_name), "%s", GetPlayerNameEx(playerid));
    
    mysql_format(mysql, query, sizeof query,
        "INSERT INTO ban_list (user_id, time, ban_time, ip, description, admin, admin_name, player_name, unban_date) \
        VALUES (%d, %d, %d, '%s', '%s', '%s', '%s', '%s', %d)",
        account_id,
        time,
        unban_time,
        "0.0.0.0", // л оффлайн бана
        reason,
        admin_name,
        admin_name,
        player_name,
        unban_time
    );
    mysql_query(mysql, query, false);
    
    // огируем в консол
    new log_msg[256];
    format(log_msg, sizeof(log_msg), "[BAN] %s[%d] забанил %s (ID: %d) на %d дней. ричина: %s", 
        admin_name, playerid, player_name, account_id, days, reason);
    print(log_msg);
    
    // ообщение в чат
    new msg[256];
    format(msg, sizeof(msg), "[A] %s[%d] забанил %s на %d дней. ричина: %s", 
        admin_name, playerid, player_name, days, reason);
    SendMessageToAdmins(msg, 0x999999FF);
    
    // сли игрок онлайн - показваем ему сообщение
    if(targetid != -1 && IsPlayerConnected(targetid))
    {
        new ban_msg[256];
        format(ban_msg, sizeof(ban_msg), 
            "{FF0000}ас забанил администратор %s на %d дней!\n\
            {FFFFFF}ричина: {FF9900}%s\n\
            {FFFFFF}ата разблокировки: {FF9900}%s",
            admin_name, days, reason, Date(unban_time));
        SendClientMessage(targetid, 0xFF0000FF, ban_msg);
        ShowPlayerDialog(targetid, 0, DIALOG_STYLE_MSGBOX, "{FF0000} забанен!", ban_msg, "", "");
    }
    
    return 1;
}

CMD:unban(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 3)
        return SendClientMessage(playerid, 0x999999FF, " вас недостаточно прав");
    
    new name[24];
    if(sscanf(params, "s[24]", name))
        return SendClientMessage(playerid, 0x999999FF, "сползуйте: /unban [ник]");
    
    // щем игрока в базе
    new query[128], Cache: result;
    mysql_format(mysql, query, sizeof query, "SELECT id FROM accounts WHERE name='%s' LIMIT 1", name);
    result = mysql_query(mysql, query, true);
    
    if(!cache_num_rows(result))
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0x999999FF, "грок с таким ником не найден");
    }
    
    new account_id = cache_get_field_content_int(0, "id");
    cache_delete(result);
    
    // роверем ест ли бан
    mysql_format(mysql, query, sizeof query, "SELECT id, ban_time FROM ban_list WHERE user_id=%d AND ban_time > %d LIMIT 1", account_id, gettime());
    result = mysql_query(mysql, query, true);
    
    if(!cache_num_rows(result))
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0x999999FF, "тот игрок не забанен");
    }
    
    // далем бан
    mysql_format(mysql, query, sizeof query, "DELETE FROM ban_list WHERE user_id=%d", account_id);
    mysql_query(mysql, query, false);
    cache_delete(result);
    
    new msg[256];
    format(msg, sizeof(msg), "[A] %s[%d] разбанил игрока %s", GetPlayerNameEx(playerid), playerid, name);
    SendMessageToAdmins(msg, 0x999999FF);
    
    SendClientMessage(playerid, 0x66CC33FF, "ан успешно снт!");
    return 1;
}

CMD:banlist(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 1)
        return SendClientMessage(playerid, 0x999999FF, " вас недостаточно прав");
    
    new query[128], Cache: result;
    mysql_format(mysql, query, sizeof query, 
        "SELECT player_name, admin_name, description, ban_time, unban_date FROM ban_list WHERE ban_time > %d ORDER BY id DESC LIMIT 50", 
        gettime());
    result = mysql_query(mysql, query, true);
    
    new rows = cache_num_rows();
    if(!rows)
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0x999999FF, "писок банов пуст");
    }
    
    new dialog_text[2048];
    format(dialog_text, sizeof(dialog_text), 
        "{FF8A8A}грок\t{FF8A8A}дмин\t{FF8A8A}ричина\t{FF8A8A}азбан\n{FFFFFF}");
    
    for(new i = 0; i < rows && i < 20; i++)
    {
        new player[24], admin[24], reason[64], unban_str[32];
        cache_get_field_content(i, "player_name", player, mysql, sizeof(player));
        cache_get_field_content(i, "admin_name", admin, mysql, sizeof(admin));
        cache_get_field_content(i, "description", reason, mysql, sizeof(reason));
        
        new unban_time = cache_get_field_content_int(i, "unban_date");
        format(unban_str, sizeof(unban_str), "%s", Date(unban_time));
        
        format(dialog_text, sizeof(dialog_text), "%s%s\t%s\t%s\t%s\n", 
            dialog_text, player, admin, reason, unban_str);
    }
    
    cache_delete(result);
    
    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, 
        "{FF8A8A}писок банов (последние 50)",
        dialog_text,
        "акрт", "");
    
    return 1;
}

CMD:setskin(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new to_player, skin_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /setskin [id игрока] [id скина]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");
	if(TEST_SERVER == 1)
	{
	    if(playerid != to_player) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анную команду можно исползоват на   толко по отношению к себе!");
	}

	if(GetPlayerTeamEx(to_player)) return SendClientMessage(playerid, 0xCECECEFF, "елз сменит скин игроку, находщемус в организации");

	if(!(1 <= skin_id <= 200000)) return SendClientMessage(playerid, 0xCECECEFF, "еверна модел скина");


	SetPlayerData(to_player, P_SKIN, skin_id);
	UpdatePlayerDatabaseInt(to_player, "skin", skin_id);

	SetPlayerSkinInit(to_player);

	new fmt_text[100];

	format(fmt_text, sizeof fmt_text, "дминистратор %s установил ам скин №%d", GetPlayerNameEx(playerid), skin_id);
	SendClientMessage(to_player, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, " установили игроку %s скин №%d", GetPlayerNameEx(to_player), skin_id);
	SendClientMessage(playerid, -1, fmt_text);
	{
		format(fmt_text, sizeof fmt_text, "[A] %s[%d] установил %s[%d] скин №%d", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, skin_id);
		SendMessageToAdmins(fmt_text, 0xCECECEFF);
	}

	format(fmt_text, sizeof fmt_text, "становил %s[acc:%d] скин %d", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), skin_id);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:offban(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /offban [ник игрока] [кол-во дней] [причина (необзателно)]");

	extract params -> new string: player_name[21], days, string: reason[30];

	if(!(1 <= days <= 365)) return SendClientMessage(playerid, 0x999999FF, "оличество дней от 1 до 365");

	if(IsPlayerConnected(GetPlayerID(player_name))) return SendClientMessage(playerid, 0x999999FF, "грок с таким именем находитс на сервере");

	new query[144],
		Cache: result,
		rows,
		uid,
		admin,
		uip[16];

	mysql_format(mysql, query, sizeof query, "SELECT id, admin, last_ip FROM accounts WHERE name='%s'", player_name);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	if(rows)
	{
		uid = cache_get_row_int(0, 0);
		admin = cache_get_row_int(0, 1);
		cache_get_row(0, 2, uip);
	}

	cache_delete(result);

	if(!rows || !uid) return SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден");

	if(GetPlayerAdminEx(playerid) < admin) return SendClientMessage(playerid, 0x999999FF, "елз забанит администратора вше по рангу");

	mysql_format(mysql, query, sizeof query, "SELECT * FROM ban_list WHERE user_id=%d", uid);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	cache_delete(result);

	if(rows) return SendClientMessage(playerid, 0x999999FF, "ккаунт игрока уже заблокирован");

	if(AntiSliv(playerid, "/offban")) return true;

	format(query, sizeof query, "дминистратор %s забанил оффлайн игрока %s на %d дней", GetPlayerNameEx(playerid), player_name, days);

	if(strlen(reason) > 0)
		format(query, sizeof query, "%s. ричина: %s", query, reason);

	if(!strlen(reason)) reason = "None";

	SendClientMessageToAll(0xFF5533FF, query);

	format(query, sizeof query, "ффлайн забанил %s[acc:%d] на %d дней. ричина: %s", player_name, uid, days, reason);
	SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, query);

	format(reason, sizeof reason, "[OFFLINE]%s", reason);

	AddBan(uid, gettime(), days, uip, reason, GetPlayerNameEx(playerid));

	return 1;
}

CMD:delacc(playerid, params[])
{
    if(TEST_SERVER == 1) 
        return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
    
    if(GetPlayerAdminEx(playerid) < 6) 
        return SendClientMessage(playerid, 0x999999FF, " вас недостаточно прав!");

    new name[24], reason[128];
    if(sscanf(params, "s[24]s[128]", name, reason))
        return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /delacc [им игрока] [причина]");

    new target_id = GetPlayerID(name);
    new account_id = -1;
    new target_name[24];
    
    // ===== Я  =====
    if(target_id != INVALID_PLAYER_ID && IsPlayerLogged(target_id))
    {
        // грок онлайн - получаем его данне
        account_id = GetPlayerAccountID(target_id);
        format(target_name, sizeof(target_name), "%s", GetPlayerNameEx(target_id));
        
        // роверем, не админ ли это вше рангом
        if(GetPlayerAdminEx(target_id) > GetPlayerAdminEx(playerid))
        {
            return SendClientMessage(playerid, 0x999999FF, " не можете удалит аккаунт администратора вше ас рангом!");
        }
        
        // роверем, не удалет ли админ сам себ
        if(target_id == playerid)
        {
            Dialog
            (
                playerid, 9996, DIALOG_STYLE_MSGBOX,
                "{FF0000}!",
                "{FFFFFF} птаетес удалит  аккаунт!\n\
                то действие !\n\n\
                {FF0000}се данне будут потерн навсегда!\n\n\
                {FFFFFF} уверен, что хотите удалит свой аккаунт?",
                ", ", "тмена"
            );
            SetPVarInt(playerid, "delacc_self", 1);
            SetPVarString(playerid, "delacc_reason", reason);
            return 1;
        }
        
        // оказваем подтверждение дл онлайн игрока
        new dialog_text[512];
        format(dialog_text, sizeof(dialog_text),
            "{FF0000}!  собираетес удалит аккаунт:\n\n\
            {FFFFFF}грок: {FF9900}%s[%d]\n\
            {FFFFFF}ID аккаунта: {FF9900}%d\n\
            {FFFFFF}ричина: {FF9900}%s\n\n\
            {FF0000}то действие !\n\
            се данне игрока будут потерн навсегда!\n\n\
            {FFFFFF}грок будет кикнут с сервера.",
            target_name, target_id, account_id, reason);
        
        Dialog
        (
            playerid, 9995, DIALOG_STYLE_MSGBOX,
            "{FF0000}даление аккаунта",
            dialog_text,
            "", "тмена"
        );
        
        SetPVarInt(playerid, "delacc_target", target_id);
        SetPVarInt(playerid, "delacc_account", account_id);
        SetPVarString(playerid, "delacc_reason", reason);
        SetPVarString(playerid, "delacc_name", target_name);
        
        return 1;
    }
    
    // =====   -    =====
    new query[256], Cache:result;
    mysql_format(mysql, query, sizeof query, 
        "SELECT id, admin, name FROM accounts WHERE name='%e' LIMIT 1", name);
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        account_id = cache_get_field_content_int(0, "id");
        new admin_level = cache_get_field_content_int(0, "admin");
        cache_get_field_content(0, "name", target_name, mysql, sizeof(target_name));
        
        cache_delete(result);
        
        // роверем, не админ ли это вше рангом
        if(admin_level > GetPlayerAdminEx(playerid))
        {
            return SendClientMessage(playerid, 0x999999FF, " не можете удалит аккаунт администратора вше ас рангом!");
        }
        
        // оказваем подтверждение дл оффлайн игрока
        new dialog_text[512];
        format(dialog_text, sizeof(dialog_text),
            "{FF0000}!  собираетес удалит аккаунт:\n\n\
            {FFFFFF}грок: {FF9900}%s\n\
            {FFFFFF}ID аккаунта: {FF9900}%d\n\
            {FFFFFF}ричина: {FF9900}%s\n\n\
            {FF0000}то действие !\n\
            се данне игрока будут потерн навсегда!",
            target_name, account_id, reason);
        
        Dialog
        (
            playerid, 9994, DIALOG_STYLE_MSGBOX,
            "{FF0000}даление аккаунта (оффлайн)",
            dialog_text,
            "", "тмена"
        );
        
        SetPVarInt(playerid, "delacc_account", account_id);
        SetPVarString(playerid, "delacc_reason", reason);
        SetPVarString(playerid, "delacc_name", target_name);
        SetPVarInt(playerid, "delacc_offline", 1);
        
        return 1;
    }
    
    cache_delete(result);
    return SendClientMessage(playerid, 0x999999FF, "грок с таким именем не найден!");
}

CMD:skin(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 3) return 1;

	extract params -> new to_player, skin_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /skin [id игрока] [id скина]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");
	if(TEST_SERVER == 1)
	{
	    if(playerid != to_player) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анную команду можно исползоват на   толко по отношению к себе!");
	}

	if(!(-1 <= skin_id <= 200000) || skin_id == 0) return SendClientMessage(playerid, 0x999999FF, "еверна модел скина");

	if(skin_id != -1)
		SetPlayerSkin(to_player, skin_id);
	else
		SetPlayerSkin(to_player, GetPlayerSkinEx(to_player));

	new fmt_text[100];

	format(fmt_text, sizeof fmt_text, "дминистратор %s вдал ам %s скин", GetPlayerNameEx(playerid), skin_id != -1 ? "временнй" : "прежний");
	SendClientMessage(to_player, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, " вдали игроку %s %s скин", GetPlayerNameEx(to_player), skin_id != -1 ? "временнй" : "прежний");
	SendClientMessage(playerid, -1, fmt_text);

	if(GetPlayerAdminEx(playerid) <= 5)
	{
		if(skin_id != -1)
			format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] вдал %s[%d] скин №%d", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, skin_id);
		else
			format(fmt_text, sizeof fmt_text, "[A] дминистратор %s[%d] вдал %s[%d] прежний скин", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
		SendMessageToAdmins(fmt_text, 0x999999FF);
	}

	format(fmt_text, sizeof fmt_text, "дал %s[acc:%d] скин %d", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), skin_id);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

CMD:house(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new house_id; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /house [номер дома]");

	if(!(0 <= house_id <= g_house_loaded-1)) return SendClientMessage(playerid, 0xCECECEFF, "анного дома не существует на сервере");

	new Float: x,
		Float: y,
		Float: z,
		Float: angle;

	if(GetHouseData(house_id, H_ENTRACE) != -1)
	{
		EnterPlayerToEntrance(playerid, GetHouseData(house_id, H_ENTRACE));

		x = GetHouseData(house_id, H_POS_X);
		y = GetHouseData(house_id, H_POS_Y);
		z = GetHouseData(house_id, H_POS_Z);
	}
	else
	{
		x = GetHouseData(house_id, H_EXIT_POS_X);
		y = GetHouseData(house_id, H_EXIT_POS_Y);
		z = GetHouseData(house_id, H_EXIT_POS_Z);
		angle = GetHouseData(house_id, H_EXIT_ANGLE);
	}
	SetPlayerPosEx(playerid, x, y, z, angle);

	new fmt_text[35];

	format(fmt_text, sizeof fmt_text, " телепортировалис к дому №%d", house_id);
	SendClientMessage(playerid, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, "елепортировалс к дому %d", house_id);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);

	return 1;
}

