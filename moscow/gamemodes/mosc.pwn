public: ShowFamilyAllPlayers(playerid)
{
    new rows = cache_num_rows();

    new p_name[21];
    new lvl, family_rank;

    new fmt_str[33];
    new text[1290] = "ровен\tанг\tм\n\n{FFFFFF}";

    new idx, j = rows;
    if(j > 45)
        j = 45;

    for(idx = 0; idx < j; idx ++)
    {
        cache_get_row(idx, 0, p_name);
        lvl = cache_get_row_int(idx, 1);
        family_rank = cache_get_row_int(idx,2);

        format(fmt_str, sizeof fmt_str, "%d\t%d\t%s\n", lvl, family_rank, p_name);
        strcat(text, fmt_str);
    }

    format(fmt_str, sizeof fmt_str, "оказан %d/%d игроков", idx, rows);
    Dialog(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, fmt_str, text, "акрт", "");
    return 1;
}
