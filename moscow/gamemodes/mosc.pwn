new driving_tutorial[4][E_DRIVING_TUTORIAL_STRUCT] =
{
	{
		"правление системами автомобил",
		"{669900}иже приведен перечен клавиш управлени транспортом и их описание:\n\n"\
		"{3399FF}евй Ctrl\t{FFFFFF}завести или заглушит двигател\n"\
		"{3399FF}евй Alt\t{FFFFFF}включит или включит фар\n"\
		"{3399FF}равй Ctrl\t{FFFFFF}открт или закрт машину {9966FF}(толко дл домашней машин)\n"\
		"{3399FF}Num 4\t\t{FFFFFF}включит или включит ограничител скорости\n"\
		"{3399FF}Num 8\t\t{FFFFFF}управление капотом и багажником {9966FF}(если они имеютс у данной модели)\n"\
		"{3399FF}Num 2\t\t{FFFFFF}заправит транспорт {9966FF}(подробнее в следующих разделах)\n\n"\
		"{FFFF00}остарайтес запомнит назначени клавиш управлени\n"\
		"огда будете готов нажмите \"алее\""
	},
	{
		"анел индикаторов",
		"{FFFFFF}анел индикаторов повлетс в правом нижнем углу экрана как толко в заходите в любой транспорт\n"\
		"на информирует водител о его текущем состонии. так, рассмотрим основне элемент этой панели:\n\n"\
		"\t{3366FF}25 km/h  {00CCFF}Fuel: 45  {006699}1000\n"\
		"\t{00CC00}Open  {FF3300}max  {FFFFFF}E {009933}S   M {FFFFFF}L B\n\n"\
		"{FFFF00}а первой строчке панели находтс числове индикатор:\n"\
		"{3366FF}25 km/h\t{FFFFFF}показвает текущую скорост транспорта\n"\
		"{00CCFF}Fuel: 45\t{FFFFFF}показвает количество бензина в баке\n"\
		"{006699}1000\t\t{FFFFFF}показвает \"здорове\" транспорта. сли у него нет повреждений, то оно будет равно 1000\n\n"\
		"{FFFF00}а второй строчке находтс цветове индикатор:\n"\
		"{00CC00}Open\t\t{FFFFFF}(или {FF3300}Close{FFFFFF}) показвают открт или закрт транспорт\n"\
		"{FF3300}max\t\t{FFFFFF}загораетс краснм при включенном ограничителе скорости\n"\
		"E\t\tзагораетс краснм при низком уровне бензина в баке\n"\
		"{CC99CC}S\t\t{FFFFFF}загораетс пурпурнм при включенной сигнализации\n"\
		"{009933}M\t\t{FFFFFF}индикатор включенного двигател\n"\
		"L\t\tиндикатор включенного света фар\n"\
		"B\t\tзагораетс краснм при откртом багажнике или капоте\n\n"\
		"{9966FF}римечани:\n"\
		"1. анел индикаторов обновлетс раз в секунду\n"\
		"2. ключенне индикатор во втором рду {FFFFFF}белого {9966FF}цвета"
	},
	{
		"аправка и ремонт",
		"{FFFFFF}ранспорт врем от времени необходимо заправлт. делат это можно двум способами:\n\n"\
		"{FFFF00}1. а заправочной станции\n"\
		"{FFFFFF}л этого подъедте к ней и нажмите {3366FF}Num 2{FFFFFF}. аждое нажатие заправлет ваш транспорт на 10 литров\n\n"\
		"{FFFF00}2. аправка с канистр\n"\
		"{FFFFFF}акой способ подойдет если автомобил не может ездит из-за отсутстви бензина\n"\
		"айдите ближайшую заправку и напишите {3366FF}/buyfuel{FFFFFF}.  получите канистру емкостю 15 литров\n"\
		"осле этого просто подойдите к транспорту, которй хотите заправит. 15 литров вполне хватит чтоб доехат до ближайшей заправки\n\n"\
		"{66CCCC}олезне совет:\n"\
		"1. ензобак может вместит максимум 150 литров бензина. то хватит на 50 минут беспрервной работ двигател\n"\
		"2. сегда включайте двигател когда входите из машин или долго стоите на месте! тим в намного уменшите расход бензина\n"\
		"3. тоб не бежат за канистрой бензина если бензобак опустел можно взват механика (/c)\n\n"\
		"{99CC66}очинит транспорт можно в любом покрасочном салоне либо взвав механика (/c)\n"\
		"братите внимание, что если купленнй или арендованнй вами транспорт взорветс, то придетс покупат или арендоват его заново!"
	},
	{
		"равила дорожного движени",
		"{66CC00}1. бщие положени\n"\
		"{FFFFFF}бгон транспортнх средств разрешен толко с левой сторон\n"\
		"ри этом водител должен убедитс что встречна полоса свободна на достаточном дл обгона расстонии\n"\
		"ри  водителм рекомендуетс взват полицию (/c) и дождатс приезда \n"\
		"{66CC00}2. корост движени\n"\
		"{FFFFFF}граничение скорости движени в пределах городов и поселков 50 км/ч\n"\
		"а пределами населеннх пунктов ограничений скорости нет\n"\
		"л соблюдени скоростного режима рекомендуетс ползоватс ограничителем скорости, которй включаетс клавишей {3366FF}Num 4\n"\
		"{66CC00}3. становка и стонка\n"\
		"{FFFFFF}становка и стонка транспортнх средств разрешаетс толко на обочине дороги или в специално отведеннх дл этого местах\n"\
		"а нарушение этого правила ваш автомобил может бт отправлен на штрафстонку\n"\
		"{66CC00}4. \n"\
		"{FFFFFF}ри виде автомобил с включенной сиреной водител обзан снизит скорост и прижатс к обочине\n"\
		"одител обзан предъвит работнику  документ, которе он попросит"
	}
};

