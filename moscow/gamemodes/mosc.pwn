CMD:rub(playerid)
{
	if(!GetPlayerAdminEx(playerid))
	{
		new status;
		status = (GetPlayerData(playerid, P_GET_RUB) ^ VEHICLE_PARAM_ON);

		SetPlayerData(playerid, P_GET_RUB, status);

		format(stringer, sizeof(stringer), "{FF9A30} успешно %s функцию '+%d руб каждй час'", GetPlayerData(playerid, P_GET_RUB) ? ("{32CD32}включили{FFFFFF}") : ("{FF0000}включили{FFFFFF}"), Config[sDistRub]);
