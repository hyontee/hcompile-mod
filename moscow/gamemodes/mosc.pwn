if(dialogid == 5000) // 
    {
        if(!response) return 1;

        new target_id = GetPVarInt(playerid, "spec_target_for_warn");
        DeletePVar(playerid, "spec_target_for_warn");

        if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            return ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");

        new reason[66];
        format(reason, sizeof(reason), "%s", inputtext);
        if(!strlen(reason)) reason = "е указана";

        // зов команд warn
        new params[128];
        format(params, sizeof(params), "%d %s", target_id, reason);
        callcmd::warn(playerid, params);

        return 1;
    }

    if(dialogid == 5001) //  -> во причина
    {
        if(!response) return 1;

        new target_id = GetPVarInt(playerid, "spec_target_for_mute");
        DeletePVar(playerid, "spec_target_for_mute");

        if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            return ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");

        new reason_time[128];
        format(reason_time, sizeof(reason_time), "%s", inputtext);
        if(!strlen(reason_time))
            return ShowNotificationNew(playerid, 2, 5, -1, -1, " не ввели причину и врем.", "");

        // оптка распарсит врем (минут)
        new minutes = 5;
        new reason[64];
        if(sscanf(reason_time, "d s[64]", minutes, reason))
        {
            // сли не удалос распарсит как "число причина", исползуем вес текст как причину и врем по умолчанию
            format(reason, sizeof(reason), "%s", reason_time);
            minutes = 5;
        }

        if(minutes < 1 || minutes > 360) minutes = 5;

        new params[128];
        format(params, sizeof(params), "%d %d %s", target_id, minutes, reason);
        callcmd::mute(playerid, params);

        return 1;
    }

    if(dialogid == 5002) //  -> сновное меню
    {
        if(!response) return 1;

        new target_id = GetPVarInt(playerid, "spec_target_for_mute");
        if(target_id == -1) return 1;
        DeletePVar(playerid, "spec_target_for_mute");

        if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            return ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");

        new minutes, reason[64];
        switch(listitem)
        {
            case 0: { minutes = 10; reason = "CAPS"; }
            case 1: { minutes = 30; reason = "скорбление роднх"; }
            case 2: { // во причина
                Dialog
                (
                    playerid, 5001, DIALOG_STYLE_INPUT,
                    "{FF5A5A}дмин меню |{FFFFFF} вод наказани",
                    "{FFFFFF}ведите причину и врем мута в формате:\n{FFFF00}рем(в минутах) ричина\n\n{FFFFFF}ример: {FFFF00}60 скорбление администрации",
                    "дат", "тмена"
                );
                SetPVarInt(playerid, "spec_target_for_mute", target_id);
                return 1;
            }
            default: return 1;
        }

        new params[128];
        format(params, sizeof(params), "%d %d %s", target_id, minutes, reason);
        callcmd::mute(playerid, params);

        return 1;
    }

