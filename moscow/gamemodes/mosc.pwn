                notify_id = NOTIFY_OFFER_CASINO_DICE;
                SendClientMessage(playerid, 0x3399FFFF, " предложили %s сграт в кости. тавка: %d руб", 
                    GetPlayerNameEx(to_player), value_1);
            }
            case OFFER_TYPE_GETHERE:
            {
                format(fmt_text, sizeof fmt_text, "%s хочет телепортироват ас к себе", 
                    GetPlayerNameEx(playerid));
                notify_id = NOTIFY_OFFER_GETHERE;
                SendClientMessage(playerid, 0x3399FFFF, " запросили у %s разрешение на телепорт", 
                    GetPlayerNameEx(to_player));
            }
            case OFFER_TYPE_GIVE_CAR_KEY:
