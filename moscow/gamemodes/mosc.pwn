CMD:dl(playerid)
{
    if(GetPlayerAdminEx(playerid) <= 0) return 0;
    
	new info[34], 
	Float:x,
	Float:y,
	Float:z, 
	count = GetVehiclePoolSize() + 1;
	
	if(!(DebugPlayer[playerid]))
	{
		SendClientMessage(playerid, -1, ""SC" одождите, загружаетс инофрмаци...");
		DebugPlayer[playerid] = true;

		for(new i = 1; i < count; i++)
		{
			GetVehiclePos(i, x, y, z);
			format(info, sizeof info, "VEH ID:%d \n MODEL ID:%d", i, GetVehicleModel(i));
			Veh_3DTEXT[playerid][i] =  CreateDynamic3DTextLabel(info, 0xFFFFFFFF, x, y, z + 1.0, 20.0, _, i, 0, -1, -1, playerid);
		}
	}
	else
	{	
		SendClientMessage(playerid, -1, ""USC"  включили отображение информации о транспорте");
		DebugPlayer[playerid] = false;	
		for(new i = 1; i < count; i++)
		{
			DestroyDynamic3DTextLabel(Veh_3DTEXT[playerid][i]);
			Veh_3DTEXT[playerid][i] = Text3D:0;
		}

	}
	return 1;
}

stock YouTubeAuthorization(playerid)
{
    if(!GetPlayerData(playerid, P_YOUTUBE) || GetPlayerData(playerid, P_YT_LOGGED))
        return 0;
    
    // роверем наличие парол в базе
    new query[128], Cache:result;
    mysql_format(mysql, query, sizeof query, "SELECT `yt_password` FROM `accounts` WHERE `id`=%d LIMIT 1", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        new db_password[32];
        cache_get_field_content(0, "yt_password", db_password, sizeof db_password);
        cache_delete(result);
        
        if(strlen(db_password) > 0)
        {
            // арол установлен - показваем окно входа
            Dialog(playerid, DIALOG_YT_LOGIN, DIALOG_STYLE_PASSWORD, 
                "{00FFFF}туберска панел", 
                "{FFFFFF} вошли как ютубер сервера\nведите парол от ютуберской панели в поле ниже", 
                "ойти", "ход");
        }
        else
        {
            // арол нет - показваем окно регистрации
            Dialog(playerid, DIALOG_YT_REG, DIALOG_STYLE_PASSWORD, 
                "{00FFFF}егистраци в ютуберской панели", 
                "{FFFFFF}ридумайте парол из 4-х цифр дл доступа к ютуберской панели\nведите его в поле ниже:\n", 
                "алее", "ход");
        }
    }
    else
    {
        cache_delete(result);
        // а вский случай показваем регистрацию
        Dialog(playerid, DIALOG_YT_REG, DIALOG_STYLE_PASSWORD, 
            "{00FFFF}егистраци в ютуберской панели", 
            "{FFFFFF}ридумайте парол из 4-х цифр дл доступа к ютуберской панели\nведите его в поле ниже:\n", 
            "алее", "ход");
    }
    return 1;
}

CMD:offsetyt(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    extract params -> new string:player_name[24]; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /offsetyt [ник игрока]");
    
    if(IsPlayerConnected(GetPlayerID(player_name)))
        return SendClientMessage(playerid, 0xCECECEFF, "грок с таким именем находитс на сервере. сползуйте /setyt [id]");
    
    // щем игрока в 
    new query[256], Cache:result, rows, uid, youtube_status;
    mysql_format(mysql, query, sizeof query, "SELECT `id`, `youtube` FROM `accounts` WHERE `name`='%e' LIMIT 1", player_name);
    result = mysql_query(mysql, query, true);
    rows = cache_num_rows();
    
    if(rows)
    {
        uid = cache_get_field_content_int(0, "id");
        youtube_status = cache_get_field_content_int(0, "youtube");
        
        if(youtube_status)
        {
            cache_delete(result);
            return SendClientMessage(playerid, 0xCECECEFF, " этого игрока уже ест ютуберска админка");
        }
        
        // даем ютуберку
        mysql_format(mysql, query, sizeof query, 
            "UPDATE `accounts` SET `youtube`=1, `yt_password`='' WHERE `id`=%d LIMIT 1", uid);
        mysql_query(mysql, query, false);
        
        cache_delete(result);
        
        new fmt_text[128];
        format(fmt_text, sizeof fmt_text, " вдали ютуберскую админку игроку %s [флайн]", player_name);
        SendClientMessage(playerid, 0x00FFFFFF, fmt_text);
        
        format(fmt_text, sizeof fmt_text, "[A] %s[%d] вдал игроку %s[acc:%d] ютуберскую админку [флайн]",
            GetPlayerNameEx(playerid), playerid, player_name, uid);
        SendMessageToAdmins(fmt_text, 0xFF5533FF);
        
        format(fmt_text, sizeof fmt_text, "дал офлайн %s[acc:%d] пост ютубера", player_name, uid);
        SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);
    }
    else
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0xCECECEFF, "грок с таким именем не найден");
    }
    
    return 1;
}

CMD:offdelyt(playerid, params[])
{
    if(TEST_SERVER == 1) return SendClientMessage(playerid, -1, "{ff2400}| {ffffff}анна команда не доступна на  !");
    if(GetPlayerAdminEx(playerid) < 6) return 1;
    
    extract params -> new string:player_name[24]; else return SendClientMessage(playerid, 0xCECECEFF, "{1E90FF}[одсказка]:{FFFFFF} /offdelyt [ник игрока]");
    
    if(IsPlayerConnected(GetPlayerID(player_name)))
        return SendClientMessage(playerid, 0xCECECEFF, "грок с таким именем находитс на сервере. сползуйте /delyt [id]");
    
    // щем игрока в 
    new query[256], Cache:result, rows, uid, youtube_status;
    mysql_format(mysql, query, sizeof query, "SELECT `id`, `youtube` FROM `accounts` WHERE `name`='%e' LIMIT 1", player_name);
    result = mysql_query(mysql, query, true);
    rows = cache_num_rows();
    
    if(rows)
    {
        uid = cache_get_field_content_int(0, "id");
        youtube_status = cache_get_field_content_int(0, "youtube");
        
        if(!youtube_status)
        {
            cache_delete(result);
            return SendClientMessage(playerid, 0xCECECEFF, " этого игрока нет ютуберской админки");
        }
        
        // нимаем ютуберку
        mysql_format(mysql, query, sizeof query, 
            "UPDATE `accounts` SET `youtube`=0, `yt_password`='' WHERE `id`=%d LIMIT 1", uid);
        mysql_query(mysql, query, false);
        
        cache_delete(result);
        
        new fmt_text[128];
        format(fmt_text, sizeof fmt_text, " забрали ютуберскую админку у игрока %s [флайн]", player_name);
        SendClientMessage(playerid, 0x00FFFFFF, fmt_text);
        
        format(fmt_text, sizeof fmt_text, "[A] %s[%d] забрал у игрока %s[acc:%d] ютуберскую админку [флайн]",
            GetPlayerNameEx(playerid), playerid, player_name, uid);
        SendMessageToAdmins(fmt_text, 0xFF5533FF);
        
        format(fmt_text, sizeof fmt_text, "абрал офлайн %s[acc:%d] пост ютубера", player_name, uid);
        SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, fmt_text);
    }
    else
    {
        cache_delete(result);
        return SendClientMessage(playerid, 0xCECECEFF, "грок с таким именем не найден");
    }
    
    return 1;
}

