CMD:mtop(playerid)
{
	new fmt_str[3000];
    format
	(
		fmt_str, sizeof fmt_str,
		""c_b"олучай онат-оин за игру на сервере!\n\
		\n\
		аждй месц топ 1 игроки будут получат вознаграждение, список вознаграждений\n\
		можно посмотрет с помощю команд: "c_s"/mpriz\n\
		"c_b"ак же, каждй месц список топ-игроков будет обнултс.\n\
		\n\
		"c_i"1. "c_b": аработаннх денег на началнх работах.\n\
		\tарабатва денги на началнх работах,  будете увеличиват прогресс данного этапа.\n\
		\t"c_i"писок работ: "c_b"рузчик, ахтер, авод, есоруб.\n\
		\n\
		"c_i"2. "c_b": аработаннх денег на гос. работах.\n\
		\tарабатва денги на гос. работах,  будете увеличиват прогресс данного этапа.\n\
		\t"c_i"писок работ: "c_b"одител автобуса, аксист, еханик.\n\
		\n\
		"c_i"3. "c_b": олученнх PayDay\n\
		\tаждй собраннй PayDay, ам будет прибавлт +1 к прогрессу данного этапа.\n\
		\t"c_i"нформаци: "c_b"PayDay происходит каждй час. апример в 11:00, 12:00\n\
		\n\
		"c_i"4. "c_b": полненнх достижений\n\
		\tполн достижени,  будете увеличиват прогресс данного этапа\n\
  		\t"c_s"/reward"c_b"- информаци о достижених и список достижений.\n\
  		\n\
		"c_i"5. "c_b": полненнх квестов\n\
		\tполн квест,  будете увеличиват прогресс данного этапа.\n\
		\t"c_s"/quest "c_b"- информаци о квестах и список квестов."
	);

	Dialog(playerid, DIALOG_MTOP, DIALOG_STYLE_MSGBOX, ""c_i": "c_b"нформаци", fmt_str, "алее", "акрт");
	return 1;
}

