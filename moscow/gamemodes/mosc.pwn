	CreateDynamic3DTextLabel("{FFFFFF}- онтейнер -\n{FFFFFF}ласс контейнера: {cd853f}ещевой\n{FFFFFF}ена контейнера: {cd853f}200.000.000 рублей\n{FFFFFF}ведите /vz чтоб открт", 0xFFFF00FF, 617.468688,1729.151977,12.078809 + 1.8, 10.0);

