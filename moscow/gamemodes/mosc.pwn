stock CompleteQuestLineReward(playerid, quest_id)
{
	if(!(1 <= quest_id <= 11)) return 1;
	if(GetQuestLineStatus(playerid, quest_id)) return 1;

	new quest_name[64],
		money = GetQuestLineRewardMoney(quest_id),
		exp = GetQuestLineRewardExp(quest_id),
		goal = GetQuestLineGoal(quest_id),
		fmt_msg[256],
		fmt_notify[128];

	SetQuestLineProgress(playerid, quest_id, goal);
	SetQuestLineStatus(playerid, quest_id, 1);

	GivePlayerMoneyEx(playerid, money, "полнение квеста");

	if(exp > 0)
	{
		AddPlayerData(playerid, P_EXP, +, exp);

		while(GetPlayerExp(playerid) >= GetExpToNextLevel(playerid))
		{
			AddPlayerData(playerid, P_EXP, -, GetExpToNextLevel(playerid));
			AddPlayerData(playerid, P_LEVEL, +, 1);
			SetPlayerLevelInit(playerid);
		}

		UpdatePlayerDatabaseInt(playerid, "exp", GetPlayerExp(playerid));
		UpdatePlayerDatabaseInt(playerid, "level", GetPlayerLevel(playerid));
	}

	AddPlayerData(playerid, P_TOP_5, +, 1);
	UpdatePlayerDatabaseInt(playerid, "TOP_Quest", GetPlayerData(playerid, P_TOP_5));

	GetQuestLineName(quest_id, quest_name, sizeof quest_name);

	format
	(
		fmt_msg,
		sizeof fmt_msg,
		"{808000}[вестова лини]:""{FFFFFF} успешно вполнили квест "c_i"'%s'. "c_b"аграда: "c_m"%d рублей и %d EXP",
		quest_name,
		money,
		exp
	);
	SendClientMessage(playerid, COR_SERVER, fmt_msg);

	format(fmt_notify, sizeof fmt_notify, " получили %d рублей и %d EXP", money, exp);
	ShowNotificationNew(playerid, 1, 5, -1, -1, fmt_notify, "");

	return 1;
}

stock AddQuestLineProgress(playerid, quest_id, amount = 1)
{
	if(!(1 <= quest_id <= 11)) return 1;
	if(GetQuestLineStatus(playerid, quest_id)) return 1;

	new progress = GetQuestLineProgress(playerid, quest_id) + amount,
		goal = GetQuestLineGoal(quest_id);

	if(progress > goal) progress = goal;

	SetQuestLineProgress(playerid, quest_id, progress);

	if(progress >= goal)
	{
		CompleteQuestLineReward(playerid, quest_id);
	}
	return 1;
}
stock ShowQuestLineInfo(playerid, quest_id)
{
	if(!(1 <= quest_id <= 15)) return 1;

	new quest_name[64],
		fmt_str[800],
		reward_text[96],
		dialog_title[110],
		progress = GetQuestLineProgress(playerid, quest_id),
		goal = GetQuestLineGoal(quest_id),
		money = GetQuestLineRewardMoney(quest_id),
		exp = GetQuestLineRewardExp(quest_id);

	if(GetQuestLineStatus(playerid, quest_id)) progress = goal;
	if(progress > goal) progress = goal;

	format(reward_text, sizeof reward_text, "%d рублей и %d EXP", money, exp);
	GetQuestLineName(quest_id, quest_name, sizeof quest_name);
	format(dialog_title, sizeof dialog_title, "{FFD700}вестова лини{FFFFFF} | %s", quest_name);

	switch(quest_id)
	{
		case 1:
		{
			format
			(
				fmt_str,
				sizeof fmt_str,
				""c_server"{FFFFFF}елики,  - это все потом.  пока...\n\n"\
				""c_server"ут задани: "c_b"перве арендоват скутер на вокзале\n"\
				""c_server"аграда за вполнение: "c_b"%s\n\n"\
				""c_server"рогресс вполнени: "c_b"%d/%d",
				reward_text,
				progress,
				goal
			);
		}
		case 2:
		{
			format
			(
				fmt_str,
				sizeof fmt_str,
				""c_server"{FFFFFF} братвой нужно бт на свзи. наче как просит в долг?\n\n"\
				""c_server"ут задани: "c_b"упит мобилнй телефон\n"\
				""c_server"аграда за вполнение: "c_b"%s\n"\
				""c_server"естоположение: "c_b"/gps > лижайшие места > лижайший 24/7\n\n"\
				""c_server"рогресс вполнени: "c_b"%d/%d",
				reward_text,
				progress,
				goal
			);
		}
		case 3:
		{
			format
			(
				fmt_str,
				sizeof fmt_str,
				""c_server"{FFFFFF} же не собираешс брат ик, да? а?...\n\n"\
				""c_server"ут задани: "c_b"тправитс в любой автосалон и приобрести себе транспорт\n"\
				""c_server"аграда за вполнение: "c_b"%s\n"\
				""c_server"естоположение: "c_b"/gps > втосалон\n\n"\
				""c_server"рогресс вполнени: "c_b"%d/%d",
				reward_text,
				progress,
				goal
			);
		}
		case 4:
		{
			format
			(
				fmt_str,
				sizeof fmt_str,
				""c_server"{FFFFFF}аже если тебе нравитс тво одежда, ради квеста придетс обновитс\n\n"\
				""c_server"ут задани: "c_b"тправитс в магазин одежд и приобрести новую одежду\n"\
				""c_server"аграда за вполнение: "c_b"%s\n"\
				""c_server"естоположение: "c_b"/gps > лижайшие места > агазин одежд\n\n"\
				""c_server"рогресс вполнени: "c_b"%d/%d",
				reward_text,
				progress,
				goal
			);
		}
		case 5:
		{
