					{
						if(GetPlayerMoneyEx(playerid) >= 600)
						{
							GivePlayerMoneyEx(playerid, -600, "дача на права");

							Dialog
							(
								playerid, DIALOG_DRIVING_EXAM_START, DIALOG_STYLE_MSGBOX,
								"{CCCC00}еоретическа част",
								"{FFFFFF}ам будет предложено 12 вопросов дл проверки теоретических знаний\n"\
								"тоб сдат эту част экзамена необходимо ответит минимум на 9 из них\n"\
								"сли правилнх ответов будет менше, то в не будете допущен до практический части\n\n"\
								"{33CCFF}а каждй вопрос будет несколко вариантов ответа, правилнй из которй толко один.\n"\
								" резултате в узнаете когда ответите на все вопрос",
								"алее", "тмена"
							);
							ClearPlayerDrivingExamInfo(playerid);
						}
						else ShowNotification(playerid, 2, "едостаточно средств | 600 руб.", 5, "", "");
