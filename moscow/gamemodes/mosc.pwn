CMD:buyslot(playerid)
{
						new fmt_text[80];

						if(GetPlayerDonateRub(playerid) < 100)
						{
						    ShowNotification(playerid, 2, "л покупки слота дл транспорта необходимо имет на счету 100 руб!", 4, "", "");
						}
						else
						{
							AddPlayerData(playerid, P_CAR_SLOTS, +, 1);
							UpdatePlayerDatabaseInt(playerid, "car_slots", GetPlayerData(playerid, P_CAR_SLOTS));

							GivePlayerDonateRub(playerid, -100, "окупка слота дл транспорта", true, true);

							format(fmt_text, sizeof fmt_text, ""SC" увеличили количество слотов дл транспорта. екущее количество слотов: {ffff00}%d", GetPlayerData(playerid, P_CAR_SLOTS));

							ShowNotification(playerid, 3, fmt_text, 4, "", "");
							UpdateDonate(playerid, GetPlayerMoney(playerid), GetPlayerDonateRub(playerid));
							show_sc(playerid, -1, -1);
						}
						
						return 1;
}
