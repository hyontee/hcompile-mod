stock ClearMedBed(playerid, bedid)
{
	if(GetPlayerData(playerid, P_OCCUPIED_BED) != -1)
	{
		SetPlayerData(playerid, P_OCCUPIED_BED, -1);
	}

	g_med_bed_used[bedid] = false;
	g_PlayerNearMedBedNotified[playerid] = -1;
	UpdateMedBed(bedid);

	return 1;
}

stock UpdateMedBed(bedid, bool:occupied = false)
{
	new fmt_text[192];

	if(occupied)
	{
		format(fmt_text, sizeof fmt_text, "{FFFF00}«анта болнична койка»\n\n{FFFFFF}омер койки{FFFF00}: №%d\n{FFFFFF}ациент{FFFF00}: \n\n", bedid + 1);
	}
	else
	{
		format(fmt_text, sizeof fmt_text, "{FFFF00}«вободна болнична койка»\n\n{FFFFFF}омер койки{FFFF00}: №%d\n{FFFFFF}ациент{FFFF00}: отсутствует\n\n{FFFFFF}одойдите ближе дл взаимодействи\nс болничной койкой", bedid + 1);
	}
	UpdateDynamic3DTextLabelText(g_med_bed_label[bedid], 0xFFFFFFEE, fmt_text);

	return 1;
}

stock MedBed_SetOccupied(playerid, bedid)
{
	SetPlayerData(playerid, P_OCCUPIED_BED, bedid);
	SetPlayerData(playerid, P_HOSPITAL, true);
	g_med_bed_used[bedid] = true;
	g_PlayerNearMedBedNotified[playerid] = -1;
	UpdateMedBed(bedid, true);
	return 1;
}

public: HospitalTreatment()
{
  for(new playerid; playerid < MAX_PLAYERS; playerid ++)
  {
    if(!IsPlayerConnected(playerid)) continue;
    else if(!IsPlayerLogged(playerid)) continue;
    else if(GetPlayerData(playerid, P_OCCUPIED_BED) == -1) continue;

    new bedid = GetPlayerData(playerid, P_OCCUPIED_BED);
    if(bedid < 0 || bedid >= sizeof g_med_bed_pos)
    {
      SetPlayerData(playerid, P_OCCUPIED_BED, -1);
      continue;
    }

    if(!IsPlayerInRangeOfPoint(playerid, 150.0, g_med_bed_pos[bedid][0], g_med_bed_pos[bedid][1], g_med_bed_pos[bedid][2]))
    {
      ClearMedBed(playerid, bedid);
    }
    else
    {
      GameTextForPlayer(playerid, "~g~~h~~h~+ 3 HP", 1000, 4);
      SetPlayerChatBubble(playerid, "+3 hp", 0x33CC33FF, 5.0, 1000);

      SetPlayerHealthEx(playerid, 3.0, true);
    }
  }
  SetTimer("HospitalTreatment", (random(5) + 1) * 1000, false);
  return 1;
}

stock IsAutosalonGameColor(color)
{
	for(new i; i < sizeof g_autosalon_game_colors; i++)
	{
		if(g_autosalon_game_colors[i] == color)
		{
			return 1;
		}
	}
	return 0;
}

stock GetAutosalonShiftGameColor(color, step)
{
	new idx = 0;
	for(new i; i < sizeof g_autosalon_game_colors; i++)
	{
		if(g_autosalon_game_colors[i] == 1)
		{
			idx = i;
			break;
		}
	}

	for(new i; i < sizeof g_autosalon_game_colors; i++)
	{
		if(g_autosalon_game_colors[i] == color)
		{
			idx = i;
			break;
		}
	}

	idx += step;

	if(idx < 0)
		idx = sizeof g_autosalon_game_colors - 1;
	else if(idx >= sizeof g_autosalon_game_colors)
		idx = 0;

	return g_autosalon_game_colors[idx];
}

public: BuyCarPTDUpdate(playerid)
{
	new fmt_str[50];
	new fmt_text[50];
	if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return 1;

	new biz_id = GetPlayerInBiz(playerid);
	if (biz_id == -1) return 1;
	new car_market_id = biz_id - 34;

	new select_car = buy_car_select_car[playerid];
	new modelid = car_market_data[car_market_id][select_car][0];

	format(fmt_str, sizeof fmt_str, "%d ", GetVehicleInfo(modelid - 400, VI_PRICE));
	PlayerTextDrawSetString(playerid, avtsln_PTD[playerid][7], fmt_str);

    format(fmt_text, sizeof fmt_text, "%s", GetVehicleInfo(modelid - 400, VI_NAME));
	PlayerTextDrawSetString(playerid, avtsln_PTD[playerid][10], fmt_text);
	
	format(fmt_text, sizeof fmt_text, "%d км/ч", GetVehicleInfo(modelid - 400, VI_MAXSP));
	PlayerTextDrawSetString(playerid, avtsln_PTD[playerid][8], fmt_text);

	format(fmt_text, sizeof fmt_text, "%.1f сек", GetVehicleInfo(modelid - 400, VI_USCOR));
	PlayerTextDrawSetString(playerid, avtsln_PTD[playerid][9], fmt_text);

	new color1 = GetPlayerData(playerid, P_AUTOSALON_COLOR1);
	new color2 = GetPlayerData(playerid, P_AUTOSALON_COLOR2);

	if(!IsAutosalonGameColor(color1))
	{
		color1 = 1;
		SetPlayerData(playerid, P_AUTOSALON_COLOR1, color1);
	}
	if(!IsAutosalonGameColor(color2))
	{
		color2 = 1;
		SetPlayerData(playerid, P_AUTOSALON_COLOR2, color2);
	}

	ChangeVehicleColor(GetPlayerData(playerid, P_BUY_CAR), color1, color2);
	return 1;
}

public: ShowBuyCarInfo(playerid, vehicleid)
{
	new text[275];

	//static const vehicle_class_name[][] = {"ото-вело", "коном", "редний", "ремиум"};

	new modelid = GetVehicleModel(vehicleid) - 400;
	format
	(
		text, sizeof text,
		"{FFFFFF}ип автомобил:\t%s класс\n\
		азвание:\t\t%s\n\
		омер модели:\t%d\n\
		тоимост аренд:\t{FFFF00}%d руб.\n\
		{FFFFFF}тоимост покупки:\t{00CC00}%d руб.\n\n\
		{FFFFFF}л покупки этой модели нажмите \"упит\"\n\
		тоб взт авто в аренду исползуйте /rentcar",
		"еопределённй",
		//vehicle_class_name[ GetVehicleInfo(modelid, VI_TYPE) ],
		GetVehicleInfo(modelid, VI_NAME),
		modelid + 400,
		GetVehicleInfo(modelid, VI_PRICE) / 100,
		GetVehicleInfo(modelid, VI_PRICE)
	);

	Dialog(playerid, DIALOG_BIZ_CAR_MARKET_CAR_INFO, DIALOG_STYLE_MSGBOX, "{FF9900}вторнок", text, "упит", "йти");
	return 1;
}

stock ExitPlayerBuyCarMarket(playerid)
{
	if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) return -1;

	DestroyVehicle(GetPlayerData(playerid, P_BUY_CAR));
	SetPlayerData(playerid, P_BUY_CAR, INVALID_VEHICLE_ID);

	new in_biz = GetPlayerInBiz(playerid);
	if (in_biz == -1) return 1;

	//BuyCarTDsHideForPlayer(playerid);
	//HidePlayerSelectPanel(playerid);

	TogglePlayerControllable(playerid, true);


	SetPlayerPosEx
	(
		playerid,
		GetBusinessData(in_biz, B_EXIT_POS_X),
		GetBusinessData(in_biz, B_EXIT_POS_Y),
		GetBusinessData(in_biz, B_EXIT_POS_Z),
		GetBusinessData(in_biz, B_EXIT_ANGLE),
		0,
		0
	);
	SetPlayerInBiz(playerid, -1);
	
	HideAutosalonTextDraws(playerid);
	ShowHud(playerid);


//	SetPlayerPosEx(playerid, 1145.5162, 221.0673, 995.1235, 34.2197, 1, biz_id + 6000);

	return 1;
}

stock CarMarketShowNextCar(playerid, next = '+')
{
	new biz_id = GetPlayerInBiz(playerid);
	if(biz_id == -1) return 1;
	new car_market_id = biz_id - 34;

	if(GetBusinessData(biz_id, B_TYPE) != BUSINESS_TYPE_CAR_MARKET) return 1;

	new max_car_index = GetCarMarketMaxIndex(car_market_id);

	if(next == '+')
	{
		if(++buy_car_select_car[playerid] > max_car_index)
			buy_car_select_car[playerid] = 0;
	}
	else
	{
		if(--buy_car_select_car[playerid] < 0)
			buy_car_select_car[playerid] = max_car_index;
	}

	new select_car = buy_car_select_car[playerid];
//	new color_1 = buy_car_select_color[playerid][0];
	//new color_2 = buy_car_select_color[playerid][1];
	new color1 = GetPlayerData(playerid, P_AUTOSALON_COLOR1);
	new color2 = GetPlayerData(playerid, P_AUTOSALON_COLOR2);

	DestroyVehicle(GetPlayerData(playerid, P_BUY_CAR));
	SetPlayerData(playerid, P_BUY_CAR, CreateVehicle(car_market_data[car_market_id][select_car][0], 1149.8434, 226.0655, 995.1953, 67.6542, color1, color2, 1));
	SetVehicleVirtualWorld(GetPlayerData(playerid, P_BUY_CAR), playerid + 1);
	LinkVehicleToInterior(GetPlayerData(playerid, P_BUY_CAR), 1);

	CallLocalFunction("BuyCarPTDUpdate", "i", playerid);
	return 1;
}

stock GetCarMarketMaxIndex(market_id)
{
	new max_index;

	for(new idx; idx < 31; idx ++)
	{
		if(car_market_data[market_id][idx][0] == 0)	break;
		++ max_index;
	}

	return max_index - 1;
}

