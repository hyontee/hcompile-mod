	if(GetPVarInt(playerid, "PizzaCheck") == 7)
	{
	  DisablePlayerCheckpoint(playerid);
	  SetPlayerCheckpoint(playerid, PizzaCheckpoint[8][0], PizzaCheckpoint[8][1], PizzaCheckpoint[8][2], 2.0);
	  SendClientMessage(playerid, COLOR_LIGHTBLUE, ""SC" доставили заказ на нужную точку. а карте отмечена нова точка, отправлйтес туда");
	  SendClientMessage(playerid, COLOR_LIGHTBLUE, ""SC"л завершени работ и получени зарплат {ffff00}/gps - о работе");
	  SetPVarInt(playerid, "PizzaCheck", 8);
	  SetPVarInt(playerid, "PizzaMoney", GetPVarInt(playerid, "PizzaMoney") + PizzaMoney);
	  return 1;
	}
