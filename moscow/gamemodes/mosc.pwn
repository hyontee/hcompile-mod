			"{FF5252} #2 {FFFFFF}онатна алюта\t\t\t\t\t {888888} нажмите дл взаимодействи\n"\
			"{FF5252} #3 {FFFFFF}ип статус\t\t\t\t\t {888888} нажмите дл взаимодействи\n"\
			"{FF5252} #4 {FFFFFF}ейс\t\t\t\t\t {888888} нажмите дл взаимодействи\n"\
			"{FF5252} #5 {FFFFFF}никалне аксессуар\t\t\t\t\t {888888} нажмите дл взаимодействи",
			"брат", "акрт"
		);
}
CMD:giveepoints(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return 1;

	extract params -> new to_player, acoins; else return SendClientMessage(playerid, 0xCECECEFF, "сползуйте: /giveepoints [id игрока] [cумма]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "акого игрока нет");

	if(!(-1 <= acoins <= 100_000)) return SendClientMessage(playerid, 0xCECECEFF, "ожно вдават от 1 до 10000 аллов за один раз");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, -1, ""USC" грок не в сети!");

	new fmt_text[999];

    format(fmt_text, sizeof fmt_text, "{FFFFFF}дминистратор {FF5252}%s {FFFFFF}вдал ам {FF5252}%d {FFFFFF}балла(-ов) обмена.", GetPlayerNameEx(playerid), acoins);
	SendClientMessage(to_player, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, "{FFFFFF}тоб потратит балл восползуйтес специалной командой: {FF5252}/epoints");
	SendClientMessage(to_player, -1, fmt_text);

	format(fmt_text, sizeof fmt_text, "[A] %s[%d] вдал балл дл обмена %s[%d] кол-во %d баллов, в итоге у игрока %d баллов", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player, acoins, GetPlayerMoneyEx(to_player));
	SendMessageToAdmins(fmt_text, 0xCECECEFF);

    AddPlayerData(playerid, P_ACOINS, +, acoins);
	UpdatePlayerDatabaseInt(playerid, "acoins", GetPlayerData(to_player, P_ACOINS) - 450);
	return 1;
}


stock UpdateFlatPickup(entranceid, flat_id, bool:is_owned)
{
    if(entranceid < 0 || entranceid >= g_entrance_loaded) 
    {
        printf("[UpdateFlatPickup] шибка: entranceid %d вне диапазона (0-%d)", entranceid, g_entrance_loaded - 1);
        return 0;
    }
    
    new floor = flat_id / 4;
    new flat_on_floor = flat_id % 4;
    
    if(floor >= GetEntranceData(entranceid, E_FLOORS)) 
    {
        printf("[UpdateFlatPickup] шибка: этаж %d превшает количество этажей %d", floor, GetEntranceData(entranceid, E_FLOORS));
        return 0;
    }

    new bool:found = false;
    for(new pickupid = 0; pickupid < MAX_PICKUPS; pickupid++)
    {
        if(!IsPickupExists(pickupid)) continue;
        if(GetPickupInfo(pickupid, P_ACTION_TYPE) != PICKUP_ACTION_TYPE_ENTRANCE_FLA) continue;
        if(GetPickupInfo(pickupid, P_ACTION_ID) != flat_id) continue;
        
        DestroyPickup(pickupid);
        found = true;
        break;
    }
    
    new pickup_model = is_owned ? 1272 : 1273;
    
    new pickupid = CreatePickup(
        pickup_model,
        23,
        g_entrance_flat_pos[flat_on_floor][0],
        g_entrance_flat_pos[flat_on_floor][1],
        g_entrance_flat_pos[flat_on_floor][2],
        -1,
        PICKUP_ACTION_TYPE_ENTRANCE_FLA,
        flat_id
    );
    
    printf("[UpdateFlatPickup] вартира %d в подъезде %d: %s (пикап %d, модел %d)", 
        flat_id + 1, entranceid + 1, is_owned ? "Я" : "", pickupid, pickup_model);
    
    return 1;
}


stock GivePlayerBusinessFree(playerid, businessid)
{
    if(IsBusinessOwned(businessid) || GetPlayerBusiness(playerid) != -1)
        return 0;

    new query[256];

    format(query, sizeof query, 
        "UPDATE accounts a, business b SET a.business=%d, b.owner_id=%d WHERE a.id=%d AND b.id=%d",
        businessid, GetPlayerAccountID(playerid), GetPlayerAccountID(playerid), GetBusinessData(businessid, B_SQL_ID));
    mysql_query(mysql, query, false);

    if(mysql_errno())
        return 0;

    SetPlayerData(playerid, P_BUSINESS, businessid);
    SetBusinessData(businessid, B_OWNER_ID, GetPlayerAccountID(playerid));
    SetBusinessData(businessid, B_IMPROVEMENTS, 0);

    new time = gettime();
    new rent_time = (time - (time % 86400)) + 86400;

    SetBusinessData(businessid, B_PRODS, 20);
    SetBusinessData(businessid, B_PROD_PRICE, 0);
    SetBusinessData(businessid, B_ENTER_MUSIC, 0);
    SetBusinessData(businessid, B_ENTER_PRICE, 0);
    SetBusinessData(businessid, B_BALANCE, 0);
    SetBusinessData(businessid, B_RENT_DATE, rent_time);
    SetBusinessData(businessid, B_LOCK_STATUS, false);
    
    format(g_business[businessid][B_OWNER_NAME], 21, GetPlayerNameEx(playerid));

    UpdateBusinessLabel(businessid);

    format(query, sizeof query,
        "UPDATE business SET improvements=0, products=%d, prod_price=%d, balance=%d, rent_time=%d, `lock`=%d WHERE id=%d LIMIT 1",
        GetBusinessData(businessid, B_PRODS),
        GetBusinessData(businessid, B_PROD_PRICE),
        GetBusinessData(businessid, B_BALANCE),
        GetBusinessData(businessid, B_RENT_DATE),
        GetBusinessData(businessid, B_LOCK_STATUS),
        GetBusinessData(businessid, B_SQL_ID)
    );
    mysql_query(mysql, query, false);

    format(query, sizeof query, "UPDATE business_profit SET view=0 WHERE bid=%d AND view=1", GetBusinessData(businessid, B_SQL_ID));
    mysql_query(mysql, query, false);

    return 1;
}


CMD:setunloadpos(playerid, params[])
{
    new vehicleid = GetPlayerOwnableCar(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0x999999FF, " вас нет личного транспорта");

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    if(index == -1) return SendClientMessage(playerid, 0xFF6600FF, "шибка!");

    new Float:x, Float:y, Float:z, Float:angle;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, angle);

    SetOwnableCarData(index, OC_UNLOAD_X, x);
    SetOwnableCarData(index, OC_UNLOAD_Y, y);
    SetOwnableCarData(index, OC_UNLOAD_Z, z);
    SetOwnableCarData(index, OC_UNLOAD_ANGLE, angle);

    new query[256];
    mysql_format(mysql, query, sizeof query,
        "UPDATE ownable_cars SET unload_x=%f, unload_y=%f, unload_z=%f, unload_angle=%f WHERE id=%d",
        x, y, z, angle, GetOwnableCarData(index, OC_SQL_ID)
    );
    mysql_query(mysql, query, false);

    SendClientMessage(playerid, 0x66CC00FF, "озици вгрузки установлена!");
    return 1;
}