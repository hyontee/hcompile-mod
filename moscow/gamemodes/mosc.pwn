    {
        PlayAudioStreamURL(playerid, "http://193.168.227.194/project/files/audio/audiostream/vehicle_sound_door.mp3");
        SendClientMessage(playerid, -1, "{66CC33}[AudioStream] {FFFFFF}вук воспроизводитс");
        return 1;
    }
    
    // сли ввели название файла
    format(url, sizeof(url), "http://193.168.227.194/project/files/audio/audiostream/%s.mp3", params);
    PlayAudioStreamURL(playerid, url);
    SendClientMessage(playerid, -1, "{66CC33}[AudioStream] {FFFFFF}оспроизведение: %s.mp3", params);
    return 1;
}

