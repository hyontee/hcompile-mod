        "DELETE FROM payments WHERE user_id=%d", account_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM ban_list WHERE user_id=%d", account_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query, 
        "DELETE FROM reports_list WHERE sender_id=%d OR target_id=%d", account_id, account_id);
    mysql_query(mysql, query, false);
    
