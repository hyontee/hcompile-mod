							}
							strcat(g_business_realtor_list,"\n{FFFFFF}ведите число в окошко ниже \nример: 10,25");
						    Dialog(playerid, DIALOG_CHANGE_COLOR_CAR, DIALOG_STYLE_INPUT,"окраска автомобил",
							g_business_realtor_list,
							"окрасит", "тмена");
	                    }
						case 3:
