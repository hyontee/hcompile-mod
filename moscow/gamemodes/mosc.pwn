stock GetQuestLineName(quest_id, output[], output_size)
{
	switch(quest_id)
	{
		case 1: format(output, output_size, "ервй шаг");
		case 2: format(output, output_size, "ез свзи никуда");
		case 3: format(output, output_size, "ерва тачка");
		case 4: format(output, output_size, "ора приодетс");
		case 5: format(output, output_size, "однй приговор");
		case 6: format(output, output_size, "амй активнй");
		case 7: format(output, output_size, "реди своих");
		case 8: format(output, output_size, "ове возможности");
		case 9: format(output, output_size, "анковский счет");
		case 10: format(output, output_size, "ой первй дом");
		case 11: format(output, output_size, "ой первй бизнес");
		case 12: format(output, output_size, "иберспортсмен");
		case 13: format(output, output_size, "очти лидер");
		case 14: format(output, output_size, "ам себе механик");
		case 15: format(output, output_size, "олноценнй лидер");
		default: format(output, output_size, "еизвестнй квест");
	}
	return 1;
}

