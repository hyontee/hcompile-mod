			case DIALOG_ADMINCALL_MENU:
            {
                switch(listitem)
                {
                    case 0: ShowPlayerReportDialog(playerid);
                    case 1: ShowPlayerAskDialog(playerid);
                }
			}
case DIALOG_ADMIN_LOGIN:
{
    if(!response || !strlen(inputtext))
    {
        SetPVarInt(playerid, "AdminPass", GetPVarInt(playerid, "AdminPass") + 1);
        if(GetPVarInt(playerid, "AdminPass") >= 3)
        {
            new fmt_text[128];
            format(fmt_text, sizeof fmt_text, "[A] %s[%d] отключилс от сервера (невернй админ парол). IP: %s", 
                GetPlayerNameEx(playerid), playerid, GetPlayerIpEx(playerid));
            SendMessageToAdmins(fmt_text, 0x999999FF);
            FixKick(playerid);
            return 1;
        }
        
        new fmt_msg[256];
        format(fmt_msg, sizeof fmt_msg, 
            "{FF5A5A}SANTA MOBILE RP {FFFFFF}| вторизаци в админ-панели\n\n\
            {FFFFFF} вошли как администратор сервера\n\
            {FF0000}евернй парол! сталос попток: %d\n\n\
            {FFFFFF}ведите парол от панели администратора в поле ниже\n\
            {FFFFFF}опустим латинские букв и цифр (6-32 символа)", 
            3 - GetPVarInt(playerid, "AdminPass"));
        
        return Dialog(playerid, DIALOG_ADMIN_LOGIN, DIALOG_STYLE_INPUT,
            "дмин авторизаци", fmt_msg, "ойти", "ход");
    }

    // олучаем хеш и сол из 
    new query[128], Cache:result;
    new db_hash[65], db_salt[11];
    
    mysql_format(mysql, query, sizeof query, 
        "SELECT admin_pass_hash, admin_pass_salt FROM accounts WHERE id=%d", 
        GetPlayerAccountID(playerid));
    result = mysql_query(mysql, query, true);
    
    if(cache_num_rows())
    {
        cache_get_field_content(0, "admin_pass_hash", db_hash, mysql, 65);
        cache_get_field_content(0, "admin_pass_salt", db_salt, mysql, 11);
    }
    cache_delete(result);
    
    // роверем парол
    new hash[65];
    SHA256_PassHash(inputtext, db_salt, hash, 65);
    
    if(strcmp(hash, db_hash) != 0)
    {
        SetPVarInt(playerid, "AdminPass", GetPVarInt(playerid, "AdminPass") + 1);
        if(GetPVarInt(playerid, "AdminPass") >= 3)
        {
            new fmt_text[128];
            format(fmt_text, sizeof fmt_text, "[A] %s[%d] отключилс от сервера (невернй админ парол). IP: %s", 
                GetPlayerNameEx(playerid), playerid, GetPlayerIpEx(playerid));
            SendMessageToAdmins(fmt_text, 0x999999FF);
            FixKick(playerid);
            return 1;
        }
        
        new fmt_msg[256];
        format(fmt_msg, sizeof fmt_msg, 
            "{FF5A5A}SANTA MOBILE RP {FFFFFF}| вторизаци в админ-панели\n\n\
            {FFFFFF} вошли как администратор сервера\n\
            {FF0000}евернй парол! сталос попток: %d\n\n\
            {FFFFFF}ведите парол от панели администратора в поле ниже\n\
            {FFFFFF}опустим латинские букв и цифр (6-32 символа)", 
            3 - GetPVarInt(playerid, "AdminPass"));
        
        return Dialog(playerid, DIALOG_ADMIN_LOGIN, DIALOG_STYLE_INPUT,
            "дмин авторизаци", fmt_msg, "ойти", "ход");
    }

    // спешна авторизаци
    if(GetPVarInt(playerid, "AdminPass")) DeletePVar(playerid, "AdminPass");

    ShowConnectPanelAC(playerid);
    ShowWarningPanelAC(playerid);

    new admin_prefix_name[64];
    GetPlayerAdminPrefixName(playerid, admin_prefix_name, sizeof admin_prefix_name);
    new fmt_text[128];

    if(GetPlayerAdminEx(playerid) >= 1)
    {
        format(fmt_text, sizeof fmt_text, "{00FF00}[ALogin] %s[%d] авторизовалс как %s",
            GetPlayerNameEx(playerid), playerid, admin_prefix_name);
        SendMessageToAdmins(fmt_text, 0xF0F0F0FF);
    }
    
    SetPlayerData(playerid, P_ADMIN_LOGGED, 1);
    CreateAdminTimeTextDraw(playerid);
    UpdateAdminTimeTextDraw(playerid);

    if(GetPlayerAdminEx(playerid) >= 1)
    {
        ShowWelcomeAdminDialog(playerid);
    }

    if(GetPlayerAdminWarn(playerid) > 0)
    {
        format(fmt_text, 256, "{FF6600} ас ест %i вговор(а), некоторе команд бли заблокирован.", 
            GetPlayerAdminWarn(playerid));
        SendClientMessage(playerid, -1, fmt_text);
    }
    
    return 1;
}
			case DIALOG_ADMIN_REG:
{
    if(!response) 
    {
        FixKick(playerid);
        return 1;
    }

    if(GetPlayerIdFamily(playerid) != -1)
    {
        new family_vehicleid = INVALID_VEHICLE_ID;
        new Float: family_radius = 10.0;
        new Float: player_x, Float: player_y, Float: player_z;
        GetPlayerPos(playerid, player_x, player_y, player_z);

        for(new idx; idx < MAX_VEHICLES; idx ++)
        {
            if(!IsValidVehicle(idx)) continue;
            if(!IsVehicleStreamedIn(idx, playerid)) continue;
            if(GetVehicleData(idx, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_FAMILY_CAR) continue;

            new family_car_idx = GetVehicleData(idx, V_ACTION_ID);
            if(family_car_idx == -1) continue;
            if(GetCarFamily(family_car_idx, OW_F_server) != GetPlayerIdFamily(playerid)) continue;
            if(GetPlayerRangFamily(playerid) < GetCarFamily(family_car_idx, V_F_RANG)) continue;

            new Float: distance = GetVehicleDistanceFromPoint(idx, player_x, player_y, player_z);
            if(distance > family_radius) continue;

            family_radius = distance;
            family_vehicleid = idx;
        }

        if(family_vehicleid != INVALID_VEHICLE_ID)
        {
            ToggleLock(playerid, family_vehicleid);
            return 1;
        }
    }

    new len = strlen(inputtext);
    
    // роверка длин
    if(len < 6 || len > 32)
    {
        Dialog(playerid, DIALOG_ADMIN_REG, DIALOG_STYLE_INPUT, 
            "{FF5A5A}SANTA MOBILE RP {FFFFFF}| ридумайте парол", 
            "{FFFFFF}л того, чтоб продолжит далее - придумайте и введите\n\
            парол от панели администратора в диалоговое поле ниже\n\n\
            {FFFFFF}лина парол от 6 до 32 символов, букв латинского алфавита, цифр.", 
            "алее", "ход");
        return 1;
    }
    
    // роверка на допустиме символ (толко латиница и цифр)
    for(new i = 0; i < len; i++)
    {
        if(!('a' <= inputtext[i] <= 'z') && !('A' <= inputtext[i] <= 'Z') && !('0' <= inputtext[i] <= '9'))
        {
            Dialog(playerid, DIALOG_ADMIN_REG, DIALOG_STYLE_INPUT, 
                "{FF5A5A}SANTA MOBILE RP {FFFFFF}| ридумайте парол", 
                "{FFFFFF}л того, чтоб продолжит далее - придумайте и введите\n\
                парол от панели администратора в диалоговое поле ниже\n\n\
                {FFFFFF}лина парол от 6 до 32 символов, букв латинского алфавита, цифр.", 
                "алее", "ход");
            return 1;
        }
    }

    // ешируем парол через SHA256
    new hash[65];
    new salt[11];
    for(new i; i < 10; i++) salt[i] = random(79) + 47;
    salt[10] = 0;
    
    SHA256_PassHash(inputtext, salt, hash, 65);
    
    // охранем хеш и сол в 
    new query[256];
    mysql_format(mysql, query, sizeof query, 
        "UPDATE accounts SET admin_pass_hash='%s', admin_pass_salt='%s' WHERE id=%d", 
        hash, salt, GetPlayerAccountID(playerid));
    mysql_query(mysql, query, false);
    
    // охранем в памт дл проверки при логине
    SetPVarString(playerid, "admin_hash", hash);
    SetPVarString(playerid, "admin_salt", salt);
    SetPlayerData(playerid, P_APASS, 1);

    SendClientMessage(playerid, -1, "{0099CC}арол успешно установлен! вторизируйтес с помощю него!");
    
    // оказваем диалог авторизации
    return Dialog(playerid, DIALOG_ADMIN_LOGIN, DIALOG_STYLE_INPUT,
        "{FF5A5A}SANTA MOBILE RP {FFFFFF}| вторизаци в админ-панели",
        "{FFFFFF} вошли как администратор сервера\n\n\
        {FFFFFF}ведите парол от панели администратора в поле ниже\n\
        {FFFFFF}опустим латинские букв и цифр (6-32 символа)",
        "ойти", "ход");
}
			case DIALOG_EDIT_ADMIN_RANG:
			{
				new user_id = GetPVarInt(playerid, "admin_panel_user_id"),
					player_id = GetPlayerIDBySqlID(user_id);

				if(player_id != -1)
				{
					if(response)
					{
						if(GetPlayerData(player_id, P_ADMIN) >= MAX_ADMIN_LEVEL)
							return SendClientMessage(playerid, 0xFF3300FF, "елз повсит вше 8 уровн");

						AddPlayerData(player_id, P_ADMIN, +, 1);
						SendClientMessage(playerid, 0x66CC33FF, "аш администраторский ранг бл повшен");
					}
					else
					{
						if(GetPlayerData(player_id, P_ADMIN) <= 1)
							return SendClientMessage(playerid, 0xFF3300FF, "елз понизит ниже 1 уровн");

						AddPlayerData(player_id, P_ADMIN, -, 1);
						SendClientMessage(playerid, 0xFF3300FF, "аш администраторский ранг бл понижен");
					}

					UpdatePlayerDatabaseInt(player_id, "admin", GetPlayerData(player_id, P_ADMIN));
				}
				else
				{
					new query[55],
						Cache: result,
						admin_rank;

					mysql_format(mysql, query, sizeof query, "SELECT admin FROM accounts WHERE id=%d", user_id);
					result = mysql_query(mysql, query, true);

					if(!cache_num_rows()) return 0;

					admin_rank = cache_get_row_int(0, 0);

					cache_delete(result);

					if(response)
					{
						if(admin_rank >= MAX_ADMIN_LEVEL)
							return SendClientMessage(playerid, 0xFF3300FF, "елз повсит вше 8 уровн");

						admin_rank++;
					}
					else
					{
						if(admin_rank <= 1)
							return SendClientMessage(playerid, 0xFF3300FF, "елз понизит ниже 1 уровн");

						admin_rank--;
					}

					mysql_format(mysql, query, sizeof query, "UPDATE accounts SET admin=%d WHERE id=%d", admin_rank, user_id);
					result = mysql_query(mysql, query, false);
				}


				return 1;
			}

			// -----------------------------------------------------------------
			case DIALOG_TELEPORT_LIST:
			{
				if(response)
				{
					if(0 <= listitem <= sizeof g_teleport_list - 1)
					{
						SetPlayerPosEx
						(
							playerid,
							GetTeleportListData(listitem, TL_POS_X),
							GetTeleportListData(listitem, TL_POS_Y),
							GetTeleportListData(listitem, TL_POS_Z),
							0.0, 0, 0
						);
					}
				}
			}
			// -----------------------------------------------------------------
			case DIALOG_SET_DOUBLING:
			{
				if(response)
				{
					new fmt_text[50],
						bool: doubling = g_doubling[listitem];

					static const doubling_name[3][24] = {"доната", "очков опта", "зарплат на подработках"};

					g_doubling[listitem] = doubling ^ true;

					format(fmt_text, sizeof fmt_text, " %s удвоение %s", doubling ? "включили" : "включили", doubling_name[listitem]);
					SendClientMessage(playerid, 0x3399FFFF, fmt_text);

					format(fmt_text, sizeof fmt_text, "%s удвоение %s", doubling ? "ключил" : "ключил", doubling_name[listitem]);
					SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_text);
				}
			}
			// -----------------------------------------------------------------
			case DIALOG_GANG_REPOSITORY:
			{
				if(response)
				{
					new item_names[4][10] = {"наркотики", "атрон", "атериал", "денги"},
						description[32],
						fmt_text[70],
						status;

					if(0 <= listitem <= 3)
						status = 1;

					SetPVarInt(playerid, "gr_state", status);
					SetPVarInt(playerid, "gr_item", status ? listitem : listitem - 4);

					format(description, sizeof description, "{FFCD00}%s %s", status ? "оложит" : "зт", status ? item_names[listitem] : item_names[listitem - 4]);
					format(fmt_text, sizeof fmt_text, "{FFFFFF}ведите количество, которое  хотите {FFCD00}%s:", status ? "положит" : "взт");

					Dialog(playerid, DIALOG_GANG_REPOSITORY_USE, DIALOG_STYLE_INPUT, description, fmt_text, "алее", "тмена");
				}
			}
			case DIALOG_GANG_REPOSITORY_USE:
			{
				if(response)
				{
					new status = GetPVarInt(playerid, "gr_state"),
						item = GetPVarInt(playerid, "gr_item"),
						item_count = strval(inputtext),
						repository_id = (GetPlayerTeamEx(playerid) - TEAM_OPG_ARZAMASKAYA);

					if(item_count < 1) return SendClientMessage(playerid, 0x999999FF, "еверное количество");

					new item_names[4][12] = {"наркотиков", "патронов", "атериала", "денег"},
						item_type[4][4] = {"г", "шт.", "кг", "руб"};

					new fmt_text[90];

					switch(status)
					{
						case 0:
						{
							if(!GetGangRepositoryData(repository_id, GR_LOCK))
								return SendClientMessage(playerid, 0x999999FF, "клад закрт.  не можете ничего брат");

							switch(item)
							{
								case 0:
								{
									if(GetGangRepositoryData(repository_id, GR_DRUGS) < item_count)
										return SendClientMessage(playerid, 0x999999FF, "а складе нет такого количества наркотиков");

									if((GetPlayerData(playerid, P_DRUGS) + item_count) > GetPlayerMaxStorage(playerid, STORAGE_DRUGS))
										return SendClientMessage(playerid, 0xCECECEFF, " не можете унести с собой столко наркотиков");

									AddPlayerData(playerid, P_DRUGS, +, item_count);
									UpdatePlayerDatabaseInt(playerid, "drugs", GetPlayerData(playerid, P_DRUGS));

									SetGangRepositoryData(repository_id, GR_DRUGS, GetGangRepositoryData(repository_id, GR_DRUGS) - item_count);
									UpdateGangRepository(repository_id);
								}
								case 1:
								{
									if(GetGangRepositoryData(repository_id, GR_AMMO) < item_count)
										return SendClientMessage(playerid, 0x999999FF, "а складе нет такого количества патронов");

									if((GetPlayerData(playerid, P_AMMO) + item_count) > GetPlayerMaxStorage(playerid, STORAGE_AMMO))
										return SendClientMessage(playerid, 0xCECECEFF, " не можете унести с собой столко патронов");

									AddPlayerData(playerid, P_AMMO, +, item_count);
									UpdatePlayerDatabaseInt(playerid, "ammo", GetPlayerData(playerid, P_AMMO));

									SetGangRepositoryData(repository_id, GR_AMMO, GetGangRepositoryData(repository_id, GR_AMMO) - item_count);
									UpdateGangRepository(repository_id);
								}
								case 2:
								{
									if(GetGangRepositoryData(repository_id, GR_METALL) < item_count)
										return SendClientMessage(playerid, 0x999999FF, "а складе нет такого количества атериала");

									if((GetPlayerData(playerid, P_METALL) + item_count) > GetPlayerMaxStorage(playerid, STORAGE_METALL))
										return SendClientMessage(playerid, 0xCECECEFF, " не можете унести с собой столко атериала");

									AddPlayerData(playerid, P_METALL, +, item_count);
									UpdatePlayerDatabaseInt(playerid, "metall", GetPlayerData(playerid, P_METALL));

									SetGangRepositoryData(repository_id, GR_METALL, GetGangRepositoryData(repository_id, GR_METALL) - item_count);
									UpdateGangRepository(repository_id);
								}
								case 3:
								{
									if(GetGangRepositoryData(repository_id, GR_MONEY) < item_count)
										return SendClientMessage(playerid, 0x999999FF, "а складе нет такого количества денег");

									GivePlayerMoneyEx(playerid, item_count, "зл со склада банд", true, true);

									SetGangRepositoryData(repository_id, GR_MONEY, GetGangRepositoryData(repository_id, GR_MONEY) - item_count);
									UpdateGangRepository(repository_id);
								}
							}

							format(fmt_text, sizeof fmt_text, "%s [id %d] взл(а) со склада банд {3399FF}%d %s {66CC33}%s",
							GetPlayerNameEx(playerid), playerid, item_count, item_type[item], item_names[item]);

							SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_text, 0x66CC33FF);
						}
						case 1:
						{
							switch(item)
							{
								case 0:
								{
									if(GetPlayerData(playerid, P_DRUGS) < item_count)
										return SendClientMessage(playerid, 0x999999FF, " ас нет такого количества наркотиков");

									AddPlayerData(playerid, P_DRUGS, -, item_count);
									UpdatePlayerDatabaseInt(playerid, "drugs", GetPlayerData(playerid, P_DRUGS));

									SetGangRepositoryData(repository_id, GR_DRUGS, GetGangRepositoryData(repository_id, GR_DRUGS) + item_count);
									UpdateGangRepository(repository_id);
								}
								case 1:
								{
									if(GetPlayerData(playerid, P_AMMO) < item_count)
										return SendClientMessage(playerid, 0x999999FF, " ас нет такого количества патронов");

									AddPlayerData(playerid, P_AMMO, -, item_count);
									UpdatePlayerDatabaseInt(playerid, "ammo", GetPlayerData(playerid, P_AMMO));

									SetGangRepositoryData(repository_id, GR_AMMO, GetGangRepositoryData(repository_id, GR_AMMO) + item_count);
									UpdateGangRepository(repository_id);
								}
								case 2:
								{
									if(GetPlayerData(playerid, P_METALL) < item_count)
										return SendClientMessage(playerid, 0x999999FF, " ас нет такого количества атериала");

									AddPlayerData(playerid, P_METALL, -, item_count);
									UpdatePlayerDatabaseInt(playerid, "metall", GetPlayerData(playerid, P_METALL));

									SetGangRepositoryData(repository_id, GR_METALL, GetGangRepositoryData(repository_id, GR_METALL) + item_count);
									UpdateGangRepository(repository_id);
								}
								case 3:
								{
									if(GetPlayerMoneyEx(playerid) < item_count)
										return SendClientMessage(playerid, 0x999999FF, " ас нет такого количества денег");

									GivePlayerMoneyEx(playerid, -item_count, "оложил на склад банд", true, true);

									SetGangRepositoryData(repository_id, GR_MONEY, GetGangRepositoryData(repository_id, GR_MONEY) + item_count);
									UpdateGangRepository(repository_id);
								}
							}

							format(fmt_text, sizeof fmt_text, "%s [id %d] положил(а) на склад банд {3399FF}%d %s {66CC33}%s",
							GetPlayerNameEx(playerid), playerid, item_count, item_type[item], item_names[item]);

							SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_text, 0x66CC33FF);
						}
					}
				}
			}
			// -----------------------------------------
			case DIALOG_ADVERT_EDIT:
			{
				new ad_id = GetPVarInt(playerid, "advert_id"),
					fmt_text[144];

				if(GetAdvertData(ad_id, A_CREATOR) == INVALID_PLAYER_ID)
					return SendClientMessage(playerid, 0x999999FF, "втор объвлени отключилс");

				if(response)
				{
					if(strlen(inputtext))
						format(g_advert[ad_id][A_TEXT], 128, inputtext);

					format(fmt_text, sizeof fmt_text, "%s | тправил: %s[%d] (тел. %d)", GetAdvertData(ad_id, A_TEXT),
					GetPlayerNameEx(GetAdvertData(ad_id, A_CREATOR)), GetAdvertData(ad_id, A_CREATOR),
					GetPlayerPhone(GetAdvertData(ad_id, A_CREATOR)));

					SendClientMessageToAll(0x00CC00FF, fmt_text);

					format(fmt_text, sizeof fmt_text, " бъвление %s сотрудник  %s", strlen(inputtext) ? "отредактировал" : "проверил",
					GetPlayerNameEx(playerid));
					SendClientMessageToAll(0x009900FF, fmt_text);
					
					AddPlayerData(playerid, P_PROGRESS_EXP_5, +, 1);
					UpdatePlayerDatabaseInt(playerid, "ProgressExp5", GetPlayerData(playerid, P_PROGRESS_EXP_5));

					if(GetPlayerData(playerid, P_PROGRESS_EXP_5) == 1000)
					{
					    SendClientMessage(playerid, COR_QUEST, "[остижени]: "c_b" успешно вполнили достижение "c_i"'адиоцентр'. "c_b"аграда: "c_s"50 DONATE-RUB");
					    GivePlayerDonateRub(playerid, 50, "полнение достижени / фракци");

					    SetPlayerData(playerid, P_PROGRESS_5, 1);
					    UpdatePlayerDatabaseInt(playerid, "Progress5", 1);
					    
					    AddPlayerData(playerid, P_TOP_4, +, 1);
						UpdatePlayerDatabaseInt(playerid, "TOP_Progress", GetPlayerData(playerid, P_TOP_4));
					}
					
					AddPlayerData(playerid, P_F_QUEST_EXP_4, +, 1);
					UpdatePlayerDatabaseInt(playerid, "FracQuestExp4", GetPlayerData(playerid, P_F_QUEST_EXP_4));

					if(GetPlayerData(playerid, P_F_QUEST_EXP_4) == 150)
					{
					    SendClientMessage(playerid, COR_QUEST, "[вест]: "c_b" успешно вполнили квест "c_i"'адиостанци на свзи'. "c_b"аграда: "c_s"1 CASE(/opencase)");

				        AddPlayerData(playerid, P_DONATE_CASE, +, 1);
						UpdatePlayerDatabaseInt(playerid, "case", GetPlayerData(playerid, P_DONATE_CASE));

					    SetPlayerData(playerid, P_F_QUEST_4, 1);
					    UpdatePlayerDatabaseInt(playerid, "FracQuest4", 1);
					    
					    AddPlayerData(playerid, P_TOP_5, +, 1);
						UpdatePlayerDatabaseInt(playerid, "TOP_Quest", GetPlayerData(playerid, P_TOP_5));
					}
				}
				else
				{
					if(!strlen(inputtext))
						return SendClientMessage(playerid, 0x999999FF, "ведите причину отклонени объвлени");

					new creator_id = GetAdvertData(ad_id, A_CREATOR);

					if(creator_id != INVALID_PLAYER_ID)
					{
						format(fmt_text, sizeof fmt_text, "%s %s[%d] отклонил аше объвление. ричина: %s",
						GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid, inputtext);

						SendClientMessage(creator_id, 0xFF5533FF, fmt_text);
					}

					format(fmt_text, sizeof fmt_text, "[] %s %s[%d] отклонил объвление №%d. ричина: %s",
					GetPlayerJobAndRankName(playerid), GetPlayerNameEx(playerid), playerid, ad_id + 1, inputtext);

					SendMessageToTeam(GetPlayerTeamEx(playerid), fmt_text, 0x99CC99FF, playerid);

					format(fmt_text, sizeof fmt_text, " отклонили объвление №%d. ричина: %s", ad_id + 1, inputtext);
					SendClientMessage(playerid, 0x66CC33FF, fmt_text);
				}

				DeleteAdvert(ad_id);
			}
			case DIALOG_DMZ_EXIT_CONFIRM:
			{
				if(response)
				{
					DMZ_ExitPlayer(playerid);
				}
				return 1;
			}
			case DIALOG_MPREG:
			{
				if(response)
				{
					switch(listitem + 1)
					{
						case 1:
						{
							Send(playerid,COR_SERVER,"[спешно]: "c_b" телепортировалис на DM ZONE, чтоб вйти с нее - введите /newdmzexit");
							Send(playerid,COR_SERVER,"[нформаци]: "c_b"тоб посмотрет   по киллам на DM ZONE, введите /newdmztop");
							Send(playerid,COR_SERVER,"[информаци]: "c_b"а каждй килл в будете получат 25.000 rub!  еще за кажде 10 кииллов - 1 DONATE RUB!");
						}
					}
				}
				return 1;
			}
			// -----------------------------------------
			case DIALOG_ARMORY:
			{
				if(response)
				{
					switch(listitem + 1)
					{
						case 1:
						{
							if(GetPVarInt(playerid, "took_nitestick") > gettime())
								return SendClientMessage(playerid, 0x999999FF, " уже недавно брали дубинку");

							GivePlayerWeapon(playerid, 3, 1);

							SendClientMessage(playerid, 0x3399FFFF, " взли дубинку");

							SetPVarInt(playerid, "took_nitestick", gettime() + 300);
						}
						case 2:
						{
							if(GetPVarInt(playerid, "took_mask") > gettime())
								return SendClientMessage(playerid, 0x999999FF, " уже недавно брали маску");

							if(GetPlayerData(playerid, P_MASK) == 1)
								return SendClientMessage(playerid, 0x999999FF, " ас уже ест маска");

							SetPlayerData(playerid, P_MASK, 1);

							SendClientMessage(playerid, 0x3399FFFF, " взли маску");

							SetPVarInt(playerid, "took_mask", gettime() + 300);
						}
						case 3:
						{
							new Float: armour;

							GetPlayerArmour(playerid, armour);

							if(armour > 20.0)
								return SendClientMessage(playerid, 0x999999FF, " ас уже ест бронежилет");

							SetPlayerArmour(playerid, 100.0);

							SendClientMessage(playerid, 0x3399FFFF, " надели бронежилет");
						}
						case 4:
						{
							if(GetPVarInt(playerid, "took_sdpistol") > gettime())
								return SendClientMessage(playerid, 0x999999FF, " уже недавно брали пистолет с глушителем");

							GivePlayerWeapon(playerid, 23, 60);

							SendClientMessage(playerid, 0x3399FFFF, " взли пистолет с глушителем");

							SetPVarInt(playerid, "took_sdpistol", gettime() + 300);
						}
						case 5:
						{
							if(GetPVarInt(playerid, "took_deagle") > gettime())
								return SendClientMessage(playerid, 0x999999FF, " уже недавно брали Desert Eagle");

							GivePlayerWeapon(playerid, 24, 120);

							SendClientMessage(playerid, 0x3399FFFF, " взли Desert Eagle");

							SetPVarInt(playerid, "took_deagle", gettime() + 300);
						}
						case 6:
						{
							if(GetPVarInt(playerid, "took_mp5") > gettime())
								return SendClientMessage(playerid, 0x999999FF, " уже недавно брали MP5");

							GivePlayerWeapon(playerid, 29, 180);

							SendClientMessage(playerid, 0x3399FFFF, " взли MP5");

							SetPVarInt(playerid, "took_mp5", gettime() + 300);
						}
						case 7:
						{
							if(GetPVarInt(playerid, "took_shotgun") > gettime())
								return SendClientMessage(playerid, 0x999999FF, " уже недавно брали дробовик");

							GivePlayerWeapon(playerid, 25, 30);

							SendClientMessage(playerid, 0x3399FFFF, " взли дробовик");

							SetPVarInt(playerid, "took_shotgun", gettime() + 300);
						}
						case 8:
						{
							if(GetPVarInt(playerid, "took_ak47") > gettime())
								return SendClientMessage(playerid, 0x999999FF, " уже недавно брали 47");

							GivePlayerWeapon(playerid, 30, 230);

							SendClientMessage(playerid, 0x3399FFFF, " взли 47");

							SetPVarInt(playerid, "took_ak47", gettime() + 300);
						}
						case 9:
						{
							if(GetPlayerJob(playerid) < 4)
								return SendClientMessage(playerid, 0x999999FF, "интовку можно брат толко с 4 ранга");

							if(GetPVarInt(playerid, "took_rifle") > gettime())
								return SendClientMessage(playerid, 0x999999FF, " уже недавно брали винтовку");

							GivePlayerWeapon(playerid, 34, 40);

							SendClientMessage(playerid, 0x3399FFFF, " взли винтовку");

							SetPVarInt(playerid, "took_rifle", gettime() + 300);
						}
					}
				}
			}
			// -----------------------------------------
			case DIALOG_BIZ_ORDERS:
			{
				if(response)
				{
					if(!IsPlayerInJob(playerid))
						return SendClientMessage(playerid, 0xCECECEFF, " должн начат работу в службе доставки");

					if(GetPlayerData(playerid, P_ORDER) != -1)
						return SendClientMessage(playerid, 0xCECECEFF, "полните текущий заказ перед тем как взт новй");

					new order_id = GetPlayerListitemValue(playerid, listitem);

					if(!GetOrderData(order_id, O_AMOUNT))
						return SendClientMessage(playerid, 0xFF6600FF, "шибка: браннй заказ не найден");

					if(GetOrderData(order_id, O_USED))
						return SendClientMessage(playerid, -1, "тот заказ уже принл другой далнобойщик");

					SetOrderData(order_id, O_USED, true);
					SetPlayerData(playerid, P_ORDER, order_id);

					SendClientMessage(playerid, 0x3399FFFF, " начали вполнение заказа. акупите необходимое количество продуктов на заводе {66CC00}(/gps)");
					SendClientMessage(playerid, 0x3399FFFF, "осле этого отправлйтес к бизнесу, которй отмечен {FF3300}красной точкой");

					new biz_id = GetOrderData(order_id, O_COMPANY_ID);

					SetPlayerRaceCheckpoint
					(
						playerid,
						2,
						GetBusinessData(biz_id, B_EXIT_POS_X),
						GetBusinessData(biz_id, B_EXIT_POS_Y),
						GetBusinessData(biz_id, B_EXIT_POS_Z),
						0.0,
						0.0,
						0.0,
						4.0,
						RCP_ACTION_TYPE_ORDER
					);
				}
			}
			case DIALOG_FS_ORDERS:
			{
				if(response)
				{
					if(!IsPlayerInJob(playerid))
						return SendClientMessage(playerid, 0xCECECEFF, " должн начат работу в службе доставки");

					if(GetPlayerData(playerid, P_ORDER) != -1)
						return SendClientMessage(playerid, 0xCECECEFF, "полните текущий заказ перед тем как взт новй");

					new order_id = GetPlayerListitemValue(playerid, listitem);

					if(!GetOrderData(order_id, O_AMOUNT))
						return SendClientMessage(playerid, 0xFF6600FF, "шибка: браннй заказ не найден");

					if(GetOrderData(order_id, O_USED))
						return SendClientMessage(playerid, -1, "тот заказ уже принл другой далнобойщик");

					SetOrderData(order_id, O_USED, true);
					SetPlayerData(playerid, P_ORDER, order_id);

					SendClientMessage(playerid, 0x3399FFFF, " начали вполнение заказа. акупите необходимое количество топлива на нефтезаводе {66CC00}(/gps)");
					SendClientMessage(playerid, 0x3399FFFF, "осле этого отправлйтес к , котора отмечена {FF3300}красной точкой");

					new fs_id = GetOrderData(order_id, O_COMPANY_ID);

					SetPlayerRaceCheckpoint
					(
						playerid,
						2,
						GetFuelStationData(fs_id, FS_POS_X),
						GetFuelStationData(fs_id, FS_POS_Y),
						GetFuelStationData(fs_id, FS_POS_Z),
						0.0,
						0.0,
						0.0,
						4.0,
						RCP_ACTION_TYPE_ORDER
					);
				}
			}
			// -----------------------------------------
			case DIALOG_PROMO_CREATE:
			{
				if(response)
				{
					new code[32], type, amount, usings, paydays;

					if(sscanf(inputtext, "P<,>s[32]dddd", code, type, amount, usings, paydays))
					{
						SendClientMessage(playerid, 0x999999FF, "екорректнй ввод");
						callcmd::createpromo(playerid, "");

						return 1;
					}
					else
					{
						if(!(0 <= type <= 3))
						{
							SendClientMessage(playerid, 0x999999FF, "ип должен бт от 0 до 3 (денги, донат-монет, донат-рубли, exp)");
							callcmd::createpromo(playerid, "");

							return 1;
						}

						if(!(1 <= amount <= 1_000_000))
						{
							SendClientMessage(playerid, 0x999999FF, "оличество должно бт от 1 до 1.000.000");
							callcmd::createpromo(playerid, "");

							return 1;
						}

						if(!(1 <= usings <= 1_000))
						{
							SendClientMessage(playerid, 0x999999FF, "оличество исползований должно бт от 1 до 1000");
							callcmd::createpromo(playerid, "");

							return 1;
						}

						if(!(0 <= paydays <= 20))
						{
							SendClientMessage(playerid, 0x999999FF, "оличество PayDay должно бт от 0 до 20");
							callcmd::createpromo(playerid, "");

							return 1;
						}

						new query[128],
							Cache: result,
							rows;

						mysql_format(mysql, query, sizeof query, "SELECT * FROM promocode WHERE code='%s'", code);
						result = mysql_query(mysql, query, true);

						rows = cache_num_rows();

						cache_delete(result);

						if(rows)
						{
							SendClientMessage(playerid, 0x999999FF, "акой промокод уже ест в базе даннх");
							callcmd::createpromo(playerid, "");

							return 1;
						}

						mysql_format(mysql, query, sizeof query, "INSERT INTO promocode (code, type, amount, usings, paydays) VALUES ('%s', %d, %d, %d, %d)",
						code, type, amount, usings, paydays);

						mysql_query(mysql, query);

						format(query, sizeof query, "ромокод \"%s\" создан (: %s, : %d, : %d, PD: %d)", code, promo_info[type][P_NAME], amount, usings, paydays);
						SendClientMessage(playerid, 0x66CC33FF, query);
					}
				}
			}
			case DIALOG_PROMO_ACTIVATE:
			{
				if(response)
				{
					if(!strlen(inputtext))
					{
						callcmd::promo(playerid, "");

						return 1;
					}

					new query[256],
						Cache: result,
						rows,
						type,
						amount,
						paydays,
						usings;


					mysql_format(mysql, query, sizeof query, "SELECT 1 FROM promocode_activations WHERE uip='%e' AND code='%s'", GetPlayerIpEx(playerid), inputtext);
					result = mysql_query(mysql, query, true);
					rows = cache_num_rows();
					cache_delete(result);
					if (rows >= 5) {
						SendClientMessage(playerid, 0x3399FFFF, "граничение на активацию");
						return 1;
					}

					mysql_format(mysql, query, sizeof query, "SELECT * FROM promocode_activations WHERE uid='%d' AND code='%s'", GetPlayerAccountID(playerid), inputtext);
					result = mysql_query(mysql, query, true);
					rows = cache_num_rows();
					if(rows)
					{
						// type = cache_get_field_content_int(0, "type");
						paydays = cache_get_field_content_int(0, "paydays");

						format(query, sizeof query, " уже активировали этот промокод");

						if(paydays)
							format(query, sizeof query, "%s.  получите свой приз через %d PayDay", query, paydays);

						SendClientMessage(playerid, 0x3399FFFF, query);

						cache_delete(result);

						return 1;
					}

					cache_delete(result);

					mysql_format(mysql, query, sizeof query, "SELECT * FROM promocode WHERE code='%s' AND usings > 0", inputtext);
					result = mysql_query(mysql, query, true);

					rows = cache_num_rows();

					if(rows)
					{
						type = cache_get_field_content_int(0, "type");
						amount = cache_get_field_content_int(0, "amount");
						usings = cache_get_field_content_int(0, "usings");
						paydays = cache_get_field_content_int(0, "paydays");
					}

					cache_delete(result);

					if(!rows)
					{
						SendClientMessage(playerid, 0x999999FF, "веденнй промокод не существует");
						callcmd::promo(playerid, "");

						return 1;
					}

					if(usings > 0)
					{
						if(!paydays)
						{
							AddPlayerData(playerid, promo_info[type][P_DATA], +, amount);
							UpdatePlayerDatabaseInt(playerid, promo_info[type][P_SQL_NAME], GetPlayerData(playerid, promo_info[type][P_DATA]));

							if(!strcmp(promo_info[type][P_SQL_NAME], "bank"))
							{
								SendClientMessage(playerid, 0x999999FF, "енги бли зачислен на банковский счёт");
							}
						}

						format(query, sizeof query, " активировали промокод \"%s\"", inputtext);

						if(paydays > 0)
							format(query, sizeof query, "%s.  получите свой приз через %d PayDay", query, paydays);

						SendClientMessage(playerid, 0x66CC33FF, query);

						mysql_format(mysql, query, sizeof query, "UPDATE promocode SET usings='%d' WHERE code='%s'", usings - 1, inputtext);
						mysql_query(mysql, query, false);

						mysql_format(mysql, query, sizeof query, "INSERT INTO promocode_activations (uid,uip,code,paydays) VALUES (%d,'%e','%e',%d)", GetPlayerAccountID(playerid), GetPlayerIpEx(playerid), inputtext, paydays);
						mysql_query(mysql, query, false);
					}
					else
					{
						SendClientMessage(playerid, 0x999999FF, "имит исползовани промокода исчерпан");
						callcmd::promo(playerid, "");
					}
				}
			}
			// -----------------------------------------
			case DIALOG_MP_CREATE:
