stock LoadSvetfor()
{
 for(new i; i < sizeof SvetforsPos; i++)
 {
     CreateObject(931, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);
     SvetforsColor[i] = CreateObject(930, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);
     SetTimerEx("SvetforsChangeColor", 15000, false, "ddd", i, 1, 0);
 }
}

forward SvetforsChangeColor(i, type, warn);
public SvetforsChangeColor(i, type, warn)
{
 //светофор писал KBASs <3
 switch(type)
 {
  //1 краснй
     case 1:
     {
         DestroyObject(SvetforsColor[i]);
      SvetforsColor[i] = CreateObject(929, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);
      SetTimerEx("SvetforsChangeColor", 3000, false, "ddd", i, 2, 1);
     }
  //2 желтй
     case 2:
     {
         if(warn == 1) //краснй - зеленй
         {
          DestroyObject(SvetforsColor[i]);
       SvetforsColor[i] = CreateObject(928, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);
       SetTimerEx("SvetforsChangeColor", 10000, false, "ddd", i, 3, 0);
   }
   else //зеленй - краснй
   {
          DestroyObject(SvetforsColor[i]);
       SvetforsColor[i] = CreateObject(930, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);
       SetTimerEx("SvetforsChangeColor", 10000, false, "dd", i, 1, 0);
   }
     }
  //3 зеленй
     case 3:
     {
         DestroyObject(SvetforsColor[i]);
      SvetforsColor[i] = CreateObject(929, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2], 0,0,SvetforsPos[i][3]);
      SetTimerEx("SvetforsChangeColor", 3000, false, "dd", i, 2, 2);
     }
 }
}

stock CheckTrafficLightViolation(playerid)
{
    // роверем толко если игрок в машине
    if(!IsPlayerInAnyVehicle(playerid)) return;
    
    new vehicleid = GetPlayerVehicleID(playerid);
    
    // олучаем скорост игрока (штрафуем толко если движетс)
    new Float:vx, Float:vy, Float:vz;
    GetVehicleVelocity(vehicleid, vx, vy, vz);
    new Float:speed = floatsqroot(vx*vx + vy*vy + vz*vz) * 100.0;
    
    if(speed < 5.0) return; // е штрафуем если стоит
    
    // олучаем позицию игрока
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    
    // роверем все светофор
    for(new i = 0; i < sizeof SvetforsPos; i++)
    {
        // роверем расстоние до светофора
        new Float:distance = GetPlayerDistanceFromPoint(playerid, SvetforsPos[i][0], SvetforsPos[i][1], SvetforsPos[i][2]);
        
        if(distance <= TRAFFIC_LIGHT_CHECK_RADIUS)
        {
            // роверем цвет светофора
            new model = GetObjectModel(SvetforsColor[i]);
            
            // 929 = раснй - 
            if(model == 929)
            {
                // роверем, не штрафовали ли уже за этот светофор
                if(PlayerTrafficLightFine[playerid][i] == 0)
                {
                    // трафуем игрока
                    GivePlayerMoney(playerid, -FINE_RED_LIGHT);
                    
                    // ообщение
                    SendClientMessage(playerid, -1, 
                        " проехали на краснй свет и получили {FF0000}штраф 2000 рублей{FFFFFF}. платит в его можете в банке!");
                    
                    // омечаем что оштрафовали
                    PlayerTrafficLightFine[playerid][i] = 1;
                    
                    // ог
                    printf("[TRAFFIC] Player %d оштрафован на светофоре %d (краснй)", playerid, i);
                }
            }
            // 928 = ёлтй -  , сбрасваем флаг
            else if(model == 928)
            {
                PlayerTrafficLightFine[playerid][i] = 0;
            }
            // 930 = елёнй -  , сбрасваем флаг
            else if(model == 930)
            {
                PlayerTrafficLightFine[playerid][i] = 0;
            }
        }
        else
        {
            // сли игрок далеко от светофора, сбрасваем флаг
            if(distance > TRAFFIC_LIGHT_CHECK_RADIUS * 2)
            {
                PlayerTrafficLightFine[playerid][i] = 0;
            }
        }
    }
}


