        new fmt_text[MAX_ADMIN_PREFIXES * 32 + 200];
        fmt_text = "{FFFF00}#\t{FFFF00}азвание\t{FFFF00}ействие\n";

        for(new i = 0; i < MAX_ADMIN_PREFIXES; i++)
        {
            // роверем, что уровен игрока позволет исползоват этот префикс
            new required_level = g_AdminPrefixes[i][PREFIX_LEVEL];
            new can_use = (GetPlayerAdminEx(playerid) >= required_level) ? 1 : 0;

            new row_text[128];
            format(row_text, sizeof(row_text),
                "{FF5A5A}%d.\t{%s}%s\t{%s}%s\n",
                i + 1,
                can_use ? "00FF00" : "808080",
                g_AdminPrefixes[i][PREFIX_NAME],
                can_use ? "00FF00" : "808080",
                can_use ? "становит" : "едоступно"
            );
            strcat(fmt_text, row_text);
        }

        new title[128];
        format(title, sizeof(title), "{FF5A5A}%s |{808080} становка тега администратора", SERVER_NAME);

        Dialog(playerid, DIALOG_SETADMIN_PREFIX_SELECT, DIALOG_STYLE_TABLIST_HEADERS,
            title, fmt_text, "брат", "тмена");

        return 1;
    }

	if(dialogid == DIALOG_CAR_SUBWOOFER)
{
    if(!response) return 1;

    if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC" должн бт за рулем");

    new vehicleid = GetPlayerVehicleID(playerid);
    if(GetPlayerOwnableCar(playerid) != vehicleid)
        return SendClientMessage(playerid, 0xFF6600FF, ""USC"абвуфер можно включит толко в личном автомобиле");

    switch(listitem)
    {
        case 0: callcmd::sub0(playerid, "");
        case 1: callcmd::sub1(playerid, "");
        case 2: callcmd::sub2(playerid, "");
        case 3: callcmd::sub3(playerid, "");
        case 4: callcmd::sub4(playerid, "");
        case 5: callcmd::suboff(playerid, "");
    }
    return 1;
}

	if(dialogid == DIALOG_FUEL_MENU)
{
    if(!response) return 1;
    
    switch(listitem)
    {
        case 0: // аправка
        {
            // роверем, включен ли двигател
            new vehicleid = GetPlayerVehicleID(playerid);
            if(GetVehicleParam(vehicleid, V_ENGINE) == VEHICLE_PARAM_ON)
            {
                SendClientMessage(playerid, 0xFF6600FF, ""USC"еред заправкой необходимо заглушит двигател! (/e)");
                ShowFuelMenu(playerid);
                return 1;
            }
            
            ShowFuelAmountDialog(playerid);
        }
        case 1: // емонтнй комплект
        {
            new stationid = GetNearestFuelStation(playerid, 10.0);
            if(stationid == -1)
                return SendClientMessage(playerid, 0xCECECEFF, ""USC"облизости нет заправочной станции");
            
            new price = 250;
            
            if(GetPlayerMoneyEx(playerid) < price)
                return SendClientMessage(playerid, 0xFF6600FF, ""USC" вас недостаточно средств! ужно: 250 руб.");
            
            // обавлем ремкомплект
            AddPlayerData(playerid, P_REPCARID, +, 1);
            UpdatePlayerDatabaseInt(playerid, "repcarid", GetPlayerData(playerid, P_REPCARID));
            GivePlayerMoneyEx(playerid, -price, "окупка ремонтного комплекта", true, true);
            
            SendClientMessage(playerid, 0x66CC33FF, ""SC" купили ремонтнй комплект! сползуйте /repaircar дл ремонта.");
            ShowFuelMenu(playerid);
        }
        case 2: // анистра
        {
            if(GetPVarInt(playerid, "have_jerrican") == 1)
                return SendClientMessage(playerid, 0xFF6600FF, ""USC" вас уже ест канистра!");
            
            new price = 200;
            
            if(GetPlayerMoneyEx(playerid) < price)
                return SendClientMessage(playerid, 0xFF6600FF, ""USC" вас недостаточно средств! ужно: 200 руб.");
            
            SetPVarInt(playerid, "have_jerrican", 1);
            GivePlayerMoneyEx(playerid, -price, "окупка канистр", true, true);
            
            SendClientMessage(playerid, 0x66CC33FF, ""SC" купили канистру! одойдите к авто и нажмите  дл заправки.");
            ShowFuelMenu(playerid);
        }
    }
    return 1;
}

