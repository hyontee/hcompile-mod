			case DIALOG_ACTION_TYPE_GET_FAMILY:
            {
                if(!(g_family_loaded >= 200))
                {
                    Dialog
                    (
                        playerid, DIALOG_CREATE_FAMILY, DIALOG_STYLE_INPUT,
                        "оздание семи",
                        "{FFFFFF}тоимост создани семи:{32a44b} 300 донат-рублей\n\
                        {FFFFFF}тоб создат семю, введите название семи, и нажмите 'оздат'",
                        "оздат", "тмена"
                    );
                }
            }
            case DIALOG_CREATE_FAMILY:
            {
                if(!response) return 1;

                if(GetPlayerIdFamily(playerid) != 0) return SendClientMessage(playerid, 0xCECECEFF, " уже состоите в семе");
                if(GetPlayerDonateRub(playerid) >= 300)
                {
                    if(GetPlayerData(playerid, P_LEVEL) >= 3)
                    {
                        new query[256],
                            Cache: result,
                            rows;

                        mysql_format(mysql, query, sizeof query, "SELECT * FROM family WHERE name='%s'", inputtext);
                        result = mysql_query(mysql, query, true);

                        rows = cache_num_rows();

                        cache_delete(result);

                        if(rows)
                        {
                            SendClientMessage(playerid, 0xCECECEFF, "анное им уже исползуетс");
                            Dialog
                            (
                                playerid, DIALOG_CREATE_FAMILY, DIALOG_STYLE_INPUT,
                                "оздание семи",
                                "{FFFFFF}ведите название семи, и нажмите 'оздат'",
                                "оздат", "тмена"
                            );

                            return 1;
                        }



                        new time = gettime();

                        mysql_format
                        (
                            mysql, query, sizeof query,
                            "INSERT INTO family "\
                                "(name,u_id,time) "\
                                "VALUES "\
                                "('%e',%d,%d)",
                            inputtext,
                            GetPlayerAccountID(playerid),
                            time
                        );
                        result = mysql_query(mysql, query);

                        new fam_id = cache_insert_id() - 1;

                        SetPlayerData(playerid, P_FAMILY, fam_id);
                        SetPlayerData(playerid, P_FAMILY_RANK, 10);

                        SetFamilyData(fam_id, F_SQL_ID, fam_id);

                        format(g_family[fam_id][F_NAME], 64, "%s", inputtext);

                        SetFamilyData(fam_id, F_TIME, time);
                        SetFamilyData(fam_id, F_HOUSE_ID, -1);
                        SetFamilyData(fam_id, F_USER_ID, GetPlayerAccountID(playerid));
                        format(g_family[fam_id][F_RANK1], 32, "усто");
                        format(g_family[fam_id][F_RANK2], 32, "усто");
                        format(g_family[fam_id][F_RANK3], 32, "усто");
                        format(g_family[fam_id][F_RANK4], 32, "усто");
                        format(g_family[fam_id][F_RANK5], 32, "усто");
                        format(g_family[fam_id][F_RANK6], 32, "усто");
                        format(g_family[fam_id][F_RANK7], 32, "усто");
                        format(g_family[fam_id][F_RANK8], 32, "усто");
                        format(g_family[fam_id][F_RANK9], 32, "усто");
                        format(g_family[fam_id][F_RANK10], 32, "усто");

                        cache_delete(result);

                        GivePlayerDonateRub(playerid, -300, "оздание семи", true);

                        format(query, sizeof query, "ем '%s' создана. {d8284c}оманд по управлению /mn > 2", inputtext);
                        SendClientMessage(playerid, 0x1E90FFFF, query);

                        format(query, sizeof query, "UPDATE accounts SET family=%d, family_rank=%d WHERE id=%d LIMIT 1", GetPlayerIdFamily(playerid), GetPlayerData(playerid, P_FAMILY_RANK), GetPlayerAccountID(playerid));
						mysql_query(mysql, query, false);

                    }
                    else SendClientMessage(playerid, 0xCECECEFF, "л создани семи необходимо проживат в штате не менее 3-ex лет");
                }
                else SendClientMessage(playerid, 0xCECECEFF, " ас недостаточно донат-рублей");
            }
            case DIALOG_ACTION_QUEST:
			{
				if(!response) return 1;
