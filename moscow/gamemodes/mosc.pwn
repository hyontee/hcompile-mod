stock TuneVinyl_BuildTexture(index, texture[], size = sizeof texture)
{
	format(texture, size, "remapbody%d", index);
	return 1;
}

stock Tune_ApplyOwnableVinyl(vehicleid)
{
	if(!IsAOwnableCar(vehicleid)) return 0;

	new own_index = GetVehicleData(vehicleid, V_ACTION_ID);
	if(own_index == -1) return 0;

	new vinyl_id = GetOwnableCarData(own_index, OC_VINILCAR);
	if(1 <= vinyl_id <= TUNE_VINYL_COUNT)
	{
		new texture[16];
		TuneVinyl_BuildTexture(vinyl_id, texture, sizeof texture);
		SetVehicleVinyl(vehicleid, texture, 1);
	}
	else
	{
		SetVehicleVinyl(vehicleid, "", 1);
	}
	return 1;
}

stock TuneVinyl_UpdatePanel(playerid)
{
	new price_str[24], fmt_text[96];
	valfmt(price_str, TUNE_PRICE_VINYL);
	format(fmt_text, sizeof fmt_text, " %d/%d | : %s рублей", g_tune_vinyl_index[playerid], TUNE_VINYL_COUNT, price_str);
	PlayerTextDrawSetString(playerid, shop_clothes_PTD[playerid][0], fmt_text);
	return 1;
}

stock TuneVinyl_ApplyPreview(playerid)
{
	if(!g_tune_vinyl_active[playerid]) return 0;
	if(!IsValidVehicle(g_tune_vinyl_vehicle[playerid])) return 0;

	new texture[16];
	TuneVinyl_BuildTexture(g_tune_vinyl_index[playerid], texture, sizeof texture);
	SetVehicleVinyl(g_tune_vinyl_vehicle[playerid], texture, 0);
	return 1;
}

stock TuneVinyl_Stop(playerid, bool:keep_selected, bool:show_menu = true)
{
	if(!g_tune_vinyl_active[playerid]) return 0;

	new vehicleid = g_tune_vinyl_vehicle[playerid];
	if(IsValidVehicle(vehicleid))
	{
		ChangeVehicleColor(vehicleid, g_tune_vinyl_prev_color1[playerid], g_tune_vinyl_prev_color2[playerid]);

		if(keep_selected)
		{
			new texture[16];
			TuneVinyl_BuildTexture(g_tune_vinyl_index[playerid], texture, sizeof texture);
			SetVehicleVinyl(vehicleid, texture, 1);
		}
		else
		{
			new prev_vinyl = g_tune_vinyl_prev_vinyl[playerid];
			if(1 <= prev_vinyl <= TUNE_VINYL_COUNT)
			{
				new texture[16];
				TuneVinyl_BuildTexture(prev_vinyl, texture, sizeof texture);
				SetVehicleVinyl(vehicleid, texture, 1);
			}
			else
			{
				SetVehicleVinyl(vehicleid, "", 1);
			}
		}
	}

	HideClothesShopTextDraws(playerid);

	if(TuneWorkshop_IsActive(playerid))
	{
		TuneWorkshop_SetCamera(playerid);
		TogglePlayerControllable(playerid, false);
	}

	g_tune_vinyl_active[playerid] = false;
	g_tune_vinyl_vehicle[playerid] = INVALID_VEHICLE_ID;
	g_tune_vinyl_index[playerid] = 0;
	g_tune_vinyl_prev_vinyl[playerid] = 0;

	if(show_menu)
	{
		ShowTuneShowPlayerDialog(playerid);
	}
	return 1;
}

stock TuneVinyl_Start(playerid)
{
	if(g_tune_vinyl_active[playerid])
	{
		TuneVinyl_Stop(playerid, false, false);
	}

	new vehicleid = GetPlayerOwnableCar(playerid);
	if(vehicleid == INVALID_VEHICLE_ID)
	{
		return SendClientMessage(playerid, -1, ""USC"ичнй транспорт не найден.");
	}

	g_tune_vinyl_vehicle[playerid] = vehicleid;
	g_tune_vinyl_prev_color1[playerid] = 1;
	g_tune_vinyl_prev_color2[playerid] = 1;

	new own_index = GetVehicleData(vehicleid, V_ACTION_ID);
	g_tune_vinyl_prev_vinyl[playerid] = 0;
	if(own_index != -1)
	{
		g_tune_vinyl_prev_color1[playerid] = GetOwnableCarData(own_index, OC_COLOR_1);
		g_tune_vinyl_prev_color2[playerid] = GetOwnableCarData(own_index, OC_COLOR_2);
		g_tune_vinyl_prev_vinyl[playerid] = GetOwnableCarData(own_index, OC_VINILCAR);
	}

	if(g_tune_vinyl_prev_color1[playerid] <= 0) g_tune_vinyl_prev_color1[playerid] = 1;
	if(g_tune_vinyl_prev_color2[playerid] <= 0) g_tune_vinyl_prev_color2[playerid] = 1;

	if(1 <= g_tune_vinyl_prev_vinyl[playerid] <= TUNE_VINYL_COUNT)
	{
		g_tune_vinyl_index[playerid] = g_tune_vinyl_prev_vinyl[playerid];
	}
	else
	{
		g_tune_vinyl_index[playerid] = 1;
	}

	g_tune_vinyl_active[playerid] = true;

	ChangeVehicleColor(vehicleid, 1, 1);
	SetCameraBehindPlayer(playerid);
	TogglePlayerControllable(playerid, true);

	CreateClothesShopTextDraws(playerid);
	TuneVinyl_UpdatePanel(playerid);
	TuneVinyl_ApplyPreview(playerid);
	return 1;
}

stock TuneVinyl_Buy(playerid)
{
	if(!g_tune_vinyl_active[playerid]) return 0;

	if(GetPlayerMoneyEx(playerid) < TUNE_PRICE_VINYL)
	{
		SendClientMessage(playerid, -1, ""USC"едостаточно средств дл покупки винила.");
		return 1;
	}

	new vehicleid = g_tune_vinyl_vehicle[playerid];
	if(!IsValidVehicle(vehicleid))
	{
		SendClientMessage(playerid, -1, ""USC"ранспорт недоступен.");
		return 1;
	}

	new vinyl_id = g_tune_vinyl_index[playerid];
	new texture[16], query[160], own_sql = Tune_GetPlayerOwnableSql(playerid);
	TuneVinyl_BuildTexture(vinyl_id, texture, sizeof texture);

	GivePlayerMoneyEx(playerid, -TUNE_PRICE_VINYL, "винил", true, true);
	Tune_SendSpentNotice(playerid, TUNE_PRICE_VINYL);

	if(own_sql > 0)
	{
		mysql_format(mysql, query, sizeof query, "UPDATE ownable_cars SET vinilcar='%d' WHERE id='%d' LIMIT 1", vinyl_id, own_sql);
		mysql_query(mysql, query, false);
	}

	if(IsAOwnableCar(vehicleid))
	{
		new own_index = GetVehicleData(vehicleid, V_ACTION_ID);
		if(own_index != -1)
		{
			SetOwnableCarData(own_index, OC_VINILCAR, vinyl_id);
		}
	}

	SetVehicleVinyl(vehicleid, texture, 1);
	SendClientMessage(playerid, -1, ""SC"инил успешно установлен!");
	TuneVinyl_Stop(playerid, true, true);
	return 1;
}

stock bool:TuneVinyl_HandleTextDrawClick(playerid, Text:clickedid)
{
	if(!g_tune_vinyl_active[playerid]) return false;

	if(clickedid == shop_clothes_TD[1] || clickedid == shop_clothes_TD[14])
	{
		if(++g_tune_vinyl_index[playerid] > TUNE_VINYL_COUNT)
		{
			g_tune_vinyl_index[playerid] = 1;
		}
		TuneVinyl_UpdatePanel(playerid);
		TuneVinyl_ApplyPreview(playerid);
		return true;
	}

	if(clickedid == shop_clothes_TD[0] || clickedid == shop_clothes_TD[13])
	{
		if(--g_tune_vinyl_index[playerid] < 1)
		{
			g_tune_vinyl_index[playerid] = TUNE_VINYL_COUNT;
		}
		TuneVinyl_UpdatePanel(playerid);
		TuneVinyl_ApplyPreview(playerid);
		return true;
	}

	if(clickedid == shop_clothes_TD[2] || clickedid == shop_clothes_TD[15])
	{
		TuneVinyl_Buy(playerid);
		return true;
	}

	if(clickedid == shop_clothes_TD[3] || clickedid == shop_clothes_TD[16] || clickedid == Text:INVALID_TEXT_DRAW)
	{
		TuneVinyl_Stop(playerid, false, true);
		return true;
	}

	return true;
}
