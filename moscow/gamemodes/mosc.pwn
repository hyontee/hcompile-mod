    return 1;
}


public OnPlayerSpawn(playerid)
{
    g_PlayerNumberPickupDialogShown[playerid] = false;
    LoadAccessory(playerid);
    #if defined name_OnPlayerSpawn
        return name_OnPlayerSpawn(playerid);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnPlayerSpawn
    #undef OnPlayerSpawn
#else
    #define _ALS_OnPlayerSpawn
#endif
#define OnPlayerSpawn name_OnPlayerSpawn
#if defined name_OnPlayerSpawn
    forward name_OnPlayerSpawn(playerid);
#endif


public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(clickedid == button_TD[4]) //вперед
    {
        new acs = pl_accessory[playerid];
        if(acs < sizeof accessory-1)
        {
            DestroyPlayerObject(playerid, pl_id_accessory[playerid]);

            pl_id_accessory[playerid] = CreatePlayerObject(playerid, accessory[acs+1][ID_ACCESSORY], 
            2899.104980,1503.386230,2499.062500, 0.0, 0.0, 0.0);

            pl_accessory[playerid] = acs+1;
            SetPriceAccesory(playerid, acs+1);
        }
    }
    if(clickedid == button_TD[7]) //назад
    {
        new acs = pl_accessory[playerid];
        if(acs > 0)
        {
            DestroyPlayerObject(playerid, pl_id_accessory[playerid]);

            pl_id_accessory[playerid] = CreatePlayerObject(playerid, accessory[acs-1][ID_ACCESSORY], 
            2899.104980,1503.386230,2499.062500, 0.0, 0.0, 0.0);

            pl_accessory[playerid] = acs-1;

            SetPriceAccesory(playerid, acs-1);
        }
    }
    if(clickedid == button_TD[11]) //вход
    {
        DestroyPlayerObject(playerid, pl_id_accessory[playerid]);
        pl_id_accessory[playerid] = -1;

        pl_accessory[playerid] = -1;

        for(new i;i < sizeof button_TD;i++) TextDrawHideForPlayer(playerid, button_TD[i]);
        PlayerTextDrawHide(playerid, button_PTD[playerid][0]);

        new in_biz = GetPlayerInBiz(playerid);
        SetPlayerPosEx
        (
            playerid,
            GetBusinessData(in_biz, B_EXIT_POS_X),
            GetBusinessData(in_biz, B_EXIT_POS_Y),
            GetBusinessData(in_biz, B_EXIT_POS_Z),
            GetBusinessData(in_biz, B_EXIT_ANGLE),
            0,
            0
        );
        SetPlayerInBiz(playerid, -1);
        CancelSelectTextDraw(playerid);
        TogglePlayerControllable(playerid, true);
        ShowHud(playerid);
    }
    if(clickedid == button_TD[12]) // купит
{
    new acs = pl_accessory[playerid], price = accessory[acs][PRICE_ACCESSORY], query[128], biz_price = price * 20 / 100;
    if(GetPlayerMoneyEx(playerid) >= price)
    {
        new businessid = GetPlayerInBiz(playerid), take_prods = random(4) + 6;
        if(GetBusinessData(businessid, B_PRODS) >= take_prods)
        {
            format(query, sizeof query, "UPDATE business SET products=%d, balance=%d WHERE id=%d", GetBusinessData(businessid, B_PRODS)-take_prods, GetBusinessData(businessid, B_BALANCE)+biz_price, GetBusinessData(businessid, B_SQL_ID));
            mysql_query(mysql, query, false);
        }
        if(!mysql_errno())
        {
            if(GetBusinessData(businessid, B_PRODS) >= take_prods)
            {
                AddBusinessData(businessid, B_PRODS, -, take_prods);
                AddBusinessData(businessid, B_BALANCE, +, biz_price);
            }
            mysql_format(mysql, query, sizeof query, "INSERT INTO business_profit (bid,uid,uip,time,money,view) VALUES (%d,%d,'%e',%d,%d,%d)", GetBusinessData(businessid, B_SQL_ID), GetPlayerAccountID(playerid), GetPlayerIpEx(playerid), gettime(), price, IsBusinessOwned(businessid));
            mysql_query(mysql, query, false);
            GivePlayerMoneyEx(playerid, -price);
            
            // =====     =====
            new acs_model = accessory[acs][ID_ACCESSORY];
            new inventoryItemId = Accessory_GetItemIdByModel(acs_model);
            
            if(inventoryItemId > 0)
            {
                new freeSlot = Inventory_GetFreeSlot(playerid);
                if(freeSlot == -1)
                {
                    ShowNotificationNew(playerid, 2, 7, -1, -1, "ет свободнх слотов в инвентаре!", "");
                }
                else
                {
                    // обавлем аксессуар в инвентар (count = 1)
                    Inventory_AddItem(playerid, inventoryItemId, freeSlot, 1, "");
                    
                    new itemName[64];
                    GetItemName(inventoryItemId, itemName);
                    new msg[128];
                    format(msg, sizeof(msg), " купили %s (слот %d). сползуйте /inv чтоб надет.", itemName, freeSlot);
                    ShowNotificationNew(playerid, 3, 7, -1, -1, msg, "");
                }
            }
            else
            {
                printf("[ERROR] е найден ID инвентар дл аксессуара %d (модел: %d)", acs, acs_model);
                SendClientMessage(playerid, -1, "шибка при добавлении аксессуара в инвентар.");
            }
            // ==============================================
            
            GiveAccessory(playerid, acs);
            AddQuestLineProgress(playerid, 5);
        }
    }
    else SendClientMessage(playerid, -1, " вас недостаточно денег.");
}

if(clickedid == cont_sell)
    {
        new cont = pInfo[playerid][BuyUseCont];
        if(cont < 1 || cont > MAX_CONT) return 1;
        if(IsPlayerInRangeOfPoint(playerid, 4.0, ContBuyTextPos[cont-1][0], ContBuyTextPos[cont-1][1], ContBuyTextPos[cont-1][2]) && cInfo[cont][Saled] == false)
        {
            if(cInfo[cont][BetedId] == playerid)
            {
                new sell_price_string[120];
                new sell_price = cInfo[cont][ItemPrice];
				GivePlayerMoneyEx(playerid, sell_price);

				new money_str[64];
				ConvertMoney(sell_price, money_str);
				format(money_str, sizeof(money_str), " получили %s рублей", money_str);
				ShowNotificationNew(playerid, 1, 6, 0, 0, money_str, " ");

				format(sell_price_string, sizeof(sell_price_string), " {ffffff} успешно продали содержимое контейнера {FF5252}#%d {ffffff}за {FF5252}%d {FF5252}рублей!", cont, sell_price);
				SendClientMessage(playerid, CLR_GREEN, sell_price_string);

                TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_SHOW);

                TextDrawHideForPlayer(playerid, cont_fon);
                TextDrawHideForPlayer(playerid, cont_take);
                TextDrawHideForPlayer(playerid, cont_sell);
                TextDrawHideForPlayer(playerid, cont_close);

                TextDrawHideForPlayer(playerid, cont_name[cont]);
                TextDrawHideForPlayer(playerid, cont_price[cont]);
                TextDrawHideForPlayer(playerid, cont_model[cont]);
                CancelSelectTextDraw(playerid);

                DestroyObject(cInfo[cont][ContObjectId]);
                DestroyObject(cInfo[cont][ContObjectOdejdaId]);
                DestroyVehicle(cInfo[cont][ContVehicleId]);
                KillTimer(ContsTimer[cont]);
                ResetContInfo(cont);
                pInfo[playerid][BuyUseCont] = 0;
                pInfo[playerid][BetUseCont] = 0;

                SetTimerEx("SpawnNewCont", 5000, false, "i", cont);
            }
        }
    }
    if(clickedid == cont_take)
    {
        new cont = pInfo[playerid][BuyUseCont];
        if(cont < 1 || cont > MAX_CONT) return 1;
        if(IsPlayerInRangeOfPoint(playerid, 4.0, ContBuyTextPos[cont-1][0], ContBuyTextPos[cont-1][1], ContBuyTextPos[cont-1][2]) && cInfo[cont][Saled] == false)
        {
            if(cInfo[cont][BetedId] == playerid)
            {
                if (cInfo[cont][ItemType] == 1)
                {
                    BuyPlayerSkin(playerid, cInfo[cont][Item], cInfo[cont][Item] );
                    SendClientMessage(playerid, CLR_GREEN, " {ffffff} получили новй скин из контейнера!");
                }
                else if (cInfo[cont][ItemType] == 2)
                {
                    new car_modelid = cInfo[cont][Item];
                    new car_color = cInfo[cont][ContVehicleColor];
                    new Float: pos_x = 13.035842;
                    new Float: pos_y = 2549.344482;
                    new Float: pos_z = 10.876162;
                    new Float: angle = 358.785644;
                    new query[256], Cache: result;

                    format(query, sizeof query, "INSERT INTO ownable_cars (owner_id, model_id, color_1, color_2, pos_x, pos_y, pos_z, angle, create_time) VALUES ('%d', '%d', '%d', '%d', '%f', '%f', '%f', '%f', '%d')",
                        GetPlayerAccountID(playerid), car_modelid, car_color, car_color, pos_x, pos_y, pos_z, angle, gettime());

                    result = mysql_query(mysql, query, true);
                    cache_delete(result);
                    SendClientMessage(playerid, CLR_GREEN, "{ffffff}оздравлем!  получили новй автомобил из контейнера!");
                }

                TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_SHOW);

                TextDrawHideForPlayer(playerid, cont_fon);
                TextDrawHideForPlayer(playerid, cont_take);
                TextDrawHideForPlayer(playerid, cont_sell);
                TextDrawHideForPlayer(playerid, cont_close);

                TextDrawHideForPlayer(playerid, cont_name[cont]);
                TextDrawHideForPlayer(playerid, cont_price[cont]);
                TextDrawHideForPlayer(playerid, cont_model[cont]);
                CancelSelectTextDraw(playerid);

                DestroyObject(cInfo[cont][ContObjectId]);
                DestroyObject(cInfo[cont][ContObjectOdejdaId]);
                DestroyVehicle(cInfo[cont][ContVehicleId]);
                KillTimer(ContsTimer[cont]);
                ResetContInfo(cont);
                pInfo[playerid][BuyUseCont] = 0;
                pInfo[playerid][BetUseCont] = 0;

                SetTimerEx("SpawnNewCont", 5000, false, "i", cont);
            }
        }
    }

    if(clickedid == cont_close)
    {
        TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_SHOW);

        TextDrawHideForPlayer(playerid, cont_fon);
        TextDrawHideForPlayer(playerid, cont_take);
        TextDrawHideForPlayer(playerid, cont_sell);
        TextDrawHideForPlayer(playerid, cont_close);
        CancelSelectTextDraw(playerid);

        for(new cont=1; cont <= MAX_CONT; cont++)
        {
            TextDrawHideForPlayer(playerid, cont_name[cont]);
            TextDrawHideForPlayer(playerid, cont_price[cont]);
            TextDrawHideForPlayer(playerid, cont_model[cont]);
        }
    }

	if(specnew_Shown[playerid])
    {
        // ----  "" (specnew_TD[0]) ----
        if(clickedid == specnew_TD[0])
        {
            new target_id = GetPlayerSpectateData(playerid, S_PLAYER);
            if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            {
                ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");
                HideSpectatorNewTDs(playerid);
                return 1;
            }

            ShowMuteMenu(playerid, target_id);
            return 1;
        }

        // ----  "" (specnew_TD[1]) ----
        if(clickedid == specnew_TD[1])
        {
            new current_target = GetPlayerSpectateData(playerid, S_PLAYER);
            if(current_target != -1)
            {
                new prev_player = -1;
                new found_current = 0;

                // щем преддущего игрока в списке игроков
                for(new i = current_target - 1; i >= 0; i--)
                {
                    if(IsPlayerConnected(i) && IsPlayerLogged(i) && GetPlayerAdminEx(i) < GetPlayerAdminEx(playerid) && !GetPlayerSecretEx(i))
                    {
                        prev_player = i;
                        break;
                    }
                }

                // сли не нашли преддущего, ищем с конца
                if(prev_player == -1)
                {
                    for(new i = MAX_PLAYERS - 1; i > current_target; i--)
                    {
                        if(IsPlayerConnected(i) && IsPlayerLogged(i) && GetPlayerAdminEx(i) < GetPlayerAdminEx(playerid) && !GetPlayerSecretEx(i))
                        {
                            prev_player = i;
                            break;
                        }
                    }
                }

                if(prev_player != -1)
                {
                    // бновлем слежку на нового игрока
                    new Float:x, Float:y, Float:z, Float:a;
                    GetPlayerPos(playerid, x, y, z);
                    GetPlayerFacingAngle(playerid, a);

                    SetPlayerSpectateData(playerid, S_START_POS_X, x);
                    SetPlayerSpectateData(playerid, S_START_POS_Y, y);
                    SetPlayerSpectateData(playerid, S_START_POS_Z, z);
                    SetPlayerSpectateData(playerid, S_START_ANGLE, a);
                    SetPlayerSpectateData(playerid, S_START_INTERIOR, GetPlayerInterior(playerid));
                    SetPlayerSpectateData(playerid, S_START_VIRTUAL_WORLD, GetPlayerVirtualWorld(playerid));

                    StartSpectateWerton(playerid, prev_player);
                    UpdateSpecInfo(playerid, prev_player);
                    ShowNotificationNew(playerid, 3, 5, -1, -1, "лежка переключена на преддущего игрока.", "");
                }
                else
                {
                    ShowNotificationNew(playerid, 2, 5, -1, -1, "ет доступнх игроков дл переключени.", "");
                }
            }
            return 1;
        }

        // ----  "Ё" (specnew_TD[2]) ----
        if(clickedid == specnew_TD[2])
        {
            new current_target = GetPlayerSpectateData(playerid, S_PLAYER);
            if(current_target != -1)
            {
                new next_player = -1;

                // щем следующего игрока в списке игроков
                for(new i = current_target + 1; i < MAX_PLAYERS; i++)
                {
                    if(IsPlayerConnected(i) && IsPlayerLogged(i) && GetPlayerAdminEx(i) < GetPlayerAdminEx(playerid) && !GetPlayerSecretEx(i))
                    {
                        next_player = i;
                        break;
                    }
                }

                // сли не нашли следующего, ищем с начала
                if(next_player == -1)
                {
                    for(new i = 0; i < current_target; i++)
                    {
                        if(IsPlayerConnected(i) && IsPlayerLogged(i) && GetPlayerAdminEx(i) < GetPlayerAdminEx(playerid) && !GetPlayerSecretEx(i))
                        {
                            next_player = i;
                            break;
                        }
                    }
                }

                if(next_player != -1)
                {
                    // бновлем слежку на нового игрока
                    new Float:x, Float:y, Float:z, Float:a;
                    GetPlayerPos(playerid, x, y, z);
                    GetPlayerFacingAngle(playerid, a);

                    SetPlayerSpectateData(playerid, S_START_POS_X, x);
                    SetPlayerSpectateData(playerid, S_START_POS_Y, y);
                    SetPlayerSpectateData(playerid, S_START_POS_Z, z);
                    SetPlayerSpectateData(playerid, S_START_ANGLE, a);
                    SetPlayerSpectateData(playerid, S_START_INTERIOR, GetPlayerInterior(playerid));
                    SetPlayerSpectateData(playerid, S_START_VIRTUAL_WORLD, GetPlayerVirtualWorld(playerid));

                    StartSpectateWerton(playerid, next_player);
                    UpdateSpecInfo(playerid, next_player);
                    ShowNotificationNew(playerid, 3, 5, -1, -1, "лежка переключена на следующего игрока.", "");
                }
                else
                {
                    ShowNotificationNew(playerid, 2, 5, -1, -1, "ет доступнх игроков дл переключени.", "");
                }
            }
            return 1;
        }

        // ----  "" (specnew_TD[3]) ----
        if(clickedid == specnew_TD[3])
        {
            new target_id = GetPlayerSpectateData(playerid, S_PLAYER);
            if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            {
                ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");
                HideSpectatorNewTDs(playerid);
                return 1;
            }

            ShowKickMenu(playerid, target_id);
            return 1;
        }

        // ----  "" (specnew_TD[4]) ----
        if(clickedid == specnew_TD[4])
        {
            new target_id = GetPlayerSpectateData(playerid, S_PLAYER);
            if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            {
                ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");
                HideSpectatorNewTDs(playerid);
                return 1;
            }

            ShowJailMenu(playerid, target_id);
            return 1;
        }

        // ----  "" (specnew_TD[5]) ----
        if(clickedid == specnew_TD[5])
        {
            new target_id = GetPlayerSpectateData(playerid, S_PLAYER);
            if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            {
                ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");
                HideSpectatorNewTDs(playerid);
                return 1;
            }

            // арн вдаетс толко с причиной
            Dialog
            (
                playerid, 5000, DIALOG_STYLE_INPUT,
                "{FF5A5A}дмин меню |{FFFFFF} дача варна",
                "{FFFFFF}ведите причину дл вдачи варна игроку {FFFF00}"#target_id" {FFFFFF}({FFFF00}%s{FFFFFF}):",
                "дат", "тмена"
            );
            SetPVarInt(playerid, "spec_target_for_warn", target_id);
            return 1;
        }

        // ----  "" (specnew_TD[6]) ----
        if(clickedid == specnew_TD[6])
        {
            new target_id = GetPlayerSpectateData(playerid, S_PLAYER);
            if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            {
                ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");
                HideSpectatorNewTDs(playerid);
                return 1;
            }

            ShowSlapMenu(playerid, target_id);
            return 1;
        }

        // ----  "" (specnew_TD[7]) ----
        if(clickedid == specnew_TD[7])
        {
            new target_id = GetPlayerSpectateData(playerid, S_PLAYER);
            if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
            {
                ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");
                HideSpectatorNewTDs(playerid);
                return 1;
            }

            ShowBanMenu(playerid, target_id);
            return 1;
        }

        // ----  "" (specnew_TD[8]) ----
        if(clickedid == specnew_TD[8])
        {
            new target_id = GetPlayerSpectateData(playerid, S_PLAYER);
            if(IsPlayerConnected(target_id) && IsPlayerLogged(target_id))
            {
                // ерезапускаем слежку дл обновлени
                new Float:x, Float:y, Float:z, Float:a;
                GetPlayerPos(playerid, x, y, z);
                GetPlayerFacingAngle(playerid, a);

                SetPlayerSpectateData(playerid, S_START_POS_X, x);
                SetPlayerSpectateData(playerid, S_START_POS_Y, y);
                SetPlayerSpectateData(playerid, S_START_POS_Z, z);
                SetPlayerSpectateData(playerid, S_START_ANGLE, a);
                SetPlayerSpectateData(playerid, S_START_INTERIOR, GetPlayerInterior(playerid));
                SetPlayerSpectateData(playerid, S_START_VIRTUAL_WORLD, GetPlayerVirtualWorld(playerid));

                StartSpectateWerton(playerid, target_id);
                UpdateSpecInfo(playerid, target_id);
                ShowNotificationNew(playerid, 3, 5, -1, -1, "нформаци об игроке обновлена.", "");
            }
            else
            {
                ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");
                HideSpectatorNewTDs(playerid);
            }
            return 1;
        }

        // ----  "" (specnew_TD[10]) ----
        if(clickedid == specnew_TD[10])
        {
            callcmd::spoff(playerid, "");
            return 1;
        }
    }
    if(clickedid == acss_TD[1])
    {
        AccessoryEdit_Close(playerid, true);
        return 1;
    }
    if(clickedid == acss_TD[2])
    {
        if(!AccessoryEdit_Close(playerid, true)) return 1;
        SendClientMessage(playerid, -1, "ксессуар успешно сохранен.");
        return 1;
    }

	if(_:(clickedid) >= _:(acss_TD[3]) && _:(clickedid) <= _:(acss_TD[9]))
	{
		new TD = -1;
		for(new i = 3; i < 10;i++) if(clickedid == acss_TD[i]) TD = i;
        if(TD == -1) return 1;
		new td_use = GetPVarInt(playerid, "acss_TD_use"), count_TD = TD - 3, Float:float_count;
		TextDrawHideForPlayer(playerid, acss_TD[9 + td_use]);
		TextDrawShowForPlayer(playerid, acss_TD[2 + td_use]);
		TextDrawHideForPlayer(playerid, acss_TD[16 + td_use]);
		TextDrawHideForPlayer(playerid, acss_TD[3 + count_TD]);
		TextDrawShowForPlayer(playerid, acss_TD[10 + count_TD]);
		TextDrawShowForPlayer(playerid, acss_TD[17 + count_TD]);
		SetPVarInt(playerid, "acss_TD_use", count_TD+1);

		switch(TD)
		{
			case 3:float_count = GetPVarFloat(playerid, "edit_x");
			case 4:float_count = GetPVarFloat(playerid, "edit_y");
			case 5:float_count = GetPVarFloat(playerid, "edit_z");
			case 6:float_count = GetPVarFloat(playerid, "edit_scale");
			case 7:float_count = GetPVarFloat(playerid, "edit_rX");
			case 8:float_count = GetPVarFloat(playerid, "edit_rY");
			case 9:float_count = GetPVarFloat(playerid, "edit_rZ");
		}
		
		new acs_coords[11];
		format(acs_coords, sizeof acs_coords, "%.3f", float_count);
		PlayerTextDrawSetString(playerid, acss_coords_PTD[playerid][0], acs_coords);
        return 1;
	}
	if(clickedid == acss_TD[24] || clickedid == acss_TD[25])
	{
		return AccessoryEdit_HandleArrowClick(playerid, clickedid == acss_TD[24]);
	}
    #if defined btn_OnPlayerClickTextDraw
        return btn_OnPlayerClickTextDraw(playerid, clickedid);
    #else
        return 1;
    #endif
}
#if defined _ALS_OnPlayerClickTextDraw
    #undef OnPlayerClickTextDraw
#else
    #define _ALS_OnPlayerClickTextDraw
#endif
#define OnPlayerClickTextDraw btn_OnPlayerClickTextDraw
#if defined btn_OnPlayerClickTextDraw
    forward btn_OnPlayerClickTextDraw(playerid, Text:clickedid);
#endif


stock AccessoryEdit_DestroyArrowPTD(playerid)
{
    for(new i; i < 2; i++)
    {
        if(acss_arrow_PTD[playerid][i] == PlayerText:-1) continue;
        PlayerTextDrawHide(playerid, acss_arrow_PTD[playerid][i]);
        PlayerTextDrawDestroy(playerid, acss_arrow_PTD[playerid][i]);
        acss_arrow_PTD[playerid][i] = PlayerText:-1;
    }
    return 1;
}


stock bool:AccessoryEdit_Save(playerid)
{
    if(GetPVarType(playerid, "gordeev_acs_editor"))
    {
        return AccessoryEditor_SaveGordeev(playerid);
    }

    new query[320];

    mysql_format
    (
        mysql,
        query,
        sizeof query,
        "UPDATE accessories_players SET acs_id=%d, bone=%d, x=%f, y=%f, z=%f, rX=%f, rY=%f, rZ=%f, scale=%f WHERE player_id=%d AND slot=%d LIMIT 1",
        GetPVarInt(playerid, "acs_id"),
        GetPVarInt(playerid, "bone"),
        GetPVarFloat(playerid, "edit_x"),
        GetPVarFloat(playerid, "edit_y"),
        GetPVarFloat(playerid, "edit_z"),
        GetPVarFloat(playerid, "edit_rX"),
        GetPVarFloat(playerid, "edit_rY"),
        GetPVarFloat(playerid, "edit_rZ"),
        GetPVarFloat(playerid, "edit_scale"),
        GetPlayerAccountID(playerid),
        GetPVarInt(playerid, "slot")
    );

    mysql_query(mysql, query, false);
    return !mysql_errno();
}

stock AccessoryEdit_Close(playerid, bool:save = false)
{
    if(save && !AccessoryEdit_Save(playerid))
    {
        new save_error[96];
        if(GetPVarType(playerid, "acs_save_errno"))
        {
            format(save_error, sizeof save_error, "е удалос сохранит аксессуар тест. E:%d", GetPVarInt(playerid, "acs_save_errno"));
            SendClientMessage(playerid, -1, save_error);
        }
        else SendClientMessage(playerid, -1, "е удалос сохранит аксессуар. тест");
        return false;
    }

    for(new i; i < sizeof acss_TD; i++)
    {
        TextDrawHideForPlayer(playerid, acss_TD[i]);
    }

    DeletePVar(playerid, "acs_use");
    DeletePVar(playerid, "acss_TD_use");
    DeletePVar(playerid, "slot");
    DeletePVar(playerid, "acs_id");
    DeletePVar(playerid, "bone");

    DeletePVar(playerid, "edit_y");
    DeletePVar(playerid, "edit_z");
    DeletePVar(playerid, "edit_x");
    DeletePVar(playerid, "edit_rX");
    DeletePVar(playerid, "edit_rY");
    DeletePVar(playerid, "edit_rZ");
    DeletePVar(playerid, "edit_scale");
    DeletePVar(playerid, "edit_modelid");
    DeletePVar(playerid, "acs_save_errno");
    DeletePVar(playerid, "gordeev_acs_editor");

    PlayerTextDrawHide(playerid, acss_coords_PTD[playerid][0]);
    AccessoryEdit_DestroyArrowPTD(playerid);
    CancelSelectTextDraw(playerid);

    TogglePlayerControllable(playerid, true);
    TogglePlayerAllHudElements(playerid, HUD_ELEMENT_SHOW);
    return true;
}

stock AccessoryEdit_CreateArrowPTD(playerid)
{
    AccessoryEdit_DestroyArrowPTD(playerid);

    // For some launchers fully transparent sprite TDs do not catch clicks.
    // Low-alpha box zones are more stable while staying visually invisible.
    acss_arrow_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 460.0000, 205.0000, "_");
    PlayerTextDrawLetterSize(playerid, acss_arrow_PTD[playerid][0], 0.0000, 0.0000);
    PlayerTextDrawTextSize(playerid, acss_arrow_PTD[playerid][0], 510.0000, 255.0000);
    PlayerTextDrawAlignment(playerid, acss_arrow_PTD[playerid][0], 1);
    PlayerTextDrawColor(playerid, acss_arrow_PTD[playerid][0], 0x00000000);
    PlayerTextDrawUseBox(playerid, acss_arrow_PTD[playerid][0], true);
    PlayerTextDrawBoxColor(playerid, acss_arrow_PTD[playerid][0], 0x00000001);
    PlayerTextDrawBackgroundColor(playerid, acss_arrow_PTD[playerid][0], 255);
    PlayerTextDrawFont(playerid, acss_arrow_PTD[playerid][0], 1);
    PlayerTextDrawSetProportional(playerid, acss_arrow_PTD[playerid][0], 0);
    PlayerTextDrawSetShadow(playerid, acss_arrow_PTD[playerid][0], 0);
    PlayerTextDrawSetSelectable(playerid, acss_arrow_PTD[playerid][0], true);
    PlayerTextDrawShow(playerid, acss_arrow_PTD[playerid][0]);

    acss_arrow_PTD[playerid][1] = CreatePlayerTextDraw(playerid, 530.0000, 205.0000, "_");
    PlayerTextDrawLetterSize(playerid, acss_arrow_PTD[playerid][1], 0.0000, 0.0000);
    PlayerTextDrawTextSize(playerid, acss_arrow_PTD[playerid][1], 580.0000, 255.0000);
    PlayerTextDrawAlignment(playerid, acss_arrow_PTD[playerid][1], 1);
    PlayerTextDrawColor(playerid, acss_arrow_PTD[playerid][1], 0x00000000);
    PlayerTextDrawUseBox(playerid, acss_arrow_PTD[playerid][1], true);
    PlayerTextDrawBoxColor(playerid, acss_arrow_PTD[playerid][1], 0x00000001);
    PlayerTextDrawBackgroundColor(playerid, acss_arrow_PTD[playerid][1], 255);
    PlayerTextDrawFont(playerid, acss_arrow_PTD[playerid][1], 1);
    PlayerTextDrawSetProportional(playerid, acss_arrow_PTD[playerid][1], 0);
    PlayerTextDrawSetShadow(playerid, acss_arrow_PTD[playerid][1], 0);
    PlayerTextDrawSetSelectable(playerid, acss_arrow_PTD[playerid][1], true);
    PlayerTextDrawShow(playerid, acss_arrow_PTD[playerid][1]);
    return 1;
}

stock AccessoryEdit_HandleArrowClick(playerid, bool:increase)
{
    if(!GetPVarType(playerid, "acss_TD_use")) return 0;

    new Float: x, Float: y, Float: z, Float: scale, Float: Rx, Float: Ry, Float: Rz, acs_coords[11];

    switch(GetPVarInt(playerid, "acss_TD_use"))
    {
        case 1:
        {
            if(increase)
            {
                if(GetPVarFloat(playerid, "edit_x") >= 0.500000) return 1;
                x += 0.01;
            }
            else
            {
                if(GetPVarFloat(playerid, "edit_x") <= -0.500000) return 1;
                x -= 0.01;
            }
            format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "edit_x") + x);
        }
        case 2:
        {
            if(increase)
            {
                if(GetPVarFloat(playerid, "edit_y") >= 1.000000) return 1;
                y += 0.01;
            }
            else
            {
                if(GetPVarFloat(playerid, "edit_y") <= -1.000000) return 1;
                y -= 0.01;
            }
            format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "edit_y") + y);
        }
        case 3:
        {
            if(increase)
            {
                if(GetPVarFloat(playerid, "edit_z") >= 0.500000) return 1;
                z += 0.01;
            }
            else
            {
                if(GetPVarFloat(playerid, "edit_z") <= -0.500000) return 1;
                z -= 0.01;
            }
            format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "edit_z") + z);
        }
        case 4:
        {
            if(increase)
            {
                if(GetPVarFloat(playerid, "edit_scale") >= 2.000000) return 1;
                scale += 0.1;
            }
            else
            {
                if(GetPVarFloat(playerid, "edit_scale") <= 0.100000) return 1;
                scale -= 0.1;
            }
            format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "edit_scale") + scale);
        }
        case 5:
        {
            if(increase)
            {
                if(GetPVarFloat(playerid, "edit_rX") >= 360.000000) SetPVarFloat(playerid, "edit_rX", -5.000000);
                Rx += 5.0;
            }
            else
            {
                if(GetPVarFloat(playerid, "edit_rX") <= -360.000000) SetPVarFloat(playerid, "edit_rX", 5.000000);
                Rx -= 5.0;
            }
            format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "edit_rX") + Rx);
        }
        case 6:
        {
            if(increase)
            {
                if(GetPVarFloat(playerid, "edit_rY") >= 360.000000) SetPVarFloat(playerid, "edit_rY", -5.000000);
                Ry += 5.0;
            }
            else
            {
                if(GetPVarFloat(playerid, "edit_rY") <= -360.000000) SetPVarFloat(playerid, "edit_rY", 5.000000);
                Ry -= 5.0;
            }
            format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "edit_rY") + Ry);
        }
        case 7:
        {
            if(increase)
            {
                if(GetPVarFloat(playerid, "edit_rZ") >= 360.000000) SetPVarFloat(playerid, "edit_rZ", -5.000000);
                Rz += 5.0;
            }
            else
            {
                if(GetPVarFloat(playerid, "edit_rZ") <= -360.000000) SetPVarFloat(playerid, "edit_rZ", 5.000000);
                Rz -= 5.0;
            }
            format(acs_coords, sizeof acs_coords, "%.3f", GetPVarFloat(playerid, "edit_rZ") + Rz);
        }
    }

    PlayerTextDrawHide(playerid, acss_coords_PTD[playerid][0]);
    PlayerTextDrawSetString(playerid, acss_coords_PTD[playerid][0], acs_coords);
    PlayerTextDrawShow(playerid, acss_coords_PTD[playerid][0]);

    SetPVarFloat(playerid, "edit_x", GetPVarFloat(playerid, "edit_x") + x);
    SetPVarFloat(playerid, "edit_y", GetPVarFloat(playerid, "edit_y") + y);
    SetPVarFloat(playerid, "edit_z", GetPVarFloat(playerid, "edit_z") + z);
    SetPVarFloat(playerid, "edit_rX", GetPVarFloat(playerid, "edit_rX") + Rx);
    SetPVarFloat(playerid, "edit_rY", GetPVarFloat(playerid, "edit_rY") + Ry);
    SetPVarFloat(playerid, "edit_rZ", GetPVarFloat(playerid, "edit_rZ") + Rz);
    SetPVarFloat(playerid, "edit_scale", GetPVarFloat(playerid, "edit_scale") + scale);

    new model_id = GetPVarType(playerid, "edit_modelid") ? GetPVarInt(playerid, "edit_modelid") : accessory[GetPVarInt(playerid, "acs_id")][ID_ACCESSORY];

    SetPlayerAttachedObject
    (
        playerid,
        GetPVarInt(playerid, "slot"),
        model_id,
        GetPVarInt(playerid, "bone"),
        GetPVarFloat(playerid, "edit_x"),
        GetPVarFloat(playerid, "edit_y"),
        GetPVarFloat(playerid, "edit_z"),
        GetPVarFloat(playerid, "edit_rX"),
        GetPVarFloat(playerid, "edit_rY"),
        GetPVarFloat(playerid, "edit_rZ"),
        GetPVarFloat(playerid, "edit_scale"),
        GetPVarFloat(playerid, "edit_scale"),
        GetPVarFloat(playerid, "edit_scale")
    );
    return 1;
}

