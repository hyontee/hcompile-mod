            return ShowNotificationNew(playerid, 2, 5, -1, -1, "грок болше не на сервере.", "");

        new reason_time[128];
        format(reason_time, sizeof(reason_time), "%s", inputtext);
        if(!strlen(reason_time))
            return ShowNotificationNew(playerid, 2, 5, -1, -1, " не ввели причину и врем.", "");

        new minutes = 5;
        new reason[64];
        if(sscanf(reason_time, "d s[64]", minutes, reason))
        {
            format(reason, sizeof(reason), "%s", reason_time);
            minutes = 5;
        }

        if(minutes < 1 || minutes > 360) minutes = 5;

        new params[128];
        format(params, sizeof(params), "%d %d %s", target_id, minutes, reason);
        callcmd::jail(playerid, params);

        return 1;
    }

