public OnGameModeExit()
{
    // ===== Я    =====
    SaveAllVehiclesFuel();
    printf("[FUEL] : охранено топливо всех авто при завершении");
    // =====================================

	    if(g_WeatherTimer != -1)
    {
        KillTimer(g_WeatherTimer);
        g_WeatherTimer = -1;
    }
    
    SaveRepository();
    foreach(new i : Player)
    {
        Inventory_Save(i);
        SavePlayerSimCards(i);
        SavePlayerAccount(i);
    }
    if (gstream) SvDeleteStream(gstream);
    if(mysql > 0) mysql_close(mysql);
    return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK);

	if(IsPlayerLogged(playerid))
	{
		SetPlayerSpawnInit(playerid);
	}
	return 1;
}

public OnPlayerRequestSpawn(playerid)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK);

	if(!IsPlayerLogged(playerid))
	{
		new a_state = GetPlayerData(playerid, P_ACCOUNT_STATE);
		if(a_state != ACCOUNT_STATE_REG_SKIN)
		{
			new fmt_str[64];
			format(fmt_str, sizeof fmt_str, "{FFFFFF}л игр на сервере  должн %s", a_state == ACCOUNT_STATE_REGISTER ? ("пройти регистрацию") : ("авторизироватс"));

			Dialog
			(
				playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
				"{FF6600}шибка",
				fmt_str,
				"акрт", ""
			);
			Kick:(playerid);
			SendClientMessage(playerid, 0xFF6600FF, fmt_str[8]);
		}
	}
	else if(IsPlayerLogged(playerid))
	{
	}

	return 1;
}

public OnPlayerConnect(playerid)
{
	TogglePlayerAllDynamicCPs(playerid, false);
	acss_arrow_PTD[playerid][0] = PlayerText:-1;
	acss_arrow_PTD[playerid][1] = PlayerText:-1;

	timeduel[playerid] = 11;
	CreateAvtosalonTextDraws(playerid);
    CreatePlayerTextDrawSpMenu(playerid);	
    Training_OnPlayerConnect(playerid);
	g_wound_sent_to_hospital[playerid] = false;

	for(new i = 0; i < MAX_SVETFORS; i++)
{
    PlayerTrafficLightFine[playerid][i] = 0;
}
	

	if(TEST_SERVER == 1) SendClientMessage(playerid, -1, ""SC" находитес на тест сервере проекта за 1000 руб!");
	new fmt_text[128];
	format(fmt_text, sizeof fmt_text, "%s[%d] подключилс к серверу. IP: %s", GetPlayerNameEx(playerid), playerid, GetPlayerIpEx(playerid));
    SendMessageToAdmins(fmt_text, 0x999999FF);
	
	new hour, minute;
	gettime(hour, minute);
	times[playerid] = true;
	
	SetPlayerTime(playerid, hour, minute);
	
 	PlayerIsDalnoboi[playerid] = 0;
	PlayerIsInkasator[playerid] = 0;
	PlayerDMZArena[playerid] = 0;

	SetPlayerColor(playerid, 0x999999FF);

	SetPlayerVirtualWorld(playerid, playerid + 0xFF);
	ClearPlayerInfo(playerid);
	g_PlayerWhitelistDenied[playerid] = false;
g_PlayerNumberPickupDialogShown[playerid] = false;
	SetPlayerData(playerid, P_DMZ_STATUS, 0);
	SetPlayerData(playerid, P_DMZ_KILL1, 0);
	g_DMZKills[playerid] = 0;
	g_DMZDeaths[playerid] = 0;
	g_DMZTD_Shown[playerid] = false;
	g_DMZTD_Created[playerid] = false;
	g_DMZRespawnPending[playerid] = false;
	g_DMZSpawnSlot[playerid] = -1;
	for(new slot = 0; slot < 13; slot++)
	{
		g_DMZBackupWeaponID[playerid][slot] = 0;
		g_DMZBackupWeaponAmmo[playerid][slot] = 0;
	}
	CreateDMZPlayerTextDraws(playerid);
	GetPlayerName(playerid, g_player[playerid][P_NAME], MAX_PLAYER_NAME);
	GetPlayerIp(playerid, g_player[playerid][P_IP], 16);

	//ShowGangZonesForPlayer(playerid);

	#if defined _GANG_ZONES_INC
	//ShowForPlayerGangZonesCR(playerid);
	#endif

	InitFly(playerid);

	// ============================================================
	//     ( )
	// ============================================================
	PlayAudioStreamURL(playerid, "http://bh-audio-cdn.srv00.com/event/spring/menu_screen.mp3");
	g_player_music_playing[playerid] = true;
	// ============================================================

	SetTimerEx("CheckPlayerAccount", 1000, false, "ii", playerid, mysql_race[playerid]);
	return 1;
}

public OnPlayerDisconnect(playerid, reason)
{
    g_PlayerNumberPickupDialogShown[playerid] = false;
	if(g_PlayerWhitelistDenied[playerid])
	{
		g_PlayerWhitelistDenied[playerid] = false;
g_PlayerNumberPickupDialogShown[playerid] = false;
		ClearPlayerInfo(playerid);
		return 1;
	}

    report_OnPlayerDisconnect(playerid);
    TurnSignal_OnPlayerDisconnect(playerid);
    AccessoryEdit_DestroyArrowPTD(playerid);
    Training_OnPlayerDisconnect(playerid);
	Inventory_Save(playerid);
	SavePlayerSimCards(playerid);
	g_wound_sent_to_hospital[playerid] = false;
    
    if (lstream[playerid])
    {
        SvDeleteStream(lstream[playerid]);
        lstream[playerid] = SV_NULL;
    }

	if(GetPVarType(playerid, "biz_auction_money"))
{
    new biz_id = -1;
    // щем активнй аукцион этого игрока
    for(new i = 0; i < MAX_BUSINESS; i++)
    {
        if(g_BizAuctionActive[i] && g_BizAuctionBidder[i] == playerid)
        {
            biz_id = i;
            break;
        }
    }
    
    if(biz_id != -1)
    {
        // озвращаем денги
        new money = GetPVarInt(playerid, "biz_auction_money");
        GivePlayerMoneyEx(playerid, money, "озврат ставки (вход)", true, true);
        
        // тключаем аукцион
        g_BizAuctionActive[biz_id] = false;
        g_BizAuctionBidder[biz_id] = INVALID_PLAYER_ID;
        g_BizAuctionPrice[biz_id] = 0;
        if(g_BizAuctionTimer[biz_id] != -1)
        {
            KillTimer(g_BizAuctionTimer[biz_id]);
            g_BizAuctionTimer[biz_id] = -1;
        }
        
        DeletePVar(playerid, "biz_auction_money");
    }
}

	    if(g_PlayerWounded[playerid])
    {
        ClearPlayerWounded(playerid);
    }

	   if(g_PlayerSubwooferActive[playerid])
    {
        foreach(new i : Player)
        {
            if(GetPVarInt(i, "subwoofer_listening") && GetPVarInt(i, "subwoofer_source") == playerid)
            {
                StopAudioStream(i);
                DeletePVar(i, "subwoofer_listening");
                DeletePVar(i, "subwoofer_source");
            }
        }
        
        if(g_SubwooferLabel[playerid] != Text3D:INVALID_3DTEXT_ID)
        {
            DestroyDynamic3DTextLabel(g_SubwooferLabel[playerid]);
            g_SubwooferLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
        }
        g_PlayerSubwooferActive[playerid] = false;
        g_PlayerSubwooferVehicle[playerid] = INVALID_VEHICLE_ID;
        StopAudioStream(playerid);
    }

	SetPlayerData(playerid, P_WORK_DAY_DELIVERY, 0);

	if(g_RefuelTimer[playerid] != -1)
    {
        KillTimer(g_RefuelTimer[playerid]);
        g_RefuelTimer[playerid] = -1;
    }
    g_PlayerRefueling[playerid] = false;
    g_RefuelAmount[playerid] = 0.0;
    g_RefuelVehicle[playerid] = INVALID_VEHICLE_ID;

	    if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
    {
        SaveVehicleFuel(GetPlayerOwnableCar(playerid));
        printf("[FUEL] : охранено топливо дл игрока %s", GetPlayerNameEx(playerid));
    }
    //SaveAdminPrefix(playerid);
    //vehidtun[playerid] = 0;
    launch[playerid] = 0;
    nitro[playerid] = 0;
    tune_highlight[playerid] = 0;
    tune_stroboscope[playerid] = 0;
    g_tune_vinyl_active[playerid] = false;
    g_tune_vinyl_vehicle[playerid] = INVALID_VEHICLE_ID;
    g_tune_vinyl_index[playerid] = 0;
    g_tune_vinyl_prev_vinyl[playerid] = 0;
    PlayerIsDalnoboi[playerid] = 0;
	PlayerIsInkasator[playerid] = 0;
	PlayerDMZArena[playerid] = 0;
	g_player_music_playing[playerid] = false;

if(GetPlayerData(playerid, P_YOUTUBE))
{
    SetPlayerData(playerid, P_YT_LOGGED, 0);
}

if(g_PlayerTakingMat[playerid])
    {
        StopTakingMaterials(playerid);
    }

if(g_FarmerCombineVehicle[playerid] != INVALID_VEHICLE_ID)
    {
        DestroyVehicle(g_FarmerCombineVehicle[playerid]);
        g_FarmerCombineVehicle[playerid] = INVALID_VEHICLE_ID;
    }
    
    // озвращаем старй скин если бл
    if(g_FarmerOldSkin[playerid] > 0)
    {
        // е можем установит скин оффлайн игроку, но сохраним в  если нужно
        g_FarmerOldSkin[playerid] = 0;
    }
    
    g_FarmerWorkStarted[playerid] = false;
    g_FarmerJob[playerid] = FARMER_JOB_NONE;
    g_FarmerCurrentZone[playerid] = -1;
    g_FarmerPickupCooldown[playerid] = 0;

    if(GetPVarType(playerid, "PlacedBB"))
    {
        //DestroyDynamicObject(GetPVarInt(playerid, "PlacedBB"));
    	DestroyDynamic3DTextLabel(Text3D:GetPVarInt(playerid, "BBLabel"));
        if(GetPVarType(playerid, "BBArea"))
        {
            foreach(Player,i)
            {
                if(IsPlayerInDynamicArea(i, GetPVarInt(playerid, "BBArea")))
                {
                    StopAudioStream(i);
                    SendClientMessage(i, COLOR_LIGHTBLUE, "ладелец бумбокса отключилс от сервера.");
                }
            }
        }
    }

		for(new i = 1; i <  GetVehiclePoolSize() + 1; i++)
	{
		DestroyDynamic3DTextLabel(Veh_3DTEXT[playerid][i]);
		Veh_3DTEXT[playerid][i] = Text3D:0;
	}

	DebugPlayer[playerid] = false;
    
    PlayerTextDrawDestroy(playerid, gAdminTimeTextDraw[playerid]);

	if(g_DMZTD_Created[playerid])
	{
		HideDMZTD(playerid);
		PlayerTextDrawDestroy(playerid, g_CAPTUREDM_TD_KILLS[playerid]);
		PlayerTextDrawDestroy(playerid, g_CAPTUREDM_TD_DEATHS[playerid]);
		g_CAPTUREDM_TD_KILLS[playerid] = PlayerText:-1;
		g_CAPTUREDM_TD_DEATHS[playerid] = PlayerText:-1;
		g_DMZTD_Created[playerid] = false;
		g_DMZTD_Shown[playerid] = false;
	}
    
	new buffer = GetPlayerLastVehicle(playerid);
	
	if(buffer != INVALID_VEHICLE_ID)
	{
		if(GetVehicleData(buffer, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_DRIVING_SCH)
		{
			if(GetPlayerDrivingExamInfo(playerid, DE_POINTS) >= 9)
			{
				SetVehicleToRespawn(buffer);
			}
		}
	}
	if(IsPlayerInJob(playerid))
	{
		buffer = GetPlayerJobCar(playerid);
		if(buffer != INVALID_VEHICLE_ID)
		{
			SetVehicleToRespawn(buffer);
		}

		if(GetPlayerData(playerid, P_ORDER) != -1)
			SetOrderData(GetPlayerData(playerid, P_ORDER), O_USED, false);
	}
	KillEndJobTimer(playerid);

	buffer = GetPlayerData(playerid, P_FACTORY_USE_DESK);
	SetPlayerFactoryDeskUse(playerid, buffer, false);

	if(GetPlayerData(playerid, P_OCCUPIED_BED) != -1)
	{
		ClearMedBed(playerid, GetPlayerData(playerid, P_OCCUPIED_BED));
	}

	if(GetPlayerData(playerid, P_FRACTION_CAR) != INVALID_VEHICLE_ID)
    {
        DestroyVehicle(GetPlayerData(playerid, P_FRACTION_CAR));
        SetPlayerData(playerid, P_FRACTION_CAR, INVALID_VEHICLE_ID);
    }

    if(GetPlayerData(playerid, P_BUY_CAR) != INVALID_VEHICLE_ID)
    {
        DestroyVehicle(GetPlayerData(playerid, P_BUY_CAR));
        SetPlayerData(playerid, P_BUY_CAR, INVALID_VEHICLE_ID);
    }

	if(GetPlayerTeamEx(playerid) == TEAM_GOVERNMENT && IsValidDynamic3DTextLabel(GetPlayerData(playerid, P_ADVISOR_LABEL)))
	{
		DestroyDynamic3DTextLabel(GetPlayerData(playerid, P_ADVISOR_LABEL));
		SetPlayerData(playerid, P_ADVISOR_LABEL, Text3D: -1);
	}

	if(IsValidDynamic3DTextLabel(GetPlayerData(playerid, P_ADMIN_LABEL)))
	{
		DestroyDynamic3DTextLabel(GetPlayerData(playerid, P_ADMIN_LABEL));
		SetPlayerData(playerid, P_ADMIN_LABEL, Text3D: -1);
	}

	if(GetPlayerOwnableCar(playerid) != INVALID_VEHICLE_ID)
	{
		if(SaveOwnableCar(GetPlayerOwnableCar(playerid)) != -1)
			UnloadPlayerOwnableCar(playerid, true);
	}

	if(GetPlayerRentCar(playerid) != INVALID_VEHICLE_ID)
	{
		SetVehicleToRespawn(GetPlayerRentCar(playerid));
	}
	if(GetPlayerData(playerid, P_RENT_BIKE) != INVALID_VEHICLE_ID)
    {
        DestroyVehicle(GetPlayerData(playerid, P_RENT_BIKE));
        SetPlayerData(playerid,  P_RENT_BIKE, INVALID_VEHICLE_ID);
    }

	OnPlayerDisconnectAndSpawn(playerid, reason);

	new fmt_text[95];

	if(GetPlayerData(playerid, P_CUFFED) && reason != 2)
	{
		new jail_time = (GetPlayerSuspect(playerid) * 5 + 30) * 60;

		SetPlayerData(playerid, P_JAIL, jail_time);
		UpdatePlayerDatabaseInt(playerid, "jail", jail_time);

		SetPlayerData(playerid, P_SUSPECT, 0);
		UpdatePlayerDatabaseInt(playerid, "suspect", 0);

		format(fmt_text, sizeof fmt_text, "%s входит при аресте (+30 минут заключени)", GetPlayerNameEx(playerid));
		SendClientMessageToAll(0xFF5533FF, fmt_text);
	}

	for(new idx; idx < g_advert_created; idx ++)
	{
		if(GetAdvertData(idx, A_CREATOR) != playerid) continue;

		DeleteAdvert(idx);
	}

	if(!server_restart)
	{

		SetPlayerData(playerid, P_ADMIN_LOGGED, 0);
	}

	SavePlayerAccount(playerid);
	ClearPlayerInfo(playerid);
	g_PlayerWhitelistDenied[playerid] = false;
g_PlayerNumberPickupDialogShown[playerid] = false;
	SetPlayerData(playerid, P_DMZ_STATUS, 0);
	SetPlayerData(playerid, P_DMZ_KILL1, 0);
	g_DMZKills[playerid] = 0;
	g_DMZDeaths[playerid] = 0;
	g_DMZTD_Shown[playerid] = false;
	g_DMZTD_Created[playerid] = false;
	g_DMZRespawnPending[playerid] = false;
	g_DMZSpawnSlot[playerid] = -1;
	for(new slot = 0; slot < 13; slot++)
	{
		g_DMZBackupWeaponID[playerid][slot] = 0;
		g_DMZBackupWeaponAmmo[playerid][slot] = 0;
	}
	CreateDMZPlayerTextDraws(playerid);
	UpdateSpectate(playerid, true);
	return 1;
}

public: SavePlayerAccount(playerid)
{
	if(GetPlayerAccountID(playerid) <= 0 || !IsPlayerLogged(playerid) || !GetPVarInt(playerid, "account_loaded")) return 0;

	new query[370];

	mysql_format
(
    mysql, query, sizeof query,
    "UPDATE accounts SET last_login=%d,game_for_hour=%d,game_for_day=%d,game_for_day_prev=%d,\
    exp=%d,health=%f,hospital=%d,mute=%d,jail=%d,fmute=%d,training_stage=%d, online = 0 WHERE id=%d LIMIT 1",
    gettime(),
    GetPlayerData(playerid, P_GAME_FOR_HOUR),
    GetPlayerData(playerid, P_GAME_FOR_DAY),
    GetPlayerData(playerid, P_GAME_FOR_DAY_PREV),
    GetPlayerData(playerid, P_EXP),
    GetPlayerData(playerid, P_HEALTH),
    GetPlayerData(playerid, P_HOSPITAL),
    GetPlayerData(playerid, P_MUTE),
    GetPlayerData(playerid, P_JAIL),
    GetPlayerData(playerid, P_FMUTE),
    g_TrainingStage[playerid],  // <--  
    GetPlayerAccountID(playerid)
);

	mysql_query(mysql, query, false);

	return 1;
}

public OnPlayerSpawn(playerid)
{
    g_PlayerNumberPickupDialogShown[playerid] = false;
    if(GetPlayerData(playerid, P_DMZ_STATUS) != 1)
    {
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
    }

    g_wound_sent_to_hospital[playerid] = false;
    SetPlayerX2(playerid, 24, 24);

	    if(g_PlayerSubwooferActive[playerid])
    {
        callcmd::suboff(playerid, "");
    }

     if(g_PlayerWounded[playerid])
    {
        // озвращаем на место ранени
        SetPlayerPos(playerid, 
            g_WoundPosition[playerid][0], 
            g_WoundPosition[playerid][1], 
            g_WoundPosition[playerid][2]);
        
        // рименем анимацию
        ApplyAnimationEx(playerid, "SWAT", "gnstwall_injurd", 4.0, 1, 0, 0, 0, 0, 1, USE_ANIM_TYPE_NONE - 1);
        
        // амораживаем
        TogglePlayerControllable(playerid, false);
        SetTimerEx("ReloadSpawnAccessories", 200, false, "i", playerid);
        
        return 1;
    }
	    
    if(TEST_SERVER == 1) SendClientMessage(playerid, -1, "{ffff00}| {ffffff} находитес на  . ведите {ffff00}/test{ffffff} дл получени админки");
    
    PlayerPlayStream(playerid, "");
    // станавливаем музку при спавне
    if(g_player_music_playing[playerid])
    {
        StopAudioStream(playerid);
        g_player_music_playing[playerid] = false;
        printf("[DEBUG] узка остановлена дл %d через StopAudioStream", playerid);
    }

	if(GetPlayerData(playerid, P_WORK_DAY) == 1 && GetPlayerData(playerid, P_OSKIN) > 0)
    {
        SetPlayerSkin(playerid, GetPlayerData(playerid, P_OSKIN));
        SetPlayerColorInit(playerid);
    }

    OnPlayerDisconnectAndSpawn(playerid, -1);
    
    if(!IsValidDynamic3DTextLabel(g_player[playerid][P_ADMIN_LABEL]) && GetPlayerData(playerid, P_3D_PREFIX))
    {
        g_player[playerid][P_ADMIN_LABEL] = CreateDynamic3DTextLabel("дминистратор", 0xFFCC33FF, 0.0, 0.0, 0.3, 10.0, playerid);
        Attach3DTextLabelToPlayer(g_player[playerid][P_ADMIN_LABEL], playerid, 0.0, 0.0, -0.8);
    }

    if(GetPlayerData(playerid, P_YOUTUBE) && !GetPlayerData(playerid, P_YT_LOGGED))
    {
        YouTubeAuthorization(playerid);
    }

    CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
    
    PlayerIsDalnoboi[playerid] = 0;
    PlayerIsInkasator[playerid] = 0;

    SetPlayerData(playerid, P_IN_HOUSE,         -1);
    SetPlayerData(playerid, P_IN_BUSINESS,      -1);
    SetPlayerData(playerid, P_IN_HOTEL_FLOOR,   -1);
    SetPlayerData(playerid, P_IN_HOTEL_ROOM,    -1);
    SetPlayerData(playerid, P_IN_ENTRANCE,      -1);
    SetPlayerData(playerid, P_IN_ENTRANCE_FLOOR,-1);

    SetPlayerSkillsInit(playerid);

    if(!IsPlayerLogged(playerid))
    {
        if(GetPlayerData(playerid, P_ACCOUNT_STATE) == ACCOUNT_STATE_REG_SKIN)
        {
            new sex = bool: GetPlayerSex(playerid);

            TogglePlayerControllable(playerid, false);
            SetPlayerSelectSkin(playerid, 0, reg_skin_data[sex][0]);

            SetPlayerPosEx(playerid, -315.9291, 828.0271, 13.0958, 184.6198, 0, _, false);

            SetPlayerCameraPos(playerid, -315.6234, 820.1765, 14.5766);
            SetPlayerCameraLookAt(playerid, -315.8497, 821.1492, 14.4216);

            ShowPlayerSelectPanel(playerid, SELECT_PANEL_TYPE_REG_SKIN);

            PlayerTextDrawSetString(playerid, price_select_TD[playerid][0], SERVER_NAME);
        }
    }
    else
    {
        if(GetPlayerData(playerid, P_DMZ_STATUS) != 1)
        {
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);
        }

        SetPlayerSpawnPos(playerid);

        if(GetPlayerData(playerid, P_HOSPITAL)) SetPlayerHealthEx(playerid, 15.0);

        if(!GetPlayerData(playerid, P_ANIMS_INIT))
        {
            PreLoadPlayerAnims(playerid);
            SetPlayerData(playerid, P_ANIMS_INIT, true);
        }

        if(GetPlayerData(playerid, P_MASK) >= 2)
        {
            SetPlayerColorInit(playerid);
            SetPlayerData(playerid, P_MASK, 0);
        }
    }

    SetTimerEx("ReloadSpawnAccessories", 200, false, "i", playerid);

    return 1;
}

forward ReloadSpawnAccessories(playerid);
public ReloadSpawnAccessories(playerid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid))
    {
        return 0;
    }

    LoadAccessory(playerid);
    return 1;
}

public OnPlayerDeath(playerid, killerid, reason)
{
    SetCameraBehindPlayer(playerid);
    
    CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
    PlayerIsDalnoboi[playerid] = 0;
    PlayerIsInkasator[playerid] = 0;

    // =====   =====
    // роверем, не в DM зоне ли игрок
    if(GetPlayerData(playerid, P_DMZ_STATUS) != 1)
    {
        // : тключаем автоматический спавн
        SetPlayerData(playerid, P_SPAWN, -1);
        SetPlayerSpawnInit(playerid);
        
        // охранем позицию смерти
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        g_WoundPosition[playerid][0] = x;
        g_WoundPosition[playerid][1] = y;
        g_WoundPosition[playerid][2] = z;
        
        // елепортируем обратно на место смерти (на случай если спавн сработал)
        SetPlayerPos(playerid, x, y, z);
        
        // рименем анимацию
        ApplyAnimationEx(playerid, "SWAT", "gnstwall_injurd", 4.0, 1, 0, 0, 0, 0, 1, USE_ANIM_TYPE_NONE - 1);
        
        // амораживаем игрока
        TogglePlayerControllable(playerid, false);
        
        // станавливаем состоние ранени
        g_PlayerWounded[playerid] = true;
        g_WoundNeedHelpTimer[playerid] = 0;
        
        // оздаем 3D текст над игроком
        if(IsValidDynamic3DTextLabel(g_WoundLabel[playerid]))
        {
            DestroyDynamic3DTextLabel(g_WoundLabel[playerid]);
        }
        
        new label_text[128];
        format(label_text, sizeof(label_text), "{FFFF00}Я Я\n{FFFFFF}одойдите дл оказани помощи");
        g_WoundLabel[playerid] = CreateDynamic3DTextLabel(
            label_text,
            0xFFFF00FF,
            x, y, z + 1.5,
            15.0,
            INVALID_PLAYER_ID,
            INVALID_VEHICLE_ID,
            0,
            0,
            -1,
            15.0
        );
        
        // аймер дл автоматической госпитализации через 60 секунд
        if(g_WoundTimer[playerid] != -1)
        {
            KillTimer(g_WoundTimer[playerid]);
        }
        g_WoundTimer[playerid] = SetTimerEx("AutoHospitalizePlayer", 60000, false, "i", playerid);
        
        // оказваем GUI ранени
        if(killerid != INVALID_PLAYER_ID && killerid != playerid && IsPlayerConnected(killerid))
        {
            ShowWoundSystemGUI(playerid, killerid);
        }
        
        printf("[WOUND] грок %s[%d] ранен. озици: %.2f, %.2f, %.2f", 
            GetPlayerNameEx(playerid), playerid, x, y, z);
        
        // : озвращаем 1, чтоб предотвратит стандартнй спавн
        return 1;
    }

	    if(g_PlayerSubwooferActive[playerid])
    {
        callcmd::suboff(playerid, "");
    }

    // =====  =====
    if(g_FarmerWorkStarted[playerid] && g_FarmerJob[playerid] == FARMER_JOB_COMBINE)
    {
        if(g_FarmerCombineVehicle[playerid] != INVALID_VEHICLE_ID)
        {
            DestroyVehicle(g_FarmerCombineVehicle[playerid]);
            g_FarmerCombineVehicle[playerid] = INVALID_VEHICLE_ID;
        }
        
        if(g_FarmerOldSkin[playerid] > 0)
        {
            SetPlayerSkin(playerid, g_FarmerOldSkin[playerid]);
            g_FarmerOldSkin[playerid] = 0;
        }
        
        g_FarmerWorkStarted[playerid] = false;
        g_FarmerJob[playerid] = FARMER_JOB_NONE;
        DisablePlayerCheckpoint(playerid);
        SendClientMessage(playerid, 0xFF6600FF, " покинули работу из-за смерти!");
    }

    // =====   =====
    if(!IsPlayerLogged(playerid))
    {
        return Kick:(playerid, " ");
    }

    // =====  =====
    if(IsPlayerInJob(playerid))
    {
        EndPlayerJob(playerid);
    }
    if(GetPlayerTempJob(playerid) == TEMP_JOB_LOADER)
    {
        TogglePlayerDynamicCP(playerid, help_info_CP, true);
    }

    // =====   =====
    if(GetPlayerData(playerid, P_OCCUPIED_BED) != -1)
    {
        ClearMedBed(playerid, GetPlayerData(playerid, P_OCCUPIED_BED));
    }

    // =====   =====
    SetPlayerData(playerid, P_JOB_CAR, INVALID_VEHICLE_ID);
    SetPlayerDrivingExamInfo(playerid, DE_POINTS, 0);
    SetPlayerFactoryDeskUse(playerid, GetPlayerData(playerid, P_FACTORY_USE_DESK), false);
    SetPlayerData(playerid, P_IN_HOUSE, -1);
    SetPlayerData(playerid, P_IN_BUSINESS, -1);
    SetPlayerData(playerid, P_IN_HOTEL_FLOOR, -1);
    SetPlayerData(playerid, P_IN_HOTEL_ROOM, -1);
    SetPlayerData(playerid, P_IN_ENTRANCE, -1);
    SetPlayerData(playerid, P_IN_ENTRANCE_FLOOR, -1);

    // ===== DM ZONE =====
    if(GetPlayerData(playerid, P_DMZ_STATUS) == 1)
    {
        if(!g_DMZRespawnPending[playerid])
        {
            g_DMZRespawnPending[playerid] = true;
            SetPlayerData(playerid, P_DMZ_KILL1, GetPlayerData(playerid, P_DMZ_KILL1) + 1);
            UpdateDMZDeaths(playerid, GetPlayerData(playerid, P_DMZ_KILL1));
            
            if(killerid != INVALID_PLAYER_ID && killerid != playerid && GetPlayerData(killerid, P_DMZ_STATUS) == 1)
            {
                SetPlayerData(killerid, P_DMZ_KILL, GetPlayerData(killerid, P_DMZ_KILL) + 1);
                g_DMZKills[killerid]++;
                UpdatePlayerDatabaseInt(killerid, "dmz_kills", GetPlayerData(killerid, P_DMZ_KILL));
                UpdateDMZKills(killerid, g_DMZKills[killerid]);
                
                new dmz_msg[144];
                format(dmz_msg, sizeof dmz_msg, "{FFFFFF}грок {FFFF00}%s {FFFFFF}убил игрока {FFFF00}%s {FFFFFF}сего убийств: {FFFF00}%d", 
                    GetPlayerNameEx(killerid), GetPlayerNameEx(playerid), g_DMZKills[killerid]);
                DMZ_SendToPlayers(0xFFFFFFFF, dmz_msg);
            }
            SetTimerEx("DMZ_RespawnPlayer", 250, false, "d", playerid);
        }
        return 1;
    }

    // =====   =====
    new fmt_text[120];
    if(killerid == INVALID_PLAYER_ID || reason >= 47 || !reason)
    {
        format(fmt_text, sizeof fmt_text, "[A] %s[%d] убил себ", GetPlayerNameEx(playerid), playerid);
        SendMessageToAdmins(fmt_text, 0x999999FF);
    }
    else
    {
        format(fmt_text, sizeof fmt_text, "[A] %s[%d] убил %s[%d] (%s)", 
            GetPlayerNameEx(killerid), killerid, GetPlayerNameEx(playerid), playerid, GetWeaponName(reason));
        SendMessageToAdmins(fmt_text, 0x999999FF);
    }

    // ===== Я  =====
    if(killerid != INVALID_PLAYER_ID)
    {
        if(GetPlayerSuspect(playerid) && IsPlayerInPoliceTeam(killerid))
        {
            format(fmt_text, sizeof fmt_text, "[сем постам] %s %s нейтрализовал преступника %s", 
                GetPlayerJobAndRankName(killerid), GetPlayerNameEx(killerid), GetPlayerNameEx(playerid));
            SendMessageToPoliceTeam(fmt_text, 0x00CCFFFF);

            JailPlayer(playerid, GetPlayerSuspect(playerid) * 5);
            SetPlayerData(playerid, P_SUSPECT, 0);
            UpdatePlayerDatabaseInt(playerid, "suspect", 0);
            SetPlayerSuspectInit(playerid);

            SendClientMessage(playerid, 0x66CC33FF, " бли нейтрализован сотрудником правоохранителнх органов");
            SendClientMessage(playerid, 0xCECECEFF, "рем до окончани заключени: {CCCC00}/time");
        }

        // =====   =====
        if(g_capture[C_STATUS])
        {
            if(TEAM_OPG_ARZAMASKAYA <= GetPlayerTeamEx(killerid) <= TEAM_OPG_LYTKARINSKAYA)
            {
                new area_id = GetGangZoneData(g_capture[C_GANG_ZONE], GZ_AREA);

                if(IsPlayerInDynamicArea(killerid, area_id) && IsPlayerInDynamicArea(playerid, area_id))
                {
                    new gang_id[2];

                    gang_id[0] = (GetPlayerTeamEx(killerid) - TEAM_OPG_ARZAMASKAYA) + 1;
                    gang_id[1] = (GetPlayerTeamEx(playerid) - TEAM_OPG_ARZAMASKAYA) + 1;

                    if(gang_id[0] == g_capture[C_ATTACK_TEAM] && gang_id[1] == g_capture[C_PROTECT_TEAM])
                        g_capture[C_ATTACKER_KILLS] ++;

                    else if(gang_id[0] == g_capture[C_PROTECT_TEAM] && gang_id[1] == g_capture[C_ATTACK_TEAM])
                        g_capture[C_PROTECTOR_KILLS] ++;
                        
                    AddPlayerData(killerid, P_CAPT_KILL, +, 1);
                    UpdatePlayerDatabaseInt(killerid, "capt_kills", GetPlayerData(killerid, P_CAPT_KILL));
                    
                    AddPlayerData(killerid, P_F_QUEST_EXP_2, +, 1);
                    UpdatePlayerDatabaseInt(killerid, "FracQuestExp2", GetPlayerData(killerid, P_F_QUEST_EXP_2));

                    if(GetPlayerData(killerid, P_F_QUEST_EXP_2) == 30)
                    {
                        SendClientMessage(killerid, COR_QUEST, "[вест]: "c_b" успешно вполнили квест "c_i"' лучше всех'. "c_b"аграда: "c_s"1 CASE(/opencase)");

                        AddPlayerData(killerid, P_DONATE_CASE, +, 1);
                        UpdatePlayerDatabaseInt(killerid, "case", GetPlayerData(killerid, P_DONATE_CASE));

                        SetPlayerData(killerid, P_F_QUEST_2, 1);
                        UpdatePlayerDatabaseInt(killerid, "FracQuest2", 1);
                        
                        AddPlayerData(killerid, P_TOP_5, +, 1);
                        UpdatePlayerDatabaseInt(killerid, "TOP_Quest", GetPlayerData(killerid, P_TOP_5));
                    }
                }
            }
        }
    }

    // =====   =====
    if(GetPlayerData(playerid, P_BUY_CAR) != INVALID_VEHICLE_ID)
    {
        DestroyVehicle(GetPlayerData(playerid, P_BUY_CAR));
        SetPlayerData(playerid, P_BUY_CAR, INVALID_VEHICLE_ID);
        HideAutosalonTextDraws(playerid);
    }

    // =====   =====
    if(GetPlayerRentCar(playerid) != INVALID_VEHICLE_ID)
    {
        new vehicleid = GetPlayerRentCar(playerid);
        rent_cars_data[vehicleid - first_rent_car_id][rent_car_tenant_id] = INVALID_PLAYER_ID;
        SetVehicleToRespawn(vehicleid);
        SetPlayerData(playerid, P_RENT_CAR, INVALID_VEHICLE_ID);
    }

    // =====    =====
    SetPlayerJobLoadItems(playerid, 0);
    SetPlayerTempJob(playerid, TEMP_JOB_NONE);
    SetPlayerSpawnInit(playerid);

    return 1;
}

public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
{
	new Float: health;

	if(issuerid == INVALID_PLAYER_ID) return 1;

	if(GetPVarInt(playerid, ""))
	{
		new green_zone_id = GetPVarInt(playerid, "player_in_green_zone") - 1;

		if(!(TEAM_DPS <= GetPlayerTeamEx(issuerid) <= TEAM_FBI))
		{
			ClearPlayerAnim(issuerid);

			new fmt_text[220];

			format
			(
				fmt_text, sizeof fmt_text,
				"{FFFFFF}"\
				"редупреждение:\n\n"\
				"грок находитс в зеленой зоне '{66CC33}%s{FFFFFF}'\n"\
				"анесение урона запрещено. ри повторнх поптках  будете кикнут.",
				g_green_zones[green_zone_id][GZ_NAME]
			);

			ShowPlayerDialog(issuerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FF5533}елена зона", fmt_text, "акрт", "");

			format(fmt_text, sizeof fmt_text, "[A] %s[%d] попталс ударит %s[%d] в зеленой зоне %s", GetPlayerNameEx(issuerid), issuerid, GetPlayerNameEx(playerid), playerid, g_green_zones[green_zone_id][GZ_NAME]);
			SendMessageToAdmins(fmt_text, 0xFF5533FF);

			return 0;
		}
	}

	if(TEAM_DPS <= GetPlayerTeamEx(issuerid) <= TEAM_FBI)
	{
		if(weaponid == WEAPON_NITESTICK)
		{
			SetPlayerAnimation(playerid, 21);
			TogglePlayerControllable(playerid, false);

			SetTimerEx("UnfreezePlayer", 15000, false, "i", playerid);

			new fmt_text[90];

			format(fmt_text, sizeof fmt_text, " оглушили %s на 15 секунд", GetPlayerNameEx(playerid));
			SendClientMessage(issuerid, 0x3399FFFF, fmt_text);

			format(fmt_text, sizeof fmt_text, "%s оглушил ас на 15 секунд", GetPlayerNameEx(issuerid));
			SendClientMessage(playerid, 0x3399FFFF, fmt_text);

			CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
		}
	}

	if(GetPlayerData(issuerid, P_POWER))
	{
		if(!weaponid)
		{
			new Float: armour,
				Float: taken_health;

			GetPlayerHealth(playerid, health);
			GetPlayerArmour(playerid, armour);

			taken_health = GetPlayerData(issuerid, P_POWER) * 0.05;

			if(armour) SetPlayerArmour(playerid, armour - taken_health);
			else SetPlayerHealth(playerid, health - taken_health);
		}
	}

	return 1;
}

public: UnfreezePlayer(playerid)
{
	ClearAnimations(playerid);
	TogglePlayerControllable(playerid, true);

	return 1;
}

public OnVehicleSpawn(vehicleid)
{
	TurnSignal_OnVehicleSpawn(vehicleid);
	SetVehicleData(vehicleid, V_DRIVER_ID, INVALID_PLAYER_ID);

	if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN_CAR || GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_ORG_CAR)
    {
        if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_ORG_CAR)
        SetPlayerData(GetVehicleData(vehicleid, V_ACTION_OWNER), P_FRACTION_CAR, INVALID_VEHICLE_ID);

        DestroyVehicle(vehicleid);
    }

	if(IsAOwnableCar(vehicleid))
	{
		new index = GetVehicleData(vehicleid, V_ACTION_ID);

		SetVehiclePos
		(
			vehicleid,
			GetOwnableCarData(index, OC_POS_X),
			GetOwnableCarData(index, OC_POS_Y),
			GetOwnableCarData(index, OC_POS_Z)
		);
		SetVehicleZAngle(vehicleid, GetOwnableCarData(index, OC_ANGLE));
	}
	if(IsAFamilyCar(vehicleid))
    {
        new index = GetVehicleData(vehicleid, V_ACTION_ID);

        SetVehiclePos
        (
            vehicleid,
            GetFamilyCarData(index, F_POS_X),
            GetFamilyCarData(index, F_POS_Y),
            GetFamilyCarData(index, F_POS_Z)
        );
        SetVehicleZAngle(vehicleid, GetFamilyCarData(index, F_ANGLE));
    }
	else
	{
		DestroyVehicleLabel(vehicleid);
		SetVehicleData(vehicleid, V_FUEL, 50.0); // 50 литров по умолчанию
LoadVehicleFuel(vehicleid); // агружаем сохраненное топливо
	}
	SetVehicleData(vehicleid, V_LIMIT, true);
	SetVehicleParamsEx(vehicleid, IsABike(vehicleid) ? VEHICLE_PARAM_ON : VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF);

	if(IsAOwnableCar(vehicleid)) SetVehicleHealth(vehicleid, GetVehicleData(vehicleid, V_HEALTH));

	switch(GetVehicleData(vehicleid, V_ACTION_TYPE))
	{
		case
			VEHICLE_ACTION_TYPE_FACTORY,
			VEHICLE_ACTION_TYPE_BUS_DRIVER,
			VEHICLE_ACTION_TYPE_TAXI_DRIVER,
			VEHICLE_ACTION_TYPE_MECHANIC,
			VEHICLE_ACTION_TYPE_TRUCKER:
		{
			SetVehicleData(vehicleid, V_ACTION_ID, VEHICLE_ACTION_ID_NONE);

			foreach(new i : Player)
			{
				if(!IsPlayerConnected(i) || !IsPlayerLogged(i)) continue;
				if(GetPlayerJobCar(i) != vehicleid) continue;

				SetPlayerData(i, P_JOB_CAR, INVALID_VEHICLE_ID);
				SetPlayerData(i, P_RENT_BIKE, INVALID_VEHICLE_ID);
			}
		}
		case VEHICLE_ACTION_TYPE_RENT_BIKE:
        {
            foreach(new i : Player)
            {
                if(!IsPlayerConnected(i) || !IsPlayerLogged(i)) continue;
                if(GetPlayerData(i, P_RENT_BIKE) != vehicleid) continue;
                DestroyVehicle(vehicleid);
                SetPlayerData(i,  P_RENT_BIKE, 0);
                //SendClientMessage(i,-1,"рендованнй / бл возвращен на стонку, договор аренд расторгнут!");
            }
        }


	}
	RestoreOwnableCarColor(vehicleid);
	RestoreFamilyCarColor(vehicleid);

	return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
    TurnSignal_OnVehicleDeath(vehicleid);
    
    // ===== Я     =====
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        SaveVehicleFuel(vehicleid);
    }
    // =============================================
    
    if(GetVehicleCarMarketID(vehicleid) != -1)
        rent_cars_data[vehicleid - first_rent_car_id][rent_car_tenant_id] = INVALID_PLAYER_ID;

    if(IsAOwnableCar(vehicleid)) SetVehicleData(vehicleid, V_HEALTH, 300.0);

    return 1;
}

public OnPlayerText(playerid, text[])
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);

	if(!IsPlayerLogged(playerid)) return 0;

	if(GetPlayerData(playerid, P_MUTE))
	{
		SendClientMessage(playerid, 0xFF6600FF, " не можете исползоват чат во врем мута");

		SetPlayerChatBubble(playerid, "(( MUTED ))", 0xFF5533FF, 10.5, 2000);

		return 0;
	}
 	if(strcmp(text, "q", true) == 0)
    {
		SetPlayerChatBubble(playerid, "оказал(а) распалцовку", 0xFF5533FF, 10.5, 2000);
		Action(playerid, "оказал(а) распалцовку");
        return 0;
 	}
	if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
	{
		SendClientMessage(playerid, 0x6B6B6BFF, "е флудите");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			SendClientMessage(playerid, 0x6B6B6BFF, "ожалуйста, подождите несколко секунд...");

		return 0;
	}
	if(strlen(text) > 90) return 0;

	if(IsAIP(text))
	{
   		SendClientMessage(playerid, -1, "одозрени в рекламе!");
       	return false;
    }

	if(GetPlayerPhoneCall(playerid, PC_TIME) != -1)
	{
		new caller = GetPlayerPhoneCall(playerid, PC_INCOMING_PLAYER);
		new call_to = GetPlayerPhoneCall(playerid, PC_OUTCOMING_PLAYER);

		new fmt_str[128];
		format(fmt_str, sizeof fmt_str, "[ел] %s: %s", GetPlayerNameEx(playerid), text);

		if(call_to != INVALID_PLAYER_ID && playerid == GetPlayerPhoneCall(call_to, PC_INCOMING_PLAYER))
		{
			SendClientMessage(call_to, 0xFFFF00FF, fmt_str);
		}
		else if(caller != INVALID_PLAYER_ID && playerid == GetPlayerPhoneCall(caller, PC_OUTCOMING_PLAYER))
		{
			SendClientMessage(caller, 0xFFFF00FF, fmt_str);
		}
		SendMessageInLocal(playerid, fmt_str, 0x999999FF, 25.0);

		return 0;
	}
	else if(!strcmp(text, "(", true))
	{
		Action(playerid, "расстроилс", _, false);
	}
	else if(!strcmp(text, "((", true))
	{
		if(!IsPlayerInAnyVehicle(playerid))
			ApplyAnimationEx(playerid, "GRAVEYARD", "mrnF_loop", 4.1, false, 0, 0, 0, 0, 0);

		Action(playerid, "силно расстроилс", _, false);
	}
	else if(!strcmp(text, ")", true))
	{
		Action(playerid, "улбаетс", _, false);
	}
	else if(!strcmp(text, "))", true))
	{
		Action(playerid, "смеётс", _, false);
	}
	else if(!strcmp(text, "=0", true))
	{
		Action(playerid, "удивилс", _, false);
	}
	else SendMessageInChat(playerid, text);

	return 0;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
	return 0;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	//SendClientMessage(playerid, -1, ""SC"л включени музки в транспортном средстве исползуйте {ffff00}/music");

	if(CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK))
	{
		SendClientMessage(playerid, 0x6B6B6BFF, "ри продолжении  будете отключен от сервера");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			SendClientMessage(playerid, 0x6B6B6BFF, "ожалуйста, подождите несколко секунд...");
		return 0;
	}

	if(!ispassenger)
	{
		if(!DrivingSchoolPlayerHasAnyCategory(playerid))
		{
			if(!IsABike(vehicleid))
			{
				ClearAnimations(playerid);
				return SendClientMessage(playerid, 0x999999FF, " ас нет прав");
			}
		}

		if(GetPlayerData(playerid, P_CUFFED))
		{
			ClearAnimations(playerid);

			new Float: x, Float: y, Float: z;
			GetPlayerPos(playerid, x, y, z);
			SetPlayerPos(playerid, x, y, z);

			return SendClientMessage(playerid, 0x999999FF, " закован в наручники");
		}

		if(IsPlayerInVehicle(GetVehicleData(vehicleid, V_DRIVER_ID), vehicleid) && GetPlayerState(GetVehicleData(vehicleid, V_DRIVER_ID)) == PLAYER_STATE_DRIVER)
		{
			ClearAnimations(playerid);

			new Float: x, Float: y, Float: z;
			GetPlayerPos(playerid, x, y, z);
			SetPlayerPos(playerid, x, y, z);

			return GameTextForPlayer(playerid, "~r~~h~car is used", 1000, 4);
		}
	}
	return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
	return 1;
}

public: OnPlayerEnterVehicleEx(playerid, vehicleid, is_driver)
{
    SendClientMessage(playerid, -1, ""SC"л включени музки в транспортном средстве исползуйте {ffff00}/music");
    
	SetPlayerData(playerid, P_LAST_VEHICLE, vehicleid);

	new vehicle_type = GetVehicleData(vehicleid, V_ACTION_TYPE);
	new action_id = GetVehicleData(vehicleid, V_ACTION_ID);


	if(is_driver)
	{
		if(!IsABike(vehicleid))
        {
        	if(!GetVehicleParam(vehicleid, V_ENGINE))
		    {
               ShowNotification(playerid, 4, "авести двигател автомобил", 7, "/e", ">>");
			} 
        }
		SetVehicleData(vehicleid, V_DRIVER_ID, playerid);

		if(!GetVehicleParam(vehicleid, V_LOCK))
		{
			if(DrivingSchoolPlayerHasAnyCategory(playerid))
			{
				switch(vehicle_type)
				{
					case VEHICLE_ACTION_ORG_CAR:
		            {
		                new frac_id = GetVehicleData(vehicleid, V_ACTION_ID);
		                if(GetPlayerData(playerid, P_TEAM) != frac_id)
		                {
		                    SendClientMessage(playerid, -1, "{808080}шибка:{FFFFFF} ам не доступен даннй транспорт [ORG]");
		                    ShowNotification(playerid, 2, "ам не доступен даннй транспорт", 5, "", "");
		                    RemovePlayerFromVehicle(playerid);
		                }
		            }
					case VEHICLE_ACTION_TYPE_DRIVING_SCH:
					{
						if(GetPlayerDrivingExamInfo(playerid, DE_POINTS) >= 9)
						{
							SetPVarFloat(playerid, "car_damage", 1000.0);

							SetVehicleParam(vehicleid, V_LOCK, VEHICLE_PARAM_ON);
							NextDrivingExamRouteCP(playerid);

							SendClientMessage(playerid, 0x66CC00FF, "[нструктор] роедтес немного по городу");
							SendClientMessage(playerid, 0xFFFF00FF, "нимание! сли  попадете в аварию или вйдете из машин, экзамен будет завершен");
							SendClientMessage(playerid, 0xFFFFFFFF, "тоб открт ворота подайте {0099FF}звуковой сигнал");
						}
						else
						{
							RemovePlayerFromVehicle(playerid);
							//SendClientMessage(playerid, 0xCECECEFF, "ранспорт принадлежит автошколе");
							ShowNotification(playerid, 2, "ам не доступен даннй транспорт", 5, "", "");
						}
					}
					case VEHICLE_ACTION_TYPE_FACTORY:
					{
						if(GetPlayerTempJob(playerid) == TEMP_JOB_FACTORY_TRUCKER)
						{
							new job_car = GetPlayerJobCar(playerid);

							if(job_car == INVALID_VEHICLE_ID && action_id == VEHICLE_ACTION_ID_NONE)
							{
								new bool: take_car = true;
								switch(GetVehicleData(vehicleid, V_MODELID))
								{
									case 514:
									{
										CreateVehicleLabel(vehicleid, "оставка топлива\n{FFFFFF}агрузка 0 / 8000 л", 0xFF6600FF, 0.0, 2.1, 2.1, 20.0);

										SendClientMessage(playerid, 0x66CC00FF, "рицепите цистерну и отправлйтес на нефтезавод дл закупки топлива");
										SendClientMessage(playerid, 0xFFFFFFFF, "бедитес, что склад не полон и заводу действително необходимо топливо");
									}
									case 498:
									{
										CreateVehicleLabel(vehicleid, "оставка атериала\n{FFFFFF}агрузка 0 / 500 кг", 0x3399FFFF, 0.0, 0.0, 1.8, 20.0);

										SendClientMessage(playerid, 0x66CC00FF, "тправлйтес на шахту, чтоб закупит атериал дл завода");
										SendClientMessage(playerid, 0xFFFFFFFF, "бедитес, что склад не полон и заводу действително нужен атериал");
									}
									default: take_car = false;
								}
								if(take_car)
								{
									SetVehicleData(vehicleid, V_ACTION_ID, true);
									SetPlayerData(playerid, P_JOB_CAR, vehicleid);
								}
							}
							else if(vehicleid != job_car)
							{
								RemovePlayerFromVehicle(playerid);
								SendClientMessage(playerid, 0xCECECEFF, " не можете исползоват этот транспорт в даннй момент");
							}
							else KillEndJobTimer(playerid);
						}
						else
						{
							RemovePlayerFromVehicle(playerid);
							SendClientMessage(playerid, 0xCECECEFF, " не работник служб доставки завода");
						}
					}

					case VEHICLE_ACTION_TYPE_TAXI_DRIVER: // аксист
					{
						if(GetPlayerJob(playerid) == 6)
						{
							new job_car = GetPlayerJobCar(playerid);

							if(!IsPlayerInJob(playerid) && job_car != vehicleid && action_id == VEHICLE_ACTION_ID_NONE)
							{
								Dialog
								(
									playerid, DIALOG_TAXI_RENT_CAR, DIALOG_STYLE_MSGBOX,
									"{FFCD00}аксопарк",
									"{FFFFFF}тоб взт машину, необходимо заплатит городскому таксопарку 200 рублей\n"\
									" действително хотите заключит договор аренд?",
									"а", "ет"
								);
							}
							else if(vehicleid != job_car)
							{
								RemovePlayerFromVehicle(playerid);
								SendClientMessage(playerid, 0xCECECEFF, " не можете исползоват этот транспорт в даннй момент");
							}
							else KillEndJobTimer(playerid);
						}
						else
						{
							RemovePlayerFromVehicle(playerid);
							SendClientMessage(playerid, 0xCECECEFF, " не таксист");
						}
					}

					case VEHICLE_ACTION_TYPE_TRUCKER: // алнобойщик
					{
						if(GetPlayerJob(playerid) == JOB_TRUCKER)
						{
							new job_car = GetPlayerJobCar(playerid);

							if(!IsPlayerInJob(playerid) && job_car != vehicleid && action_id == VEHICLE_ACTION_ID_NONE)
							{
								Dialog
								(
									playerid, DIALOG_TRUCKER_RENT_CAR, DIALOG_STYLE_MSGBOX,
									"{FFCD00}втопарк",
									"{FFFFFF}тоб взт машину, необходимо заплатит городскому автопарку 180 рублей\n"\
									" действително хотите заключит договор аренд?",
									"а", "ет"
								);
							}
							else if(vehicleid != job_car)
							{
								RemovePlayerFromVehicle(playerid);
								SendClientMessage(playerid, 0xCECECEFF, " не можете исползоват этот транспорт в даннй момент");
							}
							else KillEndJobTimer(playerid);
						}
						else
						{
							RemovePlayerFromVehicle(playerid);
							SendClientMessage(playerid, 0xCECECEFF, " не далнобойщик");
						}
					}

					case VEHICLE_ACTION_TYPE_RENT_CAR:
					{
						if(!(playerid == rent_cars_data[vehicleid - first_rent_car_id][rent_car_tenant_id] && GetPlayerRentCar(playerid) == vehicleid))
						{
							TogglePlayerControllable(playerid, false);
							CallLocalFunction("ShowBuyCarInfo", "ii", playerid, vehicleid);
						}
					}
					case VEHICLE_ACTION_TYPE_ADMIN_CAR:
					{
						if(action_id != 1)
						{
							if(!GetPlayerAdminEx(playerid))
							{
								RemovePlayerFromVehicle(playerid);
								SendClientMessage(playerid, 0xCECECEFF, "ам недоступен даннй транспорт");
							}
						}
					}
					case VEHICLE_ACTION_TYPE_FAMILY_CAR:
{
    //  - временно отключено
    // TODO: осстановит проверку семейного транспорта
    return 1;
    
    /*   ()
    action_id = GetVehicleData(vehicleid, V_ACTION_ID);
    new player_family_sql = GetPlayerFamily(playerid, ID_SQL_FAMILY);
    
    if(player_family_sql <= 0 || g_family_car[action_id][F_OWNER_ID] != player_family_sql)
    {
        RemovePlayerFromVehicle(playerid);
        SendClientMessage(playerid, 0xCECECEFF, "ам недоступен даннй транспорт (FAMILY)");
    }
    else if(g_family_car[action_id][F_RANG] > GetPlayerData(playerid, P_FAMILY_RANK))
    {
        RemovePlayerFromVehicle(playerid);
        SendClientMessage(playerid, 0xCECECEFF, "ам недоступен даннй транспорт (RANG)");
    }
    */
}
				}
			}
			else
			{
				if(!IsABike(vehicleid))
				{
					RemovePlayerFromVehicle(playerid);
					SendClientMessage(playerid, 0x999999FF, " ас нет прав");
				}
			}
		}
		else RemovePlayerFromVehicle(playerid);
	}
	else
	{
		if(GetPlayerData(playerid, P_CUFFED)) TogglePlayerControllable(playerid, false);

		switch(vehicle_type)
		{
			case VEHICLE_ACTION_TYPE_BUS_DRIVER, VEHICLE_ACTION_TYPE_TAXI_DRIVER:
			{
				new driver = GetVehicleData(vehicleid, V_DRIVER_ID);
				if(driver != INVALID_PLAYER_ID && IsPlayerInJob(driver) && IsPlayerDriver(driver))
				{
					if(GetPlayerJobCar(driver) == vehicleid && IsPlayerInVehicle(driver, vehicleid))
					{
						new tariff = GetPlayerData(driver, P_JOB_TARIFF);

						if(vehicle_type == VEHICLE_ACTION_TYPE_TAXI_DRIVER)
						{
							if(GetPlayerMoneyEx(playerid) >= tariff)
							{
								new fmt_str[90];
								g_taxi_mileage[playerid] = 0.0;

								format(fmt_str, sizeof fmt_str, "%s сел в ваше такси. четчик включен", GetPlayerNameEx(playerid));
								SendClientMessage(driver, 0x3399FFFF, fmt_str);

								format(fmt_str, sizeof fmt_str, " сели в такси %s. ариф: %d рублей (оплата за кажде 100 м поездки)", GetPlayerNameEx(driver), tariff);
								SendClientMessage(playerid, 0x3399FFFF, fmt_str);

								AddPlayerData(driver, P_JOB_LOAD_ITEMS, +, 1);
							}
							else
							{
								RemovePlayerFromVehicle(playerid);
								SendClientMessage(playerid, 0xFF6600FF, "едостаточно денег дл оплат тарифа");
							}
						}
						else
						{
							if(GetPlayerMoneyEx(playerid) >= tariff)
							{
								AddPlayerData(driver, P_JOB_LOAD_ITEMS, +, 1);
								GivePlayerMoneyEx(driver, tariff, "+ плата проезда в автобусе", true, true);
							}
							else
							{
								RemovePlayerFromVehicle(playerid);
								SendClientMessage(playerid, 0xFF6600FF, "едостаточно денег дл оплат проезда");
							}
						}
					}
				}
			}
		}
	}
	return 1;
}

public: OnPlayerExitVehicleEx(playerid, vehicleid, is_driver)
{

	StopAudioStream(playerid);

	SetPlayerData(playerid, P_LAST_VEHICLE, INVALID_VEHICLE_ID);

	if(is_driver)
	{
		SetVehicleData(vehicleid, V_DRIVER_ID, INVALID_PLAYER_ID);


		if(GetPlayerDrivingExamInfo(playerid, DE_POINTS) >= 9)
		{
			DisablePlayerRaceCheckpoint(playerid);

			if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_DRIVING_SCH)
			{
				SetVehicleToRespawn(vehicleid);
			}
			DrivingSchoolSetLicenseValue(playerid, 0, false);
			ClearPlayerDrivingExamInfo(playerid);

			SendClientMessage(playerid, 0xFF6600FF, " покинули учебнй автомобил");
			SendClientMessage(playerid, 0xFF0000FF, "кзамен провален!");

			DeletePVar(playerid, "car_damage");
		}

		switch(GetVehicleData(vehicleid, V_ACTION_TYPE))
		{
		    case VEHICLE_ACTION_TYPE_RENT_BIKE:
            {
                if(GetPlayerData(playerid, P_RENT_BIKE) != vehicleid) return 1;
                //SendClientMessage(playerid, 0xCECECEFF, " ас ест 40 сек чтоб вернутс в транспорт , после чего он будет удален");
            }
			case VEHICLE_ACTION_TYPE_FACTORY:
			{
				if(GetPlayerTempJob(playerid) == TEMP_JOB_FACTORY_TRUCKER)
				{
					if(GetPlayerJobCar(playerid) == vehicleid)
					{
						StartEndJobTimer(playerid);
						SendClientMessage(playerid, 0xFF6600FF, " ас ест 15 секунд чтоб вернутс в транспорт");
					}
				}
			}
			case VEHICLE_ACTION_TYPE_BUS_DRIVER:
			{
				if(GetPlayerJob(playerid) == JOB_BUS_DRIVER)
				{
					if(IsPlayerInJob(playerid))
					{
						if(GetPlayerJobCar(playerid) == vehicleid)
						{
							StartEndJobTimer(playerid);
							SendClientMessage(playerid, 0xFF6600FF, " ас ест 15 секунд чтоб вернутс в автобус");
						}
					}
				}
			}
			case VEHICLE_ACTION_TYPE_TAXI_DRIVER:
			{
				if(GetPlayerJob(playerid) == 6)
				{
					if(IsPlayerInJob(playerid))
					{
						if(GetPlayerJobCar(playerid) == vehicleid)
						{
							StartEndJobTimer(playerid);
							SendClientMessage(playerid, 0xFF6600FF, " ас ест 15 секунд чтоб вернутс в транспорт");
						}
					}
				}
			}
			case VEHICLE_ACTION_TYPE_MECHANIC:
			{
				if(GetPlayerJob(playerid) == JOB_MECHANIC)
				{
					if(IsPlayerInJob(playerid))
					{
						if(GetPlayerJobCar(playerid) == vehicleid)
						{
							StartEndJobTimer(playerid);
							SendClientMessage(playerid, 0xFF6600FF, " ас ест 15 секунд чтоб вернутс в транспорт");
						}
					}
				}
			}
			case VEHICLE_ACTION_TYPE_TRUCKER:
			{
				if(GetPlayerJob(playerid) == JOB_TRUCKER)
				{
					if(IsPlayerInJob(playerid))
					{
						if(GetPlayerJobCar(playerid) == vehicleid)
						{
							StartEndJobTimer(playerid);
							SendClientMessage(playerid, 0xFF6600FF, " ас ест 15 секунд чтоб вернутс в транспорт");
						}
					}
				}
			}
		}
	}
	else
	{
		if(GetPlayerData(playerid, P_CUFFED)) TogglePlayerControllable(playerid, true);
	}
	RestoreOwnableCarColor(vehicleid);
	RestoreFamilyCarColor(vehicleid);

	return 1;
}

public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
	if(GetVehicleParam(vehicleid, V_ENGINE) == VEHICLE_PARAM_ON && GetPlayerData(playerid, P_IMPROVEMENTS) < 4)
	{
		//SetVehicleParam(vehicleid, V_ENGINE, VEHICLE_PARAM_OFF);
		//GameTextForPlayer(playerid, "~r~~h~engine off", 4000, 6);
		ShowNotification(playerid, 2, " попали в дтп, впред будте окуратнее", 6, "", "");

		new Float: veh_health;

		GetVehicleHealth(vehicleid, veh_health);

		if(IsAOwnableCar(vehicleid))
		{
			SetVehicleData(vehicleid, V_HEALTH, veh_health);

			if(veh_health < 300.0)
			{
				SetVehicleData(vehicleid, V_HEALTH, 300.0);
			}
		}

		switch(GetVehicleData(vehicleid, V_ACTION_TYPE))
		{
			case VEHICLE_ACTION_TYPE_DRIVING_SCH, VEHICLE_ACTION_TYPE_BUS_DRIVER:
			{
				new Float: health = GetPVarFloat(playerid, "car_damage");

				health -= floatabs((health - veh_health));

				SetPVarFloat(playerid, "car_damage", health);
			}
		}
	}
    return 1;
}

