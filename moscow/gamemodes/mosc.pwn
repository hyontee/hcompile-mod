    (
        fmt_text,
        sizeof fmt_text,
        "{FFFFFF}\
        тавка: {009900}1000\n\
        {FFFFFF}аличие: {009900}%d\n\
  		\n\
        {6666CC}ведите количество, которое\n\
         хотите конвертироват в игрове денги:\
        ",
        GetPlayerDonateRub(playerid)
    );

    Dialog(playerid, DIALOG_DONATE_CONVERT, DIALOG_STYLE_INPUT, "{ffcc00}бмен валют (конвертер)", fmt_text, "алее", "азад");
}
