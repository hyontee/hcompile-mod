stock EntryAccessoryMarket(playerid)
{
    pl_accessory[playerid] = 0;
    SetPlayerPosEx(playerid, 2896.610839,1496.067871,2499.343750,355.015014, 1, playerid+1);
    HideHud(playerid);
    TogglePlayerControllable(playerid, false);

   // SetPlayerCameraLookAt(playerid, 2899.593261,1499.915283,2499.343750);

    InterpolateCameraPos(playerid, 2901.951660,1498.124877,2499.343750, 2900.450927,1500.220703,2499.363750, 2000, CAMERA_MOVE);
    InterpolateCameraLookAt(playerid, 2903.739257,1499.161499,2499.343750, 2899.104980,1503.386230,2499.562500, 2000, CAMERA_MOVE);

    pl_id_accessory[playerid] = CreatePlayerObject(playerid, accessory[0][ID_ACCESSORY], 2899.104980,1503.386230,2499.062500, 0.0, 0.0, 0.0);
        
    CreatePlTDButtonBR(playerid);

    SetPriceAccesory(playerid, 0);

    SelectTextDraw(playerid, 0xFF5252FF);
    for(new i;i < sizeof button_TD;i++) TextDrawShowForPlayer(playerid, button_TD[i]);
    PlayerTextDrawShow(playerid, button_PTD[playerid][0]);

    new Float:x, Float:y, Float:z, string[124];
    GetPlayerCameraPos(playerid, x, y, z);
    return 1;
}

stock SetPriceAccesory(playerid, acs)
{
    new string[24];
    format(string, sizeof string, "‰EHA:%d", accessory[acs][PRICE_ACCESSORY]);
    PlayerTextDrawSetString(playerid, button_PTD[playerid][0], string);

    return 1;
}

CMD:myacs(playerid)
{
	new fmt_text[640],
	Cache: result,
	id;

    mysql_format(mysql, fmt_text, sizeof fmt_text, "SELECT * FROM accessory_inventory WHERE player_id='%d'", GetPlayerAccountID(playerid));
    result = mysql_query(mysql, fmt_text, true);

    new rows = cache_num_rows();

    if(!rows) SendClientMessage(playerid, 0x999999FF, " ас нет аксессуаров");
    else
    {	
            new query[78],
                acs, use, acs_use[24];

            format(fmt_text, sizeof fmt_text, "");

            for(new i = 0; i < rows; i ++)
            {
                id = cache_get_field_content_int(i, "id");
                acs = cache_get_field_content_int(i, "acs_id");
                use = cache_get_field_content_int(i, "use");

                if(use > 0) acs_use = "{636363}[исползуетс]";
                else  acs_use = "";

                format
                (
                    query,
                    sizeof query,
                    "{FFFFFF}%d. %s %s\n",
                    i + 1, 
                    accessory[acs][NAME_ACCESSORY], acs_use
                );
                strcat(fmt_text, query);
                SetPlayerListitemValue(playerid, i, id);

                format(query, sizeof query, "acsuse%d", i);
                SetPVarInt(playerid, query, use);
            }

            Dialog
            (
                playerid, 1190, DIALOG_STYLE_LIST,
                "{FFCD00}берите акссесуар",
                fmt_text,
                "брат", "акрт"
            );
    }

    cache_delete(result);

	return 1;
}


public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	if(OnTaksoDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(dialogid == 1190)
    {
        if(response)
        {
            new idx = GetPlayerListitemValue(playerid, listitem), string[24];
            SetPVarInt(playerid, "acs_id_sql", idx);

            format(string, sizeof string, "acsuse%d", listitem);

            if(!GetPVarInt(playerid, string))
            {
                Dialog
                (
                    playerid, 1191, DIALOG_STYLE_LIST,
                    "{FF0000}берите действие",
                    "1. сползoват\n"\
                    "2. ередат/родат\n"\
                    "{FF0000}3. далит",
                    "брат", "акрт"
                );
                SetPVarInt(playerid, "acs_use", 0);
            }
            else
            {
                Dialog
                (
                    playerid, 1191, DIALOG_STYLE_LIST,
                    "{FF0000}берите действие",
                    "1. нт\n"\
                    "2. едактироват",
                    "брат", "акрт"
                );
                SetPVarInt(playerid, "acs_use", 1);
            }
        }
    }

	if(dialogid == DIALOG_ADDEPOINTS)
    {
        if (response)
        {
            new amount = strval(inputtext);
            if (amount > 0 && amount <= 1000000000)
            {
                AddPlayerData(playerid, P_ACOINS, +, amount);
	           UpdatePlayerDatabaseInt(playerid, "acoins", GetPlayerData(playerid, P_ACOINS) + 450);
                SendClientMessage(playerid, COLOR_WHITE, " успешно вдали епоинт!");
            }
            else
            {
                SendClientMessage(playerid, COLOR_RED, "ведите корректную сумму! умма должна бт положителной и не превшат 1000000000.");
            }
        }
    }

	


	if(dialogid == DIALOG_CONT_BET)
{
    if(response)
    {
        new cont = pInfo[playerid][BetUseCont];
        if(cont == 0) return printf("ERROR PLAYERID: %d (contuse == 0)");
        if(cInfo[cont][Saled] == true)
        {
            if(cInfo[cont][BetedId] == playerid) return SendClientMessage(playerid, CLR_RED, "{ffffff}тавка на контейнер уже ваша, в не можете перебит свою ставку");
            if(0 < strval(inputtext) < 100000000)
            {
                if(GetPlayerMoneyEx(playerid) >= strval(inputtext))
                {
                    if(strval(inputtext)-99999 > cInfo[cont][BetPrice])
                    {
                        if(strval(inputtext) > cInfo[cont][ContPrice] && strval(inputtext) > cInfo[cont][BetPrice])
                        {
                            new strwerton[111];
                            new name[MAX_PLAYER_NAME]; GetPlayerName(playerid, name, MAX_PLAYER_NAME);
                            if(cInfo[cont][BetedId] != INVALID_PLAYER_ID)
                            {
                                format(strwerton, sizeof strwerton, "{ffffff}аша ставка бла отменена в свзи с тем, что игрок {FF6347}%s {ffffff}поставил болше!", name);
                                SendClientMessage(cInfo[cont][BetedId], CLR_RED, strwerton);

                                new return_str[64], return_money[32];
                                ConvertMoney(cInfo[cont][BetPrice], return_money);
                            }

                            cInfo[cont][BetPrice] = strval(inputtext);
                            cInfo[cont][BetedId] = playerid;
                            format(cInfo[cont][BetedName], MAX_PLAYER_NAME, "%s", name);

                            new betstr[15];
                            ConvertMoney(cInfo[cont][BetPrice], betstr);
                            format(strwerton, sizeof strwerton, " {ffffff} успешно сделали ставку в размере {FF5252}%s {ffffff}рублей за контейнер {FF5252}#%d", betstr, cont);
                            SendClientMessage(playerid, CLR_YELLOW, strwerton);

                            ShowNotificationNew(playerid, 3, 6, 0, 0, "тавка принта успешно!", " ");

                            StartContBidding(cont);
                        }
                        else
                        {
                            new strwerton[140], betstr[15];
                            new sile_title[128];
                            format(sile_title, sizeof sile_title, "{FF6347}%s {ffffff}| итва за контейнер", SERVER_NAME);
                            ConvertMoney(cInfo[cont][BetPrice], betstr);
                            format(strwerton, sizeof strwerton, "оследн сделанна ставка: %s рублей\n\nл того, чтоб сделат свою ставку ам необходимо\nбудет ввести ее в диалоговом поле ниже:", betstr);
                            SPD(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, sile_title, strwerton, "отово", "тмена");
                            SendClientMessage(playerid, CLR_RED, " {ffffff}аша ставка должна бт вше последней!");

                            ShowNotificationNew(playerid, 2, 6, 0, 0, "тавка должна бт вше", " ");
                            pInfo[playerid][BetUseCont] = 0;
                        }
                    }
                    else
                    {
                        new strwerton[140], betstr[15];
                        new sile_title[128];
                        format(sile_title, sizeof sile_title, "{FF6347}%s {ffffff}| итва за контейнер", SERVER_NAME);
                        ConvertMoney(cInfo[cont][BetPrice], betstr);
                        format(strwerton, sizeof strwerton, "оследн сделанна ставка: %s рублей\n\nл того, чтоб сделат свою ставку ам необходимо\nбудет ввести ее в диалоговом поле ниже:", betstr);
                        SPD(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, sile_title, strwerton, "отово", "тмена");
                        SendClientMessage(playerid, CLR_RED, "{ffffff}инималнй подем ставки 100.000 рублей!");

                        ShowNotificationNew(playerid, 2, 6, 0, 0, "инималнй подъем 100.000 руб", " ");
                        pInfo[playerid][BetUseCont] = 0;
                    }
                }
                else
                {
                    new strwerton[140], betstr[15];
                    new sile_title[128];
                    format(sile_title, sizeof sile_title, "{FF6347}%s {ffffff}| итва за контейнер", SERVER_NAME);
                    ConvertMoney(cInfo[cont][BetPrice], betstr);
                    format(strwerton, sizeof strwerton, "оследн сделанна ставка: %s рублей\n\nл того, чтоб сделат свою ставку ам необходимо\nбудет ввести ее в диалоговом поле ниже:", betstr);
                    SPD(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, sile_title, strwerton, "отово", "тмена");
                    SendClientMessage(playerid, CLR_RED, "{ffffff} вас недостаточно средств дл такой ставки!");

                    ShowNotificationNew(playerid, 2, 6, 0, 0, "едостаточно средств", " ");
                    pInfo[playerid][BetUseCont] = 0;
                }
            }
            else
            {
                new strwerton[140], betstr[15];
                new sile_title[128];
                format(sile_title, sizeof sile_title, "{FF6347}%s {ffffff}| итва за контейнер", SERVER_NAME);
                ConvertMoney(cInfo[cont][BetPrice], betstr);
                format(strwerton, sizeof strwerton, "оследн сделанна ставка: %s рублей\n\nл того, чтоб сделат свою ставку ам необходимо\nбудет ввести ее в диалоговом поле ниже:", betstr);
                SPD(playerid, DIALOG_CONT_BET, DIALOG_STYLE_INPUT, sile_title, strwerton, "отово", "тмена");
                SendClientMessage(playerid, CLR_RED, "{ffffff}ведите корректную ставку!");

                ShowNotificationNew(playerid, 2, 6, 0, 0, "ведите корректную ставку", " ");
                pInfo[playerid][BetUseCont] = 0;
            }
        }
    }
}

    if(dialogid == DIALOG_ACCESSORY_ACTION)
    {
        if(!response)
        {
            DeletePVar(playerid, "inv_slot");
            DeletePVar(playerid, "item_id");
            DeletePVar(playerid, "model_id");
            DeletePVar(playerid, "target_slot");
            DeletePVar(playerid, "target_bone");
            return 1;
        }

        if(listitem < 0 || listitem > 1)
            return 1;

        new inv_slot = GetPVarInt(playerid, "inv_slot");
        new item_id = GetPVarInt(playerid, "item_id");
        new model_id = GetPVarInt(playerid, "model_id");
        new acs_id = LairdAccGetAcsIdByModel(model_id);

        if(inv_slot >= 0
        && inv_slot < MAX_INVENTORY_SLOTS
        && g_PlayerInventory[playerid][inv_slot][inv_itemId] == item_id
        && g_PlayerInventory[playerid][inv_slot][inv_itemCount] > 0)
        {
            if(acs_id == -1)
            {
                ShowNotificationNew(playerid, 2, 5, -1, -1, "ксессуар не найден в системе аксессуаров.", "");
            }
            else if(LairdAccGiveAndWear(playerid, acs_id, listitem == 1))
            {
                Inventory_RemoveOneItem(playerid, inv_slot);
            }
        }

        DeletePVar(playerid, "inv_slot");
        DeletePVar(playerid, "item_id");
        DeletePVar(playerid, "model_id");
        DeletePVar(playerid, "target_slot");
        DeletePVar(playerid, "target_bone");
        return 1;
    }



	if(dialogid == 9995)
{
    if(!response) 
    {
        DeletePVar(playerid, "delacc_target");
        DeletePVar(playerid, "delacc_account");
        DeletePVar(playerid, "delacc_reason");
        DeletePVar(playerid, "delacc_name");
        return 1;
    }
    
    new target_id = GetPVarInt(playerid, "delacc_target");
    new account_id = GetPVarInt(playerid, "delacc_account");
    new reason[128], target_name[24];
    GetPVarString(playerid, "delacc_reason", reason, sizeof(reason));
    GetPVarString(playerid, "delacc_name", target_name, sizeof(target_name));
    
    // роверем, что игрок все еще онлайн
    if(!IsPlayerConnected(target_id) || !IsPlayerLogged(target_id))
    {
        SendClientMessage(playerid, 0x999999FF, "грок уже отключилс!");
        DeletePVar(playerid, "delacc_target");
        DeletePVar(playerid, "delacc_account");
        return 1;
    }
    
    // далем аккаунт
    if(DeleteAccount(playerid, account_id, target_id, target_name, reason))
    {
        SendClientMessage(playerid, 0x66CC33FF, "ккаунт успешно удален!");
        
        // икаем игрока
        SetTimerEx("KickPlayerAfterDelete", 1000, false, "i", target_id);
        
        // чищаем PVars
        DeletePVar(playerid, "delacc_target");
        DeletePVar(playerid, "delacc_account");
        DeletePVar(playerid, "delacc_reason");
        DeletePVar(playerid, "delacc_name");
    }
    return 1;
}

