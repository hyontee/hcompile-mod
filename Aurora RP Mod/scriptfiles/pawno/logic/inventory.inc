	else format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"6. "W"Бандана / маска: "G"не используется\n");
	playerListitemID[targetid][idx++] = INVENTORY_SLOT_ID_BANDANA;
