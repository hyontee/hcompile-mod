	);
	ShowPlayerDialog(playerid, DIALOG_NONE, DIALOG_STYLE_LIST, COMMAND_GLOBAL, STRING_GLOBAL, "Закрыть", "");

	COMMAND_GLOBAL[0] = STRING_GLOBAL[0] = EOS;
		
	return true;
}
