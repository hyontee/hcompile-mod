	else {
		ShowPlayerDialog(playerid, D_INVENTORY_SELL_ID, DIALOG_STYLE_INPUT, CHAT_GLOBAL, ""W"\
			"W"Введите через запятую:\n\
			"P"- "W"ID игрока, которому хотите продать;\n\
			"P"- "W"Стоимость продажи.\n \n\
			"G"Например: 1, 100, 5000",
