stock inventory_UpdateAccesory(playerid, slot_id = -1) {
	new skinid = GetPlayerSkin(playerid),

	accesorySlotID[5] = {
		INVENTORY_SLOT_ID_HEAD, INVENTORY_SLOT_ID_GLASSES,
		INVENTORY_SLOT_ID_BANDANA, INVENTORY_SLOT_ID_WATCHES,
		INVENTORY_SLOT_ID_BACKPACK
	};
	if (slot_id == -1) {
		for (new slotid = 0, boneid, item_id, item_slotid; slotid < 5; slotid++) {
			item_slotid = accesorySlotID[slotid];
			item_id = PI[playerid][pItemsID][item_slotid];

			if (item_id) {
				switch (InventoryItemInfo[item_id][itemType]) {
					case ITEM_TYPE_HEADPHONES: boneid = 1;
					case ITEM_TYPE_BACKPACK: boneid = 1;
					case ITEM_TYPE_WATCHES: boneid = 6;
					default: boneid = 2;
				}
				if (PI[playerid][pAccessoryModel][slotid] != InventoryItemInfo[item_id][itemModelID]) {
					PI[playerid][pAccessoryOffsetSZ][slotid] = 0;
					PI[playerid][pAccessoryModel][slotid] = InventoryItemInfo[item_id][itemModelID];
				}
				if (PI[playerid][pAccessoryOffsetSZ][slotid] == 0) {
					GetAccesoryDefaultPos(InventoryItemInfo[item_id][itemModelID], skinid,
						PI[playerid][pAccessoryOffsetX][slotid], PI[playerid][pAccessoryOffsetY][slotid], PI[playerid][pAccessoryOffsetZ][slotid],
						PI[playerid][pAccessoryOffsetRX][slotid], PI[playerid][pAccessoryOffsetRY][slotid], PI[playerid][pAccessoryOffsetRZ][slotid],
						PI[playerid][pAccessoryOffsetSX][slotid], PI[playerid][pAccessoryOffsetSY][slotid], PI[playerid][pAccessoryOffsetSZ][slotid]
					);
				}
				SetPlayerAttachedObject(playerid, slotid, InventoryItemInfo[item_id][itemModelID], boneid,
					PI[playerid][pAccessoryOffsetX][slotid], PI[playerid][pAccessoryOffsetY][slotid], PI[playerid][pAccessoryOffsetZ][slotid],
					PI[playerid][pAccessoryOffsetRX][slotid], PI[playerid][pAccessoryOffsetRY][slotid], PI[playerid][pAccessoryOffsetRZ][slotid],
					PI[playerid][pAccessoryOffsetSX][slotid], PI[playerid][pAccessoryOffsetSY][slotid], PI[playerid][pAccessoryOffsetSZ][slotid]
				);
			}
			else {
				if (IsPlayerAttachedObjectSlotUsed(playerid, slotid)) {
					RemovePlayerAttachedObject(playerid, slotid);
				}
			}
		}
	}
	else if (ATTACH_SLOT_HEAD <= slot_id <= ATTACH_SLOT_BACKPACK) {
		new
			slotid = slot_id, item_slotid = accesorySlotID[slotid],
			item_id = PI[playerid][pItemsID][item_slotid], boneid;

		if (item_id) {
			switch (InventoryItemInfo[item_id][itemType]) {
				case ITEM_TYPE_HEADPHONES: boneid = 1;
				case ITEM_TYPE_BACKPACK: boneid = 1;
				case ITEM_TYPE_WATCHES: boneid = 6;
				default: boneid = 2;
			}
			if (PI[playerid][pAccessoryModel][slotid] != InventoryItemInfo[item_id][itemModelID]) {
				PI[playerid][pAccessoryOffsetSZ][slotid] = 0;
				PI[playerid][pAccessoryModel][slotid] = InventoryItemInfo[item_id][itemModelID];
			}
			if (PI[playerid][pAccessoryOffsetSZ][slotid] == 0) {
				GetAccesoryDefaultPos(InventoryItemInfo[item_id][itemModelID], skinid,
					PI[playerid][pAccessoryOffsetX][slotid], PI[playerid][pAccessoryOffsetY][slotid], PI[playerid][pAccessoryOffsetZ][slotid],
					PI[playerid][pAccessoryOffsetRX][slotid], PI[playerid][pAccessoryOffsetRY][slotid], PI[playerid][pAccessoryOffsetRZ][slotid],
					PI[playerid][pAccessoryOffsetSX][slotid], PI[playerid][pAccessoryOffsetSY][slotid], PI[playerid][pAccessoryOffsetSZ][slotid]
				);
			}
			SetPlayerAttachedObject(playerid, slotid, InventoryItemInfo[item_id][itemModelID], boneid,
				PI[playerid][pAccessoryOffsetX][slotid], PI[playerid][pAccessoryOffsetY][slotid], PI[playerid][pAccessoryOffsetZ][slotid],
				PI[playerid][pAccessoryOffsetRX][slotid], PI[playerid][pAccessoryOffsetRY][slotid], PI[playerid][pAccessoryOffsetRZ][slotid],
				PI[playerid][pAccessoryOffsetSX][slotid], PI[playerid][pAccessoryOffsetSY][slotid], PI[playerid][pAccessoryOffsetSZ][slotid]
			);
		}
		else {
			if (IsPlayerAttachedObjectSlotUsed(playerid, slotid)) {
				RemovePlayerAttachedObject(playerid, slotid);
			}
		}
	}
	if (TI[playerid][tPoliceAttachID][ATTACH_TYPE_HEAD] != -1) {
		ApplyPoliceAttach(playerid, TI[playerid][tPoliceAttachID][ATTACH_TYPE_HEAD]);
	}
	if (TI[playerid][tMaskTime]) {
		SetPlayerAttachedObject(playerid, ATTACH_SLOT_BANDANA, 19801, 2, 0.064999, 0.028999, 0.000000, 0.000000, 80.300003, 178.900009, 1.330000, 1.25, 1.125000);
	}
}
stock GivePlayerAccessoryItem(playerid, modelid) {
	new itemid = -1;
	for (new item_id = 42; item_id < sizeof (InventoryItemInfo); item_id++) {
		if (InventoryItemInfo[item_id][itemModelID] != modelid) continue;
		itemid = item_id;
