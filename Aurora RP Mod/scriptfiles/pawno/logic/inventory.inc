stock IsSplittableItem(item_id, item_amount = 1) {
	#pragma unused item_amount
	new bool:isReturn = false;

	switch (item_id) {
		case 7, 165 .. 180: isReturn = true;
	}
	switch (InventoryItemInfo[item_id][itemType]) {
		case ITEM_TYPE_AMMO: isReturn = true;
	}
	return isReturn;
}
stock IsDroppableItem(playerid, item_id, item_amount = 1) {
	switch (InventoryItemInfo[item_id][itemType]) {
		case ITEM_TYPE_SKIN: {
			switch (item_amount) {
				case 2: {		
					ErrorMessage(playerid, "Вы не можете передать / выбросить данный предмет.");
					return false;
				}
			}
		}
		case ITEM_TYPE_WEAPON: {
			switch (item_amount) {
				case 2: {		
					ErrorMessage(playerid, "Вы не можете передать / выбросить данный предмет.");
					return false;
				}
			}
		}
	}
	switch (item_id) {
		case 492 .. 499: {
			ErrorMessage(playerid, "Вы не можете передать / выбросить данный предмет.");
			return false;
		}
		default: return true;
	}
	return true;
}
stock GivePlayerItemToPlayer(playerid, targetid, slotid, amount) {
	if (!(0 <= slotid < INVENTORY_MAX_PAGE_SLOTS * 3)) return false;

	new itemid = PI[playerid][pItemsID][slotid];
	if (itemid == 0) return false;

	if (!IsDroppableItem(playerid, itemid, amount))  return false;

	if (PI[playerid][pItemsAmount][slotid] < amount) {
		ErrorMessage(playerid, "У вас нет такого количества предмета.");
		return false;
	}
	if (!GivePlayerItem(targetid, itemid, amount)) {
		ErrorMessage(playerid, "У игрока недостаточно места в инвентаре.");
		return false;
	}
	format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы передали %s (%d шт.) %s",
		InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemAction_Name], amount, player_name[targetid]
	);
	SendOk(targetid, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;

	format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "%s передал Вам %s (%d шт.)",
		player_name[playerid], InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemAction_Name], amount
	);
	SendOk(targetid, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;

	/*format(homeystr, 364, "%s передал игроку %s - %s (%d шт.)",
		PI[playerid][pName], PI[targetid][pName],
		InventoryItemInfo[PI[playerid][pItemsID][slotid]][ii_action_name], PI[playerid][pItemsAmount][slotid]
	);
	WriteLog("logs_inventory_give", homeystr);
	homeystr[0] = 0;*/

	PI[playerid][pItemsAmount][slotid] -= amount;
	if (PI[playerid][pItemsAmount][slotid] <= 0)
		inventory_DeleteItem(playerid, slotid);
	inventory_UpdateWeapons(playerid);

	if (InventoryTempInfo[playerid][tInventoryShowed]) {
		PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID]
		);
		PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
		);
		PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
		PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)]);

		inventory_UpdateWeightPTD(playerid);
		inventory_UpdateAmounts(playerid, slotid);
		inventory_NullSlots(playerid);
		inventory_HideContextMenu(playerid);
	}
	SavePlayerInventory(playerid);
	return true;
}

stock inventory_DropItem(playerid, slot_id = -1) {
	if (InventoryTempInfo[playerid][tChangedSlotID] == -1) return false;

	new slotid = InventoryTempInfo[playerid][tChangedSlotID];
	if (slot_id != -1) slotid = slot_id;
	new item_id = PI[playerid][pItemsID][slotid];

	InventoryTempInfo[playerid][tActionSelectedSlotID] = slotid;
	if (item_id == 0) return false;
	if (!IsDroppableItem(playerid, item_id, PI[playerid][pItemsAmount][slotid])) return false;

	if (IsSplittableItem(item_id)) {
		// show dialog
		format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), ""P"Выбросить %s", InventoryItemInfo[item_id][itemName]);

		ShowPlayerDialog(playerid, D_INVENTORY_DROP_AMOUNT, DIALOG_STYLE_INPUT, CHAT_GLOBAL, ""W"\
			"W"Введите количество предмета, которое хотите выбросить:",
			"Принять", "Отмена"
		);
	}
	else inventory_DropItemAction(playerid, slotid);

	return true;
}
stock inventory_DropItemAction(playerid, slotid, amount = 0) {
	if (slotid == -1) return false;

	new item_id = PI[playerid][pItemsID][slotid], bool:isReturn = false;

	if (item_id == 0) return false;
	new item_amount = PI[playerid][pItemsAmount][slotid];

	if (amount != 0) item_amount = amount;
	if (amount > PI[playerid][pItemsAmount][slotid]) {
		ErrorMessage(playerid, "У вас нет такого количества этого предмета.");
		return false;
	}

	for (new di_id = 0; di_id < MAX_DROPPED_ITEMS; di_id++) {
		if (!IsValidDroppedItem(di_id) ||
			GetPlayerInterior(playerid) != DroppedItemsInfo[di_id][itemInterior] ||
			GetPlayerVirtualWorld(playerid) != DroppedItemsInfo[di_id][itemWorld] ||
			!IsPlayerInRangeOfPoint(playerid, 0.6, DroppedItemsInfo[di_id][itemPos][0], DroppedItemsInfo[di_id][itemPos][1], DroppedItemsInfo[di_id][itemPos][2])
		) continue;

		inventory_NullSlots(playerid);
		ErrorMessage(playerid, "Вы не можете выбросить предмет в данном месте!");
		isReturn = true;
		break;
	}
	if (isReturn) return false;

	switch (slotid) {
		case INVENTORY_SLOT_ID_WEAPON_1: if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_1] != 0) {
			inventory_NullSlots(playerid);
			ErrorMessage(playerid, "Сначала разрядите оружие, перед тем как выбрасывать.");
			return false;
		}
		case INVENTORY_SLOT_ID_WEAPON_2: if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_2] != 0) {
			inventory_NullSlots(playerid);
			ErrorMessage(playerid, "Сначала разрядите оружие, перед тем как выбрасывать.");
			return false;
		}
	}

	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);

	CreateDroppedItem(x, y, z, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid),
		item_id, item_amount
	);
	format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "Вы выбросили %s.",
		InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemAction_Name]
	);
	SendOk(playerid, STRING_GLOBAL), STRING_GLOBAL[0] = EOS;

	ShowItemInfoPTD(playerid,
		InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID], item_id, -item_amount,
		InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
		InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
		InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
		InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
	);
	PI[playerid][pItemsAmount][slotid] -= item_amount;

	if (PI[playerid][pItemsAmount][slotid] <= 0) {
		PI[playerid][pItemsID][slotid] =
		PI[playerid][pItemsAmount][slotid] = 0;
	}
	if (InventoryTempInfo[playerid][tInventoryShowed]) {
		PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID]);
		PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
			InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
		);
		PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
		PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)]);
	}
	inventory_UpdateWeapons(playerid);
	inventory_UpdateAccesory(playerid);
	inventory_UpdateArmour(playerid);
	// inventory_UpdateClothes(playerid);
	inventory_UpdateWeightPTD(playerid);
	inventory_UpdateAmounts(playerid, slotid);
	SavePlayerInventory(playerid);

	Streamer_Update(playerid);

	inventory_NullSlots(playerid);
	inventory_HideContextMenu(playerid);

	ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0, 0);

	return true;
}
