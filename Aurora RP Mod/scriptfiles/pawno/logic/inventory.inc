stock ItemContains(playerid, item_id, type = 0) {
	new bool:isReturn = false;
	for (new slotid = 0; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS * 3); slotid++) {
		if (type) {
			if (InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemType] != item_id) continue;
		}
		else {
			if (PI[playerid][pItemsID][slotid] != item_id) continue;
		}
		isReturn = true;
		break;
	}
	return isReturn;
}
stock GetAvailableInventorySlots(playerid) {
	new amount = 0;
	for (new slotid = 0; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS * 3); slotid++) {
		if (PI[playerid][pItemsID][slotid] != 0) continue;
		amount++;
	}
	return amount;
}
stock ItemCounts(playerid, item_id, type = 0) {
	new amount = 0;
	for (new slotid = 0; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS * 3); slotid++) {
		if (type) {
			if (InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemType] != item_id) continue;
		}
		else {
			if (PI[playerid][pItemsID][slotid] != item_id) continue;
		}
		amount += PI[playerid][pItemsAmount][slotid];
	}
	return amount;
}
