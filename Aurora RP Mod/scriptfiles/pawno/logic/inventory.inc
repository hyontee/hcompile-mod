					PlayerTextDrawBackgroundColor(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(InventoryTempInfo[playerid][tChangedSlotID])], INVENTORY_ITEM_COLOR_DEFAULT);
					PlayerTextDrawShow(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(InventoryTempInfo[playerid][tChangedSlotID])]);
