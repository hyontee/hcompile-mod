			if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_BACKPACK] && PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_BACKPACK]) {
				format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"8. "W"Рюкзак: "P"%s\n", 
					InventoryItemInfo[PI[playerid][pItemsID][INVENTORY_SLOT_ID_BACKPACK]][itemName]
				);
			}
			else format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"8. "W"Рюкзак: "G"не используется\n");
			playerListitemID[playerid][idx++] = INVENTORY_SLOT_ID_BACKPACK;
			strcat(STRING_GLOBAL, COMMAND_GLOBAL);

			playerListitemID[playerid][idx++] = -1;
			strcat(STRING_GLOBAL, ""G"————————————————————————\n");

			for (new slotid = 0, item_id, item_amount; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3); slotid++) { 
				switch (GetBackpackLevel(playerid)) {
					case 1: { }
					default: if (slotid >= (INVENTORY_MAX_PAGE_SLOTS * 2) && slotid < (INVENTORY_MAX_PAGE_SLOTS * 3)) continue;
				}
				item_id = PI[playerid][pItemsID][slotid];
				item_amount = PI[playerid][pItemsAmount][slotid];

				if (!item_id) continue;

				switch (InventoryItemInfo[item_id][itemType]) {
					case ITEM_TYPE_WEAPON, ITEM_TYPE_AMMO: {
						format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"%s "G"[%s"G"]\n", (idx - 11), 
							InventoryItemInfo[item_id][itemName], GetInventoryAmount(playerid, item_id, item_amount, 1)
						);
					} 
					case ITEM_TYPE_SKIN: {
						format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Одежда "G"[%s"G"]\n", (idx - 11), 
							GetInventoryAmount(playerid, item_id, item_amount, 1)
						);
					} 
					default: {
						format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"%s "G"[%s шт.]\n", (idx - 11), 
							InventoryItemInfo[item_id][itemName], GetInventoryAmount(playerid, item_id, item_amount, 1)
						);
					}
				}
				playerListitemID[playerid][idx++] = slotid;
				strcat(STRING_GLOBAL, COMMAND_GLOBAL);
			}
			if (InventoryTempInfo[playerid][tHouseID] != -1) {
				playerListitemID[playerid][idx++] = 100 + INVENTORY_TYPE_HOUSE;
				format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""G">> "P"Открыть домашний шкаф "G"[ID: %i]\n", 
					InventoryTempInfo[playerid][tHouseID]
				);
				strcat(STRING_GLOBAL, COMMAND_GLOBAL);
			}
			else if (InventoryTempInfo[playerid][tVehicleID] != -1) {
				playerListitemID[playerid][idx++] = 100 + INVENTORY_TYPE_CAR;
				format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""G">> "P"Открыть багажник %s "G"[ID: %i]\n", 
					gTransport[GetVehicleModel(InventoryTempInfo[playerid][tVehicleID]) - 400][trName],
					InventoryTempInfo[playerid][tVehicleID]
				);
				strcat(STRING_GLOBAL, COMMAND_GLOBAL);
			}
			format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"Инвентарь "G"[%.2f / %.2f кг.]",
				GetInventoryWeight(playerid), InventoryTempInfo[playerid][tAvailableWeight]
			);
			ShowPlayerDialog(playerid, D_INVENTORY_MENU, DIALOG_STYLE_LIST, COMMAND_GLOBAL, STRING_GLOBAL, "Выбрать", "Отмена");
		}
		case INVENTORY_TYPE_CAR, INVENTORY_TYPE_HOUSE: {
			strcat(STRING_GLOBAL, ""G"<< "P"Открыть рюкзак\n"), idx++;

			for (new slotid = 0, slot_itemid, slot_amount; slotid < INVENTORY_MAX_OTHER_SLOTS; slotid++) {
				switch (type) {
					case INVENTORY_TYPE_CAR: {
						slot_itemid = VehicleInfo[vehicleid][vItemsID][slotid];
						slot_amount = VehicleInfo[vehicleid][vItemsAmount][slotid];
						if (slot_itemid == 0) slot_amount = 0;
					}
					case INVENTORY_TYPE_HOUSE: {
						slot_itemid = gHouses[houseid][houseItemsID][slotid];
						slot_amount = gHouses[houseid][houseItemsAmount][slotid];
						if (slot_itemid == 0) slot_amount = 0;
					}
					default: slot_itemid = slot_amount = 0;
				}
				if (!slot_itemid) continue;

				switch (InventoryItemInfo[slot_itemid][itemType]) {
					case ITEM_TYPE_WEAPON, ITEM_TYPE_AMMO: {
						format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"%s "G"[%s"G"]\n", (idx), 
							InventoryItemInfo[slot_itemid][itemName], GetInventoryAmount(playerid, slot_itemid, slot_amount, 1)
						);
					} 
					case ITEM_TYPE_SKIN: {
						format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Одежда "G"[%s"G"]\n", (idx - 11), 
							GetInventoryAmount(playerid, slot_itemid, slot_amount, 1)
						);
					} 
					default: {
						format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"%s "G"[%s шт.]\n", (idx), 
							InventoryItemInfo[slot_itemid][itemName], GetInventoryAmount(playerid, slot_itemid, slot_amount, 1)
						);
					}
				}
				playerListitemID[playerid][idx++] = slotid;
				strcat(STRING_GLOBAL, COMMAND_GLOBAL);
			}
			switch (type) {
				case INVENTORY_TYPE_CAR: {
					format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"Взять из %s "G"[ID: %i]",
						gTransport[GetVehicleModel(vehicleid) - 400][trName], vehicleid
					);
					ShowPlayerDialog(playerid, D_INVENTORY_MENU_CAR, DIALOG_STYLE_LIST, COMMAND_GLOBAL, STRING_GLOBAL, "Выбрать", "Отмена");
				}
				case INVENTORY_TYPE_HOUSE: {
					format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"Взять из шкафа "G"[ID: %i]",
						houseid
					);
					ShowPlayerDialog(playerid, D_INVENTORY_MENU_CAR, DIALOG_STYLE_LIST, COMMAND_GLOBAL, STRING_GLOBAL, "Выбрать", "Отмена");
				}
			}
		}
	}
	COMMAND_GLOBAL[0] = STRING_GLOBAL[0] = EOS;
	return true;
}
stock inventory_Show(playerid) {
	if (InventoryTempInfo[playerid][tInventoryShowed]) return;
	if (
		PI[playerid][pStageDeath] ||
		TI[playerid][tDuel] != -1 || 
		player_to_golod[playerid] || player_to_game[playerid] || 
		player_to_race_lv[playerid] || 
		TI[playerid][tGunArea][0] ||
		TI[playerid][tDMArea][0]
	) return;
	
	if (PI[playerid][pAdmin]) UpdateAdminCP(playerid, 2);
	inventory_UpdateBackpack(playerid);

	new Float:armour;
	GetPlayerArmour(playerid, armour);
	if (armour <= 0 && PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]) {
		PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR] = 0;
		PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR] = 0;
	}
	if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_WEAPON_2] == 502) {
		new weapon_id, weapon_ammo;
		GetPlayerWeaponData(playerid, 9, weapon_id, weapon_ammo);
		
		if (weapon_id == 41) {
			PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_WEAPON_2] = weapon_ammo;
			if (weapon_ammo <= 0) {
				PI[playerid][pItemsID][INVENTORY_SLOT_ID_WEAPON_2] =
				PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_WEAPON_2] = 0;
			}
		} else  {
			PI[playerid][pItemsID][INVENTORY_SLOT_ID_WEAPON_2] =
			PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_WEAPON_2] = 0;
		}
	}
	if (InventoryTempInfo[playerid][tItemInfoShowed]) {
		for (new ptd_id = 0; ptd_id < sizeof (InventoryItemInfoPTD[]); ptd_id++)
			PlayerTextDrawDestroy(playerid, InventoryItemInfoPTD[playerid][ptd_id]);
		if (InventoryTempInfo[playerid][tItemInfoTimer] != -1) {
			KillTimer(InventoryTempInfo[playerid][tItemInfoTimer]);
			printf("[KillTimer 36] InventoryTempInfo[playerid][tItemInfoTimer] = '%d' killed", 
				InventoryTempInfo[playerid][tItemInfoTimer]
			);
			InventoryTempInfo[playerid][tItemInfoTimer] = -1;
		}
	}
	InventoryTempInfo[playerid][tChangedSlotID] = -1;
	InventoryTempInfo[playerid][tSelectedSlotID] = -1;
	InventoryTempInfo[playerid][tChangedOtherSlotID] = -1;
	InventoryTempInfo[playerid][tSelectedOtherSlotID] = -1;

	new type = INVENTORY_TYPE_NONE, Float:vehiclePos[4];

	InventoryTempInfo[playerid][tHouseID] = -1;
	InventoryTempInfo[playerid][tVehicleID] = -1;

	if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {
		for (new vehicleid = GetVehiclePoolSize() + 1; --vehicleid != 0;) {
			if (!IsValidVehicle(vehicleid) || IsABike(vehicleid) || IsAVelik(vehicleid) || IsABoat(vehicleid))
				continue;
			GetVehicleShiftPos(vehicleid, 1, vehiclePos[0], vehiclePos[1], vehiclePos[2], 2.0);
			if (!IsPlayerInRangeOfPoint(playerid, 2.5, vehiclePos[0], vehiclePos[1], vehiclePos[2]) || IsVehicleTrunkLocked(vehicleid)) continue;

			type = INVENTORY_TYPE_CAR;
			InventoryTempInfo[playerid][tVehicleID] = vehicleid;
			break;
		}
	}
	if (type != INVENTORY_TYPE_CAR && GetPlayerVirtualWorld(playerid) > 0) {
		new 
			houseid = GetPlayerVirtualWorld(playerid) - 1;
		if (0 <= houseid < MAX_HOUSE_COUNT) {

			new house_interiorid = gHouses[houseid][houseHint];
			if (IsPlayerInRangeOfPoint(playerid, 3.0, 
					hinterior_info[house_interiorid][h_pos_exit][0], 
					hinterior_info[house_interiorid][h_pos_exit][1], 
					hinterior_info[house_interiorid][h_pos_exit][2])
			) {

				type = INVENTORY_TYPE_HOUSE;
				InventoryTempInfo[playerid][tHouseID] = houseid;
			}
		}

	}

	new
		vehicleid = InventoryTempInfo[playerid][tVehicleID],
		Float:playerPos[3];

	GetPlayerPos(playerid, playerPos[0], playerPos[1], playerPos[2]);

	switch (type) {
		case INVENTORY_TYPE_CAR: {
			GetVehicleZAngle(vehicleid, vehiclePos[3]);

			GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
			GetVehicleShiftPos(vehicleid, 1, vehiclePos[0], vehiclePos[1], vehiclePos[2], 2.0);

			if (boot != VEHICLE_PARAMS_ON) 
				SetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, VEHICLE_PARAMS_ON, objective);
			// AnimationTrunk(playerid, vehiclePos[0], vehiclePos[1], vehiclePos[2], vehiclePos[3], playerPos[1], playerPos[2]);
		}
		case INVENTORY_TYPE_HOUSE: {
			/*GetVehicleZAngle(vehicleid, vehiclePos[3]);

			GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
			GetVehicleShiftPos(vehicleid, 1, vehiclePos[0], vehiclePos[1], vehiclePos[2], 2.0);

			if (boot != VEHICLE_PARAMS_ON) 
				SetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, VEHICLE_PARAMS_ON, objective);
			// AnimationTrunk(playerid, vehiclePos[0], vehiclePos[1], vehiclePos[2], vehiclePos[3], playerPos[1], playerPos[2]);*/
		}
	}
	inventory_CreatePTD(playerid, type);
	inventory_UpdateWeapons(playerid, 1);

	new Float:health;
	GetPlayerHealth(playerid, health);

	format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "%.0f", health);
	PlayerTextDrawSetString(playerid, InventoryPTD[playerid][7], STRING_GLOBAL);
	format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "%i", PI[playerid][pSatiety]);
	PlayerTextDrawSetString(playerid, InventoryPTD[playerid][8], STRING_GLOBAL);

	PlayerTextDrawSetSelectable(playerid, InventoryPTD[playerid][3], false); // disable 3 page.type [LD_BEAT:chit]
	STRING_GLOBAL[0] = EOS;

	for (new td_id = 0; td_id < sizeof (InventoryTD); td_id++) {
		TextDrawShowForPlayer(playerid, InventoryTD[td_id]);
		if (td_id >= sizeof (InventoryOtherTD)) continue;
		if (type != INVENTORY_TYPE_NONE) {
			TextDrawShowForPlayer(playerid, InventoryOtherTD[td_id]);
		}
	}
	for (new ptd_id = 0; ptd_id < sizeof (InventoryPTD[]); ptd_id++) {
		PlayerTextDrawShow(playerid, InventoryPTD[playerid][ptd_id]);

		if (ptd_id >= (INVENTORY_MAX_OTHER_SLOTS)) continue;
		if (type != INVENTORY_TYPE_NONE) {
			PlayerTextDrawShow(playerid, InventoryOtherSlotPTD[playerid][ptd_id]);
			PlayerTextDrawShow(playerid, InventoryOtherAmountPTD[playerid][ptd_id]);
		}
		if (ptd_id >= (INVENTORY_MAX_PAGE_SLOTS + INVENTORY_MAX_PAGE_USE_SLOTS)) continue;
		PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][ptd_id]);
		PlayerTextDrawShow(playerid, InventoryAmountPTD[playerid][ptd_id]);

		if (ptd_id >= sizeof (InventoryOtherPTD[])) continue;
		if (type != INVENTORY_TYPE_NONE) {
			PlayerTextDrawShow(playerid, InventoryOtherPTD[playerid][ptd_id]);
		}
	}
	SelectTextDraw(playerid, INVENTORY_STD_COLOR);
	InventoryTempInfo[playerid][tInventoryShowed] = type;
}
stock inventory_Hide(playerid) {
	if (!InventoryTempInfo[playerid][tInventoryShowed]) return;

	if (PI[playerid][pAdmin]) UpdateAdminCP(playerid);
	new
		type = InventoryTempInfo[playerid][tInventoryShowed],
		vehicleid = InventoryTempInfo[playerid][tVehicleID];

	switch (type) {
		case INVENTORY_TYPE_CAR: {
			GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
			if (boot != VEHICLE_PARAMS_OFF) {
				SetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, VEHICLE_PARAMS_OFF, objective);
			}
		}
	}
	if (InventoryTempInfo[playerid][tItemInfoShowed]) {
		for (new ptd_id = 0; ptd_id < sizeof (InventoryItemInfoPTD[]); ptd_id++)
			PlayerTextDrawDestroy(playerid, InventoryItemInfoPTD[playerid][ptd_id]);
		if (InventoryTempInfo[playerid][tItemInfoTimer] != -1) {
			KillTimer(InventoryTempInfo[playerid][tItemInfoTimer]);
			printf("[KillTimer 37] InventoryTempInfo[playerid][tItemInfoTimer] = '%d' killed", 
				InventoryTempInfo[playerid][tItemInfoTimer]
			);
			InventoryTempInfo[playerid][tItemInfoTimer] = -1;
		}
	}
	inventory_HideContextMenu(playerid);

	for (new td_id = 0; td_id < sizeof (InventoryTD); td_id++) {
		TextDrawHideForPlayer(playerid, InventoryTD[td_id]);

		if (td_id >= sizeof (InventoryOtherTD)) continue;
		TextDrawHideForPlayer(playerid, InventoryOtherTD[td_id]);
	}
	inventory_DestroyPTD(playerid);

	InventoryTempInfo[playerid][tInventoryShowed] = 0;
	CancelSelectTextDraw(playerid);
}
inventory_OnGameModeInit() {
	inventory_CreateTD();

	NULL_INVENTORY_TI[tChangedSlotID] = -1;
	NULL_INVENTORY_TI[tSelectedSlotID] = -1;
	NULL_INVENTORY_TI[tChangedOtherSlotID] = -1;
	NULL_INVENTORY_TI[tSelectedOtherSlotID] = -1;
	NULL_INVENTORY_TI[tDroppedItemArea] = -1;
	NULL_INVENTORY_TI[tAvailableWeight] = 30.0;
}
stock inventory_UpdateSlots(playerid, page) {
	if (!InventoryTempInfo[playerid][tInventoryShowed]) return;

	new start_slotid, slot_id[2];
	slot_id[0] = InventoryTempInfo[playerid][tSelectedSlotID];
	slot_id[1] = InventoryTempInfo[playerid][tChangedSlotID];

	for (new slotid = (start_slotid = (page - 1) * INVENTORY_MAX_PAGE_SLOTS), slot_itemid; slotid < (start_slotid + INVENTORY_MAX_PAGE_SLOTS); slotid++) {
		slot_itemid = PI[playerid][pItemsID][slotid];

		if (PI[playerid][pItemsID][slotid] == 0) PI[playerid][pItemsAmount][slotid] = 0;

		if (slot_id[1] != slotid)
			PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][slotid - start_slotid], INVENTORY_ITEM_COLOR_DEFAULT);
		else PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][slotid - start_slotid], INVENTORY_ITEM_COLOR_SELECTED);

		PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][slotid - start_slotid], InventoryItemInfo[slot_itemid][itemModelID]);
		PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][slotid - start_slotid],
			InventoryItemInfo[slot_itemid][itemPos][0], InventoryItemInfo[slot_itemid][itemPos][1],
			InventoryItemInfo[slot_itemid][itemPos][2], InventoryItemInfo[slot_itemid][itemPos][3]
		);
		PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][slotid - start_slotid],
			GetInventoryAmount(playerid, PI[playerid][pItemsID][slotid], PI[playerid][pItemsAmount][slotid])
		);
		PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][slotid - start_slotid]);
	}
}
stock inventory_UpdateAmounts(playerid, slotid = -1, type = 0) {
	if (!InventoryTempInfo[playerid][tInventoryShowed] || slotid >= (INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS * 3))
		return false;

	switch (slotid) {
		case -1: {
			new slot_id[2];
			slot_id[0] = InventoryTempInfo[playerid][tSelectedSlotID];
			slot_id[1] = InventoryTempInfo[playerid][tChangedSlotID];

			for (new td_id = 0; td_id < sizeof(slot_id); td_id++) if ((-1) != slot_id[td_id]){
				switch (slot_id[td_id]) {
					case INVENTORY_MAX_PAGE_SLOTS * 3 + 1: {
						if (0 != PI[playerid][pItemsID][slot_id[td_id]]) {
							format(STRING_GLOBAL, 32, "~y~%d", PI[playerid][pPhone]);
							PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slot_id[td_id])], STRING_GLOBAL);

							STRING_GLOBAL[0] = 0;
						}
						else PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slot_id[td_id])], " ");
					}
					default: {
						PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slot_id[td_id])],
							GetInventoryAmount(playerid, PI[playerid][pItemsID][slot_id[td_id]], PI[playerid][pItemsAmount][slot_id[td_id]])
						);
					}
				}
			}
			new item_id, item_amount, targetid;

			if (InventoryTempInfo[playerid][tSelectedOtherSlotID] != -1) {
				slotid = InventoryTempInfo[playerid][tSelectedOtherSlotID];
				switch (InventoryTempInfo[playerid][tInventoryShowed]) {
					case INVENTORY_TYPE_CAR: {
						targetid = InventoryTempInfo[playerid][tVehicleID];
						if (0 <= targetid < MAX_VEHICLES) {
							item_id = VehicleInfo[targetid][vItemsID][slotid];
							item_amount = VehicleInfo[targetid][vItemsAmount][slotid];
						}
					}
					case INVENTORY_TYPE_HOUSE: {
						targetid = InventoryTempInfo[playerid][tHouseID];
						if (0 <= targetid < MAX_HOUSE_COUNT) {
							item_id = gHouses[targetid][houseItemsID][slotid];
							item_amount = gHouses[targetid][houseItemsAmount][slotid];
						}
					}
					default: item_id = item_amount = 0;
				}
				PlayerTextDrawSetString(playerid, InventoryOtherAmountPTD[playerid][slotid],
					GetInventoryAmount(playerid, item_id, item_amount)
				);
			}
			if (InventoryTempInfo[playerid][tChangedOtherSlotID] != -1) {
				slotid = InventoryTempInfo[playerid][tChangedOtherSlotID];
				switch (InventoryTempInfo[playerid][tInventoryShowed]) {
					case INVENTORY_TYPE_CAR: {
						targetid = InventoryTempInfo[playerid][tVehicleID];
						if (0 <= targetid < MAX_VEHICLES) {
							item_id = VehicleInfo[targetid][vItemsID][slotid];
							item_amount = VehicleInfo[targetid][vItemsAmount][slotid];
						}
					}
					case INVENTORY_TYPE_HOUSE: {
						targetid = InventoryTempInfo[playerid][tHouseID];
						if (0 <= targetid < MAX_HOUSE_COUNT) {
							item_id = gHouses[targetid][houseItemsID][slotid];
							item_amount = gHouses[targetid][houseItemsAmount][slotid];
						}
					}
					default: item_id = item_amount = 0;
				}
				PlayerTextDrawSetString(playerid, InventoryOtherAmountPTD[playerid][slotid],
					GetInventoryAmount(playerid, item_id, item_amount)
				);
			}
		}
		case INVENTORY_SLOT_ID_SKIN: {
			new skin_itemid = PI[playerid][pItemsID][INVENTORY_SLOT_ID_SKIN];
			if (skin_itemid) {
				switch (PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_SKIN]) {
					case 2: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), "~y~ID: %i", InventoryItemInfo[skin_itemid][itemModelID]);
					default: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), "ID: %i", InventoryItemInfo[skin_itemid][itemModelID]);
				} 
			}
			else COMMAND_GLOBAL = "_";
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][30], COMMAND_GLOBAL), COMMAND_GLOBAL[0] = EOS;
		}
		case 0 .. (INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS * 3): {
			if (0 == type) {
				switch (slotid) {
					case INVENTORY_MAX_PAGE_SLOTS * 3 + 1: {
						if (0 != PI[playerid][pItemsID][slotid]) {
							format(STRING_GLOBAL, 32, "~y~%d", PI[playerid][pPhone]);
							PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slotid)], STRING_GLOBAL), STRING_GLOBAL[0] = 0;
						}
						else PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slotid)], " ");
					}
					default: {
						PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slotid)],
							GetInventoryAmount(playerid, PI[playerid][pItemsID][slotid], PI[playerid][pItemsAmount][slotid])
						);
					}
				}

			}
			else {
				new item_id, item_amount, targetid;

				switch (InventoryTempInfo[playerid][tInventoryShowed]) {
					case INVENTORY_TYPE_CAR: {
						targetid = InventoryTempInfo[playerid][tVehicleID];
						if (0 <= targetid < MAX_VEHICLES) {
							item_id = VehicleInfo[targetid][vItemsID][slotid];
							item_amount = VehicleInfo[targetid][vItemsAmount][slotid];
						}
					}
					case INVENTORY_TYPE_HOUSE: {
						targetid = InventoryTempInfo[playerid][tHouseID];
						if (0 <= targetid < MAX_HOUSE_COUNT) {
							item_id = gHouses[targetid][houseItemsID][slotid];
							item_amount = gHouses[targetid][houseItemsAmount][slotid];
						}
					}
					default: item_id = item_amount = 0;
				}
				PlayerTextDrawSetString(playerid, InventoryOtherAmountPTD[playerid][slotid],
					GetInventoryAmount(playerid, item_id, item_amount)
				);
				if (InventoryTempInfo[playerid][tSelectedSlotID] != -1) {
					slotid = InventoryTempInfo[playerid][tSelectedSlotID];

					PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slotid)],
						GetInventoryAmount(playerid, PI[playerid][pItemsID][slotid], PI[playerid][pItemsAmount][slotid])
					);
				}
				if (InventoryTempInfo[playerid][tChangedSlotID] != -1) {
					slotid = InventoryTempInfo[playerid][tChangedSlotID];

					PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slotid)],
						GetInventoryAmount(playerid, PI[playerid][pItemsID][slotid], PI[playerid][pItemsAmount][slotid])
					);
				}
			}
		}
	}
	return true;
}

stock GetInventoryAmount(playerid, item_id, item_amount, type = 0) {
	new lstring[32], languageid = PI[playerid][pInventoryLanguage];
	#pragma unused languageid

	if (!(0 <= item_id < sizeof (InventoryItemInfo)))
		return lstring;
	switch (InventoryItemInfo[item_id][itemType]) {
		case ITEM_TYPE_SKIN: {
			if (type == 0) {
				switch (item_amount) {
					case 2: format(lstring, sizeof (lstring), "~y~ID: %i", InventoryItemInfo[item_id][itemModelID]);
					default: format(lstring, sizeof (lstring), "ID: %i", InventoryItemInfo[item_id][itemModelID]);
				}
			} else {
				switch (item_amount) {
					case 2: format(lstring, sizeof (lstring), ""ORANGE"ID: %i", InventoryItemInfo[item_id][itemModelID]);
					default: format(lstring, sizeof (lstring), "ID: %i", InventoryItemInfo[item_id][itemModelID]);
				}
			}
		}
		case ITEM_TYPE_AMMO: {
			if (type == 0) {
				switch (item_id) {
					case 492 .. 499: format(lstring, sizeof (lstring), "~b~%i", item_amount);
					default: format(lstring, sizeof (lstring), "~y~%i", item_amount);
				}
			} else {
				switch (item_id) {
					case 492 .. 499: format(lstring, sizeof (lstring), ""ORANGE"%i шт.", item_amount);
					default: format(lstring, sizeof (lstring), "%i шт.", item_amount);
				}
			}
		}
		case ITEM_TYPE_WEAPON: {
			if (type == 0) {
				switch (item_amount) {
					case 2: {
						switch (item_id) {
							case 20, 21: lstring = "~b~.45ACP";
							case 22: lstring = "~b~.50AE";
							case 23 .. 25: lstring = "~b~12_GAUGE";
							case 26.. 28: lstring = "~b~9MM";
							case 29: lstring = "~b~7.62MM";
							case 30: lstring = "~b~5.56MM";
							case 31: lstring = "~b~.366";
							case 32: lstring = "~b~7.62HATO";
							default: lstring = "~b~1";
						}
					}
					default: {
						switch (item_id) {
							case 20, 21: lstring = "~y~.45ACP";
							case 22: lstring = "~y~.50AE";
							case 23 .. 25: lstring = "~y~12_GAUGE";
							case 26.. 28: lstring = "~y~9MM";
							case 29: lstring = "~y~7.62MM";
							case 30: lstring = "~y~5.56MM";
							case 31: lstring = "~y~.366";
							case 32: lstring = "~y~7.62HATO";
							default: lstring = "~y~1";
						}
					}
				}
			} else {
				switch (item_amount) {
					case 2: {
						switch (item_id) {
							case 20, 21: lstring = ""ORANGE".45ACP";
							case 22: lstring = ""ORANGE".50AE";
							case 23 .. 25: lstring = ""ORANGE"12 Gauge";
							case 26.. 28: lstring = ""ORANGE"9 мм";
							case 29: lstring = ""ORANGE"7.62 мм";
							case 30: lstring = ""ORANGE"5.56 мм";
							case 31: lstring = ""ORANGE".366";
							case 32: lstring = ""ORANGE"7.62 НАТО";
							default: lstring = ""ORANGE"1 шт.";
						}
					}
					default: {
						switch (item_id) {
							case 20, 21: lstring = ".45ACP";
							case 22: lstring = ".50AE";
							case 23 .. 25: lstring = "12 Gauge";
							case 26.. 28: lstring = "9 мм";
							case 29: lstring = "7.62 мм";
							case 30: lstring = "5.56 мм";
							case 31: lstring = ".366";
							case 32: lstring = "7.62 НАТО";
							default: lstring = "1 шт.";
						}
					}
				}
			}
		}
		default: {
			if (0 == item_id || 0 == item_amount) {
				if (0 == type) lstring = " ";
				else lstring[0] = 0;
			}
			else format(lstring, sizeof(lstring), "%i", item_amount);
		}
	}
	return lstring;
}
stock inventory_ShowActionMenu(playerid) {
	new
		slotid = GetInventoryPTD_ID(InventoryTempInfo[playerid][tActionSelectedSlotID]),
		slot_id = InventoryTempInfo[playerid][tActionSelectedSlotID], type = 0;

	if (!(0 <= slotid <= INVENTORY_SLOT_ID_SKIN)) return;

	switch (slot_id) {
		case INVENTORY_SLOT_ID_WEAPON_1, INVENTORY_SLOT_ID_WEAPON_2: {
			if (PI[playerid][pItemsID][slot_id + 2] == 0)
				type = 4;
			else type = 2;

			switch (PI[playerid][pItemsID][slot_id]) {
				case 10 .. 19: type = 5;
			}
		}
		case INVENTORY_SLOT_ID_HEAD, INVENTORY_SLOT_ID_GLASSES,
			 INVENTORY_SLOT_ID_BANDANA, INVENTORY_SLOT_ID_WATCHES,
			 INVENTORY_SLOT_ID_BACKPACK: type = 3;
		case INVENTORY_SLOT_ID_SKIN: type = 6;
	}
	switch (type) {
		case 0: { // Без разделения
			InventoryTempInfo[playerid][tInventoryContextMenu][0] = INVENTORY_LANG_ID_USE;
			InventoryTempInfo[playerid][tInventoryContextMenu][1] = INVENTORY_LANG_ID_GIVE;
			InventoryTempInfo[playerid][tInventoryContextMenu][2] = INVENTORY_LANG_ID_SELL;
			InventoryTempInfo[playerid][tInventoryContextMenu][3] = INVENTORY_LANG_ID_DROP;
			InventoryTempInfo[playerid][tInventoryContextMenu][4] = INVENTORY_LANG_ID_INFO;
			InventoryTempInfo[playerid][tInventoryContextMenu][5] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][6] = -1;
		}
		case 1: { // С разделением
			InventoryTempInfo[playerid][tInventoryContextMenu][0] = INVENTORY_LANG_ID_USE;
			InventoryTempInfo[playerid][tInventoryContextMenu][1] = INVENTORY_LANG_ID_GIVE;
			InventoryTempInfo[playerid][tInventoryContextMenu][2] = INVENTORY_LANG_ID_SELL;
			InventoryTempInfo[playerid][tInventoryContextMenu][3] = INVENTORY_LANG_ID_SPLIT;
			InventoryTempInfo[playerid][tInventoryContextMenu][4] = INVENTORY_LANG_ID_DROP;
			InventoryTempInfo[playerid][tInventoryContextMenu][5] = INVENTORY_LANG_ID_INFO;
			InventoryTempInfo[playerid][tInventoryContextMenu][6] = -1;
		}
		case 2: { // Для используемых оружий
			InventoryTempInfo[playerid][tInventoryContextMenu][0] = INVENTORY_LANG_ID_DISCHARGE;
			InventoryTempInfo[playerid][tInventoryContextMenu][1] = INVENTORY_LANG_ID_INFO;
			InventoryTempInfo[playerid][tInventoryContextMenu][2] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][3] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][4] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][5] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][6] = -1;
		}
		case 4: { // Для используемых оружий - без патрон
			InventoryTempInfo[playerid][tInventoryContextMenu][0] = INVENTORY_LANG_ID_CHARGE;
			InventoryTempInfo[playerid][tInventoryContextMenu][1] = INVENTORY_LANG_ID_REMOVE;
			InventoryTempInfo[playerid][tInventoryContextMenu][2] = INVENTORY_LANG_ID_INFO;
			InventoryTempInfo[playerid][tInventoryContextMenu][3] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][4] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][5] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][6] = -1;
		}
		case 5: { // Для используемых оружий - холодное
			InventoryTempInfo[playerid][tInventoryContextMenu][0] = INVENTORY_LANG_ID_REMOVE;
			InventoryTempInfo[playerid][tInventoryContextMenu][1] = INVENTORY_LANG_ID_INFO;
			InventoryTempInfo[playerid][tInventoryContextMenu][2] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][3] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][4] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][5] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][6] = -1;
		}
		case 3: { // Для используемых аксессуаров
			InventoryTempInfo[playerid][tInventoryContextMenu][0] = INVENTORY_LANG_ID_EDIT;
			InventoryTempInfo[playerid][tInventoryContextMenu][1] = INVENTORY_LANG_ID_REMOVE;
			InventoryTempInfo[playerid][tInventoryContextMenu][2] = INVENTORY_LANG_ID_INFO;
			InventoryTempInfo[playerid][tInventoryContextMenu][3] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][4] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][5] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][6] = -1;
		}
		case 6: { // Для одежды
			InventoryTempInfo[playerid][tInventoryContextMenu][0] = INVENTORY_LANG_ID_REMOVE;
			InventoryTempInfo[playerid][tInventoryContextMenu][1] = INVENTORY_LANG_ID_INFO;
			InventoryTempInfo[playerid][tInventoryContextMenu][2] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][3] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][4] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][5] = -1;
			InventoryTempInfo[playerid][tInventoryContextMenu][6] = -1;
		}
	}
	if (slot_id < (INVENTORY_MAX_PAGE_SLOTS * 3)) {
		if (InventoryTempInfo[playerid][tHouseID] != -1) {
			for (new i = 0; i < sizeof (InventoryContextPTD[]) - 1; i++) {
				if (InventoryTempInfo[playerid][tInventoryContextMenu][i] != -1) continue;
				InventoryTempInfo[playerid][tInventoryContextMenu][i] = INVENTORY_LANG_ID_PUT_HOUSE;
				break;
			}
		}
		else if (InventoryTempInfo[playerid][tVehicleID] != -1) {
			for (new i = 0; i < sizeof (InventoryContextPTD[]) - 1; i++) {
				if (InventoryTempInfo[playerid][tInventoryContextMenu][i] != -1) continue;
				InventoryTempInfo[playerid][tInventoryContextMenu][i] = INVENTORY_LANG_ID_PUT_CAR;
				break;
			}
		}
	}
	STRING_GLOBAL[0] = EOS;

	for (new i = 0; i < sizeof (InventoryContextPTD[]) - 1; i++) {
		if (InventoryTempInfo[playerid][tInventoryContextMenu][i] == -1) continue;

		switch (InventoryTempInfo[playerid][tInventoryContextMenu][i]) {
			case INVENTORY_LANG_ID_USE: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Использовать\n", i+1);
			case INVENTORY_LANG_ID_GIVE: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Передать\n", i+1);
			case INVENTORY_LANG_ID_SELL: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Продать\n", i+1);
			case INVENTORY_LANG_ID_DROP: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Выбросить\n", i+1);
			case INVENTORY_LANG_ID_INFO: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Информация\n", i+1);
			case INVENTORY_LANG_ID_EDIT: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Изменить\n", i+1);
			case INVENTORY_LANG_ID_REMOVE: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Убрать / снять\n", i+1);
			case INVENTORY_LANG_ID_CHARGE: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Зарядить\n", i+1);
			case INVENTORY_LANG_ID_DISCHARGE: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "W"Разрядить\n", i+1);
			case INVENTORY_LANG_ID_PUT_HOUSE: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "ORANGE"Положить в шкаф\n", i+1);
			case INVENTORY_LANG_ID_PUT_CAR: format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""P"%i. "ORANGE"Положить в багажник\n", i+1);
		}
		strcat(STRING_GLOBAL, COMMAND_GLOBAL);
	}
	ShowPlayerDialog(playerid, D_INVENTORY_ACTION_MENU, DIALOG_STYLE_LIST, ""P"Выберите действие", STRING_GLOBAL, "Выбрать", "Назад");
}
stock inventory_PutItem(playerid) {
	new slot_id = InventoryTempInfo[playerid][tActionSelectedSlotID];
	if (!(0 <= slot_id <= (INVENTORY_MAX_PAGE_SLOTS * 3))) 
		return false;
	new 
		houseid = InventoryTempInfo[playerid][tHouseID],
		vehicleid = InventoryTempInfo[playerid][tVehicleID],

		item_id = PI[playerid][pItemsID][slot_id],
		item_amount = PI[playerid][pItemsAmount][slot_id],
		free_slotid = -1;

	if (!item_id) return false;

	if (!IsDroppableItem(playerid, item_id, item_amount))  return false;

	for(new slotid = 0; slotid < INVENTORY_MAX_OTHER_SLOTS; slotid++) {
		if (houseid != -1) {
			if (gHouses[houseid][houseItemsID][slotid] != 0) continue;
		}
		else if (vehicleid != -1) {
			if (VehicleInfo[vehicleid][vItemsID][slotid] != 0) continue;
		}
		free_slotid = slotid;
		break;
	}
	if (free_slotid == -1) {
		return ErrorMessage(playerid, "В шкафу дома / багажнике транспорта недостаточно места!");
	}

	if (houseid != -1) {
		gHouses[houseid][houseItemsID][free_slotid] = item_id;
		gHouses[houseid][houseItemsAmount][free_slotid] = item_amount;
		SaveHouseInventory(houseid);
		SendOk(playerid, "Вы положили предмет в домашний шкаф.");
	}
	else if (vehicleid != -1) {
		VehicleInfo[vehicleid][vItemsID][free_slotid] = item_id;
		VehicleInfo[vehicleid][vItemsAmount][free_slotid] = item_amount;
		SaveVehicleInventory(vehicleid);
		SendOk(playerid, "Вы положили предмет в багажник транспорта.");
	}
	PI[playerid][pItemsID][slot_id] = 0; 
	PI[playerid][pItemsAmount][slot_id] = 0; 

	inventory_ShowDialogMenu(playerid);
	return true;
}
stock inventory_TakeItem(playerid) {
	new slotid = InventoryTempInfo[playerid][tActionSelectedSlotID];
	if (!(0 <= slotid < INVENTORY_MAX_OTHER_SLOTS)) return true;
	new 
		houseid = InventoryTempInfo[playerid][tHouseID],
		vehicleid = InventoryTempInfo[playerid][tVehicleID],
		item_id, item_amount;

	if (houseid != -1) {
		item_id = gHouses[houseid][houseItemsID][slotid];
		item_amount = gHouses[houseid][houseItemsAmount][slotid];
	}
	else if (vehicleid != -1) {
		item_id = VehicleInfo[vehicleid][vItemsID][slotid];
		item_amount = VehicleInfo[vehicleid][vItemsAmount][slotid];
	}
	if (!item_id) return true;

	if (!GivePlayerItem(playerid, item_id, item_amount)) return true;

	if (houseid != -1) {
		gHouses[houseid][houseItemsID][slotid] = 0;
		gHouses[houseid][houseItemsAmount][slotid] = 0;
		SaveHouseInventory(houseid);
	}
	else if (vehicleid != -1) {
		VehicleInfo[vehicleid][vItemsID][slotid] = 0;
		VehicleInfo[vehicleid][vItemsAmount][slotid] = 0;
		SaveVehicleInventory(vehicleid);
	}
	inventory_ShowDialogMenu(playerid);
	return true;
}
