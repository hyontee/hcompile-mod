	/*switch (item_id) {
		case 29..54: if (PI[playerid][pLevel] < ALLOW_GUN_LEVEL)
			return ErrorMessage(playerid, "Оружие доступно с "#ALLOW_GUN_LEVEL" уровня."), false;
	}*/
	if (type == 2 && item_count < 0) {
		new item_amount = item_count * (-1);

		for (new slotid = 0; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3); slotid++) {
			switch (GetBackpackLevel(playerid)) {
				case 1: { }
				default: if (slotid >= (INVENTORY_MAX_PAGE_SLOTS * 2) && slotid < (INVENTORY_MAX_PAGE_SLOTS * 3)) continue;
			}
				/*
					* item_amount - количество AMOUNT
					* itemamount - количество предмета
				*/
			if (PI[playerid][pItemsID][slotid] == item_id && item_amount > 0) 
			{
				/*if (item_amount == PI[playerid][pItemsAmount][slotid]) 
				{
					PI[playerid][pItemsID][slotid] = 0;
					PI[playerid][pItemsAmount][slotid] = 0;
				}*/
				if (PI[playerid][pItemsAmount][slotid] >= item_amount) {
					new new_amount = PI[playerid][pItemsAmount][slotid];
					PI[playerid][pItemsAmount][slotid] -= item_amount;
					item_amount -= new_amount;

					if (PI[playerid][pItemsAmount][slotid] <= 0) {
						PI[playerid][pItemsID][slotid] = 0;
						PI[playerid][pItemsAmount][slotid] = 0;
					}
				}
				else 
				{
					item_amount -= PI[playerid][pItemsAmount][slotid];
					PI[playerid][pItemsID][slotid] = 0;
					PI[playerid][pItemsAmount][slotid] = 0;
				}
			}
		}
		return true;
	}
	if (item_count < 0) {
		for (new slotid = 0; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3); slotid++) {
			switch (GetBackpackLevel(playerid)) {
				case 1: { }
				default: if (slotid >= (INVENTORY_MAX_PAGE_SLOTS * 2) && slotid < (INVENTORY_MAX_PAGE_SLOTS * 3)) continue;
			}
			if (PI[playerid][pItemsID][slotid] == item_id) {
				isReturn = true;

				PI[playerid][pItemsAmount][slotid] += item_count;
				ShowItemInfoPTD(playerid,
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID], item_id, item_count,
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
				);
				if (item_count < 0 && PI[playerid][pItemsAmount][slotid] < 1)
					PI[playerid][pItemsID][slotid] = 0;
				if (InventoryTempInfo[playerid][tInventoryShowed] && InventoryTempInfo[playerid][tInventoryPageSlot] == GetInventoryPage(slotid)) {
					PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID]
					);
					PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
					);
					PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
					PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)]);
					inventory_UpdateAmounts(playerid, slotid);
				}
				inventory_UpdateWeightPTD(playerid);
				inventory_UpdateAmounts(playerid, slotid);
				SavePlayerInventory(playerid);

				isReturn = true;
				break;
			}
		}
	} else {
		switch (InventoryItemInfo[item_id][itemType]) {
			case ITEM_TYPE_WEAPON, ITEM_TYPE_SKIN, ITEM_TYPE_ARMOUR: { }
			default: {
				for (new slotid = 0; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3); slotid++) {
					switch (GetBackpackLevel(playerid)) {
						case 1: { }
						default: if (slotid >= (INVENTORY_MAX_PAGE_SLOTS * 2) && slotid < (INVENTORY_MAX_PAGE_SLOTS * 3)) continue;
					}
					if (PI[playerid][pItemsID][slotid] == item_id) {
						PI[playerid][pItemsAmount][slotid] += item_count;
						ShowItemInfoPTD(playerid,
							InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID], item_id, item_count,
							InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
							InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
							InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
							InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
						);
						if (item_count < 0 && PI[playerid][pItemsAmount][slotid] < 1)
							PI[playerid][pItemsID][slotid] = 0;
						if (InventoryTempInfo[playerid][tInventoryShowed] && InventoryTempInfo[playerid][tInventoryPageSlot] == GetInventoryPage(slotid)) {
							PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
								InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID]);
							PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
								InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
								InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
								InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
								InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
							);
							PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
							PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)]);
							inventory_UpdateAmounts(playerid, slotid);
						}
						inventory_UpdateWeightPTD(playerid);
						inventory_UpdateAmounts(playerid, slotid);
						SavePlayerInventory(playerid);

						isReturn = true;
						break;
					}
				}
			}
		}
	}
	if (isReturn) return true;

	for (new slotid = 0; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3); slotid++) {
		switch (GetBackpackLevel(playerid)) {
			case 1: { }
			default: if (slotid >= (INVENTORY_MAX_PAGE_SLOTS * 2) && slotid < (INVENTORY_MAX_PAGE_SLOTS * 3)) continue;
		}
		if (PI[playerid][pItemsID][slotid] == 0) {
			isReturn = true;

			PI[playerid][pItemsID][slotid] = item_id;
			PI[playerid][pItemsAmount][slotid] = item_count;
			//set_weight_inventory(playerid);
			if (InventoryTempInfo[playerid][tInventoryShowed] && InventoryTempInfo[playerid][tInventoryPageSlot] == GetInventoryPage(slotid)) {
				PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID]
				);
				PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
				);
				PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
				PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)]);
				inventory_UpdateAmounts(playerid, slotid);
			}
			inventory_UpdateWeightPTD(playerid);
			inventory_UpdateAmounts(playerid, slotid);

			ShowItemInfoPTD(playerid,
				InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID], item_id, item_count,
				InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
				InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
				InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
				InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
			);
			SavePlayerInventory(playerid);
			break;
		}
	}
	if (!isReturn) {
		ErrorMessage(playerid, "У Вас недостаточно места в инвентаре!");
		return false;
	}
	return true;
}
stock ShowItemInfoPTD(playerid, modelid, itemid, amount, Float:rotX, Float:rotY, Float:rotZ, Float:rotC) {
	if (!TI[playerid][tLogin] || 0 == amount)
		return;
	if (InventoryTempInfo[playerid][tItemInfoShowed]) {
		for (new ptd_id = 0; ptd_id < 3; ptd_id++)
			PlayerTextDrawDestroy(playerid, InventoryItemInfoPTD[playerid][ptd_id]);
		if (InventoryTempInfo[playerid][tItemInfoTimer] != -1) {
			KillTimer(InventoryTempInfo[playerid][tItemInfoTimer]);
			printf("[KillTimer 35] InventoryTempInfo[playerid][tItemInfoTimer] = '%d' killed", 
				InventoryTempInfo[playerid][tItemInfoTimer]
			);
