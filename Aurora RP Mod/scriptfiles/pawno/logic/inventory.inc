Float:GetWeightItem(item_id, item_amount = 1) {
	new Float:item_weight = 0.0;
	if (!(1 <= item_id < sizeof (InventoryItemInfo)))
		return item_weight;
	if (item_amount < 1)
		item_amount = 1;
	switch (InventoryItemInfo[item_id][itemType]) {
		case ITEM_TYPE_WEAPON, ITEM_TYPE_SKIN, ITEM_TYPE_ARMOUR:
			item_weight = InventoryItemInfo[item_id][itemWeight];
		default: item_weight = (InventoryItemInfo[item_id][itemWeight] * item_amount);
	}
	return item_weight;
}
Float:GetInventoryWeight(playerid) {
	new Float:items_weight = 0.0;
	for (new slotid = 0; slotid < (INVENTORY_SLOT_ID_WEAPON_1); slotid++) { // ((INVENTORY_MAX_PAGE_SLOTS * 3) + INVENTORY_MAX_PAGE_USE_SLOTS * 3)
		switch (GetBackpackLevel(playerid)) {
			case 1: { }
			default: if (slotid >= (INVENTORY_MAX_PAGE_SLOTS * 2) && slotid < (INVENTORY_MAX_PAGE_SLOTS * 3)) continue;
		}
		items_weight += GetWeightItem(PI[playerid][pItemsID][slotid], PI[playerid][pItemsAmount][slotid]);
	}
	return items_weight;
}
