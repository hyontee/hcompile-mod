			InventoryItemInfo[PI[targetid][pItemsID][INVENTORY_SLOT_ID_WATCHES]][itemName]
		);
	}
	else format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"7. "W"Часы / наушники: "G"не используется\n");
	playerListitemID[targetid][idx++] = INVENTORY_SLOT_ID_WATCHES;
	strcat(STRING_GLOBAL, COMMAND_GLOBAL);

	if (PI[targetid][pItemsID][INVENTORY_SLOT_ID_BACKPACK] && PI[targetid][pItemsAmount][INVENTORY_SLOT_ID_BACKPACK]) {
