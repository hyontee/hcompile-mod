		}
		PlayerTextDrawSetPreviewModel(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid + 2)], 2061);
		PlayerTextDrawSetPreviewRot(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid + 2)], 0.000000, 0.000000, 0.000000, 1.000000);
		PlayerTextDrawColor(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid + 2)], 255);

		PlayerTextDrawBackgroundColor(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid + 2)], INVENTORY_ITEM_COLOR_DEFAULT);
		PlayerTextDrawShow(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid + 2)]);
	}
	// В пустой слот перемещаем предмет

	return true;
}

stock SaveHouseInventory(houseid) {
	if (!(0 <= houseid < MAX_HOUSE_COUNT)) 
		return;
	MYSQL_GLOBAL[0] = EOS;

	mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "UPDATE `houses` SET \
		`itemsID`='%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i', \
		`itemsAmount`='%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i,%i' \
		WHERE id = %d LIMIT 1",
		gHouses[houseid][houseItemsID][0], gHouses[houseid][houseItemsID][1], 
		gHouses[houseid][houseItemsID][2], gHouses[houseid][houseItemsID][3], 
		gHouses[houseid][houseItemsID][4], gHouses[houseid][houseItemsID][5], 
		gHouses[houseid][houseItemsID][6], gHouses[houseid][houseItemsID][7], 
		gHouses[houseid][houseItemsID][8], gHouses[houseid][houseItemsID][9], 
		gHouses[houseid][houseItemsID][10], gHouses[houseid][houseItemsID][11], 
		gHouses[houseid][houseItemsID][12], gHouses[houseid][houseItemsID][13], 
		gHouses[houseid][houseItemsID][14], gHouses[houseid][houseItemsID][15], 
		gHouses[houseid][houseItemsID][16], gHouses[houseid][houseItemsID][17],

		gHouses[houseid][houseItemsAmount][0], gHouses[houseid][houseItemsAmount][1], 
		gHouses[houseid][houseItemsAmount][2], gHouses[houseid][houseItemsAmount][3], 
		gHouses[houseid][houseItemsAmount][4], gHouses[houseid][houseItemsAmount][5], 
		gHouses[houseid][houseItemsAmount][6], gHouses[houseid][houseItemsAmount][7], 
		gHouses[houseid][houseItemsAmount][8], gHouses[houseid][houseItemsAmount][9], 
		gHouses[houseid][houseItemsAmount][10], gHouses[houseid][houseItemsAmount][11], 
