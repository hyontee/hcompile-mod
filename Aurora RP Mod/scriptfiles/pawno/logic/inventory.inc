stock inventory_HideContextMenu(playerid) {
	if (!InventoryTempInfo[playerid][tContextMenuShowed]) return;

	PlayerTextDrawDestroy(playerid, InventoryContextBG_PTD[playerid]);

	for (new ptd_id = 0; ptd_id < sizeof (InventoryContextPTD[]); ptd_id++) {
		InventoryTempInfo[playerid][tInventoryContextMenu][ptd_id] = -1;
		PlayerTextDrawDestroy(playerid, InventoryContextPTD[playerid][ptd_id]);
	}
	InventoryTempInfo[playerid][tContextMenuShowed] = 0;
}

inventory_OnPlayerClickTextDraw(playerid, Text:clickedid) {
	if (!InventoryTempInfo[playerid][tInventoryShowed])
		return false;
	if (clickedid == InventoryTD[10]) {
		new page = InventoryTempInfo[playerid][tInventoryPageType] - 1;
		if (page < 1) page = 1;

		inventory_SetSlotsType(playerid, page);
		return true;
	}
	if (clickedid == InventoryTD[11]) {
		new page = InventoryTempInfo[playerid][tInventoryPageType] + 1;
		if (page > 2) page = 2;

		inventory_SetSlotsType(playerid, page);
		return true;
	}
	if (clickedid == InventoryTD[12]) {
		new page = InventoryTempInfo[playerid][tInventoryPageSlot] - 1;
		if (page < 1) page = 1;

		inventory_SetSlotsPage(playerid, page);
		return true;
	}
	if (clickedid == InventoryTD[13]) {
		new page = InventoryTempInfo[playerid][tInventoryPageSlot] + 1;
		if (page > 3) page = 3;

		inventory_SetSlotsPage(playerid, page);
		return true;
	}
	if (clickedid == InventoryOtherTD[2]) {
		inventory_HideTargetMenu(playerid);
		return true;
	}
	if (clickedid == Text:INVALID_TEXT_DRAW) {
		inventory_Hide(playerid);
		return true;
	}
	return false;
}
stock inventory_HideTargetMenu(playerid) {
	if (InventoryTempInfo[playerid][tInventoryShowed] <= INVENTORY_TYPE_NONE)
		return;
	inventory_HideContextMenu(playerid);
	inventory_NullSlots(playerid);
	new
		type = InventoryTempInfo[playerid][tInventoryShowed],
		vehicleid = InventoryTempInfo[playerid][tVehicleID];

	switch (type) {
		case INVENTORY_TYPE_CAR: {
			GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
			if (boot != VEHICLE_PARAMS_OFF) {
				SetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, VEHICLE_PARAMS_OFF, objective);
			}
		}
	}
	for (new td_id = 0; td_id < sizeof (InventoryOtherTD); td_id++)
		TextDrawHideForPlayer(playerid, InventoryOtherTD[td_id]);

	for (new ptd_id = 0; ptd_id < INVENTORY_MAX_OTHER_SLOTS; ptd_id++) {
		PlayerTextDrawHide(playerid, InventoryOtherSlotPTD[playerid][ptd_id]);
		PlayerTextDrawHide(playerid, InventoryOtherAmountPTD[playerid][ptd_id]);

		if (ptd_id >= sizeof (InventoryOtherPTD[])) continue;
		PlayerTextDrawHide(playerid, InventoryOtherPTD[playerid][ptd_id]);
	}
	InventoryTempInfo[playerid][tInventoryShowed] = INVENTORY_TYPE_NONE;
}
stock inventory_UpdateClothes(playerid, inventoryShowed = 0) {
	if (inventoryShowed == 0)
		inventoryShowed = InventoryTempInfo[playerid][tInventoryShowed];
	new skin_itemid = PI[playerid][pItemsID][INVENTORY_SLOT_ID_SKIN];
	
	start_work[playerid] = 0;
	if (GetTeamID(playerid) == fFBI) start_work[playerid] = 1;

	if ((IsAGang(playerid) || IsAMafia(playerid)) || start_work[playerid])
	{
		start_work[playerid] = true;
		A_SetPlayerSkin(playerid, PI[playerid][pFracSkin]);
		SetPlayerColor(playerid, gFractionSpawn[PI[playerid][pMember]][fracColor]);
	}
	else if (skin_itemid) {
		if (PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_SKIN] == 2) {
			start_work[playerid] = 1;
			/*if (!start_work[playerid]) {
				SetPlayerColor(playerid, gFractionSpawn[PI[playerid][pMember]][fracColor]);
				start_work[playerid] = 1;
			}*/
		}
		else {
			ClearPoliceAttach(playerid);
			/*if (start_work[playerid]) {
				SetPlayerColor(playerid, TEAM_HIT_COLOR);
				start_work[playerid] = 0;
			}*/
			// SetPlayerColor(playerid, TEAM_HIT_COLOR);
		}
		A_SetPlayerSkin(playerid, InventoryItemInfo[skin_itemid][itemModelID]);
	}
	else {
		switch (PI[playerid][pSex]) {
			case 1: A_SetPlayerSkin(playerid, INVENTORY_NUDE_SKIN_MALE);
			case 2: A_SetPlayerSkin(playerid, INVENTORY_NUDE_SKIN_FEMALE);
		}
		ClearPoliceAttach(playerid);
		// SetPlayerColor(playerid, TEAM_HIT_COLOR);
	}
	if (start_work[playerid]) {
		if (!TI[playerid][tClistDisabled]) SetPlayerColor(playerid, gFractionSpawn[PI[playerid][pMember]][fracColor]);
	} else {
		SetPlayerColor(playerid, TEAM_HIT_COLOR);
	}
	ApplyAnimation(playerid, "CARRY", "null", 1.0, 0, 0, 0, 0, 0, 0);
	TogglePlayerControllable(playerid, true);

	if (InventoryTempInfo[playerid][tInventoryShowed]) {
		PlayerTextDrawSetPreviewModel(playerid, InventoryPTD[playerid][0], GetPlayerSkin(playerid));
		PlayerTextDrawShow(playerid, InventoryPTD[playerid][0]);

		if (skin_itemid) PlayerTextDrawSetPreviewRot(playerid, InventoryPTD[playerid][28], 0.000000, 0.000000, 0.000000, 1.151026);
		else PlayerTextDrawSetPreviewRot(playerid, InventoryPTD[playerid][28], 0.000000, 0.000000, 0.000000, 100.000000);
		PlayerTextDrawShow(playerid, InventoryPTD[playerid][28]);

		PlayerTextDrawSetString(playerid, InventoryPTD[playerid][30],
			GetInventoryAmount(playerid, PI[playerid][pItemsID][INVENTORY_SLOT_ID_SKIN], PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_SKIN])
		);
	}
}
