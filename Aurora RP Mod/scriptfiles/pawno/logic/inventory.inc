					item_id = gHouses[targetid][houseItemsID][InventoryTempInfo[playerid][tSelectedOtherSlotID]];
				}
			}
		}
		if (0 != item_id) {
			PlayerTextDrawBackgroundColor(playerid, InventoryOtherSlotPTD[playerid][InventoryTempInfo[playerid][tSelectedOtherSlotID]], INVENTORY_ITEM_COLOR_DEFAULT);
			PlayerTextDrawShow(playerid, InventoryOtherSlotPTD[playerid][InventoryTempInfo[playerid][tSelectedOtherSlotID]]);
		}
		InventoryTempInfo[playerid][tSelectedOtherSlotID] = -1;
	}
	if (InventoryTempInfo[playerid][tChangedOtherSlotID] != -1) {
		switch (InventoryTempInfo[playerid][tInventoryShowed]) {
			case INVENTORY_TYPE_CAR: {
				targetid = InventoryTempInfo[playerid][tVehicleID];
				if (0 <= targetid < MAX_VEHICLES) {
					item_id = VehicleInfo[targetid][vItemsID][InventoryTempInfo[playerid][tChangedOtherSlotID]];
				}
			}
			case INVENTORY_TYPE_HOUSE: {
				targetid = InventoryTempInfo[playerid][tHouseID];
				if (0 <= targetid < MAX_HOUSE_COUNT) {
					item_id = gHouses[targetid][houseItemsID][InventoryTempInfo[playerid][tChangedOtherSlotID]];
				}
			}
		}
		if (0 != item_id) {
			PlayerTextDrawBackgroundColor(playerid, InventoryOtherSlotPTD[playerid][InventoryTempInfo[playerid][tChangedOtherSlotID]], INVENTORY_ITEM_COLOR_DEFAULT);
			PlayerTextDrawShow(playerid, InventoryOtherSlotPTD[playerid][InventoryTempInfo[playerid][tChangedOtherSlotID]]);
		}
		InventoryTempInfo[playerid][tChangedOtherSlotID] = -1;
	}
	return PlayerPlaySound(playerid, 17803, 0.0, 0.0, 0.0);
}


