					PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(InventoryTempInfo[playerid][tChangedSlotID])]);
				}
			}
		}
		InventoryTempInfo[playerid][tChangedSlotID] = -1;
	}
	new targetid = -1, item_id = 0;
