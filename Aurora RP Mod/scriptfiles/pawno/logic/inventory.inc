stock inventory_ClearFractionClothes(playerid) {
	for (new slotid = 0, itemid; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3); slotid++) {
		itemid = PI[playerid][pItemsID][slotid];
		switch (InventoryItemInfo[itemid][itemType]) {
			case ITEM_TYPE_SKIN: {
				if (PI[playerid][pItemsAmount][slotid] == 2) {
					PI[playerid][pItemsID][slotid] =
					PI[playerid][pItemsAmount][slotid] = 0;
				}
			}
		}
	}
	new slotid = INVENTORY_SLOT_ID_SKIN;
	if (PI[playerid][pItemsAmount][slotid] == 2) {
		PI[playerid][pItemsID][slotid] =
		PI[playerid][pItemsAmount][slotid] = 0;
		inventory_UpdateClothes(playerid);
	}
	ClearPoliceAttach(playerid);
}
stock inventory_ClearFractionWeapons(playerid, updateWeapons = 1) {
	for (new slotid = 0, itemid; slotid < INVENTORY_SLOT_ID_SKIN; slotid++) {
		itemid = PI[playerid][pItemsID][slotid];

		if (InventoryItemInfo[itemid][itemType] == ITEM_TYPE_WEAPON && PI[playerid][pItemsAmount][slotid] == 2) {
			switch (slotid) {
				case INVENTORY_SLOT_ID_WEAPON_1: {
					if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_1]) {
						PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_1] =
						PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_AMMO_1] = 0;
					}
				}
				case INVENTORY_SLOT_ID_WEAPON_2: {
					if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_2]) {
						PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_2] =
						PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_AMMO_2] = 0;
					}
				}
			}
			PI[playerid][pItemsID][slotid] =
			PI[playerid][pItemsAmount][slotid] = 0;
		}
		switch (itemid) {
			case 492 .. 499: {
				PI[playerid][pItemsID][slotid] =
				PI[playerid][pItemsAmount][slotid] = 0;
			}
		}
	}
	if (updateWeapons) inventory_UpdateWeapons(playerid);
}
