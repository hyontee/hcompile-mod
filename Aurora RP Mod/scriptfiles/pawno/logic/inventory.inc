stock inventory_ResetWeapons(playerid, type = RESET_WEAPON_TYPE_HANDS) {
	#pragma unused playerid, type

	new 
		weapon_slotid = INVENTORY_SLOT_ID_WEAPON_1, 
		ammo_slotid = INVENTORY_SLOT_ID_AMMO_1;

	if (PI[playerid][pItemsID][weapon_slotid] != 0) {
		PI[playerid][pItemsID][weapon_slotid] = 0;
		PI[playerid][pItemsAmount][weapon_slotid] = 0;
	}
	if (PI[playerid][pItemsID][ammo_slotid] != 0) {
		PI[playerid][pItemsID][ammo_slotid] = 0;
		PI[playerid][pItemsAmount][ammo_slotid] = 0;
	}
	weapon_slotid = INVENTORY_SLOT_ID_WEAPON_2;
	ammo_slotid = INVENTORY_SLOT_ID_AMMO_2;

	if (PI[playerid][pItemsID][weapon_slotid] != 0) {
		PI[playerid][pItemsID][weapon_slotid] = 0;
		PI[playerid][pItemsAmount][weapon_slotid] = 0;
	}
	if (PI[playerid][pItemsID][ammo_slotid] != 0) {
		PI[playerid][pItemsID][ammo_slotid] = 0;
		PI[playerid][pItemsAmount][ammo_slotid] = 0;
	}
	weapon_slotid = INVENTORY_SLOT_ID_WEAPON_2, 
	ammo_slotid = INVENTORY_SLOT_ID_AMMO_2;

	if (PI[playerid][pItemsID][weapon_slotid] != 0) {
		PI[playerid][pItemsID][weapon_slotid] = 0;
		PI[playerid][pItemsAmount][weapon_slotid] = 0;
	}
	if (PI[playerid][pItemsID][ammo_slotid] != 0) {
		PI[playerid][pItemsID][ammo_slotid] = 0;
		PI[playerid][pItemsAmount][ammo_slotid] = 0;
	}
	weapon_slotid = INVENTORY_SLOT_ID_WEAPON_2;
	ammo_slotid = INVENTORY_SLOT_ID_AMMO_2;

	if (PI[playerid][pItemsID][weapon_slotid] != 0) {
		PI[playerid][pItemsID][weapon_slotid] = 0;
		PI[playerid][pItemsAmount][weapon_slotid] = 0;
	}
	if (PI[playerid][pItemsID][ammo_slotid] != 0) {
		PI[playerid][pItemsID][ammo_slotid] = 0;
		PI[playerid][pItemsAmount][ammo_slotid] = 0;
	}
	switch (type) {
		case RESET_WEAPON_TYPE_FULL: {	
			for (new slotid = 0, itemid; slotid < (INVENTORY_MAX_PAGE_SLOTS * 3); slotid++) {
				itemid = PI[playerid][pItemsID][slotid];
				switch (InventoryItemInfo[itemid][itemType]) {
					case ITEM_TYPE_WEAPON, ITEM_TYPE_AMMO: {
						PI[playerid][pItemsID][slotid] = 0;
						PI[playerid][pItemsAmount][slotid] = 0;
					}
				}
			}
		}
	}
	inventory_UpdateWeapons(playerid);

	return true;
}
stock inventory_UpdateWeapons(playerid, inventoryShowed = 0) {
	if (inventoryShowed == 0)
		inventoryShowed = InventoryTempInfo[playerid][tInventoryShowed];
	ResetPlayerWeapons(playerid);
	new slot_id = INVENTORY_SLOT_ID_WEAPON_1, slot_ammo = INVENTORY_SLOT_ID_AMMO_1;

	if (PI[playerid][pItemsID][slot_id] != 0) {
		new weapon_ammo = PI[playerid][pItemsID][slot_ammo];
		if (weapon_ammo) {
			if (inventoryShowed) {
				PlayerTextDrawSetPreviewModel(playerid, InventoryPTD[playerid][21], InventoryItemInfo[weapon_ammo][itemModelID]);
				PlayerTextDrawColor(playerid, InventoryPTD[playerid][21], 0xFFFFFFFF);
				PlayerTextDrawShow(playerid, InventoryPTD[playerid][21]);
			}
			if (InventoryTempInfo[playerid][tAttachedWeapon][0]) {
				RemovePlayerAttachedObject(playerid, AttachWeaponBodyPos[0][weaponSlotID]);
				InventoryTempInfo[playerid][tAttachedWeapon][0] = 0;
			}
			if (PI[playerid][pItemsAmount][slot_ammo]) AC_GivePlayerWeapon(playerid, 
				GetWeaponidByModel(InventoryItemInfo[PI[playerid][pItemsID][slot_id]][itemModelID]), 
				PI[playerid][pItemsAmount][slot_ammo]
			);
		}
		if (inventoryShowed) {
			switch (PI[playerid][pItemsID][slot_id]) {
				case 20, 21: CHAT_GLOBAL = "~w~(.45ACP) ~y~";
				case 22: CHAT_GLOBAL = "~w~(.50AE) ~y~";
				case 23 .. 25: CHAT_GLOBAL = "~w~(12_GAUGE) ~y~";
				case 26.. 28: CHAT_GLOBAL = "~w~(9MM) ~y~";
				case 29: CHAT_GLOBAL = "~w~(7.62MM) ~y~";
				case 30: CHAT_GLOBAL = "~w~(5.56MM) ~y~";
				case 31: CHAT_GLOBAL = "~w~(.366) ~y~";
				case 32: CHAT_GLOBAL = "~w~(7.62x51_HATO) ~y~";
			}
			format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "%s%d", CHAT_GLOBAL, PI[playerid][pItemsAmount][slot_ammo]);
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][13], CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
		}
	}
	else if (inventoryShowed) PlayerTextDrawSetString(playerid, InventoryPTD[playerid][13], "~r~0");
	slot_id = INVENTORY_SLOT_ID_WEAPON_2, slot_ammo = INVENTORY_SLOT_ID_AMMO_2;

	if (PI[playerid][pItemsID][slot_id] != 0) {
		new weapon_ammo = PI[playerid][pItemsID][slot_ammo];
		if (PI[playerid][pItemsID][slot_id] == 41)
			AC_GivePlayerWeapon(playerid, GetWeaponidByModel(InventoryItemInfo[PI[playerid][pItemsID][slot_id]][itemModelID]), 20000);
		else if (PI[playerid][pItemsID][slot_id] == 502) {
			AC_GivePlayerWeapon(playerid, 41, PI[playerid][pItemsAmount][slot_id]);
		}
		else if (10 <= PI[playerid][pItemsID][slot_id] < 20) 
			AC_GivePlayerWeapon(playerid, GetWeaponidByModel(InventoryItemInfo[PI[playerid][pItemsID][slot_id]][itemModelID]), 1);
		else if (weapon_ammo) {
			if (inventoryShowed) {
				PlayerTextDrawSetPreviewModel(playerid, InventoryPTD[playerid][22], InventoryItemInfo[weapon_ammo][itemModelID]);
				PlayerTextDrawColor(playerid, InventoryPTD[playerid][22], 0xFFFFFFFF);
				PlayerTextDrawShow(playerid, InventoryPTD[playerid][22]);
			}
			if (InventoryTempInfo[playerid][tAttachedWeapon][1]) {
				RemovePlayerAttachedObject(playerid, AttachWeaponHandsPos[1][weaponSlotID]);
				InventoryTempInfo[playerid][tAttachedWeapon][1] = 0;
			}
			if (PI[playerid][pItemsAmount][slot_ammo]) AC_GivePlayerWeapon(playerid, 
				GetWeaponidByModel(InventoryItemInfo[PI[playerid][pItemsID][slot_id]][itemModelID]), 
				PI[playerid][pItemsAmount][slot_ammo]
			);
		}
		if (inventoryShowed) {
			switch (PI[playerid][pItemsID][slot_id]) {
				case 20, 21: CHAT_GLOBAL = "~w~(.45ACP) ~y~";
				case 22: CHAT_GLOBAL = "~w~(.50AE) ~y~";
				case 23 .. 25: CHAT_GLOBAL = "~w~(12_GAUGE) ~y~";
				case 26.. 28: CHAT_GLOBAL = "~w~(9MM) ~y~";
				case 29: CHAT_GLOBAL = "~w~(7.62MM) ~y~";
				case 30: CHAT_GLOBAL = "~w~(5.56MM) ~y~";
				case 31: CHAT_GLOBAL = "~w~(.366) ~y~";
				case 32: CHAT_GLOBAL = "~w~(7.62x51_HATO) ~y~";
			}
			format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "%s%d", CHAT_GLOBAL, PI[playerid][pItemsAmount][slot_ammo]);
			switch (PI[playerid][pItemsID][slot_id]) {
				case 41, 502: CHAT_GLOBAL = " ";
			}
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][14], CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
		}
	}
	else if (inventoryShowed) PlayerTextDrawSetString(playerid, InventoryPTD[playerid][14], "~r~0");

	SetPlayerArmedWeapon(playerid, 0);
}
inventory_OnPlayerUpdate(playerid) {

	if (GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return;

	new
		weaponid = GetPlayerWeapon(playerid),
		slot_id = INVENTORY_SLOT_ID_WEAPON_1,
		weapon_id = PI[playerid][pItemsID][slot_id] + 2;

	if (weaponid == 0) {
		slot_id = INVENTORY_SLOT_ID_WEAPON_2;
		weapon_id = PI[playerid][pItemsID][slot_id] + 2;

		if (PI[playerid][pItemsID][slot_id] != 0 && PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_2] == 0 && (22 <= weapon_id <= 34)) {
			if (!InventoryTempInfo[playerid][tAttachedWeapon][1]) {
				SetPlayerAttachedObject(playerid,
					AttachWeaponHandsPos[weapon_id - 22][weaponSlotID], AttachWeaponHandsPos[weapon_id - 22][weaponModelID], AttachWeaponHandsPos[weapon_id - 22][weaponBoneID],
					AttachWeaponHandsPos[weapon_id - 22][weaponPos][0], AttachWeaponHandsPos[weapon_id - 22][weaponPos][1], AttachWeaponHandsPos[weapon_id - 22][weaponPos][2],
					AttachWeaponHandsPos[weapon_id - 22][weaponPos][3], AttachWeaponHandsPos[weapon_id - 22][weaponPos][4], AttachWeaponHandsPos[weapon_id - 22][weaponPos][5],
					AttachWeaponHandsPos[weapon_id - 22][weaponPos][6], AttachWeaponHandsPos[weapon_id - 22][weaponPos][7], AttachWeaponHandsPos[weapon_id - 22][weaponPos][8]
				);
				InventoryTempInfo[playerid][tAttachedWeapon][1] = 1;
			}
		}
		else if ((PI[playerid][pItemsID][slot_id] == 0 || PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_2] == 0) && InventoryTempInfo[playerid][tAttachedWeapon][1]) {
			RemovePlayerAttachedObject(playerid, AttachWeaponHandsPos[1][weaponSlotID]);
			InventoryTempInfo[playerid][tAttachedWeapon][1] = 0;
		}
		//
		slot_id = INVENTORY_SLOT_ID_WEAPON_1;
		weapon_id = PI[playerid][pItemsID][slot_id] + 2;

		if (PI[playerid][pItemsID][slot_id] != 0 && (22 <= weapon_id <= 34) && !InventoryTempInfo[playerid][tAttachedWeapon][0]) {
			SetPlayerAttachedObject(playerid,
				AttachWeaponBodyPos[weapon_id - 22][weaponSlotID], AttachWeaponBodyPos[weapon_id - 22][weaponModelID], AttachWeaponBodyPos[weapon_id - 22][weaponBoneID],
				AttachWeaponBodyPos[weapon_id - 22][weaponPos][0], AttachWeaponBodyPos[weapon_id - 22][weaponPos][1], AttachWeaponBodyPos[weapon_id - 22][weaponPos][2],
				AttachWeaponBodyPos[weapon_id - 22][weaponPos][3], AttachWeaponBodyPos[weapon_id - 22][weaponPos][4], AttachWeaponBodyPos[weapon_id - 22][weaponPos][5],
				AttachWeaponBodyPos[weapon_id - 22][weaponPos][6], AttachWeaponBodyPos[weapon_id - 22][weaponPos][7], AttachWeaponBodyPos[weapon_id - 22][weaponPos][8]
			);
			InventoryTempInfo[playerid][tAttachedWeapon][0] = 1;
		}
		else if (PI[playerid][pItemsID][slot_id] == 0 && InventoryTempInfo[playerid][tAttachedWeapon][0]) {
			RemovePlayerAttachedObject(playerid, AttachWeaponBodyPos[0][weaponSlotID]);
			InventoryTempInfo[playerid][tAttachedWeapon][0] = 0;
		}
	}
	else {
		/*	* Если в руках крупное оружие: 
				-> Убираем атач крупного оружия, если есть
				-> Убираем атач пистолета, если есть

			* Если в руках друге: 
				-> Крепим на спину крупное оружие, если есть
				* Пистолеты: 
				* Другие: */

		switch (weaponid) {
			case 25 .. 34: {
				if (InventoryTempInfo[playerid][tAttachedWeapon][0]) {
					RemovePlayerAttachedObject(playerid, AttachWeaponBodyPos[0][weaponSlotID]);
					InventoryTempInfo[playerid][tAttachedWeapon][0] = 0;
				}
				if (InventoryTempInfo[playerid][tAttachedWeapon][1]) {
					RemovePlayerAttachedObject(playerid, AttachWeaponHandsPos[1][weaponSlotID]);
					InventoryTempInfo[playerid][tAttachedWeapon][1] = 0;
				}
			}
			default: {
				slot_id = INVENTORY_SLOT_ID_WEAPON_1;
				weapon_id = PI[playerid][pItemsID][slot_id] + 2;

				if (PI[playerid][pItemsID][slot_id] != 0 && (22 <= weapon_id <= 34) && !InventoryTempInfo[playerid][tAttachedWeapon][0]) {
					SetPlayerAttachedObject(playerid,
						AttachWeaponBodyPos[weapon_id - 22][weaponSlotID], AttachWeaponBodyPos[weapon_id - 22][weaponModelID], AttachWeaponBodyPos[weapon_id - 22][weaponBoneID],
						AttachWeaponBodyPos[weapon_id - 22][weaponPos][0], AttachWeaponBodyPos[weapon_id - 22][weaponPos][1], AttachWeaponBodyPos[weapon_id - 22][weaponPos][2],
						AttachWeaponBodyPos[weapon_id - 22][weaponPos][3], AttachWeaponBodyPos[weapon_id - 22][weaponPos][4], AttachWeaponBodyPos[weapon_id - 22][weaponPos][5],
						AttachWeaponBodyPos[weapon_id - 22][weaponPos][6], AttachWeaponBodyPos[weapon_id - 22][weaponPos][7], AttachWeaponBodyPos[weapon_id - 22][weaponPos][8]
					);
					InventoryTempInfo[playerid][tAttachedWeapon][0] = 1;
				}
				else if (PI[playerid][pItemsID][slot_id] == 0 && InventoryTempInfo[playerid][tAttachedWeapon][0]) {
					RemovePlayerAttachedObject(playerid, AttachWeaponBodyPos[0][weaponSlotID]);
					InventoryTempInfo[playerid][tAttachedWeapon][0] = 0;
				}
			}
		}
	}
}
inventory_OnPlayerClickPlayerTD(playerid, PlayerText:playertextid) {
	if (!InventoryTempInfo[playerid][tInventoryShowed])
		return false;
	new bool:isReturn = false;

	if (InventoryTempInfo[playerid][tContextMenuShowed]) {
		if (playertextid == InventoryContextPTD[playerid][sizeof (InventoryContextPTD[]) - 1]) {
			PlayerPlaySound(playerid, 17803, 0.0, 0.0, 0.0);
			inventory_HideContextMenu(playerid);
			//inventory_NullSlots(playerid);
			return true;
		}
		for (new ptd_id = 0; ptd_id < sizeof (InventoryContextPTD[]) - 1; ptd_id++) {
			if (playertextid != InventoryContextPTD[playerid][ptd_id]) continue;

			switch (InventoryTempInfo[playerid][tInventoryContextMenu][ptd_id]) {
				case INVENTORY_LANG_ID_USE: inventory_UseItem(playerid);
				case INVENTORY_LANG_ID_DROP: inventory_DropItem(playerid);
				case INVENTORY_LANG_ID_GIVE: inventory_GiveItem(playerid);
				case INVENTORY_LANG_ID_REMOVE: inventory_RemoveItem(playerid);
				case INVENTORY_LANG_ID_DISCHARGE: inventory_DischargeItem(playerid);
				case INVENTORY_LANG_ID_CHARGE: inventory_ChargeItem(playerid);
				case INVENTORY_LANG_ID_EDIT: inventory_EditItem(playerid);
				case INVENTORY_LANG_ID_SELL: inventory_SellItem(playerid);
				case INVENTORY_LANG_ID_INFO: inventory_InfoItem(playerid);
				case INVENTORY_LANG_ID_SPLIT: { }
			}
			PlayerPlaySound(playerid, 17803, 0.0, 0.0, 0.0);

			isReturn = true;
			break;
		}
	}
	if (isReturn) return true;

	if (playertextid == InventoryPTD[playerid][28]) {
		if (IsChangeClothesBlocked(playerid)) {
			ErrorMessage(playerid, "В данный момент нельзя переодеть одежду.");
			inventory_HideContextMenu(playerid);
			inventory_NullSlots(playerid);
			return true;
		}
		PlayerPlaySound(playerid, 17803, 0.0, 0.0, 0.0);

		new 
			skin_itemid = PI[playerid][pItemsID][INVENTORY_SLOT_ID_SKIN],
			slotid = InventoryTempInfo[playerid][tChangedSlotID];
			
		if (skin_itemid == 0) {
			if (slotid != -1) {
				new itemid = PI[playerid][pItemsID][slotid];
				if (InventoryItemInfo[itemid][itemType] != ITEM_TYPE_SKIN) {
					ErrorMessage(playerid, "Данный слот предназначен для одежды персонажа.");
					inventory_NullSlots(playerid);
					return true;
				}
				if (PI[playerid][pSex] == 1 && GetSkinGender(InventoryItemInfo[itemid][itemModelID]) == SKIN_GENDER_MALE) { }
				else if (PI[playerid][pSex] == 2 && GetSkinGender(InventoryItemInfo[itemid][itemModelID]) == SKIN_GENDER_FEMALE) { }
				else {
					ErrorMessage(playerid, "Данная одежда не подходит вашему полу.");
					inventory_NullSlots(playerid);
					return true;
				}
				PI[playerid][pItemsID][INVENTORY_SLOT_ID_SKIN] = PI[playerid][pItemsID][slotid];
				PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_SKIN] = PI[playerid][pItemsAmount][slotid];

				PI[playerid][pItemsID][slotid] = 0;
				PI[playerid][pItemsAmount][slotid] = 0;
				
				if (InventoryTempInfo[playerid][tInventoryShowed]) {
					PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID]
					);
					PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
						InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
					);
					PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slotid)],
						GetInventoryAmount(playerid, PI[playerid][pItemsID][slotid], PI[playerid][pItemsAmount][slotid])
					);
					PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
					PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)]);
				}
				inventory_UpdateClothes(playerid);
				inventory_UpdateAmounts(playerid);
				inventory_UpdateAmounts(playerid, INVENTORY_SLOT_ID_SKIN);
				inventory_UpdateWeightPTD(playerid);
				inventory_NullSlots(playerid);
			}
		}
		else {
			if (slotid != -1) {
				if (slotid == INVENTORY_SLOT_ID_SKIN) {
					InventoryTempInfo[playerid][tSelectedSlotID] =
					InventoryTempInfo[playerid][tChangedSlotID] = INVENTORY_SLOT_ID_SKIN;
