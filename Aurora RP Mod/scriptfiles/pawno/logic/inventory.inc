		case 25: item_id = 23, ammo_id = 35;
		case 26: item_id = 24, ammo_id = 35;
		case 27: item_id = 25, ammo_id = 35;
		case 28: item_id = 26, ammo_id = 36;
		case 29: item_id = 28, ammo_id = 36;
		case 32: item_id = 27, ammo_id = 36;
		case 30: item_id = 29, ammo_id = 37;
		case 31: item_id = 30, ammo_id = 38;
		case 33: item_id = 31, ammo_id = 39;
		case 34: item_id = 32, ammo_id = 40;
		default: return false;
	}
	new
		weapon_slotid = INVENTORY_SLOT_ID_WEAPON_2,
		ammo_slotid = INVENTORY_SLOT_ID_AMMO_2;

	switch (weaponid) {
		case 25 .. 34: {
			weapon_slotid = INVENTORY_SLOT_ID_WEAPON_1,
			ammo_slotid = INVENTORY_SLOT_ID_AMMO_1;
		}
	}
	if (PI[playerid][pItemsID][weapon_slotid] == item_id ) {
		if (ammo_id) {
			PI[playerid][pItemsID][ammo_slotid] = ammo_id;
			PI[playerid][pItemsAmount][ammo_slotid] += ammo;
		}
	} else {
		PI[playerid][pItemsID][weapon_slotid] = item_id;
		PI[playerid][pItemsAmount][weapon_slotid] = 1;
		if (ammo_id) {
			PI[playerid][pItemsID][ammo_slotid] = ammo_id;
			PI[playerid][pItemsAmount][ammo_slotid] = ammo;
		}
	}
	inventory_UpdateWeapons(playerid);
	inventory_NullSlots(playerid);

	return true;
}
stock inventory_GiveWeapon(playerid, weaponid, isAmmo = 0, type = 1) {
	new item_id, ammo_id;
	switch (weaponid) {
		case 1: item_id = 10;
		case 2: item_id = 11;
		case 3: item_id = 12;
		case 4: item_id = 13;
		case 14: item_id = 14;
		case 15: item_id = 15;
		case 6: item_id = 16;
		case 7: item_id = 17;
		case 8: item_id = 18;
		case 5: item_id = 19;
		case 22: item_id = 20, ammo_id = 33;
		case 23: item_id = 21, ammo_id = 33;
		case 24: item_id = 22, ammo_id = 34;
		case 25: item_id = 23, ammo_id = 35;
		case 26: item_id = 24, ammo_id = 35;
		case 27: item_id = 25, ammo_id = 35;
		case 28: item_id = 26, ammo_id = 36;
		case 29: item_id = 28, ammo_id = 36;
		case 32: item_id = 27, ammo_id = 36;
		case 30: item_id = 29, ammo_id = 37;
		case 31: item_id = 30, ammo_id = 38;
		case 33: item_id = 31, ammo_id = 39;
		case 34: item_id = 32, ammo_id = 40;
		default: return false;
	}
	new slots = (!isAmmo) ? 1 : 2;

	if (
		GetAvailableInventorySlots(playerid) < slots || 
		Float:(GetInventoryWeight(playerid) + GetWeightItem(item_id) + GetWeightItem(ammo_id, isAmmo)) > Float:InventoryTempInfo[playerid][tAvailableWeight]
	) {
