stock inventory_UpdateBackpack(playerid) {
	new 
		backpackLevel = 0, Float:backpackWeight = 30.0;
	// itemid = PI[playerid][pItemsID][INVENTORY_SLOT_ID_BACKPACK];

	if (TYPE_VIP[playerid] != VIP_STATE_NONE) {
		backpackWeight += VipData[TYPE_VIP[playerid]][VipInventory];
	}
	InventoryTempInfo[playerid][tAvailableWeight] = backpackWeight;

	return backpackLevel;
}
stock IsSimilarityAmmo(weapon_itemid, ammo_itemid) {
	if (!(20 <= weapon_itemid <= 32)) 
		return false;
	weapon_itemid -= 20;
	if (492 <= ammo_itemid <= 499)
		ammo_itemid -= 459;
	if (AmmoSimilarityWeapon[weapon_itemid][1] != ammo_itemid) 
		return false;
	return true;
}
