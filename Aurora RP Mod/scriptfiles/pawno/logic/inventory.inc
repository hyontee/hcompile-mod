			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][17], inventory_LangText(languageid, INVENTORY_LANG_ID_PHONE));
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][18], inventory_LangText(languageid, INVENTORY_LANG_ID_BACKPACK));
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][19], inventory_LangText(languageid, INVENTORY_LANG_ID_ARMOUR));
		}
		case SLOT_TYPE_ACCESORY: {
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][15], inventory_LangText(languageid, INVENTORY_LANG_ID_ACCESSORY));

			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][16], inventory_LangText(languageid, INVENTORY_LANG_ID_HEAD));
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][17], inventory_LangText(languageid, INVENTORY_LANG_ID_GLASSES));
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][18], inventory_LangText(languageid, INVENTORY_LANG_ID_BANDANA));
			PlayerTextDrawSetString(playerid, InventoryPTD[playerid][19], inventory_LangText(languageid, INVENTORY_LANG_ID_WATCHES));
		}
	}
	switch (languageid) {
		case INVENTORY_LANGUAGE_RUSSIAN: {
			PlayerTextDrawBoxColor(playerid, InventoryPTD[playerid][25], 255);
