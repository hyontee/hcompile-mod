CMD:giveitem(playerid, params[]) {
	if (PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return true;

	new targetid, item, amount;
	if (sscanf(params, "iii", targetid, item, amount) ||
		!IsPlayerConnected(targetid) || !(1 <= item < sizeof (InventoryItemInfo)) || !(1 <= amount <= 1000000)
	) return ErrorMessage(playerid, "(debug) /giveitem [playerid] [itemid (1 - 41)] [amount (1 - 1,000,000)]");

	GivePlayerItem(targetid, item, amount);
	printf("(debug:%d) GivePlayerItem(targetid = %d, item = %d, amount = %d)", playerid, targetid, item, amount);
	return true;
}
CMD:giveskin(playerid, params[]) {
	if (PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return true;

	new targetid, item, amount;
	if (sscanf(params, "iii", targetid, item, amount) ||
		!IsPlayerConnected(targetid) || !(1 + 180 <= item + 180 < 311 + 180) || !(1 <= amount <= 2)
	) return ErrorMessage(playerid, "(debug) /giveskin [playerid] [skinid (1 - 311)] [type 1 | 2 - fraction]");

	GivePlayerSkin(targetid, item, amount);
	printf("(debug:%d) GivePlayerItem(targetid = %d, item = %d, amount = %d)", playerid, targetid, item, amount);
	return true;
}
static dropped_item_id = 0;

stock CreateDroppedItem(Float:x, Float:y, Float:z, interiorid, worldid, item_id, item_amount) {
	if (!(0 <= item_id < sizeof (InventoryItemInfo)) || item_amount <= 0)
		return 0;
	new di_id = Iter_Free(DroppedItems), Float:rotPos[3];

	if (di_id == -1)  {
		if (++dropped_item_id >= MAX_DROPPED_ITEMS)
			dropped_item_id = 0;
		di_id = dropped_item_id;
		DestroyDroppedItem(di_id);
	}
	DroppedItemsInfo[di_id][itemModelID] = InventoryItemInfo[item_id][itemModelID];

	switch (InventoryItemInfo[item_id][itemType]) {
		case ITEM_TYPE_SKIN: DroppedItemsInfo[di_id][itemModelID] = 2386;
		case ITEM_TYPE_WEAPON: rotPos[0] = 93.7, rotPos[1] = rotPos[2] = 120.0;
	}
	DroppedItemsInfo[di_id][itemPos][0] = x;
	DroppedItemsInfo[di_id][itemPos][1] = y;
	DroppedItemsInfo[di_id][itemPos][2] = z;

	DroppedItemsInfo[di_id][itemWorld] = worldid;
	DroppedItemsInfo[di_id][itemInterior] = interiorid;

	DroppedItemsInfo[di_id][itemObjectID] = CreateDynamicObject(DroppedItemsInfo[di_id][itemModelID],
		DroppedItemsInfo[di_id][itemPos][0], DroppedItemsInfo[di_id][itemPos][1], DroppedItemsInfo[di_id][itemPos][2] - 1.0,
		rotPos[0], rotPos[1], rotPos[2], DroppedItemsInfo[di_id][itemWorld], DroppedItemsInfo[di_id][itemInterior],
		-1, 40.0, 40.0
	);
	format(STRING_GLOBAL, sizeof (STRING_GLOBAL), ""P"%s\n"W"Чтобы поднять, нажмите "P"\"ALT\"", InventoryItemInfo[item_id][itemName]);

	DroppedItemsInfo[di_id][itemText] = CreateDynamic3DTextLabel(STRING_GLOBAL, 0xFFFFFFFF,
		DroppedItemsInfo[di_id][itemPos][0], DroppedItemsInfo[di_id][itemPos][1],
		DroppedItemsInfo[di_id][itemPos][2] - 1.0, 1.1, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,
		DroppedItemsInfo[di_id][itemWorld], DroppedItemsInfo[di_id][itemInterior]
	);
	STRING_GLOBAL[0] = EOS;

	new areaid = DroppedItemsInfo[di_id][itemArea] = CreateDynamicSphere(
		DroppedItemsInfo[di_id][itemPos][0],
		DroppedItemsInfo[di_id][itemPos][1],
		DroppedItemsInfo[di_id][itemPos][2] - 1.0,
		2.0, DroppedItemsInfo[di_id][itemWorld],
		DroppedItemsInfo[di_id][itemInterior]
	);
	SetDynamicAreaType(areaid, AREA_TYPE_DROPPED_ITEM);
	DroppedItemsInfo[di_id][itemID] = item_id;
	DroppedItemsInfo[di_id][itemAmount] = item_amount;

	Iter_Add(DroppedItems, di_id);
	return di_id;
}
stock DestroyDroppedItem(di_id) {
	if (!IsValidDroppedItem(di_id))
		return 0;

	DroppedItemsInfo[di_id][itemPos][0] = 0.0;
	DroppedItemsInfo[di_id][itemPos][1] = 0.0;
	DroppedItemsInfo[di_id][itemPos][2] = 0.0;

	if (IsValidDynamicObject(DroppedItemsInfo[di_id][itemObjectID]))
		DestroyDynamicObject(DroppedItemsInfo[di_id][itemObjectID]);
	if (IsValidDynamicArea(DroppedItemsInfo[di_id][itemArea]))
		DestroyDynamicArea(DroppedItemsInfo[di_id][itemArea]);
	if (IsValidDynamic3DTextLabel(DroppedItemsInfo[di_id][itemText]))
		DestroyDynamic3DTextLabel(DroppedItemsInfo[di_id][itemText]);

	DroppedItemsInfo[di_id][itemID] = DroppedItemsInfo[di_id][itemAmount] =
	DroppedItemsInfo[di_id][itemWorld] = DroppedItemsInfo[di_id][itemInterior] =
	DroppedItemsInfo[di_id][itemModelID] = 0;

	Iter_Remove(DroppedItems, di_id);
	return di_id;
}
OnDroppedItemsTimer() {
	if (++onDroppedItemsTimer < ON_DESTROY_ITEM_TIMER) return;
	onDroppedItemsTimer = 0;

	for (new item_id; item_id < MAX_DROPPED_ITEMS; item_id++) {
		if (!IsValidDroppedItem(item_id))
			continue;
		DroppedItemsInfo[item_id][itemTimer] += ON_DESTROY_ITEM_TIMER;

		if (DroppedItemsInfo[item_id][itemTimer] < DROPPED_ITEM_DESTROY_TIMER) continue;
		DestroyDroppedItem(item_id);
	}
}
stock inventory_UseItem(playerid, slot_id = -1) {
	if (InventoryTempInfo[playerid][tChangedSlotID] == -1) return false;

	new slotid = InventoryTempInfo[playerid][tChangedSlotID];
	if (slot_id != -1) slotid = slot_id;
	new itemid = PI[playerid][pItemsID][slotid];

	if (!(1 <= itemid < sizeof (InventoryItemInfo))) return false;

	InventoryTempInfo[playerid][tActionSelectedSlotID] = slotid;

	switch (InventoryItemInfo[itemid][itemType]) {
		case ITEM_TYPE_ARMOUR: {

			if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]) {
				new
					item_id = PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR],
					item_amount = PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR];

				PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR] = PI[playerid][pItemsID][slotid];
				PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR] = PI[playerid][pItemsAmount][slotid];

				PI[playerid][pItemsID][slotid] = item_id;
				PI[playerid][pItemsAmount][slotid] = item_amount;
			}
			else {
				PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR] = PI[playerid][pItemsID][slotid];
				PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR] = PI[playerid][pItemsAmount][slotid];

				PI[playerid][pItemsID][slotid] = 0;
				PI[playerid][pItemsAmount][slotid] = 0;
			}
			if (InventoryTempInfo[playerid][tInventoryShowed]) {
				PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(INVENTORY_SLOT_ID_ARMOUR)],
					InventoryItemInfo[PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]][itemModelID]
				);
				PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(INVENTORY_SLOT_ID_ARMOUR)],
					InventoryItemInfo[PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]][itemPos][0],
					InventoryItemInfo[PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]][itemPos][1],
					InventoryItemInfo[PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]][itemPos][2],
					InventoryItemInfo[PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]][itemPos][3]
				);
				PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(INVENTORY_SLOT_ID_ARMOUR)],
					GetInventoryAmount(playerid, PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR], PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR])
				);
				PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(INVENTORY_SLOT_ID_ARMOUR)], INVENTORY_ITEM_COLOR_DEFAULT);
				PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(INVENTORY_SLOT_ID_ARMOUR)]);

				PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID]
