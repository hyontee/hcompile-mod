stock inventory_UseDrugs(playerid, amount = 1, item_id = 166) {
	if (TI[playerid][tDuel] != -1 || player_to_game[playerid]) return 1;
	if (GetPVarInt(playerid, "anti_sbiv_time") > unix) return 1;
	if (TI[playerid][tDMArea][0]) return ErrorMessage(playerid, "Нельзя использовать на данном мероприятии");
	if (TI[playerid][tGunArea][0]) return ErrorMessage(playerid, "Нельзя использовать на данном мероприятии");
	if (player_to_golod[playerid]) return ErrorMessage(playerid, "Нельзя использовать на голодных играх");
	if (TI[playerid][tDuel] != -1) return ErrorMessage(playerid, "Нельзя использовать на дуэлях");

	new item_amount = ItemCounts(playerid, item_id);
	if (item_amount <= 0) return ErrorMessage(playerid, "У Вас нет наркотиков");

	new Float: PlayerHP;
	GetPlayerHealth(playerid, PlayerHP);

	if (!(1 <= amount <= 15))
	{
		if (PI[playerid][pAddiction] < 2000)
		{
			if (item_amount >= 5) amount = 5;
			if (item_amount > 0 && item_amount < 5) amount = item_amount;
		}
		else if (PI[playerid][pAddiction] < 5000)
		{
			if (item_amount >= 10) amount = 10;
			if (item_amount > 0 && item_amount < 10) amount = item_amount;
		}
		else if (PI[playerid][pAddiction] > 5000)
		{
			if (item_amount >= 15) amount = 15;
			if (item_amount > 0 && item_amount < 15) amount = item_amount;
		}
	}
	if (item_amount < amount) return ErrorMessage(playerid, "У вас нет столько наркотиков");
	if (amount < 1) return ErrorMessage(playerid, "Значение не может быть менее 1");
	if (PI[playerid][pAddiction] < 2000 && amount > 5) return ErrorMessage(playerid, "Вы не можете принять более 5 грамм наркотиков");
	if (PI[playerid][pAddiction] < 5000 && amount > 10) return ErrorMessage(playerid, "Вы не можете принять более 10 грамм наркотиков");
	else if (amount > 15) return ErrorMessage(playerid, "Вы не можете принять более 15 грамм наркотиков");

	new ReasonHeal = 5;
	
	switch (item_id) {
		case 166: ReasonHeal = 5;
		case 167: ReasonHeal = 10;
	}
	if (TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		ReasonHeal = VipData[TYPE_VIP[playerid]][VipUseDrugs];
	}

	if (PI[playerid][pAddiction] < 2000 && (PlayerHP + (ReasonHeal * amount)) > 120)
	{
		if (GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOk(playerid, "Уровень здоровья пополнен до 120 единиц");
			SetPlayerHealth(playerid, 120);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else if (PI[playerid][pAddiction] < 5000 && (PlayerHP + (ReasonHeal * amount)) > 140)
	{
		if (GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOk(playerid, "Уровень здоровья пополнен до 140 единиц");
			SetPlayerHealth(playerid, 140);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else if (PI[playerid][pAddiction] > 5000 && (PlayerHP + (ReasonHeal * amount)) > 160)
	{
		if (GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOk(playerid, "Уровень здоровья пополнен до 160 единиц");
			SetPlayerHealth(playerid, 160);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");
	}
	else
	{
		if (GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Уровень здоровья пополнен до %.0f единиц", (PlayerHP + (ReasonHeal * amount)));
			SendClientMessage(playerid, 0xFFFFFFFF, STRING_GLOBAL);
			SetPlayerHealth(playerid, (PlayerHP + (ReasonHeal * amount)));
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "(( Здоровье можно пополнить не чаще, чем раз в 30 секунд ))");

		if (PI[playerid][pAddiction] < 2000)
		{
			UsingDrugs[playerid] = 10;
			SetPlayerTime(playerid, 17, 0);
			SetPlayerWeather(playerid, -68);
			SetPlayerDrunkLevel(playerid, 3000);
		}
	}

	if (PI[playerid][pSex] == 1)
	{
		SetPlayerChatBubble(playerid, "употребил наркотик", COLOR_PURPLE, 30.0, 5000);
		MeAction(playerid, "употребил наркотик");
	}
	if (PI[playerid][pSex] == 2)
	{
		SetPlayerChatBubble(playerid, "употребила наркотик", COLOR_PURPLE, 30.0, 5000);
		MeAction(playerid, "употребила наркотик");
	}

	if (IsPlayerInRangeOfPoint(playerid, 20.0, 2628.4819, -589.2004, 2768.9805) == 0)
	{
		if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT || GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
		{
			PlayerHealFix[playerid] = 1;
			PlayerHealExFix[playerid] = unix + 3;
			TogglePlayerControllable(playerid, false);
		}
	}

	if (IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
	else ApplyAnimation(playerid, "SMOKING", "M_smk_drag", 4.1, 0, 0, 0, 0, 0, 1);
	SetPVarInt(playerid, "anti_sbiv_time", unix + 3);
	PI[playerid][pAddiction] += (5 * amount);
	GivePlayerItem(playerid, item_id, -amount, 2);
	PI[playerid][pStartLomka] = 0;
	PI[playerid][pNarcoLomka] = 0;
	return 0x1;
}
stock inventory_GiveItem(playerid, slot_id = -1) {
	if (InventoryTempInfo[playerid][tChangedSlotID] == -1) 
		return false;
	new slotid = InventoryTempInfo[playerid][tChangedSlotID];
	if (slot_id != -1) slotid = slot_id;
	new itemid = PI[playerid][pItemsID][slotid];

	if (!(1 <= itemid < sizeof (InventoryItemInfo))) 
		return false;
	if (!IsDroppableItem(playerid, itemid, PI[playerid][pItemsAmount][slotid])) 
		return false;
	switch (slotid) {
		case INVENTORY_SLOT_ID_WEAPON_1: if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_1] != 0) {
			inventory_NullSlots(playerid);
			ErrorMessage(playerid, "Сначала разрядите оружие, перед тем как выбрасывать.");
			return false;
		}
		case INVENTORY_SLOT_ID_WEAPON_2: if (PI[playerid][pItemsID][INVENTORY_SLOT_ID_AMMO_2] != 0) {
			inventory_NullSlots(playerid);
			ErrorMessage(playerid, "Сначала разрядите оружие, перед тем как выбрасывать.");
			return false;
		}
	}
	format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), ""P"Передать %s", InventoryItemInfo[itemid][itemName]);

	if (IsSplittableItem(itemid)) {
		ShowPlayerDialog(playerid, D_INVENTORY_GIVE_ID_AMOUNT, DIALOG_STYLE_INPUT, CHAT_GLOBAL, ""W"\
			"W"Введите через запятую:\n\
