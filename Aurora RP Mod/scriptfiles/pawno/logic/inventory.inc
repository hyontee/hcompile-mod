stock inventory_PickItem(playerid) {
	if (InventoryTempInfo[playerid][tDroppedItemArea] == -1) return false;

	new item_id = -1;
	foreach (new di_id: DroppedItems) {
		if (!IsValidDroppedItem(di_id))
			continue;
		if (!IsPlayerInRangeOfPoint(playerid, 0.75, DroppedItemsInfo[di_id][itemPos][0], DroppedItemsInfo[di_id][itemPos][1], DroppedItemsInfo[di_id][itemPos][2]))
			continue;
		item_id = di_id;
		break;
	}
	if (item_id == -1) return false;

	if (!GivePlayerItem(playerid, DroppedItemsInfo[item_id][itemID], DroppedItemsInfo[item_id][itemAmount]))
		return false;
	DestroyDroppedItem(item_id);

	ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0, 0);
	return true;
}
