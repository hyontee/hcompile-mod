	if (PI[targetid][pItemsID][INVENTORY_SLOT_ID_BANDANA] && PI[targetid][pItemsAmount][INVENTORY_SLOT_ID_BANDANA]) {
		format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"6. "W"Бандана / маска: "P"%s\n", 
			InventoryItemInfo[PI[targetid][pItemsID][INVENTORY_SLOT_ID_BANDANA]][itemName]
		);
