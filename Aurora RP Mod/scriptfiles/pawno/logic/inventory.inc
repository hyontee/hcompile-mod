		case INVENTORY_LANGUAGE_ENGLISH: {
			PlayerTextDrawBoxColor(playerid, InventoryPTD[playerid][25], 8388732);
			PlayerTextDrawBoxColor(playerid, InventoryPTD[playerid][26], 255);
		}
	}
	PlayerTextDrawShow(playerid, InventoryPTD[playerid][25]);
	PlayerTextDrawShow(playerid, InventoryPTD[playerid][26]);

	inventory_HideContextMenu(playerid);
	PlayerPlaySound(playerid, 17803, 0.0, 0.0, 0.0);


	new start_slotid, slot_id[2], page = InventoryTempInfo[playerid][tInventoryPageSlot];
	slot_id[0] = InventoryTempInfo[playerid][tSelectedSlotID];
	slot_id[1] = InventoryTempInfo[playerid][tChangedSlotID];

	for (new slotid = (start_slotid = (page - 1) * INVENTORY_MAX_PAGE_SLOTS), slot_itemid; slotid < (start_slotid + INVENTORY_MAX_PAGE_SLOTS); slotid++) {
		slot_itemid = PI[playerid][pItemsID][slotid];

