		format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"3. "W"Бронежилет: "P"%s\n", 
			InventoryItemInfo[PI[targetid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]][itemName]
