		format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"4. "W"Головной убор: "P"%s\n", 
			InventoryItemInfo[PI[targetid][pItemsID][INVENTORY_SLOT_ID_HEAD]][itemName]
		);
	}
	else format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"4. "W"Головной убор: "G"не используется\n");
	playerListitemID[targetid][idx++] = INVENTORY_SLOT_ID_HEAD;
	strcat(STRING_GLOBAL, COMMAND_GLOBAL);

	if (PI[targetid][pItemsID][INVENTORY_SLOT_ID_GLASSES] && PI[targetid][pItemsAmount][INVENTORY_SLOT_ID_GLASSES]) {
		format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"5. "W"Очки: "P"%s\n", 
			InventoryItemInfo[PI[targetid][pItemsID][INVENTORY_SLOT_ID_GLASSES]][itemName]
		);
	}
	else format(COMMAND_GLOBAL, sizeof (COMMAND_GLOBAL), ""ORANGE"5. "W"Очки: "G"не используется\n");
	playerListitemID[targetid][idx++] = INVENTORY_SLOT_ID_GLASSES;
