inventory_OnPlayerDeath(playerid, killerid, reason) {
	if (
		!TI[playerid][tLogin] || 
		TI[playerid][tDuel] != -1 || 
		player_to_game[playerid] || 
		player_to_golod[playerid] ||
		TI[playerid][tDMArea][0] || 
		TI[playerid][tGunArea][0] 
	) return;

	new
		weapon_slotid = INVENTORY_SLOT_ID_WEAPON_1, Float:playerPos[3],
		ammo_slotid = INVENTORY_SLOT_ID_AMMO_1;

	GetPlayerPos(playerid, playerPos[0], playerPos[1], playerPos[2]);

	if (PI[playerid][pItemsID][weapon_slotid] != 0) {
		if (PI[playerid][pItemsAmount][weapon_slotid] != 2) {
			CreateDroppedItem(playerPos[0] + 0.25, playerPos[1], playerPos[2],
				GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid),
				PI[playerid][pItemsID][weapon_slotid], PI[playerid][pItemsAmount][weapon_slotid]
			);
		}
		PI[playerid][pItemsID][weapon_slotid] = PI[playerid][pItemsAmount][weapon_slotid] = 0;

		if (PI[playerid][pItemsID][ammo_slotid] != 0) {
			if (33 <= PI[playerid][pItemsID][ammo_slotid] <= 40) {	
				CreateDroppedItem(playerPos[0] + 1.0, playerPos[1], playerPos[2],
					GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid),
					PI[playerid][pItemsID][ammo_slotid], PI[playerid][pItemsAmount][ammo_slotid]
				);
			}
			PI[playerid][pItemsID][ammo_slotid] = PI[playerid][pItemsAmount][ammo_slotid] = 0;
		}
	}
	weapon_slotid = INVENTORY_SLOT_ID_WEAPON_2;
	ammo_slotid = INVENTORY_SLOT_ID_AMMO_2;

	if (PI[playerid][pItemsID][weapon_slotid] != 0) {
		if (PI[playerid][pItemsAmount][weapon_slotid] != 2) {
			CreateDroppedItem(playerPos[0] + 0.35, playerPos[1], playerPos[2],
				GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid),
				PI[playerid][pItemsID][weapon_slotid], PI[playerid][pItemsAmount][weapon_slotid]
			);
		}
		PI[playerid][pItemsID][weapon_slotid] = PI[playerid][pItemsAmount][weapon_slotid] = 0;

		if (PI[playerid][pItemsID][ammo_slotid] != 0) {
			if (33 <= PI[playerid][pItemsID][ammo_slotid] <= 40) {	
				CreateDroppedItem(playerPos[0] + 1.1, playerPos[1], playerPos[2],
					GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid),
					PI[playerid][pItemsID][ammo_slotid], PI[playerid][pItemsAmount][ammo_slotid]
				);
			}
			PI[playerid][pItemsID][ammo_slotid] = PI[playerid][pItemsAmount][ammo_slotid] = 0;
		}
	}
	#pragma unused killerid, reason
}
stock StopEditAccesory(playerid, showMessage = 1) {
	if (!InventoryTempInfo[playerid][tEditAccessorySlot]) return false;
	new slotid = (InventoryTempInfo[playerid][tEditAccessorySlot] - 1);

	InventoryTempInfo[playerid][tEditAccessorySlot] = 0;
	inventory_UpdateAccesory(playerid, slotid);

	if(showMessage)
		ErrorMessage(playerid, "Вы отменили редактирование аксессуара.");
	return true;
}
stock inventory_RemoveItem(playerid, slot_id = -1) {
	if (InventoryTempInfo[playerid][tChangedSlotID] == -1) return false;

	new slotid = InventoryTempInfo[playerid][tChangedSlotID], free_slotid = -1;
	if (slot_id != -1) slotid = slot_id;
	if (slotid < INVENTORY_MAX_PAGE_SLOTS * 3) return false;

	new 
		item_id = PI[playerid][pItemsID][slotid],
		item_amount = PI[playerid][pItemsAmount][slotid];

	if (!(1 <= item_id < sizeof (InventoryItemInfo))) return false;

	for (new i = 0; i < (INVENTORY_MAX_PAGE_SLOTS * 3); i++) { 
		switch (GetBackpackLevel(playerid)) {
			case 1: { }
			default: if (i >= (INVENTORY_MAX_PAGE_SLOTS * 2) && i < (INVENTORY_MAX_PAGE_SLOTS * 3)) continue;
		}
		if (PI[playerid][pItemsID][i] == 0) {
			free_slotid = i;
			break;
		}
	}
	if (free_slotid == -1) {
		ErrorMessage(playerid, "У вас недостаточно места в инвентаре.");
		return false;
	}
	if (Float:(GetInventoryWeight(playerid) + GetWeightItem(item_id, item_amount)) > Float:InventoryTempInfo[playerid][tAvailableWeight]) {
		ErrorMessage(playerid, "У Вас недостаточно места в инвентаре!");
		return false;
	}
	if (slotid == INVENTORY_SLOT_ID_BACKPACK && GetInventoryWeight(playerid) > 30.0) {
		inventory_NullSlots(playerid);
		ErrorMessage(playerid, "У вас недостаточно места в инвентаре, опустошите его до 30 кг.");
		return false;
	}
	PI[playerid][pItemsID][free_slotid] = item_id;
	PI[playerid][pItemsAmount][free_slotid] = item_amount;

	PI[playerid][pItemsID][slotid] = 0;
	PI[playerid][pItemsAmount][slotid] = 0;

	inventory_UpdateClothes(playerid);
	inventory_UpdateAccesory(playerid);
	inventory_UpdateWeapons(playerid);
	inventory_NullSlots(playerid);
	inventory_UpdateWeightPTD(playerid);

	// printf("slotid = %d | item_id = %d", slotid, item_id);
	if (InventoryTempInfo[playerid][tInventoryShowed]) {
		if (InventoryTempInfo[playerid][tInventoryPageSlot] == GetInventoryPage(free_slotid)) {
			PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(free_slotid)],
				InventoryItemInfo[PI[playerid][pItemsID][free_slotid]][itemModelID]
			);
			PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(free_slotid)],
				InventoryItemInfo[PI[playerid][pItemsID][free_slotid]][itemPos][0],
				InventoryItemInfo[PI[playerid][pItemsID][free_slotid]][itemPos][1],
				InventoryItemInfo[PI[playerid][pItemsID][free_slotid]][itemPos][2],
				InventoryItemInfo[PI[playerid][pItemsID][free_slotid]][itemPos][3]
			);
			PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(free_slotid)],
				GetInventoryAmount(playerid, PI[playerid][pItemsID][free_slotid], PI[playerid][pItemsAmount][free_slotid])
			);
			PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(free_slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
			PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(free_slotid)]);
		}

		switch (slotid) {
			case INVENTORY_SLOT_ID_WEAPON_1, INVENTORY_SLOT_ID_WEAPON_2: {
				if (slotid == INVENTORY_SLOT_ID_WEAPON_1)
					PlayerTextDrawSetPreviewModel(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid) + 2], 355);
				else PlayerTextDrawSetPreviewModel(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid) + 2], 346);
				PlayerTextDrawColor(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid) + 2], 152);

				PlayerTextDrawShow(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid) + 2]);
				PlayerTextDrawBackgroundColor(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
				PlayerTextDrawShow(playerid, InventoryPTD[playerid][GetInventoryPTD_ID(slotid)]);
			}
			default: {
				PlayerTextDrawSetPreviewModel(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemModelID]
				);
				PlayerTextDrawSetPreviewRot(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][0],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][1],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][2],
					InventoryItemInfo[PI[playerid][pItemsID][slotid]][itemPos][3]
				);
				PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][GetInventoryPTD_ID(slotid)],
					GetInventoryAmount(playerid, PI[playerid][pItemsID][slotid], PI[playerid][pItemsAmount][slotid])
				);
				PlayerTextDrawBackgroundColor(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)], INVENTORY_ITEM_COLOR_DEFAULT);
				PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][GetInventoryPTD_ID(slotid)]);
			}
		}
	}
	return true;
}
