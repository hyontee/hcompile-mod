		);
		PlayerTextDrawSetString(playerid, InventoryAmountPTD[playerid][slotid - start_slotid],
			GetInventoryAmount(playerid, PI[playerid][pItemsID][slotid], PI[playerid][pItemsAmount][slotid])
		);
		PlayerTextDrawShow(playerid, InventorySlotPTD[playerid][slotid - start_slotid]);
	}
	inventory_NullSlots(playerid);
}
stock inventory_DestroyPTD(playerid) {
	if (!InventoryTempInfo[playerid][tCreatedGUI]) return;


	for (new ptd_id = 0; ptd_id < sizeof (InventoryPTD[]); ptd_id++) {
		if (ptd_id < sizeof (InventoryOtherPTD[]))
			PlayerTextDrawDestroy(playerid, InventoryOtherPTD[playerid][ptd_id]);
		PlayerTextDrawDestroy(playerid, InventoryPTD[playerid][ptd_id]);

		if (ptd_id >= (INVENTORY_MAX_OTHER_SLOTS)) continue;
		PlayerTextDrawDestroy(playerid, InventoryOtherSlotPTD[playerid][ptd_id]);
		PlayerTextDrawDestroy(playerid, InventoryOtherAmountPTD[playerid][ptd_id]);

		if (ptd_id >= (INVENTORY_MAX_PAGE_SLOTS + INVENTORY_MAX_PAGE_USE_SLOTS)) continue;
		PlayerTextDrawDestroy(playerid, InventorySlotPTD[playerid][ptd_id]);
		PlayerTextDrawDestroy(playerid, InventoryAmountPTD[playerid][ptd_id]);
	}
	InventoryTempInfo[playerid][tCreatedGUI] = 0;
}
stock inventory_UpdateWeightPTD(playerid) {
	if (!InventoryTempInfo[playerid][tInventoryShowed]) return;
	inventory_UpdateBackpack(playerid);

	format(STRING_GLOBAL, sizeof (STRING_GLOBAL), "%.2f / %.2fKG",
		GetInventoryWeight(playerid), InventoryTempInfo[playerid][tAvailableWeight]
	);
	PlayerTextDrawSetString(playerid, InventoryPTD[playerid][20], STRING_GLOBAL), STRING_GLOBAL[0] = EOS;
}
stock inventory_ShowDialogMenu(playerid, targetMenu = INVENTORY_TYPE_NONE) {
	new type = INVENTORY_TYPE_NONE, Float:vehiclePos[4];

	new Float:armour;
	GetPlayerArmour(playerid, armour);
	if (armour <= 0 && PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR]) {
		PI[playerid][pItemsID][INVENTORY_SLOT_ID_ARMOUR] = 0;
		PI[playerid][pItemsAmount][INVENTORY_SLOT_ID_ARMOUR] = 0;
	}
	InventoryTempInfo[playerid][tHouseID] = -1;
	InventoryTempInfo[playerid][tVehicleID] = -1;

	if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) {
		for (new vehicleid = GetVehiclePoolSize() + 1; --vehicleid != 0;) {
			if (!IsValidVehicle(vehicleid) || IsABike(vehicleid) || IsAVelik(vehicleid) || IsABoat(vehicleid))
				continue;
			GetVehicleShiftPos(vehicleid, 1, vehiclePos[0], vehiclePos[1], vehiclePos[2], 2.0);
			if (!IsPlayerInRangeOfPoint(playerid, 2.5, vehiclePos[0], vehiclePos[1], vehiclePos[2]) || IsVehicleTrunkLocked(vehicleid)) continue;

			type = INVENTORY_TYPE_CAR;
			InventoryTempInfo[playerid][tVehicleID] = vehicleid;
			break;
		}
	}
	if (type != INVENTORY_TYPE_CAR && GetPlayerVirtualWorld(playerid) > 0) {
		new 
			houseid = GetPlayerVirtualWorld(playerid) - 1,
			house_interiorid = gHouses[houseid][houseHint];

		if (IsPlayerInRangeOfPoint(playerid, 3.0, 
				hinterior_info[house_interiorid][h_pos_exit][0], 
				hinterior_info[house_interiorid][h_pos_exit][1], 
				hinterior_info[house_interiorid][h_pos_exit][2])
		) {

			type = INVENTORY_TYPE_HOUSE;
			InventoryTempInfo[playerid][tHouseID] = houseid;
		}
	}
	new
		vehicleid = InventoryTempInfo[playerid][tVehicleID], 
		houseid = InventoryTempInfo[playerid][tHouseID],
		Float:playerPos[3], idx = 0;

	if (targetMenu != type) type = INVENTORY_TYPE_NONE;
	GetPlayerPos(playerid, playerPos[0], playerPos[1], playerPos[2]);

	switch (type) {
		case INVENTORY_TYPE_CAR: {
			GetVehicleZAngle(vehicleid, vehiclePos[3]);

			GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
			GetVehicleShiftPos(vehicleid, 1, vehiclePos[0], vehiclePos[1], vehiclePos[2], 2.0);

			if (boot != VEHICLE_PARAMS_ON) 
				SetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, VEHICLE_PARAMS_ON, objective);
			// AnimationTrunk(playerid, vehiclePos[0], vehiclePos[1], vehiclePos[2], vehiclePos[3], playerPos[1], playerPos[2]);
		}
		case INVENTORY_TYPE_HOUSE: { }
	}
	STRING_GLOBAL[0] = EOS;

	switch (type) {
		case INVENTORY_TYPE_NONE: {
