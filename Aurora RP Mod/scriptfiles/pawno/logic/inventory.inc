				targetid = InventoryTempInfo[playerid][tVehicleID];
				if (0 <= targetid < MAX_VEHICLES) {
					item_id = VehicleInfo[targetid][vItemsID][InventoryTempInfo[playerid][tSelectedOtherSlotID]];
				}
			}
			case INVENTORY_TYPE_HOUSE: {
				targetid = InventoryTempInfo[playerid][tHouseID];
