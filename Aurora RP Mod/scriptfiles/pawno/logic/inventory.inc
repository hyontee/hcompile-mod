inventory_OnPlayerKeySChange(playerid, newkeys, oldkeys) {
	if ((newkeys & KEY_NO) && !(oldkeys & KEY_NO)) {
		if (GetPVarInt(playerid, "BuyItemStatus")) {
			new targetid = GetPVarInt(playerid, "BuyItemID");

			format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "%s отказался от покупки.",
				player_name[playerid]
			);
			ErrorMessage(targetid, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
			ErrorMessage(playerid, "Вы отказались от покупки.");

			DeletePVar(playerid, "BuyItemStatus");

			return true;
		}
	}
	if ((newkeys & KEY_YES) && !(oldkeys & KEY_YES)) {
		if (GetPVarInt(playerid, "BuyItemStatus")) {
			new
				targetid = GetPVarInt(playerid, "BuyItemID"),
				amount = GetPVarInt(targetid, "SellItemAmount"),
				price = GetPVarInt(targetid, "SellItemPrice");

			if (!ProxDetectorS(7.5, playerid, targetid)) {
				ErrorMessage(playerid, "Вы слишком далеко.");
				return true;
			}
			SetPVarInt(playerid, "BuyItemStatus", 0);

			if (GetPlayerMoneyEx(playerid) > price) {
				new itemid = PI[targetid][pItemsID][GetPVarInt(targetid, "SellSlotID")];
				if (itemid != GetPVarInt(targetid, "SellItem_ID")) return true;

				InventoryTempInfo[targetid][tActionSelectedSlotID] = GetPVarInt(targetid, "SellSlotID");
				if (!GivePlayerItemToPlayer(targetid, playerid, GetPVarInt(targetid, "SellSlotID"), amount)) return true;

				format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "%s купил у Вас "GREEN"%s [%d шт].",
					player_name[playerid], InventoryItemInfo[itemid][itemName], amount);
				SendClientMessage(targetid, COLOR_GREEN, CHAT_GLOBAL);
				format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "Вы купили "GREEN"%s [%d шт].",
					InventoryItemInfo[itemid][itemName], amount);
				SendClientMessage(playerid, 0xFFFFFFFF, CHAT_GLOBAL);

				/*format(CHAT_GLOBAL, 128, "%s купил у игрока %s - %s [%d шт] за %d.",
					player_name[playerid], player_name[targetid],
					InventoryItemInfo[itemid][itemName], amount, price
				);
				WriteLog("logs_givemoney", CHAT_GLOBAL);*/

				GiveMoney(playerid, -price, "покупка предмета");
				GiveMoney(targetid, price, "продажа предмета");

				CHAT_GLOBAL[0] = EOS;
			} else {
				format(CHAT_GLOBAL, sizeof (CHAT_GLOBAL), "У %s не хватает денег.", player_name[playerid]);
				ErrorMessage(targetid, CHAT_GLOBAL), CHAT_GLOBAL[0] = EOS;
				ErrorMessage(playerid, "У вас не хватает денег.");

				return true;
			}
		}
	}
	if ((newkeys & KEY_YES) && !(oldkeys & KEY_YES)) {
		callcmd::inv(playerid);
		return true;
	}

	if (GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
		return false;
	if (!InventoryTempInfo[playerid][tInventoryShowed] && (newkeys & KEY_WALK) && !(oldkeys & KEY_WALK)) {
		if (inventory_PickItem(playerid)) return true;
	}
	return false;
}

stock GetInventoryPTD_ID(slotid) {
	new td_id = slotid;
	switch (slotid) {
		case (INVENTORY_MAX_PAGE_SLOTS * 1)..(INVENTORY_MAX_PAGE_SLOTS * 2 - 1): td_id -= INVENTORY_MAX_PAGE_SLOTS * 1;
		case (INVENTORY_MAX_PAGE_SLOTS * 2)..(INVENTORY_MAX_PAGE_SLOTS * 3 - 1): td_id -= INVENTORY_MAX_PAGE_SLOTS * 2;
		// case (INVENTORY_MAX_PAGE_SLOTS * 3)..(INVENTORY_MAX_PAGE_SLOTS * 4 - 1): td_id -= INVENTORY_MAX_PAGE_SLOTS * 2;
		case (INVENTORY_MAX_PAGE_SLOTS * 3) .. (INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS - 1): td_id -= MINUS_INVENTORY_SLOTS;
		case INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS .. (INVENTORY_MAX_PAGE_SLOTS * 3 + INVENTORY_MAX_PAGE_USE_SLOTS * 2 - 1):
			td_id -= (MINUS_INVENTORY_SLOTS + INVENTORY_MAX_PAGE_USE_SLOTS);
		case INVENTORY_SLOT_ID_WEAPON_1: td_id = 9;
		case INVENTORY_SLOT_ID_WEAPON_2: td_id = 10;
		case INVENTORY_SLOT_ID_AMMO_1: td_id = 21;
		case INVENTORY_SLOT_ID_AMMO_2: td_id = 22;
		case INVENTORY_SLOT_ID_SKIN: td_id = 28;
	}
	return td_id;
}
stock GetInventoryPage(slotid) {
	new inventory_Page = 1;
	switch (slotid) {
		case (INVENTORY_MAX_PAGE_SLOTS * 1)..(INVENTORY_MAX_PAGE_SLOTS * 2 - 1): inventory_Page = 2;
		case (INVENTORY_MAX_PAGE_SLOTS * 2)..(INVENTORY_MAX_PAGE_SLOTS * 3 - 1): inventory_Page = 3;
		// case INVENTORY_SLOT_ID_WEAPON_1, INVENTORY_SLOT_ID_WEAPON_2: inventory_Page = InventoryTempInfo[playerid][tInventoryPageSlot];
	}
	return inventory_Page;
}
