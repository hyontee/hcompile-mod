		PR_UINT8, 1,
		PR_UINT8, 1,
		
		PR_FLOAT, 20.0,
		PR_FLOAT, 180.0,
		PR_FLOAT, 45.0,
		PR_FLOAT, 0.78,
	
		PR_INT8, floatround ( p_t_info [ playerid ] [ p_health ] ),
		PR_INT8, floatround ( p_t_info [ playerid ] [ p_armour ] ),
		PR_INT8, 1);

    PR_SendPacket(bitstream, playerid);

	BS_Delete(bitstream);
