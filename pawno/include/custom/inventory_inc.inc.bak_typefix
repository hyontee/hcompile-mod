					PR_INT32, item_object_id ( playerid, _model ),
				
					PR_UINT8, 1,
					PR_UINT8, 1,
				
					PR_FLOAT, 20.0,
					PR_FLOAT, 180.0,
					PR_FLOAT, 45.0,
