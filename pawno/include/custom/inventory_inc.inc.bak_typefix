		else
		{
			format ( line_string, sizeof line_string, "%d", veh_info [ _id - 1 ] [ v_slot_count ] [ _item_id ] ) ;
			BS_WriteValue(
				bitstream,
				PR_INT8, item_render_type ( _model ),
				PR_INT32, item_object_id ( playerid, _model ),
				
				PR_UINT8, 1,
				PR_UINT8, 1,
				
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
				
				PR_UINT8, strlen ( item_name ( _model ) ),
				PR_STRING, item_name ( _model ),
				
				PR_UINT8, strlen ( line_string ),
				PR_STRING, line_string ) ;
		}
	}
	else if ( _type == 7 )
	{
		new _model = h_info [ _id - 1 ] [ h_slot ] [ _item_id ], line_string [ 12 ] ;
		BS_WriteValue(bitstream, PR_INT8, _item_id);
		if ( _model < 1 )
		{
			BS_WriteValue(
				bitstream,
				PR_INT8, -1,
				PR_INT32, -1,
				
				PR_UINT8, 1,
				PR_UINT8, 1,
				
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
			
				PR_UINT8, strlen ( "" ),
				PR_STRING, "",
				
				PR_UINT8, strlen ( "" ),
				PR_STRING, "" ) ;
		}
		else
		{
			format ( line_string, sizeof line_string, "%d", h_info [ _id - 1 ] [ h_slot_count ] [ _item_id ] ) ;
			BS_WriteValue(
				bitstream,
				PR_INT8, item_render_type ( _model ),
				PR_INT32, item_object_id ( playerid, _model ),
				
				PR_UINT8, 1,
				PR_UINT8, 1,
				
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
				
				PR_UINT8, strlen ( item_name ( _model ) ),
				PR_STRING, item_name ( _model ),
				
				PR_UINT8, strlen ( line_string ),
				PR_STRING, line_string ) ;
		}
	}
	else if ( _type == 10 )
	{
		new _model = family_info [ _id - 1 ] [ fam_slot ] [ _item_id ], line_string [ 12 ] ;
		BS_WriteValue(bitstream, PR_INT8, _item_id);
		if ( _model < 1 )
		{
			BS_WriteValue(
				bitstream,
				PR_INT8, -1,
				PR_INT32, -1,
				
				PR_UINT8, 1,
				PR_UINT8, 1,
				
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
			
				PR_UINT8, strlen ( "" ),
				PR_STRING, "",
				
				PR_UINT8, strlen ( "" ),
				PR_STRING, "" ) ;
		}
		else
		{
			format ( line_string, sizeof line_string, "%d", family_info [ _id - 1 ] [ fam_slot_count ] [ _item_id ] ) ;
			BS_WriteValue(
				bitstream,
				PR_INT8, item_render_type ( _model ),
				PR_INT32, item_object_id ( playerid, _model ),
				
				PR_UINT8, 1,
				PR_UINT8, 1,
				
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
				
				PR_UINT8, strlen ( item_name ( _model ) ),
				PR_STRING, item_name ( _model ),
				
				PR_UINT8, strlen ( line_string ),
				PR_STRING, line_string ) ;
		}
	}
	else if ( _type == 11 )
	{
		new _model = f_info [ _id - 1 ] [ f_slot ] [ _item_id ], line_string [ 12 ] ;
		BS_WriteValue(bitstream, PR_INT8, _item_id);
		if ( _model < 1 )
		{
			BS_WriteValue(
				bitstream,
				PR_INT8, -1,
				PR_INT32, -1,
				
				PR_UINT8, 1,
				PR_UINT8, 1,
				
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
			
				PR_UINT8, strlen ( "" ),
				PR_STRING, "",
				
				PR_UINT8, strlen ( "" ),
				PR_STRING, "" ) ;
		}
		else
		{
			format ( line_string, sizeof line_string, "%d", f_info [ _id - 1 ] [ f_slot_count ] [ _item_id ] ) ;
			BS_WriteValue(
				bitstream,
				PR_INT8, item_render_type ( _model ),
				PR_INT32, item_object_id ( playerid, _model ),
				
				PR_UINT8, 1,
				PR_UINT8, 1,
				
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
				
				PR_UINT8, strlen ( item_name ( _model ) ),
				PR_STRING, item_name ( _model ),
				
				PR_UINT8, strlen ( line_string ),
				PR_STRING, line_string ) ;
		}
	}

    PR_SendPacket(bitstream, playerid);

	BS_Delete(bitstream);
}

stock SetInventoryButton ( playerid, _str [ ], _type, bool: status )
{
	#if defined debug_packet
		printf ( "[SetInventoryButton] playerid: %d", playerid ) ;
	#endif
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
	BS_WriteValue(bitstream, PR_UINT32, RPC_INVENTORY);
	
	BS_WriteValue(
		bitstream,
		PR_INT8, 9,
	
		PR_UINT8, strlen ( _str ),
		PR_STRING, _str,
	
		PR_INT8, _type,
		PR_BOOL, status);

    PR_SendPacket(bitstream, playerid);

	BS_Delete(bitstream);
}

stock UpdateInventoryButton ( playerid, _position, _str [ ], _type, bool: status )
{
	#if defined debug_packet
		printf ( "[SetInventoryButton] playerid: %d", playerid ) ;
	#endif
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
	BS_WriteValue(bitstream, PR_UINT32, RPC_INVENTORY);
	
	BS_WriteValue(
		bitstream,
		PR_INT8, 11,
		PR_INT8, _position,
	
		PR_UINT8, strlen ( _str ),
		PR_STRING, _str,
	
		PR_INT8, _type,
		PR_BOOL, status);

    PR_SendPacket(bitstream, playerid);

	BS_Delete(bitstream);
}

stock convert_gun_to_model ( gun_id )
{
	new item_id ;
	switch ( gun_id )
	{
		case 1: item_id = 105 ;
		case 3: item_id = 107 ;
		case 5: item_id = 109 ;
		case 24: item_id = 124 ;
		case 25: item_id = 125 ;
		case 29: item_id = 129 ;
		case 30: item_id = 130 ;
		case 31: item_id = 131 ;
		case 33: item_id = 133 ;
		case 41: item_id = 141 ;
		case 43: item_id = 143 ;
	}
	return item_id ;
}

stock SetInventoryWallet ( playerid )
{
	#if defined debug_packet
		printf ( "[SetInventoryWallet] playerid: %d", playerid ) ;
	#endif
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_CUSTOMRPC);
	BS_WriteValue(bitstream, PR_UINT32, RPC_INVENTORY);
	
	BS_WriteValue(bitstream, PR_INT8, 10);
	BS_WriteValue(bitstream, PR_UINT8, 13);
	
	new line_string [ 12 ] ;
	for ( new i = 0 ; i < 13 ; i ++ )
	{
		BS_WriteValue(bitstream, PR_INT8, i);
		if ( p_t_info [ playerid ] [ p_gun_slot ] [ i ] < 1 )
		{
			BS_WriteValue(
				bitstream,
				PR_INT8, -1,
				PR_INT32, -1,
			
				PR_UINT8, 1,
				PR_UINT8, 1,
			
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
			
				PR_UINT8, strlen ( "" ),
				PR_STRING, "",
			
				PR_BOOL, false);
		}
		else
		{
			format ( line_string, sizeof line_string, "%d", p_t_info [ playerid ] [ p_gun_ammo ] [ i ] ) ;
			BS_WriteValue(
				bitstream,
				PR_INT8, -1,
				PR_INT32, convert_gun_to_model ( p_t_info [ playerid ] [ p_gun_slot ] [ i ] ),
			
				PR_UINT8, 1,
				PR_UINT8, 1,
			
				PR_FLOAT, 20.0,
				PR_FLOAT, 180.0,
				PR_FLOAT, 45.0,
				PR_FLOAT, 0.78,
			
				PR_UINT8, strlen ( line_string ),
				PR_STRING, line_string,
			
				PR_BOOL, ( GetPlayerWeapon ( playerid ) == p_t_info [ playerid ] [ p_gun_slot ] [ i ] ) ? ( true ) : ( false ) ) ;
		}
	}

    PR_SendPacket(bitstream, playerid);

	BS_Delete(bitstream);
}