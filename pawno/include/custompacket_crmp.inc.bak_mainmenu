stock getReplacableSkinModel ( playerid )
{
	new _skin_model = 0 ;
	if ( p_info [ playerid ] [ custom_skin ] [ 0 ] != 0 ) _skin_model = p_info [ playerid ] [ custom_skin ] [ 0 ] ;
	else if ( p_info [ playerid ] [ custom_skin ] [ 1 ] != 0 ) _skin_model = p_info [ playerid ] [ custom_skin ] [ 1 ] ;
	else 
	{
		if ( changed_player_skin [ playerid ] == false ) return _skin_model ;
		else _skin_model = p_info [ playerid ] [ skin ] ;
	}
    return _skin_model ;
}

stock getNewSkinModel ( playerid )
{
	new _skin_model = 0 ;
	if ( p_info [ playerid ] [ custom_skin ] [ 1 ] != 0 ) _skin_model = p_info [ playerid ] [ custom_skin ] [ 1 ] ;
	else if ( p_info [ playerid ] [ custom_skin ] [ 0 ] != 0 ) _skin_model = p_info [ playerid ] [ custom_skin ] [ 0 ] ;
	else _skin_model = p_info [ playerid ] [ skin ] ;
    return _skin_model ;
}

stock ProcessReplaceSkin ( playerid, BitStream:bs )
{
    new player, skinid ;
	BS_ReadValue(
		bs,
 		PR_UINT32, player,
		PR_UINT32, skinid);

	new custom_id = getReplacableSkinModel ( player ) ;
	if ( custom_id > 311 )
	{
		if ( player_checking_hash [ playerid ] < 66 && custom_id >= 4622 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 69 && custom_id >= 4636 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 72 && custom_id >= 4644 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 75 && custom_id >= 4664 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 78 && custom_id >= 4694 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 81 && custom_id >= 4717 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 84 && custom_id >= 4733 ) return 0 ;
		
		new BitStream:bitstream = BS_New();
		
		BS_WriteValue(
			bitstream,
			PR_UINT32, player,
			PR_UINT32, custom_id);
		PR_SendRPC(bitstream, playerid, RPC_ScrSetPlayerSkin, PR_HIGH_PRIORITY, PR_RELIABLE_SEQUENCED);
		BS_Delete(bitstream);
		return 1 ;
	}
	return 0 ;
}

stock ProcessReplaceSkinAdd ( playerid, BitStream:bs )
{
    static clearPlayerData [ E_PLAYER_STRUCT ] ;
	playerData = clearPlayerData ;

	BS_ReadValue(
 		bs,
   		PR_INT16, playerData [ e_usPlayerID ],
		PR_UINT8, playerData [ e_bTeam ],
		PR_UINT32, playerData [ e_uiSkin ],
		PR_FLOAT, playerData [ e_pfPosX ],
		PR_FLOAT, playerData [ e_pfPosY ],
		PR_FLOAT, playerData [ e_pfPosZ ],
		PR_FLOAT, playerData [ e_pfRot ],
		PR_UINT32, playerData [ e_uiColor ],
		PR_UINT8, playerData [ e_bFighting ],
		PR_BOOL, playerData [ e_boolVisible ]);

	new custom_id = getReplacableSkinModel ( playerData [ e_usPlayerID ] ) ;
	if ( custom_id > 311 )
	{
		if ( player_checking_hash [ playerid ] < 66 && custom_id >= 4622 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 69 && custom_id >= 4636 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 72 && custom_id >= 4644 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 75 && custom_id >= 4664 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 78 && custom_id >= 4694 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 81 && custom_id >= 4717 ) return 0 ;
		if ( player_checking_hash [ playerid ] < 84 && custom_id >= 4733 ) return 0 ;
		
		new BitStream:bitstream = BS_New();

		BS_WriteValue(
			bitstream,
			PR_INT16, playerData [ e_usPlayerID ],
			PR_UINT8, playerData [ e_bTeam ],
			PR_UINT32, custom_id,
			PR_FLOAT, playerData [ e_pfPosX ],
			PR_FLOAT, playerData [ e_pfPosY ],
			PR_FLOAT, playerData [ e_pfPosZ ],
			PR_FLOAT, playerData [ e_pfRot ],
			PR_UINT32, playerData [ e_uiColor ],
			PR_UINT8, playerData [ e_bFighting ],
			PR_BOOL, playerData [ e_boolVisible ]);
	
		PR_SendRPC(bitstream, playerid, RPC_WorldPlayerAdd, PR_HIGH_PRIORITY, PR_RELIABLE_SEQUENCED);
		BS_Delete(bitstream);
		return 1 ;
	}
	return 0 ;
}

