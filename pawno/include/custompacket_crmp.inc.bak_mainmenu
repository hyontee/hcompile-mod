const ID_RPC = 20 ;
const ID_CUSTOM_PACKET = 251 ;

const RPC_GiveActorDamage = 177 ;
const RPC_ModeSettings = 207 ;
const RPC_ModeBinder = 208 ;
const RPC_CustomHash = 209 ;
const RPC_CInfo = 210 ;
const RPC_BattlePass = 211 ;
const RPC_VoiceChat = 212 ;
const RPC_HudManager = 213 ;
const RPC_PlayAudioStreams = 214 ;
const RPC_Trade = 216 ;
const RPC_Inventory = 217 ;
const RPC_Tuning = 218 ;
const RPC_Family = 219 ;
const RPC_Finger = 220 ;
const RPC_Apple = 221 ;
const RPC_Binary = 222 ;
const RPC_Roulette = 223 ;
const RPC_CustomSpawn = 224 ;
const RPC_Action = 225 ;
const RPC_RadialMenu = 226 ;
const RPC_RentMenu = 227 ;
const RPC_ShopManager = 228 ;
const RPC_ValentineManager = 229 ;
const RPC_BoatsManager = 230 ;
const RPC_JackpotManager = 231 ;
const RPC_WheelManager = 232 ;
const RPC_QuestManager = 233 ;
const RPC_MobileClient = 235 ;
const RPC_CarShowroom = 236 ;
const RPC_Fraction = 237 ;
const RPC_Parking = 238 ;
const RPC_Market = 239 ;
const RPC_Craft = 240 ;
const RPC_PlayerRoulette = 241 ;
const RPC_EditManager = 242 ;
const RPC_ReconManager = 243 ;
const RPC_AzsManager = 244 ;
const RPC_AdminManager = 245 ;
const RPC_ContainerManager = 246 ;
const RPC_FishingManager = 247 ;
const RPC_CasinoDice = 248 ;
const RPC_SelectorDialog = 249 ;
const RPC_Binders = 251 ;
const RPC_BindersChar = 252 ;
const RPC_VehicleDistance = 253 ;
const RPC_NewBieBattle = 254 ;
const RPC_AuthReg = 255 ;
const RPC_TouchZone = 256 ;
const RPC_Plates = 257 ;
const RPC_Business = 258 ;
const RPC_NOTIFY_SERVER = 260 ;
const RPC_NOTIFY_SERVER_UI_VISIBLE = 261 ;

IPacket:ID_CUSTOM_PACKET(playerid, BitStream:bs)
{
    new rpcid ;

    BS_ReadValue(bs,
		PR_IGNORE_BITS, 8, // packet id
		PR_UINT32, rpcid
    );
    
	if ( rpcid == RPC_GiveActorDamage )
	{
		#if defined debug_rpc
			printf ( "[RPC_GiveActorDamage] playerid: %d", playerid ) ;
		#endif
		
        new _actorId, Float: _amount, _weaponId, _bodypart ;

        BS_ReadValue(bs,
            PR_UINT16, _actorId,
			PR_FLOAT, _amount,
			PR_UINT32, _weaponId,
			PR_UINT32, _bodypart
        );

		show_packet_actor ( playerid, _actorId, _amount, _weaponId, _bodypart ) ;
	}
    else if ( rpcid == RPC_ModeSettings )
    {
		#if defined debug_rpc
			printf ( "[RPC_ModeSettings] playerid: %d", playerid ) ;
		#endif
		
        new i_bit ;

        BS_ReadValue(bs,
            PR_UINT8, i_bit
        );

		if ( i_bit == 1 ) 
		{
			if ( p_t_info [ playerid ] [ p_logged ] == false || player_loaded { playerid } == 0 ) return 1 ;
			show_playersettings ( playerid ) ;
		}
    }
	else if ( rpcid == RPC_ModeBinder )
    {
		#if defined debug_rpc
			printf ( "[RPC_ModeBinder] playerid: %d", playerid ) ;
		#endif
		
        new i_bit ;

        BS_ReadValue(bs,
            PR_UINT8, i_bit
        );

		if ( i_bit == 1 )
		{
			if ( p_t_info [ playerid ] [ p_logged ] == false || player_loaded { playerid } == 0 ) return 1 ; 
			show_playerbinder ( playerid ) ;
		}
    }
	else if ( rpcid == RPC_CustomHash )
    {
		#if defined debug_rpc
			printf ( "[RPC_CustomHash] playerid: %d", playerid ) ;
		#endif
		
        new i_bit ;

        BS_ReadValue(bs,
            PR_UINT32, i_bit
        );

		player_checking_hash [ playerid ] += i_bit ;
    }
	else if ( rpcid == RPC_CInfo )
    {
		#if defined debug_rpc
			printf ( "[RPC_CInfo] playerid: %d", playerid ) ;
		#endif
		
        new i_id, i_bit, bool: i_bool ;

        BS_ReadValue(bs,
            PR_UINT16, i_id,
            PR_UINT16, i_bit,
            PR_BOOL, i_bool
        );
		
		show_packet_noty ( playerid, i_id, i_bit, i_bool ) ;
    }
	else if ( rpcid == RPC_BattlePass )
	{
		#if defined debug_rpc
			printf ( "[RPC_BattlePass] playerid: %d", playerid ) ;
		#endif
		
		new i_bit, i_info, i_pos_bp, i_type ;

        BS_ReadValue(bs,
            PR_INT32, i_bit,
            PR_INT32, i_info,
            PR_INT32, i_pos_bp,
            PR_INT32, i_type
        );
		
		show_packet_battlepass ( playerid, i_bit, i_info, i_pos_bp, i_type ) ;
	}
	else if ( rpcid == RPC_VoiceChat )
	{
		#if defined debug_rpc
			printf ( "[RPC_VoiceChat] playerid: %d", playerid ) ;
		#endif
		
		new i_bit, i_chat ;

        BS_ReadValue(bs,
            PR_UINT8, i_bit,
            PR_UINT8, i_chat
        );
		
		p_info [ playerid ] [ voice ] = i_bit ;
		p_info [ playerid ] [ chat_status ] = i_chat ;
	}
	else if ( rpcid == RPC_HudManager )
	{
		#if defined debug_rpc
			printf ( "[RPC_HudManager] playerid: %d", playerid ) ;
		#endif
		
		new i_bit ;

        BS_ReadValue(bs,
            PR_UINT8, i_bit
        );
		
		p_info [ playerid ] [ hud_id ] = i_bit ;
		
		if ( p_t_info [ playerid ] [ p_logged ] == true )
		{
			if ( player_device { playerid } == 2 && p_info [ playerid ] [ hud_id ] )
			{
				SendCheckHud ( playerid ) ;
			}
		}
	}
	else if ( rpcid == RPC_PlayAudioStreams )
	{
		#if defined debug_rpc
			printf ( "[RPC_PlayAudioStreams] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param_len, _param_url [ 256 ], _param_name [ 256 ] ;
		
		BS_ReadValue(
			bs,
			PR_UINT8, _param1,
			PR_UINT8, _param2,
			PR_UINT8, _param_len,
			PR_STRING, _param_url, _param_len,
			PR_UINT8, _param_len,
			PR_STRING, _param_name, _param_len
		);
		
		new eType = g_aStreamSources [ playerid ] [ eStreamType ] ;
		if ( _param1 == 0 )
		{
			if ( _param2 == 0 )
			{
				musicHide ( playerid ) ;
			}
			else if ( _param2 == 1 )
			{
				musicHide ( playerid ) ;
				musicAudioSelectorShow ( playerid, 0 ) ;
			}
			else if ( _param2 == 2 )
			{
				musicHide ( playerid ) ;
				musicAudioSelectorShow ( playerid, 1 ) ;
			}
			else if ( _param2 == 3 )
			{
				if ( eType == NONE )
				{
					if ( IsValidDynamicObject ( boombox_player [ playerid ] [ b_object ] ) ) DestroyDynamicObject ( boombox_player [ playerid ] [ b_object ] ) ;
					if ( boombox_player [ playerid ] [ b_status ] )
					{
						Iter_Remove(box_player, playerid);
						boombox_player [ playerid ] [ b_status ] = false ;
						DestroyDynamicArea ( boombox_player [ playerid ] [ b_area ] ) ;
					}

					if ( IsValidDynamic3DTextLabel ( boombox_player [ playerid ] [ b_text ] ) )
					{
						DestroyDynamic3DTextLabel ( boombox_player [ playerid ] [ b_text ] ) ;
						boombox_player [ playerid ] [ b_text ] = Text3D:INVALID_3DTEXT_ID ;
					}
					
					g_aStreamSources [ playerid ] [ eStreamType ] = TOPLAYER ;
					g_aStreamSources [ playerid ] [ eStreamAttach ] = playerid ;
					
					SetAttachedBoomBox ( playerid ) ;
				}
				else if ( eType == TOPLAYER )
				{
					if ( IsPlayerAttachedObjectSlotUsed ( playerid, 4 ) ) RemovePlayerAttachedObject ( playerid, 4 ) ;
					
					g_aStreamSources [ playerid ] [ eStreamType ] = NONE ;
					g_aStreamSources [ playerid ] [ eStreamAttach ] = 0 ;
					
					SetAddRecorder ( playerid ) ;
				}
				musicHide ( playerid ) ;
			}
			else if ( _param2 == 4 )
			{
				DestroyRecorder ( playerid ) ;
				musicHide ( playerid ) ;
			}
			else if ( _param2 == 5 || _param2 == 6 || _param2 == 7 )
			{
				new _item_0 = 0, _item_1 = 0 ;
				if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT )
				{
					if ( eType == NONE ) _item_0 = 2, _item_1 = 3 ;
					else if ( eType == TOPLAYER ) _item_0 = 1, _item_1 = 3 ;
				}
				else if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER )
				{
					if ( veh_info [ GetPlayerVehicleID ( playerid ) - 1 ] [ v_sound ] > 0 )
					{
						_item_0 = 4 ;
						_item_1 = 5 ;
					}
				}
				else _item_0 = 0, _item_1 = 0 ;
				musicShow ( playerid, _item_0, _item_1, 100, false, g_aStreamSources [ playerid ] [ eStreamName ] ) ;
			}
			return 1 ;
		}
		
		musicHide ( playerid ) ;
		format ( g_aStreamSources [ playerid ] [ eStreamURL ], 256, "%s", _param_url ) ;
		format ( g_aStreamSources [ playerid ] [ eStreamName ], 256, "%s", _param_name ) ;
		if ( eType == NONE )
		{
			if ( GetPlayerVehicleID ( playerid ) != 0 || GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT )
			{
				DestroyRecorder ( playerid ) ;
				return 1 ;
			}
			
		   	g_aStreamSources [ playerid ] [ eStreamID ] = playerid ;
			g_aStreamSources [ playerid ] [ eStreamPos ] [ 0 ] = p_t_info [ playerid ] [ p_pos ] [ 0 ] ;
			g_aStreamSources [ playerid ] [ eStreamPos ] [ 1 ] = p_t_info [ playerid ] [ p_pos ] [ 1 ] ;
			g_aStreamSources [ playerid ] [ eStreamPos ] [ 2 ] = p_t_info [ playerid ] [ p_pos ] [ 2 ] ;
		   	g_aStreamSources [ playerid ] [ eStreamDistance ] = 40.0 ;
		   	g_aStreamSources [ playerid ] [ eStreamInt ] = GetPlayerInterior ( playerid ) ;
		   	g_aStreamSources [ playerid ] [ eStreamRepeat ] = 1 ;
		   	g_aStreamSources [ playerid ] [ eStreamCurrentTime ] = gettime ( ) ;
		    CreateStreamSource ( playerid, playerid ) ;
		    
		   	g_aStreamSources [ playerid ] [ eStreamType ] = NONE ;
		   	g_aStreamSources [ playerid ] [ eStreamAttach ] = 0 ;
		   	AttachStreamSource ( playerid, playerid ) ;
	
		   	VolumeStreamSource ( playerid ) ;
			
			foreach(new i: logged_players)
	        {
	            if ( g_aStreamSources [ i ] [ eStreamID ] == playerid )
	            {
	                CreateStreamSource ( i, playerid ) ;
	                AttachStreamSource ( i, playerid ) ;
	                VolumeStreamSource ( i ) ;
	            }
	        }
		}
		else if ( eType == TOVEHICLE )
		{
			if ( GetPlayerVehicleID ( playerid ) == 0 || GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER )
			{
				DestroyRecorder ( playerid ) ;
				return 1 ;
			}
			
		   	g_aStreamSources [ playerid ] [ eStreamID ] = playerid ;
		   	g_aStreamSources [ playerid ] [ eStreamDistance ] = 40.0 ;
		   	g_aStreamSources [ playerid ] [ eStreamInt ] = GetPlayerInterior ( playerid ) ;
		   	g_aStreamSources [ playerid ] [ eStreamRepeat ] = 1 ;
		   	g_aStreamSources [ playerid ] [ eStreamCurrentTime ] = gettime ( ) ;
		    CreateStreamSource ( playerid, playerid ) ;
		    
		   	g_aStreamSources [ playerid ] [ eStreamType ] = TOVEHICLE ;
		   	g_aStreamSources [ playerid ] [ eStreamAttach ] = GetPlayerVehicleID ( playerid ) ;
		   	AttachStreamSource ( playerid, playerid ) ;
		   	
		   	VolumeStreamSource ( playerid ) ;
			
			foreach(new i: logged_players)
	        {
	            if ( g_aStreamSources [ i ] [ eStreamID ] == playerid )
	            {
	                CreateStreamSource ( i, playerid ) ;
	                AttachStreamSource ( i, playerid ) ;
	                VolumeStreamSource ( i ) ;
	            }
	        }
		}
		else if ( eType == TOPLAYER )
		{
			if ( GetPlayerVehicleID ( playerid ) != 0 || GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT )
			{
				DestroyRecorder ( playerid ) ;
				return 1 ;
			}
			
		   	g_aStreamSources [ playerid ] [ eStreamID ] = playerid ;
		   	g_aStreamSources [ playerid ] [ eStreamDistance ] = 40.0 ;
		   	g_aStreamSources [ playerid ] [ eStreamInt ] = GetPlayerInterior ( playerid ) ;
		   	g_aStreamSources [ playerid ] [ eStreamRepeat ] = 1 ;
		   	g_aStreamSources [ playerid ] [ eStreamCurrentTime ] = gettime ( ) ;
		    CreateStreamSource ( playerid, playerid ) ;
		    
		   	g_aStreamSources [ playerid ] [ eStreamType ] = TOPLAYER ;
		   	g_aStreamSources [ playerid ] [ eStreamAttach ] = playerid ;
		   	AttachStreamSource ( playerid, playerid ) ;
		   	
		   	VolumeStreamSource ( playerid ) ;
			
			foreach(new i: logged_players)
	        {
	            if ( g_aStreamSources [ i ] [ eStreamID ] == playerid )
	            {
	                CreateStreamSource ( i, playerid ) ;
	                AttachStreamSource ( i, playerid ) ;
	                VolumeStreamSource ( i ) ;
	            }
	        }
		}
	}
	else if ( rpcid == RPC_Trade )
	{
		#if defined debug_rpc
			printf ( "[RPC_Trade] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3 ;
		
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3
		);
		
		show_packet_trade ( playerid, _param1, _param2, _param3 ) ;
	}
	else if ( rpcid == RPC_Inventory )
	{
		#if defined debug_rpc
			printf ( "[RPC_Inventory] playerid: %d", playerid ) ;
		#endif
		
        new _param1, _param2, _param3 ;
		
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3
		);
		
		show_packet_inventory ( playerid, _param1, _param2, _param3);
	}
	else if ( rpcid == RPC_Tuning )
	{
		#if defined debug_rpc
			printf ( "[RPC_Tuning] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3 ;
		
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3
		);
		
		show_packet_tune ( playerid, _param1, _param2, _param3 ) ;
	}
	else if ( rpcid == RPC_Family )
	{
		#if defined debug_rpc
			printf ( "[RPC_Family] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3 ;
		
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3
		);
		
		show_packet_family ( playerid, _param1, _param2, _param3 ) ;
	}
	else if ( rpcid == RPC_Fraction )
	{
		#if defined debug_rpc
			printf ( "[RPC_Fraction] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3 ;
		
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3
		);
		
		show_packet_fraction ( playerid, _param1, _param2, _param3 ) ;
	}
	else if ( rpcid == RPC_Finger )
	{
		#if defined debug_rpc
			printf ( "[RPC_Finger] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param_len, _param_str [ 128 ] ;
		
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_UINT8, _param_len,
			PR_STRING, _param_str, _param_len
		);
		
		show_packet_finger ( playerid, _param1, _param2, _param_str ) ;
	}
	else if ( rpcid == RPC_Apple )
	{
		#if defined debug_rpc
			printf ( "[RPC_Apple] playerid: %d", playerid ) ;
		#endif
		
		new _id, _result ;
	
		BS_ReadValue(
			bs,
			PR_UINT8, _id,
			PR_UINT32, _result
		);
		
		show_packet_apple ( playerid, _id, _result ) ;
	}
	else if ( rpcid == RPC_Binary )
	{
		#if defined debug_rpc
			printf ( "[RPC_Binary] playerid: %d", playerid ) ;
		#endif
		
		new _id1, bool: _status, _result ;
	
		BS_ReadValue(
			bs,
			PR_UINT8, _id1,
			PR_UINT32, _result,
			PR_BOOL, _status
		);
		
		show_packet_binary ( playerid, _id1, _status, _result ) ;
	}
	else if ( rpcid == RPC_Roulette )
	{
		#if defined debug_rpc
			printf ( "[RPC_Roulette] playerid: %d", playerid ) ;
		#endif
		
		new current_bid, select_type, select_number ;
	
		BS_ReadValue(
			bs,
			PR_UINT32, current_bid,
			PR_UINT8, select_type,
			PR_UINT8, select_number
		);
		
		show_packet_roulette ( playerid, current_bid, select_type, select_number ) ;
	}
	else if ( rpcid == RPC_CustomSpawn )
	{
		#if defined debug_rpc
			printf ( "[RPC_CustomSpawn] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3 ;
	
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3
		);
		
		upload_spawn_packet ( playerid, _param1, _param2, _param3 ) ;
	}
	else if ( rpcid == RPC_Action )
	{
		#if defined debug_rpc
			printf ( "[RPC_Action] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3, _param4 ;
	
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3,
			PR_INT32, _param4
		);
		
		show_packet_action ( playerid, _param1, _param2, _param3, _param4 ) ;
	}
	else if ( rpcid == RPC_RadialMenu )
	{
		#if defined debug_rpc
			printf ( "[RPC_RadialMenu] playerid: %d", playerid ) ;
		#endif
		
		new current_id ;
	
		BS_ReadValue(
			bs,
			PR_UINT8, current_id
		);
		
		use_radial_menu ( playerid, current_id ) ;
	}
	else if ( rpcid == RPC_RentMenu )
	{
		#if defined debug_rpc
			printf ( "[RPC_RentMenu] playerid: %d", playerid ) ;
		#endif
		
		new current_id ;
	
		BS_ReadValue(
			bs,
			PR_UINT8, current_id
		);
		
		use_rent_menu ( playerid, current_id ) ;
	}
	else if ( rpcid == RPC_ShopManager )
	{
		#if defined debug_rpc
			printf ( "[RPC_ShopManager] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3, _param4 ;
	
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3,
			PR_INT32, _param4
		);
		
		use_shop_manager ( playerid, _param1, _param2, _param3, _param4 ) ;
	}
	else if ( rpcid == RPC_ValentineManager )
	{
		#if defined debug_rpc
			printf ( "[RPC_ValentineManager] playerid: %d", playerid ) ;
		#endif
		
		new _i, _i2, _i3 ;
	
		BS_ReadValue(
			bs,
			PR_INT32, _i,
			PR_INT32, _i2,
			PR_INT32, _i3
		);
		
		use_valentine_manager ( playerid, _i, _i2, _i3 ) ;
	}
	else if ( rpcid == RPC_BoatsManager )
	{
		#if defined debug_rpc
			printf ( "[RPC_BoatsManager] playerid: %d", playerid ) ;
		#endif
		
		new _i, _i2, _i3 ;
	
		BS_ReadValue(
			bs,
			PR_INT32, _i,
			PR_INT32, _i2,
			PR_INT32, _i3
		);
		
		use_boats_manager ( playerid, _i, _i2, _i3 ) ;
	}
	else if ( rpcid == RPC_JackpotManager )
	{
		#if defined debug_rpc
			printf ( "[RPC_JackpotManager] playerid: %d", playerid ) ;
		#endif
		
		new _i, _i2 ;
	
		BS_ReadValue(
			bs,
			PR_INT32, _i,
			PR_INT32, _i2
		);
		
		show_packet_jackpot ( playerid, _i, _i2 ) ;
	}
	else if ( rpcid == RPC_WheelManager )
	{
		#if defined debug_rpc
			printf ( "[RPC_WheelManager] playerid: %d", playerid ) ;
		#endif
		
		new _i ;
	
		BS_ReadValue(
			bs,
			PR_INT32, _i
		);
		
		show_packet_wheel ( playerid, _i ) ;
	}
	else if ( rpcid == RPC_QuestManager )
	{
		#if defined debug_rpc
			printf ( "[RPC_QuestManager] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3 ;
	
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3
		);
		
		show_packet_quest ( playerid, _param1, _param2, _param3 ) ;
	}
	else if ( rpcid == RPC_MobileClient )
	{
		#if defined debug_rpc
			printf ( "[RPC_MobileClient] playerid: %d", playerid ) ;
		#endif
		
		new _param_len, _param_text [ 128 ] ;
		
		BS_ReadValue(
			bs,
			PR_UINT8, _param_len,
			PR_STRING, _param_text, _param_len
		);
		
		player_checking_mobile ( playerid, _param_text ) ;
	}
	else if ( rpcid == RPC_CarShowroom )
	{
		#if defined debug_rpc
			printf ( "[RPC_CarShowroom] playerid: %d", playerid ) ;
		#endif
		
		new _param1, _param2, _param3 ;
		
		BS_ReadValue(
			bs,
			PR_INT32, _param1,
			PR_INT32, _param2,
			PR_INT32, _param3
		);
		
		//show_packet_carshowroom ( playerid, _param1, _param2, _param3 ) ;
	}
	else if ( rpcid == RPC_Parking )
	{
		#if defined debug_rpc
			printf ( "[RPC_Parking] playerid: %d", playerid ) ;
		#endif
		
		new _param_1, _param_2 ;
		
		BS_ReadValue(
			bs,
			PR_INT32, _param_1,
			PR_INT32, _param_2
		);
		
